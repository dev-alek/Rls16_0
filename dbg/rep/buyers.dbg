      846   define buffer buf_trn-doc for trn-doc .
      847   define variable sum-zak  as decimal   no-undo .
      848   define variable sum-prod as decimal   no-undo .
      849   define variable sum-skid as decimal   no-undo .
      850   define variable Counter1 as integer   no-undo .
      851   define variable v-account as integer init 0 no-undo .
      852   define variable v-account-lavel as character no-undo .
      853   define variable v-button-stop as logical no-undo .
      854   define variable v-kol-spice as integer no-undo .
      855   define variable v-kol-spice2 as integer no-undo .
      856   define variable v-kol-spice3 as integer no-undo .
      857   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      858   DEFINE BUTTON StopBtn AUTO-END-KEY
      859        LABEL "Стоп"
      860        SIZE 10 BY 1.
      861   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      862        LABEL "Обработано записей"
      863         VIEW-AS TEXT
      864        SIZE 14 BY .67 NO-UNDO.
      865   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      866         VIEW-AS TEXT
      867        SIZE 53.25 BY .67
      868        FGCOLOR 1  NO-UNDO.
      869   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      870         VIEW-AS TEXT
      871        SIZE 53.25 BY .67
      872        FGCOLOR 1  NO-UNDO.
      873   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      874         VIEW-AS TEXT
      875        SIZE 53.25 BY .67
      876        FGCOLOR 1  NO-UNDO.
      877   DEFINE RECTANGLE RECT-1
      878        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      879        SIZE 55.13 BY 4.46.
      880   DEFINE FRAME InfoFrame
      881        StopBtn AT ROW 4.25 COL 21.75
      882        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      883        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      884        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      885        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      886        RECT-1 AT ROW 1 COL 1
      887       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      888            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      889            TITLE "Процесс"
      890            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      891   define variable mFrameView      as logical   no-undo init yes.
      892     define variable mFramHandle as handle no-undo.
      893     mFramHandle = frame InfoFrame:handle.
      894     if  log-manager:logfile-name ne ?
      895     then DO:
      896         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      897         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      898         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      899     end.
      900     mFrameView = not session:batch-mode and mFramHandle:visible.
      901     if mFrameView
      902     then do:
      903       ASSIGN
      904          FRAME InfoFrame:HIDDEN                           = TRUE
      905          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      906     end.
      907   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      908   DO:
      909     IF not StopProcessing THEN
      910       Message "Вы действительно хотите прервать" SKIP
      911               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      912                 UPDATE StopProcessing.
      913     IF StopProcessing THEN do:
      914        if mFrameView
      915        then do:
      916           HIDE FRAME InfoFrame.
      917        end.
      918     End.
      919   END.
      920   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
      921     if  log-manager:logfile-name ne ?
      922     then DO:
      923         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      924     end.
      925     if not session:batch-mode then
      926     do:
      927       VIEW FRAME InfoFrame.
      928       mFrameView = true.
      929     end.
      930      v-button-stop = false .
      931         if mFrameView
      932         then do:
      933         if v-button-stop then view STOPBTN in frame InfoFrame.
      934                          else Hide STOPBTN in frame InfoFrame.
      935         end.
      936     define variable all-Sum-zak  as decimal initial 0  no-undo .
      937     define variable all-Sum-prod as decimal initial 0  no-undo .
      938     define variable all-Sum-skid as decimal initial 0  no-undo .
      939     define variable all-EffValue as decimal initial 0  no-undo .
      940       define variable mon  as integer   no-undo .
      941       define variable yer  as integer   no-undo .
      942       define variable dte  as date      no-undo .
      943     DEFINE FRAME Firm-SaleRpt
      944       sym1       column-label ":!:!:"            format "x(1)" space(0)
      945       CliRegCode column-label "Код! ! "          format "x(6)" space(0)
      946       sym2       column-label ":!:!:"            format "x(1)"
      947       CliRegName column-label "Наименование! ! " format "x(40)"
      948       sym3       column-label ":!:!:"            format "x(1)"
      949       m-y        column-label "Месяц!/ Год! "    format "x(7)"
      950       sym4       column-label ":!:!:"            format "x(1)"
      951       sum-zak    column-label "Сумма продаж!в учетных!ценах"    format "->>>>>>>>>9.99"
      952       sum-prod   column-label "Сумма продаж!в ценах!реализации" format "->>>>>>>>>>9.99"
      953       sym5       column-label ":!:!:" format "x(1)"
      954       sum-skid   column-label "Сумма скидок! ! " format "->>>>>>>9.99"
      955       sym6       column-label ":!:!:" format "x(1)"
      956       EffValue   column-label "Эффективность! ! "  format "->>>>>>>>9.99"
      957       sym7       column-label ":!:!:" format "x(1)"
      958       HEADER
      959           string("Дата печати : ") AT 5 format "x(15)" TODAY format "99.99.9999" string(", ") format "X(2)"
      960           string(TIME, "HH:MM")
      961           space(5) ( if v-rb-is-base = yes then "Суммы в базовой валюте" else "Суммы в рублях" ) format "X(22)"
      962           string( "Страница " + string (PAGE-NUMBER( PrnLibStream ) , ">>9") ) AT 114 format "X(15)" SKIP
      963           Line format "x(125)" AT 1
      964     with width 235 down stream-io use-text .
      965   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      967     (output v-rb-is-base
      968     )  .
      969     TOT-DebBaseSum = 0 .
      970     if ( year( StartPoint ) = year( EndPoint ) ) AND ( month( StartPoint ) = month( EndPoint ) ) then OneMonth = TRUE .
      971     else  OneMonth = FALSE .
      972     if SelectBuyers:screen-value in FRAME DLGOKCAN = 'все':U then do:
      973       for each cli-buy where cli-buy.obj-type = 'орг':U no-lock :
      974   define variable vss-include-info11 as character format "X(65)" no-undo
      975   initial "@(#)$Workfile$ $Revision$".
      976     for each buf_trn-doc no-lock
      977       where buf_trn-doc.host-code = p-curr-host-code
      978         and buf_trn-doc.cli-type  = cli-buy.obj-type
