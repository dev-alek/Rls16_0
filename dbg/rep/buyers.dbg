     1391           and buy-data-dt.cur-date2  > buf_trn-doc.fact-date
     1392         no-error .
     1393       if not available buy-data-dt then do:
     1394         create buy-data-dt .
     1395         assign
     1396           buy-data-dt.obj-type = cli-buy.obj-type
     1397           buy-data-dt.obj-code = cli-buy.obj-code
     1398           buy-data-dt.Sum-zak  = 0
     1399           buy-data-dt.Sum-prod = 0
     1400           buy-data-dt.Sum-skid = 0
     1401           buy-data-dt.EffValue = 0
     1402           mon = month( buf_trn-doc.fact-date )
     1403           yer = year ( buf_trn-doc.fact-date )
     1404           buy-data-dt.cur-date1 = date(mon,1,yer)
     1405         .
     1406         if mon < 12 then assign buy-data-dt.cur-date2 = date(mon + 1,1,yer) .
     1407         else             assign buy-data-dt.cur-date2 = date(1,1,yer + 1) .
     1408       end.
     1409       if buf_trn-doc.ext-doc-type = 're':U or
     1410          buf_trn-doc.ext-doc-type = 'rs':U then do:
     1411         if v-rb-is-base = yes then
     1412           assign
     1413             buy-data-dt.Sum-zak  = buy-data-dt.Sum-zak  - buf_trn-doc.fact-base
     1414             buy-data-dt.Sum-skid = buy-data-dt.Sum-skid - buf_trn-doc.tot-calc
     1415             buy-data-dt.Sum-prod = buy-data-dt.Sum-prod - buf_trn-doc.tot-doc + buf_trn-doc.tot-calc
     1416             buy-data.Sum-zak     = buy-data.Sum-zak     - buf_trn-doc.fact-base
     1417             buy-data.Sum-skid    = buy-data.Sum-skid    - buf_trn-doc.tot-calc
     1418             buy-data.Sum-prod    = buy-data.Sum-prod    - buf_trn-doc.tot-doc
     1419           .
     1420         else
     1421           assign
     1422             buy-data-dt.Sum-zak  = buy-data-dt.Sum-zak  - buf_trn-doc.fact-rubl
     1423             buy-data-dt.Sum-skid = buy-data-dt.Sum-skid - buf_trn-doc.discnt-rubl
     1424             buy-data-dt.Sum-prod = buy-data-dt.Sum-prod - buf_trn-doc.tot-rubl + buf_trn-doc.discnt-rubl
     1425             buy-data.Sum-zak     = buy-data.Sum-zak     - buf_trn-doc.fact-rubl
     1426             buy-data.Sum-skid    = buy-data.Sum-skid    - buf_trn-doc.discnt-rubl
     1427             buy-data.Sum-prod    = buy-data.Sum-prod    - buf_trn-doc.tot-rubl
     1428           .
     1429       end.
     1430       else do:
     1431         if v-rb-is-base = yes then
     1432           assign
     1433             buy-data-dt.Sum-zak  = buy-data-dt.Sum-zak  + buf_trn-doc.fact-base
     1434             buy-data-dt.Sum-skid = buy-data-dt.Sum-skid + buf_trn-doc.tot-calc
     1435             buy-data-dt.Sum-prod = buy-data-dt.Sum-prod + buf_trn-doc.tot-doc - buf_trn-doc.tot-calc
     1436             buy-data.Sum-zak     = buy-data.Sum-zak     + buf_trn-doc.fact-base
     1437             buy-data.Sum-skid    = buy-data.Sum-skid    + buf_trn-doc.tot-calc
     1438             buy-data.Sum-prod    = buy-data.Sum-prod    + buf_trn-doc.tot-doc
     1439           .
     1440         else
     1441           assign
     1442             buy-data-dt.Sum-zak  = buy-data-dt.Sum-zak  + buf_trn-doc.fact-rubl
     1443             buy-data-dt.Sum-skid = buy-data-dt.Sum-skid + buf_trn-doc.discnt-rubl
     1444             buy-data-dt.Sum-prod = buy-data-dt.Sum-prod + buf_trn-doc.tot-rubl - buf_trn-doc.discnt-rubl
     1445             buy-data.Sum-zak     = buy-data.Sum-zak     + buf_trn-doc.fact-rubl
     1446             buy-data.Sum-skid    = buy-data.Sum-skid    + buf_trn-doc.discnt-rubl
     1447             buy-data.Sum-prod    = buy-data.Sum-prod    + buf_trn-doc.tot-rubl
     1448           .
     1449       end.
     1450     end.
     1451         end.
     1452       end.
     1453       else MESSAGE "Ошибка: эта ветвь алгоритма не должна была сработать (buyers.w)." VIEW-AS ALERT-BOX ERROR .
     1454     end.
     1455     Line = fill ( "-", 232 ) .
     1456     FORM HEADER
     1457       Line format "X(125)" SKIP
     1458       "Продолжение - на следующей странице" AT 30 SKIP
     1459       with FRAME FirmBottomFrame width 235 PAGE-BOTTOM NO-LABELS no-box.
     1460     VIEW stream PrnLibStream FRAME FirmBottomFrame .
     1461     FORM with FRAME Firm-SaleRpt .
     1462     for each buy-data :
     1463       for each buy-data-dt
     1464         where buy-data-dt.obj-type = buy-data.obj-type
     1465           and buy-data-dt.obj-code = buy-data.obj-code
     1466         :
     1467         assign
     1468           all-Sum-zak  = all-Sum-zak  + buy-data-dt.Sum-zak
     1469           all-Sum-skid = all-Sum-skid + buy-data-dt.Sum-skid
     1470           all-Sum-prod = all-Sum-prod + buy-data-dt.Sum-prod
     1471           buy-data.EffValue    = buy-data.Sum-prod    - buy-data.Sum-zak
     1472           buy-data-dt.EffValue = buy-data-dt.Sum-prod - buy-data-dt.Sum-zak
     1473         .
     1474       end.
     1475     end.
     1476     CASE Sort_Type:screen-value in FRAME DLGOKCAN :
     1477       when "По алфавиту" then do:
     1478   define variable vss-include-info15 as character format "X(65)" no-undo
     1479   initial "@(#)$Workfile$ $Revision$".
     1480     for each buy-data by Name :
     1481       assign
     1482         is-name = yes
     1483         Counter1 = 0
     1484       .
     1485       for each buy-data-dt
     1486         where buy-data-dt.obj-type = buy-data.obj-type
     1487           and buy-data-dt.obj-code = buy-data.obj-code
     1488         :
     1489         display stream PrnLibStream
     1490               sym1 string( buy-data.obj-code ) when (is-name = yes) @ cliregcode
     1491               sym2 buy-data.name               when (is-name = yes) @ cliregname
     1492               sym3 string( string( month(buy-data-dt.cur-date1) ) + "/" + string( year((buy-data-dt.cur-date1)) ) ) @ m-y
     1493               sym4 buy-data-dt.sum-zak         when whatshow:screen-value <> "Только продажные" @ sum-zak
     1494               sym5 buy-data-dt.sum-prod        when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1495               sym6 buy-data-dt.sum-skid        when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1496               sym7 buy-data-dt.EffValue        when whatshow:screen-value = 'все':U              @ effvalue
     1497               with frame firm-salerpt .
     1498            down stream PrnLibStream 1 with frame firm-salerpt .
     1499         if is-name = yes then assign is-name = no .
     1500         assign Counter1 = Counter1 + 1 .
     1501       end.
     1502       if onemonth = no and Counter1 > 1 then do:
     1503         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1504         display stream PrnLibStream
     1505           sym1 "ИТОГО" @ cliregname
     1506           buy-data.sum-zak  when whatshow:screen-value <> "Только продажные"  @ sum-zak
     1507           buy-data.sum-prod when whatshow:screen-value <> "Только учетные"    @ sum-prod
     1508           buy-data.sum-skid when whatshow:screen-value <> "Только учетные"    @ sum-skid
     1509           buy-data.EffValue when whatshow:screen-value = 'все':U               @ effvalue
     1510           sym4     with frame firm-salerpt .
     1511         down stream PrnLibStream 1 with frame firm-salerpt .
     1512         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1513         down stream PrnLibStream 2 with frame firm-salerpt .
     1514       end.
     1515       else underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1516     end.
     1517     assign  all-EffValue = all-Sum-prod - all-Sum-zak - all-Sum-skid .
     1518     display stream PrnLibStream
     1519       sym1 "ВСЕГО" @ cliregname
     1520       sym4 all-Sum-zak  when whatshow:screen-value <> "Только продажные" @ sum-zak
     1521       sym5 all-Sum-prod when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1522       sym6 all-Sum-skid when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1523       sym7 all-EffValue when whatshow:screen-value = 'все':U              @ effvalue
     1524        with frame firm-salerpt .
     1525     down stream PrnLibStream 1 with frame firm-salerpt .
     1526             end.
     1527       when "По возрастанию учетной суммы" then do:
