      643   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   procedure minbtn-set :
      645       do
      646           on error undo, return error return-value
      647           :
      648           define variable ii              as integer       no-undo .
      649           define variable fh              as widget-handle no-undo .
      650           define variable hh              as widget-handle no-undo .
      651           define variable v-h             as handle        extent 4 no-undo .
      652           define variable v-name-button   as character     no-undo .
      653           define variable v-help-old-x    as decimal       no-undo .
      654           define variable v-help-old-y    as decimal       no-undo .
      655           define variable v-help-old-size as decimal       no-undo .
      656           define variable v-frame-width   as decimal       no-undo .
      657           define variable jj              as integer       no-undo .
      658           do
      659               on error undo, return error
      660               :
      661               assign
      662                   v-frame-width = frame DLGOKCAN:width - 0.3
      663                   fh            = frame DLGOKCAN:first-child
      664                   hh            = fh:first-child
      665                   ii            = 1
      666                   .
      667               do while valid-handle(hh):
      668                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      669                   do:
      670                       case lc(hh:name) :
      671                           when "b-help" then
      672                               do:
      673                                   hh:load-image-up("cmp/b-help.bmp":u) .
      674                                   hh:load-image-down("cmp/b-help.bmp":u) .
      675                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      676                                   hh:TOOLTIP = "Помощь" .
      677                                   v-help-old-x = hh:column .
      678                                   v-help-old-y = hh:row    .
      679                                   v-help-old-size = hh:width .
      680                                   hh:width-chars = 2.5 .
      681                               end.
      682                           when "b-print" then
      683                               do:
      684                                   hh:load-image("cmp/b-print.bmp":u) .
      685                                   hh:TOOLTIP = "Печать" .
      686                                   v-h[ii] = hh:handle .
      687                                   ii = ii + 1 .
      688                                   hh:width-chars = 3 .
      689                               end.
      690                           when "b-history" or
      691                           when "b-hist" then
      692                               do:
      693                                   hh:load-image("cmp/b-hist.bmp":u) .
      694                                   hh:TOOLTIP = "История" .
      695                                   v-h[ii] = hh:handle .
      696                                   ii = ii + 1 .
      697                                   hh:width-chars = 3 .
      698                               end.
      699                           when "b-sch" then
      700                               do:
      701                                   hh:load-image("cmp/b-sch.bmp":u) .
      702                                   hh:TOOLTIP = "Установка Фильтра" .
      703                                   v-h[ii] = hh:handle .
      704                                   ii = ii + 1 .
      705                                   hh:width-chars = 3 .
      706                               end.
      707                           when "b-hist-user" then
      708                               do:
      709                                   hh:load-image("cmp/b-hist.bmp":u) .
      710                                   hh:TOOLTIP = "История пользователя" .
      711                                   ii = ii + 1 .
      712                               end.
      713                       end case.
      714                   end.
      715                   hh = hh:next-sibling.
      716               end.
      717               b-help:column = v-frame-width - b-help:width-chars.
      718               jj = 0.
      719               repeat ii = 4 to 1 by -1 :
      720                   if valid-handle (v-h[ii] ) then
      721                   do:
      722                       jj  = jj + 1 .
      723                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      724                       v-h[ii]:row    = v-help-old-y .
      725                   end.
      726               end.
      727           end.
      728       end.
      729   end procedure.
