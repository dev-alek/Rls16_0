     1740               sym1 string( buy-data.obj-code ) when (is-name = yes) @ cliregcode
     1741               sym2 buy-data.name               when (is-name = yes) @ cliregname
     1742               sym3 string( string( month(buy-data-dt.cur-date1) ) + "/" + string( year((buy-data-dt.cur-date1)) ) ) @ m-y
     1743               sym4 buy-data-dt.sum-zak         when whatshow:screen-value <> "Только продажные" @ sum-zak
     1744               sym5 buy-data-dt.sum-prod        when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1745               sym6 buy-data-dt.sum-skid        when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1746               sym7 buy-data-dt.EffValue        when whatshow:screen-value = 'все':U              @ effvalue
     1747               with frame firm-salerpt .
     1748            down stream PrnLibStream 1 with frame firm-salerpt .
     1749         if is-name = yes then assign is-name = no .
     1750         assign Counter1 = Counter1 + 1 .
     1751       end.
     1752       if onemonth = no and Counter1 > 1 then do:
     1753         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1754         display stream PrnLibStream
     1755           sym1 "ИТОГО" @ cliregname
     1756           buy-data.sum-zak  when whatshow:screen-value <> "Только продажные"  @ sum-zak
     1757           buy-data.sum-prod when whatshow:screen-value <> "Только учетные"    @ sum-prod
     1758           buy-data.sum-skid when whatshow:screen-value <> "Только учетные"    @ sum-skid
     1759           buy-data.EffValue when whatshow:screen-value = 'все':U               @ effvalue
     1760           sym4     with frame firm-salerpt .
     1761         down stream PrnLibStream 1 with frame firm-salerpt .
     1762         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1763         down stream PrnLibStream 2 with frame firm-salerpt .
     1764       end.
     1765       else underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1766     end.
     1767     assign  all-EffValue = all-Sum-prod - all-Sum-zak - all-Sum-skid .
     1768     display stream PrnLibStream
     1769       sym1 "ВСЕГО" @ cliregname
     1770       sym4 all-Sum-zak  when whatshow:screen-value <> "Только продажные" @ sum-zak
     1771       sym5 all-Sum-prod when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1772       sym6 all-Sum-skid when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1773       sym7 all-EffValue when whatshow:screen-value = 'все':U              @ effvalue
     1774        with frame firm-salerpt .
     1775     down stream PrnLibStream 1 with frame firm-salerpt .
     1776             end.
     1777       when "По убыванию эффективности" then do:
     1778   define variable vss-include-info21 as character format "X(65)" no-undo
     1779   initial "@(#)$Workfile$ $Revision$".
     1780     for each buy-data by EffValue DESCENDING :
     1781       assign
     1782         is-name = yes
     1783         Counter1 = 0
     1784       .
     1785       for each buy-data-dt
     1786         where buy-data-dt.obj-type = buy-data.obj-type
     1787           and buy-data-dt.obj-code = buy-data.obj-code
     1788         :
     1789         display stream PrnLibStream
     1790               sym1 string( buy-data.obj-code ) when (is-name = yes) @ cliregcode
     1791               sym2 buy-data.name               when (is-name = yes) @ cliregname
     1792               sym3 string( string( month(buy-data-dt.cur-date1) ) + "/" + string( year((buy-data-dt.cur-date1)) ) ) @ m-y
     1793               sym4 buy-data-dt.sum-zak         when whatshow:screen-value <> "Только продажные" @ sum-zak
     1794               sym5 buy-data-dt.sum-prod        when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1795               sym6 buy-data-dt.sum-skid        when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1796               sym7 buy-data-dt.EffValue        when whatshow:screen-value = 'все':U              @ effvalue
     1797               with frame firm-salerpt .
     1798            down stream PrnLibStream 1 with frame firm-salerpt .
     1799         if is-name = yes then assign is-name = no .
     1800         assign Counter1 = Counter1 + 1 .
     1801       end.
     1802       if onemonth = no and Counter1 > 1 then do:
     1803         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1804         display stream PrnLibStream
     1805           sym1 "ИТОГО" @ cliregname
     1806           buy-data.sum-zak  when whatshow:screen-value <> "Только продажные"  @ sum-zak
     1807           buy-data.sum-prod when whatshow:screen-value <> "Только учетные"    @ sum-prod
     1808           buy-data.sum-skid when whatshow:screen-value <> "Только учетные"    @ sum-skid
     1809           buy-data.EffValue when whatshow:screen-value = 'все':U               @ effvalue
     1810           sym4     with frame firm-salerpt .
     1811         down stream PrnLibStream 1 with frame firm-salerpt .
     1812         underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1813         down stream PrnLibStream 2 with frame firm-salerpt .
     1814       end.
     1815       else underline stream PrnLibStream cliregname sum-zak sum-prod sum-skid effvalue with frame firm-salerpt .
     1816     end.
     1817     assign  all-EffValue = all-Sum-prod - all-Sum-zak - all-Sum-skid .
     1818     display stream PrnLibStream
     1819       sym1 "ВСЕГО" @ cliregname
     1820       sym4 all-Sum-zak  when whatshow:screen-value <> "Только продажные" @ sum-zak
     1821       sym5 all-Sum-prod when whatshow:screen-value <> "Только учетные"   @ sum-prod
     1822       sym6 all-Sum-skid when whatshow:screen-value <> "Только учетные"   @ sum-skid
     1823       sym7 all-EffValue when whatshow:screen-value = 'все':U              @ effvalue
     1824        with frame firm-salerpt .
     1825     down stream PrnLibStream 1 with frame firm-salerpt .
     1826             end.
     1827     END CASE.
     1828     DOWN stream PrnLibStream 1 with FRAME Firm-SaleRpt .
     1829     PUT stream PrnLibStream Line format "X(125)" SKIP.
     1830     HIDE stream PrnLibStream FRAME FirmBottomFrame .
     1831   if mFrameView
     1832   then do:
     1833      HIDE FRAME InfoFrame.
     1834   end.
     1835   END PROCEDURE.
     1836   PROCEDURE StartProc :
     1837   define variable CurrMonth  as       integer    no-undo.
     1838   define variable CurrYear   as      integer    no-undo.
     1839   define variable DatasBuf   as      character  no-undo.
     1840       get-key-value section "REP-SETS" key "StartDate" value LifeStartDate.
     1841       assign
     1842           CurrMonth = month ( date ( LifeStartDate ) )
     1843           CurrYear = year ( date ( LifeStartDate ) ) .
     1844       do while CurrYear < year ( today ) :
     1845           do while CurrMonth <= 12 :
     1846               DatasBuf = DatasBuf +
     1847                   string ( CurrMonth, "99" ) + fill( " ", 5 ) + string ( CurrYear, "9999" ) + "," .
     1848               CurrMonth = CurrMonth + 1 .
     1849           end.
     1850           assign
     1851               CurrMonth = 1
     1852               CurrYear = CurrYear + 1 .
     1853       end.
     1854       do CurrMonth = 1 to month ( today ) :
     1855           DatasBuf = DatasBuf +
     1856                               string ( CurrMonth, "99" ) + fill( " ", 5 ) + string ( CurrYear, "9999" ) + "," .
     1857       end.
     1858       TimePeriod:list-items in frame DLGOKCAN = right-trim ( datasbuf, "," ) .
     1859       stat = TimePeriod:scroll-to-item( TimePeriod:num-items in frame DLGOKCAN )
     1860           in frame DLGOKCAN .
     1861     APPLY "value-changed" to SelectBuyers in FRAME DLGOKCAN .
     1862   END PROCEDURE.
