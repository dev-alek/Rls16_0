      528                                                   ).
      529       PUT stream PrnLibStream SPACE(20) string ( "Продажи " + " c  " + string ( StartPoint ) + "  по  " + string ( EndPoint ) +
      530               ( if buygrp_recids <> ? AND buygrp_recids <> "" then "  по группам организаций ( регионам )" else "  по организациям" ) + "." ) format "x(100)" SKIP(1).
      531       PUT stream PrnLibStream SPACE(20) string( "Сортировка : " + lc( Sort_Type:screen-value ) + "." ) format "x(100)" SKIP.
      532       RUN main_proc .
      533       PUT stream PrnLibStream " " SKIP.
      534       output stream PrnLibStream CLOSE.
      535       FOR EACH buy-data :     delete buy-data.     END.
      536       FOR EACH buy-data-dt :  delete buy-data-dt.  END.
      537       run prn-lib-prn-file in this-procedure (
      538                                                 input parParentProc
      539                                                 ,input 0
      540                                                 ).
      541       if session:set-wait-state("") then.
      542       APPLY "ENTRY" TO Btn_OK .
      543     end.
      544     else message "Вы забыли указать требуемый период времени." view-as alert-box ERROR.
      545   END.
      546   ON VALUE-CHANGED OF SelectBuyers IN FRAME DLGOKCAN
      547   DO:
      548     assign SelectBuyers .
      549     if SelectBuyers = 'группа':U then do:
      550       run ref/cli-grps.w ( input parparentproc
      551                           ,input "b-sel"
      552                           ,input-output buygrp_recids ) .
      553       if buygrp_recids = "" then  do:
      554         assign SelectBuyers = 'все':U .
      555         DISPLAY SelectBuyers with FRAME DLGOKCAN .
      556       end.
      557     end.
      558     if SelectBuyers = 'все':U then buygrp_recids = "" .
      559   END.
      560   ON VALUE-CHANGED OF TimePeriod IN FRAME DLGOKCAN
      561   DO:
      562     def var StrBuf              as char         no-undo.
      563     def var PrevMonth       as  integer     no-undo.
      564     def var CurrMonth       as  integer     no-undo.
      565     def var EndLastDay  as  integer     no-undo.
      566     def var ii                  as  integer     no-undo.
      567       StrBuf  = TimePeriod:screen-value .
      568       if num-entries ( StrBuf ) = 1 then
      569           FineDate = TRUE .
      570       else
      571           CheckStrBuf:
      572               DO ii = 2 to num-entries ( StrBuf ) :
      573                   assign
      574                       PrevMonth = integer ( substring ( entry ( ii - 1, StrBuf ), 1, 2 ) )
      575                       CurrMonth = integer ( substring ( entry ( ii, StrBuf ), 1, 2 ) ) .
      576                   if PrevMonth = 12 then
      577                       do:
      578                           if ( CurrMonth = 1 ) AND
      579                              ( integer ( trim ( substring ( entry ( ii - 1, StrBuf ), 3 ) ) ) =
      580                                ( integer ( trim ( substring ( entry ( ii, StrBuf ), 3 ) ) ) - 1 ) ) then
      581                               FineDate = TRUE .
      582                           else
      583                               do:
      584                                   FineDate = FALSE .
      585                                   LEAVE CheckStrBuf.
      586                               end.
      587                       end.
      588                   else
      589                       do:
      590                           if PrevMonth = ( CurrMonth - 1 ) then
      591                               FineDate = TRUE .
      592                           else
      593                               do:
      594                                   FineDate = FALSE .
      595                                   LEAVE CheckStrBuf.
      596                               end.
      597                       end.
      598               END.
      599       if FineDate then
      600           do:
      601               assign
      602                   StartPoint = date ( integer ( substring ( entry ( 1, StrBuf ), 1, 2) ),
      603                                                 integer ( "01" ) ,
      604                                                 integer ( trim ( substring ( entry ( 1, StrBuf ), 3 ) ) ) )
      605                   EndPoint = date ( integer ( substring ( entry ( num-entries ( StrBuf ), StrBuf ), 1, 2) ),
      606                                  integer ( "01" ) ,
      607                                  integer ( trim ( substring ( entry ( num-entries ( StrBuf ), StrBuf ), 3 ) ) ) ) .
      608               run gbl/lastday.p ( input EndPoint, output EndLastDay ) .
      609               EndPoint = date ( integer ( substring ( entry ( num-entries ( StrBuf ), StrBuf ), 1, 2) ),
      610                                  EndLastDay,
      611                                  integer ( trim ( substring ( entry ( num-entries ( StrBuf ), StrBuf ), 3 ) ) ) ) .
      612           end.
      613       else
      614           do:
      615               message "Вы ошиблись : укажите НЕПРЕРЫВНЫЙ период времени."
      616                   view-as alert-box ERROR.
      617               stat = TimePeriod:scroll-to-item( TimePeriod:num-items ) .
      618               TimePeriod:screen-value = "".
      619           end.
      620   END.
      621   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME DLGOKCAN:PARENT eq ?
      622   THEN FRAME DLGOKCAN:PARENT = ACTIVE-WINDOW.
      623   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
