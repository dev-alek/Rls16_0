      826   PROCEDURE main_proc :
      827   define variable grp-path like clients.grp-name no-undo.
      828   define variable Line                as      char     no-undo.
      829   define variable CliRegName   as      char    no-undo.
      830   define variable CliRegCode   as      char    no-undo.
      831   define variable DebBasePcnt  as      char     no-undo.
      832   define variable TOT-DebBaseSum      as  decimal     no-undo.
      833   define variable sym1 as char init ":"   no-undo.
      834   define variable sym2 as char init ":"   no-undo.
      835   define variable sym3 as char init ":"   no-undo.
      836   define variable sym4 as char init ":"   no-undo.
      837   define variable sym5 as char init ":"   no-undo.
      838   define variable sym6 as char init ":"   no-undo.
      839   define variable sym7 as char init ":"   no-undo.
      840   define variable sym8 as char init ":"   no-undo.
