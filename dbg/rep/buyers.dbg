      119   define  stream PrnLibStream.
      120   procedure prn-lib-prn-file :
      121     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      122     define input parameter p-DIsabledoptions as integer no-undo .
      123     define variable v-report-name as character no-undo .
      124     define variable v-user-action as character no-undo .
      125     define variable v-printed     as logical   no-undo .
      126     define variable v-exist       as logical   no-undo .
      127     do
      128       on error undo, return error
      129       :
      130       run prn-lib-get-report-name  in this-procedure (
      131         input parParentProc
      132         ,output v-report-name
      133         ).
      134   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      135   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      136     (input  v-report-name
      137     ,input  2
      138     ,output v-exist
      139     )  .
      140       if NOT v-exist then
      141       DO:
      142         Message
      143           "Нет заданий на печать ! "
      144           view-as alert-box .
      145         Return  .
      146       End.
      147       run gbl/prnfilen.w
      148         (input  ""
      149         ,input  p-DisabledOptions
      150         ,input  string(v-report-name )
      151         ,input  7
      152         ,output v-user-action
      153         ,output v-printed
      154         ) .
      155       if v-printed then
      156       do:
      157         return "YES" .
      158       end.
      159       else
      160       do:
      161         return "NO" .
      162       end.
      163     end.
      164   end procedure.
      165   procedure prn-lib-open-stream :
      166     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      167     define input parameter p-page-size    as integer no-undo .
      168     define input parameter p-is-stream    as logical no-undo .
      169     define input parameter p-append       as logical no-undo .
      170     define variable v-report-name as character no-undo .
      171     do
      172       on error undo, return error
      173       :
      174       run prn-lib-get-report-name  in this-procedure (
      175         input parParentProc
      176         ,output v-report-name
      177         ).
      178       if p-is-stream then
      179       do:
      180         if p-append then
      181         do:
      182           output stream PrnLibStream to value( v-report-name )
      183             page-size value(p-page-size) append .
      184         end.
      185         if not p-append then
      186         do:
      187           output stream PrnLibStream to value( v-report-name )
      188             page-size value(p-page-size) .
      189         end.
      190       end.
      191       if not p-is-stream then
      192       do:
      193         if p-append then
      194         do:
      195           output to value( v-report-name )
      196             page-size value(p-page-size) append .
      197         end.
      198         if not p-append then
      199         do:
      200           output to value( v-report-name )
      201             page-size value(p-page-size) .
      202         end.
      203       end.
      204     end.
      205   end procedure.
      206   procedure prn-lib-open-exp :
      207     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      208     define input parameter p-is-stream    as logical no-undo .
      209     define input parameter p-is-append    as logical no-undo .
      210     define output parameter p-ReportFileName as char init "report" no-undo.
      211     define output parameter p-process as logical no-undo .
      212     define variable glog as logical no-undo .
      213     do
      214       on error undo, return error
      215       :
      216       SYSTEM-DIALOG GET-FILE p-ReportFileName
      217         TITLE      "Укажите путь"
      218         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      219         ASK-OVERWRITE
      220         CREATE-TEST-FILE
      221         SAVE-AS
      222         USE-FILENAME
      223         DEFAULT-EXTENSION "txt"
      224         UPDATE glog
      225         .
      226       if not glog then  return.
      227       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      228       if p-is-stream then
      229       do:
      230         if p-is-append then
      231         do:
      232           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      233         end.
      234         else
      235         do:
      236           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      237         end.
      238       end.
      239       else
      240       do:
      241         if p-is-append then
      242         do:
      243           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      244         end.
      245         else
      246         do:
      247           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      248         end.
      249       end.
      250       p-process = yes.
      251     end.
      252   end procedure.
      253   procedure prn-lib-get-report-name :
      254     define input parameter parParentProc  as widget-handle no-undo.
      255     define output parameter p-report-name as character no-undo .
      256     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      257   end procedure.
      258   procedure prn-lib-reportviewer-report-name :
      259     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      260     define input parameter p-report-name-html as character no-undo .
      261     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      262   end procedure.
      263   procedure prn-lib-reportviewer :
      264     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      265     define input parameter p-report-name-html as character no-undo .
      266     define input parameter p-param        as character no-undo .
      267     define variable v-excel           as character no-undo init 'TRUE' .
      268     define variable v-value-character as character no-undo .
      269     define variable v-value-integer   as character no-undo .
      270     define variable v-value-date      as date      no-undo .
      271     define variable v-value-decimal   as decimal   no-undo .
      272     define variable rep-excel         as logical   no-undo .
      273     define variable excel-string      as character no-undo .
      274     define variable v-param-type      as character no-undo .
      275     define variable v-tth             as handle    no-undo .
      276     run adm/shattri.p (
      277       input "get":U
      278       ,input  ""
      279       ,input  0
      280       ,input  'report-glob':U
      281       ,input  'rep-excel':U
      282       ,output v-value-character
      283       ,output v-value-date
      284       ,output v-value-decimal
      285       ,output v-value-integer
      286       ,output rep-excel
      287       ,output v-param-type
      288       ,INPUT-OUTPUT table-handle v-tth
      289       )  .
      290     if rep-excel then v-excel = "TRUE" .
      291     else v-excel = "FALSE" .
      292     if p-param eq ""
      293     then
      294        p-param = "EXCEL:" + v-excel.
      295     else
      296        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      297     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      298   end procedure.
      299   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   procedure cli-grplib-get-full-name :
      301      define input parameter  p-node-code  as integer      no-undo.
      302      define output parameter p-full-name as character    no-undo.
      303   do
      304   on error undo, return error
      305   :
      306       define variable v-upper-code    as integer           no-undo.
      307       define buffer buf_cli-grp       for ub.cli-grp.
      308       define buffer buf_upper_cli-grp for ub.cli-grp.
      309       find first buf_cli-grp no-lock
      310            where buf_cli-grp.node-code = p-node-code
      311       no-error.
      312       if not available buf_cli-grp
      313       then do:
      314           undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом " + string( p-node-code ).
      315       end.
      316       assign
      317           p-full-name  = ""
      318           v-upper-code = 1
      319       .
      320       do while buf_cli-grp.upper-code <> 0
      321       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      322       :
      323           assign
      324               p-full-name  = buf_cli-grp.node-name
      325                            + (if p-full-name <> "" then chr(47) else "")
      326                            + p-full-name
      327               v-upper-code = buf_cli-grp.upper-code
      328           .
      329           find first buf_cli-grp no-lock
      330                where buf_cli-grp.node-code = v-upper-code
      331           no-error.
      332           if not available buf_cli-grp
      333           then do:
      334               undo, return error "cli-grplib-get-full-name: Не найдена группа клиентов с кодом "
      335                                   + string( v-upper-code )
      336                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      337           end.
      338       end.
      339       assign
      340       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      341       .
      342   end.
      343   end .
      344   procedure cgrplib-get-node-from-full-name :
      345   define input parameter p-full-name as character no-undo .
      346   define output parameter p-node-code as integer no-undo .
      347   define variable v-ii as integer no-undo .
      348   define variable v-upper-code as integer no-undo .
      349   define variable v-root-code as integer no-undo .
      350   define variable v-entry as character no-undo .
      351   define buffer buf_cli-grp       for ub.cli-grp.
      352   do
      353   on error undo, return error
      354   :
      355     find first buf_cli-grp no-lock
      356         where buf_cli-grp.upper-code = 0
      357     no-error .
      358     if not available buf_cli-grp
      359     then do:
      360         undo, return error substitute("Не найдена корневая группа клиентов (upper-code = 0)").
      361     end.
      362     else do:
      363       assign
      364       v-root-code = buf_cli-grp.node-code
      365       .
      366     end.
      367     v-upper-code = v-root-code.
      368     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      369       assign
      370       v-entry = entry(v-ii, p-full-name, chr(47)).
      371       if v-entry = '' then leave.
      372       find first buf_cli-grp no-lock where
      373                 buf_cli-grp.node-name = v-entry
      374             and buf_cli-grp.upper-code = v-upper-code
      375             no-error.
      376       if not available buf_cli-grp then do:
      377         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      378       end.
      379       else do:
      380         p-node-code = buf_cli-grp.node-code.
      381         v-upper-code = buf_cli-grp.node-code.
      382       end.
      383     end.
      384   end.
      385   end .
