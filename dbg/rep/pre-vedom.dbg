      973   function fnc-convert-dot-to-colon returns character
      974       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      975   function fnc-convert-dot-to-colon returns character
      976   (input p-data as decimal, input p-accur as character, input p-num as integer):
      977       define variable result as character no-undo.
      978       define variable v-str-result as character no-undo.
      979       if p-data = ? then p-data = 0 .
      980       p-data = round(p-data, p-num).
      981       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      982       return v-str-result.
      983   END FUNCTION.
