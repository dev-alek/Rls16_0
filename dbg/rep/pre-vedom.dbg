     1028   define variable v-deposit-bank_bik    as character no-undo .
     1029   define variable v-recip-bank          as character no-undo .
     1030   define variable v-recip-bank_name1    as character no-undo .
     1031   define variable v-recip-bank_bik1     as character no-undo .
     1032   define variable v-schet1              as character no-undo .
     1033   define variable v-recip-bank_name2    as character no-undo .
     1034   define variable v-recip-bank_bik2     as character no-undo .
     1035   define variable v-schet2              as character no-undo .
     1036   define variable v-schetUB             as character no-undo .
     1037   define variable v-source              as character no-undo .
     1038   define variable v-source1             as character no-undo .
     1039   define variable v-total-rubl          as character no-undo .
     1040   define variable v-total-kop           as character no-undo .
     1041   define variable v-ii                  as character no-undo .
     1042   define variable name-page-obor        as character no-undo .
     1043   define variable name-page             as character no-undo .
     1044   define variable v-ok-cashGB           as logical   no-undo .
     1045   define variable v-ok-cashUB           as logical   no-undo .
     1046   define variable v-sum-cashGB          as decimal   no-undo .
     1047   define variable v-sum-cashUB          as decimal   no-undo .
     1048   define variable v-sum                 as character no-undo .
     1049   define variable v-simvol              as character no-undo .
     1050   define variable v-name-titul          as character no-undo .
     1051   define variable v-name-titul1         as character no-undo .
     1052   define variable v-cashier             as character no-undo .
     1053   define variable v-decimal             as decimal   no-undo .
     1054   define variable v-pin                 as character no-undo .
     1055   define variable v-qr-code             as integer   no-undo .
     1056   define variable v-hist-name           as character no-undo .
     1057   define variable v-hist-code           as character no-undo .
     1058   define variable v-bank-kredit         as logical   no-undo .
     1059   define variable par-type              as character no-undo .
     1060   define stream Out-Stream.
     1061   define stream OutStr-html.
     1062   define buffer buf_fin-doc      for ub.fin-doc .
     1063   define buffer buf_fin-doc-attr for ub.fin-doc-attr .
     1064   define buffer buf_clients      for ub.clients .
     1065   define buffer buf_clients-attr for ub.clients-attr .
     1066   define buffer buf_fin-bank     for ub.fin-bank .
     1067   do
     1068     on error undo, return error return-value
     1069     :
     1070     find first ub.fin-doc no-lock where ub.fin-doc.fin-doc-code = p-fin-doc-code and ub.fin-doc.host-code = p-host-code no-error .
     1071     v-shift-date = ub.fin-doc.shift-date .
     1072     for first ub.fin-doc-attr no-lock where ub.fin-doc-attr.attr-code = "pre-vedom"
     1073       and ub.fin-doc-attr.fin-doc-code = p-fin-doc-code and ub.fin-doc-attr.host-code = p-host-code:
     1074       assign
     1075         v-num-bag      = entry(1,ub.fin-doc-attr.attr-value,";")
     1076         v-deposit-bank = entry (2,ub.fin-doc-attr.attr-value,";")
     1077         v-recip-bank   = entry (3,ub.fin-doc-attr.attr-value,";")
     1078         .
     1079       for first ub.fin-bank no-lock where ub.fin-bank.code-bank = integer(v-recip-bank) and ub.fin-bank.host-code = ub.fin-doc-attr.host-code:
     1080         find first ub.fin-bank-attr no-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank and ub.fin-bank-attr.host-code = ub.fin-bank.host-code and
     1081           ub.fin-bank-attr.attr-code = "collect-qrcode" no-error .
     1082         if available (ub.fin-bank-attr) then v-qr-code = integer(ub.fin-bank-attr.attr-value) .
     1083         find first ub.fin-bank-attr no-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank and ub.fin-bank-attr.host-code = ub.fin-bank.host-code and
     1084           ub.fin-bank-attr.attr-code = "collect-debt" no-error .
     1085         if available (ub.fin-bank-attr) then v-debt-schet = ub.fin-bank-attr.attr-value .
     1086         find first ub.fin-bank-attr no-lock where ub.fin-bank-attr.code-bank = ub.fin-bank.code-bank and ub.fin-bank-attr.host-code = ub.fin-bank.host-code and
     1087           ub.fin-bank-attr.attr-code = "collect-credit" no-error .
     1088         if available (ub.fin-bank-attr) then v-credit-schet = ub.fin-bank-attr.attr-value .
     1089       end.
     1090       for first ub.fin-bank no-lock where ub.fin-bank.code-bank = integer(v-deposit-bank) and ub.fin-bank.host-code = ub.fin-doc-attr.host-code:
     1091         assign
     1092           v-deposit-bank_name = ub.fin-bank.bank-name
     1093           v-deposit-bank_bik  = ub.fin-bank.bik .
     1094       end.
     1095       for each buf_fin-doc no-lock where buf_fin-doc.host-code = ub.fin-doc.host-code and buf_fin-doc.shift-date = ub.fin-doc.shift-date and buf_fin-doc.shift-name = ub.fin-doc.shift-name
     1096         and buf_fin-doc.obj-code = ub.fin-doc.obj-code and buf_fin-doc.obj-type = ub.fin-doc.obj-type,
     1097         first buf_fin-doc-attr no-lock where buf_fin-doc-attr.attr-code = "pre-vedom" and buf_fin-doc-attr.host-code = buf_fin-doc.host-code and entry(1,buf_fin-doc-attr.attr-value,";") = v-num-bag and
     1098         buf_fin-doc-attr.fin-doc-code = buf_fin-doc.fin-doc-code:
     1099         if buf_fin-doc.CashBookId <> 0 then
     1100         do:
     1101           v-ok-cashUB = yes .
     1102           v-decimal =  buf_fin-doc.sum-doc .
     1103           v-sum-cashUB = v-sum-cashUB + v-decimal .
     1104           v-pin = if v-pin = " " then entry(4,buf_fin-doc-attr.attr-value,";") else v-pin + "/" + entry(4,buf_fin-doc-attr.attr-value,";") .
     1105           for first ub.CashBook no-lock where ub.CashBook.id = buf_fin-doc.CashBookId:
     1106             for each ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     1107               ub.CashBookRule.Code = "BankRecip-acct" and ub.CashBookRule.Status_ = 0:
     1108               v-schet2 = ub.CashBookRule.RuleValue .
     1109             end.
     1110           end.
     1111         end.
     1112         else
     1113         do:
     1114           v-ok-cashGB = yes .
     1115           v-decimal =  buf_fin-doc.sum-doc .
     1116           v-sum-cashGB = v-sum-cashGB + v-decimal .
     1117           v-pin = if v-pin = " " then entry(4,buf_fin-doc-attr.attr-value,";") else v-pin + "/" + entry(4,buf_fin-doc-attr.attr-value,";") .
     1118           for first ub.CashBook no-lock where ub.CashBook.id = buf_fin-doc.CashBookId:
     1119             for each ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = ub.CashBook.id and
     1120               ub.CashBookRule.Code = "BankRecip-acct" and ub.CashBookRule.Status_ = 0:
     1121               v-schet1 = ub.CashBookRule.RuleValue .
     1122             end.
     1123           end.
     1124         end.
     1125         v-fin-doc-list = v-fin-doc-list + ";" + string(buf_fin-doc-attr.fin-doc-code) .
     1126         v-total-sum = v-total-sum + buf_fin-doc.sum-doc .
     1127         v-ii = entry(3,buf_fin-doc-attr.attr-value,";") .
     1128         if lookup (v-ii,v-bank-code,";") = 0 then
     1129         do:
     1130           v-bank-code = v-bank-code + ";" + entry(3,buf_fin-doc-attr.attr-value,";") .
     1131         end.
     1132       end.
     1133       if v-ok-cashGB then v-source = "Поступления от продажи товаров" .
     1134       if v-ok-cashUB then v-source1 = "Прочие поступления" .
     1135       v-source = v-source + ", " + v-source1 .
     1136       find first ub.user-account no-lock where ub.user-account.user-id = v-cntxt-userid no-error .
     1137       assign
     1138         v-cashier = if available ub.user-account then string(ub.user-account.last-name + " " + ub.user-account.first-name + " " + ub.user-account.second-name) else "".
     1139     end.
     1140     v-schet = v-schet1 + "," + v-schet2 .
     1141     v-schet = trim(v-schet,",") .
     1142     if v-debt-schet = "" then v-credit-schet = v-schet .
     1143     v-bank-code = trim (v-bank-code,";") .
     1144     v-fin-doc-list = trim(v-fin-doc-list,";") .
     1145     v-source = trim(v-source,", ") .
     1146     do ii = 1 to num-entries (v-bank-code,";"):
     1147       for first ub.fin-bank no-lock where ub.fin-bank.code-bank = integer(entry (ii,v-bank-code,";")) and ub.fin-bank.host-code = p-host-code:
     1148         do jj = 1 to num-entries (v-schet,","):
     1149           for first ub.fin-schet no-lock where ub.fin-schet.code-bank = ub.fin-bank.code-bank and ub.fin-schet.status_ = 'тек':U and
     1150             ub.fin-schet.r-schet = entry (jj,v-schet,","):
     1151             if v-recip-bank_name1 <> "" then
     1152             do:
     1153               v-recip-bank_name2 = ub.fin-bank.bank-name .
     1154             end.
     1155             else v-recip-bank_name1 = ub.fin-bank.bank-name .
     1156             if v-recip-bank_bik1 <> "" then
     1157             do:
     1158               v-recip-bank_bik2 = ub.fin-bank.bik .
     1159             end.
     1160             else v-recip-bank_bik1 = ub.fin-bank.bik .
     1161           end.
     1162         end.
     1163       end.
     1164     end.
     1165     v-total-rubl = Sum-in-Words-Without-Dec(v-total-sum) .
     1166     v-total-kop = string((v-total-sum - truncate(v-total-sum, 0)) * 100, "99":U) .
     1167     do ii = 1 to num-entries(v-fin-doc-list,";"):
     1168       empty temp-table tt-banknots .
     1169       empty temp-table tt-coins .
     1170       for first buf_fin-doc-attr no-lock where buf_fin-doc-attr.fin-doc-code = integer(entry(ii,v-fin-doc-list,";")) and buf_fin-doc-attr.host-code = p-host-code
     1171         and buf_fin-doc-attr.attr-code = "cover_sheet":
     1172         CSJson = buf_fin-doc-attr.attr-value .
     1173         if CSJson <> "" and CSJson <> ? then
     1174         do:
     1175           dataset ds-banknots:handle:read-json ("longchar",CSJson) .
     1176           for each tt-banknots no-lock where tt-banknots.qnty <> 0:
     1177             find first tt-monets exclusive-lock where tt-monets.id = tt-banknots.id no-error .
     1178             if not available (tt-monets) then
     1179             do:
     1180               create tt-monets .
     1181               tt-monets.id = tt-banknots.id .
     1182             end.
     1183             assign
     1184               tt-monets.qnty     = tt-monets.qnty + tt-banknots.qnty
     1185               tt-monets.sum-qnty = tt-monets.sum-qnty + tt-banknots.sum-qnty
     1186               .
     1187           end.
     1188           for each tt-coins no-lock where tt-coins.qnty <> 0:
     1189             find first tt-monets exclusive-lock where tt-monets.id = tt-coins.id no-error .
     1190             if not available (tt-monets) then
     1191             do:
     1192               create tt-monets .
     1193               tt-monets.id = tt-coins.id .
     1194             end.
     1195             assign
     1196               tt-monets.qnty     = tt-monets.qnty + tt-coins.qnty
     1197               tt-monets.sum-qnty = tt-monets.sum-qnty + tt-coins.sum-qnty
     1198               .
     1199           end.
     1200         end.
     1201       end.
     1202     end.
     1203     find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = ub.fin-doc.host-code no-error .
     1204     if available (buf_clients) then v-firm = buf_clients.obj-name .
     1205     find first ub.firm no-lock where ub.firm.firm-code = ub.fin-doc.host-code no-error .
     1206     v-inn = ub.firm.inn .
     1207     find first buf_clients no-lock where buf_clients.obj-type = ub.fin-doc.obj-type and buf_clients.obj-code = ub.fin-doc.obj-code no-error .
     1208     if available (buf_clients) then v-obj-name = buf_clients.obj-name .
     1209     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-code':U,OUTPUT v-hist-code ,OUTPUT par-type) .
     1210     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-name':U,OUTPUT v-hist-name ,OUTPUT par-type) .
     1211     if v-hist-name = "" then v-hist-name = v-obj-name .
     1212     if v-qr-code = 1 then
     1213     do:
     1214   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1215   procedure base64-encode :
     1216     define input  parameter v-string        as character no-undo .
     1217     define output parameter v-base64-encode as character no-undo .
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       define variable v-raw     as raw       no-undo .
     1222       define variable v-raw-str as character no-undo .
     1223       if v-string = ?
     1224       then do:
     1225         undo, return error "base64-encode: строка имеет неопределенное значение" .
     1226       end.
     1227       assign
     1228         length(v-raw) = length(v-string) + 1
     1229       .
     1230       assign
     1231         put-string(v-raw, 1) = v-string
     1232       .
     1233       assign
     1234         v-raw-str = string(v-raw)
     1235       .
     1236       assign
     1237         length(v-raw) = 0
     1238       .
     1239       assign
     1240         v-base64-encode = substring(v-raw-str, 7)
     1241       .
     1242     end.
     1243   end.
     1244       define variable qr-code     as character no-undo.
     1245       define variable qr-code-out as character no-undo.
     1246       qr-code = '<?xml version="1.0" encoding="windows-1251" standalone="yes"?>
     1247   <client_info><client_info_row>
     1248   <client_ink>8598123368358741900012</client_ink>
     1249   <client_ino>156885</client_ino>
     1250   <client_name>АЗС№02-136 БашнефтьРозница</client_name>
     1251   <client_organization_name>Общество с ограниченной ответственностью "Башнефть-Розница"</client_organization_name>
     1252   <client_address xsi:type="xs:string" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">Чишмы, Железнодорожная,1-1</client_address>
     1253   <client_inn>1831090630</client_inn>
     1254   <client_kpp>027801001</client_kpp>
     1255   <client_accounts>
     1256   <acc_num>40702810306000008673</acc_num>
     1257   <bic>048073601</bic>
     1258   <bank_name>БАШКИРСКОЕ ОТДЕЛЕНИЕ N8598 ПАО СБЕРБАНК Г.Уфа</bank_name>
     1259   </client_accounts>
     1260   <client_accounts>
     1261   <acc_num>40821810200000000015</acc_num>
     1262   <bic>044525880</bic>
     1263   <bank_name>БАНК "ВБРР" (АО) Г.Москва</bank_name>
     1264   </client_accounts>
     1265   <bank_name>БАШКИРСКОЕ ОТДЕЛЕНИЕ N8598 ПАО СБЕРБАНК Г.УФА</bank_name>
     1266   <bank_bic>048073601</bank_bic>
     1267   <debet_account xsi:nil="true" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/>
     1268   </client_info_row></client_info>'.
     1269       run base64-encode (qr-code,output qr-code-out).
     1270       define variable v-arc as character no-undo .
     1271       define variable v-cmd as character no-undo .
     1272       assign
     1273         v-arc = search( "exe/qrgen.exe":U )
     1274         .
     1275       if v-arc = ? then
     1276       do:
     1277         return error "Не найдена программа qrgen.exe" .
     1278       end.
     1279       os-command silent value (v-arc + ' -size=128 -content="' + qr-code-out + '"' + ' -filename="c:\temp\qr-code"') .
     1280     end.
     1281     run get-report-num  (output g#report-num).
     1282     do jj = 1 to 3:
     1283       v-file-name-rep-html = session:temp-directory + string(g#report-num) + "_" + string (jj) + ".html".
     1284       output stream OutStr-html to value(v-file-name-rep-html) convert target 'UTF-8'.
     1285       put stream OutStr-html unformatted
     1286         "<!DOCTYPE HTML>" skip
     1287         ' <html>' skip
     1288         '  <head>' skip
     1289         '   <meta charset="utf-8">' skip
     1290         '    <style type="text/css">' skip
     1291         '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1292         '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     1293         '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     1294         '   </style>' skip
     1295         '  </head>' skip
     1296         '<body>' skip
     1297         .
     1298       put stream OutStr-html unformatted
     1299         '<TABLE fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0" name="Ведомость_1">'skip
     1300         .
     1301       put stream OutStr-html unformatted
     1302         '<thead>' skip.
     1303       put stream OutStr-html unformatted
