      347   procedure prn-lib-open-stream :
      348     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      349     define input parameter p-page-size    as integer no-undo .
      350     define input parameter p-is-stream    as logical no-undo .
      351     define input parameter p-append       as logical no-undo .
      352     define variable v-report-name as character no-undo .
      353     do
      354       on error undo, return error
      355       :
      356       run prn-lib-get-report-name  in this-procedure (
      357         input parParentProc
      358         ,output v-report-name
      359         ).
      360       if p-is-stream then
      361       do:
      362         if p-append then
      363         do:
      364           output stream PrnLibStream to value( v-report-name )
      365             page-size value(p-page-size) append .
      366         end.
      367         if not p-append then
      368         do:
      369           output stream PrnLibStream to value( v-report-name )
      370             page-size value(p-page-size) .
      371         end.
      372       end.
      373       if not p-is-stream then
      374       do:
      375         if p-append then
      376         do:
      377           output to value( v-report-name )
      378             page-size value(p-page-size) append .
      379         end.
      380         if not p-append then
      381         do:
      382           output to value( v-report-name )
      383             page-size value(p-page-size) .
      384         end.
      385       end.
      386     end.
      387   end procedure.
      388   procedure prn-lib-open-exp :
      389     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      390     define input parameter p-is-stream    as logical no-undo .
      391     define input parameter p-is-append    as logical no-undo .
      392     define output parameter p-ReportFileName as char init "report" no-undo.
      393     define output parameter p-process as logical no-undo .
      394     define variable glog as logical no-undo .
      395     do
      396       on error undo, return error
      397       :
      398       SYSTEM-DIALOG GET-FILE p-ReportFileName
      399         TITLE      "Укажите путь"
      400         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      401         ASK-OVERWRITE
      402         CREATE-TEST-FILE
      403         SAVE-AS
      404         USE-FILENAME
      405         DEFAULT-EXTENSION "txt"
      406         UPDATE glog
      407         .
      408       if not glog then  return.
      409       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      410       if p-is-stream then
      411       do:
      412         if p-is-append then
      413         do:
      414           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      415         end.
      416         else
      417         do:
      418           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      419         end.
      420       end.
      421       else
      422       do:
      423         if p-is-append then
      424         do:
      425           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      426         end.
      427         else
      428         do:
      429           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      430         end.
      431       end.
      432       p-process = yes.
      433     end.
      434   end procedure.
      435   procedure prn-lib-get-report-name :
      436     define input parameter parParentProc  as widget-handle no-undo.
      437     define output parameter p-report-name as character no-undo .
      438     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      439   end procedure.
      440   procedure prn-lib-reportviewer-report-name :
      441     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      442     define input parameter p-report-name-html as character no-undo .
      443     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      444   end procedure.
      445   procedure prn-lib-reportviewer :
      446     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      447     define input parameter p-report-name-html as character no-undo .
      448     define input parameter p-param        as character no-undo .
      449     define variable v-excel           as character no-undo init 'TRUE' .
      450     define variable v-value-character as character no-undo .
      451     define variable v-value-integer   as character no-undo .
      452     define variable v-value-date      as date      no-undo .
      453     define variable v-value-decimal   as decimal   no-undo .
      454     define variable rep-excel         as logical   no-undo .
      455     define variable excel-string      as character no-undo .
      456     define variable v-param-type      as character no-undo .
      457     define variable v-tth             as handle    no-undo .
      458     run adm/shattri.p (
      459       input "get":U
      460       ,input  ""
      461       ,input  0
      462       ,input  'report-glob':U
      463       ,input  'rep-excel':U
      464       ,output v-value-character
      465       ,output v-value-date
      466       ,output v-value-decimal
      467       ,output v-value-integer
      468       ,output rep-excel
      469       ,output v-param-type
      470       ,INPUT-OUTPUT table-handle v-tth
      471       )  .
      472     if rep-excel then v-excel = "TRUE" .
      473     else v-excel = "FALSE" .
      474     if p-param eq ""
      475     then
      476        p-param = "EXCEL:" + v-excel.
      477     else
      478        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      479     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      480   end procedure.
      481   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      482   FUNCTION Break-n-line RETURNS CHARACTER
      483     ( INPUT p-ost as char,
      484       INPUT p-lengths  as character,
      485       OUTPUT output-num-lines as integer
      486       ) :
      487   define variable ii as integer no-undo.
      488   define variable jj as integer no-undo.
      489   define variable linei as character no-undo extent 10.
      490   define variable line-length as integer no-undo extent 10.
      491   define variable num-line as integer no-undo .
      492   define variable v-line as character no-undo .
      493   do ii = 1 to MIN(num-entries(p-lengths), 10):
      494     assign
      495     line-length[ii] = integer(entry(ii, p-lengths))
      496     num-line = ii
      497     .
      498   end.
      499   do jj = 1 to num-line:
      500     if Length ( p-ost ) <= line-length[jj] then do:
      501       assign
      502       output-num-lines = jj
      503       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      504       .
      505       return v-line.
      506     end.
      507     assign
      508     ii = 1
      509     .
      510     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      511     then do:
      512       assign
      513       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      514       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      515       .
      516     end.
      517     else do:
      518       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      519         assign
      520         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      521         ii = ii + 1
      522         .
      523         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      524         assign
      525         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      526         .
      527       END.
      528       assign
      529       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      530       .
      531     end.
      532     assign
      533     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      534     .
      535     if p-ost = "":U then LEAVE.
      536   end.
      537   assign
      538   output-num-lines = jj.
      539   RETURN v-line.
      540   END FUNCTION.
      541   FUNCTION Center-Field RETURNS CHARACTER
      542     ( INPUT p-str as char,
      543       INPUT p-format as integer,
      544       INPUT p-Length as integer,
      545       INPUT p-fill as character
      546       ) :
      547   define variable v-str as character no-undo .
      548   define variable v-left as integer no-undo .
      549   define variable v-dop as integer no-undo .
      550   assign
      551   p-str = trim(p-str)
      552   .
      553   if p-str = "":U then return fill(p-fill, p-length).
      554   if length(p-str) >= p-format then
      555   p-str = substr(p-str, 1, p-format).
      556   else do:
      557     p-format = length(p-str).
      558   end.
      559   if p-format < p-length then do:
      560     assign
      561     v-left = (p-length - p-format )
      562     v-dop = (if v-left modulo 2 = 1
      563              then 1
      564              else 0)
      565     v-left = (if (v-left modulo 2 = 1)
      566              then (v-left - 1 ) / 2
      567              else v-left / 2)
      568     v-str =  fill(p-fill, v-left) +
      569              string(p-str, "X(":U + string(p-format) + ")":U) +
      570              fill(p-fill, v-left) + fill(p-fill, v-dop)
      571     .
      572     return v-str.
      573   end.
      574   else do:
      575     return string(p-str, "X(":U + string(p-length) + ")":U).
      576   end.
      577   END FUNCTION.
      578   FUNCTION Left-Field RETURNS CHARACTER
      579     ( INPUT p-str as char,
      580       INPUT p-format as integer,
      581       INPUT p-Length as integer,
      582       INPUT p-fill as character
      583       ) :
      584   define variable v-str as character no-undo .
      585   define variable v-left as integer no-undo .
      586   define variable v-dop as integer no-undo .
      587   assign
      588   p-str = trim(p-str)
      589   .
      590   if p-str = "":U then return fill(p-fill, p-length).
      591   if length(p-str) >= p-format then
      592   p-str = substr(p-str, 1, p-format).
      593   else do:
      594     p-format = length(p-str).
      595   end.
      596   if p-format < p-length then do:
      597     assign
      598     v-dop =  p-length - p-format
      599     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      600              fill(p-fill, v-dop)
      601     .
      602     return v-str.
      603   end.
      604   else do:
      605     return string(p-str, "X(":U + string(p-length) + ")":U).
      606   end.
      607   END FUNCTION.
      608   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      609     ( INPUT p-sum as decimal,
      610       INPUT p-rub-length as integer,
      611       INPUT p-kop-length as integer,
      612       INPUT p-fill as character,
      613       INPUT p-razr-delim as character,
      614       INPUT p-rub-str  as character,
      615       INPUT p-kop-str  as character
      616       ) :
      617   define variable v-str as character no-undo .
      618   define variable v-format as character no-undo .
      619   define variable v-dopi as integer no-undo .
      620   define variable v-dopi2 as integer no-undo .
      621   assign
      622   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      623   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      624   .
      625   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      626   assign
      627   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      628   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      629   .
      630   assign
      631   v-str = fill(p-fill, p-rub-length - v-dopi) +
      632           string(truncate(p-sum, 0), v-format) +
      633           p-rub-str +
      634           fill(p-fill, p-kop-length - 2) +
      635           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      636   .
      637   return v-str.
      638   END FUNCTION.
      639   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      640     ( INPUT p-sum as decimal,
      641       INPUT p-sum-length as integer,
      642       INPUT p-curr-code as integer,
      643       INPUT p-fill as character,
      644       INPUT p-razr-delim as character
      645       ) :
      646   define variable v-str as character no-undo .
      647   define variable v-format as character no-undo .
      648   define variable v-dopi as integer no-undo .
      649   define variable v-dopi2 as integer no-undo .
      650   define variable v-curr-name as character no-undo .
      651   define buffer buf_currency for ub.currency.
      652   find first buf_currency no-lock where
      653             buf_currency.curr-code = p-curr-code no-error .
      654   if not avail buf_currency
      655   then v-curr-name = "неизвестная валюта".
      656   else
      657   assign
      658   v-curr-name = buf_currency.curr-name
      659   .
      660   assign
      661   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      662   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      663   .
      664   if v-dopi > p-sum-length then return "?".
      665   assign
      666   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      667   v-dopi = length(trim(string(p-sum, v-format)))
      668   .
      669   assign
      670   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      671           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      672           trim(string(p-sum, v-format))
      673   .
      674   return v-str.
      675   END FUNCTION.
      676   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      677   (input v-sum as decimal
      678   ):
      679   define variable v-str as character no-undo .
      680   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      681   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      682   return v-str.
      683   END FUNCTION.
      684   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      685   (input p-sum as decimal
      686    ,input p-curr-code as integer
      687   ):
      688   define variable v-str as character no-undo .
      689   define variable Copeck as character no-undo.
      690   define variable Rouble as character no-undo.
      691   define variable v-Word as character no-undo.
      692   define variable ii as integer init 18 no-undo.
      693   define variable v-str-rubl as character no-undo .
      694   define variable v-kop as integer no-undo .
      695   define buffer buf_currency for ub.currency.
      696   assign
      697   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      698   find first buf_currency no-lock where
      699             buf_currency.curr-code = p-curr-code no-error .
      700   if not available buf_currency then return chr(63).
      701   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      702     CASE substring(v-Word, ii - 3,1):
      703       WHEN "1" THEN DO:
      704         if substring(v-Word, ii - 4,1) = "1" then
      705             Rouble = buf_currency.curr-name-five .
      706         else
      707             Rouble = buf_currency.curr-name-one .
      708       END.
      709       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      710         if substring(v-Word, ii - 4,1) = "1" then
      711            Rouble = buf_currency.curr-name-five .
      712            else
      713            Rouble = buf_currency.curr-name-three .
      714         END.
      715       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      716          Rouble = buf_currency.curr-name-five .
      717       END.
      718     END CASE.
      719   end.
      720   CASE substring(v-Word, ii, 1):
      721     WHEN "1" THEN DO:
      722       if substring(v-Word, ii - 1, 1) = "1" then
      723           Copeck = buf_currency.part-name-five .
      724       else
      725           Copeck = buf_currency.part-name-one .
      726     END.
      727     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      728       if substring(v-Word, ii - 1, 1) = "1" then
      729           Copeck = buf_currency.part-name-five .
      730       else
      731           Copeck = buf_currency.part-name-three .
      732     END.
      733     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      734       Copeck = buf_currency.part-name-five .
      735     END.
      736   END CASE.
      737   run gbl/num-rus.p ( input absolute( p-sum )
      738                , output v-str-rubl).
      739   assign
      740   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      741           ) * 100
      742   .
      743   v-str = ( if p-Sum < 0 then "- " else "" ) +
      744               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      745               string(v-kop, "99":U) + chr(32) + Copeck .
      746   return v-str.
      747   END FUNCTION.
      748   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      749   (input v-sum as decimal,
      750   input v-razr as integer
      751   ):
      752   define variable v-str as character no-undo .
      753   define variable v-dec-separ as character no-undo .
      754   case SESSION:NUMERIC-FORMAT:
      755     when "American":U then do:
      756       assign
      757       v-dec-separ = ".":U
      758       .
      759     end.
      760     when "European":U then do:
      761       assign
      762       v-dec-separ = ",":U
      763       .
      764     end.
      765   END CASE.
      766   assign
      767   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      768   .
      769   return v-str.
      770   END FUNCTION.
      771   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      772     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      773     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      774     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      775   END FUNCTION.
      776   PROCEDURE get-month-name-gen :
      777     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      778     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      779     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      780     DO ON ERROR UNDO, RETURN ERROR :
      781       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      782     END.
      783   END PROCEDURE.
