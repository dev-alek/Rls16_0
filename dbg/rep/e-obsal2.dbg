      708            SIDE-LABELS NO-UNDERLINE THREE-D
      709            AT COL 1 ROW 1 SCROLLABLE .
      710   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      711   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      712   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      713   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      714   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      715   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      716   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      717   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      718         adm-object-hdl = FRAME F-Main:HANDLE.
      719   RUN ensure-broker.
      720   THIS-PROCEDURE:ADM-DATA =
      721        'ADM1.1~`':U +
      722        'SmartObject~`':U +
      723        '~`':U +
      724        'NO ~`':U +
      725        '~`':U +
      726        '~`':U +
      727        '~`':U +
      728        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      729           + "~`":U +
      730        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      731        'Record-Source,Record-Target,TableIO-Target~`':U +
      732        '~`':U +
      733        '~`~`~`~`~`~`~`~`~`~`~`':U +
      734        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      735            THEN "^^":U
      736        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      737             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      738   PROCEDURE adm-apply-entry :
      739     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      740   END PROCEDURE.
      741   PROCEDURE adm-destroy :
      742    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      743   END PROCEDURE.
      744   PROCEDURE adm-disable :
      745       DISABLE RECT-6 RECT-7 RECT-8 contr-code BUTTON-contr is-real snum is-fo itog-contract is-fin itog-only is-date WITH FRAME F-Main.
      746       RUN dispatch ('disable-fields':U).
      747       RUN set-attribute-list ('ENABLED=no':U).
      748       RETURN.
      749   END PROCEDURE.
      750   PROCEDURE adm-edit-attribute-list :
      751         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      752         RETURN.
      753   END PROCEDURE.
      754   PROCEDURE adm-enable :
      755       ENABLE UNLESS-HIDDEN RECT-6 RECT-7 RECT-8 contr-code BUTTON-contr is-real snum is-fo itog-contract is-fin itog-only is-date WITH FRAME F-Main.
      756       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      757       RUN set-attribute-list ('ENABLED=yes':U).
      758       RETURN.
      759   END PROCEDURE.
      760   PROCEDURE adm-exit :
      761        RUN notify ('exit':U).
      762     RETURN.
      763   END PROCEDURE.
      764   PROCEDURE adm-hide :
      765     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      766   END PROCEDURE.
      767   PROCEDURE adm-initialize :
      768     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      769   END PROCEDURE.
      770   PROCEDURE adm-show-errors :
      771       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      772       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      773           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      774       END.
      775       RETURN.
      776   END PROCEDURE.
      777   PROCEDURE adm-UIB-mode :
      778     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      779   END PROCEDURE.
      780   PROCEDURE adm-view :
      781     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      782   END PROCEDURE.
      783   PROCEDURE dispatch :
      784       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      785       RUN broker-dispatch IN adm-broker-hdl
      786           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      787       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      788   END PROCEDURE.
      789   PROCEDURE ensure-broker :
      790   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      791   IF RETURN-VALUE NE "ADM-Broker":U THEN
      792   DO:
      793       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      794       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      795   END.
      796   END PROCEDURE.
      797   PROCEDURE get-attribute :
      798     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      799     RUN broker-get-attribute IN adm-broker-hdl
      800         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      801     RETURN RETURN-VALUE.
      802   END PROCEDURE.
      803   PROCEDURE get-attribute-list :
      804     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      805     RUN broker-get-attribute-list IN adm-broker-hdl
      806         (INPUT THIS-PROCEDURE,
      807          INPUT ?,
      808          OUTPUT p-attr-list) NO-ERROR.
      809     RETURN.
      810   END PROCEDURE.
      811   PROCEDURE new-state :
      812     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      813     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      814     RETURN.
      815   END PROCEDURE.
      816   PROCEDURE notify :
      817     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      818     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      819     IF RETURN-VALUE = "ADM-ERROR":U THEN
      820         RETURN "ADM-ERROR":U.
      821     RETURN.
      822   END PROCEDURE.
      823   PROCEDURE set-attribute-list :
      824     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      825     RUN ensure-broker.
      826     RUN broker-set-attribute-list IN adm-broker-hdl
      827         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      828     RETURN.
      829   END PROCEDURE.
      830   PROCEDURE set-position :
      831       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      832       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      833       IF VALID-HANDLE(adm-object-hdl) THEN
      834       DO:
      835         ASSIGN adm-object-hdl:ROW    =   p-row
      836                adm-object-hdl:COLUMN =   p-col.
      837       END.
      838       RETURN.
      839   END PROCEDURE.
      840   PROCEDURE adm-display-fields :
      841       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      842       RETURN.
      843   END PROCEDURE.
      844   PROCEDURE adm-open-query :
      845     RETURN.
      846   END PROCEDURE.
      847   PROCEDURE adm-row-changed :
      848         IF VALID-HANDLE(adm-object-hdl) THEN
      849           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      850         RUN notify ('row-available':U).
      851         RETURN.
      852   END PROCEDURE.
      853   PROCEDURE reposition-query :
      854       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      855       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      856       RETURN.
      857   END PROCEDURE.
      858     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      859     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      860     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      861     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      862     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      863     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      864     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      865     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      866     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      867     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      868     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      869     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      870     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      871     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      872     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      873     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      874     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      875     IF "":U = "":U THEN
      876       RUN modify-list-attribute IN adm-broker-hdl
      877         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      878     RUN use-create-on-add(?).
      879   PROCEDURE adm-add-record :
