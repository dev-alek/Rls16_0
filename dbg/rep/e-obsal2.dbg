      931   PROCEDURE adm-update-record :
      932       MESSAGE
      933         "Object ":U THIS-PROCEDURE:FILE-NAME
      934           "must have at least one Enabled Table to perform Update.":U
      935             VIEW-AS ALERT-BOX ERROR.
      936      RETURN.
      937   END PROCEDURE.
      938   PROCEDURE check-modified :
      939   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      940   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      941   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      942   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      943     IF check-state = "check":U THEN
      944     DO:
      945       RUN get-link-handle IN adm-broker-hdl
      946         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      947            OUTPUT group-target-list).
      948       IF group-target-list NE "":U THEN
      949       DO i = 1 TO NUM-ENTRIES(group-target-list):
      950         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      951         RUN check-modified IN curr-widget ('group-check':U).
      952         IF RETURN-VALUE NE "":U THEN
      953         DO:
      954           RUN check-modified-message(RETURN-VALUE).
      955           RETURN "":U.
      956         END.
      957       END.
      958     END.
      959     RETURN "":U.
      960   END PROCEDURE.
      961   PROCEDURE check-modified-message :
      962     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      963        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      964           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      965        IF RETURN-VALUE = "YES":U THEN
      966           RUN notify ('view,CONTAINER-SOURCE':U).
      967        MESSAGE IF p-changed-table NE ? THEN
      968           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      969           ELSE "Current values have been changed."
      970           SKIP "  Do you wish to save those changes?"
      971           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      972        IF ANS THEN
      973        DO:
      974           IF group-assign-target THEN
      975             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      976           ELSE RUN dispatch('update-record':U).
      977           IF RETURN-VALUE = "ADM-ERROR":U THEN
      978           DO:
      979               MESSAGE "Changes to the previous record were not saved."
      980                 VIEW-AS ALERT-BOX ERROR.
      981               IF group-assign-target THEN
      982                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      983               ELSE RUN dispatch ('cancel-record':U).
      984           END.
      985        END.
      986        ELSE DO:
      987          IF group-assign-target THEN
      988             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      989          ELSE RUN dispatch('cancel-record':U).
      990        END.
      991        RETURN.
      992   END PROCEDURE.
      993   PROCEDURE get-rowid :
      994       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      995       ASSIGN
      996       p-table   =   adm-first-table.
      997       RETURN.
      998   END PROCEDURE.
      999   PROCEDURE init-group-assign :
     1000       RUN request-attribute IN adm-broker-hdl
     1001         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1002       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1003         group-assign-target = yes.
     1004       ELSE group-assign-target = no.
     1005       RETURN.
     1006   END PROCEDURE.
     1007   PROCEDURE set-editors :
     1008       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1009       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1010       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1011       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1012       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1013       DO WHILE VALID-HANDLE (curr-widget):
     1014           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1015              curr-widget:HIDDEN = no THEN DO:
     1016             CASE p-field-setting:
     1017               WHEN "INITIALIZE":U THEN
     1018               DO:
     1019                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1020                     read-only-list +
     1021                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1022                        STRING(curr-widget).
     1023               END.
     1024               WHEN "DISABLE":U OR
     1025               WHEN "ENABLE":U THEN
     1026               DO:
     1027                   curr-widget:SENSITIVE = yes.
     1028                   RUN get-attribute ('Read-Only-Editors':U).
     1029                   IF RETURN-VALUE = ? OR
     1030                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1031                       curr-widget:READ-ONLY =
     1032                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1033               END.
     1034               WHEN "CLEAR":U THEN
     1035                   curr-widget:SCREEN-VALUE = "":U.
     1036             END CASE.
     1037           END.
     1038           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1039       END.
     1040       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1041         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1042           + '"':U).
     1043       RETURN.
     1044   END PROCEDURE.
     1045   PROCEDURE use-check-modified-all :
     1046    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1047     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1048     RETURN.
     1049   END PROCEDURE.
     1050   PROCEDURE use-create-on-add :
     1051   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1052      RETURN.
     1053   END PROCEDURE.
     1054   PROCEDURE use-initial-lock :
     1055     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1056     ASSIGN adm-initial-lock = p-attr-value.
     1057     RETURN.
     1058   END PROCEDURE.
     1059     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1060   ASSIGN
     1061          FRAME F-Main:SCROLLABLE       = FALSE
     1062          FRAME F-Main:HIDDEN           = TRUE.
     1063   ON CHOOSE OF BUTTON-contr IN FRAME F-Main
     1064   DO:
     1065     run str/cont-all.w (input parParentProc, input v-cntxt-host-code-obj, input "b-sel", input 'фирма':U, input ?,
     1066                     input ?, input ?, input ?, input "current":u, input 'рас':U, input-output contr-list).
     1067     if contr-list <> "" then do:
     1068       find first contract no-lock where RECID(contract) = int (contr-list) no-error .
     1069       if available contract then do:
     1070         assign
     1071           contr-code = contract.contract-code
     1072           snum    = contract.contract-prn-code + " от " + string(contract.contract-date,"99/99/9999")
     1073         .
     1074       end.
     1075       else assign  contr-code = 0   snum = "" .
     1076     end.
     1077     display contr-code snum with frame F-Main.
     1078   END.
     1079   ON LEAVE OF contr-code IN FRAME F-Main
     1080   DO:
     1081     assign contr-code.
     1082     run  FindRec in this-procedure  ( input 0 ) .
     1083   END.
     1084   ON RETURN OF contr-code IN FRAME F-Main
     1085   DO:
     1086     assign contr-code.
     1087     run FindRec in this-procedure  ( input 0 ) .
     1088   END.
     1089   ON LEAVE OF snum IN FRAME F-Main
     1090   DO:
     1091     assign snum.
     1092     run FindRec in this-procedure (input 1) .
     1093   END.
     1094   ON VALUE-CHANGED OF itog-contract IN FRAME F-Main
     1095   DO:
     1096     assign itog-contract .
     1097     if itog-contract then do:
     1098       disable itog-only with frame F-Main.
     1099     end.
     1100     else do:
     1101       enable itog-only with frame F-Main.
     1102     end.
     1103   END.
     1104   ON RETURN OF snum IN FRAME F-Main
     1105   DO:
     1106     assign snum.
     1107     run FindRec in this-procedure (input 1) .
     1108   END.
     1109   if not this-procedure :persistent
     1110   then do:
     1111     message
     1112       vss-workfile vss-revision vss-description skip
     1113       "Ошибка при запуске процедуры" skip
     1114       "Данную процедуру следует запускать только с параметром persistent" skip
     1115       view-as alert-box error .
     1116     undo, return error .
     1117   end.
     1118     assign  frame F-Main  is-real is-fin is-fo .
     1119     display is-real is-fin is-fo with frame F-Main.
     1120     enable itog-contract with frame F-Main.
     1121   PROCEDURE disable_UI :
     1122     HIDE FRAME F-Main.
     1123     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1124   END PROCEDURE.
     1125   PROCEDURE FindRec :
     1126   define input  parameter typ as integer   no-undo .
     1127     do on error undo, return error return-value :
     1128         if typ = 0 then find first contract no-lock where contract.contract-code = contr-code  and contract.host-code = v-cntxt-host-code-obj no-error .
     1129         else            find first contract no-lock where contract.contract-prn-code = snum and contract.host-code = v-cntxt-host-code-obj no-error .
     1130         if available contract then do:
     1131           assign
     1132             contr-code = contract.contract-code
     1133             snum    = contract.contract-prn-code + " от " + string(contract.contract-date,"99/99/9999")
     1134           .
     1135         end.
     1136         else assign  contr-code = 0    snum = "" .
     1137         display contr-code snum with frame F-Main.
     1138     end.
     1139   end procedure.
     1140   PROCEDURE local-apply-layout :
     1141     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1142   END PROCEDURE.
     1143   PROCEDURE my-report :
     1144   if is-fin or is-fo or is-real then
     1145       run rep/r-obsal2.p ( itog-only, itog-contract, contr-code, is-date, is-fin, is-fo, is-real ) .
     1146     else message
     1147       "Не выбраны данные для печати"
     1148       view-as alert-box.
     1149   END PROCEDURE.
     1150   PROCEDURE my-var :
     1151     Assign frame F-Main itog-only itog-contract is-date is-fin is-fo is-real .
     1152     find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = v-cntxt-host-code-obj .
     1153     assign str1 = "Фирма: " + clients.obj-name +  chr(10) .
     1154     if contr-code > 0 and itog-contract then  assign ReportNAme = "Оборотно-сальдовая ведомость по договору " + snum .
     1155     else assign ReportNAme = "Оборотно-сальдовая ведомость по поставщикам с: " + string(x-date-start,"99/99/9999") + "г. по: "  + string(x-date-end, "99/99/9999") + "г." .
     1156   END PROCEDURE.
     1157   PROCEDURE state-changed :
     1158     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1159     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1160     CASE p-state:
     1161       when "link-changed":U then  DO:
     1162            Run my-var.
     1163            End.
     1164     END CASE.
     1165   END PROCEDURE.
