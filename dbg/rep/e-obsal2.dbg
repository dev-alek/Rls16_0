      900        "must have at least one Enabled Table to perform Copy.":U
      901          VIEW-AS ALERT-BOX ERROR.
      902       RETURN.
      903   END PROCEDURE.
      904   PROCEDURE adm-create-record :
      905      RETURN.
      906   END PROCEDURE.
      907   PROCEDURE adm-current-changed :
      908     RETURN.
      909   END PROCEDURE.
      910   PROCEDURE adm-delete-record :
      911    MESSAGE
      912          "Object ":U THIS-PROCEDURE:FILE-NAME
      913            "must have at least one Enabled Table to perform Delete.":U
      914              VIEW-AS ALERT-BOX ERROR.
      915       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      916       RETURN.
