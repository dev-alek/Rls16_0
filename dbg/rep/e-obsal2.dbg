      685   DEFINE FRAME F-Main
      686        contr-code AT ROW 3 COL 6.5 COLON-ALIGNED
      687        BUTTON-contr AT ROW 3 COL 33.5
      688        is-real AT ROW 3 COL 40
      689        snum AT ROW 4.5 COL 3.5 COLON-ALIGNED
      690        is-fo AT ROW 4.5 COL 40
      691        itog-contract AT ROW 5.75 COL 3
      692        is-fin AT ROW 6 COL 40
      693        itog-only AT ROW 9.08 COL 3.5
      694        is-date AT ROW 10.33 COL 3.5
      695        "Договор:" VIEW-AS TEXT
      696             SIZE 10 BY 1 AT ROW 1.5 COL 2.5
      697             FGCOLOR 4
      698        "Показать:" VIEW-AS TEXT
      699             SIZE 18 BY 1 AT ROW 7.83 COL 2.5
      700             FGCOLOR 4
      701        "Данные:" VIEW-AS TEXT
      702             SIZE 13.5 BY 1 AT ROW 1.5 COL 40.5
      703             FGCOLOR 4
      704        RECT-6 AT ROW 7.33 COL 1.5
      705        RECT-7 AT ROW 1.25 COL 1.5
      706        RECT-8 AT ROW 1.25 COL 38.5
