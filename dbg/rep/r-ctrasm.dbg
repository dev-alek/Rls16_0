      583   define new global shared variable g#library  as handle no-undo .
      584   define new global shared variable g#library2 as handle no-undo .
      585   define variable var-report-r-b as character no-undo .
      586   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      587   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      588     (output var-report-r-b
      589     )  .
      590   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   define  stream PrnLibStream.
      592   procedure prn-lib-prn-file :
      593     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      594     define input parameter p-DIsabledoptions as integer no-undo .
      595     define variable v-report-name as character no-undo .
      596     define variable v-user-action as character no-undo .
      597     define variable v-printed     as logical   no-undo .
      598     define variable v-exist       as logical   no-undo .
      599     do
      600       on error undo, return error
      601       :
      602       run prn-lib-get-report-name  in this-procedure (
      603         input parParentProc
      604         ,output v-report-name
      605         ).
      606   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      607   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      608     (input  v-report-name
      609     ,input  2
      610     ,output v-exist
      611     )  .
      612       if NOT v-exist then
      613       DO:
      614         Message
      615           "Нет заданий на печать ! "
      616           view-as alert-box .
      617         Return  .
      618       End.
      619       run gbl/prnfilen.w
      620         (input  ""
      621         ,input  p-DisabledOptions
      622         ,input  string(v-report-name )
      623         ,input  7
      624         ,output v-user-action
      625         ,output v-printed
      626         ) .
      627       if v-printed then
      628       do:
      629         return "YES" .
      630       end.
      631       else
      632       do:
      633         return "NO" .
      634       end.
      635     end.
      636   end procedure.
      637   procedure prn-lib-open-stream :
      638     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      639     define input parameter p-page-size    as integer no-undo .
      640     define input parameter p-is-stream    as logical no-undo .
      641     define input parameter p-append       as logical no-undo .
      642     define variable v-report-name as character no-undo .
      643     do
      644       on error undo, return error
      645       :
      646       run prn-lib-get-report-name  in this-procedure (
      647         input parParentProc
      648         ,output v-report-name
      649         ).
      650       if p-is-stream then
      651       do:
      652         if p-append then
      653         do:
      654           output stream PrnLibStream to value( v-report-name )
      655             page-size value(p-page-size) append .
      656         end.
      657         if not p-append then
      658         do:
      659           output stream PrnLibStream to value( v-report-name )
      660             page-size value(p-page-size) .
      661         end.
      662       end.
      663       if not p-is-stream then
      664       do:
      665         if p-append then
      666         do:
      667           output to value( v-report-name )
      668             page-size value(p-page-size) append .
      669         end.
      670         if not p-append then
      671         do:
      672           output to value( v-report-name )
      673             page-size value(p-page-size) .
      674         end.
      675       end.
      676     end.
      677   end procedure.
      678   procedure prn-lib-open-exp :
      679     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      680     define input parameter p-is-stream    as logical no-undo .
      681     define input parameter p-is-append    as logical no-undo .
      682     define output parameter p-ReportFileName as char init "report" no-undo.
      683     define output parameter p-process as logical no-undo .
      684     define variable glog as logical no-undo .
      685     do
      686       on error undo, return error
      687       :
      688       SYSTEM-DIALOG GET-FILE p-ReportFileName
      689         TITLE      "Укажите путь"
      690         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      691         ASK-OVERWRITE
      692         CREATE-TEST-FILE
      693         SAVE-AS
      694         USE-FILENAME
      695         DEFAULT-EXTENSION "txt"
      696         UPDATE glog
      697         .
      698       if not glog then  return.
      699       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      700       if p-is-stream then
      701       do:
      702         if p-is-append then
      703         do:
      704           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      705         end.
      706         else
      707         do:
      708           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      709         end.
      710       end.
      711       else
      712       do:
      713         if p-is-append then
      714         do:
      715           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      716         end.
      717         else
      718         do:
      719           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      720         end.
      721       end.
      722       p-process = yes.
      723     end.
      724   end procedure.
      725   procedure prn-lib-get-report-name :
      726     define input parameter parParentProc  as widget-handle no-undo.
      727     define output parameter p-report-name as character no-undo .
      728     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      729   end procedure.
      730   procedure prn-lib-reportviewer-report-name :
      731     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      732     define input parameter p-report-name-html as character no-undo .
      733     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      734   end procedure.
      735   procedure prn-lib-reportviewer :
      736     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      737     define input parameter p-report-name-html as character no-undo .
      738     define input parameter p-param        as character no-undo .
      739     define variable v-excel           as character no-undo init 'TRUE' .
      740     define variable v-value-character as character no-undo .
      741     define variable v-value-integer   as character no-undo .
      742     define variable v-value-date      as date      no-undo .
      743     define variable v-value-decimal   as decimal   no-undo .
      744     define variable rep-excel         as logical   no-undo .
      745     define variable excel-string      as character no-undo .
      746     define variable v-param-type      as character no-undo .
      747     define variable v-tth             as handle    no-undo .
      748     run adm/shattri.p (
      749       input "get":U
      750       ,input  ""
      751       ,input  0
      752       ,input  'report-glob':U
      753       ,input  'rep-excel':U
      754       ,output v-value-character
      755       ,output v-value-date
      756       ,output v-value-decimal
      757       ,output v-value-integer
      758       ,output rep-excel
      759       ,output v-param-type
      760       ,INPUT-OUTPUT table-handle v-tth
      761       )  .
      762     if rep-excel then v-excel = "TRUE" .
      763     else v-excel = "FALSE" .
      764     if p-param eq ""
      765     then
      766        p-param = "EXCEL:" + v-excel.
      767     else
      768        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      769     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      770   end procedure.
      771   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      772   procedure cur-time :
      773      define output parameter p-today as date      no-undo .
      774      define output parameter p-time  as integer   no-undo .
      775     do
      776     on error undo, return error
      777     :
      778       define variable v-date1 as date      no-undo .
      779       define variable v-date2 as date      no-undo .
      780       define variable v-time  as integer   no-undo .
      781       assign
      782         v-date1 = today
      783         v-time  = time
      784         v-date2 = today
      785       .
      786       if v-date1 <> v-date2
      787       then do:
      788         assign
      789           v-date1 = today
      790           v-time  = v-time
      791         .
      792       end.
      793       assign
      794         p-today = v-date1
      795         p-time  = v-time
      796       .
      797     end.
      798   end.
      799   function cur-time-date returns character
      800   :
      801     return string(today, '99/99/9999':U) .
      802   end.
      803   function cur-time-mjd returns decimal
      804   :
      805     define variable v-date as date      no-undo .
      806     define variable v-time as integer   no-undo .
      807     run cur-time in this-procedure
      808       (output v-date
      809       ,output v-time
      810       ) .
      811     return integer(v-date) - 2400002 + (v-time / 86400) .
      812   end.
      813   function cur-time-get-ending-index returns integer
      814   (input p-number as integer
      815   )
      816   :
      817     if p-number < 0
      818     or p-number = ?
      819     then do:
      820       return 1 .
      821     end.
      822     define variable v-rest as integer   no-undo .
      823     assign
      824       p-number = p-number modulo 100
      825     .
      826     if p-number < 20
      827     then do:
      828       assign
      829         v-rest = p-number
      830       .
      831     end.
      832     else do:
      833       assign
      834         v-rest = p-number modulo 10
      835       .
      836     end.
      837     case v-rest :
      838       when 1
      839       then do:
      840         return 2 .
      841       end.
      842       when 2 or
      843       when 3 or
      844       when 4
      845       then do:
      846         return 3 .
      847       end.
      848       otherwise do:
      849         return 1 .
      850       end.
      851     end case .
      852   end.
      853   procedure cur-time-mjd-to-date :
      854      define input  parameter i-mjd-diff as decimal no-undo.
      855      define output parameter o-Date     as date    no-undo.
      856      define output parameter o-Time     as integer no-undo.
      857      define variable v-day-number as integer   no-undo .
      858      if    i-mjd-diff < 0
      859         or i-mjd-diff = ?
      860      then do:
      861         return "?" .
      862      end.
      863      assign
      864         v-day-number = truncate(i-mjd-diff,0).
      865         o-Date = date(v-day-number + 2400002).
      866         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      867     .
      868   end.
      869   function cur-time-mjd-to-string returns character
      870   (input p-mjd-diff as decimal
      871   )
      872   :
      873     define variable v-day-number as integer   no-undo .
      874     define variable v-seconds    as integer   no-undo .
      875     define variable v-hour       as integer   no-undo .
      876     define variable v-min        as integer   no-undo .
      877     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      878     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      879     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      880     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      881     if p-mjd-diff < 0
      882     or p-mjd-diff = ?
      883     then do:
      884       return "?" .
      885     end.
      886     assign
      887       v-day-number = integer(truncate(p-mjd-diff,0))
      888       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      889     .
      890     if v-seconds > 86400
      891     then do:
      892       assign
      893         v-seconds = 86400 - 1
      894       .
      895     end.
      896     if v-seconds < 0
      897     then do:
      898       assign
      899         v-seconds = 0
      900       .
      901     end.
      902     assign
      903       v-hour = truncate(v-seconds / 3600, 0)
      904     .
      905     assign
      906       v-seconds = v-seconds modulo 3600
      907     .
      908     assign
      909       v-min = truncate(v-seconds / 60, 0)
      910     .
      911     assign
      912       v-seconds = v-seconds modulo 60
      913     .
      914     return
      915         (if v-day-number <> 0
      916           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      917           else ""
      918         )
      919       + (if v-day-number <> 0 or v-hour <> 0
      920           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      921           else ""
      922         )
      923       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      924           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      925           else ""
      926         )
      927       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      928       .
      929   end.
      930   function cur-time-string returns character
      931   :
      932     define variable v-date as date      no-undo .
      933     define variable v-time as integer   no-undo .
      934     run cur-time in this-procedure
      935       (output v-date
      936       ,output v-time
      937       ) .
      938     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      939   end.
      940   function cur-time-string-sec returns character
      941   :
      942     define variable v-date as date      no-undo .
      943     define variable v-time as integer   no-undo .
      944     run cur-time in this-procedure
      945       (output v-date
      946       ,output v-time
      947       ) .
      948     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      949   end.
      950   function cur-time-custom  returns character
      951   (input p-prefix as character
      952   ,input p-date-format as character
      953   ,input p-delimiter as character
      954   ,input p-time-format as character
      955   ,input p-suffix as character
      956   )
      957   :
      958     define variable v-date as date      no-undo .
      959     define variable v-time as integer   no-undo .
      960     run cur-time in this-procedure
      961       (output v-date
      962       ,output v-time
      963       ) .
      964     return
      965       p-prefix
      966       + string(v-date, p-date-format)
      967       + p-delimiter
      968       + string(v-time, p-time-format)
      969       + p-suffix
      970       .
      971   end.
      972   function cur-time-print  returns character
      973   :
      974     define variable v-date as date      no-undo .
      975     define variable v-time as integer   no-undo .
      976     run cur-time in this-procedure
      977       (output v-date
      978       ,output v-time
      979       ) .
      980     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      981   end.
      982   function cur-time-datetime returns datetime
      983   :
      984     define variable v-char as character no-undo .
      985     define variable v-datetime as datetime no-undo .
      986     v-char = cur-time-string().
      987     v-datetime = datetime(v-char).
      988     return  v-datetime.
      989   end.
      990   function cur-time-string-msec returns character
      991   :
      992     define variable v-date as datetime  no-undo .
      993     v-date = now.
      994     return string(v-date) .
      995   end.
      996   procedure ost-line :
      997     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
      998     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
      999     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1000     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1001     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1002     define input  parameter x-tog-shift  as logical no-undo .
     1003     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1004     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1005     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1006     define input  parameter xtog-obj     as logical no-undo .
     1007     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1008     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1009     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1010     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1011     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1012     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1013     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1014     define buffer buff-obj-list  for obj-list .
     1015     define buffer buff-stk-line  for ub.stk-line .
     1016     assign
     1017       Quantity = 0
     1018       Coast_R  = 0
     1019       Coast_V  = 0
     1020       VAT_R    = 0
     1021       VAT_V    = 0
     1022       SLT_R    = 0
     1023       SLT_V    = 0
     1024     .
     1025     if  x-tog-shift = false then do:
     1026       for each buff-obj-list no-lock
     1027         where xtog-obj = false
     1028            or (buff-obj-list.obj-type = x-store-type
     1029               and buff-obj-list.obj-code = x-store-code
     1030               )
     1031       on error undo, return error
     1032       :
     1033         find last buff-stk-line no-lock
     1034           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1035             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1036             and buff-stk-line.artic      = x-artic
     1037             and buff-stk-line.prod-type  = x-prod-type
     1038             and buff-stk-line.prod-code  = x-prod-code
     1039             and buff-stk-line.sum-type   = x-sum-type
     1040             and buff-stk-line.cat-id     = '##,##':U
     1041             and buff-stk-line.fact-order <= x-fact-order
     1042             and buff-stk-line.shift-num  = 0
     1043           use-index category
     1044           no-error .
     1045         if available buff-stk-line then do:
     1046           assign
     1047             Quantity = Quantity +  buff-stk-line.fact-qnty
     1048             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1049             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1050             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1051             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1052             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1053             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1054           .
     1055         end.
     1056       end.
     1057     end.
     1058     else do:
     1059       for each buff-obj-list no-lock
     1060         where xtog-obj = false
     1061            or (buff-obj-list.obj-type = x-store-type
     1062               and buff-obj-list.obj-code = x-store-code
     1063               )
     1064       on error undo, return error
     1065       :
     1066         find last buff-stk-line no-lock
     1067           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1068             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1069             and buff-stk-line.artic      = x-artic
     1070             and buff-stk-line.prod-type  = x-prod-type
     1071             and buff-stk-line.prod-code  = x-prod-code
     1072             and buff-stk-line.sum-type   = x-sum-type
     1073             and buff-stk-line.cat-id     = '##,##':U
     1074             and buff-stk-line.fact-order <= x-fact-order
     1075             and buff-stk-line.shift-num  > 0
     1076           use-index category
     1077           no-error .
     1078         if available buff-stk-line then do:
     1079           assign
     1080             Quantity = Quantity +  buff-stk-line.fact-qnty
     1081             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1082             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1083             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1084             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1085             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1086             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1087           .
     1088         end.
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure ost-lineother-tax :
     1093     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1094     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1095     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1096     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1097     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1098     define input  parameter x-tog-shift  as logical no-undo .
     1099     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1100     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1101     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1102     define input  parameter xTog-obj     as logical no-undo .
     1103     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1104     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1105     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1106     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1107     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1108     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1109     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1110     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1111     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1112     define buffer buff-obj-list  for obj-list .
     1113     define buffer buff-stk-line  for ub.stk-line .
     1114     assign
     1115       Quantity = 0
     1116       Coast_R  = 0
     1117       Coast_V  = 0
     1118       VAT_R    = 0
     1119       VAT_V    = 0
     1120       SLT_R    = 0
     1121       SLT_V    = 0
     1122       other_R  = 0
     1123       other_V  = 0
     1124     .
     1125     if  x-tog-shift = false then do:
     1126       for each buff-obj-list no-lock
     1127         where xtog-obj = false
     1128            or (buff-obj-list.obj-type = x-store-type
     1129               and buff-obj-list.obj-code = x-store-code
     1130               )
     1131       on error undo, return error
     1132       :
     1133         find last buff-stk-line no-lock
     1134           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1135             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1136             and buff-stk-line.artic      = x-artic
     1137             and buff-stk-line.prod-type  = x-prod-type
     1138             and buff-stk-line.prod-code  = x-prod-code
     1139             and buff-stk-line.sum-type   = x-sum-type
     1140             and buff-stk-line.cat-id     = '##,##':U
     1141             and buff-stk-line.fact-order <= x-fact-order
     1142             and buff-stk-line.shift-num  = 0
     1143           use-index category
     1144           no-error .
     1145         if available buff-stk-line then do:
     1146           assign
     1147             Quantity = Quantity +  buff-stk-line.fact-qnty
     1148             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1149             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1150             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1151             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1152             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1153             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1154             other_R  = other_R  +  buff-stk-line.other-rubl
     1155             other_V  = other_V  +  buff-stk-line.other-base
     1156           .
     1157         end.
     1158       end.
     1159     end.
     1160     else do:
     1161       for each buff-obj-list no-lock
     1162         where xtog-obj = false
     1163            or (buff-obj-list.obj-type = x-store-type
     1164               and buff-obj-list.obj-code = x-store-code
     1165               )
     1166       on error undo, return error
     1167       :
     1168         find last buff-stk-line no-lock
     1169           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1170             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1171             and buff-stk-line.artic      = x-artic
     1172             and buff-stk-line.prod-type  = x-prod-type
     1173             and buff-stk-line.prod-code  = x-prod-code
     1174             and buff-stk-line.sum-type   = x-sum-type
     1175             and buff-stk-line.cat-id     = '##,##':U
     1176             and buff-stk-line.fact-order <= x-fact-order
     1177             and buff-stk-line.shift-num  > 0
     1178           use-index category
     1179           no-error .
     1180         if available buff-stk-line then do:
     1181           assign
     1182             Quantity = Quantity +  buff-stk-line.fact-qnty
     1183             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1184             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1185             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1186             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1187             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1188             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1189             other_R = other_R   +  buff-stk-line.other-rubl
     1190             other_V = other_V   +  buff-stk-line.other-base
     1191           .
     1192         end.
     1193       end.
     1194     end.
     1195   end procedure.
     1196   procedure ost-line-kg :
     1197     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1198     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1199     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1200     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1201     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1202     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1203     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1204     define buffer buff-obj-list  for obj-list .
     1205     define buffer buf_doc-line for ub.doc-line .
     1206     define buffer buf_inv-line for ub.inv-line .
     1207     do
     1208     on error undo, return error
     1209     :
     1210       for each buf_doc-line no-lock where
     1211                buf_doc-line.obj-type    = p-obj-type   and
     1212                buf_doc-line.obj-code    = p-obj-code   and
     1213                buf_doc-line.prod-type   = p-prod-type  and
     1214                buf_doc-line.prod-code   = p-prod-code  and
     1215                buf_doc-line.artic       = p-artic      and
     1216                buf_doc-line.status_     = 'факт':U      and
     1217                buf_doc-line.fact-order <= p-fact-order
     1218             by buf_doc-line.fact-order    descending
     1219       :
     1220         find first buf_inv-line no-lock where
     1221                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1222                    buf_inv-line.artic     = buf_doc-line.artic     and
     1223                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1224                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1225         if available buf_inv-line
     1226         then do:
     1227           if buf_inv-line.after-cli-qnty <> ?
     1228           then do:
     1229             assign
     1230               p-quantity-kg = buf_inv-line.after-cli-qnty
     1231             .
     1232             leave .
     1233           end.
     1234         end.
     1235       end.
     1236       if p-quantity-kg = ?
     1237       then do:
     1238         assign
     1239           p-quantity-kg = 0
     1240         .
     1241       end.
     1242     end.
     1243   end procedure.
     1244   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245   procedure factord :
     1246     define input  parameter p-fact-date            as date    no-undo .
     1247     define input  parameter p-fact-time            as integer no-undo .
     1248     define input  parameter p-fact-num             as integer no-undo .
     1249     define input  parameter p-shift-date           as date    no-undo .
     1250     define input  parameter p-shift-num            as integer no-undo .
     1251     define input  parameter p-shift-on             as logical no-undo .
     1252     define output parameter p-fact-order           as decimal no-undo .
     1253     define output parameter p-shift-end-fact-order as decimal no-undo .
     1254     define output parameter p-day-end-fact-order   as decimal no-undo .
     1255     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1256     if p-fact-date = ?
     1257     then do:
     1258       return error "Не указана фактическая дата" .
     1259     end.
     1260     define variable v-fact-date-num as integer no-undo .
     1261     assign
     1262       v-fact-date-num = integer(p-fact-date)
     1263     .
     1264     if p-fact-num = ?
     1265     or p-fact-num = 0
     1266     then do:
     1267       return error "Не задан p-fact-num " + string(p-fact-num) .
     1268     end.
     1269     if p-fact-num < 0
     1270     then do:
     1271       return error "Отрицательный fact-num " + string(p-fact-num) .
     1272     end.
     1273     if p-fact-num >= 100000000
     1274     then do:
     1275       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1276     end.
     1277     if p-shift-on = true
     1278     then do:
     1279       if p-shift-date = ?
     1280       then do:
     1281         return error "Не задана дата смены" .
     1282       end.
     1283       if p-shift-num = ?
     1284       or p-shift-num = 0
     1285       then do:
     1286         return error "Не задан номер смены" .
     1287       end.
     1288     end.
     1289     else do:
     1290       assign
     1291         p-shift-date = p-fact-date
     1292         p-shift-num  = 24
     1293       .
     1294     end.
     1295     define variable v-shift-offset as integer no-undo .
     1296     if p-shift-date = p-fact-date
     1297     then do:
     1298       assign
     1299         v-shift-offset = 1
     1300       .
     1301     end.
     1302     if p-shift-date < p-fact-date
     1303     then do:
     1304       assign
     1305         v-shift-offset = 0
     1306       .
     1307     end.
     1308     if p-shift-date > p-fact-date
     1309     then do:
     1310       message
     1311         vss-workfile vss-revision vss-description skip
     1312         "Неправильная дата закрытия смены" skip
     1313         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1314         view-as alert-box error .
     1315       undo, return error
     1316         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1317           ,string(p-fact-date, '99/99/9999':U)
     1318           ,string(p-shift-date, '99/99/9999':U)
     1319           )
     1320       .
     1321     end.
     1322     if p-shift-num < 1
     1323     or p-shift-num > 24
     1324     then do:
     1325       message
     1326         vss-workfile vss-revision vss-description skip
     1327         "Неправильный номер смены" skip
     1328         "p-shift-num" p-shift-num skip
     1329         view-as alert-box error .
     1330       undo, return error return-value .
     1331     end.
     1332     assign
     1333       p-fact-order           = v-fact-date-num
     1334                              + v-shift-offset * 0.5
     1335                              + p-shift-num    * 0.02 - 0.01
     1336                              + p-fact-num     * 0.0000000001
     1337       p-shift-end-fact-order = v-fact-date-num
     1338                              + v-shift-offset * 0.5
     1339                              + p-shift-num    * 0.02
     1340       p-day-end-fact-order   = v-fact-date-num
     1341                              + 0.99
     1342     .
     1343     if p-fact-order           <= v-fact-date-num
     1344     or p-shift-end-fact-order <= v-fact-date-num
     1345     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1346     or p-shift-end-fact-order >= p-day-end-fact-order
     1347     then do:
     1348       message
     1349         vss-workfile vss-revision vss-description skip
     1350         "Внутренняя ошибка при генерации фактического номера" skip
     1351         "p-fact-date"            p-fact-date            skip
     1352         "p-fact-time"            p-fact-time            skip
     1353         "p-fact-num"             p-fact-num             skip
     1354         "p-shift-date"           p-shift-date           skip
     1355         "p-shift-num"            p-shift-num            skip
     1356         "p-shift-on"             p-shift-on             skip
     1357         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1358         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1359         "v-fact-date-num"        v-fact-date-num        skip
     1360         view-as alert-box error .
     1361       undo, return error return-value .
     1362     end.
     1363   end procedure.
     1364   procedure day-begin-fact-order :
     1365     define input  parameter p-fact-date            as date    no-undo .
     1366     define output parameter p-day-begin-fact-order as decimal no-undo .
     1367     do
     1368     on error undo, return error return-value
     1369     :
     1370       if p-fact-date = ?
     1371       then do:
     1372         assign
     1373           p-day-begin-fact-order = 0
     1374         .
     1375       end.
     1376       else do:
     1377         assign
     1378           p-day-begin-fact-order = integer(p-fact-date)
     1379         .
     1380       end.
     1381     end.
     1382   end procedure.
     1383   procedure factord-max-fact-order :
     1384     define output parameter p-max-fact-order as decimal   no-undo .
     1385     do
     1386     on error undo, return error return-value
     1387     :
     1388       run day-begin-fact-order in this-procedure
     1389         (input  date(1, 1, 5000)
     1390         ,output p-max-fact-order
     1391         ) .
     1392     end.
     1393   end procedure.
     1394   procedure factord-cut-archive :
     1395     define input  parameter p-obj-type             as character no-undo .
     1396     define input  parameter p-obj-code             as integer   no-undo .
     1397     define input  parameter p-fact-date            as date      no-undo .
     1398     define output parameter p-shift-on             as logical   no-undo .
     1399     define output parameter p-shift-date           as date      no-undo .
     1400     define output parameter p-shift-num            as integer   no-undo .
     1401     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1402     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1403     define variable v-fact-order as decimal   no-undo .
     1404     define buffer buf_shift-obj for ub.shift-obj .
     1405     do
     1406     on error undo, return error return-value
     1407     :
     1408   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1409   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1410     (input  p-obj-type
     1411     ,input  p-obj-code
     1412     ,input  'shift-on=request'
     1413     ,output p-shift-on
     1414     ) no-error .
     1415       if error-status :error
     1416       then do:
     1417         message
     1418           vss-workfile vss-revision vss-description skip
     1419           "Ошибка при определении атрибута объекта" skip
     1420           "Объект" p-obj-type p-obj-code skip
     1421           error-status :get-message(1) skip
     1422           return-value skip
     1423           view-as alert-box error .
     1424         undo, return error return-value .
     1425       end.
     1426       if p-shift-on = false
     1427       then do:
     1428         assign
     1429           p-shift-date               = ?
     1430           p-shift-num                = 0
     1431         .
     1432       end.
     1433       else do:
     1434         find first buf_shift-obj share-lock
     1435           where buf_shift-obj.obj-type   = p-obj-type
     1436             and buf_shift-obj.obj-code   = p-obj-code
     1437             and buf_shift-obj.shift-date > p-fact-date
     1438           use-index pi
     1439           no-error .
     1440         if not available buf_shift-obj
     1441         or buf_shift-obj.status_ <> 'зкр':U
     1442         then do:
     1443           message
     1444             vss-workfile vss-revision vss-description skip
     1445             "Невозможно вычислить последнюю смену" skip
     1446             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1447             "Объект" p-obj-type p-obj-code skip
     1448             "Дата" p-fact-date skip
     1449             view-as alert-box error .
     1450           undo, return error return-value .
     1451         end.
     1452         find last buf_shift-obj share-lock
     1453           where buf_shift-obj.obj-type = p-obj-type
     1454             and buf_shift-obj.obj-code = p-obj-code
     1455             and buf_shift-obj.shift-date <= p-fact-date
     1456           use-index pi
     1457           no-error .
     1458         if available buf_shift-obj
     1459         then do:
     1460           if  buf_shift-obj.status_ = 'зкр':U
     1461           then do:
     1462             assign
     1463               p-shift-date = buf_shift-obj.shift-date
     1464               p-shift-num  = buf_shift-obj.shift-num
     1465             .
     1466           end.
     1467           else do:
     1468             message
     1469               vss-workfile vss-revision vss-description skip
     1470               "Невозможно вычислить последнюю смену" skip
     1471               "Статус смены отличен от статуса" 'зкр':U skip
     1472               "Объект" p-obj-type p-obj-code skip
     1473               "Дата" p-fact-date skip
     1474               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1475               view-as alert-box error .
     1476             undo, return error return-value .
     1477           end.
     1478         end.
     1479         else do:
     1480           assign
     1481             p-shift-date = p-fact-date - 1
     1482             p-shift-num  = 1
     1483           .
     1484         end.
     1485       end.
     1486       run factord in this-procedure
     1487         (input  p-fact-date
     1488         ,input  1
     1489         ,input  1
     1490         ,input  p-shift-date
     1491         ,input  p-shift-num
     1492         ,input  p-shift-on
     1493         ,output v-fact-order
     1494         ,output p-shift-end-fact-order
     1495         ,output p-day-end-fact-order
     1496         ) no-error .
     1497       if error-status :error
     1498       then do:
     1499         message
     1500           vss-workfile vss-revision vss-description skip
     1501           "Ошибка при вызове процедуры factord"
     1502           error-status :get-message(1) skip
     1503           return-value skip
     1504           view-as alert-box error .
     1505         undo, return error return-value .
     1506       end.
     1507     end.
     1508   end procedure.
     1509   procedure factord-lock-shift :
     1510     define input  parameter p-obj-type  as character no-undo .
     1511     define input  parameter p-obj-code  as integer   no-undo .
     1512     define input  parameter p-fact-date as date      no-undo .
     1513     define parameter buffer buf_shift-obj for ub.shift-obj .
     1514     define variable v-shift-on      as logical   no-undo .
     1515     define variable v-extra-message as character no-undo .
     1516     define variable v-error as character no-undo .
     1517     do
     1518     on error undo, return error return-value
     1519     :
     1520   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1521   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1522     (input  p-obj-type
     1523     ,input  p-obj-code
     1524     ,input  'shift-on=request'
     1525     ,output v-shift-on
     1526     ) no-error .
     1527       if error-status :error
     1528       then do:
     1529         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1530         undo, return error v-error .
     1531       end.
     1532       if v-shift-on = true
     1533       then do:
     1534         find first buf_shift-obj share-lock
     1535           where buf_shift-obj.obj-type   = p-obj-type
     1536             and buf_shift-obj.obj-code   = p-obj-code
     1537             and buf_shift-obj.shift-date > p-fact-date
     1538           use-index pi
     1539           no-error .
     1540         if not available buf_shift-obj
     1541         or buf_shift-obj.status_ <> 'зкр':U
     1542         then do:
     1543           find last buf_shift-obj
     1544             where buf_shift-obj.obj-type = p-obj-type
     1545               and buf_shift-obj.obj-code = p-obj-code
     1546               and buf_shift-obj.status_  = 'зкр':U
     1547             use-index stts
     1548             no-error .
     1549           if available buf_shift-obj
     1550           then do:
     1551             assign
     1552               v-extra-message =
     1553                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1554                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1555                               )
     1556             .
     1557           end.
     1558           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1559           undo, return error v-error .
     1560         end.
     1561       end.
     1562     end.
     1563   end procedure.
     1564   procedure factord-end-day :
     1565     define input  parameter p-fact-date            as date    no-undo .
     1566     define output parameter p-day-end-fact-order   as decimal no-undo .
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570       if p-fact-date = ?
     1571       then do:
     1572         return error "Не указана фактическая дата" .
     1573       end.
     1574       assign
     1575         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1576       .
     1577     end.
     1578   end procedure.
     1579   procedure factord-to-date :
     1580     define input  parameter p-fact-order as decimal no-undo .
     1581     define output parameter p-fact-date  as date    no-undo .
     1582     define variable v-ref-date  as date      no-undo .
     1583     define variable v-ref-delta as integer   no-undo .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587       if p-fact-order = ?
     1588       or p-fact-order = 0
     1589       then do:
     1590         return error "Не указан fact-order" .
     1591       end.
     1592       assign
     1593         v-ref-date  = date(1, 1, 2000)
     1594       .
     1595       assign
     1596         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1597       .
     1598       assign
     1599         p-fact-date = v-ref-date + v-ref-delta
     1600       .
     1601     end.
     1602   end procedure.
     1603   procedure factord-to-fact-num :
     1604     define input  parameter p-fact-order as decimal no-undo .
     1605     define output parameter p-fact-num   as integer no-undo .
     1606     define variable v-fact-order-trunc as decimal no-undo .
     1607     do
     1608     on error undo, return error return-value
     1609     :
     1610       if p-fact-order = ?
     1611       or p-fact-order = 0
     1612       then do:
     1613         return error "Не указан fact-order" .
     1614       end.
     1615       assign
     1616        v-fact-order-trunc = truncate(p-fact-order, 2)
     1617       .
     1618       assign
     1619         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1620       .
     1621     end.
     1622   end procedure.
     1623   procedure factord-to-shift-num :
     1624     define input  parameter p-fact-order as decimal no-undo .
     1625     define output parameter p-shift-num   as integer no-undo .
     1626     define variable  p-shift-numd  as decimal   no-undo .
     1627     define variable v-fact-order-trunc as decimal no-undo .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       if p-fact-order = ?
     1632       or p-fact-order = 0
     1633       then do:
     1634         return error "Не указан fact-order" .
     1635       end.
     1636       assign
     1637        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1638       .
     1639       if v-fact-order-trunc < 0.5 then do:
     1640         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1641       end.
     1642       assign
     1643         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1644         .
     1645        assign
     1646         p-shift-num = truncate (p-shift-numd , 0)
     1647       .
     1648     end.
     1649   end procedure.
     1650   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1651   define variable v-waitfram-action01         as character   no-undo .
     1652   define variable v-waitfram-action02         as character   no-undo .
     1653   define variable v-waitfram-action03         as character   no-undo .
     1654   define variable mWaitFramTextBeg            as character   no-undo.
     1655   define variable mWaitFramTextEnd            as character   no-undo.
     1656   define variable mWaitFramView               as logical     no-undo.
     1657   define variable mWaitProcEvent              as logical     no-undo init yes.
     1658   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1659   define variable mWaitFramStop               as logical     no-undo.
     1660   define variable mWaitFramStopUser           as logical     no-undo.
     1661   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1662   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1663   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1664   define button B-WaitFramStop auto-end-key
     1665        label "Стоп"
     1666        size 10 by 1 tooltip "Остоновить процесс".
     1667   define button B-viewProcInfo
     1668        label "Информация"
     1669        size 15 by 1 tooltip "Информация о процесс".
     1670   define frame waitfram
     1671     v-waitfram-action01 format "x(72)" no-label skip
     1672     v-waitfram-action02 format "x(72)" no-label skip
     1673     v-waitfram-action03 format "x(72)" no-label skip
     1674     B-viewProcInfo
     1675     B-WaitFramStop at row 4 col 30
     1676     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1677     .
     1678   define new global shared variable mBatchMode as logical no-undo init ?.
     1679   define variable mFramBachModHandle as handle no-undo.
     1680   mFramBachModHandle = frame waitfram:handle.
     1681   define variable mFameOldVis as logical no-undo.
     1682   define variable mVisCUrentVin as logical no-undo.
     1683   if session:batch-mode
     1684   then
     1685      mBatchMode = yes.
     1686   if mBatchMode = ? then do:
     1687     mVisCUrentVin = current-window:visible.
     1688     mFameOldVis = mFramBachModHandle:visible.
     1689     mFramBachModHandle:visible  = yes.
     1690     mBatchMode = mFramBachModHandle:visible ne yes.
     1691     mFramBachModHandle:visible = mFameOldVis.
     1692     current-window:visible = mVisCUrentVin.
     1693   end.
     1694    if  log-manager:logfile-name ne ?
     1695     then DO:
     1696         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1697         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1698         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1699     end.
     1700   on choose of B-WaitFramStop in frame waitfram
     1701   do:
     1702     mWaitFramStop = yes.
     1703     mWaitFramStopUser = yes.
     1704   end.
     1705   function waitfram-check-timeout returns logical():
     1706      define variable vtime as int64 no-undo.
     1707      if mWaitFramStopTimeOut
     1708      then
     1709         return yes.
     1710      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1711      if     mWaitFramTimeOut ne ?
     1712         and mWaitFramTimeOut ne 0
     1713         and mWaitFramTimeOut lt vtime
     1714      then do:
     1715         mWaitFramStopTimeOut = yes.
     1716      end.
     1717      return mWaitFramStopTimeOut.
     1718   end.
     1719   procedure waitfram-hide :
     1720     if not session:batch-mode
     1721     then do
     1722     on error undo, return error return-value
     1723     :
     1724       pause 0 before-hide .
     1725       if not mBatchMode then
     1726         hide frame waitfram .
     1727     if     not mWaitFramView
     1728        and mWaitProcEvent
     1729     then
     1730       process events .
     1731     end.
     1732   end procedure.
     1733   procedure waitfram-show :
     1734     define input  parameter p-message as character no-undo .
     1735     define variable v-left-margin as integer   no-undo .
     1736     if not session:batch-mode
     1737     then do
     1738     on error undo, return error return-value
     1739     :
     1740       if length(p-message) <= 70 then do:
     1741         assign
     1742           v-left-margin = integer((70 - length(p-message)) / 2)
     1743         .
     1744         assign
     1745           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1746         .
     1747         assign
     1748           v-waitfram-action01 = " "
     1749           v-waitfram-action02 = " "
     1750                                    + fill(" ", v-left-margin)
     1751                                    + p-message
     1752           v-waitfram-action03 = " "
     1753         .
     1754       end.
     1755       else do:
     1756         define variable vRindex1 as integer no-undo.
     1757         define variable vRindex2 as integer no-undo.
     1758         vRindex1 = r-index(p-message," ",70).
     1759         if vRindex1 = 0
     1760         then
     1761            vRindex1 = 70.
     1762         if length(p-message)  <= vRindex1 + 70 then do:
     1763           assign
     1764             v-waitfram-action01 = " "
     1765             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1766             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1767           .
     1768         end.
     1769         else do:
     1770           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1771           if vRindex2 <= vRindex1
     1772           then
     1773              vRindex2 = vRindex1 + 70.
     1774           assign
     1775             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1776             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1777             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1778           .
     1779         end.
     1780       end.
     1781       B-viewProcInfo:visible   in frame waitfram = no.
     1782       B-viewProcInfo:sensitive in frame waitfram = no.
     1783       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1784       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1785       if  (   mWaitFramView
     1786          or  mWaitProcEvent)
     1787          and not mBatchMode
     1788       then
     1789          display
     1790             v-waitfram-action01 skip
     1791             v-waitfram-action02 skip
     1792             v-waitfram-action03 skip
     1793          with frame waitfram .
     1794       if     mWaitFramView
     1795          then do:
     1796             if     mWaitFramInterval ne ?
     1797                and not mBatchMode
     1798             then
     1799                wait-for go of frame waitfram pause mWaitFramInterval.
     1800          end.
     1801          else
     1802             if     mWaitProcEvent
     1803                and not mBatchMode
     1804             then
     1805                process events .
     1806     end.
     1807   end procedure.
     1808      procedure waitfram-show-this:
     1809         define input  parameter iInterval as int64 no-undo.
     1810         define variable vtime as int64 no-undo.
     1811         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1812         mWaitFramInterval = iInterval.
     1813         run waitfram-show (substitute("&1&2 &3&4" ,
     1814                                       mWaitFramTextBeg ,
     1815                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1816                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1817                                       mWaitFramTextEnd
     1818                                      )
     1819                           ).
     1820      end.
     1821      procedure WaitFramRunPause:
     1822         define input  parameter iInterval as dec no-undo.
     1823         define variable vStart  as datetime-tz no-undo.
     1824         define variable vend    as datetime-tz no-undo.
     1825         define variable vint as int64 no-undo.
     1826         define variable vOk as logical no-undo.
     1827         vStart = now.
     1828         vend   = vStart.
     1829         publish "WaitFramPause" (iInterval,output vOk).
     1830         vend   =  now.
     1831         vint = vend - vStart.
     1832         vint = iInterval - vint / 1000.
     1833         if     not mWaitFramStop
     1834            and (   vint > 0
     1835                 or (    not vOk
     1836                     and iInterval eq ?
     1837                     )
     1838                 )
     1839         then
     1840            run waitfram-show-this (iInterval).
     1841         vend   =  now.
     1842         vint = vend - vStart.
     1843         vint = iInterval - vint / 1000.
     1844         if     not mWaitFramStop
     1845            and vint > 0
     1846         then do:
     1847            run gbl/pause.p (vint * 1000).
     1848         end.
     1849         if iInterval ne ?
     1850         then
     1851            publish "WaitFramStop".
     1852         waitfram-check-timeout().
     1853      end.
     1854      procedure WaitFramWaitFor:
     1855         define input  parameter iInterval as dec no-undo.
     1856         assign
     1857            mWaitFramStartProc   = now
     1858            mWaitFramStopUser    = no
     1859            mWaitFramStopTimeOut = no
     1860         .
     1861         block-wait:
     1862         do while not mWaitFramStop:
     1863            run WaitFramRunPause (iInterval).
     1864            if  waitfram-check-timeout()
     1865            then do:
     1866               leave block-wait.
     1867            end.
     1868         end.
     1869         run waitfram-hide.
     1870      end.
     1871   procedure waitfram-join :
     1872     define input  parameter p-line-1  as character no-undo .
     1873     define input  parameter p-line-2  as character no-undo .
     1874     define input  parameter p-line-3  as character no-undo .
     1875     define output parameter p-message as character no-undo .
     1876     do
     1877     on error undo, return error return-value
     1878     :
     1879       assign
     1880         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1881                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1882                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1883       .
     1884     end.
     1885   end procedure.
     1886   function waitfram-join-function returns character
     1887     (input p-line-1 as character
     1888     ,input p-line-2 as character
     1889     ,input p-line-3 as character
     1890     ).
     1891     define variable v-message as character no-undo .
     1892     run waitfram-join in this-procedure
     1893       (input  p-line-1
     1894       ,input  p-line-2
     1895       ,input  p-line-3
     1896       ,output v-message
     1897       ) .
     1898     return v-message .
     1899   end function .
     1900   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1901   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
     1902   define  shared variable RepPathName        as character no-undo .
     1903   define  shared variable PrintRubl          as logical   no-undo .
     1904   define temp-table temp-font no-undo
     1905     field fontnum  as integer
     1906     field fontname as character
     1907     field fontsize as character
     1908     field fonttype as character
     1909     field font-h   as integer
     1910     field font-w   as integer
     1911     field v-row    as integer
     1912     field v-col    as integer
     1913     field v-row-lans as integer
     1914     field v-col-lans as integer
     1915   index pi fontnum
     1916   .
     1917   procedure get-font-ini :
     1918     do
     1919     on error undo, return error return-value
     1920     :
     1921   define variable ii as integer   no-undo .
     1922   define variable v-font7 as character no-undo .
     1923   define variable v-font as character no-undo .
     1924   define variable loc-name as character no-undo .
     1925   define variable loc-size as character no-undo .
     1926   define variable loc-type as character no-undo .
     1927   define variable old_H as integer   no-undo .
     1928   define variable old_w as integer   no-undo .
     1929   define variable old-row  as integer   no-undo .
     1930   define variable old-col  as integer   no-undo .
     1931   define variable old-row-lans  as integer   no-undo .
     1932   define variable old-col-lans  as integer   no-undo .
     1933   define variable vv as integer   no-undo .
     1934   empty temp-table temp-font.
     1935     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1936       case num-entries (v-font7) :
     1937         when 4 then do:
     1938             assign
     1939               loc-name = entry ( 1 , v-font7 )
     1940               loc-size = entry ( 2 , v-font7 )
     1941               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1942             .
     1943         end.
     1944         when 3 then do:
     1945             assign
     1946               loc-name = entry ( 1 , v-font7 )
     1947               loc-size = entry ( 2 , v-font7 )
     1948               loc-type = entry ( 3 , v-font7 )
     1949             .
     1950         end.
     1951         when 2 then  do:
     1952             assign
     1953               loc-name = entry ( 1 , v-font7 )
     1954               loc-size = entry ( 2 , v-font7 )
     1955               loc-type = ""
     1956             .
     1957         end.
     1958         when 1 then do:
     1959             assign
     1960               loc-name = trim(entry ( 1 , v-font7 ))
     1961               loc-size = ""
     1962               loc-type = ""
     1963             .
     1964         end.
     1965       end case.
     1966     create temp-font.
     1967     assign
     1968       temp-font.fontnum  = 7
     1969       temp-font.fontname = trim(loc-name)
     1970       temp-font.fontsize = trim(loc-size)
     1971       temp-font.fonttype = trim(loc-type)
     1972       temp-font.v-row    = 62
     1973       temp-font.v-col    = 136
     1974       temp-font.v-row-lans = 43
     1975       temp-font.v-col-lans = 198
     1976     .
     1977     repeat ii = 16 to 100 :
     1978       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1979       if v-font = "" or v-font = ? then leave.
     1980       case num-entries (v-font) :
     1981         when 4 then do:
     1982             assign
     1983               loc-name = entry ( 1 , v-font )
     1984               loc-size = entry ( 2 , v-font )
     1985               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1986             .
     1987         end.
     1988         when 3 then do:
     1989             assign
     1990               loc-name = entry ( 1 , v-font )
     1991               loc-size = entry ( 2 , v-font )
     1992               loc-type = entry ( 3 , v-font )
     1993             .
     1994         end.
     1995         when 2 then do:
     1996             assign
     1997               loc-name = entry ( 1 , v-font )
     1998               loc-size = entry ( 2 , v-font )
     1999               loc-type = ""
     2000             .
     2001         end.
     2002         when 1 then do:
     2003             assign
     2004               loc-name = trim(entry ( 1 , v-font ))
     2005               loc-size = ""
     2006               loc-type = ""
     2007             .
     2008         end.
     2009       end case.
     2010     create temp-font.
     2011     assign
     2012       temp-font.fontnum  = ii
     2013       temp-font.fontname = trim(loc-name)
     2014       temp-font.fontsize = trim(loc-size)
     2015       temp-font.fonttype = trim(loc-type)
     2016     .
     2017     end.
     2018       for each temp-font :
     2019          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2020          if  vv = ? then vv =  0 .
     2021           run rep/exfont.p (
     2022             input   temp-font.fontname ,
     2023             input   vv ,
     2024             input   temp-font.fonttype ,
     2025             output  temp-font.font-h   ,
     2026             output  temp-font.font-w   )
     2027           .
     2028       end.
     2029   find first temp-font where  temp-font.fontnum  = 7  .
     2030   old_H = temp-font.font-H .
     2031   old_w = temp-font.font-W .
     2032   old-row = temp-font.v-row .
     2033   old-col = temp-font.v-col .
     2034   old-row-lans = temp-font.v-row-lans .
     2035   old-col-lans = temp-font.v-col-lans .
     2036       for each temp-font where
     2037                temp-font.fontnum  <> 7 :
     2038           assign
     2039               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2040               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2041               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2042               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2043           .
     2044       end.
     2045     end.
     2046   end procedure.
     2047   PROCEDURE How-name :
     2048   define input  parameter h as integer no-undo .
     2049   define input  parameter w as integer no-undo .
     2050   define output parameter n as character  no-undo .
     2051   define variable A4port-H as integer   no-undo init 63.
     2052   define variable A4port-W as integer   no-undo init 136.
     2053   define variable A4lans-H as integer   no-undo init 43.
     2054   define variable A4lans-W as integer   no-undo init 198.
     2055   define variable Strim-W  as integer   no-undo init 278.
     2056   run define-a4-size (
     2057        input ReportFontNum
     2058       ,output A4port-H
     2059       ,output A4port-W
     2060       ,output A4lans-H
     2061       ,output A4lans-W ).
     2062   If w >= 1 and w <= A4port-W Then DO:
     2063     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2064     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2065     If h > A4port-H              Then n = "to-file":U.
     2066   End.
     2067   If w > A4port-W and w <= A4lans-W Then DO:
     2068     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2069     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2070     If h > A4port-H              Then n = "to-file":U.
     2071   End.
     2072   If w > A4lans-W and w <= Strim-W Then DO:
     2073     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2074     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2075     If h > A4port-H              Then n = "to-file":U.
     2076   End.
     2077   If w > Strim-W Then DO:
     2078      n = "to-file":U.
     2079   End.
     2080   END PROCEDURE.
     2081   PROCEDURE define-a4-size :
     2082   define input  parameter p-ReportFontNum as integer   no-undo .
     2083   define output parameter A4port-H as integer   no-undo .
     2084   define output parameter A4port-W as integer   no-undo .
     2085   define output parameter A4lans-H as integer   no-undo .
     2086   define output parameter A4lans-W as integer   no-undo .
     2087   if not can-find (first temp-font ) then do:
     2088      run get-font-ini .
     2089   end.
     2090   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2091   if available temp-font then do:
     2092   assign
     2093     A4port-H = temp-font.v-row
     2094     A4port-W = temp-font.v-col
     2095     A4lans-H = temp-font.v-row-lans
     2096     A4lans-W = temp-font.v-col-lans
     2097   .
     2098   end.
     2099   else do:
     2100   assign
     2101     A4port-H = 63
     2102     A4port-W = 136
     2103     A4lans-H = 43
     2104     A4lans-W = 198
     2105   .
     2106   end.
     2107   END PROCEDURE.
     2108   define variable vss-include-info15 as character format "X(65)" no-undo
     2109   initial "@(#)$Workfile$ $Revision$".
     2110   procedure grplib-get-full-name :
     2111      define input parameter p-node-code  as integer      no-undo.
     2112      define output parameter p-full-name as character    no-undo.
     2113      do
     2114   on error undo, return error
     2115   :
     2116       define variable v-upper-code    as integer           no-undo.
     2117       define buffer buf_gds-grp       for ub.gds-grp.
     2118       define buffer buf_upper_gds-grp for ub.gds-grp.
     2119       find first buf_gds-grp no-lock
     2120            where buf_gds-grp.node-code = p-node-code
     2121       no-error.
     2122       if not available buf_gds-grp
     2123       then do:
     2124           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2125       end.
     2126       assign
     2127           p-full-name  = ""
     2128           v-upper-code = 1
     2129       .
     2130       do while buf_gds-grp.upper-code <> 0
     2131       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2132       :
     2133           assign
     2134               p-full-name  = buf_gds-grp.node-name
     2135                            + (if p-full-name <> "" then chr(47) else "")
     2136                            + p-full-name
     2137               v-upper-code = buf_gds-grp.upper-code
     2138           .
     2139           find first buf_gds-grp no-lock
     2140                where buf_gds-grp.node-code = v-upper-code
     2141           no-error.
     2142           if not available buf_gds-grp
     2143           then do:
     2144               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2145                                   + string( v-upper-code )
     2146                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2147           end.
     2148       end.
     2149       assign
     2150       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2151       .
     2152   end.
     2153   end .
     2154   procedure grplib-get-node-from-full-name :
     2155   define input parameter p-full-name as character no-undo .
     2156   define output parameter p-node-code as integer no-undo .
     2157   define variable v-ii as integer no-undo .
     2158   define variable v-upper-code as integer no-undo .
     2159   define variable v-root-code as integer no-undo .
     2160   define variable v-entry as character no-undo .
     2161   define buffer buf_gds-grp       for ub.gds-grp.
     2162   do
     2163   on error undo, return error
     2164   :
     2165     find first buf_gds-grp no-lock
     2166         where buf_gds-grp.upper-code = 0
     2167     no-error .
     2168     if not available buf_gds-grp
     2169     then do:
     2170         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2171     end.
     2172     else do:
     2173       assign
     2174       v-root-code = buf_gds-grp.node-code
     2175       .
     2176     end.
     2177     v-upper-code = v-root-code.
     2178     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2179       assign
     2180       v-entry = entry(v-ii, p-full-name, chr(47)).
     2181       if v-entry = '' then leave.
     2182       find first buf_gds-grp no-lock where
     2183                 buf_gds-grp.node-name = v-entry
     2184             and buf_gds-grp.upper-code = v-upper-code
     2185             no-error.
     2186       if not available buf_gds-grp then do:
     2187         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2188       end.
     2189       else do:
     2190         p-node-code = buf_gds-grp.node-code.
     2191         v-upper-code = buf_gds-grp.node-code.
     2192       end.
     2193     end.
     2194   end.
     2195   end .
     2196   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2197   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2198   procedure paramls-clear :
     2199     define buffer buf_temp-param for temp-param .
     2200     do
     2201     on error undo, return error return-value
     2202     :
     2203       for each buf_temp-param
     2204       on error undo, return error
     2205       :
     2206         delete buf_temp-param .
     2207       end.
     2208     end.
     2209   end procedure.
     2210   procedure paramls-write :
     2211     define input  parameter p-code     as character no-undo .
     2212     define input  parameter p-sub-code as character no-undo .
     2213     define input  parameter p-value    as character no-undo .
     2214     define buffer buf_temp-param for temp-param .
     2215     do
     2216     on error undo, return error return-value
     2217     :
     2218       find first buf_temp-param
     2219         where buf_temp-param.param-code     = p-code
     2220           and buf_temp-param.param-sub-code = p-sub-code
     2221         no-error .
     2222       if not available buf_temp-param then do:
     2223         create buf_temp-param .
     2224         assign
     2225           buf_temp-param.param-code     = p-code
     2226           buf_temp-param.param-sub-code = p-sub-code
     2227         .
     2228       end.
     2229       assign
     2230         buf_temp-param.param-value = p-value
     2231       .
     2232     end.
     2233   end procedure.
     2234   procedure paramls-read :
     2235     define input  parameter p-code          as character no-undo .
     2236     define input  parameter p-sub-code      as character no-undo .
     2237     define input  parameter p-default-value as character no-undo .
     2238     define output parameter p-value         as character no-undo .
     2239     define buffer buf_temp-param for temp-param .
     2240     do
     2241     on error undo, return error return-value
     2242     :
     2243       find first buf_temp-param
     2244         where buf_temp-param.param-code     = p-code
     2245           and buf_temp-param.param-sub-code = p-sub-code
     2246         no-error .
     2247       if available buf_temp-param then do:
     2248         assign
     2249           p-value = buf_temp-param.param-value
     2250         .
     2251       end.
     2252       else do:
     2253         assign
     2254           p-value = p-default-value
     2255         .
     2256       end.
     2257     end.
     2258   end procedure.
     2259   procedure paramls-append :
     2260     define input  parameter p-code     as character no-undo .
     2261     define input  parameter p-sub-code as character no-undo .
     2262     define input  parameter p-value    as character no-undo .
     2263     define buffer buf_temp-param for temp-param .
     2264     do
     2265     on error undo, return error return-value
     2266     :
     2267       find first buf_temp-param
     2268            where buf_temp-param.param-code     = p-code
     2269              and buf_temp-param.param-sub-code = p-sub-code
     2270         no-error .
     2271       if not available buf_temp-param then do:
     2272         create buf_temp-param .
     2273         assign
     2274           buf_temp-param.param-code     = p-code
     2275           buf_temp-param.param-sub-code = p-sub-code
     2276           buf_temp-param.param-value    = p-value
     2277         .
     2278       end.
     2279       else do:
     2280           assign
     2281               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2282           .
     2283       end.
     2284     end.
     2285   end procedure.
     2286   function fnc-convert-dot-to-colon returns character
     2287       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     2288   function fnc-convert-dot-to-colon returns character
     2289   (input p-data as decimal, input p-accur as character, input p-num as integer):
     2290       define variable result as character no-undo.
     2291       define variable v-str-result as character no-undo.
     2292       if p-data = ? then p-data = 0 .
     2293       p-data = round(p-data, p-num).
     2294       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     2295       return v-str-result.
     2296   END FUNCTION.
     2297   define variable g#report-num  as integer   no-undo .
     2298   procedure OpenForExcel :
     2299      define variable v-ch#ExcelApplication as com-handle no-undo .
     2300      define variable v-ch#Workbook         as com-handle no-undo .
     2301      define variable v-ch#Worksheet        as com-handle no-undo .
     2302      os-delete value( string( session:temp-directory ) +
     2303                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     2304      os-delete value( string( session:temp-directory ) +
     2305                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     2306      os-delete value( string( session:temp-directory ) +
     2307                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     2308      if Make-Excel
     2309      then do:
     2310         output stream ForExcel to value( string( session:temp-directory +
     2311                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     2312         assign
     2313            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     2314            number-list = 1
     2315         .
     2316         if make-excel-com
     2317         then do:
     2318   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2319   if valid-handle(ch#WorkSheet) then
     2320   RELEASE OBJECT ch#WorkSheet no-error.
     2321   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2322   if valid-handle(ch#Workbook) then
     2323   RELEASE OBJECT ch#Workbook no-error.
     2324   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2325   if valid-handle(ch#ExcelApplication) then
     2326   RELEASE OBJECT ch#ExcelApplication no-error.
     2327            create "Excel.Application" ch#excelApplication connect no-error.
     2328            if error-status:error
     2329            then do :
     2330           create "Excel.Application" ch#excelApplication no-error.
     2331       if error-status :error then do:
     2332           message
     2333           "Ошибка при запуске Excel" skip
     2334           error-status :get-message(1) skip
     2335           view-as alert-box error .
     2336           undo, return error .
     2337       end.
     2338            end.
     2339            assign
     2340               num#str#  = 0.
     2341               v-ch#excelApplication  = ch#excelApplication.
     2342               v-ch#excelApplication:Interactive = false.
     2343               v-ch#excelApplication:ScreenUpdating = false.
     2344               v-ch#excelApplication:Visible = false.
     2345               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     2346               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     2347               v-ch#Worksheet = ch#WorkSheet.
     2348               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     2349               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     2350               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     2351               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     2352            no-error .
     2353            if error-status:error
     2354            then do:
     2355               Make-Excel-com = false .
     2356               Make-Excel = false .
     2357               output Stream  ForExcel close.
     2358               os-delete value( string( session:temp-directory ) +
     2359                              "rpt" + string( g#report-num ) + ".txt":U ) .
     2360               os-delete value( string( session:temp-directory ) +
     2361                              "rpt" + string( g#report-num ) + ".frm":U ) .
     2362               return.
     2363            end.
     2364         end.
     2365      end.
     2366   end.
     2367   procedure CloseForExcel :
     2368      define variable ii as integer no-undo .
     2369      define variable vsheet-num as integer no-undo.
     2370      if Make-Excel
     2371      then  do:
     2372         output Stream  ForExcel close.
     2373         os-delete value( string( session:temp-directory ) +
     2374                                "rpt" + string( g#report-num ) + ".txt":U ) .
     2375         os-delete value( string( session:temp-directory ) +
     2376                                "rpt" + string( g#report-num ) + ".frm":U ) .
     2377         define buffer buf_sheetf for sheetf.
     2378         find last buf_sheetf no-error .
     2379         if available buf_sheetf
     2380         then
     2381            vsheet-num = buf_sheetf.sheet-num.
     2382         if vsheet-num > 1
     2383         then do:
     2384            do ii = 2 to vsheet-num:
     2385               os-delete value( string( session:temp-directory ) +
     2386                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     2387            end.
     2388         end.
     2389   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2390   if valid-handle(ch#WorkSheet) then
     2391   RELEASE OBJECT ch#WorkSheet no-error.
     2392   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2393   if valid-handle(ch#Workbook) then
     2394   RELEASE OBJECT ch#Workbook no-error.
     2395   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2396   if valid-handle(ch#ExcelApplication) then
     2397   RELEASE OBJECT ch#ExcelApplication no-error.
     2398      end.
     2399   end.
