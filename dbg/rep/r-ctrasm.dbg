     4733                   put stream OutStr-html unformatted
     4734               '<TH style="text-align: center;">' + string( v-asm-prc-balance , ">>9.999" ) + '</TH>'skip
     4735               '<TH style="text-align: center;">' + string( v-asm-prc-sale    , ">>9.999" ) + '</TH>'skip
     4736               '</TR>'skip
     4737           .
     4738           end.
     4739           assign
     4740             v-asm-tot-balance = v-asm-tot-balance + v-asm-balance
     4741             v-asm-tot-sale    = v-asm-tot-sale    + v-asm-sale
     4742             v-asm-tot-order   = v-asm-tot-order   + v-asm-order
     4743             v-asm-balance     = 0
     4744             v-asm-sale        = 0
     4745             v-asm-order       = 0
     4746           .
     4747         end.
     4748       end.
     4749       assign
     4750         v-gds-asm-tot-count = v-gds-tot-count * v-days-count
     4751         v-asm-prc-balance   = (v-gds-asm-tot-count - v-asm-tot-balance) / v-gds-asm-tot-count * 100
     4752         v-asm-prc-sale      = (v-gds-asm-tot-count - v-asm-tot-sale   ) / v-gds-asm-tot-count * 100
     4753         v-asm-prc-order     = (v-gds-asm-tot-count - v-asm-tot-order  ) / v-gds-asm-tot-count * 100
     4754       .
     4755       if p-group-by-order then do:
     4756               put stream OutStr-html unformatted
     4757               '<TH style="text-align: center;">' + string( v-asm-prc-balance , ">>9.999" ) + '</TH>'skip
     4758               '<TH style="text-align: center;">' + string( v-asm-prc-sale    , ">>9.999" ) + '</TH>'skip
     4759               '<TH style="text-align: center;">' + string( v-asm-prc-order   , ">>9.999" ) + '</TH>'skip
     4760               '</TR>'skip
     4761           .
     4762        end.
     4763        else do:
     4764               put stream OutStr-html unformatted
     4765               '<TH style="text-align: center;">' + string( v-asm-prc-balance , ">>9.999" ) + '</TH>'skip
     4766               '<TH style="text-align: center;">' + string( v-asm-prc-sale    , ">>9.999" ) + '</TH>'skip
     4767               '</TR>'skip
     4768           .
     4769        end.
     4770       assign
     4771         v-asm-tot-balance     = 0
     4772         v-asm-tot-sale        = 0
     4773         v-asm-tot-order       = 0
     4774         v-gds-asm-count       = 0
     4775         v-gds-asm-tot-count   = 0
     4776       .
     4777     end.
     4778     run waitfram-hide in this-procedure .
     4779   end.
     4780   end procedure.
     4781   procedure print-schedule :
     4782   do
     4783   on error undo, return error return-value
     4784   :
     4785   end.
     4786   end procedure.
     4787   procedure write-log :
     4788     define input  parameter p-str as character no-undo .
     4789   do
     4790   on error undo, return error return-value
     4791   :
     4792     if p-str = ''
     4793     then do:
     4794       return .
     4795     end.
     4796     if p-is-schedule = yes
     4797     then do:
     4798       if parparentproc :get-signature("write-to-log") <> "":u
     4799       then do:
     4800         run write-to-log in parparentproc ( input p-str ) .
     4801       end.
     4802       assign
     4803         p-str = substitute("&1 &2&3", cur-time-string-sec() , p-str, chr(10))
     4804         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     4805         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     4806         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     4807       .
     4808       run gbl/fileapnd.p
     4809         ( input "r-ctrasm.log"
     4810          ,input p-str
     4811          ,input 10
     4812         ) no-error .
     4813       if error-status:error then do:
     4814         return error return-value .
     4815       end.
     4816     end.
     4817   end.
     4818   end procedure.
     4819   procedure proc-message :
     4820     define input  parameter p-message as character no-undo .
     4821   do
     4822   on error undo, return error return-value
     4823   :
     4824     if p-is-schedule = yes
     4825     then do:
     4826       run write-log in this-procedure ( input p-message ) .
     4827     end.
     4828     else do:
     4829       message
     4830         p-message
     4831       view-as alert-box information.
     4832     end.
     4833   end.
     4834   end procedure.
     4835   procedure cb_set-objects :
     4836   define input parameter p-obj-type-code as character no-undo .
     4837   define buffer buf_clients for ub.clients.
     4838   do
     4839   on error undo, return error
     4840   :
     4841     find first buf_clients no-lock where
     4842               buf_clients.obj-type = substring(p-obj-type-code, 1, 3)
     4843           and buf_clients.obj-code = integer(substring(p-obj-type-code, 4)) no-error.
     4844     if available buf_clients then do:
     4845       run create_obj-list in this-procedure ( input buf_clients.obj-type
     4846                                             , input buf_clients.obj-code
     4847                                             ) .
     4848     end.
     4849   end.
     4850   end procedure.
