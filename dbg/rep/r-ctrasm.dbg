     3255                   buf_tt-suppliers.obj-type  = buf_tt-goods.obj-type
     3256                   buf_tt-suppliers.obj-code  = buf_tt-goods.obj-code
     3257                   buf_tt-suppliers.gds-code  = buf_tt-goods.gds-code
     3258                   buf_tt-suppliers.supp-type = buf_ord-doc.cli-type
     3259                   buf_tt-suppliers.supp-code = buf_ord-doc.cli-code
     3260                 .
     3261               end.
     3262             end.
     3263           end.
     3264         end.
     3265         assign
