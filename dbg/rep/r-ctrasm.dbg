     3471     end.
     3472     run waitfram-hide in this-procedure .
     3473   end.
     3474   end procedure.
     3475   procedure fill-tt-report :
     3476   do
     3477   on error undo, return error return-value
     3478   :
     3479     run initialize-tt-report in this-procedure .
     3480     if p-group-by-post = yes
     3481     then do:
     3482       run fill-tt-report-supp in this-procedure .
     3483     end.
     3484     else do:
     3485       run fill-tt-report-no-supp in this-procedure .
     3486     end.
     3487   end.
     3488   end procedure.
     3489   procedure initialize-tt-report :
     3490     define buffer buf_tt-report   for tt-report.
     3491     define buffer buf_tt-obj-list for tt-obj-list.
     3492     define buffer buf_tt-goods    for tt-goods.
     3493     define buffer buf_clients     for ub.clients.
     3494     define variable v-tmp-date  as date      no-undo .
     3495     define variable v-i         as integer   no-undo .
     3496   do
     3497   on error undo, return error return-value
     3498   :
     3499     empty temp-table buf_tt-report.
     3500     if p-group-by-post = yes
     3501     then do:
     3502       return .
     3503     end.
     3504     else do:
     3505       run waitfram-show in this-procedure ( input "Инициализация...":u ) .
     3506       for each buf_tt-goods
     3507       :
     3508         assign
     3509           v-tmp-date = p-date-start
     3510           v-i        = v-i + 1
     3511         .
     3512         do while v-tmp-date <= p-date-finish
     3513         :
     3514           create buf_tt-report.
     3515           assign
     3516             buf_tt-report.obj-type  = buf_tt-goods.obj-type
     3517             buf_tt-report.obj-code  = buf_tt-goods.obj-code
     3518             buf_tt-report.gds-code  = buf_tt-goods.gds-code
     3519             buf_tt-report.artic     = buf_tt-goods.artic
     3520             buf_tt-report.prod-type = buf_tt-goods.prod-type
     3521             buf_tt-report.prod-code = buf_tt-goods.prod-code
     3522             buf_tt-report.grp-code  = buf_tt-goods.grp-code
     3523             buf_tt-report.r-date    = v-tmp-date
     3524             v-tmp-date              = v-tmp-date + 1
     3525           .
     3526         end.
     3527       end.
     3528     end.
     3529     run waitfram-hide in this-procedure .
     3530   end.
     3531   end procedure.
     3532   procedure filter-tt-report :
     3533     define buffer buf_tt-obj-list     for tt-obj-list.
     3534     define buffer buf_tt-report       for tt-report.
     3535     define buffer buf_tt-goods        for tt-goods.
     3536     define buffer buf_tt-filtred-gds  for tt-filtred-gds.
     3537     define variable v-days-wt-goods as integer   no-undo .
     3538   do
     3539   on error undo, return error return-value
     3540   :
     3541     if p-days-wt-goods = 0
     3542     then do:
     3543       return .
     3544     end.
     3545     for each buf_tt-obj-list
     3546     :
     3547       run waitfram-show in this-procedure ( input substitute( "Фильтрация результатов по &1 &2...":u
     3548                                                             , buf_tt-obj-list.obj-type
     3549                                                             , buf_tt-obj-list.obj-code
     3550                                                             )
     3551                                           ) .
     3552       for each buf_tt-report
     3553         where buf_tt-report.obj-type = buf_tt-obj-list.obj-type
     3554           and buf_tt-report.obj-code = buf_tt-obj-list.obj-code
     3555       break by buf_tt-report.gds-code
     3556       :
     3557         if buf_tt-report.balance <= p-critical-qnty-balance
     3558         then do:
     3559           assign
     3560             v-days-wt-goods = v-days-wt-goods + 1
     3561           .
     3562         end.
     3563         if last-of( buf_tt-report.gds-code )
     3564         then do:
     3565           if v-days-wt-goods < p-days-wt-goods
     3566           then do:
     3567             create buf_tt-filtred-gds.
     3568             assign
     3569               buf_tt-filtred-gds.obj-type   = buf_tt-report.obj-type
     3570               buf_tt-filtred-gds.obj-code   = buf_tt-report.obj-code
     3571               buf_tt-filtred-gds.gds-code   = buf_tt-report.gds-code
     3572               buf_tt-filtred-gds.supp-type  = buf_tt-report.supp-type
     3573               buf_tt-filtred-gds.supp-code  = buf_tt-report.supp-code
     3574             .
     3575           end.
     3576           assign
     3577             v-days-wt-goods = 0
     3578           .
     3579         end.
     3580       end.
     3581     end.
     3582     run waitfram-show in this-procedure ( input substitute( "Исключение отфильтрованых товаров...":u ) ) .
     3583     for each buf_tt-filtred-gds
     3584     :
     3585       find first buf_tt-goods
     3586         where buf_tt-goods.obj-type  = buf_tt-filtred-gds.obj-type
     3587           and buf_tt-goods.obj-code  = buf_tt-filtred-gds.obj-code
     3588           and buf_tt-goods.gds-code  = buf_tt-filtred-gds.gds-code
     3589       no-error.
     3590       if available buf_tt-goods
     3591       then do:
     3592         delete buf_tt-goods.
     3593       end.
     3594       for each buf_tt-report
     3595         where buf_tt-report.obj-type  = buf_tt-filtred-gds.obj-type
     3596           and buf_tt-report.obj-code  = buf_tt-filtred-gds.obj-code
     3597           and buf_tt-report.gds-code  = buf_tt-filtred-gds.gds-code
     3598           and buf_tt-report.supp-type = buf_tt-filtred-gds.supp-type
     3599           and buf_tt-report.supp-code = buf_tt-filtred-gds.supp-code
     3600       :
     3601         delete buf_tt-report.
     3602       end.
     3603     end.
     3604     empty temp-table buf_tt-filtred-gds.
     3605     run waitfram-hide in this-procedure .
     3606   end.
     3607   end procedure.
     3608   procedure print-report :
     3609   do
     3610   on error undo, return error return-value
     3611   :
     3612     run filter-tt-report in this-procedure .
     3613     run print-no-schedule in this-procedure .
     3614   end.
     3615   end procedure.
     3616   procedure print-no-schedule :
     3617   do
     3618   on error undo, return error return-value
     3619   :
     3620     if p-group-by-post = yes
     3621     then do:
     3622       run print-no-schedule-supp in this-procedure .
     3623     end.
     3624     else do:
     3625       run print-no-schedule-no-supp in this-procedure .
     3626     end.
     3627   end.
     3628   end procedure.
     3629   procedure print-no-schedule-no-supp :
     3630     define buffer buf_tt-obj-list   for tt-obj-list.
     3631     define buffer buf_tt-report     for tt-report.
     3632     define buffer buf_tt-report-day for tt-report.
     3633     define buffer buf_tt-goods      for tt-goods.
     3634     define variable v-i               as integer   no-undo .
     3635     define variable ii                as integer   no-undo .
     3636     define variable v-line-1          as character no-undo .
     3637     define variable v-clmn-label-1    as character no-undo .
     3638     define variable v-clmn-label-2    as character no-undo .
     3639     define variable v-clmn-format     as character no-undo .
     3640     define variable v-clmn-sizes      as character no-undo .
     3641     define variable v-tmp-date        as date      no-undo .
     3642     define variable v-days-count      as integer   no-undo .
     3643     define variable v-list-num        as integer   no-undo .
     3644     define variable v-grp-tot-balance as decimal   no-undo .
     3645     define variable v-grp-tot-sale    as decimal   no-undo .
     3646     define variable v-grp-tot-order   as decimal   no-undo .
     3647     define variable v-grp-balance     as decimal   no-undo .
     3648     define variable v-grp-sale        as decimal   no-undo .
     3649     define variable v-grp-order       as decimal   no-undo .
     3650     define variable v-grp-prc-balance as decimal   no-undo .
     3651     define variable v-grp-prc-sale    as decimal   no-undo .
     3652     define variable v-grp-prc-order   as decimal   no-undo .
     3653     define variable v-gds-prc-balance as decimal   no-undo .
     3654     define variable v-gds-prc-sale    as decimal   no-undo .
     3655     define variable v-gds-prc-order   as decimal   no-undo .
     3656     define variable v-num-days-wo-balance     as decimal   no-undo .
     3657     define variable v-num-days-wo-sale        as decimal   no-undo .
     3658     define variable v-num-days-wo-order       as decimal   no-undo .
     3659     define variable v-gds-grp-count           as decimal   no-undo .
     3660     define variable v-gds-grp-tot-count       as decimal   no-undo .
     3661     define variable v-gds-tot-count           as decimal   no-undo .
     3662     define variable v-gds-asm-count           as decimal   no-undo .
     3663     define variable v-balance                 as decimal   no-undo .
     3664     define variable v-balance-last            as decimal   no-undo .
     3665     define variable v-sum-sale                as decimal   no-undo .
     3666     define variable v-gds-asm-tot-count       as decimal   no-undo .
     3667     define variable v-tot-num-days-wo-balance as decimal   no-undo .
     3668     define variable v-tot-num-days-wo-sale    as decimal   no-undo .
     3669     define variable v-tot-num-days-wo-order   as decimal   no-undo .
     3670     define variable v-tot-asm-gds-count       as decimal   no-undo .
     3671     define variable v-tot-balance             as decimal   no-undo .
     3672     define variable v-tot-sale                as decimal   no-undo .
     3673     define variable v-tot-order               as decimal   no-undo .
     3674     define variable v-tot-asm-balance         as decimal   no-undo .
     3675     define variable v-tot-asm-sale            as decimal   no-undo .
     3676     define variable v-tot-asm-order           as decimal   no-undo .
     3677     define variable v-grp-start-line          as integer   no-undo .
     3678     define variable v-grp-end-line            as integer   no-undo .
     3679     define variable v-grp-list                as character no-undo .
     3680     define variable jj                        as integer   no-undo .
     3681     define VARIABLE v-jj                      as integer   no-undo .
     3682     DEFINE VARIABLE v-first                   as LOGICAL   NO-UNDO .
     3683     DEFINE VARIABLE v-last                    as LOGICAL   NO-UNDO .
     3684   do
     3685   on error undo, return error return-value
     3686   :
     3687     assign
     3688       v-days-count = p-date-finish - p-date-start + 1
     3689     .
     3690     for each buf_tt-obj-list
     3691     :
     3692       run waitfram-show in this-procedure ( input substitute( "Расчет итогов по объекту &1 &2...":U
     3693                                                             , buf_tt-obj-list.obj-type
     3694                                                             , buf_tt-obj-list.obj-code
     3695                                                             )
     3696                                           ) .
     3697       assign
     3698         v-tmp-date      = p-date-start
     3699         v-i             = 3
     3700         v-list-num      = v-list-num + 1
     3701         v-clmn-label-1  = '':u
     3702         v-clmn-label-2  = '':u
     3703         v-clmn-format   = '':u
     3704         v-clmn-sizes    = '':u
     3705         v-line-1        = '':u
     3706       .
     3707       if p-gds-by-am = yes
     3708       then do:
     3709         assign
     3710           v-gds-tot-count = 0
     3711           v-i             = 0
     3712         .
     3713         for each buf_tt-goods
     3714           where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     3715             and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     3716         :
     3717           assign
     3718             v-i = v-i + 1
     3719           .
     3720         end.
     3721         put stream OutStr-html unformatted
     3722           '<TR>'skip
     3723               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute("По АМ на &1 товаров":U , v-i )) + '</TD>' skip
     3724           '</TR>'skip
     3725       .
     3726       end.
     3727       if p-group-by-post = yes
     3728       then do:
     3729         put stream OutStr-html unformatted
     3730           '<TR>'skip
     3731               '<TD colspan="11" STYLE="font-size: 14px;">Группировка по поставщику</TD>' skip
     3732           '</TR>'skip
     3733       .
     3734       end.
     3735      put stream OutStr-html unformatted
     3736           '<TR>'skip
     3737               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute( "Критический остаток: &1" , p-critical-qnty-balance )) + '</TD>' skip
     3738           '</TR>'skip
     3739       .
     3740        put stream OutStr-html unformatted
     3741           '<TR>'skip
     3742               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute( "Критическая продажа: &1" , p-critical-qnty-sale    )) + '</TD>' skip
     3743           '</TR>'skip
     3744       .
     3745        put stream OutStr-html unformatted
     3746           '<TR>'skip
     3747               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute( "Критический заказ: &1"   , p-critical-qnty-order   )) + '</TD>' skip
     3748           '</TR>'skip
     3749       .
     3750        put stream OutStr-html unformatted
     3751           '<TR>'skip
     3752               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute( "Фильтры:"                                          )) + '</TD>' skip
     3753           '</TR>'skip
     3754       .
     3755        put stream OutStr-html unformatted
     3756           '<TR>'skip
     3757               '<TD colspan="11" STYLE="font-size: 14px;">' + string(substitute( "Дней без товара: &1"     , p-days-wt-goods         )) + '</TD>' skip
     3758           '</TR>'skip
     3759       .
     3760         put stream OutStr-html unformatted
     3761           '<TR>'skip
     3762               '<TD colspan="11" STYLE="font-size: 14px;">Показывать товары с ИЖТ:' + string(( if p-igt-all   = yes then 'все':U else
     3763         ( if p-igt-new   = yes then 'Новинка':U   + "," else "" ) +
     3764         ( if p-igt-com   = yes then 'Основная группа':U   + "," else "" ) +
     3765         ( if p-igt-spec  = yes then 'Нештатный':U  + "," else "" ) +
     3766         ( if p-igt-del   = yes then 'На вывод из ассортимента':U   + "," else "" ) +
     3767         ( if p-igt-empty = yes then 'Пусто':U       else "" ) )) + '</TD>' skip
     3768           '</TR>'skip
     3769           '</thead>'skip
     3770       .
     3771          put stream OutStr-html unformatted
     3772           '<tbody>'
     3773           '<TR>'skip
     3774               '<TH rowspan="2" style="text-align: center; width: 40px;">Артикул</TH>'skip
     3775               '<TH rowspan="2" style="text-align: center; width: 60px;">Название</TH>'skip
     3776           .
     3777           if p-group-by-order then do:
     3778               v-jj = 3 .
     3779           end.
     3780           else do:
     3781               v-jj = 2 .
     3782           end.
     3783       do while v-tmp-date <= p-date-finish
     3784       :
     3785           put stream OutStr-html unformatted
     3786               '<TH colspan ="' + string(v-jj) + '" style="text-align: center;">' + string(v-tmp-date,"99.99.9999") + '</TH>'skip
     3787           .
     3788           v-tmp-date     = v-tmp-date + 1.
     3789           ii = ii + 1.
     3790       end.
     3791          put stream OutStr-html unformatted
     3792               '<TH colspan="' + string(v-jj) + '" style="text-align: center;">Итого %</TH>'skip
     3793          .
     3794          put stream OutStr-html unformatted
     3795               '<TH rowspan="2" style="text-align: center; width: 60px;">Средний товарный запас</TH>'skip
     3796               '<TH rowspan="2" style="text-align: center; width: 60px;">Об. дн.</TH>'skip
     3797               '<TH rowspan="2" style="text-align: center; width: 60px;">Об раз</TH>'skip
     3798           .
     3799          put stream OutStr-html unformatted
     3800           '</TR>'skip
     3801           '<TR>'skip
     3802           .
     3803       v-tmp-date      = p-date-start.
     3804       do while v-tmp-date <= p-date-finish
     3805       :
     3806           put stream OutStr-html unformatted
     3807               '<TH colstyle="text-align: center; width: 20px;">О</TH>'skip
     3808               '<TH colstyle="text-align: center; width: 20px;">П</TH>'skip
     3809           .
     3810           if p-group-by-order = yes then do:
     3811           put stream OutStr-html UNFORMATTED
     3812               '<TH colstyle="text-align: center; width: 20px;">З</TH>'skip
     3813           .
     3814           end.
     3815           v-tmp-date     = v-tmp-date + 1.
     3816       end.
     3817       if p-group-by-order = yes then do:
     3818          put stream OutStr-html unformatted
     3819               '<TH colstyle="text-align: center; width: 20px;">% прис</TH>'skip
     3820               '<TH colstyle="text-align: center; width: 20px;">% прод</TH>'skip
     3821               '<TH colstyle="text-align: center; width: 20px;">% зак</TH>'skip
     3822           '</TR>'skip
     3823           .
     3824       end.
     3825       else do:
     3826          put stream OutStr-html unformatted
     3827               '<TH colstyle="text-align: center; width: 20px;">% прис</TH>'skip
     3828               '<TH colstyle="text-align: center; width: 20px;">% прод</TH>'skip
     3829           '</TR>'skip
     3830           .
     3831       end.
     3832       for each buf_tt-report
     3833         where buf_tt-report.obj-type = buf_tt-obj-list.obj-type
     3834           and buf_tt-report.obj-code = buf_tt-obj-list.obj-code
     3835       break by buf_tt-report.grp-code
     3836             by buf_tt-report.gds-code
     3837             by buf_tt-report.r-date
     3838       :
     3839         v-first = no .
     3840         v-last = no .
     3841         if first-of(buf_tt-report.gds-code)
     3842         then do:
     3843           find first buf_tt-goods
     3844             where buf_tt-goods.obj-type = buf_tt-report.obj-type
     3845               and buf_tt-goods.obj-code = buf_tt-report.obj-code
     3846               and buf_tt-goods.gds-code = buf_tt-report.gds-code
     3847           no-error .
     3848           if available buf_tt-goods
     3849           then do:
     3850               assign
     3851                   v-balance = 0
     3852                   v-balance-last = 0
     3853                   v-sum-sale = 0
     3854               .
     3855               v-first = yes .
     3856           put stream OutStr-html unformatted
     3857           '<TR>'skip
     3858               '<TD style="text-align: center;">' + buf_tt-goods.artic + '</TD>'skip
     3859               '<TD style="text-align: center;">' + buf_tt-goods.gds-name + '</TD>'skip
     3860           .
     3861           end.
     3862         end.
     3863         if last-of(buf_tt-report.gds-code)
     3864         then do:
     3865           find first buf_tt-goods
     3866             where buf_tt-goods.obj-type = buf_tt-report.obj-type
     3867               and buf_tt-goods.obj-code = buf_tt-report.obj-code
     3868               and buf_tt-goods.gds-code = buf_tt-report.gds-code
     3869           no-error .
     3870           if available buf_tt-goods
     3871           then do:
     3872              v-last = yes .
     3873              v-balance-last = buf_tt-report.balance / 2.
     3874           end.
     3875         end.
     3876           put stream OutStr-html unformatted
     3877               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(buf_tt-report.balance,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-report.balance,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3878               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(buf_tt-report.sale,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-report.sale,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3879           .
     3880       if p-group-by-order then do:
     3881           put stream OutStr-html unformatted
     3882               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(buf_tt-report.order,"->>>>>>>>>>>9.999",3) + '" style="text-align: right;">' + fnc-convert-dot-to-colon(buf_tt-report.order,"->>>>>>>>>>>9.999",3) +  '</TD>'skip
     3883           .
     3884       end.
     3885         if v-first = yes then do:
     3886             v-balance = buf_tt-report.balance / 2 .
     3887         end.
     3888         else do:
     3889             if v-last = yes then do:
     3890                 v-balance = v-balance + v-balance-last.
     3891             end.
     3892             else do:
     3893                 v-balance = v-balance + buf_tt-report.balance.
     3894             end.
     3895         end.
     3896         v-sum-sale = v-sum-sale + buf_tt-report.sale .
     3897         if buf_tt-report.balance <= p-critical-qnty-balance
     3898         then do:
     3899           assign
     3900             v-num-days-wo-balance = v-num-days-wo-balance + 1
     3901           .
     3902         end.
     3903         if buf_tt-report.sale <= p-critical-qnty-sale
     3904         then do:
     3905           assign
     3906             v-num-days-wo-sale  = v-num-days-wo-sale + 1
     3907           .
     3908         end.
     3909         if buf_tt-report.order <= p-critical-qnty-order
     3910         then do:
     3911           assign
     3912             v-num-days-wo-order = v-num-days-wo-order + 1
     3913           .
     3914         end.
     3915         if last-of(buf_tt-report.gds-code)
     3916         then do:
     3917           assign
     3918             v-gds-prc-balance = ( ( v-days-count - v-num-days-wo-balance ) / v-days-count ) * 100
     3919             v-gds-prc-sale    = ( ( v-days-count - v-num-days-wo-sale    ) / v-days-count ) * 100
     3920             v-gds-prc-order   = ( ( v-days-count - v-num-days-wo-order   ) / v-days-count ) * 100
     3921             v-grp-end-line    = v-grp-end-line + 1
     3922           .
     3923           put stream OutStr-html unformatted
     3924                   '<TD num="0.000" val="' + fnc-convert-dot-to-colon(v-gds-prc-balance,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(v-gds-prc-balance,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3925                   '<TD num="0.000" val="' + fnc-convert-dot-to-colon(v-gds-prc-sale,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(v-gds-prc-sale,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3926           .
     3927           if p-group-by-order then do:
     3928           put stream OutStr-html unformatted
     3929               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(v-gds-prc-order,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(v-gds-prc-order,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3930           .
     3931           end.
     3932           put stream OutStr-html unformatted
     3933               '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-balance / (ii - 1)),"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-balance / (ii - 1)),"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3934           .
     3935           if v-sum-sale <> 0 then do:
     3936           put stream OutStr-html unformatted
     3937               '<TD num="0.000" val="' + fnc-convert-dot-to-colon((((v-balance / (ii - 1)) * ii ) / v-sum-sale  ),"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((((v-balance / (ii - 1)) * ii ) / v-sum-sale  ),"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3938           .
     3939           end.
     3940           else do:
     3941               put stream OutStr-html unformatted
     3942               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(0.000,"->>>>>>>>>>>9.999",3) + '"style="text-align:right;">' + fnc-convert-dot-to-colon(0.000,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3943           .
     3944           end.
     3945           if v-balance <> 0 then do:
     3946           put stream OutStr-html unformatted
     3947               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(v-sum-sale /(v-balance / (ii - 1)),"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(v-sum-sale /(v-balance / (ii - 1)),"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3948           .
     3949           end.
     3950           else do:
     3951               put stream OutStr-html unformatted
     3952               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(0.000,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(0.000,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     3953           .
     3954           end.
     3955          put stream OutStr-html unformatted
     3956           '</TR>'skip
     3957           .
     3958           assign
     3959             v-tot-num-days-wo-balance = v-tot-num-days-wo-balance + v-num-days-wo-balance
     3960             v-tot-num-days-wo-sale    = v-tot-num-days-wo-sale    + v-num-days-wo-sale
     3961             v-tot-num-days-wo-order   = v-tot-num-days-wo-order   + v-num-days-wo-order
     3962             v-num-days-wo-balance     = 0
     3963             v-num-days-wo-sale        = 0
     3964             v-num-days-wo-order       = 0
     3965           .
     3966         end.
     3967         if last-of(buf_tt-report.grp-code)
     3968         then do:
     3969           assign
     3970             v-gds-grp-count   = 0
     3971             v-grp-list        = v-grp-list + substitute("&1&2&3" , v-grp-start-line , chr(1), v-grp-end-line ) + chr(4)
     3972             v-grp-start-line  = v-grp-end-line + 2
     3973             v-grp-end-line    = v-grp-start-line - 1
     3974           .
     3975           for each buf_tt-goods
     3976             where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     3977               and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     3978               and buf_tt-goods.grp-code = buf_tt-report.grp-code
     3979           :
     3980             assign
     3981               v-gds-grp-count = v-gds-grp-count + 1
     3982             .
     3983           end.
     3984           find first buf_tt-goods
     3985             where buf_tt-goods.obj-type = buf_tt-report.obj-type
     3986               and buf_tt-goods.obj-code = buf_tt-report.obj-code
     3987               and buf_tt-goods.gds-code = buf_tt-report.gds-code
     3988           no-error .
     3989           if available buf_tt-goods
     3990           then do:
     3991           put stream OutStr-html unformatted
     3992           '<TR>'skip
     3993               '<TD colspan = "2" style="text-align: center;">Итого % группы' + buf_tt-goods.grp-name + '</TD>'skip
     3994           .
     3995           end.
     3996           for each buf_tt-report-day
     3997             where buf_tt-report-day.obj-type = buf_tt-obj-list.obj-type
     3998               and buf_tt-report-day.obj-code = buf_tt-obj-list.obj-code
     3999               and buf_tt-report-day.grp-code = buf_tt-report.grp-code
     4000           break by buf_tt-report-day.r-date
     4001           :
     4002             if buf_tt-report-day.balance <= p-critical-qnty-balance
     4003             then do:
     4004               assign
     4005                 v-grp-balance = v-grp-balance + 1
     4006               .
     4007             end.
     4008             if buf_tt-report-day.sale <= p-critical-qnty-sale
     4009             then do:
     4010               assign
     4011                 v-grp-sale  = v-grp-sale + 1
     4012               .
     4013             end.
     4014             if buf_tt-report-day.order <= p-critical-qnty-order
     4015             then do:
     4016               assign
     4017                 v-grp-order = v-grp-order + 1
     4018               .
     4019             end.
     4020             if last-of(buf_tt-report-day.r-date)
     4021             then do:
     4022           put stream OutStr-html unformatted
     4023               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(((v-gds-grp-count - v-grp-balance) / v-gds-grp-count) * 100,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(((v-gds-grp-count - v-grp-balance) / v-gds-grp-count) * 100,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4024               '<TD num="0.000" val="' + fnc-convert-dot-to-colon( ((v-gds-grp-count - v-grp-sale   ) / v-gds-grp-count) * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon( ((v-gds-grp-count - v-grp-sale   ) / v-gds-grp-count) * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4025            .
     4026           if p-group-by-order then do:
     4027           put stream OutStr-html unformatted
     4028               '<TD num="0.000" val="' + fnc-convert-dot-to-colon(((v-gds-grp-count - v-grp-order  ) / v-gds-grp-count) * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon(((v-gds-grp-count - v-grp-order  ) / v-gds-grp-count) * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4029           .
     4030           end.
     4031               assign
     4032                 v-grp-tot-balance = v-grp-tot-balance + v-grp-balance
     4033                 v-grp-tot-sale    = v-grp-tot-sale    + v-grp-sale
     4034                 v-grp-tot-order   = v-grp-tot-order   + v-grp-order
     4035                 v-grp-balance     = 0
     4036                 v-grp-sale        = 0
     4037                 v-grp-order       = 0
     4038               .
     4039             end.
     4040           end.
     4041           assign
     4042             v-gds-grp-tot-count = v-gds-grp-count * v-days-count
     4043           .
     4044           put stream OutStr-html unformatted
     4045           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-balance) / ( v-gds-grp-tot-count ) * 100,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-balance) / ( v-gds-grp-tot-count ) * 100,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4046           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-sale   ) / ( v-gds-grp-tot-count ) * 100,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-sale   ) / ( v-gds-grp-tot-count ) * 100,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4047           .
     4048           if p-group-by-order then do:
     4049           put stream OutStr-html unformatted
     4050           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-order  ) / ( v-gds-grp-tot-count ) * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-grp-tot-count - v-grp-tot-order  ) / ( v-gds-grp-tot-count ) * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4051           .
     4052           end.
     4053           put stream OutStr-html unformatted
     4054               '<TD style="text-align: center;"></TD>'skip
     4055               '<TD style="text-align: center;"></TD>'skip
     4056               '<TD style="text-align: center;"></TD>'skip
     4057           .
     4058           put stream OutStr-html unformatted
     4059           '</TR>'skip
     4060           .
     4061           assign
     4062             v-grp-tot-balance = 0
     4063             v-grp-tot-sale    = 0
     4064             v-grp-tot-order   = 0
     4065             v-gds-tot-count   = v-gds-tot-count + v-gds-grp-count
     4066           .
     4067         end.
     4068       end.
     4069               put stream OutStr-html unformatted
     4070           '<TR>'skip
     4071               '<TD colspan = "2" style="text-align: center;">Итого по матрице</TD>'skip
     4072           .
     4073       for each buf_tt-report-day
     4074         where buf_tt-report-day.obj-type = buf_tt-obj-list.obj-type
     4075           and buf_tt-report-day.obj-code = buf_tt-obj-list.obj-code
     4076       break by buf_tt-report-day.r-date
     4077       :
     4078         if buf_tt-report-day.balance <= p-critical-qnty-balance
     4079         then do:
     4080           assign
     4081             v-tot-balance = v-tot-balance + 1
     4082           .
     4083         end.
     4084         if buf_tt-report-day.sale <= p-critical-qnty-sale
     4085         then do:
     4086           assign
     4087             v-tot-sale  = v-tot-sale + 1
     4088           .
     4089         end.
     4090         if buf_tt-report-day.order <= p-critical-qnty-order
     4091         then do:
     4092           assign
     4093             v-tot-order = v-tot-order + 1
     4094           .
     4095         end.
     4096         if last-of(buf_tt-report-day.r-date)
     4097         then do:
     4098           put stream OutStr-html unformatted
     4099           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-balance  ) / v-gds-tot-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-balance  ) / v-gds-tot-count * 100,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4100           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-sale     ) / v-gds-tot-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-sale     ) / v-gds-tot-count * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4101           .
     4102           if p-group-by-order then do:
     4103           put stream OutStr-html unformatted
     4104           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-order    ) / v-gds-tot-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-gds-tot-count - v-tot-order    ) / v-gds-tot-count * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4105           .
     4106           end.
     4107           assign
     4108             v-tot-asm-balance = v-tot-asm-balance + v-tot-balance
     4109             v-tot-asm-sale    = v-tot-asm-sale    + v-tot-sale
     4110             v-tot-asm-order   = v-tot-asm-order   + v-tot-order
     4111             v-tot-balance     = 0
     4112             v-tot-sale        = 0
     4113             v-tot-order       = 0
     4114           .
     4115         end.
     4116       end.
     4117       assign
     4118         v-tot-asm-gds-count = v-gds-tot-count * v-days-count
     4119       .
     4120           put stream OutStr-html unformatted
     4121           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-balance ) / v-tot-asm-gds-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-balance ) / v-tot-asm-gds-count * 100,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4122           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-sale    ) / v-tot-asm-gds-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-sale    ) / v-tot-asm-gds-count * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4123           .
     4124           if p-group-by-order then do:
     4125           put stream OutStr-html unformatted
     4126           '<TD num="0.000" val="' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-order   ) / v-tot-asm-gds-count * 100 ,"->>>>>>>>>>>9.999",3) + '"style="text-align: right;">' + fnc-convert-dot-to-colon((v-tot-asm-gds-count - v-tot-asm-order   ) / v-tot-asm-gds-count * 100 ,"->>>>>>>>>>>9.999",3) + '</TD>'skip
     4127           .
     4128           end.
     4129           put stream OutStr-html unformatted
     4130               '<TD style="text-align: center;"></TD>'skip
     4131               '<TD style="text-align: center;"></TD>'skip
     4132               '<TD style="text-align: center;"></TD>'skip
     4133           .
     4134           put stream OutStr-html unformatted
     4135           '</TR>'skip
     4136           .
     4137       assign
     4138         v-tot-asm-gds-count = 0
     4139         v-tot-asm-balance   = 0
     4140         v-tot-asm-sale      = 0
     4141         v-tot-asm-order     = 0
     4142         v-gds-tot-count     = 0
     4143       .
     4144     end.
     4145     run waitfram-hide in this-procedure .
     4146   end.
     4147   end procedure.
     4148   procedure print-no-schedule-supp :
     4149     define buffer buf_tt-obj-list   for tt-obj-list.
     4150     define buffer buf_tt-report     for tt-report.
     4151     define buffer buf_tt-report-day for tt-report.
     4152     define buffer buf_tt-goods      for tt-goods.
     4153     define buffer buf_clients       for ub.clients.
     4154     define variable v-i               as integer   no-undo .
     4155     define variable v-line-1          as character no-undo .
     4156     define variable v-clmn-label-1    as character no-undo .
     4157     define variable v-clmn-label-2    as character no-undo .
     4158     define variable v-clmn-format     as character no-undo .
     4159     define variable v-clmn-sizes      as character no-undo .
     4160     define variable v-tmp-date        as date      no-undo .
     4161     define variable v-days-count      as integer   no-undo .
     4162     define variable v-list-num        as integer   no-undo .
     4163     define variable v-grp-start-line  as integer   no-undo .
     4164     define variable v-grp-end-line    as integer   no-undo .
     4165     define variable v-supp-start-line as integer   no-undo .
     4166     define variable v-supp-end-line   as integer   no-undo .
     4167     define variable v-grp-list        as character no-undo .
     4168     define variable v-gds-tot-count     as decimal   no-undo .
     4169     define variable v-gds-grp-count     as decimal   no-undo .
     4170     define variable v-gds-grp-tot-count as decimal   no-undo .
     4171     define variable v-gds-sup-count     as decimal   no-undo .
     4172     define variable v-gds-sup-tot-count as decimal   no-undo .
     4173     define variable v-gds-asm-count     as decimal   no-undo .
     4174     define variable v-gds-asm-tot-count as decimal   no-undo .
     4175     define variable v-gds-balance     as decimal   no-undo .
     4176     define variable v-gds-sale        as decimal   no-undo .
     4177     define variable v-gds-order       as decimal   no-undo .
     4178     define variable v-gds-tot-balance as decimal   no-undo .
     4179     define variable v-gds-tot-sale    as decimal   no-undo .
     4180     define variable v-gds-tot-order   as decimal   no-undo .
     4181     define variable v-grp-balance     as decimal   no-undo .
     4182     define variable v-grp-sale        as decimal   no-undo .
     4183     define variable v-grp-order       as decimal   no-undo .
     4184     define variable v-grp-tot-balance as decimal   no-undo .
     4185     define variable v-grp-tot-sale    as decimal   no-undo .
     4186     define variable v-grp-tot-order   as decimal   no-undo .
     4187     define variable v-sup-balance     as decimal   no-undo .
     4188     define variable v-sup-sale        as decimal   no-undo .
     4189     define variable v-sup-order       as decimal   no-undo .
     4190     define variable v-sup-tot-balance as decimal   no-undo .
     4191     define variable v-sup-tot-sale    as decimal   no-undo .
     4192     define variable v-sup-tot-order   as decimal   no-undo .
     4193     define variable v-asm-balance     as decimal   no-undo .
     4194     define variable v-asm-sale        as decimal   no-undo .
     4195     define variable v-asm-order       as decimal   no-undo .
     4196     define variable v-asm-tot-balance as decimal   no-undo .
     4197     define variable v-asm-tot-sale    as decimal   no-undo .
     4198     define variable v-asm-tot-order   as decimal   no-undo .
     4199     define variable v-gds-prc-balance as decimal   no-undo .
     4200     define variable v-gds-prc-sale    as decimal   no-undo .
     4201     define variable v-gds-prc-order   as decimal   no-undo .
     4202     define variable v-grp-prc-balance as decimal   no-undo .
     4203     define variable v-grp-prc-sale    as decimal   no-undo .
     4204     define variable v-grp-prc-order   as decimal   no-undo .
     4205     define variable v-sup-prc-balance as decimal   no-undo .
     4206     define variable v-sup-prc-sale    as decimal   no-undo .
     4207     define variable v-sup-prc-order   as decimal   no-undo .
     4208     define variable v-asm-prc-balance as decimal   no-undo .
     4209     define variable v-asm-prc-sale    as decimal   no-undo .
     4210     define variable v-asm-prc-order   as decimal   no-undo .
     4211   do
     4212   on error undo, return error return-value
     4213   :
     4214     assign
     4215       v-days-count = p-date-finish - p-date-start + 1
     4216     .
     4217     for each buf_tt-obj-list
     4218     :
     4219       run waitfram-show in this-procedure ( input substitute( "Расчет итогов по объекту &1 &2...":U
     4220                                                             , buf_tt-obj-list.obj-type
     4221                                                             , buf_tt-obj-list.obj-code
     4222                                                             )
     4223                                           ) .
     4224      if p-gds-by-am = yes
     4225       then do:
     4226         put stream OutStr-html unformatted
     4227           '<TR>'skip
     4228               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute("По АМ на &1 товаров":U , v-gds-tot-count )) + '</TD>' skip
     4229           '</TR>'skip
     4230       .
     4231       end.
     4232       if p-group-by-post = yes
     4233       then do:
     4234         put stream OutStr-html unformatted
     4235           '<TR>'skip
     4236               '<TD colspan="8" STYLE="font-size: 14px;">Группировка по поставщику</TD>' skip
     4237           '</TR>'skip
     4238       .
     4239       end.
     4240      put stream OutStr-html unformatted
     4241           '<TR>'skip
     4242               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute( "Критический остаток: &1" , p-critical-qnty-balance )) + '</TD>' skip
     4243           '</TR>'skip
     4244       .
     4245        put stream OutStr-html unformatted
     4246           '<TR>'skip
     4247               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute( "Критическая продажа: &1" , p-critical-qnty-sale    )) + '</TD>' skip
     4248           '</TR>'skip
     4249       .
     4250        put stream OutStr-html unformatted
     4251           '<TR>'skip
     4252               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute( "Критический заказ: &1"   , p-critical-qnty-order   )) + '</TD>' skip
     4253           '</TR>'skip
     4254       .
     4255        put stream OutStr-html unformatted
     4256           '<TR>'skip
     4257               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute( "Фильтры:"                                          )) + '</TD>' skip
     4258           '</TR>'skip
     4259       .
     4260        put stream OutStr-html unformatted
     4261           '<TR>'skip
     4262               '<TD colspan="8" STYLE="font-size: 14px;">' + string(substitute( "Дней без товара: &1"     , p-days-wt-goods         )) + '</TD>' skip
     4263           '</TR>'skip
     4264       .
     4265         put stream OutStr-html unformatted
     4266           '<TR>'skip
     4267               '<TD colspan="8" STYLE="font-size: 14px;">Показывать товары с ИЖТ:' + string(( if p-igt-all   = yes then 'все':U else
     4268         ( if p-igt-new   = yes then 'Новинка':U   + "," else "" ) +
     4269         ( if p-igt-com   = yes then 'Основная группа':U   + "," else "" ) +
     4270         ( if p-igt-spec  = yes then 'Нештатный':U  + "," else "" ) +
     4271         ( if p-igt-del   = yes then 'На вывод из ассортимента':U   + "," else "" ) +
     4272         ( if p-igt-empty = yes then 'Пусто':U       else "" ) )) + '</TD>' skip
     4273           '</TR>'skip
     4274           '</thead>'skip
     4275       .
     4276       assign
     4277         v-tmp-date      = p-date-start
     4278         v-i             = 3
     4279         v-list-num      = v-list-num + 1
     4280         v-clmn-label-1  = '':u
     4281         v-clmn-label-2  = '':u
     4282         v-clmn-format   = '':u
     4283         v-clmn-sizes    = '':u
     4284         v-line-1        = '':u
     4285       .
     4286      put stream OutStr-html unformatted
     4287           '<tbody>'
     4288           '<TR>'skip
