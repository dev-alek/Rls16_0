     3246                   and buf_tt-suppliers.obj-code  = buf_tt-goods.obj-code
     3247                   and buf_tt-suppliers.gds-code  = buf_tt-goods.gds-code
     3248                   and buf_tt-suppliers.supp-type = buf_ord-doc.cli-type
