     3196                 and buf_tt-goods.obj-code   = buf_tt-obj-list.obj-code
     3197                 and buf_tt-goods.artic      = buf_doc-line.artic
     3198                 and buf_tt-goods.prod-type  = buf_doc-line.prod-type
     3199                 and buf_tt-goods.prod-code  = buf_doc-line.prod-code
     3200           :
     3201             find first buf_tt-suppliers
