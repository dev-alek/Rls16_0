     3119     define buffer buf_stk-supp-line for ub.stk-supp-line.
     3120     define buffer buf_trn-doc       for ub.trn-doc.
     3121     define buffer buf_doc-line      for ub.doc-line.
     3122     define buffer buf_ord-doc       for ub.ord-doc.
     3123     define buffer buf_ord-line      for ub.ord-line.
     3124     define buffer buf_cli-gds       for ub.cli-gds.
     3125     define variable v-day-begin-factord as decimal   no-undo .
     3126     define variable v-day-end-factord   as decimal   no-undo .
     3127     define variable v-begin-factord     as decimal   no-undo .
     3128     define variable v-end-factord       as decimal   no-undo .
