     2492   define stream sout.
     2493   define variable v-date-start  as date      no-undo .
     2494   define variable v-date-finish as date      no-undo .
     2495   define variable v-file-name   as character no-undo .
     2496   define variable v-date-from   as date      no-undo .
     2497   define variable v-date-to     as date      no-undo .
     2498   define variable v-archive-ok  as logical   no-undo .
     2499   define variable v-comment     as character no-undo .
     2500   define variable v-can-print   as logical   no-undo .
     2501   define stream Out-Stream.
     2502   define stream OutStr-html.
     2503   define VARIABLE p-report-id              as character               no-undo .
     2504   define variable v-file-name-rep-htm as character no-undo .
     2505   do
     2506   on error undo, return error return-value
     2507   :
     2508     run get-report-num in parparentproc (output p-report-id).
     2509   output stream sout to value( string( session:temp-directory +
     2510                                        "rpt" + string( g#report-num ) ) )
     2511                                        page-size  value(62) .
     2512    v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     2513    if p-is-schedule = yes
     2514     then do:
     2515       assign
     2516         my-handle   = parparentproc
     2517         ReportName  = "Контроль ассортиментной матрицы":U
     2518       .
     2519     end.
     2520     assign
     2521       v-date-start  = p-Date-Start
     2522       v-date-finish = p-Date-finish
     2523       v-file-name   = string(session :temp-directory) + "rpt" + string( g#report-num ) + '.txt'
     2524       v-date-from   = v-date-start
     2525       v-date-to     = v-date-finish
     2526     .
     2527       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     2528       put stream OutStr-html unformatted
     2529                "<!DOCTYPE HTML>" skip
     2530                   ' <html>' skip
     2531                   '  <head>' skip
     2532                   '   <meta charset="utf-8">' skip
     2533                   '    <style type="text/css">' skip
     2534                   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2535                   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2536                   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
     2537                   '   </style>' skip
     2538                   '  </head>' skip
     2539               .
     2540       put stream OutStr-html unformatted
     2541           '<body>' skip
     2542           '<TABLE name="1"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     2543           '<thead>' skip
     2544           .
     2545       put stream OutStr-html unformatted
     2546           '<TR>'skip
     2547               '<TD colspan="11" STYLE="font-size: 14px;">' + string(ReportNAme) + '</TD>' skip
     2548           '</TR>'skip
     2549           '<TR>'skip
     2550               '<TD colspan="11" STYLE="font-size: 14px;">За период с' + string(v-date-start,"99.99.9999") + ' по ' + string(v-date-finish,"99.99.9999") + '</TD>' skip
     2551           '</TR>'skip
     2552       .
     2553     run empty-tt in this-procedure .
     2554     run fill-tt in this-procedure .
     2555     run print-report in this-procedure .
     2556     run empty-tt in this-procedure .
     2557     define variable v-user-action   as character no-undo .
     2558     define variable v-printed       as logical   no-undo .
     2559     define variable DisabledOptions as integer   no-undo .
     2560     define variable v-orient-page as character no-undo .
     2561      put stream OutStr-html unformatted
     2562                                   '</tbody>' skip
     2563                                   '</table>' skip
     2564                                   '</body>' skip
     2565                                   '</html>' skip
     2566                                   .
     2567     run prn-lib-reportviewer-report-name in this-procedure (
     2568                                                             input parParentProc
     2569                                                             ,input v-file-name-rep-htm
     2570                                                             ).
     2571   end.
     2572   procedure empty-tt :
     2573     define buffer buf_tt-obj-list     for tt-obj-list.
     2574     define buffer buf_tt-goods        for tt-goods.
     2575     define buffer buf_tt-report       for tt-report.
     2576     define buffer buf_tt-filtred-gds  for tt-filtred-gds.
     2577     define buffer buf_tt-suppliers    for tt-suppliers.
     2578   do
     2579   on error undo, return error return-value
     2580   :
     2581     empty temp-table buf_tt-obj-list    .
     2582     empty temp-table buf_tt-goods       .
     2583     empty temp-table buf_tt-report      .
     2584     empty temp-table buf_tt-filtred-gds .
     2585     empty temp-table buf_tt-suppliers   .
     2586   end.
     2587   end procedure.
     2588   procedure fill-tt :
     2589   do
     2590   on error undo, return error return-value
     2591   :
     2592     run fill-tt-obj in this-procedure .
     2593     run fill-tt-gds in this-procedure .
     2594     run fill-tt-report in this-procedure .
     2595   end.
     2596   end procedure.
     2597   procedure fill-tt-obj :
     2598     define buffer buf_clients           for ub.clients.
     2599     define buffer buf_tt-obj-list       for tt-obj-list.
     2600     define buffer buf_assortment-matrix for ub.assortment-matrix.
     2601   do
     2602   on error undo, return error return-value
     2603   :
     2604     empty temp-table buf_tt-obj-list.
     2605     if valid-handle(p-call-handle)
     2606     and lookup( "cb_get-objects", p-call-handle:internal-entries ) > 0
     2607     then do:
     2608       run cb_get-objects in p-call-handle ( input this-procedure:handle).
     2609     end.
     2610     for each obj-list
     2611     :
     2612       if p-is-schedule = yes
     2613       then do:
     2614         run rep/chk-ahz.p (
     2615               input        obj-list.obj-type
     2616             , input        obj-list.obj-code
     2617             , input        yes
     2618             , input        yes
     2619             , input        yes
     2620             , input        no
     2621             , input        no
     2622             , input        0
     2623             , input        "":U
     2624             , input-output v-date-from
     2625             , input-output v-date-to
     2626             , output       v-archive-ok
     2627             , output       v-comment
     2628             , output       v-can-print
     2629         ) no-error .
     2630         if error-status :error
     2631         then do:
     2632             undo, return error substitute( "Ошибка при вызове программы rep/chk-ahz.p. &1. &2. &3"
     2633                 , return-value
     2634                 , trim(error-status :get-message(1))
     2635                 , trim(error-status :get-message(2))
     2636             ) .
     2637         end.
     2638         if v-date-from <> v-date-start
     2639         or v-date-to   <> v-date-finish
     2640         or v-archive-ok = no
     2641         then do:
     2642           assign
     2643             v-comment    = substitute( "Выгрузка не может быть произведена. &1", v-comment )
     2644           .
     2645           undo, return .
     2646         end.
     2647       end.
     2648       find first buf_clients no-lock
     2649         where buf_clients.obj-type = obj-list.obj-type
     2650           and buf_clients.obj-code = obj-list.obj-code
     2651       no-error .
     2652       if available buf_clients
     2653       then do:
     2654         find first buf_tt-obj-list
     2655           where buf_tt-obj-list.obj-type = obj-list.obj-type
     2656             and buf_tt-obj-list.obj-code = obj-list.obj-code
     2657         no-error .
     2658         if not available buf_tt-obj-list
     2659         then do:
     2660           find first buf_assortment-matrix no-lock
     2661             where buf_assortment-matrix.obj-type    = obj-list.obj-type
     2662               and buf_assortment-matrix.obj-code    = obj-list.obj-code
     2663               and buf_assortment-matrix.asmt-status = integer ('0':U)
     2664           no-error .
     2665           create buf_tt-obj-list.
     2666           buffer-copy buf_clients to buf_tt-obj-list
     2667           assign
     2668             buf_tt-obj-list.is-have-assortment-matrix = available buf_assortment-matrix
     2669           .
     2670         end.
     2671       end.
     2672     end.
     2673   end.
     2674   end procedure.
     2675   procedure fill-tt-gds :
     2676     define buffer buf_goods                   for ub.goods.
     2677     define buffer buf_assortment-matrix       for ub.assortment-matrix.
     2678     define buffer buf_assortment-matrix-goods for ub.assortment-matrix-goods.
     2679     define buffer buf_gds-obj                 for ub.gds-obj.
     2680     define buffer buf_gds-obj-prop            for ub.gds-obj-prop.
     2681     define buffer buf_tt-obj-list for tt-obj-list.
     2682     define buffer buf_tt-goods    for tt-goods.
     2683     define variable v-curr-grp-name               as character no-undo .
     2684     define variable v-return-AssMin               as logical   no-undo .
     2685     define variable v-return-igt                  as character no-undo .
     2686     define variable v-gdop-min-stock              as decimal   no-undo .
     2687     define variable v-grop-max-stock              as decimal   no-undo .
     2688     define variable v-grop-level-always-presence  as decimal   no-undo .
     2689     define variable v-grop-min-order              as decimal   no-undo .
     2690   do
     2691   on error undo, return error return-value
     2692   :
     2693     empty temp-table buf_tt-goods.
     2694     if p-gds-by-am = yes
     2695     then do:
     2696       for each buf_tt-obj-list
     2697         where buf_tt-obj-list.is-have-assortment-matrix = yes
     2698       :
     2699         run waitfram-show in this-procedure ( input substitute( "Построение списка товаров по объекту &1 &2"
     2700                                                               , buf_tt-obj-list.obj-type
     2701                                                               , buf_tt-obj-list.obj-code
     2702                                                               )
     2703                                             ) .
     2704         find first buf_assortment-matrix no-lock
     2705           where buf_assortment-matrix.obj-type    = buf_tt-obj-list.obj-type
     2706             and buf_assortment-matrix.obj-code    = buf_tt-obj-list.obj-code
     2707             and buf_assortment-matrix.asmt-status = integer ('0':U)
     2708         no-error .
     2709         if available buf_assortment-matrix
     2710         then do:
     2711           for each buf_assortment-matrix-goods no-lock
     2712             where buf_assortment-matrix-goods.asmt-id     = buf_assortment-matrix.asmt-id
     2713               and buf_assortment-matrix-goods.db-num      = buf_assortment-matrix.db-num
     2714               and buf_assortment-matrix-goods.asmg-status = integer ('0':U)
     2715           :
     2716             find first buf_gds-obj-prop
     2717                  where buf_gds-obj-prop.gds-code = buf_assortment-matrix-goods.gds-code
     2718                    and buf_gds-obj-prop.obj-type = buf_tt-obj-list.obj-type
     2719                    and buf_gds-obj-prop.obj-code = buf_tt-obj-list.obj-code
     2720                    no-error.
     2721             if available buf_gds-obj-prop then do :
     2722                 if p-igt-all   = yes or
     2723                    p-igt-new   = yes and (buf_gds-obj-prop.gdop-igt = 'Новинка':U)   or
     2724                    p-igt-com   = yes and (buf_gds-obj-prop.gdop-igt = 'Основная группа':U)   or
     2725                    p-igt-spec  = yes and (buf_gds-obj-prop.gdop-igt = 'Нештатный':U)  or
     2726                    p-igt-del   = yes and (buf_gds-obj-prop.gdop-igt = 'На вывод из ассортимента':U)   or
     2727                    p-igt-empty = yes and (buf_gds-obj-prop.gdop-igt = 'Пусто':U)
     2728                 then do:
     2729                     find first buf_goods no-lock
     2730                       where buf_goods.gds-code = buf_assortment-matrix-goods.gds-code
     2731                     no-error .
     2732                     if available buf_goods
     2733                     then do:
     2734                       find first buf_tt-goods
     2735                         where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2736                           and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2737                           and buf_tt-goods.gds-code = buf_goods.gds-code
     2738                       no-error .
     2739                       if not available buf_tt-goods
     2740                       then do:
     2741                         create buf_tt-goods.
     2742                         buffer-copy buf_goods to buf_tt-goods
     2743                         assign
     2744                           buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2745                           buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2746                         .
     2747                       end.
     2748                     end.
     2749                 end.
     2750             end.
     2751           end.
     2752         end.
     2753         else do:
     2754           for each buf_gds-obj no-lock
     2755             where buf_gds-obj.obj-type = buf_tt-obj-list.obj-type
     2756               and buf_gds-obj.obj-code = buf_tt-obj-list.obj-code
     2757           , first buf_goods no-lock
     2758               where buf_goods.artic     = buf_gds-obj.artic
     2759                 and buf_goods.prod-type = buf_gds-obj.prod-type
     2760                 and buf_goods.prod-code = buf_gds-obj.prod-code
     2761           :
     2762             find first buf_tt-goods
     2763               where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2764                 and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2765                 and buf_tt-goods.gds-code = buf_goods.gds-code
     2766             no-error .
     2767             if not available buf_tt-goods
     2768             then do:
     2769               create buf_tt-goods.
     2770               buffer-copy buf_goods to buf_tt-goods
     2771               assign
     2772                 buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2773                 buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2774               .
     2775             end.
     2776           end.
     2777         end.
     2778       end.
     2779       find first buf_tt-obj-list
     2780         where buf_tt-obj-list.is-have-assortment-matrix = no
     2781       no-error .
     2782       if available buf_tt-obj-list
     2783       then do:
     2784         run waitfram-show in this-procedure ( input "Построение списка товаров по объектам не имеющим АМ...":U ) .
     2785         for each buf_gds-obj no-lock
     2786           where buf_gds-obj.obj-type = buf_tt-obj-list.obj-type
     2787             and buf_gds-obj.obj-code = buf_tt-obj-list.obj-code
     2788         , first buf_goods no-lock
     2789             where buf_goods.artic     = buf_gds-obj.artic
     2790               and buf_goods.prod-type = buf_gds-obj.prod-type
     2791               and buf_goods.prod-code = buf_gds-obj.prod-code
     2792         :
     2793           for each buf_tt-obj-list
     2794               where buf_tt-obj-list.is-have-assortment-matrix = no
     2795           :
     2796             find first buf_tt-goods
     2797               where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2798                 and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2799                 and buf_tt-goods.gds-code = buf_goods.gds-code
     2800             no-error .
     2801             if not available buf_tt-goods
     2802             then do:
     2803               create buf_tt-goods.
     2804               buffer-copy buf_goods to buf_tt-goods
     2805               assign
     2806                 buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2807                 buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2808               .
     2809             end.
     2810           end.
     2811         end.
     2812       end.
     2813     end.
     2814     else do:
     2815       run waitfram-show in this-procedure ( input "Построение списков товаров по объектам...":u ) .
     2816       case x-SelectGood
     2817       :
     2818         when 1
     2819         then do:
     2820           for each buf_tt-obj-list
     2821           , each buf_gds-obj no-lock
     2822               where buf_gds-obj.obj-type  = buf_tt-obj-list.obj-type
     2823                 and buf_gds-obj.obj-code  = buf_tt-obj-list.obj-code
     2824           , first buf_goods no-lock
     2825               where buf_goods.gds-code = buf_gds-obj.gds-code
     2826           :
     2827             find first buf_tt-goods
     2828               where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2829                 and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2830                 and buf_tt-goods.gds-code = buf_goods.gds-code
     2831             no-error .
     2832             if not available buf_tt-goods
     2833             then do:
     2834               create buf_tt-goods.
     2835               buffer-copy buf_goods to buf_tt-goods
     2836               assign
     2837                 buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2838                 buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2839               .
     2840             end.
     2841           end.
     2842         end.
     2843         when 2
     2844         then do:
     2845           for each tmp#grp no-lock
     2846           :
     2847             run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     2848             for each buf_goods no-lock
     2849               where buf_goods.grp-name begins v-curr-grp-name
     2850             :
     2851               for each buf_tt-obj-list
     2852               , first buf_gds-obj no-lock
     2853                   where buf_gds-obj.obj-type  = buf_tt-obj-list.obj-type
     2854                     and buf_gds-obj.obj-code  = buf_tt-obj-list.obj-code
     2855                     and buf_gds-obj.artic     = buf_goods.artic
     2856                     and buf_gds-obj.prod-type = buf_goods.prod-type
     2857                     and buf_gds-obj.prod-code = buf_goods.prod-code
     2858               :
     2859                 find first buf_tt-goods
     2860                   where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2861                     and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2862                     and buf_tt-goods.gds-code = buf_goods.gds-code
     2863                 no-error .
     2864                 if not available buf_tt-goods
     2865                 then do:
     2866                   create buf_tt-goods.
     2867                   buffer-copy buf_goods to buf_tt-goods
     2868                   assign
     2869                     buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2870                     buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2871                   .
     2872                 end.
     2873               end.
     2874             end.
     2875           end.
     2876         end.
     2877         when 3
     2878         then do:
     2879           for each g#cli
     2880           :
     2881             for each buf_goods no-lock
     2882               where buf_goods.prod-type = g#cli.obj-type
     2883                 and buf_goods.prod-code = g#cli.obj-code
     2884             :
     2885               for each buf_tt-obj-list
     2886               , first buf_gds-obj no-lock
     2887                   where buf_gds-obj.obj-type  = buf_tt-obj-list.obj-type
     2888                     and buf_gds-obj.obj-code  = buf_tt-obj-list.obj-code
     2889                     and buf_gds-obj.artic     = buf_goods.artic
     2890                     and buf_gds-obj.prod-type = buf_goods.prod-type
     2891                     and buf_gds-obj.prod-code = buf_goods.prod-code
     2892               :
     2893                 find first buf_tt-goods
     2894                   where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2895                     and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2896                     and buf_tt-goods.gds-code = buf_goods.gds-code
     2897                 no-error .
     2898                 if not available buf_tt-goods
     2899                 then do:
     2900                   create buf_tt-goods.
     2901                   buffer-copy buf_goods to buf_tt-goods
     2902                   assign
     2903                     buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2904                     buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2905                   .
     2906                 end.
     2907               end.
     2908             end.
     2909           end.
     2910         end.
     2911         when 4 or
     2912         when 5 or
     2913         when 7
     2914         then do:
     2915           for each gds-list
     2916           :
     2917             for each buf_tt-obj-list
     2918             , first buf_gds-obj no-lock
     2919                 where buf_gds-obj.obj-type  = buf_tt-obj-list.obj-type
     2920                   and buf_gds-obj.obj-code  = buf_tt-obj-list.obj-code
     2921                   and buf_gds-obj.artic     = gds-list.artic
     2922                   and buf_gds-obj.prod-type = gds-list.prod-type
     2923                   and buf_gds-obj.prod-code = gds-list.prod-code
     2924             , first buf_goods no-lock
     2925                 where buf_goods.gds-code = buf_gds-obj.gds-code
     2926             :
     2927               find first buf_tt-goods
     2928                 where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2929                   and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2930                   and buf_tt-goods.gds-code = buf_goods.gds-code
     2931               no-error .
     2932               if not available buf_tt-goods
     2933               then do:
     2934                 create buf_tt-goods.
     2935                 buffer-copy buf_goods to buf_tt-goods
     2936                 assign
     2937                   buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2938                   buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2939                 .
     2940               end.
     2941             end.
     2942           end.
     2943         end.
     2944       end case.
     2945     end.
     2946     run waitfram-hide in this-procedure .
     2947     for each buf_tt-obj-list
     2948     :
     2949       find first buf_tt-goods
     2950         where buf_tt-goods.obj-type = buf_tt-obj-list.obj-type
     2951           and buf_tt-goods.obj-code = buf_tt-obj-list.obj-code
     2952       no-error .
     2953       if not available buf_tt-goods
     2954       then do:
     2955         run proc-message in this-procedure ( input substitute( "Список товаров по объекту &1 &2 пуст. Объект исключен."
     2956                                                              , buf_tt-obj-list.obj-type
     2957                                                              , buf_tt-obj-list.obj-code
     2958                                                              )
     2959                                            ) .
     2960         delete buf_tt-obj-list.
     2961       end.
     2962     end.
     2963     find first buf_tt-goods no-error .
     2964     if not available buf_tt-goods
     2965     then do:
     2966       run proc-message in this-procedure ( input "Список товаров по объектам пуст. Отчет не может быть составлен." ) .
     2967       return .
     2968     end.
     2969   end.
     2970   end procedure.
     2971   procedure fill-tt-report-no-supp :
     2972     define buffer buf_ot-line     for ub.ot-line.
     2973     define buffer buf_ord-doc     for ub.ord-doc.
     2974     define buffer buf_ord-line    for ub.ord-line.
     2975     define buffer buf_tt-obj-list for tt-obj-list.
     2976     define buffer buf_tt-goods    for tt-goods.
     2977     define buffer buf_tt-report   for tt-report.
     2978     define variable v-day-begin-factord as decimal   no-undo .
     2979     define variable v-day-end-factord   as decimal   no-undo .
     2980     define variable v-quantity          as decimal   no-undo .
     2981     define variable v-coast_r           as decimal   no-undo .
     2982     define variable v-coast_v           as decimal   no-undo .
     2983     define variable v-vat_r             as decimal   no-undo .
     2984     define variable v-vat_v             as decimal   no-undo .
     2985     define variable v-slt_r             as decimal   no-undo .
     2986     define variable v-slt_v             as decimal   no-undo .
     2987     define variable v-sale              as decimal   no-undo .
     2988     define variable v-order             as decimal   no-undo .
     2989     define variable v-tmp-date          as date      no-undo .
     2990   do
     2991   on error undo, return error return-value
     2992   :
     2993     for each buf_tt-report
     2994       break by buf_tt-report.r-date
     2995             by buf_tt-report.obj-type
     2996             by buf_tt-report.obj-code
     2997     :
     2998       if first-of(buf_tt-report.r-date)
     2999       then do:
     3000         run day-begin-fact-order  in this-procedure ( input buf_tt-report.r-date
     3001                                                     , output v-day-begin-factord
     3002                                                     ) .
     3003         run factord-end-day in this-procedure ( input buf_tt-report.r-date
     3004                                               , output v-day-end-factord
     3005                                               ) .
     3006       end.
     3007       if first-of(buf_tt-report.r-date) or first-of(buf_tt-report.obj-type) or first-of(buf_tt-report.obj-code)
     3008       then do:
     3009         run waitfram-show in this-procedure ( input substitute( "Расчет остатков и продаж на дату &1 для &2 &3..."
     3010                                                               , string(buf_tt-report.r-date ,  "99/99/9999")
     3011                                                               , buf_tt-report.obj-type
     3012                                                               , buf_tt-report.obj-code
     3013                                                               )
     3014                                             ) .
     3015       end.
     3016       run ost-line in this-procedure ( input  buf_tt-report.obj-code
     3017                                      , input  buf_tt-report.obj-type
     3018                                      , input  buf_tt-report.artic
     3019                                      , input  buf_tt-report.prod-code
     3020                                      , input  buf_tt-report.prod-type
     3021                                      , input  no
     3022                                      , input  v-day-end-factord
     3023                                      , input  'cost':U
     3024                                      , input  '##,##':U
     3025                                      , input  yes
     3026                                      , output v-quantity
     3027                                      , output v-coast_r
     3028                                      , output v-coast_v
     3029                                      , output v-vat_r
     3030                                      , output v-vat_v
     3031                                      , output v-slt_r
     3032                                      , output v-slt_v
     3033                                      ) .
     3034       _ot-line:
     3035       for each buf_ot-line no-lock
     3036           where buf_ot-line.obj-type     = buf_tt-report.obj-type
     3037             and buf_ot-line.obj-code     = buf_tt-report.obj-code
     3038             and buf_ot-line.artic        = buf_tt-report.artic
     3039             and buf_ot-line.prod-type    = buf_tt-report.prod-type
     3040             and buf_ot-line.prod-code    = buf_tt-report.prod-code
     3041             and buf_ot-line.fact-order  >= v-day-begin-factord
     3042             and buf_ot-line.fact-order  <= v-day-end-factord
     3043             and buf_ot-line.sum-type     = 'cost':U
     3044       :
     3045         if buf_ot-line.ext-doc-type = 'es':U
     3046         then do:
     3047           assign
     3048             v-sale = v-sale + abs(buf_ot-line.fact-qnty)
     3049           .
     3050         end.
     3051       end.
     3052       assign
     3053         buf_tt-report.balance = v-quantity
     3054         buf_tt-report.sale    = v-sale
     3055         v-sale                = 0
     3056       .
     3057     end.
     3058     for each buf_tt-obj-list
     3059     :
     3060       assign
     3061         v-tmp-date = p-date-start
     3062       .
     3063       do while v-tmp-date <= p-date-finish
     3064       :
     3065         run waitfram-show in this-procedure ( input substitute( "Расчет заказов на дату &1 для &2 &3..."
     3066                                                               , string(v-tmp-date ,  "99/99/9999")
     3067                                                               , buf_tt-obj-list.obj-type
     3068                                                               , buf_tt-obj-list.obj-code
     3069                                                               )
     3070                                             ) .
     3071         for each buf_ord-doc no-lock
     3072           where buf_ord-doc.obj-type = buf_tt-obj-list.obj-type
     3073             and buf_ord-doc.obj-code = buf_tt-obj-list.obj-code
     3074             and buf_ord-doc.doc-date = v-tmp-date
     3075         :
     3076           if buf_ord-doc.status_ = 'поставка':U or
     3077              buf_ord-doc.status_ = 'факт':U
     3078           then do:
     3079             for each buf_ord-line no-lock
     3080               where buf_ord-line.doc-code   = buf_ord-doc.doc-code
     3081             , first buf_tt-goods
     3082                 where buf_tt-goods.obj-type   = buf_tt-obj-list.obj-type
     3083                   and buf_tt-goods.obj-code   = buf_tt-obj-list.obj-code
     3084                   and buf_tt-goods.artic      = buf_ord-line.artic
     3085                   and buf_tt-goods.prod-type  = buf_ord-line.prod-type
     3086                   and buf_tt-goods.prod-code  = buf_ord-line.prod-code
     3087             :
     3088               find first buf_tt-report no-lock
     3089                 where buf_tt-report.obj-type  = buf_tt-obj-list.obj-type
     3090                   and buf_tt-report.obj-code  = buf_tt-obj-list.obj-code
     3091                   and buf_tt-report.r-date    = v-tmp-date
     3092                   and buf_tt-report.gds-code  = buf_tt-goods.gds-code
     3093               no-error .
     3094               if available buf_tt-report
     3095               then do:
     3096                 assign
     3097                   buf_tt-report.order = buf_tt-report.order + buf_ord-line.qnty
     3098                 .
     3099               end.
     3100             end.
     3101           end.
     3102         end.
     3103         assign
     3104           v-tmp-date = v-tmp-date + 1
     3105         .
     3106       end.
     3107     end.
     3108     run waitfram-hide in this-procedure .
     3109   end.
     3110   end procedure.
     3111   procedure fill-tt-report-supp :
     3112     define buffer buf_tt-obj-list   for tt-obj-list.
     3113     define buffer buf_tt-goods      for tt-goods.
     3114     define buffer buf_tt-report     for tt-report.
     3115     define buffer buf_tt-suppliers  for tt-suppliers.
     3116     define buffer buf_goods         for ub.goods.
     3117     define buffer buf_parts         for ub.parts.
