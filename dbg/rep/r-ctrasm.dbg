     3154             and buf_stk-supp-line.prod-code   = buf_tt-goods.prod-code
     3155             and buf_stk-supp-line.artic       = buf_tt-goods.artic
     3156             and buf_stk-supp-line.obj-type    = buf_tt-goods.obj-type
     3157             and buf_stk-supp-line.obj-code    = buf_tt-goods.obj-code
     3158             and buf_stk-supp-line.fact-order >= v-begin-factord
     3159             and buf_stk-supp-line.fact-order <= v-end-factord
     3160             and buf_stk-supp-line.sum-type    = 'cost':U
     3161             and buf_stk-supp-line.cat-id      = '##':U
     3162         :
     3163           find first buf_tt-suppliers
     3164             where buf_tt-suppliers.obj-type  = buf_stk-supp-line.obj-type
     3165               and buf_tt-suppliers.obj-code  = buf_stk-supp-line.obj-code
     3166               and buf_tt-suppliers.gds-code  = buf_tt-goods.gds-code
     3167               and buf_tt-suppliers.supp-type = buf_stk-supp-line.cli-type
     3168               and buf_tt-suppliers.supp-code = buf_stk-supp-line.cli-code
     3169           no-error .
     3170           if not available buf_tt-suppliers
     3171           then do:
     3172             create buf_tt-suppliers.
     3173             assign
     3174               buf_tt-suppliers.obj-type  = buf_stk-supp-line.obj-type
     3175               buf_tt-suppliers.obj-code  = buf_stk-supp-line.obj-code
     3176               buf_tt-suppliers.gds-code  = buf_tt-goods.gds-code
     3177               buf_tt-suppliers.supp-type = buf_stk-supp-line.cli-type
     3178               buf_tt-suppliers.supp-code = buf_stk-supp-line.cli-code
     3179             .
     3180           end.
     3181         end.
     3182       end.
