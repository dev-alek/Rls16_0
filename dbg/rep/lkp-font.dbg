      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define temp-table temp-font no-undo
      570     field fontnum  as integer
      571     field fontname as character
      572     field fontsize as character
      573     field fonttype as character
      574     field font-h   as integer
      575     field font-w   as integer
      576     field v-row    as integer
      577     field v-col    as integer
      578     field v-row-lans as integer
      579     field v-col-lans as integer
      580   index pi fontnum
      581   .
      582   procedure get-font-ini :
      583     do
      584     on error undo, return error return-value
      585     :
      586   define variable ii as integer   no-undo .
      587   define variable v-font7 as character no-undo .
      588   define variable v-font as character no-undo .
      589   define variable loc-name as character no-undo .
      590   define variable loc-size as character no-undo .
      591   define variable loc-type as character no-undo .
      592   define variable old_H as integer   no-undo .
      593   define variable old_w as integer   no-undo .
      594   define variable old-row  as integer   no-undo .
      595   define variable old-col  as integer   no-undo .
      596   define variable old-row-lans  as integer   no-undo .
      597   define variable old-col-lans  as integer   no-undo .
      598   define variable vv as integer   no-undo .
      599   empty temp-table temp-font.
      600     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
      601       case num-entries (v-font7) :
      602         when 4 then do:
      603             assign
      604               loc-name = entry ( 1 , v-font7 )
      605               loc-size = entry ( 2 , v-font7 )
      606               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
      607             .
      608         end.
      609         when 3 then do:
      610             assign
      611               loc-name = entry ( 1 , v-font7 )
      612               loc-size = entry ( 2 , v-font7 )
      613               loc-type = entry ( 3 , v-font7 )
      614             .
      615         end.
      616         when 2 then  do:
      617             assign
      618               loc-name = entry ( 1 , v-font7 )
      619               loc-size = entry ( 2 , v-font7 )
      620               loc-type = ""
      621             .
      622         end.
      623         when 1 then do:
      624             assign
      625               loc-name = trim(entry ( 1 , v-font7 ))
      626               loc-size = ""
      627               loc-type = ""
      628             .
      629         end.
      630       end case.
      631     create temp-font.
      632     assign
      633       temp-font.fontnum  = 7
      634       temp-font.fontname = trim(loc-name)
      635       temp-font.fontsize = trim(loc-size)
      636       temp-font.fonttype = trim(loc-type)
      637       temp-font.v-row    = 62
      638       temp-font.v-col    = 136
      639       temp-font.v-row-lans = 43
      640       temp-font.v-col-lans = 198
      641     .
      642     repeat ii = 16 to 100 :
      643       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
      644       if v-font = "" or v-font = ? then leave.
      645       case num-entries (v-font) :
      646         when 4 then do:
      647             assign
      648               loc-name = entry ( 1 , v-font )
      649               loc-size = entry ( 2 , v-font )
      650               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
      651             .
      652         end.
      653         when 3 then do:
      654             assign
      655               loc-name = entry ( 1 , v-font )
      656               loc-size = entry ( 2 , v-font )
      657               loc-type = entry ( 3 , v-font )
      658             .
      659         end.
      660         when 2 then do:
      661             assign
      662               loc-name = entry ( 1 , v-font )
      663               loc-size = entry ( 2 , v-font )
      664               loc-type = ""
      665             .
      666         end.
      667         when 1 then do:
      668             assign
      669               loc-name = trim(entry ( 1 , v-font ))
      670               loc-size = ""
      671               loc-type = ""
      672             .
      673         end.
      674       end case.
      675     create temp-font.
      676     assign
      677       temp-font.fontnum  = ii
      678       temp-font.fontname = trim(loc-name)
      679       temp-font.fontsize = trim(loc-size)
      680       temp-font.fonttype = trim(loc-type)
      681     .
      682     end.
      683       for each temp-font :
      684          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
      685          if  vv = ? then vv =  0 .
      686           run rep/exfont.p (
      687             input   temp-font.fontname ,
      688             input   vv ,
      689             input   temp-font.fonttype ,
      690             output  temp-font.font-h   ,
      691             output  temp-font.font-w   )
      692           .
      693       end.
      694   find first temp-font where  temp-font.fontnum  = 7  .
      695   old_H = temp-font.font-H .
      696   old_w = temp-font.font-W .
      697   old-row = temp-font.v-row .
      698   old-col = temp-font.v-col .
      699   old-row-lans = temp-font.v-row-lans .
      700   old-col-lans = temp-font.v-col-lans .
      701       for each temp-font where
      702                temp-font.fontnum  <> 7 :
      703           assign
      704               temp-font.v-row    = old_H * old-row / temp-font.font-h
      705               temp-font.v-col    = old_W * old-col / temp-font.font-W
      706               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
      707               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
      708           .
      709       end.
      710     end.
      711   end procedure.
      712   PROCEDURE How-name :
      713   define input  parameter h as integer no-undo .
      714   define input  parameter w as integer no-undo .
      715   define output parameter n as character  no-undo .
      716   define variable A4port-H as integer   no-undo init 63.
      717   define variable A4port-W as integer   no-undo init 136.
      718   define variable A4lans-H as integer   no-undo init 43.
      719   define variable A4lans-W as integer   no-undo init 198.
      720   define variable Strim-W  as integer   no-undo init 278.
      721   run define-a4-size (
      722        input ReportFontNum
      723       ,output A4port-H
      724       ,output A4port-W
      725       ,output A4lans-H
      726       ,output A4lans-W ).
      727   If w >= 1 and w <= A4port-W Then DO:
      728     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
      729     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
      730     If h > A4port-H              Then n = "to-file":U.
      731   End.
      732   If w > A4port-W and w <= A4lans-W Then DO:
      733     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
      734     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
      735     If h > A4port-H              Then n = "to-file":U.
      736   End.
      737   If w > A4lans-W and w <= Strim-W Then DO:
      738     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
      739     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
      740     If h > A4port-H              Then n = "to-file":U.
      741   End.
      742   If w > Strim-W Then DO:
      743      n = "to-file":U.
      744   End.
      745   END PROCEDURE.
      746   PROCEDURE define-a4-size :
      747   define input  parameter p-ReportFontNum as integer   no-undo .
      748   define output parameter A4port-H as integer   no-undo .
      749   define output parameter A4port-W as integer   no-undo .
      750   define output parameter A4lans-H as integer   no-undo .
      751   define output parameter A4lans-W as integer   no-undo .
      752   if not can-find (first temp-font ) then do:
      753      run get-font-ini .
      754   end.
      755   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
      756   if available temp-font then do:
      757   assign
      758     A4port-H = temp-font.v-row
      759     A4port-W = temp-font.v-col
      760     A4lans-H = temp-font.v-row-lans
      761     A4lans-W = temp-font.v-col-lans
      762   .
      763   end.
      764   else do:
      765   assign
      766     A4port-H = 63
      767     A4port-W = 136
      768     A4lans-H = 43
      769     A4lans-W = 198
      770   .
      771   end.
      772   END PROCEDURE.
      773   procedure proc-alt-shift-f2:
      774     if not ibs.th.gbl.gbl-var:rcode
      775   then
      776     run gbl\inidebug.p .
      777   end.
      778   procedure proc-alt-shift-f3:
      779     run gbl/prvssinf.p
      780       ( input this-procedure
      781       ) .
      782   end.
      783   define variable v-inform-launched as logical no-undo initial false .
      784   procedure proc-alt-shift-f4:
      785     define variable v-action as character no-undo .
      786     if v-inform-launched = false then do:
      787       assign
      788         v-inform-launched = true
      789       .
      790       run gbl/d-inform.w
      791         (  input self
      792         ,  input this-procedure
      793         , output v-action
      794         ) no-error .
      795       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      796       assign
      797         v-inform-launched = false
      798       .
      799     end.
      800   end.
      801   procedure proc-alt-f1:
      802     run gbl/corrhelp.p
      803       (input this-procedure
      804       ) .
      805   end .
      806   on alt-shift-f2 anywhere do:
      807     run proc-alt-shift-f2.
      808   end.
      809   on alt-shift-f3 anywhere do:
      810     run proc-alt-shift-f3 in this-procedure .
      811   end.
      812   on alt-shift-f4 anywhere do:
      813     run proc-alt-shift-f4 in this-procedure.
      814   end.
      815   on alt-f1 anywhere do:
      816     run proc-alt-f1 in this-procedure .
      817   end.
      818   define output parameter p-fontnum  as integer   no-undo .
      819   define output parameter p-fontname as character no-undo .
      820   define output parameter p-fontsize as character no-undo .
      821   define output parameter p-fonttype as character no-undo .
      822   define output parameter p-col      as integer   no-undo .
      823   define output parameter p-row      as integer   no-undo .
      824   define output parameter p-col-lans      as integer   no-undo .
      825   define output parameter p-row-lans      as integer   no-undo .
      826   DEFINE BUTTON B-Cancel AUTO-END-KEY
      827        LABEL "Выход"
      828        SIZE 10 BY 1
      829        BGCOLOR 8 .
      830   DEFINE BUTTON B-Help
      831        LABEL "Помощь"
      832        SIZE 10 BY 1
      833        BGCOLOR 8 .
      834   DEFINE BUTTON B-sel AUTO-GO
      835        LABEL "Выбор"
      836        SIZE 10 BY 1
      837        BGCOLOR 8 .
      838   DEFINE QUERY BROWSE-1 FOR
      839         temp-font SCROLLING.
      840   DEFINE BROWSE BROWSE-1
      841     QUERY BROWSE-1 DISPLAY
      842         temp-font.fontnum   COLUMN-LABEL "№" FORMAT ">9":U
      843   temp-font.fontname  COLUMN-LABEL "Название" FORMAT "x(20)":U
      844   temp-font.fontsize  COLUMN-LABEL "Размер" FORMAT "x(7)":U
      845   temp-font.fonttype  COLUMN-LABEL "Тип" FORMAT "x(6)":U
      846   temp-font.v-row     COLUMN-LABEL "Строк A4-port" FORMAT ">>>>9":U
      847   temp-font.v-col     COLUMN-LABEL "Колонок" FORMAT ">>>>9":U
      848       WITH NO-ROW-MARKERS SEPARATORS SIZE 61.5 BY 10 EXPANDABLE.
      849   DEFINE FRAME Dialog-Frame
      850        B-Cancel AT ROW 1 COL 1
      851        B-sel AT ROW 1 COL 11
      852        B-Help AT ROW 1 COL 55
      853        BROWSE-1 AT ROW 2.25 COL 2.5
      854        SPACE(1.13) SKIP(0.03)
      855       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      856            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      857            TITLE "Список фонтов"
      858            DEFAULT-BUTTON B-sel CANCEL-BUTTON B-Cancel.
      859   ASSIGN
      860          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      861          FRAME Dialog-Frame:HIDDEN           = TRUE.
      862   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      863   DO:
      864     APPLY "END-ERROR":U TO SELF.
      865   END.
      866   ON CHOOSE OF B-Cancel IN FRAME Dialog-Frame
      867   DO:
      868   assign
      869   p-fontnum  = ?
      870   .
      871   END.
      872   ON CHOOSE OF B-sel IN FRAME Dialog-Frame
      873   DO:
      874   if available  temp-font then
      875   assign
      876   p-fontnum  = temp-font.fontnum
      877   p-fontname = temp-font.fontname
      878   p-fontsize = temp-font.fontsize
      879   p-fonttype = temp-font.fonttype
      880   p-col      = temp-font.v-col
      881   p-row      = temp-font.v-row
      882   p-col-lans      = temp-font.v-col-lans
      883   p-row-lans      = temp-font.v-row-lans
      884   .
      885   END.
      886   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      887   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      888   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      889   on help of frame Dialog-Frame
      890   do:
      891     run gbl/app_help.p
      892       (input this-procedure :file-name
      893       ,input ''
      894       ,input ?
      895       ) no-error.
      896     if error-status :error then do:
      897       message
      898         "Ошибка при вызове помощи"
      899         error-status :get-message(1)
      900         view-as alert-box .
      901     end.
      902   end.
      903   run minbtn-set in this-procedure .
      904   on choose of b-help in frame Dialog-Frame
      905   do:
      906     apply "help":u to frame Dialog-Frame .
      907   end.
      908   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      909   procedure minbtn-set :
      910       do
      911           on error undo, return error return-value
      912           :
      913           define variable ii              as integer       no-undo .
      914           define variable fh              as widget-handle no-undo .
      915           define variable hh              as widget-handle no-undo .
      916           define variable v-h             as handle        extent 4 no-undo .
      917           define variable v-name-button   as character     no-undo .
      918           define variable v-help-old-x    as decimal       no-undo .
      919           define variable v-help-old-y    as decimal       no-undo .
      920           define variable v-help-old-size as decimal       no-undo .
      921           define variable v-frame-width   as decimal       no-undo .
      922           define variable jj              as integer       no-undo .
      923           do
      924               on error undo, return error
      925               :
      926               assign
      927                   v-frame-width = frame Dialog-Frame:width - 0.3
      928                   fh            = frame Dialog-Frame:first-child
      929                   hh            = fh:first-child
      930                   ii            = 1
      931                   .
      932               do while valid-handle(hh):
      933                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      934                   do:
      935                       case lc(hh:name) :
      936                           when "b-help" then
      937                               do:
      938                                   hh:load-image-up("cmp/b-help.bmp":u) .
      939                                   hh:load-image-down("cmp/b-help.bmp":u) .
      940                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      941                                   hh:TOOLTIP = "Помощь" .
      942                                   v-help-old-x = hh:column .
      943                                   v-help-old-y = hh:row    .
      944                                   v-help-old-size = hh:width .
      945                                   hh:width-chars = 2.5 .
      946                               end.
      947                           when "b-print" then
      948                               do:
      949                                   hh:load-image("cmp/b-print.bmp":u) .
      950                                   hh:TOOLTIP = "Печать" .
      951                                   v-h[ii] = hh:handle .
      952                                   ii = ii + 1 .
      953                                   hh:width-chars = 3 .
      954                               end.
      955                           when "b-history" or
      956                           when "b-hist" then
      957                               do:
      958                                   hh:load-image("cmp/b-hist.bmp":u) .
      959                                   hh:TOOLTIP = "История" .
      960                                   v-h[ii] = hh:handle .
      961                                   ii = ii + 1 .
      962                                   hh:width-chars = 3 .
      963                               end.
      964                           when "b-sch" then
      965                               do:
      966                                   hh:load-image("cmp/b-sch.bmp":u) .
      967                                   hh:TOOLTIP = "Установка Фильтра" .
      968                                   v-h[ii] = hh:handle .
      969                                   ii = ii + 1 .
      970                                   hh:width-chars = 3 .
      971                               end.
      972                           when "b-hist-user" then
      973                               do:
      974                                   hh:load-image("cmp/b-hist.bmp":u) .
      975                                   hh:TOOLTIP = "История пользователя" .
      976                                   ii = ii + 1 .
      977                               end.
      978                       end case.
      979                   end.
      980                   hh = hh:next-sibling.
      981               end.
      982               b-help:column = v-frame-width - b-help:width-chars.
      983               jj = 0.
      984               repeat ii = 4 to 1 by -1 :
      985                   if valid-handle (v-h[ii] ) then
      986                   do:
      987                       jj  = jj + 1 .
      988                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      989                       v-h[ii]:row    = v-help-old-y .
      990                   end.
      991               end.
      992           end.
      993       end.
      994   end procedure.
      995   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      996   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      997   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      998   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      999   define variable v-diasize-current-frame-width  as decimal   no-undo .
     1000   define variable v-diasize-current-frame-height as decimal   no-undo .
     1001   define variable v-diasize-change-size          as logical   no-undo .
     1002   define variable v-diasize-resize-button        as handle    no-undo .
     1003   define variable v-diasize-wndmax               as logical   no-undo .
     1004   define variable v-diasize-wndstore             as logical   no-undo .
     1005   define variable v-diasize-proc-name            as character no-undo .
     1006   define variable v-diasize-browse-handle        as handle    no-undo .
     1007   define variable v-diasize-browse-number        as integer   no-undo .
     1008   define variable v-diasize-need-full-display    as logical   no-undo init false .
     1009   define temp-table temp-diasize-handle no-undo
     1010     field handle-value  as handle
     1011     field save-position as decimal
     1012     index xpk is primary unique handle-value
     1013     .
     1014   define temp-table temp-browse-handle no-undo
     1015     field browse-type   as character
     1016     field browse-number as integer
     1017     field browse-handle as handle
     1018     field original-size as decimal
     1019     index xpk is primary unique browse-type browse-number
     1020     index xie browse-type browse-handle
     1021   .
     1022   procedure diasize_change-height :
     1023     define input  parameter p-change-value  as decimal   no-undo .
     1024     define input  parameter p-move-resize   as logical   no-undo .
     1025     define variable v-field-group-handle    as handle    no-undo .
     1026     define variable v-object-handle         as handle    no-undo .
     1027     define variable v-frame-height          as decimal   no-undo .
     1028     define variable v-frame-virtual-height  as decimal   no-undo .
     1029     define variable v-browse-height         as decimal   no-undo .
     1030     define variable v-window-height         as decimal   no-undo .
     1031     define variable v-window-virtual-height as decimal   no-undo .
     1032     define variable v-change-sign           as integer   no-undo .
     1033     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1034     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1035     if p-change-value > 0
     1036     then do:
     1037       if frame Dialog-Frame :height + p-change-value
     1038           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     1039       then do:
     1040         assign
     1041           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     1042                           - (frame Dialog-Frame :height-chars)
     1043         .
     1044         if p-change-value <= 0
     1045         then do:
     1046           run diasize_position-resize-button in this-procedure .
     1047           return .
     1048         end.
     1049       end.
     1050     end.
     1051     if p-change-value < 0
     1052     then do:
     1053       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
     1054       then do:
     1055         assign
     1056           p-change-value = v-diasize-orig-frame-height
     1057                          - (frame Dialog-Frame :height-chars)
     1058         .
     1059         if p-change-value >= 0
     1060         then do:
     1061           run diasize_position-resize-button in this-procedure .
     1062           return .
     1063         end.
     1064       end.
     1065     end.
     1066     if p-change-value >= 0
     1067     then do:
     1068       assign
     1069         v-change-sign = 1
     1070       .
     1071     end.
     1072     else do:
     1073       assign
     1074         v-change-sign = -1
     1075       .
     1076     end.
     1077     assign
     1078       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1079     .
     1080     if p-change-value = 0
     1081     then do:
     1082       run diasize_position-resize-button in this-procedure .
     1083       return .
     1084     end.
     1085     move_block:
     1086     do
     1087     on error undo move_block, retry move_block
     1088     :
     1089       if retry
     1090       then do:
     1091         do
     1092         on error undo move_block, leave move_block
     1093         :
     1094           if p-change-value > 0
     1095           then do:
     1096             for each buf_temp-diasize-handle
     1097             on error undo, next
     1098             :
     1099               assign
     1100                 v-object-handle = buf_temp-diasize-handle.handle-value
     1101               .
     1102               if v-object-handle <> v-diasize-resize-button
     1103               then do:
     1104                 assign
     1105                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1106                 .
     1107               end.
     1108             end.
     1109             assign
     1110               v-diasize-browse-handle :height = v-browse-height
     1111             .
     1112             for each buf_temp-browse-handle
     1113               where buf_temp-browse-handle.browse-type = 'height':u
     1114             on error undo, next
     1115             :
     1116               assign
     1117                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1118               .
     1119             end.
     1120             assign
     1121               frame Dialog-Frame :height = v-frame-height
     1122             .
     1123             if frame Dialog-Frame :scrollable = true
     1124             then do:
     1125               assign
     1126                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1127               .
     1128             end.
     1129             run diasize_position-resize-button in this-procedure .
     1130           end.
     1131           else do:
     1132             if frame Dialog-Frame :scrollable = true
     1133             then do:
     1134               assign
     1135                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
     1136               .
     1137             end.
     1138             assign
     1139               frame Dialog-Frame :height = v-frame-height
     1140             .
     1141             assign
     1142               v-diasize-browse-handle :height = v-browse-height
     1143             .
     1144             for each buf_temp-browse-handle
     1145               where buf_temp-browse-handle.browse-type = 'height':u
     1146             on error undo, next
     1147             :
     1148               assign
     1149                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     1150               .
     1151             end.
     1152             for each buf_temp-diasize-handle
     1153             on error undo, next
     1154             :
     1155               assign
     1156                 v-object-handle = buf_temp-diasize-handle.handle-value
     1157               .
     1158               if v-object-handle <> v-diasize-resize-button
     1159               then do:
     1160                 assign
     1161                   v-object-handle :row = buf_temp-diasize-handle.save-position
     1162                 .
     1163               end.
     1164             end.
     1165             run diasize_position-resize-button in this-procedure .
     1166           end.
     1167           assign
     1168             v-diasize-change-size = false
     1169           .
     1170           leave move_block .
     1171         end.
     1172       end.
     1173       assign
     1174         v-diasize-need-full-display = true
     1175       .
     1176       if v-diasize-change-size = false
     1177       then do:
     1178         assign
     1179           v-diasize-change-size = true
     1180         .
     1181       end.
     1182       else do:
     1183         return .
     1184       end.
     1185       assign
     1186         v-frame-height = frame Dialog-Frame :height
     1187         v-frame-virtual-height = frame Dialog-Frame :virtual-height
     1188         v-browse-height = v-diasize-browse-handle :height
     1189       .
     1190       for each buf_temp-browse-handle
     1191         where buf_temp-browse-handle.browse-type = 'height':u
     1192       :
     1193         assign
     1194           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     1195         .
     1196       end.
     1197       for each buf_temp-diasize-handle
     1198       :
     1199         delete buf_temp-diasize-handle .
     1200       end.
     1201       assign
     1202         v-field-group-handle = frame Dialog-Frame :first-child
     1203       .
     1204       do while valid-handle(v-field-group-handle)
     1205       :
     1206         assign
     1207           v-object-handle = v-field-group-handle :first-child
     1208         .
     1209         do while valid-handle(v-object-handle)
     1210         :
     1211           if  v-object-handle <> v-diasize-browse-handle :handle
     1212           and can-query(v-object-handle, "row")
     1213           and can-query(v-object-handle, "height")
     1214           and ( v-object-handle :row > v-diasize-browse-handle :row )
     1215           then do:
     1216             find first buf_temp-browse-handle
     1217               where buf_temp-browse-handle.browse-type   = 'height':u
     1218                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1219               no-error .
     1220             if available buf_temp-browse-handle
     1221             then do:
     1222             end.
     1223             else do:
     1224               create buf_temp-diasize-handle .
     1225               assign
     1226                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1227                 buf_temp-diasize-handle.save-position = v-object-handle :row
     1228               .
     1229             end.
     1230           end.
     1231           assign
     1232             v-object-handle = v-object-handle :next-sibling
     1233           .
     1234         end.
     1235         assign
     1236           v-field-group-handle = v-field-group-handle :next-sibling
     1237         .
     1238       end.
     1239       do with frame Dialog-Frame
     1240       :
     1241         hide v-diasize-resize-button .
     1242         assign
     1243           v-diasize-resize-button :row    = 1
     1244           v-diasize-resize-button :column = 1
     1245         .
     1246       end.
     1247       if p-change-value > 0
     1248       then do:
     1249         if frame Dialog-Frame :scrollable = true
     1250         then do:
     1251           assign
     1252             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1253             no-error .
     1254           if error-status :error
     1255           or error-status :get-message(1) <> ""
     1256           then do:
     1257             undo move_block, retry move_block .
     1258           end.
     1259         end.
     1260         assign
     1261           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1262           no-error .
     1263         if error-status :error
     1264         or error-status :get-message(1) <> ""
     1265         then do:
     1266           undo move_block, retry move_block .
     1267         end.
     1268         assign
     1269           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1270           no-error .
     1271         if error-status :error
     1272         or error-status :get-message(1) <> ""
     1273         then do:
     1274           undo move_block, retry move_block .
     1275         end.
     1276         for each buf_temp-browse-handle
     1277           where buf_temp-browse-handle.browse-type = 'height':u
     1278         on error undo move_block, retry move_block
     1279         :
     1280           assign
     1281             buf_temp-browse-handle.browse-handle :height
     1282               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1283             no-error .
     1284           if error-status :error
     1285           or error-status :get-message(1) <> ""
     1286           then do:
     1287             undo move_block, retry move_block .
     1288           end.
     1289         end.
     1290         for each buf_temp-diasize-handle
     1291         on error undo move_block, retry move_block
     1292         :
     1293           assign
     1294             v-object-handle = buf_temp-diasize-handle.handle-value
     1295           .
     1296           if v-object-handle <> v-diasize-resize-button
     1297           then do:
     1298             assign
     1299               v-object-handle :row = v-object-handle :row + p-change-value
     1300               no-error .
     1301             if error-status :error
     1302             or error-status :get-message(1) <> ""
     1303             then do:
     1304               undo move_block, retry move_block .
     1305             end.
     1306           end.
     1307         end.
     1308       end.
     1309       else do:
     1310         for each buf_temp-diasize-handle
     1311         on error undo move_block, retry move_block
     1312         :
     1313           assign
     1314             v-object-handle = buf_temp-diasize-handle.handle-value
     1315           .
     1316           if v-object-handle <> v-diasize-resize-button
     1317           then do:
     1318             assign
     1319               v-object-handle :row = v-object-handle :row + p-change-value
     1320               no-error .
     1321             if error-status :error
     1322             or error-status :get-message(1) <> ""
     1323             then do:
     1324               undo move_block, retry move_block .
     1325             end.
     1326           end.
     1327         end.
     1328         assign
     1329           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1330           no-error .
     1331         if error-status :error
     1332         or error-status :get-message(1) <> ""
     1333         then do:
     1334           undo move_block, retry move_block .
     1335         end.
     1336         for each buf_temp-browse-handle
     1337           where buf_temp-browse-handle.browse-type = 'height':u
     1338         on error undo move_block, retry move_block
     1339         :
     1340           assign
     1341             buf_temp-browse-handle.browse-handle :height
     1342               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1343             no-error .
     1344           if error-status :error
     1345           or error-status :get-message(1) <> ""
     1346           then do:
     1347             undo move_block, retry move_block .
     1348           end.
     1349         end.
     1350         assign
     1351           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1352           no-error .
     1353         if error-status :error
     1354         or error-status :get-message(1) <> ""
     1355         then do:
     1356           undo move_block, retry move_block .
     1357         end.
     1358         if frame Dialog-Frame :scrollable = true
     1359         then do:
     1360           assign
     1361             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1362             no-error .
     1363           if error-status :error
     1364           or error-status :get-message(1) <> ""
     1365           then do:
     1366             undo move_block, retry move_block .
     1367           end.
     1368         end.
     1369       end.
     1370       if p-move-resize = true
     1371       then do:
     1372         run diasize_position-resize-button in this-procedure .
     1373       end.
     1374       if v-diasize-wndstore = true
     1375       then do:
     1376         if connected("ub") = true
     1377         then do:
     1378           define variable v-cntxt-db-num        as integer   no-undo .
     1379           define variable v-cntxt-userid        as character no-undo .
     1380           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1381                                             , OUTPUT v-cntxt-userid
     1382                                             ) .
     1383           run gbl/wndsizew.p
     1384             (input  v-cntxt-db-num
     1385             ,input  v-cntxt-userid
     1386             ,input  v-diasize-proc-name
     1387             ,input  'height':u
     1388             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1389             ) .
     1390         end.
     1391       end.
     1392     end.
     1393     assign
     1394       v-diasize-change-size = false
     1395     .
     1396   end procedure.
     1397   procedure diasize_set-height :
     1398     define input  parameter p-new-height  as decimal   no-undo .
     1399     define input  parameter p-move-resize as logical   no-undo .
     1400     do
     1401     on error undo, return error return-value
     1402     :
     1403       run diasize_change-height in this-procedure
     1404         (input  (p-new-height - frame Dialog-Frame :height)
     1405         ,input  p-move-resize
     1406         ) .
     1407     end.
     1408   end procedure.
     1409   procedure diasize_change-width :
     1410     define input  parameter p-change-value as decimal   no-undo .
     1411     define input  parameter p-move-resize  as logical   no-undo .
     1412     define variable v-field-group-handle   as handle    no-undo .
     1413     define variable v-object-handle        as handle    no-undo .
     1414     define variable v-frame-width          as decimal   no-undo .
     1415     define variable v-frame-virtual-width  as decimal   no-undo .
     1416     define variable v-browse-width         as decimal   no-undo .
     1417     define variable v-window-width         as decimal   no-undo .
     1418     define variable v-window-virtual-width as decimal   no-undo .
     1419     define variable v-change-sign          as integer   no-undo .
     1420     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1421     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1422     if p-change-value > 0
     1423     then do:
     1424       if frame Dialog-Frame :width + p-change-value >
     1425           session :width-chars
     1426       then do:
     1427         assign
     1428           p-change-value = session :width-chars - frame Dialog-Frame :width
     1429         .
     1430         if p-change-value <= 0
     1431         then do:
     1432           run diasize_position-resize-button in this-procedure .
     1433           return .
     1434         end.
     1435       end.
     1436     end.
     1437     if p-change-value < 0
     1438     then do:
     1439       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1440       then do:
     1441         assign
     1442           p-change-value = v-diasize-orig-frame-width
     1443                          - frame Dialog-Frame :width
     1444         .
     1445         if p-change-value >= 0
     1446         then do:
     1447           run diasize_position-resize-button in this-procedure .
     1448           return .
     1449         end.
     1450       end.
     1451     end.
     1452     if p-change-value >= 0
     1453     then do:
     1454       assign
     1455         v-change-sign = 1
     1456       .
     1457     end.
     1458     else do:
     1459       assign
     1460         v-change-sign = -1
     1461       .
     1462     end.
     1463     assign
     1464       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1465     .
     1466     if p-change-value = 0
     1467     then do:
     1468       run diasize_position-resize-button in this-procedure .
     1469       return .
     1470     end.
     1471     move_block:
     1472     do
     1473     on error undo move_block, leave move_block
     1474     :
     1475       if retry
     1476       then do:
     1477         do
     1478         on error undo move_block, leave move_block
     1479         :
     1480           if p-change-value > 0
     1481           then do:
     1482             for each buf_temp-diasize-handle
     1483             on error undo, next
     1484             :
     1485               assign
     1486                 v-object-handle = buf_temp-diasize-handle.handle-value
     1487               .
     1488               if v-object-handle <> v-diasize-resize-button
     1489               then do:
     1490                 assign
     1491                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1492                 .
     1493               end.
     1494             end.
     1495             assign
     1496               v-diasize-browse-handle :width = v-browse-width
     1497             .
     1498             for each buf_temp-browse-handle
     1499               where buf_temp-browse-handle.browse-type = 'width':u
     1500             on error undo, next
     1501             :
     1502               assign
     1503                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1504               .
     1505             end.
     1506             assign
     1507               frame Dialog-Frame :width = v-frame-width
     1508             .
     1509             if frame Dialog-Frame :scrollable = true
     1510             then do:
     1511               assign
     1512                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1513               .
     1514             end.
     1515             run diasize_position-resize-button in this-procedure .
     1516           end.
     1517           else do:
     1518             if frame Dialog-Frame :scrollable = true
     1519             then do:
     1520               assign
     1521                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1522               .
     1523             end.
     1524             assign
     1525               frame Dialog-Frame :width = v-frame-width
     1526             .
     1527             for each buf_temp-browse-handle
     1528               where buf_temp-browse-handle.browse-type = 'width':u
     1529             on error undo, next
     1530             :
     1531               assign
     1532                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1533               .
     1534             end.
     1535             assign
     1536               v-diasize-browse-handle :width = v-browse-width
     1537             .
     1538             for each buf_temp-diasize-handle
     1539             on error undo, next
     1540             :
     1541               assign
     1542                 v-object-handle = buf_temp-diasize-handle.handle-value
     1543               .
     1544               if v-object-handle <> v-diasize-resize-button
     1545               then do:
     1546                 assign
     1547                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1548                 .
     1549               end.
     1550             end.
     1551             run diasize_position-resize-button in this-procedure .
     1552           end.
     1553           assign
     1554             v-diasize-change-size = false
     1555           .
     1556           leave move_block .
     1557         end.
     1558       end.
     1559       assign
     1560         v-diasize-need-full-display = true
     1561       .
     1562       if v-diasize-change-size = false
     1563       then do:
     1564         assign
     1565           v-diasize-change-size = true
     1566         .
     1567       end.
     1568       else do:
     1569         return .
     1570       end.
     1571       assign
     1572         v-frame-width = frame Dialog-Frame :width
     1573         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1574         v-browse-width = v-diasize-browse-handle :width
     1575       .
     1576       for each buf_temp-browse-handle
     1577         where buf_temp-browse-handle.browse-type = 'width':u
     1578       :
     1579         assign
     1580           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1581         .
     1582       end.
     1583       for each buf_temp-diasize-handle
     1584       :
     1585         delete buf_temp-diasize-handle .
     1586       end.
     1587       assign
     1588         v-field-group-handle = frame Dialog-Frame :first-child
     1589       .
     1590       do while valid-handle(v-field-group-handle)
     1591       :
     1592         assign
     1593           v-object-handle = v-field-group-handle :first-child
     1594         .
     1595         do while valid-handle(v-object-handle)
     1596         :
     1597           if  v-object-handle <> v-diasize-browse-handle :handle
     1598           and v-object-handle <> v-diasize-resize-button
     1599           and can-query(v-object-handle, "row")
     1600           and can-query(v-object-handle, "height")
     1601           and ( v-object-handle :col + v-object-handle :width
     1602                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1603               )
     1604           then do:
     1605             find first buf_temp-browse-handle
     1606               where buf_temp-browse-handle.browse-type   = 'width':u
     1607                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1608               no-error .
     1609             if available buf_temp-browse-handle
     1610             then do:
     1611             end.
     1612             else do:
     1613               create buf_temp-diasize-handle .
     1614               assign
     1615                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1616                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1617               .
     1618             end.
     1619           end.
     1620           assign
     1621             v-object-handle = v-object-handle :next-sibling
     1622           .
     1623         end.
     1624         assign
     1625           v-field-group-handle = v-field-group-handle :next-sibling
     1626         .
     1627       end.
     1628       do with frame Dialog-Frame
     1629       :
     1630         hide v-diasize-resize-button .
     1631         v-diasize-resize-button :row = 1.
     1632         v-diasize-resize-button :column = 1.
     1633       end.
     1634       if p-change-value > 0
     1635       then do:
     1636         if frame Dialog-Frame :scrollable = true
     1637         then do:
     1638           assign
     1639             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1640             no-error .
     1641           if error-status :error
     1642           or error-status :get-message(1) <> ""
     1643           then do:
     1644             undo move_block, retry move_block.
     1645           end.
     1646         end.
     1647         assign
     1648           frame Dialog-Frame :width = v-frame-width + p-change-value
     1649           no-error .
     1650         if error-status :error
     1651         or error-status :get-message(1) <> ""
     1652         then do:
     1653           undo move_block, retry move_block.
     1654         end.
     1655         assign
     1656           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1657         no-error .
     1658         if error-status :error
     1659         or error-status :get-message(1) <> ""
     1660         then do:
     1661           undo move_block, retry move_block.
     1662         end.
     1663         for each buf_temp-browse-handle
     1664           where buf_temp-browse-handle.browse-type = 'width':u
     1665         on error undo move_block, retry move_block
     1666         :
     1667           assign
     1668             buf_temp-browse-handle.browse-handle :width
     1669               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1670             no-error .
     1671           if error-status :error
     1672           or error-status :get-message(1) <> ""
     1673           then do:
     1674             undo move_block, retry move_block .
     1675           end.
     1676         end.
     1677         for each buf_temp-diasize-handle
     1678         on error undo move_block, retry move_block
     1679         :
     1680           assign
     1681             v-object-handle = buf_temp-diasize-handle.handle-value
     1682           .
     1683           if v-object-handle <> v-diasize-resize-button
     1684           then do:
     1685             assign
     1686               v-object-handle :col = v-object-handle :col + p-change-value
     1687               no-error .
     1688             if error-status :error
     1689             or error-status :get-message(1) <> ""
     1690             then do:
     1691               undo move_block, retry move_block .
     1692             end.
     1693           end.
     1694         end.
     1695       end.
     1696       else do:
     1697         for each buf_temp-diasize-handle
     1698         on error undo move_block, retry move_block
     1699         :
     1700           assign
     1701             v-object-handle = buf_temp-diasize-handle.handle-value
     1702           .
     1703           if v-object-handle <> v-diasize-resize-button
     1704           then do:
     1705             assign
     1706               v-object-handle :col = v-object-handle :col + p-change-value
     1707               no-error .
     1708             if error-status :error
     1709             or error-status :get-message(1) <> ""
     1710             then do:
     1711               undo move_block, retry move_block .
     1712             end.
     1713           end.
     1714         end.
     1715         for each buf_temp-browse-handle
     1716           where buf_temp-browse-handle.browse-type = 'width':u
     1717         on error undo move_block, retry move_block
     1718         :
     1719           assign
     1720             buf_temp-browse-handle.browse-handle :width
     1721               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1722             no-error .
     1723           if error-status :error
     1724           or error-status :get-message(1) <> ""
     1725           then do:
     1726             undo move_block, retry move_block .
     1727           end.
     1728         end.
     1729         assign
     1730           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1731           no-error .
     1732         if error-status :error
     1733         or error-status :get-message(1) <> ""
     1734         then do:
     1735           undo move_block, retry move_block.
     1736         end.
     1737         assign
     1738           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1739         no-error .
     1740         if error-status :error
     1741         or error-status :get-message(1) <> ""
     1742         then do:
     1743           undo move_block, retry move_block.
     1744         end.
     1745         if frame Dialog-Frame :scrollable = true
     1746         then do:
     1747           assign
     1748             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1749           no-error .
     1750           if error-status :error
     1751           or error-status :get-message(1) <> ""
     1752           then do:
     1753             undo move_block, retry move_block.
     1754           end.
     1755         end.
     1756       end.
     1757       if p-move-resize
     1758       then do:
     1759         run diasize_position-resize-button in this-procedure .
     1760       end.
     1761       if v-diasize-wndstore = true
     1762       then do:
     1763         if connected("ub") = true
     1764         then do:
     1765           define variable v-cntxt-db-num        as integer   no-undo .
     1766           define variable v-cntxt-userid        as character no-undo .
     1767           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1768                                             , OUTPUT v-cntxt-userid
     1769                                             ) .
     1770           run gbl/wndsizew.p
     1771             (input  v-cntxt-db-num
     1772             ,input  v-cntxt-userid
     1773             ,input  v-diasize-proc-name
     1774             ,input  'width':u
     1775             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1776             ) .
     1777         end.
     1778       end.
     1779     end.
     1780     assign
     1781       v-diasize-change-size = false
     1782     .
     1783   end procedure.
     1784   procedure diasize_set-width :
     1785     define input  parameter p-new-width  as decimal   no-undo .
     1786     define input  parameter p-move-resize as logical   no-undo .
     1787     do
     1788     on error undo, return error return-value
     1789     :
     1790       run diasize_change-width in this-procedure
     1791         (input  (p-new-width - frame Dialog-Frame :width)
     1792         ,input  p-move-resize
     1793         ) .
     1794     end.
     1795   end procedure.
     1796   procedure diasize_position-resize-button :
     1797     do with frame Dialog-Frame
     1798     :
     1799       hide v-diasize-resize-button .
     1800       assign
     1801         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1802                     - 1
     1803                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1804         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1805                     - 1
     1806                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1807       .
     1808       view v-diasize-resize-button .
     1809     end.
     1810   end procedure.
     1811   on alt-right anywhere
     1812   do:
     1813     run diasize_change-width in this-procedure
     1814       (input 1
     1815       ,input true
     1816       ) .
     1817     return no-apply .
     1818   end.
     1819   on alt-left anywhere
     1820   do:
     1821     run diasize_change-width in this-procedure
     1822       (input -1
     1823       ,input true
     1824       ) .
     1825     return no-apply .
     1826   end.
     1827   on alt-down anywhere
     1828   do:
     1829     run diasize_change-height in this-procedure
     1830       (input 1
     1831       ,input true
     1832       ) .
     1833     return no-apply .
     1834   end.
     1835   on alt-up anywhere
     1836   do:
     1837     run diasize_change-height in this-procedure
     1838       (input -1
     1839       ,input true
     1840       ) .
     1841     return no-apply .
     1842   end.
     1843   on alt-enter of frame Dialog-Frame
     1844   do:
     1845     run diasize_maximize in this-procedure
     1846       (input  ?
     1847       ).
     1848     return no-apply .
     1849   end.
     1850   procedure diasize_end-move :
     1851     do
     1852     on error undo, return error return-value
     1853     :
     1854       define variable v-row-delta as decimal   no-undo .
     1855       define variable v-col-delta as decimal   no-undo .
     1856       define variable v-new-row as decimal   no-undo .
     1857       define variable v-new-col as decimal   no-undo .
     1858       assign
     1859         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1860         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1861       .
     1862       assign
     1863         v-row-delta = v-new-row - frame Dialog-Frame :height
     1864         v-col-delta = v-new-col - frame Dialog-Frame :width
     1865       .
     1866       run diasize_change-height in this-procedure
     1867         (input v-row-delta
     1868         ,input true
     1869         ) .
     1870       run diasize_change-width in this-procedure
     1871         (input v-col-delta
     1872         ,input true
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure diasize_maximize :
     1877     define input  parameter p-action as logical   no-undo .
     1878     do
     1879     on error undo, return error return-value
     1880     :
     1881       if p-action = ?
     1882       then do:
     1883         if v-diasize-need-maximize = true
     1884         then do:
     1885           assign
     1886             p-action = true
     1887           .
     1888         end.
     1889         else do:
     1890           assign
     1891             p-action = false
     1892           .
     1893         end.
     1894       end.
     1895       if p-action = true
     1896       then do:
     1897         run diasize_change-height in this-procedure
     1898           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1899               - frame Dialog-Frame :height-chars
     1900           ,input true
     1901           ) .
     1902         run diasize_change-width in this-procedure
     1903           (input session :width-chars
     1904               - frame Dialog-Frame :width-chars
     1905           ,input true
     1906           ) .
     1907         assign
     1908           v-diasize-need-maximize = false
     1909         .
     1910       end.
     1911       else do:
     1912         run diasize_change-width in this-procedure
     1913           (input v-diasize-orig-frame-width
     1914               - frame Dialog-Frame :width-chars
     1915           ,input true
     1916           ) .
     1917         run diasize_change-height in this-procedure
     1918           (input v-diasize-orig-frame-height
     1919               - frame Dialog-Frame :height-chars
     1920           ,input true
     1921           ) .
     1922         assign
     1923           v-diasize-need-maximize = true
     1924         .
     1925       end.
     1926     end.
     1927   end procedure.
     1928   procedure diasize_restore-orig-size :
     1929     do
     1930     on error undo, return error return-value
     1931     :
     1932       assign
     1933         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1934         v-diasize-current-frame-height = frame Dialog-Frame :height
     1935       .
     1936       run diasize_set-height in this-procedure
     1937         (input  v-diasize-orig-frame-height
     1938         ,input  true
     1939         ) .
     1940       run diasize_set-width in this-procedure
     1941         (input  v-diasize-orig-frame-width
     1942         ,input  true
     1943         ) .
     1944     end.
     1945   end procedure.
     1946   procedure diasize_restore-current-size :
     1947     do
     1948     on error undo, return error return-value
     1949     :
     1950       run diasize_set-height in this-procedure
     1951         (input  v-diasize-current-frame-height
     1952         ,input  true
     1953         ) .
     1954       run diasize_set-width in this-procedure
     1955         (input  v-diasize-current-frame-width
     1956         ,input  true
     1957         ) .
     1958     end.
     1959   end procedure.
     1960   procedure diasize_set-browse-handle :
     1961     define input  parameter p-browse-handle as handle   no-undo .
     1962     define buffer buf_temp-browse-handle for temp-browse-handle .
     1963     do
     1964     on error undo, return error return-value
     1965     :
     1966       assign
     1967         v-diasize-browse-handle = p-browse-handle
     1968       .
     1969       for each buf_temp-browse-handle
     1970       on error undo, return error return-value
     1971       :
     1972         delete buf_temp-browse-handle .
     1973       end.
     1974     end.
     1975   end procedure.
     1976   procedure diasize_add_browse :
     1977     define input  parameter p-browse-type   as character no-undo .
     1978     define input  parameter p-browse-handle as handle    no-undo .
     1979     define buffer buf_temp-browse-handle for temp-browse-handle .
     1980     do
     1981     on error undo, return error return-value
     1982     :
     1983       assign
     1984         v-diasize-browse-number = v-diasize-browse-number + 1
     1985       .
     1986       create buf_temp-browse-handle .
     1987       assign
     1988         buf_temp-browse-handle.browse-type   = p-browse-type
     1989         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1990         buf_temp-browse-handle.browse-handle = p-browse-handle
     1991       .
     1992     end.
     1993   end procedure.
     1994   procedure diasize_init :
     1995     define variable v-default-value    as logical   no-undo .
     1996     define variable v-restore-saved    as logical   no-undo .
     1997     define variable v-resize-value-str as character no-undo .
     1998     do
     1999     on error undo, return error return-value
     2000     :
     2001       do with frame Dialog-Frame
     2002       :
     2003         assign
     2004           v-diasize-orig-frame-height = frame Dialog-Frame :height
     2005           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     2006           v-diasize-browse-handle     = browse BROWSE-1 :handle
     2007         .
     2008         create button v-diasize-resize-button
     2009         assign
     2010           parent        = frame Dialog-Frame :first-child
     2011           label         = "s"
     2012           height-pixels = 16
     2013           width-pixels  = 16
     2014           visible       = true
     2015           sensitive     = true
     2016           movable       = true
     2017           triggers:
     2018             on end-move persistent run diasize_end-move in this-procedure .
     2019           end triggers.
     2020         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     2021         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     2022         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     2023         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     2024         assign
     2025           v-diasize-wndmax = false
     2026         .
     2027         if connected("ub") = true
     2028         then do:
     2029           define variable v-cntxt-db-num        as integer   no-undo .
     2030           define variable v-cntxt-userid        as character no-undo .
     2031           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2032                                             , OUTPUT v-cntxt-userid
     2033                                             ) .
     2034           run gbl/wndpar_r.p
     2035             (input  v-cntxt-db-num
     2036             ,input  v-cntxt-userid
     2037             ,input  'wndmax':U
     2038             ,output v-diasize-wndmax
     2039             ,output v-default-value
     2040             ) .
     2041         end.
     2042         assign
     2043           v-diasize-wndstore = false
     2044         .
     2045         if connected("ub") = true
     2046         then do:
     2047           run gbl/wndpar_r.p
     2048             (input  v-cntxt-db-num
     2049             ,input  v-cntxt-userid
     2050             ,input  'wndstore':U
     2051             ,output v-diasize-wndstore
     2052             ,output v-default-value
     2053             ) .
     2054         end.
     2055         assign
     2056           v-diasize-proc-name = entry(1, program-name(2), '.')
     2057         .
     2058         if v-diasize-wndstore = true
     2059         then do:
     2060           assign
     2061             v-restore-saved = false
     2062           .
     2063           if connected("ub") = true
     2064           then do:
     2065             run gbl/wndsizer.p
     2066               (input  v-cntxt-db-num
     2067               ,input  v-cntxt-userid
     2068               ,input  v-diasize-proc-name
     2069               ,input  'height':u
     2070               ,output v-resize-value-str
     2071               ) .
     2072             if v-resize-value-str <> '':U
     2073             then do:
     2074               run diasize_change-height in this-procedure
     2075                 (input  integer(v-resize-value-str)
     2076                 ,input  true
     2077                 ) .
     2078               assign
     2079                 v-restore-saved = true
     2080               .
     2081             end.
     2082           end.
     2083           if connected("ub") = true
     2084           then do:
     2085             run gbl/wndsizer.p
     2086               (input  v-cntxt-db-num
     2087               ,input  v-cntxt-userid
     2088               ,input  v-diasize-proc-name
     2089               ,input  'width':u
     2090               ,output v-resize-value-str
     2091               ) .
     2092             if v-resize-value-str <> '':U
     2093             then do:
     2094               run diasize_change-width in this-procedure
     2095                 (input  integer(v-resize-value-str)
     2096                 ,input  true
     2097                 ) .
     2098               assign
     2099                 v-restore-saved = true
     2100               .
     2101             end.
     2102           end.
     2103           if v-restore-saved <> true
     2104           then do:
     2105             if v-diasize-wndmax = true
     2106             then do:
     2107               run diasize_maximize in this-procedure
     2108                 (input  true
     2109                 ) .
     2110             end.
     2111           end.
     2112         end.
     2113         else do:
     2114           if v-diasize-wndmax = true
     2115           then do:
     2116             run diasize_maximize in this-procedure
     2117               (input  true
     2118               ) .
     2119           end.
     2120         end.
     2121       end.
     2122     end.
     2123   end procedure.
     2124   procedure diasize_need-full-display :
     2125     define output parameter p-need-full-display as logical   no-undo .
     2126     do
     2127     on error undo, return error return-value
     2128     :
     2129       assign
     2130         p-need-full-display = v-diasize-need-full-display
     2131       .
     2132       assign
     2133         v-diasize-need-full-display = false
     2134       .
     2135     end.
     2136   end procedure.
     2137   procedure get-context :
     2138      define output parameter p-db-num as integer          no-undo.
     2139      define output parameter p-user-id as character        no-undo.
     2140      define variable v-login               as character    no-undo.
     2141      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     2142      define buffer buf_user-login  for ub.user-login .
     2143      do
     2144      on error undo, return error
     2145      :
     2146            FIND FIRST buf_sys-ctrl no-lock.
     2147            ASSIGN
     2148               v-login = USERID("ub")
     2149               p-db-num = buf_sys-ctrl.db-num
     2150            .
     2151            FIND FIRST buf_user-login
     2152                 WHERE buf_user-login.db-num = p-db-num
     2153                   AND buf_user-login.user-login = v-login
     2154                 no-lock
     2155                 no-error
     2156                 .
     2157            IF AVAILABLE buf_user-login
     2158            THEN DO:
     2159               assign
     2160                  p-user-id = buf_user-login.user-id
     2161               .
     2162            END.
     2163      end.
     2164   end procedure.
     2165       run diasize_init in this-procedure .
     2166   MAIN-BLOCK:
     2167   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     2168      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     2169     RUN INIT-proc.
     2170     RUN enable_UI.
     2171     WAIT-FOR GO OF FRAME Dialog-Frame.
     2172   END.
     2173   RUN disable_UI.
     2174   PROCEDURE disable_UI :
     2175     HIDE FRAME Dialog-Frame.
     2176   END PROCEDURE.
     2177   PROCEDURE enable_UI :
     2178     ENABLE B-Cancel B-sel B-Help BROWSE-1
     2179         WITH FRAME Dialog-Frame.
     2180     VIEW FRAME Dialog-Frame.
     2181     OPEN QUERY BROWSE-1 FOR EACH temp-font .
     2182   END PROCEDURE.
     2183   PROCEDURE INIT-proc :
     2184   run get-font-ini in this-procedure .
     2185   END PROCEDURE.
