      408   def
      409   new shared
      410   temp-table  obj-list no-undo
      411     field obj-type like ub.clients.obj-type
      412     field obj-code like ub.clients.obj-code
      413     field obj-name like ub.clients.obj-name
      414     field obj-id   as integer
