     1587        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
     1588        size 96.5 by 4.83
     1589        BGCOLOR 8 .
     1590   DEFINE QUERY br-suppl FOR
     1591         suppl-gds SCROLLING.
     1592   DEFINE BROWSE br-suppl
     1593     QUERY br-suppl DISPLAY
     1594         suppl-gds.artic COLUMN-LABEL "Артикул! "
     1595   suppl-gds.gds-name COLUMN-LABEL "Название товара! "
     1596   suppl-gds.unit-base COLUMN-LABEL "Ед.!Изм." FORMAT "X(5)"
     1597   suppl-gds.in-qnty COLUMN-LABEL "Приход! количество" FORMAT "->,>>>,>>9.<<<"
     1598   suppl-gds.in-sum0-rubl COLUMN-LABEL "Приход сумма!уч. цен (руб)" FORMAT "->>>,>>>,>>9.99"
     1599   suppl-gds.in-sum0-base COLUMN-LABEL "Приход сумма!уч. цен (б.вал)" FORMAT "->>>,>>>,>>9.99"
     1600   suppl-gds.out-qnty COLUMN-LABEL "Расход!количество" FORMAT "->,>>>,>>9.<<<"
     1601   suppl-gds.out-sum0-rubl COLUMN-LABEL "Расход сумма!уч. цен (руб)" FORMAT "->>>,>>>,>>9.99"
     1602   suppl-gds.out-sum0-base COLUMN-LABEL "Расход сумма!уч. цен (б.вал)" FORMAT "->>>,>>>,>>9.99"
     1603   suppl-gds.free-qnty COLUMN-LABEL "Остаток!количество" FORMAT "->,>>>,>>9.<<<"
     1604   suppl-gds.free-sum0-rubl COLUMN-LABEL "Остаток сумма!уч. цен (руб)" FORMAT "->>>,>>>,>>9.99"
     1605   suppl-gds.free-sum0-base COLUMN-LABEL "Остаток сумма!уч. цен (б.вал)" FORMAT "->>>,>>>,>>9.99"
     1606   suppl-gds.qnty-sale COLUMN-LABEL "Кол-во!продаж" FORMAT "->,>>>,>>9"
     1607   (suppl-gds.ls-date - suppl-gds.fs-date) COLUMN-LABEL "Кол-во дней!продаж" FORMAT "->,>>>,>>9"
     1608       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.5 BY 16.
     1609   DEFINE FRAME v-suppl
     1610        tot-out-sum0-rubl at row 22 col 45 COLON-ALIGNED NO-LABEL
     1611        br-suppl AT ROW 3.67 COL 2
     1612        tot-in-qnty at row 20.83 col 18.5 COLON-ALIGNED
     1613        tot-out-sum0-base at row 23.17 col 45 COLON-ALIGNED NO-LABEL
     1614        tot-free-qnty at row 20.83 col 72.5 COLON-ALIGNED NO-LABEL
     1615        tot-in-sum0-rubl at row 22 col 18.5 COLON-ALIGNED
     1616        b-parts at row 1.17 col 22
     1617        loc-art at row 2.5 col 33.5 COLON-ALIGNED
     1618        a-n-c at row 2.5 col 2 NO-LABEL
     1619        tot-free-sum0-rubl at row 22 col 72.5 COLON-ALIGNED NO-LABEL
     1620        tot-out-qnty at row 20.83 col 45 COLON-ALIGNED NO-LABEL
     1621        tot-in-sum0-base at row 23.17 col 18.5 COLON-ALIGNED
     1622        tot-free-sum0-base at row 23.17 col 72.5 COLON-ALIGNED NO-LABEL
     1623        b-quit at row 1.17 col 2
     1624        loc-name at row 2.5 col 33.5 COLON-ALIGNED
     1625        loc-code at row 2.5 col 33.5 COLON-ALIGNED
     1626        b-print at row 1.17 col 12
     1627        b-help at row 1.17 col 88.5
     1628        "Остаток" VIEW-AS TEXT
     1629             size 10 by 0.63 at row 20 col 77.5
     1630        rect-in at row 19.67 col 2
