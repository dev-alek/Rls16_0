      855   define variable var-report-r-b as character no-undo .
      856   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      857   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      858     (output var-report-r-b
      859     )  .
      860   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      861   define  stream PrnLibStream.
      862   procedure prn-lib-prn-file :
      863     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      864     define input parameter p-DIsabledoptions as integer no-undo .
      865     define variable v-report-name as character no-undo .
      866     define variable v-user-action as character no-undo .
      867     define variable v-printed     as logical   no-undo .
      868     define variable v-exist       as logical   no-undo .
      869     do
      870       on error undo, return error
      871       :
      872       run prn-lib-get-report-name  in this-procedure (
      873         input parParentProc
      874         ,output v-report-name
      875         ).
      876   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      877   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      878     (input  v-report-name
      879     ,input  2
      880     ,output v-exist
      881     )  .
      882       if NOT v-exist then
      883       DO:
      884         Message
      885           "Нет заданий на печать ! "
      886           view-as alert-box .
      887         Return  .
      888       End.
      889       run gbl/prnfilen.w
      890         (input  ""
      891         ,input  p-DisabledOptions
      892         ,input  string(v-report-name )
      893         ,input  7
      894         ,output v-user-action
      895         ,output v-printed
      896         ) .
      897       if v-printed then
      898       do:
      899         return "YES" .
      900       end.
      901       else
      902       do:
      903         return "NO" .
      904       end.
      905     end.
      906   end procedure.
      907   procedure prn-lib-open-stream :
      908     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      909     define input parameter p-page-size    as integer no-undo .
      910     define input parameter p-is-stream    as logical no-undo .
      911     define input parameter p-append       as logical no-undo .
      912     define variable v-report-name as character no-undo .
      913     do
      914       on error undo, return error
      915       :
      916       run prn-lib-get-report-name  in this-procedure (
      917         input parParentProc
      918         ,output v-report-name
      919         ).
      920       if p-is-stream then
      921       do:
      922         if p-append then
      923         do:
      924           output stream PrnLibStream to value( v-report-name )
      925             page-size value(p-page-size) append .
      926         end.
      927         if not p-append then
      928         do:
      929           output stream PrnLibStream to value( v-report-name )
      930             page-size value(p-page-size) .
      931         end.
      932       end.
      933       if not p-is-stream then
      934       do:
      935         if p-append then
      936         do:
      937           output to value( v-report-name )
      938             page-size value(p-page-size) append .
      939         end.
      940         if not p-append then
      941         do:
      942           output to value( v-report-name )
      943             page-size value(p-page-size) .
      944         end.
      945       end.
      946     end.
      947   end procedure.
      948   procedure prn-lib-open-exp :
      949     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      950     define input parameter p-is-stream    as logical no-undo .
      951     define input parameter p-is-append    as logical no-undo .
      952     define output parameter p-ReportFileName as char init "report" no-undo.
      953     define output parameter p-process as logical no-undo .
      954     define variable glog as logical no-undo .
      955     do
      956       on error undo, return error
      957       :
      958       SYSTEM-DIALOG GET-FILE p-ReportFileName
      959         TITLE      "Укажите путь"
      960         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      961         ASK-OVERWRITE
      962         CREATE-TEST-FILE
      963         SAVE-AS
      964         USE-FILENAME
      965         DEFAULT-EXTENSION "txt"
      966         UPDATE glog
      967         .
      968       if not glog then  return.
      969       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      970       if p-is-stream then
      971       do:
      972         if p-is-append then
      973         do:
      974           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      975         end.
      976         else
      977         do:
      978           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      979         end.
      980       end.
      981       else
      982       do:
      983         if p-is-append then
      984         do:
      985           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      986         end.
      987         else
      988         do:
      989           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      990         end.
      991       end.
      992       p-process = yes.
      993     end.
      994   end procedure.
      995   procedure prn-lib-get-report-name :
      996     define input parameter parParentProc  as widget-handle no-undo.
      997     define output parameter p-report-name as character no-undo .
      998     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      999   end procedure.
     1000   procedure prn-lib-reportviewer-report-name :
     1001     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1002     define input parameter p-report-name-html as character no-undo .
     1003     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1004   end procedure.
     1005   procedure prn-lib-reportviewer :
     1006     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1007     define input parameter p-report-name-html as character no-undo .
     1008     define input parameter p-param        as character no-undo .
     1009     define variable v-excel           as character no-undo init 'TRUE' .
     1010     define variable v-value-character as character no-undo .
     1011     define variable v-value-integer   as character no-undo .
     1012     define variable v-value-date      as date      no-undo .
     1013     define variable v-value-decimal   as decimal   no-undo .
     1014     define variable rep-excel         as logical   no-undo .
     1015     define variable excel-string      as character no-undo .
     1016     define variable v-param-type      as character no-undo .
     1017     define variable v-tth             as handle    no-undo .
     1018     run adm/shattri.p (
     1019       input "get":U
     1020       ,input  ""
     1021       ,input  0
     1022       ,input  'report-glob':U
     1023       ,input  'rep-excel':U
     1024       ,output v-value-character
     1025       ,output v-value-date
     1026       ,output v-value-decimal
     1027       ,output v-value-integer
     1028       ,output rep-excel
     1029       ,output v-param-type
     1030       ,INPUT-OUTPUT table-handle v-tth
     1031       )  .
     1032     if rep-excel then v-excel = "TRUE" .
     1033     else v-excel = "FALSE" .
     1034     if p-param eq ""
     1035     then
     1036        p-param = "EXCEL:" + v-excel.
     1037     else
     1038        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1039     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1040   end procedure.
     1041   define new shared temp-table sup-gds no-undo
     1042       field artic          like ub.goods.artic
