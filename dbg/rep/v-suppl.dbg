     1658   ON CHOOSE OF b-print IN FRAME v-suppl
     1659   DO:
     1660   define variable in-sum0 LIKE parts.price-rubl no-undo.
     1661   define variable out-sum0 LIKE parts.price-rubl no-undo.
     1662   define variable free-sum0 LIKE parts.price-rubl no-undo.
     1663   define variable sym1 as char init ":"   no-undo.
     1664   define variable sym2 as char init ":"   no-undo.
     1665   define variable sym3 as char init ":"   no-undo.
     1666   define variable sym4 as char init ":"   no-undo.
     1667   define variable sym5 as char init ":"   no-undo.
     1668   define variable sym6 as char init ":"   no-undo.
     1669   define variable sym7 as char init ":"   no-undo.
     1670   define variable sym8 as char init ":"   no-undo.
     1671   define variable sym9 as char init ":"   no-undo.
     1672   define variable sym10 as char init ":"   no-undo.
     1673   define variable sym11 as char init ":"   no-undo.
     1674   define variable sym12 as char init ":"   no-undo.
     1675   define variable sym13 as char init ":"   no-undo.
     1676   define variable Line as char no-undo.
     1677   assign PrintRubl = yes .
     1678   if v-base-code <> 0 then
     1679   message "Печатать в рублях ?" VIEW-AS ALERT-BOX QUESTION BUTTONS yes-no TITLE "" UPDATE PrintRubl.
     1680   assign
     1681   sheetf.Excel-Column-Lable = "Артикул,Название,Ед.изм,Приход количество,Приход сумма учетных цен," +
     1682                               "Расход количество,Расход сумма учетных цен,Остаток количество,Остаток сумма учетных цен"
     1683   sheetf.sizes =  "16,50,5,15,18," +
     1684                   "15,18,15,18"
     1685   sheetf.colformat = chr(4) + "1=@"
     1686   Make-Excel = yes
     1687   reportname =  "ОТЧЕТ ПО ПОСТАВЩИКУ: " + supplier.obj-name +
     1688               " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")"
     1689   str2 =  " за период с: " + string(from-date,"99/99/9999") + " по: " + string(to-date,"99/99/9999")
     1690   str4 = "Cуммы указаны в " + (if PrintRubl then "руб" else base-type)
     1691   .
     1692   DEFINE FRAME supp-gds
     1693         sym1 column-label ":!:" format "X(1)"
     1694         suppl-gds.artic COLUMN-LABEL "Артикул! " FORMAT "x(16)"
     1695         sym2 column-label ":!:" format "X(1)"
     1696         suppl-gds.gds-name COLUMN-LABEL "Название! " FORMAT "x(50)"
     1697         sym3 column-label ":!:" format "X(1)"
     1698         suppl-gds.unit-base COLUMN-LABEL "Ед.!изм." FORMAT "x(5)"
     1699         sym4 column-label ":!:" format "X(1)"
     1700         suppl-gds.in-qnty COLUMN-LABEL "Приход!    количество" FORMAT "->,>>>,>>9.<<<"
     1701         sym5 column-label ":!:" format "X(1)"
     1702         in-sum0 COLUMN-LABEL "Приход сумма!учетных цен" FORMAT "->>,>>>,>>>,>>9.99"
     1703         sym6 column-label ":!:" format "X(1)"
     1704         suppl-gds.out-qnty COLUMN-LABEL "Расход!    количество" FORMAT "->,>>>,>>9.<<<"
     1705         sym7 column-label ":!:" format "X(1)"
     1706         out-sum0 COLUMN-LABEL "Расход сумма!учетных цен" FORMAT "->>,>>>,>>>,>>9.99"
     1707         sym8 column-label ":!:" format "X(1)"
     1708         suppl-gds.free-qnty COLUMN-LABEL "Остаток!    количество" FORMAT "->,>>>,>>9.<<<"
     1709         sym9 column-label ":!:" format "X(1)"
     1710         free-sum0 COLUMN-LABEL "Остаток сумма!учетных цен" FORMAT "->>,>>>,>>>,>>9.99"
     1711         sym10 column-label ":!:" format "X(1)"
     1712       HEADER
     1713           cur-time-print() AT 5 format "X(35)"
     1714           string( "Отчет по поставщику: " + supplier.obj-name ) AT 45 format "X(71)"
     1715           string( str4 ) AT 145 format "X(20)"
     1716           string( "Страница " + string( PAGE-NUMBER( PrnLibStream ), ">>9" ) ) AT 170 format "X(13)" SKIP
     1717           Line format "X(195)" AT 1
     1718       with width 232 down stream-io.
     1719   if session:set-wait-state("COMPILER") then.
     1720   assign Line = fill("-", 232).
     1721   run prn-lib-open-stream  in this-procedure (
     1722                                                input parParentProc
     1723                                               ,input 43
     1724                                               ,input yes
     1725                                               ,input no
     1726                                               ).
     1727   FORM with FRAME supp-gds.
     1728   FORM HEADER
     1729       Line format "X(195)" AT 1 SKIP
     1730       "Продолжение - на следующей странице" AT 60 SKIP
     1731       with FRAME BottomFrame width 232
     1732       PAGE-BOTTOM no-labels no-box.
     1733   VIEW STREAM PrnLibStream FRAME BottomFrame .
     1734   PUT STREAM PrnLibStream
     1735       string( ReportName + chr(32) + str2)  AT 37 format "X(195)" SKIP(1).
     1736   RUN OpenForExcel in this-procedure .
     1737   run rep/extitle.p (1).
     1738       FOR EACH suppl-gds:
     1739           assign
     1740               in-sum0 = (if PrintRubl then suppl-gds.in-sum0-rubl else suppl-gds.in-sum0-base)
     1741               out-sum0 = (if PrintRubl then suppl-gds.out-sum0-rubl else suppl-gds.out-sum0-base)
     1742               free-sum0 = (if PrintRubl then suppl-gds.free-sum0-rubl else suppl-gds.free-sum0-base)
     1743               .
     1744           DISPLAY STREAM PrnLibStream
     1745               sym1 suppl-gds.artic
     1746               sym2 suppl-gds.gds-name
     1747               sym3 suppl-gds.unit-base
     1748               sym4 suppl-gds.in-qnty
     1749               sym5 in-sum0
     1750               sym6 suppl-gds.out-qnty
     1751               sym7 out-sum0
     1752               sym8 suppl-gds.free-qnty
     1753               sym9 free-sum0
     1754               sym10
     1755               with FRAME supp-gds .
     1756           DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1757           if Make-Excel then  put   stream ForExcel unformatted
     1758           suppl-gds.artic          CHR(9)
     1759           suppl-gds.gds-name       CHR(9)
     1760           suppl-gds.unit-base      CHR(9)
     1761           suppl-gds.in-qnty        CHR(9)
     1762           in-sum0                  CHR(9)
     1763           suppl-gds.out-qnty       CHR(9)
     1764           out-sum0                 CHR(9)
     1765           suppl-gds.free-qnty      CHR(9)
     1766           free-sum0
     1767           skip.
     1768           ACCUMULATE
     1769               suppl-gds.in-qnty (TOTAL)
     1770               in-sum0 (TOTAL)
     1771               suppl-gds.out-qnty (TOTAL)
     1772               out-sum0 (TOTAL)
     1773               suppl-gds.free-qnty (TOTAL)
     1774               free-sum0 (TOTAL)
     1775               .
     1776       END.
     1777   PUT STREAM PrnLibStream Line format "X(195)" SKIP.
     1778   DISPLAY STREAM PrnLibStream
     1779       "Итого" @ suppl-gds.unit-base
     1780       (ACCUM TOTAL suppl-gds.in-qnty) @ suppl-gds.in-qnty
     1781       (ACCUM TOTAL in-sum0) @ in-sum0
     1782       (ACCUM TOTAL suppl-gds.out-qnty) @ suppl-gds.out-qnty
     1783       (ACCUM TOTAL out-sum0) @ out-sum0
     1784       (ACCUM TOTAL suppl-gds.free-qnty) @ suppl-gds.free-qnty
     1785       (ACCUM TOTAL free-sum0) @ free-sum0
     1786       with FRAME supp-gds .
     1787   DOWN STREAM PrnLibStream 1 with FRAME supp-gds .
     1788   if Make-Excel then  put   stream ForExcel unformatted
     1789   "Итого"                                             CHR(9)
     1790                                                       CHR(9)
     1791                                                       CHR(9)
     1792   (ACCUM TOTAL suppl-gds.in-qnty)                     CHR(9)
     1793   (ACCUM TOTAL in-sum0)                               CHR(9)
     1794   (ACCUM TOTAL suppl-gds.out-qnty)                    CHR(9)
     1795   (ACCUM TOTAL out-sum0)                              CHR(9)
     1796   (ACCUM TOTAL suppl-gds.free-qnty)                   CHR(9)
     1797   (ACCUM TOTAL free-sum0)
     1798   skip.
     1799   HIDE STREAM PrnLibStream FRAME BottomFrame .
     1800   OUTPUT STREAM PrnLibStream CLOSE.
     1801   if Make-Excel then output stream ForExcel close.
     1802   if session:set-wait-state("") then.
     1803   run prn-lib-prn-file in this-procedure (
     1804                                             input parParentProc
     1805                                             ,input 8
     1806                                             ).
     1807   APPLY "ENTRY" TO BROWSE br-suppl.
     1808   END.
     1809   ON MOUSE-SELECT-DBLCLICK OF br-suppl IN FRAME v-suppl
     1810   DO:
     1811     APPLY "CHOOSE" TO b-parts IN FRAME v-suppl.
     1812   END.
     1813   ON RETURN OF br-suppl IN FRAME v-suppl
     1814   DO:
     1815     APPLY "CHOOSE" TO b-parts IN FRAME v-suppl.
     1816   END.
     1817   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-suppl:PARENT eq ?
     1818   THEN FRAME v-suppl:PARENT = ACTIVE-WINDOW.
     1819   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820   define variable varscales-pref18 as character no-undo .
     1821   define variable varpgscales-pref18 as character no-undo.
     1822   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1823   define variable varscales-pref-type19 as character no-undo.
     1824   varscales-pref18  = ?.
     1825   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1826     (input  'sclspref':u
     1827     ,input  '':u
     1828     ,input  '':u
     1829     ,input  0
     1830     ,input  '':u
     1831     ,input  '':u
     1832     ,input  '':u
     1833     ,input  no
     1834     ,output varscales-pref18
     1835     ,output varscales-pref-type19
     1836     ) no-error .
     1837   if varscales-pref18 = ? then do:
     1838     assign
     1839     varscales-pref18 = '21,23,25':U.
     1840   end.
     1841   define variable varpgscales-pref-type19 as character no-undo.
     1842   varpgscales-pref18  = ?.
     1843   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     1844     (input  'scpgpref':u
     1845     ,input  '':u
     1846     ,input  '':u
     1847     ,input  0
     1848     ,input  '':u
     1849     ,input  '':u
     1850     ,input  '':u
     1851     ,input  no
     1852     ,output varpgscales-pref18
     1853     ,output varpgscales-pref-type19
     1854     ) no-error .
     1855   if varpgscales-pref18 = ? then do:
     1856     assign
     1857     varpgscales-pref18 = '24IIIIIQQ000C,28IIIIIQQQ00C':U.
     1858   end.
     1859   on value-changed of a-n-c in frame v-suppl do:
     1860     run proc-valchg-a-n-c in this-procedure  no-error.
     1861     return no-apply.
     1862   end.
     1863   on any-printable of br-suppl in frame v-suppl do:
     1864     run proc-any-printable-br-suppl in this-procedure   no-error.
     1865     return no-apply.
     1866   end.
     1867   on backspace of br-suppl in frame v-suppl do:
     1868     run proc-backspace-br-suppl in this-procedure   no-error.
     1869     return no-apply.
     1870   end.
     1871   ON return OF loc-code IN FRAME v-suppl do:
     1872     run proc-mouse-dbl-click-loc-code in this-procedure   no-error.
     1873     return no-apply.
     1874   end.
     1875   ON return, Ctrl-J OF loc-name IN FRAME v-suppl do:
     1876     run proc-mouse-dbl-click-loc-name in this-procedure   no-error.
     1877     return no-apply.
     1878   end.
     1879   PROCEDURE proc-valchg-a-n-c:
     1880     case input frame v-suppl a-n-c :
     1881       when "art" then do:
     1882         apply "entry" to br-suppl in frame v-suppl.
     1883         hide loc-name loc-code
     1884         in frame v-suppl.
     1885         loc-art = "".
     1886       end.
     1887       when "name" then do:
     1888         enable loc-name with frame v-suppl.
     1889         disp loc-name with frame v-suppl.
     1890         hide loc-art loc-code
     1891         in frame v-suppl.
     1892         apply "entry" to loc-name in frame v-suppl.
     1893       end.
     1894       when "code"
     1895    or when "DataMatrix" then
     1896       do:
     1897         enable loc-code with frame v-suppl.
     1898         disp loc-code with frame v-suppl.
     1899         hide loc-art loc-name
     1900         in frame v-suppl.
     1901         apply "entry" to loc-code in frame v-suppl.
     1902       end.
     1903     end CASE.
     1904   END PROCEDURE.
     1905   PROCEDURE proc-any-printable-br-suppl :
     1906     if input frame v-suppl a-n-c = "art" then do:
     1907       if last-event:label = " " and
     1908          loc-art = "" then
     1909       return error.
     1910       find first l-suppl-gds where
     1911                   l-suppl-gds.artic begins (loc-art + last-event:label)
     1912                  no-lock no-error.
     1913       if available l-suppl-gds then do:
     1914         loc-art = loc-art + last-event:label.
     1915         disp loc-art with frame v-suppl.
     1916         line-rec = recid (l-suppl-gds).
     1917         reposition br-suppl to recid line-rec no-error.
     1918       end.
     1919     end.
     1920   END PROCEDURE.
     1921   PROCEDURE proc-backspace-br-suppl:
     1922     if input frame v-suppl a-n-c = "art" then do:
     1923       if loc-art = "" then
     1924         return error.
     1925       loc-art = substr (loc-art, 1, length (loc-art) - 1).
     1926       find first l-suppl-gds where
     1927                   l-suppl-gds.artic begins loc-art
     1928                  no-lock.
     1929       disp loc-art with frame v-suppl.
     1930       line-rec = recid (l-suppl-gds).
     1931       reposition br-suppl to recid line-rec no-error.
     1932     end.
     1933   END PROCEDURE.
     1934   PROCEDURE proc-mouse-dbl-click-loc-code:
     1935   def var str-code as integer no-undo.
     1936   define variable varresult   as character         no-undo.
     1937   define variable vartype-bc  as character         no-undo.
     1938   define variable varweight   as decimal           no-undo.
     1939   define buffer l-goods for ub.goods.
     1940   define buffer l-bar-code for ub.bar-code.
     1941   define buffer buf_bar-code for ub.bar-code .
     1942   define buffer buf_prod-bc for ub.prod-bc.
     1943   define buffer buf_place for ub.place.
     1944     assign
     1945     frame v-suppl
     1946     loc-code
     1947     a-n-c.
     1948     if a-n-c = "datamatrix"
     1949     then do:
     1950   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_dm-rcnz in g#libbcrcn
     1951   (
     1952    input  parparentproc
     1953   ,input  loc-code
     1954   ,input  ?
     1955   ,input  p-curr-obj-type
     1956   ,input  p-curr-obj-code
     1957   ,input  yes
     1958   ,input  no
     1959   ,input  varscales-pref18
     1960   ,input  varpgscales-pref18
     1961   ,output varresult
     1962   ,output vartype-bc
     1963   ,output varweight
     1964   ,buffer buf_bar-code
     1965   ,buffer buf_prod-bc
     1966   ,buffer buf_place
     1967   ) no-error.
     1968        if varresult eq "prod-bc"
     1969        then
     1970           loc-code:screen-value in frame v-suppl = buf_prod-bc.b-str.
     1971     end.
     1972     else do:
     1973   if (valid-handle(g#libbcrcn) <> true) then do:   run str/libbcrcn.p persistent no-error .   if error-status :error or (valid-handle(g#libbcrcn) <> true) then do:     message       "Error starting libbcrcn.p" skip       g#libbcrcn skip       g#libbcrcn :type skip       g#libbcrcn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run libbcrcn_bc-rcnz in g#libbcrcn
     1974   (
     1975    input  parparentproc
     1976   ,input  loc-code
     1977   ,input  ?
     1978   ,input  p-curr-obj-type
     1979   ,input  p-curr-obj-code
     1980   ,input  yes
     1981   ,input  no
     1982   ,input  varscales-pref18
     1983   ,input  varpgscales-pref18
     1984   ,output varresult
     1985   ,output vartype-bc
     1986   ,output varweight
     1987   ,buffer buf_bar-code
     1988   ,buffer buf_prod-bc
     1989   ,buffer buf_place
     1990   ) no-error.
     1991   end.
     1992     if available buf_bar-code then do:
     1993           find first l-goods where
     1994                     l-goods.gds-code =
     1995     buf_bar-code.gds-code No-LOCK.
     1996           find first l-suppl-gds where
     1997                     l-suppl-gds.artic = l-goods.artic AND
     1998                     l-suppl-gds.prod-type = l-goods.prod-type AND
     1999                     l-suppl-gds.prod-code = l-goods.prod-code no-lock no-error.
     2000       if available l-suppl-gds then do:
     2001         line-rec = recid (l-suppl-gds).
     2002         reposition br-suppl to recid line-rec no-error.
     2003       end.
     2004       else do:
     2005         message "Строка не найдена."
     2006                 view-as alert-box error.
     2007       end.
     2008     end.
     2009     else
     2010       message "Бар-код не найден."
     2011               view-as alert-box error.
     2012     apply "entry" to loc-code in frame v-suppl.
     2013   END PROCEDURE.
     2014   PROCEDURE  proc-mouse-dbl-click-loc-name:
     2015     assign
     2016     frame v-suppl
     2017     loc-name.
     2018       if last-event:label = "Ctrl-J" then
     2019         find next l-suppl-gds where
     2020                   can-find (ub.goods where ub.goods.artic = l-suppl-gds.artic and
     2021                   ub.goods.prod-type = l-suppl-gds.prod-type and
     2022                   ub.goods.prod-code = l-suppl-gds.prod-code and
     2023                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     2024       else
     2025         find first l-suppl-gds where
     2026                   can-find (ub.goods where ub.goods.artic = l-suppl-gds.artic and
     2027                   ub.goods.prod-type = l-suppl-gds.prod-type and
     2028                   ub.goods.prod-code = l-suppl-gds.prod-code and
     2029                   ub.goods.gds-name begins loc-name no-lock) no-lock no-error.
     2030       if available l-suppl-gds then do:
     2031         line-rec = recid (l-suppl-gds).
     2032         reposition br-suppl to recid line-rec no-error.
     2033       end.
     2034       else do:
     2035         message "Строка не найдена."
     2036                 view-as alert-box error.
     2037       end.
     2038     apply "entry" to loc-name in frame v-suppl.
     2039   END PROCEDURE.
     2040   on value-changed of br-suppl in frame v-suppl do:
     2041   if not available suppl-gds or recid (suppl-gds) <> line-rec then do:
     2042       hide loc-art in frame v-suppl.
     2043       loc-art = "".
     2044   end.
     2045   end.
     2046   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2047   on help of frame v-suppl
     2048   do:
     2049     run gbl/app_help.p
     2050       (input this-procedure :file-name
     2051       ,input ''
     2052       ,input ?
     2053       ) no-error.
     2054     if error-status :error then do:
     2055       message
     2056         "Ошибка при вызове помощи"
     2057         error-status :get-message(1)
     2058         view-as alert-box .
     2059     end.
     2060   end.
     2061   run minbtn-set in this-procedure .
     2062   on choose of b-help in frame v-suppl
     2063   do:
     2064     apply "help":u to frame v-suppl .
     2065   end.
     2066   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2067   procedure minbtn-set :
     2068       do
     2069           on error undo, return error return-value
     2070           :
     2071           define variable ii              as integer       no-undo .
     2072           define variable fh              as widget-handle no-undo .
     2073           define variable hh              as widget-handle no-undo .
     2074           define variable v-h             as handle        extent 4 no-undo .
     2075           define variable v-name-button   as character     no-undo .
     2076           define variable v-help-old-x    as decimal       no-undo .
     2077           define variable v-help-old-y    as decimal       no-undo .
     2078           define variable v-help-old-size as decimal       no-undo .
     2079           define variable v-frame-width   as decimal       no-undo .
     2080           define variable jj              as integer       no-undo .
     2081           do
     2082               on error undo, return error
     2083               :
     2084               assign
     2085                   v-frame-width = frame v-suppl:width - 0.3
     2086                   fh            = frame v-suppl:first-child
     2087                   hh            = fh:first-child
     2088                   ii            = 1
     2089                   .
     2090               do while valid-handle(hh):
     2091                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
     2092                   do:
     2093                       case lc(hh:name) :
     2094                           when "b-help" then
     2095                               do:
     2096                                   hh:load-image-up("cmp/b-help.bmp":u) .
     2097                                   hh:load-image-down("cmp/b-help.bmp":u) .
     2098                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
     2099                                   hh:TOOLTIP = "Помощь" .
     2100                                   v-help-old-x = hh:column .
     2101                                   v-help-old-y = hh:row    .
     2102                                   v-help-old-size = hh:width .
     2103                                   hh:width-chars = 2.5 .
     2104                               end.
     2105                           when "b-print" then
     2106                               do:
     2107                                   hh:load-image("cmp/b-print.bmp":u) .
     2108                                   hh:TOOLTIP = "Печать" .
     2109                                   v-h[ii] = hh:handle .
     2110                                   ii = ii + 1 .
     2111                                   hh:width-chars = 3 .
     2112                               end.
     2113                           when "b-history" or
     2114                           when "b-hist" then
     2115                               do:
     2116                                   hh:load-image("cmp/b-hist.bmp":u) .
     2117                                   hh:TOOLTIP = "История" .
     2118                                   v-h[ii] = hh:handle .
     2119                                   ii = ii + 1 .
     2120                                   hh:width-chars = 3 .
     2121                               end.
     2122                           when "b-sch" then
     2123                               do:
     2124                                   hh:load-image("cmp/b-sch.bmp":u) .
     2125                                   hh:TOOLTIP = "Установка Фильтра" .
     2126                                   v-h[ii] = hh:handle .
     2127                                   ii = ii + 1 .
     2128                                   hh:width-chars = 3 .
     2129                               end.
     2130                           when "b-hist-user" then
     2131                               do:
     2132                                   hh:load-image("cmp/b-hist.bmp":u) .
     2133                                   hh:TOOLTIP = "История пользователя" .
     2134                                   ii = ii + 1 .
     2135                               end.
     2136                       end case.
     2137                   end.
     2138                   hh = hh:next-sibling.
     2139               end.
     2140               b-help:column = v-frame-width - b-help:width-chars.
     2141               jj = 0.
     2142               repeat ii = 4 to 1 by -1 :
     2143                   if valid-handle (v-h[ii] ) then
     2144                   do:
     2145                       jj  = jj + 1 .
     2146                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     2147                       v-h[ii]:row    = v-help-old-y .
     2148                   end.
     2149               end.
     2150           end.
     2151       end.
     2152   end procedure.
     2153   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
     2154   define variable v-diasize-need-maximize        as logical   no-undo init true  .
     2155   define variable v-diasize-orig-frame-height    as decimal   no-undo .
     2156   define variable v-diasize-orig-frame-width     as decimal   no-undo .
     2157   define variable v-diasize-current-frame-width  as decimal   no-undo .
     2158   define variable v-diasize-current-frame-height as decimal   no-undo .
     2159   define variable v-diasize-change-size          as logical   no-undo .
     2160   define variable v-diasize-resize-button        as handle    no-undo .
     2161   define variable v-diasize-wndmax               as logical   no-undo .
     2162   define variable v-diasize-wndstore             as logical   no-undo .
     2163   define variable v-diasize-proc-name            as character no-undo .
     2164   define variable v-diasize-browse-handle        as handle    no-undo .
     2165   define variable v-diasize-browse-number        as integer   no-undo .
     2166   define variable v-diasize-need-full-display    as logical   no-undo init false .
     2167   define temp-table temp-diasize-handle no-undo
     2168     field handle-value  as handle
     2169     field save-position as decimal
     2170     index xpk is primary unique handle-value
     2171     .
     2172   define temp-table temp-browse-handle no-undo
     2173     field browse-type   as character
     2174     field browse-number as integer
     2175     field browse-handle as handle
     2176     field original-size as decimal
     2177     index xpk is primary unique browse-type browse-number
     2178     index xie browse-type browse-handle
     2179   .
     2180   procedure diasize_change-height :
     2181     define input  parameter p-change-value  as decimal   no-undo .
     2182     define input  parameter p-move-resize   as logical   no-undo .
     2183     define variable v-field-group-handle    as handle    no-undo .
     2184     define variable v-object-handle         as handle    no-undo .
     2185     define variable v-frame-height          as decimal   no-undo .
     2186     define variable v-frame-virtual-height  as decimal   no-undo .
     2187     define variable v-browse-height         as decimal   no-undo .
     2188     define variable v-window-height         as decimal   no-undo .
     2189     define variable v-window-virtual-height as decimal   no-undo .
     2190     define variable v-change-sign           as integer   no-undo .
     2191     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2192     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2193     if p-change-value > 0
     2194     then do:
     2195       if frame v-suppl :height + p-change-value
     2196           > decimal(session :work-area-height-pixels) / session :pixels-per-row
     2197       then do:
     2198         assign
     2199           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
     2200                           - (frame v-suppl :height-chars)
     2201         .
     2202         if p-change-value <= 0
     2203         then do:
     2204           run diasize_position-resize-button in this-procedure .
     2205           return .
     2206         end.
     2207       end.
     2208     end.
     2209     if p-change-value < 0
     2210     then do:
     2211       if frame v-suppl :height + p-change-value < v-diasize-orig-frame-height
     2212       then do:
     2213         assign
     2214           p-change-value = v-diasize-orig-frame-height
     2215                          - (frame v-suppl :height-chars)
     2216         .
     2217         if p-change-value >= 0
     2218         then do:
     2219           run diasize_position-resize-button in this-procedure .
     2220           return .
     2221         end.
     2222       end.
     2223     end.
     2224     if p-change-value >= 0
     2225     then do:
     2226       assign
     2227         v-change-sign = 1
     2228       .
     2229     end.
     2230     else do:
     2231       assign
     2232         v-change-sign = -1
     2233       .
     2234     end.
     2235     assign
     2236       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2237     .
     2238     if p-change-value = 0
     2239     then do:
     2240       run diasize_position-resize-button in this-procedure .
     2241       return .
     2242     end.
     2243     move_block:
     2244     do
     2245     on error undo move_block, retry move_block
     2246     :
     2247       if retry
     2248       then do:
     2249         do
     2250         on error undo move_block, leave move_block
     2251         :
     2252           if p-change-value > 0
     2253           then do:
     2254             for each buf_temp-diasize-handle
     2255             on error undo, next
     2256             :
     2257               assign
     2258                 v-object-handle = buf_temp-diasize-handle.handle-value
     2259               .
     2260               if v-object-handle <> v-diasize-resize-button
     2261               then do:
     2262                 assign
     2263                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2264                 .
     2265               end.
     2266             end.
     2267             assign
     2268               v-diasize-browse-handle :height = v-browse-height
     2269             .
     2270             for each buf_temp-browse-handle
     2271               where buf_temp-browse-handle.browse-type = 'height':u
     2272             on error undo, next
     2273             :
     2274               assign
     2275                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2276               .
     2277             end.
     2278             assign
     2279               frame v-suppl :height = v-frame-height
     2280             .
     2281             if frame v-suppl :scrollable = true
     2282             then do:
     2283               assign
     2284                 frame v-suppl :virtual-height = v-frame-virtual-height
     2285               .
     2286             end.
     2287             run diasize_position-resize-button in this-procedure .
     2288           end.
     2289           else do:
     2290             if frame v-suppl :scrollable = true
     2291             then do:
     2292               assign
     2293                 frame v-suppl :virtual-height = v-frame-virtual-height
     2294               .
     2295             end.
     2296             assign
     2297               frame v-suppl :height = v-frame-height
     2298             .
     2299             assign
     2300               v-diasize-browse-handle :height = v-browse-height
     2301             .
     2302             for each buf_temp-browse-handle
     2303               where buf_temp-browse-handle.browse-type = 'height':u
     2304             on error undo, next
     2305             :
     2306               assign
     2307                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
     2308               .
     2309             end.
     2310             for each buf_temp-diasize-handle
     2311             on error undo, next
     2312             :
     2313               assign
     2314                 v-object-handle = buf_temp-diasize-handle.handle-value
     2315               .
     2316               if v-object-handle <> v-diasize-resize-button
     2317               then do:
     2318                 assign
     2319                   v-object-handle :row = buf_temp-diasize-handle.save-position
     2320                 .
     2321               end.
     2322             end.
     2323             run diasize_position-resize-button in this-procedure .
     2324           end.
     2325           assign
     2326             v-diasize-change-size = false
     2327           .
     2328           leave move_block .
     2329         end.
     2330       end.
     2331       assign
     2332         v-diasize-need-full-display = true
     2333       .
     2334       if v-diasize-change-size = false
     2335       then do:
     2336         assign
     2337           v-diasize-change-size = true
     2338         .
     2339       end.
     2340       else do:
     2341         return .
     2342       end.
     2343       assign
     2344         v-frame-height = frame v-suppl :height
     2345         v-frame-virtual-height = frame v-suppl :virtual-height
     2346         v-browse-height = v-diasize-browse-handle :height
     2347       .
     2348       for each buf_temp-browse-handle
     2349         where buf_temp-browse-handle.browse-type = 'height':u
     2350       :
     2351         assign
     2352           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
     2353         .
     2354       end.
     2355       for each buf_temp-diasize-handle
     2356       :
     2357         delete buf_temp-diasize-handle .
     2358       end.
     2359       assign
     2360         v-field-group-handle = frame v-suppl :first-child
     2361       .
     2362       do while valid-handle(v-field-group-handle)
     2363       :
     2364         assign
     2365           v-object-handle = v-field-group-handle :first-child
     2366         .
     2367         do while valid-handle(v-object-handle)
     2368         :
     2369           if  v-object-handle <> v-diasize-browse-handle :handle
     2370           and can-query(v-object-handle, "row")
     2371           and can-query(v-object-handle, "height")
     2372           and ( v-object-handle :row > v-diasize-browse-handle :row )
     2373           then do:
     2374             find first buf_temp-browse-handle
     2375               where buf_temp-browse-handle.browse-type   = 'height':u
     2376                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2377               no-error .
     2378             if available buf_temp-browse-handle
     2379             then do:
     2380             end.
     2381             else do:
     2382               create buf_temp-diasize-handle .
     2383               assign
     2384                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2385                 buf_temp-diasize-handle.save-position = v-object-handle :row
     2386               .
     2387             end.
     2388           end.
     2389           assign
     2390             v-object-handle = v-object-handle :next-sibling
     2391           .
     2392         end.
     2393         assign
     2394           v-field-group-handle = v-field-group-handle :next-sibling
     2395         .
     2396       end.
     2397       do with frame v-suppl
     2398       :
     2399         hide v-diasize-resize-button .
     2400         assign
     2401           v-diasize-resize-button :row    = 1
     2402           v-diasize-resize-button :column = 1
     2403         .
     2404       end.
     2405       if p-change-value > 0
     2406       then do:
     2407         if frame v-suppl :scrollable = true
     2408         then do:
     2409           assign
     2410             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     2411             no-error .
     2412           if error-status :error
     2413           or error-status :get-message(1) <> ""
     2414           then do:
     2415             undo move_block, retry move_block .
     2416           end.
     2417         end.
     2418         assign
     2419           frame v-suppl :height = frame v-suppl :height + p-change-value
     2420           no-error .
     2421         if error-status :error
     2422         or error-status :get-message(1) <> ""
     2423         then do:
     2424           undo move_block, retry move_block .
     2425         end.
     2426         assign
     2427           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2428           no-error .
     2429         if error-status :error
     2430         or error-status :get-message(1) <> ""
     2431         then do:
     2432           undo move_block, retry move_block .
     2433         end.
     2434         for each buf_temp-browse-handle
     2435           where buf_temp-browse-handle.browse-type = 'height':u
     2436         on error undo move_block, retry move_block
     2437         :
     2438           assign
     2439             buf_temp-browse-handle.browse-handle :height
     2440               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2441             no-error .
     2442           if error-status :error
     2443           or error-status :get-message(1) <> ""
     2444           then do:
     2445             undo move_block, retry move_block .
     2446           end.
     2447         end.
     2448         for each buf_temp-diasize-handle
     2449         on error undo move_block, retry move_block
     2450         :
     2451           assign
     2452             v-object-handle = buf_temp-diasize-handle.handle-value
     2453           .
     2454           if v-object-handle <> v-diasize-resize-button
     2455           then do:
     2456             assign
     2457               v-object-handle :row = v-object-handle :row + p-change-value
     2458               no-error .
     2459             if error-status :error
     2460             or error-status :get-message(1) <> ""
     2461             then do:
     2462               undo move_block, retry move_block .
     2463             end.
     2464           end.
     2465         end.
     2466       end.
     2467       else do:
     2468         for each buf_temp-diasize-handle
     2469         on error undo move_block, retry move_block
     2470         :
     2471           assign
     2472             v-object-handle = buf_temp-diasize-handle.handle-value
     2473           .
     2474           if v-object-handle <> v-diasize-resize-button
     2475           then do:
     2476             assign
     2477               v-object-handle :row = v-object-handle :row + p-change-value
     2478               no-error .
     2479             if error-status :error
     2480             or error-status :get-message(1) <> ""
     2481             then do:
     2482               undo move_block, retry move_block .
     2483             end.
     2484           end.
     2485         end.
     2486         assign
     2487           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     2488           no-error .
     2489         if error-status :error
     2490         or error-status :get-message(1) <> ""
     2491         then do:
     2492           undo move_block, retry move_block .
     2493         end.
     2494         for each buf_temp-browse-handle
     2495           where buf_temp-browse-handle.browse-type = 'height':u
     2496         on error undo move_block, retry move_block
     2497         :
     2498           assign
     2499             buf_temp-browse-handle.browse-handle :height
     2500               = buf_temp-browse-handle.browse-handle :height + p-change-value
     2501             no-error .
     2502           if error-status :error
     2503           or error-status :get-message(1) <> ""
     2504           then do:
     2505             undo move_block, retry move_block .
     2506           end.
     2507         end.
     2508         assign
     2509           frame v-suppl :height = frame v-suppl :height + p-change-value
     2510           no-error .
     2511         if error-status :error
     2512         or error-status :get-message(1) <> ""
     2513         then do:
     2514           undo move_block, retry move_block .
     2515         end.
     2516         if frame v-suppl :scrollable = true
     2517         then do:
     2518           assign
     2519             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
     2520             no-error .
     2521           if error-status :error
     2522           or error-status :get-message(1) <> ""
     2523           then do:
     2524             undo move_block, retry move_block .
     2525           end.
     2526         end.
     2527       end.
     2528       if p-move-resize = true
     2529       then do:
     2530         run diasize_position-resize-button in this-procedure .
     2531       end.
     2532       if v-diasize-wndstore = true
     2533       then do:
     2534         if connected("ub") = true
     2535         then do:
     2536           define variable v-cntxt-db-num        as integer   no-undo .
     2537           define variable v-cntxt-userid        as character no-undo .
     2538           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2539                                             , OUTPUT v-cntxt-userid
     2540                                             ) .
     2541           run gbl/wndsizew.p
     2542             (input  v-cntxt-db-num
     2543             ,input  v-cntxt-userid
     2544             ,input  v-diasize-proc-name
     2545             ,input  'height':u
     2546             ,input  string(frame v-suppl :height - v-diasize-orig-frame-height)
     2547             ) .
     2548         end.
     2549       end.
     2550     end.
     2551     assign
     2552       v-diasize-change-size = false
     2553     .
     2554   end procedure.
     2555   procedure diasize_set-height :
     2556     define input  parameter p-new-height  as decimal   no-undo .
     2557     define input  parameter p-move-resize as logical   no-undo .
     2558     do
     2559     on error undo, return error return-value
     2560     :
     2561       run diasize_change-height in this-procedure
     2562         (input  (p-new-height - frame v-suppl :height)
     2563         ,input  p-move-resize
     2564         ) .
     2565     end.
     2566   end procedure.
     2567   procedure diasize_change-width :
     2568     define input  parameter p-change-value as decimal   no-undo .
     2569     define input  parameter p-move-resize  as logical   no-undo .
     2570     define variable v-field-group-handle   as handle    no-undo .
     2571     define variable v-object-handle        as handle    no-undo .
     2572     define variable v-frame-width          as decimal   no-undo .
     2573     define variable v-frame-virtual-width  as decimal   no-undo .
     2574     define variable v-browse-width         as decimal   no-undo .
     2575     define variable v-window-width         as decimal   no-undo .
     2576     define variable v-window-virtual-width as decimal   no-undo .
     2577     define variable v-change-sign          as integer   no-undo .
     2578     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     2579     define buffer buf_temp-browse-handle  for temp-browse-handle .
     2580     if p-change-value > 0
     2581     then do:
     2582       if frame v-suppl :width + p-change-value >
     2583           session :width-chars
     2584       then do:
     2585         assign
     2586           p-change-value = session :width-chars - frame v-suppl :width
     2587         .
     2588         if p-change-value <= 0
     2589         then do:
     2590           run diasize_position-resize-button in this-procedure .
     2591           return .
     2592         end.
     2593       end.
     2594     end.
     2595     if p-change-value < 0
     2596     then do:
     2597       if frame v-suppl :width + p-change-value < v-diasize-orig-frame-width
     2598       then do:
     2599         assign
     2600           p-change-value = v-diasize-orig-frame-width
     2601                          - frame v-suppl :width
     2602         .
     2603         if p-change-value >= 0
     2604         then do:
     2605           run diasize_position-resize-button in this-procedure .
     2606           return .
     2607         end.
     2608       end.
     2609     end.
     2610     if p-change-value >= 0
     2611     then do:
     2612       assign
     2613         v-change-sign = 1
     2614       .
     2615     end.
     2616     else do:
     2617       assign
     2618         v-change-sign = -1
     2619       .
     2620     end.
     2621     assign
     2622       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     2623     .
     2624     if p-change-value = 0
     2625     then do:
     2626       run diasize_position-resize-button in this-procedure .
     2627       return .
     2628     end.
     2629     move_block:
     2630     do
     2631     on error undo move_block, leave move_block
     2632     :
     2633       if retry
     2634       then do:
     2635         do
     2636         on error undo move_block, leave move_block
     2637         :
     2638           if p-change-value > 0
     2639           then do:
     2640             for each buf_temp-diasize-handle
     2641             on error undo, next
     2642             :
     2643               assign
     2644                 v-object-handle = buf_temp-diasize-handle.handle-value
     2645               .
     2646               if v-object-handle <> v-diasize-resize-button
     2647               then do:
     2648                 assign
     2649                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2650                 .
     2651               end.
     2652             end.
     2653             assign
     2654               v-diasize-browse-handle :width = v-browse-width
     2655             .
     2656             for each buf_temp-browse-handle
     2657               where buf_temp-browse-handle.browse-type = 'width':u
     2658             on error undo, next
     2659             :
     2660               assign
     2661                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2662               .
     2663             end.
     2664             assign
     2665               frame v-suppl :width = v-frame-width
     2666             .
     2667             if frame v-suppl :scrollable = true
     2668             then do:
     2669               assign
     2670                 frame v-suppl :virtual-width = v-frame-virtual-width
     2671               .
     2672             end.
     2673             run diasize_position-resize-button in this-procedure .
     2674           end.
     2675           else do:
     2676             if frame v-suppl :scrollable = true
     2677             then do:
     2678               assign
     2679                 frame v-suppl :virtual-width = v-frame-virtual-width
     2680               .
     2681             end.
     2682             assign
     2683               frame v-suppl :width = v-frame-width
     2684             .
     2685             for each buf_temp-browse-handle
     2686               where buf_temp-browse-handle.browse-type = 'width':u
     2687             on error undo, next
     2688             :
     2689               assign
     2690                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     2691               .
     2692             end.
     2693             assign
     2694               v-diasize-browse-handle :width = v-browse-width
     2695             .
     2696             for each buf_temp-diasize-handle
     2697             on error undo, next
     2698             :
     2699               assign
     2700                 v-object-handle = buf_temp-diasize-handle.handle-value
     2701               .
     2702               if v-object-handle <> v-diasize-resize-button
     2703               then do:
     2704                 assign
     2705                   v-object-handle :col = buf_temp-diasize-handle.save-position
     2706                 .
     2707               end.
     2708             end.
     2709             run diasize_position-resize-button in this-procedure .
     2710           end.
     2711           assign
     2712             v-diasize-change-size = false
     2713           .
     2714           leave move_block .
     2715         end.
     2716       end.
     2717       assign
     2718         v-diasize-need-full-display = true
     2719       .
     2720       if v-diasize-change-size = false
     2721       then do:
     2722         assign
     2723           v-diasize-change-size = true
     2724         .
     2725       end.
     2726       else do:
     2727         return .
     2728       end.
     2729       assign
     2730         v-frame-width = frame v-suppl :width
     2731         v-frame-virtual-width = frame v-suppl :virtual-width
     2732         v-browse-width = v-diasize-browse-handle :width
     2733       .
     2734       for each buf_temp-browse-handle
     2735         where buf_temp-browse-handle.browse-type = 'width':u
     2736       :
     2737         assign
     2738           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     2739         .
     2740       end.
     2741       for each buf_temp-diasize-handle
     2742       :
     2743         delete buf_temp-diasize-handle .
     2744       end.
     2745       assign
     2746         v-field-group-handle = frame v-suppl :first-child
     2747       .
     2748       do while valid-handle(v-field-group-handle)
     2749       :
     2750         assign
     2751           v-object-handle = v-field-group-handle :first-child
     2752         .
     2753         do while valid-handle(v-object-handle)
     2754         :
     2755           if  v-object-handle <> v-diasize-browse-handle :handle
     2756           and v-object-handle <> v-diasize-resize-button
     2757           and can-query(v-object-handle, "row")
     2758           and can-query(v-object-handle, "height")
     2759           and ( v-object-handle :col + v-object-handle :width
     2760                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     2761               )
     2762           then do:
     2763             find first buf_temp-browse-handle
     2764               where buf_temp-browse-handle.browse-type   = 'width':u
     2765                 and buf_temp-browse-handle.browse-handle = v-object-handle
     2766               no-error .
     2767             if available buf_temp-browse-handle
     2768             then do:
     2769             end.
     2770             else do:
     2771               create buf_temp-diasize-handle .
     2772               assign
     2773                 buf_temp-diasize-handle.handle-value  = v-object-handle
     2774                 buf_temp-diasize-handle.save-position = v-object-handle :col
     2775               .
     2776             end.
     2777           end.
     2778           assign
     2779             v-object-handle = v-object-handle :next-sibling
     2780           .
     2781         end.
     2782         assign
     2783           v-field-group-handle = v-field-group-handle :next-sibling
     2784         .
     2785       end.
     2786       do with frame v-suppl
     2787       :
     2788         hide v-diasize-resize-button .
     2789         v-diasize-resize-button :row = 1.
     2790         v-diasize-resize-button :column = 1.
     2791       end.
     2792       if p-change-value > 0
     2793       then do:
     2794         if frame v-suppl :scrollable = true
     2795         then do:
     2796           assign
     2797             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     2798             no-error .
     2799           if error-status :error
     2800           or error-status :get-message(1) <> ""
     2801           then do:
     2802             undo move_block, retry move_block.
     2803           end.
     2804         end.
     2805         assign
     2806           frame v-suppl :width = v-frame-width + p-change-value
     2807           no-error .
     2808         if error-status :error
     2809         or error-status :get-message(1) <> ""
     2810         then do:
     2811           undo move_block, retry move_block.
     2812         end.
     2813         assign
     2814           v-diasize-browse-handle :width = v-browse-width + p-change-value
     2815         no-error .
     2816         if error-status :error
     2817         or error-status :get-message(1) <> ""
     2818         then do:
     2819           undo move_block, retry move_block.
     2820         end.
     2821         for each buf_temp-browse-handle
     2822           where buf_temp-browse-handle.browse-type = 'width':u
     2823         on error undo move_block, retry move_block
     2824         :
     2825           assign
     2826             buf_temp-browse-handle.browse-handle :width
     2827               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2828             no-error .
     2829           if error-status :error
     2830           or error-status :get-message(1) <> ""
     2831           then do:
     2832             undo move_block, retry move_block .
     2833           end.
     2834         end.
     2835         for each buf_temp-diasize-handle
     2836         on error undo move_block, retry move_block
     2837         :
     2838           assign
     2839             v-object-handle = buf_temp-diasize-handle.handle-value
     2840           .
     2841           if v-object-handle <> v-diasize-resize-button
     2842           then do:
     2843             assign
     2844               v-object-handle :col = v-object-handle :col + p-change-value
     2845               no-error .
     2846             if error-status :error
     2847             or error-status :get-message(1) <> ""
     2848             then do:
     2849               undo move_block, retry move_block .
     2850             end.
     2851           end.
     2852         end.
     2853       end.
     2854       else do:
     2855         for each buf_temp-diasize-handle
     2856         on error undo move_block, retry move_block
     2857         :
     2858           assign
     2859             v-object-handle = buf_temp-diasize-handle.handle-value
     2860           .
     2861           if v-object-handle <> v-diasize-resize-button
     2862           then do:
     2863             assign
     2864               v-object-handle :col = v-object-handle :col + p-change-value
     2865               no-error .
     2866             if error-status :error
     2867             or error-status :get-message(1) <> ""
     2868             then do:
     2869               undo move_block, retry move_block .
     2870             end.
     2871           end.
     2872         end.
     2873         for each buf_temp-browse-handle
     2874           where buf_temp-browse-handle.browse-type = 'width':u
     2875         on error undo move_block, retry move_block
     2876         :
     2877           assign
     2878             buf_temp-browse-handle.browse-handle :width
     2879               = buf_temp-browse-handle.browse-handle :width + p-change-value
     2880             no-error .
     2881           if error-status :error
     2882           or error-status :get-message(1) <> ""
     2883           then do:
     2884             undo move_block, retry move_block .
     2885           end.
     2886         end.
     2887         assign
     2888           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     2889           no-error .
     2890         if error-status :error
     2891         or error-status :get-message(1) <> ""
     2892         then do:
     2893           undo move_block, retry move_block.
     2894         end.
     2895         assign
     2896           frame v-suppl :width = frame v-suppl :width + p-change-value
     2897         no-error .
     2898         if error-status :error
     2899         or error-status :get-message(1) <> ""
     2900         then do:
     2901           undo move_block, retry move_block.
     2902         end.
     2903         if frame v-suppl :scrollable = true
     2904         then do:
     2905           assign
     2906             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     2907           no-error .
     2908           if error-status :error
     2909           or error-status :get-message(1) <> ""
     2910           then do:
     2911             undo move_block, retry move_block.
     2912           end.
     2913         end.
     2914       end.
     2915       if p-move-resize
     2916       then do:
     2917         run diasize_position-resize-button in this-procedure .
     2918       end.
     2919       if v-diasize-wndstore = true
     2920       then do:
     2921         if connected("ub") = true
     2922         then do:
     2923           define variable v-cntxt-db-num        as integer   no-undo .
     2924           define variable v-cntxt-userid        as character no-undo .
     2925           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     2926                                             , OUTPUT v-cntxt-userid
     2927                                             ) .
     2928           run gbl/wndsizew.p
     2929             (input  v-cntxt-db-num
     2930             ,input  v-cntxt-userid
     2931             ,input  v-diasize-proc-name
     2932             ,input  'width':u
     2933             ,input  string(frame v-suppl :width - v-diasize-orig-frame-width)
     2934             ) .
     2935         end.
     2936       end.
     2937     end.
     2938     assign
     2939       v-diasize-change-size = false
     2940     .
     2941   end procedure.
     2942   procedure diasize_set-width :
     2943     define input  parameter p-new-width  as decimal   no-undo .
     2944     define input  parameter p-move-resize as logical   no-undo .
     2945     do
     2946     on error undo, return error return-value
     2947     :
     2948       run diasize_change-width in this-procedure
     2949         (input  (p-new-width - frame v-suppl :width)
     2950         ,input  p-move-resize
     2951         ) .
     2952     end.
     2953   end procedure.
     2954   procedure diasize_position-resize-button :
     2955     do with frame v-suppl
     2956     :
     2957       hide v-diasize-resize-button .
     2958       assign
     2959         v-diasize-resize-button :row = frame v-suppl :height - v-diasize-resize-button :height
     2960                     - 1
     2961                     - (frame v-suppl :border-bottom-pixels / session :pixels-per-row)
     2962         v-diasize-resize-button :col = frame v-suppl :width - v-diasize-resize-button :width
     2963                     - 1
     2964                     - (frame v-suppl :border-right-pixels / session :pixels-per-column)
     2965       .
     2966       view v-diasize-resize-button .
     2967     end.
     2968   end procedure.
     2969   on alt-right anywhere
     2970   do:
     2971     run diasize_change-width in this-procedure
     2972       (input 1
     2973       ,input true
     2974       ) .
     2975     return no-apply .
     2976   end.
     2977   on alt-left anywhere
     2978   do:
     2979     run diasize_change-width in this-procedure
     2980       (input -1
     2981       ,input true
     2982       ) .
     2983     return no-apply .
     2984   end.
     2985   on alt-down anywhere
     2986   do:
     2987     run diasize_change-height in this-procedure
     2988       (input 1
     2989       ,input true
     2990       ) .
     2991     return no-apply .
     2992   end.
     2993   on alt-up anywhere
     2994   do:
     2995     run diasize_change-height in this-procedure
     2996       (input -1
     2997       ,input true
     2998       ) .
     2999     return no-apply .
     3000   end.
     3001   on alt-enter of frame v-suppl
     3002   do:
     3003     run diasize_maximize in this-procedure
     3004       (input  ?
     3005       ).
     3006     return no-apply .
     3007   end.
     3008   procedure diasize_end-move :
     3009     do
     3010     on error undo, return error return-value
     3011     :
     3012       define variable v-row-delta as decimal   no-undo .
     3013       define variable v-col-delta as decimal   no-undo .
     3014       define variable v-new-row as decimal   no-undo .
     3015       define variable v-new-col as decimal   no-undo .
     3016       assign
     3017         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     3018         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     3019       .
     3020       assign
     3021         v-row-delta = v-new-row - frame v-suppl :height
     3022         v-col-delta = v-new-col - frame v-suppl :width
     3023       .
     3024       run diasize_change-height in this-procedure
     3025         (input v-row-delta
     3026         ,input true
     3027         ) .
     3028       run diasize_change-width in this-procedure
     3029         (input v-col-delta
     3030         ,input true
     3031         ) .
     3032     end.
     3033   end procedure.
     3034   procedure diasize_maximize :
     3035     define input  parameter p-action as logical   no-undo .
     3036     do
     3037     on error undo, return error return-value
     3038     :
     3039       if p-action = ?
     3040       then do:
     3041         if v-diasize-need-maximize = true
     3042         then do:
     3043           assign
     3044             p-action = true
     3045           .
     3046         end.
     3047         else do:
     3048           assign
     3049             p-action = false
     3050           .
     3051         end.
     3052       end.
     3053       if p-action = true
     3054       then do:
     3055         run diasize_change-height in this-procedure
     3056           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     3057               - frame v-suppl :height-chars
     3058           ,input true
     3059           ) .
     3060         run diasize_change-width in this-procedure
     3061           (input session :width-chars
     3062               - frame v-suppl :width-chars
     3063           ,input true
     3064           ) .
     3065         assign
     3066           v-diasize-need-maximize = false
     3067         .
     3068       end.
     3069       else do:
     3070         run diasize_change-width in this-procedure
     3071           (input v-diasize-orig-frame-width
     3072               - frame v-suppl :width-chars
     3073           ,input true
     3074           ) .
     3075         run diasize_change-height in this-procedure
     3076           (input v-diasize-orig-frame-height
     3077               - frame v-suppl :height-chars
     3078           ,input true
     3079           ) .
     3080         assign
     3081           v-diasize-need-maximize = true
     3082         .
     3083       end.
     3084     end.
     3085   end procedure.
     3086   procedure diasize_restore-orig-size :
     3087     do
     3088     on error undo, return error return-value
     3089     :
     3090       assign
     3091         v-diasize-current-frame-width  = frame v-suppl :width
     3092         v-diasize-current-frame-height = frame v-suppl :height
     3093       .
     3094       run diasize_set-height in this-procedure
     3095         (input  v-diasize-orig-frame-height
     3096         ,input  true
     3097         ) .
     3098       run diasize_set-width in this-procedure
     3099         (input  v-diasize-orig-frame-width
     3100         ,input  true
     3101         ) .
     3102     end.
     3103   end procedure.
     3104   procedure diasize_restore-current-size :
     3105     do
     3106     on error undo, return error return-value
     3107     :
     3108       run diasize_set-height in this-procedure
     3109         (input  v-diasize-current-frame-height
     3110         ,input  true
     3111         ) .
     3112       run diasize_set-width in this-procedure
     3113         (input  v-diasize-current-frame-width
     3114         ,input  true
     3115         ) .
     3116     end.
     3117   end procedure.
     3118   procedure diasize_set-browse-handle :
     3119     define input  parameter p-browse-handle as handle   no-undo .
     3120     define buffer buf_temp-browse-handle for temp-browse-handle .
     3121     do
     3122     on error undo, return error return-value
     3123     :
     3124       assign
     3125         v-diasize-browse-handle = p-browse-handle
     3126       .
     3127       for each buf_temp-browse-handle
     3128       on error undo, return error return-value
     3129       :
     3130         delete buf_temp-browse-handle .
     3131       end.
     3132     end.
     3133   end procedure.
     3134   procedure diasize_add_browse :
     3135     define input  parameter p-browse-type   as character no-undo .
     3136     define input  parameter p-browse-handle as handle    no-undo .
     3137     define buffer buf_temp-browse-handle for temp-browse-handle .
     3138     do
     3139     on error undo, return error return-value
     3140     :
     3141       assign
     3142         v-diasize-browse-number = v-diasize-browse-number + 1
     3143       .
     3144       create buf_temp-browse-handle .
     3145       assign
     3146         buf_temp-browse-handle.browse-type   = p-browse-type
     3147         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     3148         buf_temp-browse-handle.browse-handle = p-browse-handle
     3149       .
     3150     end.
     3151   end procedure.
     3152   procedure diasize_init :
     3153     define variable v-default-value    as logical   no-undo .
     3154     define variable v-restore-saved    as logical   no-undo .
     3155     define variable v-resize-value-str as character no-undo .
     3156     do
     3157     on error undo, return error return-value
     3158     :
     3159       do with frame v-suppl
     3160       :
     3161         assign
     3162           v-diasize-orig-frame-height = frame v-suppl :height
     3163           v-diasize-orig-frame-width  = frame v-suppl :width
     3164           v-diasize-browse-handle     = browse br-suppl :handle
     3165         .
     3166         create button v-diasize-resize-button
     3167         assign
     3168           parent        = frame v-suppl :first-child
     3169           label         = "s"
     3170           height-pixels = 16
     3171           width-pixels  = 16
     3172           visible       = true
     3173           sensitive     = true
     3174           movable       = true
     3175           triggers:
     3176             on end-move persistent run diasize_end-move in this-procedure .
     3177           end triggers.
     3178         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     3179         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     3180         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     3181         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     3182         assign
     3183           v-diasize-wndmax = false
     3184         .
     3185         if connected("ub") = true
     3186         then do:
     3187           define variable v-cntxt-db-num        as integer   no-undo .
     3188           define variable v-cntxt-userid        as character no-undo .
     3189           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     3190                                             , OUTPUT v-cntxt-userid
     3191                                             ) .
     3192           run gbl/wndpar_r.p
     3193             (input  v-cntxt-db-num
     3194             ,input  v-cntxt-userid
     3195             ,input  'wndmax':U
     3196             ,output v-diasize-wndmax
     3197             ,output v-default-value
     3198             ) .
     3199         end.
     3200         assign
     3201           v-diasize-wndstore = false
     3202         .
     3203         if connected("ub") = true
     3204         then do:
     3205           run gbl/wndpar_r.p
     3206             (input  v-cntxt-db-num
     3207             ,input  v-cntxt-userid
     3208             ,input  'wndstore':U
     3209             ,output v-diasize-wndstore
     3210             ,output v-default-value
     3211             ) .
     3212         end.
     3213         assign
     3214           v-diasize-proc-name = entry(1, program-name(2), '.')
     3215         .
     3216         if v-diasize-wndstore = true
     3217         then do:
     3218           assign
     3219             v-restore-saved = false
     3220           .
     3221           if connected("ub") = true
     3222           then do:
     3223             run gbl/wndsizer.p
     3224               (input  v-cntxt-db-num
     3225               ,input  v-cntxt-userid
     3226               ,input  v-diasize-proc-name
     3227               ,input  'height':u
     3228               ,output v-resize-value-str
     3229               ) .
     3230             if v-resize-value-str <> '':U
     3231             then do:
     3232               run diasize_change-height in this-procedure
     3233                 (input  integer(v-resize-value-str)
     3234                 ,input  true
     3235                 ) .
     3236               assign
     3237                 v-restore-saved = true
     3238               .
     3239             end.
     3240           end.
     3241           if connected("ub") = true
     3242           then do:
     3243             run gbl/wndsizer.p
     3244               (input  v-cntxt-db-num
     3245               ,input  v-cntxt-userid
     3246               ,input  v-diasize-proc-name
     3247               ,input  'width':u
     3248               ,output v-resize-value-str
     3249               ) .
     3250             if v-resize-value-str <> '':U
     3251             then do:
     3252               run diasize_change-width in this-procedure
     3253                 (input  integer(v-resize-value-str)
     3254                 ,input  true
     3255                 ) .
     3256               assign
     3257                 v-restore-saved = true
     3258               .
     3259             end.
     3260           end.
     3261           if v-restore-saved <> true
     3262           then do:
     3263             if v-diasize-wndmax = true
     3264             then do:
     3265               run diasize_maximize in this-procedure
     3266                 (input  true
     3267                 ) .
     3268             end.
     3269           end.
     3270         end.
     3271         else do:
     3272           if v-diasize-wndmax = true
     3273           then do:
     3274             run diasize_maximize in this-procedure
     3275               (input  true
     3276               ) .
     3277           end.
     3278         end.
     3279       end.
     3280     end.
     3281   end procedure.
     3282   procedure diasize_need-full-display :
     3283     define output parameter p-need-full-display as logical   no-undo .
     3284     do
     3285     on error undo, return error return-value
     3286     :
     3287       assign
     3288         p-need-full-display = v-diasize-need-full-display
     3289       .
     3290       assign
     3291         v-diasize-need-full-display = false
     3292       .
     3293     end.
     3294   end procedure.
     3295   procedure get-context :
     3296      define output parameter p-db-num as integer          no-undo.
     3297      define output parameter p-user-id as character        no-undo.
     3298      define variable v-login               as character    no-undo.
     3299      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     3300      define buffer buf_user-login  for ub.user-login .
     3301      do
     3302      on error undo, return error
     3303      :
     3304            FIND FIRST buf_sys-ctrl no-lock.
     3305            ASSIGN
     3306               v-login = USERID("ub")
     3307               p-db-num = buf_sys-ctrl.db-num
     3308            .
     3309            FIND FIRST buf_user-login
     3310                 WHERE buf_user-login.db-num = p-db-num
     3311                   AND buf_user-login.user-login = v-login
     3312                 no-lock
     3313                 no-error
     3314                 .
     3315            IF AVAILABLE buf_user-login
     3316            THEN DO:
     3317               assign
     3318                  p-user-id = buf_user-login.user-id
     3319               .
     3320            END.
     3321      end.
     3322   end procedure.
     3323       run diasize_init in this-procedure .
     3324   MAIN-BLOCK:
     3325   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     3326      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     3327     FIND supplier WHERE recid(supplier) = suppl-rid NO-LOCK.
     3328     run get-report-num in parparentproc(output g#report-num).
     3329   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3330   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3331     (input  p-curr-obj-type
     3332     ,input  p-curr-obj-code
     3333     ,output v-host-code
     3334     )  .
     3335   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3337     (input  v-host-code
     3338     ,output v-base-code
     3339     )  .
     3340     find first buf_rep_currency no-lock
     3341     where buf_rep_currency.curr-code = v-base-code
     3342     no-error .
     3343     if available buf_rep_currency then base-type = buf_rep_currency.curr-abbr .
     3344                 else base-type = "б.в." .
     3345     RUN calc.
     3346     RUN enable_UI.
     3347     FRAME v-suppl:TITLE = string( "Поставки с: " + string(from-date,"99/99/9999") +
     3348                                                                       " по: " + string(to-date,"99/99/9999") +
     3349                                                                       " Поставщик: " + supplier.obj-name +
     3350                                                                       " (" + supplier.obj-type + " " + string(supplier.obj-code) + ")" ).
     3351     apply "entry" to br-suppl in frame v-suppl.
     3352     WAIT-FOR GO OF FRAME v-suppl.
     3353   END.
     3354   RUN disable_UI.
     3355   PROCEDURE calc :
     3356   def buffer b-parts for parts.
     3357   define variable out-qnty    like parts.fact-qnty        no-undo.
     3358   define variable free-qnty   like parts.fact-qnty        no-undo.
     3359   define variable qnty_sale   like suppl-gds.qnty-sale    no-undo.
     3360   define variable f-date      as date                     no-undo.
     3361   define variable l-date      as date                     no-undo.
     3362   define variable v-today     as date                     no-undo.
     3363   define variable v-time      as integer                  no-undo.
     3364   if session:set-wait-state("COMPILER") then.
     3365   run waitfram-show in this-procedure ("Подождите...").
     3366   FOR EACH parts WHERE parts.host-code = v-host-code
     3367                        AND parts.supp-type = supplier.obj-type
     3368                        AND parts.supp-code = supplier.obj-code
     3369                        AND parts.status_ = yes
     3370                        AND parts.fact-date >= from-date
     3371                        AND parts.fact-date <= to-date
     3372                        AND parts.out-code = parts.in-code NO-LOCK,
     3373       EACH goods WHERE goods.artic = parts.artic
     3374                        AND goods.prod-type = parts.prod-type
     3375                        AND goods.prod-code = parts.prod-code NO-LOCK
     3376                        BREAK BY parts.fact-date:
     3377       assign
     3378           l-date = parts.fact-date
     3379           qnty_sale = 0
     3380           .
     3381       FOR EACH b-parts WHERE b-parts.artic = parts.artic
     3382                                                   AND b-parts.prod-type = parts.prod-type
     3383                                                   AND b-parts.prod-code = parts.prod-code
     3384                                                   AND b-parts.in-code = parts.in-code
     3385                                                   AND b-parts.part-code = parts.part-code
     3386                                                   AND b-parts.status_ = yes
     3387                                                   AND b-parts.doc-type = 'рас':U NO-LOCK,
     3388               EACH trn-doc WHERE trn-doc.doc-code = b-parts.out-code
     3389                                                   AND trn-doc.internal = no NO-LOCK
     3390                                                   BREAK BY b-parts.fact-date:
     3391           if LAST-OF( b-parts.fact-date ) then
     3392               assign qnty_sale = qnty_sale + 1.
     3393           if LAST( b-parts.fact-date ) AND l-date - 1 < b-parts.fact-date then
     3394               assign l-date = b-parts.fact-date + 1.
     3395       END.
     3396       FOR EACH b-parts WHERE b-parts.artic = parts.artic
     3397                            AND b-parts.prod-type = parts.prod-type
     3398                            AND b-parts.prod-code = parts.prod-code
     3399                            AND b-parts.in-code = parts.in-code
     3400                            AND b-parts.part-code = parts.part-code
     3401                            AND b-parts.out-code = 'out-zone':U
     3402                            NO-LOCK:
     3403           ACCUMULATE b-parts.fact-qnty (TOTAL).
     3404       END.
     3405       assign out-qnty = (ACCUM TOTAL b-parts.fact-qnty) .
     3406       FOR EACH b-parts WHERE b-parts.artic = parts.artic
     3407                            AND b-parts.prod-type = parts.prod-type
     3408                            AND b-parts.prod-code = parts.prod-code
     3409                            AND b-parts.in-code = parts.in-code
     3410                            AND b-parts.part-code = parts.part-code
     3411                            AND b-parts.out-code = 'free-zone':U
     3412                            NO-LOCK:
     3413           ACCUMULATE b-parts.fact-qnty (TOTAL).
     3414       END.
     3415       assign free-qnty = (ACCUM TOTAL b-parts.fact-qnty) .
     3416       if free-qnty > 0 then do:
     3417           run cur-time in this-procedure ( output v-today
     3418                                          , output v-time
     3419                                          ).
     3420           assign l-date = v-today + 1.
     3421       end.
     3422       find    first  buf-trn-doc where
     3423               buf-trn-doc.doc-code =   parts.in-code  and
     3424               buf-trn-doc.doc-type <> 'инв':U no-lock no-error .
     3425        if available buf-trn-doc then  dO:
     3426           ACCUMULATE
     3427               parts.fact-qnty (TOTAL)
     3428               parts.fact-qnty * parts.price-rubl (TOTAL)
     3429               parts.fact-qnty * parts.price-base (TOTAL)
     3430             .
     3431          end.
     3432       ACCUMULATE
     3433           out-qnty (TOTAL)
     3434           out-qnty * parts.price-rubl (TOTAL)
     3435           out-qnty * parts.price-base (TOTAL)
     3436           free-qnty (TOTAL)
     3437           free-qnty * parts.price-rubl (TOTAL)
     3438           free-qnty * parts.price-base (TOTAL)
     3439           .
     3440       FIND suppl-gds WHERE suppl-gds.artic = parts.artic
     3441                            AND suppl-gds.prod-type = parts.prod-type
     3442                            AND suppl-gds.prod-code = parts.prod-code
     3443                            NO-ERROR.
     3444       if available suppl-gds then
     3445           assign
     3446               suppl-gds.in-qnty = suppl-gds.in-qnty + parts.fact-qnty
     3447               suppl-gds.in-sum0-rubl = suppl-gds.in-sum0-rubl + parts.fact-qnty * parts.price-rubl
     3448               suppl-gds.in-sum0-base = suppl-gds.in-sum0-base + parts.fact-qnty * parts.price-base
     3449               suppl-gds.out-qnty = suppl-gds.out-qnty + out-qnty
     3450               suppl-gds.out-sum0-rubl = suppl-gds.out-sum0-rubl + out-qnty * parts.price-rubl
     3451               suppl-gds.out-sum0-base = suppl-gds.out-sum0-base + out-qnty * parts.price-base
     3452               suppl-gds.free-qnty = suppl-gds.free-qnty + free-qnty
     3453               suppl-gds.free-sum0-rubl = suppl-gds.free-sum0-rubl + free-qnty * parts.price-rubl
     3454               suppl-gds.free-sum0-base = suppl-gds.free-sum0-base + free-qnty * parts.price-base
     3455               suppl-gds.qnty-sale = suppl-gds.qnty-sale + qnty_sale
     3456               .
     3457       else
     3458           do:
     3459               CREATE suppl-gds.
     3460               assign
     3461                   suppl-gds.artic = parts.artic
     3462                   suppl-gds.prod-type = parts.prod-type
     3463                   suppl-gds.prod-code = parts.prod-code
     3464                   suppl-gds.gds-name = goods.gds-name
     3465                   suppl-gds.unit-base = goods.unit-base
     3466                   suppl-gds.in-qnty = parts.fact-qnty
     3467                   suppl-gds.in-sum0-rubl = parts.fact-qnty * parts.price-rubl
     3468                   suppl-gds.in-sum0-base = parts.fact-qnty * parts.price-base
     3469                   suppl-gds.out-qnty = out-qnty
     3470                   suppl-gds.out-sum0-rubl = out-qnty * parts.price-rubl
     3471                   suppl-gds.out-sum0-base = out-qnty * parts.price-base
     3472                   suppl-gds.free-qnty = free-qnty
     3473                   suppl-gds.free-sum0-rubl = free-qnty * parts.price-rubl
     3474                   suppl-gds.free-sum0-base = free-qnty * parts.price-base
     3475                   suppl-gds.qnty-sale = qnty_sale
     3476                   suppl-gds.fs-date = parts.fact-date
     3477                   suppl-gds.ls-date = parts.fact-date
     3478                   .
     3479           end.
     3480       if l-date >  suppl-gds.ls-date then
     3481           assign suppl-gds.ls-date = l-date.
     3482   END.
     3483   assign
     3484       tot-in-qnty = (ACCUM TOTAL parts.fact-qnty)
     3485       tot-in-sum0-rubl = (ACCUM TOTAL parts.fact-qnty * parts.price-rubl)
     3486       tot-in-sum0-base = (ACCUM TOTAL parts.fact-qnty * parts.price-base)
     3487       tot-out-qnty = (ACCUM TOTAL out-qnty)
     3488       tot-out-sum0-rubl = (ACCUM TOTAL out-qnty * parts.price-rubl)
     3489       tot-out-sum0-base = (ACCUM TOTAL out-qnty * parts.price-base)
     3490       tot-free-qnty = (ACCUM TOTAL free-qnty)
     3491       tot-free-sum0-rubl = (ACCUM TOTAL free-qnty * parts.price-rubl)
     3492       tot-free-sum0-base = (ACCUM TOTAL free-qnty * parts.price-base)
     3493       .
     3494   hide loc-art in frame v-suppl loc-name loc-code in frame v-suppl.
     3495   assign loc-art = "".
     3496   if session:set-wait-state("") then.
     3497   run waitfram-hide in this-procedure .
     3498   END PROCEDURE.
     3499   PROCEDURE disable_UI :
     3500     HIDE FRAME v-suppl.
     3501   END PROCEDURE.
     3502   PROCEDURE enable_UI :
     3503     DISPLAY tot-out-sum0-rubl tot-in-qnty tot-out-sum0-base tot-free-qnty
     3504             tot-in-sum0-rubl a-n-c tot-free-sum0-rubl tot-out-qnty tot-in-sum0-base
     3505             tot-free-sum0-base
     3506         WITH FRAME v-suppl.
     3507     ENABLE rect-in br-suppl b-parts a-n-c b-quit b-print b-help
     3508         WITH FRAME v-suppl.
     3509     VIEW FRAME v-suppl.
     3510     OPEN QUERY br-suppl FOR EACH suppl-gds NO-LOCK.
     3511     assign tot-in-sum0-rubl:label = "сумма (руб)" .
     3512   END PROCEDURE.
