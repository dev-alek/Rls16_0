      420   procedure create_obj-list :
      421      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      422      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      423      do
      424      on error undo, return error return-value
      425      :
      426         define buffer cli-obj for ub.clients .
      427         define variable p-var as integer no-undo .
      428         define buffer buf_obj-list for obj-list .
      429         find last buf_obj-list  use-index pi no-error .
      430         if available buf_obj-list
      431         then
      432            p-var = buf_obj-list.obj-id + 1.
      433         else
      434            p-var = 1.
      435         find first cli-obj where
      436                   cli-obj.obj-type = p-obj-type
      437               and cli-obj.obj-code = p-obj-code
      438         no-lock no-error.
      439         if available cli-obj
      440         then do:
      441            create buf_obj-list.
      442            assign
      443               buf_obj-list.obj-id   = p-var
      444               buf_obj-list.obj-code = cli-obj.obj-code
      445               buf_obj-list.obj-type = cli-obj.obj-type
      446               buf_obj-list.obj-name = cli-obj.obj-name
      447               buf_obj-list.db-num   = cli-obj.db-num
      448            .
      449         end.
      450      end.
      451   end.
