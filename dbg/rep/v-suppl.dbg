     1046       field unit-base      like ub.goods.unit-base
     1047       field s-pay-type     as character
     1048       field in-qnty        like ub.parts.fact-qnty
     1049       field in-nds0-rubl   like ub.parts.price-rubl
     1050       field in-nds0-base   like ub.parts.price-base
     1051       field in-sum0-rubl   like ub.parts.price-rubl
     1052       field in-sum0-base   like ub.parts.price-base
     1053       field in-nds-rubl    like ub.parts.price-rubl
     1054       field in-nds-base    like ub.parts.price-base
     1055       field in-sum-rubl    like ub.parts.price-rubl
