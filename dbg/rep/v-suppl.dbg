     1572        VIEW-AS FILL-IN
     1573        size 17 by 1
     1574        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1575   DEFINE VARIABLE tot-out-sum0-rubl AS DECIMAL FORMAT "->>>,>>>,>>9.99" INITIAL ?
     1576        VIEW-AS FILL-IN
     1577        size 17 by 1
     1578        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
     1579   DEFINE VARIABLE a-n-c AS CHARACTER
     1580        VIEW-AS RADIO-SET HORIZONTAL
     1581        RADIO-BUTTONS
     1582             "&А", "art",
     1583   "&Н", "name",
     1584   "&К", "code"
     1585        size 15 by 1 NO-UNDO.
