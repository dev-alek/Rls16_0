     1149   define new global shared variable g#libbcrcn as handle no-undo .
     1150   define variable g#report-num as integer no-undo .
     1151   procedure OpenForExcel :
     1152      define variable v-ch#ExcelApplication as com-handle no-undo .
     1153      define variable v-ch#Workbook         as com-handle no-undo .
     1154      define variable v-ch#Worksheet        as com-handle no-undo .
     1155      os-delete value( string( session:temp-directory ) +
     1156                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     1157      os-delete value( string( session:temp-directory ) +
     1158                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     1159      os-delete value( string( session:temp-directory ) +
     1160                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     1161      if Make-Excel
     1162      then do:
     1163         output stream ForExcel to value( string( session:temp-directory +
     1164                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     1165         assign
     1166            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     1167            number-list = 1
     1168         .
     1169         if make-excel-com
     1170         then do:
     1171   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   if valid-handle(ch#WorkSheet) then
     1173   RELEASE OBJECT ch#WorkSheet no-error.
     1174   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1175   if valid-handle(ch#Workbook) then
     1176   RELEASE OBJECT ch#Workbook no-error.
     1177   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1178   if valid-handle(ch#ExcelApplication) then
     1179   RELEASE OBJECT ch#ExcelApplication no-error.
     1180            create "Excel.Application" ch#excelApplication connect no-error.
     1181            if error-status:error
     1182            then do :
     1183           create "Excel.Application" ch#excelApplication no-error.
     1184       if error-status :error then do:
     1185           message
     1186           "Ошибка при запуске Excel" skip
     1187           error-status :get-message(1) skip
     1188           view-as alert-box error .
     1189           undo, return error .
     1190       end.
     1191            end.
     1192            assign
     1193               num#str#  = 0.
     1194               v-ch#excelApplication  = ch#excelApplication.
     1195               v-ch#excelApplication:Interactive = false.
     1196               v-ch#excelApplication:ScreenUpdating = false.
     1197               v-ch#excelApplication:Visible = false.
     1198               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     1199               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     1200               v-ch#Worksheet = ch#WorkSheet.
     1201               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     1202               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     1203               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     1204               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     1205            no-error .
     1206            if error-status:error
     1207            then do:
     1208               Make-Excel-com = false .
     1209               Make-Excel = false .
     1210               output Stream  ForExcel close.
     1211               os-delete value( string( session:temp-directory ) +
     1212                              "rpt" + string( g#report-num ) + ".txt":U ) .
     1213               os-delete value( string( session:temp-directory ) +
     1214                              "rpt" + string( g#report-num ) + ".frm":U ) .
     1215               return.
     1216            end.
     1217         end.
     1218      end.
     1219   end.
     1220   procedure CloseForExcel :
     1221      define variable ii as integer no-undo .
     1222      define variable vsheet-num as integer no-undo.
     1223      if Make-Excel
     1224      then  do:
     1225         output Stream  ForExcel close.
     1226         os-delete value( string( session:temp-directory ) +
     1227                                "rpt" + string( g#report-num ) + ".txt":U ) .
     1228         os-delete value( string( session:temp-directory ) +
     1229                                "rpt" + string( g#report-num ) + ".frm":U ) .
     1230         define buffer buf_sheetf for sheetf.
     1231         find last buf_sheetf no-error .
     1232         if available buf_sheetf
     1233         then
     1234            vsheet-num = buf_sheetf.sheet-num.
     1235         if vsheet-num > 1
     1236         then do:
     1237            do ii = 2 to vsheet-num:
     1238               os-delete value( string( session:temp-directory ) +
     1239                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     1240            end.
     1241         end.
     1242   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   if valid-handle(ch#WorkSheet) then
     1244   RELEASE OBJECT ch#WorkSheet no-error.
     1245   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   if valid-handle(ch#Workbook) then
     1247   RELEASE OBJECT ch#Workbook no-error.
     1248   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1249   if valid-handle(ch#ExcelApplication) then
     1250   RELEASE OBJECT ch#ExcelApplication no-error.
     1251      end.
     1252   end.
     1253   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1254   define variable v-waitfram-action01         as character   no-undo .
     1255   define variable v-waitfram-action02         as character   no-undo .
     1256   define variable v-waitfram-action03         as character   no-undo .
     1257   define variable mWaitFramTextBeg            as character   no-undo.
     1258   define variable mWaitFramTextEnd            as character   no-undo.
     1259   define variable mWaitFramView               as logical     no-undo.
     1260   define variable mWaitProcEvent              as logical     no-undo init yes.
     1261   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1262   define variable mWaitFramStop               as logical     no-undo.
     1263   define variable mWaitFramStopUser           as logical     no-undo.
     1264   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1265   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1266   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1267   define button B-WaitFramStop auto-end-key
     1268        label "Стоп"
     1269        size 10 by 1 tooltip "Остоновить процесс".
     1270   define button B-viewProcInfo
     1271        label "Информация"
     1272        size 15 by 1 tooltip "Информация о процесс".
     1273   define frame waitfram
     1274     v-waitfram-action01 format "x(72)" no-label skip
     1275     v-waitfram-action02 format "x(72)" no-label skip
     1276     v-waitfram-action03 format "x(72)" no-label skip
     1277     B-viewProcInfo
     1278     B-WaitFramStop at row 4 col 30
     1279     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1280     .
     1281   define new global shared variable mBatchMode as logical no-undo init ?.
     1282   define variable mFramBachModHandle as handle no-undo.
     1283   mFramBachModHandle = frame waitfram:handle.
     1284   define variable mFameOldVis as logical no-undo.
     1285   define variable mVisCUrentVin as logical no-undo.
     1286   if session:batch-mode
     1287   then
     1288      mBatchMode = yes.
     1289   if mBatchMode = ? then do:
     1290     mVisCUrentVin = current-window:visible.
     1291     mFameOldVis = mFramBachModHandle:visible.
     1292     mFramBachModHandle:visible  = yes.
     1293     mBatchMode = mFramBachModHandle:visible ne yes.
     1294     mFramBachModHandle:visible = mFameOldVis.
     1295     current-window:visible = mVisCUrentVin.
     1296   end.
     1297    if  log-manager:logfile-name ne ?
     1298     then DO:
     1299         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1300         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1301         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1302     end.
     1303   on choose of B-WaitFramStop in frame waitfram
     1304   do:
     1305     mWaitFramStop = yes.
     1306     mWaitFramStopUser = yes.
     1307   end.
     1308   function waitfram-check-timeout returns logical():
     1309      define variable vtime as int64 no-undo.
     1310      if mWaitFramStopTimeOut
     1311      then
     1312         return yes.
     1313      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1314      if     mWaitFramTimeOut ne ?
     1315         and mWaitFramTimeOut ne 0
     1316         and mWaitFramTimeOut lt vtime
     1317      then do:
     1318         mWaitFramStopTimeOut = yes.
     1319      end.
     1320      return mWaitFramStopTimeOut.
     1321   end.
     1322   procedure waitfram-hide :
     1323     if not session:batch-mode
     1324     then do
     1325     on error undo, return error return-value
     1326     :
     1327       pause 0 before-hide .
     1328       if not mBatchMode then
     1329         hide frame waitfram .
     1330     if     not mWaitFramView
     1331        and mWaitProcEvent
     1332     then
     1333       process events .
     1334     end.
     1335   end procedure.
     1336   procedure waitfram-show :
     1337     define input  parameter p-message as character no-undo .
     1338     define variable v-left-margin as integer   no-undo .
     1339     if not session:batch-mode
     1340     then do
     1341     on error undo, return error return-value
     1342     :
     1343       if length(p-message) <= 70 then do:
     1344         assign
     1345           v-left-margin = integer((70 - length(p-message)) / 2)
     1346         .
     1347         assign
     1348           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1349         .
     1350         assign
     1351           v-waitfram-action01 = " "
     1352           v-waitfram-action02 = " "
     1353                                    + fill(" ", v-left-margin)
     1354                                    + p-message
     1355           v-waitfram-action03 = " "
     1356         .
     1357       end.
     1358       else do:
     1359         define variable vRindex1 as integer no-undo.
     1360         define variable vRindex2 as integer no-undo.
     1361         vRindex1 = r-index(p-message," ",70).
     1362         if vRindex1 = 0
     1363         then
     1364            vRindex1 = 70.
     1365         if length(p-message)  <= vRindex1 + 70 then do:
     1366           assign
     1367             v-waitfram-action01 = " "
     1368             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1369             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1370           .
     1371         end.
     1372         else do:
     1373           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1374           if vRindex2 <= vRindex1
     1375           then
     1376              vRindex2 = vRindex1 + 70.
     1377           assign
     1378             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1379             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1380             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1381           .
     1382         end.
     1383       end.
     1384       B-viewProcInfo:visible   in frame waitfram = no.
     1385       B-viewProcInfo:sensitive in frame waitfram = no.
     1386       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1387       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1388       if  (   mWaitFramView
     1389          or  mWaitProcEvent)
     1390          and not mBatchMode
     1391       then
     1392          display
     1393             v-waitfram-action01 skip
     1394             v-waitfram-action02 skip
     1395             v-waitfram-action03 skip
     1396          with frame waitfram .
     1397       if     mWaitFramView
     1398          then do:
     1399             if     mWaitFramInterval ne ?
     1400                and not mBatchMode
     1401             then
     1402                wait-for go of frame waitfram pause mWaitFramInterval.
     1403          end.
     1404          else
     1405             if     mWaitProcEvent
     1406                and not mBatchMode
     1407             then
     1408                process events .
     1409     end.
     1410   end procedure.
     1411      procedure waitfram-show-this:
     1412         define input  parameter iInterval as int64 no-undo.
     1413         define variable vtime as int64 no-undo.
     1414         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1415         mWaitFramInterval = iInterval.
     1416         run waitfram-show (substitute("&1&2 &3&4" ,
     1417                                       mWaitFramTextBeg ,
     1418                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1419                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1420                                       mWaitFramTextEnd
     1421                                      )
     1422                           ).
     1423      end.
     1424      procedure WaitFramRunPause:
     1425         define input  parameter iInterval as dec no-undo.
     1426         define variable vStart  as datetime-tz no-undo.
     1427         define variable vend    as datetime-tz no-undo.
     1428         define variable vint as int64 no-undo.
     1429         define variable vOk as logical no-undo.
     1430         vStart = now.
     1431         vend   = vStart.
     1432         publish "WaitFramPause" (iInterval,output vOk).
     1433         vend   =  now.
     1434         vint = vend - vStart.
     1435         vint = iInterval - vint / 1000.
     1436         if     not mWaitFramStop
     1437            and (   vint > 0
     1438                 or (    not vOk
     1439                     and iInterval eq ?
     1440                     )
     1441                 )
     1442         then
     1443            run waitfram-show-this (iInterval).
     1444         vend   =  now.
     1445         vint = vend - vStart.
     1446         vint = iInterval - vint / 1000.
     1447         if     not mWaitFramStop
     1448            and vint > 0
     1449         then do:
     1450            run gbl/pause.p (vint * 1000).
     1451         end.
     1452         if iInterval ne ?
     1453         then
     1454            publish "WaitFramStop".
     1455         waitfram-check-timeout().
     1456      end.
     1457      procedure WaitFramWaitFor:
     1458         define input  parameter iInterval as dec no-undo.
     1459         assign
     1460            mWaitFramStartProc   = now
     1461            mWaitFramStopUser    = no
     1462            mWaitFramStopTimeOut = no
     1463         .
     1464         block-wait:
     1465         do while not mWaitFramStop:
     1466            run WaitFramRunPause (iInterval).
     1467            if  waitfram-check-timeout()
     1468            then do:
     1469               leave block-wait.
     1470            end.
     1471         end.
     1472         run waitfram-hide.
     1473      end.
     1474   procedure waitfram-join :
     1475     define input  parameter p-line-1  as character no-undo .
     1476     define input  parameter p-line-2  as character no-undo .
     1477     define input  parameter p-line-3  as character no-undo .
     1478     define output parameter p-message as character no-undo .
     1479     do
     1480     on error undo, return error return-value
     1481     :
     1482       assign
     1483         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1484                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1485                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1486       .
     1487     end.
     1488   end procedure.
     1489   function waitfram-join-function returns character
     1490     (input p-line-1 as character
     1491     ,input p-line-2 as character
     1492     ,input p-line-3 as character
     1493     ).
     1494     define variable v-message as character no-undo .
     1495     run waitfram-join in this-procedure
     1496       (input  p-line-1
     1497       ,input  p-line-2
     1498       ,input  p-line-3
     1499       ,output v-message
     1500       ) .
     1501     return v-message .
     1502   end function .
     1503   def buffer l-suppl-gds for suppl-gds.
     1504   define buffer buf-trn-doc for trn-doc.
     1505   define variable conf-par as char no-undo.
     1506   define variable par-type as char no-undo.
     1507   define variable base-type as character no-undo .
     1508   define variable v-host-code like ub.sysconf.host-code no-undo .
     1509   define variable v-base-code like ub.sysconf.base-code no-undo .
     1510   define variable line-rec as recid no-undo .
     1511   define buffer buf_rep_currency for ub.currency.
     1512   DEFINE BUTTON b-help DEFAULT
     1513        LABEL "Помо&щь"
     1514        size 10 by 1.
     1515   DEFINE BUTTON b-parts DEFAULT
     1516        LABEL "&Партии"
     1517        size 10 by 1.
     1518   DEFINE BUTTON b-print DEFAULT
     1519        LABEL "Пе&чать"
     1520        size 10 by 1.
     1521   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
     1522        LABEL "Вы&ход "
     1523        size 10 by 1
     1524        BGCOLOR 8 .
     1525   DEFINE VARIABLE loc-art AS CHARACTER FORMAT "X(16)":U
     1526        LABEL "Начало артикула"
     1527        VIEW-AS FILL-IN
     1528        size 17 by 1
     1529        FGCOLOR 12  NO-UNDO.
     1530   DEFINE VARIABLE loc-code AS CHARACTER FORMAT "X(13)":U
     1531        LABEL "Бар-код (весь)"
     1532        VIEW-AS FILL-IN
     1533        size 14 by 1
     1534        FGCOLOR 12  NO-UNDO.
     1535   DEFINE VARIABLE loc-name AS CHARACTER FORMAT "X(50)":U
     1536        LABEL "Начало названия"
     1537        VIEW-AS FILL-IN
     1538        size 20 by 1
     1539        FGCOLOR 12  NO-UNDO.
     1540   DEFINE VARIABLE tot-free-qnty AS DECIMAL FORMAT "->>>,>>>,>>9.<<<":U INITIAL ?
     1541        VIEW-AS FILL-IN
     1542        size 17 by 1
     1543        BGCOLOR 3 FGCOLOR 15  NO-UNDO.
