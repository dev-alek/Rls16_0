     2408                   find first ub.clients where
     2409                              ub.clients.obj-type = ub.shop.sub-store-type and
     2410                              ub.clients.obj-code = ub.shop.sub-store-code
     2411                   no-lock no-error.
     2412                   if available ub.clients then
     2413                   do:
     2414                       find last buf_obj-list use-index pi no-error.
     2415                       if available buf_obj-list then
     2416                       do:
     2417                           v-temp-id = buf_obj-list.obj-id + 1.
     2418                       end.
     2419                       else
     2420                       do:
     2421                           v-temp-id = 1.
     2422                       end.
     2423                       create buf_obj-list.
     2424                       assign
     2425                           v-sub-store-on = yes
     2426                           buf_obj-list.obj-type = ub.clients.obj-type
     2427                           buf_obj-list.obj-code = ub.clients.obj-code
     2428                           buf_obj-list.obj-id = v-temp-id
     2429                           buf_obj-list.db-num = ub.clients.db-num
     2430                           buf_obj-list.obj-name = ub.clients.obj-name
     2431                       .
     2432                   end.
     2433               end.
     2434           end.
     2435       end.
     2436       for each obj-list no-lock:
     2437   if session :set-wait-state( "compiler" ) then.
     2438           run gbl/conf-rd.p (
     2439               "alcohol":U,
     2440               "":U,
     2441               obj-list.obj-type,
     2442               obj-list.obj-code,
     2443               "":U,
     2444               "":U,
     2445               "":U,
     2446               yes,
     2447               output v-par-val,
     2448               output v-par-type
     2449           ) no-error.
     2450           if v-par-val <> "yes" then
     2451               do:
     2452                   next.
     2453               end.
     2454           else
     2455           do:
     2456               for each ub.gds-obj where
     2457                        ub.gds-obj.obj-type = obj-list.obj-type and
     2458                        ub.gds-obj.obj-code = obj-list.obj-code
     2459               no-lock
     2460               ,
     2461               first goods where
     2462               goods.gds-code = gds-obj.gds-code
     2463               :
     2464                   run gds-attr-value(
     2465                       ub.gds-obj.gds-code,
     2466                       'alcohol-prod':U,
     2467                       output v-par-val,
     2468                       output v-par-type
     2469                   ).
     2470                   if v-par-val <> "" and
     2471                   v-par-val <> "no" then
     2472                   do:
     2473                       v-alc-type-name = "".
     2474                       v-alc-type-code = "".
     2475                       for first ub.alc-type-gds where
     2476                                 ub.alc-type-gds.gds-code = ub.gds-obj.gds-code no-lock
     2477                       :
     2478                           do:
     2479                               for first ub.alc-type where
     2480                                         ub.alc-type.alc-type-inner-code = ub.alc-type-gds.alc-type-inner-code no-lock
     2481                               :
     2482                                   do:
     2483                                       assign
     2484                                           v-alc-type-name = ub.alc-type.alc-type-name
     2485                                           v-alc-type-code = ub.alc-type.alc-type-code
     2486                                       .
     2487                                       for each ub.doc-line where
     2488                                                ub.doc-line.obj-type = obj-list.obj-type and
     2489                                                ub.doc-line.obj-code = obj-list.obj-code and
     2490                                                ub.doc-line.status_ = 'факт':U and
     2491                                                ub.doc-line.fact-order >= v-fact-order-start and
     2492                                                ub.doc-line.fact-order <= v-fact-order-end and
     2493                                                ub.doc-line.prod-type = ub.gds-obj.prod-type and
     2494                                                ub.doc-line.prod-code = ub.gds-obj.prod-code and
     2495                                                ub.doc-line.artic = ub.gds-obj.artic no-lock
     2496                                       ,
     2497                                       first buf_trn-doc where
     2498                                       buf_trn-doc.doc-code = ub.doc-line.doc-code no-lock
     2499                                       :
     2500                                           if lookup(ub.doc-line.ext-doc-type, 'ie,re,rs,vt,vp,ap,mp,pc,iv,rv,im,io':U) > 0 then
     2501                                           do:
     2502                                               if v-sub-store-on = yes then
     2503                                               do:
     2504                                                   if (can-find(first buf2_obj-list no-lock where
     2505                                                               buf2_obj-list.obj-type = buf_trn-doc.cli-type and
     2506                                                               buf2_obj-list.obj-code = buf_trn-doc.cli-code))
     2507                                                       and
     2508                                                       (ub.doc-line.ext-doc-type = 'iv':U or
     2509                                                        ub.doc-line.ext-doc-type = 'rv':U)
     2510                                                   then next.
     2511                                               end.
     2512                                               find first tt-rep1 where
     2513                                                          tt-rep1.alc-type-code = v-alc-type-code and
     2514                                                          tt-rep1.doc-line-code = doc-line.doc-code and
     2515                                                          tt-rep1.volume-piece-litres = goods.ms-base
     2516                                               no-error.
     2517                                               if not available tt-rep1 then
     2518                                               do:
     2519                                                   run fmtcli-get-client in this-procedure (
     2520                                                       input buf_trn-doc.cli-type,
     2521                                                       input buf_trn-doc.cli-code
     2522                                                   ).
     2523                                                   v-doc-code = doc-line.doc-code.
     2524   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-doc-code ,
     2525                           input 'dids':U ,
     2526                          output v-attr-value ,
     2527                          output v-attr-type )  .
     2528                                                   v-attr-doc-data = date(v-attr-value).
     2529                                                   if v-attr-doc-data = ? then v-attr-doc-data = buf_trn-doc.fact-date.
     2530   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input v-doc-code ,
     2531                           input 'nids':U ,
     2532                          output v-attr-value ,
     2533                          output v-attr-type )  .
     2534                                                   v-attr-doc-code = v-attr-value.
     2535                                                   if buf_trn-doc.hold-doc-code-child <> "" and
     2536                                                      buf_trn-doc.hold-doc-code-child <> "no-hold" or
     2537                                                      buf_trn-doc.hold-doc-code-parent <> "" and
     2538                                                      buf_trn-doc.hold-doc-code-parent <> "no-hold" then
     2539                                                   do:
     2540                                                       v-attr-doc-code = buf_trn-doc.hold-doc-code-parent.
     2541                                                   end.
     2542                                                   create tt-rep1.
     2543                                                   assign
     2544                                                       tt-rep1.alc-type-name = v-alc-type-name
     2545                                                       tt-rep1.alc-type-code = v-alc-type-code
     2546                                                       tt-rep1.cli-obj-name = v-fmtcli-name
     2547                                                       tt-rep1.inn = v-fmtcli-inn
     2548                                                       tt-rep1.date-trn = v-attr-doc-data
     2549                                                       tt-rep1.doc-line-code = doc-line.doc-code
     2550                                                       tt-rep1.doc-line-fact-order = doc-line.fact-order
     2551                                                       tt-rep1.doc-code = v-attr-doc-code
     2552                                                       tt-rep1.volume-piece-litres =
     2553                                                           if (goods.ms-base * doc-line.cli-base-rate) = ? then 0
     2554                                                           else (goods.ms-base * doc-line.cli-base-rate)
     2555                                                   .
     2556                                               end.
     2557                                               tt-rep1.fact-qnty = tt-rep1.fact-qnty +
     2558                                                   if (doc-line.fact-qnty / doc-line.cli-base-rate) = ? then 0
     2559                                                   else (doc-line.fact-qnty / doc-line.cli-base-rate).
     2560                                           end.
     2561                                           else
     2562                                           if lookup(ub.doc-line.ext-doc-type, 'ee,ep,es,we,ev,em,wm,eo':U) > 0 then
     2563                                           do:
     2564                                               do:
     2565                                               end.
     2566                                               if v-sub-store-on = yes then
     2567                                               do:
     2568                                                   if (can-find(first buf2_obj-list no-lock where
     2569                                                               buf2_obj-list.obj-type = buf_trn-doc.cli-type and
     2570                                                               buf2_obj-list.obj-code = buf_trn-doc.cli-code))
     2571                                                       and
     2572                                                       (
     2573                                                        ub.doc-line.ext-doc-type = 'ev':U
     2574                                                        )
     2575                                                   then
     2576                                                   next.
     2577                                               end.
     2578                                               create tt-rep1.
     2579                                               run ConvertStr-ext-doc-type (input ub.doc-line.ext-doc-type, output v-name-ext-doc-type).
     2580                                               assign
     2581                                                   tt-rep1.exp-doc-line-code = doc-line.doc-code
     2582                                                   tt-rep1.exp-alc-type-code = v-alc-type-code
     2583                                                   tt-rep1.exp-td-fact-date = buf_trn-doc.fact-date
     2584                                                   tt-rep1.doc-line-fact-order = doc-line.fact-order
     2585                                                   tt-rep1.exp-categoryes-prod = v-name-ext-doc-type
     2586                                                   tt-rep1.exp-alc-type-name = v-alc-type-name
     2587                                                   tt-rep1.exp-volume-piece-litres = goods.ms-base
     2588                                                   tt-rep1.exp-fact-qnty = tt-rep1.exp-fact-qnty +
     2589                                                       (if doc-line.fact-qnty = ? then 0 else doc-line.fact-qnty).
     2590                                               .
     2591                                           end.
     2592                                       end.
     2593                                   end.
     2594                               end.
     2595                           end.
     2596                       end.
     2597                   end.
     2598               end.
     2599           end.
     2600       end.
     2601       do:
     2602           define variable v-inc-litres-line as decimal initial 0 no-undo.
     2603           define variable v-out-litres-line as decimal initial 0 no-undo.
     2604           define variable v-inc-litres-tot as decimal initial 0 no-undo.
     2605           define variable v-out-litres-tot as decimal initial 0 no-undo.
     2606           define variable v-inc-qnty-tot as decimal initial 0 no-undo.
     2607           define variable v-out-qnty-tot as decimal initial 0 no-undo.
     2608   define variable v-dec as character no-undo.
     2609           v-cnt-line = 0.
     2610           for each tt-rep1 no-lock
     2611           by tt-rep1.doc-line-fact-order
     2612           :
     2613               v-cnt-line = v-cnt-line + 1.
     2614               tt-rep1.cnt-line = v-cnt-line.
     2615               v-inc-litres-line =
     2616                   if ((decimal(tt-rep1.volume-piece-litres) * decimal(tt-rep1.fact-qnty)) / 10) = ? then 0
     2617                   else ((decimal(tt-rep1.volume-piece-litres) * decimal(tt-rep1.fact-qnty)) / 10).
     2618               v-inc-litres-tot = v-inc-litres-tot + v-inc-litres-line.
     2619               v-inc-qnty-tot = v-inc-qnty-tot +
     2620                   (if decimal(tt-rep1.fact-qnty) = ? then 0 else decimal(tt-rep1.fact-qnty)).
     2621               v-out-litres-line =
     2622                   if ((tt-rep1.exp-volume-piece-litres * tt-rep1.exp-fact-qnty) / 10) = ? then 0
     2623                   else ((tt-rep1.exp-volume-piece-litres * tt-rep1.exp-fact-qnty) / 10).
     2624               v-out-litres-tot =
     2625                   (if v-out-litres-tot = ? then 0 else v-out-litres-tot) +
     2626                   (if v-out-litres-line = ? then 0 else v-out-litres-line).
     2627               v-out-qnty-tot =
     2628                   (if v-out-qnty-tot = ? then 0 else v-out-qnty-tot) +
     2629                   (if tt-rep1.exp-fact-qnty = ? then 0 else tt-rep1.exp-fact-qnty).
     2630           end.
     2631           v-cnt-line = 0.
     2632       end.
     2633       find first tt-rep1 no-lock no-error.
     2634       if error-status:error then
     2635           do:
     2636               message "Для установленных параметров отчета" skip "- данные отсутствуют!" view-as alert-box warning.
     2637           end.
     2638       run proc-create-HTML (input v-inc-qnty-tot, input v-inc-litres-tot, input v-out-qnty-tot, input v-out-litres-tot, buffer tt-rep1).
     2639       if search(v-file-name-rep-htm) = ? then
     2640           do:
     2641               message "Не найден файл отчёта: " v-file-name-rep-htm view-as alert-box error.
     2642           end.
     2643       else
     2644           do:
     2645               v-file-name-rep-htm = search(v-file-name-rep-htm).
     2646           end.
     2647       os-command no-wait value(v-fill-path-RepView + " " + search(v-file-name-rep-htm)).
     2648       do:
     2649       end.
     2650   end.
     2651       do:
     2652       end.
     2653   end.
     2654   procedure my-watch-table:
     2655       define variable v-full-file-name as character no-undo.
     2656       define variable v-message as character no-undo.
     2657       define variable v-table-handle as handle no-undo.
     2658       define variable v-cnt-field as integer no-undo.
     2659       define variable v-list-field-name as character no-undo.
     2660       define variable v-list-field-label as character no-undo.
     2661       define variable v-list-field-type as character no-undo.
     2662       define variable v-ii as integer no-undo.
     2663       define buffer tt-rep1 for tt-rep1.
     2664       v-table-handle = buffer tt-rep1:handle.
     2665       v-cnt-field = v-table-handle:num-fields.
     2666       do v-ii = 1 to v-cnt-field:
     2667           v-list-field-name =
     2668               (if v-list-field-name <> "" then
     2669                  v-list-field-name + "$" + v-table-handle:buffer-field(v-ii):name
     2670               else
     2671                   v-table-handle:buffer-field(v-ii):name).
     2672           v-list-field-label =
     2673               (if v-list-field-label <> "" then
     2674                  v-list-field-label + "$" + v-table-handle:buffer-field(v-ii):label
     2675               else
     2676                   v-table-handle:buffer-field(v-ii):label).
     2677           v-list-field-type =
     2678               (if v-list-field-type <> "" then
     2679                  v-list-field-type + "$" + v-table-handle:buffer-field(v-ii):data-type
     2680               else
     2681                   v-table-handle:buffer-field(v-ii):data-type).
     2682       end.
     2683       v-full-file-name = "C:\work15_0\my-watch2-tt-rep1.txt".
     2684       if search(v-full-file-name) = ? then
     2685           do:
     2686               message "Не найден файл отчёта: " v-full-file-name view-as alert-box error.
     2687           end.
     2688       output stream MyWatch-strm to value(v-full-file-name)   convert target "utf-8".
     2689           put stream MyWatch-strm unformatted
     2690               today format "99.99.9999" " " string(time, "HH:MM") " " "Исследуемая таблица: " "tt-rep1" "." skip
     2691               v-list-field-label skip
     2692               v-list-field-name skip
     2693               v-list-field-type skip
     2694           .
     2695           if not can-find(first tt-rep1) then
     2696           do:
     2697               v-message = "Исследуемая таблица tt-rep1 пуста!".
     2698               put stream MyWatch-strm unformatted
     2699                   v-message
     2700               .
     2701               message "My-watch-table: " v-message view-as alert-box information.
     2702           end.
     2703               for each  tt-rep1 no-lock:
     2704                   export stream MyWatch-strm delimiter "$"  tt-rep1.
     2705               end.
     2706       output stream MyWatch-strm close.
     2707   end procedure.
