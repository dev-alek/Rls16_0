     1155   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1156   procedure factord :
     1157     define input  parameter p-fact-date            as date    no-undo .
     1158     define input  parameter p-fact-time            as integer no-undo .
     1159     define input  parameter p-fact-num             as integer no-undo .
     1160     define input  parameter p-shift-date           as date    no-undo .
     1161     define input  parameter p-shift-num            as integer no-undo .
     1162     define input  parameter p-shift-on             as logical no-undo .
     1163     define output parameter p-fact-order           as decimal no-undo .
     1164     define output parameter p-shift-end-fact-order as decimal no-undo .
     1165     define output parameter p-day-end-fact-order   as decimal no-undo .
     1166     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1167     if p-fact-date = ?
     1168     then do:
     1169       return error "Не указана фактическая дата" .
     1170     end.
     1171     define variable v-fact-date-num as integer no-undo .
     1172     assign
     1173       v-fact-date-num = integer(p-fact-date)
     1174     .
     1175     if p-fact-num = ?
     1176     or p-fact-num = 0
     1177     then do:
     1178       return error "Не задан p-fact-num " + string(p-fact-num) .
     1179     end.
     1180     if p-fact-num < 0
     1181     then do:
     1182       return error "Отрицательный fact-num " + string(p-fact-num) .
     1183     end.
     1184     if p-fact-num >= 100000000
     1185     then do:
     1186       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1187     end.
     1188     if p-shift-on = true
     1189     then do:
     1190       if p-shift-date = ?
     1191       then do:
     1192         return error "Не задана дата смены" .
     1193       end.
     1194       if p-shift-num = ?
     1195       or p-shift-num = 0
     1196       then do:
     1197         return error "Не задан номер смены" .
     1198       end.
     1199     end.
     1200     else do:
     1201       assign
     1202         p-shift-date = p-fact-date
     1203         p-shift-num  = 24
     1204       .
     1205     end.
     1206     define variable v-shift-offset as integer no-undo .
     1207     if p-shift-date = p-fact-date
     1208     then do:
     1209       assign
     1210         v-shift-offset = 1
     1211       .
     1212     end.
     1213     if p-shift-date < p-fact-date
     1214     then do:
     1215       assign
     1216         v-shift-offset = 0
     1217       .
     1218     end.
     1219     if p-shift-date > p-fact-date
     1220     then do:
     1221       message
     1222         vss-workfile vss-revision vss-description skip
     1223         "Неправильная дата закрытия смены" skip
     1224         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1225         view-as alert-box error .
     1226       undo, return error
     1227         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1228           ,string(p-fact-date, '99/99/9999':U)
     1229           ,string(p-shift-date, '99/99/9999':U)
     1230           )
     1231       .
     1232     end.
     1233     if p-shift-num < 1
     1234     or p-shift-num > 24
     1235     then do:
     1236       message
     1237         vss-workfile vss-revision vss-description skip
     1238         "Неправильный номер смены" skip
     1239         "p-shift-num" p-shift-num skip
     1240         view-as alert-box error .
     1241       undo, return error return-value .
     1242     end.
     1243     assign
     1244       p-fact-order           = v-fact-date-num
     1245                              + v-shift-offset * 0.5
     1246                              + p-shift-num    * 0.02 - 0.01
     1247                              + p-fact-num     * 0.0000000001
     1248       p-shift-end-fact-order = v-fact-date-num
     1249                              + v-shift-offset * 0.5
     1250                              + p-shift-num    * 0.02
     1251       p-day-end-fact-order   = v-fact-date-num
     1252                              + 0.99
     1253     .
     1254     if p-fact-order           <= v-fact-date-num
     1255     or p-shift-end-fact-order <= v-fact-date-num
     1256     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1257     or p-shift-end-fact-order >= p-day-end-fact-order
     1258     then do:
     1259       message
     1260         vss-workfile vss-revision vss-description skip
     1261         "Внутренняя ошибка при генерации фактического номера" skip
     1262         "p-fact-date"            p-fact-date            skip
     1263         "p-fact-time"            p-fact-time            skip
     1264         "p-fact-num"             p-fact-num             skip
     1265         "p-shift-date"           p-shift-date           skip
     1266         "p-shift-num"            p-shift-num            skip
     1267         "p-shift-on"             p-shift-on             skip
     1268         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1269         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1270         "v-fact-date-num"        v-fact-date-num        skip
     1271         view-as alert-box error .
     1272       undo, return error return-value .
     1273     end.
     1274   end procedure.
     1275   procedure day-begin-fact-order :
     1276     define input  parameter p-fact-date            as date    no-undo .
     1277     define output parameter p-day-begin-fact-order as decimal no-undo .
     1278     do
     1279     on error undo, return error return-value
     1280     :
     1281       if p-fact-date = ?
     1282       then do:
     1283         assign
     1284           p-day-begin-fact-order = 0
     1285         .
     1286       end.
     1287       else do:
     1288         assign
     1289           p-day-begin-fact-order = integer(p-fact-date)
     1290         .
     1291       end.
     1292     end.
     1293   end procedure.
     1294   procedure factord-max-fact-order :
     1295     define output parameter p-max-fact-order as decimal   no-undo .
     1296     do
     1297     on error undo, return error return-value
     1298     :
     1299       run day-begin-fact-order in this-procedure
     1300         (input  date(1, 1, 5000)
     1301         ,output p-max-fact-order
     1302         ) .
     1303     end.
     1304   end procedure.
     1305   procedure factord-cut-archive :
     1306     define input  parameter p-obj-type             as character no-undo .
     1307     define input  parameter p-obj-code             as integer   no-undo .
     1308     define input  parameter p-fact-date            as date      no-undo .
     1309     define output parameter p-shift-on             as logical   no-undo .
     1310     define output parameter p-shift-date           as date      no-undo .
     1311     define output parameter p-shift-num            as integer   no-undo .
     1312     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1313     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1314     define variable v-fact-order as decimal   no-undo .
     1315     define buffer buf_shift-obj for ub.shift-obj .
     1316     do
     1317     on error undo, return error return-value
     1318     :
     1319   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1320   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1321     (input  p-obj-type
     1322     ,input  p-obj-code
     1323     ,input  'shift-on=request'
     1324     ,output p-shift-on
     1325     ) no-error .
     1326       if error-status :error
     1327       then do:
     1328         message
     1329           vss-workfile vss-revision vss-description skip
     1330           "Ошибка при определении атрибута объекта" skip
     1331           "Объект" p-obj-type p-obj-code skip
     1332           error-status :get-message(1) skip
     1333           return-value skip
     1334           view-as alert-box error .
     1335         undo, return error return-value .
     1336       end.
     1337       if p-shift-on = false
     1338       then do:
     1339         assign
     1340           p-shift-date               = ?
     1341           p-shift-num                = 0
     1342         .
     1343       end.
     1344       else do:
     1345         find first buf_shift-obj share-lock
     1346           where buf_shift-obj.obj-type   = p-obj-type
     1347             and buf_shift-obj.obj-code   = p-obj-code
     1348             and buf_shift-obj.shift-date > p-fact-date
     1349           use-index pi
     1350           no-error .
     1351         if not available buf_shift-obj
     1352         or buf_shift-obj.status_ <> 'зкр':U
     1353         then do:
     1354           message
     1355             vss-workfile vss-revision vss-description skip
     1356             "Невозможно вычислить последнюю смену" skip
     1357             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1358             "Объект" p-obj-type p-obj-code skip
     1359             "Дата" p-fact-date skip
     1360             view-as alert-box error .
     1361           undo, return error return-value .
     1362         end.
     1363         find last buf_shift-obj share-lock
     1364           where buf_shift-obj.obj-type = p-obj-type
     1365             and buf_shift-obj.obj-code = p-obj-code
     1366             and buf_shift-obj.shift-date <= p-fact-date
     1367           use-index pi
     1368           no-error .
     1369         if available buf_shift-obj
     1370         then do:
     1371           if  buf_shift-obj.status_ = 'зкр':U
     1372           then do:
     1373             assign
     1374               p-shift-date = buf_shift-obj.shift-date
     1375               p-shift-num  = buf_shift-obj.shift-num
     1376             .
     1377           end.
     1378           else do:
     1379             message
     1380               vss-workfile vss-revision vss-description skip
     1381               "Невозможно вычислить последнюю смену" skip
     1382               "Статус смены отличен от статуса" 'зкр':U skip
     1383               "Объект" p-obj-type p-obj-code skip
     1384               "Дата" p-fact-date skip
     1385               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1386               view-as alert-box error .
     1387             undo, return error return-value .
     1388           end.
     1389         end.
     1390         else do:
     1391           assign
     1392             p-shift-date = p-fact-date - 1
     1393             p-shift-num  = 1
     1394           .
     1395         end.
     1396       end.
     1397       run factord in this-procedure
     1398         (input  p-fact-date
     1399         ,input  1
     1400         ,input  1
     1401         ,input  p-shift-date
     1402         ,input  p-shift-num
     1403         ,input  p-shift-on
     1404         ,output v-fact-order
     1405         ,output p-shift-end-fact-order
     1406         ,output p-day-end-fact-order
     1407         ) no-error .
     1408       if error-status :error
     1409       then do:
     1410         message
     1411           vss-workfile vss-revision vss-description skip
     1412           "Ошибка при вызове процедуры factord"
     1413           error-status :get-message(1) skip
     1414           return-value skip
     1415           view-as alert-box error .
     1416         undo, return error return-value .
     1417       end.
     1418     end.
     1419   end procedure.
     1420   procedure factord-lock-shift :
     1421     define input  parameter p-obj-type  as character no-undo .
     1422     define input  parameter p-obj-code  as integer   no-undo .
     1423     define input  parameter p-fact-date as date      no-undo .
     1424     define parameter buffer buf_shift-obj for ub.shift-obj .
     1425     define variable v-shift-on      as logical   no-undo .
     1426     define variable v-extra-message as character no-undo .
     1427     define variable v-error as character no-undo .
     1428     do
     1429     on error undo, return error return-value
     1430     :
     1431   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1433     (input  p-obj-type
     1434     ,input  p-obj-code
     1435     ,input  'shift-on=request'
     1436     ,output v-shift-on
     1437     ) no-error .
     1438       if error-status :error
     1439       then do:
     1440         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1441         undo, return error v-error .
     1442       end.
     1443       if v-shift-on = true
     1444       then do:
     1445         find first buf_shift-obj share-lock
     1446           where buf_shift-obj.obj-type   = p-obj-type
     1447             and buf_shift-obj.obj-code   = p-obj-code
     1448             and buf_shift-obj.shift-date > p-fact-date
     1449           use-index pi
     1450           no-error .
     1451         if not available buf_shift-obj
     1452         or buf_shift-obj.status_ <> 'зкр':U
     1453         then do:
     1454           find last buf_shift-obj
     1455             where buf_shift-obj.obj-type = p-obj-type
     1456               and buf_shift-obj.obj-code = p-obj-code
     1457               and buf_shift-obj.status_  = 'зкр':U
     1458             use-index stts
     1459             no-error .
     1460           if available buf_shift-obj
     1461           then do:
     1462             assign
     1463               v-extra-message =
     1464                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1465                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1466                               )
     1467             .
     1468           end.
     1469           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1470           undo, return error v-error .
     1471         end.
     1472       end.
     1473     end.
     1474   end procedure.
     1475   procedure factord-end-day :
     1476     define input  parameter p-fact-date            as date    no-undo .
     1477     define output parameter p-day-end-fact-order   as decimal no-undo .
     1478     do
     1479     on error undo, return error return-value
     1480     :
     1481       if p-fact-date = ?
     1482       then do:
     1483         return error "Не указана фактическая дата" .
     1484       end.
     1485       assign
     1486         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1487       .
     1488     end.
     1489   end procedure.
     1490   procedure factord-to-date :
     1491     define input  parameter p-fact-order as decimal no-undo .
     1492     define output parameter p-fact-date  as date    no-undo .
     1493     define variable v-ref-date  as date      no-undo .
     1494     define variable v-ref-delta as integer   no-undo .
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       if p-fact-order = ?
     1499       or p-fact-order = 0
     1500       then do:
     1501         return error "Не указан fact-order" .
     1502       end.
     1503       assign
     1504         v-ref-date  = date(1, 1, 2000)
     1505       .
     1506       assign
     1507         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1508       .
     1509       assign
     1510         p-fact-date = v-ref-date + v-ref-delta
     1511       .
     1512     end.
     1513   end procedure.
     1514   procedure factord-to-fact-num :
     1515     define input  parameter p-fact-order as decimal no-undo .
     1516     define output parameter p-fact-num   as integer no-undo .
     1517     define variable v-fact-order-trunc as decimal no-undo .
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       if p-fact-order = ?
     1522       or p-fact-order = 0
     1523       then do:
     1524         return error "Не указан fact-order" .
     1525       end.
     1526       assign
     1527        v-fact-order-trunc = truncate(p-fact-order, 2)
     1528       .
     1529       assign
     1530         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1531       .
     1532     end.
     1533   end procedure.
     1534   procedure factord-to-shift-num :
     1535     define input  parameter p-fact-order as decimal no-undo .
     1536     define output parameter p-shift-num   as integer no-undo .
     1537     define variable  p-shift-numd  as decimal   no-undo .
     1538     define variable v-fact-order-trunc as decimal no-undo .
     1539     do
     1540     on error undo, return error return-value
     1541     :
     1542       if p-fact-order = ?
     1543       or p-fact-order = 0
     1544       then do:
     1545         return error "Не указан fact-order" .
     1546       end.
     1547       assign
     1548        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1549       .
     1550       if v-fact-order-trunc < 0.5 then do:
     1551         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1552       end.
     1553       assign
     1554         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1555         .
     1556        assign
     1557         p-shift-num = truncate (p-shift-numd , 0)
     1558       .
     1559     end.
     1560   end procedure.
     1561   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1562   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1563   procedure paramls-clear :
     1564     define buffer buf_temp-param for temp-param .
     1565     do
     1566     on error undo, return error return-value
     1567     :
     1568       for each buf_temp-param
     1569       on error undo, return error
     1570       :
     1571         delete buf_temp-param .
     1572       end.
     1573     end.
     1574   end procedure.
     1575   procedure paramls-write :
     1576     define input  parameter p-code     as character no-undo .
     1577     define input  parameter p-sub-code as character no-undo .
     1578     define input  parameter p-value    as character no-undo .
     1579     define buffer buf_temp-param for temp-param .
     1580     do
     1581     on error undo, return error return-value
     1582     :
     1583       find first buf_temp-param
     1584         where buf_temp-param.param-code     = p-code
     1585           and buf_temp-param.param-sub-code = p-sub-code
     1586         no-error .
     1587       if not available buf_temp-param then do:
     1588         create buf_temp-param .
     1589         assign
     1590           buf_temp-param.param-code     = p-code
     1591           buf_temp-param.param-sub-code = p-sub-code
     1592         .
     1593       end.
     1594       assign
     1595         buf_temp-param.param-value = p-value
     1596       .
     1597     end.
     1598   end procedure.
     1599   procedure paramls-read :
     1600     define input  parameter p-code          as character no-undo .
     1601     define input  parameter p-sub-code      as character no-undo .
     1602     define input  parameter p-default-value as character no-undo .
     1603     define output parameter p-value         as character no-undo .
     1604     define buffer buf_temp-param for temp-param .
     1605     do
     1606     on error undo, return error return-value
     1607     :
     1608       find first buf_temp-param
     1609         where buf_temp-param.param-code     = p-code
     1610           and buf_temp-param.param-sub-code = p-sub-code
     1611         no-error .
     1612       if available buf_temp-param then do:
     1613         assign
     1614           p-value = buf_temp-param.param-value
     1615         .
     1616       end.
     1617       else do:
     1618         assign
     1619           p-value = p-default-value
     1620         .
     1621       end.
     1622     end.
     1623   end procedure.
     1624   procedure paramls-append :
     1625     define input  parameter p-code     as character no-undo .
     1626     define input  parameter p-sub-code as character no-undo .
     1627     define input  parameter p-value    as character no-undo .
     1628     define buffer buf_temp-param for temp-param .
     1629     do
     1630     on error undo, return error return-value
     1631     :
     1632       find first buf_temp-param
     1633            where buf_temp-param.param-code     = p-code
     1634              and buf_temp-param.param-sub-code = p-sub-code
     1635         no-error .
     1636       if not available buf_temp-param then do:
     1637         create buf_temp-param .
     1638         assign
     1639           buf_temp-param.param-code     = p-code
     1640           buf_temp-param.param-sub-code = p-sub-code
     1641           buf_temp-param.param-value    = p-value
     1642         .
     1643       end.
     1644       else do:
     1645           assign
     1646               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1647           .
     1648       end.
     1649     end.
     1650   end procedure.
     1651   define variable vss-include-info13 as character format "X(65)" no-undo
     1652   initial "@(#)$Workfile$ $Revision$".
     1653   define variable v-fmtcli-name          as character    no-undo.
     1654   define variable v-fmtcli-engl-name     as character    no-undo.
     1655   define variable v-fmtcli-addres        as character    no-undo.
     1656   define variable v-fmtcli-post-addres   as character    no-undo.
     1657   define variable v-fmtcli-full-addres   as character    no-undo.
     1658   define variable v-fmtcli-phone         as character    no-undo.
     1659   define variable v-fmtcli-inn           as character    no-undo.
     1660   define variable v-fmtcli-kpp           as character    no-undo.
     1661   define variable v-fmtcli-okpo          as character    no-undo.
     1662   define variable v-fmtcli-country       as character    no-undo.
     1663   define variable v-fmtcli-city          as character    no-undo.
     1664   define variable v-fmtcli-index         as character    no-undo.
     1665   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1666   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1667   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1668   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1669   define variable v-fmtcli-bank-bik      as character    no-undo.
     1670   define variable v-fmtcli-bank-name     as character    no-undo.
     1671   define variable v-fmtcli-bank-addres   as character    no-undo.
     1672   define variable v-fmtcli-bank-city     as character    no-undo.
     1673   procedure fmtcli-get-bank :
     1674   define input parameter p-host-code      as integer          no-undo.
     1675   define input parameter p-obj-type       as character        no-undo.
     1676   define input parameter p-obj-code       as integer          no-undo.
     1677   define input parameter p-curr-code      as integer          no-undo.
     1678       define buffer buf_fin-schet     for ub.fin-schet.
     1679       define buffer buf_fin-bank      for ub.fin-bank.
     1680   do
     1681   for buf_fin-schet
     1682     , buf_fin-bank
     1683   on error undo, return error
     1684   :
     1685       assign
     1686           v-fmtcli-schet-exists       = no
     1687           v-fmtcli-bank-exists        = no
     1688           v-fmtcli-bank-r-schet       = "":U
     1689           v-fmtcli-bank-c-schet       = "":U
     1690           v-fmtcli-bank-bik           = "":U
     1691           v-fmtcli-bank-name          = "":U
     1692           v-fmtcli-bank-addres        = "":U
     1693           v-fmtcli-bank-city          = "":U
     1694       .
     1695       search-for-schet:
     1696       for each buf_fin-schet no-lock
     1697          where buf_fin-schet.host-code = p-host-code
     1698            and buf_fin-schet.cli-type  = p-obj-type
     1699            and buf_fin-schet.cli-code  = p-obj-code
     1700            and buf_fin-schet.curr-code = p-curr-code
     1701       on error undo, return error
     1702       :
     1703           if buf_fin-schet.status_   = 'удал':U
     1704           then do:
     1705           end.
     1706           else do:
     1707               assign
     1708                   v-fmtcli-schet-exists   = yes
     1709                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1710                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1711               .
     1712               find first buf_fin-bank no-lock
     1713                    where buf_fin-bank.host-code = p-host-code
     1714                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1715               no-error.
     1716               if available buf_fin-bank
     1717               then do:
     1718                   assign
     1719                       v-fmtcli-bank-exists      = yes
     1720                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1721                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1722                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1723                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1724                   .
     1725               end.
     1726               else do:
     1727                   assign
     1728                       v-fmtcli-bank-exists    = no
     1729                       v-fmtcli-bank-bik       = "":U
     1730                       v-fmtcli-bank-name      = "":U
     1731                       v-fmtcli-bank-addres    = "":U
     1732                       v-fmtcli-bank-city      = "":U
     1733                   .
     1734               end.
     1735               leave search-for-schet.
     1736           end.
     1737       end.
     1738   end.
     1739   end procedure.
     1740   procedure fmtcli-get-client :
     1741   define input parameter p-obj-type       as character    no-undo.
     1742   define input parameter p-obj-code       as integer      no-undo.
     1743       define variable v-temp-fmtcli-address      as character     no-undo.
     1744       define variable v-num-country-city    as integer      no-undo.
     1745       define buffer buf_clients   for ub.clients.
     1746       define buffer buf_firm      for ub.firm.
     1747       define buffer buf_store     for ub.store.
     1748       define buffer buf_shop      for ub.shop.
     1749       define buffer buf_person    for ub.person.
     1750   do
     1751   for buf_clients
     1752     , buf_firm
     1753     , buf_store
     1754     , buf_shop
     1755     , buf_person
     1756   on error undo, return error
     1757   :
     1758       assign
     1759           v-fmtcli-name           = "":U
     1760           v-fmtcli-addres         = "":U
     1761           v-fmtcli-post-addres    = "":U
     1762           v-fmtcli-full-addres    = "":U
     1763           v-fmtcli-phone          = "":U
     1764           v-fmtcli-inn            = "":U
     1765           v-fmtcli-kpp            = "":U
     1766           v-fmtcli-okpo           = "":U
     1767           v-fmtcli-city           = "":U
     1768           v-fmtcli-index          = "":U
     1769           v-fmtcli-country        = "":U
     1770       .
     1771       find first buf_clients no-lock
     1772            where buf_clients.obj-type = p-obj-type
     1773              and buf_clients.obj-code = p-obj-code
     1774       .
     1775       assign
     1776           v-fmtcli-name = buf_clients.obj-name
     1777       .
     1778       case buf_clients.obj-type:
     1779          when 'орг':U
     1780          then do:
     1781               find first buf_firm no-lock
     1782                    where buf_firm.firm-code = buf_clients.obj-code
     1783                    no-error
     1784               .
     1785               if available buf_firm
     1786               then do:
     1787                   assign
     1788                       v-num-country-city = num-entries( buf_firm.city )
     1789                       v-fmtcli-engl-name = buf_firm.engl-name
     1790                   .
     1791                   if v-num-country-city > 0
     1792                   then do:
     1793                       assign
     1794                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1795                       .
     1796                   end.
     1797                   if v-num-country-city > 1
     1798                   then do:
     1799                       assign
     1800                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1801                       .
     1802                   end.
     1803                   run fmtcli-concatenate-strings in this-procedure (
     1804                         input v-fmtcli-full-addres
     1805                       , input v-fmtcli-country
     1806                       , input ", ":U
     1807                       , input 50
     1808                       , output v-fmtcli-full-addres
     1809                   ).
     1810                   run fmtcli-concatenate-strings in this-procedure (
     1811                         input v-fmtcli-full-addres
     1812                       , input v-fmtcli-city
     1813                       , input ", ":U
     1814                       , input 50
     1815                       , output v-fmtcli-full-addres
     1816                   ).
     1817                   run fmtcli-concatenate-strings in this-procedure (
     1818                         input v-fmtcli-full-addres
     1819                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1820                       , input ", ":U
     1821                       , input 50
     1822                       , output v-fmtcli-full-addres
     1823                   ).
     1824                   run fmtcli-concatenate-strings in this-procedure (
     1825                         input v-fmtcli-post-addres
     1826                       , input v-fmtcli-country
     1827                       , input ", ":U
     1828                       , input 50
     1829                       , output v-fmtcli-post-addres
     1830                   ).
     1831                   run fmtcli-concatenate-strings in this-procedure (
     1832                         input v-fmtcli-post-addres
     1833                       , input v-fmtcli-city
     1834                       , input ", ":U
     1835                       , input 50
     1836                       , output v-fmtcli-post-addres
     1837                   ).
     1838                   run fmtcli-concatenate-strings in this-procedure (
     1839                         input v-fmtcli-post-addres
     1840                       , input string( buf_firm.ind )
     1841                       , input ", ":U
     1842                       , input 50
     1843                       , output v-fmtcli-post-addres
     1844                   ).
     1845                   run fmtcli-concatenate-strings in this-procedure (
     1846                         input substring( buf_firm.addres1, 1, 50 )
     1847                       , input buf_firm.addres2
     1848                       , input " ":U
     1849                       , input 50
     1850                       , output v-temp-fmtcli-address
     1851                   ).
     1852                   run fmtcli-concatenate-strings in this-procedure (
     1853                         input v-temp-fmtcli-address
     1854                       , input substring( buf_firm.addres1, 51, 50 )
     1855                       , input " ":U
     1856                       , input 50
     1857                       , output v-temp-fmtcli-address
     1858                   ).
     1859                   run fmtcli-concatenate-strings in this-procedure (
     1860                         input v-temp-fmtcli-address
     1861                       , input substring( buf_firm.addres1, 101, 50 )
     1862                       , input " ":U
     1863                       , input 50
     1864                       , output v-temp-fmtcli-address
     1865                   ).
     1866                   assign
     1867                       v-fmtcli-addres = v-temp-fmtcli-address
     1868                   .
     1869                   if buf_firm.addres1 <> ?
     1870                   then do:
     1871                       run fmtcli-concatenate-strings in this-procedure (
     1872                             input v-fmtcli-full-addres
     1873                           , input v-fmtcli-addres
     1874                           , input ", ":U
     1875                           , input 0
     1876                           , output v-fmtcli-full-addres
     1877                       ).
     1878                   end.
     1879                   run fmtcli-concatenate-strings in this-procedure (
     1880                         input substring( buf_firm.post-addr1, 1, 50 )
     1881                       , input buf_firm.post-addr2
     1882                       , input " ":U
     1883                       , input 50
     1884                       , output v-fmtcli-post-addres
     1885                   ).
     1886                   run fmtcli-concatenate-strings in this-procedure (
     1887                         input v-fmtcli-post-addres
     1888                       , input substring( buf_firm.post-addr1, 51, 50 )
     1889                       , input " ":U
     1890                       , input 50
     1891                       , output v-fmtcli-post-addres
     1892                   ).
     1893                   run fmtcli-concatenate-strings in this-procedure (
     1894                         input v-fmtcli-post-addres
     1895                       , input substring( buf_firm.post-addr1, 101, 50 )
     1896                       , input " ":U
     1897                       , input 50
     1898                       , output v-fmtcli-post-addres
     1899                   ).
     1900                   assign
     1901                       v-fmtcli-phone         = buf_firm.phone
     1902                       v-fmtcli-inn           = buf_firm.inn
     1903                       v-fmtcli-kpp           = buf_firm.kpp
     1904                       v-fmtcli-okpo          = buf_firm.okpo
     1905                       v-fmtcli-index         = string( buf_firm.ind )
     1906                   .
     1907               end.
     1908          end.
     1909          when 'маг':U
     1910          then do:
     1911               find first buf_shop no-lock
     1912                    where buf_shop.obj-code = buf_clients.obj-code
     1913               .
     1914               if available buf_shop
     1915               then do:
     1916                   run fmtcli-concatenate-strings in this-procedure (
     1917                         input buf_shop.addres1
     1918                       , input buf_shop.addres2
     1919                       , input " ":U
     1920                       , input 50
     1921                       , output v-fmtcli-addres
     1922                   ).
     1923                   assign
     1924                       v-fmtcli-full-addres = v-fmtcli-addres
     1925                       v-fmtcli-post-addres = v-fmtcli-addres
     1926                       v-fmtcli-phone       = buf_shop.phone
     1927                       v-fmtcli-inn         = "":U
     1928                       v-fmtcli-kpp         = "":U
     1929                       v-fmtcli-okpo        = "":U
     1930                       v-fmtcli-city        = "":U
     1931                       v-fmtcli-index       = "":U
     1932                   .
     1933               end.
     1934          end.
     1935          when 'скл':U
     1936          then do:
     1937               find first buf_store no-lock
     1938                    where buf_store.obj-code = buf_clients.obj-code
     1939               .
     1940               if available buf_store
     1941               then do:
     1942                   run fmtcli-concatenate-strings in this-procedure (
     1943                         input buf_store.addres1
     1944                       , input buf_store.addres2
     1945                       , input " ":U
     1946                       , input 50
     1947                       , output v-fmtcli-addres
     1948                   ).
     1949                   assign
     1950                       v-fmtcli-full-addres = v-fmtcli-addres
     1951                       v-fmtcli-phone       = buf_store.phone
     1952                       v-fmtcli-inn         = "":U
     1953                       v-fmtcli-kpp         = "":U
     1954                       v-fmtcli-okpo        = "":U
     1955                       v-fmtcli-city        = "":U
     1956                       v-fmtcli-index       = "":U
     1957                   .
     1958               end.
     1959          end.
     1960          when 'чел':U
     1961          then do:
     1962               find first buf_person no-lock
     1963                    where buf_person.psn-code = buf_clients.obj-code
     1964               .
     1965               if available buf_person
     1966               then do:
     1967                   run fmtcli-concatenate-strings in this-procedure (
     1968                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1969                                 then "":U
     1970                                 else string( buf_person.ind, "999999")
     1971                                 )
     1972                       , input buf_person.city
     1973                       , input ", ":U
     1974                       , input 0
     1975                       , output v-fmtcli-full-addres
     1976                   ).
     1977                   assign
     1978                       v-fmtcli-addres = buf_person.address
     1979                   .
     1980                   run fmtcli-concatenate-strings in this-procedure (
     1981                         input v-fmtcli-full-addres
     1982                       , input v-fmtcli-addres
     1983                       , input ", ":U
     1984                       , input 0
     1985                       , output v-fmtcli-full-addres
     1986                   ).
     1987                   assign
     1988                       v-fmtcli-phone     = buf_person.phone1
     1989                       v-fmtcli-inn       = buf_person.inn
     1990                       v-fmtcli-kpp       = buf_person.kpp
     1991                       v-fmtcli-okpo      = buf_person.okpo
     1992                       v-fmtcli-city      = buf_person.city
     1993                       v-fmtcli-index     = string( buf_person.ind )
     1994                   .
     1995               end.
     1996          end.
     1997       end case.
     1998   end.
     1999   end procedure.
     2000   procedure fmtcli-concatenate-strings :
     2001   define input parameter p-string-1       as character        no-undo.
     2002   define input parameter p-string-2       as character        no-undo.
     2003   define input parameter p-delimiter      as character        no-undo.
     2004   define input parameter p-length         as integer          no-undo.
     2005   define output parameter p-out-string    as character        no-undo.
     2006   do
     2007   on error undo, return error
     2008   :
     2009       assign
     2010           p-out-string = ( if p-string-1 = ?
     2011                            then "":U
     2012                            else trim( p-string-1 ) )
     2013       .
     2014       assign
     2015           p-out-string = p-out-string
     2016                        + ( if p-out-string = "":U
     2017                            or length( p-out-string ) = p-length
     2018                            or p-string-2 = ?
     2019                            or trim( p-string-2 ) = "":U
     2020                            then "":U
     2021                            else p-delimiter )
     2022                        + ( if p-string-2 = ?
     2023                            or trim( p-string-2 ) = "":U
     2024                            then "":U
     2025                            else trim( p-string-2 ) )
     2026       .
     2027   end.
     2028   end procedure.
