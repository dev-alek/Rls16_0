     2287                   v-exp-volume-piece-litres,
     2288                   if buf_tt.exp-fact-qnty = 0 and buf_tt.exp-volume-piece-litres = 0 then "" else string(fnc-fmt-dec-tc-qnty(buf_tt.exp-fact-qnty)),
     2289                   ""
     2290                   ).
     2291       output stream OutStr-html close.
     2292               end.
     2293       output stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8' .
     2294           put stream OutStr-html unformatted
     2295               substitute (
