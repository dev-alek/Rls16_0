        1   block-level on error undo, throw.
        2   define input parameter parParentProc as handle no-undo.
        3   define variable vss-revision    as character no-undo init "$Revision: 1f78fe327cdf, 1091, rls $":U .
        4   define variable vss-author      as character no-undo init "$Author: ASMorozov $":U .
        5   define variable vss-date        as character no-undo init "$Date: Thu Dec 14 02:13:52 2017 +0300 $":U .
        6   define variable vss-workfile    as character no-undo init "$Workfile: r-regbk-alc.p $":U .
