     2246               v-inc-total-quontity = fnc-fmt-dec-tc-litres(buf_tt.inc-total-quontity)
     2247               v-exp-volume-piece-litres = if buf_tt.exp-volume-piece-litres = 0 and buf_tt.exp-fact-qnty = 0 then "" else fnc-fmt-dec-tc-litres(buf_tt.exp-volume-piece-litres)
     2248               v-exp-total-quontity = fnc-fmt-dec-tc-litres(buf_tt.exp-total-quontity)
     2249           .
     2250       output stream OutStr-html to value(v-file-name-rep-htm) append convert target 'UTF-8'.
     2251           put stream OutStr-html unformatted
     2252               substitute(
     2253                       '<tr>
