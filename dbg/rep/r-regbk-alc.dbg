     2350   end procedure.
     2351   function fnc-fmt-dec-tc-litres returns character
     2352   (input p-number as decimal):
     2353       define variable result as character no-undo.
     2354       define variable v-str1 as character no-undo.
     2355       v-str1 = trim(replace(string(p-number,'>>>>9.99<'), ".", ",")).
     2356       return v-str1.
     2357   end function.
     2358   function fnc-fmt-dec-tc-qnty returns character
     2359   (input p-number as decimal):
     2360       define variable result as character no-undo.
     2361       define variable v-str1 as character no-undo.
     2362           v-str1 = trim(replace(string(p-number,'->>>>>>>9.9<<'), ".", ",")).
     2363       return v-str1.
     2364   end function.
     2365   do:
     2366       do:
