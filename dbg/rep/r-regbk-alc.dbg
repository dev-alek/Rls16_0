     2260                           <td style="border: 1px solid black;">&7</td>
     2261                           <td style="border: 1px solid black; text-align: right; padding: 3px;">&8</td>
     2262                           <td style="border: 1px solid black; text-align: right; padding: 3px;">&9</td>'
     2263                   ,
     2264                   buf_tt.cnt-line,
     2265                   buf_tt.alc-type-name,
     2266                   buf_tt.alc-type-code,
     2267                   buf_tt.cli-obj-name,
     2268                   buf_tt.inn,
     2269                   if buf_tt.date-trn = ? then "" else string(buf_tt.date-trn),
     2270                   buf_tt.doc-code,
     2271                   v-volume-piece-litres,
     2272                   if buf_tt.fact-qnty = 0 and buf_tt.volume-piece-litres = 0 then "" else string(fnc-fmt-dec-tc-qnty(buf_tt.fact-qnty))
     2273               )
     2274               +
     2275               substitute(
     2276                           '<td style="border-top: none; border-bottom: none; text-align: right; padding: 3px;">&1</td>
     2277                           <td style="border: 1px solid black; padding: 3px;">&2</td>
     2278                           <td style="border: 1px solid black; padding: 3px;">&3</td>
     2279                           <td style="border: 1px solid black; text-align: right;">&4</td>
