     1870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1871     (input  bf_trn-doc.obj-type
     1872     ,input  bf_trn-doc.obj-code
     1873     ,input  varb-code
     1874     ,input  0
     1875     ,input  bf_trn-doc.fact-order
     1876     ,output vardoc-num
     1877     ,output varprice-sale
     1878     ,output varroad-tax
     1879     ,output varexcise
     1880     )  .
     1881             if varprice-sale = ?
     1882             then do:
     1883               assign
     1884                 varprice-sale = 0
     1885                 varroad-tax   = 0
     1886                 varexcise     = 0
     1887               .
     1888             end.
     1889             assign
     1890               varlastcur-base     = varprice-sale
     1891               varlastcur-road-tax = varroad-tax
     1892               varlastcur-excise   = varexcise
     1893               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     1894               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     1895               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     1896               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     1897             .
     1898         end.
     1899       end.
     1900       if varcur-fact-qnty = 0 then do:
     1901         assign
     1902           varcur-base      = varlastcur-base
     1903           varcur-road-tax  = varlastcur-road-tax
     1904           varcur-excise    = varlastcur-excise
     1905         .
     1906       end.
     1907       else do:
     1908         assign
     1909           varcur-base      = varcur-base      / varcur-fact-qnty
     1910           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     1911           varcur-excise    = varcur-excise    / varcur-fact-qnty
     1912         .
     1913       end.
     1914       if varcur-vat-pc = ?
     1915       then do:
     1916         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1917       end.
     1918       if varcur-slt-pc = ?
     1919       then do:
     1920         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     1921       end.
     1922       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     1923       assign
