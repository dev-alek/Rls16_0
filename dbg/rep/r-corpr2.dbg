      663   end.
      664   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      665   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      666     (output varoutvprbcl
      667     )  .
      668   if varoutvprbcl = "base":u then do:
      669     assign
      670           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax * 1)
      671       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   * 1)
      672     .
      673   end.
      674   else do:
      675     assign
      676           road-tax-base-salecl    =  (if parroad-tax = ? then 0 else parroad-tax / parbase-rate * parbase-scale)
      677       excise-base-salecl      =  (if parexcise   = ? then 0 else parexcise   / parbase-rate * parbase-scale)
      678     .
      679   end.
      680   if varoutvprbcl = "rubl":u then do:
      681     assign
      682           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * 1)
      683       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * 1) .
      684   end.
      685   else do:
      686     assign
      687           road-tax-rubl-salecl    = (if parroad-tax = ? then 0 else parroad-tax * parbase-rate / parbase-scale)
      688       excise-rubl-salecl      = (if parexcise   = ? then 0 else parexcise   * parbase-rate / parbase-scale) .
      689   end.
      690   assign
      691     varis-cons-parts-havecl =  no.
      692   assign
      693     varfact-qntycl       = 0
      694     varcons-qntycl       = 0
      695     varprice-base-conscl = 0
      696     varprice-rubl-conscl = 0.
      697   find first out-vatp_doc-linecl where
      698              out-vatp_doc-linecl.doc-code   = pardoc-code
      699          and out-vatp_doc-linecl.artic      = parartic
      700          and out-vatp_doc-linecl.prod-type  = parprod-type
      701          and out-vatp_doc-linecl.prod-code  = parprod-code no-lock no-error.
      702   if available out-vatp_doc-linecl           and
