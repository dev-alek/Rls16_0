     2663   procedure create_obj-list :
     2664      define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2665      define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2666      do
     2667      on error undo, return error return-value
     2668      :
     2669         define buffer cli-obj for ub.clients .
     2670         define variable p-var as integer no-undo .
     2671         define buffer buf_obj-list for obj-list .
     2672         find last buf_obj-list  use-index pi no-error .
     2673         if available buf_obj-list
     2674         then
     2675            p-var = buf_obj-list.obj-id + 1.
     2676         else
     2677            p-var = 1.
     2678         find first cli-obj where
     2679                   cli-obj.obj-type = p-obj-type
     2680               and cli-obj.obj-code = p-obj-code
     2681         no-lock no-error.
     2682         if available cli-obj
     2683         then do:
     2684            create buf_obj-list.
     2685            assign
     2686               buf_obj-list.obj-id   = p-var
     2687               buf_obj-list.obj-code = cli-obj.obj-code
     2688               buf_obj-list.obj-type = cli-obj.obj-type
     2689               buf_obj-list.obj-name = cli-obj.obj-name
     2690               buf_obj-list.db-num   = cli-obj.db-num
     2691            .
     2692         end.
     2693      end.
     2694   end.
