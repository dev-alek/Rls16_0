     1936           and bf_parts.obj-type  = bf_doc-line.obj-type
     1937           and bf_parts.obj-code  = bf_doc-line.obj-code
     1938           and bf_parts.artic     = bf_doc-line.artic
     1939           and bf_parts.prod-type = bf_doc-line.prod-type
     1940           and bf_parts.prod-code = bf_doc-line.prod-code
     1941       on error undo, return error return-value
     1942       :
