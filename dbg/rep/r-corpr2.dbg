      794     varvatcons-base-factovpcl = 0
      795     vardsc-base-factovpcl     = 0
      796     varsum-base-docovpcl      = 0
      797     varslt-base-docovpcl      = 0
      798     varvat-base-docovpcl      = 0
      799     varvatcons-base-docovpcl  = 0
      800     vardsc-base-docovpcl      = 0
