      542   do on error undo, return error return-value :
      543   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
      544   for each bf_tt-allsum on error undo, return error return-value :
      545     delete bf_tt-allsum.
      546   end.
      547   assign
      548     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
      549     price-base-with-tax-loccl = cl_tt-clcparts.price-base
      550   .
      551   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      553     (output varinvprbcl
      554     )  .
      555     if cl_tt-clcparts.out-code = 'free-zone':U     or
      556        cl_tt-clcparts.out-code = 'out-zone':U   or
      557        cl_tt-clcparts.doc-type = 'акт':U then do:
      558       assign
      559         in-vatp-have-vat-sltcl = yes.
      560     end.
      561     else do:
      562       find first in-vatp_doc-attrcl no-lock
      563         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
      564           and in-vatp_doc-attrcl.attr-code = 'envd':U
      565         no-error .
      566       if not available in-vatp_doc-attrcl then do:
      567         assign
      568           in-vatp-have-vat-sltcl = yes.
      569       end.
      570       else do:
      571            in-vatp-have-vat-sltcl = no.
      572       end.
      573     end.
      574     assign
      575      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
      576      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
      577     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
      578              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
      579     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
      580             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
      581             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
      582             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
      583             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
      584             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
      585             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      586       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
      587     assign
      588       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
      589     assign
      590       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
      591       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
      592       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
      593       transport-cli-loccl  = 0
      594       other-cli-loccl      = 0
      595     .
      596   ASSIGN
      597             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
      598       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
      599   .
      600   if paris-doc then do:
      601     assign
      602       parartic     = cl_tt-clcparts.artic
      603       parprod-type = cl_tt-clcparts.prod-type
      604       parprod-code = cl_tt-clcparts.prod-code
      605       pardoc-type  = cl_tt-clcparts.doc-type
      606       pardoc-code  = cl_tt-clcparts.out-code
      607       parobj-type  = cl_tt-clcparts.obj-type
      608       parobj-code  = cl_tt-clcparts.obj-code.
      609   if parext-doc-type = 'ot':U or
      610      parext-doc-type = ?                 then do:
      611     assign
      612      out-vatp-have-vat-sltcl = yes.
      613   end.
      614   else do:
      615     find first out-vatp_doc-attrcl no-lock
      616       where out-vatp_doc-attrcl.doc-code  = pardoc-code
      617         and out-vatp_doc-attrcl.attr-code = 'envd':U
      618         no-error .
      619     if not available out-vatp_doc-attrcl then do:
      620       assign
      621         out-vatp-have-vat-sltcl = yes.
      622     end.
      623     else do:
      624        out-vatp-have-vat-sltcl = no.
      625     end.
      626   end.
      627   find first out-vatp_goodscl where out-vatp_goodscl.artic     = parartic     and
      628                                      out-vatp_goodscl.prod-type = parprod-type and
      629                                      out-vatp_goodscl.prod-code = parprod-code no-lock.
      630   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      631   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      632     (input  parartic
      633     ,input  parprod-type
      634     ,input  parprod-code
      635     ,output varroot-nodecl
      636     ) no-error .
      637   if error-status :error then do:
      638     message
      639       vss-workfile vss-revision vss-description skip
