     2156   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2157   procedure factord :
     2158     define input  parameter p-fact-date            as date    no-undo .
     2159     define input  parameter p-fact-time            as integer no-undo .
     2160     define input  parameter p-fact-num             as integer no-undo .
     2161     define input  parameter p-shift-date           as date    no-undo .
     2162     define input  parameter p-shift-num            as integer no-undo .
     2163     define input  parameter p-shift-on             as logical no-undo .
     2164     define output parameter p-fact-order           as decimal no-undo .
     2165     define output parameter p-shift-end-fact-order as decimal no-undo .
     2166     define output parameter p-day-end-fact-order   as decimal no-undo .
     2167     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     2168     if p-fact-date = ?
     2169     then do:
     2170       return error "Не указана фактическая дата" .
     2171     end.
     2172     define variable v-fact-date-num as integer no-undo .
     2173     assign
     2174       v-fact-date-num = integer(p-fact-date)
     2175     .
     2176     if p-fact-num = ?
     2177     or p-fact-num = 0
     2178     then do:
     2179       return error "Не задан p-fact-num " + string(p-fact-num) .
     2180     end.
     2181     if p-fact-num < 0
     2182     then do:
     2183       return error "Отрицательный fact-num " + string(p-fact-num) .
     2184     end.
     2185     if p-fact-num >= 100000000
     2186     then do:
     2187       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     2188     end.
     2189     if p-shift-on = true
     2190     then do:
     2191       if p-shift-date = ?
     2192       then do:
     2193         return error "Не задана дата смены" .
     2194       end.
     2195       if p-shift-num = ?
     2196       or p-shift-num = 0
     2197       then do:
     2198         return error "Не задан номер смены" .
     2199       end.
     2200     end.
     2201     else do:
     2202       assign
     2203         p-shift-date = p-fact-date
     2204         p-shift-num  = 24
     2205       .
     2206     end.
     2207     define variable v-shift-offset as integer no-undo .
     2208     if p-shift-date = p-fact-date
     2209     then do:
     2210       assign
     2211         v-shift-offset = 1
     2212       .
     2213     end.
     2214     if p-shift-date < p-fact-date
     2215     then do:
     2216       assign
     2217         v-shift-offset = 0
     2218       .
     2219     end.
     2220     if p-shift-date > p-fact-date
     2221     then do:
     2222       message
     2223         vss-workfile vss-revision vss-description skip
     2224         "Неправильная дата закрытия смены" skip
     2225         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     2226         view-as alert-box error .
     2227       undo, return error
     2228         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     2229           ,string(p-fact-date, '99/99/9999':U)
     2230           ,string(p-shift-date, '99/99/9999':U)
     2231           )
     2232       .
     2233     end.
     2234     if p-shift-num < 1
     2235     or p-shift-num > 24
     2236     then do:
     2237       message
     2238         vss-workfile vss-revision vss-description skip
     2239         "Неправильный номер смены" skip
     2240         "p-shift-num" p-shift-num skip
     2241         view-as alert-box error .
     2242       undo, return error return-value .
     2243     end.
     2244     assign
     2245       p-fact-order           = v-fact-date-num
     2246                              + v-shift-offset * 0.5
     2247                              + p-shift-num    * 0.02 - 0.01
     2248                              + p-fact-num     * 0.0000000001
     2249       p-shift-end-fact-order = v-fact-date-num
     2250                              + v-shift-offset * 0.5
     2251                              + p-shift-num    * 0.02
     2252       p-day-end-fact-order   = v-fact-date-num
     2253                              + 0.99
     2254     .
     2255     if p-fact-order           <= v-fact-date-num
     2256     or p-shift-end-fact-order <= v-fact-date-num
     2257     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     2258     or p-shift-end-fact-order >= p-day-end-fact-order
     2259     then do:
     2260       message
     2261         vss-workfile vss-revision vss-description skip
     2262         "Внутренняя ошибка при генерации фактического номера" skip
     2263         "p-fact-date"            p-fact-date            skip
     2264         "p-fact-time"            p-fact-time            skip
     2265         "p-fact-num"             p-fact-num             skip
     2266         "p-shift-date"           p-shift-date           skip
     2267         "p-shift-num"            p-shift-num            skip
     2268         "p-shift-on"             p-shift-on             skip
     2269         "p-shift-end-fact-order" p-shift-end-fact-order skip
     2270         "p-day-end-fact-order"   p-day-end-fact-order   skip
     2271         "v-fact-date-num"        v-fact-date-num        skip
     2272         view-as alert-box error .
     2273       undo, return error return-value .
     2274     end.
     2275   end procedure.
     2276   procedure day-begin-fact-order :
     2277     define input  parameter p-fact-date            as date    no-undo .
     2278     define output parameter p-day-begin-fact-order as decimal no-undo .
     2279     do
     2280     on error undo, return error return-value
     2281     :
     2282       if p-fact-date = ?
     2283       then do:
     2284         assign
     2285           p-day-begin-fact-order = 0
     2286         .
     2287       end.
     2288       else do:
     2289         assign
     2290           p-day-begin-fact-order = integer(p-fact-date)
     2291         .
     2292       end.
     2293     end.
     2294   end procedure.
     2295   procedure factord-max-fact-order :
     2296     define output parameter p-max-fact-order as decimal   no-undo .
     2297     do
     2298     on error undo, return error return-value
     2299     :
     2300       run day-begin-fact-order in this-procedure
     2301         (input  date(1, 1, 5000)
     2302         ,output p-max-fact-order
     2303         ) .
     2304     end.
     2305   end procedure.
     2306   procedure factord-cut-archive :
     2307     define input  parameter p-obj-type             as character no-undo .
     2308     define input  parameter p-obj-code             as integer   no-undo .
     2309     define input  parameter p-fact-date            as date      no-undo .
     2310     define output parameter p-shift-on             as logical   no-undo .
     2311     define output parameter p-shift-date           as date      no-undo .
     2312     define output parameter p-shift-num            as integer   no-undo .
     2313     define output parameter p-day-end-fact-order   as decimal   no-undo .
     2314     define output parameter p-shift-end-fact-order as decimal   no-undo .
     2315     define variable v-fact-order as decimal   no-undo .
     2316     define buffer buf_shift-obj for ub.shift-obj .
     2317     do
     2318     on error undo, return error return-value
     2319     :
     2320   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2321   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2322     (input  p-obj-type
     2323     ,input  p-obj-code
     2324     ,input  'shift-on=request'
     2325     ,output p-shift-on
     2326     ) no-error .
     2327       if error-status :error
     2328       then do:
     2329         message
     2330           vss-workfile vss-revision vss-description skip
     2331           "Ошибка при определении атрибута объекта" skip
     2332           "Объект" p-obj-type p-obj-code skip
     2333           error-status :get-message(1) skip
     2334           return-value skip
     2335           view-as alert-box error .
     2336         undo, return error return-value .
     2337       end.
     2338       if p-shift-on = false
     2339       then do:
     2340         assign
     2341           p-shift-date               = ?
     2342           p-shift-num                = 0
     2343         .
     2344       end.
     2345       else do:
     2346         find first buf_shift-obj share-lock
     2347           where buf_shift-obj.obj-type   = p-obj-type
     2348             and buf_shift-obj.obj-code   = p-obj-code
     2349             and buf_shift-obj.shift-date > p-fact-date
     2350           use-index pi
     2351           no-error .
     2352         if not available buf_shift-obj
     2353         or buf_shift-obj.status_ <> 'зкр':U
     2354         then do:
     2355           message
     2356             vss-workfile vss-revision vss-description skip
     2357             "Невозможно вычислить последнюю смену" skip
     2358             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     2359             "Объект" p-obj-type p-obj-code skip
     2360             "Дата" p-fact-date skip
     2361             view-as alert-box error .
     2362           undo, return error return-value .
     2363         end.
     2364         find last buf_shift-obj share-lock
     2365           where buf_shift-obj.obj-type = p-obj-type
     2366             and buf_shift-obj.obj-code = p-obj-code
     2367             and buf_shift-obj.shift-date <= p-fact-date
     2368           use-index pi
     2369           no-error .
     2370         if available buf_shift-obj
     2371         then do:
     2372           if  buf_shift-obj.status_ = 'зкр':U
     2373           then do:
     2374             assign
     2375               p-shift-date = buf_shift-obj.shift-date
     2376               p-shift-num  = buf_shift-obj.shift-num
     2377             .
     2378           end.
     2379           else do:
     2380             message
     2381               vss-workfile vss-revision vss-description skip
     2382               "Невозможно вычислить последнюю смену" skip
     2383               "Статус смены отличен от статуса" 'зкр':U skip
     2384               "Объект" p-obj-type p-obj-code skip
     2385               "Дата" p-fact-date skip
     2386               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     2387               view-as alert-box error .
     2388             undo, return error return-value .
     2389           end.
     2390         end.
     2391         else do:
     2392           assign
     2393             p-shift-date = p-fact-date - 1
     2394             p-shift-num  = 1
     2395           .
     2396         end.
     2397       end.
     2398       run factord in this-procedure
     2399         (input  p-fact-date
     2400         ,input  1
     2401         ,input  1
     2402         ,input  p-shift-date
     2403         ,input  p-shift-num
     2404         ,input  p-shift-on
     2405         ,output v-fact-order
     2406         ,output p-shift-end-fact-order
     2407         ,output p-day-end-fact-order
     2408         ) no-error .
     2409       if error-status :error
     2410       then do:
     2411         message
     2412           vss-workfile vss-revision vss-description skip
     2413           "Ошибка при вызове процедуры factord"
     2414           error-status :get-message(1) skip
     2415           return-value skip
     2416           view-as alert-box error .
     2417         undo, return error return-value .
     2418       end.
     2419     end.
     2420   end procedure.
     2421   procedure factord-lock-shift :
     2422     define input  parameter p-obj-type  as character no-undo .
     2423     define input  parameter p-obj-code  as integer   no-undo .
     2424     define input  parameter p-fact-date as date      no-undo .
     2425     define parameter buffer buf_shift-obj for ub.shift-obj .
     2426     define variable v-shift-on      as logical   no-undo .
     2427     define variable v-extra-message as character no-undo .
     2428     define variable v-error as character no-undo .
     2429     do
     2430     on error undo, return error return-value
     2431     :
     2432   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2434     (input  p-obj-type
     2435     ,input  p-obj-code
     2436     ,input  'shift-on=request'
     2437     ,output v-shift-on
     2438     ) no-error .
     2439       if error-status :error
     2440       then do:
     2441         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2442         undo, return error v-error .
     2443       end.
     2444       if v-shift-on = true
     2445       then do:
     2446         find first buf_shift-obj share-lock
     2447           where buf_shift-obj.obj-type   = p-obj-type
     2448             and buf_shift-obj.obj-code   = p-obj-code
     2449             and buf_shift-obj.shift-date > p-fact-date
     2450           use-index pi
     2451           no-error .
     2452         if not available buf_shift-obj
     2453         or buf_shift-obj.status_ <> 'зкр':U
     2454         then do:
     2455           find last buf_shift-obj
     2456             where buf_shift-obj.obj-type = p-obj-type
     2457               and buf_shift-obj.obj-code = p-obj-code
     2458               and buf_shift-obj.status_  = 'зкр':U
     2459             use-index stts
     2460             no-error .
     2461           if available buf_shift-obj
     2462           then do:
     2463             assign
     2464               v-extra-message =
     2465                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2466                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2467                               )
     2468             .
     2469           end.
     2470           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2471           undo, return error v-error .
     2472         end.
     2473       end.
     2474     end.
     2475   end procedure.
     2476   procedure factord-end-day :
     2477     define input  parameter p-fact-date            as date    no-undo .
     2478     define output parameter p-day-end-fact-order   as decimal no-undo .
     2479     do
     2480     on error undo, return error return-value
     2481     :
     2482       if p-fact-date = ?
     2483       then do:
     2484         return error "Не указана фактическая дата" .
     2485       end.
     2486       assign
     2487         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2488       .
     2489     end.
     2490   end procedure.
     2491   procedure factord-to-date :
     2492     define input  parameter p-fact-order as decimal no-undo .
     2493     define output parameter p-fact-date  as date    no-undo .
     2494     define variable v-ref-date  as date      no-undo .
     2495     define variable v-ref-delta as integer   no-undo .
     2496     do
     2497     on error undo, return error return-value
     2498     :
     2499       if p-fact-order = ?
     2500       or p-fact-order = 0
     2501       then do:
     2502         return error "Не указан fact-order" .
     2503       end.
     2504       assign
     2505         v-ref-date  = date(1, 1, 2000)
     2506       .
     2507       assign
     2508         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2509       .
     2510       assign
     2511         p-fact-date = v-ref-date + v-ref-delta
     2512       .
     2513     end.
     2514   end procedure.
     2515   procedure factord-to-fact-num :
     2516     define input  parameter p-fact-order as decimal no-undo .
     2517     define output parameter p-fact-num   as integer no-undo .
     2518     define variable v-fact-order-trunc as decimal no-undo .
     2519     do
     2520     on error undo, return error return-value
     2521     :
     2522       if p-fact-order = ?
     2523       or p-fact-order = 0
     2524       then do:
     2525         return error "Не указан fact-order" .
     2526       end.
     2527       assign
     2528        v-fact-order-trunc = truncate(p-fact-order, 2)
     2529       .
     2530       assign
     2531         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2532       .
     2533     end.
     2534   end procedure.
     2535   procedure factord-to-shift-num :
     2536     define input  parameter p-fact-order as decimal no-undo .
     2537     define output parameter p-shift-num   as integer no-undo .
     2538     define variable  p-shift-numd  as decimal   no-undo .
     2539     define variable v-fact-order-trunc as decimal no-undo .
     2540     do
     2541     on error undo, return error return-value
     2542     :
     2543       if p-fact-order = ?
     2544       or p-fact-order = 0
     2545       then do:
     2546         return error "Не указан fact-order" .
     2547       end.
     2548       assign
     2549        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2550       .
     2551       if v-fact-order-trunc < 0.5 then do:
     2552         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2553       end.
     2554       assign
     2555         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2556         .
     2557        assign
     2558         p-shift-num = truncate (p-shift-numd , 0)
     2559       .
     2560     end.
     2561   end procedure.
