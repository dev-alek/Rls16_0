     1976       run clcprtsl_calc-ttable in this-procedure
     1977         (input yes,
     1978          input yes,
     1979          input bf_doc-line.road-tax,
     1980          input bf_doc-line.excise,
     1981          input bf_doc-line.vat-pc,
     1982          input bf_doc-line.cons-vat-pc,
