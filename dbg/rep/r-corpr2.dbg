     2009   end.
     2010   procedure clcprtsl_calc-ttable :
     2011   define input parameter paris-doc           as   logical                 no-undo.
     2012   define input parameter paris-cur           as   logical                 no-undo.
     2013   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2014   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2015   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2016   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2017   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2018   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2019   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2020   define input parameter parr-b              as   character               no-undo.
     2021   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2022   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2023   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2024   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2025   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2026   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2027   define buffer bf_tt-allsum      for tt-allsum.
     2028   define buffer bf_tt-clcparts    for tt-clcparts.
     2029   define buffer bf_tt-allsum-line for tt-allsum-line.
     2030   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2031   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2032   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2033   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2034   define variable varexcise          like ub.price-list.excise     no-undo.
     2035   do on error undo, return error return-value :
     2036   for each bf_tt-allsum-line
     2037   on error undo, return error return-value
     2038    :
     2039     delete bf_tt-allsum-line.
     2040   end.
     2041   for each bf_tt-allsum
     2042   on error undo, return error return-value
     2043   :
     2044     delete bf_tt-allsum.
     2045   end.
     2046   for each bf_tt-clcparts
     2047   on error undo, return error return-value
     2048   :
     2049   if v-calcbypart then do:
     2050             assign
