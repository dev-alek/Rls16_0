      729     else do:
      730       find first in-vatp_doc-attrocl no-lock
      731         where in-vatp_doc-attrocl.doc-code  = out-vatp_partscl.out-code
      732           and in-vatp_doc-attrocl.attr-code = 'envd':U
      733         no-error .
