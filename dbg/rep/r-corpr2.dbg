      863       for each out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      864                                          out-vatp_gds-dtlcl.artic     = parartic     and
      865                                          out-vatp_gds-dtlcl.prod-type = parprod-type and
      866                                          out-vatp_gds-dtlcl.prod-code = parprod-code no-lock :
      867         if varoutvprbcl = "base":u then do:
      868           assign
      869             varcurclprice-base = out-vatp_gds-dtlcl.cur-base
      870             varcurclprice-rubl = out-vatp_gds-dtlcl.cur-base * ((out-vatp_gds-dtlcl.price-rubl - out-vatp_gds-dtlcl.discnt-rubl) / (out-vatp_gds-dtlcl.price-base - out-vatp_gds-dtlcl.discnt-base)).
      871         end.
      872         else do:
