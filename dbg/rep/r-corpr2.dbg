     1998           return-value skip
     1999           trim(error-status :get-message(1))
     2000           trim(error-status :get-message(2))
     2001           trim(error-status :get-message(3))
     2002           trim(error-status :get-message(4))
     2003           trim(error-status :get-message(5)) skip
     2004           view-as alert-box error.
