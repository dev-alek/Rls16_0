        1   block-level on error undo, throw.
        2   define input parameter p-cli-type as character no-undo .
        3   define input parameter p-cli-code as integer   no-undo .
        4   define input parameter v-doc-code as character no-undo .
        5   define input parameter sort-name  as integer   no-undo .
        6   define input parameter sort-gr    as logical   no-undo .
        7   define input parameter is_rem     as logical   no-undo .
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: r-corpr2.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: rep/r-corpr2.p $":U .
       13   define variable vss-description as character no-undo init "Печать счета-фактуры".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function breakstr returns character ( input        for-name    as character,
       80                                         input        line-length as integer,
       81                                         input-output line1       as character,
       82                                         input-output line2       as character ) :
       83     define variable ii as integer no-undo.
       84     if length( for-name ) > line-length then do:
       85       assign ii    = 1
       86              line1 = "":u
       87              line2 = "":u.
       88       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       89         assign line1 =       substring( for-name, 1, line-length     )
       90                line2 = trim( substring( for-name,    line-length + 1 ) ).
       91       end.                                                     else do:
       92         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       93           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       94                  ii    = ii    + 1.
       95           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       96             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       97           end.
       98         end.
       99         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      100       end.
      101     end.                                else do:
      102       assign line1 = for-name
      103              line2 = "":u.
      104     end.
      105     return ( line1 ).
      106   end function.
      107   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure tax-name:
      109   define input  parameter pardef-tax  as character           no-undo.
      110   define output parameter parname-tax as character initial ? no-undo.
      111   define buffer bf_tax for ub.tax.
      112   do on error undo, return error :
      113      case pardef-tax:
      114         when 'vat':U then do:
      115                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      116         end.
      117         when 'slt':U then do:
      118                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      119         end.
      120         when 'rdt':U then do:
      121                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      122         end.
      123         when 'exc':U then do:
      124                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      125         end.
      126         otherwise do:
      127            return error "Задан неверный параметр " + pardef-tax + " .".
      128         end.
      129      end case.
      130   end.
      131   end procedure.
