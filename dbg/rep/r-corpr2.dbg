      706   end.
      707   else do:
      708     for each out-vatp_partscl where out-vatp_partscl.out-code   = pardoc-code
      709                                  and out-vatp_partscl.obj-type   = parobj-type
      710                                  and out-vatp_partscl.obj-code   = parobj-code
      711                                  and out-vatp_partscl.artic      = parartic
      712                                  and out-vatp_partscl.prod-type  = parprod-type
      713                                  and out-vatp_partscl.prod-code  = parprod-code no-lock :
      714       if out-vatp_partscl.purch-code = 2 then do:
      715   assign
      716     price-rubl-with-tax-lococl = out-vatp_partscl.price-rubl
      717     price-base-with-tax-lococl = out-vatp_partscl.price-base
      718   .
      719   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      721     (output varinvprbocl
      722     )  .
      723     if out-vatp_partscl.out-code = 'free-zone':U     or
