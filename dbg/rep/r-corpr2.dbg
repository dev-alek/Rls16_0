      802     varslt-rubl-factovpcl     = 0
      803     varvat-rubl-factovpcl     = 0
      804     varvatcons-rubl-factovpcl = 0
      805     vardsc-rubl-factovpcl     = 0
      806     varsum-rubl-docovpcl      = 0
      807     varslt-rubl-docovpcl      = 0
      808     varvat-rubl-docovpcl      = 0
      809     varvatcons-rubl-docovpcl  = 0
      810     vardsc-rubl-docovpcl      = 0.
      811   assign
      812     varis-one-gds-dtlcl = no.
      813   find first out-vatp_gds-dtlcl where out-vatp_gds-dtlcl.doc-code  = pardoc-code  and
      814                                        out-vatp_gds-dtlcl.artic     = parartic     and
      815                                        out-vatp_gds-dtlcl.prod-type = parprod-type and
      816                                        out-vatp_gds-dtlcl.prod-code = parprod-code no-lock no-error.
      817   if available out-vatp_gds-dtlcl then do:
      818     find first buf_out-vatp_gds-dtlcl where buf_out-vatp_gds-dtlcl.doc-code  =  pardoc-code                and
      819                                              buf_out-vatp_gds-dtlcl.artic     =  parartic                   and
