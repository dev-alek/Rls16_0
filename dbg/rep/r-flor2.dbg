      526   define new shared  variable ch#Workbook         as com-handle no-undo .
      527   define new shared  variable ch#Worksheet        as com-handle no-undo .
      528   define new shared  variable Num#Str#            as integer no-undo.
      529   define new shared  variable Number-List         as integer no-undo init 1.
      530   define new shared  variable v-excel-file        as character no-undo .
      531   define variable Col-name as character  extent 256.
      532   define variable Col-format as character  extent 256.
      533   define variable Col-Post-format as character  extent 256.
      534   run proc-page0-assign in this-procedure .
      535   define variable v-del-1 as character no-undo .
      536   if  v-delim = " " or v-delim = ? or v-delim = ""  then do:
      537       run gbl/getlocal.p ( output v-delim  , output v-del-1, output v-sdate, output v-shortdate ) no-error .
      538       if error-status :error then do:
      539         message error-status :error error-status :get-message(1)
      540                 v-delim v-del-1.
      541           v-delim = ','  .
      542       end.
      543   end.
