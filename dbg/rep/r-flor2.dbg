     1187         ,output v-fillin_width
     1188         ,output v-fillin_height
     1189         ,output v-label
     1190         ,output v-user-can-edit
     1191         ,output v-output-display
     1192         ,output v-other
     1193         ) no-error .
     1194       if error-status :error then do:
     1195         undo, return error return-value .
     1196       end.
     1197       find first buf_doc-line-attr no-lock
     1198         where buf_doc-line-attr.doc-code  = p-doc-code
     1199           and buf_doc-line-attr.gds-code = p-gds-code
     1200           and buf_doc-line-attr.attr-code = p-code
     1201         no-error .
