     1364   procedure lineattr-delete-flora-all :
     1365     do
     1366     on error undo, return error return-value
     1367     :
     1368       define input  parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1369       define input  parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1370       define input  parameter p-prt-code    as integer   no-undo .
     1371       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1372       for each buf_doc-line-attr exclusive-lock
     1373         where buf_doc-line-attr.doc-code  = p-doc-code
     1374           and buf_doc-line-attr.gds-code  = p-gds-code
     1375           and buf_doc-line-attr.attr-code begins 'fl_gds-code':U + chr(44) + string(p-prt-code)  + chr(44)
     1376        :
     1377         delete buf_doc-line-attr.
     1378       end.
     1379    end.
     1380   end procedure.
     1381   procedure lineattr-exist-flora-gds :
     1382     do
     1383     on error undo, return error return-value
     1384     :
     1385       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1386       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1387       define input  parameter p-prt-code    as integer   no-undo .
     1388       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     1389       define output parameter p-exist as logical   no-undo .
     1390       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1391       p-exist = false .
     1392       find first buf_doc-line-attr no-lock
     1393         where buf_doc-line-attr.doc-code  = p-doc-code
     1394           and buf_doc-line-attr.gds-code  = p-gds-code
     1395           and buf_doc-line-attr.attr-code = 'fl_gds-code':U  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1396         no-error .
     1397       if avail buf_doc-line-attr then do:
     1398         assign
     1399          p-exist = true
     1400         .
     1401       end.
     1402     end.
     1403   end procedure.
     1404   procedure lineattr-write-add-line-cli :
     1405   define input  parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1406   define input  parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1407   define input  parameter p-cli-type      as character no-undo .
     1408   define input  parameter p-cli-code      as integer   no-undo .
     1409   define input  parameter p-contract-code as integer   no-undo .
     1410   define input  parameter p-host-code     as integer   no-undo .
     1411   define input  parameter p-exch-code     as integer   no-undo .
     1412   define input  parameter p-exch-rate     as decimal   no-undo .
     1413   define input  parameter p-exch-scale    as integer   no-undo .
     1414   define input  parameter p-sum-cli       as decimal   no-undo .
     1415   define input  parameter p-sum-vat       as decimal   no-undo .
     1416   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       find first buf_doc-line-attr exclusive-lock
     1421         where buf_doc-line-attr.doc-code  = p-doc-code
     1422           and buf_doc-line-attr.gds-code  = p-gds-code
     1423           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1424                                             chr(4) + p-cli-type +
     1425                                             chr(4) + string(p-cli-code) +
     1426                                             chr(4) + string(p-contract-code) +
     1427                                             chr(4) + string(p-host-code)
     1428         no-error .
     1429       if not available buf_doc-line-attr then do:
     1430         create buf_doc-line-attr .
     1431         assign
     1432           buf_doc-line-attr.doc-code  = p-doc-code
     1433           buf_doc-line-attr.gds-code  = p-gds-code
     1434           buf_doc-line-attr.attr-code = 'add-line-cli':U  +
     1435                                         chr(4) + p-cli-type +
     1436                                         chr(4) + string(p-cli-code) +
     1437                                         chr(4) + string(p-contract-code) +
     1438                                         chr(4) + string(p-host-code)
     1439         .
     1440       end.
     1441       assign
     1442         buf_doc-line-attr.attr-value =
     1443         string(p-exch-code)  + chr(4) +
     1444         string(p-exch-rate)  + chr(4) +
     1445         string(p-exch-scale) + chr(4) +
     1446         string(p-sum-cli)    + chr(4) +
     1447         string(p-sum-vat)
     1448         .
     1449     end.
     1450   end procedure.
     1451   procedure lineattr-value-add-line-cli :
     1452   define input   parameter p-doc-code      like  ub.doc-line-attr.doc-code   no-undo .
     1453   define input   parameter p-gds-code      like  ub.doc-line-attr.gds-code   no-undo .
     1454   define input   parameter p-cli-type      as character no-undo .
     1455   define input   parameter p-cli-code      as integer   no-undo .
     1456   define input   parameter p-contract-code as integer   no-undo .
     1457   define input   parameter p-host-code     as integer   no-undo .
     1458   define output  parameter p-exch-code     as integer   no-undo .
     1459   define output  parameter p-exch-rate     as decimal   no-undo .
     1460   define output  parameter p-exch-scale    as integer   no-undo .
     1461   define output  parameter p-sum-cli       as decimal   no-undo .
     1462   define output  parameter p-sum-vat       as decimal   no-undo .
     1463   define buffer buf_doc-line-attr for ub.doc-line-attr .
     1464     do
     1465     on error undo, return error return-value
     1466     :
     1467       find first buf_doc-line-attr exclusive-lock
     1468         where buf_doc-line-attr.doc-code  = p-doc-code
     1469           and buf_doc-line-attr.gds-code  = p-gds-code
     1470           and buf_doc-line-attr.attr-code = 'add-line-cli':U +
     1471                                             chr(4) + p-cli-type +
     1472                                             chr(4) + string(p-cli-code) +
     1473                                             chr(4) + string(p-contract-code) +
     1474                                             chr(4) + string(p-host-code)
     1475         no-error .
     1476       if available buf_doc-line-attr then do:
     1477        assign
     1478           p-exch-code  = integer ( entry (1 , buf_doc-line-attr.attr-value,  chr(4) ))
     1479           p-exch-rate  = decimal ( entry (2 , buf_doc-line-attr.attr-value, chr(4) ))
     1480           p-exch-scale = integer ( entry (3 , buf_doc-line-attr.attr-value, chr(4) ))
     1481           p-sum-cli    = decimal ( entry (4 , buf_doc-line-attr.attr-value, chr(4) ))
     1482           p-sum-vat    = decimal ( entry (5 , buf_doc-line-attr.attr-value, chr(4) ))
     1483          .
     1484        end.
     1485     end.
     1486   end procedure.
     1487   function lineattr-get-reason returns character ( buffer local-doc-line for ub.doc-line ) :
     1488     define variable v-code as character no-undo .
     1489     define variable v-type as character no-undo .
     1490     define variable v-gds-code as integer   no-undo .
     1491   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1492   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1493     (input  local-doc-line.artic
     1494     ,input  local-doc-line.prod-type
     1495     ,input  local-doc-line.prod-code
     1496     ,output v-gds-code
     1497     )  .
     1498     run lineattr-value (
     1499         input   local-doc-line.doc-code ,
     1500         input   v-gds-code              ,
     1501         input   'reason-code':U ,
     1502         output  v-code                  ,
     1503         output  v-type ) .
     1504     find first ub.trn-reason no-lock where
     1505                ub.trn-reason.reason-code = integer ( v-code ) no-error.
     1506     if not available ub.trn-reason then do:
     1507        return "" .
     1508     end.
     1509     else do:
     1510        return ub.trn-reason.reason-name .
     1511     end.
     1512   end function.
     1513   procedure lineattr-value-parts :
     1514     do
     1515     on error undo, return error return-value
     1516     :
     1517       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1518       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1519       define input  parameter p-part-code   as character no-undo .
     1520       define input  parameter p_in-code     as character no-undo .
     1521       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1522       define output parameter p-value       as    decimal   no-undo .
     1523       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1524       find first buf_doc-line-attr no-lock
     1525         where buf_doc-line-attr.doc-code  = p-doc-code
     1526           and buf_doc-line-attr.gds-code  = p-gds-code
     1527           and buf_doc-line-attr.attr-code = p-code  + chr(4) + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1528         no-error .
     1529       if avail buf_doc-line-attr then do:
     1530         assign
     1531           p-value = decimal( buf_doc-line-attr.attr-value)
     1532         .
     1533       end.
     1534       else do:
     1535         assign
     1536           p-value = 0
     1537         .
     1538       end.
     1539     end.
     1540   end procedure.
     1541   procedure lineattr-write-parts :
     1542     do
     1543     on error undo, return error return-value
     1544     :
     1545       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1546       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1547       define input parameter p-part-code  as character no-undo .
     1548       define input parameter p_in-code    as character no-undo .
     1549       define input parameter p-code       like ub.doc-line-attr.attr-code  no-undo .
     1550       define input parameter p-value      as decimal   no-undo .
     1551       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1552       find first buf_doc-line-attr exclusive-lock
     1553         where buf_doc-line-attr.doc-code  = p-doc-code
     1554           and buf_doc-line-attr.gds-code  = p-gds-code
     1555           and buf_doc-line-attr.attr-code = p-code + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1556         no-error .
     1557       if not available buf_doc-line-attr then do:
     1558         create buf_doc-line-attr .
     1559         assign
     1560           buf_doc-line-attr.doc-code  = p-doc-code
     1561           buf_doc-line-attr.gds-code  = p-gds-code
     1562           buf_doc-line-attr.attr-code = p-code  + chr(4)  + trim(p-part-code)  + chr(4) + trim(p_in-code)
     1563         .
     1564       end.
     1565       assign
     1566         buf_doc-line-attr.attr-value = string( p-value )
     1567       .
     1568     end.
     1569   end procedure.
     1570   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1571   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1572   procedure paramls-clear :
