     1173       define output parameter p-exist   as logical  no-undo .
     1174       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1175       def var v-type           as character no-undo .
     1176       def var v-format         as character no-undo .
     1177       def var v-fillin_width   as integer   no-undo .
