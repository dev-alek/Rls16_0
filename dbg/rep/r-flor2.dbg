     1203         p-exist = yes.
     1204       end.
     1205     end.
     1206   end procedure.
     1207   procedure lineattr-delete :
     1208     do
     1209     on error undo, return error return-value
     1210     :
     1211       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1212       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1213       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1214       define output parameter p-deleted  as logical no-undo.
     1215       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1216       def var v-type           as character no-undo .
     1217       def var v-format         as character no-undo .
     1218       def var v-fillin_width   as integer   no-undo .
     1219       def var v-fillin_height  as integer   no-undo .
     1220       def var v-label          as character no-undo .
     1221       def var v-user-can-edit  as logical   no-undo .
     1222       def var v-output-display as logical   no-undo .
     1223       def var v-other          as character no-undo .
     1224       run lineattr-code in this-procedure
     1225         (input  p-code
     1226         ,output v-type
     1227         ,output v-format
     1228         ,output v-fillin_width
     1229         ,output v-fillin_height
     1230         ,output v-label
     1231         ,output v-user-can-edit
     1232         ,output v-output-display
     1233         ,output v-other
     1234         ) no-error .
     1235       if error-status :error then do:
     1236         undo, return error return-value .
     1237       end.
     1238       find first buf_doc-line-attr exclusive-lock
     1239         where buf_doc-line-attr.doc-code  = p-doc-code
     1240           and buf_doc-line-attr.gds-code  = p-gds-code
     1241           and buf_doc-line-attr.attr-code = p-code
     1242         no-error NO-WAIT.
     1243       if not available buf_doc-line-attr then do:
     1244         p-deleted = no.
     1245       end.
     1246       else do:
     1247         delete buf_doc-line-attr.
     1248         p-deleted = yes.
     1249       end.
     1250     end.
     1251   end procedure.
     1252   procedure lineattr-code :
     1253     do on error undo, return error return-value
     1254     :
     1255       define input  parameter p-code           as character no-undo .
     1256       define output parameter p-type           as character no-undo .
     1257       define output parameter p-format         as character no-undo .
     1258       define output parameter p-fillin_width   as integer   no-undo .
     1259       define output parameter p-fillin_height  as integer   no-undo .
     1260       define output parameter p-label          as character no-undo .
     1261       define output parameter p-user-can-edit  as logical   no-undo .
     1262       define output parameter p-output-display as logical   no-undo .
     1263       define output parameter p-other          as character no-undo .
     1264       case p-code :
     1265               when 'parts_price-sale':U then do:     assign     p-label          = "Продажная цена партии"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Продажная цена партии"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1266               when 'fl_gds-code':U then do:     assign     p-label          = "Количество по букету"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Количество по букету"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1267               when 'old_other-ras':U then do:     assign     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Первым способом из ПН Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1268               when 'new_other-ras':U then do:     assign     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = " Способом из ДопРасх Сумма дополнительных расходов по строке rubl base"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1269               when 'flora_ps':U then do:     assign     p-label          = "Описание не товарной позиции"     p-type           = 'C':U      p-format         = "x(70)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Описание не товарной позиции"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1270               when 'country-code':U then do:     assign     p-label          = "Страна"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Страна"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1271               when 'add-line-cli':U then do:     assign     p-label          = "Курс . шкала . сумма . НДС "     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 12     p-fillin_height  = 1     p-label          = "Курс . шкала . сумма . НДС "     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1272               when 'corr-price-sale':U then do:     assign     p-label          = "Продажная цена в строке ПН"     p-type           = 'C':U      p-format         = "x(100)"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Продажная цена в строке ПН"     p-user-can-edit  = false     p-output-display = false     p-other          = '':u      .   end.
     1273               when 'reason-code':U then do:     assign     p-label          = "Причина отклонения"     p-type           = 'I':U      p-format         = "->>>>>>>>9"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Причина отклонения"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1274               when 'price-prod':U then do:     assign     p-label          = "Цена производителя Без НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя Без НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1275               when 'price-prodvat':U then do:     assign     p-label          = "Цена производителя c НДС"     p-type           = 'D':U      p-format         = ">>>>>>>>9.99"     p-fillin_width   = 10     p-fillin_height  = 1     p-label          = "Цена производителя c НДС"     p-user-can-edit  = true     p-output-display = true     p-other          = '':u      .   end.
     1276         otherwise do:
     1277           undo, return error "неизвестный атрибут строки документа" + " " + p-code .
     1278         end.
     1279       end.
     1280     end.
     1281   end procedure.
     1282   procedure lineattr-value-flora-gds :
     1283     do
     1284     on error undo, return error return-value
     1285     :
     1286       define input  parameter p-doc-code    like  ub.doc-line-attr.doc-code   no-undo .
     1287       define input  parameter p-gds-code    like  ub.doc-line-attr.gds-code   no-undo .
     1288       define input  parameter p-prt-code    as integer   no-undo .
     1289       define input  parameter p-bk-gds-code like  ub.doc-line-attr.gds-code   no-undo .
     1290       define input  parameter p-code        like  ub.doc-line-attr.attr-code  no-undo .
     1291       define output parameter p-value       as    decimal   no-undo .
     1292       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1293       find first buf_doc-line-attr no-lock
     1294         where buf_doc-line-attr.doc-code  = p-doc-code
     1295           and buf_doc-line-attr.gds-code  = p-gds-code
     1296           and buf_doc-line-attr.attr-code = p-code  + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1297         no-error .
     1298       if avail buf_doc-line-attr then do:
     1299         assign
     1300           p-value = decimal( buf_doc-line-attr.attr-value)
     1301         .
     1302       end.
     1303       else do:
     1304         assign
     1305           p-value = 0
     1306         .
     1307       end.
     1308     end.
     1309   end procedure.
     1310   procedure lineattr-write-flora-gds :
     1311     do
     1312     on error undo, return error return-value
     1313     :
     1314       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1315       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1316       define input parameter p-prt-code    as integer   no-undo .
     1317       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1318       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1319       define input parameter p-value    as decimal   no-undo .
     1320       define buffer buf_doc-line-attr for ub.doc-line-attr .
     1321       find first buf_doc-line-attr exclusive-lock
     1322         where buf_doc-line-attr.doc-code  = p-doc-code
     1323           and buf_doc-line-attr.gds-code  = p-gds-code
     1324           and buf_doc-line-attr.attr-code = p-code + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1325         no-error .
     1326       if not available buf_doc-line-attr then do:
     1327         create buf_doc-line-attr .
     1328         assign
     1329           buf_doc-line-attr.doc-code  = p-doc-code
     1330           buf_doc-line-attr.gds-code  = p-gds-code
     1331           buf_doc-line-attr.attr-code = p-code  + chr(44)  + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1332         .
     1333       end.
     1334       assign
     1335         buf_doc-line-attr.attr-value = string( p-value )
     1336       .
     1337     end.
     1338   end procedure.
     1339   procedure lineattr-delete-flora-gds :
     1340     do
     1341     on error undo, return error return-value
     1342     :
     1343       define input parameter p-doc-code like ub.doc-line-attr.doc-code   no-undo .
     1344       define input parameter p-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1345       define input  parameter p-prt-code    as integer   no-undo .
     1346       define input parameter p-bk-gds-code like ub.doc-line-attr.gds-code   no-undo .
     1347       define input parameter p-code     like ub.doc-line-attr.attr-code  no-undo .
     1348       define output parameter p-deleted  as logical no-undo.
     1349       define buffer buf_doc-line-attr for ub.doc-line-attr .
