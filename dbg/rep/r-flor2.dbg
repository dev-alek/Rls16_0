     2266    num#str# = num#str# + 1.  run macr_excel_char ( "Скидка клиента          :" + string( nakl_trn-doc.discnt-rubl, ">>>>>>>>>9.99")                    , num#str# , num#col# ).
     2267    num#str# = num#str# + 1.  run macr_excel_char ( "Стоимость доставки      :" + v-deliv                                                               , num#str# , num#col#   ) .
     2268    num#str# = num#str# + 1.  run macr_excel_char ( "ИТОГО ПО ЗАКАЗУ         :" + string(round( decimal (v-itoggo),2 ))                       , num#str# , num#col# ).
     2269   end.
     2270   else do:
     2271   num#str# = num#str# + 1.
     2272   num#col# = 1.
     2273    num#str# = num#str# + 1.  run macr_excel_char ( "Итого со скидкой :" + string(v-all-sum , ">>>>>>>>>9.99")                                , num#str# , num#col# ).
     2274    num#str# = num#str# + 1.  run macr_excel_char ( "Наценка :" + string(v-procs, ">>>>>>>>>9.99")                                   , num#str# , num#col# ).
     2275    num#str# = num#str# + 1.  run macr_excel_char ( "ИТОГО С УЧЕТОМ НАЦЕНКИ :" + string(v-proci, ">>>>>>>>>9.99")                             , num#str# , num#col# ).
     2276    num#str# = num#str# + 1.  run macr_excel_char ( "Стоимость доставки      :" + v-deliv                                            , num#str# , num#col#   ) .
     2277    num#str# = num#str# + 1.  run macr_excel_char ( "ИТОГО ПО ЗАКАЗУ :" + string(round( decimal (v-itoggo),2 ))         , num#str# , num#col# ).
     2278   end.
     2279   output stream OutStream CLOSE .
     2280   run waitfram-hide .
     2281     run paramls-write in this-procedure
     2282       (input "file"
     2283       ,input string(v-ind)
     2284       ,input v-file-name
     2285       ) .
     2286   run end-proc in this-procedure .
     2287   Output stream Macr_Excel  close .
     2288       run paramls-write in this-procedure
     2289           (input "charcol"
     2290           ,input ""
     2291           ,input "1,2,3,4,5"
     2292           ) .
     2293   define variable v-user-action as character no-undo .
     2294   define variable v-printed     as logical   no-undo .
     2295    make-excel = true      .
     2296    make-excel-com = false  .
     2297   run rep/runexcel.p ( v-file-name).
     2298   PROCEDURE on-same-page :
     2299     define input parameter p-line-number as integer  no-undo .
     2300     if p-line-number > page-size( OutStream ) then do:
     2301       return .
     2302     end.
     2303     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2304       page stream OutStream .
     2305     end.
     2306   end procedure.
     2307   procedure sost :
     2308     do
     2309     on error undo, return error return-value
     2310     :
     2311   define input  parameter p-bk-gds-code as integer   no-undo .
     2312   define output parameter v-all-sum as decimal   no-undo .
     2313   define variable v-cost as decimal   no-undo .
     2314   define variable v-dis as decimal   no-undo .
     2315   v-all-sum = 0 .
     2316   define variable v-qnty       as    decimal   no-undo .
     2317   define variable v-exist as logical   no-undo .
     2318   put stream outstream    "Составляющие:"  format "x(100)"  skip.
     2319        num#str# = num#str# + 1.
     2320        num#col# = 1. run macr_excel_char ("Составляющие:", num#str# , num#col# ).
     2321   for each buf_gds-dtl no-lock where buf_gds-dtl.doc-code = nakl_trn-doc.doc-code :
     2322       find first buf_goods no-lock
     2323           where buf_goods.artic      = buf_gds-dtl.artic
     2324             and buf_goods.prod-type  = buf_gds-dtl.prod-type
     2325             and buf_goods.prod-code  = buf_gds-dtl.prod-code .
     2326   run lineattr-exist-flora-gds in this-procedure (
     2327       input  buf_gds-dtl.doc-code    ,
     2328       input  buf_goods.gds-code      ,
     2329       input  buf_gds-dtl.prt-code    ,
     2330       input  p-bk-gds-code           ,
     2331       output v-exist                 ).
     2332   if v-exist = false then next.
     2333   run lineattr-value-flora-gds    (
     2334       input  buf_gds-dtl.doc-code    ,
     2335       input  buf_goods.gds-code      ,
     2336       input  buf_gds-dtl.prt-code    ,
     2337       input  p-bk-gds-code           ,
     2338       input  'fl_gds-code':U ,
     2339       output v-qnty                      ).
     2340       if v-qnty < 0 then next.
     2341       find first ub.gds-prt where ub.gds-prt.node-code = buf_gds-dtl.prt-code no-error .
     2342       if buf_trn-doc.exch-code = 0 then  assign
     2343                                            v-cost = buf_gds-dtl.price-rubl
     2344                                            v-dis  = buf_gds-dtl.discnt-rubl * v-qnty
     2345                                            .
     2346                                    else
     2347                                           assign
     2348                                             v-cost = buf_gds-dtl.price-base
     2349                                             v-dis  = buf_gds-dtl.discnt-base * v-qnty
     2350                                           .
     2351       put stream outstream  unformatted
     2352       buf_goods.artic at 1
     2353       caps(buf_goods.gds-name) + "-" + ub.gds-prt.f-name    format "x(50)"     at 11
     2354       "кол-во: " + string (v-qnty, ">>>>>9.99")     at 70
     2355       "по цене " + string (v-cost, ">>>>>9.99")     at 90
     2356       skip.
     2357        num#str# = num#str# + 1.
     2358        num#col# = 1. run macr_excel_char (buf_goods.artic, num#str# , num#col# ).
     2359        num#col# = 2. run macr_excel_char (caps(buf_goods.gds-name) + "-" + ub.gds-prt.f-name, num#str# , num#col# ).
     2360        num#col# = 6. run macr_excel_char ("кол-во: ", num#str# , num#col# ).
     2361        num#col# = 7. run macr_excel_dec (  v-qnty , num#str# , num#col# ).
     2362        num#col# = 8. run macr_excel_char ("по цене: ", num#str# , num#col# ).
     2363        num#col# = 9. run macr_excel_dec (  round(v-cost,2) , num#str# , num#col# ).
     2364       v-all-sum =  v-all-sum + ( v-qnty * v-cost ) - v-dis .
     2365   end.
     2366     end.
     2367   end procedure.
     2368   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2369   procedure macr_excel_char :
     2370    do
     2371    on error undo, return error return-value
     2372    :
     2373    define input parameter  p-val as character no-undo .
     2374    define input parameter  p-row as integer no-undo .
     2375    define input parameter  p-col as integer no-undo .
     2376    if p-val = ? then p-val = "" .
     2377       put stream macr_excel unformatted
     2378             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2379    end.
     2380   end procedure.
     2381   procedure macr_excel_char_with_format :
     2382    do
     2383    on error undo, return error return-value
     2384    :
     2385    define input parameter  p-val as character no-undo .
     2386    define input parameter  p-row as integer no-undo .
     2387    define input parameter  p-col as integer no-undo .
     2388    if p-val = ? then p-val = "" .
     2389       put stream macr_excel unformatted
     2390             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2391       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2392       put stream macr_excel unformatted
     2393             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2394    end.
     2395   end procedure.
     2396   procedure macr_excel_cell_format :
     2397    do
     2398    on error undo, return error return-value
     2399    :
     2400    define input parameter  p-val    as character no-undo .
     2401    define input parameter  p-row    as integer   no-undo .
     2402    define input parameter  p-col    as integer   no-undo .
     2403    define input parameter  p-format as character no-undo .
     2404    if p-val = ? then p-val = "" .
     2405       put stream macr_excel unformatted
     2406             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2407       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2408       put stream macr_excel unformatted
     2409             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2410    end.
     2411   end procedure.
     2412   procedure macr_excel_sum :
     2413    do
     2414    on error undo, return error return-value
     2415    :
     2416    define input parameter  p-row as integer no-undo .
     2417    define input parameter  p-col as integer no-undo .
     2418    define input parameter  p-row1 as integer no-undo .
     2419    define input parameter  p-col1 as integer no-undo .
     2420    define input parameter  p-row2 as integer no-undo .
     2421    define input parameter  p-col2 as integer no-undo .
     2422       put stream macr_excel unformatted
     2423             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2424    end.
     2425   end procedure.
     2426   procedure macr_excel_dec :
     2427    do
     2428    on error undo, return error return-value
     2429    :
     2430    define input parameter  p-val as character no-undo .
     2431    define input parameter  p-row as integer   no-undo .
     2432    define input parameter  p-col as integer   no-undo .
     2433     if p-val = ? then p-val =  "" .
     2434      put  stream macr_excel unformatted
     2435           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2436    end.
     2437   end procedure.
     2438   procedure macr_cell_format :
     2439    do
     2440    on error undo, return error return-value
     2441    :
     2442    define input parameter  p-size   as integer   no-undo .
     2443    define input parameter  p-bold   as logical   no-undo .
     2444    define input parameter  p-italic as logical   no-undo .
     2445    define input parameter  p-color  as integer   no-undo .
     2446    define input parameter  p-row    as integer   no-undo .
     2447    define input parameter  p-col    as integer   no-undo .
     2448    define input parameter  p-row-2  as integer   no-undo .
     2449    define input parameter  p-col-2  as integer   no-undo .
     2450     if p-size = ? then p-size = 10 .
     2451     if p-bold = ? then p-bold = false .
     2452     if p-italic = ? then p-italic = false .
     2453     if p-row-2 = ? then p-row-2 = p-row .
     2454     if p-col-2 = ? then p-col-2 = p-col .
     2455     put  stream macr_excel unformatted
     2456      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2457     if p-color <> ? then do:
     2458        put  stream macr_excel unformatted
     2459          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2460     end.
     2461     put  stream macr_excel unformatted
     2462          substitute('format.font(,&1,&2,&3)' , p-size,
     2463                                           string ( p-bold  , "true/false" ) ,
     2464                                           string ( p-italic , "true/false" )
     2465                                           ) + chr(10) .
     2466    end.
     2467   end procedure.
     2468   procedure macr_cell_size :
     2469    do
     2470    on error undo, return error return-value
     2471    :
     2472    define input parameter  p-w   as integer   no-undo .
     2473    define input parameter  p-l   as integer   no-undo .
     2474    define input parameter  p-row    as integer   no-undo .
     2475    define input parameter  p-col    as integer   no-undo .
     2476    define input parameter  p-row-2  as integer   no-undo .
     2477    define input parameter  p-col-2  as integer   no-undo .
     2478     if p-row-2 = ? then p-row-2 = p-row .
     2479     if p-col-2 = ? then p-col-2 = p-col .
     2480     if p-w = ? then    p-w = 0 .
     2481     if p-l = ? then    p-l = 0 .
     2482    define variable s-w as character no-undo .
     2483    define variable s-l as character no-undo .
     2484    if p-w = 0 then s-w = "" .
     2485               else s-w = string(p-w)  .
     2486    if p-l = 0 then s-l = "" .
     2487               else s-l = string(p-l)  .
     2488   put  stream macr_excel unformatted
     2489        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2490   put  stream macr_excel unformatted
     2491        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2492   put  stream macr_excel unformatted
     2493        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2494    end.
     2495   end procedure.
     2496   procedure proc-print-header :
     2497    do
     2498    on error undo, return error return-value
     2499    :
     2500      find first sheetf .
     2501        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2502        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2503        var-1 =  num#str# .
     2504        repeat c-c = 1 to sheetf.excel-row-title :
     2505        num#str# = num#str# + 1 .
     2506        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2507        do c-i = 1 to p-var :
     2508           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2509           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2510           num#col# = c-i .
     2511           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2512           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2513        end.
     2514       c-i = 0.
     2515       end.
     2516       run macr_cell_format (
     2517           10       ,
     2518           true     ,
     2519           false    ,
     2520           35       ,
     2521           var-1 + 1,
     2522           1        ,
     2523           num#str# ,
     2524           num#col# )
     2525           .
     2526     put  stream macr_excel unformatted
     2527          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2528          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2529          .
     2530    end.
     2531   end procedure.
     2532   procedure end-proc :
     2533    do
     2534    on error undo, return error return-value
     2535    :
     2536     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2537     OUTPUT to VALUE (v-file-name) .
     2538     for each temp-param :
     2539       export  temp-param  .
     2540     end.
     2541    end.
     2542   end procedure.
