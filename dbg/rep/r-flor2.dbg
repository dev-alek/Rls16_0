      375   procedure create_obj-list :
      376      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      377      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      378      do
      379      on error undo, return error return-value
      380      :
      381         define buffer cli-obj for ub.clients .
      382         define variable p-var as integer no-undo .
      383         define buffer buf_obj-list for obj-list .
      384         find last buf_obj-list  use-index pi no-error .
      385         if available buf_obj-list
      386         then
      387            p-var = buf_obj-list.obj-id + 1.
      388         else
      389            p-var = 1.
      390         find first cli-obj where
      391                   cli-obj.obj-type = p-obj-type
      392               and cli-obj.obj-code = p-obj-code
      393         no-lock no-error.
      394         if available cli-obj
      395         then do:
      396            create buf_obj-list.
      397            assign
      398               buf_obj-list.obj-id   = p-var
      399               buf_obj-list.obj-code = cli-obj.obj-code
      400               buf_obj-list.obj-type = cli-obj.obj-type
      401               buf_obj-list.obj-name = cli-obj.obj-name
      402               buf_obj-list.db-num   = cli-obj.db-num
      403            .
      404         end.
      405      end.
      406   end.
