     1351         where buf_doc-line-attr.doc-code  = p-doc-code
     1352           and buf_doc-line-attr.gds-code  = p-gds-code
     1353           and buf_doc-line-attr.attr-code = p-code + chr(44) + string(p-prt-code)  + chr(44) + string(p-bk-gds-code)
     1354         no-error NO-WAIT.
