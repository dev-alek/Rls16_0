      363   def
      364   new shared
      365   temp-table  obj-list no-undo
      366     field obj-type like ub.clients.obj-type
      367     field obj-code like ub.clients.obj-code
      368     field obj-name like ub.clients.obj-name
      369     field obj-id   as integer
