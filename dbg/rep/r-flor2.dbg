     2183   num#str# = 21.  num#col# = 1.    run macr_excel_char ("Доставка "  + ( if v-ord_dl = "yes"  then "ДА" else "НЕТ")                 , num#str# , num#col#   ) .
     2184   run macr_cell_format ( 10 , true , false, ?, num#str#, num#col#, num#str#, num#col# ).
     2185   num#str# = 22.  num#col# = 1.    run macr_excel_char ("Куда                 :" + substring(v-ord_adr,1,50 )                          , num#str# , num#col#   ) .
     2186   if length(v-ord_adr) > 50 then do:
