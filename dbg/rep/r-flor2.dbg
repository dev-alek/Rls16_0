     1948                          output v-type )  .
     1949   v-itoggo = "" .
     1950   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input nakl_trn-doc.doc-code ,
     1951                           input 'discnt-stop':U ,
     1952                          output v-itoggo ,
     1953                          output v-type )  .
     1954   if session :set-wait-state( "compiler" ) then.
     1955   output STREAM OutStream to value( string( session:temp-directory +
     1956                                        "rpt" + string( g#report-num ) ) )
     1957                                        page-size  value(62) .
     1958   assign
     1959     Line    = fill("-", 136)
     1960     UndLine = fill("_", 136)
     1961     LineBuf = fill("_", 136) .
     1962       Output stream Macr_Excel  close .
     1963       num#str# = 0 .
     1964       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1965       output stream macr_excel to value(v-file-name)   .
     1966       v-ind = v-ind + 1.
     1967   if buf_trn-doc.exch-code = 0 then
     1968       assign
     1969           PrintRubl = true
     1970           pp = "руб"
     1971       .
     1972   else do:
     1973      FIND ub.currency NO-LOCK WHERE ub.currency.curr-code = buf_trn-doc.exch-code.
     1974      assign
     1975           PrintRubl = false
     1976           pp = ub.currency.curr-abbr
     1977           .
     1978           end.
     1979   .
     1980   run waitfram-show ( 'Подождите ...' ) .
     1981   FIND This_Object  WHERE This_Object.obj-type = store-type
     1982                       AND This_Object.obj-code = store-code NO-LOCK.
     1983   FIND ub.clients  WHERE ub.clients.obj-type = 'орг':U
     1984                   AND ub.clients.obj-code = buf_trn-doc.host-code NO-LOCK.
     1985   Case buf_trn-doc.cli-type :
     1986       when  'орг':U then do :
     1987           FIND ub.firm  WHERE ub.firm.firm-code = buf_trn-doc.cli-code NO-LOCK.
     1988           Assign
     1989             B-adress = ub.firm.addres1
     1990             b-phone  = ub.firm.phone .
     1991           end.
     1992       when  'чел':U then do :
     1993           FIND ub.person  WHERE ub.person.psn-code = buf_trn-doc.cli-code NO-LOCK.
     1994           Assign
     1995             B-adress = ub.person.address
     1996             b-phone  = ub.person.phone1 .
     1997           end.
     1998       when  'маг':U then do :
     1999           FIND ub.shop  WHERE ub.shop.obj-code = buf_trn-doc.cli-code NO-LOCK.
     2000           Assign
     2001             B-adress = ub.shop.addres1
     2002             b-phone  = ub.shop.phone .
     2003           end.
     2004       when  'скл':U then do :
     2005           FIND ub.store  WHERE ub.store.obj-code = buf_trn-doc.cli-code NO-LOCK.
     2006           Assign
     2007             B-adress = ub.store.addres1
     2008             b-phone  = ub.store.phone .
     2009           end.
     2010    End case.
     2011   define variable v-manag    as character no-undo initial "".
     2012   define variable v-type-pay as character no-undo initial "".
     2013   define buffer mn_clients for ub.clients.
     2014   find first mn_clients no-lock where mn_clients.obj-code = buf_trn-doc.boss and
     2015                                       mn_clients.obj-type = 'чел':U no-error .
     2016   if available mn_clients then v-manag  = mn_clients.obj-name.
     2017   find first ub.pay-type no-lock where ub.pay-type.obj-code = buf_trn-doc.pay-code no-error .
     2018   if available ub.pay-type then v-type-pay  = ub.pay-type.obj-name.
     2019   define buffer cl_clients for  ub.clients.
     2020   FIND cl_clients  WHERE cl_clients.obj-type = buf_trn-doc.cli-type
     2021                      AND cl_clients.obj-code = buf_trn-doc.cli-code NO-LOCK.
     2022       case clients.obj-type:
     2023          when 'орг':U
     2024          then do:
     2025               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     2026               if available ub.firm
     2027               then do:
     2028                   assign
     2029                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     2030                       t-addres = t-addres
     2031                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     2032                               then ""
     2033                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     2034                             )
     2035                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     2036                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2037                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2038                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     2039                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     2040                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2041                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2042                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     2043                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     2044                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2045                       t-phone = ub.firm.phone
     2046                       t-inn   = ub.firm.inn
     2047                       t-okpo  = ub.firm.okpo
     2048                   .
     2049               end.
     2050          end.
     2051          when 'маг':U
     2052          then do:
     2053               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     2054               if available ub.shop
     2055               then do:
     2056                   assign
     2057                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     2058                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     2059                       t-phone = shop.phone
     2060                       t-inn = ""
     2061                       t-okpo = ""
     2062                   .
     2063               end.
     2064          end.
     2065          when 'скл':U
     2066          then do:
     2067               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     2068               if available ub.store
     2069               then do:
     2070                   assign
     2071                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     2072                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     2073                       t-phone = ub.store.phone
     2074                       t-inn = ""
     2075                       t-okpo = ""
     2076                   .
     2077               end.
     2078          end.
     2079          when 'чел':U
     2080          then do:
     2081               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     2082               if available ub.person
     2083               then do:
     2084                   assign
     2085                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     2086                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     2087                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     2088                       t-phone = ub.person.phone1
     2089                       t-inn = ub.person.inn
     2090                       t-okpo = ub.person.okpo
     2091                   .
     2092               end.
     2093          end.
     2094       end case.
     2095   assign
     2096     t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     2097     t-addres = t-addres
     2098         + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     2099             then ""
     2100             else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) + ", ")
     2101           )
     2102     t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     2103     t-addres = t-addres
     2104         + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2105         + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( trim( ub.firm.addres2 ) ) )
     2106     t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     2107     t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else "" )
     2108         + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2109     t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     2110     t-addres = t-addres   + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     2111   .
     2112     Assign
     2113      NAme1   = "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name )
     2114      NAme2   = cl_clients.obj-name
     2115      Adres1  = t-addres + "  " + t-phone
     2116      Adres2  = b-adress + "  " + b-phone
     2117      .
     2118     Adres1  = " Адрес: " + t-addres + "  тел. " + t-phone .
     2119   PUT STREAM OutStream
     2120       space(90) "Бланк заказа № 2"     format "X(100)"       skip
     2121       space(0) string( Name1  )   format "X(110)" skip
     2122       space(0) string( CAPS( This_Object.obj-name )  + Adres1 ) format "X(100)" skip(1)
     2123       space(50) Line format "X(33)" skip
     2124       space(30) string( "З А К А З ") format "x(10)"
     2125               " | " at 50
     2126                 ( string( tdoc-code , "X(16)" ) + " | "
     2127                 + string( tdoc-date , "99/99/9999" )
     2128             + " | "  + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else ""))
     2129                     format "X(50)" skip
     2130                   space(50) Line format "X(33)" skip
     2131       space(0) "Срок исполнения  :" v-ord_date format "X(100)" skip
     2132       space(0) "Время исполнения :" v-ord_time format "X(100)"  skip
     2133       space(0) "Заказчик         :" + name2  format "X(59)"
     2134        "Телефон:"        +   b-phone format "X(20)"  at 62  skip
     2135       space(0) "Номер клиента или клиентской карты  :" + string(cl_clients.obj-code) format "X(60)" skip
     2136       space(0) "Контактное лицо  :" + v-ord_contact format "X(59)"
     2137        "Телефон:"        +  v-ord_phone format "X(60)"  at 62  skip
     2138       space(0) "Менеджер по заказам :" v-manag      format "X(60)"
     2139                "Дата составления заказа :" + string( buf_trn-doc.doc-date , "99/99/9999" ) format "X(40)" at 62 skip
     2140       space(0) "Оплата              "                format "X(100)"  skip
     2141       space(0) "Вид                 :" v-type-pay    format "X(100)"  skip
     2142       space(0) "Валюта              :" + pp   format "X(50)" skip
     2143                "Предоплата " + v-befpay      format "X(50)"
     2144                "Доплата "     + v-postpay      at 62        format "X(50)"  skip
     2145                "Чек № " + v-ord_nchek + " от " + v-dchek                 format "X(50)"
     2146                "Чек № " + v-postNchek + " от " + v-postdchek            at 62 format "X(50)"  skip (1)
