     1660   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1661     if num-entries(string(p-dec), '.') = 2
     1662       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1663       else return( string(p-dec)) .
     1664   end function.
     1665   function format-point-to-comma returns char (input orig as char ) .
     1666   define variable rtext as character no-undo .
     1667   define variable strt as integer no-undo .
     1668   define variable leng as integer no-undo .
     1669   assign rtext = orig .
     1670   repeat:
     1671     strt =  index(rtext,'.').
     1672     if strt = 0 then leave.
     1673     leng = 1.
     1674     substring(rtext,strt,leng,"character") = v-delim .
     1675   end.
     1676   return rtext.
     1677   end function.
     1678   function format-excel-text returns char ( input start-text as char ) :
     1679   def var  i    as int no-undo.
     1680   def var  ch   as char no-undo.
     1681   def var  n    as int no-undo.
     1682   def var  ipos as int no-undo.
     1683     n = num-entries(trim(start-text), chr(10)) - 1 .
     1684     do i = 1 to n :
     1685       ipos = index( start-text, chr(10)).
     1686       if ipos > 0 then
     1687         substr( start-text, ipos, 1 ) = ' '.
     1688     end.
     1689     n = num-entries(trim(start-text), chr(13)) - 1 .
     1690     do i = 1 to n :
     1691       ipos = index( start-text, chr(13)).
     1692       if ipos > 0 then
     1693         substr( start-text, ipos, 1 ) = ' '.
     1694     end.
     1695     if index( start-text, '"' ) = 0 then
     1696       start-text =  '="'   + trim( start-text) + '"'   .
     1697       else do:
     1698         n = num-entries(trim(start-text), '"') - 1.
     1699         do i = 1 to n :
     1700           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1701         end.
     1702         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1703         start-text = '="'  + ch  + '"' .
     1704       end.
     1705     return start-text.
     1706   end.
     1707   function excel-sum returns char (input p-dec as decimal ).
     1708     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1709   end function.
     1710   function excel-qnty returns char (input p-dec as decimal ).
     1711     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1712   end function.
     1713   function format-excel-text-macr returns char ( input start-text as char ) :
     1714   def var  i    as int no-undo.
     1715   def var  ch   as char no-undo.
     1716   def var  n    as int no-undo.
     1717   def var  ipos as int no-undo.
     1718     n = num-entries(trim(start-text), chr(10)) - 1 .
     1719     do i = 1 to n :
     1720       ipos = index( start-text, chr(10)).
     1721       if ipos > 0 then
     1722         substring( start-text, ipos , 1 ) = ' '.
     1723     end.
     1724     n = num-entries(trim(start-text), chr(13)) - 1 .
     1725     do i = 1 to n :
     1726       ipos = index( start-text, chr(13)).
     1727       if ipos > 0 then
     1728         substring( start-text, ipos, 1 ) = ' '.
     1729     end.
     1730     if index( start-text, '"' ) = 0 then
     1731       start-text =  '"'   + trim( start-text) + '"'   .
     1732       else do:
     1733         n = num-entries(trim(start-text), '"') - 1.
     1734         do i = 1 to n :
     1735           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1736         end.
     1737         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1738         start-text = '"'  + ch  + '"' .
     1739       end.
     1740     n = num-entries(trim(start-text), chr(10)) - 1 .
     1741     do i = 1 to n :
     1742       ipos = index( start-text, chr(10)).
     1743       if ipos > 0 then
     1744         substring( start-text, ipos , 1 ) = ' '.
     1745     end.
     1746       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1747     return start-text.
     1748   end.
