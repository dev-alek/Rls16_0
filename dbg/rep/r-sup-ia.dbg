      599   define new global shared variable g#library  as handle no-undo .
      600   define new global shared variable g#library2 as handle no-undo .
      601   define variable var-report-r-b as character no-undo .
      602   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      603   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      604     (output var-report-r-b
      605     )  .
      606   do
      607   on error undo, return error
      608   :
      609   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      610   ASSIGN parParentProc =  my-handle .
      611     define variable g#report-num as integer   no-undo .
      612     run get-report-num  in parParentProc ( output g#report-num ).
      613   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      614     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
      615     define variable v-cntxp-price-calc      like ub.store.price-calc      no-undo.
      616     define variable v-cntxp-inout-price     like ub.store.inout-price     no-undo.
      617     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
      618     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
      619     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
      620     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
      621     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
      622     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
      623     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
      624     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      625     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
      626     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
      627     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
      628     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      629     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      630     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      631     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      632     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      633     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      634     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      635     define variable v-cntxp-conf-par        as   character                no-undo.
      636     define variable v-cntxp-par-type        as   character                no-undo.
      637     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      638     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      639     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      640     define variable v-cntxp-db-num          as integer   no-undo .
      641     define variable v-cntxp-userid          as character no-undo .
      642     define variable v-cntxp-level           as character no-undo .
      643     define variable v-cntxp-db-num-obj      as integer   no-undo .
      644     define variable v-cntxp-is-admin        as logical   no-undo .
      645     define buffer bf-cntxp_store for ub.store.
      646     define buffer bf-cntxp_shop  for ub.shop.
      647     define buffer bf-cntxp_sysconf for ub.sysconf.
      648   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      649     run mainmenu_getcntxt in parparentproc
      650       (output v-cntxp-db-num
      651       ,output v-cntxp-userid
      652       ,output v-cntxp-level
      653       ,output v-cntxp-curr-host-code
      654       ,output v-cntxp-obj-type
      655       ,output v-cntxp-obj-code
      656       ,output v-cntxp-db-num-obj
      657       ,output v-cntxp-is-admin
      658       ) .
      659     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      660        v-cntxp-obj-code <> 0 then do:
      661   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      662     (input  'is-prt'
      663     ,input  0
      664     ,input  ''
      665     ,input  0
      666     ,input  ''
      667     ,input  ''
      668     ,input  ''
      669     ,input  yes
      670     ,output v-cntxp-conf-par
      671     ,output v-cntxp-par-type
      672     ) no-error .
      673       case v-cntxp-obj-type :
      674         when 'скл':U then do:
      675           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      676           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      677           assign
      678             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      679             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      680             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      681             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      682             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      683             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      684             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      685             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      686             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      687             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      688             v-cntxp-load-time       = bf-cntxp_store.load-time
      689             v-cntxp-holidays        = bf-cntxp_store.holidays
      690             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      691             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      692             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      693             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      694             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      695             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      696             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      697             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      698             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      699             .
      700         end.
      701         when 'маг':U then do:
      702           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      703           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      704           assign
      705             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      706             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      707             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      708             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      709             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      710             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      711             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      712             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      713             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      714             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      715             v-cntxp-load-time       = bf-cntxp_shop.load-time
      716             v-cntxp-holidays        = bf-cntxp_shop.holidays
      717             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      718             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      719             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      720             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      721             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      722             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      723             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      724             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      725             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      726             .
      727         end.
      728       end case.
      729     end.
      730   define temp-table gds-cycl no-undo
      731     field artic        like goods.artic
      732     field prod-type    like goods.prod-type
      733     field prod-code    like goods.prod-code
      734     field gds-name     like goods.gds-name
      735     field pay-code     like trn-doc.pay-code
      736     field ext-doc-type like trn-doc.ext-doc-type
      737     field type         as integer
      738     field in-doc-date  like trn-doc.fact-date
      739     field in-doc-code  like doc-line.doc-code
      740     field in-cli-code  like trn-doc.cli-code
      741     field in-cli-type  like trn-doc.cli-type
      742     field in-cli-name  like trn-doc.cli-name
      743     field in-qnty      like doc-line.fact-qnty
      744     field in-sum       like doc-line.price-rubl
      745     field out-doc-date like trn-doc.fact-date
      746     field out-doc-code like doc-line.doc-code
      747     field out-doc-type like trn-doc.doc-type
      748     field out-cli-code like trn-doc.cli-code
      749     field out-cli-type like trn-doc.cli-type
      750     field out-cli-name like trn-doc.cli-name
      751     field out-qnty     like doc-line.fact-qnty
      752     field out-sum      like doc-line.price-rubl
      753     field out-sumc     like doc-line.price-rubl
      754     index gds artic prod-type prod-code out-doc-code in-cli-code in-cli-type
      755     index tp type
      756   .
      757   define Stream OutStream.
      758   define buffer cli-obj     for clients.
      759   define buffer cli-suppl   for clients.
      760   define buffer b-trn-doc   for trn-doc.
      761   define buffer b-doc-line  for doc-line.
      762   define buffer buf_goods   for goods.
      763   define buffer buf_parts   for parts.
      764   define buffer buf_trn-doc for trn-doc.
      765   define buffer buf_clients for clients.
      766   define variable Counter as integer .
      767     FOR EACH gds-cycl :
      768       delete gds-cycl.
      769     END.
      770   define variable v-account as integer init 0 no-undo .
      771   define variable v-account-lavel as character no-undo .
      772   define variable v-button-stop as logical no-undo .
      773   define variable v-kol-spice as integer no-undo .
      774   define variable v-kol-spice2 as integer no-undo .
      775   define variable v-kol-spice3 as integer no-undo .
      776   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      777   DEFINE BUTTON StopBtn AUTO-END-KEY
      778        LABEL "Стоп"
      779        SIZE 10 BY 1.
      780   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      781        LABEL "Обработано записей"
      782         VIEW-AS TEXT
      783        SIZE 14 BY .67 NO-UNDO.
      784   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      785         VIEW-AS TEXT
      786        SIZE 53.25 BY .67
      787        FGCOLOR 1  NO-UNDO.
      788   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      789         VIEW-AS TEXT
      790        SIZE 53.25 BY .67
      791        FGCOLOR 1  NO-UNDO.
      792   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      793         VIEW-AS TEXT
      794        SIZE 53.25 BY .67
      795        FGCOLOR 1  NO-UNDO.
      796   DEFINE RECTANGLE RECT-1
      797        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      798        SIZE 55.13 BY 4.46.
      799   DEFINE FRAME InfoFrame
      800        StopBtn AT ROW 4.25 COL 21.75
      801        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      802        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      803        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      804        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      805        RECT-1 AT ROW 1 COL 1
      806       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      807            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      808            TITLE "Процесс"
      809            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      810   define variable mFrameView      as logical   no-undo init yes.
      811     define variable mFramHandle as handle no-undo.
      812     mFramHandle = frame InfoFrame:handle.
      813     if  log-manager:logfile-name ne ?
      814     then DO:
      815         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      816         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      817         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      818     end.
      819     mFrameView = not session:batch-mode and mFramHandle:visible.
      820     if mFrameView
      821     then do:
      822       ASSIGN
      823          FRAME InfoFrame:HIDDEN                           = TRUE
      824          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      825     end.
      826   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      827   DO:
      828     IF not StopProcessing THEN
      829       Message "Вы действительно хотите прервать" SKIP
      830               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      831                 UPDATE StopProcessing.
      832     IF StopProcessing THEN do:
      833        if mFrameView
      834        then do:
      835           HIDE FRAME InfoFrame.
      836        end.
      837     End.
      838   END.
      839   assign v-account = ( if integer( 10 ) = 0 then 100 else integer( 10 ) ).
      840     if  log-manager:logfile-name ne ?
      841     then DO:
      842         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      843     end.
      844     if not session:batch-mode then
      845     do:
      846       VIEW FRAME InfoFrame.
      847       mFrameView = true.
      848     end.
      849      v-button-stop = false .
      850         if mFrameView
      851         then do:
      852         if v-button-stop then view STOPBTN in frame InfoFrame.
      853                          else Hide STOPBTN in frame InfoFrame.
      854         end.
      855     assign Counter = 0.
      856     for each obj-list no-lock :
      857       find cli-obj no-lock
      858         where cli-obj.obj-type = obj-list.obj-type
      859           and cli-obj.obj-code = obj-list.obj-code .
      860       if p-SelectGood = 1 then
      861       do:
      862         for each buf_goods no-lock :
      863           run suppl-cycl in this-procedure .
      864         end.
      865       end.
      866       else do:
      867         for each gds-list no-lock ,
      868             each buf_goods no-lock
      869            where buf_goods.artic     = gds-list.artic
      870              and buf_goods.prod-type = gds-list.prod-type
      871              and buf_goods.prod-code = gds-list.prod-code :
      872           run suppl-cycl in this-procedure .
      873         end.
      874       end.
      875     end.
      876   if mFrameView
      877   then do:
      878      HIDE FRAME InfoFrame.
      879   end.
      880     if not can-find( first gds-cycl no-lock ) then
      881     do:
      882       message "Нет данных по движению товара." view-as alert-box ERROR.
      883     end.
      884     else
      885     do:
      886       run PrintProvOtchet in this-procedure .
      887     end.
      888   end.
      889   PROCEDURE suppl-cycl :
      890     for each buf_parts no-lock
      891       where  buf_parts.obj-type  = obj-list.obj-type
      892          and buf_parts.obj-code  = obj-list.obj-code
      893          and buf_parts.artic     = buf_goods.artic
      894          and buf_parts.prod-type = buf_goods.prod-type
      895          and buf_parts.prod-code = buf_goods.prod-code
      896          and buf_parts.status_   = yes
      897          and (buf_parts.doc-type  = 'рас':U  or
      898               buf_parts.doc-type  = 'возврат':U )
      899          ,
      900         each buf_trn-doc no-lock
      901        where buf_trn-doc.obj-code   = obj-list.obj-code
      902          and buf_trn-doc.obj-type   = obj-list.obj-type
      903          and buf_trn-doc.fact-date >= x-date-start
      904          and buf_trn-doc.fact-date <= x-date-end
      905          and buf_trn-doc.doc-type   = buf_parts.doc-type
      906          and buf_trn-doc.status_    = 'факт':U
      907          and buf_trn-doc.internal   = no
      908          and buf_trn-doc.office     = no
      909          and buf_trn-doc.doc-code   = buf_parts.out-code
      910       :
      911       assign Counter = Counter + 1.
      912   IF ( Counter modulo v-account = 0 )  then DO:
      913             if  log-manager:logfile-name ne ?
      914             then DO:
      915                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
      916             end.
      917              if mFrameView
      918              then do:
      919               DISPLAY
      920                 Counter @ RecordsDone
      921                 WITH FRAME InfoFrame.
      922              end.
      923   End.
      924      if v-button-stop then  DO:
      925            if mFrameView
      926            then
      927               PROCESS EVENTS.
      928            IF StopProcessing THEN DO:
      929            RETURN error.
      930            End.
      931      end.
      932       find cli-suppl no-lock
      933         where cli-suppl.obj-type = buf_parts.supp-type
      934           and cli-suppl.obj-code = buf_parts.supp-code  no-error.
      935       find buf_clients no-lock
      936         where buf_clients.obj-type = buf_trn-doc.cli-type
      937           and buf_clients.obj-code = buf_trn-doc.cli-code .
      938       case p_type-count :
      939         when "поставщик" then
      940         do:
      941           if available cli-suppl and not can-do( p_cli-list, string( recid( cli-suppl ) ) ) then next.
      942         end.
      943         when "покупатель" then
      944         do:
      945           if not can-do( p_cli-list, string( recid( buf_clients ) ) ) then next.
      946         end.
      947         otherwise
      948         do:
      949         end.
      950       end case.
      951       for each gds-dtl
      952          where gds-dtl.doc-code = buf_trn-doc.doc-code
      953            and gds-dtl.artic = buf_goods.artic
      954            and gds-dtl.prod-type = buf_goods.prod-type
      955            and gds-dtl.prod-code = buf_goods.prod-code
      956        no-lock :
      957         ACCUMULATE
      958           gds-dtl.fact-qnty (TOTAL)
      959           gds-dtl.fact-qnty * gds-dtl.price-rubl (TOTAL)
      960           gds-dtl.fact-qnty * gds-dtl.price-base (TOTAL)
      961           gds-dtl.fact-qnty * ( gds-dtl.price-rubl - gds-dtl.discnt-rubl ) (TOTAL)
      962           gds-dtl.fact-qnty * ( gds-dtl.price-base - gds-dtl.discnt-base ) (TOTAL)
      963         .
      964       END.
      965       find b-trn-doc no-lock
      966         where b-trn-doc.doc-code = buf_parts.in-code  no-error.
      967       if available b-trn-doc then
      968       do:
      969         find b-doc-line no-lock
      970           where b-doc-line.doc-code = b-trn-doc.doc-code
      971             and b-doc-line.artic = buf_goods.artic
      972             and b-doc-line.prod-type = buf_goods.prod-type
      973             and b-doc-line.prod-code = buf_goods.prod-code
      974         .
      975       end.
      976       if buf_parts.fact-qnty <> 0 then do:
      977         if available cli-suppl then do:
      978           find gds-cycl
      979             where gds-cycl.artic        = buf_goods.artic
      980               and gds-cycl.prod-type    = buf_goods.prod-type
      981               and gds-cycl.prod-code    = buf_goods.prod-code
      982               and gds-cycl.out-doc-code = buf_trn-doc.doc-code
      983               and gds-cycl.in-cli-code  = cli-suppl.obj-code
      984               and gds-cycl.in-cli-type  = cli-suppl.obj-type
      985           no-error.
      986         end.
      987         else do:
      988           find gds-cycl
      989             where gds-cycl.artic        = buf_goods.artic
      990               and gds-cycl.prod-type    = buf_goods.prod-type
      991               and gds-cycl.prod-code    = buf_goods.prod-code
      992               and gds-cycl.out-doc-code = buf_trn-doc.doc-code
      993               and gds-cycl.in-cli-code  = 0
      994               and gds-cycl.in-cli-type  = ""
      995           no-error.
      996         end.
      997         if available gds-cycl then do:
      998           assign
      999             gds-cycl.out-qnty = gds-cycl.out-qnty + buf_parts.fact-qnty
     1000           .
     1001           if p_typ_val = 1 then do:
     1002             assign
     1003               gds-cycl.out-sumc = gds-cycl.out-sumc + buf_parts.fact-qnty * b-doc-line.price-rubl
     1004               gds-cycl.out-sum = gds-cycl.out-sum + buf_parts.fact-qnty * ( ACCUM TOTAL gds-dtl.fact-qnty * ( gds-dtl.price-rubl - gds-dtl.discnt-rubl ) ) / ( ACCUM TOTAL gds-dtl.fact-qnty )
     1005             .
     1006           end.
     1007           else do:
     1008             assign
     1009               gds-cycl.out-sumc = gds-cycl.out-sumc + buf_parts.fact-qnty * b-doc-line.price-base
     1010               gds-cycl.out-sum = gds-cycl.out-sum + buf_parts.fact-qnty * ( ACCUM TOTAL gds-dtl.fact-qnty * ( gds-dtl.price-base - gds-dtl.discnt-base ) ) / ( ACCUM TOTAL gds-dtl.fact-qnty )
     1011             .
     1012           end.
     1013           next.
     1014         end.
     1015       create gds-cycl.
     1016       assign
     1017         gds-cycl.artic        = buf_goods.artic
     1018         gds-cycl.prod-type    = buf_goods.prod-type
     1019         gds-cycl.prod-code    = buf_goods.prod-code
     1020         gds-cycl.gds-name     = buf_goods.gds-name
     1021         gds-cycl.out-doc-date = buf_trn-doc.fact-date
     1022         gds-cycl.out-doc-code = buf_trn-doc.doc-code
     1023         gds-cycl.out-cli-code = buf_clients.obj-code
     1024         gds-cycl.out-cli-type = buf_clients.obj-type
     1025         gds-cycl.out-qnty     = buf_parts.fact-qnty
     1026         gds-cycl.out-doc-type = buf_parts.doc-type
     1027         gds-cycl.ext-doc-type = buf_trn-doc.ext-doc-type
     1028         gds-cycl.pay-code     = buf_trn-doc.pay-code
     1029       .
     1030       if buf_trn-doc.ext-doc-type = 'ep':U then
     1031         assign
     1032           gds-cycl.out-cli-name = "Возврат поставщику"
     1033           gds-cycl.type         = 0
     1034         .
     1035       else
     1036         assign
     1037           gds-cycl.out-cli-name = buf_clients.obj-name
     1038           gds-cycl.type         = 1
     1039         .
     1040       if available cli-suppl then
     1041         assign
     1042           gds-cycl.in-cli-code = cli-suppl.obj-code
     1043           gds-cycl.in-cli-type = cli-suppl.obj-type
     1044           gds-cycl.in-cli-name = cli-suppl.obj-name
     1045         .
     1046       else
     1047         assign
     1048           gds-cycl.in-cli-code = 0
     1049           gds-cycl.in-cli-type = ""
     1050           gds-cycl.in-cli-name = "Поставщик не определен"
     1051         .
     1052       if available b-trn-doc then
     1053       do:
     1054         assign
     1055           gds-cycl.in-qnty     = b-doc-line.fact-qnty
     1056           gds-cycl.in-doc-date = b-trn-doc.fact-date
     1057           gds-cycl.in-doc-code = b-trn-doc.doc-code
     1058         .
     1059         if p_typ_val = 1  then
     1060           assign
     1061             gds-cycl.in-sum = b-doc-line.fact-qnty * b-doc-line.price-rubl
     1062           .
     1063         else
     1064           assign
     1065             gds-cycl.in-sum = b-doc-line.fact-qnty * b-doc-line.price-base
     1066           .
     1067       end.
     1068       else
     1069         assign
     1070           gds-cycl.in-qnty     = 0
     1071           gds-cycl.in-sum      = 0
     1072           gds-cycl.in-doc-date = ?
     1073           gds-cycl.in-doc-code = "неизвестен"
     1074         .
     1075       if p_typ_val = 1  then
     1076         assign
     1077           gds-cycl.out-sumc = buf_parts.fact-qnty * b-doc-line.price-rubl
     1078           gds-cycl.out-sum  = buf_parts.fact-qnty * ( ACCUM TOTAL gds-dtl.fact-qnty * ( gds-dtl.price-rubl - gds-dtl.discnt-rubl ) ) / ( ACCUM TOTAL gds-dtl.fact-qnty )
     1079         .
     1080       else
     1081         assign
     1082           gds-cycl.out-sumc = buf_parts.fact-qnty * b-doc-line.price-base
     1083           gds-cycl.out-sum  = buf_parts.fact-qnty * ( ACCUM TOTAL gds-dtl.fact-qnty * ( gds-dtl.price-base - gds-dtl.discnt-base ) ) / ( ACCUM TOTAL gds-dtl.fact-qnty )
     1084         .
     1085       end.
     1086     end.
     1087   end procedure.
     1088   PROCEDURE PrintProvOtchet :
     1089     def var Line as char no-undo.
     1090     def var i as int no-undo.
     1091   if session :set-wait-state( "compiler" ) then.
     1092     Line = fill("-", 140).
     1093     DEFINE FRAME Gds_cycl
     1094           sym1 column-label ":!:" format "x(1)" space (0)
     1095           gds-cycl.artic column-label " Артикул! " format "x(16)"  space (0)
     1096           sym2 column-label ":!:" format "x(1)" space (0)
     1097           gds-cycl.gds-name
     1098           column-label " Наименование товара! " format "x(30)"  space (0)
     1099           sym3 column-label ":!:" format "x(1)" space (0)
     1100           gds-cycl.out-doc-date column-label " Дата!расхода" format "99/99/99"  space (0)
     1101           sym8 column-label ":!:" format "x(1)" space (0)
     1102           gds-cycl.out-doc-code column-label " N док.! " format "x(10)"  space (0)
     1103           sym9 column-label ":!:" format "x(1)" space (0)
     1104           gds-cycl.out-cli-name
     1105           column-label " Получатель! " format "x(31)"  space (0)
     1106           sym10 column-label ":!:" format "x(1)" space (0)
     1107           gds-cycl.out-qnty  column-label "Кол-во  !(расход) " format "->>>>9.<<<"  space (0)
     1108           sym11 column-label ":!:" format "x(1)" space (0)
     1109           gds-cycl.out-sum  column-label "Сумма  !(расход) " format "->>>>>>9.99"  space (0)
     1110           sym12 column-label ":!:" format "x(1)" space (0)
     1111           gds-cycl.out-sumc  column-label "Сумма уч.ц.!(расход) " format "->>>>>>9.99"  space (0)
     1112           sym13 column-label ":!:" format "x(1)" space (0)
     1113       HEADER
     1114           string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(100)"
     1115           string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 115 format "X(15)" SKIP
     1116           Line format "X(135)" AT 1
     1117     with width 235 down stream-io.
     1118   output stream OutStream to value( string( session:temp-directory +
     1119                                        "rpt" + string( g#report-num ) ) )
     1120                                        page-size 62 .
     1121     FORM HEADER
     1122           Line format "X(135)" AT 1 SKIP
     1123           "Продолжение - на следующей странице" AT 30 SKIP
     1124           with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     1125     VIEW stream OutStream FRAME BottomFrame .
     1126     FORM with FRAME Gds_cycl .
     1127     PUT stream OutStream SPACE(30) "О Т Ч Е Т    П О    П О С Т А В Щ И К А М  за период с: "
     1128           x-date-start format "99/99/9999" "г. по: "  x-date-end format "99/99/9999" "г." SKIP(2).
     1129     for each gds-cycl no-lock
     1130       break by string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type )
     1131             by gds-cycl.type
     1132             by gds-cycl.out-doc-type
     1133             by gds-cycl.artic :
     1134       if FIRST-OF( string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) ) then do:
     1135         DISPLAY stream OutStream sym1 sym13 with frame Gds_cycl.
     1136         DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1137         PUT stream OutStream
     1138           sym1
     1139           string( " ПОСТАВЩИК: " + gds-cycl.in-cli-name + " (" + gds-cycl.in-cli-type + " " + string( gds-cycl.in-cli-code ) + ") " ) format "X(100)"
     1140           sym2 AT 135 .
     1141         DISPLAY stream OutStream sym1 sym13 with frame Gds_cycl.
     1142         DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1143       end.
     1144       if FIRST-OF( gds-cycl.type ) then do:
     1145         if gds-cycl.type = 1 then PUT stream OutStream sym1 format "X(1)" " Расход/Возврат: "     format "X(100)" sym2 AT 135 skip .
     1146         else                      PUT stream OutStream sym1 format "X(1)" " Возврат поставщику: " format "X(100)" sym2 AT 135 .
     1147       end.
     1148       if FIRST-OF( gds-cycl.out-doc-type ) then do:
     1149         if gds-cycl.type = 1 then do:
     1150           if gds-cycl.out-doc-type = 'возврат':U then  PUT stream OutStream sym1 format "X(1)" " Возврат: " format "X(100)" sym2 AT 135 .
     1151           else                                       PUT stream OutStream sym1 format "X(1)" " Расход: "  format "X(100)" sym2 AT 135 .
     1152         end.
     1153       end.
     1154       if gds-cycl.out-doc-type = 'возврат':U then do:
     1155         assign
     1156           gds-cycl.out-qnty = - gds-cycl.out-qnty
     1157           gds-cycl.out-sum  = - gds-cycl.out-sum
     1158           gds-cycl.out-sumc = - gds-cycl.out-sumc
     1159         .
     1160       end.
     1161       DISPLAY stream OutStream
     1162               sym1 gds-cycl.artic
     1163               sym2 gds-cycl.gds-name
     1164               sym3 gds-cycl.out-doc-date
     1165               sym8 gds-cycl.out-doc-code
     1166               sym9 gds-cycl.out-cli-name
     1167               sym10 gds-cycl.out-qnty
     1168               sym11 gds-cycl.out-sum
     1169               sym12 gds-cycl.out-sumc
     1170               sym13
     1171               with frame Gds_cycl.
     1172       DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1173         ACCUMULATE
     1174           gds-cycl.out-qnty (SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) )
     1175           gds-cycl.out-sum  (SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) )
     1176           gds-cycl.out-sumc (SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) )
     1177           gds-cycl.out-qnty (SUB-TOTAL BY gds-cycl.type)
     1178           gds-cycl.out-sum  (SUB-TOTAL BY gds-cycl.type)
     1179           gds-cycl.out-sumc (SUB-TOTAL BY gds-cycl.type)
     1180           gds-cycl.out-qnty (SUB-TOTAL BY gds-cycl.out-doc-type)
     1181           gds-cycl.out-sum  (SUB-TOTAL BY gds-cycl.out-doc-type)
     1182           gds-cycl.out-sumc (SUB-TOTAL BY gds-cycl.out-doc-type)
     1183           gds-cycl.out-qnty (TOTAL)
     1184           gds-cycl.out-sum  (TOTAL)
     1185           gds-cycl.out-sumc (TOTAL)
     1186         .
     1187       if LAST-OF( gds-cycl.out-doc-type ) then do:
     1188         if gds-cycl.type = 1 then do:
     1189           DISPLAY stream OutStream
     1190             sym1 (if gds-cycl.out-doc-type = 'возврат':U then " Возврат" else " Расход") @ gds-cycl.artic
     1191             sym2 string( "(" + gds-cycl.in-cli-type + " " + string( gds-cycl.in-cli-code ) + "):" )  @ gds-cycl.gds-name
     1192             sym3
     1193             sym10 ( ACCUM SUB-TOTAL BY gds-cycl.out-doc-type gds-cycl.out-qnty ) @ gds-cycl.out-qnty
     1194             sym11 ( ACCUM SUB-TOTAL BY gds-cycl.out-doc-type gds-cycl.out-sum ) @ gds-cycl.out-sum
     1195             sym12 ( ACCUM SUB-TOTAL BY gds-cycl.out-doc-type gds-cycl.out-sumc ) @ gds-cycl.out-sumc
     1196             sym13
     1197           with frame Gds_cycl.
     1198           DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1199         end.
     1200       end.
     1201       if LAST-OF( gds-cycl.type ) then  do:
     1202         DISPLAY stream OutStream
     1203           sym1 ( if gds-cycl.type = 1 then " Расход-возврат" else " Возвр. пост-ку") @ gds-cycl.artic
     1204           sym2 string( "(" + gds-cycl.in-cli-type + " " + string( gds-cycl.in-cli-code ) + "):" )  @ gds-cycl.gds-name
     1205           sym3
     1206           sym10 ( ACCUM SUB-TOTAL BY gds-cycl.type gds-cycl.out-qnty ) @ gds-cycl.out-qnty
     1207           sym11 ( ACCUM SUB-TOTAL BY gds-cycl.type gds-cycl.out-sum ) @ gds-cycl.out-sum
     1208           sym12 ( ACCUM SUB-TOTAL BY gds-cycl.type gds-cycl.out-sumc ) @ gds-cycl.out-sumc
     1209           sym13
     1210         with frame Gds_cycl.
     1211         DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1212       end.
     1213       if LAST-OF( string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) ) then do:
     1214         DISPLAY stream OutStream
     1215           sym1
     1216           Line @ gds-cycl.artic
     1217           Line @ gds-cycl.gds-name
     1218           Line @ gds-cycl.out-qnty
     1219           Line @ gds-cycl.out-sum
     1220           Line @ gds-cycl.out-sumc
     1221           sym13
     1222         with frame Gds_cycl.
     1223         DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1224         DISPLAY stream OutStream
     1225           sym1 " ИТОГО ПО" @ gds-cycl.artic
     1226           string( "(" + gds-cycl.in-cli-type + " " + string( gds-cycl.in-cli-code ) + "):" )  @ gds-cycl.gds-name
     1227           ( ACCUM SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) gds-cycl.out-qnty ) @ gds-cycl.out-qnty
     1228           ( ACCUM SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) gds-cycl.out-sum ) @ gds-cycl.out-sum
     1229           ( ACCUM SUB-TOTAL BY string( string( gds-cycl.in-cli-code ) + gds-cycl.in-cli-type ) gds-cycl.out-sumc ) @ gds-cycl.out-sumc
     1230           sym13
     1231         with frame Gds_cycl.
     1232         DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1233       end.
     1234       PROCESS EVENTS.
     1235     END.
     1236     PUT STREAM OutStream Line format "X(135)".
     1237     DISPLAY stream OutStream
     1238           "ИТОГО" @ gds-cycl.artic
     1239           ( ACCUM TOTAL gds-cycl.out-qnty ) @ gds-cycl.out-qnty
     1240           ( ACCUM TOTAL gds-cycl.out-sum ) @ gds-cycl.out-sum
     1241           ( ACCUM TOTAL gds-cycl.out-sumc ) @ gds-cycl.out-sumc
     1242           with frame Gds_cycl.
     1243     DOWN stream OutStream 1 WITH FRAME Gds_cycl.
     1244     HIDE stream OutStream FRAME BottomFrame .
     1245     OUTPUT stream OutStream CLOSE.
     1246   if session :set-wait-state( "" ) then.
     1247     define variable v-user-action as character no-undo .
     1248     define variable v-printed as logical   no-undo .
     1249     run gbl/prnfilen.w
     1250       (input  ""
     1251       ,input  0
     1252       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1253       ,input 7
     1254       ,output v-user-action
     1255       ,output v-printed
     1256       ) .
     1257   END.
