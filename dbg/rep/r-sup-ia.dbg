      175   procedure create_obj-list :
      176      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      177      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      178      do
      179      on error undo, return error return-value
      180      :
      181         define buffer cli-obj for ub.clients .
      182         define variable p-var as integer no-undo .
      183         define buffer buf_obj-list for obj-list .
      184         find last buf_obj-list  use-index pi no-error .
      185         if available buf_obj-list
      186         then
      187            p-var = buf_obj-list.obj-id + 1.
      188         else
      189            p-var = 1.
      190         find first cli-obj where
      191                   cli-obj.obj-type = p-obj-type
      192               and cli-obj.obj-code = p-obj-code
      193         no-lock no-error.
      194         if available cli-obj
      195         then do:
      196            create buf_obj-list.
      197            assign
      198               buf_obj-list.obj-id   = p-var
      199               buf_obj-list.obj-code = cli-obj.obj-code
      200               buf_obj-list.obj-type = cli-obj.obj-type
      201               buf_obj-list.obj-name = cli-obj.obj-name
      202               buf_obj-list.db-num   = cli-obj.db-num
      203            .
      204         end.
      205      end.
      206   end.
