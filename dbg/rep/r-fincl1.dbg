     1469     define variable v-cntxt-obj-type      as character no-undo .
     1470     define variable v-cntxt-obj-code      as integer   no-undo .
     1471     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1472     define variable v-cntxt-is-admin      as logical   no-undo .
     1473   define shared temp-table g#post-f no-undo
     1474       field obj-type  like ub.clients.obj-type
     1475       field obj-code  like ub.clients.obj-code
     1476       field obj-name  like ub.clients.obj-name
     1477       field grp-code  like ub.clients.grp-code
     1478       field grp-name  like ub.clients.grp-name
     1479       field lvl-num   like ub.cli-grp.lvl-num
