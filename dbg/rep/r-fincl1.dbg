     1794           v-talon-give-sum-1  = 0
     1795           v-fuel-sell-sum-1   = 0
     1796           v-pay-sum-2         = 0
     1797           v-talon-give-sum-2  = 0
     1798           v-fuel-sell-sum-2   = 0
     1799           v-repfrm-str  = "Расчет для: " + ub.clients.obj-name
     1800         .
