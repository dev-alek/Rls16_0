     1483   index hc host-code
     1484   .
     1485   define temp-table tt-report no-undo
     1486       field obj-type        like ub.clients.obj-type
     1487       field obj-code        like ub.clients.obj-code
     1488       field obj-name        like ub.clients.obj-name
     1489       field pay-sum         as decimal
     1490       field talon-give-sum  as decimal
     1491       field fuel-sell-sum   as decimal
     1492   index pi is primary unique obj-type obj-code
     1493   index p1 obj-name.
     1494   define stream out-stream.
     1495   define buffer buf_clients         for ub.clients.
     1496   define buffer buf_arh-wth-cli-tot for ub.arh-wth-cli-tot.
     1497   define variable g#report-num         as integer   no-undo .
     1498   define variable v-fact-order-start   as decimal   no-undo .
     1499   define variable v-fact-order-end     as decimal   no-undo .
     1500   define variable v-line               as character no-undo .
     1501   define variable v-print-rubl         as logical   no-undo .
     1502   define variable v-repfrm-str         as character no-undo .
     1503   define variable v-counter            as integer   no-undo .
     1504   define variable v-pay-sum-1          as decimal   no-undo .
     1505   define variable v-talon-give-sum-1   as decimal   no-undo .
     1506   define variable v-fuel-sell-sum-1    as decimal   no-undo .
     1507   define variable v-pay-sum-2          as decimal   no-undo .
     1508   define variable v-talon-give-sum-2   as decimal   no-undo .
     1509   define variable v-fuel-sell-sum-2    as decimal   no-undo .
     1510   define variable v-saldo-1            as decimal   no-undo .
     1511   define variable v-saldo-2            as decimal   no-undo .
     1512   define variable v-curr-r-b           as integer   no-undo .
     1513   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1514   procedure calc-cli-saldo :
     1515     define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1516     define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1517     define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1518     define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1519     define input  parameter p-fact-order    as decimal   no-undo .
     1520     define output parameter p-saldo         as decimal   no-undo .
     1521     define variable v-saldo as decimal   no-undo .
     1522     define variable v-sum-e as decimal   no-undo .
     1523     define variable v-sum-i as decimal   no-undo .
     1524   do
     1525   on error undo, return error return-value
     1526   :
     1527       run CalcOstatFin( input p-cli-type
     1528                       , input p-cli-code
     1529                       , input p-host-code-obj
     1530                       , input p-curr-r-b
     1531                       , input p-fact-order
     1532                       , input 'ппп':U
     1533                       , output v-sum-e
     1534                       , output v-sum-i
     1535                       ) .
     1536       assign  v-saldo = v-saldo - v-sum-e .
     1537       run CalcOstatFin( input p-cli-type
     1538                       , input p-cli-code
     1539                       , input p-host-code-obj
     1540                       , input p-curr-r-b
     1541                       , input p-fact-order
     1542                       , input 'рпп':U
     1543                       , output v-sum-e
     1544                       , output v-sum-i
     1545                       ) .
     1546       assign  v-saldo = v-saldo + v-sum-i .
     1547       run CalcOstatFinNal( input p-cli-type
     1548                          , input p-cli-code
     1549                          , input p-host-code-obj
     1550                          , input p-curr-r-b
     1551                          , input p-fact-order
     1552                          , input 'пко':U
     1553                          , output v-sum-e
     1554                          , output v-sum-i
     1555                          ) .
     1556       assign  v-saldo = v-saldo - v-sum-e .
     1557       run CalcOstatFinNal( input p-cli-type
     1558                          , input p-cli-code
     1559                          , input p-host-code-obj
     1560                          , input p-curr-r-b
     1561                          , input p-fact-order
     1562                          , input 'рко':U
     1563                          , output v-sum-e
     1564                          , output v-sum-i
     1565                          ) .
     1566       assign  v-saldo = v-saldo + v-sum-i .
     1567       run CalcOstatFinNal( input p-cli-type
     1568                          , input p-cli-code
     1569                          , input p-host-code-obj
     1570                          , input p-curr-r-b
     1571                          , input p-fact-order
     1572                          , input 'апп':U
     1573                          , output v-sum-e
     1574                          , output v-sum-i
     1575                          ) .
     1576       assign  v-saldo = v-saldo - v-sum-e .
     1577       run CalcOstatFinNal( input p-cli-type
     1578                          , input p-cli-code
     1579                          , input p-host-code-obj
     1580                          , input p-curr-r-b
     1581                          , input p-fact-order
     1582                          , input 'апр':U
     1583                          , output v-sum-e
     1584                          , output v-sum-i
     1585                          ) .
     1586       assign  v-saldo = v-saldo + v-sum-i .
     1587       define buffer buf_clients for ub.clients.
     1588       define buffer buf_arh-wth-cli-tot for ub.arh-wth-cli-tot.
     1589               define variable v-wth-saldo as decimal   no-undo .
     1590     for each buf_clients no-lock
     1591       where buf_clients.host-code = p-host-code-obj
     1592     :
     1593       find last buf_arh-wth-cli-tot no-lock
     1594         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1595           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1596           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1597           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1598           and buf_arh-wth-cli-tot.ext-doc-type = 'pc':U
     1599           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1600           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1601       no-error .
     1602       if available buf_arh-wth-cli-tot then do:
     1603         assign
     1604           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.in-sum-rubl
     1605                               else                 buf_arh-wth-cli-tot.in-sum-base
     1606         .
     1607       end.
     1608       find last buf_arh-wth-cli-tot no-lock
     1609         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1610           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1611           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1612           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1613           and buf_arh-wth-cli-tot.ext-doc-type = 'ps':U
     1614           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1615           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1616       no-error .
     1617       if available buf_arh-wth-cli-tot then do:
     1618         assign
     1619           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.in-sum-rubl
     1620                               else                 buf_arh-wth-cli-tot.in-sum-base
     1621         .
     1622       end.
     1623       find last buf_arh-wth-cli-tot no-lock
     1624         where buf_arh-wth-cli-tot.cli-type     = p-cli-type
     1625           and buf_arh-wth-cli-tot.cli-code     = p-cli-code
     1626           and buf_arh-wth-cli-tot.obj-type     = buf_clients.obj-type
     1627           and buf_arh-wth-cli-tot.obj-code     = buf_clients.obj-code
     1628           and buf_arh-wth-cli-tot.ext-doc-type = 'pz':U
     1629           and buf_arh-wth-cli-tot.sum-type     = 'при':U
     1630           and buf_arh-wth-cli-tot.fact-order  <= p-fact-order
     1631       no-error .
     1632       if available buf_arh-wth-cli-tot then do:
     1633         assign
     1634           v-saldo = v-saldo + if v-print-rubl then buf_arh-wth-cli-tot.out-sum-rubl
     1635                               else                 buf_arh-wth-cli-tot.out-sum-base
     1636         .
     1637       end.
     1638     end.
     1639     assign
     1640       p-saldo = v-saldo
     1641     .
     1642   end.
     1643   end procedure.
     1644   procedure CalcOstatFin:
     1645     do on error undo, return error return-value :
     1646       define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1647       define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1648       define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1649       define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1650       define input  parameter p-fact-order     as decimal   no-undo .
     1651       define input  parameter p-type          as character no-undo .
     1652       define output parameter p-sum-exp       as decimal   no-undo .
     1653       define output parameter p-sum-inc       as decimal   no-undo .
     1654       define buffer buf_contract                for ub.contract .
     1655       define buffer buf_arh-fin-doc-contr-schet for ub.arh-fin-doc-contr-schet .
     1656       for each buf_contract no-lock
     1657         where buf_contract.host-code = p-host-code-obj
     1658           and buf_contract.cli-type  = p-cli-type
     1659           and buf_contract.cli-code  = p-cli-code
     1660           and buf_contract.doc-type  = 'рас':U
     1661       :
     1662         find last buf_arh-fin-doc-contr-schet no-lock
     1663           where buf_arh-fin-doc-contr-schet.host-code        = p-host-code-obj
     1664             and buf_arh-fin-doc-contr-schet.contract-code    = buf_contract.contract-code
     1665             and buf_arh-fin-doc-contr-schet.code-schet       = 0
     1666             and buf_arh-fin-doc-contr-schet.cli-code         = p-cli-code
     1667             and buf_arh-fin-doc-contr-schet.cli-type         = p-cli-type
     1668             and buf_arh-fin-doc-contr-schet.fin-ext-doc-type = p-type
     1669             and buf_arh-fin-doc-contr-schet.calc-curr-code   = p-curr-r-b
     1670             and buf_arh-fin-doc-contr-schet.sum-type         = "sum-contract"
     1671             and buf_arh-fin-doc-contr-schet.fact-order      < p-fact-order
     1672         no-error .
     1673         if available buf_arh-fin-doc-contr-schet then
     1674           assign
     1675             p-sum-exp = p-sum-exp + buf_arh-fin-doc-contr-schet.expense
     1676             p-sum-inc = p-sum-inc + buf_arh-fin-doc-contr-schet.income
     1677           .
     1678         end.
     1679       end.
     1680   end procedure.
     1681   procedure CalcOstatFinNal:
     1682     do on error undo, return error return-value :
     1683       define input  parameter p-cli-type      like ub.clients.obj-type no-undo .
     1684       define input  parameter p-cli-code      like ub.clients.obj-code no-undo .
     1685       define input  parameter p-host-code-obj like ub.clients.obj-code no-undo .
     1686       define input  parameter p-curr-r-b      like ub.arh-fin-doc-contr-schet.calc-curr-code no-undo .
     1687       define input  parameter p-fact-order    as decimal   no-undo .
     1688       define input  parameter p-type          as character no-undo .
     1689       define output parameter p-sum-exp       as decimal   no-undo .
     1690       define output parameter p-sum-inc       as decimal   no-undo .
     1691       define buffer buf_contract                    for ub.contract .
     1692       define buffer buf_arh-fin-doc-contr-schet-nal for ub.arh-fin-doc-contr-schet-nal .
     1693       for each buf_contract no-lock
     1694         where buf_contract.host-code = p-host-code-obj
     1695           and buf_contract.cli-type  = p-cli-type
     1696           and buf_contract.cli-code  = p-cli-code
     1697           and buf_contract.doc-type  = 'рас':U
     1698       :
     1699         find last buf_arh-fin-doc-contr-schet-nal no-lock
     1700           where buf_arh-fin-doc-contr-schet-nal.host-code        = p-host-code-obj
     1701             and buf_arh-fin-doc-contr-schet-nal.contract-code    = buf_contract.contract-code
     1702             and buf_arh-fin-doc-contr-schet-nal.cli-code         = p-cli-code
     1703             and buf_arh-fin-doc-contr-schet-nal.cli-type         = p-cli-type
     1704             and buf_arh-fin-doc-contr-schet-nal.fin-code-acc     = 0
     1705             and buf_arh-fin-doc-contr-schet-nal.fin-ext-doc-type = p-type
     1706             and buf_arh-fin-doc-contr-schet-nal.curr-code        = p-curr-r-b
     1707             and buf_arh-fin-doc-contr-schet-nal.calc-curr-code   = p-curr-r-b
     1708             and buf_arh-fin-doc-contr-schet-nal.sum-type         = "sum-contract"
     1709             and buf_arh-fin-doc-contr-schet-nal.fact-order       < p-fact-order
     1710         no-error .
     1711         if available buf_arh-fin-doc-contr-schet-nal then
     1712           assign
     1713             p-sum-exp = p-sum-exp + buf_arh-fin-doc-contr-schet-nal.expense
     1714             p-sum-inc = p-sum-inc + buf_arh-fin-doc-contr-schet-nal.income
     1715           .
     1716         end.
     1717       end.
     1718   end procedure.
     1719   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run r-b-curr in g#library
     1721     (input  v-cntxt-host-code-obj
