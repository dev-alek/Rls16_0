     2611                             temp-gds-list.grp-name  = gds-obj.grp-name
     2612                             temp-gds-list.gds-name  = goods.grp-name
     2613                             temp-gds-list.gds-code  = gds-obj.gds-code
     2614                             temp-gds-list.artic     = gds-obj.artic
     2615                           .
     2616                       end.
     2617               end.
     2618       end.
     2619     for each temp-gds-list no-lock
     2620       , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2621         break
     2622       by temp-gds-list.gds-code :
     2623       run item-goods ( "1" , "goods" ) .
     2624         if return-value <> "" then next.
     2625     end.
     2626   end.
     2627     end.
     2628           when 3 then do:
     2629   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
