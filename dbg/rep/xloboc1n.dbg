     3193   procedure display-b1  :
     3194   define variable ll as int no-undo.
     3195   define variable kk as int no-undo.
     3196     b1-null-str# = 1.
     3197     b1-null-str2# = 1.
     3198     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3199     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3200      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3201         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3202                 if sums-only then do:
     3203                     if fr0 = true then do:
     3204                           num#str# = num#str# + 1     .
     3205                           num#col# = 1.
     3206                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3207                           run macr_cell_format
     3208                           ( 10    ,
     3209                             true  ,
     3210                             true  ,
     3211                             36    ,
     3212                             num#str# ,
     3213                             num#col# ,
     3214                             num#str# ,
     3215                             5 ) .
     3216                         fr0 = false .
     3217                       end.
     3218                  end.
     3219     num#str# = num#str# + 1     .
     3220     num#col# = 2 .
     3221     if substitute( "&1", sf1:screen-value )  <> "?" then
     3222       run macr_excel_char_with_format(  string(s-bar-code +
     3223                                    sf1:screen-value +
     3224                                    gds-zap-artic +
     3225                                    sf2:screen-value +
     3226                                    gds-zap-gds-name +
     3227                                    temp-str-2    )  , num#str# , num#col#  ) .
     3228      else
