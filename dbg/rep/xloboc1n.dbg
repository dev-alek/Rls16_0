     3230                                    gds-zap-artic +
     3231                                    gds-zap-gds-name +
     3232                                    temp-str-2    )  , num#str# , num#col#  ) .
     3233     num#col#  = 0 .
     3234     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3235     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3236     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3237     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3238     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3239     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3240   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3241   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3242   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
