     3374   procedure display-b2  :
     3375   define variable ll as int no-undo.
     3376   define variable kk as int no-undo.
     3377   b2-null-str#  = 1 .
     3378   b2-null-str2# = 1 .
     3379     if not show-negativ   then  run b2-null-str-pr   in this-procedure .
     3380     if not show-negativ-2 then  run b2-null-str-pr2  in this-procedure .
     3381      if not  (not show-negativ   and b2-null-str#  = 0  ) then do :
     3382         if not  (not show-negativ-2 and b2-null-str2# = 0  ) then do :
     3383   assign
     3384     num#str# = num#str# + 1
     3385     num#col# = 1.
     3386     run macr_excel_char_with_format( string( s-bar-code + ' ' + gds-zap-artic + ' ' + gds-zap-gds-name)  , num#str# , num#col#  ) .
     3387     num#col#  = 0 .
     3388     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3389     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3390     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3391     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3392     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3393     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3394   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3395   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3396   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3397   def var l-nk as integer no-undo .
     3398     Assign
     3399       LL = 0
     3400       KK = 1
     3401     .
     3402     if xShowCost      Then DO: KK = KK + 1. End.
     3403     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3404     if xShowCrsa      Then DO: KK = KK + 1. End.
     3405     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3406     if xShowSale      Then DO: KK = KK + 1. End.
     3407     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3408     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3409     if xShowmediator  Then DO: KK = KK + 1. End.
     3410     if x-tog-wt       then do: KK = KK + 1. End.
     3411     if x-tog-ms       then do: KK = KK + 1. End.
     3412     if xDens          then do: KK = KK + 1. End.
     3413     repeat i = 1 to 13 :
     3414       if i = 7 then next.
     3415       if NOT xShowCost      and i = 2   Then  next.
     3416       if NOT xShowCostNDS   and i = 3   Then  next.
     3417       if NOT xShowCrsa      and i = 5   Then  next.
     3418       if NOT xShowCrsaNds   and i = 6   Then  next.
     3419       if NOT xShowSale      and i = 8   Then  next.
     3420       if NOT xShowSaleNds   and i = 9   Then  next.
     3421       if NOT xShowSaleSlt   and i = 10  Then  next.
     3422       if NOT xShowmediator  and i = 4   Then  next.
     3423       if not x-tog-wt       and i = 11  then  next.
     3424       if not x-tog-ms       and i = 12  then  next.
     3425       if not xDens          and i = 13  then  next.
     3426       assign
     3427         LL = LL + 1
     3428         l-nk = mp-1
     3429       .
     3430     if x-vat or i <> 2  then do:
     3431     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-ostatok-start                          [i] ,  i). end.
     3432     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ie          [i] ,  i). end.
     3433     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-iv          [i] ,  i). end.
     3434     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-im           [i] ,  i). end.
     3435     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ee          [i] ,  i). end.
     3436     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ev          [i] ,  i). end.
     3437     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-em           [i] ,  i). end.
     3438     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-we          [i] ,  i). end.
     3439     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-es     [i] ,  i). end.
     3440     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-rs [i] ,  i). end.
     3441     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-re      [i] ,  i). end.
     3442     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ep       [i] ,  i). end.
     3443     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-rv      [i] ,  i). end.
     3444     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-vt                [i] ,  i). end.
     3445     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ot           [i] ,  i). end.
     3446     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-ostatok-end                            [i] ,  i). end.
     3447     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-ap [i] ,  i). end.
     3448     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b2-oborot-pc [i] ,  i). end.
     3449     if i = 13 then do:
     3450       if "b2-" = "b1-" or "b2-" = "b2-" or "b2-" = "bi-" or "b2-" = "bo-" then do:
     3451          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3452       end.
     3453       else do:
     3454         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b2-oborot-ee         [1] +
     3455                                                                                                                                       b2-oborot-re     [1] +
     3456                                                                                                                                       b2-oborot-es    [1] +
     3457                                                                                                                                       b2-oborot-rs[1] ) <> 0
     3458                                                                                                                               then
     3459                                                                                                                                   ABS(b2-oborot-ee         [11] +
     3460                                                                                                                                       b2-oborot-re     [11] +
     3461                                                                                                                                       b2-oborot-es    [11] +
     3462                                                                                                                                       b2-oborot-rs[11] )
     3463                                                                                                                                   /
     3464                                                                                                                                   ABS(b2-oborot-ee         [1] +
     3465                                                                                                                                       b2-oborot-re     [1] +
     3466                                                                                                                                       b2-oborot-es    [1] +
     3467                                                                                                                                       b2-oborot-rs[1] )
     3468                                                                                                                               else 0 )
     3469         ,  i). end.
     3470       end.
     3471     end.
     3472     else do:
     3473     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (b2-oborot-ee         [i] +
     3474                                                                                                                           b2-oborot-re     [i] +
     3475                                                                                                                           b2-oborot-es    [i] +
     3476                                                                                                                           b2-oborot-rs[i] )
     3477     ,  i). end.
     3478     end.
     3479     end.
     3480     if x-vat = false  and i = 2 then do:
     3481     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-start                          [i] -  b2-ostatok-start                          [3] ),  i). end.
     3482     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ie          [i] -  b2-oborot-ie          [3] ),  i). end.
     3483     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-iv          [i] -  b2-oborot-iv          [3] ),  i). end.
     3484     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-im           [i] -  b2-oborot-im           [3] ),  i). end.
     3485     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ee          [i] -  b2-oborot-ee          [3] ),  i). end.
     3486     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ev          [i] -  b2-oborot-ev          [3] ),  i). end.
     3487     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-em           [i] -  b2-oborot-em           [3] ),  i). end.
     3488     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-we          [i] -  b2-oborot-we          [3] ),  i). end.
     3489     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-es     [i] -  b2-oborot-es     [3] ),  i). end.
     3490     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rs [i] -  b2-oborot-rs [3] ),  i). end.
     3491     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-re      [i] -  b2-oborot-re      [3] ),  i). end.
     3492     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ep       [i] -  b2-oborot-ep       [3] ),  i). end.
     3493     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rv      [i] -  b2-oborot-rv      [3] ),  i). end.
     3494     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-vt                [i] -  b2-oborot-vt                [3] ),  i). end.
     3495     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ot           [i] -  b2-oborot-ot           [3] ),  i). end.
     3496     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-end                            [i] -  b2-ostatok-end                            [3] ),  i). end.
     3497     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ap [i] -  b2-oborot-ap[3] ),  i). end.
     3498     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3499     if i = 13 then do :
     3500       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3501     end.
     3502     else do:
     3503       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3504       (                                                                                      (b2-oborot-ee         [i] +
     3505                                                                                               b2-oborot-re     [i] +
     3506                                                                                               b2-oborot-es    [i] +
     3507                                                                                               b2-oborot-rs[i]) -
     3508                                                                                             (b2-oborot-ee         [3] +
     3509                                                                                               b2-oborot-re     [3] +
     3510                                                                                               b2-oborot-es    [3] +
     3511                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3512     end.
     3513     end.
     3514     end.
     3515    run new-tmp-page .
     3516     run macr_cell_format
     3517     ( 10    ,
     3518       true  ,
     3519       true  ,
     3520       33    ,
     3521       num#str# ,
     3522       1 ,
