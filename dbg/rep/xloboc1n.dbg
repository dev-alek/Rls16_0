     2662                       create temp-gds-list.
     2663                       assign
     2664                         temp-gds-list.prod-code = gds-obj.prod-code
     2665                         temp-gds-list.grp-name  = gds-obj.grp-name
     2666                         temp-gds-list.gds-name  = goods.gds-name
     2667                         temp-gds-list.gds-code  = gds-obj.gds-code
     2668                         temp-gds-list.artic     = gds-obj.artic
     2669                       .
     2670                   end.
     2671             end.
     2672       end.
     2673         for each temp-gds-list no-lock
     2674           , first goods  where goods.gds-code  = temp-gds-list.gds-code no-lock
     2675             break
     2676               by temp-gds-list.gds-code :
     2677           run item-goods ( "1" , "goods" ) .
     2678             if return-value <> "" then next.
     2679         end.
     2680   end.
     2681     end.
     2682           otherwise do:
     2683   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2684   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2685       for each gds-obj  where
     2686             gds-obj.obj-type = x-store-type  and
     2687             gds-obj.obj-code = x-store-code
     2688             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2689                   no-lock,
     2690             First goods  where  gds-obj.gds-code   = goods.gds-code
     2691         no-lock,
     2692   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2693   no-lock
     2694   BREAK
     2695       BY (gds-list.gds-code) :
     2696         run item-goods ( "1" , "gds-list" ) .
     2697         if return-value <> "" then NEXT.
