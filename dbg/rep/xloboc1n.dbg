     4758   procedure ex-display :
     4759   define input parameter par-1 as int no-undo.
     4760   define input parameter par-2 like  ostatok-start[1] no-undo.
     4761   define input parameter par-i as int no-undo.
     4762     assign num#col#  = par-1.
     4763     if par-i = 13 then do:
     4764       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     4765     end.
     4766     else do:
     4767       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     4768         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4769       end.
     4770       else do :
     4771         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4772       end.
     4773     end.
     4774   end procedure.
     4775   procedure u-line:
     4776   end procedure.
     4777   procedure p-line:
     4778   end procedure.
     4779   procedure make-col :
     4780    define variable l#1 as int  no-undo.
     4781    define variable l#2 as int  no-undo.
     4782    define variable l as int  no-undo.
     4783     assign
     4784       nk = 0
     4785       kk = 0
     4786     .
     4787     if xshowcost     then do: kk = kk + 1. end.
     4788     if xshowcostnds  then do: kk = kk + 1. end.
     4789     if xshowcrsa     then do: kk = kk + 1. end.
     4790     if xshowcrsands  then do: kk = kk + 1. end.
     4791     if xshowsale     then do: kk = kk + 1. end.
     4792     if xshowsalends  then do: kk = kk + 1. end.
     4793     if xshowsaleslt  then do: kk = kk + 1. end.
     4794     if xshowmediator then do: kk = kk + 1. end.
     4795     if x-tog-wt      then do: kk = kk + 1. end.
     4796     if x-tog-ms      then do: kk = kk + 1. end.
     4797     if xDens         then do: kk = kk + 1. end.
     4798    assign
     4799     num#str# = num#str# + 1
     4800     num#col#  = 0
     4801    .
     4802    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4803    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4804    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4805    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4806    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4807    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4808    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4809    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4810    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4811       mp = num#col#  + 1.
     4812       mp-1 = num#col#  .
     4813    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4814    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4815    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4816    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4817    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4818    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4819    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4820    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4821    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4822    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4823    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4824    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4825    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4826    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4827    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4828    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4829    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4830    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4831    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4832       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     4833      num#str# = num#str# + 1.
     4834      repeat l#1 = mp to nk :
     4835            l#2 = 0.
     4836                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     4837            if xshowcost    then do:
     4838                l#2 = l#2 + 1.
     4839                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     4840                end.
     4841            if xshowcostnds then do:
     4842                l#2 = l#2 + 1.
     4843                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     4844               end.
     4845            if xshowmediator then do:
     4846               l#2 = l#2 + 1.
     4847               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     4848               end.
     4849            if xshowcrsa    then do:
     4850               l#2 = l#2 + 1.
     4851               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     4852               end.
     4853            if xshowcrsands then do:
     4854               l#2 = l#2 + 1.
     4855               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     4856               end.
     4857             if xshowsale    then do:
     4858               l#2 = l#2 + 1.
     4859               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     4860               end.
     4861            if xshowsalends then do:
     4862               l#2 = l#2 + 1.
     4863               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     4864               end.
     4865            if xshowsaleslt then do:
     4866               l#2 = l#2 + 1.
     4867               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     4868            end.
     4869            if x-tog-wt then do:
     4870             assign
     4871               l#2 = l#2 + 1
     4872               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4873             .
     4874             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     4875            end.
     4876            if x-tog-ms then do:
     4877             assign
     4878               l#2 = l#2 + 1
     4879               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4880             .
     4881             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     4882            end.
     4883            if xDens then do:
     4884             assign
     4885               l#2 = l#2 + 1
     4886               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     4887             .
     4888             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     4889            end.
     4890        end.
     4891   end procedure .
