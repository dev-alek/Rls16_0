     2728     End.
     2729   End.
     2730           end.
     2731          end case.
     2732   end procedure.
     2733   procedure calcitog :
     2734       run ostatok  in this-procedure (
     2735           input x-store-code  ,
     2736           input x-store-type  , x-tog-shift ,
     2737           input x-date-start - 1 ,
     2738           input date('')      , x-Shift-Start,x-Shift-End,
     2739           input 'crsa':U   ,
     2740           input '##,##':U,
     2741           input xtog-obj ,
     2742           output  quantity1  ,
     2743           output  coast_r1   ,
     2744           output  coast_v1   ,
     2745           output  vat_r1     ,
     2746           output  vat_v1     ,
     2747           output  fact-order-1 ).
     2748       run ostatok  in this-procedure (
     2749           input x-store-code  ,
     2750           input x-store-type  , x-tog-shift ,
     2751           input x-date-start  ,
     2752           input x-date-end    , x-Shift-Start,x-Shift-End,
     2753           input 'crsa':U   ,
     2754           input '##,##':U,
     2755           input xtog-obj ,
     2756           output  quantity1  ,
     2757           output  coast_r1   ,
     2758           output  coast_v1   ,
     2759           output  vat_r1     ,
     2760           output  vat_v1     ,
     2761           output  fact-order-2 ).
     2762             quantity1  = 0.
     2763             coast_r1   = 0.
     2764             coast_v1   = 0.
     2765             vat_r1     = 0.
     2766             vat_v1     = 0.
     2767   end procedure.
     2768   procedure display-str1  :
     2769   define variable ll as int no-undo.
     2770     assign
     2771       num#str# = num#str# + 1
     2772       num#col# = 0
     2773       v-gds-num = v-gds-num + 1
     2774     .
     2775     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     2776     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     2777     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     2778     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     2779     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     2780     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     2781   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2782   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2783   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2784   def var l-nk as integer no-undo .
     2785     Assign
     2786       LL = 0
     2787       KK = 1
     2788     .
     2789     if xShowCost      Then DO: KK = KK + 1. End.
     2790     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2791     if xShowCrsa      Then DO: KK = KK + 1. End.
     2792     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2793     if xShowSale      Then DO: KK = KK + 1. End.
     2794     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2795     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2796     if xShowmediator  Then DO: KK = KK + 1. End.
     2797     if x-tog-wt       then do: KK = KK + 1. End.
     2798     if x-tog-ms       then do: KK = KK + 1. End.
     2799     if xDens          then do: KK = KK + 1. End.
     2800     repeat i = 1 to 13 :
     2801       if i = 7 then next.
     2802       if NOT xShowCost      and i = 2   Then  next.
     2803       if NOT xShowCostNDS   and i = 3   Then  next.
     2804       if NOT xShowCrsa      and i = 5   Then  next.
     2805       if NOT xShowCrsaNds   and i = 6   Then  next.
     2806       if NOT xShowSale      and i = 8   Then  next.
     2807       if NOT xShowSaleNds   and i = 9   Then  next.
     2808       if NOT xShowSaleSlt   and i = 10  Then  next.
     2809       if NOT xShowmediator  and i = 4   Then  next.
     2810       if not x-tog-wt       and i = 11  then  next.
     2811       if not x-tog-ms       and i = 12  then  next.
     2812       if not xDens          and i = 13  then  next.
     2813       assign
     2814         LL = LL + 1
     2815         l-nk = mp-1
     2816       .
     2817     if x-vat or i <> 2  then do:
     2818     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     2819     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     2820     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     2821     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     2822     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     2823     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     2824     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     2825     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     2826     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     2827     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     2828     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     2829     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     2830     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
     2831     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-vt                [i] ,  i). end.
     2832     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ot           [i] ,  i). end.
     2833     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-end                            [i] ,  i). end.
     2834     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ap [i] ,  i). end.
     2835     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-pc [i] ,  i). end.
     2836     if i = 13 then do:
     2837       if "" = "b1-" or "" = "b2-" or "" = "bi-" or "" = "bo-" then do:
     2838          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     2839       end.
     2840       else do:
     2841         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(oborot-ee         [1] +
     2842                                                                                                                                       oborot-re     [1] +
     2843                                                                                                                                       oborot-es    [1] +
     2844                                                                                                                                       oborot-rs[1] ) <> 0
     2845                                                                                                                               then
     2846                                                                                                                                   ABS(oborot-ee         [11] +
     2847                                                                                                                                       oborot-re     [11] +
     2848                                                                                                                                       oborot-es    [11] +
     2849                                                                                                                                       oborot-rs[11] )
     2850                                                                                                                                   /
     2851                                                                                                                                   ABS(oborot-ee         [1] +
     2852                                                                                                                                       oborot-re     [1] +
     2853                                                                                                                                       oborot-es    [1] +
     2854                                                                                                                                       oborot-rs[1] )
     2855                                                                                                                               else 0 )
     2856         ,  i). end.
     2857       end.
     2858     end.
     2859     else do:
     2860     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (oborot-ee         [i] +
     2861                                                                                                                           oborot-re     [i] +
     2862                                                                                                                           oborot-es    [i] +
     2863                                                                                                                           oborot-rs[i] )
     2864     ,  i). end.
     2865     end.
     2866     end.
     2867     if x-vat = false  and i = 2 then do:
     2868     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-start                          [i] -  ostatok-start                          [3] ),  i). end.
     2869     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ie          [i] -  oborot-ie          [3] ),  i). end.
     2870     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-iv          [i] -  oborot-iv          [3] ),  i). end.
     2871     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-im           [i] -  oborot-im           [3] ),  i). end.
     2872     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ee          [i] -  oborot-ee          [3] ),  i). end.
     2873     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ev          [i] -  oborot-ev          [3] ),  i). end.
     2874     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-em           [i] -  oborot-em           [3] ),  i). end.
     2875     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-we          [i] -  oborot-we          [3] ),  i). end.
     2876     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-es     [i] -  oborot-es     [3] ),  i). end.
     2877     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rs [i] -  oborot-rs [3] ),  i). end.
     2878     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-re      [i] -  oborot-re      [3] ),  i). end.
     2879     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ep       [i] -  oborot-ep       [3] ),  i). end.
     2880     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rv      [i] -  oborot-rv      [3] ),  i). end.
     2881     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-vt                [i] -  oborot-vt                [3] ),  i). end.
