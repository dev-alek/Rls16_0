     3004                                                                                                                           bi-oborot-re     [i] +
     3005                                                                                                                           bi-oborot-es    [i] +
     3006                                                                                                                           bi-oborot-rs[i] )
     3007     ,  i). end.
     3008     end.
     3009     end.
