     2904   procedure display-bi  :
     2905   define variable ll as int no-undo.
     2906   define variable kk as int no-undo.
     2907     num#col#  = 0 .
     2908     if use-column[28] then assign num#col#  = num#col#  + 1 .
     2909     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     2910     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     2911     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     2912     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     2913     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     2914     run macr_cell_format
     2915                                 ( 10    ,
     2916                                   true  ,
     2917                                   false ,
     2918                                   ?    ,
     2919                                   num#str# ,
     2920                                   1 ,
     2921                                   num#str# ,
     2922                                   (mp + ll + (kk * (27 - 8)))
     2923                                   ) .
     2924   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2925   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2926   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2927   def var l-nk as integer no-undo .
     2928     Assign
     2929       LL = 0
     2930       KK = 1
     2931     .
     2932     if xShowCost      Then DO: KK = KK + 1. End.
     2933     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2934     if xShowCrsa      Then DO: KK = KK + 1. End.
     2935     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2936     if xShowSale      Then DO: KK = KK + 1. End.
     2937     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2938     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2939     if xShowmediator  Then DO: KK = KK + 1. End.
     2940     if x-tog-wt       then do: KK = KK + 1. End.
     2941     if x-tog-ms       then do: KK = KK + 1. End.
     2942     if xDens          then do: KK = KK + 1. End.
     2943     repeat i = 1 to 13 :
     2944       if i = 7 then next.
     2945       if NOT xShowCost      and i = 2   Then  next.
     2946       if NOT xShowCostNDS   and i = 3   Then  next.
     2947       if NOT xShowCrsa      and i = 5   Then  next.
     2948       if NOT xShowCrsaNds   and i = 6   Then  next.
     2949       if NOT xShowSale      and i = 8   Then  next.
