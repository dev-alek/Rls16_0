     2703                   gds-obj.obj-type = obj-list.obj-type    and
     2704                   gds-obj.obj-code = obj-list.obj-code
     2705                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2706                   no-lock,
     2707             First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     2708                   no-lock :
     2709                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     2710                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     2711                       Create temp-gds-list.
     2712                       Assign
     2713                         temp-gds-list.prod-code = gds-obj.prod-code
     2714                         temp-gds-list.grp-name  = gds-obj.grp-name
     2715                         temp-gds-list.gds-name  = goods.gds-name
     2716                         temp-gds-list.gds-code  = gds-obj.gds-code
     2717                         temp-gds-list.artic     = gds-obj.artic
     2718                       .
     2719                   End.
     2720               End.
     2721     End.
     2722     for each temp-gds-list no-lock
     2723       , First gds-list  where gds-list.gds-code  = temp-gds-list.gds-code no-lock
     2724         BREAK
