     4448   procedure item-goods :
     4449    define input parameter  par-3 as char no-undo.
     4450    define input parameter  par-4 as char no-undo.
     4451        if par-4 = "goods":u  then  assign
     4452                                       gds-zap-unit-base  = goods.unit-base
     4453                                       gds-zap-prt-root   = goods.prt-root
     4454                                       gds-zap-prod-type  = goods.prod-type
     4455                                       gds-zap-prod-code  = goods.prod-code
     4456                                       gds-zap-artic      = goods.artic
     4457                                       gds-zap-type       = goods.gds-type
     4458                                       gds-zap-grp-name   = goods.grp-name
     4459                                       gds-zap-b-code     = goods.gds-code
     4460                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4461                                                                          else goods.gds-name
     4462                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4463                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4464        if par-4 = "gds-list":u  then  assign
     4465                                       gds-zap-unit-base  = gds-list.unit-base
     4466                                       gds-zap-prt-root   = gds-list.prt-root
     4467                                       gds-zap-prod-type  = gds-list.prod-type
     4468                                       gds-zap-prod-code  = gds-list.prod-code
     4469                                       gds-zap-artic      = gds-list.artic
     4470                                       gds-zap-type       = gds-list.gds-type
     4471                                       gds-zap-grp-name   = gds-list.grp-name
     4472                                       gds-zap-b-code     = gds-list.gds-code
     4473                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4474                                                                          else gds-list.gds-name
     4475                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4476                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4477       run foreach in this-procedure .
     4478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4479     (input  gds-zap-b-code
     4480     ,input  ?
     4481     ,output v-bar-code
     4482     )  .
     4483   s-bar-code = string (v-bar-code,"999999999").
     4484       If  break_group = true  and par-3 <> "1"  then DO :
     4485            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4486            gds-zap-prod-name  = clients.obj-name.
     4487             If break_group1 = true  THEN  DO :
     4488               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4489                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4490                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4491               if par-3 = "6"  then  dO:
     4492                  if xTog-obj = true then do:
     4493                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4494                   end.
     4495                  else do:
     4496                   var-vat-pc = temp-gds-list.vat-pc  .
     4497                   end.
     4498                   assign
     4499                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4500                       b1-name = temp-str .
     4501                   end.
     4502               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4503                   fr0 = true .
     4504                   tmp#stroka0 = temp-str.
     4505               End .
     4506             End .
     4507             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4508               if par-3 = "4"
     4509                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4510                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4511               if NOT xSumsOnly THEN DO :
     4512               fr = true .
     4513               End.
     4514               break_group1 = false.
     4515             END.
     4516          break_group = false.
     4517       End.
     4518       run display-line in this-procedure .
     4519    end procedure.
