     3618   procedure ob-line  :
     3619   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3620   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3621   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3622   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3623   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3624   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3625   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3626   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3627   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3628   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3629   define input  parameter xtog-obj           as log no-undo.
     3630   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3631   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3632   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3633   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3634   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3635   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3636   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3637   define variable  v-summa  as decimal extent 4 no-undo .
     3638   define variable  tt#          as int no-undo.
     3639   define variable v-ii as integer no-undo .
     3640   define variable slt  as decimal no-undo .
     3641   define variable disc  as decimal no-undo .
     3642   define variable xi as integer no-undo .
     3643   define variable v-tt as integer no-undo .
     3644    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3645       else
     3646       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3647       else
     3648       assign tt# = 6  v-tt = 200.
     3649     if long-p = false then do :
     3650     for each obj-list no-lock:
     3651      if  xtog-obj then
     3652          if   not(x-store-type     = obj-list.obj-type
     3653               and x-store-code    = obj-list.obj-code ) then next.
     3654           for each ub.ot-line where
     3655                     ub.ot-line.artic         = x-artic
     3656               and   ub.ot-line.prod-code    = x-prod-code
     3657               and   ub.ot-line.prod-type    = x-prod-type
     3658               and   ub.ot-line.fact-order   <= x-fact-order-2
     3659               and   ub.ot-line.fact-order   >= x-fact-order-1
     3660               and   ub.ot-line.obj-code     = obj-list.obj-code
     3661               and   ub.ot-line.obj-type     = obj-list.obj-type
     3662               and   ub.ot-line.sum-type     = x-sum-type
     3663               no-lock :
     3664               case ub.ot-line.ext-doc-type:
     3665     WHEN 'ie':U THEN DO:
     3666       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3667             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3668             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3669         if tt# = 6 Then   assign
     3670             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3671             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3672             End.
     3673     WHEN 'ee':U THEN DO:
     3674       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3675             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3676             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3677         if tt# = 6 Then   assign
     3678             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3679             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3680             End.
     3681     WHEN 'ep':U THEN DO:
     3682       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3683             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3684             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3685         if tt# = 6 Then   assign
     3686             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3687             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3688             End.
     3689     WHEN 'es':U THEN DO:
     3690       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3691             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3692             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3693         if tt# = 6 Then   assign
     3694             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3695             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3696             End.
     3697     WHEN 're':U THEN DO:
     3698       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3699             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3700             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3701         if tt# = 6 Then   assign
     3702             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3703             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3704             End.
     3705     WHEN 'rs':U THEN DO:
     3706       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3707             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3708             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3709         if tt# = 6 Then   assign
     3710             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3711             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3712             End.
     3713     WHEN 'we':U THEN DO:
     3714       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3715             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3716             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3717         if tt# = 6 Then   assign
     3718             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3719             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3720             End.
     3721     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     3722       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     3723             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3724             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3725           if tt# = 6 Then  assign
     3726             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3727             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3728             End.
     3729     WHEN 'iv':U THEN DO:
     3730       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     3731             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3732             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3733         if tt# = 6 Then   assign
     3734             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3735             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3736             End.
     3737     WHEN 'ev':U THEN DO:
     3738       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     3739             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3740             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3741         if tt# = 6 Then   assign
     3742             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3743             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3744             End.
     3745     WHEN 'rv':U THEN DO:
     3746       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     3747             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3748             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3749         if tt# = 6 Then   assign
     3750             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3751             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3752             End.
     3753     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     3754       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     3755             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3756             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
