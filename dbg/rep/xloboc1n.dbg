     4951   procedure new-tmp-page :
     4952    do
     4953    on error undo, return error return-value
     4954    :
     4955       if   num#str#  >=  63000  then do:
     4956           output stream macr_excel  close .
     4957           run paramls-write in this-procedure
     4958             (input "file"
     4959             ,input string(v-ind)
     4960             ,input v-file-name
     4961             ) .
     4962           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     4963           output stream  macr_excel to value(v-file-name) .
     4964           v-ind = v-ind + 1 .
     4965           num#str# = 0 .
     4966   define variable old-s as integer no-undo .
     4967   define variable old-s2 as integer no-undo .
     4968       assign
     4969       old-s =   num#str#
     4970       .
     4971       run make-col .
     4972       assign
     4973         old-s2 =   num#str#
     4974       .
     4975      num#str# = old-s + 1  .
     4976      run proc-print-header .
     4977      num#str# = old-s2     .
     4978       end.
     4979    end.
     4980   end procedure.
     4981   procedure pp :
     4982   define input parameter ll as integer no-undo .
     4983   define input parameter uu as integer no-undo .
     4984   define input parameter ff as character no-undo .
     4985   End procedure.
     4986   procedure find-last-prise-med :
     4987   define input parameter p-artic     like ub.goods.artic no-undo .
     4988   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     4989   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     4990   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     4991   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     4992   define buffer p-gds-obj   for  ub.gds-obj .
     4993   define buffer buf_trn-doc for  ub.trn-doc .
     4994   define variable v-fact-order as decimal no-undo .
     4995   p-price = 0 .
     4996     define variable v-in-date as date      no-undo .
     4997     define variable fl as logical no-undo .
     4998     fl = yes.
     4999     v-fact-order = 0 .
     5000     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5001     :
     5002       find first p-gds-obj no-lock
     5003         where p-gds-obj.artic     = p-artic         and
     5004                 p-gds-obj.prod-type = p-prod-type     and
     5005                 p-gds-obj.prod-code = p-prod-code     and
     5006                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5007                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5008         no-error .
     5009       if available p-gds-obj then do:
     5010       if p-gds-obj.in-date = ?  then next .
     5011       if fl = yes then do:
     5012         assign
     5013           v-in-date = p-gds-obj.in-date
     5014           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5015           fl = no
     5016       .
     5017        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5018        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5019       end.
     5020         if p-gds-obj.in-date >= v-in-date   then do:
     5021            if p-gds-obj.in-date = v-in-date then do:
     5022               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5023               if available buf_trn-doc  then
     5024                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5025                     assign
     5026                       v-fact-order = buf_trn-doc.fact-order
     5027                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5028                       v-in-date =   p-gds-obj.in-date
     5029                     .
     5030                   end.
     5031            end.
     5032            else do:
     5033             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5034             if available buf_trn-doc  then
     5035                 assign
     5036                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5037                   v-in-date =    p-gds-obj.in-date
     5038                   v-fact-order = buf_trn-doc.fact-order .
     5039                 .
     5040             end.
     5041           if p-price = ? then   p-price  = 0 .
     5042         end.
     5043       end.
     5044     End .
     5045     if p-price = ? then   p-price  = 0 .
     5046   end procedure.
     5047   procedure find-mediator :
     5048   define input  parameter c-host-code as integer no-undo .
     5049   define input  parameter p-Showmediatr as logical no-undo .
     5050   define output parameter p-host-code as integer no-undo .
     5051   define output parameter p-flag as logical no-undo .
     5052   define buffer b-sysconf  for ub.sysconf.
     5053    p-host-code = 0 .
     5054    p-flag  = true .
     5055       if p-Showmediatr = true then do:
     5056       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5057             if avail ub.sysconf then DO :
     5058               p-host-code = ub.sysconf.host-code.
     5059               if tPrintRubl = false then do:
     5060                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5061                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5062                                 p-flag  = false  .
     5063                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5064                                 view-as alert-box error.
     5065                           end.
     5066               end.
     5067             end.
     5068             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5069                 create tt-obj-list no-error .
     5070                 assign tt-obj-list.obj-type = 'маг':U
     5071                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5072             end.
     5073             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5074                 create tt-obj-list no-error .
     5075                 assign tt-obj-list.obj-type = 'скл':U
     5076                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5077             end.
     5078       End.
     5079    End procedure .
     5080   PROCEDURE ob-line-stk  :
     5081   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5082   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5083   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5084   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5085   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5086   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5087   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5088   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5089   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5090   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5091   define input  parameter xTog-obj         as log                     no-undo.
     5092   define input  parameter xi               as int                     no-undo.
     5093   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5094   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5095   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5096   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5097   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5098   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5099   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5100   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5101   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5102   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5103   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5104   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5105   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5106   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5107   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5108   define buffer stk-line2 for ub.stk-line .
     5109   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5110    Assign
     5111      First-qnty  = 0
     5112      Second-qnty = 0
     5113      Quntity     = 0
     5114      First-sum  = 0
     5115      Second-sum = 0
     5116      sum        = 0
     5117      First-vat  = 0
     5118      Second-vat = 0
     5119      vat        = 0
     5120      First-slt   = 0
     5121      Second-slt  = 0
     5122      slt         = 0
     5123      First-disc  = 0
     5124      Second-disc = 0
     5125      disc        = 0
     5126     .
     5127     For each obj-list  no-lock :
     5128      if  xTog-obj THEN
     5129          if   NOT(    x-store-type     = obj-list.obj-type
     5130               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5131      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5132         find last ub.stk-line no-lock
     5133           where ub.stk-line.obj-type   = obj-list.obj-type
     5134             and ub.stk-line.obj-code   = obj-list.obj-code
     5135             and ub.stk-line.artic      = x-artic
     5136             and ub.stk-line.prod-type  = x-prod-type
     5137             and ub.stk-line.prod-code  = x-prod-code
     5138             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5139             and ub.stk-line.cat-id     = '##,##':U
     5140             and ub.stk-line.fact-order <= x-fact-order-1
     5141           use-index category
     5142           no-error .
     5143         if available ub.stk-line then do:
     5144           assign
     5145             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5146             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5147             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5148             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5149             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5150           .
     5151         end.
     5152         find last stk-line2 no-lock
     5153           where stk-line2.obj-code   = obj-list.obj-code
     5154             and stk-line2.obj-type   = obj-list.obj-type
     5155             and stk-line2.artic      = x-artic
     5156             and stk-line2.prod-type  = x-prod-type
     5157             and stk-line2.prod-code  = x-prod-code
     5158             and stk-line2.sum-type   = temp#sum-type.sum-type
     5159             and stk-line2.cat-id     = '##,##':U
     5160             and stk-line2.fact-order <= x-fact-order-2
     5161           use-index category
     5162           no-error .
     5163         if available stk-line2 then do:
     5164           assign
     5165             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5166             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5167             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5168             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5169             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5170           .
     5171         end.
     5172      end.
     5173    end.
     5174    Assign
     5175      Quntity = Second-qnty - first-qnty
     5176      sum     = Second-sum  - first-sum
     5177      vat     = Second-vat  - first-vat
     5178      slt     = Second-slt  - first-slt
     5179      disc    = Second-disc  - first-disc
     5180      .
     5181   END PROCEDURE.
     5182   procedure calc-ms-wt :
     5183   define input        parameter p-oborot-num      as decimal   no-undo .
     5184   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5185   define input-output parameter p-oborot          as decimal   no-undo .
     5186   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5187   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5188   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5189   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5190   do
     5191   on error undo, return error return-value
     5192   :
     5193   if p-is-petrol = true then return .
     5194     assign
     5195       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5196       p-bi-oborot = p-bi-oborot + p-oborot
     5197       p-bo-oborot = p-bo-oborot + p-oborot
     5198       p-b1-oborot = p-b1-oborot + p-oborot
     5199       p-b2-oborot = p-b2-oborot + p-oborot
     5200     .
     5201   end.
     5202   end procedure.
     5203   procedure calc-dens :
     5204   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5205   define input        parameter p-ostatok          as decimal   no-undo .
     5206   define input-output parameter p-density          as decimal   no-undo .
     5207   define input-output parameter p-bi-density       as decimal   no-undo .
     5208   define input-output parameter p-bo-density       as decimal   no-undo .
     5209   define input-output parameter p-b1-density       as decimal   no-undo .
     5210   define input-output parameter p-b2-density       as decimal   no-undo .
     5211   do
     5212   on error undo, return error return-value
     5213   :
     5214   if p-is-petrol = false then return .
     5215     assign
     5216       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5217       p-bi-density = 0
     5218       p-bo-density = 0
     5219       p-b1-density = 0
     5220       p-b2-density = 0
     5221     .
     5222   end.
     5223   end procedure.
     5224   procedure calc-pt-ob :
     5225   define input  parameter p-ext-doc-type    as character no-undo .
     5226   define input  parameter x-store-type      as character no-undo .
     5227   define input  parameter x-store-code      as integer   no-undo .
     5228   define input  parameter p-artic           as character no-undo .
     5229   define input  parameter p-prod-type       as character no-undo .
     5230   define input  parameter p-prod-code       as integer   no-undo .
     5231   define input-output parameter p-oborot    as decimal   no-undo .
     5232   define input-output parameter p-bi-oborot as decimal   no-undo .
     5233   define input-output parameter p-bo-oborot as decimal   no-undo .
     5234   define input-output parameter p-b1-oborot as decimal   no-undo .
     5235   define input-output parameter p-b2-oborot as decimal   no-undo .
     5236     do
     5237     on error undo, return error return-value
     5238     :
     5239   define variable v-oborot as decimal   no-undo .
     5240   define buffer buf_doc-line  for ub.doc-line  .
     5241   define buffer buf_inv-line  for ub.inv-line  .
     5242   define buffer buf1_obj-list for obj-list .
     5243   assign
     5244     v-oborot = 0
     5245   .
     5246   if p-is-petrol = false   then return .
     5247     for each buf1_obj-list no-lock :
     5248      if  xtog-obj then
     5249          if   not(x-store-type     = buf1_obj-list.obj-type
     5250               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5251       for each buf_doc-line  no-lock where
     5252             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5253             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5254             buf_doc-line.artic        = p-artic and
     5255             buf_doc-line.prod-type    = p-prod-type and
     5256             buf_doc-line.prod-code    = p-prod-code and
     5257             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5258             buf_doc-line.status_      = 'факт':U        and
     5259             buf_doc-line.fact-order   <= fact-order-2  and
     5260             buf_doc-line.fact-order   >= fact-order-1
     5261             :
     5262             for each buf_inv-line  no-lock where
     5263                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5264                 buf_inv-line.artic        = buf_doc-line.artic and
     5265                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5266                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5267                 :
     5268                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5269                     else do:
     5270                     if p-ext-doc-type = 'we':U    or
     5271                        p-ext-doc-type = 'ee':U    or
     5272                        p-ext-doc-type = 'ev':U    or
     5273                        p-ext-doc-type = 'ep':U or
     5274                        p-ext-doc-type = 'em':U     or
     5275                        p-ext-doc-type = 'wm':U     or
     5276                        p-ext-doc-type = 'es':U   then
     5277                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5278                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5279                     end.
     5280             end.
     5281       end.
     5282   end.
     5283   assign
     5284     p-oborot    = v-oborot
     5285     p-bi-oborot = p-bi-oborot + v-oborot
     5286     p-bo-oborot = p-bo-oborot + v-oborot
     5287     p-b1-oborot = p-b1-oborot + v-oborot
     5288     p-b2-oborot = p-b2-oborot + v-oborot
     5289   .
     5290   end.
     5291   end procedure.
     5292   procedure calc-density :
     5293   define input        parameter p-ext-doc-type  as character no-undo .
     5294   define input        parameter x-store-type    as character no-undo .
     5295   define input        parameter x-store-code    as integer   no-undo .
     5296   define input        parameter p-artic         as character no-undo .
     5297   define input        parameter p-prod-type     as character no-undo .
     5298   define input        parameter p-prod-code     as integer   no-undo .
     5299   define input-output parameter p-density       as decimal   no-undo .
     5300   define input-output parameter p-bi-density    as decimal   no-undo .
     5301   define input-output parameter p-bo-density    as decimal   no-undo .
     5302   define input-output parameter p-b1-density    as decimal   no-undo .
     5303   define input-output parameter p-b2-density    as decimal   no-undo .
     5304     do
     5305     on error undo, return error return-value
     5306     :
     5307   define variable v-oborot    as decimal   no-undo .
     5308   define variable v-fact-qnty as decimal   no-undo .
     5309   define buffer buf_doc-line  for ub.doc-line  .
     5310   define buffer buf_inv-line  for ub.inv-line  .
     5311   define buffer buf1_obj-list for obj-list .
     5312   assign
     5313     v-oborot     = 0
     5314     v-fact-qnty  = 0
     5315   .
     5316   if p-is-petrol = false   then return .
     5317     for each buf1_obj-list no-lock :
     5318      if  xtog-obj then
     5319          if   not(x-store-type     = buf1_obj-list.obj-type
     5320               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5321       for each buf_doc-line  no-lock where
     5322             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5323             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5324             buf_doc-line.artic        = p-artic and
     5325             buf_doc-line.prod-type    = p-prod-type and
     5326             buf_doc-line.prod-code    = p-prod-code and
     5327             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5328             buf_doc-line.status_      = 'факт':U        and
     5329             buf_doc-line.fact-order   <= fact-order-2  and
     5330             buf_doc-line.fact-order   >= fact-order-1
     5331             :
     5332             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5333             for each buf_inv-line  no-lock where
     5334                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5335                 buf_inv-line.artic        = buf_doc-line.artic and
     5336                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5337                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5338                 :
     5339                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5340                     else do:
     5341                     if p-ext-doc-type = 'we':U    or
     5342                        p-ext-doc-type = 'ee':U    or
     5343                        p-ext-doc-type = 'ev':U    or
     5344                        p-ext-doc-type = 'ep':U or
     5345                        p-ext-doc-type = 'em':U     or
     5346                        p-ext-doc-type = 'wm':U     or
     5347                        p-ext-doc-type = 'es':U   then
     5348                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5349                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5350                     end.
     5351             end.
     5352       end.
     5353       assign
     5354         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5355       .
     5356       assign
     5357         p-bi-density = p-density
     5358         p-bo-density = 0
     5359         p-b1-density = 0
     5360         p-b2-density = 0
     5361       .
     5362   end.
     5363   end.
     5364   end procedure.
