     3760             End.
     3761     WHEN 'im':U THEN DO:
     3762       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     3763             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3764             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3765         if tt# = 6 Then   assign
     3766             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3767             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3768             End.
     3769     WHEN 'ot':U THEN DO:
     3770       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     3771             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3772             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3773         if tt# = 6 Then   assign
     3774             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3775             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3776             End.
     3777     WHEN 'ap':U THEN DO:
     3778       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     3779             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3780             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3781         if tt# = 6 Then   assign
     3782             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3783             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3784             End.
     3785     WHEN 'pc':U THEN DO:
     3786       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     3787             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3788             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3789         if tt# = 6 Then   assign
     3790             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3791             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3792             End.
     3793               end case.
     3794           end.
     3795      end.
     3796   end.
     3797   else do:
     3798   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     3799   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     3800   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     3801   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     3802   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     3803   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     3804   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     3805   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     3806   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     3807   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     3808   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     3809   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     3810   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     3811   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     3812   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     3813   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3814   end.
     3815     if tt# = 6 then do:
     3816     if  xshowmediator = false then
     3817         oborot-sum-cost[1] =
     3818         oborot-ee[2]      +
     3819         oborot-es[2] +
     3820         oborot-re[2]  +
     3821         oborot-rs[2]
     3822         .
     3823         else
     3824         oborot-sum-cost[1] =
     3825         oborot-ee[4]      +
     3826         oborot-es[4] +
     3827         oborot-re[4]  +
     3828         oborot-rs[4]
     3829         .
     3830        repeat v-ii = 1 to 1 :
     3831        v-summa[v-ii ]  =
     3832           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     3833           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     3834           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     3835           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     3836           oborot-im[v-ii ] .
     3837        end.
     3838        repeat v-ii = 2 to 4 :
     3839        v-summa[v-ii ]  =
     3840           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     3841           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     3842           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     3843           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     3844           oborot-im[v-ii + tt#] .
     3845        end.
     3846         oborot-sum-sale[1] =
     3847         oborot-ee[2 + tt#] +
     3848         oborot-es[2 + tt#] +
     3849         oborot-re[2 + tt#] +
     3850         oborot-rs[2 + tt#]
     3851         .
     3852          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     3853           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     3854                                                                                                     -  oborot-disc[1]
     3855           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     3856           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     3857           .
     3858           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     3859           if oborot-sum-cost[1] <>  0 then
     3860             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     3861             else oborot-prc[1] = 0.
     3862     end.
     3863   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     3864   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     3865   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     3866   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     3867   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     3868   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     3869   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     3870   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     3871   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     3872   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     3873   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     3874   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     3875   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     3876   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     3877   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     3878   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     3879   end procedure.
     3880   procedure ost-line :
     3881     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     3882     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     3883     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     3884     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     3885     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     3886     define input  parameter x-tog-shift  as logical no-undo .
     3887     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     3888     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     3889     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     3890     define input  parameter xtog-obj     as logical no-undo .
     3891     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     3892     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     3893     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     3894     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     3895     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     3896     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     3897     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     3898     define buffer buff-obj-list  for obj-list .
     3899     define buffer buff-stk-line  for ub.stk-line .
     3900     assign
     3901       Quantity = 0
     3902       Coast_R  = 0
     3903       Coast_V  = 0
     3904       VAT_R    = 0
     3905       VAT_V    = 0
     3906       SLT_R    = 0
     3907       SLT_V    = 0
     3908     .
     3909     if  x-tog-shift = false then do:
     3910       for each buff-obj-list no-lock
     3911       on error undo, return error
     3912       :
     3913         find last buff-stk-line no-lock
     3914           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3915             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3916             and buff-stk-line.artic      = x-artic
     3917             and buff-stk-line.prod-type  = x-prod-type
     3918             and buff-stk-line.prod-code  = x-prod-code
     3919             and buff-stk-line.sum-type   = x-sum-type
     3920             and buff-stk-line.cat-id     = '##,##':U
     3921             and buff-stk-line.fact-order <= x-fact-order
     3922             and buff-stk-line.shift-num  = 0
     3923           use-index category
     3924           no-error .
     3925         if available buff-stk-line then do:
     3926           assign
     3927             Quantity = Quantity +  buff-stk-line.fact-qnty
     3928             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3929             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3930             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3931             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3932             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3933             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3934           .
     3935         end.
     3936       end.
     3937     end.
     3938     else do:
     3939       for each buff-obj-list no-lock
     3940         where xtog-obj = false
     3941            or (buff-obj-list.obj-type = x-store-type
     3942               and buff-obj-list.obj-code = x-store-code
     3943               )
     3944       on error undo, return error
     3945       :
     3946         find last buff-stk-line no-lock
     3947           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3948             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3949             and buff-stk-line.artic      = x-artic
     3950             and buff-stk-line.prod-type  = x-prod-type
     3951             and buff-stk-line.prod-code  = x-prod-code
     3952             and buff-stk-line.sum-type   = x-sum-type
     3953             and buff-stk-line.cat-id     = '##,##':U
     3954             and buff-stk-line.fact-order <= x-fact-order
     3955             and buff-stk-line.shift-num  > 0
     3956           use-index category
     3957           no-error .
     3958         if available buff-stk-line then do:
     3959           assign
     3960             Quantity = Quantity +  buff-stk-line.fact-qnty
     3961             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3962             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3963             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3964             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3965             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3966             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3967           .
     3968         end.
     3969       end.
     3970     end.
     3971   end procedure.
     3972   procedure ost-lineother-tax :
     3973     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     3974     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     3975     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     3976     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     3977     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     3978     define input  parameter x-tog-shift  as logical no-undo .
     3979     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     3980     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     3981     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     3982     define input  parameter xTog-obj     as logical no-undo .
     3983     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     3984     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     3985     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     3986     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     3987     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     3988     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     3989     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     3990     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     3991     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     3992     define buffer buff-obj-list  for obj-list .
     3993     define buffer buff-stk-line  for ub.stk-line .
     3994     assign
     3995       Quantity = 0
     3996       Coast_R  = 0
     3997       Coast_V  = 0
     3998       VAT_R    = 0
     3999       VAT_V    = 0
     4000       SLT_R    = 0
     4001       SLT_V    = 0
     4002       other_R  = 0
     4003       other_V  = 0
     4004     .
     4005     if  x-tog-shift = false then do:
     4006       for each buff-obj-list no-lock
     4007       on error undo, return error
     4008       :
     4009         find last buff-stk-line no-lock
     4010           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4011             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4012             and buff-stk-line.artic      = x-artic
     4013             and buff-stk-line.prod-type  = x-prod-type
     4014             and buff-stk-line.prod-code  = x-prod-code
     4015             and buff-stk-line.sum-type   = x-sum-type
     4016             and buff-stk-line.cat-id     = '##,##':U
     4017             and buff-stk-line.fact-order <= x-fact-order
     4018             and buff-stk-line.shift-num  = 0
     4019           use-index category
     4020           no-error .
     4021         if available buff-stk-line then do:
     4022           assign
     4023             Quantity = Quantity +  buff-stk-line.fact-qnty
     4024             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4025             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4026             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4027             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4028             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4029             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4030             other_R  = other_R  +  buff-stk-line.other-rubl
     4031             other_V  = other_V  +  buff-stk-line.other-base
     4032           .
     4033         end.
     4034       end.
     4035     end.
     4036     else do:
     4037       for each buff-obj-list no-lock
     4038         where xtog-obj = false
     4039            or (buff-obj-list.obj-type = x-store-type
     4040               and buff-obj-list.obj-code = x-store-code
     4041               )
     4042       on error undo, return error
     4043       :
     4044         find last buff-stk-line no-lock
     4045           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4046             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4047             and buff-stk-line.artic      = x-artic
     4048             and buff-stk-line.prod-type  = x-prod-type
     4049             and buff-stk-line.prod-code  = x-prod-code
     4050             and buff-stk-line.sum-type   = x-sum-type
     4051             and buff-stk-line.cat-id     = '##,##':U
     4052             and buff-stk-line.fact-order <= x-fact-order
     4053             and buff-stk-line.shift-num  > 0
     4054           use-index category
     4055           no-error .
     4056         if available buff-stk-line then do:
     4057           assign
     4058             Quantity = Quantity +  buff-stk-line.fact-qnty
     4059             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4060             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4061             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4062             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4063             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4064             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4065             other_R = other_R   +  buff-stk-line.other-rubl
     4066             other_V = other_V   +  buff-stk-line.other-base
     4067           .
     4068         end.
     4069       end.
     4070     end.
     4071   end procedure.
     4072   procedure ost-line-kg :
     4073     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4074     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4075     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4076     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4077     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4078     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4079     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4080     define buffer buff-obj-list  for obj-list .
     4081     define buffer buf_doc-line for ub.doc-line .
     4082     define buffer buf_inv-line for ub.inv-line .
     4083     do
     4084     on error undo, return error
     4085     :
     4086       for each buf_doc-line no-lock where
     4087                buf_doc-line.obj-type    = p-obj-type   and
     4088                buf_doc-line.obj-code    = p-obj-code   and
     4089                buf_doc-line.prod-type   = p-prod-type  and
     4090                buf_doc-line.prod-code   = p-prod-code  and
     4091                buf_doc-line.artic       = p-artic      and
     4092                buf_doc-line.status_     = 'факт':U      and
     4093                buf_doc-line.fact-order <= p-fact-order
     4094             by buf_doc-line.fact-order    descending
     4095       :
     4096         find first buf_inv-line no-lock where
     4097                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4098                    buf_inv-line.artic     = buf_doc-line.artic     and
     4099                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4100                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4101         if available buf_inv-line
     4102         then do:
     4103           if buf_inv-line.after-cli-qnty <> ?
     4104           then do:
     4105             assign
     4106               p-quantity-kg = buf_inv-line.after-cli-qnty
     4107             .
     4108             leave .
     4109           end.
     4110         end.
     4111       end.
     4112       if p-quantity-kg = ?
     4113       then do:
     4114         assign
     4115           p-quantity-kg = 0
     4116         .
     4117       end.
     4118     end.
     4119   end procedure.
     4120   PROCEDURE ostatok :
     4121   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4122   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4123   def input parameter x-tog-shift   as   logical             no-undo.
     4124   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4125   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4126   def input parameter x-shift-start as integer               no-undo.
     4127   def input parameter x-shift-end   as integer               no-undo.
     4128   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4129   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4130   def input parameter xTog-obj   as log no-undo.
     4131   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4132   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4133   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4134   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4135   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4136   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4137   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4138   def var              Fact-orderS   as char  no-undo.
     4139   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4140      Assign
     4141         Fact-order   = 0
     4142         Quantity     = 0
     4143         Coast_R      = 0
     4144         Coast_V      = 0
     4145         VAT_R        = 0
     4146         VAT_V        = 0 .
     4147    x-date-start-t  = x-date-start + 1 .
     4148   IF x-date-end = date('') then DO:
     4149      Fact-order = 0 .
     4150      for each obj-list
     4151          where  ( not xtog-obj or
     4152                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4153                 no-lock :
     4154         if  x-tog-shift = false then do:
     4155                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4156                               ub.stk-tot.Fact-date <=  x-date-start
     4157                               and ub.stk-tot.shift-num = 0
     4158                               USE-INDEX fact-date no-lock no-error .
     4159              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4160         End.
     4161         Else  DO :
     4162             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4163              (ub.stk-tot.shift-date  = x-date-start-t and
     4164               ub.stk-tot.shift-num  < x-shift-start or
     4165               ub.stk-tot.shift-date  < x-date-start-t  )
     4166               and ub.stk-tot.shift-num  > 0
     4167               USE-INDEX Shift-num no-lock no-error .
     4168            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4169           END.
     4170       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4171     End.
     4172   End.
     4173   Else DO:
     4174     For each obj-list  WHERE
     4175        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4176         no-lock :
     4177      IF  x-TOG-Shift = False Then DO:
     4178          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4179               ub.stk-tot.Fact-date <= x-date-end
     4180               and ub.stk-tot.shift-num = 0
     4181               USE-INDEX fact-date no-lock no-error.
     4182          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4183      END.
     4184      Else DO:
     4185           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4186               (ub.stk-tot.shift-date  = x-date-end and
     4187               ub.stk-tot.shift-num  <= x-shift-end or
     4188               ub.stk-tot.shift-date  < x-date-end       ) and
     4189               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4190               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4191       End.
     4192       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4193     End.
     4194   End.
     4195   END PROCEDURE.
     4196   procedure report-exec1  :
     4197      find first clients where x-store-type = clients.obj-type and
     4198                               x-store-code = clients.obj-code
     4199                               no-lock no-error.
     4200              if available clients then assign  objname = clients.obj-name
     4201                                                x-db-num     = clients.db-num.
     4202                                            else  objname="объект не определен".
     4203     run calcitog in this-procedure .
     4204     run print-header in this-procedure .      case retclassify :
     4205      when "no-classify":u    then  run run1 in this-procedure .
     4206      otherwise do:
     4207        message "Ошибка вызова" view-as alert-box error .
     4208      end.
     4209      end case.
     4210     run print-footer in this-procedure .
     4211     end procedure.
     4212   procedure calc-sub-itog :
     4213   define input parameter tt as int no-undo.
     4214   define variable tt2 as integer no-undo .
     4215     if tt = 6 then tt2 = 7 .
     4216               else tt2 = tt.
     4217   repeat i# = 1 + tt to 3 + tt2 :
     4218   run sum-i (
     4219    input oborot-vt[i#]
     4220   ,input tt
     4221   ,input-output b1-oborot-vt[i#]
     4222   ,input-output b2-oborot-vt[i#]
     4223   ,input-output bi-oborot-vt[i#]
     4224   ,input-output bo-oborot-vt[i#]
     4225   ,input oborot-ie[i#]
     4226   ,input-output b1-oborot-ie[i#]
     4227   ,input-output b2-oborot-ie[i#]
     4228   ,input-output bi-oborot-ie[i#]
     4229   ,input-output bo-oborot-ie[i#]
     4230   ) .
     4231   run sum-i (
     4232    input oborot-iv[i#]
     4233   ,input tt
     4234   ,input-output b1-oborot-iv[i#]
     4235   ,input-output b2-oborot-iv[i#]
     4236   ,input-output bi-oborot-iv[i#]
     4237   ,input-output bo-oborot-iv[i#]
     4238   ,input oborot-ee[i#]
     4239   ,input-output b1-oborot-ee[i#]
     4240   ,input-output b2-oborot-ee[i#]
     4241   ,input-output bi-oborot-ee[i#]
     4242   ,input-output bo-oborot-ee[i#]
     4243   ) .
     4244   run sum-i (
     4245    input oborot-ev[i#]
     4246   ,input tt
     4247   ,input-output b1-oborot-ev[i#]
     4248   ,input-output b2-oborot-ev[i#]
     4249   ,input-output bi-oborot-ev[i#]
     4250   ,input-output bo-oborot-ev[i#]
     4251   ,input oborot-ep[i#]
     4252   ,input-output b1-oborot-ep[i#]
     4253   ,input-output b2-oborot-ep[i#]
     4254   ,input-output bi-oborot-ep[i#]
     4255   ,input-output bo-oborot-ep[i#]
     4256   ) .
     4257   run sum-i (
     4258    input oborot-rv[i#]
     4259   ,input tt
     4260   ,input-output b1-oborot-rv[i#]
     4261   ,input-output b2-oborot-rv[i#]
     4262   ,input-output bi-oborot-rv[i#]
     4263   ,input-output bo-oborot-rv[i#]
     4264   ,input oborot-es[i#]
     4265   ,input-output b1-oborot-es[i#]
     4266   ,input-output b2-oborot-es[i#]
     4267   ,input-output bi-oborot-es[i#]
     4268   ,input-output bo-oborot-es[i#]
     4269   ) .
     4270   run sum-i (
     4271    input oborot-em[i#]
     4272   ,input tt
     4273   ,input-output b1-oborot-em[i#]
     4274   ,input-output b2-oborot-em[i#]
     4275   ,input-output bi-oborot-em[i#]
     4276   ,input-output bo-oborot-em[i#]
     4277   ,input oborot-re[i#]
     4278   ,input-output b1-oborot-re[i#]
     4279   ,input-output b2-oborot-re[i#]
     4280   ,input-output bi-oborot-re[i#]
     4281   ,input-output bo-oborot-re[i#]
     4282   ) .
     4283   run sum-i (
     4284    input oborot-im[i#]
     4285   ,input tt
     4286   ,input-output b1-oborot-im[i#]
     4287   ,input-output b2-oborot-im[i#]
     4288   ,input-output bi-oborot-im[i#]
     4289   ,input-output bo-oborot-im[i#]
     4290   ,input oborot-rs[i#]
     4291   ,input-output b1-oborot-rs[i#]
     4292   ,input-output b2-oborot-rs[i#]
     4293   ,input-output bi-oborot-rs[i#]
     4294   ,input-output bo-oborot-rs[i#]
     4295   ) .
     4296   run sum-i (
     4297    input oborot-ot[i#]
     4298   ,input tt
     4299   ,input-output b1-oborot-ot[i#]
     4300   ,input-output b2-oborot-ot[i#]
     4301   ,input-output bi-oborot-ot[i#]
     4302   ,input-output bo-oborot-ot[i#]
     4303   ,input oborot-we[i#]
     4304   ,input-output b1-oborot-we[i#]
     4305   ,input-output b2-oborot-we[i#]
     4306   ,input-output bi-oborot-we[i#]
     4307   ,input-output bo-oborot-we[i#]
     4308   ) .
     4309   run sum-i (
     4310    input oborot-ap[i#]
     4311   ,input tt
     4312   ,input-output b1-oborot-ap[i#]
     4313   ,input-output b2-oborot-ap[i#]
     4314   ,input-output bi-oborot-ap[i#]
     4315   ,input-output bo-oborot-ap[i#]
     4316   ,input oborot-pc[i#]
     4317   ,input-output b1-oborot-pc[i#]
     4318   ,input-output b2-oborot-pc[i#]
     4319   ,input-output bi-oborot-pc[i#]
     4320   ,input-output bo-oborot-pc[i#]
     4321   ) .
     4322     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4323     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4324     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4325     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4326     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4327     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4328     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4329     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4330     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4331     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4332     if i# = 8 then
     4333       assign
     4334         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4335                                 bi-oborot-re[ i#]         +
     4336                                 bi-oborot-rs[ i#]    +
     4337                                 bi-oborot-es[ i#]
     4338         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4339                                 b1-oborot-re[ i#]         +
     4340                                 b1-oborot-rs[ i#]    +
     4341                                 b1-oborot-es[ i#]
     4342         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4343                                 b2-oborot-re[ i#]         +
     4344                                 b2-oborot-rs[ i#]    +
     4345                                 b2-oborot-es[ i#]
     4346         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4347                                 bo-oborot-re[ i#]         +
     4348                                 bo-oborot-rs[ i#]    +
     4349                                 bo-oborot-es[ i#]
     4350         .
     4351     if  xshowmediator = true  then do:
     4352         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4353         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4354         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4355         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4356     end.
     4357     if i# = 2 and xshowmediator = false  then
     4358         assign
     4359           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4360                                   bi-oborot-re[ i#]         +
     4361                                   bi-oborot-rs[ i#]    +
     4362                                   bi-oborot-es[ i#]
     4363           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4364                                   b1-oborot-re[ i#]         +
     4365                                   b1-oborot-rs[ i#]    +
     4366                                   b1-oborot-es[ i#]
     4367           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4368                                   b2-oborot-re[ i#]         +
     4369                                   b2-oborot-rs[ i#]    +
     4370                                   b2-oborot-es[ i#]
     4371           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4372                                   bo-oborot-re[ i#]         +
     4373                                   bo-oborot-rs[ i#]    +
     4374                                   bo-oborot-es[ i#]
     4375           .
     4376     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4377     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4378     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4379     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4380     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4381                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4382                      else bi-oborot-prc[1] = 0.
     4383     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4384                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4385                      else bo-oborot-prc[1] = 0.
     4386     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4387                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4388                      else b1-oborot-prc[1] = 0.
     4389     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4390                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4391                      else b2-oborot-prc[1] = 0.
     4392    end.
     4393   end procedure.
     4394   procedure sum-i :
     4395   define input parameter ob like oborot-ot[1] no-undo.
     4396   define input parameter tt as int  no-undo.
     4397   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4398   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4399   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4400   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4401   define input parameter ob2 like oborot-ot[1] no-undo.
     4402   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4403   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4404   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4405   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4406   assign
     4407    b1  = b1 + ob
     4408    b2  = b2 + ob
     4409    b1- = b1- + ob2
     4410    b2- = b2- + ob2
     4411    .
     4412       assign
     4413       bi = bi + ob
     4414       bo = bo + ob
     4415       bi- = bi- + ob2
     4416       bo- = bo- + ob2
     4417       .
     4418   end procedure.
     4419   procedure clear-item :
     4420   define variable kk as int no-undo.
     4421    repeat kk = 1 to 13 :
     4422    assign
     4423       oborot-ie                 [kk]    = 0
     4424       oborot-ee                 [kk]    = 0
     4425       oborot-ep              [kk]    = 0
     4426       oborot-es            [kk]    = 0
     4427       oborot-re             [kk]    = 0
     4428       oborot-rs        [kk]    = 0
     4429       oborot-we                 [kk]    = 0
     4430       oborot-vt                       [kk]    = 0
     4431       oborot-iv                 [kk]    = 0
     4432       oborot-ev                 [kk]    = 0
     4433       oborot-rv             [kk]    = 0
     4434       oborot-em                  [kk]    = 0
