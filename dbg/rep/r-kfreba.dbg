     1688           and buf_chk-doc.shift-date <= buf_shift-obj_end.shift-date
     1689       :
     1690         if buf_chk-doc.shift-date = buf_shift-obj_begin.shift-date and
     1691            buf_chk-doc.shift-num < buf_shift-obj_begin.shift-num
     1692         then do:
     1693           next _chk-doc-cycle.
