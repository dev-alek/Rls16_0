     1161     id
     1162     gds-code
     1163   index gds
     1164     gds-code
     1165   index bcode
     1166     b-code
     1167   index art
     1168     artic
     1169     prod-type
     1170     prod-code
     1171   .
     1172   define temp-table tt-report no-undo
     1173     field obj-type                    like ub.rvs-line-pump.obj-type
     1174     field obj-code                    like ub.rvs-line-pump.obj-code
     1175     field pump-code                   like ub.rvs-line-pump.pump-code
     1176     field gds-code                    like ub.rvs-line-pump.gds-code
     1177     field pl-code                     like ub.rvs-line-pump.pl-code
     1178     field obj-name                    as character
     1179     field gds-name                    as character
     1180     field prev-state-measure-qnty     as decimal
     1181     field fact-qnty                   as decimal
     1182     field end-state-el-cnt            as decimal
     1183     field begin-state-el-cnt          as decimal
     1184     field sale-state-el-cnt           as decimal
     1185     field end-state-mh-cnt            as decimal
     1186     field begin-state-mh-cnt          as decimal
     1187     field sale-state-mh-cnt           as decimal
     1188     field state-divergence            as decimal
     1189     field sale-state                  as decimal
     1190     field sale-techfuel               as decimal
     1191     field sale-total                  as decimal
     1192     field place-loc1                  like ub.place.loc1
     1193     field fact-ost-measure-qnty       as decimal
     1194     field fact-ost-state-measure-qnty as decimal
     1195     field end-system-qnty             as decimal
     1196     field fact-divergence             as decimal
     1197   index pi is unique primary
     1198     obj-type
     1199     obj-code
     1200     gds-code descending
     1201     pl-code
     1202     pump-code
     1203   index rep
     1204     obj-type
     1205     obj-code
     1206     gds-code
     1207     place-loc1
     1208     pump-code
     1209   index place
     1210     place-loc1
     1211     pump-code
     1212   .
     1213   define temp-table tt-pump-pl no-undo
     1214     field obj-type                    like ub.rvs-line-pump.obj-type
     1215     field obj-code                    like ub.rvs-line-pump.obj-code
     1216     field gds-code                    like ub.goods.gds-code
     1217     field pump-code                   like ub.rvs-line-pump.pump-code
     1218     field pl-code                     like ub.rvs-line-pump.pl-code
     1219   index pi is unique primary
     1220     obj-type
     1221     obj-code
     1222     gds-code
     1223     pl-code
     1224     pump-code
     1225   index pump
     1226     obj-type
     1227     obj-code
     1228     gds-code
     1229     pump-code
     1230   .
     1231   define variable v-err-message as character no-undo .
     1232   do
     1233   on error undo, return error return-value
     1234   :
     1235     run write-log in this-procedure ( input substitute("Запуск отчета 'Реализация и остатки' для БД &1 " , p-db-num ) ) .
     1236     run clear-tt in this-procedure .
     1237     run write-log in this-procedure ( input "Расчет данных для отчета":U  ) .
     1238     run fill-tt in this-procedure .
     1239     run write-log in this-procedure ( input "Вывод отчета в Excel":U  ) .
     1240     run print-report in this-procedure ( output v-err-message ).
     1241     run clear-tt in this-procedure .
     1242     run write-log in this-procedure ( input "Формирование отчета завершено":U ) .
     1243     if v-err-message <> ''
     1244     then do:
     1245       return error v-err-message.
     1246     end.
     1247   end.
     1248   procedure clear-tt :
     1249   do
     1250   on error undo, return error return-value
     1251   :
     1252     empty temp-table tt-report.
     1253     empty temp-table tt-obj-list.
     1254     empty temp-table tt-gds.
     1255     empty temp-table tt-pump-pl.
     1256   end.
     1257   end procedure.
     1258   procedure fill-tt :
     1259   do
     1260   on error undo, return error return-value
     1261   :
     1262     run fill-tt-obj-list in this-procedure .
     1263     run fill-tt-gds in this-procedure .
     1264     run fill-tt-report in this-procedure .
     1265   end.
     1266   end procedure.
     1267   procedure fill-tt-obj-list :
     1268     define buffer buf_clients     for ub.clients.
     1269     define buffer buf_db          for ub.db.
     1270     define buffer buf_tt-obj-list for tt-obj-list.
     1271     define variable v-cur-db-num  as integer   no-undo .
     1272   do for buf_clients
     1273        , buf_tt-obj-list
     1274   on error undo, return error return-value
     1275   :
     1276     if p-is-schedule = no
     1277     then do:
     1278   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1279     run mainmenu_getcntxt in parparentproc
     1280       (output v-cntxt-db-num
     1281       ,output v-cntxt-userid
     1282       ,output v-cntxt-level
     1283       ,output v-cntxt-host-code-obj
     1284       ,output v-cntxt-obj-type
     1285       ,output v-cntxt-obj-code
     1286       ,output v-cntxt-db-num-obj
     1287       ,output v-cntxt-is-admin
     1288       ) .
     1289       find first buf_clients no-lock
     1290         where buf_clients.obj-type = v-cntxt-obj-type
     1291           and buf_clients.obj-code = v-cntxt-obj-code
     1292       no-error .
     1293       if not available buf_clients
     1294       then do:
     1295         message
     1296           "Не найден текущий объект" skip
     1297         view-as alert-box information.
     1298         undo, return error.
     1299       end.
     1300       create buf_tt-obj-list .
     1301       assign
     1302         buf_tt-obj-list.obj-type = buf_clients.obj-type
     1303         buf_tt-obj-list.obj-code = buf_clients.obj-code
     1304         buf_tt-obj-list.obj-name = buf_clients.obj-name
     1305       .
     1306     end.
     1307     else do:
     1308       assign
     1309         v-cur-db-num = p-db-num
     1310       .
     1311       _cli-cycle:
     1312       for each buf_clients no-lock
     1313         where buf_clients.obj-type = 'маг':U
     1314           and buf_clients.stts = 0
     1315       :
     1316         if v-cur-db-num <> 0 and buf_clients.db-num <> v-cur-db-num
     1317         then do:
     1318           run write-log in this-procedure ( input substitute( 'Объект &1 &2 - "&3" УБД &4 текущая БД &5.':u
     1319                                                             , buf_clients.obj-type
     1320                                                             , buf_clients.obj-code
     1321                                                             , buf_clients.obj-name
     1322                                                             , buf_clients.db-num
     1323                                                             , v-cur-db-num
     1324                                                             )
     1325                                           ) .
     1326           next _cli-cycle.
     1327         end.
     1328         find first buf_db no-lock
     1329           where buf_db.db-num = buf_clients.db-num
     1330         no-error .
     1331         if buf_db.send-check = no
     1332         then do:
     1333           run write-log in this-procedure ( input substitute( 'Чеки с объекта &1 &2 - "&3" БД &4 не отсылаются. Объект исключен из списка.':u
     1334                                                             , buf_clients.obj-type
     1335                                                             , buf_clients.obj-code
     1336                                                             , buf_clients.obj-name
     1337                                                             , buf_clients.db-num
     1338                                                             )
     1339                                           ) .
     1340           next _cli-cycle.
     1341         end.
     1342         find first buf_tt-obj-list
     1343           where buf_tt-obj-list.obj-type = buf_clients.obj-type
     1344             and buf_tt-obj-list.obj-code = buf_clients.obj-code
     1345         no-error.
     1346         if not available buf_tt-obj-list
     1347         then do:
     1348           create buf_tt-obj-list .
     1349           assign
     1350             buf_tt-obj-list.obj-type = buf_clients.obj-type
     1351             buf_tt-obj-list.obj-code = buf_clients.obj-code
     1352             buf_tt-obj-list.obj-name = buf_clients.obj-name
     1353           .
     1354         end.
     1355       end.
     1356     end.
     1357   end.
     1358   end procedure.
     1359   procedure fill-tt-gds :
     1360     define buffer buf_prod-bc   for ub.prod-bc.
     1361     define buffer buf_bar-code  for ub.bar-code.
     1362     define buffer buf_goods     for ub.goods.
     1363     define buffer buf_tt-gds    for tt-gds.
     1364     define variable v-sort-list as character no-undo .
     1365     define variable v-sort-type as character no-undo .
     1366     define variable v-i         as integer   no-undo .
     1367     define variable v-str       as character no-undo .
     1368     define variable v-is-petrol as logical   no-undo .
     1369     define variable v-is-pieces as logical   no-undo .
     1370   do for buf_prod-bc
     1371        , buf_bar-code
     1372        , buf_goods
     1373        , buf_tt-gds
     1374   on error undo, return error return-value
     1375   :
     1376   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1377   empty temp-table thbjattr_thbj-attr.
     1378   run adm/shattri.p (
     1379      input "get":U
     1380     ,input ''
     1381     ,input 0
     1382     ,input 'report-glob':U
     1383     ,input  ""
     1384     ,output v-value-character
     1385     ,output v-value-date
     1386     ,output v-value-decimal
     1387     ,output v-value-integer
     1388     ,output v-value-logical
     1389     ,output par-type
     1390     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1391     ) no-error .
     1392     _thbjattr_thbj-attr:
     1393     for each thbjattr_thbj-attr :
     1394         if thbjattr_thbj-attr.prop-code = 'rep-sort'
     1395         then do:
     1396           assign
     1397             v-sort-list  = thbjattr_thbj-attr.property-value-character
     1398           .
     1399           leave _thbjattr_thbj-attr.
     1400         end.
     1401     end.
     1402     if v-sort-list = ? or v-sort-list = "":U
     1403     then do:
     1404       if p-is-schedule = no
     1405       then do:
     1406         message
     1407           "Параметр rep-sort не найден, либо не заполнен.":U
     1408         view-as alert-box error.
     1409       end.
     1410       undo , return error "Параметр rep-sort не найден, либо в нем отсутствуют бар-коды.":U .
     1411     end.
     1412     _rep-sort-cycle:
     1413     do v-i = 1 to num-entries(v-sort-list)
     1414     :
     1415       assign
     1416         v-str = entry( v-i , v-sort-list)
     1417       .
     1418       _gds-cycle:
     1419       for each buf_goods no-lock
     1420         where buf_goods.artic = v-str
     1421       :
     1422   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1423     (
     1424        input buf_goods.artic
     1425     ,  input buf_goods.prod-type
     1426     ,  input buf_goods.prod-code
     1427     , output v-is-petrol
     1428     , output v-is-pieces
     1429     ) .
     1430         if v-is-petrol  = yes
     1431         and v-is-pieces = no
     1432         then do:
     1433           find first buf_tt-gds
     1434             where buf_tt-gds.gds-code = buf_goods.gds-code
     1435           no-error .
     1436           if not available buf_tt-gds
     1437           then do:
     1438             find first buf_bar-code no-lock where buf_bar-code.gds-code = buf_goods.gds-code no-error .
     1439             create buf_tt-gds.
     1440             buffer-copy buf_goods to buf_tt-gds
     1441             assign
     1442               buf_tt-gds.id     = v-i
     1443               buf_tt-gds.b-code = buf_bar-code.b-code
     1444             .
     1445             next _rep-sort-cycle.
     1446           end.
     1447         end.
     1448       end.
     1449     end.
     1450   end.
     1451   end procedure.
     1452   procedure fill-tt-report :
     1453     define buffer buf_tt-obj-list             for tt-obj-list.
     1454     define buffer buf_tt-gds                  for tt-gds.
     1455     define buffer buf_tt-report               for tt-report.
     1456     define buffer buf_tt-pump-pl              for tt-pump-pl.
     1457     define buffer buf_shift-obj_previous      for ub.shift-obj.
     1458     define buffer buf_shift-obj_begin         for ub.shift-obj.
     1459     define buffer buf_shift-obj_end           for ub.shift-obj.
     1460     define buffer buf_rvs-doc_previous        for ub.rvs-doc.
     1461     define buffer buf_rvs-line_previous       for ub.rvs-line.
     1462     define buffer buf_rvs-line_end            for ub.rvs-line.
     1463     define buffer buf_place                   for ub.place.
     1464     define buffer buf_rvs-doc_begin           for ub.rvs-doc.
     1465     define buffer buf_rvs-doc_end             for ub.rvs-doc.
     1466     define buffer buf_rvs-doc                 for ub.rvs-doc.
     1467     define buffer buf_rvs-line-pump_previous  for ub.rvs-line-pump.
     1468     define buffer buf_rvs-line-pump_begin     for ub.rvs-line-pump.
     1469     define buffer buf_rvs-line-pump_end       for ub.rvs-line-pump.
     1470     define buffer buf_rvs-line-pump           for ub.rvs-line-pump.
     1471     define buffer buf_chk-doc                 for ub.chk-doc.
     1472     define buffer buf_chk-gds                 for ub.chk-gds.
     1473     define buffer buf_trn-doc                 for ub.trn-doc.
     1474     define buffer buf_doc-line                for ub.doc-line.
     1475     define buffer buf_doc-pl                  for ub.doc-pl.
     1476     define buffer buf_pl-pump                 for ub.pl-pump.
     1477     define variable v-date                    as date      no-undo .
     1478     define variable v-time                    as integer   no-undo .
     1479     define variable v-begin-date              as date      no-undo .
     1480     define variable v-end-date                as date      no-undo .
     1481     define variable v-prev-state-measure-qnty as decimal   no-undo .
     1482     define variable v-prev-shift-exist        as logical   no-undo .
     1483     define variable v-varshift-name-begin     as character no-undo .
     1484     define variable v-varshift-name-end       as character no-undo .
     1485     define variable v-varshift-name-num-begin as character no-undo .
     1486     define variable v-varshift-name-num-end   as character no-undo .
     1487     define variable v-rcpt-tech-refuell       as integer   no-undo .
     1488     define variable v-pump                    as integer   no-undo .
     1489     define variable v-qnty                    as decimal   no-undo .
     1490     define variable v-valid-pl                as logical   no-undo .
     1491     define variable v-message                 as character no-undo .
     1492     define variable v-prev-fo                 as decimal   no-undo .
     1493     define variable v-fo                      as decimal   no-undo .
     1494     define variable v-month-list as character no-undo extent 12 initial
     1495       ["января"
     1496       ,"февраля"
     1497       ,"марта"
     1498       ,"апреля"
     1499       ,"мая"
     1500       ,"июня"
     1501       ,"июля"
     1502       ,"августа"
     1503       ,"сентября"
     1504       ,"октября"
     1505       ,"ноября"
     1506       ,"декабря"
     1507       ] .
     1508   do for buf_tt-obj-list
     1509        , buf_tt-gds
     1510        , buf_tt-report
     1511        , buf_tt-pump-pl
     1512        , buf_shift-obj_begin
     1513        , buf_shift-obj_end
     1514        , buf_rvs-doc_begin
     1515        , buf_rvs-doc_end
     1516        , buf_rvs-doc
     1517        , buf_rvs-line-pump_previous
     1518        , buf_rvs-line-pump_begin
     1519        , buf_rvs-line-pump_end
     1520        , buf_rvs-line-pump
     1521        , buf_rvs-doc_previous
     1522        , buf_rvs-line_previous
     1523        , buf_rvs-line_end
     1524        , buf_chk-doc
     1525        , buf_chk-gds
     1526        , buf_place
     1527        , buf_trn-doc
     1528        , buf_doc-line
     1529        , buf_doc-pl
     1530        , buf_pl-pump
     1531   on error undo, return error return-value
     1532   :
     1533     run cur-time in this-procedure ( output v-date
     1534                                    , output v-time
     1535                                    ) .
     1536     assign
     1537       v-begin-date        = date ( month(v-date) , 1 , year(v-date) )
     1538       v-end-date          = v-date
     1539       v-rcpt-tech-refuell = integer('17':U)
     1540     .
     1541     _obj-list:
     1542     for each buf_tt-obj-list
     1543     :
     1544       assign
     1545         v-message = "Расчет для " + buf_tt-obj-list.obj-name
     1546       .
     1547       run waitfram-show in this-procedure ( input v-message ) .
     1548       find first buf_shift-obj_begin no-lock
     1549         where buf_shift-obj_begin.obj-type    = buf_tt-obj-list.obj-type
     1550           and buf_shift-obj_begin.obj-code    = buf_tt-obj-list.obj-code
     1551           and buf_shift-obj_begin.shift-date >= v-begin-date
     1552           and buf_shift-obj_begin.status_     = 'зкр':U
     1553       use-index pi
     1554       no-error .
     1555       if not available buf_shift-obj_begin then do:
     1556         run proc-message in this-procedure ( input substitute( "По объекту &1 &2 не найдена первая закрытая смена на &3"
     1557                                                               , buf_tt-obj-list.obj-type
     1558                                                               , buf_tt-obj-list.obj-code
     1559                                                               , string(v-begin-date,"99/99/9999")
     1560                                                               )
     1561                                             ) .
     1562         next _obj-list.
     1563       end.
     1564       find last buf_shift-obj_end no-lock
     1565         where buf_shift-obj_end.obj-type    = buf_tt-obj-list.obj-type
     1566           and buf_shift-obj_end.obj-code    = buf_tt-obj-list.obj-code
     1567           and buf_shift-obj_end.shift-date <= v-end-date
     1568           and buf_shift-obj_end.status_     = 'зкр':U
     1569       use-index pi
     1570       no-error .
     1571       if not available buf_shift-obj_end then do:
     1572         run proc-message in this-procedure ( input substitute( "По объекту &1 &2 не найдена последняя закрытая смена на &3"
     1573                                                               , buf_tt-obj-list.obj-type
     1574                                                               , buf_tt-obj-list.obj-code
     1575                                                               , string(v-end-date,"99/99/9999")
     1576                                                               )
     1577                                             ) .
     1578         next _obj-list.
     1579       end.
     1580       find last buf_shift-obj_previous no-lock
     1581         where buf_shift-obj_previous.obj-type = buf_tt-obj-list.obj-type
     1582           and buf_shift-obj_previous.obj-code = buf_tt-obj-list.obj-code
     1583           and ((    buf_shift-obj_previous.shift-date = buf_shift-obj_begin.shift-date
     1584                 and buf_shift-obj_previous.shift-num  < buf_shift-obj_begin.shift-num
     1585                )
     1586                or buf_shift-obj_previous.shift-date < buf_shift-obj_begin.shift-date
     1587               )
     1588       use-index pi no-error.
     1589       if available buf_shift-obj_previous
     1590       then do:
     1591         find first buf_rvs-doc_previous no-lock
     1592           where buf_rvs-doc_previous.obj-type   = buf_tt-obj-list.obj-type
     1593             and buf_rvs-doc_previous.obj-code   = buf_tt-obj-list.obj-code
     1594             and buf_rvs-doc_previous.shift-date = buf_shift-obj_previous.shift-date
     1595             and buf_rvs-doc_previous.shift-num  = buf_shift-obj_previous.shift-num
     1596             and buf_rvs-doc_previous.status_    = 'факт':U
     1597             and buf_rvs-doc_previous.rvs-type   = 'смена':U
     1598         no-error.
     1599         if not available buf_rvs-doc_previous
     1600         then do:
     1601           assign
     1602             v-prev-shift-exist = no
     1603           .
     1604         end.
     1605         else do:
     1606           assign
     1607             v-prev-shift-exist = yes
     1608           .
     1609         end.
     1610       end.
     1611       else do:
     1612         assign
     1613           v-prev-shift-exist = no
     1614         .
     1615       end.
     1616   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     1617     (
     1618        input buf_shift-obj_begin.obj-type
     1619     ,  input buf_shift-obj_begin.obj-code
     1620     ,  input buf_shift-obj_begin.shift-date
