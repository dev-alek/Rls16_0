     1952         .
     1953       end.
     1954       assign
     1955         buf_tt-obj-list.cre-report      = yes
     1956         buf_tt-obj-list.shift-date-str  = substitute( "с: &1 от &2 &3 по: &4 от &5 &6 закрыта &7 &8"
     1957                                                     , string( v-varshift-name-begin                         )
     1958                                                     , string( buf_shift-obj_begin.open-date , "99/99/9999"  )
     1959                                                     , string( buf_shift-obj_begin.open-time , "hh:mm"       )
     1960                                                     , string( v-varshift-name-end                           )
     1961                                                     , string( buf_shift-obj_end.open-date , "99/99/9999"    )
     1962                                                     , string( buf_shift-obj_end.open-time , "hh:mm"         )
     1963                                                     , string( buf_shift-obj_end.close-date,"99/99/9999"     )
     1964                                                     , string( buf_shift-obj_end.close-time,"hh:mm"          )
     1965                                                     )
     1966         buf_tt-obj-list.report-name     = substitute( "Реализация_и_остатки_с_начала_месяца_&1_по_&2_&3_&4-&5"
     1967                                                     , v-month-list[month(v-date)]
     1968                                                     , string(year(buf_shift-obj_end.shift-date)  , "9999")
     1969                                                     , string(month(buf_shift-obj_end.shift-date) , "99"  )
     1970                                                     , string(day(buf_shift-obj_end.shift-date)   , "99"  )
     1971                                                     , v-varshift-name-end
     1972                                                     )
     1973       .
     1974       empty temp-table buf_tt-pump-pl.
     1975     end.
     1976     run waitfram-show in this-procedure ( input "Расчет данных..." ) .
     1977     for each buf_tt-report
     1978     :
     1979       find first buf_place no-lock
     1980         where buf_place.obj-type = buf_tt-report.obj-type
     1981           and buf_place.obj-code = buf_tt-report.obj-code
     1982           and buf_place.pl-code  = buf_tt-report.pl-code
     1983       no-error .
     1984       assign
     1985         buf_tt-report.place-loc1        = if available buf_place then buf_place.loc1 else ''
     1986         buf_tt-report.sale-state-el-cnt = buf_tt-report.end-state-el-cnt  - buf_tt-report.begin-state-el-cnt
     1987         buf_tt-report.sale-state-mh-cnt = buf_tt-report.end-state-mh-cnt  - buf_tt-report.begin-state-mh-cnt
     1988         buf_tt-report.state-divergence  = buf_tt-report.sale-state-mh-cnt - buf_tt-report.sale-state-el-cnt
     1989         buf_tt-report.sale-state        = buf_tt-report.sale-state-mh-cnt
     1990         buf_tt-report.sale-total        = buf_tt-report.sale-state - buf_tt-report.sale-techfuel
     1991         buf_tt-report.fact-divergence   = buf_tt-report.fact-ost-state-measure-qnty - buf_tt-report.end-system-qnty
     1992       .
     1993     end.
     1994     run waitfram-hide in this-procedure .
     1995   end.
     1996   end procedure.
     1997   procedure print-report :
     1998     define output parameter p-error-message as character no-undo .
     1999   do
     2000   on error undo, return error return-value
     2001   :
     2002     if p-is-schedule = yes
     2003     then do:
     2004       run print-schedule in this-procedure ( output p-error-message).
     2005     end.
     2006     else do:
     2007       run print-no-schedule in this-procedure .
     2008     end.
     2009   end.
     2010   end procedure.
     2011   procedure print-schedule :
     2012     define output parameter p-error-message as character no-undo .
     2013     define buffer buf_temp-param for temp-param .
     2014     define variable v-report-dir            as character    no-undo .
     2015     define variable v-filename              as character    no-undo .
     2016     define variable v-obj-dir               as character    no-undo .
     2017     define variable v-report-filename       as character    no-undo .
     2018     define variable v-home-dir-filename     as character    no-undo .
     2019     define variable v-error-num             as integer      no-undo .
     2020     define variable v-template-file-name    as character    no-undo .
     2021     define variable v-vb-file-name          as character    no-undo .
     2022     define variable v-data-header-filename  as character    no-undo .
     2023     define variable v-data-filename         as character    no-undo .
     2024     define variable v-excel-file-name       as character    no-undo .
     2025     define variable v-err-message           as character    no-undo .
     2026     define variable v-obj-errors            as character    no-undo .
     2027     define variable v-os-err-str            as character    no-undo .
     2028     define variable v-message               as character    no-undo .
     2029   do for buf_temp-param
     2030   on error undo, return error return-value
     2031   :
     2032     assign
     2033       v-report-dir  = trim( replace( p-report-dir, '/' , '\' ) , '\' )
     2034     .
     2035     _obj-cycle:
     2036     for each tt-obj-list
     2037       where tt-obj-list.cre-report = yes
     2038     by tt-obj-list.obj-type
     2039     by tt-obj-list.obj-code
     2040     :
     2041       assign
     2042         v-message = "Выгрузка отчета для " + tt-obj-list.obj-name
     2043       .
     2044       run waitfram-show in this-procedure ( input v-message ) .
     2045       run write-log in this-procedure ( input v-message  ) .
     2046       run paramls-clear in this-procedure .
     2047       run kfrebaxl-init in this-procedure.
     2048       run kfrebaxl-write-cell-data in this-procedure ( input "h_date":U , input tt-obj-list.shift-date-str ).
     2049       run kfrebaxl-write-cell-data in this-procedure ( input "h_obj":U  , input tt-obj-list.obj-name       ).
     2050       for each tt-gds
     2051       , each tt-report
     2052         where tt-report.obj-type = tt-obj-list.obj-type
     2053           and tt-report.obj-code = tt-obj-list.obj-code
     2054           and tt-report.gds-code = tt-gds.gds-code
     2055       by tt-gds.id descending
     2056       by tt-report.place-loc1
     2057       by tt-report.pump-code
     2058       :
     2059         run kfrebaxl-sheet1-write-line-data in this-procedure
     2060               ( input tt-report.pump-code
     2061               , input tt-report.gds-name
     2062               , input tt-report.prev-state-measure-qnty
     2063               , input tt-report.fact-qnty
     2064               , input tt-report.end-state-el-cnt
     2065               , input tt-report.begin-state-el-cnt
     2066               , input tt-report.sale-state-el-cnt
     2067               , input tt-report.end-state-mh-cnt
     2068               , input tt-report.begin-state-mh-cnt
     2069               , input tt-report.sale-state-mh-cnt
     2070               , input tt-report.state-divergence
     2071               , input tt-report.sale-state
     2072               , input tt-report.sale-techfuel
     2073               , input tt-report.sale-total
     2074               , input tt-report.place-loc1
     2075               , input tt-report.fact-ost-measure-qnty
     2076               , input tt-report.fact-ost-state-measure-qnty
     2077               , input tt-report.end-system-qnty
     2078               , input tt-report.fact-divergence
     2079               ).
     2080       end .
     2081       run kfrebaxl-close in this-procedure.
     2082       assign
     2083         v-filename          = string( session:temp-directory ) + "rpt" + string( g#report-num )
     2084         v-obj-dir           = v-report-dir + '/' + tt-obj-list.obj-name
     2085         v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".xls"
     2086         v-home-dir-filename = v-obj-dir +  "/" + tt-obj-list.report-name + ".xls"
     2087       .
     2088       os-rename
     2089         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2090         value( v-filename + ".txl" )
     2091       .
     2092       assign
     2093         v-filename = search( v-filename + ".txl" )
     2094       .
     2095       if v-filename = "" or v-filename = ?
     2096       then do:
     2097         assign
     2098           v-obj-errors  = v-obj-errors + substitute( "Не найден файл &1 для формирования Excel-файла по объекту &2 &3&4&4"
     2099                                                    , string( session:temp-directory ) + "rpt" + string( g#report-num )
     2100                                                    , tt-obj-list.obj-type
     2101                                                    , tt-obj-list.obj-code
     2102                                                    , chr(10)
     2103                                                    )
     2104           v-err-message = v-err-message + v-obj-errors
     2105         .
     2106         next _obj-cycle.
     2107       end.
     2108       input stream in-stream from value( v-filename ).
     2109       import stream in-stream v-template-file-name   no-error .
     2110       import stream in-stream v-vb-file-name         no-error .
     2111       import stream in-stream v-data-header-filename no-error .
     2112       import stream in-stream v-data-filename        no-error .
     2113       input stream in-stream close.
     2114       if search( v-template-file-name ) = ?
     2115       then do:
     2116         assign
     2117           v-obj-errors  = v-obj-errors + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     2118                                                    , v-template-file-name
     2119                                                    , chr(10)
     2120                                                    )
     2121           v-err-message = v-err-message + v-obj-errors
     2122         .
     2123       end.
     2124       if search( v-vb-file-name ) = ?
     2125       then do:
     2126         assign
     2127           v-obj-errors  = v-obj-errors +  substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     2128                                                     , v-template-file-name
     2129                                                     , v-vb-file-name
     2130                                                     , chr(10)
     2131                                                     )
     2132           v-err-message = v-err-message + v-obj-errors
     2133         .
     2134       end.
     2135       if v-data-header-filename <> "":U
     2136       and search( v-data-header-filename ) = ?
     2137       then do:
     2138         assign
     2139           v-obj-errors  = v-obj-errors +  substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     2140                                                     , v-template-file-name
     2141                                                     , v-data-header-filename
     2142                                                     , chr(10)
     2143                                                     )
     2144           v-err-message = v-err-message + v-obj-errors
     2145         .
     2146       end.
     2147       if v-data-filename <> "":U
     2148       and search( v-data-filename )   = ?
     2149       then do:
     2150         assign
     2151           v-obj-errors  = v-obj-errors + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     2152                                                    , v-template-file-name
     2153                                                    , v-data-filename
     2154                                                    , chr(10)
     2155                                                    )
     2156           v-err-message = v-err-message + v-obj-errors
     2157         .
     2158       end.
     2159       create buf_temp-param.
     2160       assign
     2161         v-template-file-name = search( v-template-file-name )
     2162         file-info :file-name = v-template-file-name
     2163         v-template-file-name = file-info :full-pathname
     2164         v-vb-file-name       = search( v-vb-file-name )
     2165         file-info :file-name = v-vb-file-name
     2166         v-vb-file-name       = file-info :full-pathname
     2167       .
     2168       if v-template-file-name = ? or v-template-file-name = "":U
     2169       then do:
     2170         next _obj-cycle.
     2171       end.
     2172       run paramls-write in this-procedure ( input "template":U
     2173                                           , input "template-file-name":U
     2174                                           , input v-template-file-name
     2175                                           ).
     2176       run paramls-write in this-procedure ( input "template":U
     2177                                           , input "vb-file-name":U
     2178                                           , input v-vb-file-name
     2179                                           ).
     2180       run paramls-write in this-procedure ( input "data":U
     2181                                           , input "data-header-filename":U
     2182                                           , input v-data-header-filename
     2183                                           ).
     2184       run paramls-write in this-procedure ( input "data":U
     2185                                           , input "data-filename":U
     2186                                           , input v-data-filename
     2187                                           ).
     2188       run paramls-write in this-procedure ( input "saveas":U
     2189                                           , input "excel-file-name":U
     2190                                           , input v-excel-file-name
     2191                                           ).
     2192       run paramls-write in this-procedure ( input "file":U
     2193                                           , input "file-no-open":U
     2194                                           , input "yes":U
     2195                                           ).
     2196       run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     2197       if error-status :error
     2198       then do:
     2199         assign
     2200           v-obj-errors  = v-obj-errors + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     2201                                                    , vss-workfile
     2202                                                    , vss-revision
     2203                                                    , vss-description
     2204                                                    , chr(10)
     2205                                                    , return-value
     2206                                                    , trim(error-status :get-message(1))
     2207                                                    , trim(error-status :get-message(2))
     2208                                                    , trim(error-status :get-message(3))
     2209                                                    )
     2210           v-err-message = v-err-message + v-obj-errors
     2211         .
     2212       end.
     2213       run gbl/del-file.p ( input v-filename ) no-error .
     2214       if error-status :error
     2215       then do:
     2216         assign
     2217           v-obj-errors  = v-obj-errors +  substitute( "Ошибка удаления файла &1: &2 &3&3"
     2218                                                     , v-filename
     2219                                                     , return-value
     2220                                                     , chr(10)
     2221                                                     )
     2222           v-err-message = v-err-message + v-obj-errors
     2223         .
     2224       end.
     2225       run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     2226       if error-status :error
     2227       then do:
     2228         assign
     2229           v-obj-errors  = v-obj-errors + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     2230                                                    , v-filename
     2231                                                    , return-value
     2232                                                    , trim(error-status :get-message(1))
     2233                                                    , chr(10)
     2234                                                    )
     2235           v-err-message = v-err-message + v-obj-errors
     2236         .
     2237       end.
     2238       run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     2239       if error-status :error
     2240       then do:
     2241         assign
     2242           v-obj-errors  = v-obj-errors + substitute( "Ошибка удаления файла &1: &2 &3&3"
     2243                                                    , v-home-dir-filename
     2244                                                    , return-value
     2245                                                    , chr(10)
     2246                                                    )
     2247           v-err-message = v-err-message + v-obj-errors
     2248         .
     2249       end.
     2250       run gbl/ren-file.p ( input v-excel-file-name
     2251                          , input v-home-dir-filename
     2252                          ) no-error .
     2253       if error-status :error
     2254       then do:
     2255         assign
     2256           v-obj-errors  = v-obj-errors + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     2257                                                    , v-excel-file-name
     2258                                                    , v-home-dir-filename
     2259                                                    , return-value
     2260                                                    , chr(10)
     2261                                                    )
     2262           v-err-message = v-err-message + v-obj-errors
     2263         .
     2264       end.
     2265       run write-log in this-procedure ( input v-obj-errors ) .
     2266       assign
     2267         v-obj-errors = ''
     2268       .
     2269     end.
     2270     run waitfram-hide in this-procedure .
     2271     assign
     2272       p-error-message = v-err-message
     2273     .
     2274   end.
     2275   end procedure.
     2276   procedure print-no-schedule :
     2277   do
     2278   on error undo, return error return-value
     2279   :
     2280     run get-report-num in parparentproc (output g#report-num).
     2281   output stream sout to value( string( session:temp-directory +
     2282                                        "rpt" + string( g#report-num ) ) )
     2283                                        page-size  value(43) .
     2284     put stream sout unformatted "Отчет формируется только в Excel." skip(2).
     2285     output stream sout close.
     2286     run kfrebaxl-init in this-procedure.
     2287     for each tt-obj-list
     2288     :
     2289       run kfrebaxl-write-cell-data in this-procedure ( input "h_date":U , input tt-obj-list.shift-date-str ).
     2290       run kfrebaxl-write-cell-data in this-procedure ( input "h_obj":U  , input tt-obj-list.obj-name       ).
     2291       for each tt-gds
     2292       , each tt-report
     2293         where tt-report.obj-type = tt-obj-list.obj-type
     2294           and tt-report.obj-code = tt-obj-list.obj-code
     2295           and tt-report.gds-code = tt-gds.gds-code
     2296       by tt-gds.id descending
     2297       by tt-report.place-loc1
     2298       by tt-report.pump-code
     2299       :
     2300         run kfrebaxl-sheet1-write-line-data in this-procedure
     2301               ( input tt-report.pump-code
     2302               , input tt-report.gds-name
     2303               , input tt-report.prev-state-measure-qnty
     2304               , input tt-report.fact-qnty
     2305               , input tt-report.end-state-el-cnt
     2306               , input tt-report.begin-state-el-cnt
     2307               , input tt-report.sale-state-el-cnt
     2308               , input tt-report.end-state-mh-cnt
     2309               , input tt-report.begin-state-mh-cnt
     2310               , input tt-report.sale-state-mh-cnt
     2311               , input tt-report.state-divergence
     2312               , input tt-report.sale-state
     2313               , input tt-report.sale-techfuel
     2314               , input tt-report.sale-total
     2315               , input tt-report.place-loc1
     2316               , input tt-report.fact-ost-measure-qnty
     2317               , input tt-report.fact-ost-state-measure-qnty
     2318               , input tt-report.end-system-qnty
     2319               , input tt-report.fact-divergence
     2320               ).
     2321       end .
     2322     end.
     2323     run kfrebaxl-close in this-procedure.
     2324     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2325     os-rename
     2326       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2327       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2328     .
     2329     define variable v-user-action   as character no-undo .
     2330     define variable v-printed       as logical   no-undo .
     2331     define variable ReportFontNum   as integer   no-undo .
     2332     run gbl/prnfilen.w
     2333         (input  ""
     2334         ,input  20
     2335         ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2336         ,input  ReportFontNum
     2337         ,output v-user-action
     2338         ,output v-printed
     2339         ) .
     2340     os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2341   end.
     2342   end procedure.
     2343   procedure write-log :
     2344     define input  parameter p-str as character no-undo .
     2345   do
     2346   on error undo, return error return-value
     2347   :
     2348     if p-str = ""
     2349     then do:
     2350       return.
     2351     end.
     2352     if p-is-schedule = yes
     2353     then do:
     2354       if parparentproc :get-signature("write-to-log") <> "":u
     2355       then do:
     2356         run write-to-log in parparentproc ( input p-str ) .
     2357       end.
     2358       assign
     2359         p-str = substitute("&1 &2&3", cur-time-string-sec() , p-str, chr(10))
     2360         p-str = replace(p-str, (chr(10) + chr(13)), chr(10) )
     2361         p-str = replace(p-str, (chr(13) + chr(10)), chr(10) )
     2362         p-str = replace(p-str, chr(10), (chr(13) + chr(10)) )
     2363       .
     2364       run gbl/fileapnd.p
     2365         ( input "r-kfreba.log"
     2366          ,input p-str
     2367          ,input 10
     2368         ) no-error .
     2369       if error-status:error then do:
     2370         return error return-value .
     2371       end.
     2372     end.
     2373   end.
     2374   end procedure.
     2375   procedure proc-message :
     2376     define input  parameter p-message as character no-undo .
     2377   do
     2378   on error undo, return error return-value
     2379   :
     2380     if p-is-schedule = yes
     2381     then do:
     2382       run write-log in this-procedure ( input p-message ) .
     2383     end.
     2384     else do:
     2385       message
     2386         p-message
     2387       view-as alert-box information.
     2388     end.
     2389   end.
     2390   end procedure.
