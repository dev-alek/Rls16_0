     1664             where buf_tt-pump-pl.obj-type  = buf_tt-obj-list.obj-type
     1665               and buf_tt-pump-pl.obj-code  = buf_tt-obj-list.obj-code
     1666               and buf_tt-pump-pl.gds-code  = buf_tt-gds.gds-code
     1667               and buf_tt-pump-pl.pl-code   = buf_rvs-line-pump.pl-code
     1668               and buf_tt-pump-pl.pump-code = buf_rvs-line-pump.pump-code
     1669           no-error .
