     1787                 and buf_tt-report.obj-code  = buf_tt-obj-list.obj-code
     1788                 and buf_tt-report.gds-code  = buf_tt-gds.gds-code
     1789                 and buf_tt-report.pl-code   = buf_doc-pl.pl-code
