       90   define  stream PrnLibStream.
       91   procedure prn-lib-prn-file :
       92     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       93     define input parameter p-DIsabledoptions as integer no-undo .
       94     define variable v-report-name as character no-undo .
       95     define variable v-user-action as character no-undo .
       96     define variable v-printed     as logical   no-undo .
       97     define variable v-exist       as logical   no-undo .
       98     do
       99       on error undo, return error
      100       :
      101       run prn-lib-get-report-name  in this-procedure (
      102         input parParentProc
      103         ,output v-report-name
      104         ).
      105   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      107     (input  v-report-name
      108     ,input  2
      109     ,output v-exist
      110     )  .
      111       if NOT v-exist then
      112       DO:
      113         Message
      114           "Нет заданий на печать ! "
      115           view-as alert-box .
      116         Return  .
      117       End.
      118       run gbl/prnfilen.w
      119         (input  ""
      120         ,input  p-DisabledOptions
      121         ,input  string(v-report-name )
      122         ,input  7
      123         ,output v-user-action
      124         ,output v-printed
      125         ) .
      126       if v-printed then
      127       do:
      128         return "YES" .
      129       end.
      130       else
      131       do:
      132         return "NO" .
      133       end.
      134     end.
      135   end procedure.
      136   procedure prn-lib-open-stream :
      137     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      138     define input parameter p-page-size    as integer no-undo .
      139     define input parameter p-is-stream    as logical no-undo .
      140     define input parameter p-append       as logical no-undo .
      141     define variable v-report-name as character no-undo .
      142     do
      143       on error undo, return error
      144       :
      145       run prn-lib-get-report-name  in this-procedure (
      146         input parParentProc
      147         ,output v-report-name
      148         ).
      149       if p-is-stream then
      150       do:
      151         if p-append then
      152         do:
      153           output stream PrnLibStream to value( v-report-name )
      154             page-size value(p-page-size) append .
      155         end.
      156         if not p-append then
      157         do:
      158           output stream PrnLibStream to value( v-report-name )
      159             page-size value(p-page-size) .
      160         end.
      161       end.
      162       if not p-is-stream then
      163       do:
      164         if p-append then
      165         do:
      166           output to value( v-report-name )
      167             page-size value(p-page-size) append .
      168         end.
      169         if not p-append then
      170         do:
      171           output to value( v-report-name )
      172             page-size value(p-page-size) .
      173         end.
      174       end.
      175     end.
      176   end procedure.
      177   procedure prn-lib-open-exp :
      178     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      179     define input parameter p-is-stream    as logical no-undo .
      180     define input parameter p-is-append    as logical no-undo .
      181     define output parameter p-ReportFileName as char init "report" no-undo.
      182     define output parameter p-process as logical no-undo .
      183     define variable glog as logical no-undo .
      184     do
      185       on error undo, return error
      186       :
      187       SYSTEM-DIALOG GET-FILE p-ReportFileName
      188         TITLE      "Укажите путь"
      189         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      190         ASK-OVERWRITE
      191         CREATE-TEST-FILE
      192         SAVE-AS
      193         USE-FILENAME
      194         DEFAULT-EXTENSION "txt"
      195         UPDATE glog
      196         .
      197       if not glog then  return.
      198       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      199       if p-is-stream then
      200       do:
      201         if p-is-append then
      202         do:
      203           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      204         end.
      205         else
      206         do:
      207           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      208         end.
      209       end.
      210       else
      211       do:
      212         if p-is-append then
      213         do:
      214           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      215         end.
      216         else
      217         do:
      218           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      219         end.
      220       end.
      221       p-process = yes.
      222     end.
      223   end procedure.
      224   procedure prn-lib-get-report-name :
      225     define input parameter parParentProc  as widget-handle no-undo.
      226     define output parameter p-report-name as character no-undo .
      227     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      228   end procedure.
      229   procedure prn-lib-reportviewer-report-name :
      230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      231     define input parameter p-report-name-html as character no-undo .
      232     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      233   end procedure.
      234   procedure prn-lib-reportviewer :
      235     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      236     define input parameter p-report-name-html as character no-undo .
      237     define input parameter p-param        as character no-undo .
      238     define variable v-excel           as character no-undo init 'TRUE' .
      239     define variable v-value-character as character no-undo .
      240     define variable v-value-integer   as character no-undo .
      241     define variable v-value-date      as date      no-undo .
      242     define variable v-value-decimal   as decimal   no-undo .
      243     define variable rep-excel         as logical   no-undo .
      244     define variable excel-string      as character no-undo .
      245     define variable v-param-type      as character no-undo .
      246     define variable v-tth             as handle    no-undo .
      247     run adm/shattri.p (
      248       input "get":U
      249       ,input  ""
      250       ,input  0
      251       ,input  'report-glob':U
      252       ,input  'rep-excel':U
      253       ,output v-value-character
      254       ,output v-value-date
      255       ,output v-value-decimal
      256       ,output v-value-integer
      257       ,output rep-excel
      258       ,output v-param-type
      259       ,INPUT-OUTPUT table-handle v-tth
      260       )  .
      261     if rep-excel then v-excel = "TRUE" .
      262     else v-excel = "FALSE" .
      263     if p-param eq ""
      264     then
      265        p-param = "EXCEL:" + v-excel.
      266     else
      267        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      268     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      269   end procedure.
      270   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      271   procedure cur-time :
      272      define output parameter p-today as date      no-undo .
      273      define output parameter p-time  as integer   no-undo .
      274     do
      275     on error undo, return error
      276     :
      277       define variable v-date1 as date      no-undo .
      278       define variable v-date2 as date      no-undo .
      279       define variable v-time  as integer   no-undo .
      280       assign
      281         v-date1 = today
      282         v-time  = time
      283         v-date2 = today
      284       .
      285       if v-date1 <> v-date2
      286       then do:
      287         assign
      288           v-date1 = today
      289           v-time  = v-time
      290         .
      291       end.
      292       assign
      293         p-today = v-date1
      294         p-time  = v-time
      295       .
      296     end.
      297   end.
      298   function cur-time-date returns character
      299   :
      300     return string(today, '99/99/9999':U) .
      301   end.
      302   function cur-time-mjd returns decimal
      303   :
      304     define variable v-date as date      no-undo .
      305     define variable v-time as integer   no-undo .
      306     run cur-time in this-procedure
      307       (output v-date
      308       ,output v-time
      309       ) .
      310     return integer(v-date) - 2400002 + (v-time / 86400) .
      311   end.
      312   function cur-time-get-ending-index returns integer
      313   (input p-number as integer
      314   )
      315   :
      316     if p-number < 0
      317     or p-number = ?
      318     then do:
      319       return 1 .
      320     end.
      321     define variable v-rest as integer   no-undo .
      322     assign
      323       p-number = p-number modulo 100
      324     .
      325     if p-number < 20
      326     then do:
      327       assign
      328         v-rest = p-number
      329       .
      330     end.
      331     else do:
      332       assign
      333         v-rest = p-number modulo 10
      334       .
      335     end.
      336     case v-rest :
      337       when 1
      338       then do:
      339         return 2 .
      340       end.
      341       when 2 or
      342       when 3 or
      343       when 4
      344       then do:
      345         return 3 .
      346       end.
      347       otherwise do:
      348         return 1 .
      349       end.
      350     end case .
      351   end.
      352   procedure cur-time-mjd-to-date :
      353      define input  parameter i-mjd-diff as decimal no-undo.
      354      define output parameter o-Date     as date    no-undo.
      355      define output parameter o-Time     as integer no-undo.
      356      define variable v-day-number as integer   no-undo .
      357      if    i-mjd-diff < 0
      358         or i-mjd-diff = ?
      359      then do:
      360         return "?" .
      361      end.
      362      assign
      363         v-day-number = truncate(i-mjd-diff,0).
      364         o-Date = date(v-day-number + 2400002).
      365         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      366     .
      367   end.
      368   function cur-time-mjd-to-string returns character
      369   (input p-mjd-diff as decimal
      370   )
      371   :
      372     define variable v-day-number as integer   no-undo .
      373     define variable v-seconds    as integer   no-undo .
      374     define variable v-hour       as integer   no-undo .
      375     define variable v-min        as integer   no-undo .
      376     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      377     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      378     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      379     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      380     if p-mjd-diff < 0
      381     or p-mjd-diff = ?
      382     then do:
      383       return "?" .
      384     end.
      385     assign
      386       v-day-number = integer(truncate(p-mjd-diff,0))
      387       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      388     .
      389     if v-seconds > 86400
      390     then do:
      391       assign
      392         v-seconds = 86400 - 1
      393       .
      394     end.
      395     if v-seconds < 0
      396     then do:
      397       assign
      398         v-seconds = 0
      399       .
      400     end.
      401     assign
      402       v-hour = truncate(v-seconds / 3600, 0)
      403     .
      404     assign
      405       v-seconds = v-seconds modulo 3600
      406     .
      407     assign
      408       v-min = truncate(v-seconds / 60, 0)
      409     .
      410     assign
      411       v-seconds = v-seconds modulo 60
      412     .
      413     return
      414         (if v-day-number <> 0
      415           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      416           else ""
      417         )
      418       + (if v-day-number <> 0 or v-hour <> 0
      419           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      420           else ""
      421         )
      422       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      423           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      424           else ""
      425         )
      426       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      427       .
      428   end.
      429   function cur-time-string returns character
      430   :
      431     define variable v-date as date      no-undo .
      432     define variable v-time as integer   no-undo .
      433     run cur-time in this-procedure
      434       (output v-date
      435       ,output v-time
      436       ) .
      437     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      438   end.
      439   function cur-time-string-sec returns character
      440   :
      441     define variable v-date as date      no-undo .
      442     define variable v-time as integer   no-undo .
      443     run cur-time in this-procedure
      444       (output v-date
      445       ,output v-time
      446       ) .
      447     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      448   end.
      449   function cur-time-custom  returns character
      450   (input p-prefix as character
      451   ,input p-date-format as character
      452   ,input p-delimiter as character
      453   ,input p-time-format as character
      454   ,input p-suffix as character
      455   )
      456   :
      457     define variable v-date as date      no-undo .
      458     define variable v-time as integer   no-undo .
      459     run cur-time in this-procedure
      460       (output v-date
      461       ,output v-time
      462       ) .
      463     return
      464       p-prefix
      465       + string(v-date, p-date-format)
      466       + p-delimiter
      467       + string(v-time, p-time-format)
      468       + p-suffix
      469       .
      470   end.
      471   function cur-time-print  returns character
      472   :
      473     define variable v-date as date      no-undo .
      474     define variable v-time as integer   no-undo .
      475     run cur-time in this-procedure
      476       (output v-date
      477       ,output v-time
      478       ) .
      479     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      480   end.
      481   function cur-time-datetime returns datetime
      482   :
      483     define variable v-char as character no-undo .
      484     define variable v-datetime as datetime no-undo .
      485     v-char = cur-time-string().
      486     v-datetime = datetime(v-char).
      487     return  v-datetime.
      488   end.
      489   function cur-time-string-msec returns character
      490   :
      491     define variable v-date as datetime  no-undo .
      492     v-date = now.
      493     return string(v-date) .
      494   end.
      495   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      496   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      497   procedure paramls-clear :
      498     define buffer buf_temp-param for temp-param .
      499     do
      500     on error undo, return error return-value
      501     :
      502       for each buf_temp-param
      503       on error undo, return error
      504       :
      505         delete buf_temp-param .
      506       end.
      507     end.
      508   end procedure.
      509   procedure paramls-write :
      510     define input  parameter p-code     as character no-undo .
      511     define input  parameter p-sub-code as character no-undo .
      512     define input  parameter p-value    as character no-undo .
      513     define buffer buf_temp-param for temp-param .
      514     do
      515     on error undo, return error return-value
      516     :
      517       find first buf_temp-param
      518         where buf_temp-param.param-code     = p-code
      519           and buf_temp-param.param-sub-code = p-sub-code
      520         no-error .
      521       if not available buf_temp-param then do:
      522         create buf_temp-param .
      523         assign
      524           buf_temp-param.param-code     = p-code
      525           buf_temp-param.param-sub-code = p-sub-code
      526         .
      527       end.
      528       assign
      529         buf_temp-param.param-value = p-value
      530       .
      531     end.
      532   end procedure.
      533   procedure paramls-read :
      534     define input  parameter p-code          as character no-undo .
      535     define input  parameter p-sub-code      as character no-undo .
      536     define input  parameter p-default-value as character no-undo .
      537     define output parameter p-value         as character no-undo .
      538     define buffer buf_temp-param for temp-param .
      539     do
      540     on error undo, return error return-value
      541     :
      542       find first buf_temp-param
      543         where buf_temp-param.param-code     = p-code
      544           and buf_temp-param.param-sub-code = p-sub-code
      545         no-error .
      546       if available buf_temp-param then do:
      547         assign
      548           p-value = buf_temp-param.param-value
      549         .
      550       end.
      551       else do:
      552         assign
      553           p-value = p-default-value
      554         .
      555       end.
      556     end.
      557   end procedure.
      558   procedure paramls-append :
      559     define input  parameter p-code     as character no-undo .
      560     define input  parameter p-sub-code as character no-undo .
      561     define input  parameter p-value    as character no-undo .
      562     define buffer buf_temp-param for temp-param .
      563     do
      564     on error undo, return error return-value
      565     :
      566       find first buf_temp-param
      567            where buf_temp-param.param-code     = p-code
      568              and buf_temp-param.param-sub-code = p-sub-code
      569         no-error .
      570       if not available buf_temp-param then do:
      571         create buf_temp-param .
      572         assign
      573           buf_temp-param.param-code     = p-code
      574           buf_temp-param.param-sub-code = p-sub-code
      575           buf_temp-param.param-value    = p-value
      576         .
      577       end.
      578       else do:
      579           assign
      580               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      581           .
      582       end.
      583     end.
      584   end procedure.
      585   define variable g#report-num  as integer    no-undo .
      586   define variable vss-include-info6 as character format "X(65)" no-undo
      587   initial "@(#)$Workfile$ $Revision$".
      588   define stream excel-line.
      589   define stream excel-cell.
      590   define temp-table temp_cell-data no-undo
      591       field data-key as character
      592       field data-value as character
      593       index pi is primary unique data-key
      594   .
      595   define temp-table temp_sheet1_line-data no-undo
      596       field sheet-name                  as character
      597       field xl-line-id                  as integer
      598       field pump-code                   like ub.rvs-line-pump.pump-code
      599       field gds-name                    as character
      600       field prev-state-measure-qnty     as decimal
      601       field fact-qnty                   as decimal
      602       field end-state-el-cnt            as decimal
      603       field begin-state-el-cnt          as decimal
      604       field sale-state-el-cnt           as decimal
      605       field end-state-mh-cnt            as decimal
      606       field begin-state-mh-cnt          as decimal
      607       field sale-state-mh-cnt           as decimal
      608       field state-divergence            as decimal
      609       field sale-state                  as decimal
      610       field sale-techfuel               as decimal
      611       field sale-total                  as decimal
      612       field place-loc1                  like ub.place.loc1
      613       field fact-ost-measure-qnty       as decimal
      614       field fact-ost-state-measure-qnty as decimal
      615       field end-system-qnty             as decimal
      616       field fact-divergence             as decimal
      617   index pi is primary unique
      618           xl-line-id
      619   .
      620   define variable v-kfrebaxl-sheet1-cur-data-row  as integer      no-undo.
      621   define variable v-kfrebaxl-cell-file-name       as character    no-undo.
      622   define variable v-kfrebaxl-data-file-name       as character    no-undo.
      623   procedure kfrebaxl-init :
      624   do
      625   on error undo, return error
      626   :
      627       assign
      628           v-kfrebaxl-sheet1-cur-data-row = 0
      629       .
      630       run gbl/_tmpfile.p (
      631             input "xd"
      632           , input ".txt"
      633           , output v-kfrebaxl-data-file-name
      634       ).
      635       output stream excel-line to value( v-kfrebaxl-data-file-name ).
      636       run gbl/_tmpfile.p (
      637             input "xc"
      638           , input ".txt"
      639           , output v-kfrebaxl-cell-file-name
      640       ).
      641       output stream excel-cell to value( v-kfrebaxl-cell-file-name ).
      642       run kfrebaxl-write-cell-data in this-procedure (
      643             input "sheetList":U
      644           , input "Лист1":U
      645       ).
      646       if printrubl
      647       then do:
      648           run kfrebaxl-write-cell-data in this-procedure (
      649                 input "Лист1_valutCode":U
      650               , input "0":U
      651           ).
      652       end.
      653       else do:
      654           run kfrebaxl-write-cell-data in this-procedure (
      655                 input "Лист1_valutCode":U
      656               , input "1":U
      657           ).
      658       end.
      659       run kfrebaxl-write-cell-data in this-procedure (
      660             input "Лист1_columnList":U
      661           , input "gds_name,prev_state_measure_qnty,fact_qnty,pump_code,end_state_el_cnt,begin_state_el_cnt,sale_state_el_cnt,end_state_mh_cnt,begin_state_mh_cnt,sale_state_mh_cnt,state_divergence,sale_state,sale_techfuel,sale_total,place_loc1,fact_ost_measure_qnty,fact_ost_state_measure_qnty,end_system_qnty,fact_divergence":U
      662       ).
      663       run kfrebaxl-write-cell-data in this-procedure (
      664             input "Лист1_columnType":U
      665           , input "S,D,D,I,D,D,D,D,D,D,D,D,D,D,S,D,D,D,D":U
      666       ).
      667       run kfrebaxl-write-cell-data in this-procedure (
      668             input "Лист1_subtotalList":U
      669           , input "":U
      670       ).
      671       run kfrebaxl-write-cell-data in this-procedure (
      672             input "Лист1_subtotalType":U
      673           , input "":U
      674       ).
      675   end.
      676   end procedure.
      677   procedure kfrebaxl-sheet1-write-line-data :
      678     define input  parameter p-pump-code                   like ub.rvs-line-pump.pump-code no-undo .
      679     define input  parameter p-gds-name                    as character                    no-undo .
      680     define input  parameter p-prev-state-measure-qnty     as decimal                      no-undo .
      681     define input  parameter p-fact-qnty                   as decimal                      no-undo .
      682     define input  parameter p-end-state-el-cnt            as decimal                      no-undo .
      683     define input  parameter p-begin-state-el-cnt          as decimal                      no-undo .
      684     define input  parameter p-sale-state-el-cnt           as decimal                      no-undo .
      685     define input  parameter p-end-state-mh-cnt            as decimal                      no-undo .
      686     define input  parameter p-begin-state-mh-cnt          as decimal                      no-undo .
      687     define input  parameter p-sale-state-mh-cnt           as decimal                      no-undo .
      688     define input  parameter p-state-divergence            as decimal                      no-undo .
      689     define input  parameter p-sale-state                  as decimal                      no-undo .
      690     define input  parameter p-sale-techfuel               as decimal                      no-undo .
      691     define input  parameter p-sale-total                  as decimal                      no-undo .
      692     define input  parameter p-place-loc1                  like ub.place.loc1              no-undo .
      693     define input  parameter p-fact-ost-measure-qnty       as decimal                      no-undo .
      694     define input  parameter p-fact-ost-state-measure-qnty as decimal                      no-undo .
      695     define input  parameter p-end-system-qnty             as decimal                      no-undo .
      696     define input  parameter p-fact-divergence             as decimal                      no-undo .
      697   define buffer buf_temp_sheet1_line-data  for temp_sheet1_line-data.
      698   do
      699   for buf_temp_sheet1_line-data
      700   on error undo, return error
      701   :
      702       for each buf_temp_sheet1_line-data
      703       :
      704           delete buf_temp_sheet1_line-data.
      705       end.
      706       create buf_temp_sheet1_line-data.
      707       assign
      708           v-kfrebaxl-sheet1-cur-data-row                        = v-kfrebaxl-sheet1-cur-data-row + 1
      709           buf_temp_sheet1_line-data.sheet-name                  = "Лист1":U
      710           buf_temp_sheet1_line-data.xl-line-id                  = v-kfrebaxl-sheet1-cur-data-row
      711           buf_temp_sheet1_line-data.pump-code                   = p-pump-code
      712           buf_temp_sheet1_line-data.gds-name                    = p-gds-name
      713           buf_temp_sheet1_line-data.prev-state-measure-qnty     = p-prev-state-measure-qnty
      714           buf_temp_sheet1_line-data.fact-qnty                   = p-fact-qnty
      715           buf_temp_sheet1_line-data.end-state-el-cnt            = p-end-state-el-cnt
      716           buf_temp_sheet1_line-data.begin-state-el-cnt          = p-begin-state-el-cnt
      717           buf_temp_sheet1_line-data.sale-state-el-cnt           = p-sale-state-el-cnt
      718           buf_temp_sheet1_line-data.end-state-mh-cnt            = p-end-state-mh-cnt
      719           buf_temp_sheet1_line-data.begin-state-mh-cnt          = p-begin-state-mh-cnt
      720           buf_temp_sheet1_line-data.sale-state-mh-cnt           = p-sale-state-mh-cnt
      721           buf_temp_sheet1_line-data.state-divergence            = p-state-divergence
      722           buf_temp_sheet1_line-data.sale-state                  = p-sale-state
      723           buf_temp_sheet1_line-data.sale-techfuel               = p-sale-techfuel
      724           buf_temp_sheet1_line-data.sale-total                  = p-sale-total
      725           buf_temp_sheet1_line-data.place-loc1                  = p-place-loc1
      726           buf_temp_sheet1_line-data.fact-ost-measure-qnty       = p-fact-ost-measure-qnty
      727           buf_temp_sheet1_line-data.fact-ost-state-measure-qnty = p-fact-ost-state-measure-qnty
      728           buf_temp_sheet1_line-data.end-system-qnty             = p-end-system-qnty
      729           buf_temp_sheet1_line-data.fact-divergence             = p-fact-divergence
      730       .
      731       put stream excel-line unformatted
      732                           buf_temp_sheet1_line-data.sheet-name
      733           chr(9)   "DTA":U
      734           chr(9)   buf_temp_sheet1_line-data.gds-name
      735           chr(9)    buf_temp_sheet1_line-data.prev-state-measure-qnty
      736           chr(9)    buf_temp_sheet1_line-data.fact-qnty
      737           chr(9)   buf_temp_sheet1_line-data.pump-code
      738           chr(9)     buf_temp_sheet1_line-data.end-state-el-cnt
      739           chr(9)     buf_temp_sheet1_line-data.begin-state-el-cnt
      740           chr(9)     buf_temp_sheet1_line-data.sale-state-el-cnt
      741           chr(9)     buf_temp_sheet1_line-data.end-state-mh-cnt
      742           chr(9)     buf_temp_sheet1_line-data.begin-state-mh-cnt
      743           chr(9)     buf_temp_sheet1_line-data.sale-state-mh-cnt
      744           chr(9)     buf_temp_sheet1_line-data.state-divergence
      745           chr(9)     buf_temp_sheet1_line-data.sale-state
      746           chr(9)     buf_temp_sheet1_line-data.sale-techfuel
      747           chr(9)     buf_temp_sheet1_line-data.sale-total
      748           chr(9)   buf_temp_sheet1_line-data.place-loc1
      749           chr(9)     buf_temp_sheet1_line-data.fact-ost-measure-qnty
      750           chr(9)     buf_temp_sheet1_line-data.fact-ost-state-measure-qnty
      751           chr(9)     buf_temp_sheet1_line-data.end-system-qnty
      752           chr(9)     buf_temp_sheet1_line-data.fact-divergence
      753           chr(10)
      754       .
      755   end.
      756   end procedure.
      757   procedure kfrebaxl-sheet1-write-line-format :
      758   define input parameter p-fmt-label       as character  no-undo.
      759       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
      760   do
      761   for buf_temp_sheet1_line-data
      762   on error undo, return error
      763   :
      764       put stream excel-line unformatted
      765                           "Лист1":U
      766           chr(9)   "FMT":U
      767           chr(9)   p-fmt-label
      768           chr(10)
      769       .
      770   end.
      771   end procedure.
      772   procedure kfrebaxl-write-cell-data :
      773   define input parameter p-data-key   as character        no-undo.
      774   define input parameter p-data-value as character        no-undo.
      775       define buffer buf_temp_cell-data     for temp_cell-data.
      776   do
      777   for buf_temp_cell-data
      778   on error undo, return error
      779   :
      780       find first buf_temp_cell-data
      781            where buf_temp_cell-data.data-key = p-data-key
      782       no-error.
      783       if not available buf_temp_cell-data
      784       then do:
      785           create buf_temp_cell-data.
      786           assign
      787               buf_temp_cell-data.data-key = p-data-key
      788           .
      789       end.
      790       assign
      791           buf_temp_cell-data.data-value = p-data-value
      792       .
      793       put stream excel-cell unformatted
      794                           buf_temp_cell-data.data-key
      795           chr(9)   buf_temp_cell-data.data-value
      796           chr(10)
      797       .
      798   end.
      799   end procedure.
      800   procedure kfrebaxl-run-excel :
      801   define input parameter p-header-filename    as character        no-undo.
      802   define input parameter p-data-filename      as character        no-undo.
      803       define variable v-Template-file-name    as character    no-undo.
      804       define variable v-vb-file-name          as character    no-undo.
      805       define buffer buf_temp-param for temp-param .
      806   do
      807   for buf_temp-param
      808   on error undo, return error
      809   :
      810       create buf_temp-param.
      811       assign
      812           v-Template-file-name    = search( "exe/kfsale.xlt" )
      813           v-vb-file-name          = search( "exe/t_form.bas")
      814       .
      815       if v-Template-file-name = ?
      816       or v-Template-file-name = "":U
      817       then do:
      818           message
      819               "Ошибка имени файла шаблона."
      820           view-as alert-box error.
      821       end.
      822       if v-vb-file-name = ?
      823       or v-vb-file-name = "":U
      824       then do:
      825           message
      826               "Ошибка имени файла кода обработки."
      827           view-as alert-box error.
      828       end.
      829       run paramls-write in this-procedure (
      830             input "template":U
      831           , input "template-file-name":U
      832           , input v-Template-file-name
      833       ).
      834       run paramls-write in this-procedure (
      835             input "template":U
      836           , input "vb-file-name":U
      837           , input v-vb-file-name
      838       ).
      839       run paramls-write in this-procedure (
      840             input "data":U
      841           , input "data-header-filename":U
      842           , input p-header-filename
      843       ).
      844       run paramls-write in this-procedure (
      845             input "data":U
      846           , input "data-filename":U
      847           , input p-data-filename
      848       ).
      849       run gbl/macroxlt.p (
      850           input-output table buf_temp-param
      851       ) no-error.
      852       if error-status :error
      853       then do:
      854           message
      855                    vss-workfile vss-revision vss-description
      856               skip(1)
      857               skip "Ошибка создания файла Excel."
      858               skip return-value
      859               skip trim(error-status :get-message(1))
      860                    trim(error-status :get-message(2))
      861                    trim(error-status :get-message(3))
      862           view-as alert-box error.
      863           undo, return error .
      864       end.
      865   end.
      866   end procedure.
      867   procedure kfrebaxl-close :
      868   do
      869   on error undo, return error
      870   :
      871       output stream excel-line close.
      872       output stream excel-cell close.
      873       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      874           export "exe/kfreba.xlt":U.
      875           export "exe/t_form.bas":U.
      876           export v-kfrebaxl-cell-file-name.
      877           export v-kfrebaxl-data-file-name.
      878       output close.
      879   end.
      880   end procedure.
      881   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   define variable v-waitfram-action01         as character   no-undo .
      883   define variable v-waitfram-action02         as character   no-undo .
      884   define variable v-waitfram-action03         as character   no-undo .
      885   define variable mWaitFramTextBeg            as character   no-undo.
      886   define variable mWaitFramTextEnd            as character   no-undo.
      887   define variable mWaitFramView               as logical     no-undo.
      888   define variable mWaitProcEvent              as logical     no-undo init yes.
      889   define variable mWaitFramInterval           as integer     no-undo init 1 .
      890   define variable mWaitFramStop               as logical     no-undo.
      891   define variable mWaitFramStopUser           as logical     no-undo.
      892   define variable mWaitFramStopTimeOut        as logical     no-undo.
      893   define variable mWaitFramStartProc          as datetime-tz no-undo.
      894   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      895   define button B-WaitFramStop auto-end-key
      896        label "Стоп"
      897        size 10 by 1 tooltip "Остоновить процесс".
      898   define button B-viewProcInfo
      899        label "Информация"
      900        size 15 by 1 tooltip "Информация о процесс".
      901   define frame waitfram
      902     v-waitfram-action01 format "x(72)" no-label skip
      903     v-waitfram-action02 format "x(72)" no-label skip
      904     v-waitfram-action03 format "x(72)" no-label skip
      905     B-viewProcInfo
      906     B-WaitFramStop at row 4 col 30
      907     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      908     .
      909   define new global shared variable mBatchMode as logical no-undo init ?.
      910   define variable mFramBachModHandle as handle no-undo.
      911   mFramBachModHandle = frame waitfram:handle.
      912   define variable mFameOldVis as logical no-undo.
      913   define variable mVisCUrentVin as logical no-undo.
      914   if session:batch-mode
      915   then
      916      mBatchMode = yes.
      917   if mBatchMode = ? then do:
      918     mVisCUrentVin = current-window:visible.
      919     mFameOldVis = mFramBachModHandle:visible.
      920     mFramBachModHandle:visible  = yes.
      921     mBatchMode = mFramBachModHandle:visible ne yes.
      922     mFramBachModHandle:visible = mFameOldVis.
      923     current-window:visible = mVisCUrentVin.
      924   end.
      925    if  log-manager:logfile-name ne ?
      926     then DO:
      927         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      928         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      929         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      930     end.
      931   on choose of B-WaitFramStop in frame waitfram
      932   do:
      933     mWaitFramStop = yes.
      934     mWaitFramStopUser = yes.
      935   end.
      936   function waitfram-check-timeout returns logical():
      937      define variable vtime as int64 no-undo.
      938      if mWaitFramStopTimeOut
      939      then
      940         return yes.
      941      vtime = ( now - mWaitFramStartProc ) / 1000 .
      942      if     mWaitFramTimeOut ne ?
      943         and mWaitFramTimeOut ne 0
      944         and mWaitFramTimeOut lt vtime
      945      then do:
      946         mWaitFramStopTimeOut = yes.
      947      end.
      948      return mWaitFramStopTimeOut.
      949   end.
      950   procedure waitfram-hide :
      951     if not session:batch-mode
      952     then do
      953     on error undo, return error return-value
      954     :
      955       pause 0 before-hide .
      956       if not mBatchMode then
      957         hide frame waitfram .
      958     if     not mWaitFramView
      959        and mWaitProcEvent
      960     then
      961       process events .
      962     end.
      963   end procedure.
      964   procedure waitfram-show :
      965     define input  parameter p-message as character no-undo .
      966     define variable v-left-margin as integer   no-undo .
      967     if not session:batch-mode
      968     then do
      969     on error undo, return error return-value
      970     :
      971       if length(p-message) <= 70 then do:
      972         assign
      973           v-left-margin = integer((70 - length(p-message)) / 2)
      974         .
      975         assign
      976           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      977         .
      978         assign
      979           v-waitfram-action01 = " "
      980           v-waitfram-action02 = " "
      981                                    + fill(" ", v-left-margin)
      982                                    + p-message
      983           v-waitfram-action03 = " "
      984         .
      985       end.
      986       else do:
      987         define variable vRindex1 as integer no-undo.
      988         define variable vRindex2 as integer no-undo.
      989         vRindex1 = r-index(p-message," ",70).
      990         if vRindex1 = 0
      991         then
      992            vRindex1 = 70.
      993         if length(p-message)  <= vRindex1 + 70 then do:
      994           assign
      995             v-waitfram-action01 = " "
      996             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      997             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      998           .
      999         end.
     1000         else do:
     1001           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1002           if vRindex2 <= vRindex1
     1003           then
     1004              vRindex2 = vRindex1 + 70.
     1005           assign
     1006             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1007             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1008             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1009           .
     1010         end.
     1011       end.
     1012       B-viewProcInfo:visible   in frame waitfram = no.
     1013       B-viewProcInfo:sensitive in frame waitfram = no.
     1014       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1015       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1016       if  (   mWaitFramView
     1017          or  mWaitProcEvent)
     1018          and not mBatchMode
     1019       then
     1020          display
     1021             v-waitfram-action01 skip
     1022             v-waitfram-action02 skip
     1023             v-waitfram-action03 skip
     1024          with frame waitfram .
     1025       if     mWaitFramView
     1026          then do:
     1027             if     mWaitFramInterval ne ?
     1028                and not mBatchMode
     1029             then
     1030                wait-for go of frame waitfram pause mWaitFramInterval.
     1031          end.
     1032          else
     1033             if     mWaitProcEvent
     1034                and not mBatchMode
     1035             then
     1036                process events .
     1037     end.
     1038   end procedure.
     1039      procedure waitfram-show-this:
     1040         define input  parameter iInterval as int64 no-undo.
     1041         define variable vtime as int64 no-undo.
     1042         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1043         mWaitFramInterval = iInterval.
     1044         run waitfram-show (substitute("&1&2 &3&4" ,
     1045                                       mWaitFramTextBeg ,
     1046                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1047                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1048                                       mWaitFramTextEnd
     1049                                      )
     1050                           ).
     1051      end.
     1052      procedure WaitFramRunPause:
     1053         define input  parameter iInterval as dec no-undo.
     1054         define variable vStart  as datetime-tz no-undo.
     1055         define variable vend    as datetime-tz no-undo.
     1056         define variable vint as int64 no-undo.
     1057         define variable vOk as logical no-undo.
     1058         vStart = now.
     1059         vend   = vStart.
     1060         publish "WaitFramPause" (iInterval,output vOk).
     1061         vend   =  now.
     1062         vint = vend - vStart.
     1063         vint = iInterval - vint / 1000.
     1064         if     not mWaitFramStop
     1065            and (   vint > 0
     1066                 or (    not vOk
     1067                     and iInterval eq ?
     1068                     )
     1069                 )
     1070         then
     1071            run waitfram-show-this (iInterval).
     1072         vend   =  now.
     1073         vint = vend - vStart.
     1074         vint = iInterval - vint / 1000.
     1075         if     not mWaitFramStop
     1076            and vint > 0
     1077         then do:
     1078            run gbl/pause.p (vint * 1000).
     1079         end.
     1080         if iInterval ne ?
     1081         then
     1082            publish "WaitFramStop".
     1083         waitfram-check-timeout().
     1084      end.
     1085      procedure WaitFramWaitFor:
     1086         define input  parameter iInterval as dec no-undo.
     1087         assign
     1088            mWaitFramStartProc   = now
     1089            mWaitFramStopUser    = no
     1090            mWaitFramStopTimeOut = no
     1091         .
     1092         block-wait:
     1093         do while not mWaitFramStop:
     1094            run WaitFramRunPause (iInterval).
     1095            if  waitfram-check-timeout()
     1096            then do:
     1097               leave block-wait.
     1098            end.
     1099         end.
     1100         run waitfram-hide.
     1101      end.
     1102   procedure waitfram-join :
     1103     define input  parameter p-line-1  as character no-undo .
     1104     define input  parameter p-line-2  as character no-undo .
     1105     define input  parameter p-line-3  as character no-undo .
     1106     define output parameter p-message as character no-undo .
     1107     do
     1108     on error undo, return error return-value
     1109     :
     1110       assign
     1111         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1112                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1113                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1114       .
     1115     end.
     1116   end procedure.
     1117   function waitfram-join-function returns character
     1118     (input p-line-1 as character
     1119     ,input p-line-2 as character
     1120     ,input p-line-3 as character
     1121     ).
     1122     define variable v-message as character no-undo .
     1123     run waitfram-join in this-procedure
     1124       (input  p-line-1
     1125       ,input  p-line-2
     1126       ,input  p-line-3
     1127       ,output v-message
     1128       ) .
     1129     return v-message .
     1130   end function .
     1131   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1132   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1133   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1134   define variable par-type          as character no-undo.
     1135   define variable v-value-character as character no-undo .
     1136   define variable v-value-date      as date      no-undo .
     1137   define variable v-value-decimal   as decimal   no-undo .
     1138   define variable v-value-integer   as integer   no-undo .
     1139   define variable v-value-logical   as logical   no-undo .
     1140   define stream sout.
     1141   define stream in-stream.
     1142   define temp-table tt-obj-list no-undo
     1143     field obj-type like ub.clients.obj-type
     1144     field obj-code like ub.clients.obj-code
     1145     field obj-name like ub.clients.obj-name
     1146     field shift-date-str          as character
     1147     field report-name             as character
     1148     field cre-report              as logical
