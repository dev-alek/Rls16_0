     1628     ,  input buf_shift-obj_end.obj-code
     1629     ,  input buf_shift-obj_end.shift-date
     1630     ,  input buf_shift-obj_end.shift-num
     1631     , output v-varshift-name-end
     1632     , output v-varshift-name-num-end
     1633     )        no-error .
     1634       assign
     1635         v-prev-fo = if available buf_shift-obj_previous then buf_shift-obj_previous.fact-order else 0
     1636         v-fo      = buf_shift-obj_end.fact-order
     1637       .
     1638       empty temp-table buf_tt-pump-pl.
     1639       _rvs-doc-cycle:
     1640       for each buf_rvs-doc no-lock
     1641         where buf_rvs-doc.obj-type   = buf_tt-obj-list.obj-type
     1642           and buf_rvs-doc.obj-code   = buf_tt-obj-list.obj-code
     1643           and buf_rvs-doc.fact-order >= v-prev-fo
     1644           and buf_rvs-doc.fact-order <= v-fo
     1645           and buf_rvs-doc.status_    = 'факт':U
     1646           and buf_rvs-doc.rvs-type   = 'смена':U
     1647       :
     1648         if buf_rvs-doc.shift-date = buf_shift-obj_begin.shift-date
     1649           and buf_rvs-doc.shift-num < buf_shift-obj_begin.shift-num
     1650         then do:
     1651           next _rvs-doc-cycle.
     1652         end.
     1653         if buf_rvs-doc.shift-date = buf_shift-obj_end.shift-date
     1654           and buf_rvs-doc.shift-num > buf_shift-obj_end.shift-num
     1655         then do:
     1656           next _rvs-doc-cycle.
     1657         end.
     1658         for each buf_rvs-line-pump no-lock
     1659           where buf_rvs-line-pump.rvs-code  = buf_rvs-doc.rvs-code
     1660         , first buf_tt-gds
     1661           where buf_tt-gds.gds-code = buf_rvs-line-pump.gds-code
     1662         :
