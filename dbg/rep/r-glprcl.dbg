     1228   procedure proc-cur-rate :
     1229     do
     1230     on error undo, return error return-value
     1231     :
     1232   define input  parameter p-obj-type as character no-undo .
     1233   define input  parameter p-obj-code as integer   no-undo .
     1234   define output parameter Rubl_Coeff as decimal   no-undo .
     1235   define variable v-base-code like ub.sysconf.base-code no-undo .
     1236   define variable v-host-code like ub.sysconf.host-code no-undo .
     1237   DEFINE VARIABLE v-today as date no-undo .
     1238   DEFINE VARIABLE v-time as integer no-undo .
     1239   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1240   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1241     (input  p-obj-type
     1242     ,input  p-obj-code
     1243     ,output v-host-code
     1244     )  .
     1245   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1246   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1247     (input  v-host-code
     1248     ,output v-base-code
     1249     )  .
     1250   run cur-time in this-procedure ( output v-today, output v-time).
     1251           FIND LAST ub.curr-accnt WHERE ub.curr-accnt.curr-code = v-base-code
     1252                                                    AND ub.curr-accnt.exch-date <= v-today
     1253                                                    NO-LOCK NO-ERROR .
     1254           FIND LAST ub.curr-shop WHERE ub.curr-shop.curr-code = v-base-code
     1255                                                    AND ub.curr-shop.obj-code = p-obj-code
     1256                                                    AND ub.curr-shop.obj-type = p-obj-type
     1257                                                    USE-INDEX pi NO-LOCK NO-ERROR .
     1258           if p-obj-type = 'маг':U then
     1259               do:
     1260                   if not available ub.curr-shop then
     1261                       do:
     1262                           bell.
     1263                           message "Нет ни одного МАГАЗИННОГО курса базовой валюты к рублям.".
     1264                           Rubl_Coeff = 1.
     1265                       end.
     1266                   else
     1267                       Rubl_Coeff = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
     1268               end.
     1269           else
     1270               do:
     1271                   if not available ub.curr-accnt then
     1272                       do:
     1273                           bell.
     1274                           message "Нет ни одного курса ММВБ базовой валюты к рублям.".
     1275                           return.
     1276                       end.
     1277                   else
     1278                       Rubl_Coeff = ub.curr-accnt.exch-rate / ub.curr-accnt.exch-scale.
     1279               end.
     1280     end.
     1281   end procedure.
     1282   PROCEDURE prtprice :
     1283   def input parameter tr       as character.
     1284   def input parameter node as integer.
     1285   define input parameter pp-gds-code like ub.goods.gds-code no-undo .
     1286   define input parameter pp-unit-base like ub.goods.unit-base no-undo .
     1287   def buffer b-gds-prt for gds-prt .
     1288   define buffer buf_bar-code for bar-code.
     1289   define variable gds_name as char no-undo.
     1290   assign gds_name = tr .
     1291       FOR EACH b-gds-prt WHERE b-gds-prt.upper-code = node no-lock ,
     1292        first buf_bar-code no-lock
     1293         where buf_bar-code.gds-code  = pp-gds-code
     1294           and buf_bar-code.node-code = b-gds-prt.node-code
     1295           and buf_bar-code.part-code = ""
     1296           and buf_bar-code.in-code   = ""
     1297           and buf_bar-code.unit-cli  = pp-unit-base
     1298        :
     1299           RUN price-qnty ( b-gds-prt.node-code ) .
     1300           if true  then
     1301               do:
     1302                   if ( OnlyPrices ) OR ( qnty <> 0 OR WaitQnty <> 0 ) then
     1303                       do:
     1304                           if NOT b-gds-prt.root then
     1305                               tr = gds_name + '\' + b-gds-prt.node-name.
     1306                           FIND bar-code WHERE
     1307                                    bar-code.gds-code = gds-list.gds-code AND
     1308                                    bar-code.unit-cli = gds-list.unit-base AND
     1309                                    bar-code.node-code = b-gds-prt.node-code AND
     1310                                    bar-code.part-code = "" AND
     1311                                    bar-code.in-code = ""
     1312                                    NO-LOCK NO-ERROR .
     1313                           if ( t_grp-name <> gds-list.grp-name ) AND
     1314                              lookup( "По группам товаров ( и артикулу )", SortType ) > 0 then
     1315                               do:
     1316                                   if t_grp-name <> "" then
     1317                                       if OnlyPrices then
     1318                                           if P_Type = 2 then
     1319                                               UNDERLINE stream PL gds-list.gds-name
     1320                                               with FRAME ReducedPriceList-Rubl .
     1321                                           else
     1322                                               UNDERLINE stream PL gds-list.gds-name
     1323                                               with FRAME ReducedPriceList-Val .
     1324                                       else
     1325                                           if P_Type = 2 then
     1326                                               UNDERLINE stream PL gds-list.gds-name
     1327                                               with FRAME FullPriceList-Rubl .
     1328                                           else
     1329                                               UNDERLINE stream PL gds-list.gds-name
     1330                                               with FRAME FullPriceList-Val .
     1331                                   DO i = 1 to num-entries( right-trim(gds-list.grp-name, chr(47)), chr(47) ):
     1332                                       if OnlyPrices then
     1333                                           if P_Type = 2 then
     1334                                               do:
     1335                                                   DISPLAY stream PL sym1
     1336                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1337                                                           @ gds-list.gds-name
     1338                                                       sym7 with FRAME ReducedPriceList-Rubl .
     1339                                                   DOWN stream PL 1 with FRAME ReducedPriceList-Rubl .
     1340                                               end.
     1341                                           else
     1342                                               do:
     1343                                                   DISPLAY stream PL sym1
     1344                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1345                                                           @ gds-list.gds-name
     1346                                                       sym7 with FRAME ReducedPriceList-Val .
     1347                                                   DOWN stream PL 1 with FRAME ReducedPriceList-Val .
     1348                                               end.
     1349                                       else
     1350                                           if P_Type = 2 then
     1351                                               do:
     1352                                                   DISPLAY stream PL sym1
     1353                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1354                                                           @ gds-list.gds-name
     1355                                                       sym9 with FRAME FullPriceList-Rubl .
     1356                                                   DOWN stream PL 1 with FRAME FullPriceList-Rubl .
     1357                                               end.
     1358                                           else
     1359                                               do:
     1360                                                   DISPLAY stream PL sym1
     1361                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1362                                                           @ gds-list.gds-name
     1363                                                       sym9 with FRAME FullPriceList-Val .
     1364                                                   DOWN stream PL 1 with FRAME FullPriceList-Val .
     1365                                               end.
     1366                                   END .
     1367                                   if OnlyPrices then
     1368                                       if P_Type = 2 then
     1369                                           UNDERLINE stream PL gds-list.gds-name
     1370                                               with FRAME ReducedPriceList-Rubl .
     1371                                       else
     1372                                           UNDERLINE stream PL gds-list.gds-name
     1373                                               with FRAME ReducedPriceList-Val .
     1374                                   else
     1375                                       if P_Type = 2 then
     1376                                           UNDERLINE stream PL gds-list.gds-name
     1377                                               with FRAME FullPriceList-Rubl .
     1378                                       else
     1379                                           UNDERLINE stream PL gds-list.gds-name
     1380                                               with FRAME FullPriceList-Val .
     1381                               end.
     1382                           if OnlyPrices then
     1383                               if P_Type = 2 then
     1384                               do:
     1385                                   DISPLAY stream PL
     1386                                       sym1 trim( string( bar-code.b-code ) ) @ tb-code
     1387                                       sym2 gds-list.artic
     1388                                       sym3 tr @ gds-list.gds-name
     1389                                       sym4 clients.obj-name
     1390                                       sym5 gds-list.unit-base @ t_unit-name
     1391                                       sym6
     1392                                       (if price = 0 or price = ? then "        ----" else string(price, ">>>>>9.99" ) ) format "x(9)" @ price
     1393                                       sym7 with FRAME ReducedPriceList-Rubl .
     1394                                   DOWN    stream PL   1   with FRAME ReducedPriceList-Rubl .
     1395                               end.
     1396                               else
     1397                               do:
     1398                                   DISPLAY stream PL
     1399                                       sym1 trim( string( bar-code.b-code ) ) @ tb-code
     1400                                       sym2 gds-list.artic
     1401                                       sym3 tr @ gds-list.gds-name
     1402                                       sym4 clients.obj-name
     1403                                       sym5 gds-list.unit-base @ t_unit-name
     1404                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>>>9.99" ) ) format "x(12)" @ price
     1405                                       sym7 with FRAME ReducedPriceList-Val .
     1406                                   DOWN    stream PL   1   with FRAME ReducedPriceList-Val .
     1407                               end.
     1408                           else
     1409                               if P_Type = 2 then
     1410                               do:
     1411                                   DISPLAY stream PL
     1412                                       sym1 trim( string( bar-code.b-code ) ) @ tb-code
     1413                                       sym2 gds-list.artic
     1414                                       sym3 tr @ gds-list.gds-name
     1415                                       sym4 clients.obj-name
     1416                                       sym5 gds-list.unit-base @ t_unit-name
     1417                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>9.99" ) ) format "x(9)" @ price
     1418                                       sym7 qnty   when qnty <> 0
     1419                                       sym8 WaitQnty   when WaitQnty <> 0
     1420                                       sym9
     1421                                       with FRAME FullPriceList-Rubl .
     1422                                   DOWN    stream PL   1 with FRAME FullPriceList-Rubl .
     1423                               end.
     1424                               else
     1425                               do:
     1426                                   DISPLAY stream PL
     1427                                       sym1 trim( string( bar-code.b-code ) ) @ tb-code
     1428                                       sym2 gds-list.artic
     1429                                       sym3 tr @ gds-list.gds-name
     1430                                       sym4 clients.obj-name
     1431                                       sym5 gds-list.unit-base @ t_unit-name
     1432                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>>>9.99" ) ) format "x(12)" @ price
     1433                                       sym7 qnty   when qnty <> 0
     1434                                       sym8 WaitQnty   when WaitQnty <> 0
     1435                                       sym9
     1436                                       with FRAME FullPriceList-Val .
     1437                                   DOWN    stream PL   1 with FRAME FullPriceList-Val .
     1438                               end.
     1439                           if ( t_grp-name <> gds-list.grp-name ) AND
     1440                              lookup( "По группам товаров ( и артикулу )", SortType ) > 0 then
     1441                               do:
     1442                                   CurrItem = "" .
     1443                                   DO i = 1 to num-entries( gds-list.grp-name, chr(47) ) :
     1444                                       CurrItem = entry( i, t_grp-name , chr(47) ) NO-ERROR .
     1445                                       if ( error-status:error ) OR
     1446                                          ( CurrItem <> entry( i, gds-list.grp-name, chr(47) ) ) then
     1447                                           do:
     1448                                               DISPLAY stream Title_
     1449                                                       string( fill( " " , i * 10 ) + string( if i = 1 then "  " else "\ " ) +
     1450                                                           entry( i, gds-list.grp-name, chr(47) ) + " " +
     1451                                                           fill( "." , 120 - ( i * 10 ) - 5 -
     1452                                                           length( entry( i, gds-list.grp-name, chr(47) ) ) ) ) @ AA
     1453                                                       PAGE-NUMBER( PL )  @ JJ
     1454                                                       with frame PL-Title .
     1455                                               DOWN stream Title_ 1 with FRAME PL-Title .
     1456                                           end.
     1457                                   END .
     1458                                   t_grp-name = gds-list.grp-name .
     1459                               end.
     1460                       end.
     1461               end.
     1462           if NOT No-Prt then
     1463               RUN prtprice( tr, b-gds-prt.node-code, goods.gds-code, goods.unit-base).
     1464       END.
     1465   END PROCEDURE .
     1466   PROCEDURE price-qnty :
     1467   def input parameter node like gds-prt.node-code .
     1468   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1469   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     1470   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     1471   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     1472   define variable gp-excise     like ub.price-list.excise     no-undo.
     1473   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     1474   define variable gp-fact-order as decimal   no-undo .
     1475   define variable gp-price-sale-parts as decimal   no-undo .
     1476   define variable v-rb-is-base            as logical      no-undo.
     1477   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1478   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
     1479     (output v-rb-is-base
     1480     )  .
     1481   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1482   gp-fact-order = 0 .
     1483   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1484     (input  gds-list.gds-code
     1485     ,input  node
     1486     ,output gp-b-code
     1487     ) no-error .
     1488   if error-status:error then do:
     1489     message
     1490       error-status :get-message(1) skip
     1491       return-value skip
     1492       view-as alert-box error .
     1493     return error.
     1494   end.
     1495   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1496   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1497     (input  p-store-type
     1498     ,input  p-store-code
     1499     ,input  gp-b-code
     1500     ,input  0
     1501     ,input  gp-fact-order
     1502     ,output gp-doc-num
     1503     ,output gp-price-sale
     1504     ,output gp-road-tax
     1505     ,output gp-excise
     1506     ) no-error .
     1507   if error-status:error then do:
     1508     return error.
     1509   end.
     1510   gp-price-sale-parts = gp-price-sale.
     1511   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_avprpart in g#lib-trn3
     1513     (input  p-store-type
     1514     ,input  p-store-code
     1515     ,input  gp-b-code
     1516     ,input  0
     1517     ,input  gp-fact-order
     1518     ,output gp-doc-num
     1519     ,output gp-price-sale-parts
     1520     ,output gp-road-tax
     1521     ,output gp-excise
     1522     ) no-error .
     1523   if error-status:error then do:
     1524     return error.
     1525   end.
     1526   if gp-price-sale-parts <> 0 and gp-price-sale-parts <> ? then do:
     1527       gp-price-sale = gp-price-sale-parts.
     1528    end.
     1529       if gp-price-sale <> ? then
     1530           do:
     1531               if v-rb-is-base = yes
     1532               then do:
     1533                   assign price = ( if P_Type = 2
     1534                                       then (gp-price-sale * Rubl_Coeff )    else gp-price-sale ) .
     1535               end.
     1536               else do:
     1537                   assign price = ( if P_Type = 2
     1538                                      then gp-price-sale else ( gp-price-sale / Rubl_Coeff ) ) .
     1539               end.
     1540          end.
     1541       else
     1542           price = 0 .
     1543       FIND first prt-obj where prt-obj.obj-type = p-store-type
     1544                          and prt-obj.obj-code = p-store-code
     1545                          and prt-obj.prod-type = gds-list.prod-type
     1546                          and prt-obj.prod-code = gds-list.prod-code
     1547                          and prt-obj.artic = gds-list.artic
     1548                          and prt-obj.prt-code = node
     1549                          use-index pi NO-LOCK NO-ERROR .
     1550       if available prt-obj then
     1551           do:
     1552               assign
     1553                   qnty = prt-obj.free-qnty
     1554                   WaitQnty = 0 .
     1555           end.
     1556       else
     1557           assign
     1558               qnty = 0
     1559               WaitQnty = 0 .
     1560   END PROCEDURE .
