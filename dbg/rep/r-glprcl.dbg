     1143   if not Log-Res then
     1144       return "NO".
     1145   if session :set-wait-state( "compiler" ) then.
     1146   if i = 0 OR P_Type = 0 then
     1147       return.
     1148   if session :set-wait-state( "compiler" ) then.
     1149   Line = fill("-", 232).
     1150   OnlyPrices = ( if i = 1 then no else yes ) .
     1151   if ( v-rb-is-base = yes
     1152       and P_Type = 2 )
     1153   or ( v-rb-is-base <> yes
     1154       and P_Type = 1 )
     1155   then do:
     1156      run proc-cur-rate( input p-store-type, input p-store-code, output Rubl_Coeff ).
     1157   end.
     1158   FIND clients where p-store-type = clients.obj-type
     1159                         and p-store-code = clients.obj-code no-lock no-error.
     1160   ObjName = clients.obj-name .
     1161   if session :set-wait-state( "compiler" ) then.
     1162   output stream PL to value( string( session:temp-directory +
     1163                                    "rpt" + string( g#report-num ) ) ) page-size value(ReportPageHeight).
     1164   output stream Title_ to value( string( session:temp-directory +
     1165                                    "plt" + string( g#report-num ) ) ) page-size value(ReportPageHeight) .
     1166   FORM HEADER
     1167           Line format "x(136)" AT 1 SKIP
     1168       with FRAME BottomFrame width 160 PAGE-BOTTOM no-labels no-box.
     1169   VIEW stream PL      FRAME BottomFrame .
     1170   if SortType = "По группам товаров ( и артикулу )" then
     1171       do:
     1172           FORM HEADER
     1173               string( "Дата печати : " + string( TODAY , "99.99.9999" ) + ", " +
     1174                   string(TIME, "HH:MM") )    AT 10 format "X(50)"
     1175                   "Страница " AT 100 PAGE-NUMBER( Title_ )  FORMAT ">>>>9" SKIP(2)
     1176               ObjName AT 55 format "X(50)" SKIP(2)
     1177               "О Г Л А В Л Е Н И Е"  AT 50 SKIP(3)
     1178               with FRAME TopFrame width 160 PAGE-TOP no-labels no-box.
     1179           VIEW stream Title_  FRAME TopFrame .
     1180       end.
     1181   PUT stream Title_ string( "Дата печати : " + string( TODAY , "99.99.9999" ) + ", " +
     1182               string(TIME, "HH:MM") )    AT 10 format "X(50)" SKIP(2)
     1183               ObjName AT 55 format "X(50)" SKIP(2)
     1184               "П Р А Й С - Л И С Т" format "X(30)" AT 50 SKIP(3) .
     1185   t_grp-name = "" .
     1186   CASE SortType :
     1187       when "По наименованию"
     1188       then do:
     1189           FOR EACH gds-list no-lock
     1190           BREAK BY gds-list.gds-name :
     1191               FIND goods WHERE goods.prod-type = gds-list.prod-type
     1192                                                 AND goods.prod-code = gds-list.prod-code
     1193                                                 AND goods.artic = gds-list.artic NO-LOCK.
     1194               FIND clients WHERE clients.obj-type = gds-list.prod-type
     1195                                                  AND clients.obj-code = gds-list.prod-code NO-LOCK .
     1196               RUN prtprice( gds-list.gds-name, gds-list.prt-root , goods.gds-code, goods.unit-base) .
     1197               ACCUMULATE gds-list.artic (COUNT) .
     1198           END.
     1199       end.
     1200   END CASE .
     1201   HIDE stream PL FRAME BottomFrame .
     1202   PUT stream PL Line format "x(136)" SKIP .
     1203   output stream Title_ CLOSE .
     1204   output stream PL CLOSE .
     1205   if session :set-wait-state( "" ) then.
