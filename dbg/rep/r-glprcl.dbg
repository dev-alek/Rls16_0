      408   procedure create_obj-list :
      409      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      410      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      411      do
      412      on error undo, return error return-value
      413      :
      414         define buffer cli-obj for ub.clients .
      415         define variable p-var as integer no-undo .
      416         define buffer buf_obj-list for obj-list .
      417         find last buf_obj-list  use-index pi no-error .
      418         if available buf_obj-list
      419         then
      420            p-var = buf_obj-list.obj-id + 1.
      421         else
      422            p-var = 1.
      423         find first cli-obj where
      424                   cli-obj.obj-type = p-obj-type
      425               and cli-obj.obj-code = p-obj-code
      426         no-lock no-error.
      427         if available cli-obj
      428         then do:
      429            create buf_obj-list.
      430            assign
      431               buf_obj-list.obj-id   = p-var
      432               buf_obj-list.obj-code = cli-obj.obj-code
      433               buf_obj-list.obj-type = cli-obj.obj-type
      434               buf_obj-list.obj-name = cli-obj.obj-name
      435               buf_obj-list.db-num   = cli-obj.db-num
      436            .
      437         end.
      438      end.
      439   end.
