      894   define variable v-inform-launched as logical no-undo initial false .
      895   procedure proc-alt-shift-f4:
      896     define variable v-action as character no-undo .
      897     if v-inform-launched = false then do:
      898       assign
      899         v-inform-launched = true
      900       .
      901       run gbl/d-inform.w
      902         (  input self
      903         ,  input this-procedure
      904         , output v-action
      905         ) no-error .
      906       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      907       assign
      908         v-inform-launched = false
      909       .
      910     end.
      911   end.
