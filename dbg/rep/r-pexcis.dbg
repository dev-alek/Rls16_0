      220   procedure prn-lib-reportviewer :
      221     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      222     define input parameter p-report-name-html as character no-undo .
      223     define input parameter p-param        as character no-undo .
      224     define variable v-excel           as character no-undo init 'TRUE' .
      225     define variable v-value-character as character no-undo .
      226     define variable v-value-integer   as character no-undo .
      227     define variable v-value-date      as date      no-undo .
      228     define variable v-value-decimal   as decimal   no-undo .
      229     define variable rep-excel         as logical   no-undo .
      230     define variable excel-string      as character no-undo .
      231     define variable v-param-type      as character no-undo .
      232     define variable v-tth             as handle    no-undo .
      233     run adm/shattri.p (
      234       input "get":U
      235       ,input  ""
      236       ,input  0
      237       ,input  'report-glob':U
      238       ,input  'rep-excel':U
      239       ,output v-value-character
      240       ,output v-value-date
      241       ,output v-value-decimal
      242       ,output v-value-integer
      243       ,output rep-excel
      244       ,output v-param-type
      245       ,INPUT-OUTPUT table-handle v-tth
      246       )  .
      247     if rep-excel then v-excel = "TRUE" .
      248     else v-excel = "FALSE" .
