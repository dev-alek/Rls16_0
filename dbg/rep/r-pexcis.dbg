      758   define  new shared  temp-table gds-list-hist no-undo
      759   field list-table as character
      760   field id as integer
      761   field line as integer
      762   field hist-mode as character
      763   field des as character
      764   field num-recs as integer
      765   field option_ as character
      766   field item_ as character
      767   field status_ as character
