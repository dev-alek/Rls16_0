      775   line
      776   index isdone
      777   done
      778   .
      779   define temp-table temp-parts no-undo
      780       field artic                   like ub.parts.artic
      781       field prod-type               like ub.parts.prod-type
      782       field prod-code               like ub.parts.prod-code
