      830       ,output v-last-date
      831       ).
      832     run fill-temp-parts in this-procedure .
      833     def var v-ind         as integer   no-undo .
      834     def var v-line        as character no-undo format "X(136)" .
      835     assign
      836       v-line = fill("-", 136 )
      837     .
      838     def var v-line1        as character no-undo format "X(136)" .
      839     def var v-line2        as character no-undo format "X(136)" .
      840     def var v-line3        as character no-undo format "X(136)" .
      841     assign
      842       v-line1 = v-line
      843       v-line2 = v-line
      844       v-line3 = v-line
      845     .
      846     def var sym1          as character no-undo format "x(1)":u label '!':u init ":":u .
      847     def var sym2          as character no-undo format "x(1)":u label '!':u init ":":u .
      848     def var sym3          as character no-undo format "x(1)":u label '!':u init ":":u .
      849     def var sym4          as character no-undo format "x(1)":u label '!':u init ":":u .
      850     def var sym5          as character no-undo format "x(1)":u label '!':u init ":":u .
      851     def var sym6          as character no-undo format "x(1)":u label '!':u init ":":u .
      852     def var sym7          as character no-undo format "x(1)":u label '!':u init ":":u .
      853     def var sym8          as character no-undo format "x(1)":u label '!':u init ":":u .
      854     def var sym9          as character no-undo format "x(1)":u label '!':u init ":":u .
      855     def var sym10         as character no-undo format "x(1)":u label '!':u init ":":u .
      856     def var sym11         as character no-undo format "x(1)":u label '!':u init ":":u .
      857     def var sym12         as character no-undo format "x(1)":u label '!':u init ":":u .
      858     def var sym13         as character no-undo format "x(1)":u label '!':u init ":":u .
      859     def var sym14         as character no-undo format "x(1)":u label '!':u init ":":u .
      860     def var sym15         as character no-undo format "x(1)":u label '!':u init ":":u .
      861     run waitfram-show in this-procedure
      862       (input 'Подождите ...'
      863       ) .
      864     run prn-lib-open-stream  in this-procedure (
      865                                                input parParentProc
      866                                               ,input 62
      867                                               ,input yes
      868                                               ,input no
      869                                               ).
      870     find first clients no-lock
      871       where clients.obj-type = p-curr-obj-type
      872         and clients.obj-code = p-curr-obj-code
      873       .
      874     def var v-header-name as character no-undo .
      875     def var v-print-time  as character no-undo .
      876     assign
      877       v-header-name = "РАСЧЕТ АКЦИЗА - основан на алгоритме FIFO"
      878       v-print-time  = cur-time-string()
      879     .
      880     form header
      881       v-line1 at 1 skip
      882       v-header-name + ": " + v-month-name + " " + string(v-year) format "x(50)" at 1
      883         "Дата печати :" at 60
      884         v-print-time format "x(20)"
      885         "Стр." at 111 string( page-number(PrnLibStream), ">>>9" )  skip
      886       "ОБЪЕКТ:" at 1 clients.obj-type + " " + string(clients.obj-code) format "x(15)"
      887       clients.obj-name skip
      888       v-line2 at 1 skip
      889       with frame topframe
      890       width 160 page-top no-labels no-box .
      891     view stream PrnLibStream frame topframe .
      892     form header
      893       v-line at 1 skip
      894       "Продолжение на следующей странице" at 30 skip
      895       with frame bottomframe
      896       width 160 page-bottom no-labels no-box .
      897     view stream PrnLibStream frame bottomframe .
      898     def var v-decrement-sell-qnty like ub.parts.fact-qnty no-undo .
      899     define frame excise-frm
      900       goods.gds-name                     format "x(40)" column-label "ПРИХОД"
      901       temp-parts.fact-date               column-label "ДАТА ПРИХОДА"
      902       temp-parts.this-month-kg-sell-qnty column-label "КОЛ-ВО (КГ)"
      903       temp-parts.density                 column-label "ПЛ-ТЬ"
      904       temp-parts.this-month-sell-qnty    column-label "КОЛ-ВО"
      905       units.long-name                    format "x(20)" column-label "ЕД.ИЗМ."
      906       v-decrement-sell-qnty              column-label ""
      907       with width 160 down stream-io use-text .
      908     form with frame excise-frm .
      909     for each gds-list no-lock
      910     ,first goods no-lock
      911       where goods.artic     = gds-list.artic
      912         and goods.prod-type = gds-list.prod-type
      913         and goods.prod-code = gds-list.prod-code
      914     :
      915       find first units no-lock
      916         where units.unit-name = goods.unit-base
      917         .
      918       assign
      919         v-ind = v-ind + 1
      920       .
      921       process events .
      922       run waitfram-show in this-procedure
      923         (input "Печать отчета. Обработано линий: " + string(v-ind)
      924         ) .
      925       def var v-total-month-sell-qnty    like ub.parts.fact-qnty .
      926       def var v-total-month-kg-sell-qnty as decimal no-undo .
      927       def var v-total-month-excise-qnty  as decimal no-undo .
      928       assign
      929         v-total-month-sell-qnty    = 0
      930         v-total-month-excise-qnty  = 0
      931         v-total-month-kg-sell-qnty = 0
      932       .
      933       for each temp-parts no-lock
      934         where temp-parts.artic                = goods.artic
      935           and temp-parts.prod-type            = goods.prod-type
      936           and temp-parts.prod-code            = goods.prod-code
      937       :
      938         assign
      939           v-total-month-sell-qnty    = v-total-month-sell-qnty
      940                                      + temp-parts.this-month-sell-qnty
      941           v-total-month-excise-qnty  = v-total-month-excise-qnty
      942                                      + temp-parts.this-month-excise
      943           v-total-month-kg-sell-qnty = v-total-month-kg-sell-qnty
      944                                      + temp-parts.this-month-kg-sell-qnty
      945         .
      946         assign
      947           temp-parts.free-qnty       = temp-parts.income-qnty
      948                                      - ( temp-parts.before-sell-qnty
      949                                        + temp-parts.this-month-sell-qnty
      950                                        )
      951         .
      952       end.
      953       run on-same-page in this-procedure (input 3) .
      954       put stream PrnLibStream
      955         goods.gds-name at 1 skip
      956         .
      957       put stream PrnLibStream
      958         "КОЛИЧЕСТВО "
      959         fill("-", 89) + ">" format "x(90)"
      960         v-total-month-sell-qnty  skip
      961         .
      962       assign
      963         v-decrement-sell-qnty = v-total-month-sell-qnty
      964       .
      965       for each temp-parts no-lock
      966         where temp-parts.artic                = goods.artic
      967           and temp-parts.prod-type            = goods.prod-type
      968           and temp-parts.prod-code            = goods.prod-code
      969           and temp-parts.this-month-sell-qnty > 0
      970       :
      971         assign
      972           v-decrement-sell-qnty = v-decrement-sell-qnty
      973                                 - temp-parts.this-month-sell-qnty
      974         .
      975         display stream PrnLibStream
      976           "ПРИХОД " + temp-parts.in-code +
      977             (if temp-parts.free-qnty > 0 then ".1" else "") @ goods.gds-name
      978           temp-parts.fact-date
      979           temp-parts.this-month-kg-sell-qnty
      980           temp-parts.density
      981           temp-parts.this-month-sell-qnty
      982           units.long-name
      983           v-decrement-sell-qnty
      984           with frame excise-frm .
      985         down stream PrnLibStream 1 with frame excise-frm .
      986       end.
      987       if v-total-month-kg-sell-qnty <> 0
      988       or v-total-month-sell-qnty    <> 0 then do:
      989         run on-same-page in this-procedure (input 3) .
      990         put stream PrnLibStream
      991           v-line  skip
      992           .
      993         display stream PrnLibStream
      994           "ПРОДАЖИ ЗА МЕСЯЦ"           @ goods.gds-name
      995           v-total-month-kg-sell-qnty @ temp-parts.this-month-kg-sell-qnty
      996           v-total-month-sell-qnty    @ temp-parts.this-month-sell-qnty
      997           units.long-name
      998           with frame excise-frm .
      999         down stream PrnLibStream 1 with frame excise-frm .
     1000         put stream PrnLibStream
     1001           v-line  skip
     1002           .
     1003       end.
     1004       for each temp-parts no-lock
     1005         where temp-parts.artic     = goods.artic
     1006           and temp-parts.prod-type = goods.prod-type
     1007           and temp-parts.prod-code = goods.prod-code
     1008           and temp-parts.free-qnty > 0
     1009       :
     1010         display stream PrnLibStream
     1011           "ПРИХОД " + temp-parts.in-code +
     1012             (if temp-parts.free-qnty > 0 then ".2" else "") @ goods.gds-name
     1013           temp-parts.fact-date
     1014           (temp-parts.free-qnty / temp-parts.cli-base-rate ) @ temp-parts.this-month-kg-sell-qnty
     1015           temp-parts.density
     1016           temp-parts.free-qnty @ temp-parts.this-month-sell-qnty
     1017           units.long-name
     1018           with frame excise-frm .
     1019         down stream PrnLibStream 1 with frame excise-frm .
     1020       end.
     1021       if v-total-month-kg-sell-qnty <> 0
     1022       or v-total-month-sell-qnty    <> 0 then do:
     1023         run on-same-page in this-procedure (input 6) .
     1024         put stream PrnLibStream
     1025           v-line skip
     1026           goods.gds-name at 1 skip
     1027           .
     1028         put stream PrnLibStream
     1029           "Итог"      at 1
     1030             units.long-name format "x(20)" at 40
     1031             "Кг"            at 70
     1032             "Тонны"         at 90
     1033           skip
     1034           "продано за месяц"       at 1
     1035             v-total-month-sell-qnty             at 40
     1036             v-total-month-kg-sell-qnty          at 70
     1037             (v-total-month-kg-sell-qnty / 1000) format "->>>,>>>,>>9.999999" at 90
     1038           skip
     1039           "акциз за месяц на тонну" at 1
     1040             ( v-total-month-excise-qnty * 1000
     1041             / v-total-month-kg-sell-qnty ) format "->>>,>>>,>>9.999999" at 90
     1042           skip
     1043           "акциз к оплате" at 1
     1044             v-total-month-excise-qnty format "->>>,>>>,>>9.99" at 90
     1045           skip
     1046           .
     1047       end.
     1048       put stream PrnLibStream
     1049         SKIP(2)
     1050         .
     1051     end.
     1052     hide frame input-frm .
     1053     run on-same-page in this-procedure (input 2) .
     1054     put stream PrnLibStream
     1055       v-line  skip
     1056       space(10) "Всего страниц в отчете" page-number(PrnLibStream) skip
     1057       .
     1058     hide stream PrnLibStream frame bottomframe .
     1059     output stream PrnLibStream close.
     1060     run waitfram-hide in this-procedure .
     1061     run prn-lib-prn-file in this-procedure (
     1062                                             input parParentProc
     1063                                             ,input 0
     1064                                             ).
     1065   end.
     1066   procedure on-same-page :
     1067     define input parameter p-line-number as integer no-undo .
     1068     if p-line-number > page-size( PrnLibStream ) then do:
     1069       return .
     1070     end.
     1071     if line-counter( PrnLibStream ) + p-line-number > page-size( PrnLibStream ) then do:
     1072       page stream PrnLibStream .
     1073     end.
     1074   end procedure.
     1075   procedure next-page :
     1076     page stream PrnLibStream .
     1077   end procedure.
     1078   procedure fill-temp-parts :
     1079     run waitfram-show in this-procedure
     1080       (input "Сбор данных..."
     1081       ) .
     1082     def var v-lookup-ind as integer no-undo .
     1083     for each gds-list no-lock
     1084     ,first goods no-lock
     1085       where goods.artic     = gds-list.artic
     1086         and goods.prod-type = gds-list.prod-type
     1087         and goods.prod-code = gds-list.prod-code
     1088     :
     1089       find first units no-lock
     1090         where units.unit-name = goods.unit-base
     1091         .
     1092       assign
     1093         v-lookup-ind = v-lookup-ind + 1
     1094       .
     1095       run waitfram-show in this-procedure
     1096         (input "Сбор данных. Обработано строк: " + string(v-lookup-ind)
     1097         ) .
     1098       for each doc-line no-lock
     1099         where doc-line.obj-type  = p-curr-obj-type
     1100           and doc-line.obj-code  = p-curr-obj-code
     1101           and doc-line.artic     = goods.artic
     1102           and doc-line.prod-type = goods.prod-type
     1103           and doc-line.prod-code = goods.prod-code
     1104           and doc-line.status_   = 'факт':U
     1105       , first trn-doc no-lock
     1106         where trn-doc.doc-code = doc-line.doc-code
     1107           and trn-doc.doc-type = 'рас':U
     1108           and trn-doc.internal = false
     1109           and trn-doc.fact-date >= v-first-date
     1110           and trn-doc.fact-date <= v-last-date
     1111       :
     1112         for each parts no-lock
     1113           where parts.out-code  = doc-line.doc-code
     1114             and parts.obj-type  = doc-line.obj-type
     1115             and parts.obj-code  = doc-line.obj-code
     1116             and parts.artic     = doc-line.artic
     1117             and parts.prod-type = doc-line.prod-type
     1118             and parts.prod-code = doc-line.prod-code
     1119         :
     1120           run create-temp-parts
     1121             (buffer temp-parts
     1122             ,buffer parts
     1123             ).
     1124           assign
     1125             temp-parts.this-month-sell-qnty    = temp-parts.this-month-sell-qnty
     1126                                                + parts.fact-qnty
     1127             temp-parts.this-month-kg-sell-qnty = temp-parts.this-month-sell-qnty
     1128                                                / temp-parts.cli-base-rate
     1129             temp-parts.density                 = 1 / temp-parts.cli-base-rate
     1130             temp-parts.this-month-excise       = temp-parts.this-month-excise
     1131                                                + parts.fact-qnty * doc-line.excise
     1132           .
     1133         end.
     1134       end.
     1135     end.
     1136     run waitfram-hide in this-procedure .
     1137   end procedure.
     1138   procedure create-temp-parts :
     1139     define parameter buffer buf_temp-parts for temp-parts .
     1140     define parameter buffer buf_parts      for parts .
     1141     find first buf_temp-parts no-lock
     1142       where buf_temp-parts.artic     = buf_parts.artic
     1143         and buf_temp-parts.prod-type = buf_parts.prod-type
     1144         and buf_temp-parts.prod-code = buf_parts.prod-code
     1145         and buf_temp-parts.in-code   = buf_parts.in-code
     1146         and buf_temp-parts.part-code = buf_parts.part-code
     1147       no-error .
     1148     if not available buf_temp-parts then do:
     1149       create buf_temp-parts .
     1150       assign
     1151         buf_temp-parts.artic     = buf_parts.artic
     1152         buf_temp-parts.prod-type = buf_parts.prod-type
     1153         buf_temp-parts.prod-code = buf_parts.prod-code
     1154         buf_temp-parts.in-code   = buf_parts.in-code
     1155         buf_temp-parts.part-code = buf_parts.part-code
     1156       .
     1157       assign
     1158         buf_temp-parts.cli-base-rate = buf_parts.cli-base-rate
     1159       .
     1160       define buffer buf_income-trn-doc for ub.trn-doc .
     1161       find first buf_income-trn-doc no-lock
     1162         where buf_income-trn-doc.doc-code = buf_parts.in-code
     1163         no-error .
     1164       if  available buf_income-trn-doc
     1165       and buf_income-trn-doc.doc-type = 'при':U
     1166       and buf_income-trn-doc.internal = false
     1167       then do:
     1168         define buffer buf_income-parts for ub.parts .
     1169         find first buf_income-parts no-lock
     1170           where buf_income-parts.obj-type  = buf_income-trn-doc.obj-type
     1171             and buf_income-parts.obj-code  = buf_income-trn-doc.obj-code
     1172             and buf_income-parts.artic     = buf_parts.artic
     1173             and buf_income-parts.prod-type = buf_parts.prod-type
     1174             and buf_income-parts.prod-code = buf_parts.prod-code
     1175             and buf_income-parts.in-code   = buf_income-trn-doc.doc-code
     1176             and buf_income-parts.out-code  = buf_income-trn-doc.doc-code
     1177             and buf_income-parts.part-code = buf_parts.part-code
     1178           no-error .
     1179         if available buf_income-parts then do:
     1180           assign
     1181             buf_temp-parts.income-qnty = buf_income-parts.fact-qnty
     1182             buf_temp-parts.fact-date   = buf_income-parts.fact-date
     1183           .
     1184         end.
     1185       end.
     1186       define buffer buf_sell-trn-doc for ub.trn-doc .
     1187       define buffer buf_sell-parts   for ub.parts .
     1188       for each buf_sell-parts no-lock
     1189         where buf_sell-parts.artic      = buf_parts.artic
     1190           and buf_sell-parts.prod-type  = buf_parts.prod-type
     1191           and buf_sell-parts.prod-code  = buf_parts.prod-code
     1192           and buf_sell-parts.in-code    = buf_parts.in-code
     1193           and buf_sell-parts.part-code  = buf_parts.part-code
     1194           and buf_sell-parts.status_    = yes
     1195           and buf_sell-parts.rsrv-free  = ?
     1196           and buf_sell-parts.fact-date  < v-first-date
     1197       ,first buf_sell-trn-doc no-lock
     1198         where buf_sell-trn-doc.doc-code = buf_sell-parts.out-code
     1199           and buf_sell-trn-doc.status_  = 'факт':U
     1200           and trn-doc.doc-type          = 'рас':U
     1201           and trn-doc.internal          = false
     1202       :
     1203         assign
     1204           buf_temp-parts.before-sell-qnty = buf_temp-parts.before-sell-qnty
     1205                                           + buf_sell-parts.fact-qnty
     1206         .
     1207       end.
     1208     end.
     1209   end procedure.
