     3361   procedure display-b1  :
     3362   define variable ll as int no-undo.
     3363   define variable kk as int no-undo.
     3364     b1-null-str# = 1.
     3365     b1-null-str2# = 1.
     3366     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3367     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3368      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3369         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3370                 if sums-only then do:
     3371                     if fr0 = true then do:
     3372                           num#str# = num#str# + 1     .
     3373                           num#col# = 1.
     3374                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3375                           run macr_cell_format
     3376                           ( 10    ,
     3377                             true  ,
     3378                             true  ,
     3379                             36    ,
     3380                             num#str# ,
     3381                             num#col# ,
     3382                             num#str# ,
     3383                             5 ) .
     3384                         fr0 = false .
     3385                       end.
     3386                  end.
     3387     num#str# = num#str# + 1     .
     3388     num#col# = 2 .
     3389     if substitute( "&1", sf1:screen-value )  <> "?" then
     3390       run macr_excel_char_with_format(  string(s-bar-code +
     3391                                    sf1:screen-value +
     3392                                    gds-zap-artic +
     3393                                    sf2:screen-value +
     3394                                    gds-zap-gds-name +
     3395                                    temp-str-2    )  , num#str# , num#col#  ) .
     3396      else
