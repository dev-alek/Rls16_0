     3297       else do:
     3298         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bo-oborot-ee         [1] +
     3299                                                                                                                                       bo-oborot-re     [1] +
     3300                                                                                                                                       bo-oborot-es    [1] +
     3301                                                                                                                                       bo-oborot-rs[1] ) <> 0
     3302                                                                                                                               then
     3303                                                                                                                                   ABS(bo-oborot-ee         [11] +
     3304                                                                                                                                       bo-oborot-re     [11] +
     3305                                                                                                                                       bo-oborot-es    [11] +
     3306                                                                                                                                       bo-oborot-rs[11] )
     3307                                                                                                                                   /
     3308                                                                                                                                   ABS(bo-oborot-ee         [1] +
     3309                                                                                                                                       bo-oborot-re     [1] +
     3310                                                                                                                                       bo-oborot-es    [1] +
     3311                                                                                                                                       bo-oborot-rs[1] )
     3312                                                                                                                               else 0 )
     3313         ,  i). end.
     3314       end.
     3315     end.
     3316     else do:
     3317     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bo-oborot-ee         [i] +
     3318                                                                                                                           bo-oborot-re     [i] +
     3319                                                                                                                           bo-oborot-es    [i] +
     3320                                                                                                                           bo-oborot-rs[i] )
     3321     ,  i). end.
     3322     end.
     3323     end.
