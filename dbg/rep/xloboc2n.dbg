     3548     if not show-negativ-2 then  run b2-null-str-pr2  in this-procedure .
     3549      if not  (not show-negativ   and b2-null-str#  = 0  ) then do :
     3550         if not  (not show-negativ-2 and b2-null-str2# = 0  ) then do :
     3551   assign
     3552     num#str# = num#str# + 1
     3553     num#col# = 1.
     3554     run macr_excel_char_with_format( string( s-bar-code + ' ' + gds-zap-artic + ' ' + gds-zap-gds-name)  , num#str# , num#col#  ) .
     3555     num#col#  = 0 .
     3556     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3557     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3558     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3559     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3560     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3561     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3562   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3563   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3564   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b2-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
