     3325     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-start                          [i] -  bo-ostatok-start                          [3] ),  i). end.
     3326     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ie          [i] -  bo-oborot-ie          [3] ),  i). end.
