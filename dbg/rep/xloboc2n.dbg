     3149          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3150       end.
     3151       else do:
     3152         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bi-oborot-ee         [1] +
     3153                                                                                                                                       bi-oborot-re     [1] +
     3154                                                                                                                                       bi-oborot-es    [1] +
     3155                                                                                                                                       bi-oborot-rs[1] ) <> 0
     3156                                                                                                                               then
