     5119   procedure new-tmp-page :
     5120    do
     5121    on error undo, return error return-value
     5122    :
     5123       if   num#str#  >=  63000  then do:
     5124           output stream macr_excel  close .
     5125           run paramls-write in this-procedure
     5126             (input "file"
     5127             ,input string(v-ind)
     5128             ,input v-file-name
     5129             ) .
     5130           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5131           output stream  macr_excel to value(v-file-name) .
     5132           v-ind = v-ind + 1 .
     5133           num#str# = 0 .
     5134   define variable old-s as integer no-undo .
     5135   define variable old-s2 as integer no-undo .
     5136       assign
     5137       old-s =   num#str#
     5138       .
     5139       run make-col .
     5140       assign
     5141         old-s2 =   num#str#
     5142       .
     5143      num#str# = old-s + 1  .
     5144      run proc-print-header .
     5145      num#str# = old-s2     .
     5146       end.
     5147    end.
     5148   end procedure.
     5149   procedure pp :
     5150   define input parameter ll as integer no-undo .
     5151   define input parameter uu as integer no-undo .
     5152   define input parameter ff as character no-undo .
     5153   End procedure.
     5154   procedure find-last-prise-med :
     5155   define input parameter p-artic     like ub.goods.artic no-undo .
     5156   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5157   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5158   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5159   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5160   define buffer p-gds-obj   for  ub.gds-obj .
     5161   define buffer buf_trn-doc for  ub.trn-doc .
     5162   define variable v-fact-order as decimal no-undo .
     5163   p-price = 0 .
     5164     define variable v-in-date as date      no-undo .
     5165     define variable fl as logical no-undo .
     5166     fl = yes.
     5167     v-fact-order = 0 .
     5168     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5169     :
     5170       find first p-gds-obj no-lock
     5171         where p-gds-obj.artic     = p-artic         and
     5172                 p-gds-obj.prod-type = p-prod-type     and
     5173                 p-gds-obj.prod-code = p-prod-code     and
     5174                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5175                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5176         no-error .
     5177       if available p-gds-obj then do:
     5178       if p-gds-obj.in-date = ?  then next .
     5179       if fl = yes then do:
     5180         assign
     5181           v-in-date = p-gds-obj.in-date
     5182           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5183           fl = no
     5184       .
     5185        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5186        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5187       end.
     5188         if p-gds-obj.in-date >= v-in-date   then do:
     5189            if p-gds-obj.in-date = v-in-date then do:
     5190               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5191               if available buf_trn-doc  then
     5192                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5193                     assign
     5194                       v-fact-order = buf_trn-doc.fact-order
     5195                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5196                       v-in-date =   p-gds-obj.in-date
     5197                     .
     5198                   end.
     5199            end.
     5200            else do:
     5201             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5202             if available buf_trn-doc  then
     5203                 assign
     5204                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5205                   v-in-date =    p-gds-obj.in-date
     5206                   v-fact-order = buf_trn-doc.fact-order .
     5207                 .
     5208             end.
     5209           if p-price = ? then   p-price  = 0 .
     5210         end.
     5211       end.
     5212     End .
     5213     if p-price = ? then   p-price  = 0 .
     5214   end procedure.
     5215   procedure find-mediator :
     5216   define input  parameter c-host-code as integer no-undo .
     5217   define input  parameter p-Showmediatr as logical no-undo .
     5218   define output parameter p-host-code as integer no-undo .
     5219   define output parameter p-flag as logical no-undo .
     5220   define buffer b-sysconf  for ub.sysconf.
     5221    p-host-code = 0 .
     5222    p-flag  = true .
     5223       if p-Showmediatr = true then do:
     5224       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5225             if avail ub.sysconf then DO :
     5226               p-host-code = ub.sysconf.host-code.
     5227               if tPrintRubl = false then do:
     5228                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5229                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5230                                 p-flag  = false  .
     5231                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5232                                 view-as alert-box error.
     5233                           end.
     5234               end.
     5235             end.
     5236             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5237                 create tt-obj-list no-error .
     5238                 assign tt-obj-list.obj-type = 'маг':U
     5239                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5240             end.
     5241             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5242                 create tt-obj-list no-error .
     5243                 assign tt-obj-list.obj-type = 'скл':U
     5244                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5245             end.
     5246       End.
     5247    End procedure .
     5248   PROCEDURE ob-line-stk  :
     5249   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5250   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5251   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5252   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5253   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5254   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5255   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5256   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5257   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5258   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5259   define input  parameter xTog-obj         as log                     no-undo.
     5260   define input  parameter xi               as int                     no-undo.
     5261   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5262   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5263   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5264   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5265   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5266   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5267   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5268   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5269   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5270   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5271   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5272   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5273   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5274   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5275   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5276   define buffer stk-line2 for ub.stk-line .
     5277   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5278    Assign
     5279      First-qnty  = 0
     5280      Second-qnty = 0
     5281      Quntity     = 0
     5282      First-sum  = 0
     5283      Second-sum = 0
     5284      sum        = 0
     5285      First-vat  = 0
     5286      Second-vat = 0
     5287      vat        = 0
     5288      First-slt   = 0
     5289      Second-slt  = 0
     5290      slt         = 0
     5291      First-disc  = 0
     5292      Second-disc = 0
     5293      disc        = 0
     5294     .
     5295     For each obj-list  no-lock :
     5296      if  xTog-obj THEN
     5297          if   NOT(    x-store-type     = obj-list.obj-type
     5298               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5299      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5300         find last ub.stk-line no-lock
     5301           where ub.stk-line.obj-type   = obj-list.obj-type
     5302             and ub.stk-line.obj-code   = obj-list.obj-code
     5303             and ub.stk-line.artic      = x-artic
     5304             and ub.stk-line.prod-type  = x-prod-type
     5305             and ub.stk-line.prod-code  = x-prod-code
     5306             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5307             and ub.stk-line.cat-id     = '##,##':U
     5308             and ub.stk-line.fact-order <= x-fact-order-1
     5309           use-index category
     5310           no-error .
     5311         if available ub.stk-line then do:
     5312           assign
     5313             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5314             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5315             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5316             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5317             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5318           .
     5319         end.
     5320         find last stk-line2 no-lock
     5321           where stk-line2.obj-code   = obj-list.obj-code
     5322             and stk-line2.obj-type   = obj-list.obj-type
     5323             and stk-line2.artic      = x-artic
     5324             and stk-line2.prod-type  = x-prod-type
     5325             and stk-line2.prod-code  = x-prod-code
     5326             and stk-line2.sum-type   = temp#sum-type.sum-type
     5327             and stk-line2.cat-id     = '##,##':U
     5328             and stk-line2.fact-order <= x-fact-order-2
     5329           use-index category
     5330           no-error .
     5331         if available stk-line2 then do:
     5332           assign
     5333             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5334             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5335             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5336             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5337             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5338           .
     5339         end.
     5340      end.
     5341    end.
     5342    Assign
     5343      Quntity = Second-qnty - first-qnty
     5344      sum     = Second-sum  - first-sum
     5345      vat     = Second-vat  - first-vat
     5346      slt     = Second-slt  - first-slt
     5347      disc    = Second-disc  - first-disc
     5348      .
     5349   END PROCEDURE.
     5350   procedure calc-ms-wt :
     5351   define input        parameter p-oborot-num      as decimal   no-undo .
     5352   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5353   define input-output parameter p-oborot          as decimal   no-undo .
     5354   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5355   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5356   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5357   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5358   do
     5359   on error undo, return error return-value
     5360   :
     5361   if p-is-petrol = true then return .
     5362     assign
     5363       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5364       p-bi-oborot = p-bi-oborot + p-oborot
     5365       p-bo-oborot = p-bo-oborot + p-oborot
     5366       p-b1-oborot = p-b1-oborot + p-oborot
     5367       p-b2-oborot = p-b2-oborot + p-oborot
     5368     .
     5369   end.
     5370   end procedure.
     5371   procedure calc-dens :
     5372   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5373   define input        parameter p-ostatok          as decimal   no-undo .
     5374   define input-output parameter p-density          as decimal   no-undo .
     5375   define input-output parameter p-bi-density       as decimal   no-undo .
     5376   define input-output parameter p-bo-density       as decimal   no-undo .
     5377   define input-output parameter p-b1-density       as decimal   no-undo .
     5378   define input-output parameter p-b2-density       as decimal   no-undo .
     5379   do
     5380   on error undo, return error return-value
     5381   :
     5382   if p-is-petrol = false then return .
     5383     assign
     5384       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5385       p-bi-density = 0
     5386       p-bo-density = 0
     5387       p-b1-density = 0
     5388       p-b2-density = 0
     5389     .
     5390   end.
     5391   end procedure.
     5392   procedure calc-pt-ob :
     5393   define input  parameter p-ext-doc-type    as character no-undo .
     5394   define input  parameter x-store-type      as character no-undo .
     5395   define input  parameter x-store-code      as integer   no-undo .
     5396   define input  parameter p-artic           as character no-undo .
     5397   define input  parameter p-prod-type       as character no-undo .
     5398   define input  parameter p-prod-code       as integer   no-undo .
     5399   define input-output parameter p-oborot    as decimal   no-undo .
     5400   define input-output parameter p-bi-oborot as decimal   no-undo .
     5401   define input-output parameter p-bo-oborot as decimal   no-undo .
     5402   define input-output parameter p-b1-oborot as decimal   no-undo .
     5403   define input-output parameter p-b2-oborot as decimal   no-undo .
     5404     do
     5405     on error undo, return error return-value
     5406     :
     5407   define variable v-oborot as decimal   no-undo .
     5408   define buffer buf_doc-line  for ub.doc-line  .
     5409   define buffer buf_inv-line  for ub.inv-line  .
     5410   define buffer buf1_obj-list for obj-list .
     5411   assign
     5412     v-oborot = 0
     5413   .
     5414   if p-is-petrol = false   then return .
     5415     for each buf1_obj-list no-lock :
     5416      if  xtog-obj then
     5417          if   not(x-store-type     = buf1_obj-list.obj-type
     5418               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5419       for each buf_doc-line  no-lock where
     5420             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5421             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5422             buf_doc-line.artic        = p-artic and
     5423             buf_doc-line.prod-type    = p-prod-type and
     5424             buf_doc-line.prod-code    = p-prod-code and
     5425             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5426             buf_doc-line.status_      = 'факт':U        and
     5427             buf_doc-line.fact-order   <= fact-order-2  and
     5428             buf_doc-line.fact-order   >= fact-order-1
     5429             :
     5430             for each buf_inv-line  no-lock where
     5431                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5432                 buf_inv-line.artic        = buf_doc-line.artic and
     5433                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5434                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5435                 :
     5436                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5437                     else do:
     5438                     if p-ext-doc-type = 'we':U    or
     5439                        p-ext-doc-type = 'ee':U    or
     5440                        p-ext-doc-type = 'ev':U    or
     5441                        p-ext-doc-type = 'ep':U or
     5442                        p-ext-doc-type = 'em':U     or
     5443                        p-ext-doc-type = 'wm':U     or
     5444                        p-ext-doc-type = 'es':U   then
     5445                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5446                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5447                     end.
     5448             end.
     5449       end.
     5450   end.
     5451   assign
     5452     p-oborot    = v-oborot
     5453     p-bi-oborot = p-bi-oborot + v-oborot
     5454     p-bo-oborot = p-bo-oborot + v-oborot
     5455     p-b1-oborot = p-b1-oborot + v-oborot
     5456     p-b2-oborot = p-b2-oborot + v-oborot
     5457   .
     5458   end.
     5459   end procedure.
     5460   procedure calc-density :
     5461   define input        parameter p-ext-doc-type  as character no-undo .
     5462   define input        parameter x-store-type    as character no-undo .
     5463   define input        parameter x-store-code    as integer   no-undo .
     5464   define input        parameter p-artic         as character no-undo .
     5465   define input        parameter p-prod-type     as character no-undo .
     5466   define input        parameter p-prod-code     as integer   no-undo .
     5467   define input-output parameter p-density       as decimal   no-undo .
     5468   define input-output parameter p-bi-density    as decimal   no-undo .
     5469   define input-output parameter p-bo-density    as decimal   no-undo .
     5470   define input-output parameter p-b1-density    as decimal   no-undo .
     5471   define input-output parameter p-b2-density    as decimal   no-undo .
     5472     do
     5473     on error undo, return error return-value
     5474     :
     5475   define variable v-oborot    as decimal   no-undo .
     5476   define variable v-fact-qnty as decimal   no-undo .
     5477   define buffer buf_doc-line  for ub.doc-line  .
     5478   define buffer buf_inv-line  for ub.inv-line  .
     5479   define buffer buf1_obj-list for obj-list .
     5480   assign
     5481     v-oborot     = 0
     5482     v-fact-qnty  = 0
     5483   .
     5484   if p-is-petrol = false   then return .
     5485     for each buf1_obj-list no-lock :
     5486      if  xtog-obj then
     5487          if   not(x-store-type     = buf1_obj-list.obj-type
     5488               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5489       for each buf_doc-line  no-lock where
     5490             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5491             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5492             buf_doc-line.artic        = p-artic and
     5493             buf_doc-line.prod-type    = p-prod-type and
     5494             buf_doc-line.prod-code    = p-prod-code and
     5495             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5496             buf_doc-line.status_      = 'факт':U        and
     5497             buf_doc-line.fact-order   <= fact-order-2  and
     5498             buf_doc-line.fact-order   >= fact-order-1
     5499             :
     5500             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5501             for each buf_inv-line  no-lock where
     5502                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5503                 buf_inv-line.artic        = buf_doc-line.artic and
     5504                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5505                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5506                 :
     5507                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5508                     else do:
     5509                     if p-ext-doc-type = 'we':U    or
     5510                        p-ext-doc-type = 'ee':U    or
     5511                        p-ext-doc-type = 'ev':U    or
     5512                        p-ext-doc-type = 'ep':U or
     5513                        p-ext-doc-type = 'em':U     or
     5514                        p-ext-doc-type = 'wm':U     or
     5515                        p-ext-doc-type = 'es':U   then
     5516                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5517                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5518                     end.
     5519             end.
     5520       end.
     5521       assign
     5522         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5523       .
     5524       assign
     5525         p-bi-density = p-density
     5526         p-bo-density = 0
     5527         p-b1-density = 0
     5528         p-b2-density = 0
     5529       .
     5530   end.
     5531   end.
     5532   end procedure.
