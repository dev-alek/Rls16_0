     1848   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1849   define variable  str  as char format "X(60)"  no-undo.
     1850   define variable  str2 as char no-undo.
     1851   define variable v-r as character no-undo init "" .
     1852   define variable  i#i as int no-undo.
     1853   STR = "".
     1854   repeat i#i =1 to lavel#:
     1855       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1856       else do:
     1857           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1858           if not error-status:error  and str2 <> "":u then
     1859                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1860           end.
     1861   end.
     1862   if str <> ? then do:
     1863   v-r = str + chr(47) .
     1864   end.
     1865   RETURN v-r .
     1866   END FUNCTION.
     1867   procedure report-execute :
     1868     if (valtype=0 and x-base-code=0)  or valtype=1
     1869                                   then   assign tprintrubl = yes .
     1870                                   else   assign tprintrubl = no .
     1871       p-file-name =  string( session:temp-directory +
     1872                                     "rpt" + string( g#report-num ) + ".txt" ) .
     1873       output stream outstream to value( string( session:temp-directory +
     1874                                     "rpt" + string( g#report-num ) ) )      .
     1875       output stream outstream2 to value(p-file-name).
     1876       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1877       output stream macr_excel to value(v-file-name)   .
     1878                   put stream  outstream  "1" format "x(100)" skip .
     1879       v-ind = 1    .
     1880       num#str# = 0 .
     1881         num#str# = num#str# + 1 .
     1882         num#col# =  1 .
     1883         run macr_excel_char_with_format( reportname , num#str# , num#col#  ).
     1884         run macr_cell_format
     1885             ( 12    ,
     1886               true  ,
     1887               false ,
     1888               ?     ,
     1889               num#str# ,
     1890               num#col# ,
     1891               ? ,
     1892               ?         ) .
     1893   define variable l-ii  as integer no-undo .
     1894   define variable l-jj  as integer no-undo .
     1895   define variable l-len as integer no-undo .
     1896   define variable l-m   as integer no-undo .
     1897   v-nn = num-entries( str1 , "chr(10)"  )   .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1898   v-nn = num-entries( str2 , "chr(10)"  )   .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1899   v-nn = num-entries( str3 , "chr(10)"  )   .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1900   v-nn = num-entries( str4 , "chr(10)"  )   .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1901   v-nn = num-entries( reportheader , "chr(10)"  )   .   do l-ii = 1 to v-nn  :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format(                                                                        substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1902     num#str# = num#str# + 1.
     1903     num#col# = 1.
     1904     run macr_excel_char_with_format(
     1905           cur-time-print() +
     1906         " Цены указаны в " +
     1907         (if tprintrubl then "РУБ" else x-base-type )
     1908         , num#str#
     1909         , num#col#
     1910           ) .
