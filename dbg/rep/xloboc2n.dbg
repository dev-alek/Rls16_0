     3662     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-vt                [i] -  b2-oborot-vt                [3] ),  i). end.
     3663     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ot           [i] -  b2-oborot-ot           [3] ),  i). end.
     3664     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-end                            [i] -  b2-ostatok-end                            [3] ),  i). end.
     3665     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ap [i] -  b2-oborot-ap[3] ),  i). end.
     3666     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3667     if i = 13 then do :
     3668       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3669     end.
     3670     else do:
     3671       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3672       (                                                                                      (b2-oborot-ee         [i] +
     3673                                                                                               b2-oborot-re     [i] +
     3674                                                                                               b2-oborot-es    [i] +
     3675                                                                                               b2-oborot-rs[i]) -
     3676                                                                                             (b2-oborot-ee         [3] +
     3677                                                                                               b2-oborot-re     [3] +
     3678                                                                                               b2-oborot-es    [3] +
     3679                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3680     end.
     3681     end.
     3682     end.
     3683    run new-tmp-page .
     3684     run macr_cell_format
     3685     ( 10    ,
     3686       true  ,
     3687       true  ,
     3688       33    ,
     3689       num#str# ,
     3690       1 ,
     3691       num#str# ,
     3692       num#col# ) .
     3693     end.
     3694     end.
     3695   end procedure.
