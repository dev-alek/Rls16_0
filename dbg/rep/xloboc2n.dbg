     4890        oborot-im                 [1] = 0 and
     4891        oborot-wm                 [1] = 0 and
     4892        oborot-em                 [1] = 0 and
     4893        oborot-ie                 [1] = 0 and
     4894        oborot-ee                 [1] = 0 and
     4895        oborot-ep              [1] = 0 and
     4896        oborot-es            [1] = 0 and
     4897        oborot-re             [1] = 0 and
     4898        oborot-rs        [1] = 0 and
     4899        oborot-we                 [1] = 0 and
     4900        oborot-vt                       [1] = 0 and
     4901        oborot-iv                [1] = 0 and
     4902        oborot-ev                [1] = 0 and
     4903        oborot-rv            [1] = 0 and
     4904        oborot-ot                 [1] = 0 and
     4905        oborot-ot                 [2] = 0 and
     4906        oborot-ap            [1] = 0 and
     4907        oborot-pc            [1] = 0 and
     4908        oborot-im                 [2] = 0 and
     4909        oborot-wm                 [2] = 0 and
     4910        oborot-em                 [2] = 0 and
     4911        oborot-ie                 [2] = 0 and
     4912        oborot-ee                 [2] = 0 and
     4913        oborot-ep              [2] = 0 and
     4914        oborot-es            [2] = 0 and
     4915        oborot-re             [2] = 0 and
     4916        oborot-rs        [2] = 0 and
     4917        oborot-we                 [2] = 0 and
     4918        oborot-vt                       [2] = 0 and
     4919        oborot-iv                [2] = 0 and
     4920        oborot-ev                [2] = 0 and
     4921        oborot-rv            [2] = 0 and
     4922        oborot-ap            [2] = 0 and
     4923        oborot-pc            [2] = 0
     4924        ) then   Null-str2# = 0    .
     4925   END PROCEDURE.
     4926   procedure ex-display :
     4927   define input parameter par-1 as int no-undo.
     4928   define input parameter par-2 like  ostatok-start[1] no-undo.
     4929   define input parameter par-i as int no-undo.
     4930     assign num#col#  = par-1.
     4931     if par-i = 13 then do:
     4932       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     4933     end.
     4934     else do:
     4935       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     4936         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4937       end.
     4938       else do :
     4939         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4940       end.
     4941     end.
     4942   end procedure.
     4943   procedure u-line:
     4944   end procedure.
     4945   procedure p-line:
     4946   end procedure.
     4947   procedure make-col :
     4948    define variable l#1 as int  no-undo.
     4949    define variable l#2 as int  no-undo.
     4950    define variable l as int  no-undo.
     4951     assign
     4952       nk = 0
     4953       kk = 0
     4954     .
     4955     if xshowcost     then do: kk = kk + 1. end.
     4956     if xshowcostnds  then do: kk = kk + 1. end.
     4957     if xshowcrsa     then do: kk = kk + 1. end.
     4958     if xshowcrsands  then do: kk = kk + 1. end.
     4959     if xshowsale     then do: kk = kk + 1. end.
     4960     if xshowsalends  then do: kk = kk + 1. end.
     4961     if xshowsaleslt  then do: kk = kk + 1. end.
     4962     if xshowmediator then do: kk = kk + 1. end.
     4963     if x-tog-wt      then do: kk = kk + 1. end.
     4964     if x-tog-ms      then do: kk = kk + 1. end.
     4965     if xDens         then do: kk = kk + 1. end.
     4966    assign
     4967     num#str# = num#str# + 1
     4968     num#col#  = 0
     4969    .
     4970    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4971    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4972    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4973    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4974    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4975    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4976    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4977    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4978    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4979       mp = num#col#  + 1.
     4980       mp-1 = num#col#  .
     4981    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4982    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4983    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4984    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4985    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4986    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4987    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4988    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4989    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4990    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4991    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4992    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4993    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4994    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4995    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4996    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4997    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4998    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4999    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5000       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5001      num#str# = num#str# + 1.
     5002      repeat l#1 = mp to nk :
     5003            l#2 = 0.
     5004                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5005            if xshowcost    then do:
     5006                l#2 = l#2 + 1.
     5007                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5008                end.
     5009            if xshowcostnds then do:
     5010                l#2 = l#2 + 1.
     5011                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5012               end.
     5013            if xshowmediator then do:
     5014               l#2 = l#2 + 1.
     5015               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5016               end.
     5017            if xshowcrsa    then do:
     5018               l#2 = l#2 + 1.
     5019               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5020               end.
     5021            if xshowcrsands then do:
     5022               l#2 = l#2 + 1.
     5023               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5024               end.
     5025             if xshowsale    then do:
     5026               l#2 = l#2 + 1.
     5027               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5028               end.
     5029            if xshowsalends then do:
     5030               l#2 = l#2 + 1.
     5031               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5032               end.
     5033            if xshowsaleslt then do:
     5034               l#2 = l#2 + 1.
     5035               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5036            end.
     5037            if x-tog-wt then do:
     5038             assign
     5039               l#2 = l#2 + 1
     5040               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5041             .
     5042             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5043            end.
     5044            if x-tog-ms then do:
     5045             assign
     5046               l#2 = l#2 + 1
     5047               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5048             .
     5049             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5050            end.
     5051            if xDens then do:
     5052             assign
     5053               l#2 = l#2 + 1
     5054               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5055             .
     5056             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5057            end.
     5058        end.
     5059   end procedure .
