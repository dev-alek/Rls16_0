     2901   procedure calcitog :
     2902       run ostatok  in this-procedure (
     2903           input x-store-code  ,
     2904           input x-store-type  , x-tog-shift ,
     2905           input x-date-start - 1 ,
     2906           input date('')      , x-Shift-Start,x-Shift-End,
     2907           input 'crsa':U   ,
     2908           input '##,##':U,
     2909           input xtog-obj ,
     2910           output  quantity1  ,
     2911           output  coast_r1   ,
     2912           output  coast_v1   ,
     2913           output  vat_r1     ,
     2914           output  vat_v1     ,
     2915           output  fact-order-1 ).
     2916       run ostatok  in this-procedure (
     2917           input x-store-code  ,
     2918           input x-store-type  , x-tog-shift ,
     2919           input x-date-start  ,
     2920           input x-date-end    , x-Shift-Start,x-Shift-End,
     2921           input 'crsa':U   ,
     2922           input '##,##':U,
     2923           input xtog-obj ,
     2924           output  quantity1  ,
     2925           output  coast_r1   ,
     2926           output  coast_v1   ,
     2927           output  vat_r1     ,
     2928           output  vat_v1     ,
     2929           output  fact-order-2 ).
     2930             quantity1  = 0.
     2931             coast_r1   = 0.
     2932             coast_v1   = 0.
     2933             vat_r1     = 0.
     2934             vat_v1     = 0.
     2935   end procedure.
     2936   procedure display-str1  :
     2937   define variable ll as int no-undo.
     2938     assign
     2939       num#str# = num#str# + 1
     2940       num#col# = 0
     2941       v-gds-num = v-gds-num + 1
     2942     .
     2943     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     2944     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     2945     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     2946     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     2947     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     2948     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     2949   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2950   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2951   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2952   def var l-nk as integer no-undo .
     2953     Assign
     2954       LL = 0
     2955       KK = 1
     2956     .
     2957     if xShowCost      Then DO: KK = KK + 1. End.
     2958     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2959     if xShowCrsa      Then DO: KK = KK + 1. End.
     2960     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2961     if xShowSale      Then DO: KK = KK + 1. End.
     2962     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2963     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2964     if xShowmediator  Then DO: KK = KK + 1. End.
     2965     if x-tog-wt       then do: KK = KK + 1. End.
     2966     if x-tog-ms       then do: KK = KK + 1. End.
     2967     if xDens          then do: KK = KK + 1. End.
     2968     repeat i = 1 to 13 :
     2969       if i = 7 then next.
     2970       if NOT xShowCost      and i = 2   Then  next.
     2971       if NOT xShowCostNDS   and i = 3   Then  next.
     2972       if NOT xShowCrsa      and i = 5   Then  next.
     2973       if NOT xShowCrsaNds   and i = 6   Then  next.
     2974       if NOT xShowSale      and i = 8   Then  next.
     2975       if NOT xShowSaleNds   and i = 9   Then  next.
     2976       if NOT xShowSaleSlt   and i = 10  Then  next.
     2977       if NOT xShowmediator  and i = 4   Then  next.
     2978       if not x-tog-wt       and i = 11  then  next.
     2979       if not x-tog-ms       and i = 12  then  next.
     2980       if not xDens          and i = 13  then  next.
     2981       assign
     2982         LL = LL + 1
     2983         l-nk = mp-1
     2984       .
     2985     if x-vat or i <> 2  then do:
     2986     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     2987     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     2988     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     2989     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     2990     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     2991     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
