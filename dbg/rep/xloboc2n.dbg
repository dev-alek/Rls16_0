     3170     else do:
     3171     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bi-oborot-ee         [i] +
     3172                                                                                                                           bi-oborot-re     [i] +
     3173                                                                                                                           bi-oborot-es    [i] +
     3174                                                                                                                           bi-oborot-rs[i] )
     3175     ,  i). end.
