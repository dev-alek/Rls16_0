     3215   procedure display-bo  :
     3216   define variable ll as int no-undo.
     3217   define variable kk as int no-undo.
     3218     num#str# = num#str# + 1.
     3219     num#col# = 1.
     3220     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3221     num#col#  = 0 .
     3222     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3223     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3224     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3225     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3226     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3227     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3228     run macr_cell_format
     3229         ( 10    ,
     3230           true  ,
     3231           false ,
     3232           ?    ,
     3233           num#str# ,
     3234           1 ,
     3235           num#str# ,
     3236           (mp + ll + (kk * (27 - 8)))
     3237           ) .
     3238   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3239   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3240   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3241   def var l-nk as integer no-undo .
     3242     Assign
     3243       LL = 0
     3244       KK = 1
     3245     .
     3246     if xShowCost      Then DO: KK = KK + 1. End.
     3247     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3248     if xShowCrsa      Then DO: KK = KK + 1. End.
     3249     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3250     if xShowSale      Then DO: KK = KK + 1. End.
     3251     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3252     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3253     if xShowmediator  Then DO: KK = KK + 1. End.
     3254     if x-tog-wt       then do: KK = KK + 1. End.
     3255     if x-tog-ms       then do: KK = KK + 1. End.
     3256     if xDens          then do: KK = KK + 1. End.
     3257     repeat i = 1 to 13 :
     3258       if i = 7 then next.
     3259       if NOT xShowCost      and i = 2   Then  next.
     3260       if NOT xShowCostNDS   and i = 3   Then  next.
     3261       if NOT xShowCrsa      and i = 5   Then  next.
     3262       if NOT xShowCrsaNds   and i = 6   Then  next.
     3263       if NOT xShowSale      and i = 8   Then  next.
     3264       if NOT xShowSaleNds   and i = 9   Then  next.
     3265       if NOT xShowSaleSlt   and i = 10  Then  next.
     3266       if NOT xShowmediator  and i = 4   Then  next.
     3267       if not x-tog-wt       and i = 11  then  next.
     3268       if not x-tog-ms       and i = 12  then  next.
     3269       if not xDens          and i = 13  then  next.
     3270       assign
     3271         LL = LL + 1
     3272         l-nk = mp-1
     3273       .
     3274     if x-vat or i <> 2  then do:
     3275     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
     3276     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ie          [i] ,  i). end.
