     3072   procedure display-bi  :
     3073   define variable ll as int no-undo.
     3074   define variable kk as int no-undo.
     3075     num#col#  = 0 .
     3076     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3077     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3078     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3079     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3080     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3081     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3082     run macr_cell_format
     3083                                 ( 10    ,
     3084                                   true  ,
     3085                                   false ,
     3086                                   ?    ,
     3087                                   num#str# ,
     3088                                   1 ,
     3089                                   num#str# ,
     3090                                   (mp + ll + (kk * (27 - 8)))
     3091                                   ) .
     3092   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3093   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3094   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3095   def var l-nk as integer no-undo .
     3096     Assign
     3097       LL = 0
     3098       KK = 1
     3099     .
     3100     if xShowCost      Then DO: KK = KK + 1. End.
     3101     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3102     if xShowCrsa      Then DO: KK = KK + 1. End.
     3103     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3104     if xShowSale      Then DO: KK = KK + 1. End.
     3105     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3106     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3107     if xShowmediator  Then DO: KK = KK + 1. End.
     3108     if x-tog-wt       then do: KK = KK + 1. End.
     3109     if x-tog-ms       then do: KK = KK + 1. End.
     3110     if xDens          then do: KK = KK + 1. End.
     3111     repeat i = 1 to 13 :
     3112       if i = 7 then next.
     3113       if NOT xShowCost      and i = 2   Then  next.
     3114       if NOT xShowCostNDS   and i = 3   Then  next.
     3115       if NOT xShowCrsa      and i = 5   Then  next.
     3116       if NOT xShowCrsaNds   and i = 6   Then  next.
     3117       if NOT xShowSale      and i = 8   Then  next.
     3118       if NOT xShowSaleNds   and i = 9   Then  next.
     3119       if NOT xShowSaleSlt   and i = 10  Then  next.
     3120       if NOT xShowmediator  and i = 4   Then  next.
     3121       if not x-tog-wt       and i = 11  then  next.
     3122       if not x-tog-ms       and i = 12  then  next.
     3123       if not xDens          and i = 13  then  next.
     3124       assign
     3125         LL = LL + 1
     3126         l-nk = mp-1
     3127       .
     3128     if x-vat or i <> 2  then do:
     3129     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     3130     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
