     3786   procedure ob-line  :
     3787   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3788   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3789   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3790   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3791   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3792   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3793   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3794   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3795   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3796   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3797   define input  parameter xtog-obj           as log no-undo.
     3798   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3799   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3800   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3801   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3802   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3803   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3804   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3805   define variable  v-summa  as decimal extent 4 no-undo .
     3806   define variable  tt#          as int no-undo.
     3807   define variable v-ii as integer no-undo .
     3808   define variable slt  as decimal no-undo .
     3809   define variable disc  as decimal no-undo .
     3810   define variable xi as integer no-undo .
     3811   define variable v-tt as integer no-undo .
     3812    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3813       else
     3814       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3815       else
     3816       assign tt# = 6  v-tt = 200.
     3817     if long-p = false then do :
     3818     for each obj-list no-lock:
     3819      if  xtog-obj then
     3820          if   not(x-store-type     = obj-list.obj-type
     3821               and x-store-code    = obj-list.obj-code ) then next.
     3822           for each ub.ot-line where
     3823                     ub.ot-line.artic         = x-artic
     3824               and   ub.ot-line.prod-code    = x-prod-code
     3825               and   ub.ot-line.prod-type    = x-prod-type
     3826               and   ub.ot-line.fact-order   <= x-fact-order-2
     3827               and   ub.ot-line.fact-order   >= x-fact-order-1
     3828               and   ub.ot-line.obj-code     = obj-list.obj-code
     3829               and   ub.ot-line.obj-type     = obj-list.obj-type
     3830               and   ub.ot-line.sum-type     = x-sum-type
     3831               no-lock :
     3832               case ub.ot-line.ext-doc-type:
     3833     WHEN 'ie':U THEN DO:
     3834       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3835             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3836             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3837         if tt# = 6 Then   assign
     3838             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3839             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3840             End.
     3841     WHEN 'ee':U THEN DO:
     3842       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3843             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3844             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3845         if tt# = 6 Then   assign
     3846             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3847             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3848             End.
     3849     WHEN 'ep':U THEN DO:
     3850       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3851             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3852             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3853         if tt# = 6 Then   assign
     3854             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3855             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3856             End.
     3857     WHEN 'es':U THEN DO:
     3858       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3859             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3860             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3861         if tt# = 6 Then   assign
     3862             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3863             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3864             End.
     3865     WHEN 're':U THEN DO:
     3866       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3867             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3868             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3869         if tt# = 6 Then   assign
     3870             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3871             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3872             End.
     3873     WHEN 'rs':U THEN DO:
     3874       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3875             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3876             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3877         if tt# = 6 Then   assign
     3878             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3879             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3880             End.
     3881     WHEN 'we':U THEN DO:
     3882       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3883             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3884             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3885         if tt# = 6 Then   assign
     3886             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3887             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3888             End.
     3889     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     3890       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     3891             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3892             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3893           if tt# = 6 Then  assign
     3894             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3895             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3896             End.
     3897     WHEN 'iv':U THEN DO:
     3898       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     3899             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3900             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3901         if tt# = 6 Then   assign
     3902             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3903             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3904             End.
     3905     WHEN 'ev':U THEN DO:
     3906       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     3907             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3908             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3909         if tt# = 6 Then   assign
     3910             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3911             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3912             End.
     3913     WHEN 'rv':U THEN DO:
     3914       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     3915             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3916             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3917         if tt# = 6 Then   assign
     3918             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3919             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3920             End.
     3921     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     3922       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     3923             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3924             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3925           if tt# = 6 Then  assign
     3926             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3927             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3928             End.
     3929     WHEN 'im':U THEN DO:
     3930       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     3931             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3932             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3933         if tt# = 6 Then   assign
     3934             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3935             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3936             End.
     3937     WHEN 'ot':U THEN DO:
     3938       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     3939             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3940             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3941         if tt# = 6 Then   assign
     3942             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3943             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3944             End.
     3945     WHEN 'ap':U THEN DO:
     3946       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     3947             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3948             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3949         if tt# = 6 Then   assign
     3950             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3951             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3952             End.
     3953     WHEN 'pc':U THEN DO:
     3954       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     3955             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3956             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3957         if tt# = 6 Then   assign
     3958             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3959             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3960             End.
     3961               end case.
     3962           end.
     3963      end.
     3964   end.
     3965   else do:
     3966   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     3967   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     3968   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     3969   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     3970   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     3971   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     3972   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     3973   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     3974   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     3975   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     3976   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     3977   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     3978   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     3979   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     3980   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     3981   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3982   end.
     3983     if tt# = 6 then do:
     3984     if  xshowmediator = false then
     3985         oborot-sum-cost[1] =
     3986         oborot-ee[2]      +
     3987         oborot-es[2] +
     3988         oborot-re[2]  +
     3989         oborot-rs[2]
     3990         .
     3991         else
     3992         oborot-sum-cost[1] =
     3993         oborot-ee[4]      +
     3994         oborot-es[4] +
     3995         oborot-re[4]  +
     3996         oborot-rs[4]
     3997         .
     3998        repeat v-ii = 1 to 1 :
     3999        v-summa[v-ii ]  =
     4000           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4001           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4002           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4003           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4004           oborot-im[v-ii ] .
     4005        end.
     4006        repeat v-ii = 2 to 4 :
     4007        v-summa[v-ii ]  =
     4008           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4009           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4010           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4011           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4012           oborot-im[v-ii + tt#] .
     4013        end.
     4014         oborot-sum-sale[1] =
     4015         oborot-ee[2 + tt#] +
     4016         oborot-es[2 + tt#] +
     4017         oborot-re[2 + tt#] +
     4018         oborot-rs[2 + tt#]
     4019         .
     4020          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4021           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4022                                                                                                     -  oborot-disc[1]
     4023           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4024           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4025           .
     4026           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4027           if oborot-sum-cost[1] <>  0 then
     4028             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4029             else oborot-prc[1] = 0.
     4030     end.
     4031   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4032   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4033   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4034   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4035   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4036   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4037   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4038   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4039   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4040   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4041   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4042   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4043   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4044   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4045   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4046   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4047   end procedure.
     4048   procedure ost-line :
     4049     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4050     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4051     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4052     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4053     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4054     define input  parameter x-tog-shift  as logical no-undo .
     4055     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4056     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4057     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4058     define input  parameter xtog-obj     as logical no-undo .
     4059     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4060     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4061     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4062     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4063     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4064     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4065     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4066     define buffer buff-obj-list  for obj-list .
     4067     define buffer buff-stk-line  for ub.stk-line .
     4068     assign
     4069       Quantity = 0
     4070       Coast_R  = 0
     4071       Coast_V  = 0
     4072       VAT_R    = 0
     4073       VAT_V    = 0
     4074       SLT_R    = 0
     4075       SLT_V    = 0
     4076     .
     4077     if  x-tog-shift = false then do:
     4078       for each buff-obj-list no-lock
     4079       on error undo, return error
     4080       :
     4081         find last buff-stk-line no-lock
     4082           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4083             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4084             and buff-stk-line.artic      = x-artic
     4085             and buff-stk-line.prod-type  = x-prod-type
     4086             and buff-stk-line.prod-code  = x-prod-code
     4087             and buff-stk-line.sum-type   = x-sum-type
     4088             and buff-stk-line.cat-id     = '##,##':U
     4089             and buff-stk-line.fact-order <= x-fact-order
     4090             and buff-stk-line.shift-num  = 0
     4091           use-index category
     4092           no-error .
     4093         if available buff-stk-line then do:
     4094           assign
     4095             Quantity = Quantity +  buff-stk-line.fact-qnty
     4096             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4097             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4098             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4099             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4100             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4101             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4102           .
     4103         end.
     4104       end.
     4105     end.
     4106     else do:
     4107       for each buff-obj-list no-lock
     4108         where xtog-obj = false
     4109            or (buff-obj-list.obj-type = x-store-type
     4110               and buff-obj-list.obj-code = x-store-code
     4111               )
     4112       on error undo, return error
     4113       :
     4114         find last buff-stk-line no-lock
     4115           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4116             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4117             and buff-stk-line.artic      = x-artic
     4118             and buff-stk-line.prod-type  = x-prod-type
     4119             and buff-stk-line.prod-code  = x-prod-code
     4120             and buff-stk-line.sum-type   = x-sum-type
     4121             and buff-stk-line.cat-id     = '##,##':U
     4122             and buff-stk-line.fact-order <= x-fact-order
     4123             and buff-stk-line.shift-num  > 0
     4124           use-index category
     4125           no-error .
     4126         if available buff-stk-line then do:
     4127           assign
     4128             Quantity = Quantity +  buff-stk-line.fact-qnty
     4129             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4130             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4131             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4132             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4133             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4134             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4135           .
     4136         end.
     4137       end.
     4138     end.
     4139   end procedure.
     4140   procedure ost-lineother-tax :
     4141     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4142     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4143     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4144     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4145     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4146     define input  parameter x-tog-shift  as logical no-undo .
     4147     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4148     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4149     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4150     define input  parameter xTog-obj     as logical no-undo .
     4151     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4152     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4153     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4154     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4155     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4156     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4157     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4158     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4159     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4160     define buffer buff-obj-list  for obj-list .
     4161     define buffer buff-stk-line  for ub.stk-line .
     4162     assign
     4163       Quantity = 0
     4164       Coast_R  = 0
     4165       Coast_V  = 0
     4166       VAT_R    = 0
     4167       VAT_V    = 0
     4168       SLT_R    = 0
     4169       SLT_V    = 0
     4170       other_R  = 0
     4171       other_V  = 0
     4172     .
     4173     if  x-tog-shift = false then do:
     4174       for each buff-obj-list no-lock
     4175       on error undo, return error
     4176       :
     4177         find last buff-stk-line no-lock
     4178           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4179             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4180             and buff-stk-line.artic      = x-artic
     4181             and buff-stk-line.prod-type  = x-prod-type
     4182             and buff-stk-line.prod-code  = x-prod-code
     4183             and buff-stk-line.sum-type   = x-sum-type
     4184             and buff-stk-line.cat-id     = '##,##':U
     4185             and buff-stk-line.fact-order <= x-fact-order
     4186             and buff-stk-line.shift-num  = 0
     4187           use-index category
     4188           no-error .
     4189         if available buff-stk-line then do:
     4190           assign
     4191             Quantity = Quantity +  buff-stk-line.fact-qnty
     4192             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4193             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4194             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4195             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4196             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4197             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4198             other_R  = other_R  +  buff-stk-line.other-rubl
     4199             other_V  = other_V  +  buff-stk-line.other-base
     4200           .
     4201         end.
     4202       end.
     4203     end.
     4204     else do:
     4205       for each buff-obj-list no-lock
     4206         where xtog-obj = false
     4207            or (buff-obj-list.obj-type = x-store-type
     4208               and buff-obj-list.obj-code = x-store-code
     4209               )
     4210       on error undo, return error
     4211       :
     4212         find last buff-stk-line no-lock
     4213           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4214             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4215             and buff-stk-line.artic      = x-artic
     4216             and buff-stk-line.prod-type  = x-prod-type
     4217             and buff-stk-line.prod-code  = x-prod-code
     4218             and buff-stk-line.sum-type   = x-sum-type
     4219             and buff-stk-line.cat-id     = '##,##':U
     4220             and buff-stk-line.fact-order <= x-fact-order
     4221             and buff-stk-line.shift-num  > 0
     4222           use-index category
     4223           no-error .
     4224         if available buff-stk-line then do:
     4225           assign
     4226             Quantity = Quantity +  buff-stk-line.fact-qnty
     4227             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4228             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4229             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4230             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4231             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4232             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4233             other_R = other_R   +  buff-stk-line.other-rubl
     4234             other_V = other_V   +  buff-stk-line.other-base
     4235           .
     4236         end.
     4237       end.
     4238     end.
     4239   end procedure.
     4240   procedure ost-line-kg :
     4241     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4242     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4243     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4244     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4245     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4246     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4247     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4248     define buffer buff-obj-list  for obj-list .
     4249     define buffer buf_doc-line for ub.doc-line .
     4250     define buffer buf_inv-line for ub.inv-line .
     4251     do
     4252     on error undo, return error
     4253     :
     4254       for each buf_doc-line no-lock where
     4255                buf_doc-line.obj-type    = p-obj-type   and
     4256                buf_doc-line.obj-code    = p-obj-code   and
     4257                buf_doc-line.prod-type   = p-prod-type  and
     4258                buf_doc-line.prod-code   = p-prod-code  and
     4259                buf_doc-line.artic       = p-artic      and
     4260                buf_doc-line.status_     = 'факт':U      and
     4261                buf_doc-line.fact-order <= p-fact-order
     4262             by buf_doc-line.fact-order    descending
     4263       :
     4264         find first buf_inv-line no-lock where
     4265                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4266                    buf_inv-line.artic     = buf_doc-line.artic     and
     4267                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4268                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4269         if available buf_inv-line
     4270         then do:
     4271           if buf_inv-line.after-cli-qnty <> ?
     4272           then do:
     4273             assign
     4274               p-quantity-kg = buf_inv-line.after-cli-qnty
     4275             .
     4276             leave .
     4277           end.
     4278         end.
     4279       end.
     4280       if p-quantity-kg = ?
     4281       then do:
     4282         assign
     4283           p-quantity-kg = 0
     4284         .
     4285       end.
     4286     end.
     4287   end procedure.
     4288   PROCEDURE ostatok :
     4289   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4290   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4291   def input parameter x-tog-shift   as   logical             no-undo.
     4292   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4293   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4294   def input parameter x-shift-start as integer               no-undo.
     4295   def input parameter x-shift-end   as integer               no-undo.
     4296   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4297   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4298   def input parameter xTog-obj   as log no-undo.
     4299   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4300   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4301   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4302   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4303   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4304   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4305   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4306   def var              Fact-orderS   as char  no-undo.
     4307   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4308      Assign
     4309         Fact-order   = 0
     4310         Quantity     = 0
     4311         Coast_R      = 0
     4312         Coast_V      = 0
     4313         VAT_R        = 0
     4314         VAT_V        = 0 .
     4315    x-date-start-t  = x-date-start + 1 .
     4316   IF x-date-end = date('') then DO:
     4317      Fact-order = 0 .
     4318      for each obj-list
     4319          where  ( not xtog-obj or
     4320                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4321                 no-lock :
     4322         if  x-tog-shift = false then do:
     4323                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4324                               ub.stk-tot.Fact-date <=  x-date-start
     4325                               and ub.stk-tot.shift-num = 0
     4326                               USE-INDEX fact-date no-lock no-error .
     4327              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4328         End.
     4329         Else  DO :
     4330             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4331              (ub.stk-tot.shift-date  = x-date-start-t and
     4332               ub.stk-tot.shift-num  < x-shift-start or
     4333               ub.stk-tot.shift-date  < x-date-start-t  )
     4334               and ub.stk-tot.shift-num  > 0
     4335               USE-INDEX Shift-num no-lock no-error .
     4336            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4337           END.
     4338       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4339     End.
     4340   End.
     4341   Else DO:
     4342     For each obj-list  WHERE
     4343        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4344         no-lock :
     4345      IF  x-TOG-Shift = False Then DO:
     4346          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4347               ub.stk-tot.Fact-date <= x-date-end
     4348               and ub.stk-tot.shift-num = 0
     4349               USE-INDEX fact-date no-lock no-error.
     4350          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4351      END.
     4352      Else DO:
     4353           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4354               (ub.stk-tot.shift-date  = x-date-end and
     4355               ub.stk-tot.shift-num  <= x-shift-end or
     4356               ub.stk-tot.shift-date  < x-date-end       ) and
     4357               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4358               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4359       End.
     4360       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4361     End.
     4362   End.
     4363   END PROCEDURE.
     4364   procedure report-exec1  :
     4365      find first clients where x-store-type = clients.obj-type and
     4366                               x-store-code = clients.obj-code
     4367                               no-lock no-error.
     4368              if available clients then assign  objname = clients.obj-name
     4369                                                x-db-num     = clients.db-num.
     4370                                            else  objname="объект не определен".
     4371     run calcitog in this-procedure .
     4372     run print-header in this-procedure .      case retclassify :
     4373      when "grp-goods":u      then  run run2 in this-procedure .
     4374      otherwise do:
     4375        message "Ошибка вызова" view-as alert-box error .
     4376      end.
     4377      end case.
     4378     run print-footer in this-procedure .
     4379     end procedure.
     4380   procedure calc-sub-itog :
     4381   define input parameter tt as int no-undo.
     4382   define variable tt2 as integer no-undo .
     4383     if tt = 6 then tt2 = 7 .
     4384               else tt2 = tt.
     4385   repeat i# = 1 + tt to 3 + tt2 :
     4386   run sum-i (
     4387    input oborot-vt[i#]
     4388   ,input tt
     4389   ,input-output b1-oborot-vt[i#]
     4390   ,input-output b2-oborot-vt[i#]
     4391   ,input-output bi-oborot-vt[i#]
     4392   ,input-output bo-oborot-vt[i#]
     4393   ,input oborot-ie[i#]
     4394   ,input-output b1-oborot-ie[i#]
     4395   ,input-output b2-oborot-ie[i#]
     4396   ,input-output bi-oborot-ie[i#]
     4397   ,input-output bo-oborot-ie[i#]
     4398   ) .
     4399   run sum-i (
     4400    input oborot-iv[i#]
     4401   ,input tt
     4402   ,input-output b1-oborot-iv[i#]
     4403   ,input-output b2-oborot-iv[i#]
     4404   ,input-output bi-oborot-iv[i#]
     4405   ,input-output bo-oborot-iv[i#]
     4406   ,input oborot-ee[i#]
     4407   ,input-output b1-oborot-ee[i#]
     4408   ,input-output b2-oborot-ee[i#]
     4409   ,input-output bi-oborot-ee[i#]
     4410   ,input-output bo-oborot-ee[i#]
     4411   ) .
     4412   run sum-i (
     4413    input oborot-ev[i#]
     4414   ,input tt
     4415   ,input-output b1-oborot-ev[i#]
     4416   ,input-output b2-oborot-ev[i#]
     4417   ,input-output bi-oborot-ev[i#]
     4418   ,input-output bo-oborot-ev[i#]
     4419   ,input oborot-ep[i#]
     4420   ,input-output b1-oborot-ep[i#]
     4421   ,input-output b2-oborot-ep[i#]
     4422   ,input-output bi-oborot-ep[i#]
     4423   ,input-output bo-oborot-ep[i#]
     4424   ) .
     4425   run sum-i (
     4426    input oborot-rv[i#]
     4427   ,input tt
     4428   ,input-output b1-oborot-rv[i#]
     4429   ,input-output b2-oborot-rv[i#]
     4430   ,input-output bi-oborot-rv[i#]
     4431   ,input-output bo-oborot-rv[i#]
     4432   ,input oborot-es[i#]
     4433   ,input-output b1-oborot-es[i#]
     4434   ,input-output b2-oborot-es[i#]
     4435   ,input-output bi-oborot-es[i#]
     4436   ,input-output bo-oborot-es[i#]
     4437   ) .
     4438   run sum-i (
     4439    input oborot-em[i#]
     4440   ,input tt
     4441   ,input-output b1-oborot-em[i#]
     4442   ,input-output b2-oborot-em[i#]
     4443   ,input-output bi-oborot-em[i#]
     4444   ,input-output bo-oborot-em[i#]
     4445   ,input oborot-re[i#]
     4446   ,input-output b1-oborot-re[i#]
     4447   ,input-output b2-oborot-re[i#]
     4448   ,input-output bi-oborot-re[i#]
     4449   ,input-output bo-oborot-re[i#]
     4450   ) .
     4451   run sum-i (
     4452    input oborot-im[i#]
     4453   ,input tt
     4454   ,input-output b1-oborot-im[i#]
     4455   ,input-output b2-oborot-im[i#]
     4456   ,input-output bi-oborot-im[i#]
     4457   ,input-output bo-oborot-im[i#]
     4458   ,input oborot-rs[i#]
     4459   ,input-output b1-oborot-rs[i#]
     4460   ,input-output b2-oborot-rs[i#]
     4461   ,input-output bi-oborot-rs[i#]
     4462   ,input-output bo-oborot-rs[i#]
     4463   ) .
     4464   run sum-i (
     4465    input oborot-ot[i#]
     4466   ,input tt
     4467   ,input-output b1-oborot-ot[i#]
     4468   ,input-output b2-oborot-ot[i#]
     4469   ,input-output bi-oborot-ot[i#]
     4470   ,input-output bo-oborot-ot[i#]
     4471   ,input oborot-we[i#]
     4472   ,input-output b1-oborot-we[i#]
     4473   ,input-output b2-oborot-we[i#]
     4474   ,input-output bi-oborot-we[i#]
     4475   ,input-output bo-oborot-we[i#]
     4476   ) .
     4477   run sum-i (
     4478    input oborot-ap[i#]
     4479   ,input tt
     4480   ,input-output b1-oborot-ap[i#]
     4481   ,input-output b2-oborot-ap[i#]
     4482   ,input-output bi-oborot-ap[i#]
     4483   ,input-output bo-oborot-ap[i#]
     4484   ,input oborot-pc[i#]
     4485   ,input-output b1-oborot-pc[i#]
     4486   ,input-output b2-oborot-pc[i#]
     4487   ,input-output bi-oborot-pc[i#]
     4488   ,input-output bo-oborot-pc[i#]
     4489   ) .
     4490     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4491     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4492     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4493     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4494     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4495     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4496     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4497     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4498     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4499     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4500     if i# = 8 then
     4501       assign
     4502         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4503                                 bi-oborot-re[ i#]         +
     4504                                 bi-oborot-rs[ i#]    +
     4505                                 bi-oborot-es[ i#]
     4506         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4507                                 b1-oborot-re[ i#]         +
     4508                                 b1-oborot-rs[ i#]    +
     4509                                 b1-oborot-es[ i#]
     4510         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4511                                 b2-oborot-re[ i#]         +
     4512                                 b2-oborot-rs[ i#]    +
     4513                                 b2-oborot-es[ i#]
     4514         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4515                                 bo-oborot-re[ i#]         +
     4516                                 bo-oborot-rs[ i#]    +
     4517                                 bo-oborot-es[ i#]
     4518         .
     4519     if  xshowmediator = true  then do:
     4520         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4521         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4522         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4523         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4524     end.
     4525     if i# = 2 and xshowmediator = false  then
     4526         assign
     4527           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4528                                   bi-oborot-re[ i#]         +
     4529                                   bi-oborot-rs[ i#]    +
     4530                                   bi-oborot-es[ i#]
     4531           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4532                                   b1-oborot-re[ i#]         +
     4533                                   b1-oborot-rs[ i#]    +
     4534                                   b1-oborot-es[ i#]
     4535           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4536                                   b2-oborot-re[ i#]         +
     4537                                   b2-oborot-rs[ i#]    +
     4538                                   b2-oborot-es[ i#]
     4539           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4540                                   bo-oborot-re[ i#]         +
     4541                                   bo-oborot-rs[ i#]    +
     4542                                   bo-oborot-es[ i#]
     4543           .
     4544     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4545     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4546     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4547     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4548     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4549                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4550                      else bi-oborot-prc[1] = 0.
     4551     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4552                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4553                      else bo-oborot-prc[1] = 0.
     4554     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4555                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4556                      else b1-oborot-prc[1] = 0.
     4557     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4558                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4559                      else b2-oborot-prc[1] = 0.
     4560    end.
     4561   end procedure.
     4562   procedure sum-i :
     4563   define input parameter ob like oborot-ot[1] no-undo.
     4564   define input parameter tt as int  no-undo.
     4565   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4566   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4567   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4568   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4569   define input parameter ob2 like oborot-ot[1] no-undo.
     4570   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4571   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4572   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4573   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4574   assign
     4575    b1  = b1 + ob
     4576    b2  = b2 + ob
     4577    b1- = b1- + ob2
     4578    b2- = b2- + ob2
     4579    .
     4580       assign
     4581       bi = bi + ob
     4582       bo = bo + ob
     4583       bi- = bi- + ob2
     4584       bo- = bo- + ob2
     4585       .
     4586   end procedure.
     4587   procedure clear-item :
     4588   define variable kk as int no-undo.
     4589    repeat kk = 1 to 13 :
     4590    assign
     4591       oborot-ie                 [kk]    = 0
     4592       oborot-ee                 [kk]    = 0
     4593       oborot-ep              [kk]    = 0
     4594       oborot-es            [kk]    = 0
     4595       oborot-re             [kk]    = 0
     4596       oborot-rs        [kk]    = 0
     4597       oborot-we                 [kk]    = 0
     4598       oborot-vt                       [kk]    = 0
     4599       oborot-iv                 [kk]    = 0
     4600       oborot-ev                 [kk]    = 0
     4601       oborot-rv             [kk]    = 0
     4602       oborot-em                  [kk]    = 0
     4603       oborot-wm                  [kk]    = 0
     4604       oborot-im                  [kk]    = 0
     4605       oborot-ot                  [kk]    = 0
     4606       oborot-disc                             [kk]    = 0
     4607       oborot-eff                              [kk]    = 0
     4608       oborot-prc                              [kk]    = 0
     4609       oborot-ap            [kk]    = 0
     4610       oborot-pc            [kk]    = 0
