     4612       ostatok-start                                  [kk]    = 0
     4613     .
     4614    end.
     4615   end procedure.
     4616   procedure item-goods :
     4617    define input parameter  par-3 as char no-undo.
     4618    define input parameter  par-4 as char no-undo.
     4619        if par-4 = "goods":u  then  assign
     4620                                       gds-zap-unit-base  = goods.unit-base
     4621                                       gds-zap-prt-root   = goods.prt-root
     4622                                       gds-zap-prod-type  = goods.prod-type
     4623                                       gds-zap-prod-code  = goods.prod-code
     4624                                       gds-zap-artic      = goods.artic
     4625                                       gds-zap-type       = goods.gds-type
     4626                                       gds-zap-grp-name   = goods.grp-name
     4627                                       gds-zap-b-code     = goods.gds-code
     4628                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4629                                                                          else goods.gds-name
     4630                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4631                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4632        if par-4 = "gds-list":u  then  assign
     4633                                       gds-zap-unit-base  = gds-list.unit-base
     4634                                       gds-zap-prt-root   = gds-list.prt-root
     4635                                       gds-zap-prod-type  = gds-list.prod-type
     4636                                       gds-zap-prod-code  = gds-list.prod-code
     4637                                       gds-zap-artic      = gds-list.artic
     4638                                       gds-zap-type       = gds-list.gds-type
     4639                                       gds-zap-grp-name   = gds-list.grp-name
     4640                                       gds-zap-b-code     = gds-list.gds-code
     4641                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4642                                                                          else gds-list.gds-name
     4643                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4644                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4645       run foreach in this-procedure .
     4646   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4647     (input  gds-zap-b-code
     4648     ,input  ?
     4649     ,output v-bar-code
     4650     )  .
     4651   s-bar-code = string (v-bar-code,"999999999").
     4652       If  break_group = true  and par-3 <> "1"  then DO :
     4653            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4654            gds-zap-prod-name  = clients.obj-name.
     4655             If break_group1 = true  THEN  DO :
     4656               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4657                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4658                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4659               if par-3 = "6"  then  dO:
     4660                  if xTog-obj = true then do:
     4661                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4662                   end.
     4663                  else do:
     4664                   var-vat-pc = temp-gds-list.vat-pc  .
     4665                   end.
     4666                   assign
     4667                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4668                       b1-name = temp-str .
     4669                   end.
     4670               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4671                   fr0 = true .
     4672                   tmp#stroka0 = temp-str.
     4673               End .
     4674             End .
     4675             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4676               if par-3 = "4"
     4677                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4678                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4679               if NOT xSumsOnly THEN DO :
     4680               fr = true .
     4681               End.
     4682               break_group1 = false.
     4683             END.
     4684          break_group = false.
     4685       End.
     4686       run display-line in this-procedure .
     4687    end procedure.
