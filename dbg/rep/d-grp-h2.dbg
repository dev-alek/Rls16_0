     2875   Line = fill( "-" , 60 ) .
     2876   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2877   run waitfram-show in this-procedure ("Строю дерево групп ...").
     2878   for each obj-list no-lock:
     2879     assign
     2880     accum-obj-list = accum-obj-list + 1.
     2881     if accum-obj-list > 1 then LEAVE.
     2882   end.
     2883   if rs-option = 3 then do:
     2884     create full-grp.
     2885     assign full-grp.grp-code = 0.
     2886   end.
     2887     for each ub.gds-grp no-lock:
     2888         find first for-grp where
     2889                   for-grp.upper-code = ub.gds-grp.node-code No-LOCK No-ERROR.
     2890         if not avail for-grp then do:
     2891             create full-grp.
     2892             assign full-grp.grp-code = ub.gds-grp.node-code.
     2893             run grplib-get-full-name in this-procedure(input ub.gds-grp.node-code, output full-grp.full-name).
     2894             full-grp.full-name = replace(full-grp.full-name, " ", "_").
     2895         end.
     2896     end.
     2897   run waitfram-hide in this-procedure .
     2898   if nc > 15 then do:
     2899   run prn-lib-open-stream  in this-procedure (
     2900                                                input parParentProc
     2901                                               ,input 62
     2902                                               ,input yes
     2903                                               ,input no
     2904                                               ).
     2905   end.
     2906   else do:
     2907     run prn-lib-open-stream  in this-procedure (
     2908                                                 input parParentProc
     2909                                                 ,input 43
     2910                                                 ,input yes
     2911                                                 ,input no
     2912                                                 ).
     2913   end.
     2914   FORM with FRAME Hour .
     2915   FORM HEADER
     2916   Line format "X(60)" AT 1 SKIP
     2917   "Продолжение - на следующей странице" AT 10 SKIP
     2918   with FRAME NBottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2919   VIEW stream PrnLibStream FRAME NBottomFrame .
     2920   PUT stream PrnLibStream
     2921   SPACE(10)
     2922   ("Почасовая статистика розничных продаж ( по количеству ТОВАРОВ ) ЗА ПЕРИОД c " +
     2923   string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) + ".")      format "x(110)" SKIP(1).
     2924   if p-SelectGood = 3 then do:
     2925     PUT STREAM PrnLibStream  "По производителям: " skip space(50) .
     2926     FOR EACH g#cli :
     2927         FIND FIRST cli-obj WHERE
     2928                     cli-obj.obj-type = g#cli.obj-type AND
     2929                     cli-obj.obj-code = g#cli.obj-code NO-LOCK .
     2930         PUT STREAM PrnLibStream  cli-obj.obj-name format "x(80)" skip space(50) .
     2931     END.
     2932   end.
     2933   define variable counter as integer no-undo .
     2934   if p-SelectGood = 4 then do:
     2935     counter = 0.
     2936     PUT STREAM PrnLibStream  "По списку товаров: " skip .
     2937     FOR EACH gds-list :
     2938         PUT STREAM PrnLibStream  unformatted
     2939         substitute("&1 &2 &3&4&5"
     2940                     , fill( chr(32), 10 )
     2941                     , gds-list.gds-code
     2942                     , gds-list.artic
     2943                     , gds-list.prod-type
     2944                     , gds-list.prod-code
     2945                     )
     2946         .
     2947         counter = counter + 1.
     2948         if counter = 3 then do:
     2949           PUT STREAM PrnLibStream  unformatted skip.
     2950           counter = 0.
     2951         end.
     2952     END.
     2953     PUT STREAM PrnLibStream  unformatted skip.
     2954   end.
     2955   if p-selectgood = 2 then do:
     2956     PUT stream PrnLibStream
     2957     space(20)  "По группам товаров: " format "x(80)" skip(0) .
     2958     for each tmp#grp:
     2959         PUT stream PrnLibStream
     2960         space(20) tmp#grp.grp-name format "x(80)" skip(0) .
     2961     end.
     2962   end.
     2963   if t-dis-card then do:
     2964     PUT stream PrnLibStream UNFORMATTED
     2965     SPACE(10)
     2966     "Только покупки по дисконтным картам" skip.
     2967     if rs-dis-card = 1 then do:
     2968       for each temp-dis-card-type No-LOCK:
     2969         PUT stream PrnLibStream UNFORMATTED
     2970         SPACE(10)
     2971         temp-dis-card-type.type
     2972         skip.
     2973       END.
     2974     end.
     2975   end.
     2976   PUT stream PrnLibStream UNFORMATTED
     2977   SPACE(10) SelectObject SKIP(0)
     2978   by-object-str skip(1)
     2979   .
     2980   display STREAM PrnLibStream with frame top-Frame .
     2981   _cycle:
     2982   do cycle = 1 to 0 by -1:
     2983     if byobject and cycle = 0 and accum-obj-list = 1 then LEAVE _cycle.
     2984     _obj-list:
     2985     for each obj-list no-lock:
     2986       obj-count = obj-count + 1.
     2987       if not byobject and cycle = 1 then LEAVE _obj-list.
     2988       if cycle = 1 then v-obj-code = obj-list.obj-code.
     2989       if cycle = 0 then v-obj-code = 0.
     2990       if cycle = 1 then do:
     2991         FIND FIRST ub.clients NO-LOCK WHERE
     2992                   ub.clients.obj-code = v-obj-code AND
     2993                   ub.clients.obj-type = 'маг':U NO-ERROR.
     2994         if available ub.clients then do:
     2995           v-obj-name = ub.clients.obj-name.
     2996         end.
     2997         else v-obj-name = string(v-obj-code).
     2998       end.
     2999       if byobject and cycle = 0 then do:
     3000         v-obj-name = "ПО ВСЕМ ОБЪЕКТАМ".
     3001       end.
     3002       if rs-option <> 3 and byobject then do:
     3003     if use-column[1]
     3004     then  C-sym1:screen-value = string(sym1, entry(1, c-sym1:private-data, chr(4))).
     3005     if use-column[2]
     3006     then  C-full-name:screen-value = string(v-obj-name, entry(1, c-full-name:private-data, chr(4))).
     3007     if use-column[3]
     3008     then  C-sym2:screen-value = string(sym2, entry(1, c-sym2:private-data, chr(4))).
     3009     if use-column[29]
     3010     then  C-sym3:screen-value = string(sym3, entry(1, c-sym3:private-data, chr(4))).
     3011         DISPLAY stream  PrnLibStream with frame HOUR.                                      DOWN 1 stream PrnLibStream with frame HOUR.
     3012     if use-column[2]
     3013     then  C-full-name:screen-value = string(fill56).
     3014     if use-column[4]
     3015     then  C-hour1:screen-value = string(fill12).
     3016     if use-column[5]
     3017     then  C-hour2:screen-value = string(fill12).
     3018     if use-column[6]
     3019     then  C-hour3:screen-value = string(fill12).
     3020     if use-column[7]
