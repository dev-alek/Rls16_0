     1087   define variable vss-include-info13 as character format "X(65)" no-undo
     1088   initial "@(#)$Workfile$ $Revision$".
     1089   procedure grplib-get-full-name :
     1090      define input parameter p-node-code  as integer      no-undo.
     1091      define output parameter p-full-name as character    no-undo.
     1092      do
     1093   on error undo, return error
     1094   :
     1095       define variable v-upper-code    as integer           no-undo.
     1096       define buffer buf_gds-grp       for ub.gds-grp.
     1097       define buffer buf_upper_gds-grp for ub.gds-grp.
     1098       find first buf_gds-grp no-lock
     1099            where buf_gds-grp.node-code = p-node-code
     1100       no-error.
     1101       if not available buf_gds-grp
     1102       then do:
     1103           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1104       end.
     1105       assign
     1106           p-full-name  = ""
     1107           v-upper-code = 1
     1108       .
     1109       do while buf_gds-grp.upper-code <> 0
     1110       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1111       :
     1112           assign
     1113               p-full-name  = buf_gds-grp.node-name
     1114                            + (if p-full-name <> "" then chr(47) else "")
     1115                            + p-full-name
     1116               v-upper-code = buf_gds-grp.upper-code
     1117           .
     1118           find first buf_gds-grp no-lock
     1119                where buf_gds-grp.node-code = v-upper-code
     1120           no-error.
     1121           if not available buf_gds-grp
     1122           then do:
     1123               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1124                                   + string( v-upper-code )
     1125                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1126           end.
     1127       end.
     1128       assign
     1129       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1130       .
     1131   end.
     1132   end .
     1133   procedure grplib-get-node-from-full-name :
     1134   define input parameter p-full-name as character no-undo .
     1135   define output parameter p-node-code as integer no-undo .
     1136   define variable v-ii as integer no-undo .
     1137   define variable v-upper-code as integer no-undo .
     1138   define variable v-root-code as integer no-undo .
     1139   define variable v-entry as character no-undo .
     1140   define buffer buf_gds-grp       for ub.gds-grp.
     1141   do
     1142   on error undo, return error
     1143   :
     1144     find first buf_gds-grp no-lock
     1145         where buf_gds-grp.upper-code = 0
     1146     no-error .
     1147     if not available buf_gds-grp
     1148     then do:
     1149         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1150     end.
     1151     else do:
     1152       assign
     1153       v-root-code = buf_gds-grp.node-code
     1154       .
     1155     end.
     1156     v-upper-code = v-root-code.
     1157     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1158       assign
     1159       v-entry = entry(v-ii, p-full-name, chr(47)).
     1160       if v-entry = '' then leave.
     1161       find first buf_gds-grp no-lock where
     1162                 buf_gds-grp.node-name = v-entry
     1163             and buf_gds-grp.upper-code = v-upper-code
     1164             no-error.
     1165       if not available buf_gds-grp then do:
     1166         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1167       end.
     1168       else do:
     1169         p-node-code = buf_gds-grp.node-code.
     1170         v-upper-code = buf_gds-grp.node-code.
     1171       end.
     1172     end.
     1173   end.
     1174   end .
     1175   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1176   define variable v-waitfram-action01         as character   no-undo .
     1177   define variable v-waitfram-action02         as character   no-undo .
     1178   define variable v-waitfram-action03         as character   no-undo .
     1179   define variable mWaitFramTextBeg            as character   no-undo.
     1180   define variable mWaitFramTextEnd            as character   no-undo.
     1181   define variable mWaitFramView               as logical     no-undo.
     1182   define variable mWaitProcEvent              as logical     no-undo init yes.
     1183   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1184   define variable mWaitFramStop               as logical     no-undo.
     1185   define variable mWaitFramStopUser           as logical     no-undo.
     1186   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1187   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1188   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1189   define button B-WaitFramStop auto-end-key
     1190        label "Стоп"
     1191        size 10 by 1 tooltip "Остоновить процесс".
     1192   define button B-viewProcInfo
     1193        label "Информация"
     1194        size 15 by 1 tooltip "Информация о процесс".
     1195   define frame waitfram
     1196     v-waitfram-action01 format "x(72)" no-label skip
     1197     v-waitfram-action02 format "x(72)" no-label skip
     1198     v-waitfram-action03 format "x(72)" no-label skip
     1199     B-viewProcInfo
     1200     B-WaitFramStop at row 4 col 30
     1201     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1202     .
     1203   define new global shared variable mBatchMode as logical no-undo init ?.
     1204   define variable mFramBachModHandle as handle no-undo.
     1205   mFramBachModHandle = frame waitfram:handle.
     1206   define variable mFameOldVis as logical no-undo.
     1207   define variable mVisCUrentVin as logical no-undo.
     1208   if session:batch-mode
     1209   then
     1210      mBatchMode = yes.
     1211   if mBatchMode = ? then do:
     1212     mVisCUrentVin = current-window:visible.
     1213     mFameOldVis = mFramBachModHandle:visible.
     1214     mFramBachModHandle:visible  = yes.
     1215     mBatchMode = mFramBachModHandle:visible ne yes.
     1216     mFramBachModHandle:visible = mFameOldVis.
     1217     current-window:visible = mVisCUrentVin.
     1218   end.
     1219    if  log-manager:logfile-name ne ?
     1220     then DO:
     1221         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1222         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1223         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1224     end.
     1225   on choose of B-WaitFramStop in frame waitfram
     1226   do:
     1227     mWaitFramStop = yes.
     1228     mWaitFramStopUser = yes.
     1229   end.
     1230   function waitfram-check-timeout returns logical():
     1231      define variable vtime as int64 no-undo.
     1232      if mWaitFramStopTimeOut
     1233      then
     1234         return yes.
     1235      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1236      if     mWaitFramTimeOut ne ?
     1237         and mWaitFramTimeOut ne 0
     1238         and mWaitFramTimeOut lt vtime
     1239      then do:
     1240         mWaitFramStopTimeOut = yes.
     1241      end.
     1242      return mWaitFramStopTimeOut.
     1243   end.
     1244   procedure waitfram-hide :
     1245     if not session:batch-mode
     1246     then do
     1247     on error undo, return error return-value
     1248     :
     1249       pause 0 before-hide .
     1250       if not mBatchMode then
     1251         hide frame waitfram .
     1252     if     not mWaitFramView
     1253        and mWaitProcEvent
     1254     then
     1255       process events .
     1256     end.
     1257   end procedure.
     1258   procedure waitfram-show :
     1259     define input  parameter p-message as character no-undo .
     1260     define variable v-left-margin as integer   no-undo .
     1261     if not session:batch-mode
     1262     then do
     1263     on error undo, return error return-value
     1264     :
     1265       if length(p-message) <= 70 then do:
     1266         assign
     1267           v-left-margin = integer((70 - length(p-message)) / 2)
     1268         .
     1269         assign
     1270           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1271         .
     1272         assign
     1273           v-waitfram-action01 = " "
     1274           v-waitfram-action02 = " "
     1275                                    + fill(" ", v-left-margin)
     1276                                    + p-message
     1277           v-waitfram-action03 = " "
     1278         .
     1279       end.
     1280       else do:
     1281         define variable vRindex1 as integer no-undo.
     1282         define variable vRindex2 as integer no-undo.
     1283         vRindex1 = r-index(p-message," ",70).
     1284         if vRindex1 = 0
     1285         then
     1286            vRindex1 = 70.
     1287         if length(p-message)  <= vRindex1 + 70 then do:
     1288           assign
     1289             v-waitfram-action01 = " "
     1290             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1291             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1292           .
     1293         end.
     1294         else do:
     1295           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1296           if vRindex2 <= vRindex1
     1297           then
     1298              vRindex2 = vRindex1 + 70.
     1299           assign
     1300             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1301             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1302             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1303           .
     1304         end.
     1305       end.
     1306       B-viewProcInfo:visible   in frame waitfram = no.
     1307       B-viewProcInfo:sensitive in frame waitfram = no.
     1308       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1309       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1310       if  (   mWaitFramView
     1311          or  mWaitProcEvent)
     1312          and not mBatchMode
     1313       then
     1314          display
     1315             v-waitfram-action01 skip
     1316             v-waitfram-action02 skip
     1317             v-waitfram-action03 skip
     1318          with frame waitfram .
     1319       if     mWaitFramView
     1320          then do:
     1321             if     mWaitFramInterval ne ?
     1322                and not mBatchMode
     1323             then
     1324                wait-for go of frame waitfram pause mWaitFramInterval.
     1325          end.
     1326          else
     1327             if     mWaitProcEvent
     1328                and not mBatchMode
     1329             then
     1330                process events .
     1331     end.
     1332   end procedure.
     1333      procedure waitfram-show-this:
     1334         define input  parameter iInterval as int64 no-undo.
     1335         define variable vtime as int64 no-undo.
     1336         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1337         mWaitFramInterval = iInterval.
     1338         run waitfram-show (substitute("&1&2 &3&4" ,
     1339                                       mWaitFramTextBeg ,
     1340                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1341                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1342                                       mWaitFramTextEnd
     1343                                      )
     1344                           ).
     1345      end.
     1346      procedure WaitFramRunPause:
     1347         define input  parameter iInterval as dec no-undo.
     1348         define variable vStart  as datetime-tz no-undo.
     1349         define variable vend    as datetime-tz no-undo.
     1350         define variable vint as int64 no-undo.
     1351         define variable vOk as logical no-undo.
     1352         vStart = now.
     1353         vend   = vStart.
     1354         publish "WaitFramPause" (iInterval,output vOk).
     1355         vend   =  now.
     1356         vint = vend - vStart.
     1357         vint = iInterval - vint / 1000.
     1358         if     not mWaitFramStop
     1359            and (   vint > 0
     1360                 or (    not vOk
     1361                     and iInterval eq ?
     1362                     )
     1363                 )
     1364         then
     1365            run waitfram-show-this (iInterval).
     1366         vend   =  now.
     1367         vint = vend - vStart.
     1368         vint = iInterval - vint / 1000.
     1369         if     not mWaitFramStop
     1370            and vint > 0
     1371         then do:
     1372            run gbl/pause.p (vint * 1000).
     1373         end.
     1374         if iInterval ne ?
     1375         then
     1376            publish "WaitFramStop".
     1377         waitfram-check-timeout().
     1378      end.
     1379      procedure WaitFramWaitFor:
     1380         define input  parameter iInterval as dec no-undo.
     1381         assign
     1382            mWaitFramStartProc   = now
     1383            mWaitFramStopUser    = no
     1384            mWaitFramStopTimeOut = no
     1385         .
     1386         block-wait:
     1387         do while not mWaitFramStop:
     1388            run WaitFramRunPause (iInterval).
     1389            if  waitfram-check-timeout()
     1390            then do:
     1391               leave block-wait.
     1392            end.
     1393         end.
     1394         run waitfram-hide.
     1395      end.
     1396   procedure waitfram-join :
     1397     define input  parameter p-line-1  as character no-undo .
     1398     define input  parameter p-line-2  as character no-undo .
     1399     define input  parameter p-line-3  as character no-undo .
     1400     define output parameter p-message as character no-undo .
     1401     do
     1402     on error undo, return error return-value
     1403     :
     1404       assign
     1405         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1406                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1407                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1408       .
     1409     end.
     1410   end procedure.
     1411   function waitfram-join-function returns character
     1412     (input p-line-1 as character
     1413     ,input p-line-2 as character
     1414     ,input p-line-3 as character
     1415     ).
     1416     define variable v-message as character no-undo .
     1417     run waitfram-join in this-procedure
     1418       (input  p-line-1
     1419       ,input  p-line-2
     1420       ,input  p-line-3
     1421       ,output v-message
     1422       ) .
     1423     return v-message .
     1424   end function .
