      564   procedure create_obj-list :
      565      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      566      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      567      do
      568      on error undo, return error return-value
      569      :
      570         define buffer cli-obj for ub.clients .
      571         define variable p-var as integer no-undo .
      572         define buffer buf_obj-list for obj-list .
      573         find last buf_obj-list  use-index pi no-error .
      574         if available buf_obj-list
      575         then
      576            p-var = buf_obj-list.obj-id + 1.
      577         else
      578            p-var = 1.
      579         find first cli-obj where
      580                   cli-obj.obj-type = p-obj-type
      581               and cli-obj.obj-code = p-obj-code
      582         no-lock no-error.
      583         if available cli-obj
      584         then do:
      585            create buf_obj-list.
      586            assign
      587               buf_obj-list.obj-id   = p-var
      588               buf_obj-list.obj-code = cli-obj.obj-code
      589               buf_obj-list.obj-type = cli-obj.obj-type
      590               buf_obj-list.obj-name = cli-obj.obj-name
      591               buf_obj-list.db-num   = cli-obj.db-num
      592            .
      593         end.
      594      end.
      595   end.
