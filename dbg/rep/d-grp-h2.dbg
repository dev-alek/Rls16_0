      455   procedure prn-lib-reportviewer :
      456     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      457     define input parameter p-report-name-html as character no-undo .
      458     define input parameter p-param        as character no-undo .
      459     define variable v-excel           as character no-undo init 'TRUE' .
      460     define variable v-value-character as character no-undo .
      461     define variable v-value-integer   as character no-undo .
      462     define variable v-value-date      as date      no-undo .
      463     define variable v-value-decimal   as decimal   no-undo .
      464     define variable rep-excel         as logical   no-undo .
      465     define variable excel-string      as character no-undo .
      466     define variable v-param-type      as character no-undo .
      467     define variable v-tth             as handle    no-undo .
      468     run adm/shattri.p (
      469       input "get":U
      470       ,input  ""
      471       ,input  0
      472       ,input  'report-glob':U
      473       ,input  'rep-excel':U
      474       ,output v-value-character
      475       ,output v-value-date
      476       ,output v-value-decimal
      477       ,output v-value-integer
      478       ,output rep-excel
      479       ,output v-param-type
      480       ,INPUT-OUTPUT table-handle v-tth
      481       )  .
      482     if rep-excel then v-excel = "TRUE" .
      483     else v-excel = "FALSE" .
      484     if p-param eq ""
      485     then
      486        p-param = "EXCEL:" + v-excel.
      487     else
      488        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      489     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      490   end procedure.
