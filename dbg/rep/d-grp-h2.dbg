      998   define variable v-dec-sep          as character no-undo init ? .
      999   define variable v-th-sep           as character no-undo init ? .
     1000   define variable v-r-col-num        as integer no-undo .
     1001   define variable v-reg-replace      as logical no-undo .
     1002   define variable v-date-col-format  as character no-undo .
     1003   DEFINE VARIABLE last-col-num as integer no-undo.
     1004   run gbl/getlocal.p (
     1005                     output v-dec-sep
     1006                    ,output v-th-sep
     1007                    ,output v-sdate
     1008                    ,output v-shortdate
     1009                    ) no-error .
     1010   assign
     1011   v-reg-replace = NOT (v-dec-sep = ".":U and v-th-sep = chr(44))
     1012                   AND (v-dec-sep <> ? and v-th-sep <> ?)
     1013   .
     1014     FUNCTION supress-null RETURNS CHARACTER ( INPUT p-string  AS CHARACTER,
     1015                                               INPUT p-dec-sep AS CHARACTER  ) :
     1016       DEFINE VARIABLE v-string AS CHARACTER NO-UNDO.
     1017       IF TRIM( p-string ) = "0"                    OR
     1018          TRIM( p-string ) = "0" + p-dec-sep + "00" OR
     1019          TRIM( p-string ) =       p-dec-sep + "00" OR
     1020          TRIM( p-string ) =       p-dec-sep + "0"  OR
     1021          TRIM( p-string ) = "0" + p-dec-sep + "0"  THEN DO: ASSIGN v-string = "":U.     END.
     1022                                                    ELSE DO: ASSIGN v-string = p-string. END.
     1023       RETURN ( TRIM( v-string ) ).
     1024     END FUNCTION.
     1025   FUNCTION reg-output returns character( input p-string as character
     1026                                         ,input p-private-data as character
     1027                                         ,input p-replace as logical
     1028                                         ,input p-supress as logical
     1029                                         ,input p-dec-sep as character
     1030                                         ,input p-th-sep as character
     1031                                         ):
     1032   DEFINE VARIABLE v-reg-output as character no-undo .
     1033   DEFINE VARIABLE v-data-type as character no-undo .
     1034   DEFINE VARIABLE v-progress-format as character no-undo .
     1035   assign
     1036   v-progress-format = entry(1, p-private-data, chr(4))
     1037   v-data-type = entry(2, p-private-data, chr(4))
     1038   .
     1039   if p-string = ? then return chr(63).
     1040   if (v-data-type = "INTEGER"
     1041       OR v-data-type = "DECIMAL" ) THEN DO:
     1042     IF p-replace THEN DO:
     1043       assign
     1044         v-reg-output = replace( p-string
     1045                                         ,chr(44)
     1046                                         ,"":U
     1047                                       )
     1048         v-reg-output = trim(v-reg-output)
     1049       .
     1050     END.
     1051     else do:
     1052       v-reg-output = p-string.
     1053     end.
     1054     IF p-supress THEN DO: ASSIGN v-reg-output = supress-null( TRIM( v-reg-output ), p-dec-sep ). END.
     1055     return v-reg-output.
     1056   end.
     1057     return p-string.
     1058   END FUNCTION.
     1059   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1060   DEFINE SHARED temp-table grp-h no-undo
