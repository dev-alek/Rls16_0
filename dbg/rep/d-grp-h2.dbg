     1078   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   DEFINE  temp-table full-grp no-undo
     1080       field grp-code like ub.gds-grp.node-code
     1081       field full-name like ub.goods.grp-name
