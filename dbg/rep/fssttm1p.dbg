       93   procedure cur-time :
       94      define output parameter p-today as date      no-undo .
       95      define output parameter p-time  as integer   no-undo .
       96     do
       97     on error undo, return error
       98     :
       99       define variable v-date1 as date      no-undo .
      100       define variable v-date2 as date      no-undo .
      101       define variable v-time  as integer   no-undo .
      102       assign
      103         v-date1 = today
      104         v-time  = time
      105         v-date2 = today
      106       .
      107       if v-date1 <> v-date2
      108       then do:
      109         assign
      110           v-date1 = today
      111           v-time  = v-time
      112         .
      113       end.
      114       assign
      115         p-today = v-date1
      116         p-time  = v-time
      117       .
      118     end.
      119   end.
      120   function cur-time-date returns character
      121   :
      122     return string(today, '99/99/9999':U) .
      123   end.
      124   function cur-time-mjd returns decimal
      125   :
      126     define variable v-date as date      no-undo .
      127     define variable v-time as integer   no-undo .
      128     run cur-time in this-procedure
      129       (output v-date
      130       ,output v-time
      131       ) .
      132     return integer(v-date) - 2400002 + (v-time / 86400) .
      133   end.
      134   function cur-time-get-ending-index returns integer
      135   (input p-number as integer
      136   )
      137   :
      138     if p-number < 0
      139     or p-number = ?
      140     then do:
      141       return 1 .
      142     end.
      143     define variable v-rest as integer   no-undo .
      144     assign
      145       p-number = p-number modulo 100
      146     .
      147     if p-number < 20
      148     then do:
      149       assign
      150         v-rest = p-number
      151       .
      152     end.
      153     else do:
      154       assign
      155         v-rest = p-number modulo 10
      156       .
      157     end.
      158     case v-rest :
      159       when 1
      160       then do:
      161         return 2 .
      162       end.
      163       when 2 or
      164       when 3 or
      165       when 4
      166       then do:
      167         return 3 .
      168       end.
      169       otherwise do:
      170         return 1 .
      171       end.
      172     end case .
      173   end.
      174   procedure cur-time-mjd-to-date :
      175      define input  parameter i-mjd-diff as decimal no-undo.
      176      define output parameter o-Date     as date    no-undo.
      177      define output parameter o-Time     as integer no-undo.
      178      define variable v-day-number as integer   no-undo .
      179      if    i-mjd-diff < 0
      180         or i-mjd-diff = ?
      181      then do:
      182         return "?" .
      183      end.
      184      assign
      185         v-day-number = truncate(i-mjd-diff,0).
      186         o-Date = date(v-day-number + 2400002).
      187         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189   end.
      190   function cur-time-mjd-to-string returns character
      191   (input p-mjd-diff as decimal
      192   )
      193   :
      194     define variable v-day-number as integer   no-undo .
      195     define variable v-seconds    as integer   no-undo .
      196     define variable v-hour       as integer   no-undo .
      197     define variable v-min        as integer   no-undo .
      198     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      199     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      200     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      201     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      202     if p-mjd-diff < 0
      203     or p-mjd-diff = ?
      204     then do:
      205       return "?" .
      206     end.
      207     assign
      208       v-day-number = integer(truncate(p-mjd-diff,0))
      209       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      210     .
      211     if v-seconds > 86400
      212     then do:
      213       assign
      214         v-seconds = 86400 - 1
      215       .
      216     end.
      217     if v-seconds < 0
      218     then do:
      219       assign
      220         v-seconds = 0
      221       .
      222     end.
      223     assign
      224       v-hour = truncate(v-seconds / 3600, 0)
      225     .
      226     assign
      227       v-seconds = v-seconds modulo 3600
      228     .
      229     assign
      230       v-min = truncate(v-seconds / 60, 0)
      231     .
      232     assign
      233       v-seconds = v-seconds modulo 60
      234     .
      235     return
      236         (if v-day-number <> 0
      237           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      238           else ""
      239         )
      240       + (if v-day-number <> 0 or v-hour <> 0
      241           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      242           else ""
      243         )
      244       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      245           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      246           else ""
      247         )
      248       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      249       .
      250   end.
      251   function cur-time-string returns character
      252   :
      253     define variable v-date as date      no-undo .
      254     define variable v-time as integer   no-undo .
      255     run cur-time in this-procedure
      256       (output v-date
      257       ,output v-time
      258       ) .
      259     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      260   end.
      261   function cur-time-string-sec returns character
      262   :
      263     define variable v-date as date      no-undo .
      264     define variable v-time as integer   no-undo .
      265     run cur-time in this-procedure
      266       (output v-date
      267       ,output v-time
      268       ) .
      269     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      270   end.
      271   function cur-time-custom  returns character
      272   (input p-prefix as character
      273   ,input p-date-format as character
      274   ,input p-delimiter as character
      275   ,input p-time-format as character
      276   ,input p-suffix as character
      277   )
      278   :
      279     define variable v-date as date      no-undo .
      280     define variable v-time as integer   no-undo .
      281     run cur-time in this-procedure
      282       (output v-date
      283       ,output v-time
      284       ) .
      285     return
      286       p-prefix
      287       + string(v-date, p-date-format)
      288       + p-delimiter
      289       + string(v-time, p-time-format)
      290       + p-suffix
      291       .
      292   end.
      293   function cur-time-print  returns character
      294   :
      295     define variable v-date as date      no-undo .
      296     define variable v-time as integer   no-undo .
      297     run cur-time in this-procedure
      298       (output v-date
      299       ,output v-time
      300       ) .
      301     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      302   end.
      303   function cur-time-datetime returns datetime
      304   :
      305     define variable v-char as character no-undo .
      306     define variable v-datetime as datetime no-undo .
      307     v-char = cur-time-string().
      308     v-datetime = datetime(v-char).
      309     return  v-datetime.
      310   end.
      311   function cur-time-string-msec returns character
      312   :
      313     define variable v-date as datetime  no-undo .
      314     v-date = now.
      315     return string(v-date) .
      316   end.
      317   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      318   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      319   define new shared variable RepPathName        as character no-undo .
      320   define new shared variable PrintRubl          as logical   no-undo .
      321   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      322   define  stream PrnLibStream.
      323   procedure prn-lib-prn-file :
      324     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      325     define input parameter p-DIsabledoptions as integer no-undo .
      326     define variable v-report-name as character no-undo .
      327     define variable v-user-action as character no-undo .
      328     define variable v-printed     as logical   no-undo .
      329     define variable v-exist       as logical   no-undo .
      330     do
      331       on error undo, return error
      332       :
      333       run prn-lib-get-report-name  in this-procedure (
      334         input parParentProc
      335         ,output v-report-name
      336         ).
      337   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      339     (input  v-report-name
      340     ,input  2
      341     ,output v-exist
      342     )  .
      343       if NOT v-exist then
      344       DO:
      345         Message
      346           "Нет заданий на печать ! "
      347           view-as alert-box .
      348         Return  .
      349       End.
      350       run gbl/prnfilen.w
      351         (input  ""
      352         ,input  p-DisabledOptions
      353         ,input  string(v-report-name )
      354         ,input  7
      355         ,output v-user-action
      356         ,output v-printed
      357         ) .
      358       if v-printed then
      359       do:
      360         return "YES" .
      361       end.
      362       else
      363       do:
      364         return "NO" .
      365       end.
      366     end.
      367   end procedure.
      368   procedure prn-lib-open-stream :
      369     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      370     define input parameter p-page-size    as integer no-undo .
      371     define input parameter p-is-stream    as logical no-undo .
      372     define input parameter p-append       as logical no-undo .
      373     define variable v-report-name as character no-undo .
      374     do
      375       on error undo, return error
      376       :
      377       run prn-lib-get-report-name  in this-procedure (
      378         input parParentProc
      379         ,output v-report-name
      380         ).
      381       if p-is-stream then
      382       do:
      383         if p-append then
      384         do:
      385           output stream PrnLibStream to value( v-report-name )
      386             page-size value(p-page-size) append .
      387         end.
      388         if not p-append then
      389         do:
      390           output stream PrnLibStream to value( v-report-name )
      391             page-size value(p-page-size) .
      392         end.
      393       end.
      394       if not p-is-stream then
      395       do:
      396         if p-append then
      397         do:
      398           output to value( v-report-name )
      399             page-size value(p-page-size) append .
      400         end.
      401         if not p-append then
      402         do:
      403           output to value( v-report-name )
      404             page-size value(p-page-size) .
      405         end.
      406       end.
      407     end.
      408   end procedure.
      409   procedure prn-lib-open-exp :
      410     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      411     define input parameter p-is-stream    as logical no-undo .
      412     define input parameter p-is-append    as logical no-undo .
      413     define output parameter p-ReportFileName as char init "report" no-undo.
      414     define output parameter p-process as logical no-undo .
      415     define variable glog as logical no-undo .
      416     do
      417       on error undo, return error
      418       :
      419       SYSTEM-DIALOG GET-FILE p-ReportFileName
      420         TITLE      "Укажите путь"
      421         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      422         ASK-OVERWRITE
      423         CREATE-TEST-FILE
      424         SAVE-AS
      425         USE-FILENAME
      426         DEFAULT-EXTENSION "txt"
      427         UPDATE glog
      428         .
      429       if not glog then  return.
      430       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      431       if p-is-stream then
      432       do:
      433         if p-is-append then
      434         do:
      435           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      436         end.
      437         else
      438         do:
      439           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      440         end.
      441       end.
      442       else
      443       do:
      444         if p-is-append then
      445         do:
      446           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      447         end.
      448         else
      449         do:
      450           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      451         end.
      452       end.
      453       p-process = yes.
      454     end.
      455   end procedure.
      456   procedure prn-lib-get-report-name :
      457     define input parameter parParentProc  as widget-handle no-undo.
      458     define output parameter p-report-name as character no-undo .
      459     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      460   end procedure.
      461   procedure prn-lib-reportviewer-report-name :
      462     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      463     define input parameter p-report-name-html as character no-undo .
      464     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      465   end procedure.
      466   procedure prn-lib-reportviewer :
      467     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      468     define input parameter p-report-name-html as character no-undo .
      469     define input parameter p-param        as character no-undo .
      470     define variable v-excel           as character no-undo init 'TRUE' .
      471     define variable v-value-character as character no-undo .
      472     define variable v-value-integer   as character no-undo .
      473     define variable v-value-date      as date      no-undo .
      474     define variable v-value-decimal   as decimal   no-undo .
      475     define variable rep-excel         as logical   no-undo .
      476     define variable excel-string      as character no-undo .
      477     define variable v-param-type      as character no-undo .
      478     define variable v-tth             as handle    no-undo .
      479     run adm/shattri.p (
      480       input "get":U
      481       ,input  ""
      482       ,input  0
      483       ,input  'report-glob':U
      484       ,input  'rep-excel':U
      485       ,output v-value-character
      486       ,output v-value-date
      487       ,output v-value-decimal
      488       ,output v-value-integer
      489       ,output rep-excel
      490       ,output v-param-type
      491       ,INPUT-OUTPUT table-handle v-tth
      492       )  .
      493     if rep-excel then v-excel = "TRUE" .
      494     else v-excel = "FALSE" .
      495     if p-param eq ""
      496     then
      497        p-param = "EXCEL:" + v-excel.
      498     else
      499        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      500     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      501   end procedure.
      502   def var vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      504   procedure paramls-clear :
      505     define buffer buf_temp-param for temp-param .
      506     do
      507     on error undo, return error return-value
      508     :
      509       for each buf_temp-param
      510       on error undo, return error
      511       :
      512         delete buf_temp-param .
      513       end.
      514     end.
      515   end procedure.
      516   procedure paramls-write :
      517     define input  parameter p-code     as character no-undo .
      518     define input  parameter p-sub-code as character no-undo .
      519     define input  parameter p-value    as character no-undo .
      520     define buffer buf_temp-param for temp-param .
      521     do
      522     on error undo, return error return-value
      523     :
      524       find first buf_temp-param
      525         where buf_temp-param.param-code     = p-code
      526           and buf_temp-param.param-sub-code = p-sub-code
      527         no-error .
      528       if not available buf_temp-param then do:
      529         create buf_temp-param .
      530         assign
      531           buf_temp-param.param-code     = p-code
      532           buf_temp-param.param-sub-code = p-sub-code
      533         .
      534       end.
      535       assign
      536         buf_temp-param.param-value = p-value
      537       .
      538     end.
      539   end procedure.
      540   procedure paramls-read :
      541     define input  parameter p-code          as character no-undo .
      542     define input  parameter p-sub-code      as character no-undo .
      543     define input  parameter p-default-value as character no-undo .
      544     define output parameter p-value         as character no-undo .
      545     define buffer buf_temp-param for temp-param .
      546     do
      547     on error undo, return error return-value
      548     :
      549       find first buf_temp-param
      550         where buf_temp-param.param-code     = p-code
      551           and buf_temp-param.param-sub-code = p-sub-code
      552         no-error .
      553       if available buf_temp-param then do:
      554         assign
      555           p-value = buf_temp-param.param-value
      556         .
      557       end.
      558       else do:
      559         assign
      560           p-value = p-default-value
      561         .
      562       end.
      563     end.
      564   end procedure.
      565   procedure paramls-append :
      566     define input  parameter p-code     as character no-undo .
      567     define input  parameter p-sub-code as character no-undo .
      568     define input  parameter p-value    as character no-undo .
      569     define buffer buf_temp-param for temp-param .
      570     do
      571     on error undo, return error return-value
      572     :
      573       find first buf_temp-param
      574            where buf_temp-param.param-code     = p-code
      575              and buf_temp-param.param-sub-code = p-sub-code
      576         no-error .
      577       if not available buf_temp-param then do:
      578         create buf_temp-param .
      579         assign
      580           buf_temp-param.param-code     = p-code
      581           buf_temp-param.param-sub-code = p-sub-code
      582           buf_temp-param.param-value    = p-value
      583         .
      584       end.
      585       else do:
      586           assign
      587               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      588           .
      589       end.
      590     end.
      591   end procedure.
      592   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      593     run mainmenu_getcntxt in parparentproc
      594       (output v-cntxt-db-num
      595       ,output v-cntxt-userid
      596       ,output v-cntxt-level
      597       ,output v-cntxt-host-code-obj
      598       ,output v-cntxt-obj-type
      599       ,output v-cntxt-obj-code
      600       ,output v-cntxt-db-num-obj
      601       ,output v-cntxt-is-admin
      602       ) .
      603   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   procedure factord :
      605     define input  parameter p-fact-date            as date    no-undo .
      606     define input  parameter p-fact-time            as integer no-undo .
      607     define input  parameter p-fact-num             as integer no-undo .
      608     define input  parameter p-shift-date           as date    no-undo .
      609     define input  parameter p-shift-num            as integer no-undo .
      610     define input  parameter p-shift-on             as logical no-undo .
      611     define output parameter p-fact-order           as decimal no-undo .
      612     define output parameter p-shift-end-fact-order as decimal no-undo .
      613     define output parameter p-day-end-fact-order   as decimal no-undo .
      614     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      615     if p-fact-date = ?
      616     then do:
      617       return error "Не указана фактическая дата" .
      618     end.
      619     define variable v-fact-date-num as integer no-undo .
      620     assign
      621       v-fact-date-num = integer(p-fact-date)
      622     .
      623     if p-fact-num = ?
      624     or p-fact-num = 0
      625     then do:
      626       return error "Не задан p-fact-num " + string(p-fact-num) .
      627     end.
      628     if p-fact-num < 0
      629     then do:
      630       return error "Отрицательный fact-num " + string(p-fact-num) .
      631     end.
      632     if p-fact-num >= 100000000
      633     then do:
      634       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      635     end.
      636     if p-shift-on = true
      637     then do:
      638       if p-shift-date = ?
      639       then do:
      640         return error "Не задана дата смены" .
      641       end.
      642       if p-shift-num = ?
      643       or p-shift-num = 0
      644       then do:
      645         return error "Не задан номер смены" .
      646       end.
      647     end.
      648     else do:
      649       assign
      650         p-shift-date = p-fact-date
      651         p-shift-num  = 24
      652       .
      653     end.
      654     define variable v-shift-offset as integer no-undo .
      655     if p-shift-date = p-fact-date
      656     then do:
      657       assign
      658         v-shift-offset = 1
      659       .
      660     end.
      661     if p-shift-date < p-fact-date
      662     then do:
      663       assign
      664         v-shift-offset = 0
      665       .
      666     end.
      667     if p-shift-date > p-fact-date
      668     then do:
      669       message
      670         vss-workfile vss-revision vss-description skip
      671         "Неправильная дата закрытия смены" skip
      672         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      673         view-as alert-box error .
      674       undo, return error
      675         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      676           ,string(p-fact-date, '99/99/9999':U)
      677           ,string(p-shift-date, '99/99/9999':U)
      678           )
      679       .
      680     end.
      681     if p-shift-num < 1
      682     or p-shift-num > 24
      683     then do:
      684       message
      685         vss-workfile vss-revision vss-description skip
      686         "Неправильный номер смены" skip
      687         "p-shift-num" p-shift-num skip
      688         view-as alert-box error .
      689       undo, return error return-value .
      690     end.
      691     assign
      692       p-fact-order           = v-fact-date-num
      693                              + v-shift-offset * 0.5
      694                              + p-shift-num    * 0.02 - 0.01
      695                              + p-fact-num     * 0.0000000001
      696       p-shift-end-fact-order = v-fact-date-num
      697                              + v-shift-offset * 0.5
      698                              + p-shift-num    * 0.02
      699       p-day-end-fact-order   = v-fact-date-num
      700                              + 0.99
      701     .
      702     if p-fact-order           <= v-fact-date-num
      703     or p-shift-end-fact-order <= v-fact-date-num
      704     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      705     or p-shift-end-fact-order >= p-day-end-fact-order
      706     then do:
      707       message
      708         vss-workfile vss-revision vss-description skip
      709         "Внутренняя ошибка при генерации фактического номера" skip
      710         "p-fact-date"            p-fact-date            skip
      711         "p-fact-time"            p-fact-time            skip
      712         "p-fact-num"             p-fact-num             skip
      713         "p-shift-date"           p-shift-date           skip
      714         "p-shift-num"            p-shift-num            skip
      715         "p-shift-on"             p-shift-on             skip
      716         "p-shift-end-fact-order" p-shift-end-fact-order skip
      717         "p-day-end-fact-order"   p-day-end-fact-order   skip
      718         "v-fact-date-num"        v-fact-date-num        skip
      719         view-as alert-box error .
      720       undo, return error return-value .
      721     end.
      722   end procedure.
      723   procedure day-begin-fact-order :
      724     define input  parameter p-fact-date            as date    no-undo .
      725     define output parameter p-day-begin-fact-order as decimal no-undo .
      726     do
      727     on error undo, return error return-value
      728     :
      729       if p-fact-date = ?
      730       then do:
      731         assign
      732           p-day-begin-fact-order = 0
      733         .
      734       end.
      735       else do:
      736         assign
      737           p-day-begin-fact-order = integer(p-fact-date)
      738         .
      739       end.
      740     end.
      741   end procedure.
      742   procedure factord-max-fact-order :
      743     define output parameter p-max-fact-order as decimal   no-undo .
      744     do
      745     on error undo, return error return-value
      746     :
      747       run day-begin-fact-order in this-procedure
      748         (input  date(1, 1, 5000)
      749         ,output p-max-fact-order
      750         ) .
      751     end.
      752   end procedure.
      753   procedure factord-cut-archive :
      754     define input  parameter p-obj-type             as character no-undo .
      755     define input  parameter p-obj-code             as integer   no-undo .
      756     define input  parameter p-fact-date            as date      no-undo .
      757     define output parameter p-shift-on             as logical   no-undo .
      758     define output parameter p-shift-date           as date      no-undo .
      759     define output parameter p-shift-num            as integer   no-undo .
      760     define output parameter p-day-end-fact-order   as decimal   no-undo .
      761     define output parameter p-shift-end-fact-order as decimal   no-undo .
      762     define variable v-fact-order as decimal   no-undo .
      763     define buffer buf_shift-obj for ub.shift-obj .
      764     do
      765     on error undo, return error return-value
      766     :
      767   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      769     (input  p-obj-type
      770     ,input  p-obj-code
      771     ,input  'shift-on=request'
      772     ,output p-shift-on
      773     ) no-error .
      774       if error-status :error
      775       then do:
      776         message
      777           vss-workfile vss-revision vss-description skip
      778           "Ошибка при определении атрибута объекта" skip
      779           "Объект" p-obj-type p-obj-code skip
      780           error-status :get-message(1) skip
      781           return-value skip
      782           view-as alert-box error .
      783         undo, return error return-value .
      784       end.
      785       if p-shift-on = false
      786       then do:
      787         assign
      788           p-shift-date               = ?
      789           p-shift-num                = 0
      790         .
      791       end.
      792       else do:
      793         find first buf_shift-obj share-lock
      794           where buf_shift-obj.obj-type   = p-obj-type
      795             and buf_shift-obj.obj-code   = p-obj-code
      796             and buf_shift-obj.shift-date > p-fact-date
      797           use-index pi
      798           no-error .
      799         if not available buf_shift-obj
      800         or buf_shift-obj.status_ <> 'зкр':U
      801         then do:
      802           message
      803             vss-workfile vss-revision vss-description skip
      804             "Невозможно вычислить последнюю смену" skip
      805             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      806             "Объект" p-obj-type p-obj-code skip
      807             "Дата" p-fact-date skip
      808             view-as alert-box error .
      809           undo, return error return-value .
      810         end.
      811         find last buf_shift-obj share-lock
      812           where buf_shift-obj.obj-type = p-obj-type
      813             and buf_shift-obj.obj-code = p-obj-code
      814             and buf_shift-obj.shift-date <= p-fact-date
      815           use-index pi
      816           no-error .
      817         if available buf_shift-obj
      818         then do:
      819           if  buf_shift-obj.status_ = 'зкр':U
      820           then do:
      821             assign
      822               p-shift-date = buf_shift-obj.shift-date
      823               p-shift-num  = buf_shift-obj.shift-num
      824             .
      825           end.
      826           else do:
      827             message
      828               vss-workfile vss-revision vss-description skip
      829               "Невозможно вычислить последнюю смену" skip
      830               "Статус смены отличен от статуса" 'зкр':U skip
      831               "Объект" p-obj-type p-obj-code skip
      832               "Дата" p-fact-date skip
      833               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      834               view-as alert-box error .
      835             undo, return error return-value .
      836           end.
      837         end.
      838         else do:
      839           assign
      840             p-shift-date = p-fact-date - 1
      841             p-shift-num  = 1
      842           .
      843         end.
      844       end.
      845       run factord in this-procedure
      846         (input  p-fact-date
      847         ,input  1
      848         ,input  1
      849         ,input  p-shift-date
      850         ,input  p-shift-num
      851         ,input  p-shift-on
      852         ,output v-fact-order
      853         ,output p-shift-end-fact-order
      854         ,output p-day-end-fact-order
      855         ) no-error .
      856       if error-status :error
      857       then do:
      858         message
      859           vss-workfile vss-revision vss-description skip
      860           "Ошибка при вызове процедуры factord"
      861           error-status :get-message(1) skip
      862           return-value skip
      863           view-as alert-box error .
      864         undo, return error return-value .
      865       end.
      866     end.
      867   end procedure.
      868   procedure factord-lock-shift :
      869     define input  parameter p-obj-type  as character no-undo .
      870     define input  parameter p-obj-code  as integer   no-undo .
      871     define input  parameter p-fact-date as date      no-undo .
      872     define parameter buffer buf_shift-obj for ub.shift-obj .
      873     define variable v-shift-on      as logical   no-undo .
      874     define variable v-extra-message as character no-undo .
      875     define variable v-error as character no-undo .
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,input  'shift-on=request'
      884     ,output v-shift-on
      885     ) no-error .
      886       if error-status :error
      887       then do:
      888         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      889         undo, return error v-error .
      890       end.
      891       if v-shift-on = true
      892       then do:
      893         find first buf_shift-obj share-lock
      894           where buf_shift-obj.obj-type   = p-obj-type
      895             and buf_shift-obj.obj-code   = p-obj-code
      896             and buf_shift-obj.shift-date > p-fact-date
      897           use-index pi
      898           no-error .
      899         if not available buf_shift-obj
      900         or buf_shift-obj.status_ <> 'зкр':U
      901         then do:
      902           find last buf_shift-obj
      903             where buf_shift-obj.obj-type = p-obj-type
      904               and buf_shift-obj.obj-code = p-obj-code
      905               and buf_shift-obj.status_  = 'зкр':U
      906             use-index stts
      907             no-error .
      908           if available buf_shift-obj
      909           then do:
      910             assign
      911               v-extra-message =
      912                     substitute("Дата начала последеней закрытой смены на объекте &1"
      913                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      914                               )
      915             .
      916           end.
      917           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      918           undo, return error v-error .
      919         end.
      920       end.
      921     end.
      922   end procedure.
      923   procedure factord-end-day :
      924     define input  parameter p-fact-date            as date    no-undo .
      925     define output parameter p-day-end-fact-order   as decimal no-undo .
      926     do
      927     on error undo, return error return-value
      928     :
      929       if p-fact-date = ?
      930       then do:
      931         return error "Не указана фактическая дата" .
      932       end.
      933       assign
      934         p-day-end-fact-order = integer(p-fact-date) + 0.99
      935       .
      936     end.
      937   end procedure.
      938   procedure factord-to-date :
      939     define input  parameter p-fact-order as decimal no-undo .
      940     define output parameter p-fact-date  as date    no-undo .
      941     define variable v-ref-date  as date      no-undo .
      942     define variable v-ref-delta as integer   no-undo .
      943     do
      944     on error undo, return error return-value
      945     :
      946       if p-fact-order = ?
      947       or p-fact-order = 0
      948       then do:
      949         return error "Не указан fact-order" .
      950       end.
      951       assign
      952         v-ref-date  = date(1, 1, 2000)
      953       .
      954       assign
      955         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      956       .
      957       assign
      958         p-fact-date = v-ref-date + v-ref-delta
      959       .
      960     end.
      961   end procedure.
      962   procedure factord-to-fact-num :
      963     define input  parameter p-fact-order as decimal no-undo .
      964     define output parameter p-fact-num   as integer no-undo .
      965     define variable v-fact-order-trunc as decimal no-undo .
      966     do
      967     on error undo, return error return-value
      968     :
      969       if p-fact-order = ?
      970       or p-fact-order = 0
      971       then do:
      972         return error "Не указан fact-order" .
      973       end.
      974       assign
      975        v-fact-order-trunc = truncate(p-fact-order, 2)
      976       .
      977       assign
      978         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      979       .
      980     end.
      981   end procedure.
      982   procedure factord-to-shift-num :
      983     define input  parameter p-fact-order as decimal no-undo .
      984     define output parameter p-shift-num   as integer no-undo .
      985     define variable  p-shift-numd  as decimal   no-undo .
      986     define variable v-fact-order-trunc as decimal no-undo .
      987     do
      988     on error undo, return error return-value
      989     :
      990       if p-fact-order = ?
      991       or p-fact-order = 0
      992       then do:
      993         return error "Не указан fact-order" .
      994       end.
      995       assign
      996        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      997       .
      998       if v-fact-order-trunc < 0.5 then do:
      999         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1000       end.
     1001       assign
     1002         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1003         .
     1004        assign
     1005         p-shift-num = truncate (p-shift-numd , 0)
     1006       .
     1007     end.
     1008   end procedure.
     1009   define variable vss-include-info10 as character format "X(65)" no-undo
     1010   initial "@(#)$Workfile$ $Revision$".
     1011   define stream excel-line.
     1012   define stream excel-cell.
     1013   define temp-table temp_cell-data no-undo
     1014       field data-key as character
     1015       field data-value as character
     1016       index pi is primary unique data-key
     1017   .
     1018   define temp-table temp_line-data no-undo
     1019       field data-key     as character
     1020       field xl-line-id   as integer
     1021       field linenum     as integer
     1022       field prndoccode as character
     1023       field rpcschet   as character
     1024       field debetsum    as character
     1025       field creditsum   as character
     1026       index pi is primary unique xl-line-id
     1027   .
     1028   define variable v-fssttxl1-current-data-row     as integer      no-undo.
     1029   define variable v-fssttxl1-cell-file-name       as character    no-undo.
     1030   define variable v-fssttxl1-data-file-name       as character    no-undo.
     1031   procedure fssttxl1-init :
     1032       define buffer buf_temp_cell-data        for temp_cell-data.
     1033   do
     1034   for buf_temp_cell-data
     1035   on error undo, return error
     1036   :
     1037       assign
     1038           v-fssttxl1-current-data-row = 0
     1039       .
     1040       run gbl/_tmpfile.p (
     1041             input "xd"
     1042           , input ".txt"
     1043           , output v-fssttxl1-data-file-name
     1044       ).
     1045       output stream excel-line to value( v-fssttxl1-data-file-name ).
     1046       run gbl/_tmpfile.p (
     1047             input "xc"
     1048           , input ".txt"
     1049           , output v-fssttxl1-cell-file-name
     1050       ).
     1051       output stream excel-cell to value( v-fssttxl1-cell-file-name ).
     1052       if printrubl
     1053       then do:
     1054           run fssttxl1-write-cell-data in this-procedure (
     1055                 input "valutCode":U
     1056               , input "0":U
     1057           ).
     1058       end.
     1059       else do:
     1060           run fssttxl1-write-cell-data in this-procedure (
     1061                 input "valutCode":U
     1062               , input "1":U
     1063           ).
     1064       end.
     1065       run fssttxl1-write-cell-data in this-procedure (
     1066             input "columnList":U
     1067           , input "linenum,prndoccode,rpcschet,debetsum,creditsum":U
     1068       ).
     1069       run fssttxl1-write-cell-data in this-procedure (
     1070             input "columnType":U
     1071           , input "I,S,S,D,D":U
     1072       ).
     1073       run fssttxl1-write-cell-data in this-procedure (
     1074             input "columnAmount":U
     1075           , input "5":U
     1076       ).
     1077       run fssttxl1-write-cell-data in this-procedure (
     1078             input "subtotalList":U
     1079           , input "":U
     1080       ).
     1081       run fssttxl1-write-cell-data in this-procedure (
     1082             input "subtotalType":U
     1083           , input "":U
     1084       ).
     1085       run fssttxl1-write-cell-data in this-procedure (
     1086             input "subtotalAmount":U
     1087           , input "0":U
     1088       ).
     1089   end.
     1090   end procedure.
     1091   procedure fssttxl1-close :
     1092   do
     1093   on error undo, return error
     1094   :
     1095       output stream excel-line close.
     1096       output stream excel-cell close.
     1097       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1098           export "exe/fssttm1.xlt":U.
     1099           export "exe/t_97.bas":U.
     1100           export v-fssttxl1-cell-file-name.
     1101           export v-fssttxl1-data-file-name.
     1102       output close.
     1103   end.
     1104   end procedure.
     1105   procedure fssttxl1-write-cell-data :
     1106   define input parameter p-data-key   as character        no-undo.
     1107   define input parameter p-data-value as character        no-undo.
     1108       define buffer buf_temp_cell-data     for temp_cell-data.
     1109   do
     1110   for buf_temp_cell-data
     1111   on error undo, return error
     1112   :
     1113       find first buf_temp_cell-data
     1114            where buf_temp_cell-data.data-key = p-data-key
     1115       no-error.
     1116       if not available buf_temp_cell-data
     1117       then do:
     1118           create buf_temp_cell-data.
     1119           assign
     1120               buf_temp_cell-data.data-key = p-data-key
     1121           .
     1122       end.
     1123       assign
     1124           buf_temp_cell-data.data-value = p-data-value
     1125       .
     1126       put stream excel-cell unformatted
     1127                           buf_temp_cell-data.data-key
     1128           chr(9)   buf_temp_cell-data.data-value
     1129           chr(10)
     1130       .
     1131   end.
     1132   end procedure.
     1133   procedure fssttxl1-write-line-data :
     1134   define input parameter p-linenum       as integer          no-undo.
     1135   define input parameter p-prndoccode   as character        no-undo.
     1136   define input parameter p-rpcschet     as character        no-undo.
     1137   define input parameter p-debetsum      as character        no-undo.
     1138   define input parameter p-creditsum     as character        no-undo.
     1139       define buffer buf_temp_line-data        for temp_line-data.
     1140   do
     1141   for buf_temp_line-data
     1142   on error undo, return error
     1143   :
     1144       for each buf_temp_line-data
     1145       :
     1146           delete buf_temp_line-data.
     1147       end.
     1148       create buf_temp_line-data.
     1149       assign
     1150           v-fssttxl1-current-data-row = v-fssttxl1-current-data-row + 1
     1151       .
     1152       assign
     1153       buf_temp_line-data.data-key     = "LD":U
     1154       buf_temp_line-data.xl-line-id   = v-fssttxl1-current-data-row
     1155       buf_temp_line-data.linenum      = p-linenum
     1156       buf_temp_line-data.prndoccode   = p-prndoccode
     1157       buf_temp_line-data.rpcschet      = p-rpcschet
     1158       buf_temp_line-data.debetsum     = p-debetsum
     1159       buf_temp_line-data.creditsum    = p-creditsum
     1160       .
     1161       put stream excel-line unformatted
     1162                           buf_temp_line-data.data-key
     1163           chr(9)   buf_temp_line-data.linenum
     1164           chr(9)   buf_temp_line-data.prndoccode
     1165           chr(9)   buf_temp_line-data.rpcschet
     1166           chr(9)   buf_temp_line-data.debetsum
     1167           chr(9)   buf_temp_line-data.creditsum
     1168           chr(10)
     1169       .
     1170   end.
     1171   end procedure.
     1172   procedure fssttxl1-run-excel :
     1173   define input parameter p-header-filename    as character        no-undo.
     1174   define input parameter p-data-filename      as character        no-undo.
     1175       define variable v-template-file-name    as character    no-undo.
     1176       define variable v-vb-file-name          as character    no-undo.
     1177       define buffer buf_temp-param for temp-param .
     1178   do
     1179   for buf_temp-param
     1180   on error undo, return error
     1181   :
     1182       create buf_temp-param.
     1183       assign
     1184           v-template-file-name    = search( "exe/t12_97.xlt" )
     1185           v-vb-file-name          = search( "exe/t_97.bas")
     1186       .
     1187       if v-template-file-name = ?
     1188       or v-template-file-name = "":U
     1189       then do:
     1190           message
     1191               "Ошибка имени файла шаблона."
     1192           view-as alert-box error.
     1193       end.
     1194       if v-vb-file-name = ?
     1195       or v-vb-file-name = "":U
     1196       then do:
     1197           message
     1198               "Ошибка имени файла кода обработки."
     1199           view-as alert-box error.
     1200       end.
     1201       run paramls-write in this-procedure (
     1202             input "template":U
     1203           , input "template-file-name":U
     1204           , input v-template-file-name
     1205       ).
     1206       run paramls-write in this-procedure (
     1207             input "template":U
     1208           , input "vb-file-name":U
     1209           , input v-vb-file-name
     1210       ).
     1211       run paramls-write in this-procedure (
     1212             input "data":U
     1213           , input "data-header-filename":U
     1214           , input p-header-filename
     1215       ).
     1216       run paramls-write in this-procedure (
     1217             input "data":U
     1218           , input "data-filename":U
     1219           , input p-data-filename
     1220       ).
     1221       run gbl/macroxlt.p (
     1222           input-output table buf_temp-param
     1223       ) no-error.
     1224       if error-status :error
     1225       then do:
     1226           message
     1227                    vss-workfile vss-revision vss-description
     1228               skip(1)
     1229               skip "Ошибка создания файла Excel."
     1230               skip return-value
     1231               skip trim(error-status :get-message(1))
     1232                    trim(error-status :get-message(2))
     1233                    trim(error-status :get-message(3))
     1234           view-as alert-box error.
     1235           undo, return error .
     1236       end.
     1237   end.
     1238   end procedure.
     1239   define variable glog as logical no-undo .
     1240   define variable Line as character no-undo .
     1241   define variable date_string as character no-undo .
     1242   define variable num-lines as integer no-undo .
     1243   define variable v-fill as character no-undo init "_".
     1244   define variable v-dops as character no-undo .
     1245   define variable v-chernovik as character no-undo .
     1246   define variable v-vo as character no-undo .
     1247   define variable v-debet like ub.fin-doc.sum-doc no-undo .
     1248   define variable v-credit like ub.fin-doc.sum-doc no-undo .
     1249   define variable v-debet-ob like ub.fin-doc.sum-doc no-undo .
     1250   define variable v-credit-ob like ub.fin-doc.sum-doc no-undo .
     1251   define variable v-my-side as logical no-undo .
     1252   define variable v-debet-str as character no-undo .
     1253   define variable v-credit-str as character no-undo .
     1254   define variable v-c-schet like ub.fin-statement-line.rp-c-schet no-undo .
     1255   define variable v-from-fact-order like ub.fin-doc.fact-order no-undo .
     1256   define variable v-to-fact-order like ub.fin-doc.fact-order no-undo .
     1257   define variable v-last-doc-fact-date as date no-undo .
     1258   define variable v-last-doc-str as character no-undo .
     1259   define variable v-from-sum as decimal no-undo .
     1260   define variable v-to-sum-doc as decimal no-undo .
     1261   define buffer buf_currency for ub.currency.
     1262   define buffer buf_fin-statement-line for ub.fin-statement-line.
     1263   define buffer buf_fin-doc for ub.fin-doc.
     1264   define buffer last_fin-doc for ub.fin-doc.
     1265   DEFINE FRAME extract
     1266   v-vo COLUMN-LABEL "ВО" format "X(4)"
     1267   buf_fin-statement-line.prn-doc-code COLUMN-LABEL "Номер документа"
     1268   buf_fin-statement-line.rp-c-schet COLUMn-LABEL "Номер корр. счета"
     1269   v-debet COLUMN-LABEL "Дебет!(-)"
     1270   v-credit COLUMN-LABEL "Кредит!(+)"
     1271   HEADER  string( "Страница " ) format "X(9)" AT 105 PAGE-NUMBER(PrnLibStream) AT 115 FORMAT ">>9" SKIP
     1272   Line format "X(134)"
     1273   with width 136 down  stream-io use-text  .
     1274   do
     1275   on error undo, return error return-value
     1276   :
     1277   define variable vss-include-info11 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1278   do:
     1279     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1280       (input  v-cntxt-db-num
     1281       ,input  v-cntxt-userid
     1282       ,input  0
     1283       ,input  'actn_reports_print':U
     1284       ,input  'firm':U
     1285       ,input  v-cntxt-host-code-obj
     1286       ,input  '':U
     1287       ,input  0
     1288       ,input  0
     1289       ,input  0
     1290       ,input  0
     1291       ,input  true
     1292       ,output glog
     1293       )  .
     1294   end.
     1295     if not glog then return.
     1296     Line = fill("-", 134).
     1297     date_string = replace(cur-time-string-sec(), chr(47), ".":U) .
     1298     find first buf_currency no-lock where
     1299               buf_currency.curr-code = buf_fin-statement.curr-code no-error .
     1300     if not available buf_currency then do:
     1301       return error .
     1302     end.
     1303     run day-begin-fact-order (
     1304         input  buf_fin-statement.start-date
     1305        ,output v-from-fact-order) .
     1306     run factord-end-day (
     1307         input  buf_fin-statement.end-date
     1308       ,output v-to-fact-order) .
     1309     find last last_fin-doc no-lock where
     1310               last_fin-doc.host-code = buf_Fin-statement.host-code
     1311           AND last_fin-doc.status_ = 'факт':U
     1312           AND last_fin-doc.fact-order < v-from-fact-order
     1313           AND last_fin-doc.receiver-code-schet = buf_Fin-statement.code-schet no-error .
     1314     if available last_fin-doc then do:
     1315       assign
     1316       v-last-doc-fact-date = last_fin-doc.fact-date
     1317       .
     1318     end.
     1319     else do:
     1320       assign
     1321       v-last-doc-fact-date = 01/01/1990
     1322       .
     1323     end.
     1324     find last last_fin-doc no-lock where
     1325               last_fin-doc.host-code = buf_Fin-statement.host-code
     1326           AND last_fin-doc.status_ = 'факт':U
     1327           AND last_fin-doc.fact-order < v-from-fact-order
     1328           AND last_fin-doc.payer-code-schet = buf_Fin-statement.code-schet no-error .
     1329     if available last_fin-doc then do:
     1330       assign
     1331       v-last-doc-fact-date = max(last_fin-doc.fact-date, v-last-doc-fact-date)
     1332       .
     1333     end.
     1334     else do:
     1335       assign
     1336       v-last-doc-fact-date = v-last-doc-fact-date
     1337       .
     1338     end.
     1339     assign
     1340     v-last-doc-str = if v-last-doc-fact-date = 01/01/1990
     1341                     then "":U
     1342                     else string(v-last-doc-fact-date, "99.99.9999":U)
     1343     .
     1344     assign
     1345     v-from-sum = buf_fin-statement.end-sum-rubl
     1346     .
     1347     run get-report-num  in parParentProc(output g#report-num).
     1348     output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1349     output close.
     1350     run fssttxl1-init in this-procedure.
     1351    if p-format <> 1
     1352    and p-format <> ?
     1353    and p-append
     1354    then do:
     1355     assign
     1356     p-format = ?
     1357     .
     1358     return.
     1359    end.
     1360     assign
     1361     Line = fill("_":U, 198)
     1362     .
     1363     assign
     1364     v-chernovik = if buf_fin-statement.status_ = 'новый':U
     1365                   then "Ч Е Р Н О В И К"
     1366                   else (fill( chr(32), 15))
     1367     .
     1368     run prn-lib-open-stream  in this-procedure (
     1369                                                 input parParentProc
     1370                                                 ,input 62
     1371                                                 ,input yes
     1372                                                 ,input p-append
     1373                                                 ).
     1374     FORM with FRAME extract  .
     1375     FORM HEADER
     1376     Line format "X(134)" SKIP
     1377     "Продолжение - на следующей странице" AT 30 SKIP
     1378     with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     1379     VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1380     run fssttxl1-write-cell-data in this-procedure ( input "h_datetime":U       , input date_string  ).
     1381     run fssttxl1-write-cell-data in this-procedure ( input "h_bankname":U       , input buf_fin-statement.bank-name  ).
     1382     run fssttxl1-write-cell-data in this-procedure ( input "h_bik":U       , input buf_fin-statement.bik  ).
     1383     run fssttxl1-write-cell-data in this-procedure ( input "h_corrschet":U       , input buf_fin-statement.c-schet  ).
     1384     run fssttxl1-write-cell-data in this-procedure ( input "h_cliname":U       , input buf_fin-statement.cli-name  ).
     1385     run fssttxl1-write-cell-data in this-procedure ( input "h_currcodename":U
     1386                                                     ,input substitute("&1/&2 &3"
     1387                                                                       ,buf_currency.curr-abbr
     1388                                                                       ,buf_currency.okv-code
     1389                                                                       ,buf_currency.curr-name )).
     1390     run fssttxl1-write-cell-data in this-procedure ( input "h_rschet":U       , input buf_fin-statement.r-schet ).
     1391     run fssttxl1-write-cell-data in this-procedure ( input "h_lastfindoc":U       , input v-last-doc-str ).
     1392     run fssttxl1-write-cell-data in this-procedure ( input "h_startsumdoc":U
     1393                                                      ,input substitute("Входящий остаток на начало дня &1: &2"
     1394                                                                        ,string(buf_fin-statement.start-date, "99/99/9999")
     1395                                                                        ,string( v-from-sum, "->>>,>>>,>>>,>>9.99"))).
     1396     PUT  STREAM PrnLibStream unformatted
     1397     line skip(1)
     1398     SPACE(25) "ВЫПИСКА ИЗ ЛИЦЕВОГО СЧЕТА КЛИЕНТА"  space(25) date_string skip(1)
     1399     buf_fin-statement.bank-name space(10) "БИК" chr(32) buf_fin-statement.bik space(10) "корр. счет" chr(32) buf_fin-statement.c-schet skip(1)
     1400     "Наименование клиента: " buf_fin-statement.cli-name skip(1)
     1401     "Валюта счета: "
     1402     substitute("&1/&2 &3"
     1403                     ,buf_currency.curr-abbr
     1404                     ,buf_currency.okv-code
     1405                     ,buf_currency.curr-name )
     1406      skip(1)
     1407     "Номер счeта: " buf_fin-statement.r-schet
     1408     skip(1)
     1409     line skip(1)
     1410     "Дата последней операции: " v-last-doc-str skip(1)
     1411      substitute("Входящий остаток на начало дня &1: &2"
     1412               ,string(buf_fin-statement.start-date, "99/99/9999")
     1413               , string(v-from-sum, "->>>,>>>,>>>,>>9.99")) skip(1)
     1414     .
     1415     for each buf_fin-statement-line no-lock where
     1416             buf_fin-statement-line.host-code = buf_fin-statement.host-code
     1417         AND buf_fin-statement-line.sttm-code = buf_fin-statement.sttm-code:
     1418       CASE buf_fin-statement-line.fin-ext-doc-type:
     1419         when 'рпп':U then do:
     1420           if buf_fin-statement-line.fin-doc-code > 0 then do:
     1421             find first buf_fin-doc no-lock where
     1422                       buf_fin-doc.host-code = buf_fin-statement-line.host-code
     1423                   and buf_fin-doc.fin-doc-code = buf_fin-statement-line.fin-doc-code no-error.
     1424           end.
     1425           assign
     1426           v-vo = string(buf_fin-statement-line.line-num)
     1427           v-c-schet = (if available buf_fin-doc
     1428                        then buf_fin-doc.receiver-c-schet
     1429                        else buf_Fin-statement-line.rp-c-schet)
     1430           v-debet = (if v-my-side
     1431                      then (if available buf_fin-doc
     1432                           then buf_fin-doc.sum-doc
     1433                           else buf_fin-statement-line.sum-doc)
     1434                      else 0)
     1435           v-credit = (if v-my-side
     1436                       then 0
     1437                       else (if available buf_fin-doc
     1438                             then buf_fin-doc.sum-doc
     1439                             else buf_fin-statement-line.sum-doc)
     1440                             )
     1441           v-debet-str   = (if v-my-side
     1442                            then (if available buf_fin-doc
     1443                                  then string(buf_fin-doc.sum-doc)
     1444                                  else string(buf_fin-statement-line.sum-doc)
     1445                                  )
     1446                            else "":U)
     1447           v-credit-str   = (if v-my-side
     1448                             then "":U
     1449                             else (if available buf_fin-doc
     1450                                   then string(buf_fin-doc.sum-doc)
     1451                                   else string(buf_fin-statement-line.sum-doc)
     1452                                  )
     1453                                   )
     1454           v-debet-ob = v-debet-ob + v-debet
     1455           v-credit-ob = v-credit-ob + v-credit
     1456           .
     1457         end.
     1458         when 'ппп':U
     1459         then do:
     1460           if buf_fin-statement-line.fin-doc-code > 0 then do:
     1461             find first buf_fin-doc no-lock where
     1462                       buf_fin-doc.host-code = buf_fin-statement-line.host-code
     1463                   and buf_fin-doc.fin-doc-code = buf_fin-statement-line.fin-doc-code no-error.
     1464           end.
     1465           assign
     1466           v-vo = string(buf_fin-statement-line.line-num)
     1467           v-c-schet = (if available buf_fin-doc
     1468                        then buf_fin-doc.payer-c-schet
     1469                        else buf_Fin-statement-line.rp-c-schet)
     1470           v-credit = (if v-my-side
     1471                       then (if available buf_fin-doc
     1472                             then buf_fin-doc.sum-doc
     1473                             else buf_fin-statement-line.sum-doc)
     1474                       else 0)
     1475           v-debet = (if v-my-side
     1476                      then 0
     1477                      else (if available buf_fin-doc
     1478                            then buf_fin-doc.sum-doc
     1479                            else buf_fin-statement-line.sum-doc)
     1480                            )
     1481           v-credit-str   = (if v-my-side
     1482                             then (if available buf_fin-doc
     1483                                   then string(buf_fin-doc.sum-doc)
     1484                                   else string(buf_fin-statement-line.sum-doc)
     1485                                   )
     1486                             else "":U)
     1487           v-debet-str = (if v-my-side
     1488                          then "":U
     1489                          else (if available buf_fin-doc
     1490                                then string(buf_fin-doc.sum-doc)
     1491                                else string(buf_fin-statement-line.sum-doc))
     1492                                )
     1493           v-credit-ob = v-credit-ob + v-credit
     1494           v-debet-ob = v-debet-ob + v-debet
     1495           .
     1496         end.
     1497       END CASE.
     1498       run fssttxl1-write-line-data in this-procedure (
     1499                                                       input v-vo
     1500                                                       ,input buf_fin-statement-line.prn-doc-code
     1501                                                       ,input v-c-schet
     1502                                                       ,input string(v-debet, ">>>,>>>,>>>,>>9.99")
     1503                                                       ,input string(v-credit, ">>>,>>>,>>>,>>9.99")
     1504                                                      ).
     1505       Display STREAM PrnLibStream
     1506       v-vo
     1507       buf_fin-statement-line.prn-doc-code
     1508       v-c-schet @ buf_fin-statement-line.rp-c-schet
     1509       v-debet
     1510       v-credit
     1511       with FRAME extract .
     1512       DOWN STREAM PrnLibStream
     1513       with frame extract .
     1514     end.
     1515     assign
     1516     v-to-sum-doc = v-from-sum - v-debet-ob + v-credit-ob
     1517     .
     1518     run fssttxl1-write-cell-data in this-procedure ( input "it_debetsum":U
     1519                                                    , input string(v-debet-ob, ">>>,>>>,>>>,>>9.99")) .
     1520     run fssttxl1-write-cell-data in this-procedure ( input "it_creditsum":U
     1521                                                    , input string(v-credit-ob, ">>>,>>>,>>>,>>9.99")).
     1522     run fssttxl1-write-cell-data in this-procedure ( input "f_endsumdoc":U
     1523                                                      ,input substitute("Исходящий остаток на конец дня &1: &2"
     1524                                                                        ,string(buf_fin-statement.end-date, "99/99/9999")
     1525                                                                        , string(v-to-sum-doc, "->>>,>>>,>>>,>>9.99"))).
     1526     DOWN STREAM PrnLibStream 1
     1527     with frame extract.
     1528     display stream PrnLibstream
     1529     "ИТОГО" @ buf_fin-statement-line.prn-doc-code
     1530     "Обороты по дебету" @ v-debet
     1531     "Обороты по кредиту" @ v-credit
     1532     with FRAME extract .
     1533     DOWN STREAM PrnLibStream 2
     1534     with frame extract.
     1535     display stream PrnLibstream
     1536     "Сумма в валюте счета:" @ v-vo
     1537     v-debet-ob @ v-debet
     1538     v-credit-ob @ v-credit
     1539     with FRAME extract .
     1540     DOWN STREAM PrnLibStream 2
     1541     with frame extract.
     1542     Put stream Prnlibstream unformatted
     1543     substitute("Исходящий остаток на конец дня &1: &2"
     1544                 ,string(buf_fin-statement.end-date, "99/99/9999")
     1545                 , string(v-to-sum-doc, "->>>,>>>,>>>,>>9.99"))
     1546     skip(1)
     1547     line skip.
     1548     HIDE  STREAM PrnLibStream FRAME BottomFrame .
     1549     HIDE  STREAM PrnLibStream FRAME extract.
     1550     if p-append and not p-is-last then Page stream PrnLibStream .
     1551     output  STREAM PrnLibStream CLOSE.
     1552     assign
     1553     p-format = 0
     1554     .
     1555     run fssttxl1-close in this-procedure .
     1556     if not p-append
     1557     then do:
     1558         os-delete
     1559             value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1560         .
     1561         os-rename
     1562             value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1563             value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1564         .
     1565         run prn-lib-prn-file in this-procedure (
     1566               input parParentProc
     1567             , input 0
     1568         ).
     1569         os-delete
     1570             value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1571         .
     1572         os-delete
     1573             value( v-fssttxl1-cell-file-name )
     1574         .
     1575     end.
     1576   end.
