        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        3   define parameter buffer buf_fin-statement for ub.fin-statement.
        4   define input parameter p-append as logical no-undo .
        5   define input parameter p-is-last as logical no-undo .
        6   define input-output parameter p-format as integer no-undo .
        7   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo init "$Workfile: fssttm1p.p $":U .
       11   define variable vss-archive     as character no-undo init "$Archive: rep/fssttm1p.p $":U .
