      603       define return parameter hSearch as long.
      604   END PROCEDURE.
      605   PROCEDURE InternetFindNextFileA EXTERNAL "wininet.dll" PERSISTENT:
      606       define input parameter  hSearch as long.
      607       define input parameter  lpFindFileData as memptr.
      608       define return parameter found as long.
      609   END PROCEDURE.
