        1   block-level on error undo, throw.
        2   define variable vss-include-info0 as character format "X(65)" no-undo
        3   initial "@(#)$Workfile$ $Revision$".
        4   DEFINE temp-table tt-obj no-undo
        5       field   obj-code    as integer
        6       field   obj-type    as character
        7       field   obj-name    as character
        8       field   host-code   as integer
        9       INDEX   pi          IS PRIMARY UNIQUE
       10               obj-type
       11               obj-code
       12     .
       13   define temp-table tt-oss-ref like ub.OperServ .
       14   DEFINE temp-table tt-gds-list no-undo
       15       field   gds-code    like ub.goods.gds-code
       16       field   artic       like ub.goods.artic
       17       field   prod-code   like ub.goods.prod-code
       18       field   prod-type   like ub.goods.prod-type
       19       field   gds-name    like ub.goods.gds-name
       20       INDEX   pi          IS PRIMARY UNIQUE
       21               gds-code
       22     .
       23   define input parameter p-date          as integer          no-undo.
       24   define input parameter p-folder        as character        no-undo.
       25   define input parameter p-name          as character        no-undo.
       26   define input parameter p-date-from     as date             no-undo.
       27   define input parameter p-date-to       as date             no-undo.
       28   define input parameter p-ftp-path      as character        no-undo.
       29   define input parameter p-ftp-target-dir as character        no-undo.
       30   define input parameter p-log-handle    as handle no-undo .
       31   define input parameter table   FOR tt-obj.
       32   define input parameter table   FOR tt-oss-ref.
       33   define input parameter table   FOR tt-gds-list.
       34   define variable vss-revision    as character no-undo init "$Revision: 8f5f559ebdb3, 2359, rls $":U .
       35   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       36   define variable vss-date        as character no-undo init "$Date: Ср июн 10 21:13:34 2020 +0300 $":U .
       37   define variable vss-workfile    as character no-undo init "$Workfile: r-help-road.p $":U .
       38   define variable vss-archive     as character no-undo init "$Archive: rep/r-help-road.p $":U .
       39   define variable vss-description as character no-undo init "Выгрузка реализации банковских продуктов".
       40   procedure vss-get-info :
       41     define output parameter p-vss-revision    like vss-revision    no-undo .
       42     define output parameter p-vss-author      like vss-author      no-undo .
       43     define output parameter p-vss-date        like vss-date        no-undo .
       44     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       45     define output parameter p-vss-archive     like vss-archive     no-undo .
       46     define output parameter p-vss-description like vss-description no-undo .
       47     assign
       48       p-vss-revision    = vss-revision
       49       p-vss-author      = vss-author
       50       p-vss-date        = vss-date
       51       p-vss-workfile    = vss-workfile
       52       p-vss-archive     = vss-archive
       53       p-vss-description = vss-description
       54     .
       55   end procedure.
       56   procedure vss-get-parameters :
       57     define output parameter p-vss-parameters as character no-undo .
       58   end procedure.
       59   define new global shared variable g#vssrevis-logger as handle    no-undo .
       60   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       61   define variable v-vssrevis-logger                   as handle    no-undo .
       62   procedure vss-logevent :
       63     define input  parameter p-extra-paramters as character no-undo .
       64     define variable v-vssrevis-parameters as character no-undo .
       65     do
       66     on error undo, return error return-value
       67     :
       68       if  valid-handle(v-vssrevis-logger)
       69       and v-vssrevis-logger :get-signature("logevent") <> ""
       70       then do:
       71         run vss-get-parameters in this-procedure
       72           (output v-vssrevis-parameters
       73           ).
       74         run logevent in v-vssrevis-logger
       75           (input vss-workfile
       76           ,input vss-revision
       77           ,input v-vssrevis-parameters
       78           ,input p-extra-paramters
       79           ).
       80       end.
       81     end.
       82   end procedure.
       83   assign
       84     v-vssrevis-logger = g#vssrevis-logger
       85   .
       86   if  valid-handle(v-vssrevis-logger)
       87   and v-vssrevis-logger :get-signature("logevent") <> ""
       88   then do:
       89     assign
       90       v-vssrevis-logevent = true
       91     .
       92     run vss-logevent in this-procedure (input vss-description) .
       93   end.
       94   define new global shared variable g#language as character no-undo .
       95   if g#language <> '' and g#language <> 'rus':U then do:
       96     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       97   end.
       98   define new global shared variable g#library  as handle no-undo .
       99   define new global shared variable g#library2 as handle no-undo .
      100   procedure proc-alt-shift-f2:
      101     if not ibs.th.gbl.gbl-var:rcode
      102   then
      103     run gbl\inidebug.p .
      104   end.
      105   procedure proc-alt-shift-f3:
      106     run gbl/prvssinf.p
      107       ( input this-procedure
      108       ) .
      109   end.
      110   define variable v-inform-launched as logical no-undo initial false .
      111   procedure proc-alt-shift-f4:
      112     define variable v-action as character no-undo .
      113     if v-inform-launched = false then do:
      114       assign
      115         v-inform-launched = true
      116       .
      117       run gbl/d-inform.w
      118         (  input self
      119         ,  input this-procedure
      120         , output v-action
      121         ) no-error .
      122       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      123       assign
      124         v-inform-launched = false
      125       .
      126     end.
      127   end.
      128   procedure proc-alt-f1:
      129     run gbl/corrhelp.p
      130       (input this-procedure
      131       ) .
      132   end .
      133   on alt-shift-f2 anywhere do:
      134     run proc-alt-shift-f2.
      135   end.
      136   on alt-shift-f3 anywhere do:
      137     run proc-alt-shift-f3 in this-procedure .
      138   end.
      139   on alt-shift-f4 anywhere do:
      140     run proc-alt-shift-f4 in this-procedure.
      141   end.
      142   on alt-f1 anywhere do:
      143     run proc-alt-f1 in this-procedure .
      144   end.
      145   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      146   procedure factord :
      147     define input  parameter p-fact-date            as date    no-undo .
      148     define input  parameter p-fact-time            as integer no-undo .
      149     define input  parameter p-fact-num             as integer no-undo .
      150     define input  parameter p-shift-date           as date    no-undo .
      151     define input  parameter p-shift-num            as integer no-undo .
      152     define input  parameter p-shift-on             as logical no-undo .
      153     define output parameter p-fact-order           as decimal no-undo .
      154     define output parameter p-shift-end-fact-order as decimal no-undo .
      155     define output parameter p-day-end-fact-order   as decimal no-undo .
      156     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      157     if p-fact-date = ?
      158     then do:
      159       return error "Не указана фактическая дата" .
      160     end.
      161     define variable v-fact-date-num as integer no-undo .
      162     assign
      163       v-fact-date-num = integer(p-fact-date)
      164     .
      165     if p-fact-num = ?
      166     or p-fact-num = 0
      167     then do:
      168       return error "Не задан p-fact-num " + string(p-fact-num) .
      169     end.
      170     if p-fact-num < 0
      171     then do:
      172       return error "Отрицательный fact-num " + string(p-fact-num) .
      173     end.
      174     if p-fact-num >= 100000000
      175     then do:
      176       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      177     end.
      178     if p-shift-on = true
      179     then do:
      180       if p-shift-date = ?
      181       then do:
      182         return error "Не задана дата смены" .
      183       end.
      184       if p-shift-num = ?
      185       or p-shift-num = 0
      186       then do:
      187         return error "Не задан номер смены" .
      188       end.
      189     end.
      190     else do:
      191       assign
      192         p-shift-date = p-fact-date
      193         p-shift-num  = 24
      194       .
      195     end.
      196     define variable v-shift-offset as integer no-undo .
      197     if p-shift-date = p-fact-date
      198     then do:
      199       assign
      200         v-shift-offset = 1
      201       .
      202     end.
      203     if p-shift-date < p-fact-date
      204     then do:
      205       assign
      206         v-shift-offset = 0
      207       .
      208     end.
      209     if p-shift-date > p-fact-date
      210     then do:
      211       message
      212         vss-workfile vss-revision vss-description skip
      213         "Неправильная дата закрытия смены" skip
      214         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      215         view-as alert-box error .
      216       undo, return error
      217         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      218           ,string(p-fact-date, '99/99/9999':U)
      219           ,string(p-shift-date, '99/99/9999':U)
      220           )
      221       .
      222     end.
      223     if p-shift-num < 1
      224     or p-shift-num > 24
      225     then do:
      226       message
      227         vss-workfile vss-revision vss-description skip
      228         "Неправильный номер смены" skip
      229         "p-shift-num" p-shift-num skip
      230         view-as alert-box error .
      231       undo, return error return-value .
      232     end.
      233     assign
      234       p-fact-order           = v-fact-date-num
      235                              + v-shift-offset * 0.5
      236                              + p-shift-num    * 0.02 - 0.01
      237                              + p-fact-num     * 0.0000000001
      238       p-shift-end-fact-order = v-fact-date-num
      239                              + v-shift-offset * 0.5
      240                              + p-shift-num    * 0.02
      241       p-day-end-fact-order   = v-fact-date-num
      242                              + 0.99
      243     .
      244     if p-fact-order           <= v-fact-date-num
      245     or p-shift-end-fact-order <= v-fact-date-num
      246     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      247     or p-shift-end-fact-order >= p-day-end-fact-order
      248     then do:
      249       message
      250         vss-workfile vss-revision vss-description skip
      251         "Внутренняя ошибка при генерации фактического номера" skip
      252         "p-fact-date"            p-fact-date            skip
      253         "p-fact-time"            p-fact-time            skip
      254         "p-fact-num"             p-fact-num             skip
      255         "p-shift-date"           p-shift-date           skip
      256         "p-shift-num"            p-shift-num            skip
      257         "p-shift-on"             p-shift-on             skip
      258         "p-shift-end-fact-order" p-shift-end-fact-order skip
      259         "p-day-end-fact-order"   p-day-end-fact-order   skip
      260         "v-fact-date-num"        v-fact-date-num        skip
      261         view-as alert-box error .
      262       undo, return error return-value .
      263     end.
      264   end procedure.
      265   procedure day-begin-fact-order :
      266     define input  parameter p-fact-date            as date    no-undo .
      267     define output parameter p-day-begin-fact-order as decimal no-undo .
      268     do
      269     on error undo, return error return-value
      270     :
      271       if p-fact-date = ?
      272       then do:
      273         assign
      274           p-day-begin-fact-order = 0
      275         .
      276       end.
      277       else do:
      278         assign
      279           p-day-begin-fact-order = integer(p-fact-date)
      280         .
      281       end.
      282     end.
      283   end procedure.
      284   procedure factord-max-fact-order :
      285     define output parameter p-max-fact-order as decimal   no-undo .
      286     do
      287     on error undo, return error return-value
      288     :
      289       run day-begin-fact-order in this-procedure
      290         (input  date(1, 1, 5000)
      291         ,output p-max-fact-order
      292         ) .
      293     end.
      294   end procedure.
      295   procedure factord-cut-archive :
      296     define input  parameter p-obj-type             as character no-undo .
      297     define input  parameter p-obj-code             as integer   no-undo .
      298     define input  parameter p-fact-date            as date      no-undo .
      299     define output parameter p-shift-on             as logical   no-undo .
      300     define output parameter p-shift-date           as date      no-undo .
      301     define output parameter p-shift-num            as integer   no-undo .
      302     define output parameter p-day-end-fact-order   as decimal   no-undo .
      303     define output parameter p-shift-end-fact-order as decimal   no-undo .
      304     define variable v-fact-order as decimal   no-undo .
      305     define buffer buf_shift-obj for ub.shift-obj .
      306     do
      307     on error undo, return error return-value
      308     :
      309   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      311     (input  p-obj-type
      312     ,input  p-obj-code
      313     ,input  'shift-on=request'
      314     ,output p-shift-on
      315     ) no-error .
      316       if error-status :error
      317       then do:
      318         message
      319           vss-workfile vss-revision vss-description skip
      320           "Ошибка при определении атрибута объекта" skip
      321           "Объект" p-obj-type p-obj-code skip
      322           error-status :get-message(1) skip
      323           return-value skip
      324           view-as alert-box error .
      325         undo, return error return-value .
      326       end.
      327       if p-shift-on = false
      328       then do:
      329         assign
      330           p-shift-date               = ?
      331           p-shift-num                = 0
      332         .
      333       end.
      334       else do:
      335         find first buf_shift-obj share-lock
      336           where buf_shift-obj.obj-type   = p-obj-type
      337             and buf_shift-obj.obj-code   = p-obj-code
      338             and buf_shift-obj.shift-date > p-fact-date
      339           use-index pi
      340           no-error .
      341         if not available buf_shift-obj
      342         or buf_shift-obj.status_ <> 'зкр':U
      343         then do:
      344           message
      345             vss-workfile vss-revision vss-description skip
      346             "Невозможно вычислить последнюю смену" skip
      347             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      348             "Объект" p-obj-type p-obj-code skip
      349             "Дата" p-fact-date skip
      350             view-as alert-box error .
      351           undo, return error return-value .
      352         end.
      353         find last buf_shift-obj share-lock
      354           where buf_shift-obj.obj-type = p-obj-type
      355             and buf_shift-obj.obj-code = p-obj-code
      356             and buf_shift-obj.shift-date <= p-fact-date
      357           use-index pi
      358           no-error .
      359         if available buf_shift-obj
      360         then do:
      361           if  buf_shift-obj.status_ = 'зкр':U
      362           then do:
      363             assign
      364               p-shift-date = buf_shift-obj.shift-date
      365               p-shift-num  = buf_shift-obj.shift-num
      366             .
      367           end.
      368           else do:
      369             message
      370               vss-workfile vss-revision vss-description skip
      371               "Невозможно вычислить последнюю смену" skip
      372               "Статус смены отличен от статуса" 'зкр':U skip
      373               "Объект" p-obj-type p-obj-code skip
      374               "Дата" p-fact-date skip
      375               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      376               view-as alert-box error .
      377             undo, return error return-value .
      378           end.
      379         end.
      380         else do:
      381           assign
      382             p-shift-date = p-fact-date - 1
      383             p-shift-num  = 1
      384           .
      385         end.
      386       end.
      387       run factord in this-procedure
      388         (input  p-fact-date
      389         ,input  1
      390         ,input  1
      391         ,input  p-shift-date
      392         ,input  p-shift-num
      393         ,input  p-shift-on
      394         ,output v-fact-order
      395         ,output p-shift-end-fact-order
      396         ,output p-day-end-fact-order
      397         ) no-error .
      398       if error-status :error
      399       then do:
      400         message
      401           vss-workfile vss-revision vss-description skip
      402           "Ошибка при вызове процедуры factord"
      403           error-status :get-message(1) skip
      404           return-value skip
      405           view-as alert-box error .
      406         undo, return error return-value .
      407       end.
      408     end.
      409   end procedure.
      410   procedure factord-lock-shift :
      411     define input  parameter p-obj-type  as character no-undo .
      412     define input  parameter p-obj-code  as integer   no-undo .
      413     define input  parameter p-fact-date as date      no-undo .
      414     define parameter buffer buf_shift-obj for ub.shift-obj .
      415     define variable v-shift-on      as logical   no-undo .
      416     define variable v-extra-message as character no-undo .
      417     define variable v-error as character no-undo .
      418     do
      419     on error undo, return error return-value
      420     :
      421   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      422   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      423     (input  p-obj-type
      424     ,input  p-obj-code
      425     ,input  'shift-on=request'
      426     ,output v-shift-on
      427     ) no-error .
      428       if error-status :error
      429       then do:
      430         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      431         undo, return error v-error .
      432       end.
      433       if v-shift-on = true
      434       then do:
      435         find first buf_shift-obj share-lock
      436           where buf_shift-obj.obj-type   = p-obj-type
      437             and buf_shift-obj.obj-code   = p-obj-code
      438             and buf_shift-obj.shift-date > p-fact-date
      439           use-index pi
      440           no-error .
      441         if not available buf_shift-obj
      442         or buf_shift-obj.status_ <> 'зкр':U
      443         then do:
      444           find last buf_shift-obj
      445             where buf_shift-obj.obj-type = p-obj-type
      446               and buf_shift-obj.obj-code = p-obj-code
      447               and buf_shift-obj.status_  = 'зкр':U
      448             use-index stts
      449             no-error .
      450           if available buf_shift-obj
      451           then do:
      452             assign
      453               v-extra-message =
      454                     substitute("Дата начала последеней закрытой смены на объекте &1"
      455                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      456                               )
      457             .
      458           end.
      459           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      460           undo, return error v-error .
      461         end.
      462       end.
      463     end.
      464   end procedure.
      465   procedure factord-end-day :
      466     define input  parameter p-fact-date            as date    no-undo .
      467     define output parameter p-day-end-fact-order   as decimal no-undo .
      468     do
      469     on error undo, return error return-value
      470     :
      471       if p-fact-date = ?
      472       then do:
      473         return error "Не указана фактическая дата" .
      474       end.
      475       assign
      476         p-day-end-fact-order = integer(p-fact-date) + 0.99
      477       .
      478     end.
      479   end procedure.
      480   procedure factord-to-date :
      481     define input  parameter p-fact-order as decimal no-undo .
      482     define output parameter p-fact-date  as date    no-undo .
      483     define variable v-ref-date  as date      no-undo .
      484     define variable v-ref-delta as integer   no-undo .
      485     do
      486     on error undo, return error return-value
      487     :
      488       if p-fact-order = ?
      489       or p-fact-order = 0
      490       then do:
      491         return error "Не указан fact-order" .
      492       end.
      493       assign
      494         v-ref-date  = date(1, 1, 2000)
      495       .
      496       assign
      497         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      498       .
      499       assign
      500         p-fact-date = v-ref-date + v-ref-delta
      501       .
      502     end.
      503   end procedure.
      504   procedure factord-to-fact-num :
      505     define input  parameter p-fact-order as decimal no-undo .
      506     define output parameter p-fact-num   as integer no-undo .
      507     define variable v-fact-order-trunc as decimal no-undo .
      508     do
      509     on error undo, return error return-value
      510     :
      511       if p-fact-order = ?
      512       or p-fact-order = 0
      513       then do:
      514         return error "Не указан fact-order" .
      515       end.
      516       assign
      517        v-fact-order-trunc = truncate(p-fact-order, 2)
      518       .
      519       assign
      520         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      521       .
      522     end.
      523   end procedure.
      524   procedure factord-to-shift-num :
      525     define input  parameter p-fact-order as decimal no-undo .
      526     define output parameter p-shift-num   as integer no-undo .
      527     define variable  p-shift-numd  as decimal   no-undo .
      528     define variable v-fact-order-trunc as decimal no-undo .
      529     do
      530     on error undo, return error return-value
      531     :
      532       if p-fact-order = ?
      533       or p-fact-order = 0
      534       then do:
      535         return error "Не указан fact-order" .
      536       end.
      537       assign
      538        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
      539       .
      540       if v-fact-order-trunc < 0.5 then do:
      541         v-fact-order-trunc = v-fact-order-trunc + 0.5.
      542       end.
      543       assign
      544         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
      545         .
      546        assign
      547         p-shift-num = truncate (p-shift-numd , 0)
      548       .
      549     end.
      550   end procedure.
      551   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      552   PROCEDURE InternetConnectA EXTERNAL "wininet.dll" PERSISTENT:
      553     define input parameter  hInternetSession  as  long.
      554     define input parameter  lpszServerName    as  char.
      555     define input parameter  nServerPort       as  long.
      556     define input parameter  lpszUserName      as  char.
      557     define input parameter  lpszPassword      as  char.
      558     define input parameter  dwService         as  long.
      559     define input parameter  dwFlags           as  long.
      560     define input parameter  dwContext         as  long.
      561     define return parameter hInternetConnect  as  long.
      562   END.
      563   PROCEDURE InternetGetLastResponseInfoA EXTERNAL "wininet.dll" PERSISTENT:
      564     define output parameter lpdwError          as  long.
      565     define output parameter lpszBuffer         as  char.
