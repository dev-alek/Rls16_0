      651   END PROCEDURE.
      652   PROCEDURE GetLastError external "kernel32.dll" :
      653     define return parameter dwMessageID as long.
      654   END PROCEDURE.
      655   define variable log-file-name     as character no-undo initial ? .
      656   define stream out-stream.
      657   define stream lst-out.
      658   define stream StreamLog.
      659   define variable v-rrn as character no-undo .
      660   define buffer buf_chk-doc       for ub.chk-doc.
      661   define buffer buf_chk-gds       for ub.chk-gds.
      662   define buffer buf_bar-code      for ub.bar-code.
      663   define buffer buf_goods         for ub.goods.
      664   define buffer buf_goods-attr    for ub.goods-attr.
      665   define buffer buf_producer      for ub.clients.
      666   define buffer buf_prod-bc       for ub.prod-bc.
      667   define buffer buf_chk-pay       for ub.chk-pay.
      668   define buffer buf_cash-pay-attr for ub.cash-pay-attr .
      669   define buffer buf_chk-gds-attr  for ub.chk-gds-attr .
      670   define buffer buf_chk-pay-attr  for ub.chk-pay-attr .
      671   define buffer bf_chk-pay-attr   for ub.chk-pay-attr .
      672   do
      673     on error undo, return error
      674     :
      675     define variable v-begin-date            as date      no-undo .
      676     define variable v-end-date              as date      no-undo .
      677     define variable v-begin-date0           as date      no-undo .
      678     define variable v-end-date0             as date      no-undo .
      679     define variable v-par-val               as character no-undo .
      680     define variable v-par-type              as character no-undo .
      681     define variable v-file-name             as character no-undo .
      682     define variable v-file-name-mapping     as character no-undo .
      683     define variable v-file-name-mapping-new as character no-undo .
      684     define variable v-fmt                   as character no-undo .
      685     define variable v-weekday-today         as integer   no-undo .
      686     define variable v-b-code                as integer   no-undo .
      687     define variable v-bar                   as character no-undo .
      688     define variable v-prod-name             as character no-undo .
      689     define variable v-gds-code              as integer   no-undo .
      690     define variable v-fact-order-start      as decimal   no-undo .
      691     define variable v-fact-order-end        as decimal   no-undo .
      692     define variable v-empty-1               as decimal   no-undo .
      693     define variable v-empty-2               as decimal   no-undo .
      694     define variable v-gds-name              as character no-undo .
      695     define variable v-grp-code              as integer   no-undo .
      696     define variable v-counter               as integer   no-undo .
      697     define variable v-label                 as character no-undo .
      698     define variable v-archive-ok            as logical   no-undo.
      699     define variable v-can-print             as logical   no-undo.
      700     define variable v-comment               as character no-undo.
      701     define variable v-grp-name              as character no-undo.
      702     define variable v-cli-base-rate         as decimal   no-undo.
      703     define frame info
      704       v-label        label "Этап" format "x(16)" skip
      705       v-counter      label "Записей" format ">>>,>>>,>>9" skip
      706       with view-as dialog-box side-labels 1 columns three-d title "Формирование отчета"
      707       .
      708     assign
      709       log-file-name = "Rep_BPA.log"
      710       .
      711     IF p-date <> ?
      712       THEN
      713     DO:
      714       assign
      715         v-begin-date    = TODAY - p-date
      716         v-end-date      = TODAY
      717         v-begin-date0   = v-begin-date
      718         v-end-date0     = v-end-date
      719         .
      720     END.
      721     ELSE
      722     DO:
      723       assign
      724         v-end-date0   = p-date-to
      725         v-begin-date0 = p-date-from
      726         .
      727     END.
      728     if p-folder <> "" then
      729     do:
      730       v-file-name = p-folder + "\" + p-name .
      731     end.
      732     else
      733     do:
      734       v-file-name = p-name .
      735     end.
      736     output stream out-stream to value(v-file-name + ".csv") .
      737     for each tt-obj no-lock:
      738       for each buf_chk-doc no-lock
      739         where buf_chk-doc.obj-type = tt-obj.obj-type
      740         and buf_chk-doc.obj-code = tt-obj.obj-code
      741         and buf_chk-doc.chk-date <= v-end-date0
      742         and buf_chk-doc.chk-date >= v-begin-date0
      743         and buf_chk-doc.out-code > "":
      744         if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next .
      745         for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code,
      746           first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
      747           first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_bar-code.gds-code
      748           and buf_goods-attr.attr-code = 'oper-serv-idd':U :
      749           find first tt-oss-ref where tt-oss-ref.id = integer(buf_goods-attr.attr-value) no-error .
      750           if available (tt-oss-ref) then do:
      751           find first tt-gds-list no-lock where tt-gds-list.gds-code = buf_goods-attr.gds-code no-error .
      752           if available (tt-gds-list) then do:
      753           find first buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-gds.doc-code and buf_chk-pay.line-num = buf_chk-gds.line-num no-error .
      754           find first buf_chk-gds-attr no-lock where buf_chk-gds-attr.attr-code = "agent-gd-code" and buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code no-error .
      755           put stream out-stream unformatted
      756             tt-obj.obj-name ";"
      757             tt-gds-list.gds-name ";".
      758           if available (buf_chk-gds-attr) then
      759           do:
      760             put stream out-stream unformatted
      761               buf_chk-gds-attr.attr-value ";".
      762           end.
      763           else
      764           do:
      765             put stream out-stream unformatted
      766               "" ";".
      767           end.
      768           if available (buf_chk-pay) then
      769           do:
      770             put stream out-stream unformatted
      771               string(buf_chk-pay.chk-date) ";" string(buf_chk-doc.chk-time,"HH:MM:SS") ";"
      772               string(buf_chk-pay.tot-sum) ";"
      773               .
      774             find first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
      775               and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
      776               and buf_cash-pay-attr.attr-code = "cash-prop" no-error .
      777             v-rrn = "" .
      778             if AVAILABLE buf_cash-pay-attr then
      779             do:
      780               if buf_cash-pay-attr.attr-value <> "1" then
      781               do:
      782                 put stream out-stream unformatted
      783                   "Электронные" ";".
      784                 for first buf_chk-pay-attr no-lock
      785                   where  buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
      786                   and buf_chk-pay-attr.attr-code = "RRN"
      787                   and buf_chk-pay-attr.line-num = buf_chk-pay.line-num  :
      788                   v-rrn = buf_chk-pay-attr.attr-value.
      789                 end.
      790                 if v-rrn = '' then
      791                   for first bf_chk-pay-attr no-lock
      792                     where bf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
      793                     and bf_chk-pay-attr.attr-code = "cpdoc"
      794                     and bf_chk-pay-attr.line-num = buf_chk-pay.line-num:
      795                     v-rrn = bf_chk-pay-attr.attr-value.
      796                   end.
      797                 put stream out-stream unformatted
      798                   v-rrn .
      799               end.
      800               else
      801               do:
      802                 put stream out-stream unformatted
      803                   "Наличные" ";".
      804                 put stream out-stream unformatted
      805                   v-rrn .
      806               end.
      807             end.
      808           end.
      809           else
      810           do:
      811             put stream out-stream unformatted
      812               ";"
      813               ";"
      814               .
      815           end.
      816           put stream out-stream unformatted
      817             "" chr(10).
      818         end.
      819       end.
      820     end.
      821   end.
      822   end.
      823   end.
