      697   define  stream PrnLibStream.
      698   procedure prn-lib-prn-file :
      699     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      700     define input parameter p-DIsabledoptions as integer no-undo .
      701     define variable v-report-name as character no-undo .
      702     define variable v-user-action as character no-undo .
      703     define variable v-printed     as logical   no-undo .
      704     define variable v-exist       as logical   no-undo .
      705     do
      706       on error undo, return error
      707       :
      708       run prn-lib-get-report-name  in this-procedure (
      709         input parParentProc
      710         ,output v-report-name
      711         ).
      712   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      714     (input  v-report-name
      715     ,input  2
      716     ,output v-exist
      717     )  .
      718       if NOT v-exist then
      719       DO:
      720         Message
      721           "Нет заданий на печать ! "
      722           view-as alert-box .
      723         Return  .
      724       End.
      725       run gbl/prnfilen.w
      726         (input  ""
      727         ,input  p-DisabledOptions
      728         ,input  string(v-report-name )
      729         ,input  7
      730         ,output v-user-action
      731         ,output v-printed
      732         ) .
      733       if v-printed then
      734       do:
      735         return "YES" .
      736       end.
      737       else
      738       do:
      739         return "NO" .
      740       end.
      741     end.
      742   end procedure.
      743   procedure prn-lib-open-stream :
      744     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      745     define input parameter p-page-size    as integer no-undo .
      746     define input parameter p-is-stream    as logical no-undo .
      747     define input parameter p-append       as logical no-undo .
      748     define variable v-report-name as character no-undo .
      749     do
      750       on error undo, return error
      751       :
      752       run prn-lib-get-report-name  in this-procedure (
      753         input parParentProc
      754         ,output v-report-name
      755         ).
      756       if p-is-stream then
      757       do:
      758         if p-append then
      759         do:
      760           output stream PrnLibStream to value( v-report-name )
      761             page-size value(p-page-size) append .
      762         end.
      763         if not p-append then
      764         do:
      765           output stream PrnLibStream to value( v-report-name )
      766             page-size value(p-page-size) .
      767         end.
      768       end.
      769       if not p-is-stream then
      770       do:
      771         if p-append then
      772         do:
      773           output to value( v-report-name )
      774             page-size value(p-page-size) append .
      775         end.
      776         if not p-append then
      777         do:
      778           output to value( v-report-name )
      779             page-size value(p-page-size) .
      780         end.
      781       end.
      782     end.
      783   end procedure.
      784   procedure prn-lib-open-exp :
      785     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      786     define input parameter p-is-stream    as logical no-undo .
      787     define input parameter p-is-append    as logical no-undo .
      788     define output parameter p-ReportFileName as char init "report" no-undo.
      789     define output parameter p-process as logical no-undo .
      790     define variable glog as logical no-undo .
      791     do
      792       on error undo, return error
      793       :
      794       SYSTEM-DIALOG GET-FILE p-ReportFileName
      795         TITLE      "Укажите путь"
      796         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      797         ASK-OVERWRITE
      798         CREATE-TEST-FILE
      799         SAVE-AS
      800         USE-FILENAME
      801         DEFAULT-EXTENSION "txt"
      802         UPDATE glog
      803         .
      804       if not glog then  return.
      805       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      806       if p-is-stream then
      807       do:
      808         if p-is-append then
      809         do:
      810           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      811         end.
      812         else
      813         do:
      814           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      815         end.
      816       end.
      817       else
      818       do:
      819         if p-is-append then
      820         do:
      821           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      822         end.
      823         else
      824         do:
      825           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      826         end.
      827       end.
      828       p-process = yes.
      829     end.
      830   end procedure.
      831   procedure prn-lib-get-report-name :
      832     define input parameter parParentProc  as widget-handle no-undo.
      833     define output parameter p-report-name as character no-undo .
      834     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      835   end procedure.
      836   procedure prn-lib-reportviewer-report-name :
      837     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      838     define input parameter p-report-name-html as character no-undo .
      839     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      840   end procedure.
      841   procedure prn-lib-reportviewer :
      842     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      843     define input parameter p-report-name-html as character no-undo .
      844     define input parameter p-param        as character no-undo .
      845     define variable v-excel           as character no-undo init 'TRUE' .
      846     define variable v-value-character as character no-undo .
      847     define variable v-value-integer   as character no-undo .
      848     define variable v-value-date      as date      no-undo .
      849     define variable v-value-decimal   as decimal   no-undo .
      850     define variable rep-excel         as logical   no-undo .
      851     define variable excel-string      as character no-undo .
      852     define variable v-param-type      as character no-undo .
      853     define variable v-tth             as handle    no-undo .
      854     run adm/shattri.p (
      855       input "get":U
      856       ,input  ""
      857       ,input  0
      858       ,input  'report-glob':U
      859       ,input  'rep-excel':U
      860       ,output v-value-character
      861       ,output v-value-date
      862       ,output v-value-decimal
      863       ,output v-value-integer
      864       ,output rep-excel
      865       ,output v-param-type
      866       ,INPUT-OUTPUT table-handle v-tth
      867       )  .
      868     if rep-excel then v-excel = "TRUE" .
      869     else v-excel = "FALSE" .
      870     if p-param eq ""
      871     then
      872        p-param = "EXCEL:" + v-excel.
      873     else
      874        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      875     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      876   end procedure.
