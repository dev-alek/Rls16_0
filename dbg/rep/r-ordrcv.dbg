      986     define variable v-cntxt-obj-code      as integer   no-undo .
      987     define variable v-cntxt-db-num-obj    as integer   no-undo .
      988     define variable v-cntxt-is-admin      as logical   no-undo .
      989   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      990     run mainmenu_getcntxt in parparentproc
      991       (output v-cntxt-db-num
      992       ,output v-cntxt-userid
      993       ,output v-cntxt-level
      994       ,output v-cntxt-host-code-obj
      995       ,output v-cntxt-obj-type
      996       ,output v-cntxt-obj-code
      997       ,output v-cntxt-db-num-obj
      998       ,output v-cntxt-is-admin
      999       ) .
     1000   def SHARED temp-table g#post-f NO-UNDO
     1001     field obj-type like ub.clients.obj-type
     1002     field obj-code like ub.clients.obj-code
     1003     field obj-name like ub.clients.obj-name
     1004     field grp-code like ub.clients.grp-code
     1005     field grp-name like ub.clients.grp-name
     1006     field lvl-num  like ub.cli-grp.lvl-num
     1007     INDEX pi IS UNIQUE PRIMARY obj-type obj-code
     1008     INDEX p1  obj-name
     1009     .
     1010   define temp-table temp-ord-rcv no-undo
     1011     FIELD obj-type         as character
     1012     FIELD obj-code         as integer
     1013     FIELD doc-code         as character
     1014     FIELD post-code        as integer
     1015     FIELD post-name        as character
     1016     FIELD rcv-code         as character
     1017     FIELD rcv-status       as character
     1018     FIELD ship-date        as date
     1019     INDEX pi is primary obj-type obj-code doc-code
     1020     .
     1021   define buffer buf_clients      for ub.clients .
     1022   define buffer buf_obj-list     for obj-list .
     1023   define variable Counter1          as integer   no-undo .
     1024   define variable v-user-action     as character no-undo .
     1025   define variable v-printed         as logical   no-undo .
     1026   define variable disabledoptions   as integer   no-undo .
     1027   define variable v-orient-page     as character no-undo .
     1028   define variable v-file-name       as character no-undo .
     1029   define variable v-file-name-ind   as integer   no-undo .
     1030   define variable v-line            as character no-undo .
     1031   define variable g#report-num      as integer   no-undo .
     1032   define stream  out-stream .
     1033   run get-report-num  in parparentproc (output  g#report-num).
     1034      assign
     1035         v-line  = fill( "-" , 96 )
     1036      .
     1037   output stream out-stream to value( string( session:temp-directory +
     1038                                        "rpt" + string( g#report-num ) ) )
     1039                                        page-size 62 .
     1040     find first obj-list.
     1041     if not available obj-list then do :
     1042       message
     1043         "Не выбран объект!"
     1044       view-as alert-box error.
     1045       return.
     1046     end.
     1047     for each sheetf :
     1048         delete sheetf.
     1049     end.
     1050     if p-det-rcv then do:
     1051       put stream out-stream  reportname  at 40 format "x(20)" skip
     1052                             trim(str1)  format "x(75)" skip
     1053                             trim(str2)  format "x(75)" skip
     1054                             trim(str3)  format "x(75)" skip
     1055                             trim(str4)  format "x(200)" skip
     1056                             ReportHeader format "x(200)" .
     1057       define frame ord-rcv
     1058               sym1                    column-label ":!:" format "X(1)"  space(0)
     1059               temp-ord-rcv.post-code  column-label "    Код    " format "999999999" space(0)
     1060               sym2                    column-label ":!:" format "X(1)"  space(0)
     1061               temp-ord-rcv.post-name  column-label "Наименование поставщика" format "X(40)" space(0)
     1062               sym3                    column-label ":!:" format "X(1)"  space(0)
     1063               temp-ord-rcv.rcv-code   column-label "  Поставка  " format "99999999999" space(0)
     1064               sym4                    column-label ":!:" format "X(1)"  space(0)
     1065               temp-ord-rcv.rcv-status column-label " Статус ! поставки " format "X(14)" space(0)
     1066               sym5                    column-label ":!:" format "X(1)"  space(0)
     1067               temp-ord-rcv.ship-date  column-label " Заказ от... " format "99/99/9999" space(0)
     1068               sym6                    column-label ":!:" format "X(1)"  space(0)
     1069       header
     1070       string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>>9" ) ) at 80 format "X(13)"
     1071       v-line format "X(96)" at 1
     1072       with width 235 down stream-io use-text NO-BOX.
     1073       VIEW stream Out-stream FRAME ord-rcv .
     1074       FORM with FRAME ord-rcv .
     1075     end.
     1076     else do:
     1077       put stream out-stream  reportname  at 30 format "x(20)" skip
     1078                             trim(str1)  format "x(75)" skip
     1079                             trim(str2)  format "x(75)" skip
     1080                             trim(str3)  format "x(75)" skip
     1081                             trim(str4)  format "x(200)" skip
     1082                             ReportHeader format "x(200)" .
     1083       define frame ord
     1084               sym1                    column-label ":!:" format "X(1)"  space(0)
     1085               temp-ord-rcv.post-code  column-label "    Код    " format "999999999" space(0)
     1086               sym2                    column-label ":!:" format "X(1)"  space(0)
     1087               temp-ord-rcv.post-name  column-label "Наименование поставщика" format "X(40)" space(0)
     1088               sym3                    column-label ":!:" format "X(1)"  space(0)
     1089               temp-ord-rcv.ship-date  column-label " Заказ от... " format "99/99/9999" space(0)
     1090               sym4                    column-label ":!:" format "X(1)"  space(0)
     1091       header
     1092       string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>>9" ) ) at 55 format "X(13)"
     1093       v-line format "X(68)" at 1
     1094       with width 235 down stream-io use-text NO-BOX.
     1095       VIEW stream Out-stream FRAME ord .
     1096       FORM with FRAME ord .
     1097     end.
     1098   if session :set-wait-state( "compiler" ) then.
     1099     assign  Counter1 = 0 .
     1100   define variable v-account as integer init 0 no-undo .
     1101   define variable v-account-lavel as character no-undo .
     1102   define variable v-button-stop as logical no-undo .
     1103   define variable v-kol-spice as integer no-undo .
     1104   define variable v-kol-spice2 as integer no-undo .
     1105   define variable v-kol-spice3 as integer no-undo .
     1106   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1107   DEFINE BUTTON StopBtn AUTO-END-KEY
     1108        LABEL "Стоп"
     1109        SIZE 10 BY 1.
     1110   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1111        LABEL "Обработано записей"
     1112         VIEW-AS TEXT
     1113        SIZE 14 BY .67 NO-UNDO.
     1114   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1115         VIEW-AS TEXT
     1116        SIZE 53.25 BY .67
     1117        FGCOLOR 1  NO-UNDO.
     1118   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1119         VIEW-AS TEXT
     1120        SIZE 53.25 BY .67
     1121        FGCOLOR 1  NO-UNDO.
     1122   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1123         VIEW-AS TEXT
     1124        SIZE 53.25 BY .67
     1125        FGCOLOR 1  NO-UNDO.
     1126   DEFINE RECTANGLE RECT-1
     1127        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1128        SIZE 55.13 BY 4.46.
     1129   DEFINE FRAME InfoFrame
     1130        StopBtn AT ROW 4.25 COL 21.75
     1131        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1132        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1133        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1134        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1135        RECT-1 AT ROW 1 COL 1
     1136       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1137            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1138            TITLE "Процесс"
     1139            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1140   define variable mFrameView      as logical   no-undo init yes.
     1141     define variable mFramHandle as handle no-undo.
     1142     mFramHandle = frame InfoFrame:handle.
     1143     if  log-manager:logfile-name ne ?
     1144     then DO:
     1145         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1146         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1147         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1148     end.
     1149     mFrameView = not session:batch-mode and mFramHandle:visible.
     1150     if mFrameView
     1151     then do:
     1152       ASSIGN
     1153          FRAME InfoFrame:HIDDEN                           = TRUE
     1154          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1155     end.
     1156   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1157   DO:
     1158     IF not StopProcessing THEN
     1159       Message "Вы действительно хотите прервать" SKIP
     1160               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1161                 UPDATE StopProcessing.
     1162     IF StopProcessing THEN do:
     1163        if mFrameView
     1164        then do:
     1165           HIDE FRAME InfoFrame.
     1166        end.
     1167     End.
     1168   END.
     1169   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1170     if  log-manager:logfile-name ne ?
     1171     then DO:
     1172         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1173     end.
     1174     if not session:batch-mode then
     1175     do:
     1176       VIEW FRAME InfoFrame.
     1177       mFrameView = true.
     1178     end.
     1179      v-button-stop = false .
     1180         if mFrameView
     1181         then do:
     1182         if v-button-stop then view STOPBTN in frame InfoFrame.
     1183                          else Hide STOPBTN in frame InfoFrame.
     1184         end.
     1185     create sheetf.
     1186     assign sheetf.sheet-num = 1.
     1187     if p-det-rcv then do:
     1188       assign
     1189         sheetf.Excel-Column-Lable = "Код,Наименование поставщика,Поставка,Статус поставки,Заказ от..."
     1190         sheetf.Sizes  = "9,40,11,14,10"
     1191         Sheetf.ColFOrmat   = "1=@;2=@;3=@;4=@;5=dd/mm/yyyy"
     1192       .
     1193     end.
     1194     else do:
     1195       assign
     1196         sheetf.Excel-Column-Lable = "Код,Наименование поставщика,Заказ от..."
     1197         sheetf.Sizes  = "9,40,10"
     1198         Sheetf.ColFOrmat   = "1=@;2=@;3=dd/mm/yyyy"
     1199       .
     1200     end.
     1201      run rep/extitle.p ( input 1).
     1202      run report-exec in this-procedure.
     1203      run text-report in this-procedure.
     1204      run excel-report in this-procedure.
     1205   if mFrameView
     1206   then do:
     1207      HIDE FRAME InfoFrame.
     1208   end.
     1209   if session :set-wait-state( "" ) then.
     1210     output stream out-stream close.
     1211     if Make-Excel then output stream ForExcel close.
     1212     DisabledOptions = 8.
     1213     ReportFontNum = 7.
     1214     run gbl/prnfilen.w
     1215       ( input  ""
     1216       , input  DisabledOptions
     1217       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1218       , input  ReportFontNum
     1219       ,output v-user-action
     1220       ,output v-printed
     1221     ) .
     1222   procedure report-exec :
     1223     define buffer buf_ord-doc     for ub.ord-doc.
     1224     define buffer buf_ord-doc-rcv for ub.ord-doc-rcv.
     1225     for each obj-list no-lock :
     1226        if p-postname = 'все':U then do :
     1227           for each buf_ord-doc no-lock
     1228               where buf_ord-doc.obj-type    = obj-list.obj-type
     1229                 and buf_ord-doc.obj-code    = obj-list.obj-code
     1230                 and buf_ord-doc.ship-date   = x-date-start
     1231                 and buf_ord-doc.doc-type    <> 'ОО':U
     1232                 :
     1233   define variable vss-include-info13 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1234     create temp-ord-rcv.
     1235     assign
     1236         temp-ord-rcv.doc-code  = buf_ord-doc.doc-code
     1237         temp-ord-rcv.post-code = buf_ord-doc.cli-code
     1238         temp-ord-rcv.post-name = buf_ord-doc.cli-name
     1239         temp-ord-rcv.ship-date = buf_ord-doc.real-date
     1240     .
     1241     if p-det-rcv then do :
     1242       find first buf_ord-doc-rcv no-lock
     1243           where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     1244             and buf_ord-doc-rcv.obj-code = obj-list.obj-code
     1245             and buf_ord-doc-rcv.obj-type = obj-list.obj-type
     1246             no-error.
     1247             if available buf_ord-doc-rcv then do:
     1248                 assign
     1249                   temp-ord-rcv.rcv-code   = buf_ord-doc-rcv.rcv-code
     1250                   temp-ord-rcv.rcv-status = buf_ord-doc-rcv.status_
     1251                 .
     1252             end.
     1253     end.
     1254           end.
     1255        end.
     1256        else do:
     1257           for each g#post-f :
     1258               for each buf_ord-doc no-lock
     1259                   where buf_ord-doc.obj-type    = obj-list.obj-type
     1260                     and buf_ord-doc.obj-code    = obj-list.obj-code
     1261                     and buf_ord-doc.ship-date   = x-date-start
     1262                     and buf_ord-doc.cli-type    = g#post-f.obj-type
     1263                     and buf_ord-doc.cli-code    = g#post-f.obj-code
     1264                     and buf_ord-doc.doc-type    <> 'ОО':U
     1265                     :
     1266   define variable vss-include-info14 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1267     create temp-ord-rcv.
     1268     assign
     1269         temp-ord-rcv.doc-code  = buf_ord-doc.doc-code
     1270         temp-ord-rcv.post-code = buf_ord-doc.cli-code
     1271         temp-ord-rcv.post-name = buf_ord-doc.cli-name
     1272         temp-ord-rcv.ship-date = buf_ord-doc.real-date
     1273     .
     1274     if p-det-rcv then do :
     1275       find first buf_ord-doc-rcv no-lock
     1276           where buf_ord-doc-rcv.doc-code = buf_ord-doc.doc-code
     1277             and buf_ord-doc-rcv.obj-code = obj-list.obj-code
     1278             and buf_ord-doc-rcv.obj-type = obj-list.obj-type
     1279             no-error.
     1280             if available buf_ord-doc-rcv then do:
     1281                 assign
     1282                   temp-ord-rcv.rcv-code   = buf_ord-doc-rcv.rcv-code
     1283                   temp-ord-rcv.rcv-status = buf_ord-doc-rcv.status_
     1284                 .
     1285             end.
     1286     end.
     1287               end.
     1288           end.
     1289        end.
     1290     end.
     1291   end procedure .
     1292   procedure text-report :
     1293       define variable v-flag as logical no-undo.
     1294       for each temp-ord-rcv
     1295         break
     1296         by (if p-sort-by-name then temp-ord-rcv.post-name else "" )
     1297         by temp-ord-rcv.post-code
     1298         :
     1299           assign v-flag = yes.
     1300           if p-det-rcv then do:
     1301             display stream Out-stream
     1302             sym1 sym2 sym3 sym4 sym5 sym6
     1303             temp-ord-rcv.post-code
     1304             temp-ord-rcv.post-name
     1305             temp-ord-rcv.rcv-code
     1306             temp-ord-rcv.rcv-status
     1307             temp-ord-rcv.ship-date
     1308             with frame ord-rcv .
     1309             down stream Out-stream 1 with frame ord-rcv .
     1310           end.
     1311           else do:
     1312             display stream Out-stream
     1313             sym1 sym2 sym3 sym4
     1314             temp-ord-rcv.post-code
     1315             temp-ord-rcv.post-name
     1316             temp-ord-rcv.ship-date
     1317             with frame ord .
     1318             down stream Out-stream 1 with frame ord .
     1319           end.
     1320       end.
     1321       if v-flag then do:
     1322         if p-det-rcv then do:
     1323           put stream out-stream  v-line format "x(96)".
     1324         end.
     1325         else do:
     1326           put stream out-stream  v-line format "x(68)".
     1327         end.
     1328       end.
     1329   end procedure .
     1330   procedure excel-report :
     1331       for each temp-ord-rcv
     1332         break
     1333         by (if p-sort-by-name then temp-ord-rcv.post-name else "" )
     1334         by temp-ord-rcv.post-code
     1335         :
     1336           if p-det-rcv then do:
     1337             if Make-Excel then  put   stream ForExcel unformatted
     1338             temp-ord-rcv.post-code  CHR(9)
     1339             temp-ord-rcv.post-name  CHR(9)
     1340             temp-ord-rcv.rcv-code   CHR(9)
     1341             temp-ord-rcv.rcv-status CHR(9)
     1342             temp-ord-rcv.ship-date  chr(10)
     1343             .
     1344           end.
     1345           else do:
     1346             if Make-Excel then  put   stream ForExcel unformatted
     1347             temp-ord-rcv.post-code  CHR(9)
     1348             temp-ord-rcv.post-name  CHR(9)
     1349             temp-ord-rcv.ship-date  chr(10)
     1350             .
     1351           end.
     1352       end.
     1353   end procedure .
