      607   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      608     if num-entries(string(p-dec), '.') = 2
      609       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      610       else return( string(p-dec)) .
      611   end function.
      612   function format-point-to-comma returns char (input orig as char ) .
      613   define variable rtext as character no-undo .
      614   define variable strt as integer no-undo .
      615   define variable leng as integer no-undo .
      616   assign rtext = orig .
      617   repeat:
      618     strt =  index(rtext,'.').
      619     if strt = 0 then leave.
      620     leng = 1.
      621     substring(rtext,strt,leng,"character") = v-delim .
      622   end.
      623   return rtext.
      624   end function.
      625   function format-excel-text returns char ( input start-text as char ) :
      626   def var  i    as int no-undo.
      627   def var  ch   as char no-undo.
      628   def var  n    as int no-undo.
      629   def var  ipos as int no-undo.
      630     n = num-entries(trim(start-text), chr(10)) - 1 .
      631     do i = 1 to n :
      632       ipos = index( start-text, chr(10)).
      633       if ipos > 0 then
      634         substr( start-text, ipos, 1 ) = ' '.
      635     end.
      636     n = num-entries(trim(start-text), chr(13)) - 1 .
      637     do i = 1 to n :
      638       ipos = index( start-text, chr(13)).
      639       if ipos > 0 then
      640         substr( start-text, ipos, 1 ) = ' '.
      641     end.
      642     if index( start-text, '"' ) = 0 then
      643       start-text =  '="'   + trim( start-text) + '"'   .
      644       else do:
      645         n = num-entries(trim(start-text), '"') - 1.
      646         do i = 1 to n :
      647           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      648         end.
      649         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      650         start-text = '="'  + ch  + '"' .
      651       end.
      652     return start-text.
      653   end.
      654   function excel-sum returns char (input p-dec as decimal ).
      655     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      656   end function.
      657   function excel-qnty returns char (input p-dec as decimal ).
      658     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      659   end function.
      660   function format-excel-text-macr returns char ( input start-text as char ) :
      661   def var  i    as int no-undo.
      662   def var  ch   as char no-undo.
      663   def var  n    as int no-undo.
      664   def var  ipos as int no-undo.
      665     n = num-entries(trim(start-text), chr(10)) - 1 .
      666     do i = 1 to n :
      667       ipos = index( start-text, chr(10)).
      668       if ipos > 0 then
      669         substring( start-text, ipos , 1 ) = ' '.
      670     end.
      671     n = num-entries(trim(start-text), chr(13)) - 1 .
      672     do i = 1 to n :
      673       ipos = index( start-text, chr(13)).
      674       if ipos > 0 then
      675         substring( start-text, ipos, 1 ) = ' '.
      676     end.
      677     if index( start-text, '"' ) = 0 then
      678       start-text =  '"'   + trim( start-text) + '"'   .
      679       else do:
      680         n = num-entries(trim(start-text), '"') - 1.
      681         do i = 1 to n :
      682           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      683         end.
      684         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      685         start-text = '"'  + ch  + '"' .
      686       end.
      687     n = num-entries(trim(start-text), chr(10)) - 1 .
      688     do i = 1 to n :
      689       ipos = index( start-text, chr(10)).
      690       if ipos > 0 then
      691         substring( start-text, ipos , 1 ) = ' '.
      692     end.
      693       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      694     return start-text.
      695   end.
