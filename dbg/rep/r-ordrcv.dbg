      879   define new global shared variable g#lib-trn3 as handle no-undo .
      880   define new global shared variable g#lib-trn4 as handle no-undo .
      881   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      882   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      883   procedure paramls-clear :
      884     define buffer buf_temp-param for temp-param .
      885     do
      886     on error undo, return error return-value
      887     :
      888       for each buf_temp-param
      889       on error undo, return error
      890       :
      891         delete buf_temp-param .
      892       end.
      893     end.
      894   end procedure.
      895   procedure paramls-write :
      896     define input  parameter p-code     as character no-undo .
      897     define input  parameter p-sub-code as character no-undo .
      898     define input  parameter p-value    as character no-undo .
      899     define buffer buf_temp-param for temp-param .
      900     do
      901     on error undo, return error return-value
      902     :
      903       find first buf_temp-param
      904         where buf_temp-param.param-code     = p-code
      905           and buf_temp-param.param-sub-code = p-sub-code
      906         no-error .
      907       if not available buf_temp-param then do:
      908         create buf_temp-param .
      909         assign
      910           buf_temp-param.param-code     = p-code
      911           buf_temp-param.param-sub-code = p-sub-code
      912         .
      913       end.
      914       assign
      915         buf_temp-param.param-value = p-value
      916       .
      917     end.
      918   end procedure.
      919   procedure paramls-read :
      920     define input  parameter p-code          as character no-undo .
      921     define input  parameter p-sub-code      as character no-undo .
      922     define input  parameter p-default-value as character no-undo .
      923     define output parameter p-value         as character no-undo .
      924     define buffer buf_temp-param for temp-param .
      925     do
      926     on error undo, return error return-value
      927     :
      928       find first buf_temp-param
      929         where buf_temp-param.param-code     = p-code
      930           and buf_temp-param.param-sub-code = p-sub-code
      931         no-error .
      932       if available buf_temp-param then do:
      933         assign
      934           p-value = buf_temp-param.param-value
      935         .
      936       end.
      937       else do:
      938         assign
      939           p-value = p-default-value
      940         .
      941       end.
      942     end.
      943   end procedure.
      944   procedure paramls-append :
      945     define input  parameter p-code     as character no-undo .
      946     define input  parameter p-sub-code as character no-undo .
      947     define input  parameter p-value    as character no-undo .
      948     define buffer buf_temp-param for temp-param .
      949     do
      950     on error undo, return error return-value
      951     :
      952       find first buf_temp-param
      953            where buf_temp-param.param-code     = p-code
      954              and buf_temp-param.param-sub-code = p-sub-code
      955         no-error .
      956       if not available buf_temp-param then do:
      957         create buf_temp-param .
      958         assign
      959           buf_temp-param.param-code     = p-code
      960           buf_temp-param.param-sub-code = p-sub-code
      961           buf_temp-param.param-value    = p-value
      962         .
      963       end.
      964       else do:
      965           assign
      966               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      967           .
      968       end.
      969     end.
      970   end procedure.
