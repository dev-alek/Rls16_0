       90   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       91   FUNCTION fnc-base-price RETURN decimal (local-bc      as integer,
       92                                           local-doc-num as char).
       93   define buffer base-price        for ub.price-list.
       94   define variable local-main-code like ub.bar-code.b-code no-undo.
       95   define variable local-base-code like ub.bar-code.b-code no-undo.
       96     run prc-base-code (input local-bc, output local-base-code).
       97     find base-price no-lock where
       98          base-price.doc-num = local-doc-num and
       99          base-price.b-code  = local-base-code and
      100          base-price.price-type = "" no-error.
      101     if not available base-price then do:
      102       run prc-main-code (input local-bc, output local-main-code).
      103       find  base-price no-lock where
      104             base-price.doc-num = local-doc-num and
      105             base-price.b-code  = local-main-code and
      106             base-price.price-type = "" no-error.
      107     end.
      108     if available base-price then
      109       return (base-price.price-sale).
      110     else
      111       return (?).
      112   END FUNCTION.
      113   procedure prc-main-code:
      114   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      115   define output parameter local-main-code like ub.bar-code.b-code no-undo.
      116   define buffer local-bar-code        for ub.bar-code.
      117   define buffer local-goods           for ub.goods.
      118   define buffer main-code             for ub.bar-code.
      119   define buffer main-prt              for ub.gds-prt.
      120     local-main-code = ?.
      121     find local-bar-code no-lock where
      122          local-bar-code.b-code = local-bc no-error.
      123     if not available local-bar-code then
      124       return.
      125     find local-goods no-lock where
      126          local-goods.gds-code = local-bar-code.gds-code.
      127     find first  main-prt no-lock where
      128                 main-prt.upper-code = local-goods.prt-root.
      129     find  main-code no-lock where
      130           main-code.gds-code  = local-bar-code.gds-code and
      131           main-code.in-code   = "" and
      132           main-code.part-code = "" and
      133           main-code.unit-cli  = local-goods.unit-base and
      134           main-code.node-code = main-prt.node-code.
      135     local-main-code = main-code.b-code.
      136   end procedure.
      137   procedure prc-base-code:
      138   define input  parameter local-bc        like ub.bar-code.b-code no-undo.
      139   define output parameter local-base-code like ub.bar-code.b-code no-undo.
      140   define buffer local-bar-code for ub.bar-code.
      141   define buffer local-goods    for ub.goods.
      142   define buffer base-code      for ub.bar-code.
      143     local-base-code = ?.
      144     find local-bar-code no-lock where
      145          local-bar-code.b-code = local-bc no-error.
      146     if not available local-bar-code then
      147       return.
      148     find local-goods no-lock where
      149          local-goods.gds-code = local-bar-code.gds-code.
      150     find base-code no-lock where
      151          base-code.gds-code  = local-bar-code.gds-code and
      152          base-code.node-code = local-bar-code.node-code and
      153          base-code.in-code   = local-bar-code.in-code and
      154          base-code.part-code = local-bar-code.part-code and
      155          base-code.unit-cli  = local-goods.unit-base.
      156     local-base-code = base-code.b-code.
      157   end procedure.
      158   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      159   procedure cur-time :
      160      define output parameter p-today as date      no-undo .
      161      define output parameter p-time  as integer   no-undo .
      162     do
      163     on error undo, return error
      164     :
      165       define variable v-date1 as date      no-undo .
      166       define variable v-date2 as date      no-undo .
      167       define variable v-time  as integer   no-undo .
      168       assign
      169         v-date1 = today
      170         v-time  = time
      171         v-date2 = today
      172       .
      173       if v-date1 <> v-date2
      174       then do:
      175         assign
      176           v-date1 = today
      177           v-time  = v-time
      178         .
      179       end.
      180       assign
      181         p-today = v-date1
      182         p-time  = v-time
      183       .
      184     end.
      185   end.
      186   function cur-time-date returns character
      187   :
      188     return string(today, '99/99/9999':U) .
      189   end.
      190   function cur-time-mjd returns decimal
      191   :
      192     define variable v-date as date      no-undo .
      193     define variable v-time as integer   no-undo .
      194     run cur-time in this-procedure
      195       (output v-date
      196       ,output v-time
      197       ) .
      198     return integer(v-date) - 2400002 + (v-time / 86400) .
      199   end.
      200   function cur-time-get-ending-index returns integer
      201   (input p-number as integer
      202   )
      203   :
      204     if p-number < 0
      205     or p-number = ?
      206     then do:
      207       return 1 .
      208     end.
      209     define variable v-rest as integer   no-undo .
      210     assign
      211       p-number = p-number modulo 100
      212     .
      213     if p-number < 20
      214     then do:
      215       assign
      216         v-rest = p-number
      217       .
      218     end.
      219     else do:
      220       assign
      221         v-rest = p-number modulo 10
      222       .
      223     end.
      224     case v-rest :
      225       when 1
      226       then do:
      227         return 2 .
      228       end.
      229       when 2 or
      230       when 3 or
      231       when 4
      232       then do:
      233         return 3 .
      234       end.
      235       otherwise do:
      236         return 1 .
      237       end.
      238     end case .
      239   end.
      240   procedure cur-time-mjd-to-date :
      241      define input  parameter i-mjd-diff as decimal no-undo.
      242      define output parameter o-Date     as date    no-undo.
      243      define output parameter o-Time     as integer no-undo.
      244      define variable v-day-number as integer   no-undo .
      245      if    i-mjd-diff < 0
      246         or i-mjd-diff = ?
      247      then do:
      248         return "?" .
      249      end.
      250      assign
      251         v-day-number = truncate(i-mjd-diff,0).
      252         o-Date = date(v-day-number + 2400002).
      253         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      254     .
      255   end.
      256   function cur-time-mjd-to-string returns character
      257   (input p-mjd-diff as decimal
      258   )
      259   :
      260     define variable v-day-number as integer   no-undo .
      261     define variable v-seconds    as integer   no-undo .
      262     define variable v-hour       as integer   no-undo .
      263     define variable v-min        as integer   no-undo .
      264     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      265     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      266     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      267     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      268     if p-mjd-diff < 0
      269     or p-mjd-diff = ?
      270     then do:
      271       return "?" .
      272     end.
      273     assign
      274       v-day-number = integer(truncate(p-mjd-diff,0))
      275       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      276     .
      277     if v-seconds > 86400
      278     then do:
      279       assign
      280         v-seconds = 86400 - 1
      281       .
      282     end.
      283     if v-seconds < 0
      284     then do:
      285       assign
      286         v-seconds = 0
      287       .
      288     end.
      289     assign
      290       v-hour = truncate(v-seconds / 3600, 0)
      291     .
      292     assign
      293       v-seconds = v-seconds modulo 3600
      294     .
      295     assign
      296       v-min = truncate(v-seconds / 60, 0)
      297     .
      298     assign
      299       v-seconds = v-seconds modulo 60
      300     .
      301     return
      302         (if v-day-number <> 0
      303           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      304           else ""
      305         )
      306       + (if v-day-number <> 0 or v-hour <> 0
      307           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      308           else ""
      309         )
      310       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      311           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      312           else ""
      313         )
      314       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      315       .
      316   end.
      317   function cur-time-string returns character
      318   :
      319     define variable v-date as date      no-undo .
      320     define variable v-time as integer   no-undo .
      321     run cur-time in this-procedure
      322       (output v-date
      323       ,output v-time
      324       ) .
      325     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      326   end.
      327   function cur-time-string-sec returns character
      328   :
      329     define variable v-date as date      no-undo .
      330     define variable v-time as integer   no-undo .
      331     run cur-time in this-procedure
      332       (output v-date
      333       ,output v-time
      334       ) .
      335     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      336   end.
      337   function cur-time-custom  returns character
      338   (input p-prefix as character
      339   ,input p-date-format as character
      340   ,input p-delimiter as character
      341   ,input p-time-format as character
      342   ,input p-suffix as character
      343   )
      344   :
      345     define variable v-date as date      no-undo .
      346     define variable v-time as integer   no-undo .
      347     run cur-time in this-procedure
      348       (output v-date
      349       ,output v-time
      350       ) .
      351     return
      352       p-prefix
      353       + string(v-date, p-date-format)
      354       + p-delimiter
      355       + string(v-time, p-time-format)
      356       + p-suffix
      357       .
      358   end.
      359   function cur-time-print  returns character
      360   :
      361     define variable v-date as date      no-undo .
      362     define variable v-time as integer   no-undo .
      363     run cur-time in this-procedure
      364       (output v-date
      365       ,output v-time
      366       ) .
      367     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      368   end.
      369   function cur-time-datetime returns datetime
      370   :
      371     define variable v-char as character no-undo .
      372     define variable v-datetime as datetime no-undo .
      373     v-char = cur-time-string().
      374     v-datetime = datetime(v-char).
      375     return  v-datetime.
      376   end.
      377   function cur-time-string-msec returns character
      378   :
      379     define variable v-date as datetime  no-undo .
      380     v-date = now.
      381     return string(v-date) .
      382   end.
      383   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      384       def var log-file-name as char no-undo.
      385       assign
      386           log-file-name = 'r-akt.log'
      387       .
      388       if log-file-name <> "":U
      389       then do:
      390           if search( 'r-akt.log' ) = ?
      391           then do:
      392               output to value( 'r-akt.log' ).
      393               output close.
      394           end.
      395       end.
      396       DEF STREAM stm-log.
      397       PROCEDURE writelog:
      398       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
      399       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
      400       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
      401       if p-file-name <> ""
      402       then do:
      403       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
      404           PUT STREAM stm-log UNFORMATTED chr(10).
      405           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
      406                                           OR p-log-string = "&Line") THEN "" ELSE
      407                                           cur-time-string-sec() + " ").
      408           PUT STREAM stm-log UNFORMATTED
      409                   (IF p-log-string = "&Line" THEN FILL("-", 80)
      410                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
      411                   ELSE fill(" ", p-log-level * 2) + p-log-string).
      412       OUTPUT STREAM stm-log CLOSE.
      413       end.
      414       END PROCEDURE.
      415   define variable vss-include-info5 as character format "X(65)" no-undo
