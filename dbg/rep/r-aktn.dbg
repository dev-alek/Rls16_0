      500           v-single-line = fill("-", 136)
      501           v-line-counter = 0
      502           v-good-line-counter = 0
      503       .
      504       find first price-doc no-lock
      505           where recid(price-doc) = rec_id .
      506       if not available price-doc
      507       then do:
      508           bell.
      509           message vss-workfile + '. Порушена табличка price-doc'.
      510           return error.
      511       end.
      512       assign
      513           v-price-doc-doc-num  = price-doc.doc-num
      514       .
      515       output stream Prtcl to value( string( session:temp-directory +
      516                                   "rpt" + string( g#report-num ) ) ) page-size 62 .
      517       assign
      518           v-title = (if price-doc.status_ = 'акт':U
      519                      then fill(" ",40) + "А К Т  переоценки  по "
      520                      else fill(" ",32) + "П Р И К А З   о  переоценке товаров по"
      521                     )
      522       .
      523       put stream Prtcl
      524               v-title     format "X(100)"
      525               skip(1)
      526               space(34) "Н Е О С Н О В Н Ы М   К О Д А М" format "X(100)"
      527               skip(1)
      528               space(40) string( caps( price-doc.status_ ) + "  N " + v-price-doc-doc-num )
      529                   format "X(75)"
      530               skip(1)
      531       .
      532       if price-doc.status_ = 'акт':U
      533       then do:
      534           put stream Prtcl
      535               space(100) "Цены введены с " format "X(20)"
      536               price-doc.doc-date format "99.99.9999"
      537               skip(1)
      538           .
      539       end.
      540       else do:
      541           put stream Prtcl
      542               skip(1)
      543           .
      544       end.
      545       form header
      546           v-single-line format "X(136)" at 1 skip
      547           "Продолжение - на следующей странице" at 30 skip
      548               with frame Bttmframe width 160 page-bottom no-labels no-box .
      549       view stream Prtcl frame Bttmframe .
      550       for each price-list no-lock
      551          where price-list.doc-num = price-doc.doc-num
      552        , first goods no-lock
      553          where goods.artic     = price-list.artic
      554            and goods.prod-type = price-list.prod-type
      555            and goods.prod-code = price-list.prod-code
      556       break by price-list.artic with frame nm-codes
      557       :
      558   define variable vss-include-info7 as character format "X(65)" no-undo
      559   initial "@(#)$Workfile$ $Revision$".
      560               find first bar-code no-lock
      561                    where bar-code.b-code = price-list.b-code
      562               .
      563               if bar-code.unit-cli = goods.unit-base
      564               then do:
      565                   assign
      566                       v-code-is-main = yes
      567                   .
      568               end.
      569               else do:
      570                   assign
      571                       v-code-is-main = no
      572                   .
      573               end.
      574               if not (v-code-is-main = yes)
      575               then do:
      576                   assign
      577                       v-not-main-unit-cli       = bar-code.unit-cli
      578                       v-not-main-cli-base-rate  = bar-code.cli-base-rate
      579                       v-not-main-b-code         = bar-code.b-code
      580                   .
      581               end.
      582               find first gds-prt no-lock
      583                    where gds-prt.node-code = bar-code.node-code
      584               .
      585               assign
      586                 v-gds-prt-node-name =
      587                 ( if gds-prt.upper-code = goods.prt-root
      588                   then if bar-code.in-code = ''
      589                       then goods.gds-name
      590                       else bar-code.in-code + '    ' + bar-code.part-code
      591                   else
      592                           goods.gds-name + "//" + gds-prt.f-name
      593                 )
      594               .
      595               run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Определили имя товара со шкалой ( "
      596                                                   + dtm-char(v-gds-prt-node-name)
      597                                                   + " )").
      598               find first gds-obj no-lock
      599                    where gds-obj.obj-type  = price-list.obj-type
      600                      and gds-obj.obj-code  = price-list.obj-code
      601                      and gds-obj.prod-type = price-list.prod-type
      602                      and gds-obj.prod-code = price-list.prod-code
      603                      and gds-obj.artic     = price-list.artic
      604               no-error.
      605               if available gds-obj
      606               then do:
      607                   assign
      608                       v-gds-obj-last-price = ( if v-rb-is-base = yes then gds-obj.last-base else gds-obj.last-rubl )
      609                   .
      610                   if v-gds-obj-last-price = ?
      611                   then do:
      612                       assign
      613                           v-gds-obj-last-price = 0
      614                       .
      615                   end.
      616                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Нашли товар ( "
      617                                   + string(gds-obj.artic) + " )" + " на объекте ( "
      618                                   + price-list.obj-type + string(price-list.obj-code) + " ). Определили цену закупки ( "
      619                                   + dtm-char(string(v-gds-obj-last-price)) + " )"
      620                                                       ).
      621               end.
      622               else do:
      623                   assign
      624                       v-gds-obj-last-price = 0
      625                   .
      626                   run writelog in this-procedure (log-file-name, 4, "R-AKT.i   Не нашли товара ( "
      627                                   + string(price-list.artic) + " )" + " на объекте ( "
      628                                   + price-list.obj-type + string(price-list.obj-code) + " ). Назначили цену закупки ( 0 )"
      629                                                       ).
      630               end.
      631               find first gds-prt no-lock
      632                    where gds-prt.upper-code = goods.prt-root
      633               .
      634               assign
      635                   v-gds-prt-node-code = gds-prt.node-code
      636               .
      637   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      638   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      639     (input  price-list.obj-type
      640     ,input  price-list.obj-code
      641     ,input  price-list.b-code
      642     ,input  0
      643     ,input  price-list.fact-order
      644     ,output v-price-list-doc-num
      645     ,output v-price-list-price-sale
      646     ,output v-price-list-road-tax
      647     ,output v-price-list-excise
      648     )  .
      649               if v-price-list-price-sale = ?
      650               then do:
      651                   assign
      652                       v-price-list-price-sale = 0
      653                   .
      654               end.
      655               if v-price-list-road-tax = ?
      656               then do:
      657                   assign
      658                       v-price-list-road-tax = 0
      659                   .
      660               end.
      661               assign
      662                   v-price-list-price-sale_old = v-price-list-price-sale
      663               .
      664               run writelog in this-procedure (log-file-name, 4,
      665                                                           "R-AKT.i   Определили продажную цену из прайс-листа ( "
      666                                                           + dtm-char(string(v-price-list-price-sale)) + " )"
      667                                                   ).
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      669     (input  goods.gds-code
      670     ,input  bar-code.node-code
      671     ,output v-price-list-b-code
      672     )  .
      673               find first bar-code no-lock
      674                    where bar-code.b-code = v-price-list-b-code
      675               .
      676               accumulate bar-code.b-code ( count ) .
      677           if not v-code-is-main
      678           then do:
      679               assign
      680                   v-line-counter = v-line-counter  + 1
      681                   v-good-line-counter = v-good-line-counter + 1
      682               .
      683               display stream Prtcl sym1 v-good-line-counter
      684                               sym2 trim (string ( v-not-main-b-code ))        @ v-b-code
      685                               sym3 price-list.artic
      686                               sym4 v-gds-prt-node-name   @ goods.gds-name
      687                               sym5 v-not-main-unit-cli
      688                               sym6 v-not-main-cli-base-rate
      689                               sym7 fnc-base-price (bar-code.b-code, price-list.doc-num) @ v-main-price-sale
      690                               price-list.d-pcnt
      691                               price-list.price-sale
      692                               sym10
      693               .
      694           end.
      695       end.
      696       hide stream Prtcl frame Bttmframe .
      697       if line-counter( Prtcl ) + 13 > page-size( Prtcl ) then
      698           page stream Prtcl .
      699       put stream Prtcl v-single-line          format "X(136)" skip(1) space(5) "Всего "
      700                       v-good-line-counter     format ">,>>>,>>9" space(2)
      701                       "наименований"          format "x(13)" skip(1)
      702       .
      703       output stream Prtcl close.
      704   if session :set-wait-state( "" ) then.
      705   if g#quest-print = false
      706   then do:
      707     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      708                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      709                                         OUTPUT g#log ).
      710   end.
      711   else do:
      712     os-command silent
      713       value( "COPY /b " +
      714         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      715         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      716         string( session:temp-directory) +  "$" + string( g#report-num )
      717                 ) .
      718     os-command silent
      719       value( "COPY /b " +
      720         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      721         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      722         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      723                 ) .
      724   end.
      725   end.
