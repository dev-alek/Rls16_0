     7298       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7299           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7300           display STREAM OutStream    with frame top-frame .
     7301       End.
     7302     End.
     7303     if c-f-sale-sum <>  ?  then do :
     7304       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7305       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7306           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7307           display STREAM OutStream    with frame top-frame .
     7308       End.
     7309     End.
     7310     if c-f-sale-other <>  ?  then do :
     7311       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7312       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7313           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7314           display STREAM OutStream    with frame top-frame .
     7315       End.
     7316     End.
     7317     if c-f-free-qnty <>  ?  then do :
     7318       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7319       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7320           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7321           display STREAM OutStream    with frame top-frame .
     7322       End.
     7323     End.
     7324     if c-f-wait-qnty <>  ?  then do :
     7325       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7326       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7327           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7328           display STREAM OutStream    with frame top-frame .
     7329       End.
     7330     End.
     7331           Display stream OutStream no-error.
     7332           DOWN stream OutStream .
     7333           run u-line in this-procedure.
     7334           if Make-Excel then  put   stream ForExcel unformatted
     7335             "ИТОГО"                         CHR(9)
     7336             "по объекту"                    CHR(9)
     7337             obj-list.obj-name               CHR(9)  CHR(9)  CHR(9)
     7338             excel-qnty(accum TOTAL f-qnty           )  CHR(9)
     7339             CHR(9)
     7340             excel-sum (accum TOTAL f-cost-sum       )  CHR(9)
     7341             CHR(9)
     7342             excel-sum (accum TOTAL f-sale-sum       )  CHR(9)
     7343             excel-sum (accum TOTAL f-sale-other    )   CHR(9)
     7344             excel-sum (accum TOTAL f-free-qnty     )   CHR(9)
     7345             excel-sum (accum TOTAL f-wait-qnty     )   CHR(9)
     7346             chr(10) .
     7347   End.
     7348      if n-no > 1 then do:
     7349     if c-nn <>  ?  then do :
     7350       c-nn:screen-value = string('ИТОГО') .
     7351       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7352           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7353           display STREAM OutStream    with frame top-frame .
     7354       End.
     7355     End.
     7356     if c-f-artic <>  ?  then do :
     7357       c-f-artic:screen-value = string('ПО ВСЕМ ОБЬЕКТАМ') .
     7358       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7359           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7360           display STREAM OutStream    with frame top-frame .
     7361       End.
     7362     End.
     7363     if c-f-qnty <>  ?  then do :
     7364       c-f-qnty:screen-value = string(accum TOTAL f-qnty) .
     7365       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7366           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7367           display STREAM OutStream    with frame top-frame .
     7368       End.
     7369     End.
     7370     if c-f-cost-sum <>  ?  then do :
     7371       c-f-cost-sum:screen-value = string(accum TOTAL f-cost-sum) .
     7372       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7373           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7374           display STREAM OutStream    with frame top-frame .
     7375       End.
     7376     End.
     7377     if c-f-sale-sum <>  ?  then do :
     7378       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7379       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7380           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7381           display STREAM OutStream    with frame top-frame .
     7382       End.
     7383     End.
     7384     if c-f-sale-other <>  ?  then do :
     7385       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7386       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7387           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7388           display STREAM OutStream    with frame top-frame .
     7389       End.
     7390     End.
     7391     if c-f-free-qnty <>  ?  then do :
     7392       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7393       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7394           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7395           display STREAM OutStream    with frame top-frame .
     7396       End.
     7397     End.
     7398     if c-f-wait-qnty <>  ?  then do :
     7399       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7400       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7401           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7402           display STREAM OutStream    with frame top-frame .
     7403       End.
     7404     End.
     7405           dIsplay stream OutStream with FRAME Zapas no-error .
     7406           DOWN stream OutStream with FRAME Zapas.
     7407         run u-line in this-procedure.
     7408            if Make-Excel then  put   stream ForExcel unformatted
     7409            "ИТОГО"                       CHR(9)
     7410            "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)  CHR(9)
     7411            excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     7412            CHR(9)
     7413            excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     7414            CHR(9)
     7415            excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     7416            excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     7417            excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     7418            excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     7419            chr(10) .
     7420       End.
     7421   end procedure.
     7422   procedure display-prt :
     7423   define variable pr-cursor as integer no-undo init 0.
     7424   define variable go-work   as logical no-undo init no.
     7425   define variable v-tmp-prt like gds-prt.node-code init -1.
     7426   IF goods.prt-root <> Prtroot Then DO:
     7427       If v-var = "no-today"  then do:
     7428   run  prdoclib-init-prt-obj-by-factord in this-procedure
     7429   ( input gds-obj.obj-type  ,
     7430     input gds-obj.obj-code  ,
     7431     input gds-obj.artic     ,
     7432     input gds-obj.prod-type ,
     7433     input gds-obj.prod-code ,
     7434     input fact-order-2 ,
     7435     input false ) .
     7436       end.
     7437     for each prt-obj where
     7438         prt-obj.artic     = goods.artic     and
     7439         prt-obj.prod-type = goods.prod-type and
     7440         prt-obj.prod-code = goods.prod-code and
     7441         prt-obj.obj-code  = obj-list.obj-code and
     7442         prt-obj.obj-type  = obj-list.obj-type and
     7443         prt-obj.is-term   =  true no-lock
     7444         BREAK BY prt-obj.prt-code with FRAME Zapas :
     7445         pr-cursor = 0.
     7446         go-work = false.
     7447         if v-prizn = "" then do:
     7448           go-work = true.
     7449         end.
     7450         else do:
     7451             do while pr-cursor < num-entries(v-prizn,","):
     7452                 pr-cursor = pr-cursor + 1.
     7453                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7454                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7455                         pr-cursor = num-entries(v-prizn,",").
     7456                         go-work = true.
     7457                     end.
     7458                 end.
     7459             end.
     7460         end.
     7461         if go-work then do:
     7462             if v-var <> "no-today" then do:
     7463                 Assign
     7464                   p-qnty      = p-qnty       + prt-obj.fact-qnty
     7465                   p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7466                   p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7467                   p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7468                   .
     7469             End.
     7470             IF last-of(prt-obj.prt-code) THEN DO:
     7471   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7472     (input  gds-obj.gds-code
     7473     ,input  prt-obj.prt-code
     7474     ,output v-bar-code
     7475     )  .
     7476                 if v-var = "no-today" then do:
     7477                   find first temp-prt-obj no-lock
     7478                        where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     7479                        if avail temp-prt-obj then do :
     7480                           run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7481                           Assign
     7482                             p-qnty      = temp-prt-obj.fact-qnty
     7483                             p-free-qnty = 0
     7484                             p-sale-sum  = temp-prt-obj.fact-qnty * v-price-sale
     7485                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7486                             .
     7487                         End.
     7488                         Else
     7489                           Assign
     7490                             p-qnty      = 0
     7491                             p-free-qnty = 0
     7492                             p-sale-sum  = 0   .
     7493                 End.
     7494           FIND first gds-prt  where gds-prt.node-code = prt-obj.prt-code NO-LOCK no-error .
     7495           if c-f-wait-qnty <> ? Then DO :
     7496             for each trn-doc no-lock  where
     7497                 trn-doc.obj-code        = obj-list.obj-code and
     7498                 trn-doc.obj-type        = obj-list.obj-type and
     7499                 trn-doc.status_         = 'накл':U           and
     7500                 trn-doc.flag_           = true              and
     7501                 trn-doc.ext-doc-type    = 'ie':U :
     7502                 for each gds-dtl no-lock where
     7503                     gds-dtl.doc-code   = trn-doc.doc-code   and
     7504                     gds-dtl.artic      = goods.artic        and
     7505                     gds-dtl.prod-code  = goods.prod-code    and
     7506                     gds-dtl.prod-type  = goods.prod-type    and
     7507                     gds-dtl.prt-code   = prt-obj.prt-code   and
     7508                     gds-dtl.obj-code   = obj-list.obj-code  and
     7509                     gds-dtl.obj-type   = obj-list.obj-type :
     7510                     Assign
     7511                     p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty.
     7512                 end.
     7513             End.
     7514           End.
     7515           if ( f-rez-qnty <> ? or
     7516               f-rez-cost <> ? or
     7517               f-rez-sale <> ? ) and  v-var <> "no-today"
     7518           then do:
     7519                 for each temp_gds-dtl where
     7520                           temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7521                     assign
     7522                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7523                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7524                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7525                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7526                     .
     7527                 end.
     7528           end.
     7529           Assign
     7530           p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7531           p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7532           p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7533           .
     7534           if not (p-zero = false  and
     7535                (p-qnty        =  0  and
     7536                 p-cost-sum    =  0  and
     7537                 p-sale-sum    =  0  and
     7538                 p-sale-other  =  0  and
     7539                 p-free-qnty   =  0  and
     7540                     p-wait-qnty  = 0  ) ) then do:
     7541     if c-nn <>  ?  then do :
     7542       c-nn:screen-value = string('') .
     7543       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7544           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7545           display STREAM OutStream    with frame top-frame .
     7546       End.
     7547     End.
     7548     if c-f-artic <>  ?  then do :
     7549       c-f-artic:screen-value = string('') .
     7550       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7551           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7552           display STREAM OutStream    with frame top-frame .
     7553       End.
     7554     End.
     7555     if c-f-b-code <>  ?  then do :
     7556       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7557       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7558           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7559           display STREAM OutStream    with frame top-frame .
     7560       End.
     7561     End.
     7562     if c-f-prt-name <>  ?  then do :
     7563       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7564       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7565           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7566           display STREAM OutStream    with frame top-frame .
     7567       End.
     7568     End.
     7569     if c-f-qnty <>  ?  then do :
     7570       c-f-qnty:screen-value = string(p-qnty) .
     7571       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7572           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7573           display STREAM OutStream    with frame top-frame .
     7574       End.
     7575     End.
     7576     if c-f-cost-pr <>  ?  then do :
     7577       c-f-cost-pr:screen-value = string(p-cost-pr) .
     7578       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7579           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7580           display STREAM OutStream    with frame top-frame .
     7581       End.
     7582     End.
     7583     if c-f-cost-sum <>  ?  then do :
     7584       c-f-cost-sum:screen-value = string(p-cost-sum) .
     7585       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7586           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7587           display STREAM OutStream    with frame top-frame .
     7588       End.
     7589     End.
     7590     if c-f-sale-pr <>  ?  then do :
     7591       c-f-sale-pr:screen-value = string(p-sale-pr) .
     7592       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7593           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7594           display STREAM OutStream    with frame top-frame .
     7595       End.
     7596     End.
     7597     if c-f-sale-sum <>  ?  then do :
     7598       c-f-sale-sum:screen-value = string(p-sale-sum) .
     7599       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7600           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7601           display STREAM OutStream    with frame top-frame .
     7602       End.
     7603     End.
     7604     if c-f-sale-other <>  ?  then do :
     7605       c-f-sale-other:screen-value = string(p-sale-other) .
     7606       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7607           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7608           display STREAM OutStream    with frame top-frame .
     7609       End.
     7610     End.
     7611     if c-f-free-qnty <>  ?  then do :
     7612       c-f-free-qnty:screen-value = string(p-free-qnty) .
     7613       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7614           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7615           display STREAM OutStream    with frame top-frame .
     7616       End.
     7617     End.
     7618     if c-f-wait-qnty <>  ?  then do :
     7619       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     7620       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7621           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7622           display STREAM OutStream    with frame top-frame .
     7623       End.
     7624     End.
     7625     if c-f-rez-qnty <>  ?  then do :
     7626       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     7627       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7628           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7629           display STREAM OutStream    with frame top-frame .
     7630       End.
     7631     End.
     7632     if c-f-rez-cost <>  ?  then do :
     7633       c-f-rez-cost:screen-value = string(p-rez-cost) .
     7634       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7635           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7636           display STREAM OutStream    with frame top-frame .
     7637       End.
     7638     End.
     7639     if c-f-rez-sale <>  ?  then do :
     7640       c-f-rez-sale:screen-value = string(p-rez-sale) .
     7641       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7642           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7643           display STREAM OutStream    with frame top-frame .
     7644       End.
     7645     End.
     7646     if c-f-rez-cost-pr <>  ?  then do :
     7647       c-f-rez-cost-pr:screen-value = string(p-rez-cost-pr) .
     7648       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7649           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7650           display STREAM OutStream    with frame top-frame .
     7651       End.
     7652     End.
     7653               Display stream OutStream no-error.
     7654               DOWN stream OutStream .
     7655               if Make-Excel then  put   stream ForExcel unformatted
     7656               CHR(9)
     7657               string(v-bar-code,"999999999") CHR(9)
     7658                            CHR(9)
     7659                            CHR(9)
     7660                gds-prt.f-name                    CHR(9)
     7661                excel-qnty(p-qnty)                            CHR(9)
     7662                excel-sum(p-cost-pr)                        CHR(9)
     7663                excel-sum(p-cost-sum)                        CHR(9)
     7664                excel-sum(p-sale-pr)                        CHR(9)
     7665                excel-sum(p-sale-sum)                        CHR(9)
     7666                excel-sum(p-sale-other)                      CHR(9)
     7667                excel-sum(p-free-qnty)                       CHR(9)
     7668               excel-sum(p-wait-qnty)   CHR(9)
     7669               excel-sum(p-rez-qnty   ) CHR(9)
     7670               excel-sum(p-rez-cost   ) CHR(9)
     7671               excel-sum(p-rez-sale   ) CHR(9)
     7672               excel-sum(p-rez-cost-pr) CHR(9)
     7673               chr(10) .
     7674           End.
     7675           Assign
     7676             p-qnty        =  0
     7677             p-cost-sum    =  0
     7678             p-sale-sum    =  0
     7679             p-sale-other  =  0
     7680             p-free-qnty   =  0
     7681             p-wait-qnty   =  0
     7682             p-rez-qnty     = 0
     7683             p-rez-cost     = 0
     7684             p-rez-sale     = 0
     7685             p-rez-cost-pr  = 0
     7686             .
     7687       End.
     7688     End.
     7689     end.
     7690   End.
     7691   end procedure.
     7692   PROCEDURE on-same-page :
     7693     define input parameter p-line-number as integer  no-undo .
     7694     if p-line-number > page-size( OutStream ) then do:
     7695       return .
     7696     end.
     7697     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     7698       page stream OutStream .
     7699     end.
     7700   end procedure.
     7701   PROCEDURE ostatok :
     7702   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     7703   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     7704   def input parameter x-tog-shift   as   logical             no-undo.
     7705   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     7706   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     7707   def input parameter x-shift-start as integer               no-undo.
     7708   def input parameter x-shift-end   as integer               no-undo.
     7709   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     7710   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     7711   def input parameter xTog-obj   as log no-undo.
     7712   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     7713   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     7714   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     7715   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     7716   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     7717   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     7718   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     7719   def var              Fact-orderS   as char  no-undo.
     7720   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     7721      Assign
     7722         Fact-order   = 0
     7723         Quantity     = 0
     7724         Coast_R      = 0
     7725         Coast_V      = 0
     7726         VAT_R        = 0
     7727         VAT_V        = 0 .
     7728    x-date-start-t  = x-date-start + 1 .
     7729   IF x-date-end = date('') then DO:
     7730      Fact-order = 0 .
     7731      for each obj-list
     7732          where  ( not xtog-obj or
     7733                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     7734                 no-lock :
     7735         if  x-tog-shift = false then do:
     7736                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7737                               ub.stk-tot.Fact-date <=  x-date-start
     7738                               and ub.stk-tot.shift-num = 0
     7739                               USE-INDEX fact-date no-lock no-error .
     7740              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7741         End.
     7742         Else  DO :
     7743             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7744              (ub.stk-tot.shift-date  = x-date-start-t and
     7745               ub.stk-tot.shift-num  < x-shift-start or
     7746               ub.stk-tot.shift-date  < x-date-start-t  )
     7747               and ub.stk-tot.shift-num  > 0
     7748               USE-INDEX Shift-num no-lock no-error .
     7749            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7750           END.
     7751       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     7752     End.
     7753   End.
     7754   Else DO:
     7755     For each obj-list  WHERE
     7756        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     7757         no-lock :
     7758      IF  x-TOG-Shift = False Then DO:
     7759          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7760               ub.stk-tot.Fact-date <= x-date-end
     7761               and ub.stk-tot.shift-num = 0
     7762               USE-INDEX fact-date no-lock no-error.
     7763          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7764      END.
     7765      Else DO:
     7766           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     7767               (ub.stk-tot.shift-date  = x-date-end and
     7768               ub.stk-tot.shift-num  <= x-shift-end or
     7769               ub.stk-tot.shift-date  < x-date-end       ) and
     7770               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     7771               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     7772       End.
     7773       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     7774     End.
     7775   End.
     7776   END PROCEDURE.
     7777   procedure ost-line :
     7778     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     7779     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     7780     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     7781     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     7782     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     7783     define input  parameter x-tog-shift  as logical no-undo .
     7784     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     7785     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     7786     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     7787     define input  parameter xtog-obj     as logical no-undo .
     7788     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     7789     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     7790     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     7791     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     7792     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     7793     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     7794     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     7795     define buffer buff-obj-list  for obj-list .
     7796     define buffer buff-stk-line  for ub.stk-line .
     7797     assign
     7798       Quantity = 0
     7799       Coast_R  = 0
     7800       Coast_V  = 0
     7801       VAT_R    = 0
     7802       VAT_V    = 0
     7803       SLT_R    = 0
     7804       SLT_V    = 0
     7805     .
     7806     if  x-tog-shift = false then do:
     7807       for each buff-obj-list no-lock
     7808         where xtog-obj = false
     7809            or (buff-obj-list.obj-type = x-store-type
     7810               and buff-obj-list.obj-code = x-store-code
     7811               )
     7812       on error undo, return error
     7813       :
     7814       find last buff-stk-line no-lock
     7815         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7816           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7817           and buff-stk-line.artic      = x-artic
     7818           and buff-stk-line.prod-type  = x-prod-type
     7819           and buff-stk-line.prod-code  = x-prod-code
     7820           and buff-stk-line.sum-type   = x-sum-type
     7821           and buff-stk-line.cat-id     = '##,##':U
     7822           and buff-stk-line.fact-order <= x-fact-order
     7823           and buff-stk-line.shift-num  = 0
     7824         use-index category
     7825         no-error .
     7826       if available buff-stk-line then do:
     7827         assign
     7828           Quantity = Quantity + buff-stk-line.fact-qnty
     7829           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7830           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7831           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7832           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7833           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7834           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7835         .
     7836       end.
     7837      end.
     7838     end.
     7839     else do:
     7840       for each buff-obj-list no-lock
     7841         where xtog-obj = false
     7842            or (buff-obj-list.obj-type = x-store-type
     7843               and buff-obj-list.obj-code = x-store-code
     7844               )
     7845       on error undo, return error
     7846       :
     7847         find last buff-stk-line no-lock
     7848           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7849             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7850             and buff-stk-line.artic      = x-artic
     7851             and buff-stk-line.prod-type  = x-prod-type
     7852             and buff-stk-line.prod-code  = x-prod-code
     7853             and buff-stk-line.sum-type   = x-sum-type
     7854             and buff-stk-line.cat-id     = '##,##':U
     7855             and buff-stk-line.fact-order <= x-fact-order
     7856             and buff-stk-line.shift-num  > 0
     7857           use-index category
     7858           no-error .
     7859         if available buff-stk-line then do:
     7860           assign
     7861             Quantity = Quantity +  buff-stk-line.fact-qnty
     7862             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7863             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7864             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7865             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7866             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7867             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7868           .
     7869         end.
     7870       end.
     7871     end.
     7872   end procedure.
     7873   procedure ost-lineother-tax :
     7874     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     7875     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     7876     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     7877     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     7878     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     7879     define input  parameter x-tog-shift  as logical no-undo .
     7880     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     7881     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     7882     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     7883     define input  parameter xTog-obj     as logical no-undo .
     7884     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     7885     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     7886     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     7887     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     7888     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     7889     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     7890     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     7891     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     7892     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     7893     define buffer buff-obj-list  for obj-list .
     7894     define buffer buff-stk-line  for ub.stk-line .
     7895     assign
     7896       Quantity = 0
     7897       Coast_R  = 0
     7898       Coast_V  = 0
     7899       VAT_R    = 0
     7900       VAT_V    = 0
     7901       SLT_R    = 0
     7902       SLT_V    = 0
     7903       other_R  = 0
     7904       other_V  = 0
     7905     .
     7906     if  x-tog-shift = false then do:
     7907       for each buff-obj-list no-lock
     7908         where xtog-obj = false
     7909            or (buff-obj-list.obj-type = x-store-type
     7910               and buff-obj-list.obj-code = x-store-code
     7911               )
     7912       on error undo, return error
     7913       :
     7914       find last buff-stk-line no-lock
     7915         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7916           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7917           and buff-stk-line.artic      = x-artic
     7918           and buff-stk-line.prod-type  = x-prod-type
     7919           and buff-stk-line.prod-code  = x-prod-code
     7920           and buff-stk-line.sum-type   = x-sum-type
     7921           and buff-stk-line.cat-id     = '##,##':U
     7922           and buff-stk-line.fact-order <= x-fact-order
     7923           and buff-stk-line.shift-num  = 0
     7924         use-index category
     7925         no-error .
     7926       if available buff-stk-line then do:
     7927         assign
     7928           Quantity = Quantity + buff-stk-line.fact-qnty
     7929           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     7930           Coast_V  = Coast_V  + buff-stk-line.sum-base
     7931           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     7932           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     7933           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     7934           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     7935           other_R  = other_R  + buff-stk-line.other-rubl
     7936           other_V  = other_V  + buff-stk-line.other-base
     7937         .
     7938       end.
     7939    end.
     7940     end.
     7941     else do:
     7942       for each buff-obj-list no-lock
     7943         where xtog-obj = false
     7944            or (buff-obj-list.obj-type = x-store-type
     7945               and buff-obj-list.obj-code = x-store-code
     7946               )
     7947       on error undo, return error
     7948       :
     7949         find last buff-stk-line no-lock
     7950           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     7951             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     7952             and buff-stk-line.artic      = x-artic
     7953             and buff-stk-line.prod-type  = x-prod-type
     7954             and buff-stk-line.prod-code  = x-prod-code
     7955             and buff-stk-line.sum-type   = x-sum-type
     7956             and buff-stk-line.cat-id     = '##,##':U
     7957             and buff-stk-line.fact-order <= x-fact-order
     7958             and buff-stk-line.shift-num  > 0
     7959           use-index category
     7960           no-error .
     7961         if available buff-stk-line then do:
     7962           assign
     7963             Quantity = Quantity +  buff-stk-line.fact-qnty
     7964             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     7965             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     7966             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     7967             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     7968             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     7969             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     7970             other_R = other_R   +  buff-stk-line.other-rubl
     7971             other_V = other_V   +  buff-stk-line.other-base
     7972           .
     7973         end.
     7974       end.
     7975     end.
     7976   end procedure.
     7977   procedure ost-line-kg :
     7978     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     7979     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     7980     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     7981     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     7982     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     7983     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     7984     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     7985     define buffer buff-obj-list  for obj-list .
     7986     define buffer buf_doc-line for ub.doc-line .
     7987     define buffer buf_inv-line for ub.inv-line .
     7988     do
     7989     on error undo, return error
     7990     :
     7991       for each buf_doc-line no-lock where
     7992                buf_doc-line.obj-type    = p-obj-type   and
     7993                buf_doc-line.obj-code    = p-obj-code   and
     7994                buf_doc-line.prod-type   = p-prod-type  and
     7995                buf_doc-line.prod-code   = p-prod-code  and
     7996                buf_doc-line.artic       = p-artic      and
     7997                buf_doc-line.status_     = 'факт':U      and
     7998                buf_doc-line.fact-order <= p-fact-order
     7999             by buf_doc-line.fact-order    descending
     8000       :
     8001         find first buf_inv-line no-lock where
     8002                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8003                    buf_inv-line.artic     = buf_doc-line.artic     and
     8004                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     8005                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     8006         if available buf_inv-line
     8007         then do:
     8008           if buf_inv-line.after-cli-qnty <> ?
     8009           then do:
     8010             assign
     8011               p-quantity-kg = buf_inv-line.after-cli-qnty
     8012             .
     8013             leave .
     8014           end.
     8015         end.
     8016       end.
     8017       if p-quantity-kg = ?
     8018       then do:
     8019         assign
     8020           p-quantity-kg = 0
     8021         .
     8022       end.
     8023     end.
     8024   end procedure.
     8025   procedure calc-price-sale-for-prt :
     8026   define output parameter v-cur-base as decimal no-undo .
     8027   define variable v-cli-base-rate like ub.bar-code.cli-base-rate no-undo .
     8028   define var parrecid-prl as recid no-undo .
     8029       define  variable price-rubl-with-tax-sale-prl    like ub.doc-line.price-rubl no-undo.
     8030       define  variable price-base-with-tax-sale-prl    like ub.doc-line.price-base no-undo.
     8031       define  variable price-rubl-without-tax-sale-prl like ub.doc-line.price-rubl no-undo.
     8032       define  variable price-base-without-tax-sale-prl like ub.doc-line.price-base no-undo.
     8033       define  variable vat-base-sale-prl               like ub.doc-line.price-base no-undo.
     8034       define  variable vat-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8035       define  variable vat-base-buyer-prl              like ub.doc-line.price-base no-undo.
     8036       define  variable vat-rubl-buyer-prl              like ub.doc-line.price-rubl no-undo.
     8037       define  variable slt-base-sale-prl               like ub.doc-line.price-base no-undo.
     8038       define  variable slt-rubl-sale-prl               like ub.doc-line.price-rubl no-undo.
     8039       define  variable road-tax-base-sale-prl          like ub.doc-line.road-tax   no-undo.
     8040       define  variable road-tax-rubl-sale-prl          like ub.doc-line.road-tax   no-undo.
     8041       define  variable excise-base-sale-prl            like ub.doc-line.price-base no-undo.
     8042       define  variable excise-rubl-sale-prl            like ub.doc-line.price-rubl no-undo.
     8043       define  variable discnt-base-sale-prl            like ub.gds-dtl.discnt-base no-undo.
     8044       define  variable discnt-rubl-sale-prl            like ub.gds-dtl.discnt-rubl no-undo.
     8045       define buffer out-vatp_gds-dtl-prl     for ub.gds-dtl.
     8046       define buffer buf_out-vatp_gds-dtl-prl for ub.gds-dtl.
     8047       define buffer out-vatp_parts-prl       for ub.parts.
     8048       define buffer out-vatp_sysconf-prl     for ub.sysconf.
     8049       define buffer out-vatp_doc-line-prl    for ub.doc-line.
     8050       define buffer out-vatp_goods-prl       for ub.goods.
     8051       define buffer out-vatp_trn-doc-prl     for ub.trn-doc.
     8052       define buffer out-vatp_doc-attr-prl    for ub.doc-attr.
