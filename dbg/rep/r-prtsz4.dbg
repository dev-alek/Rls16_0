     6901                                                           output  Coast_R1  ,
     6902                                                           output  Coast_V1  ,
     6903                                                           output  VAT_R1    ,
     6904                                                           output  VAT_V1    ,
     6905                                                           output  SLT_R1    ,
     6906                                                           output  SLT_V1     ).
     6907                                                       Assign
     6908                                                           f-qnty       = Quantity1
     6909                                                           f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6910                                                           f-sale-pr    = if f-qnty = 0  then 0 else f-sale-sum / f-qnty
     6911                                                           .
     6912                                                         RUN ost-line in this-procedure
     6913                                                         (input   ub.gds-obj.obj-code  ,
     6914                                                           input   ub.gds-obj.obj-type  ,
     6915                                                           INPUT   ub.gds-obj.artic     ,
