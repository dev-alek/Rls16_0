     5210       c-f-sale-pr:DATA-TYPE = "CHARACTER"
     5211       c-f-sale-pr:FORMAT    = "x(" + string(C-f-sale-pr:WIDTH-CHARS) + ")"
     5212       c-f-sale-pr:screen-value = string(ff)  .
