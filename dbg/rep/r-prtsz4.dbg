     6924                                                           output  Coast_R1  ,
     6925                                                           output  Coast_V1  ,
     6926                                                           output  VAT_R1    ,
     6927                                                           output  VAT_V1    ,
     6928                                                           output  SLT_R1    ,
     6929                                                           output  SLT_V1    ).
     6930                                                       Assign
     6931                                                           f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6932                                                           f-cost-pr    = if Quantity1 = 0 then 0 else f-cost-sum / Quantity1
     6933                                                           .
     6934                                           end.
     6935                                           else do:
     6936                                                       Assign
     6937                                                           f-qnty       = ub.gds-obj.fact-qnty
     6938                                                           f-cost-sum   = determined(gds-obj.fact-base)
     6939                                                           f-sale-sum   = ub.gds-obj.fact-sale
     6940                                                           f-free-qnty  = ub.gds-obj.free-qnty
     6941                                                           f-cost-pr    = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6942                                                           f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6943                                                        .
     6944                                           end.
     6945                                       f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6946                                       if c-f-wait-qnty <> ? Then DO :
     6947                                         for each ub.trn-doc no-lock  where
     6948                                             ub.trn-doc.obj-code        = obj-list.obj-code and
