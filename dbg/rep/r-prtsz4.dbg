     5177       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5178           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5179           display STREAM OutStream    with frame top-frame .
     5180       End.
     5181     End.
     5182   if c-f-qnty <>  ?  then do :
     5183   Assign
     5184       l1f-qnty  = c-f-qnty:DATA-TYPE
     5185       l2f-qnty  = c-f-qnty:FORMAT
