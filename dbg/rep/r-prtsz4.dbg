     6959                                                     Assign
     6960                                                       f-wait-qnty   = f-wait-qnty     + ub.doc-line.fact-qnty.
     6961                                             end.
     6962                                         End.
     6963                                       End.
     6964                                     if itog = false and
     6965                                         not(f-qnty         = 0 and
     6966                                             f-cost-sum     = 0 and
     6967                                             f-sale-sum     = 0 and
     6968                                             f-sale-other   = 0 and
