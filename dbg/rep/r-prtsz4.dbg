     4993     find first clients no-lock where
     4994                 clients.obj-type = x-store-type   and
     4995                 clients.obj-code = x-store-code
     4996                 no-error.
     4997     if available clients then  objname = clients.obj-name.
     4998                          else  objname = "объект не определен".
     4999        assign
     5000           i=0
     5001           startdate     = x-date-start
     5002           enddate       = x-date-end
     5003           v-var         = string("")
     5004           paytype       = x-set_pay_type
     5005           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     5006           Find first gds-prt where gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     5007           If available  gds-prt then   Prtroot = gds-prt.prt-root.
     5008                                 Else   Prtroot = 0.
     5009           run report-execute in this-procedure.
     5010   PROCEDURE report-execute :
     5011     If (ValType=0 and x-base-code=0)  Or ValType=1
     5012                                   then   assign tPrintRubl = yes .
     5013                                   else   assign tPrintRubl = no .
     5014      NO-PRISE = true .
     5015     if  var-report-r-b = "rubl"  Then
     5016       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     5017     else
     5018       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     5019     If ReportPageHeight = 0 then ReportPageHeight = 43 .
     5020   output stream OutStream to value( string( session:temp-directory +
     5021                                        "rpt" + string( g#report-num ) ) )
     5022                                        page-size  value(ReportPageHeight) .
     5023     FORM with FRAME Zapas .
     5024   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5025   form header
     5026     line format "x(198)" at 1 skip
     5027     "Продолжение - на следующей странице" at 30 skip
     5028     with frame bottomframe width 232 page-bottom no-labels no-box .
     5029   view stream outstream frame bottomframe .
     5030      Line = fill("-", 198).
     5031     Run CalcItog in this-procedure.
     5032     Run Print-Header in this-procedure.
     5033     if p-tog-obj = true then do:
     5034       CAse classify :
     5035         when 1 then do:
     5036         end.
     5037         when 2 then do:
     5038         end.
     5039         when 3 then do:
     5040         end.
     5041         when 4 then do:
     5042         end.
     5043         when 5 then do:
     5044           Run Foreach5 in this-procedure.
     5045         end.
     5046         when 6 then do:
     5047           Run Foreach6 in this-procedure.
     5048         end.
     5049         when 7 then do:
     5050           Run Foreach7 in this-procedure.
     5051         end.
     5052       End case.
     5053     end.
     5054     else do:
     5055       case classify :
     5056         when 1 then do:
     5057         end.
     5058         when 2 then do:
     5059         end.
     5060         when 3 then do:
     5061         end.
     5062         when 4 then do:
     5063         end.
     5064         end case.
     5065    end.
     5066     HIDE stream OutStream FRAME BottomFrame .
     5067     Run  Print-footer in this-procedure.
     5068     HIDE STREAM OutStream FRAME Zapas .
     5069     HIDE   STREAM OutStream FRAME top-Frame .
     5070     DELETE WIDGET-POOL "My-pool".
     5071     Output stream OutStream close.
     5072     if Make-Excel then output stream ForExcel close.
     5073   if mFrameView
     5074   then do:
     5075      HIDE FRAME InfoFrame.
     5076   end.
     5077     define variable v-user-action as character no-undo .
     5078     define variable v-printed as logical   no-undo .
     5079     define variable DisabledOptions as integer   no-undo .
     5080     define variable v-orient-page as character no-undo .
     5081     run How-name in this-procedure (
     5082         input ReportPageHeight,
     5083         input ReportPageWidth,
     5084         output v-orient-page )
     5085         .
     5086     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     5087                                    else DisabledOptions = 0 .
     5088     run gbl/prnfilen.w
     5089       (input  ""
     5090       ,input  DisabledOptions
     5091       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     5092       ,input  ReportFontNum
     5093       ,output v-user-action
     5094       ,output v-printed
     5095       ) .
     5096   END PROCEDURE.
     5097   PROCEDURE print-header :
     5098      PUT stream OutStream  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     5099            AT 50 format "X(85)" SKIP(2)
     5100            REPORTNAME
     5101            AT 35  format "X(100)" skip.
     5102        PUT stream OutStream   "на "  + string(x-date-start,"99/99/9999") +
     5103            " время " +  string(x-time,"HH:MM:SS")  AT 35 format "X(160)" SKIP.
     5104        Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     5105           PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(160)" SKIP.
     5106        End.
     5107        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     5108           PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(160)" SKIP.
     5109        End.
     5110        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     5111           PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(160)" SKIP.
     5112        End.
     5113        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     5114           PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(160)" SKIP.
     5115        End.
     5116       i=0.
     5117       run rep/extitle.p (1) .
     5118       display STREAM OutStream     with frame top-Frame .
     5119      END PROCEDURE.
     5120   PROCEDURE Print-Footer :
     5121     define variable v-today as date      no-undo.
     5122     define variable v-time  as integer   no-undo.
     5123     run cur-time in this-procedure ( output v-today
     5124                                    , output v-time
     5125                                    ).
     5126     PUT STREAM OutStream UNFORMATTED " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     5127     PUT STREAM OutStream UNFORMATTED " За время формирования отчета были закрыты документы : " SKIP.
     5128     for each obj-list :
     5129     for each trn-doc no-lock where
     5130         trn-doc.status_ = 'факт':U and
     5131         trn-doc.flag_= true  and
     5132         trn-doc.obj-code = obj-list.obj-code and
     5133         trn-doc.obj-type = obj-list.obj-type and
     5134         trn-doc.host-code = v-cntxt-host-code-obj and
     5135         trn-doc.fact-order > fact-order-2 .
     5136         PUT STREAM OutStream  UNFORMATTED trn-doc.doc-code SKIP.
     5137      end.
     5138     end.
     5139     PUT STREAM OutStream UNFORMATTED " ______________________________________________________" SKIP.
     5140      run on-same-page in this-procedure (input 1) .
     5141      END PROCEDURE.
     5142   PROCEDURE U-LINE :
     5143   define variable ff as character no-undo .
     5144   if itog = false
     5145   Then do:
     5146   ff = fill("-",40).
     5147     if c-nn <>  ?  then do :
     5148       c-nn:screen-value = string(ff) .
     5149       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5150           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5151           display STREAM OutStream    with frame top-frame .
     5152       End.
     5153     End.
     5154     if c-f-b-code <>  ?  then do :
     5155       c-f-b-code:screen-value = string(ff) .
     5156       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5157           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5158           display STREAM OutStream    with frame top-frame .
     5159       End.
     5160     End.
     5161     if c-f-artic <>  ?  then do :
