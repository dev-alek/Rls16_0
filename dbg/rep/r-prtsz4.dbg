     5342   PROCEDURE CalcItog :
     5343   run ostatok  in this-procedure (
     5344       input x-store-code  ,
     5345       input x-store-type  , x-TOG-Shift,
     5346       input x-date-start - 1 ,
     5347       input date('')      , x-Shift-Start,x-Shift-End,
     5348       input 'crsa':U   ,
     5349       input '##,##':U,
     5350       input xTog-obj ,
     5351       output  Quantity1  ,
     5352       output  Coast_R1   ,
     5353       output  Coast_V1   ,
     5354       output  VAT_R1     ,
     5355       output  VAT_V1     ,
     5356       output  Fact-order-1 ).
     5357       Quantity1  = 0.
     5358       Coast_R1   = 0.
     5359       Coast_V1   = 0.
     5360       VAT_R1     = 0.
     5361       VAT_V1     = 0.
     5362   define variable max-val like trn-doc.fact-order no-undo .
     5363   define variable max-val-old like trn-doc.fact-order no-undo .
     5364   max-val-old  = 0 .
     5365   for each obj-list :
     5366     fact-order-2 = 0 .
     5367     find last trn-doc no-lock where
     5368         trn-doc.status_  = 'факт':U and
     5369         trn-doc.flag_    = true  and
     5370         trn-doc.obj-code = obj-list.obj-code and
     5371         trn-doc.obj-type = obj-list.obj-type
     5372         use-index fact-order .
     5373      if available trn-doc then   fact-order-2 = trn-doc.fact-order  .
     5374          max-val = fact-order-2 .
     5375      if  max-val < max-val-old then max-val =  max-val-old .
     5376          max-val-old  =  fact-order-2.
     5377    end.
     5378    fact-order-2  = max-val .
     5379   END PROCEDURE.
