      645       define variable v-ok            as logical   no-undo .
      646       define variable v-curr-sv-date  as date      no-undo .
      647       define variable v-description   as character no-undo .
      648       assign
      649         v-curr-sv-date = date(self :screen-value) no-error
      650       .
      651       if v-curr-sv-date = ?
      652       then do:
      653         run gbl/getcurdt.p
      654           (output v-curr-sv-date
      655           ) .
      656       end.
      657       if v-curr-sv-date <> ?
      658       then do:
      659         run gbl/d-inpday.w
      660           (input ?
      661           ,input "Выбор даты"
      662           ,input v-description
      663           ,input ""
      664           ,input-output v-curr-sv-date
      665           ,output v-ok
      666           ).
      667         if v-ok = true
      668         then do:
      669           assign
      670             self :screen-value = string(v-curr-sv-date) .
      671           .
      672         end.
      673       end.
      674     end.
      675     return no-apply .
      676   end.
      677     define MENU m-ed-date4
      678       MENU-ITEM m-ed-date4-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
      679       MENU-ITEM m-ed-date4-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
      680       MENU-ITEM m-ed-date4-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
      681       MENU-ITEM m-ed-date4-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
      682       .
      683     if Date-End :POPUP-MENU in frame Dialog-Frame = ?
      684     then do:
      685       ASSIGN
      686         Date-End :POPUP-MENU in frame Dialog-Frame = MENU m-ed-date4 :HANDLE
      687         Date-End :MENU-MOUSE in frame Dialog-Frame = 3
      688       .
      689     end.
      690     define variable v-label-handle4 as handle no-undo .
      691     assign
      692       v-label-handle4 = Date-End :side-label-handle in frame Dialog-Frame
      693     .
      694     if valid-handle (v-label-handle4)
      695     then do:
      696       if v-label-handle4 :tooltip = ""
      697       or v-label-handle4 :tooltip = ?
      698       then do:
      699         assign
      700           v-label-handle4 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
      701         .
      702       end.
      703     end.
      704     ON CHOOSE OF MENU-ITEM m-ed-date4-1 in menu m-ed-date4 DO:
      705       apply "ctrl-b":U to Date-End in frame Dialog-Frame .
      706     END.
      707     ON CHOOSE OF MENU-ITEM m-ed-date4-2 in menu m-ed-date4 DO:
      708       apply "ctrl-d":U to Date-End in frame Dialog-Frame .
      709     END.
      710     ON CHOOSE OF MENU-ITEM m-ed-date4-3 in menu m-ed-date4 DO:
      711       apply "ctrl-e":U to Date-End in frame Dialog-Frame .
      712     END.
      713     ON CHOOSE OF MENU-ITEM m-ed-date4-4 in menu m-ed-date4 DO:
      714       apply "ctrl-f":U to Date-End in frame Dialog-Frame .
      715     END.
      716     RUN enable_UI.
      717     WAIT-FOR GO OF FRAME Dialog-Frame.
      718   END.
      719   RUN disable_UI.
      720   PROCEDURE disable_UI :
      721     HIDE FRAME Dialog-Frame.
      722   END PROCEDURE.
      723   PROCEDURE enable_UI :
      724     DISPLAY Date-Start Date-End
      725       WITH FRAME Dialog-Frame.
      726     ENABLE Btn_OK Btn_Cancel RECT-8 Date-Start b-date-Start Date-End b-date-End
      727       WITH FRAME Dialog-Frame.
      728     VIEW FRAME Dialog-Frame.
      729   END PROCEDURE.
