       29   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       30   procedure sel-date :
       31     define input  parameter p-date-handle as handle    no-undo .
       32     define input  parameter p-description as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if (can-query (p-date-handle, "sensitive")
       37         and
       38         p-date-handle :sensitive = true
       39         )
       40       or (can-query (p-date-handle, "read-only")
       41         and
       42         p-date-handle :read-only = false
       43         )
       44       then do:
       45         if p-date-handle :handle <> focus :handle
       46         then do:
       47           apply "entry":u to p-date-handle .
       48         end.
       49         define variable v-ok            as logical no-undo .
       50         define variable v-curr-sv-date as date no-undo .
       51         assign
       52           v-curr-sv-date = date(p-date-handle :screen-value) no-error
       53         .
       54         if v-curr-sv-date = ?
       55         then do:
       56           run gbl/getcurdt.p
       57             (output v-curr-sv-date
       58             ) .
       59         end.
       60         if v-curr-sv-date <> ?
       61         then do:
       62           run gbl/d-inpday.w
       63             (input ?
       64             ,input "Выбор даты"
       65             ,input p-description
       66             ,input ""
       67             ,input-output v-curr-sv-date
       68             ,output v-ok
       69             ).
       70           if v-ok = true
       71           then do:
       72             assign
       73               p-date-handle :screen-value = string(v-curr-sv-date) .
       74             .
       75           end.
       76         end.
       77       end.
       78     end.
       79   end procedure.
       80   DEFINE INPUT PARAMETER  parParentProc  AS WIDGET-HANDLE NO-UNDO.
       81   define input-output  PARAMETER TABLE FOR tt-dateZakaz.
       82   define buffer buf_dateZakaz for tt-dateZakaz .
       83   DEFINE BUTTON b-date-End
       84     IMAGE-UP FILE "btn-down-arrow":U
       85     IMAGE-DOWN FILE "btn-down-arrow":U
       86     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       87     LABEL ""
       88     SIZE 3 BY .88.
       89   DEFINE BUTTON b-date-Start
       90     IMAGE-UP FILE "btn-down-arrow":U
       91     IMAGE-DOWN FILE "btn-down-arrow":U
       92     IMAGE-INSENSITIVE FILE "btn-down-arrow":U
       93     LABEL ""
       94     SIZE 3 BY .88.
       95   DEFINE BUTTON Btn_Cancel AUTO-END-KEY
       96     LABEL "Отмена"
       97     SIZE 15 BY 1.13
       98     BGCOLOR 8 .
       99   DEFINE BUTTON Btn_OK AUTO-GO
      100     LABEL "Ввод"
      101     SIZE 15 BY 1.13
      102     BGCOLOR 8 .
      103   DEFINE VARIABLE Date-End   AS DATE FORMAT "99/99/9999":U
      104     LABEL "по"
      105     VIEW-AS FILL-IN NATIVE
      106     SIZE 13 BY 1
      107     BGCOLOR 15 NO-UNDO.
      108   DEFINE VARIABLE Date-Start AS DATE FORMAT "99/99/9999":U
      109     LABEL "С"
      110     VIEW-AS FILL-IN NATIVE
      111     SIZE 13 BY 1
      112     BGCOLOR 15 NO-UNDO.
      113   DEFINE RECTANGLE RECT-8
      114     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      115     SIZE 47 BY 2.5.
      116   DEFINE FRAME Dialog-Frame
      117     Btn_OK AT ROW 1 COL 1
      118     Btn_Cancel AT ROW 1 COL 16
      119     Date-Start AT ROW 3.5 COL 6 COLON-ALIGNED WIDGET-ID 34
      120     b-date-Start AT ROW 3.5 COL 23 RIGHT-ALIGNED WIDGET-ID 374
      121     Date-End AT ROW 3.5 COL 42 RIGHT-ALIGNED WIDGET-ID 32
      122     b-date-End AT ROW 3.5 COL 45 RIGHT-ALIGNED WIDGET-ID 376
      123     RECT-8 AT ROW 2.75 COL 3 WIDGET-ID 378
      124     SPACE(1.24) SKIP(0.66)
      125     WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      126     SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      127     TITLE "Задайте период"
      128     DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel WIDGET-ID 100.
      129   ASSIGN
      130     FRAME Dialog-Frame:SCROLLABLE = FALSE
      131     FRAME Dialog-Frame:HIDDEN     = TRUE.
      132   ASSIGN
      133     b-date-End:HIDDEN IN FRAME Dialog-Frame = TRUE.
      134   ASSIGN
      135     b-date-Start:HIDDEN IN FRAME Dialog-Frame = TRUE.
      136   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      137     DO:
      138       APPLY "END-ERROR":U TO SELF.
      139     END.
      140   ON CHOOSE OF btn_ok IN FRAME Dialog-Frame
      141     DO:
      142     find first tt-dateZakaz no-error .
      143     if not available (tt-dateZakaz) then do:
      144       create tt-dateZakaz .
      145       assign
      146       tt-dateZakaz.id = 1
      147       tt-dateZakaz.dateStart = Date-Start
      148       tt-dateZakaz.dateEnd = Date-End .
      149     end.
      150     else do:
      151       find first tt-dateZakaz no-lock where (Date-Start >= tt-dateZakaz.dateStart and Date-Start <= tt-dateZakaz.dateEnd) or
      152       (Date-End >= tt-dateZakaz.dateStart and Date-End <= tt-dateZakaz.dateEnd) no-error .
      153       if available (tt-dateZakaz) then do:
      154         message "Выбранный интервал пересекается с предыдущим"
      155         view-as alert-box.
      156         return no-apply .
      157       end.
      158       find last tt-dateZakaz no-error .
      159       if available (tt-dateZakaz) then do:
      160         create buf_dateZakaz .
      161         assign
      162         buf_dateZakaz.id = tt-dateZakaz.id + 1
      163         buf_dateZakaz.dateEnd = Date-End
      164         buf_dateZakaz.dateStart = Date-Start
      165         .
      166       end.
      167     end.
      168     END.
      169   ON CHOOSE OF b-date-End IN FRAME Dialog-Frame
      170     DO:
      171       run sel-date in this-procedure
      172         (input Date-End :handle
      173         ,input ""
      174         ) .
      175       if date(Date-End:screen-value) < Date-Start then
      176       do:
      177         message "Дата начала не может быть больше конечной даты"
      178           view-as alert-box.
      179         display Date-End with frame Dialog-Frame .
      180       end.
      181       if date(Date-End:screen-value) >= today then
      182       do:
      183         message "Дата окончания периода продаж должна быть меньше текущей"
      184           view-as alert-box.
      185         display Date-End with frame Dialog-Frame .
      186       end.
      187     END.
      188   ON CHOOSE OF b-date-Start IN FRAME Dialog-Frame
      189     DO:
      190       run sel-date in this-procedure
      191         (input Date-Start :handle
      192         ,input ""
      193         ) .
      194       if Date-End < date(Date-Start:screen-value) then
      195       do:
      196         message "Дата начала не может быть больше конечной даты"
      197           view-as alert-box.
      198         display Date-Start with frame Dialog-Frame .
      199       end.
      200       if date(Date-Start:screen-value) >= today then
      201       do:
      202         message "Дата начала периода продаж должна быть меньше текущей"
      203           view-as alert-box.
      204         display Date-Start with frame Dialog-Frame .
      205       end.
      206     END.
      207   ON LEAVE OF Date-End IN FRAME Dialog-Frame
      208     DO:
      209       apply "TAB":U to self .
      210     END.
      211   ON LEAVE OF Date-Start IN FRAME Dialog-Frame
      212     DO:
      213       apply "TAB":U to self .
      214     END.
      215   ON RETURN OF Date-End IN FRAME Dialog-Frame
      216     DO:
      217       apply "TAB":U to self .
      218     END.
      219   ON TAB OF Date-End IN FRAME Dialog-Frame
      220     DO:
      221       if string(Date-End) <> Date-End:screen-value then
      222       do:
      223         if date(Date-End:screen-value) < Date-Start then
      224         do:
      225           message "Дата начала не может быть больше конечной даты"
      226             view-as alert-box.
      227           return no-apply .
      228         end.
      229         if date(Date-End:screen-value) >= today then
      230         do:
      231           message "Дата окончания периода продаж должна быть меньше текущей"
      232             view-as alert-box.
      233           display Date-End with frame Dialog-Frame .
      234           return .
      235         end.
      236         assign Date-End .
      237         display Date-End with frame Dialog-Frame .
      238       end.
      239     END.
      240   ON RETURN OF Date-Start IN FRAME Dialog-Frame
      241     DO:
      242       apply "TAB":U to self .
      243     END.
      244   ON TAB OF Date-Start IN FRAME Dialog-Frame
      245     DO:
      246       if string(Date-Start) <> Date-Start:screen-value then
      247       do:
      248         if Date-End < date(Date-Start:screen-value) then
      249         do:
      250           message "Дата начала не может быть больше конечной даты"
      251             view-as alert-box.
      252           return no-apply .
      253         end.
      254         if date(Date-Start:screen-value) >= today then
      255         do:
      256           message "Дата начала периода продаж должна быть меньше текущей"
      257             view-as alert-box.
      258           display Date-Start with frame Dialog-Frame .
      259           return .
      260         end.
      261         assign Date-Start .
      262         display Date-Start with frame Dialog-Frame .
      263       end.
      264     END.
      265   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      266     THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      267   MAIN-BLOCK:
      268   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
