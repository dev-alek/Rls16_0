        1   define temp-table  tt-dateZakaz     no-undo
        2   field id as integer
        3   field dateStart as date
        4   field dateEnd as date
        5   index pi id
        6       .
        7   DEFINE TEMP-TABLE tt-typeDocChoose NO-UNDO
        8     field type-code as character
        9     field typeName  as character.
       10   define temp-table gds-list like ub.goods
       11     field minZapas as decimal
       12     field contract as character
       13     field contract-code as integer
       14     field price as decimal
       15     field doc-qnty as decimal
       16     index pi contract gds-code.
       17    define temp-table choose-gds-list like ub.goods
       18     field minZapas as decimal
       19     field contract as character
       20     field contract-code as integer
       21     field price as decimal
       22     field doc-qnty as decimal
       23     index pi contract gds-code.
