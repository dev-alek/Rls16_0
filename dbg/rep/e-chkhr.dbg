     1028   define variable mWaitProcEvent              as logical     no-undo init yes.
     1029   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1030   define variable mWaitFramStop               as logical     no-undo.
     1031   define variable mWaitFramStopUser           as logical     no-undo.
     1032   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1033   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1034   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1035   define button B-WaitFramStop auto-end-key
     1036        label "Стоп"
     1037        size 10 by 1 tooltip "Остоновить процесс".
     1038   define button B-viewProcInfo
     1039        label "Информация"
     1040        size 15 by 1 tooltip "Информация о процесс".
     1041   define frame waitfram
     1042     v-waitfram-action01 format "x(72)" no-label skip
     1043     v-waitfram-action02 format "x(72)" no-label skip
     1044     v-waitfram-action03 format "x(72)" no-label skip
     1045     B-viewProcInfo
     1046     B-WaitFramStop at row 4 col 30
     1047     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1048     .
     1049   define new global shared variable mBatchMode as logical no-undo init ?.
     1050   define variable mFramBachModHandle as handle no-undo.
     1051   mFramBachModHandle = frame waitfram:handle.
     1052   define variable mFameOldVis as logical no-undo.
     1053   define variable mVisCUrentVin as logical no-undo.
     1054   if session:batch-mode
     1055   then
     1056      mBatchMode = yes.
     1057   if mBatchMode = ? then do:
     1058     mVisCUrentVin = current-window:visible.
     1059     mFameOldVis = mFramBachModHandle:visible.
     1060     mFramBachModHandle:visible  = yes.
     1061     mBatchMode = mFramBachModHandle:visible ne yes.
     1062     mFramBachModHandle:visible = mFameOldVis.
     1063     current-window:visible = mVisCUrentVin.
     1064   end.
     1065    if  log-manager:logfile-name ne ?
     1066     then DO:
     1067         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1068         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1069         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1070     end.
     1071   on choose of B-WaitFramStop in frame waitfram
     1072   do:
     1073     mWaitFramStop = yes.
     1074     mWaitFramStopUser = yes.
     1075   end.
     1076   function waitfram-check-timeout returns logical():
     1077      define variable vtime as int64 no-undo.
     1078      if mWaitFramStopTimeOut
     1079      then
     1080         return yes.
     1081      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1082      if     mWaitFramTimeOut ne ?
     1083         and mWaitFramTimeOut ne 0
     1084         and mWaitFramTimeOut lt vtime
     1085      then do:
     1086         mWaitFramStopTimeOut = yes.
     1087      end.
     1088      return mWaitFramStopTimeOut.
     1089   end.
     1090   procedure waitfram-hide :
     1091     if not session:batch-mode
     1092     then do
     1093     on error undo, return error return-value
     1094     :
     1095       pause 0 before-hide .
     1096       if not mBatchMode then
     1097         hide frame waitfram .
     1098     if     not mWaitFramView
     1099        and mWaitProcEvent
     1100     then
     1101       process events .
     1102     end.
     1103   end procedure.
     1104   procedure waitfram-show :
     1105     define input  parameter p-message as character no-undo .
     1106     define variable v-left-margin as integer   no-undo .
     1107     if not session:batch-mode
     1108     then do
     1109     on error undo, return error return-value
     1110     :
     1111       if length(p-message) <= 70 then do:
     1112         assign
     1113           v-left-margin = integer((70 - length(p-message)) / 2)
     1114         .
     1115         assign
     1116           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1117         .
     1118         assign
     1119           v-waitfram-action01 = " "
     1120           v-waitfram-action02 = " "
     1121                                    + fill(" ", v-left-margin)
     1122                                    + p-message
     1123           v-waitfram-action03 = " "
     1124         .
     1125       end.
     1126       else do:
     1127         define variable vRindex1 as integer no-undo.
     1128         define variable vRindex2 as integer no-undo.
     1129         vRindex1 = r-index(p-message," ",70).
     1130         if vRindex1 = 0
     1131         then
     1132            vRindex1 = 70.
     1133         if length(p-message)  <= vRindex1 + 70 then do:
     1134           assign
     1135             v-waitfram-action01 = " "
     1136             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1137             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1138           .
     1139         end.
     1140         else do:
     1141           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1142           if vRindex2 <= vRindex1
     1143           then
     1144              vRindex2 = vRindex1 + 70.
     1145           assign
     1146             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1147             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1148             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1149           .
     1150         end.
     1151       end.
     1152       B-viewProcInfo:visible   in frame waitfram = no.
     1153       B-viewProcInfo:sensitive in frame waitfram = no.
     1154       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1155       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1156       if  (   mWaitFramView
     1157          or  mWaitProcEvent)
     1158          and not mBatchMode
     1159       then
     1160          display
     1161             v-waitfram-action01 skip
     1162             v-waitfram-action02 skip
     1163             v-waitfram-action03 skip
     1164          with frame waitfram .
     1165       if     mWaitFramView
     1166          then do:
     1167             if     mWaitFramInterval ne ?
     1168                and not mBatchMode
     1169             then
     1170                wait-for go of frame waitfram pause mWaitFramInterval.
     1171          end.
     1172          else
     1173             if     mWaitProcEvent
     1174                and not mBatchMode
     1175             then
     1176                process events .
     1177     end.
     1178   end procedure.
     1179      procedure waitfram-show-this:
     1180         define input  parameter iInterval as int64 no-undo.
     1181         define variable vtime as int64 no-undo.
     1182         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1183         mWaitFramInterval = iInterval.
     1184         run waitfram-show (substitute("&1&2 &3&4" ,
     1185                                       mWaitFramTextBeg ,
     1186                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1187                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1188                                       mWaitFramTextEnd
     1189                                      )
     1190                           ).
     1191      end.
     1192      procedure WaitFramRunPause:
     1193         define input  parameter iInterval as dec no-undo.
     1194         define variable vStart  as datetime-tz no-undo.
     1195         define variable vend    as datetime-tz no-undo.
     1196         define variable vint as int64 no-undo.
     1197         define variable vOk as logical no-undo.
     1198         vStart = now.
     1199         vend   = vStart.
     1200         publish "WaitFramPause" (iInterval,output vOk).
     1201         vend   =  now.
     1202         vint = vend - vStart.
     1203         vint = iInterval - vint / 1000.
     1204         if     not mWaitFramStop
     1205            and (   vint > 0
     1206                 or (    not vOk
     1207                     and iInterval eq ?
     1208                     )
     1209                 )
     1210         then
     1211            run waitfram-show-this (iInterval).
     1212         vend   =  now.
     1213         vint = vend - vStart.
     1214         vint = iInterval - vint / 1000.
     1215         if     not mWaitFramStop
     1216            and vint > 0
     1217         then do:
     1218            run gbl/pause.p (vint * 1000).
     1219         end.
     1220         if iInterval ne ?
     1221         then
     1222            publish "WaitFramStop".
     1223         waitfram-check-timeout().
     1224      end.
     1225      procedure WaitFramWaitFor:
     1226         define input  parameter iInterval as dec no-undo.
     1227         assign
     1228            mWaitFramStartProc   = now
     1229            mWaitFramStopUser    = no
     1230            mWaitFramStopTimeOut = no
     1231         .
     1232         block-wait:
     1233         do while not mWaitFramStop:
     1234            run WaitFramRunPause (iInterval).
     1235            if  waitfram-check-timeout()
     1236            then do:
     1237               leave block-wait.
     1238            end.
     1239         end.
     1240         run waitfram-hide.
     1241      end.
     1242   procedure waitfram-join :
     1243     define input  parameter p-line-1  as character no-undo .
     1244     define input  parameter p-line-2  as character no-undo .
     1245     define input  parameter p-line-3  as character no-undo .
     1246     define output parameter p-message as character no-undo .
     1247     do
     1248     on error undo, return error return-value
     1249     :
     1250       assign
     1251         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1252                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1253                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1254       .
     1255     end.
     1256   end procedure.
     1257   function waitfram-join-function returns character
     1258     (input p-line-1 as character
     1259     ,input p-line-2 as character
     1260     ,input p-line-3 as character
     1261     ).
     1262     define variable v-message as character no-undo .
     1263     run waitfram-join in this-procedure
     1264       (input  p-line-1
     1265       ,input  p-line-2
     1266       ,input  p-line-3
     1267       ,output v-message
     1268       ) .
     1269     return v-message .
     1270   end function .
     1271   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1272   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1274   define variable par-type          as character no-undo.
     1275   define variable v-value-character as character no-undo .
     1276   define variable v-value-date      as date      no-undo .
     1277   define variable v-value-decimal   as decimal   no-undo .
     1278   define variable v-value-integer   as integer   no-undo .
     1279   define variable v-value-logical   as logical   no-undo .
     1280   define variable parparentproc as widget-handle no-undo .
     1281   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1282     define variable v-cntxt-db-num        as integer   no-undo .
     1283     define variable v-cntxt-userid        as character no-undo .
     1284     define variable v-cntxt-level         as character no-undo .
     1285     define variable v-cntxt-host-code-obj as integer   no-undo .
     1286     define variable v-cntxt-obj-type      as character no-undo .
     1287     define variable v-cntxt-obj-code      as integer   no-undo .
     1288     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1289     define variable v-cntxt-is-admin      as logical   no-undo .
     1290   define buffer cli-obj for ub.clients .
     1291   define variable ii as integer.
     1292   DEFINE VARIABLE h_s-hour AS HANDLE NO-UNDO.
     1293   DEFINE VARIABLE RS-dis-card AS INTEGER
     1294        VIEW-AS RADIO-SET VERTICAL
     1295        RADIO-BUTTONS
     1296             "Все типы карт", 0,
     1297   "Выборочно", 1
     1298        SIZE 19 BY 2.13 NO-UNDO.
     1299   DEFINE VARIABLE RS-OPTION AS INTEGER
     1300        VIEW-AS RADIO-SET VERTICAL
     1301        RADIO-BUTTONS
     1302             "Только итоги", 1,
     1303   "С разбивкой по объектам", 2,
     1304   "С разбивкой итоги", 3
     1305        SIZE 25.63 BY 2.83 NO-UNDO.
     1306   DEFINE VARIABLE T-dis-card AS LOGICAL INITIAL no
     1307        LABEL "Только покупки по картам"
     1308        VIEW-AS TOGGLE-BOX
     1309        SIZE 26.63 BY 1 NO-UNDO.
     1310   DEFINE QUERY BR-dis-card-type FOR
     1311         temp-dis-card-type SCROLLING.
     1312   DEFINE BROWSE BR-dis-card-type
     1313     QUERY BR-dis-card-type DISPLAY
     1314         temp-dis-card-type.type COLUMN-LABEL "Тип" FORMAT "X(8)":U
     1315         temp-dis-card-type.emitent-host-code COLUMN-LABEL "Код эмитента" FORMAT "99999":U
     1316       WITH NO-ROW-MARKERS SEPARATORS SIZE 23.63 BY 8.04
     1317            TITLE "Выбранные типы карт".
     1318   DEFINE FRAME F-Main
     1319        T-dis-card AT ROW 1.21 COL 49.75
     1320        RS-dis-card AT ROW 2.88 COL 49.88 NO-LABEL
     1321        BR-dis-card-type AT ROW 5.63 COL 49.13
     1322        RS-OPTION AT ROW 12.71 COL 2 NO-LABEL
     1323       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1324            SIDE-LABELS NO-UNDERLINE THREE-D
     1325            AT COL 1 ROW 1
     1326            SIZE 77.38 BY 16.21.
     1327   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1328   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1329   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1330   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1331   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1332   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1333   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1334   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1335       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1336   RUN ensure-broker.
     1337   THIS-PROCEDURE:ADM-DATA =
     1338        'ADM1.1~`':U +
     1339        'SmartObject~`':U +
     1340        'FRAME~`':U +
     1341        'NO ~`':U +
     1342        '~`':U +
     1343        'temp-dis-card-type~`':U +
     1344        '~`':U +
     1345        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1346           + "~`":U +
     1347        'Layout,Hide-on-Init~`':U +
     1348        '~`':U +
     1349        '~`':U +
     1350        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1351        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1352            THEN "^^":U
     1353        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1354             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1355   PROCEDURE adm-apply-entry :
     1356     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1357   END PROCEDURE.
     1358   PROCEDURE adm-destroy :
     1359    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1360   END PROCEDURE.
     1361   PROCEDURE adm-disable :
     1362       DISABLE T-dis-card BR-dis-card-type RS-OPTION WITH FRAME F-Main.
     1363       RUN dispatch ('disable-fields':U).
     1364       RUN set-attribute-list ('ENABLED=no':U).
     1365       RETURN.
     1366   END PROCEDURE.
     1367   PROCEDURE adm-edit-attribute-list :
     1368         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1369         RETURN.
     1370   END PROCEDURE.
     1371   PROCEDURE adm-enable :
     1372       ENABLE UNLESS-HIDDEN T-dis-card BR-dis-card-type RS-OPTION WITH FRAME F-Main.
     1373       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1374       RUN set-attribute-list ('ENABLED=yes':U).
     1375       RETURN.
     1376   END PROCEDURE.
     1377   PROCEDURE adm-exit :
     1378        RUN notify ('exit':U).
     1379     RETURN.
     1380   END PROCEDURE.
     1381   PROCEDURE adm-hide :
     1382     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1383   END PROCEDURE.
     1384   PROCEDURE adm-initialize :
     1385     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1386   END PROCEDURE.
     1387   PROCEDURE adm-show-errors :
     1388       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1389       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1390           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1391       END.
     1392       RETURN.
     1393   END PROCEDURE.
     1394   PROCEDURE adm-UIB-mode :
     1395     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1396   END PROCEDURE.
     1397   PROCEDURE adm-view :
     1398     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1399   END PROCEDURE.
     1400   PROCEDURE dispatch :
     1401       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1402       RUN broker-dispatch IN adm-broker-hdl
     1403           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1404       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1405   END PROCEDURE.
     1406   PROCEDURE ensure-broker :
     1407   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1408   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1409   DO:
     1410       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1411       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1412   END.
     1413   END PROCEDURE.
     1414   PROCEDURE get-attribute :
     1415     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1416     RUN broker-get-attribute IN adm-broker-hdl
     1417         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1418     RETURN RETURN-VALUE.
     1419   END PROCEDURE.
     1420   PROCEDURE get-attribute-list :
     1421     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1422     RUN broker-get-attribute-list IN adm-broker-hdl
     1423         (INPUT THIS-PROCEDURE,
     1424          INPUT ?,
     1425          OUTPUT p-attr-list) NO-ERROR.
     1426     RETURN.
     1427   END PROCEDURE.
     1428   PROCEDURE new-state :
     1429     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1430     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1431     RETURN.
     1432   END PROCEDURE.
     1433   PROCEDURE notify :
     1434     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1435     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1436     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1437         RETURN "ADM-ERROR":U.
     1438     RETURN.
     1439   END PROCEDURE.
     1440   PROCEDURE set-attribute-list :
     1441     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1442     RUN ensure-broker.
     1443     RUN broker-set-attribute-list IN adm-broker-hdl
     1444         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1445     RETURN.
     1446   END PROCEDURE.
     1447   PROCEDURE set-position :
     1448       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1449       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1450       IF VALID-HANDLE(adm-object-hdl) THEN
     1451       DO:
     1452           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1453           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1454           DO:
     1455             IF p-row = 0 THEN p-row =
     1456               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1457             IF p-col = 0 THEN p-col =
     1458               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1459           END.
     1460           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1461           DO:
     1462             parent-hdl = adm-object-hdl:PARENT.
     1463             IF p-row = 0 THEN p-row =
     1464               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1465                 parent-hdl:ROW.
     1466             IF p-col = 0 THEN p-col =
     1467               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1468                 parent-hdl:COL.
     1469           END.
     1470           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1471           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1472         ASSIGN adm-object-hdl:ROW    =   p-row
     1473                adm-object-hdl:COLUMN =   p-col.
     1474       END.
     1475       RETURN.
     1476   END PROCEDURE.
     1477   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1478       STRING(adm-object-hdl)).
     1479   PAUSE 0 BEFORE-HIDE.
     1480   PROCEDURE adm-change-page :
     1481     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1482     END PROCEDURE.
     1483   PROCEDURE delete-page :
     1484     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1485     RUN broker-delete-page IN adm-broker-hdl
     1486         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1487     END PROCEDURE.
     1488   PROCEDURE init-object :
     1489     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1490     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1491     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1492     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1493     RUN broker-init-object IN adm-broker-hdl
     1494         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1495          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1496     RETURN.
     1497   END PROCEDURE.
     1498   PROCEDURE init-pages :
     1499     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1500     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1501         INPUT p-page-list) NO-ERROR.
     1502     END PROCEDURE.
     1503   PROCEDURE select-page :
     1504     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1505     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1506         INPUT p-page#) NO-ERROR.
     1507     END PROCEDURE.
     1508   PROCEDURE view-page :
     1509     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1510     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1511         INPUT p-page#).
     1512     END PROCEDURE.
     1513   ASSIGN
     1514          BR-dis-card-type:HIDDEN  IN FRAME F-Main                = TRUE.
     1515   ON VALUE-CHANGED OF RS-dis-card IN FRAME F-Main
     1516   DO:
     1517   DEFINE VARIABLE varrid-list as character no-undo.
     1518     ASSIGN
     1519     RS-dis-card.
     1520     CASE RS-dis-card:
     1521       when 1 then do:
     1522           run ref/dc-types.w (
     1523                          input my-handle
     1524                         ,input "":U
     1525                         ,INPUT "b-sel,b-mark":U
     1526                         ,INPUT 0
     1527                         ,INPUT v-cntxt-host-code-obj
     1528                         ,INPUT v-cntxt-obj-type
     1529                         ,INPUT v-cntxt-obj-type
     1530                         ,input-OUTPUT varrid-list).
     1531           if varrid-list = "" then do:
     1532               for each temp-dis-card-type:
     1533                   delete temp-dis-card-type.
     1534               end.
     1535               rs-dis-card = 0.
     1536               OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1537               DISPLAY
     1538               rs-dis-card
     1539               with frame F-Main.
     1540               HIDE
     1541               br-dis-card-type
     1542               in frame F-Main.
     1543           end.
     1544           else dO:
     1545             DO ii = 1 to num-entries(varrid-list):
     1546               FIND FIRST ub.dis-card-type No-LOCK WHERE
     1547                                 recid(ub.dis-card-type) = integer(entry(ii, varrid-list)) No-ERROR.
     1548             if avail ub.dis-card-type then dO:
     1549               create temp-dis-card-type.
     1550               buffer-copy ub.dis-card-type to temp-dis-card-type.
     1551             END.
     1552           END.
     1553           OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1554           DISPLAY
     1555           br-dis-card-type
     1556           with frame F-Main .
     1557         end.
     1558       end.
     1559       when 0 then do:
     1560         for each temp-dis-card-type:
     1561           delete temp-dis-card-type.
     1562         end.
     1563        OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1564         HIDE
     1565         br-dis-card-type
     1566         in frame F-Main.
     1567       end.
     1568     END CASE.
     1569   END.
     1570   ON VALUE-CHANGED OF T-dis-card IN FRAME F-Main
     1571   DO:
     1572     assign
     1573     t-dis-card.
     1574     CASE t-dis-card:
     1575       when yes then do:
     1576           assign
     1577           Rs-dis-card = 0.
     1578           DISPLAY
     1579           RS-dis-card
     1580           with frame F-Main.
     1581           ENABLE
     1582           RS-dis-card
     1583           with frame F-Main.
     1584       end.
     1585       when no then do:
     1586           assign
     1587           Rs-dis-card = 0.
     1588           DISABLE
     1589           RS-dis-card
     1590           with frame F-Main.
     1591       end.
     1592     END CASE.
     1593   END.
     1594   if not this-procedure :persistent
     1595   then do:
     1596     message
     1597       vss-workfile vss-revision vss-description skip
     1598       "Ошибка при запуске процедуры" skip
     1599       "Данную процедуру следует запускать только с параметром persistent" skip
     1600       view-as alert-box error .
     1601     undo, return error .
     1602   end.
     1603   assign
     1604   loc#db-num = v-cntxt-db-num
     1605   loc#host-code = v-cntxt-host-code-obj
     1606   loc#store-code = v-cntxt-obj-code
     1607   .
     1608   PROCEDURE adm-create-objects :
     1609     DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.
     1610     RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
     1611     ASSIGN adm-current-page = INTEGER(RETURN-VALUE).
     1612     CASE adm-current-page:
     1613       WHEN 0 THEN DO:
     1614          RUN init-object IN THIS-PROCEDURE (
     1615                INPUT  'rep/s-hour.w':U ,
     1616                INPUT  FRAME F-Main:HANDLE ,
     1617                INPUT  '':U ,
     1618                OUTPUT h_s-hour ).
     1619           RUN adjust-tab-order IN adm-broker-hdl ( h_s-hour ,
     1620           T-dis-card:HANDLE IN FRAME F-Main , 'BEFORE':U ).
     1621       END.
     1622     END CASE.
     1623   END PROCEDURE.
     1624   PROCEDURE adm-row-available :
     1625     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1626     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1627     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1628     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1629     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1630     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1631     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1632     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1633     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1634     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1635     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1636     IF adm-updating-record THEN RETURN.
     1637     RUN get-attribute ('FIELDS-ENABLED':U).
     1638     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1639     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1640         OUTPUT link-handle) NO-ERROR.
     1641     IF link-handle = "":U THEN
     1642         RETURN.
     1643     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1644     IF NUM-ENTRIES(link-handle) > 1 THEN
     1645         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1646             "encountered more than one RECORD-SOURCE.":U SKIP
     1647             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1648                VIEW-AS ALERT-BOX ERROR.
     1649     RUN get-attribute ('Key-Name':U).
     1650     key-name = RETURN-VALUE.
     1651     IF key-name = "":U THEN key-name = ?.
     1652     IF key-name NE ? THEN DO:
     1653       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1654         NO-ERROR.
     1655       IF key-value NE ? THEN
     1656         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1657     END.
     1658   IF VALID-HANDLE (adm-object-hdl) THEN
     1659       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1660   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1661   END PROCEDURE.
     1662   PROCEDURE disable_UI :
     1663     HIDE FRAME F-Main.
     1664     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1665   END PROCEDURE.
     1666   PROCEDURE enable_UI :
     1667     DISPLAY T-dis-card RS-dis-card RS-OPTION
     1668         WITH FRAME F-Main.
     1669     ENABLE T-dis-card BR-dis-card-type RS-OPTION
     1670         WITH FRAME F-Main.
     1671     OPEN QUERY BR-dis-card-type FOR EACH temp-dis-card-type NO-LOCK.
     1672   END PROCEDURE.
     1673   PROCEDURE ini-from-selobj :
     1674   DEFINE INPUT PARAMETER myp-state as character no-undo.
     1675       CASE myp-state:
     1676           WHEN 'все':U then do:
     1677                   ENABLE RS-OPTION with frame F-Main.
     1678           END.
     1679           WHEN "Текущий" then do:
     1680                   assign
     1681                    RS-OPTION = 1.
     1682                    Display RS-OPTION with frame F-Main.
     1683                    DISABLE RS-OPTION with frame F-Main.
     1684           END.
     1685           WHEN "Выборочно" then do:
     1686               if can-find(FIRST obj-list) then ENABLE RS-OPTION WITH FRAME F-Main.
     1687           END.
     1688       END CASE.
     1689   END PROCEDURE.
     1690   PROCEDURE local-initialize :
     1691     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1692     run ini-from-selobj in h_s-hour.
     1693     APPLY "VALUE-CHANGED" to T-dis-card in frame F-Main.
     1694     APPLY "VALUE-CHANGED" to RS-dis-card in frame F-Main.
     1695     parparentproc = my-handle.
     1696   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1697     define variable v-cntxt-db-num        as integer   no-undo .
     1698     define variable v-cntxt-userid        as character no-undo .
     1699     define variable v-cntxt-level         as character no-undo .
     1700     define variable v-cntxt-host-code-obj as integer   no-undo .
     1701     define variable v-cntxt-obj-type      as character no-undo .
     1702     define variable v-cntxt-obj-code      as integer   no-undo .
     1703     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1704     define variable v-cntxt-is-admin      as logical   no-undo .
     1705   END PROCEDURE.
     1706   PROCEDURE My-report :
     1707   define variable num-cols as integer.
     1708   define variable choice as integer.
     1709   define variable for-h as logical extent 24 no-undo.
     1710   define variable for-ch-str as character no-undo.
     1711   define variable glog as logical no-undo .
     1712   DEFINE VARIABLE for-h-str as character no-undo .
     1713   run Assign-Frame in h_s-hour.
     1714   assign
     1715   FRAME F-Main RS-OPTION
     1716   .
     1717   run my-var.
     1718   if vH-0 then for-h[1] = yes. else for-h[1] = no.
     1719   if vH-1 then for-h[2] = yes. else for-h[2] = no.
     1720   if vH-2 then for-h[3] = yes. else for-h[3] = no.
     1721   if vH-3 then for-h[4] = yes. else for-h[4] = no.
     1722   if vH-4 then for-h[5] = yes. else for-h[5] = no.
     1723   if vH-5 then for-h[6] = yes. else for-h[6] = no.
     1724   if vH-6 then for-h[7] = yes. else for-h[7] = no.
     1725   if vH-7 then for-h[8] = yes. else for-h[8] = no.
     1726   if vH-8 then for-h[9] = yes. else for-h[9] = no.
     1727   if vH-9 then for-h[10] = yes. else for-h[10] = no.
     1728   if vH-10 then for-h[11] = yes. else for-h[11] = no.
     1729   if vH-11 then for-h[12] = yes. else for-h[12] = no.
     1730   if vH-12 then for-h[13] = yes. else for-h[13] = no.
     1731   if vH-13 then for-h[14] = yes. else for-h[14] = no.
     1732   if vH-14 then for-h[15] = yes. else for-h[15] = no.
     1733   if vH-15 then for-h[16] = yes. else for-h[16] = no.
     1734   if vH-16 then for-h[17] = yes. else for-h[17] = no.
     1735   if vH-17 then for-h[18] = yes. else for-h[18] = no.
     1736   if vH-18 then for-h[19] = yes. else for-h[19] = no.
     1737   if vH-19 then for-h[20] = yes. else for-h[20] = no.
     1738   if vH-20 then for-h[21] = yes. else for-h[21] = no.
     1739   if vH-21 then for-h[22] = yes. else for-h[22] = no.
     1740   if vH-22 then for-h[23] = yes. else for-h[23] = no.
     1741   if vH-23 then for-h[24] = yes. else for-h[24] = no.
     1742   num-cols = ( integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1743                integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1744                integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1745                integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1746                integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ).
     1747   glog = ?.
     1748   if num-cols > 10 AND num-cols < 14  and NOT vXL
     1749   then do:
     1750     run gbl/d-askw.w (input "Формат вывода",
     1751                  input ("Количество интересующих Вас интервалов времени больше 10 :" + chr(10) +
     1752                         "отчет не уместится на бумаге формата А4 (ориентация альбомная)"
     1753                        ),
     1754                  input "|",
     1755                  input ("Выводить в Excel|" +
     1756                         "Формат А3 (ориентация альбомная)|" +
     1757                         "Уменьшить количество интервалов"),
     1758                  input "||",
     1759                  input 1,
     1760                  input 3,
     1761                  output choice).
     1762     if choice = 3 then return no-apply.
     1763     if choice = 1 then vxl = yes.
     1764     run display_ in h_s-hour.
     1765   end.
     1766   else if num-cols >=14 AND NOT vXL then do:
     1767      run gbl/d-askw.w (input "Формат вывода",
     1768                   input ("Количество интересующих Вас интервалов времени больше 13 :" + chr(10) +
     1769                   "отчет не уместится на бумаге формата А3 (ориентация альбомная)"
     1770                   ),
     1771                   input "|",
     1772                   input ("Выводить в Excel|" +
     1773                             "Уменьшить количество интервалов"),
     1774                   input "|",
     1775                   input 1,
     1776                   input 2,
     1777                   output choice).
     1778       if choice = 2 then return no-apply.
     1779       vxl = yes.
     1780       run display_ in h_s-hour.
     1781   end.
     1782   if (  integer( vH-0 ) + integer( vH-1 ) + integer( vH-2 ) + integer( vH-3 ) + integer( vH-4 ) +
     1783         integer( vH-5 ) + integer( vH-6 ) + integer( vH-7 ) + integer( vH-8 ) + integer( vH-9 ) +
     1784         integer( vH-10 ) + integer( vH-11 ) + integer( vH-12 ) + integer( vH-13 ) + integer( vH-14 ) +
     1785         integer( vH-15 ) + integer( vH-16 ) + integer( vH-17 ) + integer( vH-18 ) + integer( vH-19 ) +
     1786         integer( vH-20 ) + integer( vH-21 ) + integer( vH-22 ) + integer( vH-23 ) ) = 0
     1787   then do:
     1788       message "Вы не определили," skip
     1789               "какие интервалы времени" skip
     1790               "Вас интересуют."     view-as alert-box ERROR .
     1791       return no-apply.
     1792   end.
     1793   else do:
     1794     run waitfram-show in this-procedure ( "Подождите ..." ).
     1795     do ii = 1 to 24:
     1796       for-h-str = for-h-str + string(for-h[ii]) + chr(44).
     1797     end.
     1798     for-h-str = right-trim(for-h-str, chr(44)).
     1799     run rep/r-chkhr.p (
     1800                   input for-h-str
     1801                   ,input RS-option
     1802                   ,input T-dis-card
     1803                   ,input Rs-dis-card
     1804                   )  no-error .
     1805     if error-status:error then do:
     1806       run waitfram-hide in this-procedure .
     1807       message
     1808       vss-workfile vss-revision vss-description skip
     1809       error-status:get-message(1) skip
     1810       return-value
     1811       view-as alert-box error .
     1812       return.
     1813     end.
     1814     run waitfram-hide in this-procedure .
     1815   define variable p-XL-delim as character no-undo .
     1816   define variable type-par1 as character no-undo .
     1817   define variable tmp-var1  as character no-undo .
     1818   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1819   empty temp-table thbjattr_thbj-attr.
     1820   run adm/shattri.p (
     1821      input "get":U
     1822     ,input v-cntxt-obj-type
     1823     ,input v-cntxt-obj-code
     1824     ,input 'report-firm':U
     1825     ,input  ""
     1826     ,output v-value-character
     1827     ,output v-value-date
     1828     ,output v-value-decimal
     1829     ,output v-value-integer
     1830     ,output v-value-logical
     1831     ,output par-type
     1832     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1833     ) no-error .
     1834   for each thbjattr_thbj-attr :
     1835       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1836   end.
     1837   IF tmp-var1 = "" then p-XL-delim = ";".
     1838   else p-XL-delim = tmp-var1.
     1839   if can-find( first chk-h ) then do:
     1840     IF vXL THEN DO:
     1841       run rep/dxchk-h2.p ( input my-handle
     1842                     , input p-xl-delim
     1843                     , input X-date-start
     1844                     , input X-date-end
     1845                     , input str4
     1846                     , input rs-option
     1847                     , input (radio-label(string(Rs-Option), RS-Option:radio-buttons))
     1848                     , input integer( WH-Start )
     1849                     , input integer( WH-End )
     1850                     , input t-dis-card
     1851                     , input Rs-dis-card ) no-error .
     1852                         .
     1853     END.
     1854     ELSE DO:
     1855       run rep/d-chk-h2.p ( input my-handle
     1856                     , input X-date-start
     1857                     , input X-date-end
     1858                     , input str4
     1859                     , input rs-option
     1860                     , input (radio-label(string(Rs-Option), RS-Option:radio-buttons))
     1861                     , input integer( WH-Start )
     1862                     , input integer( WH-End )
     1863                     , input t-dis-card
     1864                     , input Rs-dis-card ) no-error .
     1865     if error-status:error then do:
     1866       run waitfram-hide in this-procedure .
     1867       message
     1868       vss-workfile vss-revision vss-description skip
     1869       error-status:get-message(1) skip
     1870       return-value
     1871       view-as alert-box error .
     1872       return.
     1873     end.
     1874   END.
     1875       if vxl then
     1876       run prn-lib-prn-file in this-procedure (
     1877                                             input parParentProc
     1878                                             ,input 3
     1879                                             ).
     1880       else
     1881       run prn-lib-prn-file in this-procedure (
     1882                                             input parParentProc
     1883                                             ,input 8
     1884                                             ).
     1885       FOR EACH chk-h :
     1886           delete chk-h .
     1887       END .
     1888       FOR EACH num-h :
     1889           delete num-h .
     1890       END .
     1891   end.
     1892   else
     1893   message "В указанный Вами период времени" skip
     1894           "на интересующих Вас объектах" skip
     1895           "не было НИКАКИХ продаж."
     1896           view-as alert-box INFORMATION .
     1897   end.
     1898   END PROCEDURE.
     1899   PROCEDURE My-var :
     1900   assign frame F-Main
     1901   Rs-Option
     1902   rs-dis-card t-dis-card
     1903   .
     1904   Assign
     1905    STR-obj-type = ''
     1906    STR-obj-code = ''
     1907    STR-obj-name = ''
     1908    STR-obj      = ''.
     1909   For each obj-list no-lock:
     1910    Assign
     1911    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1912    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1913    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1914    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1915   End.
     1916   ReportNAme = "Почасовая статистика розничных продаж по КОЛИЧЕСТВУ ПОКУПОК".
     1917   ReportHeader =  radio-label(string(Rs-Option), RS-Option:radio-buttons) +
     1918                               string(if vXl then ", Вывод в Excel" else "").
     1919   assign
     1920   use-column[2] = vH-0
     1921   use-column[3] = vH-1
     1922   use-column[4] = vh-2
     1923   use-column[5] = vh-3
     1924   use-column[6] = vh-4
     1925   use-column[7] = vH-5
     1926   use-column[8] = vH-6
     1927   use-column[9] = vh-7
     1928   use-column[10] = vh-8
     1929   use-column[11] = vh-9
     1930   use-column[12] = vH-10
     1931   use-column[13] = vH-11
     1932   use-column[14] = vh-12
     1933   use-column[15] = vh-13
     1934   use-column[16] = vh-14
     1935   use-column[17] = vH-15
     1936   use-column[18] = vH-16
     1937   use-column[19] = vh-17
     1938   use-column[20] = vh-18
     1939   use-column[21] = vh-19
     1940   use-column[22] = vH-20
     1941   use-column[23] = vH-21
     1942   use-column[24] = vh-22
     1943   use-column[25] = vh-23
     1944   .
     1945   END PROCEDURE.
     1946   PROCEDURE send-records :
     1947     DEFINE INPUT PARAMETER p-tbl-list AS CHARACTER NO-UNDO.
     1948     DEFINE OUTPUT PARAMETER p-rowid-list AS CHARACTER NO-UNDO.
     1949     DEFINE VARIABLE i            AS INTEGER   NO-UNDO.
     1950     DEFINE VARIABLE link-handle  AS CHARACTER NO-UNDO.
     1951     DEFINE VARIABLE rowid-string AS CHARACTER NO-UNDO.
     1952     DO i = 1 TO NUM-ENTRIES(p-tbl-list):
     1953         IF i > 1 THEN p-rowid-list = p-rowid-list + ",":U.
     1954         CASE ENTRY(i, p-tbl-list):
     1955       WHEN "temp-dis-card-type":U THEN p-rowid-list = p-rowid-list +
     1956           IF AVAILABLE temp-dis-card-type THEN STRING(ROWID(temp-dis-card-type))
     1957           ELSE "?":U.
     1958           OTHERWISE
     1959           DO:
     1960               RUN get-link-handle IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1961                   INPUT "RECORD-SOURCE":U, OUTPUT link-handle) NO-ERROR.
     1962               IF link-handle NE "":U THEN
     1963               DO:
     1964                   IF NUM-ENTRIES(link-handle) > 1 THEN
     1965                       MESSAGE "send-records in ":U THIS-PROCEDURE:FILE-NAME
     1966                               "encountered more than one RECORD-SOURCE.":U SKIP
     1967                               "The first will be used.":U
     1968                               VIEW-AS ALERT-BOX ERROR.
     1969                   RUN send-records IN WIDGET-HANDLE(ENTRY(1,link-handle))
     1970                       (INPUT ENTRY(i, p-tbl-list), OUTPUT rowid-string).
     1971                   p-rowid-list = p-rowid-list + rowid-string.
     1972               END.
     1973               ELSE
     1974               DO:
     1975                   MESSAGE "Requested table":U ENTRY(i, p-tbl-list)
     1976                           "does not match tables in send-records":U
     1977                           "in procedure":U THIS-PROCEDURE:FILE-NAME ".":U SKIP
     1978                           "Check that objects are linked properly and that":U
     1979                           "database qualification is consistent.":U
     1980                       VIEW-AS ALERT-BOX ERROR.
     1981                   RETURN ERROR.
     1982               END.
     1983           END.
     1984           END CASE.
     1985       END.
     1986   END PROCEDURE.
     1987   PROCEDURE state-changed :
     1988     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     1989     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1990     CASE p-state:
     1991       WHEN "link-changed" then do:
     1992           run ini-from-selobj(X-Selectobject).
     1993       end.
     1994     END CASE.
     1995     IF INDEX(p-state, "SELECTOBJECT=") > 0 then do:
     1996           RUn ini-from-selobj in h_s-hour.
     1997     end.
     1998   END PROCEDURE.
