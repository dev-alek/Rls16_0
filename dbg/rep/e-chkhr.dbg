      828   function diff-list returns character (
      829     input parfirst-list  as character,
      830     input parsecond-list as character,
      831     input pardelim       as character).
      832     if pardelim = ""
      833     or pardelim = ?
      834     then do:
      835       assign
      836         pardelim = ","
      837       .
      838     end.
      839     def var ind as integer no-undo .
      840     def var v-elem as character no-undo .
      841     def var v-result-list as character no-undo init "".
      842     def var v-num-parfirst-list as integer no-undo .
      843     assign
      844       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      845     .
      846     do ind = 1 to v-num-parfirst-list
      847     :
      848       assign
      849         v-elem = entry(ind, parfirst-list, pardelim)
      850       .
      851       if lookup(v-elem, parsecond-list, pardelim) = 0 then do:
      852         assign
      853           v-result-list = v-result-list
      854                         + (if v-result-list > "" then pardelim else "")
      855                         + v-elem
      856         .
      857       end.
      858     end.
      859     return v-result-list .
      860   end function.
      861   function add-list returns character (
      862    input parfirst-list  as character,
      863    input parsecond-list as character,
      864    input pardelim       as character).
      865     if pardelim = ""
      866     or pardelim = ?
      867     then do:
      868       assign
      869         pardelim = ","
      870       .
      871     end.
      872     def var ind as integer no-undo .
      873     def var v-elem as character no-undo .
      874     def var v-result-list as character no-undo init "".
      875     def var v-num-parfirst-list as integer no-undo .
      876     assign
      877       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      878     .
      879     do ind = 1 to v-num-parfirst-list
      880     :
      881       assign
      882         v-elem = entry(ind, parfirst-list, pardelim)
      883       .
      884       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      885         assign
      886           v-result-list = v-result-list
      887                         + (if v-result-list > "" then pardelim else "")
      888                         + v-elem
      889         .
      890       end.
      891     end.
      892     def var v-num-parsecond-list as integer no-undo .
      893     assign
      894       v-num-parsecond-list = num-entries(parsecond-list, pardelim)
      895     .
      896     do ind = 1 to v-num-parsecond-list
      897     :
      898       assign
      899         v-elem = entry(ind, parsecond-list, pardelim)
      900       .
      901       if lookup(v-elem, v-result-list, pardelim) = 0 then do:
      902         assign
      903           v-result-list = v-result-list
      904                         + (if v-result-list > "" then pardelim else "")
      905                         + v-elem
      906         .
      907       end.
      908     end.
      909     return v-result-list .
      910   end function.
      911   function cross-list returns character (
      912    input parfirst-list  as character,
      913    input parsecond-list as character,
      914    input pardelim       as character).
      915     if pardelim = ""
      916     or pardelim = ?
      917     then do:
      918       assign
      919         pardelim = ","
      920       .
      921     end.
      922     def var ind as integer no-undo .
      923     def var v-elem as character no-undo .
      924     def var v-result-list as character no-undo init "".
      925     def var v-num-parfirst-list as integer no-undo .
      926     assign
      927       v-num-parfirst-list = num-entries(parfirst-list, pardelim)
      928     .
      929     do ind = 1 to v-num-parfirst-list
      930     :
      931       assign
      932         v-elem = entry(ind, parfirst-list, pardelim)
      933       .
      934       if lookup(v-elem, v-result-list, pardelim) = 0
      935       and lookup(v-elem, parsecond-list, pardelim) > 0
      936       then do:
      937         assign
      938           v-result-list = v-result-list
      939                         + (if v-result-list > "" then pardelim else "")
      940                         + v-elem
      941         .
      942       end.
      943     end.
      944     return v-result-list .
      945   end function.
      946   function radio-label returns character (
      947    input par-rs-value  as character,
      948    input par-rs-radio-buttons as character)
      949    .
      950    DEFINE variable v-result-label as character no-undo.
      951    assign
      952    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons) MODULO 2 = 0)
      953                              then (LOOKUP(par-rs-value, par-rs-radio-buttons) - 1)
      954                              else LOOKUP(par-rs-value, par-rs-radio-buttons)
      955                             ), par-rs-radio-buttons
      956                           )
      957    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      958    .
      959   return v-result-label.
      960   end function.
      961   function m-radio-label returns character (
      962    input par-rs-value  as character,
      963    input par-rs-radio-buttons as character,
      964    input par-delim as character
      965    )
      966    .
      967    DEFINE variable v-result-label as character no-undo.
      968    assign
      969    v-result-label =  ENTRY( (IF (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) MODULO 2 = 0)
      970                              then (LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim) - 1)
      971                              else LOOKUP(par-rs-value, par-rs-radio-buttons, par-delim)
      972                             ), par-rs-radio-buttons, par-delim
      973                           )
      974    v-result-label = REPLACE(v-result-label, "&":U, "":U)
      975    .
      976   return v-result-label.
      977   end function.
      978   FUNCTION mixlist returns character
      979   (
      980    input parfirst-list  as character
      981    ,input parsecond-list as character
      982    ,input pardelim       as character
      983    ,input pardelim-result as character ) :
      984     if pardelim = ""
      985     or pardelim = ?
      986     then do:
      987       assign
      988         pardelim = ","
      989       .
      990     end.
      991     def var ind as integer no-undo .
      992     def var v-elem1 as character no-undo .
      993     def var v-elem2 as character no-undo .
      994     def var v-result-list as character no-undo init "".
      995     do ind = 1 to num-entries(parfirst-list, pardelim)
      996     :
      997       assign
      998         v-elem1 = entry(ind, parfirst-list, pardelim)
      999         v-elem2 = entry(ind, parsecond-list, pardelim)
     1000       .
     1001         assign
     1002           v-result-list = v-result-list
     1003                         + (if v-result-list > "" then pardelim-result else "")
     1004                         + v-elem1 + pardelim-result + v-elem2
     1005         .
     1006     end.
     1007     return v-result-list .
     1008   END FUNCTION.
