      185     index ie2 obj-name
      186   .
      187   procedure create_obj-list :
      188      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      189      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      190      do
      191      on error undo, return error return-value
      192      :
      193         define buffer cli-obj for ub.clients .
      194         define variable p-var as integer no-undo .
      195         define buffer buf_obj-list for obj-list .
      196         find last buf_obj-list  use-index pi no-error .
      197         if available buf_obj-list
      198         then
      199            p-var = buf_obj-list.obj-id + 1.
      200         else
      201            p-var = 1.
      202         find first cli-obj where
      203                   cli-obj.obj-type = p-obj-type
      204               and cli-obj.obj-code = p-obj-code
      205         no-lock no-error.
      206         if available cli-obj
      207         then do:
      208            create buf_obj-list.
      209            assign
      210               buf_obj-list.obj-id   = p-var
      211               buf_obj-list.obj-code = cli-obj.obj-code
      212               buf_obj-list.obj-type = cli-obj.obj-type
      213               buf_obj-list.obj-name = cli-obj.obj-name
      214               buf_obj-list.db-num   = cli-obj.db-num
      215            .
      216         end.
      217      end.
      218   end.
