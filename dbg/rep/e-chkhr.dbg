      616   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   define  stream PrnLibStream.
      618   procedure prn-lib-prn-file :
      619     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      620     define input parameter p-DIsabledoptions as integer no-undo .
      621     define variable v-report-name as character no-undo .
      622     define variable v-user-action as character no-undo .
      623     define variable v-printed     as logical   no-undo .
      624     define variable v-exist       as logical   no-undo .
      625     do
      626       on error undo, return error
      627       :
      628       run prn-lib-get-report-name  in this-procedure (
      629         input parParentProc
      630         ,output v-report-name
      631         ).
      632   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      634     (input  v-report-name
      635     ,input  2
      636     ,output v-exist
      637     )  .
      638       if NOT v-exist then
      639       DO:
      640         Message
      641           "Нет заданий на печать ! "
      642           view-as alert-box .
      643         Return  .
      644       End.
      645       run gbl/prnfilen.w
      646         (input  ""
      647         ,input  p-DisabledOptions
      648         ,input  string(v-report-name )
      649         ,input  7
      650         ,output v-user-action
      651         ,output v-printed
      652         ) .
      653       if v-printed then
      654       do:
      655         return "YES" .
      656       end.
      657       else
      658       do:
      659         return "NO" .
      660       end.
      661     end.
      662   end procedure.
      663   procedure prn-lib-open-stream :
      664     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      665     define input parameter p-page-size    as integer no-undo .
      666     define input parameter p-is-stream    as logical no-undo .
      667     define input parameter p-append       as logical no-undo .
      668     define variable v-report-name as character no-undo .
      669     do
      670       on error undo, return error
      671       :
      672       run prn-lib-get-report-name  in this-procedure (
      673         input parParentProc
      674         ,output v-report-name
      675         ).
      676       if p-is-stream then
      677       do:
      678         if p-append then
      679         do:
      680           output stream PrnLibStream to value( v-report-name )
      681             page-size value(p-page-size) append .
      682         end.
      683         if not p-append then
      684         do:
      685           output stream PrnLibStream to value( v-report-name )
      686             page-size value(p-page-size) .
      687         end.
      688       end.
      689       if not p-is-stream then
      690       do:
      691         if p-append then
      692         do:
      693           output to value( v-report-name )
      694             page-size value(p-page-size) append .
      695         end.
      696         if not p-append then
      697         do:
      698           output to value( v-report-name )
      699             page-size value(p-page-size) .
      700         end.
      701       end.
      702     end.
      703   end procedure.
      704   procedure prn-lib-open-exp :
      705     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      706     define input parameter p-is-stream    as logical no-undo .
      707     define input parameter p-is-append    as logical no-undo .
      708     define output parameter p-ReportFileName as char init "report" no-undo.
      709     define output parameter p-process as logical no-undo .
      710     define variable glog as logical no-undo .
      711     do
      712       on error undo, return error
      713       :
      714       SYSTEM-DIALOG GET-FILE p-ReportFileName
      715         TITLE      "Укажите путь"
      716         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      717         ASK-OVERWRITE
      718         CREATE-TEST-FILE
      719         SAVE-AS
      720         USE-FILENAME
      721         DEFAULT-EXTENSION "txt"
      722         UPDATE glog
      723         .
      724       if not glog then  return.
      725       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      726       if p-is-stream then
      727       do:
      728         if p-is-append then
      729         do:
      730           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      731         end.
      732         else
      733         do:
      734           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      735         end.
      736       end.
      737       else
      738       do:
      739         if p-is-append then
      740         do:
      741           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      742         end.
      743         else
      744         do:
      745           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      746         end.
      747       end.
      748       p-process = yes.
      749     end.
      750   end procedure.
      751   procedure prn-lib-get-report-name :
      752     define input parameter parParentProc  as widget-handle no-undo.
      753     define output parameter p-report-name as character no-undo .
      754     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      755   end procedure.
      756   procedure prn-lib-reportviewer-report-name :
      757     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      758     define input parameter p-report-name-html as character no-undo .
      759     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      760   end procedure.
      761   procedure prn-lib-reportviewer :
      762     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      763     define input parameter p-report-name-html as character no-undo .
      764     define input parameter p-param        as character no-undo .
      765     define variable v-excel           as character no-undo init 'TRUE' .
      766     define variable v-value-character as character no-undo .
      767     define variable v-value-integer   as character no-undo .
      768     define variable v-value-date      as date      no-undo .
      769     define variable v-value-decimal   as decimal   no-undo .
      770     define variable rep-excel         as logical   no-undo .
      771     define variable excel-string      as character no-undo .
      772     define variable v-param-type      as character no-undo .
      773     define variable v-tth             as handle    no-undo .
      774     run adm/shattri.p (
      775       input "get":U
      776       ,input  ""
      777       ,input  0
      778       ,input  'report-glob':U
      779       ,input  'rep-excel':U
      780       ,output v-value-character
      781       ,output v-value-date
      782       ,output v-value-decimal
      783       ,output v-value-integer
      784       ,output rep-excel
      785       ,output v-param-type
      786       ,INPUT-OUTPUT table-handle v-tth
      787       )  .
      788     if rep-excel then v-excel = "TRUE" .
      789     else v-excel = "FALSE" .
      790     if p-param eq ""
      791     then
      792        p-param = "EXCEL:" + v-excel.
      793     else
      794        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      795     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      796   end procedure.
