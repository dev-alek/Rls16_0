     1207           vss-include-info14 skip
     1208           "Ошибка задания входных параметров" skip
     1209           "Не найдена строка документа" skip
     1210           "Документ" p-doc-code skip
     1211           "Артикул" p-artic p-prod-type p-prod-code skip
     1212           view-as alert-box error .
     1213         undo, return error .
     1214       end.
     1215       find first buf_trn-doc no-lock
     1216         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1217         no-error .
     1218       if not available buf_trn-doc then do:
     1219         message
     1220           vss-workfile vss-revision vss-description skip
     1221           vss-include-info14 skip
     1222           "Не найден документ" skip
     1223           "Документ" p-doc-code skip
     1224           "Артикул" p-artic p-prod-type p-prod-code skip
     1225           view-as alert-box error .
     1226         undo, return error .
     1227       end.
     1228       for each buf_gds-dtl no-lock
