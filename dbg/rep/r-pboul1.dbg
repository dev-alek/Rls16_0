     1455   end.
     1456   if varis-cons-parts-have = no then do:
     1457     assign
     1458           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1459           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1460   end.
     1461   else do:
     1462     if buf_trn-doc.doc-type = 'инв':U then do:
     1463       assign
     1464               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1465               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1466        .
     1467     end.
     1468     else do:
     1469       assign
     1470               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1471               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1472        .
     1473     end.
     1474   end.
     1475   assign
     1476   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1477   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1478               ASSIGN
     1479                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1480                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1481                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1482                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1483                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1484                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1485                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1486                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1487                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1488                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1489                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1490                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1491                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1492               .
     1493           end.
     1494       end.
     1495       assign
     1496           p-transport-base      = 0
     1497           p-transport-rubl      = 0
     1498           p-vat-pc              = buf_doc-line.vat-pc
     1499           p-slt-pc              = buf_doc-line.slt-pc
     1500       .
     1501     end.
     1502     if p-fact-qnty      = ?
     1503     or p-vat-pc         = ?
     1504     or p-slt-pc         = ?
     1505     or p-sum-base       = ?
     1506     or p-sum-rubl       = ?
     1507     or p-vat-base       = ?
     1508     or p-vat-rubl       = ?
     1509     or p-slt-base       = ?
     1510     or p-slt-rubl       = ?
     1511     or p-road-tax-base  = ?
     1512     or p-road-tax-rubl  = ?
     1513     or p-transport-base = ?
     1514     or p-transport-rubl = ?
     1515     or p-other-base     = ?
     1516     or p-other-rubl     = ?
     1517     or p-excise-base    = ?
     1518     or p-excise-rubl    = ?
     1519     then do:
     1520       message
     1521         vss-workfile vss-revision vss-description skip
     1522         vss-include-info14 skip
     1523         "Получены неопределенные значения" skip
     1524         "Документ" p-doc-code skip
     1525         "Артикул" p-artic p-prod-type p-prod-code skip
     1526         "fact-qnty     " p-fact-qnty      skip
     1527         "vat-pc        " p-vat-pc         skip
     1528         "slt-pc        " p-slt-pc         skip
     1529         "sum-base      " p-sum-base       skip
     1530         "sum-rubl      " p-sum-rubl       skip
     1531         "vat-base      " p-vat-base       skip
     1532         "vat-rubl      " p-vat-rubl       skip
     1533         "slt-base      " p-slt-base       skip
     1534         "slt-rubl      " p-slt-rubl       skip
     1535         "road-tax-base " p-road-tax-base  skip
     1536         "road-tax-rubl " p-road-tax-rubl  skip
     1537         "transport-base" p-transport-base skip
     1538         "transport-rubl" p-transport-rubl skip
     1539         "other-base    " p-other-base     skip
     1540         "other-rubl    " p-other-rubl     skip
     1541         "excise-base   " p-excise-base    skip
     1542         "excise-rubl   " p-excise-rubl    skip
     1543         view-as alert-box error .
     1544       undo, return error .
     1545     end.
     1546   end procedure.
     1547   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1548     if num-entries(string(p-dec), '.') = 2
     1549       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1550       else return( string(p-dec)) .
     1551   end function.
     1552   function format-point-to-comma returns char (input orig as char ) .
     1553   define variable rtext as character no-undo .
     1554   define variable strt as integer no-undo .
     1555   define variable leng as integer no-undo .
     1556   assign rtext = orig .
     1557   repeat:
     1558     strt =  index(rtext,'.').
     1559     if strt = 0 then leave.
     1560     leng = 1.
     1561     substring(rtext,strt,leng,"character") = v-delim .
     1562   end.
     1563   return rtext.
     1564   end function.
     1565   function format-excel-text returns char ( input start-text as char ) :
     1566   def var  i    as int no-undo.
     1567   def var  ch   as char no-undo.
     1568   def var  n    as int no-undo.
     1569   def var  ipos as int no-undo.
     1570     n = num-entries(trim(start-text), chr(10)) - 1 .
     1571     do i = 1 to n :
     1572       ipos = index( start-text, chr(10)).
     1573       if ipos > 0 then
     1574         substr( start-text, ipos, 1 ) = ' '.
     1575     end.
     1576     n = num-entries(trim(start-text), chr(13)) - 1 .
     1577     do i = 1 to n :
     1578       ipos = index( start-text, chr(13)).
     1579       if ipos > 0 then
     1580         substr( start-text, ipos, 1 ) = ' '.
     1581     end.
     1582     if index( start-text, '"' ) = 0 then
     1583       start-text =  '="'   + trim( start-text) + '"'   .
     1584       else do:
     1585         n = num-entries(trim(start-text), '"') - 1.
     1586         do i = 1 to n :
     1587           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1588         end.
     1589         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1590         start-text = '="'  + ch  + '"' .
     1591       end.
     1592     return start-text.
     1593   end.
     1594   function excel-sum returns char (input p-dec as decimal ).
     1595     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1596   end function.
     1597   function excel-qnty returns char (input p-dec as decimal ).
     1598     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1599   end function.
     1600   function format-excel-text-macr returns char ( input start-text as char ) :
     1601   def var  i    as int no-undo.
     1602   def var  ch   as char no-undo.
     1603   def var  n    as int no-undo.
     1604   def var  ipos as int no-undo.
     1605     n = num-entries(trim(start-text), chr(10)) - 1 .
     1606     do i = 1 to n :
     1607       ipos = index( start-text, chr(10)).
     1608       if ipos > 0 then
     1609         substring( start-text, ipos , 1 ) = ' '.
     1610     end.
     1611     n = num-entries(trim(start-text), chr(13)) - 1 .
     1612     do i = 1 to n :
     1613       ipos = index( start-text, chr(13)).
     1614       if ipos > 0 then
     1615         substring( start-text, ipos, 1 ) = ' '.
     1616     end.
     1617     if index( start-text, '"' ) = 0 then
     1618       start-text =  '"'   + trim( start-text) + '"'   .
     1619       else do:
     1620         n = num-entries(trim(start-text), '"') - 1.
     1621         do i = 1 to n :
     1622           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1623         end.
     1624         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1625         start-text = '"'  + ch  + '"' .
     1626       end.
     1627     n = num-entries(trim(start-text), chr(10)) - 1 .
     1628     do i = 1 to n :
     1629       ipos = index( start-text, chr(10)).
     1630       if ipos > 0 then
     1631         substring( start-text, ipos , 1 ) = ' '.
     1632     end.
     1633       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1634     return start-text.
     1635   end.
     1636   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1637   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1638   procedure paramls-clear :
     1639     define buffer buf_temp-param for temp-param .
     1640     do
     1641     on error undo, return error return-value
     1642     :
     1643       for each buf_temp-param
     1644       on error undo, return error
     1645       :
     1646         delete buf_temp-param .
     1647       end.
     1648     end.
     1649   end procedure.
     1650   procedure paramls-write :
     1651     define input  parameter p-code     as character no-undo .
     1652     define input  parameter p-sub-code as character no-undo .
     1653     define input  parameter p-value    as character no-undo .
     1654     define buffer buf_temp-param for temp-param .
     1655     do
     1656     on error undo, return error return-value
     1657     :
     1658       find first buf_temp-param
     1659         where buf_temp-param.param-code     = p-code
     1660           and buf_temp-param.param-sub-code = p-sub-code
     1661         no-error .
     1662       if not available buf_temp-param then do:
     1663         create buf_temp-param .
     1664         assign
     1665           buf_temp-param.param-code     = p-code
     1666           buf_temp-param.param-sub-code = p-sub-code
     1667         .
     1668       end.
     1669       assign
     1670         buf_temp-param.param-value = p-value
     1671       .
     1672     end.
     1673   end procedure.
     1674   procedure paramls-read :
     1675     define input  parameter p-code          as character no-undo .
     1676     define input  parameter p-sub-code      as character no-undo .
     1677     define input  parameter p-default-value as character no-undo .
     1678     define output parameter p-value         as character no-undo .
     1679     define buffer buf_temp-param for temp-param .
     1680     do
     1681     on error undo, return error return-value
     1682     :
     1683       find first buf_temp-param
     1684         where buf_temp-param.param-code     = p-code
     1685           and buf_temp-param.param-sub-code = p-sub-code
     1686         no-error .
     1687       if available buf_temp-param then do:
     1688         assign
     1689           p-value = buf_temp-param.param-value
     1690         .
     1691       end.
     1692       else do:
     1693         assign
     1694           p-value = p-default-value
     1695         .
     1696       end.
     1697     end.
     1698   end procedure.
     1699   procedure paramls-append :
     1700     define input  parameter p-code     as character no-undo .
     1701     define input  parameter p-sub-code as character no-undo .
     1702     define input  parameter p-value    as character no-undo .
     1703     define buffer buf_temp-param for temp-param .
     1704     do
     1705     on error undo, return error return-value
     1706     :
     1707       find first buf_temp-param
     1708            where buf_temp-param.param-code     = p-code
     1709              and buf_temp-param.param-sub-code = p-sub-code
     1710         no-error .
     1711       if not available buf_temp-param then do:
     1712         create buf_temp-param .
     1713         assign
     1714           buf_temp-param.param-code     = p-code
     1715           buf_temp-param.param-sub-code = p-sub-code
     1716           buf_temp-param.param-value    = p-value
     1717         .
     1718       end.
     1719       else do:
     1720           assign
     1721               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1722           .
     1723       end.
     1724     end.
     1725   end procedure.
     1726   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1727   procedure factord :
     1728     define input  parameter p-fact-date            as date    no-undo .
     1729     define input  parameter p-fact-time            as integer no-undo .
     1730     define input  parameter p-fact-num             as integer no-undo .
     1731     define input  parameter p-shift-date           as date    no-undo .
     1732     define input  parameter p-shift-num            as integer no-undo .
     1733     define input  parameter p-shift-on             as logical no-undo .
     1734     define output parameter p-fact-order           as decimal no-undo .
     1735     define output parameter p-shift-end-fact-order as decimal no-undo .
     1736     define output parameter p-day-end-fact-order   as decimal no-undo .
     1737     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1738     if p-fact-date = ?
     1739     then do:
     1740       return error "Не указана фактическая дата" .
     1741     end.
     1742     define variable v-fact-date-num as integer no-undo .
     1743     assign
     1744       v-fact-date-num = integer(p-fact-date)
     1745     .
     1746     if p-fact-num = ?
     1747     or p-fact-num = 0
     1748     then do:
     1749       return error "Не задан p-fact-num " + string(p-fact-num) .
     1750     end.
     1751     if p-fact-num < 0
     1752     then do:
     1753       return error "Отрицательный fact-num " + string(p-fact-num) .
     1754     end.
     1755     if p-fact-num >= 100000000
     1756     then do:
     1757       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1758     end.
     1759     if p-shift-on = true
     1760     then do:
     1761       if p-shift-date = ?
     1762       then do:
     1763         return error "Не задана дата смены" .
     1764       end.
     1765       if p-shift-num = ?
     1766       or p-shift-num = 0
     1767       then do:
     1768         return error "Не задан номер смены" .
     1769       end.
     1770     end.
     1771     else do:
     1772       assign
     1773         p-shift-date = p-fact-date
     1774         p-shift-num  = 24
     1775       .
     1776     end.
     1777     define variable v-shift-offset as integer no-undo .
     1778     if p-shift-date = p-fact-date
     1779     then do:
     1780       assign
     1781         v-shift-offset = 1
     1782       .
     1783     end.
     1784     if p-shift-date < p-fact-date
     1785     then do:
     1786       assign
     1787         v-shift-offset = 0
     1788       .
     1789     end.
     1790     if p-shift-date > p-fact-date
     1791     then do:
     1792       message
     1793         vss-workfile vss-revision vss-description skip
     1794         "Неправильная дата закрытия смены" skip
     1795         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1796         view-as alert-box error .
     1797       undo, return error
     1798         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1799           ,string(p-fact-date, '99/99/9999':U)
     1800           ,string(p-shift-date, '99/99/9999':U)
     1801           )
     1802       .
     1803     end.
     1804     if p-shift-num < 1
     1805     or p-shift-num > 24
     1806     then do:
     1807       message
     1808         vss-workfile vss-revision vss-description skip
     1809         "Неправильный номер смены" skip
     1810         "p-shift-num" p-shift-num skip
     1811         view-as alert-box error .
     1812       undo, return error return-value .
     1813     end.
     1814     assign
     1815       p-fact-order           = v-fact-date-num
     1816                              + v-shift-offset * 0.5
     1817                              + p-shift-num    * 0.02 - 0.01
     1818                              + p-fact-num     * 0.0000000001
     1819       p-shift-end-fact-order = v-fact-date-num
     1820                              + v-shift-offset * 0.5
     1821                              + p-shift-num    * 0.02
     1822       p-day-end-fact-order   = v-fact-date-num
     1823                              + 0.99
     1824     .
     1825     if p-fact-order           <= v-fact-date-num
     1826     or p-shift-end-fact-order <= v-fact-date-num
     1827     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1828     or p-shift-end-fact-order >= p-day-end-fact-order
     1829     then do:
     1830       message
     1831         vss-workfile vss-revision vss-description skip
     1832         "Внутренняя ошибка при генерации фактического номера" skip
     1833         "p-fact-date"            p-fact-date            skip
     1834         "p-fact-time"            p-fact-time            skip
     1835         "p-fact-num"             p-fact-num             skip
     1836         "p-shift-date"           p-shift-date           skip
     1837         "p-shift-num"            p-shift-num            skip
     1838         "p-shift-on"             p-shift-on             skip
     1839         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1840         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1841         "v-fact-date-num"        v-fact-date-num        skip
     1842         view-as alert-box error .
     1843       undo, return error return-value .
     1844     end.
     1845   end procedure.
     1846   procedure day-begin-fact-order :
     1847     define input  parameter p-fact-date            as date    no-undo .
     1848     define output parameter p-day-begin-fact-order as decimal no-undo .
     1849     do
     1850     on error undo, return error return-value
     1851     :
     1852       if p-fact-date = ?
     1853       then do:
     1854         assign
     1855           p-day-begin-fact-order = 0
     1856         .
     1857       end.
     1858       else do:
     1859         assign
     1860           p-day-begin-fact-order = integer(p-fact-date)
     1861         .
     1862       end.
     1863     end.
     1864   end procedure.
     1865   procedure factord-max-fact-order :
     1866     define output parameter p-max-fact-order as decimal   no-undo .
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       run day-begin-fact-order in this-procedure
     1871         (input  date(1, 1, 5000)
     1872         ,output p-max-fact-order
     1873         ) .
     1874     end.
     1875   end procedure.
     1876   procedure factord-cut-archive :
     1877     define input  parameter p-obj-type             as character no-undo .
     1878     define input  parameter p-obj-code             as integer   no-undo .
     1879     define input  parameter p-fact-date            as date      no-undo .
     1880     define output parameter p-shift-on             as logical   no-undo .
     1881     define output parameter p-shift-date           as date      no-undo .
     1882     define output parameter p-shift-num            as integer   no-undo .
     1883     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1884     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1885     define variable v-fact-order as decimal   no-undo .
     1886     define buffer buf_shift-obj for ub.shift-obj .
     1887     do
     1888     on error undo, return error return-value
     1889     :
     1890   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1891   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1892     (input  p-obj-type
     1893     ,input  p-obj-code
     1894     ,input  'shift-on=request'
     1895     ,output p-shift-on
     1896     ) no-error .
     1897       if error-status :error
     1898       then do:
     1899         message
     1900           vss-workfile vss-revision vss-description skip
     1901           "Ошибка при определении атрибута объекта" skip
     1902           "Объект" p-obj-type p-obj-code skip
     1903           error-status :get-message(1) skip
     1904           return-value skip
     1905           view-as alert-box error .
     1906         undo, return error return-value .
     1907       end.
     1908       if p-shift-on = false
     1909       then do:
     1910         assign
     1911           p-shift-date               = ?
     1912           p-shift-num                = 0
     1913         .
     1914       end.
     1915       else do:
     1916         find first buf_shift-obj share-lock
     1917           where buf_shift-obj.obj-type   = p-obj-type
     1918             and buf_shift-obj.obj-code   = p-obj-code
     1919             and buf_shift-obj.shift-date > p-fact-date
     1920           use-index pi
     1921           no-error .
     1922         if not available buf_shift-obj
     1923         or buf_shift-obj.status_ <> 'зкр':U
     1924         then do:
     1925           message
     1926             vss-workfile vss-revision vss-description skip
     1927             "Невозможно вычислить последнюю смену" skip
     1928             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1929             "Объект" p-obj-type p-obj-code skip
     1930             "Дата" p-fact-date skip
     1931             view-as alert-box error .
     1932           undo, return error return-value .
     1933         end.
     1934         find last buf_shift-obj share-lock
     1935           where buf_shift-obj.obj-type = p-obj-type
     1936             and buf_shift-obj.obj-code = p-obj-code
     1937             and buf_shift-obj.shift-date <= p-fact-date
     1938           use-index pi
     1939           no-error .
     1940         if available buf_shift-obj
     1941         then do:
     1942           if  buf_shift-obj.status_ = 'зкр':U
     1943           then do:
     1944             assign
     1945               p-shift-date = buf_shift-obj.shift-date
     1946               p-shift-num  = buf_shift-obj.shift-num
     1947             .
     1948           end.
     1949           else do:
     1950             message
     1951               vss-workfile vss-revision vss-description skip
     1952               "Невозможно вычислить последнюю смену" skip
     1953               "Статус смены отличен от статуса" 'зкр':U skip
     1954               "Объект" p-obj-type p-obj-code skip
     1955               "Дата" p-fact-date skip
     1956               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1957               view-as alert-box error .
     1958             undo, return error return-value .
     1959           end.
     1960         end.
     1961         else do:
     1962           assign
     1963             p-shift-date = p-fact-date - 1
     1964             p-shift-num  = 1
     1965           .
     1966         end.
     1967       end.
     1968       run factord in this-procedure
     1969         (input  p-fact-date
     1970         ,input  1
     1971         ,input  1
     1972         ,input  p-shift-date
     1973         ,input  p-shift-num
     1974         ,input  p-shift-on
     1975         ,output v-fact-order
     1976         ,output p-shift-end-fact-order
     1977         ,output p-day-end-fact-order
     1978         ) no-error .
     1979       if error-status :error
     1980       then do:
     1981         message
     1982           vss-workfile vss-revision vss-description skip
     1983           "Ошибка при вызове процедуры factord"
     1984           error-status :get-message(1) skip
     1985           return-value skip
     1986           view-as alert-box error .
     1987         undo, return error return-value .
     1988       end.
     1989     end.
     1990   end procedure.
     1991   procedure factord-lock-shift :
     1992     define input  parameter p-obj-type  as character no-undo .
     1993     define input  parameter p-obj-code  as integer   no-undo .
     1994     define input  parameter p-fact-date as date      no-undo .
     1995     define parameter buffer buf_shift-obj for ub.shift-obj .
     1996     define variable v-shift-on      as logical   no-undo .
     1997     define variable v-extra-message as character no-undo .
     1998     define variable v-error as character no-undo .
     1999     do
     2000     on error undo, return error return-value
     2001     :
     2002   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2003   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2004     (input  p-obj-type
     2005     ,input  p-obj-code
     2006     ,input  'shift-on=request'
     2007     ,output v-shift-on
     2008     ) no-error .
     2009       if error-status :error
     2010       then do:
     2011         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     2012         undo, return error v-error .
     2013       end.
     2014       if v-shift-on = true
     2015       then do:
     2016         find first buf_shift-obj share-lock
     2017           where buf_shift-obj.obj-type   = p-obj-type
     2018             and buf_shift-obj.obj-code   = p-obj-code
     2019             and buf_shift-obj.shift-date > p-fact-date
     2020           use-index pi
     2021           no-error .
     2022         if not available buf_shift-obj
     2023         or buf_shift-obj.status_ <> 'зкр':U
     2024         then do:
     2025           find last buf_shift-obj
     2026             where buf_shift-obj.obj-type = p-obj-type
     2027               and buf_shift-obj.obj-code = p-obj-code
     2028               and buf_shift-obj.status_  = 'зкр':U
     2029             use-index stts
     2030             no-error .
     2031           if available buf_shift-obj
     2032           then do:
     2033             assign
     2034               v-extra-message =
     2035                     substitute("Дата начала последеней закрытой смены на объекте &1"
     2036                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     2037                               )
     2038             .
     2039           end.
     2040           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     2041           undo, return error v-error .
     2042         end.
     2043       end.
     2044     end.
     2045   end procedure.
     2046   procedure factord-end-day :
     2047     define input  parameter p-fact-date            as date    no-undo .
     2048     define output parameter p-day-end-fact-order   as decimal no-undo .
     2049     do
     2050     on error undo, return error return-value
     2051     :
     2052       if p-fact-date = ?
     2053       then do:
     2054         return error "Не указана фактическая дата" .
     2055       end.
     2056       assign
     2057         p-day-end-fact-order = integer(p-fact-date) + 0.99
     2058       .
     2059     end.
     2060   end procedure.
     2061   procedure factord-to-date :
     2062     define input  parameter p-fact-order as decimal no-undo .
     2063     define output parameter p-fact-date  as date    no-undo .
     2064     define variable v-ref-date  as date      no-undo .
     2065     define variable v-ref-delta as integer   no-undo .
     2066     do
     2067     on error undo, return error return-value
     2068     :
     2069       if p-fact-order = ?
     2070       or p-fact-order = 0
     2071       then do:
     2072         return error "Не указан fact-order" .
     2073       end.
     2074       assign
     2075         v-ref-date  = date(1, 1, 2000)
     2076       .
     2077       assign
     2078         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     2079       .
     2080       assign
     2081         p-fact-date = v-ref-date + v-ref-delta
     2082       .
     2083     end.
     2084   end procedure.
     2085   procedure factord-to-fact-num :
     2086     define input  parameter p-fact-order as decimal no-undo .
     2087     define output parameter p-fact-num   as integer no-undo .
     2088     define variable v-fact-order-trunc as decimal no-undo .
     2089     do
     2090     on error undo, return error return-value
     2091     :
     2092       if p-fact-order = ?
     2093       or p-fact-order = 0
     2094       then do:
     2095         return error "Не указан fact-order" .
     2096       end.
     2097       assign
     2098        v-fact-order-trunc = truncate(p-fact-order, 2)
     2099       .
     2100       assign
     2101         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     2102       .
     2103     end.
     2104   end procedure.
     2105   procedure factord-to-shift-num :
     2106     define input  parameter p-fact-order as decimal no-undo .
     2107     define output parameter p-shift-num   as integer no-undo .
     2108     define variable  p-shift-numd  as decimal   no-undo .
     2109     define variable v-fact-order-trunc as decimal no-undo .
     2110     do
     2111     on error undo, return error return-value
     2112     :
     2113       if p-fact-order = ?
     2114       or p-fact-order = 0
     2115       then do:
     2116         return error "Не указан fact-order" .
     2117       end.
     2118       assign
     2119        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     2120       .
     2121       if v-fact-order-trunc < 0.5 then do:
     2122         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     2123       end.
     2124       assign
     2125         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     2126         .
     2127        assign
     2128         p-shift-num = truncate (p-shift-numd , 0)
     2129       .
     2130     end.
     2131   end procedure.
     2132   define new global shared variable g#lib-trn  as handle no-undo .
     2133   define new global shared variable g#lib-trn2 as handle no-undo .
     2134   define new global shared variable g#lib-trn3 as handle no-undo .
     2135   define new global shared variable g#lib-trn4 as handle no-undo .
     2136     DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
     2137     ASSIGN parParentProc =  my-handle .
     2138     define variable g#report-num as integer   no-undo .
     2139     run get-report-num  in parParentProc ( output g#report-num ).
     2140   define variable vss-include-info22 as character format "X(65)" no-undo
     2141   initial "@(#)$Workfile$ $Revision$".
     2142    define stream macr_excel .
     2143    define variable v-file-name as character no-undo .
     2144   procedure macr_excel_char :
