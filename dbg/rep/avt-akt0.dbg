      463           gds-dtl.fact-qnty column-label "Количество  ! " format "->>>>>>9.<<<"
      464           price-doc column-label "Цена по!докум.(Вал)" format ">>>>>>9.99"
      465           doc-sum column-label "Сумма по!докум.(Вал)" format "->>>>>>>>9.99"
      466           gds-dtl.cur-base column-label "Цена по!объекту(Вал)" format ">>>>>>9.99"
      467           obj-sum column-label "Сумма цен по!объекту(Вал)" format "->>>>>>>>9.99"
      468           Delt column-label "Процент!разницы" format "X(8)"
      469           sym2 column-label ":!:" format "X(1)" space(0)
      470       header
      471               cur-time-print() at 5 format "X(35)"
      472               string( "Акт автоматической переоценки по документу N " + tdoc-code + " от " + string( tdoc-date,"99/99/9999" ) ) at 40 format "X(80)"
      473               string( "Страница " + string(PAGE-NUMBER) ) at 120 format "X(15)" skip
      474           v-single-line format "X(136)" at 1
      475   with width 235 down stream-io .
      476   define frame Akt-rubl
      477           sym1 column-label ":!:" format "X(1)" space(0)
      478           tb-code column-label "Код! " format "x(10)"
      479           gds-dtl.artic column-label "Артикул! " format "X(16)"
      480           goods.gds-name column-label "Название товара! " format "X(30)"
      481           gds-dtl.fact-qnty column-label "Количество  ! " format "->>>>>>9.<<<"
      482           price-doc column-label "Цена по!докум.(Руб)" format ">>>>>>9.99"
      483           doc-sum column-label "Сумма по!докум.(Руб)" format "->>>>>>>>9.99"
      484           gds-dtl.cur-base column-label "Цена по!объекту(Руб)" format ">>>>>>9.99"
      485           obj-sum column-label "Сумма цен по!объекту(Руб)" format "->>>>>>>>9.99"
      486           Delt column-label "Процент!разницы" format "X(8)"
      487           sym2 column-label ":!:" format "X(1)" space(0)
      488       header
      489               cur-time-print() at 5 format "X(35)"
      490               string( "Акт автоматической переоценки по документу N " + tdoc-code + " от " + string( tdoc-date,"99/99/9999" ) ) at 40 format "X(80)"
      491               string( "Страница " + string(PAGE-NUMBER) ) at 120 format "X(15)" skip
      492           v-single-line format "X(136)" at 1
      493   with width 235 down stream-io .
      494   output     to value( string( session:temp-directory +
      495                                        "rpt" + string( g#report-num ) ) )
      496                                        page-size  value(43) .
      497   v-single-line = fill("-", 200).
      498   find first t-doc no-lock
      499        where recid(t-doc) = rec_id
      500   .
      501   define variable FullGdsName as logical   no-undo .
      502   define variable tmp-var  as character no-undo .
      503   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      504   empty temp-table thbjattr_thbj-attr.
      505   run adm/shattri.p (
      506      input "get":U
      507     ,input t-doc.obj-type
      508     ,input t-doc.obj-code
      509     ,input 'prt-obj':U
      510     ,input  ""
      511     ,output v-value-character
      512     ,output v-value-date
      513     ,output v-value-decimal
      514     ,output v-value-integer
      515     ,output v-value-logical
      516     ,output par-type
      517     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
      518     ) no-error .
      519   for each thbjattr_thbj-attr :
      520       if thbjattr_thbj-attr.prop-code = 'FGdsNinD' then tmp-var =  string(thbjattr_thbj-attr.property-value-logical) .
      521   end.
      522   FullGdsName = (tmp-var = "yes") .
      523   assign
      524       tdoc-date   = t-doc.doc-date
      525       tdoc-code   = t-doc.doc-code
      526   .
      527   find first Our_Host no-lock
      528        where Our_Host.obj-type = 'орг':U
      529          and Our_Host.obj-code = t-doc.host-code
      530   .
      531   put
      532       space(90) Our_Host.obj-name format "x(40)"
      533       skip(2) space(20) "А К Т   П Е Р Е О Ц Е Н К И   ( автоматической ) по документу  N " format "x(80)"
      534           t-doc.doc-code format "X(10)"
      535           "  от  " t-doc.doc-date format "99.99.9999" skip(1)
      536   .
      537   if lookup( "ParCom":U, p-mode ) <> 0
      538   then do:
      539       if t-doc.doc-type = 'при':U
      540       and not t-doc.internal
      541       then do:
      542           put
      543               substitute( "Основание: накладная поставщика N &1 от &2"
      544                           , t-doc.ord-num
      545                           , string( t-doc.ship-date, "99.99.9999" )
      546               )   format "x(110)"
      547               skip(1)
      548           .
      549       end.
      550   end.
      551   else do:
      552       if t-doc.doc-type = 'при':U
      553       and not t-doc.internal
      554       then do:
      555   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
      556                           input 'nids':U ,
      557                          output v-nids ,
      558                          output v-parameter-type )  .
      559           if v-nids <> ""
      560           and v-nids <> ?
      561           then do:
      562               put
      563                           space(20)   "Основание: накладная поставщика N: "
      564                                       v-nids format "x(110)"
      565                   skip(1)
      566               .
      567           end.
      568       end.
      569   end.
      570   if t-doc.doc-type = 'при':U
      571   or ( t-doc.ext-doc-type = 'ep':U )
      572   then do:
      573           put space(20) string( "ПОСТАВЩИК : " + t-doc.cli-name ) format "x(90)" skip(1) .
      574   end.
      575   form header
      576       v-single-line format "X(136)" at 1 skip
      577       "Продолжение - на следующей странице" at 30 skip
      578       with frame Bottomframe width 235 page-bottom no-labels no-box .
      579   view frame Bottomframe .
      580   if v-rb-is-base = yes
      581   then do:
      582       form with frame Akt-base .
      583   end.
      584   else do:
      585       form with frame Akt-rubl .
      586   end.
      587   for each doc-line no-lock
      588      where doc-line.doc-code = t-doc.doc-code
      589     , each gds-dtl no-lock
      590      where gds-dtl.doc-code = t-doc.doc-code
      591        and gds-dtl.prod-type = doc-line.prod-type
      592        and gds-dtl.prod-code = doc-line.prod-code
      593        and gds-dtl.artic = doc-line.artic
      594        and gds-dtl.ov = yes
      595     , each goods no-lock
      596      where goods.prod-type = gds-dtl.prod-type
      597        and goods.prod-code = gds-dtl.prod-code
      598        and goods.artic = gds-dtl.artic
      599   break by gds-dtl.artic
      600         by gds-dtl.prt-code
      601   :
      602           find first bar-code no-lock
      603                where bar-code.gds-code = goods.gds-code
      604                  and goods.unit-base = bar-code.unit-cli
      605                  and gds-dtl.prt-code = bar-code.node-code
      606                  and bar-code.part-code = ""
      607                  and bar-code.in-code = ""
      608           no-error.
      609           accumulate
      610               bar-code.b-code ( COUNT )
      611               gds-dtl.fact-qnty ( total )
      612               ( gds-dtl.fact-qnty * gds-dtl.cur-base ) ( total )
      613               ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ( total )
      614               ( gds-dtl.fact-qnty * gds-dtl.price-base ) ( total )
      615               ( ( gds-dtl.cur-base - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ( total )
      616               ( ( gds-dtl.cur-base - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ( total )
      617           .
      618           if v-rb-is-base = yes
      619           then do:
      620               display
      621                   sym1
      622                   trim( string( bar-code.b-code ) ) @ tb-code
      623                   gds-dtl.artic
      624                   goods.gds-name
      625                   gds-dtl.fact-qnty
      626                   gds-dtl.price-base @ price-doc
      627                   ( gds-dtl.fact-qnty * gds-dtl.price-base ) @ doc-sum
      628                   gds-dtl.cur-base
      629                   ( gds-dtl.fact-qnty * gds-dtl.cur-base ) @ obj-sum
      630                   string( string( ( gds-dtl.cur-base - gds-dtl.price-base ) / gds-dtl.price-base * 100, "->>>9.9" ) + "%" ) @ Delt
      631                   sym2
      632               with frame Akt-base .
      633               down 1 with frame Akt-base .
      634               IF LENGTH(goods.gds-name, "CHARACTER") > 30 and FullGdsName THEN  do:
      635                 assign propis = SUBSTRING(goods.gds-name,31) .
      636                 DISPLAY sym1 propis @ goods.gds-name  sym2   with frame Akt-base .
      637                 down 1 with frame Akt-base .
      638               end.
      639           end.
      640           else do:
      641               display
      642                   sym1
      643                   trim( string( bar-code.b-code ) ) @ tb-code
      644                   gds-dtl.artic
      645                   goods.gds-name
      646                   gds-dtl.fact-qnty
      647                   gds-dtl.price-rubl @ price-doc
      648                   ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) @ doc-sum
      649                   gds-dtl.cur-base
      650                   ( gds-dtl.fact-qnty * gds-dtl.cur-base ) @ obj-sum
      651                   string( string( ( gds-dtl.cur-base - gds-dtl.price-rubl ) / gds-dtl.price-rubl * 100, "->>>9.9" ) + "%" ) @ Delt
      652                   sym2
      653               with frame Akt-rubl .
      654               down 1 with frame Akt-rubl .
      655               IF LENGTH(goods.gds-name, "CHARACTER") > 30 and FullGdsName THEN  do:
      656                 assign propis = SUBSTRING(goods.gds-name,31) .
      657                 DISPLAY sym1 propis @ goods.gds-name  sym2   with frame Akt-rubl .
      658                 down 1 with frame Akt-rubl .
      659               end.
      660           end.
      661           if last( gds-dtl.artic )
      662           then do:
      663               if v-rb-is-base = yes
      664               then do:
      665                   put
      666                       v-single-line format "X(136)" skip
      667                   .
      668                   display "  ИТОГО"    @ goods.gds-name
      669                       accum total gds-dtl.fact-qnty @ gds-dtl.fact-qnty
      670                       accum total ( gds-dtl.fact-qnty * gds-dtl.price-base ) @ doc-sum
      671                       accum total ( gds-dtl.fact-qnty * gds-dtl.cur-base ) @ obj-sum
      672                       string( string( ( accum total ( ( gds-dtl.cur-base - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ) /
      673                                               ( accum total ( gds-dtl.fact-qnty * gds-dtl.price-base ) ) * 100, "->>>9.9" ) + "%" )
      674                                       @ Delt
      675                   with frame Akt-base.
      676                   underline
      677                       goods.gds-name
      678                       gds-dtl.fact-qnty
      679                       doc-sum
      680                       obj-sum
      681                       Delt
      682                   with frame Akt-base.
      683                   down 2
      684                   with frame Akt-base.
      685               end.
      686               else do:
      687                   put
      688                       v-single-line format "X(136)" skip
      689                   .
      690                   display "  ИТОГО"    @ goods.gds-name
      691                       accum total gds-dtl.fact-qnty @ gds-dtl.fact-qnty
      692                       accum total ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) @ doc-sum
      693                       accum total ( gds-dtl.fact-qnty * gds-dtl.cur-base ) @ obj-sum
      694                       string( string( ( accum total ( ( gds-dtl.cur-base - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ) /
      695                                               ( accum total ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ) * 100, "->>>9.9" ) + "%" )
      696                                       @ Delt
      697                   with frame Akt-rubl.
      698                   underline
      699                       goods.gds-name
      700                       gds-dtl.fact-qnty
      701                       doc-sum
      702                       obj-sum
      703                       Delt
      704                   with frame Akt-rubl.
      705                   down 2
      706                   with frame Akt-rubl.
      707               end.
      708           end.
      709   end.
      710   hide frame Bottomframe .
      711   if v-rb-is-base = yes
      712   then do:
      713       run rep/wp.p ( input p-mainmenu-handle, input absolute( accum total ( ( gds-dtl.cur-base - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
      714       put space(10) "Всего  " ( accum COUNT bar-code.b-code ) format ">>>>9"
      715           " наименований." format "X(15)"
      716           skip(1) space(10)
      717           "Разница в суммах составила :  " format "X(35)"
      718               ( accum total ( ( gds-dtl.cur-base - gds-dtl.price-base ) * gds-dtl.fact-qnty ) )
      719               format "->,>>>,>>>,>>9.99" space(2) trim( abbr ) format "X(3)"
      720           skip(1)
      721       .
      722   end.
      723   else do:
      724       run rep/wp-rub.p ( input absolute( accum total ( ( gds-dtl.cur-base - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
      725       put space(10) "Всего  " ( accum COUNT bar-code.b-code ) format ">>>>9"
      726           " наименований." format "X(15)"
      727           skip(1) space(10)
      728           "Разница в суммах составила :  " format "X(35)"
      729               ( accum total ( ( gds-dtl.cur-base - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) )
      730               format "->,>>>,>>>,>>9.99" space(2) trim( abbr ) format "X(3)"
      731           skip(1)
      732       .
      733   end.
      734   if line-counter + 4 > page-size then
      735       page .
      736   put space(10) ( if trim(propis) begins trim( abbr ) then string( "0 " + propis ) else propis ) format "X(120)" skip(2).
      737   put space(20) "Зав. складом/Зав. секцией : " format "X(30)" skip.
      738   output close.
      739   if g#quest-print = false
      740   then do:
      741     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      742                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      743                                         OUTPUT g#log ).
      744   end.
      745   else do:
      746     os-command silent
      747       value( "COPY /b " +
      748         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      749         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      750         string( session:temp-directory) +  "$" + string( g#report-num )
      751                 ) .
      752     os-command silent
      753       value( "COPY /b " +
      754         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      755         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      756         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      757                 ) .
      758   end.
