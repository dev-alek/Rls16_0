     1296   DEFINE temp-table temp-gds no-undo
     1297       field   artic            as char
     1298       field   prod-type        as char
     1299       field   prod-code        as integer
     1300       field   part-code        like parts.part-code
     1301       field   in-code          like parts.in-code
     1302       field   gds-code         as integer
     1303       field   gds-name         as char
     1304       field   gds-name1        as char
     1305       field   grp-name         as char
     1306       field   upak             as decimal
     1307       field   qnty             as decimal
     1308       field   price            as decimal
     1309       field   qnty1            as decimal
     1310       field   price1           as decimal
     1311       field   sum              as decimal
     1312       field   num-ser          as character
     1313       field   seria            as character
     1314       field   line-num         like doc-line.line-num
     1315       field   data             as date
     1316       field   last-date        as date
     1317       index pi  is primary   artic  prod-type prod-code
     1318       index pi1              gds-name
     1319       index pi2              grp-name
     1320       index pi3              line-num
     1321   .
     1322       find first buf_trn-doc no-lock where recid( buf_trn-doc ) = p-trn-doc-recid .
     1323       find first buf_clients no-lock
     1324            where buf_clients.obj-type = buf_trn-doc.obj-type
     1325              and buf_clients.obj-code = buf_trn-doc.obj-code
     1326       .
     1327       assign  v-obj-name = string( buf_clients.obj-name )  .
     1328       find first buf_clients no-lock
     1329            where buf_clients.obj-type = buf_trn-doc.cli-type
     1330              and buf_clients.obj-code = buf_trn-doc.cli-code
     1331       .
     1332       if available buf_clients then  assign  v-cli-name = string( buf_clients.obj-name ) .
     1333       else                           assign  v-cli-name = "" .
     1334       define variable v-attr-value  as character no-undo .
     1335       define variable v-attr-type   as character no-undo .
     1336       define variable v-osnov       as character initial "" no-undo .
     1337       define variable v-ser_on_pack   as character.
     1338   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1339                           input 'ser_on_pack':U ,
     1340                          output v-ser_on_pack ,
     1341                          output v-attr-type )  .
     1342   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1343                           input 'nids':U ,
     1344                          output v-attr-value ,
     1345                          output v-attr-type )  .
     1346       assign v-osnov = v-attr-value .
     1347   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     1348                           input 'dids':U ,
     1349                          output v-attr-value ,
     1350                          output v-attr-type )  .
     1351       if v-attr-value <> ? and trim(v-attr-value) <> "" then assign v-osnov = v-osnov + " от " + v-attr-value .
     1352       assign
     1353           v-single-line       = fill( "-", 195 )
     1354           v-line-counter      = 0
     1355       .
     1356   output stream out-stream to value( string( session:temp-directory +
     1357                                        "rpt" + string( g#report-num ) ) )
     1358                                        page-size  value(43) .
     1359       run r-fasxl-init in this-procedure .
     1360       form header
     1361           space(1) v-single-line format "X(195)" skip    'Продолжение - на следующей странице' at 90 skip
     1362           with frame BottomFrame width 198 page-bottom no-labels no-box .
     1363       view stream out-stream frame BottomFrame .
     1364   if session :set-wait-state( "compiler" ) then.
     1365       put stream out-stream
     1366           space(1 )  v-obj-name  format "X(60)"
     1367           skip space( 60 ) "Лист журнала фасовочных работ № "   buf_trn-doc.doc-code   format "X(14)"
     1368           " от " ( if buf_trn-doc.status_ <> 'факт':U then string(buf_trn-doc.doc-date) + "   Статус: " + caps(buf_trn-doc.status_) else string(buf_trn-doc.fact-date) )  format "X(50)"
     1369           skip space( 1 ) string( "Поставщик (отправитель): " + v-cli-name + v-osnov )  format "X(160)"
     1370           skip
     1371       .
     1372       run r-fasxl-write-cell-data in this-procedure ( input "h_docName":U, input string( buf_trn-doc.doc-code + " от " + ( if buf_trn-doc.status_ <> 'факт':U then string(buf_trn-doc.doc-date) + "   Статус: " + caps(buf_trn-doc.status_) else string(buf_trn-doc.fact-date) ))) .
     1373       run r-fasxl-write-cell-data in this-procedure ( input "h_Obj":U, input v-obj-name) .
     1374       run r-fasxl-write-cell-data in this-procedure ( input "h_cliFrom":U, input string( "Поставщик (отправитель): " + v-cli-name + v-osnov )) .
     1375       run print-header in this-procedure .
     1376       for each buf_doc-line no-lock where buf_doc-line.doc-code = buf_trn-doc.doc-code :
     1377         find first  buf_goods no-lock where buf_goods.artic = buf_doc-line.artic and buf_goods.prod-type = buf_doc-line.prod-type and buf_goods.prod-code = buf_doc-line.prod-code .
     1378         run gds-attr-value in this-procedure (
     1379              input  buf_goods.gds-code,
     1380              input  'fasovka':U,
     1381              output v-attr-value,
     1382              output v-attr-type )
     1383              .
     1384         if lookup(v-attr-value, 'true,yes':u) = 0 then next .
     1385         for each buf_parts no-lock
     1386           where buf_parts.out-code   = buf_doc-line.doc-code
     1387             and buf_parts.obj-type   = buf_doc-line.obj-type
     1388             and buf_parts.obj-code   = buf_doc-line.obj-code
     1389             and buf_parts.artic      = buf_doc-line.artic
     1390             and buf_parts.prod-type  = buf_doc-line.prod-type
     1391             and buf_parts.prod-code  = buf_doc-line.prod-code
     1392           :
     1393           create temp-gds .
     1394           assign
     1395             temp-gds.artic       = buf_doc-line.artic
     1396             temp-gds.prod-type   = buf_doc-line.prod-type
     1397             temp-gds.prod-code   = buf_doc-line.prod-code
     1398             temp-gds.part-code   = buf_parts.part-code
     1399             temp-gds.in-code     = buf_parts.in-code
     1400             temp-gds.gds-code    = buf_goods.gds-code
     1401             temp-gds.gds-name1   = buf_goods.gds-name
     1402             temp-gds.gds-name    = buf_goods.engl-name
     1403             temp-gds.grp-name    = buf_goods.grp-name
     1404             temp-gds.upak        = if buf_goods.qnty-cart = 0 then 1 else buf_goods.qnty-cart
     1405             temp-gds.qnty        = buf_parts.fact-qnty
     1406             temp-gds.qnty1       = buf_parts.fact-qnty / temp-gds.upak
     1407             temp-gds.line-num    = buf_doc-line.line-num
     1408             temp-gds.data        = if buf_trn-doc.status_ <> 'факт':U then buf_trn-doc.doc-date else buf_trn-doc.fact-date
     1409             temp-gds.last-date   = buf_parts.last-date
     1410             temp-gds.num-ser     = entry(1,buf_parts.part-code,' ')
     1411           .
     1412           if num-entries(buf_parts.part-code,' ') > 1 then do:
     1413             assign temp-gds.seria = entry(2,buf_parts.part-code,' ') .
     1414             if num-entries(buf_parts.part-code,' ') > 2 then assign temp-gds.seria = temp-gds.seria + entry(3,buf_parts.part-code,' ') .
     1415           end.
     1416           if trim(temp-gds.gds-name) = "" then  assign temp-gds.gds-name = temp-gds.gds-name1 .
     1417           if temp-gds.num-ser = ? then assign temp-gds.num-ser = ""  .
     1418           if temp-gds.seria = ?   then assign temp-gds.seria = ""  .
     1419           if buf_trn-doc.status_ = 'факт':U then do:
     1420             assign
     1421               tot-sum  = 0
     1422               tot-qnty = 0
     1423             .
     1424             FOR EACH buf_gds-dtl NO-LOCK
     1425               WHERE buf_gds-dtl.doc-code  = buf_trn-doc.doc-code
     1426                 and buf_gds-dtl.artic     = buf_doc-line.artic
     1427                 and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1428                 and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1429               :
     1430               assign
     1431                 tot-sum  = tot-sum  + buf_gds-dtl.doc-qnty * buf_gds-dtl.cur-base
     1432                 tot-qnty = tot-qnty + buf_gds-dtl.doc-qnty
     1433               .
     1434             end.
     1435             if tot-qnty <> 0 then assign temp-gds.price = tot-sum / tot-qnty  .
     1436           END.
     1437           else do:
     1438   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1439     (input  temp-gds.gds-code
     1440     ,input  ?
     1441     ,output b-code
     1442     ) no-error .
     1443             if not error-status :error then do:
     1444               find last price-list no-lock
     1445                 where price-list.obj-type  = buf_doc-line.obj-type
     1446                   and price-list.obj-code  = buf_doc-line.obj-code
     1447                   and price-list.b-code    = b-code
     1448               use-index fact-close no-error .
     1449               if available price-list then assign temp-gds.price = price-list.price-sale .
     1450             end .
     1451           end .
     1452           assign
     1453             temp-gds.price1      = temp-gds.price * temp-gds.upak
     1454             temp-gds.sum         = temp-gds.qnty * temp-gds.price
     1455           .
     1456         end.
     1457       end.
     1458       if v-sort-prod = "yes" then do:
     1459         if sort-gr = yes then do:
     1460           if sort-name = yes then do:
     1461             for each temp-gds break by temp-gds.prod-type by temp-gds.prod-code by  temp-gds.grp-name by temp-gds.gds-name :
     1462               if  first-of( temp-gds.prod-code) then do:
     1463                 run print-prod in this-procedure .
     1464               end.
     1465               if first-of(temp-gds.grp-name) then do:
     1466                 run print-group-line in this-procedure ( input temp-gds.grp-name ).
     1467               end.
     1468               if last( temp-gds.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1469                 run PrintTitul .
     1470               end.
     1471               run print-line in this-procedure .
     1472             end.
     1473           end.
     1474           else do:
     1475             for each temp-gds break by temp-gds.prod-type by temp-gds.prod-code by temp-gds.grp-name by temp-gds.line-num :
     1476               if  first-of( temp-gds.prod-code) then do:
     1477                 run print-prod in this-procedure .
     1478               end.
     1479               if first-of( temp-gds.grp-name ) then do:
     1480                 run print-group-line in this-procedure ( input temp-gds.grp-name ).
     1481               end.
     1482               if last( temp-gds.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1483                 run PrintTitul .
     1484               end.
     1485               run print-line in this-procedure .
     1486             end.
     1487           end.
     1488         end.
     1489         else do:
     1490           if sort-name = yes then do:
     1491             for each temp-gds break by temp-gds.prod-type by temp-gds.prod-code by temp-gds.gds-name :
     1492               if  first-of( temp-gds.prod-code) then do:
     1493                 run print-prod in this-procedure .
     1494               end.
     1495               if last( temp-gds.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1496                 run PrintTitul .
     1497               end.
     1498               run print-line in this-procedure .
     1499             end.
     1500           end.
     1501           else do:
     1502             for each temp-gds break by temp-gds.prod-type by temp-gds.prod-code by temp-gds.line-num :
     1503               if  first-of( temp-gds.prod-code) then do:
     1504                 run print-prod in this-procedure .
     1505               end.
     1506               if last( temp-gds.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1507                 run PrintTitul .
     1508               end.
     1509               run print-line in this-procedure .
     1510             end.
     1511           end.
     1512         end.
     1513       end.
     1514       else do:
     1515         if sort-gr = yes then do:
     1516           if sort-name = yes then do:
     1517             for each temp-gds break by temp-gds.grp-name  by temp-gds.gds-name :
     1518               if first-of(temp-gds.grp-name) then do:
     1519                 run print-group-line in this-procedure ( input temp-gds.grp-name ).
     1520               end.
     1521               if last( temp-gds.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1522                 run PrintTitul .
     1523               end.
     1524               run print-line in this-procedure .
     1525             end.
     1526           end.
     1527           else do:
     1528             for each temp-gds break by temp-gds.grp-name by temp-gds.line-num :
     1529               if first-of( temp-gds.grp-name ) then do:
     1530                 run print-group-line in this-procedure ( input temp-gds.grp-name ).
     1531               end.
     1532               if last( temp-gds.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1533                 run PrintTitul .
     1534               end.
     1535               run print-line in this-procedure .
     1536             end.
     1537           end.
     1538         end.
     1539         else do:
     1540           if sort-name = yes then do:
     1541             for each temp-gds break by temp-gds.gds-name  :
     1542               if last( temp-gds.gds-name ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1543                 run PrintTitul .
     1544               end.
     1545               run print-line in this-procedure .
     1546             end.
     1547           end.
     1548           else do:
     1549             for each temp-gds break by temp-gds.line-num    :
     1550               if last( temp-gds.line-num ) and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream ) then do:
     1551                 run PrintTitul .
     1552               end.
     1553               run print-line in this-procedure .
     1554             end.
     1555           end.
     1556         end.
     1557       end.
     1558       run print-total-result in this-procedure .
     1559          put stream out-stream
     1560          skip
     1561           space(20 )   "Сдал___________________                                                                                Принял__________________________ "   format "X(140)" skip.
     1562       run r-fasxl-close in this-procedure .
     1563       hide stream Out-Stream frame BottomFrame .
     1564       output stream out-stream close.
     1565   if session :set-wait-state( "" ) then.
     1566   if g#quest-print = false
     1567   then do:
     1568     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1569                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1570                                         OUTPUT g#log ).
     1571   end.
     1572   else do:
     1573     os-command silent
     1574       value( "COPY /b " +
     1575         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1576         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1577         string( session:temp-directory) +  "$" + string( g#report-num )
     1578                 ) .
     1579     os-command silent
     1580       value( "COPY /b " +
     1581         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1582         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1583         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1584                 ) .
     1585   end.
     1586   procedure PrintTitul :
     1587     do on error undo, return error return-value :
     1588       if line-counter( Out-Stream ) + 2 < page-size( Out-Stream ) then do:
     1589         put stream out-stream skip space(1) "|" v-single-line format "X(193)" "|" .
     1590       end.
     1591       page stream Out-Stream .
     1592       run print-header in this-procedure .
     1593     end.
     1594   end procedure.
     1595   procedure print-header :
     1596     do on error undo, return error:
     1597       assign  v-first-line = yes .
     1598       put stream out-stream
     1599       skip
     1600       space(1)       v-single-line   format "X(195)"
     1601       skip space(1)  "|"
     1602           "Выдано в работу"       at center-field(1 + 1, 1 + 104, 15)
     1603           "|"                     at 1 + 104
     1604           "Расфасовано и сдано"   at center-field(1 + 104, 1 + 186, 19)
     1605           "|"                     at 1 + 186
     1606           "Срок"                  at center-field(1 + 186, 1 + 195, 4)
     1607           "|"                     at 1 + 195
     1608       skip
     1609       space(1)   "|"     v-single-line   format "X(184)"   "|"
     1610           "|"                     at 1 + 195
     1611       skip space(1)  "|"
     1612           "№ ф/с"                 at center-field(1 + 1, 1 + 11, 7)
     1613           "|"                     at 1 + 11
     1614           "дата"                  at center-field(1 + 11, 1 + 20, 4)
     1615           "|"                     at 1 + 20
     1616           "номенкл"               at center-field(1 + 20, 1 + 28, 7)
     1617           "|"                     at 1 + 28
     1618           "Наименование товара (сырья)"   at 1 + 28 + 2
     1619           "|"                     at 1 + 63
     1620           "Ед."                   at center-field(1 + 63, 1 + 67, 3)
     1621           "|"                     at 1 + 67
     1622           "Серия"                 at center-field(1 + 67, 1 + 78, 5)
     1623           "|"                     at 1 + 78
     1624           "Кол-во"                at center-field(1 + 78, 1 + 89, 6)
     1625           "|"                     at 1 + 89
     1626           "Цена розн."            at center-field(1 + 89, 1 + 104, 10)
     1627           "|"                     at 1 + 104
     1628           "Наименование готовой продукции"   at 1 + 104 + 2
     1629           "|"                     at 1 + 139
     1630           "Ед."                   at center-field(1 + 139, 1 + 143, 3)
     1631           "|"                     at 1 + 143
     1632           "Кол-во"                at center-field(1 + 143, 1 + 154, 6)
     1633           "|"                     at 1 + 154
     1634           "Цена розн."            at center-field(1 + 154, 1 + 169, 10)
     1635           "|"                     at 1 + 169
     1636           "Сумма розн."           at center-field(1 + 169, 1 + 186, 11)
     1637           "|"                     at 1 + 186
     1638           "годности"              at center-field(1 + 186, 1 + 195, 8)
     1639           "|"                     at 1 + 195
     1640       skip space(1)  "|"
     1641           "|"                     at 1 + 11
     1642           "|"                     at 1 + 20
     1643           "номер"                 at center-field(1 + 20, 1 + 28, 5)
     1644           "|"                     at 1 + 28
     1645           "|"                     at 1 + 63
     1646           "изм"                   at center-field(1 + 63, 1 + 67, 3)
     1647           "|"                     at 1 + 67
     1648           "|"                     at 1 + 78
     1649           "|"                     at 1 + 89
     1650           "|"                     at 1 + 104
     1651           "|"                     at 1 + 139
     1652           "изм"                   at center-field(1 + 139, 1 + 143, 3)
     1653           "|"                     at 1 + 143
     1654           "|"                     at 1 + 154
     1655           "|"                     at 1 + 169
     1656           "|"                     at 1 + 186
     1657           "|"                     at 1 + 195
     1658       skip space(1)
     1659           "|" v-single-line format "X(193)" "|"
     1660       .
     1661     end.
     1662   end procedure.
     1663   procedure print-line :
     1664       put stream out-stream
     1665               skip space(1)  "|"
     1666                   v-ser_on_pack                format "X(9)"
     1667                   "|"   at 1 + 11
     1668                   temp-gds.data                format "99/99/99"
     1669                   "|"   at 1 + 20
     1670                   "|"   at 1 + 28
     1671                   temp-gds.gds-name            format "X(34)"
     1672                   "|"   at 1 + 63
     1673                   "|"   at 1 + 67
     1674                   temp-gds.num-ser             format "X(10)"
     1675                   "|"   at 1 + 78
     1676                   temp-gds.qnty1                format "->>>>>9.99"
     1677                   "|"   at 1 + 89
     1678                   temp-gds.price1              format "->>>>>>>>>9.99"
     1679                   "|"   at 1 + 104
     1680                   temp-gds.gds-name1           format "X(34)"
     1681                   "|"   at 1 + 139
     1682                   "|"   at 1 + 143
     1683                   temp-gds.qnty                format "->>>>>9.99"
     1684                   "|"   at 1 + 154
     1685                   temp-gds.price              format "->>>>>>>>>9.99"
     1686                   "|"   at 1 + 169
     1687                   temp-gds.sum                 format "->>>>>>>>>>>9.99"
     1688                   "|"   at 1 + 186
     1689                   temp-gds.last-date           format "99/99/99"
     1690                   "|"   at 1 + 195
     1691           .
     1692         run r-fasxl-write-line-data in this-procedure (
     1693                     input v-ser_on_pack
     1694                   , input string(temp-gds.data, "99/99/99")
     1695                   , input temp-gds.gds-name
     1696                   , input temp-gds.num-ser
     1697                   , input temp-gds.qnty1
     1698                   , input temp-gds.price1
     1699                   , input temp-gds.gds-name1
     1700                   , input temp-gds.qnty
     1701                   , input temp-gds.price
     1702                   , input temp-gds.sum
     1703                   , input if string(temp-gds.last-date) = ? then "" else string(temp-gds.last-date, "99/99/9999" )
     1704         ).
     1705         assign v-line-counter      = v-line-counter    + 1  .
     1706         if line-counter( Out-Stream ) + 2 + 2 > page-size( Out-Stream ) then do:
     1707           page stream Out-Stream .
     1708           run print-header in this-procedure .
     1709         end.
     1710   end procedure.
     1711   procedure print-group-line :
     1712     define input parameter p-grp-name   as character no-undo .
     1713     if line-counter( Out-Stream ) + 2 + 2 + 1 > page-size( Out-Stream ) then do:
     1714       page stream out-stream.
     1715       run print-header in this-procedure .
     1716     end.
     1717     if v-first-line <> yes then do:
     1718       put stream out-stream  skip space(1) "|" v-single-line format "X(193)" "|" .
     1719     end.
     1720     put stream out-stream  skip space(1) "|   ***  Группа:  "  + p-grp-name format "X(110)" "|" at 1 + 195 .
     1721   end procedure.
     1722   procedure print-prod :
     1723     do on error undo, return error :
     1724       if line-counter( Out-Stream ) + 2 + 2 + 1 > page-size( Out-Stream ) then do:
     1725           page stream out-stream.
     1726           run print-header in this-procedure .
     1727       end.
     1728       if v-first-line <> yes then do:
     1729         put stream out-stream  skip space(1) "|" v-single-line format "X(193)" "|" .
     1730       end.
     1731       find first buf_clients no-lock where buf_clients.obj-type = temp-gds.prod-type and buf_clients.obj-code = temp-gds.prod-code  .
     1732       put stream out-stream  skip space(1) "| *** Производитель: "  + buf_clients.obj-name format "X(110)" "|" at 1 + 195 .
     1733     end.
     1734   end procedure.
     1735   procedure print-total-result :
     1736     do on error undo, return error :
     1737       put stream out-stream  skip space(1)  v-single-line format "X(195)" .
     1738     end.
     1739   end procedure.
     1740   procedure print-note :
     1741     do on error undo, return error :
     1742       put stream out-stream  skip(1) space(22)  "Всего строк: "  v-line-counter  format ">>>>>9"  .
     1743     end.
     1744   end procedure.
