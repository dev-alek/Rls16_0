      930   define new global shared variable g#library  as handle no-undo .
      931   define new global shared variable g#library2 as handle no-undo .
      932   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      933   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      934   procedure paramls-clear :
      935     define buffer buf_temp-param for temp-param .
      936     do
      937     on error undo, return error return-value
      938     :
      939       for each buf_temp-param
      940       on error undo, return error
      941       :
      942         delete buf_temp-param .
      943       end.
      944     end.
      945   end procedure.
      946   procedure paramls-write :
      947     define input  parameter p-code     as character no-undo .
      948     define input  parameter p-sub-code as character no-undo .
      949     define input  parameter p-value    as character no-undo .
      950     define buffer buf_temp-param for temp-param .
      951     do
      952     on error undo, return error return-value
      953     :
      954       find first buf_temp-param
      955         where buf_temp-param.param-code     = p-code
      956           and buf_temp-param.param-sub-code = p-sub-code
      957         no-error .
      958       if not available buf_temp-param then do:
      959         create buf_temp-param .
      960         assign
      961           buf_temp-param.param-code     = p-code
      962           buf_temp-param.param-sub-code = p-sub-code
      963         .
      964       end.
      965       assign
      966         buf_temp-param.param-value = p-value
      967       .
      968     end.
      969   end procedure.
      970   procedure paramls-read :
      971     define input  parameter p-code          as character no-undo .
      972     define input  parameter p-sub-code      as character no-undo .
      973     define input  parameter p-default-value as character no-undo .
      974     define output parameter p-value         as character no-undo .
      975     define buffer buf_temp-param for temp-param .
      976     do
      977     on error undo, return error return-value
      978     :
      979       find first buf_temp-param
      980         where buf_temp-param.param-code     = p-code
      981           and buf_temp-param.param-sub-code = p-sub-code
      982         no-error .
      983       if available buf_temp-param then do:
      984         assign
      985           p-value = buf_temp-param.param-value
      986         .
      987       end.
      988       else do:
      989         assign
      990           p-value = p-default-value
      991         .
      992       end.
      993     end.
      994   end procedure.
      995   procedure paramls-append :
      996     define input  parameter p-code     as character no-undo .
      997     define input  parameter p-sub-code as character no-undo .
      998     define input  parameter p-value    as character no-undo .
      999     define buffer buf_temp-param for temp-param .
     1000     do
     1001     on error undo, return error return-value
     1002     :
     1003       find first buf_temp-param
     1004            where buf_temp-param.param-code     = p-code
     1005              and buf_temp-param.param-sub-code = p-sub-code
     1006         no-error .
     1007       if not available buf_temp-param then do:
     1008         create buf_temp-param .
     1009         assign
     1010           buf_temp-param.param-code     = p-code
     1011           buf_temp-param.param-sub-code = p-sub-code
     1012           buf_temp-param.param-value    = p-value
     1013         .
     1014       end.
     1015       else do:
     1016           assign
     1017               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1018           .
     1019       end.
     1020     end.
     1021   end procedure.
     1022   define variable g#report-num    as integer      no-undo.
     1023   define variable vss-include-info5 as character format "X(65)" no-undo
     1024   initial "@(#)$Workfile$ $Revision$".
     1025   define stream excel-line.
     1026   define stream excel-cell.
     1027   define temp-table temp_cell-data no-undo
     1028       field data-key as character
     1029       field data-value as character
     1030       index pi is primary unique data-key
     1031   .
     1032   define temp-table temp_line-data no-undo
     1033       field data-key     as character
     1034       field xl-line-id   as integer
     1035       field   num_ser          as character
     1036       field   docdate             as character
     1037       field   gds_name         as character
     1038       field   seria            as character
     1039       field   qnty             as decimal
     1040       field   price            as decimal
     1041       field   gds_name1        as character
     1042       field   qnty1            as decimal
     1043       field   price1           as decimal
     1044       field   sum              as decimal
     1045       field   last_date        as character
     1046       index pi is primary unique xl-line-id
     1047   .
     1048   define variable v-r-fasxl-current-data-row     as integer      no-undo.
     1049   define variable v-r-fasxl-cell-file-name       as character    no-undo.
     1050   define variable v-r-fasxl-data-file-name       as character    no-undo.
     1051   procedure r-fasxl-init :
     1052       define buffer buf_temp_cell-data        for temp_cell-data.
     1053   do
     1054   for buf_temp_cell-data on error undo, return error :
     1055       assign
     1056           v-r-fasxl-current-data-row = 0
     1057       .
     1058       run gbl/_tmpfile.p ( input "xd", input ".txt", output v-r-fasxl-data-file-name ).
     1059       output stream excel-line to value( v-r-fasxl-data-file-name ).
     1060       run gbl/_tmpfile.p ( input "xc", input ".txt", output v-r-fasxl-cell-file-name ).
     1061       output stream excel-cell to value( v-r-fasxl-cell-file-name ).
     1062       if printrubl
     1063       then do:
     1064           run r-fasxl-write-cell-data in this-procedure (
     1065                 input "valutCode":U
     1066               , input "0":U
     1067           ).
     1068       end.
     1069       else do:
     1070           run r-fasxl-write-cell-data in this-procedure (
     1071                 input "valutCode":U
     1072               , input "1":U
     1073           ).
     1074       end.
     1075       run r-fasxl-write-cell-data in this-procedure (
     1076             input "columnList":U
     1077           , input "num_ser,docdate,gds_name,seria,qnty,price,gds_name1,qnty1,price1,sum,last_date":U
     1078       ).
     1079       run r-fasxl-write-cell-data in this-procedure (
     1080             input "columnType":U
     1081           , input "S,S,S,S,D,D,S,D,D,D,S":U
     1082       ).
     1083       run r-fasxl-write-cell-data in this-procedure (
     1084             input "columnAmount":U
     1085           , input "11":U
     1086       ).
     1087   end.
     1088   end procedure.
     1089   procedure r-fasxl-close :
     1090   do
     1091   on error undo, return error
     1092   :
     1093       output stream excel-line close.
     1094       output stream excel-cell close.
     1095       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1096           export "exe/fas_97.xlt":U.
     1097           export "exe/t_97.bas":U.
     1098           export v-r-fasxl-cell-file-name.
     1099           export v-r-fasxl-data-file-name.
     1100       output close.
     1101   end.
     1102   end procedure.
     1103   procedure r-fasxl-write-cell-data :
     1104   define input parameter p-data-key   as character        no-undo.
     1105   define input parameter p-data-value as character        no-undo.
     1106       define buffer buf_temp_cell-data     for temp_cell-data.
     1107   do
     1108   for buf_temp_cell-data
     1109   on error undo, return error
     1110   :
     1111       find first buf_temp_cell-data
     1112            where buf_temp_cell-data.data-key = p-data-key
     1113       no-error.
     1114       if not available buf_temp_cell-data
     1115       then do:
     1116           create buf_temp_cell-data.
     1117           assign
     1118               buf_temp_cell-data.data-key = p-data-key
     1119           .
     1120       end.
     1121       assign
     1122           buf_temp_cell-data.data-value = p-data-value
     1123       .
     1124       put stream excel-cell unformatted
     1125                           buf_temp_cell-data.data-key
     1126           chr(9)   buf_temp_cell-data.data-value
     1127           chr(10)
     1128       .
     1129   end.
     1130   end procedure.
     1131   procedure r-fasxl-write-line-data :
     1132   define input parameter p-num-ser          as character         no-undo.
     1133   define input parameter p-docdate             as character              no-undo.
     1134   define input parameter p-gds-name         as character              no-undo.
     1135   define input parameter p-seria            as character         no-undo.
     1136   define input parameter p-qnty             as decimal           no-undo.
     1137   define input parameter p-price            as decimal           no-undo.
     1138   define input parameter p-gds-name1        as character              no-undo.
     1139   define input parameter p-qnty1            as decimal           no-undo.
     1140   define input parameter p-price1           as decimal           no-undo.
     1141   define input parameter p-sum              as decimal           no-undo.
     1142   define input parameter p-last-date        as character              no-undo.
     1143      define buffer buf_temp_line-data        for temp_line-data.
     1144   do
     1145   for buf_temp_line-data
     1146   on error undo, return error
     1147   :
     1148       for each buf_temp_line-data
     1149       :
     1150           delete buf_temp_line-data.
     1151       end.
     1152       create buf_temp_line-data.
     1153       assign
     1154           v-r-fasxl-current-data-row = v-r-fasxl-current-data-row + 1
     1155       .
     1156       assign
     1157           buf_temp_line-data.data-key     = "LD":U
     1158           buf_temp_line-data.xl-line-id   = v-r-fasxl-current-data-row
     1159           buf_temp_line-data.num_ser      = p-num-ser
     1160           buf_temp_line-data.docdate         = p-docdate
     1161           buf_temp_line-data.gds_name     = p-gds-name
     1162           buf_temp_line-data.seria        = p-seria
     1163           buf_temp_line-data.qnty         = p-qnty
     1164           buf_temp_line-data.price        = p-price
     1165           buf_temp_line-data.gds_name1    = p-gds-name1
     1166           buf_temp_line-data.qnty1        = p-qnty1
     1167           buf_temp_line-data.price1       = p-price1
     1168           buf_temp_line-data.sum          = p-sum
     1169           buf_temp_line-data.last_date    = p-last-date
     1170       .
     1171       put stream excel-line unformatted
     1172                           buf_temp_line-data.data-key
     1173           chr(9)   buf_temp_line-data.num_ser
     1174           chr(9)   buf_temp_line-data.docdate
     1175           chr(9)   buf_temp_line-data.gds_name
     1176           chr(9)   buf_temp_line-data.seria
     1177           chr(9)   buf_temp_line-data.qnty
     1178           chr(9)   buf_temp_line-data.price
     1179           chr(9)   buf_temp_line-data.gds_name1
     1180           chr(9)   buf_temp_line-data.qnty1
     1181           chr(9)   buf_temp_line-data.price1
     1182           chr(9)   buf_temp_line-data.sum
     1183           chr(9)   buf_temp_line-data.last_date
     1184           chr(10)
     1185       .
     1186   end.
     1187   end procedure.
     1188   procedure r-fasxl-run-excel :
     1189   define input parameter p-header-filename    as character        no-undo.
     1190   define input parameter p-data-filename      as character        no-undo.
     1191       define variable v-template-file-name    as character    no-undo.
     1192       define variable v-vb-file-name          as character    no-undo.
     1193       define buffer buf_temp-param for temp-param .
     1194   do
     1195   for buf_temp-param
     1196   on error undo, return error
     1197   :
     1198       create buf_temp-param.
     1199       assign
     1200           v-template-file-name    = search( "exe/fas_97.xlt" )
     1201           v-vb-file-name          = search( "exe/t_97.bas")
     1202       .
     1203       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     1204           message  "Ошибка имени файла шаблона." view-as alert-box error.
     1205       end.
     1206       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     1207           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     1208       end.
     1209       run paramls-write in this-procedure (
     1210             input "template":U
     1211           , input "template-file-name":U
     1212           , input v-template-file-name
     1213       ).
     1214       run paramls-write in this-procedure (
     1215             input "template":U
     1216           , input "vb-file-name":U
     1217           , input v-vb-file-name
     1218       ).
     1219       run paramls-write in this-procedure (
     1220             input "data":U
     1221           , input "data-header-filename":U
     1222           , input p-header-filename
     1223       ).
     1224       run paramls-write in this-procedure (
     1225             input "data":U
     1226           , input "data-filename":U
     1227           , input p-data-filename
     1228       ).
     1229       run gbl/macroxlt.p (
     1230           input-output table buf_temp-param
     1231       ) no-error.
     1232       if error-status :error
     1233       then do:
     1234           message
     1235                    vss-workfile vss-revision vss-description
     1236               skip(1)
     1237               skip "Ошибка создания файла Excel."
     1238               skip return-value
     1239               skip trim(error-status :get-message(1))
     1240                    trim(error-status :get-message(2))
     1241                    trim(error-status :get-message(3))
     1242           view-as alert-box error.
     1243           undo, return error .
     1244       end.
     1245   end.
     1246   end procedure.
     1247   define variable g#quest-print   as logical      no-undo.
     1248   define variable g#log           as logical      no-undo.
