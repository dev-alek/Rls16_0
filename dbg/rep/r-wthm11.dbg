     1958       .
     1959      run fmtcli-get-bank in this-procedure (
     1960             input p-host-obj-code
     1961           , input p-obj-type
     1962           , input p-obj-code
     1963           , input p-curr-code
     1964       ).
     1965       assign
     1966           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1967           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1968           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1969           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
