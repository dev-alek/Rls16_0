     3491         END.
     3492         OTHERWISE DO:
     3493            assign
     3494               v-torgconf-main-buh  = "":U
     3495            .
     3496         END.
     3497         END CASE.
     3498      end.
     3499      if v-torgconf-outR = "no_print"
     3500         then do:
     3501            assign
     3502               v-torgconf-main-boss = ""
     3503               v-torgconf-main-boss-post = ""
     3504            .
     3505         end.
     3506      if v-torgconf-outR = "ruk_firm"
