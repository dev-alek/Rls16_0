     1179   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1180   define new global shared variable g#trdcalib as handle no-undo.
     1181   procedure wthcattr-sprcli :
     1182   define input parameter parparentproc  as widget-handle no-undo.
     1183   define input parameter p-mode  as character no-undo.
     1184   define input-output parameter p-value as character no-undo .
     1185   define output parameter p-setted as logical no-undo .
     1186     DEFINE VARIABLE v-value as character no-undo .
     1187     define variable v-cli-type as character no-undo .
     1188     define variable v-cli-code as integer no-undo .
     1189     define buffer buf_clients   for ub.clients.
     1190     define variable v_rid as character no-undo.
     1191     define variable ref-rec as recid no-undo .
     1192     do
     1193     on error undo, return error
     1194     :
     1195         v-value = p-value.
     1196      if p-value <> '':U then do:
     1197       assign
     1198       v-cli-type = substring(p-value, 1, 3)
     1199       v-cli-code = integer(substring(p-value, 4))
     1200       no-error.
     1201       if error-status:error then do:
     1202         assign
     1203         v-cli-type = '':U
     1204         v-cli-code = 0
     1205         .
     1206       end.
     1207      end.
     1208      FIND FIRST buf_clients NO-LOCK WHERE
     1209               buf_clients.obj-type = v-cli-type AND
     1210               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1211      IF available(buf_clients) then do:
     1212       run ref/cli-all.w (
     1213                   input parparentproc
     1214                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1215                  ,input v-cli-type
     1216                  ,input 'все':U
     1217                  ,input 'все':U
     1218                  ,input RECID( buf_clients )
     1219                  ,input ",,,,,,NO"
     1220                  ,input ?
     1221                  ,OUTPUT v_rid ).
     1222     END.
     1223     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1224       run ref/cli-all.w (
     1225                    input parparentproc
     1226                   ,INPUT "b-sel":U
     1227                  ,input  v-cli-type
     1228                  ,input 'все':U
     1229                  ,input 'текущие':U
     1230                  ,input ?
     1231                  ,input ",,,,,,NO"
     1232                  ,input ?
     1233                  ,OUTPUT v_rid ).
     1234     END.
     1235     else do:
     1236       message
     1237       if p-value = "":U then 'Атрибут не задан!'
     1238       else substitute('Не найден клиент &1',p-value)
     1239       view-as alert-box warning.
     1240     end.
     1241     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1242       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1243       IF ERROR-STATUS:ERROR THEN DO:
     1244           RETURN NO-APPLY.
     1245       END.
     1246       FIND FIRST buf_clients NO-LOCK WHERE
     1247                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1248       IF AVAIL buf_clients THEN DO:
     1249         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1250       end.
     1251     end.
     1252     if v-value <> p-value then do:
     1253       p-value = v-value.
     1254       p-setted = yes.
     1255     end.
     1256     end.
     1257   end procedure.
     1258     define new global shared variable g#wthcalib as handle no-undo.
     1259   procedure torgconf-read :
     1260   do
     1261   on error undo, return error
     1262   :
     1263       define input parameter p-form-name  as character    no-undo.
     1264       define input parameter p-host-code  as integer      no-undo.
     1265       define input parameter p-obj-type   as character    no-undo.
     1266       define input parameter p-obj-code   as integer      no-undo.
     1267       define variable v-outdate   as character     no-undo.
     1268       define variable v-outares   as character     no-undo.
     1269       define variable v-outsend   as character     no-undo.
     1270       define variable v-outasend  as character     no-undo.
     1271       define variable v-outprops  as character     no-undo.
     1272       define variable v-outnum    as character     no-undo.
     1273       define variable v-outprim   as character     no-undo.
     1274       define variable v-outdisc   as character     no-undo.
     1275       define variable v-outsubs   as character     no-undo.
     1276       define variable v-outrecv   as character     no-undo.
     1277       define variable v-outegrp   as character     no-undo.
     1278       define variable v-outt12    as character     no-undo.
     1279       define variable v-outappr   as character     no-undo.
     1280       define variable v-outrubl   as character     no-undo.
     1281       define variable v-outhold   as character     no-undo.
     1282       define variable v-outobj    as character     no-undo.
     1283       define variable v-outexlst  as character     no-undo.
     1284       define variable v-outprncd  as character     no-undo.
     1285       define variable v-par-type  as character     no-undo.
     1286       define variable v-outogr    as character     no-undo.
     1287       define variable v-outR      as character     no-undo.
     1288       define variable v-outB      as character     no-undo.
     1289       define variable v-outC      as character     no-undo.
     1290       assign
     1291           v-torgconf-outdate  = no
     1292           v-torgconf-outnum   = no
     1293           v-torgconf-outprim  = no
     1294           v-torgconf-outdisc  = no
     1295           v-torgconf-outsubs  = no
     1296           v-torgconf-outrecv  = no
     1297           v-torgconf-outegrp  = no
     1298           v-torgconf-outt12   = no
     1299           v-torgconf-outappr  = no
     1300           v-torgconf-outrubl  = no
     1301           v-torgconf-outhold  = no
     1302           v-torgconf-outobj   = no
     1303           v-torgconf-outexlst = no
     1304           v-torgconf-outexpas = "":U
     1305           v-torgconf-outprncd = yes
     1306           v-torgconf-outares  = no
     1307           v-torgconf-outsend  = no
     1308           v-torgconf-outasend  = no
     1309           v-torgconf-outprops  = no
     1310           v-form-name          = p-form-name
     1311       .
     1312   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   empty temp-table thbjattr_thbj-attr.
     1314   run adm/shattri.p (
     1315      input "get":U
     1316     ,input ''
     1317     ,input 0
     1318     ,input 'prt-glob':U
     1319     ,input  ""
     1320     ,output v-value-character
     1321     ,output v-value-date
     1322     ,output v-value-decimal
     1323     ,output v-value-integer
     1324     ,output v-value-logical
     1325     ,output par-type
     1326     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1327     ) no-error .
     1328   for each thbjattr_thbj-attr :
     1329       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1330       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1331       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1332   end.
     1333   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1334   empty temp-table thbjattr_thbj-attr.
     1335   run adm/shattri.p (
     1336      input "get":U
     1337     ,input p-obj-type
     1338     ,input p-obj-code
     1339     ,input 'prt-obj':U
     1340     ,input  ""
     1341     ,output v-value-character
     1342     ,output v-value-date
     1343     ,output v-value-decimal
     1344     ,output v-value-integer
     1345     ,output v-value-logical
     1346     ,output par-type
     1347     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1348     ) no-error .
     1349   for each thbjattr_thbj-attr :
     1350       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1351       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1352       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1353       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1354       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1355       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1356       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
     1357       if thbjattr_thbj-attr.prop-code = 'outt12':U   then v-outt12   =  thbjattr_thbj-attr.property-value-character .
     1358       if thbjattr_thbj-attr.prop-code = 'outappr':U  then v-outappr  =  thbjattr_thbj-attr.property-value-character .
     1359       if thbjattr_thbj-attr.prop-code = 'outrubl':U  then v-outrubl  =  thbjattr_thbj-attr.property-value-character .
     1360       if thbjattr_thbj-attr.prop-code = 'outhold':U  then v-outhold  =  thbjattr_thbj-attr.property-value-character .
     1361       if thbjattr_thbj-attr.prop-code = 'outobj':U   then v-outobj   =  thbjattr_thbj-attr.property-value-character .
     1362       if thbjattr_thbj-attr.prop-code = 'outsend':U  then v-outsend  =  thbjattr_thbj-attr.property-value-character .
     1363       if thbjattr_thbj-attr.prop-code = 'outasend':U then v-outasend =  thbjattr_thbj-attr.property-value-character .
     1364       if thbjattr_thbj-attr.prop-code = 'outogr':U   then v-torgconf-outogr   =  thbjattr_thbj-attr.property-value-character .
     1365       if thbjattr_thbj-attr.prop-code = 'outR':U     then v-torgconf-outR     =  thbjattr_thbj-attr.property-value-character .
