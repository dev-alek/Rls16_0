     2027           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2028           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2029           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2030           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2031           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2032           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2033           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2034       .
     2035   end.
     2036   end procedure.
     2037   procedure torgconf-get-holdfirm-code :
     2038   define input parameter p-obj-type   as character        no-undo.
     2039   define input parameter p-obj-code   as integer          no-undo.
     2040   define output parameter p-firm-code as integer          no-undo.
     2041       define variable v-firm-code-str     as character    no-undo.
     2042       define variable v-par-type          as character    no-undo.
     2043       define buffer buf_clients       for ub.clients.
     2044   do
     2045   for buf_clients
     2046   on error undo, return error
     2047   :
     2048       run gbl/clntat-v.p (
     2049             input p-obj-type
     2050           , input p-obj-code
     2051           , input 'holdfirm-code':U
     2052           , output v-firm-code-str
     2053           , output v-par-type
     2054       ).
     2055       assign
     2056           p-firm-code = integer( v-firm-code-str )
     2057       no-error.
     2058       if error-status :error
     2059       then do:
     2060           message
     2061               "Неверно задан код фирмы для печати накладных."
     2062           view-as alert-box warning.
     2063           assign
     2064               p-firm-code = 0
     2065           .
     2066       end.
     2067       else do:
     2068           find first buf_clients no-lock
     2069                where buf_clients.obj-type = 'орг':U
     2070                  and buf_clients.obj-code = p-firm-code
     2071           no-error.
     2072           if not available buf_clients
     2073           then do:
     2074               message
     2075                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2076                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2077               view-as alert-box warning.
     2078               assign
     2079                   p-firm-code = 0
     2080               .
     2081           end.
     2082       end.
     2083   end.
     2084   end procedure.
     2085   procedure torgconf-get-post-head:
     2086   define input  parameter p-obj-type             as character        no-undo.
     2087   define input  parameter p-obj-code             as integer          no-undo.
     2088   define output parameter p-torgconf-post-head   as character        no-undo.
     2089      define variable v-host-code         as integer      no-undo.
     2090      define buffer buf_sysconf     for ub.sysconf.
     2091        assign
     2092         p-torgconf-post-head  = ""
     2093        .
     2094   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2096     (input  p-obj-type
     2097     ,input  p-obj-code
     2098     ,output v-host-code
     2099     )  .
     2100      find first buf_sysconf no-lock
     2101      where buf_sysconf.host-code = v-host-code
     2102      no-error.
     2103      if available buf_sysconf
     2104      then do:
     2105         assign
     2106            p-torgconf-post-head = buf_sysconf.head-position
     2107         .
     2108      end.
     2109   end procedure.
     2110   procedure torgconf-get-storekeeper:
     2111   define input  parameter p-wrkr                   as integer          no-undo.
     2112   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2113   define output parameter p-torgconf-post          as character        no-undo.
     2114      define buffer buf_sysconf     for ub.sysconf.
     2115      define buffer buf_person      for ub.person.
     2116      define buffer buf_shop        for ub.shop .
     2117      define buffer buf_store       for ub.store .
     2118      if v-torgconf-outC = "no_print"
     2119      then do:
     2120         assign p-torgconf-post = ""
     2121                p-torgconf-wrkr-name = ""
     2122                .
     2123      end.
     2124      if v-torgconf-outC = "clad_doc"
     2125      then do:
     2126         run rep/get-psn.p
     2127               (input  p-wrkr
     2128               ,output p-torgconf-wrkr-name
     2129               ) .
     2130         find first buf_person no-lock
     2131         where buf_person.psn-code = p-wrkr
     2132         no-error.
     2133         if available buf_person
     2134         then do:
     2135           p-torgconf-post = buf_person.position.
     2136         end.
     2137         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2138         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2139      end.
     2140      if v-torgconf-outC = "clad_obj"
     2141      then do:
     2142         CASE v-torgconf-self-obj-type:
     2143         WHEN 'маг':U
     2144         THEN DO:
     2145            find first buf_shop no-lock
     2146            where buf_shop.obj-code = v-torgconf-self-obj-code
     2147            .
     2148            assign
     2149               p-torgconf-wrkr-name = buf_shop.store-man
     2150               p-torgconf-post = ""
     2151            .
     2152            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2153         END.
     2154         WHEN 'скл':U
     2155         THEN DO:
     2156            find first buf_store no-lock
     2157            where buf_store.obj-code = v-torgconf-self-obj-code
     2158            .
     2159            assign
     2160               p-torgconf-wrkr-name = buf_store.store-man
     2161               p-torgconf-post = ""
     2162            .
     2163            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2164         END.
     2165         OTHERWISE DO:
     2166            assign
     2167               p-torgconf-post = "":U
     2168               p-torgconf-wrkr-name = "":U
     2169            .
     2170         END.
     2171         END CASE.
     2172      end.
     2173    end procedure.
     2174   procedure torgconf-get-form-header :
     2175   define input parameter p-for-inverse    as logical          no-undo.
     2176   define input parameter p-doc-code       as character        no-undo.
     2177   define input parameter p-print-doc      as logical          no-undo.
     2178   define input parameter p-doc-date       as date             no-undo.
     2179   define input parameter p-fact-date      as date             no-undo.
     2180   define input parameter p-doc-type       as character        no-undo.
     2181   define input parameter p-status_        as character        no-undo.
     2182   define input parameter p-reverse        as logical          no-undo.
     2183   define input parameter p-sf-par         as logical          no-undo.
     2184       define variable v-attr-type         as character    no-undo.
     2185       define variable v-doc-code-standard as logical      no-undo.
     2186       define variable v-doc-date-standard as logical      no-undo.
     2187       define variable v-par-consignee-addres  as character    no-undo.
     2188       define variable v-host-code         as integer      no-undo.
     2189       define variable v-dcode-attr        as character    no-undo.
     2190       define variable v-ddate-attr        as character    no-undo.
     2191       define variable v-doc-date          as character    no-undo.
     2192       define variable v-doc-code          as character    no-undo.
     2193       define variable v-par-type          as character    no-undo.
     2194       define variable v-attr              as character    no-undo.
     2195       define buffer buf_firm          for ub.firm .
     2196       define buffer buf_clients       for ub.clients .
     2197       define buffer buf_sysconf       for ub.sysconf .
     2198       define buffer buf_shop          for ub.shop .
     2199       define buffer buf_store         for ub.store .
