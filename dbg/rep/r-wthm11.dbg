     1837   procedure torgconf-get-sup-param :
     1838   define input parameter p-obj-type           as character        no-undo.
     1839   define input parameter p-obj-code           as integer          no-undo.
     1840   define input parameter p-curr-code          as integer          no-undo.
     1841       define variable v-host-code    as integer      no-undo.
     1842       define variable v-par-type     as character    no-undo.
     1843   do
     1844   on error undo, return error
     1845   :
     1846       assign
     1847          v-torgconf-sup-host-code = v-host-code
     1848       .
     1849       if v-torgconf-sup-host-code = 0
     1850       then do:
     1851           assign
     1852               v-torgconf-sup-host-name           = "":U
     1853               v-torgconf-sup-host-addres         = "":U
     1854               v-torgconf-sup-host-post-addres    = "":U
     1855               v-torgconf-sup-host-phone          = "":U
     1856               v-torgconf-sup-host-inn            = "":U
     1857               v-torgconf-sup-host-kpp            = "":U
     1858               v-torgconf-sup-host-okpo           = "":U
     1859               v-torgconf-sup-host-egrip-date     = "":U
     1860               v-torgconf-sup-host-egrip-num      = "":U
     1861           .
     1862       end.
     1863       else do:
     1864           run fmtcli-get-client in this-procedure (
     1865                 input 'орг':U
     1866               , input v-torgconf-sup-host-code
     1867           ).
     1868           assign
     1869               v-torgconf-sup-host-name        = v-fmtcli-name
     1870               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1871               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1872               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1873               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1874               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1875               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1876               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1877           .
     1878           run gbl/clntat-v.p (
     1879                 input 'орг':U
     1880               , input v-torgconf-sup-host-code
     1881               , input 'egrip-date':U
     1882               , output v-torgconf-sup-host-egrip-date
     1883               , output v-par-type
     1884           ).
     1885           run gbl/clntat-v.p (
     1886                 input 'орг':U
     1887               , input v-torgconf-sup-host-code
     1888               , input 'egrip-num':U
     1889               , output v-torgconf-sup-host-egrip-num
     1890               , output v-par-type
     1891           ).
     1892           run fmtcli-get-bank in this-procedure (
     1893                 input v-host-code
     1894               , input 'орг':U
     1895               , input v-torgconf-sup-host-code
     1896               , input p-curr-code
     1897           ).
     1898       end.
     1899       assign
     1900           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1901           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1902           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1903           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1904           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1905           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1906           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1907           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1908       .
     1909       assign
     1910           v-torgconf-sup-obj-type = p-obj-type
     1911           v-torgconf-sup-obj-code = p-obj-code
     1912       .
     1913       if trim(p-obj-type) <> ""
     1914       and p-obj-code <> 0
     1915       then do:
     1916       run fmtcli-get-client in this-procedure (
     1917             input p-obj-type
     1918           , input p-obj-code
     1919       ).
     1920       assign
     1921           v-torgconf-sup-obj-name        = v-fmtcli-name
     1922           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1923           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1924           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1925           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1926           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1927           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1928       .
     1929      end.
     1930      end.
     1931   end procedure.
     1932   procedure torgconf-get-cli-param :
     1933   define input parameter p-host-obj-code      as integer          no-undo.
     1934   define input parameter p-obj-type           as character        no-undo.
