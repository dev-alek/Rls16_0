     3842            no-error.
     3843            if available buf_person
     3844            then do:
     3845               v-torgconf-ogr-post = buf_person.position.
     3846            end.
     3847            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3848            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3849         end.
     3850      end.
