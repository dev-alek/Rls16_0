        1   block-level on error undo, throw.
        2   DEFINE INPUT PARAMETER p-parent-proc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE INPUT PARAMETER p-doc-code    AS character     NO-UNDO.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-wthm11.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-wthm11.p $":U .
        9   define variable vss-description as character no-undo init "Печать требования-накладной (М-11)".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define   shared variable g#auto as logical no-undo.
       71   define   shared variable g#news as logical no-undo.
       72   define   shared variable g#oxml as logical no-undo.
       73   define   shared variable g#esys as logical no-undo.
       74   define   shared variable g#news-source-db as integer no-undo.
       75   define   shared variable g#esys-source-esys as integer no-undo.
       76   define   shared variable g#db-num as integer   no-undo .
       77   define   shared variable g#userid as character no-undo .
       78   define   shared variable g#passwd as character no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       81   define  shared variable RepPathName        as character no-undo .
       82   define  shared variable PrintRubl          as logical   no-undo .
       83   define variable g#report-num    as integer      no-undo.
       84   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       85   define  stream PrnLibStream.
       86   procedure prn-lib-prn-file :
       87     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
       88     define input parameter p-DIsabledoptions as integer no-undo .
       89     define variable v-report-name as character no-undo .
       90     define variable v-user-action as character no-undo .
       91     define variable v-printed     as logical   no-undo .
       92     define variable v-exist       as logical   no-undo .
       93     do
       94       on error undo, return error
       95       :
       96       run prn-lib-get-report-name  in this-procedure (
       97         input parParentProc
       98         ,output v-report-name
       99         ).
      100   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      101   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      102     (input  v-report-name
      103     ,input  2
      104     ,output v-exist
      105     )  .
      106       if NOT v-exist then
      107       DO:
      108         Message
      109           "Нет заданий на печать ! "
      110           view-as alert-box .
      111         Return  .
      112       End.
      113       run gbl/prnfilen.w
      114         (input  ""
      115         ,input  p-DisabledOptions
      116         ,input  string(v-report-name )
      117         ,input  7
      118         ,output v-user-action
      119         ,output v-printed
      120         ) .
      121       if v-printed then
      122       do:
      123         return "YES" .
      124       end.
      125       else
      126       do:
      127         return "NO" .
      128       end.
      129     end.
      130   end procedure.
      131   procedure prn-lib-open-stream :
      132     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      133     define input parameter p-page-size    as integer no-undo .
      134     define input parameter p-is-stream    as logical no-undo .
      135     define input parameter p-append       as logical no-undo .
      136     define variable v-report-name as character no-undo .
      137     do
      138       on error undo, return error
      139       :
      140       run prn-lib-get-report-name  in this-procedure (
      141         input parParentProc
      142         ,output v-report-name
      143         ).
      144       if p-is-stream then
      145       do:
      146         if p-append then
      147         do:
      148           output stream PrnLibStream to value( v-report-name )
      149             page-size value(p-page-size) append .
      150         end.
      151         if not p-append then
      152         do:
      153           output stream PrnLibStream to value( v-report-name )
      154             page-size value(p-page-size) .
      155         end.
      156       end.
      157       if not p-is-stream then
      158       do:
      159         if p-append then
      160         do:
      161           output to value( v-report-name )
      162             page-size value(p-page-size) append .
      163         end.
      164         if not p-append then
      165         do:
      166           output to value( v-report-name )
      167             page-size value(p-page-size) .
      168         end.
      169       end.
      170     end.
      171   end procedure.
      172   procedure prn-lib-open-exp :
      173     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      174     define input parameter p-is-stream    as logical no-undo .
      175     define input parameter p-is-append    as logical no-undo .
      176     define output parameter p-ReportFileName as char init "report" no-undo.
      177     define output parameter p-process as logical no-undo .
      178     define variable glog as logical no-undo .
      179     do
      180       on error undo, return error
      181       :
      182       SYSTEM-DIALOG GET-FILE p-ReportFileName
      183         TITLE      "Укажите путь"
      184         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      185         ASK-OVERWRITE
      186         CREATE-TEST-FILE
      187         SAVE-AS
      188         USE-FILENAME
      189         DEFAULT-EXTENSION "txt"
      190         UPDATE glog
      191         .
      192       if not glog then  return.
      193       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      194       if p-is-stream then
      195       do:
      196         if p-is-append then
      197         do:
      198           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      199         end.
      200         else
      201         do:
      202           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      203         end.
      204       end.
      205       else
      206       do:
      207         if p-is-append then
      208         do:
      209           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      210         end.
      211         else
      212         do:
      213           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      214         end.
      215       end.
      216       p-process = yes.
      217     end.
      218   end procedure.
      219   procedure prn-lib-get-report-name :
      220     define input parameter parParentProc  as widget-handle no-undo.
      221     define output parameter p-report-name as character no-undo .
      222     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      223   end procedure.
      224   procedure prn-lib-reportviewer-report-name :
      225     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      226     define input parameter p-report-name-html as character no-undo .
      227     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      228   end procedure.
      229   procedure prn-lib-reportviewer :
      230     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      231     define input parameter p-report-name-html as character no-undo .
      232     define input parameter p-param        as character no-undo .
      233     define variable v-excel           as character no-undo init 'TRUE' .
      234     define variable v-value-character as character no-undo .
      235     define variable v-value-integer   as character no-undo .
      236     define variable v-value-date      as date      no-undo .
      237     define variable v-value-decimal   as decimal   no-undo .
      238     define variable rep-excel         as logical   no-undo .
      239     define variable excel-string      as character no-undo .
      240     define variable v-param-type      as character no-undo .
      241     define variable v-tth             as handle    no-undo .
      242     run adm/shattri.p (
      243       input "get":U
      244       ,input  ""
      245       ,input  0
      246       ,input  'report-glob':U
      247       ,input  'rep-excel':U
      248       ,output v-value-character
      249       ,output v-value-date
      250       ,output v-value-decimal
      251       ,output v-value-integer
      252       ,output rep-excel
      253       ,output v-param-type
      254       ,INPUT-OUTPUT table-handle v-tth
      255       )  .
      256     if rep-excel then v-excel = "TRUE" .
      257     else v-excel = "FALSE" .
      258     if p-param eq ""
      259     then
      260        p-param = "EXCEL:" + v-excel.
      261     else
      262        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      263     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      264   end procedure.
      265   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      266   define variable v-waitfram-action01         as character   no-undo .
      267   define variable v-waitfram-action02         as character   no-undo .
      268   define variable v-waitfram-action03         as character   no-undo .
      269   define variable mWaitFramTextBeg            as character   no-undo.
      270   define variable mWaitFramTextEnd            as character   no-undo.
      271   define variable mWaitFramView               as logical     no-undo.
      272   define variable mWaitProcEvent              as logical     no-undo init yes.
      273   define variable mWaitFramInterval           as integer     no-undo init 1 .
      274   define variable mWaitFramStop               as logical     no-undo.
      275   define variable mWaitFramStopUser           as logical     no-undo.
      276   define variable mWaitFramStopTimeOut        as logical     no-undo.
      277   define variable mWaitFramStartProc          as datetime-tz no-undo.
      278   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      279   define button B-WaitFramStop auto-end-key
      280        label "Стоп"
      281        size 10 by 1 tooltip "Остоновить процесс".
      282   define button B-viewProcInfo
      283        label "Информация"
      284        size 15 by 1 tooltip "Информация о процесс".
      285   define frame waitfram
      286     v-waitfram-action01 format "x(72)" no-label skip
      287     v-waitfram-action02 format "x(72)" no-label skip
      288     v-waitfram-action03 format "x(72)" no-label skip
      289     B-viewProcInfo
      290     B-WaitFramStop at row 4 col 30
      291     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      292     .
      293   define new global shared variable mBatchMode as logical no-undo init ?.
      294   define variable mFramBachModHandle as handle no-undo.
      295   mFramBachModHandle = frame waitfram:handle.
      296   define variable mFameOldVis as logical no-undo.
      297   define variable mVisCUrentVin as logical no-undo.
      298   if session:batch-mode
      299   then
      300      mBatchMode = yes.
      301   if mBatchMode = ? then do:
      302     mVisCUrentVin = current-window:visible.
      303     mFameOldVis = mFramBachModHandle:visible.
      304     mFramBachModHandle:visible  = yes.
      305     mBatchMode = mFramBachModHandle:visible ne yes.
      306     mFramBachModHandle:visible = mFameOldVis.
      307     current-window:visible = mVisCUrentVin.
      308   end.
      309    if  log-manager:logfile-name ne ?
      310     then DO:
      311         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      312         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      313         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      314     end.
      315   on choose of B-WaitFramStop in frame waitfram
      316   do:
      317     mWaitFramStop = yes.
      318     mWaitFramStopUser = yes.
      319   end.
      320   function waitfram-check-timeout returns logical():
      321      define variable vtime as int64 no-undo.
      322      if mWaitFramStopTimeOut
      323      then
      324         return yes.
      325      vtime = ( now - mWaitFramStartProc ) / 1000 .
      326      if     mWaitFramTimeOut ne ?
      327         and mWaitFramTimeOut ne 0
      328         and mWaitFramTimeOut lt vtime
      329      then do:
      330         mWaitFramStopTimeOut = yes.
      331      end.
      332      return mWaitFramStopTimeOut.
      333   end.
      334   procedure waitfram-hide :
      335     if not session:batch-mode
      336     then do
      337     on error undo, return error return-value
      338     :
      339       pause 0 before-hide .
      340       if not mBatchMode then
      341         hide frame waitfram .
      342     if     not mWaitFramView
      343        and mWaitProcEvent
      344     then
      345       process events .
      346     end.
      347   end procedure.
      348   procedure waitfram-show :
      349     define input  parameter p-message as character no-undo .
      350     define variable v-left-margin as integer   no-undo .
      351     if not session:batch-mode
      352     then do
      353     on error undo, return error return-value
      354     :
      355       if length(p-message) <= 70 then do:
      356         assign
      357           v-left-margin = integer((70 - length(p-message)) / 2)
      358         .
      359         assign
      360           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      361         .
      362         assign
      363           v-waitfram-action01 = " "
      364           v-waitfram-action02 = " "
      365                                    + fill(" ", v-left-margin)
      366                                    + p-message
      367           v-waitfram-action03 = " "
      368         .
      369       end.
      370       else do:
      371         define variable vRindex1 as integer no-undo.
      372         define variable vRindex2 as integer no-undo.
      373         vRindex1 = r-index(p-message," ",70).
      374         if vRindex1 = 0
      375         then
      376            vRindex1 = 70.
      377         if length(p-message)  <= vRindex1 + 70 then do:
      378           assign
      379             v-waitfram-action01 = " "
      380             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      381             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      382           .
      383         end.
      384         else do:
      385           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      386           if vRindex2 <= vRindex1
      387           then
      388              vRindex2 = vRindex1 + 70.
      389           assign
      390             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      391             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      392             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      393           .
      394         end.
      395       end.
      396       B-viewProcInfo:visible   in frame waitfram = no.
      397       B-viewProcInfo:sensitive in frame waitfram = no.
      398       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      399       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      400       if  (   mWaitFramView
      401          or  mWaitProcEvent)
      402          and not mBatchMode
      403       then
      404          display
      405             v-waitfram-action01 skip
      406             v-waitfram-action02 skip
      407             v-waitfram-action03 skip
      408          with frame waitfram .
      409       if     mWaitFramView
      410          then do:
      411             if     mWaitFramInterval ne ?
      412                and not mBatchMode
      413             then
      414                wait-for go of frame waitfram pause mWaitFramInterval.
      415          end.
      416          else
      417             if     mWaitProcEvent
      418                and not mBatchMode
      419             then
      420                process events .
      421     end.
      422   end procedure.
      423      procedure waitfram-show-this:
      424         define input  parameter iInterval as int64 no-undo.
      425         define variable vtime as int64 no-undo.
      426         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      427         mWaitFramInterval = iInterval.
      428         run waitfram-show (substitute("&1&2 &3&4" ,
      429                                       mWaitFramTextBeg ,
      430                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      431                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      432                                       mWaitFramTextEnd
      433                                      )
      434                           ).
      435      end.
      436      procedure WaitFramRunPause:
      437         define input  parameter iInterval as dec no-undo.
      438         define variable vStart  as datetime-tz no-undo.
      439         define variable vend    as datetime-tz no-undo.
      440         define variable vint as int64 no-undo.
      441         define variable vOk as logical no-undo.
      442         vStart = now.
      443         vend   = vStart.
      444         publish "WaitFramPause" (iInterval,output vOk).
      445         vend   =  now.
      446         vint = vend - vStart.
      447         vint = iInterval - vint / 1000.
      448         if     not mWaitFramStop
      449            and (   vint > 0
      450                 or (    not vOk
      451                     and iInterval eq ?
      452                     )
      453                 )
      454         then
      455            run waitfram-show-this (iInterval).
      456         vend   =  now.
      457         vint = vend - vStart.
      458         vint = iInterval - vint / 1000.
      459         if     not mWaitFramStop
      460            and vint > 0
      461         then do:
      462            run gbl/pause.p (vint * 1000).
      463         end.
      464         if iInterval ne ?
      465         then
      466            publish "WaitFramStop".
      467         waitfram-check-timeout().
      468      end.
      469      procedure WaitFramWaitFor:
      470         define input  parameter iInterval as dec no-undo.
      471         assign
      472            mWaitFramStartProc   = now
      473            mWaitFramStopUser    = no
      474            mWaitFramStopTimeOut = no
      475         .
      476         block-wait:
      477         do while not mWaitFramStop:
      478            run WaitFramRunPause (iInterval).
      479            if  waitfram-check-timeout()
      480            then do:
      481               leave block-wait.
      482            end.
      483         end.
      484         run waitfram-hide.
      485      end.
      486   procedure waitfram-join :
      487     define input  parameter p-line-1  as character no-undo .
      488     define input  parameter p-line-2  as character no-undo .
      489     define input  parameter p-line-3  as character no-undo .
      490     define output parameter p-message as character no-undo .
      491     do
      492     on error undo, return error return-value
      493     :
      494       assign
      495         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      496                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      497                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      498       .
      499     end.
      500   end procedure.
      501   function waitfram-join-function returns character
      502     (input p-line-1 as character
      503     ,input p-line-2 as character
      504     ,input p-line-3 as character
      505     ).
      506     define variable v-message as character no-undo .
      507     run waitfram-join in this-procedure
      508       (input  p-line-1
      509       ,input  p-line-2
      510       ,input  p-line-3
      511       ,output v-message
      512       ) .
      513     return v-message .
      514   end function .
      515   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      516     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      517     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      518     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      519   END FUNCTION.
      520   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      521     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      522     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      523     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      524   END FUNCTION.
      525   PROCEDURE get-number-grade :
      526     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      527     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      528     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      529     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      530     DO ON ERROR UNDO, RETURN ERROR :
      531       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      532       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      533       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      534       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      535                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      536       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      537     END.
      538   END PROCEDURE.
      539   PROCEDURE conv-sum-to-word :
      540     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      541     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      542     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      543     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      544     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      545     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      546     DO ON ERROR UNDO, RETURN ERROR :
      547       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      548       IF ERROR-STATUS :ERROR THEN DO:
      549         ASSIGN p-res = ?.
      550         UNDO, RETURN ERROR.
      551       END.
      552       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      553         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      554         IF jj < 15 THEN DO:
      555           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      556           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      557              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      558           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      559              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      560              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      561             IF jj = 12 THEN DO:
      562               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      563             END.       ELSE DO:
      564               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      565             END.
      566           END.
      567           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      568                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      569                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      570                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      571              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      572           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      573         END.
      574         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      575           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      576           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      577           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      578           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      579           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      580         END.                                        ELSE DO:
      581           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      582         END.
      583         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      584         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      585         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      586       END.
      587       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      588       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      589       ASSIGN p-res = TRIM( OutSum ).
      590     END.
      591   END PROCEDURE.
      592   define variable vss-include-info4 as character format "X(65)" no-undo
      593   initial "@(#)$Workfile$ $Revision$".
      594   define variable v-fmtcli-name          as character    no-undo.
      595   define variable v-fmtcli-engl-name     as character    no-undo.
      596   define variable v-fmtcli-addres        as character    no-undo.
      597   define variable v-fmtcli-post-addres   as character    no-undo.
      598   define variable v-fmtcli-full-addres   as character    no-undo.
      599   define variable v-fmtcli-phone         as character    no-undo.
      600   define variable v-fmtcli-inn           as character    no-undo.
      601   define variable v-fmtcli-kpp           as character    no-undo.
      602   define variable v-fmtcli-okpo          as character    no-undo.
      603   define variable v-fmtcli-country       as character    no-undo.
      604   define variable v-fmtcli-city          as character    no-undo.
      605   define variable v-fmtcli-index         as character    no-undo.
      606   define variable v-fmtcli-schet-exists  as logical      no-undo.
      607   define variable v-fmtcli-bank-exists   as logical      no-undo.
      608   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      609   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      610   define variable v-fmtcli-bank-bik      as character    no-undo.
      611   define variable v-fmtcli-bank-name     as character    no-undo.
      612   define variable v-fmtcli-bank-addres   as character    no-undo.
      613   define variable v-fmtcli-bank-city     as character    no-undo.
      614   procedure fmtcli-get-bank :
      615   define input parameter p-host-code      as integer          no-undo.
      616   define input parameter p-obj-type       as character        no-undo.
      617   define input parameter p-obj-code       as integer          no-undo.
      618   define input parameter p-curr-code      as integer          no-undo.
      619       define buffer buf_fin-schet     for ub.fin-schet.
      620       define buffer buf_fin-bank      for ub.fin-bank.
      621   do
      622   for buf_fin-schet
      623     , buf_fin-bank
      624   on error undo, return error
      625   :
      626       assign
      627           v-fmtcli-schet-exists       = no
      628           v-fmtcli-bank-exists        = no
      629           v-fmtcli-bank-r-schet       = "":U
      630           v-fmtcli-bank-c-schet       = "":U
      631           v-fmtcli-bank-bik           = "":U
      632           v-fmtcli-bank-name          = "":U
      633           v-fmtcli-bank-addres        = "":U
      634           v-fmtcli-bank-city          = "":U
      635       .
      636       search-for-schet:
      637       for each buf_fin-schet no-lock
      638          where buf_fin-schet.host-code = p-host-code
      639            and buf_fin-schet.cli-type  = p-obj-type
      640            and buf_fin-schet.cli-code  = p-obj-code
      641            and buf_fin-schet.curr-code = p-curr-code
      642       on error undo, return error
      643       :
      644           if buf_fin-schet.status_   = 'удал':U
      645           then do:
      646           end.
      647           else do:
      648               assign
      649                   v-fmtcli-schet-exists   = yes
      650                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      651                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      652               .
      653               find first buf_fin-bank no-lock
      654                    where buf_fin-bank.host-code = p-host-code
      655                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      656               no-error.
      657               if available buf_fin-bank
      658               then do:
      659                   assign
      660                       v-fmtcli-bank-exists      = yes
      661                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      662                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      663                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      664                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      665                   .
      666               end.
      667               else do:
      668                   assign
      669                       v-fmtcli-bank-exists    = no
      670                       v-fmtcli-bank-bik       = "":U
      671                       v-fmtcli-bank-name      = "":U
      672                       v-fmtcli-bank-addres    = "":U
      673                       v-fmtcli-bank-city      = "":U
      674                   .
      675               end.
      676               leave search-for-schet.
      677           end.
      678       end.
      679   end.
      680   end procedure.
      681   procedure fmtcli-get-client :
      682   define input parameter p-obj-type       as character    no-undo.
      683   define input parameter p-obj-code       as integer      no-undo.
      684       define variable v-temp-fmtcli-address      as character     no-undo.
      685       define variable v-num-country-city    as integer      no-undo.
      686       define buffer buf_clients   for ub.clients.
      687       define buffer buf_firm      for ub.firm.
      688       define buffer buf_store     for ub.store.
      689       define buffer buf_shop      for ub.shop.
      690       define buffer buf_person    for ub.person.
      691   do
      692   for buf_clients
      693     , buf_firm
      694     , buf_store
      695     , buf_shop
      696     , buf_person
      697   on error undo, return error
      698   :
      699       assign
      700           v-fmtcli-name           = "":U
      701           v-fmtcli-addres         = "":U
      702           v-fmtcli-post-addres    = "":U
      703           v-fmtcli-full-addres    = "":U
      704           v-fmtcli-phone          = "":U
      705           v-fmtcli-inn            = "":U
      706           v-fmtcli-kpp            = "":U
      707           v-fmtcli-okpo           = "":U
      708           v-fmtcli-city           = "":U
      709           v-fmtcli-index          = "":U
      710           v-fmtcli-country        = "":U
      711       .
      712       find first buf_clients no-lock
      713            where buf_clients.obj-type = p-obj-type
      714              and buf_clients.obj-code = p-obj-code
      715       .
      716       assign
      717           v-fmtcli-name = buf_clients.obj-name
      718       .
      719       case buf_clients.obj-type:
      720          when 'орг':U
      721          then do:
      722               find first buf_firm no-lock
      723                    where buf_firm.firm-code = buf_clients.obj-code
      724                    no-error
      725               .
      726               if available buf_firm
      727               then do:
      728                   assign
      729                       v-num-country-city = num-entries( buf_firm.city )
      730                       v-fmtcli-engl-name = buf_firm.engl-name
      731                   .
      732                   if v-num-country-city > 0
      733                   then do:
      734                       assign
      735                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      736                       .
      737                   end.
      738                   if v-num-country-city > 1
      739                   then do:
      740                       assign
      741                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      742                       .
      743                   end.
      744                   run fmtcli-concatenate-strings in this-procedure (
      745                         input v-fmtcli-full-addres
      746                       , input v-fmtcli-country
      747                       , input ", ":U
      748                       , input 50
      749                       , output v-fmtcli-full-addres
      750                   ).
      751                   run fmtcli-concatenate-strings in this-procedure (
      752                         input v-fmtcli-full-addres
      753                       , input v-fmtcli-city
      754                       , input ", ":U
      755                       , input 50
      756                       , output v-fmtcli-full-addres
      757                   ).
      758                   run fmtcli-concatenate-strings in this-procedure (
      759                         input v-fmtcli-full-addres
      760                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      761                       , input ", ":U
      762                       , input 50
      763                       , output v-fmtcli-full-addres
      764                   ).
      765                   run fmtcli-concatenate-strings in this-procedure (
      766                         input v-fmtcli-post-addres
      767                       , input v-fmtcli-country
      768                       , input ", ":U
      769                       , input 50
      770                       , output v-fmtcli-post-addres
      771                   ).
      772                   run fmtcli-concatenate-strings in this-procedure (
      773                         input v-fmtcli-post-addres
      774                       , input v-fmtcli-city
      775                       , input ", ":U
      776                       , input 50
      777                       , output v-fmtcli-post-addres
      778                   ).
      779                   run fmtcli-concatenate-strings in this-procedure (
      780                         input v-fmtcli-post-addres
      781                       , input string( buf_firm.ind )
      782                       , input ", ":U
      783                       , input 50
      784                       , output v-fmtcli-post-addres
      785                   ).
      786                   run fmtcli-concatenate-strings in this-procedure (
      787                         input substring( buf_firm.addres1, 1, 50 )
      788                       , input buf_firm.addres2
      789                       , input " ":U
      790                       , input 50
      791                       , output v-temp-fmtcli-address
      792                   ).
      793                   run fmtcli-concatenate-strings in this-procedure (
      794                         input v-temp-fmtcli-address
      795                       , input substring( buf_firm.addres1, 51, 50 )
      796                       , input " ":U
      797                       , input 50
      798                       , output v-temp-fmtcli-address
      799                   ).
      800                   run fmtcli-concatenate-strings in this-procedure (
      801                         input v-temp-fmtcli-address
      802                       , input substring( buf_firm.addres1, 101, 50 )
      803                       , input " ":U
      804                       , input 50
      805                       , output v-temp-fmtcli-address
      806                   ).
      807                   assign
      808                       v-fmtcli-addres = v-temp-fmtcli-address
      809                   .
      810                   if buf_firm.addres1 <> ?
      811                   then do:
      812                       run fmtcli-concatenate-strings in this-procedure (
      813                             input v-fmtcli-full-addres
      814                           , input v-fmtcli-addres
      815                           , input ", ":U
      816                           , input 0
      817                           , output v-fmtcli-full-addres
      818                       ).
      819                   end.
      820                   run fmtcli-concatenate-strings in this-procedure (
      821                         input substring( buf_firm.post-addr1, 1, 50 )
      822                       , input buf_firm.post-addr2
      823                       , input " ":U
      824                       , input 50
      825                       , output v-fmtcli-post-addres
      826                   ).
      827                   run fmtcli-concatenate-strings in this-procedure (
      828                         input v-fmtcli-post-addres
      829                       , input substring( buf_firm.post-addr1, 51, 50 )
      830                       , input " ":U
      831                       , input 50
      832                       , output v-fmtcli-post-addres
      833                   ).
      834                   run fmtcli-concatenate-strings in this-procedure (
      835                         input v-fmtcli-post-addres
      836                       , input substring( buf_firm.post-addr1, 101, 50 )
      837                       , input " ":U
      838                       , input 50
      839                       , output v-fmtcli-post-addres
      840                   ).
      841                   assign
      842                       v-fmtcli-phone         = buf_firm.phone
      843                       v-fmtcli-inn           = buf_firm.inn
      844                       v-fmtcli-kpp           = buf_firm.kpp
      845                       v-fmtcli-okpo          = buf_firm.okpo
      846                       v-fmtcli-index         = string( buf_firm.ind )
      847                   .
      848               end.
      849          end.
      850          when 'маг':U
      851          then do:
      852               find first buf_shop no-lock
      853                    where buf_shop.obj-code = buf_clients.obj-code
      854               .
      855               if available buf_shop
      856               then do:
      857                   run fmtcli-concatenate-strings in this-procedure (
      858                         input buf_shop.addres1
      859                       , input buf_shop.addres2
      860                       , input " ":U
      861                       , input 50
      862                       , output v-fmtcli-addres
      863                   ).
      864                   assign
      865                       v-fmtcli-full-addres = v-fmtcli-addres
      866                       v-fmtcli-post-addres = v-fmtcli-addres
      867                       v-fmtcli-phone       = buf_shop.phone
      868                       v-fmtcli-inn         = "":U
      869                       v-fmtcli-kpp         = "":U
      870                       v-fmtcli-okpo        = "":U
      871                       v-fmtcli-city        = "":U
      872                       v-fmtcli-index       = "":U
      873                   .
      874               end.
      875          end.
      876          when 'скл':U
      877          then do:
      878               find first buf_store no-lock
      879                    where buf_store.obj-code = buf_clients.obj-code
      880               .
      881               if available buf_store
      882               then do:
      883                   run fmtcli-concatenate-strings in this-procedure (
      884                         input buf_store.addres1
      885                       , input buf_store.addres2
      886                       , input " ":U
      887                       , input 50
      888                       , output v-fmtcli-addres
      889                   ).
      890                   assign
      891                       v-fmtcli-full-addres = v-fmtcli-addres
      892                       v-fmtcli-phone       = buf_store.phone
      893                       v-fmtcli-inn         = "":U
      894                       v-fmtcli-kpp         = "":U
      895                       v-fmtcli-okpo        = "":U
      896                       v-fmtcli-city        = "":U
      897                       v-fmtcli-index       = "":U
      898                   .
      899               end.
      900          end.
      901          when 'чел':U
      902          then do:
      903               find first buf_person no-lock
      904                    where buf_person.psn-code = buf_clients.obj-code
      905               .
      906               if available buf_person
      907               then do:
      908                   run fmtcli-concatenate-strings in this-procedure (
      909                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      910                                 then "":U
      911                                 else string( buf_person.ind, "999999")
      912                                 )
      913                       , input buf_person.city
      914                       , input ", ":U
      915                       , input 0
      916                       , output v-fmtcli-full-addres
      917                   ).
      918                   assign
      919                       v-fmtcli-addres = buf_person.address
      920                   .
      921                   run fmtcli-concatenate-strings in this-procedure (
      922                         input v-fmtcli-full-addres
      923                       , input v-fmtcli-addres
      924                       , input ", ":U
      925                       , input 0
      926                       , output v-fmtcli-full-addres
      927                   ).
      928                   assign
      929                       v-fmtcli-phone     = buf_person.phone1
      930                       v-fmtcli-inn       = buf_person.inn
      931                       v-fmtcli-kpp       = buf_person.kpp
      932                       v-fmtcli-okpo      = buf_person.okpo
      933                       v-fmtcli-city      = buf_person.city
      934                       v-fmtcli-index     = string( buf_person.ind )
      935                   .
      936               end.
      937          end.
      938       end case.
      939   end.
      940   end procedure.
      941   procedure fmtcli-concatenate-strings :
      942   define input parameter p-string-1       as character        no-undo.
      943   define input parameter p-string-2       as character        no-undo.
      944   define input parameter p-delimiter      as character        no-undo.
      945   define input parameter p-length         as integer          no-undo.
      946   define output parameter p-out-string    as character        no-undo.
      947   do
      948   on error undo, return error
      949   :
      950       assign
      951           p-out-string = ( if p-string-1 = ?
      952                            then "":U
      953                            else trim( p-string-1 ) )
      954       .
      955       assign
      956           p-out-string = p-out-string
      957                        + ( if p-out-string = "":U
      958                            or length( p-out-string ) = p-length
      959                            or p-string-2 = ?
      960                            or trim( p-string-2 ) = "":U
      961                            then "":U
      962                            else p-delimiter )
      963                        + ( if p-string-2 = ?
      964                            or trim( p-string-2 ) = "":U
      965                            then "":U
      966                            else trim( p-string-2 ) )
      967       .
      968   end.
      969   end procedure.
      970   define variable vss-include-info5 as character format "X(65)" no-undo
      971   initial "@(#)$Workfile$ $Revision$".
      972   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      974   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      975   define variable par-type          as character no-undo.
      976   define variable v-value-character as character no-undo .
      977   define variable v-value-date      as date      no-undo .
      978   define variable v-value-decimal   as decimal   no-undo .
      979   define variable v-value-integer   as integer   no-undo .
      980   define variable v-value-logical   as logical   no-undo .
      981   define variable v-torgconf-ext-doc-type as character    no-undo.
      982   define variable v-torgconf-outdate   as logical  init no    no-undo.
      983   define variable v-torgconf-outnum    as logical  init no    no-undo.
      984   define variable v-torgconf-outprim   as logical  init no    no-undo.
      985   define variable v-torgconf-outdisc   as logical  init no    no-undo.
      986   define variable v-torgconf-outsubs   as logical  init no    no-undo.
      987   define variable v-torgconf-outrecv   as logical  init no    no-undo.
      988   define variable v-torgconf-outegrp   as logical  init no    no-undo.
      989   define variable v-torgconf-outt12    as logical  init no    no-undo.
      990   define variable v-torgconf-outappr   as logical  init no    no-undo.
      991   define variable v-torgconf-outrubl   as logical  init no    no-undo.
      992   define variable v-torgconf-outhold   as logical  init no    no-undo.
      993   define variable v-torgconf-outobj    as logical  init no    no-undo.
      994   define variable v-torgconf-outexlst  as logical  init no    no-undo.
      995   define variable v-torgconf-outexpas  as character  init no    no-undo.
      996   define variable v-torgconf-outprncd  as logical  init no    no-undo.
      997   define variable v-torgconf-outares   as logical  init no    no-undo.
      998   define variable v-torgconf-outsend   as logical  init no    no-undo.
      999   define variable v-torgconf-outasend  as logical  init no    no-undo.
     1000   define variable v-torgconf-outprops  as logical  init no    no-undo.
     1001   define variable v-torgconf-outogr    as character no-undo.
     1002   define variable v-torgconf-outR      as character no-undo.
     1003   define variable v-torgconf-outB      as character no-undo.
     1004   define variable v-torgconf-outC      as character no-undo.
     1005   define variable v-torgconf-outssdoc  as character init "":U no-undo.
     1006   define variable v-torgconf-self-host-code           as integer      no-undo.
     1007   define variable v-torgconf-self-host-type           as character    INITIAL 'орг':U  no-undo.
     1008   define variable v-torgconf-self-host-name           as character    no-undo.
     1009   define variable v-torgconf-self-host-engl-name           as character    no-undo.
     1010   define variable v-torgconf-self-host-addres         as character    no-undo.
     1011   define variable v-torgconf-self-host-post-addres    as character    no-undo.
