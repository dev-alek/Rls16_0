     1951           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1952           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1953           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1954           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1955           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
