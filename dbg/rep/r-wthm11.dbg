     3921   procedure torgconf-get-reason  :
     3922   define input parameter  p-doc-code       as character        no-undo.
     3923   define input parameter  p-reason-code    as integer          no-undo .
     3924   define input parameter  p-doc-type       as character        no-undo.
     3925       if p-reason-code > 0
     3926       then do:
     3927           define buffer buf_trn-reason for ub.trn-reason.
     3928           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3929           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3930       end.
     3931       else do:
     3932           if p-doc-type = 'при':U
     3933           then  do:
     3934               define variable v-attr-type     as character    no-undo.
     3935               define variable v-attr-value    as character    no-undo.
     3936               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3937               assign v-torgconf-reason = v-attr-value .
     3938               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3939               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3940           end.
     3941       end.
     3942   end procedure.
     3943   define variable g#quest-print   as logical      no-undo.
     3944   define variable g#log           as logical      no-undo.
     3945   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3946     define variable v-cntxt-db-num        as integer   no-undo .
     3947     define variable v-cntxt-userid        as character no-undo .
     3948     define variable v-cntxt-level         as character no-undo .
     3949     define variable v-cntxt-host-code-obj as integer   no-undo .
     3950     define variable v-cntxt-obj-type      as character no-undo .
     3951     define variable v-cntxt-obj-code      as integer   no-undo .
     3952     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3953     define variable v-cntxt-is-admin      as logical   no-undo .
     3954   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3955     run mainmenu_getcntxt in p-parent-proc
     3956       (output v-cntxt-db-num
     3957       ,output v-cntxt-userid
     3958       ,output v-cntxt-level
     3959       ,output v-cntxt-host-code-obj
     3960       ,output v-cntxt-obj-type
     3961       ,output v-cntxt-obj-code
     3962       ,output v-cntxt-db-num-obj
     3963       ,output v-cntxt-is-admin
     3964       ) .
     3965   run get-report-num in p-parent-proc ( output g#report-num ).
     3966   run get-quest-print in p-parent-proc ( output g#quest-print ).
     3967   DEFINE VARIABLE v-host-name  AS CHARACTER NO-UNDO.
