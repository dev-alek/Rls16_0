     4781   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4782   define new global shared variable g#attr-lib  as handle no-undo .
     4783   define variable v-attr-lib-variable as handle no-undo .
     4784   procedure gds-attr-name :
     4785     define input  parameter p-code           as character no-undo .
     4786     define output parameter p-type           as character no-undo .
     4787     define output parameter p-format         as character no-undo .
     4788     define output parameter p-label          as character no-undo .
     4789     define output parameter p-user-can-edit  as logical   no-undo .
     4790     define output parameter p-output-display as logical   no-undo .
     4791     define output parameter p-other          as character no-undo .
     4792     do
     4793     on error undo, return error
     4794     :
     4795           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     4796         (input  p-code
     4797         ,output p-type
     4798         ,output p-format
     4799         ,output p-label
     4800         ,output p-user-can-edit
     4801         ,output p-output-display
     4802         ,output p-other
     4803         ) no-error .
     4804       if error-status :error
     4805       then do:
     4806         undo, return error return-value .
     4807       end.
     4808     end.
     4809   end procedure.
