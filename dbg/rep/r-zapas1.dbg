     3151   procedure prn-lib-prn-file :
     3152     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3153     define input parameter p-DIsabledoptions as integer no-undo .
     3154     define variable v-report-name as character no-undo .
     3155     define variable v-user-action as character no-undo .
     3156     define variable v-printed     as logical   no-undo .
     3157     define variable v-exist       as logical   no-undo .
     3158     do
     3159       on error undo, return error
     3160       :
     3161       run prn-lib-get-report-name  in this-procedure (
     3162         input parParentProc
     3163         ,output v-report-name
     3164         ).
     3165   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3166   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     3167     (input  v-report-name
     3168     ,input  2
     3169     ,output v-exist
     3170     )  .
     3171       if NOT v-exist then
     3172       DO:
     3173         Message
     3174           "Нет заданий на печать ! "
     3175           view-as alert-box .
     3176         Return  .
     3177       End.
     3178       run gbl/prnfilen.w
     3179         (input  ""
     3180         ,input  p-DisabledOptions
     3181         ,input  string(v-report-name )
     3182         ,input  7
     3183         ,output v-user-action
     3184         ,output v-printed
     3185         ) .
     3186       if v-printed then
     3187       do:
     3188         return "YES" .
     3189       end.
     3190       else
     3191       do:
     3192         return "NO" .
     3193       end.
