     6218                   '<TD style="text-align: center"> ' + string(gds-zap-unit-base) + '</TD>'skip
     6219       '<TD num="0.000" val="' + fnc-convert-dot-to-colon(gds-zap-qnty,      "->>>>>>>>>>>9.999",3) + '" style="text-align: right"> ' + if gds-zap-qnty <> ? then fnc-convert-dot-to-colon(gds-zap-qnty,"->>>>>>>>>>>9.999",3) + '</TD>' else "" + '</td>' skip
     6220             '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-price-base,"->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-price-base <> ? then fnc-convert-dot-to-colon(gds-zap-price-base,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6221        '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-stoim-base,"->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-stoim-base <> ? then fnc-convert-dot-to-colon(gds-zap-stoim-base,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6222              '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-Nds,       "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-Nds <> ? then fnc-convert-dot-to-colon(gds-zap-Nds,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6223               '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-Np,        "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-Np <> ? then fnc-convert-dot-to-colon(gds-zap-Np,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6224     '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-price-nds, "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-price-nds <> ? then fnc-convert-dot-to-colon(gds-zap-price-nds,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6225    '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(tot_tqnty,         "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if tot_tqnty <> ? then fnc-convert-dot-to-colon(tot_tqnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6226                 .
     6227                   if v-photo then do:
     6228                                 put stream OutStr-html unformatted
     6229                                     '<TD style="text-align: center; width: 20px;">'skip
     6230                                     '<img  src="' + gds-zap-image + '"; alt="Фото товара" style="height: 50px;"/>'
     6231                                     '</TD>'skip
     6232                                 .
     6233                   end.
     6234                 put stream OutStr-html unformatted
     6235                   '</TR>'skip
     6236                 .
     6237                   run new-tmp-page .
     6238                     num#str# = num#str# + 1.
     6239                     num#col# = 1.
     6240               end.
     6241               else do :
     6242                 put stream OutStr-html unformatted
     6243                   '<TR>'skip
     6244                     '<TD style="text-align: center"> ' + string(gds-zap-b-code) + '</TD>'skip
     6245                     '<TD style="text-align: center"> ' + string(gds-zap-artic) + '</TD>'skip
     6246                     '<TD style="text-align: left"> ' + string(gds-zap-gds-name) + '</TD>'skip
     6247                     '<TD style="text-align: center"> ' + if string(gds-zap-part-b-code) = ? then " " + '</TD>' else string(gds-zap-part-b-code) + '</TD>'skip
     6248                     '<TD style="text-align: center"> ' + string(gds-zap-unit-base) + '</TD>'skip
     6249   '<TD num="0.000" val="' + fnc-convert-dot-to-colon(gds-zap-qnty,      "->>>>>>>>>>>9.999",3) + '" style="text-align: right"> ' + if gds-zap-qnty <> ? then fnc-convert-dot-to-colon(gds-zap-qnty,"->>>>>>>>>>>9.999",3) + '</TD>' else "" + '</td>' skip
     6250   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-price-base,"->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-price-base <> ? then fnc-convert-dot-to-colon(gds-zap-price-base,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6251   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-stoim-base,"->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-stoim-base <> ? then fnc-convert-dot-to-colon(gds-zap-stoim-base,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6252   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-Nds,       "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-Nds <> ? then fnc-convert-dot-to-colon(gds-zap-Nds,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6253   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-Np,        "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-Np <> ? then fnc-convert-dot-to-colon(gds-zap-Np,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6254   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(gds-zap-price-nds, "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if gds-zap-price-nds <> ? then fnc-convert-dot-to-colon(gds-zap-price-nds,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6255   '<TD num="0.00"  val="' + fnc-convert-dot-to-colon(tot_tqnty,         "->>>>>>>>>>>9.99", 2) + '" style="text-align: right"> ' + if tot_tqnty <> ? then fnc-convert-dot-to-colon(tot_tqnty,"->>>>>>>>>>>9.99",2) + '</TD>' else "" + '</td>' skip
     6256                 .
