     6113   assign
     6114     i=0
     6115     zap-date      = x-Date-Alone
     6116     Select-Good   = x-SelectGood
     6117     PayType       = x-SET_PAY_TYPE
     6118     RetClassify   = xClassify
     6119     RetSortType   = xSortType
