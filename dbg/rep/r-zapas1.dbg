     6028   define variable Tot-5 as decimal FORMAT "->>>>>>>>>>9.99" no-undo init 0.
     6029   define variable oTot-1 as decimal FORMAT "->>>>>>>>>>9.999"  no-undo init 0.
     6030   define variable oTot-2 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6031   define variable oTot-3 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6032   define variable oTot-4 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6033   define variable oTot-5 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6034   define variable Tot-1-1 as decimal FORMAT "->>>>>>>>>>9.999"  no-undo init 0.
     6035   define variable Tot-1-2 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6036   define variable Tot-1-3 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6037   define variable Tot-1-4 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6038   define variable Tot-1-5 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6039   define variable Tot-2-1 as decimal FORMAT "->>>>>>>>>>9.999"  no-undo init 0.
     6040   define variable Tot-2-2 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6041   define variable Tot-2-3 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
     6042   define variable Tot-2-4 as decimal FORMAT "->>>>>>>>>>9.99"  no-undo init 0.
