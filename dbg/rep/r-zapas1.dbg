     3196   procedure prn-lib-open-stream :
     3197     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3198     define input parameter p-page-size    as integer no-undo .
     3199     define input parameter p-is-stream    as logical no-undo .
     3200     define input parameter p-append       as logical no-undo .
     3201     define variable v-report-name as character no-undo .
     3202     do
     3203       on error undo, return error
     3204       :
     3205       run prn-lib-get-report-name  in this-procedure (
     3206         input parParentProc
     3207         ,output v-report-name
     3208         ).
     3209       if p-is-stream then
     3210       do:
     3211         if p-append then
     3212         do:
     3213           output stream PrnLibStream to value( v-report-name )
     3214             page-size value(p-page-size) append .
     3215         end.
     3216         if not p-append then
     3217         do:
     3218           output stream PrnLibStream to value( v-report-name )
     3219             page-size value(p-page-size) .
     3220         end.
     3221       end.
     3222       if not p-is-stream then
     3223       do:
     3224         if p-append then
     3225         do:
     3226           output to value( v-report-name )
     3227             page-size value(p-page-size) append .
     3228         end.
     3229         if not p-append then
     3230         do:
     3231           output to value( v-report-name )
     3232             page-size value(p-page-size) .
     3233         end.
     3234       end.
     3235     end.
     3236   end procedure.
     3237   procedure prn-lib-open-exp :
     3238     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3239     define input parameter p-is-stream    as logical no-undo .
     3240     define input parameter p-is-append    as logical no-undo .
     3241     define output parameter p-ReportFileName as char init "report" no-undo.
     3242     define output parameter p-process as logical no-undo .
     3243     define variable glog as logical no-undo .
     3244     do
     3245       on error undo, return error
     3246       :
     3247       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3248         TITLE      "Укажите путь"
     3249         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3250         ASK-OVERWRITE
     3251         CREATE-TEST-FILE
     3252         SAVE-AS
     3253         USE-FILENAME
     3254         DEFAULT-EXTENSION "txt"
     3255         UPDATE glog
     3256         .
     3257       if not glog then  return.
     3258       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3259       if p-is-stream then
     3260       do:
     3261         if p-is-append then
     3262         do:
     3263           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3264         end.
     3265         else
     3266         do:
     3267           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3268         end.
     3269       end.
     3270       else
     3271       do:
     3272         if p-is-append then
     3273         do:
     3274           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3275         end.
     3276         else
     3277         do:
     3278           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3279         end.
     3280       end.
     3281       p-process = yes.
     3282     end.
     3283   end procedure.
     3284   procedure prn-lib-get-report-name :
     3285     define input parameter parParentProc  as widget-handle no-undo.
     3286     define output parameter p-report-name as character no-undo .
