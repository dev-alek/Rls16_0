     3294   procedure prn-lib-reportviewer :
     3295     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3296     define input parameter p-report-name-html as character no-undo .
     3297     define input parameter p-param        as character no-undo .
     3298     define variable v-excel           as character no-undo init 'TRUE' .
     3299     define variable v-value-character as character no-undo .
     3300     define variable v-value-integer   as character no-undo .
     3301     define variable v-value-date      as date      no-undo .
     3302     define variable v-value-decimal   as decimal   no-undo .
     3303     define variable rep-excel         as logical   no-undo .
     3304     define variable excel-string      as character no-undo .
     3305     define variable v-param-type      as character no-undo .
     3306     define variable v-tth             as handle    no-undo .
     3307     run adm/shattri.p (
     3308       input "get":U
     3309       ,input  ""
     3310       ,input  0
     3311       ,input  'report-glob':U
     3312       ,input  'rep-excel':U
     3313       ,output v-value-character
     3314       ,output v-value-date
     3315       ,output v-value-decimal
     3316       ,output v-value-integer
     3317       ,output rep-excel
     3318       ,output v-param-type
     3319       ,INPUT-OUTPUT table-handle v-tth
     3320       )  .
     3321     if rep-excel then v-excel = "TRUE" .
     3322     else v-excel = "FALSE" .
     3323     if p-param eq ""
     3324     then
     3325        p-param = "EXCEL:" + v-excel.
     3326     else
     3327        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     3328     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     3329   end procedure.
