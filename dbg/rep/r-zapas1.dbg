     6127   define variable v-fact-order-end as decimal   no-undo .
     6128     run day-begin-fact-order in this-procedure ( input ( zap-date + 1 ),   output v-fact-order-end ).
     6129     RUN REPORT-EXECUTE.
     6130   procedure foreach :
     6131    do
     6132    on error undo, return error return-value
     6133    :
     6134    FIND LAST  ub.stk-line where
     6135                           ub.stk-line.artic      = gds-zap-artic
     6136                     AND   ub.stk-line.fact-date <= zap-date
     6137                     AND   ub.stk-line.obj-code   = x-store-code
     6138                     AND   ub.stk-line.obj-type   = x-store-type
     6139                     AND   ub.stk-line.prod-code  = gds-zap-prod-code
     6140                     AND   ub.stk-line.prod-type  = gds-zap-prod-type
     6141                     AND   ub.stk-line.sum-type   = (IF PayType = 2  then  'cost':U
     6142                                                                  else  'crsa':U )
     6143                    AND    ub.stk-line.cat-id       = '##,##':U
     6144                          USE-INDEX category no-lock no-error.
     6145           IF AVAILABLE ub.stk-line Then DO:
     6146               IF  tPrintRubl  THEN
     6147                     ASSIGN gds-zap-qnty       = ub.stk-line.fact-qnty
     6148                           gds-zap-stoim-base  = ub.stk-line.sum-rubl
     6149                           gds-zap-Nds         = ub.stk-line.VAT-rubl
     6150                           gds-zap-Np          = ub.stk-line.SLT-rubl .
     6151                 ELSE
     6152                     ASSIGN gds-zap-qnty       =  ub.stk-line.fact-qnty
     6153                           gds-zap-stoim-base  =  ub.stk-line.sum-base
     6154                           gds-zap-Nds         =  ub.stk-line.VAT-base
     6155                           gds-zap-Np          =  ub.stk-line.SLT-base .
     6156                End.
     6157             Else ASSIGN gds-zap-qnty       = 0
     6158                         gds-zap-price-base = 0
     6159                         gds-zap-price-nds = 0
     6160                         gds-zap-stoim-base = 0
     6161                         gds-zap-Nds   = 0
     6162                         gds-zap-Np    = 0.
     6163           Assign
     6164             gds-zap-price-base = if (gds-zap-qnty <> 0) Then round((gds-zap-stoim-base / gds-zap-qnty),2) Else 0
     6165             tot_tqnty          = gds-zap-stoim-base - gds-zap-Nds
     6166             gds-zap-price-nds = if (gds-zap-qnty <> 0) Then round( (tot_tqnty / gds-zap-qnty) , 2) Else 0
     6167             .
     6168                 if v-photo = yes then do:
     6169                     IF mImagePh THEN
     6170                   DO:
     6171                     find first buf_goods where buf_goods.artic = gds-zap-artic and buf_goods.prod-code = gds-zap-prod-code and buf_goods.prod-type = gds-zap-prod-type no-error.
     6172                     if available buf_goods then do:
     6173                         RUN gds-attr-value ( buf_goods.gds-code, "image-list":U, OUTPUT vImageList, OUTPUT vCh).
     6174                         RUN imagelist_decode IN THIS-PROCEDURE (INPUT vImageList, buf_goods.gds-code, OUTPUT vImageList).
     6175                     gds-zap-image = entry (1,vImageList).
     6176                     end.
     6177                   v-col = 12.
     6178                   END.
     6179                 end.
     6180    end.
     6181   end procedure.
     6182   procedure display-line :
     6183   define variable v-sum-dsc-rubl-acc-no-nds as decimal no-undo .
     6184    do
     6185    on error undo, return error return-value
     6186    :
     6187        i = i + 1.
     6188        IF  NOT (NOT Show-Negativ  AND (round(gds-zap-qnty,3) = 0 and round(gds-zap-stoim-base,2) = 0 and round(gds-zap-Nds,2) = 0 )) then DO:
     6189           IF NOT Sums-Only then DO:
     6190             if fr = true then do:
     6191                             if fr0 = true then do:
     6192                               put stream OutStr-html unformatted
     6193                               '<TR>'skip
     6194                                   '<TD colspan="' + string(v-col) + '"> ' + tmp#stroka0 + '</TD>'skip
     6195                               '</TR>'skip
     6196                               .
     6197                                 PUT stream OutStr-html  tmp#stroka0 format "X(100)" skip .
     6198                                 num#str# = num#str# + 1.
     6199                                 num#col# = 1.
     6200                                 fr0 = false .
     6201                              end.
     6202                          put stream OutStr-html unformatted
     6203                               '<TR>'skip
     6204                                   '<TD colspan="' + string(v-col) + '"> ' + tmp#stroka + '</TD>'skip
     6205                               '</TR>'skip
