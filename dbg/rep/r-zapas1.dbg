     7264     end.
     7265     else do:
     7266       run partslib-init-temp-parts in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code ) .
     7267     end.
     7268   end.
     7269        run foreach.
     7270        run display-line.
     7271   end.
     7272     End.
     7273           otherwise do:
     7274   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7275   for each gds-obj
     7276       where  gds-obj.obj-code   = x-store-code
     7277         and  gds-obj.obj-type   = x-store-type
     7278                                   no-lock ,
     7279       first gds-list
     7280             where gds-obj.prod-code  = gds-list.prod-code and
     7281                   gds-obj.prod-type  = gds-list.prod-type and
     7282                   gds-obj.artic      = gds-list.artic  no-lock ,
     7283       first b-clients no-lock where b-clients.obj-type = gds-list.prod-type and
     7284                                     b-clients.obj-code = gds-list.prod-code
     7285             break
     7286             by gds-list.gds-code :
     7287     assign
     7288         gds-zap-unit-base  = gds-list.unit-base
     7289         gds-zap-prt-root   = gds-list.prt-root
     7290         gds-zap-prod-type  = gds-list.prod-type
     7291         gds-zap-prod-code  = gds-list.prod-code
     7292         gds-zap-artic      = gds-list.artic
     7293         gds-zap-grp-name   = gds-list.grp-name
     7294         gds-zap-b-code     = gds-list.gds-code
     7295         gds-zap-prod-name  = b-clients.obj-name
     7296         gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name else gds-list.gds-name
     7297     .
     7298         gds-zap-gds-long-name = substring(
     7299                   (if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
