      764   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      765     if num-entries(string(p-dec), '.') = 2
      766       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      767       else return( string(p-dec)) .
      768   end function.
      769   function format-point-to-comma returns char (input orig as char ) .
      770   define variable rtext as character no-undo .
      771   define variable strt as integer no-undo .
      772   define variable leng as integer no-undo .
      773   assign rtext = orig .
      774   repeat:
      775     strt =  index(rtext,'.').
      776     if strt = 0 then leave.
      777     leng = 1.
      778     substring(rtext,strt,leng,"character") = v-delim .
      779   end.
      780   return rtext.
      781   end function.
      782   function format-excel-text returns char ( input start-text as char ) :
      783   def var  i    as int no-undo.
      784   def var  ch   as char no-undo.
      785   def var  n    as int no-undo.
      786   def var  ipos as int no-undo.
      787     n = num-entries(trim(start-text), chr(10)) - 1 .
      788     do i = 1 to n :
      789       ipos = index( start-text, chr(10)).
      790       if ipos > 0 then
      791         substr( start-text, ipos, 1 ) = ' '.
      792     end.
      793     n = num-entries(trim(start-text), chr(13)) - 1 .
      794     do i = 1 to n :
      795       ipos = index( start-text, chr(13)).
      796       if ipos > 0 then
      797         substr( start-text, ipos, 1 ) = ' '.
      798     end.
      799     if index( start-text, '"' ) = 0 then
      800       start-text =  '="'   + trim( start-text) + '"'   .
      801       else do:
      802         n = num-entries(trim(start-text), '"') - 1.
      803         do i = 1 to n :
      804           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      805         end.
      806         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      807         start-text = '="'  + ch  + '"' .
      808       end.
      809     return start-text.
      810   end.
      811   function excel-sum returns char (input p-dec as decimal ).
      812     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      813   end function.
      814   function excel-qnty returns char (input p-dec as decimal ).
      815     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      816   end function.
      817   function format-excel-text-macr returns char ( input start-text as char ) :
      818   def var  i    as int no-undo.
      819   def var  ch   as char no-undo.
      820   def var  n    as int no-undo.
      821   def var  ipos as int no-undo.
      822     n = num-entries(trim(start-text), chr(10)) - 1 .
      823     do i = 1 to n :
      824       ipos = index( start-text, chr(10)).
      825       if ipos > 0 then
      826         substring( start-text, ipos , 1 ) = ' '.
      827     end.
      828     n = num-entries(trim(start-text), chr(13)) - 1 .
      829     do i = 1 to n :
      830       ipos = index( start-text, chr(13)).
      831       if ipos > 0 then
      832         substring( start-text, ipos, 1 ) = ' '.
      833     end.
      834     if index( start-text, '"' ) = 0 then
      835       start-text =  '"'   + trim( start-text) + '"'   .
      836       else do:
      837         n = num-entries(trim(start-text), '"') - 1.
      838         do i = 1 to n :
      839           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      840         end.
      841         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      842         start-text = '"'  + ch  + '"' .
      843       end.
      844     n = num-entries(trim(start-text), chr(10)) - 1 .
      845     do i = 1 to n :
      846       ipos = index( start-text, chr(10)).
      847       if ipos > 0 then
      848         substring( start-text, ipos , 1 ) = ' '.
      849     end.
      850       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      851     return start-text.
      852   end.
      853   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   procedure cur-time :
      855      define output parameter p-today as date      no-undo .
      856      define output parameter p-time  as integer   no-undo .
      857     do
      858     on error undo, return error
      859     :
      860       define variable v-date1 as date      no-undo .
      861       define variable v-date2 as date      no-undo .
      862       define variable v-time  as integer   no-undo .
      863       assign
      864         v-date1 = today
      865         v-time  = time
      866         v-date2 = today
      867       .
      868       if v-date1 <> v-date2
      869       then do:
      870         assign
      871           v-date1 = today
      872           v-time  = v-time
      873         .
      874       end.
      875       assign
      876         p-today = v-date1
      877         p-time  = v-time
      878       .
      879     end.
      880   end.
      881   function cur-time-date returns character
      882   :
      883     return string(today, '99/99/9999':U) .
      884   end.
      885   function cur-time-mjd returns decimal
      886   :
      887     define variable v-date as date      no-undo .
      888     define variable v-time as integer   no-undo .
      889     run cur-time in this-procedure
      890       (output v-date
      891       ,output v-time
      892       ) .
      893     return integer(v-date) - 2400002 + (v-time / 86400) .
      894   end.
      895   function cur-time-get-ending-index returns integer
      896   (input p-number as integer
      897   )
      898   :
      899     if p-number < 0
      900     or p-number = ?
      901     then do:
      902       return 1 .
      903     end.
      904     define variable v-rest as integer   no-undo .
      905     assign
      906       p-number = p-number modulo 100
      907     .
      908     if p-number < 20
      909     then do:
      910       assign
      911         v-rest = p-number
      912       .
      913     end.
      914     else do:
      915       assign
      916         v-rest = p-number modulo 10
      917       .
      918     end.
      919     case v-rest :
      920       when 1
      921       then do:
      922         return 2 .
      923       end.
      924       when 2 or
      925       when 3 or
      926       when 4
      927       then do:
      928         return 3 .
      929       end.
      930       otherwise do:
      931         return 1 .
      932       end.
      933     end case .
      934   end.
      935   procedure cur-time-mjd-to-date :
      936      define input  parameter i-mjd-diff as decimal no-undo.
      937      define output parameter o-Date     as date    no-undo.
      938      define output parameter o-Time     as integer no-undo.
      939      define variable v-day-number as integer   no-undo .
      940      if    i-mjd-diff < 0
      941         or i-mjd-diff = ?
      942      then do:
      943         return "?" .
      944      end.
      945      assign
      946         v-day-number = truncate(i-mjd-diff,0).
      947         o-Date = date(v-day-number + 2400002).
      948         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      949     .
      950   end.
      951   function cur-time-mjd-to-string returns character
      952   (input p-mjd-diff as decimal
      953   )
      954   :
      955     define variable v-day-number as integer   no-undo .
      956     define variable v-seconds    as integer   no-undo .
      957     define variable v-hour       as integer   no-undo .
      958     define variable v-min        as integer   no-undo .
      959     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      960     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      961     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      962     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      963     if p-mjd-diff < 0
      964     or p-mjd-diff = ?
      965     then do:
      966       return "?" .
      967     end.
      968     assign
      969       v-day-number = integer(truncate(p-mjd-diff,0))
      970       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      971     .
      972     if v-seconds > 86400
      973     then do:
      974       assign
      975         v-seconds = 86400 - 1
      976       .
      977     end.
      978     if v-seconds < 0
      979     then do:
      980       assign
      981         v-seconds = 0
      982       .
      983     end.
      984     assign
      985       v-hour = truncate(v-seconds / 3600, 0)
      986     .
      987     assign
      988       v-seconds = v-seconds modulo 3600
      989     .
      990     assign
      991       v-min = truncate(v-seconds / 60, 0)
      992     .
      993     assign
      994       v-seconds = v-seconds modulo 60
      995     .
      996     return
      997         (if v-day-number <> 0
      998           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      999           else ""
     1000         )
     1001       + (if v-day-number <> 0 or v-hour <> 0
     1002           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1003           else ""
     1004         )
     1005       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1006           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1007           else ""
     1008         )
     1009       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1010       .
     1011   end.
     1012   function cur-time-string returns character
     1013   :
     1014     define variable v-date as date      no-undo .
     1015     define variable v-time as integer   no-undo .
     1016     run cur-time in this-procedure
     1017       (output v-date
     1018       ,output v-time
     1019       ) .
     1020     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1021   end.
     1022   function cur-time-string-sec returns character
     1023   :
     1024     define variable v-date as date      no-undo .
     1025     define variable v-time as integer   no-undo .
     1026     run cur-time in this-procedure
     1027       (output v-date
     1028       ,output v-time
     1029       ) .
     1030     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1031   end.
     1032   function cur-time-custom  returns character
     1033   (input p-prefix as character
     1034   ,input p-date-format as character
     1035   ,input p-delimiter as character
     1036   ,input p-time-format as character
     1037   ,input p-suffix as character
     1038   )
     1039   :
     1040     define variable v-date as date      no-undo .
     1041     define variable v-time as integer   no-undo .
     1042     run cur-time in this-procedure
     1043       (output v-date
     1044       ,output v-time
     1045       ) .
     1046     return
     1047       p-prefix
     1048       + string(v-date, p-date-format)
     1049       + p-delimiter
     1050       + string(v-time, p-time-format)
     1051       + p-suffix
     1052       .
     1053   end.
     1054   function cur-time-print  returns character
     1055   :
     1056     define variable v-date as date      no-undo .
     1057     define variable v-time as integer   no-undo .
     1058     run cur-time in this-procedure
     1059       (output v-date
     1060       ,output v-time
     1061       ) .
     1062     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1063   end.
     1064   function cur-time-datetime returns datetime
     1065   :
     1066     define variable v-char as character no-undo .
     1067     define variable v-datetime as datetime no-undo .
     1068     v-char = cur-time-string().
     1069     v-datetime = datetime(v-char).
     1070     return  v-datetime.
     1071   end.
     1072   function cur-time-string-msec returns character
     1073   :
     1074     define variable v-date as datetime  no-undo .
     1075     v-date = now.
     1076     return string(v-date) .
     1077   end.
     1078   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1079   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1080   procedure paramls-clear :
     1081     define buffer buf_temp-param for temp-param .
     1082     do
     1083     on error undo, return error return-value
     1084     :
     1085       for each buf_temp-param
     1086       on error undo, return error
     1087       :
     1088         delete buf_temp-param .
     1089       end.
     1090     end.
     1091   end procedure.
     1092   procedure paramls-write :
     1093     define input  parameter p-code     as character no-undo .
     1094     define input  parameter p-sub-code as character no-undo .
     1095     define input  parameter p-value    as character no-undo .
     1096     define buffer buf_temp-param for temp-param .
     1097     do
     1098     on error undo, return error return-value
     1099     :
     1100       find first buf_temp-param
     1101         where buf_temp-param.param-code     = p-code
     1102           and buf_temp-param.param-sub-code = p-sub-code
     1103         no-error .
     1104       if not available buf_temp-param then do:
     1105         create buf_temp-param .
     1106         assign
     1107           buf_temp-param.param-code     = p-code
     1108           buf_temp-param.param-sub-code = p-sub-code
     1109         .
     1110       end.
     1111       assign
     1112         buf_temp-param.param-value = p-value
     1113       .
     1114     end.
     1115   end procedure.
     1116   procedure paramls-read :
     1117     define input  parameter p-code          as character no-undo .
     1118     define input  parameter p-sub-code      as character no-undo .
     1119     define input  parameter p-default-value as character no-undo .
     1120     define output parameter p-value         as character no-undo .
     1121     define buffer buf_temp-param for temp-param .
     1122     do
     1123     on error undo, return error return-value
     1124     :
     1125       find first buf_temp-param
     1126         where buf_temp-param.param-code     = p-code
     1127           and buf_temp-param.param-sub-code = p-sub-code
     1128         no-error .
     1129       if available buf_temp-param then do:
     1130         assign
     1131           p-value = buf_temp-param.param-value
     1132         .
     1133       end.
     1134       else do:
     1135         assign
     1136           p-value = p-default-value
     1137         .
     1138       end.
     1139     end.
     1140   end procedure.
     1141   procedure paramls-append :
     1142     define input  parameter p-code     as character no-undo .
     1143     define input  parameter p-sub-code as character no-undo .
     1144     define input  parameter p-value    as character no-undo .
     1145     define buffer buf_temp-param for temp-param .
     1146     do
     1147     on error undo, return error return-value
     1148     :
     1149       find first buf_temp-param
     1150            where buf_temp-param.param-code     = p-code
     1151              and buf_temp-param.param-sub-code = p-sub-code
     1152         no-error .
     1153       if not available buf_temp-param then do:
     1154         create buf_temp-param .
     1155         assign
     1156           buf_temp-param.param-code     = p-code
     1157           buf_temp-param.param-sub-code = p-sub-code
     1158           buf_temp-param.param-value    = p-value
     1159         .
     1160       end.
     1161       else do:
     1162           assign
     1163               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1164           .
     1165       end.
     1166     end.
     1167   end procedure.
     1168   define temp-table temp-font no-undo
     1169     field fontnum  as integer
     1170     field fontname as character
     1171     field fontsize as character
     1172     field fonttype as character
     1173     field font-h   as integer
     1174     field font-w   as integer
     1175     field v-row    as integer
     1176     field v-col    as integer
     1177     field v-row-lans as integer
     1178     field v-col-lans as integer
     1179   index pi fontnum
     1180   .
     1181   procedure get-font-ini :
     1182     do
     1183     on error undo, return error return-value
     1184     :
     1185   define variable ii as integer   no-undo .
     1186   define variable v-font7 as character no-undo .
     1187   define variable v-font as character no-undo .
     1188   define variable loc-name as character no-undo .
     1189   define variable loc-size as character no-undo .
     1190   define variable loc-type as character no-undo .
     1191   define variable old_H as integer   no-undo .
     1192   define variable old_w as integer   no-undo .
     1193   define variable old-row  as integer   no-undo .
     1194   define variable old-col  as integer   no-undo .
     1195   define variable old-row-lans  as integer   no-undo .
     1196   define variable old-col-lans  as integer   no-undo .
     1197   define variable vv as integer   no-undo .
     1198   empty temp-table temp-font.
     1199     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1200       case num-entries (v-font7) :
     1201         when 4 then do:
     1202             assign
     1203               loc-name = entry ( 1 , v-font7 )
     1204               loc-size = entry ( 2 , v-font7 )
     1205               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1206             .
     1207         end.
     1208         when 3 then do:
     1209             assign
     1210               loc-name = entry ( 1 , v-font7 )
     1211               loc-size = entry ( 2 , v-font7 )
     1212               loc-type = entry ( 3 , v-font7 )
     1213             .
     1214         end.
     1215         when 2 then  do:
     1216             assign
     1217               loc-name = entry ( 1 , v-font7 )
     1218               loc-size = entry ( 2 , v-font7 )
     1219               loc-type = ""
     1220             .
     1221         end.
     1222         when 1 then do:
     1223             assign
     1224               loc-name = trim(entry ( 1 , v-font7 ))
     1225               loc-size = ""
     1226               loc-type = ""
     1227             .
     1228         end.
     1229       end case.
     1230     create temp-font.
     1231     assign
     1232       temp-font.fontnum  = 7
     1233       temp-font.fontname = trim(loc-name)
     1234       temp-font.fontsize = trim(loc-size)
     1235       temp-font.fonttype = trim(loc-type)
     1236       temp-font.v-row    = 62
     1237       temp-font.v-col    = 136
     1238       temp-font.v-row-lans = 43
     1239       temp-font.v-col-lans = 198
     1240     .
     1241     repeat ii = 16 to 100 :
     1242       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1243       if v-font = "" or v-font = ? then leave.
     1244       case num-entries (v-font) :
     1245         when 4 then do:
     1246             assign
     1247               loc-name = entry ( 1 , v-font )
     1248               loc-size = entry ( 2 , v-font )
     1249               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1250             .
     1251         end.
     1252         when 3 then do:
     1253             assign
     1254               loc-name = entry ( 1 , v-font )
     1255               loc-size = entry ( 2 , v-font )
     1256               loc-type = entry ( 3 , v-font )
     1257             .
     1258         end.
     1259         when 2 then do:
     1260             assign
     1261               loc-name = entry ( 1 , v-font )
     1262               loc-size = entry ( 2 , v-font )
     1263               loc-type = ""
     1264             .
     1265         end.
     1266         when 1 then do:
     1267             assign
     1268               loc-name = trim(entry ( 1 , v-font ))
     1269               loc-size = ""
     1270               loc-type = ""
     1271             .
     1272         end.
     1273       end case.
     1274     create temp-font.
     1275     assign
     1276       temp-font.fontnum  = ii
     1277       temp-font.fontname = trim(loc-name)
     1278       temp-font.fontsize = trim(loc-size)
     1279       temp-font.fonttype = trim(loc-type)
     1280     .
     1281     end.
     1282       for each temp-font :
     1283          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1284          if  vv = ? then vv =  0 .
     1285           run rep/exfont.p (
     1286             input   temp-font.fontname ,
     1287             input   vv ,
     1288             input   temp-font.fonttype ,
     1289             output  temp-font.font-h   ,
     1290             output  temp-font.font-w   )
     1291           .
     1292       end.
     1293   find first temp-font where  temp-font.fontnum  = 7  .
     1294   old_H = temp-font.font-H .
     1295   old_w = temp-font.font-W .
     1296   old-row = temp-font.v-row .
     1297   old-col = temp-font.v-col .
     1298   old-row-lans = temp-font.v-row-lans .
     1299   old-col-lans = temp-font.v-col-lans .
     1300       for each temp-font where
     1301                temp-font.fontnum  <> 7 :
     1302           assign
     1303               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1304               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1305               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1306               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1307           .
     1308       end.
     1309     end.
     1310   end procedure.
     1311   PROCEDURE How-name :
     1312   define input  parameter h as integer no-undo .
     1313   define input  parameter w as integer no-undo .
     1314   define output parameter n as character  no-undo .
     1315   define variable A4port-H as integer   no-undo init 63.
     1316   define variable A4port-W as integer   no-undo init 136.
     1317   define variable A4lans-H as integer   no-undo init 43.
     1318   define variable A4lans-W as integer   no-undo init 198.
     1319   define variable Strim-W  as integer   no-undo init 278.
     1320   run define-a4-size (
     1321        input ReportFontNum
     1322       ,output A4port-H
     1323       ,output A4port-W
     1324       ,output A4lans-H
     1325       ,output A4lans-W ).
     1326   If w >= 1 and w <= A4port-W Then DO:
     1327     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1328     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1329     If h > A4port-H              Then n = "to-file":U.
     1330   End.
     1331   If w > A4port-W and w <= A4lans-W Then DO:
     1332     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1333     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1334     If h > A4port-H              Then n = "to-file":U.
     1335   End.
     1336   If w > A4lans-W and w <= Strim-W Then DO:
     1337     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1338     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1339     If h > A4port-H              Then n = "to-file":U.
     1340   End.
     1341   If w > Strim-W Then DO:
     1342      n = "to-file":U.
     1343   End.
     1344   END PROCEDURE.
     1345   PROCEDURE define-a4-size :
     1346   define input  parameter p-ReportFontNum as integer   no-undo .
     1347   define output parameter A4port-H as integer   no-undo .
     1348   define output parameter A4port-W as integer   no-undo .
     1349   define output parameter A4lans-H as integer   no-undo .
     1350   define output parameter A4lans-W as integer   no-undo .
     1351   if not can-find (first temp-font ) then do:
     1352      run get-font-ini .
     1353   end.
     1354   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1355   if available temp-font then do:
     1356   assign
     1357     A4port-H = temp-font.v-row
     1358     A4port-W = temp-font.v-col
     1359     A4lans-H = temp-font.v-row-lans
     1360     A4lans-W = temp-font.v-col-lans
     1361   .
     1362   end.
     1363   else do:
     1364   assign
     1365     A4port-H = 63
     1366     A4port-W = 136
     1367     A4lans-H = 43
     1368     A4lans-W = 198
     1369   .
     1370   end.
     1371   END PROCEDURE.
     1372   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1373   procedure factord :
     1374     define input  parameter p-fact-date            as date    no-undo .
     1375     define input  parameter p-fact-time            as integer no-undo .
     1376     define input  parameter p-fact-num             as integer no-undo .
     1377     define input  parameter p-shift-date           as date    no-undo .
     1378     define input  parameter p-shift-num            as integer no-undo .
     1379     define input  parameter p-shift-on             as logical no-undo .
     1380     define output parameter p-fact-order           as decimal no-undo .
     1381     define output parameter p-shift-end-fact-order as decimal no-undo .
     1382     define output parameter p-day-end-fact-order   as decimal no-undo .
     1383     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1384     if p-fact-date = ?
     1385     then do:
     1386       return error "Не указана фактическая дата" .
     1387     end.
     1388     define variable v-fact-date-num as integer no-undo .
     1389     assign
     1390       v-fact-date-num = integer(p-fact-date)
     1391     .
     1392     if p-fact-num = ?
     1393     or p-fact-num = 0
     1394     then do:
     1395       return error "Не задан p-fact-num " + string(p-fact-num) .
     1396     end.
     1397     if p-fact-num < 0
     1398     then do:
     1399       return error "Отрицательный fact-num " + string(p-fact-num) .
     1400     end.
     1401     if p-fact-num >= 100000000
     1402     then do:
     1403       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1404     end.
     1405     if p-shift-on = true
     1406     then do:
     1407       if p-shift-date = ?
     1408       then do:
     1409         return error "Не задана дата смены" .
     1410       end.
     1411       if p-shift-num = ?
     1412       or p-shift-num = 0
     1413       then do:
     1414         return error "Не задан номер смены" .
     1415       end.
     1416     end.
     1417     else do:
     1418       assign
     1419         p-shift-date = p-fact-date
     1420         p-shift-num  = 24
     1421       .
     1422     end.
     1423     define variable v-shift-offset as integer no-undo .
     1424     if p-shift-date = p-fact-date
     1425     then do:
     1426       assign
     1427         v-shift-offset = 1
     1428       .
     1429     end.
     1430     if p-shift-date < p-fact-date
     1431     then do:
     1432       assign
     1433         v-shift-offset = 0
     1434       .
     1435     end.
     1436     if p-shift-date > p-fact-date
     1437     then do:
     1438       message
     1439         vss-workfile vss-revision vss-description skip
     1440         "Неправильная дата закрытия смены" skip
     1441         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1442         view-as alert-box error .
     1443       undo, return error
     1444         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1445           ,string(p-fact-date, '99/99/9999':U)
     1446           ,string(p-shift-date, '99/99/9999':U)
     1447           )
     1448       .
     1449     end.
     1450     if p-shift-num < 1
     1451     or p-shift-num > 24
     1452     then do:
     1453       message
     1454         vss-workfile vss-revision vss-description skip
     1455         "Неправильный номер смены" skip
     1456         "p-shift-num" p-shift-num skip
     1457         view-as alert-box error .
     1458       undo, return error return-value .
     1459     end.
     1460     assign
     1461       p-fact-order           = v-fact-date-num
     1462                              + v-shift-offset * 0.5
     1463                              + p-shift-num    * 0.02 - 0.01
     1464                              + p-fact-num     * 0.0000000001
     1465       p-shift-end-fact-order = v-fact-date-num
     1466                              + v-shift-offset * 0.5
     1467                              + p-shift-num    * 0.02
     1468       p-day-end-fact-order   = v-fact-date-num
     1469                              + 0.99
     1470     .
     1471     if p-fact-order           <= v-fact-date-num
     1472     or p-shift-end-fact-order <= v-fact-date-num
     1473     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1474     or p-shift-end-fact-order >= p-day-end-fact-order
     1475     then do:
     1476       message
     1477         vss-workfile vss-revision vss-description skip
     1478         "Внутренняя ошибка при генерации фактического номера" skip
     1479         "p-fact-date"            p-fact-date            skip
     1480         "p-fact-time"            p-fact-time            skip
     1481         "p-fact-num"             p-fact-num             skip
     1482         "p-shift-date"           p-shift-date           skip
     1483         "p-shift-num"            p-shift-num            skip
     1484         "p-shift-on"             p-shift-on             skip
     1485         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1486         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1487         "v-fact-date-num"        v-fact-date-num        skip
     1488         view-as alert-box error .
     1489       undo, return error return-value .
     1490     end.
     1491   end procedure.
     1492   procedure day-begin-fact-order :
     1493     define input  parameter p-fact-date            as date    no-undo .
     1494     define output parameter p-day-begin-fact-order as decimal no-undo .
     1495     do
     1496     on error undo, return error return-value
     1497     :
     1498       if p-fact-date = ?
     1499       then do:
     1500         assign
     1501           p-day-begin-fact-order = 0
     1502         .
     1503       end.
     1504       else do:
     1505         assign
     1506           p-day-begin-fact-order = integer(p-fact-date)
     1507         .
     1508       end.
     1509     end.
     1510   end procedure.
     1511   procedure factord-max-fact-order :
     1512     define output parameter p-max-fact-order as decimal   no-undo .
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       run day-begin-fact-order in this-procedure
     1517         (input  date(1, 1, 5000)
     1518         ,output p-max-fact-order
     1519         ) .
     1520     end.
     1521   end procedure.
     1522   procedure factord-cut-archive :
     1523     define input  parameter p-obj-type             as character no-undo .
     1524     define input  parameter p-obj-code             as integer   no-undo .
     1525     define input  parameter p-fact-date            as date      no-undo .
     1526     define output parameter p-shift-on             as logical   no-undo .
     1527     define output parameter p-shift-date           as date      no-undo .
     1528     define output parameter p-shift-num            as integer   no-undo .
     1529     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1530     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1531     define variable v-fact-order as decimal   no-undo .
     1532     define buffer buf_shift-obj for ub.shift-obj .
     1533     do
     1534     on error undo, return error return-value
     1535     :
     1536   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1537   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1538     (input  p-obj-type
     1539     ,input  p-obj-code
     1540     ,input  'shift-on=request'
     1541     ,output p-shift-on
     1542     ) no-error .
     1543       if error-status :error
     1544       then do:
     1545         message
     1546           vss-workfile vss-revision vss-description skip
     1547           "Ошибка при определении атрибута объекта" skip
     1548           "Объект" p-obj-type p-obj-code skip
     1549           error-status :get-message(1) skip
     1550           return-value skip
     1551           view-as alert-box error .
     1552         undo, return error return-value .
     1553       end.
     1554       if p-shift-on = false
     1555       then do:
     1556         assign
     1557           p-shift-date               = ?
     1558           p-shift-num                = 0
     1559         .
     1560       end.
     1561       else do:
     1562         find first buf_shift-obj share-lock
     1563           where buf_shift-obj.obj-type   = p-obj-type
     1564             and buf_shift-obj.obj-code   = p-obj-code
     1565             and buf_shift-obj.shift-date > p-fact-date
     1566           use-index pi
     1567           no-error .
     1568         if not available buf_shift-obj
     1569         or buf_shift-obj.status_ <> 'зкр':U
     1570         then do:
     1571           message
     1572             vss-workfile vss-revision vss-description skip
     1573             "Невозможно вычислить последнюю смену" skip
     1574             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1575             "Объект" p-obj-type p-obj-code skip
     1576             "Дата" p-fact-date skip
     1577             view-as alert-box error .
     1578           undo, return error return-value .
     1579         end.
     1580         find last buf_shift-obj share-lock
     1581           where buf_shift-obj.obj-type = p-obj-type
     1582             and buf_shift-obj.obj-code = p-obj-code
     1583             and buf_shift-obj.shift-date <= p-fact-date
     1584           use-index pi
     1585           no-error .
     1586         if available buf_shift-obj
     1587         then do:
     1588           if  buf_shift-obj.status_ = 'зкр':U
     1589           then do:
     1590             assign
     1591               p-shift-date = buf_shift-obj.shift-date
     1592               p-shift-num  = buf_shift-obj.shift-num
     1593             .
     1594           end.
     1595           else do:
     1596             message
     1597               vss-workfile vss-revision vss-description skip
     1598               "Невозможно вычислить последнюю смену" skip
     1599               "Статус смены отличен от статуса" 'зкр':U skip
     1600               "Объект" p-obj-type p-obj-code skip
     1601               "Дата" p-fact-date skip
     1602               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1603               view-as alert-box error .
     1604             undo, return error return-value .
     1605           end.
     1606         end.
     1607         else do:
     1608           assign
     1609             p-shift-date = p-fact-date - 1
     1610             p-shift-num  = 1
     1611           .
     1612         end.
     1613       end.
     1614       run factord in this-procedure
     1615         (input  p-fact-date
     1616         ,input  1
     1617         ,input  1
     1618         ,input  p-shift-date
     1619         ,input  p-shift-num
     1620         ,input  p-shift-on
     1621         ,output v-fact-order
     1622         ,output p-shift-end-fact-order
     1623         ,output p-day-end-fact-order
     1624         ) no-error .
     1625       if error-status :error
     1626       then do:
     1627         message
     1628           vss-workfile vss-revision vss-description skip
     1629           "Ошибка при вызове процедуры factord"
     1630           error-status :get-message(1) skip
     1631           return-value skip
     1632           view-as alert-box error .
     1633         undo, return error return-value .
     1634       end.
     1635     end.
     1636   end procedure.
     1637   procedure factord-lock-shift :
     1638     define input  parameter p-obj-type  as character no-undo .
     1639     define input  parameter p-obj-code  as integer   no-undo .
     1640     define input  parameter p-fact-date as date      no-undo .
     1641     define parameter buffer buf_shift-obj for ub.shift-obj .
     1642     define variable v-shift-on      as logical   no-undo .
     1643     define variable v-extra-message as character no-undo .
     1644     define variable v-error as character no-undo .
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1649   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1650     (input  p-obj-type
     1651     ,input  p-obj-code
     1652     ,input  'shift-on=request'
     1653     ,output v-shift-on
     1654     ) no-error .
     1655       if error-status :error
     1656       then do:
     1657         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1658         undo, return error v-error .
     1659       end.
     1660       if v-shift-on = true
     1661       then do:
     1662         find first buf_shift-obj share-lock
     1663           where buf_shift-obj.obj-type   = p-obj-type
     1664             and buf_shift-obj.obj-code   = p-obj-code
     1665             and buf_shift-obj.shift-date > p-fact-date
     1666           use-index pi
     1667           no-error .
     1668         if not available buf_shift-obj
     1669         or buf_shift-obj.status_ <> 'зкр':U
     1670         then do:
     1671           find last buf_shift-obj
     1672             where buf_shift-obj.obj-type = p-obj-type
     1673               and buf_shift-obj.obj-code = p-obj-code
     1674               and buf_shift-obj.status_  = 'зкр':U
     1675             use-index stts
     1676             no-error .
     1677           if available buf_shift-obj
     1678           then do:
     1679             assign
     1680               v-extra-message =
     1681                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1682                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1683                               )
     1684             .
     1685           end.
     1686           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1687           undo, return error v-error .
     1688         end.
     1689       end.
     1690     end.
     1691   end procedure.
     1692   procedure factord-end-day :
     1693     define input  parameter p-fact-date            as date    no-undo .
     1694     define output parameter p-day-end-fact-order   as decimal no-undo .
     1695     do
     1696     on error undo, return error return-value
     1697     :
     1698       if p-fact-date = ?
     1699       then do:
     1700         return error "Не указана фактическая дата" .
     1701       end.
     1702       assign
     1703         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1704       .
     1705     end.
     1706   end procedure.
     1707   procedure factord-to-date :
     1708     define input  parameter p-fact-order as decimal no-undo .
     1709     define output parameter p-fact-date  as date    no-undo .
     1710     define variable v-ref-date  as date      no-undo .
     1711     define variable v-ref-delta as integer   no-undo .
     1712     do
     1713     on error undo, return error return-value
     1714     :
     1715       if p-fact-order = ?
     1716       or p-fact-order = 0
     1717       then do:
     1718         return error "Не указан fact-order" .
     1719       end.
     1720       assign
     1721         v-ref-date  = date(1, 1, 2000)
     1722       .
     1723       assign
     1724         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1725       .
     1726       assign
     1727         p-fact-date = v-ref-date + v-ref-delta
     1728       .
     1729     end.
     1730   end procedure.
     1731   procedure factord-to-fact-num :
     1732     define input  parameter p-fact-order as decimal no-undo .
     1733     define output parameter p-fact-num   as integer no-undo .
     1734     define variable v-fact-order-trunc as decimal no-undo .
     1735     do
     1736     on error undo, return error return-value
     1737     :
     1738       if p-fact-order = ?
     1739       or p-fact-order = 0
     1740       then do:
     1741         return error "Не указан fact-order" .
     1742       end.
     1743       assign
     1744        v-fact-order-trunc = truncate(p-fact-order, 2)
     1745       .
     1746       assign
     1747         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1748       .
     1749     end.
     1750   end procedure.
     1751   procedure factord-to-shift-num :
     1752     define input  parameter p-fact-order as decimal no-undo .
     1753     define output parameter p-shift-num   as integer no-undo .
     1754     define variable  p-shift-numd  as decimal   no-undo .
     1755     define variable v-fact-order-trunc as decimal no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       if p-fact-order = ?
     1760       or p-fact-order = 0
     1761       then do:
     1762         return error "Не указан fact-order" .
     1763       end.
     1764       assign
     1765        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1766       .
     1767       if v-fact-order-trunc < 0.5 then do:
     1768         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1769       end.
     1770       assign
     1771         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1772         .
     1773        assign
     1774         p-shift-num = truncate (p-shift-numd , 0)
     1775       .
     1776     end.
     1777   end procedure.
     1778   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1779   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
     1780   procedure partslib-clear-temp-parts :
     1781     define buffer buf_temp-parts for temp-parts .
     1782     do
     1783     on error undo, return error
     1784     :
     1785       for each buf_temp-parts
     1786       on error undo, return error
     1787       :
     1788         delete buf_temp-parts .
     1789       end.
     1790     end.
     1791   end procedure.
     1792   procedure partslib-create-temp-parts :
     1793     define parameter buffer buf_parts       for ub.parts .
     1794     define parameter buffer buf_temp-parts  for temp-parts .
     1795     define input  parameter p-goods-twounit as logical   no-undo .
     1796     define variable v-base-part-code as character no-undo .
     1797     do
     1798     on error undo, return error
     1799     :
     1800       if p-goods-twounit = true
     1801       then do:
     1802         assign
     1803           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
     1804         .
     1805       end.
     1806       else do:
     1807         assign
     1808           v-base-part-code = buf_parts.part-code
     1809         .
     1810       end.
     1811       find first buf_temp-parts exclusive-lock
     1812         where buf_temp-parts.obj-type  = buf_parts.obj-type
     1813           and buf_temp-parts.obj-code  = buf_parts.obj-code
     1814           and buf_temp-parts.artic     = buf_parts.artic
     1815           and buf_temp-parts.prod-type = buf_parts.prod-type
     1816           and buf_temp-parts.prod-code = buf_parts.prod-code
     1817           and buf_temp-parts.in-code   = buf_parts.in-code
     1818           and buf_temp-parts.out-code  = 'free-zone':U
     1819           and buf_temp-parts.part-code = v-base-part-code
     1820         no-error.
     1821       if not available buf_temp-parts
     1822       then do:
     1823         create buf_temp-parts .
     1824         buffer-copy buf_parts to buf_temp-parts
     1825         assign
     1826           buf_temp-parts.out-code  = 'free-zone':U
     1827           buf_temp-parts.part-code = v-base-part-code
     1828           buf_temp-parts.rsrv-free = yes
     1829           buf_temp-parts.status_   = no
     1830           buf_temp-parts.qnty      = 0
     1831           buf_temp-parts.fact-qnty = 0
     1832           buf_temp-parts.real-qnty = 0
     1833           buf_temp-parts.cli-qnty  = 0
     1834         .
     1835       end.
     1836     end.
     1837   end procedure.
     1838   procedure partslib-init-temp-parts :
     1839     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1840     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1841     define input parameter p-artic           like ub.parts.artic     no-undo .
     1842     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1843     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1844     define buffer buf_parts      for ub.parts .
     1845     define buffer buf_temp-parts for temp-parts .
     1846     define variable v-goods-twounit    as logical   no-undo .
     1847     do
     1848     on error undo, return error
     1849     :
     1850   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1851   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1852     (input  p-artic
     1853     ,input  p-prod-type
     1854     ,input  p-prod-code
     1855     ,input  'twounit=request':u
     1856     ,output v-goods-twounit
     1857     ) no-error .
     1858       if error-status :error
     1859       then do:
     1860         message
     1861           vss-workfile vss-revision vss-description skip
     1862           vss-include-info18 skip
     1863           "Ошибка при определении атрибута товара" skip
     1864           "Артикул" p-artic p-prod-type p-prod-code skip
     1865           "twounit=request" skip
     1866           error-status :get-message(1) skip
     1867           return-value skip
     1868           view-as alert-box error .
     1869         undo, return error return-value .
     1870       end.
     1871       run partslib-clear-temp-parts in this-procedure .
     1872       for each buf_parts
     1873         where buf_parts.obj-type  = p-obj-type
     1874           and buf_parts.obj-code  = p-obj-code
     1875           and buf_parts.artic     = p-artic
     1876           and buf_parts.prod-type = p-prod-type
     1877           and buf_parts.prod-code = p-prod-code
     1878           and buf_parts.rsrv-free = yes
     1879           and buf_parts.status_   = no
     1880           and buf_parts.in-code   <> buf_parts.out-code
     1881       on error undo, return error
     1882       :
     1883         run partslib-create-temp-parts in this-procedure
     1884           (buffer buf_parts
     1885           ,buffer buf_temp-parts
     1886           ,input  v-goods-twounit
     1887           ) .
     1888         define variable v-parts-qnty          as decimal   no-undo .
     1889         define variable v-parts-cli-qnty      as decimal   no-undo .
     1890         define variable v-parts-free-qnty     as decimal   no-undo .
     1891         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1892         if buf_parts.out-code = 'free-zone':U
     1893         then do:
     1894           assign
     1895             v-parts-qnty          = buf_parts.qnty
     1896             v-parts-cli-qnty      = buf_parts.cli-qnty
     1897             v-parts-free-qnty     = buf_parts.qnty
     1898             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1899           .
     1900         end.
     1901         else do:
     1902           assign
     1903             v-parts-qnty          = abs(buf_parts.qnty)
     1904             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1905             v-parts-free-qnty     = 0
     1906             v-parts-free-cli-qnty = 0
     1907           .
     1908         end.
     1909         assign
     1910           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1911           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1912           buf_temp-parts.real-qnty     = 0
     1913           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1914           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1915           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1916         .
     1917       end.
     1918     end.
     1919   end procedure.
     1920   procedure partslib-init-temp-parts-by-factord :
     1921     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1922     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1923     define input parameter p-artic              like ub.parts.artic     no-undo .
     1924     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1925     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1926     define input parameter p-fact-order         as decimal   no-undo .
     1927     define input parameter p-include-fact-order as logical   no-undo .
     1928     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1929     define buffer buf_gds-obj  for ub.gds-obj .
     1930     do
     1931     on error undo, return error
     1932     :
     1933       do transaction
     1934       on error undo, return error
     1935       :
     1936   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1937   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1938     (input  p-obj-type
     1939     ,input  p-obj-code
     1940     ,input  p-artic
     1941     ,input  p-prod-type
     1942     ,input  p-prod-code
     1943     ,buffer buf_gds-obj
     1944     ) no-error .
     1945         if error-status :error
     1946         then do:
     1947           message
     1948             vss-workfile vss-revision vss-description skip
     1949             vss-include-info18 skip
     1950             "Невозможно найти товар на объекте" skip
     1951             "Объект" p-obj-type p-obj-code skip
     1952             "Артикул" p-artic p-prod-type p-prod-code skip
     1953             error-status :get-message(1) skip
     1954             return-value skip
     1955             view-as alert-box error .
     1956           undo, return error .
     1957         end.
     1958         find current buf_gds-obj exclusive-lock .
     1959       end.
     1960       run partslib-init-temp-parts in this-procedure
     1961         (input p-obj-type
     1962         ,input p-obj-code
     1963         ,input p-artic
     1964         ,input p-prod-type
     1965         ,input p-prod-code
     1966         ) no-error .
     1967       if error-status :error
     1968       then do:
     1969         message
     1970           vss-workfile vss-revision vss-description skip
     1971           vss-include-info18 skip
     1972           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1973           "Объект" p-obj-type p-obj-code skip
     1974           "Артикул" p-artic p-prod-type p-prod-code skip
     1975           "p-fact-order" p-fact-order skip
     1976           view-as alert-box error .
     1977         undo, return error .
     1978       end.
     1979       if p-include-fact-order = true
     1980       then do:
     1981         assign
     1982           p-fact-order = p-fact-order - 0.0000000001
     1983         .
     1984       end.
     1985       define variable v-max-fact-order as character no-undo .
     1986       run factord-max-fact-order in this-procedure
     1987         (output v-max-fact-order
     1988         ) no-error .
     1989       if error-status :error
     1990       then do:
     1991         message
     1992           vss-workfile vss-revision vss-description skip
     1993           vss-include-info18 skip
     1994           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1995           "Объект" p-obj-type p-obj-code skip
     1996           "Артикул" p-artic p-prod-type p-prod-code skip
     1997           "p-fact-order" p-fact-order skip
     1998           view-as alert-box error .
     1999         undo, return error .
     2000       end.
     2001       run partslib-update-by-factord in this-procedure
     2002         (input p-obj-type
     2003         ,input p-obj-code
     2004         ,input p-artic
     2005         ,input p-prod-type
     2006         ,input p-prod-code
     2007         ,input p-fact-order
     2008         ,input v-max-fact-order
     2009         ,input false
     2010         ) no-error .
     2011       if error-status :error
     2012       then do:
     2013         message
     2014           vss-workfile vss-revision vss-description skip
     2015           vss-include-info18 skip
     2016           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     2017           "Объект" p-obj-type p-obj-code skip
     2018           "Артикул" p-artic p-prod-type p-prod-code skip
     2019           "p-fact-order" p-fact-order skip
     2020           "v-max-fact-order" v-max-fact-order skip
     2021           view-as alert-box error .
     2022         undo, return error .
     2023       end.
     2024     end.
     2025   end procedure.
     2026   procedure partslib-update-by-factord :
     2027     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     2028     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     2029     define input parameter p-artic              like ub.parts.artic     no-undo .
     2030     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     2031     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     2032     define input parameter p-start-fact-order   as decimal   no-undo .
     2033     define input parameter p-end-fact-order     as decimal   no-undo .
     2034     define input parameter p-lock-gds-obj       as logical   no-undo .
     2035     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     2036     define buffer buf_gds-obj  for ub.gds-obj .
     2037     define buffer buf_doc-line for ub.doc-line .
     2038     define variable v-total-parts-qnty as decimal   no-undo .
     2039     define variable v-goods-gds-goods  as logical   no-undo .
     2040     define variable v-goods-twounit    as logical   no-undo .
     2041     do
     2042     on error undo, return error
     2043     :
     2044       if p-start-fact-order > p-end-fact-order
     2045       then do:
     2046         message
     2047           vss-workfile vss-revision vss-description skip
     2048           vss-include-info18 skip
     2049           "Ошибка задания входных параметров" skip
     2050           "Начало интервала превышает конец интервала" skip
     2051           "Объект" p-obj-type p-obj-code skip
     2052           "Артикул" p-artic p-prod-type p-prod-code skip
     2053           "p-start-fact-order" p-start-fact-order skip
     2054           "p-end-fact-order"   p-end-fact-order skip
     2055           view-as alert-box error .
     2056         undo, return error .
     2057       end.
     2058       if p-lock-gds-obj = true
     2059       then do:
     2060         do transaction
     2061         on error undo, return error
     2062         :
     2063   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2064   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2065     (input  p-obj-type
     2066     ,input  p-obj-code
     2067     ,input  p-artic
     2068     ,input  p-prod-type
     2069     ,input  p-prod-code
     2070     ,buffer buf_gds-obj
     2071     ) no-error .
     2072           if error-status :error
     2073           then do:
     2074             message
     2075               vss-workfile vss-revision vss-description skip
     2076               vss-include-info18 skip
     2077               "Невозможно найти gds-obj" skip
     2078               error-status :get-message(1) skip
     2079               return-value skip
     2080               view-as alert-box error .
     2081             undo, return error .
     2082           end.
     2083           find current buf_gds-obj exclusive-lock .
     2084         end.
     2085       end.
     2086   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2087   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2088     (input  p-artic
     2089     ,input  p-prod-type
     2090     ,input  p-prod-code
     2091     ,input  'gds-goods=request':u
     2092     ,output v-goods-gds-goods
     2093     ) no-error .
     2094       if error-status :error
     2095       then do:
     2096         message
     2097           vss-workfile vss-revision vss-description skip
     2098           vss-include-info18 skip
     2099           "Ошибка при определении атрибута товара" skip
     2100           "Артикул" p-artic p-prod-type p-prod-code skip
     2101           "gds-goods=request" skip
     2102           error-status :get-message(1) skip
     2103           return-value skip
     2104           view-as alert-box error .
     2105         undo, return error return-value .
     2106       end.
     2107   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2109     (input  p-artic
     2110     ,input  p-prod-type
     2111     ,input  p-prod-code
     2112     ,input  'twounit=request':u
     2113     ,output v-goods-twounit
     2114     ) no-error .
     2115       if error-status :error
     2116       then do:
     2117         message
     2118           vss-workfile vss-revision vss-description skip
     2119           vss-include-info18 skip
     2120           "Ошибка при определении атрибута товара" skip
     2121           "Артикул" p-artic p-prod-type p-prod-code skip
     2122           "twounit=request" skip
     2123           error-status :get-message(1) skip
     2124           return-value skip
     2125           view-as alert-box error .
     2126         undo, return error return-value .
     2127       end.
     2128       for each buf_doc-line no-lock
     2129         where buf_doc-line.obj-type   = p-obj-type
     2130           and buf_doc-line.obj-code   = p-obj-code
     2131           and buf_doc-line.artic      = p-artic
     2132           and buf_doc-line.prod-type  = p-prod-type
     2133           and buf_doc-line.prod-code  = p-prod-code
     2134           and buf_doc-line.status_    = 'факт':U
     2135           and buf_doc-line.fact-order > p-start-fact-order
     2136           and buf_doc-line.fact-order <= p-end-fact-order
     2137       on error undo, return error
     2138       :
     2139         run partslib-process-document in this-procedure
     2140           (input  buf_doc-line.doc-code
     2141           ,input  p-obj-type
     2142           ,input  p-obj-code
     2143           ,input  p-artic
     2144           ,input  p-prod-type
     2145           ,input  p-prod-code
     2146           ,input  v-goods-gds-goods
     2147           ,input  v-goods-twounit
     2148           ,output v-total-parts-qnty
     2149           ) no-error .
     2150         if error-status :error
     2151         then do:
     2152           message
     2153             vss-workfile vss-revision vss-description skip
     2154             vss-include-info18 skip
     2155             "Ошибка при вызове процедуры partslib-process-document" skip
     2156             "Документ" buf_doc-line.doc-code skip
     2157             "Объект" p-obj-type p-obj-code skip
     2158             "Артикул" p-artic p-prod-type p-prod-code skip
     2159             "p-start-fact-order" p-start-fact-order skip
     2160             "p-end-fact-order" p-end-fact-order skip
     2161             error-status :get-message(1) skip
     2162             return-value skip
     2163             view-as alert-box error .
     2164           undo, return error return-value .
     2165         end.
     2166       end.
     2167     end.
     2168   end procedure.
     2169   procedure partslib-process-document :
     2170     define input  parameter p-doc-code         as character no-undo .
     2171     define input  parameter p-obj-type         as character no-undo .
     2172     define input  parameter p-obj-code         as integer   no-undo .
     2173     define input  parameter p-artic            as character no-undo .
     2174     define input  parameter p-prod-type        as character no-undo .
     2175     define input  parameter p-prod-code        as integer   no-undo .
     2176     define input  parameter p-goods-gds-goods  as logical   no-undo .
     2177     define input  parameter p-goods-twounit    as logical   no-undo .
     2178     define output parameter p-total-parts-qnty as decimal   no-undo .
     2179     define variable v-parts-sign as integer   no-undo .
     2180     define buffer buf_trn-doc    for ub.trn-doc .
     2181     define buffer buf_doc-line   for ub.doc-line .
     2182     define buffer buf_parts      for ub.parts .
     2183     define buffer buf_temp-parts for temp-parts .
     2184     do
     2185     on error undo, return error return-value
     2186     :
     2187       find first buf_trn-doc no-lock
     2188         where buf_trn-doc.doc-code = p-doc-code
     2189         no-error .
     2190       if not available buf_trn-doc
     2191       then do:
     2192         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     2193                                      ,p-doc-code
     2194                                      ) .
     2195       end.
     2196       case buf_trn-doc.doc-type
     2197       :
     2198         when 'при':U or
     2199         when 'возврат':U or
     2200         when 'инв':U
     2201         then do:
     2202           assign
     2203             v-parts-sign = -1
     2204           .
     2205         end.
     2206         when 'рас':U or
     2207         when 'спи':U
     2208         then do:
     2209           assign
     2210             v-parts-sign = 1
     2211           .
     2212         end.
     2213         otherwise do:
     2214           undo, return error substitute("Неизвестный тип документа &1"
     2215                                       ,buf_trn-doc.doc-type
     2216                                       ) .
     2217         end.
     2218       end.
     2219       find first buf_doc-line no-lock
     2220         where buf_doc-line.doc-code  = p-doc-code
     2221           and buf_doc-line.artic     = p-artic
     2222           and buf_doc-line.prod-type = p-prod-type
     2223           and buf_doc-line.prod-code = p-prod-code
     2224         no-error .
     2225       if not available buf_doc-line
     2226       then do:
     2227         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     2228                                      ,p-doc-code
     2229                                      ,artic
     2230                                      ,prod-type
     2231                                      ,prod-code
     2232                                      ) .
     2233       end.
     2234       assign
     2235         p-total-parts-qnty = 0
     2236       .
     2237       if p-goods-gds-goods = true
     2238       then do:
     2239         for each buf_parts no-lock
     2240           where buf_parts.out-code  = p-doc-code
     2241             and buf_parts.obj-type  = p-obj-type
     2242             and buf_parts.obj-code  = p-obj-code
     2243             and buf_parts.artic     = p-artic
     2244             and buf_parts.prod-type = p-prod-type
     2245             and buf_parts.prod-code = p-prod-code
     2246         on error undo, return error
     2247         :
     2248           run partslib-create-temp-parts in this-procedure
     2249             (buffer buf_parts
     2250             ,buffer buf_temp-parts
     2251             ,input  p-goods-twounit
     2252             ) .
     2253           assign
     2254             p-total-parts-qnty        = p-total-parts-qnty
     2255                                       + v-parts-sign * buf_parts.fact-qnty
     2256             buf_temp-parts.qnty       = buf_temp-parts.qnty
     2257                                       + v-parts-sign * buf_parts.fact-qnty
     2258             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     2259                                       + v-parts-sign * buf_parts.fact-qnty
     2260             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     2261                                       + v-parts-sign * buf_parts.cli-qnty
     2262           .
     2263           if buf_temp-parts.qnty = 0
     2264           then do:
     2265             delete buf_temp-parts .
     2266           end.
     2267         end.
     2268       end.
     2269       else do:
     2270         assign
     2271           p-total-parts-qnty = p-total-parts-qnty
     2272                              + v-parts-sign * buf_doc-line.fact-qnty
     2273         .
     2274       end.
     2275     end.
     2276   end procedure.
     2277   procedure partslib-init-temp-parts-by-date :
     2278     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     2279     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     2280     define input parameter p-artic           like ub.parts.artic     no-undo .
     2281     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     2282     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     2283     define input parameter p-fact-date       as date      no-undo .
     2284     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     2285     do
     2286     on error undo, return error
     2287     :
     2288       define variable v-fact-order                as decimal   no-undo .
     2289       define variable v-shift-end-fact-order      as decimal   no-undo .
     2290       define variable v-day-end-fact-order        as decimal   no-undo .
     2291       run factord in this-procedure
     2292         (input  p-fact-date
     2293         ,input  1
     2294         ,input  1
     2295         ,input  ?
     2296         ,input  0
     2297         ,input  false
     2298         ,output v-fact-order
     2299         ,output v-shift-end-fact-order
     2300         ,output v-day-end-fact-order
     2301         ) no-error .
     2302       if error-status :error
     2303       then do:
     2304         message
     2305           vss-workfile vss-revision vss-description skip
     2306           vss-include-info18 skip
     2307           "Ошибка при определении момента времени, на который требуется остаток" skip
     2308           "Объект" p-obj-type p-obj-code skip
     2309           "Артикул" p-artic p-prod-type p-prod-code skip
     2310           "Дата" p-fact-date skip
     2311           view-as alert-box error .
     2312         undo, return error .
     2313       end.
     2314       run partslib-init-temp-parts-by-factord in this-procedure
     2315         (input p-obj-type
     2316         ,input p-obj-code
     2317         ,input p-artic
     2318         ,input p-prod-type
     2319         ,input p-prod-code
     2320         ,input v-day-end-fact-order
     2321         ,input false
     2322         ) no-error .
     2323       if error-status :error
     2324       then do:
     2325         message
     2326           vss-workfile vss-revision vss-description skip
     2327           vss-include-info18 skip
     2328           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     2329           "Объект" p-obj-type p-obj-code skip
     2330           "Артикул" p-artic p-prod-type p-prod-code skip
     2331           "Дата" p-fact-date skip
     2332           view-as alert-box error .
     2333         undo, return error .
     2334       end.
     2335     end.
     2336   end procedure.
     2337   procedure partslib-calc-cost :
     2338     define output parameter p-fact-qnty      as decimal   no-undo .
     2339     define output parameter p-vat-pc         as decimal   no-undo .
     2340     define output parameter p-slt-pc         as decimal   no-undo .
     2341     define output parameter p-sum-base       as decimal   no-undo .
     2342     define output parameter p-sum-rubl       as decimal   no-undo .
     2343     define output parameter p-vat-base       as decimal   no-undo .
     2344     define output parameter p-vat-rubl       as decimal   no-undo .
     2345     define output parameter p-slt-base       as decimal   no-undo .
     2346     define output parameter p-slt-rubl       as decimal   no-undo .
     2347     define output parameter p-road-tax-base  as decimal   no-undo .
     2348     define output parameter p-road-tax-rubl  as decimal   no-undo .
     2349     define output parameter p-transport-base as decimal   no-undo .
     2350     define output parameter p-transport-rubl as decimal   no-undo .
     2351     define output parameter p-other-base     as decimal   no-undo .
     2352     define output parameter p-other-rubl     as decimal   no-undo .
     2353     define output parameter p-excise-base    as decimal   no-undo .
     2354     define output parameter p-excise-rubl    as decimal   no-undo .
     2355     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     2356     do
     2357     on error undo, return error return-value
     2358     :
     2359       define buffer buf_temp-parts for temp-parts .
     2360       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     2361       define buffer   in-vatp-parts    for ub.parts   .
     2362       define buffer   in-vatp-doc      for ub.trn-doc .
     2363       define buffer   in-vatp-goods    for ub.goods   .
     2364       define buffer   in-vatp-sysconf  for ub.sysconf .
     2365       define buffer   in-vatp_doc-attr for ub.doc-attr.
     2366       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     2367       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     2368       define variable varinvprb                  as   character              no-undo.
     2369       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     2370       define variable cli-base-rate              as   decimal                no-undo.
     2371       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     2372       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     2373       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     2374       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     2375       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     2376       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     2377       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     2378       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2379       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     2380       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     2381       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     2382       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     2383       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     2384       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     2385       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     2386       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     2387       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     2388       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     2389       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     2390       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     2391       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     2392       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     2393       define variable varinvatp-envd             as   character              no-undo.
     2394       define variable varinvatp-type             as   character              no-undo.
     2395       for each buf_temp-parts
     2396       on error undo, return error
     2397       :
     2398   assign
     2399     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     2400     price-base-with-tax-loc = buf_temp-parts.price-base
     2401   .
     2402   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2404     (output varinvprb
     2405     )  .
     2406     if buf_temp-parts.out-code = 'free-zone':U     or
     2407        buf_temp-parts.out-code = 'out-zone':U   or
     2408        buf_temp-parts.doc-type = 'акт':U then do:
     2409       assign
     2410         in-vatp-have-vat-slt = yes.
     2411     end.
     2412     else do:
     2413       find first in-vatp_doc-attr no-lock
     2414         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     2415           and in-vatp_doc-attr.attr-code = 'envd':U
     2416         no-error .
     2417       if not available in-vatp_doc-attr then do:
     2418         assign
     2419           in-vatp-have-vat-slt = yes.
     2420       end.
     2421       else do:
     2422            in-vatp-have-vat-slt = no.
     2423       end.
     2424     end.
     2425     assign
     2426      price-cli-with-tax-loc = buf_temp-parts.price-cli
     2427      cli-base-rate          = buf_temp-parts.cli-base-rate.
     2428     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     2429              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     2430     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     2431             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     2432             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     2433             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     2434             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     2435             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     2436             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2437       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     2438     assign
     2439       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     2440     assign
     2441       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     2442       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     2443       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     2444       transport-cli-loc  = 0
     2445       other-cli-loc      = 0
     2446     .
     2447   ASSIGN
     2448             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     2449       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     2450   .
     2451         assign
     2452           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     2453           p-vat-pc         = p-vat-pc         + vat-pc-loc
     2454           p-slt-pc         = p-slt-pc         + slt-pc-loc
     2455           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     2456           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     2457           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     2458           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     2459           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     2460           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     2461           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     2462           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     2463           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     2464           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     2465           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     2466           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     2467           p-excise-base    = p-excise-base    + 0
     2468           p-excise-rubl    = p-excise-rubl    + 0
     2469         .
     2470       end.
     2471       if p-fact-qnty      = ?
     2472       or p-sum-base       = ?
     2473       or p-sum-rubl       = ?
     2474       or p-vat-base       = ?
     2475       or p-vat-rubl       = ?
     2476       or p-slt-base       = ?
     2477       or p-slt-rubl       = ?
     2478       or p-road-tax-base  = ?
     2479       or p-road-tax-rubl  = ?
     2480       or p-transport-base = ?
     2481       or p-transport-rubl = ?
     2482       or p-other-base     = ?
     2483       or p-other-rubl     = ?
     2484       or p-excise-base    = ?
     2485       or p-excise-rubl    = ?
     2486       then do:
     2487         message
     2488           vss-workfile vss-revision vss-description skip
     2489           vss-include-info18 skip
     2490           "Программа in-vatp.i вернула неопределенные значения" skip
     2491           "p-fact-qnty"      p-fact-qnty      skip
     2492           "p-sum-base"       p-sum-base       skip
     2493           "p-sum-rubl"       p-sum-rubl       skip
     2494           "p-vat-base"       p-vat-base       skip
     2495           "p-vat-rubl"       p-vat-rubl       skip
     2496           "p-slt-base"       p-slt-base       skip
     2497           "p-slt-rubl"       p-slt-rubl       skip
     2498           "p-road-tax-base"  p-road-tax-base  skip
     2499           "p-road-tax-rubl"  p-road-tax-rubl  skip
     2500           "p-transport-base" p-transport-base skip
     2501           "p-transport-rubl" p-transport-rubl skip
     2502           "p-other-base"     p-other-base     skip
     2503           "p-other-rubl"     p-other-rubl     skip
     2504           "p-excise-base"    p-excise-base    skip
     2505           "p-excise-rubl"    p-excise-rubl    skip
     2506           view-as alert-box error .
     2507         undo, return error .
     2508       end.
     2509     end.
     2510   end procedure.
     2511   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2512   procedure prl-vat:
     2513     define input parameter parrecid as recid no-undo.
     2514       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     2515       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     2516       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     2517       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     2518       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     2519       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2520       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     2521       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
     2522       define output parameter slt-base-saleprl               like ub.doc-line.price-base no-undo.
     2523       define output parameter slt-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     2524       define output parameter road-tax-base-saleprl          like ub.doc-line.road-tax   no-undo.
     2525       define output parameter road-tax-rubl-saleprl          like ub.doc-line.road-tax   no-undo.
     2526       define output parameter excise-base-saleprl            like ub.doc-line.price-base no-undo.
     2527       define output parameter excise-rubl-saleprl            like ub.doc-line.price-rubl no-undo.
     2528       define output parameter discnt-base-saleprl            like ub.gds-dtl.discnt-base no-undo.
     2529       define output parameter discnt-rubl-saleprl            like ub.gds-dtl.discnt-rubl no-undo.
     2530       define buffer out-vatp_gds-dtlprl     for ub.gds-dtl.
     2531       define buffer buf_out-vatp_gds-dtlprl for ub.gds-dtl.
     2532       define buffer out-vatp_partsprl       for ub.parts.
     2533       define buffer out-vatp_sysconfprl     for ub.sysconf.
     2534       define buffer out-vatp_doc-lineprl    for ub.doc-line.
