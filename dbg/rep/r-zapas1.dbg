     7140   procedure Run1 :
     7141    do
     7142    on error undo, return error return-value
     7143    :
     7144     case RetSortType  :
     7145     when "sort-code":U  then DO:
     7146          CAse Select-Good :
     7147           when 1   then DO:
     7148   define variable vss-include-info47 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7149   for each gds-obj
     7150       where  gds-obj.obj-code   = x-store-code
     7151         and  gds-obj.obj-type   = x-store-type
     7152                                   no-lock ,
     7153       first goods
     7154             where gds-obj.prod-code  = goods.prod-code and
     7155                   gds-obj.prod-type  = goods.prod-type and
     7156                   gds-obj.artic      = goods.artic  no-lock ,
     7157       first b-clients no-lock where b-clients.obj-type = goods.prod-type and
     7158                                     b-clients.obj-code = goods.prod-code
     7159             break
     7160             by goods.gds-code :
     7161     assign
     7162         gds-zap-unit-base  = goods.unit-base
     7163         gds-zap-prt-root   = goods.prt-root
     7164         gds-zap-prod-type  = goods.prod-type
     7165         gds-zap-prod-code  = goods.prod-code
     7166         gds-zap-artic      = goods.artic
     7167         gds-zap-grp-name   = goods.grp-name
     7168         gds-zap-b-code     = goods.gds-code
     7169         gds-zap-prod-name  = b-clients.obj-name
     7170         gds-zap-gds-name   = if g#gds-engl then goods.engl-name else goods.gds-name
     7171     .
     7172         gds-zap-gds-long-name = substring(
     7173                   (if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     7174                   (if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120 ) .
     7175   if Parts-Det then do :
     7176     if zap-date < today then do:
     7177       run partslib-init-temp-parts-by-factord in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code, input v-fact-order-end, input false ) .
     7178     end.
     7179     else do:
     7180       run partslib-init-temp-parts in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code ) .
     7181     end.
     7182   end.
     7183        run foreach.
     7184        run display-line.
     7185   end.
     7186     End.
     7187           when 2   then DO:
     7188   define variable vss-include-info48 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7189   for each gds-obj
     7190       where  gds-obj.obj-code   = x-store-code
     7191         and  gds-obj.obj-type   = x-store-type
     7192                               and
     7193                               can-find(first tmp#grp
     7194                               where  gds-obj.grp-name   begins  tmp#grp.grp-name) = true
     7195                               no-lock,
     7196       first goods
     7197             where gds-obj.prod-code  = goods.prod-code and
     7198                   gds-obj.prod-type  = goods.prod-type and
     7199                   gds-obj.artic      = goods.artic   no-lock ,
     7200       first b-clients no-lock where b-clients.obj-type = goods.prod-type and
     7201                                     b-clients.obj-code = goods.prod-code
     7202             break
     7203             by goods.gds-code:
     7204     assign
     7205         gds-zap-unit-base  = goods.unit-base
     7206         gds-zap-prt-root   = goods.prt-root
     7207         gds-zap-prod-type  = goods.prod-type
     7208         gds-zap-prod-code  = goods.prod-code
     7209         gds-zap-artic      = goods.artic
     7210         gds-zap-grp-name   = goods.grp-name
     7211         gds-zap-b-code     = goods.gds-code
     7212         gds-zap-prod-name  = b-clients.obj-name
     7213         gds-zap-gds-name   = if g#gds-engl then goods.engl-name else goods.gds-name
     7214     .
     7215         gds-zap-gds-long-name = substring(
     7216                   (if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     7217                   (if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120 ) .
     7218   if Parts-Det then do :
     7219     if zap-date < today then do:
     7220       run partslib-init-temp-parts-by-factord in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code, input v-fact-order-end, input false ) .
     7221     end.
     7222     else do:
     7223       run partslib-init-temp-parts in this-procedure( input gds-obj.obj-type, input gds-obj.obj-code, input gds-obj.artic, input gds-obj.prod-type, input gds-obj.prod-code ) .
     7224     end.
     7225   end.
     7226        run foreach.
     7227        run display-line.
     7228   end.
     7229     End.
     7230           when 3  then DO:
     7231   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7232   for each gds-obj
     7233       where  gds-obj.obj-code   = x-store-code
     7234         and  gds-obj.obj-type   = x-store-type
     7235         and
     7236       can-find( first g#cli
     7237       where  gds-obj.prod-code  = g#cli.obj-code
     7238         and  gds-obj.prod-type  = g#cli.obj-type) = true no-lock,
     7239       first goods
     7240             where gds-obj.prod-code  = goods.prod-code and
     7241                   gds-obj.prod-type  = goods.prod-type and
     7242                   gds-obj.artic      = goods.artic  no-lock ,
     7243       first b-clients no-lock where b-clients.obj-type = goods.prod-type and
     7244                                     b-clients.obj-code = goods.prod-code
     7245             break
     7246             by goods.gds-code :
     7247     assign
     7248         gds-zap-unit-base  = goods.unit-base
     7249         gds-zap-prt-root   = goods.prt-root
     7250         gds-zap-prod-type  = goods.prod-type
     7251         gds-zap-prod-code  = goods.prod-code
     7252         gds-zap-artic      = goods.artic
     7253         gds-zap-grp-name   = goods.grp-name
     7254         gds-zap-b-code     = goods.gds-code
     7255         gds-zap-prod-name  = b-clients.obj-name
     7256         gds-zap-gds-name   = if g#gds-engl then goods.engl-name else goods.gds-name
     7257     .
     7258         gds-zap-gds-long-name = substring(
     7259                   (if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
