     2537       define buffer out-vatp_doc-attrprl    for ub.doc-attr.
     2538       define variable varprice-base-consprl      like ub.doc-line.price-base initial 0.00 no-undo.
     2539       define variable varprice-rubl-consprl      like ub.doc-line.price-rubl initial 0.00 no-undo.
     2540       define variable varfrm-cnsv-typeprl         as   character                           no-undo.
     2541       define variable varfrm-cnsvprl              as   character                           no-undo.
     2542       define variable varroot-nodeprl             as   integer                             no-undo.
     2543       define variable varempty-scaleprl           as   logical                             no-undo.
     2544       define variable varis-cons-parts-haveprl    as   logical                             no-undo.
     2545       define variable varsum-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2546       define variable varslt-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2547       define variable varvat-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2548       define variable varvatcons-base-factovpprl  like ub.gds-dtl.price-base               no-undo.
     2549       define variable vardsc-base-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2550       define variable varsum-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2551       define variable varslt-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2552       define variable varvat-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2553       define variable varvatcons-base-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2554       define variable vardsc-base-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2555       define variable varsum-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2556       define variable varslt-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2557       define variable varvat-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2558       define variable varvatcons-rubl-factovpprl  like ub.gds-dtl.price-base               no-undo.
     2559       define variable vardsc-rubl-factovpprl      like ub.gds-dtl.price-base               no-undo.
     2560       define variable varsum-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2561       define variable varslt-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2562       define variable varvat-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2563       define variable varvatcons-rubl-docovpprl   like ub.gds-dtl.price-base               no-undo.
     2564       define variable vardsc-rubl-docovpprl       like ub.gds-dtl.price-base               no-undo.
     2565       define variable varfact-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2566       define variable varcons-qntyprl             like ub.parts.fact-qnty                  no-undo.
     2567       define variable varis-one-gds-dtlprl        as   logical                             no-undo.
     2568       define variable varcurprlprice-base         like ub.gds-dtl.cur-base                 no-undo.
     2569       define variable varcurprlprice-rubl         like ub.gds-dtl.price-base               no-undo.
     2570       define variable varcurprldiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
     2571       define variable varcurprldiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
     2572       define variable varoutvprbprl               as   character                           no-undo.
     2573       define variable out-vatp-have-vat-sltprl    as   logical initial yes                 no-undo.
     2574       define buffer   in-vatp-trn-docoprl  for ub.trn-doc .
     2575       define buffer   in-vatp-partsoprl    for ub.parts   .
     2576       define buffer   in-vatp-docoprl      for ub.trn-doc .
     2577       define buffer   in-vatp-goodsoprl    for ub.goods   .
     2578       define buffer   in-vatp-sysconfoprl  for ub.sysconf .
     2579       define buffer   in-vatp_doc-attroprl for ub.doc-attr.
     2580       define variable in-vatp-have-vat-sltoprl       as   logical initial yes    no-undo.
     2581       define variable vat-pc-locoprl                 like ub.doc-line.vat-pc     no-undo.
     2582       define variable varinvprboprl                  as   character              no-undo.
     2583       define variable slt-pc-locoprl                 like ub.doc-line.slt-pc     no-undo.
     2584       define variable cli-base-rateoprl              as   decimal                no-undo.
     2585       define variable price-rubl-with-tax-locoprl    like ub.doc-line.price-rubl no-undo.
     2586       define variable price-base-with-tax-locoprl    like ub.doc-line.price-base no-undo.
     2587       define variable price-cli-with-tax-locoprl     like ub.doc-line.price-cli  no-undo.
     2588       define variable price-rubl-without-tax-locoprl like ub.doc-line.price-rubl no-undo.
     2589       define variable price-base-without-tax-locoprl like ub.doc-line.price-base no-undo.
     2590       define variable price-cli-without-tax-locoprl  like ub.doc-line.price-base no-undo.
     2591       define variable vat-base-locoprl               like ub.doc-line.price-base no-undo.
     2592       define variable vat-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2593       define variable vat-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2594       define variable slt-base-locoprl               like ub.doc-line.price-base no-undo.
     2595       define variable slt-rubl-locoprl               like ub.doc-line.price-rubl no-undo.
     2596       define variable slt-cli-locoprl                like ub.doc-line.price-rubl no-undo.
     2597       define variable road-tax-base-locoprl          like ub.doc-line.road-tax   no-undo.
     2598       define variable road-tax-rubl-locoprl          like ub.doc-line.road-tax   no-undo.
     2599       define variable road-tax-cli-locoprl           like ub.doc-line.road-tax   no-undo.
     2600       define variable transport-base-locoprl         like ub.doc-line.price-base no-undo.
     2601       define variable transport-rubl-locoprl         like ub.doc-line.price-rubl no-undo.
     2602       define variable transport-cli-locoprl          like ub.doc-line.price-rubl no-undo.
     2603       define variable other-base-locoprl             like ub.doc-line.price-base no-undo.
     2604       define variable other-rubl-locoprl             like ub.doc-line.price-rubl no-undo.
     2605       define variable other-cli-locoprl              like ub.doc-line.price-rubl no-undo.
     2606       define variable exch-rate-cli-locoprl          like ub.trn-doc.exch-rate   no-undo.
     2607       define variable varinvatp-envdoprl             as   character              no-undo.
     2608       define variable varinvatp-typeoprl             as   character              no-undo.
     2609     define buffer bf_price-list for ub.price-list.
     2610     define buffer bf_goods      for ub.goods.
     2611     define buffer bf_sysconf    for ub.sysconf.
     2612     define buffer bf_parts      for ub.parts.
     2613     define variable varbase-rate   like ub.trn-doc.base-rate     no-undo.
     2614     define variable varbase-scale  like ub.trn-doc.base-scale    no-undo.
     2615     define variable varroad-tax    like ub.price-list.road-tax   no-undo.
     2616     define variable varexcise      like ub.price-list.excise     no-undo.
     2617     define variable varvat-pc      like ub.doc-line.vat-pc       no-undo.
     2618     define variable varslt-pc      like ub.doc-line.slt-pc       no-undo.
     2619     define variable varprice-base  like ub.price-list.price-sale no-undo.
     2620     define variable varprice-rubl  like ub.price-list.price-sale no-undo.
     2621     define variable vardiscnt-base like ub.price-list.price-sale no-undo.
     2622     define variable vardiscnt-rubl like ub.price-list.price-sale no-undo.
     2623     define variable v-host-code    like ub.sysconf.host-code     no-undo.
     2624     define variable vardoc-num     like ub.price-list.doc-num    no-undo.
     2625     define variable vardoc-code    like ub.price-list.doc-num    no-undo.
     2626     define variable varobj-type    like ub.price-list.obj-type   no-undo.
     2627     define variable varobj-code    like ub.price-list.obj-code   no-undo.
     2628     define variable varartic       like ub.price-list.artic      no-undo.
     2629     define variable varprod-type   like ub.price-list.prod-type  no-undo.
     2630     define variable varprod-code   like ub.price-list.prod-code  no-undo.
     2631     define variable varfact-qnty   like ub.price-list.doc-qnty   no-undo.
     2632     define variable varcons-vat-pc like ub.doc-line.vat-pc       no-undo.
     2633     define variable varext-doc-type like ub.trn-doc.ext-doc-type no-undo.
     2634     define variable vardoc-qnty     like ub.price-list.doc-qnty no-undo.
     2635     define variable vardoc-type     as   character              no-undo.
     2636     do
     2637     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     2638     :
     2639       find first bf_price-list no-lock
     2640         where recid(bf_price-list) = parrecid
     2641         no-error .
     2642       if not available bf_price-list
     2643       then do:
     2644         return error "Ошибка во входящих параметрах prl-vat.i" .
     2645       end.
     2646       find first bf_goods no-lock
     2647         where bf_goods.artic     = bf_price-list.artic
     2648           and bf_goods.prod-type = bf_price-list.prod-type
     2649           and bf_goods.prod-code = bf_price-list.prod-code
     2650         no-error .
     2651       if not available bf_goods
     2652       then do:
     2653         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     2654       end.
     2655       assign
     2656         varvat-pc = bf_price-list.vat-pc
     2657         varslt-pc = bf_price-list.slt-pc
     2658       .
     2659       if varvat-pc = ?
     2660       then do:
     2661         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2662       end.
     2663       if varslt-pc = ?
     2664       then do:
     2665         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     2666       end.
     2667       assign
     2668         varbase-rate   = 1
     2669         varbase-scale  = 1
     2670         varroad-tax    = bf_price-list.road-tax
     2671         varexcise      = bf_price-list.excise
     2672         varprice-base  = bf_price-list.price-sale
     2673         varprice-rubl  = bf_price-list.price-sale
     2674         vardiscnt-base = 0
     2675         vardiscnt-rubl = 0
     2676       .
     2677       assign
     2678         varfact-qnty = 0
     2679       .
     2680       for each bf_parts no-lock
     2681         where bf_parts.out-code   = bf_price-list.doc-num
     2682           and bf_parts.obj-type   = bf_price-list.obj-type
     2683           and bf_parts.obj-code   = bf_price-list.obj-code
     2684           and bf_parts.artic      = bf_price-list.artic
     2685           and bf_parts.prod-type  = bf_price-list.prod-type
     2686           and bf_parts.prod-code  = bf_price-list.prod-code
     2687       :
     2688         assign
     2689           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     2690         .
     2691       end.
     2692       assign
     2693         vardoc-num   = bf_price-list.doc-num
     2694         vardoc-code  = bf_price-list.doc-num
     2695         varobj-type  = bf_price-list.obj-type
     2696         varobj-code  = bf_price-list.obj-code
     2697         varartic     = bf_price-list.artic
     2698         varprod-type = bf_price-list.prod-type
     2699         varprod-code = bf_price-list.prod-code
     2700         vardoc-qnty  = varfact-qnty
     2701         varext-doc-type = 'ot':U
     2702       .
     2703   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2704   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2705     (input  bf_price-list.obj-type
     2706     ,input  bf_price-list.obj-code
     2707     ,output v-host-code
     2708     )  .
     2709       find first bf_sysconf no-lock
     2710         where bf_sysconf.host-code = v-host-code
     2711         .
     2712       if bf_sysconf.cons-vat-pc = ?
     2713       then do:
     2714         return error "Не задан консигнационный НДС по фирме." .
     2715       end.
     2716       else do:
     2717         assign
     2718           varcons-vat-pc = bf_sysconf.cons-vat-pc
     2719         .
     2720       end.
     2721   if varext-doc-type = 'ot':U or
     2722      varext-doc-type = ?                 then do:
     2723     assign
     2724      out-vatp-have-vat-sltprl = yes.
     2725   end.
     2726   else do:
     2727     find first out-vatp_doc-attrprl no-lock
     2728       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     2729         and out-vatp_doc-attrprl.attr-code = 'envd':U
     2730         no-error .
     2731     if not available out-vatp_doc-attrprl then do:
     2732       assign
     2733         out-vatp-have-vat-sltprl = yes.
     2734     end.
     2735     else do:
     2736        out-vatp-have-vat-sltprl = no.
     2737     end.
     2738   end.
     2739   find first out-vatp_goodsprl where out-vatp_goodsprl.artic     = varartic     and
     2740                                      out-vatp_goodsprl.prod-type = varprod-type and
     2741                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     2742   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
