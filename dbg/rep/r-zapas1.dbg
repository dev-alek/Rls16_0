     6081   define variable break_group as logical no-undo init true.
     6082   define variable break_group1 as logical no-undo init true.
     6083   define variable stat     as log no-undo .
     6084   define variable InpError as log no-undo .
     6085   define variable i        as integer no-undo .
     6086   define variable rid-list as character no-undo .
