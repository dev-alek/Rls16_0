     6558   procedure print-header :
     6559    do
     6560    on error undo, return error return-value
     6561    :
     6562              run get-report-num (
     6563               output p-report-id
     6564           ).
     6565       v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
     6566       output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
     6567       put stream OutStr-html unformatted
     6568                "<!DOCTYPE HTML>" skip
