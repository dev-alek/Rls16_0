     5363   DEFINE VARIABLE mImagePath     AS CHARACTER   NO-UNDO.
     5364   DEFINE VARIABLE mImageDir      AS CHARACTER   NO-UNDO.
     5365   DEFINE VARIABLE mImagePreDir   AS CHARACTER   NO-UNDO.
     5366   DEFINE VARIABLE mImageTrash    AS CHARACTER   NO-UNDO.
     5367   DEFINE VARIABLE mPhotomgd      AS LOGICAL     NO-UNDO.
     5368   DEFINE VARIABLE mImagePh       AS LOGICAL     NO-UNDO.
     5369   define variable v-param-types   as character  no-undo.
     5370   define variable v-value-char    as character  no-undo.
     5371   define variable v-val-date      as date       no-undo.
     5372   define variable v-val-decimal   as decimal    no-undo.
     5373   define variable v-val-integer   as integer    no-undo.
     5374   define variable v-val-logical   as logical    no-undo.
     5375   define variable v-tthd          as handle     no-undo.
     5376   RUN imagelist_loaddef IN THIS-PROCEDURE NO-ERROR.
     5377   PROCEDURE imagelist_loaddef:
     5378       DEFINE VARIABLE vPar-val       AS CHARACTER   NO-UNDO.
     5379       DEFINE VARIABLE vPar-type      AS CHARACTER   NO-UNDO.
     5380       ASSIGN
     5381           vPar-val  = "":U
     5382           vPar-type = "":U
     5383           .
     5384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5385     (input  'photo':u
     5386     ,input  '':u
     5387     ,input  '':u
     5388     ,input  0
     5389     ,input  '':u
     5390     ,input  '':u
     5391     ,input  '':u
     5392     ,input  no
     5393     ,output vPar-val
     5394     ,output vPar-type
     5395     ) no-error .
     5396           mImagePh = LOOKUP (vPar-val, "true,yes":U) > 0.
     5397       IF mImagePh THEN .
     5398       ELSE RETURN.
     5399       ASSIGN
     5400           vPar-val  = "":U
     5401           vPar-type = "":U
     5402           .
     5403   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     5404     (input  'ph-dir':u
     5405     ,input  '':u
     5406     ,input  '':u
     5407     ,input  0
     5408     ,input  '':u
     5409     ,input  '':u
     5410     ,input  '':u
     5411     ,input  NO
     5412     ,output vPar-val
     5413     ,output vPar-type
     5414     ) no-error .
     5415       IF LENGTH (vPar-val) = 0 THEN
     5416           RUN verify-ini-entry("ph-dir":U, "REP-SETS":U, "":U, YES, OUTPUT vPar-val) NO-ERROR.
     5417       IF LENGTH (vPar-val) = 0 THEN vPar-val = "c:\temp\":U.
     5418       ASSIGN
     5419           mImagePath   = RIGHT-TRIM (vPar-val, "~\~/":U)
     5420           mImagePath   = mImagePath + (IF LENGTH (mImagePath) > 0 THEN "\":U ELSE "":U)
     5421           mImagePreDir = mImagePath
     5422           mImageDir    = mImagePreDir
     5423           mImageTrash  = mImagePath + "trash\":U
     5424           .
     5425       ASSIGN
     5426           vPar-val  = "":U
     5427           vPar-type = "":U
     5428           .
     5429               run adm/shattri.p (
     5430           input "get":U
     5431           ,input  '':U
     5432           ,input  0
     5433           ,input  'gds-ref':U
     5434           ,input  'shema-foto':U
     5435           ,output v-value-char
     5436           ,output v-val-date
     5437           ,output v-val-decimal
     5438           ,output v-val-integer
     5439           ,output v-val-logical
     5440           ,output v-param-types
     5441           ,INPUT-OUTPUT table-handle v-tthd
     5442           ) no-error.
     5443           delete object v-tthd.
     5444           mPhotomgd = IF v-val-integer = 2 then yes else no.
     5445   END PROCEDURE.
     5446   PROCEDURE imagelist_decode:
     5447       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     5448       DEFINE INPUT  PARAMETER iImageGdsCode AS int    NO-UNDO.
     5449       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     5450       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     5451       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     5452       ASSIGN
     5453           oImageList = iImageList
     5454           .
     5455       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     5456           vCh =ENTRY (vInt, iImageList, ",":U).
     5457           IF SUBSTRING (vCh, 1, 2) = "~\~\":U THEN .
     5458           ELSE
     5459           DO:
     5460               ASSIGN
     5461                   vCh = REPLACE (vCh, "~/":U, "\":U)
     5462                   vCh = REPLACE (vCh, "~\":U, "\":U)
     5463                   .
     5464               IF SUBSTRING (vCh, 2, 2) = ":\":U OR vCh BEGINS mImageDir THEN .
     5465               ELSE vCh = mImagePreDir + (if mPhotomgd then string(iImageGdsCode) + "\":U else '':U ) +  vCh.
     5466               ENTRY (vInt, oImageList, ",":U) = vCh.
     5467           END.
     5468       END.
     5469   END PROCEDURE.
     5470   PROCEDURE imagelist_encode:
     5471       DEFINE INPUT  PARAMETER iImageList AS LONGCHAR  NO-UNDO.
     5472       DEFINE OUTPUT PARAMETER oImageList AS LONGCHAR  NO-UNDO.
     5473       DEFINE VARIABLE vCh                AS CHARACTER NO-UNDO.
     5474       DEFINE VARIABLE vInt               AS INTEGER   NO-UNDO.
     5475       DEFINE VARIABLE vLen               AS INTEGER   NO-UNDO.
     5476       ASSIGN
     5477           oImageList = iImageList
     5478           vLen       = LENGTH (mImageDir)
     5479           .
     5480       DO vInt = 1 TO NUM-ENTRIES (iImageList, ",":U):
     5481           vCh =ENTRY (vInt, iImageList, ",":U).
     5482           IF LENGTH (vCh) > 0 AND vLen > 0 AND vCh BEGINS mImageDir THEN
     5483               ENTRY (vInt, oImageList, ",":U) =
     5484                   SUBSTRING (vCh, vLen + 1).
     5485       END.
     5486   END PROCEDURE.
     5487   function fnc-convert-dot-to-colon returns character
     5488       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     5489   function fnc-convert-dot-to-colon returns character
     5490   (input p-data as decimal, input p-accur as character, input p-num as integer):
     5491       define variable result as character no-undo.
     5492       define variable v-str-result as character no-undo.
     5493       if p-data = ? then p-data = 0 .
     5494       p-data = round(p-data, p-num).
     5495       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     5496       return v-str-result.
     5497   END FUNCTION.
     5498   def var vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5499   procedure gen-key-rec :
     5500     define input  parameter p-tbl-name    as character no-undo.
     5501     define input  parameter p-bh_tbl-name as handle    no-undo.
     5502     define output parameter p-key-rec     as character no-undo.
     5503     do
     5504     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5505     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     5506     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     5507     :
     5508       define variable fh               as handle    no-undo .
     5509       define variable v-ok             as logical   no-undo .
     5510       define variable v-inform         as character no-undo .
     5511       define variable v-ind            as integer   no-undo .
     5512       define variable v-idx-field-qnty as integer   no-undo .
     5513       if p-tbl-name = ?
     5514         or p-tbl-name = "":U
     5515       then do:
     5516         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info44 ).
     5517       end.
     5518       if not p-bh_tbl-name:available then do:
     5519         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info44, p-tbl-name ).
     5520       end.
     5521       assign
     5522         p-key-rec = p-tbl-name
     5523         v-inform  = p-bh_tbl-name:index-information(1)
     5524         v-ind     = 2
     5525       .
     5526       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5527       on error undo, return error
     5528       :
     5529         assign
     5530           v-inform = p-bh_tbl-name:index-information( v-ind )
     5531           v-ind    = v-ind + 1
     5532         .
     5533       end.
     5534       if v-inform = ?
     5535         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5536         or entry( 3, v-inform, ",":U ) <> "1":U
     5537       then do:
     5538         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info44, p-tbl-name ).
     5539       end.
     5540       else do:
     5541         assign
     5542           v-idx-field-qnty = num-entries( v-inform ) - 4
     5543         .
     5544         if v-idx-field-qnty < 2 then do:
     5545           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info44, v-inform, p-tbl-name ).
     5546         end.
     5547         do v-ind = 1 to v-idx-field-qnty by 2
     5548         on error undo, return error
     5549         :
     5550           assign
     5551             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     5552             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     5553           .
     5554         end.
     5555       end.
     5556       if p-key-rec = ? then do:
     5557         assign
     5558           p-key-rec = "":U
     5559         .
     5560         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info44, p-tbl-name ).
     5561       end.
     5562     end.
     5563     return.
     5564   end procedure.
     5565   procedure gen-where-keyr-tab :
     5566     define input  parameter i-tableSerach as character no-undo.
     5567     define input  parameter i-tablekey   as character  no-undo.
     5568     define input  parameter p-key-rec    as character  no-undo.
     5569     define input  parameter p-key-handle as handle     no-undo .
     5570     define input  parameter p-db-name    as character  no-undo .
     5571     define input  parameter p-tt-handle  as handle     no-undo .
     5572     define output parameter o-Where      as character  no-undo.
     5573     do
     5574     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5575     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5576     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     5577     :
     5578       define variable v-full-tbl-name  as character no-undo .
     5579       define variable bh_tbl-name      as handle    no-undo .
     5580       define variable fh_key           as handle    no-undo .
     5581       define variable fh_search        as handle    no-undo .
     5582       define variable v-field-num      as integer   no-undo .
     5583       define variable v-count-fld      as integer   no-undo .
     5584       define variable v-inform         as character no-undo .
     5585       define variable v-ind            as integer   no-undo .
     5586       define variable v-idx-field-qnty as integer   no-undo .
     5587       define variable v-field-name     as character no-undo .
     5588       define variable v-field-val      as character no-undo .
     5589       define variable v-word-link      as character no-undo .
     5590       define variable vTable           as character no-undo.
     5591       define variable bh_tbl-key       as handle    no-undo .
     5592       assign
     5593         p-key-rec = trim( p-key-rec )
     5594       .
     5595       if p-key-handle <> ? then do:
     5596         if not valid-handle(p-key-handle)
     5597            or p-key-handle:type <> "buffer"
     5598         then do:
     5599           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info44 ).
     5600         end.
     5601         if num-entries( p-key-rec, chr(3) ) > 1
     5602           or p-key-rec = ?
     5603           or p-key-rec = "":U
     5604         then do:
     5605           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info44, p-key-rec ).
     5606         end.
     5607       end.
     5608       else do:
     5609         if p-key-rec = ?
     5610           or p-key-rec = "":U
     5611         then do:
     5612           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info44 ).
     5613         end.
     5614       end.
     5615       assign
     5616         vTable = entry( 1 , p-key-rec, chr(3) )
     5617       .
     5618       if p-tt-handle <> ?
     5619         and ( not valid-handle(p-tt-handle)
     5620               or p-tt-handle:type <> "buffer"
     5621             )
     5622       then do:
     5623         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info44, vTable, chr(10) ).
     5624       end.
     5625       if p-tt-handle = ? then do:
     5626         assign
     5627           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     5628         .
     5629         create buffer bh_tbl-name for table v-full-tbl-name .
     5630       end.
     5631       else do:
     5632         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5633       end.
     5634       assign
     5635         v-inform = bh_tbl-name:index-information(1)
     5636         v-ind    = 2
     5637       .
     5638       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5639       on error undo, return error
     5640       :
     5641         assign
     5642           v-inform = bh_tbl-name:index-information( v-ind )
     5643           v-ind    = v-ind + 1
     5644         .
     5645       end.
     5646       if v-inform = ?
     5647         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5648         or entry( 3, v-inform, ",":U ) <> "1":U
     5649       then do:
     5650         delete object bh_tbl-name no-error.
     5651         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info44, vTable ).
     5652       end.
     5653       assign
     5654         v-idx-field-qnty = num-entries( v-inform ) - 4
     5655       .
     5656       if v-idx-field-qnty < 2 then do:
     5657         delete object bh_tbl-name no-error.
     5658         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info44, v-inform, vTable ).
     5659       end.
     5660       assign
     5661         o-where     = "where":U
     5662         v-word-link = "":U
     5663         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     5664         v-count-fld = 0
     5665       .
     5666       if i-tablekey ne "" and i-tablekey ne ?
     5667       then do:
     5668         assign
     5669           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     5670         .
     5671         create buffer bh_tbl-key for table v-full-tbl-name .
     5672       end.
     5673       if i-tableSerach ne "" and i-tableSerach ne ?
     5674       then do:
     5675         delete object bh_tbl-name no-error.
     5676         assign
     5677           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     5678         .
     5679         create buffer bh_tbl-name for table v-full-tbl-name .
     5680       end.
     5681       block_where:
     5682       do v-ind = 1 to v-idx-field-qnty by 2
     5683       on error undo, return error
     5684       :
     5685         assign
     5686           v-count-fld = v-count-fld + 1
     5687         .
     5688         if p-key-handle = ?
     5689           and v-count-fld > v-field-num
     5690         then do:
     5691           leave block_where.
     5692         end.
     5693         define variable VfieldKeyTable as handle no-undo.
     5694         assign
     5695           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     5696           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     5697         .
     5698         if     bh_tbl-key ne ?
     5699         then do:
     5700            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     5701            if VfieldKeyTable eq ?
     5702            then next block_where.
     5703         end.
     5704         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     5705         then
     5706            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     5707         else
     5708            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     5709         if p-key-handle = ? then do:
     5710           assign
     5711             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     5712           .
     5713         end.
     5714         else do:
     5715           assign
     5716             fh_key = p-key-handle:buffer-field( v-field-name )
     5717           .
     5718           if fh_key = ?
     5719             or not valid-handle( fh_key )
     5720           then do:
     5721             delete object bh_tbl-name.
     5722             if     bh_tbl-key ne ?
     5723             then
     5724                delete object bh_tbl-key.
     5725             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info44, p-key-handle:name, v-field-name ).
     5726           end.
     5727           assign
     5728             v-field-val = fh_key:buffer-value
     5729           .
     5730         end.
     5731         if fh_search:data-type ="character":U then do:
     5732           assign
     5733             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     5734             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     5735             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     5736             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     5737             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     5738             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     5739             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     5740             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     5741             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     5742             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     5743             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     5744             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     5745             v-field-val = substitute( '"&1"', v-field-val )
     5746           .
     5747         end.
     5748         assign
     5749           o-where = substitute( "&1 &2", o-where, v-field-val )
     5750         .
     5751         if v-word-link = "":U then do:
     5752           assign
     5753             v-word-link = "and":U
     5754           .
     5755         end.
     5756       end.
     5757       delete object bh_tbl-name.
     5758       if     bh_tbl-key ne ?
     5759       then
     5760          delete object bh_tbl-key.
     5761       if p-key-handle = ?
     5762         and v-count-fld <> v-field-num
     5763       then do:
     5764         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info44, vTable ).
     5765       end.
     5766     end.
     5767   end procedure.
     5768   procedure gen-hn-keyr-tab :
     5769     define input  parameter i-tableSerach as character no-undo.
     5770     define input  parameter i-tablekey   as character no-undo.
     5771     define input  parameter p-key-rec    as character no-undo.
     5772     define input  parameter p-key-handle as handle    no-undo .
     5773     define input  parameter p-db-name    as character no-undo .
     5774     define input  parameter p-tt-handle  as handle    no-undo .
     5775     define input  parameter p-stts-lock  as integer   no-undo .
     5776     define output parameter o-hn         as handle    no-undo.
     5777     define variable v-full-tbl-name as character no-undo.
     5778     define variable v-where         as character no-undo.
     5779     define variable bh_tbl-name     as handle    no-undo.
     5780     define variable vTable          as character no-undo.
     5781     do
     5782     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5783     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     5784     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     5785         run gen-where-keyr-tab(i-tableSerach,
     5786                                i-tablekey,
     5787                                p-key-rec,
     5788                                p-key-handle,
     5789                                p-db-name,
     5790                                p-tt-handle,
     5791                                output v-where).
     5792         if i-tableSerach ne "" and i-tableSerach ne ?
     5793         then do:
     5794            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     5795            create buffer bh_tbl-name for table v-full-tbl-name .
     5796         end.
     5797         else do:
     5798            if p-tt-handle = ? then do:
     5799               assign
     5800                  vTable = entry( 1 , p-key-rec, chr(3) )
     5801               .
     5802               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     5803               create buffer bh_tbl-name for table v-full-tbl-name .
     5804            end.
     5805            else do:
     5806               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     5807            end.
     5808         end.
     5809         if p-tt-handle = ? then do:
     5810            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     5811         end.
     5812         else do:
     5813            bh_tbl-name:find-first( v-where ) no-error .
     5814         end.
     5815         o-hn = bh_tbl-name.
     5816      end.
     5817   end procedure.
     5818   procedure gen-hn-keyr :
     5819     define input  parameter p-key-rec    as character no-undo.
     5820     define input  parameter p-key-handle as handle    no-undo .
     5821     define input  parameter p-db-name    as character no-undo .
     5822     define input  parameter p-tt-handle  as handle    no-undo .
     5823     define input  parameter p-stts-lock  as integer   no-undo .
     5824     define output parameter o-hn         as handle    no-undo.
     5825     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     5826   end.
     5827   procedure gen-row-keyr :
     5828     define input  parameter p-key-rec    as character no-undo.
     5829     define input  parameter p-key-handle as handle    no-undo .
     5830     define input  parameter p-db-name    as character no-undo .
     5831     define input  parameter p-tt-handle  as handle    no-undo .
     5832     define input  parameter p-stts-lock  as integer   no-undo .
     5833     define output parameter p-tbl-row    as rowid     no-undo.
     5834     define output parameter p-tbl-name   as character no-undo.
     5835     define variable vHn as handle no-undo.
     5836       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     5837       p-tbl-row = if vHn:available then vHn:rowid else ?.
     5838       p-tbl-name =  vHn:table.
     5839       delete object vHn no-error.
     5840     if p-tbl-row = ? then do:
     5841       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info44, p-tbl-name, p-key-rec ).
     5842     end.
     5843     else do:
     5844       return.
     5845     end.
     5846   end procedure.
     5847   procedure gen-key-fv :
     5848     define input  parameter p-key-rec    as character no-undo .
     5849     define output parameter p-field-list as character no-undo .
     5850     define output parameter p-value-list as character no-undo.
     5851     do
     5852     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5853     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5854     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5855     :
     5856       define variable v-full-tbl-name  as character no-undo .
     5857       define variable bh_tbl-name      as handle    no-undo .
     5858       define variable v-tbl-name       as character no-undo .
     5859       define variable v-field-num      as integer   no-undo .
     5860       define variable v-count-fld      as integer   no-undo .
     5861       define variable v-inform         as character no-undo .
     5862       define variable v-ind            as integer   no-undo .
     5863       define variable v-idx-field-qnty as integer   no-undo .
     5864       define variable v-delim-key      as character no-undo .
     5865       if p-key-rec = ?
     5866         or p-key-rec = "":U
     5867       then do:
     5868         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info44 ).
     5869       end.
     5870       assign
     5871         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     5872         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5873       .
     5874       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5875       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info44 ).
     5876       assign
     5877         v-inform = bh_tbl-name:index-information(1)
     5878         v-ind    = 2
     5879       .
     5880       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5881       on error undo, return error
     5882       :
     5883         assign
     5884           v-inform = bh_tbl-name:index-information( v-ind )
     5885           v-ind    = v-ind + 1
     5886         .
     5887       end.
     5888       if v-inform = ?
     5889         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5890         or entry( 3, v-inform, ",":U ) <> "1":U
     5891       then do:
     5892         delete object bh_tbl-name no-error.
     5893         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info44, v-tbl-name ).
     5894       end.
     5895       assign
     5896         v-idx-field-qnty = num-entries( v-inform ) - 4
     5897       .
     5898       if v-idx-field-qnty < 2 then do:
     5899         delete object bh_tbl-name no-error.
     5900         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info44, v-inform, v-tbl-name ).
     5901       end.
     5902       assign
     5903         p-field-list = "":U
     5904         p-value-list = "":U
     5905         v-delim-key  = "":U
     5906         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     5907         v-count-fld  = 0
     5908       .
     5909       block_where:
     5910       do v-ind = 1 to v-idx-field-qnty by 2
     5911       on error undo, return error
     5912       :
     5913         assign
     5914           v-count-fld = v-count-fld + 1
     5915         .
     5916         if v-count-fld > v-field-num then do:
     5917           leave block_where.
     5918         end.
     5919         assign
     5920           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     5921           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     5922         .
     5923         if v-ind = 1 then do:
     5924           assign
     5925             v-delim-key = chr(3)
     5926           .
     5927         end.
     5928       end.
     5929       delete object bh_tbl-name.
     5930       if v-count-fld <> v-field-num then do:
     5931         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info44, v-tbl-name ).
     5932       end.
     5933     end.
     5934   end procedure.
     5935   procedure gen-key-field :
     5936     define input  parameter p-table      as character no-undo .
     5937     define output parameter p-field-list as character no-undo .
     5938     do
     5939     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     5940     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     5941     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     5942     :
     5943       define variable v-full-tbl-name  as character no-undo .
     5944       define variable bh_tbl-name      as handle    no-undo .
     5945       define variable v-tbl-name       as character no-undo .
     5946       define variable v-field-num      as integer   no-undo .
     5947       define variable v-count-fld      as integer   no-undo .
     5948       define variable v-inform         as character no-undo .
     5949       define variable v-ind            as integer   no-undo .
     5950       define variable v-idx-field-qnty as integer   no-undo .
     5951       define variable v-delim-key      as character no-undo .
     5952       if p-table = ?
     5953         or p-table = "":U
     5954       then do:
     5955         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info44 ).
     5956       end.
     5957       assign
     5958         v-tbl-name      = p-table
     5959         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     5960       .
     5961       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     5962       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info44 ).
     5963       assign
     5964         v-inform = bh_tbl-name:index-information(1)
     5965         v-ind    = 2
     5966       .
     5967       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     5968       on error undo, return error
     5969       :
     5970         assign
     5971           v-inform = bh_tbl-name:index-information( v-ind )
     5972           v-ind    = v-ind + 1
     5973         .
     5974       end.
     5975       if v-inform = ?
     5976         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     5977         or entry( 3, v-inform, ",":U ) <> "1":U
     5978       then do:
     5979         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info44, v-tbl-name ).
     5980       end.
     5981       assign
     5982         v-idx-field-qnty = num-entries( v-inform ) - 4
     5983       .
     5984       if v-idx-field-qnty < 2 then do:
     5985         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info44, v-inform, v-tbl-name ).
     5986       end.
     5987       assign
     5988         p-field-list = "":U
     5989         v-delim-key  = "":U
     5990         v-count-fld  = 0
     5991       .
     5992       block_where:
     5993       do v-ind = 1 to v-idx-field-qnty by 2
     5994       on error undo, return error
     5995       :
     5996         assign
     5997           v-count-fld = v-count-fld + 1
     5998         .
     5999         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     6000         if v-ind = 1 then do:
     6001           assign
     6002             v-delim-key = chr(3)
     6003           .
     6004         end.
     6005       end.
     6006       delete object bh_tbl-name.
     6007     end.
     6008   end procedure.
