     6352                       ,input v-cur-rt
     6353                       ,input v-cur-ex
     6354                       ,input v-cur-VAT-pc
     6355                       ,input v-cons-vat-pc
     6356                       ,input v-cur-SLT-pc
     6357                       ) no-error .
