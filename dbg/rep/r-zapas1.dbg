     6265                   '</TR>'skip
     6266                 .
     6267                 run new-tmp-page .
     6268                   num#str# = num#str# + 1.
     6269                   num#col# = 1.
     6270                   for each temp-parts no-lock :
     6271                       gds-zap-part-print-code = ''.
     6272                       gds-zap-part-b-code = ?.
     6273                       find first buf_parts where  buf_parts.obj-type   = temp-parts.obj-type   and
     6274                           buf_parts.obj-code   = temp-parts.obj-code   and
     6275                           buf_parts.artic      = temp-parts.artic      and
     6276                           buf_parts.prod-type  = temp-parts.prod-type  and
     6277                           buf_parts.prod-code  = temp-parts.prod-code  and
     6278                           buf_parts.in-code    = temp-parts.in-code      no-lock no-error.
     6279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdscdat in g#library
     6280     (input  gds-zap-b-code
     6281     ,input  'alcohol-prod=request':u
     6282     ,output v-goods-alcohol-prod
     6283     ) no-error .
     6284                       if (v-goods-alcohol-prod = false) and (temp-parts.part-code = '':u)
     6285                           then
     6286                       do:
     6287                           v-show-part-code = '------':u .
     6288                       end.
     6289                       else
     6290                       do:
     6291                           if v-alc-marks then
     6292                           do:
     6293                               run gen-key-rec IN THIS-PROCEDURE (  input 'parts':U
     6294                                   ,input (buffer buf_parts:handle)
     6295                                   ,output v-parts-uniq-key-rec).
     6296                               run bge/egais-marks-find.p persistent (output hndl-proc-egais-marks-lib) no-error .
     6297                               run find-marks-part in hndl-proc-egais-marks-lib (input v-parts-uniq-key-rec, output v-marks, output v-rezerv).
     6298                               delete object hndl-proc-egais-marks-lib no-error.
     6299                           end.
     6300                           run partsfnc_get-parts-show-code in this-procedure
     6301                               (input  temp-parts.part-code
     6302                               ,input  temp-parts.mark-db-num
     6303                               ,input  temp-parts.mark-code
     6304                               ,input  temp-parts.alc-bottling-date
     6305                               ,input  v-goods-alcohol-prod
     6306                               ,output v-show-part-code
     6307                               ) .
     6308                       end.
     6309   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     6310     (buffer buf_parts
     6311     ,output gds-zap-part-b-code
     6312     ) no-error .
     6313                       if not(gds-zap-part-b-code = 0 or gds-zap-part-b-code = ? ) then
     6314                       do:
     6315                           gds-zap-part-print-code =  string(gds-zap-part-b-code).
     6316   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcprcex in g#library
     6318     (input  buf_parts.obj-type
     6319     ,input  buf_parts.obj-code
     6320     ,input  gds-zap-part-b-code
     6321     ,input  0
     6322     ,input  v-fact-order-end
     6323     ,output v-cur-dn
     6324     ,output v-price
     6325     ,output v-cur-rt
     6326     ,output v-cur-ex
     6327     ,output v-cur-VAT-pc
     6328     ,output v-cur-SLT-pc
     6329     ) no-error .
     6330                     end.
     6331                     else gds-zap-part-print-code = buf_parts.in-code.
     6332   define variable vss-include-info46 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6333   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run consvtpc in g#library
     6334     (input  buf_parts.host-code
     6335     ,output v-cons-vat-pc
     6336     )  .
     6337                         if v-cons-vat-pc = ? then v-cons-vat-pc = 0.
     6338                     buffer-copy temp-parts to tt-clcparts.
     6339                     run clcprtsl_calc-parts in this-procedure
     6340                       (input recid(tt-clcparts)
     6341                       ,input false
     6342                       ,input true
     6343                       ,input ?
     6344                       ,input ?
     6345                       ,input ?
     6346                       ,input ?
     6347                       ,input ?
     6348                       ,input ?
     6349                       ,input ?
     6350                       ,input ?
