     7821   procedure proc-prt-3 :
     7822    do
     7823    on error undo, return error return-value
     7824    :
     7825     PUT stream  OutStr-html  tmp#stroka0 format "X(100)" SKIP.
     7826     assign
     7827     num#str# = num#str# + 1
     7828     num#col# =  1
     7829     var-1 = num#str#
     7830     var-2 = num#col#
     7831     .
     7832    end.
     7833   end procedure.
     7834   procedure new-tmp-page :
     7835    do
     7836    on error undo, return error return-value
     7837    :
     7838       if   num#str#  >= 63000 then do:
     7839           run paramls-write in this-procedure
     7840             (input "file"
     7841             ,input string(v-ind)
     7842             ,input v-file-name
     7843             ) .
     7844           v-ind = v-ind + 1 .
     7845           num#str# = 0 .
     7846           run proc-print-header-my.
     7847       end.
     7848    end.
     7849   end procedure.
     7850   procedure proc-print-header-my :
     7851    do
     7852    on error undo, return error return-value
     7853    :
     7854      find first sheetf .
     7855        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     7856        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     7857        var-1 =  num#str# .
     7858        repeat c-c = 1 to sheetf.excel-row-title :
     7859        num#str# = num#str# + 1 .
     7860        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     7861        do c-i = 1 to p-var :
     7862           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     7863           str--2 = integer(entry( c-i, sheetf.sizes )) .
     7864           num#col# = c-i .
     7865           run macr_excel_char ( str--1  , num#str# , num#col#  ) .
     7866           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     7867        end.
     7868       c-i = 0.
     7869       end.
     7870    end.
     7871   end procedure.
     7872   PROCEDURE report-execute :
     7873    do
     7874    on error undo, return error return-value
     7875    :
     7876   define variable vss-include-info59 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7877   case x-set_pay_type :
     7878     when 1 then do:
     7879           tprintrubl = ( var-report-r-b = 'rubl':U ) .
     7880     end.
     7881     when 2 or when 3 then do:
     7882           if x-set_val_type = 1  then tprintrubl = yes .
     7883           if x-set_val_type = 2  then tprintrubl = no  .
     7884     end.
     7885   end case.
     7886       v-ind = 1    .
     7887       num#str# = 0 .
     7888   output stream OutStr-html to value( string( session:temp-directory +
     7889                                        "rpt" + string( g#report-num ) ) )
     7890                                        page-size  value(ReportPageHeight) .
     7891     FIND First clients where
     7892                x-store-type = clients.obj-type AND
     7893                x-store-code = clients.obj-code no-lock no-error.
     7894       If available clients then  ObjName = clients.obj-name.
     7895                            else  ObjName="объект не определен".
     7896     run print-header .
     7897         num#str# = num#str# + 1 .
     7898         num#col# =  1 .
     7899   define variable l-ii  as integer no-undo .
     7900   define variable l-jj  as integer no-undo .
     7901   define variable l-len as integer no-undo .
     7902   define variable l-m   as integer no-undo .
     7903     num#str# = num#str# + 1.
     7904     num#col# = 1.
     7905      run proc-print-header-my.
     7906      For each obj-list no-lock :
     7907         x-store-type  =  obj-list.obj-type .
     7908         x-store-code  =  obj-list.obj-code .
     7909         FIND First clients where x-store-type = clients.obj-type AND
     7910                                  x-store-code = clients.obj-code no-lock no-error.
     7911           If available clients then  ObjName = clients.obj-name.
     7912                                else  ObjName = "объект не определен".
     7913         PUT stream OutStr-html  string(  "ПО ОБЬЕКТУ : (" + x-store-type  + string(x-store-code)  +  ") " + ObjName) at 2 format "x(100)" skip .
     7914         assign
     7915          num#str# = num#str# + 1
     7916          num#col# =  1
     7917          .
     7918          case retclassify :
     7919             when "no-classify":u  then do:
     7920               run run1.
     7921               end.
     7922             when "grp-goods":u then do:
     7923               run run2.
     7924               end.
     7925             when "prod":u then do:
     7926               run run3.
     7927               end.
     7928             when "prod/grp-goods":u then do:
     7929               end.
     7930             when "grp-goods/prod":u then do:
     7931               end.
     7932         end case.
     7933         run print-footer-o.
     7934     end.
     7935     run print-footer.
     7936       run paramls-write in this-procedure
     7937         (input "file"
     7938         ,input string(v-ind)
     7939         ,input v-file-name
     7940         ) .
     7941       run paramls-write in this-procedure
     7942           (input "charcol"
     7943           ,input ""
     7944           ,input "2,3,4"
     7945           ) .
     7946     define variable v-user-action as character no-undo .
     7947     define variable v-printed as logical   no-undo .
     7948     define variable DisabledOptions as integer   no-undo .
     7949      put stream OutStr-html unformatted
     7950                                   '</tbody>' skip
     7951                                   '</table>' skip
     7952                                   '</body>' skip
     7953                                   '</html>' skip
     7954                                   .
     7955     run prn-lib-reportviewer-report-name in this-procedure (
     7956                                                             input parParentProc
     7957                                                             ,input v-file-name-rep-htm
     7958                                                             ).
     7959    end.
     7960   END PROCEDURE.
     7961   PROCEDURE get-report-num :
     7962   define output parameter p-report-num as integer no-undo .
     7963     do
     7964     on error undo, return error return-value
     7965     :
     7966       run gbl/getrpnum.p (output p-report-num).
     7967     end.
     7968   END PROCEDURE.
