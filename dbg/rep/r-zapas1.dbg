     6088   define variable gds-zap-prt-root      like ub.goods.prt-root    no-undo  .
     6089   define variable gds-zap-gds-name      like ub.goods.gds-name    no-undo  .
     6090   define variable gds-zap-gds-long-name as character format "x(120)" no-undo .
     6091   define variable gds-zap-part-b-code   like ub.bar-code.b-code   no-undo  .
     6092   define variable gds-zap-prod-type     like ub.goods.prod-type   no-undo  .
     6093   define variable gds-zap-prod-code     like ub.goods.prod-code   no-undo  .
     6094   define variable gds-zap-artic         like ub.goods.artic       no-undo  .
     6095   define variable gds-zap-b-code        like ub.bar-code.b-code   no-undo  .
