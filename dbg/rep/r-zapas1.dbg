     2944   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2945   FUNCTION get-parts-part-code RETURNS CHARACTER
     2946     ( BUFFER buf_parts FOR ub.parts
     2947     , INPUT p-goods-alcohol-prod AS LOGICAL
     2948     ) :
     2949     define variable v-show-part-code as character no-undo .
     2950     if (p-goods-alcohol-prod = false) and (buf_parts.part-code = '':u)
     2951     then do:
     2952       return '------':u .
     2953     end.
     2954     run partsfnc_get-parts-show-code in this-procedure
     2955       (input  buf_parts.part-code
     2956       ,input  buf_parts.mark-db-num
     2957       ,input  buf_parts.mark-code
     2958       ,input  buf_parts.alc-bottling-date
     2959       ,input  p-goods-alcohol-prod
     2960       ,output v-show-part-code
     2961       ) .
     2962     return v-show-part-code .
     2963   END FUNCTION.
     2964   procedure partsfnc_get-parts-show-code :
     2965     define input  parameter p-part-code          as character no-undo .
     2966     define input  parameter p-mark-db-num        as integer   no-undo .
     2967     define input  parameter p-mark-code          as integer   no-undo .
     2968     define input  parameter p-alc-bottling-date  as date      no-undo .
     2969     define input  parameter p-goods-alcohol-prod as logical   no-undo .
     2970     define output parameter p-show-code          as character no-undo .
     2971     define variable v-alc-mark-name as character no-undo .
     2972     do
     2973     on error undo, return error return-value
     2974     :
     2975       assign
     2976         p-show-code = '':u
     2977       .
     2978       if p-goods-alcohol-prod = true
     2979       then do:
     2980         run alc-lib_mark-name in this-procedure
     2981           (input  p-mark-db-num
     2982           ,input  p-mark-code
     2983           ,output v-alc-mark-name
     2984           ) .
     2985         assign
     2986           p-show-code = substitute('&1,&2':u
     2987                                   ,v-alc-mark-name
     2988                                   ,string(p-alc-bottling-date,'99/99/9999':u)
     2989                                   )
     2990         .
     2991       end.
     2992       else do:
     2993         assign
     2994           p-show-code = p-part-code
     2995         .
     2996       end.
     2997       return '':u .
     2998     end.
     2999   end procedure.
     3000   FUNCTION get-parts-out-code RETURNS CHARACTER
     3001     ( BUFFER buf_parts FOR ub.parts ) :
     3002     case buf_parts.out-code :
     3003       when 'free-zone':U then do:
     3004         return "свободно" .
     3005       end.
     3006       when 'out-zone':U then do:
     3007         return "расход" .
     3008       end.
     3009       otherwise do:
     3010         if buf_parts.doc-type = 'акт':U then do:
     3011           return caps("ЦН") + " № " + buf_parts.out-code .
     3012         end.
     3013         else do:
     3014           define variable v-ext-name       as character no-undo .
     3015           define variable v-trn-doc-status as character no-undo .
     3016           define buffer buf_trn-doc for ub.trn-doc .
     3017           find first buf_trn-doc no-lock
     3018             where buf_trn-doc.doc-code = buf_parts.out-code
     3019             no-error .
     3020           if available buf_trn-doc then do:
     3021   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3022   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run docextnm in g#library
     3023     (input  buf_parts.out-code
     3024     ,output v-ext-name
     3025     )  .
     3026             assign
     3027               v-trn-doc-status = (if buf_trn-doc.status_ = 'факт':U then 'факт':U else "")
     3028             .
     3029           end.
     3030           else do:
     3031             assign
     3032               v-ext-name       = caps(substring(buf_parts.doc-type, 1, 1))
     3033               v-trn-doc-status = (if buf_parts.status_ = ? then 'факт':U else "")
     3034             .
     3035           end.
     3036           return substitute("&1 № &2 &3"
     3037              ,v-ext-name
     3038              ,buf_parts.out-code
     3039              ,v-trn-doc-status
     3040              ) .
     3041         end.
     3042       end.
     3043     end case .
     3044     return "".
     3045   END FUNCTION.
     3046   FUNCTION get-parts-cli-qnty RETURNS DECIMAL
     3047     ( BUFFER buf_parts FOR ub.parts
     3048     , INPUT p-goods-twounit AS LOGICAL
     3049     ) :
     3050     if p-goods-twounit then do:
     3051       RETURN buf_parts.cli-qnty .
     3052     end.
     3053     else do:
     3054       RETURN buf_parts.fact-qnty / buf_parts.cli-base-rate .
     3055     end.
     3056     RETURN ? .
     3057   END FUNCTION.
     3058   FUNCTION get-parts-cli-base-rate RETURNS DECIMAL
     3059     ( BUFFER buf_parts FOR ub.parts
     3060     , INPUT p-goods-twounit AS LOGICAL
     3061     ) :
     3062     if p-goods-twounit then do:
     3063       RETURN buf_parts.fact-qnty / buf_parts.cli-qnty .
     3064     end.
     3065     else do:
     3066       RETURN buf_parts.cli-base-rate .
     3067     end.
     3068     RETURN ? .
     3069   END FUNCTION.
     3070   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3071   procedure alc-lib_mark-name :
     3072     define input  parameter p-mark-db-num   as integer   no-undo .
     3073     define input  parameter p-mark-code     as integer   no-undo .
     3074     define output parameter p-mark-name     as character no-undo .
     3075     define buffer buf_ex-mark for ub.ex-mark .
     3076     do
     3077     on error undo, return error return-value
     3078     :
     3079       if p-mark-db-num = ?
     3080       or p-mark-code   = ?
     3081       then do:
     3082         assign
     3083           p-mark-name = '?':u
     3084         .
     3085         return .
     3086       end.
     3087       if  p-mark-db-num = 0
     3088       and p-mark-code   = 0
     3089       then do:
     3090         assign
     3091           p-mark-name = ""
     3092         .
     3093         return .
     3094       end.
     3095       find first buf_ex-mark no-lock
     3096         where buf_ex-mark.db-num    = p-mark-db-num
     3097           and buf_ex-mark.mark-code = p-mark-code
     3098         no-error .
     3099       if available buf_ex-mark
     3100       then do:
     3101         assign
     3102           p-mark-name = substitute('&1':u
     3103                                   ,buf_ex-mark.mark-name
     3104                                   )
     3105         .
     3106       end.
     3107     end.
     3108   end procedure.
     3109   procedure alc-lib_get-new-part-code :
     3110     define input  parameter p-obj-type       as character no-undo .
     3111     define input  parameter p-obj-code       as integer   no-undo .
     3112     define input  parameter p-prod-type      as character no-undo .
     3113     define input  parameter p-prod-code      as integer   no-undo .
     3114     define input  parameter p-artic          as character no-undo .
     3115     define input  parameter p-doc-code       as character no-undo .
     3116     define output parameter p-new-part-code  as character no-undo .
     3117     define variable v-cur-part-code as integer no-undo.
     3118     define variable v-max-part-code as integer no-undo.
     3119     define variable i               as integer no-undo.
     3120     define buffer bf_parts for ub.parts .
     3121     do
     3122     on error undo, return error return-value
     3123     :
     3124       assign
     3125         v-max-part-code = 0
     3126       .
     3127       for each bf_parts no-lock
     3128             where bf_parts.obj-type  = p-obj-type  and
     3129                   bf_parts.obj-code  = p-obj-code  and
     3130                   bf_parts.prod-type = p-prod-type and
     3131                   bf_parts.prod-code = p-prod-code and
     3132                   bf_parts.artic     = p-artic     and
     3133                   bf_parts.out-code  = p-doc-code
     3134         :
     3135         assign
     3136           v-cur-part-code = integer(bf_parts.part-code)
     3137           no-error.
     3138         if error-status:error = no and v-cur-part-code > v-max-part-code then do:
     3139           assign
     3140             v-max-part-code = v-cur-part-code
     3141           .
     3142         end.
     3143       end.
     3144       assign
     3145         p-new-part-code = string (v-max-part-code + 1)
     3146       .
     3147     end.
     3148   end procedure.
