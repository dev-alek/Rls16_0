     2811          and out-vatp_doc-lineprl.artic      = varartic
     2812          and out-vatp_doc-lineprl.prod-type  = varprod-type
     2813          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     2814   if available out-vatp_doc-lineprl           and
     2815     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     2816     assign
     2817       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
     2818   end.
     2819   else do:
