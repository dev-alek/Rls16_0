     2744     (input  varartic
     2745     ,input  varprod-type
     2746     ,input  varprod-code
     2747     ,output varroot-nodeprl
     2748     ) no-error .
     2749   if error-status :error then do:
     2750     message
     2751       vss-workfile vss-revision vss-description skip
     2752       "Ошибка при определении корневого признака товара" skip
     2753       "Артикул" varartic varprod-type varprod-code skip
     2754       error-status :get-message(1) skip
     2755       return-value skip
     2756       view-as alert-box error .
     2757     undo, return error .
     2758   end.
     2759   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     2760     (input  varroot-nodeprl
     2761     ,input  'empty-scale=request'
     2762     ,output varempty-scaleprl
     2763     ) no-error .
     2764   if error-status :error then do:
     2765     message
     2766       vss-workfile vss-revision vss-description skip
     2767       "Ошибка при определении атрибута признака" skip
     2768       "Артикул" varartic varprod-type varprod-code skip
     2769       "Признак" varroot-nodeprl skip
     2770       "Запрашивался атрибут" "empty-scale=request" skip
     2771       error-status :get-message(1) skip
     2772       return-value skip
     2773       view-as alert-box error .
     2774     undo, return error .
     2775   end.
     2776   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2777   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2778     (output varoutvprbprl
     2779     )  .
     2780   if varoutvprbprl = "base":u then do:
     2781     assign
     2782           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     2783       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     2784     .
     2785   end.
     2786   else do:
     2787     assign
     2788           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     2789       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     2790     .
     2791   end.
     2792   if varoutvprbprl = "rubl":u then do:
     2793     assign
     2794           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     2795       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     2796   end.
     2797   else do:
     2798     assign
     2799           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     2800       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     2801   end.
     2802   assign
     2803     varis-cons-parts-haveprl =  no.
     2804   assign
     2805     varfact-qntyprl       = 0
     2806     varcons-qntyprl       = 0
     2807     varprice-base-consprl = 0
     2808     varprice-rubl-consprl = 0.
     2809   find first out-vatp_doc-lineprl where
