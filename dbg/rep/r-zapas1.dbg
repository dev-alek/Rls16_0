     6047   define buffer buf_goods for ub.goods.
     6048   define buffer buf_gen-attr for ub.gen-attr.
     6049   define variable    ObjName           as char no-undo.
     6050   define variable    Select-Good       as   integer no-undo.
     6051   define variable    ChosedType        as   integer no-undo.
     6052   define variable    PayType           as   integer no-undo.
     6053   define variable    RetClassify       as   char no-undo.
     6054   define variable    RetSortType       as   char no-undo.
