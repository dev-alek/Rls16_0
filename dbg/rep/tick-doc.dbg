      355         if varcont3 = yes then do:
      356           assign
      357             sum3 = sum3 * 3
      358           .
      359           do i3 = 2 to len-code3 by 2
      360           :
      361             assign
      362               v-sum-char3 = substr(full-b-code, len-code3 - i3 + 1, 1)
      363             .
