      480       v-fact-order = ub.trn-doc.fact-order
      481       .
      482   end.
      483   else do:
      484     assign
      485       v-fact-order = ub.price-doc.fact-order
      486      .
      487   end.
      488   define variable how-pcnt-kat as character no-undo .
      489   define variable dflt-cd as character no-undo .
      490   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      491   define variable v-param-type6 as character no-undo .
      492   define variable v-value-date6 as date no-undo .
      493   define variable v-value-decimal6 as decimal no-undo .
      494   define variable v-value-integer6 as INTEGER no-undo .
      495   define variable v-value-logical6 AS LOGICAL no-undo .
      496   define variable v-tth6 as handle no-undo .
      497   define variable v-host-code6 as integer no-undo .
      498   define buffer buf_dis-thbj-rule6 for ub.dis-thbj-rule.
      499   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      500   define variable v-param-type7 as character no-undo .
      501   define variable v-value-date7 as date no-undo .
      502   define variable v-value-decimal7 as decimal no-undo .
      503   define variable v-value-integer7 as INTEGER no-undo .
      504   define variable v-value-logical7 AS LOGICAL no-undo .
      505   define variable v-tth7 as handle no-undo .
      506   run adm/shattri.p (
      507       input "get":U
      508       ,input  p-obj-type
      509       ,input  p-obj-code
      510       ,input  'cd-sending':U
      511       ,input  'dflt-cd':U
      512       ,output dflt-cd
      513       ,output v-value-date7
      514       ,output v-value-decimal7
      515       ,output v-value-integer7
      516       ,output v-value-logical7
      517       ,output v-param-type7
      518       ,INPUT-OUTPUT table-handle v-tth7
      519       )  .
      520   delete object v-tth7 no-error.
      521   how-pcnt-kat = ''.
      522   run adm/shattri.p (
      523       input "get":U
      524       ,input  p-obj-type
      525       ,input  p-obj-code
      526       ,input  'cd-inf-send':U
      527       ,input  'how-pcnt-kat':U
      528       ,output how-pcnt-kat
      529       ,output v-value-date6
      530       ,output v-value-decimal6
      531       ,output v-value-integer6
      532       ,output v-value-logical6
      533       ,output v-param-type6
      534       ,INPUT-OUTPUT table-handle v-tth6
      535       ) no-error .
      536   delete object v-tth6.
      537   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      538     find first  buf_dis-thbj-rule6 No-LOCK  where
      539                 buf_dis-thbj-rule6.obj-type = p-obj-type
      540           AND  buf_dis-thbj-rule6.obj-code = p-obj-code
      541           and  buf_dis-thbj-rule6.pos-type = dflt-cd
      542           and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      543           and  buf_dis-thbj-rule6.nonunique = ''
      544           no-error .
      545     if not available buf_dis-thbj-rule6 then do:
      546   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      548     (input  p-obj-type
      549     ,input  p-obj-code
      550     ,output v-host-code6
      551     )  .
      552       find first  buf_dis-thbj-rule6 No-LOCK  where
      553                   buf_dis-thbj-rule6.obj-code = v-host-code6
      554             AND  buf_dis-thbj-rule6.obj-type = 'орг':U
      555             and  buf_dis-thbj-rule6.pos-type = dflt-cd
      556             and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      557             and  buf_dis-thbj-rule6.nonunique = ''
      558             no-error .
      559     end.
      560     if not available buf_dis-thbj-rule6 then do:
      561       find first  buf_dis-thbj-rule6 No-LOCK  where
      562                   buf_dis-thbj-rule6.obj-code = 0
      563             AND  buf_dis-thbj-rule6.obj-type = ''
      564             and  buf_dis-thbj-rule6.pos-type = dflt-cd
      565             and  buf_dis-thbj-rule6.discnt-role = 'pcnt-kat-pdf':U
      566             and  buf_dis-thbj-rule6.nonunique = ''
      567             no-error .
      568     end.
      569     if available buf_dis-thbj-rule6 then do:
      570       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule6.rule-num).
      571     end.
      572     else do:
      573       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      574     end.
      575   end.
      576   run get-report-num in parparentproc (
      577       output g#report-num
      578   ).
      579   run get-quest-print in parparentproc (
      580       output g#quest-print
      581   ).
      582   PROCEDURE tick-trn:
      583   define variable v-table-name    as character no-undo .
      584   define variable v-goods    as character no-undo .
      585   define variable v-query-prepare as character no-undo .
      586   define variable qh as widget-handle no-undo .
      587   define variable bh as widget-handle no-undo .
      588   define variable bg as widget-handle no-undo .
      589     do
      590     on error undo, return error return-value
      591     :
      592    v-table-name = "doc-line" .
      593    v-goods      = "goods" .
      594    case list-sort :
      595    when "artic" then do:
      596       v-query-prepare =
      597         substitute ('
      598           for each doc-line no-lock where doc-line.doc-code = &3&2&3  by &1' ,
      599                   "doc-line.artic" ,
      600                   ub.trn-doc.doc-code  ,
      601                   chr(34)) .
      602    end.
      603    when "b-code" then do:
      604       v-query-prepare =
      605         substitute ('
      606           for each doc-line no-lock where doc-line.doc-code = &3&2&3 ,
      607               first goods no-lock where
      608                     goods.artic     = doc-line.artic and
      609                     goods.prod-type = doc-line.prod-type and
      610                     goods.prod-code = doc-line.prod-code by &1' ,
      611                   "goods.gds-code" ,
      612                   ub.trn-doc.doc-code  ,
      613                   chr(34)) .
      614    end.
      615    when "order-num" then do:
      616       v-query-prepare =
      617         substitute ('
      618           for each doc-line no-lock where doc-line.doc-code = &3&2&3 by &1' ,
      619                   "doc-line.line-num" ,
      620                   ub.trn-doc.doc-code  ,
      621                   chr(34)) .
      622    end.
      623    when "gds-name" then do:
      624       v-query-prepare =
      625         substitute ('
      626           for each doc-line no-lock where doc-line.doc-code = &3&2&3 ,
      627               first goods no-lock where
      628                     goods.artic     = doc-line.artic and
      629                     goods.prod-type = doc-line.prod-type and
      630                     goods.prod-code = doc-line.prod-code by &1' ,
      631                   "goods.gds-name" ,
      632                   ub.trn-doc.doc-code  ,
      633                   chr(34)) .
      634    end.
      635    otherwise do:
      636       v-query-prepare =
      637         substitute ('
      638           for each doc-line no-lock where doc-line.doc-code = &3&2&3 by &1' ,
      639                   "doc-line.line-num" ,
      640                   ub.trn-doc.doc-code  ,
      641                   chr(34)) .
      642    end.
      643    end case.
      644       create buffer bh for table v-table-name.
      645       create buffer bg for table v-goods.
      646       create query qh.
      647         if list-sort =  "gds-name" or
      648            list-sort =  "b-code"
      649         then do:
      650            qh:set-buffers (bh, bg).
      651         end.
      652         else do:
      653            qh:set-buffers (bh).
      654         end.
      655         qh:query-prepare (v-query-prepare).
      656         qh:query-open ().
      657         qh:get-first ().
      658         if bh:available <> true then do:
      659            qh:query-close() .
      660            delete object qh.
      661            delete object bh.
      662            return.
      663          end.
      664         do while qh:query-off-end = false :
      665             run tick-trn-line in this-procedure (input  bh:recid ) .
      666             qh:get-next().
      667         end.
      668       qh:query-close() .
      669       delete object qh.
      670       delete object bh.
      671     end.
      672   END PROCEDURE.
      673   PROCEDURE tick-trn-line:
      674   define input  parameter p-recid as recid no-undo .
      675   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      676   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      677     (output v-rb-is-base
      678     )  .
      679   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      680   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      681     (input  p-obj-type
      682     ,input  p-obj-code
      683     ,output v-host-code
      684     )  .
      685   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      687     (input  v-host-code
      688     ,output v-base-code
      689     )  .
      690     for each ub.doc-line no-lock
      691       where recid(ub.doc-line) = p-recid
      692     :
      693       find first ub.goods no-lock
      694         where ub.goods.prod-type = ub.doc-line.prod-type
      695           and ub.goods.prod-code = ub.doc-line.prod-code
      696           and ub.goods.artic     = ub.doc-line.artic
      697         .
      698       find first ub.gds-prt no-lock
      699         where ub.gds-prt.upper-code = ub.goods.prt-root
      700         .
      701       assign
      702         rootnode_code = ub.gds-prt.node-code
      703         v-part-code = "":U
      704         .
      705       case BCodeType:
      706         when "main" then do:
      707           for each ub.gds-dtl no-lock
      708             where ub.gds-dtl.prod-type = ub.doc-line.prod-type
      709               and ub.gds-dtl.prod-code = ub.doc-line.prod-code
      710               and ub.gds-dtl.artic = ub.doc-line.artic
      711               and ub.gds-dtl.doc-code = ub.doc-line.doc-code
      712           :
      713             find first ub.bar-code
      714               where ub.bar-code.gds-code = ub.goods.gds-code
      715                 and ub.bar-code.unit-cli = ub.goods.unit-base
      716                 and ub.bar-code.node-code = ub.gds-dtl.prt-code
      717                 and ub.bar-code.part-code = ""
      718                 and ub.bar-code.in-code = ""
      719               .
      720             find first ub.units no-lock
      721               where ub.units.unit-name = ub.bar-code.unit-cli
      722               .
      723             if lookup('2ед':U, units.type) > 0 then do:
      724               assign nakl-qnty = ub.doc-line.cli-qnty .
      725             end.
      726             else do:
      727               assign nakl-qnty = ( if can-do( 'факт':U, ub.trn-doc.status_ ) then ub.gds-dtl.fact-qnty else ub.gds-dtl.doc-qnty ) .
      728             end.
      729             assign
      730               pr-doc-rubl = ub.gds-dtl.price-rubl
      731             .
      732             if v-rb-is-base = true then do:
      733               assign
      734                 pr-doc-rb = ub.gds-dtl.price-base
      735               .
      736             end.
      737             else do:
      738               assign
      739                 pr-doc-rb = ub.gds-dtl.price-rubl
      740               .
      741             end.
      742   run rep/ticket.p (
      743                  buffer ub.goods
      744                 ,buffer ub.bar-code
      745                 ,buffer ub.scales-gds
      746                 ,input p-obj-type
      747                 ,input p-obj-code
      748                 ,input Action
      749                 ,input rootnode_code
      750                 ,input TickOnw
      751                 ,input TickOnN
      752                 ,input QntyType
      753                 ,input PriceType
      754                 ,input scaleprice
      755                 ,input nakl-qnty
      756                 ,input list-qnty
      757                 ,input pr-doc-rubl
      758                 ,input pr-doc-rb
      759                 ,input pr-doc-rubl-old
      760                 ,input pr-doc-rb-old
      761                 ,input v-fact-order
      762                 ,input ListProdBc
      763                 ,input curr-rate
      764                 ,input TickPS
      765                 ,input dflt-cd
      766                 ,input how-pcnt-kat
      767                 ,input-output b-count
      768                 ,input v-part-code
      769                 ,input v-doc-code
      770                 ,input v-promo-code
      771                 ,input v-ActionId
      772                 ,input v-db-num
      773                 ) no-error .
      774           end.
      775         end.
      776         when "part" then do:
      777           for each ub.parts no-lock
      778             where ub.parts.obj-type = ub.trn-doc.obj-type
      779               and ub.parts.obj-code = ub.trn-doc.obj-code
      780               and ub.parts.artic = ub.goods.artic
      781               and ub.parts.prod-type = ub.goods.prod-type
      782               and ub.parts.prod-code = ub.goods.prod-code
      783               and ub.parts.out-code = ub.trn-doc.doc-code
      784           :
      785             find first ub.bar-code no-lock
      786               where ub.bar-code.gds-code  = ub.goods.gds-code
      787                 and ub.bar-code.unit-cli  = ub.goods.unit-base
      788                 and ub.bar-code.node-code = rootnode_code
      789                 and ub.bar-code.part-code = ub.parts.part-code
      790                 and ub.bar-code.in-code   = ub.parts.in-code
      791               no-error.
      792             if not available ub.bar-code then
      793               message "На товар, артикул - " ub.goods.artic " (" ub.goods.prod-type " " ub.goods.prod-code "), нет бар-кода партии!" view-as alert-box error.
      794             else
      795               do:
      796                 find first ub.units no-lock
      797                   where ub.units.unit-name = ub.bar-code.unit-cli
      798                   .
      799                 if ub.units.type = '2ед':U then do:
      800                   assign
      801                     nakl-qnty = ub.parts.cli-qnty
      802                   .
      803                 end.
      804                 else do:
      805                   assign
      806                     nakl-qnty = ( if can-do( 'факт':U, ub.trn-doc.status_ ) then ub.parts.fact-qnty else parts.qnty )
      807                   .
      808                 end.
      809                 assign
      810                   v-part-code = ub.parts.part-code
      811                 .
      812   run rep/ticket.p (
      813                  buffer ub.goods
      814                 ,buffer ub.bar-code
      815                 ,buffer ub.scales-gds
      816                 ,input p-obj-type
      817                 ,input p-obj-code
      818                 ,input Action
      819                 ,input rootnode_code
      820                 ,input TickOnw
      821                 ,input TickOnN
      822                 ,input QntyType
      823                 ,input PriceType
      824                 ,input scaleprice
      825                 ,input nakl-qnty
      826                 ,input list-qnty
      827                 ,input pr-doc-rubl
      828                 ,input pr-doc-rb
      829                 ,input pr-doc-rubl-old
      830                 ,input pr-doc-rb-old
      831                 ,input v-fact-order
      832                 ,input ListProdBc
      833                 ,input curr-rate
      834                 ,input TickPS
      835                 ,input dflt-cd
      836                 ,input how-pcnt-kat
      837                 ,input-output b-count
      838                 ,input v-part-code
      839                 ,input v-doc-code
      840                 ,input v-promo-code
      841                 ,input v-ActionId
      842                 ,input v-db-num
      843                 ) no-error .
      844               end.
      845           end.
      846         end.
      847         when "subs" then  do:
      848           if TickOnS then do:
      849             for each ub.gds-dtl no-lock
      850               where ub.gds-dtl.prod-type = ub.doc-line.prod-type
      851                 and ub.gds-dtl.prod-code = ub.doc-line.prod-code
      852                 and ub.gds-dtl.artic     = ub.doc-line.artic
      853                 and ub.gds-dtl.doc-code  = ub.doc-line.doc-code
      854               ,each ub.bar-code no-lock
      855               where ub.bar-code.gds-code  = ub.goods.gds-code
      856                 and ub.bar-code.unit-cli  = UnitName
      857                 and ub.bar-code.node-code = ub.gds-dtl.prt-code
      858                 and ub.bar-code.part-code = ""
      859                 and ub.bar-code.in-code   = ""
      860             :
      861               assign
      862                 pr-doc-rubl = ub.gds-dtl.price-rubl
      863               .
      864               if v-rb-is-base = true then do:
      865                 assign
      866                   pr-doc-rb = ub.gds-dtl.price-base
      867                 .
      868               end.
      869               else do:
      870                 assign
      871                   pr-doc-rb = ub.gds-dtl.price-rubl
      872                 .
      873               end.
      874               if qntytype = "документ" then do:
      875                 assign
      876                 nakl-qnty = ( if can-do( 'факт':U, ub.trn-doc.status_ ) then ub.gds-dtl.fact-qnty else ub.gds-dtl.doc-qnty ) .
      877               end.
      878   run rep/ticket.p (
      879                  buffer ub.goods
      880                 ,buffer ub.bar-code
      881                 ,buffer ub.scales-gds
      882                 ,input p-obj-type
      883                 ,input p-obj-code
      884                 ,input Action
      885                 ,input rootnode_code
      886                 ,input TickOnw
      887                 ,input TickOnN
      888                 ,input QntyType
      889                 ,input PriceType
      890                 ,input scaleprice
      891                 ,input nakl-qnty
      892                 ,input list-qnty
      893                 ,input pr-doc-rubl
      894                 ,input pr-doc-rb
      895                 ,input pr-doc-rubl-old
      896                 ,input pr-doc-rb-old
      897                 ,input v-fact-order
      898                 ,input ListProdBc
      899                 ,input curr-rate
      900                 ,input TickPS
      901                 ,input dflt-cd
      902                 ,input how-pcnt-kat
      903                 ,input-output b-count
      904                 ,input v-part-code
      905                 ,input v-doc-code
      906                 ,input v-promo-code
      907                 ,input v-ActionId
      908                 ,input v-db-num
      909                 ) no-error .
      910             end.
      911           end.
      912           else do:
      913             find first ub.gds-dtl no-lock
      914               where ub.gds-dtl.prod-type = ub.doc-line.prod-type
      915                 and ub.gds-dtl.prod-code = ub.doc-line.prod-code
      916                 and ub.gds-dtl.artic     = ub.doc-line.artic
      917                 and ub.gds-dtl.doc-code  = ub.doc-line.doc-code
      918               .
      919             find first ub.bar-code no-lock
      920               where ub.bar-code.gds-code  = ub.goods.gds-code
      921                 and ub.bar-code.unit-cli  = UnitName
      922                 and ub.bar-code.node-code = rootnode_code
      923                 and ub.bar-code.part-code = ""
      924                 and ub.bar-code.in-code   = ""
      925               no-error.
      926             if available ub.bar-code then do:
      927               assign
      928                 pr-doc-rubl = ub.gds-dtl.price-rubl
      929               .
      930               if v-rb-is-base = true then do:
      931                 assign
      932                   pr-doc-rb = ub.gds-dtl.price-base
      933                 .
      934               end.
      935               else do:
      936                 assign
      937                   pr-doc-rb = ub.gds-dtl.price-rubl
      938                 .
      939               end.
      940               if qntytype = "документ" then do:
      941                 assign
      942                   nakl-qnty = ( if can-do( 'факт':U, ub.trn-doc.status_ ) then ub.gds-dtl.fact-qnty else ub.gds-dtl.doc-qnty )
      943                 .
      944               end.
      945   run rep/ticket.p (
      946                  buffer ub.goods
      947                 ,buffer ub.bar-code
      948                 ,buffer ub.scales-gds
      949                 ,input p-obj-type
      950                 ,input p-obj-code
      951                 ,input Action
      952                 ,input rootnode_code
      953                 ,input TickOnw
      954                 ,input TickOnN
      955                 ,input QntyType
      956                 ,input PriceType
      957                 ,input scaleprice
      958                 ,input nakl-qnty
      959                 ,input list-qnty
      960                 ,input pr-doc-rubl
      961                 ,input pr-doc-rb
      962                 ,input pr-doc-rubl-old
      963                 ,input pr-doc-rb-old
      964                 ,input v-fact-order
      965                 ,input ListProdBc
      966                 ,input curr-rate
      967                 ,input TickPS
      968                 ,input dflt-cd
      969                 ,input how-pcnt-kat
      970                 ,input-output b-count
      971                 ,input v-part-code
      972                 ,input v-doc-code
      973                 ,input v-promo-code
      974                 ,input v-ActionId
      975                 ,input v-db-num
      976                 ) no-error .
      977             end.
      978           end.
      979         end.
      980       end case.
      981     end.
      982   END PROCEDURE.
      983   PROCEDURE tick-price:
      984   define variable v-table-name    as character no-undo .
      985   define variable v-goods    as character no-undo .
      986   define variable v-query-prepare as character no-undo .
      987   define variable qh as widget-handle no-undo .
      988   define variable bh as widget-handle no-undo .
      989   define variable bg as widget-handle no-undo .
      990     do
      991     on error undo, return error return-value
      992     :
      993    v-table-name = "price-list" .
      994    v-goods      = "goods" .
      995    case list-sort :
      996    when "artic" then do:
      997       v-query-prepare =
      998         substitute ('
      999           for each price-list no-lock where price-list.doc-num = &3&2&3  by &1' ,
     1000                   "price-list.artic" ,
     1001                   ub.price-doc.doc-num  ,
     1002                   chr(34)) .
     1003    end.
     1004    when "b-code" then do:
     1005       v-query-prepare =
     1006         substitute ('
     1007           for each price-list no-lock where price-list.doc-num = &3&2&3  by &1' ,
     1008                   "price-list.b-code" ,
     1009                   ub.price-doc.doc-num  ,
     1010                   chr(34)) .
     1011    end.
     1012    when "order-num" then do:
     1013       v-query-prepare =
     1014         substitute ('
     1015           for each price-list no-lock where price-list.doc-num = &3&2&3  by &1' ,
     1016                   "price-list.line-num" ,
     1017                   ub.price-doc.doc-num  ,
     1018                   chr(34)) .
     1019    end.
     1020    when "gds-name" then do:
     1021       v-query-prepare =
     1022         substitute ('
     1023           for each price-list no-lock where price-list.doc-num = &3&2&3 ,
     1024               first goods no-lock where
     1025                     goods.artic     = price-list.artic and
     1026                     goods.prod-type = price-list.prod-type and
     1027                     goods.prod-code = price-list.prod-code by &1' ,
     1028                   "goods.gds-name" ,
     1029                   ub.price-doc.doc-num  ,
     1030                   chr(34)) .
     1031    end.
     1032   otherwise do:
     1033       v-query-prepare =
     1034         substitute ('
     1035           for each price-list no-lock where price-list.doc-num = &3&2&3  by &1' ,
     1036                   "price-list.line-num" ,
     1037                   ub.price-doc.doc-num  ,
     1038                   chr(34)) .
     1039   end.
     1040    end case.
     1041       create buffer bh for table v-table-name.
     1042       create buffer bg for table v-goods.
     1043       create query qh.
     1044         if list-sort =  "gds-name" then do:
     1045            qh:set-buffers (bh, bg).
     1046         end.
     1047         else do:
     1048            qh:set-buffers (bh).
     1049         end.
     1050         qh:query-prepare (v-query-prepare).
     1051         qh:query-open ().
     1052         qh:get-first ().
     1053         if bh:available <> true then do:
     1054            qh:query-close() .
     1055            delete object qh.
     1056            delete object bh.
     1057            return.
     1058          end.
     1059         do while qh:query-off-end = false :
     1060             run tick-price-line in this-procedure (input  bh:recid ) .
     1061             qh:get-next().
     1062         end.
     1063       qh:query-close() .
     1064       delete object qh.
     1065       delete object bh.
     1066     end.
     1067   END PROCEDURE.
     1068   procedure tick-price-line :
     1069   define input  parameter p-recid  as recid no-undo .
     1070     do
     1071     on error undo, return error return-value
     1072     :
     1073     define variable cur-rt like ub.price-list.road-tax   no-undo.
     1074     define variable cur-ex like ub.price-list.excise     no-undo.
     1075     define variable cur-dn like ub.price-list.doc-num    no-undo.
     1076     define variable v-is-chg as logical   no-undo .
     1077     for each b-price-list no-lock
     1078       where recid( b-price-list ) = p-recid and true
     1079     :
     1080       assign
     1081         v-is-chg = true
     1082       .
     1083       if OnlyChgPr = true then do:
     1084   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1085   if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ichprise in g#library2
     1086     (input  b-price-list.b-code
     1087     ,input  b-price-list.doc-num
     1088     ,output v-is-Chg
     1089     )  .
     1090       end.
     1091       if v-is-Chg = true then do:
     1092         find first ub.goods no-lock
     1093           where ub.goods.prod-type = b-price-list.prod-type
     1094             and ub.goods.prod-code = b-price-list.prod-code
     1095             and ub.goods.artic     = b-price-list.artic
     1096           .
     1097         find first ub.gds-prt no-lock
     1098           where ub.gds-prt.upper-code = ub.goods.prt-root .
     1099         assign
     1100           v-part-code = "":U
     1101           pr-doc-rb = b-price-list.price-sale
     1102           pr-doc-rubl = b-price-list.price-sale
     1103           .
     1104   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1106     (input  b-price-list.obj-type
     1107     ,input  b-price-list.obj-code
     1108     ,input  b-price-list.b-code
     1109     ,input  0
     1110     ,input  b-price-list.fact-order
     1111     ,output cur-dn
     1112     ,output pr-doc-rb-old
     1113     ,output cur-rt
     1114     ,output cur-ex
     1115     ) no-error .
     1116         assign
     1117           pr-doc-rubl-old = pr-doc-rb-old
     1118         .
     1119         if v-rb-is-base = true
     1120           and v-base-code <> 0
     1121         then do:
     1122           assign
     1123             pr-doc-rubl = pr-doc-rubl * curr-rate
     1124             pr-doc-rubl-old = pr-doc-rubl-old * curr-rate
     1125           .
     1126         end.
     1127         CASE BCodeType:
     1128           when "main" then do:
     1129             if TickOnS   and  b-price-list.main-price = no then do:
     1130                 find first ub.bar-code no-lock
     1131                 where ub.bar-code.gds-code  = ub.goods.gds-code
     1132                   and ub.bar-code.unit-cli  = ub.goods.unit-base
     1133                   and ub.bar-code.b-code = ub.b-price-list.b-code
     1134                 no-error .
     1135                 if available ub.bar-code then do:
     1136                  nakl-qnty = b-price-list.doc-qnty .
     1137   run rep/ticket.p (
     1138                  buffer ub.goods
     1139                 ,buffer ub.bar-code
     1140                 ,buffer ub.scales-gds
     1141                 ,input p-obj-type
     1142                 ,input p-obj-code
     1143                 ,input Action
     1144                 ,input rootnode_code
     1145                 ,input TickOnw
     1146                 ,input TickOnN
     1147                 ,input QntyType
     1148                 ,input PriceType
     1149                 ,input scaleprice
     1150                 ,input nakl-qnty
     1151                 ,input list-qnty
     1152                 ,input pr-doc-rubl
     1153                 ,input pr-doc-rb
     1154                 ,input pr-doc-rubl-old
     1155                 ,input pr-doc-rb-old
     1156                 ,input v-fact-order
     1157                 ,input ListProdBc
     1158                 ,input curr-rate
     1159                 ,input TickPS
     1160                 ,input dflt-cd
     1161                 ,input how-pcnt-kat
     1162                 ,input-output b-count
     1163                 ,input v-part-code
     1164                 ,input v-doc-code
     1165                 ,input v-promo-code
     1166                 ,input v-ActionId
     1167                 ,input v-db-num
     1168                 ) no-error .
     1169                 end.
     1170             end.
     1171             else if not TickOnS and b-price-list.main-price then do:
     1172               find first ub.bar-code no-lock
     1173                 where ub.bar-code.gds-code  = ub.goods.gds-code
     1174                   and ub.bar-code.unit-cli  = ub.goods.unit-base
     1175                   and ub.bar-code.node-code = ub.gds-prt.node-code
     1176                   and ub.bar-code.part-code = ""
     1177                   and ub.bar-code.in-code   = ""
     1178                 .
     1179               if ub.bar-code.b-code = b-price-list.b-code then do:
     1180                 assign
     1181                   nakl-qnty = b-price-list.doc-qnty
     1182                .
     1183   run rep/ticket.p (
     1184                  buffer ub.goods
     1185                 ,buffer ub.bar-code
     1186                 ,buffer ub.scales-gds
     1187                 ,input p-obj-type
     1188                 ,input p-obj-code
     1189                 ,input Action
     1190                 ,input rootnode_code
     1191                 ,input TickOnw
     1192                 ,input TickOnN
     1193                 ,input QntyType
     1194                 ,input PriceType
     1195                 ,input scaleprice
     1196                 ,input nakl-qnty
     1197                 ,input list-qnty
     1198                 ,input pr-doc-rubl
     1199                 ,input pr-doc-rb
     1200                 ,input pr-doc-rubl-old
     1201                 ,input pr-doc-rb-old
     1202                 ,input v-fact-order
     1203                 ,input ListProdBc
     1204                 ,input curr-rate
     1205                 ,input TickPS
     1206                 ,input dflt-cd
     1207                 ,input how-pcnt-kat
     1208                 ,input-output b-count
     1209                 ,input v-part-code
     1210                 ,input v-doc-code
     1211                 ,input v-promo-code
     1212                 ,input v-ActionId
     1213                 ,input v-db-num
     1214                 ) no-error .
     1215               end.
     1216             end.
     1217           end.
     1218         when "part" then do:
     1219           for each ub.parts no-lock
     1220             where ub.parts.obj-type = b-price-list.obj-type
     1221               and ub.parts.obj-code = b-price-list.obj-code
     1222               and ub.parts.artic = ub.goods.artic
     1223               and ub.parts.prod-type = ub.goods.prod-type
     1224               and ub.parts.prod-code = ub.goods.prod-code
     1225               and ub.parts.out-code = b-price-list.doc-num
     1226           :
     1227               find first ub.bar-code no-lock
     1228                 where ub.bar-code.gds-code = ub.goods.gds-code
     1229                   and ub.bar-code.unit-cli = ub.goods.unit-base
     1230                   and ub.bar-code.node-code = ub.gds-prt.node-code
     1231                   and ub.bar-code.part-code = ub.parts.part-code
     1232                   and ub.bar-code.in-code = ub.parts.in-code
     1233                 no-error.
     1234               if available ub.bar-code
     1235                 and ( ( ub.bar-code.in-code <> ""
     1236                         and b-price-list.b-code = ub.bar-code.b-code
     1237                       )
     1238                       or ( ub.bar-code.in-code = ""
     1239                            and b-price-list.main-price = true
     1240                          )
     1241                     )
     1242               then do:
     1243                 assign
     1244                   nakl-qnty = ( if can-do( 'акт':U, ub.price-doc.status_ ) then ub.parts.fact-qnty else ub.parts.qnty )
     1245                   v-part-code = ub.parts.part-code
     1246                 .
     1247   run rep/ticket.p (
     1248                  buffer ub.goods
     1249                 ,buffer ub.bar-code
     1250                 ,buffer ub.scales-gds
     1251                 ,input p-obj-type
     1252                 ,input p-obj-code
     1253                 ,input Action
     1254                 ,input rootnode_code
     1255                 ,input TickOnw
     1256                 ,input TickOnN
     1257                 ,input QntyType
     1258                 ,input PriceType
     1259                 ,input scaleprice
     1260                 ,input nakl-qnty
     1261                 ,input list-qnty
     1262                 ,input pr-doc-rubl
     1263                 ,input pr-doc-rb
     1264                 ,input pr-doc-rubl-old
     1265                 ,input pr-doc-rb-old
     1266                 ,input v-fact-order
     1267                 ,input ListProdBc
     1268                 ,input curr-rate
     1269                 ,input TickPS
     1270                 ,input dflt-cd
     1271                 ,input how-pcnt-kat
     1272                 ,input-output b-count
     1273                 ,input v-part-code
     1274                 ,input v-doc-code
     1275                 ,input v-promo-code
     1276                 ,input v-ActionId
     1277                 ,input v-db-num
     1278                 ) no-error .
     1279               end.
     1280             end.
     1281           end.
     1282           when "subs" then  do:
     1283             if TickOnS   and  b-price-list.main-price = no then do:
     1284                 find first ub.bar-code no-lock
     1285                 where ub.bar-code.gds-code  = ub.goods.gds-code
     1286                   and ub.bar-code.unit-cli  = ub.goods.unit-base
     1287                   and ub.bar-code.b-code = ub.b-price-list.b-code
     1288                 no-error .
     1289                 if available ub.bar-code then do:
     1290                  nakl-qnty = b-price-list.doc-qnty .
     1291   run rep/ticket.p (
     1292                  buffer ub.goods
     1293                 ,buffer ub.bar-code
     1294                 ,buffer ub.scales-gds
     1295                 ,input p-obj-type
     1296                 ,input p-obj-code
     1297                 ,input Action
     1298                 ,input rootnode_code
     1299                 ,input TickOnw
     1300                 ,input TickOnN
     1301                 ,input QntyType
     1302                 ,input PriceType
     1303                 ,input scaleprice
     1304                 ,input nakl-qnty
     1305                 ,input list-qnty
     1306                 ,input pr-doc-rubl
     1307                 ,input pr-doc-rb
     1308                 ,input pr-doc-rubl-old
     1309                 ,input pr-doc-rb-old
     1310                 ,input v-fact-order
     1311                 ,input ListProdBc
     1312                 ,input curr-rate
     1313                 ,input TickPS
     1314                 ,input dflt-cd
     1315                 ,input how-pcnt-kat
     1316                 ,input-output b-count
     1317                 ,input v-part-code
     1318                 ,input v-doc-code
     1319                 ,input v-promo-code
     1320                 ,input v-ActionId
     1321                 ,input v-db-num
     1322                 ) no-error .
     1323                 end.
     1324             end.
     1325             else do:
     1326               find first ub.bar-code no-lock
     1327                 where ub.bar-code.gds-code  = ub.goods.gds-code
     1328                   and ub.bar-code.unit-cli  = unitname
     1329                   and ub.bar-code.node-code = ub.gds-prt.node-code
     1330                   and ub.bar-code.part-code = ""
     1331                   and ub.bar-code.in-code   = ""
     1332                 no-error.
     1333               if available ub.bar-code then do:
     1334   run rep/ticket.p (
     1335                  buffer ub.goods
     1336                 ,buffer ub.bar-code
     1337                 ,buffer ub.scales-gds
     1338                 ,input p-obj-type
     1339                 ,input p-obj-code
     1340                 ,input Action
     1341                 ,input rootnode_code
     1342                 ,input TickOnw
     1343                 ,input TickOnN
     1344                 ,input QntyType
     1345                 ,input PriceType
     1346                 ,input scaleprice
     1347                 ,input nakl-qnty
     1348                 ,input list-qnty
     1349                 ,input pr-doc-rubl
     1350                 ,input pr-doc-rb
     1351                 ,input pr-doc-rubl-old
     1352                 ,input pr-doc-rb-old
     1353                 ,input v-fact-order
     1354                 ,input ListProdBc
     1355                 ,input curr-rate
     1356                 ,input TickPS
     1357                 ,input dflt-cd
     1358                 ,input how-pcnt-kat
     1359                 ,input-output b-count
     1360                 ,input v-part-code
     1361                 ,input v-doc-code
     1362                 ,input v-promo-code
     1363                 ,input v-ActionId
     1364                 ,input v-db-num
     1365                 ) no-error .
     1366               end.
     1367             end.
     1368           end.
     1369         end case.
     1370       end.
     1371     end.
     1372     end.
     1373   end procedure.
     1374   if DocType = "trn" then do:
     1375     run tick-trn.
     1376   end.
     1377   else do:
     1378     run tick-price.
     1379   end.
     1380   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1381   OUTPUT STREAM OutStream CLOSE.
     1382   message
     1383     substitute( "Передано на печать &1 этикеток (ценников)", b-count )
     1384     view-as alert-box INFORMATION.
     1385   os-command NO-WAIT value( substitute( "start &1run-lbc.bat &1 &2title &3 &4", lbc-path, lbc-tmp, TicketName, v-user-id ) ).
