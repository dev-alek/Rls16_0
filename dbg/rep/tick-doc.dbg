      157   def new shared var bc-frmt as character no-undo .
      158   def new shared var bc-pfx  as character no-undo .
      159   def var bc-par-type as character no-undo .
      160       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      161       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      162           do:
      163               message "Не задан или не верно задан ТИП собственного бар-кода!"
      164                   view-as alert-box ERROR TITLE "".
      165               return error.
      166           end.
      167       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      168       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      169           do:
      170               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      171                   view-as alert-box ERROR TITLE "".
      172               return error.
      173           end.
      174   PROCEDURE gen-bc:
      175     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      176     def output parameter full-b-code     as character init ""    no-undo .
      177   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      178     define variable tmp-str2  as character no-undo.
      179     define variable tmp-num2  as character no-undo.
      180     define variable i2        as integer   no-undo.
      181     define variable sum2      as integer   no-undo.
      182     define variable len-code2 as integer   no-undo.
      183     define variable varcont2  as logical   initial yes no-undo.
      184     CASE bc-frmt :
      185       WHEN "EAN13" THEN do:
      186         assign
      187           tmp-str2 = string( internal-b-code, "999999999999" )
      188         .
      189       end.
      190       WHEN "EAN8" THEN do:
      191         assign
      192           tmp-str2 = string( internal-b-code, "9999999" )
      193         .
      194       end.
      195       OTHERWISE DO:
      196           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      197           view-as alert-box error.
      198           return error.
      199       END.
      200     END CASE.
      201     if varcont2 = yes then do:
      202       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      203       then do:
      204         message
      205           "Невозможно сформировать бар-код" SKIP
      206           "для товара с кодом: " internal-b-code
      207           view-as alert-box error title "подрезание кода".
      208         return error.
      209       end.
      210       else do:
      211         assign
      212           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      213           len-code2    = length( full-b-code )
      214         .
      215         define variable v-sum-char2 as character no-undo .
      216         assign
      217           sum2 = 0
      218         .
      219         do i2 = 1 to len-code2 by 2
      220         :
      221           assign
      222             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      223           .
      224           if v-sum-char2 < "0"
      225           or v-sum-char2 > "9"
      226           then do:
      227             message
      228               "Невозможно сформировать бар-код" skip
      229               "для товара с кодом: " internal-b-code skip
      230               view-as alert-box error title "подсчет контрольной суммы".
      231             return error.
      232           end.
      233           assign
      234             sum2 = sum2 + integer(v-sum-char2)
      235           .
      236         end.
      237         if varcont2 = yes then do:
      238           assign
      239             sum2 = sum2 * 3
      240           .
      241           do i2 = 2 to len-code2 by 2
      242           :
      243             assign
      244               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      245             .
      246             if v-sum-char2 < "0"
      247             or v-sum-char2 > "9"
      248             then do:
      249               message
      250                 "Невозможно сформировать бар-код" skip
      251                 "для товара с кодом: " internal-b-code skip
      252                 view-as alert-box error title "подсчет контрольной суммы".
      253               return error.
      254             end.
      255             assign
      256               sum2 = sum2 + integer(v-sum-char2)
      257             .
      258           end.
      259           if varcont2 = yes then do:
      260              if sum2 mod 10 = 0 then do:
      261                assign
      262                  full-b-code = full-b-code + '0'
      263                .
      264              end.
      265              else do:
      266                assign
      267                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      268                .
      269              end.
      270           end.
      271         end.
      272       end.
      273     end.
      274   END PROCEDURE.
      275   def new shared var pl-frmt as character no-undo .
      276   def new shared var pl-pfx  as character no-undo .
      277   def var pl-par-type as character no-undo .
      278       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      279       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      280           do:
      281               message "Не задан или не верно задан ТИП собственного бар-кода!"
      282                   view-as alert-box ERROR TITLE "".
      283               return error.
      284           end.
      285       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      286       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      287           do:
      288               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      289                   view-as alert-box ERROR TITLE "".
      290               return error.
      291           end.
