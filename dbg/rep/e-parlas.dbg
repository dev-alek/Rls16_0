      929   define variable var-report-r-b as character no-undo .
      930   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      931   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      932     (output var-report-r-b
      933     )  .
      934   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      935     define variable v-cntxt-db-num        as integer   no-undo .
      936     define variable v-cntxt-userid        as character no-undo .
      937     define variable v-cntxt-level         as character no-undo .
      938     define variable v-cntxt-host-code-obj as integer   no-undo .
      939     define variable v-cntxt-obj-type      as character no-undo .
      940     define variable v-cntxt-obj-code      as integer   no-undo .
      941     define variable v-cntxt-db-num-obj    as integer   no-undo .
      942     define variable v-cntxt-is-admin      as logical   no-undo .
      943   RUN set-attribute-list (
      944       'Keys-Accepted = "",
      945        Keys-Supplied = ""':U).
      946   DEFINE BUTTON b-choose-last-date
      947        IMAGE-UP FILE "btn-down-arrow":U
      948        IMAGE-DOWN FILE "btn-down-arrow":U
      949        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
      950        LABEL "b-choose-last-date"
      951        SIZE 3 BY .88 TOOLTIP "Годен до".
      952   DEFINE VARIABLE fi-description AS CHARACTER FORMAT "X(256)":U INITIAL "Выбор партий"
      953         VIEW-AS TEXT
      954        SIZE 35.13 BY .67
      955        FGCOLOR 4  NO-UNDO.
      956   DEFINE VARIABLE fi-last-date AS DATE FORMAT "99/99/9999":U
      957        VIEW-AS FILL-IN
      958        SIZE 11.5 BY 1 NO-UNDO.
      959   DEFINE VARIABLE fi-last-date-offset AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 0
      960        VIEW-AS FILL-IN
      961        SIZE 14 BY 1 NO-UNDO.
      962   DEFINE VARIABLE rs-select AS CHARACTER
      963        VIEW-AS RADIO-SET VERTICAL
      964        RADIO-BUTTONS
      965             "Дата 'Годен до' не задана", "not-defined",
      966   "Дата 'Годен до' меньше чем", "less-then",
      967   "Все", "all"
      968        SIZE 29.13 BY 2.67 NO-UNDO.
      969   DEFINE RECTANGLE RECT-1
      970        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      971        SIZE 77.38 BY 17.13.
      972   DEFINE FRAME F-Main
      973        rs-select AT ROW 2.92 COL 2.63 NO-LABEL
      974        fi-last-date AT ROW 3.75 COL 30.88 COLON-ALIGNED NO-LABEL
      975        fi-last-date-offset AT ROW 3.79 COL 47.25 COLON-ALIGNED NO-LABEL
      976        b-choose-last-date AT ROW 3.83 COL 45.25
      977        fi-description AT ROW 1.71 COL 3 NO-LABEL
      978        RECT-1 AT ROW 1.13 COL 1
      979       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      980            SIDE-LABELS NO-UNDERLINE THREE-D
      981            AT COL 1 ROW 1 SCROLLABLE .
      982   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      983   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      984   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      985   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      986   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      987   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      988   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      989   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      990         adm-object-hdl = FRAME F-Main:HANDLE.
      991   RUN ensure-broker.
      992   THIS-PROCEDURE:ADM-DATA =
      993        'ADM1.1~`':U +
      994        'SmartObject~`':U +
      995        '~`':U +
      996        'NO ~`':U +
      997        '~`':U +
      998        '~`':U +
      999        '~`':U +
     1000        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1001           + "~`":U +
     1002        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1003        'Record-Source,Record-Target,TableIO-Target~`':U +
     1004        '~`':U +
     1005        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1006        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1007            THEN "^^":U
     1008        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1009             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1010   PROCEDURE adm-apply-entry :
     1011     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-destroy :
     1014    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1015   END PROCEDURE.
     1016   PROCEDURE adm-disable :
     1017       DISABLE RECT-1 rs-select fi-last-date fi-last-date-offset b-choose-last-date fi-description WITH FRAME F-Main.
     1018       RUN dispatch ('disable-fields':U).
     1019       RUN set-attribute-list ('ENABLED=no':U).
     1020       RETURN.
     1021   END PROCEDURE.
     1022   PROCEDURE adm-edit-attribute-list :
     1023         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1024         RETURN.
     1025   END PROCEDURE.
     1026   PROCEDURE adm-enable :
     1027       ENABLE UNLESS-HIDDEN RECT-1 rs-select fi-last-date fi-last-date-offset b-choose-last-date fi-description WITH FRAME F-Main.
     1028       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1029       RUN set-attribute-list ('ENABLED=yes':U).
     1030       RETURN.
     1031   END PROCEDURE.
     1032   PROCEDURE adm-exit :
     1033        RUN notify ('exit':U).
     1034     RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE adm-hide :
     1037     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-initialize :
     1040     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1041   END PROCEDURE.
     1042   PROCEDURE adm-show-errors :
     1043       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1044       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1045           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1046       END.
     1047       RETURN.
     1048   END PROCEDURE.
     1049   PROCEDURE adm-UIB-mode :
     1050     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1051   END PROCEDURE.
     1052   PROCEDURE adm-view :
     1053     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1054   END PROCEDURE.
     1055   PROCEDURE dispatch :
     1056       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1057       RUN broker-dispatch IN adm-broker-hdl
     1058           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1059       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1060   END PROCEDURE.
     1061   PROCEDURE ensure-broker :
     1062   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1063   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1064   DO:
     1065       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1066       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1067   END.
     1068   END PROCEDURE.
     1069   PROCEDURE get-attribute :
     1070     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1071     RUN broker-get-attribute IN adm-broker-hdl
     1072         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1073     RETURN RETURN-VALUE.
     1074   END PROCEDURE.
     1075   PROCEDURE get-attribute-list :
     1076     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1077     RUN broker-get-attribute-list IN adm-broker-hdl
     1078         (INPUT THIS-PROCEDURE,
     1079          INPUT ?,
     1080          OUTPUT p-attr-list) NO-ERROR.
     1081     RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE new-state :
     1084     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1085     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1086     RETURN.
     1087   END PROCEDURE.
     1088   PROCEDURE notify :
     1089     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1090     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1091     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1092         RETURN "ADM-ERROR":U.
     1093     RETURN.
     1094   END PROCEDURE.
     1095   PROCEDURE set-attribute-list :
     1096     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1097     RUN ensure-broker.
     1098     RUN broker-set-attribute-list IN adm-broker-hdl
     1099         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1100     RETURN.
     1101   END PROCEDURE.
     1102   PROCEDURE set-position :
     1103       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1104       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1105       IF VALID-HANDLE(adm-object-hdl) THEN
     1106       DO:
     1107         ASSIGN adm-object-hdl:ROW    =   p-row
     1108                adm-object-hdl:COLUMN =   p-col.
     1109       END.
     1110       RETURN.
     1111   END PROCEDURE.
     1112   PROCEDURE adm-display-fields :
     1113       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1114       RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE adm-open-query :
     1117     RETURN.
     1118   END PROCEDURE.
     1119   PROCEDURE adm-row-changed :
     1120         IF VALID-HANDLE(adm-object-hdl) THEN
     1121           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1122         RUN notify ('row-available':U).
     1123         RETURN.
     1124   END PROCEDURE.
     1125   PROCEDURE reposition-query :
     1126       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1127       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1128       RETURN.
     1129   END PROCEDURE.
     1130     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1131     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1132     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1133     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1134     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1135     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1136     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1137     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1138     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1139     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1140     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1141     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1142     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1143     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1144     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1145     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1146     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1147     IF "":U = "":U THEN
     1148       RUN modify-list-attribute IN adm-broker-hdl
     1149         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1150     RUN use-create-on-add(?).
     1151   PROCEDURE adm-add-record :
     1152       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1153          "must have at least one Enabled Table to perform Add.":U
     1154          VIEW-AS ALERT-BOX ERROR.
