      493   def
      494    shared
      495   temp-table  obj-list no-undo
      496     field obj-type like ub.clients.obj-type
      497     field obj-code like ub.clients.obj-code
      498     field obj-name like ub.clients.obj-name
      499     field obj-id   as integer
