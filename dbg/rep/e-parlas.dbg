     1163     END PROCEDURE.
     1164   PROCEDURE adm-assign-statement :
     1165     RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE adm-cancel-record :
     1168      RETURN.
     1169     END PROCEDURE.
     1170   PROCEDURE adm-copy-record :
     1171       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1172        "must have at least one Enabled Table to perform Copy.":U
     1173          VIEW-AS ALERT-BOX ERROR.
     1174       RETURN.
     1175   END PROCEDURE.
     1176   PROCEDURE adm-create-record :
     1177      RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE adm-current-changed :
     1180     RETURN.
     1181   END PROCEDURE.
     1182   PROCEDURE adm-delete-record :
     1183    MESSAGE
     1184          "Object ":U THIS-PROCEDURE:FILE-NAME
     1185            "must have at least one Enabled Table to perform Delete.":U
     1186              VIEW-AS ALERT-BOX ERROR.
     1187       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1188       RETURN.
     1189   END PROCEDURE.
     1190   PROCEDURE adm-disable-fields :
     1191         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1192       RETURN.
     1193   END PROCEDURE.
     1194   PROCEDURE adm-enable-fields :
     1195       RETURN.
     1196   END PROCEDURE.
     1197   PROCEDURE adm-end-update :
     1198     RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE adm-reset-record :
     1201       RETURN.
     1202   END PROCEDURE.
     1203   PROCEDURE adm-update-record :
     1204       MESSAGE
     1205         "Object ":U THIS-PROCEDURE:FILE-NAME
     1206           "must have at least one Enabled Table to perform Update.":U
     1207             VIEW-AS ALERT-BOX ERROR.
     1208      RETURN.
     1209   END PROCEDURE.
     1210   PROCEDURE check-modified :
     1211   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1212   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1213   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1214   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1215     IF check-state = "check":U THEN
     1216     DO:
     1217       RUN get-link-handle IN adm-broker-hdl
     1218         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1219            OUTPUT group-target-list).
     1220       IF group-target-list NE "":U THEN
     1221       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1222         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1223         RUN check-modified IN curr-widget ('group-check':U).
     1224         IF RETURN-VALUE NE "":U THEN
     1225         DO:
     1226           RUN check-modified-message(RETURN-VALUE).
     1227           RETURN "":U.
     1228         END.
     1229       END.
     1230     END.
     1231     RETURN "":U.
     1232   END PROCEDURE.
     1233   PROCEDURE check-modified-message :
     1234     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1235        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1236           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1237        IF RETURN-VALUE = "YES":U THEN
     1238           RUN notify ('view,CONTAINER-SOURCE':U).
     1239        MESSAGE IF p-changed-table NE ? THEN
     1240           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1241           ELSE "Current values have been changed."
     1242           SKIP "  Do you wish to save those changes?"
     1243           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1244        IF ANS THEN
     1245        DO:
     1246           IF group-assign-target THEN
     1247             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1248           ELSE RUN dispatch('update-record':U).
     1249           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1250           DO:
     1251               MESSAGE "Changes to the previous record were not saved."
     1252                 VIEW-AS ALERT-BOX ERROR.
     1253               IF group-assign-target THEN
     1254                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1255               ELSE RUN dispatch ('cancel-record':U).
     1256           END.
     1257        END.
     1258        ELSE DO:
     1259          IF group-assign-target THEN
     1260             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1261          ELSE RUN dispatch('cancel-record':U).
     1262        END.
     1263        RETURN.
     1264   END PROCEDURE.
     1265   PROCEDURE get-rowid :
     1266       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1267       ASSIGN
     1268       p-table   =   adm-first-table.
     1269       RETURN.
     1270   END PROCEDURE.
     1271   PROCEDURE init-group-assign :
     1272       RUN request-attribute IN adm-broker-hdl
     1273         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1274       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1275         group-assign-target = yes.
     1276       ELSE group-assign-target = no.
     1277       RETURN.
     1278   END PROCEDURE.
     1279   PROCEDURE set-editors :
     1280       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1281       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1282       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1283       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1284       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1285       DO WHILE VALID-HANDLE (curr-widget):
     1286           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1287              curr-widget:HIDDEN = no THEN DO:
     1288             CASE p-field-setting:
     1289               WHEN "INITIALIZE":U THEN
     1290               DO:
     1291                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1292                     read-only-list +
     1293                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1294                        STRING(curr-widget).
     1295               END.
     1296               WHEN "DISABLE":U OR
     1297               WHEN "ENABLE":U THEN
     1298               DO:
     1299                   curr-widget:SENSITIVE = yes.
     1300                   RUN get-attribute ('Read-Only-Editors':U).
     1301                   IF RETURN-VALUE = ? OR
     1302                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1303                       curr-widget:READ-ONLY =
     1304                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1305               END.
     1306               WHEN "CLEAR":U THEN
     1307                   curr-widget:SCREEN-VALUE = "":U.
     1308             END CASE.
     1309           END.
     1310           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1311       END.
     1312       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1313         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1314           + '"':U).
     1315       RETURN.
     1316   END PROCEDURE.
     1317   PROCEDURE use-check-modified-all :
     1318    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1319     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1320     RETURN.
     1321   END PROCEDURE.
     1322   PROCEDURE use-create-on-add :
     1323   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1324      RETURN.
     1325   END PROCEDURE.
     1326   PROCEDURE use-initial-lock :
     1327     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1328     ASSIGN adm-initial-lock = p-attr-value.
     1329     RETURN.
     1330   END PROCEDURE.
     1331     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1332   ASSIGN
     1333          FRAME F-Main:SCROLLABLE       = FALSE
     1334          FRAME F-Main:HIDDEN           = TRUE.
     1335   ON CHOOSE OF b-choose-last-date IN FRAME F-Main
     1336   DO:
     1337     run sel-date in this-procedure
     1338       (input fi-last-date :handle
     1339       ,input "Годен до &1 (для партии товара)"
     1340       ) .
     1341   END.
     1342   ON LEAVE OF fi-last-date IN FRAME F-Main
     1343   DO:
     1344     run update-last-date-offset in this-procedure .
     1345   END.
     1346   ON LEAVE OF fi-last-date-offset IN FRAME F-Main
     1347   DO:
     1348     define variable v-last-date as date      no-undo .
     1349     define variable v-today as date      no-undo .
     1350     define variable v-time  as integer   no-undo .
     1351     run cur-time in this-procedure
     1352       (output v-today
     1353       ,output v-time
     1354       ) .
     1355     run godendo-offset-to-date in this-procedure
     1356       (input  v-today
     1357       ,input  (input frame F-Main fi-last-date-offset)
     1358       ,output v-last-date
     1359       ) .
     1360     assign
     1361       fi-last-date     :screen-value = string(v-last-date
     1362                                               ,fi-last-date :format)
     1363     .
     1364   END.
     1365   ON VALUE-CHANGED OF rs-select IN FRAME F-Main
     1366   DO:
     1367     assign
     1368       rs-select
     1369     .
     1370     if rs-select = "less-then"
     1371     then do:
     1372       assign
     1373         fi-last-date        :visible   = true
     1374         fi-last-date        :sensitive = true
     1375         b-choose-last-date  :visible   = true
     1376         b-choose-last-date  :sensitive = true
     1377         fi-last-date-offset :visible   = true
     1378         fi-last-date-offset :sensitive = true
     1379       .
     1380     end.
     1381     else do:
     1382       assign
     1383         fi-last-date        :sensitive = false
     1384         fi-last-date        :visible   = false
     1385         b-choose-last-date  :sensitive = false
     1386         b-choose-last-date  :visible   = false
     1387         fi-last-date-offset :sensitive = false
     1388         fi-last-date-offset :visible   = false
     1389       .
     1390     end.
     1391   END.
     1392   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1393     run mainmenu_getcntxt in my-handle
     1394       (output v-cntxt-db-num
     1395       ,output v-cntxt-userid
     1396       ,output v-cntxt-level
     1397       ,output v-cntxt-host-code-obj
     1398       ,output v-cntxt-obj-type
     1399       ,output v-cntxt-obj-code
     1400       ,output v-cntxt-db-num-obj
     1401       ,output v-cntxt-is-admin
     1402       ) .
     1403   if not this-procedure :persistent
     1404   then do:
     1405     message
     1406       vss-workfile vss-revision vss-description skip
     1407       "Ошибка при запуске процедуры" skip
     1408       "Данную процедуру следует запускать только с параметром persistent" skip
     1409       view-as alert-box error .
     1410     undo, return error .
     1411   end.
     1412   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1413   on ' ' of fi-last-date in frame F-Main
     1414   do:
     1415     if (can-query (self, "sensitive")
     1416        and
     1417        self :sensitive = true
     1418        )
     1419     or (can-query (self, "read-only")
     1420        and
     1421        self :read-only = false
     1422        )
     1423     then do:
     1424       assign
     1425         self :screen-value = ?
     1426       .
     1427     end.
     1428     return no-apply.
     1429   end.
     1430   on delete-character of fi-last-date in frame F-Main
     1431   do:
     1432     if (can-query (self, "sensitive")
     1433        and
     1434        self :sensitive = true
     1435        )
     1436     or (can-query (self, "read-only")
     1437        and
     1438        self :read-only = false
     1439        )
     1440     then do:
     1441       assign
     1442         self :screen-value = ?
     1443       .
     1444     end.
     1445     return no-apply.
     1446   end.
     1447   on ctrl-d of fi-last-date in frame F-Main
     1448   do:
     1449     define variable v-curr-sv-date as date no-undo .
     1450     if (can-query (self, "sensitive")
     1451        and
     1452        self :sensitive = true
     1453        )
     1454     or (can-query (self, "read-only")
     1455        and
     1456        self :read-only = false
     1457        )
     1458     then do:
     1459       if self :handle <> focus :handle
     1460       then do:
     1461         apply "entry":u to self .
     1462       end.
     1463       run gbl/getcurdt.p
     1464         (output v-curr-sv-date
     1465         ) .
     1466       assign
     1467         self :screen-value = string(v-curr-sv-date) .
     1468       .
     1469     end.
     1470     return no-apply.
     1471   end.
     1472   on ctrl-b of fi-last-date in frame F-Main
     1473   do:
     1474     if (can-query (self, "sensitive")
     1475        and
     1476        self :sensitive = true
     1477        )
     1478     or (can-query (self, "read-only")
     1479        and
     1480        self :read-only = false
     1481        )
     1482     then do:
     1483       if self :handle <> focus :handle
     1484       then do:
     1485         apply "entry":u to self .
     1486       end.
     1487       define variable v-curr-sv-date as date no-undo .
     1488       define variable v-new-sv-date  as date no-undo .
     1489       assign
     1490         v-curr-sv-date = date(self :screen-value) no-error
     1491       .
     1492       if v-curr-sv-date = ?
     1493       then do:
     1494         run gbl/getcurdt.p
     1495           (output v-curr-sv-date
     1496           ) .
     1497       end.
     1498       if v-curr-sv-date <> ?
     1499       then do:
     1500         assign
     1501           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1502         .
     1503         assign
     1504           self :screen-value = string(v-new-sv-date) .
     1505         .
     1506       end.
     1507     end.
     1508     return no-apply .
     1509   end.
     1510   on ctrl-e of fi-last-date in frame F-Main
     1511   do:
     1512     if (can-query (self, "sensitive")
     1513        and
     1514        self :sensitive = true
     1515        )
     1516     or (can-query (self, "read-only")
     1517        and
     1518        self :read-only = false
     1519        )
     1520     then do:
     1521       if self :handle <> focus :handle
     1522       then do:
     1523         apply "entry":u to self .
     1524       end.
     1525       define variable v-curr-sv-date as date no-undo .
     1526       define variable v-new-sv-date  as date no-undo .
     1527       assign
     1528         v-curr-sv-date = date(self :screen-value) no-error
     1529       .
     1530       if v-curr-sv-date = ?
     1531       then do:
     1532         run gbl/getcurdt.p
     1533           (output v-curr-sv-date
     1534           ) .
     1535       end.
     1536       if v-curr-sv-date <> ?
     1537       then do:
     1538         run gbl/lastdate.p
     1539           (input  v-curr-sv-date
     1540           ,output v-new-sv-date
     1541           ).
     1542         assign
     1543           self :screen-value = string(v-new-sv-date) .
     1544         .
     1545       end.
     1546     end.
     1547     return no-apply .
     1548   end.
     1549   on ctrl-f of fi-last-date in frame F-Main
     1550   do:
     1551     if (can-query (self, "sensitive")
     1552        and
     1553        self :sensitive = true
     1554        )
     1555     or (can-query (self, "read-only")
     1556        and
     1557        self :read-only = false
     1558        )
     1559     then do:
     1560       if self :handle <> focus :handle
     1561       then do:
     1562         apply "entry":u to self .
     1563       end.
     1564       define variable v-ok            as logical   no-undo .
     1565       define variable v-curr-sv-date  as date      no-undo .
     1566       define variable v-description   as character no-undo .
     1567       assign
     1568         v-curr-sv-date = date(self :screen-value) no-error
     1569       .
     1570       if v-curr-sv-date = ?
     1571       then do:
     1572         run gbl/getcurdt.p
     1573           (output v-curr-sv-date
     1574           ) .
     1575       end.
     1576       if v-curr-sv-date <> ?
     1577       then do:
     1578         run gbl/d-inpday.w
     1579           (input ?
     1580           ,input "Выбор даты"
     1581           ,input v-description
     1582           ,input ""
     1583           ,input-output v-curr-sv-date
     1584           ,output v-ok
     1585           ).
     1586         if v-ok = true
     1587         then do:
     1588           assign
     1589             self :screen-value = string(v-curr-sv-date) .
     1590           .
     1591         end.
     1592       end.
     1593     end.
     1594     return no-apply .
     1595   end.
     1596     define MENU m-ed-date13
     1597       MENU-ITEM m-ed-date13-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1598       MENU-ITEM m-ed-date13-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1599       MENU-ITEM m-ed-date13-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1600       MENU-ITEM m-ed-date13-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1601       .
     1602     if fi-last-date :POPUP-MENU in frame F-Main = ?
     1603     then do:
     1604       ASSIGN
     1605         fi-last-date :POPUP-MENU in frame F-Main = MENU m-ed-date13 :HANDLE
     1606         fi-last-date :MENU-MOUSE in frame F-Main = 3
     1607       .
     1608     end.
     1609     define variable v-label-handle13 as handle no-undo .
     1610     assign
     1611       v-label-handle13 = fi-last-date :side-label-handle in frame F-Main
     1612     .
     1613     if valid-handle (v-label-handle13)
     1614     then do:
     1615       if v-label-handle13 :tooltip = ""
     1616       or v-label-handle13 :tooltip = ?
     1617       then do:
     1618         assign
     1619           v-label-handle13 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1620         .
     1621       end.
     1622     end.
     1623     ON CHOOSE OF MENU-ITEM m-ed-date13-1 in menu m-ed-date13 DO:
     1624       apply "ctrl-b":U to fi-last-date in frame F-Main .
     1625     END.
     1626     ON CHOOSE OF MENU-ITEM m-ed-date13-2 in menu m-ed-date13 DO:
     1627       apply "ctrl-d":U to fi-last-date in frame F-Main .
     1628     END.
     1629     ON CHOOSE OF MENU-ITEM m-ed-date13-3 in menu m-ed-date13 DO:
     1630       apply "ctrl-e":U to fi-last-date in frame F-Main .
     1631     END.
     1632     ON CHOOSE OF MENU-ITEM m-ed-date13-4 in menu m-ed-date13 DO:
     1633       apply "ctrl-f":U to fi-last-date in frame F-Main .
     1634     END.
     1635   PROCEDURE adm-row-available :
     1636     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1637     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1638     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1639     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1640     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1641     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1642     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1643     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1644     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1645     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1646     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1647     IF adm-updating-record THEN RETURN.
     1648     RUN get-attribute ('FIELDS-ENABLED':U).
     1649     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1650     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1651         OUTPUT link-handle) NO-ERROR.
     1652     IF link-handle = "":U THEN
     1653         RETURN.
     1654     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1655     IF NUM-ENTRIES(link-handle) > 1 THEN
     1656         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1657             "encountered more than one RECORD-SOURCE.":U SKIP
     1658             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1659                VIEW-AS ALERT-BOX ERROR.
     1660     RUN get-attribute ('Key-Name':U).
     1661     key-name = RETURN-VALUE.
     1662     IF key-name = "":U THEN key-name = ?.
     1663     IF key-name NE ? THEN DO:
     1664       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1665         NO-ERROR.
     1666       IF key-value NE ? THEN
     1667         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1668     END.
     1669   IF VALID-HANDLE (adm-object-hdl) THEN
     1670       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1671   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1672   END PROCEDURE.
     1673   PROCEDURE disable_UI :
     1674     HIDE FRAME F-Main.
     1675     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1676   END PROCEDURE.
     1677   PROCEDURE local-apply-layout :
     1678     do with frame F-Main
     1679     :
     1680       define variable v-date as date      no-undo .
     1681       define variable v-time as integer   no-undo .
     1682       run cur-time in this-procedure
     1683         (output v-date
     1684         ,output v-time
     1685         ) .
     1686       assign
     1687         rs-select               = "not-defined"
     1688         fi-last-date            = v-date
     1689       .
     1690       display
     1691         rs-select
     1692         fi-last-date
     1693         fi-description
     1694         with frame F-Main
     1695       .
     1696       run update-last-date-offset in this-procedure .
     1697     end.
     1698     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1699     do with frame F-Main
     1700     :
     1701       assign
     1702         fi-last-date        :sensitive = false
     1703         fi-last-date        :visible   = false
     1704         b-choose-last-date  :sensitive = false
     1705         b-choose-last-date  :visible   = false
     1706         fi-last-date-offset :sensitive = false
     1707         fi-last-date-offset :visible   = false
     1708       .
     1709     end.
     1710   END PROCEDURE.
     1711   PROCEDURE my-report :
     1712     do
     1713     on error undo, return error return-value
     1714     :
     1715       run My-var.
     1716       run rep/d-parlas.w
     1717         (input my-handle
     1718         ,input v-cntxt-obj-type
     1719         ,input v-cntxt-obj-code
     1720         ,input rs-select
     1721         ,input fi-last-date
     1722         ) .
     1723     end.
     1724   END PROCEDURE.
     1725   PROCEDURE my-var :
     1726       assign frame F-Main
     1727           rs-select
     1728           fi-last-date
     1729       .
     1730       define variable v-select-string  as character no-undo.
     1731       case rs-select
     1732       :
     1733         when "not-defined"
     1734         then do:
     1735           assign
     1736             v-select-string = "Партии с незаданным сроком годности"
     1737           .
     1738         end.
     1739         when "less-then"
     1740         then do:
     1741           assign
     1742             v-select-string = "Партии со сроком годности меньше чем " + string(fi-last-date, '99/99/9999':u)
     1743           .
     1744         end.
     1745         when "all"
     1746         then do:
     1747           assign
     1748             v-select-string = "Все партии"
     1749           .
     1750         end.
     1751         otherwise do:
     1752           message
     1753             vss-workfile vss-revision vss-description skip
     1754             "Внутренняя ошибка" skip
     1755             "Неизвестное значение переменной rs-select" skip
     1756             "rs-select" rs-select skip
     1757             view-as alert-box error .
     1758           undo, return error return-value .
     1759         end.
     1760       end case .
     1761       assign
     1762           ReportName      = "Редактирование сроков годности партий товара"
     1763           ReportHeader    = v-select-string
     1764       .
     1765   END PROCEDURE.
     1766   PROCEDURE send-records :
     1767   END PROCEDURE.
     1768   PROCEDURE state-changed :
     1769     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1770     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1771     CASE p-state:
     1772       WHEN 'update-begin':U THEN DO:
     1773           RUN dispatch('enable-fields':U).
     1774           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1775           DO:
     1776             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1777             RUN new-state('update-complete':U).
     1778           END.
     1779           ELSE RUN new-state ('update':U).
     1780       END.
     1781       WHEN 'update-complete':U THEN DO:
     1782           RUN new-state ('update-complete':U).
     1783       END.
     1784     END CASE.
     1785   END PROCEDURE.
     1786   PROCEDURE update-last-date-offset :
     1787     do with frame F-Main
     1788     :
     1789       define variable v-last-date-offset as integer   no-undo .
     1790       define variable v-today     as date      no-undo .
     1791       define variable v-time      as integer   no-undo .
     1792       run cur-time in this-procedure
     1793         (output v-today
     1794         ,output v-time
     1795         ) .
     1796       run godendo-date-to-offset in this-procedure
     1797         (input  v-today
     1798         ,input  (input frame F-Main fi-last-date)
     1799         ,output v-last-date-offset
     1800         ) .
     1801       assign
     1802         fi-last-date-offset :screen-value = string(v-last-date-offset
     1803                                                   ,fi-last-date-offset :format
     1804                                                   )
     1805       .
     1806     end.
     1807   END PROCEDURE.
