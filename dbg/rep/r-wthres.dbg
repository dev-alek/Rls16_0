      201   procedure create_obj-list :
      202      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      203      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      204      do
      205      on error undo, return error return-value
      206      :
      207         define buffer cli-obj for ub.clients .
      208         define variable p-var as integer no-undo .
      209         define buffer buf_obj-list for obj-list .
      210         find last buf_obj-list  use-index pi no-error .
      211         if available buf_obj-list
      212         then
      213            p-var = buf_obj-list.obj-id + 1.
      214         else
      215            p-var = 1.
      216         find first cli-obj where
      217                   cli-obj.obj-type = p-obj-type
      218               and cli-obj.obj-code = p-obj-code
      219         no-lock no-error.
      220         if available cli-obj
      221         then do:
      222            create buf_obj-list.
      223            assign
      224               buf_obj-list.obj-id   = p-var
      225               buf_obj-list.obj-code = cli-obj.obj-code
      226               buf_obj-list.obj-type = cli-obj.obj-type
      227               buf_obj-list.obj-name = cli-obj.obj-name
      228               buf_obj-list.db-num   = cli-obj.db-num
      229            .
      230         end.
      231      end.
      232   end.
