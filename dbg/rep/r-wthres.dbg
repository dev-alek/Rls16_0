      635   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      636   procedure paramls-clear :
      637     define buffer buf_temp-param for temp-param .
      638     do
      639     on error undo, return error return-value
      640     :
      641       for each buf_temp-param
      642       on error undo, return error
      643       :
      644         delete buf_temp-param .
      645       end.
      646     end.
      647   end procedure.
      648   procedure paramls-write :
      649     define input  parameter p-code     as character no-undo .
      650     define input  parameter p-sub-code as character no-undo .
      651     define input  parameter p-value    as character no-undo .
      652     define buffer buf_temp-param for temp-param .
      653     do
      654     on error undo, return error return-value
      655     :
      656       find first buf_temp-param
      657         where buf_temp-param.param-code     = p-code
      658           and buf_temp-param.param-sub-code = p-sub-code
      659         no-error .
      660       if not available buf_temp-param then do:
      661         create buf_temp-param .
      662         assign
      663           buf_temp-param.param-code     = p-code
      664           buf_temp-param.param-sub-code = p-sub-code
      665         .
      666       end.
      667       assign
      668         buf_temp-param.param-value = p-value
      669       .
      670     end.
      671   end procedure.
      672   procedure paramls-read :
      673     define input  parameter p-code          as character no-undo .
      674     define input  parameter p-sub-code      as character no-undo .
      675     define input  parameter p-default-value as character no-undo .
      676     define output parameter p-value         as character no-undo .
      677     define buffer buf_temp-param for temp-param .
      678     do
      679     on error undo, return error return-value
      680     :
      681       find first buf_temp-param
      682         where buf_temp-param.param-code     = p-code
      683           and buf_temp-param.param-sub-code = p-sub-code
      684         no-error .
      685       if available buf_temp-param then do:
      686         assign
      687           p-value = buf_temp-param.param-value
      688         .
      689       end.
      690       else do:
      691         assign
      692           p-value = p-default-value
      693         .
      694       end.
      695     end.
      696   end procedure.
      697   procedure paramls-append :
      698     define input  parameter p-code     as character no-undo .
      699     define input  parameter p-sub-code as character no-undo .
      700     define input  parameter p-value    as character no-undo .
      701     define buffer buf_temp-param for temp-param .
      702     do
      703     on error undo, return error return-value
      704     :
      705       find first buf_temp-param
      706            where buf_temp-param.param-code     = p-code
      707              and buf_temp-param.param-sub-code = p-sub-code
      708         no-error .
      709       if not available buf_temp-param then do:
      710         create buf_temp-param .
      711         assign
      712           buf_temp-param.param-code     = p-code
      713           buf_temp-param.param-sub-code = p-sub-code
      714           buf_temp-param.param-value    = p-value
      715         .
      716       end.
      717       else do:
      718           assign
      719               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      720           .
      721       end.
      722     end.
      723   end procedure.
      724   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      725     define variable v-cntxt-db-num        as integer   no-undo .
      726     define variable v-cntxt-userid        as character no-undo .
      727     define variable v-cntxt-level         as character no-undo .
      728     define variable v-cntxt-host-code-obj as integer   no-undo .
      729     define variable v-cntxt-obj-type      as character no-undo .
      730     define variable v-cntxt-obj-code      as integer   no-undo .
      731     define variable v-cntxt-db-num-obj    as integer   no-undo .
