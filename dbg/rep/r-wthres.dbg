      733   define variable vss-include-info10 as character format "X(65)" no-undo
      734   initial "@(#)$Workfile$ $Revision$".
      735   define stream excel-line.
      736   define stream excel-cell.
      737   define temp-table temp_cell-data no-undo
      738       field data-key as character
      739       field data-value as character
      740       index pi is primary unique data-key
      741   .
      742   define variable v-wthres-sheet1-cur-data-row     as integer      no-undo.
      743   define variable v-wthres-cell-file-name       as character    no-undo.
      744   define variable v-wthres-data-file-name       as character    no-undo.
      745   procedure wthres-init :
      746   do
      747   on error undo, return error
      748   :
      749       assign
      750           v-wthres-sheet1-cur-data-row = 0
      751       .
      752       run gbl/_tmpfile.p (
      753             input "xd"
      754           , input ".txt"
      755           , output v-wthres-data-file-name
      756       ).
      757       output stream excel-line to value( v-wthres-data-file-name ).
      758       run gbl/_tmpfile.p (
      759             input "xc"
      760           , input ".txt"
      761           , output v-wthres-cell-file-name
      762       ).
      763       output stream excel-cell to value( v-wthres-cell-file-name ).
      764       run wthres-write-cell-data in this-procedure (
      765             input "sheetList":U
      766           , input "Template":U
      767       ).
      768       if printrubl
      769       then do:
      770           run wthres-write-cell-data in this-procedure (
      771                 input "Template_valutCode":U
      772               , input "0":U
      773           ).
      774       end.
      775       else do:
      776           run wthres-write-cell-data in this-procedure (
      777                 input "Template_valutCode":U
      778               , input "1":U
      779           ).
      780       end.
      781       run wthres-write-cell-data in this-procedure (
      782             input "Template_columnList":U
      783           , input "wth_name,wth_par,qnty_free,qnty_out":U
      784       ).
      785       run wthres-write-cell-data in this-procedure (
      786             input "Template_columnType":U
      787           , input "S,S,S,S":U
      788       ).
      789       run wthres-write-cell-data in this-procedure (
      790             input "Template_subtotalList":U
      791           , input "":U
      792       ).
      793       run wthres-write-cell-data in this-procedure (
      794             input "Template_subtotalType":U
      795           , input "":U
      796       ).
      797   end.
      798   end procedure.
      799   procedure wthres-sheet1-write-line-data :
      800   define input parameter p-wth-name      as character        no-undo.
      801   define input parameter p-wth-par-name  as character        no-undo.
      802   define input parameter p-wth-qnty-free as character        no-undo.
      803   define input parameter p-wth-qnty-put  as character        no-undo.
      804   do
      805   on error undo, return error
      806   :
      807         put stream excel-line unformatted
      808                               "Template":U
      809               CHR(9)   "DTA":U
      810               CHR(9)   p-wth-name
      811               CHR(9)   p-wth-par-name
      812               CHR(9)   p-wth-qnty-free
      813               CHR(9)   p-wth-qnty-put
      814               chr(10)
      815         .
      816   end.
      817   end procedure.
      818   procedure wthres-sheet1-write-line-style :
      819   define input parameter p-style         as character        no-undo.
      820   do
      821   on error undo, return error
      822   :
      823         put stream excel-line unformatted
      824                           "Template":U
      825            CHR(9)  "FMT":U
      826            CHR(9)  p-style
      827            chr(10)
      828         .
      829   end.
      830   end procedure.
      831   procedure wthres-write-cell-data :
      832   define input parameter p-data-key   as character        no-undo.
      833   define input parameter p-data-value as character        no-undo.
      834       define buffer buf_temp_cell-data     for temp_cell-data.
      835   do
      836   for buf_temp_cell-data
      837   on error undo, return error
      838   :
      839       find first buf_temp_cell-data
      840            where buf_temp_cell-data.data-key = p-data-key
      841       no-error.
      842       if not available buf_temp_cell-data
      843       then do:
      844           create buf_temp_cell-data.
      845           assign
      846               buf_temp_cell-data.data-key = p-data-key
      847           .
      848       end.
      849       assign
      850           buf_temp_cell-data.data-value = p-data-value
      851       .
      852       put stream excel-cell unformatted
      853                           buf_temp_cell-data.data-key
      854           CHR(9)   buf_temp_cell-data.data-value
      855           chr(10)
      856       .
      857   end.
      858   end procedure.
      859   procedure wthres-run-excel :
      860   define input parameter p-header-filename    as character        no-undo.
      861   define input parameter p-data-filename      as character        no-undo.
      862   define variable v-template-file-name    as character    no-undo.
      863   define variable v-vb-file-name          as character    no-undo.
      864   define buffer buf_temp-param for temp-param .
      865   do
      866   for buf_temp-param
      867   on error undo, return error
      868   :
      869       create buf_temp-param.
      870       assign
      871           v-template-file-name    = search( "exe/wthres.xlt" )
      872           v-vb-file-name          = search( "exe/t_form.bas" )
      873       .
      874       if v-template-file-name = ?
      875       or v-template-file-name = "":U
      876       then do:
      877           message
      878               "Ошибка имени файла шаблона."
      879           view-as alert-box error.
      880       end.
      881       if v-vb-file-name = ?
      882       or v-vb-file-name = "":U
      883       then do:
      884           message
      885               "Ошибка имени файла кода обработки."
      886           view-as alert-box error.
      887       end.
      888       run paramls-write in this-procedure (
      889             input "template":U
      890           , input "template-file-name":U
      891           , input v-template-file-name
      892       ).
      893       run paramls-write in this-procedure (
      894             input "template":U
      895           , input "vb-file-name":U
      896           , input v-vb-file-name
      897       ).
      898       run paramls-write in this-procedure (
      899             input "data":U
      900           , input "data-header-filename":U
      901           , input p-header-filename
      902       ).
      903       run paramls-write in this-procedure (
      904             input "data":U
      905           , input "data-filename":U
      906           , input p-data-filename
      907       ).
      908       run gbl/macroxlt.p (
      909           input-output table buf_temp-param
      910       ) no-error.
      911       if error-status :error
      912       then do:
      913           message
      914                    vss-workfile vss-revision vss-description
      915               skip(1)
      916               skip "Ошибка создания файла Excel."
      917               skip return-value
      918               skip trim(error-status :get-message(1))
      919                    trim(error-status :get-message(2))
      920                    trim(error-status :get-message(3))
      921           view-as alert-box error.
      922           undo, return error .
      923       end.
      924   end.
      925   end procedure.
      926   procedure wthres-close :
      927   do
      928   on error undo, return error
      929   :
      930       output stream excel-line close.
      931       output stream excel-cell close.
      932       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
      933           export "exe/wthres.xlt" .
      934           export "exe/t_form.bas" .
      935           export v-wthres-cell-file-name.
      936           export v-wthres-data-file-name.
      937       output close.
      938   end.
      939   end procedure.
      940   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   procedure factord :
      942     define input  parameter p-fact-date            as date    no-undo .
      943     define input  parameter p-fact-time            as integer no-undo .
      944     define input  parameter p-fact-num             as integer no-undo .
      945     define input  parameter p-shift-date           as date    no-undo .
      946     define input  parameter p-shift-num            as integer no-undo .
      947     define input  parameter p-shift-on             as logical no-undo .
      948     define output parameter p-fact-order           as decimal no-undo .
      949     define output parameter p-shift-end-fact-order as decimal no-undo .
      950     define output parameter p-day-end-fact-order   as decimal no-undo .
      951     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      952     if p-fact-date = ?
      953     then do:
      954       return error "Не указана фактическая дата" .
      955     end.
      956     define variable v-fact-date-num as integer no-undo .
      957     assign
      958       v-fact-date-num = integer(p-fact-date)
      959     .
      960     if p-fact-num = ?
      961     or p-fact-num = 0
      962     then do:
      963       return error "Не задан p-fact-num " + string(p-fact-num) .
      964     end.
      965     if p-fact-num < 0
      966     then do:
      967       return error "Отрицательный fact-num " + string(p-fact-num) .
      968     end.
      969     if p-fact-num >= 100000000
      970     then do:
      971       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      972     end.
      973     if p-shift-on = true
      974     then do:
      975       if p-shift-date = ?
      976       then do:
      977         return error "Не задана дата смены" .
      978       end.
      979       if p-shift-num = ?
      980       or p-shift-num = 0
      981       then do:
      982         return error "Не задан номер смены" .
      983       end.
      984     end.
      985     else do:
      986       assign
      987         p-shift-date = p-fact-date
      988         p-shift-num  = 24
      989       .
      990     end.
      991     define variable v-shift-offset as integer no-undo .
      992     if p-shift-date = p-fact-date
      993     then do:
      994       assign
      995         v-shift-offset = 1
      996       .
      997     end.
      998     if p-shift-date < p-fact-date
      999     then do:
     1000       assign
     1001         v-shift-offset = 0
     1002       .
     1003     end.
     1004     if p-shift-date > p-fact-date
     1005     then do:
     1006       message
     1007         vss-workfile vss-revision vss-description skip
     1008         "Неправильная дата закрытия смены" skip
     1009         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1010         view-as alert-box error .
     1011       undo, return error
     1012         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1013           ,string(p-fact-date, '99/99/9999':U)
     1014           ,string(p-shift-date, '99/99/9999':U)
     1015           )
     1016       .
     1017     end.
     1018     if p-shift-num < 1
     1019     or p-shift-num > 24
     1020     then do:
     1021       message
     1022         vss-workfile vss-revision vss-description skip
     1023         "Неправильный номер смены" skip
     1024         "p-shift-num" p-shift-num skip
     1025         view-as alert-box error .
     1026       undo, return error return-value .
     1027     end.
     1028     assign
     1029       p-fact-order           = v-fact-date-num
     1030                              + v-shift-offset * 0.5
     1031                              + p-shift-num    * 0.02 - 0.01
     1032                              + p-fact-num     * 0.0000000001
     1033       p-shift-end-fact-order = v-fact-date-num
     1034                              + v-shift-offset * 0.5
     1035                              + p-shift-num    * 0.02
     1036       p-day-end-fact-order   = v-fact-date-num
     1037                              + 0.99
     1038     .
     1039     if p-fact-order           <= v-fact-date-num
     1040     or p-shift-end-fact-order <= v-fact-date-num
     1041     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1042     or p-shift-end-fact-order >= p-day-end-fact-order
     1043     then do:
     1044       message
     1045         vss-workfile vss-revision vss-description skip
     1046         "Внутренняя ошибка при генерации фактического номера" skip
     1047         "p-fact-date"            p-fact-date            skip
     1048         "p-fact-time"            p-fact-time            skip
     1049         "p-fact-num"             p-fact-num             skip
     1050         "p-shift-date"           p-shift-date           skip
     1051         "p-shift-num"            p-shift-num            skip
     1052         "p-shift-on"             p-shift-on             skip
     1053         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1054         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1055         "v-fact-date-num"        v-fact-date-num        skip
     1056         view-as alert-box error .
     1057       undo, return error return-value .
     1058     end.
     1059   end procedure.
     1060   procedure day-begin-fact-order :
     1061     define input  parameter p-fact-date            as date    no-undo .
     1062     define output parameter p-day-begin-fact-order as decimal no-undo .
     1063     do
     1064     on error undo, return error return-value
     1065     :
     1066       if p-fact-date = ?
     1067       then do:
     1068         assign
     1069           p-day-begin-fact-order = 0
     1070         .
     1071       end.
     1072       else do:
     1073         assign
     1074           p-day-begin-fact-order = integer(p-fact-date)
     1075         .
     1076       end.
     1077     end.
     1078   end procedure.
     1079   procedure factord-max-fact-order :
     1080     define output parameter p-max-fact-order as decimal   no-undo .
     1081     do
     1082     on error undo, return error return-value
     1083     :
     1084       run day-begin-fact-order in this-procedure
     1085         (input  date(1, 1, 5000)
     1086         ,output p-max-fact-order
     1087         ) .
     1088     end.
     1089   end procedure.
     1090   procedure factord-cut-archive :
     1091     define input  parameter p-obj-type             as character no-undo .
     1092     define input  parameter p-obj-code             as integer   no-undo .
     1093     define input  parameter p-fact-date            as date      no-undo .
     1094     define output parameter p-shift-on             as logical   no-undo .
     1095     define output parameter p-shift-date           as date      no-undo .
     1096     define output parameter p-shift-num            as integer   no-undo .
     1097     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1098     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1099     define variable v-fact-order as decimal   no-undo .
     1100     define buffer buf_shift-obj for ub.shift-obj .
     1101     do
     1102     on error undo, return error return-value
     1103     :
     1104   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1105   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1106     (input  p-obj-type
     1107     ,input  p-obj-code
     1108     ,input  'shift-on=request'
     1109     ,output p-shift-on
     1110     ) no-error .
     1111       if error-status :error
     1112       then do:
     1113         message
     1114           vss-workfile vss-revision vss-description skip
     1115           "Ошибка при определении атрибута объекта" skip
     1116           "Объект" p-obj-type p-obj-code skip
     1117           error-status :get-message(1) skip
     1118           return-value skip
     1119           view-as alert-box error .
     1120         undo, return error return-value .
     1121       end.
     1122       if p-shift-on = false
     1123       then do:
     1124         assign
     1125           p-shift-date               = ?
     1126           p-shift-num                = 0
     1127         .
     1128       end.
     1129       else do:
     1130         find first buf_shift-obj share-lock
     1131           where buf_shift-obj.obj-type   = p-obj-type
     1132             and buf_shift-obj.obj-code   = p-obj-code
     1133             and buf_shift-obj.shift-date > p-fact-date
     1134           use-index pi
     1135           no-error .
     1136         if not available buf_shift-obj
     1137         or buf_shift-obj.status_ <> 'зкр':U
     1138         then do:
     1139           message
     1140             vss-workfile vss-revision vss-description skip
     1141             "Невозможно вычислить последнюю смену" skip
     1142             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1143             "Объект" p-obj-type p-obj-code skip
     1144             "Дата" p-fact-date skip
     1145             view-as alert-box error .
     1146           undo, return error return-value .
     1147         end.
     1148         find last buf_shift-obj share-lock
     1149           where buf_shift-obj.obj-type = p-obj-type
     1150             and buf_shift-obj.obj-code = p-obj-code
     1151             and buf_shift-obj.shift-date <= p-fact-date
     1152           use-index pi
     1153           no-error .
     1154         if available buf_shift-obj
     1155         then do:
     1156           if  buf_shift-obj.status_ = 'зкр':U
     1157           then do:
     1158             assign
     1159               p-shift-date = buf_shift-obj.shift-date
     1160               p-shift-num  = buf_shift-obj.shift-num
     1161             .
     1162           end.
     1163           else do:
     1164             message
     1165               vss-workfile vss-revision vss-description skip
     1166               "Невозможно вычислить последнюю смену" skip
     1167               "Статус смены отличен от статуса" 'зкр':U skip
     1168               "Объект" p-obj-type p-obj-code skip
     1169               "Дата" p-fact-date skip
     1170               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1171               view-as alert-box error .
     1172             undo, return error return-value .
     1173           end.
     1174         end.
     1175         else do:
     1176           assign
     1177             p-shift-date = p-fact-date - 1
     1178             p-shift-num  = 1
     1179           .
     1180         end.
     1181       end.
     1182       run factord in this-procedure
     1183         (input  p-fact-date
     1184         ,input  1
     1185         ,input  1
     1186         ,input  p-shift-date
     1187         ,input  p-shift-num
     1188         ,input  p-shift-on
     1189         ,output v-fact-order
     1190         ,output p-shift-end-fact-order
     1191         ,output p-day-end-fact-order
     1192         ) no-error .
     1193       if error-status :error
     1194       then do:
     1195         message
     1196           vss-workfile vss-revision vss-description skip
     1197           "Ошибка при вызове процедуры factord"
     1198           error-status :get-message(1) skip
     1199           return-value skip
     1200           view-as alert-box error .
     1201         undo, return error return-value .
     1202       end.
     1203     end.
     1204   end procedure.
     1205   procedure factord-lock-shift :
     1206     define input  parameter p-obj-type  as character no-undo .
     1207     define input  parameter p-obj-code  as integer   no-undo .
     1208     define input  parameter p-fact-date as date      no-undo .
     1209     define parameter buffer buf_shift-obj for ub.shift-obj .
     1210     define variable v-shift-on      as logical   no-undo .
     1211     define variable v-extra-message as character no-undo .
     1212     define variable v-error as character no-undo .
     1213     do
     1214     on error undo, return error return-value
     1215     :
     1216   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1217   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1218     (input  p-obj-type
     1219     ,input  p-obj-code
     1220     ,input  'shift-on=request'
     1221     ,output v-shift-on
     1222     ) no-error .
     1223       if error-status :error
     1224       then do:
     1225         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1226         undo, return error v-error .
     1227       end.
     1228       if v-shift-on = true
     1229       then do:
     1230         find first buf_shift-obj share-lock
     1231           where buf_shift-obj.obj-type   = p-obj-type
     1232             and buf_shift-obj.obj-code   = p-obj-code
     1233             and buf_shift-obj.shift-date > p-fact-date
     1234           use-index pi
     1235           no-error .
     1236         if not available buf_shift-obj
     1237         or buf_shift-obj.status_ <> 'зкр':U
     1238         then do:
     1239           find last buf_shift-obj
     1240             where buf_shift-obj.obj-type = p-obj-type
     1241               and buf_shift-obj.obj-code = p-obj-code
     1242               and buf_shift-obj.status_  = 'зкр':U
     1243             use-index stts
     1244             no-error .
     1245           if available buf_shift-obj
     1246           then do:
     1247             assign
     1248               v-extra-message =
     1249                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1250                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1251                               )
     1252             .
     1253           end.
     1254           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1255           undo, return error v-error .
     1256         end.
     1257       end.
     1258     end.
     1259   end procedure.
     1260   procedure factord-end-day :
     1261     define input  parameter p-fact-date            as date    no-undo .
     1262     define output parameter p-day-end-fact-order   as decimal no-undo .
     1263     do
     1264     on error undo, return error return-value
     1265     :
     1266       if p-fact-date = ?
     1267       then do:
     1268         return error "Не указана фактическая дата" .
     1269       end.
     1270       assign
     1271         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1272       .
     1273     end.
     1274   end procedure.
     1275   procedure factord-to-date :
     1276     define input  parameter p-fact-order as decimal no-undo .
     1277     define output parameter p-fact-date  as date    no-undo .
     1278     define variable v-ref-date  as date      no-undo .
     1279     define variable v-ref-delta as integer   no-undo .
     1280     do
     1281     on error undo, return error return-value
     1282     :
     1283       if p-fact-order = ?
     1284       or p-fact-order = 0
     1285       then do:
     1286         return error "Не указан fact-order" .
     1287       end.
     1288       assign
     1289         v-ref-date  = date(1, 1, 2000)
     1290       .
     1291       assign
     1292         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1293       .
     1294       assign
     1295         p-fact-date = v-ref-date + v-ref-delta
     1296       .
     1297     end.
     1298   end procedure.
     1299   procedure factord-to-fact-num :
     1300     define input  parameter p-fact-order as decimal no-undo .
     1301     define output parameter p-fact-num   as integer no-undo .
     1302     define variable v-fact-order-trunc as decimal no-undo .
     1303     do
     1304     on error undo, return error return-value
     1305     :
     1306       if p-fact-order = ?
     1307       or p-fact-order = 0
     1308       then do:
     1309         return error "Не указан fact-order" .
     1310       end.
     1311       assign
     1312        v-fact-order-trunc = truncate(p-fact-order, 2)
     1313       .
     1314       assign
     1315         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1316       .
     1317     end.
     1318   end procedure.
     1319   procedure factord-to-shift-num :
     1320     define input  parameter p-fact-order as decimal no-undo .
     1321     define output parameter p-shift-num   as integer no-undo .
     1322     define variable  p-shift-numd  as decimal   no-undo .
     1323     define variable v-fact-order-trunc as decimal no-undo .
     1324     do
     1325     on error undo, return error return-value
     1326     :
     1327       if p-fact-order = ?
     1328       or p-fact-order = 0
     1329       then do:
     1330         return error "Не указан fact-order" .
     1331       end.
     1332       assign
     1333        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1334       .
     1335       if v-fact-order-trunc < 0.5 then do:
     1336         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1337       end.
     1338       assign
     1339         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1340         .
     1341        assign
     1342         p-shift-num = truncate (p-shift-numd , 0)
     1343       .
     1344     end.
     1345   end procedure.
     1346   do
     1347   on error undo, return error
     1348   :
     1349   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1350     run mainmenu_getcntxt in parparentproc
     1351       (output v-cntxt-db-num
     1352       ,output v-cntxt-userid
     1353       ,output v-cntxt-level
     1354       ,output v-cntxt-host-code-obj
     1355       ,output v-cntxt-obj-type
     1356       ,output v-cntxt-obj-code
     1357       ,output v-cntxt-db-num-obj
     1358       ,output v-cntxt-is-admin
     1359       ) .
     1360   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1361   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1362     (input  v-cntxt-obj-type
     1363     ,input  v-cntxt-obj-code
     1364     ,input  'shift-on=request'
     1365     ,output v-obj-shift
     1366     ) no-error .
     1367      if error-status :error
     1368      then do:
     1369         message
     1370            vss-workfile vss-revision vss-description skip
     1371            "Ошибка при запуске процедуры objat" skip
     1372            error-status :get-message(1) skip
     1373            return-value skip
     1374            view-as alert-box error .
     1375         return.
     1376      end.
     1377      IF v-obj-shift
     1378      THEN DO:
     1379         RUN factord IN THIS-PROCEDURE ( INPUT x-date-alone + 1
     1380                                       , INPUT 0
     1381                                       , INPUT 1
     1382                                       , INPUT x-date-alone + 1
     1383                                       , INPUT X-shift-Alone
     1384                                       , INPUT yes
     1385                                       , OUTPUT v-fact-order
     1386                                       , OUTPUT v-empty-1
     1387                                       , OUTPUT v-empty-2
     1388                                       ) .
     1389         ASSIGN
     1390            v-period = x-date-alone
     1391         .
     1392      END.
     1393      ELSE DO:
     1394         RUN factord IN THIS-PROCEDURE ( INPUT x-date-alone
     1395                                       , INPUT 0
     1396                                       , INPUT 1
     1397                                       , INPUT X-date-Start
     1398                                       , INPUT X-shift-Alone + 1
     1399                                       , INPUT no
     1400                                       , OUTPUT v-fact-order
     1401                                       , OUTPUT v-empty-1
     1402                                       , OUTPUT v-empty-2
     1403                                       ) .
     1404         ASSIGN
     1405            v-period = X-date-Start
     1406         .
     1407      END.
     1408      FIND FIRST buf_clients
     1409            where buf_clients.obj-type = 'орг':U
     1410            AND buf_clients.obj-code = v-cntxt-host-code-obj
     1411            no-lock
     1412            .
     1413      assign
     1414         v-firm   = buf_clients.obj-name
     1415      .
     1416      run open-stream     IN THIS-PROCEDURE .
     1417      run fill-temp-table in this-procedure .
     1418       run wthres-write-cell-data in this-procedure (
     1419             input "firm":U
     1420           , input v-firm
     1421       ).
     1422       run wthres-write-cell-data in this-procedure (
     1423             input "period":U
     1424           , input v-period
     1425       ).
     1426       run wthres-write-cell-data in this-procedure (
     1427             input "place":U
     1428           , input v-place-name-list
     1429       ).
     1430      run close-stream    IN THIS-PROCEDURE .
     1431   end.
     1432   procedure fill-temp-table :
     1433   define buffer buf_wth-place  for ub.wth-place .
     1434   define buffer buf_wealth     for ub.wealth .
     1435   define variable v-count    as integer      no-undo.
     1436   define variable v-qnty-free-total-pl    as integer      no-undo.
     1437   define variable v-qnty-put-total-pl     as integer      no-undo.
     1438   define variable v-qnty-free    as integer      no-undo.
     1439   define variable v-qnty-put     as integer      no-undo.
     1440   do
     1441   on error undo, return error
     1442   :
     1443      IF p-wth-pl-all
     1444      THEN DO:
     1445         FOR EACH  buf_wth-place
     1446             WHERE (    v-cntxt-db-num = 0
     1447                    AND buf_wth-place.host-code = v-cntxt-host-code-obj
     1448                   )
     1449                 OR
     1450                   (    v-cntxt-db-num <> 0
     1451                    AND buf_wth-place.obj-type = v-cntxt-obj-type
     1452                    AND buf_wth-place.obj-code = v-cntxt-obj-code
     1453                   )
     1454             NO-LOCK
     1455             :
     1456             find first buf_clients
     1457                  where buf_clients.obj-type = buf_wth-place.obj-type
     1458                    and buf_clients.obj-code = buf_wth-place.obj-code
     1459                  no-lock
     1460                  .
     1461             assign
     1462                v-qnty-free-total-pl = 0
     1463                v-qnty-put-total-pl  = 0
     1464                v-place-name-list = IF v-place-name-list = "":U THEN SUBSTITUTE("&1 (&2)", buf_wth-place.w-p-name, buf_clients.obj-name)
     1465                                                                ELSE SUBSTITUTE("&1, &2 (&3)", v-place-name-list, buf_wth-place.w-p-name, buf_clients.obj-name)
     1466             .
     1467             run wthres-sheet1-write-line-data in this-procedure  ( INPUT SUBSTITUTE("&1 (&2)", buf_wth-place.w-p-name, buf_clients.obj-name)
     1468                                                                  , INPUT "":U
     1469                                                                  , INPUT "":U
     1470                                                                  , INPUT "":U
     1471                                                                  ) .
     1472             run wthres-sheet1-write-line-style in this-procedure  ( INPUT "FM_1":U
     1473                                                                   ) .
     1474               IF p-wth-all
     1475               THEN DO:
     1476                  FOR EACH buf_wealth
     1477                     NO-LOCK
     1478                     :
     1479                       RUN print-one-wth IN THIS-PROCEDURE ( INPUT buf_wealth.wth-code
     1480                                                       , INPUT buf_wth-place.obj-type
     1481                                                       , INPUT buf_wth-place.obj-code
     1482                                                       , INPUT buf_wth-place.w-p-code
     1483                                                       , INPUT buf_wealth.wth-name
     1484                                                       , OUTPUT v-qnty-free
     1485                                                       , OUTPUT v-qnty-put
     1486                                                       ) .
     1487                        assign
     1488                           v-qnty-free-total-pl = v-qnty-free-total-pl + v-qnty-free
     1489                           v-qnty-put-total-pl  = v-qnty-put-total-pl  + v-qnty-put
     1490                        .
     1491                  END.
     1492               END.
     1493               ELSE DO:
     1494                  DO v-count = 1 TO NUM-ENTRIES(p-wth-list)
     1495                  on error undo, next
     1496                  :
     1497                     find first buf_wealth
     1498                        where   buf_wealth.wth-code = INTEGER(ENTRY(v-count, p-wth-list))
     1499                        no-lock
     1500                        no-error
     1501                        .
     1502                     IF AVAILABLE buf_wealth
     1503                     THEN DO:
     1504                       RUN print-one-wth IN THIS-PROCEDURE ( INPUT buf_wealth.wth-code
     1505                                                       , INPUT buf_wth-place.obj-type
     1506                                                       , INPUT buf_wth-place.obj-code
     1507                                                       , INPUT buf_wth-place.w-p-code
     1508                                                       , INPUT buf_wealth.wth-name
     1509                                                       , OUTPUT v-qnty-free
     1510                                                       , OUTPUT v-qnty-put
     1511                                                       ) .
     1512                        assign
     1513                           v-qnty-free-total-pl = v-qnty-free-total-pl + v-qnty-free
     1514                           v-qnty-put-total-pl  = v-qnty-put-total-pl  + v-qnty-put
     1515                        .
     1516                     END.
     1517                  END.
     1518               END.
     1519               run wthres-sheet1-write-line-data in this-procedure  ( INPUT SUBSTITUTE("Итого по &1 (&2):", buf_wth-place.w-p-name, buf_clients.obj-name)
     1520                                                                     , INPUT "":U
     1521                                                                     , INPUT v-qnty-free-total-pl
     1522                                                                     , INPUT v-qnty-put-total-pl
     1523                                                                     ) .
     1524         END.
     1525      END.
     1526      ELSE DO:
     1527         DO v-count = 1 TO NUM-ENTRIES(p-wth-pl-list)
     1528         on error undo, next
     1529         :
     1530            find first buf_wth-place
     1531               where RECID(buf_wth-place) = INTEGER(ENTRY(v-count, p-wth-pl-list))
     1532               no-lock
     1533               no-error
     1534               .
     1535            IF AVAILABLE buf_wth-place
     1536            THEN DO:
     1537             find first buf_clients
     1538                  where buf_clients.obj-type = buf_wth-place.obj-type
     1539                    and buf_clients.obj-code = buf_wth-place.obj-code
     1540                  no-lock
     1541                  .
     1542             assign
     1543                v-qnty-free-total-pl = 0
     1544                v-qnty-put-total-pl  = 0
     1545                v-place-name-list = IF v-place-name-list = "":U THEN SUBSTITUTE("&1 (&2)", buf_wth-place.w-p-name, buf_clients.obj-name)
     1546                                                                ELSE SUBSTITUTE("&1, &2 (&3)", v-place-name-list, buf_wth-place.w-p-name, buf_clients.obj-name)
     1547             .
     1548             run wthres-sheet1-write-line-data in this-procedure  ( INPUT SUBSTITUTE("&1 (&2)", buf_wth-place.w-p-name, buf_clients.obj-name)
     1549                                                                  , INPUT "":U
     1550                                                                  , INPUT "":U
     1551                                                                  , INPUT "":U
     1552                                                                  ) .
     1553             run wthres-sheet1-write-line-style in this-procedure  ( INPUT "FM_1":U
     1554                                                                   ) .
     1555               IF p-wth-all
     1556               THEN DO:
     1557                  FOR EACH buf_wealth
     1558                     NO-LOCK
     1559                     :
     1560                       RUN print-one-wth IN THIS-PROCEDURE ( INPUT buf_wealth.wth-code
     1561                                                       , INPUT buf_wth-place.obj-type
     1562                                                       , INPUT buf_wth-place.obj-code
     1563                                                       , INPUT buf_wth-place.w-p-code
     1564                                                       , INPUT buf_wealth.wth-name
     1565                                                       , OUTPUT v-qnty-free
     1566                                                       , OUTPUT v-qnty-put
     1567                                                       ) .
     1568                        assign
     1569                           v-qnty-free-total-pl = v-qnty-free-total-pl + v-qnty-free
     1570                           v-qnty-put-total-pl  = v-qnty-put-total-pl  + v-qnty-put
     1571                        .
     1572                  END.
     1573               END.
     1574               ELSE DO:
     1575                  DO v-count = 1 TO NUM-ENTRIES(p-wth-list)
     1576                  on error undo, next
     1577                  :
     1578                     find first buf_wealth
     1579                        where   buf_wealth.wth-code = INTEGER(ENTRY(v-count, p-wth-list))
     1580                        no-lock
     1581                        no-error
     1582                        .
     1583                     IF AVAILABLE buf_wealth
     1584                     THEN DO:
     1585                       RUN print-one-wth IN THIS-PROCEDURE ( INPUT buf_wealth.wth-code
     1586                                                       , INPUT buf_wth-place.obj-type
     1587                                                       , INPUT buf_wth-place.obj-code
     1588                                                       , INPUT buf_wth-place.w-p-code
     1589                                                       , INPUT buf_wealth.wth-name
     1590                                                       , OUTPUT v-qnty-free
     1591                                                       , OUTPUT v-qnty-put
     1592                                                       ) .
     1593                        assign
     1594                           v-qnty-free-total-pl = v-qnty-free-total-pl + v-qnty-free
     1595                           v-qnty-put-total-pl  = v-qnty-put-total-pl  + v-qnty-put
     1596                        .
     1597                     END.
     1598                  END.
     1599               END.
     1600               run wthres-sheet1-write-line-data in this-procedure  ( INPUT SUBSTITUTE("Итого по &1 (&2):", buf_wth-place.w-p-name, buf_clients.obj-name)
     1601                                                                     , INPUT "":U
     1602                                                                     , INPUT v-qnty-free-total-pl
     1603                                                                     , INPUT v-qnty-put-total-pl
     1604                                                                     ) .
     1605            END.
     1606         END.
     1607      END.
     1608   end.
     1609   end procedure.
     1610   procedure open-stream :
     1611   do
     1612   on error undo, return error
     1613   :
     1614   if session :set-wait-state( "compiler" ) then.
     1615   output stream out-stream to value( string( session:temp-directory +
     1616                                        "rpt" + string( g#report-num ) ) )
     1617                                        page-size 62 .
     1618       put stream out-stream unformatted
     1619             chr(10)
     1620           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     1621           + chr(10)
     1622       .
     1623       output stream out-stream close.
     1624       run wthres-init in this-procedure.
     1625   end.
     1626   end procedure.
     1627   procedure close-stream :
     1628   do
     1629   on error undo, return error
     1630   :
     1631       run wthres-close in this-procedure .
     1632       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1633       os-rename
     1634           value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     1635           value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     1636       .
     1637   if session :set-wait-state( "" ) then.
     1638       define variable v-user-action   as character no-undo .
     1639       define variable v-printed       as logical   no-undo .
     1640       define variable DisabledOptions as integer   no-undo .
     1641       define variable v-orient-page as character no-undo .
     1642       run gbl/prnfilen.w (
     1643             input "":U
     1644           , input 8
     1645           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     1646           , input ReportFontNum
     1647           , output v-user-action
     1648           , output v-printed
     1649       ).
     1650       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     1651   end.
     1652   end procedure.
     1653   procedure print-one-wth :
     1654   define input parameter p-wth-code as integer          no-undo.
     1655   define input parameter p-obj-type as character        no-undo.
     1656   define input parameter p-obj-code as integer          no-undo.
     1657   define input parameter p-w-p-code as integer          no-undo.
     1658   define input parameter p-wth-name as character        no-undo.
     1659   define output parameter p-qnty-free as integer          no-undo.
     1660   define output parameter p-qnty-put as integer          no-undo.
     1661   define buffer buf_arh-wth-w-p    for ub.arh-wth-w-p .
     1662   define buffer buf_wth-par     for ub.wth-par .
     1663   do
     1664   on error undo, return error
     1665   :
     1666      FOR EACH  buf_wth-par
     1667          WHERE buf_wth-par.wth-code = p-wth-code
     1668          NO-LOCK
     1669          :
     1670          FIND  LAST buf_arh-wth-w-p
     1671               WHERE buf_arh-wth-w-p.obj-type   = p-obj-type
     1672                 and buf_arh-wth-w-p.obj-code   = p-obj-code
     1673                 and buf_arh-wth-w-p.w-p-code   = p-w-p-code
     1674                 and buf_arh-wth-w-p.wth-code   = p-wth-code
     1675                 AND buf_arh-wth-w-p.par-code   = buf_wth-par.par-code
     1676                 AND buf_arh-wth-w-p.out-code   = 'free-zone':U
     1677                 AND buf_arh-wth-w-p.fact-order <= v-fact-order
     1678               NO-LOCK
     1679               NO-ERROR
     1680               .
     1681          IF AVAILABLE buf_arh-wth-w-p
     1682          THEN DO:
     1683            ASSIGN
     1684               p-qnty-free = buf_arh-wth-w-p.in-qnty - buf_arh-wth-w-p.out-qnty
     1685            .
     1686          END.
     1687          FIND  LAST buf_arh-wth-w-p
     1688               WHERE buf_arh-wth-w-p.obj-type = p-obj-type
     1689                 and buf_arh-wth-w-p.obj-code = p-obj-code
     1690                 and buf_arh-wth-w-p.w-p-code = p-w-p-code
     1691                 and buf_arh-wth-w-p.wth-code = p-wth-code
     1692                 AND buf_arh-wth-w-p.par-code = buf_wth-par.par-code
     1693                 AND buf_arh-wth-w-p.out-code = 'put-zone':U
     1694                 AND buf_arh-wth-w-p.fact-order <= v-fact-order
     1695               NO-LOCK
     1696               NO-ERROR
     1697               .
     1698          IF AVAILABLE buf_arh-wth-w-p
     1699          THEN DO:
     1700            ASSIGN
     1701               p-qnty-put = buf_arh-wth-w-p.in-qnty - buf_arh-wth-w-p.out-qnty
     1702            .
     1703          END.
     1704          run wthres-sheet1-write-line-data in this-procedure  ( INPUT p-wth-name
     1705                                                               , INPUT SUBSTITUTE ("&1 &2", buf_wth-par.par-val, buf_wth-par.par-unit)
     1706                                                               , INPUT p-qnty-free
     1707                                                               , INPUT p-qnty-put
     1708                                                               ) .
     1709      END.
     1710   end.
     1711   end procedure.
