      189   def
      190    shared
      191   temp-table  obj-list no-undo
      192     field obj-type like ub.clients.obj-type
      193     field obj-code like ub.clients.obj-code
      194     field obj-name like ub.clients.obj-name
      195     field obj-id   as integer
