      141   def new shared var bc-frmt as character no-undo .
      142   def new shared var bc-pfx  as character no-undo .
      143   def var bc-par-type as character no-undo .
      144       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      145       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      146           do:
      147               message "Не задан или не верно задан ТИП собственного бар-кода!"
      148                   view-as alert-box ERROR TITLE "".
      149               return error.
      150           end.
      151       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      152       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      153           do:
      154               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      155                   view-as alert-box ERROR TITLE "".
      156               return error.
      157           end.
      158   PROCEDURE gen-bc:
      159     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      160     def output parameter full-b-code     as character init ""    no-undo .
      161   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      162     define variable tmp-str2  as character no-undo.
      163     define variable tmp-num2  as character no-undo.
      164     define variable i2        as integer   no-undo.
      165     define variable sum2      as integer   no-undo.
      166     define variable len-code2 as integer   no-undo.
      167     define variable varcont2  as logical   initial yes no-undo.
      168     CASE bc-frmt :
      169       WHEN "EAN13" THEN do:
      170         assign
      171           tmp-str2 = string( internal-b-code, "999999999999" )
      172         .
      173       end.
      174       WHEN "EAN8" THEN do:
      175         assign
      176           tmp-str2 = string( internal-b-code, "9999999" )
      177         .
      178       end.
      179       OTHERWISE DO:
      180           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      181           view-as alert-box error.
      182           return error.
      183       END.
      184     END CASE.
      185     if varcont2 = yes then do:
      186       if integer( substring( tmp-str2, 1, length( bc-pfx ) ) ) <> 0
      187       then do:
      188         message
      189           "Невозможно сформировать бар-код" SKIP
      190           "для товара с кодом: " internal-b-code
      191           view-as alert-box error title "подрезание кода".
      192         return error.
      193       end.
      194       else do:
      195         assign
      196           full-b-code = bc-pfx + substring( tmp-str2, length( bc-pfx ) + 1, length( tmp-str2 ) - length( bc-pfx ) )
      197           len-code2    = length( full-b-code )
      198         .
      199         define variable v-sum-char2 as character no-undo .
      200         assign
      201           sum2 = 0
      202         .
      203         do i2 = 1 to len-code2 by 2
      204         :
      205           assign
      206             v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      207           .
      208           if v-sum-char2 < "0"
      209           or v-sum-char2 > "9"
      210           then do:
      211             message
      212               "Невозможно сформировать бар-код" skip
      213               "для товара с кодом: " internal-b-code skip
      214               view-as alert-box error title "подсчет контрольной суммы".
      215             return error.
      216           end.
      217           assign
      218             sum2 = sum2 + integer(v-sum-char2)
      219           .
      220         end.
      221         if varcont2 = yes then do:
      222           assign
      223             sum2 = sum2 * 3
      224           .
      225           do i2 = 2 to len-code2 by 2
      226           :
      227             assign
      228               v-sum-char2 = substr(full-b-code, len-code2 - i2 + 1, 1)
      229             .
      230             if v-sum-char2 < "0"
      231             or v-sum-char2 > "9"
      232             then do:
      233               message
      234                 "Невозможно сформировать бар-код" skip
      235                 "для товара с кодом: " internal-b-code skip
      236                 view-as alert-box error title "подсчет контрольной суммы".
      237               return error.
      238             end.
      239             assign
      240               sum2 = sum2 + integer(v-sum-char2)
      241             .
      242           end.
      243           if varcont2 = yes then do:
      244              if sum2 mod 10 = 0 then do:
      245                assign
      246                  full-b-code = full-b-code + '0'
      247                .
      248              end.
      249              else do:
      250                assign
      251                  full-b-code = full-b-code + string(10 - sum2 mod 10)
      252                .
      253              end.
      254           end.
      255         end.
      256       end.
      257     end.
      258   END PROCEDURE.
