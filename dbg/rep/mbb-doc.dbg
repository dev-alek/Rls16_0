      598   define buffer buf_trn-doc for ub.trn-doc  .
      599   define variable v-obj-type  as character no-undo .
      600   define variable v-obj-code  as integer   no-undo .
      601   define buffer buf_doc-line for ub.doc-line  .
      602   define buffer buf_gds-obj  for ub.gds-obj  .
      603   define buffer buf_parts for ub.parts  .
      604   define buffer buf_bar-code for ub.bar-code  .
      605   define buffer buf_prod-bc for ub.prod-bc  .
      606   define buffer buf_goods for ub.goods  .
      607   define buffer buf_gds-dtl for ub.gds-dtl  .
      608   define variable  lns-cnt as integer   no-undo .
      609   define variable  line-rec as recid no-undo .
      610   define variable v-ean as character no-undo .
      611   define variable v-root-node as integer   no-undo .
      612   define variable is-prt as logical   no-undo .
      613   define variable v-value as character no-undo .
      614   define variable v-type  as character no-undo .
      615   define variable v-new-qnty as logical   no-undo .
      616   define variable v-new-qnty1 as integer   no-undo .
      617   do
      618   on error undo, return error return-value
      619   :
      620    find first buf_trn-doc no-lock where recid(buf_trn-doc)  = p-recid .
      621     empty temp-table scnblist.
      622     v-obj-type = buf_trn-doc.obj-type.
      623     v-obj-code = buf_trn-doc.obj-code.
      624     for each buf_doc-line no-lock where
      625               buf_doc-line.doc-code = buf_trn-doc.doc-code,
      626               first buf_gds-obj no-lock where
      627                     buf_gds-obj.artic     =  buf_doc-line.artic and
      628                     buf_gds-obj.prod-type =  buf_doc-line.prod-type and
      629                     buf_gds-obj.prod-code =  buf_doc-line.prod-code and
      630                     buf_gds-obj.obj-type  =  buf_trn-doc.obj-type and
      631                     buf_gds-obj.obj-code  =  buf_trn-doc.obj-code ,
      632               first buf_goods no-lock where
      633                     buf_goods.artic     =  buf_doc-line.artic and
      634                     buf_goods.prod-type =  buf_doc-line.prod-type and
      635                     buf_goods.prod-code =  buf_doc-line.prod-code
      636                     :
      637             run  gdsoattr-value in this-procedure
      638               ( input 'doc-tickets':U ,
      639                 input buf_goods.gds-code    ,
      640                 input buf_gds-obj.obj-type  ,
      641                 input buf_gds-obj.obj-code  ,
      642                 output v-value       ,
      643                 output v-type
      644                 ) no-error .
      645              v-new-qnty = true  .
      646              if v-value = "fact-qnty"  or
      647                 v-value = ""  or
      648                 v-value = ?
      649              then do:
      650                v-new-qnty = false .
      651              end.
      652              else do:
      653                 if v-value begins "val" then v-value = substring(v-value,4).
      654                 v-new-qnty1 = int(v-value) no-error .
      655                 if v-value begins "quest" then v-new-qnty1 = ?.
      656              end.
      657   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      658   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
      659     (input  buf_goods.artic
      660     ,input  buf_goods.prod-type
      661     ,input  buf_goods.prod-code
      662     ,output v-root-node
      663     )  .
      664         find first ub.gds-prt where ub.gds-prt.node-code = v-root-node no-error .
      665         if ub.gds-prt.node-name <> '_Пустая шкала':U  then is-prt  = true .
      666         else is-prt = false   .
      667        if buf_gds-obj.cash-parts then do:
      668           for each buf_parts no-lock where
      669                    buf_parts.out-code  =  buf_trn-doc.doc-code and
      670                    buf_parts.artic     =  buf_doc-line.artic and
      671                    buf_parts.prod-type =  buf_doc-line.prod-type and
      672                    buf_parts.prod-code =  buf_doc-line.prod-code and
      673                    buf_parts.obj-type  =  buf_trn-doc.obj-type and
      674                    buf_parts.obj-code  =  buf_trn-doc.obj-code :
      675                    find first buf_bar-code no-lock where
      676                               buf_bar-code.gds-code  = buf_goods.gds-code  and
      677                               buf_bar-code.part-code = buf_parts.part-code and
      678                               buf_bar-code.in-code   = buf_parts.in-code and
      679                               buf_bar-code.unit-cli   = buf_goods.unit-base
      680                               no-error .
      681                     if error-status :error then return error "Бар-код не создан. Закройте документ!" .
      682                    run gen-bc in this-procedure (input buf_bar-code.b-code , output v-ean) no-error .
      683                    find first buf_prod-bc no-lock where
      684                               buf_prod-bc.b-code = buf_bar-code.b-code  no-error .
      685   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      686   find first scnblist
      687     where scnblist.gds-code = buf_bar-code.gds-code
      688       and scnblist.b-code   = buf_bar-code.b-code
      689       and scnblist.b-str    = v-ean
      690     no-error .
      691   if available scnblist then do:
      692     assign
      693       scnblist.to-del = no
      694     .
      695   end.
      696   else do:
      697     define variable v-last5 as integer no-undo .
      698     find last scnblist use-index oi no-error.
      699     if available scnblist then do:
      700       v-last5 = scnblist.order-num .
      701     end.
      702     else do:
      703       v-last5 = 0 .
      704     end.
      705     create scnblist .
      706     buffer-copy buf_goods to scnblist
      707     assign
      708       scnblist.to-del = no
      709       scnblist.order-num = v-last5 + 1
      710       scnblist.b-code = buf_bar-code.b-code
      711       scnblist.bc-cli-base-rate = buf_bar-code.cli-base-rate
      712       scnblist.bc-cr-db-num     = buf_bar-code.cr-db-num
      713       scnblist.in-code       = buf_bar-code.in-code
      714       scnblist.node-code     = buf_bar-code.node-code
      715       scnblist.part-code     = buf_bar-code.part-code
      716       scnblist.stts_         = buf_bar-code.stts_
      717       scnblist.bc-unit-cli   = buf_bar-code.unit-cli
      718       scnblist.b-str         = v-ean
      719       scnblist.f-name        = ''
      720       scnblist.loc-ean       = true
      721       .
      722       if available buf_prod-bc
      723       then
      724       assign
      725       scnblist.bc-on-type    = buf_prod-bc.bc-on-type
      726       scnblist.bc-on         = buf_prod-bc.bc-on
      727       scnblist.pbc-cr-db-num = buf_prod-bc.cr-db-num
      728       .
      729     assign
      730       lns-cnt = lns-cnt + 1
      731       line-rec = recid (scnblist)
      732     .
      733   end.
      734                   scnblist.qnty = buf_parts.fact-qnty .
      735                   if v-new-qnty then scnblist.qnty = v-new-qnty1 .
      736           end.
      737        end.
      738        else do:
      739           if is-prt = true then do:
      740              for each buf_gds-dtl no-lock where
      741                    buf_gds-dtl.doc-code  =  buf_trn-doc.doc-code and
      742                    buf_gds-dtl.artic     =  buf_doc-line.artic and
      743                    buf_gds-dtl.prod-type =  buf_doc-line.prod-type and
      744                    buf_gds-dtl.prod-code =  buf_doc-line.prod-code :
      745                    find first buf_bar-code no-lock where
      746                               buf_bar-code.gds-code  = buf_goods.gds-code  and
      747                               buf_bar-code.node-code = buf_gds-dtl.prt-code and
      748                               buf_bar-code.part-code = "" and
      749                               buf_bar-code.in-code   = "" and
      750                               buf_bar-code.unit-cli   = buf_goods.unit-base
      751                               no-error .
      752                    if error-status :error then return error "Бар-код не создан. Закройте документ!" .
      753                    run gen-bc in this-procedure (input buf_bar-code.b-code , output v-ean) no-error .
      754                    find first buf_prod-bc no-lock where
      755                               buf_prod-bc.b-code = buf_bar-code.b-code  no-error .
      756   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      757   find first scnblist
      758     where scnblist.gds-code = buf_bar-code.gds-code
      759       and scnblist.b-code   = buf_bar-code.b-code
      760       and scnblist.b-str    = v-ean
      761     no-error .
      762   if available scnblist then do:
      763     assign
      764       scnblist.to-del = no
      765     .
      766   end.
      767   else do:
      768     define variable v-last6 as integer no-undo .
      769     find last scnblist use-index oi no-error.
      770     if available scnblist then do:
      771       v-last6 = scnblist.order-num .
      772     end.
      773     else do:
      774       v-last6 = 0 .
      775     end.
      776     create scnblist .
      777     buffer-copy buf_goods to scnblist
      778     assign
      779       scnblist.to-del = no
      780       scnblist.order-num = v-last6 + 1
      781       scnblist.b-code = buf_bar-code.b-code
      782       scnblist.bc-cli-base-rate = buf_bar-code.cli-base-rate
      783       scnblist.bc-cr-db-num     = buf_bar-code.cr-db-num
      784       scnblist.in-code       = buf_bar-code.in-code
      785       scnblist.node-code     = buf_bar-code.node-code
      786       scnblist.part-code     = buf_bar-code.part-code
      787       scnblist.stts_         = buf_bar-code.stts_
      788       scnblist.bc-unit-cli   = buf_bar-code.unit-cli
      789       scnblist.b-str         = v-ean
      790       scnblist.f-name        = ''
      791       scnblist.loc-ean       = true
      792       .
      793       if available buf_prod-bc
      794       then
      795       assign
      796       scnblist.bc-on-type    = buf_prod-bc.bc-on-type
      797       scnblist.bc-on         = buf_prod-bc.bc-on
      798       scnblist.pbc-cr-db-num = buf_prod-bc.cr-db-num
      799       .
      800     assign
      801       lns-cnt = lns-cnt + 1
      802       line-rec = recid (scnblist)
      803     .
      804   end.
      805                 scnblist.qnty = buf_gds-dtl.fact-qnty.
      806                 if v-new-qnty then scnblist.qnty = v-new-qnty1 .
      807               end.
      808           end.
      809            else do:
      810                    find first buf_bar-code no-lock where
      811                               buf_bar-code.gds-code  = buf_goods.gds-code  and
      812                               buf_bar-code.part-code = "" and
      813                               buf_bar-code.in-code   = "" and
      814                               buf_bar-code.unit-cli   = buf_goods.unit-base
      815                               no-error .
      816                    if error-status :error then return error "Бар-код не создан. Закройте документ!" .
      817                    run gen-bc in this-procedure (input buf_bar-code.b-code , output v-ean) no-error .
      818                    find first buf_prod-bc no-lock where
      819                               buf_prod-bc.b-code = buf_bar-code.b-code  no-error .
      820   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      821   find first scnblist
      822     where scnblist.gds-code = buf_bar-code.gds-code
      823       and scnblist.b-code   = buf_bar-code.b-code
      824       and scnblist.b-str    = v-ean
      825     no-error .
      826   if available scnblist then do:
      827     assign
      828       scnblist.to-del = no
      829     .
      830   end.
      831   else do:
      832     define variable v-last7 as integer no-undo .
      833     find last scnblist use-index oi no-error.
