      848       scnblist.in-code       = buf_bar-code.in-code
      849       scnblist.node-code     = buf_bar-code.node-code
      850       scnblist.part-code     = buf_bar-code.part-code
      851       scnblist.stts_         = buf_bar-code.stts_
      852       scnblist.bc-unit-cli   = buf_bar-code.unit-cli
      853       scnblist.b-str         = v-ean
