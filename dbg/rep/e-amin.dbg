       99   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      100         adm-object-hdl = FRAME F-Main:HANDLE.
      101   RUN ensure-broker.
      102   THIS-PROCEDURE:ADM-DATA =
      103        'ADM1.1~`':U +
      104        'SmartViewer~`':U +
      105        '~`':U +
      106        'NO ~`':U +
      107        '~`':U +
      108        '~`':U +
      109        '~`':U +
      110        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      111           + "~`":U +
      112        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      113        'Record-Source,Record-Target,TableIO-Target~`':U +
      114        '~`':U +
      115        '~`~`~`~`~`~`~`~`~`~`~`':U +
      116        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      117            THEN "^^":U
      118        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      119             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      120   PROCEDURE adm-apply-entry :
