      320   PROCEDURE check-modified :
      321   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      322   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      323   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      324   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      325     IF check-state = "check":U THEN
      326     DO:
      327       RUN get-link-handle IN adm-broker-hdl
      328         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      329            OUTPUT group-target-list).
      330       IF group-target-list NE "":U THEN
      331       DO i = 1 TO NUM-ENTRIES(group-target-list):
      332         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      333         RUN check-modified IN curr-widget ('group-check':U).
      334         IF RETURN-VALUE NE "":U THEN
      335         DO:
      336           RUN check-modified-message(RETURN-VALUE).
      337           RETURN "":U.
      338         END.
      339       END.
      340     END.
      341     RETURN "":U.
      342   END PROCEDURE.
      343   PROCEDURE check-modified-message :
      344     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      345        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      346           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      347        IF RETURN-VALUE = "YES":U THEN
      348           RUN notify ('view,CONTAINER-SOURCE':U).
      349        MESSAGE IF p-changed-table NE ? THEN
      350           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      351           ELSE "Current values have been changed."
      352           SKIP "  Do you wish to save those changes?"
      353           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      354        IF ANS THEN
      355        DO:
      356           IF group-assign-target THEN
      357             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      358           ELSE RUN dispatch('update-record':U).
      359           IF RETURN-VALUE = "ADM-ERROR":U THEN
      360           DO:
      361               MESSAGE "Changes to the previous record were not saved."
      362                 VIEW-AS ALERT-BOX ERROR.
      363               IF group-assign-target THEN
      364                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      365               ELSE RUN dispatch ('cancel-record':U).
      366           END.
      367        END.
      368        ELSE DO:
      369          IF group-assign-target THEN
      370             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      371          ELSE RUN dispatch('cancel-record':U).
      372        END.
      373        RETURN.
      374   END PROCEDURE.
      375   PROCEDURE get-rowid :
      376       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      377       ASSIGN
      378       p-table   =   adm-first-table.
      379       RETURN.
      380   END PROCEDURE.
      381   PROCEDURE init-group-assign :
      382       RUN request-attribute IN adm-broker-hdl
      383         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      384       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      385         group-assign-target = yes.
      386       ELSE group-assign-target = no.
      387       RETURN.
      388   END PROCEDURE.
      389   PROCEDURE set-editors :
      390       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      391       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      392       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      393       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      394       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      395       DO WHILE VALID-HANDLE (curr-widget):
      396           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      397              curr-widget:HIDDEN = no THEN DO:
      398             CASE p-field-setting:
      399               WHEN "INITIALIZE":U THEN
      400               DO:
      401                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      402                     read-only-list +
      403                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      404                        STRING(curr-widget).
      405               END.
      406               WHEN "DISABLE":U OR
      407               WHEN "ENABLE":U THEN
      408               DO:
      409                   curr-widget:SENSITIVE = yes.
      410                   RUN get-attribute ('Read-Only-Editors':U).
      411                   IF RETURN-VALUE = ? OR
      412                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      413                       curr-widget:READ-ONLY =
      414                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      415               END.
      416               WHEN "CLEAR":U THEN
      417                   curr-widget:SCREEN-VALUE = "":U.
      418             END CASE.
      419           END.
      420           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      421       END.
      422       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      423         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      424           + '"':U).
      425       RETURN.
      426   END PROCEDURE.
      427   PROCEDURE use-check-modified-all :
      428    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      429     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      430     RETURN.
