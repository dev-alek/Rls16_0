      165   PROCEDURE dispatch :
      166       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      167       RUN broker-dispatch IN adm-broker-hdl
      168           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      169       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      170   END PROCEDURE.
      171   PROCEDURE ensure-broker :
      172   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      173   IF RETURN-VALUE NE "ADM-Broker":U THEN
      174   DO:
      175       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      176       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      177   END.
      178   END PROCEDURE.
      179   PROCEDURE get-attribute :
      180     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      181     RUN broker-get-attribute IN adm-broker-hdl
      182         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      183     RETURN RETURN-VALUE.
      184   END PROCEDURE.
      185   PROCEDURE get-attribute-list :
      186     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      187     RUN broker-get-attribute-list IN adm-broker-hdl
      188         (INPUT THIS-PROCEDURE,
      189          INPUT ?,
      190          OUTPUT p-attr-list) NO-ERROR.
      191     RETURN.
      192   END PROCEDURE.
      193   PROCEDURE new-state :
      194     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
