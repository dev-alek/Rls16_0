      200     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      201     IF RETURN-VALUE = "ADM-ERROR":U THEN
      202         RETURN "ADM-ERROR":U.
      203     RETURN.
