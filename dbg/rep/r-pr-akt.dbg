     1253                       '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1254                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-sum-last   <> ?  then fnc-convert-dot-to-colon(  v-price-sum-last   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1255                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-list-price-sale   <> ?  then fnc-convert-dot-to-colon(  v-price-list-price-sale   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1256                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-sum-list   <> ?  then fnc-convert-dot-to-colon(  v-price-sum-list   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1257                       '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1258                       '       </tr>' skip
     1259                       .
     1260               end.
     1261               else
     1262               do:
     1263                   put stream OutStr-html unformatted
     1264                       '       <tr level="1">' skip
     1265                       '         <td style="display: yes; text-align: center ">'  + if goods.gds-code  <> ?  then fnc-convert-dot-to-colon( goods.gds-code , "->>>>>>>9") + '</td>' else "?" + '</td>' skip
     1266                       '         <td style="display: yes; text-align:  right ">'  +  price-list.artic   + '</td>'  skip
     1267                       '         <td style="display: yes; text-align:  left ">'  +        goods.gds-name + '</td>' skip
     1268                       '         <td style="display: yes; text-align:  right ">'  + if      price-list.doc-qnty  <> ?  then fnc-convert-dot-to-colon( price-list.doc-qnty , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1269                       '         <td style="display: yes; text-align:  right ">'  + if     price-list.price-sale   <> ?  then fnc-convert-dot-to-colon(  price-list.price-sale  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1270                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-sum-last   <> ?  then fnc-convert-dot-to-colon(  v-price-sum-last   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1271                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-list-price-sale   <> ?  then fnc-convert-dot-to-colon( v-price-list-price-sale   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1272                       '         <td style="display: yes; text-align:  right ">'  + if    v-price-sum-list   <> ?  then fnc-convert-dot-to-colon(  v-price-sum-list   , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1273                       '         <td style="display: yes; text-align:  right ">'  + if     p-procent   <> ?  then fnc-convert-dot-to-colon(   p-procent  , "->>>>>>>9.99") + '</td>' else "?" + '</td>' skip
     1274                       '       </tr>' skip
     1275                       .
     1276               end.
     1277           end.
     1278       end.
     1279   end procedure.
     1280   run search-full-path-Report(input v-report-name-html).
     1281   run Report-Viewer(input v-full-path-RepView, input v-report-name-html).
     1282    function fnc-DD-MM-YYYY returns character
     1283   (input p-dat-date as date):
     1284       define variable result as character no-undo.
     1285       define variable p-str-date as character no-undo.
     1286       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     1287           return p-str-date.
     1288   end function.
     1289   function fnc-convert-dot-to-colon returns character
     1290       (input p-data as decimal, input p-accur as character):
     1291       define variable result       as character no-undo.
     1292       define variable v-str-result as character no-undo.
     1293       p-data = round(p-data, 2).
     1294       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1295       return v-str-result.
     1296   end function.
     1297   procedure create-file:
     1298       define input parameter p-file-name as character no-undo.
     1299       output to value(string(p-file-name)).
     1300       output close.
     1301   end procedure.
     1302   procedure search-full-path-Report:
     1303       define input parameter p-file-name as character no-undo.
     1304       if search(p-file-name) = ? then
     1305       do:
     1306           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1307       end.
     1308       else
     1309       do:
     1310           p-file-name = search(p-file-name).
     1311       end.
     1312   end procedure.
     1313   procedure define-full-path-Report:
     1314       define input parameter p-rep-num as integer no-undo.
     1315       define output parameter p-file-name-rep-htm as character no-undo.
     1316       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     1317   end procedure.
     1318   procedure Report-Viewer:
     1319       define input parameter p-full-path-RepView as character no-undo.
     1320       define input parameter p-file-name-rep-htm as character no-undo.
     1321       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     1322   end procedure.
     1323   procedure get-full-path-RepViewer:
     1324       define output parameter p-fill-path-RepView as character no-undo.
     1325       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1326       do:
     1327           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1328       end.
     1329       else
     1330       do:
     1331           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1332       end.
     1333   end procedure.
