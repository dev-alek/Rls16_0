     1018               if v-code-is-main = yes
     1019                   then
     1020               do:
     1021                   accumulate ( ( price-list.price-sale - v-price-list-price-sale_old ) * price-list.doc-qnty ) (total)
     1022                       ( price-list.doc-qnty ) (total)
     1023                       ( price-list.doc-qnty * v-price-list-price-sale_old ) (total)
     1024                       ( price-list.doc-qnty * price-list.price-sale ) (total)
     1025                       ( price-list.doc-qnty * v-gds-obj-last-price ) (total) .
     1026                   run print-line-fact in this-procedure.
     1027               end.
