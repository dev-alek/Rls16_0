      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      572   define  stream PrnLibStream.
      573   procedure prn-lib-prn-file :
      574     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      575     define input parameter p-DIsabledoptions as integer no-undo .
      576     define variable v-report-name as character no-undo .
      577     define variable v-user-action as character no-undo .
      578     define variable v-printed     as logical   no-undo .
      579     define variable v-exist       as logical   no-undo .
      580     do
      581       on error undo, return error
      582       :
      583       run prn-lib-get-report-name  in this-procedure (
      584         input parParentProc
      585         ,output v-report-name
      586         ).
      587   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      589     (input  v-report-name
      590     ,input  2
      591     ,output v-exist
      592     )  .
      593       if NOT v-exist then
      594       DO:
      595         Message
      596           "Нет заданий на печать ! "
      597           view-as alert-box .
      598         Return  .
      599       End.
      600       run gbl/prnfilen.w
      601         (input  ""
      602         ,input  p-DisabledOptions
      603         ,input  string(v-report-name )
      604         ,input  7
      605         ,output v-user-action
      606         ,output v-printed
      607         ) .
      608       if v-printed then
      609       do:
      610         return "YES" .
      611       end.
      612       else
      613       do:
      614         return "NO" .
      615       end.
      616     end.
      617   end procedure.
      618   procedure prn-lib-open-stream :
      619     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      620     define input parameter p-page-size    as integer no-undo .
      621     define input parameter p-is-stream    as logical no-undo .
      622     define input parameter p-append       as logical no-undo .
      623     define variable v-report-name as character no-undo .
      624     do
      625       on error undo, return error
      626       :
      627       run prn-lib-get-report-name  in this-procedure (
      628         input parParentProc
      629         ,output v-report-name
      630         ).
      631       if p-is-stream then
      632       do:
      633         if p-append then
      634         do:
      635           output stream PrnLibStream to value( v-report-name )
      636             page-size value(p-page-size) append .
      637         end.
      638         if not p-append then
      639         do:
      640           output stream PrnLibStream to value( v-report-name )
      641             page-size value(p-page-size) .
      642         end.
      643       end.
      644       if not p-is-stream then
      645       do:
      646         if p-append then
      647         do:
      648           output to value( v-report-name )
      649             page-size value(p-page-size) append .
      650         end.
      651         if not p-append then
      652         do:
      653           output to value( v-report-name )
      654             page-size value(p-page-size) .
      655         end.
      656       end.
      657     end.
      658   end procedure.
      659   procedure prn-lib-open-exp :
      660     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      661     define input parameter p-is-stream    as logical no-undo .
      662     define input parameter p-is-append    as logical no-undo .
      663     define output parameter p-ReportFileName as char init "report" no-undo.
      664     define output parameter p-process as logical no-undo .
      665     define variable glog as logical no-undo .
      666     do
      667       on error undo, return error
      668       :
      669       SYSTEM-DIALOG GET-FILE p-ReportFileName
      670         TITLE      "Укажите путь"
      671         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      672         ASK-OVERWRITE
      673         CREATE-TEST-FILE
      674         SAVE-AS
      675         USE-FILENAME
      676         DEFAULT-EXTENSION "txt"
      677         UPDATE glog
      678         .
      679       if not glog then  return.
      680       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      681       if p-is-stream then
      682       do:
      683         if p-is-append then
      684         do:
      685           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      686         end.
      687         else
      688         do:
      689           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      690         end.
      691       end.
      692       else
      693       do:
      694         if p-is-append then
      695         do:
      696           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      697         end.
      698         else
      699         do:
      700           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      701         end.
      702       end.
      703       p-process = yes.
      704     end.
      705   end procedure.
      706   procedure prn-lib-get-report-name :
      707     define input parameter parParentProc  as widget-handle no-undo.
      708     define output parameter p-report-name as character no-undo .
      709     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      710   end procedure.
      711   procedure prn-lib-reportviewer-report-name :
      712     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      713     define input parameter p-report-name-html as character no-undo .
      714     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      715   end procedure.
      716   procedure prn-lib-reportviewer :
      717     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      718     define input parameter p-report-name-html as character no-undo .
      719     define input parameter p-param        as character no-undo .
      720     define variable v-excel           as character no-undo init 'TRUE' .
      721     define variable v-value-character as character no-undo .
      722     define variable v-value-integer   as character no-undo .
      723     define variable v-value-date      as date      no-undo .
      724     define variable v-value-decimal   as decimal   no-undo .
      725     define variable rep-excel         as logical   no-undo .
      726     define variable excel-string      as character no-undo .
      727     define variable v-param-type      as character no-undo .
      728     define variable v-tth             as handle    no-undo .
      729     run adm/shattri.p (
      730       input "get":U
      731       ,input  ""
      732       ,input  0
      733       ,input  'report-glob':U
      734       ,input  'rep-excel':U
      735       ,output v-value-character
      736       ,output v-value-date
      737       ,output v-value-decimal
      738       ,output v-value-integer
      739       ,output rep-excel
      740       ,output v-param-type
      741       ,INPUT-OUTPUT table-handle v-tth
      742       )  .
      743     if rep-excel then v-excel = "TRUE" .
      744     else v-excel = "FALSE" .
      745     if p-param eq ""
      746     then
      747        p-param = "EXCEL:" + v-excel.
      748     else
      749        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      750     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      751   end procedure.
      752   define temp-table tt-price
      753     field obj-code     as integer
      754     field pay-desk     as integer
      755     field cashier-code as character
      756     field cashier-fio  as character
      757     field date_        as date
      758     field time_        as character
      759     field gds-code     as integer
      760     field gds-name     as character
      761     field old-price    as decimal
      762     field price        as decimal
      763     field dif-price    as decimal
      764     field shift-date   as date
      765     field shift-num    as integer
      766     field menedger     as character
      767     field menedger-fio as character
      768     field chk-doc      as character
      769     INDEX pi IS PRIMARY UNIQUE
      770     obj-code
      771     gds-code
      772     chk-doc
      773     .
      774   define variable p-report-id          as character no-undo .
      775   define variable v-file-name-rep-html as character no-undo .
      776   define variable ii                   as integer   no-undo .
      777   define variable v-name               as character no-undo .
      778   define variable v-name-report        as character no-undo .
      779   define variable v-obj-name           as character no-undo .
      780   define stream Out-Stream.
      781   define stream OutStr-html.
      782   define buffer buf_chk-doc      for ub.chk-doc.
      783   define buffer buf_chk-gds      for ub.chk-gds.
      784   define buffer buf_bar-code     for ub.bar-code.
      785   define buffer buf_goods        for ub.goods.
      786   define buffer buf_goods-attr   for ub.goods-attr.
      787   define buffer buf_tt-price     for tt-price .
      788   define buffer buf_person       for ub.person .
      789   define buffer buf_chk-gds-attr for ub.chk-gds-attr .
      790   define buffer buf_inkas        for ub.inkas .
      791   do
      792     on error undo, return error
      793     :
      794     if x-TOG-Shift then
      795       v-name-report = "за период: c " + string(x-date-Start) + " №" + string(x-Shift-Start) + " по " + string(x-Date-End) + " №" + string(x-Shift-End) .
      796     else
      797       v-name-report = "за период: c " + string(x-date-Start) + " по " + string(x-Date-End) .
      798     for each obj-list no-lock:
      799       if v-obj-name <> "" then v-obj-name = v-obj-name + ", " + obj-list.obj-type + " " + string(obj-list.obj-code) .
      800       else v-obj-name = obj-list.obj-type + " " + string(obj-list.obj-code) .
      801       for each buf_inkas no-lock where buf_inkas.obj-code = obj-list.obj-code
      802         and buf_inkas.obj-type = obj-list.obj-type
      803         and ((buf_inkas.fact-date <= x-Date-End
      804         and buf_inkas.fact-date >= x-Date-Start) or
      805         buf_inkas.fact-date = x-Date-Alone ):
      806         if x-TOG-Shift then
      807         do:
      808           if buf_inkas.shift-date = x-Date-Start and buf_inkas.shift-num < x-Shift-Start then next .
      809           if buf_inkas.shift-date = x-date-End   and buf_inkas.shift-num > x-Shift-End then next .
      810         end.
      811         for each buf_chk-doc no-lock
      812           where buf_chk-doc.out-code = buf_inkas.inkas-code:
      813           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next .
      814           for each buf_chk-gds no-lock where buf_chk-gds.doc-code = buf_chk-doc.doc-code,
      815             first buf_bar-code no-lock where buf_bar-code.b-code = buf_chk-gds.b-code,
      816             first buf_goods no-lock where buf_bar-code.gds-code = buf_goods.gds-code,
      817             first buf_chk-gds-attr no-lock where buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      818             and buf_chk-gds-attr.line-num = buf_chk-gds.line-num
      819             and buf_chk-gds-attr.attr-code = "CSPriceOrig":
      820             find first buf_tt-price where buf_tt-price.obj-code = obj-list.obj-code and buf_tt-price.gds-code = buf_goods.gds-code and buf_tt-price.chk-doc = buf_chk-doc.doc-code no-error .
      821             if not available (buf_tt-price) then
      822             do:
      823               create buf_tt-price .
      824               assign
      825                 buf_tt-price.chk-doc    = buf_chk-doc.doc-code
      826                 buf_tt-price.date_      = buf_chk-doc.chk-date
      827                 buf_tt-price.time_      = string(truncate (buf_chk-doc.chk-time / 3600, 0)) + ":" + string((buf_chk-doc.chk-time modulo 3600) / 60,"99")
      828                 buf_tt-price.gds-code   = buf_goods.gds-code
      829                 buf_tt-price.gds-name   = buf_goods.gds-name
      830                 buf_tt-price.pay-desk   = buf_chk-doc.pay-desk
      831                 buf_tt-price.obj-code   = buf_chk-doc.obj-code
      832                 buf_tt-price.shift-date = buf_inkas.shift-date
      833                 buf_tt-price.shift-num  = buf_inkas.shift-num
      834                 buf_tt-price.price      = abs(buf_chk-gds.price-base * buf_chk-gds.doc-qnty)
      835                 buf_tt-price.old-price  = decimal(buf_chk-gds-attr.attr-value)
      836                 buf_tt-price.dif-price  = buf_tt-price.old-price - buf_tt-price.price
      837                 .
      838               for first buf_person no-lock where buf_person.psn-code = buf_chk-doc.cashier-psn-code:
      839                 run rep/get-psn.p(input buf_person.psn-code, output v-name ).
      840                 buf_tt-price.cashier-fio = v-name + '  ' + buf_person.name1 + ' ':U + buf_person.name2.
      841               end .
      842               find first ub.shift-staff no-lock where ub.shift-staff.shift-date = buf_inkas.shift-date
      843                 and ub.shift-staff.shift-num = buf_inkas.shift-num
      844                 and ub.shift-staff.obj-code = buf_chk-doc.obj-code
      845                 and ub.shift-staff.obj-type = buf_chk-doc.obj-type
      846                 and ub.shift-staff.staff-role = yes no-error .
      847               if available (ub.shift-staff) then
      848               do:
      849                 for first buf_person no-lock where buf_person.psn-code = ub.shift-staff.psn-code:
      850                   run rep/get-psn.p(input buf_person.psn-code, output v-name ).
      851                   buf_tt-price.menedger-fio = v-name + '  ' + buf_person.name1 + ' ':U + buf_person.name2.
      852                 end .
      853               end.
      854             end.
      855           end.
      856         end.
      857       end.
      858     end.
      859     run get-report-num (output p-report-id).
      860     v-file-name-rep-html = session:temp-directory + string(p-report-id) + ".html".
      861     run print-report .
      862     run prn-lib-reportviewer-report-name in this-procedure (
      863       input THIS-PROCEDURE
      864       ,input v-file-name-rep-html
      865       ).
      866   PROCEDURE print-report :
      867     output stream OutStr-html to value(v-file-name-rep-html) convert target 'UTF-8'.
      868     put stream OutStr-html unformatted
      869       "<!DOCTYPE HTML>" skip
      870       ' <html>' skip
      871       '  <head>' skip
      872       '   <meta charset="utf-8">' skip
      873       '    <style type="text/css">' skip
      874       '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      875       '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      876       '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black; height: 14px;' + chr(125) skip
      877       '   </style>' skip
      878       '  </head>' skip
      879       '<body>' skip
      880       .
      881     put stream OutStr-html unformatted
      882       '<TABLE fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0" name="Отчет">'skip
      883       .
      884     put stream OutStr-html unformatted
      885       '<thead>' skip
      886       '<tr>' skip
      887       '<td style="width: 40px;"></td>' skip
      888       '<td style="width: 40px;"></td>' skip
      889       '<td style="width: 40px;"></td>' skip
      890       '<td style="width: 120px;"></td>' skip
      891       '<td style="width: 120px;"></td>' skip
      892       '<td style="width: 120px;"></td>' skip
      893       '<td style="width: 120px;"></td>' skip
      894       '<td style="width: 120px;"></td>' skip
      895       '<td style="width: 120px;"></td>' skip
      896       '<td style="width: 120px;"></td>' skip
      897       '<td style="width: 120px;"></td>' skip
      898       '<td style="width: 120px;"></td>' skip
      899       '</tr>' skip
      900       '<tr>' skip
      901       '<td colspan="12" style="align: center;">Отчет по изменению розничных цен в соответствии с МРЦ</td>' skip
      902       '</tr>' skip
      903       '<tr>' skip
      904       '<td colspan="12" style="align: center;">' + v-name-report + '</td>' skip
      905       '</tr>' skip
      906       '<tr>' skip
      907       '<td colspan="12" style="align: center;">' + "по объектам: " + v-obj-name + '</td>' skip
      908       '</tr>' skip
      909       '</thead>' skip
      910       '<tbody>' skip
      911       .
      912     put stream OutStr-html unformatted
      913       '<tr>' skip
      914       '<th text_wrap="true" style="align: center;">№ п/п</th>' skip
      915       '<th text_wrap="true" style="align: center;">№ АЗК</th>' skip
      916       '<th text_wrap="true" style="align: center;">№ POS</th>' skip
      917       '<th text_wrap="true" style="align: center;">ФИО кассира</th>' skip
      918       '<th text_wrap="true" style="align: center;">Дата и время продаж</th>' skip
      919       '<th text_wrap="true" style="align: center;">Внутренний код товара</th>' skip
      920       '<th text_wrap="true" style="align: center;">Название товара</th>' skip
      921       '<th text_wrap="true" style="align: center;">Розничная цена в соответствии с БД</th>' skip
      922       '<th text_wrap="true" style="align: center;">МРЦ</th>' skip
      923       '<th text_wrap="true" style="align: center;">Разница между розничной ценой и МРЦ</th>' skip
      924       '<th text_wrap="true" style="align: center;">Дата и номер смены</th>' skip
      925       '<th text_wrap="true" style="align: center;">ФИО старшего смены</th>' skip
      926       '</tr>' skip
      927       .
      928     ii = 0 .
      929     for each buf_tt-price:
      930       ii = ii + 1 .
      931       put stream OutStr-html unformatted
      932         '<tr>' skip
      933         '<td style="align: center;">' + string(ii) + '</td>' skip
      934         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.obj-code) + '</td>' skip
      935         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.pay-desk) + '</td>' skip
      936         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.cashier-fio) + '</td>' skip
      937         '<td text_wrap="true" style="align: center;">' + string(string(buf_tt-price.date_) + " " + buf_tt-price.time_) + '</td>' skip
      938         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.gds-code) + '</td>' skip
      939         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.gds-name) + '</td>' skip
      940         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.old-price) + '</td>' skip
      941         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.price) + '</td>' skip
      942         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.dif-price) + '</td>' skip
      943         '<td text_wrap="true" style="align: center;">' + string(string(buf_tt-price.shift-date) + " №" + string(buf_tt-price.shift-num)) + '</td>' skip
      944         '<td text_wrap="true" style="align: center;">' + string(buf_tt-price.menedger-fio) + '</td>' skip
      945         '</tr>' skip
      946         .
      947     end.
      948     put stream OutStr-html unformatted
      949       '</tbody>' skip
      950       '</table>' skip
      951       .
      952     put stream OutStr-html unformatted
      953       '</body>' skip
      954       '</html>' skip
      955       .
      956     output stream OutStr-html close.
      957   END PROCEDURE.
      958   PROCEDURE get-report-num :
      959     define output parameter p-report-num as integer no-undo .
      960     do
      961       on error undo, return error return-value
      962       :
      963       run gbl/getrpnum.p (output p-report-num).
      964     end.
      965   END PROCEDURE.
      966   end.
