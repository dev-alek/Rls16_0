      221   FIND trn-doc WHERE recid( trn-doc ) = rec_id  NO-LOCK.
      222   FIND clients WHERE clients.obj-type = trn-doc.cli-type AND
      223                                      clients.obj-code = trn-doc.cli-code NO-LOCK.
      224   FIND Our_Host WHERE Our_Host.obj-type = 'орг':U AND
      225                                          Our_Host.obj-code = trn-doc.host-code NO-LOCK.
      226   Line = fill("-", 140) .
      227   assign
      228       Lines_Counter = 1
      229       tdoc-code = trn-doc.doc-code
      230       tdoc-date = trn-doc.doc-date .
      231   output STREAM Out_Stream to value( string( session:temp-directory +
      232                                        "rpt" + string( g#report-num ) ) )
      233                                        page-size 62 .
      234   if NOT trn-doc.print-rubl then
      235       if NoProd then
      236           FORM with FRAME val-no-prod .
      237       else
      238           FORM with FRAME val .
      239   else
      240       if NoProd then
      241           FORM with FRAME rubl-no-prod .
      242       else
      243           FORM with FRAME rubl .
      244   FORM HEADER
      245       Line format "X(136)" AT 1 SKIP
      246       "Продолжение - на следующей странице" AT 30 SKIP
      247       with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
      248   VIEW STREAM Out_Stream FRAME BottomFrame .
      249   PUT STREAM Out_Stream space(20)
      250           "П Р О Т О К О Л   СОГЛАСОВАНИЯ  СВОБОДНЫХ  ОТПУСКНЫХ  ЦЕН"
      251               format "X(100)" SKIP(1)
      252           SPACE(20) string( "между " + CAPS( Our_Host.obj-name ) + " и " + CAPS( clients.obj-name ) )
      253               format "X(100)" SKIP(1)
      254           SPACE(40) string( "НАКЛАДНАЯ  N " + tdoc-code ) format "X(60)" SKIP(1) .
      255   FOR  EACH doc-line where doc-line.doc-code = trn-doc.doc-code NO-LOCK
      256                               BREAK BY doc-line.artic :
      257       FIND goods WHERE goods.prod-type = doc-line.prod-type AND
      258                                         goods.prod-code = doc-line.prod-code AND
      259                                         goods.artic = doc-line.artic NO-LOCK .
      260       FIND cli-prod WHERE cli-prod.obj-type = doc-line.prod-type AND
      261                                           cli-prod.obj-code = doc-line.prod-code NO-LOCK .
      262       FIND FIRST units WHERE units.unit-name = goods.unit-base NO-LOCK no-error.
      263       FIND gds-prt where gds-prt.upper-code = doc-line.prt-root NO-LOCK .
      264       rootnode_code = gds-prt.node-code.
      265       if can-find(first gds-prt where gds-prt.upper-code = rootnode_code)
      266       then do:
      267               if NOT trn-doc.print-rubl
      268               then do:
      269                   if NoProd
      270                   then do:
      271   define variable vss-include-info5 as character format "X(65)" no-undo
      272   initial "@(#)$Workfile$ $Revision$".
      273   do:
      274       DISPLAY STREAM Out_Stream
      275                                       sym1 sym2
      276                                       goods.artic
      277                                       goods.gds-name
      278                                       sym9 sym7 sym8 with FRAME val-no-prod .
      279       DOWN STREAM Out_Stream 1 with FRAME val-no-prod .
      280   end.
      281                   end.
      282                   else do:
      283   define variable vss-include-info6 as character format "X(65)" no-undo
      284   initial "@(#)$Workfile$ $Revision$".
