      322               run rep/tl_tree.p ( INPUT doc-line.prt-root, INPUT rootnode_code, INPUT 1,
      323                                       INPUT gds-prt.node-name, INPUT goods.gds-name,
      324                                       INPUT goods.artic, OUTPUT LastLevelSign).
      325               if session:set-wait-state("compiler") then.
      326               FOR EACH gds-dtl WHERE
      327                               gds-dtl.prod-type = doc-line.prod-type AND
      328                               gds-dtl.prod-code = doc-line.prod-code AND
      329                               gds-dtl.artic = doc-line.artic AND
      330                               gds-dtl.doc-code = doc-line.doc-code NO-LOCK :
      331                   FIND gds-prt WHERE gds-prt.node-code = gds-dtl.prt-code NO-LOCK.
      332                   FIND FIRST tl-tree WHERE tl-tree.node-code = gds-prt.node-code NO-ERROR.
      333                   DO WHILE not available tl-tree :
      334                       Node_Code = gds-prt.upper-code.
      335                       FIND gds-prt WHERE gds-prt.node-code = Node_Code NO-LOCK.
      336                       FIND FIRST tl-tree WHERE tl-tree.node-code = Node_Code NO-ERROR.
      337                   END.
      338                   FIND bar-code WHERE bar-code.gds-code = goods.gds-code AND
      339                                                         bar-code.unit-cli = goods.unit-base AND
      340                                                         bar-code.node-code = tl-tree.node-code AND
      341                                                         bar-code.part-code = "" AND
      342                                                         bar-code.in-code = "" NO-LOCK NO-ERROR.
      343                   assign
      344                       tl-tree.gds-amount =  gds-dtl.fact-qnty
      345                       tl-tree.b-code = ( if not available bar-code
      346                                                  then "?" else trim ( string ( bar-code.b-code) ))
      347                       tl-tree.price-base = gds-dtl.price-base
      348                       tl-tree.price-rubl = gds-dtl.price-rubl
      349                   .
      350               END.
      351               FOR EACH tl-tree WHERE tl-tree.level-number = 1
      352                   BREAK BY tl-tree.gds-artic BY tl-tree.prt-num  :
      353                   if can-find( first Help-buffer where
      354                                                   Help-buffer.level-number = 2 and
      355                                                   Help-buffer.gds-amount <> 0 and
      356                                                   Help-buffer.uppernode-name = tl-tree.node-name) then
      357                       do:
      358                           FOR EACH Help-buffer WHERE
      359                                                     Help-buffer.uppernode-name = tl-tree.node-name AND
      360                                                     Help-buffer.gds-amount <> 0 :
      361                               if NOT trn-doc.print-rubl then
      362                                   if NoProd then
      363                                       DISPLAY STREAM Out_Stream
      364                                           sym1 Lines_Counter
      365                                           sym2 Help-buffer.b-code @ tb-code
      366                                           ( "  \" + string(tl-tree.node-name, "x(10)") + "\" +
      367                                                       string(Help-buffer.node-name, "x(10)")) @ goods.gds-name
      368                                           sym9 units.long-name
      369                                           sym7 ( if Discnt_Type = 1
      370                                                       then ( if v-rb-is-base = yes
      371                                                              then Help-buffer.price-base - Help-buffer.discnt-base
      372                                                              else Help-buffer.price-rubl - Help-buffer.discnt-rubl )
      373                                                       else ( if v-rb-is-base = yes
      374                                                              then Help-buffer.price-base
      375                                                              else Help-buffer.price-rubl )
      376                                                )
      377                                                           @ v-price-rb
      378                                           sym8 with FRAME val-no-prod .
      379                                   else
      380                                       DISPLAY STREAM Out_Stream
      381                                           sym1 Lines_Counter
      382                                           sym2 Help-buffer.b-code @ tb-code
      383                                           ( "  \" + string(tl-tree.node-name, "x(10)") + "\" +
      384                                                         string(Help-buffer.node-name, "x(10)")) @ goods.gds-name
      385                                           cli-prod.obj-name
      386                                           sym9 units.long-name
      387                                           sym7 ( if Discnt_Type = 1
      388                                                       then ( if v-rb-is-base = yes
      389                                                              then Help-buffer.price-base - Help-buffer.discnt-base
      390                                                              else Help-buffer.price-rubl - Help-buffer.discnt-rubl )
      391                                                       else ( if v-rb-is-base = yes
      392                                                              then Help-buffer.price-base
      393                                                              else Help-buffer.price-rubl )
      394                                                )
      395                                                           @ v-price-rb
      396                                           sym8 with FRAME val .
      397                               else
      398                                   if NoProd then
      399                                       DISPLAY STREAM Out_Stream
      400                                           sym1 Lines_Counter
      401                                           sym2 Help-buffer.b-code @ tb-code
      402                                           ( "  \" + string(tl-tree.node-name, "x(10)") + "\" +
      403                                                         string(Help-buffer.node-name, "x(10)")) @ goods.gds-name
      404                                           sym9 units.long-name
      405                                           sym7 ( if Discnt_Type = 1
      406                                                       then Help-buffer.price-rubl - Help-buffer.discnt-rubl
      407                                                       else Help-buffer.price-rubl) @ gds-dtl.price-rubl
      408                                           sym8 with FRAME rubl-no-prod .
      409                                   else
      410                                       DISPLAY STREAM Out_Stream
      411                                           sym1 Lines_Counter
      412                                           sym2 Help-buffer.b-code @ tb-code
      413                                           ( "  \" + string(tl-tree.node-name, "x(10)") + "\" +
      414                                                         string(Help-buffer.node-name, "x(10)")) @ goods.gds-name
      415                                           cli-prod.obj-name
      416                                           sym9 units.long-name
      417                                           sym7 ( if Discnt_Type = 1
      418                                                       then Help-buffer.price-rubl - Help-buffer.discnt-rubl
      419                                                       else Help-buffer.price-rubl) @ gds-dtl.price-rubl
      420                                           sym8 with FRAME rubl .
      421                               Lines_Counter = Lines_Counter + 1.
      422                           END.
      423                       end.
      424                   else
      425                       do:
      426                           if tl-tree.gds-amount <> 0 then
      427                               do:
      428                                   if NOT trn-doc.print-rubl then
      429                                       if NoProd then
      430                                           DISPLAY STREAM Out_Stream
      431                                                       sym1 Lines_Counter
      432                                                       sym2 tl-tree.b-code @ tb-code
      433                                                       ( "  \" + string(tl-tree.node-name, "x(10)") )
      434                                                                               @ goods.gds-name
      435                                                       sym9 units.long-name
      436                                                       sym7 ( if Discnt_Type = 1
      437                                                            then ( if v-rb-is-base = yes
      438                                                                   then tl-tree.price-base - tl-tree.discnt-base
      439                                                                   else tl-tree.price-rubl - tl-tree.discnt-rubl )
      440                                                            else ( if v-rb-is-base = yes
      441                                                                   then tl-tree.price-base
      442                                                                   else tl-tree.price-rubl )
      443                                                             ) @ v-price-rb
      444                                                       sym8 with FRAME val-no-prod .
      445                                       else
      446                                           DISPLAY STREAM Out_Stream
      447                                                       sym1 Lines_Counter
      448                                                       sym2 tl-tree.b-code @ tb-code
      449                                                       ( "  \" + string(tl-tree.node-name, "x(10)") )
      450                                                                               @ goods.gds-name
      451                                                       cli-prod.obj-name
      452                                                       sym9 units.long-name
      453                                                       sym7 ( if Discnt_Type = 1
      454                                                            then ( if v-rb-is-base = yes
      455                                                                   then tl-tree.price-base - tl-tree.discnt-base
      456                                                                   else tl-tree.price-rubl - tl-tree.discnt-rubl )
      457                                                            else ( if v-rb-is-base = yes
      458                                                                   then tl-tree.price-base
      459                                                                   else tl-tree.price-rubl )
      460                                                             ) @ v-price-rb
      461                                                       sym8 with FRAME val .
      462                                   else
      463                                       if NoProd then
      464                                           DISPLAY STREAM Out_Stream
      465                                                           sym1 Lines_Counter
      466                                                           sym2 tl-tree.b-code @ tb-code
      467                                                           ( "  \" + string(tl-tree.node-name, "x(10)") )
      468                                                                               @ goods.gds-name
      469                                                           sym9 units.long-name
      470                                                           sym7 ( if Discnt_Type = 1
      471                                                                       then tl-tree.price-rubl - tl-tree.discnt-rubl
      472                                                                       else tl-tree.price-rubl ) @ gds-dtl.price-rubl
      473                                                           sym8 with FRAME rubl-no-prod .
      474                                       else
      475                                           DISPLAY STREAM Out_Stream
      476                                                           sym1 Lines_Counter
      477                                                           sym2 tl-tree.b-code @ tb-code
      478                                                           ( "  \" + string(tl-tree.node-name, "x(10)") )
      479                                                                               @ goods.gds-name
      480                                                           cli-prod.obj-name
      481                                                           sym9 units.long-name
      482                                                           sym7 ( if Discnt_Type = 1
      483                                                                       then tl-tree.price-rubl - tl-tree.discnt-rubl
      484                                                                       else tl-tree.price-rubl ) @ gds-dtl.price-rubl
      485                                                           sym8 with FRAME rubl .
      486                                   Lines_Counter = Lines_Counter + 1.
      487                                   if NOT LAST( tl-tree.prt-num ) then
      488                                       do:
      489                                           if NOT trn-doc.print-rubl then
      490                                               if NoProd then
      491                                                   DOWN STREAM Out_Stream 1 with FRAME val-no-prod .
      492                                               else
      493                                                   DOWN STREAM Out_Stream 1 with FRAME val .
      494                                           else
      495                                               if NoProd then
      496                                                   DOWN STREAM Out_Stream 1 with FRAME rubl-no-prod .
      497                                               else
      498                                                   DOWN STREAM Out_Stream 1 with FRAME rubl .
      499                                       end.
      500                               end.
      501                       end.
      502               END.
      503               FOR EACH tl-tree:
      504                   delete  tl-tree.
      505               END.
      506           end.
      507       else
      508           do:
      509               FIND gds-dtl where gds-dtl.doc-code = doc-line.doc-code
      510                                               and gds-dtl.prod-type = doc-line.prod-type
      511                                               and gds-dtl.prod-code = doc-line.prod-code
      512                                               and gds-dtl.artic = doc-line.artic
      513                                               and gds-dtl.prt-code = rootnode_code NO-LOCK .
      514               FIND bar-code WHERE bar-code.gds-code = goods.gds-code AND
      515                                                     bar-code.unit-cli = goods.unit-base AND
      516                                                     bar-code.node-code = rootnode_code AND
      517                                                     bar-code.part-code = "" AND
      518                                                     bar-code.in-code = "" NO-LOCK NO-ERROR.
      519               if NOT trn-doc.print-rubl then
      520                   if NoProd then
      521                       do:
      522                           DISPLAY STREAM Out_Stream
      523                               sym1 Lines_Counter
      524                               sym2 trim ( string ( bar-code.b-code )) @ tb-code
      525                               goods.artic
      526                               goods.gds-name
      527                               sym9 units.long-name
      528                               sym7 ( if Discnt_Type = 1
      529                                    then ( if v-rb-is-base = yes
      530                                           then gds-dtl.price-base - gds-dtl.discnt-base
      531                                           else gds-dtl.price-rubl - gds-dtl.discnt-rubl )
      532                                    else ( if v-rb-is-base = yes
      533                                           then gds-dtl.price-base
      534                                           else gds-dtl.price-rubl )
      535                                    ) @ v-price-rb
      536                               sym8 with FRAME val-no-prod .
      537                           DOWN STREAM Out_Stream 1 with FRAME val-no-prod .
      538                       end.
      539                   else
      540                       do:
      541                           DISPLAY STREAM Out_Stream
      542                               sym1 Lines_Counter
      543                               sym2 trim ( string ( bar-code.b-code )) @ tb-code
      544                               goods.artic
      545                               goods.gds-name
      546                               cli-prod.obj-name
      547                               sym9 units.long-name
      548                               sym7 ( if Discnt_Type = 1
      549                                    then ( if v-rb-is-base = yes
      550                                           then gds-dtl.price-base - gds-dtl.discnt-base
      551                                           else gds-dtl.price-rubl - gds-dtl.discnt-rubl )
      552                                    else ( if v-rb-is-base = yes
      553                                           then gds-dtl.price-base
      554                                           else gds-dtl.price-rubl )
      555                                    ) @ v-price-rb
      556                               sym8 with FRAME val .
      557                           DOWN STREAM Out_Stream 1 with FRAME val .
      558                       end.
      559               else
      560                   if NoProd then
      561                       do:
      562                           DISPLAY STREAM Out_Stream
      563                               sym1 Lines_Counter
      564                               sym2 trim ( string ( bar-code.b-code )) @ tb-code
      565                               goods.artic
      566                               goods.gds-name
      567                               sym9 units.long-name
      568                               sym7 ( if Discnt_Type = 1
      569                                           then gds-dtl.price-rubl - gds-dtl.discnt-rubl
      570                                           else gds-dtl.price-rubl ) @ gds-dtl.price-rubl
      571                               sym8 with FRAME rubl-no-prod .
      572                           DOWN STREAM Out_Stream 1 with FRAME rubl-no-prod .
      573                       end.
      574                   else
      575                       do:
      576                           DISPLAY STREAM Out_Stream
      577                               sym1 Lines_Counter
      578                               sym2 trim ( string ( bar-code.b-code )) @ tb-code
      579                               goods.artic
      580                               goods.gds-name
      581                               cli-prod.obj-name
      582                               sym9 units.long-name
      583                               sym7 ( if Discnt_Type = 1
      584                                           then gds-dtl.price-rubl - gds-dtl.discnt-rubl
      585                                           else gds-dtl.price-rubl ) @ gds-dtl.price-rubl
      586                               sym8 with FRAME rubl .
      587                           DOWN STREAM Out_Stream 1 with FRAME rubl .
      588                       end.
      589               Lines_Counter = Lines_Counter + 1.
      590           end.
      591   END.
      592   if line-counter( Out_Stream ) + 13 > page-size( Out_Stream ) then
      593       page STREAM Out_Stream .
      594   PUT STREAM Out_Stream  Line format "X(136)" SKIP(1) SPACE(5) "Всего "
      595           ( Lines_Counter - 1 ) format ">,>>>,>>9" SPACE(2)
      596           "наименований" format "x(13)" SKIP(1) .
      597   define variable v-user-name as character no-undo .
      598   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      599   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrfulnm in g#library
      600     (input  v-cntxt-userid
      601     ,output v-user-name
      602     )  .
      603   put stream out_stream skip(1) space(10) "Подписи сторон" format "x(100)" skip(1)
      604           space(10) "Генеральный директор : " format "x(70)" skip(1)
      605           space(10) "Планово-экономический отдел : " format "x(70)" skip(1)
      606           space(10) "Управляющий  магазином : " format "x(70)" skip(3)
      607           space(20) string( "Исполнитель : " + v-user-name ) format "x(70)" skip .
      608   hide stream out_stream frame bottomframe .
      609   output stream out_stream close.
      610   if g#quest-print = false
      611   then do:
      612     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      613                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      614                                         OUTPUT g#log ).
      615   end.
      616   else do:
      617     os-command silent
      618       value( "COPY /b " +
      619         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      620         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      621         string( session:temp-directory) +  "$" + string( g#report-num )
      622                 ) .
      623     os-command silent
      624       value( "COPY /b " +
      625         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      626         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      627         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      628                 ) .
      629   end.
