      290                                       sym9 sym7 sym8 with FRAME val .
      291       DOWN STREAM Out_Stream 1 with FRAME val .
      292   end.
      293                   end.
      294               end.
      295               else do:
      296                   if NoProd
      297                   then do:
      298   define variable vss-include-info7 as character format "X(65)" no-undo
      299   initial "@(#)$Workfile$ $Revision$".
      300   do:
      301       DISPLAY STREAM Out_Stream
      302                                       sym1 sym2
      303                                       goods.artic
      304                                       goods.gds-name
      305                                       sym9 sym7 sym8 with FRAME rubl-no-prod .
      306       DOWN STREAM Out_Stream 1 with FRAME rubl-no-prod .
