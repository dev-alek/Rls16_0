      987   define variable v-waitfram-action01         as character   no-undo .
      988   define variable v-waitfram-action02         as character   no-undo .
      989   define variable v-waitfram-action03         as character   no-undo .
      990   define variable mWaitFramTextBeg            as character   no-undo.
      991   define variable mWaitFramTextEnd            as character   no-undo.
      992   define variable mWaitFramView               as logical     no-undo.
      993   define variable mWaitProcEvent              as logical     no-undo init yes.
      994   define variable mWaitFramInterval           as integer     no-undo init 1 .
      995   define variable mWaitFramStop               as logical     no-undo.
      996   define variable mWaitFramStopUser           as logical     no-undo.
      997   define variable mWaitFramStopTimeOut        as logical     no-undo.
      998   define variable mWaitFramStartProc          as datetime-tz no-undo.
      999   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1000   define button B-WaitFramStop auto-end-key
     1001        label "Стоп"
     1002        size 10 by 1 tooltip "Остоновить процесс".
     1003   define button B-viewProcInfo
     1004        label "Информация"
     1005        size 15 by 1 tooltip "Информация о процесс".
     1006   define frame waitfram
     1007     v-waitfram-action01 format "x(72)" no-label skip
     1008     v-waitfram-action02 format "x(72)" no-label skip
     1009     v-waitfram-action03 format "x(72)" no-label skip
     1010     B-viewProcInfo
     1011     B-WaitFramStop at row 4 col 30
     1012     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1013     .
     1014   define new global shared variable mBatchMode as logical no-undo init ?.
     1015   define variable mFramBachModHandle as handle no-undo.
     1016   mFramBachModHandle = frame waitfram:handle.
     1017   define variable mFameOldVis as logical no-undo.
     1018   define variable mVisCUrentVin as logical no-undo.
     1019   if session:batch-mode
     1020   then
     1021      mBatchMode = yes.
     1022   if mBatchMode = ? then do:
     1023     mVisCUrentVin = current-window:visible.
     1024     mFameOldVis = mFramBachModHandle:visible.
     1025     mFramBachModHandle:visible  = yes.
     1026     mBatchMode = mFramBachModHandle:visible ne yes.
     1027     mFramBachModHandle:visible = mFameOldVis.
     1028     current-window:visible = mVisCUrentVin.
     1029   end.
     1030    if  log-manager:logfile-name ne ?
     1031     then DO:
     1032         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1033         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1034         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1035     end.
     1036   on choose of B-WaitFramStop in frame waitfram
     1037   do:
     1038     mWaitFramStop = yes.
     1039     mWaitFramStopUser = yes.
     1040   end.
     1041   function waitfram-check-timeout returns logical():
     1042      define variable vtime as int64 no-undo.
     1043      if mWaitFramStopTimeOut
     1044      then
     1045         return yes.
     1046      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1047      if     mWaitFramTimeOut ne ?
     1048         and mWaitFramTimeOut ne 0
     1049         and mWaitFramTimeOut lt vtime
     1050      then do:
     1051         mWaitFramStopTimeOut = yes.
     1052      end.
     1053      return mWaitFramStopTimeOut.
     1054   end.
     1055   procedure waitfram-hide :
     1056     if not session:batch-mode
     1057     then do
     1058     on error undo, return error return-value
     1059     :
     1060       pause 0 before-hide .
     1061       if not mBatchMode then
     1062         hide frame waitfram .
     1063     if     not mWaitFramView
     1064        and mWaitProcEvent
     1065     then
     1066       process events .
     1067     end.
     1068   end procedure.
     1069   procedure waitfram-show :
     1070     define input  parameter p-message as character no-undo .
     1071     define variable v-left-margin as integer   no-undo .
     1072     if not session:batch-mode
     1073     then do
     1074     on error undo, return error return-value
     1075     :
     1076       if length(p-message) <= 70 then do:
     1077         assign
     1078           v-left-margin = integer((70 - length(p-message)) / 2)
     1079         .
     1080         assign
     1081           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1082         .
     1083         assign
     1084           v-waitfram-action01 = " "
     1085           v-waitfram-action02 = " "
     1086                                    + fill(" ", v-left-margin)
     1087                                    + p-message
     1088           v-waitfram-action03 = " "
     1089         .
     1090       end.
     1091       else do:
     1092         define variable vRindex1 as integer no-undo.
     1093         define variable vRindex2 as integer no-undo.
     1094         vRindex1 = r-index(p-message," ",70).
     1095         if vRindex1 = 0
     1096         then
     1097            vRindex1 = 70.
     1098         if length(p-message)  <= vRindex1 + 70 then do:
     1099           assign
     1100             v-waitfram-action01 = " "
     1101             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1102             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1103           .
     1104         end.
     1105         else do:
     1106           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1107           if vRindex2 <= vRindex1
     1108           then
     1109              vRindex2 = vRindex1 + 70.
     1110           assign
     1111             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1112             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1113             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1114           .
     1115         end.
     1116       end.
     1117       B-viewProcInfo:visible   in frame waitfram = no.
     1118       B-viewProcInfo:sensitive in frame waitfram = no.
     1119       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1120       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1121       if  (   mWaitFramView
     1122          or  mWaitProcEvent)
     1123          and not mBatchMode
     1124       then
     1125          display
     1126             v-waitfram-action01 skip
     1127             v-waitfram-action02 skip
     1128             v-waitfram-action03 skip
     1129          with frame waitfram .
     1130       if     mWaitFramView
     1131          then do:
     1132             if     mWaitFramInterval ne ?
     1133                and not mBatchMode
     1134             then
     1135                wait-for go of frame waitfram pause mWaitFramInterval.
     1136          end.
     1137          else
     1138             if     mWaitProcEvent
     1139                and not mBatchMode
     1140             then
     1141                process events .
     1142     end.
     1143   end procedure.
     1144      procedure waitfram-show-this:
     1145         define input  parameter iInterval as int64 no-undo.
     1146         define variable vtime as int64 no-undo.
     1147         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1148         mWaitFramInterval = iInterval.
     1149         run waitfram-show (substitute("&1&2 &3&4" ,
     1150                                       mWaitFramTextBeg ,
     1151                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1152                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1153                                       mWaitFramTextEnd
     1154                                      )
     1155                           ).
     1156      end.
     1157      procedure WaitFramRunPause:
     1158         define input  parameter iInterval as dec no-undo.
     1159         define variable vStart  as datetime-tz no-undo.
     1160         define variable vend    as datetime-tz no-undo.
     1161         define variable vint as int64 no-undo.
     1162         define variable vOk as logical no-undo.
     1163         vStart = now.
     1164         vend   = vStart.
     1165         publish "WaitFramPause" (iInterval,output vOk).
     1166         vend   =  now.
     1167         vint = vend - vStart.
     1168         vint = iInterval - vint / 1000.
     1169         if     not mWaitFramStop
     1170            and (   vint > 0
     1171                 or (    not vOk
     1172                     and iInterval eq ?
     1173                     )
     1174                 )
     1175         then
     1176            run waitfram-show-this (iInterval).
     1177         vend   =  now.
     1178         vint = vend - vStart.
     1179         vint = iInterval - vint / 1000.
     1180         if     not mWaitFramStop
     1181            and vint > 0
     1182         then do:
     1183            run gbl/pause.p (vint * 1000).
     1184         end.
     1185         if iInterval ne ?
     1186         then
     1187            publish "WaitFramStop".
     1188         waitfram-check-timeout().
     1189      end.
     1190      procedure WaitFramWaitFor:
     1191         define input  parameter iInterval as dec no-undo.
     1192         assign
     1193            mWaitFramStartProc   = now
     1194            mWaitFramStopUser    = no
     1195            mWaitFramStopTimeOut = no
     1196         .
     1197         block-wait:
     1198         do while not mWaitFramStop:
     1199            run WaitFramRunPause (iInterval).
     1200            if  waitfram-check-timeout()
     1201            then do:
     1202               leave block-wait.
     1203            end.
     1204         end.
     1205         run waitfram-hide.
     1206      end.
     1207   procedure waitfram-join :
     1208     define input  parameter p-line-1  as character no-undo .
     1209     define input  parameter p-line-2  as character no-undo .
     1210     define input  parameter p-line-3  as character no-undo .
     1211     define output parameter p-message as character no-undo .
     1212     do
     1213     on error undo, return error return-value
     1214     :
     1215       assign
     1216         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1217                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1218                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1219       .
     1220     end.
     1221   end procedure.
     1222   function waitfram-join-function returns character
     1223     (input p-line-1 as character
     1224     ,input p-line-2 as character
     1225     ,input p-line-3 as character
     1226     ).
     1227     define variable v-message as character no-undo .
     1228     run waitfram-join in this-procedure
     1229       (input  p-line-1
     1230       ,input  p-line-2
     1231       ,input  p-line-3
     1232       ,output v-message
     1233       ) .
     1234     return v-message .
     1235   end function .
     1236   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1237   procedure sys-time_get-sys :
     1238     define output parameter p-year         as integer   no-undo .
     1239     define output parameter p-month        as integer   no-undo .
     1240     define output parameter p-day          as integer   no-undo .
     1241     define output parameter p-hour         as integer   no-undo .
     1242     define output parameter p-minute       as integer   no-undo .
     1243     define output parameter p-second       as integer   no-undo .
     1244     define output parameter p-milliseconds as integer   no-undo .
     1245     define variable v-system-time-structure as memptr    no-undo.
     1246     do
     1247     on error undo, return error return-value
     1248     :
     1249       assign
     1250         set-size(v-system-time-structure) = 16
     1251       .
     1252       run GetSystemTime
     1253         (input  get-pointer-value(v-system-time-structure)
     1254         ) .
     1255       assign
     1256         p-year         = get-short(v-system-time-structure,  1)
     1257         p-month        = get-short(v-system-time-structure,  3)
     1258         p-day          = get-short(v-system-time-structure,  7)
     1259         p-hour         = get-short(v-system-time-structure,  9)
     1260         p-minute       = get-short(v-system-time-structure, 11)
     1261         p-second       = get-short(v-system-time-structure, 13)
     1262         p-milliseconds = get-short(v-system-time-structure, 15)
     1263       .
     1264       assign
     1265         set-size(v-system-time-structure) = 0
     1266       .
     1267     end.
     1268   end procedure.
     1269   procedure sys-time_get-comp-user-name :
     1270     define output parameter p-computer-name as character no-undo .
     1271     define output parameter p-user-name     as character no-undo .
     1272     define output parameter p-process-pid   as integer   no-undo .
     1273     define variable v-return-value  as integer   no-undo .
     1274     define variable v-buffer-length as integer   no-undo .
     1275     define variable v-buffer-memptr as memptr    no-undo .
     1276     do
     1277     on error undo, return error return-value
     1278     :
     1279       assign
     1280         v-buffer-length = 1024
     1281         set-size(v-buffer-memptr) = v-buffer-length + 4
     1282       .
     1283       assign
     1284         put-long(v-buffer-memptr, 1) = v-buffer-length
     1285       .
     1286       run GetComputerNameA
     1287         (input  get-pointer-value(v-buffer-memptr) + 4
     1288         ,input  get-pointer-value(v-buffer-memptr)
     1289         ,output v-return-value
     1290         ) .
     1291       if v-return-value <> 0
     1292       then do:
     1293         assign
     1294           p-computer-name = get-string(v-buffer-memptr, 5)
     1295         .
     1296       end.
     1297       assign
     1298         put-long(v-buffer-memptr, 1) = v-buffer-length
     1299       .
     1300       run GetUserNameA
     1301         (input  get-pointer-value(v-buffer-memptr) + 4
     1302         ,input  get-pointer-value(v-buffer-memptr)
     1303         ,output v-return-value
     1304         ) .
     1305       if v-return-value <> 0
     1306       then do:
     1307         assign
     1308           p-user-name = get-string(v-buffer-memptr, 5)
     1309         .
     1310       end.
     1311       run GetCurrentProcessId
     1312         (output p-process-pid
     1313         ) .
     1314       assign
     1315         set-size(v-buffer-memptr) = 0
     1316       .
     1317     end.
     1318   end procedure.
     1319   procedure sys-time_get-http :
     1320     define output parameter p-http-time as character no-undo .
     1321     define variable v-year         as integer   no-undo .
     1322     define variable v-month        as integer   no-undo .
     1323     define variable v-day-of-week  as integer   no-undo .
     1324     define variable v-day          as integer   no-undo .
     1325     define variable v-hour         as integer   no-undo .
     1326     define variable v-minute       as integer   no-undo .
     1327     define variable v-second       as integer   no-undo .
     1328     define variable v-milliseconds as integer   no-undo .
     1329     do
     1330     on error undo, return error return-value
     1331     :
     1332       run sys-time_get-sys in this-procedure
     1333         (output v-year
     1334         ,output v-month
     1335         ,output v-day
     1336         ,output v-hour
     1337         ,output v-minute
     1338         ,output v-second
     1339         ,output v-milliseconds
     1340         ) .
     1341       assign
     1342         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1343         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1344                     + ', ':u
     1345                     + string(v-day, '99':u)
     1346                     + ' ':u
     1347                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1348                     + ' ':u
     1349                     + string(v-year, '9999':u)
     1350                     + ' ':u
     1351                     + string(v-hour, '99':u)
     1352                     + ':':u
     1353                     + string(v-minute, '99':u)
     1354                     + ':':u
     1355                     + string(v-second, '99':u)
     1356                     + ' ':u
     1357                     + 'GMT':u
     1358       .
     1359     end.
     1360   end procedure.
     1361   procedure sys-time_set-sys :
     1362     define input  parameter p-year         as integer   no-undo .
     1363     define input  parameter p-month        as integer   no-undo .
     1364     define input  parameter p-day          as integer   no-undo .
     1365     define input  parameter p-hour         as integer   no-undo .
     1366     define input  parameter p-minute       as integer   no-undo .
     1367     define input  parameter p-second       as integer   no-undo .
     1368     define input  parameter p-milliseconds as integer   no-undo .
     1369     define variable v-system-time-structure as memptr    no-undo.
     1370     define variable v-return-value as integer   no-undo .
     1371     define variable v-day-of-week  as integer   no-undo .
     1372     do
     1373     on error undo, return error return-value
     1374     :
     1375       assign
     1376         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1377       .
     1378       assign
     1379         set-size(v-system-time-structure) = 16
     1380       .
     1381       assign
     1382         put-short(v-system-time-structure,  1) = p-year
     1383         put-short(v-system-time-structure,  3) = p-month
     1384         put-short(v-system-time-structure,  5) = v-day-of-week
     1385         put-short(v-system-time-structure,  7) = p-day
     1386         put-short(v-system-time-structure,  9) = p-hour
     1387         put-short(v-system-time-structure, 11) = p-minute
     1388         put-short(v-system-time-structure, 13) = p-second
     1389         put-short(v-system-time-structure, 15) = p-milliseconds
     1390       .
     1391       run SetSystemTime
     1392         (input  get-pointer-value(v-system-time-structure)
     1393         ,output v-return-value
     1394         ) .
     1395       assign
     1396         set-size(v-system-time-structure) = 0
     1397       .
     1398       if v-return-value = 0
     1399       then do:
     1400         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1401       end.
     1402     end.
     1403   end procedure.
     1404   procedure sys-time_sys-to-mjd :
     1405     define input  parameter p-year         as integer   no-undo .
     1406     define input  parameter p-month        as integer   no-undo .
     1407     define input  parameter p-day          as integer   no-undo .
     1408     define input  parameter p-hour         as integer   no-undo .
     1409     define input  parameter p-minute       as integer   no-undo .
     1410     define input  parameter p-second       as integer   no-undo .
     1411     define input  parameter p-milliseconds as integer   no-undo .
     1412     define output parameter p-mjd          as decimal   no-undo .
     1413     define variable v-year-correction as decimal   no-undo .
     1414     define variable v-shift-year as decimal   no-undo .
     1415     do
     1416     on error undo, return error return-value
     1417     :
     1418       assign
     1419         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1420         v-shift-year      = decimal(p-year) + v-year-correction
     1421         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1422               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1423               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1424               + decimal(p-day) - 2432076.0
     1425               + p-hour / 24.0
     1426               + p-minute / 1440.0
     1427               + p-second / 86400.0
     1428               + p-milliseconds / 86400000.0
     1429       .
     1430     end.
     1431   end procedure.
     1432   procedure sys-time_sys-to-loc :
     1433     define input  parameter p-sys-year         as integer   no-undo .
     1434     define input  parameter p-sys-month        as integer   no-undo .
     1435     define input  parameter p-sys-day          as integer   no-undo .
     1436     define input  parameter p-sys-hour         as integer   no-undo .
     1437     define input  parameter p-sys-minute       as integer   no-undo .
     1438     define input  parameter p-sys-second       as integer   no-undo .
     1439     define input  parameter p-sys-milliseconds as integer   no-undo .
     1440     define output parameter p-loc-year         as integer   no-undo .
     1441     define output parameter p-loc-month        as integer   no-undo .
     1442     define output parameter p-loc-day          as integer   no-undo .
     1443     define output parameter p-loc-hour         as integer   no-undo .
     1444     define output parameter p-loc-minute       as integer   no-undo .
     1445     define output parameter p-loc-second       as integer   no-undo .
     1446     define output parameter p-loc-milliseconds as integer   no-undo .
     1447     define variable v-system-time-structure as memptr    no-undo.
     1448     define variable v-return-value          as integer   no-undo .
     1449     define variable v-sys-day-of-week       as integer   no-undo .
     1450     do
     1451     on error undo, return error return-value
     1452     :
     1453       assign
     1454         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1455       .
     1456       assign
     1457         set-size(v-system-time-structure) = 32
     1458       .
     1459       assign
     1460         put-short(v-system-time-structure,  1) = p-sys-year
     1461         put-short(v-system-time-structure,  3) = p-sys-month
     1462         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1463         put-short(v-system-time-structure,  7) = p-sys-day
     1464         put-short(v-system-time-structure,  9) = p-sys-hour
     1465         put-short(v-system-time-structure, 11) = p-sys-minute
     1466         put-short(v-system-time-structure, 13) = p-sys-second
     1467         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1468       .
     1469       run SystemTimeToTzSpecificLocalTime
     1470         (input  0
     1471         ,input  get-pointer-value(v-system-time-structure)
     1472         ,input  get-pointer-value(v-system-time-structure) + 16
     1473         ,output v-return-value
     1474         ) .
     1475       assign
     1476         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1477         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1478         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1479         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1480         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1481         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1482         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1483       .
     1484       assign
     1485         set-size(v-system-time-structure) = 0
     1486       .
     1487       if v-return-value = 0
     1488       then do:
     1489         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1490       end.
     1491     end.
     1492   end procedure.
     1493   procedure sys-time_mjd-to-sys :
     1494     define input  parameter p-mjd          as decimal   no-undo .
     1495     define output parameter p-year         as integer   no-undo .
     1496     define output parameter p-month        as integer   no-undo .
     1497     define output parameter p-day          as integer   no-undo .
     1498     define output parameter p-hour         as integer   no-undo .
     1499     define output parameter p-minute       as integer   no-undo .
     1500     define output parameter p-second       as integer   no-undo .
     1501     define output parameter p-milliseconds as integer   no-undo .
     1502     define variable v-year-correction as decimal   no-undo .
     1503     define variable v-shift-year      as decimal   no-undo .
     1504     define variable v-conv-date     as date      no-undo .
     1505     define variable v-int-part      as integer   no-undo .
     1506     define variable v-fraction-part as decimal   no-undo .
     1507     do
     1508     on error undo, return error return-value
     1509     :
     1510       assign
     1511         v-int-part      = integer(truncate(p-mjd, 0))
     1512         v-fraction-part = p-mjd - v-int-part
     1513         v-conv-date     = date(11, 17, 1858) + v-int-part
     1514         p-year          = year(v-conv-date)
     1515         p-month         = month(v-conv-date)
     1516         p-day           = day(v-conv-date)
     1517         v-fraction-part = v-fraction-part * 24.0
     1518         p-hour          = integer(truncate(v-fraction-part, 0))
     1519         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1520         p-minute        = integer(truncate(v-fraction-part, 0))
     1521         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1522         p-second        = integer(truncate(v-fraction-part, 0))
     1523         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1524         p-milliseconds  = integer(v-fraction-part)
     1525       .
     1526     end.
     1527   end procedure.
     1528   procedure sys-time_mjd-to-loc :
     1529     define input  parameter p-mjd              as decimal   no-undo .
     1530     define output parameter p-loc-year         as integer   no-undo .
     1531     define output parameter p-loc-month        as integer   no-undo .
     1532     define output parameter p-loc-day          as integer   no-undo .
     1533     define output parameter p-loc-hour         as integer   no-undo .
     1534     define output parameter p-loc-minute       as integer   no-undo .
     1535     define output parameter p-loc-second       as integer   no-undo .
     1536     define output parameter p-loc-milliseconds as integer   no-undo .
     1537     define variable v-sys-year         as integer   no-undo .
     1538     define variable v-sys-month        as integer   no-undo .
     1539     define variable v-sys-day          as integer   no-undo .
     1540     define variable v-sys-hour         as integer   no-undo .
     1541     define variable v-sys-minute       as integer   no-undo .
     1542     define variable v-sys-second       as integer   no-undo .
     1543     define variable v-sys-milliseconds as integer   no-undo .
     1544     do
     1545     on error undo, return error return-value
     1546     :
     1547       run sys-time_mjd-to-sys
     1548         (input  p-mjd
     1549         ,output v-sys-year
     1550         ,output v-sys-month
     1551         ,output v-sys-day
     1552         ,output v-sys-hour
     1553         ,output v-sys-minute
     1554         ,output v-sys-second
     1555         ,output v-sys-milliseconds
     1556         ) .
     1557       run sys-time_sys-to-loc
     1558         (input  v-sys-year
     1559         ,input  v-sys-month
     1560         ,input  v-sys-day
     1561         ,input  v-sys-hour
     1562         ,input  v-sys-minute
     1563         ,input  v-sys-second
     1564         ,input  v-sys-milliseconds
     1565         ,output p-loc-year
