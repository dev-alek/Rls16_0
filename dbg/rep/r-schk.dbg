     1575   function sys-time_get-mjd-func returns decimal
     1576   :
     1577     define variable v-year         as integer   no-undo .
     1578     define variable v-month        as integer   no-undo .
     1579     define variable v-day          as integer   no-undo .
     1580     define variable v-hour         as integer   no-undo .
     1581     define variable v-minute       as integer   no-undo .
     1582     define variable v-second       as integer   no-undo .
     1583     define variable v-milliseconds as integer   no-undo .
     1584     define variable v-mjd          as decimal   no-undo .
     1585     run sys-time_get-sys in this-procedure
     1586       (output v-year
     1587       ,output v-month
     1588       ,output v-day
     1589       ,output v-hour
     1590       ,output v-minute
     1591       ,output v-second
     1592       ,output v-milliseconds
     1593       ) .
     1594     run sys-time_sys-to-mjd in this-procedure
     1595       (input  v-year
     1596       ,input  v-month
     1597       ,input  v-day
     1598       ,input  v-hour
     1599       ,input  v-minute
     1600       ,input  v-second
     1601       ,input  v-milliseconds
     1602       ,output v-mjd
     1603       ) .
     1604     return v-mjd .
     1605   end function .
     1606   function sys-time_get-sys-str-func returns character
     1607   :
     1608     define variable v-utc-time as character no-undo .
     1609     define variable v-year         as integer   no-undo .
     1610     define variable v-month        as integer   no-undo .
     1611     define variable v-day          as integer   no-undo .
     1612     define variable v-hour         as integer   no-undo .
     1613     define variable v-minute       as integer   no-undo .
     1614     define variable v-second       as integer   no-undo .
     1615     define variable v-milliseconds as integer   no-undo .
     1616     run sys-time_get-sys in this-procedure
     1617       (output v-year
     1618       ,output v-month
     1619       ,output v-day
     1620       ,output v-hour
     1621       ,output v-minute
     1622       ,output v-second
     1623       ,output v-milliseconds
     1624       ) .
     1625     assign
     1626       v-utc-time  = 'UTC ':u
     1627                   + string(v-year,         '9999':u)
     1628                   + '/':u
     1629                   + string(v-month,        '99':u)
     1630                   + '/':u
     1631                   + string(v-day,          '99':u)
     1632                   + ' ':u
     1633                   + string(v-hour,         '99':u)
     1634                   + ':':u
     1635                   + string(v-minute,       '99':u)
     1636                   + ':':u
     1637                   + string(v-second,       '99':u)
     1638                   + ' ':u
     1639                   + string(v-milliseconds, '999':u)
     1640     .
     1641     return v-utc-time.
     1642   end function .
     1643   function sys-time_mjd-to-loc-str-func returns character
     1644     (v-sys-mjd as decimal)
     1645   :
     1646     define variable v-loc-str          as character no-undo .
     1647     define variable v-loc-year         as integer   no-undo .
     1648     define variable v-loc-month        as integer   no-undo .
     1649     define variable v-loc-day          as integer   no-undo .
     1650     define variable v-loc-hour         as integer   no-undo .
     1651     define variable v-loc-minute       as integer   no-undo .
     1652     define variable v-loc-second       as integer   no-undo .
     1653     define variable v-loc-milliseconds as integer   no-undo .
     1654     run sys-time_mjd-to-loc in this-procedure
     1655       (input  v-sys-mjd
     1656       ,output v-loc-year
     1657       ,output v-loc-month
     1658       ,output v-loc-day
     1659       ,output v-loc-hour
     1660       ,output v-loc-minute
     1661       ,output v-loc-second
     1662       ,output v-loc-milliseconds
     1663       ) .
     1664     assign
     1665       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1666                             ,string(v-loc-day,    '99':U)
     1667                             ,string(v-loc-month,  '99':U)
     1668                             ,string(v-loc-year,   '9999':U)
     1669                             ,string(v-loc-hour,   '99':U)
     1670                             ,string(v-loc-minute, '99':U)
     1671                             )
     1672     .
     1673     return v-loc-str .
     1674   end function .
