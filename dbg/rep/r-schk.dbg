     2497     , output is-petrol
     2498     , output is-pieces
     2499     ) no-error.
     2500                     if is-petrol = yes
     2501                        and not is-gas(buf_goods.gds-code)   then
     2502                     do:
     2503                        find first tt-goods no-lock
     2504                           where tt-goods.artic = buf_goods.artic
     2505                           and tt-goods.prod-type = buf_goods.prod-type
     2506                           and tt-goods.prod-code = buf_goods.prod-code no-error.
     2507                        if not available tt-goods then
