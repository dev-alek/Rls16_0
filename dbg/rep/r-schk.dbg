      575   define  stream PrnLibStream.
      576   procedure prn-lib-prn-file :
      577     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      578     define input parameter p-DIsabledoptions as integer no-undo .
      579     define variable v-report-name as character no-undo .
      580     define variable v-user-action as character no-undo .
      581     define variable v-printed     as logical   no-undo .
      582     define variable v-exist       as logical   no-undo .
      583     do
      584       on error undo, return error
      585       :
      586       run prn-lib-get-report-name  in this-procedure (
      587         input parParentProc
      588         ,output v-report-name
      589         ).
      590   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      592     (input  v-report-name
      593     ,input  2
      594     ,output v-exist
      595     )  .
      596       if NOT v-exist then
      597       DO:
      598         Message
      599           "Нет заданий на печать ! "
      600           view-as alert-box .
      601         Return  .
      602       End.
      603       run gbl/prnfilen.w
      604         (input  ""
      605         ,input  p-DisabledOptions
      606         ,input  string(v-report-name )
      607         ,input  7
      608         ,output v-user-action
      609         ,output v-printed
      610         ) .
      611       if v-printed then
      612       do:
      613         return "YES" .
      614       end.
      615       else
      616       do:
      617         return "NO" .
      618       end.
      619     end.
      620   end procedure.
      621   procedure prn-lib-open-stream :
      622     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      623     define input parameter p-page-size    as integer no-undo .
      624     define input parameter p-is-stream    as logical no-undo .
      625     define input parameter p-append       as logical no-undo .
      626     define variable v-report-name as character no-undo .
      627     do
      628       on error undo, return error
      629       :
      630       run prn-lib-get-report-name  in this-procedure (
      631         input parParentProc
      632         ,output v-report-name
      633         ).
      634       if p-is-stream then
      635       do:
      636         if p-append then
      637         do:
      638           output stream PrnLibStream to value( v-report-name )
      639             page-size value(p-page-size) append .
      640         end.
      641         if not p-append then
      642         do:
      643           output stream PrnLibStream to value( v-report-name )
      644             page-size value(p-page-size) .
      645         end.
      646       end.
      647       if not p-is-stream then
      648       do:
      649         if p-append then
      650         do:
      651           output to value( v-report-name )
      652             page-size value(p-page-size) append .
      653         end.
      654         if not p-append then
      655         do:
      656           output to value( v-report-name )
      657             page-size value(p-page-size) .
      658         end.
      659       end.
      660     end.
      661   end procedure.
      662   procedure prn-lib-open-exp :
      663     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      664     define input parameter p-is-stream    as logical no-undo .
      665     define input parameter p-is-append    as logical no-undo .
      666     define output parameter p-ReportFileName as char init "report" no-undo.
      667     define output parameter p-process as logical no-undo .
      668     define variable glog as logical no-undo .
      669     do
      670       on error undo, return error
      671       :
      672       SYSTEM-DIALOG GET-FILE p-ReportFileName
      673         TITLE      "Укажите путь"
      674         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      675         ASK-OVERWRITE
      676         CREATE-TEST-FILE
      677         SAVE-AS
      678         USE-FILENAME
      679         DEFAULT-EXTENSION "txt"
      680         UPDATE glog
      681         .
      682       if not glog then  return.
      683       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      684       if p-is-stream then
      685       do:
      686         if p-is-append then
      687         do:
      688           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      689         end.
      690         else
      691         do:
      692           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      693         end.
      694       end.
      695       else
      696       do:
      697         if p-is-append then
      698         do:
      699           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      700         end.
      701         else
      702         do:
      703           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      704         end.
      705       end.
      706       p-process = yes.
      707     end.
      708   end procedure.
      709   procedure prn-lib-get-report-name :
      710     define input parameter parParentProc  as widget-handle no-undo.
      711     define output parameter p-report-name as character no-undo .
      712     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      713   end procedure.
      714   procedure prn-lib-reportviewer-report-name :
      715     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      716     define input parameter p-report-name-html as character no-undo .
      717     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      718   end procedure.
      719   procedure prn-lib-reportviewer :
      720     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      721     define input parameter p-report-name-html as character no-undo .
      722     define input parameter p-param        as character no-undo .
      723     define variable v-excel           as character no-undo init 'TRUE' .
      724     define variable v-value-character as character no-undo .
      725     define variable v-value-integer   as character no-undo .
      726     define variable v-value-date      as date      no-undo .
      727     define variable v-value-decimal   as decimal   no-undo .
      728     define variable rep-excel         as logical   no-undo .
      729     define variable excel-string      as character no-undo .
      730     define variable v-param-type      as character no-undo .
      731     define variable v-tth             as handle    no-undo .
      732     run adm/shattri.p (
      733       input "get":U
      734       ,input  ""
      735       ,input  0
      736       ,input  'report-glob':U
      737       ,input  'rep-excel':U
      738       ,output v-value-character
      739       ,output v-value-date
      740       ,output v-value-decimal
      741       ,output v-value-integer
      742       ,output rep-excel
      743       ,output v-param-type
      744       ,INPUT-OUTPUT table-handle v-tth
      745       )  .
      746     if rep-excel then v-excel = "TRUE" .
      747     else v-excel = "FALSE" .
      748     if p-param eq ""
      749     then
      750        p-param = "EXCEL:" + v-excel.
      751     else
      752        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      753     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      754   end procedure.
      755   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      756   PROCEDURE LastDate:
      757       def input parameter in-date as date no-undo.
      758       def output parameter LastDate as date no-undo.
      759       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      760   END PROCEDURE.
      761   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   procedure cur-time :
      763      define output parameter p-today as date      no-undo .
      764      define output parameter p-time  as integer   no-undo .
      765     do
      766     on error undo, return error
      767     :
      768       define variable v-date1 as date      no-undo .
      769       define variable v-date2 as date      no-undo .
      770       define variable v-time  as integer   no-undo .
      771       assign
      772         v-date1 = today
      773         v-time  = time
      774         v-date2 = today
      775       .
      776       if v-date1 <> v-date2
      777       then do:
      778         assign
      779           v-date1 = today
      780           v-time  = v-time
      781         .
      782       end.
      783       assign
      784         p-today = v-date1
      785         p-time  = v-time
      786       .
      787     end.
      788   end.
      789   function cur-time-date returns character
      790   :
      791     return string(today, '99/99/9999':U) .
      792   end.
      793   function cur-time-mjd returns decimal
      794   :
      795     define variable v-date as date      no-undo .
      796     define variable v-time as integer   no-undo .
      797     run cur-time in this-procedure
      798       (output v-date
      799       ,output v-time
      800       ) .
      801     return integer(v-date) - 2400002 + (v-time / 86400) .
      802   end.
      803   function cur-time-get-ending-index returns integer
      804   (input p-number as integer
      805   )
      806   :
      807     if p-number < 0
      808     or p-number = ?
      809     then do:
      810       return 1 .
      811     end.
      812     define variable v-rest as integer   no-undo .
      813     assign
      814       p-number = p-number modulo 100
      815     .
      816     if p-number < 20
      817     then do:
      818       assign
      819         v-rest = p-number
      820       .
      821     end.
      822     else do:
      823       assign
      824         v-rest = p-number modulo 10
      825       .
      826     end.
      827     case v-rest :
      828       when 1
      829       then do:
      830         return 2 .
      831       end.
      832       when 2 or
      833       when 3 or
      834       when 4
      835       then do:
      836         return 3 .
      837       end.
      838       otherwise do:
      839         return 1 .
      840       end.
      841     end case .
      842   end.
      843   procedure cur-time-mjd-to-date :
      844      define input  parameter i-mjd-diff as decimal no-undo.
      845      define output parameter o-Date     as date    no-undo.
      846      define output parameter o-Time     as integer no-undo.
      847      define variable v-day-number as integer   no-undo .
      848      if    i-mjd-diff < 0
      849         or i-mjd-diff = ?
      850      then do:
      851         return "?" .
      852      end.
      853      assign
      854         v-day-number = truncate(i-mjd-diff,0).
      855         o-Date = date(v-day-number + 2400002).
      856         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      857     .
      858   end.
      859   function cur-time-mjd-to-string returns character
      860   (input p-mjd-diff as decimal
      861   )
      862   :
      863     define variable v-day-number as integer   no-undo .
      864     define variable v-seconds    as integer   no-undo .
      865     define variable v-hour       as integer   no-undo .
      866     define variable v-min        as integer   no-undo .
      867     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      868     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      869     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      870     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      871     if p-mjd-diff < 0
      872     or p-mjd-diff = ?
      873     then do:
      874       return "?" .
      875     end.
      876     assign
      877       v-day-number = integer(truncate(p-mjd-diff,0))
      878       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      879     .
      880     if v-seconds > 86400
      881     then do:
      882       assign
      883         v-seconds = 86400 - 1
      884       .
      885     end.
      886     if v-seconds < 0
      887     then do:
      888       assign
      889         v-seconds = 0
      890       .
      891     end.
      892     assign
      893       v-hour = truncate(v-seconds / 3600, 0)
      894     .
      895     assign
      896       v-seconds = v-seconds modulo 3600
      897     .
      898     assign
      899       v-min = truncate(v-seconds / 60, 0)
      900     .
      901     assign
      902       v-seconds = v-seconds modulo 60
      903     .
      904     return
      905         (if v-day-number <> 0
      906           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      907           else ""
      908         )
      909       + (if v-day-number <> 0 or v-hour <> 0
      910           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      911           else ""
      912         )
      913       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      914           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      915           else ""
      916         )
      917       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      918       .
      919   end.
      920   function cur-time-string returns character
      921   :
      922     define variable v-date as date      no-undo .
      923     define variable v-time as integer   no-undo .
      924     run cur-time in this-procedure
      925       (output v-date
      926       ,output v-time
      927       ) .
      928     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      929   end.
      930   function cur-time-string-sec returns character
      931   :
      932     define variable v-date as date      no-undo .
      933     define variable v-time as integer   no-undo .
      934     run cur-time in this-procedure
      935       (output v-date
      936       ,output v-time
      937       ) .
      938     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      939   end.
      940   function cur-time-custom  returns character
      941   (input p-prefix as character
      942   ,input p-date-format as character
      943   ,input p-delimiter as character
      944   ,input p-time-format as character
      945   ,input p-suffix as character
      946   )
      947   :
      948     define variable v-date as date      no-undo .
      949     define variable v-time as integer   no-undo .
      950     run cur-time in this-procedure
      951       (output v-date
      952       ,output v-time
      953       ) .
      954     return
      955       p-prefix
      956       + string(v-date, p-date-format)
      957       + p-delimiter
      958       + string(v-time, p-time-format)
      959       + p-suffix
      960       .
      961   end.
      962   function cur-time-print  returns character
      963   :
      964     define variable v-date as date      no-undo .
      965     define variable v-time as integer   no-undo .
      966     run cur-time in this-procedure
      967       (output v-date
      968       ,output v-time
      969       ) .
      970     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      971   end.
      972   function cur-time-datetime returns datetime
      973   :
      974     define variable v-char as character no-undo .
      975     define variable v-datetime as datetime no-undo .
      976     v-char = cur-time-string().
      977     v-datetime = datetime(v-char).
      978     return  v-datetime.
      979   end.
      980   function cur-time-string-msec returns character
      981   :
      982     define variable v-date as datetime  no-undo .
      983     v-date = now.
      984     return string(v-date) .
      985   end.
