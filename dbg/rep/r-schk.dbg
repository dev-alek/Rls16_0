     2298   function is-gas returns logical
     2299           (input p-gds-code as integer):
     2300   define variable result as logical no-undo.
     2301   define variable c-value as character no-undo.
     2302   define variable c-type as character no-undo.
     2303   do on error undo, return error:
     2304           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2305         (input  p-gds-code
     2306         ,input  'fuel-type':U
     2307         ,output c-value
     2308         ,output c-type) no-error.
     2309   end.
     2310   result = logical(c-value = 'metan':U) no-error.
     2311   return result.
     2312   end function.
     2313   define variable vss-include-info15 as character format "X(65)" no-undo
     2314   initial "@(#)$Workfile$ $Revision$".
     2315   procedure grplib-get-full-name :
     2316      define input parameter p-node-code  as integer      no-undo.
     2317      define output parameter p-full-name as character    no-undo.
     2318      do
     2319   on error undo, return error
     2320   :
     2321       define variable v-upper-code    as integer           no-undo.
     2322       define buffer buf_gds-grp       for ub.gds-grp.
     2323       define buffer buf_upper_gds-grp for ub.gds-grp.
     2324       find first buf_gds-grp no-lock
     2325            where buf_gds-grp.node-code = p-node-code
     2326       no-error.
     2327       if not available buf_gds-grp
     2328       then do:
     2329           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2330       end.
     2331       assign
     2332           p-full-name  = ""
     2333           v-upper-code = 1
     2334       .
     2335       do while buf_gds-grp.upper-code <> 0
     2336       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2337       :
     2338           assign
     2339               p-full-name  = buf_gds-grp.node-name
     2340                            + (if p-full-name <> "" then chr(47) else "")
     2341                            + p-full-name
     2342               v-upper-code = buf_gds-grp.upper-code
     2343           .
     2344           find first buf_gds-grp no-lock
     2345                where buf_gds-grp.node-code = v-upper-code
     2346           no-error.
     2347           if not available buf_gds-grp
     2348           then do:
     2349               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2350                                   + string( v-upper-code )
     2351                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2352           end.
     2353       end.
     2354       assign
     2355       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2356       .
     2357   end.
     2358   end .
     2359   procedure grplib-get-node-from-full-name :
     2360   define input parameter p-full-name as character no-undo .
     2361   define output parameter p-node-code as integer no-undo .
     2362   define variable v-ii as integer no-undo .
     2363   define variable v-upper-code as integer no-undo .
     2364   define variable v-root-code as integer no-undo .
     2365   define variable v-entry as character no-undo .
     2366   define buffer buf_gds-grp       for ub.gds-grp.
     2367   do
     2368   on error undo, return error
     2369   :
     2370     find first buf_gds-grp no-lock
     2371         where buf_gds-grp.upper-code = 0
     2372     no-error .
     2373     if not available buf_gds-grp
     2374     then do:
     2375         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2376     end.
     2377     else do:
     2378       assign
     2379       v-root-code = buf_gds-grp.node-code
     2380       .
     2381     end.
     2382     v-upper-code = v-root-code.
     2383     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2384       assign
     2385       v-entry = entry(v-ii, p-full-name, chr(47)).
     2386       if v-entry = '' then leave.
     2387       find first buf_gds-grp no-lock where
     2388                 buf_gds-grp.node-name = v-entry
     2389             and buf_gds-grp.upper-code = v-upper-code
     2390             no-error.
     2391       if not available buf_gds-grp then do:
     2392         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2393       end.
     2394       else do:
     2395         p-node-code = buf_gds-grp.node-code.
     2396         v-upper-code = buf_gds-grp.node-code.
     2397       end.
     2398     end.
     2399   end.
     2400   end .
     2401   define buffer buf_clients        for ub.clients .
     2402   define buffer previous-shift-obj for ub.shift-obj.
