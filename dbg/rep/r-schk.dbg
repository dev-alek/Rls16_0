     2429   define variable qnt-vnchk-all       as int       no-undo.
     2430   define variable qnt-vpchk-all       as int       no-undo.
     2431   define variable o-qnt-vschk-all     as int       no-undo.
     2432   define variable o-qnt-vcchk-all     as int       no-undo.
     2433   define variable o-qnt-vnchk-all     as int       no-undo.
     2434   define variable o-qnt-vpchk-all     as int       no-undo.
     2435   define variable pr-qnt-vp           as int       no-undo.
