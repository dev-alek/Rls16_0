     2459   do on error undo, return error return-value:
     2460      empty temp-table tt-goods.
     2461      case x-SelectGood:
     2462         when 1 then
     2463            do:
     2464               v-gds = 'Все'.
     2465               for each buf_goods no-lock where
     2466                  buf_goods.stts = 0:
     2467   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2468     (
     2469        input buf_goods.artic
     2470     ,  input buf_goods.prod-type
     2471     ,  input buf_goods.prod-code
     2472     , output is-petrol
     2473     , output is-pieces
     2474     ) no-error.
     2475                  if is-petrol = yes
     2476                     and not is-gas(buf_goods.gds-code)   then
     2477                  do:
     2478                     create tt-goods.
     2479                     buffer-copy buf_goods to tt-goods.
     2480                     find first bar-code where bar-code.gds-code eq buf_goods.gds-code no-lock no-error.
     2481                     IF AVAILABLE bar-code THEN  tt-goods.b-code = bar-code.b-code.
     2482                     v-gds-counter = v-gds-counter + 1.
     2483                  END.
     2484               end.
     2485            end.
     2486         when 2 then
     2487            do:
     2488               v-gds = 'Группы товаров'.
     2489               for each tmp#grp no-lock:
     2490                  run grplib-get-full-name in this-procedure(input tmp#grp.node-code, output v-curr-grp-name).
     2491                  for each buf_goods no-lock where buf_goods.grp-name begins v-curr-grp-name:
     2492   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2493     (
     2494        input buf_goods.artic
