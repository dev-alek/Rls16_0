     2650            end.
     2651      end case.
     2652   end.
     2653   find first buf_clients no-lock where buf_clients.obj-type = 'орг':U NO-ERROR.
     2654   assign
     2655      v-host-name = buf_clients.obj-name
     2656      .
     2657   FIND FIRST tt-goods no-lock no-error .
     2658   IF NOT AVAILABLE tt-goods THEN
     2659   DO:
     2660      MESSAGE ' Не выбран товар ! Будет использован фильр по умолчанию: Все виды топлива, кроме КПГ ! '  VIEW-AS ALERT-BOX .
     2661      for each buf_goods no-lock:
     2662   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     2663     (
     2664        input buf_goods.artic
     2665     ,  input buf_goods.prod-type
     2666     ,  input buf_goods.prod-code
     2667     , output is-petrol
     2668     , output is-pieces
     2669     ) no-error.
     2670         if is-petrol = yes
     2671            and not is-gas(buf_goods.gds-code)   then
     2672         do:
     2673            create tt-goods.
     2674            buffer-copy buf_goods to tt-goods.
     2675            find first bar-code where bar-code.gds-code eq buf_goods.gds-code no-lock no-error.
     2676            IF AVAILABLE bar-code THEN  tt-goods.b-code = bar-code.b-code.
     2677            v-gds-counter = v-gds-counter + 1.
     2678         END.
     2679      end.
     2680   END.
     2681   DEFINE VARIABLE spis_obj as char no-undo.
     2682   FOR EACH obj-list NO-LOCK:
     2683      spis_obj = spis_obj + ' ' + obj-list.obj-name.
     2684   END.
     2685   define stream OutStr-html.
     2686   run get-report-num in my-handle ( output var-report-num ).
     2687   v-file-name-rep-htm = session:temp-directory + "rpt" + string(var-report-num) + ".html".
     2688   output to value(v-file-name-rep-htm).
     2689   output close.
     2690   def var v-first-time as int  no-undo.
     2691   def var v-first-date as date no-undo.
     2692   def var v-last-date  as date no-undo.
     2693   def var v-last-time  as int  no-undo.
     2694   output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2695   put stream OutStr-html unformatted
     2696   "<!DOCTYPE HTML>" skip
     2697   ' <html>' skip
     2698   '  <head>' skip
     2699   '   <meta charset="utf-8">' skip
     2700   '    <style type="text/css">' skip
     2701   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2702   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
     2703   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
     2704   '   </style>' skip
     2705   '  </head>' skip
     2706      .
     2707         v-period = "с " + string(x-Date-Start, "99.99.9999") + ' по ' + string(X-date-End, "99.99.9999") .
     2708         run shapka .
     2709   FOR EACH obj-list NO-LOCK:
     2710      if X-tog-shift then
     2711      do:
     2712         run rep/rpychk0.p ( input "r-shftc2"
     2713            ,input obj-list.obj-type
     2714            ,input obj-list.obj-code
     2715            ,input ?
     2716            ,input ?
     2717            ,input X-date-start
     2718            ,input X-date-end
     2719            ,input X-shift-start
     2720            ,input X-shift-end
     2721            ,input ?
     2722            ).
     2723         FOR EACH ub.chk-doc where ub.chk-doc.obj-code = obj-list.obj-code
     2724            and ub.chk-doc.shift-date >= X-date-Start
     2725            and ub.chk-doc.shift-date <= x-Date-End
     2726            and (ub.chk-doc.chk-type = 1 or ub.chk-doc.chk-type = 6)
     2727            and ub.chk-doc.out-code <> ? NO-LOCK:
     2728            if ub.chk-doc.shift-date = X-date-Start and ub.chk-doc.shift-num < X-Shift-Start then next .
     2729            if ub.chk-doc.shift-date = X-date-End   and ub.chk-doc.shift-num > X-Shift-End then next .
     2730            run proc-report .
     2731         end.
     2732      end.
     2733      else
     2734      do:
     2735         run rep/rpychk0.p ( input "r-date"
     2736            ,input obj-list.obj-type
     2737            ,input obj-list.obj-code
     2738            ,input ?
     2739            ,input ?
     2740            ,input X-date-start
     2741            ,input X-date-end
     2742            ,input ?
     2743            ,input ?
     2744            ,input ?
     2745            ).
     2746         FOR EACH chk-doc where chk-doc.obj-code = obj-list.obj-code
     2747            and chk-doc.chk-date >= x-Date-Start
     2748            and chk-doc.chk-date <= x-Date-End
     2749            and (chk-doc.chk-type = 1 or chk-doc.chk-type = 6)
     2750            and chk-doc.out-code <> ? NO-LOCK:
     2751            run proc-report .
     2752         end.
     2753      end.
     2754      run itog .
     2755   end.
     2756   procedure shapka:
     2757      put stream OutStr-html unformatted
     2758         '<body>' skip
     2759         '<TABLE name="Отчет по сухим чекам"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
     2760         '<thead>' skip
     2761         .
     2762      put stream OutStr-html unformatted
     2763         '<tr class="set_columns">' skip
     2764         '<td style="width:200px"></td>' skip
     2765         '<td style="width:160px"></td>' skip
     2766         '<td style="width:130px"></td>' skip
     2767         '<td style="width:60px"></td>' skip
     2768         '<td style="width:180px"></td>' skip
     2769         '<td style="width:100px"></td>' skip
     2770         '<td style="width:180px"></td>' skip
     2771         '<td style="width:80px"></td>' skip
     2772         '<td style="width:130px"></td>' skip
     2773         '<td style="width:100px"></td>' skip
     2774         '<td style="width:150px"></td>' skip
     2775         '<td style="width:75px"></td>' skip
     2776         '<td style="width:65px"></td>' skip
     2777         '<td style="width:80px"></td>' skip
     2778         '<td style="width:85px"></td>' skip
     2779         '<td style="width:85px"></td>' skip
     2780         '<td style="width:85px"></td>' skip
     2781         '<td style="width:120px"></td>' skip
     2782         '<td style="width:100px"></td>' skip
     2783         '</tr>' skip
     2784         .
     2785      put stream OutStr-html unformatted
     2786         '<tr><td colspan="19">' + string(v-host-name) + '</td></tr>' skip
     2787         '<tr><td colspan="19" style="text-align:left;">За период ' + v-period + '</td></tr>' skip
     2788         '<tr><td colspan="19" style="text-align:left;">Выбор объекта:</td></tr>' skip
     2789         '<tr><td colspan="19" style="text-align:left;">' + string(spis_obj) + '</td></tr>' skip
     2790         '<tr><td colspan="19" style="text-align:left;">Дата формирования ' + string(now,"99.99.99 HH:MM:SS") + ' </td></tr>' skip
     2791         '<tr><td colspan="19"  style="font-size:14px;font-weight:bold;">Отчет по всем сухим чекам продажи и возврата с топливом</td></tr>' skip
     2792         '<tr><td colspan="5" style="font-size:11px; text-align: left;"></td>' skip
     2793         '<td colspan="14"></td></tr>' skip
     2794         '</thead>' skip
     2795         '<tbody>' skip
     2796         '<tr>' skip
     2797         '<th style="text-align: center;">ПНПО</th>' skip
     2798         '<th style="text-align: center;">Наименование объекта</th>' skip
     2799         '<th style="text-align: center;">Номер кассы</th>' skip
     2800         '<th style="text-align: center;">Смена</th>' skip
     2801         '<th style="text-align: center;">Дата смены</th>' skip
     2802         '<th style="text-align: center;">Тип чека</th>' skip
     2803         '<th style="text-align: center;">Номер чека</th>' skip
     2804         '<th style="text-align: center;">Создан в ТН</th>' skip
     2805         '<th style="text-align: center;">Дата чека</th>' skip
     2806         '<th style="text-align: center;">Время чека</th>' skip
     2807         '<th style="text-align: center;">Продукт</th>'skip
     2808         '<th style="text-align: center;">ТРК</th>' skip
     2809         '<th style="text-align: center;">Пистолет</th>' skip
     2810         '<th style="text-align: center;">Кол-во, л.</th>' skip
     2811         '<th style="text-align: center;">Цена за ед.</th>' skip
     2812         '<th style="text-align: center;">Сумма по чеку</th>' skip
     2813         '<th style="text-align: center;">Сумма по типу оплаты</th>' skip
     2814         '<th style="text-align: center;">Тип оплаты</th>' skip
     2815         '<th style="text-align: center;">ФИО кассира</th>' skip
     2816         '</tr>' skip
     2817         .
     2818   end procedure .
     2819   procedure proc-report:
     2820      define variable handmade as character no-undo.
     2821      handmade = '-'.
     2822      FIND FIRST c-chk-doc WHERE c-chk-doc.doc-code = chk-doc.doc-code AND c-chk-doc.is-add = yes NO-LOCK NO-ERROR.
     2823      IF AVAILABLE c-chk-doc THEN handmade = '+'.
     2824      FOR EACH  chk-gds where chk-gds.doc-code = chk-doc.doc-code no-lock:
     2825         if chk-doc.chk-type = 1 and chk-gds.pass-gds <> 1 then next .
     2826         if chk-doc.chk-type = 6 then do:
     2827         find first chk-doc-attr where chk-doc-attr.doc-code = chk-doc.doc-code
     2828            and chk-doc-attr.attr-code = 'CHFlag1' no-lock no-error.
     2829         IF not AVAILABLE chk-doc-attr or chk-doc-attr.attr-value <> '0' THEN next .
     2830         end.
     2831         find first tt-goods where tt-goods.b-code = chk-gds.b-code no-error .
     2832         if not available (tt-goods) then next .
     2833         produkt = ''.
     2834         time-chk-chr = ''.
     2835         produkt = TRIM(tt-goods.gds-name).
     2836         find first person where person.psn-code = chk-doc.cashier-psn-code no-lock no-error.
     2837         IF AVAILABLE person THEN  kassir-chr = person.name1 + ' ' + person.name2 + ' '.
     2838         find first clients where person.psn-code = clients.obj-code and clients.obj-type = 'чел' no-lock no-error.
     2839         IF AVAILABLE clients THEN kassir-chr = kassir-chr + clients.obj-name.
     2840         time-chk-chr = string(chk-doc.chk-time, "HH:MM").
     2841         t-chk-chr = ENTRY(LOOKUP(string(chk-doc.chk-type), "1,6,8,11,12,13,40,69,96,14,15,16,17,36,101,106,108,111,112,113,169,196,114,115,116,117,136,201,206,208,301,306,2,3,4,5,7,43,44"),"Продажа,Возврат,Аннуляция,Инвентаризация,Z-отчет,Закрытие_смены,Открытие_смены,Списание,ВзврСпис,СбросТрнзкц,Перелив,ПеревТрнзкц,ТехПролив,РазблТрнзкц,_Продажа,_Возврат,_Аннуляция,_Инвентаризация,_Z-отчет,_Закрытие_смены,_Списание,_ВзврСпис,_СбросТрнзкц,_Перелив,_ПеревТрнзкц,_ТехПролив,_РазблТрнзкц,>Продажа,>Возврат,>Аннуляция,>>Продажа,>>Возврат,Инкассация,Касс_фонд,Перевод_опл,Расход_кассы,Декл_ден_ящ,Приход_Корр,Расход_Корр").
     2842         o-qnt-chk = o-qnt-chk + 1.
     2843         IF chk-doc.chk-type = 1 THEN o-qnt-pchk = o-qnt-pchk + 1.
     2844         IF chk-doc.chk-type = 6 THEN o-qnt-vchk = o-qnt-vchk + 1.
     2845         o-sum-ob = o-sum-ob + ABSOLUTE(chk-doc.tot-doc).
     2846         o-sum-it = o-sum-it + chk-doc.tot-doc .
     2847         opl-chr = ''.
     2848         opl-sum = ''.
     2849         for EACH  chk-gds-pay where chk-gds-pay.doc-code = chk-gds.doc-code and chk-gds-pay.b-code = chk-gds.b-code no-lock :
     2850            find first cash-pay where cash-pay.cdpay-code = chk-gds-pay.pay-code no-lock no-error.
     2851            IF AVAILABLE cash-pay THEN opl-chr = cash-pay.obj-name.
     2852            put stream OutStr-html unformatted
     2853               '<tr>' skip
     2854               '<td text_wrap="true">' + v-host-name + '</td>' skip
     2855               '<td text_wrap="true">' + obj-list.obj-name + '</td>' skip
     2856               '<td text_wrap="true" style="text-align:center;">' + string(chk-doc.pay-desk) + '</td>' skip
     2857               '<td text_wrap="true" style="text-align:center;">' + chk-doc.shift-name + '</td>' skip
     2858               '<td text_wrap="true" style="text-align:center;">' + string(chk-doc.shift-date) + '</td>' skip
     2859               '<td text_wrap="true" style="text-align:center;">' + t-chk-chr + '</td>' skip
     2860               '<td text_wrap="true" style="text-align:center;">' + string(chk-doc.chk-num) + ':' + string(chk-doc.z-number) + '</td>' skip
     2861               '<td text_wrap="true" style="text-align:center;">' + handmade + '</td>' skip
     2862               '<td text_wrap="true" style="text-align:center;">' + string(chk-gds.chk-date) + '</td>' skip
     2863               '<td text_wrap="true" style="text-align:center;">' + time-chk-chr + '</td>' skip
     2864               '<td text_wrap="true">' + SUBSTRING(produkt,1,50) + '</td>' skip
     2865               '<td text_wrap="true" style="text-align:center;">' + string(chk-gds.pump) + '</td>' skip
     2866               '<td text_wrap="true" style="text-align:center;">' + string(chk-gds.nozzle-code) + '</td>' skip
     2867               '<td text_wrap="true" style="text-align:right;">' + string(ABSOLUTE(chk-gds.doc-qnty),"->>>>>>>>9.99") + '</td>' skip
     2868               '<td text_wrap="true" style="text-align:center;">' + string(chk-gds.price-base,"->>>>>>>>9.99") + '</td>' skip
     2869               '<td text_wrap="true" style="text-align:right;">' + string(ABSOLUTE(chk-gds.src-sum),"->>>>>>>>9.99") + '</td>' skip
     2870               '<td text_wrap="true" style="text-align:right;">' + string(ABSOLUTE(chk-gds-pay.tot-r-b),"->>>>>>>>9.99") + '</td>' skip
     2871               '<td text_wrap="true">' + opl-chr + '</td>' skip
     2872               '<td text_wrap="true">' + kassir-chr + '</td>' skip
     2873               '</tr>' skip
     2874               .
     2875         end.
     2876      END.
     2877   end PROCEDURE.
     2878   procedure itog:
     2879      if o-qnt-chk > 0 then
     2880      do:
     2881         put stream OutStr-html unformatted
     2882            '<tr>' skip
     2883            '<td style="font-weight:bold;">Итог по:</td>' skip
     2884            '<td style="font-weight:bold;">' + obj-list.obj-name + '</td>' skip
     2885            '<td style="font-weight:bold;">Всего сухих чеков:</td>' skip
     2886            '<td style="font-weight:bold; text-align:center;">' + string(o-qnt-chk) + '</td>' skip
     2887            '<td style="font-weight:bold;">Всего сухих чеков продажи:</td>' skip
     2888            '<td style="text-align:center; font-weight:bold;">' + string(o-qnt-pchk) + '</td>' skip
     2889            '<td style="font-weight:bold;">Всего сухих чеков возврата:</td>' skip
     2890            '<td style="text-align:center; font-weight:bold;">' + string(o-qnt-vchk) + '</td>' skip
     2891            '<td style="font-weight:bold;">Сумма по обороту:</td>' skip
     2892            '<td style="text-align:center; font-weight:bold;">' + string(o-sum-ob,"->>>>>>>>9.99") + '</td>' skip
     2893            '<td style="font-weight:bold;">Итоговая сумма:</td>' skip
     2894            '<td style="font-weight:bold; text-align:center;">' + string(o-sum-it,"->>>>>>>>9.99") + '</td>' skip
     2895            '<td></td>' skip
     2896            '<td></td>' skip
     2897            '<td></td>' skip
     2898            '<td></td>' skip
     2899            '<td></td>' skip
     2900            '<td></td>' skip
     2901            '<td></td>' skip
     2902            '</tr>' skip
     2903            .
     2904      end.
     2905      qnt-chk = qnt-chk + o-qnt-chk.
     2906      qnt-pchk = qnt-pchk + o-qnt-pchk.
     2907      qnt-vchk = qnt-vchk + o-qnt-vchk.
     2908      sum-it = sum-it + o-sum-it.
     2909      sum-ob = sum-ob + o-sum-ob.
     2910      o-qnt-chk = 0.
     2911      o-qnt-pchk = 0.
     2912      o-qnt-vchk = 0.
     2913      o-sum-it = 0.
     2914      o-sum-ob = 0.
     2915   end procedure .
     2916   put stream OutStr-html unformatted
     2917      '<tr>' skip
     2918      '<td style="font-weight:bold;">Итог по:</td>' skip
     2919      '<td style="font-weight:bold;">Все объекты</td>' skip
     2920      '<td style="font-weight:bold;">Всего сухих чеков:</td>' skip
     2921      '<td style="text-align:center; font-weight:bold;">' + string(qnt-chk) + '</td>' skip
     2922      '<td style="font-weight:bold;">Всего сухих чеков продажи:</td>' skip
     2923      '<td style="text-align:center; font-weight:bold;">' + string(qnt-pchk) + '</td>' skip
     2924      '<td style="font-weight:bold;">Всего сухих чеков возврата:</td>' skip
     2925      '<td style="text-align:center; font-weight:bold;">' + string(qnt-vchk) + '</td>' skip
     2926      '<td style="font-weight:bold;">Сумма по обороту:</td>' skip
     2927      '<td style="text-align:center; font-weight:bold;">' + string(sum-ob,"->>>>>>>>9.99") + '</td>' skip
     2928      '<td style="font-weight:bold;">Итоговая сумма:</td>' skip
     2929      '<td style="text-align:center; font-weight:bold;">' + string(sum-it,"->>>>>>>>9.99") + '</td>' skip
     2930      '<td></td>' skip
     2931      '<td></td>' skip
     2932      '<td></td>' skip
     2933      '<td></td>' skip
     2934      '<td></td>' skip
     2935      '<td></td>' skip
     2936      '<td></td>' skip
     2937      '</tr>' skip
     2938      .
     2939   put stream OutStr-html unformatted
     2940      substitute (' 
     2941   </tbody> 
     2942   </table> 
     2943   </body> 
     2944   </html> 
     2945    ').
     2946   output stream OutStr-html close.
     2947   run prn-lib-reportviewer in this-procedure (
     2948      input my-handle
     2949      ,input v-file-name-rep-htm
     2950      ,input ""
     2951      ) no-error.
     2952   if error-status:error then
     2953   do:
     2954      message return-value view-as alert-box.
     2955      return .
     2956   end.
