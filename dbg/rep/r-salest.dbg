      618   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      619     (output var-report-r-b
      620     )  .
      621   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      622   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      623   define  shared variable RepPathName        as character no-undo .
      624   define  shared variable PrintRubl          as logical   no-undo .
      625   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      627   procedure paramls-clear :
      628     define buffer buf_temp-param for temp-param .
      629     do
      630     on error undo, return error return-value
      631     :
      632       for each buf_temp-param
      633       on error undo, return error
      634       :
      635         delete buf_temp-param .
      636       end.
      637     end.
      638   end procedure.
      639   procedure paramls-write :
      640     define input  parameter p-code     as character no-undo .
      641     define input  parameter p-sub-code as character no-undo .
      642     define input  parameter p-value    as character no-undo .
      643     define buffer buf_temp-param for temp-param .
      644     do
      645     on error undo, return error return-value
      646     :
      647       find first buf_temp-param
      648         where buf_temp-param.param-code     = p-code
      649           and buf_temp-param.param-sub-code = p-sub-code
      650         no-error .
      651       if not available buf_temp-param then do:
      652         create buf_temp-param .
      653         assign
      654           buf_temp-param.param-code     = p-code
      655           buf_temp-param.param-sub-code = p-sub-code
      656         .
      657       end.
      658       assign
      659         buf_temp-param.param-value = p-value
      660       .
      661     end.
      662   end procedure.
      663   procedure paramls-read :
      664     define input  parameter p-code          as character no-undo .
      665     define input  parameter p-sub-code      as character no-undo .
      666     define input  parameter p-default-value as character no-undo .
      667     define output parameter p-value         as character no-undo .
      668     define buffer buf_temp-param for temp-param .
      669     do
      670     on error undo, return error return-value
      671     :
      672       find first buf_temp-param
      673         where buf_temp-param.param-code     = p-code
      674           and buf_temp-param.param-sub-code = p-sub-code
      675         no-error .
      676       if available buf_temp-param then do:
      677         assign
      678           p-value = buf_temp-param.param-value
      679         .
      680       end.
      681       else do:
      682         assign
      683           p-value = p-default-value
      684         .
      685       end.
      686     end.
      687   end procedure.
      688   procedure paramls-append :
      689     define input  parameter p-code     as character no-undo .
      690     define input  parameter p-sub-code as character no-undo .
      691     define input  parameter p-value    as character no-undo .
      692     define buffer buf_temp-param for temp-param .
      693     do
      694     on error undo, return error return-value
      695     :
      696       find first buf_temp-param
      697            where buf_temp-param.param-code     = p-code
      698              and buf_temp-param.param-sub-code = p-sub-code
      699         no-error .
      700       if not available buf_temp-param then do:
      701         create buf_temp-param .
      702         assign
      703           buf_temp-param.param-code     = p-code
      704           buf_temp-param.param-sub-code = p-sub-code
      705           buf_temp-param.param-value    = p-value
      706         .
      707       end.
      708       else do:
      709           assign
      710               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      711           .
      712       end.
      713     end.
      714   end procedure.
      715   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      716   procedure factord :
      717     define input  parameter p-fact-date            as date    no-undo .
      718     define input  parameter p-fact-time            as integer no-undo .
      719     define input  parameter p-fact-num             as integer no-undo .
      720     define input  parameter p-shift-date           as date    no-undo .
      721     define input  parameter p-shift-num            as integer no-undo .
      722     define input  parameter p-shift-on             as logical no-undo .
      723     define output parameter p-fact-order           as decimal no-undo .
      724     define output parameter p-shift-end-fact-order as decimal no-undo .
      725     define output parameter p-day-end-fact-order   as decimal no-undo .
      726     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      727     if p-fact-date = ?
      728     then do:
      729       return error "Не указана фактическая дата" .
      730     end.
      731     define variable v-fact-date-num as integer no-undo .
      732     assign
      733       v-fact-date-num = integer(p-fact-date)
      734     .
      735     if p-fact-num = ?
      736     or p-fact-num = 0
      737     then do:
      738       return error "Не задан p-fact-num " + string(p-fact-num) .
      739     end.
      740     if p-fact-num < 0
      741     then do:
      742       return error "Отрицательный fact-num " + string(p-fact-num) .
      743     end.
      744     if p-fact-num >= 100000000
      745     then do:
      746       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      747     end.
      748     if p-shift-on = true
      749     then do:
      750       if p-shift-date = ?
      751       then do:
      752         return error "Не задана дата смены" .
      753       end.
      754       if p-shift-num = ?
      755       or p-shift-num = 0
      756       then do:
      757         return error "Не задан номер смены" .
      758       end.
      759     end.
      760     else do:
      761       assign
      762         p-shift-date = p-fact-date
      763         p-shift-num  = 24
      764       .
      765     end.
      766     define variable v-shift-offset as integer no-undo .
      767     if p-shift-date = p-fact-date
      768     then do:
      769       assign
      770         v-shift-offset = 1
      771       .
      772     end.
      773     if p-shift-date < p-fact-date
      774     then do:
      775       assign
      776         v-shift-offset = 0
      777       .
      778     end.
      779     if p-shift-date > p-fact-date
      780     then do:
      781       message
      782         vss-workfile vss-revision vss-description skip
      783         "Неправильная дата закрытия смены" skip
      784         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      785         view-as alert-box error .
      786       undo, return error
      787         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      788           ,string(p-fact-date, '99/99/9999':U)
      789           ,string(p-shift-date, '99/99/9999':U)
      790           )
      791       .
      792     end.
      793     if p-shift-num < 1
      794     or p-shift-num > 24
      795     then do:
      796       message
      797         vss-workfile vss-revision vss-description skip
      798         "Неправильный номер смены" skip
      799         "p-shift-num" p-shift-num skip
      800         view-as alert-box error .
      801       undo, return error return-value .
      802     end.
      803     assign
      804       p-fact-order           = v-fact-date-num
      805                              + v-shift-offset * 0.5
      806                              + p-shift-num    * 0.02 - 0.01
      807                              + p-fact-num     * 0.0000000001
      808       p-shift-end-fact-order = v-fact-date-num
      809                              + v-shift-offset * 0.5
      810                              + p-shift-num    * 0.02
      811       p-day-end-fact-order   = v-fact-date-num
      812                              + 0.99
      813     .
      814     if p-fact-order           <= v-fact-date-num
      815     or p-shift-end-fact-order <= v-fact-date-num
      816     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      817     or p-shift-end-fact-order >= p-day-end-fact-order
      818     then do:
      819       message
      820         vss-workfile vss-revision vss-description skip
      821         "Внутренняя ошибка при генерации фактического номера" skip
      822         "p-fact-date"            p-fact-date            skip
      823         "p-fact-time"            p-fact-time            skip
      824         "p-fact-num"             p-fact-num             skip
      825         "p-shift-date"           p-shift-date           skip
      826         "p-shift-num"            p-shift-num            skip
      827         "p-shift-on"             p-shift-on             skip
      828         "p-shift-end-fact-order" p-shift-end-fact-order skip
      829         "p-day-end-fact-order"   p-day-end-fact-order   skip
      830         "v-fact-date-num"        v-fact-date-num        skip
      831         view-as alert-box error .
      832       undo, return error return-value .
      833     end.
      834   end procedure.
      835   procedure day-begin-fact-order :
      836     define input  parameter p-fact-date            as date    no-undo .
      837     define output parameter p-day-begin-fact-order as decimal no-undo .
      838     do
      839     on error undo, return error return-value
      840     :
      841       if p-fact-date = ?
      842       then do:
      843         assign
      844           p-day-begin-fact-order = 0
      845         .
      846       end.
      847       else do:
      848         assign
      849           p-day-begin-fact-order = integer(p-fact-date)
      850         .
      851       end.
      852     end.
      853   end procedure.
      854   procedure factord-max-fact-order :
      855     define output parameter p-max-fact-order as decimal   no-undo .
      856     do
      857     on error undo, return error return-value
      858     :
      859       run day-begin-fact-order in this-procedure
      860         (input  date(1, 1, 5000)
      861         ,output p-max-fact-order
      862         ) .
      863     end.
      864   end procedure.
      865   procedure factord-cut-archive :
      866     define input  parameter p-obj-type             as character no-undo .
      867     define input  parameter p-obj-code             as integer   no-undo .
      868     define input  parameter p-fact-date            as date      no-undo .
      869     define output parameter p-shift-on             as logical   no-undo .
      870     define output parameter p-shift-date           as date      no-undo .
      871     define output parameter p-shift-num            as integer   no-undo .
      872     define output parameter p-day-end-fact-order   as decimal   no-undo .
      873     define output parameter p-shift-end-fact-order as decimal   no-undo .
      874     define variable v-fact-order as decimal   no-undo .
      875     define buffer buf_shift-obj for ub.shift-obj .
      876     do
      877     on error undo, return error return-value
      878     :
      879   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      881     (input  p-obj-type
      882     ,input  p-obj-code
      883     ,input  'shift-on=request'
      884     ,output p-shift-on
      885     ) no-error .
      886       if error-status :error
      887       then do:
      888         message
      889           vss-workfile vss-revision vss-description skip
      890           "Ошибка при определении атрибута объекта" skip
      891           "Объект" p-obj-type p-obj-code skip
      892           error-status :get-message(1) skip
      893           return-value skip
      894           view-as alert-box error .
      895         undo, return error return-value .
      896       end.
      897       if p-shift-on = false
      898       then do:
      899         assign
      900           p-shift-date               = ?
      901           p-shift-num                = 0
      902         .
      903       end.
      904       else do:
      905         find first buf_shift-obj share-lock
      906           where buf_shift-obj.obj-type   = p-obj-type
      907             and buf_shift-obj.obj-code   = p-obj-code
      908             and buf_shift-obj.shift-date > p-fact-date
      909           use-index pi
      910           no-error .
      911         if not available buf_shift-obj
      912         or buf_shift-obj.status_ <> 'зкр':U
      913         then do:
      914           message
      915             vss-workfile vss-revision vss-description skip
      916             "Невозможно вычислить последнюю смену" skip
      917             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      918             "Объект" p-obj-type p-obj-code skip
      919             "Дата" p-fact-date skip
      920             view-as alert-box error .
      921           undo, return error return-value .
      922         end.
      923         find last buf_shift-obj share-lock
      924           where buf_shift-obj.obj-type = p-obj-type
      925             and buf_shift-obj.obj-code = p-obj-code
      926             and buf_shift-obj.shift-date <= p-fact-date
      927           use-index pi
      928           no-error .
      929         if available buf_shift-obj
      930         then do:
      931           if  buf_shift-obj.status_ = 'зкр':U
      932           then do:
      933             assign
      934               p-shift-date = buf_shift-obj.shift-date
      935               p-shift-num  = buf_shift-obj.shift-num
      936             .
      937           end.
      938           else do:
      939             message
      940               vss-workfile vss-revision vss-description skip
      941               "Невозможно вычислить последнюю смену" skip
      942               "Статус смены отличен от статуса" 'зкр':U skip
      943               "Объект" p-obj-type p-obj-code skip
      944               "Дата" p-fact-date skip
      945               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      946               view-as alert-box error .
      947             undo, return error return-value .
      948           end.
      949         end.
      950         else do:
      951           assign
      952             p-shift-date = p-fact-date - 1
      953             p-shift-num  = 1
      954           .
      955         end.
      956       end.
      957       run factord in this-procedure
      958         (input  p-fact-date
      959         ,input  1
      960         ,input  1
      961         ,input  p-shift-date
      962         ,input  p-shift-num
      963         ,input  p-shift-on
      964         ,output v-fact-order
      965         ,output p-shift-end-fact-order
      966         ,output p-day-end-fact-order
      967         ) no-error .
      968       if error-status :error
      969       then do:
      970         message
      971           vss-workfile vss-revision vss-description skip
      972           "Ошибка при вызове процедуры factord"
      973           error-status :get-message(1) skip
      974           return-value skip
      975           view-as alert-box error .
      976         undo, return error return-value .
      977       end.
      978     end.
      979   end procedure.
      980   procedure factord-lock-shift :
      981     define input  parameter p-obj-type  as character no-undo .
      982     define input  parameter p-obj-code  as integer   no-undo .
      983     define input  parameter p-fact-date as date      no-undo .
      984     define parameter buffer buf_shift-obj for ub.shift-obj .
      985     define variable v-shift-on      as logical   no-undo .
      986     define variable v-extra-message as character no-undo .
      987     define variable v-error as character no-undo .
      988     do
      989     on error undo, return error return-value
      990     :
      991   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      992   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      993     (input  p-obj-type
      994     ,input  p-obj-code
      995     ,input  'shift-on=request'
      996     ,output v-shift-on
      997     ) no-error .
      998       if error-status :error
      999       then do:
     1000         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1001         undo, return error v-error .
     1002       end.
     1003       if v-shift-on = true
     1004       then do:
     1005         find first buf_shift-obj share-lock
     1006           where buf_shift-obj.obj-type   = p-obj-type
     1007             and buf_shift-obj.obj-code   = p-obj-code
     1008             and buf_shift-obj.shift-date > p-fact-date
     1009           use-index pi
     1010           no-error .
     1011         if not available buf_shift-obj
     1012         or buf_shift-obj.status_ <> 'зкр':U
     1013         then do:
     1014           find last buf_shift-obj
     1015             where buf_shift-obj.obj-type = p-obj-type
     1016               and buf_shift-obj.obj-code = p-obj-code
     1017               and buf_shift-obj.status_  = 'зкр':U
     1018             use-index stts
     1019             no-error .
     1020           if available buf_shift-obj
     1021           then do:
     1022             assign
     1023               v-extra-message =
     1024                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1025                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1026                               )
     1027             .
     1028           end.
     1029           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1030           undo, return error v-error .
     1031         end.
     1032       end.
     1033     end.
     1034   end procedure.
     1035   procedure factord-end-day :
     1036     define input  parameter p-fact-date            as date    no-undo .
     1037     define output parameter p-day-end-fact-order   as decimal no-undo .
     1038     do
     1039     on error undo, return error return-value
     1040     :
     1041       if p-fact-date = ?
     1042       then do:
     1043         return error "Не указана фактическая дата" .
     1044       end.
     1045       assign
     1046         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1047       .
     1048     end.
     1049   end procedure.
     1050   procedure factord-to-date :
     1051     define input  parameter p-fact-order as decimal no-undo .
     1052     define output parameter p-fact-date  as date    no-undo .
     1053     define variable v-ref-date  as date      no-undo .
     1054     define variable v-ref-delta as integer   no-undo .
     1055     do
     1056     on error undo, return error return-value
     1057     :
     1058       if p-fact-order = ?
     1059       or p-fact-order = 0
     1060       then do:
     1061         return error "Не указан fact-order" .
     1062       end.
     1063       assign
     1064         v-ref-date  = date(1, 1, 2000)
     1065       .
     1066       assign
     1067         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1068       .
     1069       assign
     1070         p-fact-date = v-ref-date + v-ref-delta
     1071       .
     1072     end.
     1073   end procedure.
     1074   procedure factord-to-fact-num :
     1075     define input  parameter p-fact-order as decimal no-undo .
     1076     define output parameter p-fact-num   as integer no-undo .
     1077     define variable v-fact-order-trunc as decimal no-undo .
     1078     do
     1079     on error undo, return error return-value
     1080     :
     1081       if p-fact-order = ?
     1082       or p-fact-order = 0
     1083       then do:
     1084         return error "Не указан fact-order" .
     1085       end.
     1086       assign
     1087        v-fact-order-trunc = truncate(p-fact-order, 2)
     1088       .
     1089       assign
     1090         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1091       .
     1092     end.
     1093   end procedure.
     1094   procedure factord-to-shift-num :
     1095     define input  parameter p-fact-order as decimal no-undo .
     1096     define output parameter p-shift-num   as integer no-undo .
     1097     define variable  p-shift-numd  as decimal   no-undo .
     1098     define variable v-fact-order-trunc as decimal no-undo .
     1099     do
     1100     on error undo, return error return-value
     1101     :
     1102       if p-fact-order = ?
     1103       or p-fact-order = 0
     1104       then do:
     1105         return error "Не указан fact-order" .
     1106       end.
     1107       assign
     1108        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1109       .
     1110       if v-fact-order-trunc < 0.5 then do:
     1111         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1112       end.
     1113       assign
     1114         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1115         .
     1116        assign
     1117         p-shift-num = truncate (p-shift-numd , 0)
     1118       .
     1119     end.
     1120   end procedure.
     1121   define variable vss-include-info12 as character format "X(65)" no-undo
     1122   initial "@(#)$Workfile$ $Revision$".
     1123   procedure grplib-get-full-name :
     1124      define input parameter p-node-code  as integer      no-undo.
     1125      define output parameter p-full-name as character    no-undo.
     1126      do
     1127   on error undo, return error
     1128   :
     1129       define variable v-upper-code    as integer           no-undo.
     1130       define buffer buf_gds-grp       for ub.gds-grp.
     1131       define buffer buf_upper_gds-grp for ub.gds-grp.
     1132       find first buf_gds-grp no-lock
     1133            where buf_gds-grp.node-code = p-node-code
     1134       no-error.
     1135       if not available buf_gds-grp
     1136       then do:
     1137           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1138       end.
     1139       assign
     1140           p-full-name  = ""
     1141           v-upper-code = 1
     1142       .
     1143       do while buf_gds-grp.upper-code <> 0
     1144       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1145       :
     1146           assign
     1147               p-full-name  = buf_gds-grp.node-name
     1148                            + (if p-full-name <> "" then chr(47) else "")
     1149                            + p-full-name
     1150               v-upper-code = buf_gds-grp.upper-code
     1151           .
     1152           find first buf_gds-grp no-lock
     1153                where buf_gds-grp.node-code = v-upper-code
     1154           no-error.
     1155           if not available buf_gds-grp
     1156           then do:
     1157               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1158                                   + string( v-upper-code )
     1159                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1160           end.
     1161       end.
     1162       assign
     1163       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1164       .
     1165   end.
     1166   end .
     1167   procedure grplib-get-node-from-full-name :
     1168   define input parameter p-full-name as character no-undo .
     1169   define output parameter p-node-code as integer no-undo .
     1170   define variable v-ii as integer no-undo .
     1171   define variable v-upper-code as integer no-undo .
     1172   define variable v-root-code as integer no-undo .
     1173   define variable v-entry as character no-undo .
     1174   define buffer buf_gds-grp       for ub.gds-grp.
     1175   do
     1176   on error undo, return error
     1177   :
     1178     find first buf_gds-grp no-lock
     1179         where buf_gds-grp.upper-code = 0
     1180     no-error .
     1181     if not available buf_gds-grp
     1182     then do:
     1183         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1184     end.
     1185     else do:
     1186       assign
     1187       v-root-code = buf_gds-grp.node-code
     1188       .
     1189     end.
     1190     v-upper-code = v-root-code.
     1191     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1192       assign
     1193       v-entry = entry(v-ii, p-full-name, chr(47)).
     1194       if v-entry = '' then leave.
     1195       find first buf_gds-grp no-lock where
     1196                 buf_gds-grp.node-name = v-entry
     1197             and buf_gds-grp.upper-code = v-upper-code
     1198             no-error.
     1199       if not available buf_gds-grp then do:
     1200         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1201       end.
     1202       else do:
     1203         p-node-code = buf_gds-grp.node-code.
     1204         v-upper-code = buf_gds-grp.node-code.
     1205       end.
     1206     end.
     1207   end.
     1208   end .
     1209   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1210   define variable v-waitfram-action01         as character   no-undo .
     1211   define variable v-waitfram-action02         as character   no-undo .
     1212   define variable v-waitfram-action03         as character   no-undo .
     1213   define variable mWaitFramTextBeg            as character   no-undo.
     1214   define variable mWaitFramTextEnd            as character   no-undo.
     1215   define variable mWaitFramView               as logical     no-undo.
     1216   define variable mWaitProcEvent              as logical     no-undo init yes.
     1217   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1218   define variable mWaitFramStop               as logical     no-undo.
     1219   define variable mWaitFramStopUser           as logical     no-undo.
     1220   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1221   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1222   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1223   define button B-WaitFramStop auto-end-key
     1224        label "Стоп"
     1225        size 10 by 1 tooltip "Остоновить процесс".
     1226   define button B-viewProcInfo
     1227        label "Информация"
     1228        size 15 by 1 tooltip "Информация о процесс".
     1229   define frame waitfram
     1230     v-waitfram-action01 format "x(72)" no-label skip
     1231     v-waitfram-action02 format "x(72)" no-label skip
     1232     v-waitfram-action03 format "x(72)" no-label skip
     1233     B-viewProcInfo
     1234     B-WaitFramStop at row 4 col 30
     1235     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1236     .
     1237   define new global shared variable mBatchMode as logical no-undo init ?.
     1238   define variable mFramBachModHandle as handle no-undo.
     1239   mFramBachModHandle = frame waitfram:handle.
     1240   define variable mFameOldVis as logical no-undo.
     1241   define variable mVisCUrentVin as logical no-undo.
     1242   if session:batch-mode
     1243   then
     1244      mBatchMode = yes.
     1245   if mBatchMode = ? then do:
     1246     mVisCUrentVin = current-window:visible.
     1247     mFameOldVis = mFramBachModHandle:visible.
     1248     mFramBachModHandle:visible  = yes.
     1249     mBatchMode = mFramBachModHandle:visible ne yes.
     1250     mFramBachModHandle:visible = mFameOldVis.
     1251     current-window:visible = mVisCUrentVin.
     1252   end.
     1253    if  log-manager:logfile-name ne ?
     1254     then DO:
     1255         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1256         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1257         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1258     end.
     1259   on choose of B-WaitFramStop in frame waitfram
     1260   do:
     1261     mWaitFramStop = yes.
     1262     mWaitFramStopUser = yes.
     1263   end.
     1264   function waitfram-check-timeout returns logical():
     1265      define variable vtime as int64 no-undo.
     1266      if mWaitFramStopTimeOut
     1267      then
     1268         return yes.
     1269      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1270      if     mWaitFramTimeOut ne ?
     1271         and mWaitFramTimeOut ne 0
     1272         and mWaitFramTimeOut lt vtime
     1273      then do:
     1274         mWaitFramStopTimeOut = yes.
     1275      end.
     1276      return mWaitFramStopTimeOut.
     1277   end.
     1278   procedure waitfram-hide :
     1279     if not session:batch-mode
     1280     then do
     1281     on error undo, return error return-value
     1282     :
     1283       pause 0 before-hide .
     1284       if not mBatchMode then
     1285         hide frame waitfram .
     1286     if     not mWaitFramView
     1287        and mWaitProcEvent
     1288     then
     1289       process events .
     1290     end.
     1291   end procedure.
     1292   procedure waitfram-show :
     1293     define input  parameter p-message as character no-undo .
     1294     define variable v-left-margin as integer   no-undo .
     1295     if not session:batch-mode
     1296     then do
     1297     on error undo, return error return-value
     1298     :
     1299       if length(p-message) <= 70 then do:
     1300         assign
     1301           v-left-margin = integer((70 - length(p-message)) / 2)
     1302         .
     1303         assign
     1304           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1305         .
     1306         assign
     1307           v-waitfram-action01 = " "
     1308           v-waitfram-action02 = " "
     1309                                    + fill(" ", v-left-margin)
     1310                                    + p-message
     1311           v-waitfram-action03 = " "
     1312         .
     1313       end.
     1314       else do:
     1315         define variable vRindex1 as integer no-undo.
     1316         define variable vRindex2 as integer no-undo.
     1317         vRindex1 = r-index(p-message," ",70).
     1318         if vRindex1 = 0
     1319         then
     1320            vRindex1 = 70.
     1321         if length(p-message)  <= vRindex1 + 70 then do:
     1322           assign
     1323             v-waitfram-action01 = " "
     1324             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1325             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1326           .
     1327         end.
     1328         else do:
     1329           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1330           if vRindex2 <= vRindex1
     1331           then
     1332              vRindex2 = vRindex1 + 70.
     1333           assign
     1334             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1335             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1336             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1337           .
     1338         end.
     1339       end.
     1340       B-viewProcInfo:visible   in frame waitfram = no.
     1341       B-viewProcInfo:sensitive in frame waitfram = no.
     1342       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1343       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1344       if  (   mWaitFramView
     1345          or  mWaitProcEvent)
     1346          and not mBatchMode
     1347       then
     1348          display
     1349             v-waitfram-action01 skip
     1350             v-waitfram-action02 skip
     1351             v-waitfram-action03 skip
     1352          with frame waitfram .
     1353       if     mWaitFramView
     1354          then do:
     1355             if     mWaitFramInterval ne ?
     1356                and not mBatchMode
     1357             then
     1358                wait-for go of frame waitfram pause mWaitFramInterval.
     1359          end.
     1360          else
     1361             if     mWaitProcEvent
     1362                and not mBatchMode
     1363             then
     1364                process events .
     1365     end.
     1366   end procedure.
     1367      procedure waitfram-show-this:
     1368         define input  parameter iInterval as int64 no-undo.
     1369         define variable vtime as int64 no-undo.
     1370         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1371         mWaitFramInterval = iInterval.
     1372         run waitfram-show (substitute("&1&2 &3&4" ,
     1373                                       mWaitFramTextBeg ,
     1374                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1375                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1376                                       mWaitFramTextEnd
     1377                                      )
     1378                           ).
     1379      end.
     1380      procedure WaitFramRunPause:
     1381         define input  parameter iInterval as dec no-undo.
     1382         define variable vStart  as datetime-tz no-undo.
     1383         define variable vend    as datetime-tz no-undo.
     1384         define variable vint as int64 no-undo.
     1385         define variable vOk as logical no-undo.
     1386         vStart = now.
     1387         vend   = vStart.
     1388         publish "WaitFramPause" (iInterval,output vOk).
     1389         vend   =  now.
     1390         vint = vend - vStart.
     1391         vint = iInterval - vint / 1000.
     1392         if     not mWaitFramStop
     1393            and (   vint > 0
     1394                 or (    not vOk
     1395                     and iInterval eq ?
     1396                     )
     1397                 )
     1398         then
     1399            run waitfram-show-this (iInterval).
     1400         vend   =  now.
     1401         vint = vend - vStart.
     1402         vint = iInterval - vint / 1000.
     1403         if     not mWaitFramStop
     1404            and vint > 0
     1405         then do:
     1406            run gbl/pause.p (vint * 1000).
     1407         end.
     1408         if iInterval ne ?
     1409         then
     1410            publish "WaitFramStop".
     1411         waitfram-check-timeout().
     1412      end.
     1413      procedure WaitFramWaitFor:
     1414         define input  parameter iInterval as dec no-undo.
     1415         assign
     1416            mWaitFramStartProc   = now
     1417            mWaitFramStopUser    = no
     1418            mWaitFramStopTimeOut = no
     1419         .
     1420         block-wait:
     1421         do while not mWaitFramStop:
     1422            run WaitFramRunPause (iInterval).
     1423            if  waitfram-check-timeout()
     1424            then do:
     1425               leave block-wait.
     1426            end.
     1427         end.
     1428         run waitfram-hide.
     1429      end.
     1430   procedure waitfram-join :
     1431     define input  parameter p-line-1  as character no-undo .
     1432     define input  parameter p-line-2  as character no-undo .
     1433     define input  parameter p-line-3  as character no-undo .
     1434     define output parameter p-message as character no-undo .
     1435     do
     1436     on error undo, return error return-value
     1437     :
     1438       assign
     1439         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1440                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1441                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1442       .
     1443     end.
     1444   end procedure.
     1445   function waitfram-join-function returns character
     1446     (input p-line-1 as character
     1447     ,input p-line-2 as character
     1448     ,input p-line-3 as character
     1449     ).
     1450     define variable v-message as character no-undo .
     1451     run waitfram-join in this-procedure
     1452       (input  p-line-1
     1453       ,input  p-line-2
     1454       ,input  p-line-3
     1455       ,output v-message
     1456       ) .
     1457     return v-message .
     1458   end function .
     1459   define variable vss-include-info14 as character format "X(65)" no-undo
     1460   initial "@(#)$Workfile$ $Revision$".
