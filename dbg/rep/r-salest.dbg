      190     index ie2 obj-name
      191   .
      192   procedure create_obj-list :
      193      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      194      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      195      do
      196      on error undo, return error return-value
      197      :
      198         define buffer cli-obj for ub.clients .
      199         define variable p-var as integer no-undo .
      200         define buffer buf_obj-list for obj-list .
      201         find last buf_obj-list  use-index pi no-error .
      202         if available buf_obj-list
      203         then
      204            p-var = buf_obj-list.obj-id + 1.
      205         else
      206            p-var = 1.
      207         find first cli-obj where
      208                   cli-obj.obj-type = p-obj-type
      209               and cli-obj.obj-code = p-obj-code
      210         no-lock no-error.
      211         if available cli-obj
      212         then do:
      213            create buf_obj-list.
      214            assign
      215               buf_obj-list.obj-id   = p-var
      216               buf_obj-list.obj-code = cli-obj.obj-code
      217               buf_obj-list.obj-type = cli-obj.obj-type
      218               buf_obj-list.obj-name = cli-obj.obj-name
      219               buf_obj-list.db-num   = cli-obj.db-num
      220            .
      221         end.
      222      end.
      223   end.
