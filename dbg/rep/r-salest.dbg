      180   def
      181    shared
      182   temp-table  obj-list no-undo
      183     field obj-type like ub.clients.obj-type
      184     field obj-code like ub.clients.obj-code
      185     field obj-name like ub.clients.obj-name
      186     field obj-id   as integer
