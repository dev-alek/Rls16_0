     1495   define variable v-salest-data-file-name       as character    no-undo.
     1496   procedure salest-init :
     1497   do
     1498   on error undo, return error
     1499   :
     1500       assign
     1501           v-salest-sheet1-cur-data-row = 0
     1502       .
     1503       run gbl/_tmpfile.p (
     1504             input "xd"
     1505           , input ".txt"
     1506           , output v-salest-data-file-name
     1507       ).
     1508       output stream excel-line to value( v-salest-data-file-name ).
     1509       run gbl/_tmpfile.p (
     1510             input "xc"
     1511           , input ".txt"
     1512           , output v-salest-cell-file-name
     1513       ).
     1514       output stream excel-cell to value( v-salest-cell-file-name ).
     1515       run salest-write-cell-data in this-procedure (
     1516             input "sheetList":U
     1517           , input "Template":U
     1518       ).
     1519       if printrubl
     1520       then do:
     1521           run salest-write-cell-data in this-procedure (
     1522                 input "Template_valutCode":U
     1523               , input "0":U
     1524           ).
     1525       end.
     1526       else do:
     1527           run salest-write-cell-data in this-procedure (
     1528                 input "Template_valutCode":U
     1529               , input "1":U
     1530           ).
     1531       end.
     1532       run salest-write-cell-data in this-procedure (
     1533             input "Template_columnList":U
     1534           , input "number,grp_name,supp_name,summ_cost,supp_perc,grp_summ_cost,grp_perc,grp_marg":U
     1535       ).
     1536       run salest-write-cell-data in this-procedure (
     1537             input "Template_columnType":U
     1538           , input "S,S,S,S,S,S,S":U
     1539       ).
     1540       run salest-write-cell-data in this-procedure (
     1541             input "Template_subtotalList":U
     1542           , input "":U
     1543       ).
     1544       run salest-write-cell-data in this-procedure (
     1545             input "Template_subtotalType":U
     1546           , input "":U
     1547       ).
     1548   end.
     1549   end procedure.
     1550   procedure salest-sheet1-write-line-data :
     1551   define buffer buf_tt-line     for tt-line .
     1552   define variable v-total-supp    as decimal  format "->>>>>9.99"     no-undo.
     1553   define variable v-number    as integer      no-undo.
     1554   define variable v-grp-name    as character    no-undo.
     1555   do
     1556   on error undo, return error
     1557   :
     1558      for each buf_tt-line
     1559          break by buf_tt-line.grp-code
     1560                by supp-type
     1561                by supp-code
     1562         :
     1563            IF FIRST-OF(buf_tt-line.grp-code)
     1564            THEN DO:
     1565               FIND FIRST tt-total
     1566                    where tt-total.grp-code = buf_tt-line.grp-code
     1567                    .
     1568               assign
     1569                  v-number = v-number + 1
     1570               v-grp-name = buf_tt-line.grp-name
     1571               .
     1572            END.
     1573         IF buf_tt-line.prod-summ-sale <> 0
     1574         THEN DO:
     1575               put stream excel-line unformatted
     1576                                    "Template":U
     1577                     CHR(9)   "DTA":U
     1578                     CHR(9)   " "
     1579                  CHR(9)   v-grp-name
     1580                     CHR(9)   buf_tt-line.supp-name
     1581                  CHR(9)   STRING(buf_tt-line.prod-summ-sale, "->>>,>>>,>>9")
     1582                  CHR(9)   IF (buf_tt-line.prod-summ-sale / tt-total.grp-summ-sale * 100) <> ? THEN buf_tt-line.prod-summ-sale / tt-total.grp-summ-sale * 100 ELSE 0
     1583                  CHR(9)   " "
     1584                  CHR(9)   " "
     1585                  CHR(9)   " "
     1586                  chr(10)
     1587            .
     1588            assign
     1589               v-grp-name = " "
     1590               .
     1591         END.
     1592         ASSIGN
     1593            v-total-supp = v-total-supp + buf_tt-line.prod-summ-sale
     1594         .
     1595         IF LAST-OF(buf_tt-line.grp-code)
     1596         THEN DO:
     1597            IF v-grp-name <> " "
     1598            THEN DO:
     1599            put stream excel-line unformatted
     1600                                 "Template":U
     1601                  CHR(9)   "DTA":U
     1602                  CHR(9)   " "
     1603                     CHR(9)   v-grp-name
     1604                     CHR(9)   " "
     1605                     CHR(9)   STRING(buf_tt-line.prod-summ-sale, "->>>,>>>,>>9")
     1606                     CHR(9)   IF (v-total-supp / tt-total.grp-summ-sale * 100) <> ? THEN v-total-supp / tt-total.grp-summ-sale * 100 ELSE 0
     1607                  CHR(9)   " "
     1608                  CHR(9)   " "
     1609                  CHR(9)   " "
     1610                     chr(10)
     1611               .
     1612               assign
     1613                  v-grp-name = " "
     1614               .
     1615            END.
     1616            put stream excel-line unformatted
     1617                                 "Template":U
     1618                  CHR(9)   "DTA":U
     1619                  CHR(9)   " "
     1620                  CHR(9)   "Итого:"
     1621                  CHR(9)   " "
     1622                  CHR(9)   " "
     1623                  CHR(9)   " "
     1624                  CHR(9)   STRING(tt-total.grp-summ-sale, "->>>,>>>,>>9")
     1625                  CHR(9)   IF (tt-total.grp-summ-sale / v-total-sale * 100) <> ? THEN tt-total.grp-summ-sale / v-total-sale * 100 ELSE 0
     1626                  CHR(9)   IF ((tt-total.grp-summ-sale - tt-total.grp-summ-cost) / tt-total.grp-summ-sale * 100) <> ? THEN (tt-total.grp-summ-sale - tt-total.grp-summ-cost) / tt-total.grp-summ-sale * 100 ELSE 0
     1627                  chr(10)
     1628            .
     1629            put stream excel-line unformatted
     1630                              "Template":U
     1631               CHR(9)  "FMT":U
     1632               CHR(9)   "h3"
     1633               chr(10)
     1634            .
     1635         END.
     1636      end.
     1637   end.
     1638   end procedure.
     1639   procedure salest-write-cell-data :
     1640   define input parameter p-data-key   as character        no-undo.
     1641   define input parameter p-data-value as character        no-undo.
     1642       define buffer buf_temp_cell-data     for temp_cell-data.
     1643   do
     1644   for buf_temp_cell-data
     1645   on error undo, return error
     1646   :
     1647       find first buf_temp_cell-data
     1648            where buf_temp_cell-data.data-key = p-data-key
     1649       no-error.
     1650       if not available buf_temp_cell-data
     1651       then do:
     1652           create buf_temp_cell-data.
     1653           assign
     1654               buf_temp_cell-data.data-key = p-data-key
     1655           .
     1656       end.
     1657       assign
     1658           buf_temp_cell-data.data-value = p-data-value
     1659       .
     1660       put stream excel-cell unformatted
     1661                           buf_temp_cell-data.data-key
     1662           CHR(9)   buf_temp_cell-data.data-value
     1663           chr(10)
     1664       .
     1665   end.
     1666   end procedure.
     1667   procedure salest-run-excel :
     1668   define input parameter p-header-filename    as character        no-undo.
     1669   define input parameter p-data-filename      as character        no-undo.
     1670   define variable v-template-file-name    as character    no-undo.
     1671   define variable v-vb-file-name          as character    no-undo.
     1672   define buffer buf_temp-param for temp-param .
     1673   do
     1674   for buf_temp-param
     1675   on error undo, return error
     1676   :
     1677       create buf_temp-param.
     1678       assign
     1679           v-template-file-name    = search( "exe/salest.xlt" )
     1680           v-vb-file-name          = search( "exe/t_form.bas" )
     1681       .
     1682       if v-template-file-name = ?
     1683       or v-template-file-name = "":U
     1684       then do:
     1685           message
     1686               "Ошибка имени файла шаблона."
     1687           view-as alert-box error.
     1688       end.
     1689       if v-vb-file-name = ?
     1690       or v-vb-file-name = "":U
     1691       then do:
     1692           message
     1693               "Ошибка имени файла кода обработки."
     1694           view-as alert-box error.
     1695       end.
     1696       run paramls-write in this-procedure (
     1697             input "template":U
     1698           , input "template-file-name":U
     1699           , input v-template-file-name
     1700       ).
     1701       run paramls-write in this-procedure (
     1702             input "template":U
     1703           , input "vb-file-name":U
     1704           , input v-vb-file-name
     1705       ).
     1706       run paramls-write in this-procedure (
     1707             input "data":U
     1708           , input "data-header-filename":U
     1709           , input p-header-filename
     1710       ).
     1711       run paramls-write in this-procedure (
     1712             input "data":U
     1713           , input "data-filename":U
     1714           , input p-data-filename
     1715       ).
     1716       run gbl/macroxlt.p (
     1717           input-output table buf_temp-param
     1718       ) no-error.
     1719       if error-status :error
     1720       then do:
     1721           message
     1722                    vss-workfile vss-revision vss-description
     1723               skip(1)
     1724               skip "Ошибка создания файла Excel."
     1725               skip return-value
     1726               skip trim(error-status :get-message(1))
     1727                    trim(error-status :get-message(2))
     1728                    trim(error-status :get-message(3))
     1729           view-as alert-box error.
     1730           undo, return error .
     1731       end.
     1732   end.
     1733   end procedure.
     1734   procedure salest-close :
     1735   do
     1736   on error undo, return error
     1737   :
     1738       output stream excel-line close.
     1739       output stream excel-cell close.
     1740       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     1741           export "exe/salest.xlt" .
     1742           export "exe/t_form.bas" .
     1743           export v-salest-cell-file-name.
     1744           export v-salest-data-file-name.
     1745       output close.
     1746   end.
     1747   end procedure.
     1748   define variable v-account as integer init 0 no-undo .
     1749   define variable v-account-lavel as character no-undo .
     1750   define variable v-button-stop as logical no-undo .
     1751   define variable v-kol-spice as integer no-undo .
     1752   define variable v-kol-spice2 as integer no-undo .
     1753   define variable v-kol-spice3 as integer no-undo .
     1754   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1755   DEFINE BUTTON StopBtn AUTO-END-KEY
     1756        LABEL "Стоп"
     1757        SIZE 10 BY 1.
     1758   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1759        LABEL "Обработано записей"
     1760         VIEW-AS TEXT
     1761        SIZE 14 BY .67 NO-UNDO.
     1762   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1763         VIEW-AS TEXT
     1764        SIZE 53.25 BY .67
     1765        FGCOLOR 1  NO-UNDO.
     1766   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1767         VIEW-AS TEXT
     1768        SIZE 53.25 BY .67
     1769        FGCOLOR 1  NO-UNDO.
     1770   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1771         VIEW-AS TEXT
     1772        SIZE 53.25 BY .67
     1773        FGCOLOR 1  NO-UNDO.
     1774   DEFINE RECTANGLE RECT-1
     1775        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1776        SIZE 55.13 BY 4.46.
     1777   DEFINE FRAME InfoFrame
     1778        StopBtn AT ROW 4.25 COL 21.75
     1779        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1780        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1781        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1782        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1783        RECT-1 AT ROW 1 COL 1
     1784       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1785            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1786            TITLE "Процесс"
     1787            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1788   define variable mFrameView      as logical   no-undo init yes.
     1789     define variable mFramHandle as handle no-undo.
     1790     mFramHandle = frame InfoFrame:handle.
     1791     if  log-manager:logfile-name ne ?
     1792     then DO:
     1793         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1794         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1795         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1796     end.
     1797     mFrameView = not session:batch-mode and mFramHandle:visible.
     1798     if mFrameView
     1799     then do:
     1800       ASSIGN
     1801          FRAME InfoFrame:HIDDEN                           = TRUE
     1802          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1803     end.
     1804   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1805   DO:
     1806     IF not StopProcessing THEN
     1807       Message "Вы действительно хотите прервать" SKIP
     1808               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1809                 UPDATE StopProcessing.
     1810     IF StopProcessing THEN do:
     1811        if mFrameView
     1812        then do:
     1813           HIDE FRAME InfoFrame.
     1814        end.
     1815     End.
     1816   END.
     1817   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1818     define variable v-cntxt-db-num        as integer   no-undo .
     1819     define variable v-cntxt-userid        as character no-undo .
     1820     define variable v-cntxt-level         as character no-undo .
     1821     define variable v-cntxt-host-code-obj as integer   no-undo .
     1822     define variable v-cntxt-obj-type      as character no-undo .
     1823     define variable v-cntxt-obj-code      as integer   no-undo .
     1824     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1825     define variable v-cntxt-is-admin      as logical   no-undo .
     1826   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1827     run mainmenu_getcntxt in parparentproc
     1828       (output v-cntxt-db-num
     1829       ,output v-cntxt-userid
     1830       ,output v-cntxt-level
     1831       ,output v-cntxt-host-code-obj
     1832       ,output v-cntxt-obj-type
     1833       ,output v-cntxt-obj-code
     1834       ,output v-cntxt-db-num-obj
     1835       ,output v-cntxt-is-admin
     1836       ) .
     1837   do
     1838   on error undo, return error
     1839   :
     1840      run fill-temp-table in this-procedure .
     1841      run open-stream     IN THIS-PROCEDURE .
     1842      run print-header    in this-procedure .
     1843      run print-body      in this-procedure .
     1844      run print-footer    in this-procedure .
     1845      run close-stream    IN THIS-PROCEDURE .
     1846   end.
     1847   procedure fill-temp-table :
     1848   define variable v-count       as integer     no-undo .
     1849   DEFINE VARIABLE v-list-doc-type-sale  AS CHAR    NO-UNDO.
     1850   DEFINE VARIABLE v-list-doc-type-ret AS CHAR    NO-UNDO.
     1851   DEFINE VARIABLE v-doc-type      AS INTEGER NO-UNDO.
     1852   define variable v-fact-order-start  as decimal              no-undo .
     1853   define variable v-fact-order-end    as decimal              no-undo .
     1854   define variable v-empty-1           as decimal      no-undo.
     1855   define variable v-empty-2           as decimal      no-undo.
     1856   define variable v-curr-grp-name    as character    no-undo.
     1857   define variable v-doc-num     as character      no-undo.
     1858   define variable v-dprice-sale as decimal      no-undo.
     1859   define variable v-droad-tax   as decimal      no-undo.
     1860   define variable v-dexcise     as decimal      no-undo.
     1861   define buffer buf_clients    for ub.clients .
     1862   define buffer prod_clients   for ub.clients .
     1863   define buffer buf_doc-line   for ub.doc-line .
     1864   define buffer buf_ot-supp-line    for ub.ot-supp-line .
     1865   define buffer buf_goods      for ub.goods .
     1866   define buffer buf_parts      for ub.parts .
     1867   define buffer buf_stk-line       for ub.stk-line .
     1868   define buffer buf_gds-obj     for ub.gds-obj .
     1869   do
     1870   on error undo, return error
     1871   :
     1872      CASE X-Radio-Task  :
     1873      WHEN 3 THEN DO:
     1874         run factord IN THIS-PROCEDURE
     1875                     ( INPUT X-date-start
     1876                     , INPUT 0
     1877                     , INPUT 1
     1878                     , INPUT X-date-start
     1879                     , INPUT X-shift-Start
     1880                     , INPUT yes
     1881                     , OUTPUT v-fact-order-start
     1882                     , OUTPUT v-empty-1
     1883                     , OUTPUT v-empty-2
     1884                     ) .
     1885         run factord IN THIS-PROCEDURE
     1886                     ( INPUT X-date-end
     1887                     , INPUT 0
     1888                     , INPUT 1
     1889                     , INPUT X-date-end
     1890                     , INPUT X-shift-end + 1
     1891                     , INPUT yes
     1892                     , OUTPUT v-fact-order-end
     1893                     , OUTPUT v-empty-1
     1894                     , OUTPUT v-empty-2
     1895                     ) .
     1896      END.
     1897      WHEN 4 THEN DO:
     1898         return.
     1899      END.
     1900      WHEN 1 OR
     1901      WHEN 2
     1902      THEN DO:
     1903         run factord-end-day IN THIS-PROCEDURE
     1904                  ( input  x-date-start - 1
     1905                  , output v-fact-order-start
     1906                  ) .
     1907         run factord-end-day IN THIS-PROCEDURE
     1908                  ( input x-date-end
     1909                  , output v-fact-order-end
     1910                  ) .
     1911      END.
     1912      END CASE.
     1913      for each tmp#grp
     1914            no-lock
     1915            :
     1916         run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     1917         FIND FIRST tt-total
     1918               WHERE tt-total.grp-code  = tmp#grp.node-code
     1919               NO-ERROR
     1920               .
     1921         IF NOT AVAILABLE tt-total THEN DO:
     1922            CREATE tt-total.
     1923            ASSIGN
     1924               tt-total.grp-code  = tmp#grp.node-code
     1925            .
     1926         END.
     1927         FOR EACH obj-list
     1928            NO-lock
     1929            ,
     1930            each buf_gds-obj no-lock
     1931            where buf_gds-obj.grp-name begins v-curr-grp-name
     1932              AND buf_gds-obj.obj-type = obj-list.obj-type
     1933              AND buf_gds-obj.obj-code = obj-list.obj-code
     1934         :
     1935            DO v-count = 1 TO NUM-ENTRIES(p-supp-list)
     1936            :
     1937               find first buf_clients
     1938                  where recid( buf_clients ) = INTEGER(ENTRY(v-count, p-supp-list))
     1939                  NO-LOCK
     1940                  no-error.
     1941               IF NOT AVAILABLE buf_clients
     1942               THEN DO:
     1943                  NEXT.
     1944               END.
     1945               FIND FIRST tt-line
     1946                  WHERE tt-line.grp-code  = tmp#grp.node-code
     1947                     AND tt-line.supp-type = buf_clients.obj-type
     1948                     AND tt-line.supp-code = buf_clients.obj-code
     1949                  NO-ERROR
     1950                  .
     1951               IF NOT AVAILABLE tt-line THEN DO:
     1952                  CREATE tt-line.
     1953                  ASSIGN
     1954                     tt-line.grp-code  = tmp#grp.node-code
     1955                     tt-line.supp-type = buf_clients.obj-type
     1956                     tt-line.supp-code = buf_clients.obj-code
     1957                     tt-line.supp-name = buf_clients.obj-name
     1958                     tt-line.grp-name  = TRIM(tmp#grp.grp-name, "/")
     1959                  .
     1960               END.
     1961                     FOR  EACH  buf_ot-supp-line
     1962                  where   buf_ot-supp-line.artic        = buf_gds-obj.artic
     1963                     and  buf_ot-supp-line.prod-code    = buf_gds-obj.prod-code
     1964                     and  buf_ot-supp-line.prod-type    = buf_gds-obj.prod-type
     1965                           and  buf_ot-supp-line.cli-type     = tt-line.supp-type
     1966                           and  buf_ot-supp-line.cli-code     = tt-line.supp-code
     1967                           and  buf_ot-supp-line.fact-order   < v-fact-order-end
     1968                           and  buf_ot-supp-line.fact-order   >  v-fact-order-start
     1969                           and  buf_ot-supp-line.obj-code     = obj-list.obj-code
     1970                           and  buf_ot-supp-line.obj-type     = obj-list.obj-type
     1971                           and  buf_ot-supp-line.sum-type     = 'cost':U
     1972                     and  (  buf_ot-supp-line.ext-doc-type = 'es':U
     1973                           OR buf_ot-supp-line.ext-doc-type = 'ee':U
     1974                           )
     1975                        NO-LOCK
     1976                            :
     1977   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1978   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1979     (input  buf_gds-obj.obj-type
     1980     ,input  buf_gds-obj.obj-code
     1981     ,input  buf_gds-obj.gds-code
     1982     ,input  0
     1983     ,input  buf_ot-supp-line.fact-order
     1984     ,output v-doc-num
     1985     ,output v-dprice-sale
     1986     ,output v-droad-tax
     1987     ,output v-dexcise
     1988     ) no-error .
     1989                           ASSIGN
     1990                              tt-line.prod-summ-cost = tt-line.prod-summ-cost - buf_ot-supp-line.sum-rubl / 1000
     1991                              tt-total.grp-summ-cost = tt-total.grp-summ-cost - buf_ot-supp-line.sum-rubl / 1000
     1992                              tt-line.prod-summ-sale = tt-line.prod-summ-sale - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     1993                              tt-total.grp-summ-sale = tt-total.grp-summ-sale - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     1994                              v-total-sale           = v-total-sale           - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     1995                           .
     1996                     END.
     1997                     FOR  EACH  buf_ot-supp-line
     1998                  where   buf_ot-supp-line.artic        = buf_gds-obj.artic
     1999                     and  buf_ot-supp-line.prod-code    = buf_gds-obj.prod-code
     2000                     and  buf_ot-supp-line.prod-type    = buf_gds-obj.prod-type
     2001                           and  buf_ot-supp-line.cli-type     = tt-line.supp-type
     2002                           and  buf_ot-supp-line.cli-code     = tt-line.supp-code
     2003                           and  buf_ot-supp-line.fact-order   < v-fact-order-end
     2004                           and  buf_ot-supp-line.fact-order   >  v-fact-order-start
     2005                           and  buf_ot-supp-line.obj-code     = obj-list.obj-code
     2006                           and  buf_ot-supp-line.obj-type     = obj-list.obj-type
     2007                           and  buf_ot-supp-line.sum-type     = 'cost':U
     2008                     and  (  buf_ot-supp-line.ext-doc-type = 'rs':U
     2009                           OR buf_ot-supp-line.ext-doc-type = 're':U
     2010                           )
     2011                        NO-LOCK
     2012                            :
     2013   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2014   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2015     (input  buf_gds-obj.obj-type
     2016     ,input  buf_gds-obj.obj-code
     2017     ,input  buf_gds-obj.gds-code
     2018     ,input  0
     2019     ,input  buf_ot-supp-line.fact-order
     2020     ,output v-doc-num
     2021     ,output v-dprice-sale
     2022     ,output v-droad-tax
     2023     ,output v-dexcise
     2024     ) no-error .
     2025                           ASSIGN
     2026                              tt-line.prod-summ-cost = tt-line.prod-summ-cost - buf_ot-supp-line.sum-rubl / 1000
     2027                              tt-total.grp-summ-cost = tt-total.grp-summ-cost - buf_ot-supp-line.sum-rubl / 1000
     2028                              tt-line.prod-summ-sale = tt-line.prod-summ-sale - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     2029                              tt-total.grp-summ-sale = tt-total.grp-summ-sale - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     2030                              v-total-sale           = v-total-sale           - buf_ot-supp-line.fact-qnty * v-dprice-sale / 1000
     2031                           .
     2032                     END.
     2033            END.
     2034            end.
     2035      end.
     2036   end.
     2037   end procedure.
     2038   procedure open-stream :
     2039   do
     2040   on error undo, return error
     2041   :
     2042      run get-report-num in parparentproc (output g#report-num).
     2043   if session :set-wait-state( "compiler" ) then.
     2044   output stream out-stream to value( string( session:temp-directory +
     2045                                        "rpt" + string( g#report-num ) ) )
     2046                                        page-size  value(62) .
     2047      put stream out-stream unformatted
     2048            chr(10)
     2049         + "Печатная форма предназначена только для вывода в Microsoft Excel."
     2050         + chr(10)
     2051      .
     2052      output stream out-stream close.
     2053      run salest-init in this-procedure.
     2054   end.
     2055   end procedure.
     2056   procedure print-header :
     2057   do
     2058   on error undo, return error
     2059   :
     2060   end.
     2061   end procedure.
     2062   procedure print-body :
     2063   do
     2064   on error undo, return error
     2065   :
     2066      run salest-sheet1-write-line-data in this-procedure .
     2067   end.
     2068   end procedure.
     2069   procedure print-footer :
     2070   do
     2071   on error undo, return error
     2072   :
     2073   end.
     2074   end procedure.
     2075   procedure close-stream :
     2076   do
     2077   on error undo, return error
     2078   :
     2079      output stream out-stream close.
     2080      run salest-close in this-procedure .
     2081   if mFrameView
     2082   then do:
     2083      HIDE FRAME InfoFrame.
     2084   end.
     2085   if session :set-wait-state( "" ) then.
     2086      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2087      os-rename
     2088         value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     2089         value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     2090      .
     2091      define variable v-user-action   as character no-undo .
     2092      define variable v-printed       as logical   no-undo .
     2093      define variable DisabledOptions as integer   no-undo .
     2094      define variable v-orient-page as character no-undo .
     2095      run gbl/prnfilen.w   ( input "":U
     2096                           , input 20
     2097                           , input string(session :temp-directory) + "rpt" + string( g#report-num )
     2098                           , input ReportFontNum
     2099                           , output v-user-action
     2100                           , output v-printed
     2101                           ) .
     2102      os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     2103   end.
     2104   end procedure.
