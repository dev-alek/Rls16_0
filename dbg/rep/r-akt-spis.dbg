      793   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      794   define  stream PrnLibStream.
      795   procedure prn-lib-prn-file :
      796     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      797     define input parameter p-DIsabledoptions as integer no-undo .
      798     define variable v-report-name as character no-undo .
      799     define variable v-user-action as character no-undo .
      800     define variable v-printed     as logical   no-undo .
      801     define variable v-exist       as logical   no-undo .
      802     do
      803       on error undo, return error
      804       :
      805       run prn-lib-get-report-name  in this-procedure (
      806         input parParentProc
      807         ,output v-report-name
      808         ).
      809   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      811     (input  v-report-name
      812     ,input  2
      813     ,output v-exist
      814     )  .
      815       if NOT v-exist then
      816       DO:
      817         Message
      818           "Нет заданий на печать ! "
      819           view-as alert-box .
      820         Return  .
      821       End.
      822       run gbl/prnfilen.w
      823         (input  ""
      824         ,input  p-DisabledOptions
      825         ,input  string(v-report-name )
      826         ,input  7
      827         ,output v-user-action
      828         ,output v-printed
      829         ) .
      830       if v-printed then
      831       do:
      832         return "YES" .
      833       end.
      834       else
      835       do:
      836         return "NO" .
      837       end.
      838     end.
      839   end procedure.
      840   procedure prn-lib-open-stream :
      841     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      842     define input parameter p-page-size    as integer no-undo .
      843     define input parameter p-is-stream    as logical no-undo .
      844     define input parameter p-append       as logical no-undo .
      845     define variable v-report-name as character no-undo .
      846     do
      847       on error undo, return error
      848       :
      849       run prn-lib-get-report-name  in this-procedure (
      850         input parParentProc
      851         ,output v-report-name
      852         ).
      853       if p-is-stream then
      854       do:
      855         if p-append then
      856         do:
      857           output stream PrnLibStream to value( v-report-name )
      858             page-size value(p-page-size) append .
      859         end.
      860         if not p-append then
      861         do:
      862           output stream PrnLibStream to value( v-report-name )
      863             page-size value(p-page-size) .
      864         end.
      865       end.
      866       if not p-is-stream then
      867       do:
      868         if p-append then
      869         do:
      870           output to value( v-report-name )
      871             page-size value(p-page-size) append .
      872         end.
      873         if not p-append then
      874         do:
      875           output to value( v-report-name )
      876             page-size value(p-page-size) .
      877         end.
      878       end.
      879     end.
      880   end procedure.
      881   procedure prn-lib-open-exp :
      882     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      883     define input parameter p-is-stream    as logical no-undo .
      884     define input parameter p-is-append    as logical no-undo .
      885     define output parameter p-ReportFileName as char init "report" no-undo.
      886     define output parameter p-process as logical no-undo .
      887     define variable glog as logical no-undo .
      888     do
      889       on error undo, return error
      890       :
      891       SYSTEM-DIALOG GET-FILE p-ReportFileName
      892         TITLE      "Укажите путь"
      893         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      894         ASK-OVERWRITE
      895         CREATE-TEST-FILE
      896         SAVE-AS
      897         USE-FILENAME
      898         DEFAULT-EXTENSION "txt"
      899         UPDATE glog
      900         .
      901       if not glog then  return.
      902       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      903       if p-is-stream then
      904       do:
      905         if p-is-append then
      906         do:
      907           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      908         end.
      909         else
      910         do:
      911           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      912         end.
      913       end.
      914       else
      915       do:
      916         if p-is-append then
      917         do:
      918           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      919         end.
      920         else
      921         do:
      922           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      923         end.
      924       end.
      925       p-process = yes.
      926     end.
      927   end procedure.
      928   procedure prn-lib-get-report-name :
      929     define input parameter parParentProc  as widget-handle no-undo.
      930     define output parameter p-report-name as character no-undo .
      931     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      932   end procedure.
      933   procedure prn-lib-reportviewer-report-name :
      934     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      935     define input parameter p-report-name-html as character no-undo .
      936     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      937   end procedure.
      938   procedure prn-lib-reportviewer :
      939     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      940     define input parameter p-report-name-html as character no-undo .
      941     define input parameter p-param        as character no-undo .
      942     define variable v-excel           as character no-undo init 'TRUE' .
      943     define variable v-value-character as character no-undo .
      944     define variable v-value-integer   as character no-undo .
      945     define variable v-value-date      as date      no-undo .
      946     define variable v-value-decimal   as decimal   no-undo .
      947     define variable rep-excel         as logical   no-undo .
      948     define variable excel-string      as character no-undo .
      949     define variable v-param-type      as character no-undo .
      950     define variable v-tth             as handle    no-undo .
      951     run adm/shattri.p (
      952       input "get":U
      953       ,input  ""
      954       ,input  0
      955       ,input  'report-glob':U
      956       ,input  'rep-excel':U
      957       ,output v-value-character
      958       ,output v-value-date
      959       ,output v-value-decimal
      960       ,output v-value-integer
      961       ,output rep-excel
      962       ,output v-param-type
      963       ,INPUT-OUTPUT table-handle v-tth
      964       )  .
      965     if rep-excel then v-excel = "TRUE" .
      966     else v-excel = "FALSE" .
      967     if p-param eq ""
      968     then
      969        p-param = "EXCEL:" + v-excel.
      970     else
      971        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      972     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      973   end procedure.
      974   function fnc-convert-dot-to-colon returns character
      975       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      976   function fnc-convert-dot-to-colon returns character
      977   (input p-data as decimal, input p-accur as character, input p-num as integer):
      978       define variable result as character no-undo.
      979       define variable v-str-result as character no-undo.
      980       if p-data = ? then p-data = 0 .
      981       p-data = round(p-data, p-num).
      982       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      983       return v-str-result.
      984   END FUNCTION.
      985   define input parameter p-doc-code as char no-undo.
      986   define buffer t-doc for trn-doc.
      987   define VARIABLE p-report-id         as character no-undo .
      988   define variable v-file-name-rep-htm as character no-undo .
      989   define stream  macr_excel .
      990   define stream  out-stream .
      991   define stream OutStr-html.
      992   define variable v-month-rus as character no-undo.
      993   define variable v-DD-Month-YYYY as character no-undo.
      994   find first chk-doc no-lock
      995       where chk-doc.doc-code = p-doc-code no-error.
      996         find first clients where clients.obj-code = chk-doc.obj-code and clients.obj-type = chk-doc.obj-type no-lock no-error.
      997   FOR EACH chk-gds NO-LOCK Where
      998       chk-gds.doc-code = chk-doc.doc-code by chk-gds.line-num:
      999       FIND FIRST bar-code No-LOCK WHERE
     1000           bar-code.b-code = chk-gds.b-code NO-ERROR.
     1001       IF AVAIL bar-code then
