     1245   run prn-lib-reportviewer-report-name in this-procedure (
     1246       input THIS-PROCEDURE
     1247       ,input v-file-name-rep-htm
     1248       ).
     1249      procedure get-DD-Month-YYYY:
     1250       define input parameter p-dat-date as date no-undo.
     1251       define output parameter p-str-date as character no-undo.
     1252       define variable v-str-date  as character no-undo.
     1253       define variable v-str-day   as character no-undo.
     1254       define variable v-num-month as character no-undo.
     1255       define variable v-str-month as character no-undo.
     1256       define variable v-str-year  as character no-undo.
     1257       v-str-date = string(p-dat-date).
     1258       do:
     1259           v-str-day = string(entry(1, v-str-date, "/")).
     1260       end.
     1261       do:
     1262           v-num-month = entry(2, v-str-date, "/").
     1263           v-str-month = MonthNameRusCase(integer(v-num-month), 2).
     1264       end.
     1265       do:
     1266           v-str-year = string(year(p-dat-date)).
     1267       end.
     1268       p-str-date = '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
     1269   end procedure.
     1270   procedure get-full-path-RepViewer:
     1271       define output parameter p-fill-path-RepView as character no-undo.
     1272       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     1273       do:
     1274           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     1275       end.
     1276       else
     1277       do:
     1278           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     1279       end.
     1280   end procedure.
     1281   procedure search-full-path-Report:
     1282       define input parameter p-file-name as character no-undo.
     1283       if search(p-file-name) = ? then
     1284       do:
     1285           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     1286       end.
     1287       else
     1288       do:
     1289           p-file-name = search(p-file-name).
     1290       end.
     1291   end procedure.
     1292   procedure create-file:
     1293       define input parameter p-file-name as character no-undo.
     1294       output to value(string(p-file-name)).
     1295       output close.
     1296   end procedure.
     1297   procedure Report-Viewer:
     1298       define input parameter p-full-path-RepView as character no-undo.
     1299       define input parameter p-file-name-rep-htm as character no-undo.
     1300       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     1301   end procedure.
     1302   PROCEDURE get-report-num :
     1303       define output parameter p-report-num as integer no-undo .
     1304       do
     1305           on error undo, return error return-value
     1306           :
     1307           run gbl/getrpnum.p (output p-report-num).
     1308       end.
     1309   END PROCEDURE.
