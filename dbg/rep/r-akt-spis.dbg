      103   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      104                                     iInput AS INTEGER).
      105     def var v-start-print as integer no-undo .
      106     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      107     assign
      108       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      109     .
      110     RETURN v-start-print .
      111   END FUNCTION.
      112   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      113                                     iInput AS INTEGER).
      114     def var v-start-print as integer no-undo .
      115     assign
      116       v-start-print = INTEGER(iEndPix - 1 - iInput)
      117     .
      118     if v-start-print < 0 then return 0.
      119     RETURN v-start-print .
      120   END FUNCTION.
      121   def var vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      123   procedure paramls-clear :
      124     define buffer buf_temp-param for temp-param .
      125     do
      126     on error undo, return error return-value
      127     :
      128       for each buf_temp-param
      129       on error undo, return error
      130       :
      131         delete buf_temp-param .
      132       end.
      133     end.
      134   end procedure.
      135   procedure paramls-write :
      136     define input  parameter p-code     as character no-undo .
      137     define input  parameter p-sub-code as character no-undo .
      138     define input  parameter p-value    as character no-undo .
      139     define buffer buf_temp-param for temp-param .
      140     do
      141     on error undo, return error return-value
      142     :
      143       find first buf_temp-param
      144         where buf_temp-param.param-code     = p-code
      145           and buf_temp-param.param-sub-code = p-sub-code
      146         no-error .
      147       if not available buf_temp-param then do:
      148         create buf_temp-param .
      149         assign
      150           buf_temp-param.param-code     = p-code
      151           buf_temp-param.param-sub-code = p-sub-code
      152         .
      153       end.
      154       assign
      155         buf_temp-param.param-value = p-value
      156       .
      157     end.
      158   end procedure.
      159   procedure paramls-read :
      160     define input  parameter p-code          as character no-undo .
      161     define input  parameter p-sub-code      as character no-undo .
      162     define input  parameter p-default-value as character no-undo .
      163     define output parameter p-value         as character no-undo .
      164     define buffer buf_temp-param for temp-param .
      165     do
      166     on error undo, return error return-value
      167     :
      168       find first buf_temp-param
      169         where buf_temp-param.param-code     = p-code
      170           and buf_temp-param.param-sub-code = p-sub-code
      171         no-error .
      172       if available buf_temp-param then do:
      173         assign
      174           p-value = buf_temp-param.param-value
      175         .
      176       end.
      177       else do:
      178         assign
      179           p-value = p-default-value
      180         .
      181       end.
      182     end.
      183   end procedure.
      184   procedure paramls-append :
      185     define input  parameter p-code     as character no-undo .
      186     define input  parameter p-sub-code as character no-undo .
      187     define input  parameter p-value    as character no-undo .
      188     define buffer buf_temp-param for temp-param .
      189     do
      190     on error undo, return error return-value
      191     :
      192       find first buf_temp-param
      193            where buf_temp-param.param-code     = p-code
      194              and buf_temp-param.param-sub-code = p-sub-code
      195         no-error .
      196       if not available buf_temp-param then do:
      197         create buf_temp-param .
      198         assign
      199           buf_temp-param.param-code     = p-code
      200           buf_temp-param.param-sub-code = p-sub-code
      201           buf_temp-param.param-value    = p-value
      202         .
      203       end.
      204       else do:
      205           assign
      206               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      207           .
      208       end.
      209     end.
      210   end procedure.
