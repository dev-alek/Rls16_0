      884   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      885   procedure paramls-clear :
      886     define buffer buf_temp-param for temp-param .
      887     do
      888     on error undo, return error return-value
      889     :
      890       for each buf_temp-param
      891       on error undo, return error
      892       :
      893         delete buf_temp-param .
      894       end.
      895     end.
      896   end procedure.
      897   procedure paramls-write :
      898     define input  parameter p-code     as character no-undo .
      899     define input  parameter p-sub-code as character no-undo .
      900     define input  parameter p-value    as character no-undo .
      901     define buffer buf_temp-param for temp-param .
      902     do
      903     on error undo, return error return-value
      904     :
      905       find first buf_temp-param
      906         where buf_temp-param.param-code     = p-code
      907           and buf_temp-param.param-sub-code = p-sub-code
      908         no-error .
      909       if not available buf_temp-param then do:
      910         create buf_temp-param .
      911         assign
      912           buf_temp-param.param-code     = p-code
      913           buf_temp-param.param-sub-code = p-sub-code
      914         .
      915       end.
      916       assign
      917         buf_temp-param.param-value = p-value
      918       .
      919     end.
      920   end procedure.
      921   procedure paramls-read :
      922     define input  parameter p-code          as character no-undo .
      923     define input  parameter p-sub-code      as character no-undo .
      924     define input  parameter p-default-value as character no-undo .
      925     define output parameter p-value         as character no-undo .
      926     define buffer buf_temp-param for temp-param .
      927     do
      928     on error undo, return error return-value
      929     :
      930       find first buf_temp-param
      931         where buf_temp-param.param-code     = p-code
      932           and buf_temp-param.param-sub-code = p-sub-code
      933         no-error .
      934       if available buf_temp-param then do:
      935         assign
      936           p-value = buf_temp-param.param-value
      937         .
      938       end.
      939       else do:
      940         assign
      941           p-value = p-default-value
      942         .
      943       end.
      944     end.
      945   end procedure.
      946   procedure paramls-append :
      947     define input  parameter p-code     as character no-undo .
      948     define input  parameter p-sub-code as character no-undo .
      949     define input  parameter p-value    as character no-undo .
      950     define buffer buf_temp-param for temp-param .
      951     do
      952     on error undo, return error return-value
      953     :
      954       find first buf_temp-param
      955            where buf_temp-param.param-code     = p-code
      956              and buf_temp-param.param-sub-code = p-sub-code
      957         no-error .
      958       if not available buf_temp-param then do:
      959         create buf_temp-param .
      960         assign
      961           buf_temp-param.param-code     = p-code
      962           buf_temp-param.param-sub-code = p-sub-code
      963           buf_temp-param.param-value    = p-value
      964         .
      965       end.
      966       else do:
      967           assign
      968               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      969           .
      970       end.
      971     end.
      972   end procedure.
