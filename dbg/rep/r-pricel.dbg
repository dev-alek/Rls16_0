      999     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1000     .
     1001   define new global shared variable mBatchMode as logical no-undo init ?.
     1002   define variable mFramBachModHandle as handle no-undo.
     1003   mFramBachModHandle = frame waitfram:handle.
     1004   define variable mFameOldVis as logical no-undo.
     1005   define variable mVisCUrentVin as logical no-undo.
     1006   if session:batch-mode
     1007   then
     1008      mBatchMode = yes.
     1009   if mBatchMode = ? then do:
     1010     mVisCUrentVin = current-window:visible.
     1011     mFameOldVis = mFramBachModHandle:visible.
     1012     mFramBachModHandle:visible  = yes.
     1013     mBatchMode = mFramBachModHandle:visible ne yes.
     1014     mFramBachModHandle:visible = mFameOldVis.
     1015     current-window:visible = mVisCUrentVin.
     1016   end.
     1017    if  log-manager:logfile-name ne ?
     1018     then DO:
     1019         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1020         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1021         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1022     end.
     1023   on choose of B-WaitFramStop in frame waitfram
     1024   do:
     1025     mWaitFramStop = yes.
     1026     mWaitFramStopUser = yes.
     1027   end.
     1028   function waitfram-check-timeout returns logical():
     1029      define variable vtime as int64 no-undo.
     1030      if mWaitFramStopTimeOut
     1031      then
     1032         return yes.
     1033      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1034      if     mWaitFramTimeOut ne ?
     1035         and mWaitFramTimeOut ne 0
     1036         and mWaitFramTimeOut lt vtime
     1037      then do:
     1038         mWaitFramStopTimeOut = yes.
     1039      end.
     1040      return mWaitFramStopTimeOut.
     1041   end.
     1042   procedure waitfram-hide :
     1043     if not session:batch-mode
     1044     then do
     1045     on error undo, return error return-value
     1046     :
     1047       pause 0 before-hide .
     1048       if not mBatchMode then
     1049         hide frame waitfram .
     1050     if     not mWaitFramView
     1051        and mWaitProcEvent
     1052     then
     1053       process events .
     1054     end.
     1055   end procedure.
     1056   procedure waitfram-show :
     1057     define input  parameter p-message as character no-undo .
     1058     define variable v-left-margin as integer   no-undo .
     1059     if not session:batch-mode
     1060     then do
     1061     on error undo, return error return-value
     1062     :
     1063       if length(p-message) <= 70 then do:
     1064         assign
     1065           v-left-margin = integer((70 - length(p-message)) / 2)
     1066         .
     1067         assign
     1068           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1069         .
     1070         assign
     1071           v-waitfram-action01 = " "
     1072           v-waitfram-action02 = " "
     1073                                    + fill(" ", v-left-margin)
     1074                                    + p-message
     1075           v-waitfram-action03 = " "
     1076         .
     1077       end.
     1078       else do:
     1079         define variable vRindex1 as integer no-undo.
     1080         define variable vRindex2 as integer no-undo.
     1081         vRindex1 = r-index(p-message," ",70).
     1082         if vRindex1 = 0
     1083         then
     1084            vRindex1 = 70.
     1085         if length(p-message)  <= vRindex1 + 70 then do:
     1086           assign
     1087             v-waitfram-action01 = " "
     1088             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1089             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1090           .
     1091         end.
     1092         else do:
     1093           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1094           if vRindex2 <= vRindex1
     1095           then
     1096              vRindex2 = vRindex1 + 70.
     1097           assign
     1098             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1099             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1100             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1101           .
     1102         end.
     1103       end.
     1104       B-viewProcInfo:visible   in frame waitfram = no.
     1105       B-viewProcInfo:sensitive in frame waitfram = no.
     1106       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1107       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1108       if  (   mWaitFramView
     1109          or  mWaitProcEvent)
     1110          and not mBatchMode
     1111       then
     1112          display
     1113             v-waitfram-action01 skip
     1114             v-waitfram-action02 skip
     1115             v-waitfram-action03 skip
     1116          with frame waitfram .
     1117       if     mWaitFramView
     1118          then do:
     1119             if     mWaitFramInterval ne ?
     1120                and not mBatchMode
     1121             then
     1122                wait-for go of frame waitfram pause mWaitFramInterval.
     1123          end.
     1124          else
     1125             if     mWaitProcEvent
     1126                and not mBatchMode
     1127             then
     1128                process events .
     1129     end.
     1130   end procedure.
     1131      procedure waitfram-show-this:
     1132         define input  parameter iInterval as int64 no-undo.
     1133         define variable vtime as int64 no-undo.
     1134         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1135         mWaitFramInterval = iInterval.
     1136         run waitfram-show (substitute("&1&2 &3&4" ,
     1137                                       mWaitFramTextBeg ,
     1138                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1139                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1140                                       mWaitFramTextEnd
     1141                                      )
     1142                           ).
     1143      end.
     1144      procedure WaitFramRunPause:
     1145         define input  parameter iInterval as dec no-undo.
     1146         define variable vStart  as datetime-tz no-undo.
     1147         define variable vend    as datetime-tz no-undo.
     1148         define variable vint as int64 no-undo.
     1149         define variable vOk as logical no-undo.
     1150         vStart = now.
     1151         vend   = vStart.
     1152         publish "WaitFramPause" (iInterval,output vOk).
     1153         vend   =  now.
     1154         vint = vend - vStart.
     1155         vint = iInterval - vint / 1000.
     1156         if     not mWaitFramStop
     1157            and (   vint > 0
     1158                 or (    not vOk
     1159                     and iInterval eq ?
     1160                     )
     1161                 )
     1162         then
     1163            run waitfram-show-this (iInterval).
     1164         vend   =  now.
     1165         vint = vend - vStart.
     1166         vint = iInterval - vint / 1000.
     1167         if     not mWaitFramStop
     1168            and vint > 0
     1169         then do:
     1170            run gbl/pause.p (vint * 1000).
     1171         end.
     1172         if iInterval ne ?
     1173         then
     1174            publish "WaitFramStop".
     1175         waitfram-check-timeout().
     1176      end.
     1177      procedure WaitFramWaitFor:
     1178         define input  parameter iInterval as dec no-undo.
     1179         assign
     1180            mWaitFramStartProc   = now
     1181            mWaitFramStopUser    = no
     1182            mWaitFramStopTimeOut = no
     1183         .
     1184         block-wait:
     1185         do while not mWaitFramStop:
     1186            run WaitFramRunPause (iInterval).
     1187            if  waitfram-check-timeout()
     1188            then do:
     1189               leave block-wait.
     1190            end.
     1191         end.
     1192         run waitfram-hide.
     1193      end.
     1194   procedure waitfram-join :
     1195     define input  parameter p-line-1  as character no-undo .
     1196     define input  parameter p-line-2  as character no-undo .
     1197     define input  parameter p-line-3  as character no-undo .
     1198     define output parameter p-message as character no-undo .
     1199     do
     1200     on error undo, return error return-value
     1201     :
     1202       assign
     1203         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1204                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1205                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1206       .
     1207     end.
     1208   end procedure.
     1209   function waitfram-join-function returns character
     1210     (input p-line-1 as character
     1211     ,input p-line-2 as character
     1212     ,input p-line-3 as character
     1213     ).
     1214     define variable v-message as character no-undo .
     1215     run waitfram-join in this-procedure
     1216       (input  p-line-1
     1217       ,input  p-line-2
     1218       ,input  p-line-3
     1219       ,output v-message
     1220       ) .
     1221     return v-message .
     1222   end function .
     1223   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1224     if num-entries(string(p-dec), '.') = 2
     1225       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1226       else return( string(p-dec)) .
     1227   end function.
     1228   function format-point-to-comma returns char (input orig as char ) .
     1229   define variable rtext as character no-undo .
     1230   define variable strt as integer no-undo .
     1231   define variable leng as integer no-undo .
     1232   assign rtext = orig .
     1233   repeat:
     1234     strt =  index(rtext,'.').
     1235     if strt = 0 then leave.
     1236     leng = 1.
     1237     substring(rtext,strt,leng,"character") = v-delim .
     1238   end.
     1239   return rtext.
     1240   end function.
     1241   function format-excel-text returns char ( input start-text as char ) :
     1242   def var  i    as int no-undo.
     1243   def var  ch   as char no-undo.
     1244   def var  n    as int no-undo.
     1245   def var  ipos as int no-undo.
     1246     n = num-entries(trim(start-text), chr(10)) - 1 .
     1247     do i = 1 to n :
     1248       ipos = index( start-text, chr(10)).
     1249       if ipos > 0 then
     1250         substr( start-text, ipos, 1 ) = ' '.
     1251     end.
     1252     n = num-entries(trim(start-text), chr(13)) - 1 .
     1253     do i = 1 to n :
     1254       ipos = index( start-text, chr(13)).
     1255       if ipos > 0 then
     1256         substr( start-text, ipos, 1 ) = ' '.
     1257     end.
     1258     if index( start-text, '"' ) = 0 then
     1259       start-text =  '="'   + trim( start-text) + '"'   .
     1260       else do:
     1261         n = num-entries(trim(start-text), '"') - 1.
     1262         do i = 1 to n :
     1263           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1264         end.
     1265         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1266         start-text = '="'  + ch  + '"' .
     1267       end.
     1268     return start-text.
     1269   end.
     1270   function excel-sum returns char (input p-dec as decimal ).
     1271     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1272   end function.
     1273   function excel-qnty returns char (input p-dec as decimal ).
     1274     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1275   end function.
     1276   function format-excel-text-macr returns char ( input start-text as char ) :
     1277   def var  i    as int no-undo.
     1278   def var  ch   as char no-undo.
     1279   def var  n    as int no-undo.
     1280   def var  ipos as int no-undo.
     1281     n = num-entries(trim(start-text), chr(10)) - 1 .
     1282     do i = 1 to n :
     1283       ipos = index( start-text, chr(10)).
     1284       if ipos > 0 then
     1285         substring( start-text, ipos , 1 ) = ' '.
     1286     end.
     1287     n = num-entries(trim(start-text), chr(13)) - 1 .
     1288     do i = 1 to n :
     1289       ipos = index( start-text, chr(13)).
     1290       if ipos > 0 then
     1291         substring( start-text, ipos, 1 ) = ' '.
     1292     end.
     1293     if index( start-text, '"' ) = 0 then
     1294       start-text =  '"'   + trim( start-text) + '"'   .
     1295       else do:
     1296         n = num-entries(trim(start-text), '"') - 1.
     1297         do i = 1 to n :
     1298           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1299         end.
     1300         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1301         start-text = '"'  + ch  + '"' .
     1302       end.
     1303     n = num-entries(trim(start-text), chr(10)) - 1 .
     1304     do i = 1 to n :
     1305       ipos = index( start-text, chr(10)).
     1306       if ipos > 0 then
     1307         substring( start-text, ipos , 1 ) = ' '.
     1308     end.
     1309       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1310     return start-text.
     1311   end.
