     1573   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1575     (input  v-cntxt-obj-type
     1576     ,input  v-cntxt-obj-code
     1577     ,output v-today
     1578     )  .
     1579   run proc-cur-rate( input v-cntxt-obj-type, input v-cntxt-obj-code, output Rubl_Coeff ).
     1580   FIND ub.clients where v-cntxt-obj-type = ub.clients.obj-type
     1581                         and v-cntxt-obj-code = ub.clients.obj-code no-lock no-error.
     1582   ObjName = ub.clients.obj-name .
     1583   RUN waitfram-show( 'Подождите ...' ).
     1584   if session:set-wait-state("COMPILER") then.
     1585   output stream PL to value( string( session:temp-directory +
     1586                                        "rpt" + string( g#report-num ) ) )
     1587                                        page-size  value(ReportPageHeight) .
     1588   output stream Title_ to value( string( session:temp-directory +
     1589                                    "plt" + string( g#report-num ) ) ) page-size value(ReportPageHeight) .
     1590   FORM HEADER
     1591           Line format "x(136)" AT 1 SKIP
     1592       with FRAME BottomFrame width 160 PAGE-BOTTOM no-labels no-box.
     1593   VIEW stream PL      FRAME BottomFrame .
     1594   if SortType = "По группам товаров ( и артикулу )" then
     1595       do:
     1596           FORM HEADER
     1597               cur-time-print() AT 5 format "X(35)"
     1598                   "Страница " AT 100 PAGE-NUMBER( Title_ )  FORMAT ">>>>9" SKIP(2)
     1599               ObjName AT 55 format "X(50)" SKIP(2)
     1600               "О Г Л А В Л Е Н И Е"  AT 50 SKIP(3)
     1601               with FRAME TopFrame width 160 PAGE-TOP no-labels no-box.
     1602           VIEW stream Title_  FRAME TopFrame .
     1603       end.
     1604   PUT stream Title_ cur-time-print() AT 5 format "X(35)" SKIP(2)
     1605               ObjName AT 55 format "X(50)" SKIP(2)
     1606               "П Р А Й С - Л И С Т" format "X(30)" AT 50 SKIP(3) .
     1607     num#str# = num#str# + 1.
     1608     num#col# = 1.
     1609     run macr_excel_char_with_format( String("        П Р А Й С - Л И С Т")  , num#str# , num#col#  ) .
     1610     run macr_cell_format
     1611     ( 14    ,
     1612       true  ,
     1613       false   ,
     1614       ? ,
     1615       1 ,
     1616       1 ,
     1617       2 ,
     1618       1 ) .
     1619     num#str# = num#str# + 1.
     1620     num#col# = 1.
     1621     run macr_excel_char_with_format( String( ObjName + " " + cur-time-print())  , num#str# , num#col#  ) .
     1622     num#str# = num#str# + 1.
     1623     run macr_excel_char_with_format(  "Код"               , num#str# , 1  ) .
     1624     run macr_excel_char_with_format(  "Артикул"           , num#str# , 2  ) .
     1625     run macr_excel_char_with_format(   "Наименование"     , num#str# , 3  ) .
     1626     run macr_excel_char_with_format(   "Производитель"    , num#str# , 4  ) .
     1627     run macr_excel_char_with_format(   "Ед. изм."         , num#str# , 5  ) .
     1628     if P_Type = 2
     1629        then  run macr_excel_char_with_format(   "Цена за ед. (РУБ)"    , num#str# , 6  ) .
     1630        else  run macr_excel_char_with_format(   "Цена за ед. (Б.вал.)"    , num#str# , 6  ) .
     1631     if not OnlyPrices  then do:
     1632        num#col# = 8 .
     1633        run macr_excel_char_with_format(   "Свободно"    , num#str# , 7  ) .
     1634        run macr_excel_char_with_format(   "Ожидается"    , num#str# , 8  ) .
     1635        run macr_cell_format
     1636         ( 10    ,
     1637           true  ,
     1638           false   ,
     1639           34 ,
     1640           3 ,
     1641           7 ,
     1642           3 ,
     1643           8 ) .
     1644     end.
     1645     else num#col# = 6 .
     1646     run macr_cell_format
     1647     ( 10    ,
     1648       true  ,
     1649       false   ,
     1650       34 ,
     1651       3 ,
     1652       1 ,
     1653       3 ,
     1654       6 ) .
     1655       run macr_cell_size ( 10 , ? , num#str# , 1 , ?, ? ) .
     1656       run macr_cell_size ( 10 , ? , num#str# , 2 , ?, ? ) .
     1657       run macr_cell_size ( 20 , ? , num#str# , 3 , ?, ? ) .
     1658       run macr_cell_size ( 20 , ? , num#str# , 4 , ?, ? ) .
     1659       run macr_cell_size ( 5 , ? , num#str# , 5 , ?, ? ) .
     1660       run macr_cell_size ( 10 , ? , num#str# , 6 , ?, ? ) .
     1661       run macr_cell_size ( 10 , ? , num#str# , 7 , ?, ? ) .
     1662       run macr_cell_size ( 11 , ? , num#str# , 8 , ?, ? ) .
     1663     put  stream macr_excel unformatted
     1664          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1665           'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1666          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1667          .
     1668   t_grp-name = "" .
     1669   CASE SortType :
     1670       when "По группам товаров ( и артикулу )" then
     1671           do:
     1672               FOR EACH gds-list BREAK BY gds-list.grp-name BY gds-list.artic :
     1673                   FIND ub.clients WHERE ub.clients.obj-type = gds-list.prod-type
     1674                                                      AND ub.clients.obj-code = gds-list.prod-code NO-LOCK .
     1675                   run make-temp-table ( input gds-list.gds-code ,
     1676                                         input v-cntxt-obj-type ,
     1677                                         input v-cntxt-obj-code ) .
     1678                   RUN prtprice( gds-list.gds-name, gds-list.prt-root , gds-list.gds-code ,gds-list.unit-base ) .
     1679                   ACCUMULATE gds-list.artic (COUNT) .
     1680                   if ( ( ( ACCUM COUNT gds-list.artic )  modulo 50 ) = 0 ) AND
     1681                              ( ( ACCUM COUNT gds-list.artic ) >= 50 ) then
     1682                       RUN waitfram-show( "Обработано наименований : " +
     1683                                                   string( ACCUM COUNT gds-list.artic ) ) .
     1684               END.
     1685               HIDE stream Title_ FRAME TopFrame .
     1686           end.
     1687       when "Только по артикулу" then
     1688           FOR EACH gds-list BREAK BY gds-list.artic :
     1689               FIND ub.clients WHERE ub.clients.obj-type = gds-list.prod-type
     1690                                                  AND ub.clients.obj-code = gds-list.prod-code NO-LOCK.
     1691               run make-temp-table ( input gds-list.gds-code ,
     1692                                         input v-cntxt-obj-type ,
     1693                                         input v-cntxt-obj-code ) .
     1694               RUN prtprice( gds-list.gds-name, gds-list.prt-root  , gds-list.gds-code ,gds-list.unit-base ) .
     1695               ACCUMULATE gds-list.artic (COUNT) .
     1696               if ( ( ( ACCUM COUNT gds-list.artic )  modulo 50 ) = 0 ) AND
     1697                          ( ( ACCUM COUNT gds-list.artic ) >= 50 ) then
     1698                   RUN waitfram-show( "Обработано наименований : " +
     1699                                               string( ACCUM COUNT gds-list.artic ) ) .
     1700           END.
     1701   END CASE .
     1702   HIDE stream PL FRAME BottomFrame .
     1703   PUT stream PL Line format "x(136)" SKIP .
     1704   output stream Title_ CLOSE .
     1705   output stream PL CLOSE .
     1706   Output stream Macr_Excel  close .
     1707   RUN waitfram-hide.
     1708       run paramls-write in this-procedure
     1709         (input "file"
     1710         ,input string(v-ind)
     1711         ,input v-file-name
     1712         ) .
     1713       run paramls-write in this-procedure
     1714           (input "charcol"
     1715           ,input ""
     1716           ,input "1,2,3,4,5"
     1717           ) .
     1718     run end-proc .
     1719   define variable vss-include-info20 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   do:
     1721     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1722       (input  v-cntxt-db-num
     1723       ,input  v-cntxt-userid
     1724       ,input  0
     1725       ,input  'actn_price-list-to-file_print':U
     1726       ,input  'firm':U
     1727       ,input  v-cntxt-host-code-obj
     1728       ,input  '':U
     1729       ,input  0
     1730       ,input  0
     1731       ,input  0
     1732       ,input  0
     1733       ,input  false
     1734       ,output log-res
     1735       )  .
     1736   end.
     1737   if not Log-Res then
     1738       run rep/pl-prn.w (4 ,g#report-num) .
     1739   else
     1740       run rep/pl-prn.w (0,g#report-num) .
     1741   procedure proc-cur-rate :
     1742     do
     1743     on error undo, return error return-value
     1744     :
     1745   define input  parameter p-obj-type as character no-undo .
     1746   define input  parameter p-obj-code as integer   no-undo .
     1747   define output parameter Rubl_Coeff as decimal   no-undo .
     1748   define variable v-base-code like ub.sysconf.base-code no-undo .
     1749   define variable v-host-code like ub.sysconf.host-code no-undo .
     1750   DEFINE VARIABLE v-today as date no-undo .
     1751   DEFINE VARIABLE v-time as integer no-undo .
     1752   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1753   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1754     (input  p-obj-type
     1755     ,input  p-obj-code
     1756     ,output v-host-code
     1757     )  .
     1758   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1759   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1760     (input  v-host-code
     1761     ,output v-base-code
     1762     )  .
     1763   run cur-time in this-procedure ( output v-today, output v-time).
     1764           FIND LAST ub.curr-accnt WHERE ub.curr-accnt.curr-code = v-base-code
     1765                                                    AND ub.curr-accnt.exch-date <= v-today
     1766                                                    NO-LOCK NO-ERROR .
     1767           FIND LAST ub.curr-shop WHERE ub.curr-shop.curr-code = v-base-code
     1768                                                    AND ub.curr-shop.obj-code = p-obj-code
     1769                                                    AND ub.curr-shop.obj-type = p-obj-type
     1770                                                    USE-INDEX pi NO-LOCK NO-ERROR .
     1771           if p-obj-type = 'маг':U then
     1772               do:
     1773                   if not available ub.curr-shop then
     1774                       do:
     1775                           bell.
     1776                           message "Нет ни одного МАГАЗИННОГО курса базовой валюты к рублям.".
     1777                           Rubl_Coeff = 1.
     1778                       end.
     1779                   else
     1780                       Rubl_Coeff = ub.curr-shop.exch-rate / ub.curr-shop.exch-scale.
     1781               end.
     1782           else
     1783               do:
     1784                   if not available ub.curr-accnt then
     1785                       do:
     1786                           bell.
     1787                           message "Нет ни одного курса ММВБ базовой валюты к рублям.".
     1788                           return.
     1789                       end.
     1790                   else
     1791                       Rubl_Coeff = ub.curr-accnt.exch-rate / ub.curr-accnt.exch-scale.
     1792               end.
     1793     end.
     1794   end procedure.
     1795   PROCEDURE prtprice :
     1796   def input parameter tr   as character no-undo .
     1797   def input parameter node as integer  no-undo  .
     1798   define input parameter pp-gds-code like ub.goods.gds-code no-undo .
     1799   define input parameter pp-unit-base like ub.goods.unit-base no-undo .
     1800   def buffer b-gds-prt for ub.gds-prt .
     1801   def var gds_name as char no-undo.
     1802   assign gds_name = tr .
     1803       FOR EACH b-gds-prt WHERE b-gds-prt.upper-code = node no-lock :
     1804       find  first temp-prt where temp-prt.prt-code = b-gds-prt.node-code no-error .
     1805       if not available temp-prt then next.
     1806       run price-qnty .
     1807                   if ( OnlyPrices ) OR ( qnty <> 0 OR WaitQnty <> 0 ) then
     1808                       do:
     1809                           if NOT b-gds-prt.root then
     1810                               tr = gds_name + '\' + b-gds-prt.node-name.
     1811                           if ( t_grp-name <> gds-list.grp-name ) AND
     1812                              lookup( "По группам товаров ( и артикулу )", SortType ) > 0 then
     1813                               do:
     1814                                   if t_grp-name <> "" then
     1815                                       if OnlyPrices then
     1816                                           if P_Type = 2 then
     1817                                               UNDERLINE stream PL gds-list.gds-name
     1818                                               with FRAME ReducedPriceList-Rubl .
     1819                                           else
     1820                                               UNDERLINE stream PL gds-list.gds-name
     1821                                               with FRAME ReducedPriceList-Val .
     1822                                       else
     1823                                           if P_Type = 2 then
     1824                                               UNDERLINE stream PL gds-list.gds-name
     1825                                               with FRAME FullPriceList-Rubl .
     1826                                           else
     1827                                               UNDERLINE stream PL gds-list.gds-name
     1828                                               with FRAME FullPriceList-Val .
     1829                                   DO i = 1 to num-entries( right-trim(gds-list.grp-name, chr(47)), chr(47) ) :
     1830                                       if OnlyPrices then
     1831                                           if P_Type = 2 then
     1832                                               do:
     1833                                                   DISPLAY stream PL sym1
     1834                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1835                                                           @ gds-list.gds-name
     1836                                                       sym7 with FRAME ReducedPriceList-Rubl .
     1837                                                   DOWN stream PL 1 with FRAME ReducedPriceList-Rubl .
     1838                                                   run gr-ex.
     1839                                               end.
     1840                                           else
     1841                                               do:
     1842                                                   DISPLAY stream PL sym1
     1843                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1844                                                           @ gds-list.gds-name
     1845                                                       sym7 with FRAME ReducedPriceList-Val .
     1846                                                   DOWN stream PL 1 with FRAME ReducedPriceList-Val .
     1847                                                   run gr-ex.
     1848                                               end.
     1849                                       else
     1850                                           if P_Type = 2 then
     1851                                               do:
     1852                                                   DISPLAY stream PL sym1
     1853                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1854                                                           @ gds-list.gds-name
     1855                                                       sym9 with FRAME FullPriceList-Rubl .
     1856                                                   DOWN stream PL 1 with FRAME FullPriceList-Rubl .
     1857                                                   run gr-ex.
     1858                                               end.
     1859                                           else
     1860                                               do:
     1861                                                   DISPLAY stream PL sym1
     1862                                                       string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )
     1863                                                           @ gds-list.gds-name
     1864                                                       sym9 with FRAME FullPriceList-Val .
     1865                                                   DOWN stream PL 1 with FRAME FullPriceList-Val .
     1866                                                   run gr-ex.
     1867                                               end.
     1868                                   END .
     1869                                   if OnlyPrices then
     1870                                       if P_Type = 2 then
     1871                                           UNDERLINE stream PL gds-list.gds-name
     1872                                               with FRAME ReducedPriceList-Rubl .
     1873                                       else
     1874                                           UNDERLINE stream PL gds-list.gds-name
     1875                                               with FRAME ReducedPriceList-Val .
     1876                                   else
     1877                                       if P_Type = 2 then
     1878                                           UNDERLINE stream PL gds-list.gds-name
     1879                                               with FRAME FullPriceList-Rubl .
     1880                                       else
     1881                                           UNDERLINE stream PL gds-list.gds-name
     1882                                               with FRAME FullPriceList-Val .
     1883                               end.
     1884                           if OnlyPrices then
     1885                               if P_Type = 2 then
     1886                               do:
     1887                                   DISPLAY stream PL
     1888                                       sym1 trim( string( temp-prt.b-code ) ) @ tb-code
     1889                                       sym2 gds-list.artic
     1890                                       sym3 tr @ gds-list.gds-name
     1891                                       sym4 ub.clients.obj-name
     1892                                       sym5 gds-list.unit-base @ t_unit-name
     1893                                       sym6
     1894                                       (if price = 0 or price = ? then "        ----" else string(price, ">>>>>9.99" ) ) format "x(9)" @ price
     1895                                       sym7 with FRAME ReducedPriceList-Rubl .
     1896                                   DOWN    stream PL   1   with FRAME ReducedPriceList-Rubl .
     1897                                   run ex-str1 (tr).
     1898                               end.
     1899                               else
     1900                               do:
     1901                                   DISPLAY stream PL
     1902                                       sym1 trim( string( temp-prt.b-code ) ) @ tb-code
     1903                                       sym2 gds-list.artic
     1904                                       sym3 tr @ gds-list.gds-name
     1905                                       sym4 ub.clients.obj-name
     1906                                       sym5 gds-list.unit-base @ t_unit-name
     1907                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>>>9.99" ) ) format "x(12)" @ price
     1908                                       sym7 with FRAME ReducedPriceList-Val .
     1909                                   DOWN    stream PL   1   with FRAME ReducedPriceList-Val .
     1910                                   run ex-str1 (tr).
     1911                               end.
     1912                           else
     1913                               if P_Type = 2 then
     1914                               do:
     1915                                   DISPLAY stream PL
     1916                                       sym1 trim( string( temp-prt.b-code ) ) @ tb-code
     1917                                       sym2 gds-list.artic
     1918                                       sym3 tr @ gds-list.gds-name
     1919                                       sym4 ub.clients.obj-name
     1920                                       sym5 gds-list.unit-base @ t_unit-name
     1921                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>9.99" ) ) format "x(9)" @ price
     1922                                       sym7 qnty   when qnty <> 0
     1923                                       sym8 WaitQnty   when WaitQnty <> 0
     1924                                       sym9
     1925                                       with FRAME FullPriceList-Rubl .
     1926                                   DOWN    stream PL   1 with FRAME FullPriceList-Rubl .
     1927                                   run ex-str2 (tr).
     1928                               end.
     1929                               else
     1930                               do:
     1931                                   DISPLAY stream PL
     1932                                       sym1 trim( string( temp-prt.b-code ) ) @ tb-code
     1933                                       sym2 gds-list.artic
     1934                                       sym3 tr @ gds-list.gds-name
     1935                                       sym4 ub.clients.obj-name
     1936                                       sym5 gds-list.unit-base @ t_unit-name
     1937                                       sym6 (if price = 0 or price = ? then "        ----" else string(price, ">>>>>>>>9.99" ) ) format "x(12)" @ price
     1938                                       sym7 qnty   when qnty <> 0
     1939                                       sym8 WaitQnty   when WaitQnty <> 0
     1940                                       sym9
     1941                                       with FRAME FullPriceList-Val .
     1942                                   DOWN    stream PL   1 with FRAME FullPriceList-Val .
     1943                                   run ex-str2 (tr).
     1944                               end.
     1945                           if ( t_grp-name <> gds-list.grp-name ) AND
     1946                              lookup( "По группам товаров ( и артикулу )", SortType ) > 0 then
     1947                               do:
     1948                                   CurrItem = "" .
     1949                                   DO i = 1 to num-entries( right-trim(gds-list.grp-name, chr(47)), chr(47) ):
     1950                                       CurrItem = entry( i, t_grp-name , chr(47) ) NO-ERROR .
     1951                                       if ( error-status:error ) OR
     1952                                          ( CurrItem <> entry( i, gds-list.grp-name, chr(47) ) ) then
     1953                                           do:
     1954                                               DISPLAY stream Title_
     1955                                                       string( fill( " " , i * 10 ) + string( if i = 1 then "  " else "\ " ) +
     1956                                                           entry( i, gds-list.grp-name, chr(47) ) + " " +
     1957                                                           fill( "." , 120 - ( i * 10 ) - 5 -
     1958                                                           length( entry( i, gds-list.grp-name, chr(47) ) ) ) ) @ AA
     1959                                                       PAGE-NUMBER( PL )  @ JJ
     1960                                                       with frame PL-Title .
     1961                                               DOWN stream Title_ 1 with FRAME PL-Title .
     1962                                           end.
     1963                                   END .
     1964                                   t_grp-name = gds-list.grp-name .
     1965                               end.
     1966                       end.
     1967           if NOT No-Prt then do:
     1968              RUN prtprice( tr, b-gds-prt.node-code, gds-list.gds-code, gds-list.unit-base).
     1969           end.
     1970       END.
     1971   END PROCEDURE .
     1972   PROCEDURE price-qnty :
     1973       if temp-prt.price-sale <> ? then
     1974           do:
     1975               if var-report-r-b = "base" then
     1976                   assign price = ( if P_Type = 2
     1977                                       then (temp-prt.price-sale * Rubl_Coeff )    else temp-prt.price-sale ) .
     1978               else do:
     1979                   if base-code = 0 then do:
     1980                   assign price = ( if P_Type = 2
     1981                                      then temp-prt.price-sale
     1982                                      else ( temp-prt.price-sale / Rubl_Coeff )   )
     1983                                      .
     1984                                      end.
     1985                   else do:
     1986                   assign price = ( if P_Type = 2
     1987                                      then ( temp-prt.price-sale )
     1988                                      else  temp-prt.price-sale / Rubl_Coeff   ).
     1989                                      end.
     1990              end.
     1991          end.
     1992       else
     1993           price = 0 .
     1994     assign
     1995         price = round(price ,2)
     1996         qnty     = temp-prt.free-qnty
     1997         Waitqnty =  0
     1998         .
     1999   END PROCEDURE .
     2000   procedure new-tmp-page :
     2001    do
     2002    on error undo, return error return-value
     2003    :
     2004       if   num#str#  >= 63000 then do:
     2005           Output stream Macr_Excel  close .
     2006           run paramls-write in this-procedure
     2007             (input "file"
     2008             ,input string(v-ind)
     2009             ,input v-file-name
     2010             ) .
     2011           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2012           output stream  Macr_Excel to value(v-file-name) .
     2013           v-ind = v-ind + 1 .
     2014           num#str# = 0 .
     2015           run proc-print-header.
     2016       end.
     2017    end.
     2018   end procedure.
     2019   procedure gr-ex :
     2020    do
     2021    on error undo, return error return-value
     2022    :
     2023   num#str# = num#str# + 1.
     2024   num#col# = 1 + i .
     2025   run macr_excel_char_with_format( string( fill( " " , i * 2 ) + chr(47) + entry( i, gds-list.grp-name, chr(47) ) )  , num#str# , num#col#  ) .
     2026   run macr_cell_format
     2027   ( 10    ,
     2028   true  ,
     2029   true  ,
     2030   ?    ,
     2031   num#str# ,
     2032   num#col# ,
     2033   num#str# ,
     2034   num#col# ) .
     2035    end.
     2036   end procedure.
     2037   procedure ex-str1 :
     2038   define input parameter tr as character no-undo .
     2039    do
     2040    on error undo, return error return-value
     2041    :
     2042     num#str# = num#str# + 1.
     2043     num#col# = 1.
     2044     run macr_excel_char_with_format( trim( string( temp-prt.b-code ) ), num#str# , num#col#  ) .
     2045     num#col# = 2.
     2046     run macr_excel_char_with_format( trim( string( gds-list.artic ) ), num#str# , num#col#  ) .
     2047     num#col# = 3.
     2048     run macr_excel_char_with_format( tr , num#str# , num#col#  ) .
     2049     num#col# = 4.
     2050     run macr_excel_char_with_format( ub.clients.obj-name, num#str# , num#col#  ) .
     2051     num#col# = 5.
     2052     run macr_excel_char_with_format( gds-list.unit-base, num#str# , num#col#  ) .
     2053     num#col# = 6.
     2054     if price = 0 or price = ? then run macr_excel_char_with_format( "---", num#str# , num#col#  ) .
     2055                               else  run macr_excel_dec ( price     , num#str# , num#col#   ) .
     2056    end.
     2057   end procedure.
     2058   procedure ex-str2 :
     2059    define input parameter tr as character no-undo .
     2060    do
     2061    on error undo, return error return-value
     2062    :
     2063     num#str# = num#str# + 1.
     2064     num#col# = 1.
     2065     run macr_excel_char_with_format( trim( string( temp-prt.b-code ) ), num#str# , num#col#  ) .
     2066     num#col# = 2.
     2067     run macr_excel_char_with_format( trim( string( gds-list.artic ) ), num#str# , num#col#  ) .
     2068     num#col# = 3.
     2069     run macr_excel_char_with_format( tr , num#str# , num#col#  ) .
     2070     num#col# = 4.
     2071     run macr_excel_char_with_format( ub.clients.obj-name, num#str# , num#col#  ) .
     2072     num#col# = 5.
     2073     run macr_excel_char_with_format( gds-list.unit-base, num#str# , num#col#  ) .
     2074     num#col# = 6.
     2075     if price = 0 or price = ? then run macr_excel_char_with_format( "---", num#str# , num#col#  ) .
     2076                               else  run macr_excel_dec ( price     , num#str# , num#col#   ) .
     2077     num#col# = 7.
     2078     run macr_excel_dec ( qnty    , num#str# , num#col#   ) .
     2079     num#col# = 8.
     2080     if waitqnty = 0 or waitqnty = ?
     2081         then run macr_excel_char_with_format( "" , num#str# , num#col#  ) .
     2082         else run macr_excel_dec ( waitqnty    , num#str# , num#col#   ) .
     2083    end.
     2084   end procedure.
     2085   def var vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2086   procedure make-temp-table :
     2087    do
     2088    on error undo, return error return-value
     2089    :
     2090   define input parameter p-gds-code like ub.goods.gds-code   no-undo .
     2091   define input parameter p-obj-type like ub.clients.obj-type no-undo .
     2092   define input parameter p-obj-code like ub.clients.obj-code no-undo .
     2093   define buffer l_goods for ub.goods       .
     2094   define buffer l_bar-code for ub.bar-code .
     2095   define buffer l_prt-obj  for ub.prt-obj  .
     2096   for each temp-prt : delete temp-prt. end.
     2097   find first  l_goods where l_goods.gds-code = p-gds-code no-lock .
     2098   for each l_bar-code where
     2099           l_bar-code.gds-code    = p-gds-code and
     2100           l_bar-code.in-code     = ""         and
     2101           l_bar-code.part-code   = ""         and
     2102           l_bar-code.unit-cli    = l_goods.unit-base   no-lock :
     2103           create temp-prt .
     2104           assign
     2105             temp-prt.b-code     = l_bar-code.b-code
     2106             temp-prt.prt-code   = l_bar-code.node-code
     2107           .
     2108        find first l_prt-obj  where
     2109                   l_prt-obj.artic     = l_goods.artic    and
     2110                   l_prt-obj.prod-code = l_goods.prod-code  and
     2111                   l_prt-obj.prod-type = l_goods.prod-type  and
     2112                   l_prt-obj.obj-code  = p-obj-code         and
     2113                   l_prt-obj.obj-type  = p-obj-type         and
     2114                   l_prt-obj.prt-code  = l_bar-code.node-code
     2115                   use-index pi NO-LOCK NO-ERROR .
     2116           if available l_prt-obj then do:
     2117               assign
     2118                 temp-prt.fact-qnty   = l_prt-obj.fact-qnty
     2119                 temp-prt.free-qnty   = l_prt-obj.free-qnty
     2120                 temp-prt.price-sale  = l_prt-obj.price-sale
     2121               .
     2122           end.
     2123           else do:
     2124             delete temp-prt .
     2125           end.
     2126    end.
     2127    end.
     2128   end procedure.
     2129   def var vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2130   procedure macr_excel_char :
     2131    do
     2132    on error undo, return error return-value
     2133    :
     2134    define input parameter  p-val as character no-undo .
     2135    define input parameter  p-row as integer no-undo .
     2136    define input parameter  p-col as integer no-undo .
     2137    if p-val = ? then p-val = "" .
     2138       put stream macr_excel unformatted
     2139             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2140    end.
     2141   end procedure.
     2142   procedure macr_excel_char_with_format :
     2143    do
     2144    on error undo, return error return-value
     2145    :
     2146    define input parameter  p-val as character no-undo .
     2147    define input parameter  p-row as integer no-undo .
     2148    define input parameter  p-col as integer no-undo .
     2149    if p-val = ? then p-val = "" .
     2150       put stream macr_excel unformatted
     2151             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2152       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     2153       put stream macr_excel unformatted
     2154             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2155    end.
     2156   end procedure.
     2157   procedure macr_excel_cell_format :
     2158    do
     2159    on error undo, return error return-value
     2160    :
     2161    define input parameter  p-val    as character no-undo .
     2162    define input parameter  p-row    as integer   no-undo .
     2163    define input parameter  p-col    as integer   no-undo .
     2164    define input parameter  p-format as character no-undo .
     2165    if p-val = ? then p-val = "" .
     2166       put stream macr_excel unformatted
     2167             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     2168       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     2169       put stream macr_excel unformatted
     2170             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     2171    end.
     2172   end procedure.
     2173   procedure macr_excel_sum :
     2174    do
     2175    on error undo, return error return-value
     2176    :
     2177    define input parameter  p-row as integer no-undo .
     2178    define input parameter  p-col as integer no-undo .
     2179    define input parameter  p-row1 as integer no-undo .
     2180    define input parameter  p-col1 as integer no-undo .
     2181    define input parameter  p-row2 as integer no-undo .
     2182    define input parameter  p-col2 as integer no-undo .
     2183       put stream macr_excel unformatted
     2184             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     2185    end.
     2186   end procedure.
     2187   procedure macr_excel_dec :
     2188    do
     2189    on error undo, return error return-value
     2190    :
     2191    define input parameter  p-val as character no-undo .
     2192    define input parameter  p-row as integer   no-undo .
     2193    define input parameter  p-col as integer   no-undo .
     2194     if p-val = ? then p-val =  "" .
     2195      put  stream macr_excel unformatted
     2196           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     2197    end.
     2198   end procedure.
     2199   procedure macr_cell_format :
     2200    do
     2201    on error undo, return error return-value
     2202    :
     2203    define input parameter  p-size   as integer   no-undo .
     2204    define input parameter  p-bold   as logical   no-undo .
     2205    define input parameter  p-italic as logical   no-undo .
     2206    define input parameter  p-color  as integer   no-undo .
     2207    define input parameter  p-row    as integer   no-undo .
     2208    define input parameter  p-col    as integer   no-undo .
     2209    define input parameter  p-row-2  as integer   no-undo .
     2210    define input parameter  p-col-2  as integer   no-undo .
     2211     if p-size = ? then p-size = 10 .
     2212     if p-bold = ? then p-bold = false .
     2213     if p-italic = ? then p-italic = false .
     2214     if p-row-2 = ? then p-row-2 = p-row .
     2215     if p-col-2 = ? then p-col-2 = p-col .
     2216     put  stream macr_excel unformatted
     2217      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     2218     if p-color <> ? then do:
     2219        put  stream macr_excel unformatted
     2220          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     2221     end.
     2222     put  stream macr_excel unformatted
     2223          substitute('format.font(,&1,&2,&3)' , p-size,
     2224                                           string ( p-bold  , "true/false" ) ,
     2225                                           string ( p-italic , "true/false" )
     2226                                           ) + chr(10) .
     2227    end.
     2228   end procedure.
     2229   procedure macr_cell_size :
     2230    do
     2231    on error undo, return error return-value
     2232    :
     2233    define input parameter  p-w   as integer   no-undo .
     2234    define input parameter  p-l   as integer   no-undo .
     2235    define input parameter  p-row    as integer   no-undo .
     2236    define input parameter  p-col    as integer   no-undo .
     2237    define input parameter  p-row-2  as integer   no-undo .
     2238    define input parameter  p-col-2  as integer   no-undo .
     2239     if p-row-2 = ? then p-row-2 = p-row .
     2240     if p-col-2 = ? then p-col-2 = p-col .
     2241     if p-w = ? then    p-w = 0 .
     2242     if p-l = ? then    p-l = 0 .
     2243    define variable s-w as character no-undo .
     2244    define variable s-l as character no-undo .
     2245    if p-w = 0 then s-w = "" .
     2246               else s-w = string(p-w)  .
     2247    if p-l = 0 then s-l = "" .
     2248               else s-l = string(p-l)  .
     2249   put  stream macr_excel unformatted
     2250        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     2251   put  stream macr_excel unformatted
     2252        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     2253   put  stream macr_excel unformatted
     2254        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     2255    end.
     2256   end procedure.
     2257   procedure proc-print-header :
     2258    do
     2259    on error undo, return error return-value
     2260    :
     2261      find first sheetf .
     2262        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     2263        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     2264        var-1 =  num#str# .
     2265        repeat c-c = 1 to sheetf.excel-row-title :
     2266        num#str# = num#str# + 1 .
     2267        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     2268        do c-i = 1 to p-var :
     2269           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     2270           str--2 = integer(entry( c-i, sheetf.sizes )) .
     2271           num#col# = c-i .
     2272           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     2273           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     2274        end.
     2275       c-i = 0.
     2276       end.
     2277       run macr_cell_format (
     2278           10       ,
     2279           true     ,
     2280           false    ,
     2281           35       ,
     2282           var-1 + 1,
     2283           1        ,
     2284           num#str# ,
     2285           num#col# )
     2286           .
     2287     put  stream macr_excel unformatted
     2288          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     2289          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2290          .
     2291    end.
     2292   end procedure.
     2293   procedure end-proc :
     2294    do
     2295    on error undo, return error return-value
     2296    :
     2297     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     2298     OUTPUT to VALUE (v-file-name) .
     2299     for each temp-param :
     2300       export  temp-param  .
     2301     end.
     2302    end.
     2303   end procedure.
