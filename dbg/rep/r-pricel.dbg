     1563    run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1564       output stream macr_excel to value(v-file-name)   .
     1565       v-ind = 1    .
     1566       num#str# = 0 .
     1567   if session:set-wait-state("COMPILER") then.
     1568   if i = 0 OR P_Type = 0 then
     1569       return.
     1570   if session:set-wait-state("COMPILER") then.
     1571   Line = fill("-", 232).
