      355     define variable v-cntxp-unit-cli-perm   like ub.store.unit-cli-perm   no-undo.
      356     define variable v-cntxp-out-rate        like ub.store.out-rate        no-undo.
      357     define variable v-cntxp-out-line-discnt like ub.store.out-line-discnt no-undo.
      358     define variable v-cntxp-in-ov           like ub.store.in-ov           no-undo.
      359     define variable v-cntxp-in-perm         like ub.store.in-perm         no-undo.
      360     define variable v-cntxp-no-eq           like ub.store.no-eq           no-undo.
      361     define variable v-cntxp-rsrv-time       like ub.store.rsrv-time       no-undo.
      362     define variable v-cntxp-load-time       like ub.store.load-time       no-undo.
      363     define variable v-cntxp-holidays        like ub.store.holidays        no-undo.
      364     define variable v-cntxp-in-pay          like ub.store.in-pay          no-undo.
      365     define variable v-cntxp-out-pay         like ub.store.out-pay         no-undo.
      366     define variable v-cntxp-ret-pay         like ub.store.ret-pay         no-undo.
      367     define variable v-cntxp-ret-sup-pay     like ub.store.ret-sup-pay     no-undo.
      368     define variable v-cntxp-down-pay        like ub.store.down-pay        no-undo.
      369     define variable v-cntxp-inv-pay         like ub.store.inv-pay         no-undo.
      370     define variable v-cntxp-chk-pay         like ub.store.chk-pay         no-undo.
      371     define variable v-cntxp-retail          like ub.sysconf.ord-prt       no-undo.
      372     define variable v-cntxp-osn-base        like ub.sysconf.osn-base      no-undo.
      373     define variable v-cntxp-conf-par        as   character                no-undo.
      374     define variable v-cntxp-par-type        as   character                no-undo.
      375     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
      376     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
      377     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
      378     define variable v-cntxp-db-num          as integer   no-undo .
      379     define variable v-cntxp-userid          as character no-undo .
      380     define variable v-cntxp-level           as character no-undo .
      381     define variable v-cntxp-db-num-obj      as integer   no-undo .
      382     define variable v-cntxp-is-admin        as logical   no-undo .
      383     define buffer bf-cntxp_store for ub.store.
      384     define buffer bf-cntxp_shop  for ub.shop.
      385     define buffer bf-cntxp_sysconf for ub.sysconf.
      386   define stream out-stream .
      387   def buffer buf_wth-doc  for ub.wth-doc.
      388   def buffer buf_wth-line for ub.wth-line.
      389   def buffer buf_wth-dtl  for ub.wth-dtl.
      390   def buffer buf_clients  for ub.clients.
      391   define buffer buf_host for ub.clients.
      392   def var v-organization  like ub.clients.obj-name no-undo.
      393   def var v-org-to        as char no-undo.
      394   def var v-org-from      as char no-undo.
      395   def var v-operator      like ub.clients.obj-name no-undo.
      396   def var v-deliver       like ub.clients.obj-name no-undo.
      397   def var v-receiver      like ub.clients.obj-name no-undo.
      398   def var v-temp-string   as char no-undo.
      399   def var v-temp-position as int  no-undo.
      400   def var v-single-line   as char no-undo.
      401   do
      402   on error undo, return error
      403   :
      404   run get-report-num in parparentproc (
      405       output g#report-num
      406   ).
      407   run get-quest-print in parparentproc (
      408       output g#quest-print
      409   ).
      410   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      411     run mainmenu_getcntxt in parparentproc
      412       (output v-cntxp-db-num
      413       ,output v-cntxp-userid
      414       ,output v-cntxp-level
      415       ,output v-cntxp-curr-host-code
      416       ,output v-cntxp-obj-type
      417       ,output v-cntxp-obj-code
      418       ,output v-cntxp-db-num-obj
      419       ,output v-cntxp-is-admin
      420       ) .
      421     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
      422        v-cntxp-obj-code <> 0 then do:
      423   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
      424     (input  'is-prt'
      425     ,input  0
      426     ,input  ''
      427     ,input  0
      428     ,input  ''
      429     ,input  ''
      430     ,input  ''
      431     ,input  yes
      432     ,output v-cntxp-conf-par
      433     ,output v-cntxp-par-type
      434     ) no-error .
      435       case v-cntxp-obj-type :
      436         when 'скл':U then do:
      437           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
      438           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
      439           assign
      440             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
      441             v-cntxp-price-calc      = bf-cntxp_store.price-calc
      442             v-cntxp-inout-price     = bf-cntxp_store.inout-price
      443             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
      444             v-cntxp-out-rate        = bf-cntxp_store.out-rate
      445             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
      446             v-cntxp-in-ov           = bf-cntxp_store.in-ov
      447             v-cntxp-in-perm         = bf-cntxp_store.in-perm
      448             v-cntxp-no-eq           = bf-cntxp_store.no-eq
      449             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
      450             v-cntxp-load-time       = bf-cntxp_store.load-time
      451             v-cntxp-holidays        = bf-cntxp_store.holidays
      452             v-cntxp-in-pay          = bf-cntxp_store.in-pay
      453             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      454             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      455             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      456             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      457             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      458             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      459             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      460             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      461             .
      462         end.
      463         when 'маг':U then do:
      464           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
      465           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
      466           assign
      467             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
      468             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
      469             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
      470             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
      471             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
      472             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
      473             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
      474             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
      475             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
      476             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
      477             v-cntxp-load-time       = bf-cntxp_shop.load-time
      478             v-cntxp-holidays        = bf-cntxp_shop.holidays
      479             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
      480             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
      481             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
      482             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
      483             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
      484             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
      485             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
      486             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
      487             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
      488             .
      489         end.
      490       end case.
      491     end.
      492   if session :set-wait-state( "compiler" ) then.
      493   output stream out-stream to value( string( session:temp-directory +
      494                                        "rpt" + string( g#report-num ) ) )
      495                                        page-size  value(43) .
      496   assign v-single-line = fill("-", 124).
      497   find first buf_wth-doc no-lock
      498        where buf_wth-doc.doc-code = p-doc-code
      499   .
      500   find first buf_clients no-lock
      501       where buf_clients.obj-type = buf_wth-doc.obj-type
      502         and buf_clients.obj-code = buf_wth-doc.obj-code
      503   .
      504   find first buf_host no-lock
      505       where buf_host.obj-type = 'орг':U
      506         and buf_host.obj-code = buf_wth-doc.host-code
      507   .
      508   assign
      509     v-organization = buf_clients.obj-name
      510   .
      511   for each buf_wth-line no-lock
      512        where buf_wth-line.doc-code = buf_wth-doc.doc-code
      513   break by buf_wth-line.wth-code
      514   :
      515       if not first(buf_wth-line.wth-code)
      516       then do:
      517         FORM HEADER
      518             v-single-line format "X(124)" AT 1 SKIP
      519             "Продолжение - на следующей странице" AT 30 SKIP
      520             with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
      521         VIEW STREAM out-stream FRAME BottomFrame .
      522         PAGE STREAM out-stream.
      523       end.
      524       find first ub.wth-place
      525            where ub.wth-place.host-code = buf_clients.host-code
      526              and ub.wth-place.obj-type  = buf_wth-doc.obj-type
      527              and ub.wth-place.obj-code  = buf_wth-doc.obj-code
      528              and ub.wth-place.w-p-code  = buf_wth-line.w-p-code
      529       no-error.
      530       find first buf_clients no-lock
      531           where buf_clients.obj-type = 'чел':U
      532             and buf_clients.obj-code = buf_wth-doc.operator
      533       no-error.
      534       assign
      535         v-operator = if available buf_clients then buf_clients.obj-name else '':U
      536       .
      537       find first buf_clients no-lock
      538           where buf_clients.obj-type = 'чел':U
      539             and buf_clients.obj-code = buf_wth-doc.deliver
      540       no-error.
      541       assign
      542         v-deliver = if available buf_clients then buf_clients.obj-name else '':U
      543       .
      544       find first buf_clients no-lock
      545           where buf_clients.obj-type = 'чел':U
      546             and buf_clients.obj-code = buf_wth-doc.receiver
      547       no-error.
      548       assign
      549         v-receiver = if available buf_clients then  buf_clients.obj-name else '':U
      550       .
      551       find first buf_clients no-lock
      552           where buf_clients.obj-type = buf_wth-doc.obj-type
      553             and buf_clients.obj-code = buf_wth-doc.obj-code
      554       .
      555       if buf_wth-doc.doc-type = 'при':U
      556       then assign
      557               v-org-from = buf_wth-doc.cli-name
      558               v-org-to   = buf_clients.obj-name + (if available wth-place
      559                                                       and wth-place.w-p-name <> ?
      560                                                    then ", " + wth-place.w-p-name else "")
      561       .
      562       else assign
      563               v-org-from = buf_clients.obj-name + (if available wth-place
      564                                                       and wth-place.w-p-name <> ?
      565                                                    then ", " + wth-place.w-p-name else "")
      566               v-org-to   = buf_wth-doc.cli-name
      567       .
      568       assign
      569           v-temp-string = "Д О К У М Е Н Т   №  " + string(buf_wth-doc.doc-code)
      570       .
      571       assign v-temp-position = center-field( 5, 130, length(v-temp-string) )         v-temp-string   = fill(" ", v-temp-position - 1) + v-temp-string.
      572       put stream out-stream
      573           skip
      574           buf_host.obj-name
      575           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) )
      576                             format "X(12)"   at right-field(130 - 5, 12)
      577           skip
      578             buf_clients.obj-name
      579           skip(2)
      580               v-temp-string format "X(130)"
      581           skip
      582           "движения материальных ценностей"
      583                             format "X(31)"   at center-field( 5, 130, 31 )
      584           skip(2)
      585           space (5) "Смена: "
      586           buf_wth-doc.shift-name format "X(12)"
      587           " от "
      588           buf_wth-doc.shift-date format "99/99/9999"
      589       .
      590       find first ub.wealth no-lock
      591           where ub.wealth.wth-code = buf_wth-line.wth-code
      592       .
      593       put stream out-stream
      594           skip(1)
      595           space (5) "Наименование материальных ценностей: "
      596           space(44 - 37) ub.wealth.wth-name      format "X(65)"
      597           skip
      598           space (5) "Источник поступления: "
      599           space(44 - 22) v-org-from           format "X(65)"
      600           skip
      601           space (5) "Получатель: "
      602           space(44 - 12) v-org-to             format "X(65)"
      603           skip
      604           space (5) "Сумма движения материальных ценностей: "
      605           space(44 - 39) (if buf_wth-doc.status_ = 'факт':U
      606                                     then buf_wth-line.fact-sum
      607                                     else buf_wth-line.doc-sum)       format "z,zzz,zzz,zz9.99"
      608       .
      609           find first  buf_wth-dtl no-lock
      610               where buf_wth-dtl.doc-code = buf_wth-line.doc-code
      611                 and buf_wth-dtl.wth-code = buf_wth-line.wth-code
      612           no-error.
      613           if available buf_wth-dtl
      614           then do:
      615               put stream out-stream
      616                   skip(1)
      617                   space (5) "Расшифровка суммы: "
      618               .
      619               for each ub.wth-par no-lock
      620                  where ub.wth-par.wth-code = buf_wth-line.wth-code
      621               break by ub.wth-par.par-feat
      622               :
      623                   find first buf_wth-dtl no-lock
      624                        where buf_wth-dtl.doc-code = buf_wth-line.doc-code
      625                          and buf_wth-dtl.wth-code = buf_wth-line.wth-code
      626                          and buf_wth-dtl.w-p-code = buf_wth-line.w-p-code
      627                          and buf_wth-dtl.par-code = ub.wth-par.par-code
      628                   no-error.
      629                   if first-of(ub.wth-par.par-feat)
      630                   then do:
      631                       if not first(ub.wth-par.par-feat)
      632                       then do:
      633                           put stream out-stream
      634                             skip
      635                               v-single-line format "X(65)" at 40
      636                             skip(2)
      637                           .
      638                       end.
      639                       put stream out-stream
      640                           skip
      641                           v-single-line format "X(65)" at 40
      642                         skip
      643                           space (5 + 15)
      644                           ub.wth-par.par-feat format "X(15)"
      645                           "|" at 40
      646                           "Номинал" at center-field(40, 40 + 21, 7)
      647                           "|" at 40 + 21
      648                           "|" at 40 + 25
      649                           "Количество" at center-field(40 + 25, 40 + 38, 10)
      650                           "|" at 40 + 38
      651                           "|" at 40 + 42
      652                           "Сумма" at center-field(40 + 42, 40 + 64, 10)
      653                           "|" at 40 + 64
      654                       .
      655                   end.
      656                   put stream out-stream
      657                     skip
      658                       "|"  at 40
      659                       v-single-line format "X(63)"
      660                       "|"
      661                     skip
      662                       "|" at 40
      663                       string(ub.wth-par.par-val, "z,zzz,zz9") + " " + string(ub.wth-par.par-unit)
      664                                           format "X(19)"
      665                       "|" at 40 + 21
      666                       "x" at center-field(40 + 21, 40 + 25, 1)
      667                       "|" at 40 + 25
      668                   .
      669                   if available buf_wth-dtl
      670                   then put stream out-stream
      671                       buf_wth-dtl.doc-sum / ub.wth-par.par-rate at center-field(40 + 25, 40 + 38, 10)
      672                   .
      673                   put stream out-stream
      674                       "|" at 40 + 38
      675                       "=" at center-field(40 + 38, 40 + 42, 1)
      676                       "|" at 40 + 42
      677                   .
      678                   if available buf_wth-dtl
      679                   then put stream out-stream
      680                       buf_wth-dtl.doc-sum format "zzz,zzz,zz9.99" at center-field(40 + 42, 40 + 64, 15)
      681                   .
      682                   put stream out-stream
      683                       "|" at 40 + 64
      684                   .
      685                   if available buf_wth-dtl
      686                   then accumulate
      687                     buf_wth-dtl.doc-sum (total)
      688                   .
      689               end.
      690               put stream out-stream
      691                 skip
      692                   v-single-line format "X(65)" at 40
      693                   "Итого: " at right-field(40 + 42, 7)
      694                   space(5) (accum total buf_wth-dtl.doc-sum)
      695                                 format "z,zzz,zzz,zz9.99"
      696               .
      697           end.
      698       if line-counter( out-stream ) + 8 > page-size( out-stream )
      699       then page stream out-stream.
      700       put stream out-stream
      701           skip(2)
      702           space (5) "Документ составил:    "
      703           v-operator format "X(60)"
      704           "подпись _______________________________"
      705           skip(2)
      706           space (5) "ПЕРЕДАЛ          "
      707           v-deliver format "X(65)"
      708           "подпись _______________________________"
      709           skip(1)
      710           space (5) "ПОЛУЧИЛ          "
      711           v-receiver format "X(65)"
      712           "подпись _______________________________"
      713       .
      714   end.
      715   output stream out-stream close.
      716   if session :set-wait-state( "" ) then.
      717   if g#quest-print = false
      718   then do:
      719     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      720                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      721                                         OUTPUT g#log ).
      722   end.
      723   else do:
      724     os-command silent
      725       value( "COPY /b " +
      726         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      727         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      728         string( session:temp-directory) +  "$" + string( g#report-num )
      729                 ) .
      730     os-command silent
      731       value( "COPY /b " +
      732         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      733         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      734         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      735                 ) .
      736   end.
      737   end.
