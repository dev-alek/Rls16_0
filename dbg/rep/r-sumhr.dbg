     1170             If byobject then v-obj-code = obj-list.obj-code.
     1171             else v-obj-code = 0.
     1172             _chk-doc4:
     1173             for EACH chk-doc WHERE
     1174                   chk-doc.obj-type = obj-list.obj-type AND
     1175                   chk-doc.obj-code = obj-list.obj-code AND
     1176                   chk-doc.chk-date >= X-date-start AND
     1177                   chk-doc.chk-date <= X-date-end AND
     1178                   chk-doc.d-card <> "":U NO-LOCK,
