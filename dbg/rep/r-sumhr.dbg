     1180               USE-INDEX doc,
     1181               FIRST bar-code WHERE bar-code.b-code = chk-gds.b-code NO-LOCK ,
     1182               FIRST goods WHERE goods.gds-code = bar-code.gds-code NO-LOCK:
     1183               if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc4.
     1184               if rs-dis-card = 1 then do:
