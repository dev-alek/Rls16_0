      570   define variable var-report-r-b as character no-undo .
      571   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      572   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      573     (output var-report-r-b
      574     )  .
      575   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      576   DEFINE SHARED temp-table grp-h no-undo
      577       field obj-code like ub.clients.obj-code
      578       field grp-code like ub.goods.grp-code
      579       field other-code as integer
      580       field sum      as   decimal extent 24
      581       field sum_disc as   decimal extent 24
      582       field num-chk as integer extent 24 format ">>>>>9"
      583       INDEX pi IS PRIMARY obj-code grp-code other-code ASCENDING .
      584   DEFINE SHARED temp-table gds-h no-undo
      585      field obj-code like ub.clients.obj-code
      586       field grp-code like ub.goods.grp-code
      587       field b-code   like ub.bar-code.b-code
      588       field gds-name like ub.goods.gds-name
      589       field uniq     as   char
      590       field artic    like ub.goods.artic
      591       field sum      as   decimal extent 24
      592       field sum_disc as   decimal extent 24
      593       INDEX pi IS PRIMARY obj-code grp-code b-code ASCENDING
      594       INDEX uu obj-code grp-code uniq ASCENDING .
      595   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      596   define variable v-waitfram-action01         as character   no-undo .
      597   define variable v-waitfram-action02         as character   no-undo .
      598   define variable v-waitfram-action03         as character   no-undo .
      599   define variable mWaitFramTextBeg            as character   no-undo.
      600   define variable mWaitFramTextEnd            as character   no-undo.
      601   define variable mWaitFramView               as logical     no-undo.
      602   define variable mWaitProcEvent              as logical     no-undo init yes.
      603   define variable mWaitFramInterval           as integer     no-undo init 1 .
      604   define variable mWaitFramStop               as logical     no-undo.
      605   define variable mWaitFramStopUser           as logical     no-undo.
      606   define variable mWaitFramStopTimeOut        as logical     no-undo.
      607   define variable mWaitFramStartProc          as datetime-tz no-undo.
      608   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      609   define button B-WaitFramStop auto-end-key
      610        label "Стоп"
      611        size 10 by 1 tooltip "Остоновить процесс".
      612   define button B-viewProcInfo
      613        label "Информация"
      614        size 15 by 1 tooltip "Информация о процесс".
      615   define frame waitfram
      616     v-waitfram-action01 format "x(72)" no-label skip
      617     v-waitfram-action02 format "x(72)" no-label skip
      618     v-waitfram-action03 format "x(72)" no-label skip
      619     B-viewProcInfo
      620     B-WaitFramStop at row 4 col 30
      621     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      622     .
      623   define new global shared variable mBatchMode as logical no-undo init ?.
      624   define variable mFramBachModHandle as handle no-undo.
      625   mFramBachModHandle = frame waitfram:handle.
      626   define variable mFameOldVis as logical no-undo.
      627   define variable mVisCUrentVin as logical no-undo.
      628   if session:batch-mode
      629   then
      630      mBatchMode = yes.
      631   if mBatchMode = ? then do:
      632     mVisCUrentVin = current-window:visible.
      633     mFameOldVis = mFramBachModHandle:visible.
      634     mFramBachModHandle:visible  = yes.
      635     mBatchMode = mFramBachModHandle:visible ne yes.
      636     mFramBachModHandle:visible = mFameOldVis.
      637     current-window:visible = mVisCUrentVin.
      638   end.
      639    if  log-manager:logfile-name ne ?
      640     then DO:
      641         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      642         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      643         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      644     end.
      645   on choose of B-WaitFramStop in frame waitfram
      646   do:
      647     mWaitFramStop = yes.
      648     mWaitFramStopUser = yes.
      649   end.
      650   function waitfram-check-timeout returns logical():
      651      define variable vtime as int64 no-undo.
      652      if mWaitFramStopTimeOut
      653      then
      654         return yes.
      655      vtime = ( now - mWaitFramStartProc ) / 1000 .
      656      if     mWaitFramTimeOut ne ?
      657         and mWaitFramTimeOut ne 0
      658         and mWaitFramTimeOut lt vtime
      659      then do:
      660         mWaitFramStopTimeOut = yes.
      661      end.
      662      return mWaitFramStopTimeOut.
      663   end.
      664   procedure waitfram-hide :
      665     if not session:batch-mode
      666     then do
      667     on error undo, return error return-value
      668     :
      669       pause 0 before-hide .
      670       if not mBatchMode then
      671         hide frame waitfram .
      672     if     not mWaitFramView
      673        and mWaitProcEvent
      674     then
      675       process events .
      676     end.
      677   end procedure.
      678   procedure waitfram-show :
      679     define input  parameter p-message as character no-undo .
      680     define variable v-left-margin as integer   no-undo .
      681     if not session:batch-mode
      682     then do
      683     on error undo, return error return-value
      684     :
      685       if length(p-message) <= 70 then do:
      686         assign
      687           v-left-margin = integer((70 - length(p-message)) / 2)
      688         .
      689         assign
      690           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      691         .
      692         assign
      693           v-waitfram-action01 = " "
      694           v-waitfram-action02 = " "
      695                                    + fill(" ", v-left-margin)
      696                                    + p-message
      697           v-waitfram-action03 = " "
      698         .
      699       end.
      700       else do:
      701         define variable vRindex1 as integer no-undo.
      702         define variable vRindex2 as integer no-undo.
      703         vRindex1 = r-index(p-message," ",70).
      704         if vRindex1 = 0
      705         then
      706            vRindex1 = 70.
      707         if length(p-message)  <= vRindex1 + 70 then do:
      708           assign
      709             v-waitfram-action01 = " "
      710             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      711             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      712           .
      713         end.
      714         else do:
      715           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      716           if vRindex2 <= vRindex1
      717           then
      718              vRindex2 = vRindex1 + 70.
      719           assign
      720             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      721             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      722             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      723           .
      724         end.
      725       end.
      726       B-viewProcInfo:visible   in frame waitfram = no.
      727       B-viewProcInfo:sensitive in frame waitfram = no.
      728       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      729       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      730       if  (   mWaitFramView
      731          or  mWaitProcEvent)
      732          and not mBatchMode
      733       then
      734          display
      735             v-waitfram-action01 skip
      736             v-waitfram-action02 skip
      737             v-waitfram-action03 skip
      738          with frame waitfram .
      739       if     mWaitFramView
      740          then do:
      741             if     mWaitFramInterval ne ?
      742                and not mBatchMode
      743             then
      744                wait-for go of frame waitfram pause mWaitFramInterval.
      745          end.
      746          else
      747             if     mWaitProcEvent
      748                and not mBatchMode
      749             then
      750                process events .
      751     end.
      752   end procedure.
      753      procedure waitfram-show-this:
      754         define input  parameter iInterval as int64 no-undo.
      755         define variable vtime as int64 no-undo.
      756         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      757         mWaitFramInterval = iInterval.
      758         run waitfram-show (substitute("&1&2 &3&4" ,
      759                                       mWaitFramTextBeg ,
      760                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      761                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      762                                       mWaitFramTextEnd
      763                                      )
      764                           ).
      765      end.
      766      procedure WaitFramRunPause:
      767         define input  parameter iInterval as dec no-undo.
      768         define variable vStart  as datetime-tz no-undo.
      769         define variable vend    as datetime-tz no-undo.
      770         define variable vint as int64 no-undo.
      771         define variable vOk as logical no-undo.
      772         vStart = now.
      773         vend   = vStart.
      774         publish "WaitFramPause" (iInterval,output vOk).
      775         vend   =  now.
      776         vint = vend - vStart.
      777         vint = iInterval - vint / 1000.
      778         if     not mWaitFramStop
      779            and (   vint > 0
      780                 or (    not vOk
      781                     and iInterval eq ?
      782                     )
      783                 )
      784         then
      785            run waitfram-show-this (iInterval).
      786         vend   =  now.
      787         vint = vend - vStart.
      788         vint = iInterval - vint / 1000.
      789         if     not mWaitFramStop
      790            and vint > 0
      791         then do:
      792            run gbl/pause.p (vint * 1000).
      793         end.
      794         if iInterval ne ?
      795         then
      796            publish "WaitFramStop".
      797         waitfram-check-timeout().
      798      end.
      799      procedure WaitFramWaitFor:
      800         define input  parameter iInterval as dec no-undo.
      801         assign
      802            mWaitFramStartProc   = now
      803            mWaitFramStopUser    = no
      804            mWaitFramStopTimeOut = no
      805         .
      806         block-wait:
      807         do while not mWaitFramStop:
      808            run WaitFramRunPause (iInterval).
      809            if  waitfram-check-timeout()
      810            then do:
      811               leave block-wait.
      812            end.
      813         end.
      814         run waitfram-hide.
      815      end.
      816   procedure waitfram-join :
      817     define input  parameter p-line-1  as character no-undo .
      818     define input  parameter p-line-2  as character no-undo .
      819     define input  parameter p-line-3  as character no-undo .
      820     define output parameter p-message as character no-undo .
      821     do
      822     on error undo, return error return-value
      823     :
      824       assign
      825         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      826                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      827                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      828       .
      829     end.
      830   end procedure.
      831   function waitfram-join-function returns character
      832     (input p-line-1 as character
      833     ,input p-line-2 as character
      834     ,input p-line-3 as character
      835     ).
      836     define variable v-message as character no-undo .
      837     run waitfram-join in this-procedure
      838       (input  p-line-1
      839       ,input  p-line-2
      840       ,input  p-line-3
      841       ,output v-message
      842       ) .
      843     return v-message .
      844   end function .
      845   define SHARED temp-table temp-dis-card-type no-undo like ub.dis-card-type.
      846   DEFINE VARIABLE ii-sec as integer no-undo .
      847   DEFINE VARIABLE accum-chk-doc as integer no-undo .
      848   DEFINE VARIABLE accum-chk-gds as integer no-undo .
      849   DEFINE VARIABLE accum-chk-pay as integer no-undo .
      850   define variable v-curr-r-b as character no-undo .
      851   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      852   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      853     (output v-curr-r-b
      854     )  .
      855   if num-entries(for-h-str) <> 24 then do:
      856     message
      857     vss-workfile vss-revision vss-description skip
      858     "Неверное значение параметра" for-h-str
      859     view-as alert-box error .
      860     return error .
      861   end.
      862   CASE with-goods:
      863     WHEN 0 or When 1 then do:
      864       run process-chk-doc in this-procedure no-error .
      865     END.
      866     WHEN 2 or when 3 then do:
      867       run process-chk-gds in this-procedure no-error .
      868     END.
      869     WHEN 4 then do:
      870       run process-chk-pay in this-procedure no-error .
      871     END.
      872   END CASE.
      873   procedure process-chk-doc :
      874   define variable v-obj-code like ub.clients.obj-code no-undo .
      875   define buffer tot_grp-h for grp-h.
      876     do
      877     on error undo, return error
      878     :
      879       run waitfram-show in this-procedure ("Ждите..." ).
      880       CASE t-dis-card:
      881         WHEN NO THEN DO:
      882           FOR EACH obj-list No-LOCK:
      883             If byobject then v-obj-code = obj-list.obj-code.
      884             else v-obj-code = 0.
      885               _chk-doc:
      886               for each ub.chk-doc WHERE
      887                   ub.chk-doc.obj-type = obj-list.obj-type AND
      888                   ub.chk-doc.obj-code = obj-list.obj-code AND
      889                   ub.chk-doc.chk-date >= X-date-start AND
      890                   ub.chk-doc.chk-date <= X-date-end NO-LOCK
      891               USE-INDEX obj-date :
      892               if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
      893   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      894   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
      895   IF With-goods = 0 then do:
      896     FIND FIRST grp-h WHERE
      897             grp-h.obj-code = v-obj-code
      898         AND grp-h.grp-code = 0
      899         NO-ERROR .
      900    if v-obj-code > 0 then
      901     FIND FIRST tot_grp-h WHERE
      902             tot_grp-h.obj-code = 0
      903         AND tot_grp-h.grp-code = 0
      904         NO-ERROR .
      905   end.
      906   else do:
      907     FIND FIRST grp-h WHERE
      908             grp-h.obj-code = v-obj-code
      909         AND grp-h.grp-code = chk-doc.pay-desk
      910         AND grp-h.other-code = chk-doc.obj-code NO-ERROR .
      911    if v-obj-code > 0 then
      912     FIND FIRST tot_grp-h WHERE
      913             tot_grp-h.obj-code = 0
      914         AND tot_grp-h.grp-code = 0
      915         and tot_grp-h.other-code = 0 NO-ERROR .
      916   end.
      917   if NOT available grp-h then do:
      918       CREATE grp-h .
      919       assign
      920       grp-h.grp-code             = (IF with-goods = 1 THEN chk-doc.pay-desk else 0)
      921       grp-h.obj-code             = (IF with-goods = 1 then chk-doc.obj-code else v-obj-code)
      922       grp-h.other-code           = (IF with-goods = 1 then chk-doc.obj-code else 0)
      923       grp-h.sum[ii-sec + 1]      = 0
      924       grp-h.sum_disc[ii-sec + 1] = 0
      925       grp-h.num-chk[ii-sec + 1]  = 0
      926       .
      927   end.
      928   if v-obj-code > 0 AND NOT available tot_grp-h then do:
      929       CREATE tot_grp-h .
      930       assign
      931       tot_grp-h.grp-code             = 0
      932       tot_grp-h.obj-code             = 0
      933       tot_grp-h.other-code           = 0
      934       tot_grp-h.sum[ii-sec + 1]      = 0
      935       tot_grp-h.sum_disc[ii-sec + 1] = 0
      936       tot_grp-h.num-chk[ii-sec + 1]  = 0
      937       .
      938   end.
      939   assign
      940   grp-h.sum[ii-sec + 1]      = grp-h.sum[ii-sec + 1] + chk-doc.tot-doc
      941   grp-h.sum_disc[ii-sec + 1] = grp-h.sum_disc[ii-sec + 1] + chk-doc.discnt
      942   grp-h.num-chk[ii-sec + 1]  = grp-h.num-chk[ii-sec + 1] + 1
      943   .
      944   if v-obj-code > 0 then
      945   assign
      946   tot_grp-h.sum[ii-sec + 1]      = tot_grp-h.sum[ii-sec + 1] + chk-doc.tot-doc
      947   tot_grp-h.sum_disc[ii-sec + 1] = tot_grp-h.sum_disc[ii-sec + 1] + chk-doc.discnt
      948   tot_grp-h.num-chk[ii-sec + 1]  = tot_grp-h.num-chk[ii-sec + 1] + 1
      949   .
      950   PROCESS EVENTS .
      951   accum-chk-doc = accum-chk-doc + 1.
      952   if ( ( ACCUM-chk-doc ) modulo 50 ) = 0 AND
      953         ( accum-chk-doc ) >= 50
      954   then
      955   run waitfram-show in this-procedure ( "Обработано  чеков : " + string( ACCUM-chk-doc ) ) .
      956             end.
      957           END.
      958         END.
      959         WHEN YES THEN DO:
      960           FOR EACH obj-list No-LOCK:
      961             If byobject then v-obj-code = obj-list.obj-code.
      962             else v-obj-code = 0.
      963              _chk-doc2:
      964              for EACH chk-doc WHERE
      965                   chk-doc.obj-type = obj-list.obj-type AND
      966                   chk-doc.obj-code = obj-list.obj-code AND
      967                   chk-doc.chk-date >= X-date-start AND
      968                   chk-doc.chk-date <= X-date-end AND
      969                   chk-doc.d-card <> "":U NO-LOCK
      970                :
      971                if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc2.
      972             if rs-dis-card = 1 then do:
      973               FIND FIRST ub.dis-card No-LOCK WHERE
      974                 ub.dis-card.d-card = ub.chk-doc.d-card no-error .
      975                 if not available ub.dis-card then next.
      976                 if not can-find(first temp-dis-card-type No-LOCK WHERE
      977                                       temp-dis-card-type.type = ub.dis-card.type AND
      978                                       temp-dis-card-type.emitent-host-code = ub.dis-card.emitent-host-code) then next.
      979             end.
      980   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      981   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
      982   IF With-goods = 0 then do:
      983     FIND FIRST grp-h WHERE
      984             grp-h.obj-code = v-obj-code
      985         AND grp-h.grp-code = 0
      986         NO-ERROR .
      987    if v-obj-code > 0 then
      988     FIND FIRST tot_grp-h WHERE
      989             tot_grp-h.obj-code = 0
      990         AND tot_grp-h.grp-code = 0
      991         NO-ERROR .
      992   end.
      993   else do:
      994     FIND FIRST grp-h WHERE
      995             grp-h.obj-code = v-obj-code
      996         AND grp-h.grp-code = chk-doc.pay-desk
      997         AND grp-h.other-code = chk-doc.obj-code NO-ERROR .
      998    if v-obj-code > 0 then
      999     FIND FIRST tot_grp-h WHERE
     1000             tot_grp-h.obj-code = 0
     1001         AND tot_grp-h.grp-code = 0
     1002         and tot_grp-h.other-code = 0 NO-ERROR .
     1003   end.
     1004   if NOT available grp-h then do:
     1005       CREATE grp-h .
     1006       assign
     1007       grp-h.grp-code             = (IF with-goods = 1 THEN chk-doc.pay-desk else 0)
     1008       grp-h.obj-code             = (IF with-goods = 1 then chk-doc.obj-code else v-obj-code)
     1009       grp-h.other-code           = (IF with-goods = 1 then chk-doc.obj-code else 0)
     1010       grp-h.sum[ii-sec + 1]      = 0
     1011       grp-h.sum_disc[ii-sec + 1] = 0
     1012       grp-h.num-chk[ii-sec + 1]  = 0
     1013       .
     1014   end.
     1015   if v-obj-code > 0 AND NOT available tot_grp-h then do:
     1016       CREATE tot_grp-h .
     1017       assign
     1018       tot_grp-h.grp-code             = 0
     1019       tot_grp-h.obj-code             = 0
     1020       tot_grp-h.other-code           = 0
     1021       tot_grp-h.sum[ii-sec + 1]      = 0
     1022       tot_grp-h.sum_disc[ii-sec + 1] = 0
     1023       tot_grp-h.num-chk[ii-sec + 1]  = 0
     1024       .
     1025   end.
     1026   assign
     1027   grp-h.sum[ii-sec + 1]      = grp-h.sum[ii-sec + 1] + chk-doc.tot-doc
     1028   grp-h.sum_disc[ii-sec + 1] = grp-h.sum_disc[ii-sec + 1] + chk-doc.discnt
     1029   grp-h.num-chk[ii-sec + 1]  = grp-h.num-chk[ii-sec + 1] + 1
     1030   .
     1031   if v-obj-code > 0 then
     1032   assign
     1033   tot_grp-h.sum[ii-sec + 1]      = tot_grp-h.sum[ii-sec + 1] + chk-doc.tot-doc
     1034   tot_grp-h.sum_disc[ii-sec + 1] = tot_grp-h.sum_disc[ii-sec + 1] + chk-doc.discnt
     1035   tot_grp-h.num-chk[ii-sec + 1]  = tot_grp-h.num-chk[ii-sec + 1] + 1
     1036   .
     1037   PROCESS EVENTS .
     1038   accum-chk-doc = accum-chk-doc + 1.
     1039   if ( ( ACCUM-chk-doc ) modulo 50 ) = 0 AND
     1040         ( accum-chk-doc ) >= 50
     1041   then
     1042   run waitfram-show in this-procedure ( "Обработано  чеков : " + string( ACCUM-chk-doc ) ) .
     1043             END.
     1044           end.
     1045         END.
     1046       END CASE.
     1047       run waitfram-hide in this-procedure .
     1048     end.
     1049   end procedure.
     1050   procedure process-chk-gds :
     1051   define variable v-obj-code like ub.clients.obj-code no-undo .
     1052   define buffer tot_grp-h for grp-h.
     1053   define buffer tot_gds-h for gds-h.
     1054     do
     1055     on error undo, return error
     1056     :
     1057       run waitfram-show in this-procedure ("Ждите..." ).
     1058       CASE t-dis-card:
     1059         when no then do:
     1060           FOR EACH obj-list NO-LOCK:
     1061             If byobject then v-obj-code = obj-list.obj-code.
     1062             else v-obj-code = 0.
     1063             _chk-doc3:
     1064             for EACH ub.chk-doc WHERE
     1065                   ub.chk-doc.obj-type = obj-list.obj-type AND
     1066                   ub.chk-doc.obj-code = obj-list.obj-code AND
     1067                   ub.chk-doc.chk-date >= X-date-start AND
     1068                   ub.chk-doc.chk-date <= X-date-end NO-LOCK
     1069               USE-INDEX obj-date ,
     1070               EACH ub.chk-gds WHERE ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOCK
     1071               USE-INDEX doc,
     1072               FIRST ub.bar-code WHERE ub.bar-code.b-code = ub.chk-gds.b-code NO-LOCK ,
     1073               FIRST ub.goods WHERE ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK:
     1074               if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc3.
     1075   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
