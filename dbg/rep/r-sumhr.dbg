     1186                   ub.dis-card.d-card = ub.chk-doc.d-card no-error .
     1187                   if not available ub.dis-card then next.
     1188                   if not can-find(first temp-dis-card-type No-LOCK WHERE
     1189                                         temp-dis-card-type.type = ub.dis-card.type AND
     1190                                         temp-dis-card-type.emitent-host-code = ub.dis-card.emitent-host-code) then next.
     1191               end.
