     1087       assign
     1088       grp-h.grp-code             = goods.grp-code
     1089       grp-h.obj-code             = v-obj-code
     1090       grp-h.sum[ii-sec + 1]      = 0
     1091       grp-h.sum_disc[ii-sec + 1] = 0
     1092       .
