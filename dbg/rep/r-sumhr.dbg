     1110   tot_grp-h.sum_disc[ii-sec + 1] = tot_grp-h.sum_disc[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.discnt
     1111   .
     1112   if With-Goods = 3 then do:
     1113       FIND FIRST gds-h WHERE
     1114                       gds-h.obj-code = v-obj-code
     1115                   AND gds-h.grp-code = goods.grp-code
     1116                   AND gds-h.b-code = bar-code.b-code NO-ERROR .
     1117       if v-obj-code > 0 then
     1118       FIND FIRST tot_gds-h WHERE
     1119                       tot_gds-h.obj-code = 0
     1120                   AND tot_gds-h.grp-code = goods.grp-code
     1121                   AND tot_gds-h.b-code = bar-code.b-code NO-ERROR .
     1122       if NOT available gds-h then do:
     1123           CREATE gds-h .
     1124           assign
     1125           gds-h.obj-code             = v-obj-code
     1126           gds-h.gds-name             = goods.gds-name
     1127           gds-h.grp-code             = goods.grp-code
     1128           gds-h.b-code               = bar-code.b-code
     1129           gds-h.uniq                 = goods.artic + goods.prod-type + string( goods.prod-code )
     1130           gds-h.artic                = goods.artic
     1131           gds-h.sum[ii-sec + 1]      = 0
     1132           gds-h.sum_disc[ii-sec + 1] = 0
     1133           .
