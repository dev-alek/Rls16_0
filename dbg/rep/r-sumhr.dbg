     1100       tot_grp-h.sum_disc[ii-sec + 1] = 0
     1101       .
     1102   end.
     1103   assign
     1104   grp-h.sum[ii-sec + 1]      = grp-h.sum[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.price-base
     1105   grp-h.sum_disc[ii-sec + 1] = grp-h.sum_disc[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.discnt
     1106   .
     1107   if v-obj-code > 0 then
     1108   assign
