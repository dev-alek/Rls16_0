     1368                   ub.chk-doc.obj-type = obj-list.obj-type AND
     1369                   ub.chk-doc.obj-code = obj-list.obj-code AND
     1370                   ub.chk-doc.chk-date >= X-date-start AND
     1371                   ub.chk-doc.chk-date <= X-date-end AND
     1372                   ub.chk-doc.d-card <> "" No-LOCK ,
     1373               EACH ub.chk-pay NO-LOCK WHERE
     1374                     ub.chk-pay.doc-code = ub.chk-doc.doc-code :
     1375                         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc6.
     1376               if rs-dis-card = 1 then do:
     1377                 FIND FIRST ub.dis-card No-LOCK WHERE
     1378                   ub.dis-card.d-card = ub.chk-doc.d-card no-error .
     1379                   if not available ub.dis-card then next.
     1380                   if not can-find(first temp-dis-card-type No-LOCK WHERE
     1381                                         temp-dis-card-type.type = ub.dis-card.type AND
     1382                                         temp-dis-card-type.emitent-host-code = ub.dis-card.emitent-host-code) then next.
     1383               end.
     1384   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1385   ii-sec = integer( truncate( chk-doc.chk-time / 3600 , 0 ) ) .
     1386   FIND FIRST grp-h WHERE
     1387              grp-h.grp-code = v-obj-code
     1388          AND grp-h.grp-code = chk-pay.pay-code
     1389          ANd grp-h.other-code = chk-pay.curr-code NO-ERROR .
     1390   if v-obj-code > 0 then do:
     1391     FIND FIRST tot_grp-h WHERE
     1392               tot_grp-h.obj-code = 0
     1393           AND tot_grp-h.grp-code = chk-pay.pay-code
     1394           ANd tot_grp-h.other-code = chk-pay.curr-code NO-ERROR .
     1395   end.
     1396   if NOT available grp-h then do:
     1397       CREATE grp-h .
     1398       assign
     1399       grp-h.obj-code            = v-obj-code
     1400       grp-h.grp-code            = chk-pay.pay-code
     1401       grp-h.other-code          = chk-pay.curr-code
     1402       grp-h.sum[ii-sec + 1]     = 0
     1403       grp-h.num-chk[ii-sec + 1] = 0
     1404       .
     1405   end.
     1406   if v-obj-code > 0 AND NOT available tot_grp-h then do:
     1407       CREATE tot_grp-h .
     1408       assign
     1409       tot_grp-h.obj-code            = 0
     1410       tot_grp-h.grp-code            = chk-pay.pay-code
     1411       tot_grp-h.other-code          = chk-pay.curr-code
     1412       tot_grp-h.sum[ii-sec + 1]     = 0
     1413       tot_grp-h.num-chk[ii-sec + 1] = 0
     1414       .
     1415   end.
     1416   assign
     1417   grp-h.sum[ii-sec + 1]     = grp-h.sum[ii-sec + 1]  + (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl)
     1418   grp-h.num-chk[ii-sec + 1] = grp-h.num-chk[ii-sec + 1] + 1
     1419   .
     1420   if v-obj-code > 0 then
     1421   assign
     1422   tot_grp-h.sum[ii-sec + 1]     = tot_grp-h.sum[ii-sec + 1]  + (if v-curr-r-b = 'base':U then chk-pay.tot-base else chk-pay.tot-rubl)
     1423   tot_grp-h.num-chk[ii-sec + 1] = tot_grp-h.num-chk[ii-sec + 1] + 1
     1424   .
     1425   PROCESS EVENTS .
     1426   accum-chk-pay = accum-chk-pay .
     1427   if ( ( ACCUM-chk-pay) modulo 50 ) = 0 AND
     1428       ( ACCUM-chk-pay ) >= 50
     1429   then
     1430   run waitfram-show in this-procedure ( "Обработано строк оплат : " + string( ACCUM-chk-pay ) ) .
     1431             end.
     1432           END.
     1433         end.
     1434       end.
     1435       run waitfram-hide in this-procedure .
     1436     end.
     1437   end procedure.
