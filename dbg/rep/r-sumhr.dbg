     1141           tot_gds-h.b-code               = bar-code.b-code
     1142           tot_gds-h.uniq                 = goods.artic + goods.prod-type + string( goods.prod-code )
     1143           tot_gds-h.artic                = goods.artic
     1144           tot_gds-h.sum[ii-sec + 1]      = 0
     1145           tot_gds-h.sum_disc[ii-sec + 1] = 0
     1146           .
     1147       end.
     1148       assign
     1149       gds-h.sum[ii-sec + 1]      = gds-h.sum[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.price-base
     1150       gds-h.sum_disc[ii-sec + 1] = gds-h.sum_disc[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.discnt
     1151       .
