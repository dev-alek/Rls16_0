     1155       tot_gds-h.sum_disc[ii-sec + 1] = tot_gds-h.sum_disc[ii-sec + 1] + chk-gds.doc-qnty * chk-gds.discnt
     1156       .
     1157   end.
     1158   PROCESS EVENTS .
     1159   accum-chk-gds = accum-chk-gds .
     1160   if ( ( ACCUM-chk-gds) modulo 50 ) = 0 AND
     1161       ( ACCUM-chk-gds ) >= 50
     1162   then
     1163   run waitfram-show in this-procedure ("Обработано строк чеков : " +
