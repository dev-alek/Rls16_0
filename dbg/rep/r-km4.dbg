     4713   procedure torgconf-get-outogr-param:
     4714       define input parameter p-form-name  as character    no-undo.
     4715       define input parameter p-host-code  as integer      no-undo.
     4716       define input parameter p-obj-type   as character    no-undo.
     4717       define input parameter p-obj-code   as integer      no-undo.
     4718       define input parameter p-doc-code   as character      no-undo.
     4719       define buffer buf_firm          for ub.firm .
     4720       define buffer buf_clients       for ub.clients .
     4721       define buffer buf_sysconf       for ub.sysconf .
     4722       define buffer buf_shop          for ub.shop .
     4723       define buffer buf_store         for ub.store .
     4724       define buffer buf_person        for ub.person .
     4725       define buffer buf_trn-doc       for ub.trn-doc .
     4726       define buffer buf_wth-doc       for ub.wth-doc .
     4727      if  p-form-name <> 'wthtrg12':U
     4728      and p-form-name <> 'wthfct':U
     4729      and p-form-name <> 'wthm11':U
     4730      then do:
     4731       find first buf_trn-doc no-lock
     4732       where buf_trn-doc.doc-code = p-doc-code
     4733       no-error.
     4734       if v-torgconf-outogr = "no_print"
     4735         then do:
     4736            assign
     4737               v-torgconf-ogr-name = ""
     4738               v-torgconf-ogr-post = ""
     4739            .
     4740         end.
     4741      if v-torgconf-outogr  = "ruk_firm"
     4742            then do:
     4743            find first buf_sysconf no-lock
     4744            where buf_sysconf.host-code = p-host-code
     4745            no-error.
     4746            if available buf_sysconf
     4747            then do:
     4748               assign
     4749                  v-torgconf-ogr-post = buf_sysconf.head-position
     4750               .
     4751            end.
     4752            find first buf_clients no-lock
     4753                where buf_clients.obj-type = 'орг':U
     4754                and buf_clients.obj-code = p-host-code
     4755            .
     4756            find first buf_firm no-lock
     4757                where buf_firm.firm-code = buf_clients.obj-code
     4758            .
     4759            assign
     4760                v-torgconf-ogr-name = buf_firm.director
     4761            .
     4762         end.
     4763         if v-torgconf-outogr = "dir_obj"
     4764            then do:
     4765            find first buf_trn-doc no-lock
     4766            where buf_trn-doc.doc-code = p-doc-code
     4767            no-error.
     4768               CASE buf_trn-doc.obj-type:
     4769               WHEN 'маг':U
     4770               THEN DO:
     4771                  find first buf_shop no-lock
     4772                  where buf_shop.obj-code = buf_trn-doc.obj-code
     4773                  .
     4774                  assign
     4775                     v-torgconf-ogr-name = buf_shop.director
     4776                     v-torgconf-ogr-post = "Директор"
     4777                  .
     4778               END.
     4779               WHEN 'скл':U
     4780               THEN DO:
     4781                  find first buf_store no-lock
     4782                  where buf_store.obj-code = buf_trn-doc.obj-code
     4783                  .
     4784                  assign
     4785                     v-torgconf-ogr-name = buf_store.store-boss
     4786                     v-torgconf-ogr-post = "Директор"
     4787                  .
     4788               END.
     4789               OTHERWISE DO:
     4790                  assign
     4791                     v-torgconf-ogr-name = "":U
     4792                     v-torgconf-ogr-post = "":U
     4793                  .
     4794               END.
     4795               END CASE.
     4796            end.
     4797      if v-torgconf-outogr = "manag_doc"
     4798         then do:
     4799            find first buf_trn-doc no-lock
     4800            where buf_trn-doc.doc-code = p-doc-code
     4801            no-error.
     4802            if available buf_trn-doc
     4803            then do:
     4804               run rep/get-psn.p
     4805               (input buf_trn-doc.boss
     4806               ,output v-torgconf-ogr-name
