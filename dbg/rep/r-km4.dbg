      638   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      639   procedure paramls-clear :
      640     define buffer buf_temp-param for temp-param .
      641     do
      642     on error undo, return error return-value
      643     :
      644       for each buf_temp-param
      645       on error undo, return error
      646       :
      647         delete buf_temp-param .
      648       end.
      649     end.
      650   end procedure.
      651   procedure paramls-write :
      652     define input  parameter p-code     as character no-undo .
      653     define input  parameter p-sub-code as character no-undo .
      654     define input  parameter p-value    as character no-undo .
      655     define buffer buf_temp-param for temp-param .
      656     do
      657     on error undo, return error return-value
      658     :
      659       find first buf_temp-param
      660         where buf_temp-param.param-code     = p-code
      661           and buf_temp-param.param-sub-code = p-sub-code
      662         no-error .
      663       if not available buf_temp-param then do:
      664         create buf_temp-param .
      665         assign
      666           buf_temp-param.param-code     = p-code
      667           buf_temp-param.param-sub-code = p-sub-code
      668         .
      669       end.
      670       assign
      671         buf_temp-param.param-value = p-value
      672       .
      673     end.
      674   end procedure.
      675   procedure paramls-read :
      676     define input  parameter p-code          as character no-undo .
      677     define input  parameter p-sub-code      as character no-undo .
      678     define input  parameter p-default-value as character no-undo .
      679     define output parameter p-value         as character no-undo .
      680     define buffer buf_temp-param for temp-param .
      681     do
      682     on error undo, return error return-value
      683     :
      684       find first buf_temp-param
      685         where buf_temp-param.param-code     = p-code
      686           and buf_temp-param.param-sub-code = p-sub-code
      687         no-error .
      688       if available buf_temp-param then do:
      689         assign
      690           p-value = buf_temp-param.param-value
      691         .
      692       end.
      693       else do:
      694         assign
      695           p-value = p-default-value
      696         .
      697       end.
      698     end.
      699   end procedure.
      700   procedure paramls-append :
      701     define input  parameter p-code     as character no-undo .
      702     define input  parameter p-sub-code as character no-undo .
      703     define input  parameter p-value    as character no-undo .
      704     define buffer buf_temp-param for temp-param .
      705     do
      706     on error undo, return error return-value
      707     :
      708       find first buf_temp-param
      709            where buf_temp-param.param-code     = p-code
      710              and buf_temp-param.param-sub-code = p-sub-code
      711         no-error .
      712       if not available buf_temp-param then do:
      713         create buf_temp-param .
