     6290   function fnc-DD-MM-YYYY returns character
     6291   (input p-dat-date as date) forward.
     6292   function fnc-convert-dot-to-colon returns character
     6293   (input p-data as decimal, input p-accur as character) forward.
     6294   for each buf_cash-pay where buf_cash-pay.is-cash:
     6295       v-is-cash-list = v-is-cash-list + string(buf_cash-pay.cdpay-code) + ','.
     6296   end.
     6297   for each buf_obj-list
     6298     no-lock :
     6299      assign
     6300         v-obj-code = buf_obj-list.obj-code
     6301         v-obj-type =  buf_obj-list.obj-type
     6302      .
     6303     for each tt-cash-desk  no-lock
     6304        where tt-cash-desk.obj-code = buf_obj-list.obj-code
     6305     break
     6306     by tt-cash-desk.db-num
     6307     by tt-cash-desk.obj-code
     6308     by tt-cash-desk.pos-type
     6309     by tt-cash-desk.cash-num
     6310       :
     6311   define variable vss-include-info36 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6312   define variable chk-shift-open-time as logical no-undo init yes.
     6313   for each buf_chk-doc
     6314       where buf_chk-doc.obj-type    = 'маг':U
     6315         and buf_chk-doc.obj-code    = tt-cash-desk.obj-code
     6316         and ((buf_chk-doc.shift-date = x-date-start and X-tog-shift)
     6317           or (buf_chk-doc.chk-date   = x-date-start and not X-tog-shift))
     6318         and buf_chk-doc.pay-desk    = tt-cash-desk.cash-num
     6319         no-lock use-index shift
     6320         :
     6321         if X-tog-shift then do:
     6322           if buf_chk-doc.shift-num <> x-shift-alone then next.
     6323         end.
     6324         else do :
     6325           if buf_chk-doc.chk-date <> x-date-start then next.
     6326         end.
     6327         find first temp-str
     6328               where temp-str.cash-num = buf_chk-doc.pay-desk
     6329               no-error.
     6330             if available temp-str then do :
     6331               if buf_chk-doc.z-number > temp-str.z-number then do :
     6332                 assign temp-str.z-number = buf_chk-doc.z-number .
     6333               end.
     6334             end.
     6335             else do :
     6336           CREATE temp-str.
     6337           assign
     6338             temp-str.cash-num      = tt-cash-desk.cash-num
     6339             temp-str.z-number      = buf_chk-doc.z-number
     6340             temp-str.zero-counter  = 0
     6341             temp-str.chk-num       = buf_chk-doc.chk-num
     6342             temp-str.chk-shift-open-time = no.
     6343           for first buf_shift-cash
     6344              where buf_shift-cash.obj-type    = 'маг':U
     6345                and buf_shift-cash.obj-code    = tt-cash-desk.obj-code
     6346                and buf_shift-cash.shift-date  = x-date-start
     6347                and buf_shift-cash.shift-num   = x-shift-alone
     6348                and buf_shift-cash.cash-num    = tt-cash-desk.cash-num
     6349                :
     6350                   assign temp-str.chk-time-1 = buf_shift-cash.shift-open-time
     6351                          temp-str.chk-time-2 = buf_shift-cash.shift-close-time.
     6352                   if temp-str.chk-time-1 <> 0 then do:
     6353                       temp-str.chk-shift-open-time = yes.
     6354                   end.
     6355           end.                   .
     6356             end.
     6357         if temp-str.chk-time-2 = 0 then do:
     6358             assign temp-str.chk-time-2 = buf_chk-doc.chk-time.
     6359         end.
     6360         if temp-str.chk-shift-open-time = no then do:
     6361             assign temp-str.chk-time-1 = buf_chk-doc.chk-time.
     6362         end.
     6363         if lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0 then do :
     6364             for each buf_chk-pay no-lock where buf_chk-pay.doc-code = buf_chk-doc.doc-code:
     6365                 if lookup(string(buf_chk-pay.pay-code), v-is-cash-list) > 0 then do:
     6366                   temp-str.summ-nal = temp-str.summ-nal + buf_chk-pay.tot-rubl.
     6367                 end.
     6368                 for first buf_chk-pay-attr where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     6369                                                and buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     6370                                                and buf_chk-pay-attr.attr-code = "autotank-sum-return" no-lock:
     6371                       temp-str.summ-nal = temp-str.summ-nal - decimal(buf_chk-pay-attr.attr-value).
     6372                   end.
     6373                 if not can-find(first buf_cash-pay-attr where buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code
     6374                                            and buf_cash-pay-attr.curr-code = buf_chk-pay.curr-code
     6375                                            and buf_cash-pay-attr.attr-code = "kbo")
     6376                 and not can-find(first buf_cash-pay where buf_cash-pay.cdpay-code = buf_chk-pay.pay-code
     6377                                                       and buf_cash-pay.curr-code = buf_chk-pay.curr-code
     6378                                                       and buf_cash-pay.is-service-pay = yes) then do:
     6379                   temp-str.summ-sale = temp-str.summ-sale + buf_chk-pay.tot-rubl.
     6380                   for first buf_chk-pay-attr where buf_chk-pay-attr.doc-code = buf_chk-pay.doc-code
     6381                                                and buf_chk-pay-attr.line-num = buf_chk-pay.line-num
     6382                                                and buf_chk-pay-attr.attr-code = "autotank-sum-return" no-lock:
     6383                       temp-str.summ-sale = temp-str.summ-sale - decimal(buf_chk-pay-attr.attr-value).
     6384                   end.
     6385                 end.
     6386             end.
     6387         end.
     6388         if lookup(string(buf_chk-doc.chk-type), '6,96':U) > 0 then do :
     6389           for each buf_chk-pay no-lock
     6390                 where buf_chk-pay.doc-code = buf_chk-doc.doc-code :
     6391             find first buf_cash-pay-attr where  buf_cash-pay-attr.cdpay-code = buf_chk-pay.pay-code   and
     6392                                                 buf_cash-pay-attr.curr-code  = buf_chk-pay.curr-code  and
     6393                                                 buf_cash-pay-attr.attr-code  = "form_km3" no-lock no-error.
     6394             if available buf_cash-pay-attr and buf_cash-pay-attr.attr-value = "yes" then
     6395               assign
     6396                 temp-str.summ-return = temp-str.summ-return + ABS(buf_chk-pay.tot-rubl)
     6397               .
     6398           end.
     6399         end.
     6400         find first buf_sale-clients
     6401               where buf_sale-clients.obj-code = buf_chk-doc.cashier-psn-code
     6402                 and buf_sale-clients.obj-type = 'чел':U
     6403                 no-lock
     6404                 no-error.
     6405                 if available buf_sale-clients then do :
     6406                   assign
     6407                       temp-str.person = buf_sale-clients.obj-name
     6408                   .
     6409                 end.
     6410                 else do:
     6411                     assign
     6412                       temp-str.person = " Кассир  № " + string ( buf_chk-doc.cashier )
     6413                     .
     6414                 end.
     6415   end.
     6416   find first temp-str
     6417        where temp-str.cash-num = tt-cash-desk.cash-num
     6418        no-error.
     6419        if not available temp-str then do :
     6420         find first buf_chk-doc
     6421             where buf_chk-doc.obj-type    = 'маг':U
     6422               and buf_chk-doc.obj-code    = tt-cash-desk.obj-code
     6423               and (buf_chk-doc.shift-date <= x-date-start
     6424                 or buf_chk-doc.chk-date   <= x-date-start)
     6425               and buf_chk-doc.pay-desk    = tt-cash-desk.cash-num
     6426               and buf_chk-doc.z-number    <> 0
     6427               use-index shift no-error .
     6428               if available buf_chk-doc then do :
     6429                   if X-tog-shift then do:
     6430                     if ( buf_chk-doc.shift-num >= x-shift-alone
     6431                       and buf_chk-doc.shift-date = x-date-start )
     6432                       then next.
     6433                   end.
     6434                   else do :
     6435                     if buf_chk-doc.chk-date >= x-date-start then next.
     6436                   end.
     6437                   create temp-str.
     6438                   assign
     6439                     temp-str.cash-num = tt-cash-desk.cash-num
     6440                     temp-str.z-number = buf_chk-doc.z-number
     6441                   .
     6442               end.
     6443        end.
     6444   release temp-str.
     6445       if not can-find(first temp-str where temp-str.cash-num = tt-cash-desk.cash-num) then next.
     6446     end.
     6447   end.
     6448   find first temp-str no-error.
     6449   if not available temp-str then do:
     6450       if p-batch > 0 then do:
     6451       .
     6452       run cb_write-report-error in p-parent-handle ( input p-rebh
     6453                                                     ,input p-report-id
     6454                                                     ,input ?
     6455                                                     ,input '3':U
     6456                                                     ,input "Не было чеков за выбранный период!!").
     6457       RETURN.
     6458     end.
     6459     else do:
     6460       .
     6461       return.
     6462     end.
     6463   end.
     6464      FIND FIRST buf_cash-desk WHERE buf_cash-desk.cash-num = tt-cash-desk.cash-num
     6465                                 AND buf_cash-desk.db-num   = tt-cash-desk.db-num
     6466                                 AND buf_cash-desk.obj-code = tt-cash-desk.obj-code
     6467                                 AND buf_cash-desk.pos-type = tt-cash-desk.pos-type
     6468                               NO-LOCK
     6469                               NO-ERROR
     6470                               .
     6471      FIND first This_Object  WHERE This_Object.obj-type = 'маг':U
     6472                          AND This_Object.obj-code = tt-cash-desk.obj-code
     6473                        NO-LOCK.
     6474      FIND first ub.clients  WHERE ub.clients.obj-type   = 'орг':U
     6475                          AND ub.clients.obj-code     = This_Object.host-code
     6476                        NO-LOCK.
     6477      find first buf_firm where buf_firm.firm-code = ub.clients.obj-code
     6478                          no-lock
     6479                          .
     6480     FIND FIRST buf_cash-desk WHERE buf_cash-desk.cash-num = tt-cash-desk.cash-num
     6481                       AND buf_cash-desk.obj-code = This_Object.obj-code
     6482                       AND Buf_cash-desk.db-num   = This_Object.db-num
     6483                     NO-LOCK
     6484                     NO-ERROR
     6485                     .
     6486       v-kkm-model = tt-cash-desk.pos-type.
     6487       assign
     6488           v-boss          = buf_firm.director
     6489           v-kkm-code-reg  = buf_cash-desk.registration-code
     6490           v-kkm-code-prod = buf_cash-desk.serial-code.
     6491        run torgconf-read in this-procedure (
     6492         input "outprncd"
     6493       , input This_Object.host-code
     6494       , input This_Object.obj-type
     6495       , input This_Object.obj-code
     6496       ) no-error.
     6497       case clients.obj-type:
     6498          when 'орг':U
     6499          then do:
     6500               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6501               if available ub.firm
     6502               then do:
     6503                   assign
     6504                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6505                       t-addres = t-addres
     6506                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6507                               then ""
     6508                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6509                             )
     6510                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6511                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6512                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6513                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6514                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6515                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6516                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6517                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6518                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6519                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6520                       t-phone = ub.firm.phone
     6521                       t-inn   = ub.firm.inn
     6522                       t-okpo  = ub.firm.okpo
     6523                   .
     6524               end.
     6525          end.
     6526          when 'маг':U
     6527          then do:
     6528               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     6529               if available ub.shop
     6530               then do:
     6531                   assign
     6532                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6533                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6534                       t-phone = shop.phone
     6535                       t-inn = ""
     6536                       t-okpo = ""
     6537                   .
     6538               end.
     6539          end.
     6540          when 'скл':U
     6541          then do:
     6542               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6543               if available ub.store
     6544               then do:
     6545                   assign
     6546                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6547                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6548                       t-phone = ub.store.phone
     6549                       t-inn = ""
     6550                       t-okpo = ""
     6551                   .
     6552               end.
     6553          end.
     6554          when 'чел':U
     6555          then do:
     6556               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     6557               if available ub.person
     6558               then do:
     6559                   assign
     6560                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     6561                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     6562                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     6563                       t-phone = ub.person.phone1
     6564                       t-inn = ub.person.inn
     6565                       t-okpo = ub.person.okpo
     6566                   .
     6567               end.
     6568          end.
     6569       end case.
     6570     Case This_Object.obj-type :
     6571       when 'маг':U then do:
     6572         find first ub.shop
     6573         where ub.shop.obj-code = This_Object.obj-code
     6574           no-error.
     6575           if available ub.shop then do:
     6576             assign v-object-addr = ub.shop.addres1.
     6577           end.
     6578       end.
     6579       when 'скл':U then do:
     6580         find first ub.store
     6581         where ub.store.obj-code = This_Object.obj-code
     6582           no-error.
     6583           if available ub.store then do:
     6584             assign v-object-addr = ub.store.addres1.
     6585           end.
     6586       end.
     6587     end case.
     6588       if x-tog-shift then
     6589       do:
     6590           assign
     6591               v-shift-name = substitute("№&1 от &2", string(x-shift-alone), string(x-date-start)) .
     6592       end.
     6593       if v-torgconf-outprncd = yes then
     6594       do:
     6595           assign
     6596               v-organization = string( CAPS( ub.clients.obj-name )  + " (" + string(ub.clients.obj-code) + ") " ) + t-addres + " " + t-phone
     6597               v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ") " ) + v-object-addr
     6598               .
     6599       end.
     6600       else
     6601       do:
     6602           assign
     6603               v-organization = string( CAPS( ub.clients.obj-name ) ) + " " + t-addres + " " + t-phone
     6604               v-object       = string( CAPS( This_Object.obj-name ) ) + " " + v-object-addr
     6605               .
     6606       end.
     6607       find last  shift-obj where shift-obj.obj-code = v-obj-code and   shift-obj.obj-type = v-obj-type  and shift-obj.shift-date = x-Date-Start and shift-obj.shift-num   >= x-Shift-Start no-lock no-error .
     6608     if available shift-obj then do:
     6609           if shift-obj.close-date = ?  then shift-obj.close-date = today.
     6610         close-date = fnc-DD-MM-YYYY(date(string(shift-obj.close-date,"99/99/9999"))).
     6611         end.
     6612         else do:
     6613             close-date = fnc-DD-MM-YYYY(date(string(today,"99/99/9999"))).
     6614             end.
     6615       v-ii = num-entries(v-organization, " ") + 1.
     6616       if v-ii = 1 then
     6617       do:
     6618           v-txt-1 = v-organization.
     6619       end.
     6620       else
     6621       do:
     6622           if length(v-organization) > 78 then
     6623           do:
     6624               do v-i = 1 to v-ii + 1:
     6625                   v-txt-1 = v-txt-1 + (if v-txt-1 = "" then "" else " ") + entry(v-i, v-organization, " ").
     6626                   if length(v-txt-1) + 1 + length(entry((v-i + 1), v-organization, " ")) > 78 then
     6627                   do:
     6628                       leave.
     6629                   end.
     6630               end.
     6631               v-txt-2 = substring(v-organization, length(v-txt-1) + 2).
     6632           end.
     6633           else
     6634           do:
     6635               v-txt-1 = v-organization.
     6636           end.
     6637       end.
     6638   run get-full-path-RepViewer(output v-full-path-RepView).
     6639   run get-report-num in parParentProc(output g#report-num).
     6640   v-report-name = "KM-4".
     6641       for each temp-str :
     6642           assign
     6643            v-kkm-programm  = (if tt-cash-desk.pos-type = 'IBM-XML':U
     6644                         or tt-cash-desk.pos-type = 'IBM':U
     6645                         then  (if tt-cash-desk.cash-os = "LINUX"
     6646                                 then "UniFO-L V 4.0.K"
     6647                                 else "UniFO-IBS V 4.0.K" )
     6648                         else '')
     6649               v-kkm-num   = "(" + trim(string(temp-str.cash-num)) + ")"
     6650               number-cash = temp-str.cash-num.
     6651           run define-full-path-Report(input g#report-num, input number-cash, output v-file-name-rep-htm).
     6652           run create-file(v-file-name-rep-htm).
     6653           run html-rep.
     6654           run search-full-path-Report(input v-file-name-rep-htm).
     6655           v-search = v-search + " "  + search(v-file-name-rep-htm).
     6656       end.
     6657       run Report-Viewer(input v-full-path-RepView, input v-search).
