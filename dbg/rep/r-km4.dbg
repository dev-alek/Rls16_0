      993       def var t-okpo          like ub.firm.okpo      no-undo.
      994       def var t-temp-address  like ub.firm.addres1   no-undo.
      995   define new global shared variable g#lib-trn  as handle no-undo .
      996   define new global shared variable g#lib-trn2 as handle no-undo .
      997   define new global shared variable g#lib-trn3 as handle no-undo .
      998   define new global shared variable g#lib-trn4 as handle no-undo .
      999     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1000       define variable v-answ as logical no-undo .
     1001       if ( p-unit-base-cli-eq = true
     1002            and p-density = 1.0
     1003          )
     1004         or ( p-unit-base-cli-eq = false
     1005              and p-density <> ?
     1006              and p-density > 0.0
     1007              and p-density < 1.0
     1008            )
     1009       then do:
     1010         assign
     1011           v-answ = true
     1012         .
     1013       end.
     1014       else do:
     1015         assign
     1016           v-answ = false
     1017         .
     1018       end.
     1019       return v-answ.
     1020     end function.
