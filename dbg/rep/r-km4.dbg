     4544     ,output v-host-code
     4545     )  .
     4546         end.
     4547       if v-torgconf-outogr = "no_print"
     4548         then do:
     4549            assign
     4550               v-torgconf-ogr-name = ""
     4551               v-torgconf-ogr-post = ""
     4552            .
     4553         end.
