     4810            where buf_person.psn-code = buf_trn-doc.boss
     4811            no-error.
     4812            if available buf_person
     4813            then do:
     4814               v-torgconf-ogr-post = buf_person.position.
     4815            end.
     4816            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4817            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4818         end.
     4819      end.
     4820      else do:
     4821      find first buf_wth-doc no-lock
     4822         where buf_wth-doc.doc-code = p-doc-code
     4823         no-error.
     4824         if v-torgconf-outogr = "no_print"
     4825            then do:
     4826               assign
