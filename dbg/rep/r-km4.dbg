      192   def
      193    shared
      194   temp-table  obj-list no-undo
      195     field obj-type like ub.clients.obj-type
      196     field obj-code like ub.clients.obj-code
      197     field obj-name like ub.clients.obj-name
      198     field obj-id   as integer
