     7335   procedure get-full-path-RepViewer:
     7336       define output parameter p-fill-path-RepView as character no-undo.
     7337       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     7338       do:
     7339           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     7340       end.
     7341       else
     7342       do:
     7343           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     7344       end.
     7345   end procedure.
     7346   procedure search-full-path-Report:
     7347       define input parameter p-file-name as character no-undo.
     7348       if search(p-file-name) = ? then
     7349       do:
     7350           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     7351       end.
     7352       else
     7353       do:
     7354           p-file-name = search(p-file-name).
     7355       end.
     7356   end procedure.
     7357   procedure create-file:
     7358       define input parameter p-file-name as character no-undo.
     7359       output to value(string(p-file-name)).
     7360       output close.
     7361   end procedure.
     7362   procedure define-full-path-Report:
     7363       define input parameter p-rep-num as integer no-undo.
     7364        define input parameter number-cash-tt as integer.
     7365       define output parameter p-file-name-rep-htm as character no-undo.
     7366       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num + number-cash-tt) + ".html".
     7367   end procedure.
     7368   procedure Report-Viewer:
     7369       define input parameter p-full-path-RepView as character no-undo.
     7370       define input parameter v-search as character no-undo.
     7371       os-command no-wait value(p-full-path-RepView + " true " + v-search).
     7372   end procedure.
     7373   function fnc-DD-MM-YYYY returns character
     7374   (input p-dat-date as date):
     7375       define variable result as character no-undo.
     7376       define variable p-str-date as character no-undo.
     7377       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     7378           return p-str-date.
     7379   end function.
     7380   function fnc-convert-dot-to-colon returns character
     7381   (input p-data as decimal, input p-accur as character):
     7382       define variable result as character no-undo.
     7383       define variable v-str-result as character no-undo.
     7384       p-data = round(p-data, 2).
     7385       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     7386       return v-str-result.
     7387   end function.
