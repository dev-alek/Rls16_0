      737   procedure cur-time :
      738      define output parameter p-today as date      no-undo .
      739      define output parameter p-time  as integer   no-undo .
      740     do
      741     on error undo, return error
      742     :
      743       define variable v-date1 as date      no-undo .
      744       define variable v-date2 as date      no-undo .
      745       define variable v-time  as integer   no-undo .
      746       assign
      747         v-date1 = today
      748         v-time  = time
      749         v-date2 = today
      750       .
      751       if v-date1 <> v-date2
      752       then do:
      753         assign
      754           v-date1 = today
      755           v-time  = v-time
      756         .
      757       end.
      758       assign
      759         p-today = v-date1
      760         p-time  = v-time
      761       .
      762     end.
      763   end.
      764   function cur-time-date returns character
      765   :
      766     return string(today, '99/99/9999':U) .
      767   end.
      768   function cur-time-mjd returns decimal
      769   :
      770     define variable v-date as date      no-undo .
      771     define variable v-time as integer   no-undo .
      772     run cur-time in this-procedure
      773       (output v-date
      774       ,output v-time
      775       ) .
      776     return integer(v-date) - 2400002 + (v-time / 86400) .
      777   end.
      778   function cur-time-get-ending-index returns integer
      779   (input p-number as integer
      780   )
      781   :
      782     if p-number < 0
      783     or p-number = ?
      784     then do:
      785       return 1 .
      786     end.
      787     define variable v-rest as integer   no-undo .
      788     assign
      789       p-number = p-number modulo 100
      790     .
      791     if p-number < 20
      792     then do:
      793       assign
      794         v-rest = p-number
      795       .
      796     end.
      797     else do:
      798       assign
      799         v-rest = p-number modulo 10
      800       .
      801     end.
      802     case v-rest :
      803       when 1
      804       then do:
      805         return 2 .
      806       end.
      807       when 2 or
      808       when 3 or
      809       when 4
      810       then do:
      811         return 3 .
      812       end.
      813       otherwise do:
      814         return 1 .
      815       end.
      816     end case .
      817   end.
      818   procedure cur-time-mjd-to-date :
      819      define input  parameter i-mjd-diff as decimal no-undo.
      820      define output parameter o-Date     as date    no-undo.
      821      define output parameter o-Time     as integer no-undo.
      822      define variable v-day-number as integer   no-undo .
      823      if    i-mjd-diff < 0
      824         or i-mjd-diff = ?
      825      then do:
      826         return "?" .
      827      end.
      828      assign
      829         v-day-number = truncate(i-mjd-diff,0).
      830         o-Date = date(v-day-number + 2400002).
      831         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      832     .
      833   end.
      834   function cur-time-mjd-to-string returns character
      835   (input p-mjd-diff as decimal
      836   )
      837   :
      838     define variable v-day-number as integer   no-undo .
      839     define variable v-seconds    as integer   no-undo .
      840     define variable v-hour       as integer   no-undo .
      841     define variable v-min        as integer   no-undo .
      842     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      843     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      844     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      845     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      846     if p-mjd-diff < 0
      847     or p-mjd-diff = ?
      848     then do:
      849       return "?" .
      850     end.
      851     assign
      852       v-day-number = integer(truncate(p-mjd-diff,0))
      853       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      854     .
      855     if v-seconds > 86400
      856     then do:
      857       assign
      858         v-seconds = 86400 - 1
      859       .
      860     end.
      861     if v-seconds < 0
      862     then do:
      863       assign
      864         v-seconds = 0
      865       .
      866     end.
      867     assign
      868       v-hour = truncate(v-seconds / 3600, 0)
      869     .
      870     assign
      871       v-seconds = v-seconds modulo 3600
      872     .
      873     assign
      874       v-min = truncate(v-seconds / 60, 0)
      875     .
      876     assign
      877       v-seconds = v-seconds modulo 60
      878     .
      879     return
      880         (if v-day-number <> 0
      881           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      882           else ""
      883         )
      884       + (if v-day-number <> 0 or v-hour <> 0
      885           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      886           else ""
      887         )
      888       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      889           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      890           else ""
      891         )
      892       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      893       .
      894   end.
      895   function cur-time-string returns character
      896   :
      897     define variable v-date as date      no-undo .
      898     define variable v-time as integer   no-undo .
      899     run cur-time in this-procedure
      900       (output v-date
      901       ,output v-time
      902       ) .
      903     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      904   end.
      905   function cur-time-string-sec returns character
      906   :
      907     define variable v-date as date      no-undo .
      908     define variable v-time as integer   no-undo .
      909     run cur-time in this-procedure
      910       (output v-date
      911       ,output v-time
      912       ) .
      913     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      914   end.
      915   function cur-time-custom  returns character
      916   (input p-prefix as character
      917   ,input p-date-format as character
      918   ,input p-delimiter as character
      919   ,input p-time-format as character
      920   ,input p-suffix as character
      921   )
      922   :
      923     define variable v-date as date      no-undo .
      924     define variable v-time as integer   no-undo .
      925     run cur-time in this-procedure
      926       (output v-date
      927       ,output v-time
      928       ) .
      929     return
      930       p-prefix
      931       + string(v-date, p-date-format)
      932       + p-delimiter
      933       + string(v-time, p-time-format)
      934       + p-suffix
      935       .
      936   end.
      937   function cur-time-print  returns character
      938   :
      939     define variable v-date as date      no-undo .
      940     define variable v-time as integer   no-undo .
      941     run cur-time in this-procedure
      942       (output v-date
      943       ,output v-time
      944       ) .
      945     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      946   end.
      947   function cur-time-datetime returns datetime
      948   :
      949     define variable v-char as character no-undo .
      950     define variable v-datetime as datetime no-undo .
      951     v-char = cur-time-string().
      952     v-datetime = datetime(v-char).
      953     return  v-datetime.
      954   end.
      955   function cur-time-string-msec returns character
      956   :
      957     define variable v-date as datetime  no-undo .
      958     v-date = now.
      959     return string(v-date) .
      960   end.
      961   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      962   function breakstr returns character ( input        for-name    as character,
      963                                         input        line-length as integer,
      964                                         input-output line1       as character,
      965                                         input-output line2       as character ) :
      966     define variable ii as integer no-undo.
      967     if length( for-name ) > line-length then do:
      968       assign ii    = 1
      969              line1 = "":u
      970              line2 = "":u.
      971       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      972         assign line1 =       substring( for-name, 1, line-length     )
      973                line2 = trim( substring( for-name,    line-length + 1 ) ).
      974       end.                                                     else do:
      975         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      976           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      977                  ii    = ii    + 1.
      978           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      979             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      980           end.
      981         end.
      982         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      983       end.
      984     end.                                else do:
      985       assign line1 = for-name
      986              line2 = "":u.
      987     end.
      988     return ( line1 ).
      989   end function.
      990       def var t-addres        like ub.firm.addres1   no-undo.
      991       def var t-phone         like ub.firm.phone     no-undo.
