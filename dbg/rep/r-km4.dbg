     2589                          output v-trdcattr-type ) no-error .
     2590       if error-status :error then do:
     2591        message
     2592         vss-workfile vss-revision vss-description skip
     2593         "Ошибка при вызове процедуры tdat-val":U skip
     2594         "Документ: " torgconfdoc-code skip
     2595         "Атрибут: " 'Recipient':U skip
     2596         "Значение: " v-recipient skip
     2597         trim( error-status :get-message (1) ) skip
     2598         return-value skip
     2599         view-as alert-box error.
     2600       undo, return error return-value.
     2601       end.
     2602     assign
