     4872               then do:
     4873                  run rep/get-psn.p
     4874                  (input buf_wth-doc.deliver
     4875                  ,output v-torgconf-ogr-name
     4876                  ) .
     4877               end.
     4878               find first buf_person no-lock
     4879               where buf_person.psn-code = buf_wth-doc.deliver
     4880               no-error.
     4881               if available buf_person
     4882               then do:
     4883                  v-torgconf-ogr-post = buf_person.position.
     4884               end.
     4885               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     4886               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     4887            end.
     4888      end.
     4889   end.
     4890   procedure torgconf-get-reason  :
     4891   define input parameter  p-doc-code       as character        no-undo.
     4892   define input parameter  p-reason-code    as integer          no-undo .
     4893   define input parameter  p-doc-type       as character        no-undo.
     4894       if p-reason-code > 0
     4895       then do:
     4896           define buffer buf_trn-reason for ub.trn-reason.
     4897           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     4898           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     4899       end.
     4900       else do:
     4901           if p-doc-type = 'при':U
     4902           then  do:
     4903               define variable v-attr-type     as character    no-undo.
     4904               define variable v-attr-value    as character    no-undo.
     4905               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     4906               assign v-torgconf-reason = v-attr-value .
     4907               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     4908               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     4909           end.
     4910       end.
     4911   end procedure.
     4912   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4913   procedure factord :
     4914     define input  parameter p-fact-date            as date    no-undo .
     4915     define input  parameter p-fact-time            as integer no-undo .
     4916     define input  parameter p-fact-num             as integer no-undo .
     4917     define input  parameter p-shift-date           as date    no-undo .
     4918     define input  parameter p-shift-num            as integer no-undo .
     4919     define input  parameter p-shift-on             as logical no-undo .
     4920     define output parameter p-fact-order           as decimal no-undo .
     4921     define output parameter p-shift-end-fact-order as decimal no-undo .
     4922     define output parameter p-day-end-fact-order   as decimal no-undo .
     4923     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     4924     if p-fact-date = ?
     4925     then do:
     4926       return error "Не указана фактическая дата" .
     4927     end.
     4928     define variable v-fact-date-num as integer no-undo .
     4929     assign
     4930       v-fact-date-num = integer(p-fact-date)
     4931     .
     4932     if p-fact-num = ?
     4933     or p-fact-num = 0
     4934     then do:
     4935       return error "Не задан p-fact-num " + string(p-fact-num) .
     4936     end.
     4937     if p-fact-num < 0
     4938     then do:
     4939       return error "Отрицательный fact-num " + string(p-fact-num) .
     4940     end.
     4941     if p-fact-num >= 100000000
     4942     then do:
     4943       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     4944     end.
     4945     if p-shift-on = true
     4946     then do:
     4947       if p-shift-date = ?
     4948       then do:
     4949         return error "Не задана дата смены" .
     4950       end.
     4951       if p-shift-num = ?
     4952       or p-shift-num = 0
     4953       then do:
     4954         return error "Не задан номер смены" .
     4955       end.
     4956     end.
     4957     else do:
     4958       assign
     4959         p-shift-date = p-fact-date
     4960         p-shift-num  = 24
     4961       .
     4962     end.
     4963     define variable v-shift-offset as integer no-undo .
     4964     if p-shift-date = p-fact-date
     4965     then do:
     4966       assign
     4967         v-shift-offset = 1
     4968       .
     4969     end.
     4970     if p-shift-date < p-fact-date
     4971     then do:
     4972       assign
     4973         v-shift-offset = 0
     4974       .
     4975     end.
     4976     if p-shift-date > p-fact-date
     4977     then do:
     4978       message
     4979         vss-workfile vss-revision vss-description skip
     4980         "Неправильная дата закрытия смены" skip
     4981         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     4982         view-as alert-box error .
     4983       undo, return error
     4984         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     4985           ,string(p-fact-date, '99/99/9999':U)
     4986           ,string(p-shift-date, '99/99/9999':U)
     4987           )
     4988       .
     4989     end.
     4990     if p-shift-num < 1
     4991     or p-shift-num > 24
     4992     then do:
     4993       message
     4994         vss-workfile vss-revision vss-description skip
     4995         "Неправильный номер смены" skip
     4996         "p-shift-num" p-shift-num skip
     4997         view-as alert-box error .
     4998       undo, return error return-value .
     4999     end.
     5000     assign
     5001       p-fact-order           = v-fact-date-num
     5002                              + v-shift-offset * 0.5
     5003                              + p-shift-num    * 0.02 - 0.01
     5004                              + p-fact-num     * 0.0000000001
     5005       p-shift-end-fact-order = v-fact-date-num
     5006                              + v-shift-offset * 0.5
     5007                              + p-shift-num    * 0.02
     5008       p-day-end-fact-order   = v-fact-date-num
     5009                              + 0.99
     5010     .
     5011     if p-fact-order           <= v-fact-date-num
     5012     or p-shift-end-fact-order <= v-fact-date-num
     5013     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     5014     or p-shift-end-fact-order >= p-day-end-fact-order
     5015     then do:
     5016       message
     5017         vss-workfile vss-revision vss-description skip
     5018         "Внутренняя ошибка при генерации фактического номера" skip
     5019         "p-fact-date"            p-fact-date            skip
     5020         "p-fact-time"            p-fact-time            skip
     5021         "p-fact-num"             p-fact-num             skip
     5022         "p-shift-date"           p-shift-date           skip
     5023         "p-shift-num"            p-shift-num            skip
     5024         "p-shift-on"             p-shift-on             skip
     5025         "p-shift-end-fact-order" p-shift-end-fact-order skip
     5026         "p-day-end-fact-order"   p-day-end-fact-order   skip
     5027         "v-fact-date-num"        v-fact-date-num        skip
     5028         view-as alert-box error .
     5029       undo, return error return-value .
     5030     end.
     5031   end procedure.
     5032   procedure day-begin-fact-order :
     5033     define input  parameter p-fact-date            as date    no-undo .
     5034     define output parameter p-day-begin-fact-order as decimal no-undo .
     5035     do
     5036     on error undo, return error return-value
     5037     :
     5038       if p-fact-date = ?
     5039       then do:
     5040         assign
     5041           p-day-begin-fact-order = 0
     5042         .
     5043       end.
     5044       else do:
     5045         assign
     5046           p-day-begin-fact-order = integer(p-fact-date)
     5047         .
     5048       end.
     5049     end.
     5050   end procedure.
     5051   procedure factord-max-fact-order :
     5052     define output parameter p-max-fact-order as decimal   no-undo .
     5053     do
     5054     on error undo, return error return-value
     5055     :
     5056       run day-begin-fact-order in this-procedure
     5057         (input  date(1, 1, 5000)
     5058         ,output p-max-fact-order
     5059         ) .
     5060     end.
     5061   end procedure.
     5062   procedure factord-cut-archive :
     5063     define input  parameter p-obj-type             as character no-undo .
     5064     define input  parameter p-obj-code             as integer   no-undo .
     5065     define input  parameter p-fact-date            as date      no-undo .
     5066     define output parameter p-shift-on             as logical   no-undo .
     5067     define output parameter p-shift-date           as date      no-undo .
     5068     define output parameter p-shift-num            as integer   no-undo .
     5069     define output parameter p-day-end-fact-order   as decimal   no-undo .
     5070     define output parameter p-shift-end-fact-order as decimal   no-undo .
     5071     define variable v-fact-order as decimal   no-undo .
     5072     define buffer buf_shift-obj for ub.shift-obj .
     5073     do
     5074     on error undo, return error return-value
     5075     :
     5076   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5077   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5078     (input  p-obj-type
     5079     ,input  p-obj-code
     5080     ,input  'shift-on=request'
     5081     ,output p-shift-on
     5082     ) no-error .
     5083       if error-status :error
     5084       then do:
     5085         message
     5086           vss-workfile vss-revision vss-description skip
     5087           "Ошибка при определении атрибута объекта" skip
     5088           "Объект" p-obj-type p-obj-code skip
     5089           error-status :get-message(1) skip
     5090           return-value skip
     5091           view-as alert-box error .
     5092         undo, return error return-value .
     5093       end.
     5094       if p-shift-on = false
     5095       then do:
     5096         assign
     5097           p-shift-date               = ?
     5098           p-shift-num                = 0
     5099         .
     5100       end.
     5101       else do:
     5102         find first buf_shift-obj share-lock
     5103           where buf_shift-obj.obj-type   = p-obj-type
     5104             and buf_shift-obj.obj-code   = p-obj-code
     5105             and buf_shift-obj.shift-date > p-fact-date
     5106           use-index pi
     5107           no-error .
     5108         if not available buf_shift-obj
     5109         or buf_shift-obj.status_ <> 'зкр':U
     5110         then do:
     5111           message
     5112             vss-workfile vss-revision vss-description skip
     5113             "Невозможно вычислить последнюю смену" skip
     5114             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     5115             "Объект" p-obj-type p-obj-code skip
     5116             "Дата" p-fact-date skip
     5117             view-as alert-box error .
     5118           undo, return error return-value .
     5119         end.
     5120         find last buf_shift-obj share-lock
     5121           where buf_shift-obj.obj-type = p-obj-type
     5122             and buf_shift-obj.obj-code = p-obj-code
     5123             and buf_shift-obj.shift-date <= p-fact-date
     5124           use-index pi
     5125           no-error .
     5126         if available buf_shift-obj
     5127         then do:
     5128           if  buf_shift-obj.status_ = 'зкр':U
     5129           then do:
     5130             assign
     5131               p-shift-date = buf_shift-obj.shift-date
     5132               p-shift-num  = buf_shift-obj.shift-num
     5133             .
     5134           end.
     5135           else do:
     5136             message
     5137               vss-workfile vss-revision vss-description skip
     5138               "Невозможно вычислить последнюю смену" skip
     5139               "Статус смены отличен от статуса" 'зкр':U skip
     5140               "Объект" p-obj-type p-obj-code skip
     5141               "Дата" p-fact-date skip
     5142               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     5143               view-as alert-box error .
     5144             undo, return error return-value .
     5145           end.
     5146         end.
     5147         else do:
     5148           assign
     5149             p-shift-date = p-fact-date - 1
     5150             p-shift-num  = 1
     5151           .
     5152         end.
     5153       end.
     5154       run factord in this-procedure
     5155         (input  p-fact-date
     5156         ,input  1
     5157         ,input  1
     5158         ,input  p-shift-date
     5159         ,input  p-shift-num
     5160         ,input  p-shift-on
     5161         ,output v-fact-order
     5162         ,output p-shift-end-fact-order
     5163         ,output p-day-end-fact-order
     5164         ) no-error .
     5165       if error-status :error
     5166       then do:
     5167         message
     5168           vss-workfile vss-revision vss-description skip
     5169           "Ошибка при вызове процедуры factord"
     5170           error-status :get-message(1) skip
     5171           return-value skip
     5172           view-as alert-box error .
     5173         undo, return error return-value .
     5174       end.
     5175     end.
     5176   end procedure.
     5177   procedure factord-lock-shift :
     5178     define input  parameter p-obj-type  as character no-undo .
     5179     define input  parameter p-obj-code  as integer   no-undo .
     5180     define input  parameter p-fact-date as date      no-undo .
     5181     define parameter buffer buf_shift-obj for ub.shift-obj .
     5182     define variable v-shift-on      as logical   no-undo .
     5183     define variable v-extra-message as character no-undo .
     5184     define variable v-error as character no-undo .
     5185     do
     5186     on error undo, return error return-value
     5187     :
     5188   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5190     (input  p-obj-type
     5191     ,input  p-obj-code
     5192     ,input  'shift-on=request'
     5193     ,output v-shift-on
     5194     ) no-error .
     5195       if error-status :error
     5196       then do:
     5197         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     5198         undo, return error v-error .
     5199       end.
     5200       if v-shift-on = true
     5201       then do:
     5202         find first buf_shift-obj share-lock
     5203           where buf_shift-obj.obj-type   = p-obj-type
     5204             and buf_shift-obj.obj-code   = p-obj-code
     5205             and buf_shift-obj.shift-date > p-fact-date
     5206           use-index pi
     5207           no-error .
     5208         if not available buf_shift-obj
     5209         or buf_shift-obj.status_ <> 'зкр':U
     5210         then do:
     5211           find last buf_shift-obj
     5212             where buf_shift-obj.obj-type = p-obj-type
     5213               and buf_shift-obj.obj-code = p-obj-code
     5214               and buf_shift-obj.status_  = 'зкр':U
     5215             use-index stts
     5216             no-error .
     5217           if available buf_shift-obj
     5218           then do:
     5219             assign
     5220               v-extra-message =
     5221                     substitute("Дата начала последеней закрытой смены на объекте &1"
     5222                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     5223                               )
     5224             .
     5225           end.
     5226           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     5227           undo, return error v-error .
     5228         end.
     5229       end.
     5230     end.
     5231   end procedure.
     5232   procedure factord-end-day :
     5233     define input  parameter p-fact-date            as date    no-undo .
     5234     define output parameter p-day-end-fact-order   as decimal no-undo .
     5235     do
     5236     on error undo, return error return-value
     5237     :
     5238       if p-fact-date = ?
     5239       then do:
     5240         return error "Не указана фактическая дата" .
     5241       end.
     5242       assign
     5243         p-day-end-fact-order = integer(p-fact-date) + 0.99
     5244       .
     5245     end.
     5246   end procedure.
     5247   procedure factord-to-date :
     5248     define input  parameter p-fact-order as decimal no-undo .
     5249     define output parameter p-fact-date  as date    no-undo .
     5250     define variable v-ref-date  as date      no-undo .
     5251     define variable v-ref-delta as integer   no-undo .
     5252     do
     5253     on error undo, return error return-value
     5254     :
     5255       if p-fact-order = ?
     5256       or p-fact-order = 0
     5257       then do:
     5258         return error "Не указан fact-order" .
     5259       end.
     5260       assign
     5261         v-ref-date  = date(1, 1, 2000)
     5262       .
     5263       assign
     5264         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     5265       .
     5266       assign
     5267         p-fact-date = v-ref-date + v-ref-delta
     5268       .
     5269     end.
     5270   end procedure.
     5271   procedure factord-to-fact-num :
     5272     define input  parameter p-fact-order as decimal no-undo .
     5273     define output parameter p-fact-num   as integer no-undo .
     5274     define variable v-fact-order-trunc as decimal no-undo .
     5275     do
     5276     on error undo, return error return-value
     5277     :
     5278       if p-fact-order = ?
     5279       or p-fact-order = 0
     5280       then do:
     5281         return error "Не указан fact-order" .
     5282       end.
     5283       assign
     5284        v-fact-order-trunc = truncate(p-fact-order, 2)
     5285       .
     5286       assign
     5287         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     5288       .
     5289     end.
     5290   end procedure.
     5291   procedure factord-to-shift-num :
     5292     define input  parameter p-fact-order as decimal no-undo .
     5293     define output parameter p-shift-num   as integer no-undo .
     5294     define variable  p-shift-numd  as decimal   no-undo .
     5295     define variable v-fact-order-trunc as decimal no-undo .
     5296     do
     5297     on error undo, return error return-value
     5298     :
     5299       if p-fact-order = ?
     5300       or p-fact-order = 0
     5301       then do:
     5302         return error "Не указан fact-order" .
     5303       end.
     5304       assign
     5305        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     5306       .
     5307       if v-fact-order-trunc < 0.5 then do:
     5308         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     5309       end.
     5310       assign
     5311         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     5312         .
     5313        assign
     5314         p-shift-num = truncate (p-shift-numd , 0)
     5315       .
     5316     end.
     5317   end procedure.
     5318   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5319   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5320   define  stream PrnLibStream.
     5321   procedure prn-lib-prn-file :
     5322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5323     define input parameter p-DIsabledoptions as integer no-undo .
     5324     define variable v-report-name as character no-undo .
     5325     define variable v-user-action as character no-undo .
     5326     define variable v-printed     as logical   no-undo .
     5327     define variable v-exist       as logical   no-undo .
     5328     do
     5329       on error undo, return error
     5330       :
     5331       run prn-lib-get-report-name  in this-procedure (
     5332         input parParentProc
     5333         ,output v-report-name
     5334         ).
     5335   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     5337     (input  v-report-name
     5338     ,input  2
     5339     ,output v-exist
     5340     )  .
     5341       if NOT v-exist then
     5342       DO:
     5343         Message
     5344           "Нет заданий на печать ! "
     5345           view-as alert-box .
     5346         Return  .
     5347       End.
     5348       run gbl/prnfilen.w
     5349         (input  ""
     5350         ,input  p-DisabledOptions
     5351         ,input  string(v-report-name )
     5352         ,input  7
     5353         ,output v-user-action
     5354         ,output v-printed
     5355         ) .
     5356       if v-printed then
     5357       do:
     5358         return "YES" .
     5359       end.
     5360       else
     5361       do:
     5362         return "NO" .
     5363       end.
     5364     end.
     5365   end procedure.
     5366   procedure prn-lib-open-stream :
     5367     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5368     define input parameter p-page-size    as integer no-undo .
     5369     define input parameter p-is-stream    as logical no-undo .
     5370     define input parameter p-append       as logical no-undo .
     5371     define variable v-report-name as character no-undo .
     5372     do
     5373       on error undo, return error
     5374       :
     5375       run prn-lib-get-report-name  in this-procedure (
     5376         input parParentProc
     5377         ,output v-report-name
     5378         ).
     5379       if p-is-stream then
     5380       do:
     5381         if p-append then
     5382         do:
     5383           output stream PrnLibStream to value( v-report-name )
     5384             page-size value(p-page-size) append .
     5385         end.
     5386         if not p-append then
     5387         do:
     5388           output stream PrnLibStream to value( v-report-name )
     5389             page-size value(p-page-size) .
     5390         end.
     5391       end.
     5392       if not p-is-stream then
     5393       do:
     5394         if p-append then
     5395         do:
     5396           output to value( v-report-name )
     5397             page-size value(p-page-size) append .
     5398         end.
     5399         if not p-append then
     5400         do:
     5401           output to value( v-report-name )
     5402             page-size value(p-page-size) .
     5403         end.
     5404       end.
     5405     end.
     5406   end procedure.
     5407   procedure prn-lib-open-exp :
     5408     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5409     define input parameter p-is-stream    as logical no-undo .
     5410     define input parameter p-is-append    as logical no-undo .
     5411     define output parameter p-ReportFileName as char init "report" no-undo.
     5412     define output parameter p-process as logical no-undo .
     5413     define variable glog as logical no-undo .
     5414     do
     5415       on error undo, return error
     5416       :
     5417       SYSTEM-DIALOG GET-FILE p-ReportFileName
     5418         TITLE      "Укажите путь"
     5419         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     5420         ASK-OVERWRITE
     5421         CREATE-TEST-FILE
     5422         SAVE-AS
     5423         USE-FILENAME
     5424         DEFAULT-EXTENSION "txt"
     5425         UPDATE glog
     5426         .
     5427       if not glog then  return.
     5428       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     5429       if p-is-stream then
     5430       do:
     5431         if p-is-append then
     5432         do:
     5433           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5434         end.
     5435         else
     5436         do:
     5437           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5438         end.
     5439       end.
     5440       else
     5441       do:
     5442         if p-is-append then
     5443         do:
     5444           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     5445         end.
     5446         else
     5447         do:
     5448           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     5449         end.
     5450       end.
     5451       p-process = yes.
     5452     end.
     5453   end procedure.
     5454   procedure prn-lib-get-report-name :
     5455     define input parameter parParentProc  as widget-handle no-undo.
     5456     define output parameter p-report-name as character no-undo .
     5457     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     5458   end procedure.
     5459   procedure prn-lib-reportviewer-report-name :
     5460     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5461     define input parameter p-report-name-html as character no-undo .
     5462     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     5463   end procedure.
     5464   procedure prn-lib-reportviewer :
     5465     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     5466     define input parameter p-report-name-html as character no-undo .
     5467     define input parameter p-param        as character no-undo .
     5468     define variable v-excel           as character no-undo init 'TRUE' .
     5469     define variable v-value-character as character no-undo .
     5470     define variable v-value-integer   as character no-undo .
     5471     define variable v-value-date      as date      no-undo .
     5472     define variable v-value-decimal   as decimal   no-undo .
     5473     define variable rep-excel         as logical   no-undo .
     5474     define variable excel-string      as character no-undo .
     5475     define variable v-param-type      as character no-undo .
     5476     define variable v-tth             as handle    no-undo .
     5477     run adm/shattri.p (
     5478       input "get":U
     5479       ,input  ""
     5480       ,input  0
     5481       ,input  'report-glob':U
     5482       ,input  'rep-excel':U
     5483       ,output v-value-character
     5484       ,output v-value-date
     5485       ,output v-value-decimal
     5486       ,output v-value-integer
     5487       ,output rep-excel
     5488       ,output v-param-type
     5489       ,INPUT-OUTPUT table-handle v-tth
     5490       )  .
     5491     if rep-excel then v-excel = "TRUE" .
     5492     else v-excel = "FALSE" .
     5493     if p-param eq ""
     5494     then
     5495        p-param = "EXCEL:" + v-excel.
     5496     else
     5497        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     5498     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     5499   end procedure.
     5500   procedure reprumpr_print-plain-text :
     5501   define input parameter p-dir-name as character no-undo .
     5502   define input parameter p-subdir-name as character no-undo .
     5503   define input parameter p-custom-name as character no-undo .
     5504   define input parameter p-disable-option as integer no-undo .
     5505   define input parameter p-font-number as integer no-undo .
     5506   define variable v-file-name as character no-undo .
     5507   define variable v-report-name as character no-undo .
     5508   define variable v-err-status as integer no-undo .
     5509   define variable v-err-mess as character no-undo .
     5510   v-file-name = p-dir-name + (if p-subdir-name <> ''
     5511                               then (p-subdir-name + chr(47))
     5512                               else '') +
     5513                 p-custom-name.
     5514   run prn-lib-get-report-name  in this-procedure (
     5515                                                     input parParentProc
     5516                                                     ,output v-report-name
     5517                                                   ).
     5518   os-copy
     5519   value(v-report-name)
     5520   value(v-file-name)
     5521   .
     5522   assign
     5523   v-err-status = os-error
     5524   .
     5525   if v-err-status <> 0 then do:
     5526     run gbl/os-errnm.p ( input v-err-status
     5527                         ,output v-err-mess).
     5528     return error v-err-mess.
     5529   end.
     5530   else do:
     5531     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     5532                                                   ,input p-report-id
     5533                                                   ,input 'text':U
     5534                                                   ,input v-file-name
     5535                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     5536                                                   ).
     5537   end.
     5538   end procedure.
     5539   procedure reprumpr_print-printer :
     5540   define input parameter p-font-number as integer no-undo .
     5541   define input parameter p-flags as integer no-undo .
     5542   define variable v-quest-print as logical no-undo .
     5543   define variable lok as logical no-undo .
     5544   define variable v-report-name as character no-undo .
     5545   run get-quest-print in parparentproc ( output v-quest-print) .
     5546   if not v-quest-print then do:
     5547       .
     5548     run prn-lib-get-report-name  in this-procedure (
     5549                                                       input parParentProc
     5550                                                      ,output v-report-name
     5551                                                     ).
     5552     run adecomm/_osprint.p
     5553       (input  ?
     5554       ,input  v-report-name
     5555       ,input  p-font-number
     5556       ,input  p-flags
     5557       ,input  0
     5558       ,input  0
     5559       ,output lok
     5560       ).
     5561     if not lok then do:
     5562     end.
     5563   end.
     5564   end procedure.
     5565   define stream temp-stream.
     5566   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5567   procedure prnexldl_clear:
     5568   define input parameter p-txl-file-name as character no-undo .
     5569   define variable v-template-file-name as character no-undo .
     5570   define variable v-vb-file-name as character no-undo .
     5571   define variable v-data-header-filename as character no-undo .
     5572   define variable v-data-filename as character no-undo .
     5573   if search( p-txl-file-name ) <> ? then do:
     5574     input stream temp-stream from value( p-txl-file-name ).
     5575     repeat
     5576     :
     5577         import stream temp-stream v-template-file-name   .
     5578         import stream temp-stream v-vb-file-name         .
     5579         import stream temp-stream v-data-header-filename .
     5580         os-delete value(v-data-header-filename).
     5581         import stream temp-stream v-data-filename        .
     5582         os-delete value(v-data-filename).
     5583     end.
     5584     input stream temp-stream close.
     5585     os-delete value( p-txl-file-name ).
     5586   end.
     5587   end procedure .
     5588   define stream reprumpr_in.
     5589   procedure reprumpr_print-xlt :
     5590   define input parameter p-dir-name as character no-undo .
     5591   define input parameter p-subdir-name as character no-undo .
     5592   define input parameter p-custom-name as character no-undo .
     5593   define input parameter p-disable-option as integer no-undo .
     5594   define input parameter p-font-number as integer no-undo .
     5595   define buffer buf_temp-param for temp-param .
     5596   define variable v-report-num            as integer no-undo .
     5597   define variable v-filename              as character    no-undo .
     5598   define variable v-obj-dir               as character    no-undo .
     5599   define variable v-report-filename       as character    no-undo .
     5600   define variable v-home-dir-filename     as character    no-undo .
     5601   define variable v-error-num             as integer      no-undo .
     5602   define variable v-template-file-name    as character    no-undo .
     5603   define variable v-vb-file-name          as character    no-undo .
     5604   define variable v-data-header-filename  as character    no-undo .
     5605   define variable v-data-filename         as character    no-undo .
     5606   define variable v-excel-file-name       as character    no-undo .
     5607   define variable v-err-message           as character    no-undo .
     5608   define variable v-os-err-str            as character    no-undo .
     5609   define variable v-report-dir            as character    no-undo .
     5610   do for buf_temp-param
     5611   on error undo, return error return-value
     5612   :
     5613   assign
     5614     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     5615   .
     5616     assign
     5617     v-report-num = g#report-num
     5618     v-obj-dir           = v-report-dir + chr(47) +
     5619                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     5620     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     5621     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     5622     v-home-dir-filename = v-obj-dir +  p-custom-name
     5623     .
     5624     os-delete value( v-filename + ".txl" )  .
     5625     os-rename
     5626       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     5627       value( v-filename + ".txl" )
     5628     .
     5629     assign
     5630       v-filename = search( v-filename + ".txl" )
     5631     .
     5632     if v-filename = "" or v-filename = ?
     5633     then do:
     5634       assign
     5635         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     5636                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     5637                                                   )
     5638       .
     5639       return error v-err-message.
     5640     end.
     5641     input stream reprumpr_in from value( v-filename ).
     5642     import stream reprumpr_in v-template-file-name   no-error .
     5643     import stream reprumpr_in v-vb-file-name         no-error .
     5644     import stream reprumpr_in v-data-header-filename no-error .
     5645     import stream reprumpr_in v-data-filename        no-error .
     5646     input stream reprumpr_in close.
     5647     if search( v-template-file-name ) = ?
     5648     then do:
     5649       assign
     5650         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     5651                                                   , v-template-file-name
     5652                                                   , chr(10)
     5653                                                   )
     5654       .
     5655       return error v-err-message.
     5656     end.
     5657     if search( v-vb-file-name ) = ?
     5658     then do:
     5659       assign
     5660         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     5661                                                   , v-template-file-name
     5662                                                   , v-vb-file-name
     5663                                                   , chr(10)
     5664                                                   )
     5665       .
     5666       return error v-err-message.
     5667     end.
     5668     if v-data-header-filename <> "":U
     5669     and search( v-data-header-filename ) = ?
     5670     then do:
     5671       assign
     5672         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     5673                                                   , v-template-file-name
     5674                                                   , v-data-header-filename
     5675                                                   , chr(10)
     5676                                                   )
     5677       .
     5678       return error v-err-message.
     5679     end.
     5680     if v-data-filename <> "":U
     5681     and search( v-data-filename )   = ?
     5682     then do:
     5683       assign
     5684         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     5685                                                   , v-template-file-name
     5686                                                   , v-data-filename
     5687                                                   , chr(10)
     5688                                                   )
     5689       .
     5690       return error v-err-message.
     5691     end.
     5692     create buf_temp-param.
     5693     assign
     5694       v-template-file-name = search( v-template-file-name )
     5695       file-info :file-name = v-template-file-name
     5696       v-template-file-name = file-info :full-pathname
     5697       v-vb-file-name       = search( v-vb-file-name )
     5698       file-info :file-name = v-vb-file-name
     5699       v-vb-file-name       = file-info :full-pathname
     5700     .
     5701     if v-template-file-name = ? or v-template-file-name = "":U
     5702     then do:
     5703       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     5704     end.
     5705     run paramls-write in this-procedure ( input "template":U
     5706                                         , input "template-file-name":U
     5707                                         , input v-template-file-name
     5708                                         ).
     5709     run paramls-write in this-procedure ( input "template":U
     5710                                         , input "vb-file-name":U
     5711                                         , input v-vb-file-name
     5712                                         ).
     5713     run paramls-write in this-procedure ( input "data":U
     5714                                         , input "data-header-filename":U
     5715                                         , input v-data-header-filename
     5716                                         ).
     5717     run paramls-write in this-procedure ( input "data":U
     5718                                         , input "data-filename":U
     5719                                         , input v-data-filename
     5720                                         ).
     5721     run paramls-write in this-procedure ( input "saveas":U
     5722                                         , input "excel-file-name":U
     5723                                         , input v-excel-file-name
     5724                                         ).
     5725     run paramls-write in this-procedure ( input "file":U
     5726                                         , input "file-no-open":U
     5727                                         , input "yes":U
     5728                                         ).
     5729     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     5730     if error-status :error
     5731     then do:
     5732       assign
     5733         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     5734                                                   , vss-workfile
     5735                                                   , vss-revision
     5736                                                   , vss-description
     5737                                                   , chr(10)
     5738                                                   , return-value
     5739                                                   , trim(error-status :get-message(1))
     5740                                                   , trim(error-status :get-message(2))
     5741                                                   , trim(error-status :get-message(3))
     5742                                                   )
     5743       .
     5744       return error v-err-message.
     5745     end.
     5746     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     5747     if error-status :error
     5748     then do:
     5749       assign
     5750         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     5751                                                   , v-filename
     5752                                                   , return-value
     5753                                                   , chr(10)
     5754                                                   )
     5755       .
     5756       return error v-err-message.
     5757     end.
     5758     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     5759     if error-status :error
     5760     then do:
     5761       assign
     5762         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     5763                                                   , v-filename
     5764                                                   , return-value
     5765                                                   , trim(error-status :get-message(1))
     5766                                                   , chr(10)
     5767                                                   )
     5768       .
     5769     end.
     5770     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     5771     if error-status :error
     5772     then do:
     5773       assign
     5774         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     5775                                                   , v-home-dir-filename
     5776                                                   , return-value
     5777                                                   , chr(10)
     5778                                                   )
     5779       .
     5780       return error v-err-message.
     5781     end.
     5782     run gbl/ren-file.p ( input v-excel-file-name
     5783                     , input v-home-dir-filename
     5784                     ) no-error .
     5785     if error-status :error
     5786     then do:
     5787       assign
     5788         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     5789                                                   , v-excel-file-name
     5790                                                   , v-home-dir-filename
     5791                                                   , return-value
     5792                                                   , chr(10)
     5793                                                   )
     5794       .
     5795       return error v-err-message.
     5796     end.
     5797     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     5798                                                   ,input p-report-id
     5799                                                   ,input 'excel':U
     5800                                                   ,input v-home-dir-filename
     5801                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     5802                                                   ).
     5803   end.
     5804   end procedure.
     5805   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5806   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5807   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5808   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5809   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5810   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5811   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5812   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5813   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5814   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5815   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5816   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5817   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5818   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5819   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5820   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5821   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5822   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5823   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5824   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     5825   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5826   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5827   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5828   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5829   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5830   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5831   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     5832   define variable temp1 as integer   no-undo.
     5833   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5834   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5835   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5836   PROCEDURE fostatok :
     5837   define input parameter p-host-code   as integer no-undo .
     5838   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     5839   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     5840   define input parameter x-tog-shift   as   logical             no-undo.
     5841   define input parameter x-date-start  as date        no-undo.
     5842   define input parameter x-date-end    as date        no-undo.
     5843   define input parameter x-shift-start as integer     no-undo.
     5844   define input parameter x-shift-end   as integer     no-undo.
     5845   define input parameter xTog-obj   as logical no-undo.
     5846   define input parameter p-curr-code as integer no-undo .
     5847   define input parameter p-cashbookid as integer  no-undo .
     5848   define output parameter sum       as decimal   no-undo.
     5849   define output parameter Fact-order  as decimal  no-undo.
     5850   define variable Fact-order#   as decimal  no-undo.
     5851   define variable Fact-orderS   as character  no-undo.
     5852   define variable x-date-start-t  as date   no-undo.
     5853   define variable x-sum-type as character no-undo .
     5854       if x-tog-shift then do:
     5855         assign
     5856         x-sum-type = 'shift-obj':U.
     5857       end.
     5858       else do:
     5859         x-sum-type = 'obj':U.
     5860       end.
     5861   Assign
     5862   Fact-order   = 0
     5863   sum     = 0
     5864   x-date-start-t  = x-date-start + 1 .
     5865   IF x-date-end = date('') then DO:
     5866     Fact-order = 0 .
     5867     For each obj-list no-lock
     5868         WHERE  (NOT xTog-obj OR
     5869                 (x-store-type = obj-list.obj-type
     5870                 AND
     5871                 x-store-code = obj-list.obj-code))
     5872     :
     5873      fact-order# = 0.
     5874      IF  x-TOG-Shift = False Then DO:
     5875         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     5876             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     5877             USE-INDEX fact-date  no-error .
     5878        if Available arh-fin-doc-schet-nal-obj THEN  do:
     5879          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     5880        end.
     5881      End.
     5882      Else  DO :
     5883         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     5884              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     5885               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     5886               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     5887               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     5888               USE-INDEX Shift-num no-error .
     5889         if Available arh-fin-doc-schet-nal-obj THEN  do:
     5890           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     5891         end.
     5892       END.
     5893       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     5894     End.
     5895   End.
     5896   Else DO:
     5897     For each obj-list  no-lock WHERE
     5898        (NOT xTog-obj
     5899         OR
     5900         (x-store-type = obj-list.obj-type
     5901         AND
     5902         x-store-code = obj-list.obj-code))
     5903      :
     5904      IF  x-TOG-Shift = False Then DO:
     5905         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     5906               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     5907               and arh-fin-doc-schet-nal-obj.shift-num = 0
     5908               USE-INDEX fact-date no-error.
     5909        if Available arh-fin-doc-schet-nal-obj THEN  do:
     5910          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     5911        end.
     5912      END.
     5913      Else DO:
     5914         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     5915               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     5916               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     5917               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     5918               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     5919         if Available arh-fin-doc-schet-nal-obj THEN  do:
     5920           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     5921         end.
     5922       End.
     5923       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     5924     End.
     5925   End.
     5926   END PROCEDURE.
     5927   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5928   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     5929     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     5930     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     5931     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     5932   END FUNCTION.
     5933   PROCEDURE get-last-month-date :
     5934     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     5935     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     5936     DO ON ERROR UNDO, RETURN ERROR :
     5937       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     5938       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     5939     END.
     5940   END PROCEDURE.
     5941   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     5942     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     5943     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     5944     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     5945   END FUNCTION.
     5946   PROCEDURE get-last-month-day :
     5947     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     5948     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     5949     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     5950     DO ON ERROR UNDO, RETURN ERROR :
     5951       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     5952       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     5953     END.
     5954   END PROCEDURE.
     5955   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     5956     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     5957     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     5958     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     5959   END FUNCTION.
     5960   PROCEDURE get-last-day-MY :
     5961     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     5962     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     5963     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     5964     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     5965     DO ON ERROR UNDO, RETURN ERROR :
     5966       ASSIGN t_date = DATE( p-month, 28, p-year ).
     5967       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     5968     END.
     5969   END PROCEDURE.
     5970   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     5971     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     5972     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     5973     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     5974   END FUNCTION.
     5975   PROCEDURE get-last-date-MY :
     5976     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     5977     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     5978     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     5979     DO ON ERROR UNDO, RETURN ERROR :
     5980       ASSIGN p-date = DATE( p-month, 28, p-year ).
     5981       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     5982     END.
     5983   END PROCEDURE.
     5984   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     5985     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     5986     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     5987     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     5988   END FUNCTION.
     5989   PROCEDURE get-next-month :
     5990     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     5991     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     5992     DO ON ERROR UNDO, RETURN ERROR :
     5993       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     5994     END.
     5995   END PROCEDURE.
     5996   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     5997     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     5998     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     5999     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6000   END FUNCTION.
     6001   PROCEDURE get-next-year :
     6002     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6003     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6004     DO ON ERROR UNDO, RETURN ERROR :
     6005       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     6006     END.
     6007   END PROCEDURE.
     6008   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6009     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     6010     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     6011     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     6012   END FUNCTION.
     6013   PROCEDURE get-prev-month :
     6014     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     6015     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     6016     DO ON ERROR UNDO, RETURN ERROR :
     6017       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     6018     END.
     6019   END PROCEDURE.
     6020   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     6021     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     6022     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     6023     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6024   END FUNCTION.
     6025   PROCEDURE get-prev-year :
     6026     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6027     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6028     DO ON ERROR UNDO, RETURN ERROR :
     6029       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     6030     END.
     6031   END PROCEDURE.
     6032   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     6033     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     6034     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     6035     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     6036   END FUNCTION.
     6037   PROCEDURE get-next-month-MY :
     6038     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     6039     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     6040     DO ON ERROR UNDO, RETURN ERROR :
     6041       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     6042     END.
     6043   END PROCEDURE.
     6044   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     6045     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     6046     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     6047     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     6048   END FUNCTION.
     6049   PROCEDURE get-next-year-MY :
     6050     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     6051     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     6052     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     6053     DO ON ERROR UNDO, RETURN ERROR :
     6054       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     6055     END.
     6056   END PROCEDURE.
     6057   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     6058     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     6059     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     6060     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     6061   END FUNCTION.
     6062   PROCEDURE get-month-name-rus :
     6063     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     6064     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     6065     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     6066     DO ON ERROR UNDO, RETURN ERROR :
     6067       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     6068     END.
     6069   END PROCEDURE.
     6070   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     6071     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     6072     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     6073     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     6074   END FUNCTION.
     6075   PROCEDURE get-month-name-gen :
     6076     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     6077     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     6078     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     6079     DO ON ERROR UNDO, RETURN ERROR :
     6080       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     6081     END.
     6082   END PROCEDURE.
     6083   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     6084     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     6085     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     6086     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     6087   END FUNCTION.
     6088   PROCEDURE get-month-number :
     6089     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     6090     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     6091     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     6092     DO ON ERROR UNDO, RETURN ERROR :
     6093       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     6094                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     6095     END.
     6096   END PROCEDURE.
     6097   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     6098                                           INPUT i-month-from AS INTEGER,
     6099                                           INPUT i-year-till  AS INTEGER,
     6100                                           INPUT i-month-till AS INTEGER  ) :
     6101     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     6102     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     6103                                               INPUT i-month-from,
     6104                                               INPUT i-year-till,
     6105                                               INPUT i-month-till,
     6106                                              OUTPUT j_month-num   ) NO-ERROR.
     6107     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     6108   END FUNCTION.
     6109   PROCEDURE get-month-num-MY :
     6110     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     6111     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     6112     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     6113     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     6114     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     6115     DO ON ERROR UNDO, RETURN ERROR :
     6116       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     6117     END.
     6118   END PROCEDURE.
     6119   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     6120     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     6121     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     6122     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     6123   END FUNCTION.
     6124   PROCEDURE get-date-time-header :
     6125     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     6126     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     6127     DO ON ERROR UNDO, RETURN ERROR :
     6128       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     6129       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     6130     END.
     6131   END PROCEDURE.
     6132   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     6133     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     6134     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     6135     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     6136   END FUNCTION.
     6137   PROCEDURE get-leap-year-sign :
     6138     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     6139     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     6140     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     6141     DO ON ERROR UNDO, RETURN ERROR :
     6142       IF p-year = ? OR p-year = 0 THEN DO:
     6143         ASSIGN t_date = TODAY.
     6144         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     6145         ASSIGN p-year = YEAR( t_date ).
     6146       END.
     6147       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     6148     END.
     6149   END PROCEDURE.
     6150   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     6151     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     6152     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     6153     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     6154   END FUNCTION.
     6155   PROCEDURE get-leap-year-sign-d :
     6156     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     6157     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     6158     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     6159     DO ON ERROR UNDO, RETURN ERROR :
     6160       IF p-date = ? THEN DO:
     6161         ASSIGN p-date = TODAY.
     6162         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     6163       END.
     6164       ASSIGN j-year = YEAR( p-date ).
     6165       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     6166     END.
     6167   END PROCEDURE.
