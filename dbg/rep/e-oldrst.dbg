     1380   DEFINE VARIABLE T-cons AS LOGICAL INITIAL no
     1381        LABEL "Разделять консигнацию и выкуп"
     1382        VIEW-AS TOGGLE-BOX
     1383        SIZE 34.13 BY .92 NO-UNDO.
     1384   DEFINE VARIABLE T-parts AS LOGICAL INITIAL no
     1385        LABEL "Каждую партию отдельной строкой"
     1386        VIEW-AS TOGGLE-BOX
     1387        SIZE 33.88 BY .92 NO-UNDO.
     1388   DEFINE VARIABLE T-supp AS LOGICAL INITIAL no
     1389        LABEL "Указывать поставщика"
     1390        VIEW-AS TOGGLE-BOX
     1391        SIZE 34.13 BY .88 NO-UNDO.
     1392   DEFINE FRAME F-Main
     1393        T-cons AT ROW 2.13 COL 2.38
     1394        T-supp AT ROW 3.83 COL 2.38
     1395        T-parts AT ROW 5.75 COL 2.38
     1396       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1397            SIDE-LABELS NO-UNDERLINE THREE-D
     1398            AT COL 1 ROW 1
     1399            SIZE 37 BY 14.
     1400   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1401   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1402   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1403   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1404   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1405   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1406   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1407   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1408       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1409   RUN ensure-broker.
     1410   THIS-PROCEDURE:ADM-DATA =
     1411        'ADM1.1~`':U +
     1412        'SmartObject~`':U +
     1413        'FRAME~`':U +
     1414        'NO ~`':U +
     1415        '~`':U +
     1416        '~`':U +
     1417        '~`':U +
     1418        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1419           + "~`":U +
     1420        'Layout,Hide-on-Init~`':U +
     1421        '~`':U +
     1422        '~`':U +
     1423        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1424        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1425            THEN "^^":U
     1426        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1427             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1428   PROCEDURE adm-apply-entry :
     1429     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1430   END PROCEDURE.
     1431   PROCEDURE adm-destroy :
     1432    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1433   END PROCEDURE.
     1434   PROCEDURE adm-disable :
     1435       DISABLE T-cons T-supp T-parts WITH FRAME F-Main.
     1436       RUN dispatch ('disable-fields':U).
     1437       RUN set-attribute-list ('ENABLED=no':U).
     1438       RETURN.
     1439   END PROCEDURE.
     1440   PROCEDURE adm-edit-attribute-list :
     1441         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1442         RETURN.
     1443   END PROCEDURE.
     1444   PROCEDURE adm-enable :
     1445       ENABLE UNLESS-HIDDEN T-cons T-supp T-parts WITH FRAME F-Main.
     1446       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1447       RUN set-attribute-list ('ENABLED=yes':U).
     1448       RETURN.
     1449   END PROCEDURE.
     1450   PROCEDURE adm-exit :
     1451        RUN notify ('exit':U).
     1452     RETURN.
     1453   END PROCEDURE.
     1454   PROCEDURE adm-hide :
     1455     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1456   END PROCEDURE.
     1457   PROCEDURE adm-initialize :
     1458     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1459   END PROCEDURE.
     1460   PROCEDURE adm-show-errors :
     1461       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1462       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1463           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1464       END.
     1465       RETURN.
     1466   END PROCEDURE.
     1467   PROCEDURE adm-UIB-mode :
     1468     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1469   END PROCEDURE.
     1470   PROCEDURE adm-view :
     1471     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1472   END PROCEDURE.
     1473   PROCEDURE dispatch :
     1474       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1475       RUN broker-dispatch IN adm-broker-hdl
     1476           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1477       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1478   END PROCEDURE.
     1479   PROCEDURE ensure-broker :
     1480   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1481   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1482   DO:
     1483       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1484       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1485   END.
     1486   END PROCEDURE.
     1487   PROCEDURE get-attribute :
     1488     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1489     RUN broker-get-attribute IN adm-broker-hdl
     1490         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1491     RETURN RETURN-VALUE.
     1492   END PROCEDURE.
     1493   PROCEDURE get-attribute-list :
     1494     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1495     RUN broker-get-attribute-list IN adm-broker-hdl
     1496         (INPUT THIS-PROCEDURE,
     1497          INPUT ?,
     1498          OUTPUT p-attr-list) NO-ERROR.
     1499     RETURN.
     1500   END PROCEDURE.
     1501   PROCEDURE new-state :
     1502     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1503     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1504     RETURN.
     1505   END PROCEDURE.
     1506   PROCEDURE notify :
     1507     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1508     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1509     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1510         RETURN "ADM-ERROR":U.
     1511     RETURN.
     1512   END PROCEDURE.
     1513   PROCEDURE set-attribute-list :
     1514     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1515     RUN ensure-broker.
     1516     RUN broker-set-attribute-list IN adm-broker-hdl
     1517         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1518     RETURN.
     1519   END PROCEDURE.
     1520   PROCEDURE set-position :
     1521       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1522       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1523       IF VALID-HANDLE(adm-object-hdl) THEN
     1524       DO:
     1525           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1526           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1527           DO:
     1528             IF p-row = 0 THEN p-row =
     1529               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1530             IF p-col = 0 THEN p-col =
     1531               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1532           END.
     1533           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1534           DO:
     1535             parent-hdl = adm-object-hdl:PARENT.
     1536             IF p-row = 0 THEN p-row =
     1537               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1538                 parent-hdl:ROW.
     1539             IF p-col = 0 THEN p-col =
     1540               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1541                 parent-hdl:COL.
     1542           END.
     1543           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1544           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1545         ASSIGN adm-object-hdl:ROW    =   p-row
     1546                adm-object-hdl:COLUMN =   p-col.
     1547       END.
     1548       RETURN.
     1549   END PROCEDURE.
     1550   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1551       STRING(adm-object-hdl)).
     1552   PAUSE 0 BEFORE-HIDE.
     1553   PROCEDURE adm-change-page :
     1554     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1555     END PROCEDURE.
     1556   PROCEDURE delete-page :
     1557     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1558     RUN broker-delete-page IN adm-broker-hdl
     1559         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1560     END PROCEDURE.
     1561   PROCEDURE init-object :
     1562     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1563     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1564     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1565     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1566     RUN broker-init-object IN adm-broker-hdl
     1567         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1568          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1569     RETURN.
     1570   END PROCEDURE.
     1571   PROCEDURE init-pages :
     1572     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1573     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1574         INPUT p-page-list) NO-ERROR.
     1575     END PROCEDURE.
     1576   PROCEDURE select-page :
     1577     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1578     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1579         INPUT p-page#) NO-ERROR.
     1580     END PROCEDURE.
     1581   PROCEDURE view-page :
     1582     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1583     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1584         INPUT p-page#).
     1585     END PROCEDURE.
     1586   ON VALUE-CHANGED OF T-parts IN FRAME F-Main
     1587   DO:
     1588     assign
     1589     T-parts.
     1590     if T-parts then do:
     1591       assign
     1592       T-cons = yes
     1593       T-supp = yes
     1594       .
     1595       DISPLAY
     1596       T-cons
     1597       T-supp
     1598       WITH FRAME F-Main.
     1599     end.
     1600   END.
     1601   if not this-procedure :persistent
     1602   then do:
     1603     message
     1604       vss-workfile vss-revision vss-description skip
     1605       "Ошибка при запуске процедуры" skip
     1606       "Данную процедуру следует запускать только с параметром persistent" skip
     1607       view-as alert-box error .
     1608     undo, return error .
     1609   end.
     1610   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1611     run mainmenu_getcntxt in my-handle
     1612       (output v-cntxt-db-num
     1613       ,output v-cntxt-userid
     1614       ,output v-cntxt-level
     1615       ,output v-cntxt-host-code-obj
     1616       ,output v-cntxt-obj-type
     1617       ,output v-cntxt-obj-code
     1618       ,output v-cntxt-db-num-obj
     1619       ,output v-cntxt-is-admin
     1620       ) .
     1621   PROCEDURE adm-create-objects :
     1622   END PROCEDURE.
     1623   PROCEDURE adm-row-available :
     1624     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1625     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1626     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1627     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1628     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1629     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1630     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1631     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1632     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1633     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1634     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1635     IF adm-updating-record THEN RETURN.
     1636     RUN get-attribute ('FIELDS-ENABLED':U).
     1637     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1638     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1639         OUTPUT link-handle) NO-ERROR.
     1640     IF link-handle = "":U THEN
     1641         RETURN.
     1642     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1643     IF NUM-ENTRIES(link-handle) > 1 THEN
     1644         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1645             "encountered more than one RECORD-SOURCE.":U SKIP
     1646             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1647                VIEW-AS ALERT-BOX ERROR.
     1648     RUN get-attribute ('Key-Name':U).
     1649     key-name = RETURN-VALUE.
     1650     IF key-name = "":U THEN key-name = ?.
     1651     IF key-name NE ? THEN DO:
     1652       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1653         NO-ERROR.
     1654       IF key-value NE ? THEN
     1655         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1656     END.
     1657   IF VALID-HANDLE (adm-object-hdl) THEN
     1658       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1659   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1660   END PROCEDURE.
     1661   PROCEDURE disable_UI :
     1662     HIDE FRAME F-Main.
     1663     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1664   END PROCEDURE.
     1665   PROCEDURE enable_UI :
     1666     DISPLAY T-cons T-supp T-parts
     1667         WITH FRAME F-Main.
     1668     ENABLE T-cons T-supp T-parts
     1669         WITH FRAME F-Main.
     1670   END PROCEDURE.
     1671   PROCEDURE My-report :
     1672   define variable date_string     as      char    no-undo.
     1673   define variable prt-qnty as decimal no-undo .
     1674   def buffer supplier for ub.clients.
     1675   define variable ocons-pay like ub.sysconf.purch-code no-undo.
     1676   define variable ocons-pay-old like ub.sysconf.purch-code no-undo.
     1677   define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     1678   define variable v-slt-pc        like ub.doc-line.slt-pc    no-undo.
     1679   define variable v-host-code     like ub.sysconf.host-code  no-undo.
     1680   DEFINE VARIABLE         v-parts-VAt-pc  like ub.parts-attr.vat-pc           no-undo .
     1681   DEFINE VARIABLE         v-parts-SLT-pc  like ub.parts-attr.SLT-pc           no-undo .
     1682   DEFINE VARIABLE         v-supp-type     like ub.parts-attr.supp-type        no-undo .
     1683   DEFINE VARIABLE         v-supp-code     like ub.parts-attr.supp-code        no-undo .
     1684   DEFINE VARIABLE         v-purch-code    like ub.parts-attr.purch-code       no-undo .
     1685   DEFINE VARIABLE         v-in-code       like ub.parts-attr.income-in-code   no-undo .
     1686   DEFINE VARIABLE         v-fact-date     like ub.parts-attr.fact-date        no-undo .
     1687   DEFINE VARIABLE         v-obj-type      like ub.parts.obj-type              no-undo .
     1688   DEFINE VARIABLE         v-obj-code      like ub.parts.obj-code              no-undo .
     1689   DEFINE VARIABLE         v-is-attr       as logical no-undo .
     1690   DEFINE VARIABLE         v-supplier      like ub.clients.obj-name            no-undo .
     1691   DEFINE VARIABLE         v-producer      like ub.clients.obj-name            no-undo .
     1692   define variable         v-pay-code      like ub.parts.pay-code              no-undo .
     1693   DEFINE VARIABLE         v-cst-code      like ub.parts.cst-code              no-undo .
     1694   define variable g#log as logical no-undo .
     1695   define variable p-XL-delim as character no-undo .
     1696   define variable type-par1 as character no-undo .
     1697   define variable tmp-var1  as character no-undo .
     1698   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1699   empty temp-table thbjattr_thbj-attr.
     1700   run adm/shattri.p (
     1701      input "get":U
     1702     ,input 'орг':U
     1703     ,input v-cntxt-host-code-obj
     1704     ,input 'report-firm':U
     1705     ,input  ""
     1706     ,output v-value-character
     1707     ,output v-value-date
     1708     ,output v-value-decimal
     1709     ,output v-value-integer
     1710     ,output v-value-logical
     1711     ,output par-type
     1712     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1713     ) no-error .
     1714   for each thbjattr_thbj-attr :
     1715       if thbjattr_thbj-attr.prop-code = 'XL-delim'  then tmp-var1   = thbjattr_thbj-attr.property-value-character.
     1716   end.
     1717   IF tmp-var1 = "" then p-XL-delim = ";".
     1718   else p-XL-delim = tmp-var1.
     1719   define variable v-curr-r-b as character no-undo .
     1720   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1721   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1722     (output v-curr-r-b
     1723     )  .
     1724   define buffer buf_parts-attr for ub.parts-attr.
     1725   define buffer buf_pay-type  for ub.pay-type.
     1726   assign
     1727   frame F-Main T-cons
     1728   frame F-Main T-supp
     1729   frame F-Main T-parts
     1730   cdate = X-date-alone
     1731   .
     1732   run My-var.
     1733   assign
     1734   date_string = cur-time-print()
     1735   .
     1736   run waitfram-show in this-procedure ( "Подождите ..." ).
     1737   FOR EACH sj-goods :
     1738       delete sj-goods.
     1739   END .
     1740   FOR EACH d-slt-vat :
     1741       delete d-slt-vat .
     1742   END .
     1743   FOR EACH obj-list NO-LOCK:
     1744     IF obj-list.obj-type = 'маг':U then do:
     1745         FIND FIRST ub.shop NO-LOCK WHERE ub.shop.obj-code = obj-list.obj-code no-error.
     1746         FIND FIRST ub.Sysconf No-LOCK WHERE ub.sysconf.host-code = ub.shop.host-code No-ERROR.
     1747         assign
     1748         odoc-prt = ub.shop.doc-prt
     1749         ocons-pay = integer('2':U)
     1750         ocons-pay-old = integer('4':U)
     1751         .
     1752     end.
     1753     else do:
     1754         FIND FIRST ub.store NO-LOCK WHERE ub.store.obj-code = obj-list.obj-code no-error.
     1755         FIND FIRST ub.Sysconf No-LOCK WHERE ub.sysconf.host-code = store.host-code No-ERROR.
     1756         assign
     1757         odoc-prt = ub.store.doc-prt
     1758         ocons-pay = integer('2':U)
     1759         ocons-pay-old = integer('4':U)
     1760         .
     1761     end.
     1762     FOR each ub.gds-obj NO-LOCk WHERE
     1763             ub.gds-obj.obj-type = obj-list.obj-type AND
     1764             ub.gds-obj.obj-code = obj-list.obj-code AND
     1765             ub.gds-obj.fact-qnty <> 0 :
     1766       ACCUMULATE gds-obj.artic (COUNT).
     1767       IF (ACCUM COUNT gds-obj.artic ) MODULO 50  = 0 then do:
     1768           run waitfram-show in this-procedure ("Обработано " + string(ACCUM COUNT gds-obj.artic) + " товаров на объекте " ).
     1769       end.
     1770       FOR EACH ub.parts NO-LOCK WHERE
     1771               ub.parts.artic = ub.gds-obj.artic AND
     1772               ub.parts.prod-type = ub.gds-obj.prod-type AND
     1773               ub.parts.prod-code = ub.gds-obj.prod-code AND
     1774               ub.parts.obj-type = ub.gds-obj.obj-type AND
     1775               ub.parts.obj-code = ub.gds-obj.obj-code AND
     1776               ub.parts.status_ = no AND
     1777               ub.parts.rsrv-free = YES AND
     1778               ub.parts.in-code <> ub.parts.out-code
     1779                                               :
     1780         FIND FIRST buf_parts-attr No-LOCK WHERE
     1781                    buf_parts-attr.in-code = parts.in-code
     1782                AND buf_parts-attr.gds-code = gds-obj.gds-code
     1783                AND buf_parts-attr.part-code = parts.part-code
     1784                    No-ERROR.
     1785         IF AVAILABLE buf_parts-attr then do:
     1786           if buf_parts-attr.fact-date > cdate then NEXT.
     1787           assign
     1788           v-is-attr      = yes
     1789           v-parts-VAt-pc = buf_parts-attr.vat-pc
     1790           v-parts-SLT-pc = buf_parts-attr.SLT-pc
     1791           v-supp-type = buf_parts-attr.supp-type
     1792           v-supp-code = buf_parts-attr.supp-code
     1793           v-purch-code = buf_parts-attr.purch-code
     1794           v-pay-code  = buf_parts-attr.pay-code
     1795           v-in-code = buf_parts-attr.income-in-code
     1796           v-fact-date = buf_parts-attr.fact-date
     1797           v-obj-type =  parts.obj-type
     1798           v-obj-code =  parts.obj-code
     1799           v-cst-code = buf_parts-attr.cst-code
     1800           .
     1801         end.
     1802         else do:
     1803           assign
     1804           v-is-attr = no
     1805           .
     1806           find first ub.trn-doc no-lock where
     1807                      ub.trn-doc.doc-code = ub.parts.in-code no-error .
     1808           if available ub.trn-doc and ub.trn-doc.fact-date > cdate then NEXT.
     1809           assign
     1810             v-parts-VAt-pc = ub.parts.vat-pc
     1811             v-parts-SLT-pc = ub.parts.SLT-pc
     1812             v-supp-type = ub.parts.supp-type
     1813             v-supp-code = ub.parts.supp-code
     1814             v-purch-code = ub.parts.purch-code
     1815             v-pay-code = ub.parts.pay-code
     1816             v-in-code = ub.parts.in-code
     1817             v-fact-date = (if available ub.trn-doc then ub.trn-doc.fact-date else ?)
     1818             v-obj-type =  ub.parts.obj-type
     1819             v-obj-code =  ub.parts.obj-code
     1820             v-cst-code = ub.parts.cst-code
     1821             .
     1822         end.
     1823         IF NOT T-parts then do:
     1824           IF T-supp then
     1825           FIND FIRST sj-goods WHERE
     1826                     sj-goods.artic = ub.gds-obj.artic AND
     1827                     sj-goods.prod-type = ub.gds-obj.prod-type AND
     1828                     sj-goods.prod-code = ub.gds-obj.prod-code AND
     1829                     sj-goods.VAT-supp = v-parts-VAT-pc AND
     1830                     sj-goods.SLT-supp = v-parts-SLT-pc AND
     1831                     sj-goods.supp-type = v-supp-type AND
     1832                     sj-goods.supp-code = v-supp-code AND
     1833                     (NOT T-cons OR
     1834                     (sj-goods.purch-code = v-purch-code
     1835                      AND
     1836                     sj-goods.pay-code = v-pay-code))
     1837                     No-error.
     1838           ELSE
     1839           FIND FIRST sj-goods WHERE
     1840                     sj-goods.artic = ub.gds-obj.artic AND
     1841                     sj-goods.prod-type = ub.gds-obj.prod-type AND
     1842                     sj-goods.prod-code = ub.gds-obj.prod-code AND
     1843                     sj-goods.VAT-supp = v-parts-VAT-pc AND
     1844                     sj-goods.SLT-supp = v-parts-SLT-pc AND
     1845                     (NOT T-cons OR
     1846                     (sj-goods.purch-code = v-purch-code
     1847                      AND
     1848                     sj-goods.pay-code = v-pay-code))
     1849                     No-error.
     1850         END.
     1851         if not avail sj-goods or T-parts then do:
     1852           FIND FIRST ub.goods No-LOCK WHERE
     1853                       ub.goods.gds-code = ub.gds-obj.gds-code  NO-ERROR.
     1854           FIND FIRST ub.gds-prt where
     1855                       ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
     1856           FIND FIRST ub.bar-code No-LOCK WHERE
     1857                       ub.bar-code.gds-code = ub.gds-obj.gds-code AND
     1858                       ub.bar-code.in-code = "" AND
     1859                       ub.bar-code.part-code = "" AND
     1860                       ub.bar-code.node-code =  ub.gds-prt.node-code  AND
     1861                       ub.bar-code.unit-cli = ub.goods.unit-base NO-ERROR.
     1862           create sj-goods.
     1863   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1864   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1865     (input  gds-obj.obj-type
     1866     ,input  gds-obj.obj-code
     1867     ,output v-host-code
     1868     )  .
     1869   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1870   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1871     (input  goods.gds-code
     1872     ,input  '1':U
     1873     ,input  ?
     1874     ,input  v-host-code
     1875     ,input  gds-obj.obj-type
     1876     ,input  gds-obj.obj-code
     1877     ,output v-vat-pc
     1878     ) no-error .
     1879   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1880   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1881     (input  goods.gds-code
     1882     ,input  '2':U
     1883     ,input  ?
     1884     ,input  v-host-code
     1885     ,input  gds-obj.obj-type
     1886     ,input  gds-obj.obj-code
     1887     ,output v-slt-pc
     1888     ) no-error .
     1889           assign
     1890           sj-goods.artic = goods.artic
     1891           sj-goods.b-code = bar-code.b-code
     1892           sj-goods.prod-type = goods.prod-type
     1893           sj-goods.prod-code = goods.prod-code
     1894           sj-goods.VAT-PC = v-vat-pc
     1895           sj-goods.SLT-pc = v-slt-pc
     1896           sj-goods.unit = goods.unit-base
     1897           sj-goods.is-prt = gds-prt.node-name <> '_Пустая шкала':U
     1898           sj-goods.prt-root = goods.prt-root
     1899           sj-goods.gds-name = REPLACE(goods.gds-name, " ", "_")
     1900           sj-goods.engl-name = REPLACE(goods.engl-name, " ", "_")
     1901           sj-goods.VAT-supp = v-parts-VAT-pc
     1902           sj-goods.SLT-supp = v-parts-SLT-pc
     1903           sj-goods.supp-type = IF T-supp OR T-parts then v-supp-type else ""
     1904           sj-goods.supp-code = IF T-supp OR T-parts then v-supp-code else 0
     1905           sj-goods.purch-code = IF T-cons or T-parts
     1906                              then v-purch-code
     1907                              else 0
     1908           sj-goods.pay-code = IF T-cons or T-parts
     1909                               then v-pay-code
     1910                               else 0
     1911           sj-goods.in-code = if T-parts then v-in-code else ""
     1912           sj-goods.fact-date = if T-parts then v-fact-date else ?
     1913           sj-goods.obj-type = if T-parts then v-obj-type else "":U
     1914           sj-goods.obj-code = if T-parts then v-obj-code else 0
     1915           sj-goods.cst-code = if T-parts then v-cst-code else "":U
     1916           .
     1917           sj-goods.s-price = gds-obj.fact-sale / gds-obj.fact-qnty.
     1918         END.
     1919   assign
     1920     price-rubl-with-tax-loc = parts.price-rubl
     1921     price-base-with-tax-loc = parts.price-base
     1922   .
     1923   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1924   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1925     (output varinvprb
     1926     )  .
     1927     if parts.out-code = 'free-zone':U     or
     1928        parts.out-code = 'out-zone':U   or
     1929        parts.doc-type = 'акт':U then do:
     1930       assign
     1931         in-vatp-have-vat-slt = yes.
     1932     end.
     1933     else do:
     1934       find first in-vatp_doc-attr no-lock
     1935         where in-vatp_doc-attr.doc-code  = parts.out-code
     1936           and in-vatp_doc-attr.attr-code = 'envd':U
     1937         no-error .
     1938       if not available in-vatp_doc-attr then do:
     1939         assign
     1940           in-vatp-have-vat-slt = yes.
     1941       end.
     1942       else do:
     1943            in-vatp-have-vat-slt = no.
     1944       end.
     1945     end.
     1946     assign
     1947      price-cli-with-tax-loc = parts.price-cli
     1948      cli-base-rate          = parts.cli-base-rate.
     1949     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     1950              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     1951     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     1952             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     1953             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     1954             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     1955             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     1956             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     1957             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1958       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1959     assign
     1960       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     1961     assign
     1962       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1963       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1964       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1965       transport-cli-loc  = 0
     1966       other-cli-loc      = 0
     1967     .
     1968   ASSIGN
     1969             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1970       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1971   .
     1972         assign
     1973         prt-qnty =  (IF parts.out-code = 'free-zone':U
     1974                      then
     1975                      parts.qnty
     1976                      else abs(parts.qnty))
     1977         sj-goods.qnty = sj-goods.qnty +  prt-qnty
     1978         sj-goods.sale-sum-rubl = if v-curr-r-b = 'base':U
     1979                                  then sj-goods.sale-sum-rubl
     1980                                  else (sj-goods.sale-sum-rubl + sj-goods.s-price * prt-qnty)
     1981         sj-goods.sale-sum-base = if v-curr-r-b = 'base':U
     1982                                  then (sj-goods.sale-sum-base + sj-goods.s-price * prt-qnty)
     1983                                  else sj-goods.sale-sum-base
     1984         sj-goods.uchet-price-base = if T-parts then parts.price-base else 0
     1985         sj-goods.uchet-price-rubl = if T-parts then parts.price-rubl else 0
     1986         sj-goods.uchet-sum-base = sj-goods.uchet-sum-base + parts.price-base * prt-qnty
     1987         sj-goods.uchet-sum-rubl = sj-goods.uchet-sum-rubl + parts.price-rubl * prt-qnty
     1988         sj-goods.uchet-sum-base-without-tax = sj-goods.uchet-sum-base-without-tax +
     1989                                              (price-base-with-tax-loc - slt-base-loc - vat-base-loc) * prt-qnty
     1990         sj-goods.uchet-sum-rubl-without-tax = sj-goods.uchet-sum-rubl-without-tax +
     1991                                              (price-rubl-with-tax-loc  - slt-rubl-loc - vat-rubl-loc) * prt-qnty
     1992         .
     1993       END.
     1994     END.
     1995   END.
     1996   run waitfram-hide in this-procedure.
     1997   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1998   define variable ReportFileName as character no-undo initial "report".
     1999   define variable was_OK_opened  as logical   no-undo.
     2000   system-dialog get-file          ReportFileName
     2001                 title             "Укажите путь"
     2002                 filters           "Текстовый файл (*.txt)" "*.txt"
     2003                 ask-overwrite
     2004                 create-test-file
     2005                 save-as
     2006                 use-filename
     2007                 default-extension "txt"
     2008                 update            was_OK_opened.
     2009   if was_OK_opened <> yes then do: return "Cancel". end.
     2010   assign ReportFileName = trim( string( ReportFileName ) ).
     2011   output stream PrnLibStream to value ( ReportFileName ) page-size 0   .
     2012   run waitfram-show in this-procedure ("Ждите...").
     2013   PUT stream PrnLibStream UNFORMATTED
     2014       "Остатки на текущий момент  по товарам, оприходованным до " +
     2015       string( cdate, "99/99/9999" ) + "."      format "x(110)" SKIP(1).
     2016   PUT stream PrnLibStream UNFORMATTED ReportHeader skip.
     2017   PUT stream PrnLibStream string("По объектам: "  )
     2018           format "X(20)" SKIP.
     2019   FOR EACH obj-list :
     2020       FIND FIRST ub.clients WHERE ub.clients.obj-type = obj-list.obj-type AND
     2021                                         ub.clients.obj-code = obj-list.obj-code NO-LOCK .
     2022       PUT stream PrnLibStream UNFORMATTED ub.clients.obj-name  ", ".
     2023   END.
     2024   PUT stream PrnLibStream UNFORMATTED
     2025           SKIP
     2026           cur-time-print() SKIP.
     2027   PUT stream PrnLibStream " " SKIP(1) .
     2028   PUT stream PrnLibStream UNFORMATTED
     2029   "Тип_производителя" p-XL-delim
     2030   "Код_производителя"  p-XL-delim
     2031   "Производитель"  p-XL-delim
     2032   "Артикул" p-XL-delim
     2033   "Бар-код" p-XL-delim
     2034   "Название" p-XL-delim
     2035   "Англ.название" p-XL-DELIM
     2036   "Ед.изм" p-XL-delim
     2037   "НДС" p-XL-delim
     2038   "НП" p-XL-delim
     2039   (IF T-supp then
     2040   ("Тип_поставщика" + p-XL-delim + "Код_поставщика" + p-XL-delim + "Поставщик" + p-XL-delim)
     2041   else "")
     2042   (IF T-cons then
     2043   ("Консигнационный_товар" + p-XL-delim)
     2044   else "")
     2045   (IF T-cons or T-parts
     2046   then
     2047   ("Тип оплаты"  + p-XL-DELIM)
     2048   else "":U)
     2049   "НДС_поставщ" p-XL-delim
     2050   "НП_поставщ" p-XL-delim
     2051   (if T-parts
     2052   then ("Тип_объекта" + p-XL-delim +
     2053         "Код_объекта" + p-XL-delim +
     2054         "Учетн.цена_с НДС_НП_баз.вал." + p-XL-delim +
     2055         "Учетн.цена_с НДС_НП_рубли" + p-XL-delim +
     2056         "N_прих.док-та" + p-XL-delim +
     2057         "Факт_дата" + p-XL-delim +
     2058         "ГТД" + p-XL-DELIM)
     2059   else ""
     2060   )
     2061   "Остаток" p-XL-delim
     2062   "Сумма_учет_цен_баз.вал" p-XL-delim
     2063   "Сумма_учет_цен_баз.вал_без_НДС_НП" p-XL-delim
     2064   "Сумма_учет_цен_рубли" p-XL-delim
     2065   "Сумма_учет_цен_рубли_без_НДС_НП" p-XL-delim
     2066   (if v-curr-r-b = 'base':U
     2067    then "Сумма_продаж_цен_баз.вал"
     2068    else "Сумма_продаж_цен_рубли") p-XL-delim
     2069   SKIP(0).
     2070   FOR EACH sj-goods NO-LOCK
     2071   use-index p1
     2072   break by sj-goods.prod-type
     2073   by sj-goods.prod-code
     2074   by sj-goods.supp-type
     2075   BY sj-goods.supp-code:
     2076       IF FIRST-OF(sj-goods.supp-code) then do:
     2077           FIND FIRST supplier NO-LOCK WHERE
     2078                     supplier.obj-type = sj-goods.supp-type AND
     2079                     supplier.obj-code = sj-goods.supp-code NO-ERROR.
     2080          assign
     2081          v-supplier = (if available supplier
     2082                        then supplier.obj-name
     2083                        else "":U)
     2084          .
     2085       end.
     2086       IF FIRST-OF(sj-goods.prod-code) then do:
     2087           FIND FIRST clients NO-LOCK WHERE
     2088                     clients.obj-type = sj-goods.prod-type AND
     2089                     clients.obj-code = sj-goods.prod-code NO-ERROR.
     2090          assign
     2091          v-producer = (if available clients
     2092                        then clients.obj-name
     2093                        else "":U)
     2094          .
     2095       end.
     2096   if t-parts or T-cons then
     2097   find first buf_pay-type no-lock where
     2098             buf_pay-type.obj-code = sj-goods.pay-code no-error .
     2099       PUT stream PrnLibStream UNFORMATTED
     2100       sj-goods.prod-type p-XL-delim
     2101       sj-goods.prod-code p-XL-delim
     2102       REPLACE(v-producer, " ", "_") p-XL-delim
     2103       sj-goods.artic p-XL-delim
     2104       sj-goods.b-code p-XL-delim
     2105       sj-goods.gds-name p-XL-delim
     2106       sj-goods.engl-name p-XL-DELIM
     2107       sj-goods.unit p-XL-delim
     2108       sj-goods.VAT-pc p-XL-delim
     2109       sj-goods.SLT-pc p-XL-delim
     2110       (IF T-supp then
     2111       (sj-goods.SUPP-type + p-XL-delim +
     2112       string(sj-goods.SUPP-code) + p-XL-delim +
     2113       REPLACE(v-supplier, " ", "_") + p-XL-delim
     2114       )
     2115       ELSE "")
     2116       (IF T-cons then
     2117       (entry (lookup (string(sj-goods.purch-code), '1,2,3,4':U), 'выкуп,консигнация,ответственное хранение,старая консигнация':U) + p-XL-DELIM)
     2118       ELSE "")
     2119       (IF T-cons or T-parts
     2120       then
     2121       (if available buf_pay-type
     2122       then (buf_pay-type.obj-name + p-XL-DELIM)
     2123       else "":U)
     2124       ELSE "":U
     2125       )
     2126       sj-goods.VAT-supp p-XL-delim
     2127       sj-goods.SLT-supp p-XL-delim
     2128       (if T-parts then
     2129       (
     2130        sj-goods.obj-type +  p-XL-delim +
     2131        string(sj-goods.obj-code) +  p-XL-delim +
     2132        string(sj-goods.uchet-price-base) +  p-XL-delim +
     2133        string(sj-goods.uchet-price-rubl) +  p-XL-delim +
     2134        sj-goods.in-code + p-XL-delim +
     2135        (if sj-goods.fact-date = ? then "?" else string(sj-goods.fact-date, "99/99/9999")) + p-XL-delim +
     2136         sj-goods.cst-code + p-XL-DELIM)
     2137        else ""
     2138        )
     2139       sj-goods.qnty p-XL-delim
     2140       sj-goods.uchet-sum-base p-XL-delim
     2141       sj-goods.uchet-sum-base-without-tax  p-XL-delim
     2142       sj-goods.uchet-sum-rubl p-XL-delim
     2143       sj-goods.uchet-sum-rubl-without-tax p-XL-delim
     2144       (if v-curr-r-b = 'base':U
     2145        then sj-goods.sale-sum-base
     2146        else sj-goods.sale-sum-rubl)   p-XL-delim
     2147       SKIP(0).
     2148   END.
     2149   output stream PrnLibStream CLOSE .
     2150   run waitfram-hide in this-procedure .
     2151   message
     2152   "Отчет выведен в файл"
     2153   view-as alert-box.
     2154   END PROCEDURE.
     2155   PROCEDURE My-var :
     2156   assign
     2157   frame F-Main T-cons
     2158   frame F-Main T-supp
     2159   frame F-Main T-parts
     2160   .
     2161   str1 = "".
     2162   Assign
     2163    STR-obj-type = ''
     2164    STR-obj-code = ''
     2165    STR-obj-name = ''
     2166    STR-obj      = ''.
     2167   For each obj-list no-lock:
     2168    Assign
     2169    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2170    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2171    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2172    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2173   End.
     2174   ReportNAme = "Остатки товаров, оприходованных до " + string( X-date-alone, "99/99/9999" ).
     2175   ReportHeader = (if T-cons
     2176                   then "Разделять консигнацию и выкуп "
     2177                   else "Не разделять консигнацию и выкуп ") + chr(10) +
     2178                  (if T-supp
     2179                   then "Указывать поставщика "
     2180                   else "Не указывать поставщика ") + chr(10) +
     2181                  (if T-parts
     2182                   then "Каждую партию отдельной строкой"
     2183                   else "")
     2184                  .
     2185   END PROCEDURE.
     2186   PROCEDURE send-records :
     2187   END PROCEDURE.
     2188   PROCEDURE state-changed :
     2189     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
     2190     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2191   END PROCEDURE.
     2192   PROCEDURE tree-prt :
     2193   def input param c like ub.gds-prt.node-code no-undo.
     2194   def param buffer b-g-p for ub.gds-prt.
     2195   def buffer b-gds-prt for ub.gds-prt.
     2196   define variable no-nodes as logical initial yes.
     2197   if odoc-prt then
     2198       FOR EACH b-gds-prt where b-gds-prt.upper-code = c  NO-LOCK:
     2199           no-nodes = no.
     2200           RUN tree-prt( b-gds-prt.node-code, buffer b-gds-prt ).
     2201       END .
     2202   if no-nodes then do:
     2203      FIND FIRST ub.prt-obj No-LOCK WHERE
     2204                 ub.prt-obj.artic = ub.gds-obj.artic AND
     2205               ub.prt-obj.prod-type = ub.gds-obj.prod-type AND
     2206               ub.prt-obj.prod-code = ub.gds-obj.prod-code AND
     2207               ub.prt-obj.prt-code = b-g-p.node-code No-ERROR.
     2208     sale-stoim = sale-stoim  + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale.
     2209   end.
     2210   END PROCEDURE.
