      403   def
      404    shared
      405   temp-table  obj-list no-undo
      406     field obj-type like ub.clients.obj-type
      407     field obj-code like ub.clients.obj-code
      408     field obj-name like ub.clients.obj-name
      409     field obj-id   as integer
