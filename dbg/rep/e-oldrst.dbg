        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Остатки товаров, оприходованных до заданной даты".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define new global shared variable g#library  as handle no-undo .
       67   define new global shared variable g#library2 as handle no-undo .
       68   procedure proc-alt-shift-f2:
       69     if not ibs.th.gbl.gbl-var:rcode
       70   then
       71     run gbl\inidebug.p .
       72   end.
       73   procedure proc-alt-shift-f3:
       74     run gbl/prvssinf.p
       75       ( input this-procedure
       76       ) .
       77   end.
       78   define variable v-inform-launched as logical no-undo initial false .
       79   procedure proc-alt-shift-f4:
       80     define variable v-action as character no-undo .
       81     if v-inform-launched = false then do:
       82       assign
       83         v-inform-launched = true
       84       .
       85       run gbl/d-inform.w
       86         (  input self
       87         ,  input this-procedure
       88         , output v-action
       89         ) no-error .
       90       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       91       assign
       92         v-inform-launched = false
       93       .
       94     end.
       95   end.
       96   procedure proc-alt-f1:
       97     run gbl/corrhelp.p
       98       (input this-procedure
       99       ) .
      100   end .
      101   on alt-shift-f2 anywhere do:
      102     run proc-alt-shift-f2.
      103   end.
      104   on alt-shift-f3 anywhere do:
      105     run proc-alt-shift-f3 in this-procedure .
      106   end.
      107   on alt-shift-f4 anywhere do:
      108     run proc-alt-shift-f4 in this-procedure.
      109   end.
      110   on alt-f1 anywhere do:
      111     run proc-alt-f1 in this-procedure .
      112   end.
      113   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      114   procedure cur-time :
      115      define output parameter p-today as date      no-undo .
      116      define output parameter p-time  as integer   no-undo .
      117     do
      118     on error undo, return error
      119     :
      120       define variable v-date1 as date      no-undo .
      121       define variable v-date2 as date      no-undo .
      122       define variable v-time  as integer   no-undo .
      123       assign
      124         v-date1 = today
      125         v-time  = time
      126         v-date2 = today
      127       .
      128       if v-date1 <> v-date2
      129       then do:
      130         assign
      131           v-date1 = today
      132           v-time  = v-time
      133         .
      134       end.
      135       assign
      136         p-today = v-date1
      137         p-time  = v-time
      138       .
      139     end.
      140   end.
      141   function cur-time-date returns character
      142   :
      143     return string(today, '99/99/9999':U) .
      144   end.
      145   function cur-time-mjd returns decimal
      146   :
      147     define variable v-date as date      no-undo .
      148     define variable v-time as integer   no-undo .
      149     run cur-time in this-procedure
      150       (output v-date
      151       ,output v-time
      152       ) .
      153     return integer(v-date) - 2400002 + (v-time / 86400) .
      154   end.
      155   function cur-time-get-ending-index returns integer
      156   (input p-number as integer
      157   )
      158   :
      159     if p-number < 0
      160     or p-number = ?
      161     then do:
      162       return 1 .
      163     end.
      164     define variable v-rest as integer   no-undo .
      165     assign
      166       p-number = p-number modulo 100
      167     .
      168     if p-number < 20
      169     then do:
      170       assign
      171         v-rest = p-number
      172       .
      173     end.
      174     else do:
      175       assign
      176         v-rest = p-number modulo 10
      177       .
      178     end.
      179     case v-rest :
      180       when 1
      181       then do:
      182         return 2 .
      183       end.
      184       when 2 or
      185       when 3 or
      186       when 4
      187       then do:
      188         return 3 .
      189       end.
      190       otherwise do:
      191         return 1 .
      192       end.
      193     end case .
      194   end.
      195   procedure cur-time-mjd-to-date :
      196      define input  parameter i-mjd-diff as decimal no-undo.
      197      define output parameter o-Date     as date    no-undo.
      198      define output parameter o-Time     as integer no-undo.
      199      define variable v-day-number as integer   no-undo .
      200      if    i-mjd-diff < 0
      201         or i-mjd-diff = ?
      202      then do:
      203         return "?" .
      204      end.
      205      assign
      206         v-day-number = truncate(i-mjd-diff,0).
      207         o-Date = date(v-day-number + 2400002).
      208         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      209     .
      210   end.
      211   function cur-time-mjd-to-string returns character
      212   (input p-mjd-diff as decimal
      213   )
      214   :
      215     define variable v-day-number as integer   no-undo .
      216     define variable v-seconds    as integer   no-undo .
      217     define variable v-hour       as integer   no-undo .
      218     define variable v-min        as integer   no-undo .
      219     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      220     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      221     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      222     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      223     if p-mjd-diff < 0
      224     or p-mjd-diff = ?
      225     then do:
      226       return "?" .
      227     end.
      228     assign
      229       v-day-number = integer(truncate(p-mjd-diff,0))
      230       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      231     .
      232     if v-seconds > 86400
      233     then do:
      234       assign
      235         v-seconds = 86400 - 1
      236       .
      237     end.
      238     if v-seconds < 0
      239     then do:
      240       assign
      241         v-seconds = 0
      242       .
      243     end.
      244     assign
      245       v-hour = truncate(v-seconds / 3600, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 3600
      249     .
      250     assign
      251       v-min = truncate(v-seconds / 60, 0)
      252     .
      253     assign
      254       v-seconds = v-seconds modulo 60
      255     .
      256     return
      257         (if v-day-number <> 0
      258           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      259           else ""
      260         )
      261       + (if v-day-number <> 0 or v-hour <> 0
      262           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      263           else ""
      264         )
      265       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      266           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      267           else ""
      268         )
      269       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      270       .
      271   end.
      272   function cur-time-string returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-string-sec returns character
      283   :
      284     define variable v-date as date      no-undo .
      285     define variable v-time as integer   no-undo .
      286     run cur-time in this-procedure
      287       (output v-date
      288       ,output v-time
      289       ) .
      290     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      291   end.
      292   function cur-time-custom  returns character
      293   (input p-prefix as character
      294   ,input p-date-format as character
      295   ,input p-delimiter as character
      296   ,input p-time-format as character
      297   ,input p-suffix as character
      298   )
      299   :
      300     define variable v-date as date      no-undo .
      301     define variable v-time as integer   no-undo .
      302     run cur-time in this-procedure
      303       (output v-date
      304       ,output v-time
      305       ) .
      306     return
      307       p-prefix
      308       + string(v-date, p-date-format)
      309       + p-delimiter
      310       + string(v-time, p-time-format)
      311       + p-suffix
      312       .
      313   end.
      314   function cur-time-print  returns character
      315   :
      316     define variable v-date as date      no-undo .
      317     define variable v-time as integer   no-undo .
      318     run cur-time in this-procedure
      319       (output v-date
      320       ,output v-time
      321       ) .
      322     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      323   end.
      324   function cur-time-datetime returns datetime
      325   :
      326     define variable v-char as character no-undo .
      327     define variable v-datetime as datetime no-undo .
      328     v-char = cur-time-string().
      329     v-datetime = datetime(v-char).
      330     return  v-datetime.
      331   end.
      332   function cur-time-string-msec returns character
      333   :
      334     define variable v-date as datetime  no-undo .
      335     v-date = now.
      336     return string(v-date) .
      337   end.
