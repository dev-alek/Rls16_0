     1771   end procedure.
     1772   procedure torgconf-get-holdfirm-code :
     1773   define input parameter p-obj-type   as character        no-undo.
     1774   define input parameter p-obj-code   as integer          no-undo.
     1775   define output parameter p-firm-code as integer          no-undo.
     1776       define variable v-firm-code-str     as character    no-undo.
     1777       define variable v-par-type          as character    no-undo.
     1778       define buffer buf_clients       for ub.clients.
     1779   do
     1780   for buf_clients
     1781   on error undo, return error
     1782   :
     1783       run gbl/clntat-v.p (
     1784             input p-obj-type
     1785           , input p-obj-code
     1786           , input 'holdfirm-code':U
     1787           , output v-firm-code-str
     1788           , output v-par-type
     1789       ).
     1790       assign
     1791           p-firm-code = integer( v-firm-code-str )
     1792       no-error.
     1793       if error-status :error
     1794       then do:
     1795           message
     1796               "Неверно задан код фирмы для печати накладных."
     1797           view-as alert-box warning.
     1798           assign
     1799               p-firm-code = 0
     1800           .
     1801       end.
     1802       else do:
     1803           find first buf_clients no-lock
     1804                where buf_clients.obj-type = 'орг':U
     1805                  and buf_clients.obj-code = p-firm-code
     1806           no-error.
     1807           if not available buf_clients
     1808           then do:
     1809               message
     1810                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1811                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1812               view-as alert-box warning.
     1813               assign
     1814                   p-firm-code = 0
     1815               .
     1816           end.
     1817       end.
     1818   end.
     1819   end procedure.
     1820   procedure torgconf-get-post-head:
     1821   define input  parameter p-obj-type             as character        no-undo.
     1822   define input  parameter p-obj-code             as integer          no-undo.
     1823   define output parameter p-torgconf-post-head   as character        no-undo.
     1824      define variable v-host-code         as integer      no-undo.
     1825      define buffer buf_sysconf     for ub.sysconf.
     1826        assign
     1827         p-torgconf-post-head  = ""
     1828        .
     1829   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1831     (input  p-obj-type
     1832     ,input  p-obj-code
     1833     ,output v-host-code
     1834     )  .
     1835      find first buf_sysconf no-lock
     1836      where buf_sysconf.host-code = v-host-code
     1837      no-error.
     1838      if available buf_sysconf
     1839      then do:
     1840         assign
     1841            p-torgconf-post-head = buf_sysconf.head-position
     1842         .
     1843      end.
     1844   end procedure.
     1845   procedure torgconf-get-storekeeper:
     1846   define input  parameter p-wrkr                   as integer          no-undo.
     1847   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1848   define output parameter p-torgconf-post          as character        no-undo.
     1849      define buffer buf_sysconf     for ub.sysconf.
     1850      define buffer buf_person      for ub.person.
     1851      define buffer buf_shop        for ub.shop .
     1852      define buffer buf_store       for ub.store .
     1853      if v-torgconf-outC = "no_print"
     1854      then do:
     1855         assign p-torgconf-post = ""
     1856                p-torgconf-wrkr-name = ""
     1857                .
     1858      end.
     1859      if v-torgconf-outC = "clad_doc"
     1860      then do:
     1861         run rep/get-psn.p
     1862               (input  p-wrkr
     1863               ,output p-torgconf-wrkr-name
     1864               ) .
     1865         find first buf_person no-lock
     1866         where buf_person.psn-code = p-wrkr
     1867         no-error.
     1868         if available buf_person
     1869         then do:
     1870           p-torgconf-post = buf_person.position.
     1871         end.
     1872         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1873         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1874      end.
     1875      if v-torgconf-outC = "clad_obj"
     1876      then do:
     1877         CASE v-torgconf-self-obj-type:
     1878         WHEN 'маг':U
     1879         THEN DO:
     1880            find first buf_shop no-lock
     1881            where buf_shop.obj-code = v-torgconf-self-obj-code
     1882            .
     1883            assign
     1884               p-torgconf-wrkr-name = buf_shop.store-man
     1885               p-torgconf-post = ""
     1886            .
     1887            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1888         END.
     1889         WHEN 'скл':U
     1890         THEN DO:
     1891            find first buf_store no-lock
     1892            where buf_store.obj-code = v-torgconf-self-obj-code
     1893            .
     1894            assign
     1895               p-torgconf-wrkr-name = buf_store.store-man
     1896               p-torgconf-post = ""
     1897            .
     1898            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1899         END.
     1900         OTHERWISE DO:
     1901            assign
     1902               p-torgconf-post = "":U
     1903               p-torgconf-wrkr-name = "":U
     1904            .
     1905         END.
     1906         END CASE.
     1907      end.
     1908    end procedure.
     1909   procedure torgconf-get-form-header :
     1910   define input parameter p-for-inverse    as logical          no-undo.
     1911   define input parameter p-doc-code       as character        no-undo.
     1912   define input parameter p-print-doc      as logical          no-undo.
     1913   define input parameter p-doc-date       as date             no-undo.
     1914   define input parameter p-fact-date      as date             no-undo.
     1915   define input parameter p-doc-type       as character        no-undo.
     1916   define input parameter p-status_        as character        no-undo.
     1917   define input parameter p-reverse        as logical          no-undo.
     1918   define input parameter p-sf-par         as logical          no-undo.
     1919       define variable v-attr-type         as character    no-undo.
     1920       define variable v-doc-code-standard as logical      no-undo.
     1921       define variable v-doc-date-standard as logical      no-undo.
     1922       define variable v-par-consignee-addres  as character    no-undo.
     1923       define variable v-host-code         as integer      no-undo.
     1924       define variable v-dcode-attr        as character    no-undo.
     1925       define variable v-ddate-attr        as character    no-undo.
     1926       define variable v-doc-date          as character    no-undo.
     1927       define variable v-doc-code          as character    no-undo.
     1928       define variable v-par-type          as character    no-undo.
     1929       define variable v-attr              as character    no-undo.
     1930       define buffer buf_firm          for ub.firm .
     1931       define buffer buf_clients       for ub.clients .
     1932       define buffer buf_sysconf       for ub.sysconf .
     1933       define buffer buf_shop          for ub.shop .
     1934       define buffer buf_store         for ub.store .
     1935       define buffer buf_person        for ub.person .
     1936       define buffer buf_trn-doc       for ub.trn-doc .
     1937       define buffer buf_wth-doc       for ub.wth-doc .
     1938       do
     1939   for buf_firm
     1940     , buf_clients
     1941     , buf_sysconf
     1942     , buf_shop
     1943     , buf_trn-doc
     1944     , buf_person
     1945     , buf_wth-doc
     1946   on error undo, return error
     1947   :
     1948       if p-doc-type = 'при':U
     1949       or p-doc-type = 'возврат':U
     1950       then do:
     1951           assign
     1952               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1953                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1954               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1955                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1956               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1957                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1958               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1959                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1960               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1961               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1962               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1963               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1964               v-torgconf-supplier-type    = v-torgconf-cli-type
     1965               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1966               v-torgconf-saler-type       = v-torgconf-self-host-type
     1967               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1968               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1969               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1970               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1971               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     1972               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     1973               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     1974               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     1975               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     1976               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     1977               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     1978               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     1979               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     1980               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     1981               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     1982           .
     1983           if v-torgconf-cli-schet-exists = yes
     1984           AND v-form-name                  = "torg12":U
     1985           then do:
     1986               assign
     1987                   v-torgconf-supplier = v-torgconf-supplier
     1988                       + substitute( ", р/с &1 к/с &2"
     1989                                   , v-torgconf-cli-bank-r-schet
     1990                                   , v-torgconf-cli-bank-c-schet
     1991                                   )
     1992                   v-torgconf-suppi = v-torgconf-supplier
     1993                       + substitute( ", р/с &1 к/с &2"
     1994                                   , v-torgconf-cli-bank-r-schet
     1995                                   , v-torgconf-cli-bank-c-schet
     1996                                   )
     1997               .
     1998               if v-torgconf-cli-bank-exists = yes
     1999               then do:
     2000                   assign
     2001                       v-torgconf-supplier = v-torgconf-supplier
     2002                           + substitute( " БИК &1 в &2 &3"
     2003                                       , v-torgconf-cli-bank-bik
     2004                                       , v-torgconf-cli-bank-name
     2005                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2006                                       )
     2007                      v-torgconf-suppi = v-torgconf-supplier
     2008                           + substitute( " БИК &1 в &2 &3"
     2009                                       , v-torgconf-cli-bank-bik
     2010                                       , v-torgconf-cli-bank-name
     2011                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2012                                       )
     2013                   .
     2014               end.
     2015           end.
     2016           if v-torgconf-self-schet-exists = yes
     2017           AND v-form-name                  = "torg12":U
     2018           then do:
     2019               assign
     2020                   v-torgconf-saler = v-torgconf-saler
     2021                       + substitute( ", р/с &1 к/с &2"
     2022                                   , v-torgconf-self-bank-r-schet
     2023                                   , v-torgconf-self-bank-c-schet
     2024                                   )
     2025               .
     2026               if v-torgconf-self-bank-exists = yes
     2027               then do:
     2028                   assign
     2029                       v-torgconf-saler = v-torgconf-saler
     2030                           + substitute( " БИК &1 в &2 &3"
     2031                                       , v-torgconf-self-bank-bik
     2032                                       , v-torgconf-self-bank-name
     2033                                       , v-torgconf-self-bank-addres
     2034                                       )
     2035                   .
     2036               end.
     2037           end.
     2038           if v-torgconf-sup-schet-exists = yes
     2039           AND v-form-name                  = "torg12":U
     2040           then do:
     2041               assign
     2042                   v-torgconf-consignee = v-torgconf-consignee
     2043                       + substitute( ", р/с &1 к/с &2"
     2044                                   , v-torgconf-sup-bank-r-schet
     2045                                   , v-torgconf-sup-bank-c-schet
     2046                                   )
     2047               .
     2048             if v-torgconf-sup-bank-exists = yes
     2049              then do:
     2050                assign
     2051                   v-torgconf-consignee = v-torgconf-consignee
     2052                           + substitute( " БИК &1 в &2 &3"
     2053                                       , v-torgconf-sup-bank-bik
     2054                                       , v-torgconf-sup-bank-name
     2055                                       , v-torgconf-sup-bank-addres
     2056                                       )
     2057                   .
     2058               end.
     2059           end.
     2060      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2061      then do:
     2062          assign
     2063            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2064                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2065                                                   , v-torgconf-cli-name
     2066                                                   , ( if v-torgconf-outprncd = yes
     2067                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2068                                                         else "":U )
     2069                                                   , v-torgconf-cli-post-addres
     2070                                                   , v-torgconf-cli-phone
     2071                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2072                                                       AND v-form-name                  = "torg12":U
     2073                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2074                                                               , v-torgconf-cli-bank-r-schet
     2075                                                               , v-torgconf-cli-bank-c-schet
     2076                                                               , v-torgconf-cli-bank-bik
     2077                                                               , v-torgconf-cli-bank-name
     2078                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2079                                                         else "":U )
     2080                                                )
     2081         .
     2082      end.
     2083       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2084                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2085                                        , v-torgconf-cli-name
     2086                                        , ( if v-torgconf-outprncd = yes
     2087                                            then substitute( " (&1)", v-torgconf-cli-code )
     2088                                            else "":U )
     2089                                        , v-torgconf-cli-addres
     2090                                        , v-torgconf-cli-phone
     2091                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2092                                            AND v-form-name                  = "torg12":U
     2093                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2094                                                           , v-torgconf-cli-bank-r-schet
     2095                                                           , v-torgconf-cli-bank-c-schet
     2096                                                           , v-torgconf-cli-bank-bik
     2097                                                           , v-torgconf-cli-bank-name
     2098                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2099                                                   else "":U )
     2100                                        ).
     2101       end.
     2102       else do:
     2103       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2104                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2105                                        , v-torgconf-self-host-name
     2106                                        , ( if v-torgconf-outprncd = yes
     2107                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2108                                            else "":U )
     2109                                        , v-torgconf-self-host-addres
     2110                                        , v-torgconf-self-host-phone
     2111                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2112                                            AND v-form-name                  = "torg12":U
     2113                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2114                                                           , v-torgconf-self-bank-r-schet
     2115                                                           , v-torgconf-self-bank-c-schet
     2116                                                           , v-torgconf-self-bank-bik
     2117                                                           , v-torgconf-self-bank-name
     2118                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2119                                                   else "":U )
     2120                                           ).
     2121         if v-torgconf-outares = yes
     2122         and p-reverse = no
     2123         then do:
     2124            assign
     2125               v-par-consignee-addres = v-torgconf-ship-post-addres
     2126            .
     2127         end.
     2128         if v-torgconf-outares = no
     2129         and p-reverse = no
     2130         then do:
     2131            assign
     2132               v-par-consignee-addres = v-torgconf-ship-addres
     2133            .
     2134         end.
     2135         if p-reverse = yes
     2136         then do:
     2137             assign
     2138               v-par-consignee-addres = v-torgconf-ship-addres
     2139             .
     2140         end.
     2141           assign
     2142               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2143                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2144               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2145                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2146               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2147                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2148               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2149               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2150               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2151               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2152               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2153               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2154               v-torgconf-saler-type       = v-torgconf-cli-type
     2155               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2156               v-torgconf-consignee-type   = v-torgconf-ship-type
     2157               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2158               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2159               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2160               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2161               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2162               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2163               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2164               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2165               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2166               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2167               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2168               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2169               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
