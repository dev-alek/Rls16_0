     3050            v-torgconf-vdoc-date = "          "
     3051           .
     3052       end.
     3053       else do:
     3054           if lookup( v-torgconf-ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ) <> 0
     3055           then do:
     3056               run gbl/wthat-v.p (
     3057                     input p-doc-code
     3058                   , input 'wthdsf':U
     3059                   , output v-torgconf-doc-date
     3060                   , output v-attr-type
     3061               ).
     3062               assign
     3063                   v-doc-date-standard = ( trim( v-torgconf-doc-date ) = "":U )
     3064               .
     3065           end.
     3066           else do:
     3067               assign
     3068                   v-doc-date-standard = yes
     3069               .
     3070           end.
     3071           if v-doc-date-standard = yes
     3072           then do:
     3073               assign v-torgconf-doc-date =  ( if p-status_ <> 'факт':U
     3074                                               or p-print-doc = yes
     3075                                               then string( p-doc-date, "99/99/9999" )
     3076                                               else string( p-fact-date, "99/99/9999" )
     3077                                           )
     3078               .
     3079           end.
     3080           assign v-torgconf-vdoc-date = ( if p-status_ <> 'факт':U
     3081                                             then string( p-doc-date, "99/99/9999" )
     3082                                             else string( p-fact-date, "99/99/9999" )
     3083                                         )
     3084           .
     3085           if p-doc-type = 'при':U
     3086              then do:
     3087                 run gbl/trdcat-v.p (
     3088                     input p-doc-code
     3089                   , input 'dids':U
     3090                   , output v-torgconf-doc-date-attr
     3091                   , output v-attr-type
     3092                ).
     3093              end.
     3094           if trim(v-torgconf-doc-date-attr) <> ""
     3095           then do:
     3096               assign v-torgconf-vdoc-date = v-torgconf-doc-date-attr
     3097               .
     3098           end.
     3099       end.
     3100      if  v-name <> 'wthtrg12'
     3101      and v-name <> 'wthfct'
     3102      and v-name <> 'wthm11'
     3103      then do:
