     4732   define variable sym2                as char     init ":" no-undo.
     4733   define variable sym3                as char     init ":" no-undo.
     4734   define variable sym4                as char     init ":" no-undo.
     4735   define variable sym5                as char     init ":" no-undo.
     4736   define variable sym6                as char     init ":" no-undo.
     4737   define variable sym7                as char     init ":" no-undo.
     4738   define variable sym8                as char     init ":" no-undo.
     4739   define variable sym9                as char     init ":" no-undo.
     4740   define variable sym10               as char     init ":" no-undo.
     4741   define variable sym11               as char     init ":" no-undo.
     4742   def buffer buf_trn-doc          for trn-doc.
     4743   def buffer buf_goods            for goods.
     4744   def buffer buf_clients          for clients.
     4745   def buffer buf_doc-line         for doc-line.
     4746   define variable v-date           as character    no-undo.
     4747   define variable v-manuf-date     as character    no-undo.
     4748   define variable v-protokol       as character    no-undo.
     4749   define variable v-protokol0      as character    no-undo.
     4750   define variable v-single-line    as character    no-undo.
     4751   define variable v-organization   as character    no-undo.
     4752   define variable v-h-num          as character    no-undo.
     4753   define variable str              as character    no-undo.
     4754   define variable str1             as character    no-undo.
     4755   define variable str2             as character    no-undo.
     4756   define variable v-adres          as character    no-undo.
     4757   define variable v-adres-u        as character    no-undo.
     4758   define variable v-adres-p        as character    no-undo.
     4759   define variable v-phone          as character    no-undo.
     4760   define variable v-sert           as character    no-undo.
     4761   define variable v-place          as decimal      no-undo.
     4762   define variable v-place-str      as character    no-undo.
     4763   define variable v-host-code      as integer      no-undo.
     4764   define variable v-curr-code      as integer      no-undo.
     4765   define variable v-ch             as logical init false   no-undo.
     4766   define variable v-number         as integer      no-undo.
     4767   define variable v-keeping0       as character    no-undo.
     4768   define variable v-keeping        as character    no-undo.
     4769   define variable kep              as character    no-undo.
     4770   define variable kep1             as character    no-undo.
     4771   define variable kep2             as character    no-undo.
     4772   define variable prot             as character    no-undo.
     4773   define variable prot1            as character    no-undo.
     4774   define variable prot2            as character    no-undo.
     4775   define variable v-gds-name       as character    no-undo.
     4776   define variable gds-name_        as character    no-undo.
     4777   define variable gds-name1        as character    no-undo.
     4778   define variable gds-name2        as character    no-undo.
     4779   define variable v-msf-name       as character    no-undo .
     4780   define variable v-uniq-key-rec   as character    no-undo .
     4781   define buffer buf_condition-keeping for ub.condition-keeping.
     4782   define buffer buf_parts for ub.parts.
     4783   define buffer buf_ext-classif for ub.ext-classif.
     4784   define buffer buf_clob-bind for ub.clob-bind.
     4785   define variable g#report-num     as integer      no-undo .
     4786   define variable g#quest-print    as logical      no-undo.
     4787   define variable g#log            as logical      no-undo.
     4788   define variable vss-include-info22 as character format "X(65)" no-undo
     4789   initial "@(#)$Workfile$ $Revision$".
     4790   define stream excel-line.
     4791   define stream excel-cell.
     4792   define temp-table temp_cell-data no-undo
     4793       field data-key as character
     4794       field data-value as character
     4795       index pi is primary unique data-key
     4796   .
     4797   define temp-table temp_Template_line-data no-undo
     4798       field template-name    as character
     4799       field xl-line-id       as integer
     4800       field df_struct        as character
     4801       field df_Name          as character
     4802       field df_manuf         as character
     4803       field df_qnty          as decimal
     4804       field df_vplace        as character
     4805       field df_deadline      as character
     4806       field df_protokol      as character
     4807       index pi is primary unique
     4808           xl-line-id
     4809   .
     4810   define variable v-certxl-Template-cur-data-row     as integer      no-undo.
     4811   define variable v-certxl-cell-file-name       as character    no-undo.
     4812   define variable v-certxl-data-file-name       as character    no-undo.
     4813   procedure certxl-init :
     4814   do
     4815   on error undo, return error
     4816   :
     4817       assign
     4818           v-certxl-Template-cur-data-row = 0
     4819       .
     4820       run gbl/_tmpfile.p (
     4821             input "xd"
     4822           , input ".txt"
     4823           , output v-certxl-data-file-name
     4824       ).
     4825       output stream excel-line to value( v-certxl-data-file-name ).
     4826       run gbl/_tmpfile.p (
     4827             input "xc"
     4828           , input ".txt"
     4829           , output v-certxl-cell-file-name
     4830       ).
     4831       output stream excel-cell to value( v-certxl-cell-file-name ).
     4832       run certxl-write-cell-data in this-procedure (
     4833             input "sheetList":U
     4834           , input "Template":U
     4835       ).
     4836       if printrubl
     4837       then do:
     4838           run certxl-write-cell-data in this-procedure (
     4839                 input "Template_valutCode":U
     4840               , input "0":U
     4841           ).
     4842       end.
     4843       else do:
     4844          run certxl-write-cell-data in this-procedure (
     4845                 input "Template_valutCode":U
     4846               , input "1":U
     4847          ).
     4848       end.
     4849       run certxl-write-cell-data in this-procedure (
     4850             input "Template_columnList":U
     4851           , input "df_struct,df_Name,df_manuf,df_qnty,df_vplace,df_deadline,df_protokol":U
     4852       ).
     4853       run certxl-write-cell-data in this-procedure (
     4854             input "Template_columnType":U
     4855           , input "S,S,S,D,S,S,S":U
     4856       ).
     4857       run certxl-write-cell-data in this-procedure (
     4858             input "Template_subtotalList":U
     4859           , input "":U
     4860       ).
     4861       run certxl-write-cell-data in this-procedure (
     4862             input "Template_subtotalType":U
     4863           , input "":U
     4864       ).
     4865   end.
     4866   end procedure.
     4867   procedure certxl-Template-write-line-data :
     4868   define input parameter p-df_struct    as character      no-undo.
     4869   define input parameter p-df_Name      as character      no-undo.
     4870   define input parameter p-df_manuf     as character      no-undo.
     4871   define input parameter p-df_qnty      as decimal        no-undo.
     4872   define input parameter p-df_vplace    as character      no-undo.
     4873   define input parameter p-df_deadline  as character      no-undo.
     4874   define input parameter p-df_protokol  as character      no-undo.
     4875       define buffer buf_temp_Template_line-data        for temp_Template_line-data.
     4876   do
     4877   for buf_temp_Template_line-data
     4878   on error undo, return error
     4879   :
     4880       for each buf_temp_Template_line-data
     4881       :
     4882           delete buf_temp_Template_line-data.
     4883       end.
     4884       create buf_temp_Template_line-data.
     4885       assign
     4886           v-certxl-Template-cur-data-row            = v-certxl-Template-cur-data-row + 1
     4887           buf_temp_Template_line-data.template-name = "Template":U
     4888           buf_temp_Template_line-data.xl-line-id    = v-certxl-Template-cur-data-row
     4889           buf_temp_Template_line-data.df_struct     = p-df_struct
     4890           buf_temp_Template_line-data.df_Name       = p-df_Name
     4891           buf_temp_Template_line-data.df_manuf      = p-df_manuf
     4892           buf_temp_Template_line-data.df_qnty       = p-df_qnty
     4893           buf_temp_Template_line-data.df_vplace     = p-df_vplace
     4894           buf_temp_Template_line-data.df_deadline   = p-df_deadline
     4895           buf_temp_Template_line-data.df_protokol   = p-df_protokol
     4896       .
     4897       put stream excel-line unformatted
     4898                           buf_temp_Template_line-data.Template-name
     4899           chr(9)   "DTA":U
     4900           chr(9)   buf_temp_Template_line-data.df_struct
     4901           chr(9)   buf_temp_Template_line-data.df_Name
     4902           chr(9)   buf_temp_Template_line-data.df_manuf
     4903           chr(9)   buf_temp_Template_line-data.df_qnty
     4904           chr(9)   buf_temp_Template_line-data.df_vplace
     4905           chr(9)   buf_temp_Template_line-data.df_deadline
     4906           chr(9)   buf_temp_Template_line-data.df_protokol
     4907           chr(10)
     4908       .
     4909   end.
     4910   end procedure.
     4911   procedure certxl-write-cell-data :
     4912   define input parameter p-data-key   as character        no-undo.
     4913   define input parameter p-data-value as character        no-undo.
     4914       define buffer buf_temp_cell-data     for temp_cell-data.
     4915   do
     4916   for buf_temp_cell-data
     4917   on error undo, return error
     4918   :
     4919       find first buf_temp_cell-data
     4920            where buf_temp_cell-data.data-key = p-data-key
     4921       no-error.
     4922       if not available buf_temp_cell-data
     4923       then do:
     4924           create buf_temp_cell-data.
     4925           assign
     4926               buf_temp_cell-data.data-key = p-data-key
     4927           .
     4928       end.
     4929       assign
     4930           buf_temp_cell-data.data-value = p-data-value
     4931       .
     4932       put stream excel-cell unformatted
     4933                           buf_temp_cell-data.data-key
     4934           chr(9)   buf_temp_cell-data.data-value
     4935           chr(10)
     4936       .
     4937   end.
     4938   end procedure.
     4939   procedure certxl-run-excel :
     4940   define input parameter p-header-filename    as character        no-undo.
     4941   define input parameter p-data-filename      as character        no-undo.
     4942       define variable v-template-file-name    as character    no-undo.
     4943       define variable v-vb-file-name          as character    no-undo.
     4944       define buffer buf_temp-param for temp-param .
     4945   do
     4946   for buf_temp-param
     4947   on error undo, return error
     4948   :
     4949       create buf_temp-param.
     4950       assign
     4951           v-template-file-name    = search( "exe/celt.xlt" )
     4952           v-vb-file-name          = search( "exe/t_form.bas")
     4953       .
     4954       if v-template-file-name = ?
     4955       or v-template-file-name = "":U
     4956       then do:
     4957           message
     4958               "Ошибка имени файла шаблона."
     4959           view-as alert-box error.
     4960       end.
     4961       if v-vb-file-name = ?
     4962       or v-vb-file-name = "":U
     4963       then do:
     4964           message
     4965               "Ошибка имени файла кода обработки."
     4966           view-as alert-box error.
     4967       end.
     4968       run paramls-write in this-procedure (
     4969             input "template":U
     4970           , input "template-file-name":U
     4971           , input v-template-file-name
     4972       ).
     4973       run paramls-write in this-procedure (
     4974             input "template":U
     4975           , input "vb-file-name":U
     4976           , input v-vb-file-name
     4977       ).
     4978       run paramls-write in this-procedure (
     4979             input "data":U
     4980           , input "data-header-filename":U
     4981           , input p-header-filename
     4982       ).
     4983       run paramls-write in this-procedure (
     4984             input "data":U
     4985           , input "data-filename":U
     4986           , input p-data-filename
     4987       ).
     4988       run gbl/macroxlt.p (
     4989           input-output table buf_temp-param
     4990       ) no-error.
     4991       if error-status :error
     4992       then do:
     4993           message
     4994                    vss-workfile vss-revision vss-description
     4995               skip(1)
     4996               skip "Ошибка создания файла Excel."
     4997               skip return-value
     4998               skip trim(error-status :get-message(1))
     4999                    trim(error-status :get-message(2))
     5000                    trim(error-status :get-message(3))
     5001           view-as alert-box error.
     5002           undo, return error .
     5003       end.
     5004   end.
     5005   end procedure.
     5006   procedure certxl-close :
     5007   do
     5008   on error undo, return error
     5009   :
     5010       output stream excel-line close.
     5011       output stream excel-cell close.
     5012       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     5013           export "exe/celt.xlt":U.
     5014           export "exe/t_form.bas":U.
     5015           export v-certxl-cell-file-name.
     5016           export v-certxl-data-file-name.
     5017       output close.
     5018   end.
     5019   end procedure.
     5020   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5021     define variable v-cntxt-db-num        as integer   no-undo .
     5022     define variable v-cntxt-userid        as character no-undo .
     5023     define variable v-cntxt-level         as character no-undo .
     5024     define variable v-cntxt-host-code-obj as integer   no-undo .
     5025     define variable v-cntxt-obj-type      as character no-undo .
     5026     define variable v-cntxt-obj-code      as integer   no-undo .
     5027     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5028     define variable v-cntxt-is-admin      as logical   no-undo .
     5029   FUNCTION get-in-code-date RETURNS CHARACTER  ( input p-gds-code as integer
     5030                                                 ,input p-artic as character
     5031                                                 ,input p-prod-type as character
     5032                                                 ,input p-prod-code as integer
     5033                                                 ,input p-obj-type  as character
     5034                                                 ,input p-obj-code  as integer
     5035                                                 ,input p-in-code as character
     5036                                                 ,input p-out-code as character
     5037                                                 ,input p-part-code as character
     5038                                                  ) :
     5039   define buffer buf_parts-attr for ub.parts-attr  .
     5040   find first buf_parts-attr no-lock where
     5041             buf_parts-attr.part-code = p-part-code
     5042         and buf_parts-attr.in-code = p-in-code
     5043         and buf_parts-attr.gds-code = p-gds-code  no-error .
     5044   if available buf_parts-attr then return string ( buf_parts-attr.fact-date, "99/99/9999" ) .
     5045    else return "" .
     5046   END FUNCTION.
     5047   define frame f-doc
     5048           sym1 column-label ":!:" format "X(1)" space(0)
     5049   v-gds-name column-label "Наименование продукта, группа, категория.!вид.подвид. термическое состояние":C50 format "X(50)" space(0)
     5050           sym2 column-label ":!:!" format "X(1)" space(0)
     5051   v-manuf-date COLUMN-LABEL "Дата выработки/!упаковывания!время выработки!смотри на уп-ке":C15 format "X(15)" space(0)
     5052           sym3 column-label ":!:" format "X(1)" space(0)
     5053   buf_parts.fact-qnty COLUMN-LABEL "Масса нетто или!выход готового изделия":C22 format "->>,>>>,>>9.<<<" space(0)
     5054           sym4 column-label ":!:" format "X(1)" space(0)
     5055   v-place-str COLUMN-LABEL "Число мест/число единиц!потребительской упаковки":C24 format "X(15)"  space(0)
     5056           sym5 column-label ":!:" format "X(1)" space(0)
     5057   v-keeping COLUMN-LABEL "Срок годности/!условия хранения":C17 format "X(16)" space(0)
     5058           sym6 column-label ":!:" format "X(1)" space(0)
     5059   v-protokol COLUMN-LABEL "Протокол приемо-!сдаточный №, дата":C20 format "X(20)" space(0)
     5060           sym7 column-label ":!:" format "X(1)" space(0)
     5061   v-sert COLUMN-LABEL "Технический документ!(ТУ,ОСТ)":C37 format "X(37)" space(0)
     5062           sym8 column-label ":!:" format "X(1)" space(0)
     5063       header
     5064           string( "Страница " + string( PAGE-NUMBER( out-stream ), ">>9" ) ) at 160 format "X(13)" skip
     5065           v-single-line format "X(193)" at 1
     5066       with width 235 down stream-io use-text .
     5067   run get-report-num in p-mainmenu-handle (
     5068       output g#report-num
     5069   ).
     5070   run get-quest-print in p-mainmenu-handle (
     5071       output g#quest-print
     5072   ).
     5073   assign
     5074      v-single-line = fill("-", 230)
     5075   .
     5076   output stream out-stream to value( string( session:temp-directory +
     5077                                        "rpt" + string( g#report-num ) ) )
     5078                                        page-size  value(43) .
     5079     form header
     5080               v-single-line format "X(191)" at 1 skip
     5081               "Продолжение - на следующей странице" at 30 skip
     5082               with frame Bottomframe width 232 page-bottom no-labels no-box .
     5083     view stream out-stream frame bottomframe .
     5084   find first buf_trn-doc no-lock where recid(buf_trn-doc) = p-trn-doc-recid.
     5085   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5086   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5087     (input  buf_trn-doc.obj-type
     5088     ,input  buf_trn-doc.obj-code
     5089     ,output v-host-code
     5090     )  .
     5091   if printRubl = yes
     5092   then do:
     5093       assign
     5094           v-curr-code = 0
     5095       .
     5096   end.
     5097   else do:
     5098   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5099   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     5100     (input  v-host-code
     5101     ,output v-curr-code
     5102     )  .
     5103   end.
     5104   run torgconf-get-self-param in this-procedure (
     5105         input buf_trn-doc.obj-type
     5106       , input buf_trn-doc.obj-code
     5107       , input v-curr-code
     5108   ) no-error.
     5109   if error-status :error
     5110   then do:
     5111       message
     5112       vss-workfile vss-revision vss-description
     5113       skip "Ошибка чтения параметров объекта документа."
     5114       skip return-value
     5115       skip trim(error-status :get-message(1))
     5116           trim(error-status :get-message(2))
     5117           trim(error-status :get-message(3))
     5118       view-as alert-box warning.
     5119   end.
     5120   assign
     5121   V-organization = substitute("&1. Юрид.адрес: &2. &3. &4"
     5122                               , v-torgconf-self-host-name
     5123                               , v-torgconf-self-host-addres
     5124                               , (if v-torgconf-self-host-post-addres<>v-torgconf-self-host-addres  and  v-torgconf-self-host-post-addres  <> ''
     5125                                  then ("Почт.адрес: " + v-torgconf-self-host-post-addres)
     5126                                  else "")
     5127                               , v-torgconf-self-host-phone
     5128                               )
     5129      v-h-num = substitute("КАЧЕСТВЕННОЕ УДОСТОВЕРЕНИЕ № &1 от &2 г. ", buf_trn-doc.doc-code, buf_trn-doc.doc-date)
     5130   v-adres = substitute("Юрид.адрес: &1. &2. &3."
     5131                        ,v-torgconf-self-host-addres
     5132                        ,(if v-torgconf-self-host-post-addres <> v-torgconf-self-host-addres and  v-torgconf-self-host-post-addres  <> ''
     5133                          then ("Почт.адрес: " + v-torgconf-self-host-post-addres)
     5134                          else "")
     5135                        ,v-torgconf-self-host-phone
     5136   )
     5137   v-adres-u = substitute("Юрид.адрес: &1.", v-torgconf-self-host-addres)
     5138   v-adres-p = (if v-torgconf-self-host-post-addres <> v-torgconf-self-host-addres
     5139                and v-torgconf-self-host-post-addres  <> ''
     5140                then ("Почт.адрес: " + v-torgconf-self-host-post-addres)
     5141                else "")
     5142   v-phone = v-torgconf-self-host-phone
     5143   v-organization = right-trim(v-organization, ". ")
     5144   v-adres = right-trim(v-adres, ". ")
     5145   .
     5146   put stream out-stream
     5147     v-torgconf-self-host-name format "X(190)" skip
     5148     v-adres-u format "X(190)" skip(0).
     5149   put stream out-stream
     5150     v-adres-p format "X(190)" skip(0).
     5151   put stream out-stream
     5152     v-phone format "X(190)" skip(1)
     5153     Centering(v-h-num, 176 )  format "X(190)" .
     5154   run certxl-init in this-procedure .
     5155   run certxl-write-cell-data in this-procedure ( input "h_org":U  , input v-torgconf-self-host-name ).
     5156   run certxl-write-cell-data in this-procedure ( input "h_adresu":U, input string(v-adres-u, "x(150)")).
     5157   run certxl-write-cell-data in this-procedure ( input "h_adresp":U, input STRING(v-adres-p, "x(150)") ).
     5158   run certxl-write-cell-data in this-procedure ( input "h_phone":U, input v-phone ).
     5159   run certxl-write-cell-data in this-procedure ( input "h_num":U  , input v-h-num ).
     5160   run meatsemi_fill-msf in this-procedure ( input 'ПРОСМОТР':U
     5161                                           , buffer buf_clob-bind).
     5162    for each buf_doc-line no-lock
     5163    where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5164    ,each buf_parts no-lock where
     5165             buf_parts.obj-type = buf_trn-doc.obj-type
     5166         and buf_parts.obj-code = buf_trn-doc.obj-code
     5167         and buf_parts.artic = buf_doc-line.artic
     5168         and buf_parts.prod-type = buf_doc-line.prod-type
     5169         and buf_parts.prod-code = buf_doc-line.prod-code
     5170         and buf_parts.out-code = buf_trn-doc.doc-code :
     5171     find first buf_goods no-lock
     5172     where buf_goods.artic      = buf_parts.artic
     5173     and buf_goods.prod-type    = buf_parts.prod-type
     5174     and buf_goods.prod-code    = buf_parts.prod-code .
     5175       v-uniq-key-rec = ''.
     5176       run gen-key-rec in this-procedure ( input 'goods':U
     5177                                          ,input buffer buf_goods:handle
     5178                                          ,output v-uniq-key-rec ).
     5179       find first buf_ext-classif no-lock where
     5180                 buf_ext-classif.classif-subject = 'goods':U
     5181            and buf_ext-classif.classif-name = 'msf-code':U
     5182             AND buf_ext-classif.db-num = - 1
     5183             and buf_ext-classif.uniq-key-rec = v-uniq-key-rec no-error.
     5184      if available buf_ext-classif then do:
     5185        find first meat-semi-finished  where
     5186                 meat-semi-finished.node-code = buf_ext-classif.key#_one no-error.
     5187        if available meat-semi-finished then do:
     5188          v-msf-name = substitute("Группа - &1 п/ф, вид - &2 п/ф, подвид - &3, &4, &5"
     5189                                 , meat-semi-finished.group-name
     5190                                 , meat-semi-finished.kind-name
     5191                                 , trim(replace(replace(meat-semi-finished.subkind-name, "-", "")
     5192                                           ,chr(44) + chr(44), chr(44))
     5193                                           ,chr(44))
     5194                                 , meat-semi-finished.category-name
     5195                                 , meat-semi-finished.termic-condition-name).
     5196        end.
     5197        else do:
     5198          v-msf-name = ''.
     5199        end.
     5200       end.
     5201       else do:
     5202         v-msf-name = ''.
     5203       end.
     5204          assign
     5205       v-place-str = Center-Field ( input string(round(buf_parts.fact-qnty / buf_goods.qnty-cart, 0))
     5206                                   ,INPUT 24
     5207                                   ,INPUT 24
     5208                                   ,INPUT chr(32) )
     5209            v-ch = false
     5210       v-manuf-date  = get-in-code-date( buf_goods.gds-code
     5211                                 ,buf_goods.artic
     5212                                 ,buf_goods.prod-type
     5213                                 ,buf_goods.prod-code
     5214                                 ,buf_trn-doc.obj-type
     5215                                 ,buf_trn-doc.obj-code
     5216                                 ,buf_parts.in-code
     5217                                 ,buf_trn-doc.doc-code
     5218                                 ,buf_parts.part-code
     5219                                 )
     5220       .
     5221       find first buf_condition-keeping no-lock where
     5222               buf_condition-keeping.cond-keep-code = buf_goods.cond-keep-code no-error.
     5223       assign
     5224       v-keeping0 = ''
     5225       v-keeping = ''
     5226       v-protokol = ''
     5227       v-protokol0 = ''
     5228       kep = ''
     5229       kep2 = ''
     5230       prot = ''
     5231       prot2 = ''
     5232       .
     5233       ASSIGN
     5234       v-keeping0 = substitute("&1 сут./ &2"
     5235                              , buf_goods.deadline
     5236                              , (if available buf_condition-keeping
     5237                                then substitute("&1 при t от &2 до &3 град C, влажности от &4 до &5 %"
     5238                                               ,buf_condition-keeping.des
     5239                                               ,buf_condition-keeping.t-mode-from
     5240                                               ,buf_condition-keeping.t-mode-to
     5241                                               ,buf_condition-keeping.h-mode-from
     5242                                               ,buf_condition-keeping.h-mode-to
     5243                                               )
     5244                                else '')
     5245                              )
     5246       kep = v-keeping0
     5247       gds-name_ = buf_goods.gds-name + chr(32) + v-msf-name
     5248       v-protokol0 = substitute("№ &1 от даты выработки", buf_parts.artic)
     5249       prot = v-protokol0
     5250          .
     5251       assign
     5252       v-place =round((buf_parts.fact-qnty)/(buf_goods.qnty-cart),0)
     5253       .
     5254       if length(buf_goods.sert) > 37
     5255       or length(kep) > 17
     5256       or length(gds-name_) > 50
     5257       or length(prot) > 20
     5258      then do:
     5259            ASSIGN
     5260         str = STRING(buf_goods.sert).
     5261               str1 = breakstr( str,37, INPUT-OUTPUT str1, INPUT-OUTPUT str2 ).
     5262         v-sert = str1.
     5263         kep1 = breakstr( kep, 17,  INPUT-OUTPUT kep1, INPUT-OUTPUT kep2 ).
     5264         v-keeping = kep1.
     5265         gds-name1 = breakstr( gds-name_, 50,  INPUT-OUTPUT gds-name1, INPUT-OUTPUT gds-name2 ).
     5266         prot1 = breakstr( prot, 20,  INPUT-OUTPUT prot1, INPUT-OUTPUT prot2 ).
     5267         v-protokol = prot1.
     5268         v-gds-name = gds-name1.
     5269            display stream out-stream
     5270         sym1
     5271         v-gds-name
     5272         sym2
     5273         v-manuf-date
     5274         sym3
     5275         buf_parts.fact-qnty
     5276         sym4
     5277         v-place-str
     5278         sym5
     5279         v-keeping
     5280         sym6
     5281         v-protokol
     5282         sym7
     5283         v-sert
     5284         sym8
     5285         with frame f-doc .
     5286                           DOWN STREAM out-stream 1 WITH FRAME f-doc.
     5287         DO WHILE TRIM( str2 ) <> "":U
     5288         or trim(kep2) <> ""
     5289         or trim(prot2) <> ""
     5290         or trim(gds-name2) <> ""     :
     5291            ASSIGN
     5292               str  = str2
     5293               str1 = breakstr( str,37, INPUT-OUTPUT str1, INPUT-OUTPUT str2 )
     5294           v-sert = str1.
     5295           .
     5296           ASSIGN
     5297           kep  = kep2
     5298           kep1 = breakstr( kep,17, INPUT-OUTPUT kep1, INPUT-OUTPUT kep2 )
     5299           v-keeping = kep1.
     5300           .
     5301           ASSIGN
     5302           prot  = prot2
     5303           prot1 = breakstr( prot, 20, INPUT-OUTPUT prot1, INPUT-OUTPUT prot2 )
     5304           v-protokol = prot1.
     5305           .
     5306           ASSIGN
     5307           gds-name_  = gds-name2
     5308           gds-name1 = breakstr( gds-name_,50, INPUT-OUTPUT gds-name1, INPUT-OUTPUT gds-name2 )
     5309           v-gds-name = gds-name1.
     5310            .
     5311            display stream out-stream
     5312           v-gds-name
     5313           sym1
     5314           sym2
     5315           sym3
     5316           sym4
     5317           sym5
     5318           v-keeping
     5319           sym6
     5320           v-protokol
     5321           sym7
     5322           v-sert
     5323           sym8
     5324           with frame f-doc .
     5325                           DOWN STREAM out-stream 1 WITH FRAME f-doc.
     5326            END.
     5327      end.
     5328      else do:
     5329         assign
     5330         v-sert = buf_goods.sert
     5331         .
     5332         display stream out-stream
     5333         sym1
     5334         buf_goods.gds-name + chr(32) + v-msf-name @ v-gds-name
     5335         sym2
     5336         v-manuf-date
     5337         sym3
     5338         buf_parts.fact-qnty
     5339         sym4
     5340         v-place-str
     5341         sym5
     5342         v-keeping
     5343         sym6
     5344         v-protokol
     5345         sym7
     5346         v-sert
     5347         sym8
     5348         with frame f-doc .
     5349                 DOWN STREAM out-stream 1 WITH FRAME f-doc.
     5350      end.
     5351   run certxl-Template-write-line-data (     input buf_goods.sert
     5352                                           , input buf_goods.gds-name + chr(32) + v-msf-name
     5353                                           , input v-manuf-date
     5354                                           , input buf_parts.fact-qnty
     5355                                           , input v-place-str
     5356                                           , input v-keeping0
     5357                                           , input v-protokol0
     5358                                         ) .
     5359   end.
     5360   run certxl-close in this-procedure .
     5361   put stream out-stream
     5362   v-single-line format "X(193)" skip(2)
     5363             string('Продукция изготовлена в соответствии с  ГОСТ Р 52675-2006 "Полуфабрикаты мясные и мясосодержащие" и сертифицирована.')format "X(160)"  skip(2)
     5364             string("") format "X(160)"  skip(2)
     5365   space(35) string("_______________          ______________              ______________") format "X(70)"  skip
     5366   space(35) string("   Должность                подпись                       Ф.И.О    ") format "X(70)"  skip(1)
     5367   space(50) string(" М.П.") format "X(5)" skip  .
     5368   hide stream out-stream frame bottomframe .
     5369   output stream out-stream close.
     5370   if g#quest-print = false
     5371   then do:
     5372     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5373                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5374                                         OUTPUT g#log ).
     5375   end.
     5376   else do:
     5377     os-command silent
     5378       value( "COPY /b " +
     5379         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5380         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5381         string( session:temp-directory) +  "$" + string( g#report-num )
     5382                 ) .
     5383     os-command silent
     5384       value( "COPY /b " +
     5385         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5386         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5387         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5388                 ) .
     5389   end.
     5390   procedure round:
     5391   define input  parameter p-dec as decimal no-undo.
     5392   define output parameter p-int as decimal no-undo.
     5393   if p-dec - TRUNCATE (p-dec, 0) <> 0
     5394   then do:
     5395       assign
     5396         p-int = TRUNCATE (p-dec, 0) + 1
     5397       .
     5398   end.
     5399   else do:
     5400       assign
     5401         p-int = p-dec
     5402       .
     5403   end.
     5404   end procedure.
     5405   end.
