     1572   procedure torgconf-get-sup-param :
     1573   define input parameter p-obj-type           as character        no-undo.
     1574   define input parameter p-obj-code           as integer          no-undo.
     1575   define input parameter p-curr-code          as integer          no-undo.
     1576       define variable v-host-code    as integer      no-undo.
     1577       define variable v-par-type     as character    no-undo.
     1578   do
     1579   on error undo, return error
     1580   :
     1581       assign
     1582          v-torgconf-sup-host-code = v-host-code
     1583       .
     1584       if v-torgconf-sup-host-code = 0
     1585       then do:
     1586           assign
     1587               v-torgconf-sup-host-name           = "":U
     1588               v-torgconf-sup-host-addres         = "":U
     1589               v-torgconf-sup-host-post-addres    = "":U
     1590               v-torgconf-sup-host-phone          = "":U
     1591               v-torgconf-sup-host-inn            = "":U
     1592               v-torgconf-sup-host-kpp            = "":U
     1593               v-torgconf-sup-host-okpo           = "":U
     1594               v-torgconf-sup-host-egrip-date     = "":U
     1595               v-torgconf-sup-host-egrip-num      = "":U
     1596           .
     1597       end.
     1598       else do:
     1599           run fmtcli-get-client in this-procedure (
     1600                 input 'орг':U
     1601               , input v-torgconf-sup-host-code
     1602           ).
     1603           assign
     1604               v-torgconf-sup-host-name        = v-fmtcli-name
     1605               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1606               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1607               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1608               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1609               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1610               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1611               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1612           .
     1613           run gbl/clntat-v.p (
     1614                 input 'орг':U
     1615               , input v-torgconf-sup-host-code
     1616               , input 'egrip-date':U
     1617               , output v-torgconf-sup-host-egrip-date
     1618               , output v-par-type
     1619           ).
     1620           run gbl/clntat-v.p (
     1621                 input 'орг':U
     1622               , input v-torgconf-sup-host-code
     1623               , input 'egrip-num':U
     1624               , output v-torgconf-sup-host-egrip-num
     1625               , output v-par-type
     1626           ).
     1627           run fmtcli-get-bank in this-procedure (
     1628                 input v-host-code
     1629               , input 'орг':U
     1630               , input v-torgconf-sup-host-code
     1631               , input p-curr-code
     1632           ).
     1633       end.
     1634       assign
     1635           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1636           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1637           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1638           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1639           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1640           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1641           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1642           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1643       .
     1644       assign
     1645           v-torgconf-sup-obj-type = p-obj-type
     1646           v-torgconf-sup-obj-code = p-obj-code
     1647       .
     1648       if trim(p-obj-type) <> ""
     1649       and p-obj-code <> 0
     1650       then do:
     1651       run fmtcli-get-client in this-procedure (
     1652             input p-obj-type
     1653           , input p-obj-code
     1654       ).
     1655       assign
     1656           v-torgconf-sup-obj-name        = v-fmtcli-name
     1657           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1658           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1659           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1660           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1661           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1662           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1663       .
     1664      end.
     1665      end.
     1666   end procedure.
