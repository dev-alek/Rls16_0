     1232   procedure torgconf-get-self-param :
     1233   define input parameter p-obj-type           as character        no-undo.
     1234   define input parameter p-obj-code           as integer          no-undo.
     1235   define input parameter p-curr-code          as integer          no-undo.
     1236       define variable v-host-code    as integer      no-undo.
     1237       define variable v-par-type     as character    no-undo.
     1238   do
     1239   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1240   :
     1241   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1242   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1243     (input  p-obj-type
     1244     ,input  p-obj-code
     1245     ,output v-host-code
     1246     )  .
     1247       if v-torgconf-outhold = yes
     1248       then do:
     1249           run torgconf-get-holdfirm-code in this-procedure (
     1250                 input p-obj-type
     1251               , input p-obj-code
     1252               , output v-torgconf-self-host-code
     1253           ).
     1254           if v-torgconf-self-host-code = 0
     1255           then do:
     1256               return error.
     1257           end.
     1258       end.
     1259       else do:
     1260           assign
     1261               v-torgconf-self-host-code = v-host-code
     1262           .
     1263       end.
     1264       if v-torgconf-self-host-code = 0
     1265       then do:
     1266           assign
     1267               v-torgconf-self-host-name           = "":U
     1268               v-torgconf-self-host-addres         = "":U
     1269               v-torgconf-self-host-post-addres    = "":U
     1270               v-torgconf-self-host-phone          = "":U
     1271               v-torgconf-self-host-inn            = "":U
     1272               v-torgconf-self-host-kpp            = "":U
     1273               v-torgconf-self-host-okpo           = "":U
     1274               v-torgconf-self-host-egrip-date     = "":U
     1275               v-torgconf-self-host-egrip-num      = "":U
     1276           .
     1277       end.
     1278       else do:
     1279           run fmtcli-get-client in this-procedure (
     1280                 input 'орг':U
     1281               , input v-torgconf-self-host-code
     1282           ).
     1283           assign
     1284               v-torgconf-self-host-name        = v-fmtcli-name
     1285               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1286               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1287               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1288               v-torgconf-self-host-phone       = v-fmtcli-phone
     1289               v-torgconf-self-host-inn         = v-fmtcli-inn
     1290               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1291               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1292           .
     1293           run gbl/clntat-v.p (
     1294                 input 'орг':U
     1295               , input v-torgconf-self-host-code
     1296               , input 'egrip-date':U
     1297               , output v-torgconf-self-host-egrip-date
     1298               , output v-par-type
     1299           ).
     1300           run gbl/clntat-v.p (
     1301                 input 'орг':U
     1302               , input v-torgconf-self-host-code
     1303               , input 'egrip-num':U
     1304               , output v-torgconf-self-host-egrip-num
     1305               , output v-par-type
     1306           ).
     1307           run fmtcli-get-bank in this-procedure (
     1308                 input v-host-code
     1309               , input 'орг':U
     1310               , input v-torgconf-self-host-code
     1311               , input p-curr-code
     1312           ).
     1313       end.
     1314       assign
     1315           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1316           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1317           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1318           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1319           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1320           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1321           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1322           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1323       .
     1324       assign
     1325           v-torgconf-self-obj-type = p-obj-type
     1326           v-torgconf-self-obj-code = p-obj-code
     1327       .
     1328       run fmtcli-get-client in this-procedure (
     1329             input p-obj-type
     1330           , input p-obj-code
     1331       ).
     1332       assign
     1333           v-torgconf-self-obj-name       = v-fmtcli-name
     1334           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1335           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1336           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1337           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1338           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1339           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1340       .
     1341   end.
     1342   end procedure.
     1343   procedure torgconf-get-recepient-param :
     1344   define input parameter torgconfdoc-code   as character                  no-undo.
     1345   define output parameter v-code-rec        as integer                    no-undo .
     1346   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1347   define output parameter v-codefirm-rec    as integer                    no-undo .
     1348   define output parameter v-curcode-rec     as integer                    no-undo .
     1349        define variable  v-recipient-code  as character                  no-undo .
     1350        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1351        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1352   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1353                           input 'Recipient':U ,
     1354                          output v-recipient-code ,
     1355                          output v-trdcattr-type ) no-error .
     1356       if error-status :error then do:
     1357        message
     1358         vss-workfile vss-revision vss-description skip
     1359         "Ошибка при вызове процедуры tdat-val":U skip
     1360         "Документ: " torgconfdoc-code skip
     1361         "Атрибут: " 'Recipient':U skip
     1362         "Значение: " v-recipient skip
     1363         trim( error-status :get-message (1) ) skip
     1364         return-value skip
     1365         view-as alert-box error.
     1366       undo, return error return-value.
     1367       end.
     1368     assign
     1369       v-recipient  = v-recipient-code
     1370       v-type-rec = substring(v-recipient-code,1,3)
     1371       v-code-rec  = int(substring(v-recipient-code,4,15))
     1372       no-error
     1373     .
     1374     if v-type-rec = ? then v-type-rec = "" .
     1375     if v-code-rec  = ? then v-code-rec  =  0 .
     1376     end procedure.
     1377   procedure torgconf-get-wthrecepient-param :
     1378   define input parameter torgconfdoc-code   as character                  no-undo.
     1379   define output parameter v-code-rec        as integer                    no-undo .
     1380   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1381   define output parameter v-codefirm-rec    as integer                    no-undo .
     1382   define output parameter v-curcode-rec     as integer                    no-undo .
     1383        define variable  v-recipient-code  as character                  no-undo .
     1384        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1385        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1386   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input torgconfdoc-code ,
     1387                           input 'wthconsignee':U ,
     1388                          output v-recipient-code ,
     1389                          output v-trdcattr-type ) no-error .
     1390       if error-status :error then do:
     1391        message
     1392         vss-workfile vss-revision vss-description skip
     1393         "Ошибка при вызове процедуры tdat-val":U skip
     1394         "Документ: " torgconfdoc-code skip
     1395         "Атрибут: " 'wthconsignee':U skip
     1396         "Значение: " v-recipient skip
     1397         trim( error-status :get-message (1) ) skip
     1398         return-value skip
     1399         view-as alert-box error.
     1400       undo, return error return-value.
     1401       end.
     1402     assign
     1403       v-recipient  = v-recipient-code
     1404       v-type-rec = substring(v-recipient-code,1,3)
     1405       v-code-rec  = int(substring(v-recipient-code,4,15))
     1406       no-error
