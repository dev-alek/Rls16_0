     3863   define dataset meat-semi-finished-ds for meat-semi-finished.
     3864   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3865   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3866   procedure meatsemi_fill-msf :
     3867   define input parameter p-mode as character no-undo .
     3868   define parameter buffer buf_clob-bind for ub.clob-bind.
     3869   define buffer buf_clob-data for ub.clob-data.
     3870   define variable v-longchar as longchar no-undo .
     3871   define variable glog as logical no-undo .
     3872   case p-mode:
     3873     when  'ИЗМЕНЕНИЕ':U then do:
     3874      find first buf_clob-bind exclusive-lock where
     3875               buf_clob-bind.resource-type = 'ref':U
     3876          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
     3877          and buf_clob-bind.field-name = "" no-error.
     3878     end.
     3879     otherwise do:
     3880       find first buf_clob-bind no-lock where
     3881               buf_clob-bind.resource-type = 'ref':U
     3882          and buf_clob-bind.uniq-key-rec = "meat-semi-finished.xml"
     3883          and buf_clob-bind.field-name = "" no-error.
     3884     end.
     3885   end case.
     3886   if available buf_clob-bind then do:
     3887     find first buf_clob-data no-lock where
     3888               buf_clob-data.db-num = buf_clob-bind.db-num
     3889           and buf_clob-data.int64-id = buf_clob-bind.int64-id no-error.
     3890     if available buf_clob-data then do:
     3891       v-longchar = buf_clob-data.cdata.
     3892       glog = DATASET meat-semi-finished-ds:HANDLE:read-XML("LONGCHAR"
     3893                                                   , v-longchar
     3894                                                   , "EMPTY"
     3895                                                   , ?
     3896                                                   , ?
     3897                                                   , ?
     3898                                                   , "loose"   )  no-error .
     3899       if error-status:error
     3900       or not glog then do:
     3901         MESSAGE
     3902         "НЕ удается прочитать из БД классификатор" skip
     3903         ERROR-STATUS:GET-MESSAGE(1) SKIP
     3904         RETURN-VALUE
     3905         VIEW-AS ALERT-BOX ERROR.
     3906         UNDO, RETURN ERROR.
     3907       end.
     3908     end.
     3909   end.
     3910   end procedure.
     3911   def var vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3912   procedure gen-key-rec :
     3913     define input  parameter p-tbl-name    as character no-undo.
     3914     define input  parameter p-bh_tbl-name as handle    no-undo.
     3915     define output parameter p-key-rec     as character no-undo.
     3916     do
     3917     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3918     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     3919     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     3920     :
     3921       define variable fh               as handle    no-undo .
     3922       define variable v-ok             as logical   no-undo .
     3923       define variable v-inform         as character no-undo .
     3924       define variable v-ind            as integer   no-undo .
     3925       define variable v-idx-field-qnty as integer   no-undo .
     3926       if p-tbl-name = ?
     3927         or p-tbl-name = "":U
     3928       then do:
     3929         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info20 ).
     3930       end.
     3931       if not p-bh_tbl-name:available then do:
     3932         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info20, p-tbl-name ).
     3933       end.
     3934       assign
     3935         p-key-rec = p-tbl-name
     3936         v-inform  = p-bh_tbl-name:index-information(1)
     3937         v-ind     = 2
     3938       .
     3939       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     3940       on error undo, return error
     3941       :
     3942         assign
     3943           v-inform = p-bh_tbl-name:index-information( v-ind )
     3944           v-ind    = v-ind + 1
     3945         .
     3946       end.
     3947       if v-inform = ?
     3948         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     3949         or entry( 3, v-inform, ",":U ) <> "1":U
     3950       then do:
     3951         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, p-tbl-name ).
     3952       end.
     3953       else do:
     3954         assign
     3955           v-idx-field-qnty = num-entries( v-inform ) - 4
     3956         .
     3957         if v-idx-field-qnty < 2 then do:
     3958           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, p-tbl-name ).
     3959         end.
     3960         do v-ind = 1 to v-idx-field-qnty by 2
     3961         on error undo, return error
     3962         :
     3963           assign
     3964             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     3965             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     3966           .
     3967         end.
     3968       end.
     3969       if p-key-rec = ? then do:
     3970         assign
     3971           p-key-rec = "":U
     3972         .
     3973         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info20, p-tbl-name ).
     3974       end.
     3975     end.
     3976     return.
     3977   end procedure.
     3978   procedure gen-where-keyr-tab :
     3979     define input  parameter i-tableSerach as character no-undo.
     3980     define input  parameter i-tablekey   as character  no-undo.
     3981     define input  parameter p-key-rec    as character  no-undo.
     3982     define input  parameter p-key-handle as handle     no-undo .
     3983     define input  parameter p-db-name    as character  no-undo .
     3984     define input  parameter p-tt-handle  as handle     no-undo .
     3985     define output parameter o-Where      as character  no-undo.
     3986     do
     3987     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     3988     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     3989     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     3990     :
     3991       define variable v-full-tbl-name  as character no-undo .
     3992       define variable bh_tbl-name      as handle    no-undo .
     3993       define variable fh_key           as handle    no-undo .
     3994       define variable fh_search        as handle    no-undo .
     3995       define variable v-field-num      as integer   no-undo .
     3996       define variable v-count-fld      as integer   no-undo .
     3997       define variable v-inform         as character no-undo .
     3998       define variable v-ind            as integer   no-undo .
     3999       define variable v-idx-field-qnty as integer   no-undo .
     4000       define variable v-field-name     as character no-undo .
     4001       define variable v-field-val      as character no-undo .
     4002       define variable v-word-link      as character no-undo .
     4003       define variable vTable           as character no-undo.
     4004       define variable bh_tbl-key       as handle    no-undo .
     4005       assign
     4006         p-key-rec = trim( p-key-rec )
     4007       .
     4008       if p-key-handle <> ? then do:
     4009         if not valid-handle(p-key-handle)
     4010            or p-key-handle:type <> "buffer"
     4011         then do:
     4012           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info20 ).
     4013         end.
     4014         if num-entries( p-key-rec, chr(3) ) > 1
     4015           or p-key-rec = ?
     4016           or p-key-rec = "":U
     4017         then do:
     4018           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info20, p-key-rec ).
     4019         end.
     4020       end.
     4021       else do:
     4022         if p-key-rec = ?
     4023           or p-key-rec = "":U
     4024         then do:
     4025           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     4026         end.
     4027       end.
     4028       assign
     4029         vTable = entry( 1 , p-key-rec, chr(3) )
     4030       .
     4031       if p-tt-handle <> ?
     4032         and ( not valid-handle(p-tt-handle)
     4033               or p-tt-handle:type <> "buffer"
     4034             )
     4035       then do:
     4036         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info20, vTable, chr(10) ).
     4037       end.
     4038       if p-tt-handle = ? then do:
     4039         assign
     4040           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     4041         .
     4042         create buffer bh_tbl-name for table v-full-tbl-name .
     4043       end.
     4044       else do:
     4045         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4046       end.
     4047       assign
     4048         v-inform = bh_tbl-name:index-information(1)
     4049         v-ind    = 2
     4050       .
     4051       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4052       on error undo, return error
     4053       :
     4054         assign
     4055           v-inform = bh_tbl-name:index-information( v-ind )
     4056           v-ind    = v-ind + 1
     4057         .
     4058       end.
     4059       if v-inform = ?
     4060         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4061         or entry( 3, v-inform, ",":U ) <> "1":U
     4062       then do:
     4063         delete object bh_tbl-name no-error.
     4064         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info20, vTable ).
     4065       end.
     4066       assign
     4067         v-idx-field-qnty = num-entries( v-inform ) - 4
     4068       .
     4069       if v-idx-field-qnty < 2 then do:
     4070         delete object bh_tbl-name no-error.
     4071         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, vTable ).
     4072       end.
     4073       assign
     4074         o-where     = "where":U
     4075         v-word-link = "":U
     4076         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     4077         v-count-fld = 0
     4078       .
     4079       if i-tablekey ne "" and i-tablekey ne ?
     4080       then do:
     4081         assign
     4082           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     4083         .
     4084         create buffer bh_tbl-key for table v-full-tbl-name .
     4085       end.
     4086       if i-tableSerach ne "" and i-tableSerach ne ?
     4087       then do:
     4088         delete object bh_tbl-name no-error.
     4089         assign
     4090           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     4091         .
     4092         create buffer bh_tbl-name for table v-full-tbl-name .
     4093       end.
     4094       block_where:
     4095       do v-ind = 1 to v-idx-field-qnty by 2
     4096       on error undo, return error
     4097       :
     4098         assign
     4099           v-count-fld = v-count-fld + 1
     4100         .
     4101         if p-key-handle = ?
     4102           and v-count-fld > v-field-num
     4103         then do:
     4104           leave block_where.
     4105         end.
     4106         define variable VfieldKeyTable as handle no-undo.
     4107         assign
     4108           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     4109           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     4110         .
     4111         if     bh_tbl-key ne ?
     4112         then do:
     4113            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     4114            if VfieldKeyTable eq ?
     4115            then next block_where.
     4116         end.
     4117         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     4118         then
     4119            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     4120         else
     4121            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     4122         if p-key-handle = ? then do:
     4123           assign
     4124             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     4125           .
     4126         end.
     4127         else do:
     4128           assign
     4129             fh_key = p-key-handle:buffer-field( v-field-name )
     4130           .
     4131           if fh_key = ?
     4132             or not valid-handle( fh_key )
     4133           then do:
     4134             delete object bh_tbl-name.
     4135             if     bh_tbl-key ne ?
     4136             then
     4137                delete object bh_tbl-key.
     4138             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info20, p-key-handle:name, v-field-name ).
     4139           end.
     4140           assign
     4141             v-field-val = fh_key:buffer-value
     4142           .
     4143         end.
     4144         if fh_search:data-type ="character":U then do:
     4145           assign
     4146             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     4147             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     4148             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     4149             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     4150             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     4151             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     4152             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     4153             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     4154             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     4155             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     4156             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     4157             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     4158             v-field-val = substitute( '"&1"', v-field-val )
     4159           .
     4160         end.
     4161         assign
     4162           o-where = substitute( "&1 &2", o-where, v-field-val )
     4163         .
     4164         if v-word-link = "":U then do:
     4165           assign
     4166             v-word-link = "and":U
     4167           .
     4168         end.
     4169       end.
     4170       delete object bh_tbl-name.
     4171       if     bh_tbl-key ne ?
     4172       then
     4173          delete object bh_tbl-key.
     4174       if p-key-handle = ?
     4175         and v-count-fld <> v-field-num
     4176       then do:
     4177         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info20, vTable ).
     4178       end.
     4179     end.
     4180   end procedure.
     4181   procedure gen-hn-keyr-tab :
     4182     define input  parameter i-tableSerach as character no-undo.
     4183     define input  parameter i-tablekey   as character no-undo.
     4184     define input  parameter p-key-rec    as character no-undo.
     4185     define input  parameter p-key-handle as handle    no-undo .
     4186     define input  parameter p-db-name    as character no-undo .
     4187     define input  parameter p-tt-handle  as handle    no-undo .
     4188     define input  parameter p-stts-lock  as integer   no-undo .
     4189     define output parameter o-hn         as handle    no-undo.
     4190     define variable v-full-tbl-name as character no-undo.
     4191     define variable v-where         as character no-undo.
     4192     define variable bh_tbl-name     as handle    no-undo.
     4193     define variable vTable          as character no-undo.
     4194     do
     4195     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4196     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     4197     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     4198         run gen-where-keyr-tab(i-tableSerach,
     4199                                i-tablekey,
     4200                                p-key-rec,
     4201                                p-key-handle,
     4202                                p-db-name,
     4203                                p-tt-handle,
     4204                                output v-where).
     4205         if i-tableSerach ne "" and i-tableSerach ne ?
     4206         then do:
     4207            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     4208            create buffer bh_tbl-name for table v-full-tbl-name .
     4209         end.
     4210         else do:
     4211            if p-tt-handle = ? then do:
     4212               assign
     4213                  vTable = entry( 1 , p-key-rec, chr(3) )
     4214               .
     4215               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     4216               create buffer bh_tbl-name for table v-full-tbl-name .
     4217            end.
     4218            else do:
     4219               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     4220            end.
     4221         end.
     4222         if p-tt-handle = ? then do:
     4223            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     4224         end.
     4225         else do:
     4226            bh_tbl-name:find-first( v-where ) no-error .
     4227         end.
     4228         o-hn = bh_tbl-name.
     4229      end.
     4230   end procedure.
     4231   procedure gen-hn-keyr :
     4232     define input  parameter p-key-rec    as character no-undo.
     4233     define input  parameter p-key-handle as handle    no-undo .
     4234     define input  parameter p-db-name    as character no-undo .
     4235     define input  parameter p-tt-handle  as handle    no-undo .
     4236     define input  parameter p-stts-lock  as integer   no-undo .
     4237     define output parameter o-hn         as handle    no-undo.
     4238     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     4239   end.
     4240   procedure gen-row-keyr :
     4241     define input  parameter p-key-rec    as character no-undo.
     4242     define input  parameter p-key-handle as handle    no-undo .
     4243     define input  parameter p-db-name    as character no-undo .
     4244     define input  parameter p-tt-handle  as handle    no-undo .
     4245     define input  parameter p-stts-lock  as integer   no-undo .
     4246     define output parameter p-tbl-row    as rowid     no-undo.
     4247     define output parameter p-tbl-name   as character no-undo.
     4248     define variable vHn as handle no-undo.
     4249       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     4250       p-tbl-row = if vHn:available then vHn:rowid else ?.
     4251       p-tbl-name =  vHn:table.
     4252       delete object vHn no-error.
     4253     if p-tbl-row = ? then do:
     4254       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info20, p-tbl-name, p-key-rec ).
     4255     end.
     4256     else do:
     4257       return.
     4258     end.
     4259   end procedure.
     4260   procedure gen-key-fv :
     4261     define input  parameter p-key-rec    as character no-undo .
     4262     define output parameter p-field-list as character no-undo .
     4263     define output parameter p-value-list as character no-undo.
     4264     do
     4265     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4266     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4267     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4268     :
     4269       define variable v-full-tbl-name  as character no-undo .
     4270       define variable bh_tbl-name      as handle    no-undo .
     4271       define variable v-tbl-name       as character no-undo .
     4272       define variable v-field-num      as integer   no-undo .
     4273       define variable v-count-fld      as integer   no-undo .
     4274       define variable v-inform         as character no-undo .
     4275       define variable v-ind            as integer   no-undo .
     4276       define variable v-idx-field-qnty as integer   no-undo .
     4277       define variable v-delim-key      as character no-undo .
     4278       if p-key-rec = ?
     4279         or p-key-rec = "":U
     4280       then do:
     4281         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info20 ).
     4282       end.
     4283       assign
     4284         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     4285         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4286       .
     4287       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4288       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info20 ).
     4289       assign
     4290         v-inform = bh_tbl-name:index-information(1)
     4291         v-ind    = 2
     4292       .
     4293       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4294       on error undo, return error
     4295       :
     4296         assign
     4297           v-inform = bh_tbl-name:index-information( v-ind )
     4298           v-ind    = v-ind + 1
     4299         .
     4300       end.
     4301       if v-inform = ?
     4302         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4303         or entry( 3, v-inform, ",":U ) <> "1":U
     4304       then do:
     4305         delete object bh_tbl-name no-error.
     4306         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     4307       end.
     4308       assign
     4309         v-idx-field-qnty = num-entries( v-inform ) - 4
     4310       .
     4311       if v-idx-field-qnty < 2 then do:
     4312         delete object bh_tbl-name no-error.
     4313         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     4314       end.
     4315       assign
     4316         p-field-list = "":U
     4317         p-value-list = "":U
     4318         v-delim-key  = "":U
     4319         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     4320         v-count-fld  = 0
     4321       .
     4322       block_where:
     4323       do v-ind = 1 to v-idx-field-qnty by 2
     4324       on error undo, return error
     4325       :
     4326         assign
     4327           v-count-fld = v-count-fld + 1
     4328         .
     4329         if v-count-fld > v-field-num then do:
     4330           leave block_where.
     4331         end.
     4332         assign
     4333           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     4334           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     4335         .
     4336         if v-ind = 1 then do:
     4337           assign
     4338             v-delim-key = chr(3)
     4339           .
     4340         end.
     4341       end.
     4342       delete object bh_tbl-name.
     4343       if v-count-fld <> v-field-num then do:
     4344         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info20, v-tbl-name ).
     4345       end.
     4346     end.
     4347   end procedure.
     4348   procedure gen-key-field :
     4349     define input  parameter p-table      as character no-undo .
     4350     define output parameter p-field-list as character no-undo .
     4351     do
     4352     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4353     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     4354     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     4355     :
     4356       define variable v-full-tbl-name  as character no-undo .
     4357       define variable bh_tbl-name      as handle    no-undo .
     4358       define variable v-tbl-name       as character no-undo .
     4359       define variable v-field-num      as integer   no-undo .
     4360       define variable v-count-fld      as integer   no-undo .
     4361       define variable v-inform         as character no-undo .
     4362       define variable v-ind            as integer   no-undo .
     4363       define variable v-idx-field-qnty as integer   no-undo .
     4364       define variable v-delim-key      as character no-undo .
     4365       if p-table = ?
     4366         or p-table = "":U
     4367       then do:
     4368         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info20 ).
     4369       end.
     4370       assign
     4371         v-tbl-name      = p-table
     4372         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     4373       .
     4374       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     4375       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info20 ).
     4376       assign
     4377         v-inform = bh_tbl-name:index-information(1)
     4378         v-ind    = 2
     4379       .
     4380       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     4381       on error undo, return error
     4382       :
     4383         assign
     4384           v-inform = bh_tbl-name:index-information( v-ind )
     4385           v-ind    = v-ind + 1
     4386         .
     4387       end.
     4388       if v-inform = ?
     4389         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     4390         or entry( 3, v-inform, ",":U ) <> "1":U
     4391       then do:
     4392         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info20, v-tbl-name ).
     4393       end.
     4394       assign
     4395         v-idx-field-qnty = num-entries( v-inform ) - 4
     4396       .
     4397       if v-idx-field-qnty < 2 then do:
     4398         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info20, v-inform, v-tbl-name ).
     4399       end.
     4400       assign
     4401         p-field-list = "":U
     4402         v-delim-key  = "":U
     4403         v-count-fld  = 0
     4404       .
     4405       block_where:
     4406       do v-ind = 1 to v-idx-field-qnty by 2
     4407       on error undo, return error
     4408       :
     4409         assign
     4410           v-count-fld = v-count-fld + 1
     4411         .
     4412         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     4413         if v-ind = 1 then do:
     4414           assign
     4415             v-delim-key = chr(3)
     4416           .
     4417         end.
     4418       end.
     4419       delete object bh_tbl-name.
     4420     end.
     4421   end procedure.
     4422   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
     4423   FUNCTION Break-n-line RETURNS CHARACTER
     4424     ( INPUT p-ost as char,
     4425       INPUT p-lengths  as character,
     4426       OUTPUT output-num-lines as integer
     4427       ) :
     4428   define variable ii as integer no-undo.
     4429   define variable jj as integer no-undo.
     4430   define variable linei as character no-undo extent 10.
     4431   define variable line-length as integer no-undo extent 10.
     4432   define variable num-line as integer no-undo .
     4433   define variable v-line as character no-undo .
     4434   do ii = 1 to MIN(num-entries(p-lengths), 10):
     4435     assign
     4436     line-length[ii] = integer(entry(ii, p-lengths))
     4437     num-line = ii
     4438     .
     4439   end.
     4440   do jj = 1 to num-line:
     4441     if Length ( p-ost ) <= line-length[jj] then do:
     4442       assign
     4443       output-num-lines = jj
     4444       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
     4445       .
     4446       return v-line.
     4447     end.
     4448     assign
     4449     ii = 1
     4450     .
     4451     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
     4452     then do:
     4453       assign
     4454       linei[jj] = substr( p-ost , 1 , line-length[jj] )
     4455       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
     4456       .
     4457     end.
     4458     else do:
     4459       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
     4460         assign
     4461         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
     4462         ii = ii + 1
     4463         .
     4464         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
     4465         assign
     4466         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
     4467         .
     4468       END.
     4469       assign
     4470       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
     4471       .
     4472     end.
     4473     assign
     4474     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
     4475     .
     4476     if p-ost = "":U then LEAVE.
     4477   end.
     4478   assign
     4479   output-num-lines = jj.
     4480   RETURN v-line.
     4481   END FUNCTION.
     4482   FUNCTION Center-Field RETURNS CHARACTER
     4483     ( INPUT p-str as char,
     4484       INPUT p-format as integer,
     4485       INPUT p-Length as integer,
     4486       INPUT p-fill as character
     4487       ) :
     4488   define variable v-str as character no-undo .
     4489   define variable v-left as integer no-undo .
     4490   define variable v-dop as integer no-undo .
     4491   assign
     4492   p-str = trim(p-str)
     4493   .
     4494   if p-str = "":U then return fill(p-fill, p-length).
     4495   if length(p-str) >= p-format then
     4496   p-str = substr(p-str, 1, p-format).
     4497   else do:
     4498     p-format = length(p-str).
     4499   end.
     4500   if p-format < p-length then do:
     4501     assign
     4502     v-left = (p-length - p-format )
     4503     v-dop = (if v-left modulo 2 = 1
     4504              then 1
     4505              else 0)
     4506     v-left = (if (v-left modulo 2 = 1)
     4507              then (v-left - 1 ) / 2
     4508              else v-left / 2)
     4509     v-str =  fill(p-fill, v-left) +
     4510              string(p-str, "X(":U + string(p-format) + ")":U) +
     4511              fill(p-fill, v-left) + fill(p-fill, v-dop)
     4512     .
     4513     return v-str.
     4514   end.
     4515   else do:
     4516     return string(p-str, "X(":U + string(p-length) + ")":U).
     4517   end.
     4518   END FUNCTION.
     4519   FUNCTION Left-Field RETURNS CHARACTER
     4520     ( INPUT p-str as char,
     4521       INPUT p-format as integer,
     4522       INPUT p-Length as integer,
     4523       INPUT p-fill as character
     4524       ) :
     4525   define variable v-str as character no-undo .
     4526   define variable v-left as integer no-undo .
     4527   define variable v-dop as integer no-undo .
     4528   assign
     4529   p-str = trim(p-str)
     4530   .
     4531   if p-str = "":U then return fill(p-fill, p-length).
     4532   if length(p-str) >= p-format then
     4533   p-str = substr(p-str, 1, p-format).
     4534   else do:
     4535     p-format = length(p-str).
     4536   end.
     4537   if p-format < p-length then do:
     4538     assign
     4539     v-dop =  p-length - p-format
     4540     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
     4541              fill(p-fill, v-dop)
     4542     .
     4543     return v-str.
     4544   end.
     4545   else do:
     4546     return string(p-str, "X(":U + string(p-length) + ")":U).
     4547   end.
     4548   END FUNCTION.
     4549   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
     4550     ( INPUT p-sum as decimal,
     4551       INPUT p-rub-length as integer,
     4552       INPUT p-kop-length as integer,
     4553       INPUT p-fill as character,
     4554       INPUT p-razr-delim as character,
     4555       INPUT p-rub-str  as character,
     4556       INPUT p-kop-str  as character
     4557       ) :
     4558   define variable v-str as character no-undo .
     4559   define variable v-format as character no-undo .
     4560   define variable v-dopi as integer no-undo .
     4561   define variable v-dopi2 as integer no-undo .
     4562   assign
     4563   v-dopi = length(string(truncate(ABS(p-sum), 0)))
     4564   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
     4565   .
     4566   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
     4567   assign
     4568   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
     4569   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
     4570   .
     4571   assign
     4572   v-str = fill(p-fill, p-rub-length - v-dopi) +
     4573           string(truncate(p-sum, 0), v-format) +
     4574           p-rub-str +
     4575           fill(p-fill, p-kop-length - 2) +
     4576           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
     4577   .
     4578   return v-str.
     4579   END FUNCTION.
     4580   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
     4581     ( INPUT p-sum as decimal,
     4582       INPUT p-sum-length as integer,
     4583       INPUT p-curr-code as integer,
     4584       INPUT p-fill as character,
     4585       INPUT p-razr-delim as character
     4586       ) :
     4587   define variable v-str as character no-undo .
     4588   define variable v-format as character no-undo .
     4589   define variable v-dopi as integer no-undo .
     4590   define variable v-dopi2 as integer no-undo .
     4591   define variable v-curr-name as character no-undo .
     4592   define buffer buf_currency for ub.currency.
     4593   find first buf_currency no-lock where
     4594             buf_currency.curr-code = p-curr-code no-error .
     4595   if not avail buf_currency
     4596   then v-curr-name = "неизвестная валюта".
     4597   else
     4598   assign
     4599   v-curr-name = buf_currency.curr-name
     4600   .
     4601   assign
     4602   v-dopi = length(string(truncate(ABS(p-sum), 0)))
     4603   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
     4604   .
     4605   if v-dopi > p-sum-length then return "?".
     4606   assign
     4607   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
     4608   v-dopi = length(trim(string(p-sum, v-format)))
     4609   .
     4610   assign
     4611   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
     4612           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
     4613           trim(string(p-sum, v-format))
     4614   .
     4615   return v-str.
     4616   END FUNCTION.
     4617   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
     4618   (input v-sum as decimal
     4619   ):
     4620   define variable v-str as character no-undo .
     4621   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
     4622   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
     4623   return v-str.
     4624   END FUNCTION.
     4625   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
     4626   (input p-sum as decimal
     4627    ,input p-curr-code as integer
     4628   ):
     4629   define variable v-str as character no-undo .
     4630   define variable Copeck as character no-undo.
     4631   define variable Rouble as character no-undo.
     4632   define variable v-Word as character no-undo.
     4633   define variable ii as integer init 18 no-undo.
     4634   define variable v-str-rubl as character no-undo .
     4635   define variable v-kop as integer no-undo .
     4636   define buffer buf_currency for ub.currency.
     4637   assign
     4638   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
     4639   find first buf_currency no-lock where
     4640             buf_currency.curr-code = p-curr-code no-error .
     4641   if not available buf_currency then return chr(63).
     4642   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
     4643     CASE substring(v-Word, ii - 3,1):
     4644       WHEN "1" THEN DO:
     4645         if substring(v-Word, ii - 4,1) = "1" then
     4646             Rouble = buf_currency.curr-name-five .
     4647         else
     4648             Rouble = buf_currency.curr-name-one .
     4649       END.
     4650       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
     4651         if substring(v-Word, ii - 4,1) = "1" then
     4652            Rouble = buf_currency.curr-name-five .
     4653            else
     4654            Rouble = buf_currency.curr-name-three .
     4655         END.
     4656       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
     4657          Rouble = buf_currency.curr-name-five .
     4658       END.
     4659     END CASE.
     4660   end.
     4661   CASE substring(v-Word, ii, 1):
     4662     WHEN "1" THEN DO:
     4663       if substring(v-Word, ii - 1, 1) = "1" then
     4664           Copeck = buf_currency.part-name-five .
     4665       else
     4666           Copeck = buf_currency.part-name-one .
     4667     END.
     4668     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
     4669       if substring(v-Word, ii - 1, 1) = "1" then
     4670           Copeck = buf_currency.part-name-five .
     4671       else
     4672           Copeck = buf_currency.part-name-three .
     4673     END.
     4674     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
     4675       Copeck = buf_currency.part-name-five .
     4676     END.
     4677   END CASE.
     4678   run gbl/num-rus.p ( input absolute( p-sum )
     4679                , output v-str-rubl).
     4680   assign
     4681   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
     4682           ) * 100
     4683   .
     4684   v-str = ( if p-Sum < 0 then "- " else "" ) +
     4685               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
     4686               string(v-kop, "99":U) + chr(32) + Copeck .
     4687   return v-str.
     4688   END FUNCTION.
     4689   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
     4690   (input v-sum as decimal,
     4691   input v-razr as integer
     4692   ):
     4693   define variable v-str as character no-undo .
     4694   define variable v-dec-separ as character no-undo .
     4695   case SESSION:NUMERIC-FORMAT:
     4696     when "American":U then do:
     4697       assign
     4698       v-dec-separ = ".":U
     4699       .
     4700     end.
     4701     when "European":U then do:
     4702       assign
     4703       v-dec-separ = ",":U
     4704       .
     4705     end.
     4706   END CASE.
     4707   assign
     4708   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
     4709   .
     4710   return v-str.
     4711   END FUNCTION.
     4712   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4713     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4714     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4715     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4716   END FUNCTION.
     4717   PROCEDURE get-month-name-gen :
     4718     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4719     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4720     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     4721     DO ON ERROR UNDO, RETURN ERROR :
     4722       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4723     END.
     4724   END PROCEDURE.
     4725   do
     4726   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     4727   on stop   undo, return error substitute( "&1. stop", vss-workfile )
     4728   on endkey undo, return error substitute( "&1. endkey", vss-workfile )
     4729   :
     4730   define stream out-stream .
