     3589         no-error.
     3590         if v-torgconf-outogr = "no_print"
     3591            then do:
     3592               assign
     3593                  v-torgconf-ogr-name = ""
     3594                  v-torgconf-ogr-post = ""
     3595               .
     3596            end.
     3597         if v-torgconf-outogr  = "ruk_firm"
     3598               then do:
     3599               find first buf_sysconf no-lock
     3600               where buf_sysconf.host-code = p-host-code
     3601               no-error.
     3602               if available buf_sysconf
     3603               then do:
     3604                  assign
     3605                     v-torgconf-ogr-post = buf_sysconf.head-position
     3606                  .
     3607               end.
     3608               find first buf_clients no-lock
     3609                  where buf_clients.obj-type = 'орг':U
     3610                  and buf_clients.obj-code = p-host-code
     3611               .
     3612               find first buf_firm no-lock
     3613                  where buf_firm.firm-code = buf_clients.obj-code
     3614               .
     3615               assign
     3616                  v-torgconf-ogr-name = buf_firm.director
     3617               .
     3618            end.
     3619            if v-torgconf-outogr = "dir_obj"
     3620               then do:
     3621               find first buf_wth-doc no-lock
     3622               where buf_wth-doc.doc-code = p-doc-code
     3623               no-error.
     3624                  find first buf_shop no-lock
     3625                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3626                  .
     3627                  assign
     3628                     v-torgconf-ogr-name = buf_shop.director
     3629                     v-torgconf-ogr-post = "Директор"
     3630                  .
     3631               end.
     3632         if v-torgconf-outogr = "manag_doc"
     3633            then do:
     3634               find first buf_wth-doc no-lock
     3635               where buf_wth-doc.doc-code = p-doc-code
     3636               no-error.
     3637               if available buf_wth-doc
     3638               then do:
     3639                  run rep/get-psn.p
     3640                  (input buf_wth-doc.deliver
     3641                  ,output v-torgconf-ogr-name
     3642                  ) .
     3643               end.
     3644               find first buf_person no-lock
     3645               where buf_person.psn-code = buf_wth-doc.deliver
     3646               no-error.
     3647               if available buf_person
     3648               then do:
     3649                  v-torgconf-ogr-post = buf_person.position.
     3650               end.
     3651               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3652               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3653            end.
     3654      end.
     3655   end.
     3656   procedure torgconf-get-reason  :
     3657   define input parameter  p-doc-code       as character        no-undo.
     3658   define input parameter  p-reason-code    as integer          no-undo .
     3659   define input parameter  p-doc-type       as character        no-undo.
     3660       if p-reason-code > 0
     3661       then do:
     3662           define buffer buf_trn-reason for ub.trn-reason.
     3663           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3664           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3665       end.
     3666       else do:
     3667           if p-doc-type = 'при':U
     3668           then  do:
     3669               define variable v-attr-type     as character    no-undo.
     3670               define variable v-attr-value    as character    no-undo.
     3671               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3672               assign v-torgconf-reason = v-attr-value .
     3673               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3674               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3675           end.
     3676       end.
     3677   end procedure.
     3678   def var vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3679   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3680   procedure paramls-clear :
     3681     define buffer buf_temp-param for temp-param .
     3682     do
     3683     on error undo, return error return-value
     3684     :
     3685       for each buf_temp-param
     3686       on error undo, return error
     3687       :
     3688         delete buf_temp-param .
     3689       end.
     3690     end.
     3691   end procedure.
     3692   procedure paramls-write :
     3693     define input  parameter p-code     as character no-undo .
     3694     define input  parameter p-sub-code as character no-undo .
     3695     define input  parameter p-value    as character no-undo .
     3696     define buffer buf_temp-param for temp-param .
     3697     do
     3698     on error undo, return error return-value
     3699     :
     3700       find first buf_temp-param
     3701         where buf_temp-param.param-code     = p-code
     3702           and buf_temp-param.param-sub-code = p-sub-code
     3703         no-error .
     3704       if not available buf_temp-param then do:
     3705         create buf_temp-param .
     3706         assign
     3707           buf_temp-param.param-code     = p-code
     3708           buf_temp-param.param-sub-code = p-sub-code
     3709         .
     3710       end.
     3711       assign
     3712         buf_temp-param.param-value = p-value
     3713       .
     3714     end.
     3715   end procedure.
     3716   procedure paramls-read :
     3717     define input  parameter p-code          as character no-undo .
     3718     define input  parameter p-sub-code      as character no-undo .
     3719     define input  parameter p-default-value as character no-undo .
     3720     define output parameter p-value         as character no-undo .
     3721     define buffer buf_temp-param for temp-param .
     3722     do
     3723     on error undo, return error return-value
     3724     :
     3725       find first buf_temp-param
     3726         where buf_temp-param.param-code     = p-code
     3727           and buf_temp-param.param-sub-code = p-sub-code
     3728         no-error .
     3729       if available buf_temp-param then do:
     3730         assign
     3731           p-value = buf_temp-param.param-value
     3732         .
     3733       end.
     3734       else do:
     3735         assign
     3736           p-value = p-default-value
     3737         .
     3738       end.
     3739     end.
     3740   end procedure.
     3741   procedure paramls-append :
     3742     define input  parameter p-code     as character no-undo .
     3743     define input  parameter p-sub-code as character no-undo .
     3744     define input  parameter p-value    as character no-undo .
     3745     define buffer buf_temp-param for temp-param .
     3746     do
     3747     on error undo, return error return-value
     3748     :
     3749       find first buf_temp-param
     3750            where buf_temp-param.param-code     = p-code
     3751              and buf_temp-param.param-sub-code = p-sub-code
     3752         no-error .
     3753       if not available buf_temp-param then do:
     3754         create buf_temp-param .
     3755         assign
     3756           buf_temp-param.param-code     = p-code
     3757           buf_temp-param.param-sub-code = p-sub-code
     3758           buf_temp-param.param-value    = p-value
     3759         .
     3760       end.
     3761       else do:
     3762           assign
     3763               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3764           .
     3765       end.
     3766     end.
     3767   end procedure.
     3768   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3769   function breakstr returns character ( input        for-name    as character,
     3770                                         input        line-length as integer,
     3771                                         input-output line1       as character,
     3772                                         input-output line2       as character ) :
     3773     define variable ii as integer no-undo.
     3774     if length( for-name ) > line-length then do:
     3775       assign ii    = 1
     3776              line1 = "":u
     3777              line2 = "":u.
     3778       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
     3779         assign line1 =       substring( for-name, 1, line-length     )
     3780                line2 = trim( substring( for-name,    line-length + 1 ) ).
     3781       end.                                                     else do:
     3782         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
     3783           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
     3784                  ii    = ii    + 1.
     3785           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
     3786             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
     3787           end.
     3788         end.
     3789         assign line2 = trim( substring( for-name, length( line1 ) ) ).
     3790       end.
     3791     end.                                else do:
     3792       assign line1 = for-name
     3793              line2 = "":u.
     3794     end.
     3795     return ( line1 ).
     3796   end function.
