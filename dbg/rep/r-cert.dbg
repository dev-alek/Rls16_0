        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-trn-doc-recid      as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-cert.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-cert.p $":U .
        9   define variable vss-description as character no-undo init "Качественное удостоверение".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define new global shared variable g#lib-trn  as handle no-undo .
       71   define new global shared variable g#lib-trn2 as handle no-undo .
       72   define new global shared variable g#lib-trn3 as handle no-undo .
       73   define new global shared variable g#lib-trn4 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   procedure cur-time :
       80      define output parameter p-today as date      no-undo .
       81      define output parameter p-time  as integer   no-undo .
       82     do
       83     on error undo, return error
       84     :
       85       define variable v-date1 as date      no-undo .
       86       define variable v-date2 as date      no-undo .
       87       define variable v-time  as integer   no-undo .
       88       assign
       89         v-date1 = today
       90         v-time  = time
       91         v-date2 = today
       92       .
       93       if v-date1 <> v-date2
       94       then do:
       95         assign
       96           v-date1 = today
       97           v-time  = v-time
       98         .
       99       end.
      100       assign
      101         p-today = v-date1
      102         p-time  = v-time
      103       .
      104     end.
      105   end.
      106   function cur-time-date returns character
      107   :
      108     return string(today, '99/99/9999':U) .
      109   end.
      110   function cur-time-mjd returns decimal
      111   :
      112     define variable v-date as date      no-undo .
      113     define variable v-time as integer   no-undo .
      114     run cur-time in this-procedure
      115       (output v-date
      116       ,output v-time
      117       ) .
      118     return integer(v-date) - 2400002 + (v-time / 86400) .
      119   end.
      120   function cur-time-get-ending-index returns integer
      121   (input p-number as integer
      122   )
      123   :
      124     if p-number < 0
      125     or p-number = ?
      126     then do:
      127       return 1 .
      128     end.
      129     define variable v-rest as integer   no-undo .
      130     assign
      131       p-number = p-number modulo 100
      132     .
      133     if p-number < 20
      134     then do:
      135       assign
      136         v-rest = p-number
      137       .
      138     end.
      139     else do:
      140       assign
      141         v-rest = p-number modulo 10
      142       .
      143     end.
      144     case v-rest :
      145       when 1
      146       then do:
      147         return 2 .
      148       end.
      149       when 2 or
      150       when 3 or
      151       when 4
      152       then do:
      153         return 3 .
      154       end.
      155       otherwise do:
      156         return 1 .
      157       end.
      158     end case .
      159   end.
      160   procedure cur-time-mjd-to-date :
      161      define input  parameter i-mjd-diff as decimal no-undo.
      162      define output parameter o-Date     as date    no-undo.
      163      define output parameter o-Time     as integer no-undo.
      164      define variable v-day-number as integer   no-undo .
      165      if    i-mjd-diff < 0
      166         or i-mjd-diff = ?
      167      then do:
      168         return "?" .
      169      end.
      170      assign
      171         v-day-number = truncate(i-mjd-diff,0).
      172         o-Date = date(v-day-number + 2400002).
      173         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      174     .
      175   end.
      176   function cur-time-mjd-to-string returns character
      177   (input p-mjd-diff as decimal
      178   )
      179   :
      180     define variable v-day-number as integer   no-undo .
      181     define variable v-seconds    as integer   no-undo .
      182     define variable v-hour       as integer   no-undo .
      183     define variable v-min        as integer   no-undo .
      184     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      185     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      186     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      187     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      188     if p-mjd-diff < 0
      189     or p-mjd-diff = ?
      190     then do:
      191       return "?" .
      192     end.
      193     assign
      194       v-day-number = integer(truncate(p-mjd-diff,0))
      195       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      196     .
      197     if v-seconds > 86400
      198     then do:
      199       assign
      200         v-seconds = 86400 - 1
      201       .
      202     end.
      203     if v-seconds < 0
      204     then do:
      205       assign
      206         v-seconds = 0
      207       .
      208     end.
      209     assign
      210       v-hour = truncate(v-seconds / 3600, 0)
      211     .
      212     assign
      213       v-seconds = v-seconds modulo 3600
      214     .
      215     assign
      216       v-min = truncate(v-seconds / 60, 0)
      217     .
      218     assign
      219       v-seconds = v-seconds modulo 60
      220     .
      221     return
      222         (if v-day-number <> 0
      223           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      224           else ""
      225         )
      226       + (if v-day-number <> 0 or v-hour <> 0
      227           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      228           else ""
      229         )
      230       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      231           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      232           else ""
      233         )
      234       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      235       .
      236   end.
      237   function cur-time-string returns character
      238   :
      239     define variable v-date as date      no-undo .
      240     define variable v-time as integer   no-undo .
      241     run cur-time in this-procedure
      242       (output v-date
      243       ,output v-time
      244       ) .
      245     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      246   end.
      247   function cur-time-string-sec returns character
      248   :
      249     define variable v-date as date      no-undo .
      250     define variable v-time as integer   no-undo .
      251     run cur-time in this-procedure
      252       (output v-date
      253       ,output v-time
      254       ) .
      255     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      256   end.
      257   function cur-time-custom  returns character
      258   (input p-prefix as character
      259   ,input p-date-format as character
      260   ,input p-delimiter as character
      261   ,input p-time-format as character
      262   ,input p-suffix as character
      263   )
      264   :
      265     define variable v-date as date      no-undo .
      266     define variable v-time as integer   no-undo .
      267     run cur-time in this-procedure
      268       (output v-date
      269       ,output v-time
      270       ) .
      271     return
      272       p-prefix
      273       + string(v-date, p-date-format)
      274       + p-delimiter
      275       + string(v-time, p-time-format)
      276       + p-suffix
      277       .
      278   end.
      279   function cur-time-print  returns character
      280   :
      281     define variable v-date as date      no-undo .
      282     define variable v-time as integer   no-undo .
      283     run cur-time in this-procedure
      284       (output v-date
      285       ,output v-time
      286       ) .
      287     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      288   end.
      289   function cur-time-datetime returns datetime
      290   :
      291     define variable v-char as character no-undo .
      292     define variable v-datetime as datetime no-undo .
      293     v-char = cur-time-string().
      294     v-datetime = datetime(v-char).
      295     return  v-datetime.
      296   end.
      297   function cur-time-string-msec returns character
      298   :
      299     define variable v-date as datetime  no-undo .
      300     v-date = now.
      301     return string(v-date) .
      302   end.
      303   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
      304     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
      305     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
      306     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
      307   END FUNCTION.
      308   PROCEDURE get-centre-string :
      309     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
      310     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
      311     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
      312     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
      313     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
      314     DO ON ERROR UNDO, RETURN ERROR :
      315       ASSIGN p-instring = TRIM(   p-instring )
      316              j-format   = LENGTH( p-instring ).
      317       IF           j-format > p-length THEN DO:
      318         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
      319       END. ELSE IF j-format < p-length THEN DO:
      320         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
      321                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
      322       END.                             ELSE DO:
      323         ASSIGN p-outstring = p-instring.
      324       END.
      325     END.
      326   END PROCEDURE.
      327   define variable vss-include-info2 as character format "X(65)" no-undo
      328   initial "@(#)$Workfile$ $Revision$".
      329   define variable v-fmtcli-name          as character    no-undo.
      330   define variable v-fmtcli-engl-name     as character    no-undo.
      331   define variable v-fmtcli-addres        as character    no-undo.
      332   define variable v-fmtcli-post-addres   as character    no-undo.
      333   define variable v-fmtcli-full-addres   as character    no-undo.
      334   define variable v-fmtcli-phone         as character    no-undo.
      335   define variable v-fmtcli-inn           as character    no-undo.
      336   define variable v-fmtcli-kpp           as character    no-undo.
      337   define variable v-fmtcli-okpo          as character    no-undo.
      338   define variable v-fmtcli-country       as character    no-undo.
      339   define variable v-fmtcli-city          as character    no-undo.
      340   define variable v-fmtcli-index         as character    no-undo.
      341   define variable v-fmtcli-schet-exists  as logical      no-undo.
      342   define variable v-fmtcli-bank-exists   as logical      no-undo.
      343   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      344   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      345   define variable v-fmtcli-bank-bik      as character    no-undo.
      346   define variable v-fmtcli-bank-name     as character    no-undo.
      347   define variable v-fmtcli-bank-addres   as character    no-undo.
      348   define variable v-fmtcli-bank-city     as character    no-undo.
      349   procedure fmtcli-get-bank :
      350   define input parameter p-host-code      as integer          no-undo.
      351   define input parameter p-obj-type       as character        no-undo.
      352   define input parameter p-obj-code       as integer          no-undo.
      353   define input parameter p-curr-code      as integer          no-undo.
      354       define buffer buf_fin-schet     for ub.fin-schet.
      355       define buffer buf_fin-bank      for ub.fin-bank.
      356   do
      357   for buf_fin-schet
      358     , buf_fin-bank
      359   on error undo, return error
      360   :
      361       assign
      362           v-fmtcli-schet-exists       = no
      363           v-fmtcli-bank-exists        = no
      364           v-fmtcli-bank-r-schet       = "":U
      365           v-fmtcli-bank-c-schet       = "":U
      366           v-fmtcli-bank-bik           = "":U
      367           v-fmtcli-bank-name          = "":U
      368           v-fmtcli-bank-addres        = "":U
      369           v-fmtcli-bank-city          = "":U
      370       .
      371       search-for-schet:
      372       for each buf_fin-schet no-lock
      373          where buf_fin-schet.host-code = p-host-code
      374            and buf_fin-schet.cli-type  = p-obj-type
      375            and buf_fin-schet.cli-code  = p-obj-code
      376            and buf_fin-schet.curr-code = p-curr-code
      377       on error undo, return error
      378       :
      379           if buf_fin-schet.status_   = 'удал':U
      380           then do:
      381           end.
      382           else do:
      383               assign
      384                   v-fmtcli-schet-exists   = yes
      385                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      386                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      387               .
      388               find first buf_fin-bank no-lock
      389                    where buf_fin-bank.host-code = p-host-code
      390                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      391               no-error.
      392               if available buf_fin-bank
      393               then do:
      394                   assign
      395                       v-fmtcli-bank-exists      = yes
      396                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      397                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      398                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      399                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      400                   .
      401               end.
      402               else do:
      403                   assign
      404                       v-fmtcli-bank-exists    = no
      405                       v-fmtcli-bank-bik       = "":U
      406                       v-fmtcli-bank-name      = "":U
      407                       v-fmtcli-bank-addres    = "":U
      408                       v-fmtcli-bank-city      = "":U
      409                   .
      410               end.
      411               leave search-for-schet.
      412           end.
      413       end.
      414   end.
      415   end procedure.
      416   procedure fmtcli-get-client :
      417   define input parameter p-obj-type       as character    no-undo.
      418   define input parameter p-obj-code       as integer      no-undo.
      419       define variable v-temp-fmtcli-address      as character     no-undo.
      420       define variable v-num-country-city    as integer      no-undo.
      421       define buffer buf_clients   for ub.clients.
      422       define buffer buf_firm      for ub.firm.
      423       define buffer buf_store     for ub.store.
      424       define buffer buf_shop      for ub.shop.
      425       define buffer buf_person    for ub.person.
      426   do
      427   for buf_clients
      428     , buf_firm
      429     , buf_store
      430     , buf_shop
      431     , buf_person
      432   on error undo, return error
      433   :
      434       assign
      435           v-fmtcli-name           = "":U
      436           v-fmtcli-addres         = "":U
      437           v-fmtcli-post-addres    = "":U
      438           v-fmtcli-full-addres    = "":U
      439           v-fmtcli-phone          = "":U
      440           v-fmtcli-inn            = "":U
      441           v-fmtcli-kpp            = "":U
      442           v-fmtcli-okpo           = "":U
      443           v-fmtcli-city           = "":U
      444           v-fmtcli-index          = "":U
      445           v-fmtcli-country        = "":U
      446       .
      447       find first buf_clients no-lock
      448            where buf_clients.obj-type = p-obj-type
      449              and buf_clients.obj-code = p-obj-code
      450       .
      451       assign
      452           v-fmtcli-name = buf_clients.obj-name
      453       .
      454       case buf_clients.obj-type:
      455          when 'орг':U
      456          then do:
      457               find first buf_firm no-lock
      458                    where buf_firm.firm-code = buf_clients.obj-code
      459                    no-error
      460               .
      461               if available buf_firm
      462               then do:
      463                   assign
      464                       v-num-country-city = num-entries( buf_firm.city )
      465                       v-fmtcli-engl-name = buf_firm.engl-name
      466                   .
      467                   if v-num-country-city > 0
      468                   then do:
      469                       assign
      470                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      471                       .
      472                   end.
      473                   if v-num-country-city > 1
      474                   then do:
      475                       assign
      476                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      477                       .
      478                   end.
      479                   run fmtcli-concatenate-strings in this-procedure (
      480                         input v-fmtcli-full-addres
      481                       , input v-fmtcli-country
      482                       , input ", ":U
      483                       , input 50
      484                       , output v-fmtcli-full-addres
      485                   ).
      486                   run fmtcli-concatenate-strings in this-procedure (
      487                         input v-fmtcli-full-addres
      488                       , input v-fmtcli-city
      489                       , input ", ":U
      490                       , input 50
      491                       , output v-fmtcli-full-addres
      492                   ).
      493                   run fmtcli-concatenate-strings in this-procedure (
      494                         input v-fmtcli-full-addres
      495                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      496                       , input ", ":U
      497                       , input 50
      498                       , output v-fmtcli-full-addres
      499                   ).
      500                   run fmtcli-concatenate-strings in this-procedure (
      501                         input v-fmtcli-post-addres
      502                       , input v-fmtcli-country
      503                       , input ", ":U
      504                       , input 50
      505                       , output v-fmtcli-post-addres
      506                   ).
      507                   run fmtcli-concatenate-strings in this-procedure (
      508                         input v-fmtcli-post-addres
      509                       , input v-fmtcli-city
      510                       , input ", ":U
      511                       , input 50
      512                       , output v-fmtcli-post-addres
      513                   ).
      514                   run fmtcli-concatenate-strings in this-procedure (
      515                         input v-fmtcli-post-addres
      516                       , input string( buf_firm.ind )
      517                       , input ", ":U
      518                       , input 50
      519                       , output v-fmtcli-post-addres
      520                   ).
      521                   run fmtcli-concatenate-strings in this-procedure (
      522                         input substring( buf_firm.addres1, 1, 50 )
      523                       , input buf_firm.addres2
      524                       , input " ":U
      525                       , input 50
      526                       , output v-temp-fmtcli-address
      527                   ).
      528                   run fmtcli-concatenate-strings in this-procedure (
      529                         input v-temp-fmtcli-address
      530                       , input substring( buf_firm.addres1, 51, 50 )
      531                       , input " ":U
      532                       , input 50
      533                       , output v-temp-fmtcli-address
      534                   ).
      535                   run fmtcli-concatenate-strings in this-procedure (
      536                         input v-temp-fmtcli-address
      537                       , input substring( buf_firm.addres1, 101, 50 )
      538                       , input " ":U
      539                       , input 50
      540                       , output v-temp-fmtcli-address
      541                   ).
      542                   assign
      543                       v-fmtcli-addres = v-temp-fmtcli-address
      544                   .
      545                   if buf_firm.addres1 <> ?
      546                   then do:
      547                       run fmtcli-concatenate-strings in this-procedure (
      548                             input v-fmtcli-full-addres
      549                           , input v-fmtcli-addres
      550                           , input ", ":U
      551                           , input 0
      552                           , output v-fmtcli-full-addres
      553                       ).
      554                   end.
      555                   run fmtcli-concatenate-strings in this-procedure (
      556                         input substring( buf_firm.post-addr1, 1, 50 )
      557                       , input buf_firm.post-addr2
      558                       , input " ":U
      559                       , input 50
      560                       , output v-fmtcli-post-addres
      561                   ).
      562                   run fmtcli-concatenate-strings in this-procedure (
      563                         input v-fmtcli-post-addres
      564                       , input substring( buf_firm.post-addr1, 51, 50 )
      565                       , input " ":U
      566                       , input 50
      567                       , output v-fmtcli-post-addres
      568                   ).
      569                   run fmtcli-concatenate-strings in this-procedure (
      570                         input v-fmtcli-post-addres
      571                       , input substring( buf_firm.post-addr1, 101, 50 )
      572                       , input " ":U
      573                       , input 50
      574                       , output v-fmtcli-post-addres
      575                   ).
      576                   assign
      577                       v-fmtcli-phone         = buf_firm.phone
      578                       v-fmtcli-inn           = buf_firm.inn
      579                       v-fmtcli-kpp           = buf_firm.kpp
      580                       v-fmtcli-okpo          = buf_firm.okpo
      581                       v-fmtcli-index         = string( buf_firm.ind )
      582                   .
      583               end.
      584          end.
      585          when 'маг':U
      586          then do:
      587               find first buf_shop no-lock
      588                    where buf_shop.obj-code = buf_clients.obj-code
      589               .
      590               if available buf_shop
      591               then do:
      592                   run fmtcli-concatenate-strings in this-procedure (
      593                         input buf_shop.addres1
      594                       , input buf_shop.addres2
      595                       , input " ":U
      596                       , input 50
      597                       , output v-fmtcli-addres
      598                   ).
      599                   assign
      600                       v-fmtcli-full-addres = v-fmtcli-addres
      601                       v-fmtcli-post-addres = v-fmtcli-addres
      602                       v-fmtcli-phone       = buf_shop.phone
      603                       v-fmtcli-inn         = "":U
      604                       v-fmtcli-kpp         = "":U
      605                       v-fmtcli-okpo        = "":U
      606                       v-fmtcli-city        = "":U
      607                       v-fmtcli-index       = "":U
      608                   .
      609               end.
      610          end.
      611          when 'скл':U
      612          then do:
      613               find first buf_store no-lock
      614                    where buf_store.obj-code = buf_clients.obj-code
      615               .
      616               if available buf_store
      617               then do:
      618                   run fmtcli-concatenate-strings in this-procedure (
      619                         input buf_store.addres1
      620                       , input buf_store.addres2
      621                       , input " ":U
      622                       , input 50
      623                       , output v-fmtcli-addres
      624                   ).
      625                   assign
      626                       v-fmtcli-full-addres = v-fmtcli-addres
      627                       v-fmtcli-phone       = buf_store.phone
      628                       v-fmtcli-inn         = "":U
      629                       v-fmtcli-kpp         = "":U
      630                       v-fmtcli-okpo        = "":U
      631                       v-fmtcli-city        = "":U
      632                       v-fmtcli-index       = "":U
      633                   .
      634               end.
      635          end.
      636          when 'чел':U
      637          then do:
      638               find first buf_person no-lock
      639                    where buf_person.psn-code = buf_clients.obj-code
      640               .
      641               if available buf_person
      642               then do:
      643                   run fmtcli-concatenate-strings in this-procedure (
      644                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      645                                 then "":U
      646                                 else string( buf_person.ind, "999999")
      647                                 )
      648                       , input buf_person.city
      649                       , input ", ":U
      650                       , input 0
      651                       , output v-fmtcli-full-addres
      652                   ).
      653                   assign
      654                       v-fmtcli-addres = buf_person.address
      655                   .
      656                   run fmtcli-concatenate-strings in this-procedure (
      657                         input v-fmtcli-full-addres
      658                       , input v-fmtcli-addres
      659                       , input ", ":U
      660                       , input 0
      661                       , output v-fmtcli-full-addres
      662                   ).
      663                   assign
      664                       v-fmtcli-phone     = buf_person.phone1
      665                       v-fmtcli-inn       = buf_person.inn
      666                       v-fmtcli-kpp       = buf_person.kpp
      667                       v-fmtcli-okpo      = buf_person.okpo
      668                       v-fmtcli-city      = buf_person.city
      669                       v-fmtcli-index     = string( buf_person.ind )
      670                   .
      671               end.
      672          end.
      673       end case.
      674   end.
      675   end procedure.
      676   procedure fmtcli-concatenate-strings :
      677   define input parameter p-string-1       as character        no-undo.
      678   define input parameter p-string-2       as character        no-undo.
      679   define input parameter p-delimiter      as character        no-undo.
      680   define input parameter p-length         as integer          no-undo.
      681   define output parameter p-out-string    as character        no-undo.
      682   do
      683   on error undo, return error
      684   :
      685       assign
      686           p-out-string = ( if p-string-1 = ?
      687                            then "":U
      688                            else trim( p-string-1 ) )
      689       .
      690       assign
      691           p-out-string = p-out-string
      692                        + ( if p-out-string = "":U
      693                            or length( p-out-string ) = p-length
      694                            or p-string-2 = ?
      695                            or trim( p-string-2 ) = "":U
      696                            then "":U
      697                            else p-delimiter )
      698                        + ( if p-string-2 = ?
      699                            or trim( p-string-2 ) = "":U
      700                            then "":U
      701                            else trim( p-string-2 ) )
      702       .
      703   end.
      704   end procedure.
