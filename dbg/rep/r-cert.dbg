     3176                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3177                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3178                                                   )
     3179               .
     3180            end.
     3181            else do:
     3182               assign
     3183                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3184               .
     3185            end.
