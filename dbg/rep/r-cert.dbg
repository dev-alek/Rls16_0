     3108                   , output v-par-type
     3109               ) no-error.
     3110       if error-status :error
     3111       then do:
     3112           assign v-dcode-attr = "".
     3113       end.
     3114       run gbl/trdcat-v.p (
     3115                     input p-doc-code
     3116                   , input 'DFinDoc':U
     3117                   , output v-ddate-attr
     3118                   , output v-par-type
     3119               ) no-error.
     3120       if error-status :error
     3121       then do:
     3122           assign v-ddate-attr = "".
     3123       end.
     3124      end.
     3125      else do:
     3126   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3127                           input 'wthpaydoc':U ,
