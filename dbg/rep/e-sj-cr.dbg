      578   define new global shared variable g#library  as handle no-undo .
      579   define new global shared variable g#library2 as handle no-undo .
      580   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      581   define SHARED temp-table sj-goods no-undo
      582   field obj-attr     as   char
      583   field b-code like ub.bar-code.b-code format "9999999999999"
      584   field saleman-chr as   character
      585   field artic     like ub.goods.artic
      586   field name   like ub.goods.gds-name format "x(30)"
      587   field grp-code          like ub.goods.grp-code
      588   field grp-name          like ub.goods.grp-code
      589   field prod-name   like ub.clients.obj-name
      590   field node-code like ub.gds-prt.node-code
      591   field node-name like ub.gds-prt.node-name
      592   field twounit as decimal
      593   field two-type as logical
      594   field alt-type as logical
      595   INDEX p1 IS PRIMARY   obj-attr ASCENDING
      596   INDEX p2              obj-attr artic ASCENDING
      597   INDEX p3              obj-attr prod-name ASCENDING
      598   INDEX p4              obj-attr b-code saleman-chr ASCENDING
      599   INDEX p6              obj-attr grp-name prod-name
      600   INDEX p7              grp-code
      601   .
      602   define SHARED temp-table sj-adv no-undo
      603   field obj-attr     as   char
      604   field b-code like ub.bar-code.b-code format "9999999999999"
      605   field saleman-chr as    character
      606   field price    like ub.chk-gds.price-base
      607   field discnt  like ub.chk-gds.discnt
      608   field qnty     like ub.chk-gds.doc-qnty
      609   field qnty-2     like ub.chk-gds.doc-qnty
      610   field qnty-3    like ub.chk-gds.doc-qnty
      611   field dop-rowid as rowid
      612   field brutto-sum   as   decimal
      613   field discnt-sum  like ub.chk-gds.discnt
      614   field netto-sum    as   decimal
      615   field brutto-sum-r   as   decimal
      616   field netto-sum-r    as   decimal
      617   field num-lines as integer
      618   field num-docs as integer
      619   INDEX pi  IS PRIMARY   obj-attr b-code saleman-chr price discnt dop-rowid ASCENDING
      620   .
      621   define SHARED temp-table sj-tots no-undo
      622   field obj-attr     as   char
      623   field grp-code          like ub.goods.grp-code
      624   field grp-name          like ub.goods.grp-code
      625   field prod-name   like ub.clients.obj-name
      626   field saleman-chr as    character
      627   field qnty     like ub.chk-gds.doc-qnty
      628   field qnty-2   like ub.chk-gds.doc-qnty
      629   field qnty-3   like ub.chk-gds.doc-qnty
      630   field brutto-sum   as   decimal
      631   field discnt-sum  like ub.chk-gds.discnt
      632   field netto-sum    as   decimal
      633   field brutto-sum-r   as   decimal
      634   field netto-sum-r    as   decimal
      635   field num-lines as integer
      636   field num-docs as integer
      637   INDEX pi  IS PRIMARY   obj-attr ASCENDING
      638   INDEX p1                        prod-name ASCENDING
      639   INDEX p2                        grp-name  ASCENDING
      640   INDEX p3                        grp-code
      641   .
      642   define SHARED temp-table sj-grp no-undo
      643   field grp-code like ub.goods.grp-code
      644   field grp-name like ub.goods.grp-name
      645   field grp-code-alpha like ub.goods.grp-code
      646   INDEX pi grp-code
      647   INDEX iname  grp-name
      648   INDEX grp-code-alpha grp-code-alpha
      649   .
      650   define SHARED temp-table sj-salesman no-undo
      651   field seller like ub.person.seller
      652   field psn-code like ub.person.psn-code
      653   field sal-chr as character
      654   index pi is unique primary seller psn-code
      655   index ichr sal-chr
      656   index ipsn psn-code
      657   .
      658   FUNCTION get-grp-name returns character( input p-grp-code-alpha as integer):
      659   define buffer buf_sj-grp for sj-grp.
      660     find first buf_sj-grp no-lock where
      661               buf_sj-grp.grp-code-alpha = p-grp-code-alpha no-error.
      662     if available buf_sj-grp then do:
      663       return buf_sj-grp.grp-name .
      664     end.
      665     return "!!!Неизвестное имя группы!!!".
      666   END FUNCTION.
      667   function ChkGdsPromo returns logical
      668       (input iDocCode as character)
      669       :
      670       define buffer buf_chk-gds for ub.chk-gds.
      671       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      672       define variable vPromo as logical no-undo.
      673       vPromo = no.
      674       cspr:
      675       for each buf_chk-gds no-lock where
      676                    buf_chk-gds.doc-code = iDocCode,
      677              first buf_chk-gds-attr no-lock where
      678                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      679                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      680                and buf_chk-gds-attr.attr-code = "CSPromo"
      681                and buf_chk-gds-attr.attr-value <> "0":
      682          vPromo = yes.
      683          leave cspr.
      684       end.
      685       return vPromo.
      686   end.
      687   function ChkPromoLine returns logical
      688       (input iDocCode as character,
      689       input iLineNum as integer)
      690       :
      691       define buffer buf_chk-gds for ub.chk-gds.
      692       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      693       define variable vPromo as logical no-undo.
      694       vPromo = no.
      695       find first buf_chk-gds-attr no-lock where
      696                    buf_chk-gds-attr.doc-code = iDocCode
      697                and buf_chk-gds-attr.line-num  = iLineNum
      698                and buf_chk-gds-attr.attr-code = "CSPromo"
      699                and buf_chk-gds-attr.attr-value <> "0"
      700       no-error.
      701       if avail buf_chk-gds-attr then vPromo = yes.
      702       return vPromo.
      703   end.
      704   function ChkPromoSum returns decimal
      705       (input iDocCode as character,
      706        input iLineNum as integer)
      707       :
      708      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      709      define variable vSumPromo as decimal no-undo.
      710      find first buf_chk-gds-attr no-lock where
      711                 buf_chk-gds-attr.doc-code = iDocCode
      712             and buf_chk-gds-attr.line-num  = iLineNum
      713             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      714         no-error.
      715      if avail buf_chk-gds-attr then
      716         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      717      return vSumPromo.
      718   end function.
      719   function ChkPromoPrice returns logical
      720       (input iDocCode as character,
      721        input iLineNum as integer)
      722       :
      723      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      724      define variable v-is-promo as logical no-undo.
      725      v-is-promo = no.
      726      find first buf_chk-gds-attr no-lock where
      727                 buf_chk-gds-attr.doc-code = iDocCode
      728             and buf_chk-gds-attr.line-num  = iLineNum
      729             and buf_chk-gds-attr.attr-code = "CSPromo"
      730         no-error.
      731      if avail buf_chk-gds-attr
      732        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      733      then v-is-promo = yes.
      734      return v-is-promo.
      735   end function.
      736   function ChkDopLitr returns logical
      737       (input iDocCode as character,
      738        input iLineNum as integer)
      739       :
      740      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      741      define variable v-is-promo as logical no-undo.
      742      v-is-promo = no.
      743      find first buf_chk-gds-attr no-lock where
      744                 buf_chk-gds-attr.doc-code = iDocCode
      745             and buf_chk-gds-attr.line-num  = iLineNum
      746             and buf_chk-gds-attr.attr-code = "CSPromo"
      747         no-error.
      748      if avail buf_chk-gds-attr and
      749        buf_chk-gds-attr.attr-value = "3"
      750      then v-is-promo = yes.
      751      return v-is-promo.
      752   end function.
      753   function RoundUp return decimal
      754       (input iQnty as decimal,
      755        input iPrice as decimal):
      756       def var vSum  as decimal no-undo.
      757       def var vSumR as decimal no-undo.
      758       vSum = ABSOLUTE(iQnty) * iPrice.
      759       vSumR = Round(vSum,2).
      760       if vSumR < vSum then vSumR = vSumR + 0.01.
      761       if iQnty < 0 then vSumR = - vSumR.
      762       return vSumR.
      763   end function.
      764   function GetPromoSum returns decimal
      765       (input iDocCode as character)
      766       :
      767       define buffer buf_chk-doc for ub.chk-doc.
      768       define buffer buf2_chk-doc for ub.chk-doc.
      769       define buffer buf_chk-gds for ub.chk-gds.
      770       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      771       define buffer buf2_chk-gds for ub.chk-gds.
      772       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      773       define variable v-price-base as decimal no-undo.
      774       define variable v-doc-qnty as decimal no-undo.
      775       define variable v-sum-base as decimal no-undo.
      776       define variable v-sum-all as decimal no-undo.
      777       define variable v-sum-promo as decimal no-undo.
      778       define variable v-sum-chk as decimal no-undo.
      779       assign
      780          v-price-base = 0
      781          v-doc-qnty = 0
      782          v-sum-all = 0
      783          v-sum-chk = 0
      784          v-sum-promo = 0
      785          .
      786       for each buf_chk-gds no-lock where
      787                buf_chk-gds.doc-code = iDocCode,
      788          first buf_chk-gds-attr no-lock where
      789                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      790            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      791            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      792          :
      793          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      794       end.
      795       if v-sum-promo = 0 then do:
      796           for each buf_chk-gds no-lock where
      797                    buf_chk-gds.doc-code = iDocCode,
      798              first buf_chk-gds-attr no-lock where
      799                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      800                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      801                and buf_chk-gds-attr.attr-code = "CSPromo"
      802                and can-do("1,6", buf_chk-gds-attr.attr-value)
      803              :
      804              assign
      805                v-price-base = buf_chk-gds.price-base
      806                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      807                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      808                .
      809           end.
      810           for each buf_chk-gds no-lock where
      811                    buf_chk-gds.doc-code = iDocCode,
      812              first buf_chk-gds-attr no-lock where
      813                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      814                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      815                and buf_chk-gds-attr.attr-code = "CSPromo"
      816                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      817              :
      818              if v-price-base = 0 then do:
      819                 find first buf_chk-doc no-lock where
      820                            buf_chk-doc.doc-code = iDocCode
      821                     no-error.
      822                 if avail buf_chk-doc and
      823                    buf_chk-doc.chk-type = int('6':U) and
      824                    buf_chk-doc.doc-num2 > ""  and
      825                    num-entries(buf_chk-doc.doc-num2,":") = 2
      826                 then
      827                 for first buf2_chk-doc no-lock where
      828                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      829                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      830                       and buf2_chk-doc.chk-type = int('1':U)
      831                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      832                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      833                       :
      834                   for each buf2_chk-gds no-lock where
      835                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      836                      first buf2_chk-gds-attr no-lock where
      837                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      838                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      839                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      840                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      841                      :
      842                       v-price-base = buf2_chk-gds.price-base.
      843                   end.
      844                 end.
      845              end.
      846              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
      847                  assign
      848                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
      849                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
      850                     .
      851              end.
      852              else do:
      853                 assign
      854                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
      855                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
      856                 .
      857              end.
      858           end.
      859           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
      860       end.
      861       return v-sum-promo.
      862   end function.
      863   function GetUnBaseSum returns decimal
      864       (input iDocCode as character,
      865        input iLineNum as integer,
      866        input iQnty as decimal,
      867        input iPrice as decimal):
      868      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      869      define variable vBaseSum as decimal no-undo.
      870      define variable vDiscSum as decimal no-undo.
      871      vDiscSum = 0.
      872      find first buf_chk-gds-attr no-lock where
      873                        buf_chk-gds-attr.doc-code = iDocCode
      874                    and buf_chk-gds-attr.line-num  = iLineNum
      875                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
      876             no-error.
      877      if avail buf_chk-gds-attr then
      878         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
      879      vBaseSum = iQnty * iPrice + vDiscSum.
      880      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
      881         vBaseSum = RoundUp(iQnty, iPrice).
      882      return vBaseSum.
      883   end function.
      884   function GetRoundSum returns decimal
      885       (input iDocCode as character,
      886        input iLineNum as integer,
      887        input iQnty as decimal,
      888        input iPrice as decimal):
      889      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      890      define variable vBaseSum as decimal no-undo.
      891      if ChkPromoPrice(iDocCode, iLineNum) then
      892         vBaseSum = RoundUp(iQnty, iPrice).
      893      else vBaseSum = iQnty * iPrice.
      894      return vBaseSum.
      895   end function.
      896   function GetRoundSumChkDel returns decimal
      897       (input iDocCode as character,
      898        input iLineNum as integer,
      899        input iChipNum as integer,
      900        input iQnty as decimal,
      901        input iPrice as decimal):
      902      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
      903      define variable vBaseSum as decimal no-undo.
      904      define variable vIsPromo as logical no-undo.
      905      for each buf_c-chk-doc-attr no-lock where
      906               buf_c-chk-doc-attr.doc-code = iDocCode
      907           and buf_c-chk-doc-attr.chip-num = iChipNum
      908          :
      909          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
      910          then do :
      911            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
      912            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
      913            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
      914            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
      915            then vIsPromo = yes.
      916          end.
      917      end.
      918      if ChkPromoPrice(iDocCode, iLineNum) then
      919         vBaseSum = RoundUp(iQnty, iPrice).
      920      else vBaseSum = iQnty * iPrice.
      921      return vBaseSum.
      922   end function.
      923   function GetSaleRetDisc returns decimal
      924       (input iDocCode as character,
      925        input iSaleCode as character):
      926      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      927      define buffer buf_chk-gds for ub.chk-gds.
      928      define variable vQntyPromoRet as decimal no-undo.
      929      define variable vQntyPromoSel as decimal no-undo.
      930      define variable vDiscSumRet   as decimal no-undo.
      931      define variable vDiscSumSale  as decimal no-undo.
      932      vDiscSumRet = 0.
      933      cspr:
      934      for each  buf_chk-gds no-lock where
      935                buf_chk-gds.doc-code = iDocCode,
      936          first buf_chk-gds-attr no-lock where
      937                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      938            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      939            and buf_chk-gds-attr.attr-code = "CSPromo"
      940            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      941          :
      942          vQntyPromoRet = buf_chk-gds.src-qnty.
      943          leave cspr.
      944      end.
      945      if vQntyPromoRet <> 0 then
      946      for each  buf_chk-gds no-lock where
      947                buf_chk-gds.doc-code = iSaleCode:
      948          find first buf_chk-gds-attr no-lock where
      949                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      950                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      951                 and buf_chk-gds-attr.attr-code = "CSPromo"
      952          no-error.
      953          if avail buf_chk-gds-attr
      954               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      955          then
      956            vQntyPromoSel = buf_chk-gds.src-qnty.
      957          find first buf_chk-gds-attr no-lock where
      958                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      959                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      960                and buf_chk-gds-attr.attr-code = "CSPromoSum"
      961          no-error.
      962          if avail buf_chk-gds-attr then
      963             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
      964      end.
      965      if vQntyPromoRet <> 0 and
      966         vQntyPromoSel = -1 * vQntyPromoRet
      967      then vDiscSumRet = -1 * vDiscSumSale.
      968      return vDiscSumRet.
      969   end function.
      970   function SetPromoDisc return logical
      971    (input iDocCode as character,
      972        input iLineNum as integer
      973        )
      974       :
      975      define buffer buf_chk-doc for ub.chk-doc.
      976      define buffer buf2_chk-doc for ub.chk-doc.
      977      define buffer buf_chk-gds for ub.chk-gds.
      978      define buffer buf2_chk-gds for ub.chk-gds.
      979      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      980      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      981      define buffer buf_chk-discnt for ub.chk-discnt.
      982      define buffer buf2_chk-discnt for ub.chk-discnt.
      983      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
      984      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
      985      define variable v-promo-sum as decimal no-undo.
      986      define variable v-disc-promo-id as character no-undo.
      987      define variable var-discnt-id as integer no-undo.
      988      define variable v-chk-sale as character no-undo.
      989      find first buf_chk-gds-attr no-lock where
      990                 buf_chk-gds-attr.doc-code = iDocCode
      991             and buf_chk-gds-attr.line-num  = iLineNum
      992             and buf_chk-gds-attr.attr-code = "CSPromo"
      993         no-error.
      994      if avail buf_chk-gds-attr
      995        then do:
      996        find first buf_chk-discnt no-lock where
      997                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      998               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
      999               and buf_chk-discnt.record-type = 0
     1000               and buf_chk-discnt.promo-id > ""
     1001               no-error.
     1002        if not avail buf_chk-discnt then do:
     1003           find first buf_chk-doc no-lock where
     1004                      buf_chk-doc.doc-code = iDocCode
     1005              no-error.
     1006           find first buf_chk-gds no-lock where
     1007                      buf_chk-gds.doc-code = iDocCode
     1008                 and  buf_chk-gds.line-num = iLineNum
     1009              no-error.
     1010          for first buf2_chk-doc no-lock where
     1011                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1012                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1013                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1014                and buf2_chk-doc.chk-type = int('1':U)
     1015                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1016                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1017              :
     1018              find first buf2_chk-gds no-lock where
     1019                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1020                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1021              no-error.
     1022              if not avail buf2_chk-gds then return no.
     1023              v-chk-sale = buf2_chk-doc.doc-code.
     1024              find first buf_chk-discnt no-lock where
     1025                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1026                         buf_chk-discnt.record-type = 1 and
     1027                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1028                         buf_chk-discnt.promo-id > ""
     1029              no-error .
     1030              if avail buf_chk-discnt
     1031              then do:
     1032                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1033                 find first buf2_chk-discnt no-lock where
     1034                   buf2_chk-discnt.doc-code = iDocCode and
     1035                   buf2_chk-discnt.record-type = 5 and
     1036                   buf2_chk-discnt.line-num = 0 and
     1037                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1038                 no-error.
     1039                 find first buf2_chk-discnt-attr no-lock where
     1040                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1041                            buf2_chk-discnt-attr.record-type = 5 and
     1042                            buf2_chk-discnt-attr.line-num = 0 and
     1043                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1044                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1045                       no-error .
     1046                 if not avail buf2_chk-discnt
     1047                 then do:
     1048                     for each buf_chk-discnt no-lock where
     1049                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1050                          and buf_chk-discnt.record-type = 5:
     1051                          var-discnt-id  = var-discnt-id + 1.
     1052                     end.
     1053                     create buf2_chk-discnt.
     1054                     assign
     1055                       buf2_chk-discnt.doc-code = iDocCode
     1056                       buf2_chk-discnt.record-type = 5
     1057                       buf2_chk-discnt.line-num = 0
     1058                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1059                       buf2_chk-discnt.object-sum = 0
     1060                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1061                                                      then buf2_chk-discnt-attr.discnt-id
     1062                                                      else (var-discnt-id + 1)
     1063                       var-discnt-id = 0
     1064                       buf2_chk-discnt.object-line-num = 0
     1065                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1066                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1067                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1068                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1069                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1070                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1071                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1072                       .
     1073                 end.
     1074                 if avail buf2_chk-discnt and
     1075                    not avail buf2_chk-discnt-attr
     1076                 then do:
     1077                    create buf2_chk-discnt-attr.
     1078                    assign
     1079                       buf2_chk-discnt-attr.doc-code = iDocCode
     1080                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1081                       buf2_chk-discnt-attr.record-type     = 5
     1082                       buf2_chk-discnt-attr.line-num        = 0
     1083                       buf2_chk-discnt-attr.object-line-num = 0
     1084                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1085                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1086                       .
     1087                 end.
     1088              end.
     1089          end.
     1090           v-promo-sum = 0.
     1091           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1092           then do:
     1093              if v-chk-sale <> ? and v-chk-sale <> "" then
     1094                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1095              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1096              if v-promo-sum <> 0 then do:
     1097                  find first buf2_chk-gds-attr no-lock where
     1098                             buf2_chk-gds-attr.doc-code = iDocCode
     1099                         and buf2_chk-gds-attr.line-num  = iLineNum
     1100                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1101                     no-error.
     1102                  if not avail buf2_chk-gds-attr then do:
     1103                      create buf2_chk-gds-attr.
     1104                      assign
     1105                         buf2_chk-gds-attr.doc-code = iDocCode
     1106                         buf2_chk-gds-attr.line-num  = iLineNum
     1107                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1108                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1109                         .
     1110                  end.
     1111              end.
     1112           end.
     1113           for each buf_chk-discnt no-lock where
     1114                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1115               and buf_chk-discnt.record-type = 0:
     1116              var-discnt-id  = var-discnt-id + 1.
     1117           end.
     1118           create buf_chk-discnt.
     1119           assign
     1120               buf_chk-discnt.doc-code = iDocCode
     1121               buf_chk-discnt.line-num = iLineNum
     1122               buf_chk-discnt.record-type = 0
     1123               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1124               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1125               buf_chk-discnt.line-type = integer('1':U)
     1126               buf_chk-discnt.line-sign = no
     1127               buf_chk-discnt.pass-discnt = integer('0':U)
     1128               buf_chk-discnt.value-type = integer('2':U)
     1129               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1130               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1131               buf_chk-discnt.discnt-value-abs = 0
     1132               buf_chk-discnt.discnt-value-pcnt = 0
     1133               buf_chk-discnt.object-line-num = iLineNum
     1134               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1135               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1136               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1137               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1138               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1139               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1140               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1141               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1142               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1143               var-discnt-id = var-discnt-id + 1
     1144               buf_chk-discnt.promo-id = v-disc-promo-id
     1145               buf_chk-discnt.discnt-type = integer('7':U)
     1146               .
     1147           find first buf_chk-discnt-attr no-lock where
     1148                      buf_chk-discnt-attr.attr-code = "promo-id"
     1149                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1150                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1151                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1152                  no-error.
     1153           if not avail buf_chk-discnt-attr then
     1154           do:
     1155               create buf_chk-discnt-attr .
     1156               assign
     1157                   buf_chk-discnt-attr.attr-code = "promo-id"
     1158                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1159                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1160                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1161                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1162                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1163                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1164                   .
     1165            end.
     1166        end.
     1167      end.
     1168      return yes.
     1169   end function.
     1170   function GetPromoPriceSum returns decimal
     1171       (input iDocCode as character)
     1172       :
     1173       define buffer buf_chk-gds for ub.chk-gds.
     1174       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1175       define variable vPromoSum as decimal no-undo.
     1176       vPromoSum = 0.
     1177       cspr:
     1178       for each buf_chk-gds no-lock where
     1179                    buf_chk-gds.doc-code = iDocCode,
     1180              first buf_chk-gds-attr no-lock where
     1181                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1182                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1183                and buf_chk-gds-attr.attr-code = "CSPromo"
     1184                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1185          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1186          leave cspr.
     1187       end.
     1188       return vPromoSum.
     1189   end.
     1190   function GetPromoPriceLine returns integer
     1191       (input iDocCode as character)
     1192       :
     1193       define buffer buf_chk-gds for ub.chk-gds.
     1194       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1195       define variable vPromoLine as integer no-undo.
     1196       vPromoLine = 0.
     1197       cspr:
     1198       for each buf_chk-gds no-lock where
     1199                    buf_chk-gds.doc-code = iDocCode,
     1200              first buf_chk-gds-attr no-lock where
     1201                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1202                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1203                and buf_chk-gds-attr.attr-code = "CSPromo"
     1204                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1205          vPromoLine = buf_chk-gds-attr.line-num.
     1206          leave cspr.
     1207       end.
     1208       return vPromoLine.
     1209   end.
     1210   DEFINE var strbuf1     as      char    no-undo.
     1211   DEFINE var for-saleman as integer no-undo.
     1212   DEFINE var for-saleman-psn-code as integer no-undo.
     1213   DEFINE var for-saleman-chr as character no-undo.
     1214   DEFINE SHARED VAR    cashdesc-num    AS    INTEGER         no-undo.
     1215   DEFINE SHARED VAR    saleman-num     AS    INTEGER         no-undo.
     1216   DEFINE VARIABLE vproc-check as character no-undo .
     1217   DEFINE VARIABLE v-found-chk-gds as logical no-undo .
     1218   define variable v-rate as decimal no-undo .
     1219   DEFINE shared VARIABLE v-num-chk as integer no-undo .
     1220   define variable prev-doc as character no-undo .
     1221   assign
     1222   v-num-chk = 0
     1223   .
     1224   vproc-check = entry(1, par-run-names, chr(4)).
     1225   FOR EACH obj-list :
     1226       strbuf1 = obj-list.obj-type + string( obj-list.obj-code ) .
     1227     _chk-doc:
     1228     FOR EACH ub.chk-doc no-lock WHERE
     1229             ub.chk-doc.obj-type = obj-list.obj-type AND
     1230             ub.chk-doc.obj-code = obj-list.obj-code
     1231             and
     1232      (
     1233                 (p-by-shift-dates = yes
     1234                 AND
     1235                 (ub.chk-doc.shift-date >= startdate AND
     1236                 ub.chk-doc.shift-date <= enddate)
     1237                 )
     1238                 or
     1239                 (p-by-shift-dates = no
     1240                 AND ub.chk-doc.chk-date >= startdate
     1241                 AND ub.chk-doc.chk-date <= enddate
     1242                 )
     1243            )
     1244       :
     1245       if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then NEXT _chk-doc.
     1246       if saleman-num < 10000 then do:
     1247         if rs-seller-cashier = "seller" then do:
     1248           if ub.chk-doc.sales-man <> 0
     1249           and not can-find(first sj-salesman where sj-salesman.seller = ub.chk-doc.sales-man) then NEXT.
     1250           if ub.chk-doc.salesman-psn-code <> ?
     1251           and ub.chk-doc.salesman-psn-code <> 0
     1252           and not can-find(first sj-salesman where sj-salesman.psn-code = ub.chk-doc.salesman-psn-code) then NEXT.
     1253         end.
     1254         else do:
     1255           if ub.chk-doc.cashier <> 0
     1256           and not can-find(first sj-salesman where sj-salesman.seller = ub.chk-doc.cashier) then NEXT.
     1257           if ub.chk-doc.cashier-psn-code <> ?
     1258           and ub.chk-doc.cashier-psn-code <> 0
     1259           and not can-find(first sj-salesman where sj-salesman.psn-code = ub.chk-doc.cashier-psn-code) then NEXT.
     1260         end.
     1261       end.
     1262       if p-cash-desk-num >= 0
     1263       and ub.chk-doc.pay-desk <> p-cash-desk-num then   NEXT .
     1264       if p-by-shift-dates then do:
     1265         IF Period-Type = 3 AND
     1266             ((ub.chk-doc.shift-date = startdate AND ub.chk-doc.shift-num < startshift) OR
     1267               (ub.chk-doc.shift-date = enddate AND  ub.chk-doc.shift-num > endshift) ) THEN NEXT.
     1268         IF Period-Type = 4 AND
     1269             ub.chk-doc.shift-num <> shiftalone THEN NEXT.
     1270       end.
     1271     if v-curr-r-b = 'base':U then do:
     1272       v-rate = ?.
     1273       assign
     1274       v-rate = ub.chk-doc.cash-rate / ub.chk-doc.cash-scale
     1275       no-error .
     1276       if error-status:error
     1277       or v-rate = 0 or v-rate = ?
     1278       then do:
     1279         FIND FIRST ub.chk-pay WHERE
     1280                     ub.chk-pay.doc-code = ub.chk-doc.doc-code NO-LOCK .
     1281         if not avail ub.chk-pay then  NEXT _chk-doc.
     1282         assign
     1283         v-rate = ub.chk-pay.tot-rubl / ub.chk-pay.tot-base.
     1284      end.
     1285   end.
     1286       if rs-seller-cashier = "seller" then do:
     1287         assign
     1288         for-saleman = IF BYSALERS
     1289                       then ub.chk-doc.sales-man
     1290                       else 0
     1291         for-saleman-psn-code = IF BYSALERS and chk-doc.salesman-psn-code <> ?
     1292                               then ub.chk-doc.salesman-psn-code
     1293                               else 0
     1294         for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1295         v-found-chk-gds = no
     1296         .
     1297       end.
     1298       else do:
     1299         assign
     1300         for-saleman = IF BYSALERS
     1301                       then ub.chk-doc.cashier
     1302                       else 0
     1303         for-saleman-psn-code = IF BYSALERS and ub.chk-doc.cashier-psn-code <> ?
     1304                               then ub.chk-doc.cashier-psn-code
     1305                               else 0
     1306         for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1307         v-found-chk-gds = no
     1308         .
     1309       end.
     1310       FOR EACH ub.chk-gds WHERE
     1311               ub.chk-gds.doc-code = ub.chk-doc.doc-code NO-LOCK :
     1312         if rs-seller-cashier = "seller" then do:
     1313           assign
     1314           for-saleman = (if BYSALERS AND ub.chk-gds.sales-man <> ? AND ub.chk-gds.sales-man <> 0
     1315                           then ub.chk-gds.sales-man
     1316                           else for-saleman)
     1317           for-saleman-psn-code = (if BYSALERS AND ub.chk-gds.salesman-psn-code <> ? AND ub.chk-gds.salesman-psn-code  <> 0
     1318                           then ub.chk-gds.salesman-psn-code
     1319                           else for-saleman-psn-code)
     1320           for-saleman-chr = string(for-saleman) + chr(4) + string(for-saleman-psn-code)
     1321           .
     1322         end.
     1323         FIND FIRST sj-goods WHERE
     1324                     sj-goods.obj-attr = strbuf1 AND
     1325                     sj-goods.b-code = ub.chk-gds.b-code AND
     1326                     sj-goods.saleman-chr = for-saleman-chr
     1327                     NO-ERROR .
     1328         if available sj-goods then  do:
     1329   if ptwounit and sj-goods.twounit > 0 then
     1330           FIND FIRST sj-adv WHERE
     1331                       sj-adv.obj-attr = strbuf1 AND
     1332                       sj-adv.b-code = ub.chk-gds.b-code AND
     1333                       sj-adv.saleman-chr = for-saleman-chr AND
     1334                       sj-adv.price = ub.chk-gds.price-base AND
     1335                       sj-adv.discnt = ub.chk-gds.discnt AND
     1336                       sj-adv.dop-rowid = rowid(ub.chk-gds)
     1337                       NO-ERROR .
     1338   else
     1339           FIND FIRST sj-adv WHERE
     1340                       sj-adv.obj-attr = strbuf1 AND
     1341                       sj-adv.b-code = ub.chk-gds.b-code AND
     1342                       sj-adv.saleman-chr = for-saleman-chr AND
     1343                       sj-adv.price = ub.chk-gds.price-base AND
     1344                       sj-adv.discnt = ub.chk-gds.discnt
     1345                       NO-ERROR .
     1346           if NOT available sj-adv then   do:
     1347             CREATE sj-adv.
     1348             assign
     1349             sj-adv.obj-attr = strbuf1
     1350             sj-adv.b-code = ub.chk-gds.b-code
     1351             sj-adv.saleman-chr = for-saleman-chr
     1352             sj-adv.price = ub.chk-gds.price-base
     1353             sj-adv.discnt = ub.chk-gds.discnt
     1354             sj-adv.qnty = 0
     1355             sj-adv.qnty-2 = 0
     1356             sj-adv.qnty-3 = 0
     1357             sj-adv.dop-rowid = if ptwounit
     1358                                 then rowid(ub.chk-gds)
     1359                                 else sj-adv.dop-rowid
     1360             .
     1361           end.
     1362         end.
     1363         else  do:
     1364           FIND FIRST ub.bar-code WHERE
     1365                     ub.bar-code.b-code = ub.chk-gds.b-code NO-LOCK NO-ERROR .
     1366           IF NOT AVAIL ub.bar-code then NEXT.
     1367           if available ub.bar-code then do:
     1368             if Producer = 4 then do:
     1369               find first gds-list where
     1370                         gds-list.gds-code = ub.bar-code.gds-code no-error .
     1371               if not available gds-list then NEXT.
     1372             end.
     1373             FIND FIRST ub.goods WHERE
     1374                       ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
     1375             IF NOT AVAIL ub.goods then NEXT.
     1376             IF Producer = 3 then do:
     1377               FIND FIRST g#cli WHERE
     1378                           g#cli.obj-type = ub.goods.prod-type AND
     1379                           g#cli.obj-code = ub.goods.prod-code NO-LOCK NO-ERROR.
     1380               if not avail g#cli then NEXT.
     1381             end.
     1382             if ptwounit then do:
     1383               FIND FIRST ub.units no-LOCK WHERE
     1384                           ub.units.unit-name = ub.goods.unit-base No-ERROR.
     1385             end.
     1386             FIND FIRST ub.clients WHERE
     1387                       ub.clients.obj-type = ub.goods.prod-type AND
     1388                       ub.clients.obj-code = ub.goods.prod-code NO-LOCK.
     1389             FIND FIRST ub.gds-prt No-LOCK WHERE
     1390                       ub.gds-prt.node-code = ub.bar-code.node-code No-ERROR.
     1391             CREATE sj-goods.
     1392             CREATE sj-adv.
     1393             assign
     1394             sj-goods.obj-attr = strbuf1
     1395             sj-goods.b-code = ub.bar-code.b-code
     1396             sj-goods.saleman-chr = for-saleman-chr
     1397             sj-goods.artic = ub.goods.artic
     1398             sj-goods.name = ub.goods.gds-name
     1399             sj-goods.grp-code = ub.goods.grp-code
     1400             sj-goods.prod-name = ub.clients.obj-name
     1401             sj-goods.node-code = ub.bar-code.node-code
     1402             sj-goods.node-name = if avail ub.gds-prt and NOT ub.gds-prt.node-name = '_Пустая шкала':U
     1403                                     then ub.gds-prt.node-name
     1404                                     else ""
     1405             sj-goods.two-type = if ptwounit
     1406                                     then  (if avail ub.units and LOOKUP('2ед':U, ub.units.type ) > 0
     1407                                             then yes
     1408                                             else no)
     1409                                     else no
     1410             sj-goods.alt-type = if ptwounit
     1411                                     then (if  avail units and LOOKUP('доп':U, units.type) > 0
     1412                                           then yes
     1413                                             else no)
     1414                                         else no
     1415             sj-goods.twounit = if sj-goods.two-type
     1416                                 then 1
     1417                                 else (if sj-goods.alt-type
     1418                                       then ub.goods.wt-cart
     1419                                       else 0)
     1420             sj-adv.obj-attr = strbuf1
     1421             sj-adv.b-code = ub.chk-gds.b-code
     1422             sj-adv.saleman-chr = for-saleman-chr
     1423             sj-adv.price = ub.chk-gds.price-base
     1424             sj-adv.discnt = ub.chk-gds.discnt
     1425             sj-adv.qnty = 0
     1426             sj-adv.qnty-2 = 0
     1427             sj-adv.qnty-3 = 0
     1428             sj-adv.dop-rowid = if ptwounit
     1429                                 then rowid(ub.chk-gds)
     1430                                 else sj-adv.dop-rowid
     1431             .
     1432             find first sj-grp where
     1433                         sj-grp.grp-code = sj-goods.grp-code no-error .
     1434             if not available sj-grp then do:
     1435               create sj-grp.
     1436               assign
     1437               sj-grp.grp-code = sj-goods.grp-code
     1438               sj-grp.grp-name = ub.goods.grp-name
     1439               .
     1440             end.
     1441           end.
     1442         end.
     1443         assign
     1444         sj-adv.qnty = sj-adv.qnty + ub.chk-gds.doc-qnty
     1445         sj-adv.qnty-2 = sj-adv.qnty-2 + (if ub.chk-gds.doc-qnty >= 0 then 1 else - 1 ) *
     1446                                         (if sj-goods.two-type then 1 else 0) * sj-goods.twounit +
     1447                                         (if sj-goods.alt-type then 1 else 0) * ub.chk-gds.doc-qnty
     1448         sj-adv.qnty-3 = sj-adv.qnty-3 + (if chk-gds.doc-qnty >= 0 then 1 else - 1 ) *
     1449                                         (if sj-goods.alt-type then 1 else 0) * sj-goods.twounit +
     1450                                         (if sj-goods.two-type then 1 else 0) * ub.chk-gds.doc-qnty
     1451         sj-adv.brutto-sum = sj-adv.brutto-sum + GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty, ub.chk-gds.price-base)
     1452                             + ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1453         sj-adv.discnt-sum = sj-adv.discnt-sum + ub.chk-gds.discnt * ub.chk-gds.doc-qnty
     1454                             + ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1455         sj-adv.netto-sum = sj-adv.netto-sum +
     1456                            + GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty, ( ub.chk-gds.price-base - ub.chk-gds.discnt ))
     1457         sj-adv.num-lines  = sj-adv.num-lines + 1
     1458         sj-adv.num-docs   = sj-adv.num-doc + (if chk-gds.doc-code = prev-doc then 0 else 1)
     1459         prev-doc          = chk-gds.doc-code.
     1460   if v-curr-r-b = 'base':U then do:
     1461         assign
     1462         sj-adv.brutto-sum-r = sj-adv.brutto-sum-r +
     1463                               round(GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty * v-rate, chk-gds.price-base), 2) +
     1464                               ChkPromoSum(ub.chk-gds.doc-code,ub.chk-gds.line-num)
     1465         sj-adv.netto-sum-r = sj-adv.netto-sum-r +
     1466                             round(GetRoundSum(ub.chk-gds.doc-code,ub.chk-gds.line-num,ub.chk-gds.doc-qnty * v-rate,( ub.chk-gds.price-base - ub.chk-gds.discnt )),2)
     1467         .
     1468   end.
     1469         v-found-chk-gds = yes
     1470         .
     1471       END.
     1472       assign
     1473       v-num-chk = (if v-found-chk-gds
     1474                     then v-num-chk + 1
     1475                     else v-num-chk)
     1476       .
     1477       ACCUMULATE ub.chk-doc.doc-code ( COUNT ) .
     1478       if ( ( ACCUM COUNT ub.chk-doc.doc-code ) modulo 20 ) = 0 AND
     1479             ( ACCUM COUNT ub.chk-doc.doc-code ) >= 20 then
     1480           run waitfram-show in p-sj-handle ( obj-list.obj-type + " " + string( obj-list.obj-code ) +
     1481               vproc-check + string( ACCUM COUNT ub.chk-doc.doc-code ) ) .
     1482     END.
     1483   END.
