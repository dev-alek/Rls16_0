     9333                   sym3 v-qnty
     9334                   sym4 v-price-no-VAT
     9335                   sym5 v-sum-no-VAT
     9336                   sym6 "без акциза" format "x(10)"                                      @ v-sum-actciz
     9337                   sym7 v-VAT-prc
