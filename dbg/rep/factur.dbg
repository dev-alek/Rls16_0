     5682     (input  bf_trn-doc.obj-type
     5683     ,input  bf_trn-doc.obj-code
     5684     ,input  varb-code
     5685     ,input  0
     5686     ,input  bf_trn-doc.fact-order
     5687     ,output vardoc-num
     5688     ,output varprice-sale
     5689     ,output varroad-tax
     5690     ,output varexcise
     5691     )  .
     5692             if varprice-sale = ?
     5693             then do:
     5694               assign
     5695                 varprice-sale = 0
     5696                 varroad-tax   = 0
     5697                 varexcise     = 0
     5698               .
     5699             end.
     5700             assign
     5701               varlastcur-base     = varprice-sale
     5702               varlastcur-road-tax = varroad-tax
     5703               varlastcur-excise   = varexcise
     5704               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     5705               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     5706               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     5707               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     5708             .
     5709         end.
     5710       end.
     5711       if varcur-fact-qnty = 0 then do:
     5712         assign
     5713           varcur-base      = varlastcur-base
     5714           varcur-road-tax  = varlastcur-road-tax
     5715           varcur-excise    = varlastcur-excise
     5716         .
     5717       end.
     5718       else do:
     5719         assign
     5720           varcur-base      = varcur-base      / varcur-fact-qnty
     5721           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     5722           varcur-excise    = varcur-excise    / varcur-fact-qnty
     5723         .
     5724       end.
     5725       if varcur-vat-pc = ?
     5726       then do:
     5727         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5728       end.
     5729       if varcur-slt-pc = ?
     5730       then do:
     5731         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5732       end.
     5733       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5734       assign
     5735         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5736       if varcur-cons-vat-pc = ? then do:
