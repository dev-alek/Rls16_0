     6954   procedure facturxl-run-excel :
     6955   define input parameter p-header-filename    as character        no-undo.
     6956   define input parameter p-data-filename      as character        no-undo.
     6957       define variable v-template-file-name    as character    no-undo.
     6958       define variable v-vb-file-name          as character    no-undo.
     6959       define buffer buf_temp-param for temp-param .
     6960   do
     6961   for buf_temp-param
     6962   on error undo, return error
     6963   :
     6964       create buf_temp-param.
     6965       assign
     6966           v-template-file-name    = search( "exe/sf_97.xlt" )
     6967           v-vb-file-name          = search( "exe/t_97.bas")
     6968       .
     6969       if v-template-file-name = ?
     6970       or v-template-file-name = "":U
     6971       then do:
     6972           message
     6973               "Ошибка имени файла шаблона."
     6974           view-as alert-box error.
     6975       end.
     6976       if v-vb-file-name = ?
     6977       or v-vb-file-name = "":U
     6978       then do:
     6979           message
     6980               "Ошибка имени файла кода обработки."
     6981           view-as alert-box error.
     6982       end.
     6983       run paramls-write in this-procedure (
     6984             input "template":U
     6985           , input "template-file-name":U
     6986           , input v-template-file-name
     6987       ).
     6988       run paramls-write in this-procedure (
     6989             input "template":U
     6990           , input "vb-file-name":U
     6991           , input v-vb-file-name
     6992       ).
     6993       run paramls-write in this-procedure (
     6994             input "data":U
     6995           , input "data-header-filename":U
     6996           , input p-header-filename
     6997       ).
     6998       run paramls-write in this-procedure (
     6999             input "data":U
     7000           , input "data-filename":U
     7001           , input p-data-filename
     7002       ).
     7003       run gbl/macroxlt.p (
     7004           input-output table buf_temp-param
     7005       ) no-error.
     7006       if error-status :error
     7007       then do:
     7008           message
     7009                    vss-workfile vss-revision vss-description
     7010               skip(1)
     7011               skip "Ошибка создания файла Excel."
     7012               skip return-value
     7013               skip trim(error-status :get-message(1))
     7014                    trim(error-status :get-message(2))
     7015                    trim(error-status :get-message(3))
     7016           view-as alert-box error.
     7017           undo, return error .
     7018       end.
     7019   end.
     7020   end procedure.
