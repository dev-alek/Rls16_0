     3476            find first buf_shop no-lock
     3477            where buf_shop.obj-code = v-torgconf-self-obj-code
     3478            .
     3479            assign
     3480               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3481            .
     3482         END.
     3483         WHEN 'скл':U
