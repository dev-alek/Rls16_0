     6657       index pi is primary unique xl-line-id
     6658   .
     6659   define variable v-facturxl-current-data-row     as integer      no-undo.
     6660   define variable v-facturxl-cell-file-name       as character    no-undo.
     6661   define variable v-facturxl-data-file-name       as character    no-undo.
     6662   procedure facturxl-init :
     6663       define buffer buf_temp_cell-data        for temp_cell-data.
     6664       define buffer buf_usr-flt               for ubflt.usr-flt.
     6665       define variable v-column-list as character no-undo .
     6666       define variable v-column-type as character no-undo .
     6667       define variable v-num-cloumns as integer no-undo .
     6668   do
     6669   for buf_temp_cell-data
     6670     , buf_usr-flt
     6671   on error undo, return error
     6672   :
     6673       assign
     6674           v-facturxl-current-data-row = 0
     6675       .
     6676       run gbl/_tmpfile.p (
     6677             input "xd"
     6678           , input ".txt"
     6679           , output v-facturxl-data-file-name
     6680       ).
     6681       output stream excel-line to value( v-facturxl-data-file-name ).
     6682       run gbl/_tmpfile.p (
     6683             input "xc"
     6684           , input ".txt"
     6685           , output v-facturxl-cell-file-name
     6686       ).
     6687       output stream excel-cell to value( v-facturxl-cell-file-name ).
     6688       run facturxl-write-cell-data in this-procedure (
     6689             input "valutCode":U
     6690           , input if printrubl then "0":U else "1":U
     6691       ).
     6692     if lookup ("corr" , p-mode) <> 0 then do :
     6693       v-column-list = "Name,pokazately,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum":U .
     6694       v-column-type = "S,S,S,I,S,D,C,C,S,D,C,C":U .
     6695     end.
     6696     else do :
     6697       v-column-list = "Name,UAES,OKEI,EI,qnty,price,SumNoVAT,SumActciz,VATpc,VATsum,sum,countrycode,country,GTD":U .
     6698       v-column-type = "S,S,I,S,D,C,C,S,D,C,C,I,S,S":U .
     6699     end.
     6700     v-num-cloumns = num-entries(v-column-list) .
     6701     run facturxl-write-cell-data in this-procedure (
     6702             input "columnList":U
     6703           , input v-column-list
     6704     ).
     6705     run facturxl-write-cell-data in this-procedure (
     6706             input "columnType":U
     6707           , input v-column-type
     6708     ).
     6709     run facturxl-write-cell-data in this-procedure (
     6710             input "columnAmount":U
     6711           , input string(v-num-cloumns)
     6712     ).
     6713     if lookup ("corr" , p-mode) <> 0 then .
     6714     else do :
     6715       run facturxl-write-cell-data in this-procedure (
     6716             input "subtotalList":U
     6717           , input "SumNoVAT,VATsum,sum":U
     6718       ).
     6719       run facturxl-write-cell-data in this-procedure (
     6720             input "subtotalType":U
     6721           , input "S,S,S":U
     6722       ).
     6723       run facturxl-write-cell-data in this-procedure (
     6724             input "subtotalAmount":U
     6725           , input "3":U
     6726       ).
     6727     end.
     6728   end.
     6729   end procedure.
     6730   procedure facturxl-close :
     6731   do
     6732   on error undo, return error
     6733   :
     6734       output stream excel-line close.
     6735       output stream excel-cell close.
     6736       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     6737           export "exe/sf_97.xlt":U.
     6738           export "exe/t_97.bas":U.
     6739           export v-facturxl-cell-file-name.
     6740           export v-facturxl-data-file-name.
     6741       output close.
     6742   end.
     6743   end procedure.
