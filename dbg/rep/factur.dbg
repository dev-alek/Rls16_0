     9310                    gds-str1                                                  @ buf_goods.gds-name
     9311                   sym2 "  -   " @ v-uaes-code
     9312                   sym16 v-unit-code
     9313                   sym14 ( if invers then ("  " + doc-line.unit-cli) else ("  " + buf_goods.unit-base) ) @ buf_goods.unit-base
     9314                   sym3 v-qnty
     9315                   sym4 v-price-no-VAT
     9316                   sym5 v-sum-no-VAT
