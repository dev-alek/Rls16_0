     6541   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     6542   procedure paramls-clear :
     6543     define buffer buf_temp-param for temp-param .
     6544     do
     6545     on error undo, return error return-value
     6546     :
     6547       for each buf_temp-param
     6548       on error undo, return error
     6549       :
     6550         delete buf_temp-param .
     6551       end.
     6552     end.
     6553   end procedure.
     6554   procedure paramls-write :
     6555     define input  parameter p-code     as character no-undo .
     6556     define input  parameter p-sub-code as character no-undo .
     6557     define input  parameter p-value    as character no-undo .
     6558     define buffer buf_temp-param for temp-param .
     6559     do
     6560     on error undo, return error return-value
     6561     :
     6562       find first buf_temp-param
     6563         where buf_temp-param.param-code     = p-code
     6564           and buf_temp-param.param-sub-code = p-sub-code
     6565         no-error .
     6566       if not available buf_temp-param then do:
     6567         create buf_temp-param .
     6568         assign
     6569           buf_temp-param.param-code     = p-code
     6570           buf_temp-param.param-sub-code = p-sub-code
     6571         .
     6572       end.
     6573       assign
     6574         buf_temp-param.param-value = p-value
     6575       .
     6576     end.
     6577   end procedure.
     6578   procedure paramls-read :
     6579     define input  parameter p-code          as character no-undo .
     6580     define input  parameter p-sub-code      as character no-undo .
     6581     define input  parameter p-default-value as character no-undo .
     6582     define output parameter p-value         as character no-undo .
     6583     define buffer buf_temp-param for temp-param .
     6584     do
     6585     on error undo, return error return-value
     6586     :
     6587       find first buf_temp-param
     6588         where buf_temp-param.param-code     = p-code
     6589           and buf_temp-param.param-sub-code = p-sub-code
     6590         no-error .
     6591       if available buf_temp-param then do:
     6592         assign
     6593           p-value = buf_temp-param.param-value
     6594         .
     6595       end.
     6596       else do:
     6597         assign
     6598           p-value = p-default-value
     6599         .
     6600       end.
     6601     end.
     6602   end procedure.
     6603   procedure paramls-append :
     6604     define input  parameter p-code     as character no-undo .
     6605     define input  parameter p-sub-code as character no-undo .
     6606     define input  parameter p-value    as character no-undo .
     6607     define buffer buf_temp-param for temp-param .
     6608     do
     6609     on error undo, return error return-value
     6610     :
     6611       find first buf_temp-param
     6612            where buf_temp-param.param-code     = p-code
     6613              and buf_temp-param.param-sub-code = p-sub-code
     6614         no-error .
     6615       if not available buf_temp-param then do:
     6616         create buf_temp-param .
     6617         assign
     6618           buf_temp-param.param-code     = p-code
     6619           buf_temp-param.param-sub-code = p-sub-code
     6620           buf_temp-param.param-value    = p-value
     6621         .
     6622       end.
     6623       else do:
     6624           assign
     6625               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     6626           .
     6627       end.
     6628     end.
     6629   end procedure.
     6630   define variable vss-include-info34 as character format "X(65)" no-undo
     6631   initial "@(#)$Workfile$ $Revision$".
     6632   define stream excel-line.
     6633   define stream excel-cell.
     6634   define temp-table temp_cell-data no-undo
     6635       field data-key as character
     6636       field data-value as character
     6637       index pi is primary unique data-key
     6638   .
