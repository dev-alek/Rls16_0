     7959   procedure print-more:
     7960   do
     7961   on error undo, return error
     7962   :
     7963       def var v-start-string as character no-undo.
     7964       def var v-add-string as character no-undo.
     7965       assign
     7966           v-start-string = gds-str2
     7967       .
     7968       do while trim(v-start-string) <> "" :
     7969           assign gds-str = v-start-string.
     7970           v-add-string = breakstr(gds-str, 45, input-output v-add-string, input-output v-start-string).
     7971           if lookup( "dec10", p-mode ) <> 0
     7972           THEN DO:
     7973             display stream Out-stream
     7974                ((if rep-artic then fill(" ",17) else "") + v-add-string) @ buf_goods.gds-name
     7975               sym16 sym14 sym2 sym3 sym4 sym5 sym6 sym7 sym8
     7976               sym9  sym11 sym15 sym12
     7977               with frame factur-10 .
     7978             down stream Out-stream 1 with frame factur-10 .
     7979           END.
     7980           ELSE DO:
     7981             display stream Out-stream
     7982               sym1 ((if rep-artic then fill(" ",17) else "") + v-add-string) @ buf_goods.gds-name
     7983               sym16 sym14 sym2 sym3 sym4 sym5 sym6 sym7 sym8
     7984               sym9  sym11 sym15 sym12 sym13
     7985               with frame factur .
     7986             down stream Out-stream 1 with frame factur .
     7987           END.
     7988       end.
     7989   end.
     7990   end procedure.
     7991   procedure print-line :
     7992       define variable v-print-parts     as logical    init no       no-undo.
     7993   do
     7994   on error undo, return error
     7995   :
     7996       assign v-VAT-prc = ub.doc-line.VAT-pc .
     7997       find first buf_goods no-lock
     7998            where buf_goods.prod-type = ub.doc-line.prod-type
     7999              and buf_goods.prod-code = ub.doc-line.prod-code
     8000              and buf_goods.artic = ub.doc-line.artic
     8001       .
     8002       find first ub.country no-lock
     8003            where ub.country.alpha1 = buf_goods.alpha1
     8004       no-error.
     8005       if lookup( "zum", p-mode ) <> 0
     8006       then do:
     8007           assign
     8008               v-country = buf_goods.engl-name
     8009           .
     8010       end.
     8011       else do:
     8012           if available ub.country
     8013           then do:
     8014               assign
     8015                   v-country-code = " " + string(ub.country.num-code)
     8016                   v-country = ub.country.short-name
     8017               .
     8018           end.
     8019           else do:
     8020               assign
     8021                   v-country-code = ""
     8022                   v-country = ""
     8023               .
     8024           end.
     8025       end.
     8026       assign
     8027           gds-str  = ''
     8028           gds-str1 = ''
     8029           gds-str2 = ''
     8030       .
     8031       find first Units no-lock
     8032            where units.unit-name = buf_goods.unit-base
     8033       .
     8034       v-unit-code = (if units.OKEI = 0 then "-" else string(units.OKEI)) .
     8035       if (units.type = "дро,2ед"  or  units.type = "дро,доп" )
     8036       then do:
     8037           assign
     8038               str =  (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "")  + string(buf_goods.Sort,"x(5)") + " " + trim(buf_goods.gds-name)
     8039                                                                                    + " " + trim(buf_goods.PS)
     8040           .
     8041       end.
     8042       else do:
     8043           assign
     8044               str = (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "")  + trim(buf_goods.gds-name)
     8045           .
     8046       end.
     8047       assign
     8048           Gds-str1 = breakstr(str, 45, input-output gds-str1, input-output gds-str2)
     8049       .
     8050       do while trim(gds-str2) <> "" :
     8051           assign
     8052               gds-str = gds-str2
     8053               gds-str1 = breakstr(gds-str, 45, input-output gds-str1, input-output gds-str2)
     8054           .
     8055       end.
     8056       assign
     8057           gds-str1 = breakstr(str, 45, input-output gds-str1, input-output gds-str2).
     8058       .
     8059       find first gds-prt no-lock
     8060            where gds-prt.upper-code = doc-line.prt-root
     8061       .
     8062       assign
     8063           rootnode_code = gds-prt.node-code
     8064       .
     8065       if ( gds-prt.node-name <> '_Пустая шкала':U )
     8066       then do:
     8067          assign
     8068              v-tot-prt-qnty          = 0
     8069              v-tot-prt-VAT           = 0
     8070              v-tot-prt-SLT           = 0
     8071              v-tot-prt-sum-no-VAT    = 0
     8072              v-tot-prt-sum           = 0
     8073          .
     8074          if PrintScale = yes
     8075          then do:
     8076             define variable is-printed as logical initial no no-undo .
     8077             for each parts no-lock
     8078                where parts.out-code  = doc-line.doc-code
     8079                  and parts.obj-type  = doc-line.obj-type
     8080                  and parts.obj-code  = doc-line.obj-code
     8081                  and parts.artic     = doc-line.artic
     8082                  and parts.prod-type = doc-line.prod-type
     8083                  and parts.prod-code = doc-line.prod-code
     8084             :
     8085                 assign v-GTD = parts.cst-code.
     8086                 if     available country
     8087                    and country.alpha1 = "RU":U
     8088                 then do:
     8089                    assign
     8090                        v-GTD       = "":U
     8091                        v-country-code = "":U
     8092                        v-country   = "":U
     8093                   .
     8094                 end.
     8095                 find first buf_parts-attr no-lock
     8096                      where buf_parts-attr.in-code   = parts.in-code
     8097                        and buf_parts-attr.gds-code  = goods.gds-code
     8098                        and buf_parts-attr.part-code = parts.part-code
     8099                 no-error .
     8100                 if available buf_parts-attr
     8101                    and buf_parts-attr.country-code <> 0
     8102                 then do:
     8103                    find first buf_country
     8104                    where buf_country.num-code = buf_parts-attr.country-code
     8105                    no-error.
     8106                    if available buf_country
     8107                       and buf_country.num-code <> country.num-code
     8108                       and buf_country.short-name <> ""
     8109                    then do :
     8110                       assign
     8111                          v-country-code = " " + string(buf_country.num-code)
     8112                          v-country = buf_country.short-name
     8113                       .
     8114                       if buf_country.alpha1 = "RU":U
     8115                       then do :
     8116                          assign
     8117                              v-country-code = "":U
     8118                              v-country = "":U
     8119                              v-GTD     = "":U
     8120                          .
     8121                       end .
     8122                    end.
     8123                 end.
     8124               if is-printed = no
     8125                 then do:
     8126                 assign is-printed = yes .
     8127                    if lookup( "dec10", p-mode ) <> 0
     8128                    THEN DO:
     8129                       display stream Out-stream  gds-str1 @ buf_goods.gds-name sym16 sym14 sym2 v-country sym3 v-GTD
     8130                                                sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12  with frame factur-10 .
     8131                       down stream Out-stream 1 with frame factur-10 .
     8132                    END.
     8133                    ELSE DO:
     8134                       display stream Out-stream sym1 gds-str1 @ buf_goods.gds-name sym16 sym14 sym2 v-country sym3 v-GTD
     8135                                                 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     8136                       down stream Out-stream 1 with frame factur .
     8137                    END.
     8138                    run facturxl-write-line-data in this-procedure (
     8139                         input gds-str1
     8140                       , input "":U
     8141                       , input "":U
     8142                       , input "":U
     8143                       , input "":U
     8144                       , input "":U
     8145                       , input "":U
     8146                       , input "":U
     8147                       , input "":U
     8148                       , input "":U
     8149                       , input "":U
     8150                       , input v-country-code
     8151                       , input v-country
     8152                       , input v-GTD
     8153                   ).
     8154                 end.
     8155                 else do:
     8156                    if v-GTD <> ""
     8157                    then do:
     8158                       if lookup( "dec10", p-mode ) <> 0
     8159                       THEN DO:
     8160                          display stream Out-stream  sym16 sym14 sym2  sym3 v-GTD sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12  with frame factur-10 .
     8161                          down stream Out-stream 1 with frame factur-10 .
     8162                       END.
     8163                       ELSE DO:
     8164                          display stream Out-stream sym1 sym16 sym14 sym2  sym3 v-GTD sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     8165                          down stream Out-stream 1 with frame factur .
     8166                       END.
     8167                       run facturxl-write-line-data in this-procedure (
     8168                             input "":U
     8169                           , input "":U
     8170                           , input "":U
     8171                           , input "":U
     8172                           , input "":U
     8173                           , input "":U
     8174                           , input "":U
     8175                           , input "":U
     8176                           , input "":U
     8177                           , input "":U
     8178                           , input "":U
     8179                           , input "":U
     8180                           , input "":U
     8181                           , input v-GTD
     8182                       ).
     8183                    end.
     8184                 end.
     8185             end.
     8186             if is-printed = no
     8187             then do:
     8188                if lookup( "dec10", p-mode ) <> 0
     8189                THEN DO:
     8190                   display stream Out-stream  gds-str1 @ buf_goods.gds-name sym16 sym14 sym2 v-country sym3 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12  with frame factur-10 .
     8191                   down stream Out-stream 1 with frame factur-10 .
     8192                END.
     8193                ELSE DO:
     8194                   display stream Out-stream sym1 gds-str1 @ buf_goods.gds-name sym16 sym14 sym2 v-country sym3 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13 with frame factur .
     8195                   down stream Out-stream 1 with frame factur .
     8196                END.
     8197                run facturxl-write-line-data in this-procedure (
     8198                         input (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "") + buf_goods.gds-name
     8199                       , input "":U
     8200                       , input "":U
     8201                       , input "":U
     8202                       , input "":U
     8203                       , input "":U
     8204                       , input "":U
     8205                       , input "":U
     8206                       , input "":U
     8207                       , input "":U
     8208                       , input "":U
     8209                       , input v-country-code
     8210                       , input v-country
     8211                       , input "":U
     8212                   ).
     8213                if FullGdsName
     8214                  and gds-str1 <> "":U
     8215                then do :
     8216                   run print-more in this-procedure.
     8217                end.
     8218             end.
     8219          end.
     8220          for each gds-dtl no-lock
     8221              where gds-dtl.prod-type  = doc-line.prod-type
     8222                and gds-dtl.prod-code  = doc-line.prod-code
     8223                and gds-dtl.artic      = doc-line.artic
     8224                and gds-dtl.doc-code   = doc-line.doc-code
     8225          :
     8226              find first gds-prt no-lock
     8227                    where gds-prt.node-code = gds-dtl.prt-code
     8228              .
     8229              if CostPrice = yes
     8230              then do:
     8231   assign
     8232     price-rubl-with-tax-loc = doc-line.price-rubl
     8233     price-base-with-tax-loc = doc-line.price-base
     8234   .
     8235   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8236   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8237     (output varinvprb
     8238     )  .
     8239      find first in-vatp_doc-attr no-lock
     8240       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8241         and in-vatp_doc-attr.attr-code = 'envd':U
     8242       no-error .
     8243       if available in-vatp_doc-attr
     8244          then do:
     8245          assign
     8246            in-vatp-have-vat-slt = no.
     8247      end.
     8248      else do:
     8249        assign
     8250          in-vatp-have-vat-slt = yes.
     8251      end.
     8252      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     8253                                        in-vatp-goods.prod-type = doc-line.prod-type and
     8254                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     8255      if (not buf_trn-doc.internal and
     8256              buf_trn-doc.doc-type = 'при':U) or
     8257         in-vatp-goods.gds-type = 'у':U then do:
     8258         if varinvprb = "base":u then do:
     8259           assign
     8260             road-tax-base-loc = doc-line.road-tax
     8261             road-tax-rubl-loc = doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     8262         end.
     8263         else do:
     8264           ASSIGN
     8265             road-tax-rubl-loc = doc-line.road-tax
     8266             road-tax-base-loc = doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     8267         end.
     8268         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     8269         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     8270         assign
     8271           road-tax-cli-loc = ?.
     8272         ASSIGN
     8273           transport-base-loc = (if doc-line.transport-base = ? then 0 else doc-line.transport-base)
     8274           transport-rubl-loc = (if doc-line.transport-rubl = ? then 0 else doc-line.transport-rubl)
     8275           transport-cli-loc  = 0
     8276           other-base-loc     = (if doc-line.other-base     = ? then 0 else doc-line.other-base)
     8277           other-rubl-loc     = (if doc-line.other-rubl     = ? then 0 else doc-line.other-rubl)
     8278           other-cli-loc      = 0
     8279           vat-pc-loc         = (if doc-line.vat-pc         = ? then 0 else doc-line.vat-pc)
     8280           slt-pc-loc         = (if doc-line.slt-pc         = ? then 0 else doc-line.slt-pc).
     8281                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8282               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8283         assign
     8284           vat-cli-loc            = ?
     8285           slt-cli-loc            = ?
     8286           price-cli-with-tax-loc = ?.
     8287      end.
     8288      else do:
     8289                                                   for each in-vatp-parts where in-vatp-parts.out-code  = doc-line.doc-code  and
     8290                                         in-vatp-parts.obj-type  = doc-line.obj-type  and
     8291                                         in-vatp-parts.obj-code  = doc-line.obj-code  and
     8292                                         in-vatp-parts.artic     = doc-line.artic     and
     8293                                         in-vatp-parts.prod-type = doc-line.prod-type and
     8294                                         in-vatp-parts.prod-code = doc-line.prod-code
     8295                            use-index out-code no-lock:
