     5748           and bf_parts.obj-code  = bf_doc-line.obj-code
     5749           and bf_parts.artic     = bf_doc-line.artic
     5750           and bf_parts.prod-type = bf_doc-line.prod-type
     5751           and bf_parts.prod-code = bf_doc-line.prod-code
     5752       on error undo, return error return-value
     5753       :
     5754         create buf_tt-clcparts .
