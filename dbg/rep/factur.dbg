        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id           as recid                no-undo.
        4   define input parameter p-ovr            as logical              no-undo.
        5   define input parameter invers           as logical              no-undo.
        6   define input parameter p-mode           as character            no-undo.
        7   define input parameter p-round          as character            no-undo.
        8   define input parameter p-no-slt         as logical              no-undo .
        9   define variable vss-revision    as character no-undo initial "$Revision: ba90cb26dd49, 1888, rls $":U .
       10   define variable vss-author      as character no-undo initial "$Author: druban $":U .
       11   define variable vss-date        as character no-undo initial "$Date: Fri Jun 07 16:26:45 2019 +0300 $":U .
       12   define variable vss-workfile    as character no-undo initial "$Workfile: factur.p $":U .
       13   define variable vss-archive     as character no-undo initial "$Archive: rep/factur.p $":U .
       14   define variable vss-description as character no-undo initial "Печать счета-фактуры.":U .
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       76   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       77   define  shared variable RepPathName        as character no-undo .
       78   define  shared variable PrintRubl          as logical   no-undo .
       79   define variable vss-include-info1 as character format "X(65)" no-undo
       80   initial "@(#)$Workfile$ $Revision$".
       81   define temp-table temp_p-fmt_string-part no-undo
       82       field str-key       as integer
       83       field string-part   as character
       84       index pi is primary unique
       85           str-key
       86   .
       87   define variable v-p-fmt-1-str-key    as integer      no-undo.
       88   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       89                                     iInput AS INTEGER).
       90     def var v-start-print as integer no-undo .
       91     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
       92     assign
       93       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
       94     .
       95     RETURN v-start-print .
       96   END FUNCTION.
       97   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
       98                                     iInput AS INTEGER).
       99     def var v-start-print as integer no-undo .
      100     assign
      101       v-start-print = INTEGER(iEndPix - 1 - iInput)
      102     .
      103     if v-start-print < 0 then return 0.
      104     RETURN v-start-print .
      105   END FUNCTION.
      106   function p-fmt-align-string returns character (
      107         p-in-string      as character
      108       , p-page-width     as integer
      109       , p-align-type     as character
      110   ).
      111       define variable v-string-length     as integer      no-undo.
      112       define variable v-out-string        as character    no-undo.
      113       assign
      114           v-string-length = length( trim( p-in-string ) )
      115       .
      116       if v-string-length >= p-page-width
      117       then do:
      118           assign
      119               v-out-string = trim( p-in-string )
      120           .
      121       end.
      122       else do:
      123           case p-align-type
      124           :
      125               when 'left':U
      126               then do:
      127                   assign
      128                       v-out-string = trim( p-in-string )
      129                   .
      130               end.
      131               when 'right':U
      132               then do:
      133                   assign
      134                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      135                   .
      136               end.
      137               when 'center':U
      138               then do:
      139                   assign
      140                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      141                   .
      142               end.
      143           end case.
      144       end.
      145       return v-out-string .
      146   end function.
      147   procedure p-fmt-split-string :
      148   define input parameter p-source-string  as character        no-undo.
      149   define input parameter p-split-length   as integer          no-undo.
      150   define output parameter p-string-1      as character        no-undo.
      151   define output parameter p-string-2      as character        no-undo.
      152   do
      153   on error undo, return error
      154   :
      155       define variable v-space-pos    as integer      no-undo.
      156       if length( p-source-string ) <= p-split-length
      157       then do:
      158           assign
      159               p-string-1 = p-source-string
      160           .
      161       end.
      162       else do:
      163           assign
      164               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      165           .
      166           if v-space-pos = 0
      167           then do:
      168               assign
      169                   v-space-pos = index( p-source-string, " ":U )
      170               .
      171           end.
      172           if v-space-pos = 0
      173           then do:
      174               assign
      175                   p-string-1 = substring( p-source-string, 1, p-split-length )
      176                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      177               .
      178           end.
      179           else do:
      180               assign
      181                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      182                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      183               .
      184           end.
      185       end.
      186   end.
      187   end procedure.
      188   procedure p-fmt-round :
      189   define input parameter p-qnty               as decimal          no-undo.
      190   define input parameter p-price-no-VAT       as decimal          no-undo.
      191   define input parameter p-VAT                as decimal          no-undo.
      192   define input parameter p-SLT                as decimal          no-undo.
      193   define input parameter p-road-tax           as decimal          no-undo.
      194   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      195   define output parameter p-new-VAT           as decimal          no-undo.
      196   define output parameter p-new-SLT           as decimal          no-undo.
      197   define output parameter p-new-sum-VAT       as decimal          no-undo.
      198   define output parameter p-new-sum-SLT       as decimal          no-undo.
      199   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      200   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      201   define output parameter p-new-sum-full      as decimal          no-undo.
      202       define variable v-vat-pc    as decimal      no-undo.
      203       define variable v-slt-pc    as decimal      no-undo.
      204   do
      205   on error undo, return error
      206   :
      207       if p-price-no-VAT = 0
      208       then do:
      209           assign
      210               p-new-price-no-VAT = 0.0
      211               p-new-VAT          = ?
      212               p-new-SLT          = ?
      213               p-new-sum-VAT      = 0.0
      214               p-new-sum-SLT      = 0.0
      215               p-new-sum-no-VAT   = 0.0
      216               p-new-sum-road-tax = 0.0
      217               p-new-sum-full     = 0.0
      218           .
      219       end.
      220       else do:
      221           assign
      222               v-vat-pc            = p-VAT / p-price-no-VAT
      223               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      224               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      225               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      226               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      227               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      228               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      229               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      230               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      231               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      232           .
      233       end.
      234   end.
      235   end procedure.
      236   procedure p-fmt-split :
      237   define input parameter p-in-string      as character        no-undo.
      238   define input parameter p-split-length   as integer          no-undo.
      239       define variable v-start-pos     as integer      no-undo.
      240       define variable v-end-pos       as integer      no-undo.
      241       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      242   do
      243   for buf_temp_p-fmt_string-part
      244   on error undo, return error
      245   :
      246       empty temp-table buf_temp_p-fmt_string-part.
      247       if p-split-length < 1
      248       then do:
      249           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      250       end.
      251       assign
      252           p-in-string                 = trim( p-in-string )
      253           v-p-fmt-1-str-key   = 0
      254           v-start-pos                 = 1
      255           v-end-pos                   = length( p-in-string )
      256       .
      257       run p-fmt-get-string-range in this-procedure (
      258             input p-in-string
      259           , input p-split-length
      260           , input v-start-pos
      261           , output v-start-pos
      262           , output v-end-pos
      263       ).
      264       do while v-end-pos <> 0
      265       :
      266           create buf_temp_p-fmt_string-part.
      267           assign
      268               v-p-fmt-1-str-key = v-p-fmt-1-str-key + 1
      269           .
      270           assign
      271               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-1-str-key
      272               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      273           .
      274           assign
      275               v-start-pos = v-end-pos + 1
      276           .
      277           run p-fmt-get-string-range in this-procedure (
      278                 input p-in-string
      279               , input p-split-length
      280               , input v-start-pos
      281               , output v-start-pos
      282               , output v-end-pos
      283           ).
      284       end.
      285   end.
      286   end procedure.
      287   procedure p-fmt-get-string-range :
      288   define input parameter p-in-string      as character        no-undo.
      289   define input parameter p-split-length   as integer          no-undo.
      290   define input parameter p-old-start-pos  as integer          no-undo.
      291   define output parameter p-start-pos     as integer          no-undo.
      292   define output parameter p-end-pos       as integer          no-undo.
      293       define variable v-init-string    as character    no-undo.
      294       define variable v-temp-char      as character    no-undo.
      295       define variable v-temp-pos       as integer      no-undo.
      296       define variable v-counter        as integer      no-undo.
      297   do
      298   on error undo, return error
      299   :
      300       assign
      301           p-start-pos   = p-old-start-pos
      302           v-init-string = substring( p-in-string, p-start-pos )
      303       no-error.
      304       if error-status :error
      305       or trim( v-init-string ) = "":U
      306       then do:
      307           assign
      308               p-end-pos = 0
      309           .
      310           undo, return .
      311       end.
      312       assign
      313           v-temp-char   = substring( v-init-string, 1, 1 )
      314       .
      315       do
      316       while trim( v-temp-char ) = "":U
      317       :
      318           assign
      319               p-start-pos     = p-start-pos + 1
      320               v-init-string   = substring( p-in-string, p-start-pos )
      321               v-temp-char     = substring( v-init-string, 1, 1 )
      322           .
      323       end.
      324       assign
      325           v-temp-pos  = p-split-length
      326           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      327           v-counter   = 0
      328       .
      329       search-word-end:
      330       do
      331       while trim( v-temp-char ) <> "":U
      332       :
      333           assign
      334               v-counter   = v-counter + 1
      335           .
      336           if v-counter > 20
      337           then do:
      338               assign
      339                   v-temp-pos  = p-split-length
      340               .
      341               leave search-word-end.
      342           end.
      343           assign
      344               v-temp-pos  = v-temp-pos - 1
      345               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      346           .
      347       end.
      348       assign
      349           p-end-pos = p-start-pos + v-temp-pos - 1
      350       .
      351   end.
      352   end procedure.
      353   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      354   function breakstr returns character ( input        for-name    as character,
      355                                         input        line-length as integer,
      356                                         input-output line1       as character,
      357                                         input-output line2       as character ) :
      358     define variable ii as integer no-undo.
      359     if length( for-name ) > line-length then do:
      360       assign ii    = 1
      361              line1 = "":u
      362              line2 = "":u.
      363       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      364         assign line1 =       substring( for-name, 1, line-length     )
      365                line2 = trim( substring( for-name,    line-length + 1 ) ).
      366       end.                                                     else do:
      367         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      368           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      369                  ii    = ii    + 1.
      370           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      371             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      372           end.
      373         end.
      374         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      375       end.
      376     end.                                else do:
      377       assign line1 = for-name
      378              line2 = "":u.
      379     end.
      380     return ( line1 ).
      381   end function.
