     5339       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     5340       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     5341       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     5342       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     5343       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     5344       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     5345       bfsacc_tt-allsum.vat-base-cur        = 0
     5346       bfsacc_tt-allsum.vat-rubl-cur        = 0
     5347       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     5348       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     5349       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     5350       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     5351       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     5352       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     5353       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     5354       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     5355       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     5356       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     5357       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     5358       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     5359       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     5360       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     5361       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     5362       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     5363       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     5364       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     5365       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     5366       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     5367       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     5368       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     5369       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     5370       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     5371       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     5372       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     5373       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     5374       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     5375       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     5376       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     5377       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     5378       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     5379       .
     5380   end.
     5381   otherwise do:
     5382     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     5383                              cl_tt-clcparts.purch-code,
     5384                              cl_tt-clcparts.part-code,
     5385                              cl_tt-clcparts.out-code,
     5386                              cl_tt-clcparts.in-code,
     5387                              cl_tt-clcparts.artic,
     5388                              cl_tt-clcparts.prod-type,
     5389                              cl_tt-clcparts.prod-code).
     5390   end.
     5391   end case.
     5392   end.
     5393   end procedure.
     5394   procedure clcprtsl_calc-line :
     5395   define input  parameter parrec-line as recid no-undo.
     5396   define variable v-tax-date         as   date                     no-undo.
     5397   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     5398   define variable varr-b             as   character                no-undo.
     5399   define variable varr-btype         as   character                no-undo.
     5400   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     5401   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     5402   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     5403   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     5404   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     5405   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     5406   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     5407   define variable varb-code          like ub.bar-code.b-code       no-undo.
     5408   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5409   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5410   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5411   define variable varexcise          like ub.price-list.excise     no-undo.
     5412   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     5413   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     5414   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     5415   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5416   define variable v-varsum           as decimal                  no-undo.
     5417   define variable varprice-salef as decimal   no-undo .
     5418   define buffer bf_trn-doc             for ub.trn-doc.
     5419   define buffer bf_doc-line            for ub.doc-line.
     5420   define buffer bf_gds-dtl             for ub.gds-dtl.
     5421   define buffer bf_goods               for ub.goods.
     5422   define buffer bf_parts               for ub.parts.
     5423   define buffer bf_sysconf             for ub.sysconf.
     5424   define buffer bf_tt-allsum-line      for tt-allsum-line.
     5425   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     5426   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     5427   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     5428   define buffer buf_parts        for ub.parts.
     5429   v-calcbypart = no.
     5430   do on error undo, return error return-value :
     5431   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     5432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     5433     (output varr-b
     5434     )  .
     5435     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     5436     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     5437     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     5438                               bf_goods.prod-type = bf_doc-line.prod-type and
     5439                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     5440     if bf_trn-doc.fact-date <> ?        then do:
     5441       assign v-tax-date = bf_trn-doc.fact-date.
     5442     end.
     5443     else do:
     5444       assign v-tax-date = ?.
     5445     end.
     5446   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5447   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     5448     (input  bf_goods.gds-code
     5449     ,input  '1':U
     5450     ,input  v-tax-date
     5451     ,input  bf_trn-doc.host-code
     5452     ,input  bf_trn-doc.obj-type
     5453     ,input  bf_trn-doc.obj-code
     5454     ,output v-vat-pc
     5455     ) no-error .
     5456     if error-status :error
     5457     or v-vat-pc = ? then do:
     5458        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5459     end.
     5460     if bf_goods.gds-type = 'у':U or
     5461        bf_trn-doc.status_ = 'запрос':U then do:
     5462       for each bf_tt-allsum-line
     5463       on error undo, return error return-value
     5464        :
     5465         delete bf_tt-allsum-line.
     5466       end.
     5467       create bf_tt-allsum-line.
     5468       assign
     5469        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     5470       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     5471                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     5472                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     5473                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     5474         assign
     5475           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     5476           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     5477           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     5478           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     5479           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     5480           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5481           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     5482           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     5483           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     5484           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     5485           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5486           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     5487           bf_tt-allsum-line.vat-cli-acc          =  ?
     5488           .
     5489       end.
     5490       assign
     5491         bf_tt-allsum-line.cli-qnty             =  ?
     5492         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5493         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5494         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5495         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5496         bf_tt-allsum-line.road-tax-base-doc    =  0
     5497         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     5498         bf_tt-allsum-line.excise-base-doc      =  0
     5499         bf_tt-allsum-line.excise-rubl-doc      =  0
     5500         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     5501         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     5502         bf_tt-allsum-line.dsc-base-cur         =  0
     5503         bf_tt-allsum-line.dsc-rubl-cur         =  0
     5504         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5505         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     5506         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5507         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     5508         bf_tt-allsum-line.road-tax-base-cur    =  0
     5509         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     5510         bf_tt-allsum-line.excise-base-cur      =  0
     5511         bf_tt-allsum-line.excise-rubl-cur      =  0
     5512         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     5513         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     5514         bf_tt-allsum-line.dsc-base-acc         =  0
     5515         bf_tt-allsum-line.dsc-rubl-acc         =  0
     5516         bf_tt-allsum-line.dsc-cli-acc          =  0
     5517         bf_tt-allsum-line.slt-base-acc         =  0
     5518         bf_tt-allsum-line.slt-rubl-acc         =  0
     5519         bf_tt-allsum-line.slt-cli-acc          =  0
     5520         bf_tt-allsum-line.road-tax-base-acc    =  0
     5521         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     5522         bf_tt-allsum-line.road-tax-cli-acc     =  0
     5523         bf_tt-allsum-line.excise-base-acc      =  0
     5524         bf_tt-allsum-line.excise-rubl-acc      =  0
     5525         bf_tt-allsum-line.excise-cli-acc       =  0
     5526         bf_tt-allsum-line.transport-base-acc   =  0
     5527         bf_tt-allsum-line.transport-rubl-acc   =  0
     5528         bf_tt-allsum-line.transport-cli-acc    =  0
     5529         bf_tt-allsum-line.other-base-acc       =  0
     5530         bf_tt-allsum-line.other-rubl-acc       =  0
     5531         bf_tt-allsum-line.other-cli-acc        =  0
     5532         .
     5533       create bfs_tt-allsum-line.
     5534       assign
     5535       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     5536       if bf_trn-doc.doc-type = 'инв':U or
     5537          bf_trn-doc.doc-type = 'при':U    or
     5538          bf_trn-doc.doc-type = 'возврат':U    then do:
     5539          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     5540       end.
     5541       else do:
     5542         assign
     5543           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     5544           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     5545           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     5546           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     5547           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     5548           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     5549           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     5550           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     5551           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     5552           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     5553           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     5554           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     5555           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     5556           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     5557           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     5558           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     5559           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     5560           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
     5561           bfs_tt-allsum-line.dsc-base-cur        =  - bf_tt-allsum-line.dsc-base-cur
     5562           bfs_tt-allsum-line.dsc-rubl-cur        =  - bf_tt-allsum-line.dsc-rubl-cur
     5563           bfs_tt-allsum-line.vat-base-cur        =  - bf_tt-allsum-line.vat-base-cur
     5564           bfs_tt-allsum-line.vat-rubl-cur        =  - bf_tt-allsum-line.vat-rubl-cur
     5565           bfs_tt-allsum-line.vat-base-buyer-cur  =  - bf_tt-allsum-line.vat-base-buyer-cur
     5566           bfs_tt-allsum-line.vat-rubl-buyer-cur  =  - bf_tt-allsum-line.vat-rubl-buyer-cur
     5567           bfs_tt-allsum-line.slt-base-cur        =  - bf_tt-allsum-line.slt-base-cur
     5568           bfs_tt-allsum-line.slt-rubl-cur        =  - bf_tt-allsum-line.slt-rubl-cur
     5569           bfs_tt-allsum-line.road-tax-base-cur   =  - bf_tt-allsum-line.road-tax-base-cur
     5570           bfs_tt-allsum-line.road-tax-rubl-cur   =  - bf_tt-allsum-line.road-tax-rubl-cur
     5571           bfs_tt-allsum-line.excise-base-cur     =  - bf_tt-allsum-line.excise-base-cur
     5572           bfs_tt-allsum-line.excise-rubl-cur     =  - bf_tt-allsum-line.excise-rubl-cur
     5573           bfs_tt-allsum-line.sum-dsc-base-acc    =  - bf_tt-allsum-line.sum-dsc-base-acc
     5574           bfs_tt-allsum-line.sum-dsc-rubl-acc    =  - bf_tt-allsum-line.sum-dsc-rubl-acc
     5575           bfs_tt-allsum-line.sum-dsc-cli-acc     =  - bf_tt-allsum-line.sum-dsc-cli-acc
     5576           bfs_tt-allsum-line.dsc-base-acc        =  - bf_tt-allsum-line.dsc-base-acc
