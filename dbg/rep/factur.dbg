     1278       define variable v-outt12    as character     no-undo.
     1279       define variable v-outappr   as character     no-undo.
     1280       define variable v-outrubl   as character     no-undo.
     1281       define variable v-outhold   as character     no-undo.
     1282       define variable v-outobj    as character     no-undo.
     1283       define variable v-outexlst  as character     no-undo.
     1284       define variable v-outprncd  as character     no-undo.
     1285       define variable v-par-type  as character     no-undo.
     1286       define variable v-outogr    as character     no-undo.
     1287       define variable v-outR      as character     no-undo.
     1288       define variable v-outB      as character     no-undo.
     1289       define variable v-outC      as character     no-undo.
     1290       assign
     1291           v-torgconf-outdate  = no
     1292           v-torgconf-outnum   = no
     1293           v-torgconf-outprim  = no
     1294           v-torgconf-outdisc  = no
     1295           v-torgconf-outsubs  = no
     1296           v-torgconf-outrecv  = no
     1297           v-torgconf-outegrp  = no
     1298           v-torgconf-outt12   = no
     1299           v-torgconf-outappr  = no
     1300           v-torgconf-outrubl  = no
     1301           v-torgconf-outhold  = no
     1302           v-torgconf-outobj   = no
     1303           v-torgconf-outexlst = no
     1304           v-torgconf-outexpas = "":U
     1305           v-torgconf-outprncd = yes
     1306           v-torgconf-outares  = no
     1307           v-torgconf-outsend  = no
     1308           v-torgconf-outasend  = no
     1309           v-torgconf-outprops  = no
     1310           v-form-name          = p-form-name
     1311       .
     1312   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1313   empty temp-table thbjattr_thbj-attr.
     1314   run adm/shattri.p (
     1315      input "get":U
     1316     ,input ''
     1317     ,input 0
     1318     ,input 'prt-glob':U
     1319     ,input  ""
     1320     ,output v-value-character
     1321     ,output v-value-date
     1322     ,output v-value-decimal
     1323     ,output v-value-integer
     1324     ,output v-value-logical
