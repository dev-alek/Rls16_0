      509       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      510       define variable varinvatp-envdo             as   character              no-undo.
      511       define variable varinvatp-typeo             as   character              no-undo.
      512   function cross-list returns logical (
      513     input parfirst-stream  as character,
      514     input parsecond-stream as character,
      515     input pardelim         as character).
      516     if pardelim = ""
      517     or pardelim = ?
      518     then do:
      519       assign
      520         pardelim = ","
      521       .
      522     end.
      523     define variable vari            as integer no-undo .
      524     define variable varresult-cross as logical no-undo .
      525     assign
      526       varresult-cross = no
      527     .
      528     def var v-num-parfirst-stream as integer no-undo .
      529     assign
      530       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      531     .
      532     do vari = 1 to v-num-parfirst-stream
      533     :
      534       if lookup(entry(vari, parfirst-stream, pardelim)
      535                ,parsecond-stream
      536                ,pardelim
      537                ) > 0 then do:
      538         assign
      539           varresult-cross = yes
      540         .
      541         leave.
      542       end.
      543     end.
      544     return varresult-cross .
      545   end function.
      546   function hvrdtax return logical (input parrecid as recid):
      547   define variable varresult as logical no-undo.
      548   run hvrdtax-proc (input parrecid, output varresult).
      549   return varresult.
      550   end function.
      551   procedure hvrdtax-proc:
      552   define input  parameter parrecid  as recid   no-undo.
      553   define output parameter parresult as logical no-undo.
      554   define buffer bf_goods for ub.goods.
      555   define buffer bf_units for ub.units.
      556   define buffer rt_tax   for ub.tax.
      557   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      558   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      559   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      560   if available rt_tax and
      561       can-find(first ub.tax-units No-LOCK WHERE
      562                      ub.tax-units.tax-code = rt_tax.tax-code AND
      563                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      564                                                       else assign parresult = no.
      565   end procedure.
      566   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      567   procedure tax-name:
      568   define input  parameter pardef-tax  as character           no-undo.
      569   define output parameter parname-tax as character initial ? no-undo.
      570   define buffer bf_tax for ub.tax.
      571   do on error undo, return error :
      572      case pardef-tax:
      573         when 'vat':U then do:
      574                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      575         end.
      576         when 'slt':U then do:
      577                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      578         end.
      579         when 'rdt':U then do:
      580                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      581         end.
      582         when 'exc':U then do:
      583                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      584         end.
      585         otherwise do:
      586            return error "Задан неверный параметр " + pardef-tax + " .".
      587         end.
      588      end case.
      589   end.
      590   end procedure.
      591   define variable vss-include-info4 as character format "X(65)" no-undo
      592   initial "@(#)$Workfile$ $Revision$".
      593   define variable v-fmtcli-name          as character    no-undo.
      594   define variable v-fmtcli-engl-name     as character    no-undo.
      595   define variable v-fmtcli-addres        as character    no-undo.
      596   define variable v-fmtcli-post-addres   as character    no-undo.
      597   define variable v-fmtcli-full-addres   as character    no-undo.
      598   define variable v-fmtcli-phone         as character    no-undo.
      599   define variable v-fmtcli-inn           as character    no-undo.
      600   define variable v-fmtcli-kpp           as character    no-undo.
      601   define variable v-fmtcli-okpo          as character    no-undo.
      602   define variable v-fmtcli-country       as character    no-undo.
      603   define variable v-fmtcli-city          as character    no-undo.
      604   define variable v-fmtcli-index         as character    no-undo.
      605   define variable v-fmtcli-schet-exists  as logical      no-undo.
      606   define variable v-fmtcli-bank-exists   as logical      no-undo.
      607   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      608   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      609   define variable v-fmtcli-bank-bik      as character    no-undo.
      610   define variable v-fmtcli-bank-name     as character    no-undo.
      611   define variable v-fmtcli-bank-addres   as character    no-undo.
      612   define variable v-fmtcli-bank-city     as character    no-undo.
      613   procedure fmtcli-get-bank :
      614   define input parameter p-host-code      as integer          no-undo.
      615   define input parameter p-obj-type       as character        no-undo.
      616   define input parameter p-obj-code       as integer          no-undo.
      617   define input parameter p-curr-code      as integer          no-undo.
      618       define buffer buf_fin-schet     for ub.fin-schet.
      619       define buffer buf_fin-bank      for ub.fin-bank.
      620   do
      621   for buf_fin-schet
      622     , buf_fin-bank
      623   on error undo, return error
      624   :
      625       assign
      626           v-fmtcli-schet-exists       = no
      627           v-fmtcli-bank-exists        = no
      628           v-fmtcli-bank-r-schet       = "":U
      629           v-fmtcli-bank-c-schet       = "":U
      630           v-fmtcli-bank-bik           = "":U
      631           v-fmtcli-bank-name          = "":U
      632           v-fmtcli-bank-addres        = "":U
      633           v-fmtcli-bank-city          = "":U
      634       .
      635       search-for-schet:
      636       for each buf_fin-schet no-lock
      637          where buf_fin-schet.host-code = p-host-code
      638            and buf_fin-schet.cli-type  = p-obj-type
      639            and buf_fin-schet.cli-code  = p-obj-code
      640            and buf_fin-schet.curr-code = p-curr-code
      641       on error undo, return error
      642       :
      643           if buf_fin-schet.status_   = 'удал':U
      644           then do:
      645           end.
      646           else do:
      647               assign
      648                   v-fmtcli-schet-exists   = yes
      649                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      650                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      651               .
      652               find first buf_fin-bank no-lock
      653                    where buf_fin-bank.host-code = p-host-code
      654                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      655               no-error.
      656               if available buf_fin-bank
      657               then do:
      658                   assign
      659                       v-fmtcli-bank-exists      = yes
      660                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      661                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      662                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      663                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      664                   .
      665               end.
      666               else do:
      667                   assign
      668                       v-fmtcli-bank-exists    = no
      669                       v-fmtcli-bank-bik       = "":U
      670                       v-fmtcli-bank-name      = "":U
      671                       v-fmtcli-bank-addres    = "":U
      672                       v-fmtcli-bank-city      = "":U
      673                   .
      674               end.
      675               leave search-for-schet.
      676           end.
      677       end.
      678   end.
      679   end procedure.
      680   procedure fmtcli-get-client :
      681   define input parameter p-obj-type       as character    no-undo.
      682   define input parameter p-obj-code       as integer      no-undo.
      683       define variable v-temp-fmtcli-address      as character     no-undo.
      684       define variable v-num-country-city    as integer      no-undo.
      685       define buffer buf_clients   for ub.clients.
      686       define buffer buf_firm      for ub.firm.
      687       define buffer buf_store     for ub.store.
      688       define buffer buf_shop      for ub.shop.
      689       define buffer buf_person    for ub.person.
      690   do
      691   for buf_clients
      692     , buf_firm
      693     , buf_store
      694     , buf_shop
      695     , buf_person
      696   on error undo, return error
      697   :
      698       assign
      699           v-fmtcli-name           = "":U
      700           v-fmtcli-addres         = "":U
      701           v-fmtcli-post-addres    = "":U
      702           v-fmtcli-full-addres    = "":U
      703           v-fmtcli-phone          = "":U
      704           v-fmtcli-inn            = "":U
      705           v-fmtcli-kpp            = "":U
      706           v-fmtcli-okpo           = "":U
      707           v-fmtcli-city           = "":U
      708           v-fmtcli-index          = "":U
      709           v-fmtcli-country        = "":U
      710       .
      711       find first buf_clients no-lock
      712            where buf_clients.obj-type = p-obj-type
      713              and buf_clients.obj-code = p-obj-code
      714       .
      715       assign
      716           v-fmtcli-name = buf_clients.obj-name
      717       .
      718       case buf_clients.obj-type:
      719          when 'орг':U
      720          then do:
      721               find first buf_firm no-lock
      722                    where buf_firm.firm-code = buf_clients.obj-code
      723                    no-error
      724               .
      725               if available buf_firm
      726               then do:
      727                   assign
      728                       v-num-country-city = num-entries( buf_firm.city )
      729                       v-fmtcli-engl-name = buf_firm.engl-name
      730                   .
      731                   if v-num-country-city > 0
      732                   then do:
      733                       assign
      734                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      735                       .
      736                   end.
      737                   if v-num-country-city > 1
      738                   then do:
      739                       assign
      740                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      741                       .
      742                   end.
      743                   run fmtcli-concatenate-strings in this-procedure (
      744                         input v-fmtcli-full-addres
      745                       , input v-fmtcli-country
      746                       , input ", ":U
      747                       , input 50
      748                       , output v-fmtcli-full-addres
      749                   ).
      750                   run fmtcli-concatenate-strings in this-procedure (
      751                         input v-fmtcli-full-addres
      752                       , input v-fmtcli-city
      753                       , input ", ":U
      754                       , input 50
      755                       , output v-fmtcli-full-addres
      756                   ).
      757                   run fmtcli-concatenate-strings in this-procedure (
      758                         input v-fmtcli-full-addres
      759                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      760                       , input ", ":U
      761                       , input 50
      762                       , output v-fmtcli-full-addres
      763                   ).
      764                   run fmtcli-concatenate-strings in this-procedure (
      765                         input v-fmtcli-post-addres
      766                       , input v-fmtcli-country
      767                       , input ", ":U
      768                       , input 50
      769                       , output v-fmtcli-post-addres
      770                   ).
      771                   run fmtcli-concatenate-strings in this-procedure (
      772                         input v-fmtcli-post-addres
      773                       , input v-fmtcli-city
      774                       , input ", ":U
      775                       , input 50
      776                       , output v-fmtcli-post-addres
      777                   ).
      778                   run fmtcli-concatenate-strings in this-procedure (
      779                         input v-fmtcli-post-addres
      780                       , input string( buf_firm.ind )
      781                       , input ", ":U
      782                       , input 50
      783                       , output v-fmtcli-post-addres
      784                   ).
      785                   run fmtcli-concatenate-strings in this-procedure (
      786                         input substring( buf_firm.addres1, 1, 50 )
      787                       , input buf_firm.addres2
      788                       , input " ":U
      789                       , input 50
      790                       , output v-temp-fmtcli-address
      791                   ).
      792                   run fmtcli-concatenate-strings in this-procedure (
      793                         input v-temp-fmtcli-address
      794                       , input substring( buf_firm.addres1, 51, 50 )
      795                       , input " ":U
      796                       , input 50
      797                       , output v-temp-fmtcli-address
      798                   ).
      799                   run fmtcli-concatenate-strings in this-procedure (
      800                         input v-temp-fmtcli-address
      801                       , input substring( buf_firm.addres1, 101, 50 )
      802                       , input " ":U
      803                       , input 50
      804                       , output v-temp-fmtcli-address
      805                   ).
      806                   assign
      807                       v-fmtcli-addres = v-temp-fmtcli-address
      808                   .
      809                   if buf_firm.addres1 <> ?
      810                   then do:
      811                       run fmtcli-concatenate-strings in this-procedure (
      812                             input v-fmtcli-full-addres
      813                           , input v-fmtcli-addres
      814                           , input ", ":U
      815                           , input 0
      816                           , output v-fmtcli-full-addres
      817                       ).
      818                   end.
      819                   run fmtcli-concatenate-strings in this-procedure (
      820                         input substring( buf_firm.post-addr1, 1, 50 )
      821                       , input buf_firm.post-addr2
      822                       , input " ":U
      823                       , input 50
      824                       , output v-fmtcli-post-addres
      825                   ).
      826                   run fmtcli-concatenate-strings in this-procedure (
      827                         input v-fmtcli-post-addres
      828                       , input substring( buf_firm.post-addr1, 51, 50 )
      829                       , input " ":U
      830                       , input 50
      831                       , output v-fmtcli-post-addres
      832                   ).
      833                   run fmtcli-concatenate-strings in this-procedure (
      834                         input v-fmtcli-post-addres
      835                       , input substring( buf_firm.post-addr1, 101, 50 )
      836                       , input " ":U
      837                       , input 50
      838                       , output v-fmtcli-post-addres
      839                   ).
      840                   assign
      841                       v-fmtcli-phone         = buf_firm.phone
      842                       v-fmtcli-inn           = buf_firm.inn
      843                       v-fmtcli-kpp           = buf_firm.kpp
      844                       v-fmtcli-okpo          = buf_firm.okpo
      845                       v-fmtcli-index         = string( buf_firm.ind )
      846                   .
      847               end.
      848          end.
      849          when 'маг':U
      850          then do:
      851               find first buf_shop no-lock
      852                    where buf_shop.obj-code = buf_clients.obj-code
      853               .
      854               if available buf_shop
      855               then do:
      856                   run fmtcli-concatenate-strings in this-procedure (
      857                         input buf_shop.addres1
      858                       , input buf_shop.addres2
      859                       , input " ":U
      860                       , input 50
      861                       , output v-fmtcli-addres
      862                   ).
      863                   assign
      864                       v-fmtcli-full-addres = v-fmtcli-addres
      865                       v-fmtcli-post-addres = v-fmtcli-addres
      866                       v-fmtcli-phone       = buf_shop.phone
      867                       v-fmtcli-inn         = "":U
      868                       v-fmtcli-kpp         = "":U
      869                       v-fmtcli-okpo        = "":U
      870                       v-fmtcli-city        = "":U
      871                       v-fmtcli-index       = "":U
      872                   .
      873               end.
      874          end.
      875          when 'скл':U
      876          then do:
      877               find first buf_store no-lock
      878                    where buf_store.obj-code = buf_clients.obj-code
      879               .
      880               if available buf_store
      881               then do:
      882                   run fmtcli-concatenate-strings in this-procedure (
      883                         input buf_store.addres1
      884                       , input buf_store.addres2
      885                       , input " ":U
      886                       , input 50
      887                       , output v-fmtcli-addres
      888                   ).
      889                   assign
      890                       v-fmtcli-full-addres = v-fmtcli-addres
      891                       v-fmtcli-phone       = buf_store.phone
      892                       v-fmtcli-inn         = "":U
      893                       v-fmtcli-kpp         = "":U
      894                       v-fmtcli-okpo        = "":U
      895                       v-fmtcli-city        = "":U
      896                       v-fmtcli-index       = "":U
      897                   .
      898               end.
      899          end.
      900          when 'чел':U
      901          then do:
      902               find first buf_person no-lock
      903                    where buf_person.psn-code = buf_clients.obj-code
      904               .
      905               if available buf_person
      906               then do:
      907                   run fmtcli-concatenate-strings in this-procedure (
      908                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      909                                 then "":U
      910                                 else string( buf_person.ind, "999999")
      911                                 )
      912                       , input buf_person.city
      913                       , input ", ":U
      914                       , input 0
      915                       , output v-fmtcli-full-addres
      916                   ).
      917                   assign
      918                       v-fmtcli-addres = buf_person.address
      919                   .
      920                   run fmtcli-concatenate-strings in this-procedure (
      921                         input v-fmtcli-full-addres
      922                       , input v-fmtcli-addres
      923                       , input ", ":U
      924                       , input 0
      925                       , output v-fmtcli-full-addres
      926                   ).
      927                   assign
      928                       v-fmtcli-phone     = buf_person.phone1
      929                       v-fmtcli-inn       = buf_person.inn
      930                       v-fmtcli-kpp       = buf_person.kpp
      931                       v-fmtcli-okpo      = buf_person.okpo
      932                       v-fmtcli-city      = buf_person.city
      933                       v-fmtcli-index     = string( buf_person.ind )
      934                   .
      935               end.
      936          end.
      937       end case.
      938   end.
      939   end procedure.
      940   procedure fmtcli-concatenate-strings :
      941   define input parameter p-string-1       as character        no-undo.
      942   define input parameter p-string-2       as character        no-undo.
      943   define input parameter p-delimiter      as character        no-undo.
      944   define input parameter p-length         as integer          no-undo.
      945   define output parameter p-out-string    as character        no-undo.
      946   do
      947   on error undo, return error
      948   :
      949       assign
      950           p-out-string = ( if p-string-1 = ?
      951                            then "":U
      952                            else trim( p-string-1 ) )
      953       .
      954       assign
      955           p-out-string = p-out-string
      956                        + ( if p-out-string = "":U
      957                            or length( p-out-string ) = p-length
      958                            or p-string-2 = ?
      959                            or trim( p-string-2 ) = "":U
      960                            then "":U
      961                            else p-delimiter )
      962                        + ( if p-string-2 = ?
      963                            or trim( p-string-2 ) = "":U
      964                            then "":U
      965                            else trim( p-string-2 ) )
      966       .
      967   end.
      968   end procedure.
