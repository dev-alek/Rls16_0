     1497   procedure torgconf-get-self-param :
     1498   define input parameter p-obj-type           as character        no-undo.
     1499   define input parameter p-obj-code           as integer          no-undo.
     1500   define input parameter p-curr-code          as integer          no-undo.
     1501       define variable v-host-code    as integer      no-undo.
     1502       define variable v-par-type     as character    no-undo.
     1503   do
     1504   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1505   :
     1506   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1507   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1508     (input  p-obj-type
     1509     ,input  p-obj-code
     1510     ,output v-host-code
     1511     )  .
     1512       if v-torgconf-outhold = yes
     1513       then do:
     1514           run torgconf-get-holdfirm-code in this-procedure (
     1515                 input p-obj-type
     1516               , input p-obj-code
     1517               , output v-torgconf-self-host-code
     1518           ).
     1519           if v-torgconf-self-host-code = 0
     1520           then do:
     1521               return error.
     1522           end.
     1523       end.
     1524       else do:
     1525           assign
     1526               v-torgconf-self-host-code = v-host-code
     1527           .
     1528       end.
     1529       if v-torgconf-self-host-code = 0
     1530       then do:
     1531           assign
     1532               v-torgconf-self-host-name           = "":U
     1533               v-torgconf-self-host-addres         = "":U
     1534               v-torgconf-self-host-post-addres    = "":U
     1535               v-torgconf-self-host-phone          = "":U
     1536               v-torgconf-self-host-inn            = "":U
     1537               v-torgconf-self-host-kpp            = "":U
     1538               v-torgconf-self-host-okpo           = "":U
     1539               v-torgconf-self-host-egrip-date     = "":U
     1540               v-torgconf-self-host-egrip-num      = "":U
     1541           .
     1542       end.
     1543       else do:
     1544           run fmtcli-get-client in this-procedure (
     1545                 input 'орг':U
     1546               , input v-torgconf-self-host-code
     1547           ).
     1548           assign
     1549               v-torgconf-self-host-name        = v-fmtcli-name
     1550               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1551               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1552               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1553               v-torgconf-self-host-phone       = v-fmtcli-phone
     1554               v-torgconf-self-host-inn         = v-fmtcli-inn
     1555               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1556               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1557           .
     1558           run gbl/clntat-v.p (
     1559                 input 'орг':U
     1560               , input v-torgconf-self-host-code
     1561               , input 'egrip-date':U
     1562               , output v-torgconf-self-host-egrip-date
     1563               , output v-par-type
     1564           ).
     1565           run gbl/clntat-v.p (
     1566                 input 'орг':U
     1567               , input v-torgconf-self-host-code
     1568               , input 'egrip-num':U
     1569               , output v-torgconf-self-host-egrip-num
     1570               , output v-par-type
     1571           ).
     1572           run fmtcli-get-bank in this-procedure (
     1573                 input v-host-code
     1574               , input 'орг':U
     1575               , input v-torgconf-self-host-code
     1576               , input p-curr-code
     1577           ).
     1578       end.
     1579       assign
     1580           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1581           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1582           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1583           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1584           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1585           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1586           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1587           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1588       .
     1589       assign
     1590           v-torgconf-self-obj-type = p-obj-type
     1591           v-torgconf-self-obj-code = p-obj-code
     1592       .
     1593       run fmtcli-get-client in this-procedure (
     1594             input p-obj-type
     1595           , input p-obj-code
     1596       ).
     1597       assign
     1598           v-torgconf-self-obj-name       = v-fmtcli-name
     1599           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1600           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1601           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1602           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1603           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1604           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1605       .
     1606   end.
     1607   end procedure.
     1608   procedure torgconf-get-recepient-param :
     1609   define input parameter torgconfdoc-code   as character                  no-undo.
     1610   define output parameter v-code-rec        as integer                    no-undo .
     1611   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1612   define output parameter v-codefirm-rec    as integer                    no-undo .
     1613   define output parameter v-curcode-rec     as integer                    no-undo .
     1614        define variable  v-recipient-code  as character                  no-undo .
     1615        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1616        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1617   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1618                           input 'Recipient':U ,
     1619                          output v-recipient-code ,
     1620                          output v-trdcattr-type ) no-error .
     1621       if error-status :error then do:
     1622        message
     1623         vss-workfile vss-revision vss-description skip
     1624         "Ошибка при вызове процедуры tdat-val":U skip
     1625         "Документ: " torgconfdoc-code skip
     1626         "Атрибут: " 'Recipient':U skip
     1627         "Значение: " v-recipient skip
     1628         trim( error-status :get-message (1) ) skip
     1629         return-value skip
     1630         view-as alert-box error.
     1631       undo, return error return-value.
     1632       end.
     1633     assign
     1634       v-recipient  = v-recipient-code
     1635       v-type-rec = substring(v-recipient-code,1,3)
     1636       v-code-rec  = int(substring(v-recipient-code,4,15))
     1637       no-error
     1638     .
     1639     if v-type-rec = ? then v-type-rec = "" .
     1640     if v-code-rec  = ? then v-code-rec  =  0 .
     1641     end procedure.
