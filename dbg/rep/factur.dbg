     5820   end.
     5821   procedure clcprtsl_calc-ttable :
     5822   define input parameter paris-doc           as   logical                 no-undo.
     5823   define input parameter paris-cur           as   logical                 no-undo.
     5824   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     5825   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     5826   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     5827   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     5828   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     5829   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     5830   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     5831   define input parameter parr-b              as   character               no-undo.
     5832   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     5833   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     5834   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     5835   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     5836   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     5837   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     5838   define buffer bf_tt-allsum      for tt-allsum.
     5839   define buffer bf_tt-clcparts    for tt-clcparts.
     5840   define buffer bf_tt-allsum-line for tt-allsum-line.
     5841   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     5842   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     5843   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     5844   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     5845   define variable varexcise          like ub.price-list.excise     no-undo.
     5846   do on error undo, return error return-value :
     5847   for each bf_tt-allsum-line
     5848   on error undo, return error return-value
     5849    :
     5850     delete bf_tt-allsum-line.
     5851   end.
     5852   for each bf_tt-allsum
     5853   on error undo, return error return-value
     5854   :
     5855     delete bf_tt-allsum.
     5856   end.
     5857   for each bf_tt-clcparts
     5858   on error undo, return error return-value
     5859   :
     5860   if v-calcbypart then do:
     5861             assign
     5862             parcur-base =   bf_tt-clcparts.part-cur-base
     5863             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     5864             parcur-excise =   bf_tt-clcparts.part-cur-excise
     5865             .
     5866   end.
     5867      run clcprtsl_calc-parts in this-procedure (
     5868        input recid(bf_tt-clcparts),
     5869        input paris-doc,
     5870        input paris-cur,
     5871        input parroad-tax,
     5872        input parexcise,
     5873        input parvat-pc,
     5874        input parcons-vat-pc,
     5875        input parslt-pc,
     5876        input parbase-rate,
     5877        input parbase-scale,
     5878        input parr-b,
     5879        input parcur-base,
     5880        input parcur-road-tax,
     5881        input parcur-excise,
     5882        input parcur-vat-pc,
     5883        input parcurcons-vat-pc,
     5884        input parcurslt-pc
     5885        ) no-error.
     5886     if error-status:error then do:
     5887       message
     5888         vss-workfile vss-revision vss-description skip
     5889         vss-include-info16 skip
     5890         "Ошибка при обсчете партии" skip
     5891         "Документ партии " bf_tt-clcparts.out-code skip
     5892         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     5893         return-value skip
     5894         error-status:get-message(1) skip
     5895         error-status:get-message(2) skip
     5896         error-status:get-message(3) skip
     5897         view-as alert-box error .
     5898       undo, return error .
     5899     end.
     5900     for each bf_tt-allsum on error undo, return error return-value :
     5901       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     5902       if not available bf_tt-allsum-line then do:
     5903         create bf_tt-allsum-line.
     5904         assign
     5905           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     5906       end.
     5907       assign
     5908         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     5909         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     5910         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     5911         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     5912         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     5913         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     5914         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     5915         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     5916         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     5917         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     5918         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     5919         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     5920         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     5921         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     5922         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
