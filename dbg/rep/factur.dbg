      481       define buffer   in-vatp-sysconfo  for ub.sysconf .
      482       define buffer   in-vatp_doc-attro for ub.doc-attr.
      483       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
      484       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
      485       define variable varinvprbo                  as   character              no-undo.
      486       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
      487       define variable cli-base-rateo              as   decimal                no-undo.
      488       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
      489       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      490       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      491       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      492       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      493       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      494       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      495       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      496       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      497       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      498       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      499       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      500       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      501       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      502       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      503       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      504       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      505       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      506       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      507       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
