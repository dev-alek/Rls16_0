      468       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
      469       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
      470       define variable varis-one-gds-dtl        as   logical                             no-undo.
      471       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
      472       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
      473       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
      474       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
      475       define variable varoutvprb               as   character                           no-undo.
      476       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
      477       define buffer   in-vatp-trn-doco  for ub.trn-doc .
      478       define buffer   in-vatp-partso    for ub.parts   .
      479       define buffer   in-vatp-doco      for ub.trn-doc .
