     9257   end.
     9258   assign
     9259   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     9260   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     9261             assign
     9262                v-VAT       = ( if PrintRubl then vat-rubl-buyer        else vat-base-buyer )
     9263                v-SLT       = ( if PrintRubl then slt-rubl-sale         else slt-base-sale )
     9264                v-tax-price = ( if PrintRubl then road-tax-rubl-sale    else road-tax-base-sale )
     9265             .
     9266             if v-VAT = ?        then assign v-VAT       = 0.
     9267             if v-SLT = ?        then assign v-SLT       = 0.
     9268             if v-tax-price = ?  then assign v-tax-price = 0.
     9269             assign
     9270                v-price-no-VAT = ( if PrintRubl
     9271                                      then price-rubl-with-tax-sale
     9272                                      else price-base-with-tax-sale ) - v-VAT - v-SLT - v-tax-price
     9273             .
     9274          end.
     9275          if p-round = 'round':U
     9276          then do:
     9277             run p-fmt-round in this-procedure (
     9278                     input v-qnty
     9279                   , input v-price-no-VAT
     9280                   , input v-VAT
     9281                   , input v-SLT
     9282                   , input v-tax-price
