     8551       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     8552       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     8553       transport-cli-loco  = 0
     8554       other-cli-loco      = 0
     8555     .
     8556   ASSIGN
