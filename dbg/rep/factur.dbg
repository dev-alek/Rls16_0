     8501                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     8502                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     8503                                  and out-vatp_parts.artic      = doc-line.artic
     8504                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     8505                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
