     8458     (output varoutvprb
     8459     )  .
     8460   if varoutvprb = "base":u then do:
     8461     assign
     8462           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     8463       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
