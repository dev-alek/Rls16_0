     3508            find first buf_sysconf no-lock
     3509            where buf_sysconf.host-code = v-torgconf-self-host-code
     3510            no-error.
     3511            if available buf_sysconf
     3512            then do:
     3513               assign
     3514                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3515               .
     3516            end.
     3517            find first buf_clients no-lock
     3518            where buf_clients.obj-type = 'орг':U
     3519            and buf_clients.obj-code = v-torgconf-self-host-code
     3520            .
     3521            find first buf_firm no-lock
     3522            where buf_firm.firm-code = buf_clients.obj-code
     3523            no-error.
