     1181   procedure wthcattr-sprcli :
     1182   define input parameter parparentproc  as widget-handle no-undo.
     1183   define input parameter p-mode  as character no-undo.
     1184   define input-output parameter p-value as character no-undo .
     1185   define output parameter p-setted as logical no-undo .
     1186     DEFINE VARIABLE v-value as character no-undo .
     1187     define variable v-cli-type as character no-undo .
     1188     define variable v-cli-code as integer no-undo .
     1189     define buffer buf_clients   for ub.clients.
     1190     define variable v_rid as character no-undo.
     1191     define variable ref-rec as recid no-undo .
     1192     do
     1193     on error undo, return error
     1194     :
     1195         v-value = p-value.
     1196      if p-value <> '':U then do:
     1197       assign
     1198       v-cli-type = substring(p-value, 1, 3)
     1199       v-cli-code = integer(substring(p-value, 4))
     1200       no-error.
     1201       if error-status:error then do:
     1202         assign
     1203         v-cli-type = '':U
     1204         v-cli-code = 0
     1205         .
     1206       end.
     1207      end.
     1208      FIND FIRST buf_clients NO-LOCK WHERE
     1209               buf_clients.obj-type = v-cli-type AND
     1210               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1211      IF available(buf_clients) then do:
     1212       run ref/cli-all.w (
     1213                   input parparentproc
     1214                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1215                  ,input v-cli-type
     1216                  ,input 'все':U
     1217                  ,input 'все':U
     1218                  ,input RECID( buf_clients )
     1219                  ,input ",,,,,,NO"
     1220                  ,input ?
     1221                  ,OUTPUT v_rid ).
     1222     END.
     1223     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1224       run ref/cli-all.w (
     1225                    input parparentproc
     1226                   ,INPUT "b-sel":U
     1227                  ,input  v-cli-type
     1228                  ,input 'все':U
     1229                  ,input 'текущие':U
     1230                  ,input ?
     1231                  ,input ",,,,,,NO"
     1232                  ,input ?
     1233                  ,OUTPUT v_rid ).
     1234     END.
     1235     else do:
     1236       message
     1237       if p-value = "":U then 'Атрибут не задан!'
     1238       else substitute('Не найден клиент &1',p-value)
     1239       view-as alert-box warning.
     1240     end.
     1241     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1242       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1243       IF ERROR-STATUS:ERROR THEN DO:
     1244           RETURN NO-APPLY.
     1245       END.
     1246       FIND FIRST buf_clients NO-LOCK WHERE
     1247                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1248       IF AVAIL buf_clients THEN DO:
     1249         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1250       end.
     1251     end.
     1252     if v-value <> p-value then do:
     1253       p-value = v-value.
     1254       p-setted = yes.
     1255     end.
     1256     end.
     1257   end procedure.
     1258     define new global shared variable g#wthcalib as handle no-undo.
     1259   procedure torgconf-read :
     1260   do
     1261   on error undo, return error
     1262   :
     1263       define input parameter p-form-name  as character    no-undo.
     1264       define input parameter p-host-code  as integer      no-undo.
     1265       define input parameter p-obj-type   as character    no-undo.
     1266       define input parameter p-obj-code   as integer      no-undo.
     1267       define variable v-outdate   as character     no-undo.
     1268       define variable v-outares   as character     no-undo.
     1269       define variable v-outsend   as character     no-undo.
     1270       define variable v-outasend  as character     no-undo.
     1271       define variable v-outprops  as character     no-undo.
     1272       define variable v-outnum    as character     no-undo.
     1273       define variable v-outprim   as character     no-undo.
     1274       define variable v-outdisc   as character     no-undo.
     1275       define variable v-outsubs   as character     no-undo.
     1276       define variable v-outrecv   as character     no-undo.
