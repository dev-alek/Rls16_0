     8576       varprice-base-cons = 0.
     8577   end.
     8578   if varprice-rubl-cons = ? then do:
     8579     assign
     8580       varprice-rubl-cons = 0.
     8581   end.
     8582   assign
     8583       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8584     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8585     discnt-base-sale            = gds-dtl.discnt-base
     8586     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     8587       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8588     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8589     discnt-rubl-sale            = gds-dtl.discnt-rubl
     8590     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     8591     .
     8592   if buf_trn-doc.doc-type = 'инв':U then do:
     8593     assign
     8594       varfact-qnty = gds-dtl.doc-qnty.
     8595   end.
     8596   else do:
     8597     assign
     8598       varfact-qnty = gds-dtl.fact-qnty.
     8599   end.
     8600   if varis-cons-parts-have = no then do:
     8601     assign
     8602           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8603           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     8604   end.
     8605   else do:
     8606     if buf_trn-doc.doc-type = 'инв':U then do:
     8607       assign
     8608               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8609               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8610        .
     8611     end.
     8612     else do:
     8613       assign
     8614               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8615               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8616        .
     8617     end.
     8618   end.
     8619   assign
     8620   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8621   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8622                 assign
     8623                    v-VAT = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     8624                    v-SLT = ( if PrintRubl then slt-rubl-sale else slt-base-sale )
     8625                 .
     8626                 if v-VAT = ? then assign v-VAT = 0.
     8627                 if v-SLT = ? then assign v-SLT = 0.
     8628                 assign
     8629                    v-price-no-VAT   = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale ) - v-VAT - v-SLT
     8630                    v-prt-qnty       = gds-dtl.fact-qnty
     8631                 .
     8632                 if p-round = 'round':U
     8633                 then do:
     8634                    run p-fmt-round in this-procedure (
     8635                             input v-prt-qnty
     8636                           , input v-price-no-VAT
     8637                           , input v-VAT
     8638                           , input v-SLT
     8639                           , input v-void-decimal
     8640                           , output v-price-no-VAT
     8641                           , output v-VAT
     8642                           , output v-SLT
     8643                           , output v-prt-VAT
     8644                           , output v-prt-SLT
     8645                           , output v-void-decimal
     8646                           , output v-prt-sum-no-VAT
     8647                           , output v-void-decimal
     8648                       ).
     8649                 end.
     8650                 else do:
     8651                    assign
     8652                       v-prt-VAT        = v-VAT          * v-prt-qnty
     8653                       v-prt-SLT        = v-SLT          * v-prt-qnty
     8654                       v-prt-sum-no-VAT = v-price-no-VAT * v-prt-qnty
     8655                    .
     8656                 end.
     8657                 assign
     8658                    v-price          = v-price-no-VAT + v-VAT
     8659                    v-prt-sum        = v-prt-sum-no-VAT + v-prt-VAT
     8660                 .
     8661                 assign
     8662                    v-tot-prt-qnty          = v-tot-prt-qnty        + v-prt-qnty
     8663                    v-tot-prt-VAT           = v-tot-prt-VAT         + v-prt-VAT
     8664                    v-tot-prt-SLT           = v-tot-prt-SLT         + v-prt-SLT
     8665                    v-tot-prt-sum-no-VAT    = v-tot-prt-sum-no-VAT  + v-prt-sum-no-VAT
     8666                    v-tot-prt-sum           = v-tot-prt-sum         + v-prt-sum
     8667                 .
     8668              end.
     8669              if PrintScale
     8670              then do:
     8671                 find first bar-code no-lock
     8672                      where bar-code.gds-code    = buf_goods.gds-code
     8673                        and bar-code.unit-cli    = buf_goods.unit-base
     8674                        and bar-code.node-code   = gds-dtl.prt-code
     8675                        and bar-code.part-code   = ""
     8676                        and bar-code.in-code     = ""
     8677                 .
     8678                 assign
     8679                    v-prt-name = ""
     8680                 .
     8681                 do while available gds-prt:
     8682                    if available gds-prt
     8683                    then do:
     8684                       assign
     8685                          v-prt-name     = "\" + string( gds-prt.node-name, "X(10)" ) + v-prt-name
     8686                          v-node-code   = gds-prt.upper-code
     8687                       .
     8688                    end.
     8689                    find first gds-prt no-lock
     8690                         where gds-prt.node-code = v-node-code
     8691                           and gds-prt.root <> yes
     8692                    no-error.
     8693                 end.
     8694                 if lookup( "dec10", p-mode ) <> 0
     8695                 THEN DO:
     8696                    display stream out-stream
     8697                           v-prt-name                 @ buf_goods.gds-name
     8698                           sym2 "  -   " @ v-uaes-code
     8699                           sym16 v-unit-code
     8700                           sym14 "  " + buf_goods.unit-base
     8701                           sym3 v-prt-qnty                     @ v-qnty
     8702                           sym4 v-price-no-VAT
     8703                           sym5 v-prt-sum-no-VAT               @ v-sum-no-VAT
     8704                           sym6 "без акциза" format "x(10)"         @ v-sum-actciz
     8705                           sym7 v-VAT-prc
     8706                           sym8 v-prt-VAT when v-prt-qnty <> 0 @ v-VAT
     8707                           sym9 v-prt-sum                      @ v-sum
     8708                           sym11 sym15 sym12
     8709                           with frame factur-10 .
     8710                    assign v-lines-counter = v-lines-counter + 1 .
     8711                    down stream out-stream 1 with frame factur-10 .
     8712                 END.
     8713                 ELSE DO:
     8714                    display stream out-stream
     8715                           sym1 v-prt-name                     @ buf_goods.gds-name
     8716                           sym2 "  -   " @ v-uaes-code
     8717                           sym16 v-unit-code
     8718                           sym14 "  " + buf_goods.unit-base
     8719                           sym3 v-prt-qnty                     @ v-qnty
     8720                           sym4 v-price-no-VAT
     8721                           sym5 v-prt-sum-no-VAT               @ v-sum-no-VAT
     8722                           sym6 "без акциза" format "x(10)"         @ v-sum-actciz
     8723                           sym7 v-VAT-prc
     8724                           sym8 v-prt-VAT when v-prt-qnty <> 0 @ v-VAT
     8725                           sym9 v-prt-sum                      @ v-sum
     8726                           sym11 sym15 sym12 sym13
     8727                           with frame factur .
     8728                     assign v-lines-counter = v-lines-counter + 1 .
     8729                     down stream out-stream 1 with frame factur .
     8730                 END.
     8731                 run facturxl-write-line-data in this-procedure (
     8732                         input v-prt-name
     8733                       , input v-uaes-code
     8734                       , input v-unit-code
     8735                       , input buf_goods.unit-base
     8736                       , input string( v-prt-qnty )
     8737                       , input string( v-price-no-VAT )
     8738                       , input string( v-prt-sum-no-VAT )
     8739                       , input "без акциза":U
     8740                       , input string( v-VAT-prc )
     8741                       , input string( v-prt-VAT )
     8742                       , input string( v-prt-sum )
     8743                       , input "":U
     8744                       , input "":U
     8745                       , input "":U
     8746                   ).
     8747              end.
     8748           end.
     8749           assign
     8750               v-qnty          = v-tot-prt-qnty
     8751               v-VAT           = v-tot-prt-VAT
     8752               v-SLT           = v-tot-prt-SLT
     8753               v-sum-no-VAT    = v-tot-prt-sum-no-VAT
     8754               v-sum           = v-tot-prt-sum
     8755           .
     8756           if not PrintScale
     8757           then do:
     8758              assign v-price-no-VAT = v-sum-no-VAT / v-qnty.
     8759              find first bar-code no-lock
     8760                   where bar-code.gds-code = buf_goods.gds-code
     8761                     and bar-code.unit-cli   = buf_goods.unit-base
     8762                     and bar-code.node-code  = rootnode_code
     8763                     and bar-code.part-code  = ""
     8764                     and bar-code.in-code    = ""
     8765              .
     8766              for each parts no-lock
     8767                   where parts.out-code    = doc-line.doc-code
     8768                     and parts.obj-type  = doc-line.obj-type
     8769                      and parts.obj-code  = doc-line.obj-code
     8770                      and parts.artic     = doc-line.artic
     8771                      and parts.prod-type = doc-line.prod-type
     8772                      and parts.prod-code = doc-line.prod-code
     8773              :
     8774                 assign v-GTD = parts.cst-code.
     8775                 if available country
     8776                    and country.alpha1 = "RU":U
     8777                 then do:
     8778                    assign
     8779                       v-GTD       = "":U
     8780                       v-country-code = "":U
     8781                       v-country   = "":U
     8782                    .
     8783                 end.
     8784                 find first buf_parts-attr no-lock
     8785                      where buf_parts-attr.in-code   = parts.in-code
     8786                        and buf_parts-attr.gds-code  = goods.gds-code
     8787                        and buf_parts-attr.part-code = parts.part-code
     8788                 no-error .
     8789                 if available buf_parts-attr
     8790                    and buf_parts-attr.country-code <> 0
     8791                 then do:
     8792                    find first buf_country
     8793                         where buf_country.num-code = buf_parts-attr.country-code
     8794                    no-error.
     8795                    if available buf_country
     8796                       and buf_country.num-code <> country.num-code
     8797                       and buf_country.short-name <> ""
     8798                    then do :
     8799                       assign
     8800                          v-country-code = " " + string(buf_country.num-code)
     8801                          v-country = buf_country.short-name
     8802                       .
     8803                       if buf_country.alpha1 = "RU":U
     8804                       then do :
     8805                          assign
     8806                             v-country-code = "":U
     8807                             v-country = "":U
     8808                             v-GTD     = "":U
     8809                          .
     8810                       end .
     8811                    end.
     8812                 end.
     8813                 if lookup( "dec10", p-mode ) <> 0
     8814                 THEN DO:
     8815                    display stream Out-stream
     8816                               ((if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "") + buf_goods.gds-name)      @ buf_goods.gds-name
     8817                               sym2 "  -   " @ v-uaes-code
     8818                               sym16 v-unit-code
     8819                               sym14 "  " + buf_goods.unit-base
     8820                               sym3 parts.fact-qnty                                                       @ v-qnty
     8821                               sym4 v-price-no-VAT
     8822                               sym5 (if v-qnty <> 0 then v-sum-no-VAT * parts.fact-qnty / v-qnty else 0 ) @ v-sum-no-VAT
     8823                               sym6 "без акциза" format "x(10)"                                             @ v-sum-actciz
     8824                               sym7 v-VAT-prc
     8825                               sym8 v-VAT * parts.fact-qnty / v-qnty when v-qnty <> 0                     @ v-VAT
     8826                               sym9 (if v-qnty <> 0 then v-sum * parts.fact-qnty / v-qnty else 0 )        @ v-sum
     8827                               sym11 v-country-code
     8828                               sym15 v-country
     8829                               sym12 v-GTD
     8830                               with frame factur-10 .
     8831                    down stream Out-stream 1 with frame factur-10 .
     8832                 END.
     8833                 ELSE DO:
     8834                    display stream Out-stream
     8835                                sym1 ((if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "") + buf_goods.gds-name)          @ buf_goods.gds-name
     8836                               sym2 "  -   " @ v-uaes-code
     8837                               sym16 v-unit-code
     8838                               sym14 "  " + buf_goods.unit-base
     8839                               sym3 parts.fact-qnty                                                       @ v-qnty
     8840                               sym4 v-price-no-VAT
     8841                               sym5 (if v-qnty <> 0 then v-sum-no-VAT * parts.fact-qnty / v-qnty else 0 ) @ v-sum-no-VAT
     8842                               sym6 "без акциза" format "x(10)" @ v-sum-actciz
     8843                               sym7 v-VAT-prc
     8844                               sym8 v-VAT * parts.fact-qnty / v-qnty when v-qnty <> 0                     @ v-VAT
     8845                               sym9 (if v-qnty <> 0 then v-sum * parts.fact-qnty / v-qnty else 0 )        @ v-sum
     8846                               sym11 v-country-code
     8847                               sym15 v-country
     8848                               sym12 v-GTD
     8849                               sym13
     8850                               with frame factur .
     8851                    down stream Out-stream 1 with frame factur .
     8852                 END.
     8853                 run facturxl-write-line-data in this-procedure (
     8854                             input (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "") + buf_goods.gds-name
     8855                           , input v-uaes-code
     8856                           , input v-unit-code
     8857                           , input buf_goods.unit-base
     8858                           , input string( parts.fact-qnty )
     8859                           , input string( v-price-no-VAT )
     8860                           , input (if v-qnty <> 0 then v-sum-no-VAT * parts.fact-qnty / v-qnty else 0 )
     8861                           , input " без акциза":U
     8862                           , input string( v-VAT-prc )
     8863                           , input ( if v-qnty = 0 then "":U else string( v-VAT * parts.fact-qnty / v-qnty ) )
     8864                           , input string( if v-qnty <> 0 then v-sum * parts.fact-qnty / v-qnty else 0 )
     8865                           , input v-country-code
     8866                           , input v-country
     8867                           , input v-GTD
     8868                       ).
     8869                 v-lines-counter = v-lines-counter + 1 .
     8870              end.
     8871           end.
     8872       end.
     8873       else do:
     8874          find first bar-code no-lock
     8875                  where bar-code.gds-code = buf_goods.gds-code
     8876                   and bar-code.unit-cli   = buf_goods.unit-base
     8877                   and bar-code.node-code  = rootnode_code
     8878                   and bar-code.part-code  = ""
     8879                   and bar-code.in-code    = ""
     8880          .
     8881          if CostPrice = yes
     8882          then do:
     8883             assign v-qnty = doc-line.doc-qnty.
     8884   assign
     8885     price-rubl-with-tax-loc = doc-line.price-rubl
     8886     price-base-with-tax-loc = doc-line.price-base
     8887   .
     8888   define variable vss-include-info49 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8889   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8890     (output varinvprb
     8891     )  .
     8892      find first in-vatp_doc-attr no-lock
     8893       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     8894         and in-vatp_doc-attr.attr-code = 'envd':U
     8895       no-error .
     8896       if available in-vatp_doc-attr
     8897          then do:
     8898          assign
     8899            in-vatp-have-vat-slt = no.
     8900      end.
     8901      else do:
     8902        assign
     8903          in-vatp-have-vat-slt = yes.
     8904      end.
     8905      find first in-vatp-goods where in-vatp-goods.artic     = doc-line.artic     and
     8906                                        in-vatp-goods.prod-type = doc-line.prod-type and
     8907                                        in-vatp-goods.prod-code = doc-line.prod-code no-lock.
     8908      if (not buf_trn-doc.internal and
     8909              buf_trn-doc.doc-type = 'при':U) or
     8910         in-vatp-goods.gds-type = 'у':U then do:
     8911         if varinvprb = "base":u then do:
     8912           assign
     8913             road-tax-base-loc = doc-line.road-tax
     8914             road-tax-rubl-loc = doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     8915         end.
     8916         else do:
     8917           ASSIGN
     8918             road-tax-rubl-loc = doc-line.road-tax
