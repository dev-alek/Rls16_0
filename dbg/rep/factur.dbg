     9397                   assign
     9398                      v-GTD       = "":U
     9399                      v-country-code   = "":U
     9400                      v-country   = "":U
     9401                   .
     9402                end.
     9403                find first buf_parts-attr no-lock
     9404                     where buf_parts-attr.in-code   = parts.in-code
     9405                       and buf_parts-attr.gds-code  = goods.gds-code
     9406                       and buf_parts-attr.part-code = parts.part-code
     9407                no-error .
