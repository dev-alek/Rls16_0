     3921   procedure torgconf-get-reason  :
     3922   define input parameter  p-doc-code       as character        no-undo.
     3923   define input parameter  p-reason-code    as integer          no-undo .
     3924   define input parameter  p-doc-type       as character        no-undo.
     3925       if p-reason-code > 0
     3926       then do:
     3927           define buffer buf_trn-reason for ub.trn-reason.
     3928           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3929           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3930       end.
     3931       else do:
     3932           if p-doc-type = 'при':U
     3933           then  do:
     3934               define variable v-attr-type     as character    no-undo.
     3935               define variable v-attr-value    as character    no-undo.
     3936               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3937               assign v-torgconf-reason = v-attr-value .
     3938               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3939               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3940           end.
     3941       end.
     3942   end procedure.
     3943   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3944   define new global shared variable g#lib-trn  as handle no-undo .
