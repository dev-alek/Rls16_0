      463       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      464       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      465       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      466       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
