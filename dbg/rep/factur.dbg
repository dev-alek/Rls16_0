     3407                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3408                                                   , ( if p-status_ <> 'факт':U
     3409                                                      then string( "(" + caps( p-status_ ) + ")" )
     3410                                                      else "":U )
     3411                                                )
     3412               .
     3413            end.
     3414            else do:
     3415            if trim(v-attr) = ""
     3416            then do:
     3417               assign
     3418                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3419                                                           v-torgconf-doc-code,
     3420                                                           v-torgconf-doc-date,
     3421                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3422                                                           )
     3423               .
     3424            end.
     3425            else do:
     3426               assign
     3427                  v-torgconf-plat-rasch-doc = v-attr.
     3428            end.
     3429            end.
     3430        end.
     3431        otherwise do:
     3432            if  v-name <> 'wthtrg12'
     3433            and v-name <> 'wthfct'
     3434            and v-name <> 'wthm11'
     3435            then do:
     3436               IF v-dcode-attr <> "":U
     3437               OR v-ddate-attr <> "":U
     3438               THEN
     3439               assign
     3440                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3441                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3442                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3443                                                   )
     3444               .
     3445            end.
     3446            else do:
     3447               assign
     3448                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3449               .
     3450            end.
     3451        end.
     3452       end case.
     3453      if v-torgconf-outB = "no_print"
     3454      then do:
     3455         assign v-torgconf-main-buh = "".
     3456      end.
     3457      if v-torgconf-outB = "glbuh_firm"
     3458      then do:
     3459            if v-torgconf-self-host-code = 0
     3460            then do:
     3461            end.
     3462            else do:
     3463               find first buf_sysconf no-lock
     3464                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3465               .
     3466               assign
     3467                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3468               .
     3469            end.
     3470      end.
     3471      if v-torgconf-outB = "buh_obj"
     3472      then do:
     3473         CASE v-torgconf-self-obj-type:
     3474         WHEN 'маг':U
