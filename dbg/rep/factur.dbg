     1837   procedure torgconf-get-sup-param :
     1838   define input parameter p-obj-type           as character        no-undo.
     1839   define input parameter p-obj-code           as integer          no-undo.
     1840   define input parameter p-curr-code          as integer          no-undo.
     1841       define variable v-host-code    as integer      no-undo.
     1842       define variable v-par-type     as character    no-undo.
     1843   do
     1844   on error undo, return error
     1845   :
     1846       assign
     1847          v-torgconf-sup-host-code = v-host-code
     1848       .
     1849       if v-torgconf-sup-host-code = 0
     1850       then do:
     1851           assign
     1852               v-torgconf-sup-host-name           = "":U
     1853               v-torgconf-sup-host-addres         = "":U
     1854               v-torgconf-sup-host-post-addres    = "":U
     1855               v-torgconf-sup-host-phone          = "":U
     1856               v-torgconf-sup-host-inn            = "":U
     1857               v-torgconf-sup-host-kpp            = "":U
     1858               v-torgconf-sup-host-okpo           = "":U
     1859               v-torgconf-sup-host-egrip-date     = "":U
     1860               v-torgconf-sup-host-egrip-num      = "":U
     1861           .
     1862       end.
     1863       else do:
     1864           run fmtcli-get-client in this-procedure (
     1865                 input 'орг':U
     1866               , input v-torgconf-sup-host-code
     1867           ).
     1868           assign
     1869               v-torgconf-sup-host-name        = v-fmtcli-name
     1870               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1871               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1872               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1873               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1874               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1875               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1876               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1877           .
     1878           run gbl/clntat-v.p (
     1879                 input 'орг':U
     1880               , input v-torgconf-sup-host-code
     1881               , input 'egrip-date':U
     1882               , output v-torgconf-sup-host-egrip-date
     1883               , output v-par-type
     1884           ).
     1885           run gbl/clntat-v.p (
     1886                 input 'орг':U
     1887               , input v-torgconf-sup-host-code
     1888               , input 'egrip-num':U
     1889               , output v-torgconf-sup-host-egrip-num
     1890               , output v-par-type
     1891           ).
     1892           run fmtcli-get-bank in this-procedure (
     1893                 input v-host-code
     1894               , input 'орг':U
     1895               , input v-torgconf-sup-host-code
     1896               , input p-curr-code
     1897           ).
     1898       end.
     1899       assign
     1900           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1901           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1902           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1903           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1904           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1905           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1906           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1907           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1908       .
     1909       assign
     1910           v-torgconf-sup-obj-type = p-obj-type
     1911           v-torgconf-sup-obj-code = p-obj-code
     1912       .
     1913       if trim(p-obj-type) <> ""
     1914       and p-obj-code <> 0
     1915       then do:
     1916       run fmtcli-get-client in this-procedure (
     1917             input p-obj-type
     1918           , input p-obj-code
     1919       ).
     1920       assign
     1921           v-torgconf-sup-obj-name        = v-fmtcli-name
     1922           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1923           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1924           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1925           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1926           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1927           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1928       .
     1929      end.
     1930      end.
     1931   end procedure.
     1932   procedure torgconf-get-cli-param :
     1933   define input parameter p-host-obj-code      as integer          no-undo.
     1934   define input parameter p-obj-type           as character        no-undo.
     1935   define input parameter p-obj-code           as integer          no-undo.
     1936   define input parameter p-curr-code          as integer          no-undo.
     1937       define variable v-host-code    as integer      no-undo.
     1938   do
     1939   on error undo, return error
     1940   :
     1941       assign
     1942           v-torgconf-cli-type = p-obj-type
     1943           v-torgconf-cli-code = p-obj-code
     1944       .
     1945       run fmtcli-get-client in this-procedure (
     1946             input p-obj-type
     1947           , input p-obj-code
     1948       ).
     1949       assign
     1950           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1951           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1952           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1953           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1954           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1955           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1956           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1957           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1958       .
     1959      run fmtcli-get-bank in this-procedure (
     1960             input p-host-obj-code
     1961           , input p-obj-type
     1962           , input p-obj-code
     1963           , input p-curr-code
     1964       ).
     1965       assign
     1966           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1967           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1968           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1969           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1970           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1971           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1972           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1973           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1974       .
     1975   end.
     1976   end procedure.
     1977   procedure torgconf-get-ship-param :
     1978   define input parameter p-host-obj-code      as integer          no-undo.
     1979   define input parameter p-obj-type           as character        no-undo.
     1980   define input parameter p-obj-code           as integer          no-undo.
     1981   define input parameter p-curr-code          as integer          no-undo.
     1982       define variable v-host-code    as integer      no-undo.
     1983   do
     1984   on error undo, return error
     1985   :
     1986       assign
     1987           v-torgconf-ship-type = p-obj-type
     1988           v-torgconf-ship-code = p-obj-code
     1989       .
     1990       if trim(p-obj-type) = ""
     1991       and p-obj-code = 0
     1992       then do:
     1993       assign
     1994           v-torgconf-ship-name         = "":U
     1995           v-torgconf-ship-addres       = "":U
     1996           v-torgconf-ship-post-addres  = "":U
     1997           v-torgconf-ship-phone        = "":U
     1998           v-torgconf-ship-inn          = "":U
     1999           v-torgconf-ship-kpp          = "":U
     2000           v-torgconf-ship-okpo         = "":U
     2001       .
     2002       end.
     2003       else do:
     2004       run fmtcli-get-client in this-procedure (
     2005             input p-obj-type
     2006           , input p-obj-code
     2007       ).
     2008       assign
     2009           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     2010           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     2011           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     2012           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     2013           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     2014           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     2015           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     2016           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     2017       .
     2018       end.
     2019           run fmtcli-get-bank in this-procedure (
     2020             input p-host-obj-code
     2021           , input p-obj-type
     2022           , input p-obj-code
     2023           , input p-curr-code
     2024       ).
     2025       assign
     2026           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     2027           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     2028           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     2029           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     2030           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     2031           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     2032           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2033           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2034       .
     2035   end.
     2036   end procedure.
     2037   procedure torgconf-get-holdfirm-code :
     2038   define input parameter p-obj-type   as character        no-undo.
     2039   define input parameter p-obj-code   as integer          no-undo.
     2040   define output parameter p-firm-code as integer          no-undo.
     2041       define variable v-firm-code-str     as character    no-undo.
     2042       define variable v-par-type          as character    no-undo.
     2043       define buffer buf_clients       for ub.clients.
     2044   do
     2045   for buf_clients
     2046   on error undo, return error
     2047   :
     2048       run gbl/clntat-v.p (
     2049             input p-obj-type
     2050           , input p-obj-code
     2051           , input 'holdfirm-code':U
     2052           , output v-firm-code-str
     2053           , output v-par-type
     2054       ).
     2055       assign
     2056           p-firm-code = integer( v-firm-code-str )
     2057       no-error.
     2058       if error-status :error
     2059       then do:
     2060           message
     2061               "Неверно задан код фирмы для печати накладных."
     2062           view-as alert-box warning.
     2063           assign
     2064               p-firm-code = 0
     2065           .
     2066       end.
     2067       else do:
     2068           find first buf_clients no-lock
     2069                where buf_clients.obj-type = 'орг':U
     2070                  and buf_clients.obj-code = p-firm-code
     2071           no-error.
     2072           if not available buf_clients
     2073           then do:
     2074               message
     2075                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2076                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2077               view-as alert-box warning.
     2078               assign
     2079                   p-firm-code = 0
     2080               .
     2081           end.
     2082       end.
     2083   end.
     2084   end procedure.
     2085   procedure torgconf-get-post-head:
     2086   define input  parameter p-obj-type             as character        no-undo.
     2087   define input  parameter p-obj-code             as integer          no-undo.
     2088   define output parameter p-torgconf-post-head   as character        no-undo.
     2089      define variable v-host-code         as integer      no-undo.
     2090      define buffer buf_sysconf     for ub.sysconf.
     2091        assign
     2092         p-torgconf-post-head  = ""
     2093        .
     2094   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2095   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2096     (input  p-obj-type
     2097     ,input  p-obj-code
     2098     ,output v-host-code
     2099     )  .
     2100      find first buf_sysconf no-lock
     2101      where buf_sysconf.host-code = v-host-code
     2102      no-error.
     2103      if available buf_sysconf
     2104      then do:
     2105         assign
     2106            p-torgconf-post-head = buf_sysconf.head-position
     2107         .
     2108      end.
     2109   end procedure.
     2110   procedure torgconf-get-storekeeper:
     2111   define input  parameter p-wrkr                   as integer          no-undo.
     2112   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2113   define output parameter p-torgconf-post          as character        no-undo.
     2114      define buffer buf_sysconf     for ub.sysconf.
     2115      define buffer buf_person      for ub.person.
     2116      define buffer buf_shop        for ub.shop .
     2117      define buffer buf_store       for ub.store .
     2118      if v-torgconf-outC = "no_print"
     2119      then do:
     2120         assign p-torgconf-post = ""
     2121                p-torgconf-wrkr-name = ""
     2122                .
     2123      end.
     2124      if v-torgconf-outC = "clad_doc"
     2125      then do:
     2126         run rep/get-psn.p
     2127               (input  p-wrkr
     2128               ,output p-torgconf-wrkr-name
     2129               ) .
     2130         find first buf_person no-lock
     2131         where buf_person.psn-code = p-wrkr
     2132         no-error.
     2133         if available buf_person
     2134         then do:
     2135           p-torgconf-post = buf_person.position.
     2136         end.
     2137         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2138         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2139      end.
     2140      if v-torgconf-outC = "clad_obj"
     2141      then do:
     2142         CASE v-torgconf-self-obj-type:
     2143         WHEN 'маг':U
     2144         THEN DO:
     2145            find first buf_shop no-lock
     2146            where buf_shop.obj-code = v-torgconf-self-obj-code
     2147            .
     2148            assign
     2149               p-torgconf-wrkr-name = buf_shop.store-man
     2150               p-torgconf-post = ""
     2151            .
     2152            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2153         END.
     2154         WHEN 'скл':U
     2155         THEN DO:
     2156            find first buf_store no-lock
     2157            where buf_store.obj-code = v-torgconf-self-obj-code
     2158            .
     2159            assign
     2160               p-torgconf-wrkr-name = buf_store.store-man
     2161               p-torgconf-post = ""
     2162            .
     2163            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2164         END.
     2165         OTHERWISE DO:
     2166            assign
     2167               p-torgconf-post = "":U
     2168               p-torgconf-wrkr-name = "":U
     2169            .
     2170         END.
     2171         END CASE.
     2172      end.
     2173    end procedure.
     2174   procedure torgconf-get-form-header :
     2175   define input parameter p-for-inverse    as logical          no-undo.
     2176   define input parameter p-doc-code       as character        no-undo.
     2177   define input parameter p-print-doc      as logical          no-undo.
     2178   define input parameter p-doc-date       as date             no-undo.
     2179   define input parameter p-fact-date      as date             no-undo.
     2180   define input parameter p-doc-type       as character        no-undo.
     2181   define input parameter p-status_        as character        no-undo.
     2182   define input parameter p-reverse        as logical          no-undo.
     2183   define input parameter p-sf-par         as logical          no-undo.
     2184       define variable v-attr-type         as character    no-undo.
     2185       define variable v-doc-code-standard as logical      no-undo.
     2186       define variable v-doc-date-standard as logical      no-undo.
     2187       define variable v-par-consignee-addres  as character    no-undo.
     2188       define variable v-host-code         as integer      no-undo.
     2189       define variable v-dcode-attr        as character    no-undo.
     2190       define variable v-ddate-attr        as character    no-undo.
     2191       define variable v-doc-date          as character    no-undo.
     2192       define variable v-doc-code          as character    no-undo.
     2193       define variable v-par-type          as character    no-undo.
     2194       define variable v-attr              as character    no-undo.
     2195       define buffer buf_firm          for ub.firm .
     2196       define buffer buf_clients       for ub.clients .
     2197       define buffer buf_sysconf       for ub.sysconf .
     2198       define buffer buf_shop          for ub.shop .
     2199       define buffer buf_store         for ub.store .
     2200       define buffer buf_person        for ub.person .
     2201       define buffer buf_trn-doc       for ub.trn-doc .
     2202       define buffer buf_wth-doc       for ub.wth-doc .
     2203       do
     2204   for buf_firm
     2205     , buf_clients
     2206     , buf_sysconf
     2207     , buf_shop
     2208     , buf_trn-doc
     2209     , buf_person
     2210     , buf_wth-doc
     2211   on error undo, return error
     2212   :
     2213       if p-doc-type = 'при':U
     2214       or p-doc-type = 'возврат':U
     2215       then do:
     2216           assign
     2217               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2218                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2219               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2220                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2221               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2222                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2223               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2224                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2225               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2226               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2227               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2228               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2229               v-torgconf-supplier-type    = v-torgconf-cli-type
     2230               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2231               v-torgconf-saler-type       = v-torgconf-self-host-type
     2232               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2233               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2234               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2235               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2236               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2237               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2238               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2239               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2240               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2241               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2242               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2243               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2244               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2245               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2246               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2247           .
     2248           if v-torgconf-cli-schet-exists = yes
     2249           AND v-form-name                  = "torg12":U
     2250           then do:
     2251               assign
     2252                   v-torgconf-supplier = v-torgconf-supplier
     2253                       + substitute( ", р/с &1 к/с &2"
     2254                                   , v-torgconf-cli-bank-r-schet
     2255                                   , v-torgconf-cli-bank-c-schet
     2256                                   )
     2257                   v-torgconf-suppi = v-torgconf-supplier
     2258                       + substitute( ", р/с &1 к/с &2"
     2259                                   , v-torgconf-cli-bank-r-schet
     2260                                   , v-torgconf-cli-bank-c-schet
     2261                                   )
     2262               .
     2263               if v-torgconf-cli-bank-exists = yes
     2264               then do:
     2265                   assign
     2266                       v-torgconf-supplier = v-torgconf-supplier
     2267                           + substitute( " БИК &1 в &2 &3"
     2268                                       , v-torgconf-cli-bank-bik
     2269                                       , v-torgconf-cli-bank-name
     2270                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2271                                       )
     2272                      v-torgconf-suppi = v-torgconf-supplier
     2273                           + substitute( " БИК &1 в &2 &3"
     2274                                       , v-torgconf-cli-bank-bik
     2275                                       , v-torgconf-cli-bank-name
     2276                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2277                                       )
     2278                   .
     2279               end.
     2280           end.
     2281           if v-torgconf-self-schet-exists = yes
     2282           AND v-form-name                  = "torg12":U
     2283           then do:
     2284               assign
     2285                   v-torgconf-saler = v-torgconf-saler
     2286                       + substitute( ", р/с &1 к/с &2"
     2287                                   , v-torgconf-self-bank-r-schet
     2288                                   , v-torgconf-self-bank-c-schet
     2289                                   )
     2290               .
     2291               if v-torgconf-self-bank-exists = yes
     2292               then do:
     2293                   assign
     2294                       v-torgconf-saler = v-torgconf-saler
     2295                           + substitute( " БИК &1 в &2 &3"
     2296                                       , v-torgconf-self-bank-bik
     2297                                       , v-torgconf-self-bank-name
     2298                                       , v-torgconf-self-bank-addres
     2299                                       )
     2300                   .
     2301               end.
     2302           end.
     2303           if v-torgconf-sup-schet-exists = yes
     2304           AND v-form-name                  = "torg12":U
     2305           then do:
     2306               assign
     2307                   v-torgconf-consignee = v-torgconf-consignee
     2308                       + substitute( ", р/с &1 к/с &2"
     2309                                   , v-torgconf-sup-bank-r-schet
     2310                                   , v-torgconf-sup-bank-c-schet
     2311                                   )
     2312               .
     2313             if v-torgconf-sup-bank-exists = yes
     2314              then do:
     2315                assign
     2316                   v-torgconf-consignee = v-torgconf-consignee
     2317                           + substitute( " БИК &1 в &2 &3"
     2318                                       , v-torgconf-sup-bank-bik
     2319                                       , v-torgconf-sup-bank-name
     2320                                       , v-torgconf-sup-bank-addres
     2321                                       )
     2322                   .
     2323               end.
     2324           end.
     2325      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2326      then do:
     2327          assign
     2328            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2329                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2330                                                   , v-torgconf-cli-name
     2331                                                   , ( if v-torgconf-outprncd = yes
     2332                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2333                                                         else "":U )
     2334                                                   , v-torgconf-cli-post-addres
     2335                                                   , v-torgconf-cli-phone
     2336                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2337                                                       AND v-form-name                  = "torg12":U
     2338                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2339                                                               , v-torgconf-cli-bank-r-schet
     2340                                                               , v-torgconf-cli-bank-c-schet
     2341                                                               , v-torgconf-cli-bank-bik
     2342                                                               , v-torgconf-cli-bank-name
     2343                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2344                                                         else "":U )
     2345                                                )
     2346         .
     2347      end.
     2348       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2349                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2350                                        , v-torgconf-cli-name
     2351                                        , ( if v-torgconf-outprncd = yes
     2352                                            then substitute( " (&1)", v-torgconf-cli-code )
     2353                                            else "":U )
     2354                                        , v-torgconf-cli-addres
     2355                                        , v-torgconf-cli-phone
     2356                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2357                                            AND v-form-name                  = "torg12":U
     2358                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2359                                                           , v-torgconf-cli-bank-r-schet
     2360                                                           , v-torgconf-cli-bank-c-schet
     2361                                                           , v-torgconf-cli-bank-bik
     2362                                                           , v-torgconf-cli-bank-name
     2363                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2364                                                   else "":U )
     2365                                        ).
     2366       end.
     2367       else do:
     2368       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2369                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2370                                        , v-torgconf-self-host-name
     2371                                        , ( if v-torgconf-outprncd = yes
     2372                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2373                                            else "":U )
     2374                                        , v-torgconf-self-host-addres
     2375                                        , v-torgconf-self-host-phone
     2376                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2377                                            AND v-form-name                  = "torg12":U
     2378                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2379                                                           , v-torgconf-self-bank-r-schet
     2380                                                           , v-torgconf-self-bank-c-schet
     2381                                                           , v-torgconf-self-bank-bik
     2382                                                           , v-torgconf-self-bank-name
     2383                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2384                                                   else "":U )
     2385                                           ).
     2386         if v-torgconf-outares = yes
     2387         and p-reverse = no
     2388         then do:
     2389            assign
     2390               v-par-consignee-addres = v-torgconf-ship-post-addres
     2391            .
     2392         end.
     2393         if v-torgconf-outares = no
     2394         and p-reverse = no
     2395         then do:
     2396            assign
     2397               v-par-consignee-addres = v-torgconf-ship-addres
     2398            .
     2399         end.
     2400         if p-reverse = yes
     2401         then do:
     2402             assign
     2403               v-par-consignee-addres = v-torgconf-ship-addres
     2404             .
     2405         end.
     2406           assign
     2407               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2408                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2409               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2410                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2411               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2412                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2413               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2414               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2415               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2416               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2417               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2418               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2419               v-torgconf-saler-type       = v-torgconf-cli-type
     2420               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2421               v-torgconf-consignee-type   = v-torgconf-ship-type
     2422               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2423               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2424               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2425               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2426               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2427               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2428               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2429               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2430               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2431               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2432               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2433               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2434               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2435               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2436               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2437               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2438               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2439           .
     2440           if v-torgconf-self-schet-exists = yes
     2441           AND v-form-name                  = "torg12":U
     2442           then do:
     2443               assign
     2444                   v-torgconf-supplier = v-torgconf-supplier
     2445                       + substitute( ", р/с &1 к/с &2"
     2446                                   , v-torgconf-self-bank-r-schet
     2447                                   , v-torgconf-self-bank-c-schet
     2448                                   )
     2449               .
     2450               if v-torgconf-self-bank-exists = yes
     2451               then do:
     2452                   assign
     2453                       v-torgconf-supplier = v-torgconf-supplier
     2454                           + substitute( " БИК &1 в &2 &3"
     2455                                       , v-torgconf-self-bank-bik
     2456                                       , v-torgconf-self-bank-name
     2457                                       , v-torgconf-self-bank-addres
     2458                                       )
     2459                   .
     2460               end.
     2461           end.
     2462           if v-torgconf-cli-schet-exists = yes
     2463           AND v-form-name                  = "torg12":U
     2464           then do:
     2465               assign
     2466                   v-torgconf-saler = v-torgconf-saler
     2467                       + substitute( ", р/с &1 к/с &2"
     2468                                   , v-torgconf-cli-bank-r-schet
     2469                                   , v-torgconf-cli-bank-c-schet
     2470                                   )
     2471               .
     2472               if v-torgconf-cli-bank-exists = yes
     2473               then do:
     2474                   assign
     2475                       v-torgconf-saler = v-torgconf-saler
     2476                           + substitute( " БИК &1 в &2 &3"
     2477                                       , v-torgconf-cli-bank-bik
     2478                                       , v-torgconf-cli-bank-name
     2479                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2480                                       )
     2481                   .
     2482               end.
     2483           end.
     2484           if v-torgconf-ship-schet-exists = yes
     2485           AND v-form-name                  = "torg12":U
     2486           then do:
     2487               assign
     2488                   v-torgconf-consignee = v-torgconf-consignee
     2489                       + substitute( ", р/с &1 к/с &2"
     2490                                   , v-torgconf-ship-bank-r-schet
     2491                                   , v-torgconf-ship-bank-c-schet
     2492                                   )
     2493               .
     2494               if v-torgconf-ship-bank-exists = yes
     2495               then do:
     2496                   assign
     2497                       v-torgconf-consignee = v-torgconf-consignee
     2498                           + substitute( " БИК &1 в &2  &3"
     2499                                       , v-torgconf-ship-bank-bik
     2500                                       , v-torgconf-ship-bank-name
     2501                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     2502                                       )
     2503                   .
     2504               end.
     2505           end.
     2506      if p-reverse = yes
     2507         then do:
     2508          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     2509            .
     2510          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
     2511                 if v-torgconf-cli-schet-exists = yes
     2512                 AND v-form-name                  = "torg12":U
     2513                     then do:
     2514                           assign
     2515                              v-torgconf-saler = v-torgconf-saler
     2516                                 + substitute( ", р/с &1 к/с &2"
