     3806                     v-torgconf-ogr-name = buf_shop.director
     3807                     v-torgconf-ogr-post = "Директор"
     3808                  .
     3809               END.
     3810               WHEN 'скл':U
     3811               THEN DO:
     3812                  find first buf_store no-lock
     3813                  where buf_store.obj-code = buf_trn-doc.obj-code
     3814                  .
