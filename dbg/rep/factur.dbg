     6800   procedure facturxl-write-cell-data :
     6801   define input parameter p-data-key   as character        no-undo.
     6802   define input parameter p-data-value as character        no-undo.
     6803       define buffer buf_temp_cell-data     for temp_cell-data.
     6804   do
     6805   for buf_temp_cell-data
     6806   on error undo, return error
     6807   :
     6808       find first buf_temp_cell-data
     6809            where buf_temp_cell-data.data-key = p-data-key
     6810       no-error.
     6811       if not available buf_temp_cell-data
     6812       then do:
     6813           create buf_temp_cell-data.
     6814           assign
     6815               buf_temp_cell-data.data-key = p-data-key
     6816           .
     6817       end.
     6818       assign
     6819           buf_temp_cell-data.data-value = p-data-value
     6820       .
     6821       put stream excel-cell unformatted
     6822                           buf_temp_cell-data.data-key
     6823           chr(9)   buf_temp_cell-data.data-value
     6824           chr(10)
     6825       .
     6826   end.
     6827   end procedure.
     6828   procedure facturxl-write-line-data :
     6829   define input parameter p-Name          as character        no-undo.
     6830   define input parameter p-UAES          as character        no-undo.
     6831   define input parameter p-OKEI          as character        no-undo.
     6832   define input parameter p-EI            as character        no-undo.
     6833   define input parameter p-qnty          as character        no-undo.
     6834   define input parameter p-price         as character        no-undo.
     6835   define input parameter p-SumNoVAT      as character        no-undo.
     6836   define input parameter p-SumActciz     as character        no-undo.
     6837   define input parameter p-VATpc         as character        no-undo.
     6838   define input parameter p-VATsum        as character        no-undo.
     6839   define input parameter p-sum           as character        no-undo.
     6840   define input parameter p-countrycode   as character        no-undo.
     6841   define input parameter p-country       as character        no-undo.
     6842   define input parameter p-GTD           as character        no-undo.
     6843       define buffer buf_temp_line-data        for temp_line-data.
     6844   do
     6845   for buf_temp_line-data
     6846   on error undo, return error
     6847   :
     6848       for each buf_temp_line-data
     6849       :
     6850           delete buf_temp_line-data.
     6851       end.
     6852       create buf_temp_line-data.
     6853       assign
     6854           v-facturxl-current-data-row = v-facturxl-current-data-row + 1
     6855       .
     6856       assign
     6857           buf_temp_line-data.data-key     = "LD":U
     6858           buf_temp_line-data.xl-line-id   = v-facturxl-current-data-row
     6859           buf_temp_line-data.Name         = p-Name
     6860           buf_temp_line-data.UAES         = p-UAES
     6861           buf_temp_line-data.OKEI         = p-OKEI
     6862           buf_temp_line-data.EI           = p-EI
     6863           buf_temp_line-data.qnty         = p-qnty
     6864           buf_temp_line-data.price        = p-price
     6865           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     6866           buf_temp_line-data.SumActciz    = p-SumActciz
     6867           buf_temp_line-data.VATpc        = p-VATpc
     6868           buf_temp_line-data.VATsum       = p-VATsum
     6869           buf_temp_line-data.sum          = p-sum
     6870           buf_temp_line-data.countrycode  = p-countrycode
     6871           buf_temp_line-data.country      = p-country
     6872           buf_temp_line-data.GTD          = p-GTD
     6873       .
     6874       put stream excel-line unformatted
     6875                           buf_temp_line-data.data-key
     6876           chr(9)   buf_temp_line-data.Name
     6877           chr(9)   buf_temp_line-data.UAES
     6878           chr(9)   buf_temp_line-data.OKEI
     6879           chr(9)   buf_temp_line-data.EI
     6880           chr(9)   buf_temp_line-data.qnty
     6881           chr(9)   buf_temp_line-data.price
     6882           chr(9)   buf_temp_line-data.SumNoVAT
     6883           chr(9)   buf_temp_line-data.SumActciz
     6884           chr(9)   buf_temp_line-data.VATpc
     6885           chr(9)   buf_temp_line-data.VATsum
     6886           chr(9)   buf_temp_line-data.sum
     6887           chr(9)   buf_temp_line-data.countrycode
     6888           chr(9)   buf_temp_line-data.country
     6889           chr(9)   buf_temp_line-data.GTD
     6890           chr(10)
     6891       .
     6892   end.
     6893   end procedure.
