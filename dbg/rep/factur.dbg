     9782                               , input string( v-prt-qnty                        )
     9783                               , input string( v-price-no-VAT * v-qnty / doc-line.cli-qnty )
     9784                               , input string( v-price-no-VAT * v-qnty / doc-line.cli-qnty * v-prt-qnty )
     9785                               , input " без акциза":U
     9786                               , input string( v-VAT-prc          )
     9787                               , input ( if v-prt-qnty = 0 or v-qnty = 0 then "":U
     9788                               else string( ( v-price-no-VAT * v-qnty / doc-line.cli-qnty * v-prt-qnty ) * v-VAT-prc / 100 ) )
     9789                               , input ( if v-prt-qnty = 0 or v-qnty = 0 then "":U
     9790                               else string( v-price-no-VAT * v-qnty / doc-line.cli-qnty * v-prt-qnty + ( v-price-no-VAT * v-qnty / doc-line.cli-qnty * v-prt-qnty ) * v-VAT-prc / 100 ) )
     9791                               , input v-country-code
     9792                               , input v-country
     9793                               , input v-GTD
     9794                      ).
     9795                   end.
     9796                   else do :
     9797                      run facturxl-write-line-data in this-procedure (
     9798                                 input (if rep-artic then (string( buf_goods.artic, "x(16)" ) + " ") else "") + buf_goods.gds-name
     9799                               , input v-uaes-code
     9800                               , input v-unit-code
     9801                               , input ( buf_goods.unit-base )
     9802                               , input string( v-qnty )
     9803                               , input string( v-price-no-VAT              )
     9804                               , input string( v-price-no-VAT * v-qnty )
     9805                               , input "без акциза":U
     9806                               , input string( v-VAT-prc          )
     9807                               , input string( v-VAT )
     9808                               , input string( ( v-price-no-VAT * v-qnty ) + v-VAT )
     9809                               , input v-country-code
     9810                               , input v-country
     9811                               , input v-GTD
     9812                      ).
     9813                   end.
     9814                end.
     9815                if FullGdsName
     9816                   and gds-str1 <> "":U
     9817                then do :
     9818                   run print-more in this-procedure.
     9819                end.
     9820                run print-tax in this-procedure (
     9821                       input recid( buf_goods )
     9822                ).
     9823                assign v-lines-counter = v-lines-counter + 1.
     9824             end.
     9825          end.
     9826       end.
     9827       assign
     9828          v-tot-sum-no-VAT    = v-tot-sum-no-VAT  + v-sum-no-VAT  + v-tax
     9829          v-tot-VAT           = v-tot-VAT         + v-VAT
     9830          v-tot-SLT           = v-tot-SLT         + v-SLT
     9831          v-tot-tax           = v-tot-tax         + v-tax
     9832          v-tot-sum           = v-tot-sum         + v-sum         + v-tax
     9833       .
     9834   end.
     9835   end procedure.
     9836   procedure print-header :
     9837   define input parameter p-doc-code           as character    no-undo.
     9838   define output parameter p-curr-abbr         as character    no-undo.
     9839       define variable v-print-doc      as character           no-undo.
     9840       define variable v-par-type       as character           no-undo.
     9841       define variable t-num            as character           no-undo.
     9842       define variable v-obj-prt-on     as logical             no-undo.
     9843       define variable t-inn            as character           no-undo.
     9844       define variable v-plat-rasch-doc as character           no-undo.
     9845       define variable v-curr-name      as character           no-undo.
     9846       define variable v-base-name      as character           no-undo.
     9847       define variable v-base-abbr      as character           no-undo.
     9848       define variable v-rubl-name      as character           no-undo.
     9849       define variable t-currency       as character           no-undo.
     9850       define variable v-idContr        as character           no-undo.
     9851       define variable v-attr-type      as character           no-undo.
     9852       define buffer buf_trn-doc       for ub.trn-doc.
     9853       define buffer buf_currency      for ub.currency.
     9854   do
     9855   for buf_trn-doc
     9856     , buf_currency
     9857   on error undo, return error
     9858   :
     9859       find first buf_trn-doc no-lock
     9860            where buf_trn-doc.doc-code = p-doc-code
     9861       .
     9862   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9863   empty temp-table thbjattr_thbj-attr.
     9864   run adm/shattri.p (
     9865      input "get":U
     9866     ,input buf_trn-doc.obj-type
     9867     ,input buf_trn-doc.obj-code
     9868     ,input 'prt-firm':U
     9869     ,input  ""
     9870     ,output v-value-character
     9871     ,output v-value-date
     9872     ,output v-value-decimal
     9873     ,output v-value-integer
     9874     ,output v-value-logical
     9875     ,output par-type
     9876     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     9877     ) no-error .
     9878       for each thbjattr_thbj-attr :
     9879           if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
     9880       end.
     9881       if v-print-doc <> 'yes'  then assign v-print-doc = "no"  .
     9882       run torgconf-get-form-header in this-procedure (
     9883             input Invers
     9884           , input buf_trn-doc.doc-code
     9885           , input ( v-print-doc = "yes" )
     9886           , input buf_trn-doc.doc-date
     9887           , input buf_trn-doc.fact-date
     9888           , input buf_trn-doc.doc-type
     9889           , input buf_trn-doc.status_
     9890           , input no
     9891           , input yes
     9892       ).
     9893   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9894   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     9895     (input  buf_trn-doc.obj-type
     9896     ,input  buf_trn-doc.obj-code
     9897     ,input  'doc-prt=request'
     9898     ,output v-obj-prt-on
     9899     )  .
     9900       if v-obj-prt-on = no
     9901       or invers
     9902       then do:
     9903           assign
     9904               PrintScale = no
     9905           .
     9906       end.
     9907       find first buf_currency no-lock
     9908            where buf_currency.curr-code = buf_trn-doc.exch-code
     9909       .
     9910       assign
     9911           p-curr-abbr = buf_currency.curr-abbr
     9912           v-curr-name = buf_currency.curr-name + ", код " + string(buf_currency.okv-code)
     9913       .
     9914       define variable v-base-code as integer   no-undo .
     9915   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9916   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     9917     (input  v-cntxt-host-code-obj
     9918     ,output v-base-code
     9919     )  .
     9920       find first buf_currency no-lock
     9921            where buf_currency.curr-code = v-base-code
     9922       .
     9923       assign
     9924           v-base-name = buf_currency.curr-name + ", код " + string(buf_currency.okv-code)
     9925           v-base-abbr = buf_currency.curr-abbr
     9926       .
     9927       find first buf_currency no-lock
     9928            where buf_currency.curr-code = 0
     9929       .
     9930       assign
     9931           v-rubl-name = buf_currency.curr-name + ", код " + string(buf_currency.okv-code)
     9932       .
     9933       assign
     9934           t-num = substitute( "&1         от &2 &3"
     9935                           , v-torgconf-doc-code
     9936                           , v-torgconf-doc-date
     9937                           , ( if buf_trn-doc.status_ <> 'факт':U
     9938                               then string( "(" + caps( buf_trn-doc.status_ ) + ")" )
     9939                               else "":U )
     9940                   )
     9941       .
     9942       assign
     9943           t-inn = substitute( "&1&2&3", v-torgconf-supplier-inn, ( if ((v-torgconf-supplier-kpp = "":U) AND (v-torgconf-supplier-inn = "":U)) then "":U else "/":U ), v-torgconf-supplier-kpp )
     9944       .
     9945       if v-torgconf-outappr = yes
     9946       then do:
     9947         put stream Out-stream
     9948             space(108) "                                                                           Приложение № 1" skip
     9949             space(108) "                                                            к постановлению Правительства" skip
     9950             space(108) "                                                                     Российской Федерации" skip
     9951             space(108) "                                                                     от 26.12.2011 № 1137" skip
     9952             space(108) "                              (в ред. Постановления Правительства РФ от 19.08.2017 № 981)" skip
     9953         .
     9954       END.
     9955       put stream Out-stream
     9956           space(25) string( "СЧЕТ-ФАКТУРА N" + ( if p-round = 'round':U then ":" else " " ) + t-num ) format "X(190)" skip
     9957           space(23) 'ИСПРАВЛЕНИЕ N   -   от " - "    -   '
     9958           skip(1) space(5) string( "Продавец" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 31 ) + v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )) format "X(190)"
     9959           skip    space(5) string( "Адрес"    + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-supplier-addr ) format "X(190)"
     9960           skip    space(5) string( "Идентификационный номер продавца (ИНН/КПП)" + ( if p-round = 'round':U then ":" else " " ) + t-inn ) format "X(190)"
     9961       .
     9962      if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
     9963      else if buf_trn-doc.doc-type <> 'при':U
     9964      and ( not invers )
     9965      and buf_trn-doc.office = no
     9966      and v-torgconf-outobj = no
     9967      and v-torgconf-outasend = no
     9968      and v-torgconf-outsend = no
     9969      then v-out-name = "Он же".
     9970      else
     9971      v-out-name =  v-torgconf-cargo-from-sf-value.
     9972         run facturxl-write-cell-data in this-procedure (
     9973              input "h_cargoFrom":U
     9974            , input v-out-name
     9975            ) .
     9976         if LENGTH(v-out-name) > 145
     9977            then do:
     9978               put stream Out-stream
     9979                  skip    space(5) string( "Грузоотправитель и его адрес"
     9980                                       + ( if p-round = 'round':U then ":" else " " )
     9981                                       + fill( " ", 11 )
     9982                                       + ( if buf_trn-doc.office = yes
     9983                                             then "---"
     9984                                             else SUBSTRING(v-out-name,1,145))) format "X(190)"
     9985                  skip    space(45) SUBSTRING(v-out-name,146) format "X(145)" skip
     9986               .
     9987            end.
     9988            else do:
     9989               put stream Out-stream
     9990                  skip    space(5) string( "Грузоотправитель и его адрес"
     9991                                          + ( if p-round = 'round':U then ":" else " " )
     9992                                          + fill( " ", 11 )
     9993                                          + ( if buf_trn-doc.office = yes
     9994                                                then "---"
     9995                                                else v-out-name)) format "X(190)" skip
     9996               .
     9997            end.
     9998   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input p-doc-code ,
     9999                           input 'idCountryContr':U ,
    10000                          output v-idContr ,
    10001                          output v-attr-type ) no-error .
    10002       run facturxl-write-cell-data in this-procedure (
    10003             input "h_docCode":U
    10004           , input v-torgconf-doc-code
    10005       ).
    10006       run facturxl-write-cell-data in this-procedure (
    10007             input "h_docDate":U
    10008           , input v-torgconf-doc-date
    10009       ).
    10010       run facturxl-write-cell-data in this-procedure (
    10011             input "h_supplier":U
    10012           , input v-torgconf-supplier-name + IF v-torgconf-supplier-engl-name = "":U THEN "":U ELSE SUBSTITUTE(" (&1)", v-torgconf-supplier-engl-name )
    10013       ).
    10014       run facturxl-write-cell-data in this-procedure (
    10015             input "h_supplierAddr":U
    10016           , input v-torgconf-supplier-addr
    10017       ).
    10018       run facturxl-write-cell-data in this-procedure (
    10019             input "h_supplierINN":U
    10020           , input t-inn
    10021       ).
    10022       run facturxl-write-cell-data in this-procedure (
    10023             input "h_idContract":U
    10024           , input v-idContr
    10025       ).
    10026       assign
    10027           t-inn = substitute( "&1&2&3", v-torgconf-saler-inn, ( if v-torgconf-saler-kpp = "":U then "":U else "/":U ), v-torgconf-saler-kpp )
    10028       .
    10029       if lookup( "GreenL", p-mode ) <> 0
    10030       then do:
    10031           assign
    10032               v-plat-rasch-doc    = "":U
    10033           .
    10034       end.
    10035       else do:
    10036           assign
    10037               v-plat-rasch-doc    = " N ":U + ( if p-round = 'round':U then ": ":U else " ":U ) + fill( " ", 6 ) + v-torgconf-plat-rasch-doc
    10038           .
    10039       end.
    10040         if LOOKUP( "serv", p-mode ) <> 0 then v-out-name = '---------------------'  .
    10041         else if     buf_trn-doc.doc-type <> 'при':U
    10042               and buf_trn-doc.doc-type <> 'возврат':U
    10043         then v-out-name =  v-torgconf-consignee.
    10044         else v-out-name =  v-torgconf-cargo-to-value .
    10045         run facturxl-write-cell-data in this-procedure (
    10046               input "h_cargoTo":U
    10047               , input v-out-name
    10048         ).
    10049         if LENGTH(v-out-name) > 145
    10050         then do:
    10051            put stream Out-stream
    10052               space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + SUBSTRING(v-out-name,1,145))   format "X(190)"
    10053               skip space(45) SUBSTRING(v-out-name,146) format "X(145)"
    10054            .
    10055         end.
    10056         else do:
    10057            put stream Out-stream
    10058               space(5) string( "Грузополучатель и его адрес" + ( if p-round = 'round':U then ": " else " " ) + fill( " ", 12 ) + v-out-name)   format "X(190)"
    10059            .
    10060         end.
    10061        put stream Out-stream
    10062           skip    space(5) string( "К платежно-расчетному документу" + v-plat-rasch-doc ) format "X(190)"
    10063           skip(1) space(5) string( "Покупатель" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 29 ) + v-torgconf-saler-name +
    10064                                                   if v-torgconf-outprncd = yes
    10065                                                   then substitute( " (&1)", v-torgconf-saler-code )
    10066                                                   else "":U  ) format "X(190)"
    10067           skip    space(5) string( "Адрес" + ( if p-round = 'round':U then ":" else " " ) + fill( " ", 34 ) + v-torgconf-saler-addr ) format "X(190)"
    10068           skip    space(5) string( "Идентификационный номер покупателя (ИНН/КПП)" + ( if p-round = 'round':U then ": " else " " ) + t-inn ) format "X(190)"
    10069           skip    space(5) string( fill( "_", 130 ) ) format "X(130)"
    10070           skip
    10071       .
    10072       run facturxl-write-cell-data in this-procedure (
    10073             input "h_platDoc":U
    10074           , input v-torgconf-plat-rasch-doc
    10075       ).
    10076       run facturxl-write-cell-data in this-procedure (
    10077             input "h_saler":U
    10078           , input v-torgconf-saler-name + if v-torgconf-outprncd = yes
    10079                                           then substitute( " (&1)", v-torgconf-saler-code )
    10080                                           else "":U
    10081       ).
    10082       run facturxl-write-cell-data in this-procedure (
    10083             input "h_salerAddr":U
    10084           , input v-torgconf-saler-addr
    10085       ).
    10086       run facturxl-write-cell-data in this-procedure (
    10087             input "h_salerINN":U
    10088           , input t-inn
    10089       ).
    10090       assign
    10091           t-currency = ( trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) )
    10092       .
    10093       run facturxl-write-cell-data in this-procedure (
    10094             input "h_currency":U
    10095           , input t-currency
    10096       ).
    10097       if buf_trn-doc.ext-doc-type = 'ep':U then do:
    10098           put stream Out-stream
    10099               space(10) "Возврат товара поставщику." format "X(120)" skip
    10100           .
    10101       end.
    10102       if v-torgconf-outrubl = no
    10103       then do:
    10104           put stream Out-stream
    10105           space(5)
    10106               string( "Валюта:  " +
    10107               trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then v-curr-name else ( if PrintRubl then v-rubl-name else v-base-name  ) ) ) ) format "X(120)" skip
    10108           .
    10109       end.
    10110       put stream Out-stream
    10111           space(5)
    10112           "Идентификатор государственного контракта, договора (соглашения) (при наличии): "
    10113            + trim(v-idContr) format "X(120)" "(8)" at 196 skip(0)
    10114       .
    10115       if v-torgconf-outprim = no
    10116       then do:
    10117           put stream Out-stream
    10118               skip space(10)
    10119               ( if not( buf_trn-doc.PS begins "@" )
    10120               then string( "Примечание : " + substr( buf_trn-doc.PS, 1, 120 ) )
    10121               else ""
    10122               ) format "X(120)"
    10123           .
    10124       end.
    10125   end.
    10126   end procedure.
    10127   procedure print-footer :
    10128   define input parameter p-doc-code   as character    no-undo.
    10129   define input parameter p-curr-abbr  as character    no-undo.
    10130   define variable v-base-code as integer     no-undo .
    10131   define variable v-base-abbr as character   no-undo .
    10132   define buffer buf_trn-doc       for trn-doc.
    10133   define buffer buf_currency      for ub.currency.
    10134   do
    10135   for buf_trn-doc
    10136   on error undo, return error
    10137   :
    10138       find first buf_trn-doc no-lock
    10139            where buf_trn-doc.doc-code = p-doc-code
    10140       .
    10141       IF LOOKUP( "dec10", p-mode ) <> 0
    10142       THEN DO:
    10143           put stream Out-stream
    10144               v-single-line format "X(232)"
    10145           .
    10146       end.
    10147       ELSE DO:
    10148           put stream Out-stream
    10149               v-single-line format "X(199)"
    10150           .
    10151       end.
    10152       if line-counter( Out-stream ) + 10 > page-size( Out-stream )
    10153       then do:
    10154           page stream Out-stream.
    10155       end.
    10156       run facturxl-write-cell-data in this-procedure (
    10157             input "it_SumNoVAT":U
    10158           , input string( v-tot-sum-no-VAT )
    10159       ).
    10160       run facturxl-write-cell-data in this-procedure (
    10161             input "it_VATsum":U
    10162           , input string( v-tot-VAT )
    10163       ).
    10164       run facturxl-write-cell-data in this-procedure (
    10165             input "it_sum":U
    10166           , input string( v-tot-sum )
    10167       ).
    10168       if lookup( "dec10", p-mode ) <> 0
    10169       THEN DO:
    10170         display stream Out-stream
    10171             "Всего к оплате"  @ buf_goods.gds-name
    10172             v-tot-sum-no-VAT  @ v-sum-no-VAT
    10173             v-tot-VAT         @ v-VAT
    10174             v-tot-sum         @ v-sum
    10175         with frame factur-10 .
    10176         down stream Out-stream 2 with frame factur-10 .
    10177       END.
    10178       ELSE DO:
    10179         display stream Out-stream
    10180             "Всего к оплате"  @ buf_goods.gds-name
    10181             v-tot-sum-no-VAT  @ v-sum-no-VAT
    10182             v-tot-VAT         @ v-VAT
    10183             v-tot-sum         @ v-sum
    10184         with frame factur .
    10185         down stream Out-stream with frame factur .
    10186       END.
    10187       run print-vat-itog-by-perc in this-procedure .
    10188   define variable vss-include-info57 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    10189   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
    10190     (input  v-cntxt-host-code-obj
    10191     ,output v-base-code
    10192     )  .
    10193       find first buf_currency no-lock
    10194            where buf_currency.curr-code = v-base-code
    10195       .
    10196       assign
    10197           v-base-abbr = buf_currency.curr-abbr
    10198       .
    10199       if lookup( "dec10", p-mode ) <> 0
    10200       then do:
    10201         if abs( v-tot-SLT ) >= 0.005
    10202         or ( not invers and abs( buf_trn-doc.discnt-rubl ) >= 0.005 )
    10203         then do:
    10204            put stream Out-stream
    10205                  space(5) "Итого по документу: "
    10206                  trim( string( v-tot-sum, "->,>>>,>>>,>>>,>>>,>>9.9999999999" ) )
    10207                  + " ("
    10208                  + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10209                  + ")"
    10210                                                                              format "X(120)"     at 40
    10211            .
    10212            if v-tot-SLT <> 0 and p-no-slt = false
    10213            then do:
    10214                  put stream Out-stream
    10215                     skip space(10) "Налог с продаж: "
    10216                              trim( string( v-tot-SLT, "->>>,>>9.9999999999" ) )
    10217                              + " ("
    10218                              + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
    10219                              + ")"
    10220                                                                              format "X(150)"     at 40
    10221                  .
    10222            end.
    10223            if buf_trn-doc.discnt-rubl <> 0
    10224            and not invers
    10225            and v-torgconf-outdisc = no
    10226            then do:
    10227                  put stream Out-stream
    10228                     skip space(14) "Скидка:"
    10229                              trim( string( ( if PrintRubl
    10230                                             then buf_trn-doc.discnt-rubl
    10231                                             else buf_trn-doc.tot-calc ), "->>>,>>>,>>>,>>9.9999999999" ) )
    10232                              + " ("
    10233                              + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
    10234                              + ")"
    10235                                                                              format "X(150)"     at 40
    10236                  .
    10237            end.
    10238         end.
    10239         if v-tot-tax <> 0
    10240         then do:
    10241            put stream Out-stream
    10242                  skip space(10)  v-tax-name + ": "                                   format "X(20)"
    10243                     trim( string( v-tot-tax, "->>>,>>>,>>>,>>9.9999999999" ) )
    10244                     + " ("
    10245                     + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10246                     + ")"
    10247                                                                              format "X(150)"     at 40
    10248            .
    10249         end.
    10250         put stream Out-stream
    10251            skip space(5) "Итого к оплате: "
    10252                              string( trim( string( v-tot-sum + v-tot-SLT, "->,>>>,>>>,>>>,>>>,>>9.9999999999" ) )
    10253                              + " ("
    10254                              + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10255                              + ")" )
    10256                                                                              format "X(150)"     at 40
    10257         .
    10258         if PrintRubl
    10259         and v-torgconf-outprops = yes
    10260         then do:
    10261            run rep/wp-rub.p (
    10262                  input v-tot-sum + v-tot-SLT
    10263                  , output v-propis
    10264                  , output v-propis-cop
    10265            ).
    10266            put stream out-stream
    10267                  skip space(25) v-propis
    10268                                                                                 format "X(150)"  at 40
    10269                  skip(1)
    10270            .
    10271         end.
    10272       end.
    10273       else do:
    10274         if abs( v-tot-SLT ) >= 0.005
    10275         or ( not invers and abs( buf_trn-doc.discnt-rubl ) >= 0.005 )
    10276         then do:
    10277            put stream Out-stream
    10278                  space(5) "Итого по документу: "
    10279                  trim( string( v-tot-sum, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
    10280                  + " ("
    10281                  + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10282                  + ")"
    10283                                                                              format "X(120)"     at 40
    10284            .
    10285            if v-tot-SLT <> 0 and p-no-slt = false
    10286            then do:
    10287                  put stream Out-stream
    10288                     skip space(10) "Налог с продаж: "
    10289                              trim( string( v-tot-SLT, "->>>,>>9.99" ) )
    10290                              + " ("
    10291                              + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
    10292                              + ")"
    10293                                                                              format "X(150)"     at 40
    10294                  .
    10295            end.
    10296            if buf_trn-doc.discnt-rubl <> 0
    10297            and not invers
    10298            and v-torgconf-outdisc = no
    10299            then do:
    10300                  put stream Out-stream
    10301                     skip space(14) "Скидка:"
    10302                              trim( string( ( if PrintRubl
    10303                                             then buf_trn-doc.discnt-rubl
    10304                                             else buf_trn-doc.tot-calc ), "->>>,>>>,>>>,>>9.99" ) )
    10305                              + " ("
    10306                              + trim( ( if PrintRubl then "РУБ" else v-base-abbr ) )
    10307                              + ")"
    10308                                                                              format "X(150)"     at 40
    10309                  .
    10310            end.
    10311         end.
    10312         if v-tot-tax <> 0
    10313         then do:
    10314            put stream Out-stream
    10315                  skip space(10)  v-tax-name + ": "                                   format "X(20)"
    10316                     trim( string( v-tot-tax, "->>>,>>>,>>>,>>9.99" ) )
    10317                     + " ("
    10318                     + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10319                     + ")"
    10320                                                                              format "X(150)"     at 40
    10321            .
    10322         end.
    10323         put stream Out-stream
    10324            skip space(5) "Итого к оплате: "
    10325                              string( trim( string( v-tot-sum + v-tot-SLT, "->,>>>,>>>,>>>,>>>,>>9.99" ) )
    10326                              + " ("
    10327                              + trim( ( if invers and buf_trn-doc.doc-type <> 'при':U then p-curr-abbr else ( if PrintRubl then "РУБ" else v-base-abbr ) ) )
    10328                              + ")" )
    10329                                                                              format "X(150)"     at 40
    10330         .
    10331         if PrintRubl
    10332         and v-torgconf-outprops = yes
    10333         then do:
    10334            run rep/wp-rub.p (
    10335                  input v-tot-sum + v-tot-SLT
    10336                  , output v-propis
    10337                  , output v-propis-cop
    10338            ).
    10339            put stream out-stream
    10340                  skip space(25) v-propis
    10341                                                                                 format "X(150)"  at 40
    10342                  skip(1)
    10343            .
    10344          run facturxl-write-cell-data in this-procedure (
    10345             input "h_summ_prop":U
    10346           , input v-propis
    10347          ).
    10348         end.
    10349       end.
    10350       if v-torgconf-outsubs = no
    10351       then do:
    10352           run facturxl-write-cell-data in this-procedure (
    10353                 input "f_bossName":U
    10354               , input v-torgconf-main-boss
    10355           ).
    10356           run facturxl-write-cell-data in this-procedure (
    10357                 input "f_buhName":U
    10358               , input v-torgconf-main-buh
    10359           ).
    10360       end.
    10361       if v-torgconf-outsubs = no
    10362       and trim(v-torgconf-main-boss) = "":U
    10363       or v-torgconf-outsubs = yes
    10364         then do:
    10365               v-torgconf-main-boss = fill( "_", 36 ).
    10366         end.
    10367       if v-torgconf-outsubs = no
    10368       and trim(v-torgconf-main-buh) = "":U
    10369       or v-torgconf-outsubs = yes
    10370         then do:
    10371            v-torgconf-main-buh = fill( "_", 36 ).
    10372         end.
    10373           put stream Out-stream
    10374               skip(2) space(10) "Руководитель организации" format "X(25)" space(75)
    10375               "Главный бухгалтер" format "X(25)" skip
    10376               space(10) "или иное уполномоченное  " format "X(25)" space(75)
    10377               "или иное уполномоченное  " format "X(25)" skip
    10378               space(10) "лицо" format "X(25)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-boss format "X(33)" "/"
    10379               space(10) "лицо" format "X(25)" fill( "_", 26 ) format "X(26)" "    /" v-torgconf-main-buh format "X(31)" "/"
    10380               skip space(43) "(подпись)" space(27) "(Ф.И.О)"  space(57) "(подпись)" space(27) "(Ф.И.О)"
    10381           .
    10382       if v-torgconf-outegrp = no
    10383       then do :
    10384         if trim(v-torgconf-self-host-name) = "":U
    10385         then do:
    10386             v-torgconf-self-host-name = fill("_", 42).
    10387         end.
    10388         if v-torgconf-self-host-egrip-date <> "":U
    10389          or v-torgconf-self-host-egrip-num  <> "":U
    10390          then do:
    10391             put stream Out-stream
    10392                 skip (1) space(10) "Индивидуальный предприниматель"
    10393                 skip (0) space(10) substitute( "или иное уполномоченное лицо     &1  / &2 / ЕГРИП N &3 от &4 ", fill( "_", 26 ) , string(v-torgconf-self-host-name, "x(42)") , v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date ) format "X(174)"
    10394                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
    10395                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(90)"
    10396                 skip
    10397             .
    10398             run facturxl-write-cell-data in this-procedure (
    10399                   input "f_ownerName":U
    10400                 , input string(v-torgconf-self-host-name, "x(42)")
    10401             ).
    10402             run facturxl-write-cell-data in this-procedure (
    10403                 input "f_ownerReg":U
    10404               , input substitute ("N &1 от &2 ", v-torgconf-self-host-egrip-num, v-torgconf-self-host-egrip-date )
    10405             ).
    10406         end.
    10407         else do :
    10408             put stream Out-stream
    10409                 skip (1) space(10) "Индивидуальный предприниматель"
    10410                 skip (0) space(10) substitute( "или иное уполномоченное лицо     &1  / &2 /  &3  ", fill( "_", 26 ) , fill("_", 42) , fill( "_", 50 ) ) format "X(174)"
    10411                 skip     space(51) "(подпись)"  space(29) "(Ф.И.О)" space(22) "(реквизиты свидетельства о государственной"
    10412                 skip     space(119) substitute( "регистрации индивидуального предпринимателя)" ) format "X(90)"
    10413                 skip
    10414             .
    10415         end.
    10416       end.
    10417       put stream Out-stream  skip "Примечание. Первый экземпляр - покупателю, второй экземпляр - продавцу"   format "X(90)"
    10418       skip
    10419       .
    10420   end.
    10421   end procedure.
    10422   procedure print-line-po :
    10423   do
    10424   on error undo, return error
    10425   :
    10426       assign
    10427           gds-str  = ''
    10428           gds-str1 = ''
    10429           gds-str2 = ''
    10430           Gds-str1 = breakstr(gds-prop.gds-name, 45, input-output gds-str1, input-output gds-str2)
    10431       .
    10432       do while trim(gds-str2) <> ""
    10433       :
    10434           assign
    10435               gds-str = gds-str2
    10436               gds-str1 = breakstr(gds-str, 45, input-output gds-str1, input-output gds-str2)
    10437           .
    10438       end.
    10439       assign
    10440           gds-str1 = breakstr(gds-prop.gds-name, 45, input-output gds-str1, input-output gds-str2)
    10441       .
    10442       if gds-prop.gds-type = 'у':U
    10443       then do:
    10444           if lookup( "dec10", p-mode ) <> 0
    10445           THEN DO:
    10446             display stream Out-stream
    10447                 gds-str1              @ buf_goods.gds-name
    10448               sym2  "  -   "                  @ v-uaes-code
    10449               sym16 gds-prop.unit-code        @ v-unit-code
    10450               sym14 gds-prop.unit-base        @ buf_goods.unit-base
    10451               sym3  gds-prop.qnty             @ v-qnty
    10452               sym4  gds-prop.price-no-VAT     @ v-price-no-vat
    10453               sym5  gds-prop.sum-no-VAT       @ v-sum-no-vat
    10454               sym6  "без акциза" format "x(10)"  @ v-sum-actciz
    10455               sym7  gds-prop.Vat-pc           @ v-VAT-prc
    10456               sym8  gds-prop.VAT              @ v-vat
    10457               sym9  gds-prop.sum              @ v-sum
    10458               sym11 gds-prop.country-code     @ v-country-code
    10459               sym15 gds-prop.country          @ v-country
    10460               sym12
    10461             with frame factur-10 .
    10462             down stream Out-stream 1 with frame factur-10 .
    10463           END.
    10464           ELSE DO:
    10465             display stream Out-stream
    10466               sym1  gds-str1                  @ buf_goods.gds-name
    10467               sym2  "  -   "                  @ v-uaes-code
    10468               sym16 gds-prop.unit-code        @ v-unit-code
    10469               sym14 gds-prop.unit-base        @ buf_goods.unit-base
    10470               sym3  gds-prop.qnty             @ v-qnty
    10471               sym4  gds-prop.price-no-VAT     @ v-price-no-vat
    10472               sym5  gds-prop.sum-no-VAT       @ v-sum-no-vat
    10473               sym6  "без акциза" format "x(10)"  @ v-sum-actciz
    10474               sym7  gds-prop.Vat-pc           @ v-VAT-prc
    10475               sym8  gds-prop.VAT              @ v-vat
    10476               sym9  gds-prop.sum              @ v-sum
    10477               sym11 gds-prop.country-code     @ v-country-code
    10478               sym15 gds-prop.country          @ v-country
    10479               sym12
    10480               sym13
    10481             with frame factur .
    10482             down stream Out-stream 1 with frame factur .
    10483           END.
    10484           if FullGdsName
    10485           and gds-str1 <> "":U then do :
    10486             run print-more-po in this-procedure.
    10487           end.
    10488           assign
    10489               v-lines-counter = v-lines-counter + 1
    10490           .
    10491       end.
    10492       else do:
    10493           if lookup( "dec10", p-mode ) <> 0
    10494           THEN DO:
    10495             display stream Out-stream
    10496                 gds-str1              @ buf_goods.gds-name
    10497               sym2  "  -   "                  @ v-uaes-code
    10498               sym16 gds-prop.unit-code        @ v-unit-code
    10499               sym14 gds-prop.unit-base        @ buf_goods.unit-base
    10500               sym3  gds-prop.qnty             @ v-qnty
    10501               sym4  gds-prop.price-no-VAT     @ v-price-no-vat
    10502               sym5  gds-prop.sum-no-VAT       @ v-sum-no-vat
    10503               sym6  "без акциза" format "x(10)"  @ v-sum-actciz
    10504               sym7  gds-prop.Vat-pc           @ v-VAT-prc
    10505               sym8  gds-prop.VAT              @ v-vat
    10506               sym9  gds-prop.sum              @ v-sum
    10507               sym11 gds-prop.country-code     @ v-country-code
    10508               sym15 gds-prop.country          @ v-country
    10509               sym12 gds-prop.GTD              @ v-gtd
    10510             with frame factur-10 .
    10511             down stream Out-stream 1 with frame factur-10 .
    10512           END.
    10513           ELSE DO:
    10514             display stream Out-stream
    10515               sym1  gds-str1                  @ buf_goods.gds-name
    10516               sym2  "  -   "                  @ v-uaes-code
    10517               sym16 gds-prop.unit-code        @ v-unit-code
    10518               sym14 gds-prop.unit-base        @ buf_goods.unit-base
    10519               sym3  gds-prop.qnty             @ v-qnty
    10520               sym4  gds-prop.price-no-VAT     @ v-price-no-vat
    10521               sym5  gds-prop.sum-no-VAT       @ v-sum-no-vat
    10522               sym6  "без акциза" format "x(10)"  @ v-sum-actciz
    10523               sym7  gds-prop.Vat-pc           @ v-VAT-prc
    10524               sym8  gds-prop.VAT              @ v-vat
    10525               sym9  gds-prop.sum              @ v-sum
    10526               sym11 gds-prop.country-code     @ v-country-code
    10527               sym15 gds-prop.country          @ v-country
    10528               sym12 gds-prop.GTD              @ v-gtd
    10529               sym13
    10530             with frame factur .
    10531             down stream Out-stream 1 with frame factur .
    10532           END.
    10533           if FullGdsName
    10534           and gds-str1 <> "":U then do :
    10535             run print-more-po in this-procedure.
    10536           end.
    10537           assign
    10538               v-lines-counter = v-lines-counter + 1
    10539           .
    10540       end.
    10541       assign
    10542           v-tot-sum-no-VAT    = v-tot-sum-no-VAT  + gds-prop.sum-no-VAT
    10543           v-tot-VAT           = v-tot-VAT         + gds-prop.VAT
    10544           v-tot-sum           = v-tot-sum         + gds-prop.sum
    10545       .
    10546   end.
    10547   end procedure.
    10548   procedure print-more-po:
    10549     do on error undo, return error :
    10550       def var v-start-string as character no-undo.
    10551       def var v-add-string as character no-undo.
    10552       assign v-start-string = gds-str2 .
    10553       do while trim(v-start-string) <> ""
    10554       :
    10555           assign
    10556               gds-str         = v-start-string
    10557               v-add-string    = breakstr( gds-str, 45, input-output v-add-string, input-output v-start-string )
    10558           .
    10559           if lookup( "dec10", p-mode ) <> 0
    10560           THEN DO:
    10561             display stream Out-stream
    10562               ((if rep-artic then fill(" ",17) else "") + v-add-string)     @ buf_goods.gds-name
    10563               sym16 sym14 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12
    10564             with frame factur-10 .
    10565             down stream Out-stream 1 with frame factur-10 .
    10566           END.
    10567           ELSE DO:
    10568             display stream Out-stream
    10569               sym1
    10570               ((if rep-artic then fill(" ",17) else "") + v-add-string)     @ buf_goods.gds-name
    10571               sym16 sym14 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9  sym11 sym15 sym12 sym13
    10572             with frame factur .
    10573             down stream Out-stream 1 with frame factur .
    10574           END.
    10575       end.
    10576     end.
    10577   end procedure.
    10578   procedure print-tax :
    10579   define input parameter p-goods-recid    as recid        no-undo.
    10580   define buffer buf_tax_goods     for ub.goods.
    10581   do
    10582   on error undo, return error
    10583   :
    10584       find first buf_tax_goods no-lock
    10585           where recid( buf_tax_goods ) = p-goods-recid
    10586       .
    10587       if hvrdtax( p-goods-recid )
    10588       then do:
    10589               run tax-name (
    10590                     input 'rdt':U
    10591                   , output v-tax-name
    10592               ).
    10593               if lookup( "dec10", p-mode ) <> 0
    10594               THEN DO:
    10595                 display stream out-stream
    10596                   ( fill(" ", 19) + v-tax-name )                                            @ buf_goods.gds-name
    10597                   v-prt-qnty                                                                @ v-qnty
    10598                   ( if PrintRubl then ub.parts.road-tax-rubl else ub.parts.road-tax-base )  @ v-price-no-VAT
    10599                   ( if PrintRubl then ub.parts.road-tax-rubl * v-qnty else ub.parts.road-tax-base * v-qnty )
    10600                                                                                             @ v-sum-no-VAT
    10601                   "без акциза" format "x(10)"                                                    @ v-sum-actciz
    10602                   0                                                                         @ v-VAT
    10603                   ( if PrintRubl then ub.parts.road-tax-rubl * v-qnty else ub.parts.road-tax-base * v-qnty )
    10604                                                                                             @ v-sum
    10605                    sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym11
    10606                 with frame factur-10.
    10607                 down stream out-stream 1 with frame factur-10.
    10608               END.
    10609               ELSE DO:
    10610                 display stream out-stream
    10611                   ( fill(" ", 19) + v-tax-name )                                            @ buf_goods.gds-name
    10612                   v-prt-qnty                                                                @ v-qnty
    10613                   ( if PrintRubl then ub.parts.road-tax-rubl else ub.parts.road-tax-base )  @ v-price-no-VAT
    10614                   ( if PrintRubl then ub.parts.road-tax-rubl * v-qnty else ub.parts.road-tax-base * v-qnty )
    10615                                                                                             @ v-sum-no-VAT
    10616                   "без акциза" format "x(10)"                                                    @ v-sum-actciz
    10617                   0                                                                         @ v-VAT
    10618                   ( if PrintRubl then ub.parts.road-tax-rubl * v-qnty else ub.parts.road-tax-base * v-qnty )
    10619                                                                                             @ v-sum
    10620                   sym1 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym11 sym13
    10621                 with frame factur.
    10622                 down stream out-stream 1 with frame factur.
    10623               END.
    10624               assign
    10625                   v-lines-counter = v-lines-counter   + 1
    10626               .
    10627       end.
    10628       else do:
    10629           if v-tax-price <> 0
    10630           then do:
    10631               message
    10632                   "Значение третьего налога (стеклопосуда) в документе отлично от нуля для товара " + buf_tax_goods.artic
    10633                   + ", хотя для этого товара система не позволяет задать третий налог. Возможны ошибки в накладной"
    10634               view-as alert-box error.
    10635           end.
    10636       end.
    10637   end.
    10638   end procedure.
    10639   procedure print-vat-itog-by-perc :
    10640     define buffer buf_doc-line for ub.doc-line.
    10641     define variable stoim        as  decimal     no-undo.
    10642     define variable SLT-sum      as  decimal     no-undo.
    10643     define variable VAT-sum      as  decimal     no-undo.
    10644     define variable v-vat-pc     like ub.doc-line.vat-pc         no-undo .
    10645     define variable v-slt-pc     like ub.doc-line.slt-pc         no-undo .
    10646     define variable v-sum-no-VAT-10 as decimal   no-undo .
    10647     define variable v-VAT-10        as decimal   no-undo .
    10648     define variable v-sum-10        as decimal   no-undo .
    10649     define variable v-sum-no-VAT-18 as decimal   no-undo .
    10650     define variable v-VAT-18        as decimal   no-undo .
    10651     define variable v-sum-18        as decimal   no-undo .
    10652   do
    10653   on error undo, return error return-value
    10654   :
    10655       if lookup( 'vat-itog' , p-mode ) <> 0 then do:
    10656         empty temp-table temp-nalog.
    10657         for each buf_doc-line no-lock
    10658           where buf_doc-line.doc-code = buf_trn-doc.doc-code
    10659         :
    10660           run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
    10661           find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
    10662           if available tt-allsum-line then do :
    10663             if not CostPrice then do:
    10664               if PrintRubl then do:
    10665                 assign stoim = tt-allsum-line.sum-dsc-rubl-doc  SLT-sum = tt-allsum-line.slt-rubl-doc  VAT-sum = tt-allsum-line.vat-rubl-buyer-doc .
    10666               end.
    10667               else do:
    10668                 assign stoim = tt-allsum-line.sum-dsc-base-doc  SLT-sum = tt-allsum-line.slt-base-doc  VAT-sum = tt-allsum-line.vat-base-buyer-doc .
    10669               end.
    10670             end.
    10671             else do:
    10672               if PrintRubl then do:
    10673                 assign stoim = tt-allsum-line.sum-dsc-rubl-acc  SLT-sum = tt-allsum-line.slt-rubl-acc  VAT-sum = tt-allsum-line.vat-rubl-acc .
    10674               end.
    10675               else do:
    10676                 assign stoim = tt-allsum-line.sum-dsc-base-acc   SLT-sum = tt-allsum-line.slt-base-acc  VAT-sum = tt-allsum-line.vat-base-acc .
    10677               end.
    10678             end.
    10679           end.
    10680           assign
    10681             v-vat-pc = round ( ( if costprice then ( VAT-sum / ( stoim - VAT-sum ) ) * 100 else buf_doc-line.vat-pc ) , 1 )
    10682             v-slt-pc = round ( ( if costprice then ( SLT-sum / ( stoim - SLT-sum ) ) * 100 else buf_doc-line.slt-pc ) , 1 )
    10683           .
    10684           find first temp-nalog where temp-nalog.vat-prc = v-vat-pc and temp-nalog.slt-prc = v-slt-pc no-error .
    10685           if not available temp-nalog then do:
    10686             create temp-nalog .
    10687             assign  temp-nalog.vat-prc = v-vat-pc  temp-nalog.slt-prc = v-slt-pc  .
    10688           end.
    10689           assign
    10690             temp-nalog.vat-sum = temp-nalog.vat-sum + VAT-sum
    10691             temp-nalog.slt-sum = temp-nalog.slt-sum + SLT-sum
    10692             temp-nalog.from-sum = temp-nalog.from-sum + stoim
    10693           .
    10694         end.
    10695         for each temp-nalog no-lock break by temp-nalog.slt-prc by temp-nalog.vat-prc
    10696         :
    10697           if temp-nalog.vat-prc = 10 then do:
    10698             assign
    10699               v-sum-no-VAT-10 = v-sum-no-VAT-10 + ( temp-nalog.from-sum - temp-nalog.vat-sum )
    10700               v-VAT-10        = v-VAT-10        + temp-nalog.vat-sum
    10701               v-sum-10        = v-sum-10        + temp-nalog.from-sum
    10702             .
    10703           end.
    10704           if temp-nalog.vat-prc = 18 or temp-nalog.vat-prc = 20 then do:
    10705             assign
    10706               v-sum-no-VAT-18 = v-sum-no-VAT-18 + ( temp-nalog.from-sum - temp-nalog.vat-sum )
    10707               v-VAT-18        = v-VAT-18        + temp-nalog.vat-sum
    10708               v-sum-18        = v-sum-18        + temp-nalog.from-sum
    10709             .
    10710           end.
    10711         end.
    10712         if lookup( "dec10", p-mode ) <> 0
    10713         THEN DO:
    10714            display stream Out-stream
    10715               "Итого по ставке 10%" @ buf_goods.gds-name
    10716               v-sum-no-VAT-10       @ v-sum-no-VAT
    10717               v-VAT-10              @ v-VAT
    10718               v-sum-10              @ v-sum
    10719            with frame factur-10 .
    10720            down stream Out-stream with frame factur-10 .
    10721            display stream Out-stream
    10722               "Итого по ставке 18/20%" @ buf_goods.gds-name
    10723               v-sum-no-VAT-18       @ v-sum-no-VAT
    10724               v-VAT-18              @ v-VAT
    10725               v-sum-18              @ v-sum
    10726            with frame factur-10 .
    10727            down stream Out-stream with frame factur-10 .
    10728         END.
    10729         ELSE DO:
    10730            display stream Out-stream
    10731               "Итого по ставке 10%" @ buf_goods.gds-name
    10732               v-sum-no-VAT-10       @ v-sum-no-VAT
    10733               v-VAT-10              @ v-VAT
    10734               v-sum-10              @ v-sum
    10735            with frame factur .
    10736            down stream Out-stream with frame factur .
    10737            display stream Out-stream
    10738               "Итого по ставке 18/20%" @ buf_goods.gds-name
    10739               v-sum-no-VAT-18       @ v-sum-no-VAT
    10740               v-VAT-18              @ v-VAT
    10741               v-sum-18              @ v-sum
    10742            with frame factur .
    10743            down stream Out-stream with frame factur .
    10744         END.
    10745         run facturxl-write-cell-data in this-procedure (
    10746               input "f_labelVat10":U
    10747             , input "Итого по ставке 10%":U
    10748         ).
    10749         run facturxl-write-cell-data in this-procedure (
    10750               input "f_sumNoVat10":U
    10751             , input v-sum-no-VAT-10
    10752         ).
    10753         run facturxl-write-cell-data in this-procedure (
    10754               input "f_sumVat10":U
    10755             , input v-VAT-10
    10756         ).
    10757         run facturxl-write-cell-data in this-procedure (
    10758               input "f_sumWithVat10":U
    10759             , input v-sum-10
    10760         ).
    10761         run facturxl-write-cell-data in this-procedure (
    10762               input "f_labelVat18":U
    10763             , input "Итого по ставке 18/20%":U
    10764         ).
    10765         run facturxl-write-cell-data in this-procedure (
    10766               input "f_sumNoVat18":U
    10767             , input v-sum-no-VAT-18
    10768         ).
    10769         run facturxl-write-cell-data in this-procedure (
    10770               input "f_sumVat18":U
    10771             , input v-VAT-18
    10772         ).
    10773         run facturxl-write-cell-data in this-procedure (
    10774               input "f_sumWithVat18":U
    10775             , input v-sum-18
    10776         ).
    10777       end.
    10778   end.
    10779   end procedure.
