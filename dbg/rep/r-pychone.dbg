      207   define buffer buf_temp-chk-gds for temp-chk-gds.
      208   define buffer buf_temp-chk-gds2 for temp-chk-gds.
      209   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
      210   define buffer buf2_chk-doc for ub.chk-doc.
      211   define buffer buf_bar-code for ub.bar-code.
      212   define buffer buf_chk-pay-attr for ub.chk-pay-attr .
      213   function ChkGdsPromo returns logical
      214       (input iDocCode as character)
      215       :
      216       define buffer buf_chk-gds for ub.chk-gds.
      217       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      218       define variable vPromo as logical no-undo.
      219       vPromo = no.
      220       cspr:
      221       for each buf_chk-gds no-lock where
      222                    buf_chk-gds.doc-code = iDocCode,
      223              first buf_chk-gds-attr no-lock where
      224                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      225                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      226                and buf_chk-gds-attr.attr-code = "CSPromo"
      227                and buf_chk-gds-attr.attr-value <> "0":
      228          vPromo = yes.
      229          leave cspr.
      230       end.
      231       return vPromo.
      232   end.
      233   function ChkPromoLine returns logical
      234       (input iDocCode as character,
      235       input iLineNum as integer)
      236       :
      237       define buffer buf_chk-gds for ub.chk-gds.
      238       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      239       define variable vPromo as logical no-undo.
      240       vPromo = no.
      241       find first buf_chk-gds-attr no-lock where
      242                    buf_chk-gds-attr.doc-code = iDocCode
      243                and buf_chk-gds-attr.line-num  = iLineNum
      244                and buf_chk-gds-attr.attr-code = "CSPromo"
      245                and buf_chk-gds-attr.attr-value <> "0"
      246       no-error.
      247       if avail buf_chk-gds-attr then vPromo = yes.
      248       return vPromo.
      249   end.
      250   function ChkPromoSum returns decimal
      251       (input iDocCode as character,
      252        input iLineNum as integer)
      253       :
      254      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      255      define variable vSumPromo as decimal no-undo.
      256      find first buf_chk-gds-attr no-lock where
      257                 buf_chk-gds-attr.doc-code = iDocCode
      258             and buf_chk-gds-attr.line-num  = iLineNum
      259             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      260         no-error.
      261      if avail buf_chk-gds-attr then
      262         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      263      return vSumPromo.
      264   end function.
      265   function ChkPromoPrice returns logical
      266       (input iDocCode as character,
      267        input iLineNum as integer)
      268       :
      269      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      270      define variable v-is-promo as logical no-undo.
      271      v-is-promo = no.
      272      find first buf_chk-gds-attr no-lock where
      273                 buf_chk-gds-attr.doc-code = iDocCode
      274             and buf_chk-gds-attr.line-num  = iLineNum
      275             and buf_chk-gds-attr.attr-code = "CSPromo"
      276         no-error.
      277      if avail buf_chk-gds-attr
      278        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      279      then v-is-promo = yes.
      280      return v-is-promo.
      281   end function.
      282   function ChkDopLitr returns logical
      283       (input iDocCode as character,
      284        input iLineNum as integer)
      285       :
      286      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      287      define variable v-is-promo as logical no-undo.
      288      v-is-promo = no.
      289      find first buf_chk-gds-attr no-lock where
      290                 buf_chk-gds-attr.doc-code = iDocCode
      291             and buf_chk-gds-attr.line-num  = iLineNum
      292             and buf_chk-gds-attr.attr-code = "CSPromo"
      293         no-error.
      294      if avail buf_chk-gds-attr and
      295        buf_chk-gds-attr.attr-value = "3"
      296      then v-is-promo = yes.
      297      return v-is-promo.
      298   end function.
      299   function RoundUp return decimal
      300       (input iQnty as decimal,
      301        input iPrice as decimal):
      302       def var vSum  as decimal no-undo.
      303       def var vSumR as decimal no-undo.
      304       vSum = ABSOLUTE(iQnty) * iPrice.
      305       vSumR = Round(vSum,2).
      306       if vSumR < vSum then vSumR = vSumR + 0.01.
      307       if iQnty < 0 then vSumR = - vSumR.
      308       return vSumR.
      309   end function.
      310   function GetPromoSum returns decimal
      311       (input iDocCode as character)
      312       :
      313       define buffer buf_chk-doc for ub.chk-doc.
      314       define buffer buf2_chk-doc for ub.chk-doc.
      315       define buffer buf_chk-gds for ub.chk-gds.
      316       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      317       define buffer buf2_chk-gds for ub.chk-gds.
      318       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      319       define variable v-price-base as decimal no-undo.
      320       define variable v-doc-qnty as decimal no-undo.
      321       define variable v-sum-base as decimal no-undo.
      322       define variable v-sum-all as decimal no-undo.
      323       define variable v-sum-promo as decimal no-undo.
      324       define variable v-sum-chk as decimal no-undo.
      325       assign
      326          v-price-base = 0
      327          v-doc-qnty = 0
      328          v-sum-all = 0
      329          v-sum-chk = 0
      330          v-sum-promo = 0
      331          .
      332       for each buf_chk-gds no-lock where
      333                buf_chk-gds.doc-code = iDocCode,
      334          first buf_chk-gds-attr no-lock where
      335                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      336            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      337            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      338          :
      339          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      340       end.
      341       if v-sum-promo = 0 then do:
      342           for each buf_chk-gds no-lock where
      343                    buf_chk-gds.doc-code = iDocCode,
      344              first buf_chk-gds-attr no-lock where
      345                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      346                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      347                and buf_chk-gds-attr.attr-code = "CSPromo"
      348                and can-do("1,6", buf_chk-gds-attr.attr-value)
      349              :
      350              assign
      351                v-price-base = buf_chk-gds.price-base
      352                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      353                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      354                .
      355           end.
      356           for each buf_chk-gds no-lock where
      357                    buf_chk-gds.doc-code = iDocCode,
      358              first buf_chk-gds-attr no-lock where
      359                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      360                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      361                and buf_chk-gds-attr.attr-code = "CSPromo"
      362                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      363              :
      364              if v-price-base = 0 then do:
      365                 find first buf_chk-doc no-lock where
      366                            buf_chk-doc.doc-code = iDocCode
      367                     no-error.
      368                 if avail buf_chk-doc and
      369                    buf_chk-doc.chk-type = int('6':U) and
      370                    buf_chk-doc.doc-num2 > ""  and
      371                    num-entries(buf_chk-doc.doc-num2,":") = 2
      372                 then
      373                 for first buf2_chk-doc no-lock where
      374                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      375                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      376                       and buf2_chk-doc.chk-type = int('1':U)
      377                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      378                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      379                       :
      380                   for each buf2_chk-gds no-lock where
      381                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      382                      first buf2_chk-gds-attr no-lock where
      383                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      384                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      385                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      386                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      387                      :
      388                       v-price-base = buf2_chk-gds.price-base.
      389                   end.
      390                 end.
      391              end.
      392              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
      393                  assign
      394                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
      395                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
      396                     .
      397              end.
      398              else do:
      399                 assign
      400                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
      401                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
      402                 .
      403              end.
      404           end.
      405           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
      406       end.
      407       return v-sum-promo.
      408   end function.
      409   function GetUnBaseSum returns decimal
      410       (input iDocCode as character,
      411        input iLineNum as integer,
      412        input iQnty as decimal,
      413        input iPrice as decimal):
      414      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      415      define variable vBaseSum as decimal no-undo.
      416      define variable vDiscSum as decimal no-undo.
      417      vDiscSum = 0.
      418      find first buf_chk-gds-attr no-lock where
      419                        buf_chk-gds-attr.doc-code = iDocCode
      420                    and buf_chk-gds-attr.line-num  = iLineNum
      421                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
      422             no-error.
      423      if avail buf_chk-gds-attr then
      424         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
      425      vBaseSum = iQnty * iPrice + vDiscSum.
      426      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
      427         vBaseSum = RoundUp(iQnty, iPrice).
      428      return vBaseSum.
      429   end function.
      430   function GetRoundSum returns decimal
      431       (input iDocCode as character,
      432        input iLineNum as integer,
      433        input iQnty as decimal,
      434        input iPrice as decimal):
      435      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      436      define variable vBaseSum as decimal no-undo.
      437      if ChkPromoPrice(iDocCode, iLineNum) then
      438         vBaseSum = RoundUp(iQnty, iPrice).
      439      else vBaseSum = iQnty * iPrice.
      440      return vBaseSum.
      441   end function.
      442   function GetRoundSumChkDel returns decimal
      443       (input iDocCode as character,
      444        input iLineNum as integer,
      445        input iChipNum as integer,
      446        input iQnty as decimal,
      447        input iPrice as decimal):
      448      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
      449      define variable vBaseSum as decimal no-undo.
      450      define variable vIsPromo as logical no-undo.
      451      for each buf_c-chk-doc-attr no-lock where
      452               buf_c-chk-doc-attr.doc-code = iDocCode
      453           and buf_c-chk-doc-attr.chip-num = iChipNum
      454          :
      455          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
      456          then do :
      457            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
      458            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
      459            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
      460            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
      461            then vIsPromo = yes.
      462          end.
      463      end.
      464      if ChkPromoPrice(iDocCode, iLineNum) then
      465         vBaseSum = RoundUp(iQnty, iPrice).
      466      else vBaseSum = iQnty * iPrice.
      467      return vBaseSum.
      468   end function.
      469   function GetSaleRetDisc returns decimal
      470       (input iDocCode as character,
      471        input iSaleCode as character):
      472      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      473      define buffer buf_chk-gds for ub.chk-gds.
      474      define variable vQntyPromoRet as decimal no-undo.
      475      define variable vQntyPromoSel as decimal no-undo.
      476      define variable vDiscSumRet   as decimal no-undo.
      477      define variable vDiscSumSale  as decimal no-undo.
      478      vDiscSumRet = 0.
      479      cspr:
      480      for each  buf_chk-gds no-lock where
      481                buf_chk-gds.doc-code = iDocCode,
      482          first buf_chk-gds-attr no-lock where
      483                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      484            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      485            and buf_chk-gds-attr.attr-code = "CSPromo"
      486            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      487          :
      488          vQntyPromoRet = buf_chk-gds.src-qnty.
      489          leave cspr.
      490      end.
      491      if vQntyPromoRet <> 0 then
      492      for each  buf_chk-gds no-lock where
      493                buf_chk-gds.doc-code = iSaleCode:
      494          find first buf_chk-gds-attr no-lock where
      495                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      496                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      497                 and buf_chk-gds-attr.attr-code = "CSPromo"
      498          no-error.
      499          if avail buf_chk-gds-attr
      500               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      501          then
      502            vQntyPromoSel = buf_chk-gds.src-qnty.
      503          find first buf_chk-gds-attr no-lock where
      504                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
      505                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      506                and buf_chk-gds-attr.attr-code = "CSPromoSum"
      507          no-error.
      508          if avail buf_chk-gds-attr then
      509             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
      510      end.
      511      if vQntyPromoRet <> 0 and
      512         vQntyPromoSel = -1 * vQntyPromoRet
      513      then vDiscSumRet = -1 * vDiscSumSale.
      514      return vDiscSumRet.
      515   end function.
      516   function SetPromoDisc return logical
      517    (input iDocCode as character,
      518        input iLineNum as integer
      519        )
      520       :
      521      define buffer buf_chk-doc for ub.chk-doc.
      522      define buffer buf2_chk-doc for ub.chk-doc.
      523      define buffer buf_chk-gds for ub.chk-gds.
      524      define buffer buf2_chk-gds for ub.chk-gds.
      525      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      526      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      527      define buffer buf_chk-discnt for ub.chk-discnt.
      528      define buffer buf2_chk-discnt for ub.chk-discnt.
      529      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
      530      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
      531      define variable v-promo-sum as decimal no-undo.
      532      define variable v-disc-promo-id as character no-undo.
      533      define variable var-discnt-id as integer no-undo.
      534      define variable v-chk-sale as character no-undo.
      535      find first buf_chk-gds-attr no-lock where
      536                 buf_chk-gds-attr.doc-code = iDocCode
      537             and buf_chk-gds-attr.line-num  = iLineNum
      538             and buf_chk-gds-attr.attr-code = "CSPromo"
      539         no-error.
      540      if avail buf_chk-gds-attr
      541        then do:
      542        find first buf_chk-discnt no-lock where
      543                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      544               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
      545               and buf_chk-discnt.record-type = 0
      546               and buf_chk-discnt.promo-id > ""
      547               no-error.
      548        if not avail buf_chk-discnt then do:
      549           find first buf_chk-doc no-lock where
      550                      buf_chk-doc.doc-code = iDocCode
      551              no-error.
      552           find first buf_chk-gds no-lock where
      553                      buf_chk-gds.doc-code = iDocCode
      554                 and  buf_chk-gds.line-num = iLineNum
      555              no-error.
      556          for first buf2_chk-doc no-lock where
      557                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      558                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      559                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
      560                and buf2_chk-doc.chk-type = int('1':U)
      561                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
      562                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      563              :
      564              find first buf2_chk-gds no-lock where
      565                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
      566                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
      567              no-error.
      568              if not avail buf2_chk-gds then return no.
      569              v-chk-sale = buf2_chk-doc.doc-code.
      570              find first buf_chk-discnt no-lock where
      571                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
      572                         buf_chk-discnt.record-type = 1 and
      573                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
      574                         buf_chk-discnt.promo-id > ""
      575              no-error .
      576              if avail buf_chk-discnt
      577              then do:
      578                 v-disc-promo-id = buf_chk-discnt.promo-id.
      579                 find first buf2_chk-discnt no-lock where
      580                   buf2_chk-discnt.doc-code = iDocCode and
      581                   buf2_chk-discnt.record-type = 5 and
      582                   buf2_chk-discnt.line-num = 0 and
      583                   buf2_chk-discnt.promo-id =  v-disc-promo-id
      584                 no-error.
      585                 find first buf2_chk-discnt-attr no-lock where
      586                            buf2_chk-discnt-attr.doc-code = iDocCode and
      587                            buf2_chk-discnt-attr.record-type = 5 and
      588                            buf2_chk-discnt-attr.line-num = 0 and
      589                            buf2_chk-discnt-attr.attr-code = "promo-id" and
      590                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
      591                       no-error .
      592                 if not avail buf2_chk-discnt
      593                 then do:
      594                     for each buf_chk-discnt no-lock where
      595                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      596                          and buf_chk-discnt.record-type = 5:
      597                          var-discnt-id  = var-discnt-id + 1.
      598                     end.
      599                     create buf2_chk-discnt.
      600                     assign
      601                       buf2_chk-discnt.doc-code = iDocCode
      602                       buf2_chk-discnt.record-type = 5
      603                       buf2_chk-discnt.line-num = 0
      604                       buf2_chk-discnt.promo-id = v-disc-promo-id
      605                       buf2_chk-discnt.object-sum = 0
      606                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
      607                                                      then buf2_chk-discnt-attr.discnt-id
      608                                                      else (var-discnt-id + 1)
      609                       var-discnt-id = 0
      610                       buf2_chk-discnt.object-line-num = 0
      611                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
      612                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
      613                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
      614                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
      615                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
      616                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
      617                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
      618                       .
      619                 end.
      620                 if avail buf2_chk-discnt and
      621                    not avail buf2_chk-discnt-attr
      622                 then do:
      623                    create buf2_chk-discnt-attr.
      624                    assign
      625                       buf2_chk-discnt-attr.doc-code = iDocCode
      626                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
      627                       buf2_chk-discnt-attr.record-type     = 5
      628                       buf2_chk-discnt-attr.line-num        = 0
      629                       buf2_chk-discnt-attr.object-line-num = 0
      630                       buf2_chk-discnt-attr.attr-code       = "promo-id"
      631                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
      632                       .
      633                 end.
      634              end.
      635          end.
      636           v-promo-sum = 0.
      637           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
      638           then do:
      639              if v-chk-sale <> ? and v-chk-sale <> "" then
      640                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
      641              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
      642              if v-promo-sum <> 0 then do:
      643                  find first buf2_chk-gds-attr no-lock where
      644                             buf2_chk-gds-attr.doc-code = iDocCode
      645                         and buf2_chk-gds-attr.line-num  = iLineNum
      646                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
      647                     no-error.
      648                  if not avail buf2_chk-gds-attr then do:
      649                      create buf2_chk-gds-attr.
      650                      assign
      651                         buf2_chk-gds-attr.doc-code = iDocCode
      652                         buf2_chk-gds-attr.line-num  = iLineNum
      653                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
      654                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
      655                         .
      656                  end.
      657              end.
      658           end.
      659           for each buf_chk-discnt no-lock where
      660                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
      661               and buf_chk-discnt.record-type = 0:
      662              var-discnt-id  = var-discnt-id + 1.
      663           end.
      664           create buf_chk-discnt.
      665           assign
      666               buf_chk-discnt.doc-code = iDocCode
      667               buf_chk-discnt.line-num = iLineNum
      668               buf_chk-discnt.record-type = 0
      669               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
      670               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
      671               buf_chk-discnt.line-type = integer('1':U)
      672               buf_chk-discnt.line-sign = no
      673               buf_chk-discnt.pass-discnt = integer('0':U)
      674               buf_chk-discnt.value-type = integer('2':U)
      675               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
      676               buf_chk-discnt.d-card = buf_chk-gds.d-card
      677               buf_chk-discnt.discnt-value-abs = 0
      678               buf_chk-discnt.discnt-value-pcnt = 0
      679               buf_chk-discnt.object-line-num = iLineNum
      680               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
      681               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
      682               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
      683               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
      684               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
      685               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
      686               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
      687               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
      688               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
      689               var-discnt-id = var-discnt-id + 1
      690               buf_chk-discnt.promo-id = v-disc-promo-id
      691               buf_chk-discnt.discnt-type = integer('7':U)
      692               .
      693           find first buf_chk-discnt-attr no-lock where
      694                      buf_chk-discnt-attr.attr-code = "promo-id"
      695                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
      696                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
      697                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
      698                  no-error.
      699           if not avail buf_chk-discnt-attr then
      700           do:
      701               create buf_chk-discnt-attr .
      702               assign
      703                   buf_chk-discnt-attr.attr-code = "promo-id"
      704                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
      705                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
      706                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
      707                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
      708                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
      709                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
      710                   .
      711            end.
      712        end.
      713      end.
      714      return yes.
      715   end function.
      716   function GetPromoPriceSum returns decimal
      717       (input iDocCode as character)
      718       :
      719       define buffer buf_chk-gds for ub.chk-gds.
      720       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      721       define variable vPromoSum as decimal no-undo.
      722       vPromoSum = 0.
      723       cspr:
      724       for each buf_chk-gds no-lock where
      725                    buf_chk-gds.doc-code = iDocCode,
      726              first buf_chk-gds-attr no-lock where
      727                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      728                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      729                and buf_chk-gds-attr.attr-code = "CSPromo"
      730                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
      731          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
      732          leave cspr.
      733       end.
      734       return vPromoSum.
      735   end.
      736   function GetPromoPriceLine returns integer
      737       (input iDocCode as character)
      738       :
      739       define buffer buf_chk-gds for ub.chk-gds.
      740       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      741       define variable vPromoLine as integer no-undo.
      742       vPromoLine = 0.
      743       cspr:
      744       for each buf_chk-gds no-lock where
      745                    buf_chk-gds.doc-code = iDocCode,
      746              first buf_chk-gds-attr no-lock where
      747                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      748                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      749                and buf_chk-gds-attr.attr-code = "CSPromo"
      750                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
      751          vPromoLine = buf_chk-gds-attr.line-num.
      752          leave cspr.
      753       end.
      754       return vPromoLine.
      755   end.
      756   define variable g#auto as logical no-undo.
      757   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      758   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      759     (output v-curr-r-b
      760     )  .
      761   define variable v-host-code      as integer no-undo .
      762   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763     run mainmenu_getcntxt in parparentproc
      764       (output v-cntxt-db-num
      765       ,output v-cntxt-userid
      766       ,output v-cntxt-level
      767       ,output v-cntxt-host-code-obj
      768       ,output v-cntxt-obj-type
      769       ,output v-cntxt-obj-code
      770       ,output v-cntxt-db-num-obj
      771       ,output v-cntxt-is-admin
      772       ) .
      773   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      775     (input  v-cntxt-obj-type
      776     ,input  v-cntxt-obj-code
      777     ,output v-host-code
      778     )  .
      779   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      781     (input  v-host-code
      782     ,output v-base-code
      783     )  .
      784     if v-curr-r-b = 'base':U or
      785     v-base-code = 0 then pychk_NO-exch = yes.
      786     else pychk_No-exch = no.
      787     if v-curr-r-b = 'rubl':U or
      788     v-base-code = 0 then pychk_NO-exch-rubl = yes.
      789     else pychk_No-exch-rubl = no.
      790   _chk-doc:
      791    for each ub.chk-doc  where
      792            chk-doc.doc-code eq idoc-code
      793            no-lock ,
      794        each ub.chk-pay no-lock where
      795              ub.chk-pay.doc-code = ub.chk-doc.doc-code
      796      break
      797      by ub.CHK-pay.doc-code
      798      by ub.CHK-pay.line-num:
      799   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
      801     pychk_create = not can-find (first buf_chk-gds-pay
      802                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
      803                                    and buf_chk-gds-pay.algo-num = "1.8") .
      804     if pychk_create then do:
      805       for each temp-chk-pay:
      806         delete temp-chk-pay.
      807       end.
      808       for each temp-chk-gds:
      809         delete temp-chk-gds.
      810       end.
      811       for each temp-chk-dp:
      812         delete temp-chk-dp.
      813       end.
      814       assign
      815       pychk_kk = 0
      816       pychk_jj = 1
      817       pychk_jjp = 0
      818       pychk_jjo = 0
      819       pychk_pay-sum = ub.chk-doc.netto
      820       pychk_dop-sumg = 0
      821       pychk_pays_count = 0
      822       .
      823     end .
      824   end.
      825   if pychk_create   then do:
      826   create-block:
      827   do transaction
      828   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
      829   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
      830   on error  undo, throw:
      831     find first buf2_chk-doc exclusive-lock where
      832            recid(buf2_chk-doc) = recid(ub.chk-doc).
      833     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
      834       FOR EACH ub.chk-gds No-LOCK WHERE
      835               ub.chk-gds.doc-code = ub.chk-pay.doc-code
      836       BY ub.chk-gds.line-num:
      837         if   ub.chk-gds.write-off-code > 0
      838           or ub.chk-gds.doc-qnty  eq 0
      839           or ub.chk-gds.doc-qnty  eq ?
      840         then NEXT.
      841         find first buf_bar-code no-lock where
      842                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
      843         if not available buf_bar-code then do:
      844           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
      845                                                       , ub.chk-gds.b-code
      846                                                       , ub.chk-gds.doc-code
      847                                                       , ub.chk-doc.obj-type
      848                                                       , ub.chk-doc.obj-code
      849                                                       , ub.chk-gds.line-num).
      850         end.
      851         if ub.chk-gds.pump <> 0 then do:
      852           pychk_rec-type = 1.
      853           find first temp-ptrl-goods where
      854                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
      855           if not available temp-ptrl-goods then do:
      856             run gds-attr-value in this-procedure (
      857                                                    input buf_bar-code.gds-code
      858                                                   ,input 'ptrl-as-good':U
      859                                                   ,output pychk_value
      860                                                   ,output pychk_type) no-error.
      861             create temp-ptrl-goods.
      862             assign
      863             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
      864             temp-ptrl-goods.b-code = buf_bar-code.b-code
      865             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
      866             no-error.
      867           end.
      868           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
      869           release temp-ptrl-goods.
      870         end.
      871         else do:
      872           assign
      873           pychk_rec-type = 0
      874           pychk_line-type = 0
      875           .
      876         end.
      877         find first temp-chk-gds where
      878                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
      879               AND temp-chk-gds.rec-type = pychk_rec-type
      880               and temp-chk-gds.b-code = ub.chk-gds.b-code
      881               and temp-chk-gds.line-num = 0
      882               no-error.
      883         if not available temp-chk-gds then do:
      884           find first temp-chk-gds use-index ijj where
      885                   temp-chk-gds.jj_ = pychk_jj
      886               and temp-chk-gds.line-num = 0
      887                   no-error.
      888           if not available temp-chk-gds then do:
      889             create temp-chk-gds.
      890             assign
      891             temp-chk-gds.jj_ = pychk_jj
      892             temp-chk-gds.b-code = ub.chk-gds.b-code
      893             temp-chk-gds.doc-code = ub.chk-gds.doc-code
      894             temp-chk-gds.line-num = 0
      895             temp-chk-gds.rec-type = pychk_rec-type
      896             temp-chk-gds.gds-code = buf_bar-code.gds-code.
      897             .
      898           end.
      899           else do:
      900             assign
      901             temp-chk-gds.b-code = ub.chk-gds.b-code
      902             temp-chk-gds.doc-code = ub.chk-gds.doc-code
      903             temp-chk-gds.line-num = 0
      904             temp-chk-gds.rec-type = pychk_rec-type
      905             temp-chk-gds.sum = 0
      906             temp-chk-gds.jjp_ = 0
      907             temp-chk-gds.jjo_ = 0
      908             temp-chk-gds.line-type = '':U
      909             temp-chk-gds.num-lines = 0
      910             temp-chk-gds.doc-qnty = 0
      911             temp-chk-gds.sum = 0
      912             temp-chk-gds.flag  = no
      913             .
      914           end.
      915           assign
      916           temp-chk-gds.line-type = (if pychk_line-type = 1
      917                                   then 'топ':U
      918                                   else entry(1, ub.chk-gds.line-type, chr(4))
      919                                   ) + chr(4) +
      920                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
      921                                   then entry(2, ub.chk-gds.line-type, chr(4))
      922                                   else '')
      923           temp-chk-gds.line-num = 0
      924           temp-chk-gds.num-lines = 0
      925           temp-chk-gds.density   = ub.chk-gds.density
      926           pychk_jj = pychk_jj + 1
      927           .
      928           if pychk_rec-type = 1 then do:
      929             assign
      930             temp-chk-gds.jjp_ = pychk_jjp + 1
      931             pychk_jjp = pychk_jjp + 1
      932             .
      933           end.
      934           else do:
      935             assign
      936             temp-chk-gds.jjo_ = pychk_jjo + 1
      937             pychk_jjo = pychk_jjo + 1
      938             .
      939           end.
      940         end.
      941         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
      942         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
      943         assign
      944         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
      945         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
      946         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
      947         .
      948         find first temp-chk-gds use-index ijj where
      949                 temp-chk-gds.jj_ = 0
      950             and temp-chk-gds.line-num = ub.chk-gds.line-num
      951                 no-error.
      952         if not available temp-chk-gds then do:
      953           create temp-chk-gds.
      954           assign
      955           temp-chk-gds.jj_ = 0
      956           temp-chk-gds.line-num = ub.chk-gds.line-num
      957           temp-chk-gds.doc-code = ub.chk-gds.doc-code
      958           temp-chk-gds.b-code = ub.chk-gds.b-code
      959           temp-chk-gds.gds-code = buf_bar-code.gds-code
      960           temp-chk-gds.rec-type = pychk_rec-type
      961           temp-chk-gds.line-num = ub.chk-gds.line-num
      962           .
      963         end.
      964         else do:
      965           assign
      966           temp-chk-gds.doc-qnty = 0
      967           temp-chk-gds.doc-code = ub.chk-gds.doc-code
      968           temp-chk-gds.b-code = ub.chk-gds.b-code
      969           temp-chk-gds.gds-code = buf_bar-code.gds-code
      970           temp-chk-gds.rec-type = pychk_rec-type
      971           temp-chk-gds.line-num = ub.chk-gds.line-num
      972           temp-chk-gds.jjp_ = 0
      973           temp-chk-gds.jjo_ = 0
      974           temp-chk-gds.line-type = '':U
      975                   .
      976         end.
      977         assign
      978         temp-chk-gds.doc-code = ub.chk-gds.doc-code
      979         temp-chk-gds.b-code = ub.chk-gds.b-code
      980         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
      981         temp-chk-gds.price-base = ub.chk-gds.price-base
      982         temp-chk-gds.price-service = ub.chk-gds.price-service
      983         temp-chk-gds.line-type = (if pychk_line-type = 1
      984                                 then 'топ':U
      985                                 else entry(1, ub.chk-gds.line-type, chr(4))
      986                                 ) + chr(4) +
      987                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
      988                                 then entry(2, ub.chk-gds.line-type, chr(4))
      989                                 else '')
      990         temp-chk-gds.line-sign = ub.chk-gds.line-sign
      991         temp-chk-gds.discnt = ub.chk-gds.discnt
      992         temp-chk-gds.sum = vSumRound
      993         temp-chk-gds.rec-type = pychk_rec-type
      994         temp-chk-gds.line-num = ub.chk-gds.line-num
      995         temp-chk-gds.num-lines = 1
      996         temp-chk-gds.density   = ub.chk-gds.density
      997         .
      998       END.
      999       for each chk-discnt no-lock
     1000          where chk-discnt.doc-code = ub.chk-doc.doc-code
     1001            and record-type = 10
     1002            and chk-discnt.discnt-value-abs <> 0,
     1003           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     1004               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     1005                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     1006                   and temp-chk-dp.b-code = chk-gds.b-code:
     1007                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     1008                   end.
     1009               end.
     1010               else do:
     1011                   create temp-chk-dp .
     1012                   assign
     1013                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     1014                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     1015                   temp-chk-dp.line-num = chk-discnt.object-line-num
     1016                   temp-chk-dp.pay-code = chk-discnt.rank
     1017                   temp-chk-dp.b-code = chk-gds.b-code
     1018                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     1019                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     1020                   .
     1021               end.
     1022       end.
     1023     end.
     1024     FIND FIRST ub.cash-pay No-LOCK WHERE
     1025               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     1026               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     1027     if available ub.cash-pay then do:
     1028       pychk_payline_rrn = "" .
     1029       if not ub.cash-pay.is-cash then do :
     1030         for first buf_chk-pay-attr no-lock
     1031             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     1032               and buf_chk-pay-attr.attr-code = "cpdoc":U
     1033               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     1034           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     1035         end .
     1036       end .
     1037         find first temp-chk-pay where
     1038                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1039             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1040             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1041             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     1042             and temp-chk-pay.rrn       = pychk_payline_rrn
     1043                    no-error.
     1044       if not available temp-chk-pay then do:
     1045           find first temp-chk-pay where
     1046                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1047               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1048               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1049               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     1050               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     1051               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     1052               no-error.
     1053         if not  avail temp-chk-pay then do:
     1054           find first temp-chk-pay where
     1055                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1056                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     1057           if not available temp-chk-pay then do:
     1058             create temp-chk-pay.
     1059             assign
     1060             temp-chk-pay.line-num = ub.chk-pay.line-num
     1061             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1062             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1063             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     1064             temp-chk-pay.rrn       = pychk_payline_rrn
     1065             pychk_pays_count = pychk_pays_count + 1
     1066             .
     1067           end.
     1068           assign
     1069           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1070           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     1071           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1072           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     1073           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     1074           temp-chk-pay.register = ub.cash-pay.register
     1075           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1076           temp-chk-pay.tot-rubl = 0
     1077           temp-chk-pay.tot-base = 0
     1078           temp-chk-pay.num-lines = 0
     1079           temp-chk-pay.flag  = no
     1080           .
     1081         end.
     1082       end.
     1083       assign
     1084       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     1085                                                      then ub.chk-pay.tot-rubl
     1086                                                      else ub.chk-pay.tot-base)
     1087       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
     1088       temp-chk-pay.tot-base = temp-chk-pay.tot-base + ub.chk-pay.tot-base
     1089       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     1090       .
     1091     end.
     1092     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     1093     if last-of(ub.chk-pay.doc-code) then do:
     1094       for each temp-chk-pay where
     1095               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     1096          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     1097             and temp-chk-pay.tot-r-b <> 0
     1098             and abs(ub.chk-doc.netto) > 0.00000001
     1099          then do:
     1100             if not g#auto then do:
     1101                message
     1102                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     1103                             ,ub.chk-doc.doc-code
     1104                             ,chr(10)
     1105                             ,ub.chk-doc.obj-type
     1106                             ,ub.chk-doc.obj-code
     1107                             ,ub.chk-doc.shift-date
     1108                             ,ub.chk-doc.shift-num
     1109                             ,ub.chk-doc.pay-desk
     1110                             ,ub.chk-doc.chk-num)
     1111                   view-as alert-box error .
     1112             end.
     1113             next _chk-doc.
     1114          end.
     1115       end.
     1116       for each temp-chk-pay where
     1117               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1118       break
     1119       by temp-chk-pay.pet-good descending
     1120       by temp-chk-pay.line-num:
     1121          dp:
     1122          for each temp-chk-dp no-lock
     1123             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     1124               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     1125               and temp-chk-dp.sum <> 0 :
     1126               find first buf_temp-chk-gds2 where
     1127                   buf_temp-chk-gds2.doc-code = ub.chk-doc.doc-code
     1128               and buf_temp-chk-gds2.line-num  =  temp-chk-dp.line-num no-error.
     1129               if available buf_temp-chk-gds2 then
     1130               for each buf_temp-chk-gds where
     1131                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     1132                   and buf_temp-chk-gds.line-num ne 0
     1133               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     1134                    if         temp-chk-dp.all-sum  eq ?
     1135                       or abs(temp-chk-dp.all-sum) <= 0.001
     1136                   then
     1137                      next dp.
     1138                   find first  temp-chk-gds where
     1139                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1140                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     1141                     and temp-chk-gds.line-num = 0
     1142                   no-error .
     1143                   if not available temp-chk-gds then next dp.
     1144                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     1145                       when 1 then do:
     1146                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     1147                       end.
     1148                       when 2 then do:
     1149                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     1150                       end.
     1151                   end case.
     1152                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     1153                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     1154                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     1155                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     1156                   then
     1157                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     1158                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     1159                   if can-find (first buf_chk-gds-pay no-lock where
     1160                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1161                                  and buf_chk-gds-pay.algo-num = "1.8"
     1162                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1163                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1164                                      )
     1165                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1166                                                       , temp-chk-pay.doc-code
     1167                                                       , ub.chk-doc.obj-type
     1168                                                       , ub.chk-doc.obj-code
     1169                                                       , buf_temp-chk-gds.line-num
     1170                                                       , temp-chk-pay.line-num).
     1171                   create buf_chk-gds-pay.
     1172                     assign
     1173                     buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1174                     buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     1175                     buf_chk-gds-pay.algo-num = "1.8"
     1176                     buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     1177                     buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     1178                     buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1179                     buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1180                     buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     1181                     buf_chk-gds-pay.tot-r-b =  pychk_dop-sumk
     1182                     buf_chk-gds-pay.eff-base-rate = 1
     1183                     buf_chk-gds-pay.eff-doc-qnty = (if (temp-chk-gds.num-lines = 1
     1184                                                     and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1185                                                     and pychk_pays_count = 1)
     1186                                                     or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     1187                                                     then temp-chk-gds.doc-qnty
     1188                                                     else (buf_chk-gds-pay.tot-r-b / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     1189                                                     )
     1190                     buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     1191                     buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     1192                     buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     1193                     buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     1194                     buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     1195                     buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     1196                     buf_chk-gds-pay.line-type = pychk_line-type-chr
     1197                     buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     1198                     buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     1199                     buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     1200                     buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     1201                     buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     1202                     buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     1203                     buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     1204                     buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     1205                     buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     1206                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     1207                     .
     1208                   assign
     1209                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     1210                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     1211                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     1212                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     1213                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     1214                   .
     1215                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     1216               end.
     1217           end.
     1218         assign
     1219         pychk_dop-sump = temp-chk-pay.tot-r-b
     1220         pychk_exch = if pychk_No-exch then 1
     1221                      else (if temp-chk-pay.tot-base = 0
     1222                            then 0
     1223                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     1224         pychk_exch-rubl = if pychk_No-exch-rubl
     1225                           then 1
     1226                           else (if temp-chk-pay.tot-base = 0
     1227                                 then 0
     1228                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     1229         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     1230         .
     1231         _repeat:
     1232         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     1233           if pychk_dop-sumg = 0 then do:
     1234             assign
     1235             pychk_kk = pychk_kk + 1
     1236             .
     1237             if pychk_kk >= pychk_jj then LEAVE _repeat.
     1238             if pychk_kk <= pychk_jjp then do:
     1239               find first temp-chk-gds where
     1240                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1241                     and temp-chk-gds.jjp_ = pychk_kk
     1242                     and temp-chk-gds.line-num = 0
     1243                   no-error .
     1244             end.
     1245             else do:
     1246               find first temp-chk-gds where
     1247                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1248                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     1249                     and temp-chk-gds.line-num = 0
     1250                   no-error .
     1251             end.
     1252             if not available temp-chk-gds
     1253             or (temp-chk-gds.sum = 0
     1254                 or
     1255                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     1256                 )
     1257             then do:
     1258               NEXT _repeat.
     1259             end.
     1260             assign
     1261             pychk_dop-sumg = if available temp-chk-gds then temp-chk-gds.sum else 0
     1262             temp-chk-gds.flag = yes
     1263             .
     1264           end.
     1265           assign
     1266           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     1267           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     1268           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     1269           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     1270           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     1271           .
     1272           if pychk_sum-promo <> 0 then
     1273              vPromoLineNum = GetPromoPriceLine(ub.chk-doc.doc-code).
     1274           else vPromoLineNum = 0.
     1275           for each buf_temp-chk-gds where
     1276                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1277               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     1278               and buf_temp-chk-gds.line-num  > 0
     1279           by buf_temp-chk-gds.doc-code
     1280           by buf_temp-chk-gds.rec-type descending
     1281           by buf_temp-chk-gds.line-num
     1282            :
     1283             case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     1284               when 1 then do:
     1285                 pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     1286               end.
     1287               when 2 then do:
     1288                 pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     1289               end.
     1290             end case.
     1291             if  vPromoLineNum <> 0 and
     1292                 temp-chk-gds.num-lines > 1 and
     1293                 buf_temp-chk-gds.line-num = vPromoLineNum and
     1294                 can-find(first buf_chk-gds-pay no-lock where
     1295                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     1296                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     1297             then .
     1298             else
     1299             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     1300                 if vPromoLineNum <> 0 and
     1301                    buf_temp-chk-gds.line-num = vPromoLineNum
     1302                 then do:
     1303                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     1304                 end.
     1305                 else if vPromoLineNum <> 0 and
     1306                         temp-chk-gds.num-lines > 1 and
     1307                         pychk_sum-promo <> 0 and
     1308                         ChkPromoLine(buf_temp-chk-gds.doc-code, buf_temp-chk-gds.line-num)
     1309                 then do:
     1310                     if can-find(first buf_chk-gds-pay no-lock where
     1311                                       buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1312                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     1313                                   )
     1314                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     1315                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     1316                 end.
     1317                 else
     1318                 vSum                     = (if    temp-chk-gds.num-lines = 1
     1319                                               and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1320                                             then pychk_dop-sumk
     1321                                             else (pychk_dop-sumk * buf_temp-chk-gds.sum / temp-chk-gds.sum)
     1322                                            )
     1323                 .
     1324                 if can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code) then do:
     1325                     find first buf_chk-gds-pay where buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1326                     and buf_chk-gds-pay.algo-num = "1.8"
     1327                     and buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     1328                     and buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     1329                     and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1330                     and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     1331                     and buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card exclusive-lock no-error.
     1332                     if not available buf_chk-gds-pay then do:
     1333                        if can-find (first buf_chk-gds-pay no-lock where
     1334                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1335                                  and buf_chk-gds-pay.algo-num = "1.8"
     1336                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1337                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1338                                      )
     1339                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1340                                                       , temp-chk-pay.doc-code
     1341                                                       , ub.chk-doc.obj-type
     1342                                                       , ub.chk-doc.obj-code
     1343                                                       , buf_temp-chk-gds.line-num
     1344                                                       , temp-chk-pay.line-num).
     1345                        create buf_chk-gds-pay.
     1346                     end.
     1347                 end.
     1348                 else do:
     1349                      if can-find (first buf_chk-gds-pay no-lock where
     1350                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1351                                  and buf_chk-gds-pay.algo-num = "1.8"
     1352                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1353                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1354                                      )
     1355                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1356                                                       , temp-chk-pay.doc-code
     1357                                                       , ub.chk-doc.obj-type
     1358                                                       , ub.chk-doc.obj-code
     1359                                                       , buf_temp-chk-gds.line-num
     1360                                                       , temp-chk-pay.line-num).
     1361                      create buf_chk-gds-pay.
     1362                 end.
     1363                 assign
     1364                 buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1365                 buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     1366                 buf_chk-gds-pay.algo-num = "1.8"
     1367                 buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     1368                 buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     1369                 buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1370                 buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     1371                 buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     1372                 buf_chk-gds-pay.tot-r-b = buf_chk-gds-pay.tot-r-b  + vSum
     1373                 buf_chk-gds-pay.eff-base-rate = pychk_exch
     1374                 buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     1375                 buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     1376                 buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     1377                 buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     1378                 buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     1379                 buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     1380                 buf_chk-gds-pay.line-type = pychk_line-type-chr
     1381                 buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     1382                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     1383                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     1384                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     1385                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     1386                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     1387                 buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     1388                 buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     1389                 buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     1390                 buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     1391                 buf_temp-chk-gds.flag = yes
     1392                 .
     1393                 if buf_temp-chk-gds.line-num = vPromoLineNum
     1394                 then do:
     1395                    buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty.
     1396                 end.
     1397                 else
     1398                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     1399                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1400                                                 and pychk_pays_count = 1)
     1401                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     1402                                                 then temp-chk-gds.doc-qnty
     1403                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     1404                                                 )
     1405                 .
     1406               end.
     1407           end.
     1408         end.
     1409       end.
     1410       if available temp-chk-gds then release temp-chk-gds.
     1411       if available temp-chk-pay then release temp-chk-pay.
     1412       pychk_zero-gds = 0.
     1413       pychk_zero-pay = 0.
     1414       for each temp-chk-gds where
     1415               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     1416           and temp-chk-gds.flag = no
     1417           and temp-chk-gds.line-num  > 0
     1418           :
     1419          pychk_zero-gds = pychk_zero-gds + 1.
     1420       end.
     1421       for each temp-chk-pay where
     1422               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1423           and temp-chk-pay.flag = no:
     1424          pychk_zero-pay = pychk_zero-pay + 1.
     1425       end.
     1426       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1427                                 and temp-chk-pay.flag = no
     1428       no-lock no-error.
     1429       if not available temp-chk-pay
     1430       then do:
     1431          block-pay:
     1432          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     1433             assign
     1434                pychk_zero-pay = pychk_zero-pay +  1
     1435                temp-chk-pay.flag = no
     1436             .
     1437             leave block-pay.
     1438          end.
     1439       end.
     1440       for each temp-chk-pay
     1441       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1442           and temp-chk-pay.flag = no:
     1443         pychk_zero-n = 0.
     1444         for each buf_temp-chk-gds
     1445         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     1446             and buf_temp-chk-gds.flag = no
     1447             and buf_temp-chk-gds.line-num  > 0 :
     1448           pychk_zero-n = pychk_zero-n + 1.
     1449           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     1450           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     1451             when 1 then do:
     1452               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     1453             end.
     1454             when 2 then do:
     1455               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     1456             end.
     1457           end case.
     1458           if can-find(first buf_chk-gds-pay no-lock where
     1459                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1460                         and buf_chk-gds-pay.algo-num = "1.8"
     1461                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1462                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     1463           then do:
     1464               buf_temp-chk-gds.flag = yes.
     1465           end.
     1466           else do:
     1467               create buf_chk-gds-pay.
     1468               assign
     1469               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1470               buf_chk-gds-pay.algo-num = "1.8"
     1471               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     1472               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     1473               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1474               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     1475               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     1476               buf_chk-gds-pay.tot-r-b = 0
     1477               buf_chk-gds-pay.eff-base-rate = pychk_exch
     1478               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     1479               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     1480               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     1481               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     1482               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     1483               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     1484               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     1485               buf_chk-gds-pay.line-type = pychk_line-type-chr
     1486               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     1487               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     1488               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     1489               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     1490               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     1491               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     1492               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     1493               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     1494               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     1495               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     1496               buf_temp-chk-gds.flag = yes
     1497               .
     1498           end.
     1499           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     1500         end.
     1501         temp-chk-pay.flag = yes.
     1502       end.
     1503     end.
     1504   end.
     1505   end.
     1506    end.
