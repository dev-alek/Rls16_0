      169     define variable v-cntxt-db-num-obj    as integer   no-undo .
      170     define variable v-cntxt-is-admin      as logical   no-undo .
      171   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      172   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      173   define variable pychk_kk as integer no-undo .
