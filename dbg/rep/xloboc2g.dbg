     2644   procedure display-bo  :
     2645   define variable ll as int no-undo.
     2646   define variable kk as int no-undo.
     2647     num#str# = num#str# + 1.
     2648     num#col# = 1.
     2649     run macr_excel_char ( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     2650     num#col#  = 0 .
     2651     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     2652     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     2653     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     2654     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     2655     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     2656     run macr_cell_format
     2657         ( 10    ,
     2658           true  ,
     2659           false ,
     2660           ?    ,
     2661           num#str# ,
     2662           1 ,
     2663           num#str# ,
     2664           (mp + ll + (kk * (27 - 8)))
     2665           ) .
     2666   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2667   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2668   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2669   def var l-nk as integer no-undo .
     2670     Assign
     2671       LL = 0
     2672       KK = 1
     2673     .
     2674     if xShowCost      Then DO: KK = KK + 1. End.
     2675     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2676     if xShowCrsa      Then DO: KK = KK + 1. End.
     2677     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2678     if xShowSale      Then DO: KK = KK + 1. End.
     2679     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2680     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2681     if xShowmediator  Then DO: KK = KK + 1. End.
     2682     if x-tog-wt       then do: KK = KK + 1. End.
     2683     if x-tog-ms       then do: KK = KK + 1. End.
     2684     if xDens          then do: KK = KK + 1. End.
     2685     repeat i = 1 to 13 :
     2686       if i = 7 then next.
     2687       if NOT xShowCost      and i = 2   Then  next.
     2688       if NOT xShowCostNDS   and i = 3   Then  next.
     2689       if NOT xShowCrsa      and i = 5   Then  next.
     2690       if NOT xShowCrsaNds   and i = 6   Then  next.
     2691       if NOT xShowSale      and i = 8   Then  next.
     2692       if NOT xShowSaleNds   and i = 9   Then  next.
     2693       if NOT xShowSaleSlt   and i = 10  Then  next.
     2694       if NOT xShowmediator  and i = 4   Then  next.
     2695       if not x-tog-wt       and i = 11  then  next.
     2696       if not x-tog-ms       and i = 12  then  next.
     2697       if not xDens          and i = 13  then  next.
     2698       assign
     2699         LL = LL + 1
     2700         l-nk = mp-1
     2701       .
     2702     if x-vat or i <> 2  then do:
     2703     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
     2704     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ie          [i] ,  i). end.
     2705     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-iv          [i] ,  i). end.
     2706     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-im           [i] ,  i). end.
     2707     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ee          [i] ,  i). end.
     2708     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ev          [i] ,  i). end.
     2709     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-em           [i] ,  i). end.
     2710     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-we          [i] ,  i). end.
     2711     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-es     [i] ,  i). end.
     2712     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rs [i] ,  i). end.
     2713     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-re      [i] ,  i). end.
     2714     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ep       [i] ,  i). end.
     2715     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rv      [i] ,  i). end.
     2716     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-vt                [i] ,  i). end.
     2717     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ot           [i] ,  i). end.
     2718     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-end                            [i] ,  i). end.
     2719     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ap [i] ,  i). end.
     2720     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-pc [i] ,  i). end.
     2721     if i = 13 then do:
     2722       if "bo-" = "b1-" or "bo-" = "b2-" or "bo-" = "bi-" or "bo-" = "bo-" then do:
     2723          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     2724       end.
     2725       else do:
     2726         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bo-oborot-ee         [1] +
     2727                                                                                                                                       bo-oborot-re     [1] +
     2728                                                                                                                                       bo-oborot-es    [1] +
     2729                                                                                                                                       bo-oborot-rs[1] ) <> 0
     2730                                                                                                                               then
     2731                                                                                                                                   ABS(bo-oborot-ee         [11] +
     2732                                                                                                                                       bo-oborot-re     [11] +
     2733                                                                                                                                       bo-oborot-es    [11] +
     2734                                                                                                                                       bo-oborot-rs[11] )
     2735                                                                                                                                   /
     2736                                                                                                                                   ABS(bo-oborot-ee         [1] +
     2737                                                                                                                                       bo-oborot-re     [1] +
     2738                                                                                                                                       bo-oborot-es    [1] +
     2739                                                                                                                                       bo-oborot-rs[1] )
     2740                                                                                                                               else 0 )
     2741         ,  i). end.
     2742       end.
     2743     end.
     2744     else do:
     2745     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bo-oborot-ee         [i] +
     2746                                                                                                                           bo-oborot-re     [i] +
     2747                                                                                                                           bo-oborot-es    [i] +
     2748                                                                                                                           bo-oborot-rs[i] )
     2749     ,  i). end.
     2750     end.
     2751     end.
     2752     if x-vat = false  and i = 2 then do:
     2753     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-start                          [i] -  bo-ostatok-start                          [3] ),  i). end.
     2754     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ie          [i] -  bo-oborot-ie          [3] ),  i). end.
     2755     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-iv          [i] -  bo-oborot-iv          [3] ),  i). end.
