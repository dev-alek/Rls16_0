     2766     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-vt                [i] -  bo-oborot-vt                [3] ),  i). end.
