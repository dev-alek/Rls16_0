     2327    ostatok-end [2 + 3]   = if tprintrubl then coast_r else coast_v
     2328    ostatok-end [3 + 3]   = if tprintrubl then vat_r   else vat_v
     2329    .
     2330      end.
     2331   if xshowsale or xshowsalends or xshowsaleslt then do :
