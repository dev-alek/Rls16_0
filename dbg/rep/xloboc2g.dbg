     2763     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-re      [i] -  bo-oborot-re      [3] ),  i). end.
