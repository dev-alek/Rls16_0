     2441   procedure display-line :
     2442   end procedure.
     2443   procedure print-header :
     2444     assign
     2445        firstline = true
     2446        num#str#  = num#str#  + 1
     2447        num#col# = 1
     2448     .
     2449       if xtog-obj and x-selectobject <> "currency":u   then  do :
     2450          run macr_excel_char( string("ПО ОБЪЕКТУ : " + caps(objname) )  , num#str# , num#col#  ) .
     2451       end.
     2452         run clear-b1 in this-procedure .
     2453         run clear-b2 in this-procedure .
     2454         run clear-bi in this-procedure .
     2455         break_group = true.
     2456         break_group1 = true.
     2457      end procedure.
     2458   procedure print-footer :
     2459        num#str# = num#str# + 1.
     2460        num#col# = 1.
     2461        run macr_excel_char( string("ИТОГО"  )  , num#str# , num#col#  ) .
     2462        run display-bi in this-procedure .
     2463   end procedure.
     2464   procedure calcitog :
     2465       run ostatok  in this-procedure (
     2466           input x-store-code  ,
     2467           input x-store-type  , x-tog-shift ,
     2468           input x-date-start - 1 ,
     2469           input date('')      , ?, ?,
     2470           input 'crsa':U   ,
     2471           input '##,##':U,
     2472           input xtog-obj ,
     2473           output  quantity1  ,
     2474           output  coast_r1   ,
     2475           output  coast_v1   ,
     2476           output  vat_r1     ,
     2477           output  vat_v1     ,
     2478           output  fact-order-1 ).
     2479       run ostatok  in this-procedure (
     2480           input x-store-code  ,
     2481           input x-store-type  , x-tog-shift ,
     2482           input x-date-start  ,
     2483           input x-date-end    ,  ?, ?,
     2484           input 'crsa':U   ,
     2485           input '##,##':U,
     2486           input xtog-obj ,
     2487           output  quantity1  ,
     2488           output  coast_r1   ,
     2489           output  coast_v1   ,
     2490           output  vat_r1     ,
     2491           output  vat_v1     ,
     2492           output  fact-order-2 ).
     2493             quantity1  = 0.
     2494             coast_r1   = 0.
     2495             coast_v1   = 0.
     2496             vat_r1     = 0.
     2497             vat_v1     = 0.
     2498   end procedure.
     2499   procedure display-str1  :
     2500    end procedure.
     2501   procedure display-bi  :
     2502   define variable ll as int no-undo.
     2503   define variable kk as int no-undo.
     2504     num#col#  = 0 .
     2505     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     2506     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     2507     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     2508     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     2509     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     2510     run macr_cell_format
     2511                                 ( 10    ,
     2512                                   true  ,
     2513                                   false ,
     2514                                   ?    ,
     2515                                   num#str# ,
     2516                                   1 ,
     2517                                   num#str# ,
     2518                                   (mp + ll + (kk * (27 - 8)))
     2519                                   ) .
     2520   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2521   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2522   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2523   def var l-nk as integer no-undo .
     2524     Assign
     2525       LL = 0
     2526       KK = 1
     2527     .
     2528     if xShowCost      Then DO: KK = KK + 1. End.
     2529     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2530     if xShowCrsa      Then DO: KK = KK + 1. End.
     2531     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2532     if xShowSale      Then DO: KK = KK + 1. End.
     2533     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2534     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2535     if xShowmediator  Then DO: KK = KK + 1. End.
     2536     if x-tog-wt       then do: KK = KK + 1. End.
     2537     if x-tog-ms       then do: KK = KK + 1. End.
     2538     if xDens          then do: KK = KK + 1. End.
     2539     repeat i = 1 to 13 :
     2540       if i = 7 then next.
     2541       if NOT xShowCost      and i = 2   Then  next.
     2542       if NOT xShowCostNDS   and i = 3   Then  next.
     2543       if NOT xShowCrsa      and i = 5   Then  next.
     2544       if NOT xShowCrsaNds   and i = 6   Then  next.
     2545       if NOT xShowSale      and i = 8   Then  next.
     2546       if NOT xShowSaleNds   and i = 9   Then  next.
     2547       if NOT xShowSaleSlt   and i = 10  Then  next.
     2548       if NOT xShowmediator  and i = 4   Then  next.
     2549       if not x-tog-wt       and i = 11  then  next.
     2550       if not x-tog-ms       and i = 12  then  next.
     2551       if not xDens          and i = 13  then  next.
     2552       assign
     2553         LL = LL + 1
     2554         l-nk = mp-1
     2555       .
     2556     if x-vat or i <> 2  then do:
     2557     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     2558     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
     2559     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-iv          [i] ,  i). end.
     2560     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-im           [i] ,  i). end.
     2561     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ee          [i] ,  i). end.
     2562     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ev          [i] ,  i). end.
     2563     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-em           [i] ,  i). end.
     2564     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-we          [i] ,  i). end.
     2565     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-es     [i] ,  i). end.
     2566     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-rs [i] ,  i). end.
     2567     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-re      [i] ,  i). end.
     2568     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ep       [i] ,  i). end.
     2569     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-rv      [i] ,  i). end.
     2570     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-vt                [i] ,  i). end.
     2571     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ot           [i] ,  i). end.
     2572     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-end                            [i] ,  i). end.
     2573     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ap [i] ,  i). end.
     2574     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-pc [i] ,  i). end.
     2575     if i = 13 then do:
     2576       if "bi-" = "b1-" or "bi-" = "b2-" or "bi-" = "bi-" or "bi-" = "bo-" then do:
     2577          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     2578       end.
     2579       else do:
     2580         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bi-oborot-ee         [1] +
     2581                                                                                                                                       bi-oborot-re     [1] +
     2582                                                                                                                                       bi-oborot-es    [1] +
     2583                                                                                                                                       bi-oborot-rs[1] ) <> 0
     2584                                                                                                                               then
     2585                                                                                                                                   ABS(bi-oborot-ee         [11] +
     2586                                                                                                                                       bi-oborot-re     [11] +
     2587                                                                                                                                       bi-oborot-es    [11] +
     2588                                                                                                                                       bi-oborot-rs[11] )
     2589                                                                                                                                   /
     2590                                                                                                                                   ABS(bi-oborot-ee         [1] +
     2591                                                                                                                                       bi-oborot-re     [1] +
     2592                                                                                                                                       bi-oborot-es    [1] +
     2593                                                                                                                                       bi-oborot-rs[1] )
     2594                                                                                                                               else 0 )
     2595         ,  i). end.
     2596       end.
     2597     end.
     2598     else do:
     2599     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bi-oborot-ee         [i] +
     2600                                                                                                                           bi-oborot-re     [i] +
     2601                                                                                                                           bi-oborot-es    [i] +
     2602                                                                                                                           bi-oborot-rs[i] )
     2603     ,  i). end.
     2604     end.
     2605     end.
     2606     if x-vat = false  and i = 2 then do:
     2607     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-ostatok-start                          [i] -  bi-ostatok-start                          [3] ),  i). end.
     2608     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ie          [i] -  bi-oborot-ie          [3] ),  i). end.
     2609     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-iv          [i] -  bi-oborot-iv          [3] ),  i). end.
     2610     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-im           [i] -  bi-oborot-im           [3] ),  i). end.
     2611     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ee          [i] -  bi-oborot-ee          [3] ),  i). end.
     2612     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ev          [i] -  bi-oborot-ev          [3] ),  i). end.
     2613     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-em           [i] -  bi-oborot-em           [3] ),  i). end.
     2614     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-we          [i] -  bi-oborot-we          [3] ),  i). end.
     2615     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-es     [i] -  bi-oborot-es     [3] ),  i). end.
     2616     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rs [i] -  bi-oborot-rs [3] ),  i). end.
     2617     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-re      [i] -  bi-oborot-re      [3] ),  i). end.
     2618     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ep       [i] -  bi-oborot-ep       [3] ),  i). end.
