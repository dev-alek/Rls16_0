     4199   procedure calc-s-itog :
     4200   define variable n-1 as integer no-undo .
     4201       do n-1 = 1 to 13 :
     4202       assign
     4203         bi-oborot-ie        [n-1]  =bi-oborot-ie        [n-1]  + b1-oborot-ie        [n-1]
     4204         bi-oborot-ee       [n-1]  =bi-oborot-ee       [n-1]  + b1-oborot-ee       [n-1]
     4205         bi-oborot-ep     [n-1]  =bi-oborot-ep     [n-1]  + b1-oborot-ep     [n-1]
     4206         bi-oborot-es    [n-1]  =bi-oborot-es    [n-1]  + b1-oborot-es    [n-1]
     4207         bi-oborot-re    [n-1]  =bi-oborot-re    [n-1]  + b1-oborot-re    [n-1]
     4208         bi-oborot-rs[n-1] = bi-oborot-rs[n-1]  + b1-oborot-rs[n-1]
     4209         bi-oborot-we[n-1]  =bi-oborot-we[n-1]  + b1-oborot-we[n-1]
     4210         bi-oborot-vt [n-1]  =bi-oborot-vt [n-1]  + b1-oborot-vt [n-1]
     4211         bi-oborot-iv  [n-1]  =bi-oborot-iv  [n-1]  + b1-oborot-iv  [n-1]
     4212         bi-oborot-ev  [n-1]  =bi-oborot-ev  [n-1]  + b1-oborot-ev  [n-1]
     4213         bi-oborot-rv  [n-1]  =bi-oborot-rv  [n-1]  + b1-oborot-rv  [n-1]
     4214         bi-oborot-em  [n-1]  =bi-oborot-em  [n-1]  + b1-oborot-em  [n-1]
     4215         bi-oborot-wm  [n-1]  =bi-oborot-wm  [n-1]  + b1-oborot-wm  [n-1]
     4216         bi-oborot-im  [n-1]  =bi-oborot-im  [n-1]  + b1-oborot-im  [n-1]
     4217         bi-oborot-ot  [n-1]  =bi-oborot-ot  [n-1]  + b1-oborot-ot  [n-1]
     4218         bi-oborot-pc  [n-1]  =bi-oborot-pc  [n-1]  + b1-oborot-pc [n-1]
     4219         bi-oborot-ap  [n-1]  =bi-oborot-ap  [n-1]  + b1-oborot-ap [n-1]
     4220         bi-oborot-disc                           [n-1]  =bi-oborot-disc                           [n-1]  + b1-oborot-disc                           [n-1]
     4221         bi-oborot-sum-sale                       [n-1]  =bi-oborot-sum-sale                       [n-1]  + b1-oborot-sum-sale                       [n-1]
     4222         bi-oborot-sum-cost                       [n-1]  =bi-oborot-sum-cost                       [n-1]  + b1-oborot-sum-cost                       [n-1]
     4223         bi-ostatok-start                         [n-1]  =bi-ostatok-start                     [n-1]  + b1-ostatok-start                         [n-1]
     4224         bi-ostatok-end                           [n-1]  =bi-ostatok-end                       [n-1]  + b1-ostatok-end                           [n-1]
     4225         bo-oborot-ie        [n-1]  =bo-oborot-ie        [n-1]  + b1-oborot-ie        [n-1]
     4226         bo-oborot-ee       [n-1]  =bo-oborot-ee       [n-1]  + b1-oborot-ee       [n-1]
     4227         bo-oborot-ep     [n-1]  =bo-oborot-ep     [n-1]  + b1-oborot-ep     [n-1]
     4228         bo-oborot-es    [n-1]  =bo-oborot-es    [n-1]  + b1-oborot-es    [n-1]
     4229         bo-oborot-re    [n-1]  =bo-oborot-re    [n-1]  + b1-oborot-re    [n-1]
     4230         bo-oborot-rs[n-1] = bo-oborot-rs[n-1]  + b1-oborot-rs[n-1]
     4231         bo-oborot-we[n-1]  =bo-oborot-we[n-1]  + b1-oborot-we[n-1]
     4232         bo-oborot-vt [n-1]  =bo-oborot-vt [n-1]  + b1-oborot-vt [n-1]
     4233         bo-oborot-iv  [n-1]  =bo-oborot-iv  [n-1]  + b1-oborot-iv  [n-1]
     4234         bo-oborot-ev  [n-1]  =bo-oborot-ev  [n-1]  + b1-oborot-ev  [n-1]
     4235         bo-oborot-rv  [n-1]  =bo-oborot-rv  [n-1]  + b1-oborot-rv  [n-1]
     4236         bo-oborot-em  [n-1]  =bo-oborot-em  [n-1]  + b1-oborot-em  [n-1]
     4237         bo-oborot-wm  [n-1]  =bo-oborot-wm  [n-1]  + b1-oborot-wm  [n-1]
     4238         bo-oborot-im  [n-1]  =bo-oborot-im  [n-1]  + b1-oborot-im  [n-1]
     4239         bo-oborot-ot  [n-1]  =bo-oborot-ot  [n-1]  + b1-oborot-ot  [n-1]
     4240         bo-oborot-pc  [n-1]  =bo-oborot-pc  [n-1]  + b1-oborot-pc [n-1]
     4241         bo-oborot-ap  [n-1]  =bo-oborot-ap  [n-1]  + b1-oborot-ap [n-1]
     4242         bo-oborot-disc                           [n-1]  =bo-oborot-disc                           [n-1]  + b1-oborot-disc                           [n-1]
     4243         bo-oborot-sum-sale                       [n-1]  =bo-oborot-sum-sale                       [n-1]  + b1-oborot-sum-sale                       [n-1]
     4244         bo-oborot-sum-cost                       [n-1]  =bo-oborot-sum-cost                       [n-1]  + b1-oborot-sum-cost                       [n-1]
     4245         bo-ostatok-start                         [n-1]  =bo-ostatok-start                     [n-1]  + b1-ostatok-start                         [n-1]
     4246         bo-ostatok-end                           [n-1]  =bo-ostatok-end                       [n-1]  + b1-ostatok-end                           [n-1]
     4247       .
     4248       end.
     4249   end procedure.
     4250   procedure pp :
     4251   define input parameter ll as integer no-undo .
     4252   define input parameter uu as integer no-undo .
     4253   define input parameter ff as character no-undo .
     4254   if ll > g-ll then return.
     4255   if ll < 1 then return.
     4256     for each   ub.gds-grp no-lock where ub.gds-grp.lvl-num = ll
     4257         and    ub.gds-grp.upper-code = uu
     4258         :
     4259          id = id + 1 .
     4260               create tmp-gds.
     4261               assign
     4262                 tmp-gds.id        = id
     4263                 tmp-gds.name      = (if ll = 1 then "" else fill("_",ll)) + ub.gds-grp.node-name + chr(47)
     4264                 tmp-gds.f-name    = ff + ub.gds-grp.node-name + chr(47)
     4265                 tmp-gds.node-code = ub.gds-grp.node-code
     4266                 tmp-gds.lvl = ub.gds-grp.lvl-num
     4267                 .
     4268               run pp in this-procedure (ll + 1 , ub.gds-grp.node-code , tmp-gds.f-name ).
     4269     End.
     4270   End procedure.
     4271   procedure ppgrp :
     4272   define input parameter ll as integer no-undo .
     4273   define input parameter uu as integer no-undo .
     4274   define input parameter ff as character no-undo .
     4275   if ll > g-ll then return.
     4276   if ll < 1 then return.
     4277     for each   ub.gds-grp no-lock where ub.gds-grp.lvl-num = ll
     4278         and    ub.gds-grp.upper-code = uu
     4279         :
     4280          id = id + 1 .
     4281               create tmp-gds.
     4282               assign
     4283                 tmp-gds.id        = id
     4284                 tmp-gds.name      = (if ll = 1 then "" else fill("_",ll)) + ub.gds-grp.node-name + chr(47)
     4285                 tmp-gds.f-name    = ff + ub.gds-grp.node-name + chr(47)
     4286                 tmp-gds.node-code = ub.gds-grp.node-code
     4287                 tmp-gds.lvl = ub.gds-grp.lvl-num
     4288                 .
     4289               run pp in this-procedure (ll + 1 , ub.gds-grp.node-code , tmp-gds.f-name ).
     4290     End.
     4291   End procedure.
     4292   procedure find-last-prise-med :
     4293   define input parameter p-artic     like ub.goods.artic no-undo .
     4294   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     4295   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     4296   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     4297   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     4298   define buffer p-gds-obj   for  ub.gds-obj .
     4299   define buffer buf_trn-doc for  ub.trn-doc .
     4300   define variable v-fact-order as decimal no-undo .
     4301   p-price = 0 .
     4302     define variable v-in-date as date      no-undo .
     4303     define variable fl as logical no-undo .
     4304     fl = yes.
     4305     v-fact-order = 0 .
     4306     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     4307     :
     4308       find first p-gds-obj no-lock
     4309         where p-gds-obj.artic     = p-artic         and
     4310                 p-gds-obj.prod-type = p-prod-type     and
     4311                 p-gds-obj.prod-code = p-prod-code     and
     4312                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     4313                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     4314         no-error .
     4315       if available p-gds-obj then do:
     4316       if p-gds-obj.in-date = ?  then next .
     4317       if fl = yes then do:
     4318         assign
     4319           v-in-date = p-gds-obj.in-date
     4320           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4321           fl = no
     4322       .
     4323        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     4324        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     4325       end.
     4326         if p-gds-obj.in-date >= v-in-date   then do:
     4327            if p-gds-obj.in-date = v-in-date then do:
     4328               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     4329               if available buf_trn-doc  then
     4330                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     4331                     assign
     4332                       v-fact-order = buf_trn-doc.fact-order
     4333                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4334                       v-in-date =   p-gds-obj.in-date
     4335                     .
     4336                   end.
     4337            end.
     4338            else do:
     4339             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     4340             if available buf_trn-doc  then
     4341                 assign
     4342                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4343                   v-in-date =    p-gds-obj.in-date
     4344                   v-fact-order = buf_trn-doc.fact-order .
     4345                 .
     4346             end.
     4347           if p-price = ? then   p-price  = 0 .
     4348         end.
     4349       end.
     4350     End .
     4351     if p-price = ? then   p-price  = 0 .
     4352   end procedure.
     4353   procedure find-mediator :
     4354   define input  parameter c-host-code as integer no-undo .
     4355   define input  parameter p-Showmediatr as logical no-undo .
     4356   define output parameter p-host-code as integer no-undo .
     4357   define output parameter p-flag as logical no-undo .
     4358   define buffer b-sysconf  for ub.sysconf.
     4359    p-host-code = 0 .
     4360    p-flag  = true .
     4361       if p-Showmediatr = true then do:
     4362       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     4363             if avail ub.sysconf then DO :
     4364               p-host-code = ub.sysconf.host-code.
     4365               if tPrintRubl = false then do:
     4366                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     4367                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     4368                                 p-flag  = false  .
     4369                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     4370                                 view-as alert-box error.
     4371                           end.
     4372               end.
     4373             end.
     4374             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     4375                 create tt-obj-list no-error .
     4376                 assign tt-obj-list.obj-type = 'маг':U
     4377                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     4378             end.
     4379             for each ub.store no-lock where ub.store.host-code = p-host-code :
     4380                 create tt-obj-list no-error .
     4381                 assign tt-obj-list.obj-type = 'скл':U
     4382                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     4383             end.
     4384       End.
     4385    End procedure .
     4386   PROCEDURE ob-line-stk  :
     4387   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     4388   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     4389   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     4390   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     4391   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     4392   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     4393   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     4394   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     4395   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     4396   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     4397   define input  parameter xTog-obj         as log                     no-undo.
     4398   define input  parameter xi               as int                     no-undo.
     4399   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     4400   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     4401   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     4402   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     4403   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     4404   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     4405   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     4406   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     4407   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     4408   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     4409   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     4410   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     4411   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     4412   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     4413   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     4414   define buffer stk-line2 for ub.stk-line .
     4415   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     4416    Assign
     4417      First-qnty  = 0
     4418      Second-qnty = 0
     4419      Quntity     = 0
     4420      First-sum  = 0
     4421      Second-sum = 0
     4422      sum        = 0
     4423      First-vat  = 0
     4424      Second-vat = 0
     4425      vat        = 0
     4426      First-slt   = 0
     4427      Second-slt  = 0
     4428      slt         = 0
     4429      First-disc  = 0
     4430      Second-disc = 0
     4431      disc        = 0
     4432     .
     4433     For each obj-list  no-lock :
     4434      if  xTog-obj THEN
     4435          if   NOT(    x-store-type     = obj-list.obj-type
     4436               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     4437      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     4438         find last ub.stk-line no-lock
     4439           where ub.stk-line.obj-type   = obj-list.obj-type
     4440             and ub.stk-line.obj-code   = obj-list.obj-code
     4441             and ub.stk-line.artic      = x-artic
     4442             and ub.stk-line.prod-type  = x-prod-type
     4443             and ub.stk-line.prod-code  = x-prod-code
     4444             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     4445             and ub.stk-line.cat-id     = '##,##':U
     4446             and ub.stk-line.fact-order <= x-fact-order-1
     4447           use-index category
     4448           no-error .
     4449         if available ub.stk-line then do:
     4450           assign
     4451             First-qnty = First-qnty + ub.stk-line.fact-qnty
     4452             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     4453             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     4454             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     4455             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     4456           .
     4457         end.
     4458         find last stk-line2 no-lock
     4459           where stk-line2.obj-code   = obj-list.obj-code
     4460             and stk-line2.obj-type   = obj-list.obj-type
     4461             and stk-line2.artic      = x-artic
     4462             and stk-line2.prod-type  = x-prod-type
     4463             and stk-line2.prod-code  = x-prod-code
     4464             and stk-line2.sum-type   = temp#sum-type.sum-type
     4465             and stk-line2.cat-id     = '##,##':U
     4466             and stk-line2.fact-order <= x-fact-order-2
     4467           use-index category
     4468           no-error .
     4469         if available stk-line2 then do:
     4470           assign
     4471             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     4472             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     4473             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     4474             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     4475             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     4476           .
     4477         end.
     4478      end.
     4479    end.
     4480    Assign
     4481      Quntity = Second-qnty - first-qnty
     4482      sum     = Second-sum  - first-sum
     4483      vat     = Second-vat  - first-vat
     4484      slt     = Second-slt  - first-slt
     4485      disc    = Second-disc  - first-disc
     4486      .
     4487   END PROCEDURE.
     4488   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4489   procedure macr_excel_char :
     4490    do
     4491    on error undo, return error return-value
     4492    :
     4493    define input parameter  p-val as character no-undo .
     4494    define input parameter  p-row as integer no-undo .
     4495    define input parameter  p-col as integer no-undo .
     4496    if p-val = ? then p-val = "" .
     4497       put stream macr_excel unformatted
     4498             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4499    end.
     4500   end procedure.
     4501   procedure macr_excel_char_with_format :
     4502    do
     4503    on error undo, return error return-value
     4504    :
     4505    define input parameter  p-val as character no-undo .
     4506    define input parameter  p-row as integer no-undo .
     4507    define input parameter  p-col as integer no-undo .
     4508    if p-val = ? then p-val = "" .
     4509       put stream macr_excel unformatted
     4510             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4511       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     4512       put stream macr_excel unformatted
     4513             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4514    end.
     4515   end procedure.
     4516   procedure macr_excel_cell_format :
     4517    do
     4518    on error undo, return error return-value
     4519    :
     4520    define input parameter  p-val    as character no-undo .
     4521    define input parameter  p-row    as integer   no-undo .
     4522    define input parameter  p-col    as integer   no-undo .
     4523    define input parameter  p-format as character no-undo .
     4524    if p-val = ? then p-val = "" .
     4525       put stream macr_excel unformatted
     4526             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     4527       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     4528       put stream macr_excel unformatted
     4529             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     4530    end.
     4531   end procedure.
     4532   procedure macr_excel_sum :
     4533    do
     4534    on error undo, return error return-value
     4535    :
     4536    define input parameter  p-row as integer no-undo .
     4537    define input parameter  p-col as integer no-undo .
     4538    define input parameter  p-row1 as integer no-undo .
     4539    define input parameter  p-col1 as integer no-undo .
     4540    define input parameter  p-row2 as integer no-undo .
     4541    define input parameter  p-col2 as integer no-undo .
     4542       put stream macr_excel unformatted
     4543             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     4544    end.
     4545   end procedure.
     4546   procedure macr_excel_dec :
     4547    do
     4548    on error undo, return error return-value
     4549    :
     4550    define input parameter  p-val as character no-undo .
     4551    define input parameter  p-row as integer   no-undo .
     4552    define input parameter  p-col as integer   no-undo .
     4553     if p-val = ? then p-val =  "" .
     4554      put  stream macr_excel unformatted
     4555           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     4556    end.
     4557   end procedure.
     4558   procedure macr_cell_format :
     4559    do
     4560    on error undo, return error return-value
     4561    :
     4562    define input parameter  p-size   as integer   no-undo .
     4563    define input parameter  p-bold   as logical   no-undo .
     4564    define input parameter  p-italic as logical   no-undo .
     4565    define input parameter  p-color  as integer   no-undo .
     4566    define input parameter  p-row    as integer   no-undo .
     4567    define input parameter  p-col    as integer   no-undo .
     4568    define input parameter  p-row-2  as integer   no-undo .
     4569    define input parameter  p-col-2  as integer   no-undo .
     4570     if p-size = ? then p-size = 10 .
     4571     if p-bold = ? then p-bold = false .
     4572     if p-italic = ? then p-italic = false .
     4573     if p-row-2 = ? then p-row-2 = p-row .
     4574     if p-col-2 = ? then p-col-2 = p-col .
     4575     put  stream macr_excel unformatted
     4576      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     4577     if p-color <> ? then do:
     4578        put  stream macr_excel unformatted
     4579          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     4580     end.
     4581     put  stream macr_excel unformatted
     4582          substitute('format.font(,&1,&2,&3)' , p-size,
     4583                                           string ( p-bold  , "true/false" ) ,
     4584                                           string ( p-italic , "true/false" )
     4585                                           ) + chr(10) .
     4586    end.
     4587   end procedure.
     4588   procedure macr_cell_size :
     4589    do
     4590    on error undo, return error return-value
     4591    :
     4592    define input parameter  p-w   as integer   no-undo .
     4593    define input parameter  p-l   as integer   no-undo .
     4594    define input parameter  p-row    as integer   no-undo .
     4595    define input parameter  p-col    as integer   no-undo .
     4596    define input parameter  p-row-2  as integer   no-undo .
     4597    define input parameter  p-col-2  as integer   no-undo .
     4598     if p-row-2 = ? then p-row-2 = p-row .
     4599     if p-col-2 = ? then p-col-2 = p-col .
     4600     if p-w = ? then    p-w = 0 .
     4601     if p-l = ? then    p-l = 0 .
     4602    define variable s-w as character no-undo .
     4603    define variable s-l as character no-undo .
     4604    if p-w = 0 then s-w = "" .
     4605               else s-w = string(p-w)  .
     4606    if p-l = 0 then s-l = "" .
     4607               else s-l = string(p-l)  .
     4608   put  stream macr_excel unformatted
     4609        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     4610   put  stream macr_excel unformatted
     4611        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     4612   put  stream macr_excel unformatted
     4613        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     4614    end.
     4615   end procedure.
     4616   procedure proc-print-header :
     4617    do
     4618    on error undo, return error return-value
     4619    :
     4620      find first sheetf .
     4621        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     4622        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     4623        var-1 =  num#str# .
     4624        repeat c-c = 1 to sheetf.excel-row-title :
     4625        num#str# = num#str# + 1 .
     4626        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     4627        do c-i = 1 to p-var :
     4628           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     4629           str--2 = integer(entry( c-i, sheetf.sizes )) .
     4630           num#col# = c-i .
     4631           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     4632           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     4633        end.
     4634       c-i = 0.
     4635       end.
     4636       run macr_cell_format (
     4637           10       ,
     4638           true     ,
     4639           false    ,
     4640           35       ,
     4641           var-1 + 1,
     4642           1        ,
     4643           num#str# ,
     4644           num#col# )
     4645           .
     4646     put  stream macr_excel unformatted
     4647          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     4648          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     4649          .
     4650    end.
     4651   end procedure.
     4652   procedure end-proc :
     4653    do
     4654    on error undo, return error return-value
     4655    :
     4656     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     4657     OUTPUT to VALUE (v-file-name) .
     4658     for each temp-param :
     4659       export  temp-param  .
     4660     end.
     4661    end.
     4662   end procedure.
     4663   procedure new-tmp-page :
     4664    do
     4665    on error undo, return error return-value
     4666    :
     4667       if   num#str#  >=  63000  then do:
     4668           output stream macr_excel  close .
     4669           run paramls-write in this-procedure
     4670             (input "file"
     4671             ,input string(v-ind)
     4672             ,input v-file-name
     4673             ) .
     4674           run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     4675           output stream  macr_excel to value(v-file-name) .
     4676           v-ind = v-ind + 1 .
     4677           num#str# = 0 .
     4678   define variable old-s as integer no-undo .
     4679   define variable old-s2 as integer no-undo .
     4680       assign
     4681         old-s =   num#str#
     4682       .
     4683       run make-col.
     4684       assign
     4685          old-s2 =   num#str#
     4686       .
     4687      num#str# = old-s + 1 .
     4688      run proc-print-header.
     4689      num#str# = old-s2 .
     4690       end.
     4691    end.
     4692   end procedure.
