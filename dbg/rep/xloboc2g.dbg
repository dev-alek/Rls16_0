     2045       .
     2046             if  log-manager:logfile-name ne ?
     2047             then DO:
     2048                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2049             end.
     2050              if mFrameView
     2051              then do:
     2052               DISPLAY
     2053                 i-str @ RecordsDone
     2054                 RecordsString   @ RecordsString
     2055                 RecordsString2  @ RecordsString2
     2056                 WITH FRAME InfoFrame.
     2057              end.
     2058   End.
     2059      if v-button-stop then  DO:
     2060            if mFrameView
     2061            then
     2062               PROCESS EVENTS.
     2063            IF StopProcessing THEN DO:
     2064            RETURN error.
     2065            End.
     2066      end.
     2067                     do n-1 = 1 to 13 :
     2068                     assign
     2069                       b1-oborot-ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + b1-oborot-ie        [n-1]
     2070                       b1-oborot-ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + b1-oborot-ee       [n-1]
     2071                       b1-oborot-ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + b1-oborot-ep     [n-1]
     2072                       b1-oborot-es    [n-1]  = tmp-gds-tree.es    [n-1]  + b1-oborot-es    [n-1]
     2073                       b1-oborot-re    [n-1]  = tmp-gds-tree.re    [n-1]  + b1-oborot-re    [n-1]
     2074                       b1-oborot-rs[n-1] = tmp-gds-tree.rs [n-1]  + b1-oborot-rs[n-1]
     2075                       b1-oborot-we[n-1]  = tmp-gds-tree.we[n-1]  + b1-oborot-we[n-1]
     2076                       b1-oborot-vt [n-1]  = tmp-gds-tree.vt [n-1]  + b1-oborot-vt [n-1]
     2077                       b1-oborot-iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + b1-oborot-iv  [n-1]
     2078                       b1-oborot-ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + b1-oborot-ev  [n-1]
     2079                       b1-oborot-rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + b1-oborot-rv  [n-1]
     2080                       b1-oborot-em  [n-1]  = tmp-gds-tree.em  [n-1]  + b1-oborot-em  [n-1]
     2081                       b1-oborot-wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + b1-oborot-wm  [n-1]
     2082                       b1-oborot-im  [n-1]  = tmp-gds-tree.im  [n-1]  + b1-oborot-im  [n-1]
     2083                       b1-oborot-ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + b1-oborot-ot  [n-1]
     2084                       b1-oborot-pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + b1-oborot-pc [n-1]
     2085                       b1-oborot-ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + b1-oborot-ap [n-1]
     2086                       b1-oborot-disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + b1-oborot-disc                           [n-1]
     2087                       b1-ostatok-start                         [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + b1-ostatok-start                         [n-1]
     2088                       b1-ostatok-end                           [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + b1-ostatok-end                           [n-1]
     2089                       b1-oborot-sum-sale                       [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + b1-oborot-sum-sale                       [n-1]
     2090                       b1-oborot-sum-cost                       [n-1]  = tmp-gds-tree.oborot-sum-cost                [n-1]  + b1-oborot-sum-cost                       [n-1]
     2091                     .
     2092                    end.
     2093                    i = i + 1 .
     2094           end.
     2095           b1-oborot-eff[1 ]  = (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) .
     2096           if  b1-oborot-sum-cost[2] <>  0 then
     2097               b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     2098               else b1-oborot-prc[1] = 0.
     2099               if not
     2100               (
     2101                 b1-oborot-ie                 [1]    = 0 and
     2102                 b1-oborot-ee                 [1]    = 0 and
     2103                 b1-oborot-ep              [1]    = 0 and
     2104                 b1-oborot-es            [1]    = 0 and
     2105                 b1-oborot-re             [1]    = 0 and
     2106                 b1-oborot-rs        [1]    = 0 and
     2107                 b1-oborot-we                 [1]    = 0 and
     2108                 b1-oborot-vt                       [1]    = 0 and
     2109                 b1-oborot-iv                 [1]    = 0 and
     2110                 b1-oborot-ev                 [1]    = 0 and
     2111                 b1-oborot-rv             [1]    = 0 and
     2112                 b1-oborot-em                  [1]    = 0 and
     2113                 b1-oborot-wm                  [1]    = 0 and
     2114                 b1-oborot-im                  [1]    = 0 and
     2115                 b1-oborot-ot                  [1]    = 0 and
     2116                 b1-oborot-disc                            [1]    = 0 and
     2117                 b1-oborot-pc           [1]    = 0 and
     2118                 b1-oborot-ap           [1]    = 0 and
     2119                 b1-ostatok-end                                    [1]    = 0 and
     2120                 b1-ostatok-start                                  [1]    = 0 and
     2121                 b1-oborot-ie                 [2]    = 0 and
     2122                 b1-oborot-ee                 [2]    = 0 and
     2123                 b1-oborot-ep              [2]    = 0 and
     2124                 b1-oborot-es            [2]    = 0 and
     2125                 b1-oborot-re             [2]    = 0 and
     2126                 b1-oborot-rs        [2]    = 0 and
     2127                 b1-oborot-we                 [2]    = 0 and
     2128                 b1-oborot-vt                       [2]    = 0 and
     2129                 b1-oborot-iv                 [2]    = 0 and
     2130                 b1-oborot-ev                 [2]    = 0 and
     2131                 b1-oborot-rv             [2]    = 0 and
     2132                 b1-oborot-em                  [2]    = 0 and
     2133                 b1-oborot-wm                  [2]    = 0 and
     2134                 b1-oborot-im                  [2]    = 0 and
     2135                 b1-oborot-ot                  [2]    = 0 and
     2136                 b1-oborot-disc                            [2]    = 0 and
     2137                 b1-oborot-pc           [2]    = 0 and
     2138                 b1-oborot-ap           [2]    = 0 and
     2139                 b1-ostatok-end                                    [2]    = 0 and
     2140                 b1-ostatok-start                                  [2]    = 0 and
     2141                 b1-oborot-ot                  [2]    = 0
     2142                 )  then do:
     2143                     assign
     2144                       tmp-gds.name =  tmp-gds.name
     2145                       s-bar-code       = substring(tmp-gds.name,1,9)
     2146                       sf1:screen-value = substring(tmp-gds.name,10,1)
     2147                       gds-zap-artic    = substring(tmp-gds.name,11,16)
     2148                       sf2:screen-value = substring(tmp-gds.name,27,1)
     2149                       gds-zap-gds-name = substring(tmp-gds.name,28,40)
     2150                       no-error .
     2151                       run display-b1  in this-procedure .
     2152                       if tmp-gds.lvl = 1 then do:
     2153                          run calc-s-itog   in this-procedure .
     2154                       end.
     2155                       run clear-b1  in this-procedure .
     2156                       assign
     2157                         sf1:screen-value =""
     2158                         sf2:screen-value =""
     2159                         no-error .
     2160                   end.
     2161      end.
     2162   end procedure.
     2163   procedure foreach :
     2164     assign
     2165       p-price-med = 0
     2166       null-str# = 1
     2167       i-str = i-str + 1
     2168     .
