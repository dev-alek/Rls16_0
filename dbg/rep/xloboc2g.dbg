     1612     allcol = num-entries(sizes) - 1 .
     1613   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1614     if  log-manager:logfile-name ne ?
     1615     then DO:
     1616         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1617     end.
     1618     if not session:batch-mode then
     1619     do:
     1620       VIEW FRAME InfoFrame.
     1621       mFrameView = true.
     1622     end.
     1623      v-button-stop = false .
     1624         if mFrameView
     1625         then do:
     1626         if v-button-stop then view STOPBTN in frame InfoFrame.
     1627                          else Hide STOPBTN in frame InfoFrame.
     1628         end.
     1629   IF ( i-str modulo v-account = 0 )  then DO:
     1630    Assign
     1631       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1632       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1633       .
     1634    Assign
     1635       v-kol-spice = (50 - LENGTH(objname)) / 2
     1636       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     1637       .
     1638             if  log-manager:logfile-name ne ?
     1639             then DO:
     1640                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1641             end.
     1642              if mFrameView
     1643              then do:
     1644               DISPLAY
     1645                 i-str @ RecordsDone
     1646                 RecordsString   @ RecordsString
     1647                 RecordsString2  @ RecordsString2
     1648                 WITH FRAME InfoFrame.
     1649              end.
     1650   End.
     1651      if v-button-stop then  DO:
     1652            if mFrameView
     1653            then
     1654               PROCESS EVENTS.
     1655            IF StopProcessing THEN DO:
     1656            RETURN error.
     1657            End.
     1658      end.
     1659   t-time = time.
     1660        assign
     1661           number-list    = 1
     1662           i              = 0
     1663           xlavel         = xvar-lavel
     1664           select-good    = x-selectgood
     1665           paytype        = x-set_pay_type
     1666           retclassify    = xclassify
     1667           retsorttype    = xsorttype
     1668           sums-only      = xsumsonly
     1669           show-negativ   = xshowzero
     1670           x-selectobject = "".
     1671           firstline      = false.
     1672           valtype        = if (paytype = 1) then 0  else x-set_val_type.
     1673       if x-vat then x-vat = false .
     1674               else x-vat = true .
     1675       if x-vat then v-name-type = "учет.".
     1676                else  v-name-type = "учет-НДС".
     1677     if  x-date-end  - x-date-start > 100
     1678         then long-p = true    .
     1679         else  long-p = false     .
     1680     find first ub.gds-grp where  ub.gds-grp.upper-code = 0 no-lock no-error .
     1681     if avail ub.gds-grp then  first-lavel = ub.gds-grp.node-code.
     1682                      else first-lavel = 0.
     1683     valtype         = if (paytype = 1) then 0  else x-set_val_type.
     1684     if (valtype=0 and x-base-code=0)  or valtype=1
     1685       then assign tprintrubl = yes .
     1686       else assign tprintrubl = no .
     1687     run make-tt-ed in this-procedure  .
     1688     run find-mediator  in this-procedure
     1689        ( input  v-cntxt-host-code-obj ,
     1690          input  xshowmediator,
     1691          output mediator-host-code,
     1692          output f-flag) .
     1693     if f-flag = false then return.
     1694     g-ll = xlavel .
     1695     if select-good <> 2 then do:
     1696     run pp in this-procedure (1,first-lavel,"").
     1697     end.
     1698     else do:
     1699     run ppgrp in this-procedure (1,first-lavel,"").
     1700     end.
     1701     run report-execute in this-procedure .
     1702   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1703   define variable  str  as char format "X(60)"  no-undo.
     1704   define variable  str2 as char no-undo.
     1705   define variable v-r as character no-undo init "" .
     1706   define variable  i#i as int no-undo.
     1707   STR = "".
     1708   repeat i#i =1 to lavel#:
     1709       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1710       else do:
     1711           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1712           if not error-status:error  and str2 <> "":u then
     1713                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1714           end.
     1715   end.
     1716   if str <> ? then do:
     1717   v-r = str + chr(47) .
     1718   end.
     1719   RETURN v-r .
     1720   END FUNCTION.
     1721   procedure report-execute :
     1722     if (valtype=0 and x-base-code=0)  or valtype=1
     1723                                   then   assign tprintrubl = yes .
     1724                                   else   assign tprintrubl = no .
     1725       p-file-name =  string( session:temp-directory +
     1726                                     "rpt" + string( g#report-num ) + ".txt" ) .
     1727       output stream outstream to value( string( session:temp-directory +
     1728                                     "rpt" + string( g#report-num ) ) )      .
     1729       output stream outstream2 to value(p-file-name).
     1730       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     1731       output stream macr_excel to value(v-file-name)   .
     1732                   put stream  outstream  "1" format "x(100)" skip .
     1733       v-ind = 1    .
     1734       num#str# = 0 .
     1735       num#str# = num#str# + 1 .
     1736       num#col# =  1 .
     1737         run macr_excel_char ( reportname , num#str# , num#col#  ).
     1738         run macr_cell_format
     1739             ( 12    ,
     1740               true  ,
     1741               false ,
     1742               ?     ,
     1743               num#str# ,
     1744               num#col# ,
     1745               ? ,
     1746               ?         ) .
     1747   define variable l-ii  as integer no-undo .
     1748   define variable l-jj  as integer no-undo .
     1749   define variable l-len as integer no-undo .
     1750   define variable l-m   as integer no-undo .
     1751   define variable v-nn as integer   no-undo .
     1752   v-nn = num-entries ( str1 , "chr(10)"  ) .  do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char (                                                                        substring (entry ( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1753   v-nn = num-entries ( str2 , "chr(10)"  ) .  do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char (                                                                        substring (entry ( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1754   v-nn = num-entries ( str3 , "chr(10)"  ) .  do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char (                                                                        substring (entry ( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1755   v-nn = num-entries ( str4 , "chr(10)"  ) .  do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char (                                                                        substring (entry ( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1756   v-nn = num-entries ( reportheader , "chr(10)"  ) .  do l-ii = 1 to v-nn :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char (                                                                        substring (entry ( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     1757     num#str# = num#str# + 1.
     1758     num#col# = 1.
     1759     run macr_excel_char (
     1760          cur-time-print()  +
     1761         " Цены указаны в " +
     1762         (if tprintrubl then "РУБ" else x-base-type )
     1763         , num#str#
     1764         , num#col#
     1765           ) .
     1766   define variable old-s as integer no-undo .
     1767   define variable old-s2 as integer no-undo .
     1768   assign
     1769   old-s =   num#str#
     1770   .
     1771   run make-col.
     1772   assign
     1773   old-s2 =   num#str#
     1774   .
     1775      num#str# = old-s + 1.
     1776      run proc-print-header.
     1777      num#str# = old-s2.
     1778      define variable gj as integer no-undo init 0.
     1779      if xtog-obj  then do:
     1780         for each obj-list no-lock:
     1781             x-store-type = obj-list.obj-type.
     1782             x-store-code = obj-list.obj-code.
     1783             run report-exec1 in this-procedure .
     1784             gj = gj + 1 .
     1785         end.
     1786         if gj > 1 then   run display-bo in this-procedure .
     1787         end.
     1788      else  run report-exec1 in this-procedure .
     1789      message  " Время составления отчета " + string((time - t-time),"hh:mm:ss" ) .
     1790      output stream outstream close.
     1791      output stream outstream2 close.
     1792     output stream macr_excel  close .
     1793   if mFrameView
     1794   then do:
     1795      HIDE FRAME InfoFrame.
     1796   end.
     1797       run paramls-write in this-procedure
     1798         (input "file"
     1799         ,input string(v-ind)
     1800         ,input v-file-name
     1801         ) .
     1802     run end-proc .
     1803   if mFrameView
     1804   then do:
     1805      HIDE FRAME InfoFrame.
     1806   end.
     1807     run rep/runexcel.p (p-file-name ).
     1808   end procedure.
     1809   procedure report-exec1 :
     1810      find first clients where x-store-type = clients.obj-type and
     1811                               x-store-code = clients.obj-code no-lock no-error.
     1812              if available clients then  objname = clients.obj-name.
     1813                                            else  objname="объект не определен".
     1814     run calcitog in this-procedure .
     1815     run print-header in this-procedure .
     1816     run run2 in this-procedure .
     1817     run print-det in this-procedure .
     1818     run print-footer in this-procedure .
     1819   end procedure.
     1820   procedure run2 :
     1821     for each tmp-gds-tree :
     1822         delete tmp-gds-tree  .
     1823     end.
     1824     case select-good :
     1825         when 1   then do: run run21 in this-procedure .  end.
     1826         when 2   then do: run run22 in this-procedure .  end.
     1827         when 3  then do: run run23 in this-procedure .  end.
     1828         otherwise do:
     1829           run run24 in this-procedure .
     1830         end.
     1831     end case.
     1832   end procedure.
     1833   procedure run21 :
     1834   define variable o-tog-obj as logical no-undo .
     1835   define variable ox-store-type as character no-undo .
     1836   define variable ox-store-code as integer no-undo .
     1837   assign
     1838     o-tog-obj     = xTog-obj
     1839     ox-store-type = x-store-type
     1840     ox-store-code = x-store-code
     1841     xTog-obj = true         .
     1842   define buffer b_gds-obj for ub.gds-obj .
     1843   define buffer b_goods for ub.goods .
     1844   define buffer b_gds-grp for ub.gds-grp .
     1845   define variable n as integer no-undo .
     1846   define variable n-1 as integer no-undo .
     1847      for each obj-list  where
     1848        ( o-Tog-obj = false OR
     1849           ( obj-list.obj-type = x-store-type and
     1850             obj-list.obj-code = x-store-code ) ) :
     1851             x-store-type = obj-list.obj-type.
     1852             x-store-code = obj-list.obj-code.
     1853         for  each b_gds-obj  no-lock  where
     1854                   b_gds-obj.obj-type = obj-list.obj-type    and
     1855                   b_gds-obj.obj-code = obj-list.obj-code    and
     1856                   not
     1857                   (b_gds-obj.last-doc <> date('')     and
     1858                   b_gds-obj.last-doc < x-date-start   and
     1859                   b_gds-obj.fact-qnty = 0             and
     1860                   b_gds-obj.avrg-qnty = 0  ) :
     1861           find first  b_goods  no-lock where b_gds-obj.gds-code    = b_goods.gds-code  no-error   .
     1862           find first  b_gds-grp no-lock where b_gds-grp.node-code  = b_goods.grp-code  no-error .
     1863             if available b_goods  and available b_gds-grp then do:
     1864               n = n + 1 .                                                                      find first tmp-gds-tree where  tmp-gds-tree.node-code  = b_gds-grp.node-code no-error .               if not available tmp-gds-tree then do:                                                                create tmp-gds-tree.                                                                                  end.                                                                                                  assign                                                                                                tmp-gds-tree.id  = n                                                                                  tmp-gds-tree.f-name     = b_goods.grp-name                                                            tmp-gds-tree.node-code  = b_gds-grp.node-code                                                         tmp-gds-tree.lvl        = b_gds-grp.lvl-num                                                           tmp-gds-tree.upper-cod  = b_gds-grp.upper-code                                                        .                                                                                                                                                                                     assign                                                                                                gds-zap-artic      = b_goods.artic                                                                    gds-zap-prod-type  = b_goods.prod-type                                                                gds-zap-prod-code  = b_goods.prod-code                                                                gds-zap-type       = b_goods.gds-type                                                                 .                                                                                                     run foreach  in this-procedure .                                                                      do n-1 = 1 to 13 :                                                                             assign                                                                                                tmp-gds-tree.ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + oborot-ie        [n-1]tmp-gds-tree.ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + oborot-ee       [n-1]tmp-gds-tree.ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + oborot-ep     [n-1]tmp-gds-tree.es    [n-1]  = tmp-gds-tree.es    [n-1]  + oborot-es    [n-1]tmp-gds-tree.re    [n-1]  = tmp-gds-tree.re    [n-1]  + oborot-re    [n-1]tmp-gds-tree.rs[n-1] = tmp-gds-tree.rs [n-1]  + oborot-rs[n-1]tmp-gds-tree.we[n-1]  = tmp-gds-tree.we[n-1]  + oborot-we[n-1]tmp-gds-tree.vt [n-1]  = tmp-gds-tree.vt [n-1]  + oborot-vt [n-1]tmp-gds-tree.iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + oborot-iv  [n-1]tmp-gds-tree.ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + oborot-ev  [n-1]tmp-gds-tree.rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + oborot-rv  [n-1]tmp-gds-tree.em  [n-1]  = tmp-gds-tree.em  [n-1]  + oborot-em  [n-1]tmp-gds-tree.wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + oborot-wm  [n-1]tmp-gds-tree.im  [n-1]  = tmp-gds-tree.im  [n-1]  + oborot-im  [n-1]tmp-gds-tree.ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + oborot-ot  [n-1]tmp-gds-tree.pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + oborot-pc  [n-1]tmp-gds-tree.ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + oborot-ap  [n-1]tmp-gds-tree.disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + oborot-disc                           [n-1]   tmp-gds-tree.ostatok-start                  [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + ostatok-start                         [n-1]   tmp-gds-tree.ostatok-end                    [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + ostatok-end                           [n-1]   tmp-gds-tree.oborot-sum-sale                [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + oborot-sum-sale                        [1]    tmp-gds-tree.oborot-sum-cost                [n-1]  = tmp-gds-tree.oborot-sum-cost               [n-1]  + oborot-sum-cost                        [1]    .              end.
     1865             end.
     1866         end.
     1867      end.
     1868   assign
     1869      xTog-obj     = o-tog-obj
     1870      x-store-type = ox-store-type
     1871      x-store-code = ox-store-code
     1872   .
     1873   end procedure.
     1874   procedure run24 :
     1875   define buffer b_gds-obj for ub.gds-obj .
     1876   define buffer b_goods for ub.goods .
     1877   define buffer b_gds-grp for ub.gds-grp .
     1878   define variable n as integer no-undo .
     1879   define variable n-1 as integer no-undo .
     1880   define variable o-tog-obj as logical no-undo .
     1881   define variable ox-store-type as character no-undo .
     1882   define variable ox-store-code as integer no-undo .
     1883   assign
     1884     o-tog-obj     = xTog-obj
     1885     ox-store-type = x-store-type
     1886     ox-store-code = x-store-code
     1887     xTog-obj = true         .
     1888      for each obj-list  :
     1889         if  o-tog-obj = true  then   do:
     1890            if not
     1891           ( obj-list.obj-type = x-store-type and obj-list.obj-code = x-store-code ) then next.
     1892         end.
     1893         x-store-type = obj-list.obj-type.
     1894         x-store-code = obj-list.obj-code.
     1895         for  each b_gds-obj  no-lock  where
     1896                   b_gds-obj.obj-type = obj-list.obj-type    and
     1897                   b_gds-obj.obj-code = obj-list.obj-code    and
     1898                   not
     1899                   (b_gds-obj.last-doc <> date('')     and
     1900                   b_gds-obj.last-doc < x-date-start   and
     1901                   b_gds-obj.fact-qnty = 0             and
     1902                   b_gds-obj.avrg-qnty = 0  ) ,
     1903                   first gds-list where gds-list.gds-code = b_gds-obj.gds-code :
     1904           find first  b_goods  no-lock where b_gds-obj.gds-code    = b_goods.gds-code  no-error   .
     1905           find first  b_gds-grp no-lock where b_gds-grp.node-code  = b_goods.grp-code  no-error .
     1906             if available b_goods  and available b_gds-grp then do:
     1907               n = n + 1 .                                                                      find first tmp-gds-tree where  tmp-gds-tree.node-code  = b_gds-grp.node-code no-error .               if not available tmp-gds-tree then do:                                                                create tmp-gds-tree.                                                                                  end.                                                                                                  assign                                                                                                tmp-gds-tree.id  = n                                                                                  tmp-gds-tree.f-name     = b_goods.grp-name                                                            tmp-gds-tree.node-code  = b_gds-grp.node-code                                                         tmp-gds-tree.lvl        = b_gds-grp.lvl-num                                                           tmp-gds-tree.upper-cod  = b_gds-grp.upper-code                                                        .                                                                                                                                                                                     assign                                                                                                gds-zap-artic      = b_goods.artic                                                                    gds-zap-prod-type  = b_goods.prod-type                                                                gds-zap-prod-code  = b_goods.prod-code                                                                gds-zap-type       = b_goods.gds-type                                                                 .                                                                                                     run foreach  in this-procedure .                                                                      do n-1 = 1 to 13 :                                                                             assign                                                                                                tmp-gds-tree.ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + oborot-ie        [n-1]tmp-gds-tree.ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + oborot-ee       [n-1]tmp-gds-tree.ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + oborot-ep     [n-1]tmp-gds-tree.es    [n-1]  = tmp-gds-tree.es    [n-1]  + oborot-es    [n-1]tmp-gds-tree.re    [n-1]  = tmp-gds-tree.re    [n-1]  + oborot-re    [n-1]tmp-gds-tree.rs[n-1] = tmp-gds-tree.rs [n-1]  + oborot-rs[n-1]tmp-gds-tree.we[n-1]  = tmp-gds-tree.we[n-1]  + oborot-we[n-1]tmp-gds-tree.vt [n-1]  = tmp-gds-tree.vt [n-1]  + oborot-vt [n-1]tmp-gds-tree.iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + oborot-iv  [n-1]tmp-gds-tree.ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + oborot-ev  [n-1]tmp-gds-tree.rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + oborot-rv  [n-1]tmp-gds-tree.em  [n-1]  = tmp-gds-tree.em  [n-1]  + oborot-em  [n-1]tmp-gds-tree.wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + oborot-wm  [n-1]tmp-gds-tree.im  [n-1]  = tmp-gds-tree.im  [n-1]  + oborot-im  [n-1]tmp-gds-tree.ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + oborot-ot  [n-1]tmp-gds-tree.pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + oborot-pc  [n-1]tmp-gds-tree.ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + oborot-ap  [n-1]tmp-gds-tree.disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + oborot-disc                           [n-1]   tmp-gds-tree.ostatok-start                  [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + ostatok-start                         [n-1]   tmp-gds-tree.ostatok-end                    [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + ostatok-end                           [n-1]   tmp-gds-tree.oborot-sum-sale                [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + oborot-sum-sale                        [1]    tmp-gds-tree.oborot-sum-cost                [n-1]  = tmp-gds-tree.oborot-sum-cost               [n-1]  + oborot-sum-cost                        [1]    .              end.
     1908             end.
     1909         end.
     1910      end.
     1911   assign
     1912      xTog-obj     = o-tog-obj
     1913      x-store-type = ox-store-type
     1914      x-store-code = ox-store-code
     1915   .
     1916   end procedure.
     1917   procedure run22 :
     1918   define variable o-tog-obj as logical no-undo .
     1919   define variable ox-store-type as character no-undo .
     1920   define variable ox-store-code as integer no-undo .
     1921   assign
     1922     o-tog-obj     = xTog-obj
     1923     ox-store-type = x-store-type
     1924     ox-store-code = x-store-code
     1925     xTog-obj = true         .
     1926   define buffer b_gds-obj for ub.gds-obj .
     1927   define buffer b_goods for ub.goods .
     1928   define buffer b_gds-grp for ub.gds-grp .
     1929   define variable n as integer no-undo .
     1930   define variable n-1 as integer no-undo .
     1931      for each obj-list  where
     1932        ( o-Tog-obj = false OR
     1933           ( obj-list.obj-type = x-store-type and
     1934             obj-list.obj-code = x-store-code ))  :
     1935             x-store-type = obj-list.obj-type.
     1936             x-store-code = obj-list.obj-code.
     1937         for  each b_gds-obj  no-lock  where
     1938                   b_gds-obj.obj-type = obj-list.obj-type    and
     1939                   b_gds-obj.obj-code = obj-list.obj-code    and
     1940                   not
     1941                   (b_gds-obj.last-doc <> date('')     and
     1942                   b_gds-obj.last-doc < x-date-start   and
     1943                   b_gds-obj.fact-qnty = 0             and
     1944                   b_gds-obj.avrg-qnty = 0  ) ,
     1945            First  tmp#grp  WHERE trim(b_gds-obj.grp-name)   begins  trim(tmp#grp.grp-name)
     1946                   :
     1947           find first  b_goods  no-lock where b_gds-obj.gds-code    = b_goods.gds-code  no-error   .
     1948           find first  b_gds-grp no-lock where b_gds-grp.node-code  = b_goods.grp-code  no-error .
     1949             if available b_goods  and available b_gds-grp then do:
     1950               n = n + 1 .                                                                      find first tmp-gds-tree where  tmp-gds-tree.node-code  = b_gds-grp.node-code no-error .               if not available tmp-gds-tree then do:                                                                create tmp-gds-tree.                                                                                  end.                                                                                                  assign                                                                                                tmp-gds-tree.id  = n                                                                                  tmp-gds-tree.f-name     = b_goods.grp-name                                                            tmp-gds-tree.node-code  = b_gds-grp.node-code                                                         tmp-gds-tree.lvl        = b_gds-grp.lvl-num                                                           tmp-gds-tree.upper-cod  = b_gds-grp.upper-code                                                        .                                                                                                                                                                                     assign                                                                                                gds-zap-artic      = b_goods.artic                                                                    gds-zap-prod-type  = b_goods.prod-type                                                                gds-zap-prod-code  = b_goods.prod-code                                                                gds-zap-type       = b_goods.gds-type                                                                 .                                                                                                     run foreach  in this-procedure .                                                                      do n-1 = 1 to 13 :                                                                             assign                                                                                                tmp-gds-tree.ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + oborot-ie        [n-1]tmp-gds-tree.ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + oborot-ee       [n-1]tmp-gds-tree.ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + oborot-ep     [n-1]tmp-gds-tree.es    [n-1]  = tmp-gds-tree.es    [n-1]  + oborot-es    [n-1]tmp-gds-tree.re    [n-1]  = tmp-gds-tree.re    [n-1]  + oborot-re    [n-1]tmp-gds-tree.rs[n-1] = tmp-gds-tree.rs [n-1]  + oborot-rs[n-1]tmp-gds-tree.we[n-1]  = tmp-gds-tree.we[n-1]  + oborot-we[n-1]tmp-gds-tree.vt [n-1]  = tmp-gds-tree.vt [n-1]  + oborot-vt [n-1]tmp-gds-tree.iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + oborot-iv  [n-1]tmp-gds-tree.ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + oborot-ev  [n-1]tmp-gds-tree.rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + oborot-rv  [n-1]tmp-gds-tree.em  [n-1]  = tmp-gds-tree.em  [n-1]  + oborot-em  [n-1]tmp-gds-tree.wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + oborot-wm  [n-1]tmp-gds-tree.im  [n-1]  = tmp-gds-tree.im  [n-1]  + oborot-im  [n-1]tmp-gds-tree.ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + oborot-ot  [n-1]tmp-gds-tree.pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + oborot-pc  [n-1]tmp-gds-tree.ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + oborot-ap  [n-1]tmp-gds-tree.disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + oborot-disc                           [n-1]   tmp-gds-tree.ostatok-start                  [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + ostatok-start                         [n-1]   tmp-gds-tree.ostatok-end                    [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + ostatok-end                           [n-1]   tmp-gds-tree.oborot-sum-sale                [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + oborot-sum-sale                        [1]    tmp-gds-tree.oborot-sum-cost                [n-1]  = tmp-gds-tree.oborot-sum-cost               [n-1]  + oborot-sum-cost                        [1]    .              end.
     1951             end.
     1952         end.
     1953      end.
     1954   assign
     1955      xTog-obj     = o-tog-obj
     1956      x-store-type = ox-store-type
     1957      x-store-code = ox-store-code
     1958   .
     1959   end procedure.
     1960   procedure run23 :
     1961   define variable o-tog-obj as logical no-undo .
     1962   define variable ox-store-type as character no-undo .
     1963   define variable ox-store-code as integer no-undo .
     1964   assign
     1965     o-tog-obj     = xTog-obj
     1966     ox-store-type = x-store-type
     1967     ox-store-code = x-store-code
     1968     xTog-obj = true         .
     1969   define buffer b_gds-obj for ub.gds-obj .
     1970   define buffer b_goods for ub.goods .
     1971   define buffer b_gds-grp for ub.gds-grp .
     1972   define variable n as integer no-undo .
     1973   define variable n-1 as integer no-undo .
     1974      for each obj-list  where
     1975        ( o-Tog-obj = false OR
     1976           ( obj-list.obj-type = x-store-type and
     1977             obj-list.obj-code = x-store-code ))  :
     1978     x-store-type = obj-list.obj-type.
     1979     x-store-code = obj-list.obj-code.
     1980         for  each b_gds-obj  no-lock  where
     1981                   b_gds-obj.obj-type = obj-list.obj-type    and
     1982                   b_gds-obj.obj-code = obj-list.obj-code    and
     1983                   not
     1984                   (b_gds-obj.last-doc <> date('')     and
     1985                   b_gds-obj.last-doc < x-date-start   and
     1986                   b_gds-obj.fact-qnty = 0             and
     1987                   b_gds-obj.avrg-qnty = 0  ) ,
     1988           first g#cli
     1989                 where b_gds-obj.prod-code   = g#cli.obj-code
     1990                 and   b_gds-obj.prod-type   = g#cli.obj-type
     1991                   :
     1992           find first  b_goods  no-lock where b_gds-obj.gds-code    = b_goods.gds-code  no-error   .
     1993           find first  b_gds-grp no-lock where b_gds-grp.node-code  = b_goods.grp-code  no-error .
     1994             if available b_goods  and available b_gds-grp then do:
     1995               n = n + 1 .                                                                      find first tmp-gds-tree where  tmp-gds-tree.node-code  = b_gds-grp.node-code no-error .               if not available tmp-gds-tree then do:                                                                create tmp-gds-tree.                                                                                  end.                                                                                                  assign                                                                                                tmp-gds-tree.id  = n                                                                                  tmp-gds-tree.f-name     = b_goods.grp-name                                                            tmp-gds-tree.node-code  = b_gds-grp.node-code                                                         tmp-gds-tree.lvl        = b_gds-grp.lvl-num                                                           tmp-gds-tree.upper-cod  = b_gds-grp.upper-code                                                        .                                                                                                                                                                                     assign                                                                                                gds-zap-artic      = b_goods.artic                                                                    gds-zap-prod-type  = b_goods.prod-type                                                                gds-zap-prod-code  = b_goods.prod-code                                                                gds-zap-type       = b_goods.gds-type                                                                 .                                                                                                     run foreach  in this-procedure .                                                                      do n-1 = 1 to 13 :                                                                             assign                                                                                                tmp-gds-tree.ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + oborot-ie        [n-1]tmp-gds-tree.ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + oborot-ee       [n-1]tmp-gds-tree.ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + oborot-ep     [n-1]tmp-gds-tree.es    [n-1]  = tmp-gds-tree.es    [n-1]  + oborot-es    [n-1]tmp-gds-tree.re    [n-1]  = tmp-gds-tree.re    [n-1]  + oborot-re    [n-1]tmp-gds-tree.rs[n-1] = tmp-gds-tree.rs [n-1]  + oborot-rs[n-1]tmp-gds-tree.we[n-1]  = tmp-gds-tree.we[n-1]  + oborot-we[n-1]tmp-gds-tree.vt [n-1]  = tmp-gds-tree.vt [n-1]  + oborot-vt [n-1]tmp-gds-tree.iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + oborot-iv  [n-1]tmp-gds-tree.ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + oborot-ev  [n-1]tmp-gds-tree.rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + oborot-rv  [n-1]tmp-gds-tree.em  [n-1]  = tmp-gds-tree.em  [n-1]  + oborot-em  [n-1]tmp-gds-tree.wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + oborot-wm  [n-1]tmp-gds-tree.im  [n-1]  = tmp-gds-tree.im  [n-1]  + oborot-im  [n-1]tmp-gds-tree.ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + oborot-ot  [n-1]tmp-gds-tree.pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + oborot-pc  [n-1]tmp-gds-tree.ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + oborot-ap  [n-1]tmp-gds-tree.disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + oborot-disc                           [n-1]   tmp-gds-tree.ostatok-start                  [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + ostatok-start                         [n-1]   tmp-gds-tree.ostatok-end                    [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + ostatok-end                           [n-1]   tmp-gds-tree.oborot-sum-sale                [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + oborot-sum-sale                        [1]    tmp-gds-tree.oborot-sum-cost                [n-1]  = tmp-gds-tree.oborot-sum-cost               [n-1]  + oborot-sum-cost                        [1]    .              end.
     1996             end.
     1997         end.
     1998      end.
     1999   assign
     2000      xTog-obj     = o-tog-obj
     2001      x-store-type = ox-store-type
     2002      x-store-code = ox-store-code
     2003   .
     2004   end procedure.
     2005   procedure print-det :
     2006   define variable n-1 as integer no-undo .
     2007   IF ( i-str modulo v-account = 0 )  then DO:
     2008    Assign
     2009       v-kol-spice = (50 - LENGTH('Суммирование дерева')) / 2
     2010       RecordsString = fill(' ',v-kol-spice) + string('Суммирование дерева')
     2011       .
     2012             if  log-manager:logfile-name ne ?
     2013             then DO:
     2014                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2015             end.
     2016              if mFrameView
     2017              then do:
     2018               DISPLAY
     2019                 i-str @ RecordsDone
     2020                 RecordsString   @ RecordsString
     2021                 WITH FRAME InfoFrame.
     2022              end.
     2023   End.
     2024      if v-button-stop then  DO:
     2025            if mFrameView
     2026            then
     2027               PROCESS EVENTS.
     2028            IF StopProcessing THEN DO:
     2029            RETURN error.
     2030            End.
     2031      end.
     2032       for each tmp-gds no-lock   :
