      786   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      787   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      788   procedure paramls-clear :
      789     define buffer buf_temp-param for temp-param .
      790     do
      791     on error undo, return error return-value
      792     :
      793       for each buf_temp-param
      794       on error undo, return error
      795       :
      796         delete buf_temp-param .
      797       end.
      798     end.
      799   end procedure.
      800   procedure paramls-write :
      801     define input  parameter p-code     as character no-undo .
      802     define input  parameter p-sub-code as character no-undo .
      803     define input  parameter p-value    as character no-undo .
      804     define buffer buf_temp-param for temp-param .
      805     do
      806     on error undo, return error return-value
      807     :
      808       find first buf_temp-param
      809         where buf_temp-param.param-code     = p-code
      810           and buf_temp-param.param-sub-code = p-sub-code
      811         no-error .
      812       if not available buf_temp-param then do:
      813         create buf_temp-param .
      814         assign
      815           buf_temp-param.param-code     = p-code
      816           buf_temp-param.param-sub-code = p-sub-code
      817         .
      818       end.
      819       assign
      820         buf_temp-param.param-value = p-value
      821       .
      822     end.
      823   end procedure.
      824   procedure paramls-read :
      825     define input  parameter p-code          as character no-undo .
      826     define input  parameter p-sub-code      as character no-undo .
      827     define input  parameter p-default-value as character no-undo .
      828     define output parameter p-value         as character no-undo .
      829     define buffer buf_temp-param for temp-param .
      830     do
      831     on error undo, return error return-value
      832     :
      833       find first buf_temp-param
      834         where buf_temp-param.param-code     = p-code
      835           and buf_temp-param.param-sub-code = p-sub-code
      836         no-error .
      837       if available buf_temp-param then do:
      838         assign
      839           p-value = buf_temp-param.param-value
      840         .
      841       end.
      842       else do:
      843         assign
      844           p-value = p-default-value
      845         .
      846       end.
      847     end.
      848   end procedure.
      849   procedure paramls-append :
      850     define input  parameter p-code     as character no-undo .
      851     define input  parameter p-sub-code as character no-undo .
      852     define input  parameter p-value    as character no-undo .
      853     define buffer buf_temp-param for temp-param .
      854     do
      855     on error undo, return error return-value
      856     :
      857       find first buf_temp-param
      858            where buf_temp-param.param-code     = p-code
      859              and buf_temp-param.param-sub-code = p-sub-code
      860         no-error .
      861       if not available buf_temp-param then do:
      862         create buf_temp-param .
      863         assign
      864           buf_temp-param.param-code     = p-code
      865           buf_temp-param.param-sub-code = p-sub-code
      866           buf_temp-param.param-value    = p-value
      867         .
      868       end.
      869       else do:
      870           assign
      871               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      872           .
      873       end.
      874     end.
      875   end procedure.
      876   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      877     if num-entries(string(p-dec), '.') = 2
      878       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      879       else return( string(p-dec)) .
      880   end function.
      881   function format-point-to-comma returns char (input orig as char ) .
      882   define variable rtext as character no-undo .
      883   define variable strt as integer no-undo .
      884   define variable leng as integer no-undo .
      885   assign rtext = orig .
      886   repeat:
      887     strt =  index(rtext,'.').
      888     if strt = 0 then leave.
      889     leng = 1.
      890     substring(rtext,strt,leng,"character") = v-delim .
      891   end.
      892   return rtext.
      893   end function.
      894   function format-excel-text returns char ( input start-text as char ) :
      895   def var  i    as int no-undo.
      896   def var  ch   as char no-undo.
      897   def var  n    as int no-undo.
      898   def var  ipos as int no-undo.
      899     n = num-entries(trim(start-text), chr(10)) - 1 .
      900     do i = 1 to n :
      901       ipos = index( start-text, chr(10)).
      902       if ipos > 0 then
      903         substr( start-text, ipos, 1 ) = ' '.
      904     end.
      905     n = num-entries(trim(start-text), chr(13)) - 1 .
      906     do i = 1 to n :
      907       ipos = index( start-text, chr(13)).
      908       if ipos > 0 then
      909         substr( start-text, ipos, 1 ) = ' '.
      910     end.
      911     if index( start-text, '"' ) = 0 then
      912       start-text =  '="'   + trim( start-text) + '"'   .
      913       else do:
      914         n = num-entries(trim(start-text), '"') - 1.
      915         do i = 1 to n :
      916           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      917         end.
      918         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      919         start-text = '="'  + ch  + '"' .
      920       end.
      921     return start-text.
      922   end.
      923   function excel-sum returns char (input p-dec as decimal ).
      924     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      925   end function.
      926   function excel-qnty returns char (input p-dec as decimal ).
      927     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      928   end function.
      929   function format-excel-text-macr returns char ( input start-text as char ) :
      930   def var  i    as int no-undo.
      931   def var  ch   as char no-undo.
      932   def var  n    as int no-undo.
      933   def var  ipos as int no-undo.
      934     n = num-entries(trim(start-text), chr(10)) - 1 .
      935     do i = 1 to n :
      936       ipos = index( start-text, chr(10)).
      937       if ipos > 0 then
      938         substring( start-text, ipos , 1 ) = ' '.
      939     end.
      940     n = num-entries(trim(start-text), chr(13)) - 1 .
      941     do i = 1 to n :
      942       ipos = index( start-text, chr(13)).
      943       if ipos > 0 then
      944         substring( start-text, ipos, 1 ) = ' '.
      945     end.
      946     if index( start-text, '"' ) = 0 then
      947       start-text =  '"'   + trim( start-text) + '"'   .
      948       else do:
      949         n = num-entries(trim(start-text), '"') - 1.
      950         do i = 1 to n :
      951           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      952         end.
      953         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      954         start-text = '"'  + ch  + '"' .
      955       end.
      956     n = num-entries(trim(start-text), chr(10)) - 1 .
      957     do i = 1 to n :
      958       ipos = index( start-text, chr(10)).
      959       if ipos > 0 then
      960         substring( start-text, ipos , 1 ) = ' '.
      961     end.
      962       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      963     return start-text.
      964   end.
      965   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      966   procedure cur-time :
      967      define output parameter p-today as date      no-undo .
      968      define output parameter p-time  as integer   no-undo .
      969     do
      970     on error undo, return error
      971     :
      972       define variable v-date1 as date      no-undo .
      973       define variable v-date2 as date      no-undo .
      974       define variable v-time  as integer   no-undo .
      975       assign
      976         v-date1 = today
      977         v-time  = time
      978         v-date2 = today
      979       .
      980       if v-date1 <> v-date2
      981       then do:
      982         assign
      983           v-date1 = today
      984           v-time  = v-time
      985         .
      986       end.
      987       assign
      988         p-today = v-date1
      989         p-time  = v-time
      990       .
      991     end.
      992   end.
      993   function cur-time-date returns character
      994   :
      995     return string(today, '99/99/9999':U) .
      996   end.
      997   function cur-time-mjd returns decimal
      998   :
      999     define variable v-date as date      no-undo .
     1000     define variable v-time as integer   no-undo .
     1001     run cur-time in this-procedure
     1002       (output v-date
     1003       ,output v-time
     1004       ) .
     1005     return integer(v-date) - 2400002 + (v-time / 86400) .
     1006   end.
     1007   function cur-time-get-ending-index returns integer
     1008   (input p-number as integer
     1009   )
     1010   :
     1011     if p-number < 0
     1012     or p-number = ?
     1013     then do:
     1014       return 1 .
     1015     end.
     1016     define variable v-rest as integer   no-undo .
     1017     assign
     1018       p-number = p-number modulo 100
     1019     .
     1020     if p-number < 20
     1021     then do:
     1022       assign
     1023         v-rest = p-number
     1024       .
     1025     end.
     1026     else do:
     1027       assign
     1028         v-rest = p-number modulo 10
     1029       .
     1030     end.
     1031     case v-rest :
     1032       when 1
     1033       then do:
     1034         return 2 .
     1035       end.
     1036       when 2 or
     1037       when 3 or
     1038       when 4
     1039       then do:
     1040         return 3 .
     1041       end.
     1042       otherwise do:
     1043         return 1 .
     1044       end.
     1045     end case .
     1046   end.
     1047   procedure cur-time-mjd-to-date :
     1048      define input  parameter i-mjd-diff as decimal no-undo.
     1049      define output parameter o-Date     as date    no-undo.
     1050      define output parameter o-Time     as integer no-undo.
     1051      define variable v-day-number as integer   no-undo .
     1052      if    i-mjd-diff < 0
     1053         or i-mjd-diff = ?
     1054      then do:
     1055         return "?" .
     1056      end.
     1057      assign
     1058         v-day-number = truncate(i-mjd-diff,0).
     1059         o-Date = date(v-day-number + 2400002).
     1060         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1061     .
     1062   end.
     1063   function cur-time-mjd-to-string returns character
     1064   (input p-mjd-diff as decimal
     1065   )
     1066   :
     1067     define variable v-day-number as integer   no-undo .
     1068     define variable v-seconds    as integer   no-undo .
     1069     define variable v-hour       as integer   no-undo .
     1070     define variable v-min        as integer   no-undo .
     1071     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1072     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1073     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1074     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1075     if p-mjd-diff < 0
     1076     or p-mjd-diff = ?
     1077     then do:
     1078       return "?" .
     1079     end.
     1080     assign
     1081       v-day-number = integer(truncate(p-mjd-diff,0))
     1082       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1083     .
     1084     if v-seconds > 86400
     1085     then do:
     1086       assign
     1087         v-seconds = 86400 - 1
     1088       .
     1089     end.
     1090     if v-seconds < 0
     1091     then do:
     1092       assign
     1093         v-seconds = 0
     1094       .
     1095     end.
     1096     assign
     1097       v-hour = truncate(v-seconds / 3600, 0)
     1098     .
     1099     assign
     1100       v-seconds = v-seconds modulo 3600
     1101     .
     1102     assign
     1103       v-min = truncate(v-seconds / 60, 0)
     1104     .
     1105     assign
     1106       v-seconds = v-seconds modulo 60
     1107     .
     1108     return
     1109         (if v-day-number <> 0
     1110           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1111           else ""
     1112         )
     1113       + (if v-day-number <> 0 or v-hour <> 0
     1114           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1115           else ""
     1116         )
     1117       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1118           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1119           else ""
     1120         )
     1121       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1122       .
     1123   end.
     1124   function cur-time-string returns character
     1125   :
     1126     define variable v-date as date      no-undo .
     1127     define variable v-time as integer   no-undo .
     1128     run cur-time in this-procedure
     1129       (output v-date
     1130       ,output v-time
     1131       ) .
     1132     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1133   end.
     1134   function cur-time-string-sec returns character
     1135   :
     1136     define variable v-date as date      no-undo .
     1137     define variable v-time as integer   no-undo .
     1138     run cur-time in this-procedure
     1139       (output v-date
     1140       ,output v-time
     1141       ) .
     1142     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1143   end.
     1144   function cur-time-custom  returns character
     1145   (input p-prefix as character
     1146   ,input p-date-format as character
     1147   ,input p-delimiter as character
     1148   ,input p-time-format as character
     1149   ,input p-suffix as character
     1150   )
     1151   :
     1152     define variable v-date as date      no-undo .
     1153     define variable v-time as integer   no-undo .
     1154     run cur-time in this-procedure
     1155       (output v-date
     1156       ,output v-time
     1157       ) .
     1158     return
     1159       p-prefix
     1160       + string(v-date, p-date-format)
     1161       + p-delimiter
     1162       + string(v-time, p-time-format)
     1163       + p-suffix
     1164       .
     1165   end.
     1166   function cur-time-print  returns character
     1167   :
     1168     define variable v-date as date      no-undo .
     1169     define variable v-time as integer   no-undo .
     1170     run cur-time in this-procedure
     1171       (output v-date
     1172       ,output v-time
     1173       ) .
     1174     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1175   end.
     1176   function cur-time-datetime returns datetime
     1177   :
     1178     define variable v-char as character no-undo .
     1179     define variable v-datetime as datetime no-undo .
     1180     v-char = cur-time-string().
     1181     v-datetime = datetime(v-char).
     1182     return  v-datetime.
     1183   end.
     1184   function cur-time-string-msec returns character
     1185   :
     1186     define variable v-date as datetime  no-undo .
     1187     v-date = now.
     1188     return string(v-date) .
     1189   end.
