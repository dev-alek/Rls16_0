     2208     run clear-item  in this-procedure .
     2209   run ost-line in this-procedure
     2210       (input   x-store-code  ,
     2211       input   x-store-type  ,
     2212       input   gds-zap-artic     ,
     2213       input   gds-zap-prod-code ,
     2214       input   gds-zap-prod-type ,
     2215       input   x-tog-shift       ,
     2216       input   fact-order-1               ,
     2217       input   'cost':U            ,
     2218       input   '##,##':U    ,
     2219       input   xtog-obj    ,
     2220       output  quantity    ,
     2221       output  coast_r     ,
     2222       output  coast_v     ,
     2223       output  vat_r       ,
     2224       output  vat_v       ,
     2225       output  slt_r       ,
     2226       output  slt_v       ).
     2227   assign
     2228     ostatok-start [1 + 0]   = quantity
     2229    ostatok-start [2 + 0]   = if tprintrubl then coast_r else coast_v
     2230    ostatok-start [3 + 0]   = if tprintrubl then vat_r   else vat_v
     2231    .
     2232   if xshowcrsa or xshowcrsands or use-column[23] or use-column[24] or xshowmediator then do :
     2233   run ost-line in this-procedure
     2234       (input   x-store-code  ,
     2235       input   x-store-type  ,
     2236       input   gds-zap-artic     ,
     2237       input   gds-zap-prod-code ,
     2238       input   gds-zap-prod-type ,
     2239       input   x-tog-shift       ,
