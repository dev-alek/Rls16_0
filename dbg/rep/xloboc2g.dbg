     1290   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1291   DEFINE BUTTON StopBtn AUTO-END-KEY
     1292        LABEL "Стоп"
     1293        SIZE 10 BY 1.
     1294   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1295        LABEL "Обработано записей"
     1296         VIEW-AS TEXT
     1297        SIZE 14 BY .67 NO-UNDO.
     1298   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1299         VIEW-AS TEXT
     1300        SIZE 53.25 BY .67
     1301        FGCOLOR 1  NO-UNDO.
     1302   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1303         VIEW-AS TEXT
     1304        SIZE 53.25 BY .67
     1305        FGCOLOR 1  NO-UNDO.
     1306   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1307         VIEW-AS TEXT
     1308        SIZE 53.25 BY .67
     1309        FGCOLOR 1  NO-UNDO.
     1310   DEFINE RECTANGLE RECT-1
     1311        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1312        SIZE 55.13 BY 4.46.
     1313   DEFINE FRAME InfoFrame
     1314        StopBtn AT ROW 4.25 COL 21.75
     1315        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1316        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1317        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1318        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1319        RECT-1 AT ROW 1 COL 1
     1320       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1321            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1322            TITLE "Процесс"
     1323            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1324   define variable mFrameView      as logical   no-undo init yes.
     1325     define variable mFramHandle as handle no-undo.
     1326     mFramHandle = frame InfoFrame:handle.
     1327     if  log-manager:logfile-name ne ?
     1328     then DO:
     1329         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1330         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1331         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1332     end.
     1333     mFrameView = not session:batch-mode and mFramHandle:visible.
     1334     if mFrameView
     1335     then do:
     1336       ASSIGN
     1337          FRAME InfoFrame:HIDDEN                           = TRUE
     1338          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1339     end.
     1340   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1341   DO:
     1342     IF not StopProcessing THEN
     1343       Message "Вы действительно хотите прервать" SKIP
     1344               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1345                 UPDATE StopProcessing.
     1346     IF StopProcessing THEN do:
     1347        if mFrameView
     1348        then do:
     1349           HIDE FRAME InfoFrame.
     1350        end.
     1351     End.
     1352   END.
