     3290        repeat v-ii = 2 to 4 :
     3291        v-summa[v-ii ]  =
     3292           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     3293           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     3294           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     3295           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     3296           oborot-im[v-ii + tt#] .
     3297        end.
     3298         oborot-sum-sale[1] =
     3299         oborot-ee[2 + tt#] +
     3300         oborot-es[2 + tt#] +
     3301         oborot-re[2 + tt#] +
     3302         oborot-rs[2 + tt#]
     3303         .
     3304          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     3305           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     3306                                                                                                     -  oborot-disc[1]
     3307           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     3308           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     3309           .
     3310           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     3311           if oborot-sum-cost[1] <>  0 then
     3312             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     3313             else oborot-prc[1] = 0.
     3314     end.
     3315   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     3316   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     3317   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     3318   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     3319   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     3320   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     3321   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     3322   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     3323   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     3324   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     3325   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     3326   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     3327   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     3328   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     3329   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     3330   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     3331   end procedure.
     3332   procedure ost-line :
     3333     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     3334     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     3335     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     3336     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     3337     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     3338     define input  parameter x-tog-shift  as logical no-undo .
     3339     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     3340     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     3341     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     3342     define input  parameter xtog-obj     as logical no-undo .
     3343     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     3344     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     3345     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     3346     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     3347     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     3348     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     3349     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     3350     define buffer buff-obj-list  for obj-list .
     3351     define buffer buff-stk-line  for ub.stk-line .
     3352     assign
     3353       Quantity = 0
     3354       Coast_R  = 0
     3355       Coast_V  = 0
     3356       VAT_R    = 0
     3357       VAT_V    = 0
     3358       SLT_R    = 0
     3359       SLT_V    = 0
     3360     .
     3361     if  x-tog-shift = false then do:
     3362       for each buff-obj-list no-lock
     3363         where xtog-obj = false
     3364            or (buff-obj-list.obj-type = x-store-type
     3365               and buff-obj-list.obj-code = x-store-code
     3366               )
     3367       on error undo, return error
     3368       :
     3369         find last buff-stk-line no-lock
     3370           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3371             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3372             and buff-stk-line.artic      = x-artic
     3373             and buff-stk-line.prod-type  = x-prod-type
     3374             and buff-stk-line.prod-code  = x-prod-code
     3375             and buff-stk-line.sum-type   = x-sum-type
     3376             and buff-stk-line.cat-id     = '##,##':U
     3377             and buff-stk-line.fact-order <= x-fact-order
     3378             and buff-stk-line.shift-num  = 0
     3379           use-index category
     3380           no-error .
     3381         if available buff-stk-line then do:
     3382           assign
     3383             Quantity = Quantity +  buff-stk-line.fact-qnty
     3384             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3385             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3386             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3387             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3388             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3389             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3390           .
     3391         end.
     3392       end.
     3393     end.
     3394     else do:
     3395       for each buff-obj-list no-lock
     3396         where xtog-obj = false
     3397            or (buff-obj-list.obj-type = x-store-type
     3398               and buff-obj-list.obj-code = x-store-code
     3399               )
     3400       on error undo, return error
     3401       :
     3402         find last buff-stk-line no-lock
     3403           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3404             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3405             and buff-stk-line.artic      = x-artic
     3406             and buff-stk-line.prod-type  = x-prod-type
     3407             and buff-stk-line.prod-code  = x-prod-code
     3408             and buff-stk-line.sum-type   = x-sum-type
     3409             and buff-stk-line.cat-id     = '##,##':U
     3410             and buff-stk-line.fact-order <= x-fact-order
     3411             and buff-stk-line.shift-num  > 0
     3412           use-index category
     3413           no-error .
     3414         if available buff-stk-line then do:
     3415           assign
     3416             Quantity = Quantity +  buff-stk-line.fact-qnty
     3417             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3418             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3419             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3420             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3421             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3422             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3423           .
     3424         end.
     3425       end.
     3426     end.
     3427   end procedure.
     3428   procedure ost-lineother-tax :
     3429     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     3430     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     3431     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     3432     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     3433     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     3434     define input  parameter x-tog-shift  as logical no-undo .
     3435     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     3436     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     3437     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     3438     define input  parameter xTog-obj     as logical no-undo .
     3439     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     3440     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     3441     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     3442     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     3443     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     3444     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     3445     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     3446     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     3447     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     3448     define buffer buff-obj-list  for obj-list .
     3449     define buffer buff-stk-line  for ub.stk-line .
     3450     assign
     3451       Quantity = 0
     3452       Coast_R  = 0
     3453       Coast_V  = 0
     3454       VAT_R    = 0
     3455       VAT_V    = 0
     3456       SLT_R    = 0
     3457       SLT_V    = 0
     3458       other_R  = 0
     3459       other_V  = 0
     3460     .
     3461     if  x-tog-shift = false then do:
     3462       for each buff-obj-list no-lock
     3463         where xtog-obj = false
     3464            or (buff-obj-list.obj-type = x-store-type
     3465               and buff-obj-list.obj-code = x-store-code
     3466               )
     3467       on error undo, return error
     3468       :
     3469         find last buff-stk-line no-lock
     3470           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3471             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3472             and buff-stk-line.artic      = x-artic
     3473             and buff-stk-line.prod-type  = x-prod-type
     3474             and buff-stk-line.prod-code  = x-prod-code
     3475             and buff-stk-line.sum-type   = x-sum-type
     3476             and buff-stk-line.cat-id     = '##,##':U
     3477             and buff-stk-line.fact-order <= x-fact-order
     3478             and buff-stk-line.shift-num  = 0
     3479           use-index category
     3480           no-error .
     3481         if available buff-stk-line then do:
     3482           assign
     3483             Quantity = Quantity +  buff-stk-line.fact-qnty
     3484             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3485             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3486             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3487             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3488             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3489             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3490             other_R  = other_R  +  buff-stk-line.other-rubl
     3491             other_V  = other_V  +  buff-stk-line.other-base
     3492           .
     3493         end.
     3494       end.
     3495     end.
     3496     else do:
     3497       for each buff-obj-list no-lock
     3498         where xtog-obj = false
     3499            or (buff-obj-list.obj-type = x-store-type
     3500               and buff-obj-list.obj-code = x-store-code
     3501               )
     3502       on error undo, return error
     3503       :
     3504         find last buff-stk-line no-lock
     3505           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     3506             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     3507             and buff-stk-line.artic      = x-artic
     3508             and buff-stk-line.prod-type  = x-prod-type
     3509             and buff-stk-line.prod-code  = x-prod-code
     3510             and buff-stk-line.sum-type   = x-sum-type
     3511             and buff-stk-line.cat-id     = '##,##':U
     3512             and buff-stk-line.fact-order <= x-fact-order
     3513             and buff-stk-line.shift-num  > 0
     3514           use-index category
     3515           no-error .
     3516         if available buff-stk-line then do:
     3517           assign
     3518             Quantity = Quantity +  buff-stk-line.fact-qnty
     3519             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     3520             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     3521             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     3522             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     3523             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     3524             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     3525             other_R = other_R   +  buff-stk-line.other-rubl
     3526             other_V = other_V   +  buff-stk-line.other-base
     3527           .
     3528         end.
     3529       end.
     3530     end.
     3531   end procedure.
     3532   procedure ost-line-kg :
     3533     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     3534     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     3535     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     3536     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     3537     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     3538     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     3539     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     3540     define buffer buff-obj-list  for obj-list .
     3541     define buffer buf_doc-line for ub.doc-line .
     3542     define buffer buf_inv-line for ub.inv-line .
     3543     do
     3544     on error undo, return error
     3545     :
     3546       for each buf_doc-line no-lock where
     3547                buf_doc-line.obj-type    = p-obj-type   and
     3548                buf_doc-line.obj-code    = p-obj-code   and
     3549                buf_doc-line.prod-type   = p-prod-type  and
     3550                buf_doc-line.prod-code   = p-prod-code  and
     3551                buf_doc-line.artic       = p-artic      and
     3552                buf_doc-line.status_     = 'факт':U      and
     3553                buf_doc-line.fact-order <= p-fact-order
     3554             by buf_doc-line.fact-order    descending
     3555       :
     3556         find first buf_inv-line no-lock where
     3557                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     3558                    buf_inv-line.artic     = buf_doc-line.artic     and
     3559                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     3560                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     3561         if available buf_inv-line
     3562         then do:
     3563           if buf_inv-line.after-cli-qnty <> ?
     3564           then do:
     3565             assign
     3566               p-quantity-kg = buf_inv-line.after-cli-qnty
     3567             .
     3568             leave .
     3569           end.
     3570         end.
     3571       end.
     3572       if p-quantity-kg = ?
     3573       then do:
     3574         assign
     3575           p-quantity-kg = 0
     3576         .
     3577       end.
     3578     end.
     3579   end procedure.
     3580   PROCEDURE ostatok :
     3581   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3582   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3583   def input parameter x-tog-shift   as   logical             no-undo.
     3584   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3585   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3586   def input parameter x-shift-start as integer               no-undo.
     3587   def input parameter x-shift-end   as integer               no-undo.
     3588   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3589   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3590   def input parameter xTog-obj   as log no-undo.
     3591   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3592   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3593   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3594   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3595   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3596   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3597   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3598   def var              Fact-orderS   as char  no-undo.
     3599   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3600      Assign
     3601         Fact-order   = 0
     3602         Quantity     = 0
     3603         Coast_R      = 0
     3604         Coast_V      = 0
     3605         VAT_R        = 0
     3606         VAT_V        = 0 .
     3607    x-date-start-t  = x-date-start + 1 .
     3608   IF x-date-end = date('') then DO:
     3609      Fact-order = 0 .
     3610      for each obj-list
     3611          where  ( not xtog-obj or
     3612                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3613                 no-lock :
     3614         if  x-tog-shift = false then do:
     3615                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3616                               ub.stk-tot.Fact-date <=  x-date-start
     3617                               and ub.stk-tot.shift-num = 0
     3618                               USE-INDEX fact-date no-lock no-error .
     3619              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3620         End.
     3621         Else  DO :
     3622             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3623              (ub.stk-tot.shift-date  = x-date-start-t and
     3624               ub.stk-tot.shift-num  < x-shift-start or
     3625               ub.stk-tot.shift-date  < x-date-start-t  )
     3626               and ub.stk-tot.shift-num  > 0
     3627               USE-INDEX Shift-num no-lock no-error .
     3628            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3629           END.
     3630       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3631     End.
     3632   End.
     3633   Else DO:
     3634     For each obj-list  WHERE
     3635        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3636         no-lock :
     3637      IF  x-TOG-Shift = False Then DO:
     3638          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3639               ub.stk-tot.Fact-date <= x-date-end
     3640               and ub.stk-tot.shift-num = 0
     3641               USE-INDEX fact-date no-lock no-error.
     3642          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3643      END.
     3644      Else DO:
     3645           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3646               (ub.stk-tot.shift-date  = x-date-end and
     3647               ub.stk-tot.shift-num  <= x-shift-end or
     3648               ub.stk-tot.shift-date  < x-date-end       ) and
     3649               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3650               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3651       End.
     3652       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3653     End.
     3654   End.
     3655   END PROCEDURE.
     3656   procedure calc-sub-itog :
     3657   def input parameter tt as int no-undo.
     3658   define variable tt2 as integer no-undo .
     3659     if tt = 6 then tt2 = 7 .
     3660               else tt2 = tt.
     3661   repeat i# = 1 + tt to 3 + tt2 :
     3662   run sum-i (
     3663    input oborot-vt[i#]
     3664   ,input tt
     3665   ,input-output b1-oborot-vt[i#]
     3666   ,input-output b2-oborot-vt[i#]
     3667   ,input-output bi-oborot-vt[i#]
     3668   ,input-output bo-oborot-vt[i#]
     3669   ,input oborot-ie[i#]
     3670   ,input-output b1-oborot-ie[i#]
     3671   ,input-output b2-oborot-ie[i#]
     3672   ,input-output bi-oborot-ie[i#]
     3673   ,input-output bo-oborot-ie[i#]
     3674   ) .
     3675   run sum-i (
     3676    input oborot-iv[i#]
     3677   ,input tt
     3678   ,input-output b1-oborot-iv[i#]
     3679   ,input-output b2-oborot-iv[i#]
     3680   ,input-output bi-oborot-iv[i#]
     3681   ,input-output bo-oborot-iv[i#]
     3682   ,input oborot-ee[i#]
     3683   ,input-output b1-oborot-ee[i#]
     3684   ,input-output b2-oborot-ee[i#]
     3685   ,input-output bi-oborot-ee[i#]
     3686   ,input-output bo-oborot-ee[i#]
     3687   ) .
     3688   run sum-i (
     3689    input oborot-ev[i#]
     3690   ,input tt
     3691   ,input-output b1-oborot-ev[i#]
     3692   ,input-output b2-oborot-ev[i#]
     3693   ,input-output bi-oborot-ev[i#]
     3694   ,input-output bo-oborot-ev[i#]
     3695   ,input oborot-ep[i#]
     3696   ,input-output b1-oborot-ep[i#]
     3697   ,input-output b2-oborot-ep[i#]
     3698   ,input-output bi-oborot-ep[i#]
     3699   ,input-output bo-oborot-ep[i#]
     3700   ) .
     3701   run sum-i (
     3702    input oborot-rv[i#]
     3703   ,input tt
     3704   ,input-output b1-oborot-rv[i#]
     3705   ,input-output b2-oborot-rv[i#]
     3706   ,input-output bi-oborot-rv[i#]
     3707   ,input-output bo-oborot-rv[i#]
     3708   ,input oborot-es[i#]
     3709   ,input-output b1-oborot-es[i#]
     3710   ,input-output b2-oborot-es[i#]
     3711   ,input-output bi-oborot-es[i#]
     3712   ,input-output bo-oborot-es[i#]
     3713   ) .
     3714   run sum-i (
     3715    input oborot-em[i#]
     3716   ,input tt
     3717   ,input-output b1-oborot-em[i#]
     3718   ,input-output b2-oborot-em[i#]
     3719   ,input-output bi-oborot-em[i#]
     3720   ,input-output bo-oborot-em[i#]
     3721   ,input oborot-re[i#]
     3722   ,input-output b1-oborot-re[i#]
     3723   ,input-output b2-oborot-re[i#]
     3724   ,input-output bi-oborot-re[i#]
     3725   ,input-output bo-oborot-re[i#]
     3726   ) .
     3727   run sum-i (
     3728    input oborot-im[i#]
     3729   ,input tt
     3730   ,input-output b1-oborot-im[i#]
     3731   ,input-output b2-oborot-im[i#]
     3732   ,input-output bi-oborot-im[i#]
     3733   ,input-output bo-oborot-im[i#]
     3734   ,input oborot-rs[i#]
     3735   ,input-output b1-oborot-rs[i#]
     3736   ,input-output b2-oborot-rs[i#]
     3737   ,input-output bi-oborot-rs[i#]
     3738   ,input-output bo-oborot-rs[i#]
     3739   ) .
     3740   run sum-i (
     3741    input oborot-ot[i#]
     3742   ,input tt
     3743   ,input-output b1-oborot-ot[i#]
     3744   ,input-output b2-oborot-ot[i#]
     3745   ,input-output bi-oborot-ot[i#]
     3746   ,input-output bo-oborot-ot[i#]
     3747   ,input oborot-we[i#]
     3748   ,input-output b1-oborot-we[i#]
     3749   ,input-output b2-oborot-we[i#]
     3750   ,input-output bi-oborot-we[i#]
     3751   ,input-output bo-oborot-we[i#]
     3752   ) .
     3753   run sum-i (
     3754    input oborot-ap[i#]
     3755   ,input tt
     3756   ,input-output b1-oborot-ap[i#]
     3757   ,input-output b2-oborot-ap[i#]
     3758   ,input-output bi-oborot-ap[i#]
     3759   ,input-output bo-oborot-ap[i#]
     3760   ,input oborot-pc[i#]
     3761   ,input-output b1-oborot-pc[i#]
     3762   ,input-output b2-oborot-pc[i#]
     3763   ,input-output bi-oborot-pc[i#]
     3764   ,input-output bo-oborot-pc[i#]
     3765   ) .
     3766     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     3767     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     3768     if tmp-gds.lvl <= 1 then do:
     3769       bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     3770       bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     3771     end.
     3772     if i# = 8 then
     3773       assign
     3774         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     3775                                 bi-oborot-re[ i#]         +
     3776                                 bi-oborot-rs[ i#]    +
     3777                                 bi-oborot-es[ i#]
     3778         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     3779                                 b1-oborot-re[ i#]         +
     3780                                 b1-oborot-rs[ i#]    +
     3781                                 b1-oborot-es[ i#]
     3782         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     3783                                 b2-oborot-re[ i#]         +
     3784                                 b2-oborot-rs[ i#]    +
     3785                                 b2-oborot-es[ i#]
     3786         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     3787                                 bo-oborot-re[ i#]         +
     3788                                 bo-oborot-rs[ i#]    +
     3789                                 bo-oborot-es[ i#]
     3790         .
     3791     if  xshowmediator = true  then do:
     3792         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     3793         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     3794         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     3795         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     3796     end.
     3797     if i# = 2 and  xshowmediator = false  then
     3798         assign
     3799           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     3800                                   bi-oborot-re[ i#]         +
     3801                                   bi-oborot-rs[ i#]    +
     3802                                   bi-oborot-es[ i#]
     3803           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     3804                                   b1-oborot-re[ i#]         +
     3805                                   b1-oborot-rs[ i#]    +
     3806                                   b1-oborot-es[ i#]
     3807           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     3808                                   b2-oborot-re[ i#]         +
     3809                                   b2-oborot-rs[ i#]    +
     3810                                   b2-oborot-es[ i#]
     3811           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     3812                                   bo-oborot-re[ i#]         +
     3813                                   bo-oborot-rs[ i#]    +
     3814                                   bo-oborot-es[ i#]
     3815           .
     3816     if i# = 7 then b1-oborot-disc[ 1]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     3817     if i# = 7 then b2-oborot-disc[ 1]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     3818     if tmp-gds.lvl <= 1 then do:
     3819         if i# = 7 then bi-oborot-disc[ 1]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     3820         if i# = 7 then bo-oborot-disc[ 1]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     3821         if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     3822         if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     3823             if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     3824                                   bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     3825                                   else bi-oborot-prc[1] = 0.
     3826             if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     3827                                   bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     3828                                   else bo-oborot-prc[1] = 0.
     3829         bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     3830         bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     3831     end.
     3832     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     3833     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     3834             if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     3835                                   b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     3836                                   else b1-oborot-prc[1] = 0.
     3837             if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     3838                                   b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     3839                                   else b2-oborot-prc[1] = 0.
     3840    end.
     3841   end procedure.
     3842   procedure sum-i :
     3843   def input parameter ob like oborot-ot[1] no-undo.
     3844   def input parameter tt as int  no-undo.
     3845   def input-output parameter b1 like b1-oborot-ot[1] no-undo.
     3846   def input-output parameter b2 like b1-oborot-ot[1] no-undo.
     3847   def input-output parameter bi like b1-oborot-ot[1] no-undo.
     3848   def input-output parameter bo like b1-oborot-ot[1] no-undo.
     3849   def input parameter ob2 like oborot-ot[1] no-undo.
     3850   def input-output parameter b1- like b1-oborot-ot[1] no-undo.
     3851   def input-output parameter b2- like b1-oborot-ot[1] no-undo.
     3852   def input-output parameter bi- like b1-oborot-ot[1] no-undo.
     3853   def input-output parameter bo- like b1-oborot-ot[1] no-undo.
     3854   assign
     3855    b1  = b1 + ob
     3856    b2  = b2 + ob
     3857    b1- = b1- + ob2
     3858    b2- = b2- + ob2
     3859    .
     3860   if tmp-gds.lvl <= 1 then do:
     3861       assign
     3862       bi = bi + ob
     3863       bo = bo + ob
     3864       bi- = bi- + ob2
     3865       bo- = bo- + ob2
     3866       .
     3867   end.
     3868   end procedure.
     3869   procedure clear-item :
     3870   define variable kk as int no-undo.
     3871    repeat kk = 1 to 13 :
     3872    assign
     3873       oborot-ie                 [kk]    = 0
     3874       oborot-ee                 [kk]    = 0
     3875       oborot-ep              [kk]    = 0
     3876       oborot-es            [kk]    = 0
     3877       oborot-re             [kk]    = 0
     3878       oborot-rs        [kk]    = 0
     3879       oborot-we                 [kk]    = 0
     3880       oborot-vt                       [kk]    = 0
     3881       oborot-iv                 [kk]    = 0
     3882       oborot-ev                 [kk]    = 0
     3883       oborot-rv             [kk]    = 0
     3884       oborot-em                  [kk]    = 0
     3885       oborot-wm                  [kk]    = 0
     3886       oborot-im                  [kk]    = 0
     3887       oborot-ot                  [kk]    = 0
     3888       oborot-pc           [kk]    = 0
     3889       oborot-ap           [kk]    = 0
     3890       oborot-disc                             [kk]    = 0
     3891       oborot-eff                             [kk]    = 0
     3892       oborot-prc                             [kk]    = 0
     3893       ostatok-end      [kk] =   0
     3894       ostatok-start    [kk] =   0   .
     3895          end.
     3896    end procedure.
     3897   procedure item-goods :
     3898    def input parameter  par-3 as char no-undo.
     3899    def input parameter  par-4 as char no-undo.
     3900        if par-4 = "goods":u  then  assign
     3901                                       gds-zap-unit-base  = goods.unit-base
     3902                                       gds-zap-prt-root   = goods.prt-root
     3903                                       gds-zap-prod-type  = goods.prod-type
     3904                                       gds-zap-prod-code  = goods.prod-code
     3905                                       gds-zap-artic      = goods.artic
     3906                                       gds-zap-type       = goods.gds-type
     3907                                       gds-zap-grp-name   = goods.grp-name
     3908                                       gds-zap-b-code     = goods.gds-code
     3909                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     3910                                                                          else goods.gds-name.
     3911        if par-4 = "gds-list":u  then  assign
     3912                                       gds-zap-unit-base  = gds-list.unit-base
     3913                                       gds-zap-prt-root   = gds-list.prt-root
     3914                                       gds-zap-prod-type  = gds-list.prod-type
     3915                                       gds-zap-prod-code  = gds-list.prod-code
     3916                                       gds-zap-artic      = gds-list.artic
     3917                                       gds-zap-type       = gds-list.gds-type
     3918                                       gds-zap-grp-name   = gds-list.grp-name
     3919                                       gds-zap-b-code     = gds-list.gds-code
     3920                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     3921                                                                          else gds-list.gds-name.
     3922       run foreach in this-procedure .
     3923   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3924     (input  gds-zap-b-code
     3925     ,input  ?
     3926     ,output v-bar-code
     3927     )  .
     3928   s-bar-code = string (v-bar-code,"999999999").
     3929       If  break_group = true  and par-3 <> "1"  then DO :
     3930            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3931            gds-zap-prod-name  = clients.obj-name.
     3932             If break_group1 = true  THEN  DO :
     3933               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3934                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3935                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3936               if par-3 = "6"  then  dO:
     3937                  if xTog-obj = true then do:
     3938                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     3939                   end.
     3940                  else do:
     3941                   var-vat-pc = temp-gds-list.vat-pc  .
     3942                   end.
     3943                   assign
     3944                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3945                       b1-name = temp-str .
     3946                   end.
     3947               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3948                   fr0 = true .
     3949                   tmp#stroka0 = temp-str.
     3950               End .
     3951             End .
     3952             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     3953               if par-3 = "4"
     3954                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     3955                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     3956               if NOT xSumsOnly THEN DO :
     3957               fr = true .
     3958               End.
     3959               break_group1 = false.
     3960             END.
     3961          break_group = false.
     3962       End.
     3963       run display-line in this-procedure .
     3964    end procedure.
     3965    procedure null-str-pr :
     3966    if (
     3967        oborot-ie                 [1] = 0  and
     3968        oborot-ee                 [1] = 0  and
     3969        oborot-ep              [1] = 0  and
     3970        oborot-es            [1] = 0  and
     3971        oborot-re             [1] = 0  and
     3972        oborot-rs        [1] = 0  and
     3973        oborot-we                 [1] = 0  and
     3974        oborot-vt                       [1] = 0  and
     3975        oborot-iv                [1] = 0  and
     3976        oborot-ev                [1] = 0  and
     3977        oborot-rv            [1] = 0  and
     3978        oborot-ot                 [2] = 0  and
     3979        oborot-pc          [1] = 0 and
     3980        oborot-ap          [1] = 0 and
     3981        ostatok-end[1]                                    = 0  and
     3982        ostatok-start[1]                                  = 0 and
     3983        oborot-ie                 [2] = 0  and
     3984        oborot-ee                 [2] = 0  and
     3985        oborot-ep              [2] = 0  and
     3986        oborot-es            [2] = 0  and
     3987        oborot-re             [2] = 0  and
     3988        oborot-rs        [2] = 0  and
     3989        oborot-we                 [2] = 0  and
     3990        oborot-vt                       [2] = 0  and
     3991        oborot-iv                [2] = 0  and
     3992        oborot-ev                [2] = 0  and
     3993        oborot-rv            [2] = 0  and
     3994        oborot-pc          [2] = 0 and
     3995        oborot-ap          [2] = 0 and
     3996        ostatok-end[2]                                    = 0  and
     3997        ostatok-start[2]                                  = 0
     3998        ) then   null-str# = 0    .
     3999       end procedure.
     4000    procedure null-str-pr2 :
     4001    if (
     4002        oborot-ie     [1]         = 0  and
     4003        oborot-ee                 [1] = 0  and
     4004        oborot-ep              [1] = 0  and
     4005        oborot-es            [1] = 0  and
     4006        oborot-re             [1] = 0  and
     4007        oborot-rs        [1] = 0  and
     4008        oborot-we                 [1] = 0  and
     4009        oborot-vt                       [1] = 0  and
     4010        oborot-iv                [1] = 0  and
     4011        oborot-ev                [1] = 0  and
     4012        oborot-rv            [1] = 0  and
     4013        oborot-pc           [1]    = 0 and
     4014        oborot-ap           [1]    = 0 and
     4015        oborot-ie     [2]         = 0  and
     4016        oborot-ee                 [2] = 0  and
     4017        oborot-ep              [2] = 0  and
     4018        oborot-es            [2] = 0  and
     4019        oborot-re             [2] = 0  and
     4020        oborot-rs        [2] = 0  and
     4021        oborot-we                 [2] = 0  and
     4022        oborot-vt                       [2] = 0  and
     4023        oborot-iv                [2] = 0  and
     4024        oborot-ev                [2] = 0  and
     4025        oborot-rv            [2] = 0  and
     4026        oborot-pc           [2]    = 0 and
     4027        oborot-ap           [2]    = 0 and
     4028        oborot-ot                 [2] = 0
     4029        ) then   null-str2# = 0    .
     4030       end procedure.
     4031   procedure ex-display :
     4032   def input parameter par-1 as int no-undo.
     4033   def input parameter par-2 like  ostatok-start[1] no-undo.
     4034   def input parameter par-i as int no-undo.
     4035     assign num#col#  = par-1.
     4036     if par-i = 1 then do:
     4037       run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4038       run macr_cell_format
     4039                       ( 10    ,
     4040                         false   ,
     4041                         false   ,
     4042                         15    ,
     4043                         num#str# ,
     4044                         num#col# ,
     4045                         num#str# ,
     4046                         num#col#  ) .
     4047     end.
     4048     else do:
     4049        run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4050     end.
     4051   end procedure.
     4052   procedure u-line:
     4053   end procedure.
     4054   procedure p-line:
     4055   end procedure.
     4056   procedure make-col :
     4057    define variable l#1 as int  no-undo.
     4058    define variable l#2 as int  no-undo.
     4059    define variable l as int  no-undo.
     4060         nk = 0.
     4061         kk = 0.
     4062            if xshowcost    then do: kk = kk + 1. end.
     4063            if xshowcostnds then do: kk = kk + 1. end.
     4064            if xshowcrsa    then do: kk = kk + 1. end.
     4065            if xshowcrsands then do: kk = kk + 1. end.
     4066            if xshowsale    then do: kk = kk + 1. end.
     4067            if xshowsalends then do: kk = kk + 1. end.
     4068            if xshowsaleslt then do: kk = kk + 1. end.
     4069            if xshowmediator then do: kk = kk + 1. end.
     4070       num#str# = num#str# + 1.
     4071       num#col#  = 0 .
     4072    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4073    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4074    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4075    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4076    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4077    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4078    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4079    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4080       mp = num#col#  + 1.
     4081       mp-1 = num#col#  .
     4082    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4083    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4084    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4085    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4086    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4087    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4088    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4089    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4090    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4091    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4092    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4093    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4094    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4095    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4096    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4097    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char ("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4098    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format ('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4099    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format ('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4100    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format ("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     4101       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     4102      num#str# = num#str# + 1.
     4103      repeat l#1 = mp to nk :
     4104            l#2 = 0.
     4105                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "количество"  , num#str# , num#col#  ) .
     4106            if xshowcost    then do:
     4107                l#2 = l#2 + 1.
     4108                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "учетн. сумма"  , num#str# , num#col#  ) .
     4109                end.
     4110            if xshowcostnds then do:
     4111                l#2 = l#2 + 1.
     4112                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "учетн.НДС"  , num#str# , num#col#  ) .
     4113               end.
     4114            if xshowmediator then do:
     4115               l#2 = l#2 + 1.
     4116               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "цены поср."  , num#str# , num#col#  ) .
     4117               end.
     4118            if xshowcrsa    then do:
     4119               l#2 = l#2 + 1.
     4120               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "продаж. сумма"  , num#str# , num#col#  ) .
     4121               end.
     4122            if xshowcrsands then do:
     4123               l#2 = l#2 + 1.
     4124               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "продаж.НДС"  , num#str# , num#col#  ) .
     4125               end.
     4126             if xshowsale    then do:
     4127               l#2 = l#2 + 1.
     4128               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "док. сумма"  , num#str# , num#col#  ) .
     4129               end.
     4130            if xshowsalends then do:
     4131               l#2 = l#2 + 1.
     4132               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "док.НДС"  , num#str# , num#col#  ) .
     4133               end.
     4134            if xshowsaleslt then do:
     4135               l#2 = l#2 + 1.
     4136               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char ( "док.НсП"  , num#str# , num#col#  ) .
     4137               end.
     4138        end.
     4139   end procedure .
