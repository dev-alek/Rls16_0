     2757     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ee          [i] -  bo-oborot-ee          [3] ),  i). end.
     2758     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ev          [i] -  bo-oborot-ev          [3] ),  i). end.
     2759     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-em           [i] -  bo-oborot-em           [3] ),  i). end.
     2760     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-we          [i] -  bo-oborot-we          [3] ),  i). end.
     2761     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-es     [i] -  bo-oborot-es     [3] ),  i). end.
