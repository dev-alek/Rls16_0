     2253    ostatok-start [2 + 3]   = if tprintrubl then coast_r else coast_v
     2254    ostatok-start [3 + 3]   = if tprintrubl then vat_r   else vat_v
     2255    .
     2256      end.
     2257   if xshowsale or xshowsalends or xshowsaleslt then do:
