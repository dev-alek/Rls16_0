     3070   procedure ob-line  :
     3071   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3072   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3073   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3074   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3075   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3076   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3077   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3078   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3079   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3080   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3081   define input  parameter xtog-obj           as log no-undo.
     3082   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3083   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3084   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3085   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3086   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3087   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3088   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3089   define variable  v-summa  as decimal extent 4 no-undo .
     3090   define variable  tt#          as int no-undo.
     3091   define variable v-ii as integer no-undo .
     3092   define variable slt  as decimal no-undo .
     3093   define variable disc  as decimal no-undo .
     3094   define variable xi as integer no-undo .
     3095   define variable v-tt as integer no-undo .
     3096    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3097       else
     3098       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3099       else
     3100       assign tt# = 6  v-tt = 200.
     3101     if long-p = false then do :
     3102     for each obj-list no-lock:
     3103      if  xtog-obj then
     3104          if   not(x-store-type     = obj-list.obj-type
     3105               and x-store-code    = obj-list.obj-code ) then next.
     3106           for each ub.ot-line where
     3107                     ub.ot-line.artic         = x-artic
     3108               and   ub.ot-line.prod-code    = x-prod-code
     3109               and   ub.ot-line.prod-type    = x-prod-type
     3110               and   ub.ot-line.fact-order   <= x-fact-order-2
     3111               and   ub.ot-line.fact-order   >= x-fact-order-1
     3112               and   ub.ot-line.obj-code     = obj-list.obj-code
     3113               and   ub.ot-line.obj-type     = obj-list.obj-type
     3114               and   ub.ot-line.sum-type     = x-sum-type
     3115               no-lock :
     3116               case ub.ot-line.ext-doc-type:
     3117     WHEN 'ie':U THEN DO:
     3118       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3119             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3120             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3121         if tt# = 6 Then   assign
     3122             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3123             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3124             End.
     3125     WHEN 'ee':U THEN DO:
     3126       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3127             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3128             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3129         if tt# = 6 Then   assign
     3130             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3131             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3132             End.
     3133     WHEN 'ep':U THEN DO:
     3134       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3135             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3136             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3137         if tt# = 6 Then   assign
     3138             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3139             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3140             End.
     3141     WHEN 'es':U THEN DO:
     3142       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3143             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3144             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3145         if tt# = 6 Then   assign
     3146             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
