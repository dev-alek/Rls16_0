     2790   procedure display-b1  :
     2791   define variable ll as int no-undo.
     2792   define variable kk as int no-undo.
     2793     num#str#  = num#str#  + 1     .
     2794     num#col# = 2              .
     2795     if substitute( "&1", sf1:screen-value )  <> "?" then do:
     2796         run macr_excel_char (  caps(  s-bar-code +
     2797                                     sf1:screen-value +
     2798                                     gds-zap-artic +
     2799                                     sf2:screen-value +
     2800                                     gds-zap-gds-name +
     2801                                     temp-str-2         )  , num#str# , num#col#  ) .
     2802                          end.
     2803      else do:
