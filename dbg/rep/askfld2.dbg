      859   ON CHOOSE OF B-exit IN FRAME Dialog-Frame
      860   DO:
      861     def var l-ind as integer no-undo .
      862     assign TOG-1 TOG-10 TOG-2 TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6 TOG-15 TOG-7 TOG-16 TOG-8 TOG-17 TOG-9 TOG-18.
      863     assign ParamStr = "" .
      864     if TOG-1  = yes then ParamStr = ParamStr + "1," .
      865     if TOG-2  = yes then ParamStr = ParamStr + "2," .
      866     if TOG-3  = yes then ParamStr = ParamStr + "3," .
      867     if TOG-4  = yes then ParamStr = ParamStr + "4," .
      868     if TOG-5  = yes then ParamStr = ParamStr + "5," .
      869     if TOG-6  = yes then ParamStr = ParamStr + "6," .
      870     if TOG-7  = yes then ParamStr = ParamStr + "7," .
      871     if TOG-8  = yes then ParamStr = ParamStr + "8," .
      872     if TOG-9  = yes then ParamStr = ParamStr + "9," .
      873     if TOG-10 = yes then ParamStr = ParamStr + "10," .
      874     if TOG-11 = yes then ParamStr = ParamStr + "11," .
      875     if TOG-12 = yes then ParamStr = ParamStr + "12," .
      876     if TOG-13 = yes then ParamStr = ParamStr + "13," .
      877     if TOG-14 = yes then ParamStr = ParamStr + "14," .
      878     if TOG-15 = yes then ParamStr = ParamStr + "15," .
      879     if TOG-16 = yes then ParamStr = ParamStr + "16," .
      880     if TOG-17 = yes then ParamStr = ParamStr + "17," .
      881     if TOG-18 = yes then ParamStr = ParamStr + "18," .
      882    find first ubflt.usr-flt share-lock where
      883      ubflt.usr-flt.user-name  = g#userid and
      884      ubflt.usr-flt.call-point = "e-ben-dt":U
      885    no-error .
      886    if NOT avail ubflt.usr-flt then  create ubflt.usr-flt.
      887    Assign
      888      ubflt.usr-flt.user-name  = g#userid
      889      ubflt.usr-flt.call-point = "e-ben-dt":U
      890      ubflt.usr-flt.list_      = ParamStr
      891    .
      892   END.
