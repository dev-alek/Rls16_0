      902      TOG-7 = false
      903      TOG-8 = false
      904      TOG-9 = false
      905      TOG-10 = false
      906      TOG-11 = false
      907      TOG-12 = false
      908      TOG-13 = false
      909      TOG-14 = false
      910      TOG-15 = false
      911      TOG-16 = false
      912      TOG-17 = false
      913      TOG-18 = false
      914     .
      915     Display  TOG-1 TOG-10 TOG-2 TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6 TOG-15 TOG-7 TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 with frame Dialog-Frame.
      916   END.
      917   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   on help of frame Dialog-Frame
      919   do:
      920     run gbl/app_help.p
      921       (input this-procedure :file-name
      922       ,input ''
      923       ,input ?
      924       ) no-error.
      925     if error-status :error then do:
      926       message
      927         "Ошибка при вызове помощи"
      928         error-status :get-message(1)
      929         view-as alert-box .
      930     end.
      931   end.
      932   run minbtn-set in this-procedure .
      933   on choose of b-help in frame Dialog-Frame
      934   do:
      935     apply "help":u to frame Dialog-Frame .
      936   end.
      937   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      938   procedure minbtn-set :
      939       do
      940           on error undo, return error return-value
      941           :
      942           define variable ii              as integer       no-undo .
      943           define variable fh              as widget-handle no-undo .
      944           define variable hh              as widget-handle no-undo .
      945           define variable v-h             as handle        extent 4 no-undo .
      946           define variable v-name-button   as character     no-undo .
      947           define variable v-help-old-x    as decimal       no-undo .
      948           define variable v-help-old-y    as decimal       no-undo .
      949           define variable v-help-old-size as decimal       no-undo .
      950           define variable v-frame-width   as decimal       no-undo .
      951           define variable jj              as integer       no-undo .
      952           do
      953               on error undo, return error
      954               :
      955               assign
      956                   v-frame-width = frame Dialog-Frame:width - 0.3
      957                   fh            = frame Dialog-Frame:first-child
      958                   hh            = fh:first-child
      959                   ii            = 1
      960                   .
      961               do while valid-handle(hh):
      962                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      963                   do:
      964                       case lc(hh:name) :
      965                           when "b-help" then
      966                               do:
      967                                   hh:load-image-up("cmp/b-help.bmp":u) .
      968                                   hh:load-image-down("cmp/b-help.bmp":u) .
      969                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      970                                   hh:TOOLTIP = "Помощь" .
      971                                   v-help-old-x = hh:column .
      972                                   v-help-old-y = hh:row    .
      973                                   v-help-old-size = hh:width .
      974                                   hh:width-chars = 2.5 .
      975                               end.
      976                           when "b-print" then
      977                               do:
      978                                   hh:load-image("cmp/b-print.bmp":u) .
      979                                   hh:TOOLTIP = "Печать" .
      980                                   v-h[ii] = hh:handle .
      981                                   ii = ii + 1 .
      982                                   hh:width-chars = 3 .
      983                               end.
      984                           when "b-history" or
      985                           when "b-hist" then
      986                               do:
      987                                   hh:load-image("cmp/b-hist.bmp":u) .
      988                                   hh:TOOLTIP = "История" .
      989                                   v-h[ii] = hh:handle .
      990                                   ii = ii + 1 .
      991                                   hh:width-chars = 3 .
      992                               end.
      993                           when "b-sch" then
      994                               do:
      995                                   hh:load-image("cmp/b-sch.bmp":u) .
      996                                   hh:TOOLTIP = "Установка Фильтра" .
      997                                   v-h[ii] = hh:handle .
      998                                   ii = ii + 1 .
      999                                   hh:width-chars = 3 .
     1000                               end.
     1001                           when "b-hist-user" then
     1002                               do:
     1003                                   hh:load-image("cmp/b-hist.bmp":u) .
     1004                                   hh:TOOLTIP = "История пользователя" .
     1005                                   ii = ii + 1 .
     1006                               end.
     1007                       end case.
     1008                   end.
     1009                   hh = hh:next-sibling.
     1010               end.
     1011               b-help:column = v-frame-width - b-help:width-chars.
     1012               jj = 0.
     1013               repeat ii = 4 to 1 by -1 :
     1014                   if valid-handle (v-h[ii] ) then
     1015                   do:
     1016                       jj  = jj + 1 .
     1017                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
     1018                       v-h[ii]:row    = v-help-old-y .
     1019                   end.
     1020               end.
     1021           end.
     1022       end.
     1023   end procedure.
     1024   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
     1025   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
     1026     def var  ii  as integer no-undo init 0 .
     1027     DO ii = 1 TO NUM-ENTRIES(ParamStr):
     1028       case integer(ENTRY(ii,ParamStr)) :
     1029         when 1  then TOG-1  = yes .
     1030         when 2  then TOG-2  = yes .
     1031         when 3  then TOG-3  = yes .
     1032         when 4  then TOG-4  = yes .
     1033         when 5  then TOG-5  = yes .
     1034         when 6  then TOG-6  = yes .
     1035         when 7  then TOG-7  = yes .
     1036         when 8  then TOG-8  = yes .
     1037         when 9  then TOG-9  = yes .
     1038         when 10 then TOG-10 = yes .
     1039         when 11 then TOG-11 = yes .
     1040         when 12 then TOG-12 = yes .
     1041         when 13 then TOG-13 = yes .
     1042         when 14 then TOG-14 = yes .
     1043         when 15 then TOG-15 = yes .
     1044         when 16 then TOG-16 = yes .
     1045         when 17 then TOG-17 = yes .
     1046         when 18 then TOG-18 = yes .
     1047       end case.
     1048     END.
     1049     Display  TOG-1 TOG-10 TOG-2 TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6 TOG-15 TOG-7 TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 with frame Dialog-Frame.
     1050   MAIN-BLOCK:
     1051   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1052      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1053     RUN enable_UI.
     1054     WAIT-FOR GO OF FRAME Dialog-Frame.
     1055   END.
     1056   RUN disable_UI.
     1057   PROCEDURE disable_UI :
     1058     HIDE FRAME Dialog-Frame.
     1059   END PROCEDURE.
     1060   PROCEDURE enable_UI :
     1061     DISPLAY TOG-1 TOG-10 TOG-2 TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6
     1062             TOG-15 TOG-7 TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 FILL-IN-25 FILL-IN-30
     1063             FILL-IN-58 FILL-IN-26 FILL-IN-31 FILL-IN-27 FILL-IN-52 FILL-IN-28
     1064             FILL-IN-53 FILL-IN-32 FILL-IN-54 FILL-IN-48 FILL-IN-55 FILL-IN-50
     1065             FILL-IN-56 FILL-IN-29 FILL-IN-57 FILL-IN-49
     1066         WITH FRAME Dialog-Frame.
     1067     ENABLE RECT-21 B-quit B-exit B-mark B-unmark B-help TOG-1 TOG-10 TOG-2
     1068            TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6 TOG-15 TOG-7
     1069            TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 FILL-IN-25 FILL-IN-30 FILL-IN-58
     1070            FILL-IN-26 FILL-IN-31 FILL-IN-27 FILL-IN-52 FILL-IN-28 FILL-IN-53
     1071            FILL-IN-32 FILL-IN-54 FILL-IN-48 FILL-IN-55 FILL-IN-50 FILL-IN-56
     1072            FILL-IN-29 FILL-IN-57 FILL-IN-49
     1073         WITH FRAME Dialog-Frame.
     1074     VIEW FRAME Dialog-Frame.
     1075   END PROCEDURE.
     1076   PROCEDURE eq-frame :
     1077     DISPLAY TOG-1 TOG-10 TOG-2 TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6
     1078             TOG-15 TOG-7 TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 FILL-IN-25 FILL-IN-30
     1079             FILL-IN-58 FILL-IN-26 FILL-IN-31 FILL-IN-27 FILL-IN-52 FILL-IN-28
     1080             FILL-IN-53 FILL-IN-32 FILL-IN-54 FILL-IN-48 FILL-IN-55 FILL-IN-50
     1081             FILL-IN-56 FILL-IN-29 FILL-IN-57 FILL-IN-49
     1082         WITH FRAME Dialog-Frame.
     1083     ENABLE RECT-21 B-quit B-exit B-mark B-unmark B-help TOG-1 TOG-10 TOG-2
     1084            TOG-11 TOG-3 TOG-12 TOG-4 TOG-13 TOG-5 TOG-14 TOG-6 TOG-15 TOG-7
     1085            TOG-16 TOG-8 TOG-17 TOG-9 TOG-18 FILL-IN-25 FILL-IN-30 FILL-IN-58
     1086            FILL-IN-26 FILL-IN-31 FILL-IN-27 FILL-IN-52 FILL-IN-28 FILL-IN-53
     1087            FILL-IN-32 FILL-IN-54 FILL-IN-48 FILL-IN-55 FILL-IN-50 FILL-IN-56
     1088            FILL-IN-29 FILL-IN-57 FILL-IN-49
     1089         WITH FRAME Dialog-Frame.
     1090     VIEW FRAME Dialog-Frame.
     1091   END PROCEDURE.
