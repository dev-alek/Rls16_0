      507       if error-status :error
      508       then do:
      509         undo, return error return-value .
      510       end.
      511     end.
      512   end procedure.
      513   procedure pck-attr-manual-edit :
      514     define input  parameter p-code           as character no-undo .
      515     define output parameter p-section-num    as integer no-undo .
      516     do
      517     on error undo, return error
      518     :
      519           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pck-attr-manual-edit in g#attr-lib
      520         (input  p-code
      521         ,output p-section-num
      522         ) no-error .
      523       if error-status :error
      524       then do:
      525         undo, return error return-value .
      526       end.
      527     end.
      528   end procedure.
      529   procedure pck-attr-batch-edit :
      530     define input  parameter p-code           as character no-undo .
      531     define output parameter p-section-num    as integer no-undo .
      532     do
      533     on error undo, return error
      534     :
      535           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pck-attr-batch-edit in g#attr-lib
      536         (input  p-code
      537         ,output p-section-num
      538         ) no-error .
      539       if error-status :error
      540       then do:
      541         undo, return error return-value .
      542       end.
      543     end.
      544   end procedure.
      545   def temp-table tt-db-info no-undo
      546       field db-num as int
      547       field db-name as char
      548       field db-date as date
      549       field last-recv-pck-dt as datetime
      550       field last-sent-pck-dt as datetime
      551       field last-recv-pck-dt-str as char
      552       field last-sent-pck-dt-str as char
      553       field min-processing-int as int64
      554       field max-processing-int as int64
      555       field avg-processing-int as int64
      556       field min-processing-str as char
      557       field max-processing-str as char
      558       field avg-processing-str as char
      559       field pck-rcvd-count as int64
      560       field pck-sent-count as int64
      561       field avg-recs-in-rcvd-pck as int64
      562       field avg-wait-confirm-int as int64
      563       field avg-wait-confirm-str as char
      564       field pck-not-confirm-count as int64
      565       field avg-recs-in-sent-pck as int64
      566       index pi as primary unique db-num
      567       .
      568   def temp-table tt-stat-info
      569       field db-num as int
      570       field table-name as char
      571       field rec-count as int64
      572       index pi as primary unique db-num table-name
      573       .
      574   def buffer buf_db for ub.db.
      575   def buffer buf_pck-rcvd for ub.pck-rcvd.
      576   def buffer buf_pck-sent for ub.pck-sent.
      577   def buffer buf_pck-rcvd-attr1 for ub.pck-rcvd-attr.
      578   def buffer buf_pck-rcvd-attr2 for ub.pck-rcvd-attr.
      579   def buffer buf_obj-date for ub.obj-date.
      580   def buffer buf_route for ub.route.
      581   def buffer buf_clients for ub.clients.
      582   def var end-work-dt as int64 no-undo.
      583   def var last-sort-column as char no-undo.
      584   def var last-sort-desc as logical no-undo init false.
      585   def var dt-interval as datetime no-undo.
      586   def var dt-not-conf-interval as datetime no-undo.
      587   DEFINE BUTTON Btn_OK AUTO-GO
      588        LABEL "Выход"
      589        SIZE 7 BY 1
      590        BGCOLOR 8 .
      591   DEFINE BUTTON Btn_print
      592        LABEL "Печать"
      593        SIZE 7 BY 1
      594        BGCOLOR 8 .
      595   DEFINE BUTTON BUTTON-start
      596        LABEL "Запуск"
      597        SIZE 7 BY 1
      598        BGCOLOR 8 .
      599   DEFINE VARIABLE abs-time-pack AS INTEGER FORMAT ">>>>9":U INITIAL 6
      600        VIEW-AS FILL-IN
      601        SIZE 10 BY 1 NO-UNDO.
      602   DEFINE VARIABLE avail-time AS INTEGER FORMAT ">>>>9":U INITIAL 6
      603        VIEW-AS FILL-IN
      604        SIZE 10 BY 1 NO-UNDO.
      605   DEFINE VARIABLE period AS INTEGER FORMAT ">>>>9":U INITIAL 24
      606        VIEW-AS FILL-IN
      607        SIZE 10 BY 1 NO-UNDO.
      608   DEFINE VARIABLE sel-dbs AS CHARACTER FORMAT "X(256)":U
      609        VIEW-AS FILL-IN
      610        SIZE 10 BY 1 NO-UNDO.
      611   DEFINE VARIABLE dbs AS INTEGER
      612        VIEW-AS RADIO-SET VERTICAL
      613        RADIO-BUTTONS
      614             "Активные", 1,
      615   "Выборочно", 2
      616        SIZE 16 BY 1.62 NO-UNDO.
      617   DEFINE RECTANGLE RECT-1
      618        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      619        SIZE 36 BY 3.1.
      620   DEFINE RECTANGLE RECT-2
      621        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      622        SIZE 59 BY 3.1.
      623   DEFINE QUERY BROWSE-dbs FOR
      624         tt-db-info SCROLLING.
      625   DEFINE QUERY BROWSE-stat FOR
      626         tt-stat-info SCROLLING.
      627   DEFINE BROWSE BROWSE-dbs
      628     QUERY BROWSE-dbs NO-LOCK DISPLAY
      629         tt-db-info.db-num COLUMN-LABEL "№" FORMAT ">>>>9"
      630           tt-db-info.db-name COLUMN-LABEL "Название БД" FORMAT "X(25)"
      631           tt-db-info.db-date COLUMN-LABEL "Дата БД" FORMAT "99/99/9999"
      632           tt-db-info.pck-rcvd-count COLUMN-LABEL "Принято!пакетов" FORMAT ">>>,>>>,>>9"
      633           tt-db-info.pck-sent-count COLUMN-LABEL "Отправлено!пакетов" FORMAT ">>>,>>>,>>9"
      634           tt-db-info.last-recv-pck-dt-str COLUMN-LABEL "Время приема!последнего пакета" FORMAT "X(20)"
      635           tt-db-info.last-sent-pck-dt-str COLUMN-LABEL "Время отправки!последнего пакета" FORMAT "X(20)"
      636           tt-db-info.min-processing-str COLUMN-LABEL "Миним. время!обработки пакетов" FORMAT "X(32)"
      637           tt-db-info.max-processing-str COLUMN-LABEL "Макс. время!обработки пакетов" FORMAT "X(32)"
      638           tt-db-info.avg-processing-str COLUMN-LABEL "Среднее время!обработки пакетов" FORMAT "X(32)"
      639           tt-db-info.avg-wait-confirm-str COLUMN-LABEL "Среднее время!ожидания подтверждения" FORMAT "X(32)"
      640           tt-db-info.avg-recs-in-rcvd-pck COLUMN-LABEL "Среднее кол-во записей!в полученном пакете" FORMAT ">>>,>>>,>>9"
      641           tt-db-info.pck-not-confirm-count COLUMN-LABEL "Кол-во не!подтвержденных пакетов" FORMAT ">>>,>>>,>>9"
      642           tt-db-info.avg-recs-in-sent-pck COLUMN-LABEL "Среднее кол-во записей!в передаваемом пакете" FORMAT ">>>,>>>,>>9"
      643       WITH NO-ROW-MARKERS SEPARATORS SIZE 109 BY 13.1
      644            TITLE "Общая информация по работе СПН".
      645   DEFINE BROWSE BROWSE-stat
      646     QUERY BROWSE-stat DISPLAY
      647         tt-stat-info.table-name COLUMN-LABEL "Таблица" FORMAT "X(80)"
      648           tt-stat-info.rec-count COLUMN-LABEL "Записей" FORMAT ">>>,>>>,>>9"
      649       WITH NO-ROW-MARKERS SEPARATORS SIZE 109 BY 8.33
      650            TITLE "Статистика по исходящей информации" FIT-LAST-COLUMN.
      651   DEFINE FRAME Dialog-Frame
      652        Btn_OK AT ROW 1 COL 2
      653        Btn_print AT ROW 1 COL 9 WIDGET-ID 2
      654        BUTTON-start AT ROW 1 COL 17 WIDGET-ID 12
      655        dbs AT ROW 2.33 COL 7 NO-LABEL WIDGET-ID 6
      656        sel-dbs AT ROW 2.43 COL 27 NO-LABEL WIDGET-ID 10
      657        abs-time-pack AT ROW 2.43 COL 84 COLON-ALIGNED NO-LABEL WIDGET-ID 42
      658        avail-time AT ROW 3.86 COL 84 COLON-ALIGNED NO-LABEL WIDGET-ID 44
      659        period AT ROW 3.95 COL 25 COLON-ALIGNED NO-LABEL WIDGET-ID 26
      660        BROWSE-dbs AT ROW 5.29 COL 2 WIDGET-ID 600
      661        BROWSE-stat AT ROW 18.38 COL 2 WIDGET-ID 700
      662        "Допустимое время отсутствия пакетов (в часах)" VIEW-AS TEXT
      663             SIZE 45 BY 1.1 AT ROW 2.43 COL 39 WIDGET-ID 46
      664        "БД:" VIEW-AS TEXT
      665             SIZE 4 BY 1.62 AT ROW 2.33 COL 2.4 WIDGET-ID 20
      666        "Период анализа в часах:" VIEW-AS TEXT
      667             SIZE 24 BY .81 AT ROW 4.1 COL 2.4 WIDGET-ID 38
      668        "Допустимое время цикла (в часах):" VIEW-AS TEXT
      669             SIZE 38 BY 1.1 AT ROW 3.62 COL 39 WIDGET-ID 48
      670        RECT-1 AT ROW 2.19 COL 2 WIDGET-ID 50
      671        RECT-2 AT ROW 2.19 COL 38 WIDGET-ID 52
      672        SPACE(15.19) SKIP(21.70)
      673       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      674            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      675            TITLE "Мониторинг СПН"
      676            DEFAULT-BUTTON Btn_OK WIDGET-ID 100.
      677   ASSIGN
      678          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      679          FRAME Dialog-Frame:HIDDEN           = TRUE.
      680   ASSIGN
      681          BROWSE-dbs:NUM-LOCKED-COLUMNS IN FRAME Dialog-Frame     = 1
      682          BROWSE-dbs:ALLOW-COLUMN-SEARCHING IN FRAME Dialog-Frame = TRUE.
      683   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      684   DO:
      685     APPLY "END-ERROR":U TO SELF.
      686   END.
      687   ON ROW-DISPLAY OF BROWSE-dbs IN FRAME Dialog-Frame
      688   DO:
      689       run highlight-dbs-rows.
      690   END.
      691   ON START-SEARCH OF BROWSE-dbs IN FRAME Dialog-Frame
      692   DO:
      693       run do-sort.
      694   END.
      695   ON VALUE-CHANGED OF BROWSE-dbs IN FRAME Dialog-Frame
      696   DO:
      697     run refresh-query(2).
      698   END.
      699   ON CHOOSE OF Btn_print IN FRAME Dialog-Frame
      700   DO:
      701     message "Печать пока не предусмотрена!" view-as alert-box.
      702   END.
      703   ON CHOOSE OF BUTTON-start IN FRAME Dialog-Frame
      704   DO:
      705       run fill-tables.
      706       run refresh-query(1).
      707       apply "VALUE-CHANGED" to BROWSE-dbs.
      708   END.
      709   ON VALUE-CHANGED OF dbs IN FRAME Dialog-Frame
      710   DO:
      711     assign frame dialog-frame dbs.
      712     if dbs = 1 then disable sel-dbs with frame dialog-frame.
      713     else enable sel-dbs with frame dialog-frame.
      714   END.
      715   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      716   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      717   MAIN-BLOCK:
      718   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      719      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      720   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      721   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      722   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      723   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      724   define variable v-diasize-current-frame-width  as decimal   no-undo .
      725   define variable v-diasize-current-frame-height as decimal   no-undo .
      726   define variable v-diasize-change-size          as logical   no-undo .
      727   define variable v-diasize-resize-button        as handle    no-undo .
      728   define variable v-diasize-wndmax               as logical   no-undo .
      729   define variable v-diasize-wndstore             as logical   no-undo .
      730   define variable v-diasize-proc-name            as character no-undo .
      731   define variable v-diasize-browse-handle        as handle    no-undo .
      732   define variable v-diasize-browse-number        as integer   no-undo .
      733   define variable v-diasize-need-full-display    as logical   no-undo init false .
      734   define temp-table temp-diasize-handle no-undo
      735     field handle-value  as handle
      736     field save-position as decimal
      737     index xpk is primary unique handle-value
      738     .
      739   define temp-table temp-browse-handle no-undo
      740     field browse-type   as character
      741     field browse-number as integer
      742     field browse-handle as handle
      743     field original-size as decimal
      744     index xpk is primary unique browse-type browse-number
      745     index xie browse-type browse-handle
      746   .
      747   procedure diasize_change-height :
      748     define input  parameter p-change-value  as decimal   no-undo .
      749     define input  parameter p-move-resize   as logical   no-undo .
      750     define variable v-field-group-handle    as handle    no-undo .
      751     define variable v-object-handle         as handle    no-undo .
      752     define variable v-frame-height          as decimal   no-undo .
      753     define variable v-frame-virtual-height  as decimal   no-undo .
      754     define variable v-browse-height         as decimal   no-undo .
      755     define variable v-window-height         as decimal   no-undo .
      756     define variable v-window-virtual-height as decimal   no-undo .
      757     define variable v-change-sign           as integer   no-undo .
      758     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      759     define buffer buf_temp-browse-handle  for temp-browse-handle .
      760     if p-change-value > 0
      761     then do:
      762       if frame Dialog-Frame :height + p-change-value
      763           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      764       then do:
      765         assign
      766           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      767                           - (frame Dialog-Frame :height-chars)
      768         .
      769         if p-change-value <= 0
      770         then do:
      771           run diasize_position-resize-button in this-procedure .
      772           return .
      773         end.
      774       end.
      775     end.
      776     if p-change-value < 0
      777     then do:
      778       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      779       then do:
      780         assign
      781           p-change-value = v-diasize-orig-frame-height
      782                          - (frame Dialog-Frame :height-chars)
      783         .
      784         if p-change-value >= 0
      785         then do:
      786           run diasize_position-resize-button in this-procedure .
      787           return .
      788         end.
      789       end.
      790     end.
      791     if p-change-value >= 0
      792     then do:
      793       assign
      794         v-change-sign = 1
      795       .
      796     end.
      797     else do:
      798       assign
      799         v-change-sign = -1
      800       .
      801     end.
      802     assign
      803       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      804     .
      805     if p-change-value = 0
      806     then do:
      807       run diasize_position-resize-button in this-procedure .
      808       return .
      809     end.
      810     move_block:
      811     do
      812     on error undo move_block, retry move_block
      813     :
      814       if retry
      815       then do:
      816         do
      817         on error undo move_block, leave move_block
      818         :
      819           if p-change-value > 0
      820           then do:
      821             for each buf_temp-diasize-handle
      822             on error undo, next
      823             :
      824               assign
      825                 v-object-handle = buf_temp-diasize-handle.handle-value
      826               .
      827               if v-object-handle <> v-diasize-resize-button
      828               then do:
      829                 assign
      830                   v-object-handle :row = buf_temp-diasize-handle.save-position
      831                 .
      832               end.
      833             end.
      834             assign
      835               v-diasize-browse-handle :height = v-browse-height
      836             .
      837             for each buf_temp-browse-handle
      838               where buf_temp-browse-handle.browse-type = 'height':u
      839             on error undo, next
      840             :
      841               assign
      842                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      843               .
      844             end.
      845             assign
      846               frame Dialog-Frame :height = v-frame-height
      847             .
      848             if frame Dialog-Frame :scrollable = true
      849             then do:
      850               assign
      851                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      852               .
      853             end.
      854             run diasize_position-resize-button in this-procedure .
      855           end.
      856           else do:
      857             if frame Dialog-Frame :scrollable = true
      858             then do:
      859               assign
      860                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      861               .
      862             end.
      863             assign
      864               frame Dialog-Frame :height = v-frame-height
      865             .
      866             assign
      867               v-diasize-browse-handle :height = v-browse-height
      868             .
      869             for each buf_temp-browse-handle
      870               where buf_temp-browse-handle.browse-type = 'height':u
      871             on error undo, next
      872             :
      873               assign
      874                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      875               .
      876             end.
      877             for each buf_temp-diasize-handle
      878             on error undo, next
      879             :
      880               assign
      881                 v-object-handle = buf_temp-diasize-handle.handle-value
      882               .
      883               if v-object-handle <> v-diasize-resize-button
      884               then do:
      885                 assign
      886                   v-object-handle :row = buf_temp-diasize-handle.save-position
      887                 .
      888               end.
      889             end.
      890             run diasize_position-resize-button in this-procedure .
      891           end.
      892           assign
      893             v-diasize-change-size = false
      894           .
      895           leave move_block .
      896         end.
      897       end.
      898       assign
      899         v-diasize-need-full-display = true
      900       .
      901       if v-diasize-change-size = false
      902       then do:
      903         assign
      904           v-diasize-change-size = true
      905         .
      906       end.
      907       else do:
      908         return .
      909       end.
      910       assign
      911         v-frame-height = frame Dialog-Frame :height
      912         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      913         v-browse-height = v-diasize-browse-handle :height
      914       .
      915       for each buf_temp-browse-handle
      916         where buf_temp-browse-handle.browse-type = 'height':u
      917       :
      918         assign
      919           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      920         .
      921       end.
      922       for each buf_temp-diasize-handle
      923       :
      924         delete buf_temp-diasize-handle .
      925       end.
      926       assign
      927         v-field-group-handle = frame Dialog-Frame :first-child
      928       .
      929       do while valid-handle(v-field-group-handle)
      930       :
      931         assign
      932           v-object-handle = v-field-group-handle :first-child
      933         .
      934         do while valid-handle(v-object-handle)
      935         :
      936           if  v-object-handle <> v-diasize-browse-handle :handle
      937           and can-query(v-object-handle, "row")
      938           and can-query(v-object-handle, "height")
      939           and ( v-object-handle :row > v-diasize-browse-handle :row )
      940           then do:
      941             find first buf_temp-browse-handle
      942               where buf_temp-browse-handle.browse-type   = 'height':u
      943                 and buf_temp-browse-handle.browse-handle = v-object-handle
      944               no-error .
      945             if available buf_temp-browse-handle
      946             then do:
      947             end.
      948             else do:
      949               create buf_temp-diasize-handle .
      950               assign
      951                 buf_temp-diasize-handle.handle-value  = v-object-handle
      952                 buf_temp-diasize-handle.save-position = v-object-handle :row
      953               .
      954             end.
      955           end.
      956           assign
      957             v-object-handle = v-object-handle :next-sibling
      958           .
      959         end.
      960         assign
      961           v-field-group-handle = v-field-group-handle :next-sibling
      962         .
      963       end.
      964       do with frame Dialog-Frame
      965       :
      966         hide v-diasize-resize-button .
      967         assign
      968           v-diasize-resize-button :row    = 1
      969           v-diasize-resize-button :column = 1
      970         .
      971       end.
      972       if p-change-value > 0
      973       then do:
      974         if frame Dialog-Frame :scrollable = true
      975         then do:
      976           assign
      977             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      978             no-error .
      979           if error-status :error
      980           or error-status :get-message(1) <> ""
      981           then do:
      982             undo move_block, retry move_block .
      983           end.
      984         end.
      985         assign
      986           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      987           no-error .
      988         if error-status :error
      989         or error-status :get-message(1) <> ""
      990         then do:
      991           undo move_block, retry move_block .
      992         end.
      993         assign
      994           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      995           no-error .
      996         if error-status :error
      997         or error-status :get-message(1) <> ""
      998         then do:
      999           undo move_block, retry move_block .
     1000         end.
     1001         for each buf_temp-browse-handle
     1002           where buf_temp-browse-handle.browse-type = 'height':u
     1003         on error undo move_block, retry move_block
     1004         :
     1005           assign
     1006             buf_temp-browse-handle.browse-handle :height
     1007               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1008             no-error .
     1009           if error-status :error
     1010           or error-status :get-message(1) <> ""
     1011           then do:
     1012             undo move_block, retry move_block .
     1013           end.
     1014         end.
     1015         for each buf_temp-diasize-handle
     1016         on error undo move_block, retry move_block
     1017         :
     1018           assign
     1019             v-object-handle = buf_temp-diasize-handle.handle-value
     1020           .
     1021           if v-object-handle <> v-diasize-resize-button
     1022           then do:
     1023             assign
     1024               v-object-handle :row = v-object-handle :row + p-change-value
     1025               no-error .
     1026             if error-status :error
     1027             or error-status :get-message(1) <> ""
     1028             then do:
     1029               undo move_block, retry move_block .
     1030             end.
     1031           end.
     1032         end.
     1033       end.
     1034       else do:
     1035         for each buf_temp-diasize-handle
     1036         on error undo move_block, retry move_block
     1037         :
     1038           assign
     1039             v-object-handle = buf_temp-diasize-handle.handle-value
     1040           .
     1041           if v-object-handle <> v-diasize-resize-button
     1042           then do:
     1043             assign
     1044               v-object-handle :row = v-object-handle :row + p-change-value
     1045               no-error .
     1046             if error-status :error
     1047             or error-status :get-message(1) <> ""
     1048             then do:
     1049               undo move_block, retry move_block .
     1050             end.
     1051           end.
     1052         end.
     1053         assign
     1054           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
     1055           no-error .
     1056         if error-status :error
     1057         or error-status :get-message(1) <> ""
     1058         then do:
     1059           undo move_block, retry move_block .
     1060         end.
     1061         for each buf_temp-browse-handle
     1062           where buf_temp-browse-handle.browse-type = 'height':u
     1063         on error undo move_block, retry move_block
     1064         :
     1065           assign
     1066             buf_temp-browse-handle.browse-handle :height
     1067               = buf_temp-browse-handle.browse-handle :height + p-change-value
     1068             no-error .
     1069           if error-status :error
     1070           or error-status :get-message(1) <> ""
     1071           then do:
     1072             undo move_block, retry move_block .
     1073           end.
     1074         end.
     1075         assign
     1076           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
     1077           no-error .
     1078         if error-status :error
     1079         or error-status :get-message(1) <> ""
     1080         then do:
     1081           undo move_block, retry move_block .
     1082         end.
     1083         if frame Dialog-Frame :scrollable = true
     1084         then do:
     1085           assign
     1086             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
     1087             no-error .
     1088           if error-status :error
     1089           or error-status :get-message(1) <> ""
     1090           then do:
     1091             undo move_block, retry move_block .
     1092           end.
     1093         end.
     1094       end.
     1095       if p-move-resize = true
     1096       then do:
     1097         run diasize_position-resize-button in this-procedure .
     1098       end.
     1099       if v-diasize-wndstore = true
     1100       then do:
     1101         if connected("ub") = true
     1102         then do:
     1103           define variable v-cntxt-db-num        as integer   no-undo .
     1104           define variable v-cntxt-userid        as character no-undo .
     1105           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1106                                             , OUTPUT v-cntxt-userid
     1107                                             ) .
     1108           run gbl/wndsizew.p
     1109             (input  v-cntxt-db-num
     1110             ,input  v-cntxt-userid
     1111             ,input  v-diasize-proc-name
     1112             ,input  'height':u
     1113             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1114             ) .
     1115         end.
     1116       end.
     1117     end.
     1118     assign
     1119       v-diasize-change-size = false
     1120     .
     1121   end procedure.
     1122   procedure diasize_set-height :
     1123     define input  parameter p-new-height  as decimal   no-undo .
     1124     define input  parameter p-move-resize as logical   no-undo .
     1125     do
     1126     on error undo, return error return-value
     1127     :
     1128       run diasize_change-height in this-procedure
     1129         (input  (p-new-height - frame Dialog-Frame :height)
     1130         ,input  p-move-resize
     1131         ) .
     1132     end.
     1133   end procedure.
     1134   procedure diasize_change-width :
     1135     define input  parameter p-change-value as decimal   no-undo .
     1136     define input  parameter p-move-resize  as logical   no-undo .
     1137     define variable v-field-group-handle   as handle    no-undo .
     1138     define variable v-object-handle        as handle    no-undo .
     1139     define variable v-frame-width          as decimal   no-undo .
     1140     define variable v-frame-virtual-width  as decimal   no-undo .
     1141     define variable v-browse-width         as decimal   no-undo .
     1142     define variable v-window-width         as decimal   no-undo .
     1143     define variable v-window-virtual-width as decimal   no-undo .
     1144     define variable v-change-sign          as integer   no-undo .
     1145     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1146     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1147     if p-change-value > 0
     1148     then do:
     1149       if frame Dialog-Frame :width + p-change-value >
     1150           session :width-chars
     1151       then do:
     1152         assign
     1153           p-change-value = session :width-chars - frame Dialog-Frame :width
     1154         .
     1155         if p-change-value <= 0
     1156         then do:
     1157           run diasize_position-resize-button in this-procedure .
     1158           return .
     1159         end.
     1160       end.
     1161     end.
     1162     if p-change-value < 0
     1163     then do:
     1164       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1165       then do:
     1166         assign
     1167           p-change-value = v-diasize-orig-frame-width
     1168                          - frame Dialog-Frame :width
     1169         .
     1170         if p-change-value >= 0
     1171         then do:
     1172           run diasize_position-resize-button in this-procedure .
     1173           return .
     1174         end.
     1175       end.
     1176     end.
     1177     if p-change-value >= 0
     1178     then do:
     1179       assign
     1180         v-change-sign = 1
     1181       .
     1182     end.
     1183     else do:
     1184       assign
     1185         v-change-sign = -1
     1186       .
     1187     end.
     1188     assign
     1189       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1190     .
     1191     if p-change-value = 0
     1192     then do:
     1193       run diasize_position-resize-button in this-procedure .
     1194       return .
     1195     end.
     1196     move_block:
     1197     do
     1198     on error undo move_block, leave move_block
     1199     :
     1200       if retry
     1201       then do:
     1202         do
     1203         on error undo move_block, leave move_block
     1204         :
     1205           if p-change-value > 0
     1206           then do:
     1207             for each buf_temp-diasize-handle
     1208             on error undo, next
     1209             :
     1210               assign
     1211                 v-object-handle = buf_temp-diasize-handle.handle-value
     1212               .
     1213               if v-object-handle <> v-diasize-resize-button
     1214               then do:
     1215                 assign
     1216                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1217                 .
     1218               end.
     1219             end.
     1220             assign
     1221               v-diasize-browse-handle :width = v-browse-width
     1222             .
     1223             for each buf_temp-browse-handle
     1224               where buf_temp-browse-handle.browse-type = 'width':u
     1225             on error undo, next
     1226             :
     1227               assign
     1228                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1229               .
     1230             end.
     1231             assign
     1232               frame Dialog-Frame :width = v-frame-width
     1233             .
     1234             if frame Dialog-Frame :scrollable = true
     1235             then do:
     1236               assign
     1237                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1238               .
     1239             end.
     1240             run diasize_position-resize-button in this-procedure .
     1241           end.
     1242           else do:
     1243             if frame Dialog-Frame :scrollable = true
     1244             then do:
     1245               assign
     1246                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1247               .
     1248             end.
     1249             assign
     1250               frame Dialog-Frame :width = v-frame-width
     1251             .
     1252             for each buf_temp-browse-handle
     1253               where buf_temp-browse-handle.browse-type = 'width':u
     1254             on error undo, next
     1255             :
     1256               assign
     1257                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1258               .
     1259             end.
     1260             assign
     1261               v-diasize-browse-handle :width = v-browse-width
     1262             .
     1263             for each buf_temp-diasize-handle
     1264             on error undo, next
     1265             :
     1266               assign
     1267                 v-object-handle = buf_temp-diasize-handle.handle-value
     1268               .
     1269               if v-object-handle <> v-diasize-resize-button
     1270               then do:
     1271                 assign
     1272                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1273                 .
     1274               end.
     1275             end.
     1276             run diasize_position-resize-button in this-procedure .
     1277           end.
     1278           assign
     1279             v-diasize-change-size = false
     1280           .
     1281           leave move_block .
     1282         end.
     1283       end.
     1284       assign
     1285         v-diasize-need-full-display = true
     1286       .
     1287       if v-diasize-change-size = false
     1288       then do:
     1289         assign
     1290           v-diasize-change-size = true
     1291         .
     1292       end.
     1293       else do:
     1294         return .
     1295       end.
     1296       assign
     1297         v-frame-width = frame Dialog-Frame :width
     1298         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1299         v-browse-width = v-diasize-browse-handle :width
     1300       .
     1301       for each buf_temp-browse-handle
     1302         where buf_temp-browse-handle.browse-type = 'width':u
     1303       :
     1304         assign
     1305           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1306         .
     1307       end.
     1308       for each buf_temp-diasize-handle
     1309       :
     1310         delete buf_temp-diasize-handle .
     1311       end.
     1312       assign
     1313         v-field-group-handle = frame Dialog-Frame :first-child
     1314       .
     1315       do while valid-handle(v-field-group-handle)
     1316       :
     1317         assign
     1318           v-object-handle = v-field-group-handle :first-child
     1319         .
     1320         do while valid-handle(v-object-handle)
     1321         :
     1322           if  v-object-handle <> v-diasize-browse-handle :handle
     1323           and v-object-handle <> v-diasize-resize-button
     1324           and can-query(v-object-handle, "row")
     1325           and can-query(v-object-handle, "height")
     1326           and ( v-object-handle :col + v-object-handle :width
     1327                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1328               )
     1329           then do:
     1330             find first buf_temp-browse-handle
     1331               where buf_temp-browse-handle.browse-type   = 'width':u
     1332                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1333               no-error .
     1334             if available buf_temp-browse-handle
     1335             then do:
     1336             end.
     1337             else do:
     1338               create buf_temp-diasize-handle .
     1339               assign
     1340                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1341                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1342               .
     1343             end.
     1344           end.
     1345           assign
     1346             v-object-handle = v-object-handle :next-sibling
     1347           .
     1348         end.
     1349         assign
     1350           v-field-group-handle = v-field-group-handle :next-sibling
     1351         .
     1352       end.
     1353       do with frame Dialog-Frame
     1354       :
     1355         hide v-diasize-resize-button .
     1356         v-diasize-resize-button :row = 1.
     1357         v-diasize-resize-button :column = 1.
     1358       end.
     1359       if p-change-value > 0
     1360       then do:
     1361         if frame Dialog-Frame :scrollable = true
     1362         then do:
     1363           assign
     1364             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1365             no-error .
     1366           if error-status :error
     1367           or error-status :get-message(1) <> ""
     1368           then do:
     1369             undo move_block, retry move_block.
     1370           end.
     1371         end.
     1372         assign
     1373           frame Dialog-Frame :width = v-frame-width + p-change-value
     1374           no-error .
     1375         if error-status :error
     1376         or error-status :get-message(1) <> ""
     1377         then do:
     1378           undo move_block, retry move_block.
     1379         end.
     1380         assign
     1381           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1382         no-error .
     1383         if error-status :error
     1384         or error-status :get-message(1) <> ""
     1385         then do:
     1386           undo move_block, retry move_block.
     1387         end.
     1388         for each buf_temp-browse-handle
     1389           where buf_temp-browse-handle.browse-type = 'width':u
     1390         on error undo move_block, retry move_block
     1391         :
     1392           assign
     1393             buf_temp-browse-handle.browse-handle :width
     1394               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1395             no-error .
     1396           if error-status :error
     1397           or error-status :get-message(1) <> ""
     1398           then do:
     1399             undo move_block, retry move_block .
     1400           end.
     1401         end.
     1402         for each buf_temp-diasize-handle
     1403         on error undo move_block, retry move_block
     1404         :
     1405           assign
     1406             v-object-handle = buf_temp-diasize-handle.handle-value
     1407           .
     1408           if v-object-handle <> v-diasize-resize-button
     1409           then do:
     1410             assign
     1411               v-object-handle :col = v-object-handle :col + p-change-value
     1412               no-error .
     1413             if error-status :error
     1414             or error-status :get-message(1) <> ""
     1415             then do:
     1416               undo move_block, retry move_block .
     1417             end.
     1418           end.
     1419         end.
     1420       end.
     1421       else do:
     1422         for each buf_temp-diasize-handle
     1423         on error undo move_block, retry move_block
     1424         :
     1425           assign
     1426             v-object-handle = buf_temp-diasize-handle.handle-value
     1427           .
     1428           if v-object-handle <> v-diasize-resize-button
     1429           then do:
     1430             assign
     1431               v-object-handle :col = v-object-handle :col + p-change-value
     1432               no-error .
     1433             if error-status :error
     1434             or error-status :get-message(1) <> ""
     1435             then do:
     1436               undo move_block, retry move_block .
     1437             end.
     1438           end.
     1439         end.
     1440         for each buf_temp-browse-handle
     1441           where buf_temp-browse-handle.browse-type = 'width':u
     1442         on error undo move_block, retry move_block
     1443         :
     1444           assign
     1445             buf_temp-browse-handle.browse-handle :width
     1446               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1447             no-error .
     1448           if error-status :error
     1449           or error-status :get-message(1) <> ""
     1450           then do:
     1451             undo move_block, retry move_block .
     1452           end.
     1453         end.
     1454         assign
     1455           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1456           no-error .
     1457         if error-status :error
     1458         or error-status :get-message(1) <> ""
     1459         then do:
     1460           undo move_block, retry move_block.
     1461         end.
     1462         assign
     1463           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1464         no-error .
     1465         if error-status :error
     1466         or error-status :get-message(1) <> ""
     1467         then do:
     1468           undo move_block, retry move_block.
     1469         end.
     1470         if frame Dialog-Frame :scrollable = true
     1471         then do:
     1472           assign
     1473             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1474           no-error .
     1475           if error-status :error
     1476           or error-status :get-message(1) <> ""
     1477           then do:
     1478             undo move_block, retry move_block.
     1479           end.
     1480         end.
     1481       end.
     1482       if p-move-resize
     1483       then do:
     1484         run diasize_position-resize-button in this-procedure .
     1485       end.
     1486       if v-diasize-wndstore = true
     1487       then do:
     1488         if connected("ub") = true
     1489         then do:
     1490           define variable v-cntxt-db-num        as integer   no-undo .
     1491           define variable v-cntxt-userid        as character no-undo .
     1492           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1493                                             , OUTPUT v-cntxt-userid
     1494                                             ) .
     1495           run gbl/wndsizew.p
     1496             (input  v-cntxt-db-num
     1497             ,input  v-cntxt-userid
     1498             ,input  v-diasize-proc-name
     1499             ,input  'width':u
     1500             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1501             ) .
     1502         end.
     1503       end.
     1504     end.
     1505     assign
     1506       v-diasize-change-size = false
     1507     .
     1508   end procedure.
     1509   procedure diasize_set-width :
     1510     define input  parameter p-new-width  as decimal   no-undo .
     1511     define input  parameter p-move-resize as logical   no-undo .
     1512     do
     1513     on error undo, return error return-value
     1514     :
     1515       run diasize_change-width in this-procedure
     1516         (input  (p-new-width - frame Dialog-Frame :width)
     1517         ,input  p-move-resize
     1518         ) .
     1519     end.
     1520   end procedure.
     1521   procedure diasize_position-resize-button :
     1522     do with frame Dialog-Frame
     1523     :
     1524       hide v-diasize-resize-button .
     1525       assign
     1526         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1527                     - 1
     1528                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1529         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1530                     - 1
     1531                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1532       .
     1533       view v-diasize-resize-button .
     1534     end.
     1535   end procedure.
     1536   on alt-right anywhere
     1537   do:
     1538     run diasize_change-width in this-procedure
     1539       (input 1
     1540       ,input true
     1541       ) .
     1542     return no-apply .
     1543   end.
     1544   on alt-left anywhere
     1545   do:
     1546     run diasize_change-width in this-procedure
     1547       (input -1
     1548       ,input true
     1549       ) .
     1550     return no-apply .
     1551   end.
     1552   on alt-down anywhere
     1553   do:
     1554     run diasize_change-height in this-procedure
     1555       (input 1
     1556       ,input true
     1557       ) .
     1558     return no-apply .
     1559   end.
     1560   on alt-up anywhere
     1561   do:
     1562     run diasize_change-height in this-procedure
     1563       (input -1
     1564       ,input true
     1565       ) .
     1566     return no-apply .
     1567   end.
     1568   on alt-enter of frame Dialog-Frame
     1569   do:
     1570     run diasize_maximize in this-procedure
     1571       (input  ?
     1572       ).
     1573     return no-apply .
     1574   end.
     1575   procedure diasize_end-move :
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       define variable v-row-delta as decimal   no-undo .
     1580       define variable v-col-delta as decimal   no-undo .
     1581       define variable v-new-row as decimal   no-undo .
     1582       define variable v-new-col as decimal   no-undo .
     1583       assign
     1584         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1585         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1586       .
     1587       assign
     1588         v-row-delta = v-new-row - frame Dialog-Frame :height
     1589         v-col-delta = v-new-col - frame Dialog-Frame :width
     1590       .
     1591       run diasize_change-height in this-procedure
     1592         (input v-row-delta
     1593         ,input true
     1594         ) .
     1595       run diasize_change-width in this-procedure
     1596         (input v-col-delta
     1597         ,input true
     1598         ) .
     1599     end.
     1600   end procedure.
     1601   procedure diasize_maximize :
     1602     define input  parameter p-action as logical   no-undo .
     1603     do
     1604     on error undo, return error return-value
     1605     :
     1606       if p-action = ?
     1607       then do:
     1608         if v-diasize-need-maximize = true
     1609         then do:
     1610           assign
     1611             p-action = true
     1612           .
     1613         end.
     1614         else do:
     1615           assign
     1616             p-action = false
     1617           .
     1618         end.
     1619       end.
     1620       if p-action = true
     1621       then do:
     1622         run diasize_change-height in this-procedure
     1623           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1624               - frame Dialog-Frame :height-chars
     1625           ,input true
     1626           ) .
     1627         run diasize_change-width in this-procedure
     1628           (input session :width-chars
     1629               - frame Dialog-Frame :width-chars
     1630           ,input true
     1631           ) .
     1632         assign
     1633           v-diasize-need-maximize = false
     1634         .
     1635       end.
     1636       else do:
     1637         run diasize_change-width in this-procedure
     1638           (input v-diasize-orig-frame-width
     1639               - frame Dialog-Frame :width-chars
     1640           ,input true
     1641           ) .
     1642         run diasize_change-height in this-procedure
     1643           (input v-diasize-orig-frame-height
     1644               - frame Dialog-Frame :height-chars
     1645           ,input true
     1646           ) .
     1647         assign
     1648           v-diasize-need-maximize = true
     1649         .
     1650       end.
     1651     end.
     1652   end procedure.
     1653   procedure diasize_restore-orig-size :
     1654     do
     1655     on error undo, return error return-value
     1656     :
     1657       assign
     1658         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1659         v-diasize-current-frame-height = frame Dialog-Frame :height
     1660       .
     1661       run diasize_set-height in this-procedure
     1662         (input  v-diasize-orig-frame-height
     1663         ,input  true
     1664         ) .
     1665       run diasize_set-width in this-procedure
     1666         (input  v-diasize-orig-frame-width
     1667         ,input  true
     1668         ) .
     1669     end.
     1670   end procedure.
     1671   procedure diasize_restore-current-size :
     1672     do
     1673     on error undo, return error return-value
     1674     :
     1675       run diasize_set-height in this-procedure
     1676         (input  v-diasize-current-frame-height
     1677         ,input  true
     1678         ) .
     1679       run diasize_set-width in this-procedure
     1680         (input  v-diasize-current-frame-width
     1681         ,input  true
     1682         ) .
     1683     end.
     1684   end procedure.
     1685   procedure diasize_set-browse-handle :
     1686     define input  parameter p-browse-handle as handle   no-undo .
     1687     define buffer buf_temp-browse-handle for temp-browse-handle .
     1688     do
     1689     on error undo, return error return-value
     1690     :
     1691       assign
     1692         v-diasize-browse-handle = p-browse-handle
     1693       .
     1694       for each buf_temp-browse-handle
     1695       on error undo, return error return-value
     1696       :
     1697         delete buf_temp-browse-handle .
     1698       end.
     1699     end.
     1700   end procedure.
     1701   procedure diasize_add_browse :
     1702     define input  parameter p-browse-type   as character no-undo .
     1703     define input  parameter p-browse-handle as handle    no-undo .
     1704     define buffer buf_temp-browse-handle for temp-browse-handle .
     1705     do
     1706     on error undo, return error return-value
     1707     :
     1708       assign
     1709         v-diasize-browse-number = v-diasize-browse-number + 1
     1710       .
     1711       create buf_temp-browse-handle .
     1712       assign
     1713         buf_temp-browse-handle.browse-type   = p-browse-type
     1714         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1715         buf_temp-browse-handle.browse-handle = p-browse-handle
     1716       .
     1717     end.
     1718   end procedure.
     1719   procedure diasize_init :
     1720     define variable v-default-value    as logical   no-undo .
     1721     define variable v-restore-saved    as logical   no-undo .
     1722     define variable v-resize-value-str as character no-undo .
     1723     do
     1724     on error undo, return error return-value
     1725     :
     1726       do with frame Dialog-Frame
     1727       :
     1728         assign
     1729           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1730           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1731           v-diasize-browse-handle     = browse BROWSE-dbs :handle
     1732         .
     1733         create button v-diasize-resize-button
     1734         assign
     1735           parent        = frame Dialog-Frame :first-child
     1736           label         = "s"
     1737           height-pixels = 16
     1738           width-pixels  = 16
     1739           visible       = true
     1740           sensitive     = true
     1741           movable       = true
     1742           triggers:
     1743             on end-move persistent run diasize_end-move in this-procedure .
     1744           end triggers.
     1745         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1746         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1747         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1748         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1749         assign
     1750           v-diasize-wndmax = false
     1751         .
     1752         if connected("ub") = true
     1753         then do:
     1754           define variable v-cntxt-db-num        as integer   no-undo .
     1755           define variable v-cntxt-userid        as character no-undo .
     1756           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1757                                             , OUTPUT v-cntxt-userid
     1758                                             ) .
     1759           run gbl/wndpar_r.p
     1760             (input  v-cntxt-db-num
     1761             ,input  v-cntxt-userid
     1762             ,input  'wndmax':U
     1763             ,output v-diasize-wndmax
     1764             ,output v-default-value
     1765             ) .
     1766         end.
     1767         assign
     1768           v-diasize-wndstore = false
     1769         .
     1770         if connected("ub") = true
     1771         then do:
     1772           run gbl/wndpar_r.p
     1773             (input  v-cntxt-db-num
     1774             ,input  v-cntxt-userid
     1775             ,input  'wndstore':U
     1776             ,output v-diasize-wndstore
     1777             ,output v-default-value
     1778             ) .
     1779         end.
     1780         assign
     1781           v-diasize-proc-name = entry(1, program-name(2), '.')
     1782         .
     1783         if v-diasize-wndstore = true
     1784         then do:
     1785           assign
     1786             v-restore-saved = false
     1787           .
     1788           if connected("ub") = true
     1789           then do:
     1790             run gbl/wndsizer.p
     1791               (input  v-cntxt-db-num
     1792               ,input  v-cntxt-userid
     1793               ,input  v-diasize-proc-name
     1794               ,input  'height':u
     1795               ,output v-resize-value-str
     1796               ) .
     1797             if v-resize-value-str <> '':U
     1798             then do:
     1799               run diasize_change-height in this-procedure
     1800                 (input  integer(v-resize-value-str)
     1801                 ,input  true
     1802                 ) .
     1803               assign
     1804                 v-restore-saved = true
     1805               .
     1806             end.
     1807           end.
     1808           if connected("ub") = true
     1809           then do:
     1810             run gbl/wndsizer.p
     1811               (input  v-cntxt-db-num
     1812               ,input  v-cntxt-userid
     1813               ,input  v-diasize-proc-name
     1814               ,input  'width':u
     1815               ,output v-resize-value-str
     1816               ) .
     1817             if v-resize-value-str <> '':U
     1818             then do:
     1819               run diasize_change-width in this-procedure
     1820                 (input  integer(v-resize-value-str)
     1821                 ,input  true
     1822                 ) .
     1823               assign
     1824                 v-restore-saved = true
     1825               .
     1826             end.
     1827           end.
     1828           if v-restore-saved <> true
     1829           then do:
     1830             if v-diasize-wndmax = true
     1831             then do:
     1832               run diasize_maximize in this-procedure
     1833                 (input  true
     1834                 ) .
     1835             end.
     1836           end.
     1837         end.
     1838         else do:
     1839           if v-diasize-wndmax = true
     1840           then do:
     1841             run diasize_maximize in this-procedure
     1842               (input  true
     1843               ) .
     1844           end.
     1845         end.
     1846       end.
     1847     end.
     1848   end procedure.
     1849   procedure diasize_need-full-display :
     1850     define output parameter p-need-full-display as logical   no-undo .
     1851     do
     1852     on error undo, return error return-value
     1853     :
     1854       assign
     1855         p-need-full-display = v-diasize-need-full-display
     1856       .
     1857       assign
     1858         v-diasize-need-full-display = false
     1859       .
     1860     end.
     1861   end procedure.
     1862   procedure get-context :
     1863      define output parameter p-db-num as integer          no-undo.
     1864      define output parameter p-user-id as character        no-undo.
     1865      define variable v-login               as character    no-undo.
     1866      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1867      define buffer buf_user-login  for ub.user-login .
     1868      do
     1869      on error undo, return error
     1870      :
     1871            FIND FIRST buf_sys-ctrl no-lock.
     1872            ASSIGN
     1873               v-login = USERID("ub")
     1874               p-db-num = buf_sys-ctrl.db-num
     1875            .
     1876            FIND FIRST buf_user-login
     1877                 WHERE buf_user-login.db-num = p-db-num
     1878                   AND buf_user-login.user-login = v-login
     1879                 no-lock
     1880                 no-error
     1881                 .
     1882            IF AVAILABLE buf_user-login
     1883            THEN DO:
     1884               assign
     1885                  p-user-id = buf_user-login.user-id
     1886               .
     1887            END.
     1888      end.
     1889   end procedure.
     1890   run diasize_add_browse in this-procedure
     1891     (input  'width':u
     1892     ,input  browse BROWSE-stat :handle
     1893     ) .
     1894   run diasize_init in this-procedure .
     1895     RUN enable_UI.
     1896     WAIT-FOR GO OF FRAME Dialog-Frame.
     1897   END.
     1898   RUN disable_UI.
     1899   procedure do-sort:
     1900       def var h-col as handle no-undo.
     1901       def var h-query as handle no-undo.
     1902       def var qstr as char no-undo.
     1903       do with frame dialog-frame:
     1904           h-col = BROWSE-dbs:CURRENT-COLUMN.
     1905           h-query = BROWSE-dbs:QUERY.
     1906           qstr = "FOR EACH tt-db-info BY " + h-col:NAME.
     1907           if last-sort-column = h-col:NAME then do:
     1908               if last-sort-desc then
     1909                   qstr = qstr + " DESC".
     1910               last-sort-desc = not last-sort-desc.
     1911           end.
     1912           else
     1913               last-sort-desc = true.
     1914           h-query:QUERY-CLOSE().
     1915           h-query:QUERY-PREPARE(qstr).
     1916           h-query:QUERY-OPEN().
     1917           last-sort-column = h-col:NAME.
     1918       end.
     1919   end.
     1920   function ticks-to-str returns char (ticks as int64):
     1921       def var v-hour as int no-undo init 0 format ">9".
     1922       def var v-min as int no-undo init 0 format "99".
     1923       def var v-sec as int no-undo init 0 format "99".
     1924       def var str as char no-undo init "".
     1925       def var tmp as int64 no-undo format ">>9".
     1926       tmp = ticks.
     1927       def var hour-ticks as int no-undo.
     1928       hour-ticks = 1000 * 60 * 60.
     1929       def var min-ticks as int no-undo.
     1930       min-ticks = 1000 * 60.
     1931       if tmp >= hour-ticks then do:
     1932           v-hour = tmp / hour-ticks.
     1933           tmp = tmp mod hour-ticks.
     1934       end.
     1935       if tmp >= min-ticks then do:
     1936           v-min = tmp / min-ticks.
     1937           tmp = tmp mod min-ticks.
     1938       end.
     1939       if tmp >= 1000 then do:
     1940           v-sec = tmp / 1000.
     1941           tmp = tmp mod 1000.
     1942       end.
     1943       if tmp = ? then tmp = 0.
     1944       return substitute("&1 ч. &2 мин. &3 сек. &4 мс.", v-hour, v-min, v-sec, tmp).
     1945   end.
     1946   procedure check-before-start:
     1947       def var er-text as char no-undo init "".
     1948       def var i as int no-undo.
     1949       def var num as int no-undo.
     1950       assign frame dialog-frame sel-dbs dbs.
     1951       if dbs = 2 then do:
     1952           num = num-entries(sel-dbs).
     1953           if num < 1 then er-text = er-text + chr(10) + "Не указан ни один номер БД".
     1954           else do:
     1955               do i = 1 to num:
     1956                   integer(entry(i, sel-dbs)) no-error.
     1957                   if error-status:ERROR then er-text = er-text + chr(10) + "Номер БД на позиции " + string(i) + " не является числом".
     1958               end.
     1959           end.
     1960       end.
     1961       return er-text.
     1962   end.
     1963   function prev-send-pck returns logical(fflag as logical):
     1964       if fflag then do:
     1965           find last buf_pck-sent no-lock
     1966               where buf_pck-sent.db-num = buf_db.db-num
     1967               no-error.
     1968           return avail buf_pck-sent.
     1969       end.
     1970       find prev buf_pck-sent no-lock
     1971           where buf_pck-sent.db-num = buf_db.db-num
     1972           no-error.
     1973       return avail buf_pck-sent.
     1974   end.
     1975   function prev-rcvd-pck returns logical(fflag as logical):
     1976       if fflag then do:
     1977           find last buf_pck-rcvd no-lock
     1978               where buf_pck-rcvd.db-num = buf_db.db-num
     1979               no-error.
     1980           return avail buf_pck-rcvd.
     1981       end.
     1982       find prev buf_pck-rcvd no-lock
     1983           where buf_pck-rcvd.db-num = buf_db.db-num
     1984           no-error.
     1985       return avail buf_pck-rcvd.
     1986   end.
     1987   procedure fill-tables:
     1988       def var ind as int no-undo.
     1989       run check-before-start no-error.
     1990       if return-value <> "" then do:
     1991           message return-value + chr(10) + chr(10) + "Продолжение не возможно!" view-as alert-box.
     1992           return.
     1993       end.
     1994       empty temp-table tt-db-info.
     1995       empty temp-table tt-stat-info.
     1996       assign frame dialog-frame period abs-time-pack avail-time.
     1997       end-work-dt = avail-time * 60 * 60 * 1000.
     1998       dt-interval = add-interval(now, -(period), "hours").
     1999       dt-not-conf-interval = add-interval(now, -(abs-time-pack), "hours").
     2000       if dbs = 1 then
     2001           for each buf_db where buf_db.db-key <> "":
     2002               run fill-record.
     2003           end.
     2004       else do:
     2005           for each buf_db:
     2006               ind = lookup(string(buf_db.db-num), sel-dbs).
     2007               if ind > 0 then
     2008                   run fill-record.
     2009           end.
     2010       end.
     2011       run waitfram-hide.
     2012   end.
     2013   procedure fill-record:
     2014       def var i as int no-undo.
     2015       def var num as int no-undo.
     2016       def var flag as logical no-undo.
     2017       def var beg-imp-dt as datetime no-undo.
     2018       def var end-imp-dt as datetime no-undo.
     2019       def var processing-int as int64 no-undo.
     2020       def var first-flag as logical no-undo init true.
     2021       def var cre-dt as datetime no-undo.
     2022       def var sent-txt-dt as datetime no-undo.
     2023       def var rcvd-dt as datetime no-undo.
     2024       def var wait-confirm-int as int64 no-undo.
     2025       def var atr-type as char no-undo.
     2026       def var atr-val1 as char no-undo.
     2027       def var atr-val2 as char no-undo.
     2028       run waitfram-show("Анализ БД " + string(buf_db.db-num)).
     2029       create tt-db-info.
     2030       assign
     2031           tt-db-info.db-num = buf_db.db-num
     2032           tt-db-info.db-name = buf_db.db-name
     2033           .
     2034       for each buf_clients use-index db-num
     2035           where buf_clients.db-num = buf_db.db-num no-lock:
     2036               find last buf_obj-date no-lock use-index pi
     2037                   where buf_obj-date.obj-code = buf_clients.obj-code
     2038                   and buf_obj-date.obj-type = buf_clients.obj-type
     2039                   no-error.
     2040               if avail buf_obj-date then do:
     2041                   if tt-db-info.db-date < buf_obj-date.sys-date or tt-db-info.db-date = ? then
     2042                       tt-db-info.db-date = buf_obj-date.sys-date.
     2043               end.
     2044       end.
     2045       first-flag = true.
     2046       tt-db-info.pck-rcvd-count = 0.
     2047       tt-db-info.min-processing-int = ?.
     2048       do while prev-rcvd-pck(first-flag):
     2049           first-flag = false.
     2050           if buf_pck-rcvd.BegImpDate = ? or buf_pck-rcvd.BegImpTime = ? then next.
     2051           beg-imp-dt = datetime(string(buf_pck-rcvd.BegImpDate) + " " + buf_pck-rcvd.BegImpTime) no-error.
     2052           if error-status:ERROR then next.
     2053           if tt-db-info.last-recv-pck-dt = ?
     2054               or tt-db-info.last-recv-pck-dt < beg-imp-dt
     2055                   then
     2056                       tt-db-info.last-recv-pck-dt = beg-imp-dt.
     2057           if buf_pck-rcvd.EndImpDate = ? or buf_pck-rcvd.EndImpTime = ? then next.
     2058           end-imp-dt = datetime(string(buf_pck-rcvd.EndImpDate) + " " + buf_pck-rcvd.EndImpTime) no-error.
     2059           if error-status:ERROR then next.
     2060           if beg-imp-dt < dt-interval then leave.
     2061           processing-int = end-imp-dt - beg-imp-dt.
     2062           if tt-db-info.min-processing-int = ?
     2063               or tt-db-info.min-processing-int > processing-int
     2064                   then
     2065                       tt-db-info.min-processing-int = processing-int.
     2066           if tt-db-info.max-processing-int = ?
     2067               or tt-db-info.max-processing-int < processing-int
     2068                   then
     2069                       tt-db-info.max-processing-int = processing-int.
     2070           tt-db-info.avg-processing-int = tt-db-info.avg-processing-int + processing-int.
     2071           tt-db-info.avg-recs-in-rcvd-pck = tt-db-info.avg-recs-in-rcvd-pck + buf_pck-rcvd.total-recs.
     2072           tt-db-info.pck-rcvd-count = tt-db-info.pck-rcvd-count + 1.
     2073       end.
     2074       tt-db-info.min-processing-str = ticks-to-str(tt-db-info.min-processing-int).
     2075       tt-db-info.max-processing-str = ticks-to-str(tt-db-info.max-processing-int).
     2076       tt-db-info.avg-processing-int = tt-db-info.avg-processing-int / tt-db-info.pck-rcvd-count.
     2077       tt-db-info.avg-processing-str = ticks-to-str(tt-db-info.avg-processing-int).
     2078       tt-db-info.avg-recs-in-rcvd-pck = tt-db-info.avg-recs-in-rcvd-pck / tt-db-info.pck-rcvd-count.
     2079       if tt-db-info.avg-recs-in-rcvd-pck = ? then tt-db-info.avg-recs-in-rcvd-pck = 0.
     2080       if tt-db-info.last-recv-pck-dt = ? then
     2081           tt-db-info.last-recv-pck-dt-str = "-".
     2082       else
     2083           tt-db-info.last-recv-pck-dt-str = string(tt-db-info.last-recv-pck-dt, "99/99/9999 HH:MM:SS").
     2084       first-flag = true.
     2085       tt-db-info.avg-recs-in-sent-pck = 0.
     2086       do while prev-send-pck(first-flag):
     2087           first-flag = false.
     2088           if buf_pck-sent.SendTxtDate = ? or buf_pck-sent.SendTxtTime = ? then next.
     2089           sent-txt-dt = datetime(string(buf_pck-sent.SendTxtDate) + " " + buf_pck-sent.SendTxtTime) no-error.
     2090           if error-status:ERROR then next.
     2091           if tt-db-info.last-sent-pck-dt = ?
     2092               or tt-db-info.last-sent-pck-dt < sent-txt-dt
     2093                   then
     2094                       tt-db-info.last-sent-pck-dt = sent-txt-dt.
     2095           if buf_pck-sent.CreDate = ? or buf_pck-sent.CreTime = ? then next.
     2096           cre-dt = datetime(string(buf_pck-sent.CreDate) + " " + buf_pck-sent.CreTime) no-error.
     2097           if error-status:ERROR then next.
     2098           if buf_pck-sent.RcvdDate = ? or buf_pck-sent.RcvdTime = ? then next.
     2099           if cre-dt < dt-interval then leave.
     2100           rcvd-dt = datetime(string(buf_pck-sent.RcvdDate) + " " + buf_pck-sent.RcvdTime) no-error.
     2101           if error-status:ERROR then next.
     2102           wait-confirm-int = rcvd-dt - cre-dt.
     2103           tt-db-info.avg-wait-confirm-int = tt-db-info.avg-wait-confirm-int + wait-confirm-int.
     2104           if not buf_pck-sent.rcvd then
     2105               tt-db-info.pck-not-confirm-count = tt-db-info.pck-not-confirm-count + 1.
     2106           tt-db-info.avg-recs-in-sent-pck = tt-db-info.avg-recs-in-sent-pck + buf_pck-sent.total-recs.
     2107           run fill-route-stat(buf_pck-sent.pack-num).
     2108           tt-db-info.pck-sent-count = tt-db-info.pck-sent-count + 1.
     2109       end.
     2110       run fill-route-stat(-1).
     2111       tt-db-info.avg-wait-confirm-int = tt-db-info.avg-wait-confirm-int / tt-db-info.pck-sent-count.
     2112       tt-db-info.avg-wait-confirm-str = ticks-to-str(tt-db-info.avg-wait-confirm-int).
     2113       tt-db-info.avg-recs-in-sent-pck = tt-db-info.avg-recs-in-sent-pck / tt-db-info.pck-sent-count.
     2114       if tt-db-info.avg-recs-in-sent-pck = ? then tt-db-info.avg-recs-in-sent-pck = 0.
     2115       if tt-db-info.last-sent-pck-dt = ? then
     2116           tt-db-info.last-sent-pck-dt-str = "-".
     2117       else
     2118           tt-db-info.last-sent-pck-dt-str = string(tt-db-info.last-sent-pck-dt, "99/99/9999 HH:MM:SS").
     2119   end.
     2120   procedure fill-route-stat:
     2121       def input param p-last-pck-num as int.
     2122       def var route-dt as datetime no-undo.
     2123       for each buf_route no-lock
     2124           where buf_route.db-num = buf_db.db-num
     2125           and buf_route.last-pack = p-last-pck-num:
     2126               route-dt = datetime(string(buf_route.CreDate) + " " + buf_route.CreTime) no-error.
     2127               if error-status:ERROR then next.
     2128               find first tt-stat-info no-lock
     2129                   where tt-stat-info.table-name = buf_route.name-rec
     2130                   and tt-stat-info.db-num = buf_db.db-num
     2131                   no-error.
     2132               if not avail tt-stat-info then do:
     2133                   create tt-stat-info.
     2134                   assign
     2135                       tt-stat-info.db-num = buf_db.db-num
     2136                       tt-stat-info.table-name = buf_route.name-rec
     2137                       .
     2138               end.
     2139               tt-stat-info.rec-count = tt-stat-info.rec-count + 1.
     2140       end.
     2141   end.
     2142   procedure highlight-dbs-rows:
     2143       do with frame dialog-frame:
     2144           if tt-db-info.last-recv-pck-dt < dt-not-conf-interval then
     2145               tt-db-info.last-recv-pck-dt-str:FGCOLOR in browse BROWSE-dbs = 12.
     2146           if tt-db-info.avg-wait-confirm-int > end-work-dt then
     2147               tt-db-info.avg-wait-confirm-str:FGCOLOR in browse BROWSE-dbs = 12.
     2148       end.
     2149   end.
     2150   procedure refresh-query:
     2151       def input param p-query-num as int.
     2152       do with frame frame-dbs:
     2153           if p-query-num = 1 then
     2154               OPEN QUERY BROWSE-dbs for each tt-db-info.
     2155           if p-query-num = 2 then
     2156               OPEN QUERY BROWSE-stat for each tt-stat-info
     2157                   where tt-stat-info.db-num = tt-db-info.db-num.
     2158       end.
     2159   end.
     2160   PROCEDURE disable_UI :
     2161     HIDE FRAME Dialog-Frame.
     2162   END PROCEDURE.
     2163   PROCEDURE enable_UI :
     2164     DISPLAY dbs abs-time-pack avail-time period
     2165         WITH FRAME Dialog-Frame.
     2166     ENABLE RECT-1 RECT-2 Btn_OK Btn_print BUTTON-start dbs abs-time-pack
     2167            avail-time period BROWSE-dbs BROWSE-stat
     2168         WITH FRAME Dialog-Frame.
     2169     VIEW FRAME Dialog-Frame.
     2170     OPEN QUERY BROWSE-dbs FOR EACH tt-db-info NO-LOCK INDEXED-REPOSITION.    OPEN QUERY BROWSE-stat FOR EACH tt-stat-info.
     2171   END PROCEDURE.
