     3483   procedure display-title :
     3484      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip( 2)
     3485             reportname  at 1 format "x(133)" skip
     3486             trim( str1)  at 35 format "x(75)" skip.
     3487        repeat i = 1 to num-entries( str2,chr( 10)) :
     3488         PUT stream  OutStream  UNFORMATTED  entry( i,str2,chr( 10))  at 1 format "x(130)" skip.
     3489        end.
     3490       i=0.
     3491        repeat i = 1 to num-entries( str3,chr( 10)) :
     3492         PUT stream  OutStream  UNFORMATTED  entry( i,str3,chr( 10))  at 1 format "x(130)" skip.
     3493        end.
     3494       i=0.
     3495        repeat i = 1 to num-entries( str4,chr( 10)) :
     3496         PUT stream  OutStream  UNFORMATTED  entry( i,str4,chr( 10))  at 1 format "x(130)" skip.
     3497        end.
     3498       i=0.
     3499        repeat i = 1 to num-entries( reportheader,chr( 10)) :
     3500         PUT stream  OutStream  UNFORMATTED  entry( i,reportheader,chr( 10))  at 1 format "x(130)" skip.
     3501        end.
     3502       i=0.
     3503    end procedure.
     3504   procedure ob-line  :
     3505   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3506   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3507   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3508   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3509   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3510   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3511   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3512   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3513   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3514   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3515   define input  parameter xtog-obj           as log no-undo.
     3516   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3517   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3518   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3519   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3520   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3521   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3522   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3523   define variable  v-summa  as decimal extent 4 no-undo .
     3524   define variable  tt#          as int no-undo.
     3525   define variable v-ii as integer no-undo .
     3526   define variable slt  as decimal no-undo .
     3527   define variable disc  as decimal no-undo .
     3528   define variable xi as integer no-undo .
     3529   define variable v-tt as integer no-undo .
     3530    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3531       else
     3532       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3533       else
     3534       assign tt# = 6  v-tt = 200.
     3535     if long-p = false then do :
     3536     for each obj-list no-lock:
     3537      if  xtog-obj then
     3538          if   not(x-store-type     = obj-list.obj-type
     3539               and x-store-code    = obj-list.obj-code ) then next.
     3540           for each ub.ot-line where
     3541                     ub.ot-line.artic         = x-artic
     3542               and   ub.ot-line.prod-code    = x-prod-code
     3543               and   ub.ot-line.prod-type    = x-prod-type
     3544               and   ub.ot-line.fact-order   <= x-fact-order-2
     3545               and   ub.ot-line.fact-order   >= x-fact-order-1
     3546               and   ub.ot-line.obj-code     = obj-list.obj-code
     3547               and   ub.ot-line.obj-type     = obj-list.obj-type
     3548               and   ub.ot-line.sum-type     = x-sum-type
     3549               no-lock :
     3550               case ub.ot-line.ext-doc-type:
     3551     WHEN 'ie':U THEN DO:
     3552       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3553             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3554             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3555         if tt# = 6 Then   assign
     3556             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3557             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3558             End.
     3559     WHEN 'ee':U THEN DO:
     3560       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3561             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3562             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3563         if tt# = 6 Then   assign
     3564             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3565             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3566             End.
     3567     WHEN 'ep':U THEN DO:
     3568       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
