     3798       oborot-ee                 [kk]    = 0
     3799       oborot-ep              [kk]    = 0
     3800       oborot-es            [kk]    = 0
     3801       oborot-re             [kk]    = 0
     3802       oborot-rs        [kk]    = 0
     3803       oborot-we                 [kk]    = 0
     3804       oborot-vt                       [kk]    = 0
     3805       oborot-iv                 [kk]    = 0
     3806       oborot-ev                 [kk]    = 0
     3807       oborot-rv             [kk]    = 0
     3808       oborot-em                  [kk]    = 0
     3809       oborot-wm                  [kk]    = 0
     3810       oborot-im                  [kk]    = 0
     3811       oborot-ot                  [kk]    = 0
     3812       oborot-pc           [kk]    = 0
     3813       oborot-ap           [kk]    = 0
     3814       oborot-disc                             [kk]    = 0
     3815       oborot-eff                             [kk]    = 0
     3816       oborot-prc                             [kk]    = 0
     3817       ostatok-end      [kk] =   0
     3818       ostatok-start    [kk] =   0   .
     3819          end.
     3820    end procedure.
