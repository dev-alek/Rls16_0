     2546   procedure calcitog :
     2547       run ostatok  in this-procedure (
     2548           input x-store-code  ,
     2549           input x-store-type  , x-tog-shift ,
     2550           input x-date-start - 1 ,
     2551           input date( '')      , ?, ?,
     2552           input 'crsa':U   ,
     2553           input '##,##':U,
     2554           input xtog-obj ,
     2555           output  quantity1  ,
     2556           output  coast_r1   ,
     2557           output  coast_v1   ,
     2558           output  vat_r1     ,
     2559           output  vat_v1     ,
     2560           output  fact-order-1 ).
     2561       run ostatok  in this-procedure (
     2562           input x-store-code  ,
     2563           input x-store-type  , x-tog-shift ,
     2564           input x-date-start  ,
     2565           input x-date-end    ,  ?, ?,
     2566           input 'crsa':U   ,
     2567           input '##,##':U,
     2568           input xtog-obj ,
     2569           output  quantity1  ,
     2570           output  coast_r1   ,
     2571           output  coast_v1   ,
     2572           output  vat_r1     ,
     2573           output  vat_v1     ,
     2574           output  fact-order-2 ).
     2575             quantity1  = 0.
     2576             coast_r1   = 0.
     2577             coast_v1   = 0.
     2578             vat_r1     = 0.
     2579             vat_v1     = 0.
     2580   end procedure.
     2581   procedure display-str1  :
     2582    end procedure.
     2583   procedure display-bi  :
     2584    if line-counter( OutStream )  > page-size( OutStream ) then DO : display STREAM OutStream    with frame top-frame. end.
     2585     p = p + 1.
     2586     if use-column[28] then c-str-num:screen-value           = '' .
     2587     if use-column[1] then  c-s-bar-code:screen-value        = ''.
     2588     if use-column[2] then  c-gds-zap-artic:screen-value     = gds-zap-artic.
     2589     if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     2590     if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
