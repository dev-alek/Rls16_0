     2527   procedure print-header :
     2528   if not firstline then  run display-title  in this-procedure .
     2529       firstline = true .
     2530       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2531             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + caps( objname)  at 30 format "x(170)" skip.
     2532             end.
     2533             form with FRAME ZAPAS .   DOWN stream   OutStream 1 with FRAME ZAPAS .
     2534         run clear-b1  in this-procedure .
     2535         run clear-bi  in this-procedure .
     2536         break_group = true.
     2537         break_group1 = true.
     2538         display stream outstream     with frame top-frame .
     2539         display stream outstream     with frame top-2 .
     2540   end procedure.
