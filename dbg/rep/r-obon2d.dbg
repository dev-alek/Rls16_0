     3947   create temp#sum-type.
     3948   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
     3949   assign temp#sum-type.sum-type = 'sadt':U + 'pc':U temp#sum-type.xi = 216 .
     3950   end procedure.
     3951   procedure pp :
     3952   define input parameter ll as integer no-undo .
     3953   define input parameter uu as integer no-undo .
     3954   define input parameter ff as character no-undo .
     3955   if ll > g-ll then return.
     3956   if ll < 1 then return.
     3957     for each   ub.gds-grp no-lock where ub.gds-grp.lvl-num = ll
     3958         and    ub.gds-grp.upper-code = uu
     3959         :
     3960          id = id + 1 .
     3961               create tmp-gds.
     3962               assign
     3963                 tmp-gds.id        = id
     3964                 tmp-gds.name      = (if ll = 1 then "" else fill("_",ll)) + ub.gds-grp.node-name + chr(47)
     3965                 tmp-gds.f-name    = ff + ub.gds-grp.node-name + chr(47)
     3966                 tmp-gds.node-code = ub.gds-grp.node-code
     3967                 tmp-gds.lvl = ub.gds-grp.lvl-num
     3968                 .
     3969               run pp in this-procedure (ll + 1 , ub.gds-grp.node-code , tmp-gds.f-name ).
     3970     End.
     3971   End procedure.
     3972   procedure find-last-prise-med :
     3973   define input parameter p-artic     like ub.goods.artic no-undo .
     3974   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     3975   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     3976   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     3977   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     3978   define buffer p-gds-obj   for  ub.gds-obj .
     3979   define buffer buf_trn-doc for  ub.trn-doc .
     3980   define variable v-fact-order as decimal no-undo .
     3981   p-price = 0 .
     3982     define variable v-in-date as date      no-undo .
     3983     define variable fl as logical no-undo .
     3984     fl = yes.
     3985     v-fact-order = 0 .
     3986     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     3987     :
     3988       find first p-gds-obj no-lock
     3989         where p-gds-obj.artic     = p-artic         and
     3990                 p-gds-obj.prod-type = p-prod-type     and
     3991                 p-gds-obj.prod-code = p-prod-code     and
     3992                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     3993                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     3994         no-error .
     3995       if available p-gds-obj then do:
     3996       if p-gds-obj.in-date = ?  then next .
     3997       if fl = yes then do:
     3998         assign
     3999           v-in-date = p-gds-obj.in-date
     4000           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4001           fl = no
     4002       .
     4003        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     4004        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     4005       end.
     4006         if p-gds-obj.in-date >= v-in-date   then do:
     4007            if p-gds-obj.in-date = v-in-date then do:
     4008               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     4009               if available buf_trn-doc  then
     4010                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     4011                     assign
     4012                       v-fact-order = buf_trn-doc.fact-order
     4013                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4014                       v-in-date =   p-gds-obj.in-date
     4015                     .
     4016                   end.
     4017            end.
     4018            else do:
     4019             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     4020             if available buf_trn-doc  then
     4021                 assign
     4022                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     4023                   v-in-date =    p-gds-obj.in-date
     4024                   v-fact-order = buf_trn-doc.fact-order .
     4025                 .
     4026             end.
     4027           if p-price = ? then   p-price  = 0 .
     4028         end.
     4029       end.
     4030     End .
     4031     if p-price = ? then   p-price  = 0 .
     4032   end procedure.
     4033   procedure find-mediator :
     4034   define input  parameter c-host-code as integer no-undo .
     4035   define input  parameter p-Showmediatr as logical no-undo .
     4036   define output parameter p-host-code as integer no-undo .
     4037   define output parameter p-flag as logical no-undo .
     4038   define buffer b-sysconf  for ub.sysconf.
     4039    p-host-code = 0 .
     4040    p-flag  = true .
     4041       if p-Showmediatr = true then do:
     4042       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     4043             if avail ub.sysconf then DO :
     4044               p-host-code = ub.sysconf.host-code.
     4045               if tPrintRubl = false then do:
     4046                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     4047                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     4048                                 p-flag  = false  .
     4049                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     4050                                 view-as alert-box error.
     4051                           end.
     4052               end.
     4053             end.
     4054             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     4055                 create tt-obj-list no-error .
     4056                 assign tt-obj-list.obj-type = 'маг':U
     4057                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     4058             end.
     4059             for each ub.store no-lock where ub.store.host-code = p-host-code :
     4060                 create tt-obj-list no-error .
     4061                 assign tt-obj-list.obj-type = 'скл':U
     4062                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     4063             end.
     4064       End.
     4065    End procedure .
     4066   PROCEDURE ob-line-stk  :
     4067   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     4068   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     4069   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     4070   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     4071   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     4072   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     4073   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     4074   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     4075   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     4076   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     4077   define input  parameter xTog-obj         as log                     no-undo.
     4078   define input  parameter xi               as int                     no-undo.
     4079   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     4080   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     4081   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     4082   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     4083   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     4084   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     4085   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     4086   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     4087   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     4088   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     4089   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     4090   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     4091   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     4092   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     4093   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     4094   define buffer stk-line2 for ub.stk-line .
     4095   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     4096    Assign
     4097      First-qnty  = 0
     4098      Second-qnty = 0
     4099      Quntity     = 0
     4100      First-sum  = 0
     4101      Second-sum = 0
     4102      sum        = 0
     4103      First-vat  = 0
     4104      Second-vat = 0
     4105      vat        = 0
     4106      First-slt   = 0
     4107      Second-slt  = 0
     4108      slt         = 0
     4109      First-disc  = 0
     4110      Second-disc = 0
     4111      disc        = 0
     4112     .
     4113     For each obj-list  no-lock :
     4114      if  xTog-obj THEN
     4115          if   NOT(    x-store-type     = obj-list.obj-type
     4116               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     4117      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     4118         find last ub.stk-line no-lock
     4119           where ub.stk-line.obj-type   = obj-list.obj-type
     4120             and ub.stk-line.obj-code   = obj-list.obj-code
     4121             and ub.stk-line.artic      = x-artic
     4122             and ub.stk-line.prod-type  = x-prod-type
     4123             and ub.stk-line.prod-code  = x-prod-code
     4124             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     4125             and ub.stk-line.cat-id     = '##,##':U
     4126             and ub.stk-line.fact-order <= x-fact-order-1
     4127           use-index category
     4128           no-error .
     4129         if available ub.stk-line then do:
     4130           assign
     4131             First-qnty = First-qnty + ub.stk-line.fact-qnty
     4132             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     4133             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     4134             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     4135             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     4136           .
     4137         end.
     4138         find last stk-line2 no-lock
     4139           where stk-line2.obj-code   = obj-list.obj-code
     4140             and stk-line2.obj-type   = obj-list.obj-type
     4141             and stk-line2.artic      = x-artic
     4142             and stk-line2.prod-type  = x-prod-type
     4143             and stk-line2.prod-code  = x-prod-code
     4144             and stk-line2.sum-type   = temp#sum-type.sum-type
     4145             and stk-line2.cat-id     = '##,##':U
     4146             and stk-line2.fact-order <= x-fact-order-2
     4147           use-index category
     4148           no-error .
     4149         if available stk-line2 then do:
     4150           assign
     4151             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     4152             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     4153             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     4154             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     4155             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     4156           .
     4157         end.
     4158      end.
     4159    end.
     4160    Assign
     4161      Quntity = Second-qnty - first-qnty
     4162      sum     = Second-sum  - first-sum
     4163      vat     = Second-vat  - first-vat
     4164      slt     = Second-slt  - first-slt
     4165      disc    = Second-disc  - first-disc
     4166      .
     4167   END PROCEDURE.
     4168   procedure calc-s-itog :
     4169   define variable n-1 as integer no-undo .
     4170       do n-1 = 1 to 10 :
     4171       assign
     4172         bi-oborot-ie        [n-1]  =bi-oborot-ie        [n-1]  + b1-oborot-ie        [n-1]
     4173         bi-oborot-ee       [n-1]  =bi-oborot-ee       [n-1]  + b1-oborot-ee       [n-1]
     4174         bi-oborot-ep     [n-1]  =bi-oborot-ep     [n-1]  + b1-oborot-ep     [n-1]
     4175         bi-oborot-es    [n-1]  =bi-oborot-es    [n-1]  + b1-oborot-es    [n-1]
     4176         bi-oborot-re    [n-1]  =bi-oborot-re    [n-1]  + b1-oborot-re    [n-1]
     4177         bi-oborot-rs[n-1] = bi-oborot-rs[n-1]  + b1-oborot-rs[n-1]
     4178         bi-oborot-we[n-1]  =bi-oborot-we[n-1]  + b1-oborot-we[n-1]
     4179         bi-oborot-vt [n-1]  =bi-oborot-vt [n-1]  + b1-oborot-vt [n-1]
     4180         bi-oborot-iv  [n-1]  =bi-oborot-iv  [n-1]  + b1-oborot-iv  [n-1]
     4181         bi-oborot-ev  [n-1]  =bi-oborot-ev  [n-1]  + b1-oborot-ev  [n-1]
     4182         bi-oborot-rv  [n-1]  =bi-oborot-rv  [n-1]  + b1-oborot-rv  [n-1]
     4183         bi-oborot-em  [n-1]  =bi-oborot-em  [n-1]  + b1-oborot-em  [n-1]
     4184         bi-oborot-wm  [n-1]  =bi-oborot-wm  [n-1]  + b1-oborot-wm  [n-1]
     4185         bi-oborot-im  [n-1]  =bi-oborot-im  [n-1]  + b1-oborot-im  [n-1]
     4186         bi-oborot-ot  [n-1]  =bi-oborot-ot  [n-1]  + b1-oborot-ot  [n-1]
     4187         bi-oborot-pc  [n-1]  =bi-oborot-pc  [n-1]  + b1-oborot-pc [n-1]
     4188         bi-oborot-ap  [n-1]  =bi-oborot-ap  [n-1]  + b1-oborot-ap [n-1]
     4189         bi-oborot-disc                           [n-1]  =bi-oborot-disc                           [n-1]  + b1-oborot-disc                           [n-1]
     4190         bi-oborot-sum-sale                       [n-1]  =bi-oborot-sum-sale                       [n-1]  + b1-oborot-sum-sale                       [n-1]
     4191         bi-oborot-sum-cost                       [n-1]  =bi-oborot-sum-cost                       [n-1]  + b1-oborot-sum-cost                       [n-1]
     4192         bi-ostatok-start                         [n-1]  =bi-ostatok-start                     [n-1]  + b1-ostatok-start                         [n-1]
     4193         bi-ostatok-end                           [n-1]  =bi-ostatok-end                       [n-1]  + b1-ostatok-end                           [n-1]
     4194         bo-oborot-ie        [n-1]  =bo-oborot-ie        [n-1]  + b1-oborot-ie        [n-1]
     4195         bo-oborot-ee       [n-1]  =bo-oborot-ee       [n-1]  + b1-oborot-ee       [n-1]
     4196         bo-oborot-ep     [n-1]  =bo-oborot-ep     [n-1]  + b1-oborot-ep     [n-1]
     4197         bo-oborot-es    [n-1]  =bo-oborot-es    [n-1]  + b1-oborot-es    [n-1]
     4198         bo-oborot-re    [n-1]  =bo-oborot-re    [n-1]  + b1-oborot-re    [n-1]
     4199         bo-oborot-rs[n-1] = bo-oborot-rs[n-1]  + b1-oborot-rs[n-1]
     4200         bo-oborot-we[n-1]  =bo-oborot-we[n-1]  + b1-oborot-we[n-1]
     4201         bo-oborot-vt [n-1]  =bo-oborot-vt [n-1]  + b1-oborot-vt [n-1]
     4202         bo-oborot-iv  [n-1]  =bo-oborot-iv  [n-1]  + b1-oborot-iv  [n-1]
     4203         bo-oborot-ev  [n-1]  =bo-oborot-ev  [n-1]  + b1-oborot-ev  [n-1]
     4204         bo-oborot-rv  [n-1]  =bo-oborot-rv  [n-1]  + b1-oborot-rv  [n-1]
     4205         bo-oborot-em  [n-1]  =bo-oborot-em  [n-1]  + b1-oborot-em  [n-1]
     4206         bo-oborot-wm  [n-1]  =bo-oborot-wm  [n-1]  + b1-oborot-wm  [n-1]
     4207         bo-oborot-im  [n-1]  =bo-oborot-im  [n-1]  + b1-oborot-im  [n-1]
     4208         bo-oborot-ot  [n-1]  =bo-oborot-ot  [n-1]  + b1-oborot-ot  [n-1]
     4209         bo-oborot-pc  [n-1]  =bo-oborot-pc  [n-1]  + b1-oborot-pc [n-1]
     4210         bo-oborot-ap  [n-1]  =bo-oborot-ap  [n-1]  + b1-oborot-ap [n-1]
     4211         bo-oborot-disc                           [n-1]  =bo-oborot-disc                           [n-1]  + b1-oborot-disc                           [n-1]
     4212         bo-oborot-sum-sale                       [n-1]  =bo-oborot-sum-sale                       [n-1]  + b1-oborot-sum-sale                       [n-1]
     4213         bo-oborot-sum-cost                       [n-1]  =bo-oborot-sum-cost                       [n-1]  + b1-oborot-sum-cost                       [n-1]
     4214         bo-ostatok-start                         [n-1]  =bo-ostatok-start                     [n-1]  + b1-ostatok-start                         [n-1]
     4215         bo-ostatok-end                           [n-1]  =bo-ostatok-end                       [n-1]  + b1-ostatok-end                           [n-1]
     4216       .
     4217       end.
     4218   end procedure.
     4219   PROCEDURE PRICE-VAT :
     4220   define input parameter PP as character no-undo .
     4221   if pp = '' THEN DO:
     4222   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     4223   p = p + 1.
     4224   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     4225   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string(  ostatok-start  [2]                         ) else  string(  ostatok-start  [2]                        -  ostatok-start  [3]                       )  .
     4226   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string(  oborot-ie [2]          ) else  string(  oborot-ie [2]         -  oborot-ie [3]        )  .
     4227   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string(  oborot-iv [2]          ) else  string(  oborot-iv [2]         -  oborot-iv [3]        )  .
     4228   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string(  oborot-im  [2]          ) else  string(  oborot-im  [2]         -  oborot-im  [3]        )  .
     4229   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string(  oborot-ee [2]          ) else  string(  oborot-ee [2]         -  oborot-ee [3]        )  .
     4230   if use-column[11] then C-oborot-ev:screen-value          = if x-vat then  string(  oborot-ev [2]          ) else  string(  oborot-ev [2]         -  oborot-ev [3]        )  .
     4231   if use-column[12] then C-oborot-em:screen-value           = if x-vat then  string(  oborot-em  [2]          ) else  string(  oborot-em  [2]         -  oborot-em  [3]        )  .
     4232   if use-column[13] then C-oborot-we:screen-value          = if x-vat then  string(  oborot-we         [2]  ) else  string(  oborot-we         [2] -  oborot-we         [3])  .
     4233   if use-column[14] then C-oborot-es:screen-value     = if x-vat then  string(  oborot-es    [2]  ) else  string(  oborot-es    [2] -  oborot-es    [3])  .
     4234   if use-column[15] then C-oborot-rs:screen-value = if x-vat then  string(  oborot-rs[2]  ) else  string(  oborot-rs[2] -  oborot-rs[3])  .
     4235   if use-column[16] then C-oborot-re:screen-value      = if x-vat then  string(  oborot-re     [2]  ) else  string(  oborot-re     [2] -  oborot-re     [3])  .
     4236   if use-column[17] then C-oborot-ep:screen-value       = if x-vat then  string(  oborot-ep      [2]  ) else  string(  oborot-ep      [2] -  oborot-ep      [3])  .
     4237   if use-column[18] then C-oborot-rv:screen-value      = if x-vat then  string(  oborot-rv     [2]  ) else  string(  oborot-rv     [2] -  oborot-rv     [3])  .
     4238   if use-column[19] then C-oborot-vt:screen-value                = if x-vat then  string(  oborot-vt               [2]  ) else  string(  oborot-vt               [2] -  oborot-vt               [3])  .
     4239   if use-column[20] then C-oborot-ot:screen-value           = if x-vat then  string(  oborot-ot          [2]  ) else  string(  oborot-ot          [2] -  oborot-ot          [3])  .
     4240   if use-column[22] then C-ostatok-end:screen-value                            = if x-vat then  string(  ostatok-end                           [2]  ) else  string(  ostatok-end                           [2] -  ostatok-end                           [3])  .
     4241   if use-column[25] then C-oborot-ap:screen-value     = if x-vat then  string(  oborot-ap    [2])   else  string(  oborot-ap [2]    -  oborot-ap [3]   )  .
     4242   if use-column[26] then C-oborot-pc:screen-value     = if x-vat then  string(  oborot-pc    [2])   else  string(  oborot-pc [2]    -  oborot-pc [3]   )  .
     4243   if use-column[27] then C-oborot-r-v:screen-value                             = if x-vat then  string(
     4244                                                                                            oborot-ee         [2] +
     4245                                                                                            oborot-re     [2] +
     4246                                                                                            oborot-es    [2] +
     4247                                                                                            oborot-rs[2]
     4248                                                                                           )
     4249                                                                                            else  string(
     4250                                                                                          ( oborot-ee         [2] +
     4251                                                                                            oborot-re     [2] +
     4252                                                                                            oborot-es    [2] +
     4253                                                                                            oborot-rs[2]) -
     4254                                                                                          ( oborot-ee         [3] +
     4255                                                                                            oborot-re     [3] +
     4256                                                                                            oborot-es    [3] +
     4257                                                                                            oborot-rs[3] )
     4258                                                                                            ).
     4259   DISPLAY stream OutStream with FRAME ZAPAS.  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4260      End.
     4261   run price-vat-1 ( pp).
     4262   END PROCEDURE.
     4263   PROCEDURE PRICE-VAT-1 :
     4264   define input parameter PP as character no-undo .
     4265   if pp = 'Bi' THEN DO:
     4266   if line-counter( OutStream ) > page-size( OutStream ) then DO: display STREAM OutStream with frame top-frame. end.
     4267   p = p + 1.
     4268   if use-column[1] then  c-s-bar-code:screen-value        = ''.
     4269   if use-column[2] then  c-gds-zap-artic:screen-value     = ''.
     4270   if use-column[3] then  c-gds-zap-gds-name:screen-value  = ''.
     4271   if use-column[4] then  c-gds-zap-unit-base:screen-value = ''.
     4272   if use-column[5] then  c-gds-type:screen-value          = v-name-type.
     4273   if use-column[6]  then C-ostatok-start:screen-value                          = if x-vat then  string( Bi-ostatok-start  [2]                         ) else  string( Bi-ostatok-start  [2]                        - Bi-ostatok-start  [3]                       )  .
     4274   if use-column[7]  then C-oborot-ie:screen-value          = if x-vat then  string( Bi-oborot-ie [2]          ) else  string( Bi-oborot-ie [2]         - Bi-oborot-ie [3]        )  .
     4275   if use-column[8]  then C-oborot-iv:screen-value          = if x-vat then  string( Bi-oborot-iv [2]          ) else  string( Bi-oborot-iv [2]         - Bi-oborot-iv [3]        )  .
     4276   if use-column[9]  then C-oborot-im:screen-value           = if x-vat then  string( Bi-oborot-im  [2]          ) else  string( Bi-oborot-im  [2]         - Bi-oborot-im  [3]        )  .
     4277   if use-column[10] then C-oborot-ee:screen-value          = if x-vat then  string( Bi-oborot-ee [2]          ) else  string( Bi-oborot-ee [2]         - Bi-oborot-ee [3]        )  .
