     1206     allcol = num-entries( sizes) - 1 .
     1207   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1208     if  log-manager:logfile-name ne ?
     1209     then DO:
     1210         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1211     end.
     1212     if not session:batch-mode then
     1213     do:
     1214       VIEW FRAME InfoFrame.
     1215       mFrameView = true.
     1216     end.
     1217      v-button-stop = false .
     1218         if mFrameView
     1219         then do:
     1220         if v-button-stop then view STOPBTN in frame InfoFrame.
     1221                          else Hide STOPBTN in frame InfoFrame.
     1222         end.
     1223   IF ( i-str modulo v-account = 0 )  then DO:
     1224    Assign
     1225       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1226       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1227       .
     1228    Assign
     1229       v-kol-spice = (50 - LENGTH(objname)) / 2
     1230       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     1231       .
     1232             if  log-manager:logfile-name ne ?
     1233             then DO:
     1234                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1235             end.
     1236              if mFrameView
     1237              then do:
     1238               DISPLAY
     1239                 i-str @ RecordsDone
     1240                 RecordsString   @ RecordsString
     1241                 RecordsString2  @ RecordsString2
     1242                 WITH FRAME InfoFrame.
     1243              end.
     1244   End.
     1245      if v-button-stop then  DO:
     1246            if mFrameView
     1247            then
     1248               PROCESS EVENTS.
     1249            IF StopProcessing THEN DO:
     1250            RETURN error.
     1251            End.
     1252      end.
     1253   define new shared variable t-1 as character initial "|||"
