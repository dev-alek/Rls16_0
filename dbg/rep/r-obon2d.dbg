     3907   assign temp#sum-type.sum-type = 'csdt':U + 'im':U temp#sum-type.xi = 13. create temp#sum-type.
     3908   assign temp#sum-type.sum-type = 'csdt':U + 'ot':U temp#sum-type.xi = 14.
     3909   create temp#sum-type.
     3910   assign temp#sum-type.sum-type = 'csdt':U + 'ap':U temp#sum-type.xi = 15 . create temp#sum-type.
     3911   assign temp#sum-type.sum-type = 'csdt':U + 'pc':U temp#sum-type.xi = 16 .
     3912   create temp#sum-type.
     3913   assign temp#sum-type.sum-type = 'cgdt':U + 'ie':U temp#sum-type.xi = 101 . create temp#sum-type.
     3914   assign temp#sum-type.sum-type = 'cgdt':U + 'ee':U temp#sum-type.xi = 102 . create temp#sum-type.
     3915   assign temp#sum-type.sum-type = 'cgdt':U + 'ep':U temp#sum-type.xi = 103 . create temp#sum-type.
     3916   assign temp#sum-type.sum-type = 'cgdt':U + 'es':U temp#sum-type.xi = 104 . create temp#sum-type.
     3917   assign temp#sum-type.sum-type = 'cgdt':U + 're':U temp#sum-type.xi = 105 . create temp#sum-type.
     3918   assign temp#sum-type.sum-type = 'cgdt':U + 'rs':U temp#sum-type.xi = 106 . create temp#sum-type.
     3919   assign temp#sum-type.sum-type = 'cgdt':U + 'we':U temp#sum-type.xi = 107 . create temp#sum-type.
     3920   assign temp#sum-type.sum-type = 'cgdt':U + 'vt':U temp#sum-type.xi = 108 . create temp#sum-type.
     3921   assign temp#sum-type.sum-type = 'cgdt':U + 'iv':U temp#sum-type.xi = 109 . create temp#sum-type.
     3922   assign temp#sum-type.sum-type = 'cgdt':U + 'ev':U temp#sum-type.xi = 110. create temp#sum-type.
     3923   assign temp#sum-type.sum-type = 'cgdt':U + 'rv':U temp#sum-type.xi = 111. create temp#sum-type.
     3924   assign temp#sum-type.sum-type = 'cgdt':U + 'em':U temp#sum-type.xi = 112. create temp#sum-type.
     3925   assign temp#sum-type.sum-type = 'cgdt':U + 'wm':U temp#sum-type.xi = 112. create temp#sum-type.
     3926   assign temp#sum-type.sum-type = 'cgdt':U + 'im':U temp#sum-type.xi = 113. create temp#sum-type.
     3927   assign temp#sum-type.sum-type = 'cgdt':U + 'ot':U temp#sum-type.xi = 114.
     3928   create temp#sum-type.
     3929   assign temp#sum-type.sum-type = 'cgdt':U + 'ap':U temp#sum-type.xi = 115 . create temp#sum-type.
     3930   assign temp#sum-type.sum-type = 'cgdt':U + 'pc':U temp#sum-type.xi = 116 .
     3931   create temp#sum-type.
