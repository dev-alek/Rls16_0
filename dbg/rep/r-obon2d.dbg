     3699   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3700   end.
     3701     if tt# = 6 then do:
     3702     if  xshowmediator = false then
     3703         oborot-sum-cost[1] =
     3704         oborot-ee[2]      +
     3705         oborot-es[2] +
     3706         oborot-re[2]  +
     3707         oborot-rs[2]
     3708         .
     3709         else
     3710         oborot-sum-cost[1] =
     3711         oborot-ee[4]      +
     3712         oborot-es[4] +
     3713         oborot-re[4]  +
     3714         oborot-rs[4]
     3715         .
     3716        repeat v-ii = 1 to 1 :
     3717        v-summa[v-ii ]  =
     3718           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     3719           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     3720           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     3721           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     3722           oborot-im[v-ii ] .
     3723        end.
     3724        repeat v-ii = 2 to 4 :
     3725        v-summa[v-ii ]  =
     3726           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     3727           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     3728           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     3729           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     3730           oborot-im[v-ii + tt#] .
     3731        end.
     3732         oborot-sum-sale[1] =
     3733         oborot-ee[2 + tt#] +
     3734         oborot-es[2 + tt#] +
     3735         oborot-re[2 + tt#] +
     3736         oborot-rs[2 + tt#]
     3737         .
     3738          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     3739           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     3740                                                                                                     -  oborot-disc[1]
     3741           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     3742           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     3743           .
     3744           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     3745           if oborot-sum-cost[1] <>  0 then
     3746             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     3747             else oborot-prc[1] = 0.
     3748     end.
     3749   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     3750   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     3751   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     3752   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     3753   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     3754   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     3755   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     3756   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     3757   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     3758   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     3759   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     3760   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     3761   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     3762   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     3763   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     3764   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     3765   end procedure.
     3766   procedure sum-i :
     3767   def input parameter ob like oborot-ot[1] no-undo.
     3768   def input parameter tt as int  no-undo.
     3769   def input-output parameter b1 like b1-oborot-ot[1] no-undo.
     3770   def input-output parameter b2 like b1-oborot-ot[1] no-undo.
     3771   def input-output parameter bi like b1-oborot-ot[1] no-undo.
     3772   def input-output parameter bo like b1-oborot-ot[1] no-undo.
     3773   def input parameter ob2 like oborot-ot[1] no-undo.
     3774   def input-output parameter b1- like b1-oborot-ot[1] no-undo.
     3775   def input-output parameter b2- like b1-oborot-ot[1] no-undo.
     3776   def input-output parameter bi- like b1-oborot-ot[1] no-undo.
     3777   def input-output parameter bo- like b1-oborot-ot[1] no-undo.
     3778   assign
     3779    b1  = b1 + ob
     3780    b2  = b2 + ob
     3781    b1- = b1- + ob2
     3782    b2- = b2- + ob2
     3783    .
     3784   if tmp-gds.lvl <= 1 then do:
     3785       assign
     3786       bi = bi + ob
     3787       bo = bo + ob
     3788       bi- = bi- + ob2
     3789       bo- = bo- + ob2
     3790       .
     3791   end.
     3792   end procedure.
     3793   procedure clear-item :
