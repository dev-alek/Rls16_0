      893   define variable v-kol-spice3 as integer no-undo .
      894   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      895   DEFINE BUTTON StopBtn AUTO-END-KEY
      896        LABEL "Стоп"
      897        SIZE 10 BY 1.
      898   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      899        LABEL "Обработано записей"
      900         VIEW-AS TEXT
      901        SIZE 14 BY .67 NO-UNDO.
      902   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      903         VIEW-AS TEXT
      904        SIZE 53.25 BY .67
      905        FGCOLOR 1  NO-UNDO.
      906   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
      907         VIEW-AS TEXT
      908        SIZE 53.25 BY .67
      909        FGCOLOR 1  NO-UNDO.
      910   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
      911         VIEW-AS TEXT
      912        SIZE 53.25 BY .67
      913        FGCOLOR 1  NO-UNDO.
      914   DEFINE RECTANGLE RECT-1
      915        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      916        SIZE 55.13 BY 4.46.
      917   DEFINE FRAME InfoFrame
      918        StopBtn AT ROW 4.25 COL 21.75
      919        RecordsString AT ROW 1.21 COL 2 NO-LABEL
      920        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
      921        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
      922        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
      923        RECT-1 AT ROW 1 COL 1
      924       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      925            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      926            TITLE "Процесс"
      927            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
      928   define variable mFrameView      as logical   no-undo init yes.
      929     define variable mFramHandle as handle no-undo.
      930     mFramHandle = frame InfoFrame:handle.
      931     if  log-manager:logfile-name ne ?
      932     then DO:
      933         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      934         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      935         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      936     end.
      937     mFrameView = not session:batch-mode and mFramHandle:visible.
      938     if mFrameView
      939     then do:
      940       ASSIGN
      941          FRAME InfoFrame:HIDDEN                           = TRUE
      942          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      943     end.
      944   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      945   DO:
      946     IF not StopProcessing THEN
      947       Message "Вы действительно хотите прервать" SKIP
      948               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      949                 UPDATE StopProcessing.
      950     IF StopProcessing THEN do:
      951        if mFrameView
      952        then do:
      953           HIDE FRAME InfoFrame.
      954        end.
      955     End.
      956   END.
