     2166                       b1-oborot-rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + b1-oborot-rv  [n-1]
     2167                       b1-oborot-em  [n-1]  = tmp-gds-tree.em  [n-1]  + b1-oborot-em  [n-1]
     2168                       b1-oborot-wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + b1-oborot-wm  [n-1]
     2169                       b1-oborot-im  [n-1]  = tmp-gds-tree.im  [n-1]  + b1-oborot-im  [n-1]
     2170                       b1-oborot-ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + b1-oborot-ot  [n-1]
     2171                       b1-oborot-pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + b1-oborot-pc [n-1]
     2172                       b1-oborot-ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + b1-oborot-ap [n-1]
     2173                       b1-oborot-disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + b1-oborot-disc                           [n-1]
     2174                       b1-ostatok-start                         [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + b1-ostatok-start                         [n-1]
     2175                       b1-ostatok-end                           [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + b1-ostatok-end                           [n-1]
     2176                       b1-oborot-sum-sale                       [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + b1-oborot-sum-sale                       [n-1]
     2177                       b1-oborot-sum-cost                       [n-1]  = tmp-gds-tree.oborot-sum-cost                [n-1]  + b1-oborot-sum-cost                       [n-1]
     2178                     .
     2179                    end.
     2180                    i = i + 1 .
     2181           end.
     2182           b1-oborot-eff[1 ]  = ( b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) .
     2183           if  b1-oborot-sum-cost[2] <>  0 then
     2184               b1-oborot-prc[1] = 100 * ( b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     2185               else b1-oborot-prc[1] = 0.
     2186               if not
