     2157                       b1-oborot-ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + b1-oborot-ee       [n-1]
     2158                       b1-oborot-ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + b1-oborot-ep     [n-1]
