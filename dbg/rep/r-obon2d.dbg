     3892   procedure make-tt-ed :
     3893   create temp#sum-type.
     3894   assign temp#sum-type.sum-type = 'csdt':U + 'ie':U temp#sum-type.xi = 1 . create temp#sum-type.
     3895   assign temp#sum-type.sum-type = 'csdt':U + 'ee':U temp#sum-type.xi = 2 . create temp#sum-type.
