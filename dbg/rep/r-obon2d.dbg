     1409   run rep/r-in-ob.p (
     1410      input          x-base-type
     1411    , input          x-base-code
     1412    , input          tprintrubl
     1413    , input-output   c-s-bar-code
     1414    , input-output   c-gds-zap-artic
     1415    , input-output   c-gds-zap-gds-name
     1416    , input-output   c-gds-zap-unit-base
     1417    , input-output   c-gds-type
     1418    , input-output   c-ostatok-start
     1419    , input-output   c-ostatok-end
     1420    , input-output   c-oborot-ie
     1421    , input-output   c-oborot-ee
     1422    , input-output   c-oborot-ep
     1423    , input-output   c-oborot-es
     1424    , input-output   c-oborot-re
     1425    , input-output   c-oborot-rs
     1426    , input-output   c-oborot-we
     1427    , input-output   c-oborot-vt
     1428    , input-output   c-oborot-iv
     1429    , input-output   c-oborot-ev
     1430    , input-output   c-oborot-rv
     1431    , input-output   c-oborot-em
     1432    , input-output   c-oborot-wm
     1433    , input-output   c-oborot-im
     1434    , input-output   c-oborot-ot
     1435    , input-output   c-oborot-pc
     1436    , input-output   c-oborot-ap
     1437    , input-output   c-oborot-disc
     1438    , input-output   c-oborot-eff
     1439    , input-output   c-oborot-prc
     1440    , input-output   c-oborot-r-v
     1441    , input-output   c-str-num
     1442    , input-output   l-col-type
     1443    , input-output   l-col-pos
     1444    , input-output   l-col-len
     1445    , input-output   l-col-format
     1446    , input-output   l-col-lable
     1447     ).
     1448        assign
     1449           number-list    = 1
     1450           i              = 0
     1451           xlavel         = xvar-lavel
     1452           select-good    = x-selectgood
     1453           paytype        = x-set_pay_type
     1454           retclassify    = xclassify
     1455           retsorttype    = xsorttype
     1456           sums-only      = xsumsonly
     1457           show-negativ   = xshowzero
     1458           x-selectobject = "".
     1459           firstline      = false.
     1460           valtype        = if ( paytype = 1) then 0  else x-set_val_type.
     1461       assign
     1462         line  = fill( '-', minimum( l-col-pos,189))
     1463         line2 = fill( '-', l-col-pos)
     1464         .
     1465     if  x-date-end  - x-date-start > 100
     1466         then long-p = true    .
     1467         else  long-p = false     .
     1468     find first ub.gds-grp where  ub.gds-grp.upper-code = 0 no-lock no-error .
     1469     if avail ub.gds-grp then  first-lavel = ub.gds-grp.node-code.
     1470                      else first-lavel = 0.
     1471     valtype         = if ( paytype = 1) then 0  else x-set_val_type.
     1472     if ( valtype=0 and x-base-code=0)  or valtype=1
     1473       then assign tprintrubl = yes .
     1474       else assign tprintrubl = no .
     1475     run make-tt-ed in this-procedure  .
     1476     run find-mediator  in this-procedure
     1477        (  input  v-cntxt-host-code-obj ,
     1478          input  xshowmediator,
     1479          output mediator-host-code,
     1480          output f-flag) .
     1481     if f-flag = false then return.
     1482     g-ll = xlavel .
     1483     run pp in this-procedure ( 1,first-lavel,"").
     1484     run report-execute in this-procedure .
     1485   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1486   define variable  str  as char format "X(60)"  no-undo.
     1487   define variable  str2 as char no-undo.
     1488   define variable v-r as character no-undo init "" .
     1489   define variable  i#i as int no-undo.
     1490   STR = "".
     1491   repeat i#i =1 to lavel#:
     1492       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1493       else do:
     1494           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1495           if not error-status:error  and str2 <> "":u then
     1496                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1497           end.
     1498   end.
     1499   if str <> ? then do:
     1500   v-r = str + chr(47) .
     1501   end.
     1502   RETURN v-r .
     1503   END FUNCTION.
     1504   procedure ost-line :
     1505     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1506     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1507     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1508     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1509     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1510     define input  parameter x-tog-shift  as logical no-undo .
     1511     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1512     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1513     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1514     define input  parameter xtog-obj     as logical no-undo .
     1515     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1516     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1517     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1518     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1519     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1520     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1521     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1522     define buffer buff-obj-list  for obj-list .
     1523     define buffer buff-stk-line  for ub.stk-line .
     1524     assign
     1525       Quantity = 0
     1526       Coast_R  = 0
     1527       Coast_V  = 0
     1528       VAT_R    = 0
     1529       VAT_V    = 0
     1530       SLT_R    = 0
     1531       SLT_V    = 0
     1532     .
     1533     if  x-tog-shift = false then do:
     1534       for each buff-obj-list no-lock
     1535         where xtog-obj = false
     1536            or (buff-obj-list.obj-type = x-store-type
     1537               and buff-obj-list.obj-code = x-store-code
     1538               )
     1539       on error undo, return error
     1540       :
     1541         find last buff-stk-line no-lock
     1542           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1543             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1544             and buff-stk-line.artic      = x-artic
     1545             and buff-stk-line.prod-type  = x-prod-type
     1546             and buff-stk-line.prod-code  = x-prod-code
     1547             and buff-stk-line.sum-type   = x-sum-type
     1548             and buff-stk-line.cat-id     = '##,##':U
     1549             and buff-stk-line.fact-order <= x-fact-order
     1550             and buff-stk-line.shift-num  = 0
     1551           use-index category
     1552           no-error .
     1553         if available buff-stk-line then do:
     1554           assign
     1555             Quantity = Quantity +  buff-stk-line.fact-qnty
     1556             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1557             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1558             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1559             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1560             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1561             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1562           .
     1563         end.
     1564       end.
     1565     end.
     1566     else do:
     1567       for each buff-obj-list no-lock
     1568         where xtog-obj = false
     1569            or (buff-obj-list.obj-type = x-store-type
     1570               and buff-obj-list.obj-code = x-store-code
     1571               )
     1572       on error undo, return error
     1573       :
     1574         find last buff-stk-line no-lock
     1575           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1576             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1577             and buff-stk-line.artic      = x-artic
     1578             and buff-stk-line.prod-type  = x-prod-type
     1579             and buff-stk-line.prod-code  = x-prod-code
     1580             and buff-stk-line.sum-type   = x-sum-type
     1581             and buff-stk-line.cat-id     = '##,##':U
     1582             and buff-stk-line.fact-order <= x-fact-order
     1583             and buff-stk-line.shift-num  > 0
     1584           use-index category
     1585           no-error .
     1586         if available buff-stk-line then do:
     1587           assign
     1588             Quantity = Quantity +  buff-stk-line.fact-qnty
     1589             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1590             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1591             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1592             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1593             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1594             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1595           .
     1596         end.
     1597       end.
     1598     end.
     1599   end procedure.
     1600   procedure ost-lineother-tax :
     1601     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1602     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1603     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1604     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1605     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1606     define input  parameter x-tog-shift  as logical no-undo .
     1607     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1608     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1609     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1610     define input  parameter xTog-obj     as logical no-undo .
     1611     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1612     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1613     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1614     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1615     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1616     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1617     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1618     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1619     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1620     define buffer buff-obj-list  for obj-list .
     1621     define buffer buff-stk-line  for ub.stk-line .
     1622     assign
     1623       Quantity = 0
     1624       Coast_R  = 0
     1625       Coast_V  = 0
     1626       VAT_R    = 0
     1627       VAT_V    = 0
     1628       SLT_R    = 0
     1629       SLT_V    = 0
     1630       other_R  = 0
     1631       other_V  = 0
     1632     .
     1633     if  x-tog-shift = false then do:
     1634       for each buff-obj-list no-lock
     1635         where xtog-obj = false
     1636            or (buff-obj-list.obj-type = x-store-type
     1637               and buff-obj-list.obj-code = x-store-code
     1638               )
     1639       on error undo, return error
     1640       :
     1641         find last buff-stk-line no-lock
     1642           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1643             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1644             and buff-stk-line.artic      = x-artic
     1645             and buff-stk-line.prod-type  = x-prod-type
     1646             and buff-stk-line.prod-code  = x-prod-code
     1647             and buff-stk-line.sum-type   = x-sum-type
     1648             and buff-stk-line.cat-id     = '##,##':U
     1649             and buff-stk-line.fact-order <= x-fact-order
     1650             and buff-stk-line.shift-num  = 0
     1651           use-index category
     1652           no-error .
     1653         if available buff-stk-line then do:
     1654           assign
     1655             Quantity = Quantity +  buff-stk-line.fact-qnty
     1656             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1657             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1658             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1659             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1660             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1661             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1662             other_R  = other_R  +  buff-stk-line.other-rubl
     1663             other_V  = other_V  +  buff-stk-line.other-base
     1664           .
     1665         end.
     1666       end.
     1667     end.
     1668     else do:
     1669       for each buff-obj-list no-lock
     1670         where xtog-obj = false
     1671            or (buff-obj-list.obj-type = x-store-type
     1672               and buff-obj-list.obj-code = x-store-code
     1673               )
     1674       on error undo, return error
     1675       :
     1676         find last buff-stk-line no-lock
     1677           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1678             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1679             and buff-stk-line.artic      = x-artic
     1680             and buff-stk-line.prod-type  = x-prod-type
     1681             and buff-stk-line.prod-code  = x-prod-code
     1682             and buff-stk-line.sum-type   = x-sum-type
     1683             and buff-stk-line.cat-id     = '##,##':U
     1684             and buff-stk-line.fact-order <= x-fact-order
     1685             and buff-stk-line.shift-num  > 0
     1686           use-index category
     1687           no-error .
     1688         if available buff-stk-line then do:
     1689           assign
     1690             Quantity = Quantity +  buff-stk-line.fact-qnty
     1691             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1692             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1693             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1694             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1695             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1696             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1697             other_R = other_R   +  buff-stk-line.other-rubl
     1698             other_V = other_V   +  buff-stk-line.other-base
     1699           .
     1700         end.
     1701       end.
     1702     end.
     1703   end procedure.
     1704   procedure ost-line-kg :
     1705     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1706     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1707     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1708     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1709     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1710     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1711     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1712     define buffer buff-obj-list  for obj-list .
     1713     define buffer buf_doc-line for ub.doc-line .
     1714     define buffer buf_inv-line for ub.inv-line .
     1715     do
     1716     on error undo, return error
     1717     :
     1718       for each buf_doc-line no-lock where
     1719                buf_doc-line.obj-type    = p-obj-type   and
     1720                buf_doc-line.obj-code    = p-obj-code   and
     1721                buf_doc-line.prod-type   = p-prod-type  and
     1722                buf_doc-line.prod-code   = p-prod-code  and
     1723                buf_doc-line.artic       = p-artic      and
     1724                buf_doc-line.status_     = 'факт':U      and
     1725                buf_doc-line.fact-order <= p-fact-order
     1726             by buf_doc-line.fact-order    descending
     1727       :
     1728         find first buf_inv-line no-lock where
     1729                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1730                    buf_inv-line.artic     = buf_doc-line.artic     and
     1731                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1732                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1733         if available buf_inv-line
     1734         then do:
     1735           if buf_inv-line.after-cli-qnty <> ?
     1736           then do:
     1737             assign
     1738               p-quantity-kg = buf_inv-line.after-cli-qnty
     1739             .
     1740             leave .
     1741           end.
     1742         end.
     1743       end.
     1744       if p-quantity-kg = ?
     1745       then do:
     1746         assign
     1747           p-quantity-kg = 0
     1748         .
     1749       end.
     1750     end.
     1751   end procedure.
     1752   PROCEDURE ostatok :
     1753   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1754   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1755   def input parameter x-tog-shift   as   logical             no-undo.
     1756   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1757   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1758   def input parameter x-shift-start as integer               no-undo.
     1759   def input parameter x-shift-end   as integer               no-undo.
     1760   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1761   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1762   def input parameter xTog-obj   as log no-undo.
     1763   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1764   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1765   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1766   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1767   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1768   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1769   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1770   def var              Fact-orderS   as char  no-undo.
     1771   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1772      Assign
     1773         Fact-order   = 0
     1774         Quantity     = 0
     1775         Coast_R      = 0
     1776         Coast_V      = 0
     1777         VAT_R        = 0
     1778         VAT_V        = 0 .
     1779    x-date-start-t  = x-date-start + 1 .
     1780   IF x-date-end = date('') then DO:
     1781      Fact-order = 0 .
     1782      for each obj-list
     1783          where  ( not xtog-obj or
     1784                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1785                 no-lock :
     1786         if  x-tog-shift = false then do:
     1787                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1788                               ub.stk-tot.Fact-date <=  x-date-start
     1789                               and ub.stk-tot.shift-num = 0
     1790                               USE-INDEX fact-date no-lock no-error .
     1791              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1792         End.
     1793         Else  DO :
     1794             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1795              (ub.stk-tot.shift-date  = x-date-start-t and
     1796               ub.stk-tot.shift-num  < x-shift-start or
     1797               ub.stk-tot.shift-date  < x-date-start-t  )
     1798               and ub.stk-tot.shift-num  > 0
     1799               USE-INDEX Shift-num no-lock no-error .
     1800            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1801           END.
     1802       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1803     End.
     1804   End.
     1805   Else DO:
     1806     For each obj-list  WHERE
     1807        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1808         no-lock :
     1809      IF  x-TOG-Shift = False Then DO:
     1810          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1811               ub.stk-tot.Fact-date <= x-date-end
     1812               and ub.stk-tot.shift-num = 0
     1813               USE-INDEX fact-date no-lock no-error.
     1814          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1815      END.
     1816      Else DO:
     1817           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1818               (ub.stk-tot.shift-date  = x-date-end and
     1819               ub.stk-tot.shift-num  <= x-shift-end or
     1820               ub.stk-tot.shift-date  < x-date-end       ) and
     1821               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1822               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1823       End.
     1824       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1825     End.
     1826   End.
     1827   END PROCEDURE.
     1828   procedure report-execute :
     1829     if ( valtype=0 and x-base-code=0)  or valtype=1
     1830                                   then   assign tprintrubl = yes .
     1831                                   else   assign tprintrubl = no .
     1832     case print-o :
     1833     when "a4-lansc":u then do:
     1834   output stream outstream to value( string( session:temp-directory +
     1835                                        "rpt" + string( g#report-num ) ) )
     1836                                        page-size  value(43) .
     1837     end.
     1838     when "a4-port":u then do:
     1839   output stream outstream to value( string( session:temp-directory +
     1840                                        "rpt" + string( g#report-num ) ) )
     1841                                        page-size  value(63) .
     1842     end.
     1843     when "a3-lansc":u then do:
     1844   output stream outstream to value( string( session:temp-directory +
     1845                                        "rpt" + string( g#report-num ) ) )
     1846                                        page-size  value(63) .
     1847     end.
     1848     otherwise do:
     1849   output stream outstream to value( string( session:temp-directory +
     1850                                        "rpt" + string( g#report-num ) ) )
     1851                                        page-size  value(43) .
     1852     end.
     1853     end case.
     1854      define variable gj as integer no-undo init 0.
     1855      if xtog-obj  then do:
     1856               for each obj-list no-lock:
     1857                   x-store-type = obj-list.obj-type.
     1858                   x-store-code = obj-list.obj-code.
     1859                   run report-exec1 in this-procedure .
     1860                   gj = gj + 1 .
     1861               end.
     1862              if gj > 1 then   run display-bo in this-procedure .
     1863             end.
     1864     else  run report-exec1 in this-procedure .
     1865     put stream outstream " Время составления отчета " string( ( time - t-time),"hh:mm:ss" ) .
     1866     hide   stream outstream frame zapas .
     1867     hide   stream outstream frame top-frame .
     1868     output stream outstream close.
     1869   if mFrameView
     1870   then do:
     1871      HIDE FRAME InfoFrame.
     1872   end.
     1873     delete widget-pool "my-pool".
     1874     define variable v-user-action as character no-undo .
     1875     define variable v-printed as logical   no-undo .
     1876     define variable DisabledOptions as integer   no-undo .
     1877     case print-o :
     1878         when "a4-lansc":u then do:
     1879           DisabledOptions = 8 .
     1880           end.
     1881         when "a4-port":u then do:
     1882           DisabledOptions = 0 .
     1883           end.
     1884         when "a3-lansc":u then do:
     1885           DisabledOptions = 8 .
     1886                             end.
     1887         otherwise do:
     1888           DisabledOptions = 1 .
     1889             end.
     1890      end case.
     1891      run gbl/prnfilen.w
     1892        ( input  ""
     1893        ,input  DisabledOptions
     1894        ,input  string( session :temp-directory) + "rpt" + string(  g#report-num )
     1895        ,input 7
     1896        ,output v-user-action
     1897        ,output v-printed
     1898        ) .
     1899   end procedure.
     1900   procedure report-exec1 :
     1901      find first ub.clients where x-store-type = ub.clients.obj-type and
     1902                               x-store-code = ub.clients.obj-code no-lock no-error.
     1903              if available ub.clients then  objname = ub.clients.obj-name.
     1904                                            else  objname="объект не определен".
     1905     form with frame zapas .
     1906   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1907   form header
     1908     line format "x(197)" at 1 skip
     1909     "Продолжение - на следующей странице" at 30 skip
     1910     with frame bottomframe width 340 page-bottom no-labels no-box .
     1911   view stream outstream frame bottomframe .
     1912     run calcitog in this-procedure .
     1913     run print-header in this-procedure .
     1914     run run2 in this-procedure .
     1915     run print-det in this-procedure .
     1916     hide stream outstream frame bottomframe .
     1917     run print-footer in this-procedure .
     1918   end procedure.
     1919   procedure run2 :
     1920     for each tmp-gds-tree :
     1921         delete tmp-gds-tree  .
     1922     end.
     1923     case select-good :
     1924         when 1   then do: run run21 in this-procedure .  end.
     1925         when 2   then do: run run22 in this-procedure .  end.
     1926         when 3  then do: run run23 in this-procedure .  end.
     1927          otherwise do:
     1928            run run24 in this-procedure .
     1929          end.
     1930     end case.
     1931   end procedure.
     1932   procedure run21 :
     1933   define variable o-tog-obj as logical no-undo .
     1934   define variable ox-store-type as character no-undo .
     1935   define variable ox-store-code as integer no-undo .
     1936   assign
     1937     o-tog-obj     = xtog-obj
     1938     ox-store-type = x-store-type
     1939     ox-store-code = x-store-code
     1940     xtog-obj = true         .
     1941   define buffer b_gds-obj for ub.gds-obj .
     1942   define buffer b_goods for ub.goods .
     1943   define buffer b_gds-grp for ub.gds-grp .
     1944   define variable n as integer no-undo .
     1945   define variable n-1 as integer no-undo .
     1946      for each obj-list  where
     1947        (  o-tog-obj = false or
     1948           (  obj-list.obj-type = x-store-type and
     1949             obj-list.obj-code = x-store-code ) ) :
     1950             x-store-type = obj-list.obj-type.
     1951             x-store-code = obj-list.obj-code.
     1952         for  each b_gds-obj  no-lock  where
     1953                   b_gds-obj.obj-type = obj-list.obj-type    and
     1954                   b_gds-obj.obj-code = obj-list.obj-code
     1955                   and (  b_gds-obj.last-doc = ? or b_gds-obj.last-doc >= x-date-start or b_gds-obj.fact-qnty <> 0 or b_gds-obj.avrg-qnty <> 0 or b_gds-obj.fact-sale <> 0 or b_gds-obj.fact-base <> 0 )
     1956                   :
     1957           find first  b_goods  no-lock where b_gds-obj.gds-code    = b_goods.gds-code  no-error   .
     1958           find first  b_gds-grp no-lock where b_gds-grp.node-code  = b_goods.grp-code  no-error .
     1959             if available b_goods  and available b_gds-grp then do:
     1960               n = n + 1 .                                                                      find first tmp-gds-tree where  tmp-gds-tree.node-code  = b_gds-grp.node-code no-error .               if not available tmp-gds-tree then do:                                                                create tmp-gds-tree.                                                                                  end.                                                                                                  assign                                                                                                tmp-gds-tree.id  = n                                                                                  tmp-gds-tree.f-name     = b_goods.grp-name                                                            tmp-gds-tree.node-code  = b_gds-grp.node-code                                                         tmp-gds-tree.lvl        = b_gds-grp.lvl-num                                                           tmp-gds-tree.upper-cod  = b_gds-grp.upper-code                                                        .                                                                                                                                                                                     assign                                                                                                gds-zap-artic      = b_goods.artic                                                                    gds-zap-prod-type  = b_goods.prod-type                                                                gds-zap-prod-code  = b_goods.prod-code                                                                gds-zap-type       = b_goods.gds-type                                                                 .                                                                                                     run foreach  in this-procedure .                                                                      do n-1 = 1 to 10 :                                                                             assign                                                                                                tmp-gds-tree.ie        [n-1]  = tmp-gds-tree.ie        [n-1]  + oborot-ie        [n-1]tmp-gds-tree.ee       [n-1]  = tmp-gds-tree.ee       [n-1]  + oborot-ee       [n-1]tmp-gds-tree.ep     [n-1]  = tmp-gds-tree.ep     [n-1]  + oborot-ep     [n-1]tmp-gds-tree.es    [n-1]  = tmp-gds-tree.es    [n-1]  + oborot-es    [n-1]tmp-gds-tree.re    [n-1]  = tmp-gds-tree.re    [n-1]  + oborot-re    [n-1]tmp-gds-tree.rs[n-1] = tmp-gds-tree.rs [n-1]  + oborot-rs[n-1]tmp-gds-tree.we[n-1]  = tmp-gds-tree.we[n-1]  + oborot-we[n-1]tmp-gds-tree.vt [n-1]  = tmp-gds-tree.vt [n-1]  + oborot-vt [n-1]tmp-gds-tree.iv  [n-1]  = tmp-gds-tree.iv  [n-1]  + oborot-iv  [n-1]tmp-gds-tree.ev  [n-1]  = tmp-gds-tree.ev  [n-1]  + oborot-ev  [n-1]tmp-gds-tree.rv  [n-1]  = tmp-gds-tree.rv  [n-1]  + oborot-rv  [n-1]tmp-gds-tree.em  [n-1]  = tmp-gds-tree.em  [n-1]  + oborot-em  [n-1]tmp-gds-tree.wm  [n-1]  = tmp-gds-tree.wm  [n-1]  + oborot-wm  [n-1]tmp-gds-tree.im  [n-1]  = tmp-gds-tree.im  [n-1]  + oborot-im  [n-1]tmp-gds-tree.ot  [n-1]  = tmp-gds-tree.ot  [n-1]  + oborot-ot  [n-1]tmp-gds-tree.pc  [n-1]  = tmp-gds-tree.pc  [n-1]  + oborot-pc  [n-1]tmp-gds-tree.ap  [n-1]  = tmp-gds-tree.ap  [n-1]  + oborot-ap  [n-1]tmp-gds-tree.disc                           [n-1]  = tmp-gds-tree.disc                           [n-1]  + oborot-disc                           [n-1]   tmp-gds-tree.ostatok-start                  [n-1]  = tmp-gds-tree.ostatok-start                  [n-1]  + ostatok-start                         [n-1]   tmp-gds-tree.ostatok-end                    [n-1]  = tmp-gds-tree.ostatok-end                    [n-1]  + ostatok-end                           [n-1]   tmp-gds-tree.oborot-sum-sale                [n-1]  = tmp-gds-tree.oborot-sum-sale                [n-1]  + oborot-sum-sale                        [1]    tmp-gds-tree.oborot-sum-cost                [n-1]  = tmp-gds-tree.oborot-sum-cost               [n-1]  + oborot-sum-cost                        [1]    .              end.
