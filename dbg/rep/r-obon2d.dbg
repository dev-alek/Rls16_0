     2092   procedure print-det :
     2093   define variable n-1 as integer no-undo .
     2094   IF ( i-str modulo v-account = 0 )  then DO:
     2095    Assign
     2096       v-kol-spice = (50 - LENGTH('Суммирование дерева')) / 2
     2097       RecordsString = fill(' ',v-kol-spice) + string('Суммирование дерева')
     2098       .
     2099             if  log-manager:logfile-name ne ?
     2100             then DO:
     2101                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2102             end.
     2103              if mFrameView
     2104              then do:
     2105               DISPLAY
     2106                 i-str @ RecordsDone
     2107                 RecordsString   @ RecordsString
     2108                 WITH FRAME InfoFrame.
     2109              end.
     2110   End.
     2111      if v-button-stop then  DO:
     2112            if mFrameView
     2113            then
     2114               PROCESS EVENTS.
     2115            IF StopProcessing THEN DO:
     2116            RETURN error.
     2117            End.
     2118      end.
     2119       for each tmp-gds no-lock   :
     2120           run clear-b1  in this-procedure .
     2121           for each tmp-gds-tree no-lock
     2122               where (  (  trim( tmp-gds-tree.f-name)  ) begins ( trim( tmp-gds.f-name) ) ) :
     2123                i-str = i-str + 1 .
     2124   IF ( i-str modulo v-account = 0 )  then DO:
     2125    Assign
     2126       v-kol-spice = (50 - LENGTH('Суммирование дерева по группам ')) / 2
     2127       RecordsString = fill(' ',v-kol-spice) + string('Суммирование дерева по группам ')
     2128       .
     2129    Assign
     2130       v-kol-spice = (50 - LENGTH(tmp-gds.f-name)) / 2
     2131       RecordsString2 = fill(' ',v-kol-spice) + string(tmp-gds.f-name)
     2132       .
     2133             if  log-manager:logfile-name ne ?
     2134             then DO:
     2135                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2136             end.
     2137              if mFrameView
     2138              then do:
     2139               DISPLAY
