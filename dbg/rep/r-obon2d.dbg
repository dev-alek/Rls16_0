     3899   assign temp#sum-type.sum-type = 'csdt':U + 'rs':U temp#sum-type.xi = 6 . create temp#sum-type.
     3900   assign temp#sum-type.sum-type = 'csdt':U + 'we':U temp#sum-type.xi = 7 . create temp#sum-type.
     3901   assign temp#sum-type.sum-type = 'csdt':U + 'vt':U temp#sum-type.xi = 8 . create temp#sum-type.
