     3944   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212. create temp#sum-type.
     3945   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213. create temp#sum-type.
