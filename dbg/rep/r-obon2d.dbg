     2160                       b1-oborot-re    [n-1]  = tmp-gds-tree.re    [n-1]  + b1-oborot-re    [n-1]
     2161                       b1-oborot-rs[n-1] = tmp-gds-tree.rs [n-1]  + b1-oborot-rs[n-1]
