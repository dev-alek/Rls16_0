      397   procedure prn-lib-open-stream :
      398     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      399     define input parameter p-page-size    as integer no-undo .
      400     define input parameter p-is-stream    as logical no-undo .
      401     define input parameter p-append       as logical no-undo .
      402     define variable v-report-name as character no-undo .
      403     do
      404       on error undo, return error
      405       :
      406       run prn-lib-get-report-name  in this-procedure (
      407         input parParentProc
      408         ,output v-report-name
      409         ).
      410       if p-is-stream then
      411       do:
      412         if p-append then
      413         do:
      414           output stream PrnLibStream to value( v-report-name )
      415             page-size value(p-page-size) append .
      416         end.
      417         if not p-append then
      418         do:
      419           output stream PrnLibStream to value( v-report-name )
      420             page-size value(p-page-size) .
      421         end.
      422       end.
      423       if not p-is-stream then
      424       do:
      425         if p-append then
      426         do:
      427           output to value( v-report-name )
      428             page-size value(p-page-size) append .
      429         end.
      430         if not p-append then
      431         do:
      432           output to value( v-report-name )
      433             page-size value(p-page-size) .
      434         end.
      435       end.
      436     end.
      437   end procedure.
      438   procedure prn-lib-open-exp :
      439     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      440     define input parameter p-is-stream    as logical no-undo .
      441     define input parameter p-is-append    as logical no-undo .
      442     define output parameter p-ReportFileName as char init "report" no-undo.
      443     define output parameter p-process as logical no-undo .
      444     define variable glog as logical no-undo .
      445     do
      446       on error undo, return error
      447       :
      448       SYSTEM-DIALOG GET-FILE p-ReportFileName
      449         TITLE      "Укажите путь"
      450         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      451         ASK-OVERWRITE
      452         CREATE-TEST-FILE
      453         SAVE-AS
      454         USE-FILENAME
      455         DEFAULT-EXTENSION "txt"
      456         UPDATE glog
      457         .
      458       if not glog then  return.
      459       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      460       if p-is-stream then
      461       do:
      462         if p-is-append then
      463         do:
      464           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      465         end.
      466         else
      467         do:
      468           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      469         end.
      470       end.
      471       else
      472       do:
      473         if p-is-append then
      474         do:
      475           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      476         end.
      477         else
      478         do:
      479           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      480         end.
      481       end.
      482       p-process = yes.
      483     end.
      484   end procedure.
      485   procedure prn-lib-get-report-name :
