      542     define variable v-cntxt-is-admin      as logical   no-undo .
      543   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      544     run mainmenu_getcntxt in p-mainmenu-handle
      545       (output v-cntxt-db-num
      546       ,output v-cntxt-userid
      547       ,output v-cntxt-level
      548       ,output v-cntxt-host-code-obj
      549       ,output v-cntxt-obj-type
      550       ,output v-cntxt-obj-code
      551       ,output v-cntxt-db-num-obj
      552       ,output v-cntxt-is-admin
      553       ) .
      554   run get-report-num in p-mainmenu-handle ( output g#report-num ).
      555   run get-quest-print in p-mainmenu-handle ( output g#quest-print ).
      556       define stream PrnLibStream .
      557       define variable v-line-counter  as integer      no-undo.
      558       define variable v-single-line   as character    no-undo.
      559       define variable v-obj-name      as character    no-undo.
      560       define variable v-cli-name      as character    no-undo.
      561       define variable v-host-name     as character    no-undo.
      562       define variable v-first-line    as logical      no-undo.
      563       define buffer buf_trn-doc   for trn-doc.
      564       define buffer buf1_trn-doc  for trn-doc.
      565       define buffer buf_clients   for clients.
      566       define buffer buf_doc-line  for doc-line.
      567       define buffer buf_parts for parts.
      568       define variable v-qnty as decimal   no-undo .
      569       define variable v-sum as decimal   no-undo .
      570       define variable str-qnty  as character no-undo .
      571       define variable s1  as character no-undo .
      572       define variable s2  as character no-undo .
      573       define variable str  as character no-undo .
      574       find first buf_trn-doc no-lock where recid(buf_trn-doc) = rec_id .
      575       find first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.obj-type and buf_clients.obj-code = buf_trn-doc.obj-code .
      576       assign  v-obj-name = buf_clients.obj-name .
      577       find first buf_clients no-lock where buf_clients.obj-type = 'орг':U and buf_clients.obj-code = buf_trn-doc.host-code .
      578       assign  v-host-name = buf_clients.obj-name .
      579       find first buf_clients no-lock where buf_clients.obj-type = buf_trn-doc.cli-type and buf_clients.obj-code = buf_trn-doc.cli-code .
      580       assign  v-cli-name = buf_clients.obj-name .
      581       assign
      582           v-single-line       = fill( "-", 132 )
      583           v-line-counter      = 0
      584       .
      585   output stream PrnLibStream to value( string( session:temp-directory +
      586                                        "rpt" + string( g#report-num ) ) )
      587                                        page-size  value(62) .
      588   if session :set-wait-state( "compiler" ) then.
      589       for each buf_doc-line no-lock where buf_doc-line.doc-code  = buf_trn-doc.doc-code :
      590         assign
      591           v-line-counter      = v-line-counter    + 1
      592           v-qnty = v-qnty + buf_doc-line.fact-qnty
      593         .
      594       end.
      595       assign v-sum = buf_trn-doc.tot-rubl .
      596       run rep/wp-rub.p ( v-sum, output s1, output s2 ) .
      597       run rep/wp-qnty.p ( input v-qnty , output str-qnty ).
      598       assign str = "по накладной № "  .
      599       define variable v-num as character no-undo .
      600       for each buf_parts no-lock where buf_parts.out-code = buf_trn-doc.doc-code :
      601         if v-num = "" then assign v-num = buf_parts.in-code .
      602         else do:
      603           if v-num <> buf_parts.in-code then do:
      604             assign v-num = "" .
      605             leave .
      606           end.
      607         end.
      608       end.
      609       if v-num <> "" then do:
      610         find first buf1_trn-doc no-lock where buf1_trn-doc.doc-code = v-num no-error .
      611         if available buf1_trn-doc then do:
      612           assign str = str + buf1_trn-doc.doc-code + " от " + string(buf1_trn-doc.doc-date,"99/99/9999") .
      613         end.
      614       end.
      615       put stream PrnLibStream         "ПРЕТЕНЗИЯ"  at 60  skip (2)
      616          space(10)  "<______>  _______________ 20_____ г."      v-cli-name format "X(60)" at 70 skip (2)
      617          space(10)  string(v-host-name + " уведомляет Вас о ненадлежащем качестве товаров, поставленных Вашей организацией")  format "X(120)"   skip
      618          space(10)  str  format "X(120)"       skip
      619          space(10)  "При приемке выявлены следующие недостатки товаров ________________________________________________________________" skip
      620          space(10)  "                                                               (нарушена упаковка товара, ненадлежащее" skip
      621          space(10)  "__________________________________________________________________________________________________________________" skip
      622          space(10)  "качество товара, истек срок реализации товара и т.д.)" skip (2)
      623          space(10)  "В соответствии с условиями договора поставки " v-host-name format "X(60)" skip
      624          space(10)  "возвращает товар в количестве "   string( string(v-qnty) + " (" + str-qnty + ") штук" )  format "X(120)"  skip
      625          space(10)  string("на сумму " + string(v-sum,">>,>>>,>>>,>>>.99") + s2 + " (" + s1 + ")" )   format "X(120)"                       skip (2)
      626          space(10)  "Уполномоченный представитель" skip
      627          space(10)  v-host-name   format "X(60)"    "___________  ______________________" at 80 skip
      628                                                     "  подпись     расшифровка подписи"   at 80 skip  (2)
      629                                                     "            Место печати, штампа"    at 90 skip  (2)
      630          space(10)  "Претензия получена:"           "___________  ______________________" at 80 skip
      631                                                     "  подпись     расшифровка подписи"   at 80 skip  (2)
      632       .
      633       put stream PrnLibStream         "ПРЕТЕНЗИЯ"  at 60  skip (2)
      634          space(10)  "<______>  _______________ 20_____ г."      v-cli-name format "X(60)" at 70 skip (2)
      635          space(10)  string(v-host-name + " уведомляет Вас о ненадлежащем качестве товаров, поставленных Вашей организацией")  format "X(120)"   skip
      636          space(10)  str  format "X(120)"       skip
      637          space(10)  "При приемке выявлены следующие недостатки товаров ________________________________________________________________" skip
      638          space(10)  "                                                               (нарушена упаковка товара, ненадлежащее" skip
      639          space(10)  "__________________________________________________________________________________________________________________" skip
      640          space(10)  "качество товара, истек срок реализации товара и т.д.)" skip (2)
      641          space(10)  "В соответствии с условиями договора поставки " v-host-name format "X(60)" skip
      642          space(10)  "возвращает товар в количестве "   string( string(v-qnty) + " (" + str-qnty + ") штук" )  format "X(120)"  skip
      643          space(10)  string("на сумму " + string(v-sum,">>,>>>,>>>,>>>.99") + s2 + " (" + s1 + ")" )   format "X(120)"                       skip (2)
      644          space(10)  "Уполномоченный представитель" skip
      645          space(10)  v-host-name   format "X(60)"    "___________  ______________________" at 80 skip
      646                                                     "  подпись     расшифровка подписи"   at 80 skip  (2)
      647                                                     "            Место печати, штампа"    at 90 skip  (2)
      648          space(10)  "Претензия получена:"           "___________  ______________________" at 80 skip
      649                                                     "  подпись     расшифровка подписи"   at 80 skip  (2)
      650       .
      651       hide stream PrnLibStream frame BottomFrame .
      652       output stream PrnLibStream close.
      653   if session :set-wait-state( "" ) then.
      654   if g#quest-print = false
      655   then do:
      656     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      657                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      658                                         OUTPUT g#log ).
      659   end.
      660   else do:
      661     os-command silent
      662       value( "COPY /b " +
      663         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      664         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      665         string( session:temp-directory) +  "$" + string( g#report-num )
      666                 ) .
      667     os-command silent
      668       value( "COPY /b " +
      669         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      670         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      671         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      672                 ) .
      673   end.
