      495   procedure prn-lib-reportviewer :
      496     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      497     define input parameter p-report-name-html as character no-undo .
      498     define input parameter p-param        as character no-undo .
      499     define variable v-excel           as character no-undo init 'TRUE' .
      500     define variable v-value-character as character no-undo .
      501     define variable v-value-integer   as character no-undo .
      502     define variable v-value-date      as date      no-undo .
      503     define variable v-value-decimal   as decimal   no-undo .
      504     define variable rep-excel         as logical   no-undo .
      505     define variable excel-string      as character no-undo .
      506     define variable v-param-type      as character no-undo .
      507     define variable v-tth             as handle    no-undo .
      508     run adm/shattri.p (
      509       input "get":U
      510       ,input  ""
      511       ,input  0
      512       ,input  'report-glob':U
      513       ,input  'rep-excel':U
      514       ,output v-value-character
      515       ,output v-value-date
      516       ,output v-value-decimal
      517       ,output v-value-integer
      518       ,output rep-excel
      519       ,output v-param-type
      520       ,INPUT-OUTPUT table-handle v-tth
      521       )  .
      522     if rep-excel then v-excel = "TRUE" .
      523     else v-excel = "FALSE" .
      524     if p-param eq ""
      525     then
      526        p-param = "EXCEL:" + v-excel.
      527     else
      528        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      529     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      530   end procedure.
