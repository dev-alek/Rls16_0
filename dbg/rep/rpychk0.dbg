     5348                   buf_temp-chk-gds2.doc-code = ub.chk-doc.doc-code
     5349               and buf_temp-chk-gds2.line-num  =  temp-chk-dp.line-num no-error.
     5350               if available buf_temp-chk-gds2 then
     5351               for each buf_temp-chk-gds where
     5352                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     5353                   and buf_temp-chk-gds.line-num ne 0
     5354               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     5355                    if         temp-chk-dp.all-sum  eq ?
     5356                       or abs(temp-chk-dp.all-sum) <= 0.001
     5357                   then
     5358                      next dp.
     5359                   find first  temp-chk-gds where
     5360                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     5361                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     5362                     and temp-chk-gds.line-num = 0
     5363                   no-error .
     5364                   if not available temp-chk-gds then next dp.
     5365                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     5366                       when 1 then do:
