     4770              vPromoLineNum = GetPromoPriceLine(ub.chk-doc.doc-code).
     4771           else vPromoLineNum = 0.
     4772           for each buf_temp-chk-gds where
     4773                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     4774               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     4775               and buf_temp-chk-gds.line-num  > 0
     4776           by buf_temp-chk-gds.doc-code
     4777           by buf_temp-chk-gds.rec-type descending
     4778           by buf_temp-chk-gds.line-num
     4779            :
