     3966                     .
     3967                   assign
     3968                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3969                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     3970                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     3971                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     3972                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     3973                   .
     3974                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     3975               end.
     3976           end.
     3977         assign
     3978         pychk_dop-sump = temp-chk-pay.tot-r-b
     3979         pychk_exch = if pychk_No-exch then 1
     3980                      else (if temp-chk-pay.tot-base = 0
     3981                            then 0
     3982                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3983         pychk_exch-rubl = if pychk_No-exch-rubl
     3984                           then 1
     3985                           else (if temp-chk-pay.tot-base = 0
     3986                                 then 0
     3987                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     3988         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     3989         .
     3990         _repeat:
     3991         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     3992           if pychk_dop-sumg = 0 then do:
     3993             assign
     3994             pychk_kk = pychk_kk + 1
     3995             .
