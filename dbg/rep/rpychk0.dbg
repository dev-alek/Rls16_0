     5746         else v-err-msg = "AppError в модуле c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\gbl\catcherr.i" .
     5747       end .
     5748     end catch .
     5749     catch exProErrors as class Progress.Lang.ProError :
     5750       v-err-msg = exProErrors:GetMessage(1) .
     5751       if v-err-msg > ""
