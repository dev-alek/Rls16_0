     1780                     buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     1781                     buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     1782                     buf_chk-gds-pay.line-type = pychk_line-type-chr
     1783                     buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     1784                     buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     1785                     buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     1786                     buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     1787                     buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     1788                     buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     1789                     buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     1790                     buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     1791                     buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     1792                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     1793                     .
     1794                   assign
     1795                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     1796                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     1797                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     1798                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     1799                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     1800                   .
     1801                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     1802               end.
     1803           end.
     1804         assign
     1805         pychk_dop-sump = temp-chk-pay.tot-r-b
     1806         pychk_exch = if pychk_No-exch then 1
     1807                      else (if temp-chk-pay.tot-base = 0
     1808                            then 0
     1809                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     1810         pychk_exch-rubl = if pychk_No-exch-rubl
     1811                           then 1
     1812                           else (if temp-chk-pay.tot-base = 0
     1813                                 then 0
     1814                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     1815         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     1816         .
     1817         _repeat:
     1818         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     1819           if pychk_dop-sumg = 0 then do:
     1820             assign
     1821             pychk_kk = pychk_kk + 1
     1822             .
     1823             if pychk_kk >= pychk_jj then LEAVE _repeat.
     1824             if pychk_kk <= pychk_jjp then do:
     1825               find first temp-chk-gds where
     1826                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1827                     and temp-chk-gds.jjp_ = pychk_kk
     1828                     and temp-chk-gds.line-num = 0
     1829                   no-error .
     1830             end.
     1831             else do:
     1832               find first temp-chk-gds where
     1833                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1834                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     1835                     and temp-chk-gds.line-num = 0
     1836                   no-error .
     1837             end.
     1838             if not available temp-chk-gds
     1839             or (temp-chk-gds.sum = 0
     1840                 or
     1841                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     1842                 )
     1843             then do:
     1844               NEXT _repeat.
     1845             end.
     1846             assign
     1847             pychk_dop-sumg = if available temp-chk-gds then temp-chk-gds.sum else 0
     1848             temp-chk-gds.flag = yes
     1849             .
     1850           end.
     1851           assign
     1852           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     1853           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     1854           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     1855           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     1856           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     1857           .
     1858           if pychk_sum-promo <> 0 then
     1859              vPromoLineNum = GetPromoPriceLine(ub.chk-doc.doc-code).
     1860           else vPromoLineNum = 0.
     1861           for each buf_temp-chk-gds where
     1862                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1863               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     1864               and buf_temp-chk-gds.line-num  > 0
     1865           by buf_temp-chk-gds.doc-code
     1866           by buf_temp-chk-gds.rec-type descending
     1867           by buf_temp-chk-gds.line-num
     1868            :
     1869             case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     1870               when 1 then do:
     1871                 pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     1872               end.
     1873               when 2 then do:
     1874                 pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     1875               end.
     1876             end case.
     1877             if  vPromoLineNum <> 0 and
     1878                 temp-chk-gds.num-lines > 1 and
     1879                 buf_temp-chk-gds.line-num = vPromoLineNum and
     1880                 can-find(first buf_chk-gds-pay no-lock where
     1881                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     1882                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     1883             then .
     1884             else
     1885             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     1886                 if vPromoLineNum <> 0 and
     1887                    buf_temp-chk-gds.line-num = vPromoLineNum
     1888                 then do:
     1889                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     1890                 end.
     1891                 else if vPromoLineNum <> 0 and
     1892                         temp-chk-gds.num-lines > 1 and
     1893                         pychk_sum-promo <> 0 and
     1894                         ChkPromoLine(buf_temp-chk-gds.doc-code, buf_temp-chk-gds.line-num)
     1895                 then do:
     1896                     if can-find(first buf_chk-gds-pay no-lock where
     1897                                       buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1898                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     1899                                   )
     1900                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     1901                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     1902                 end.
     1903                 else
