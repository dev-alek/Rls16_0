       12   define variable vss-revision    as character no-undo init "$Revision: 245fc987699b, 3203, rls $":U .
       13   define variable vss-author      as character no-undo init "$Author: EShklyar $":U .
       14   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:28 $":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile: rpychk0.p $":U .
