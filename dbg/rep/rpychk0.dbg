     5551                     and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     5552                     and buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card exclusive-lock no-error.
     5553                     if not available buf_chk-gds-pay then do:
     5554                        if can-find (first buf_chk-gds-pay no-lock where
     5555                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     5556                                  and buf_chk-gds-pay.algo-num = "1.8"
     5557                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     5558                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     5559                                      )
     5560                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     5561                                                       , temp-chk-pay.doc-code
     5562                                                       , ub.chk-doc.obj-type
     5563                                                       , ub.chk-doc.obj-code
     5564                                                       , buf_temp-chk-gds.line-num
     5565                                                       , temp-chk-pay.line-num).
     5566                        create buf_chk-gds-pay.
     5567                     end.
     5568                 end.
     5569                 else do:
     5570                      if can-find (first buf_chk-gds-pay no-lock where
     5571                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     5572                                  and buf_chk-gds-pay.algo-num = "1.8"
     5573                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     5574                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     5575                                      )
     5576                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     5577                                                       , temp-chk-pay.doc-code
     5578                                                       , ub.chk-doc.obj-type
     5579                                                       , ub.chk-doc.obj-code
     5580                                                       , buf_temp-chk-gds.line-num
     5581                                                       , temp-chk-pay.line-num).
     5582                      create buf_chk-gds-pay.
     5583                 end.
