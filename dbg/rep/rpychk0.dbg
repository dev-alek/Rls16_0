     5427                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     5428                     .
     5429                   assign
     5430                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     5431                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     5432                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     5433                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     5434                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     5435                   .
     5436                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     5437               end.
     5438           end.
     5439         assign
     5440         pychk_dop-sump = temp-chk-pay.tot-r-b
     5441         pychk_exch = if pychk_No-exch then 1
     5442                      else (if temp-chk-pay.tot-base = 0
     5443                            then 0
     5444                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     5445         pychk_exch-rubl = if pychk_No-exch-rubl
     5446                           then 1
     5447                           else (if temp-chk-pay.tot-base = 0
     5448                                 then 0
     5449                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     5450         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     5451         .
     5452         _repeat:
     5453         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     5454           if pychk_dop-sumg = 0 then do:
     5455             assign
     5456             pychk_kk = pychk_kk + 1
     5457             .
     5458             if pychk_kk >= pychk_jj then LEAVE _repeat.
     5459             if pychk_kk <= pychk_jjp then do:
     5460               find first temp-chk-gds where
     5461                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     5462                     and temp-chk-gds.jjp_ = pychk_kk
