     4627               for each buf_temp-chk-gds where
     4628                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     4629                   and buf_temp-chk-gds.line-num ne 0
     4630               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     4631                    if         temp-chk-dp.all-sum  eq ?
     4632                       or abs(temp-chk-dp.all-sum) <= 0.001
     4633                   then
     4634                      next dp.
     4635                   find first  temp-chk-gds where
     4636                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     4637                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     4638                     and temp-chk-gds.line-num = 0
     4639                   no-error .
     4640                   if not available temp-chk-gds then next dp.
     4641                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     4642                       when 1 then do:
     4643                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     4644                       end.
     4645                       when 2 then do:
     4646                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     4647                       end.
     4648                   end case.
     4649                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     4650                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     4651                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     4652                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     4653                   then
     4654                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     4655                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     4656                   if can-find (first buf_chk-gds-pay no-lock where
     4657                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4658                                  and buf_chk-gds-pay.algo-num = "1.8"
