     5310       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     5311       .
     5312     end.
     5313     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     5314     if last-of(ub.chk-pay.doc-code) then do:
     5315       for each temp-chk-pay where
     5316               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     5317          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     5318             and temp-chk-pay.tot-r-b <> 0
     5319             and abs(ub.chk-doc.netto) > 0.00000001
     5320          then do:
     5321             if not g#auto then do:
     5322                message
     5323                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     5324                             ,ub.chk-doc.doc-code
     5325                             ,chr(10)
     5326                             ,ub.chk-doc.obj-type
     5327                             ,ub.chk-doc.obj-code
     5328                             ,ub.chk-doc.shift-date
     5329                             ,ub.chk-doc.shift-num
     5330                             ,ub.chk-doc.pay-desk
     5331                             ,ub.chk-doc.chk-num)
     5332                   view-as alert-box error .
     5333             end.
     5334             next _chk-doc.
     5335          end.
     5336       end.
     5337       for each temp-chk-pay where
     5338               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     5339       break
     5340       by temp-chk-pay.pet-good descending
     5341       by temp-chk-pay.line-num:
     5342          dp:
     5343          for each temp-chk-dp no-lock
     5344             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     5345               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     5346               and temp-chk-dp.sum <> 0 :
