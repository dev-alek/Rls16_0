     2604                 can-find(first buf_chk-gds-pay no-lock where
     2605                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     2606                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     2607             then .
     2608             else
     2609             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     2610                 if vPromoLineNum <> 0 and
     2611                    buf_temp-chk-gds.line-num = vPromoLineNum
     2612                 then do:
     2613                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     2614                 end.
     2615                 else if vPromoLineNum <> 0 and
     2616                         temp-chk-gds.num-lines > 1 and
