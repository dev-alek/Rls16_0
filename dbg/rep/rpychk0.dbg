     5483             temp-chk-gds.flag = yes
     5484             .
     5485           end.
     5486           assign
     5487           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     5488           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     5489           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     5490           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     5491           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     5492           .
