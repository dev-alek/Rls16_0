     1920                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1921                                  and buf_chk-gds-pay.algo-num = "1.8"
     1922                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1923                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1924                                      )
     1925                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1926                                                       , temp-chk-pay.doc-code
     1927                                                       , ub.chk-doc.obj-type
     1928                                                       , ub.chk-doc.obj-code
     1929                                                       , buf_temp-chk-gds.line-num
     1930                                                       , temp-chk-pay.line-num).
     1931                        create buf_chk-gds-pay.
     1932                     end.
     1933                 end.
     1934                 else do:
     1935                      if can-find (first buf_chk-gds-pay no-lock where
     1936                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1937                                  and buf_chk-gds-pay.algo-num = "1.8"
     1938                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1939                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1940                                      )
     1941                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1942                                                       , temp-chk-pay.doc-code
     1943                                                       , ub.chk-doc.obj-type
     1944                                                       , ub.chk-doc.obj-code
     1945                                                       , buf_temp-chk-gds.line-num
     1946                                                       , temp-chk-pay.line-num).
     1947                      create buf_chk-gds-pay.
     1948                 end.
     1949                 assign
     1950                 buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1951                 buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     1952                 buf_chk-gds-pay.algo-num = "1.8"
     1953                 buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     1954                 buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     1955                 buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1956                 buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     1957                 buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     1958                 buf_chk-gds-pay.tot-r-b = buf_chk-gds-pay.tot-r-b  + vSum
     1959                 buf_chk-gds-pay.eff-base-rate = pychk_exch
     1960                 buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     1961                 buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     1962                 buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     1963                 buf_chk-gds-pay.price-base = buf_temp-chk-gds.price-base
     1964                 buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
