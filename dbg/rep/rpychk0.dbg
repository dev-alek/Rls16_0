      788   define temp-table temp-ptrl-goods no-undo
      789   field b-code as integer
      790   field gds-code as integer
      791   field ptrl-good as logical
      792   index pi as unique primary
      793   b-code
      794   .
      795   define buffer buf_temp-chk-gds for temp-chk-gds.
      796   define buffer buf_temp-chk-gds2 for temp-chk-gds.
      797   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
      798   define buffer buf2_chk-doc for ub.chk-doc.
      799   define buffer buf_bar-code for ub.bar-code.
      800   define buffer buf_chk-pay-attr for ub.chk-pay-attr .
      801   function ChkGdsPromo returns logical
      802       (input iDocCode as character)
      803       :
      804       define buffer buf_chk-gds for ub.chk-gds.
      805       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      806       define variable vPromo as logical no-undo.
      807       vPromo = no.
      808       cspr:
      809       for each buf_chk-gds no-lock where
      810                    buf_chk-gds.doc-code = iDocCode,
      811              first buf_chk-gds-attr no-lock where
      812                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      813                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      814                and buf_chk-gds-attr.attr-code = "CSPromo"
      815                and buf_chk-gds-attr.attr-value <> "0":
      816          vPromo = yes.
      817          leave cspr.
      818       end.
      819       return vPromo.
      820   end.
      821   function ChkPromoLine returns logical
      822       (input iDocCode as character,
      823       input iLineNum as integer)
      824       :
      825       define buffer buf_chk-gds for ub.chk-gds.
      826       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      827       define variable vPromo as logical no-undo.
      828       vPromo = no.
      829       find first buf_chk-gds-attr no-lock where
      830                    buf_chk-gds-attr.doc-code = iDocCode
      831                and buf_chk-gds-attr.line-num  = iLineNum
      832                and buf_chk-gds-attr.attr-code = "CSPromo"
      833                and buf_chk-gds-attr.attr-value <> "0"
      834       no-error.
      835       if avail buf_chk-gds-attr then vPromo = yes.
      836       return vPromo.
      837   end.
      838   function ChkPromoSum returns decimal
      839       (input iDocCode as character,
      840        input iLineNum as integer)
      841       :
      842      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      843      define variable vSumPromo as decimal no-undo.
      844      find first buf_chk-gds-attr no-lock where
      845                 buf_chk-gds-attr.doc-code = iDocCode
      846             and buf_chk-gds-attr.line-num  = iLineNum
      847             and buf_chk-gds-attr.attr-code = "CSPromoSum"
      848         no-error.
      849      if avail buf_chk-gds-attr then
      850         vSumPromo = DEC(buf_chk-gds-attr.attr-value) no-error.
      851      return vSumPromo.
      852   end function.
      853   function ChkPromoPrice returns logical
      854       (input iDocCode as character,
      855        input iLineNum as integer)
      856       :
      857      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      858      define variable v-is-promo as logical no-undo.
      859      v-is-promo = no.
      860      find first buf_chk-gds-attr no-lock where
      861                 buf_chk-gds-attr.doc-code = iDocCode
      862             and buf_chk-gds-attr.line-num  = iLineNum
      863             and buf_chk-gds-attr.attr-code = "CSPromo"
      864         no-error.
      865      if avail buf_chk-gds-attr
      866        and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      867      then v-is-promo = yes.
      868      return v-is-promo.
      869   end function.
      870   function ChkDopLitr returns logical
      871       (input iDocCode as character,
      872        input iLineNum as integer)
      873       :
      874      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      875      define variable v-is-promo as logical no-undo.
      876      v-is-promo = no.
      877      find first buf_chk-gds-attr no-lock where
      878                 buf_chk-gds-attr.doc-code = iDocCode
      879             and buf_chk-gds-attr.line-num  = iLineNum
      880             and buf_chk-gds-attr.attr-code = "CSPromo"
      881         no-error.
      882      if avail buf_chk-gds-attr and
      883        buf_chk-gds-attr.attr-value = "3"
      884      then v-is-promo = yes.
      885      return v-is-promo.
      886   end function.
      887   function RoundUp return decimal
      888       (input iQnty as decimal,
      889        input iPrice as decimal):
      890       def var vSum  as decimal no-undo.
      891       def var vSumR as decimal no-undo.
      892       vSum = ABSOLUTE(iQnty) * iPrice.
      893       vSumR = Round(vSum,2).
      894       if vSumR < vSum then vSumR = vSumR + 0.01.
      895       if iQnty < 0 then vSumR = - vSumR.
      896       return vSumR.
      897   end function.
      898   function GetPromoSum returns decimal
      899       (input iDocCode as character)
      900       :
      901       define buffer buf_chk-doc for ub.chk-doc.
      902       define buffer buf2_chk-doc for ub.chk-doc.
      903       define buffer buf_chk-gds for ub.chk-gds.
      904       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
      905       define buffer buf2_chk-gds for ub.chk-gds.
      906       define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
      907       define variable v-price-base as decimal no-undo.
      908       define variable v-doc-qnty as decimal no-undo.
      909       define variable v-sum-base as decimal no-undo.
      910       define variable v-sum-all as decimal no-undo.
      911       define variable v-sum-promo as decimal no-undo.
      912       define variable v-sum-chk as decimal no-undo.
      913       assign
      914          v-price-base = 0
      915          v-doc-qnty = 0
      916          v-sum-all = 0
      917          v-sum-chk = 0
      918          v-sum-promo = 0
      919          .
      920       for each buf_chk-gds no-lock where
      921                buf_chk-gds.doc-code = iDocCode,
      922          first buf_chk-gds-attr no-lock where
      923                buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      924            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      925            and buf_chk-gds-attr.attr-code = "CSPromoSum"
      926          :
      927          v-sum-promo = Dec(buf_chk-gds-attr.attr-value).
      928       end.
      929       if v-sum-promo = 0 then do:
      930           for each buf_chk-gds no-lock where
      931                    buf_chk-gds.doc-code = iDocCode,
      932              first buf_chk-gds-attr no-lock where
      933                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      934                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      935                and buf_chk-gds-attr.attr-code = "CSPromo"
      936                and can-do("1,6", buf_chk-gds-attr.attr-value)
      937              :
      938              assign
      939                v-price-base = buf_chk-gds.price-base
      940                v-doc-qnty   = if buf_chk-gds.doc-qnty = ? then buf_chk-gds.src-qnty else buf_chk-gds.doc-qnty
      941                v-sum-base = if buf_chk-gds.sum-base = ? then round(v-doc-qnty * v-price-base, 2) else buf_chk-gds.sum-base
      942                .
      943           end.
      944           for each buf_chk-gds no-lock where
      945                    buf_chk-gds.doc-code = iDocCode,
      946              first buf_chk-gds-attr no-lock where
      947                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
      948                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
      949                and buf_chk-gds-attr.attr-code = "CSPromo"
      950                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
      951              :
      952              if v-price-base = 0 then do:
      953                 find first buf_chk-doc no-lock where
      954                            buf_chk-doc.doc-code = iDocCode
      955                     no-error.
      956                 if avail buf_chk-doc and
      957                    buf_chk-doc.chk-type = int('6':U) and
      958                    buf_chk-doc.doc-num2 > ""  and
      959                    num-entries(buf_chk-doc.doc-num2,":") = 2
      960                 then
      961                 for first buf2_chk-doc no-lock where
      962                           buf2_chk-doc.obj-code = buf_chk-doc.obj-code
      963                       and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
      964                       and buf2_chk-doc.chk-type = int('1':U)
      965                       and buf2_chk-doc.chk-num = int(entry(1,buf_chk-doc.doc-num2,":"))
      966                       and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
      967                       :
      968                   for each buf2_chk-gds no-lock where
      969                            buf2_chk-gds.doc-code = buf2_chk-doc.doc-code,
      970                      first buf2_chk-gds-attr no-lock where
      971                            buf2_chk-gds-attr.doc-code = buf2_chk-gds.doc-code
      972                        and buf2_chk-gds-attr.line-num  = buf2_chk-gds.line-num
      973                        and buf2_chk-gds-attr.attr-code = "CSPromo"
      974                        and can-do("1,6", buf2_chk-gds-attr.attr-value)
      975                      :
      976                       v-price-base = buf2_chk-gds.price-base.
      977                   end.
      978                 end.
      979              end.
      980              if buf_chk-gds.sum-base = ? or buf_chk-gds.src-qnty = 0 then do:
      981                  assign
      982                     v-sum-all = (buf_chk-gds.src-qnty + v-doc-qnty) * v-price-base
      983                     v-sum-chk = v-sum-base + RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price)
      984                     .
      985              end.
      986              else do:
      987                 assign
      988                 v-sum-all = (buf_chk-gds.doc-qnty + v-doc-qnty ) * v-price-base
      989                 v-sum-chk = v-sum-base + buf_chk-gds.sum-base
      990                 .
      991              end.
      992           end.
      993           v-sum-promo = Round(v-sum-all, 2) - Round(v-sum-chk, 2).
      994       end.
      995       return v-sum-promo.
      996   end function.
      997   function GetUnBaseSum returns decimal
      998       (input iDocCode as character,
      999        input iLineNum as integer,
     1000        input iQnty as decimal,
     1001        input iPrice as decimal):
     1002      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1003      define variable vBaseSum as decimal no-undo.
     1004      define variable vDiscSum as decimal no-undo.
     1005      vDiscSum = 0.
     1006      find first buf_chk-gds-attr no-lock where
     1007                        buf_chk-gds-attr.doc-code = iDocCode
     1008                    and buf_chk-gds-attr.line-num  = iLineNum
     1009                    and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1010             no-error.
     1011      if avail buf_chk-gds-attr then
     1012         vDiscSum = dec(buf_chk-gds-attr.attr-value) no-error.
     1013      vBaseSum = iQnty * iPrice + vDiscSum.
     1014      if vDiscSum = 0 and ChkPromoPrice(iDocCode, iLineNum) then
     1015         vBaseSum = RoundUp(iQnty, iPrice).
     1016      return vBaseSum.
     1017   end function.
     1018   function GetRoundSum returns decimal
     1019       (input iDocCode as character,
     1020        input iLineNum as integer,
     1021        input iQnty as decimal,
     1022        input iPrice as decimal):
     1023      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1024      define variable vBaseSum as decimal no-undo.
     1025      if ChkPromoPrice(iDocCode, iLineNum) then
     1026         vBaseSum = RoundUp(iQnty, iPrice).
     1027      else vBaseSum = iQnty * iPrice.
     1028      return vBaseSum.
     1029   end function.
     1030   function GetRoundSumChkDel returns decimal
     1031       (input iDocCode as character,
     1032        input iLineNum as integer,
     1033        input iChipNum as integer,
     1034        input iQnty as decimal,
     1035        input iPrice as decimal):
     1036      define buffer  buf_c-chk-doc-attr for ub.c-chk-doc-attr.
     1037      define variable vBaseSum as decimal no-undo.
     1038      define variable vIsPromo as logical no-undo.
     1039      for each buf_c-chk-doc-attr no-lock where
     1040               buf_c-chk-doc-attr.doc-code = iDocCode
     1041           and buf_c-chk-doc-attr.chip-num = iChipNum
     1042          :
     1043          if num-entries(buf_c-chk-doc-attr.attr-code, chr(4)) > 1
     1044          then do :
     1045            if entry(1, buf_c-chk-doc-attr.attr-code, chr(4)) begins "gds="
     1046            and entry(2, buf_c-chk-doc-attr.attr-code, chr(4)) = "CSPromo"
     1047            and entry(2, entry(1, buf_c-chk-doc-attr.attr-code, chr(4)), "=") = String(iLineNum)
     1048            and can-do("2,4,5,7", buf_c-chk-doc-attr.attr-value)
     1049            then vIsPromo = yes.
     1050          end.
     1051      end.
     1052      if ChkPromoPrice(iDocCode, iLineNum) then
     1053         vBaseSum = RoundUp(iQnty, iPrice).
     1054      else vBaseSum = iQnty * iPrice.
     1055      return vBaseSum.
     1056   end function.
     1057   function GetSaleRetDisc returns decimal
     1058       (input iDocCode as character,
     1059        input iSaleCode as character):
     1060      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1061      define buffer buf_chk-gds for ub.chk-gds.
     1062      define variable vQntyPromoRet as decimal no-undo.
     1063      define variable vQntyPromoSel as decimal no-undo.
     1064      define variable vDiscSumRet   as decimal no-undo.
     1065      define variable vDiscSumSale  as decimal no-undo.
     1066      vDiscSumRet = 0.
     1067      cspr:
     1068      for each  buf_chk-gds no-lock where
     1069                buf_chk-gds.doc-code = iDocCode,
     1070          first buf_chk-gds-attr no-lock where
     1071                buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1072            and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1073            and buf_chk-gds-attr.attr-code = "CSPromo"
     1074            and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1075          :
     1076          vQntyPromoRet = buf_chk-gds.src-qnty.
     1077          leave cspr.
     1078      end.
     1079      if vQntyPromoRet <> 0 then
     1080      for each  buf_chk-gds no-lock where
     1081                buf_chk-gds.doc-code = iSaleCode:
     1082          find first buf_chk-gds-attr no-lock where
     1083                     buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1084                 and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1085                 and buf_chk-gds-attr.attr-code = "CSPromo"
     1086          no-error.
     1087          if avail buf_chk-gds-attr
     1088               and can-do("2,4,5,7", buf_chk-gds-attr.attr-value)
     1089          then
     1090            vQntyPromoSel = buf_chk-gds.src-qnty.
     1091          find first buf_chk-gds-attr no-lock where
     1092                    buf_chk-gds-attr.doc-code  = buf_chk-gds.doc-code
     1093                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1094                and buf_chk-gds-attr.attr-code = "CSPromoSum"
     1095          no-error.
     1096          if avail buf_chk-gds-attr then
     1097             vDiscSumSale = dec(buf_chk-gds-attr.attr-value) no-error.
     1098      end.
     1099      if vQntyPromoRet <> 0 and
     1100         vQntyPromoSel = -1 * vQntyPromoRet
     1101      then vDiscSumRet = -1 * vDiscSumSale.
     1102      return vDiscSumRet.
     1103   end function.
     1104   function SetPromoDisc return logical
     1105    (input iDocCode as character,
     1106        input iLineNum as integer
     1107        )
     1108       :
     1109      define buffer buf_chk-doc for ub.chk-doc.
     1110      define buffer buf2_chk-doc for ub.chk-doc.
     1111      define buffer buf_chk-gds for ub.chk-gds.
     1112      define buffer buf2_chk-gds for ub.chk-gds.
     1113      define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1114      define buffer buf2_chk-gds-attr for ub.chk-gds-attr.
     1115      define buffer buf_chk-discnt for ub.chk-discnt.
     1116      define buffer buf2_chk-discnt for ub.chk-discnt.
     1117      define buffer buf_chk-discnt-attr for ub.chk-discnt-attr.
     1118      define buffer buf2_chk-discnt-attr for ub.chk-discnt-attr.
     1119      define variable v-promo-sum as decimal no-undo.
     1120      define variable v-disc-promo-id as character no-undo.
     1121      define variable var-discnt-id as integer no-undo.
     1122      define variable v-chk-sale as character no-undo.
     1123      find first buf_chk-gds-attr no-lock where
     1124                 buf_chk-gds-attr.doc-code = iDocCode
     1125             and buf_chk-gds-attr.line-num  = iLineNum
     1126             and buf_chk-gds-attr.attr-code = "CSPromo"
     1127         no-error.
     1128      if avail buf_chk-gds-attr
     1129        then do:
     1130        find first buf_chk-discnt no-lock where
     1131                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1132               and buf_chk-discnt.line-num = buf_chk-gds-attr.line-num
     1133               and buf_chk-discnt.record-type = 0
     1134               and buf_chk-discnt.promo-id > ""
     1135               no-error.
     1136        if not avail buf_chk-discnt then do:
     1137           find first buf_chk-doc no-lock where
     1138                      buf_chk-doc.doc-code = iDocCode
     1139              no-error.
     1140           find first buf_chk-gds no-lock where
     1141                      buf_chk-gds.doc-code = iDocCode
     1142                 and  buf_chk-gds.line-num = iLineNum
     1143              no-error.
     1144          for first buf2_chk-doc no-lock where
     1145                    buf2_chk-doc.obj-code = buf_chk-doc.obj-code
     1146                and buf2_chk-doc.obj-type = buf_chk-doc.obj-type
     1147                and buf2_chk-doc.pay-desk = buf_chk-doc.pay-desk
     1148                and buf2_chk-doc.chk-type = int('1':U)
     1149                and buf2_chk-doc.chk-num  = int(entry(1,buf_chk-doc.doc-num2,":"))
     1150                and buf2_chk-doc.z-number = int(entry(2, buf_chk-doc.doc-num2,":"))
     1151              :
     1152              find first buf2_chk-gds no-lock where
     1153                         buf2_chk-gds.doc-code = buf2_chk-doc.doc-code
     1154                    and  buf2_chk-gds.b-code   = buf_chk-gds.b-code
     1155              no-error.
     1156              if not avail buf2_chk-gds then return no.
     1157              v-chk-sale = buf2_chk-doc.doc-code.
     1158              find first buf_chk-discnt no-lock where
     1159                         buf_chk-discnt.doc-code =  buf2_chk-doc.doc-code and
     1160                         buf_chk-discnt.record-type = 1 and
     1161                         buf_chk-discnt.object-line-num = buf2_chk-gds.line-num and
     1162                         buf_chk-discnt.promo-id > ""
     1163              no-error .
     1164              if avail buf_chk-discnt
     1165              then do:
     1166                 v-disc-promo-id = buf_chk-discnt.promo-id.
     1167                 find first buf2_chk-discnt no-lock where
     1168                   buf2_chk-discnt.doc-code = iDocCode and
     1169                   buf2_chk-discnt.record-type = 5 and
     1170                   buf2_chk-discnt.line-num = 0 and
     1171                   buf2_chk-discnt.promo-id =  v-disc-promo-id
     1172                 no-error.
     1173                 find first buf2_chk-discnt-attr no-lock where
     1174                            buf2_chk-discnt-attr.doc-code = iDocCode and
     1175                            buf2_chk-discnt-attr.record-type = 5 and
     1176                            buf2_chk-discnt-attr.line-num = 0 and
     1177                            buf2_chk-discnt-attr.attr-code = "promo-id" and
     1178                            buf2_chk-discnt-attr.attr-value = v-disc-promo-id
     1179                       no-error .
     1180                 if not avail buf2_chk-discnt
     1181                 then do:
     1182                     for each buf_chk-discnt no-lock where
     1183                              buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1184                          and buf_chk-discnt.record-type = 5:
     1185                          var-discnt-id  = var-discnt-id + 1.
     1186                     end.
     1187                     create buf2_chk-discnt.
     1188                     assign
     1189                       buf2_chk-discnt.doc-code = iDocCode
     1190                       buf2_chk-discnt.record-type = 5
     1191                       buf2_chk-discnt.line-num = 0
     1192                       buf2_chk-discnt.promo-id = v-disc-promo-id
     1193                       buf2_chk-discnt.object-sum = 0
     1194                       buf2_chk-discnt.discnt-id = if avail buf2_chk-discnt-attr
     1195                                                      then buf2_chk-discnt-attr.discnt-id
     1196                                                      else (var-discnt-id + 1)
     1197                       var-discnt-id = 0
     1198                       buf2_chk-discnt.object-line-num = 0
     1199                       buf2_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1200                       buf2_chk-discnt.obj-code = buf_chk-doc.obj-code
     1201                       buf2_chk-discnt.obj-type = buf_chk-doc.obj-type
     1202                       buf2_chk-discnt.chk-date = buf_chk-doc.chk-date
     1203                       buf2_chk-discnt.shift-date = buf_chk-doc.shift-date
     1204                       buf2_chk-discnt.shift-num = buf_chk-doc.shift-num
     1205                       buf2_chk-discnt.chk-time = buf_chk-doc.chk-time
     1206                       .
     1207                 end.
     1208                 if avail buf2_chk-discnt and
     1209                    not avail buf2_chk-discnt-attr
     1210                 then do:
     1211                    create buf2_chk-discnt-attr.
     1212                    assign
     1213                       buf2_chk-discnt-attr.doc-code = iDocCode
     1214                       buf2_chk-discnt-attr.discnt-id = buf2_chk-discnt.discnt-id
     1215                       buf2_chk-discnt-attr.record-type     = 5
     1216                       buf2_chk-discnt-attr.line-num        = 0
     1217                       buf2_chk-discnt-attr.object-line-num = 0
     1218                       buf2_chk-discnt-attr.attr-code       = "promo-id"
     1219                       buf2_chk-discnt-attr.attr-value      = v-disc-promo-id
     1220                       .
     1221                 end.
     1222              end.
     1223          end.
     1224           v-promo-sum = 0.
     1225           if can-do("1,6,7", buf_chk-gds-attr.attr-value)
     1226           then do:
     1227              if v-chk-sale <> ? and v-chk-sale <> "" then
     1228                 v-promo-sum = GetSaleRetDisc(iDocCode,v-chk-sale).
     1229              v-promo-sum = if v-promo-sum = 0 then GetPromoSum(iDocCode) else v-promo-sum.
     1230              if v-promo-sum <> 0 then do:
     1231                  find first buf2_chk-gds-attr no-lock where
     1232                             buf2_chk-gds-attr.doc-code = iDocCode
     1233                         and buf2_chk-gds-attr.line-num  = iLineNum
     1234                         and buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1235                     no-error.
     1236                  if not avail buf2_chk-gds-attr then do:
     1237                      create buf2_chk-gds-attr.
     1238                      assign
     1239                         buf2_chk-gds-attr.doc-code = iDocCode
     1240                         buf2_chk-gds-attr.line-num  = iLineNum
     1241                         buf2_chk-gds-attr.attr-code = "CSPromoSum"
     1242                         buf2_chk-gds-attr.attr-value = string(Round(v-promo-sum,2))
     1243                         .
     1244                  end.
     1245              end.
     1246           end.
     1247           for each buf_chk-discnt no-lock where
     1248                   buf_chk-discnt.doc-code = buf_chk-gds-attr.doc-code
     1249               and buf_chk-discnt.record-type = 0:
     1250              var-discnt-id  = var-discnt-id + 1.
     1251           end.
     1252           create buf_chk-discnt.
     1253           assign
     1254               buf_chk-discnt.doc-code = iDocCode
     1255               buf_chk-discnt.line-num = iLineNum
     1256               buf_chk-discnt.record-type = 0
     1257               buf_chk-discnt.discnt-id = (var-discnt-id + 1)
     1258               buf_chk-discnt.time-oper = buf_chk-gds.time-oper
     1259               buf_chk-discnt.line-type = integer('1':U)
     1260               buf_chk-discnt.line-sign = no
     1261               buf_chk-discnt.pass-discnt = integer('0':U)
     1262               buf_chk-discnt.value-type = integer('2':U)
     1263               buf_chk-discnt.src-d-card = buf_chk-gds.src-d-card
     1264               buf_chk-discnt.d-card = buf_chk-gds.d-card
     1265               buf_chk-discnt.discnt-value-abs = 0
     1266               buf_chk-discnt.discnt-value-pcnt = 0
     1267               buf_chk-discnt.object-line-num = iLineNum
     1268               buf_chk-discnt.pay-desk = buf_chk-doc.pay-desk
     1269               buf_chk-discnt.obj-code = buf_chk-doc.obj-code
     1270               buf_chk-discnt.obj-type = buf_chk-doc.obj-type
     1271               buf_chk-discnt.chk-date = buf_chk-doc.chk-date
     1272               buf_chk-discnt.chk-time = buf_chk-doc.chk-time
     1273               buf_chk-discnt.shift-date = buf_chk-doc.shift-date
     1274               buf_chk-discnt.shift-num = buf_chk-doc.shift-num
     1275               buf_chk-discnt.object-qnty = buf_chk-gds.src-qnty
     1276               buf_chk-discnt.object-sum = buf_chk-gds.src-sum
     1277               var-discnt-id = var-discnt-id + 1
     1278               buf_chk-discnt.promo-id = v-disc-promo-id
     1279               buf_chk-discnt.discnt-type = integer('7':U)
     1280               .
     1281           find first buf_chk-discnt-attr no-lock where
     1282                      buf_chk-discnt-attr.attr-code = "promo-id"
     1283                  and buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1284                  and buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1285                  and buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1286                  no-error.
     1287           if not avail buf_chk-discnt-attr then
     1288           do:
     1289               create buf_chk-discnt-attr .
     1290               assign
     1291                   buf_chk-discnt-attr.attr-code = "promo-id"
     1292                   buf_chk-discnt-attr.attr-value = buf_chk-discnt.promo-id
     1293                   buf_chk-discnt-attr.discnt-id = buf_chk-discnt.discnt-id
     1294                   buf_chk-discnt-attr.doc-code = buf_chk-discnt.doc-code
     1295                   buf_chk-discnt-attr.line-num = buf_chk-discnt.line-num
     1296                   buf_chk-discnt-attr.object-line-num = buf_chk-discnt.object-line-num
     1297                   buf_chk-discnt-attr.record-type = buf_chk-discnt.record-type
     1298                   .
     1299            end.
     1300        end.
     1301      end.
     1302      return yes.
     1303   end function.
     1304   function GetPromoPriceSum returns decimal
     1305       (input iDocCode as character)
     1306       :
     1307       define buffer buf_chk-gds for ub.chk-gds.
     1308       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1309       define variable vPromoSum as decimal no-undo.
     1310       vPromoSum = 0.
     1311       cspr:
     1312       for each buf_chk-gds no-lock where
     1313                    buf_chk-gds.doc-code = iDocCode,
     1314              first buf_chk-gds-attr no-lock where
     1315                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1316                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1317                and buf_chk-gds-attr.attr-code = "CSPromo"
     1318                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1319          vPromoSum = RoundUp(buf_chk-gds.src-qnty, buf_chk-gds.src-price).
     1320          leave cspr.
     1321       end.
     1322       return vPromoSum.
     1323   end.
     1324   function GetPromoPriceLine returns integer
     1325       (input iDocCode as character)
     1326       :
     1327       define buffer buf_chk-gds for ub.chk-gds.
     1328       define buffer buf_chk-gds-attr for ub.chk-gds-attr.
     1329       define variable vPromoLine as integer no-undo.
     1330       vPromoLine = 0.
     1331       cspr:
     1332       for each buf_chk-gds no-lock where
     1333                    buf_chk-gds.doc-code = iDocCode,
     1334              first buf_chk-gds-attr no-lock where
     1335                    buf_chk-gds-attr.doc-code = buf_chk-gds.doc-code
     1336                and buf_chk-gds-attr.line-num  = buf_chk-gds.line-num
     1337                and buf_chk-gds-attr.attr-code = "CSPromo"
     1338                and can-do("2,4,5,7", buf_chk-gds-attr.attr-value):
     1339          vPromoLine = buf_chk-gds-attr.line-num.
     1340          leave cspr.
     1341       end.
     1342       return vPromoLine.
     1343   end.
     1344   define variable v-host-code as integer no-undo .
     1345   define variable v-base-code as integer no-undo .
     1346   define variable v-curr-r-b as character no-undo .
     1347   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1348   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1349     (input  p-obj-type
     1350     ,input  p-obj-code
     1351     ,output v-host-code
     1352     )  .
     1353   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1354   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1355     (input  v-host-code
     1356     ,output v-base-code
     1357     )  .
     1358   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1359   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1360     (output v-curr-r-b
     1361     )  .
     1362   if v-curr-r-b = 'base':U or
     1363   v-base-code = 0 then pychk_NO-exch = yes.
     1364   else pychk_No-exch = no.
     1365   if v-curr-r-b = 'rubl':U or
     1366   v-base-code = 0 then pychk_NO-exch-rubl = yes.
     1367   else pychk_No-exch-rubl = no.
     1368   case p-caller:
     1369     when "r-shftc2" then do:
     1370       _chk-doc:
     1371       FOR EACH ub.chk-doc No-LOCK WHERE
     1372               ub.chk-doc.obj-type = p-obj-type
     1373           AND ub.chk-doc.obj-code = p-obj-code
     1374           AND ub.chk-doc.shift-date >= p-shift-date-start
     1375           AND ub.chk-doc.shift-date <= p-shift-date-end
     1376           and ub.chk-doc.out-code <> ?,
     1377         EACH ub.chk-pay NO-LOCK WHERE
     1378                 ub.chk-pay.doc-code = ub.chk-doc.doc-code
     1379         BREAK
     1380         BY ub.CHK-pay.doc-code
     1381         BY ub.CHK-pay.line-num:
     1382         if ub.chk-doc.shift-date = p-shift-date-start  and ub.chk-doc.shift-num < p-shift-num-start  then next .
     1383         if ub.chk-doc.shift-date = p-shift-date-end and ub.chk-doc.shift-num > p-shift-num-end then next .
     1384         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     1385   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1386   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     1387     pychk_create = not can-find (first buf_chk-gds-pay
     1388                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     1389                                    and buf_chk-gds-pay.algo-num = "1.8") .
     1390     if pychk_create then do:
     1391       for each temp-chk-pay:
     1392         delete temp-chk-pay.
     1393       end.
     1394       for each temp-chk-gds:
     1395         delete temp-chk-gds.
     1396       end.
     1397       for each temp-chk-dp:
     1398         delete temp-chk-dp.
     1399       end.
     1400       assign
     1401       pychk_kk = 0
     1402       pychk_jj = 1
     1403       pychk_jjp = 0
     1404       pychk_jjo = 0
     1405       pychk_pay-sum = ub.chk-doc.netto
     1406       pychk_dop-sumg = 0
     1407       pychk_pays_count = 0
     1408       .
     1409     end .
     1410   end.
     1411   if pychk_create   then do:
     1412   create-block:
     1413   do transaction
     1414   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     1415   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     1416   on error  undo, throw:
     1417     find first buf2_chk-doc exclusive-lock where
     1418            recid(buf2_chk-doc) = recid(ub.chk-doc).
     1419     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     1420       FOR EACH ub.chk-gds No-LOCK WHERE
     1421               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     1422       BY ub.chk-gds.line-num:
     1423         if   ub.chk-gds.write-off-code > 0
     1424           or ub.chk-gds.doc-qnty  eq 0
     1425           or ub.chk-gds.doc-qnty  eq ?
     1426         then NEXT.
     1427         find first buf_bar-code no-lock where
     1428                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     1429         if not available buf_bar-code then do:
     1430           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     1431                                                       , ub.chk-gds.b-code
     1432                                                       , ub.chk-gds.doc-code
     1433                                                       , ub.chk-doc.obj-type
     1434                                                       , ub.chk-doc.obj-code
     1435                                                       , ub.chk-gds.line-num).
     1436         end.
     1437         if ub.chk-gds.pump <> 0 then do:
     1438           pychk_rec-type = 1.
     1439           find first temp-ptrl-goods where
     1440                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     1441           if not available temp-ptrl-goods then do:
     1442             run gds-attr-value in this-procedure (
     1443                                                    input buf_bar-code.gds-code
     1444                                                   ,input 'ptrl-as-good':U
     1445                                                   ,output pychk_value
     1446                                                   ,output pychk_type) no-error.
     1447             create temp-ptrl-goods.
     1448             assign
     1449             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     1450             temp-ptrl-goods.b-code = buf_bar-code.b-code
     1451             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     1452             no-error.
     1453           end.
     1454           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     1455           release temp-ptrl-goods.
     1456         end.
     1457         else do:
     1458           assign
     1459           pychk_rec-type = 0
     1460           pychk_line-type = 0
     1461           .
     1462         end.
     1463         find first temp-chk-gds where
     1464                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1465               AND temp-chk-gds.rec-type = pychk_rec-type
     1466               and temp-chk-gds.b-code = ub.chk-gds.b-code
     1467               and temp-chk-gds.line-num = 0
     1468               no-error.
     1469         if not available temp-chk-gds then do:
     1470           find first temp-chk-gds use-index ijj where
     1471                   temp-chk-gds.jj_ = pychk_jj
     1472               and temp-chk-gds.line-num = 0
     1473                   no-error.
     1474           if not available temp-chk-gds then do:
     1475             create temp-chk-gds.
     1476             assign
     1477             temp-chk-gds.jj_ = pychk_jj
     1478             temp-chk-gds.b-code = ub.chk-gds.b-code
     1479             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1480             temp-chk-gds.line-num = 0
     1481             temp-chk-gds.rec-type = pychk_rec-type
     1482             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     1483             .
     1484           end.
     1485           else do:
     1486             assign
     1487             temp-chk-gds.b-code = ub.chk-gds.b-code
     1488             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1489             temp-chk-gds.line-num = 0
     1490             temp-chk-gds.rec-type = pychk_rec-type
     1491             temp-chk-gds.sum = 0
     1492             temp-chk-gds.jjp_ = 0
     1493             temp-chk-gds.jjo_ = 0
     1494             temp-chk-gds.line-type = '':U
     1495             temp-chk-gds.num-lines = 0
     1496             temp-chk-gds.doc-qnty = 0
     1497             temp-chk-gds.sum = 0
     1498             temp-chk-gds.flag  = no
     1499             .
     1500           end.
     1501           assign
     1502           temp-chk-gds.line-type = (if pychk_line-type = 1
     1503                                   then 'топ':U
     1504                                   else entry(1, ub.chk-gds.line-type, chr(4))
     1505                                   ) + chr(4) +
     1506                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     1507                                   then entry(2, ub.chk-gds.line-type, chr(4))
     1508                                   else '')
     1509           temp-chk-gds.line-num = 0
     1510           temp-chk-gds.num-lines = 0
     1511           temp-chk-gds.density   = ub.chk-gds.density
     1512           pychk_jj = pychk_jj + 1
     1513           .
     1514           if pychk_rec-type = 1 then do:
     1515             assign
     1516             temp-chk-gds.jjp_ = pychk_jjp + 1
     1517             pychk_jjp = pychk_jjp + 1
     1518             .
     1519           end.
     1520           else do:
     1521             assign
     1522             temp-chk-gds.jjo_ = pychk_jjo + 1
     1523             pychk_jjo = pychk_jjo + 1
     1524             .
     1525           end.
     1526         end.
     1527         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     1528         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     1529         assign
     1530         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     1531         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     1532         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     1533         .
     1534         find first temp-chk-gds use-index ijj where
     1535                 temp-chk-gds.jj_ = 0
     1536             and temp-chk-gds.line-num = ub.chk-gds.line-num
     1537                 no-error.
     1538         if not available temp-chk-gds then do:
     1539           create temp-chk-gds.
     1540           assign
     1541           temp-chk-gds.jj_ = 0
     1542           temp-chk-gds.line-num = ub.chk-gds.line-num
     1543           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1544           temp-chk-gds.b-code = ub.chk-gds.b-code
     1545           temp-chk-gds.gds-code = buf_bar-code.gds-code
     1546           temp-chk-gds.rec-type = pychk_rec-type
     1547           temp-chk-gds.line-num = ub.chk-gds.line-num
     1548           .
     1549         end.
     1550         else do:
     1551           assign
     1552           temp-chk-gds.doc-qnty = 0
     1553           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1554           temp-chk-gds.b-code = ub.chk-gds.b-code
     1555           temp-chk-gds.gds-code = buf_bar-code.gds-code
     1556           temp-chk-gds.rec-type = pychk_rec-type
     1557           temp-chk-gds.line-num = ub.chk-gds.line-num
     1558           temp-chk-gds.jjp_ = 0
     1559           temp-chk-gds.jjo_ = 0
     1560           temp-chk-gds.line-type = '':U
     1561                   .
     1562         end.
     1563         assign
     1564         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     1565         temp-chk-gds.b-code = ub.chk-gds.b-code
     1566         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     1567         temp-chk-gds.price-base = ub.chk-gds.price-base
     1568         temp-chk-gds.price-service = ub.chk-gds.price-service
     1569         temp-chk-gds.line-type = (if pychk_line-type = 1
     1570                                 then 'топ':U
     1571                                 else entry(1, ub.chk-gds.line-type, chr(4))
     1572                                 ) + chr(4) +
     1573                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     1574                                 then entry(2, ub.chk-gds.line-type, chr(4))
     1575                                 else '')
     1576         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     1577         temp-chk-gds.discnt = ub.chk-gds.discnt
     1578         temp-chk-gds.sum = vSumRound
     1579         temp-chk-gds.rec-type = pychk_rec-type
     1580         temp-chk-gds.line-num = ub.chk-gds.line-num
     1581         temp-chk-gds.num-lines = 1
     1582         temp-chk-gds.density   = ub.chk-gds.density
     1583         .
     1584       END.
     1585       for each chk-discnt no-lock
     1586          where chk-discnt.doc-code = ub.chk-doc.doc-code
     1587            and record-type = 10
     1588            and chk-discnt.discnt-value-abs <> 0,
     1589           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     1590               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     1591                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     1592                   and temp-chk-dp.b-code = chk-gds.b-code:
     1593                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     1594                   end.
     1595               end.
     1596               else do:
     1597                   create temp-chk-dp .
     1598                   assign
     1599                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     1600                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     1601                   temp-chk-dp.line-num = chk-discnt.object-line-num
     1602                   temp-chk-dp.pay-code = chk-discnt.rank
     1603                   temp-chk-dp.b-code = chk-gds.b-code
     1604                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     1605                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     1606                   .
     1607               end.
     1608       end.
     1609     end.
     1610     FIND FIRST ub.cash-pay No-LOCK WHERE
     1611               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     1612               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     1613     if available ub.cash-pay then do:
     1614       pychk_payline_rrn = "" .
     1615       if not ub.cash-pay.is-cash then do :
     1616         for first buf_chk-pay-attr no-lock
     1617             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     1618               and buf_chk-pay-attr.attr-code = "cpdoc":U
     1619               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     1620           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     1621         end .
     1622       end .
     1623         find first temp-chk-pay where
     1624                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1625             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1626             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1627             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     1628             and temp-chk-pay.rrn       = pychk_payline_rrn
     1629                    no-error.
     1630       if not available temp-chk-pay then do:
     1631           find first temp-chk-pay where
     1632                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1633               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1634               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1635               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     1636               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     1637               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     1638               no-error.
     1639         if not  avail temp-chk-pay then do:
     1640           find first temp-chk-pay where
     1641                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     1642                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     1643           if not available temp-chk-pay then do:
     1644             create temp-chk-pay.
     1645             assign
     1646             temp-chk-pay.line-num = ub.chk-pay.line-num
     1647             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1648             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1649             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     1650             temp-chk-pay.rrn       = pychk_payline_rrn
     1651             pychk_pays_count = pychk_pays_count + 1
     1652             .
     1653           end.
     1654           assign
     1655           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1656           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     1657           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     1658           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     1659           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     1660           temp-chk-pay.register = ub.cash-pay.register
     1661           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     1662           temp-chk-pay.tot-rubl = 0
     1663           temp-chk-pay.tot-base = 0
     1664           temp-chk-pay.num-lines = 0
     1665           temp-chk-pay.flag  = no
     1666           .
     1667         end.
     1668       end.
     1669       assign
     1670       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     1671                                                      then ub.chk-pay.tot-rubl
     1672                                                      else ub.chk-pay.tot-base)
     1673       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
     1674       temp-chk-pay.tot-base = temp-chk-pay.tot-base + ub.chk-pay.tot-base
     1675       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     1676       .
     1677     end.
     1678     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     1679     if last-of(ub.chk-pay.doc-code) then do:
     1680       for each temp-chk-pay where
     1681               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     1682          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     1683             and temp-chk-pay.tot-r-b <> 0
     1684             and abs(ub.chk-doc.netto) > 0.00000001
     1685          then do:
     1686             if not g#auto then do:
     1687                message
     1688                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     1689                             ,ub.chk-doc.doc-code
     1690                             ,chr(10)
     1691                             ,ub.chk-doc.obj-type
     1692                             ,ub.chk-doc.obj-code
     1693                             ,ub.chk-doc.shift-date
     1694                             ,ub.chk-doc.shift-num
     1695                             ,ub.chk-doc.pay-desk
     1696                             ,ub.chk-doc.chk-num)
     1697                   view-as alert-box error .
     1698             end.
     1699             next _chk-doc.
     1700          end.
     1701       end.
     1702       for each temp-chk-pay where
     1703               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     1704       break
     1705       by temp-chk-pay.pet-good descending
     1706       by temp-chk-pay.line-num:
     1707          dp:
     1708          for each temp-chk-dp no-lock
     1709             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     1710               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     1711               and temp-chk-dp.sum <> 0 :
     1712               find first buf_temp-chk-gds2 where
     1713                   buf_temp-chk-gds2.doc-code = ub.chk-doc.doc-code
     1714               and buf_temp-chk-gds2.line-num  =  temp-chk-dp.line-num no-error.
     1715               if available buf_temp-chk-gds2 then
     1716               for each buf_temp-chk-gds where
     1717                   buf_temp-chk-gds.b-code = buf_temp-chk-gds2.b-code
     1718                   and buf_temp-chk-gds.line-num ne 0
     1719               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     1720                    if         temp-chk-dp.all-sum  eq ?
     1721                       or abs(temp-chk-dp.all-sum) <= 0.001
     1722                   then
     1723                      next dp.
     1724                   find first  temp-chk-gds where
     1725                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     1726                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     1727                     and temp-chk-gds.line-num = 0
     1728                   no-error .
     1729                   if not available temp-chk-gds then next dp.
     1730                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     1731                       when 1 then do:
     1732                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     1733                       end.
     1734                       when 2 then do:
     1735                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     1736                       end.
     1737                   end case.
     1738                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     1739                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     1740                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     1741                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     1742                   then
     1743                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     1744                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     1745                   if can-find (first buf_chk-gds-pay no-lock where
     1746                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1747                                  and buf_chk-gds-pay.algo-num = "1.8"
     1748                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1749                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1750                                      )
     1751                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     1752                                                       , temp-chk-pay.doc-code
     1753                                                       , ub.chk-doc.obj-type
     1754                                                       , ub.chk-doc.obj-code
     1755                                                       , buf_temp-chk-gds.line-num
     1756                                                       , temp-chk-pay.line-num).
     1757                   create buf_chk-gds-pay.
     1758                     assign
     1759                     buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1760                     buf_chk-gds-pay.chk-type = ub.chk-doc.chk-type
     1761                     buf_chk-gds-pay.algo-num = "1.8"
     1762                     buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
