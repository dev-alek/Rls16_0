     1966                 buf_chk-gds-pay.line-type = pychk_line-type-chr
     1967                 buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     1968                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     1969                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     1970                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     1971                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     1972                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
