     5603                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     5604                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     5605                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     5606                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     5607                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
