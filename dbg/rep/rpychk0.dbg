     5507               end.
     5508               when 2 then do:
     5509                 pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     5510               end.
     5511             end case.
     5512             if  vPromoLineNum <> 0 and
