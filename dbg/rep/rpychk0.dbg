     2586                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     2587               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     2588               and buf_temp-chk-gds.line-num  > 0
     2589           by buf_temp-chk-gds.doc-code
     2590           by buf_temp-chk-gds.rec-type descending
