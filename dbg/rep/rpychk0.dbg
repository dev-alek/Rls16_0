     3892               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     3893                    if         temp-chk-dp.all-sum  eq ?
     3894                       or abs(temp-chk-dp.all-sum) <= 0.001
     3895                   then
     3896                      next dp.
     3897                   find first  temp-chk-gds where
     3898                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     3899                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     3900                     and temp-chk-gds.line-num = 0
     3901                   no-error .
