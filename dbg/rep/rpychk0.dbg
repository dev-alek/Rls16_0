     4053                 can-find(first buf_chk-gds-pay no-lock where
     4054                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     4055                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     4056             then .
     4057             else
     4058             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     4059                 if vPromoLineNum <> 0 and
     4060                    buf_temp-chk-gds.line-num = vPromoLineNum
     4061                 then do:
     4062                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
