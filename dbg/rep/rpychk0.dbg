     5514                 buf_temp-chk-gds.line-num = vPromoLineNum and
     5515                 can-find(first buf_chk-gds-pay no-lock where
     5516                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     5517                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     5518             then .
     5519             else
     5520             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     5521                 if vPromoLineNum <> 0 and
     5522                    buf_temp-chk-gds.line-num = vPromoLineNum
     5523                 then do:
     5524                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
     5525                 end.
     5526                 else if vPromoLineNum <> 0 and
     5527                         temp-chk-gds.num-lines > 1 and
