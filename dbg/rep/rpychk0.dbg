     4660                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     4661                                      )
     4662                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     4663                                                       , temp-chk-pay.doc-code
     4664                                                       , ub.chk-doc.obj-type
     4665                                                       , ub.chk-doc.obj-code
     4666                                                       , buf_temp-chk-gds.line-num
     4667                                                       , temp-chk-pay.line-num).
     4668                   create buf_chk-gds-pay.
