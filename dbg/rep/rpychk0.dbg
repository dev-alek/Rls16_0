     1764                     buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     1765                     buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     1766                     buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     1767                     buf_chk-gds-pay.tot-r-b =  pychk_dop-sumk
     1768                     buf_chk-gds-pay.eff-base-rate = 1
     1769                     buf_chk-gds-pay.eff-doc-qnty = (if (temp-chk-gds.num-lines = 1
     1770                                                     and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1771                                                     and pychk_pays_count = 1)
     1772                                                     or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     1773                                                     then temp-chk-gds.doc-qnty
     1774                                                     else (buf_chk-gds-pay.tot-r-b / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     1775                                                     )
     1776                     buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     1777                     buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
