     2498                                                     else (buf_chk-gds-pay.tot-r-b / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     2499                                                     )
     2500                     buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
