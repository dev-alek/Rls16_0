     2648                                      )
     2649                        then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     2650                                                       , temp-chk-pay.doc-code
     2651                                                       , ub.chk-doc.obj-type
     2652                                                       , ub.chk-doc.obj-code
     2653                                                       , buf_temp-chk-gds.line-num
     2654                                                       , temp-chk-pay.line-num).
     2655                        create buf_chk-gds-pay.
     2656                     end.
     2657                 end.
     2658                 else do:
     2659                      if can-find (first buf_chk-gds-pay no-lock where
     2660                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2661                                  and buf_chk-gds-pay.algo-num = "1.8"
     2662                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2663                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     2664                                      )
     2665                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     2666                                                       , temp-chk-pay.doc-code
     2667                                                       , ub.chk-doc.obj-type
     2668                                                       , ub.chk-doc.obj-code
     2669                                                       , buf_temp-chk-gds.line-num
     2670                                                       , temp-chk-pay.line-num).
