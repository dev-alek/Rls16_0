     1905                                               and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1906                                             then pychk_dop-sumk
     1907                                             else (pychk_dop-sumk * buf_temp-chk-gds.sum / temp-chk-gds.sum)
     1908                                            )
     1909                 .
     1910                 if can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code) then do:
     1911                     find first buf_chk-gds-pay where buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     1912                     and buf_chk-gds-pay.algo-num = "1.8"
     1913                     and buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
