     3909                       end.
     3910                   end case.
     3911                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     3912                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     3913                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     3914                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     3915                   then
