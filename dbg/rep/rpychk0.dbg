     2709                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     2710                                                 and pychk_pays_count = 1)
     2711                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     2712                                                 then temp-chk-gds.doc-qnty
     2713                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     2714                                                 )
     2715                 .
     2716               end.
     2717           end.
     2718         end.
     2719       end.
     2720       if available temp-chk-gds then release temp-chk-gds.
     2721       if available temp-chk-pay then release temp-chk-pay.
     2722       pychk_zero-gds = 0.
     2723       pychk_zero-pay = 0.
     2724       for each temp-chk-gds where
     2725               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     2726           and temp-chk-gds.flag = no
     2727           and temp-chk-gds.line-num  > 0
     2728           :
     2729          pychk_zero-gds = pychk_zero-gds + 1.
     2730       end.
     2731       for each temp-chk-pay where
     2732               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2733           and temp-chk-pay.flag = no:
     2734          pychk_zero-pay = pychk_zero-pay + 1.
     2735       end.
     2736       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2737                                 and temp-chk-pay.flag = no
     2738       no-lock no-error.
     2739       if not available temp-chk-pay
     2740       then do:
     2741          block-pay:
     2742          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     2743             assign
     2744                pychk_zero-pay = pychk_zero-pay +  1
     2745                temp-chk-pay.flag = no
     2746             .
     2747             leave block-pay.
     2748          end.
     2749       end.
     2750       for each temp-chk-pay
     2751       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2752           and temp-chk-pay.flag = no:
     2753         pychk_zero-n = 0.
     2754         for each buf_temp-chk-gds
     2755         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     2756             and buf_temp-chk-gds.flag = no
     2757             and buf_temp-chk-gds.line-num  > 0 :
     2758           pychk_zero-n = pychk_zero-n + 1.
     2759           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     2760           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     2761             when 1 then do:
     2762               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     2763             end.
     2764             when 2 then do:
     2765               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     2766             end.
     2767           end case.
     2768           if can-find(first buf_chk-gds-pay no-lock where
     2769                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2770                         and buf_chk-gds-pay.algo-num = "1.8"
     2771                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2772                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     2773           then do:
     2774               buf_temp-chk-gds.flag = yes.
     2775           end.
     2776           else do:
     2777               create buf_chk-gds-pay.
     2778               assign
     2779               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2780               buf_chk-gds-pay.algo-num = "1.8"
     2781               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     2782               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     2783               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2784               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     2785               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     2786               buf_chk-gds-pay.tot-r-b = 0
     2787               buf_chk-gds-pay.eff-base-rate = pychk_exch
     2788               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     2789               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     2790               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     2791               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     2792               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     2793               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     2794               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     2795               buf_chk-gds-pay.line-type = pychk_line-type-chr
     2796               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     2797               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     2798               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     2799               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     2800               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     2801               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     2802               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     2803               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     2804               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     2805               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     2806               buf_temp-chk-gds.flag = yes
     2807               .
     2808           end.
     2809           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     2810         end.
     2811         temp-chk-pay.flag = yes.
     2812       end.
     2813     end.
     2814   end.
     2815   end.
     2816       end.
     2817     end.
     2818     when "r-date" then do:
     2819       _chk-doc:
     2820       FOR EACH ub.chk-doc No-LOCK WHERE
     2821               ub.chk-doc.obj-type = p-obj-type
     2822           AND ub.chk-doc.obj-code = p-obj-code
     2823           AND ub.chk-doc.chk-date >= p-shift-date-start
     2824           AND ub.chk-doc.chk-date <= p-shift-date-end
     2825           and ub.chk-doc.out-code <> ?,
     2826         EACH ub.chk-pay NO-LOCK WHERE
     2827                 ub.chk-pay.doc-code = ub.chk-doc.doc-code
     2828         BREAK
     2829         BY ub.CHK-pay.doc-code
     2830         BY ub.CHK-pay.line-num:
     2831         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2832   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2833   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     2834     pychk_create = not can-find (first buf_chk-gds-pay
     2835                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     2836                                    and buf_chk-gds-pay.algo-num = "1.8") .
     2837     if pychk_create then do:
     2838       for each temp-chk-pay:
     2839         delete temp-chk-pay.
     2840       end.
     2841       for each temp-chk-gds:
     2842         delete temp-chk-gds.
     2843       end.
     2844       for each temp-chk-dp:
     2845         delete temp-chk-dp.
     2846       end.
     2847       assign
     2848       pychk_kk = 0
     2849       pychk_jj = 1
     2850       pychk_jjp = 0
     2851       pychk_jjo = 0
     2852       pychk_pay-sum = ub.chk-doc.netto
     2853       pychk_dop-sumg = 0
     2854       pychk_pays_count = 0
     2855       .
     2856     end .
     2857   end.
     2858   if pychk_create   then do:
     2859   create-block:
     2860   do transaction
     2861   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     2862   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     2863   on error  undo, throw:
     2864     find first buf2_chk-doc exclusive-lock where
     2865            recid(buf2_chk-doc) = recid(ub.chk-doc).
     2866     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     2867       FOR EACH ub.chk-gds No-LOCK WHERE
     2868               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     2869       BY ub.chk-gds.line-num:
     2870         if   ub.chk-gds.write-off-code > 0
     2871           or ub.chk-gds.doc-qnty  eq 0
     2872           or ub.chk-gds.doc-qnty  eq ?
     2873         then NEXT.
     2874         find first buf_bar-code no-lock where
     2875                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     2876         if not available buf_bar-code then do:
     2877           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     2878                                                       , ub.chk-gds.b-code
     2879                                                       , ub.chk-gds.doc-code
     2880                                                       , ub.chk-doc.obj-type
     2881                                                       , ub.chk-doc.obj-code
     2882                                                       , ub.chk-gds.line-num).
     2883         end.
     2884         if ub.chk-gds.pump <> 0 then do:
     2885           pychk_rec-type = 1.
     2886           find first temp-ptrl-goods where
     2887                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     2888           if not available temp-ptrl-goods then do:
     2889             run gds-attr-value in this-procedure (
     2890                                                    input buf_bar-code.gds-code
     2891                                                   ,input 'ptrl-as-good':U
     2892                                                   ,output pychk_value
     2893                                                   ,output pychk_type) no-error.
     2894             create temp-ptrl-goods.
     2895             assign
     2896             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     2897             temp-ptrl-goods.b-code = buf_bar-code.b-code
     2898             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     2899             no-error.
     2900           end.
     2901           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     2902           release temp-ptrl-goods.
     2903         end.
     2904         else do:
     2905           assign
     2906           pychk_rec-type = 0
     2907           pychk_line-type = 0
     2908           .
     2909         end.
     2910         find first temp-chk-gds where
     2911                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2912               AND temp-chk-gds.rec-type = pychk_rec-type
     2913               and temp-chk-gds.b-code = ub.chk-gds.b-code
     2914               and temp-chk-gds.line-num = 0
     2915               no-error.
     2916         if not available temp-chk-gds then do:
     2917           find first temp-chk-gds use-index ijj where
     2918                   temp-chk-gds.jj_ = pychk_jj
     2919               and temp-chk-gds.line-num = 0
     2920                   no-error.
     2921           if not available temp-chk-gds then do:
     2922             create temp-chk-gds.
     2923             assign
     2924             temp-chk-gds.jj_ = pychk_jj
     2925             temp-chk-gds.b-code = ub.chk-gds.b-code
     2926             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2927             temp-chk-gds.line-num = 0
     2928             temp-chk-gds.rec-type = pychk_rec-type
     2929             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     2930             .
     2931           end.
     2932           else do:
     2933             assign
     2934             temp-chk-gds.b-code = ub.chk-gds.b-code
     2935             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2936             temp-chk-gds.line-num = 0
     2937             temp-chk-gds.rec-type = pychk_rec-type
     2938             temp-chk-gds.sum = 0
     2939             temp-chk-gds.jjp_ = 0
     2940             temp-chk-gds.jjo_ = 0
     2941             temp-chk-gds.line-type = '':U
     2942             temp-chk-gds.num-lines = 0
     2943             temp-chk-gds.doc-qnty = 0
     2944             temp-chk-gds.sum = 0
     2945             temp-chk-gds.flag  = no
     2946             .
     2947           end.
     2948           assign
     2949           temp-chk-gds.line-type = (if pychk_line-type = 1
     2950                                   then 'топ':U
     2951                                   else entry(1, ub.chk-gds.line-type, chr(4))
     2952                                   ) + chr(4) +
     2953                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     2954                                   then entry(2, ub.chk-gds.line-type, chr(4))
     2955                                   else '')
     2956           temp-chk-gds.line-num = 0
     2957           temp-chk-gds.num-lines = 0
     2958           temp-chk-gds.density   = ub.chk-gds.density
     2959           pychk_jj = pychk_jj + 1
     2960           .
     2961           if pychk_rec-type = 1 then do:
     2962             assign
     2963             temp-chk-gds.jjp_ = pychk_jjp + 1
     2964             pychk_jjp = pychk_jjp + 1
     2965             .
     2966           end.
     2967           else do:
     2968             assign
     2969             temp-chk-gds.jjo_ = pychk_jjo + 1
     2970             pychk_jjo = pychk_jjo + 1
     2971             .
     2972           end.
     2973         end.
     2974         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     2975         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     2976         assign
     2977         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     2978         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     2979         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     2980         .
     2981         find first temp-chk-gds use-index ijj where
     2982                 temp-chk-gds.jj_ = 0
     2983             and temp-chk-gds.line-num = ub.chk-gds.line-num
     2984                 no-error.
     2985         if not available temp-chk-gds then do:
     2986           create temp-chk-gds.
     2987           assign
     2988           temp-chk-gds.jj_ = 0
     2989           temp-chk-gds.line-num = ub.chk-gds.line-num
     2990           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2991           temp-chk-gds.b-code = ub.chk-gds.b-code
     2992           temp-chk-gds.gds-code = buf_bar-code.gds-code
     2993           temp-chk-gds.rec-type = pychk_rec-type
     2994           temp-chk-gds.line-num = ub.chk-gds.line-num
     2995           .
     2996         end.
     2997         else do:
     2998           assign
     2999           temp-chk-gds.doc-qnty = 0
     3000           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3001           temp-chk-gds.b-code = ub.chk-gds.b-code
     3002           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3003           temp-chk-gds.rec-type = pychk_rec-type
     3004           temp-chk-gds.line-num = ub.chk-gds.line-num
     3005           temp-chk-gds.jjp_ = 0
     3006           temp-chk-gds.jjo_ = 0
     3007           temp-chk-gds.line-type = '':U
     3008                   .
     3009         end.
     3010         assign
     3011         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3012         temp-chk-gds.b-code = ub.chk-gds.b-code
     3013         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     3014         temp-chk-gds.price-base = ub.chk-gds.price-base
     3015         temp-chk-gds.price-service = ub.chk-gds.price-service
     3016         temp-chk-gds.line-type = (if pychk_line-type = 1
     3017                                 then 'топ':U
     3018                                 else entry(1, ub.chk-gds.line-type, chr(4))
     3019                                 ) + chr(4) +
     3020                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3021                                 then entry(2, ub.chk-gds.line-type, chr(4))
     3022                                 else '')
     3023         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     3024         temp-chk-gds.discnt = ub.chk-gds.discnt
     3025         temp-chk-gds.sum = vSumRound
     3026         temp-chk-gds.rec-type = pychk_rec-type
     3027         temp-chk-gds.line-num = ub.chk-gds.line-num
     3028         temp-chk-gds.num-lines = 1
     3029         temp-chk-gds.density   = ub.chk-gds.density
     3030         .
     3031       END.
     3032       for each chk-discnt no-lock
     3033          where chk-discnt.doc-code = ub.chk-doc.doc-code
     3034            and record-type = 10
     3035            and chk-discnt.discnt-value-abs <> 0,
     3036           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     3037               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     3038                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3039                   and temp-chk-dp.b-code = chk-gds.b-code:
     3040                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     3041                   end.
     3042               end.
     3043               else do:
     3044                   create temp-chk-dp .
     3045                   assign
     3046                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3047                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     3048                   temp-chk-dp.line-num = chk-discnt.object-line-num
     3049                   temp-chk-dp.pay-code = chk-discnt.rank
     3050                   temp-chk-dp.b-code = chk-gds.b-code
     3051                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     3052                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     3053                   .
     3054               end.
     3055       end.
     3056     end.
     3057     FIND FIRST ub.cash-pay No-LOCK WHERE
     3058               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     3059               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     3060     if available ub.cash-pay then do:
     3061       pychk_payline_rrn = "" .
     3062       if not ub.cash-pay.is-cash then do :
     3063         for first buf_chk-pay-attr no-lock
     3064             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     3065               and buf_chk-pay-attr.attr-code = "cpdoc":U
     3066               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     3067           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     3068         end .
     3069       end .
     3070         find first temp-chk-pay where
     3071                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3072             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3073             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3074             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3075             and temp-chk-pay.rrn       = pychk_payline_rrn
     3076                    no-error.
     3077       if not available temp-chk-pay then do:
     3078           find first temp-chk-pay where
     3079                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3080               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3081               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3082               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3083               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     3084               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     3085               no-error.
     3086         if not  avail temp-chk-pay then do:
     3087           find first temp-chk-pay where
     3088                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3089                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     3090           if not available temp-chk-pay then do:
     3091             create temp-chk-pay.
     3092             assign
     3093             temp-chk-pay.line-num = ub.chk-pay.line-num
     3094             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3095             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3096             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3097             temp-chk-pay.rrn       = pychk_payline_rrn
     3098             pychk_pays_count = pychk_pays_count + 1
     3099             .
     3100           end.
     3101           assign
     3102           temp-chk-pay.doc-code = ub.chk-doc.doc-code
