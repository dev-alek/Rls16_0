     1982                 end.
     1983                 else
     1984                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     1985                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     1986                                                 and pychk_pays_count = 1)
     1987                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     1988                                                 then temp-chk-gds.doc-qnty
     1989                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     1990                                                 )
     1991                 .
     1992               end.
     1993           end.
     1994         end.
     1995       end.
     1996       if available temp-chk-gds then release temp-chk-gds.
     1997       if available temp-chk-pay then release temp-chk-pay.
     1998       pychk_zero-gds = 0.
     1999       pychk_zero-pay = 0.
     2000       for each temp-chk-gds where
     2001               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     2002           and temp-chk-gds.flag = no
     2003           and temp-chk-gds.line-num  > 0
     2004           :
     2005          pychk_zero-gds = pychk_zero-gds + 1.
     2006       end.
     2007       for each temp-chk-pay where
     2008               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2009           and temp-chk-pay.flag = no:
     2010          pychk_zero-pay = pychk_zero-pay + 1.
     2011       end.
     2012       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2013                                 and temp-chk-pay.flag = no
     2014       no-lock no-error.
     2015       if not available temp-chk-pay
     2016       then do:
     2017          block-pay:
     2018          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     2019             assign
     2020                pychk_zero-pay = pychk_zero-pay +  1
     2021                temp-chk-pay.flag = no
     2022             .
     2023             leave block-pay.
     2024          end.
     2025       end.
     2026       for each temp-chk-pay
     2027       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2028           and temp-chk-pay.flag = no:
     2029         pychk_zero-n = 0.
     2030         for each buf_temp-chk-gds
     2031         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     2032             and buf_temp-chk-gds.flag = no
     2033             and buf_temp-chk-gds.line-num  > 0 :
     2034           pychk_zero-n = pychk_zero-n + 1.
     2035           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     2036           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     2037             when 1 then do:
     2038               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     2039             end.
     2040             when 2 then do:
     2041               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     2042             end.
     2043           end case.
     2044           if can-find(first buf_chk-gds-pay no-lock where
     2045                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2046                         and buf_chk-gds-pay.algo-num = "1.8"
     2047                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2048                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     2049           then do:
     2050               buf_temp-chk-gds.flag = yes.
     2051           end.
     2052           else do:
     2053               create buf_chk-gds-pay.
     2054               assign
     2055               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2056               buf_chk-gds-pay.algo-num = "1.8"
     2057               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     2058               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     2059               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2060               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     2061               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     2062               buf_chk-gds-pay.tot-r-b = 0
     2063               buf_chk-gds-pay.eff-base-rate = pychk_exch
     2064               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     2065               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     2066               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     2067               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     2068               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     2069               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     2070               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     2071               buf_chk-gds-pay.line-type = pychk_line-type-chr
     2072               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     2073               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     2074               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     2075               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     2076               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     2077               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     2078               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     2079               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     2080               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     2081               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     2082               buf_temp-chk-gds.flag = yes
     2083               .
     2084           end.
     2085           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     2086         end.
     2087         temp-chk-pay.flag = yes.
     2088       end.
     2089     end.
     2090   end.
     2091   end.
     2092       end.
     2093     end.
     2094     when "r-shft3f" then do:
     2095       _chk-doc:
     2096       FOR EACH ub.chk-doc No-LOCK WHERE
     2097               ub.chk-doc.obj-type = p-obj-type
     2098           AND ub.chk-doc.obj-code = p-obj-code
     2099           AND ub.chk-doc.shift-date >= p-shift-date-start
     2100           AND ub.chk-doc.shift-date <= p-shift-date-end,
     2101         EACH ub.chk-pay NO-LOCK WHERE
     2102                 ub.chk-pay.doc-code = ub.chk-doc.doc-code
     2103         BREAK
     2104         BY ub.CHK-pay.doc-code
     2105         BY ub.CHK-pay.line-num:
     2106         if ub.chk-doc.shift-date = p-shift-date-start  and ub.chk-doc.shift-num < p-shift-num-start  then next .
     2107         if ub.chk-doc.shift-date = p-shift-date-end and ub.chk-doc.shift-num > p-shift-num-end then next .
     2108         if lookup(string(ub.chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     2109   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     2111     pychk_create = not can-find (first buf_chk-gds-pay
     2112                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     2113                                    and buf_chk-gds-pay.algo-num = "1.8") .
     2114     if pychk_create then do:
     2115       for each temp-chk-pay:
     2116         delete temp-chk-pay.
     2117       end.
     2118       for each temp-chk-gds:
     2119         delete temp-chk-gds.
     2120       end.
     2121       for each temp-chk-dp:
     2122         delete temp-chk-dp.
     2123       end.
     2124       assign
     2125       pychk_kk = 0
     2126       pychk_jj = 1
     2127       pychk_jjp = 0
     2128       pychk_jjo = 0
     2129       pychk_pay-sum = ub.chk-doc.netto
     2130       pychk_dop-sumg = 0
     2131       pychk_pays_count = 0
     2132       .
     2133     end .
     2134   end.
     2135   if pychk_create   then do:
     2136   create-block:
     2137   do transaction
     2138   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     2139   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     2140   on error  undo, throw:
     2141     find first buf2_chk-doc exclusive-lock where
     2142            recid(buf2_chk-doc) = recid(ub.chk-doc).
     2143     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     2144       FOR EACH ub.chk-gds No-LOCK WHERE
     2145               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     2146       BY ub.chk-gds.line-num:
     2147         if   ub.chk-gds.write-off-code > 0
     2148           or ub.chk-gds.doc-qnty  eq 0
     2149           or ub.chk-gds.doc-qnty  eq ?
     2150         then NEXT.
     2151         find first buf_bar-code no-lock where
     2152                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     2153         if not available buf_bar-code then do:
     2154           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     2155                                                       , ub.chk-gds.b-code
     2156                                                       , ub.chk-gds.doc-code
     2157                                                       , ub.chk-doc.obj-type
     2158                                                       , ub.chk-doc.obj-code
     2159                                                       , ub.chk-gds.line-num).
     2160         end.
     2161         if ub.chk-gds.pump <> 0 then do:
     2162           pychk_rec-type = 1.
     2163           find first temp-ptrl-goods where
     2164                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     2165           if not available temp-ptrl-goods then do:
     2166             run gds-attr-value in this-procedure (
     2167                                                    input buf_bar-code.gds-code
     2168                                                   ,input 'ptrl-as-good':U
     2169                                                   ,output pychk_value
     2170                                                   ,output pychk_type) no-error.
     2171             create temp-ptrl-goods.
     2172             assign
     2173             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     2174             temp-ptrl-goods.b-code = buf_bar-code.b-code
     2175             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     2176             no-error.
     2177           end.
     2178           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     2179           release temp-ptrl-goods.
     2180         end.
     2181         else do:
     2182           assign
     2183           pychk_rec-type = 0
     2184           pychk_line-type = 0
     2185           .
     2186         end.
     2187         find first temp-chk-gds where
     2188                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2189               AND temp-chk-gds.rec-type = pychk_rec-type
     2190               and temp-chk-gds.b-code = ub.chk-gds.b-code
     2191               and temp-chk-gds.line-num = 0
     2192               no-error.
     2193         if not available temp-chk-gds then do:
     2194           find first temp-chk-gds use-index ijj where
     2195                   temp-chk-gds.jj_ = pychk_jj
     2196               and temp-chk-gds.line-num = 0
     2197                   no-error.
     2198           if not available temp-chk-gds then do:
     2199             create temp-chk-gds.
     2200             assign
     2201             temp-chk-gds.jj_ = pychk_jj
     2202             temp-chk-gds.b-code = ub.chk-gds.b-code
     2203             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2204             temp-chk-gds.line-num = 0
     2205             temp-chk-gds.rec-type = pychk_rec-type
     2206             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     2207             .
     2208           end.
     2209           else do:
     2210             assign
     2211             temp-chk-gds.b-code = ub.chk-gds.b-code
     2212             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2213             temp-chk-gds.line-num = 0
     2214             temp-chk-gds.rec-type = pychk_rec-type
     2215             temp-chk-gds.sum = 0
     2216             temp-chk-gds.jjp_ = 0
     2217             temp-chk-gds.jjo_ = 0
     2218             temp-chk-gds.line-type = '':U
     2219             temp-chk-gds.num-lines = 0
     2220             temp-chk-gds.doc-qnty = 0
     2221             temp-chk-gds.sum = 0
     2222             temp-chk-gds.flag  = no
     2223             .
     2224           end.
     2225           assign
     2226           temp-chk-gds.line-type = (if pychk_line-type = 1
     2227                                   then 'топ':U
     2228                                   else entry(1, ub.chk-gds.line-type, chr(4))
     2229                                   ) + chr(4) +
     2230                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     2231                                   then entry(2, ub.chk-gds.line-type, chr(4))
     2232                                   else '')
     2233           temp-chk-gds.line-num = 0
     2234           temp-chk-gds.num-lines = 0
     2235           temp-chk-gds.density   = ub.chk-gds.density
     2236           pychk_jj = pychk_jj + 1
     2237           .
     2238           if pychk_rec-type = 1 then do:
     2239             assign
     2240             temp-chk-gds.jjp_ = pychk_jjp + 1
     2241             pychk_jjp = pychk_jjp + 1
     2242             .
     2243           end.
     2244           else do:
     2245             assign
     2246             temp-chk-gds.jjo_ = pychk_jjo + 1
     2247             pychk_jjo = pychk_jjo + 1
     2248             .
     2249           end.
     2250         end.
     2251         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     2252         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     2253         assign
     2254         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     2255         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     2256         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     2257         .
     2258         find first temp-chk-gds use-index ijj where
     2259                 temp-chk-gds.jj_ = 0
     2260             and temp-chk-gds.line-num = ub.chk-gds.line-num
     2261                 no-error.
     2262         if not available temp-chk-gds then do:
     2263           create temp-chk-gds.
     2264           assign
     2265           temp-chk-gds.jj_ = 0
     2266           temp-chk-gds.line-num = ub.chk-gds.line-num
     2267           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2268           temp-chk-gds.b-code = ub.chk-gds.b-code
     2269           temp-chk-gds.gds-code = buf_bar-code.gds-code
     2270           temp-chk-gds.rec-type = pychk_rec-type
     2271           temp-chk-gds.line-num = ub.chk-gds.line-num
     2272           .
     2273         end.
     2274         else do:
     2275           assign
     2276           temp-chk-gds.doc-qnty = 0
     2277           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2278           temp-chk-gds.b-code = ub.chk-gds.b-code
     2279           temp-chk-gds.gds-code = buf_bar-code.gds-code
     2280           temp-chk-gds.rec-type = pychk_rec-type
     2281           temp-chk-gds.line-num = ub.chk-gds.line-num
     2282           temp-chk-gds.jjp_ = 0
     2283           temp-chk-gds.jjo_ = 0
     2284           temp-chk-gds.line-type = '':U
     2285                   .
     2286         end.
     2287         assign
     2288         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     2289         temp-chk-gds.b-code = ub.chk-gds.b-code
     2290         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     2291         temp-chk-gds.price-base = ub.chk-gds.price-base
     2292         temp-chk-gds.price-service = ub.chk-gds.price-service
     2293         temp-chk-gds.line-type = (if pychk_line-type = 1
     2294                                 then 'топ':U
     2295                                 else entry(1, ub.chk-gds.line-type, chr(4))
     2296                                 ) + chr(4) +
     2297                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     2298                                 then entry(2, ub.chk-gds.line-type, chr(4))
     2299                                 else '')
     2300         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     2301         temp-chk-gds.discnt = ub.chk-gds.discnt
     2302         temp-chk-gds.sum = vSumRound
     2303         temp-chk-gds.rec-type = pychk_rec-type
     2304         temp-chk-gds.line-num = ub.chk-gds.line-num
     2305         temp-chk-gds.num-lines = 1
     2306         temp-chk-gds.density   = ub.chk-gds.density
     2307         .
     2308       END.
     2309       for each chk-discnt no-lock
     2310          where chk-discnt.doc-code = ub.chk-doc.doc-code
     2311            and record-type = 10
     2312            and chk-discnt.discnt-value-abs <> 0,
     2313           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     2314               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     2315                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     2316                   and temp-chk-dp.b-code = chk-gds.b-code:
     2317                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     2318                   end.
     2319               end.
     2320               else do:
     2321                   create temp-chk-dp .
     2322                   assign
     2323                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     2324                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     2325                   temp-chk-dp.line-num = chk-discnt.object-line-num
     2326                   temp-chk-dp.pay-code = chk-discnt.rank
     2327                   temp-chk-dp.b-code = chk-gds.b-code
     2328                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     2329                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     2330                   .
     2331               end.
     2332       end.
     2333     end.
     2334     FIND FIRST ub.cash-pay No-LOCK WHERE
     2335               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     2336               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     2337     if available ub.cash-pay then do:
     2338       pychk_payline_rrn = "" .
     2339       if not ub.cash-pay.is-cash then do :
     2340         for first buf_chk-pay-attr no-lock
     2341             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     2342               and buf_chk-pay-attr.attr-code = "cpdoc":U
     2343               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     2344           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     2345         end .
     2346       end .
     2347         find first temp-chk-pay where
     2348                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2349             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     2350             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     2351             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     2352             and temp-chk-pay.rrn       = pychk_payline_rrn
     2353                    no-error.
     2354       if not available temp-chk-pay then do:
     2355           find first temp-chk-pay where
     2356                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2357               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     2358               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     2359               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     2360               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     2361               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     2362               no-error.
     2363         if not  avail temp-chk-pay then do:
     2364           find first temp-chk-pay where
     2365                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     2366                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     2367           if not available temp-chk-pay then do:
     2368             create temp-chk-pay.
     2369             assign
     2370             temp-chk-pay.line-num = ub.chk-pay.line-num
     2371             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     2372             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     2373             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     2374             temp-chk-pay.rrn       = pychk_payline_rrn
     2375             pychk_pays_count = pychk_pays_count + 1
     2376             .
     2377           end.
     2378           assign
     2379           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     2380           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     2381           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     2382           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     2383           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     2384           temp-chk-pay.register = ub.cash-pay.register
     2385           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     2386           temp-chk-pay.tot-rubl = 0
     2387           temp-chk-pay.tot-base = 0
     2388           temp-chk-pay.num-lines = 0
     2389           temp-chk-pay.flag  = no
     2390           .
     2391         end.
     2392       end.
     2393       assign
     2394       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     2395                                                      then ub.chk-pay.tot-rubl
     2396                                                      else ub.chk-pay.tot-base)
     2397       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
