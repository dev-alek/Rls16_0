     2517                     .
     2518                   assign
     2519                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     2520                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     2521                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     2522                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     2523                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     2524                   .
     2525                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     2526               end.
     2527           end.
     2528         assign
     2529         pychk_dop-sump = temp-chk-pay.tot-r-b
     2530         pychk_exch = if pychk_No-exch then 1
     2531                      else (if temp-chk-pay.tot-base = 0
     2532                            then 0
     2533                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     2534         pychk_exch-rubl = if pychk_No-exch-rubl
     2535                           then 1
     2536                           else (if temp-chk-pay.tot-base = 0
     2537                                 then 0
     2538                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     2539         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     2540         .
     2541         _repeat:
     2542         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     2543           if pychk_dop-sumg = 0 then do:
     2544             assign
     2545             pychk_kk = pychk_kk + 1
     2546             .
