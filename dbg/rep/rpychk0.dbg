     4036               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     4037               and buf_temp-chk-gds.line-num  > 0
     4038           by buf_temp-chk-gds.doc-code
     4039           by buf_temp-chk-gds.rec-type descending
