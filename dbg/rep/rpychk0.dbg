     2442                   and buf_temp-chk-gds.line-num ne 0
     2443               no-lock by buf_temp-chk-gds.line-num  ne  temp-chk-dp.line-num :
     2444                    if         temp-chk-dp.all-sum  eq ?
     2445                       or abs(temp-chk-dp.all-sum) <= 0.001
     2446                   then
     2447                      next dp.
     2448                   find first  temp-chk-gds where
     2449                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     2450                       and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     2451                     and temp-chk-gds.line-num = 0
     2452                   no-error .
     2453                   if not available temp-chk-gds then next dp.
     2454                   case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     2455                       when 1 then do:
     2456                         pychk_line-type-chr = temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     2457                       end.
     2458                       when 2 then do:
     2459                         pychk_line-type-chr = temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     2460                       end.
     2461                   end case.
     2462                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     2463                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     2464                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     2465                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     2466                   then
     2467                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     2468                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     2469                   if can-find (first buf_chk-gds-pay no-lock where
     2470                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     2471                                  and buf_chk-gds-pay.algo-num = "1.8"
     2472                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     2473                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     2474                                      )
     2475                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     2476                                                       , temp-chk-pay.doc-code
     2477                                                       , ub.chk-doc.obj-type
     2478                                                       , ub.chk-doc.obj-code
     2479                                                       , buf_temp-chk-gds.line-num
