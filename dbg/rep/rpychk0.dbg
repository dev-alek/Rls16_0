     5497                   buf_temp-chk-gds.doc-code = ub.chk-doc.doc-code
     5498               and buf_temp-chk-gds.b-code = temp-chk-gds.b-code
     5499               and buf_temp-chk-gds.line-num  > 0
     5500           by buf_temp-chk-gds.doc-code
     5501           by buf_temp-chk-gds.rec-type descending
     5502           by buf_temp-chk-gds.line-num
     5503            :
