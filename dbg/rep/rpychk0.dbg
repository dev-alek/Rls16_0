     3432                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     3433                                                 and pychk_pays_count = 1)
     3434                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     3435                                                 then temp-chk-gds.doc-qnty
     3436                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     3437                                                 )
     3438                 .
     3439               end.
     3440           end.
     3441         end.
     3442       end.
     3443       if available temp-chk-gds then release temp-chk-gds.
     3444       if available temp-chk-pay then release temp-chk-pay.
     3445       pychk_zero-gds = 0.
     3446       pychk_zero-pay = 0.
     3447       for each temp-chk-gds where
     3448               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     3449           and temp-chk-gds.flag = no
     3450           and temp-chk-gds.line-num  > 0
     3451           :
     3452          pychk_zero-gds = pychk_zero-gds + 1.
     3453       end.
     3454       for each temp-chk-pay where
     3455               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3456           and temp-chk-pay.flag = no:
     3457          pychk_zero-pay = pychk_zero-pay + 1.
     3458       end.
     3459       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3460                                 and temp-chk-pay.flag = no
     3461       no-lock no-error.
     3462       if not available temp-chk-pay
     3463       then do:
     3464          block-pay:
     3465          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     3466             assign
     3467                pychk_zero-pay = pychk_zero-pay +  1
     3468                temp-chk-pay.flag = no
     3469             .
     3470             leave block-pay.
     3471          end.
     3472       end.
     3473       for each temp-chk-pay
     3474       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3475           and temp-chk-pay.flag = no:
     3476         pychk_zero-n = 0.
     3477         for each buf_temp-chk-gds
     3478         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     3479             and buf_temp-chk-gds.flag = no
     3480             and buf_temp-chk-gds.line-num  > 0 :
     3481           pychk_zero-n = pychk_zero-n + 1.
     3482           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     3483           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     3484             when 1 then do:
     3485               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     3486             end.
     3487             when 2 then do:
     3488               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     3489             end.
     3490           end case.
     3491           if can-find(first buf_chk-gds-pay no-lock where
     3492                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3493                         and buf_chk-gds-pay.algo-num = "1.8"
     3494                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3495                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     3496           then do:
     3497               buf_temp-chk-gds.flag = yes.
     3498           end.
     3499           else do:
     3500               create buf_chk-gds-pay.
     3501               assign
     3502               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     3503               buf_chk-gds-pay.algo-num = "1.8"
     3504               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     3505               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     3506               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     3507               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     3508               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     3509               buf_chk-gds-pay.tot-r-b = 0
     3510               buf_chk-gds-pay.eff-base-rate = pychk_exch
     3511               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     3512               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     3513               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     3514               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     3515               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     3516               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     3517               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     3518               buf_chk-gds-pay.line-type = pychk_line-type-chr
     3519               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     3520               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     3521               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     3522               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     3523               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     3524               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     3525               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     3526               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     3527               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     3528               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     3529               buf_temp-chk-gds.flag = yes
     3530               .
     3531           end.
     3532           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     3533         end.
     3534         temp-chk-pay.flag = yes.
     3535       end.
     3536     end.
     3537   end.
     3538   end.
     3539       end.
     3540     end.
     3541     when "r-ptrsp2" then do:
     3542       _chk-doc:
     3543       for each ub.chk-doc no-lock where
     3544                ub.chk-doc.obj-type    = p-obj-type
     3545            and ub.chk-doc.obj-code    = p-obj-code
     3546            and ub.chk-doc.shift-date  = p-shift-date-start
     3547            and ub.chk-doc.shift-num   = p-shift-num-start
     3548            and ub.chk-doc.out-code   <> ? ,
     3549       EACH ub.chk-pay NO-LOCK WHERE
     3550               ub.chk-pay.doc-code = ub.chk-doc.doc-code
     3551       BREAK
     3552       BY ub.CHK-pay.doc-code
     3553       BY ub.CHK-pay.line-num:
     3554         if lookup( string( ub.chk-doc.chk-type ), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U ) > 0
     3555         then do:
     3556           next _chk-doc .
     3557         end.
     3558   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3559   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3560     pychk_create = not can-find (first buf_chk-gds-pay
     3561                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     3562                                    and buf_chk-gds-pay.algo-num = "1.8") .
     3563     if pychk_create then do:
     3564       for each temp-chk-pay:
     3565         delete temp-chk-pay.
     3566       end.
     3567       for each temp-chk-gds:
     3568         delete temp-chk-gds.
     3569       end.
     3570       for each temp-chk-dp:
     3571         delete temp-chk-dp.
     3572       end.
     3573       assign
     3574       pychk_kk = 0
     3575       pychk_jj = 1
     3576       pychk_jjp = 0
     3577       pychk_jjo = 0
     3578       pychk_pay-sum = ub.chk-doc.netto
     3579       pychk_dop-sumg = 0
     3580       pychk_pays_count = 0
     3581       .
     3582     end .
     3583   end.
     3584   if pychk_create   then do:
     3585   create-block:
     3586   do transaction
     3587   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     3588   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     3589   on error  undo, throw:
     3590     find first buf2_chk-doc exclusive-lock where
     3591            recid(buf2_chk-doc) = recid(ub.chk-doc).
     3592     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     3593       FOR EACH ub.chk-gds No-LOCK WHERE
     3594               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     3595       BY ub.chk-gds.line-num:
     3596         if   ub.chk-gds.write-off-code > 0
     3597           or ub.chk-gds.doc-qnty  eq 0
     3598           or ub.chk-gds.doc-qnty  eq ?
     3599         then NEXT.
     3600         find first buf_bar-code no-lock where
     3601                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     3602         if not available buf_bar-code then do:
     3603           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     3604                                                       , ub.chk-gds.b-code
     3605                                                       , ub.chk-gds.doc-code
     3606                                                       , ub.chk-doc.obj-type
     3607                                                       , ub.chk-doc.obj-code
     3608                                                       , ub.chk-gds.line-num).
     3609         end.
     3610         if ub.chk-gds.pump <> 0 then do:
     3611           pychk_rec-type = 1.
     3612           find first temp-ptrl-goods where
     3613                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     3614           if not available temp-ptrl-goods then do:
     3615             run gds-attr-value in this-procedure (
     3616                                                    input buf_bar-code.gds-code
     3617                                                   ,input 'ptrl-as-good':U
     3618                                                   ,output pychk_value
     3619                                                   ,output pychk_type) no-error.
     3620             create temp-ptrl-goods.
     3621             assign
     3622             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     3623             temp-ptrl-goods.b-code = buf_bar-code.b-code
     3624             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     3625             no-error.
     3626           end.
     3627           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     3628           release temp-ptrl-goods.
     3629         end.
     3630         else do:
     3631           assign
     3632           pychk_rec-type = 0
     3633           pychk_line-type = 0
     3634           .
     3635         end.
     3636         find first temp-chk-gds where
     3637                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3638               AND temp-chk-gds.rec-type = pychk_rec-type
     3639               and temp-chk-gds.b-code = ub.chk-gds.b-code
     3640               and temp-chk-gds.line-num = 0
     3641               no-error.
     3642         if not available temp-chk-gds then do:
     3643           find first temp-chk-gds use-index ijj where
     3644                   temp-chk-gds.jj_ = pychk_jj
     3645               and temp-chk-gds.line-num = 0
     3646                   no-error.
     3647           if not available temp-chk-gds then do:
     3648             create temp-chk-gds.
     3649             assign
     3650             temp-chk-gds.jj_ = pychk_jj
     3651             temp-chk-gds.b-code = ub.chk-gds.b-code
     3652             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3653             temp-chk-gds.line-num = 0
     3654             temp-chk-gds.rec-type = pychk_rec-type
     3655             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     3656             .
     3657           end.
     3658           else do:
     3659             assign
     3660             temp-chk-gds.b-code = ub.chk-gds.b-code
     3661             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3662             temp-chk-gds.line-num = 0
     3663             temp-chk-gds.rec-type = pychk_rec-type
     3664             temp-chk-gds.sum = 0
     3665             temp-chk-gds.jjp_ = 0
     3666             temp-chk-gds.jjo_ = 0
     3667             temp-chk-gds.line-type = '':U
     3668             temp-chk-gds.num-lines = 0
     3669             temp-chk-gds.doc-qnty = 0
     3670             temp-chk-gds.sum = 0
     3671             temp-chk-gds.flag  = no
     3672             .
     3673           end.
     3674           assign
     3675           temp-chk-gds.line-type = (if pychk_line-type = 1
     3676                                   then 'топ':U
     3677                                   else entry(1, ub.chk-gds.line-type, chr(4))
     3678                                   ) + chr(4) +
     3679                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3680                                   then entry(2, ub.chk-gds.line-type, chr(4))
     3681                                   else '')
     3682           temp-chk-gds.line-num = 0
     3683           temp-chk-gds.num-lines = 0
     3684           temp-chk-gds.density   = ub.chk-gds.density
     3685           pychk_jj = pychk_jj + 1
     3686           .
     3687           if pychk_rec-type = 1 then do:
     3688             assign
     3689             temp-chk-gds.jjp_ = pychk_jjp + 1
     3690             pychk_jjp = pychk_jjp + 1
     3691             .
     3692           end.
     3693           else do:
     3694             assign
     3695             temp-chk-gds.jjo_ = pychk_jjo + 1
     3696             pychk_jjo = pychk_jjo + 1
     3697             .
     3698           end.
     3699         end.
     3700         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     3701         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     3702         assign
     3703         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     3704         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     3705         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     3706         .
     3707         find first temp-chk-gds use-index ijj where
     3708                 temp-chk-gds.jj_ = 0
     3709             and temp-chk-gds.line-num = ub.chk-gds.line-num
     3710                 no-error.
     3711         if not available temp-chk-gds then do:
     3712           create temp-chk-gds.
     3713           assign
     3714           temp-chk-gds.jj_ = 0
     3715           temp-chk-gds.line-num = ub.chk-gds.line-num
     3716           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3717           temp-chk-gds.b-code = ub.chk-gds.b-code
     3718           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3719           temp-chk-gds.rec-type = pychk_rec-type
     3720           temp-chk-gds.line-num = ub.chk-gds.line-num
     3721           .
     3722         end.
     3723         else do:
     3724           assign
     3725           temp-chk-gds.doc-qnty = 0
     3726           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3727           temp-chk-gds.b-code = ub.chk-gds.b-code
     3728           temp-chk-gds.gds-code = buf_bar-code.gds-code
     3729           temp-chk-gds.rec-type = pychk_rec-type
     3730           temp-chk-gds.line-num = ub.chk-gds.line-num
     3731           temp-chk-gds.jjp_ = 0
     3732           temp-chk-gds.jjo_ = 0
     3733           temp-chk-gds.line-type = '':U
     3734                   .
     3735         end.
     3736         assign
     3737         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     3738         temp-chk-gds.b-code = ub.chk-gds.b-code
     3739         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     3740         temp-chk-gds.price-base = ub.chk-gds.price-base
     3741         temp-chk-gds.price-service = ub.chk-gds.price-service
     3742         temp-chk-gds.line-type = (if pychk_line-type = 1
     3743                                 then 'топ':U
     3744                                 else entry(1, ub.chk-gds.line-type, chr(4))
     3745                                 ) + chr(4) +
     3746                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     3747                                 then entry(2, ub.chk-gds.line-type, chr(4))
     3748                                 else '')
     3749         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     3750         temp-chk-gds.discnt = ub.chk-gds.discnt
     3751         temp-chk-gds.sum = vSumRound
     3752         temp-chk-gds.rec-type = pychk_rec-type
     3753         temp-chk-gds.line-num = ub.chk-gds.line-num
     3754         temp-chk-gds.num-lines = 1
     3755         temp-chk-gds.density   = ub.chk-gds.density
     3756         .
     3757       END.
     3758       for each chk-discnt no-lock
     3759          where chk-discnt.doc-code = ub.chk-doc.doc-code
     3760            and record-type = 10
     3761            and chk-discnt.discnt-value-abs <> 0,
     3762           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     3763               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     3764                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3765                   and temp-chk-dp.b-code = chk-gds.b-code:
     3766                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     3767                   end.
     3768               end.
     3769               else do:
     3770                   create temp-chk-dp .
     3771                   assign
     3772                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     3773                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     3774                   temp-chk-dp.line-num = chk-discnt.object-line-num
     3775                   temp-chk-dp.pay-code = chk-discnt.rank
     3776                   temp-chk-dp.b-code = chk-gds.b-code
     3777                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     3778                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     3779                   .
     3780               end.
     3781       end.
     3782     end.
     3783     FIND FIRST ub.cash-pay No-LOCK WHERE
     3784               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     3785               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     3786     if available ub.cash-pay then do:
     3787       pychk_payline_rrn = "" .
     3788       if not ub.cash-pay.is-cash then do :
     3789         for first buf_chk-pay-attr no-lock
     3790             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     3791               and buf_chk-pay-attr.attr-code = "cpdoc":U
     3792               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     3793           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     3794         end .
     3795       end .
     3796         find first temp-chk-pay where
     3797                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3798             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3799             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3800             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3801             and temp-chk-pay.rrn       = pychk_payline_rrn
     3802                    no-error.
     3803       if not available temp-chk-pay then do:
     3804           find first temp-chk-pay where
     3805                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3806               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3807               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3808               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     3809               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     3810               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     3811               no-error.
     3812         if not  avail temp-chk-pay then do:
     3813           find first temp-chk-pay where
     3814                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     3815                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     3816           if not available temp-chk-pay then do:
     3817             create temp-chk-pay.
     3818             assign
     3819             temp-chk-pay.line-num = ub.chk-pay.line-num
     3820             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3821             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3822             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3823             temp-chk-pay.rrn       = pychk_payline_rrn
     3824             pychk_pays_count = pychk_pays_count + 1
     3825             .
     3826           end.
     3827           assign
     3828           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3829           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     3830           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     3831           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     3832           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     3833           temp-chk-pay.register = ub.cash-pay.register
     3834           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     3835           temp-chk-pay.tot-rubl = 0
     3836           temp-chk-pay.tot-base = 0
     3837           temp-chk-pay.num-lines = 0
     3838           temp-chk-pay.flag  = no
     3839           .
     3840         end.
     3841       end.
     3842       assign
     3843       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     3844                                                      then ub.chk-pay.tot-rubl
     3845                                                      else ub.chk-pay.tot-base)
     3846       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
