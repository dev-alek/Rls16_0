     4879                 buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     4880                 buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     4881                 buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     4882                 buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     4883                 buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
