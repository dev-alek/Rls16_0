     4072                                   )
     4073                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     4074                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
