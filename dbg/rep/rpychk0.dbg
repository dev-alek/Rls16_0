     3855          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     3856             and temp-chk-pay.tot-r-b <> 0
     3857             and abs(ub.chk-doc.netto) > 0.00000001
     3858          then do:
     3859             if not g#auto then do:
     3860                message
     3861                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     3862                             ,ub.chk-doc.doc-code
     3863                             ,chr(10)
     3864                             ,ub.chk-doc.obj-type
     3865                             ,ub.chk-doc.obj-code
     3866                             ,ub.chk-doc.shift-date
     3867                             ,ub.chk-doc.shift-num
     3868                             ,ub.chk-doc.pay-desk
     3869                             ,ub.chk-doc.chk-num)
     3870                   view-as alert-box error .
     3871             end.
     3872             next _chk-doc.
     3873          end.
     3874       end.
     3875       for each temp-chk-pay where
     3876               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     3877       break
     3878       by temp-chk-pay.pet-good descending
     3879       by temp-chk-pay.line-num:
     3880          dp:
