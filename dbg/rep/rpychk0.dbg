     4024           assign
     4025           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     4026           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     4027           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
