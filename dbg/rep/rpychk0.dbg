     4158                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     4159                                                 and pychk_pays_count = 1)
     4160                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     4161                                                 then temp-chk-gds.doc-qnty
     4162                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     4163                                                 )
     4164                 .
     4165               end.
     4166           end.
     4167         end.
     4168       end.
     4169       if available temp-chk-gds then release temp-chk-gds.
     4170       if available temp-chk-pay then release temp-chk-pay.
     4171       pychk_zero-gds = 0.
     4172       pychk_zero-pay = 0.
     4173       for each temp-chk-gds where
     4174               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4175           and temp-chk-gds.flag = no
     4176           and temp-chk-gds.line-num  > 0
     4177           :
     4178          pychk_zero-gds = pychk_zero-gds + 1.
     4179       end.
     4180       for each temp-chk-pay where
     4181               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4182           and temp-chk-pay.flag = no:
     4183          pychk_zero-pay = pychk_zero-pay + 1.
     4184       end.
     4185       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4186                                 and temp-chk-pay.flag = no
     4187       no-lock no-error.
     4188       if not available temp-chk-pay
     4189       then do:
     4190          block-pay:
     4191          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     4192             assign
     4193                pychk_zero-pay = pychk_zero-pay +  1
     4194                temp-chk-pay.flag = no
     4195             .
     4196             leave block-pay.
     4197          end.
     4198       end.
     4199       for each temp-chk-pay
     4200       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4201           and temp-chk-pay.flag = no:
     4202         pychk_zero-n = 0.
     4203         for each buf_temp-chk-gds
     4204         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4205             and buf_temp-chk-gds.flag = no
     4206             and buf_temp-chk-gds.line-num  > 0 :
     4207           pychk_zero-n = pychk_zero-n + 1.
     4208           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     4209           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     4210             when 1 then do:
     4211               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     4212             end.
     4213             when 2 then do:
     4214               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     4215             end.
     4216           end case.
     4217           if can-find(first buf_chk-gds-pay no-lock where
     4218                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4219                         and buf_chk-gds-pay.algo-num = "1.8"
     4220                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4221                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     4222           then do:
     4223               buf_temp-chk-gds.flag = yes.
     4224           end.
     4225           else do:
     4226               create buf_chk-gds-pay.
     4227               assign
     4228               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4229               buf_chk-gds-pay.algo-num = "1.8"
     4230               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     4231               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     4232               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4233               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     4234               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     4235               buf_chk-gds-pay.tot-r-b = 0
     4236               buf_chk-gds-pay.eff-base-rate = pychk_exch
     4237               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     4238               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     4239               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     4240               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     4241               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     4242               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     4243               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     4244               buf_chk-gds-pay.line-type = pychk_line-type-chr
     4245               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     4246               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     4247               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     4248               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     4249               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     4250               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     4251               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     4252               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     4253               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     4254               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     4255               buf_temp-chk-gds.flag = yes
     4256               .
     4257           end.
     4258           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     4259         end.
     4260         temp-chk-pay.flag = yes.
     4261       end.
     4262     end.
     4263   end.
     4264   end.
     4265       end.
     4266     end.
     4267     when "r-pychk2"
     4268     or
     4269     when "bgepych2"
     4270     or
     4271     when "r-accor2"
     4272     or
     4273     when "r-pychk0"
     4274     or
     4275     when "salevza2"
     4276     or
     4277     when "exp-elc2"
     4278     or
     4279     when "r-trg29d"
     4280     then do:
     4281       _chk-doc:
     4282       FOR EACH ub.chk-doc No-LOCK WHERE
     4283               ub.chk-doc.obj-type = p-obj-type
     4284           and ub.chk-doc.obj-code = p-obj-code
     4285           and ub.chk-doc.out-code = p-inkas-code,
     4286         EACH ub.chk-pay NO-LOCK WHERE
     4287                 ub.chk-pay.doc-code = ub.chk-doc.doc-code
     4288       BREAK
     4289       BY CHK-pay.DOC-CODE
     4290       BY CHK-pay.LINE-NUM:
     4291         if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     4292         if p-caller = "r-accor2" and
     4293               not ( ub.chk-doc.chk-type = 1 or
     4294                    ub.chk-doc.chk-type = 6 ) then next _chk-doc.
     4295         if p-caller = "exp-elc2" and ub.chk-doc.d-card = "":U then next _chk-doc.
     4296   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4297   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     4298     pychk_create = not can-find (first buf_chk-gds-pay
     4299                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     4300                                    and buf_chk-gds-pay.algo-num = "1.8") .
     4301     if pychk_create then do:
     4302       for each temp-chk-pay:
     4303         delete temp-chk-pay.
     4304       end.
     4305       for each temp-chk-gds:
     4306         delete temp-chk-gds.
     4307       end.
     4308       for each temp-chk-dp:
     4309         delete temp-chk-dp.
     4310       end.
     4311       assign
     4312       pychk_kk = 0
     4313       pychk_jj = 1
     4314       pychk_jjp = 0
     4315       pychk_jjo = 0
     4316       pychk_pay-sum = ub.chk-doc.netto
     4317       pychk_dop-sumg = 0
     4318       pychk_pays_count = 0
     4319       .
     4320     end .
     4321   end.
     4322   if pychk_create   then do:
     4323   create-block:
     4324   do transaction
     4325   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     4326   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     4327   on error  undo, throw:
     4328     find first buf2_chk-doc exclusive-lock where
     4329            recid(buf2_chk-doc) = recid(ub.chk-doc).
     4330     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     4331       FOR EACH ub.chk-gds No-LOCK WHERE
     4332               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     4333       BY ub.chk-gds.line-num:
     4334         if   ub.chk-gds.write-off-code > 0
     4335           or ub.chk-gds.doc-qnty  eq 0
     4336           or ub.chk-gds.doc-qnty  eq ?
     4337         then NEXT.
     4338         find first buf_bar-code no-lock where
     4339                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     4340         if not available buf_bar-code then do:
     4341           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     4342                                                       , ub.chk-gds.b-code
     4343                                                       , ub.chk-gds.doc-code
     4344                                                       , ub.chk-doc.obj-type
     4345                                                       , ub.chk-doc.obj-code
     4346                                                       , ub.chk-gds.line-num).
     4347         end.
     4348         if ub.chk-gds.pump <> 0 then do:
     4349           pychk_rec-type = 1.
     4350           find first temp-ptrl-goods where
     4351                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     4352           if not available temp-ptrl-goods then do:
     4353             run gds-attr-value in this-procedure (
     4354                                                    input buf_bar-code.gds-code
     4355                                                   ,input 'ptrl-as-good':U
     4356                                                   ,output pychk_value
     4357                                                   ,output pychk_type) no-error.
     4358             create temp-ptrl-goods.
     4359             assign
     4360             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     4361             temp-ptrl-goods.b-code = buf_bar-code.b-code
     4362             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     4363             no-error.
     4364           end.
     4365           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     4366           release temp-ptrl-goods.
     4367         end.
     4368         else do:
     4369           assign
     4370           pychk_rec-type = 0
     4371           pychk_line-type = 0
     4372           .
     4373         end.
     4374         find first temp-chk-gds where
     4375                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4376               AND temp-chk-gds.rec-type = pychk_rec-type
     4377               and temp-chk-gds.b-code = ub.chk-gds.b-code
     4378               and temp-chk-gds.line-num = 0
     4379               no-error.
     4380         if not available temp-chk-gds then do:
     4381           find first temp-chk-gds use-index ijj where
     4382                   temp-chk-gds.jj_ = pychk_jj
     4383               and temp-chk-gds.line-num = 0
     4384                   no-error.
     4385           if not available temp-chk-gds then do:
     4386             create temp-chk-gds.
     4387             assign
     4388             temp-chk-gds.jj_ = pychk_jj
     4389             temp-chk-gds.b-code = ub.chk-gds.b-code
     4390             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4391             temp-chk-gds.line-num = 0
     4392             temp-chk-gds.rec-type = pychk_rec-type
     4393             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     4394             .
     4395           end.
     4396           else do:
     4397             assign
     4398             temp-chk-gds.b-code = ub.chk-gds.b-code
     4399             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4400             temp-chk-gds.line-num = 0
     4401             temp-chk-gds.rec-type = pychk_rec-type
     4402             temp-chk-gds.sum = 0
     4403             temp-chk-gds.jjp_ = 0
     4404             temp-chk-gds.jjo_ = 0
     4405             temp-chk-gds.line-type = '':U
     4406             temp-chk-gds.num-lines = 0
     4407             temp-chk-gds.doc-qnty = 0
     4408             temp-chk-gds.sum = 0
     4409             temp-chk-gds.flag  = no
     4410             .
     4411           end.
     4412           assign
     4413           temp-chk-gds.line-type = (if pychk_line-type = 1
     4414                                   then 'топ':U
     4415                                   else entry(1, ub.chk-gds.line-type, chr(4))
     4416                                   ) + chr(4) +
     4417                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     4418                                   then entry(2, ub.chk-gds.line-type, chr(4))
     4419                                   else '')
     4420           temp-chk-gds.line-num = 0
     4421           temp-chk-gds.num-lines = 0
     4422           temp-chk-gds.density   = ub.chk-gds.density
     4423           pychk_jj = pychk_jj + 1
     4424           .
     4425           if pychk_rec-type = 1 then do:
     4426             assign
     4427             temp-chk-gds.jjp_ = pychk_jjp + 1
     4428             pychk_jjp = pychk_jjp + 1
     4429             .
     4430           end.
     4431           else do:
     4432             assign
     4433             temp-chk-gds.jjo_ = pychk_jjo + 1
     4434             pychk_jjo = pychk_jjo + 1
     4435             .
     4436           end.
     4437         end.
     4438         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     4439         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     4440         assign
     4441         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     4442         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     4443         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     4444         .
     4445         find first temp-chk-gds use-index ijj where
     4446                 temp-chk-gds.jj_ = 0
     4447             and temp-chk-gds.line-num = ub.chk-gds.line-num
     4448                 no-error.
     4449         if not available temp-chk-gds then do:
     4450           create temp-chk-gds.
     4451           assign
     4452           temp-chk-gds.jj_ = 0
     4453           temp-chk-gds.line-num = ub.chk-gds.line-num
     4454           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4455           temp-chk-gds.b-code = ub.chk-gds.b-code
     4456           temp-chk-gds.gds-code = buf_bar-code.gds-code
     4457           temp-chk-gds.rec-type = pychk_rec-type
     4458           temp-chk-gds.line-num = ub.chk-gds.line-num
     4459           .
     4460         end.
     4461         else do:
     4462           assign
     4463           temp-chk-gds.doc-qnty = 0
     4464           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4465           temp-chk-gds.b-code = ub.chk-gds.b-code
     4466           temp-chk-gds.gds-code = buf_bar-code.gds-code
     4467           temp-chk-gds.rec-type = pychk_rec-type
     4468           temp-chk-gds.line-num = ub.chk-gds.line-num
     4469           temp-chk-gds.jjp_ = 0
     4470           temp-chk-gds.jjo_ = 0
     4471           temp-chk-gds.line-type = '':U
     4472                   .
     4473         end.
     4474         assign
     4475         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     4476         temp-chk-gds.b-code = ub.chk-gds.b-code
     4477         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     4478         temp-chk-gds.price-base = ub.chk-gds.price-base
     4479         temp-chk-gds.price-service = ub.chk-gds.price-service
     4480         temp-chk-gds.line-type = (if pychk_line-type = 1
     4481                                 then 'топ':U
     4482                                 else entry(1, ub.chk-gds.line-type, chr(4))
     4483                                 ) + chr(4) +
     4484                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     4485                                 then entry(2, ub.chk-gds.line-type, chr(4))
     4486                                 else '')
     4487         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     4488         temp-chk-gds.discnt = ub.chk-gds.discnt
     4489         temp-chk-gds.sum = vSumRound
     4490         temp-chk-gds.rec-type = pychk_rec-type
     4491         temp-chk-gds.line-num = ub.chk-gds.line-num
     4492         temp-chk-gds.num-lines = 1
     4493         temp-chk-gds.density   = ub.chk-gds.density
     4494         .
     4495       END.
     4496       for each chk-discnt no-lock
     4497          where chk-discnt.doc-code = ub.chk-doc.doc-code
     4498            and record-type = 10
     4499            and chk-discnt.discnt-value-abs <> 0,
     4500           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     4501               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     4502                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     4503                   and temp-chk-dp.b-code = chk-gds.b-code:
     4504                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     4505                   end.
     4506               end.
     4507               else do:
     4508                   create temp-chk-dp .
     4509                   assign
     4510                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     4511                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     4512                   temp-chk-dp.line-num = chk-discnt.object-line-num
     4513                   temp-chk-dp.pay-code = chk-discnt.rank
     4514                   temp-chk-dp.b-code = chk-gds.b-code
     4515                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     4516                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     4517                   .
     4518               end.
     4519       end.
     4520     end.
     4521     FIND FIRST ub.cash-pay No-LOCK WHERE
     4522               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     4523               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     4524     if available ub.cash-pay then do:
     4525       pychk_payline_rrn = "" .
     4526       if not ub.cash-pay.is-cash then do :
     4527         for first buf_chk-pay-attr no-lock
     4528             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     4529               and buf_chk-pay-attr.attr-code = "cpdoc":U
     4530               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     4531           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     4532         end .
     4533       end .
     4534         find first temp-chk-pay where
     4535                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4536             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     4537             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     4538             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     4539             and temp-chk-pay.rrn       = pychk_payline_rrn
     4540                    no-error.
     4541       if not available temp-chk-pay then do:
     4542           find first temp-chk-pay where
     4543                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4544               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     4545               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     4546               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     4547               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     4548               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     4549               no-error.
     4550         if not  avail temp-chk-pay then do:
     4551           find first temp-chk-pay where
     4552                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4553                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     4554           if not available temp-chk-pay then do:
     4555             create temp-chk-pay.
     4556             assign
     4557             temp-chk-pay.line-num = ub.chk-pay.line-num
     4558             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     4559             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     4560             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     4561             temp-chk-pay.rrn       = pychk_payline_rrn
     4562             pychk_pays_count = pychk_pays_count + 1
     4563             .
     4564           end.
     4565           assign
     4566           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     4567           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     4568           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     4569           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     4570           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     4571           temp-chk-pay.register = ub.cash-pay.register
     4572           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     4573           temp-chk-pay.tot-rubl = 0
     4574           temp-chk-pay.tot-base = 0
     4575           temp-chk-pay.num-lines = 0
     4576           temp-chk-pay.flag  = no
     4577           .
     4578         end.
     4579       end.
     4580       assign
