     2577           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     2578           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     2579           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     2580           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     2581           .
