     4889                 .
     4890                 if buf_temp-chk-gds.line-num = vPromoLineNum
     4891                 then do:
     4892                    buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty.
     4893                 end.
     4894                 else
     4895                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     4896                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     4897                                                 and pychk_pays_count = 1)
     4898                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     4899                                                 then temp-chk-gds.doc-qnty
     4900                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     4901                                                 )
     4902                 .
     4903               end.
     4904           end.
     4905         end.
     4906       end.
     4907       if available temp-chk-gds then release temp-chk-gds.
     4908       if available temp-chk-pay then release temp-chk-pay.
     4909       pychk_zero-gds = 0.
     4910       pychk_zero-pay = 0.
     4911       for each temp-chk-gds where
     4912               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4913           and temp-chk-gds.flag = no
     4914           and temp-chk-gds.line-num  > 0
     4915           :
     4916          pychk_zero-gds = pychk_zero-gds + 1.
     4917       end.
     4918       for each temp-chk-pay where
     4919               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4920           and temp-chk-pay.flag = no:
     4921          pychk_zero-pay = pychk_zero-pay + 1.
     4922       end.
     4923       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4924                                 and temp-chk-pay.flag = no
     4925       no-lock no-error.
     4926       if not available temp-chk-pay
     4927       then do:
     4928          block-pay:
     4929          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     4930             assign
     4931                pychk_zero-pay = pychk_zero-pay +  1
     4932                temp-chk-pay.flag = no
     4933             .
     4934             leave block-pay.
     4935          end.
     4936       end.
     4937       for each temp-chk-pay
     4938       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     4939           and temp-chk-pay.flag = no:
     4940         pychk_zero-n = 0.
     4941         for each buf_temp-chk-gds
     4942         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     4943             and buf_temp-chk-gds.flag = no
     4944             and buf_temp-chk-gds.line-num  > 0 :
     4945           pychk_zero-n = pychk_zero-n + 1.
     4946           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     4947           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     4948             when 1 then do:
     4949               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     4950             end.
     4951             when 2 then do:
     4952               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     4953             end.
     4954           end case.
     4955           if can-find(first buf_chk-gds-pay no-lock where
     4956                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4957                         and buf_chk-gds-pay.algo-num = "1.8"
     4958                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4959                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     4960           then do:
     4961               buf_temp-chk-gds.flag = yes.
     4962           end.
     4963           else do:
     4964               create buf_chk-gds-pay.
     4965               assign
     4966               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4967               buf_chk-gds-pay.algo-num = "1.8"
     4968               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     4969               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     4970               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4971               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     4972               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     4973               buf_chk-gds-pay.tot-r-b = 0
     4974               buf_chk-gds-pay.eff-base-rate = pychk_exch
     4975               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     4976               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     4977               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     4978               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     4979               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     4980               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     4981               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     4982               buf_chk-gds-pay.line-type = pychk_line-type-chr
     4983               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     4984               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     4985               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     4986               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     4987               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     4988               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     4989               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     4990               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     4991               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     4992               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     4993               buf_temp-chk-gds.flag = yes
     4994               .
     4995           end.
     4996           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     4997         end.
     4998         temp-chk-pay.flag = yes.
     4999       end.
     5000     end.
     5001   end.
     5002   end.
     5003       end.
     5004     end.
     5005     when "r-autocu"
     5006     then do:
     5007       _chk-doc:
     5008       FOR EACH ub.chk-doc No-LOCK WHERE
     5009               ub.chk-doc.obj-type = p-obj-type
     5010           and ub.chk-doc.obj-code = p-obj-code
     5011           and ub.chk-doc.chk-date >= p-date-start
     5012           and ub.chk-doc.chk-date <= p-date-end,
     5013         EACH ub.chk-pay NO-LOCK WHERE
     5014                 ub.chk-pay.doc-code = ub.chk-doc.doc-code
     5015       BREAK
     5016       BY CHK-pay.DOC-CODE
     5017       BY CHK-pay.LINE-NUM:
     5018         if lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     5019         if replace(replace(replace(replace(ub.chk-doc.office, 'у':U, ''), 'т':U, ''), 'смн-ош':U, ''), chr(44), '') <> '' then next _chk-doc.
     5020   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5021   if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     5022     pychk_create = not can-find (first buf_chk-gds-pay
     5023                                  where buf_chk-gds-pay.doc-code = ub.chk-doc.doc-code
     5024                                    and buf_chk-gds-pay.algo-num = "1.8") .
     5025     if pychk_create then do:
     5026       for each temp-chk-pay:
     5027         delete temp-chk-pay.
     5028       end.
     5029       for each temp-chk-gds:
     5030         delete temp-chk-gds.
     5031       end.
     5032       for each temp-chk-dp:
     5033         delete temp-chk-dp.
     5034       end.
     5035       assign
     5036       pychk_kk = 0
     5037       pychk_jj = 1
     5038       pychk_jjp = 0
     5039       pychk_jjo = 0
     5040       pychk_pay-sum = ub.chk-doc.netto
     5041       pychk_dop-sumg = 0
     5042       pychk_pays_count = 0
     5043       .
     5044     end .
     5045   end.
     5046   if pychk_create   then do:
     5047   create-block:
     5048   do transaction
     5049   on stop   undo create-block, return error substitute( "&1. stop", vss-workfile )
     5050   on endkey undo create-block, return error substitute( "&1. endkey", vss-workfile )
     5051   on error  undo, throw:
     5052     find first buf2_chk-doc exclusive-lock where
     5053            recid(buf2_chk-doc) = recid(ub.chk-doc).
     5054     if first-of(ub.CHK-pay.DOC-CODE) THEN Do:
     5055       FOR EACH ub.chk-gds No-LOCK WHERE
     5056               ub.chk-gds.doc-code = ub.chk-pay.doc-code
     5057       BY ub.chk-gds.line-num:
     5058         if   ub.chk-gds.write-off-code > 0
     5059           or ub.chk-gds.doc-qnty  eq 0
     5060           or ub.chk-gds.doc-qnty  eq ?
     5061         then NEXT.
     5062         find first buf_bar-code no-lock where
     5063                   buf_bar-code.b-code = ub.chk-gds.b-code no-error.
     5064         if not available buf_bar-code then do:
     5065           undo create-block, return error substitute("Не найден товар для бар-кода &1: чек &2 &3&4 строка &5"
     5066                                                       , ub.chk-gds.b-code
     5067                                                       , ub.chk-gds.doc-code
     5068                                                       , ub.chk-doc.obj-type
     5069                                                       , ub.chk-doc.obj-code
     5070                                                       , ub.chk-gds.line-num).
     5071         end.
     5072         if ub.chk-gds.pump <> 0 then do:
     5073           pychk_rec-type = 1.
     5074           find first temp-ptrl-goods where
     5075                      temp-ptrl-goods.b-code = ub.chk-gds.b-code no-error.
     5076           if not available temp-ptrl-goods then do:
     5077             run gds-attr-value in this-procedure (
     5078                                                    input buf_bar-code.gds-code
     5079                                                   ,input 'ptrl-as-good':U
     5080                                                   ,output pychk_value
     5081                                                   ,output pychk_type) no-error.
     5082             create temp-ptrl-goods.
     5083             assign
     5084             temp-ptrl-goods.gds-code = buf_bar-code.gds-code
     5085             temp-ptrl-goods.b-code = buf_bar-code.b-code
     5086             temp-ptrl-goods.ptrl-good = (not logical(pychk_value))
     5087             no-error.
     5088           end.
     5089           pychk_line-type = if temp-ptrl-goods.ptrl-good then 1 else 0 .
     5090           release temp-ptrl-goods.
     5091         end.
     5092         else do:
     5093           assign
     5094           pychk_rec-type = 0
     5095           pychk_line-type = 0
     5096           .
     5097         end.
     5098         find first temp-chk-gds where
     5099                   temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5100               AND temp-chk-gds.rec-type = pychk_rec-type
     5101               and temp-chk-gds.b-code = ub.chk-gds.b-code
     5102               and temp-chk-gds.line-num = 0
     5103               no-error.
     5104         if not available temp-chk-gds then do:
     5105           find first temp-chk-gds use-index ijj where
     5106                   temp-chk-gds.jj_ = pychk_jj
     5107               and temp-chk-gds.line-num = 0
     5108                   no-error.
     5109           if not available temp-chk-gds then do:
     5110             create temp-chk-gds.
     5111             assign
     5112             temp-chk-gds.jj_ = pychk_jj
     5113             temp-chk-gds.b-code = ub.chk-gds.b-code
     5114             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5115             temp-chk-gds.line-num = 0
     5116             temp-chk-gds.rec-type = pychk_rec-type
     5117             temp-chk-gds.gds-code = buf_bar-code.gds-code.
     5118             .
     5119           end.
     5120           else do:
     5121             assign
     5122             temp-chk-gds.b-code = ub.chk-gds.b-code
     5123             temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5124             temp-chk-gds.line-num = 0
     5125             temp-chk-gds.rec-type = pychk_rec-type
     5126             temp-chk-gds.sum = 0
     5127             temp-chk-gds.jjp_ = 0
     5128             temp-chk-gds.jjo_ = 0
     5129             temp-chk-gds.line-type = '':U
     5130             temp-chk-gds.num-lines = 0
     5131             temp-chk-gds.doc-qnty = 0
     5132             temp-chk-gds.sum = 0
     5133             temp-chk-gds.flag  = no
     5134             .
     5135           end.
     5136           assign
     5137           temp-chk-gds.line-type = (if pychk_line-type = 1
     5138                                   then 'топ':U
     5139                                   else entry(1, ub.chk-gds.line-type, chr(4))
     5140                                   ) + chr(4) +
     5141                                   (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     5142                                   then entry(2, ub.chk-gds.line-type, chr(4))
     5143                                   else '')
     5144           temp-chk-gds.line-num = 0
     5145           temp-chk-gds.num-lines = 0
     5146           temp-chk-gds.density   = ub.chk-gds.density
     5147           pychk_jj = pychk_jj + 1
     5148           .
     5149           if pychk_rec-type = 1 then do:
     5150             assign
     5151             temp-chk-gds.jjp_ = pychk_jjp + 1
     5152             pychk_jjp = pychk_jjp + 1
     5153             .
     5154           end.
     5155           else do:
     5156             assign
     5157             temp-chk-gds.jjo_ = pychk_jjo + 1
     5158             pychk_jjo = pychk_jjo + 1
     5159             .
     5160           end.
     5161         end.
     5162         vSumRound = ub.chk-gds.doc-qnty * (ub.chk-gds.price-base - ub.chk-gds.discnt).
     5163         if ChkPromoPrice(ub.chk-gds.doc-code, ub.chk-gds.line-num) then vSumRound = ub.chk-gds.src-sum.
     5164         assign
     5165         temp-chk-gds.doc-qnty = temp-chk-gds.doc-qnty + ub.chk-gds.doc-qnty
     5166         temp-chk-gds.sum = temp-chk-gds.sum + vSumRound
     5167         temp-chk-gds.num-lines = temp-chk-gds.num-lines  + 1
     5168         .
     5169         find first temp-chk-gds use-index ijj where
     5170                 temp-chk-gds.jj_ = 0
     5171             and temp-chk-gds.line-num = ub.chk-gds.line-num
     5172                 no-error.
     5173         if not available temp-chk-gds then do:
     5174           create temp-chk-gds.
     5175           assign
     5176           temp-chk-gds.jj_ = 0
     5177           temp-chk-gds.line-num = ub.chk-gds.line-num
     5178           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5179           temp-chk-gds.b-code = ub.chk-gds.b-code
     5180           temp-chk-gds.gds-code = buf_bar-code.gds-code
     5181           temp-chk-gds.rec-type = pychk_rec-type
     5182           temp-chk-gds.line-num = ub.chk-gds.line-num
     5183           .
     5184         end.
     5185         else do:
     5186           assign
     5187           temp-chk-gds.doc-qnty = 0
     5188           temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5189           temp-chk-gds.b-code = ub.chk-gds.b-code
     5190           temp-chk-gds.gds-code = buf_bar-code.gds-code
     5191           temp-chk-gds.rec-type = pychk_rec-type
     5192           temp-chk-gds.line-num = ub.chk-gds.line-num
     5193           temp-chk-gds.jjp_ = 0
     5194           temp-chk-gds.jjo_ = 0
     5195           temp-chk-gds.line-type = '':U
     5196                   .
     5197         end.
     5198         assign
     5199         temp-chk-gds.doc-code = ub.chk-gds.doc-code
     5200         temp-chk-gds.b-code = ub.chk-gds.b-code
     5201         temp-chk-gds.doc-qnty = ub.chk-gds.doc-qnty
     5202         temp-chk-gds.price-base = ub.chk-gds.price-base
     5203         temp-chk-gds.price-service = ub.chk-gds.price-service
     5204         temp-chk-gds.line-type = (if pychk_line-type = 1
     5205                                 then 'топ':U
     5206                                 else entry(1, ub.chk-gds.line-type, chr(4))
     5207                                 ) + chr(4) +
     5208                                 (if num-entries(ub.chk-gds.line-type, chr(4)) > 1
     5209                                 then entry(2, ub.chk-gds.line-type, chr(4))
     5210                                 else '')
     5211         temp-chk-gds.line-sign = ub.chk-gds.line-sign
     5212         temp-chk-gds.discnt = ub.chk-gds.discnt
     5213         temp-chk-gds.sum = vSumRound
     5214         temp-chk-gds.rec-type = pychk_rec-type
     5215         temp-chk-gds.line-num = ub.chk-gds.line-num
     5216         temp-chk-gds.num-lines = 1
     5217         temp-chk-gds.density   = ub.chk-gds.density
     5218         .
     5219       END.
     5220       for each chk-discnt no-lock
     5221          where chk-discnt.doc-code = ub.chk-doc.doc-code
     5222            and record-type = 10
     5223            and chk-discnt.discnt-value-abs <> 0,
     5224           first ub.chk-gds of ub.chk-doc where ub.chk-gds.line-num =  chk-discnt.object-line-num :
     5225               if ub.chk-doc.chk-type = 1 and chk-discnt.object-qnty < 0 then do:
     5226                   for first temp-chk-dp where temp-chk-dp.doc-code = ub.chk-doc.doc-code
     5227                   and temp-chk-dp.b-code = chk-gds.b-code:
     5228                       temp-chk-dp.sum = temp-chk-dp.sum - abs(chk-discnt.discnt-value-abs * chk-discnt.object-qnty).
     5229                   end.
     5230               end.
     5231               else do:
     5232                   create temp-chk-dp .
     5233                   assign
     5234                   temp-chk-dp.doc-code = ub.chk-doc.doc-code
     5235                   temp-chk-dp.sum = abs(chk-discnt.discnt-value-abs) * chk-discnt.object-qnty
     5236                   temp-chk-dp.line-num = chk-discnt.object-line-num
     5237                   temp-chk-dp.pay-code = chk-discnt.rank
     5238                   temp-chk-dp.b-code = chk-gds.b-code
     5239                   temp-chk-dp.qnty   = abs(chk-discnt.discnt-value-pcnt)
     5240                   temp-chk-dp.all-sum =  chk-discnt.discnt-value-abs * chk-discnt.discnt-value-pcnt
     5241                   .
     5242               end.
     5243       end.
     5244     end.
     5245     FIND FIRST ub.cash-pay No-LOCK WHERE
     5246               ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     5247               ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     5248     if available ub.cash-pay then do:
     5249       pychk_payline_rrn = "" .
     5250       if not ub.cash-pay.is-cash then do :
     5251         for first buf_chk-pay-attr no-lock
     5252             where buf_chk-pay-attr.doc-code  = ub.CHK-pay.DOC-CODE
     5253               and buf_chk-pay-attr.attr-code = "cpdoc":U
     5254               and buf_chk-pay-attr.line-num  = ub.CHK-pay.line-num :
     5255           pychk_payline_rrn = buf_chk-pay-attr.attr-value .
     5256         end .
     5257       end .
     5258         find first temp-chk-pay where
     5259                 temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5260             and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     5261             and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     5262             and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     5263             and temp-chk-pay.rrn       = pychk_payline_rrn
     5264                    no-error.
     5265       if not available temp-chk-pay then do:
     5266           find first temp-chk-pay where
     5267                   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5268               and temp-chk-pay.pay-code = ub.chk-pay.pay-code
     5269               and temp-chk-pay.pay-card = ub.chk-pay.pay-card
     5270               and temp-chk-pay.curr-code = ub.chk-pay.curr-code
     5271               and abs(temp-chk-pay.tot-r-b) >= abs(ub.chk-pay.tot-sum)
     5272               and (temp-chk-pay.tot-r-b >=0) NE (ub.chk-pay.tot-sum >=0)
     5273               no-error.
     5274         if not  avail temp-chk-pay then do:
     5275           find first temp-chk-pay where
     5276                     temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5277                 and temp-chk-pay.line-num = ub.chk-pay.line-num use-index pi no-error.
     5278           if not available temp-chk-pay then do:
     5279             create temp-chk-pay.
     5280             assign
     5281             temp-chk-pay.line-num = ub.chk-pay.line-num
     5282             temp-chk-pay.doc-code = ub.chk-doc.doc-code
     5283             temp-chk-pay.pay-code = ub.chk-pay.pay-code
     5284             temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     5285             temp-chk-pay.rrn       = pychk_payline_rrn
     5286             pychk_pays_count = pychk_pays_count + 1
     5287             .
     5288           end.
     5289           assign
     5290           temp-chk-pay.doc-code = ub.chk-doc.doc-code
     5291           temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash) + 2 * int(can-find(first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code ))
     5292           temp-chk-pay.pay-code = ub.chk-pay.pay-code
     5293           temp-chk-pay.curr-code =  ub.chk-pay.curr-code
     5294           temp-chk-pay.is-cash  = ub.cash-pay.is-cash
     5295           temp-chk-pay.register = ub.cash-pay.register
     5296           temp-chk-pay.pay-card = ub.chk-pay.pay-card
     5297           temp-chk-pay.tot-rubl = 0
     5298           temp-chk-pay.tot-base = 0
     5299           temp-chk-pay.num-lines = 0
     5300           temp-chk-pay.flag  = no
     5301           .
     5302         end.
     5303       end.
     5304       assign
     5305       temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b + (if v-curr-r-b = 'rubl':U
     5306                                                      then ub.chk-pay.tot-rubl
     5307                                                      else ub.chk-pay.tot-base)
     5308       temp-chk-pay.tot-rubl = temp-chk-pay.tot-rubl + ub.chk-pay.tot-rubl
