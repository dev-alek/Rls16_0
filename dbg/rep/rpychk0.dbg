     4745                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     4746                     and temp-chk-gds.line-num = 0
     4747                   no-error .
     4748             end.
     4749             if not available temp-chk-gds
     4750             or (temp-chk-gds.sum = 0
     4751                 or
     4752                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     4753                 )
     4754             then do:
     4755               NEXT _repeat.
     4756             end.
     4757             assign
     4758             pychk_dop-sumg = if available temp-chk-gds then temp-chk-gds.sum else 0
     4759             temp-chk-gds.flag = yes
     4760             .
     4761           end.
     4762           assign
     4763           pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 ) * (if pychk_dop-sumg < 0 AND ub.chk-doc.chk-type = 1 then -1 else 1 )
     4764           pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     4765           pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     4766           pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     4767           pychk_sum-promo = GetPromoPriceSum(ub.chk-doc.doc-code)
     4768           .
