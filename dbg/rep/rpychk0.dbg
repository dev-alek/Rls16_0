     5469                     and temp-chk-gds.jjo_ = pychk_kk - pychk_jjp
     5470                     and temp-chk-gds.line-num = 0
     5471                   no-error .
     5472             end.
     5473             if not available temp-chk-gds
     5474             or (temp-chk-gds.sum = 0
     5475                 or
     5476                 (temp-chk-gds.sum <= 0  and ub.chk-doc.netto > 0)
     5477                 )
     5478             then do:
     5479               NEXT _repeat.
     5480             end.
     5481             assign
