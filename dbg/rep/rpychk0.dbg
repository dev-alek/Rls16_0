     2399       temp-chk-pay.num-lines = temp-chk-pay.num-lines  + 1
     2400       .
     2401     end.
     2402     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     2403     if last-of(ub.chk-pay.doc-code) then do:
     2404       for each temp-chk-pay where
     2405               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     2406          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     2407             and temp-chk-pay.tot-r-b <> 0
     2408             and abs(ub.chk-doc.netto) > 0.00000001
     2409          then do:
     2410             if not g#auto then do:
     2411                message
     2412                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     2413                             ,ub.chk-doc.doc-code
     2414                             ,chr(10)
     2415                             ,ub.chk-doc.obj-type
     2416                             ,ub.chk-doc.obj-code
     2417                             ,ub.chk-doc.shift-date
     2418                             ,ub.chk-doc.shift-num
     2419                             ,ub.chk-doc.pay-desk
     2420                             ,ub.chk-doc.chk-num)
     2421                   view-as alert-box error .
     2422             end.
     2423             next _chk-doc.
     2424          end.
     2425       end.
     2426       for each temp-chk-pay where
     2427               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     2428       break
     2429       by temp-chk-pay.pet-good descending
     2430       by temp-chk-pay.line-num:
     2431          dp:
     2432          for each temp-chk-dp no-lock
     2433             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     2434               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
