     4837                                                       , temp-chk-pay.doc-code
     4838                                                       , ub.chk-doc.obj-type
     4839                                                       , ub.chk-doc.obj-code
     4840                                                       , buf_temp-chk-gds.line-num
     4841                                                       , temp-chk-pay.line-num).
     4842                        create buf_chk-gds-pay.
     4843                     end.
     4844                 end.
     4845                 else do:
     4846                      if can-find (first buf_chk-gds-pay no-lock where
     4847                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4848                                  and buf_chk-gds-pay.algo-num = "1.8"
     4849                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4850                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     4851                                      )
     4852                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     4853                                                       , temp-chk-pay.doc-code
     4854                                                       , ub.chk-doc.obj-type
     4855                                                       , ub.chk-doc.obj-code
     4856                                                       , buf_temp-chk-gds.line-num
