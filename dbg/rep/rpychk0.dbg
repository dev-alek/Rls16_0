     4703                     buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     4704                     .
     4705                   assign
     4706                   buf_temp-chk-gds.sum = buf_temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     4707                   temp-chk-gds.sum =  temp-chk-gds.sum - buf_chk-gds-pay.tot-r-b
     4708                   buf_temp-chk-gds.doc-qnty = buf_temp-chk-gds.doc-qnty - buf_chk-gds-pay.eff-doc-qnty
     4709                   temp-chk-pay.tot-r-b = temp-chk-pay.tot-r-b - buf_chk-gds-pay.tot-r-b
     4710                   pychk_dop-sumk = pychk_dop-sumk - buf_chk-gds-pay.tot-r-b
     4711                   .
     4712                    if (ub.chk-doc.chk-type = 1 and temp-chk-pay.tot-r-b <= 0) or (ub.chk-doc.chk-type <> 1 and temp-chk-pay.tot-r-b >= 0) then leave dp.
     4713               end.
     4714           end.
     4715         assign
     4716         pychk_dop-sump = temp-chk-pay.tot-r-b
     4717         pychk_exch = if pychk_No-exch then 1
     4718                      else (if temp-chk-pay.tot-base = 0
     4719                            then 0
     4720                            else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     4721         pychk_exch-rubl = if pychk_No-exch-rubl
     4722                           then 1
     4723                           else (if temp-chk-pay.tot-base = 0
     4724                                 then 0
     4725                                 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base)
     4726         temp-chk-pay.flag = (if abs(temp-chk-pay.tot-rubl) < 0.001 then no else yes)
     4727         .
     4728         _repeat:
     4729         REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     4730           if pychk_dop-sumg = 0 then do:
     4731             assign
     4732             pychk_kk = pychk_kk + 1
     4733             .
     4734             if pychk_kk >= pychk_jj then LEAVE _repeat.
     4735             if pychk_kk <= pychk_jjp then do:
     4736               find first temp-chk-gds where
     4737                       temp-chk-gds.doc-code = ub.chk-doc.doc-code
     4738                     and temp-chk-gds.jjp_ = pychk_kk
     4739                     and temp-chk-gds.line-num = 0
     4740                   no-error .
     4741             end.
     4742             else do:
