     5533                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     5534                                   )
     5535                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     5536                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     5537                 end.
     5538                 else
