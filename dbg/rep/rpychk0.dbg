     4809                                   and buf_chk-gds-pay.line-num = vPromoLineNum
     4810                                   )
     4811                      then vSum = (pychk_dop-sumk * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     4812                      else vSum = ((pychk_dop-sumk - pychk_sum-promo) * buf_temp-chk-gds.sum / (temp-chk-gds.sum - pychk_sum-promo)).
     4813                 end.
