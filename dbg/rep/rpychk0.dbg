     5371                       end.
     5372                   end case.
     5373                   pychk_dop-sumk =  if temp-chk-dp.sum >= 0
     5374                   then min(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum,temp-chk-pay.tot-r-b)
     5375                   else max(temp-chk-dp.all-sum,temp-chk-dp.sum,buf_temp-chk-gds.sum).
     5376                   if abs(temp-chk-pay.tot-r-b - pychk_dop-sumk) <= 0.001
     5377                   then
     5378                      pychk_dop-sumk = temp-chk-pay.tot-r-b.
     5379                   temp-chk-dp.all-sum           = temp-chk-dp.all-sum - pychk_dop-sumk.
     5380                   if can-find (first buf_chk-gds-pay no-lock where
     5381                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     5382                                  and buf_chk-gds-pay.algo-num = "1.8"
     5383                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     5384                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     5385                                      )
     5386                   then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     5387                                                       , temp-chk-pay.doc-code
     5388                                                       , ub.chk-doc.obj-type
     5389                                                       , ub.chk-doc.obj-code
     5390                                                       , buf_temp-chk-gds.line-num
     5391                                                       , temp-chk-pay.line-num).
     5392                   create buf_chk-gds-pay.
     5393                     assign
     5394                     buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
