     5611                 buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     5612                 buf_temp-chk-gds.flag = yes
     5613                 .
     5614                 if buf_temp-chk-gds.line-num = vPromoLineNum
     5615                 then do:
     5616                    buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty.
     5617                 end.
     5618                 else
     5619                 buf_chk-gds-pay.eff-doc-qnty = (if buf_chk-gds-pay.eff-doc-qnty = ? then 0 else buf_chk-gds-pay.eff-doc-qnty) + (if (temp-chk-gds.num-lines = 1
     5620                                                 and abs(pychk_dop-sumk) <= abs(temp-chk-gds.sum)
     5621                                                 and pychk_pays_count = 1)
     5622                                                 or (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt) = 0
     5623                                                 then temp-chk-gds.doc-qnty
     5624                                                 else (vSum / (buf_temp-chk-gds.price-base - buf_temp-chk-gds.discnt))
     5625                                                 )
     5626                 .
     5627               end.
     5628           end.
     5629         end.
     5630       end.
     5631       if available temp-chk-gds then release temp-chk-gds.
     5632       if available temp-chk-pay then release temp-chk-pay.
     5633       pychk_zero-gds = 0.
     5634       pychk_zero-pay = 0.
     5635       for each temp-chk-gds where
     5636               temp-chk-gds.doc-code = ub.chk-pay.doc-code
     5637           and temp-chk-gds.flag = no
     5638           and temp-chk-gds.line-num  > 0
     5639           :
     5640          pychk_zero-gds = pychk_zero-gds + 1.
     5641       end.
     5642       for each temp-chk-pay where
     5643               temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5644           and temp-chk-pay.flag = no:
     5645          pychk_zero-pay = pychk_zero-pay + 1.
     5646       end.
     5647       find first temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5648                                 and temp-chk-pay.flag = no
     5649       no-lock no-error.
     5650       if not available temp-chk-pay
     5651       then do:
     5652          block-pay:
     5653          for each temp-chk-pay where temp-chk-pay.doc-code = ub.chk-pay.doc-code:
     5654             assign
     5655                pychk_zero-pay = pychk_zero-pay +  1
     5656                temp-chk-pay.flag = no
     5657             .
     5658             leave block-pay.
     5659          end.
     5660       end.
     5661       for each temp-chk-pay
     5662       where   temp-chk-pay.doc-code = ub.chk-pay.doc-code
     5663           and temp-chk-pay.flag = no:
     5664         pychk_zero-n = 0.
     5665         for each buf_temp-chk-gds
     5666         where   buf_temp-chk-gds.doc-code = ub.chk-pay.doc-code
     5667             and buf_temp-chk-gds.flag = no
     5668             and buf_temp-chk-gds.line-num  > 0 :
     5669           pychk_zero-n = pychk_zero-n + 1.
     5670           if  temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 and abs(buf_temp-chk-gds.sum) > 0 then next.
     5671           case num-entries(buf_temp-chk-gds.line-type, chr(4)):
     5672             when 1 then do:
     5673               pychk_line-type-chr = buf_temp-chk-gds.line-type + chr(4) + chr(4) + string(temp-chk-pay.num-lines).
     5674             end.
     5675             when 2 then do:
     5676               pychk_line-type-chr = buf_temp-chk-gds.line-type +                chr(4) + string(temp-chk-pay.num-lines).
     5677             end.
     5678           end case.
     5679           if can-find(first buf_chk-gds-pay no-lock where
     5680                             buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     5681                         and buf_chk-gds-pay.algo-num = "1.8"
     5682                         and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     5683                         and buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num)
     5684           then do:
     5685               buf_temp-chk-gds.flag = yes.
     5686           end.
     5687           else do:
     5688               create buf_chk-gds-pay.
     5689               assign
     5690               buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     5691               buf_chk-gds-pay.algo-num = "1.8"
     5692               buf_chk-gds-pay.pay-code = temp-chk-pay.pay-code
     5693               buf_chk-gds-pay.curr-code = temp-chk-pay.curr-code
     5694               buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     5695               buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     5696               buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     5697               buf_chk-gds-pay.tot-r-b = 0
     5698               buf_chk-gds-pay.eff-base-rate = pychk_exch
     5699               buf_chk-gds-pay.eff-doc-qnty = buf_temp-chk-gds.doc-qnty
     5700               buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     5701               buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     5702               buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
     5703               buf_chk-gds-pay.price-base = (if temp-chk-pay.tot-r-b = 0 and buf_temp-chk-gds.discnt = 0 then 0 else buf_temp-chk-gds.price-base)
     5704               buf_chk-gds-pay.price-service = buf_temp-chk-gds.price-service
     5705               buf_chk-gds-pay.line-sign = buf_temp-chk-gds.line-sign
     5706               buf_chk-gds-pay.line-type = pychk_line-type-chr
     5707               buf_chk-gds-pay.rec-type = buf_temp-chk-gds.rec-type
     5708               buf_chk-gds-pay.density  = buf_temp-chk-gds.density
     5709               buf_chk-gds-pay.chk-date = ub.chk-doc.chk-date
     5710               buf_chk-gds-pay.chk-time = ub.chk-doc.chk-time
     5711               buf_chk-gds-pay.obj-type = ub.chk-doc.obj-type
     5712               buf_chk-gds-pay.obj-code = ub.chk-doc.obj-code
     5713               buf_chk-gds-pay.out-code = ub.chk-doc.out-code
     5714               buf_chk-gds-pay.shift-date = ub.chk-doc.shift-date
     5715               buf_chk-gds-pay.shift-num = ub.chk-doc.shift-num
     5716               buf_chk-gds-pay.shift-name= ub.chk-doc.shift-name
     5717               buf_temp-chk-gds.flag = yes
     5718               .
     5719           end.
     5720           if pychk_zero-n > pychk_zero-gds / pychk_zero-pay then leave.
     5721         end.
     5722         temp-chk-pay.flag = yes.
     5723       end.
     5724     end.
     5725   end.
     5726   end.
     5727       end.
     5728     end.
     5729     otherwise do:
     5730       message
     5731       substitute("&1&2&3Неверное значение p-caller=&4"
     5732                  ,vss-workfile
     5733                  ,vss-revision
     5734                  ,vss-description
     5735                  , p-caller)
     5736       view-as alert-box error .
     5737     end.
     5738   end case.
     5739   define variable v-err-msg as character no-undo .
     5740   catch exAppErrors as class Progress.Lang.AppError :
     5741       v-err-msg = exAppErrors:ReturnValue .
     5742       if v-err-msg > "" then . else do :
