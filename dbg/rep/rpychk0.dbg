     4099                                                       , temp-chk-pay.doc-code
     4100                                                       , ub.chk-doc.obj-type
     4101                                                       , ub.chk-doc.obj-code
     4102                                                       , buf_temp-chk-gds.line-num
     4103                                                       , temp-chk-pay.line-num).
     4104                        create buf_chk-gds-pay.
     4105                     end.
     4106                 end.
     4107                 else do:
     4108                      if can-find (first buf_chk-gds-pay no-lock where
     4109                                      buf_chk-gds-pay.doc-code = temp-chk-pay.doc-code
     4110                                  and buf_chk-gds-pay.algo-num = "1.8"
     4111                                  and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num
     4112                                  and buf_chk-gds-pay.cpline-num = int(temp-chk-pay.line-num)
     4113                                      )
     4114                      then undo create-block, return error substitute("Уже есть платеж: чек &1 &2&3 строка &4 строка &5"
     4115                                                       , temp-chk-pay.doc-code
     4116                                                       , ub.chk-doc.obj-type
