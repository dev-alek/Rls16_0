     4587       .
     4588     end.
     4589     if available temp-chk-pay then RELEASE TEMP-CHK-PAY.
     4590     if last-of(ub.chk-pay.doc-code) then do:
     4591       for each temp-chk-pay where
     4592               temp-chk-pay.doc-code = ub.chk-doc.doc-code:
     4593          if    (temp-chk-pay.tot-r-b  >= 0) NE (ub.chk-doc.netto >= 0)
     4594             and temp-chk-pay.tot-r-b <> 0
     4595             and abs(ub.chk-doc.netto) > 0.00000001
     4596          then do:
     4597             if not g#auto then do:
     4598                message
     4599                   substitute("Не могу обработать чек &1&2&3&4 смена &5 пор.&6 касса &7 № на кассе &8"
     4600                             ,ub.chk-doc.doc-code
     4601                             ,chr(10)
     4602                             ,ub.chk-doc.obj-type
     4603                             ,ub.chk-doc.obj-code
     4604                             ,ub.chk-doc.shift-date
     4605                             ,ub.chk-doc.shift-num
     4606                             ,ub.chk-doc.pay-desk
     4607                             ,ub.chk-doc.chk-num)
     4608                   view-as alert-box error .
     4609             end.
     4610             next _chk-doc.
     4611          end.
     4612       end.
     4613       for each temp-chk-pay where
     4614               temp-chk-pay.doc-code = ub.chk-doc.doc-code
     4615       break
     4616       by temp-chk-pay.pet-good descending
     4617       by temp-chk-pay.line-num:
     4618          dp:
     4619          for each temp-chk-dp no-lock
     4620             where temp-chk-dp.pay-code = temp-chk-pay.pay-code
     4621               and temp-chk-dp.doc-code = temp-chk-pay.doc-code
     4622               and temp-chk-dp.sum <> 0 :
