     5591                 buf_chk-gds-pay.cpline-num = temp-chk-pay.line-num
     5592                 buf_chk-gds-pay.pay-card = temp-chk-pay.pay-card
     5593                 buf_chk-gds-pay.tot-r-b = buf_chk-gds-pay.tot-r-b  + vSum
     5594                 buf_chk-gds-pay.eff-base-rate = pychk_exch
     5595                 buf_chk-gds-pay.b-code = buf_temp-chk-gds.b-code
     5596                 buf_chk-gds-pay.gds-code = buf_temp-chk-gds.gds-code
     5597                 buf_chk-gds-pay.discnt = buf_temp-chk-gds.discnt
