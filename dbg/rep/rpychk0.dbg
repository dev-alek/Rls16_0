     4789                 temp-chk-gds.num-lines > 1 and
     4790                 buf_temp-chk-gds.line-num = vPromoLineNum and
     4791                 can-find(first buf_chk-gds-pay no-lock where
     4792                                buf_chk-gds-pay.doc-code = buf_temp-chk-gds.doc-code
     4793                            and buf_chk-gds-pay.line-num = buf_temp-chk-gds.line-num)
     4794             then .
     4795             else
     4796             if not (buf_temp-chk-gds.sum = 0 and can-find (first temp-chk-dp no-lock where temp-chk-dp.pay-code = temp-chk-pay.pay-code and temp-chk-dp.doc-code = temp-chk-pay.doc-code and buf_temp-chk-gds.line-num  =  temp-chk-dp.line-num)) then do:
     4797                 if vPromoLineNum <> 0 and
     4798                    buf_temp-chk-gds.line-num = vPromoLineNum
     4799                 then do:
     4800                    vSum = RoundUp(buf_temp-chk-gds.doc-qnty, buf_temp-chk-gds.price-base).
