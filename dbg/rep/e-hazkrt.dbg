      834   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      835   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      836   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      837   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      838   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      839   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      840   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      841   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      842         adm-object-hdl = FRAME F-Main:HANDLE.
      843   RUN ensure-broker.
      844   THIS-PROCEDURE:ADM-DATA =
      845        'ADM1.1~`':U +
      846        'SmartViewer~`':U +
      847        '~`':U +
      848        'NO ~`':U +
      849        '~`':U +
      850        '~`':U +
      851        '~`':U +
      852        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      853           + "~`":U +
      854        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      855        'Record-Source,Record-Target,TableIO-Target~`':U +
      856        '~`':U +
      857        '~`~`~`~`~`~`~`~`~`~`~`':U +
      858        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      859            THEN "^^":U
      860        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      861             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      862   PROCEDURE adm-apply-entry :
      863     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      864   END PROCEDURE.
      865   PROCEDURE adm-destroy :
      866    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      867   END PROCEDURE.
      868   PROCEDURE adm-disable :
      869       DISABLE fi-date-start fi-date-end fi-time-start fi-time-end WITH FRAME F-Main.
      870       RUN dispatch ('disable-fields':U).
      871       RUN set-attribute-list ('ENABLED=no':U).
      872       RETURN.
      873   END PROCEDURE.
      874   PROCEDURE adm-edit-attribute-list :
      875         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      876         RETURN.
      877   END PROCEDURE.
      878   PROCEDURE adm-enable :
      879       ENABLE UNLESS-HIDDEN fi-date-start fi-date-end fi-time-start fi-time-end WITH FRAME F-Main.
      880       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      881       RUN set-attribute-list ('ENABLED=yes':U).
      882       RETURN.
      883   END PROCEDURE.
      884   PROCEDURE adm-exit :
      885        RUN notify ('exit':U).
      886     RETURN.
      887   END PROCEDURE.
      888   PROCEDURE adm-hide :
      889     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      890   END PROCEDURE.
      891   PROCEDURE adm-initialize :
      892     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      893   END PROCEDURE.
      894   PROCEDURE adm-show-errors :
      895       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      896       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      897           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      898       END.
      899       RETURN.
      900   END PROCEDURE.
      901   PROCEDURE adm-UIB-mode :
      902     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      903   END PROCEDURE.
      904   PROCEDURE adm-view :
      905     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      906   END PROCEDURE.
      907   PROCEDURE dispatch :
      908       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      909       RUN broker-dispatch IN adm-broker-hdl
      910           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      911       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      912   END PROCEDURE.
      913   PROCEDURE ensure-broker :
      914   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      915   IF RETURN-VALUE NE "ADM-Broker":U THEN
      916   DO:
      917       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      918       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      919   END.
      920   END PROCEDURE.
      921   PROCEDURE get-attribute :
      922     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      923     RUN broker-get-attribute IN adm-broker-hdl
      924         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      925     RETURN RETURN-VALUE.
      926   END PROCEDURE.
      927   PROCEDURE get-attribute-list :
      928     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      929     RUN broker-get-attribute-list IN adm-broker-hdl
      930         (INPUT THIS-PROCEDURE,
      931          INPUT ?,
      932          OUTPUT p-attr-list) NO-ERROR.
      933     RETURN.
      934   END PROCEDURE.
      935   PROCEDURE new-state :
      936     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      937     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      938     RETURN.
      939   END PROCEDURE.
      940   PROCEDURE notify :
      941     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      942     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      943     IF RETURN-VALUE = "ADM-ERROR":U THEN
      944         RETURN "ADM-ERROR":U.
      945     RETURN.
      946   END PROCEDURE.
      947   PROCEDURE set-attribute-list :
      948     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      949     RUN ensure-broker.
      950     RUN broker-set-attribute-list IN adm-broker-hdl
      951         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      952     RETURN.
      953   END PROCEDURE.
      954   PROCEDURE set-position :
      955       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      956       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      957       IF VALID-HANDLE(adm-object-hdl) THEN
      958       DO:
      959         ASSIGN adm-object-hdl:ROW    =   p-row
      960                adm-object-hdl:COLUMN =   p-col.
      961       END.
      962       RETURN.
      963   END PROCEDURE.
      964   PROCEDURE adm-display-fields :
      965       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      966       RETURN.
      967   END PROCEDURE.
      968   PROCEDURE adm-open-query :
      969     RETURN.
      970   END PROCEDURE.
      971   PROCEDURE adm-row-changed :
      972         IF VALID-HANDLE(adm-object-hdl) THEN
      973           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      974         RUN notify ('row-available':U).
      975         RETURN.
      976   END PROCEDURE.
      977   PROCEDURE reposition-query :
      978       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      979       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      980       RETURN.
      981   END PROCEDURE.
