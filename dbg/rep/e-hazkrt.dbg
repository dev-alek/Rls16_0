     1054   END PROCEDURE.
     1055   PROCEDURE adm-update-record :
     1056       MESSAGE
     1057         "Object ":U THIS-PROCEDURE:FILE-NAME
     1058           "must have at least one Enabled Table to perform Update.":U
     1059             VIEW-AS ALERT-BOX ERROR.
     1060      RETURN.
     1061   END PROCEDURE.
     1062   PROCEDURE check-modified :
     1063   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1064   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1065   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1066   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1067     IF check-state = "check":U THEN
     1068     DO:
     1069       RUN get-link-handle IN adm-broker-hdl
     1070         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1071            OUTPUT group-target-list).
     1072       IF group-target-list NE "":U THEN
     1073       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1074         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1075         RUN check-modified IN curr-widget ('group-check':U).
     1076         IF RETURN-VALUE NE "":U THEN
     1077         DO:
     1078           RUN check-modified-message(RETURN-VALUE).
     1079           RETURN "":U.
     1080         END.
     1081       END.
     1082     END.
     1083     RETURN "":U.
     1084   END PROCEDURE.
     1085   PROCEDURE check-modified-message :
     1086     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1087        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1088           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1089        IF RETURN-VALUE = "YES":U THEN
     1090           RUN notify ('view,CONTAINER-SOURCE':U).
     1091        MESSAGE IF p-changed-table NE ? THEN
     1092           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1093           ELSE "Current values have been changed."
     1094           SKIP "  Do you wish to save those changes?"
     1095           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1096        IF ANS THEN
     1097        DO:
     1098           IF group-assign-target THEN
     1099             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1100           ELSE RUN dispatch('update-record':U).
     1101           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1102           DO:
     1103               MESSAGE "Changes to the previous record were not saved."
     1104                 VIEW-AS ALERT-BOX ERROR.
     1105               IF group-assign-target THEN
     1106                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1107               ELSE RUN dispatch ('cancel-record':U).
     1108           END.
     1109        END.
     1110        ELSE DO:
     1111          IF group-assign-target THEN
     1112             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1113          ELSE RUN dispatch('cancel-record':U).
     1114        END.
     1115        RETURN.
     1116   END PROCEDURE.
     1117   PROCEDURE get-rowid :
     1118       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1119       ASSIGN
     1120       p-table   =   adm-first-table.
     1121       RETURN.
     1122   END PROCEDURE.
     1123   PROCEDURE init-group-assign :
     1124       RUN request-attribute IN adm-broker-hdl
     1125         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1126       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1127         group-assign-target = yes.
     1128       ELSE group-assign-target = no.
     1129       RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE set-editors :
     1132       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1133       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1134       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1135       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1136       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1137       DO WHILE VALID-HANDLE (curr-widget):
     1138           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1139              curr-widget:HIDDEN = no THEN DO:
     1140             CASE p-field-setting:
     1141               WHEN "INITIALIZE":U THEN
     1142               DO:
     1143                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1144                     read-only-list +
     1145                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1146                        STRING(curr-widget).
     1147               END.
     1148               WHEN "DISABLE":U OR
     1149               WHEN "ENABLE":U THEN
     1150               DO:
     1151                   curr-widget:SENSITIVE = yes.
     1152                   RUN get-attribute ('Read-Only-Editors':U).
     1153                   IF RETURN-VALUE = ? OR
     1154                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1155                       curr-widget:READ-ONLY =
     1156                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1157               END.
     1158               WHEN "CLEAR":U THEN
     1159                   curr-widget:SCREEN-VALUE = "":U.
     1160             END CASE.
     1161           END.
     1162           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1163       END.
     1164       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1165         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1166           + '"':U).
     1167       RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE use-check-modified-all :
     1170    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1171     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1172     RETURN.
     1173   END PROCEDURE.
     1174   PROCEDURE use-create-on-add :
     1175   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1176      RETURN.
     1177   END PROCEDURE.
     1178   PROCEDURE use-initial-lock :
     1179     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1180     ASSIGN adm-initial-lock = p-attr-value.
     1181     RETURN.
     1182   END PROCEDURE.
     1183     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1184   ASSIGN
     1185          FRAME F-Main:SCROLLABLE       = FALSE
     1186          FRAME F-Main:HIDDEN           = TRUE.
     1187   ON LEAVE OF fi-date-end IN FRAME F-Main
     1188   DO:
     1189     assign
     1190         fi-date-end
     1191     .
     1192   END.
     1193   ON LEAVE OF fi-date-start IN FRAME F-Main
     1194   DO:
     1195     assign fi-date-start.
     1196   END.
     1197   ON LEAVE OF fi-time-end IN FRAME F-Main
     1198   DO:
     1199       DEFINE VARIABLE v-ok AS LOGICAL    NO-UNDO.
     1200       run check-time-format in this-procedure ( input self :handle
     1201                                               , output v-ok
     1202                                               ) .
     1203       if not v-ok then do:
     1204           message
     1205               "Неправильное значение времени."
     1206           view-as alert-box error.
     1207           return no-apply.
     1208       end.
     1209       assign
     1210           fi-time-end
     1211       .
     1212       run get-time-in-sec in this-procedure ( input fi-time-end
     1213                                             , output v-time-end-sec
     1214                                             ) no-error .
     1215       if error-status :error then return no-apply.
     1216   END.
     1217   ON LEAVE OF fi-time-start IN FRAME F-Main
     1218   DO:
     1219     DEFINE VARIABLE v-ok AS LOGICAL    NO-UNDO.
     1220     run check-time-format in this-procedure ( input self :handle
     1221                                             , output v-ok
     1222                                             ) .
     1223     if not v-ok then do:
     1224         message
     1225             "Неправильное значение времени."
     1226         view-as alert-box error.
     1227         return no-apply.
     1228     end.
     1229     assign
     1230         fi-time-start
     1231     .
     1232     run get-time-in-sec in this-procedure ( input fi-time-start
     1233                                           , output v-time-start-sec
     1234                                           ) no-error .
     1235     if error-status :error then return no-apply.
     1236   END.
     1237   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   on ' ' of fi-date-start in frame F-Main
     1239   do:
     1240     if (can-query (self, "sensitive")
     1241        and
     1242        self :sensitive = true
     1243        )
     1244     or (can-query (self, "read-only")
     1245        and
     1246        self :read-only = false
     1247        )
     1248     then do:
     1249       assign
     1250         self :screen-value = ?
     1251       .
     1252     end.
     1253     return no-apply.
     1254   end.
     1255   on delete-character of fi-date-start in frame F-Main
     1256   do:
     1257     if (can-query (self, "sensitive")
     1258        and
     1259        self :sensitive = true
     1260        )
     1261     or (can-query (self, "read-only")
     1262        and
     1263        self :read-only = false
     1264        )
     1265     then do:
     1266       assign
     1267         self :screen-value = ?
     1268       .
     1269     end.
     1270     return no-apply.
     1271   end.
     1272   on ctrl-d of fi-date-start in frame F-Main
     1273   do:
     1274     define variable v-curr-sv-date as date no-undo .
     1275     if (can-query (self, "sensitive")
     1276        and
     1277        self :sensitive = true
     1278        )
     1279     or (can-query (self, "read-only")
     1280        and
     1281        self :read-only = false
     1282        )
     1283     then do:
     1284       if self :handle <> focus :handle
     1285       then do:
     1286         apply "entry":u to self .
     1287       end.
     1288       run gbl/getcurdt.p
     1289         (output v-curr-sv-date
     1290         ) .
     1291       assign
     1292         self :screen-value = string(v-curr-sv-date) .
     1293       .
     1294     end.
     1295     return no-apply.
     1296   end.
     1297   on ctrl-b of fi-date-start in frame F-Main
     1298   do:
     1299     if (can-query (self, "sensitive")
     1300        and
     1301        self :sensitive = true
     1302        )
     1303     or (can-query (self, "read-only")
     1304        and
     1305        self :read-only = false
     1306        )
     1307     then do:
     1308       if self :handle <> focus :handle
     1309       then do:
     1310         apply "entry":u to self .
     1311       end.
     1312       define variable v-curr-sv-date as date no-undo .
     1313       define variable v-new-sv-date  as date no-undo .
     1314       assign
     1315         v-curr-sv-date = date(self :screen-value) no-error
     1316       .
     1317       if v-curr-sv-date = ?
     1318       then do:
     1319         run gbl/getcurdt.p
     1320           (output v-curr-sv-date
     1321           ) .
     1322       end.
     1323       if v-curr-sv-date <> ?
     1324       then do:
     1325         assign
     1326           v-new-sv-date = date( month(v-curr-sv-date), 1, year(v-curr-sv-date))
     1327         .
     1328         assign
     1329           self :screen-value = string(v-new-sv-date) .
     1330         .
     1331       end.
     1332     end.
     1333     return no-apply .
     1334   end.
     1335   on ctrl-e of fi-date-start in frame F-Main
     1336   do:
     1337     if (can-query (self, "sensitive")
     1338        and
     1339        self :sensitive = true
     1340        )
     1341     or (can-query (self, "read-only")
     1342        and
     1343        self :read-only = false
     1344        )
     1345     then do:
     1346       if self :handle <> focus :handle
     1347       then do:
     1348         apply "entry":u to self .
     1349       end.
     1350       define variable v-curr-sv-date as date no-undo .
     1351       define variable v-new-sv-date  as date no-undo .
     1352       assign
     1353         v-curr-sv-date = date(self :screen-value) no-error
     1354       .
     1355       if v-curr-sv-date = ?
     1356       then do:
     1357         run gbl/getcurdt.p
     1358           (output v-curr-sv-date
     1359           ) .
     1360       end.
     1361       if v-curr-sv-date <> ?
     1362       then do:
     1363         run gbl/lastdate.p
     1364           (input  v-curr-sv-date
     1365           ,output v-new-sv-date
     1366           ).
     1367         assign
     1368           self :screen-value = string(v-new-sv-date) .
     1369         .
     1370       end.
     1371     end.
     1372     return no-apply .
     1373   end.
     1374   on ctrl-f of fi-date-start in frame F-Main
     1375   do:
     1376     if (can-query (self, "sensitive")
     1377        and
     1378        self :sensitive = true
     1379        )
     1380     or (can-query (self, "read-only")
     1381        and
     1382        self :read-only = false
     1383        )
     1384     then do:
     1385       if self :handle <> focus :handle
     1386       then do:
     1387         apply "entry":u to self .
     1388       end.
     1389       define variable v-ok            as logical   no-undo .
     1390       define variable v-curr-sv-date  as date      no-undo .
     1391       define variable v-description   as character no-undo .
     1392       assign
     1393         v-curr-sv-date = date(self :screen-value) no-error
     1394       .
     1395       if v-curr-sv-date = ?
     1396       then do:
     1397         run gbl/getcurdt.p
     1398           (output v-curr-sv-date
     1399           ) .
     1400       end.
     1401       if v-curr-sv-date <> ?
     1402       then do:
     1403         run gbl/d-inpday.w
     1404           (input ?
     1405           ,input "Выбор даты"
     1406           ,input v-description
     1407           ,input ""
     1408           ,input-output v-curr-sv-date
     1409           ,output v-ok
     1410           ).
     1411         if v-ok = true
     1412         then do:
     1413           assign
     1414             self :screen-value = string(v-curr-sv-date) .
     1415           .
     1416         end.
     1417       end.
     1418     end.
     1419     return no-apply .
     1420   end.
     1421     define MENU m-ed-date10
     1422       MENU-ITEM m-ed-date10-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1423       MENU-ITEM m-ed-date10-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1424       MENU-ITEM m-ed-date10-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1425       MENU-ITEM m-ed-date10-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1426       .
