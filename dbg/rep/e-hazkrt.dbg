     1428     then do:
     1429       ASSIGN
     1430         fi-date-start :POPUP-MENU in frame F-Main = MENU m-ed-date10 :HANDLE
     1431         fi-date-start :MENU-MOUSE in frame F-Main = 3
     1432       .
     1433     end.
     1434     define variable v-label-handle10 as handle no-undo .
     1435     assign
     1436       v-label-handle10 = fi-date-start :side-label-handle in frame F-Main
     1437     .
     1438     if valid-handle (v-label-handle10)
     1439     then do:
     1440       if v-label-handle10 :tooltip = ""
     1441       or v-label-handle10 :tooltip = ?
     1442       then do:
     1443         assign
     1444           v-label-handle10 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1445         .
     1446       end.
     1447     end.
     1448     ON CHOOSE OF MENU-ITEM m-ed-date10-1 in menu m-ed-date10 DO:
     1449       apply "ctrl-b":U to fi-date-start in frame F-Main .
     1450     END.
     1451     ON CHOOSE OF MENU-ITEM m-ed-date10-2 in menu m-ed-date10 DO:
     1452       apply "ctrl-d":U to fi-date-start in frame F-Main .
     1453     END.
     1454     ON CHOOSE OF MENU-ITEM m-ed-date10-3 in menu m-ed-date10 DO:
     1455       apply "ctrl-e":U to fi-date-start in frame F-Main .
     1456     END.
     1457     ON CHOOSE OF MENU-ITEM m-ed-date10-4 in menu m-ed-date10 DO:
     1458       apply "ctrl-f":U to fi-date-start in frame F-Main .
     1459     END.
