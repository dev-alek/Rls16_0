     1598   do:
     1599     if (can-query (self, "sensitive")
     1600        and
     1601        self :sensitive = true
     1602        )
     1603     or (can-query (self, "read-only")
     1604        and
     1605        self :read-only = false
     1606        )
     1607     then do:
     1608       if self :handle <> focus :handle
     1609       then do:
     1610         apply "entry":u to self .
     1611       end.
     1612       define variable v-ok            as logical   no-undo .
     1613       define variable v-curr-sv-date  as date      no-undo .
     1614       define variable v-description   as character no-undo .
     1615       assign
     1616         v-curr-sv-date = date(self :screen-value) no-error
     1617       .
     1618       if v-curr-sv-date = ?
     1619       then do:
     1620         run gbl/getcurdt.p
     1621           (output v-curr-sv-date
     1622           ) .
     1623       end.
     1624       if v-curr-sv-date <> ?
     1625       then do:
     1626         run gbl/d-inpday.w
     1627           (input ?
     1628           ,input "Выбор даты"
     1629           ,input v-description
     1630           ,input ""
     1631           ,input-output v-curr-sv-date
     1632           ,output v-ok
     1633           ).
     1634         if v-ok = true
     1635         then do:
     1636           assign
     1637             self :screen-value = string(v-curr-sv-date) .
     1638           .
     1639         end.
     1640       end.
     1641     end.
     1642     return no-apply .
     1643   end.
     1644     define MENU m-ed-date12
     1645       MENU-ITEM m-ed-date12-1 LABEL "Начало месяца" ACCELERATOR "ALT-1"
     1646       MENU-ITEM m-ed-date12-2 LABEL "Сегодня"       ACCELERATOR "ALT-2"
     1647       MENU-ITEM m-ed-date12-3 LABEL "Конец месяца"  ACCELERATOR "ALT-3"
     1648       MENU-ITEM m-ed-date12-4 LABEL "Календарь"     ACCELERATOR "ALT-4"
     1649       .
     1650     if fi-date-end :POPUP-MENU in frame F-Main = ?
     1651     then do:
     1652       ASSIGN
     1653         fi-date-end :POPUP-MENU in frame F-Main = MENU m-ed-date12 :HANDLE
     1654         fi-date-end :MENU-MOUSE in frame F-Main = 3
     1655       .
     1656     end.
     1657     define variable v-label-handle12 as handle no-undo .
     1658     assign
     1659       v-label-handle12 = fi-date-end :side-label-handle in frame F-Main
     1660     .
     1661     if valid-handle (v-label-handle12)
     1662     then do:
     1663       if v-label-handle12 :tooltip = ""
     1664       or v-label-handle12 :tooltip = ?
     1665       then do:
     1666         assign
     1667           v-label-handle12 :tooltip = "Ctrl-D - текущая, Ctrl-B - начало, Ctrl-E - конец, Ctrl-F - календарь, Прав.Клавиша Мыши - Popup Menu"
     1668         .
     1669       end.
     1670     end.
     1671     ON CHOOSE OF MENU-ITEM m-ed-date12-1 in menu m-ed-date12 DO:
     1672       apply "ctrl-b":U to fi-date-end in frame F-Main .
     1673     END.
     1674     ON CHOOSE OF MENU-ITEM m-ed-date12-2 in menu m-ed-date12 DO:
     1675       apply "ctrl-d":U to fi-date-end in frame F-Main .
     1676     END.
     1677     ON CHOOSE OF MENU-ITEM m-ed-date12-3 in menu m-ed-date12 DO:
     1678       apply "ctrl-e":U to fi-date-end in frame F-Main .
     1679     END.
     1680     ON CHOOSE OF MENU-ITEM m-ed-date12-4 in menu m-ed-date12 DO:
     1681       apply "ctrl-f":U to fi-date-end in frame F-Main .
     1682     END.
     1683   PROCEDURE check-time-format :
     1684   define input parameter p-fi-handle as handle  no-undo .
     1685   define output parameter p-ok       as logical no-undo .
     1686     define variable v-time-str    as character no-undo .
     1687     define variable v-hh          as integer   no-undo .
     1688     define variable v-mm          as integer   no-undo .
     1689     assign
     1690         v-time-str = p-fi-handle :screen-value
     1691         v-hh = integer(substring(v-time-str,1,2))
     1692         v-mm = integer(substring(v-time-str,4,2))
     1693     .
     1694     if v-hh < 0 or v-hh > 24 then do:
     1695       return.
     1696     end.
     1697     if v-mm < 0 or v-mm > 59 then do:
     1698       return.
     1699     end.
     1700     if v-hh = 24 and v-mm <> 0 then do :
     1701       return.
     1702     end.
     1703     assign
     1704       p-ok = yes
     1705     .
     1706   END PROCEDURE.
     1707   PROCEDURE disable_UI :
     1708     HIDE FRAME F-Main.
     1709     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1710   END PROCEDURE.
     1711   PROCEDURE get-time-in-sec :
     1712   define input  parameter p-str-time as character no-undo .
     1713   define output parameter p-int-time as integer   no-undo .
     1714   do
     1715   on error undo, return error return-value
     1716   :
     1717     define variable v-h as integer   no-undo .
     1718     define variable v-m as integer   no-undo .
     1719     if length( p-str-time ) <> 4 then do:
     1720         message
     1721             "Неверный формат времени"
     1722         view-as alert-box error.
     1723         undo, return error.
     1724     end.
     1725     assign
     1726       v-h = integer( substring( p-str-time,1,2) )
     1727       v-m = integer( substring( p-str-time,3,2) )
     1728     .
     1729     if v-h < 0 or v-h > 24 then do:
     1730         message
     1731             "Диапазон часов задан неверно"
     1732         view-as alert-box error.
     1733         undo, return error.
     1734     end.
     1735     if v-m < 0 or v-m > 59 then do :
     1736         message
     1737             "Диапазон минут задан неверно"
     1738         view-as alert-box error.
     1739       undo, return error.
     1740     end.
     1741     assign
     1742       p-int-time = v-h * 3600 + v-m * 60
     1743     .
     1744   end.
     1745   END PROCEDURE.
     1746   PROCEDURE local-apply-layout :
     1747     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1748     assign
     1749         fi-date-start = today - 1
     1750         fi-date-end   = today
     1751         fi-time-start = "0700":U
     1752         fi-time-end   = "0700":U
     1753     .
     1754     run get-time-in-sec in this-procedure ( input fi-time-start
     1755                                           , output v-time-start-sec
     1756                                           ) .
     1757     run get-time-in-sec in this-procedure ( input fi-time-end
     1758                                           , output v-time-end-sec
     1759                                           ) .
     1760     display
     1761         fi-date-start
     1762         fi-date-end
     1763         fi-time-start
     1764         fi-time-end
     1765     with frame F-Main.
     1766   END PROCEDURE.
     1767   PROCEDURE my-report :
     1768    run rep/r-hazkrt.p ( input fi-date-start
     1769                       , input v-time-start-sec
     1770                       , input fi-date-end
     1771                       , input v-time-end-sec
     1772                       ).
     1773   END PROCEDURE.
     1774   PROCEDURE my-var :
     1775     assign
     1776       ReportHeader =    "Диапазон:" + chr(10)
     1777                      + "    " + "C: " +  string( fi-date-start , "99/99/9999" ) + " " + string( v-time-start-sec , "hh:mm" ) + chr(10)
     1778                      + "    " + "По: " +  string( fi-date-end , "99/99/9999" ) + " " + string( v-time-end-sec , "hh:mm" ) + chr(10)
     1779     .
     1780   END PROCEDURE.
     1781   PROCEDURE state-changed :
     1782     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1783     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1784     CASE p-state:
     1785     END CASE.
     1786     END PROCEDURE.
