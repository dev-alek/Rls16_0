     3498                                    gds-zap-artic +
     3499                                    gds-zap-gds-name +
     3500                                    temp-str-2    )  , num#str# , num#col#  ) .
     3501     num#col#  = 0 .
     3502     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3503     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3504     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3505     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3506     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3507     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3508   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3509   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3510   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3511   def var l-nk as integer no-undo .
     3512     Assign
     3513       LL = 0
     3514       KK = 1
     3515     .
     3516     if xShowCost      Then DO: KK = KK + 1. End.
     3517     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3518     if xShowCrsa      Then DO: KK = KK + 1. End.
     3519     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3520     if xShowSale      Then DO: KK = KK + 1. End.
     3521     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3522     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3523     if xShowmediator  Then DO: KK = KK + 1. End.
     3524     if x-tog-wt       then do: KK = KK + 1. End.
     3525     if x-tog-ms       then do: KK = KK + 1. End.
     3526     if xDens          then do: KK = KK + 1. End.
     3527     repeat i = 1 to 13 :
     3528       if i = 7 then next.
     3529       if NOT xShowCost      and i = 2   Then  next.
     3530       if NOT xShowCostNDS   and i = 3   Then  next.
     3531       if NOT xShowCrsa      and i = 5   Then  next.
     3532       if NOT xShowCrsaNds   and i = 6   Then  next.
     3533       if NOT xShowSale      and i = 8   Then  next.
     3534       if NOT xShowSaleNds   and i = 9   Then  next.
     3535       if NOT xShowSaleSlt   and i = 10  Then  next.
     3536       if NOT xShowmediator  and i = 4   Then  next.
     3537       if not x-tog-wt       and i = 11  then  next.
     3538       if not x-tog-ms       and i = 12  then  next.
     3539       if not xDens          and i = 13  then  next.
     3540       assign
     3541         LL = LL + 1
     3542         l-nk = mp-1
     3543       .
     3544     if x-vat or i <> 2  then do:
     3545     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-ostatok-start                          [i] ,  i). end.
     3546     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ie          [i] ,  i). end.
     3547     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-iv          [i] ,  i). end.
     3548     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-im           [i] ,  i). end.
     3549     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ee          [i] ,  i). end.
     3550     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , b1-oborot-ev          [i] ,  i). end.
