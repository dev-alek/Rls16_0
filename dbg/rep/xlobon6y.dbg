     3162                                                                                               oborot-rs[i]) -
     3163                                                                                             (oborot-ee         [3] +
     3164                                                                                               oborot-re     [3] +
     3165                                                                                               oborot-es    [3] +
     3166                                                                                               oborot-rs[3] ) ) , i ). end.
     3167     end.
     3168     end.
     3169     end.
     3170    run new-tmp-page .
     3171   end procedure.
     3172   procedure display-bi  :
     3173   define variable ll as int no-undo.
     3174   define variable kk as int no-undo.
     3175     num#col#  = 0 .
     3176     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3177     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3178     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3179     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3180     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3181     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3182     run macr_cell_format
     3183                                 ( 10    ,
     3184                                   true  ,
     3185                                   false ,
     3186                                   ?    ,
     3187                                   num#str# ,
     3188                                   1 ,
     3189                                   num#str# ,
     3190                                   (mp + ll + (kk * (27 - 8)))
     3191                                   ) .
     3192   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3193   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3194   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3195   def var l-nk as integer no-undo .
     3196     Assign
     3197       LL = 0
     3198       KK = 1
     3199     .
     3200     if xShowCost      Then DO: KK = KK + 1. End.
     3201     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3202     if xShowCrsa      Then DO: KK = KK + 1. End.
     3203     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3204     if xShowSale      Then DO: KK = KK + 1. End.
     3205     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3206     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3207     if xShowmediator  Then DO: KK = KK + 1. End.
     3208     if x-tog-wt       then do: KK = KK + 1. End.
     3209     if x-tog-ms       then do: KK = KK + 1. End.
     3210     if xDens          then do: KK = KK + 1. End.
     3211     repeat i = 1 to 13 :
     3212       if i = 7 then next.
     3213       if NOT xShowCost      and i = 2   Then  next.
     3214       if NOT xShowCostNDS   and i = 3   Then  next.
     3215       if NOT xShowCrsa      and i = 5   Then  next.
     3216       if NOT xShowCrsaNds   and i = 6   Then  next.
     3217       if NOT xShowSale      and i = 8   Then  next.
     3218       if NOT xShowSaleNds   and i = 9   Then  next.
     3219       if NOT xShowSaleSlt   and i = 10  Then  next.
     3220       if NOT xShowmediator  and i = 4   Then  next.
     3221       if not x-tog-wt       and i = 11  then  next.
     3222       if not x-tog-ms       and i = 12  then  next.
     3223       if not xDens          and i = 13  then  next.
     3224       assign
     3225         LL = LL + 1
     3226         l-nk = mp-1
     3227       .
     3228     if x-vat or i <> 2  then do:
     3229     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-ostatok-start                          [i] ,  i). end.
     3230     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ie          [i] ,  i). end.
     3231     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-iv          [i] ,  i). end.
     3232     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-im           [i] ,  i). end.
     3233     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ee          [i] ,  i). end.
     3234     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-ev          [i] ,  i). end.
     3235     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-em           [i] ,  i). end.
     3236     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-we          [i] ,  i). end.
     3237     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-es     [i] ,  i). end.
     3238     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-rs [i] ,  i). end.
     3239     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bi-oborot-re      [i] ,  i). end.
