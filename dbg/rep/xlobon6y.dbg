     3565          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3566       end.
     3567       else do:
     3568         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(b1-oborot-ee         [1] +
     3569                                                                                                                                       b1-oborot-re     [1] +
     3570                                                                                                                                       b1-oborot-es    [1] +
     3571                                                                                                                                       b1-oborot-rs[1] ) <> 0
     3572                                                                                                                               then
     3573                                                                                                                                   ABS(b1-oborot-ee         [11] +
     3574                                                                                                                                       b1-oborot-re     [11] +
     3575                                                                                                                                       b1-oborot-es    [11] +
     3576                                                                                                                                       b1-oborot-rs[11] )
     3577                                                                                                                                   /
     3578                                                                                                                                   ABS(b1-oborot-ee         [1] +
     3579                                                                                                                                       b1-oborot-re     [1] +
     3580                                                                                                                                       b1-oborot-es    [1] +
     3581                                                                                                                                       b1-oborot-rs[1] )
     3582                                                                                                                               else 0 )
     3583         ,  i). end.
