     1529   function func-vat returns decimal (
     1530       input p-gds-code as integer  ,
     1531       input p-obj-type as character ,
     1532       input p-obj-code as integer  ).
     1533   define variable i-vat-pc as decimal no-undo .
     1534   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     1536     (input  p-gds-code
     1537     ,input  '1':U
     1538     ,input  x-Date-End
     1539     ,input  v-cntxt-host-code-obj
     1540     ,input  p-obj-type
     1541     ,input  p-obj-code
     1542     ,output i-vat-pc
     1543     ) no-error .
     1544   if error-status :error then return 0 .
     1545   else return i-vat-pc.
     1546   end function .
     1547   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1548   procedure macr_excel_char :
     1549    do
     1550    on error undo, return error return-value
     1551    :
     1552    define input parameter  p-val as character no-undo .
     1553    define input parameter  p-row as integer no-undo .
     1554    define input parameter  p-col as integer no-undo .
     1555    if p-val = ? then p-val = "" .
     1556       put stream macr_excel unformatted
     1557             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1558    end.
     1559   end procedure.
     1560   procedure macr_excel_char_with_format :
     1561    do
     1562    on error undo, return error return-value
     1563    :
     1564    define input parameter  p-val as character no-undo .
     1565    define input parameter  p-row as integer no-undo .
     1566    define input parameter  p-col as integer no-undo .
     1567    if p-val = ? then p-val = "" .
     1568       put stream macr_excel unformatted
     1569             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1570       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1571       put stream macr_excel unformatted
     1572             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1573    end.
     1574   end procedure.
     1575   procedure macr_excel_cell_format :
     1576    do
     1577    on error undo, return error return-value
     1578    :
     1579    define input parameter  p-val    as character no-undo .
     1580    define input parameter  p-row    as integer   no-undo .
     1581    define input parameter  p-col    as integer   no-undo .
     1582    define input parameter  p-format as character no-undo .
     1583    if p-val = ? then p-val = "" .
     1584       put stream macr_excel unformatted
     1585             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1586       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1587       put stream macr_excel unformatted
     1588             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1589    end.
     1590   end procedure.
     1591   procedure macr_excel_sum :
     1592    do
     1593    on error undo, return error return-value
     1594    :
     1595    define input parameter  p-row as integer no-undo .
     1596    define input parameter  p-col as integer no-undo .
     1597    define input parameter  p-row1 as integer no-undo .
     1598    define input parameter  p-col1 as integer no-undo .
     1599    define input parameter  p-row2 as integer no-undo .
     1600    define input parameter  p-col2 as integer no-undo .
     1601       put stream macr_excel unformatted
     1602             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1603    end.
     1604   end procedure.
     1605   procedure macr_excel_dec :
     1606    do
     1607    on error undo, return error return-value
     1608    :
     1609    define input parameter  p-val as character no-undo .
     1610    define input parameter  p-row as integer   no-undo .
     1611    define input parameter  p-col as integer   no-undo .
     1612     if p-val = ? then p-val =  "" .
     1613      put  stream macr_excel unformatted
     1614           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1615    end.
     1616   end procedure.
     1617   procedure macr_cell_format :
     1618    do
     1619    on error undo, return error return-value
     1620    :
     1621    define input parameter  p-size   as integer   no-undo .
     1622    define input parameter  p-bold   as logical   no-undo .
     1623    define input parameter  p-italic as logical   no-undo .
     1624    define input parameter  p-color  as integer   no-undo .
     1625    define input parameter  p-row    as integer   no-undo .
     1626    define input parameter  p-col    as integer   no-undo .
     1627    define input parameter  p-row-2  as integer   no-undo .
     1628    define input parameter  p-col-2  as integer   no-undo .
     1629     if p-size = ? then p-size = 10 .
     1630     if p-bold = ? then p-bold = false .
     1631     if p-italic = ? then p-italic = false .
     1632     if p-row-2 = ? then p-row-2 = p-row .
     1633     if p-col-2 = ? then p-col-2 = p-col .
     1634     put  stream macr_excel unformatted
     1635      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1636     if p-color <> ? then do:
     1637        put  stream macr_excel unformatted
     1638          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1639     end.
     1640     put  stream macr_excel unformatted
     1641          substitute('format.font(,&1,&2,&3)' , p-size,
     1642                                           string ( p-bold  , "true/false" ) ,
     1643                                           string ( p-italic , "true/false" )
     1644                                           ) + chr(10) .
     1645    end.
     1646   end procedure.
     1647   procedure macr_cell_size :
     1648    do
     1649    on error undo, return error return-value
     1650    :
     1651    define input parameter  p-w   as integer   no-undo .
     1652    define input parameter  p-l   as integer   no-undo .
     1653    define input parameter  p-row    as integer   no-undo .
     1654    define input parameter  p-col    as integer   no-undo .
     1655    define input parameter  p-row-2  as integer   no-undo .
     1656    define input parameter  p-col-2  as integer   no-undo .
     1657     if p-row-2 = ? then p-row-2 = p-row .
     1658     if p-col-2 = ? then p-col-2 = p-col .
     1659     if p-w = ? then    p-w = 0 .
     1660     if p-l = ? then    p-l = 0 .
     1661    define variable s-w as character no-undo .
     1662    define variable s-l as character no-undo .
     1663    if p-w = 0 then s-w = "" .
     1664               else s-w = string(p-w)  .
     1665    if p-l = 0 then s-l = "" .
     1666               else s-l = string(p-l)  .
     1667   put  stream macr_excel unformatted
     1668        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1669   put  stream macr_excel unformatted
     1670        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1671   put  stream macr_excel unformatted
     1672        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1673    end.
     1674   end procedure.
     1675   procedure proc-print-header :
     1676    do
     1677    on error undo, return error return-value
     1678    :
     1679      find first sheetf .
     1680        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1681        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1682        var-1 =  num#str# .
     1683        repeat c-c = 1 to sheetf.excel-row-title :
     1684        num#str# = num#str# + 1 .
     1685        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1686        do c-i = 1 to p-var :
     1687           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1688           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1689           num#col# = c-i .
     1690           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1691           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1692        end.
     1693       c-i = 0.
     1694       end.
     1695       run macr_cell_format (
     1696           10       ,
     1697           true     ,
     1698           false    ,
     1699           35       ,
     1700           var-1 + 1,
     1701           1        ,
     1702           num#str# ,
     1703           num#col# )
     1704           .
     1705     put  stream macr_excel unformatted
     1706          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1707          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1708          .
     1709    end.
     1710   end procedure.
     1711   procedure end-proc :
     1712    do
     1713    on error undo, return error return-value
     1714    :
     1715     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1716     OUTPUT to VALUE (v-file-name) .
     1717     for each temp-param :
     1718       export  temp-param  .
     1719     end.
     1720    end.
     1721   end procedure.
     1722   define variable nn      as   int  no-undo.
     1723   define variable report1 as int no-undo.
     1724   define variable report2 as int no-undo.
     1725   define variable errorlevel as int no-undo.
     1726   define variable first-lavel as integer no-undo .
     1727   define variable sf1 as handle .
     1728   define variable sf2 as handle .
