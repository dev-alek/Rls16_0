     5213   assign temp#sum-type.sum-type = 'sadt':U + 'rs':U temp#sum-type.xi = 206 . create temp#sum-type.
     5214   assign temp#sum-type.sum-type = 'sadt':U + 'we':U temp#sum-type.xi = 207 . create temp#sum-type.
     5215   assign temp#sum-type.sum-type = 'sadt':U + 'vt':U temp#sum-type.xi = 208 . create temp#sum-type.
     5216   assign temp#sum-type.sum-type = 'sadt':U + 'iv':U temp#sum-type.xi = 209 . create temp#sum-type.
     5217   assign temp#sum-type.sum-type = 'sadt':U + 'ev':U temp#sum-type.xi = 210 . create temp#sum-type.
     5218   assign temp#sum-type.sum-type = 'sadt':U + 'rv':U temp#sum-type.xi = 211 . create temp#sum-type.
     5219   assign temp#sum-type.sum-type = 'sadt':U + 'em':U temp#sum-type.xi = 212 . create temp#sum-type.
     5220   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212 . create temp#sum-type.
     5221   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213 . create temp#sum-type.
     5222   assign temp#sum-type.sum-type = 'sadt':U + 'ot':U temp#sum-type.xi = 214 .
     5223   create temp#sum-type.
     5224   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
