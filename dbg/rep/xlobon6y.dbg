     3461   procedure display-b1  :
     3462   define variable ll as int no-undo.
     3463   define variable kk as int no-undo.
     3464     b1-null-str# = 1.
     3465     b1-null-str2# = 1.
     3466     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3467     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3468      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3469         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3470                 if sums-only then do:
     3471                     if fr0 = true then do:
     3472                           num#str# = num#str# + 1     .
     3473                           num#col# = 1.
     3474                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3475                           run macr_cell_format
     3476                           ( 10    ,
     3477                             true  ,
     3478                             true  ,
     3479                             36    ,
     3480                             num#str# ,
     3481                             num#col# ,
     3482                             num#str# ,
     3483                             5 ) .
     3484                         fr0 = false .
     3485                       end.
     3486                  end.
     3487     num#str# = num#str# + 1     .
     3488     num#col# = 2 .
     3489     if substitute( "&1", sf1:screen-value )  <> "?" then
     3490       run macr_excel_char_with_format(  string(s-bar-code +
     3491                                    sf1:screen-value +
     3492                                    gds-zap-artic +
     3493                                    sf2:screen-value +
     3494                                    gds-zap-gds-name +
     3495                                    temp-str-2    )  , num#str# , num#col#  ) .
     3496      else
