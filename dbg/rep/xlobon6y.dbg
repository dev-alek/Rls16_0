     4280            or (buff-obj-list.obj-type = x-store-type
     4281               and buff-obj-list.obj-code = x-store-code
     4282               )
     4283       on error undo, return error
     4284       :
     4285       find last buff-stk-line no-lock
     4286         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4287           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4288           and buff-stk-line.artic      = x-artic
     4289           and buff-stk-line.prod-type  = x-prod-type
     4290           and buff-stk-line.prod-code  = x-prod-code
     4291           and buff-stk-line.sum-type   = x-sum-type
     4292           and buff-stk-line.cat-id     = '##,##':U
     4293           and buff-stk-line.fact-order <= x-fact-order
     4294           and buff-stk-line.shift-num  = 0
     4295         use-index category
     4296         no-error .
     4297       if available buff-stk-line then do:
     4298         assign
     4299           Quantity = Quantity + buff-stk-line.fact-qnty
     4300           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4301           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4302           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4303           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4304           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4305           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4306           other_R  = other_R  + buff-stk-line.other-rubl
     4307           other_V  = other_V  + buff-stk-line.other-base
     4308         .
     4309       end.
     4310    end.
     4311     end.
     4312     else do:
     4313       for each buff-obj-list no-lock
     4314         where xtog-obj = false
     4315            or (buff-obj-list.obj-type = x-store-type
     4316               and buff-obj-list.obj-code = x-store-code
     4317               )
     4318       on error undo, return error
     4319       :
     4320         find last buff-stk-line no-lock
     4321           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4322             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4323             and buff-stk-line.artic      = x-artic
     4324             and buff-stk-line.prod-type  = x-prod-type
     4325             and buff-stk-line.prod-code  = x-prod-code
     4326             and buff-stk-line.sum-type   = x-sum-type
     4327             and buff-stk-line.cat-id     = '##,##':U
     4328             and buff-stk-line.fact-order <= x-fact-order
     4329             and buff-stk-line.shift-num  > 0
     4330           use-index category
     4331           no-error .
     4332         if available buff-stk-line then do:
     4333           assign
     4334             Quantity = Quantity +  buff-stk-line.fact-qnty
     4335             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4336             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4337             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4338             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4339             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4340             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4341             other_R = other_R   +  buff-stk-line.other-rubl
     4342             other_V = other_V   +  buff-stk-line.other-base
     4343           .
     4344         end.
