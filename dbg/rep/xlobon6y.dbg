     3315   procedure display-bo  :
     3316   define variable ll as int no-undo.
     3317   define variable kk as int no-undo.
     3318     num#str# = num#str# + 1.
     3319     num#col# = 1.
     3320     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3321     num#col#  = 0 .
     3322     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3323     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3324     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3325     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3326     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3327     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3328     run macr_cell_format
     3329         ( 10    ,
     3330           true  ,
     3331           false ,
     3332           ?    ,
     3333           num#str# ,
     3334           1 ,
     3335           num#str# ,
     3336           (mp + ll + (kk * (27 - 8)))
     3337           ) .
     3338   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3339   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3340   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
