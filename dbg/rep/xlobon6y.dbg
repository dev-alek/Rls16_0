     2976           If Last-of((func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))) Then Do:
     2977           If String(Entry(2,"(func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code))",".")) = "Grp-name"
     2978             Then  Assign
     2979                     S-bar-code   = " Итого по "
     2980                     Gds-zap-artic = Substring(
     2981                                         B1-name
     2982                                         ,1,16)
     2983                     Gds-zap-gds-name = Substring(
     2984                                         B1-name
     2985                                         ,17,40)
     2986                                   .
     2987             Else  Assign
     2988                     S-bar-code   = ""
     2989                     Gds-zap-artic = "        Итого по "
     2990                     Gds-zap-gds-name =  B1-name
     2991                                   .
     2992               Run Display-b1 In This-procedure .
     2993               Run Clear-b1 In This-procedure .
     2994               Assign Break_Group = True.
     2995           End.
     2996     End.
     2997   End.
     2998           end.
     2999         end case.
     3000   end procedure.
     3001   procedure calcitog :
     3002       run ostatok  in this-procedure (
     3003           input x-store-code  ,
     3004           input x-store-type  , x-tog-shift ,
     3005           input x-date-start - 1 ,
     3006           input date('')      , x-Shift-Start,x-Shift-End,
     3007           input 'crsa':U   ,
     3008           input '##,##':U,
     3009           input xtog-obj ,
     3010           output  quantity1  ,
     3011           output  coast_r1   ,
     3012           output  coast_v1   ,
     3013           output  vat_r1     ,
     3014           output  vat_v1     ,
     3015           output  fact-order-1 ).
     3016       run ostatok  in this-procedure (
     3017           input x-store-code  ,
     3018           input x-store-type  , x-tog-shift ,
     3019           input x-date-start  ,
     3020           input x-date-end    , x-Shift-Start,x-Shift-End,
     3021           input 'crsa':U   ,
     3022           input '##,##':U,
     3023           input xtog-obj ,
     3024           output  quantity1  ,
     3025           output  coast_r1   ,
     3026           output  coast_v1   ,
     3027           output  vat_r1     ,
     3028           output  vat_v1     ,
     3029           output  fact-order-2 ).
     3030             quantity1  = 0.
     3031             coast_r1   = 0.
     3032             coast_v1   = 0.
     3033             vat_r1     = 0.
     3034             vat_v1     = 0.
     3035   end procedure.
     3036   procedure display-str1  :
     3037   define variable ll as int no-undo.
     3038     assign
     3039       num#str# = num#str# + 1
     3040       num#col# = 0
     3041       v-gds-num = v-gds-num + 1
     3042     .
     3043     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     3044     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     3045     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     3046     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     3047     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     3048     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     3049   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3050   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3051   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3052   def var l-nk as integer no-undo .
     3053     Assign
     3054       LL = 0
     3055       KK = 1
     3056     .
     3057     if xShowCost      Then DO: KK = KK + 1. End.
     3058     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3059     if xShowCrsa      Then DO: KK = KK + 1. End.
     3060     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3061     if xShowSale      Then DO: KK = KK + 1. End.
     3062     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3063     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3064     if xShowmediator  Then DO: KK = KK + 1. End.
     3065     if x-tog-wt       then do: KK = KK + 1. End.
     3066     if x-tog-ms       then do: KK = KK + 1. End.
     3067     if xDens          then do: KK = KK + 1. End.
     3068     repeat i = 1 to 13 :
     3069       if i = 7 then next.
     3070       if NOT xShowCost      and i = 2   Then  next.
     3071       if NOT xShowCostNDS   and i = 3   Then  next.
     3072       if NOT xShowCrsa      and i = 5   Then  next.
     3073       if NOT xShowCrsaNds   and i = 6   Then  next.
     3074       if NOT xShowSale      and i = 8   Then  next.
     3075       if NOT xShowSaleNds   and i = 9   Then  next.
     3076       if NOT xShowSaleSlt   and i = 10  Then  next.
     3077       if NOT xShowmediator  and i = 4   Then  next.
     3078       if not x-tog-wt       and i = 11  then  next.
     3079       if not x-tog-ms       and i = 12  then  next.
     3080       if not xDens          and i = 13  then  next.
     3081       assign
     3082         LL = LL + 1
     3083         l-nk = mp-1
     3084       .
     3085     if x-vat or i <> 2  then do:
     3086     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-start                          [i] ,  i). end.
     3087     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ie          [i] ,  i). end.
     3088     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-iv          [i] ,  i). end.
     3089     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-im           [i] ,  i). end.
     3090     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ee          [i] ,  i). end.
     3091     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ev          [i] ,  i). end.
     3092     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-em           [i] ,  i). end.
     3093     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-we          [i] ,  i). end.
     3094     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-es     [i] ,  i). end.
     3095     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rs [i] ,  i). end.
     3096     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-re      [i] ,  i). end.
     3097     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ep       [i] ,  i). end.
     3098     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-rv      [i] ,  i). end.
     3099     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-vt                [i] ,  i). end.
     3100     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ot           [i] ,  i). end.
     3101     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ostatok-end                            [i] ,  i). end.
     3102     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-ap [i] ,  i). end.
     3103     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , oborot-pc [i] ,  i). end.
     3104     if i = 13 then do:
     3105       if "" = "b1-" or "" = "b2-" or "" = "bi-" or "" = "bo-" then do:
     3106          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3107       end.
     3108       else do:
     3109         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(oborot-ee         [1] +
     3110                                                                                                                                       oborot-re     [1] +
     3111                                                                                                                                       oborot-es    [1] +
     3112                                                                                                                                       oborot-rs[1] ) <> 0
     3113                                                                                                                               then
     3114                                                                                                                                   ABS(oborot-ee         [11] +
     3115                                                                                                                                       oborot-re     [11] +
     3116                                                                                                                                       oborot-es    [11] +
     3117                                                                                                                                       oborot-rs[11] )
     3118                                                                                                                                   /
     3119                                                                                                                                   ABS(oborot-ee         [1] +
     3120                                                                                                                                       oborot-re     [1] +
     3121                                                                                                                                       oborot-es    [1] +
     3122                                                                                                                                       oborot-rs[1] )
     3123                                                                                                                               else 0 )
     3124         ,  i). end.
     3125       end.
     3126     end.
     3127     else do:
     3128     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (oborot-ee         [i] +
     3129                                                                                                                           oborot-re     [i] +
     3130                                                                                                                           oborot-es    [i] +
     3131                                                                                                                           oborot-rs[i] )
     3132     ,  i). end.
     3133     end.
     3134     end.
     3135     if x-vat = false  and i = 2 then do:
     3136     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-start                          [i] -  ostatok-start                          [3] ),  i). end.
     3137     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ie          [i] -  oborot-ie          [3] ),  i). end.
     3138     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-iv          [i] -  oborot-iv          [3] ),  i). end.
     3139     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-im           [i] -  oborot-im           [3] ),  i). end.
     3140     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ee          [i] -  oborot-ee          [3] ),  i). end.
     3141     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ev          [i] -  oborot-ev          [3] ),  i). end.
     3142     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-em           [i] -  oborot-em           [3] ),  i). end.
     3143     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-we          [i] -  oborot-we          [3] ),  i). end.
     3144     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-es     [i] -  oborot-es     [3] ),  i). end.
     3145     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rs [i] -  oborot-rs [3] ),  i). end.
     3146     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-re      [i] -  oborot-re      [3] ),  i). end.
     3147     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ep       [i] -  oborot-ep       [3] ),  i). end.
     3148     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-rv      [i] -  oborot-rv      [3] ),  i). end.
     3149     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-vt                [i] -  oborot-vt                [3] ),  i). end.
     3150     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ot           [i] -  oborot-ot           [3] ),  i). end.
     3151     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( ostatok-end                            [i] -  ostatok-end                            [3] ),  i). end.
     3152     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-ap [i] -  oborot-ap[3] ),  i). end.
     3153     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( oborot-pc [i] -  oborot-pc[3] ),  i). end.
     3154     if i = 13 then do :
     3155       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3156     end.
     3157     else do:
     3158       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3159       (                                                                                      (oborot-ee         [i] +
