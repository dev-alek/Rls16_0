     4081   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     4082   end.
     4083     if tt# = 6 then do:
     4084     if  xshowmediator = false then
     4085         oborot-sum-cost[1] =
     4086         oborot-ee[2]      +
     4087         oborot-es[2] +
     4088         oborot-re[2]  +
     4089         oborot-rs[2]
     4090         .
     4091         else
     4092         oborot-sum-cost[1] =
     4093         oborot-ee[4]      +
     4094         oborot-es[4] +
     4095         oborot-re[4]  +
     4096         oborot-rs[4]
     4097         .
     4098        repeat v-ii = 1 to 1 :
     4099        v-summa[v-ii ]  =
     4100           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4101           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4102           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4103           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4104           oborot-im[v-ii ] .
     4105        end.
     4106        repeat v-ii = 2 to 4 :
     4107        v-summa[v-ii ]  =
     4108           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4109           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4110           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4111           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4112           oborot-im[v-ii + tt#] .
     4113        end.
     4114         oborot-sum-sale[1] =
     4115         oborot-ee[2 + tt#] +
     4116         oborot-es[2 + tt#] +
     4117         oborot-re[2 + tt#] +
     4118         oborot-rs[2 + tt#]
     4119         .
     4120          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4121           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4122                                                                                                     -  oborot-disc[1]
     4123           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4124           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4125           .
     4126           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4127           if oborot-sum-cost[1] <>  0 then
     4128             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4129             else oborot-prc[1] = 0.
     4130     end.
     4131   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4132   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4133   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4134   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4135   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4136   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4137   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4138   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4139   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4140   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4141   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4142   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4143   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4144   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4145   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4146   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4147   end procedure.
     4148   procedure ost-line :
     4149     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4150     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4151     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4152     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4153     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4154     define input  parameter x-tog-shift  as logical no-undo .
     4155     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4156     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4157     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4158     define input  parameter xtog-obj     as logical no-undo .
     4159     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4160     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4161     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4162     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4163     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4164     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4165     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4166     define buffer buff-obj-list  for obj-list .
     4167     define buffer buff-stk-line  for ub.stk-line .
     4168     assign
     4169       Quantity = 0
     4170       Coast_R  = 0
     4171       Coast_V  = 0
     4172       VAT_R    = 0
     4173       VAT_V    = 0
     4174       SLT_R    = 0
     4175       SLT_V    = 0
     4176     .
     4177     if  x-tog-shift = false then do:
     4178       for each buff-obj-list no-lock
     4179         where xtog-obj = false
     4180            or (buff-obj-list.obj-type = x-store-type
     4181               and buff-obj-list.obj-code = x-store-code
     4182               )
     4183       on error undo, return error
     4184       :
     4185       find last buff-stk-line no-lock
     4186         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4187           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4188           and buff-stk-line.artic      = x-artic
     4189           and buff-stk-line.prod-type  = x-prod-type
     4190           and buff-stk-line.prod-code  = x-prod-code
     4191           and buff-stk-line.sum-type   = x-sum-type
     4192           and buff-stk-line.cat-id     = '##,##':U
     4193           and buff-stk-line.fact-order <= x-fact-order
     4194           and buff-stk-line.shift-num  = 0
     4195         use-index category
     4196         no-error .
     4197       if available buff-stk-line then do:
     4198         assign
     4199           Quantity = Quantity + buff-stk-line.fact-qnty
     4200           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4201           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4202           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4203           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4204           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4205           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4206         .
     4207       end.
     4208      end.
     4209     end.
     4210     else do:
     4211       for each buff-obj-list no-lock
     4212         where xtog-obj = false
     4213            or (buff-obj-list.obj-type = x-store-type
     4214               and buff-obj-list.obj-code = x-store-code
     4215               )
     4216       on error undo, return error
     4217       :
     4218         find last buff-stk-line no-lock
     4219           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4220             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4221             and buff-stk-line.artic      = x-artic
     4222             and buff-stk-line.prod-type  = x-prod-type
     4223             and buff-stk-line.prod-code  = x-prod-code
     4224             and buff-stk-line.sum-type   = x-sum-type
     4225             and buff-stk-line.cat-id     = '##,##':U
     4226             and buff-stk-line.fact-order <= x-fact-order
     4227             and buff-stk-line.shift-num  > 0
     4228           use-index category
     4229           no-error .
     4230         if available buff-stk-line then do:
     4231           assign
     4232             Quantity = Quantity +  buff-stk-line.fact-qnty
     4233             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4234             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4235             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4236             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4237             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4238             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4239           .
     4240         end.
     4241       end.
     4242     end.
     4243   end procedure.
     4244   procedure ost-lineother-tax :
     4245     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4246     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4247     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4248     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4249     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4250     define input  parameter x-tog-shift  as logical no-undo .
     4251     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4252     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4253     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4254     define input  parameter xTog-obj     as logical no-undo .
     4255     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4256     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4257     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4258     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4259     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4260     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
