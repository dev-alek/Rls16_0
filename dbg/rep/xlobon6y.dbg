     5195   assign temp#sum-type.sum-type = 'cgdt':U + 'we':U temp#sum-type.xi = 107 . create temp#sum-type.
     5196   assign temp#sum-type.sum-type = 'cgdt':U + 'vt':U temp#sum-type.xi = 108 . create temp#sum-type.
     5197   assign temp#sum-type.sum-type = 'cgdt':U + 'iv':U temp#sum-type.xi = 109 . create temp#sum-type.
     5198   assign temp#sum-type.sum-type = 'cgdt':U + 'ev':U temp#sum-type.xi = 110 . create temp#sum-type.
     5199   assign temp#sum-type.sum-type = 'cgdt':U + 'rv':U temp#sum-type.xi = 111 . create temp#sum-type.
     5200   assign temp#sum-type.sum-type = 'cgdt':U + 'em':U temp#sum-type.xi = 112 . create temp#sum-type.
     5201   assign temp#sum-type.sum-type = 'cgdt':U + 'wm':U temp#sum-type.xi = 112 . create temp#sum-type.
     5202   assign temp#sum-type.sum-type = 'cgdt':U + 'im':U temp#sum-type.xi = 113 . create temp#sum-type.
     5203   assign temp#sum-type.sum-type = 'cgdt':U + 'ot':U temp#sum-type.xi = 114 .
     5204   create temp#sum-type.
     5205   assign temp#sum-type.sum-type = 'cgdt':U + 'ap':U temp#sum-type.xi = 115 . create temp#sum-type.
     5206   assign temp#sum-type.sum-type = 'cgdt':U + 'pc':U temp#sum-type.xi = 116 .
     5207   create temp#sum-type.
     5208   assign temp#sum-type.sum-type = 'sadt':U + 'ie':U temp#sum-type.xi = 201 . create temp#sum-type.
     5209   assign temp#sum-type.sum-type = 'sadt':U + 'ee':U temp#sum-type.xi = 202 . create temp#sum-type.
     5210   assign temp#sum-type.sum-type = 'sadt':U + 'ep':U temp#sum-type.xi = 203 . create temp#sum-type.
