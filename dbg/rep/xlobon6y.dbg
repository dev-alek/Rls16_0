     3596     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ie          [i] -  b1-oborot-ie          [3] ),  i). end.
