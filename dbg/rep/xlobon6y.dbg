     3599     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ee          [i] -  b1-oborot-ee          [3] ),  i). end.
     3600     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b1-oborot-ev          [i] -  b1-oborot-ev          [3] ),  i). end.
