     5226   end procedure.
     5227   procedure new-tmp-page :
     5228    do
     5229    on error undo, return error return-value
     5230    :
     5231       if   num#str#  >=  63000  then do:
     5232           output stream macr_excel  close .
     5233           run paramls-write in this-procedure
     5234             (input "file"
     5235             ,input string(v-ind)
     5236             ,input v-file-name
     5237             ) .
     5238           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5239           output stream  macr_excel to value(v-file-name) .
     5240           v-ind = v-ind + 1 .
     5241           num#str# = 0 .
     5242   define variable old-s as integer no-undo .
     5243   define variable old-s2 as integer no-undo .
     5244       assign
     5245       old-s =   num#str#
     5246       .
     5247       run make-col .
     5248       assign
     5249         old-s2 =   num#str#
     5250       .
     5251      num#str# = old-s + 1  .
     5252      run proc-print-header .
     5253      num#str# = old-s2     .
     5254       end.
     5255    end.
     5256   end procedure.
     5257   procedure pp :
     5258   define input parameter ll as integer no-undo .
     5259   define input parameter uu as integer no-undo .
     5260   define input parameter ff as character no-undo .
     5261   End procedure.
     5262   procedure find-last-prise-med :
     5263   define input parameter p-artic     like ub.goods.artic no-undo .
     5264   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5265   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5266   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5267   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5268   define buffer p-gds-obj   for  ub.gds-obj .
     5269   define buffer buf_trn-doc for  ub.trn-doc .
     5270   define variable v-fact-order as decimal no-undo .
     5271   p-price = 0 .
     5272     define variable v-in-date as date      no-undo .
     5273     define variable fl as logical no-undo .
     5274     fl = yes.
     5275     v-fact-order = 0 .
     5276     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5277     :
     5278       find first p-gds-obj no-lock
     5279         where p-gds-obj.artic     = p-artic         and
     5280                 p-gds-obj.prod-type = p-prod-type     and
     5281                 p-gds-obj.prod-code = p-prod-code     and
     5282                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5283                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5284         no-error .
     5285       if available p-gds-obj then do:
     5286       if p-gds-obj.in-date = ?  then next .
     5287       if fl = yes then do:
     5288         assign
     5289           v-in-date = p-gds-obj.in-date
     5290           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5291           fl = no
     5292       .
     5293        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5294        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5295       end.
     5296         if p-gds-obj.in-date >= v-in-date   then do:
     5297            if p-gds-obj.in-date = v-in-date then do:
     5298               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5299               if available buf_trn-doc  then
     5300                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5301                     assign
     5302                       v-fact-order = buf_trn-doc.fact-order
     5303                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5304                       v-in-date =   p-gds-obj.in-date
     5305                     .
     5306                   end.
     5307            end.
     5308            else do:
     5309             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5310             if available buf_trn-doc  then
     5311                 assign
     5312                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5313                   v-in-date =    p-gds-obj.in-date
     5314                   v-fact-order = buf_trn-doc.fact-order .
     5315                 .
     5316             end.
     5317           if p-price = ? then   p-price  = 0 .
     5318         end.
     5319       end.
     5320     End .
     5321     if p-price = ? then   p-price  = 0 .
     5322   end procedure.
     5323   procedure find-mediator :
     5324   define input  parameter c-host-code as integer no-undo .
     5325   define input  parameter p-Showmediatr as logical no-undo .
     5326   define output parameter p-host-code as integer no-undo .
     5327   define output parameter p-flag as logical no-undo .
     5328   define buffer b-sysconf  for ub.sysconf.
     5329    p-host-code = 0 .
     5330    p-flag  = true .
     5331       if p-Showmediatr = true then do:
     5332       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5333             if avail ub.sysconf then DO :
     5334               p-host-code = ub.sysconf.host-code.
     5335               if tPrintRubl = false then do:
     5336                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5337                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5338                                 p-flag  = false  .
     5339                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5340                                 view-as alert-box error.
     5341                           end.
     5342               end.
     5343             end.
     5344             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5345                 create tt-obj-list no-error .
     5346                 assign tt-obj-list.obj-type = 'маг':U
     5347                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5348             end.
     5349             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5350                 create tt-obj-list no-error .
     5351                 assign tt-obj-list.obj-type = 'скл':U
     5352                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5353             end.
     5354       End.
     5355    End procedure .
     5356   PROCEDURE ob-line-stk  :
     5357   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5358   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5359   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5360   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5361   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5362   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5363   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5364   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5365   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5366   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5367   define input  parameter xTog-obj         as log                     no-undo.
     5368   define input  parameter xi               as int                     no-undo.
     5369   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5370   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5371   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5372   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5373   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5374   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5375   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5376   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5377   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5378   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5379   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5380   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5381   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5382   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5383   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5384   define buffer stk-line2 for ub.stk-line .
     5385   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5386    Assign
     5387      First-qnty  = 0
     5388      Second-qnty = 0
     5389      Quntity     = 0
     5390      First-sum  = 0
     5391      Second-sum = 0
     5392      sum        = 0
     5393      First-vat  = 0
     5394      Second-vat = 0
     5395      vat        = 0
     5396      First-slt   = 0
     5397      Second-slt  = 0
     5398      slt         = 0
     5399      First-disc  = 0
     5400      Second-disc = 0
     5401      disc        = 0
     5402     .
     5403     For each obj-list  no-lock :
     5404      if  xTog-obj THEN
     5405          if   NOT(    x-store-type     = obj-list.obj-type
     5406               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5407      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5408         find last ub.stk-line no-lock
     5409           where ub.stk-line.obj-type   = obj-list.obj-type
     5410             and ub.stk-line.obj-code   = obj-list.obj-code
     5411             and ub.stk-line.artic      = x-artic
     5412             and ub.stk-line.prod-type  = x-prod-type
     5413             and ub.stk-line.prod-code  = x-prod-code
     5414             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5415             and ub.stk-line.cat-id     = '##,##':U
     5416             and ub.stk-line.fact-order <= x-fact-order-1
     5417           use-index category
     5418           no-error .
     5419         if available ub.stk-line then do:
     5420           assign
     5421             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5422             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5423             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5424             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5425             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5426           .
     5427         end.
     5428         find last stk-line2 no-lock
     5429           where stk-line2.obj-code   = obj-list.obj-code
     5430             and stk-line2.obj-type   = obj-list.obj-type
     5431             and stk-line2.artic      = x-artic
     5432             and stk-line2.prod-type  = x-prod-type
     5433             and stk-line2.prod-code  = x-prod-code
     5434             and stk-line2.sum-type   = temp#sum-type.sum-type
     5435             and stk-line2.cat-id     = '##,##':U
     5436             and stk-line2.fact-order <= x-fact-order-2
     5437           use-index category
     5438           no-error .
     5439         if available stk-line2 then do:
     5440           assign
     5441             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5442             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5443             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5444             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5445             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5446           .
     5447         end.
     5448      end.
     5449    end.
     5450    Assign
     5451      Quntity = Second-qnty - first-qnty
     5452      sum     = Second-sum  - first-sum
     5453      vat     = Second-vat  - first-vat
     5454      slt     = Second-slt  - first-slt
     5455      disc    = Second-disc  - first-disc
     5456      .
     5457   END PROCEDURE.
     5458   procedure calc-ms-wt :
     5459   define input        parameter p-oborot-num      as decimal   no-undo .
     5460   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5461   define input-output parameter p-oborot          as decimal   no-undo .
     5462   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5463   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5464   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5465   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5466   do
     5467   on error undo, return error return-value
     5468   :
     5469   if p-is-petrol = true then return .
     5470     assign
     5471       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5472       p-bi-oborot = p-bi-oborot + p-oborot
     5473       p-bo-oborot = p-bo-oborot + p-oborot
     5474       p-b1-oborot = p-b1-oborot + p-oborot
     5475       p-b2-oborot = p-b2-oborot + p-oborot
     5476     .
     5477   end.
     5478   end procedure.
     5479   procedure calc-dens :
     5480   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5481   define input        parameter p-ostatok          as decimal   no-undo .
     5482   define input-output parameter p-density          as decimal   no-undo .
     5483   define input-output parameter p-bi-density       as decimal   no-undo .
     5484   define input-output parameter p-bo-density       as decimal   no-undo .
     5485   define input-output parameter p-b1-density       as decimal   no-undo .
     5486   define input-output parameter p-b2-density       as decimal   no-undo .
     5487   do
     5488   on error undo, return error return-value
     5489   :
     5490   if p-is-petrol = false then return .
     5491     assign
     5492       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5493       p-bi-density = 0
     5494       p-bo-density = 0
     5495       p-b1-density = 0
     5496       p-b2-density = 0
     5497     .
     5498   end.
     5499   end procedure.
     5500   procedure calc-pt-ob :
     5501   define input  parameter p-ext-doc-type    as character no-undo .
     5502   define input  parameter x-store-type      as character no-undo .
     5503   define input  parameter x-store-code      as integer   no-undo .
     5504   define input  parameter p-artic           as character no-undo .
     5505   define input  parameter p-prod-type       as character no-undo .
     5506   define input  parameter p-prod-code       as integer   no-undo .
     5507   define input-output parameter p-oborot    as decimal   no-undo .
     5508   define input-output parameter p-bi-oborot as decimal   no-undo .
     5509   define input-output parameter p-bo-oborot as decimal   no-undo .
     5510   define input-output parameter p-b1-oborot as decimal   no-undo .
     5511   define input-output parameter p-b2-oborot as decimal   no-undo .
     5512     do
     5513     on error undo, return error return-value
     5514     :
     5515   define variable v-oborot as decimal   no-undo .
     5516   define buffer buf_doc-line  for ub.doc-line  .
     5517   define buffer buf_inv-line  for ub.inv-line  .
     5518   define buffer buf1_obj-list for obj-list .
     5519   assign
     5520     v-oborot = 0
     5521   .
     5522   if p-is-petrol = false   then return .
     5523     for each buf1_obj-list no-lock :
     5524      if  xtog-obj then
     5525          if   not(x-store-type     = buf1_obj-list.obj-type
     5526               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5527       for each buf_doc-line  no-lock where
     5528             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5529             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5530             buf_doc-line.artic        = p-artic and
     5531             buf_doc-line.prod-type    = p-prod-type and
     5532             buf_doc-line.prod-code    = p-prod-code and
     5533             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5534             buf_doc-line.status_      = 'факт':U        and
     5535             buf_doc-line.fact-order   <= fact-order-2  and
     5536             buf_doc-line.fact-order   >= fact-order-1
     5537             :
     5538             for each buf_inv-line  no-lock where
     5539                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5540                 buf_inv-line.artic        = buf_doc-line.artic and
     5541                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5542                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5543                 :
     5544                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5545                     else do:
     5546                     if p-ext-doc-type = 'we':U    or
     5547                        p-ext-doc-type = 'ee':U    or
     5548                        p-ext-doc-type = 'ev':U    or
     5549                        p-ext-doc-type = 'ep':U or
     5550                        p-ext-doc-type = 'em':U     or
     5551                        p-ext-doc-type = 'wm':U     or
     5552                        p-ext-doc-type = 'es':U   then
     5553                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5554                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5555                     end.
     5556             end.
     5557       end.
     5558   end.
     5559   assign
     5560     p-oborot    = v-oborot
     5561     p-bi-oborot = p-bi-oborot + v-oborot
     5562     p-bo-oborot = p-bo-oborot + v-oborot
     5563     p-b1-oborot = p-b1-oborot + v-oborot
     5564     p-b2-oborot = p-b2-oborot + v-oborot
     5565   .
     5566   end.
     5567   end procedure.
     5568   procedure calc-density :
     5569   define input        parameter p-ext-doc-type  as character no-undo .
     5570   define input        parameter x-store-type    as character no-undo .
     5571   define input        parameter x-store-code    as integer   no-undo .
     5572   define input        parameter p-artic         as character no-undo .
     5573   define input        parameter p-prod-type     as character no-undo .
     5574   define input        parameter p-prod-code     as integer   no-undo .
     5575   define input-output parameter p-density       as decimal   no-undo .
     5576   define input-output parameter p-bi-density    as decimal   no-undo .
     5577   define input-output parameter p-bo-density    as decimal   no-undo .
     5578   define input-output parameter p-b1-density    as decimal   no-undo .
     5579   define input-output parameter p-b2-density    as decimal   no-undo .
     5580     do
     5581     on error undo, return error return-value
     5582     :
     5583   define variable v-oborot    as decimal   no-undo .
     5584   define variable v-fact-qnty as decimal   no-undo .
     5585   define buffer buf_doc-line  for ub.doc-line  .
     5586   define buffer buf_inv-line  for ub.inv-line  .
     5587   define buffer buf1_obj-list for obj-list .
     5588   assign
     5589     v-oborot     = 0
     5590     v-fact-qnty  = 0
     5591   .
     5592   if p-is-petrol = false   then return .
     5593     for each buf1_obj-list no-lock :
     5594      if  xtog-obj then
     5595          if   not(x-store-type     = buf1_obj-list.obj-type
     5596               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5597       for each buf_doc-line  no-lock where
     5598             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5599             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5600             buf_doc-line.artic        = p-artic and
     5601             buf_doc-line.prod-type    = p-prod-type and
     5602             buf_doc-line.prod-code    = p-prod-code and
     5603             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5604             buf_doc-line.status_      = 'факт':U        and
     5605             buf_doc-line.fact-order   <= fact-order-2  and
     5606             buf_doc-line.fact-order   >= fact-order-1
     5607             :
     5608             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5609             for each buf_inv-line  no-lock where
     5610                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5611                 buf_inv-line.artic        = buf_doc-line.artic and
     5612                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5613                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5614                 :
     5615                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5616                     else do:
     5617                     if p-ext-doc-type = 'we':U    or
     5618                        p-ext-doc-type = 'ee':U    or
     5619                        p-ext-doc-type = 'ev':U    or
     5620                        p-ext-doc-type = 'ep':U or
     5621                        p-ext-doc-type = 'em':U     or
     5622                        p-ext-doc-type = 'wm':U     or
     5623                        p-ext-doc-type = 'es':U   then
     5624                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5625                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5626                     end.
     5627             end.
     5628       end.
     5629       assign
     5630         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5631       .
     5632       assign
     5633         p-bi-density = p-density
     5634         p-bo-density = 0
     5635         p-b1-density = 0
     5636         p-b2-density = 0
     5637       .
     5638   end.
     5639   end.
     5640   end procedure.
