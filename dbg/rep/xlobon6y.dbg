     3886   procedure ob-line  :
     3887   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3888   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3889   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3890   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3891   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3892   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3893   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3894   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3895   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3896   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3897   define input  parameter xtog-obj           as log no-undo.
     3898   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3899   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3900   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3901   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3902   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3903   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3904   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3905   define variable  v-summa  as decimal extent 4 no-undo .
     3906   define variable  tt#          as int no-undo.
     3907   define variable v-ii as integer no-undo .
     3908   define variable slt  as decimal no-undo .
     3909   define variable disc  as decimal no-undo .
     3910   define variable xi as integer no-undo .
     3911   define variable v-tt as integer no-undo .
     3912    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3913       else
     3914       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3915       else
     3916       assign tt# = 6  v-tt = 200.
     3917     if long-p = false then do :
     3918     for each obj-list no-lock:
     3919      if  xtog-obj then
     3920          if   not(x-store-type     = obj-list.obj-type
     3921               and x-store-code    = obj-list.obj-code ) then next.
     3922           for each ub.ot-line where
     3923                     ub.ot-line.artic         = x-artic
     3924               and   ub.ot-line.prod-code    = x-prod-code
     3925               and   ub.ot-line.prod-type    = x-prod-type
     3926               and   ub.ot-line.fact-order   <= x-fact-order-2
     3927               and   ub.ot-line.fact-order   >= x-fact-order-1
     3928               and   ub.ot-line.obj-code     = obj-list.obj-code
     3929               and   ub.ot-line.obj-type     = obj-list.obj-type
     3930               and   ub.ot-line.sum-type     = x-sum-type
     3931               no-lock :
     3932               case ub.ot-line.ext-doc-type:
     3933     WHEN 'ie':U THEN DO:
     3934       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3935             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3936             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3937         if tt# = 6 Then   assign
     3938             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3939             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3940             End.
     3941     WHEN 'ee':U THEN DO:
     3942       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3943             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3944             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3945         if tt# = 6 Then   assign
     3946             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3947             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3948             End.
     3949     WHEN 'ep':U THEN DO:
     3950       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3951             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3952             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3953         if tt# = 6 Then   assign
     3954             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3955             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3956             End.
     3957     WHEN 'es':U THEN DO:
     3958       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3959             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3960             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3961         if tt# = 6 Then   assign
     3962             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3963             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3964             End.
     3965     WHEN 're':U THEN DO:
     3966       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3967             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3968             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3969         if tt# = 6 Then   assign
     3970             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3971             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3972             End.
     3973     WHEN 'rs':U THEN DO:
     3974       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3975             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3976             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3977         if tt# = 6 Then   assign
     3978             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3979             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3980             End.
     3981     WHEN 'we':U THEN DO:
     3982       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3983             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
