     3769     end.
     3770     else do:
     3771       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3772       (                                                                                      (b2-oborot-ee         [i] +
     3773                                                                                               b2-oborot-re     [i] +
     3774                                                                                               b2-oborot-es    [i] +
     3775                                                                                               b2-oborot-rs[i]) -
     3776                                                                                             (b2-oborot-ee         [3] +
     3777                                                                                               b2-oborot-re     [3] +
     3778                                                                                               b2-oborot-es    [3] +
     3779                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3780     end.
     3781     end.
     3782     end.
     3783    run new-tmp-page .
