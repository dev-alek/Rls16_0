     5034   procedure ex-display :
     5035   define input parameter par-1 as int no-undo.
     5036   define input parameter par-2 like  ostatok-start[1] no-undo.
     5037   define input parameter par-i as int no-undo.
     5038     assign num#col#  = par-1.
     5039     if par-i = 13 then do:
     5040       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     5041     end.
     5042     else do:
     5043       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     5044         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     5045       end.
     5046       else do :
     5047         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     5048       end.
     5049     end.
     5050   end procedure.
     5051   procedure u-line:
     5052   end procedure.
     5053   procedure p-line:
     5054   end procedure.
     5055   procedure make-col :
     5056    define variable l#1 as int  no-undo.
     5057    define variable l#2 as int  no-undo.
     5058    define variable l as int  no-undo.
     5059     assign
     5060       nk = 0
     5061       kk = 0
     5062     .
     5063     if xshowcost     then do: kk = kk + 1. end.
     5064     if xshowcostnds  then do: kk = kk + 1. end.
     5065     if xshowcrsa     then do: kk = kk + 1. end.
     5066     if xshowcrsands  then do: kk = kk + 1. end.
     5067     if xshowsale     then do: kk = kk + 1. end.
     5068     if xshowsalends  then do: kk = kk + 1. end.
     5069     if xshowsaleslt  then do: kk = kk + 1. end.
     5070     if xshowmediator then do: kk = kk + 1. end.
     5071     if x-tog-wt      then do: kk = kk + 1. end.
     5072     if x-tog-ms      then do: kk = kk + 1. end.
     5073     if xDens         then do: kk = kk + 1. end.
     5074    assign
     5075     num#str# = num#str# + 1
     5076     num#col#  = 0
     5077    .
     5078    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5079    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5080    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5081    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5082    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5083    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     5084    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5085    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5086    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5087       mp = num#col#  + 1.
     5088       mp-1 = num#col#  .
     5089    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5090    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5091    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5092    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5093    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5094    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5095    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5096    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5097    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5098    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5099    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5100    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5101    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5102    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5103    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5104    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5105    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5106    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5107    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5108       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5109      num#str# = num#str# + 1.
     5110      repeat l#1 = mp to nk :
     5111            l#2 = 0.
     5112                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5113            if xshowcost    then do:
     5114                l#2 = l#2 + 1.
     5115                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5116                end.
     5117            if xshowcostnds then do:
     5118                l#2 = l#2 + 1.
     5119                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5120               end.
     5121            if xshowmediator then do:
     5122               l#2 = l#2 + 1.
     5123               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5124               end.
     5125            if xshowcrsa    then do:
     5126               l#2 = l#2 + 1.
     5127               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5128               end.
     5129            if xshowcrsands then do:
     5130               l#2 = l#2 + 1.
     5131               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5132               end.
     5133             if xshowsale    then do:
     5134               l#2 = l#2 + 1.
     5135               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5136               end.
     5137            if xshowsalends then do:
     5138               l#2 = l#2 + 1.
     5139               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5140               end.
     5141            if xshowsaleslt then do:
     5142               l#2 = l#2 + 1.
     5143               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5144            end.
     5145            if x-tog-wt then do:
     5146             assign
     5147               l#2 = l#2 + 1
     5148               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5149             .
     5150             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5151            end.
     5152            if x-tog-ms then do:
     5153             assign
     5154               l#2 = l#2 + 1
     5155               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5156             .
     5157             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5158            end.
     5159            if xDens then do:
     5160             assign
     5161               l#2 = l#2 + 1
     5162               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5163             .
     5164             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5165            end.
     5166        end.
     5167   end procedure .
     5168   procedure make-tt-ed :
     5169   create temp#sum-type.
     5170   assign temp#sum-type.sum-type = 'csdt':U + 'ie':U temp#sum-type.xi = 1 . create temp#sum-type.
     5171   assign temp#sum-type.sum-type = 'csdt':U + 'ee':U temp#sum-type.xi = 2 . create temp#sum-type.
     5172   assign temp#sum-type.sum-type = 'csdt':U + 'ep':U temp#sum-type.xi = 3 . create temp#sum-type.
     5173   assign temp#sum-type.sum-type = 'csdt':U + 'es':U temp#sum-type.xi = 4 . create temp#sum-type.
     5174   assign temp#sum-type.sum-type = 'csdt':U + 're':U temp#sum-type.xi = 5 . create temp#sum-type.
     5175   assign temp#sum-type.sum-type = 'csdt':U + 'rs':U temp#sum-type.xi = 6 . create temp#sum-type.
     5176   assign temp#sum-type.sum-type = 'csdt':U + 'we':U temp#sum-type.xi = 7 . create temp#sum-type.
     5177   assign temp#sum-type.sum-type = 'csdt':U + 'vt':U temp#sum-type.xi = 8 . create temp#sum-type.
     5178   assign temp#sum-type.sum-type = 'csdt':U + 'iv':U temp#sum-type.xi = 9 . create temp#sum-type.
     5179   assign temp#sum-type.sum-type = 'csdt':U + 'ev':U temp#sum-type.xi = 10. create temp#sum-type.
     5180   assign temp#sum-type.sum-type = 'csdt':U + 'rv':U temp#sum-type.xi = 11. create temp#sum-type.
     5181   assign temp#sum-type.sum-type = 'csdt':U + 'em':U temp#sum-type.xi = 12 . create temp#sum-type.
     5182   assign temp#sum-type.sum-type = 'csdt':U + 'wm':U temp#sum-type.xi = 12 . create temp#sum-type.
     5183   assign temp#sum-type.sum-type = 'csdt':U + 'im':U temp#sum-type.xi = 13 . create temp#sum-type.
     5184   assign temp#sum-type.sum-type = 'csdt':U + 'ot':U temp#sum-type.xi = 14 .
     5185   create temp#sum-type.
     5186   assign temp#sum-type.sum-type = 'csdt':U + 'ap':U temp#sum-type.xi = 15 . create temp#sum-type.
     5187   assign temp#sum-type.sum-type = 'csdt':U + 'pc':U temp#sum-type.xi = 16 .
     5188   create temp#sum-type.
     5189   assign temp#sum-type.sum-type = 'cgdt':U + 'ie':U temp#sum-type.xi = 101 . create temp#sum-type.
     5190   assign temp#sum-type.sum-type = 'cgdt':U + 'ee':U temp#sum-type.xi = 102 . create temp#sum-type.
     5191   assign temp#sum-type.sum-type = 'cgdt':U + 'ep':U temp#sum-type.xi = 103 . create temp#sum-type.
     5192   assign temp#sum-type.sum-type = 'cgdt':U + 'es':U temp#sum-type.xi = 104 . create temp#sum-type.
