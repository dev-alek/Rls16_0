     4346     end.
     4347   end procedure.
     4348   procedure ost-line-kg :
     4349     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4350     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4351     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4352     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4353     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4354     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4355     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4356     define buffer buff-obj-list  for obj-list .
     4357     define buffer buf_doc-line for ub.doc-line .
     4358     define buffer buf_inv-line for ub.inv-line .
     4359     do
     4360     on error undo, return error
     4361     :
     4362       for each buf_doc-line no-lock where
     4363                buf_doc-line.obj-type    = p-obj-type   and
     4364                buf_doc-line.obj-code    = p-obj-code   and
     4365                buf_doc-line.prod-type   = p-prod-type  and
     4366                buf_doc-line.prod-code   = p-prod-code  and
     4367                buf_doc-line.artic       = p-artic      and
     4368                buf_doc-line.status_     = 'факт':U      and
     4369                buf_doc-line.fact-order <= p-fact-order
     4370             by buf_doc-line.fact-order    descending
     4371       :
     4372         find first buf_inv-line no-lock where
     4373                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4374                    buf_inv-line.artic     = buf_doc-line.artic     and
     4375                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4376                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4377         if available buf_inv-line
     4378         then do:
     4379           if buf_inv-line.after-cli-qnty <> ?
     4380           then do:
     4381             assign
     4382               p-quantity-kg = buf_inv-line.after-cli-qnty
     4383             .
     4384             leave .
     4385           end.
     4386         end.
     4387       end.
     4388       if p-quantity-kg = ?
     4389       then do:
     4390         assign
     4391           p-quantity-kg = 0
     4392         .
     4393       end.
     4394     end.
     4395   end procedure.
     4396   PROCEDURE ostatok :
     4397   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4398   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4399   def input parameter x-tog-shift   as   logical             no-undo.
     4400   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4401   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4402   def input parameter x-shift-start as integer               no-undo.
     4403   def input parameter x-shift-end   as integer               no-undo.
     4404   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4405   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4406   def input parameter xTog-obj   as log no-undo.
     4407   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4408   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4409   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4410   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4411   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4412   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4413   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4414   def var              Fact-orderS   as char  no-undo.
     4415   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4416      Assign
     4417         Fact-order   = 0
     4418         Quantity     = 0
     4419         Coast_R      = 0
     4420         Coast_V      = 0
     4421         VAT_R        = 0
     4422         VAT_V        = 0 .
     4423    x-date-start-t  = x-date-start + 1 .
     4424   IF x-date-end = date('') then DO:
     4425      Fact-order = 0 .
     4426      for each obj-list
     4427          where  ( not xtog-obj or
     4428                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4429                 no-lock :
     4430         if  x-tog-shift = false then do:
     4431                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4432                               ub.stk-tot.Fact-date <=  x-date-start
     4433                               and ub.stk-tot.shift-num = 0
     4434                               USE-INDEX fact-date no-lock no-error .
     4435              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4436         End.
     4437         Else  DO :
     4438             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4439              (ub.stk-tot.shift-date  = x-date-start-t and
     4440               ub.stk-tot.shift-num  < x-shift-start or
     4441               ub.stk-tot.shift-date  < x-date-start-t  )
     4442               and ub.stk-tot.shift-num  > 0
     4443               USE-INDEX Shift-num no-lock no-error .
     4444            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4445           END.
     4446       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4447     End.
     4448   End.
     4449   Else DO:
     4450     For each obj-list  WHERE
     4451        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4452         no-lock :
     4453      IF  x-TOG-Shift = False Then DO:
     4454          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4455               ub.stk-tot.Fact-date <= x-date-end
     4456               and ub.stk-tot.shift-num = 0
     4457               USE-INDEX fact-date no-lock no-error.
     4458          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4459      END.
     4460      Else DO:
     4461           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4462               (ub.stk-tot.shift-date  = x-date-end and
     4463               ub.stk-tot.shift-num  <= x-shift-end or
     4464               ub.stk-tot.shift-date  < x-date-end       ) and
     4465               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4466               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4467       End.
     4468       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4469     End.
     4470   End.
     4471   END PROCEDURE.
     4472   procedure report-exec1  :
     4473      find first clients where x-store-type = clients.obj-type and
     4474                               x-store-code = clients.obj-code
     4475                               no-lock no-error.
     4476              if available clients then assign  objname = clients.obj-name
     4477                                                x-db-num     = clients.db-num.
     4478                                            else  objname="объект не определен".
     4479     run calcitog in this-procedure .
     4480     run print-header in this-procedure .      case retclassify :
     4481      when "vat-ps":u         then  run run7 in this-procedure .
     4482      otherwise do:
     4483        message "Ошибка вызова" view-as alert-box error .
     4484      end.
     4485      end case.
     4486     run print-footer in this-procedure .
     4487     end procedure.
     4488   procedure calc-sub-itog :
     4489   define input parameter tt as int no-undo.
     4490   define variable tt2 as integer no-undo .
     4491     if tt = 6 then tt2 = 7 .
     4492               else tt2 = tt.
     4493   repeat i# = 1 + tt to 3 + tt2 :
     4494   run sum-i (
     4495    input oborot-vt[i#]
     4496   ,input tt
     4497   ,input-output b1-oborot-vt[i#]
     4498   ,input-output b2-oborot-vt[i#]
     4499   ,input-output bi-oborot-vt[i#]
     4500   ,input-output bo-oborot-vt[i#]
     4501   ,input oborot-ie[i#]
     4502   ,input-output b1-oborot-ie[i#]
     4503   ,input-output b2-oborot-ie[i#]
     4504   ,input-output bi-oborot-ie[i#]
     4505   ,input-output bo-oborot-ie[i#]
     4506   ) .
     4507   run sum-i (
     4508    input oborot-iv[i#]
     4509   ,input tt
     4510   ,input-output b1-oborot-iv[i#]
     4511   ,input-output b2-oborot-iv[i#]
     4512   ,input-output bi-oborot-iv[i#]
     4513   ,input-output bo-oborot-iv[i#]
     4514   ,input oborot-ee[i#]
     4515   ,input-output b1-oborot-ee[i#]
     4516   ,input-output b2-oborot-ee[i#]
     4517   ,input-output bi-oborot-ee[i#]
     4518   ,input-output bo-oborot-ee[i#]
     4519   ) .
     4520   run sum-i (
     4521    input oborot-ev[i#]
     4522   ,input tt
     4523   ,input-output b1-oborot-ev[i#]
     4524   ,input-output b2-oborot-ev[i#]
     4525   ,input-output bi-oborot-ev[i#]
     4526   ,input-output bo-oborot-ev[i#]
     4527   ,input oborot-ep[i#]
     4528   ,input-output b1-oborot-ep[i#]
     4529   ,input-output b2-oborot-ep[i#]
     4530   ,input-output bi-oborot-ep[i#]
     4531   ,input-output bo-oborot-ep[i#]
     4532   ) .
     4533   run sum-i (
     4534    input oborot-rv[i#]
     4535   ,input tt
     4536   ,input-output b1-oborot-rv[i#]
     4537   ,input-output b2-oborot-rv[i#]
     4538   ,input-output bi-oborot-rv[i#]
     4539   ,input-output bo-oborot-rv[i#]
     4540   ,input oborot-es[i#]
     4541   ,input-output b1-oborot-es[i#]
     4542   ,input-output b2-oborot-es[i#]
     4543   ,input-output bi-oborot-es[i#]
     4544   ,input-output bo-oborot-es[i#]
     4545   ) .
     4546   run sum-i (
     4547    input oborot-em[i#]
     4548   ,input tt
     4549   ,input-output b1-oborot-em[i#]
     4550   ,input-output b2-oborot-em[i#]
     4551   ,input-output bi-oborot-em[i#]
     4552   ,input-output bo-oborot-em[i#]
     4553   ,input oborot-re[i#]
     4554   ,input-output b1-oborot-re[i#]
     4555   ,input-output b2-oborot-re[i#]
     4556   ,input-output bi-oborot-re[i#]
     4557   ,input-output bo-oborot-re[i#]
     4558   ) .
     4559   run sum-i (
     4560    input oborot-im[i#]
     4561   ,input tt
     4562   ,input-output b1-oborot-im[i#]
     4563   ,input-output b2-oborot-im[i#]
     4564   ,input-output bi-oborot-im[i#]
     4565   ,input-output bo-oborot-im[i#]
     4566   ,input oborot-rs[i#]
     4567   ,input-output b1-oborot-rs[i#]
     4568   ,input-output b2-oborot-rs[i#]
     4569   ,input-output bi-oborot-rs[i#]
     4570   ,input-output bo-oborot-rs[i#]
     4571   ) .
     4572   run sum-i (
     4573    input oborot-ot[i#]
     4574   ,input tt
     4575   ,input-output b1-oborot-ot[i#]
     4576   ,input-output b2-oborot-ot[i#]
     4577   ,input-output bi-oborot-ot[i#]
     4578   ,input-output bo-oborot-ot[i#]
     4579   ,input oborot-we[i#]
     4580   ,input-output b1-oborot-we[i#]
     4581   ,input-output b2-oborot-we[i#]
     4582   ,input-output bi-oborot-we[i#]
     4583   ,input-output bo-oborot-we[i#]
     4584   ) .
     4585   run sum-i (
     4586    input oborot-ap[i#]
     4587   ,input tt
     4588   ,input-output b1-oborot-ap[i#]
     4589   ,input-output b2-oborot-ap[i#]
     4590   ,input-output bi-oborot-ap[i#]
     4591   ,input-output bo-oborot-ap[i#]
     4592   ,input oborot-pc[i#]
     4593   ,input-output b1-oborot-pc[i#]
     4594   ,input-output b2-oborot-pc[i#]
     4595   ,input-output bi-oborot-pc[i#]
     4596   ,input-output bo-oborot-pc[i#]
     4597   ) .
     4598     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4599     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4600     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4601     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4602     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4603     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4604     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4605     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4606     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4607     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4608     if i# = 8 then
     4609       assign
     4610         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4611                                 bi-oborot-re[ i#]         +
     4612                                 bi-oborot-rs[ i#]    +
     4613                                 bi-oborot-es[ i#]
     4614         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4615                                 b1-oborot-re[ i#]         +
     4616                                 b1-oborot-rs[ i#]    +
     4617                                 b1-oborot-es[ i#]
     4618         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4619                                 b2-oborot-re[ i#]         +
     4620                                 b2-oborot-rs[ i#]    +
     4621                                 b2-oborot-es[ i#]
     4622         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4623                                 bo-oborot-re[ i#]         +
     4624                                 bo-oborot-rs[ i#]    +
     4625                                 bo-oborot-es[ i#]
     4626         .
     4627     if  xshowmediator = true  then do:
     4628         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4629         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4630         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4631         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4632     end.
     4633     if i# = 2 and xshowmediator = false  then
     4634         assign
     4635           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4636                                   bi-oborot-re[ i#]         +
     4637                                   bi-oborot-rs[ i#]    +
     4638                                   bi-oborot-es[ i#]
     4639           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4640                                   b1-oborot-re[ i#]         +
     4641                                   b1-oborot-rs[ i#]    +
     4642                                   b1-oborot-es[ i#]
     4643           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4644                                   b2-oborot-re[ i#]         +
     4645                                   b2-oborot-rs[ i#]    +
     4646                                   b2-oborot-es[ i#]
     4647           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4648                                   bo-oborot-re[ i#]         +
     4649                                   bo-oborot-rs[ i#]    +
     4650                                   bo-oborot-es[ i#]
     4651           .
     4652     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4653     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4654     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4655     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4656     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4657                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4658                      else bi-oborot-prc[1] = 0.
     4659     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4660                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4661                      else bo-oborot-prc[1] = 0.
     4662     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4663                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4664                      else b1-oborot-prc[1] = 0.
     4665     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4666                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4667                      else b2-oborot-prc[1] = 0.
     4668    end.
     4669   end procedure.
     4670   procedure sum-i :
     4671   define input parameter ob like oborot-ot[1] no-undo.
     4672   define input parameter tt as int  no-undo.
     4673   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4674   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4675   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4676   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4677   define input parameter ob2 like oborot-ot[1] no-undo.
     4678   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4679   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4680   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4681   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4682   assign
     4683    b1  = b1 + ob
     4684    b2  = b2 + ob
     4685    b1- = b1- + ob2
     4686    b2- = b2- + ob2
     4687    .
     4688       assign
     4689       bi = bi + ob
     4690       bo = bo + ob
     4691       bi- = bi- + ob2
     4692       bo- = bo- + ob2
     4693       .
     4694   end procedure.
     4695   procedure clear-item :
     4696   define variable kk as int no-undo.
     4697    repeat kk = 1 to 13 :
     4698    assign
     4699       oborot-ie                 [kk]    = 0
     4700       oborot-ee                 [kk]    = 0
     4701       oborot-ep              [kk]    = 0
     4702       oborot-es            [kk]    = 0
     4703       oborot-re             [kk]    = 0
     4704       oborot-rs        [kk]    = 0
     4705       oborot-we                 [kk]    = 0
     4706       oborot-vt                       [kk]    = 0
     4707       oborot-iv                 [kk]    = 0
     4708       oborot-ev                 [kk]    = 0
     4709       oborot-rv             [kk]    = 0
     4710       oborot-em                  [kk]    = 0
     4711       oborot-wm                  [kk]    = 0
     4712       oborot-im                  [kk]    = 0
     4713       oborot-ot                  [kk]    = 0
     4714       oborot-disc                             [kk]    = 0
     4715       oborot-eff                              [kk]    = 0
     4716       oborot-prc                              [kk]    = 0
     4717       oborot-ap            [kk]    = 0
     4718       oborot-pc            [kk]    = 0
     4719       ostatok-end                                    [kk]    = 0
     4720       ostatok-start                                  [kk]    = 0
     4721     .
     4722    end.
     4723   end procedure.
     4724   procedure item-goods :
     4725    define input parameter  par-3 as char no-undo.
     4726    define input parameter  par-4 as char no-undo.
     4727        if par-4 = "goods":u  then  assign
     4728                                       gds-zap-unit-base  = goods.unit-base
     4729                                       gds-zap-prt-root   = goods.prt-root
     4730                                       gds-zap-prod-type  = goods.prod-type
     4731                                       gds-zap-prod-code  = goods.prod-code
     4732                                       gds-zap-artic      = goods.artic
     4733                                       gds-zap-type       = goods.gds-type
     4734                                       gds-zap-grp-name   = goods.grp-name
     4735                                       gds-zap-b-code     = goods.gds-code
     4736                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4737                                                                          else goods.gds-name
     4738                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4739                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4740        if par-4 = "gds-list":u  then  assign
     4741                                       gds-zap-unit-base  = gds-list.unit-base
     4742                                       gds-zap-prt-root   = gds-list.prt-root
     4743                                       gds-zap-prod-type  = gds-list.prod-type
     4744                                       gds-zap-prod-code  = gds-list.prod-code
     4745                                       gds-zap-artic      = gds-list.artic
     4746                                       gds-zap-type       = gds-list.gds-type
     4747                                       gds-zap-grp-name   = gds-list.grp-name
     4748                                       gds-zap-b-code     = gds-list.gds-code
     4749                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4750                                                                          else gds-list.gds-name
     4751                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4752                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4753       run foreach in this-procedure .
     4754   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4755     (input  gds-zap-b-code
     4756     ,input  ?
     4757     ,output v-bar-code
     4758     )  .
     4759   s-bar-code = string (v-bar-code,"999999999").
     4760       If  break_group = true  and par-3 <> "1"  then DO :
     4761            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4762            gds-zap-prod-name  = clients.obj-name.
     4763             If break_group1 = true  THEN  DO :
     4764               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4765                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4766                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4767               if par-3 = "6"  then  dO:
     4768                  if xTog-obj = true then do:
     4769                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4770                   end.
     4771                  else do:
     4772                   var-vat-pc = temp-gds-list.vat-pc  .
     4773                   end.
     4774                   assign
     4775                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4776                       b1-name = temp-str .
     4777                   end.
     4778               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4779                   fr0 = true .
     4780                   tmp#stroka0 = temp-str.
     4781               End .
     4782             End .
     4783             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4784               if par-3 = "4"
     4785                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4786                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4787               if NOT xSumsOnly THEN DO :
     4788               fr = true .
     4789               End.
     4790               break_group1 = false.
     4791             END.
     4792          break_group = false.
     4793       End.
     4794       run display-line in this-procedure .
     4795    end procedure.
     4796   procedure b1-null-str-pr :
     4797    if (
     4798        b1-oborot-im                 [1] = 0 and
     4799        b1-oborot-wm                 [1] = 0 and
     4800        b1-oborot-em                 [1] = 0 and
     4801        b1-oborot-ie                 [1] = 0 and
     4802        b1-oborot-ee                 [1] = 0 and
     4803        b1-oborot-ep              [1] = 0 and
     4804        b1-oborot-es            [1] = 0 and
     4805        b1-oborot-re             [1] = 0 and
     4806        b1-oborot-rs        [1] = 0 and
     4807        b1-oborot-we                 [1] = 0 and
     4808        b1-oborot-vt                       [1] = 0 and
     4809        b1-oborot-iv                [1] = 0 and
     4810        b1-oborot-ev                [1] = 0 and
     4811        b1-oborot-rv            [1] = 0 and
     4812        b1-oborot-ot                 [2] = 0 and
     4813        b1-oborot-ap           [1] = 0 and
     4814        b1-oborot-pc           [1] = 0 and
     4815        b1-ostatok-end[1]                                    = 0 and
     4816        b1-ostatok-start[1]                                  = 0 and
     4817        b1-oborot-im                 [2] = 0 and
     4818        b1-oborot-wm                 [2] = 0 and
     4819        b1-oborot-em                 [2] = 0 and
     4820        b1-oborot-ie                 [2] = 0 and
     4821        b1-oborot-ee                 [2] = 0 and
     4822        b1-oborot-ep              [2] = 0 and
     4823        b1-oborot-es            [2] = 0 and
     4824        b1-oborot-re             [2] = 0 and
     4825        b1-oborot-rs        [2] = 0 and
     4826        b1-oborot-we                 [2] = 0 and
     4827        b1-oborot-vt                       [2] = 0 and
     4828        b1-oborot-iv                [2] = 0 and
     4829        b1-oborot-ev                [2] = 0 and
     4830        b1-oborot-rv            [2] = 0 and
     4831        b1-oborot-ap           [2] = 0 and
     4832        b1-oborot-pc           [2] = 0 and
     4833        b1-ostatok-end[2]                                    = 0 and
     4834        b1-ostatok-start[2]                                  = 0
     4835        ) then  b1-null-str# = 0    .
     4836   end procedure.
     4837   procedure b1-null-str-pr2 :
     4838    if (
     4839        b1-oborot-im                 [1] = 0 and
     4840        b1-oborot-wm                 [1] = 0 and
     4841        b1-oborot-em                 [1] = 0 and
     4842        b1-oborot-ie                 [1] = 0 and
     4843        b1-oborot-ee                 [1] = 0 and
     4844        b1-oborot-ep              [1] = 0 and
     4845        b1-oborot-es            [1] = 0 and
     4846        b1-oborot-re             [1] = 0 and
     4847        b1-oborot-rs        [1] = 0 and
     4848        b1-oborot-we                 [1] = 0 and
     4849        b1-oborot-vt                       [1] = 0 and
     4850        b1-oborot-iv                [1] = 0 and
     4851        b1-oborot-ev                [1] = 0 and
     4852        b1-oborot-rv            [1] = 0 and
     4853        b1-oborot-ap           [1] = 0 and
     4854        b1-oborot-pc           [1] = 0 and
     4855        b1-oborot-ot                 [1] = 0 and
     4856        b1-oborot-ot                 [2] = 0 and
     4857        b1-oborot-im                 [2] = 0 and
     4858        b1-oborot-wm                 [2] = 0 and
     4859        b1-oborot-em                 [2] = 0 and
     4860        b1-oborot-ie                 [2] = 0 and
     4861        b1-oborot-ee                 [2] = 0 and
     4862        b1-oborot-ep              [2] = 0 and
     4863        b1-oborot-es            [2] = 0 and
     4864        b1-oborot-re             [2] = 0 and
     4865        b1-oborot-rs        [2] = 0 and
     4866        b1-oborot-we                 [2] = 0 and
     4867        b1-oborot-vt                       [2] = 0 and
