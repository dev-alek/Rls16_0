     2464   procedure display-line :
     2465     i = i + 1.
     2466      if not  (not show-negativ and null-str# = 0 ) then do:
     2467          if not  (not show-negativ-2 and null-str2# = 0  ) then do:
     2468           if not sums-only then do:
     2469               if fr0 = true then do:
     2470                 num#str# = num#str# + 1.
     2471                 num#col# = 1.
     2472                 run macr_excel_char_with_format( string(tmp#stroka0)  , num#str# , num#col#  ) .
     2473                 run macr_cell_format
     2474                 ( 10    ,
     2475                   true  ,
     2476                   true  ,
     2477                   33    ,
     2478                   num#str# ,
     2479                   num#col# ,
     2480                   num#str# ,
     2481                   5 ) .
     2482                 fr0 = false .
     2483               end.
     2484               if fr = true then do:
     2485                   num#str# = num#str# + 1.
     2486                   num#col# = 2.
     2487                   run macr_excel_char_with_format( string(caps(temp-str))  , num#str# , num#col#  ) .
     2488                   run macr_cell_format
     2489                     ( 10    ,
     2490                       true  ,
     2491                       true  ,
     2492                       36    ,
     2493                       num#str# ,
     2494                       num#col# ,
     2495                       num#str# ,
     2496                       5 ) .
     2497                 fr = false .
     2498               end.
     2499               run display-str1 in this-procedure .
     2500               run new-tmp-page .
     2501               end.
     2502           end.
     2503       end.
     2504   end procedure.
     2505   procedure print-header :
     2506   if not firstline then   do: end.
     2507       firstline = true .
     2508       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2509        num#str# = num#str# + 1.
     2510        num#col# = 1.
     2511        run macr_excel_char_with_format(
     2512        string(  "ПО ОБЪЕКТУ : " + ObjName)
     2513         , num#str# , num#col#  ) .
     2514        num#col# = num#col# + 3.
     2515        run macr_excel_char_with_format(
     2516        string(  x-store-type + " " + string(x-store-code)  )
     2517         , num#str# , num#col#  ) .
     2518        num#col# = num#col# + 1.
     2519        run macr_excel_char_with_format(
     2520        string( "УБД " + string(x-db-num)  )
     2521         , num#str# , num#col#  ) .
     2522       end.
     2523         run clear-b1 in this-procedure .
     2524         run clear-b2 in this-procedure .
     2525         run clear-bi in this-procedure .
     2526         break_group = true.
     2527         break_group1 = true.
     2528      end procedure.
     2529   procedure print-footer :
     2530        num#str# = num#str# + 1.
     2531        num#col# = 1.
     2532        run macr_excel_char_with_format( string("ИТОГО"  )  , num#str# , num#col#  ) .
     2533        run display-bi in this-procedure .
     2534   end procedure.
     2535   procedure run7 :
     2536         case select-good:
     2537           when 1   then do:
     2538   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2539   IF x-SelectObject = "currency":U  OR  xTog-obj then do :
     2540   define variable first-l18 as logical   no-undo .
     2541     first-l18 = true .
     2542     for each gds-obj
     2543       where gds-obj.obj-type = x-store-type
     2544         and gds-obj.obj-code = x-store-code
     2545             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     2546             no-lock,
     2547         first goods  where  goods.gds-code = gds-obj.gds-code
     2548         no-lock
     2549         break by func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code)
     2550               by (goods.gds-name)
     2551               :
     2552         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     2553         if last-vat <> var-vat-pc then do:
     2554             if not first-l18 then do:
     2555               Assign
     2556                   s-bar-code    = ""
     2557                   gds-zap-artic = "        Итого по "
     2558                   gds-zap-gds-name = b1-name
     2559                   .
     2560                 run display-b1.
     2561                 run clear-b1  .
     2562             end.
     2563             Assign
     2564               first-l18 = false
     2565               break_group = true
     2566               break_group1 = true
     2567               .
     2568             end.
     2569         first-l18 = false .
     2570         run item-goods ( "6" , "goods" ) .
     2571         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     2572      end.
     2573       Assign
     2574           s-bar-code   = ""
     2575           gds-zap-artic = "        Итого по "
     2576           gds-zap-gds-name = b1-name
     2577           .
     2578         run display-b1.
     2579         run clear-b1.
     2580   end.
     2581   else do:
     2582      For each obj-list no-lock :
     2583                     FOR EACH gds-obj where
     2584                         gds-obj.obj-type = obj-list.obj-type    and
     2585                         gds-obj.obj-code = obj-list.obj-code
