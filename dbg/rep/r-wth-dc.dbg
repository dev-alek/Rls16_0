      677   define button B-WaitFramStop auto-end-key
      678        label "Стоп"
      679        size 10 by 1 tooltip "Остоновить процесс".
      680   define button B-viewProcInfo
      681        label "Информация"
      682        size 15 by 1 tooltip "Информация о процесс".
      683   define frame waitfram
      684     v-waitfram-action01 format "x(72)" no-label skip
      685     v-waitfram-action02 format "x(72)" no-label skip
      686     v-waitfram-action03 format "x(72)" no-label skip
      687     B-viewProcInfo
      688     B-WaitFramStop at row 4 col 30
      689     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      690     .
      691   define new global shared variable mBatchMode as logical no-undo init ?.
      692   define variable mFramBachModHandle as handle no-undo.
      693   mFramBachModHandle = frame waitfram:handle.
      694   define variable mFameOldVis as logical no-undo.
      695   define variable mVisCUrentVin as logical no-undo.
      696   if session:batch-mode
      697   then
      698      mBatchMode = yes.
      699   if mBatchMode = ? then do:
      700     mVisCUrentVin = current-window:visible.
      701     mFameOldVis = mFramBachModHandle:visible.
      702     mFramBachModHandle:visible  = yes.
      703     mBatchMode = mFramBachModHandle:visible ne yes.
      704     mFramBachModHandle:visible = mFameOldVis.
      705     current-window:visible = mVisCUrentVin.
      706   end.
      707    if  log-manager:logfile-name ne ?
      708     then DO:
      709         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      710         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      711         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      712     end.
      713   on choose of B-WaitFramStop in frame waitfram
      714   do:
      715     mWaitFramStop = yes.
      716     mWaitFramStopUser = yes.
      717   end.
      718   function waitfram-check-timeout returns logical():
      719      define variable vtime as int64 no-undo.
      720      if mWaitFramStopTimeOut
      721      then
      722         return yes.
      723      vtime = ( now - mWaitFramStartProc ) / 1000 .
      724      if     mWaitFramTimeOut ne ?
      725         and mWaitFramTimeOut ne 0
      726         and mWaitFramTimeOut lt vtime
      727      then do:
      728         mWaitFramStopTimeOut = yes.
      729      end.
      730      return mWaitFramStopTimeOut.
      731   end.
      732   procedure waitfram-hide :
      733     if not session:batch-mode
      734     then do
      735     on error undo, return error return-value
      736     :
      737       pause 0 before-hide .
      738       if not mBatchMode then
      739         hide frame waitfram .
      740     if     not mWaitFramView
      741        and mWaitProcEvent
      742     then
      743       process events .
      744     end.
      745   end procedure.
      746   procedure waitfram-show :
      747     define input  parameter p-message as character no-undo .
      748     define variable v-left-margin as integer   no-undo .
      749     if not session:batch-mode
      750     then do
      751     on error undo, return error return-value
      752     :
      753       if length(p-message) <= 70 then do:
      754         assign
      755           v-left-margin = integer((70 - length(p-message)) / 2)
      756         .
      757         assign
      758           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      759         .
      760         assign
      761           v-waitfram-action01 = " "
      762           v-waitfram-action02 = " "
      763                                    + fill(" ", v-left-margin)
      764                                    + p-message
      765           v-waitfram-action03 = " "
      766         .
      767       end.
      768       else do:
      769         define variable vRindex1 as integer no-undo.
      770         define variable vRindex2 as integer no-undo.
      771         vRindex1 = r-index(p-message," ",70).
      772         if vRindex1 = 0
      773         then
      774            vRindex1 = 70.
      775         if length(p-message)  <= vRindex1 + 70 then do:
      776           assign
      777             v-waitfram-action01 = " "
      778             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      779             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      780           .
      781         end.
      782         else do:
      783           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      784           if vRindex2 <= vRindex1
      785           then
      786              vRindex2 = vRindex1 + 70.
      787           assign
      788             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      789             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      790             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      791           .
      792         end.
      793       end.
      794       B-viewProcInfo:visible   in frame waitfram = no.
      795       B-viewProcInfo:sensitive in frame waitfram = no.
      796       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      797       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      798       if  (   mWaitFramView
      799          or  mWaitProcEvent)
      800          and not mBatchMode
      801       then
      802          display
      803             v-waitfram-action01 skip
      804             v-waitfram-action02 skip
      805             v-waitfram-action03 skip
      806          with frame waitfram .
      807       if     mWaitFramView
      808          then do:
      809             if     mWaitFramInterval ne ?
      810                and not mBatchMode
      811             then
      812                wait-for go of frame waitfram pause mWaitFramInterval.
      813          end.
      814          else
      815             if     mWaitProcEvent
      816                and not mBatchMode
      817             then
      818                process events .
      819     end.
      820   end procedure.
      821      procedure waitfram-show-this:
      822         define input  parameter iInterval as int64 no-undo.
      823         define variable vtime as int64 no-undo.
      824         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      825         mWaitFramInterval = iInterval.
      826         run waitfram-show (substitute("&1&2 &3&4" ,
      827                                       mWaitFramTextBeg ,
      828                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      829                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      830                                       mWaitFramTextEnd
      831                                      )
      832                           ).
      833      end.
      834      procedure WaitFramRunPause:
      835         define input  parameter iInterval as dec no-undo.
      836         define variable vStart  as datetime-tz no-undo.
      837         define variable vend    as datetime-tz no-undo.
      838         define variable vint as int64 no-undo.
      839         define variable vOk as logical no-undo.
      840         vStart = now.
      841         vend   = vStart.
      842         publish "WaitFramPause" (iInterval,output vOk).
      843         vend   =  now.
      844         vint = vend - vStart.
      845         vint = iInterval - vint / 1000.
      846         if     not mWaitFramStop
      847            and (   vint > 0
      848                 or (    not vOk
      849                     and iInterval eq ?
      850                     )
      851                 )
      852         then
      853            run waitfram-show-this (iInterval).
      854         vend   =  now.
      855         vint = vend - vStart.
      856         vint = iInterval - vint / 1000.
      857         if     not mWaitFramStop
      858            and vint > 0
      859         then do:
      860            run gbl/pause.p (vint * 1000).
      861         end.
      862         if iInterval ne ?
      863         then
      864            publish "WaitFramStop".
      865         waitfram-check-timeout().
      866      end.
      867      procedure WaitFramWaitFor:
      868         define input  parameter iInterval as dec no-undo.
      869         assign
      870            mWaitFramStartProc   = now
      871            mWaitFramStopUser    = no
      872            mWaitFramStopTimeOut = no
      873         .
      874         block-wait:
      875         do while not mWaitFramStop:
      876            run WaitFramRunPause (iInterval).
      877            if  waitfram-check-timeout()
      878            then do:
      879               leave block-wait.
      880            end.
      881         end.
      882         run waitfram-hide.
      883      end.
      884   procedure waitfram-join :
      885     define input  parameter p-line-1  as character no-undo .
      886     define input  parameter p-line-2  as character no-undo .
      887     define input  parameter p-line-3  as character no-undo .
      888     define output parameter p-message as character no-undo .
      889     do
      890     on error undo, return error return-value
      891     :
      892       assign
      893         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      894                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      895                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      896       .
      897     end.
      898   end procedure.
      899   function waitfram-join-function returns character
      900     (input p-line-1 as character
      901     ,input p-line-2 as character
      902     ,input p-line-3 as character
      903     ).
      904     define variable v-message as character no-undo .
      905     run waitfram-join in this-procedure
      906       (input  p-line-1
      907       ,input  p-line-2
      908       ,input  p-line-3
      909       ,output v-message
      910       ) .
      911     return v-message .
      912   end function .
      913   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      914   procedure cur-time :
      915      define output parameter p-today as date      no-undo .
      916      define output parameter p-time  as integer   no-undo .
      917     do
      918     on error undo, return error
      919     :
      920       define variable v-date1 as date      no-undo .
      921       define variable v-date2 as date      no-undo .
      922       define variable v-time  as integer   no-undo .
      923       assign
      924         v-date1 = today
      925         v-time  = time
      926         v-date2 = today
      927       .
      928       if v-date1 <> v-date2
      929       then do:
      930         assign
      931           v-date1 = today
      932           v-time  = v-time
      933         .
      934       end.
      935       assign
      936         p-today = v-date1
      937         p-time  = v-time
      938       .
      939     end.
      940   end.
      941   function cur-time-date returns character
      942   :
      943     return string(today, '99/99/9999':U) .
      944   end.
      945   function cur-time-mjd returns decimal
      946   :
      947     define variable v-date as date      no-undo .
      948     define variable v-time as integer   no-undo .
      949     run cur-time in this-procedure
      950       (output v-date
      951       ,output v-time
      952       ) .
      953     return integer(v-date) - 2400002 + (v-time / 86400) .
      954   end.
      955   function cur-time-get-ending-index returns integer
      956   (input p-number as integer
      957   )
      958   :
      959     if p-number < 0
      960     or p-number = ?
      961     then do:
      962       return 1 .
      963     end.
      964     define variable v-rest as integer   no-undo .
      965     assign
      966       p-number = p-number modulo 100
      967     .
      968     if p-number < 20
      969     then do:
      970       assign
      971         v-rest = p-number
      972       .
      973     end.
      974     else do:
      975       assign
      976         v-rest = p-number modulo 10
      977       .
      978     end.
      979     case v-rest :
      980       when 1
      981       then do:
      982         return 2 .
      983       end.
      984       when 2 or
      985       when 3 or
      986       when 4
      987       then do:
      988         return 3 .
      989       end.
      990       otherwise do:
      991         return 1 .
      992       end.
      993     end case .
      994   end.
      995   procedure cur-time-mjd-to-date :
      996      define input  parameter i-mjd-diff as decimal no-undo.
      997      define output parameter o-Date     as date    no-undo.
      998      define output parameter o-Time     as integer no-undo.
      999      define variable v-day-number as integer   no-undo .
     1000      if    i-mjd-diff < 0
     1001         or i-mjd-diff = ?
     1002      then do:
     1003         return "?" .
     1004      end.
     1005      assign
     1006         v-day-number = truncate(i-mjd-diff,0).
     1007         o-Date = date(v-day-number + 2400002).
     1008         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1009     .
     1010   end.
     1011   function cur-time-mjd-to-string returns character
     1012   (input p-mjd-diff as decimal
     1013   )
     1014   :
     1015     define variable v-day-number as integer   no-undo .
     1016     define variable v-seconds    as integer   no-undo .
     1017     define variable v-hour       as integer   no-undo .
     1018     define variable v-min        as integer   no-undo .
     1019     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1020     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1021     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1022     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1023     if p-mjd-diff < 0
     1024     or p-mjd-diff = ?
     1025     then do:
     1026       return "?" .
     1027     end.
     1028     assign
     1029       v-day-number = integer(truncate(p-mjd-diff,0))
     1030       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1031     .
     1032     if v-seconds > 86400
     1033     then do:
     1034       assign
     1035         v-seconds = 86400 - 1
     1036       .
     1037     end.
     1038     if v-seconds < 0
     1039     then do:
     1040       assign
     1041         v-seconds = 0
     1042       .
     1043     end.
     1044     assign
     1045       v-hour = truncate(v-seconds / 3600, 0)
     1046     .
     1047     assign
     1048       v-seconds = v-seconds modulo 3600
     1049     .
     1050     assign
     1051       v-min = truncate(v-seconds / 60, 0)
     1052     .
     1053     assign
     1054       v-seconds = v-seconds modulo 60
     1055     .
     1056     return
     1057         (if v-day-number <> 0
     1058           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1059           else ""
     1060         )
     1061       + (if v-day-number <> 0 or v-hour <> 0
     1062           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1063           else ""
     1064         )
     1065       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1066           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1067           else ""
     1068         )
     1069       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1070       .
     1071   end.
     1072   function cur-time-string returns character
     1073   :
     1074     define variable v-date as date      no-undo .
     1075     define variable v-time as integer   no-undo .
     1076     run cur-time in this-procedure
     1077       (output v-date
     1078       ,output v-time
     1079       ) .
     1080     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1081   end.
     1082   function cur-time-string-sec returns character
     1083   :
     1084     define variable v-date as date      no-undo .
     1085     define variable v-time as integer   no-undo .
     1086     run cur-time in this-procedure
     1087       (output v-date
     1088       ,output v-time
     1089       ) .
     1090     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1091   end.
     1092   function cur-time-custom  returns character
     1093   (input p-prefix as character
     1094   ,input p-date-format as character
     1095   ,input p-delimiter as character
     1096   ,input p-time-format as character
     1097   ,input p-suffix as character
     1098   )
     1099   :
     1100     define variable v-date as date      no-undo .
     1101     define variable v-time as integer   no-undo .
     1102     run cur-time in this-procedure
     1103       (output v-date
     1104       ,output v-time
     1105       ) .
     1106     return
     1107       p-prefix
     1108       + string(v-date, p-date-format)
     1109       + p-delimiter
     1110       + string(v-time, p-time-format)
     1111       + p-suffix
     1112       .
     1113   end.
     1114   function cur-time-print  returns character
     1115   :
     1116     define variable v-date as date      no-undo .
     1117     define variable v-time as integer   no-undo .
     1118     run cur-time in this-procedure
     1119       (output v-date
     1120       ,output v-time
     1121       ) .
     1122     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1123   end.
     1124   function cur-time-datetime returns datetime
     1125   :
     1126     define variable v-char as character no-undo .
     1127     define variable v-datetime as datetime no-undo .
     1128     v-char = cur-time-string().
     1129     v-datetime = datetime(v-char).
     1130     return  v-datetime.
     1131   end.
     1132   function cur-time-string-msec returns character
     1133   :
     1134     define variable v-date as datetime  no-undo .
     1135     v-date = now.
     1136     return string(v-date) .
     1137   end.
     1138   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     1139     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1140     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     1141     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     1142   END FUNCTION.
     1143   PROCEDURE get-sparsed-string :
     1144     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1145     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1146     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     1147     DO ON ERROR UNDO, RETURN ERROR :
     1148       DO jj = 1 TO LENGTH( p-instring ) :
     1149         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     1150       END.
     1151       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     1152     END.
     1153   END PROCEDURE.
     1154   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     1155     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1156     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     1157     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     1158   END FUNCTION.
     1159   PROCEDURE get-centre-string :
     1160     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1161     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     1162     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1163     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     1164     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     1165     DO ON ERROR UNDO, RETURN ERROR :
     1166       ASSIGN p-instring = TRIM(   p-instring )
     1167              j-format   = LENGTH( p-instring ).
     1168       IF           j-format > p-length THEN DO:
     1169         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     1170       END. ELSE IF j-format < p-length THEN DO:
     1171         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     1172                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     1173       END.                             ELSE DO:
     1174         ASSIGN p-outstring = p-instring.
     1175       END.
     1176     END.
     1177   END PROCEDURE.
     1178   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     1179     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     1180     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     1181     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     1182   END FUNCTION.
     1183   PROCEDURE get-right-string :
     1184     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     1185     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     1186     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     1187     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     1188     DO ON ERROR UNDO, RETURN ERROR :
     1189       ASSIGN p-instring = TRIM(   p-instring )
     1190              j-format   = LENGTH( p-instring ).
     1191       IF           j-format > p-length THEN DO:
     1192         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     1193       END. ELSE IF j-format < p-length THEN DO:
     1194         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     1195       END.                             ELSE DO:
     1196         ASSIGN p-outstring = p-instring.
     1197       END.
     1198     END.
     1199   END PROCEDURE.
