      218   def
      219    shared
      220   temp-table  obj-list no-undo
      221     field obj-type like ub.clients.obj-type
      222     field obj-code like ub.clients.obj-code
      223     field obj-name like ub.clients.obj-name
      224     field obj-id   as integer
      225     field db-num   as integer
      226     index pi is primary unique obj-id
      227     index ie1 obj-type obj-code
      228     index ie2 obj-name
      229   .
      230   procedure create_obj-list :
      231      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      232      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      233      do
      234      on error undo, return error return-value
      235      :
      236         define buffer cli-obj for ub.clients .
      237         define variable p-var as integer no-undo .
      238         define buffer buf_obj-list for obj-list .
      239         find last buf_obj-list  use-index pi no-error .
      240         if available buf_obj-list
      241         then
      242            p-var = buf_obj-list.obj-id + 1.
      243         else
      244            p-var = 1.
      245         find first cli-obj where
      246                   cli-obj.obj-type = p-obj-type
      247               and cli-obj.obj-code = p-obj-code
      248         no-lock no-error.
      249         if available cli-obj
      250         then do:
      251            create buf_obj-list.
      252            assign
      253               buf_obj-list.obj-id   = p-var
      254               buf_obj-list.obj-code = cli-obj.obj-code
      255               buf_obj-list.obj-type = cli-obj.obj-type
      256               buf_obj-list.obj-name = cli-obj.obj-name
      257               buf_obj-list.db-num   = cli-obj.db-num
      258            .
      259         end.
      260      end.
      261   end.
