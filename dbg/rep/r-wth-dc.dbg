     2236           tt_line.shift-name = bf_line.shift-name
     2237           tt_line.shift-out  = "":U
     2238           tt_line.rest-from  = d_rest-from
     2239           tt_line.rest-till  = bf_line.rest-till
     2240           tt_line.cash-sum   = d_cash-sum
     2241           tt_line.incass-sum = d_incass-sum
     2242           tt_line.is-total   = yes
     2243         .
     2244         assign
     2245           tt_line.shift-out  = Centering( "Итого за смену:" , 23 )
     2246         .
     2247       end.
     2248     end.
     2249     assign
     2250       d_rest-from  = 0.00
     2251       d_rest-till  = 0.00
     2252       d_cash-sum   = 0.00
     2253       d_incass-sum = 0.00
     2254     .
     2255     for each bf_line no-lock where
     2256              bf_line.is-total = yes
     2257     :
     2258       if bf_line.obj-type   = "---" or
     2259          bf_line.obj-code   = -1 or
     2260          bf_line.shift-date = ?                 or
     2261          bf_line.shift-num  = 0
     2262       then do:
     2263         next .
     2264       end.
     2265       assign
     2266         d_rest-from  = d_rest-from  + bf_line.rest-from
     2267         d_rest-till  = d_rest-till  + bf_line.rest-till
     2268         d_cash-sum   = d_cash-sum   + bf_line.cash-sum
     2269         d_incass-sum = d_incass-sum + bf_line.incass-sum
     2270       .
     2271     end.
     2272     assign
     2273       j_order = j_order + 10
     2274     .
     2275     create tt_line .
     2276     assign
     2277       tt_line.order      = j_order + 8
     2278       tt_line.obj-type   = "---"
     2279       tt_line.obj-code   = -1
     2280       tt_line.obj-name   = v-obj-name
     2281       tt_line.own-type   = "":U
     2282       tt_line.own-code   = 0
     2283       tt_line.own-name   = v-own-name
     2284       tt_line.shift-date = ?
     2285       tt_line.shift-num  = 0
     2286       tt_line.shift-name = "":U
     2287       tt_line.shift-out  = "":U
     2288       tt_line.rest-from  = d_rest-from
     2289       tt_line.rest-till  = d_rest-till
     2290       tt_line.cash-sum   = d_cash-sum
     2291       tt_line.incass-sum = d_incass-sum
     2292       tt_line.is-total   = yes
     2293     .
     2294     assign
     2295       tt_line.shift-out  = Centering( "Итого:" , 23 )
     2296     .
     2297     assign
     2298       d_rest-from  = 0.00
     2299       d_rest-till  = 0.00
     2300       d_cash-sum   = 0.00
     2301       d_incass-sum = 0.00
     2302     .
     2303     assign
     2304       j_order-max = tt_line.order
     2305     .
     2306     run prn-lib-open-stream in this-procedure
     2307       ( input parparentproc
     2308       , input 62
     2309       , input yes
     2310       , input no
     2311       ) .
     2312     assign
     2313       v-report-name    = Centering( Sparse( "Отчет о движении материальных ценностей" ), 113 )
     2314       v-report-subname = Centering( Sparse( "за " + v-temp                            ), 113 )
     2315                        + chr(10)
     2316                        + chr(10)
     2317     .
     2318     if p-tog-object = yes
     2319     then do:
     2320       assign
     2321         j_line-counter = 0
     2322       .
     2323       for each tt_line no-lock where
     2324                tt_line.is-total = p-tog-total
     2325       break by tt_line.obj-type
     2326             by tt_line.obj-code
     2327             by tt_line.shift-date
     2328             by tt_line.shift-num
     2329       :
     2330         if p-tog-total        =  yes               and
     2331            tt_line.obj-type   =  "---" and
     2332            tt_line.obj-code   =  -1 and
     2333            tt_line.shift-date <> t_today           and
     2334            tt_line.shift-num  <> j_time
     2335         then do:
     2336           next .
     2337         end.
     2338         if first-of( tt_line.obj-code )
     2339         then do:
     2340           assign
     2341             v-firm-name   = tt_line.own-name
     2342             v-object-type = tt_line.obj-type
     2343             v-object-code = tt_line.obj-code
     2344             v-object-name = tt_line.obj-name
     2345           .
     2346           if v-firm-name = v-stored-name
     2347           then do:
     2348             assign
     2349               v-firm-name = "":U
     2350             .
     2351           end.
     2352           view stream text_out frame    Top_Page .
     2353           view stream text_out frame Bottom_Page .
     2354           if not first( tt_line.obj-code )
     2355           then do:
     2356             assign
     2357               v-report-name    = "":U
     2358               v-report-subname = "":U
     2359             .
     2360             if page-size( text_out ) > line-counter( text_out ) + 6 and
     2361                j_line-counter        > 0
     2362             then do:
     2363               put stream text_out unformatted
     2364                 v-firm-name               format "x(136)":U at 1                                                              skip( 0 )
     2365                 substitute( '&1 &2 "&3".'
     2366                           , v-object-type
     2367                           , v-object-code
     2368                           , v-object-name
     2369                           )               format "x(136)":U at 1                                                              skip( 0 )
     2370                 "-----------------------------------------------------------------------------------------------------------------" skip( 0 )                                                                                                       skip( 0 )                                                         "|                       :  Остаток на начало  :                     : Инкассировано в банк:   Остаток на конец  |" skip( 0 )                     "|     № и дата смены    :   периода (на АЗК)  :   Выручка за смену  :      (за смену)     :   периода (на АЗК)  |" skip( 0 )                     "|-----------------------:---------------------:---------------------:---------------------:---------------------|" skip( 0 )                                                                                                    skip( 0 )
     2371               .
     2372             end.
     2373             else do:
     2374               page stream text_out .
     2375             end.
     2376           end.
     2377           assign
     2378             v-firm-name   = tt_line.own-name
     2379             v-stored-name = tt_line.own-name
     2380           .
     2381         end.
     2382         put stream text_out unformatted
     2383           "|" string(         tt_line.shift-out                              , "x(23)":U )
     2384           ":" string( string( tt_line.rest-from,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2385           ":" string( string( tt_line.cash-sum,   "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2386           ":" string( string( tt_line.incass-sum, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2387           ":" string( string( tt_line.rest-till,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2388           "|" skip
     2389         .
     2390         if last-of( tt_line.obj-code )
     2391         then do:
     2392           if p-tog-total = no
     2393           then do:
     2394             find first bf_line no-lock where
     2395                        bf_line.is-total = yes              and
     2396                        bf_line.obj-type = tt_line.obj-type and
     2397                        bf_line.obj-code = tt_line.obj-code .
     2398             put stream text_out unformatted
     2399               "|-----------------------:---------------------:---------------------:---------------------:---------------------|" skip( 0 )
     2400             .
     2401             put stream text_out unformatted
     2402               "|" string(         bf_line.shift-out                              , "x(23)":U )
     2403               ":" string( string( bf_line.rest-from,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2404               ":" string( string( bf_line.cash-sum,   "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2405               ":" string( string( bf_line.incass-sum, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2406               ":" string( string( bf_line.rest-till,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2407               "|" skip
     2408             .
     2409           end.
     2410           if last( tt_line.obj-code )
     2411           then do:
     2412             put stream text_out unformatted
     2413               string( Under_Line, "x(113)":U ) skip( 0 )
     2414             .
     2415             hide stream text_out frame Bottom_Page .
     2416           end.
     2417           else do:
     2418             put stream text_out unformatted
     2419               string( Under_Line, "x(113)":U ) skip( 1 )
     2420             .
     2421           end.
     2422         end.
     2423         if last( tt_line.obj-code )
     2424         then do:
     2425           hide stream text_out frame Bottom_Page .
     2426         end.
     2427         assign
     2428           j_line-counter = j_line-counter + 1
     2429         .
     2430       end.
     2431     end.
     2432     else do:
     2433       assign
     2434         v-firm-name   = v-own-name
     2435         v-object-type = "":U
     2436         v-object-code = num-entries( v-obj-name )
     2437         v-object-name = v-obj-name
     2438       .
     2439       view stream text_out frame    Top_Page .
     2440       view stream text_out frame Bottom_Page .
     2441       assign
     2442         v-report-name    = "":U
     2443         v-report-subname = "":U
     2444       .
     2445       if p-tog-total = yes
     2446       then do:
     2447         assign
     2448           j_line-counter = 1
     2449         .
     2450       end.
     2451       else do:
     2452         assign
     2453           j_line-counter = 0
     2454         .
     2455         for each tt_line no-lock where
     2456                  tt_line.is-total = p-tog-total
     2457         break by tt_line.shift-date
     2458               by tt_line.shift-num
     2459               by tt_line.obj-type
     2460               by tt_line.obj-code
     2461         :
     2462           if p-tog-total        =  yes               and
     2463              tt_line.obj-type   <> "---" and
     2464              tt_line.obj-code   <> -1 and
     2465              tt_line.shift-date =  t_today           and
     2466              tt_line.shift-num  =  j_time
     2467           then do:
     2468             next .
     2469           end.
     2470           if tt_line.order      = j_order-max or
     2471              tt_line.shift-date = ?           or
     2472              tt_line.shift-num  = 0
     2473           then do:
     2474             next .
     2475           end.
     2476           if p-tog-total = yes
     2477           then do:
     2478             assign
     2479               v-temp-string = ShiftRight( substitute( '№ &1&3 от &2'
     2480                                         , tt_line.shift-name
     2481                                         , string( tt_line.shift-date, "99/99/9999":U )
     2482                                         , ( if tt_line.shift-name = string( tt_line.shift-num ) then "":U else
     2483                                           ( substitute( '(&1)'
     2484                                                       , tt_line.shift-num
     2485                                                       )
     2486                                           )
     2487                                           )
     2488                                         )
     2489                                         , 22 ) + " ":U
     2490             .
     2491             put stream text_out unformatted
     2492               "|" string( v-temp-string, "x(23)":U )
     2493             .
     2494           end.
     2495           else do:
     2496             put stream text_out unformatted
     2497               "|" string(         tt_line.shift-out                              , "x(23)":U )
     2498             .
     2499           end.
     2500           put stream text_out unformatted
     2501             ":" string( string( tt_line.rest-from,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2502             ":" string( string( tt_line.cash-sum,   "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2503             ":" string( string( tt_line.incass-sum, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2504             ":" string( string( tt_line.rest-till,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2505             "|" skip
     2506           .
     2507           if last( tt_line.shift-num )
     2508           then do:
     2509             hide stream text_out frame Bottom_Page .
     2510           end.
     2511           assign
     2512             j_line-counter = j_line-counter + 1
     2513           .
     2514         end.
     2515         put stream text_out unformatted
     2516           string( Under_Line, "x(113)":U ) skip
     2517         .
     2518       end.
     2519     end.
     2520     if j_line-counter > 0
     2521     then do:
     2522       find first bf_line no-lock where
     2523                  bf_line.order = j_order-max .
     2524       put stream text_out unformatted
     2525         "|" string(         bf_line.shift-out                              , "x(23)":U )
     2526         ":" string( string( bf_line.rest-from,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2527         ":" string( string( bf_line.cash-sum,   "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2528         ":" string( string( bf_line.incass-sum, "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2529         ":" string( string( bf_line.rest-till,  "->,>>>,>>>,>>>,>>9.99":U ), "x(21)":U )
     2530         "|" skip
     2531       .
     2532       put stream text_out unformatted
     2533         string( Under_Line, "x(113)":U ) skip
     2534       .
     2535     end.
     2536     hide stream text_out frame    Top_Page .
     2537     hide stream text_out frame Bottom_Page .
     2538     output stream text_out close .
     2539     run WaitFram-Hide in this-procedure .
     2540     run prn-lib-prn-file in this-procedure
     2541       ( input parparentproc
     2542       , input 0
     2543       ) .
     2544   end.
     2545   procedure wealth-rest :
     2546     define  input parameter p-obj-type    as character no-undo .
     2547     define  input parameter p-obj-code    as integer   no-undo .
     2548     define  input parameter p-shift-date  as date      no-undo .
     2549     define  input parameter p-shift-num   as integer   no-undo .
     2550     define output parameter p-rest-from   as decimal   no-undo initial 0.00 .
     2551     define output parameter p-rest-till   as decimal   no-undo initial 0.00 .
     2552     define output parameter p-incass-bank as decimal   no-undo initial 0.00 .
     2553     define variable d_stock-start  like ub.wth-line.income       no-undo .
     2554     define variable d_stock-end    like ub.wth-line.income       no-undo .
     2555     define variable d_income       like ub.wth-line.income       no-undo .
     2556     define variable d_income-cassa like ub.wth-line.income-cassa no-undo .
     2557     define variable d_income-other like ub.wth-line.income-other no-undo .
     2558     define variable d_incass       like ub.wth-line.incass       no-undo .
     2559     define variable d_incass-bank  like ub.wth-line.incass-bank  no-undo .
     2560     define variable d_incass-other like ub.wth-line.incass-other no-undo .
     2561     define variable d_incass-cassa like ub.wth-line.incass-cassa no-undo .
     2562     define buffer bf_wth-obj for ub.wth-obj .
     2563     do
     2564     on error undo, return error return-value
     2565     :
     2566       for each bf_wth-obj no-lock where
     2567                bf_wth-obj.obj-type = p-obj-type and
     2568                bf_wth-obj.obj-code = p-obj-code
     2569             by bf_wth-obj.wth-code
     2570       :
     2571         run wth-lib_full-inf-shift in this-procedure
     2572           (  input p-obj-type
     2573           ,  input p-obj-code
     2574           ,  input bf_wth-obj.wth-code
     2575           ,  input p-shift-date
     2576           ,  input p-shift-num
     2577           , output d_stock-start
     2578           , output d_stock-end
     2579           , output d_income
     2580           , output d_income-cassa
     2581           , output d_income-other
     2582           , output d_incass
     2583           , output d_incass-bank
     2584           , output d_incass-other
     2585           , output d_incass-cassa
     2586           ) no-error .
     2587         if error-status :error
     2588         then do:
     2589           undo, return error return-value .
     2590         end.
     2591         assign
     2592           p-rest-from   = p-rest-from   + d_stock-start
     2593           p-rest-till   = p-rest-till   + d_stock-end
     2594           p-incass-bank = p-incass-bank + d_income      - d_incass
     2595         .
     2596       end.
     2597     end.
     2598   end procedure.
     2599   procedure create-tt_line :
     2600     define  input parameter p-obj-type   as character no-undo .
     2601     define  input parameter p-obj-code   as integer   no-undo .
     2602     define  input parameter p-obj-name   as character no-undo .
     2603     define  input parameter p-cli-type   as character no-undo .
     2604     define  input parameter p-cli-code   as integer   no-undo .
     2605     define  input parameter p-cli-name   as character no-undo .
     2606     define  input parameter p-shift-date as date      no-undo .
     2607     define  input parameter p-shift-num  as integer   no-undo .
     2608     define output parameter p-rec-id     as recid     no-undo .
     2609     define variable v-shift-name     as character no-undo .
     2610     define variable v-shift-name-num as character no-undo .
     2611     do
     2612     on error undo, return error return-value
     2613     :
     2614       find first tt_line where
     2615                  tt_line.obj-type   = p-obj-type   and
     2616                  tt_line.obj-code   = p-obj-code   and
     2617                  tt_line.shift-date = p-shift-date and
     2618                  tt_line.shift-num  = p-shift-num  no-error .
     2619       if not available tt_line
     2620       then do:
     2621         assign
     2622           j_order = j_order + 10
     2623         .
     2624   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:   run str/lib-trn3.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn3) <> true) then do:     message       "Error starting lib-trn3.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn3 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn3_shiftnam in g#lib-trn3
     2625     (
     2626        input p-obj-type
     2627     ,  input p-obj-code
     2628     ,  input p-shift-date
     2629     ,  input p-shift-num
     2630     , output v-shift-name
     2631     , output v-shift-name-num
     2632     )        no-error .
     2633         if error-status :error
     2634         then do:
     2635           undo, return error return-value .
     2636         end.
     2637         create tt_line .
     2638         assign
     2639           tt_line.order      = j_order
     2640           tt_line.obj-type   = p-obj-type
     2641           tt_line.obj-code   = p-obj-code
     2642           tt_line.obj-name   = p-obj-name
     2643           tt_line.own-type   = p-cli-type
     2644           tt_line.own-code   = p-cli-code
     2645           tt_line.own-name   = p-cli-name
     2646           tt_line.shift-date = p-shift-date
     2647           tt_line.shift-num  = p-shift-num
     2648           tt_line.shift-name = v-shift-name
     2649           tt_line.shift-out  = "":U
     2650           tt_line.rest-from  = 0.00
     2651           tt_line.rest-till  = 0.00
     2652           tt_line.cash-sum   = 0.00
     2653           tt_line.incass-sum = 0.00
     2654           tt_line.is-total   = no
     2655         .
     2656         assign
     2657           tt_line.shift-out  = ShiftRight( substitute( '№ &1 от &2'
     2658                                                      , v-shift-name-num
     2659                                                      , string( p-shift-date, "99/99/9999":U )
     2660                                                      )
     2661                                                      , 22 ) + " ":U
     2662         .
     2663         run wealth-rest in this-procedure
     2664           (  input p-obj-type
     2665           ,  input p-obj-code
     2666           ,  input p-shift-date
     2667           ,  input p-shift-num
     2668           , output tt_line.rest-from
     2669           , output tt_line.rest-till
     2670           , output tt_line.incass-sum
     2671           ) no-error .
     2672         if error-status :error
     2673         then do:
     2674           undo, return error return-value .
     2675         end.
     2676       end.
     2677       assign
     2678         p-rec-id = recid( tt_line )
     2679       .
     2680     end.
     2681   end procedure.
