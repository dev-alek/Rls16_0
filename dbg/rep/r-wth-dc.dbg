     1248   define variable g#host-code   as integer no-undo .
     1249   define temp-table tt_line no-undo
     1250     field order      as integer
     1251     field obj-type   as character
     1252     field obj-code   as integer
     1253     field obj-name   as character
     1254     field own-type   as character
     1255     field own-code   as integer
     1256     field own-name   as character
     1257     field shift-date as date
     1258     field shift-num  as integer
     1259     field shift-name as character
     1260     field shift-out  as character
     1261     field rest-from  as decimal   decimals 2 format "->,>>>,>>>,>>>,>>9.99":U
     1262     field rest-till  as decimal   decimals 2 format "->,>>>,>>>,>>>,>>9.99":U
     1263     field cash-sum   as decimal   decimals 2 format "->,>>>,>>>,>>>,>>9.99":U
     1264     field incass-sum as decimal   decimals 2 format "->,>>>,>>>,>>>,>>9.99":U
     1265     field is-total   as logical
     1266     index tt-pui     is primary   unique order
     1267     index tt-ui1     is           unique obj-type   obj-code   shift-date shift-num
     1268     index tt-ui2     is           unique shift-date shift-num  obj-type   obj-code
     1269     index i1                             is-total   obj-type   obj-code   shift-date shift-num order
     1270     index i2                             is-total   shift-date shift-num  obj-type   obj-code  order
     1271   .
     1272   define buffer bf_line for tt_line .
     1273   define stream text_out .
     1274   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   define   stream text_out.
     1276   procedure prn-lib-prn-file :
     1277     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1278     define input parameter p-DIsabledoptions as integer no-undo .
     1279     define variable v-report-name as character no-undo .
     1280     define variable v-user-action as character no-undo .
     1281     define variable v-printed     as logical   no-undo .
     1282     define variable v-exist       as logical   no-undo .
     1283     do
     1284       on error undo, return error
     1285       :
     1286       run prn-lib-get-report-name  in this-procedure (
     1287         input parParentProc
     1288         ,output v-report-name
     1289         ).
     1290   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1291   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1292     (input  v-report-name
     1293     ,input  2
     1294     ,output v-exist
     1295     )  .
     1296       if NOT v-exist then
     1297       DO:
     1298         Message
     1299           "Нет заданий на печать ! "
     1300           view-as alert-box .
     1301         Return  .
     1302       End.
     1303       run gbl/prnfilen.w
     1304         (input  ""
     1305         ,input  p-DisabledOptions
     1306         ,input  string(v-report-name )
     1307         ,input  7
     1308         ,output v-user-action
     1309         ,output v-printed
     1310         ) .
     1311       if v-printed then
     1312       do:
     1313         return "YES" .
     1314       end.
     1315       else
     1316       do:
     1317         return "NO" .
     1318       end.
     1319     end.
     1320   end procedure.
     1321   procedure prn-lib-open-stream :
     1322     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1323     define input parameter p-page-size    as integer no-undo .
     1324     define input parameter p-is-stream    as logical no-undo .
     1325     define input parameter p-append       as logical no-undo .
     1326     define variable v-report-name as character no-undo .
     1327     do
     1328       on error undo, return error
     1329       :
     1330       run prn-lib-get-report-name  in this-procedure (
     1331         input parParentProc
     1332         ,output v-report-name
     1333         ).
     1334       if p-is-stream then
     1335       do:
     1336         if p-append then
     1337         do:
     1338           output stream text_out to value( v-report-name )
     1339             page-size value(p-page-size) append .
     1340         end.
     1341         if not p-append then
     1342         do:
     1343           output stream text_out to value( v-report-name )
     1344             page-size value(p-page-size) .
     1345         end.
     1346       end.
     1347       if not p-is-stream then
     1348       do:
     1349         if p-append then
     1350         do:
     1351           output to value( v-report-name )
     1352             page-size value(p-page-size) append .
     1353         end.
     1354         if not p-append then
     1355         do:
     1356           output to value( v-report-name )
     1357             page-size value(p-page-size) .
     1358         end.
     1359       end.
     1360     end.
     1361   end procedure.
     1362   procedure prn-lib-open-exp :
     1363     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1364     define input parameter p-is-stream    as logical no-undo .
     1365     define input parameter p-is-append    as logical no-undo .
     1366     define output parameter p-ReportFileName as char init "report" no-undo.
     1367     define output parameter p-process as logical no-undo .
     1368     define variable glog as logical no-undo .
     1369     do
     1370       on error undo, return error
     1371       :
     1372       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1373         TITLE      "Укажите путь"
     1374         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1375         ASK-OVERWRITE
     1376         CREATE-TEST-FILE
     1377         SAVE-AS
     1378         USE-FILENAME
     1379         DEFAULT-EXTENSION "txt"
     1380         UPDATE glog
     1381         .
     1382       if not glog then  return.
     1383       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1384       if p-is-stream then
     1385       do:
     1386         if p-is-append then
     1387         do:
     1388           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1389         end.
     1390         else
     1391         do:
     1392           OUTPUT stream text_out TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1393         end.
     1394       end.
     1395       else
     1396       do:
     1397         if p-is-append then
     1398         do:
     1399           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1400         end.
     1401         else
     1402         do:
     1403           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1404         end.
     1405       end.
     1406       p-process = yes.
     1407     end.
     1408   end procedure.
     1409   procedure prn-lib-get-report-name :
     1410     define input parameter parParentProc  as widget-handle no-undo.
     1411     define output parameter p-report-name as character no-undo .
     1412     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1413   end procedure.
     1414   procedure prn-lib-reportviewer-report-name :
     1415     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1416     define input parameter p-report-name-html as character no-undo .
     1417     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1418   end procedure.
     1419   procedure prn-lib-reportviewer :
     1420     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1421     define input parameter p-report-name-html as character no-undo .
     1422     define input parameter p-param        as character no-undo .
     1423     define variable v-excel           as character no-undo init 'TRUE' .
     1424     define variable v-value-character as character no-undo .
     1425     define variable v-value-integer   as character no-undo .
     1426     define variable v-value-date      as date      no-undo .
     1427     define variable v-value-decimal   as decimal   no-undo .
     1428     define variable rep-excel         as logical   no-undo .
     1429     define variable excel-string      as character no-undo .
     1430     define variable v-param-type      as character no-undo .
     1431     define variable v-tth             as handle    no-undo .
     1432     run adm/shattri.p (
     1433       input "get":U
     1434       ,input  ""
     1435       ,input  0
     1436       ,input  'report-glob':U
     1437       ,input  'rep-excel':U
     1438       ,output v-value-character
     1439       ,output v-value-date
     1440       ,output v-value-decimal
     1441       ,output v-value-integer
     1442       ,output rep-excel
     1443       ,output v-param-type
     1444       ,INPUT-OUTPUT table-handle v-tth
     1445       )  .
     1446     if rep-excel then v-excel = "TRUE" .
     1447     else v-excel = "FALSE" .
     1448     if p-param eq ""
     1449     then
     1450        p-param = "EXCEL:" + v-excel.
     1451     else
     1452        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1453     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1454   end procedure.
     1455   form header
     1456     v-report-name                                                             format "x(136)":U at 1
     1457     v-report-subname                                                          format "x(136)":U at 1
     1458     v-firm-name                                                               format "x(136)":U at 1 skip( 0 )
     1459     substitute( '&1 &2 "&3".'
     1460               , v-object-type
     1461               , v-object-code
     1462               , v-object-name
     1463               )                                                              format "x(136)":U at 1 skip( 1 )
     1464     ShiftRight( substitute( "Дата печати: &1, время: &2.   Страница: &3."
     1465                           , string( t_today,                 "99.99.9999":U )
     1466                           , string( j_time,                  "HH:MM:SS":U   )
     1467                           , string( page-number( text_out ), ">>9":U        )
     1468                           )                                , 113 ) format "x(136)":U at 1 skip( 0 )
     1469     "-----------------------------------------------------------------------------------------------------------------" skip( 0 )                                                                                                       skip( 0 )                                                         "|                       :  Остаток на начало  :                     : Инкассировано в банк:   Остаток на конец  |" skip( 0 )                     "|     № и дата смены    :   периода (на АЗК)  :   Выручка за смену  :      (за смену)     :   периода (на АЗК)  |" skip( 0 )                     "|-----------------------:---------------------:---------------------:---------------------:---------------------|" skip( 0 )                                                                                                    skip( 0 )
     1470   with frame Top_Page width 136 page-top no-labels no-box use-text stream-io no-underline .
     1471   form header                                    skip( 1 )
     1472     Under_Line format "x(136)":U at  1 skip( 0 )
     1473     "Продолжение на следующей странице"    at 30 skip( 0 )
     1474   with frame Bottom_Page width 136 page-bottom no-labels no-box use-text stream-io no-underline .
     1475   do
     1476   on error undo, return error return-value
     1477   :
     1478     run WaitFram-Show   in this-procedure
     1479       ( input 'Подождите ...'
     1480       ) .
     1481     run get-report-num  in parparentproc
     1482       (
     1483         output g#report-num
     1484       ) .
     1485     run get-quest-print in parparentproc
     1486       (
     1487         output g#quest-print
     1488       ) .
     1489   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1490     run mainmenu_getcntxt in parparentproc
     1491       (output v-cntxt-db-num
     1492       ,output v-cntxt-userid
     1493       ,output v-cntxt-level
     1494       ,output v-cntxt-host-code-obj
     1495       ,output v-cntxt-obj-type
     1496       ,output v-cntxt-obj-code
     1497       ,output v-cntxt-db-num-obj
     1498       ,output v-cntxt-is-admin
     1499       ) .
     1500     assign
     1501       g#host-code = v-cntxt-host-code-obj
     1502     .
     1503   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1504   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1505   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1506   define variable par-type          as character no-undo.
     1507   define variable v-value-character as character no-undo .
     1508   define variable v-value-date      as date      no-undo .
     1509   define variable v-value-decimal   as decimal   no-undo .
     1510   define variable v-value-integer   as integer   no-undo .
     1511   define variable v-value-logical   as logical   no-undo .
     1512   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1513   empty temp-table thbjattr_thbj-attr.
     1514   run adm/shattri.p (
     1515      input "get":U
     1516     ,input v-cntxt-obj-type
     1517     ,input v-cntxt-obj-code
     1518     ,input 'report-firm':U
     1519     ,input  ""
     1520     ,output v-value-character
     1521     ,output v-value-date
     1522     ,output v-value-decimal
     1523     ,output v-value-integer
     1524     ,output v-value-logical
     1525     ,output par-type
     1526     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1527     ) no-error .
     1528     for each thbjattr_thbj-attr :
     1529         if thbjattr_thbj-attr.prop-code = 'XL-delim'  then v_temp-param   = thbjattr_thbj-attr.property-value-character.
     1530     end.
     1531     IF v_temp-param = "" then XL-delim = ";".
     1532     else XL-delim = v_temp-param.
     1533     run gbl/getlocal.p
     1534       ( output v-del-0
     1535       , output v-del-1
     1536       , output v-del-2
     1537       , output v-short-date
     1538       ) no-error .
     1539     if error-status :error
     1540     then do:
     1541       assign
     1542         v-del-1 = " ":U
     1543       .
     1544     end.
     1545     case x-radio-task :
     1546       when 1
     1547       then do:
     1548         assign
     1549           v-temp = "период с " + string( x-date-start ) + " по " + string( x-date-end )
     1550         .
     1551       end.
     1552       when 2
     1553       then do:
     1554         assign
     1555           v-temp = "сменные сутки c " + string( x-date-start ) + " по " + string( x-date-end )
     1556         .
     1557       end.
     1558       when 3
     1559       then do:
     1560         assign
     1561           v-temp = "сменные сутки и порядок смен с "
     1562                   + string( x-shift-start ) + " ":U + string( x-date-start ) + " по "
     1563                   + string( x-shift-end   ) + " ":U + string( x-date-end   )
     1564         .
     1565       end.
     1566       when 4
     1567       then do:
     1568         assign
     1569           v-temp = "смену " + string( x-shift-alone ) + " с "
     1570                             + string( x-date-start  ) + " по " + string( x-date-end )
     1571         .
     1572       end.
     1573     end case.
     1574     run cur-time in this-procedure
     1575       ( output t_today
     1576       , output j_time
     1577       ) .
     1578     assign
     1579       Under_Line = fill( '-', 113 )
     1580     .
     1581     for each obj-list no-lock
     1582     :
     1583       find first bf_object no-lock where
     1584                  bf_object.obj-type = obj-list.obj-type and
     1585                  bf_object.obj-code = obj-list.obj-code .
     1586       find first bf_clients no-lock where
     1587                  bf_clients.obj-type = 'орг':U              and
     1588                  bf_clients.obj-code = bf_object.host-code .
     1589       find first bf_sysconf no-lock where
     1590                  bf_sysconf.host-code = bf_clients.obj-code .
     1591       if lookup( bf_object.obj-name, v-obj-name, chr(44) ) = 0
     1592       then do:
     1593         assign
     1594           v-obj-name = v-obj-name
     1595                      + ( if v-obj-name = "":U then "":U else chr(44) )
     1596                      + bf_object.obj-name
     1597         .
     1598       end.
     1599       if lookup( bf_clients.obj-name, v-own-name, chr(44) ) = 0
     1600       then do:
     1601         assign
     1602           v-own-name = v-own-name
     1603                      + ( if v-own-name = "":U then "":U else chr(44) )
     1604                      + bf_clients.obj-name
     1605         .
     1606       end.
     1607       case x-radio-task :
     1608         when 1
     1609         then do:
     1610           for each bf_wth-doc no-lock where
     1611                    bf_wth-doc.obj-type   = obj-list.obj-type and
     1612                    bf_wth-doc.obj-code   = obj-list.obj-code and
     1613                    bf_wth-doc.fact-date >= x-date-start      and
     1614                    bf_wth-doc.fact-date <= x-date-end        and
     1615                    bf_wth-doc.status_    = 'факт':U           and
     1616                    bf_wth-doc.borned     = no
     1617             , each bf_wth-line no-lock where
     1618                    bf_wth-line.doc-code  = bf_wth-doc.doc-code
     1619           break by bf_wth-doc.shift-date
     1620                 by bf_wth-doc.shift-num
     1621                 by bf_wth-line.wth-code
     1622           :
     1623   if first-of( bf_wth-line.wth-code )
     1624   then do:
     1625     assign
     1626       fact-order_from = bf_wth-doc.fact-order
     1627     .
     1628     find first tt_line where
     1629                tt_line.obj-type   = bf_object.obj-type    and
     1630                tt_line.obj-code   = bf_object.obj-code    and
     1631                tt_line.shift-date = bf_wth-doc.shift-date and
     1632                tt_line.shift-num  = bf_wth-doc.shift-num  no-error .
     1633     if not available tt_line
     1634     then do:
     1635       run create-tt_line in this-procedure
     1636         (  input bf_object.obj-type
     1637         ,  input bf_object.obj-code
     1638         ,  input bf_object.obj-name
     1639         ,  input bf_clients.obj-type
     1640         ,  input bf_clients.obj-code
     1641         ,  input bf_clients.obj-name
     1642         ,  input bf_wth-doc.shift-date
     1643         ,  input bf_wth-doc.shift-num
     1644         , output r-rec-line
     1645         ) no-error .
     1646       if error-status :error or
     1647          r-rec-line = ?
     1648       then do:
     1649         undo, return error return-value .
     1650       end.
     1651       find first tt_line where
     1652           recid( tt_line ) = r-rec-line .
     1653     end.
     1654   end.
     1655   if bf_wth-doc.cli-type = bf_sysconf.sale-type and
     1656      bf_wth-doc.cli-code = bf_sysconf.sale-code and
     1657    ( bf_wth-doc.doc-type = 'при':U            or
     1658      bf_wth-doc.doc-type = 'рас':U         ) and
     1659      bf_wth-doc.inter_   = no
     1660   then do:
     1661     find first tt_line where
     1662                tt_line.obj-type   = bf_object.obj-type    and
     1663                tt_line.obj-code   = bf_object.obj-code    and
     1664                tt_line.shift-date = bf_wth-doc.shift-date and
     1665                tt_line.shift-num  = bf_wth-doc.shift-num  no-error .
     1666     if not available tt_line
     1667     then do:
     1668       run create-tt_line in this-procedure
     1669         (  input bf_object.obj-type
     1670         ,  input bf_object.obj-code
     1671         ,  input bf_object.obj-name
     1672         ,  input bf_clients.obj-type
     1673         ,  input bf_clients.obj-code
     1674         ,  input bf_clients.obj-name
     1675         ,  input bf_wth-doc.shift-date
     1676         ,  input bf_wth-doc.shift-num
     1677         , output r-rec-line
     1678         ) no-error .
     1679       if error-status :error or
     1680          r-rec-line = ?
     1681       then do:
     1682         undo, return error return-value .
     1683       end.
     1684       find first tt_line where
     1685           recid( tt_line ) = r-rec-line .
     1686     end.
     1687     case bf_wth-doc.doc-type :
     1688       when 'при':U
     1689       then do:
     1690         assign
     1691           tt_line.cash-sum = tt_line.cash-sum + bf_wth-line.fact-sum
     1692         .
     1693       end.
     1694       when 'рас':U
     1695       then do:
     1696         assign
     1697           tt_line.cash-sum = tt_line.cash-sum - bf_wth-line.fact-sum
     1698         .
     1699       end.
     1700     end case.
     1701   end.
     1702   if last-of( bf_wth-line.wth-code )
     1703   then do:
     1704     assign
     1705       fact-order_till = bf_wth-doc.fact-order
     1706     .
     1707     find first tt_line where
     1708                tt_line.obj-type   = bf_object.obj-type    and
