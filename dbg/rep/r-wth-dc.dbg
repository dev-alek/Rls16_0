      146   FUNCTION get-curr RETURNS CHARACTER
      147     (buffer loc-wealth for ub.wealth ) :
      148   define buffer buf_currency for ub.currency.
      149   if loc-wealth.curr-code = ? or loc-wealth.is-money = no then
      150   return loc-wealth.unit-base.
      151   FIND FIRST buf_currency no-lock where
      152             buf_currency.curr-code = loc-wealth.curr-code No-ERROR.
      153   if avail buf_currency then
      154     RETURN buf_currency.curr-abbr.
      155   else return "".
      156   END FUNCTION.
