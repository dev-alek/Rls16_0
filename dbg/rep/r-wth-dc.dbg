     1219   define variable j_time     as integer   no-undo .
     1220   define variable j_order    as integer   no-undo initial 0 .
     1221   define variable v-del-0    as character no-undo .
     1222   define variable v-del-1    as character no-undo .
     1223   define variable v-del-2    as character no-undo .
     1224   define variable r-rec-line as recid     no-undo .
     1225   define variable v-firm-name      as character no-undo .
     1226   define variable v-object-name    as character no-undo .
     1227   define variable v-object-type    as character no-undo .
     1228   define variable v-object-code    as integer   no-undo .
     1229   define variable fact-order_from  as decimal   no-undo .
     1230   define variable fact-order_till  as decimal   no-undo .
     1231   define variable j_line-counter   as integer   no-undo .
     1232   define variable j_order-max      as integer   no-undo .
     1233   define variable v-short-date     as character no-undo .
     1234   define variable XLS-page-num     as integer   no-undo .
     1235   define variable v-temp-string    as character no-undo .
     1236   define variable v_temp-param     as character no-undo .
     1237   define variable v_data-type      as character no-undo .
     1238   define variable XL-delim         as character no-undo .
     1239   define variable v-report-name    as character no-undo .
     1240   define variable v-report-subname as character no-undo .
