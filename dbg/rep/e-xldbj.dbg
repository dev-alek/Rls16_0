      611     (
      612      input  loc-dis-card.type
      613     ,input  loC-dis-card.emitent-host-code
      614     ,input  parhost-code
      615     ,input  ''
      616     ,input  0
      617     ,input  p-discnt-role
      618     ,output loc-d-v
      619     ) no-error .
      620       end.
      621       if loc-d-v = ? then do:
      622         case p-discnt-role:
      623           when 'def-categ':U then do:
      624             loc-d-v = loc-dis-card.category.
      625           end.
      626           when 'def-pcnt':U then do:
      627             loc-d-v = loc-dis-card.d-pcnt.
      628           end.
      629           when 'def-cash-pcnt':U then do:
      630             loc-d-v = loc-dis-card.cash-d-pcnt.
      631           end.
      632         end case.
      633       end.
      634       if p-discnt-role = 'def-categ':U then do:
      635         return substitute("(i) &1", string(loc-d-v, ">>>9")).
      636       end.
      637       else do:
      638         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
      639       end.
      640     end.
      641   end.
      642   else do:
      643    return "ОШИБКА-НЕТ ТИПА".
      644   end.
      645   case p-discnt-role:
      646     when 'def-categ':U then do:
      647        loc-d-v = loc-dis-card.category.
      648        return string(loc-d-v, ">>>9").
      649     end.
      650     when 'def-pcnt':U then do:
      651       loc-d-v = loc-dis-card.d-pcnt.
      652       return string(loc-d-v, "->9.99%").
      653     end.
      654     when 'def-cash-pcnt':U then do:
      655       loc-d-v = loc-dis-card.cash-d-pcnt.
      656       return string(loc-d-v, "->9.99%").
      657     end.
      658   end case.
      659   END FUNCTION.
      660   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      661   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   FUNCTION get-d-pcnt RETURNS CHARACTER
      663     ( buffer loc-dis-card for ub.dis-card,
      664       input parhost-code as integer,
      665       input parobj-type as character,
      666       input parobj-code as integer,
      667       input p-discnt-role as character,
      668       output loc-d-v as decimal) :
      669   define variable v-node-code as integer no-undo .
      670   define buffer buf_dis-card-type for ub.dis-card-type.
      671   define buffer buf_dis-card-property for ub.dis-card-property.
      672   find first buf_dis-card-type no-lock where
      673             buf_dis-card-type.type = loc-dis-card.type
      674         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
      675         and buf_dis-card-type.host-code = 0
      676         and buf_dis-card-type.obj-type = '':U
      677         and buf_dis-card-type.obj-code = 0 no-error.
      678   if available buf_dis-card-type then do:
      679     case p-discnt-role:
      680       when 'def-pcnt':U  then do:
      681         assign
      682         v-node-code = 1.
      683       end.
      684       when 'def-cash-pcnt':U then do:
      685         assign
      686         v-node-code = 2.
      687       end.
      688       when 'def-categ':U then do:
      689         assign
      690         v-node-code = 3.
      691       end.
      692     end.
      693     if buf_dis-card-type.d-pcnt-byshop then do:
      694      find first buf_dis-card-property no-lock where
      695                buf_dis-card-property.d-card = loc-dis-card.d-card
      696            and buf_dis-card-property.dtm-code = 26
      697            and buf_dis-card-property.host-code = parhost-code
      698            and buf_dis-card-property.obj-type = parobj-type
      699            and buf_dis-card-property.obj-code = parobj-code
      700            and buf_dis-card-property.node-code = v-node-code no-error.
      701      if available buf_dis-card-property then do:
      702        if p-discnt-role = 'def-categ':U then do:
      703          assign
      704          loc-d-v = buf_dis-card-property.property-value-integer.
      705        end.
      706        else do:
      707          assign
      708          loc-d-v = buf_dis-card-property.property-value-decimal.
      709        end.
      710      end.
      711       if loc-d-v = ? then do:
      712   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      713   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      714     (
      715      input  loc-dis-card.type
      716     ,input  loC-dis-card.emitent-host-code
      717     ,input  parhost-code
      718     ,input  parobj-type
      719     ,input  parobj-code
      720     ,input  p-discnt-role
      721     ,output loc-d-v
      722     ) no-error .
      723       end.
      724       if loc-d-v = ? then do:
      725         find first buf_dis-card-property no-lock where
      726                   buf_dis-card-property.d-card = loc-dis-card.d-card
      727               and buf_dis-card-property.dtm-code = 26
      728               and buf_dis-card-property.host-code = parhost-code
      729               and buf_dis-card-property.obj-type = ''
      730               and buf_dis-card-property.obj-code = 0
      731               and buf_dis-card-property.node-code = v-node-code no-error.
      732         if available buf_dis-card-property then do:
      733           if p-discnt-role = 'def-categ':U then do:
      734             assign
      735             loc-d-v = buf_dis-card-property.property-value-integer.
      736           end.
      737           else do:
      738             assign
      739             loc-d-v = buf_dis-card-property.property-value-decimal.
      740           end.
      741         end.
      742       end.
      743       if loc-d-v = ? then do:
      744   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      745   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      746     (
      747      input  loc-dis-card.type
      748     ,input  loC-dis-card.emitent-host-code
      749     ,input  parhost-code
      750     ,input  ''
      751     ,input  0
      752     ,input  p-discnt-role
      753     ,output loc-d-v
      754     ) no-error .
      755       end.
      756       if loc-d-v = ? then do:
      757         case p-discnt-role:
      758           when 'def-categ':U then do:
      759             loc-d-v = loc-dis-card.category.
      760           end.
      761           when 'def-pcnt':U then do:
      762             loc-d-v = loc-dis-card.d-pcnt.
      763           end.
      764           when 'def-cash-pcnt':U then do:
      765             loc-d-v = loc-dis-card.cash-d-pcnt.
      766           end.
      767         end case.
      768       end.
      769       if p-discnt-role = 'def-categ':U then do:
      770         return substitute("(i) &1", string(loc-d-v, ">>>9")).
      771       end.
      772       else do:
      773         return substitute("(i) &1", string(loc-d-v, "->9.99%")).
      774       end.
      775     end.
      776   end.
      777   else do:
      778    return "ОШИБКА-НЕТ ТИПА".
      779   end.
      780   case p-discnt-role:
      781     when 'def-categ':U then do:
      782        loc-d-v = loc-dis-card.category.
      783        return string(loc-d-v, ">>>9").
      784     end.
      785     when 'def-pcnt':U then do:
      786       loc-d-v = loc-dis-card.d-pcnt.
      787       return string(loc-d-v, "->9.99%").
      788     end.
      789     when 'def-cash-pcnt':U then do:
      790       loc-d-v = loc-dis-card.cash-d-pcnt.
      791       return string(loc-d-v, "->9.99%").
      792     end.
      793   end case.
      794   END FUNCTION.
      795   define variable new-card as logical no-undo.
      796   DEFINE VARIABLE vwait as character no-undo .
      797   DEFINE VARIABLE vproc-arch-disc-cards as character no-undo .
      798   DEFINE VARIABLE loc-d-pcnt like ub.dis-card.d-pcnt no-undo .
      799   define buffer card-clients for ub.clients.
      800   define buffer bsj-groups for sj-groups.
      801   define buffer bsj-cards for sj-cards.
      802   define buffer buf_dis-card for ub.dis-card.
      803   define buffer osn_dis-card for ub.dis-card.
      804   define buffer cli-obj for ub.clients.
      805   define variable v-count as integer   no-undo .
      806   run waitfram-show in this-procedure  ( input "Ждите... Обработано архивов по ДК").
      807   define temp-table temp-dis-card no-undo like ub.dis-card.
      808   create bsj-cards.
      809   assign
      810   bsj-cards.d-card = ?
      811   .
      812   create temp-dis-card.
      813   FOR EACH obj-list no-lock ,
      814       FIRST cli-obj no-lock where
      815            cli-obj.obj-type = obj-list.obj-type
      816       AND  cli-obj.obj-code = obj-list.obj-code:
      817     case dcardmode:
      818       when "LIST"
      819       or
      820       when "ONE" then do:
      821         FOR EACH dc-list no-lock,
      822            first ub.dis-obj no-lock WHERE
      823               ub.dis-obj.dt-code = 0
      824           and ub.dis-obj.d-card = dc-list.d-card
      825           and ub.dis-obj.obj-type = obj-list.obj-type
      826           AND ub.dis-obj.obj-code = obj-list.obj-code,
      827            FIRST card-clients NO-LOCK WHERE
      828                 card-clients.obj-type = dc-list.cli-type
      829             AND card-clients.obj-code = dc-list.cli-code:
      830           if p-group-mode =  "ONE":U
      831           and  card-clients.grp-code <> current-gcode then next.
      832           PROCESS EVENTS .
      833           dis-obj-found = yes.
      834           buffer-copy dc-list to temp-dis-card.
      835           run process-dis-obj in this-procedure .
      836         end.
      837       end.
      838       otherwise do:
      839         FOR EACH ub.dis-obj no-lock WHERE
      840               ub.dis-obj.dt-code = 0
      841           and obj-list.obj-type = ub.dis-obj.obj-type
      842           AND obj-list.obj-code = ub.dis-obj.obj-code
      843           AND ub.dis-obj.host-code = cli-obj.host-code,
      844           FIRST ub.dis-card No-LOCK WHERE
      845               ub.dis-card.d-card = ub.dis-obj.d-card,
      846          FIRST card-clients NO-LOCK WHERE
      847               card-clients.obj-type = ub.dis-card.cli-type
      848           AND card-clients.obj-code = ub.dis-card.cli-code:
      849           if p-group-mode =  "ONE":U
      850           and  card-clients.grp-code <> current-gcode then next.
      851           PROCESS EVENTS .
      852           dis-obj-found = yes.
      853           buffer-copy dis-card to temp-dis-card.
      854           run process-dis-obj in this-procedure .
      855         end.
      856       end.
      857     end case.
      858   end.
      859   run waitfram-hide in this-procedure  .
      860   procedure process-dis-obj :
      861   do
      862   on error undo, return error return-value
      863   :
      864       v-count = v-count + 1.
      865       if v-count modulo 10  = 0
      866       AND v-count  >= 10 then do:
      867         run waitfram-show in this-procedure ( input substitute("&1&2 Обработано архивов по ДК: &3"
      868                                                               ,obj-list.obj-type
      869                                                               ,obj-list.obj-code
      870                                                               ,v-count )
      871                                              ).
      872       end.
      873       assign
      874       new-card = no.
      875       if p-sort-mode = "group":U then do:
      876         FIND  FIRST  bsj-groups WHERE
      877                       bsj-groups.g-code = card-clients.grp-code AND
      878                       bsj-groups.obj-code = 0
      879                       NO-ERROR.
      880         if p-group-mode = "LIST":U then do:
      881           if NOT avail bsj-groups then do:
      882               NEXT.
      883           end.
      884         end.
      885         IF NOT AVAIL bsj-groups then do:
      886           FIND FIRST ub.cli-grp No-LOCK WHERE
      887                     ub.cli-grp.node-code = card-clients.grp-code NO-ERROR.
      888           create bsj-groups.
      889           assign
      890           bsj-groups.g-code = card-clients.grp-code
      891           bsj-groups.g-name = (if avail ub.cli-grp then ub.cli-grp.node-name else "")
      892           bsj-groups.obj-code = 0
      893           .
      894         end.
      895         FIND FIRST sj-groups WHERE
      896                   sj-groups.g-code = card-clients.grp-code AND
      897                   sj-groups.obj-code = ub.dis-obj.obj-code No-ERROR.
      898         IF NOT AVAIL sj-groups then do:
      899           FIND FIRST ub.cli-grp No-LOCK WHERE
      900                     ub.cli-grp.node-code = card-clients.grp-code NO-ERROR.
      901           create sj-groups.
      902           assign
      903           sj-groups.g-code = card-clients.grp-code
      904           sj-groups.g-name = (if avail cli-grp then cli-grp.node-name else "")
      905           sj-groups.obj-code = dis-obj.obj-code
      906           .
      907         end.
      908       end.
      909       FIND FIRST sj-cards No-LOCK WHERE
      910                  sj-cards.d-card = dis-obj.d-card NO-ERROR.
      911       IF NOT AVAIL sj-cards then do:
      912         FIND FIRST ub.dis-host No-LOCK WHERE
      913                    ub.dis-host.d-card = ub.dis-obj.d-card
      914                AND ub.dis-host.host-code = p-host-code
      915                and ub.dis-host.dt-code = 0  No-ERROR.
      916         create
      917         sj-cards.
      918         assign
      919         new-card = yes
      920         sj-cards.d-card = ub.dis-obj.d-card
      921         sj-cards.g-code = card-clients.grp-code
      922         sj-cards.global-card = (temp-dis-card.emitent-host-code = 0)
      923         sj-cards.credit-card = temp-dis-card.credit-card
      924         sj-cards.cli-type = temp-dis-card.cli-type
      925         sj-cards.cli-code = temp-dis-card.cli-code
      926         sj-cards.cli-name =  card-clients.obj-name
      927         sj-cards.d-pcnt = temp-dis-card.d-pcnt
      928         sj-cards.saldo = (if p-curr-type = 'rubl':U
      929                           then temp-dis-card.saldo-rubl
      930                           else temp-dis-card.saldo-base
      931                           )
      932         sj-cards.must-pay = if sj-cards.saldo < 0 then (- sj-cards.saldo) else 0
      933         sj-cards.pay = (if avail dis-host
      934                         then (if p-curr-type = 'rubl':U
      935                               then dis-host.pay-tot-rubl
      936                               else dis-host.pay-tot-base )
      937                         else 0)
      938         sj-cards.obj-qnty = 0
      939         sj-cards.first-main-card = dis-obj.first-main-card
      940         sj-cards.main-card = dis-obj.main-card
      941         sj-cards.first-card = dis-obj.first-card
      942         sj-cards.card-num-chr = (if t-legacy or t-subsid
      943                                  then (if t-legacy
      944                                        and t-subsid
      945                                        then dis-obj.first-main-card
      946                                        else (if t-legacy
      947                                              then dis-obj.first-card
      948                                              else dis-obj.main-card)
      949                                        )
      950                                  else  dis-obj.d-card)
      951         bsj-cards.saldo = bsj-cards.saldo +
      952                           (if p-curr-type = 'rubl':U
      953                            then temp-dis-card.saldo-rubl
      954                            else temp-dis-card.saldo-base
      955                           )
      956         bsj-cards.must-pay = bsj-cards.must-pay + (if sj-cards.saldo < 0 then (- sj-cards.saldo) else 0)
      957         bsj-cards.pay = bsj-cards.pay + (if avail dis-host
      958                                          then (if p-curr-type = 'rubl':U
      959                                                then dis-host.pay-tot-rubl
      960                                                else dis-host.pay-tot-base)
      961                                          else 0)
      962         bsj-cards.obj-qnty = bsj-cards.obj-qnty + 1
      963         .
      964         if dcardmode = "LIST"
      965         or dcardmode = "ONE" then do:
      966           assign
      967           sj-cards.d-pcntchr = get-d-pcntdc-list ( buffer dc-list
      968                                         ,input p-host-code
      969                                         ,input obj-list.obj-type
      970                                         ,input obj-list.obj-code
      971                                         ,input 'def-pcnt':U
      972                                         ,output loc-d-pcnt).
      973         end.
      974         else do:
      975           assign
      976           sj-cards.d-pcntchr = get-d-pcnt ( buffer ub.dis-card
      977                                         ,input p-host-code
      978                                         ,input obj-list.obj-type
      979                                         ,input obj-list.obj-code
      980                                         ,input 'def-pcnt':U
      981                                         ,output loc-d-pcnt).
      982         end.
      983       end.
      984       if p-curr-type = 'rubl':U then do:
      985         assign
      986         sj-cards.tot = sj-cards.tot + dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl
      987         sj-cards.disc = sj-cards.disc + dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl
      988         sj-cards.netto = sj-cards.netto + (dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl) -
      989                                           (dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl)
      990         sj-cards.instant-pay = sj-cards.instant-pay + dis-obj.pay-tot-rubl
      991         sj-cards.credit-pay = sj-cards.credit-pay + (dis-obj.gds-tot-rubl + dis-obj.sum-tot-rubl) -
      992                                                     (dis-obj.gds-dis-rubl +  dis-obj.sum-dis-rubl) -
      993                                                     dis-obj.pay-tot-rubl
      994         sj-cards.num-chk = sj-cards.num-chk + dis-obj.num-chk
      995         sj-cards.obj-qnty = if sj-cards.obj-qnty = 0
      996                             then dis-obj.obj-code
      997                             else (- 1)
      998         .
      999       end.
     1000       else do:
     1001         assign
     1002         sj-cards.tot = sj-cards.tot + dis-obj.gds-tot-base + dis-obj.sum-tot-base
     1003         sj-cards.disc = sj-cards.disc + dis-obj.gds-dis-base +  dis-obj.sum-dis-base
     1004         sj-cards.netto = sj-cards.netto + (dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     1005                                           (dis-obj.gds-dis-base +  dis-obj.sum-dis-base)
     1006         sj-cards.instant-pay = sj-cards.instant-pay + dis-obj.pay-tot-base
     1007         sj-cards.credit-pay = sj-cards.credit-pay + (dis-obj.gds-tot-base + dis-obj.sum-tot-base) -
     1008                                                     (dis-obj.gds-dis-base +  dis-obj.sum-dis-base) -
     1009                                                     dis-obj.pay-tot-base
     1010         sj-cards.num-chk = sj-cards.num-chk + dis-obj.num-chk
     1011         sj-cards.obj-qnty = if sj-cards.obj-qnty = 0
     1012                             then dis-obj.obj-code
     1013                             else (- 1)
     1014         .
     1015       end.
     1016       if (t-legacy or t-subsid)
     1017       then do:
     1018         if t-legacy and not t-subsid then do:
     1019           find first legacy-obj no-lock where
     1020                     legacy-obj.obj-type = dis-obj.obj-type
     1021                 AND legacy-obj.obj-code = dis-obj.obj-code
     1022             AND legacy-obj.card-num-chr = temp-dis-card.first-card
     1023             no-error .
     1024           if not available legacy-obj then do:
     1025             create legacy-obj.
     1026             assign
     1027             legacy-obj.obj-type = dis-obj.obj-type
     1028             legacy-obj.obj-code = dis-obj.obj-code
     1029             legacy-obj.card-num-chr = temp-dis-card.first-card
     1030             legacy-obj.first-card = temp-dis-card.first-card
     1031             legacy-obj.first-main-card = temp-dis-card.first-main-card
     1032             legacy-obj.main-card = temp-dis-card.main-card
     1033             .
     1034             find last osn_dis-card no-lock where
     1035             osn_dis-card.first-card = legacy-obj.first-card use-index isourced no-error.
     1036             if not available osn_dis-card then do:
     1037               message
     1038               substitute("Не найдена текущая карта цепочки карт с ПЕРВОЙ КАРТОЙ = &1 для карты &2"
     1039                          ,legacy-obj.first-card
     1040                          ,dis-obj.d-card
     1041                          )
     1042               view-as alert-box .
     1043               assign
     1044               legacy-obj.d-card = dis-obj.d-card
     1045               legacy-obj.d-pcnt = 0
     1046               legacy-obj.d-pcntchr = "?"
     1047               .
     1048             end.
     1049             else do:
     1050               assign
     1051               legacy-obj.d-card = osn_dis-card.d-card
     1052               legacy-obj.d-pcnt = osn_dis-card.d-pcnt
     1053               .
     1054               assign
     1055               legacy-obj.d-pcntchr = get-d-pcnt(buffer osn_dis-card
     1056                                               ,input p-host-code
     1057                                               ,input obj-list.obj-type
     1058                                               ,input obj-list.obj-code
     1059                                               ,input 'def-pcnt':U
     1060                                               ,output loc-d-pcnt).
     1061               .
     1062             end.
     1063           end.
     1064         end.
     1065         if not t-legacy and t-subsid then do:
     1066           find first legacy-obj no-lock where
     1067                     legacy-obj.obj-type = dis-obj.obj-type
     1068                 AND legacy-obj.obj-code = dis-obj.obj-code
     1069                 AND legacy-obj.card-num-chr = temp-dis-card.main-card
     1070                 no-error .
     1071           if not available legacy-obj then do:
     1072             create legacy-obj.
     1073             assign
     1074             legacy-obj.obj-type = dis-obj.obj-type
     1075             legacy-obj.obj-code = dis-obj.obj-code
     1076             legacy-obj.card-num-chr = temp-dis-card.main-card
     1077             legacy-obj.main-card = temp-dis-card.main-card
     1078             legacy-obj.first-card = temp-dis-card.first-card
     1079             legacy-obj.first-main-card = temp-dis-card.first-main-card
     1080             .
     1081             find first osn_dis-card no-lock where
     1082             osn_dis-card.d-card = legacy-obj.main-card use-index isourced no-error .
     1083             if not available osn_Dis-card then do:
     1084               message
