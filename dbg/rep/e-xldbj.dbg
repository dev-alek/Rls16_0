     1086                          ,temp-dis-card.main-card
     1087                          ,dis-obj.d-card )
     1088               view-as alert-box .
     1089               assign
     1090               legacy-obj.d-card = dis-obj.main-card
     1091               legacy-obj.d-pcnt = 0
     1092               legacy-obj.d-pcntchr = "?"
     1093               .
     1094             end.
     1095             else do:
     1096               assign
     1097               legacy-obj.d-card = osn_dis-card.d-card
     1098               legacy-obj.d-pcnt = osn_dis-card.d-pcnt
     1099               .
     1100               legacy-obj.d-pcntchr = get-d-pcnt(buffer osn_dis-card
     1101                                               ,input p-host-code
     1102                                               ,input obj-list.obj-type
     1103                                               ,input obj-list.obj-code
     1104                                               ,input 'def-pcnt':U
     1105                                               ,output loc-d-pcnt)
     1106               .
     1107             end.
     1108           end.
     1109         end.
     1110         if t-legacy and t-subsid then do:
     1111           find first legacy-obj no-lock where
     1112                     legacy-obj.obj-type = dis-obj.obj-type
     1113                 AND legacy-obj.obj-code = dis-obj.obj-code
     1114                 AND legacy-obj.card-num-chr = temp-dis-card.first-main-card
     1115                 no-error .
     1116           if not available legacy-obj then do:
     1117             create legacy-obj.
     1118             assign
     1119             legacy-obj.obj-type = dis-obj.obj-type
     1120             legacy-obj.obj-code = dis-obj.obj-code
     1121             legacy-obj.card-num-chr = temp-dis-card.first-main-card
     1122             legacy-obj.first-main-card = temp-dis-card.first-main-card
     1123             legacy-obj.first-card = temp-dis-card.first-card
     1124             legacy-obj.main-card = temp-dis-card.main-card
     1125             .
     1126             find last osn_dis-card no-lock where
     1127             osn_dis-card.first-card = legacy-obj.first-card
     1128             and osn_dis-card.is-subsid = no
     1129             use-index isourced no-error .
