      275   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      276   define variable v-waitfram-action01         as character   no-undo .
      277   define variable v-waitfram-action02         as character   no-undo .
      278   define variable v-waitfram-action03         as character   no-undo .
      279   define variable mWaitFramTextBeg            as character   no-undo.
      280   define variable mWaitFramTextEnd            as character   no-undo.
      281   define variable mWaitFramView               as logical     no-undo.
      282   define variable mWaitProcEvent              as logical     no-undo init yes.
      283   define variable mWaitFramInterval           as integer     no-undo init 1 .
      284   define variable mWaitFramStop               as logical     no-undo.
      285   define variable mWaitFramStopUser           as logical     no-undo.
      286   define variable mWaitFramStopTimeOut        as logical     no-undo.
      287   define variable mWaitFramStartProc          as datetime-tz no-undo.
      288   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      289   define button B-WaitFramStop auto-end-key
      290        label "Стоп"
      291        size 10 by 1 tooltip "Остоновить процесс".
      292   define button B-viewProcInfo
      293        label "Информация"
      294        size 15 by 1 tooltip "Информация о процесс".
      295   define frame waitfram
      296     v-waitfram-action01 format "x(72)" no-label skip
      297     v-waitfram-action02 format "x(72)" no-label skip
      298     v-waitfram-action03 format "x(72)" no-label skip
      299     B-viewProcInfo
      300     B-WaitFramStop at row 4 col 30
      301     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      302     .
      303   define new global shared variable mBatchMode as logical no-undo init ?.
      304   define variable mFramBachModHandle as handle no-undo.
      305   mFramBachModHandle = frame waitfram:handle.
      306   define variable mFameOldVis as logical no-undo.
      307   define variable mVisCUrentVin as logical no-undo.
      308   if session:batch-mode
      309   then
      310      mBatchMode = yes.
      311   if mBatchMode = ? then do:
      312     mVisCUrentVin = current-window:visible.
      313     mFameOldVis = mFramBachModHandle:visible.
      314     mFramBachModHandle:visible  = yes.
      315     mBatchMode = mFramBachModHandle:visible ne yes.
      316     mFramBachModHandle:visible = mFameOldVis.
      317     current-window:visible = mVisCUrentVin.
      318   end.
      319    if  log-manager:logfile-name ne ?
      320     then DO:
      321         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      322         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      323         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      324     end.
      325   on choose of B-WaitFramStop in frame waitfram
      326   do:
      327     mWaitFramStop = yes.
      328     mWaitFramStopUser = yes.
      329   end.
      330   function waitfram-check-timeout returns logical():
      331      define variable vtime as int64 no-undo.
      332      if mWaitFramStopTimeOut
      333      then
      334         return yes.
      335      vtime = ( now - mWaitFramStartProc ) / 1000 .
      336      if     mWaitFramTimeOut ne ?
      337         and mWaitFramTimeOut ne 0
      338         and mWaitFramTimeOut lt vtime
      339      then do:
      340         mWaitFramStopTimeOut = yes.
      341      end.
      342      return mWaitFramStopTimeOut.
      343   end.
      344   procedure waitfram-hide :
      345     if not session:batch-mode
      346     then do
      347     on error undo, return error return-value
      348     :
      349       pause 0 before-hide .
      350       if not mBatchMode then
      351         hide frame waitfram .
      352     if     not mWaitFramView
      353        and mWaitProcEvent
      354     then
      355       process events .
      356     end.
      357   end procedure.
      358   procedure waitfram-show :
      359     define input  parameter p-message as character no-undo .
      360     define variable v-left-margin as integer   no-undo .
      361     if not session:batch-mode
      362     then do
      363     on error undo, return error return-value
      364     :
      365       if length(p-message) <= 70 then do:
      366         assign
      367           v-left-margin = integer((70 - length(p-message)) / 2)
      368         .
      369         assign
      370           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      371         .
      372         assign
      373           v-waitfram-action01 = " "
      374           v-waitfram-action02 = " "
      375                                    + fill(" ", v-left-margin)
      376                                    + p-message
      377           v-waitfram-action03 = " "
      378         .
      379       end.
      380       else do:
      381         define variable vRindex1 as integer no-undo.
      382         define variable vRindex2 as integer no-undo.
      383         vRindex1 = r-index(p-message," ",70).
      384         if vRindex1 = 0
      385         then
      386            vRindex1 = 70.
      387         if length(p-message)  <= vRindex1 + 70 then do:
      388           assign
      389             v-waitfram-action01 = " "
      390             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      391             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      392           .
      393         end.
      394         else do:
      395           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      396           if vRindex2 <= vRindex1
      397           then
      398              vRindex2 = vRindex1 + 70.
      399           assign
      400             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      401             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      402             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      403           .
      404         end.
      405       end.
      406       B-viewProcInfo:visible   in frame waitfram = no.
      407       B-viewProcInfo:sensitive in frame waitfram = no.
      408       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      409       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      410       if  (   mWaitFramView
      411          or  mWaitProcEvent)
      412          and not mBatchMode
      413       then
      414          display
      415             v-waitfram-action01 skip
      416             v-waitfram-action02 skip
      417             v-waitfram-action03 skip
      418          with frame waitfram .
      419       if     mWaitFramView
      420          then do:
      421             if     mWaitFramInterval ne ?
      422                and not mBatchMode
      423             then
      424                wait-for go of frame waitfram pause mWaitFramInterval.
      425          end.
      426          else
      427             if     mWaitProcEvent
      428                and not mBatchMode
      429             then
      430                process events .
      431     end.
      432   end procedure.
      433      procedure waitfram-show-this:
      434         define input  parameter iInterval as int64 no-undo.
      435         define variable vtime as int64 no-undo.
      436         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      437         mWaitFramInterval = iInterval.
      438         run waitfram-show (substitute("&1&2 &3&4" ,
      439                                       mWaitFramTextBeg ,
      440                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      441                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      442                                       mWaitFramTextEnd
      443                                      )
      444                           ).
      445      end.
      446      procedure WaitFramRunPause:
      447         define input  parameter iInterval as dec no-undo.
      448         define variable vStart  as datetime-tz no-undo.
      449         define variable vend    as datetime-tz no-undo.
      450         define variable vint as int64 no-undo.
      451         define variable vOk as logical no-undo.
      452         vStart = now.
      453         vend   = vStart.
      454         publish "WaitFramPause" (iInterval,output vOk).
      455         vend   =  now.
      456         vint = vend - vStart.
      457         vint = iInterval - vint / 1000.
      458         if     not mWaitFramStop
      459            and (   vint > 0
      460                 or (    not vOk
      461                     and iInterval eq ?
      462                     )
      463                 )
      464         then
      465            run waitfram-show-this (iInterval).
      466         vend   =  now.
      467         vint = vend - vStart.
      468         vint = iInterval - vint / 1000.
      469         if     not mWaitFramStop
      470            and vint > 0
      471         then do:
      472            run gbl/pause.p (vint * 1000).
      473         end.
      474         if iInterval ne ?
      475         then
      476            publish "WaitFramStop".
      477         waitfram-check-timeout().
      478      end.
      479      procedure WaitFramWaitFor:
      480         define input  parameter iInterval as dec no-undo.
      481         assign
      482            mWaitFramStartProc   = now
      483            mWaitFramStopUser    = no
      484            mWaitFramStopTimeOut = no
      485         .
      486         block-wait:
      487         do while not mWaitFramStop:
      488            run WaitFramRunPause (iInterval).
      489            if  waitfram-check-timeout()
      490            then do:
      491               leave block-wait.
      492            end.
      493         end.
      494         run waitfram-hide.
      495      end.
      496   procedure waitfram-join :
      497     define input  parameter p-line-1  as character no-undo .
      498     define input  parameter p-line-2  as character no-undo .
      499     define input  parameter p-line-3  as character no-undo .
      500     define output parameter p-message as character no-undo .
      501     do
      502     on error undo, return error return-value
      503     :
      504       assign
      505         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      506                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      507                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      508       .
      509     end.
      510   end procedure.
      511   function waitfram-join-function returns character
      512     (input p-line-1 as character
      513     ,input p-line-2 as character
      514     ,input p-line-3 as character
      515     ).
      516     define variable v-message as character no-undo .
      517     run waitfram-join in this-procedure
      518       (input  p-line-1
      519       ,input  p-line-2
      520       ,input  p-line-3
      521       ,output v-message
      522       ) .
      523     return v-message .
      524   end function .
      525   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      526   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      527   FUNCTION get-d-pcntdc-list RETURNS CHARACTER
      528     ( buffer loc-dis-card for dc-list,
      529       input parhost-code as integer,
      530       input parobj-type as character,
      531       input parobj-code as integer,
      532       input p-discnt-role as character,
      533       output loc-d-v as decimal) :
      534   define variable v-node-code as integer no-undo .
      535   define buffer buf_dis-card-type for ub.dis-card-type.
      536   define buffer buf_dis-card-property for ub.dis-card-property.
      537   find first buf_dis-card-type no-lock where
      538             buf_dis-card-type.type = loc-dis-card.type
      539         and buf_dis-card-type.emitent-host-code = loc-dis-card.emitent-host-code
      540         and buf_dis-card-type.host-code = 0
      541         and buf_dis-card-type.obj-type = '':U
      542         and buf_dis-card-type.obj-code = 0 no-error.
      543   if available buf_dis-card-type then do:
      544     case p-discnt-role:
      545       when 'def-pcnt':U  then do:
      546         assign
      547         v-node-code = 1.
      548       end.
      549       when 'def-cash-pcnt':U then do:
      550         assign
      551         v-node-code = 2.
      552       end.
      553       when 'def-categ':U then do:
      554         assign
      555         v-node-code = 3.
      556       end.
      557     end.
      558     if buf_dis-card-type.d-pcnt-byshop then do:
      559      find first buf_dis-card-property no-lock where
      560                buf_dis-card-property.d-card = loc-dis-card.d-card
      561            and buf_dis-card-property.dtm-code = 26
      562            and buf_dis-card-property.host-code = parhost-code
      563            and buf_dis-card-property.obj-type = parobj-type
      564            and buf_dis-card-property.obj-code = parobj-code
      565            and buf_dis-card-property.node-code = v-node-code no-error.
      566      if available buf_dis-card-property then do:
      567        if p-discnt-role = 'def-categ':U then do:
      568          assign
      569          loc-d-v = buf_dis-card-property.property-value-integer.
      570        end.
      571        else do:
      572          assign
      573          loc-d-v = buf_dis-card-property.property-value-decimal.
      574        end.
      575      end.
      576       if loc-d-v = ? then do:
      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdpcnt in g#library
      579     (
      580      input  loc-dis-card.type
      581     ,input  loC-dis-card.emitent-host-code
      582     ,input  parhost-code
      583     ,input  parobj-type
      584     ,input  parobj-code
      585     ,input  p-discnt-role
      586     ,output loc-d-v
      587     ) no-error .
      588       end.
      589       if loc-d-v = ? then do:
      590         find first buf_dis-card-property no-lock where
      591                   buf_dis-card-property.d-card = loc-dis-card.d-card
      592               and buf_dis-card-property.dtm-code = 26
      593               and buf_dis-card-property.host-code = parhost-code
      594               and buf_dis-card-property.obj-type = ''
      595               and buf_dis-card-property.obj-code = 0
