      193   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      194   def
      195    shared
      196   temp-table  obj-list no-undo
      197     field obj-type like ub.clients.obj-type
      198     field obj-code like ub.clients.obj-code
      199     field obj-name like ub.clients.obj-name
