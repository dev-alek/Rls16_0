     2703                     Gds-zap-artic = "        Итого по "
     2704                     Gds-zap-gds-name =  B1-name
     2705                                   .
     2706               Run Display-b1 In This-procedure .
     2707               Run Clear-b1 In This-procedure .
     2708               Assign Break_Group = True.
     2709           End.
     2710     End.
     2711   End.
     2712           end.
     2713        end case.
     2714   end procedure.
