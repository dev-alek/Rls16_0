     1377   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1378         VIEW-AS TEXT
     1379        SIZE 53.25 BY .67
     1380        FGCOLOR 1  NO-UNDO.
     1381   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1382         VIEW-AS TEXT
     1383        SIZE 53.25 BY .67
     1384        FGCOLOR 1  NO-UNDO.
     1385   DEFINE RECTANGLE RECT-1
     1386        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1387        SIZE 55.13 BY 4.46.
     1388   DEFINE FRAME InfoFrame
     1389        StopBtn AT ROW 4.25 COL 21.75
     1390        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1391        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1392        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1393        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1394        RECT-1 AT ROW 1 COL 1
     1395       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1396            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1397            TITLE "Процесс"
     1398            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1399   define variable mFrameView      as logical   no-undo init yes.
     1400     define variable mFramHandle as handle no-undo.
     1401     mFramHandle = frame InfoFrame:handle.
     1402     if  log-manager:logfile-name ne ?
     1403     then DO:
     1404         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1405         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1406         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1407     end.
     1408     mFrameView = not session:batch-mode and mFramHandle:visible.
     1409     if mFrameView
     1410     then do:
     1411       ASSIGN
     1412          FRAME InfoFrame:HIDDEN                           = TRUE
     1413          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1414     end.
     1415   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1416   DO:
     1417     IF not StopProcessing THEN
     1418       Message "Вы действительно хотите прервать" SKIP
     1419               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1420                 UPDATE StopProcessing.
     1421     IF StopProcessing THEN do:
     1422        if mFrameView
     1423        then do:
     1424           HIDE FRAME InfoFrame.
     1425        end.
     1426     End.
     1427   END.
     1428   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1429     if  log-manager:logfile-name ne ?
     1430     then DO:
     1431         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1432     end.
     1433     if not session:batch-mode then
     1434     do:
     1435       VIEW FRAME InfoFrame.
     1436       mFrameView = true.
     1437     end.
     1438      v-button-stop = false .
     1439         if mFrameView
     1440         then do:
     1441         if v-button-stop then view STOPBTN in frame InfoFrame.
     1442                          else Hide STOPBTN in frame InfoFrame.
     1443         end.
     1444   DEFINE FRAME zapas
     1445           gds-zap-b-code column-label  "Код! ":C10 format ">>>>>>>>>>" space(0)
     1446           sym1 column-label ":!:" format "x(1)"       space(0)
     1447           gds-zap-artic column-label "Артикул! ":C16 format "X(16)" space(0)
     1448           sym2 column-label ":!:" format "x(1)"                         space(0)
     1449           gds-zap-gds-name column-label "Название товара! ":C33 format "X(33)" space(0)
     1450           sym3 column-label ":!:" format "x(1)"                                 space(0)
     1451           gds-zap-unit-base column-label "Ед.!изм" format "X(3)"                 space(0)
     1452           sym4 column-label ":!:" format "x(1)"                                   space(0)
     1453           type-Sum column-label  "Тип!цен":C4 format "X(4)" space(0)
     1454           sym5 column-label ":!:" format "x(1)" space(0)
     1455           F-qnty   column-label "Количество! ":C15     Format "x(15)"     space(0)
     1456           sym6 column-label ":!:" format "x(1)" space(0)
     1457           F-Summ    column-label "Сумма!  ":C15     Format "x(15)"     space(0)
     1458           sym7 column-label ":!:" format "x(1)" space(0)
     1459           F-Vat   column-label "НДС! ":C15     Format "x(15)"     space(0)
     1460           sym8 column-label ":!:" format "x(1)" space(0)
     1461           F-excise             column-label "Акциз!  ":C15  Format "x(15)"   space(0)
     1462           sym9 column-label ":!:" format "x(1)" space(0)
     1463           F-road-tax               column-label "Дорожный налог!  ":C15  Format "x(15)"   space(0)
     1464           sym10 column-label ":!:" format "x(1)" space(0)
     1465           F-transport           column-label "Транспортный!налог":C15  Format "x(15)"   space(0)
     1466           sym11 column-label ":!:" format "x(1)" space(0)
     1467           F-Other         column-label "Скидка! ":C12  Format "x(12)"   space(0)
     1468           sym12 column-label ":!:" format "x(1)" space(0)
     1469           F-eff      column-label "Эффективность!% ":C15  Format "x(15)"   space(0)
     1470       HEADER
     1471           cur-time-print() AT 5 format "X(35)"
     1472           "Цены указаны в" (if tPrintRubl then "РУБ" else x-base-type )
     1473           string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>9") ) AT 147 format "X(53)" SKIP
     1474           Line format "X(198)" AT 1
     1475      with width 232 down stream-io use-text NO-BOX.
     1476        assign
     1477           i=0
     1478           xlavel = xvar-lavel
     1479           Select-Good   = x-SelectGood
     1480           PayType       = x-SET_PAY_TYPE
     1481           RetClassify   = xClassify
     1482           RetSortType   = xSortType
     1483           Sums-Only     = xSumsOnly
     1484           Show-Negativ  = xShowZero
     1485           FirstLine     = FALSE.
     1486           Line          = fill("-", 232).
     1487           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1488           run tax-name (input 'rdt':U, output rdtaxname ).
     1489           assign F-road-tax :label = rdtaxname .
     1490           if not ( show-sale and show-cost ) then  do:
     1491                F-eff :label = "" .
     1492                F-eff :hidden = true  .
     1493               end .
     1494           Run report-execute.
     1495   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1496   define variable str  as char format "X(60)"  no-undo.
     1497   define variable str2 as char  no-undo.
     1498   STR ="".
     1499   define variable i#i as int no-undo.
     1500     REPEAT i#i =1 to lavel#:
     1501         If i#i =1 then STR   = entry(1,grp-name, chr(47)) .
     1502         Else DO:
     1503             STR2 =   entry(i#i,grp-name, chr(47)) no-error.
     1504             IF NOT ERROR-STATUS:ERROR  and str2 <> "":U then  STR = STR + chr(47) +  entry(i#i,grp-name, chr(47)) .
     1505             End.
     1506     End.
     1507       RETURN (str + chr(47)).
     1508   END FUNCTION.
     1509   PROCEDURE report-execute :
     1510     If (ValType=0 and x-base-code=0)  Or ValType=1
     1511                                   then   assign tPrintRubl = yes .
     1512                                   else   assign tPrintRubl = no .
     1513   output stream OutStream to value( string( session:temp-directory +
     1514                                        "rpt" + string( g#report-num ) ) )
     1515                                        page-size  value(ReportPageHeight) .
     1516      if xTog-obj  Then DO:
     1517               FOR each obj-list no-lock:
     1518                   x-store-type = obj-list.obj-type.
     1519                   x-store-code = obj-list.obj-code.
     1520                   Run report-exec1.
     1521               End.
     1522                                                  End.
     1523     Else Run report-exec1.
     1524     HIDE   STREAM OutStream FRAME ZAPAS .
     1525     Output stream OutStream close.
     1526   if mFrameView
     1527   then do:
     1528      HIDE FRAME InfoFrame.
     1529   end.
     1530     define variable v-user-action as character no-undo .
     1531     define variable v-printed as logical   no-undo .
     1532     define variable DisabledOptions as integer   no-undo .
     1533     define variable v-orient-page as character no-undo .
     1534     run How-name in this-procedure (
     1535         input ReportPageHeight,
     1536         input ReportPageWidth,
     1537         output v-orient-page )
     1538         .
     1539     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     1540                                    else DisabledOptions = 0 .
     1541     run gbl/prnfilen.w
     1542       (input  ""
     1543       ,input  DisabledOptions
     1544       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1545       ,input  ReportFontNum
     1546       ,output v-user-action
     1547       ,output v-printed
     1548       ) .
     1549   END PROCEDURE.
     1550   PROCEDURE report-exec1  :
     1551      FIND FIRST clients where x-store-type = clients.obj-type AND
     1552                               x-store-code = clients.obj-code no-lock no-error.
     1553              If available clients then  ObjName = clients.obj-name.
     1554                                            else  ObjName="объект не определен".
     1555     FORM with FRAME zapas .
     1556     Line = fill("-", 198).
     1557   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1558   form header
     1559     line format "X(198)" at 1 skip
     1560     "Продолжение - на следующей странице" at 30 skip
     1561     with frame bottomframe width 232 page-bottom no-labels no-box .
     1562   view stream outstream frame bottomframe .
     1563     run calcitog in this-procedure .
     1564     run print-header.
     1565      case RetClassify :
     1566       when "no-classify":U    then  run run1 in this-procedure .
     1567       when "grp-goods":U      then  run run2 in this-procedure .
     1568       when "prod":U           then  run run3 in this-procedure .
     1569       otherwise do:
     1570         message "Ошибка вызова!" view-as alert-box error .
     1571       end.
     1572      end case.
     1573     hide stream outstream frame bottomframe .
     1574     run print-footer.
     1575     end procedure.
     1576   PROCEDURE foreach :
     1577   IF ( i modulo v-account = 0 )  then DO:
     1578    Assign
     1579       v-kol-spice = (50 - LENGTH(reportname)) / 2
     1580       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     1581       .
     1582    Assign
     1583       v-kol-spice = (50 - LENGTH(objname)) / 2
     1584       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     1585       .
     1586             if  log-manager:logfile-name ne ?
     1587             then DO:
     1588                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1589             end.
     1590              if mFrameView
     1591              then do:
     1592               DISPLAY
     1593                 i @ RecordsDone
     1594                 RecordsString   @ RecordsString
     1595                 RecordsString2  @ RecordsString2
     1596                 WITH FRAME InfoFrame.
     1597              end.
     1598   End.
     1599      if v-button-stop then  DO:
     1600            if mFrameView
     1601            then
     1602               PROCESS EVENTS.
     1603            IF StopProcessing THEN DO:
     1604            RETURN error.
     1605            End.
     1606      end.
     1607    If Show-cost  then DO:
     1608      RUN Clear-item(1).
     1609      if gds-zap-type = 'т':U THEN
     1610   run ob-line  in this-procedure (
     1611   input x-store-code ,
     1612   input x-store-type ,
     1613   input gds-zap-artic ,
     1614   input gds-zap-prod-code ,
     1615   input gds-zap-prod-type ,
     1616   input fact-order-1 ,
     1617   input fact-order-2 ,
     1618   input 'cost':U ,
     1619   input '##,##':U,
     1620   input xCOMBO-node ,
     1621   input xtog-obj) .
     1622      if gds-zap-type = 'у':U THEN
     1623   run ob-line  in this-procedure (
     1624   input x-store-code ,
     1625   input x-store-type ,
     1626   input gds-zap-artic ,
     1627   input gds-zap-prod-code ,
     1628   input gds-zap-prod-type ,
     1629   input fact-order-1 ,
     1630   input fact-order-2 ,
     1631   input 'cssr':U ,
     1632   input '##,##':U,
     1633   input xCOMBO-node ,
     1634   input xtog-obj) .
     1635      Run CAlc-Sub-itog (1).
     1636      End.
     1637    If Show-crsa  then DO:
     1638      RUN Clear-item(2).
     1639      if gds-zap-type = 'т':U THEN
     1640   run ob-line  in this-procedure (
     1641   input x-store-code ,
     1642   input x-store-type ,
     1643   input gds-zap-artic ,
     1644   input gds-zap-prod-code ,
     1645   input gds-zap-prod-type ,
     1646   input fact-order-1 ,
     1647   input fact-order-2 ,
     1648   input 'crsa':U ,
     1649   input '##,##':U,
     1650   input xCOMBO-node ,
     1651   input xtog-obj) .
     1652      if gds-zap-type = 'у':U THEN
     1653   run ob-line  in this-procedure (
     1654   input x-store-code ,
     1655   input x-store-type ,
     1656   input gds-zap-artic ,
     1657   input gds-zap-prod-code ,
     1658   input gds-zap-prod-type ,
     1659   input fact-order-1 ,
     1660   input fact-order-2 ,
     1661   input 'cgsr':U ,
     1662   input '##,##':U,
     1663   input xCOMBO-node ,
     1664   input xtog-obj) .
     1665      Run CAlc-Sub-itog (2).
     1666      End.
     1667     RUN Clear-item(3).
     1668      if gds-zap-type = 'т':U THEN
     1669   run ob-line  in this-procedure (
     1670   input x-store-code ,
     1671   input x-store-type ,
     1672   input gds-zap-artic ,
     1673   input gds-zap-prod-code ,
     1674   input gds-zap-prod-type ,
     1675   input fact-order-1 ,
     1676   input fact-order-2 ,
     1677   input 'sale':U ,
     1678   input '##,##':U,
     1679   input xCOMBO-node ,
     1680   input xtog-obj) .
     1681      if gds-zap-type = 'у':U THEN
     1682   run ob-line  in this-procedure (
     1683   input x-store-code ,
     1684   input x-store-type ,
     1685   input gds-zap-artic ,
     1686   input gds-zap-prod-code ,
     1687   input gds-zap-prod-type ,
     1688   input fact-order-1 ,
     1689   input fact-order-2 ,
     1690   input 'sasr':U ,
     1691   input '##,##':U,
     1692   input xCOMBO-node ,
     1693   input xtog-obj) .
     1694      Run CAlc-Sub-itog (3).
     1695   END PROCEDURE.
     1696   PROCEDURE display-line :
     1697       i = i + 1.
     1698       IF  NOT (NOT Show-Negativ  AND
     1699         ( qnty     [1]    = 0 and  qnty     [2]    = 0 and  qnty     [3]    = 0 and
     1700           Summ     [1]    = 0 and  Summ     [2]    = 0 and  Summ     [3]    = 0 and
     1701           Vat      [1]    = 0 and  Vat      [2]    = 0 and  Vat      [3]    = 0 and
     1702           excise   [1]    = 0 and  excise   [2]    = 0 and  excise   [3]    = 0 and
     1703           road-tax [1]    = 0 and  road-tax [2]    = 0 and  road-tax [3]    = 0 and
     1704           transport[1]    = 0 and  transport[2]    = 0 and  transport[3]    = 0 and
     1705           Other    [1]    = 0 and  Other    [2]    = 0 and  Other    [3]    = 0 )) Then dO:
     1706           IF NOT Sums-Only then   do:
     1707                   if fr0 = true then do:
     1708                       PUT stream  OutStream
     1709                           tmp#stroka0
     1710                           format "X(100)" SKIP.
     1711                       fr0 = false .
     1712                   end.
     1713                 if fr = true then do:
     1714                   PUT stream  OutStream   space(10)
     1715                           (if xtog-lavel = false then tmp#stroka
     1716                                               else  str )
     1717                       format "X(100)" SKIP.
     1718                   fr = false .
     1719                 end.
     1720               Run Display-str1.
     1721           end.
     1722        END.
     1723     END PROCEDURE.
     1724   PROCEDURE print-header :
     1725   if NOT FirstLine Then  Run Display-Title.
     1726       FirstLine = TRUE .
     1727       if xTog-obj and   x-SelectObject <> "currency":U   Then  DO:
     1728             PUT stream  OutStream  UNFORMATTED  "ПО ОБЪЕКТУ : " + CAPS(ObjName)  AT 30 format "X(170)" SKIP.
     1729             End.
     1730        FORM with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     1731         RUN clear--B1 (1) . RUN clear--B1 (2) . RUN clear--B1 (3) .
     1732         RUN clear--B2 (1) .  RUN clear--B2 (2).  RUN clear--B2 (3).
     1733         RUN clear--Bi (1) . RUN clear--Bi (2) . RUN clear--Bi (3) .
     1734         break_group = true.
     1735         break_group1 = true.
     1736      END PROCEDURE.
     1737   PROCEDURE Print-Footer :
     1738         If RetClassify = "no-classify":U  then Run U-line.
     1739          gds-zap-artic = "ИТОГО" .
     1740          Run display-BI.
     1741          Run U-line.
     1742          END PROCEDURE.
     1743   PROCEDURE U-LINE :
     1744   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     1745           gds-zap-b-code
     1746           gds-zap-artic
     1747           gds-zap-gds-name
     1748           gds-zap-unit-base
     1749           F-qnty
     1750           F-Summ
     1751           F-Vat
     1752           F-eff
     1753           F-excise
     1754           F-road-tax
     1755           F-transport
     1756           F-Other
     1757           type-Sum
     1758           with FRAME ZAPAS .
     1759           DOWN stream   OutStream 1 with FRAME ZAPAS.
     1760           END PROCEDURE.
     1761   PROCEDURE P-LINE :
     1762   UNDERLINE stream OutStream
     1763           sym3
     1764           gds-zap-gds-name
     1765           sym4
     1766           gds-zap-unit-base
     1767           sym5
     1768           with FRAME ZAPAS.
     1769           DOWN stream   OutStream 1 with FRAME ZAPAS .
     1770           END PROCEDURE.
     1771   procedure run1 :
     1772          case select-good :
     1773           when 1  then do:
     1774   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1775   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     1776       for each gds-obj  where
     1777             gds-obj.obj-type = x-store-type  and
     1778             gds-obj.obj-code = x-store-code
     1779             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1780                   no-lock,
     1781             First goods  where  gds-obj.gds-code   = goods.gds-code
     1782   no-lock
     1783   BREAK
     1784       BY (goods.gds-name) :
     1785         run item-goods ( "1" , "goods" ) .
     1786         if return-value <> "" then NEXT.
     1787       End.
     1788     END.
     1789     Else DO:
     1790      For each obj-list no-lock :
     1791                     FOR EACH gds-obj where
     1792                   gds-obj.obj-type = obj-list.obj-type    and
     1793                   gds-obj.obj-code = obj-list.obj-code
     1794                   and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1795                   no-lock :
     1796                   if NOT can-find(First temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code) Then do:
     1797                       find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     1798                       Create temp-gds-list.
     1799                       Assign
     1800                         temp-gds-list.prod-code = gds-obj.prod-code
     1801                         temp-gds-list.grp-name  = gds-obj.grp-name
     1802                         temp-gds-list.gds-name  = goods.gds-name
     1803                         temp-gds-list.gds-code  = gds-obj.gds-code
     1804                         temp-gds-list.artic     = gds-obj.artic
     1805                       .
     1806                   End.
     1807               End.
     1808     End.
     1809     for each temp-gds-list no-lock
     1810       , First goods     where goods.gds-code  = temp-gds-list.gds-code no-lock
     1811         BREAK
     1812       BY goods.gds-name :
     1813       run item-goods ( "1" , "goods" ) .
     1814         if return-value <> "" then NEXT.
     1815     End.
     1816   End.
     1817     end.
     1818           when 2  then do:
     1819   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1820     if x-selectobject = "currency":u  or  xtog-obj then do:
     1821         for  each gds-obj
     1822                     where gds-obj.obj-code   = x-store-code
     1823                      and  gds-obj.obj-type   = x-store-type
     1824                           and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1825                           no-lock ,
     1826                 first  tmp#grp  where gds-obj.grp-name   begins tmp#grp.grp-name   no-lock ,
     1827                 first goods       where gds-obj.gds-code   = goods.gds-code  no-lock
     1828                     break
     1829                     by goods.gds-name :
     1830                     run item-goods ( input "1" , input "goods" ) .
     1831                     if return-value <> "" then next.
     1832         end.
     1833     end.
     1834     else do:
     1835         for each obj-list no-lock :
     1836               for  each gds-obj
     1837                 where  gds-obj.obj-code   = obj-list.obj-code
     1838                   and  gds-obj.obj-type   = obj-list.obj-type
     1839                        and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     1840                 no-lock ,
