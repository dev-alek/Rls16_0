     3138    Assign
     3139       b1-qnty     [tt#]   = 0
     3140       b1-Summ     [tt#]    = 0
     3141       b1-Vat      [tt#]    = 0
     3142       b1-eff      [tt#]    = 0
     3143       b1-excise   [tt#]    = 0
     3144       b1-road-tax [tt#]    = 0
     3145       b1-transport[tt#]    = 0
     3146       b1-Other    [tt#]    = 0  .
