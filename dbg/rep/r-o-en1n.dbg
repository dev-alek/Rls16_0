     3172   PROCEDURE Display-title :
     3173      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     3174             REPORTNAME  AT 20 format "X(170)" SKIP
     3175             Trim(str1)  AT 35 format "X(75)" SKIP.
     3176        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     3177         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     3178        End.
     3179       i=0.
     3180        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     3181         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(170)" SKIP.
     3182        End.
     3183       i=0.
     3184        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     3185         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     3186        End.
     3187       i=0.
     3188        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     3189         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     3190        End.
     3191       i=0.
     3192   END PROCEDURE.
     3193   PROCEDURE ob-line  :
     3194   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3195   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3196   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     3197   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3198   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3199   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     3200   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     3201   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3202   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3203   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3204   define input  parameter xTog-obj         as   log                  no-undo.
     3205   define variable  tt#          as   int                 no-undo.
     3206    if x-sum-type = 'cost':U  OR x-sum-type = 'cssr':U  then tt# = 1.
     3207     if x-sum-type = 'crsa':U  OR x-sum-type = 'cgsr':U  then tt# = 2.
     3208     if x-sum-type = 'sale':U  OR x-sum-type = 'sasr':U  then tt# = 3.
     3209     For EAch obj-list no-lock:
     3210      if  xTog-obj THEN
     3211          if   NOT(    x-store-type     = obj-list.obj-type
     3212               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     3213        IF x-ext-doc-type = 'rs':U + ',' + 'es':U  Then DO:
     3214          FOR each ub.ot-line where
     3215                           ub.ot-line.artic         = x-artic
     3216                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3217                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3218                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3219                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3220                     AND   ub.ot-line.prod-code    = x-prod-code
     3221                     AND   ub.ot-line.prod-type    = x-prod-type
     3222                     AND   ub.ot-line.sum-type     = x-sum-type
     3223                     And   (ot-line.ext-doc-type = 'rs':U
     3224                            OR ub.ot-line.ext-doc-type = 'es':U)
     3225                       no-lock :
     3226              If tPrintRubl = yes Then
     3227              ASSIGN qnty       [tt#]     = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3228                     Summ     [tt#]     = Summ      [tt#]      +  ub.ot-line.sum-rubl
     3229                     Vat      [tt#]     = Vat       [tt#]      +  ub.ot-line.VAT-rubl
     3230                     excise   [tt#]     = excise    [tt#]      +  ub.ot-line.excise-rubl
     3231                     road-tax [tt#]     = road-tax  [tt#]      +  ub.ot-line.road-tax-rubl
     3232                     transport[tt#]     = transport [tt#]      +  ub.ot-line.transport-rubl
     3233                     Other    [tt#]     = Other     [tt#]      +  ub.ot-line.Other-rubl           .
     3234              Else
     3235              ASSIGN qnty       [tt#]     = qnty       [tt#]      +  ub.ot-line.fact-qnty
     3236                     Summ      [tt#]     = Summ        [tt#]    +  ub.ot-line.sum-base
     3237                     Vat       [tt#]     = Vat         [tt#]    +  ub.ot-line.VAT-base
     3238                     excise    [tt#]     = excise      [tt#]    +  ub.ot-line.excise-base
     3239                     road-tax  [tt#]     = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3240                     transport [tt#]     = transport   [tt#]    +  ub.ot-line.transport-base
     3241                     Other     [tt#]     = Other       [tt#]    +  ub.ot-line.Other-base           .
     3242           End.
     3243        End.
     3244        Else DO:
     3245          FOR each ub.ot-line where
     3246                           ub.ot-line.artic         = x-artic
     3247                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3248                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3249                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3250                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3251                     AND   ub.ot-line.prod-code    = x-prod-code
     3252                     AND   ub.ot-line.prod-type    = x-prod-type
     3253                     AND   ub.ot-line.sum-type     = x-sum-type
     3254                     And   ub.ot-line.ext-doc-type = x-ext-doc-type
     3255                       no-lock :
     3256              If tPrintRubl = yes Then
     3257              ASSIGN qnty  [tt#]          = qnty    [tt#]         +  ub.ot-line.fact-qnty
     3258                     Summ       [tt#]    = Summ       [tt#]     +  ub.ot-line.sum-rubl
     3259                     Vat        [tt#]    = Vat        [tt#]     +  ub.ot-line.VAT-rubl
     3260                     excise     [tt#]    = excise     [tt#]     +  ub.ot-line.excise-rubl
     3261                     road-tax   [tt#]    = road-tax   [tt#]     +  ub.ot-line.road-tax-rubl
     3262                     transport  [tt#]    = transport  [tt#]     +  ub.ot-line.transport-rubl
     3263                     Other      [tt#]    = Other      [tt#]     +  ub.ot-line.Other-rubl           .
     3264              Else
     3265              ASSIGN qnty    [tt#]        = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3266                     Summ       [tt#]    = Summ        [tt#]    +  ub.ot-line.sum-base
     3267                     Vat        [tt#]    = Vat         [tt#]    +  ub.ot-line.VAT-base
     3268                     excise     [tt#]    = excise      [tt#]    +  ub.ot-line.excise-base
     3269                     road-tax   [tt#]    = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3270                     transport  [tt#]    = transport   [tt#]    +  ub.ot-line.transport-base
     3271                     Other      [tt#]    = Other       [tt#]    +  ub.ot-line.Other-base           .
     3272           End.
     3273         End.
     3274     END.
     3275   END PROCEDURE.
     3276   PROCEDURE ostatok :
     3277   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3278   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3279   def input parameter x-tog-shift   as   logical             no-undo.
     3280   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3281   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3282   def input parameter x-shift-start as integer               no-undo.
     3283   def input parameter x-shift-end   as integer               no-undo.
     3284   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3285   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3286   def input parameter xTog-obj   as log no-undo.
     3287   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3288   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3289   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3290   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3291   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3292   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3293   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3294   def var              Fact-orderS   as char  no-undo.
     3295   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3296      Assign
     3297         Fact-order   = 0
     3298         Quantity     = 0
     3299         Coast_R      = 0
     3300         Coast_V      = 0
     3301         VAT_R        = 0
     3302         VAT_V        = 0 .
     3303    x-date-start-t  = x-date-start + 1 .
     3304   IF x-date-end = date('') then DO:
     3305      Fact-order = 0 .
     3306      for each obj-list
     3307          where  ( not xtog-obj or
     3308                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3309                 no-lock :
     3310         if  x-tog-shift = false then do:
     3311                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3312                               ub.stk-tot.Fact-date <=  x-date-start
     3313                               and ub.stk-tot.shift-num = 0
     3314                               USE-INDEX fact-date no-lock no-error .
     3315              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3316         End.
     3317         Else  DO :
     3318             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3319              (ub.stk-tot.shift-date  = x-date-start-t and
     3320               ub.stk-tot.shift-num  < x-shift-start or
     3321               ub.stk-tot.shift-date  < x-date-start-t  )
     3322               and ub.stk-tot.shift-num  > 0
     3323               USE-INDEX Shift-num no-lock no-error .
     3324            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3325           END.
     3326       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3327     End.
     3328   End.
     3329   Else DO:
     3330     For each obj-list  WHERE
     3331        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3332         no-lock :
     3333      IF  x-TOG-Shift = False Then DO:
     3334          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3335               ub.stk-tot.Fact-date <= x-date-end
     3336               and ub.stk-tot.shift-num = 0
     3337               USE-INDEX fact-date no-lock no-error.
     3338          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3339      END.
     3340      Else DO:
     3341           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3342               (ub.stk-tot.shift-date  = x-date-end and
     3343               ub.stk-tot.shift-num  <= x-shift-end or
     3344               ub.stk-tot.shift-date  < x-date-end       ) and
     3345               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3346               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3347       End.
     3348       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3349     End.
     3350   End.
     3351   END PROCEDURE.
     3352     PROCEDURE Calc-Sub-itog :
     3353     define input parameter tt#          as   int                 no-undo.
     3354     Assign
     3355     B1-qnty     [tt#] = B1-qnty       [tt#] + qnty            [tt#]
     3356     B1-Summ     [tt#]  = B1-Summ     [tt#]    + Summ          [tt#]
     3357     B1-Vat      [tt#]  = B1-Vat      [tt#]    + Vat           [tt#]
     3358     B1-excise   [tt#]  = B1-excise   [tt#]    + excise        [tt#]
     3359     B1-road-tax [tt#]  = B1-road-tax [tt#]    + road-tax      [tt#]
     3360     B1-transport[tt#]  = B1-transport[tt#]    + transport     [tt#]
     3361     B1-Other    [tt#]  = B1-Other    [tt#]    + Other         [tt#]
     3362     B2-qnty     [tt#]   = B2-qnty      [tt#]  + qnty        [tt#]
     3363     B2-Summ     [tt#]  = B2-Summ       [tt#]  + Summ       [tt#]
     3364     B2-Vat      [tt#]  = B2-Vat        [tt#]  + Vat        [tt#]
     3365     B2-excise   [tt#]  = B2-excise     [tt#]  + excise     [tt#]
     3366     B2-road-tax [tt#]  = B2-road-tax   [tt#]  + road-tax   [tt#]
     3367     B2-transport[tt#]  = B2-transport  [tt#]  + transport  [tt#]
     3368     B2-Other    [tt#]  = B2-Other      [tt#]  + Other      [tt#]
     3369     Bi-qnty     [tt#]  = Bi-qnty      [tt#]   + qnty     [tt#]
     3370     Bi-Summ     [tt#]  = Bi-Summ      [tt#]   + Summ     [tt#]
     3371     Bi-Vat      [tt#]  = Bi-Vat       [tt#]   + Vat      [tt#]
     3372     Bi-excise   [tt#]  = Bi-excise    [tt#]   + excise   [tt#]
     3373     Bi-road-tax [tt#]  = Bi-road-tax  [tt#]   + road-tax [tt#]
     3374     Bi-transport[tt#]  = Bi-transport [tt#]   + transport[tt#]
     3375     Bi-Other    [tt#]  = Bi-Other     [tt#]   + Other    [tt#]    .
     3376   END PROCEDURE.
     3377   PROCEDURE Clear-item :
     3378    define input parameter tt#          as   int                 no-undo.
     3379    Assign
     3380     Qnty      [tt#]   = 0
     3381     Summ      [tt#]  = 0
     3382     Vat       [tt#]  = 0
     3383     eff       [tt#]  = 0
     3384     Excise    [tt#]  = 0
     3385     Road-tax  [tt#]  = 0
     3386     Transport [tt#]  = 0
     3387     Other     [tt#]  = 0 .
     3388    END PROCEDURE.
     3389   PROCEDURE Item-Goods :
     3390    define input parameter  par-3 as char no-undo.
     3391    define input parameter  par-4 as char no-undo.
     3392    define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     3393    define variable v-host-code     like ub.sysconf.host-code  no-undo.
     3394    define variable v-gds-code      like ub.goods.gds-code     no-undo.
     3395        if par-4 = "goods":U  Then DO:
     3396             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     3397                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     3398                                   assign
     3399                                       gds-zap-unit-base  = Goods.unit-base
     3400                                       gds-zap-prt-root   = Goods.prt-root
     3401                                       gds-zap-prod-type  = Goods.prod-type
     3402                                       gds-zap-prod-code  = Goods.prod-code
     3403                                       gds-zap-artic      = Goods.artic
     3404                                       gds-zap-type       = Goods.gds-type
     3405                                       gds-zap-grp-name   = Goods.grp-name
     3406                                       gds-zap-b-code     = Goods.gds-code
     3407                                       gds-zap-prod-name  = clients.obj-name .
     3408                                   if g#gds-engl then
     3409                                       assign gds-zap-gds-name = Goods.engl-name.
     3410                                   else
     3411                                       assign gds-zap-gds-name = Goods.gds-name.
     3412                               End.
     3413        if par-4 = "gds-list":U  Then DO:
     3414             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     3415                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     3416                                   assign
     3417                                       gds-zap-unit-base  = gds-list.unit-base
     3418                                       gds-zap-prt-root   = gds-list.prt-root
     3419                                       gds-zap-prod-type  = gds-list.prod-type
     3420                                       gds-zap-prod-code  = gds-list.prod-code
     3421                                       gds-zap-type       = gds-list.gds-type
     3422                                       gds-zap-artic      = gds-list.artic
     3423                                       gds-zap-grp-name   = gds-list.grp-name
     3424                                       gds-zap-b-code     = gds-list.gds-code
     3425                                       gds-zap-prod-name  = clients.obj-name .
     3426                                   if g#gds-engl then
     3427                                       assign gds-zap-gds-name = gds-list.engl-name.
     3428                                   else
     3429                                       assign gds-zap-gds-name = gds-list.gds-name.
     3430                               End.
     3431       Run foreach .
     3432         If  break_group = true and par-3 <> "1"  then DO:
     3433                        If break_group1 = True THEN  DO:
     3434                                  if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3435                                     then temp-str = string("ГРУППА : " + gds-zap-grp-name ).
     3436                                     else temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) .
     3437                                  if par-3 = "6"  then do:
     3438                                     assign
     3439                                         v-gds-code = ( if par-4 = "gds-list" then Gds-list.gds-code
     3440                                                                              else goods.gds-code )
     3441                                     .
     3442   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3443   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3444     (input  x-store-type
     3445     ,input  x-store-code
     3446     ,output v-host-code
     3447     )  .
     3448   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3449   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3450     (input  v-gds-code
     3451     ,input  '1':U
     3452     ,input  ?
     3453     ,input  v-host-code
     3454     ,input  x-store-type
     3455     ,input  x-store-code
     3456     ,output v-vat-pc
     3457     ) no-error .
     3458                                     assign
     3459                                       temp-str = string( "СТАВКА НДС : " + string(v-vat-pc) + "%" )
     3460                                     .
     3461                                  end.
     3462                                fr0 = true .
     3463                                tmp#stroka0 = temp-str.
     3464                        End.
     3465                        IF  (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3466                            temp-str =
     3467                                ( if par-3 = "4"
     3468                                     then string("ГРУППА : " + gds-zap-grp-name )
     3469                                     else string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) ).
     3470                                 if NOT xSumsOnly THEN DO :
     3471                                 tmp#stroka = temp-str.
     3472                                 fr = true .
     3473                                 end.
     3474                                 break_group1 = false.
     3475                        END.
     3476                         break_group = false.
     3477       End.
     3478             Run display-line.
     3479    END PROCEDURE.
     3480   PROCEDURE Di :
     3481   define input parameter tt# as int no-undo.
     3482   define input parameter p1 as char no-undo.
     3483   define input parameter p2 as int no-undo.
     3484   define input parameter p3 as char no-undo.
     3485   define input parameter p4 as char no-undo.
     3486   define input parameter p5 as char no-undo.
     3487   define input parameter p6 as char no-undo.
     3488   define input parameter p7 as char no-undo.
     3489    CASE CAPS(p7) :
     3490      WHEN "B1":U  Then  DO:
     3491      IF  NOT (NOT Show-Negativ  AND
     3492        (b1-qnty  [tt#]           = 0 and
     3493          b1-Summ     [tt#] = 0 and
     3494          b1-Vat      [tt#] = 0 and
     3495          b1-excise   [tt#] = 0 and
     3496          b1-road-tax [tt#] = 0 and
     3497          b1-transport[tt#] = 0 and
     3498          b1-Other    [tt#] = 0 ))  THEN DO:
     3499                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3500                   p1   @ type-Sum
     3501                   p3 @ gds-zap-b-code
     3502                   p4 @ gds-zap-artic
     3503                   p5 @ gds-zap-gds-name
     3504                   p6 @ gds-zap-unit-base
     3505                   b1-qnty      @ F-qnty
     3506                   b1-Summ     [tt#]  @ F-Summ
     3507                   b1-Vat      [tt#]  @ F-Vat
     3508                   b1-eff      [tt#] when b1-eff[tt#] <> 0  @ F-eff
     3509                   b1-excise   [tt#]  @ F-excise
     3510                   b1-road-tax [tt#]  @ F-road-tax
     3511                   b1-transport[tt#]  @ F-transport
     3512                   b1-Other    [tt#]  @ F-Other
     3513                  with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3514       End.
     3515      WHEN "B2":U  Then do:
     3516      IF  NOT (NOT Show-Negativ  AND
     3517      (b2-qnty  [tt#]           = 0 and
     3518          b2-Summ     [tt#] = 0 and
     3519          b2-Vat      [tt#] = 0 and
     3520          b2-excise   [tt#] = 0 and
     3521          b2-road-tax [tt#] = 0 and
     3522          b2-transport[tt#] = 0 and
     3523          b2-Other    [tt#] = 0 ))  THEN  DO:
     3524         DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3525                   p1 @ type-Sum
     3526                   p3 @ gds-zap-b-code
     3527                   p4 @ gds-zap-artic
     3528                   p5 @ gds-zap-gds-name
     3529                   p6 @ gds-zap-unit-base
     3530                   b2-qnty    [tt#]    @ F-qnty
     3531                   b2-Summ     [tt#]  @ F-Summ
     3532                   b2-Vat      [tt#]  @ F-Vat
     3533                   b2-eff      [tt#] when b2-eff[tt#] <> 0  @ F-eff
     3534                   b2-excise   [tt#]  @ F-excise
     3535                   b2-road-tax [tt#]  @ F-road-tax
     3536                   b2-transport[tt#]  @ F-transport
     3537                   b2-Other    [tt#]  @ F-Other
     3538                   with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3539          End.
     3540      WHEN "BI":U Then DO:
     3541                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3542                   p1   @ type-Sum
     3543                   p3 @ gds-zap-b-code
     3544                   p4 @ gds-zap-artic
     3545                   p5 @ gds-zap-gds-name
     3546                   p6 @ gds-zap-unit-base
     3547                   bi-qnty    [tt#]    @ F-qnty
     3548                   bi-Summ     [tt#]  @ F-Summ
     3549                   bi-Vat      [tt#]  @ F-Vat
     3550                   bi-eff      [tt#] when bi-eff[tt#] <> 0 @ F-eff
     3551                   bi-excise   [tt#]  @ F-excise
     3552                   bi-road-tax [tt#]  @ F-road-tax
     3553                   bi-transport[tt#]  @ F-transport
     3554                   bi-Other    [tt#]  @ F-Other
     3555                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3556               End.
     3557      WHEN ""  Then DO:
     3558                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3559                   p1   @ type-Sum
     3560                   p3   @ gds-zap-b-code
     3561                   p4 @ gds-zap-artic
     3562                   p5 @ gds-zap-gds-name
     3563                   p6 @ gds-zap-unit-base
     3564                   qnty     [tt#]  @ F-qnty
     3565                   Summ     [tt#]  @ F-Summ
     3566                   Vat      [tt#]  @ F-Vat
     3567                   eff      [tt#]  when eff[tt#] <> 0   @ F-eff
     3568                   excise   [tt#]  @ F-excise
     3569                   road-tax [tt#]  @ F-road-tax
     3570                   transport[tt#]  @ F-transport
     3571                   Other    [tt#]  @ F-Other
     3572                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3573                End.
     3574      End case.
     3575    END PROCEDURE.
     3576   PROCEDURE Clear-B1  :
     3577   define variable tt#          as   int                 no-undo.
     3578   repeat tt# = 1 to 3 :
     3579    Assign
     3580       b1-qnty      = 0
     3581       b1-Summ     [tt#]    = 0
     3582       b1-Vat      [tt#]    = 0
     3583       b1-eff      [tt#]    = 0
     3584       b1-excise   [tt#]    = 0
     3585       b1-road-tax [tt#]    = 0
     3586       b1-transport[tt#]    = 0
     3587       b1-Other    [tt#]    = 0  .
     3588      End.
     3589    END PROCEDURE.
     3590   PROCEDURE Clear-B2  :
     3591   define variable tt#          as   int                 no-undo.
     3592   repeat tt# = 1 to 3 :
     3593    Assign
     3594       b2-qnty         = 0
     3595       b2-Summ        [tt#]  = 0
     3596       b2-Vat         [tt#]  = 0
     3597       b2-eff         [tt#]  = 0
     3598       b2-excise      [tt#]  = 0
     3599       b2-road-tax    [tt#]  = 0
     3600       b2-transport   [tt#]  = 0
     3601       b2-Other       [tt#]  = 0  .
     3602       End.
     3603   END PROCEDURE.
     3604   PROCEDURE Clear-Bi  :
     3605   define variable tt#          as   int                 no-undo.
     3606   repeat tt# = 1 to 3 :
     3607    Assign
     3608       bi-qnty         = 0
     3609       bi-Summ        [tt#]  = 0
     3610       bi-Vat         [tt#]  = 0
     3611       bi-eff         [tt#]  = 0
     3612       bi-excise      [tt#]  = 0
     3613       bi-road-tax    [tt#]  = 0
     3614       bi-transport   [tt#]  = 0
     3615       bi-Other       [tt#]  = 0  .
     3616       End.
     3617   END PROCEDURE.
