      154   procedure create_obj-list :
      155      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      156      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      157      do
      158      on error undo, return error return-value
      159      :
      160         define buffer cli-obj for ub.clients .
      161         define variable p-var as integer no-undo .
      162         define buffer buf_obj-list for obj-list .
      163         find last buf_obj-list  use-index pi no-error .
      164         if available buf_obj-list
      165         then
      166            p-var = buf_obj-list.obj-id + 1.
      167         else
      168            p-var = 1.
      169         find first cli-obj where
      170                   cli-obj.obj-type = p-obj-type
      171               and cli-obj.obj-code = p-obj-code
      172         no-lock no-error.
      173         if available cli-obj
      174         then do:
      175            create buf_obj-list.
      176            assign
      177               buf_obj-list.obj-id   = p-var
      178               buf_obj-list.obj-code = cli-obj.obj-code
      179               buf_obj-list.obj-type = cli-obj.obj-type
      180               buf_obj-list.obj-name = cli-obj.obj-name
      181               buf_obj-list.db-num   = cli-obj.db-num
      182            .
      183         end.
      184      end.
      185   end.
