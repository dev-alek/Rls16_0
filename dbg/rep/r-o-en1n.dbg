     3014   PROCEDURE CalcItog :
     3015       run ostatok (
     3016           input x-store-code  ,
     3017           input x-store-type  , x-TOG-Shift,
     3018           input x-date-start - 1 ,
     3019           input date('')      ,  x-Shift-Start,x-Shift-End,
     3020           input 'crsa':U   ,
     3021           input '##,##':U,
     3022           input xTog-obj ,
     3023           output  Quantity1  ,
     3024           output  Coast_R1   ,
     3025           output  Coast_V1   ,
     3026           output  VAT_R1     ,
     3027           output  VAT_V1     ,
     3028           output  Fact-order-1 ).
     3029       run ostatok (
     3030           input x-store-code  ,
     3031           input x-store-type  , x-TOG-Shift,
     3032           input x-date-start  ,
     3033           input x-date-end    , x-Shift-Start,x-Shift-End,
     3034           input 'crsa':U   ,
     3035           input '##,##':U,
     3036           input xTog-obj ,
     3037           output  Quantity1  ,
     3038           output  Coast_R1   ,
     3039           output  Coast_V1   ,
     3040           output  VAT_R1     ,
     3041           output  VAT_V1     ,
     3042           output  Fact-order-2 ).
     3043             Quantity1  = 0.
     3044             Coast_R1   = 0.
     3045             Coast_V1   = 0.
     3046             VAT_R1     = 0.
     3047             VAT_V1     = 0.
     3048   END PROCEDURE.
     3049   PROCEDURE display-str1  :
     3050   define variable jjj as integer no-undo init 0.
     3051   if show-cost and show-sale then
     3052      assign
     3053         eff[1] = Summ[3]  - Summ[1]
     3054         eff[3] = if Summ[1] <> 0 then ((Summ[3]  - Summ[1]) * 100 / Summ[1] )  else 0
     3055       .
     3056              if show-cost then DO:  Run di (1,"учет", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").  jjj = jjj + 1. End.
     3057              if show-crsa then DO:
     3058                if jjj = 0
     3059                   then   Run di (2,"прод", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3060                   Else   Run di (2,"прод", 1, "","","","","").
     3061                  jjj = jjj + 1. End.
     3062              if show-sale then DO:  if jjj = 0
     3063                 then Run di (3,"док.", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3064                 Else Run di (3,"док.", 1, "","","","","").
     3065                 jjj = jjj + 1. End.
     3066   END PROCEDURE.
     3067   PROCEDURE display-Bi  :
     3068   if show-cost and show-sale then
     3069      assign
     3070         bi-eff[1] = bi-Summ [3]  - bi-Summ  [1]
     3071         bi-eff[3] = if bi-Summ  [1] <> 0 then ((bi-Summ [3]  - bi-Summ  [1]) * 100 / bi-Summ  [1] )
     3072                                   else 0
     3073       .
     3074              if show-cost then run di(1,"учет",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3075              if show-crsa then run di(2,"прод",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3076              if show-sale then run di(3,"док.",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3077   END PROCEDURE.
     3078   PROCEDURE display-B1  :
     3079   IF  NOT (NOT Show-Negativ  AND
     3080    (
     3081   b1-qnty     [1]    = 0 and  b1-qnty     [2]    = 0 and b1-qnty     [3]    = 0  and
     3082   b1-Summ     [1]    = 0 and  b1-Summ     [2]    = 0 and  b1-Summ     [3]    = 0 and
     3083   b1-Vat      [1]    = 0 and  b1-Vat      [2]    = 0 and  b1-Vat      [3]    = 0 and
     3084   b1-excise   [1]    = 0 and  b1-excise   [2]    = 0 and  b1-excise   [3]    = 0 and
     3085   b1-road-tax [1]    = 0 and  b1-road-tax [2]    = 0 and  b1-road-tax [3]    = 0 and
     3086   b1-transport[1]    = 0 and  b1-transport[2]    = 0 and  b1-transport[3]    = 0 and
     3087   b1-Other    [1]    = 0 and  b1-Other    [2]    = 0 and  b1-Other    [3]    = 0 )) Then DO:
     3088     if Sums-Only THEN do:
     3089         if fr0 = true then do:
     3090             PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     3091             if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     3092             fr0 = false .
     3093           end.
     3094       end.
     3095       assign
     3096        gds-zap-artic = "Итого"
     3097        gds-zap-gds-name = temp-str
     3098       .
     3099           if show-cost and show-sale then
     3100             assign
     3101                 b1-eff[1] = b1-Summ [3]  - b1-Summ  [1]
     3102                 b1-eff[3] = if b1-Summ  [1] <> 0 then ((b1-Summ [3]  - b1-Summ  [1]) * 100 / b1-Summ  [1] )
     3103                                           else 0
     3104               .
     3105            if show-cost then  Run di(1,"учет"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3106            if show-crsa then  Run di(2,"прод"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3107            if show-sale then  Run di(3,"док."  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3108     Run u-line.
     3109     End.
     3110   END PROCEDURE.
     3111   PROCEDURE display-B2  :
     3112   IF  NOT (NOT Show-Negativ  AND
     3113     ( b2-qnty     [1]    = 0 and  b2-qnty     [2]    = 0 and  b2-qnty     [3]    = 0 and
     3114       b2-Summ     [1]    = 0 and  b2-Summ     [2]    = 0 and  b2-Summ     [3]    = 0 and
     3115       b2-Vat      [1]    = 0 and  b2-Vat      [2]    = 0 and  b2-Vat      [3]    = 0 and
     3116       b2-excise   [1]    = 0 and  b2-excise   [2]    = 0 and  b2-excise   [3]    = 0 and
     3117       b2-road-tax [1]    = 0 and  b2-road-tax [2]    = 0 and  b2-road-tax [3]    = 0 and
     3118       b2-transport[1]    = 0 and  b2-transport[2]    = 0 and  b2-transport[3]    = 0 and
     3119       b2-Other    [1]    = 0 and  b2-Other    [2]    = 0 and  b2-Other    [3]    = 0 ) )Then dO:
     3120       assign
     3121        gds-zap-artic = ""
     3122        gds-zap-gds-name = tmp#stroka0
     3123       .
     3124           if show-cost and show-sale then
     3125           assign
     3126               b2-eff[1] = b2-Summ [3]  - b2-Summ  [1]
     3127               b2-eff[3] = if b2-Summ  [1] <> 0 then ((b2-Summ [3]  - b2-Summ  [1]) * 100 / b2-Summ  [1] )
     3128                                         else 0
     3129             .
     3130          if show-cost then  Run di (1, "учет", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3131          if show-crsa then  Run di (2, "прод", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3132          if show-sale then  Run di (3, "док.", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3133          Run u-line.
     3134   end.
     3135   END PROCEDURE.
     3136   PROCEDURE Clear--B1  :
