     4474           assign
     4475               t-doc-line.vat-pc = v-vat-pc
     4476               t-doc-line.slt-pc = v-slt-pc
     4477           .
     4478          FIND bar-code WHERE bar-code.gds-code = goods.gds-code
     4479                          AND bar-code.unit-cli = goods.unit-base
     4480                          AND bar-code.node-code = gds-dtl.prt-code
     4481                          AND bar-code.part-code = ""
     4482                          AND bar-code.in-code = ""
     4483                              NO-LOCK no-error.
