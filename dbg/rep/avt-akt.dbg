      934   define variable v-torgconf-consignee-name       as character    no-undo.
      935   define variable v-torgconf-supplier-addr        as character    no-undo.
      936   define variable v-torgconf-saler-addr           as character    no-undo.
      937   define variable v-torgconf-consignee-addr       as character    no-undo.
      938   define variable v-torgconf-supplier-inn         as character    no-undo.
      939   define variable v-torgconf-saler-inn            as character    no-undo.
      940   define variable v-torgconf-consignee-inn        as character    no-undo.
      941   define variable v-torgconf-supplier-kpp         as character    no-undo.
      942   define variable v-torgconf-saler-kpp            as character    no-undo.
      943   define variable v-torgconf-consignee-kpp        as character    no-undo.
      944   define variable v-torgconf-plat-rasch-doc       as character    no-undo.
      945   define variable v-torgconf-main-boss            as character    no-undo.
      946   define variable v-torgconf-main-buh             as character    no-undo.
      947   define variable v-torgconf-reason               as character    no-undo.
      948   define variable v-torgconf-sf-buyer-name        as character    no-undo.
      949   define variable v-torgconf-sf-buyer-code        as character    no-undo.
      950   define variable v-torgconf-sf-buyer-type        as character    no-undo.
      951   define variable v-torgconf-sf-buyer-addr        as character    no-undo.
      952   define variable v-torgconf-wth-cargo-to         as character    no-undo.
      953   define variable p-torgconf-date-warrant         as date      no-undo.
      954   define variable p-torgconf-N-warrant            as character no-undo.
      955   define variable p-torgconf-accept-fname         as character no-undo.
      956   define variable p-torgconf-accept-position      as character no-undo.
      957   define variable p-torgconf-t_pass-fname         as character no-undo.
      958   define variable p-torgconf-t_pass-position      as character no-undo.
      959   define variable p-torgconf-nfindoc              as character no-undo.
      960   define variable p-torgconf-ndovwho              as character no-undo.
      961   define variable p-torgconf-ddog                 as date      no-undo.
      962   define variable p-torgconf-ndog                 as character no-undo.
      963   define variable v-torgconf-vdoc-code            as character no-undo.
      964   define variable v-doc-code-attr                 as character no-undo.
      965   define variable v-torgconf-doc-date-attr        as character no-undo.
      966   define variable v-torgconf-vdoc-date            as character no-undo.
      967   define variable v-torgconf-main-boss-post       as character no-undo.
      968   define variable v-torgconf-ogr-name             as character no-undo.
      969   define variable v-torgconf-ogr-post             as character no-undo.
      970   define variable v-name                          as character    no-undo.
      971   define variable v-form-name    as character    no-undo.
      972   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      973   procedure wthcattr-sprcli :
      974   define input parameter parparentproc  as widget-handle no-undo.
      975   define input parameter p-mode  as character no-undo.
      976   define input-output parameter p-value as character no-undo .
      977   define output parameter p-setted as logical no-undo .
      978     DEFINE VARIABLE v-value as character no-undo .
      979     define variable v-cli-type as character no-undo .
      980     define variable v-cli-code as integer no-undo .
      981     define buffer buf_clients   for ub.clients.
      982     define variable v_rid as character no-undo.
      983     define variable ref-rec as recid no-undo .
      984     do
      985     on error undo, return error
      986     :
      987         v-value = p-value.
      988      if p-value <> '':U then do:
      989       assign
      990       v-cli-type = substring(p-value, 1, 3)
      991       v-cli-code = integer(substring(p-value, 4))
      992       no-error.
      993       if error-status:error then do:
      994         assign
      995         v-cli-type = '':U
      996         v-cli-code = 0
      997         .
      998       end.
      999      end.
     1000      FIND FIRST buf_clients NO-LOCK WHERE
     1001               buf_clients.obj-type = v-cli-type AND
     1002               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1003      IF available(buf_clients) then do:
     1004       run ref/cli-all.w (
     1005                   input parparentproc
     1006                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1007                  ,input v-cli-type
     1008                  ,input 'все':U
     1009                  ,input 'все':U
     1010                  ,input RECID( buf_clients )
     1011                  ,input ",,,,,,NO"
     1012                  ,input ?
     1013                  ,OUTPUT v_rid ).
     1014     END.
     1015     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1016       run ref/cli-all.w (
     1017                    input parparentproc
     1018                   ,INPUT "b-sel":U
     1019                  ,input  v-cli-type
     1020                  ,input 'все':U
     1021                  ,input 'текущие':U
     1022                  ,input ?
     1023                  ,input ",,,,,,NO"
     1024                  ,input ?
     1025                  ,OUTPUT v_rid ).
     1026     END.
     1027     else do:
     1028       message
     1029       if p-value = "":U then 'Атрибут не задан!'
     1030       else substitute('Не найден клиент &1',p-value)
     1031       view-as alert-box warning.
     1032     end.
     1033     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1034       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1035       IF ERROR-STATUS:ERROR THEN DO:
     1036           RETURN NO-APPLY.
     1037       END.
     1038       FIND FIRST buf_clients NO-LOCK WHERE
     1039                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1040       IF AVAIL buf_clients THEN DO:
     1041         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1042       end.
     1043     end.
     1044     if v-value <> p-value then do:
     1045       p-value = v-value.
     1046       p-setted = yes.
     1047     end.
     1048     end.
     1049   end procedure.
     1050     define new global shared variable g#wthcalib as handle no-undo.
     1051   procedure torgconf-read :
