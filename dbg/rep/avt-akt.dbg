     3528                  v-torgconf-ogr-post = buf_person.position.
     3529               end.
     3530               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3531               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3532            end.
     3533      end.
     3534   end.
     3535   end procedure.
     3536   procedure torgconf-get-outogr-param:
     3537       define input parameter p-form-name  as character    no-undo.
     3538       define input parameter p-host-code  as integer      no-undo.
     3539       define input parameter p-obj-type   as character    no-undo.
     3540       define input parameter p-obj-code   as integer      no-undo.
     3541       define input parameter p-doc-code   as character      no-undo.
     3542       define buffer buf_firm          for ub.firm .
     3543       define buffer buf_clients       for ub.clients .
     3544       define buffer buf_sysconf       for ub.sysconf .
     3545       define buffer buf_shop          for ub.shop .
     3546       define buffer buf_store         for ub.store .
     3547       define buffer buf_person        for ub.person .
     3548       define buffer buf_trn-doc       for ub.trn-doc .
     3549       define buffer buf_wth-doc       for ub.wth-doc .
     3550      if  p-form-name <> 'wthtrg12':U
     3551      and p-form-name <> 'wthfct':U
     3552      and p-form-name <> 'wthm11':U
     3553      then do:
     3554       find first buf_trn-doc no-lock
     3555       where buf_trn-doc.doc-code = p-doc-code
     3556       no-error.
     3557       if v-torgconf-outogr = "no_print"
     3558         then do:
     3559            assign
     3560               v-torgconf-ogr-name = ""
     3561               v-torgconf-ogr-post = ""
     3562            .
     3563         end.
     3564      if v-torgconf-outogr  = "ruk_firm"
     3565            then do:
     3566            find first buf_sysconf no-lock
     3567            where buf_sysconf.host-code = p-host-code
     3568            no-error.
     3569            if available buf_sysconf
     3570            then do:
     3571               assign
     3572                  v-torgconf-ogr-post = buf_sysconf.head-position
     3573               .
     3574            end.
     3575            find first buf_clients no-lock
     3576                where buf_clients.obj-type = 'орг':U
     3577                and buf_clients.obj-code = p-host-code
     3578            .
     3579            find first buf_firm no-lock
     3580                where buf_firm.firm-code = buf_clients.obj-code
     3581            .
     3582            assign
     3583                v-torgconf-ogr-name = buf_firm.director
     3584            .
     3585         end.
     3586         if v-torgconf-outogr = "dir_obj"
     3587            then do:
     3588            find first buf_trn-doc no-lock
     3589            where buf_trn-doc.doc-code = p-doc-code
     3590            no-error.
     3591               CASE buf_trn-doc.obj-type:
     3592               WHEN 'маг':U
     3593               THEN DO:
     3594                  find first buf_shop no-lock
     3595                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3596                  .
     3597                  assign
     3598                     v-torgconf-ogr-name = buf_shop.director
     3599                     v-torgconf-ogr-post = "Директор"
     3600                  .
     3601               END.
     3602               WHEN 'скл':U
     3603               THEN DO:
     3604                  find first buf_store no-lock
     3605                  where buf_store.obj-code = buf_trn-doc.obj-code
     3606                  .
     3607                  assign
     3608                     v-torgconf-ogr-name = buf_store.store-boss
     3609                     v-torgconf-ogr-post = "Директор"
     3610                  .
     3611               END.
     3612               OTHERWISE DO:
     3613                  assign
     3614                     v-torgconf-ogr-name = "":U
     3615                     v-torgconf-ogr-post = "":U
     3616                  .
     3617               END.
     3618               END CASE.
     3619            end.
     3620      if v-torgconf-outogr = "manag_doc"
     3621         then do:
     3622            find first buf_trn-doc no-lock
     3623            where buf_trn-doc.doc-code = p-doc-code
     3624            no-error.
     3625            if available buf_trn-doc
     3626            then do:
     3627               run rep/get-psn.p
     3628               (input buf_trn-doc.boss
     3629               ,output v-torgconf-ogr-name
     3630               ) .
     3631            end.
     3632            find first buf_person no-lock
     3633            where buf_person.psn-code = buf_trn-doc.boss
     3634            no-error.
     3635            if available buf_person
     3636            then do:
     3637               v-torgconf-ogr-post = buf_person.position.
     3638            end.
     3639            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3640            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3641         end.
     3642      end.
     3643      else do:
     3644      find first buf_wth-doc no-lock
     3645         where buf_wth-doc.doc-code = p-doc-code
     3646         no-error.
     3647         if v-torgconf-outogr = "no_print"
     3648            then do:
     3649               assign
     3650                  v-torgconf-ogr-name = ""
     3651                  v-torgconf-ogr-post = ""
     3652               .
     3653            end.
     3654         if v-torgconf-outogr  = "ruk_firm"
     3655               then do:
     3656               find first buf_sysconf no-lock
     3657               where buf_sysconf.host-code = p-host-code
     3658               no-error.
     3659               if available buf_sysconf
     3660               then do:
     3661                  assign
     3662                     v-torgconf-ogr-post = buf_sysconf.head-position
     3663                  .
     3664               end.
     3665               find first buf_clients no-lock
     3666                  where buf_clients.obj-type = 'орг':U
     3667                  and buf_clients.obj-code = p-host-code
     3668               .
     3669               find first buf_firm no-lock
     3670                  where buf_firm.firm-code = buf_clients.obj-code
     3671               .
     3672               assign
     3673                  v-torgconf-ogr-name = buf_firm.director
     3674               .
     3675            end.
     3676            if v-torgconf-outogr = "dir_obj"
     3677               then do:
     3678               find first buf_wth-doc no-lock
     3679               where buf_wth-doc.doc-code = p-doc-code
     3680               no-error.
     3681                  find first buf_shop no-lock
     3682                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3683                  .
     3684                  assign
     3685                     v-torgconf-ogr-name = buf_shop.director
     3686                     v-torgconf-ogr-post = "Директор"
     3687                  .
     3688               end.
     3689         if v-torgconf-outogr = "manag_doc"
     3690            then do:
     3691               find first buf_wth-doc no-lock
     3692               where buf_wth-doc.doc-code = p-doc-code
     3693               no-error.
     3694               if available buf_wth-doc
     3695               then do:
     3696                  run rep/get-psn.p
     3697                  (input buf_wth-doc.deliver
     3698                  ,output v-torgconf-ogr-name
     3699                  ) .
     3700               end.
     3701               find first buf_person no-lock
     3702               where buf_person.psn-code = buf_wth-doc.deliver
     3703               no-error.
     3704               if available buf_person
     3705               then do:
     3706                  v-torgconf-ogr-post = buf_person.position.
     3707               end.
     3708               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3709               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3710            end.
     3711      end.
     3712   end.
     3713   procedure torgconf-get-reason  :
     3714   define input parameter  p-doc-code       as character        no-undo.
     3715   define input parameter  p-reason-code    as integer          no-undo .
     3716   define input parameter  p-doc-type       as character        no-undo.
     3717       if p-reason-code > 0
     3718       then do:
     3719           define buffer buf_trn-reason for ub.trn-reason.
     3720           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3721           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3722       end.
     3723       else do:
     3724           if p-doc-type = 'при':U
     3725           then  do:
     3726               define variable v-attr-type     as character    no-undo.
     3727               define variable v-attr-value    as character    no-undo.
     3728               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3729               assign v-torgconf-reason = v-attr-value .
     3730               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3731               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3732           end.
     3733       end.
     3734   end procedure.
     3735   def buffer t-doc for trn-doc.
     3736   define buffer buf_clients for ub.clients.
     3737   def temp-table t-doc-line no-undo like doc-line.
     3738   define shared variable sort-name    as logical          no-undo.
     3739   define temp-table tt-tax no-undo
