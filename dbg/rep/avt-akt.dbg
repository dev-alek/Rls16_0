      399   define variable v-fmtcli-schet-exists  as logical      no-undo.
      400   define variable v-fmtcli-bank-exists   as logical      no-undo.
      401   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      402   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      403   define variable v-fmtcli-bank-bik      as character    no-undo.
      404   define variable v-fmtcli-bank-name     as character    no-undo.
      405   define variable v-fmtcli-bank-addres   as character    no-undo.
      406   define variable v-fmtcli-bank-city     as character    no-undo.
      407   procedure fmtcli-get-bank :
      408   define input parameter p-host-code      as integer          no-undo.
      409   define input parameter p-obj-type       as character        no-undo.
      410   define input parameter p-obj-code       as integer          no-undo.
      411   define input parameter p-curr-code      as integer          no-undo.
      412       define buffer buf_fin-schet     for ub.fin-schet.
      413       define buffer buf_fin-bank      for ub.fin-bank.
      414   do
      415   for buf_fin-schet
      416     , buf_fin-bank
      417   on error undo, return error
      418   :
      419       assign
      420           v-fmtcli-schet-exists       = no
      421           v-fmtcli-bank-exists        = no
      422           v-fmtcli-bank-r-schet       = "":U
      423           v-fmtcli-bank-c-schet       = "":U
      424           v-fmtcli-bank-bik           = "":U
      425           v-fmtcli-bank-name          = "":U
      426           v-fmtcli-bank-addres        = "":U
      427           v-fmtcli-bank-city          = "":U
      428       .
      429       search-for-schet:
      430       for each buf_fin-schet no-lock
      431          where buf_fin-schet.host-code = p-host-code
      432            and buf_fin-schet.cli-type  = p-obj-type
      433            and buf_fin-schet.cli-code  = p-obj-code
      434            and buf_fin-schet.curr-code = p-curr-code
      435       on error undo, return error
      436       :
      437           if buf_fin-schet.status_   = 'удал':U
      438           then do:
      439           end.
      440           else do:
      441               assign
      442                   v-fmtcli-schet-exists   = yes
      443                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      444                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      445               .
      446               find first buf_fin-bank no-lock
      447                    where buf_fin-bank.host-code = p-host-code
      448                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      449               no-error.
      450               if available buf_fin-bank
      451               then do:
      452                   assign
      453                       v-fmtcli-bank-exists      = yes
      454                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      455                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      456                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      457                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      458                   .
      459               end.
      460               else do:
      461                   assign
      462                       v-fmtcli-bank-exists    = no
      463                       v-fmtcli-bank-bik       = "":U
      464                       v-fmtcli-bank-name      = "":U
      465                       v-fmtcli-bank-addres    = "":U
      466                       v-fmtcli-bank-city      = "":U
      467                   .
      468               end.
      469               leave search-for-schet.
      470           end.
      471       end.
      472   end.
      473   end procedure.
      474   procedure fmtcli-get-client :
      475   define input parameter p-obj-type       as character    no-undo.
      476   define input parameter p-obj-code       as integer      no-undo.
      477       define variable v-temp-fmtcli-address      as character     no-undo.
      478       define variable v-num-country-city    as integer      no-undo.
      479       define buffer buf_clients   for ub.clients.
      480       define buffer buf_firm      for ub.firm.
      481       define buffer buf_store     for ub.store.
      482       define buffer buf_shop      for ub.shop.
      483       define buffer buf_person    for ub.person.
      484   do
      485   for buf_clients
      486     , buf_firm
      487     , buf_store
      488     , buf_shop
      489     , buf_person
      490   on error undo, return error
      491   :
      492       assign
      493           v-fmtcli-name           = "":U
      494           v-fmtcli-addres         = "":U
      495           v-fmtcli-post-addres    = "":U
      496           v-fmtcli-full-addres    = "":U
      497           v-fmtcli-phone          = "":U
      498           v-fmtcli-inn            = "":U
      499           v-fmtcli-kpp            = "":U
      500           v-fmtcli-okpo           = "":U
      501           v-fmtcli-city           = "":U
      502           v-fmtcli-index          = "":U
      503           v-fmtcli-country        = "":U
      504       .
      505       find first buf_clients no-lock
      506            where buf_clients.obj-type = p-obj-type
      507              and buf_clients.obj-code = p-obj-code
      508       .
      509       assign
      510           v-fmtcli-name = buf_clients.obj-name
      511       .
      512       case buf_clients.obj-type:
      513          when 'орг':U
      514          then do:
      515               find first buf_firm no-lock
      516                    where buf_firm.firm-code = buf_clients.obj-code
      517                    no-error
      518               .
      519               if available buf_firm
      520               then do:
      521                   assign
      522                       v-num-country-city = num-entries( buf_firm.city )
      523                       v-fmtcli-engl-name = buf_firm.engl-name
      524                   .
      525                   if v-num-country-city > 0
      526                   then do:
      527                       assign
      528                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      529                       .
      530                   end.
      531                   if v-num-country-city > 1
      532                   then do:
      533                       assign
      534                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      535                       .
      536                   end.
      537                   run fmtcli-concatenate-strings in this-procedure (
      538                         input v-fmtcli-full-addres
      539                       , input v-fmtcli-country
      540                       , input ", ":U
      541                       , input 50
      542                       , output v-fmtcli-full-addres
      543                   ).
      544                   run fmtcli-concatenate-strings in this-procedure (
      545                         input v-fmtcli-full-addres
      546                       , input v-fmtcli-city
      547                       , input ", ":U
      548                       , input 50
      549                       , output v-fmtcli-full-addres
      550                   ).
      551                   run fmtcli-concatenate-strings in this-procedure (
      552                         input v-fmtcli-full-addres
      553                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      554                       , input ", ":U
      555                       , input 50
      556                       , output v-fmtcli-full-addres
      557                   ).
      558                   run fmtcli-concatenate-strings in this-procedure (
      559                         input v-fmtcli-post-addres
      560                       , input v-fmtcli-country
      561                       , input ", ":U
      562                       , input 50
      563                       , output v-fmtcli-post-addres
      564                   ).
      565                   run fmtcli-concatenate-strings in this-procedure (
      566                         input v-fmtcli-post-addres
      567                       , input v-fmtcli-city
      568                       , input ", ":U
      569                       , input 50
      570                       , output v-fmtcli-post-addres
      571                   ).
      572                   run fmtcli-concatenate-strings in this-procedure (
      573                         input v-fmtcli-post-addres
      574                       , input string( buf_firm.ind )
      575                       , input ", ":U
      576                       , input 50
      577                       , output v-fmtcli-post-addres
      578                   ).
      579                   run fmtcli-concatenate-strings in this-procedure (
      580                         input substring( buf_firm.addres1, 1, 50 )
      581                       , input buf_firm.addres2
      582                       , input " ":U
      583                       , input 50
      584                       , output v-temp-fmtcli-address
      585                   ).
      586                   run fmtcli-concatenate-strings in this-procedure (
      587                         input v-temp-fmtcli-address
      588                       , input substring( buf_firm.addres1, 51, 50 )
      589                       , input " ":U
      590                       , input 50
      591                       , output v-temp-fmtcli-address
      592                   ).
      593                   run fmtcli-concatenate-strings in this-procedure (
      594                         input v-temp-fmtcli-address
      595                       , input substring( buf_firm.addres1, 101, 50 )
      596                       , input " ":U
      597                       , input 50
      598                       , output v-temp-fmtcli-address
      599                   ).
      600                   assign
      601                       v-fmtcli-addres = v-temp-fmtcli-address
      602                   .
      603                   if buf_firm.addres1 <> ?
      604                   then do:
      605                       run fmtcli-concatenate-strings in this-procedure (
      606                             input v-fmtcli-full-addres
      607                           , input v-fmtcli-addres
      608                           , input ", ":U
      609                           , input 0
      610                           , output v-fmtcli-full-addres
      611                       ).
      612                   end.
      613                   run fmtcli-concatenate-strings in this-procedure (
      614                         input substring( buf_firm.post-addr1, 1, 50 )
      615                       , input buf_firm.post-addr2
      616                       , input " ":U
      617                       , input 50
      618                       , output v-fmtcli-post-addres
      619                   ).
      620                   run fmtcli-concatenate-strings in this-procedure (
      621                         input v-fmtcli-post-addres
      622                       , input substring( buf_firm.post-addr1, 51, 50 )
      623                       , input " ":U
      624                       , input 50
      625                       , output v-fmtcli-post-addres
      626                   ).
      627                   run fmtcli-concatenate-strings in this-procedure (
      628                         input v-fmtcli-post-addres
      629                       , input substring( buf_firm.post-addr1, 101, 50 )
      630                       , input " ":U
      631                       , input 50
      632                       , output v-fmtcli-post-addres
      633                   ).
      634                   assign
      635                       v-fmtcli-phone         = buf_firm.phone
      636                       v-fmtcli-inn           = buf_firm.inn
      637                       v-fmtcli-kpp           = buf_firm.kpp
      638                       v-fmtcli-okpo          = buf_firm.okpo
      639                       v-fmtcli-index         = string( buf_firm.ind )
      640                   .
      641               end.
      642          end.
      643          when 'маг':U
      644          then do:
      645               find first buf_shop no-lock
      646                    where buf_shop.obj-code = buf_clients.obj-code
      647               .
      648               if available buf_shop
      649               then do:
      650                   run fmtcli-concatenate-strings in this-procedure (
      651                         input buf_shop.addres1
      652                       , input buf_shop.addres2
      653                       , input " ":U
      654                       , input 50
      655                       , output v-fmtcli-addres
      656                   ).
      657                   assign
      658                       v-fmtcli-full-addres = v-fmtcli-addres
      659                       v-fmtcli-post-addres = v-fmtcli-addres
      660                       v-fmtcli-phone       = buf_shop.phone
      661                       v-fmtcli-inn         = "":U
      662                       v-fmtcli-kpp         = "":U
      663                       v-fmtcli-okpo        = "":U
      664                       v-fmtcli-city        = "":U
      665                       v-fmtcli-index       = "":U
      666                   .
      667               end.
      668          end.
      669          when 'скл':U
      670          then do:
      671               find first buf_store no-lock
      672                    where buf_store.obj-code = buf_clients.obj-code
      673               .
      674               if available buf_store
      675               then do:
      676                   run fmtcli-concatenate-strings in this-procedure (
      677                         input buf_store.addres1
      678                       , input buf_store.addres2
      679                       , input " ":U
      680                       , input 50
      681                       , output v-fmtcli-addres
      682                   ).
      683                   assign
      684                       v-fmtcli-full-addres = v-fmtcli-addres
      685                       v-fmtcli-phone       = buf_store.phone
      686                       v-fmtcli-inn         = "":U
      687                       v-fmtcli-kpp         = "":U
      688                       v-fmtcli-okpo        = "":U
      689                       v-fmtcli-city        = "":U
      690                       v-fmtcli-index       = "":U
      691                   .
      692               end.
      693          end.
      694          when 'чел':U
      695          then do:
      696               find first buf_person no-lock
      697                    where buf_person.psn-code = buf_clients.obj-code
      698               .
      699               if available buf_person
      700               then do:
      701                   run fmtcli-concatenate-strings in this-procedure (
      702                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      703                                 then "":U
      704                                 else string( buf_person.ind, "999999")
      705                                 )
      706                       , input buf_person.city
      707                       , input ", ":U
      708                       , input 0
      709                       , output v-fmtcli-full-addres
      710                   ).
      711                   assign
      712                       v-fmtcli-addres = buf_person.address
      713                   .
      714                   run fmtcli-concatenate-strings in this-procedure (
      715                         input v-fmtcli-full-addres
      716                       , input v-fmtcli-addres
      717                       , input ", ":U
      718                       , input 0
      719                       , output v-fmtcli-full-addres
      720                   ).
      721                   assign
      722                       v-fmtcli-phone     = buf_person.phone1
      723                       v-fmtcli-inn       = buf_person.inn
      724                       v-fmtcli-kpp       = buf_person.kpp
      725                       v-fmtcli-okpo      = buf_person.okpo
      726                       v-fmtcli-city      = buf_person.city
      727                       v-fmtcli-index     = string( buf_person.ind )
      728                   .
      729               end.
      730          end.
      731       end case.
      732   end.
      733   end procedure.
      734   procedure fmtcli-concatenate-strings :
      735   define input parameter p-string-1       as character        no-undo.
      736   define input parameter p-string-2       as character        no-undo.
      737   define input parameter p-delimiter      as character        no-undo.
      738   define input parameter p-length         as integer          no-undo.
      739   define output parameter p-out-string    as character        no-undo.
      740   do
      741   on error undo, return error
      742   :
      743       assign
      744           p-out-string = ( if p-string-1 = ?
      745                            then "":U
      746                            else trim( p-string-1 ) )
      747       .
      748       assign
      749           p-out-string = p-out-string
      750                        + ( if p-out-string = "":U
      751                            or length( p-out-string ) = p-length
      752                            or p-string-2 = ?
      753                            or trim( p-string-2 ) = "":U
      754                            then "":U
      755                            else p-delimiter )
      756                        + ( if p-string-2 = ?
      757                            or trim( p-string-2 ) = "":U
      758                            then "":U
      759                            else trim( p-string-2 ) )
      760       .
      761   end.
      762   end procedure.
