     1194           if lookup( p-form-name, v-outnum  ) <> 0
     1195           then do:
     1196               assign
     1197                   v-torgconf-outnum   = yes
     1198               .
     1199           end.
     1200           if lookup( p-form-name, v-outprim ) <> 0
     1201           then do:
