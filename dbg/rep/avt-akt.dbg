     4234                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     4235                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     4236                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     4237                         .
     4238         end.
     4239         ASSIGN
     4240           road-tax-base-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4241           road-tax-rubl-loc   = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4242           transport-base-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4243           transport-rubl-loc  = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4244           other-base-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4245           other-rubl-loc      = if doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / doc-line.fact-qnty  else 0
     4246                                           vat-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     4247           slt-base-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     4248                   vat-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / doc-line.fact-qnty   else 0
     4249           slt-rubl-loc        = if doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / doc-line.fact-qnty   else 0
     4250           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     4251           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     4252         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     4253         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     4254         if transport-base-loc = ? then transport-base-loc = 0.
     4255         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     4256         if other-base-loc     = ? then other-base-loc     = 0.
     4257         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     4258         assign
     4259           transport-cli-loc      = 0
     4260           other-cli-loc          = 0
     4261           road-tax-cli-loc       = ?
     4262           vat-cli-loc            = ?
     4263           slt-cli-loc            = ?
     4264           price-cli-with-tax-loc = ?.
     4265      end.
     4266   ASSIGN
     4267             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     4268       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     4269   .
     4270               if road-tax-rubl-loc = ? then assign road-tax-rubl-loc = 0.
     4271               if road-tax-base-loc = ? then assign road-tax-base-loc = 0.
     4272               assign
     4273                   price-doc = ( if v-curr-r-b = 'base':U
     4274                                 then ( price-base-with-tax-loc - vat-base-loc )
     4275                                 else ( price-rubl-with-tax-loc - vat-rubl-loc ) )
     4276                   v-tax-sum = ( if v-curr-r-b = 'base':U
     4277                                 then road-tax-base-loc
     4278                                 else road-tax-rubl-loc )
     4279               .
     4280           end.
     4281           else do:
     4282               if v-curr-r-b = 'base':U
     4283               then do:
     4284                   assign
     4285                       price-doc = gds-dtl.price-base - (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - ub.doc-line.road-tax * 1 - (ub.gds-dtl.price-base - ub.gds-dtl.discnt-base - ub.doc-line.road-tax * 1)                           * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc))                           * ub.doc-line.VAT-pc / (100 + ub.doc-line.VAT-pc)
     4286                   .
     4287               end.
     4288               else do:
     4289                   assign
     4290                       price-doc = gds-dtl.price-rubl - (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - ub.doc-line.road-tax * 1 - (ub.gds-dtl.price-rubl - ub.gds-dtl.discnt-rubl - ub.doc-line.road-tax * 1)                           * ub.doc-line.SLT-pc / (100 + ub.doc-line.SLT-pc))                           * ub.doc-line.VAT-pc / (100 + ub.doc-line.VAT-pc)
     4291                   .
     4292               end.
     4293           end.
     4294           assign
     4295               Vat-gds = ( price-lst - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) - v-tax-sum) * t-doc-line.vat-pc / ( 100 + t-doc-line.vat-pc )
     4296               marg = price-lst - price-doc - Vat-gds - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc)
     4297           .
     4298           ACCUMULATE
     4299               bar-code.b-code ( COUNT )
     4300               gds-dtl.fact-qnty ( TOTAL )
     4301               marg * gds-dtl.fact-qnty ( TOTAL )
     4302               gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ( TOTAL )
     4303               gds-dtl.fact-qnty * VAT-gds ( TOTAL )
     4304               ( gds-dtl.fact-qnty * price-lst ) ( TOTAL )
     4305               ( gds-dtl.fact-qnty * price-doc ) ( TOTAL )
     4306           .
     4307           if v-curr-r-b = 'base':U
     4308           then do:
     4309               ACCUMULATE
     4310                   ( gds-dtl.fact-qnty * gds-dtl.price-base ) ( TOTAL )
     4311                   ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ( TOTAL )
     4312               .
     4313           end.
     4314           else do:
     4315               ACCUMULATE
     4316                   ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ( TOTAL )
     4317                   ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ( TOTAL )
     4318               .
     4319           end.
     4320           assign
     4321                delt = ( if v-curr-r-b = 'base':U
     4322                         then string( ( price-lst - gds-dtl.price-base ) / gds-dtl.price-base * 100, "->>>9.9" )
     4323                         else string( ( price-lst - gds-dtl.price-rubl ) / gds-dtl.price-rubl * 100, "->>>9.9" )
     4324                       ) + "%"
     4325           .
     4326           DISPLAY sym1
     4327                   trim( string( bar-code.b-code ) ) @ tb-code
     4328                   gds-dtl.artic
     4329                   goods.gds-name
     4330                   gds-dtl.fact-qnty
     4331                   price-doc
     4332                   ( gds-dtl.fact-qnty * price-doc ) @ sum-no-NDS
     4333                   ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) ) @ doc-sum
     4334                   price-lst
     4335                   ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     4336                   t-doc-line.vat-pc
     4337                   ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     4338                   string( string( marg / price-doc * 100, "->>>9.9" ) + "%" ) @ UpFact
     4339                   Delt
     4340                   sym2
     4341           .
     4342           IF LENGTH(goods.gds-name, "CHARACTER") > 33 and FullGdsName  THEN  do:
     4343             assign propis = SUBSTRING(goods.gds-name,34) .
     4344             DOWN 1 .
     4345             DISPLAY sym1 propis @ goods.gds-name  sym2     .
     4346           end.
     4347           find first tt-tax exclusive-lock
     4348             where tt-tax.vat-pc = t-doc-line.vat-pc
     4349           no-error .
     4350           if not available tt-tax
     4351           then do:
     4352             create tt-tax no-error .
     4353             assign
     4354               tt-tax.vat-pc = t-doc-line.vat-pc
     4355             .
     4356           end.
     4357           assign
     4358             tt-tax.sum-no-nds = tt-tax.sum-no-nds + ( gds-dtl.fact-qnty * price-doc )
     4359             tt-tax.doc-sum    = tt-tax.doc-sum    + ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) )
     4360             tt-tax.obj-sum    = tt-tax.obj-sum    + ( gds-dtl.fact-qnty * price-lst )
     4361             tt-tax.vat-sum    = tt-tax.vat-sum    + ( gds-dtl.fact-qnty * VAT-gds )
     4362             tt-tax.fact-qnty  = tt-tax.fact-qnty  + gds-dtl.fact-qnty
     4363           no-error .
     4364           if LAST( gds-dtl.artic ) then
     4365               do:
     4366                   DOWN 1 .
     4367                   PUT Line format "X(180)" SKIP .
     4368                   assign
     4369                       v-sum-cost-without-vat = ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )
     4370                       v-sum-sale             = ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst )
     4371                   .
     4372                   assign
     4373                       Delt = ( if v-curr-r-b = 'base':U
     4374                               then string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) )
     4375                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base ) ) * 100, "->>>9.9" ) + "%"
     4376                               else string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) )
     4377                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ) * 100, "->>>9.9" ) + "%"
     4378                              )
     4379                   .
     4380                   for each tt-tax
     4381                     by tt-tax.vat-pc
     4382                   :
     4383                     display
     4384                       substitute("  ИТОГО по НДС &1%", tt-tax.vat-pc ) @ goods.gds-name
     4385                       tt-tax.fact-qnty                                 @ gds-dtl.fact-qnty
     4386                       tt-tax.sum-no-nds                                @ sum-no-NDS
     4387                       tt-tax.doc-sum                                   @ doc-sum
     4388                       tt-tax.obj-sum                                   @ obj-sum
     4389                       tt-tax.vat-sum                                   @ VAT-sum
     4390                     with frame Akt.
     4391                     down 1 with frame Akt.
     4392                   end.
     4393                   DISPLAY "  ИТОГО"    @ goods.gds-name
     4394                       ACCUM TOTAL gds-dtl.fact-qnty @ gds-dtl.fact-qnty
     4395                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )   @ sum-no-NDS
     4396                       ( if v-curr-r-b = 'base':U
     4397                         then ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base )
     4398                         else ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl )
     4399                       )                                               @ doc-sum
     4400                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     4401                       ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     4402                       string( string( ( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ) /
     4403                                              ( ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc ) ) * 100, "->>>9.9" ) + "%" )
     4404                                       @ UpFact
     4405                       Delt .
     4406                   DOWN 2 .
     4407               end.
     4408   END.
     4409   if sort-name = yes then  FOR EACH doc-line WHERE doc-line.doc-code = t-doc.doc-code NO-LOCK ,
     4410           EACH gds-dtl WHERE gds-dtl.doc-code = t-doc.doc-code AND
     4411                                               gds-dtl.prod-type = doc-line.prod-type AND
     4412                                               gds-dtl.prod-code = doc-line.prod-code AND
     4413                                               gds-dtl.artic = doc-line.artic NO-LOCK,
     4414           EACH goods WHERE goods.prod-type = gds-dtl.prod-type AND
     4415                                              goods.prod-code = gds-dtl.prod-code AND
     4416                                              goods.artic = gds-dtl.artic NO-LOCK
     4417               BREAK BY goods.gds-name with frame akt-1 :
     4418   FOR EACH t-doc-line :
     4419             delete t-doc-line.
     4420          END.
     4421          CREATE t-doc-line.
     4422          BUFFER-COPY doc-line TO t-doc-line.
