     1086           v-torgconf-outdisc  = no
     1087           v-torgconf-outsubs  = no
     1088           v-torgconf-outrecv  = no
     1089           v-torgconf-outegrp  = no
     1090           v-torgconf-outt12   = no
     1091           v-torgconf-outappr  = no
     1092           v-torgconf-outrubl  = no
     1093           v-torgconf-outhold  = no
