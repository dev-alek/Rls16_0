     1728   define input parameter p-curr-code          as integer          no-undo.
     1729       define variable v-host-code    as integer      no-undo.
     1730   do
     1731   on error undo, return error
     1732   :
     1733       assign
     1734           v-torgconf-cli-type = p-obj-type
     1735           v-torgconf-cli-code = p-obj-code
     1736       .
     1737       run fmtcli-get-client in this-procedure (
     1738             input p-obj-type
     1739           , input p-obj-code
     1740       ).
     1741       assign
     1742           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1743           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1744           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1745           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1746           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1747           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1748           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1749           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1750       .
     1751      run fmtcli-get-bank in this-procedure (
     1752             input p-host-obj-code
     1753           , input p-obj-type
     1754           , input p-obj-code
     1755           , input p-curr-code
     1756       ).
     1757       assign
     1758           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1759           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1760           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1761           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1762           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1763           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1764           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1765           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1766       .
     1767   end.
     1768   end procedure.
     1769   procedure torgconf-get-ship-param :
     1770   define input parameter p-host-obj-code      as integer          no-undo.
     1771   define input parameter p-obj-type           as character        no-undo.
     1772   define input parameter p-obj-code           as integer          no-undo.
     1773   define input parameter p-curr-code          as integer          no-undo.
     1774       define variable v-host-code    as integer      no-undo.
     1775   do
     1776   on error undo, return error
     1777   :
     1778       assign
     1779           v-torgconf-ship-type = p-obj-type
     1780           v-torgconf-ship-code = p-obj-code
     1781       .
     1782       if trim(p-obj-type) = ""
     1783       and p-obj-code = 0
     1784       then do:
     1785       assign
     1786           v-torgconf-ship-name         = "":U
     1787           v-torgconf-ship-addres       = "":U
     1788           v-torgconf-ship-post-addres  = "":U
     1789           v-torgconf-ship-phone        = "":U
     1790           v-torgconf-ship-inn          = "":U
     1791           v-torgconf-ship-kpp          = "":U
     1792           v-torgconf-ship-okpo         = "":U
     1793       .
     1794       end.
     1795       else do:
     1796       run fmtcli-get-client in this-procedure (
     1797             input p-obj-type
     1798           , input p-obj-code
     1799       ).
     1800       assign
     1801           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1802           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1803           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1804           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1805           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1806           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1807           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1808           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1809       .
     1810       end.
     1811           run fmtcli-get-bank in this-procedure (
     1812             input p-host-obj-code
     1813           , input p-obj-type
     1814           , input p-obj-code
     1815           , input p-curr-code
     1816       ).
     1817       assign
     1818           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1819           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1820           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1821           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1822           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1823           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1824           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1825           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1826       .
     1827   end.
     1828   end procedure.
     1829   procedure torgconf-get-holdfirm-code :
     1830   define input parameter p-obj-type   as character        no-undo.
     1831   define input parameter p-obj-code   as integer          no-undo.
     1832   define output parameter p-firm-code as integer          no-undo.
     1833       define variable v-firm-code-str     as character    no-undo.
     1834       define variable v-par-type          as character    no-undo.
     1835       define buffer buf_clients       for ub.clients.
     1836   do
     1837   for buf_clients
     1838   on error undo, return error
     1839   :
     1840       run gbl/clntat-v.p (
     1841             input p-obj-type
     1842           , input p-obj-code
     1843           , input 'holdfirm-code':U
     1844           , output v-firm-code-str
     1845           , output v-par-type
     1846       ).
     1847       assign
     1848           p-firm-code = integer( v-firm-code-str )
     1849       no-error.
     1850       if error-status :error
     1851       then do:
     1852           message
     1853               "Неверно задан код фирмы для печати накладных."
     1854           view-as alert-box warning.
     1855           assign
     1856               p-firm-code = 0
     1857           .
     1858       end.
     1859       else do:
     1860           find first buf_clients no-lock
     1861                where buf_clients.obj-type = 'орг':U
     1862                  and buf_clients.obj-code = p-firm-code
     1863           no-error.
     1864           if not available buf_clients
     1865           then do:
     1866               message
     1867                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1868                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1869               view-as alert-box warning.
     1870               assign
     1871                   p-firm-code = 0
     1872               .
     1873           end.
     1874       end.
     1875   end.
     1876   end procedure.
     1877   procedure torgconf-get-post-head:
     1878   define input  parameter p-obj-type             as character        no-undo.
     1879   define input  parameter p-obj-code             as integer          no-undo.
     1880   define output parameter p-torgconf-post-head   as character        no-undo.
     1881      define variable v-host-code         as integer      no-undo.
     1882      define buffer buf_sysconf     for ub.sysconf.
     1883        assign
     1884         p-torgconf-post-head  = ""
     1885        .
     1886   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1887   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1888     (input  p-obj-type
     1889     ,input  p-obj-code
     1890     ,output v-host-code
     1891     )  .
     1892      find first buf_sysconf no-lock
     1893      where buf_sysconf.host-code = v-host-code
     1894      no-error.
     1895      if available buf_sysconf
     1896      then do:
     1897         assign
     1898            p-torgconf-post-head = buf_sysconf.head-position
     1899         .
     1900      end.
     1901   end procedure.
     1902   procedure torgconf-get-storekeeper:
     1903   define input  parameter p-wrkr                   as integer          no-undo.
     1904   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1905   define output parameter p-torgconf-post          as character        no-undo.
     1906      define buffer buf_sysconf     for ub.sysconf.
     1907      define buffer buf_person      for ub.person.
     1908      define buffer buf_shop        for ub.shop .
     1909      define buffer buf_store       for ub.store .
     1910      if v-torgconf-outC = "no_print"
     1911      then do:
     1912         assign p-torgconf-post = ""
     1913                p-torgconf-wrkr-name = ""
     1914                .
     1915      end.
     1916      if v-torgconf-outC = "clad_doc"
     1917      then do:
     1918         run rep/get-psn.p
     1919               (input  p-wrkr
     1920               ,output p-torgconf-wrkr-name
     1921               ) .
     1922         find first buf_person no-lock
     1923         where buf_person.psn-code = p-wrkr
     1924         no-error.
     1925         if available buf_person
     1926         then do:
     1927           p-torgconf-post = buf_person.position.
     1928         end.
     1929         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1930         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1931      end.
     1932      if v-torgconf-outC = "clad_obj"
     1933      then do:
     1934         CASE v-torgconf-self-obj-type:
     1935         WHEN 'маг':U
     1936         THEN DO:
     1937            find first buf_shop no-lock
     1938            where buf_shop.obj-code = v-torgconf-self-obj-code
     1939            .
     1940            assign
     1941               p-torgconf-wrkr-name = buf_shop.store-man
     1942               p-torgconf-post = ""
     1943            .
     1944            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1945         END.
     1946         WHEN 'скл':U
     1947         THEN DO:
     1948            find first buf_store no-lock
     1949            where buf_store.obj-code = v-torgconf-self-obj-code
     1950            .
     1951            assign
     1952               p-torgconf-wrkr-name = buf_store.store-man
     1953               p-torgconf-post = ""
     1954            .
     1955            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1956         END.
     1957         OTHERWISE DO:
     1958            assign
     1959               p-torgconf-post = "":U
     1960               p-torgconf-wrkr-name = "":U
     1961            .
     1962         END.
     1963         END CASE.
     1964      end.
     1965    end procedure.
     1966   procedure torgconf-get-form-header :
     1967   define input parameter p-for-inverse    as logical          no-undo.
     1968   define input parameter p-doc-code       as character        no-undo.
     1969   define input parameter p-print-doc      as logical          no-undo.
     1970   define input parameter p-doc-date       as date             no-undo.
     1971   define input parameter p-fact-date      as date             no-undo.
     1972   define input parameter p-doc-type       as character        no-undo.
     1973   define input parameter p-status_        as character        no-undo.
     1974   define input parameter p-reverse        as logical          no-undo.
     1975   define input parameter p-sf-par         as logical          no-undo.
     1976       define variable v-attr-type         as character    no-undo.
     1977       define variable v-doc-code-standard as logical      no-undo.
     1978       define variable v-doc-date-standard as logical      no-undo.
     1979       define variable v-par-consignee-addres  as character    no-undo.
     1980       define variable v-host-code         as integer      no-undo.
     1981       define variable v-dcode-attr        as character    no-undo.
     1982       define variable v-ddate-attr        as character    no-undo.
     1983       define variable v-doc-date          as character    no-undo.
     1984       define variable v-doc-code          as character    no-undo.
     1985       define variable v-par-type          as character    no-undo.
     1986       define variable v-attr              as character    no-undo.
     1987       define buffer buf_firm          for ub.firm .
     1988       define buffer buf_clients       for ub.clients .
     1989       define buffer buf_sysconf       for ub.sysconf .
     1990       define buffer buf_shop          for ub.shop .
     1991       define buffer buf_store         for ub.store .
     1992       define buffer buf_person        for ub.person .
     1993       define buffer buf_trn-doc       for ub.trn-doc .
     1994       define buffer buf_wth-doc       for ub.wth-doc .
     1995       do
     1996   for buf_firm
     1997     , buf_clients
     1998     , buf_sysconf
     1999     , buf_shop
     2000     , buf_trn-doc
     2001     , buf_person
     2002     , buf_wth-doc
     2003   on error undo, return error
     2004   :
     2005       if p-doc-type = 'при':U
     2006       or p-doc-type = 'возврат':U
     2007       then do:
     2008           assign
     2009               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2010                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2011               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2012                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2013               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2014                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2015               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2016                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2017               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2018               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2019               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2020               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2021               v-torgconf-supplier-type    = v-torgconf-cli-type
     2022               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2023               v-torgconf-saler-type       = v-torgconf-self-host-type
     2024               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2025               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2026               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2027               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2028               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2029               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2030               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2031               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2032               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2033               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2034               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2035               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2036               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2037               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2038               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2039           .
     2040           if v-torgconf-cli-schet-exists = yes
     2041           AND v-form-name                  = "torg12":U
     2042           then do:
     2043               assign
     2044                   v-torgconf-supplier = v-torgconf-supplier
     2045                       + substitute( ", р/с &1 к/с &2"
     2046                                   , v-torgconf-cli-bank-r-schet
     2047                                   , v-torgconf-cli-bank-c-schet
     2048                                   )
     2049                   v-torgconf-suppi = v-torgconf-supplier
     2050                       + substitute( ", р/с &1 к/с &2"
     2051                                   , v-torgconf-cli-bank-r-schet
     2052                                   , v-torgconf-cli-bank-c-schet
     2053                                   )
     2054               .
     2055               if v-torgconf-cli-bank-exists = yes
     2056               then do:
     2057                   assign
     2058                       v-torgconf-supplier = v-torgconf-supplier
     2059                           + substitute( " БИК &1 в &2 &3"
     2060                                       , v-torgconf-cli-bank-bik
     2061                                       , v-torgconf-cli-bank-name
     2062                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2063                                       )
     2064                      v-torgconf-suppi = v-torgconf-supplier
     2065                           + substitute( " БИК &1 в &2 &3"
     2066                                       , v-torgconf-cli-bank-bik
     2067                                       , v-torgconf-cli-bank-name
     2068                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2069                                       )
     2070                   .
     2071               end.
     2072           end.
     2073           if v-torgconf-self-schet-exists = yes
     2074           AND v-form-name                  = "torg12":U
     2075           then do:
     2076               assign
     2077                   v-torgconf-saler = v-torgconf-saler
     2078                       + substitute( ", р/с &1 к/с &2"
     2079                                   , v-torgconf-self-bank-r-schet
     2080                                   , v-torgconf-self-bank-c-schet
     2081                                   )
     2082               .
     2083               if v-torgconf-self-bank-exists = yes
     2084               then do:
     2085                   assign
     2086                       v-torgconf-saler = v-torgconf-saler
     2087                           + substitute( " БИК &1 в &2 &3"
     2088                                       , v-torgconf-self-bank-bik
     2089                                       , v-torgconf-self-bank-name
     2090                                       , v-torgconf-self-bank-addres
     2091                                       )
     2092                   .
     2093               end.
     2094           end.
     2095           if v-torgconf-sup-schet-exists = yes
     2096           AND v-form-name                  = "torg12":U
     2097           then do:
     2098               assign
     2099                   v-torgconf-consignee = v-torgconf-consignee
     2100                       + substitute( ", р/с &1 к/с &2"
     2101                                   , v-torgconf-sup-bank-r-schet
     2102                                   , v-torgconf-sup-bank-c-schet
     2103                                   )
     2104               .
     2105             if v-torgconf-sup-bank-exists = yes
     2106              then do:
     2107                assign
     2108                   v-torgconf-consignee = v-torgconf-consignee
     2109                           + substitute( " БИК &1 в &2 &3"
     2110                                       , v-torgconf-sup-bank-bik
     2111                                       , v-torgconf-sup-bank-name
     2112                                       , v-torgconf-sup-bank-addres
     2113                                       )
     2114                   .
     2115               end.
     2116           end.
     2117      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2118      then do:
     2119          assign
     2120            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2121                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2122                                                   , v-torgconf-cli-name
     2123                                                   , ( if v-torgconf-outprncd = yes
     2124                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2125                                                         else "":U )
     2126                                                   , v-torgconf-cli-post-addres
     2127                                                   , v-torgconf-cli-phone
     2128                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2129                                                       AND v-form-name                  = "torg12":U
     2130                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2131                                                               , v-torgconf-cli-bank-r-schet
     2132                                                               , v-torgconf-cli-bank-c-schet
     2133                                                               , v-torgconf-cli-bank-bik
     2134                                                               , v-torgconf-cli-bank-name
     2135                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2136                                                         else "":U )
     2137                                                )
     2138         .
     2139      end.
     2140       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2141                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2142                                        , v-torgconf-cli-name
     2143                                        , ( if v-torgconf-outprncd = yes
     2144                                            then substitute( " (&1)", v-torgconf-cli-code )
     2145                                            else "":U )
     2146                                        , v-torgconf-cli-addres
     2147                                        , v-torgconf-cli-phone
     2148                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2149                                            AND v-form-name                  = "torg12":U
     2150                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2151                                                           , v-torgconf-cli-bank-r-schet
     2152                                                           , v-torgconf-cli-bank-c-schet
     2153                                                           , v-torgconf-cli-bank-bik
     2154                                                           , v-torgconf-cli-bank-name
     2155                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2156                                                   else "":U )
     2157                                        ).
     2158       end.
     2159       else do:
