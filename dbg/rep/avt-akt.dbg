     4454   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4455     (input  goods.gds-code
     4456     ,input  '1':U
     4457     ,input  t-doc.fact-date
     4458     ,input  v-host-code
     4459     ,input  doc-line.obj-type
     4460     ,input  doc-line.obj-code
     4461     ,output v-vat-pc
     4462     ) no-error .
     4463   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4464   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4465     (input  goods.gds-code
     4466     ,input  '2':U
