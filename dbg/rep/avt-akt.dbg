     1629   procedure torgconf-get-sup-param :
     1630   define input parameter p-obj-type           as character        no-undo.
     1631   define input parameter p-obj-code           as integer          no-undo.
     1632   define input parameter p-curr-code          as integer          no-undo.
     1633       define variable v-host-code    as integer      no-undo.
     1634       define variable v-par-type     as character    no-undo.
     1635   do
     1636   on error undo, return error
     1637   :
     1638       assign
     1639          v-torgconf-sup-host-code = v-host-code
     1640       .
     1641       if v-torgconf-sup-host-code = 0
     1642       then do:
     1643           assign
     1644               v-torgconf-sup-host-name           = "":U
     1645               v-torgconf-sup-host-addres         = "":U
     1646               v-torgconf-sup-host-post-addres    = "":U
     1647               v-torgconf-sup-host-phone          = "":U
     1648               v-torgconf-sup-host-inn            = "":U
     1649               v-torgconf-sup-host-kpp            = "":U
     1650               v-torgconf-sup-host-okpo           = "":U
     1651               v-torgconf-sup-host-egrip-date     = "":U
     1652               v-torgconf-sup-host-egrip-num      = "":U
     1653           .
     1654       end.
     1655       else do:
     1656           run fmtcli-get-client in this-procedure (
     1657                 input 'орг':U
     1658               , input v-torgconf-sup-host-code
     1659           ).
     1660           assign
     1661               v-torgconf-sup-host-name        = v-fmtcli-name
     1662               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1663               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1664               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1665               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1666               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1667               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1668               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1669           .
     1670           run gbl/clntat-v.p (
     1671                 input 'орг':U
     1672               , input v-torgconf-sup-host-code
     1673               , input 'egrip-date':U
     1674               , output v-torgconf-sup-host-egrip-date
     1675               , output v-par-type
     1676           ).
     1677           run gbl/clntat-v.p (
     1678                 input 'орг':U
     1679               , input v-torgconf-sup-host-code
     1680               , input 'egrip-num':U
     1681               , output v-torgconf-sup-host-egrip-num
     1682               , output v-par-type
     1683           ).
     1684           run fmtcli-get-bank in this-procedure (
     1685                 input v-host-code
     1686               , input 'орг':U
     1687               , input v-torgconf-sup-host-code
     1688               , input p-curr-code
     1689           ).
     1690       end.
     1691       assign
     1692           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1693           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1694           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1695           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1696           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1697           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1698           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1699           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1700       .
     1701       assign
     1702           v-torgconf-sup-obj-type = p-obj-type
     1703           v-torgconf-sup-obj-code = p-obj-code
     1704       .
     1705       if trim(p-obj-type) <> ""
     1706       and p-obj-code <> 0
     1707       then do:
     1708       run fmtcli-get-client in this-procedure (
     1709             input p-obj-type
     1710           , input p-obj-code
     1711       ).
     1712       assign
     1713           v-torgconf-sup-obj-name        = v-fmtcli-name
     1714           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1715           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1716           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1717           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1718           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1719           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1720       .
     1721      end.
     1722      end.
     1723   end procedure.
     1724   procedure torgconf-get-cli-param :
     1725   define input parameter p-host-obj-code      as integer          no-undo.
     1726   define input parameter p-obj-type           as character        no-undo.
