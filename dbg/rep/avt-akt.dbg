     1246               .
     1247           end.
     1248           if lookup( p-form-name, v-outhold  ) <> 0
     1249           then do:
     1250               assign
     1251                   v-torgconf-outhold   = yes
     1252               .
     1253           end.
     1254           if lookup( p-form-name, v-outobj   ) <> 0
     1255           then do:
     1256               assign
     1257                   v-torgconf-outobj    = yes
     1258               .
     1259           end.
     1260           if lookup( p-form-name, v-outsend   ) <> 0
     1261           then do:
