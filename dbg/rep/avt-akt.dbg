     4677           assign
     4678               Vat-gds = ( price-lst - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) - v-tax-sum) * t-doc-line.vat-pc / ( 100 + t-doc-line.vat-pc )
     4679               marg = price-lst - price-doc - Vat-gds - (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc)
     4680           .
     4681           ACCUMULATE
     4682               bar-code.b-code ( COUNT )
     4683               gds-dtl.fact-qnty ( TOTAL )
     4684               marg * gds-dtl.fact-qnty ( TOTAL )
     4685               gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ( TOTAL )
     4686               gds-dtl.fact-qnty * VAT-gds ( TOTAL )
     4687               ( gds-dtl.fact-qnty * price-lst ) ( TOTAL )
     4688               ( gds-dtl.fact-qnty * price-doc ) ( TOTAL )
     4689           .
     4690           if v-curr-r-b = 'base':U
     4691           then do:
     4692               ACCUMULATE
     4693                   ( gds-dtl.fact-qnty * gds-dtl.price-base ) ( TOTAL )
     4694                   ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) ( TOTAL )
     4695               .
     4696           end.
     4697           else do:
     4698               ACCUMULATE
     4699                   ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ( TOTAL )
     4700                   ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) ( TOTAL )
     4701               .
     4702           end.
     4703           assign
     4704                delt = ( if v-curr-r-b = 'base':U
     4705                         then string( ( price-lst - gds-dtl.price-base ) / gds-dtl.price-base * 100, "->>>9.9" )
     4706                         else string( ( price-lst - gds-dtl.price-rubl ) / gds-dtl.price-rubl * 100, "->>>9.9" )
     4707                       ) + "%"
     4708           .
     4709           DISPLAY sym1
     4710                   trim( string( bar-code.b-code ) ) @ tb-code
     4711                   gds-dtl.artic
     4712                   goods.gds-name
     4713                   gds-dtl.fact-qnty
     4714                   price-doc
     4715                   ( gds-dtl.fact-qnty * price-doc ) @ sum-no-NDS
     4716                   ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) ) @ doc-sum
     4717                   price-lst
     4718                   ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     4719                   t-doc-line.vat-pc
     4720                   ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     4721                   string( string( marg / price-doc * 100, "->>>9.9" ) + "%" ) @ UpFact
     4722                   Delt
     4723                   sym2
     4724           .
     4725           IF LENGTH(goods.gds-name, "CHARACTER") > 33 and FullGdsName  THEN  do:
     4726             assign propis = SUBSTRING(goods.gds-name,34) .
     4727             DOWN 1 .
     4728             DISPLAY sym1 propis @ goods.gds-name  sym2     .
     4729           end.
     4730           find first tt-tax exclusive-lock
     4731             where tt-tax.vat-pc = t-doc-line.vat-pc
     4732           no-error .
     4733           if not available tt-tax
     4734           then do:
     4735             create tt-tax no-error .
     4736             assign
     4737               tt-tax.vat-pc = t-doc-line.vat-pc
     4738             .
     4739           end.
     4740           assign
     4741             tt-tax.sum-no-nds = tt-tax.sum-no-nds + ( gds-dtl.fact-qnty * price-doc )
     4742             tt-tax.doc-sum    = tt-tax.doc-sum    + ( gds-dtl.fact-qnty * ( if v-curr-r-b = 'base':U then gds-dtl.price-base else gds-dtl.price-rubl ) )
     4743             tt-tax.obj-sum    = tt-tax.obj-sum    + ( gds-dtl.fact-qnty * price-lst )
     4744             tt-tax.vat-sum    = tt-tax.vat-sum    + ( gds-dtl.fact-qnty * VAT-gds )
     4745             tt-tax.fact-qnty  = tt-tax.fact-qnty  + gds-dtl.fact-qnty
     4746           no-error .
     4747           if LAST(goods.gds-name ) then
     4748               do:
     4749                   DOWN 1 .
     4750                   PUT Line format "X(180)" SKIP .
     4751                   assign
     4752                       v-sum-cost-without-vat = ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )
     4753                       v-sum-sale             = ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst )
     4754                   .
     4755                   assign
     4756                       Delt = ( if v-curr-r-b = 'base':U
     4757                               then string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-base ) * gds-dtl.fact-qnty ) )
     4758                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base ) ) * 100, "->>>9.9" ) + "%"
     4759                               else string( ( ACCUM TOTAL ( ( price-lst - gds-dtl.price-rubl ) * gds-dtl.fact-qnty ) )
     4760                                          / ( ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl ) ) * 100, "->>>9.9" ) + "%"
     4761                              )
     4762                   .
     4763                   for each tt-tax
     4764                     by tt-tax.vat-pc
     4765                   :
     4766                     display
     4767                       substitute("  ИТОГО по НДС &1%", tt-tax.vat-pc ) @ goods.gds-name
     4768                       tt-tax.fact-qnty                                 @ gds-dtl.fact-qnty
     4769                       tt-tax.sum-no-nds                                @ sum-no-NDS
     4770                       tt-tax.doc-sum                                   @ doc-sum
     4771                       tt-tax.obj-sum                                   @ obj-sum
     4772                       tt-tax.vat-sum                                   @ VAT-sum
     4773                     with frame Akt-1.
     4774                     down 1 with frame Akt-1.
     4775                   end.
     4776                   DISPLAY "  ИТОГО"    @ goods.gds-name
     4777                       ACCUM TOTAL gds-dtl.fact-qnty @ gds-dtl.fact-qnty
     4778                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc )   @ sum-no-NDS
     4779                       ( if v-curr-r-b = 'base':U
     4780                         then ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-base )
     4781                         else ACCUM TOTAL ( gds-dtl.fact-qnty * gds-dtl.price-rubl )
     4782                       )                                               @ doc-sum
     4783                       ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ) @ obj-sum
     4784                       ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ) @ VAT-sum
     4785                       string( string( ( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ) /
     4786                                              ( ACCUM TOTAL ( gds-dtl.fact-qnty * price-doc ) ) * 100, "->>>9.9" ) + "%" )
     4787                                       @ UpFact
     4788                       Delt .
     4789                   DOWN 2 .
     4790               end.
     4791   END.
     4792   empty temp-table tt-tax.
     4793   HIDE FRAME BottomFrame .
     4794   if v-curr-r-b = 'base':U
     4795   then do:
     4796       run rep/wp.p ( input p-mainmenu-handle, input absolute( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
     4797   end.
     4798   else do:
     4799       run rep/wp-rub.p ( input absolute( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ), output propis, output abbr ) .
     4800   end.
     4801   PUT SPACE(10) "Всего  " ( ACCUM COUNT bar-code.b-code ) format ">>>>9"
     4802       " наименований." format "X(15)"
     4803       SKIP(1)
     4804       SPACE(10)
     4805       string( "Сумма цен по объекту составила : "
     4806                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * price-lst ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     4807                  + " " + trim( abbr )
     4808                  + ", в том числе налог с продаж : "
     4809                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * (price-lst - ub.doc-line.road-tax * 1) * t-doc-line.SLT-pc / (100 + t-doc-line.SLT-pc) ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     4810                  + " " + trim( abbr )
     4811                  + ", НДС : "
     4812                  + trim( string( ACCUM TOTAL ( gds-dtl.fact-qnty * VAT-gds ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     4813                  + " " + trim( abbr )
     4814                 ) format "X(126)"
     4815       skip(1)
     4816       space(10) "Разница между суммой в продажных ценах по объекту и суммой в ценах документа без НДС составила: "
     4817                  + trim( string( v-sum-sale - v-sum-cost-without-vat, "->>>,>>>,>>>,>>>,>>9.99" ) )
     4818                  + " " + trim( abbr )
     4819                                                           format "X(126)"
     4820       skip(1)
     4821       space(10) string( "Торговая наценка составила : "
     4822                  + trim( string( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ), "->>>,>>>,>>>,>>>,>>9.99" ) )
     4823                  + " " + trim( abbr )
     4824                 ) format "X(126)"
     4825       SKIP(1)
     4826       .
     4827   if line-counter + 4 > page-size then
     4828       PAGE .
     4829   if ( ACCUM TOTAL ( marg * gds-dtl.fact-qnty ) ) <> 0
     4830   then do:
     4831       PUT SPACE(10)
     4832               ( if trim(propis) begins trim( abbr ) then string( "0 " + propis ) else propis )
     4833               format "X(120)" SKIP(2).
     4834   end.
     4835   if trim(v-torgconf-ogr-post) = ""
     4836   then do:
     4837       v-torgconf-ogr-post = fill("_",30).
     4838   end.
     4839   if trim(v-torgconf-ogr-name) = ""
     4840   then do:
     4841       v-torgconf-ogr-name = fill("_",30).
     4842   end.
     4843   PUT SPACE(20) "Зав. складом/Зав. секцией :  " format "X(30)" v-torgconf-ogr-post  format "X(30)" "   " fill("_",30) format "X(30)" "   " v-torgconf-ogr-name format "X(30)" SKIP
     4844   space(58) "(должность)" space(25) "(подпись)" space(18) "(расшифровка подписи)"
     4845   SKIP.
     4846   output CLOSE.
     4847   if g#quest-print = false
     4848   then do:
     4849     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4850                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     4851                                         OUTPUT g#log ).
     4852   end.
     4853   else do:
     4854     os-command silent
     4855       value( "COPY /b " +
     4856         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4857         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4858         string( session:temp-directory) +  "$" + string( g#report-num )
     4859                 ) .
     4860     os-command silent
     4861       value( "COPY /b " +
     4862         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4863         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4864         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4865                 ) .
     4866   end.
