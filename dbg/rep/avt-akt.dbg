     1286   end.
     1287   end.
     1288   end procedure.
     1289   procedure torgconf-get-self-param :
     1290   define input parameter p-obj-type           as character        no-undo.
     1291   define input parameter p-obj-code           as integer          no-undo.
     1292   define input parameter p-curr-code          as integer          no-undo.
     1293       define variable v-host-code    as integer      no-undo.
     1294       define variable v-par-type     as character    no-undo.
     1295   do
     1296   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1297   :
     1298   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1300     (input  p-obj-type
     1301     ,input  p-obj-code
     1302     ,output v-host-code
     1303     )  .
     1304       if v-torgconf-outhold = yes
     1305       then do:
     1306           run torgconf-get-holdfirm-code in this-procedure (
     1307                 input p-obj-type
     1308               , input p-obj-code
     1309               , output v-torgconf-self-host-code
     1310           ).
     1311           if v-torgconf-self-host-code = 0
     1312           then do:
     1313               return error.
     1314           end.
     1315       end.
     1316       else do:
     1317           assign
     1318               v-torgconf-self-host-code = v-host-code
     1319           .
     1320       end.
     1321       if v-torgconf-self-host-code = 0
     1322       then do:
     1323           assign
     1324               v-torgconf-self-host-name           = "":U
     1325               v-torgconf-self-host-addres         = "":U
     1326               v-torgconf-self-host-post-addres    = "":U
     1327               v-torgconf-self-host-phone          = "":U
     1328               v-torgconf-self-host-inn            = "":U
     1329               v-torgconf-self-host-kpp            = "":U
     1330               v-torgconf-self-host-okpo           = "":U
     1331               v-torgconf-self-host-egrip-date     = "":U
     1332               v-torgconf-self-host-egrip-num      = "":U
     1333           .
     1334       end.
     1335       else do:
     1336           run fmtcli-get-client in this-procedure (
     1337                 input 'орг':U
     1338               , input v-torgconf-self-host-code
     1339           ).
     1340           assign
     1341               v-torgconf-self-host-name        = v-fmtcli-name
     1342               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1343               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1344               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1345               v-torgconf-self-host-phone       = v-fmtcli-phone
     1346               v-torgconf-self-host-inn         = v-fmtcli-inn
     1347               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1348               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1349           .
     1350           run gbl/clntat-v.p (
     1351                 input 'орг':U
     1352               , input v-torgconf-self-host-code
     1353               , input 'egrip-date':U
     1354               , output v-torgconf-self-host-egrip-date
     1355               , output v-par-type
     1356           ).
     1357           run gbl/clntat-v.p (
     1358                 input 'орг':U
     1359               , input v-torgconf-self-host-code
     1360               , input 'egrip-num':U
     1361               , output v-torgconf-self-host-egrip-num
     1362               , output v-par-type
     1363           ).
     1364           run fmtcli-get-bank in this-procedure (
     1365                 input v-host-code
     1366               , input 'орг':U
     1367               , input v-torgconf-self-host-code
     1368               , input p-curr-code
     1369           ).
     1370       end.
     1371       assign
     1372           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1373           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1374           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1375           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1376           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1377           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1378           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1379           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1380       .
     1381       assign
     1382           v-torgconf-self-obj-type = p-obj-type
     1383           v-torgconf-self-obj-code = p-obj-code
     1384       .
     1385       run fmtcli-get-client in this-procedure (
     1386             input p-obj-type
     1387           , input p-obj-code
