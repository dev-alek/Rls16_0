     1215                   v-torgconf-outsubs  = yes
     1216               .
     1217           end.
     1218           if lookup( p-form-name, v-outrecv ) <> 0
     1219           then do:
     1220               assign
     1221                   v-torgconf-outrecv  = yes
     1222               .
     1223           end.
     1224           if lookup( p-form-name, v-outegrp ) <> 0
     1225           then do:
     1226               assign
