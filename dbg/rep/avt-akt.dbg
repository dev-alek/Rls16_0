     3841       ,output v-cntxp-obj-code
     3842       ,output v-cntxp-db-num-obj
     3843       ,output v-cntxp-is-admin
     3844       ) .
     3845     if (v-cntxp-obj-type = 'маг':U or v-cntxp-obj-type = 'скл':U) and
     3846        v-cntxp-obj-code <> 0 then do:
     3847   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     3848     (input  'is-prt'
     3849     ,input  0
     3850     ,input  ''
     3851     ,input  0
     3852     ,input  ''
     3853     ,input  ''
     3854     ,input  ''
     3855     ,input  yes
     3856     ,output v-cntxp-conf-par
     3857     ,output v-cntxp-par-type
     3858     ) no-error .
     3859       case v-cntxp-obj-type :
     3860         when 'скл':U then do:
     3861           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     3862           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     3863           assign
     3864             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     3865             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     3866             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     3867             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     3868             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     3869             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     3870             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     3871             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     3872             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     3873             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     3874             v-cntxp-load-time       = bf-cntxp_store.load-time
     3875             v-cntxp-holidays        = bf-cntxp_store.holidays
     3876             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     3877             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     3878             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     3879             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     3880             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     3881             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     3882             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     3883             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3884             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3885             .
     3886         end.
     3887         when 'маг':U then do:
     3888           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     3889           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     3890           assign
     3891             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     3892             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
     3893             v-cntxp-inout-price     = bf-cntxp_shop.inout-price
     3894             v-cntxp-unit-cli-perm   = bf-cntxp_shop.unit-cli-perm
     3895             v-cntxp-out-rate        = bf-cntxp_shop.out-rate
     3896             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     3897             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     3898             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     3899             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     3900             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     3901             v-cntxp-load-time       = bf-cntxp_shop.load-time
     3902             v-cntxp-holidays        = bf-cntxp_shop.holidays
     3903             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     3904             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     3905             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     3906             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
     3907             v-cntxp-down-pay        = bf-cntxp_shop.down-pay
     3908             v-cntxp-inv-pay         = bf-cntxp_shop.inv-pay
     3909             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     3910             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     3911             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     3912             .
     3913         end.
     3914       end case.
     3915     end.
