        1   DEFINE INPUT PARAMETER parparentproc AS WIDGET-HANDLE NO-UNDO.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Просмотр и печать  отчетов, отработавших пакетно".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       63   define variable v-waitfram-action01         as character   no-undo .
       64   define variable v-waitfram-action02         as character   no-undo .
       65   define variable v-waitfram-action03         as character   no-undo .
       66   define variable mWaitFramTextBeg            as character   no-undo.
       67   define variable mWaitFramTextEnd            as character   no-undo.
       68   define variable mWaitFramView               as logical     no-undo.
       69   define variable mWaitProcEvent              as logical     no-undo init yes.
       70   define variable mWaitFramInterval           as integer     no-undo init 1 .
       71   define variable mWaitFramStop               as logical     no-undo.
       72   define variable mWaitFramStopUser           as logical     no-undo.
       73   define variable mWaitFramStopTimeOut        as logical     no-undo.
       74   define variable mWaitFramStartProc          as datetime-tz no-undo.
       75   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       76   define button B-WaitFramStop auto-end-key
       77        label "Стоп"
       78        size 10 by 1 tooltip "Остоновить процесс".
       79   define button B-viewProcInfo
       80        label "Информация"
       81        size 15 by 1 tooltip "Информация о процесс".
       82   define frame waitfram
       83     v-waitfram-action01 format "x(72)" no-label skip
       84     v-waitfram-action02 format "x(72)" no-label skip
       85     v-waitfram-action03 format "x(72)" no-label skip
       86     B-viewProcInfo
       87     B-WaitFramStop at row 4 col 30
       88     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       89     .
       90   define new global shared variable mBatchMode as logical no-undo init ?.
       91   define variable mFramBachModHandle as handle no-undo.
       92   mFramBachModHandle = frame waitfram:handle.
       93   define variable mFameOldVis as logical no-undo.
       94   define variable mVisCUrentVin as logical no-undo.
       95   if session:batch-mode
       96   then
       97      mBatchMode = yes.
       98   if mBatchMode = ? then do:
       99     mVisCUrentVin = current-window:visible.
      100     mFameOldVis = mFramBachModHandle:visible.
      101     mFramBachModHandle:visible  = yes.
      102     mBatchMode = mFramBachModHandle:visible ne yes.
      103     mFramBachModHandle:visible = mFameOldVis.
      104     current-window:visible = mVisCUrentVin.
      105   end.
      106    if  log-manager:logfile-name ne ?
      107     then DO:
      108         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      109         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      110         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      111     end.
      112   on choose of B-WaitFramStop in frame waitfram
      113   do:
      114     mWaitFramStop = yes.
      115     mWaitFramStopUser = yes.
      116   end.
      117   function waitfram-check-timeout returns logical():
      118      define variable vtime as int64 no-undo.
      119      if mWaitFramStopTimeOut
      120      then
      121         return yes.
      122      vtime = ( now - mWaitFramStartProc ) / 1000 .
      123      if     mWaitFramTimeOut ne ?
      124         and mWaitFramTimeOut ne 0
      125         and mWaitFramTimeOut lt vtime
      126      then do:
      127         mWaitFramStopTimeOut = yes.
      128      end.
      129      return mWaitFramStopTimeOut.
      130   end.
      131   procedure waitfram-hide :
      132     if not session:batch-mode
      133     then do
      134     on error undo, return error return-value
      135     :
      136       pause 0 before-hide .
      137       if not mBatchMode then
      138         hide frame waitfram .
      139     if     not mWaitFramView
      140        and mWaitProcEvent
      141     then
      142       process events .
      143     end.
      144   end procedure.
      145   procedure waitfram-show :
      146     define input  parameter p-message as character no-undo .
      147     define variable v-left-margin as integer   no-undo .
      148     if not session:batch-mode
      149     then do
      150     on error undo, return error return-value
      151     :
      152       if length(p-message) <= 70 then do:
      153         assign
      154           v-left-margin = integer((70 - length(p-message)) / 2)
      155         .
      156         assign
      157           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      158         .
      159         assign
      160           v-waitfram-action01 = " "
      161           v-waitfram-action02 = " "
      162                                    + fill(" ", v-left-margin)
      163                                    + p-message
      164           v-waitfram-action03 = " "
      165         .
      166       end.
      167       else do:
      168         define variable vRindex1 as integer no-undo.
      169         define variable vRindex2 as integer no-undo.
      170         vRindex1 = r-index(p-message," ",70).
      171         if vRindex1 = 0
      172         then
      173            vRindex1 = 70.
      174         if length(p-message)  <= vRindex1 + 70 then do:
      175           assign
      176             v-waitfram-action01 = " "
      177             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      178             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      179           .
      180         end.
      181         else do:
      182           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      183           if vRindex2 <= vRindex1
      184           then
      185              vRindex2 = vRindex1 + 70.
      186           assign
      187             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      188             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      189             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      190           .
      191         end.
      192       end.
      193       B-viewProcInfo:visible   in frame waitfram = no.
      194       B-viewProcInfo:sensitive in frame waitfram = no.
      195       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      196       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      197       if  (   mWaitFramView
      198          or  mWaitProcEvent)
      199          and not mBatchMode
      200       then
      201          display
      202             v-waitfram-action01 skip
      203             v-waitfram-action02 skip
      204             v-waitfram-action03 skip
      205          with frame waitfram .
      206       if     mWaitFramView
      207          then do:
      208             if     mWaitFramInterval ne ?
      209                and not mBatchMode
      210             then
      211                wait-for go of frame waitfram pause mWaitFramInterval.
      212          end.
      213          else
      214             if     mWaitProcEvent
      215                and not mBatchMode
      216             then
      217                process events .
      218     end.
      219   end procedure.
      220      procedure waitfram-show-this:
      221         define input  parameter iInterval as int64 no-undo.
      222         define variable vtime as int64 no-undo.
      223         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      224         mWaitFramInterval = iInterval.
      225         run waitfram-show (substitute("&1&2 &3&4" ,
      226                                       mWaitFramTextBeg ,
      227                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      228                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      229                                       mWaitFramTextEnd
      230                                      )
      231                           ).
      232      end.
      233      procedure WaitFramRunPause:
      234         define input  parameter iInterval as dec no-undo.
      235         define variable vStart  as datetime-tz no-undo.
      236         define variable vend    as datetime-tz no-undo.
      237         define variable vint as int64 no-undo.
      238         define variable vOk as logical no-undo.
      239         vStart = now.
      240         vend   = vStart.
      241         publish "WaitFramPause" (iInterval,output vOk).
      242         vend   =  now.
      243         vint = vend - vStart.
      244         vint = iInterval - vint / 1000.
      245         if     not mWaitFramStop
      246            and (   vint > 0
      247                 or (    not vOk
      248                     and iInterval eq ?
      249                     )
      250                 )
      251         then
      252            run waitfram-show-this (iInterval).
      253         vend   =  now.
      254         vint = vend - vStart.
      255         vint = iInterval - vint / 1000.
      256         if     not mWaitFramStop
      257            and vint > 0
      258         then do:
      259            run gbl/pause.p (vint * 1000).
      260         end.
      261         if iInterval ne ?
      262         then
      263            publish "WaitFramStop".
      264         waitfram-check-timeout().
      265      end.
      266      procedure WaitFramWaitFor:
      267         define input  parameter iInterval as dec no-undo.
      268         assign
      269            mWaitFramStartProc   = now
      270            mWaitFramStopUser    = no
      271            mWaitFramStopTimeOut = no
      272         .
      273         block-wait:
      274         do while not mWaitFramStop:
      275            run WaitFramRunPause (iInterval).
      276            if  waitfram-check-timeout()
      277            then do:
      278               leave block-wait.
      279            end.
      280         end.
      281         run waitfram-hide.
      282      end.
      283   procedure waitfram-join :
      284     define input  parameter p-line-1  as character no-undo .
      285     define input  parameter p-line-2  as character no-undo .
      286     define input  parameter p-line-3  as character no-undo .
      287     define output parameter p-message as character no-undo .
      288     do
      289     on error undo, return error return-value
      290     :
      291       assign
      292         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      293                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      294                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      295       .
      296     end.
      297   end procedure.
      298   function waitfram-join-function returns character
      299     (input p-line-1 as character
      300     ,input p-line-2 as character
      301     ,input p-line-3 as character
      302     ).
      303     define variable v-message as character no-undo .
      304     run waitfram-join in this-procedure
      305       (input  p-line-1
      306       ,input  p-line-2
      307       ,input  p-line-3
      308       ,output v-message
      309       ) .
      310     return v-message .
      311   end function .
      312   define new global shared variable g#language as character no-undo .
      313   if g#language <> '' and g#language <> 'rus':U then do:
      314     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
      315   end.
      316   procedure proc-alt-shift-f2:
      317     if not ibs.th.gbl.gbl-var:rcode
      318   then
      319     run gbl\inidebug.p .
      320   end.
      321   procedure proc-alt-shift-f3:
      322     run gbl/prvssinf.p
      323       ( input this-procedure
      324       ) .
      325   end.
      326   define variable v-inform-launched as logical no-undo initial false .
      327   procedure proc-alt-shift-f4:
      328     define variable v-action as character no-undo .
      329     if v-inform-launched = false then do:
      330       assign
      331         v-inform-launched = true
      332       .
      333       run gbl/d-inform.w
      334         (  input self
      335         ,  input this-procedure
      336         , output v-action
      337         ) no-error .
      338       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      339       assign
      340         v-inform-launched = false
      341       .
      342     end.
      343   end.
      344   procedure proc-alt-f1:
      345     run gbl/corrhelp.p
      346       (input this-procedure
      347       ) .
      348   end .
      349   on alt-shift-f2 anywhere do:
      350     run proc-alt-shift-f2.
      351   end.
      352   on alt-shift-f3 anywhere do:
      353     run proc-alt-shift-f3 in this-procedure .
      354   end.
      355   on alt-shift-f4 anywhere do:
      356     run proc-alt-shift-f4 in this-procedure.
      357   end.
      358   on alt-f1 anywhere do:
      359     run proc-alt-f1 in this-procedure .
      360   end.
      361   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      362   define shared temp-table report-headert no-undo
      363   field datetimeStart as datetime
      364   field datetimeEnd as datetime
      365   field report-name as character
      366   field report-label as character
      367   field report-id as character
      368   field report-db-num as integer
      369   field task-num as integer
      370   index pi is unique primary
      371   report-id
      372   .
      373   define shared temp-table report-parameterst no-undo
      374   field report-id as character
      375   field parameter-name as character
      376   field parameter-label as character
      377   field parameter-value-type as character
      378   field parameter-value as character
      379   field parameter-index as integer
      380   field parameter-des as character
      381   index pi is unique primary
      382   report-id
      383   parameter-name
      384   parameter-index
      385   .
      386   define shared temp-table report-errorst no-undo
      387   field report-id as character
      388   field ErrNum as integer
      389   field ErrCode as integer
      390   field ErrSeverity as integer
      391   field ErrMessage as character
      392   index pi is unique primary
      393   report-id
      394   ErrNum.
      395   define shared temp-table report-destinationt no-undo
      396   field report-id as character
      397   field destination-id as character
      398   field destination as character
      399   field destination-details as character
      400   index pi is unique primary
      401   report-id
      402   destination-id.
      403   DEFINE BUTTON B-Help
      404        LABEL "Помо&щь"
      405        SIZE 3 BY 1
      406        BGCOLOR 8 .
      407   DEFINE BUTTON B-print
      408        LABEL "Btn 1"
      409        SIZE 3 BY 1.
      410   DEFINE BUTTON b-quit AUTO-END-KEY
      411        LABEL "&Выход"
      412        SIZE 10 BY 1
      413        BGCOLOR 8 .
      414   DEFINE IMAGE I-parameter
      415        FILENAME "cmp/info.bmp":U
      416        SIZE 3 BY 1.
      417   DEFINE QUERY BR-report FOR
      418         report-headert SCROLLING.
      419   DEFINE QUERY BR-report-destination FOR
      420         report-destinationt SCROLLING.
      421   DEFINE QUERY BR-report-errorst FOR
      422         report-errorst SCROLLING.
      423   DEFINE QUERY BR-report-parameters FOR
      424         report-parameterst SCROLLING.
      425   DEFINE BROWSE BR-report
      426     QUERY BR-report DISPLAY
      427         report-headert.report-id COLUMN-LABEL "ID отчета"
      428   report-headert.report-label COLUMN-LABEL "Название отчета" FORMAT "X(255)" WIDTH 50
      429   report-headert.datetimeStart FORMAT "99/99/9999 HH:MM:SS" COLUMN-LABEL "Начало расчета"
      430   report-headert.datetimeEnd FORMAT "99/99/9999 HH:MM:SS" COLUMN-LABEL "Конец расчета"
      431       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 5.8
      432            FONT 4
      433            TITLE "Выполненные отчеты" FIT-LAST-COLUMN.
      434   DEFINE BROWSE BR-report-destination
      435     QUERY BR-report-destination DISPLAY
      436         report-destinationt.destination-id COLUMN-LABEL "Тип вывода" FORMAT "X(8)"
      437    report-destinationt.destination COLUMN-LABEL "Ресурс" FORMAT "X(255)" WIDTH 70
      438       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 4
      439            FONT 4
      440            TITLE "Направления вывода" FIT-LAST-COLUMN.
      441   DEFINE BROWSE BR-report-errorst
      442     QUERY BR-report-errorst DISPLAY
      443         report-errorst.ErrNum COLUMN-LABEL "Пор.№"
      444   report-errorst.Errseverity COLUMN-LABEL "Серьезность"
      445   report-errorst.ErrMessage COLUMN-LABEL "Сообщение" FORMAT "X(255)" WIDTH 50
      446       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 4.2
      447            FONT 4
      448            TITLE "Ошибки при расчете отчета" FIT-LAST-COLUMN.
      449   DEFINE BROWSE BR-report-parameters
      450     QUERY BR-report-parameters DISPLAY
      451         report-parameterst.parameter-label + (IF
      452                                         report-parameterst.parameter-index > 0
      453                                         THEN substitute("[&1]",report-parameterst.parameter-index)
      454                                         ELSE '')
      455   COLUMN-LABEL "Параметр" FORMAT "X(255)" WIDTH 60
      456   report-parameterst.parameter-value COLUMN-LABEL "Знач. пар-ра" FORMAT "X(255)" WIDTH 36
      457       WITH NO-ROW-MARKERS SEPARATORS SIZE 98 BY 6.5
      458            FONT 4
      459            TITLE "Параметры отчета" FIT-LAST-COLUMN.
      460   DEFINE FRAME Dialog-Frame
      461        b-quit AT ROW 1 COL 1
      462        B-print AT ROW 1 COL 92.5 WIDGET-ID 4
      463        B-Help AT ROW 1 COL 95
      464        BR-report AT ROW 2 COL 1 WIDGET-ID 100
      465        BR-report-parameters AT ROW 7.8 COL 1 WIDGET-ID 300
      466        BR-report-errorst AT ROW 14.3 COL 1 WIDGET-ID 400
      467        BR-report-destination AT ROW 18.5 COL 1 WIDGET-ID 200
      468        I-parameter AT ROW 8.2 COL 96.5 WIDGET-ID 34
      469        SPACE(0.20) SKIP(14.02)
      470       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      471            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      472            TITLE "Просмотр выполненных отчетов"
      473            CANCEL-BUTTON b-quit.
      474   ASSIGN
      475          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      476          FRAME Dialog-Frame:HIDDEN           = TRUE.
      477   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      478   or CHOOSE OF B-quit IN FRAME Dialog-Frame
      479   DO:
      480     DEFINE VARIABLE glog AS LOGICAL NO-UNDO.
      481     MESSAGE
      482     "Выйти из режима просмотра отчетов?"
      483      VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE glog.
      484     IF NOT glog THEN RETURN NO-APPLY.
      485     APPLY "END-ERROR":U TO SELF.
      486   END.
      487   ON CHOOSE OF B-print IN FRAME Dialog-Frame
      488   DO:
      489     RUN proc-b-print IN THIS-PROCEDURE NO-ERROR.
      490     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      491   END.
      492   ON MOUSE-SELECT-DBLCLICK OF BR-report IN FRAME Dialog-Frame
      493   DO:
      494     IF NOT AVAILABLE report-headert  THEN RETURN NO-APPLY.
      495     RUN proc-b-print IN THIS-PROCEDURE NO-ERROR.
      496     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      497   END.
      498   ON VALUE-CHANGED OF BR-report IN FRAME Dialog-Frame
      499   DO:
      500     OPEN QUERY BR-report-parameters FOR EACH report-parameterst WHERE     report-parameterst.report-id = report-headert.report-id.
      501     OPEN QUERY BR-report-destination FOR EACH report-destinationt WHERE     report-destinationt.report-id = report-headert.report-id.
      502     OPEN QUERY BR-report-errorst FOR EACH report-errorst WHERE     report-errorst.report-id = report-headert.report-id.
      503   END.
      504   ON MOUSE-SELECT-DBLCLICK OF BR-report-destination IN FRAME Dialog-Frame
      505   DO:
      506     IF NOT AVAILABLE report-headert  THEN RETURN NO-APPLY.
      507     RUN proc-b-print IN THIS-PROCEDURE NO-ERROR.
      508     IF ERROR-STATUS:ERROR THEN RETURN NO-APPLY.
      509   END.
      510   ON MOUSE-SELECT-CLICK OF I-parameter IN FRAME Dialog-Frame
      511   DO:
      512      IF NOT AVAILABLE report-parameterst THEN RETURN NO-APPLY.
      513      MESSAGE report-parameterst.parameter-des
      514      VIEW-AS ALERT-BOX INFORMATION.
      515   END.
      516   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      517   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      518   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      519   on help of frame Dialog-Frame
      520   do:
      521     run gbl/app_help.p
      522       (input this-procedure :file-name
      523       ,input ''
      524       ,input ?
      525       ) no-error.
      526     if error-status :error then do:
      527       message
      528         "Ошибка при вызове помощи"
      529         error-status :get-message(1)
      530         view-as alert-box .
      531     end.
      532   end.
      533   run minbtn-set in this-procedure .
      534   on choose of b-help in frame Dialog-Frame
      535   do:
      536     apply "help":u to frame Dialog-Frame .
      537   end.
      538   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      539   procedure minbtn-set :
      540       do
      541           on error undo, return error return-value
      542           :
      543           define variable ii              as integer       no-undo .
      544           define variable fh              as widget-handle no-undo .
      545           define variable hh              as widget-handle no-undo .
      546           define variable v-h             as handle        extent 4 no-undo .
      547           define variable v-name-button   as character     no-undo .
      548           define variable v-help-old-x    as decimal       no-undo .
      549           define variable v-help-old-y    as decimal       no-undo .
      550           define variable v-help-old-size as decimal       no-undo .
      551           define variable v-frame-width   as decimal       no-undo .
      552           define variable jj              as integer       no-undo .
      553           do
      554               on error undo, return error
      555               :
      556               assign
      557                   v-frame-width = frame Dialog-Frame:width - 0.3
      558                   fh            = frame Dialog-Frame:first-child
      559                   hh            = fh:first-child
      560                   ii            = 1
      561                   .
      562               do while valid-handle(hh):
      563                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      564                   do:
      565                       case lc(hh:name) :
      566                           when "b-help" then
      567                               do:
      568                                   hh:load-image-up("cmp/b-help.bmp":u) .
      569                                   hh:load-image-down("cmp/b-help.bmp":u) .
      570                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      571                                   hh:TOOLTIP = "Помощь" .
      572                                   v-help-old-x = hh:column .
      573                                   v-help-old-y = hh:row    .
      574                                   v-help-old-size = hh:width .
      575                                   hh:width-chars = 2.5 .
      576                               end.
      577                           when "b-print" then
      578                               do:
      579                                   hh:load-image("cmp/b-print.bmp":u) .
      580                                   hh:TOOLTIP = "Печать" .
      581                                   v-h[ii] = hh:handle .
      582                                   ii = ii + 1 .
      583                                   hh:width-chars = 3 .
      584                               end.
      585                           when "b-history" or
      586                           when "b-hist" then
      587                               do:
      588                                   hh:load-image("cmp/b-hist.bmp":u) .
      589                                   hh:TOOLTIP = "История" .
      590                                   v-h[ii] = hh:handle .
      591                                   ii = ii + 1 .
      592                                   hh:width-chars = 3 .
      593                               end.
      594                           when "b-sch" then
      595                               do:
      596                                   hh:load-image("cmp/b-sch.bmp":u) .
      597                                   hh:TOOLTIP = "Установка Фильтра" .
      598                                   v-h[ii] = hh:handle .
      599                                   ii = ii + 1 .
      600                                   hh:width-chars = 3 .
      601                               end.
      602                           when "b-hist-user" then
      603                               do:
      604                                   hh:load-image("cmp/b-hist.bmp":u) .
      605                                   hh:TOOLTIP = "История пользователя" .
      606                                   ii = ii + 1 .
      607                               end.
      608                       end case.
      609                   end.
      610                   hh = hh:next-sibling.
      611               end.
      612               b-help:column = v-frame-width - b-help:width-chars.
      613               jj = 0.
      614               repeat ii = 4 to 1 by -1 :
      615                   if valid-handle (v-h[ii] ) then
      616                   do:
      617                       jj  = jj + 1 .
      618                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      619                       v-h[ii]:row    = v-help-old-y .
      620                   end.
      621               end.
      622           end.
      623       end.
      624   end procedure.
      625   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      626   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      627   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      628   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      629   define variable v-diasize-current-frame-width  as decimal   no-undo .
      630   define variable v-diasize-current-frame-height as decimal   no-undo .
      631   define variable v-diasize-change-size          as logical   no-undo .
      632   define variable v-diasize-resize-button        as handle    no-undo .
      633   define variable v-diasize-wndmax               as logical   no-undo .
      634   define variable v-diasize-wndstore             as logical   no-undo .
      635   define variable v-diasize-proc-name            as character no-undo .
      636   define variable v-diasize-browse-handle        as handle    no-undo .
      637   define variable v-diasize-browse-number        as integer   no-undo .
      638   define variable v-diasize-need-full-display    as logical   no-undo init false .
      639   define temp-table temp-diasize-handle no-undo
      640     field handle-value  as handle
      641     field save-position as decimal
      642     index xpk is primary unique handle-value
      643     .
      644   define temp-table temp-browse-handle no-undo
      645     field browse-type   as character
      646     field browse-number as integer
      647     field browse-handle as handle
      648     field original-size as decimal
      649     index xpk is primary unique browse-type browse-number
      650     index xie browse-type browse-handle
      651   .
      652   procedure diasize_change-height :
      653     define input  parameter p-change-value  as decimal   no-undo .
      654     define input  parameter p-move-resize   as logical   no-undo .
      655     define variable v-field-group-handle    as handle    no-undo .
      656     define variable v-object-handle         as handle    no-undo .
      657     define variable v-frame-height          as decimal   no-undo .
      658     define variable v-frame-virtual-height  as decimal   no-undo .
      659     define variable v-browse-height         as decimal   no-undo .
      660     define variable v-window-height         as decimal   no-undo .
      661     define variable v-window-virtual-height as decimal   no-undo .
      662     define variable v-change-sign           as integer   no-undo .
      663     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      664     define buffer buf_temp-browse-handle  for temp-browse-handle .
      665     if p-change-value > 0
      666     then do:
      667       if frame Dialog-Frame :height + p-change-value
      668           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      669       then do:
      670         assign
      671           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      672                           - (frame Dialog-Frame :height-chars)
      673         .
      674         if p-change-value <= 0
      675         then do:
      676           run diasize_position-resize-button in this-procedure .
      677           return .
      678         end.
      679       end.
      680     end.
      681     if p-change-value < 0
      682     then do:
      683       if frame Dialog-Frame :height + p-change-value < v-diasize-orig-frame-height
      684       then do:
      685         assign
      686           p-change-value = v-diasize-orig-frame-height
      687                          - (frame Dialog-Frame :height-chars)
      688         .
      689         if p-change-value >= 0
      690         then do:
      691           run diasize_position-resize-button in this-procedure .
      692           return .
      693         end.
      694       end.
      695     end.
      696     if p-change-value >= 0
      697     then do:
      698       assign
      699         v-change-sign = 1
      700       .
      701     end.
      702     else do:
      703       assign
      704         v-change-sign = -1
      705       .
      706     end.
      707     assign
      708       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      709     .
      710     if p-change-value = 0
      711     then do:
      712       run diasize_position-resize-button in this-procedure .
      713       return .
      714     end.
      715     move_block:
      716     do
      717     on error undo move_block, retry move_block
      718     :
      719       if retry
      720       then do:
      721         do
      722         on error undo move_block, leave move_block
      723         :
      724           if p-change-value > 0
      725           then do:
      726             for each buf_temp-diasize-handle
      727             on error undo, next
      728             :
      729               assign
      730                 v-object-handle = buf_temp-diasize-handle.handle-value
      731               .
      732               if v-object-handle <> v-diasize-resize-button
      733               then do:
      734                 assign
      735                   v-object-handle :row = buf_temp-diasize-handle.save-position
      736                 .
      737               end.
      738             end.
      739             assign
      740               v-diasize-browse-handle :height = v-browse-height
      741             .
      742             for each buf_temp-browse-handle
      743               where buf_temp-browse-handle.browse-type = 'height':u
      744             on error undo, next
      745             :
      746               assign
      747                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      748               .
      749             end.
      750             assign
      751               frame Dialog-Frame :height = v-frame-height
      752             .
      753             if frame Dialog-Frame :scrollable = true
      754             then do:
      755               assign
      756                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      757               .
      758             end.
      759             run diasize_position-resize-button in this-procedure .
      760           end.
      761           else do:
      762             if frame Dialog-Frame :scrollable = true
      763             then do:
      764               assign
      765                 frame Dialog-Frame :virtual-height = v-frame-virtual-height
      766               .
      767             end.
      768             assign
      769               frame Dialog-Frame :height = v-frame-height
      770             .
      771             assign
      772               v-diasize-browse-handle :height = v-browse-height
      773             .
      774             for each buf_temp-browse-handle
      775               where buf_temp-browse-handle.browse-type = 'height':u
      776             on error undo, next
      777             :
      778               assign
      779                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      780               .
      781             end.
      782             for each buf_temp-diasize-handle
      783             on error undo, next
      784             :
      785               assign
      786                 v-object-handle = buf_temp-diasize-handle.handle-value
      787               .
      788               if v-object-handle <> v-diasize-resize-button
      789               then do:
      790                 assign
      791                   v-object-handle :row = buf_temp-diasize-handle.save-position
      792                 .
      793               end.
      794             end.
      795             run diasize_position-resize-button in this-procedure .
      796           end.
      797           assign
      798             v-diasize-change-size = false
      799           .
      800           leave move_block .
      801         end.
      802       end.
      803       assign
      804         v-diasize-need-full-display = true
      805       .
      806       if v-diasize-change-size = false
      807       then do:
      808         assign
      809           v-diasize-change-size = true
      810         .
      811       end.
      812       else do:
      813         return .
      814       end.
      815       assign
      816         v-frame-height = frame Dialog-Frame :height
      817         v-frame-virtual-height = frame Dialog-Frame :virtual-height
      818         v-browse-height = v-diasize-browse-handle :height
      819       .
      820       for each buf_temp-browse-handle
      821         where buf_temp-browse-handle.browse-type = 'height':u
      822       :
      823         assign
      824           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      825         .
      826       end.
      827       for each buf_temp-diasize-handle
      828       :
      829         delete buf_temp-diasize-handle .
      830       end.
      831       assign
      832         v-field-group-handle = frame Dialog-Frame :first-child
      833       .
      834       do while valid-handle(v-field-group-handle)
      835       :
      836         assign
      837           v-object-handle = v-field-group-handle :first-child
      838         .
      839         do while valid-handle(v-object-handle)
      840         :
      841           if  v-object-handle <> v-diasize-browse-handle :handle
      842           and can-query(v-object-handle, "row")
      843           and can-query(v-object-handle, "height")
      844           and ( v-object-handle :row > v-diasize-browse-handle :row )
      845           then do:
      846             find first buf_temp-browse-handle
      847               where buf_temp-browse-handle.browse-type   = 'height':u
      848                 and buf_temp-browse-handle.browse-handle = v-object-handle
      849               no-error .
      850             if available buf_temp-browse-handle
      851             then do:
      852             end.
      853             else do:
      854               create buf_temp-diasize-handle .
      855               assign
      856                 buf_temp-diasize-handle.handle-value  = v-object-handle
      857                 buf_temp-diasize-handle.save-position = v-object-handle :row
      858               .
      859             end.
      860           end.
      861           assign
      862             v-object-handle = v-object-handle :next-sibling
      863           .
      864         end.
      865         assign
      866           v-field-group-handle = v-field-group-handle :next-sibling
      867         .
      868       end.
      869       do with frame Dialog-Frame
      870       :
      871         hide v-diasize-resize-button .
      872         assign
      873           v-diasize-resize-button :row    = 1
      874           v-diasize-resize-button :column = 1
      875         .
      876       end.
      877       if p-change-value > 0
      878       then do:
      879         if frame Dialog-Frame :scrollable = true
      880         then do:
      881           assign
      882             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      883             no-error .
      884           if error-status :error
      885           or error-status :get-message(1) <> ""
      886           then do:
      887             undo move_block, retry move_block .
      888           end.
      889         end.
      890         assign
      891           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      892           no-error .
      893         if error-status :error
      894         or error-status :get-message(1) <> ""
      895         then do:
      896           undo move_block, retry move_block .
      897         end.
      898         assign
      899           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      900           no-error .
      901         if error-status :error
      902         or error-status :get-message(1) <> ""
      903         then do:
      904           undo move_block, retry move_block .
      905         end.
      906         for each buf_temp-browse-handle
      907           where buf_temp-browse-handle.browse-type = 'height':u
      908         on error undo move_block, retry move_block
      909         :
      910           assign
      911             buf_temp-browse-handle.browse-handle :height
      912               = buf_temp-browse-handle.browse-handle :height + p-change-value
      913             no-error .
      914           if error-status :error
      915           or error-status :get-message(1) <> ""
      916           then do:
      917             undo move_block, retry move_block .
      918           end.
      919         end.
      920         for each buf_temp-diasize-handle
      921         on error undo move_block, retry move_block
      922         :
      923           assign
      924             v-object-handle = buf_temp-diasize-handle.handle-value
      925           .
      926           if v-object-handle <> v-diasize-resize-button
      927           then do:
      928             assign
      929               v-object-handle :row = v-object-handle :row + p-change-value
      930               no-error .
      931             if error-status :error
      932             or error-status :get-message(1) <> ""
      933             then do:
      934               undo move_block, retry move_block .
      935             end.
      936           end.
      937         end.
      938       end.
      939       else do:
      940         for each buf_temp-diasize-handle
      941         on error undo move_block, retry move_block
      942         :
      943           assign
      944             v-object-handle = buf_temp-diasize-handle.handle-value
      945           .
      946           if v-object-handle <> v-diasize-resize-button
      947           then do:
      948             assign
      949               v-object-handle :row = v-object-handle :row + p-change-value
      950               no-error .
      951             if error-status :error
      952             or error-status :get-message(1) <> ""
      953             then do:
      954               undo move_block, retry move_block .
      955             end.
      956           end.
      957         end.
      958         assign
      959           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      960           no-error .
      961         if error-status :error
      962         or error-status :get-message(1) <> ""
      963         then do:
      964           undo move_block, retry move_block .
      965         end.
      966         for each buf_temp-browse-handle
      967           where buf_temp-browse-handle.browse-type = 'height':u
      968         on error undo move_block, retry move_block
      969         :
      970           assign
      971             buf_temp-browse-handle.browse-handle :height
      972               = buf_temp-browse-handle.browse-handle :height + p-change-value
      973             no-error .
      974           if error-status :error
      975           or error-status :get-message(1) <> ""
      976           then do:
      977             undo move_block, retry move_block .
      978           end.
      979         end.
      980         assign
      981           frame Dialog-Frame :height = frame Dialog-Frame :height + p-change-value
      982           no-error .
      983         if error-status :error
      984         or error-status :get-message(1) <> ""
      985         then do:
      986           undo move_block, retry move_block .
      987         end.
      988         if frame Dialog-Frame :scrollable = true
      989         then do:
      990           assign
      991             frame Dialog-Frame :virtual-height = frame Dialog-Frame :virtual-height + p-change-value
      992             no-error .
      993           if error-status :error
      994           or error-status :get-message(1) <> ""
      995           then do:
      996             undo move_block, retry move_block .
      997           end.
      998         end.
      999       end.
     1000       if p-move-resize = true
     1001       then do:
     1002         run diasize_position-resize-button in this-procedure .
     1003       end.
     1004       if v-diasize-wndstore = true
     1005       then do:
     1006         if connected("ub") = true
     1007         then do:
     1008           define variable v-cntxt-db-num        as integer   no-undo .
     1009           define variable v-cntxt-userid        as character no-undo .
     1010           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1011                                             , OUTPUT v-cntxt-userid
     1012                                             ) .
     1013           run gbl/wndsizew.p
     1014             (input  v-cntxt-db-num
     1015             ,input  v-cntxt-userid
     1016             ,input  v-diasize-proc-name
     1017             ,input  'height':u
     1018             ,input  string(frame Dialog-Frame :height - v-diasize-orig-frame-height)
     1019             ) .
     1020         end.
     1021       end.
     1022     end.
     1023     assign
     1024       v-diasize-change-size = false
     1025     .
     1026   end procedure.
     1027   procedure diasize_set-height :
     1028     define input  parameter p-new-height  as decimal   no-undo .
     1029     define input  parameter p-move-resize as logical   no-undo .
     1030     do
     1031     on error undo, return error return-value
     1032     :
     1033       run diasize_change-height in this-procedure
     1034         (input  (p-new-height - frame Dialog-Frame :height)
     1035         ,input  p-move-resize
     1036         ) .
     1037     end.
     1038   end procedure.
     1039   procedure diasize_change-width :
     1040     define input  parameter p-change-value as decimal   no-undo .
     1041     define input  parameter p-move-resize  as logical   no-undo .
     1042     define variable v-field-group-handle   as handle    no-undo .
     1043     define variable v-object-handle        as handle    no-undo .
     1044     define variable v-frame-width          as decimal   no-undo .
     1045     define variable v-frame-virtual-width  as decimal   no-undo .
     1046     define variable v-browse-width         as decimal   no-undo .
     1047     define variable v-window-width         as decimal   no-undo .
     1048     define variable v-window-virtual-width as decimal   no-undo .
     1049     define variable v-change-sign          as integer   no-undo .
     1050     define buffer buf_temp-diasize-handle for temp-diasize-handle .
     1051     define buffer buf_temp-browse-handle  for temp-browse-handle .
     1052     if p-change-value > 0
     1053     then do:
     1054       if frame Dialog-Frame :width + p-change-value >
     1055           session :width-chars
     1056       then do:
     1057         assign
     1058           p-change-value = session :width-chars - frame Dialog-Frame :width
     1059         .
     1060         if p-change-value <= 0
     1061         then do:
     1062           run diasize_position-resize-button in this-procedure .
     1063           return .
     1064         end.
     1065       end.
     1066     end.
     1067     if p-change-value < 0
     1068     then do:
     1069       if frame Dialog-Frame :width + p-change-value < v-diasize-orig-frame-width
     1070       then do:
     1071         assign
     1072           p-change-value = v-diasize-orig-frame-width
     1073                          - frame Dialog-Frame :width
     1074         .
     1075         if p-change-value >= 0
     1076         then do:
     1077           run diasize_position-resize-button in this-procedure .
     1078           return .
     1079         end.
     1080       end.
     1081     end.
     1082     if p-change-value >= 0
     1083     then do:
     1084       assign
     1085         v-change-sign = 1
     1086       .
     1087     end.
     1088     else do:
     1089       assign
     1090         v-change-sign = -1
     1091       .
     1092     end.
     1093     assign
     1094       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
     1095     .
     1096     if p-change-value = 0
     1097     then do:
     1098       run diasize_position-resize-button in this-procedure .
     1099       return .
     1100     end.
     1101     move_block:
     1102     do
     1103     on error undo move_block, leave move_block
     1104     :
     1105       if retry
     1106       then do:
     1107         do
     1108         on error undo move_block, leave move_block
     1109         :
     1110           if p-change-value > 0
     1111           then do:
     1112             for each buf_temp-diasize-handle
     1113             on error undo, next
     1114             :
     1115               assign
     1116                 v-object-handle = buf_temp-diasize-handle.handle-value
     1117               .
     1118               if v-object-handle <> v-diasize-resize-button
     1119               then do:
     1120                 assign
     1121                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1122                 .
     1123               end.
     1124             end.
     1125             assign
     1126               v-diasize-browse-handle :width = v-browse-width
     1127             .
     1128             for each buf_temp-browse-handle
     1129               where buf_temp-browse-handle.browse-type = 'width':u
     1130             on error undo, next
     1131             :
     1132               assign
     1133                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1134               .
     1135             end.
     1136             assign
     1137               frame Dialog-Frame :width = v-frame-width
     1138             .
     1139             if frame Dialog-Frame :scrollable = true
     1140             then do:
     1141               assign
     1142                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1143               .
     1144             end.
     1145             run diasize_position-resize-button in this-procedure .
     1146           end.
     1147           else do:
     1148             if frame Dialog-Frame :scrollable = true
     1149             then do:
     1150               assign
     1151                 frame Dialog-Frame :virtual-width = v-frame-virtual-width
     1152               .
     1153             end.
     1154             assign
     1155               frame Dialog-Frame :width = v-frame-width
     1156             .
     1157             for each buf_temp-browse-handle
     1158               where buf_temp-browse-handle.browse-type = 'width':u
     1159             on error undo, next
     1160             :
     1161               assign
     1162                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
     1163               .
     1164             end.
     1165             assign
     1166               v-diasize-browse-handle :width = v-browse-width
     1167             .
     1168             for each buf_temp-diasize-handle
     1169             on error undo, next
     1170             :
     1171               assign
     1172                 v-object-handle = buf_temp-diasize-handle.handle-value
     1173               .
     1174               if v-object-handle <> v-diasize-resize-button
     1175               then do:
     1176                 assign
     1177                   v-object-handle :col = buf_temp-diasize-handle.save-position
     1178                 .
     1179               end.
     1180             end.
     1181             run diasize_position-resize-button in this-procedure .
     1182           end.
     1183           assign
     1184             v-diasize-change-size = false
     1185           .
     1186           leave move_block .
     1187         end.
     1188       end.
     1189       assign
     1190         v-diasize-need-full-display = true
     1191       .
     1192       if v-diasize-change-size = false
     1193       then do:
     1194         assign
     1195           v-diasize-change-size = true
     1196         .
     1197       end.
     1198       else do:
     1199         return .
     1200       end.
     1201       assign
     1202         v-frame-width = frame Dialog-Frame :width
     1203         v-frame-virtual-width = frame Dialog-Frame :virtual-width
     1204         v-browse-width = v-diasize-browse-handle :width
     1205       .
     1206       for each buf_temp-browse-handle
     1207         where buf_temp-browse-handle.browse-type = 'width':u
     1208       :
     1209         assign
     1210           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
     1211         .
     1212       end.
     1213       for each buf_temp-diasize-handle
     1214       :
     1215         delete buf_temp-diasize-handle .
     1216       end.
     1217       assign
     1218         v-field-group-handle = frame Dialog-Frame :first-child
     1219       .
     1220       do while valid-handle(v-field-group-handle)
     1221       :
     1222         assign
     1223           v-object-handle = v-field-group-handle :first-child
     1224         .
     1225         do while valid-handle(v-object-handle)
     1226         :
     1227           if  v-object-handle <> v-diasize-browse-handle :handle
     1228           and v-object-handle <> v-diasize-resize-button
     1229           and can-query(v-object-handle, "row")
     1230           and can-query(v-object-handle, "height")
     1231           and ( v-object-handle :col + v-object-handle :width
     1232                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
     1233               )
     1234           then do:
     1235             find first buf_temp-browse-handle
     1236               where buf_temp-browse-handle.browse-type   = 'width':u
     1237                 and buf_temp-browse-handle.browse-handle = v-object-handle
     1238               no-error .
     1239             if available buf_temp-browse-handle
     1240             then do:
     1241             end.
     1242             else do:
     1243               create buf_temp-diasize-handle .
     1244               assign
     1245                 buf_temp-diasize-handle.handle-value  = v-object-handle
     1246                 buf_temp-diasize-handle.save-position = v-object-handle :col
     1247               .
     1248             end.
     1249           end.
     1250           assign
     1251             v-object-handle = v-object-handle :next-sibling
     1252           .
     1253         end.
     1254         assign
     1255           v-field-group-handle = v-field-group-handle :next-sibling
     1256         .
     1257       end.
     1258       do with frame Dialog-Frame
     1259       :
     1260         hide v-diasize-resize-button .
     1261         v-diasize-resize-button :row = 1.
     1262         v-diasize-resize-button :column = 1.
     1263       end.
     1264       if p-change-value > 0
     1265       then do:
     1266         if frame Dialog-Frame :scrollable = true
     1267         then do:
     1268           assign
     1269             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1270             no-error .
     1271           if error-status :error
     1272           or error-status :get-message(1) <> ""
     1273           then do:
     1274             undo move_block, retry move_block.
     1275           end.
     1276         end.
     1277         assign
     1278           frame Dialog-Frame :width = v-frame-width + p-change-value
     1279           no-error .
     1280         if error-status :error
     1281         or error-status :get-message(1) <> ""
     1282         then do:
     1283           undo move_block, retry move_block.
     1284         end.
     1285         assign
     1286           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1287         no-error .
     1288         if error-status :error
     1289         or error-status :get-message(1) <> ""
     1290         then do:
     1291           undo move_block, retry move_block.
     1292         end.
     1293         for each buf_temp-browse-handle
     1294           where buf_temp-browse-handle.browse-type = 'width':u
     1295         on error undo move_block, retry move_block
     1296         :
     1297           assign
     1298             buf_temp-browse-handle.browse-handle :width
     1299               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1300             no-error .
     1301           if error-status :error
     1302           or error-status :get-message(1) <> ""
     1303           then do:
     1304             undo move_block, retry move_block .
     1305           end.
     1306         end.
     1307         for each buf_temp-diasize-handle
     1308         on error undo move_block, retry move_block
     1309         :
     1310           assign
     1311             v-object-handle = buf_temp-diasize-handle.handle-value
     1312           .
     1313           if v-object-handle <> v-diasize-resize-button
     1314           then do:
     1315             assign
     1316               v-object-handle :col = v-object-handle :col + p-change-value
     1317               no-error .
     1318             if error-status :error
     1319             or error-status :get-message(1) <> ""
     1320             then do:
     1321               undo move_block, retry move_block .
     1322             end.
     1323           end.
     1324         end.
     1325       end.
     1326       else do:
     1327         for each buf_temp-diasize-handle
     1328         on error undo move_block, retry move_block
     1329         :
     1330           assign
     1331             v-object-handle = buf_temp-diasize-handle.handle-value
     1332           .
     1333           if v-object-handle <> v-diasize-resize-button
     1334           then do:
     1335             assign
     1336               v-object-handle :col = v-object-handle :col + p-change-value
     1337               no-error .
     1338             if error-status :error
     1339             or error-status :get-message(1) <> ""
     1340             then do:
     1341               undo move_block, retry move_block .
     1342             end.
     1343           end.
     1344         end.
     1345         for each buf_temp-browse-handle
     1346           where buf_temp-browse-handle.browse-type = 'width':u
     1347         on error undo move_block, retry move_block
     1348         :
     1349           assign
     1350             buf_temp-browse-handle.browse-handle :width
     1351               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1352             no-error .
     1353           if error-status :error
     1354           or error-status :get-message(1) <> ""
     1355           then do:
     1356             undo move_block, retry move_block .
     1357           end.
     1358         end.
     1359         assign
     1360           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1361           no-error .
     1362         if error-status :error
     1363         or error-status :get-message(1) <> ""
     1364         then do:
     1365           undo move_block, retry move_block.
     1366         end.
     1367         assign
     1368           frame Dialog-Frame :width = frame Dialog-Frame :width + p-change-value
     1369         no-error .
     1370         if error-status :error
     1371         or error-status :get-message(1) <> ""
     1372         then do:
     1373           undo move_block, retry move_block.
     1374         end.
     1375         if frame Dialog-Frame :scrollable = true
     1376         then do:
     1377           assign
     1378             frame Dialog-Frame :virtual-width = frame Dialog-Frame :virtual-width + p-change-value
     1379           no-error .
     1380           if error-status :error
     1381           or error-status :get-message(1) <> ""
     1382           then do:
     1383             undo move_block, retry move_block.
     1384           end.
     1385         end.
     1386       end.
     1387       if p-move-resize
     1388       then do:
     1389         run diasize_position-resize-button in this-procedure .
     1390       end.
     1391       if v-diasize-wndstore = true
     1392       then do:
     1393         if connected("ub") = true
     1394         then do:
     1395           define variable v-cntxt-db-num        as integer   no-undo .
     1396           define variable v-cntxt-userid        as character no-undo .
     1397           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1398                                             , OUTPUT v-cntxt-userid
     1399                                             ) .
     1400           run gbl/wndsizew.p
     1401             (input  v-cntxt-db-num
     1402             ,input  v-cntxt-userid
     1403             ,input  v-diasize-proc-name
     1404             ,input  'width':u
     1405             ,input  string(frame Dialog-Frame :width - v-diasize-orig-frame-width)
     1406             ) .
     1407         end.
     1408       end.
     1409     end.
     1410     assign
     1411       v-diasize-change-size = false
     1412     .
     1413   end procedure.
     1414   procedure diasize_set-width :
     1415     define input  parameter p-new-width  as decimal   no-undo .
     1416     define input  parameter p-move-resize as logical   no-undo .
     1417     do
     1418     on error undo, return error return-value
     1419     :
     1420       run diasize_change-width in this-procedure
     1421         (input  (p-new-width - frame Dialog-Frame :width)
     1422         ,input  p-move-resize
     1423         ) .
     1424     end.
     1425   end procedure.
     1426   procedure diasize_position-resize-button :
     1427     do with frame Dialog-Frame
     1428     :
     1429       hide v-diasize-resize-button .
     1430       assign
     1431         v-diasize-resize-button :row = frame Dialog-Frame :height - v-diasize-resize-button :height
     1432                     - 1
     1433                     - (frame Dialog-Frame :border-bottom-pixels / session :pixels-per-row)
     1434         v-diasize-resize-button :col = frame Dialog-Frame :width - v-diasize-resize-button :width
     1435                     - 1
     1436                     - (frame Dialog-Frame :border-right-pixels / session :pixels-per-column)
     1437       .
     1438       view v-diasize-resize-button .
     1439     end.
     1440   end procedure.
     1441   on alt-right anywhere
     1442   do:
     1443     run diasize_change-width in this-procedure
     1444       (input 1
     1445       ,input true
     1446       ) .
     1447     return no-apply .
     1448   end.
     1449   on alt-left anywhere
     1450   do:
     1451     run diasize_change-width in this-procedure
     1452       (input -1
     1453       ,input true
     1454       ) .
     1455     return no-apply .
     1456   end.
     1457   on alt-down anywhere
     1458   do:
     1459     run diasize_change-height in this-procedure
     1460       (input 1
     1461       ,input true
     1462       ) .
     1463     return no-apply .
     1464   end.
     1465   on alt-up anywhere
     1466   do:
     1467     run diasize_change-height in this-procedure
     1468       (input -1
     1469       ,input true
     1470       ) .
     1471     return no-apply .
     1472   end.
     1473   on alt-enter of frame Dialog-Frame
     1474   do:
     1475     run diasize_maximize in this-procedure
     1476       (input  ?
     1477       ).
     1478     return no-apply .
     1479   end.
     1480   procedure diasize_end-move :
     1481     do
     1482     on error undo, return error return-value
     1483     :
     1484       define variable v-row-delta as decimal   no-undo .
     1485       define variable v-col-delta as decimal   no-undo .
     1486       define variable v-new-row as decimal   no-undo .
     1487       define variable v-new-col as decimal   no-undo .
     1488       assign
     1489         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1490         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1491       .
     1492       assign
     1493         v-row-delta = v-new-row - frame Dialog-Frame :height
     1494         v-col-delta = v-new-col - frame Dialog-Frame :width
     1495       .
     1496       run diasize_change-height in this-procedure
     1497         (input v-row-delta
     1498         ,input true
     1499         ) .
     1500       run diasize_change-width in this-procedure
     1501         (input v-col-delta
     1502         ,input true
     1503         ) .
     1504     end.
     1505   end procedure.
     1506   procedure diasize_maximize :
     1507     define input  parameter p-action as logical   no-undo .
     1508     do
     1509     on error undo, return error return-value
     1510     :
     1511       if p-action = ?
     1512       then do:
     1513         if v-diasize-need-maximize = true
     1514         then do:
     1515           assign
     1516             p-action = true
     1517           .
     1518         end.
     1519         else do:
     1520           assign
     1521             p-action = false
     1522           .
     1523         end.
     1524       end.
     1525       if p-action = true
     1526       then do:
     1527         run diasize_change-height in this-procedure
     1528           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1529               - frame Dialog-Frame :height-chars
     1530           ,input true
     1531           ) .
     1532         run diasize_change-width in this-procedure
     1533           (input session :width-chars
     1534               - frame Dialog-Frame :width-chars
     1535           ,input true
     1536           ) .
     1537         assign
     1538           v-diasize-need-maximize = false
     1539         .
     1540       end.
     1541       else do:
     1542         run diasize_change-width in this-procedure
     1543           (input v-diasize-orig-frame-width
     1544               - frame Dialog-Frame :width-chars
     1545           ,input true
     1546           ) .
     1547         run diasize_change-height in this-procedure
     1548           (input v-diasize-orig-frame-height
     1549               - frame Dialog-Frame :height-chars
     1550           ,input true
     1551           ) .
     1552         assign
     1553           v-diasize-need-maximize = true
     1554         .
     1555       end.
     1556     end.
     1557   end procedure.
     1558   procedure diasize_restore-orig-size :
     1559     do
     1560     on error undo, return error return-value
     1561     :
     1562       assign
     1563         v-diasize-current-frame-width  = frame Dialog-Frame :width
     1564         v-diasize-current-frame-height = frame Dialog-Frame :height
     1565       .
     1566       run diasize_set-height in this-procedure
     1567         (input  v-diasize-orig-frame-height
     1568         ,input  true
     1569         ) .
     1570       run diasize_set-width in this-procedure
     1571         (input  v-diasize-orig-frame-width
     1572         ,input  true
     1573         ) .
     1574     end.
     1575   end procedure.
     1576   procedure diasize_restore-current-size :
     1577     do
     1578     on error undo, return error return-value
     1579     :
     1580       run diasize_set-height in this-procedure
     1581         (input  v-diasize-current-frame-height
     1582         ,input  true
     1583         ) .
     1584       run diasize_set-width in this-procedure
     1585         (input  v-diasize-current-frame-width
     1586         ,input  true
     1587         ) .
     1588     end.
     1589   end procedure.
     1590   procedure diasize_set-browse-handle :
     1591     define input  parameter p-browse-handle as handle   no-undo .
     1592     define buffer buf_temp-browse-handle for temp-browse-handle .
     1593     do
     1594     on error undo, return error return-value
     1595     :
     1596       assign
     1597         v-diasize-browse-handle = p-browse-handle
     1598       .
     1599       for each buf_temp-browse-handle
     1600       on error undo, return error return-value
     1601       :
     1602         delete buf_temp-browse-handle .
     1603       end.
     1604     end.
     1605   end procedure.
     1606   procedure diasize_add_browse :
     1607     define input  parameter p-browse-type   as character no-undo .
     1608     define input  parameter p-browse-handle as handle    no-undo .
     1609     define buffer buf_temp-browse-handle for temp-browse-handle .
     1610     do
     1611     on error undo, return error return-value
     1612     :
     1613       assign
     1614         v-diasize-browse-number = v-diasize-browse-number + 1
     1615       .
     1616       create buf_temp-browse-handle .
     1617       assign
     1618         buf_temp-browse-handle.browse-type   = p-browse-type
     1619         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1620         buf_temp-browse-handle.browse-handle = p-browse-handle
     1621       .
     1622     end.
     1623   end procedure.
     1624   procedure diasize_init :
     1625     define variable v-default-value    as logical   no-undo .
     1626     define variable v-restore-saved    as logical   no-undo .
     1627     define variable v-resize-value-str as character no-undo .
     1628     do
     1629     on error undo, return error return-value
     1630     :
     1631       do with frame Dialog-Frame
     1632       :
     1633         assign
     1634           v-diasize-orig-frame-height = frame Dialog-Frame :height
     1635           v-diasize-orig-frame-width  = frame Dialog-Frame :width
     1636           v-diasize-browse-handle     = browse BR-report :handle
     1637         .
     1638         create button v-diasize-resize-button
     1639         assign
     1640           parent        = frame Dialog-Frame :first-child
     1641           label         = "s"
     1642           height-pixels = 16
     1643           width-pixels  = 16
     1644           visible       = true
     1645           sensitive     = true
     1646           movable       = true
     1647           triggers:
     1648             on end-move persistent run diasize_end-move in this-procedure .
     1649           end triggers.
     1650         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1651         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1652         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1653         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1654         assign
     1655           v-diasize-wndmax = false
     1656         .
     1657         if connected("ub") = true
     1658         then do:
     1659           define variable v-cntxt-db-num        as integer   no-undo .
     1660           define variable v-cntxt-userid        as character no-undo .
     1661           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1662                                             , OUTPUT v-cntxt-userid
     1663                                             ) .
     1664           run gbl/wndpar_r.p
     1665             (input  v-cntxt-db-num
     1666             ,input  v-cntxt-userid
     1667             ,input  'wndmax':U
     1668             ,output v-diasize-wndmax
     1669             ,output v-default-value
     1670             ) .
     1671         end.
     1672         assign
     1673           v-diasize-wndstore = false
     1674         .
     1675         if connected("ub") = true
     1676         then do:
     1677           run gbl/wndpar_r.p
     1678             (input  v-cntxt-db-num
     1679             ,input  v-cntxt-userid
     1680             ,input  'wndstore':U
     1681             ,output v-diasize-wndstore
     1682             ,output v-default-value
     1683             ) .
     1684         end.
     1685         assign
     1686           v-diasize-proc-name = entry(1, program-name(2), '.')
     1687         .
     1688         if v-diasize-wndstore = true
     1689         then do:
     1690           assign
     1691             v-restore-saved = false
     1692           .
     1693           if connected("ub") = true
     1694           then do:
     1695             run gbl/wndsizer.p
     1696               (input  v-cntxt-db-num
     1697               ,input  v-cntxt-userid
     1698               ,input  v-diasize-proc-name
     1699               ,input  'height':u
     1700               ,output v-resize-value-str
     1701               ) .
     1702             if v-resize-value-str <> '':U
     1703             then do:
     1704               run diasize_change-height in this-procedure
     1705                 (input  integer(v-resize-value-str)
     1706                 ,input  true
     1707                 ) .
     1708               assign
     1709                 v-restore-saved = true
     1710               .
     1711             end.
     1712           end.
     1713           if connected("ub") = true
     1714           then do:
     1715             run gbl/wndsizer.p
     1716               (input  v-cntxt-db-num
     1717               ,input  v-cntxt-userid
     1718               ,input  v-diasize-proc-name
     1719               ,input  'width':u
     1720               ,output v-resize-value-str
     1721               ) .
     1722             if v-resize-value-str <> '':U
     1723             then do:
     1724               run diasize_change-width in this-procedure
     1725                 (input  integer(v-resize-value-str)
     1726                 ,input  true
     1727                 ) .
     1728               assign
     1729                 v-restore-saved = true
     1730               .
     1731             end.
     1732           end.
     1733           if v-restore-saved <> true
     1734           then do:
     1735             if v-diasize-wndmax = true
     1736             then do:
     1737               run diasize_maximize in this-procedure
     1738                 (input  true
     1739                 ) .
     1740             end.
     1741           end.
     1742         end.
     1743         else do:
     1744           if v-diasize-wndmax = true
     1745           then do:
     1746             run diasize_maximize in this-procedure
     1747               (input  true
     1748               ) .
     1749           end.
     1750         end.
     1751       end.
     1752     end.
     1753   end procedure.
     1754   procedure diasize_need-full-display :
     1755     define output parameter p-need-full-display as logical   no-undo .
     1756     do
     1757     on error undo, return error return-value
     1758     :
     1759       assign
     1760         p-need-full-display = v-diasize-need-full-display
     1761       .
     1762       assign
     1763         v-diasize-need-full-display = false
     1764       .
     1765     end.
     1766   end procedure.
     1767   procedure get-context :
     1768      define output parameter p-db-num as integer          no-undo.
     1769      define output parameter p-user-id as character        no-undo.
     1770      define variable v-login               as character    no-undo.
     1771      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1772      define buffer buf_user-login  for ub.user-login .
     1773      do
     1774      on error undo, return error
     1775      :
     1776            FIND FIRST buf_sys-ctrl no-lock.
     1777            ASSIGN
     1778               v-login = USERID("ub")
     1779               p-db-num = buf_sys-ctrl.db-num
     1780            .
     1781            FIND FIRST buf_user-login
     1782                 WHERE buf_user-login.db-num = p-db-num
     1783                   AND buf_user-login.user-login = v-login
     1784                 no-lock
     1785                 no-error
     1786                 .
     1787            IF AVAILABLE buf_user-login
     1788            THEN DO:
     1789               assign
     1790                  p-user-id = buf_user-login.user-id
     1791               .
     1792            END.
     1793      end.
     1794   end procedure.
     1795       run diasize_init in this-procedure .
     1796   MAIN-BLOCK:
     1797   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1798      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1799     RUN Myenable.
     1800     WAIT-FOR GO OF FRAME Dialog-Frame.
     1801   END.
     1802   RUN disable_UI.
     1803   PROCEDURE cb_get-options :
     1804   DEFINE INPUT PARAMETER p-caller AS HANDLE NO-UNDO.
     1805   DEFINE BUFFER buf_report-destinationt FOR report-destinationt.
     1806   FOR EACH buf_report-destinationt WHERE
     1807       buf_report-destinationt.report-id = report-headert.report-id:
     1808     RUN cb_set-options IN p-caller ( INPUT buf_report-destinationt.destination-id
     1809                                      ,INPUT buf_report-destinationt.destination
     1810                                      ) .
     1811   END.
     1812   END PROCEDURE.
     1813   PROCEDURE disable_UI :
     1814     HIDE FRAME Dialog-Frame.
     1815   END PROCEDURE.
     1816   PROCEDURE enable_UI :
     1817     ENABLE b-quit B-print B-Help I-parameter BR-report BR-report-parameters
     1818            BR-report-errorst BR-report-destination
     1819         WITH FRAME Dialog-Frame.
     1820     VIEW FRAME Dialog-Frame.
     1821     OPEN QUERY BR-report FOR EACH report-headert.    OPEN QUERY BR-report-destination FOR EACH report-destinationt WHERE     report-destinationt.report-id = report-headert.report-id.    OPEN QUERY BR-report-errorst FOR EACH report-errorst WHERE     report-errorst.report-id = report-headert.report-id.    OPEN QUERY BR-report-parameters FOR EACH report-parameterst WHERE     report-parameterst.report-id = report-headert.report-id.
     1822   END PROCEDURE.
     1823   PROCEDURE MyEnable :
     1824   define variable v-ch0 as handle no-undo .
     1825   v-ch0 = br-report-parameters:FIRST-COLUMN IN FRAME Dialog-Frame.
     1826   REPEAT WHILE valid-handle(v-ch0):
     1827      IF v-ch0:LABEL = "Параметр" THEN DO:
     1828        v-ch0:resizable = yes.
     1829      END.
     1830      v-ch0 = v-ch0:NEXT-COLUMN.
     1831   end.
     1832   ENABLE
     1833   b-quit
     1834   B-print
     1835   B-Help
     1836   BR-report
     1837   BR-report-parameters
     1838   BR-report-errorst
     1839   BR-report-destination
     1840   i-parameter
     1841   WITH FRAME Dialog-Frame .
     1842   VIEW FRAME Dialog-Frame .
     1843   assign
     1844   report-headert.report-label:resizable in browse br-report = yes
     1845   report-errorst.errmessage:resizable in browse br-report-errorst = yes
     1846   report-destinationt.destination:resizable in browse br-report-destination = yes
     1847   .
     1848   OPEN QUERY BR-report FOR EACH report-headert.    OPEN QUERY BR-report-destination FOR EACH report-destinationt WHERE     report-destinationt.report-id = report-headert.report-id.    OPEN QUERY BR-report-errorst FOR EACH report-errorst WHERE     report-errorst.report-id = report-headert.report-id.    OPEN QUERY BR-report-parameters FOR EACH report-parameterst WHERE     report-parameterst.report-id = report-headert.report-id.
     1849   END PROCEDURE.
     1850   PROCEDURE proc-b-print :
     1851   define variable v-user-action as character no-undo .
     1852   define variable v-printed as logical no-undo .
     1853   define variable v-disabled-options as integer no-undo init -1.
     1854   define variable v-font-number as integer no-undo .
     1855   define buffer pt_report-destinationt for report-destinationt.
     1856   define buffer xls_report-destinationt for report-destinationt.
     1857   find first pt_report-destinationt where
     1858           pt_report-destinationt.report-id = report-headert.report-id
     1859       and  pt_report-destinationt.destination-id = 'text':U no-error.
     1860   find first xls_report-destinationt where
     1861           xls_report-destinationt.report-id = report-headert.report-id
     1862       and  xls_report-destinationt.destination-id = 'excel':U no-error.
     1863   if available pt_report-destinationt then do:
     1864     assign
     1865     v-disabled-options = integer(entry(1, pt_report-destinationt.destination-details, chr(4) ))
     1866     v-font-number = integer(entry(2, pt_report-destinationt.destination-details, chr(4) ))
     1867     .
     1868   end.
     1869     if available xls_report-destinationt then do:
     1870       assign
     1871       v-disabled-options = integer(entry(1, xls_report-destinationt.destination-details, chr(4) ))
     1872       v-font-number = integer(entry(2, xls_report-destinationt.destination-details, chr(4) ))
     1873       .
     1874     end.
     1875   if v-disabled-options = -1 then do:
     1876     message
     1877     "Отчет не может быть просмотрен/распечатан, так как это не предусмотрено заданными параметрами" skip
     1878     "или отсутствуют задания на печать/просмотр!"
     1879     view-as alert-box warning.
     1880     return.
     1881   end.
     1882   run gbl/prnfilen.w
     1883     (input  report-headert.report-label
     1884     ,input  v-disabled-options + 30
     1885     ,input  ''
     1886     ,input  v-font-number
     1887     ,output v-user-action
     1888     ,output v-printed
     1889     ) .
     1890   END PROCEDURE.
