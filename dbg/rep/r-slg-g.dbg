     1814   define buffer buf_stk-supp-line for stk-supp-line.
     1815   DEFINE temp-table temp-GrSales1 no-undo
     1816       field   sale-qnty        as decimal
     1817       field   in-qnty          as decimal
     1818       field   obj-type         as  char
     1819       field   obj-code         as  integer
     1820       field   grp-name         as  char
