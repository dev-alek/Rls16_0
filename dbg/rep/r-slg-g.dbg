     3092   if session :set-wait-state( "compiler" ) then.
     3093     Line = fill("-", 102).
     3094     DEFINE frame f-doc
     3095         sym1  v-NameString column-label " Отдел/Группа/Подгруппа " format "X(50)"              space(0)
     3096         sym2  v-in-qnty    column-label "Продано за!период  "      format "->>>,>>>,>>9"   space(0)
     3097         sym3  v-sale-qnty  column-label "  Было за !период  "      format "->>>,>>>,>>9"   space(0)
     3098         sym4  v-proc       column-label " % прода- !ваемости"      format  "->>>,>>9.99"       space(0)
     3099         sym5
     3100     HEADER
     3101         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(70)"
     3102         string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 80 format "X(15)" SKIP
     3103         Line format "X(102)" AT 1
     3104     with width 160 down stream-io.
     3105   output stream OutStream to value( string( session:temp-directory +
     3106                                        "rpt" + string( g#report-num ) ) )
     3107                                        page-size 62 .
     3108     FORM HEADER
     3109         Line format "X(102)" AT 1 SKIP
     3110         "Продолжение - на следующей странице" AT 30 SKIP
     3111         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     3112     VIEW stream OutStream FRAME BottomFrame .
     3113     FORM with FRAME f-doc .
     3114     PUT stream OutStream SPACE(20) "Отчет по количеству наименований с: " x-date-start format "99/99/9999" "г. по: " x-date-end format "99/99/9999" "г." SKIP .
     3115     assign  v-NameString = "Выбор объекта: " .
     3116     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3117     for each obj-list no-lock:
     3118       Assign  v-NameString = obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), " .
     3119       PUT stream OutStream SPACE(5) v-NameString format "X(100)" SKIP .
     3120     end.
     3121     assign  v-NameString = "Выбор товара: " .
     3122     case x-SelectGood :
     3123       when 1        then assign v-NameString = v-NameString + "по всем товарам"  .
     3124       when 2        then assign v-NameString = v-NameString + "по группам"  .
     3125       when 3       then assign v-NameString = v-NameString + "по производителям"  .
     3126       when 4     then assign v-NameString = v-NameString + "выборочно"  .
     3127       when 5        then assign v-NameString = v-NameString + "выборочно"  .
     3128       when 6       then assign v-NameString = v-NameString + "хранимый список"  .
     3129       when 7   then assign v-NameString = v-NameString + "по группам и по производителям"  .
     3130     end case .
     3131     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3132     if p_provid = 1 then assign  v-NameString = "Выбор поставщика: все" .
     3133     else                 assign  v-NameString = "Выбор поставщика: выборочно" .
     3134     PUT stream OutStream v-NameString format "X(100)" SKIP .
     3135     for each obj-list no-lock :
     3136       assign
     3137         ind = 0
     3138         titul = yes
     3139         v-old-level = 0
     3140         v-level = 0
     3141       .
     3142       for each temp-GrSales1
     3143         where temp-GrSales1.obj-type = obj-list.obj-type
     3144           and temp-GrSales1.obj-code = obj-list.obj-code
     3145         break by temp-GrSales1.full-grp-name :
     3146         if titul = yes then do:
     3147           assign
     3148             titul = no
     3149             all-in-qnty   = 0
     3150             all-sale-qnty = 0
     3151             v-NameString  = "Объект: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ")"
     3152           .
     3153           display stream outstream sym1 v-NameString sym2 sym3 sym4 sym5 with frame f-doc.
     3154           down stream outstream with frame f-doc .
     3155         end.
     3156         run GrpSumTree in this-procedure .
     3157         assign
     3158           v-NameString  = temp-GrSales1.grp-name
     3159           v-in-qnty     = temp-GrSales1.in-qnty
     3160           v-sale-qnty   = temp-GrSales1.sale-qnty
     3161           v-proc        = 100 - ( ( temp-GrSales1.sale-qnty - temp-GrSales1.in-qnty ) * 100 / temp-GrSales1.sale-qnty )
     3162           all-in-qnty   = all-in-qnty + temp-GrSales1.in-qnty
     3163           all-sale-qnty = all-sale-qnty + temp-GrSales1.sale-qnty
     3164         .
     3165         if v-proc = ? then v-proc = 0 .
     3166         display stream outstream
     3167           sym1  v-NameString
     3168           sym2  v-in-qnty
     3169           sym3  v-sale-qnty
     3170           sym4  v-proc
     3171           sym5
     3172         with frame f-doc.
     3173         down stream outstream with frame f-doc .
     3174         do ii = 1 to v-level :
     3175           run CalculSum in this-procedure (ii) .
     3176         end.
     3177       End.
     3178       do ii = v-old-level to ind by -1 :
     3179         find first temp-grp-sum
     3180           where temp-grp-sum.num = ii no-error .
     3181         if available temp-grp-sum then do:
     3182           assign
     3183             v-NameString = "Итого по группе " + temp-grp-sum.grp + ":"
     3184             v-in-qnty    = temp-grp-sum.in-qnty
     3185             v-sale-qnty  = temp-grp-sum.sale-qnty
     3186             v-proc       = 100 - ( ( temp-grp-sum.sale-qnty - temp-grp-sum.in-qnty ) * 100 / temp-grp-sum.sale-qnty )
     3187           .
     3188           if v-proc = ? then v-proc = 0 .
     3189           display stream outstream sym1 v-NameString sym2 v-in-qnty sym3 v-sale-qnty sym4 v-proc sym5 with frame f-doc.
     3190           down stream outstream with frame f-doc .
     3191         end.
     3192       end.
     3193       for each temp-grp-sum :
     3194         delete temp-grp-sum .
     3195       end.
     3196       if titul = no then do:
     3197         assign
     3198           v-NameString = "Итого по объекту " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ") :"
     3199           v-in-qnty    = all-in-qnty
     3200           v-sale-qnty  = all-sale-qnty
     3201           v-proc       = 100 - ( ( all-sale-qnty - all-in-qnty ) * 100 / all-sale-qnty )
     3202         .
     3203         if v-proc = ? then v-proc = 0 .
     3204         display stream outstream sym1 v-NameString sym2 v-in-qnty sym3 v-sale-qnty sym4 v-proc sym5 with frame f-doc.
     3205         down stream outstream with frame f-doc .
     3206         display stream outstream sym1 sym2 sym3 sym4 sym5 with frame f-doc.
     3207         down stream outstream with frame f-doc .
     3208       end.
     3209     End.
     3210     PUT STREAM OutStream Line format "X(102)".
     3211     HIDE stream OutStream FRAME BottomFrame .
     3212     OUTPUT stream OutStream CLOSE.
     3213   if mFrameView
     3214   then do:
     3215      HIDE FRAME InfoFrame.
     3216   end.
     3217   if session :set-wait-state( "" ) then.
     3218     define variable v-user-action as character no-undo .
     3219     define variable v-printed as logical   no-undo .
     3220     run gbl/prnfilen.w
     3221       (input  ""
     3222       ,input  0
     3223       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3224       ,input 7
     3225       ,output v-user-action
     3226       ,output v-printed
     3227       ) .
     3228   end.
     3229   procedure GrpSumTree :
     3230     v-level      = num-entries( right-trim(temp-GrSales1.full-grp-name, chr(47)), chr(47) ) - 1 .
     3231     assign CurrGrpName = "" .
     3232     do ind = 1 to v-level :
     3233       assign CurrGrpName = CurrGrpName + entry ( ind, temp-GrSales1.full-grp-name, chr(47) )  + chr(47).
     3234       find first temp-grp-sum
     3235         where temp-grp-sum.full_grp = CurrGrpName
     3236       no-error .
     3237       if not available temp-grp-sum then LEAVE.
     3238     end.
     3239     do ii = v-old-level to ind by -1 :
     3240       find first temp-grp-sum
     3241         where temp-grp-sum.num = ii .
     3242       assign
     3243         v-NameString = "Итого по группе " + temp-grp-sum.grp + ":"
     3244         v-in-qnty    = temp-grp-sum.in-qnty
     3245         v-sale-qnty  = temp-grp-sum.sale-qnty
     3246         v-proc       = 100 - ( ( temp-grp-sum.sale-qnty - temp-grp-sum.in-qnty ) * 100 / temp-grp-sum.sale-qnty )
     3247       .
     3248       if v-proc = ? then v-proc = 0 .
     3249       display stream outstream sym1 v-NameString sym2 v-in-qnty sym3 v-sale-qnty sym4 v-proc sym5 with frame f-doc.
     3250       down stream outstream with frame f-doc .
     3251       delete temp-grp-sum .
     3252     end.
     3253     assign
     3254        v-old-level = v-level
     3255     .
     3256     do ii = ind to v-level :
     3257       create temp-grp-sum .
     3258       if ii > ind then do:
     3259         assign CurrGrpName = CurrGrpName + entry ( ii, temp-GrSales1.full-grp-name, chr(47) )  + chr(47).
     3260       end.
     3261       assign
     3262         temp-grp-sum.num = ii
     3263         temp-grp-sum.full_grp = CurrGrpName
     3264         temp-grp-sum.grp = entry ( ii, temp-GrSales1.full-grp-name, chr(47) )
     3265         v-NameString = "Группа " + temp-grp-sum.grp
     3266         temp-grp-sum.in-qnty    = 0
     3267         temp-grp-sum.sale-qnty  = 0
     3268       .
     3269       display stream outstream sym1 v-NameString sym2 sym3 sym4 sym5 with frame f-doc.
     3270       down stream outstream with frame f-doc .
     3271     end.
     3272   end procedure.
     3273   procedure CalculSum :
     3274     define input  parameter p-num as integer   no-undo .
     3275     define buffer buf_temp-grp-sum for temp-grp-sum .
     3276     find first buf_temp-grp-sum where buf_temp-grp-sum.num = p-num no-error .
     3277     assign
     3278       buf_temp-grp-sum.in-qnty   = buf_temp-grp-sum.in-qnty     + v-in-qnty
     3279       buf_temp-grp-sum.sale-qnty = buf_temp-grp-sum.sale-qnty + v-sale-qnty
     3280     .
     3281   end procedure.
