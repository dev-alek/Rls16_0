     1837     define variable v-sale-qnty   as decimal   no-undo .
     1838     define variable v-proc        as decimal   no-undo .
     1839     define variable  all-in-qnty     as decimal initial 0  no-undo .
     1840     define variable  all-sale-qnty   as decimal initial 0  no-undo .
     1841     run day-begin-fact-order in this-procedure ( input x-date-start, output v-fact-order-start ).
     1842     run day-begin-fact-order in this-procedure ( input ( x-date-end + 1 ),   output v-fact-order-end ).
     1843     assign
     1844       Counter1 = 0 .
     1845     .
     1846   define variable v-account as integer init 0 no-undo .
     1847   define variable v-account-lavel as character no-undo .
     1848   define variable v-button-stop as logical no-undo .
     1849   define variable v-kol-spice as integer no-undo .
     1850   define variable v-kol-spice2 as integer no-undo .
     1851   define variable v-kol-spice3 as integer no-undo .
     1852   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1853   DEFINE BUTTON StopBtn AUTO-END-KEY
     1854        LABEL "Стоп"
     1855        SIZE 10 BY 1.
     1856   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1857        LABEL "Обработано записей"
     1858         VIEW-AS TEXT
     1859        SIZE 14 BY .67 NO-UNDO.
     1860   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1861         VIEW-AS TEXT
     1862        SIZE 53.25 BY .67
     1863        FGCOLOR 1  NO-UNDO.
     1864   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1865         VIEW-AS TEXT
     1866        SIZE 53.25 BY .67
     1867        FGCOLOR 1  NO-UNDO.
     1868   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1869         VIEW-AS TEXT
     1870        SIZE 53.25 BY .67
     1871        FGCOLOR 1  NO-UNDO.
     1872   DEFINE RECTANGLE RECT-1
     1873        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1874        SIZE 55.13 BY 4.46.
     1875   DEFINE FRAME InfoFrame
     1876        StopBtn AT ROW 4.25 COL 21.75
     1877        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1878        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1879        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1880        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1881        RECT-1 AT ROW 1 COL 1
     1882       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1883            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1884            TITLE "Процесс"
     1885            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1886   define variable mFrameView      as logical   no-undo init yes.
     1887     define variable mFramHandle as handle no-undo.
     1888     mFramHandle = frame InfoFrame:handle.
     1889     if  log-manager:logfile-name ne ?
     1890     then DO:
     1891         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1892         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1893         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1894     end.
     1895     mFrameView = not session:batch-mode and mFramHandle:visible.
     1896     if mFrameView
     1897     then do:
     1898       ASSIGN
     1899          FRAME InfoFrame:HIDDEN                           = TRUE
     1900          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1901     end.
     1902   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1903   DO:
     1904     IF not StopProcessing THEN
     1905       Message "Вы действительно хотите прервать" SKIP
     1906               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1907                 UPDATE StopProcessing.
     1908     IF StopProcessing THEN do:
     1909        if mFrameView
     1910        then do:
     1911           HIDE FRAME InfoFrame.
     1912        end.
     1913     End.
     1914   END.
     1915   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1916     if  log-manager:logfile-name ne ?
     1917     then DO:
     1918         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1919     end.
     1920     if not session:batch-mode then
     1921     do:
     1922       VIEW FRAME InfoFrame.
     1923       mFrameView = true.
     1924     end.
     1925      v-button-stop = false .
     1926         if mFrameView
     1927         then do:
     1928         if v-button-stop then view STOPBTN in frame InfoFrame.
     1929                          else Hide STOPBTN in frame InfoFrame.
     1930         end.
     1931     for each temp-GrSales1 exclusive-lock :
     1932       delete temp-GrSales1 .
     1933     end.
     1934     if x-SelectGood = 1 then do:
     1935       for each buf_goods no-lock :
     1936         for each obj-list :
     1937           find first buf_gds-obj no-lock
     1938             where buf_gds-obj.obj-type  = obj-list.obj-type
     1939               and buf_gds-obj.obj-code  = obj-list.obj-code
     1940               and buf_gds-obj.artic     = buf_goods.artic
     1941               and buf_gds-obj.prod-type = buf_goods.prod-type
     1942               and buf_gds-obj.prod-code = buf_goods.prod-code
     1943           no-error .
     1944           if not available buf_gds-obj then next .
     1945           if p_provid = 1 then do:
     1946   define variable vss-include-info19 as character format "X(65)" no-undo
     1947   initial "@(#)$Workfile$ $Revision$".
     1948     if buf_gds-obj.last-doc = ? then next .
     1949     if buf_gds-obj.last-doc < x-date-start and buf_gds-obj.fact-qnty = 0 and buf_gds-obj.avrg-qnty = 0 and buf_gds-obj.fact-sale =0 and buf_gds-obj.fact-base = 0 then next .
     1950     assign
     1951       Counter1  = Counter1 + 1
     1952       beg-qnty  = 0
     1953       end-qnty  = 0
     1954       sale-qnty = 0
     1955       in-qnty   = 0
     1956     .
     1957   IF ( Counter1 modulo v-account = 0 )  then DO:
     1958             if  log-manager:logfile-name ne ?
     1959             then DO:
     1960                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     1961             end.
     1962              if mFrameView
     1963              then do:
     1964               DISPLAY
     1965                 Counter1 @ RecordsDone
     1966                 WITH FRAME InfoFrame.
     1967              end.
     1968   End.
     1969      if v-button-stop then  DO:
     1970            if mFrameView
     1971            then
     1972               PROCESS EVENTS.
     1973            IF StopProcessing THEN DO:
     1974            RETURN error.
     1975            End.
     1976      end.
     1977     find last buf_stk-line no-lock
     1978       where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     1979         and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     1980         and buf_stk-line.artic     = buf_goods.artic
     1981         and buf_stk-line.prod-type = buf_gds-obj.prod-type
     1982         and buf_stk-line.prod-code = buf_gds-obj.prod-code
     1983         and buf_stk-line.sum-type  = 'crsa':U
     1984         and buf_stk-line.cat-id    = '##,##'
     1985         and buf_stk-line.fact-order  <= v-fact-order-start
     1986       use-index category no-error .
     1987     if available buf_stk-line then do:
     1988       assign
     1989         in-qnty  = buf_stk-line.fact-qnty
     1990       .
