     1018       field processed     as logical
     1019       field sort-name     as character
     1020       field full-name     as character
     1021       index pi is primary unique node-code
     1022       index ps processed
     1023   .
     1024   define variable v-grplib-not-fill-extra-info        as logical      no-undo.
     1025   define variable v-grplib-no-warning-grp-amount      as logical      no-undo.
     1026   define variable v-grplib-grp-amount-for-load        as integer      no-undo.
     1027   procedure grplib-get-parameters :
     1028   define input parameter p-store-type     as character        no-undo.
     1029   define input parameter p-store-code     as integer          no-undo.
     1030   do
     1031   on error undo, return error
     1032   :
     1033       assign
     1034           v-grplib-not-fill-extra-info = no
     1035       .
     1036   end.
     1037   end procedure.
     1038   procedure grplib-get-sort-name :
     1039   do
     1040   on error undo, return error
     1041   :
     1042   define input parameter p-node-code  as integer      no-undo.
     1043   define output parameter p-sort-name as character    no-undo.
     1044       define variable v-upper-code    as integer           no-undo.
     1045       define buffer buf_gds-grp       for ub.gds-grp.
     1046       define buffer buf_upper_gds-grp for ub.gds-grp.
     1047       find first buf_gds-grp no-lock
     1048            where buf_gds-grp.node-code = p-node-code
     1049       no-error.
     1050       if not available buf_gds-grp
     1051       then do:
     1052           undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1053       end.
     1054       assign
     1055           p-sort-name  = ""
     1056           v-upper-code = 1
     1057       .
     1058       do while buf_gds-grp.upper-code <> 0
     1059       on error undo, return error "grplib-get-sort-name: Ошибка составления полного имени группы"
     1060       :
     1061           assign
     1062               p-sort-name  = buf_gds-grp.node-name
     1063                            + (if p-sort-name <> "" then chr(2) else "")
     1064                            + p-sort-name
     1065               v-upper-code = buf_gds-grp.upper-code
     1066           .
     1067           find first buf_gds-grp no-lock
     1068                where buf_gds-grp.node-code = v-upper-code
     1069           no-error.
     1070           if not available buf_gds-grp
     1071           then do:
     1072               undo, return error "grplib-get-sort-name: Не найдена группа товаров с кодом "
     1073                                   + string( v-upper-code )
     1074                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1075           end.
     1076       end.
     1077   end.
     1078   end procedure.
     1079   define variable vss-include-info11 as character format "X(65)" no-undo
     1080   initial "@(#)$Workfile$ $Revision$".
     1081   procedure grplib-get-full-name :
     1082      define input parameter p-node-code  as integer      no-undo.
     1083      define output parameter p-full-name as character    no-undo.
     1084      do
     1085   on error undo, return error
     1086   :
     1087       define variable v-upper-code    as integer           no-undo.
     1088       define buffer buf_gds-grp       for ub.gds-grp.
     1089       define buffer buf_upper_gds-grp for ub.gds-grp.
     1090       find first buf_gds-grp no-lock
     1091            where buf_gds-grp.node-code = p-node-code
     1092       no-error.
     1093       if not available buf_gds-grp
     1094       then do:
     1095           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1096       end.
     1097       assign
     1098           p-full-name  = ""
     1099           v-upper-code = 1
     1100       .
     1101       do while buf_gds-grp.upper-code <> 0
     1102       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1103       :
     1104           assign
     1105               p-full-name  = buf_gds-grp.node-name
     1106                            + (if p-full-name <> "" then chr(47) else "")
     1107                            + p-full-name
     1108               v-upper-code = buf_gds-grp.upper-code
     1109           .
     1110           find first buf_gds-grp no-lock
     1111                where buf_gds-grp.node-code = v-upper-code
     1112           no-error.
     1113           if not available buf_gds-grp
     1114           then do:
     1115               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1116                                   + string( v-upper-code )
     1117                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1118           end.
     1119       end.
     1120       assign
     1121       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1122       .
     1123   end.
     1124   end .
     1125   procedure grplib-get-node-from-full-name :
     1126   define input parameter p-full-name as character no-undo .
     1127   define output parameter p-node-code as integer no-undo .
     1128   define variable v-ii as integer no-undo .
     1129   define variable v-upper-code as integer no-undo .
     1130   define variable v-root-code as integer no-undo .
     1131   define variable v-entry as character no-undo .
     1132   define buffer buf_gds-grp       for ub.gds-grp.
     1133   do
     1134   on error undo, return error
     1135   :
     1136     find first buf_gds-grp no-lock
     1137         where buf_gds-grp.upper-code = 0
     1138     no-error .
     1139     if not available buf_gds-grp
     1140     then do:
     1141         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1142     end.
     1143     else do:
     1144       assign
     1145       v-root-code = buf_gds-grp.node-code
     1146       .
     1147     end.
     1148     v-upper-code = v-root-code.
     1149     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1150       assign
     1151       v-entry = entry(v-ii, p-full-name, chr(47)).
     1152       if v-entry = '' then leave.
     1153       find first buf_gds-grp no-lock where
     1154                 buf_gds-grp.node-name = v-entry
     1155             and buf_gds-grp.upper-code = v-upper-code
     1156             no-error.
     1157       if not available buf_gds-grp then do:
     1158         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1159       end.
     1160       else do:
     1161         p-node-code = buf_gds-grp.node-code.
     1162         v-upper-code = buf_gds-grp.node-code.
     1163       end.
     1164     end.
     1165   end.
     1166   end .
     1167   procedure grplib-get-root-code :
     1168   do
     1169   on error undo, return error
     1170   :
     1171   define output parameter p-root-code as integer      no-undo.
     1172       define buffer buf_gds-grp       for ub.gds-grp.
     1173       find first buf_gds-grp no-lock
     1174           where buf_gds-grp.upper-code = 0
     1175       no-error .
     1176       if not available buf_gds-grp
     1177       then do:
     1178           undo, return error .
     1179       end.
     1180       else do:
     1181           assign
     1182               p-root-code = buf_gds-grp.node-code
     1183           .
     1184       end.
     1185   end.
     1186   end procedure.
     1187   procedure grplib-find-grp-by-full-name :
     1188   do
     1189   on error undo, return error
     1190   :
     1191   define input parameter p-search-name  as character    no-undo.
     1192   define input parameter p-fill-path    as logical      no-undo.
     1193   define output parameter p-found       as logical      no-undo.
     1194       define variable v-upper-code    as integer          no-undo.
     1195       define variable v-counter       as integer           no-undo.
     1196       define variable v-level         as integer           no-undo.
     1197       define variable v-full-name     as character         no-undo.
     1198       define variable v-sort-name     as character         no-undo.
     1199       define buffer buf_gds-grp       for ub.gds-grp.
     1200       assign
     1201           p-search-name = replace( p-search-name, chr(47), chr(2) )
     1202       .
     1203       run grplib-get-root-code ( output v-upper-code ) no-error .
     1204       if error-status :error
     1205       then do:
     1206           undo, return error "grplib-expand-name: Ошибка при поиске корневого узла".
     1207       end.
     1208       assign
     1209           v-full-name  = ""
     1210           v-level      = num-entries( p-search-name, chr(2) )
     1211       .
     1212       for each temp_grplib_found-grp
     1213       :
     1214           delete temp_grplib_found-grp.
     1215       end.
     1216       start-name-analyze:
     1217       do v-counter = 1 to v-level
     1218       :
     1219           if v-counter < v-level
     1220           then do:
     1221               find first buf_gds-grp no-lock
     1222                    where buf_gds-grp.upper-code = v-upper-code
     1223                      and buf_gds-grp.node-name  = entry( v-counter, p-search-name, chr(2) )
     1224               no-error .
     1225               if not available buf_gds-grp
     1226               then do:
     1227                   assign
     1228                       v-full-name  = p-search-name
     1229                       v-sort-name  = p-search-name
     1230                   .
     1231                   return error "grplib-expand-name: не найдена группа " + entry( v-level, p-search-name, chr(2) ).
     1232               end.
     1233               else do:
     1234                   assign
     1235                       v-full-name = v-full-name + ( if v-full-name = "" then "" else chr(47) )        + buf_gds-grp.node-name
     1236                       v-sort-name = v-sort-name + ( if v-sort-name = "" then "" else chr(2) ) + buf_gds-grp.node-name
     1237                       v-upper-code = buf_gds-grp.node-code
     1238                   .
     1239                   if p-fill-path = yes
     1240                   then do:
     1241                       create temp_grplib_found-grp.
     1242                       assign
     1243                           temp_grplib_found-grp.full-name = v-full-name + chr(47)
     1244                           temp_grplib_found-grp.sort-name = v-sort-name
     1245                           temp_grplib_found-grp.node-code = v-upper-code
     1246                           temp_grplib_found-grp.level     = v-counter
     1247                       .
     1248                   end.
     1249               end.
     1250           end.
     1251           else do:
     1252               for each buf_gds-grp no-lock
     1253                  where buf_gds-grp.upper-code = v-upper-code
     1254                    and buf_gds-grp.node-name begins entry( v-counter, p-search-name, chr(2) )
     1255               :
     1256                   assign
     1257                       p-found = yes
     1258                   .
     1259                   create temp_grplib_found-grp.
     1260                   assign
     1261                       temp_grplib_found-grp.full-name = v-full-name
     1262                                                           + (if v-full-name = "" then "" else chr(47) )
     1263                                                           + buf_gds-grp.node-name + chr(47)
     1264                       temp_grplib_found-grp.sort-name = v-sort-name
     1265                                                           + ( if v-sort-name = "" then "" else chr(2) )
     1266                                                           + buf_gds-grp.node-name
     1267                       temp_grplib_found-grp.node-code = buf_gds-grp.node-code
     1268                       temp_grplib_found-grp.level     = v-level
     1269                   .
     1270               end.
     1271               if p-found = no
     1272               then do:
     1273                   assign
     1274                       v-full-name  = p-search-name
     1275                       v-sort-name  = p-search-name
     1276                   .
     1277                   for each temp_grplib_found-grp
     1278                   :
     1279                       delete temp_grplib_found-grp.
     1280                   end.
     1281                   assign
     1282                       p-found = no
     1283                   .
     1284               end.
     1285           end.
     1286       end.
     1287   end.
     1288   end procedure.
     1289   procedure grplib-find-all-subgroup :
     1290   do
     1291   on error undo, return error
     1292   :
     1293   define input parameter p-start-node-code    as integer      no-undo.
     1294   define input parameter p-terminal-only      as logical      no-undo.
     1295       define variable v-start-full-name   as character     no-undo.
     1296       define variable v-start-sort-name   as character     no-undo.
     1297       define variable v-not-found         as logical       no-undo.
     1298       define variable v-is-terminal       as logical       no-undo.
     1299       define buffer buf_gds-grp           for ub.gds-grp.
     1300       create temp_found-result-nodelist.
     1301       assign
     1302           temp_found-result-nodelist.node-code = p-start-node-code
     1303           temp_found-result-nodelist.processed = no
     1304       .
     1305       run grplib-get-full-name in this-procedure (
     1306             input p-start-node-code
     1307           , output v-start-full-name
     1308       ).
     1309       run grplib-get-full-name in this-procedure (
     1310             input p-start-node-code
     1311           , output v-start-sort-name
     1312       ).
     1313       process-nodes:
     1314       do while yes
     1315       :
     1316           find first temp_found-result-nodelist
     1317                where temp_found-result-nodelist.node-code = p-start-node-code
     1318           .
     1319           assign
     1320               temp_found-result-nodelist.processed = yes
     1321           .
     1322           for each buf_gds-grp no-lock
     1323              where buf_gds-grp.upper-code = p-start-node-code
     1324           on error undo, return error
     1325           :
     1326               run grplib-is-terminal in this-procedure (
     1327                     input buf_gds-grp.node-code
     1328                   , output v-is-terminal
     1329               ).
     1330               if v-is-terminal = yes
     1331               then do:
     1332                   create temp_grplib_found-grp.
     1333                   assign
     1334                       temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1335                                                           chr(47) + buf_gds-grp.node-name + chr(47)
     1336                       temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1337                                                           chr(2) + buf_gds-grp.node-name + chr(2)
     1338                       temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1339                       temp_grplib_found-grp.is-terminal = yes
     1340                   .
     1341               end.
     1342               else do:
     1343                   create temp_found-result-nodelist.
     1344                   assign
     1345                       temp_found-result-nodelist.node-code = buf_gds-grp.node-code
     1346                       temp_found-result-nodelist.full-name = right-trim(v-start-full-name, chr(47)) +
     1347                                                              chr(47) + buf_gds-grp.node-name + chr(47)
     1348                       temp_found-result-nodelist.sort-name = right-trim(v-start-sort-name, chr(2)) +
     1349                                                              chr(2) + buf_gds-grp.node-name + chr(2)
     1350                       temp_found-result-nodelist.processed = no
     1351                   .
     1352                   if p-terminal-only = no
     1353                   then do:
     1354                       create temp_grplib_found-grp.
     1355                       assign
     1356                           temp_grplib_found-grp.full-name   = right-trim(v-start-full-name, chr(47)) +
     1357                                                               chr(47) + buf_gds-grp.node-name + chr(47)
     1358                           temp_grplib_found-grp.sort-name   = right-trim(v-start-sort-name, chr(2)) +
     1359                                                               chr(2) + buf_gds-grp.node-name + chr(2)
     1360                           temp_grplib_found-grp.node-code   = buf_gds-grp.node-code
     1361                           temp_grplib_found-grp.is-terminal = no
     1362                       .
     1363                   end.
     1364               end.
     1365           end.
     1366           find first temp_found-result-nodelist
     1367                where temp_found-result-nodelist.processed = no
     1368           no-error.
     1369           if not available temp_found-result-nodelist
     1370           then do:
     1371               leave process-nodes.
     1372           end.
     1373           else do:
     1374               assign
     1375                   p-start-node-code = temp_found-result-nodelist.node-code
     1376                   v-start-full-name = temp_found-result-nodelist.full-name
     1377                   v-start-sort-name = temp_found-result-nodelist.sort-name
     1378               .
     1379           end.
     1380       end.
     1381   end.
     1382   end procedure.
     1383   procedure grplib-expand-name :
     1384   define input parameter p-start-name as character        no-undo.
     1385   define output parameter p-end-name  as character        no-undo.
     1386       define variable v-is-terminal   as logical      no-undo.
     1387       define variable v-found         as character    no-undo.
     1388       define buffer buf_temp_grplib_found-grp     for temp_grplib_found-grp.
     1389   do
     1390   for buf_temp_grplib_found-grp
     1391   on error undo, return error
     1392   :
     1393       run grplib-find-grp-by-full-name in this-procedure (
     1394             input p-start-name
     1395           , input no
     1396           , output v-found
     1397       ) no-error.
     1398       run grplib-get-max-substring in this-procedure (
     1399                   input length( p-start-name )
     1400                 , output p-end-name
     1401       ) no-error .
     1402       if error-status :error
     1403       then do:
     1404           assign
     1405               p-end-name = ""
     1406           .
     1407       end.
     1408       else do:
     1409           find first temp_grplib_found-grp
     1410               where temp_grplib_found-grp.full-name = p-end-name
     1411           no-error.
     1412           if available temp_grplib_found-grp
     1413           then do:
     1414               find first buf_temp_grplib_found-grp
     1415                   where buf_temp_grplib_found-grp.full-name begins p-end-name
     1416                   and recid( buf_temp_grplib_found-grp ) <> recid( temp_grplib_found-grp )
     1417               no-error.
     1418               if not available buf_temp_grplib_found-grp
     1419               then do:
     1420                   run grplib-is-terminal in this-procedure (
     1421                       input temp_grplib_found-grp.node-code
     1422                       , output v-is-terminal
     1423                   ).
     1424               end.
     1425           end.
     1426       end.
     1427   end.
     1428   end procedure.
     1429   procedure grplib-get-max-substring :
     1430   do
     1431   on error undo, return error
     1432   :
     1433   define input parameter p-min-substring-length   as integer      no-undo.
     1434   define output parameter p-substring             as character    no-undo.
     1435           define variable v-char-counter  as integer           no-undo.
     1436           define variable v-current-char  as character         no-undo.
     1437           define variable v-names-counter  as integer           no-undo.
     1438           define variable v-base-string   as character         no-undo.
     1439           assign
     1440               v-char-counter  = p-min-substring-length
     1441           .
     1442           find first temp_grplib_found-grp no-error.
     1443           if not available temp_grplib_found-grp
     1444           then do:
     1445               undo, return error "grplib-get-max-substring: Нет строк для вычисления общей подстроки".
     1446           end.
     1447           else do:
     1448               assign
     1449                   v-base-string  = temp_grplib_found-grp.full-name
     1450                   v-char-counter = 0
     1451               .
     1452               counter-block:
     1453               do while yes
     1454               on error undo, return error "grplib-get-max-substring: Ошибка вычисления продолжения имени группы."
     1455               :
     1456                   assign
     1457                       v-char-counter  = v-char-counter + 1
     1458                       v-current-char  = substring( v-base-string, v-char-counter, 1 )
     1459                       v-names-counter = 0
     1460                   .
     1461                   compare-block:
     1462                   for each temp_grplib_found-grp
     1463                   :
     1464                       assign
     1465                           v-names-counter = v-names-counter + 1
     1466                       .
     1467                       if v-names-counter = 1
     1468                       then do:
     1469                           next compare-block.
     1470                       end.
     1471                       if substring( temp_grplib_found-grp.full-name, v-char-counter, 1 ) <> v-current-char
     1472                       then do:
     1473                           leave counter-block.
     1474                       end.
     1475                   end.
     1476                   if v-names-counter = 1
     1477                   then do:
     1478                       assign
     1479                           p-substring = v-base-string
     1480                       .
     1481                       return.
     1482                   end.
     1483               end.
     1484               assign
     1485                   p-substring = substring( v-base-string, 1, v-char-counter - 1 )
     1486               .
     1487           end.
     1488   end.
     1489   end procedure.
     1490   procedure grplib-is-terminal :
     1491   do
     1492   on error undo, return error "Ошибка процедуры grplib-is-terminal"
     1493   :
     1494   define input parameter p-node-code      as integer      no-undo.
     1495   define output parameter p-is-terminal   as logical      no-undo.
     1496       define buffer buf_gds-grp       for ub.gds-grp.
     1497       find first buf_gds-grp no-lock
     1498           where buf_gds-grp.upper-code = p-node-code
     1499       no-error .
     1500       if not available buf_gds-grp
     1501       then do:
     1502           assign
     1503               p-is-terminal = yes
     1504           .
     1505       end.
     1506       else do:
     1507           assign
     1508               p-is-terminal = no
     1509           .
     1510       end.
     1511   end.
     1512   end procedure.
     1513   procedure grplib-have-goods :
     1514   do
     1515   on error undo, return error
     1516   :
     1517   define input parameter p-node-code      as integer      no-undo.
     1518   define output parameter p-have-goods   as logical      no-undo.
     1519       define buffer buf_goods         for ub.goods.
     1520       find first buf_goods no-lock
     1521            where buf_goods.grp-code = p-node-code
     1522       no-error .
     1523       if available buf_goods
     1524       then do:
     1525           assign
     1526               p-have-goods = yes
     1527           .
     1528       end.
     1529       else do:
     1530           assign
     1531               p-have-goods = no
     1532           .
     1533       end.
     1534   end.
     1535   end procedure.
     1536   procedure grplib-find-by-substring :
     1537   do
     1538   on error undo, return error
     1539   :
     1540   define input parameter p-start-code         as integer      no-undo.
     1541   define input parameter p-full-search-string as character    no-undo.
     1542   define output parameter p-found-code        as integer      no-undo.
     1543   define output parameter p-full-name         as character    no-undo.
     1544       define variable v-start-code     as integer           no-undo.
     1545       define variable v-found          as logical  init no  no-undo.
     1546       define buffer buf_gds-grp       for ub.gds-grp.
     1547       search-grp:
     1548       for each buf_gds-grp no-lock
     1549           where buf_gds-grp.node-code > p-start-code
     1550       :
     1551           if index( buf_gds-grp.node-name, p-full-search-string ) <> 0
     1552           then do:
     1553               assign
     1554                   p-found-code = buf_gds-grp.node-code
     1555                   v-found      = yes
     1556               .
     1557               run grplib-get-full-name in this-procedure (
     1558                     input p-found-code
     1559                   , output p-full-name
     1560               ) no-error .
     1561               if error-status :error
     1562               then do:
     1563                   undo, return error "grplib-find-by-substring: Ошибка вычисления полного имени группы." + chr(10) + return-value.
     1564               end.
     1565               leave search-grp.
     1566           end.
     1567       end.
     1568       if v-found = yes
     1569       then do:
     1570       end.
     1571       else do:
     1572           assign
     1573               p-full-name  = ""
     1574               p-found-code = 0
     1575           .
     1576       end.
     1577   end.
     1578   end procedure.
     1579   procedure grplib-analyze-grp-name :
     1580   do
     1581   on error undo, return error
     1582   :
     1583   define input parameter p-grp-name       as character            no-undo.
     1584   define input parameter p-upper-code     as integer              no-undo.
     1585   define output parameter p-error-message as character init ""    no-undo.
     1586       define variable v-char-list     as character    no-undo.
     1587       define variable v-char-counter  as integer      no-undo.
     1588       define variable v-full-name     as character    no-undo.
     1589       if p-grp-name = "" then do:
     1590           assign
     1591               p-error-message = "Название группы не может быть пустым.".
     1592           .
     1593       end.
     1594       else do:
     1595           assign
     1596               v-char-list = "47,92,58,63,34,60,62,171,187,183"
     1597           .
     1598           do v-char-counter = 1 to num-entries( v-char-list )
     1599           :
     1600               if index( p-grp-name, chr( integer( entry( v-char-counter, v-char-list ) ) ) ) <> 0
     1601               then do:
     1602                   assign
     1603                       p-error-message = 'Название группы не может содержать символы /\:*?"<>|«»·'
     1604                   .
     1605                   return.
     1606               end.
     1607           end.
     1608           if p-upper-code > 0
     1609           then do:
     1610               run grplib-get-full-name in this-procedure (
     1611                     input p-upper-code
     1612                   , output v-full-name
     1613               ) no-error .
     1614               if error-status :error
     1615               then do:
     1616                   undo, return error "grplib-analyze-grp-name: Не удалось вычислить полное имя группы." + chr(10) + return-value.
     1617               end.
     1618               if length( v-full-name ) + 1 + length( p-grp-name ) > 350
     1619               then do:
     1620                   assign
     1621                       p-error-message = 'Полное название группы не может содержать более 350 символов.'
     1622                   .
     1623               end.
     1624           end.
     1625       end.
     1626   end.
     1627   end procedure.
     1628   procedure grplib-get-lvl-num :
     1629   define input parameter p-node-code  as integer      no-undo.
     1630   define output parameter p-lvl-num   as integer      no-undo.
     1631       define variable v-full-name    as character    no-undo.
     1632   do
     1633   on error undo, return error
     1634   :
     1635       run grplib-get-full-name in this-procedure (
     1636             input p-node-code
     1637           , output v-full-name
     1638       ).
     1639       assign
     1640           p-lvl-num = num-entries( v-full-name, chr(47) ) - 1
     1641       .
     1642       if p-lvl-num = -1
     1643       then do:
     1644           assign
     1645               p-lvl-num = 0
     1646           .
     1647       end.
     1648   end.
     1649   end procedure.
