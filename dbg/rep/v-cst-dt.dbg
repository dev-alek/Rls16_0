      140       FIELD part-type     AS   CHARACTER
      141       FIELD obj-code      LIKE ub.parts.obj-code
      142       FIELD obj-type      LIKE ub.parts.obj-type
      143       FIELD host-code     LIKE ub.parts.host-code
      144       FIELD artic         LIKE ub.parts.artic
      145       FIELD prod-type     LIKE ub.parts.prod-type
      146       FIELD prod-code     LIKE ub.parts.prod-code
      147       FIELD gds-name      LIKE ub.goods.gds-name
      148       FIELD tnved         LIKE tt-tnved.tnved
      149       FIELD nationality   LIKE ub.goods.nationality
      150       FIELD unit          LIKE ub.goods.unit-base
      151       FIELD fact-date     LIKE ub.parts.fact-date
      152       FIELD fact-num      LIKE ub.parts.fact-num
      153       FIELD cst-code      LIKE ub.parts.cst-code
      154       FIELD fact-qnty     LIKE ub.parts.fact-qnty
      155       FIELD qnty-up       LIKE ub.parts.fact-qnty
      156       FIELD down-qnty     LIKE ub.parts.fact-qnty
      157       FIELD fact-brutto   LIKE ub.doc-line.wt-brutto
      158       FIELD fact-place    LIKE ub.doc-line.num-place
      159       INDEX atom IS PRIMARY
      160                     part-type
      161                     host-code
      162                     obj-code
      163                     obj-type
      164                     artic
      165                     prod-type
      166                     prod-code
      167                     cst-code
