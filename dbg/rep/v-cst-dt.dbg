      169   DEFINE BUFFER bf-parts-brutto  FOR parts-brutto.
      170   DEFINE BUFFER out-parts-brutto FOR parts-brutto.
      171   DEFINE BUFFER in-parts-brutto FOR parts-brutto.
      172   DEFINE  SHARED TEMP-TABLE prt-parts-brutto    NO-UNDO
      173       FIELD in-date        AS   CHARACTER
      174       FIELD cst-code       LIKE ub.parts.cst-code
      175       FIELD artic          LIKE ub.goods.artic
      176       FIELD prod-code      LIKE ub.goods.prod-code
      177       FIELD prod-type      LIKE ub.goods.prod-type
      178       FIELD obj-code       LIKE ub.parts.obj-code
      179       FIELD obj-type       LIKE ub.parts.obj-type
      180       FIELD host-code      LIKE ub.parts.host-code
      181       FIELD in-num         LIKE ub.parts.fact-num
      182       FIELD out-num        LIKE ub.parts.fact-num
      183       FIELD tnved          LIKE tt-tnved.tnved
      184       FIELD gds-name       LIKE ub.goods.gds-name
      185       FIELD nationality    LIKE ub.goods.nationality
      186       FIELD unit           LIKE ub.goods.unit-base
      187       FIELD in-qnty        AS   CHARACTER
      188       FIELD in-qnty-up     AS   CHARACTER
      189       FIELD in-wt-brutto   AS   CHARACTER
      190       FIELD in-fact-place  AS   CHARACTER
      191       FIELD out-date       AS   CHARACTER
      192       FIELD out-qnty       AS   CHARACTER
      193       FIELD out-qnty-up    AS   CHARACTER
      194       FIELD out-wt-brutto  AS   CHARACTER
      195       FIELD out-fact-place AS   CHARACTER
      196       FIELD des            AS   CHARACTER
      197       INDEX in-out IS PRIMARY cst-code in-num out-num ASCENDING .
      198   DEFINE BUTTON b-help
      199        LABEL "Помо&щь"
      200        SIZE 10 BY 1.
      201   DEFINE BUTTON b-quit AUTO-END-KEY DEFAULT
      202        LABEL "Вы&ход "
      203        size 10 by 1
      204        BGCOLOR 8 .
      205   DEFINE QUERY br-parts-brutto FOR
      206         parts-brutto SCROLLING.
      207   DEFINE BROWSE br-parts-brutto
      208     QUERY br-parts-brutto DISPLAY
      209         parts-brutto.part-type     COLUMN-LABEL "Тип"
      210   parts-brutto.fact-date     COLUMN-LABEL "Дата"
      211   parts-brutto.artic         COLUMN-LABEL "Артикул! "
      212   parts-brutto.gds-name      COLUMN-LABEL "Название товара! "
      213   parts-brutto.cst-code      COLUMN-LABEL "Номер ГТД"   FORMAT "X(31)"
      214   parts-brutto.unit          COLUMN-LABEL "Ед.!Изм." FORMAT "X(5)"
      215   parts-brutto.fact-qnty     COLUMN-LABEL "Количество" FORMAT "->,>>>,>>9.<<<"
      216   parts-brutto.fact-brutto   COLUMN-LABEL "Вес брутто" FORMAT "->,>>>,>>9.<<<"
      217   parts-brutto.obj-type      COLUMN-LABEL "Тип!объекта"
      218   parts-brutto.obj-code      COLUMN-LABEL "Код!объекта"
      219       WITH NO-ROW-MARKERS SEPARATORS SIZE 96.13 BY 12.75.
      220   DEFINE FRAME v-suppl
      221        b-help AT ROW 1.17 COL 12.63
      222        b-quit at row 1.17 col 2
      223        br-parts-brutto AT ROW 2.58 COL 2
      224       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      225            SIDE-LABELS NO-UNDERLINE THREE-D
      226            size 98.88 by 15.79
      227            TITLE "".
      228   ASSIGN
      229          FRAME v-suppl:SCROLLABLE       = FALSE
      230          FRAME v-suppl:HIDDEN           = TRUE.
      231   ON WINDOW-CLOSE OF FRAME v-suppl
      232   DO:
      233     APPLY "END-ERROR":U TO SELF.
      234   END.
      235   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      236   on help of frame v-suppl
      237   do:
      238     run gbl/app_help.p
      239       (input this-procedure :file-name
      240       ,input ''
      241       ,input ?
      242       ) no-error.
      243     if error-status :error then do:
      244       message
      245         "Ошибка при вызове помощи"
      246         error-status :get-message(1)
      247         view-as alert-box .
      248     end.
      249   end.
      250   run minbtn-set in this-procedure .
      251   on choose of b-help in frame v-suppl
      252   do:
      253     apply "help":u to frame v-suppl .
      254   end.
      255   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      256   procedure minbtn-set :
      257       do
      258           on error undo, return error return-value
      259           :
      260           define variable ii              as integer       no-undo .
      261           define variable fh              as widget-handle no-undo .
      262           define variable hh              as widget-handle no-undo .
      263           define variable v-h             as handle        extent 4 no-undo .
      264           define variable v-name-button   as character     no-undo .
      265           define variable v-help-old-x    as decimal       no-undo .
      266           define variable v-help-old-y    as decimal       no-undo .
      267           define variable v-help-old-size as decimal       no-undo .
      268           define variable v-frame-width   as decimal       no-undo .
      269           define variable jj              as integer       no-undo .
      270           do
      271               on error undo, return error
      272               :
      273               assign
      274                   v-frame-width = frame v-suppl:width - 0.3
      275                   fh            = frame v-suppl:first-child
      276                   hh            = fh:first-child
      277                   ii            = 1
      278                   .
      279               do while valid-handle(hh):
      280                   if LOOKUP(lc(hh:name), "b-help,b-print,b-history,b-hist,b-hist-user,b-sch") > 0  then
      281                   do:
      282                       case lc(hh:name) :
      283                           when "b-help" then
      284                               do:
      285                                   hh:load-image-up("cmp/b-help.bmp":u) .
      286                                   hh:load-image-down("cmp/b-help.bmp":u) .
      287                                   hh:load-image-insensitive("cmp/b-help.bmp":u) .
      288                                   hh:TOOLTIP = "Помощь" .
      289                                   v-help-old-x = hh:column .
      290                                   v-help-old-y = hh:row    .
      291                                   v-help-old-size = hh:width .
      292                                   hh:width-chars = 2.5 .
      293                               end.
      294                           when "b-print" then
      295                               do:
      296                                   hh:load-image("cmp/b-print.bmp":u) .
      297                                   hh:TOOLTIP = "Печать" .
      298                                   v-h[ii] = hh:handle .
      299                                   ii = ii + 1 .
      300                                   hh:width-chars = 3 .
      301                               end.
      302                           when "b-history" or
      303                           when "b-hist" then
      304                               do:
      305                                   hh:load-image("cmp/b-hist.bmp":u) .
      306                                   hh:TOOLTIP = "История" .
      307                                   v-h[ii] = hh:handle .
      308                                   ii = ii + 1 .
      309                                   hh:width-chars = 3 .
      310                               end.
      311                           when "b-sch" then
      312                               do:
      313                                   hh:load-image("cmp/b-sch.bmp":u) .
      314                                   hh:TOOLTIP = "Установка Фильтра" .
      315                                   v-h[ii] = hh:handle .
      316                                   ii = ii + 1 .
      317                                   hh:width-chars = 3 .
      318                               end.
      319                           when "b-hist-user" then
      320                               do:
      321                                   hh:load-image("cmp/b-hist.bmp":u) .
      322                                   hh:TOOLTIP = "История пользователя" .
      323                                   ii = ii + 1 .
      324                               end.
      325                       end case.
      326                   end.
      327                   hh = hh:next-sibling.
      328               end.
      329               b-help:column = v-frame-width - b-help:width-chars.
      330               jj = 0.
      331               repeat ii = 4 to 1 by -1 :
      332                   if valid-handle (v-h[ii] ) then
      333                   do:
      334                       jj  = jj + 1 .
      335                       v-h[ii]:column = v-frame-width - b-help:width-chars - ( 3 * jj ).
      336                       v-h[ii]:row    = v-help-old-y .
      337                   end.
      338               end.
      339           end.
      340       end.
      341   end procedure.
      342   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ Библиотека изменения размеров окна".
      343   define variable v-diasize-need-maximize        as logical   no-undo init true  .
      344   define variable v-diasize-orig-frame-height    as decimal   no-undo .
      345   define variable v-diasize-orig-frame-width     as decimal   no-undo .
      346   define variable v-diasize-current-frame-width  as decimal   no-undo .
      347   define variable v-diasize-current-frame-height as decimal   no-undo .
      348   define variable v-diasize-change-size          as logical   no-undo .
      349   define variable v-diasize-resize-button        as handle    no-undo .
      350   define variable v-diasize-wndmax               as logical   no-undo .
      351   define variable v-diasize-wndstore             as logical   no-undo .
      352   define variable v-diasize-proc-name            as character no-undo .
      353   define variable v-diasize-browse-handle        as handle    no-undo .
      354   define variable v-diasize-browse-number        as integer   no-undo .
      355   define variable v-diasize-need-full-display    as logical   no-undo init false .
      356   define temp-table temp-diasize-handle no-undo
      357     field handle-value  as handle
      358     field save-position as decimal
      359     index xpk is primary unique handle-value
      360     .
      361   define temp-table temp-browse-handle no-undo
      362     field browse-type   as character
      363     field browse-number as integer
      364     field browse-handle as handle
      365     field original-size as decimal
      366     index xpk is primary unique browse-type browse-number
      367     index xie browse-type browse-handle
      368   .
      369   procedure diasize_change-height :
      370     define input  parameter p-change-value  as decimal   no-undo .
      371     define input  parameter p-move-resize   as logical   no-undo .
      372     define variable v-field-group-handle    as handle    no-undo .
      373     define variable v-object-handle         as handle    no-undo .
      374     define variable v-frame-height          as decimal   no-undo .
      375     define variable v-frame-virtual-height  as decimal   no-undo .
      376     define variable v-browse-height         as decimal   no-undo .
      377     define variable v-window-height         as decimal   no-undo .
      378     define variable v-window-virtual-height as decimal   no-undo .
      379     define variable v-change-sign           as integer   no-undo .
      380     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      381     define buffer buf_temp-browse-handle  for temp-browse-handle .
      382     if p-change-value > 0
      383     then do:
      384       if frame v-suppl :height + p-change-value
      385           > decimal(session :work-area-height-pixels) / session :pixels-per-row
      386       then do:
      387         assign
      388           p-change-value = decimal(session :work-area-height-pixels) / session :pixels-per-row
      389                           - (frame v-suppl :height-chars)
      390         .
      391         if p-change-value <= 0
      392         then do:
      393           run diasize_position-resize-button in this-procedure .
      394           return .
      395         end.
      396       end.
      397     end.
      398     if p-change-value < 0
      399     then do:
      400       if frame v-suppl :height + p-change-value < v-diasize-orig-frame-height
      401       then do:
      402         assign
      403           p-change-value = v-diasize-orig-frame-height
      404                          - (frame v-suppl :height-chars)
      405         .
      406         if p-change-value >= 0
      407         then do:
      408           run diasize_position-resize-button in this-procedure .
      409           return .
      410         end.
      411       end.
      412     end.
      413     if p-change-value >= 0
      414     then do:
      415       assign
      416         v-change-sign = 1
      417       .
      418     end.
      419     else do:
      420       assign
      421         v-change-sign = -1
      422       .
      423     end.
      424     assign
      425       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      426     .
      427     if p-change-value = 0
      428     then do:
      429       run diasize_position-resize-button in this-procedure .
      430       return .
      431     end.
      432     move_block:
      433     do
      434     on error undo move_block, retry move_block
      435     :
      436       if retry
      437       then do:
      438         do
      439         on error undo move_block, leave move_block
      440         :
      441           if p-change-value > 0
      442           then do:
      443             for each buf_temp-diasize-handle
      444             on error undo, next
      445             :
      446               assign
      447                 v-object-handle = buf_temp-diasize-handle.handle-value
      448               .
      449               if v-object-handle <> v-diasize-resize-button
      450               then do:
      451                 assign
      452                   v-object-handle :row = buf_temp-diasize-handle.save-position
      453                 .
      454               end.
      455             end.
      456             assign
      457               v-diasize-browse-handle :height = v-browse-height
      458             .
      459             for each buf_temp-browse-handle
      460               where buf_temp-browse-handle.browse-type = 'height':u
      461             on error undo, next
      462             :
      463               assign
      464                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      465               .
      466             end.
      467             assign
      468               frame v-suppl :height = v-frame-height
      469             .
      470             if frame v-suppl :scrollable = true
      471             then do:
      472               assign
      473                 frame v-suppl :virtual-height = v-frame-virtual-height
      474               .
      475             end.
      476             run diasize_position-resize-button in this-procedure .
      477           end.
      478           else do:
      479             if frame v-suppl :scrollable = true
      480             then do:
      481               assign
      482                 frame v-suppl :virtual-height = v-frame-virtual-height
      483               .
      484             end.
      485             assign
      486               frame v-suppl :height = v-frame-height
      487             .
      488             assign
      489               v-diasize-browse-handle :height = v-browse-height
      490             .
      491             for each buf_temp-browse-handle
      492               where buf_temp-browse-handle.browse-type = 'height':u
      493             on error undo, next
      494             :
      495               assign
      496                 buf_temp-browse-handle.browse-handle :height = buf_temp-browse-handle.original-size
      497               .
      498             end.
      499             for each buf_temp-diasize-handle
      500             on error undo, next
      501             :
      502               assign
      503                 v-object-handle = buf_temp-diasize-handle.handle-value
      504               .
      505               if v-object-handle <> v-diasize-resize-button
      506               then do:
      507                 assign
      508                   v-object-handle :row = buf_temp-diasize-handle.save-position
      509                 .
      510               end.
      511             end.
      512             run diasize_position-resize-button in this-procedure .
      513           end.
      514           assign
      515             v-diasize-change-size = false
      516           .
      517           leave move_block .
      518         end.
      519       end.
      520       assign
      521         v-diasize-need-full-display = true
      522       .
      523       if v-diasize-change-size = false
      524       then do:
      525         assign
      526           v-diasize-change-size = true
      527         .
      528       end.
      529       else do:
      530         return .
      531       end.
      532       assign
      533         v-frame-height = frame v-suppl :height
      534         v-frame-virtual-height = frame v-suppl :virtual-height
      535         v-browse-height = v-diasize-browse-handle :height
      536       .
      537       for each buf_temp-browse-handle
      538         where buf_temp-browse-handle.browse-type = 'height':u
      539       :
      540         assign
      541           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :height
      542         .
      543       end.
      544       for each buf_temp-diasize-handle
      545       :
      546         delete buf_temp-diasize-handle .
      547       end.
      548       assign
      549         v-field-group-handle = frame v-suppl :first-child
      550       .
      551       do while valid-handle(v-field-group-handle)
      552       :
      553         assign
      554           v-object-handle = v-field-group-handle :first-child
      555         .
      556         do while valid-handle(v-object-handle)
      557         :
      558           if  v-object-handle <> v-diasize-browse-handle :handle
      559           and can-query(v-object-handle, "row")
      560           and can-query(v-object-handle, "height")
      561           and ( v-object-handle :row > v-diasize-browse-handle :row )
      562           then do:
      563             find first buf_temp-browse-handle
      564               where buf_temp-browse-handle.browse-type   = 'height':u
      565                 and buf_temp-browse-handle.browse-handle = v-object-handle
      566               no-error .
      567             if available buf_temp-browse-handle
      568             then do:
      569             end.
      570             else do:
      571               create buf_temp-diasize-handle .
      572               assign
      573                 buf_temp-diasize-handle.handle-value  = v-object-handle
      574                 buf_temp-diasize-handle.save-position = v-object-handle :row
      575               .
      576             end.
      577           end.
      578           assign
      579             v-object-handle = v-object-handle :next-sibling
      580           .
      581         end.
      582         assign
      583           v-field-group-handle = v-field-group-handle :next-sibling
      584         .
      585       end.
      586       do with frame v-suppl
      587       :
      588         hide v-diasize-resize-button .
      589         assign
      590           v-diasize-resize-button :row    = 1
      591           v-diasize-resize-button :column = 1
      592         .
      593       end.
      594       if p-change-value > 0
      595       then do:
      596         if frame v-suppl :scrollable = true
      597         then do:
      598           assign
      599             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
      600             no-error .
      601           if error-status :error
      602           or error-status :get-message(1) <> ""
      603           then do:
      604             undo move_block, retry move_block .
      605           end.
      606         end.
      607         assign
      608           frame v-suppl :height = frame v-suppl :height + p-change-value
      609           no-error .
      610         if error-status :error
      611         or error-status :get-message(1) <> ""
      612         then do:
      613           undo move_block, retry move_block .
      614         end.
      615         assign
      616           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      617           no-error .
      618         if error-status :error
      619         or error-status :get-message(1) <> ""
      620         then do:
      621           undo move_block, retry move_block .
      622         end.
      623         for each buf_temp-browse-handle
      624           where buf_temp-browse-handle.browse-type = 'height':u
      625         on error undo move_block, retry move_block
      626         :
      627           assign
      628             buf_temp-browse-handle.browse-handle :height
      629               = buf_temp-browse-handle.browse-handle :height + p-change-value
      630             no-error .
      631           if error-status :error
      632           or error-status :get-message(1) <> ""
      633           then do:
      634             undo move_block, retry move_block .
      635           end.
      636         end.
      637         for each buf_temp-diasize-handle
      638         on error undo move_block, retry move_block
      639         :
      640           assign
      641             v-object-handle = buf_temp-diasize-handle.handle-value
      642           .
      643           if v-object-handle <> v-diasize-resize-button
      644           then do:
      645             assign
      646               v-object-handle :row = v-object-handle :row + p-change-value
      647               no-error .
      648             if error-status :error
      649             or error-status :get-message(1) <> ""
      650             then do:
      651               undo move_block, retry move_block .
      652             end.
      653           end.
      654         end.
      655       end.
      656       else do:
      657         for each buf_temp-diasize-handle
      658         on error undo move_block, retry move_block
      659         :
      660           assign
      661             v-object-handle = buf_temp-diasize-handle.handle-value
      662           .
      663           if v-object-handle <> v-diasize-resize-button
      664           then do:
      665             assign
      666               v-object-handle :row = v-object-handle :row + p-change-value
      667               no-error .
      668             if error-status :error
      669             or error-status :get-message(1) <> ""
      670             then do:
      671               undo move_block, retry move_block .
      672             end.
      673           end.
      674         end.
      675         assign
      676           v-diasize-browse-handle :height = v-diasize-browse-handle :height + p-change-value
      677           no-error .
      678         if error-status :error
      679         or error-status :get-message(1) <> ""
      680         then do:
      681           undo move_block, retry move_block .
      682         end.
      683         for each buf_temp-browse-handle
      684           where buf_temp-browse-handle.browse-type = 'height':u
      685         on error undo move_block, retry move_block
      686         :
      687           assign
      688             buf_temp-browse-handle.browse-handle :height
      689               = buf_temp-browse-handle.browse-handle :height + p-change-value
      690             no-error .
      691           if error-status :error
      692           or error-status :get-message(1) <> ""
      693           then do:
      694             undo move_block, retry move_block .
      695           end.
      696         end.
      697         assign
      698           frame v-suppl :height = frame v-suppl :height + p-change-value
      699           no-error .
      700         if error-status :error
      701         or error-status :get-message(1) <> ""
      702         then do:
      703           undo move_block, retry move_block .
      704         end.
      705         if frame v-suppl :scrollable = true
      706         then do:
      707           assign
      708             frame v-suppl :virtual-height = frame v-suppl :virtual-height + p-change-value
      709             no-error .
      710           if error-status :error
      711           or error-status :get-message(1) <> ""
      712           then do:
      713             undo move_block, retry move_block .
      714           end.
      715         end.
      716       end.
      717       if p-move-resize = true
      718       then do:
      719         run diasize_position-resize-button in this-procedure .
      720       end.
      721       if v-diasize-wndstore = true
      722       then do:
      723         if connected("ub") = true
      724         then do:
      725           define variable v-cntxt-db-num        as integer   no-undo .
      726           define variable v-cntxt-userid        as character no-undo .
      727           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
      728                                             , OUTPUT v-cntxt-userid
      729                                             ) .
      730           run gbl/wndsizew.p
      731             (input  v-cntxt-db-num
      732             ,input  v-cntxt-userid
      733             ,input  v-diasize-proc-name
      734             ,input  'height':u
      735             ,input  string(frame v-suppl :height - v-diasize-orig-frame-height)
      736             ) .
      737         end.
      738       end.
      739     end.
      740     assign
      741       v-diasize-change-size = false
      742     .
      743   end procedure.
      744   procedure diasize_set-height :
      745     define input  parameter p-new-height  as decimal   no-undo .
      746     define input  parameter p-move-resize as logical   no-undo .
      747     do
      748     on error undo, return error return-value
      749     :
      750       run diasize_change-height in this-procedure
      751         (input  (p-new-height - frame v-suppl :height)
      752         ,input  p-move-resize
      753         ) .
      754     end.
      755   end procedure.
      756   procedure diasize_change-width :
      757     define input  parameter p-change-value as decimal   no-undo .
      758     define input  parameter p-move-resize  as logical   no-undo .
      759     define variable v-field-group-handle   as handle    no-undo .
      760     define variable v-object-handle        as handle    no-undo .
      761     define variable v-frame-width          as decimal   no-undo .
      762     define variable v-frame-virtual-width  as decimal   no-undo .
      763     define variable v-browse-width         as decimal   no-undo .
      764     define variable v-window-width         as decimal   no-undo .
      765     define variable v-window-virtual-width as decimal   no-undo .
      766     define variable v-change-sign          as integer   no-undo .
      767     define buffer buf_temp-diasize-handle for temp-diasize-handle .
      768     define buffer buf_temp-browse-handle  for temp-browse-handle .
      769     if p-change-value > 0
      770     then do:
      771       if frame v-suppl :width + p-change-value >
      772           session :width-chars
      773       then do:
      774         assign
      775           p-change-value = session :width-chars - frame v-suppl :width
      776         .
      777         if p-change-value <= 0
      778         then do:
      779           run diasize_position-resize-button in this-procedure .
      780           return .
      781         end.
      782       end.
      783     end.
      784     if p-change-value < 0
      785     then do:
      786       if frame v-suppl :width + p-change-value < v-diasize-orig-frame-width
      787       then do:
      788         assign
      789           p-change-value = v-diasize-orig-frame-width
      790                          - frame v-suppl :width
      791         .
      792         if p-change-value >= 0
      793         then do:
      794           run diasize_position-resize-button in this-procedure .
      795           return .
      796         end.
      797       end.
      798     end.
      799     if p-change-value >= 0
      800     then do:
      801       assign
      802         v-change-sign = 1
      803       .
      804     end.
      805     else do:
      806       assign
      807         v-change-sign = -1
      808       .
      809     end.
      810     assign
      811       p-change-value = truncate(abs(p-change-value), 0) * v-change-sign
      812     .
      813     if p-change-value = 0
      814     then do:
      815       run diasize_position-resize-button in this-procedure .
      816       return .
      817     end.
      818     move_block:
      819     do
      820     on error undo move_block, leave move_block
      821     :
      822       if retry
      823       then do:
      824         do
      825         on error undo move_block, leave move_block
      826         :
      827           if p-change-value > 0
      828           then do:
      829             for each buf_temp-diasize-handle
      830             on error undo, next
      831             :
      832               assign
      833                 v-object-handle = buf_temp-diasize-handle.handle-value
      834               .
      835               if v-object-handle <> v-diasize-resize-button
      836               then do:
      837                 assign
      838                   v-object-handle :col = buf_temp-diasize-handle.save-position
      839                 .
      840               end.
      841             end.
      842             assign
      843               v-diasize-browse-handle :width = v-browse-width
      844             .
      845             for each buf_temp-browse-handle
      846               where buf_temp-browse-handle.browse-type = 'width':u
      847             on error undo, next
      848             :
      849               assign
      850                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      851               .
      852             end.
      853             assign
      854               frame v-suppl :width = v-frame-width
      855             .
      856             if frame v-suppl :scrollable = true
      857             then do:
      858               assign
      859                 frame v-suppl :virtual-width = v-frame-virtual-width
      860               .
      861             end.
      862             run diasize_position-resize-button in this-procedure .
      863           end.
      864           else do:
      865             if frame v-suppl :scrollable = true
      866             then do:
      867               assign
      868                 frame v-suppl :virtual-width = v-frame-virtual-width
      869               .
      870             end.
      871             assign
      872               frame v-suppl :width = v-frame-width
      873             .
      874             for each buf_temp-browse-handle
      875               where buf_temp-browse-handle.browse-type = 'width':u
      876             on error undo, next
      877             :
      878               assign
      879                 buf_temp-browse-handle.browse-handle :width = buf_temp-browse-handle.original-size
      880               .
      881             end.
      882             assign
      883               v-diasize-browse-handle :width = v-browse-width
      884             .
      885             for each buf_temp-diasize-handle
      886             on error undo, next
      887             :
      888               assign
      889                 v-object-handle = buf_temp-diasize-handle.handle-value
      890               .
      891               if v-object-handle <> v-diasize-resize-button
      892               then do:
      893                 assign
      894                   v-object-handle :col = buf_temp-diasize-handle.save-position
      895                 .
      896               end.
      897             end.
      898             run diasize_position-resize-button in this-procedure .
      899           end.
      900           assign
      901             v-diasize-change-size = false
      902           .
      903           leave move_block .
      904         end.
      905       end.
      906       assign
      907         v-diasize-need-full-display = true
      908       .
      909       if v-diasize-change-size = false
      910       then do:
      911         assign
      912           v-diasize-change-size = true
      913         .
      914       end.
      915       else do:
      916         return .
      917       end.
      918       assign
      919         v-frame-width = frame v-suppl :width
      920         v-frame-virtual-width = frame v-suppl :virtual-width
      921         v-browse-width = v-diasize-browse-handle :width
      922       .
      923       for each buf_temp-browse-handle
      924         where buf_temp-browse-handle.browse-type = 'width':u
      925       :
      926         assign
      927           buf_temp-browse-handle.original-size = buf_temp-browse-handle.browse-handle :width
      928         .
      929       end.
      930       for each buf_temp-diasize-handle
      931       :
      932         delete buf_temp-diasize-handle .
      933       end.
      934       assign
      935         v-field-group-handle = frame v-suppl :first-child
      936       .
      937       do while valid-handle(v-field-group-handle)
      938       :
      939         assign
      940           v-object-handle = v-field-group-handle :first-child
      941         .
      942         do while valid-handle(v-object-handle)
      943         :
      944           if  v-object-handle <> v-diasize-browse-handle :handle
      945           and v-object-handle <> v-diasize-resize-button
      946           and can-query(v-object-handle, "row")
      947           and can-query(v-object-handle, "height")
      948           and ( v-object-handle :col + v-object-handle :width
      949                 > v-diasize-browse-handle :col + v-diasize-browse-handle :width
      950               )
      951           then do:
      952             find first buf_temp-browse-handle
      953               where buf_temp-browse-handle.browse-type   = 'width':u
      954                 and buf_temp-browse-handle.browse-handle = v-object-handle
      955               no-error .
      956             if available buf_temp-browse-handle
      957             then do:
      958             end.
      959             else do:
      960               create buf_temp-diasize-handle .
      961               assign
      962                 buf_temp-diasize-handle.handle-value  = v-object-handle
      963                 buf_temp-diasize-handle.save-position = v-object-handle :col
      964               .
      965             end.
      966           end.
      967           assign
      968             v-object-handle = v-object-handle :next-sibling
      969           .
      970         end.
      971         assign
      972           v-field-group-handle = v-field-group-handle :next-sibling
      973         .
      974       end.
      975       do with frame v-suppl
      976       :
      977         hide v-diasize-resize-button .
      978         v-diasize-resize-button :row = 1.
      979         v-diasize-resize-button :column = 1.
      980       end.
      981       if p-change-value > 0
      982       then do:
      983         if frame v-suppl :scrollable = true
      984         then do:
      985           assign
      986             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
      987             no-error .
      988           if error-status :error
      989           or error-status :get-message(1) <> ""
      990           then do:
      991             undo move_block, retry move_block.
      992           end.
      993         end.
      994         assign
      995           frame v-suppl :width = v-frame-width + p-change-value
      996           no-error .
      997         if error-status :error
      998         or error-status :get-message(1) <> ""
      999         then do:
     1000           undo move_block, retry move_block.
     1001         end.
     1002         assign
     1003           v-diasize-browse-handle :width = v-browse-width + p-change-value
     1004         no-error .
     1005         if error-status :error
     1006         or error-status :get-message(1) <> ""
     1007         then do:
     1008           undo move_block, retry move_block.
     1009         end.
     1010         for each buf_temp-browse-handle
     1011           where buf_temp-browse-handle.browse-type = 'width':u
     1012         on error undo move_block, retry move_block
     1013         :
     1014           assign
     1015             buf_temp-browse-handle.browse-handle :width
     1016               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1017             no-error .
     1018           if error-status :error
     1019           or error-status :get-message(1) <> ""
     1020           then do:
     1021             undo move_block, retry move_block .
     1022           end.
     1023         end.
     1024         for each buf_temp-diasize-handle
     1025         on error undo move_block, retry move_block
     1026         :
     1027           assign
     1028             v-object-handle = buf_temp-diasize-handle.handle-value
     1029           .
     1030           if v-object-handle <> v-diasize-resize-button
     1031           then do:
     1032             assign
     1033               v-object-handle :col = v-object-handle :col + p-change-value
     1034               no-error .
     1035             if error-status :error
     1036             or error-status :get-message(1) <> ""
     1037             then do:
     1038               undo move_block, retry move_block .
     1039             end.
     1040           end.
     1041         end.
     1042       end.
     1043       else do:
     1044         for each buf_temp-diasize-handle
     1045         on error undo move_block, retry move_block
     1046         :
     1047           assign
     1048             v-object-handle = buf_temp-diasize-handle.handle-value
     1049           .
     1050           if v-object-handle <> v-diasize-resize-button
     1051           then do:
     1052             assign
     1053               v-object-handle :col = v-object-handle :col + p-change-value
     1054               no-error .
     1055             if error-status :error
     1056             or error-status :get-message(1) <> ""
     1057             then do:
     1058               undo move_block, retry move_block .
     1059             end.
     1060           end.
     1061         end.
     1062         for each buf_temp-browse-handle
     1063           where buf_temp-browse-handle.browse-type = 'width':u
     1064         on error undo move_block, retry move_block
     1065         :
     1066           assign
     1067             buf_temp-browse-handle.browse-handle :width
     1068               = buf_temp-browse-handle.browse-handle :width + p-change-value
     1069             no-error .
     1070           if error-status :error
     1071           or error-status :get-message(1) <> ""
     1072           then do:
     1073             undo move_block, retry move_block .
     1074           end.
     1075         end.
     1076         assign
     1077           v-diasize-browse-handle :width = v-diasize-browse-handle :width + p-change-value
     1078           no-error .
     1079         if error-status :error
     1080         or error-status :get-message(1) <> ""
     1081         then do:
     1082           undo move_block, retry move_block.
     1083         end.
     1084         assign
     1085           frame v-suppl :width = frame v-suppl :width + p-change-value
     1086         no-error .
     1087         if error-status :error
     1088         or error-status :get-message(1) <> ""
     1089         then do:
     1090           undo move_block, retry move_block.
     1091         end.
     1092         if frame v-suppl :scrollable = true
     1093         then do:
     1094           assign
     1095             frame v-suppl :virtual-width = frame v-suppl :virtual-width + p-change-value
     1096           no-error .
     1097           if error-status :error
     1098           or error-status :get-message(1) <> ""
     1099           then do:
     1100             undo move_block, retry move_block.
     1101           end.
     1102         end.
     1103       end.
     1104       if p-move-resize
     1105       then do:
     1106         run diasize_position-resize-button in this-procedure .
     1107       end.
     1108       if v-diasize-wndstore = true
     1109       then do:
     1110         if connected("ub") = true
     1111         then do:
     1112           define variable v-cntxt-db-num        as integer   no-undo .
     1113           define variable v-cntxt-userid        as character no-undo .
     1114           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1115                                             , OUTPUT v-cntxt-userid
     1116                                             ) .
     1117           run gbl/wndsizew.p
     1118             (input  v-cntxt-db-num
     1119             ,input  v-cntxt-userid
     1120             ,input  v-diasize-proc-name
     1121             ,input  'width':u
     1122             ,input  string(frame v-suppl :width - v-diasize-orig-frame-width)
     1123             ) .
     1124         end.
     1125       end.
     1126     end.
     1127     assign
     1128       v-diasize-change-size = false
     1129     .
     1130   end procedure.
     1131   procedure diasize_set-width :
     1132     define input  parameter p-new-width  as decimal   no-undo .
     1133     define input  parameter p-move-resize as logical   no-undo .
     1134     do
     1135     on error undo, return error return-value
     1136     :
     1137       run diasize_change-width in this-procedure
     1138         (input  (p-new-width - frame v-suppl :width)
     1139         ,input  p-move-resize
     1140         ) .
     1141     end.
     1142   end procedure.
     1143   procedure diasize_position-resize-button :
     1144     do with frame v-suppl
     1145     :
     1146       hide v-diasize-resize-button .
     1147       assign
     1148         v-diasize-resize-button :row = frame v-suppl :height - v-diasize-resize-button :height
     1149                     - 1
     1150                     - (frame v-suppl :border-bottom-pixels / session :pixels-per-row)
     1151         v-diasize-resize-button :col = frame v-suppl :width - v-diasize-resize-button :width
     1152                     - 1
     1153                     - (frame v-suppl :border-right-pixels / session :pixels-per-column)
     1154       .
     1155       view v-diasize-resize-button .
     1156     end.
     1157   end procedure.
     1158   on alt-right anywhere
     1159   do:
     1160     run diasize_change-width in this-procedure
     1161       (input 1
     1162       ,input true
     1163       ) .
     1164     return no-apply .
     1165   end.
     1166   on alt-left anywhere
     1167   do:
     1168     run diasize_change-width in this-procedure
     1169       (input -1
     1170       ,input true
     1171       ) .
     1172     return no-apply .
     1173   end.
     1174   on alt-down anywhere
     1175   do:
     1176     run diasize_change-height in this-procedure
     1177       (input 1
     1178       ,input true
     1179       ) .
     1180     return no-apply .
     1181   end.
     1182   on alt-up anywhere
     1183   do:
     1184     run diasize_change-height in this-procedure
     1185       (input -1
     1186       ,input true
     1187       ) .
     1188     return no-apply .
     1189   end.
     1190   on alt-enter of frame v-suppl
     1191   do:
     1192     run diasize_maximize in this-procedure
     1193       (input  ?
     1194       ).
     1195     return no-apply .
     1196   end.
     1197   procedure diasize_end-move :
     1198     do
     1199     on error undo, return error return-value
     1200     :
     1201       define variable v-row-delta as decimal   no-undo .
     1202       define variable v-col-delta as decimal   no-undo .
     1203       define variable v-new-row as decimal   no-undo .
     1204       define variable v-new-col as decimal   no-undo .
     1205       assign
     1206         v-new-row = decimal(last-event :y) / (session :pixels-per-row)
     1207         v-new-col = decimal(last-event :x) / (session :pixels-per-column)
     1208       .
     1209       assign
     1210         v-row-delta = v-new-row - frame v-suppl :height
     1211         v-col-delta = v-new-col - frame v-suppl :width
     1212       .
     1213       run diasize_change-height in this-procedure
     1214         (input v-row-delta
     1215         ,input true
     1216         ) .
     1217       run diasize_change-width in this-procedure
     1218         (input v-col-delta
     1219         ,input true
     1220         ) .
     1221     end.
     1222   end procedure.
     1223   procedure diasize_maximize :
     1224     define input  parameter p-action as logical   no-undo .
     1225     do
     1226     on error undo, return error return-value
     1227     :
     1228       if p-action = ?
     1229       then do:
     1230         if v-diasize-need-maximize = true
     1231         then do:
     1232           assign
     1233             p-action = true
     1234           .
     1235         end.
     1236         else do:
     1237           assign
     1238             p-action = false
     1239           .
     1240         end.
     1241       end.
     1242       if p-action = true
     1243       then do:
     1244         run diasize_change-height in this-procedure
     1245           (input decimal(session :work-area-height-pixels) / session :pixels-per-row
     1246               - frame v-suppl :height-chars
     1247           ,input true
     1248           ) .
     1249         run diasize_change-width in this-procedure
     1250           (input session :width-chars
     1251               - frame v-suppl :width-chars
     1252           ,input true
     1253           ) .
     1254         assign
     1255           v-diasize-need-maximize = false
     1256         .
     1257       end.
     1258       else do:
     1259         run diasize_change-width in this-procedure
     1260           (input v-diasize-orig-frame-width
     1261               - frame v-suppl :width-chars
     1262           ,input true
     1263           ) .
     1264         run diasize_change-height in this-procedure
     1265           (input v-diasize-orig-frame-height
     1266               - frame v-suppl :height-chars
     1267           ,input true
     1268           ) .
     1269         assign
     1270           v-diasize-need-maximize = true
     1271         .
     1272       end.
     1273     end.
     1274   end procedure.
     1275   procedure diasize_restore-orig-size :
     1276     do
     1277     on error undo, return error return-value
     1278     :
     1279       assign
     1280         v-diasize-current-frame-width  = frame v-suppl :width
     1281         v-diasize-current-frame-height = frame v-suppl :height
     1282       .
     1283       run diasize_set-height in this-procedure
     1284         (input  v-diasize-orig-frame-height
     1285         ,input  true
     1286         ) .
     1287       run diasize_set-width in this-procedure
     1288         (input  v-diasize-orig-frame-width
     1289         ,input  true
     1290         ) .
     1291     end.
     1292   end procedure.
     1293   procedure diasize_restore-current-size :
     1294     do
     1295     on error undo, return error return-value
     1296     :
     1297       run diasize_set-height in this-procedure
     1298         (input  v-diasize-current-frame-height
     1299         ,input  true
     1300         ) .
     1301       run diasize_set-width in this-procedure
     1302         (input  v-diasize-current-frame-width
     1303         ,input  true
     1304         ) .
     1305     end.
     1306   end procedure.
     1307   procedure diasize_set-browse-handle :
     1308     define input  parameter p-browse-handle as handle   no-undo .
     1309     define buffer buf_temp-browse-handle for temp-browse-handle .
     1310     do
     1311     on error undo, return error return-value
     1312     :
     1313       assign
     1314         v-diasize-browse-handle = p-browse-handle
     1315       .
     1316       for each buf_temp-browse-handle
     1317       on error undo, return error return-value
     1318       :
     1319         delete buf_temp-browse-handle .
     1320       end.
     1321     end.
     1322   end procedure.
     1323   procedure diasize_add_browse :
     1324     define input  parameter p-browse-type   as character no-undo .
     1325     define input  parameter p-browse-handle as handle    no-undo .
     1326     define buffer buf_temp-browse-handle for temp-browse-handle .
     1327     do
     1328     on error undo, return error return-value
     1329     :
     1330       assign
     1331         v-diasize-browse-number = v-diasize-browse-number + 1
     1332       .
     1333       create buf_temp-browse-handle .
     1334       assign
     1335         buf_temp-browse-handle.browse-type   = p-browse-type
     1336         buf_temp-browse-handle.browse-number = v-diasize-browse-number
     1337         buf_temp-browse-handle.browse-handle = p-browse-handle
     1338       .
     1339     end.
     1340   end procedure.
     1341   procedure diasize_init :
     1342     define variable v-default-value    as logical   no-undo .
     1343     define variable v-restore-saved    as logical   no-undo .
     1344     define variable v-resize-value-str as character no-undo .
     1345     do
     1346     on error undo, return error return-value
     1347     :
     1348       do with frame v-suppl
     1349       :
     1350         assign
     1351           v-diasize-orig-frame-height = frame v-suppl :height
     1352           v-diasize-orig-frame-width  = frame v-suppl :width
     1353           v-diasize-browse-handle     = browse br-parts-brutto :handle
     1354         .
     1355         create button v-diasize-resize-button
     1356         assign
     1357           parent        = frame v-suppl :first-child
     1358           label         = "s"
     1359           height-pixels = 16
     1360           width-pixels  = 16
     1361           visible       = true
     1362           sensitive     = true
     1363           movable       = true
     1364           triggers:
     1365             on end-move persistent run diasize_end-move in this-procedure .
     1366           end triggers.
     1367         v-diasize-resize-button :load-mouse-pointer("SIZE") .
     1368         v-diasize-resize-button :load-image("exe/grip.bmp":U) .
     1369         v-diasize-resize-button :load-image-down("exe/grip.bmp":U) .
     1370         v-diasize-resize-button :load-image-insensitive("exe/grip.bmp":U) .
     1371         assign
     1372           v-diasize-wndmax = false
     1373         .
     1374         if connected("ub") = true
     1375         then do:
     1376           define variable v-cntxt-db-num        as integer   no-undo .
     1377           define variable v-cntxt-userid        as character no-undo .
     1378           RUN get-context in this-procedure ( OUTPUT v-cntxt-db-num
     1379                                             , OUTPUT v-cntxt-userid
     1380                                             ) .
     1381           run gbl/wndpar_r.p
     1382             (input  v-cntxt-db-num
     1383             ,input  v-cntxt-userid
     1384             ,input  'wndmax':U
     1385             ,output v-diasize-wndmax
     1386             ,output v-default-value
     1387             ) .
     1388         end.
     1389         assign
     1390           v-diasize-wndstore = false
     1391         .
     1392         if connected("ub") = true
     1393         then do:
     1394           run gbl/wndpar_r.p
     1395             (input  v-cntxt-db-num
     1396             ,input  v-cntxt-userid
     1397             ,input  'wndstore':U
     1398             ,output v-diasize-wndstore
     1399             ,output v-default-value
     1400             ) .
     1401         end.
     1402         assign
     1403           v-diasize-proc-name = entry(1, program-name(2), '.')
     1404         .
     1405         if v-diasize-wndstore = true
     1406         then do:
     1407           assign
     1408             v-restore-saved = false
     1409           .
     1410           if connected("ub") = true
     1411           then do:
     1412             run gbl/wndsizer.p
     1413               (input  v-cntxt-db-num
     1414               ,input  v-cntxt-userid
     1415               ,input  v-diasize-proc-name
     1416               ,input  'height':u
     1417               ,output v-resize-value-str
     1418               ) .
     1419             if v-resize-value-str <> '':U
     1420             then do:
     1421               run diasize_change-height in this-procedure
     1422                 (input  integer(v-resize-value-str)
     1423                 ,input  true
     1424                 ) .
     1425               assign
     1426                 v-restore-saved = true
     1427               .
     1428             end.
     1429           end.
     1430           if connected("ub") = true
     1431           then do:
     1432             run gbl/wndsizer.p
     1433               (input  v-cntxt-db-num
     1434               ,input  v-cntxt-userid
     1435               ,input  v-diasize-proc-name
     1436               ,input  'width':u
     1437               ,output v-resize-value-str
     1438               ) .
     1439             if v-resize-value-str <> '':U
     1440             then do:
     1441               run diasize_change-width in this-procedure
     1442                 (input  integer(v-resize-value-str)
     1443                 ,input  true
     1444                 ) .
     1445               assign
     1446                 v-restore-saved = true
     1447               .
     1448             end.
     1449           end.
     1450           if v-restore-saved <> true
     1451           then do:
     1452             if v-diasize-wndmax = true
     1453             then do:
     1454               run diasize_maximize in this-procedure
     1455                 (input  true
     1456                 ) .
     1457             end.
     1458           end.
     1459         end.
     1460         else do:
     1461           if v-diasize-wndmax = true
     1462           then do:
     1463             run diasize_maximize in this-procedure
     1464               (input  true
     1465               ) .
     1466           end.
     1467         end.
     1468       end.
     1469     end.
     1470   end procedure.
     1471   procedure diasize_need-full-display :
     1472     define output parameter p-need-full-display as logical   no-undo .
     1473     do
     1474     on error undo, return error return-value
     1475     :
     1476       assign
     1477         p-need-full-display = v-diasize-need-full-display
     1478       .
     1479       assign
     1480         v-diasize-need-full-display = false
     1481       .
     1482     end.
     1483   end procedure.
     1484   procedure get-context :
     1485      define output parameter p-db-num as integer          no-undo.
     1486      define output parameter p-user-id as character        no-undo.
     1487      define variable v-login               as character    no-undo.
     1488      define buffer buf_sys-ctrl    for ub.sys-ctrl .
     1489      define buffer buf_user-login  for ub.user-login .
     1490      do
     1491      on error undo, return error
     1492      :
     1493            FIND FIRST buf_sys-ctrl no-lock.
     1494            ASSIGN
     1495               v-login = USERID("ub")
     1496               p-db-num = buf_sys-ctrl.db-num
     1497            .
     1498            FIND FIRST buf_user-login
     1499                 WHERE buf_user-login.db-num = p-db-num
     1500                   AND buf_user-login.user-login = v-login
     1501                 no-lock
     1502                 no-error
     1503                 .
     1504            IF AVAILABLE buf_user-login
     1505            THEN DO:
     1506               assign
     1507                  p-user-id = buf_user-login.user-id
     1508               .
     1509            END.
     1510      end.
     1511   end procedure.
     1512       run diasize_init in this-procedure .
     1513   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME v-suppl:PARENT eq ?
     1514   THEN FRAME v-suppl:PARENT = ACTIVE-WINDOW.
     1515   MAIN-BLOCK:
     1516   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
     1517      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
     1518     RUN enable_UI.
     1519     FRAME v-suppl:TITLE = string( "Сводный отчет(склад МБТ- МБТ): " + string(from-date,"99/99/9999") +
     1520                                                                       " по: " + string(to-date,"99/99/9999")).
     1521     apply "entry" to br-parts-brutto in frame v-suppl.
     1522     WAIT-FOR GO OF FRAME v-suppl.
     1523   END.
     1524   RUN disable_UI.
     1525   PROCEDURE disable_UI :
     1526     HIDE FRAME v-suppl.
     1527   END PROCEDURE.
     1528   PROCEDURE enable_UI :
     1529     ENABLE b-help b-quit br-parts-brutto
     1530         WITH FRAME v-suppl.
     1531     VIEW FRAME v-suppl.
     1532     OPEN QUERY br-parts-brutto FOR EACH parts-brutto WHERE  parts-brutto.artic     = parartic AND  parts-brutto.cst-code  = parcst-code USE-INDEX fact-num.
     1533   END PROCEDURE.
