     7013   procedure print-titul :
     7014         define variable v-firm-string    as character    no-undo.
     7015     do on error undo, return error return-value :
     7016     if is-chek then do:
     7017       put stream Out_stream  "Т О В А Р Н Ы Й  Ч Е К  N " at 32 format "X(30)" .
     7018       put stream Out_stream
     7019                     v-doc-code                                                                      format "X(14)"
     7020                     "  от  "
     7021                     v-doc-date-string                                                               format "X(28)"
     7022                     skip "Продавец : " at 10 format "X(20)"
     7023                     skip v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"                     at 12   format "X(108)"
     7024                     skip "Адрес : " at 10 format "X(20)"
     7025                     skip v-torgconf-self-host-addres          at 12   format "X(108)"
     7026                     skip "Покупатель : " at 10 format "X(20)"
     7027                     skip sch_clients.obj-name at 12 format "X(40)"
     7028                     skip(1)
     7029                 .
     7030       run outretxl-write-cell-data in this-procedure (
     7031             input "h_docName":U
     7032           , input string("Т О В А Р Н Ы Й  Ч Е К  N ")
     7033       ).
     7034       run outretxl-write-cell-data in this-procedure (
     7035             input "h_docCode":U
     7036           , input v-doc-code
     7037       ).
     7038       run outretxl-write-cell-data in this-procedure (
     7039             input "h_docDate":U
     7040           , input v-doc-date-string
     7041       ).
     7042       run outretxl-write-cell-data in this-procedure (
     7043             input "h_cliFrom":U
     7044           , input "Продавец : " + v-torgconf-self-host-inn + " " + Our_Host.obj-name + ", " + Our_Object.obj-name + "(" + string(Our_Object.obj-code) + ")"
     7045       ).
     7046       run outretxl-write-cell-data in this-procedure (
     7047             input "h_cliTo":U
     7048           , input "Покупатель : " + sch_clients.obj-name
     7049       ).
     7050     end.
     7051     else do:
     7052       case t-doc.doc-type :
     7053         when 'возврат':U then do:
     7054           if t-doc.internal then put stream Out_stream  "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N " at 22 format "X(60)" .
     7055           else                   put stream Out_stream  "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я   N " at 32 format "X(50)" .
     7056           put stream Out_stream
     7057                     v-doc-code                                                                      format "X(14)"
     7058                     "  от  "
     7059                     v-doc-date-string                                                               format "X(28)"
     7060                     skip(2) "Отправитель :"                                                 at 10   format "X(20)"
     7061                     skip string( sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )  at 12   format "X(108)"
     7062                     skip "Получатель  : " at 10 format "X(20)"
     7063                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7064                     skip(1)
     7065                 .
     7066           if t-doc.internal then
     7067             run outretxl-write-cell-data in this-procedure (
     7068                 input "h_docName":U
     7069               , input "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - В О З В Р А Т  N "
     7070             ).
     7071           else
     7072             run outretxl-write-cell-data in this-procedure (
     7073                 input "h_docName":U
     7074               , input "В О З В Р А Т Н А Я   Н А К Л А Д Н А Я  N "
     7075             ).
     7076           run outretxl-write-cell-data in this-procedure (
     7077                 input "h_docCode":U
     7078               , input v-doc-code
     7079           ).
     7080           run outretxl-write-cell-data in this-procedure (
     7081                 input "h_docDate":U
     7082               , input v-doc-date-string
     7083           ).
     7084           run outretxl-write-cell-data in this-procedure (
     7085                 input "h_cliFrom":U
     7086               , input string( "Отправитель : " + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )
     7087           ).
     7088           run outretxl-write-cell-data in this-procedure (
     7089                 input "h_cliTo":U
     7090               , input "Получатель  :" + Our_Host.obj-name + ", " + Our_Object.obj-name
     7091           ).
     7092           if CostPrice then do:
     7093             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7094             run outretxl-write-cell-data in this-procedure (
     7095                 input "h_CostPrice":U
     7096               , input "Указаны УЧЕТНЫЕ цены"
     7097             ).
     7098           end.
     7099         end.
     7100         when 'спи':U then do:
     7101           put stream Out_stream
     7102                     skip(1) "С П И С А Н И Е   N "                                          at 32   format "X(22)"
     7103                     v-doc-code                                                                      format "X(14)"
     7104                     "  от  "
     7105                     v-doc-date-string                                                               format "X(28)"
     7106                     skip(2) "Отправитель  :"                                                at 10   format "X(20)"
     7107                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7108                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7109                     skip sch_clients.obj-name                                                   at 12   format "X(108)"
     7110                 .
     7111           run outretxl-write-cell-data in this-procedure (
     7112                 input "h_docName":U
     7113               , input "С П И С А Н И Е  N "
     7114           ).
     7115           run outretxl-write-cell-data in this-procedure (
     7116                 input "h_docCode":U
     7117               , input v-doc-code
     7118           ).
     7119           run outretxl-write-cell-data in this-procedure (
     7120                 input "h_docDate":U
     7121               , input v-doc-date-string
     7122           ).
     7123           run outretxl-write-cell-data in this-procedure (
     7124                 input "h_cliFrom":U
     7125               , input string( "Отправитель : " + Our_Host.obj-name + ", " + Our_Object.obj-name )
     7126           ).
     7127           run outretxl-write-cell-data in this-procedure (
     7128                 input "h_cliTo":U
     7129               , input "Получатель  :" + sch_clients.obj-name
     7130           ).
     7131         end.
     7132         when 'рас':U then do:
     7133           if  t-doc.internal then do:
     7134             assign
     7135               v-firm-string = substitute( "&1, ", Our_Host.obj-name )
     7136             .
     7137             put stream Out_stream "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - Р А С Х О Д   N " at 22 format "X(55)"  v-doc-code format "X(14)" .
     7138             run outretxl-write-cell-data in this-procedure (
     7139                 input "h_docName":U
     7140               , input "В Н У Т Р Е Н Н Е Е  ПЕРЕМЕЩЕНИЕ - Р А С Х О Д  N "
     7141             ).
     7142           end.
     7143           else do:
     7144             assign
     7145               v-firm-string = "":U
     7146             .
     7147             if t-doc.office then do:
     7148               put stream Out_stream "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г   N " at 22 format "X(70)"  v-doc-code format "X(14)" .
     7149               run outretxl-write-cell-data in this-procedure (
     7150                   input "h_docName":U
     7151                 , input "А К Т  П Р И Е М К И - П Е Р Е Д А Ч И  Р А Б О Т / У С Л У Г  N "
     7152               ).
     7153             end.
     7154             else do:
     7155               put stream Out_stream "Р А С Х О Д Н А Я   Н А К Л А Д Н А Я   N " at 32 format "X(45)" v-doc-code format "X(14)" .
     7156               run outretxl-write-cell-data in this-procedure (
     7157                   input "h_docName":U
     7158                 , input "Р А С Х О Д Н А Я   Н А К Л А Д Н А Я  N "
     7159               ).
     7160             end.
     7161           end.
     7162           put stream Out_stream
     7163                     "  от  "  v-doc-date-string                                                     format "X(28)"
     7164                     skip(1) "Отправитель  :"                                                at 10   format "X(20)"
     7165                     skip Our_Host.obj-name + ", " + Our_Object.obj-name                     at 12   format "X(108)"
     7166                     skip "Получатель   :"                                                   at 10   format "X(20)"
     7167                     skip string( v-firm-string + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )  at 12   format "X(108)"
     7168                     skip(1)
     7169                 .
     7170           run outretxl-write-cell-data in this-procedure (
     7171                 input "h_docCode":U
     7172               , input v-doc-code
     7173           ).
     7174           run outretxl-write-cell-data in this-procedure (
     7175                 input "h_docDate":U
     7176               , input v-doc-date-string
     7177           ).
     7178           run outretxl-write-cell-data in this-procedure (
     7179                 input "h_cliFrom":U
     7180               , input "Отправитель : " + Our_Host.obj-name + ", " + Our_Object.obj-name
     7181           ).
     7182           run outretxl-write-cell-data in this-procedure (
     7183                 input "h_cliTo":U
     7184               , input string( "Получатель : " + sch_clients.obj-name + "(" + string(sch_clients.obj-code) + ")" )
     7185           ).
     7186           if CostPrice then do:
     7187             put stream Out_stream space(10) "Указаны УЧЕТНЫЕ цены"      format "X(50)"  skip(2) .
     7188             run outretxl-write-cell-data in this-procedure (
     7189                 input "h_CostPrice":U
     7190               , input "Указаны УЧЕТНЫЕ цены"
     7191             ).
     7192           end.
     7193         end.
     7194       end case .
     7195       Find buf_pay-type Where buf_pay-type.Obj-code = T-doc.Pay-code No-lock No-error.
     7196       Put Stream Out_Stream String( "Вид оплаты : " + ( If Available buf_pay-type Then buf_pay-type.Obj-name Else "?" ) ) At 10 Format "X(60)" Skip.
     7197       run outretxl-write-cell-data in this-procedure (
     7198           input "h_PayType":U
     7199         , input ( If Available buf_pay-type Then buf_pay-type.Obj-name Else "?" )
     7200       ).
     7201       If V-torgconf-outprim = No or t-doc.internal Then Do:
     7202         Put Stream Out_Stream  String( "Примечание : " + ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " ) ) At 10 Format "X(100)" Skip .
     7203         run outretxl-write-cell-data in this-procedure (
     7204             input "h_PS":U
     7205           , input ( If ( Not Can-do( 'факт':U, T-doc.Status_ ) Or Logres ) And Not ( T-doc.Ps Begins "@" ) Then  T-doc.Ps Else " " )
     7206         ).
     7207       End.
     7208       run torgconf-get-reason in this-procedure ( input t-doc.doc-code, input t-doc.reason-code,  input t-doc.doc-type ) .
     7209       put stream Out_Stream
     7210           space(5) string( "Основание: " + v-torgconf-reason ) at 10 format "X(100)" skip
     7211       .
     7212       run outretxl-write-cell-data in this-procedure (
     7213             input "h_reason":U
     7214           , input v-torgconf-reason
     7215       ).
     7216       end.
     7217     end.
     7218   end procedure.
     7219   procedure print-itog :
     7220     do on error undo, return error return-value :
     7221         define variable v-oper-name    as character    no-undo.
     7222       put stream out_stream Line format "X(137)" skip .
     7223       if PrintRubl then do:
     7224         display stream out_stream
     7225           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-qnty-up @ qnty-up sym9 all-stoim @ stoim  sym10
     7226         with frame rubl.
     7227         down stream out_stream with frame rubl .
     7228       end.
     7229       else do:
     7230         display stream out_stream
     7231           sym1 sym2 sym3 sym4 "ИТОГО: " @ gds_name sym5 sym6 sym7 all-qnty @ qnty sym8 all-qnty-up @ qnty-up sym9 all-stoim @ stoim  sym10 sym11
     7232         with frame val.
     7233         down stream out_stream with frame val .
     7234       end.
     7235       put stream out_stream Line format "X(137)" skip .
     7236       run outretxl-write-cell-data in this-procedure (
     7237             input "it_qnty":U
     7238           , input string( all-qnty )
     7239       ).
     7240       run outretxl-write-cell-data in this-procedure (
     7241             input "it_qntyup":U
     7242           , input string( all-qnty-up )
     7243       ).
     7244       run outretxl-write-cell-data in this-procedure (
     7245             input "it_sum":U
     7246           , input string( all-stoim )
     7247       ).
     7248       if line-counter( Out_stream ) + 16 > page-size( Out_stream ) then  page stream Out_stream .
     7249       put stream Out_stream skip(1) space(5) "Всего " format "x(8)" all-qnty format ">,>>>,>>9.<<<"
     7250         space(2) "единицы" format "x(8)" space(2) Lines_Counter format ">,>>>,>>9" space(2) "наименований" format "x(13)"
     7251                                                 "на сумму"  all-stoim  format ">,>>>,>>>,>>>,>>9.99"  " "  ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" )
     7252         skip(1).
     7253       run outretxl-write-cell-data in this-procedure (
     7254             input "f_lineAmount":U
     7255           , input string( "Всего " + string(all-qnty,">,>>>,>>9.<<<") + " единицы " + string(Lines_Counter,">,>>>,>>9") + " наименований  на сумму " + string(all-stoim,">,>>>,>>>,>>>,>>9.99") + " " +  ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" ) )
     7256       ).
     7257       if v-torgconf-outdisc = no and not CostPrice then do:
     7258         put stream Out_stream space(5) "Скидка " format "x(8)"
     7259           ( if t-doc.tot-calc <> 0 and t-doc.discnt-pc = 0 then " " else string( string( t-doc.discnt-pc, "->>9.9" ) + "%" ) )
     7260           space(2) "на сумму"                                                        format "x(10)"
     7261           space(2) ( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl )   format "->>>,>>>,>>>,>>9.99"
     7262           space(2) ( if not PrintRubl then buf_currency.curr-abbr else "РУБ" )                    format "x(4)" skip(1)
     7263         .
     7264         if t-doc.discnt-pc <> 0 then
     7265           run outretxl-write-cell-data in this-procedure (
     7266                 input "f_Skidka":U
     7267               , input string( "Скидка " + string( t-doc.discnt-pc, "->>9.9" ) + "%  на сумму  "  + string(( if not PrintRubl then t-doc.tot-calc else t-doc.discnt-rubl ),"->>>,>>>,>>>,>>9.99") )
     7268           ).
     7269       end.
     7270       run rep/get-psn.p
     7271         (input t-doc.boss
     7272         ,output boss-name
     7273         ) .
     7274       run rep/get-psn.p
     7275         (input t-doc.wrkr
     7276         ,output Wrkr_name
     7277         ) .
     7278   define variable vss-include-info43 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7279   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run usrnick in g#library
     7280     (input  t-doc.creid
     7281     ,output v-oper-name
     7282     )  .
     7283       if can-do( 'факт':U , t-doc.status_ ) or
     7284          ( can-do( 'рас':U , t-doc.doc-type ) and can-do( 'накл,запрос':U , t-doc.status_ ) and
     7285          ( not t-doc.internal ) ) then do:
     7286         if not PrintRubl then run rep/wp.p (     input ParParentProc, input all-stoim, output s1, output s2 ) .
     7287         else                  run rep/wp-rub.p (                      input all-stoim, output s1, output s2 ) .
     7288         if can-do( 'возврат':U , t-doc.doc-type ) then put stream Out_stream space(5) "Итого " format "x(6)" .
     7289         else                                         put stream Out_stream space(5) "Итого к оплате " format "x(17)" .
     7290         if v-torgconf-outdisc = no and not CostPrice then put stream Out_stream "( с учетом скидки ) " format "x(22)" .
     7291         put stream Out_stream all-stoim format "->>>,>>>,>>>,>>9.99" space(1) trim(s2) format "x(4)".
     7292         run outretxl-write-cell-data in this-procedure (
     7293               input "f_SumAll":U
     7294             , input string( all-stoim,"->>>,>>>,>>>,>>9.99")
     7295         ).
     7296         run outretxl-write-cell-data in this-procedure (
     7297               input "f_SumAllLiteral":U
     7298             , input s1
     7299         ).
     7300         put stream Out_stream skip(1) space(10) caps(s1) format "x(126)" skip(1) .
     7301         put stream Out_stream  space(5)  "В том числе: " format "x(25)" skip.
     7302         define variable str-nal as character no-undo .
     7303         for each temp-nalog break by temp-nalog.slt-prc by temp-nalog.vat-prc:
     7304           put stream Out_stream
     7305               string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) at 10 format "X(12)"
     7306               ":"  + string( temp-nalog.VAT-sum , "->>>,>>>,>>9.99" ) at 25 format "X(18)"   trim(s2)  " от суммы " format "X(10)"
     7307                string( temp-nalog.from-sum , "->>>,>>>,>>9.99" )  at 65 format "X(16)"   trim(s2) skip
     7308           .
     7309           if str-nal <> "" then assign str-nal = str-nal + "\n" .
     7310           assign
     7311             str-nal = str-nal +
     7312             string( "НДС " + string( temp-nalog.vat-prc, ">>9.<<%")) +  ":" + string( temp-nalog.VAT-sum , "->>,>>>,>>9.99" ) + " " + trim(s2) + " от суммы "
     7313             + string( temp-nalog.from-sum , "->>>,>>>,>>9.99" ) + " " + trim(s2)
     7314           .
     7315         end.
     7316         run outretxl-write-cell-data in this-procedure (
     7317               input "f_Nalog":U
     7318             , input str-nal
     7319         ).
     7320         if is-chek then do:
     7321           put stream Out_stream space(10)  "М П" format "x(60)"  "Подпись : " format "x(50)" skip(1) .
     7322         end.
     7323         else do:
     7324           if can-do( 'рас':U , t-doc.doc-type ) and ( not t-doc.internal )
     7325               and ( ( can-do( 'запрос':U , t-doc.status_ )
     7326               or ( can-do( 'накл':U , t-doc.status_ ) and t-doc.flag_ ) ) )
     7327               or t-doc.status_ = 'факт':U
     7328           then do:
     7329             if t-doc.office then do:
     7330               put stream Out_stream  "Заказчик :    ______________/_____________ / " space(20)  "Исполнитель : ______________/_____________ /"  .
     7331             end.
     7332             else do:
     7333               find first buf_doc-attr where buf_doc-attr.doc-code = v-doc-code and buf_doc-attr.attr-code = "t_accept-fname":U   no-error .
     7334               if available buf_doc-attr then do :
     7335                   assign
     7336                         v-accept-fname = buf_doc-attr.attr-value
     7337                         .
     7338               end.
     7339               find first buf_doc-attr where buf_doc-attr.doc-code = v-doc-code and buf_doc-attr.attr-code = "t_accept-position":U   no-error .
     7340               if available buf_doc-attr then do :
     7341                   assign
     7342                       v-accept-fname = buf_doc-attr.attr-value + " " + v-accept-fname.
     7343               end.
     7344               find first buf_doc-attr where buf_doc-attr.doc-code = v-doc-code and buf_doc-attr.attr-code = "t_pass-fname":U   no-error .
     7345               if available buf_doc-attr then do :
     7346                   assign
     7347                         v-pass-fname = buf_doc-attr.attr-value
     7348                         .
     7349               end.
     7350               else do:
     7351                   assign
     7352                         v-pass-fname = Wrkr_name
     7353                         .
     7354               end.
     7355               if v-pass-fname ne Wrkr_name then do:
     7356                 find first buf_doc-attr where buf_doc-attr.doc-code = v-doc-code and buf_doc-attr.attr-code = "t_pass-position":U   no-error .
     7357                   if available buf_doc-attr then do:
     7358                       assign
     7359                         v-pass-fname = buf_doc-attr.attr-value + " " + v-pass-fname
     7360                         .
     7361                   end.
     7362               end.
     7363               put stream Out_stream space(10)  "Сдал : " v-pass-fname format "x(40)"  "Принял : " v-accept-fname format "x(30)" skip(1) .
     7364             end.
     7365           end.
     7366           else do:
     7367             put stream Out_stream space(30) "--- Н Е   П О Д П И С Ы В А Т Ь ! ---" format "X(75)" skip(1) .
     7368           end.
     7369         end.
     7370       end.
     7371       if boss-name = "?" then boss-name = "" .
     7372       if Wrkr_name = "?" then Wrkr_name = "" .
     7373       put stream Out_stream "Документ оформил: " skip  "Оператор: "  v-oper-name  skip "Кладовщик: "  Wrkr_name skip "Менеджер: "  boss-name skip.
     7374       run outretxl-write-cell-data in this-procedure (
     7375             input "f_OperName":U
     7376           , input v-oper-name
     7377       ).
     7378       run outretxl-write-cell-data in this-procedure (
     7379             input "f_KladName":U
     7380           , input Wrkr_name
     7381       ).
     7382       run outretxl-write-cell-data in this-procedure (
     7383             input "f_MngrName":U
     7384           , input boss-name
     7385       ).
     7386       run outretxl-write-cell-data in this-procedure (
     7387             input "f_PassFname":U
     7388           , input v-pass-fname
     7389       ).
     7390          run outretxl-write-cell-data in this-procedure (
     7391             input "f_AcceptFname":U
     7392           , input v-accept-fname
     7393       ).
     7394       put stream Out_stream space(65) ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )  format "X(10)"  skip .
     7395       run outretxl-write-cell-data in this-procedure (
     7396             input "f_Date":U
     7397           , input ( if v-torgconf-outdate = no then string( t-doc.fact-date, "99/99/9999" ) else "" )
     7398       ).
     7399       hide stream Out_stream frame Bottomframe .
     7400     end.
     7401   end procedure.
