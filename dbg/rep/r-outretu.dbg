     5733   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5734   DEFINE temp-table temp-nalog no-undo
     5735     field   slt-prc          as  decimal
     5736     field   vat-prc          as  decimal
     5737     field   slt-sum          as  decimal
     5738     field   vat-sum          as  decimal
     5739     field   from-sum         as  decimal
     5740     INDEX pi  IS PRIMARY   vat-prc slt-prc
     5741   .
     5742   do
     5743   on error undo, return error
     5744   :
     5745     define variable g#report-num as integer   no-undo .
     5746     run get-report-num  in parParentProc ( output g#report-num ) .
     5747   def var vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5748   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     5749   procedure paramls-clear :
     5750     define buffer buf_temp-param for temp-param .
     5751     do
     5752     on error undo, return error return-value
     5753     :
     5754       for each buf_temp-param
     5755       on error undo, return error
     5756       :
     5757         delete buf_temp-param .
     5758       end.
     5759     end.
     5760   end procedure.
     5761   procedure paramls-write :
     5762     define input  parameter p-code     as character no-undo .
     5763     define input  parameter p-sub-code as character no-undo .
     5764     define input  parameter p-value    as character no-undo .
     5765     define buffer buf_temp-param for temp-param .
     5766     do
     5767     on error undo, return error return-value
     5768     :
     5769       find first buf_temp-param
     5770         where buf_temp-param.param-code     = p-code
     5771           and buf_temp-param.param-sub-code = p-sub-code
     5772         no-error .
     5773       if not available buf_temp-param then do:
     5774         create buf_temp-param .
     5775         assign
     5776           buf_temp-param.param-code     = p-code
     5777           buf_temp-param.param-sub-code = p-sub-code
     5778         .
     5779       end.
     5780       assign
     5781         buf_temp-param.param-value = p-value
     5782       .
     5783     end.
     5784   end procedure.
     5785   procedure paramls-read :
     5786     define input  parameter p-code          as character no-undo .
     5787     define input  parameter p-sub-code      as character no-undo .
     5788     define input  parameter p-default-value as character no-undo .
     5789     define output parameter p-value         as character no-undo .
     5790     define buffer buf_temp-param for temp-param .
     5791     do
     5792     on error undo, return error return-value
     5793     :
     5794       find first buf_temp-param
     5795         where buf_temp-param.param-code     = p-code
     5796           and buf_temp-param.param-sub-code = p-sub-code
     5797         no-error .
     5798       if available buf_temp-param then do:
     5799         assign
     5800           p-value = buf_temp-param.param-value
     5801         .
     5802       end.
     5803       else do:
     5804         assign
     5805           p-value = p-default-value
     5806         .
     5807       end.
     5808     end.
     5809   end procedure.
     5810   procedure paramls-append :
     5811     define input  parameter p-code     as character no-undo .
     5812     define input  parameter p-sub-code as character no-undo .
     5813     define input  parameter p-value    as character no-undo .
     5814     define buffer buf_temp-param for temp-param .
     5815     do
     5816     on error undo, return error return-value
     5817     :
     5818       find first buf_temp-param
     5819            where buf_temp-param.param-code     = p-code
     5820              and buf_temp-param.param-sub-code = p-sub-code
     5821         no-error .
     5822       if not available buf_temp-param then do:
     5823         create buf_temp-param .
     5824         assign
     5825           buf_temp-param.param-code     = p-code
     5826           buf_temp-param.param-sub-code = p-sub-code
     5827           buf_temp-param.param-value    = p-value
     5828         .
     5829       end.
     5830       else do:
     5831           assign
     5832               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     5833           .
     5834       end.
     5835     end.
     5836   end procedure.
     5837   define variable vss-include-info30 as character format "X(65)" no-undo
     5838   initial "@(#)$Workfile$ $Revision$".
     5839   define stream excel-line.
     5840   define stream excel-cell.
     5841   define temp-table temp_cell-data no-undo
     5842       field data-key as character
     5843       field data-value as character
     5844       index pi is primary unique data-key
     5845   .
     5846   define temp-table temp_line-data no-undo
     5847       field data-key     as character
     5848       field xl-line-id   as integer
     5849       field ID           as integer
     5850       field gdscode      as character
     5851       field artic        as character
     5852       field Name         as character
     5853       field EI           as character
     5854       field price        as character
     5855       field qnty         as character
     5856       field qntyup       as character
