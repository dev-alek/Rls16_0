     1256               .
     1257           end.
     1258        assign
     1259         v-name = p-form-name.
     1260   end.
     1261   end.
     1262   end procedure.
     1263   procedure torgconf-get-self-param :
     1264   define input parameter p-obj-type           as character        no-undo.
     1265   define input parameter p-obj-code           as integer          no-undo.
     1266   define input parameter p-curr-code          as integer          no-undo.
     1267       define variable v-host-code    as integer      no-undo.
     1268       define variable v-par-type     as character    no-undo.
     1269   do
     1270   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1271   :
     1272   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1273   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1274     (input  p-obj-type
     1275     ,input  p-obj-code
     1276     ,output v-host-code
     1277     )  .
     1278       if v-torgconf-outhold = yes
     1279       then do:
     1280           run torgconf-get-holdfirm-code in this-procedure (
     1281                 input p-obj-type
     1282               , input p-obj-code
     1283               , output v-torgconf-self-host-code
     1284           ).
     1285           if v-torgconf-self-host-code = 0
     1286           then do:
     1287               return error.
     1288           end.
     1289       end.
     1290       else do:
     1291           assign
     1292               v-torgconf-self-host-code = v-host-code
     1293           .
     1294       end.
     1295       if v-torgconf-self-host-code = 0
     1296       then do:
     1297           assign
     1298               v-torgconf-self-host-name           = "":U
     1299               v-torgconf-self-host-addres         = "":U
     1300               v-torgconf-self-host-post-addres    = "":U
     1301               v-torgconf-self-host-phone          = "":U
     1302               v-torgconf-self-host-inn            = "":U
     1303               v-torgconf-self-host-kpp            = "":U
     1304               v-torgconf-self-host-okpo           = "":U
     1305               v-torgconf-self-host-egrip-date     = "":U
     1306               v-torgconf-self-host-egrip-num      = "":U
     1307           .
     1308       end.
     1309       else do:
     1310           run fmtcli-get-client in this-procedure (
     1311                 input 'орг':U
     1312               , input v-torgconf-self-host-code
     1313           ).
     1314           assign
     1315               v-torgconf-self-host-name        = v-fmtcli-name
     1316               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1317               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1318               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1319               v-torgconf-self-host-phone       = v-fmtcli-phone
     1320               v-torgconf-self-host-inn         = v-fmtcli-inn
     1321               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1322               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1323           .
     1324           run gbl/clntat-v.p (
     1325                 input 'орг':U
