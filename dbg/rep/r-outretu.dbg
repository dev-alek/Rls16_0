     5860   .
     5861   define variable v-outretxl-current-data-row     as integer      no-undo.
     5862   define variable v-outretxl-cell-file-name       as character    no-undo.
     5863   define variable v-outretxl-data-file-name       as character    no-undo.
     5864   procedure outretxl-init :
     5865       define buffer buf_temp_cell-data        for temp_cell-data.
     5866   do
     5867   for buf_temp_cell-data on error undo, return error :
     5868       assign
     5869           v-outretxl-current-data-row = 0
     5870       .
     5871       run gbl/_tmpfile.p
     5872         (input  "xd"
     5873         ,input  ".txt"
     5874         ,output v-outretxl-data-file-name
     5875         ).
     5876       output stream excel-line to value( v-outretxl-data-file-name ).
     5877       run gbl/_tmpfile.p
     5878         (input "xc"
     5879         ,input ".txt"
     5880         ,output v-outretxl-cell-file-name
     5881         ).
     5882       output stream excel-cell to value( v-outretxl-cell-file-name ).
     5883       if printrubl
     5884       then do:
     5885           run outretxl-write-cell-data in this-procedure
     5886             (input "valutCode":U
     5887             ,input "0":U
     5888             ).
     5889       end.
     5890       else do:
     5891           run outretxl-write-cell-data in this-procedure (
     5892                 input "valutCode":U
     5893               , input "1":U
     5894           ).
     5895       end.
     5896       run outretxl-write-cell-data in this-procedure (
     5897             input "regularExpressions":U
     5898           , input "1":U
     5899       ).
     5900       run outretxl-write-cell-data in this-procedure (
     5901             input "columnList":U
     5902           , input "ID,gdscode,artic,Name,EI,price,qnty,qntyup,qntycart,sum":U
     5903       ).
     5904       run outretxl-write-cell-data in this-procedure (
     5905             input "columnType":U
     5906           , input "I,I,S,S,S,D,D,D,D,D":U
     5907       ).
     5908       run outretxl-write-cell-data in this-procedure (
     5909             input "columnAmount":U
     5910           , input "10":U
     5911       ).
     5912       run outretxl-write-cell-data in this-procedure (
     5913             input "subtotalList":U
     5914           , input "qnty,qntyup,sum":U
     5915       ).
     5916       run outretxl-write-cell-data in this-procedure (
     5917             input "subtotalType":U
     5918           , input "D,D,D":U
     5919       ).
     5920       run outretxl-write-cell-data in this-procedure (
     5921             input "subtotalAmount":U
     5922           , input "3":U
     5923       ).
     5924   end.
     5925   end procedure.
     5926   procedure outretxl-close :
     5927   do
     5928   on error undo, return error
     5929   :
     5930       output stream excel-line close.
     5931       output stream excel-cell close.
     5932       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     5933           export "exe/nou_97.xlt":U.
     5934           export "exe/t_97.bas":U.
     5935           export v-outretxl-cell-file-name.
     5936           export v-outretxl-data-file-name.
     5937       output close.
     5938   end.
     5939   end procedure.
     5940   procedure outretxl-write-cell-data :
     5941   define input parameter p-data-key   as character        no-undo.
     5942   define input parameter p-data-value as character        no-undo.
     5943       define buffer buf_temp_cell-data     for temp_cell-data.
     5944   do
     5945   for buf_temp_cell-data
     5946   on error undo, return error
     5947   :
     5948       find first buf_temp_cell-data
     5949            where buf_temp_cell-data.data-key = p-data-key
     5950       no-error.
     5951       if not available buf_temp_cell-data
     5952       then do:
     5953           create buf_temp_cell-data.
     5954           assign
     5955               buf_temp_cell-data.data-key = p-data-key
     5956           .
     5957       end.
     5958       assign
     5959           buf_temp_cell-data.data-value = p-data-value
     5960       .
     5961       put stream excel-cell unformatted
     5962                           buf_temp_cell-data.data-key
     5963           chr(9)   buf_temp_cell-data.data-value
     5964           chr(10)
     5965       .
     5966   end.
     5967   end procedure.
     5968   procedure outretxl-write-line-data :
     5969   define input parameter p-ID             as integer          no-undo.
     5970   define input parameter p-gdscode        as character        no-undo.
     5971   define input parameter p-artic          as character        no-undo.
     5972   define input parameter p-Name           as character        no-undo.
     5973   define input parameter p-EI             as character        no-undo.
     5974   define input parameter p-price          as character        no-undo.
     5975   define input parameter p-qnty           as character        no-undo.
     5976   define input parameter p-qntyup         as character        no-undo.
     5977   define input parameter p-qntycart       as character        no-undo.
     5978   define input parameter p-sum            as character        no-undo.
     5979       define buffer buf_temp_line-data        for temp_line-data.
     5980   do
     5981   for buf_temp_line-data
     5982   on error undo, return error
     5983   :
     5984       for each buf_temp_line-data
     5985       :
     5986           delete buf_temp_line-data.
     5987       end.
     5988       create buf_temp_line-data.
     5989       assign
     5990           v-outretxl-current-data-row = v-outretxl-current-data-row + 1
     5991       .
     5992       assign
     5993           buf_temp_line-data.data-key     = "LD":U
     5994           buf_temp_line-data.xl-line-id   = v-outretxl-current-data-row
     5995           buf_temp_line-data.id           = p-id
     5996           buf_temp_line-data.gdscode      = p-gdscode
     5997           buf_temp_line-data.artic        = p-artic
     5998           buf_temp_line-data.Name         = p-Name
     5999           buf_temp_line-data.EI           = p-EI
     6000           buf_temp_line-data.price        = p-price
     6001           buf_temp_line-data.qnty         = p-qnty
     6002           buf_temp_line-data.qntyup       = p-qntyup
     6003           buf_temp_line-data.qntycart     = p-qntycart
     6004           buf_temp_line-data.sum          = p-sum
     6005       .
     6006       put stream excel-line unformatted
     6007                           buf_temp_line-data.data-key
     6008           chr(9)   ( if buf_temp_line-data.id = 0 then "":U else string( buf_temp_line-data.id ) )
     6009           chr(9)   buf_temp_line-data.gdscode
     6010           chr(9)   buf_temp_line-data.artic
     6011           chr(9)   buf_temp_line-data.Name
     6012           chr(9)   buf_temp_line-data.EI
     6013           chr(9)   buf_temp_line-data.price
     6014           chr(9)   buf_temp_line-data.qnty
     6015           chr(9)   buf_temp_line-data.qntyup
     6016           chr(9)   buf_temp_line-data.qntycart
     6017           chr(9)   buf_temp_line-data.sum
     6018           chr(10)
     6019       .
     6020   end.
     6021   end procedure.
     6022   procedure outretxl-run-excel :
     6023     define input parameter p-header-filename    as character        no-undo.
     6024     define input parameter p-data-filename      as character        no-undo.
     6025     define variable v-template-file-name    as character    no-undo.
     6026     define variable v-vb-file-name          as character    no-undo.
     6027     define buffer buf_temp-param for temp-param .
     6028     do for buf_temp-param on error undo, return error :
     6029       create buf_temp-param.
     6030       assign
     6031           v-template-file-name    = search( "exe/nou_97.xlt" )
     6032           v-vb-file-name          = search( "exe/t_97.bas")
     6033       .
     6034       if v-template-file-name = ?  or v-template-file-name = "":U  then do:
     6035           message  "Ошибка имени файла шаблона." view-as alert-box error.
     6036       end.
     6037       if v-vb-file-name = ?  or v-vb-file-name = "":U then do:
     6038           message  "Ошибка имени файла кода обработки."   view-as alert-box error.
     6039       end.
     6040       run paramls-write in this-procedure (
     6041             input "template":U
     6042           , input "template-file-name":U
     6043           , input v-template-file-name
     6044       ).
     6045       run paramls-write in this-procedure (
     6046             input "template":U
     6047           , input "vb-file-name":U
     6048           , input v-vb-file-name
     6049       ).
     6050       run paramls-write in this-procedure (
     6051             input "data":U
     6052           , input "data-header-filename":U
     6053           , input p-header-filename
     6054       ).
     6055       run paramls-write in this-procedure (
     6056             input "data":U
     6057           , input "data-filename":U
     6058           , input p-data-filename
     6059       ).
     6060       run gbl/macroxlt.p (
     6061           input-output table buf_temp-param
     6062       ) no-error.
     6063       if error-status :error
     6064       then do:
     6065           message vss-workfile vss-revision vss-description skip(1)
     6066               skip "Ошибка создания файла Excel."
     6067               skip return-value
     6068               skip trim(error-status :get-message(1))
     6069                    trim(error-status :get-message(2))
     6070                    trim(error-status :get-message(3))
     6071           view-as alert-box error.
     6072           undo, return error .
     6073       end.
     6074     end.
     6075   end procedure.
