     5524     (buffer bf_parts
     5525     ,output v-b-pcode
     5526     ) no-error .
     5527   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5528   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     5529     (input  bf_parts.obj-type
     5530     ,input  bf_parts.obj-code
     5531     ,input  v-b-pcode
     5532     ,input  0
     5533     ,input  bf_trn-doc.fact-order
     5534     ,output vardoc-num
     5535     ,output varprice-salef
     5536     ,output varroad-tax
     5537     ,output varexcise
     5538     ) no-error .
     5539             if varprice-sale = ?
     5540             then do:
     5541               assign
     5542                 varprice-salef = 0
     5543                 varroad-tax   = 0
     5544                 varexcise     = 0
     5545               .
     5546             end.
     5547             assign
     5548             part-cur-base  = varprice-salef
     5549             part-cur-road-tax  = varroad-tax
     5550             part-cur-excise = varexcise.
     5551         end.
     5552       end.
     5553       run clcprtsl_calc-ttable in this-procedure
     5554         (input yes,
     5555          input yes,
     5556          input bf_doc-line.road-tax,
     5557          input bf_doc-line.excise,
     5558          input bf_doc-line.vat-pc,
     5559          input bf_doc-line.cons-vat-pc,
     5560          input bf_doc-line.slt-pc,
     5561          input bf_trn-doc.base-rate,
     5562          input bf_trn-doc.base-scale,
