     6723     )  .
     6724   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     6725     (input  v-root-node
     6726     ,input  'empty-scale=request'
     6727     ,output empty-scale
     6728     )  .
     6729       run clcprtsl_calc-line in this-procedure (input recid (buf_doc-line)).
     6730       find first tt-allsum-line where tt-allsum-line.sum-type = 'основная_сумма':U no-error .
     6731       if CostPrice then do:
     6732         if PrintRubl then do:
     6733           assign stoim = tt-allsum-line.sum-dsc-rubl-acc  SLT-sum = tt-allsum-line.slt-rubl-acc  VAT-sum = tt-allsum-line.vat-rubl-acc .
     6734         end.
     6735         else do:
     6736           assign stoim = tt-allsum-line.sum-dsc-base-acc  SLT-sum = tt-allsum-line.slt-base-acc  VAT-sum = tt-allsum-line.vat-base-acc .
     6737         end.
     6738       end.
     6739       else do:
     6740         if PrintRubl then do:
     6741           assign stoim = tt-allsum-line.sum-dsc-rubl-doc  SLT-sum = tt-allsum-line.slt-rubl-doc  VAT-sum = tt-allsum-line.vat-rubl-buyer-doc .
     6742         end.
     6743         else do:
     6744           assign stoim = tt-allsum-line.sum-dsc-base-doc  SLT-sum = tt-allsum-line.slt-base-doc  VAT-sum = tt-allsum-line.vat-base-buyer-doc .
     6745         end.
     6746       end.
     6747       if g#gds-engl then assign gds_name = buf_goods.engl-name.
     6748       else               assign gds_name = buf_goods.gds-name.
     6749       assign
     6750         Lines_Counter = Lines_Counter + 1
     6751         tb-code = string(b-code)
     6752         qnty    = buf_doc-line.fact-qnty
     6753         qnty-cart = buf_goods.qnty-cart
     6754         qnty-up = qnty / qnty-cart
     6755         all-qnty-up = all-qnty-up + qnty-up
     6756         Price   = stoim / qnty
     6757         all-qnty    = all-qnty    + qnty
     6758         all-stoim   = all-stoim   + stoim
     6759         all-SLT-sum = all-SLT-sum + SLT-sum
     6760         all-VAT-sum = all-VAT-sum + VAT-sum
     6761         v-vat-pc = round(buf_doc-line.vat-pc,1)
     6762         v-slt-pc = round(buf_doc-line.slt-pc,1)
     6763       .
