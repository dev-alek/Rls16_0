     4119   do on error undo, return error return-value :
     4120   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     4121   for each bf_tt-allsum on error undo, return error return-value :
     4122     delete bf_tt-allsum.
     4123   end.
     4124   assign
     4125     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     4126     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     4127   .
     4128   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4130     (output varinvprbcl
     4131     )  .
     4132     if cl_tt-clcparts.out-code = 'free-zone':U     or
     4133        cl_tt-clcparts.out-code = 'out-zone':U   or
     4134        cl_tt-clcparts.doc-type = 'акт':U then do:
     4135       assign
     4136         in-vatp-have-vat-sltcl = yes.
     4137     end.
     4138     else do:
     4139       find first in-vatp_doc-attrcl no-lock
     4140         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     4141           and in-vatp_doc-attrcl.attr-code = 'envd':U
     4142         no-error .
     4143       if not available in-vatp_doc-attrcl then do:
     4144         assign
     4145           in-vatp-have-vat-sltcl = yes.
     4146       end.
     4147       else do:
     4148            in-vatp-have-vat-sltcl = no.
     4149       end.
     4150     end.
     4151     assign
     4152      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     4153      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     4154     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     4155              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     4156     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     4157             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     4158             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     4159             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
