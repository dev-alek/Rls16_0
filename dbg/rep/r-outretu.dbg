     5565          input varcur-road-tax,
     5566          input varcur-excise,
     5567          input varcur-vat-pc,
     5568          input varcur-cons-vat-pc,
     5569          input varcur-slt-pc
     5570          ) no-error.
     5571       if error-status:error then do:
     5572         message
     5573           vss-workfile vss-revision vss-description skip
     5574           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     5575           return-value skip
