     6694         underline stream out_stream buf_goods.artic gds_name with frame val .
     6695       end.
     6696       else do:
     6697         display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ gds_name sym10 with frame rubl .
     6698         down stream out_stream 1 with frame rubl .
     6699         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6700       end.
     6701     end.
     6702   end procedure.
