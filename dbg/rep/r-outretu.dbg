     5497         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     5498       end.
     5499       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     5500       assign
     5501         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     5502       if varcur-cons-vat-pc = ? then do:
