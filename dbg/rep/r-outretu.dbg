     6667         down stream out_stream 1 with frame val .
     6668         underline stream out_stream buf_goods.artic gds_name with frame val .
     6669       end.
     6670       else do:
     6671         display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ gds_name sym10 with frame rubl .
     6672         down stream out_stream 1 with frame rubl .
     6673         underline stream out_stream buf_goods.artic gds_name with frame rubl .
     6674       end.
     6675     end.
     6676   end procedure.
