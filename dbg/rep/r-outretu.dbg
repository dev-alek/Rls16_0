     1603   procedure torgconf-get-sup-param :
     1604   define input parameter p-obj-type           as character        no-undo.
     1605   define input parameter p-obj-code           as integer          no-undo.
     1606   define input parameter p-curr-code          as integer          no-undo.
     1607       define variable v-host-code    as integer      no-undo.
     1608       define variable v-par-type     as character    no-undo.
     1609   do
     1610   on error undo, return error
     1611   :
     1612       assign
     1613          v-torgconf-sup-host-code = v-host-code
     1614       .
     1615       if v-torgconf-sup-host-code = 0
     1616       then do:
     1617           assign
     1618               v-torgconf-sup-host-name           = "":U
     1619               v-torgconf-sup-host-addres         = "":U
     1620               v-torgconf-sup-host-post-addres    = "":U
     1621               v-torgconf-sup-host-phone          = "":U
     1622               v-torgconf-sup-host-inn            = "":U
     1623               v-torgconf-sup-host-kpp            = "":U
     1624               v-torgconf-sup-host-okpo           = "":U
     1625               v-torgconf-sup-host-egrip-date     = "":U
     1626               v-torgconf-sup-host-egrip-num      = "":U
     1627           .
     1628       end.
     1629       else do:
     1630           run fmtcli-get-client in this-procedure (
     1631                 input 'орг':U
     1632               , input v-torgconf-sup-host-code
     1633           ).
     1634           assign
     1635               v-torgconf-sup-host-name        = v-fmtcli-name
     1636               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1637               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1638               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1639               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1640               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1641               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1642               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1643           .
     1644           run gbl/clntat-v.p (
     1645                 input 'орг':U
     1646               , input v-torgconf-sup-host-code
     1647               , input 'egrip-date':U
     1648               , output v-torgconf-sup-host-egrip-date
     1649               , output v-par-type
     1650           ).
     1651           run gbl/clntat-v.p (
     1652                 input 'орг':U
     1653               , input v-torgconf-sup-host-code
     1654               , input 'egrip-num':U
     1655               , output v-torgconf-sup-host-egrip-num
     1656               , output v-par-type
     1657           ).
     1658           run fmtcli-get-bank in this-procedure (
     1659                 input v-host-code
     1660               , input 'орг':U
     1661               , input v-torgconf-sup-host-code
     1662               , input p-curr-code
     1663           ).
     1664       end.
     1665       assign
     1666           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1667           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1668           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1669           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1670           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1671           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1672           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1673           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1674       .
     1675       assign
     1676           v-torgconf-sup-obj-type = p-obj-type
     1677           v-torgconf-sup-obj-code = p-obj-code
     1678       .
     1679       if trim(p-obj-type) <> ""
     1680       and p-obj-code <> 0
     1681       then do:
     1682       run fmtcli-get-client in this-procedure (
     1683             input p-obj-type
     1684           , input p-obj-code
     1685       ).
     1686       assign
     1687           v-torgconf-sup-obj-name        = v-fmtcli-name
     1688           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1689           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1690           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1691           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1692           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1693           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1694       .
     1695      end.
     1696      end.
     1697   end procedure.
     1698   procedure torgconf-get-cli-param :
     1699   define input parameter p-host-obj-code      as integer          no-undo.
     1700   define input parameter p-obj-type           as character        no-undo.
     1701   define input parameter p-obj-code           as integer          no-undo.
     1702   define input parameter p-curr-code          as integer          no-undo.
     1703       define variable v-host-code    as integer      no-undo.
     1704   do
     1705   on error undo, return error
     1706   :
     1707       assign
     1708           v-torgconf-cli-type = p-obj-type
     1709           v-torgconf-cli-code = p-obj-code
     1710       .
     1711       run fmtcli-get-client in this-procedure (
     1712             input p-obj-type
     1713           , input p-obj-code
     1714       ).
     1715       assign
     1716           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1717           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1718           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1719           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1720           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1721           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1722           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1723           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1724       .
     1725      run fmtcli-get-bank in this-procedure (
     1726             input p-host-obj-code
     1727           , input p-obj-type
     1728           , input p-obj-code
     1729           , input p-curr-code
     1730       ).
     1731       assign
     1732           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1733           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1734           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1735           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1736           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1737           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1738           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1739           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1740       .
     1741   end.
     1742   end procedure.
     1743   procedure torgconf-get-ship-param :
     1744   define input parameter p-host-obj-code      as integer          no-undo.
     1745   define input parameter p-obj-type           as character        no-undo.
     1746   define input parameter p-obj-code           as integer          no-undo.
     1747   define input parameter p-curr-code          as integer          no-undo.
     1748       define variable v-host-code    as integer      no-undo.
     1749   do
     1750   on error undo, return error
     1751   :
     1752       assign
     1753           v-torgconf-ship-type = p-obj-type
     1754           v-torgconf-ship-code = p-obj-code
     1755       .
     1756       if trim(p-obj-type) = ""
     1757       and p-obj-code = 0
     1758       then do:
     1759       assign
     1760           v-torgconf-ship-name         = "":U
     1761           v-torgconf-ship-addres       = "":U
     1762           v-torgconf-ship-post-addres  = "":U
     1763           v-torgconf-ship-phone        = "":U
     1764           v-torgconf-ship-inn          = "":U
     1765           v-torgconf-ship-kpp          = "":U
     1766           v-torgconf-ship-okpo         = "":U
     1767       .
     1768       end.
     1769       else do:
     1770       run fmtcli-get-client in this-procedure (
     1771             input p-obj-type
     1772           , input p-obj-code
     1773       ).
     1774       assign
     1775           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1776           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1777           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1778           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1779           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1780           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1781           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1782           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1783       .
     1784       end.
     1785           run fmtcli-get-bank in this-procedure (
     1786             input p-host-obj-code
     1787           , input p-obj-type
     1788           , input p-obj-code
     1789           , input p-curr-code
     1790       ).
     1791       assign
     1792           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1793           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1794           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1795           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1796           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1797           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1798           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1799           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1800       .
     1801   end.
     1802   end procedure.
     1803   procedure torgconf-get-holdfirm-code :
     1804   define input parameter p-obj-type   as character        no-undo.
     1805   define input parameter p-obj-code   as integer          no-undo.
     1806   define output parameter p-firm-code as integer          no-undo.
     1807       define variable v-firm-code-str     as character    no-undo.
     1808       define variable v-par-type          as character    no-undo.
     1809       define buffer buf_clients       for ub.clients.
     1810   do
     1811   for buf_clients
     1812   on error undo, return error
     1813   :
     1814       run gbl/clntat-v.p (
     1815             input p-obj-type
     1816           , input p-obj-code
     1817           , input 'holdfirm-code':U
     1818           , output v-firm-code-str
     1819           , output v-par-type
     1820       ).
     1821       assign
     1822           p-firm-code = integer( v-firm-code-str )
     1823       no-error.
     1824       if error-status :error
     1825       then do:
     1826           message
     1827               "Неверно задан код фирмы для печати накладных."
     1828           view-as alert-box warning.
     1829           assign
     1830               p-firm-code = 0
     1831           .
     1832       end.
     1833       else do:
     1834           find first buf_clients no-lock
     1835                where buf_clients.obj-type = 'орг':U
     1836                  and buf_clients.obj-code = p-firm-code
     1837           no-error.
     1838           if not available buf_clients
     1839           then do:
     1840               message
     1841                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1842                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1843               view-as alert-box warning.
     1844               assign
     1845                   p-firm-code = 0
     1846               .
     1847           end.
     1848       end.
     1849   end.
     1850   end procedure.
     1851   procedure torgconf-get-post-head:
     1852   define input  parameter p-obj-type             as character        no-undo.
     1853   define input  parameter p-obj-code             as integer          no-undo.
     1854   define output parameter p-torgconf-post-head   as character        no-undo.
     1855      define variable v-host-code         as integer      no-undo.
     1856      define buffer buf_sysconf     for ub.sysconf.
     1857        assign
     1858         p-torgconf-post-head  = ""
     1859        .
     1860   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1861   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1862     (input  p-obj-type
     1863     ,input  p-obj-code
     1864     ,output v-host-code
     1865     )  .
     1866      find first buf_sysconf no-lock
     1867      where buf_sysconf.host-code = v-host-code
     1868      no-error.
     1869      if available buf_sysconf
     1870      then do:
     1871         assign
     1872            p-torgconf-post-head = buf_sysconf.head-position
     1873         .
     1874      end.
     1875   end procedure.
     1876   procedure torgconf-get-storekeeper:
     1877   define input  parameter p-wrkr                   as integer          no-undo.
     1878   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1879   define output parameter p-torgconf-post          as character        no-undo.
     1880      define buffer buf_sysconf     for ub.sysconf.
     1881      define buffer buf_person      for ub.person.
     1882      define buffer buf_shop        for ub.shop .
     1883      define buffer buf_store       for ub.store .
     1884      if v-torgconf-outC = "no_print"
     1885      then do:
     1886         assign p-torgconf-post = ""
     1887                p-torgconf-wrkr-name = ""
     1888                .
     1889      end.
     1890      if v-torgconf-outC = "clad_doc"
     1891      then do:
     1892         run rep/get-psn.p
     1893               (input  p-wrkr
     1894               ,output p-torgconf-wrkr-name
     1895               ) .
     1896         find first buf_person no-lock
     1897         where buf_person.psn-code = p-wrkr
     1898         no-error.
     1899         if available buf_person
     1900         then do:
     1901           p-torgconf-post = buf_person.position.
     1902         end.
     1903         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1904         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1905      end.
     1906      if v-torgconf-outC = "clad_obj"
     1907      then do:
     1908         CASE v-torgconf-self-obj-type:
     1909         WHEN 'маг':U
     1910         THEN DO:
     1911            find first buf_shop no-lock
     1912            where buf_shop.obj-code = v-torgconf-self-obj-code
     1913            .
     1914            assign
     1915               p-torgconf-wrkr-name = buf_shop.store-man
     1916               p-torgconf-post = ""
     1917            .
     1918            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1919         END.
     1920         WHEN 'скл':U
     1921         THEN DO:
     1922            find first buf_store no-lock
     1923            where buf_store.obj-code = v-torgconf-self-obj-code
     1924            .
     1925            assign
     1926               p-torgconf-wrkr-name = buf_store.store-man
     1927               p-torgconf-post = ""
     1928            .
     1929            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1930         END.
     1931         OTHERWISE DO:
     1932            assign
     1933               p-torgconf-post = "":U
     1934               p-torgconf-wrkr-name = "":U
     1935            .
     1936         END.
     1937         END CASE.
     1938      end.
     1939    end procedure.
     1940   procedure torgconf-get-form-header :
     1941   define input parameter p-for-inverse    as logical          no-undo.
     1942   define input parameter p-doc-code       as character        no-undo.
     1943   define input parameter p-print-doc      as logical          no-undo.
     1944   define input parameter p-doc-date       as date             no-undo.
     1945   define input parameter p-fact-date      as date             no-undo.
     1946   define input parameter p-doc-type       as character        no-undo.
     1947   define input parameter p-status_        as character        no-undo.
     1948   define input parameter p-reverse        as logical          no-undo.
     1949   define input parameter p-sf-par         as logical          no-undo.
     1950       define variable v-attr-type         as character    no-undo.
     1951       define variable v-doc-code-standard as logical      no-undo.
     1952       define variable v-doc-date-standard as logical      no-undo.
     1953       define variable v-par-consignee-addres  as character    no-undo.
     1954       define variable v-host-code         as integer      no-undo.
     1955       define variable v-dcode-attr        as character    no-undo.
     1956       define variable v-ddate-attr        as character    no-undo.
     1957       define variable v-doc-date          as character    no-undo.
     1958       define variable v-doc-code          as character    no-undo.
     1959       define variable v-par-type          as character    no-undo.
     1960       define variable v-attr              as character    no-undo.
     1961       define buffer buf_firm          for ub.firm .
     1962       define buffer buf_clients       for ub.clients .
     1963       define buffer buf_sysconf       for ub.sysconf .
     1964       define buffer buf_shop          for ub.shop .
     1965       define buffer buf_store         for ub.store .
     1966       define buffer buf_person        for ub.person .
     1967       define buffer buf_trn-doc       for ub.trn-doc .
     1968       define buffer buf_wth-doc       for ub.wth-doc .
     1969       do
     1970   for buf_firm
     1971     , buf_clients
     1972     , buf_sysconf
     1973     , buf_shop
     1974     , buf_trn-doc
     1975     , buf_person
     1976     , buf_wth-doc
     1977   on error undo, return error
     1978   :
     1979       if p-doc-type = 'при':U
     1980       or p-doc-type = 'возврат':U
     1981       then do:
     1982           assign
     1983               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1984                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1985               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1986                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1987               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1988                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1989               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1990                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1991               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1992               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1993               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1994               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1995               v-torgconf-supplier-type    = v-torgconf-cli-type
     1996               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1997               v-torgconf-saler-type       = v-torgconf-self-host-type
     1998               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1999               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2000               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2001               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2002               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2003               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2004               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2005               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2006               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2007               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2008               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2009               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2010               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2011               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2012               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2013           .
     2014           if v-torgconf-cli-schet-exists = yes
     2015           AND v-form-name                  = "torg12":U
     2016           then do:
     2017               assign
     2018                   v-torgconf-supplier = v-torgconf-supplier
     2019                       + substitute( ", р/с &1 к/с &2"
     2020                                   , v-torgconf-cli-bank-r-schet
     2021                                   , v-torgconf-cli-bank-c-schet
     2022                                   )
     2023                   v-torgconf-suppi = v-torgconf-supplier
     2024                       + substitute( ", р/с &1 к/с &2"
     2025                                   , v-torgconf-cli-bank-r-schet
     2026                                   , v-torgconf-cli-bank-c-schet
     2027                                   )
     2028               .
     2029               if v-torgconf-cli-bank-exists = yes
     2030               then do:
     2031                   assign
     2032                       v-torgconf-supplier = v-torgconf-supplier
     2033                           + substitute( " БИК &1 в &2 &3"
     2034                                       , v-torgconf-cli-bank-bik
     2035                                       , v-torgconf-cli-bank-name
     2036                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2037                                       )
     2038                      v-torgconf-suppi = v-torgconf-supplier
     2039                           + substitute( " БИК &1 в &2 &3"
     2040                                       , v-torgconf-cli-bank-bik
     2041                                       , v-torgconf-cli-bank-name
     2042                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2043                                       )
     2044                   .
     2045               end.
     2046           end.
     2047           if v-torgconf-self-schet-exists = yes
     2048           AND v-form-name                  = "torg12":U
     2049           then do:
     2050               assign
     2051                   v-torgconf-saler = v-torgconf-saler
     2052                       + substitute( ", р/с &1 к/с &2"
     2053                                   , v-torgconf-self-bank-r-schet
     2054                                   , v-torgconf-self-bank-c-schet
     2055                                   )
     2056               .
     2057               if v-torgconf-self-bank-exists = yes
     2058               then do:
     2059                   assign
     2060                       v-torgconf-saler = v-torgconf-saler
     2061                           + substitute( " БИК &1 в &2 &3"
     2062                                       , v-torgconf-self-bank-bik
     2063                                       , v-torgconf-self-bank-name
     2064                                       , v-torgconf-self-bank-addres
     2065                                       )
     2066                   .
     2067               end.
     2068           end.
     2069           if v-torgconf-sup-schet-exists = yes
     2070           AND v-form-name                  = "torg12":U
     2071           then do:
     2072               assign
     2073                   v-torgconf-consignee = v-torgconf-consignee
     2074                       + substitute( ", р/с &1 к/с &2"
     2075                                   , v-torgconf-sup-bank-r-schet
     2076                                   , v-torgconf-sup-bank-c-schet
     2077                                   )
     2078               .
     2079             if v-torgconf-sup-bank-exists = yes
     2080              then do:
     2081                assign
     2082                   v-torgconf-consignee = v-torgconf-consignee
     2083                           + substitute( " БИК &1 в &2 &3"
     2084                                       , v-torgconf-sup-bank-bik
     2085                                       , v-torgconf-sup-bank-name
     2086                                       , v-torgconf-sup-bank-addres
     2087                                       )
     2088                   .
     2089               end.
     2090           end.
     2091      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2092      then do:
     2093          assign
     2094            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2095                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2096                                                   , v-torgconf-cli-name
     2097                                                   , ( if v-torgconf-outprncd = yes
     2098                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2099                                                         else "":U )
     2100                                                   , v-torgconf-cli-post-addres
     2101                                                   , v-torgconf-cli-phone
     2102                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2103                                                       AND v-form-name                  = "torg12":U
