      987   PROCEDURE check-modified :
      988   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      989   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      990   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      991   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      992     IF check-state = "check":U THEN
      993     DO:
      994       RUN get-link-handle IN adm-broker-hdl
      995         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      996            OUTPUT group-target-list).
      997       IF group-target-list NE "":U THEN
      998       DO i = 1 TO NUM-ENTRIES(group-target-list):
      999         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1000         RUN check-modified IN curr-widget ('group-check':U).
     1001         IF RETURN-VALUE NE "":U THEN
     1002         DO:
     1003           RUN check-modified-message(RETURN-VALUE).
     1004           RETURN "":U.
     1005         END.
     1006       END.
     1007     END.
     1008     RETURN "":U.
     1009   END PROCEDURE.
     1010   PROCEDURE check-modified-message :
     1011     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1012        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1013           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1014        IF RETURN-VALUE = "YES":U THEN
     1015           RUN notify ('view,CONTAINER-SOURCE':U).
     1016        MESSAGE IF p-changed-table NE ? THEN
     1017           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1018           ELSE "Current values have been changed."
     1019           SKIP "  Do you wish to save those changes?"
     1020           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1021        IF ANS THEN
     1022        DO:
     1023           IF group-assign-target THEN
     1024             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1025           ELSE RUN dispatch('update-record':U).
     1026           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1027           DO:
     1028               MESSAGE "Changes to the previous record were not saved."
     1029                 VIEW-AS ALERT-BOX ERROR.
     1030               IF group-assign-target THEN
     1031                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1032               ELSE RUN dispatch ('cancel-record':U).
     1033           END.
     1034        END.
     1035        ELSE DO:
     1036          IF group-assign-target THEN
     1037             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1038          ELSE RUN dispatch('cancel-record':U).
     1039        END.
     1040        RETURN.
     1041   END PROCEDURE.
     1042   PROCEDURE get-rowid :
     1043       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1044       ASSIGN
     1045       p-table   =   adm-first-table.
     1046       RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE init-group-assign :
     1049       RUN request-attribute IN adm-broker-hdl
     1050         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1051       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1052         group-assign-target = yes.
     1053       ELSE group-assign-target = no.
     1054       RETURN.
     1055   END PROCEDURE.
     1056   PROCEDURE set-editors :
     1057       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1058       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1059       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1060       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1061       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1062       DO WHILE VALID-HANDLE (curr-widget):
     1063           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1064              curr-widget:HIDDEN = no THEN DO:
     1065             CASE p-field-setting:
     1066               WHEN "INITIALIZE":U THEN
     1067               DO:
     1068                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1069                     read-only-list +
     1070                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1071                        STRING(curr-widget).
     1072               END.
     1073               WHEN "DISABLE":U OR
     1074               WHEN "ENABLE":U THEN
     1075               DO:
     1076                   curr-widget:SENSITIVE = yes.
     1077                   RUN get-attribute ('Read-Only-Editors':U).
     1078                   IF RETURN-VALUE = ? OR
     1079                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1080                       curr-widget:READ-ONLY =
     1081                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1082               END.
     1083               WHEN "CLEAR":U THEN
     1084                   curr-widget:SCREEN-VALUE = "":U.
     1085             END CASE.
     1086           END.
     1087           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1088       END.
     1089       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1090         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1091           + '"':U).
     1092       RETURN.
     1093   END PROCEDURE.
     1094   PROCEDURE use-check-modified-all :
     1095    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1096     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1097     RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE use-create-on-add :
     1100   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1101      RETURN.
     1102   END PROCEDURE.
     1103   PROCEDURE use-initial-lock :
     1104     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1105     ASSIGN adm-initial-lock = p-attr-value.
     1106     RETURN.
     1107   END PROCEDURE.
     1108     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1109   ASSIGN
     1110          FRAME F-Main:SCROLLABLE       = FALSE
     1111          FRAME F-Main:HIDDEN           = TRUE
     1112          FRAME F-Main:PRIVATE-DATA     =
     1113                   "DLGCLOSE".
     1114   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1115   DO:
     1116       if Classify:screen-value  Begins "prod":U OR
     1117          Classify:screen-value  Begins "grp-goods":U OR
     1118          Classify:screen-value  Begins "vat-ps":U
     1119           then
     1120           enable SumsOnly with frame F-Main .
     1121      if Classify:screen-value = "no-classify":U
     1122         Then do:
     1123               SumsOnly = FALSE .
     1124               display SumsOnly with frame F-Main .
     1125               disable SumsOnly with frame F-Main .
     1126           end.
     1127      if Classify:screen-value = "grp-goods":U
     1128            Then do:
     1129               display TOG-lavel   with frame F-Main .
     1130               enable  TOG-lavel   with frame F-Main .
     1131           end.
     1132            Else do:
     1133               display  TOG-lavel  var-Lavel with frame F-Main .
     1134               disable  TOG-lavel  var-Lavel with frame F-Main .
     1135           end.
     1136   END.
     1137   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1138   DO:
     1139     if tog-lavel:screen-value="yes"
     1140           Then do:
     1141               display  var-Lavel  with frame F-Main .
     1142               enable   var-Lavel  with frame F-Main .
     1143           end.
     1144            Else do:
     1145               display    var-Lavel with frame F-Main .
     1146               disable    var-Lavel with frame F-Main .
     1147           end.
     1148   END.
     1149   if not this-procedure :persistent
     1150   then do:
     1151     message
     1152       vss-workfile vss-revision vss-description skip
     1153       "Ошибка при запуске процедуры" skip
     1154       "Данную процедуру следует запускать только с параметром persistent" skip
     1155       view-as alert-box error .
     1156     undo, return error .
     1157   end.
     1158   PROCEDURE disable_UI :
     1159     HIDE FRAME F-Main.
     1160     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1161   END PROCEDURE.
     1162   PROCEDURE local-initialize :
     1163     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1164      Tog-obj:screen-value in frame F-Main = 'yes'.
     1165      var-lavel:screen-value in frame F-Main = '1'.
     1166       Combo-node:list-items = Combo-node:list-items + ',' + 'касса продажа':U      .
     1167       Combo-node:list-items = Combo-node:list-items + ',' + 'касса возврат':U  .
     1168       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внешний':U           .
     1169       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внутренний':U           .
     1170       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внешний':U       .
     1171       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внутренний':U       .
     1172       Combo-node:list-items = Combo-node:list-items + ',' + 'приход  произв.':U            .
     1173       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внешний':U           .
     1174       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат пост.':U        .
     1175       Combo-node:list-items = Combo-node:list-items + ',' + 'списание':U           .
     1176       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внутренний':U           .
     1177       Combo-node:list-items = Combo-node:list-items + ',' + 'расход  произв.':U            .
     1178       Combo-node:list-items = Combo-node:list-items + ',' + 'списан. произв.':U            .
     1179       Combo-node:list-items = Combo-node:list-items + ',' + 'инвентаризация':U                 .
     1180       Combo-node:list-items = Combo-node:list-items + ',' + 'переоценка':U            .
     1181       Combo-node:list-items = Combo-node:list-items + ',' + 'корректировка отрицательных партий':U            .
     1182       Combo-node:list-items = Combo-node:list-items + ',' + 'пересортица':U            .
     1183       Combo-node:screen-value in frame F-Main = 'касса'.
     1184       display Combo-node  with frame F-Main .
     1185   END PROCEDURE.
     1186   PROCEDURE my-report :
     1187   case SortType :
     1188     when "sort-artic" then do:
     1189       run proc-x in this-procedure .
     1190     end.
     1191     when "sort-code" then do:
     1192       run proc-c in this-procedure .
     1193     end.
     1194     when "sort-name" then do:
     1195       run proc-n in this-procedure .
     1196     end.
     1197   end case.
     1198   END PROCEDURE.
     1199   PROCEDURE my-var :
     1200   assign frame F-Main SumsOnly ShowZero tog-obj
     1201   tog-lavel var-lavel COMBO-node Classify sorttype.
     1202   if x-SelectObject = "currency":U and tog-obj = false then tog-obj = true .
     1203   Assign
     1204    STR-obj-type = ''
     1205    STR-obj-code = ''
     1206    STR-obj-name = ''
     1207    STR-obj      = ''.
     1208   For each obj-list no-lock:
     1209    Assign
     1210    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1211    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1212    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1213    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1214   End.
     1215   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( по одному типу документа)".
     1216   def var t-class as char no-undo.
     1217   def var t-sort as char no-undo.
     1218     case classify:
     1219       when "no-classify":u    then t-class =   "Без классификации" .
     1220       when "prod":u           then t-class =   "Производители"   .
     1221       when "post":u           then t-class =   "Поставщики"   .
     1222       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1223       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1224       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1225       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1226       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1227       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1228       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1229       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1230       when  "t-level":u       then t-class =   "Терминальные группы" .
     1231    end case.
     1232     case sorttype:
     1233       when "sort-pp":u               then t-sort =   "по порядку" .
     1234       when "sort-code":u             then t-sort =   "по коду" .
     1235       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1236       when "sort-qunty":u            then t-sort =   "по реализации".
     1237       when "sort-name":u             then t-sort =   "по наименованию".
     1238       when "sort-type":u             then t-sort =   "по типу ткани".
     1239       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1240       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1241    end case.
     1242   ReportHeader = "Классификация : " + t-Class .
     1243   ReportHeader = ReportHeader +
     1244                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1245   ReportHeader = ReportHeader  + " Тип документов : " + COMBO-node + chr(10).
     1246   ReportHeader = ReportHeader +
     1247                  "Сортировка " + t-Sort  + chr(10) +
     1248                  "Показать : " +
     1249                  (if SumsOnly     then "Только итоги, "  else " "            ) +
     1250                  (if ShowZero     then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1251               Case COMBO-node:
     1252                   when  'приход внешний':U             then   COMBO-node = 'ie':U          .
     1253                   when  'расход внешний':U             then   COMBO-node = 'ee':U          .
     1254                   when  'возврат пост.':U          then   COMBO-node = 'ep':U       .
     1255                   when  'касса продажа':U        then   COMBO-node = 'es':U     .
     1256                   when  'возврат внешний':U         then   COMBO-node = 're':U      .
     1257                   when  'касса возврат':U    then   COMBO-node = 'rs':U .
     1258                   when  'списание':U             then   COMBO-node = 'we':U          .
     1259                   when  'инвентаризация':U                   then   COMBO-node = 'vt':U                .
     1260                   when  'приход внутренний':U             then   COMBO-node = 'iv':U          .
     1261                   when  'расход внутренний':U             then   COMBO-node = 'ev':U          .
     1262                   when  'возврат внутренний':U         then   COMBO-node = 'rv':U       .
     1263                   when  'расход  произв.':U              then   COMBO-node = 'em':U            .
     1264                   when  'списан. произв.':U              then   COMBO-node = 'wm':U            .
     1265                   when  'приход  произв.':U              then   COMBO-node = 'im':U            .
     1266                   when  'переоценка':U              then   COMBO-node = 'ot':U            .
     1267                   when  'пересортица':U              then   COMBO-node = 'vp':U            .
     1268                   when  'корректировка отрицательных партий':U              then   COMBO-node = 'mp':U            .
     1269                   when  'касса'                             then   COMBO-node = 'rs':U + ',' + 'es':U.
     1270               End case.
     1271   END PROCEDURE.
