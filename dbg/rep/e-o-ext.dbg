      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   DEFINE VARIABLE COMBO-node AS CHARACTER FORMAT "X(40)":U INITIAL "касса"
      680        LABEL "Типы документов"
      681        VIEW-AS COMBO-BOX INNER-LINES 6
      682        LIST-ITEMS "касса"
      683        DROP-DOWN-LIST
      684        SIZE 40.75 BY 1
      685        BGCOLOR 15  NO-UNDO.
      686   DEFINE VARIABLE var-lavel AS INTEGER FORMAT ">>9":U INITIAL 1
      687        VIEW-AS FILL-IN NATIVE
      688        SIZE 5 BY 1 NO-UNDO.
      689   DEFINE VARIABLE Classify AS CHARACTER
      690        VIEW-AS RADIO-SET VERTICAL
      691        RADIO-BUTTONS
      692             "Без классификации", "no-classify":U,
      693   "Производители", "prod":U,
      694   "Группы товаров", "grp-goods":U,
      695   "Производители/Группы товаров", "prod/grp-goods":U,
      696   "Группы товаров/Производители", "grp-goods/prod":U,
      697   "Ставка НДС", "vat-ps":U
      698        SIZE 30.88 BY 6.29 NO-UNDO.
      699   DEFINE VARIABLE SortType AS CHARACTER
      700        VIEW-AS RADIO-SET VERTICAL
      701        RADIO-BUTTONS
      702             "по коду", "sort-code":U,
      703   "по артикулу", "sort-artic":U,
      704   "по наименованию", "sort-name":U
      705        SIZE 19 BY 2.54 NO-UNDO.
      706   DEFINE RECTANGLE RECT-5
      707        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      708        SIZE 44.5 BY 9.33.
      709   DEFINE RECTANGLE RECT-6
      710        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      711        SIZE 22.5 BY 9.33.
      712   DEFINE RECTANGLE RECT-8
      713        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      714        SIZE 67.75 BY 3.33.
      715   DEFINE RECTANGLE RECT-9
      716        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      717        SIZE 67.75 BY 3.33.
      718   DEFINE VARIABLE ShowZero AS LOGICAL INITIAL no
      719        LABEL "Нулевые остатки":L
      720        VIEW-AS TOGGLE-BOX
      721        SIZE 19 BY .83 NO-UNDO.
      722   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      723        LABEL "Только итоги"
      724        VIEW-AS TOGGLE-BOX
      725        SIZE 19 BY .83 NO-UNDO.
      726   DEFINE VARIABLE Tog-lavel AS LOGICAL INITIAL no
      727        LABEL "с уровня":L
      728        VIEW-AS TOGGLE-BOX
      729        SIZE 12.63 BY 1 NO-UNDO.
      730   DEFINE VARIABLE Tog-obj AS LOGICAL INITIAL yes
      731        LABEL "Раздельно по объектам":L
      732        VIEW-AS TOGGLE-BOX
      733        SIZE 31 BY 1 NO-UNDO.
      734   DEFINE FRAME F-Main
      735        SortType AT ROW 2.5 COL 47.63 NO-LABEL
      736        Tog-obj AT ROW 2.54 COL 2.13
      737        Classify AT ROW 3.79 COL 2.13 NO-LABEL
      738        Tog-lavel AT ROW 5.96 COL 21.38
      739        var-lavel AT ROW 6 COL 32.63 COLON-ALIGNED NO-LABEL
      740        COMBO-node AT ROW 10.92 COL 5.88
      741        ShowZero AT ROW 15.54 COL 2.63
      742        SumsOnly AT ROW 16.42 COL 2.63
      743        "Сортировка товара :" VIEW-AS TEXT
      744             SIZE 19.38 BY .67 AT ROW 1.46 COL 47.63
      745             FGCOLOR 4
      746        "Классификация :" VIEW-AS TEXT
      747             SIZE 15 BY .75 AT ROW 1.46 COL 12
      748             FGCOLOR 4
      749        "Показать :" VIEW-AS TEXT
      750             SIZE 11.5 BY .75 AT ROW 14.29 COL 3.13
      751             FGCOLOR 4
      752        RECT-9 AT ROW 10.58 COL 1.63
      753        RECT-6 AT ROW 1.21 COL 46.75
      754        RECT-5 AT ROW 1.21 COL 1.75
      755        RECT-8 AT ROW 14.08 COL 1.75
      756       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      757            SIDE-LABELS NO-UNDERLINE THREE-D
      758            AT COL 1 ROW 1 SCROLLABLE .
      759   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      760   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      761   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      762   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      763   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      764   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      765   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      766   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      767         adm-object-hdl = FRAME F-Main:HANDLE.
      768   RUN ensure-broker.
      769   THIS-PROCEDURE:ADM-DATA =
      770        'ADM1.1~`':U +
      771        'SmartObject~`':U +
      772        '~`':U +
      773        'NO ~`':U +
      774        '~`':U +
      775        '~`':U +
      776        '~`':U +
      777        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      778           + "~`":U +
      779        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      780        'Record-Source,Record-Target,TableIO-Target~`':U +
      781        '~`':U +
      782        '~`~`~`~`~`~`~`~`~`~`~`':U +
      783        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      784            THEN "^^":U
      785        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      786             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      787   PROCEDURE adm-apply-entry :
      788     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      789   END PROCEDURE.
      790   PROCEDURE adm-destroy :
      791    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      792   END PROCEDURE.
      793   PROCEDURE adm-disable :
      794       DISABLE RECT-9 RECT-6 RECT-5 RECT-8 SortType Tog-obj Classify COMBO-node ShowZero WITH FRAME F-Main.
      795       RUN dispatch ('disable-fields':U).
      796       RUN set-attribute-list ('ENABLED=no':U).
      797       RETURN.
      798   END PROCEDURE.
      799   PROCEDURE adm-edit-attribute-list :
      800         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      801         RETURN.
      802   END PROCEDURE.
      803   PROCEDURE adm-enable :
      804       ENABLE UNLESS-HIDDEN RECT-9 RECT-6 RECT-5 RECT-8 SortType Tog-obj Classify COMBO-node ShowZero WITH FRAME F-Main.
      805       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      806       RUN set-attribute-list ('ENABLED=yes':U).
      807       RETURN.
      808   END PROCEDURE.
      809   PROCEDURE adm-exit :
      810        RUN notify ('exit':U).
      811     RETURN.
      812   END PROCEDURE.
      813   PROCEDURE adm-hide :
      814     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      815   END PROCEDURE.
      816   PROCEDURE adm-initialize :
      817     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      818   END PROCEDURE.
      819   PROCEDURE adm-show-errors :
      820       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      821       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      822           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      823       END.
      824       RETURN.
      825   END PROCEDURE.
      826   PROCEDURE adm-UIB-mode :
      827     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      828   END PROCEDURE.
      829   PROCEDURE adm-view :
      830     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      831   END PROCEDURE.
      832   PROCEDURE dispatch :
      833       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      834       RUN broker-dispatch IN adm-broker-hdl
      835           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      836       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      837   END PROCEDURE.
      838   PROCEDURE ensure-broker :
      839   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      840   IF RETURN-VALUE NE "ADM-Broker":U THEN
      841   DO:
      842       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      843       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      844   END.
      845   END PROCEDURE.
      846   PROCEDURE get-attribute :
      847     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      848     RUN broker-get-attribute IN adm-broker-hdl
      849         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      850     RETURN RETURN-VALUE.
      851   END PROCEDURE.
      852   PROCEDURE get-attribute-list :
      853     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      854     RUN broker-get-attribute-list IN adm-broker-hdl
      855         (INPUT THIS-PROCEDURE,
      856          INPUT ?,
      857          OUTPUT p-attr-list) NO-ERROR.
      858     RETURN.
      859   END PROCEDURE.
      860   PROCEDURE new-state :
      861     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      862     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      863     RETURN.
      864   END PROCEDURE.
      865   PROCEDURE notify :
      866     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      867     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      868     IF RETURN-VALUE = "ADM-ERROR":U THEN
      869         RETURN "ADM-ERROR":U.
      870     RETURN.
      871   END PROCEDURE.
      872   PROCEDURE set-attribute-list :
      873     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      874     RUN ensure-broker.
      875     RUN broker-set-attribute-list IN adm-broker-hdl
      876         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      877     RETURN.
      878   END PROCEDURE.
      879   PROCEDURE set-position :
      880       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      881       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      882       IF VALID-HANDLE(adm-object-hdl) THEN
      883       DO:
      884         ASSIGN adm-object-hdl:ROW    =   p-row
      885                adm-object-hdl:COLUMN =   p-col.
      886       END.
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-display-fields :
      890       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      891       RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-open-query :
      894     RETURN.
      895   END PROCEDURE.
      896   PROCEDURE adm-row-changed :
      897         IF VALID-HANDLE(adm-object-hdl) THEN
      898           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      899         RUN notify ('row-available':U).
      900         RETURN.
      901   END PROCEDURE.
      902   PROCEDURE reposition-query :
      903       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      904       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      905       RETURN.
      906   END PROCEDURE.
      907     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      908     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      909     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      910     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      911     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      912     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      913     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      914     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      915     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      916     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      917     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      918     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      919     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      920     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      921     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      922     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      923     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      924     IF "":U = "":U THEN
      925       RUN modify-list-attribute IN adm-broker-hdl
      926         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      927     RUN use-create-on-add(?).
      928   PROCEDURE adm-add-record :
      929       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      930          "must have at least one Enabled Table to perform Add.":U
      931          VIEW-AS ALERT-BOX ERROR.
      932       RETURN.
      933   END PROCEDURE.
      934   PROCEDURE adm-assign-record :
      935    MESSAGE
      936          "Object ":U THIS-PROCEDURE:FILE-NAME
      937            "must have at least one Enabled Table to perform Assign.":U
      938              VIEW-AS ALERT-BOX ERROR.
      939      RETURN.
      940     END PROCEDURE.
      941   PROCEDURE adm-assign-statement :
      942     RETURN.
      943   END PROCEDURE.
