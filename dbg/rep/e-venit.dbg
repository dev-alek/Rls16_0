        8   procedure proc-alt-shift-f2:
        9     if not ibs.th.gbl.gbl-var:rcode
       10   then
       11     run gbl\inidebug.p .
       12   end.
       13   procedure proc-alt-shift-f3:
       14     run gbl/prvssinf.p
       15       ( input this-procedure
       16       ) .
       17   end.
       18   define variable v-inform-launched as logical no-undo initial false .
       19   procedure proc-alt-shift-f4:
       20     define variable v-action as character no-undo .
       21     if v-inform-launched = false then do:
       22       assign
       23         v-inform-launched = true
       24       .
       25       run gbl/d-inform.w
       26         (  input self
       27         ,  input this-procedure
       28         , output v-action
       29         ) no-error .
       30       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       31       assign
       32         v-inform-launched = false
       33       .
       34     end.
       35   end.
       36   procedure proc-alt-f1:
       37     run gbl/corrhelp.p
       38       (input this-procedure
       39       ) .
       40   end .
       41   on alt-shift-f2 anywhere do:
       42     run proc-alt-shift-f2.
       43   end.
       44   on alt-shift-f3 anywhere do:
       45     run proc-alt-shift-f3 in this-procedure .
       46   end.
       47   on alt-shift-f4 anywhere do:
       48     run proc-alt-shift-f4 in this-procedure.
       49   end.
       50   on alt-f1 anywhere do:
       51     run proc-alt-f1 in this-procedure .
       52   end.
