      550   define new global shared variable g#library  as handle no-undo .
      551   define new global shared variable g#library2 as handle no-undo .
      552   define variable var-report-r-b as character no-undo .
      553   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      554   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      555     (output var-report-r-b
      556     )  .
      557   RUN set-attribute-list (
      558       'Keys-Accepted = "",
      559        Keys-Supplied = ""':U).
      560   DEFINE VARIABLE r-kind AS INTEGER INITIAL 1
      561        VIEW-AS RADIO-SET VERTICAL
      562        RADIO-BUTTONS
      563             "Товары с группировкой", 1,
      564   "Товары без группировки", 2,
      565   "Только группы товаров", 3
      566        SIZE 62 BY 4.5 NO-UNDO.
      567   DEFINE FRAME F-Main
      568        r-kind AT ROW 3.13 COL 2.25 NO-LABEL
      569        "Вид отчета:" VIEW-AS TEXT
      570             SIZE 32.13 BY 1.21 AT ROW 1.67 COL 2.5
      571       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      572            SIDE-LABELS NO-UNDERLINE THREE-D
      573            AT COL 1 ROW 1 SCROLLABLE .
      574   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      575   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      576   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      577   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      578   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      579   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      580   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      581   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      582         adm-object-hdl = FRAME F-Main:HANDLE.
      583   RUN ensure-broker.
      584   THIS-PROCEDURE:ADM-DATA =
      585        'ADM1.1~`':U +
      586        'SmartObject~`':U +
      587        '~`':U +
      588        'NO ~`':U +
      589        '~`':U +
      590        '~`':U +
      591        '~`':U +
      592        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      593           + "~`":U +
      594        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      595        'Record-Source,Record-Target,TableIO-Target~`':U +
      596        '~`':U +
      597        '~`~`~`~`~`~`~`~`~`~`~`':U +
      598        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      599            THEN "^^":U
      600        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      601             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      602   PROCEDURE adm-apply-entry :
      603     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      604   END PROCEDURE.
      605   PROCEDURE adm-destroy :
      606    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      607   END PROCEDURE.
      608   PROCEDURE adm-disable :
      609       DISABLE r-kind WITH FRAME F-Main.
      610       RUN dispatch ('disable-fields':U).
      611       RUN set-attribute-list ('ENABLED=no':U).
      612       RETURN.
      613   END PROCEDURE.
      614   PROCEDURE adm-edit-attribute-list :
      615         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      616         RETURN.
      617   END PROCEDURE.
      618   PROCEDURE adm-enable :
      619       ENABLE UNLESS-HIDDEN r-kind WITH FRAME F-Main.
      620       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      621       RUN set-attribute-list ('ENABLED=yes':U).
      622       RETURN.
      623   END PROCEDURE.
      624   PROCEDURE adm-exit :
      625        RUN notify ('exit':U).
      626     RETURN.
      627   END PROCEDURE.
      628   PROCEDURE adm-hide :
      629     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      630   END PROCEDURE.
      631   PROCEDURE adm-initialize :
      632     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      633   END PROCEDURE.
      634   PROCEDURE adm-show-errors :
      635       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      636       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      637           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      638       END.
      639       RETURN.
      640   END PROCEDURE.
      641   PROCEDURE adm-UIB-mode :
      642     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      643   END PROCEDURE.
      644   PROCEDURE adm-view :
      645     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      646   END PROCEDURE.
      647   PROCEDURE dispatch :
      648       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      649       RUN broker-dispatch IN adm-broker-hdl
      650           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      651       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      652   END PROCEDURE.
      653   PROCEDURE ensure-broker :
      654   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      655   IF RETURN-VALUE NE "ADM-Broker":U THEN
      656   DO:
      657       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      658       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      659   END.
      660   END PROCEDURE.
      661   PROCEDURE get-attribute :
      662     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      663     RUN broker-get-attribute IN adm-broker-hdl
      664         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      665     RETURN RETURN-VALUE.
      666   END PROCEDURE.
      667   PROCEDURE get-attribute-list :
      668     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      669     RUN broker-get-attribute-list IN adm-broker-hdl
      670         (INPUT THIS-PROCEDURE,
      671          INPUT ?,
      672          OUTPUT p-attr-list) NO-ERROR.
      673     RETURN.
      674   END PROCEDURE.
      675   PROCEDURE new-state :
      676     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      677     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      678     RETURN.
      679   END PROCEDURE.
      680   PROCEDURE notify :
      681     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      682     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      683     IF RETURN-VALUE = "ADM-ERROR":U THEN
      684         RETURN "ADM-ERROR":U.
      685     RETURN.
      686   END PROCEDURE.
      687   PROCEDURE set-attribute-list :
      688     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      689     RUN ensure-broker.
      690     RUN broker-set-attribute-list IN adm-broker-hdl
      691         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      692     RETURN.
      693   END PROCEDURE.
      694   PROCEDURE set-position :
      695       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      696       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      697       IF VALID-HANDLE(adm-object-hdl) THEN
      698       DO:
      699         ASSIGN adm-object-hdl:ROW    =   p-row
      700                adm-object-hdl:COLUMN =   p-col.
      701       END.
      702       RETURN.
      703   END PROCEDURE.
      704   PROCEDURE adm-display-fields :
      705       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      706       RETURN.
      707   END PROCEDURE.
      708   PROCEDURE adm-open-query :
      709     RETURN.
      710   END PROCEDURE.
      711   PROCEDURE adm-row-changed :
      712         IF VALID-HANDLE(adm-object-hdl) THEN
      713           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      714         RUN notify ('row-available':U).
      715         RETURN.
      716   END PROCEDURE.
      717   PROCEDURE reposition-query :
      718       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      719       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      720       RETURN.
      721   END PROCEDURE.
      722     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      723     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      724     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      725     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      726     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      727     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      728     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      729     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      730     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      731     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      732     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      733     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      734     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      735     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      736     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      737     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      738     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      739     IF "":U = "":U THEN
      740       RUN modify-list-attribute IN adm-broker-hdl
      741         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      742     RUN use-create-on-add(?).
      743   PROCEDURE adm-add-record :
      744       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      745          "must have at least one Enabled Table to perform Add.":U
