      760      RETURN.
      761     END PROCEDURE.
      762   PROCEDURE adm-copy-record :
      763       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      764        "must have at least one Enabled Table to perform Copy.":U
      765          VIEW-AS ALERT-BOX ERROR.
      766       RETURN.
      767   END PROCEDURE.
      768   PROCEDURE adm-create-record :
      769      RETURN.
      770   END PROCEDURE.
      771   PROCEDURE adm-current-changed :
      772     RETURN.
      773   END PROCEDURE.
      774   PROCEDURE adm-delete-record :
