      114   def
      115    shared
      116   temp-table  obj-list no-undo
      117     field obj-type like ub.clients.obj-type
      118     field obj-code like ub.clients.obj-code
      119     field obj-name like ub.clients.obj-name
      120     field obj-id   as integer
      121     field db-num   as integer
      122     index pi is primary unique obj-id
      123     index ie1 obj-type obj-code
      124     index ie2 obj-name
      125   .
      126   procedure create_obj-list :
      127      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      128      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      129      do
      130      on error undo, return error return-value
      131      :
      132         define buffer cli-obj for ub.clients .
      133         define variable p-var as integer no-undo .
      134         define buffer buf_obj-list for obj-list .
      135         find last buf_obj-list  use-index pi no-error .
      136         if available buf_obj-list
      137         then
      138            p-var = buf_obj-list.obj-id + 1.
      139         else
      140            p-var = 1.
      141         find first cli-obj where
      142                   cli-obj.obj-type = p-obj-type
      143               and cli-obj.obj-code = p-obj-code
      144         no-lock no-error.
      145         if available cli-obj
      146         then do:
      147            create buf_obj-list.
      148            assign
      149               buf_obj-list.obj-id   = p-var
      150               buf_obj-list.obj-code = cli-obj.obj-code
      151               buf_obj-list.obj-type = cli-obj.obj-type
      152               buf_obj-list.obj-name = cli-obj.obj-name
      153               buf_obj-list.db-num   = cli-obj.db-num
      154            .
      155         end.
      156      end.
      157   end.
