      786   PROCEDURE adm-enable-fields :
      787       RETURN.
      788   END PROCEDURE.
      789   PROCEDURE adm-end-update :
      790     RETURN.
      791   END PROCEDURE.
      792   PROCEDURE adm-reset-record :
      793       RETURN.
      794   END PROCEDURE.
      795   PROCEDURE adm-update-record :
      796       MESSAGE
      797         "Object ":U THIS-PROCEDURE:FILE-NAME
      798           "must have at least one Enabled Table to perform Update.":U
      799             VIEW-AS ALERT-BOX ERROR.
      800      RETURN.
      801   END PROCEDURE.
      802   PROCEDURE check-modified :
      803   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      804   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      805   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      806   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      807     IF check-state = "check":U THEN
      808     DO:
      809       RUN get-link-handle IN adm-broker-hdl
      810         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      811            OUTPUT group-target-list).
      812       IF group-target-list NE "":U THEN
      813       DO i = 1 TO NUM-ENTRIES(group-target-list):
      814         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      815         RUN check-modified IN curr-widget ('group-check':U).
      816         IF RETURN-VALUE NE "":U THEN
      817         DO:
      818           RUN check-modified-message(RETURN-VALUE).
      819           RETURN "":U.
      820         END.
      821       END.
      822     END.
      823     RETURN "":U.
      824   END PROCEDURE.
      825   PROCEDURE check-modified-message :
      826     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      827        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      828           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      829        IF RETURN-VALUE = "YES":U THEN
      830           RUN notify ('view,CONTAINER-SOURCE':U).
      831        MESSAGE IF p-changed-table NE ? THEN
      832           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      833           ELSE "Current values have been changed."
      834           SKIP "  Do you wish to save those changes?"
      835           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      836        IF ANS THEN
      837        DO:
      838           IF group-assign-target THEN
      839             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      840           ELSE RUN dispatch('update-record':U).
      841           IF RETURN-VALUE = "ADM-ERROR":U THEN
      842           DO:
      843               MESSAGE "Changes to the previous record were not saved."
      844                 VIEW-AS ALERT-BOX ERROR.
      845               IF group-assign-target THEN
      846                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      847               ELSE RUN dispatch ('cancel-record':U).
      848           END.
      849        END.
      850        ELSE DO:
      851          IF group-assign-target THEN
      852             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      853          ELSE RUN dispatch('cancel-record':U).
      854        END.
      855        RETURN.
      856   END PROCEDURE.
      857   PROCEDURE get-rowid :
      858       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      859       ASSIGN
      860       p-table   =   adm-first-table.
      861       RETURN.
      862   END PROCEDURE.
      863   PROCEDURE init-group-assign :
      864       RUN request-attribute IN adm-broker-hdl
      865         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      866       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      867         group-assign-target = yes.
      868       ELSE group-assign-target = no.
      869       RETURN.
      870   END PROCEDURE.
      871   PROCEDURE set-editors :
      872       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      873       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      874       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      875       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      876       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      877       DO WHILE VALID-HANDLE (curr-widget):
      878           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      879              curr-widget:HIDDEN = no THEN DO:
      880             CASE p-field-setting:
      881               WHEN "INITIALIZE":U THEN
      882               DO:
      883                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      884                     read-only-list +
      885                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      886                        STRING(curr-widget).
      887               END.
      888               WHEN "DISABLE":U OR
      889               WHEN "ENABLE":U THEN
      890               DO:
      891                   curr-widget:SENSITIVE = yes.
      892                   RUN get-attribute ('Read-Only-Editors':U).
      893                   IF RETURN-VALUE = ? OR
      894                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      895                       curr-widget:READ-ONLY =
      896                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      897               END.
      898               WHEN "CLEAR":U THEN
      899                   curr-widget:SCREEN-VALUE = "":U.
      900             END CASE.
      901           END.
      902           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      903       END.
      904       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      905         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      906           + '"':U).
      907       RETURN.
      908   END PROCEDURE.
      909   PROCEDURE use-check-modified-all :
      910    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      911     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      912     RETURN.
      913   END PROCEDURE.
      914   PROCEDURE use-create-on-add :
      915   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      916      RETURN.
      917   END PROCEDURE.
      918   PROCEDURE use-initial-lock :
      919     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      920     ASSIGN adm-initial-lock = p-attr-value.
      921     RETURN.
      922   END PROCEDURE.
      923     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      924   ASSIGN
      925          FRAME F-Main:SCROLLABLE       = FALSE
      926          FRAME F-Main:HIDDEN           = TRUE.
      927   ON VALUE-CHANGED OF r-kind IN FRAME F-Main
      928   DO:
      929     ASSIGN r-kind.
      930   END.
      931   if not this-procedure :persistent
      932   then do:
      933     message
      934       vss-workfile vss-revision vss-description skip
      935       "Ошибка при запуске процедуры" skip
      936       "Данную процедуру следует запускать только с параметром persistent" skip
      937       view-as alert-box error .
      938     undo, return error .
      939   end.
      940   PROCEDURE adm-row-available :
      941     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      942     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      943     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      944     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      945     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      946     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      947     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      948     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      949     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      950     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      951     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      952     IF adm-updating-record THEN RETURN.
      953     RUN get-attribute ('FIELDS-ENABLED':U).
      954     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      955     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      956         OUTPUT link-handle) NO-ERROR.
      957     IF link-handle = "":U THEN
      958         RETURN.
      959     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      960     IF NUM-ENTRIES(link-handle) > 1 THEN
      961         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      962             "encountered more than one RECORD-SOURCE.":U SKIP
      963             "The first - ":U record-source-hdl:file-name " - will be used.":U
      964                VIEW-AS ALERT-BOX ERROR.
      965     RUN get-attribute ('Key-Name':U).
      966     key-name = RETURN-VALUE.
      967     IF key-name = "":U THEN key-name = ?.
      968     IF key-name NE ? THEN DO:
      969       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      970         NO-ERROR.
      971       IF key-value NE ? THEN
      972         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      973     END.
      974   IF VALID-HANDLE (adm-object-hdl) THEN
      975       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      976   RUN notify IN THIS-PROCEDURE ('row-available':U).
      977   END PROCEDURE.
      978   PROCEDURE disable_UI :
      979     HIDE FRAME F-Main.
      980     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      981   END PROCEDURE.
      982   PROCEDURE my-report :
      983   if x-shift-start = ? or x-shift-end = ?
      984      then assign x-shift-start = ?
      985                  x-shift-end   = ? .
      986   IF NOT CAN-FIND(FIRST obj-list) THEN DO:
      987      message "Вы не выбрали объект." view-as alert-box.
      988      return error.
      989   END.
      990   FIND FIRST obj-list.
      991   run rep/r-venit.p (input my-handle,
      992                  input obj-list.obj-type,
      993                  input obj-list.obj-code,
      994                  input gdsgrp_recids,
      995                  input x-radio-task,
      996                  input x-date-start,
      997                  input x-shift-start,
      998                  input x-date-end,
      999                  input x-shift-end,
     1000                  input r-kind).
     1001   END PROCEDURE.
     1002   PROCEDURE my-var :
     1003   END PROCEDURE.
     1004   PROCEDURE send-records :
     1005   END PROCEDURE.
     1006   PROCEDURE state-changed :
     1007     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1008     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1009     CASE p-state:
     1010       WHEN 'update-begin':U THEN DO:
     1011           RUN dispatch('enable-fields':U).
     1012           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1013           DO:
     1014             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1015             RUN new-state('update-complete':U).
     1016           END.
     1017           ELSE RUN new-state ('update':U).
     1018       END.
     1019       WHEN 'update-complete':U THEN DO:
     1020           RUN new-state ('update-complete':U).
     1021       END.
     1022     END CASE.
     1023   END PROCEDURE.
