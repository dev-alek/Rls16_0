     3596            then do:
     3597               assign
     3598                  v-torgconf-ogr-name = ""
     3599                  v-torgconf-ogr-post = ""
     3600               .
     3601            end.
     3602         if v-torgconf-outogr  = "ruk_firm"
     3603               then do:
     3604               find first buf_sysconf no-lock
     3605               where buf_sysconf.host-code = p-host-code
     3606               no-error.
     3607               if available buf_sysconf
     3608               then do:
     3609                  assign
     3610                     v-torgconf-ogr-post = buf_sysconf.head-position
     3611                  .
     3612               end.
     3613               find first buf_clients no-lock
     3614                  where buf_clients.obj-type = 'орг':U
     3615                  and buf_clients.obj-code = p-host-code
     3616               .
     3617               find first buf_firm no-lock
     3618                  where buf_firm.firm-code = buf_clients.obj-code
     3619               .
     3620               assign
     3621                  v-torgconf-ogr-name = buf_firm.director
     3622               .
     3623            end.
     3624            if v-torgconf-outogr = "dir_obj"
     3625               then do:
     3626               find first buf_wth-doc no-lock
     3627               where buf_wth-doc.doc-code = p-doc-code
     3628               no-error.
     3629                  find first buf_shop no-lock
     3630                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3631                  .
     3632                  assign
     3633                     v-torgconf-ogr-name = buf_shop.director
     3634                     v-torgconf-ogr-post = "Директор"
     3635                  .
     3636               end.
     3637         if v-torgconf-outogr = "manag_doc"
     3638            then do:
     3639               find first buf_wth-doc no-lock
     3640               where buf_wth-doc.doc-code = p-doc-code
     3641               no-error.
     3642               if available buf_wth-doc
     3643               then do:
     3644                  run rep/get-psn.p
     3645                  (input buf_wth-doc.deliver
     3646                  ,output v-torgconf-ogr-name
     3647                  ) .
     3648               end.
     3649               find first buf_person no-lock
     3650               where buf_person.psn-code = buf_wth-doc.deliver
     3651               no-error.
     3652               if available buf_person
     3653               then do:
     3654                  v-torgconf-ogr-post = buf_person.position.
     3655               end.
     3656               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3657               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3658            end.
     3659      end.
     3660   end.
     3661   procedure torgconf-get-reason  :
     3662   define input parameter  p-doc-code       as character        no-undo.
     3663   define input parameter  p-reason-code    as integer          no-undo .
     3664   define input parameter  p-doc-type       as character        no-undo.
     3665       if p-reason-code > 0
     3666       then do:
     3667           define buffer buf_trn-reason for ub.trn-reason.
     3668           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3669           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3670       end.
     3671       else do:
     3672           if p-doc-type = 'при':U
     3673           then  do:
     3674               define variable v-attr-type     as character    no-undo.
     3675               define variable v-attr-value    as character    no-undo.
     3676               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3677               assign v-torgconf-reason = v-attr-value .
     3678               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3679               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3680           end.
     3681       end.
     3682   end procedure.
