     4452           chr(9)   buf_temp_line-data.EI
     4453           chr(9)   buf_temp_line-data.OKEI
     4454           chr(9)   buf_temp_line-data.pack
     4455           chr(9)   buf_temp_line-data.AmountInPl
     4456           chr(9)   buf_temp_line-data.PlaceAmount
     4457           chr(9)   buf_temp_line-data.Mass
     4458           chr(9)   buf_temp_line-data.qnty
     4459           chr(9)   buf_temp_line-data.price
     4460           chr(9)   buf_temp_line-data.SumNoVAT
     4461           chr(9)   buf_temp_line-data.VATpc
     4462           chr(9)   buf_temp_line-data.VATsum
     4463           chr(9)   buf_temp_line-data.sum
