      919   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      920   define new global shared variable g#trdcalib as handle no-undo.
      921   procedure wthcattr-sprcli :
      922   define input parameter parparentproc  as widget-handle no-undo.
      923   define input parameter p-mode  as character no-undo.
      924   define input-output parameter p-value as character no-undo .
      925   define output parameter p-setted as logical no-undo .
      926     DEFINE VARIABLE v-value as character no-undo .
      927     define variable v-cli-type as character no-undo .
      928     define variable v-cli-code as integer no-undo .
      929     define buffer buf_clients   for ub.clients.
      930     define variable v_rid as character no-undo.
      931     define variable ref-rec as recid no-undo .
      932     do
      933     on error undo, return error
      934     :
      935         v-value = p-value.
      936      if p-value <> '':U then do:
      937       assign
      938       v-cli-type = substring(p-value, 1, 3)
      939       v-cli-code = integer(substring(p-value, 4))
      940       no-error.
      941       if error-status:error then do:
      942         assign
      943         v-cli-type = '':U
      944         v-cli-code = 0
      945         .
      946       end.
      947      end.
      948      FIND FIRST buf_clients NO-LOCK WHERE
      949               buf_clients.obj-type = v-cli-type AND
      950               buf_clients.obj-code = v-cli-code  NO-ERROR.
      951      IF available(buf_clients) then do:
      952       run ref/cli-all.w (
      953                   input parparentproc
      954                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      955                  ,input v-cli-type
      956                  ,input 'все':U
      957                  ,input 'все':U
      958                  ,input RECID( buf_clients )
      959                  ,input ",,,,,,NO"
      960                  ,input ?
      961                  ,OUTPUT v_rid ).
      962     END.
      963     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      964       run ref/cli-all.w (
      965                    input parparentproc
      966                   ,INPUT "b-sel":U
      967                  ,input  v-cli-type
      968                  ,input 'все':U
      969                  ,input 'текущие':U
      970                  ,input ?
      971                  ,input ",,,,,,NO"
      972                  ,input ?
      973                  ,OUTPUT v_rid ).
      974     END.
      975     else do:
      976       message
      977       if p-value = "":U then 'Атрибут не задан!'
      978       else substitute('Не найден клиент &1',p-value)
      979       view-as alert-box warning.
      980     end.
      981     IF v_rid <> ? AND v_rid <> "":U THEN DO:
      982       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
      983       IF ERROR-STATUS:ERROR THEN DO:
      984           RETURN NO-APPLY.
      985       END.
      986       FIND FIRST buf_clients NO-LOCK WHERE
      987                  RECID( buf_clients ) = ref-rec NO-ERROR.
      988       IF AVAIL buf_clients THEN DO:
      989         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
      990       end.
      991     end.
      992     if v-value <> p-value then do:
      993       p-value = v-value.
      994       p-setted = yes.
      995     end.
      996     end.
      997   end procedure.
      998     define new global shared variable g#wthcalib as handle no-undo.
      999   procedure torgconf-read :
