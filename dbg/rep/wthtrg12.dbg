     5304           v-underline format "X(29)" at 151 skip
     5305           string( "Масса груза (нетто) " + v-underline ) format "X(85)" at 60
     5306                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip
     5307           space(10) string( "Всего мест " + v-doc-places ) format "X(45)"
     5308                   string( "Масса груза (брутто) " + v-underline ) format "X(85)" at 60
     5309                   string( "|" + v-underline ) format "X(30)" at 150 "|" skip
     5310           string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( v-underline, "X(42)" ) + " листах" ) format "X(95)" "|" at 97
     5311               string( "По доверенности N " +
     5312               IF p-torgconf-ndovwho = "":U
     5313               THEN
     5314               (string( v-underline, "X(39)" ) + " от " + v-underline)
     5315               ELSE
     5316               p-torgconf-ndovwho
     5317               ) format "X(100)" at 99 skip
     5318           "Всего отпущено на сумму " format "X(95)" "|" at 97
     5319               IF p-torgconf-ndovwho = "":U
     5320               THEN
     5321               string( "выданной " + v-underline )
     5322               ELSE
     5323               "":U
     5324            format "X(100)" at 99 skip
     5325           space(2) CAPS(s1) format "X(93)" "|" at 97 skip
     5326       .
     5327       run torg12xl-write-cell-data in this-procedure (
     5328             input "N_ndovwho"
     5329           , input(p-torgconf-ndovwho)
     5330       ).
     5331       run torg12xl-write-cell-data in this-procedure (
     5332             input "f_lineAmount":U
     5333           , input CAPS( txt-LC )
     5334       ).
     5335       assign
     5336           s1 = breakstr( s1, 40, input-output s1, input-output s2)
     5337       .
     5338       run torg12xl-write-cell-data in this-procedure (
     5339             input "f_sumLiteral1":U
     5340           , input s1
     5341       ).
     5342       run torg12xl-write-cell-data in this-procedure (
     5343             input "f_sumLiteral2":U
     5344           , input s2
     5345       ).
     5346       if trim(v-torgconf-main-buh) = ""
     5347       or v-torgconf-outsubs <> no
     5348       then do:
     5349         v-torgconf-main-buh = "________________________":U.
     5350       end.
     5351       put stream out-stream
     5352           "Отпуск разрешил: "
     5353       .
     5354       if trim(v-torgconf-ogr-post) = "":U
     5355       or v-torgconf-outsubs <> no
     5356       then do:
     5357           put stream out-stream
     5358               ": _____________"
     5359           .
     5360       end.
     5361       else do:
     5362           put stream out-stream
     5363           space(6)   string( v-torgconf-ogr-post) format "X(19)"
     5364           .
     5365       end.
     5366      if trim(v-torgconf-ogr-name) = ""
     5367       or v-torgconf-outsubs <> no
     5368       then do:
     5369         v-torgconf-ogr-name = "________________________":U.
     5370       end.
     5371       define variable v-deliver    as character    no-undo.
     5372       define variable v-deliv      as character    no-undo.
     5373       define variable v-accept       as character    no-undo.
     5374       FIND FIRST buf_clients
     5375            WHERE buf_clients.obj-type = 'чел':U
     5376              AND buf_clients.obj-code = buf_wth-doc.deliver
     5377            NO-LoCK
     5378            NO-ERROR
     5379            .
     5380       IF AVAILABLE buf_clients
     5381       THEN DO:
     5382         ASSIGN
     5383            v-deliver = buf_clients.obj-name
     5384         .
     5385       END.
     5386       ASSIGN
     5387         v-deliv = IF  buf_wth-doc.doc-type = 'при':U
     5388                  OR  buf_wth-doc.doc-type = 'возврат':U
     5389                  THEN v-underline
     5390                  ELSE IF v-deliver = "":U
     5391                       OR v-torgconf-outsubs = yes
     5392                                       THEN v-underline
     5393                                       ELSE v-deliver
     5394       .
     5395       ASSIGN
     5396         v-accept  = IF  buf_wth-doc.doc-type = 'при':U
     5397                  OR  buf_wth-doc.doc-type = 'возврат':U
     5398                  THEN IF v-deliver = "":U
     5399                       OR v-torgconf-outsubs = yes
     5400                                       THEN v-underline
     5401                                       ELSE v-deliver
     5402                  ELSE IF p-torgconf-accept-fname = "":U
     5403                       OR v-torgconf-outsubs = yes
     5404                                       THEN v-underline
     5405                                       ELSE p-torgconf-accept-fname
     5406       .
     5407       put stream out-stream
     5408           string( "___________________ / " +  v-torgconf-ogr-name ) format "X(52)" "/ |":U at 95 skip
     5409           string( "Главный бухгалтер: ________________________________ / " +  v-torgconf-main-buh ) format "X(93)" "/ |" at 95 skip
     5410           string( "Отпуск груза произвел кладовщик: " + v-deliv ) format "X(95)" "|" at 97
     5411            string( "Груз принял: " + v-accept
     5412                                       ) format "X(100)" at 99 skip
     5413           v-underline format "X(95)" "|" at 97 string( "Груз получил грузополучатель " + v-underline ) format "X(100)" at 99 skip
     5414           "М.П." at 15  "|" at 97 "М.П." at 99 skip
     5415       .
     5416       run torg12xl-write-cell-data in this-procedure (
     5417              input "f_permitterStatus":U
     5418            , input ( if v-torgconf-outsubs = no then v-torgconf-ogr-post else "":U )
     5419         ).
     5420       run torg12xl-write-cell-data in this-procedure (
     5421             input "f_permitterName":U
     5422           , input ( if v-torgconf-outsubs = no then v-torgconf-ogr-name else "":U )
     5423       ).
     5424       run torg12xl-write-cell-data in this-procedure (
     5425             input "f_buhName":U
     5426           , input ( if v-torgconf-outsubs = no then v-torgconf-main-buh else "":U )
     5427       ).
     5428       IF  buf_wth-doc.doc-type = 'при':U
     5429       OR  buf_wth-doc.doc-type = 'возврат':U
     5430       THEN DO:
     5431         run torg12xl-write-cell-data in this-procedure (
     5432             input "accept_fname"
     5433           , input ( if v-torgconf-outsubs = no  then v-deliver else "":U )
     5434         ).
     5435       END.
     5436       ELSE DO:
     5437         run torg12xl-write-cell-data in this-procedure (
     5438             input "f_wkr_name"
     5439           , input ( if v-torgconf-outsubs = no  then v-deliver else "":U )
     5440         ).
     5441         run torg12xl-write-cell-data in this-procedure (
     5442             input "accept_fname"
     5443           , input ( if v-torgconf-outsubs = no  then p-torgconf-accept-fname else "":U )
     5444         ).
     5445       END.
     5446       run torg12xl-close in this-procedure (input p-mode) .
     5447       output stream out-stream close.
     5448   if session :set-wait-state( "" ) then.
     5449   if g#quest-print = false
     5450   then do:
     5451     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5452                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5453                                         OUTPUT g#log ).
     5454   end.
     5455   else do:
     5456     os-command silent
     5457       value( "COPY /b " +
     5458         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5459         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5460         string( session:temp-directory) +  "$" + string( g#report-num )
     5461                 ) .
     5462     os-command silent
     5463       value( "COPY /b " +
     5464         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5465         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5466         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5467                 ) .
     5468   end.
     5469   end.
     5470   procedure print-line :
     5471   define input parameter p-gds-code   as integer          no-undo.
     5472   define input parameter p-price-rubl as decimal          no-undo.
     5473   define input parameter p-vat-pc     as decimal          no-undo.
     5474       define variable v-price-is-changed      as logical  no-undo.
     5475       define variable v-sum-prt-qnty                  as decimal      no-undo.
     5476       define variable v-avg-prt-price                 as decimal      no-undo.
     5477       define variable v-avg-prt-price-no-tax          as decimal      no-undo.
     5478       define variable v-sum-SLT                       as decimal      no-undo.
     5479       define variable v-sum-VAT                       as decimal      no-undo.
     5480       define variable v-avg-VAT                       as decimal      no-undo.
     5481       define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
     5482       define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
     5483       define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
     5484       define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
     5485       define variable v-gds-name-length               as integer      no-undo.
     5486       define variable v-void-decimal                  as decimal      no-undo.
     5487       define variable v-price-no-VAT                  as decimal      no-undo.
     5488       define variable v-VAT-pc                        as decimal      no-undo.
     5489       define variable v-SLT-pc                        as decimal      no-undo.
     5490       define buffer buf_temp_wthgds_price-group       for temp_wthgds_price-group.
     5491       define buffer buf_country                       for ub.country.
     5492       define buffer buf_units                         for ub.units.
     5493       define buffer buf_goods                         for ub.goods.
     5494   do
     5495   for buf_temp_wthgds_price-group
     5496     , buf_country
     5497     , buf_units
     5498     , buf_goods
     5499   on error undo, return error
     5500   :
     5501       find first buf_temp_wthgds_price-group
     5502            where buf_temp_wthgds_price-group.gds-code   = p-gds-code
     5503              and buf_temp_wthgds_price-group.price-rubl = p-price-rubl
     5504              and buf_temp_wthgds_price-group.vat-pc     = p-vat-pc
     5505       .
     5506       find first buf_goods no-lock
     5507            where buf_goods.gds-code = buf_temp_wthgds_price-group.gds-code
     5508       .
     5509       assign
     5510           v-gds-name-length = ( if v-torgconf-outt12 = yes then 52 else 27 )
     5511       .
     5512       run get-okei in this-procedure (
     5513             input buf_goods.unit-base
     5514           , output v-okei
     5515       ).
     5516       if FullGdsName
     5517       then do:
     5518           gds-str1 = breakstr(buf_goods.gds-name, v-gds-name-length, input-output gds-str1, input-output gds-str2).
     5519           assign v-char-counter = 0.
     5520           do while gds-str2 <> "" :
     5521               assign
     5522                   gds-str = gds-str2
     5523                   gds-str1 = breakstr(gds-str, v-gds-name-length, input-output gds-str1, input-output gds-str2)
     5524                   v-char-counter = v-char-counter + 1
     5525               .
     5526           end.
     5527           if line-counter( out-stream ) + v-char-counter > page-size( out-stream )
     5528           then do:
     5529   define variable vss-include-info26 as character format "X(65)" no-undo
     5530   initial "@(#)$Workfile$ $Revision$".
     5531   if page-number( out-stream ) > prevpage then
     5532       assign
     5533           Pg-tqnty = 0
     5534           Pg-VAT-gds = 0
     5535           Pg-SLT-gds = 0
     5536           Pg-stoim-noNDS = 0
     5537           Pg-stoim = 0
     5538           .
     5539           do:
     5540               put stream out-stream v-single-line format "x(198)" skip.
     5541               if v-torgconf-outt12 = yes
     5542               then do:
     5543                   display stream out-stream
     5544                       "Итого" @ v-gds-name
     5545                       Pg-tqnty @ tqnty
     5546                       Pg-stoim-noNDS @ stoim-noNDS
     5547                       Pg-VAT-gds  @ VAT-gds
     5548                       Pg-stoim @ stoim
     5549                   with frame f-doc-m .
     5550                   down stream out-stream 1 with frame f-doc-m .
     5551               end.
     5552               else do:
     5553                   display stream out-stream
     5554                       "Итого" @ v-gds-name
     5555                       Pg-tqnty @ tqnty
     5556                       Pg-stoim-noNDS @ stoim-noNDS
     5557                       Pg-VAT-gds  @ VAT-gds
     5558                       Pg-stoim @ stoim
     5559                       Pg-SLT-gds  @ SLT-gds
     5560                   with frame f-doc .
     5561                   down stream out-stream 1 with frame f-doc .
     5562               end.
     5563           end.
     5564               PAGE stream out-stream.
     5565           end.
     5566           assign
     5567               gds-str1 = breakstr(buf_goods.gds-name, v-gds-name-length, input-output gds-str1, input-output gds-str2)
     5568           .
     5569       end.
     5570       else do:
     5571           assign
     5572               gds-str1 = buf_goods.gds-name
     5573           .
     5574       end.
     5575       find first ub.gds-prt no-lock
     5576            where ub.gds-prt.upper-code = buf_goods.prt-root
     5577       .
     5578       assign
     5579           v-rootnode-code = ub.gds-prt.node-code
     5580       .
     5581   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5582     (input  buf_goods.gds-code
     5583     ,input  v-rootnode-code
     5584     ,output tb-code
     5585     )  .
     5586       assign
     5587           tqnty    = buf_temp_wthgds_price-group.qnty
     5588           unit-str = buf_goods.unit-base
     5589       .
     5590       if Invers
     5591       then do:
     5592           assign
     5593               VAT-gds       = varprice-vat
     5594               SLT-gds       = varprice-slt
     5595               price-withNDS = varprice-no-vat-slt + VAT-gds + SLT-gds
     5596           .
     5597       end.
     5598       else do:
     5599           assign
     5600               VAT-gds         = ( if tqnty = 0.0
     5601                                   then 0.0
     5602                                   else ( if PrintRubl
     5603                                   then buf_temp_wthgds_price-group.sum-vat-rubl / tqnty
     5604                                   else buf_temp_wthgds_price-group.sum-vat-base / tqnty ) )
     5605               SLT-gds         = 0.0
     5606               v-tax-price     = 0.0
     5607               price-withNDS   = ( if PrintRubl
     5608                                   then buf_temp_wthgds_price-group.price-rubl
     5609                                   else buf_temp_wthgds_price-group.price-base )
     5610               v-tax           = 0.0
     5611               v-tax-sum       = 0.0
     5612           .
     5613       end.
     5614       if VAT-gds = ? then assign VAT-gds = 0.
     5615       if SLT-gds = ? then assign SLT-gds = 0.
     5616       assign
     5617           price-noNDS = price-withNDS - VAT-gds - SLT-gds
     5618       .
     5619       if p-round = "round":U
     5620       then do:
     5621           run p-fmt-round in this-procedure (
     5622                 input tqnty
     5623               , input price-noNDS
     5624               , input VAT-gds
     5625               , input SLT-gds
     5626               , input 0
     5627               , output price-noNDS
     5628               , output v-VAT-pc
     5629               , output v-void-decimal
     5630               , output VAT-gds
     5631               , output v-void-decimal
     5632               , output v-void-decimal
     5633               , output stoim-noNDS
     5634               , output stoim
     5635           ).
     5636           assign
     5637               stoim           = stoim - SLT-gds
     5638               price-withNDS   = stoim / tqnty
     5639           .
     5640       end.
     5641       else do:
     5642           assign
     5643               VAT-gds     = VAT-gds * tqnty
     5644               SLT-gds     = SLT-gds * tqnty
     5645               stoim-noNDS = price-noNDS * tqnty
     5646               stoim       = stoim-noNDS + VAT-gds
     5647           .
     5648       end.
     5649       assign
     5650           v-artic = buf_goods.artic
     5651       .
     5652       if v-torgconf-outt12 = yes
     5653       then do:
     5654           display stream out-stream
     5655               v-doc-line-counter
     5656               v-artic
     5657               gds-str1 @ v-gds-name
     5658               tb-code
     5659               unit-str @ ub.goods.unit-base
     5660               v-okei
     5661               tqnty
     5662               price-noNDS
     5663               stoim-noNDS
     5664               p-vat-pc @ ub.doc-line.VAT-pc
     5665               VAT-gds when tqnty <> 0
     5666               stoim
     5667               sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     5668               sym11 sym12 sym13 sym14 sym15 sym16 sym19
     5669           with frame f-doc-m.
     5670           down stream out-stream 1 with frame f-doc-m.
     5671       end.
     5672       else do:
     5673           display stream out-stream
     5674               v-doc-line-counter
     5675               v-artic
     5676               gds-str1 @ v-gds-name
     5677               tb-code
     5678               unit-str @ ub.goods.unit-base
     5679               v-okei
     5680               tqnty
     5681               price-noNDS
     5682               stoim-noNDS
     5683               p-vat-pc @ ub.doc-line.VAT-pc
     5684               VAT-gds when tqnty <> 0
     5685               stoim
     5686               SLT-gds when tqnty <> 0
     5687               price-withNDS
     5688               sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     5689               sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19
     5690           with frame f-doc.
     5691           down stream out-stream 1 with frame f-doc.
     5692       end.
     5693       run torg12xl-write-line-data in this-procedure (
     5694             input v-doc-line-counter
     5695           , input substitute( "&1 &2", buf_goods.artic, buf_goods.gds-name )
     5696           , input string( tb-code )
     5697           , input unit-str
     5698           , input "":U
     5699           , input "":U
     5700           , input "":U
     5701           , input "":U
     5702           , input "":U
     5703           , input string( tqnty )
     5704           , input string( price-noNDS )
     5705           , input string( stoim-noNDS )
     5706           , input string( p-vat-pc    )
     5707           , input string( VAT-gds )
     5708           , input string( stoim + SLT-gds )
     5709       ).
     5710   define variable vss-include-info27 as character format "X(65)" no-undo
     5711   initial "@(#)$Workfile$ $Revision$".
     5712       if FullGdsName
     5713       then do:
     5714           do while gds-str2 <> ""
     5715           :
     5716               assign
     5717                   gds-str = gds-str2
     5718                   gds-str1 = breakstr(gds-str, v-gds-name-length, input-output gds-str1, input-output gds-str2)
     5719               .
     5720               if v-torgconf-outt12 = yes
     5721               then do:
     5722                   display stream out-stream
     5723                       gds-str1 @ v-gds-name
     5724                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     5725                       sym11 sym12 sym13 sym14 sym15 sym16 sym19
     5726                   with frame f-doc-m .
     5727                   down stream out-stream 1 with frame f-doc-m .
     5728               end.
     5729               else do:
     5730                   display stream out-stream
     5731                       gds-str1 @ v-gds-name
     5732                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     5733                       sym11 sym12 sym13 sym14 sym15 sym16 sym17 sym18 sym19
     5734                   with frame f-doc .
     5735                   down stream out-stream 1 with frame f-doc .
     5736               end.
     5737           end.
     5738       end.
     5739   if page-number( out-stream ) > prevpage then
     5740       assign
     5741           Pg-tqnty = 0
     5742           Pg-VAT-gds = 0
     5743           Pg-SLT-gds = 0
     5744           Pg-stoim-noNDS = 0
     5745           Pg-stoim = 0
     5746           .
     5747           assign
     5748               PrevPage = page-number( Out-Stream )
     5749               Pg-tqnty = Pg-tqnty +  tqnty
     5750               Pg-VAT-gds = Pg-VAT-gds +  VAT-gds
     5751               Pg-SLT-gds = Pg-SLT-gds +  SLT-gds
     5752               Pg-stoim-noNDS = Pg-stoim-noNDS +  stoim-noNDS
     5753               Pg-stoim = Pg-stoim +  stoim
     5754               .
     5755       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
     5756           do:
     5757               put stream out-stream v-single-line format "x(198)" skip.
     5758               if v-torgconf-outt12 = yes
     5759               then do:
     5760                   display stream out-stream
     5761                       "Итого" @ v-gds-name
     5762                       Pg-tqnty @ tqnty
     5763                       Pg-stoim-noNDS @ stoim-noNDS
     5764                       Pg-VAT-gds  @ VAT-gds
     5765                       Pg-stoim @ stoim
     5766                   with frame f-doc-m .
     5767                   down stream out-stream 1 with frame f-doc-m .
     5768               end.
     5769               else do:
     5770                   display stream out-stream
     5771                       "Итого" @ v-gds-name
     5772                       Pg-tqnty @ tqnty
     5773                       Pg-stoim-noNDS @ stoim-noNDS
     5774                       Pg-VAT-gds  @ VAT-gds
     5775                       Pg-stoim @ stoim
     5776                       Pg-SLT-gds  @ SLT-gds
     5777                   with frame f-doc .
     5778                   down stream out-stream 1 with frame f-doc .
     5779               end.
     5780           end.
     5781       assign
     5782           v-line-counter     = v-line-counter + 1
     5783           v-doc-line-counter = v-doc-line-counter + 1
     5784       .
     5785   end.
     5786   end procedure.
     5787   procedure print-header :
     5788   define input parameter p-currency-curr-abbr as character        no-undo.
     5789       define variable v-print-doc                 as character                no-undo.
     5790       define buffer buf_wth-doc       for ub.wth-doc.
     5791       define buffer buf_clients       for ub.clients.
     5792       define buffer buf_shop          for ub.shop.
     5793       define buffer buf_temp_p-fmt_string-part    for temp_p-fmt_string-part.
     5794   do
     5795   for buf_wth-doc
     5796     , buf_clients
     5797     , buf_shop
     5798   on error undo, return error
     5799   :
     5800       find first buf_wth-doc no-lock
     5801            where buf_wth-doc.doc-code = p-doc-code
     5802       .
     5803       run gbl/conf-rd.p (
     5804             input "factur01":U
     5805           , input ""
     5806           , input ""
     5807           , input 0
     5808           , input ""
     5809           , input ""
     5810           , input ""
     5811           , input no
     5812           , output v-print-doc
     5813           , output v-par-type
     5814       ) no-error.
     5815       if error-status :error
     5816       then do:
     5817           assign
     5818               v-print-doc = "no"
     5819           .
     5820       end.
     5821       run torgconf-get-form-header in this-procedure (
     5822             input Invers
     5823           , input buf_wth-doc.doc-code
     5824           , input ( v-print-doc = "yes" )
     5825           , input buf_wth-doc.doc-date
     5826           , input buf_wth-doc.fact-date
     5827           , input buf_wth-doc.doc-type
     5828           , input buf_wth-doc.status_
     5829           , input p-reverse
     5830           , input no
     5831       ).
     5832       run torg12xl-write-cell-data in this-procedure (
     5833             input "h_docCode":U
     5834           , input v-torgconf-doc-code
     5835       ).
     5836       run torg12xl-write-cell-data in this-procedure (
     5837             input "h_tbl_docCode":U
     5838           , input v-torgconf-doc-code
     5839       ).
     5840       run torg12xl-write-cell-data in this-procedure (
     5841             input "h_docDate":U
     5842           , input v-torgconf-doc-date
     5843       ).
     5844       run torg12xl-write-cell-data in this-procedure (
     5845             input "h_tbl_docDate":U
     5846           , input v-torgconf-doc-date
     5847       ).
     5848       find first buf_clients no-lock
     5849            where buf_clients.obj-type = buf_wth-doc.obj-type
     5850              and buf_clients.obj-code = buf_wth-doc.obj-code
     5851       no-error.
     5852       case buf_clients.obj-type :
     5853           when 'маг':U
     5854           then do:
     5855               find first ub.shop where ub.shop.obj-code = buf_clients.obj-code no-lock .
     5856               tdoc-prt = ub.shop.doc-prt.
     5857           end.
     5858           when 'скл':U
     5859           then do:
     5860               find first ub.store where ub.store.obj-code = buf_clients.obj-code no-lock .
     5861               tdoc-prt = ub.store.doc-prt .
     5862           end.
     5863       end case.
     5864       if not tdoc-prt or Invers = yes
     5865       then do:
     5866           assign
     5867               PrintScale = no
     5868           .
     5869       end.
     5870       form header
     5871           v-single-line format "X(198)" at 1 SKIP
     5872           "Продолжение - на следующей странице" at 30 SKIP
     5873           with frame BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     5874       view stream out-stream frame BottomFrame .
     5875       assign
     5876           val-str = ( if Invers then p-currency-curr-abbr else ( if PrintRubl then "рублях" else "баз.вал" ) )
     5877       .
     5878       if v-torgconf-outappr = yes
     5879       then do:
     5880           put stream out-stream
     5881                    "Унифицированная форма № ТОРГ-12"                                at 137
     5882               skip "Утверждена постановлением Госкомстата России от 25.12.98 N 132" at 137
     5883           .
     5884       end.
     5885       put stream out-stream
     5886           space(5) v-single-line          format  "X(19)"     at 180 skip
     5887           space(5) "| "                                       at 180
     5888               'код':U                                     at 188
     5889               "|"                                             at 198 skip
     5890           space(5) "Форма по ОКУД"        format "X(14)"      at 166
     5891           "| "                                                at 180
     5892           "0330212"
     5893           "|"                                                 at 198 skip
     5894       .
     5895       if v-torgconf-outrecv = yes
     5896       then do:
     5897           run p-fmt-split in this-procedure (
     5898                 input v-torgconf-organization
     5899               , input 150
     5900           ).
     5901           for each buf_temp_p-fmt_string-part
     5902           :
     5903               if buf_temp_p-fmt_string-part.str-key = 1
     5904               then do:
     5905                   put stream out-stream
     5906                       space(5) buf_temp_p-fmt_string-part.string-part format "X(160)"
     5907                               "по ОКПО"                               format "X(7)"   at 172
     5908                               "| "                                        at 180
     5909                               v-torgconf-okpo                         format "X(16)"
     5910                               "|"                                         at 198 skip
     5911                   .
     5912               end.
     5913               else do:
     5914                   put stream out-stream
     5915                       space(16) buf_temp_p-fmt_string-part.string-part format "X(149)"
     5916                               "       "                               format "X(7)"   at 172
     5917                               "| "                                        at 180
     5918                               " "                                     format "X(16)"
     5919                               "|"                                         at 198 skip
     5920                   .
     5921               end.
     5922           end.
     5923       end.
     5924       else do:
     5925           put stream out-stream
     5926           space(5) v-torgconf-organization    format "X(160)"
     5927                    "по ОКПО"                  format "X(7)"   at 172
     5928                    "| "                                       at 180
     5929                    v-torgconf-okpo            format "X(16)"
     5930                    "|"                                        at 198 skip
     5931           .
     5932       end.
     5933          put stream out-stream
     5934           space(5)  v-torgconf-client-from    format "X(160)"
     5935                    "| "                                       at 180
     5936                    "|"                                        at 198 skip
     5937           space(5) "Вид деятельности по ОКДП" format "X(25)"  at 155
     5938                    "| "                                       at 180
     5939                    "|"                                        at 198 skip
     5940       .
     5941       run torg12xl-write-cell-data in this-procedure (
     5942             input "h_OKPO_0":U
     5943           , input v-torgconf-okpo
     5944       ).
     5945       run torg12xl-write-cell-data in this-procedure (
     5946           input "h_orgFrom":U
     5947           , input v-torgconf-organization
     5948       ).
     5949       run torg12xl-write-cell-data in this-procedure (
     5950           input "h_cliFrom":U
     5951           , input v-torgconf-client-from
     5952       ).
     5953       run torg12xl-write-cell-data in this-procedure (
     5954             input "h_cargoTo":U
     5955           , input v-torgconf-torg12-cargo-label
     5956       ).
     5957      if ( buf_wth-doc.doc-type = 'при':U
     5958      or buf_wth-doc.doc-type = 'возврат':U )
     5959      and buf_wth-doc.ext-doc-type <> 're':U
     5960      and buf_wth-doc.ext-doc-type <> 'pz':U
     5961      then do:
     5962       run torg12xl-write-cell-data in this-procedure (
     5963             input "h_cargoToValue":U
     5964           , input v-torgconf-torg12-cargo-value
     5965       ).
     5966      end.
     5967      else do:
     5968       run torg12xl-write-cell-data in this-procedure (
     5969             input "h_cargoToValue":U
     5970           , input v-torgconf-consignee
     5971       ).
     5972      end.
     5973       if v-torgconf-self-obj-type = 'маг':U
     5974       then do:
     5975           find first buf_shop no-lock
     5976                where buf_shop.obj-code = v-torgconf-self-obj-code
     5977           no-error.
     5978           if available buf_shop
     5979           then do:
     5980               case buf_wth-doc.doc-type
     5981               :
     5982                   when 'рас':U
     5983                   then do:
     5984                   end.
     5985                   when 'возврат':U
     5986                   then do:
     5987                   end.
     5988               end case.
     5989           end.
     5990       end.
     5991       put stream out-stream
     5992           space(5) v-torgconf-torg12-cargo-string      format "X(160)"
     5993                   "по ОКПО"          format "X(7)"       at 172
     5994                   "| "                                   at 180
     5995                   v-torgconf-torg12-cargo-okpo         format "X(16)"
     5996                   "|"                                    at 198
     5997           skip
     5998       .
     5999       put stream out-stream
     6000           space(5) string( "Поставщик: " + v-torgconf-supplier )      format "X(160)"
     6001                    "по ОКПО"                                          format "X(7)"   at 172
     6002                    "| "                                                               at 180
     6003                    v-torgconf-supplier-okpo                            format "X(16)"
     6004                    "|"                                                                at 198 skip
     6005       .
     6006       run torg12xl-write-cell-data in this-procedure (
     6007             input "h_OKPO":U
     6008           , input v-torgconf-torg12-cargo-okpo
     6009       ).
     6010       run torg12xl-write-cell-data in this-procedure (
     6011             input "h_OKPO2":U
     6012           , input v-torgconf-supplier-okpo
     6013       ).
     6014       run torg12xl-write-cell-data in this-procedure (
     6015             input "h_OKPO3":U
     6016           , input v-torgconf-saler-okpo
     6017       ).
     6018       run torg12xl-write-cell-data in this-procedure (
     6019             input "h_supplier":U
     6020           , input v-torgconf-supplier
     6021       ).
     6022       define variable v-attr-value  as character no-undo .
     6023       define variable v-attr-type   as character no-undo .
     6024       define variable v-osnov       as character initial "" no-undo .
     6025   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input buf_wth-doc.doc-code ,
     6026                           input 'wthreason':U ,
     6027                          output v-osnov ,
     6028                          output v-attr-type )  .
     6029       put stream out-stream
     6030           space(5) string( "Плательщик: " + v-torgconf-saler )                                 format "X(160)"
     6031                           "по ОКПО" format "X(7)" at 172 "| " at 180 v-torgconf-saler-okpo format "X(16)" "|" at 198 skip
     6032           space(5) string( "Основание: " + v-osnov ) format "X(160)"
     6033                           "номер" format "X(5)" at 174 "| " at 180  "|" at 198 skip
     6034       .
     6035       run torg12xl-write-cell-data in this-procedure (
     6036           input "h_saler":U
     6037           , input v-torgconf-saler
     6038       ).
     6039       run torg12xl-write-cell-data in this-procedure (
     6040           input "h_reason":U
     6041           , input v-osnov
     6042       ).
     6043       if v-torgconf-outprim = yes
     6044       then do:
     6045       end.
     6046       else do:
     6047           put stream out-stream
     6048               space(5) string( "Примечание: " + ( if not( buf_wth-doc.PS begins "@" )
     6049                                                   then replace( buf_wth-doc.PS, chr(10), " " )
     6050                                                   else "" ) )                         format "X(163)"
     6051           .
     6052       end.
     6053       put stream out-stream
     6054                           "дата" format "X(4)" at 175 "| " at 180 "|" at 198 skip
     6055           space(5) string( "Вид оплаты: " ) format "X(130)"
     6056                           string( "Транспортная накладная " ) format "X(23)" at 147
     6057                           "номер" format "X(5)" at 174 "| " at 180 v-torgconf-doc-code format "X(16)" "|" at 198 skip
     6058           space(64) v-single-line format "X(33)"
     6059           space(5) "дата" format "X(4)" at 175 "| " at 180 v-torgconf-doc-date format "X(10)" "|" at 198 skip
     6060       .
     6061       define variable v-operation-type    as character    no-undo.
     6062       assign
     6063           v-operation-type = ( if buf_wth-doc.doc-type = 'при':U and not Invers and buf_wth-doc.exter_  = no
     6064                                       then " приход"
     6065                                       else ( if buf_wth-doc.doc-type = 'при':U and buf_wth-doc.exter_
     6066                                              then " возврат"
     6067                                              else " расход" ) )
     6068       .
     6069       run torg12xl-write-cell-data in this-procedure (
     6070             input "h_operationType":U
     6071           , input v-operation-type
     6072       ).
     6073       put stream out-stream
     6074           space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | "
     6075                                       + string( v-torgconf-doc-code, "X(16)") + " | "
     6076                                       + v-torgconf-doc-date
     6077                                       + " | " + (if buf_wth-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_wth-doc.status_) + ")" ) else "")
     6078                                       ) format "X(100)"
     6079           space(5) "Вид операции"   format "X(12)"    at 167
     6080                    "| "                               at 180
     6081                    v-operation-type format "X(16)"
     6082                    "|"                                at 198 skip
     6083           space(64) v-single-line format "X(33)"
     6084           space(5) v-single-line format  "X(19)" at 180 skip
     6085           .
     6086   end.
     6087   end procedure.
     6088   procedure get-okei :
     6089   define input parameter p-unit-base as character        no-undo.
     6090   define output parameter p-okei as character        no-undo.
     6091       define buffer buf_units         for ub.units.
     6092   do
     6093   for buf_units
     6094   on error undo, return error
     6095   :
     6096       find first buf_units no-lock
     6097            where buf_units.unit-name = p-unit-base
     6098       no-error.
     6099       if available buf_units
     6100       and buf_units.OKEI <> 0
     6101       then do:
     6102           assign
     6103               p-okei = string( buf_units.OKEI, ">999":U )
     6104           .
     6105       end.
     6106       else do:
     6107           assign
     6108               p-okei = "":U
     6109           .
     6110       end.
     6111   end.
     6112   end procedure.
