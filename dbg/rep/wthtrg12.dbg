     1166           if lookup( p-form-name, v-outrecv ) <> 0
     1167           then do:
     1168               assign
     1169                   v-torgconf-outrecv  = yes
     1170               .
     1171           end.
     1172           if lookup( p-form-name, v-outegrp ) <> 0
     1173           then do:
     1174               assign
     1175                   v-torgconf-outegrp  = yes
     1176               .
     1177           end.
     1178           if lookup( p-form-name, v-outt12  ) <> 0
     1179           then do:
     1180               assign
