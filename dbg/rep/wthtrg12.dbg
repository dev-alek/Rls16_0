     1776   end procedure.
     1777   procedure torgconf-get-holdfirm-code :
     1778   define input parameter p-obj-type   as character        no-undo.
     1779   define input parameter p-obj-code   as integer          no-undo.
     1780   define output parameter p-firm-code as integer          no-undo.
     1781       define variable v-firm-code-str     as character    no-undo.
     1782       define variable v-par-type          as character    no-undo.
     1783       define buffer buf_clients       for ub.clients.
     1784   do
     1785   for buf_clients
     1786   on error undo, return error
     1787   :
     1788       run gbl/clntat-v.p (
     1789             input p-obj-type
     1790           , input p-obj-code
     1791           , input 'holdfirm-code':U
     1792           , output v-firm-code-str
     1793           , output v-par-type
     1794       ).
     1795       assign
     1796           p-firm-code = integer( v-firm-code-str )
     1797       no-error.
     1798       if error-status :error
     1799       then do:
     1800           message
     1801               "Неверно задан код фирмы для печати накладных."
     1802           view-as alert-box warning.
     1803           assign
     1804               p-firm-code = 0
     1805           .
     1806       end.
     1807       else do:
     1808           find first buf_clients no-lock
     1809                where buf_clients.obj-type = 'орг':U
     1810                  and buf_clients.obj-code = p-firm-code
     1811           no-error.
     1812           if not available buf_clients
     1813           then do:
     1814               message
     1815                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1816                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1817               view-as alert-box warning.
     1818               assign
     1819                   p-firm-code = 0
     1820               .
     1821           end.
     1822       end.
     1823   end.
     1824   end procedure.
     1825   procedure torgconf-get-post-head:
     1826   define input  parameter p-obj-type             as character        no-undo.
     1827   define input  parameter p-obj-code             as integer          no-undo.
     1828   define output parameter p-torgconf-post-head   as character        no-undo.
     1829      define variable v-host-code         as integer      no-undo.
     1830      define buffer buf_sysconf     for ub.sysconf.
     1831        assign
     1832         p-torgconf-post-head  = ""
     1833        .
     1834   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1835   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1836     (input  p-obj-type
     1837     ,input  p-obj-code
     1838     ,output v-host-code
     1839     )  .
     1840      find first buf_sysconf no-lock
     1841      where buf_sysconf.host-code = v-host-code
     1842      no-error.
     1843      if available buf_sysconf
     1844      then do:
     1845         assign
     1846            p-torgconf-post-head = buf_sysconf.head-position
     1847         .
     1848      end.
     1849   end procedure.
     1850   procedure torgconf-get-storekeeper:
     1851   define input  parameter p-wrkr                   as integer          no-undo.
     1852   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1853   define output parameter p-torgconf-post          as character        no-undo.
     1854      define buffer buf_sysconf     for ub.sysconf.
     1855      define buffer buf_person      for ub.person.
     1856      define buffer buf_shop        for ub.shop .
     1857      define buffer buf_store       for ub.store .
     1858      if v-torgconf-outC = "no_print"
     1859      then do:
     1860         assign p-torgconf-post = ""
     1861                p-torgconf-wrkr-name = ""
     1862                .
     1863      end.
     1864      if v-torgconf-outC = "clad_doc"
     1865      then do:
     1866         run rep/get-psn.p
     1867               (input  p-wrkr
     1868               ,output p-torgconf-wrkr-name
     1869               ) .
     1870         find first buf_person no-lock
     1871         where buf_person.psn-code = p-wrkr
     1872         no-error.
     1873         if available buf_person
     1874         then do:
     1875           p-torgconf-post = buf_person.position.
     1876         end.
     1877         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1878         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1879      end.
     1880      if v-torgconf-outC = "clad_obj"
     1881      then do:
     1882         CASE v-torgconf-self-obj-type:
     1883         WHEN 'маг':U
     1884         THEN DO:
     1885            find first buf_shop no-lock
     1886            where buf_shop.obj-code = v-torgconf-self-obj-code
     1887            .
     1888            assign
     1889               p-torgconf-wrkr-name = buf_shop.store-man
     1890               p-torgconf-post = ""
     1891            .
     1892            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1893         END.
     1894         WHEN 'скл':U
     1895         THEN DO:
     1896            find first buf_store no-lock
     1897            where buf_store.obj-code = v-torgconf-self-obj-code
     1898            .
     1899            assign
     1900               p-torgconf-wrkr-name = buf_store.store-man
     1901               p-torgconf-post = ""
     1902            .
     1903            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1904         END.
     1905         OTHERWISE DO:
     1906            assign
     1907               p-torgconf-post = "":U
     1908               p-torgconf-wrkr-name = "":U
     1909            .
     1910         END.
     1911         END CASE.
     1912      end.
     1913    end procedure.
     1914   procedure torgconf-get-form-header :
     1915   define input parameter p-for-inverse    as logical          no-undo.
     1916   define input parameter p-doc-code       as character        no-undo.
     1917   define input parameter p-print-doc      as logical          no-undo.
     1918   define input parameter p-doc-date       as date             no-undo.
     1919   define input parameter p-fact-date      as date             no-undo.
     1920   define input parameter p-doc-type       as character        no-undo.
     1921   define input parameter p-status_        as character        no-undo.
     1922   define input parameter p-reverse        as logical          no-undo.
     1923   define input parameter p-sf-par         as logical          no-undo.
     1924       define variable v-attr-type         as character    no-undo.
     1925       define variable v-doc-code-standard as logical      no-undo.
     1926       define variable v-doc-date-standard as logical      no-undo.
     1927       define variable v-par-consignee-addres  as character    no-undo.
     1928       define variable v-host-code         as integer      no-undo.
     1929       define variable v-dcode-attr        as character    no-undo.
     1930       define variable v-ddate-attr        as character    no-undo.
     1931       define variable v-doc-date          as character    no-undo.
     1932       define variable v-doc-code          as character    no-undo.
     1933       define variable v-par-type          as character    no-undo.
     1934       define variable v-attr              as character    no-undo.
     1935       define buffer buf_firm          for ub.firm .
     1936       define buffer buf_clients       for ub.clients .
     1937       define buffer buf_sysconf       for ub.sysconf .
     1938       define buffer buf_shop          for ub.shop .
     1939       define buffer buf_store         for ub.store .
     1940       define buffer buf_person        for ub.person .
     1941       define buffer buf_trn-doc       for ub.trn-doc .
     1942       define buffer buf_wth-doc       for ub.wth-doc .
     1943       do
     1944   for buf_firm
     1945     , buf_clients
     1946     , buf_sysconf
     1947     , buf_shop
     1948     , buf_trn-doc
     1949     , buf_person
     1950     , buf_wth-doc
     1951   on error undo, return error
     1952   :
     1953       if p-doc-type = 'при':U
     1954       or p-doc-type = 'возврат':U
     1955       then do:
     1956           assign
     1957               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1958                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1959               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1960                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1961               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1962                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1963               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1964                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1965               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1966               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1967               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1968               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1969               v-torgconf-supplier-type    = v-torgconf-cli-type
     1970               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1971               v-torgconf-saler-type       = v-torgconf-self-host-type
     1972               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     1973               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     1974               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     1975               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     1976               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     1977               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     1978               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     1979               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     1980               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     1981               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     1982               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     1983               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     1984               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     1985               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     1986               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     1987           .
     1988           if v-torgconf-cli-schet-exists = yes
     1989           AND v-form-name                  = "torg12":U
     1990           then do:
     1991               assign
     1992                   v-torgconf-supplier = v-torgconf-supplier
     1993                       + substitute( ", р/с &1 к/с &2"
     1994                                   , v-torgconf-cli-bank-r-schet
     1995                                   , v-torgconf-cli-bank-c-schet
     1996                                   )
     1997                   v-torgconf-suppi = v-torgconf-supplier
     1998                       + substitute( ", р/с &1 к/с &2"
     1999                                   , v-torgconf-cli-bank-r-schet
     2000                                   , v-torgconf-cli-bank-c-schet
     2001                                   )
     2002               .
     2003               if v-torgconf-cli-bank-exists = yes
     2004               then do:
     2005                   assign
     2006                       v-torgconf-supplier = v-torgconf-supplier
     2007                           + substitute( " БИК &1 в &2 &3"
     2008                                       , v-torgconf-cli-bank-bik
     2009                                       , v-torgconf-cli-bank-name
     2010                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2011                                       )
     2012                      v-torgconf-suppi = v-torgconf-supplier
     2013                           + substitute( " БИК &1 в &2 &3"
     2014                                       , v-torgconf-cli-bank-bik
     2015                                       , v-torgconf-cli-bank-name
     2016                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2017                                       )
     2018                   .
     2019               end.
     2020           end.
     2021           if v-torgconf-self-schet-exists = yes
     2022           AND v-form-name                  = "torg12":U
     2023           then do:
     2024               assign
     2025                   v-torgconf-saler = v-torgconf-saler
     2026                       + substitute( ", р/с &1 к/с &2"
     2027                                   , v-torgconf-self-bank-r-schet
     2028                                   , v-torgconf-self-bank-c-schet
     2029                                   )
     2030               .
     2031               if v-torgconf-self-bank-exists = yes
     2032               then do:
     2033                   assign
     2034                       v-torgconf-saler = v-torgconf-saler
     2035                           + substitute( " БИК &1 в &2 &3"
     2036                                       , v-torgconf-self-bank-bik
     2037                                       , v-torgconf-self-bank-name
     2038                                       , v-torgconf-self-bank-addres
     2039                                       )
     2040                   .
     2041               end.
     2042           end.
     2043           if v-torgconf-sup-schet-exists = yes
     2044           AND v-form-name                  = "torg12":U
     2045           then do:
     2046               assign
     2047                   v-torgconf-consignee = v-torgconf-consignee
     2048                       + substitute( ", р/с &1 к/с &2"
     2049                                   , v-torgconf-sup-bank-r-schet
     2050                                   , v-torgconf-sup-bank-c-schet
     2051                                   )
     2052               .
     2053             if v-torgconf-sup-bank-exists = yes
     2054              then do:
     2055                assign
     2056                   v-torgconf-consignee = v-torgconf-consignee
     2057                           + substitute( " БИК &1 в &2 &3"
     2058                                       , v-torgconf-sup-bank-bik
     2059                                       , v-torgconf-sup-bank-name
     2060                                       , v-torgconf-sup-bank-addres
     2061                                       )
     2062                   .
     2063               end.
     2064           end.
     2065      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2066      then do:
     2067          assign
     2068            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2069                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2070                                                   , v-torgconf-cli-name
     2071                                                   , ( if v-torgconf-outprncd = yes
     2072                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2073                                                         else "":U )
     2074                                                   , v-torgconf-cli-post-addres
     2075                                                   , v-torgconf-cli-phone
     2076                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2077                                                       AND v-form-name                  = "torg12":U
     2078                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2079                                                               , v-torgconf-cli-bank-r-schet
     2080                                                               , v-torgconf-cli-bank-c-schet
     2081                                                               , v-torgconf-cli-bank-bik
     2082                                                               , v-torgconf-cli-bank-name
     2083                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2084                                                         else "":U )
     2085                                                )
     2086         .
     2087      end.
     2088       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2089                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2090                                        , v-torgconf-cli-name
     2091                                        , ( if v-torgconf-outprncd = yes
     2092                                            then substitute( " (&1)", v-torgconf-cli-code )
     2093                                            else "":U )
     2094                                        , v-torgconf-cli-addres
     2095                                        , v-torgconf-cli-phone
     2096                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2097                                            AND v-form-name                  = "torg12":U
     2098                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2099                                                           , v-torgconf-cli-bank-r-schet
     2100                                                           , v-torgconf-cli-bank-c-schet
     2101                                                           , v-torgconf-cli-bank-bik
     2102                                                           , v-torgconf-cli-bank-name
     2103                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2104                                                   else "":U )
     2105                                        ).
     2106       end.
     2107       else do:
     2108       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2109                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2110                                        , v-torgconf-self-host-name
     2111                                        , ( if v-torgconf-outprncd = yes
     2112                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2113                                            else "":U )
     2114                                        , v-torgconf-self-host-addres
     2115                                        , v-torgconf-self-host-phone
     2116                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2117                                            AND v-form-name                  = "torg12":U
     2118                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2119                                                           , v-torgconf-self-bank-r-schet
     2120                                                           , v-torgconf-self-bank-c-schet
     2121                                                           , v-torgconf-self-bank-bik
     2122                                                           , v-torgconf-self-bank-name
     2123                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2124                                                   else "":U )
     2125                                           ).
     2126         if v-torgconf-outares = yes
     2127         and p-reverse = no
     2128         then do:
     2129            assign
     2130               v-par-consignee-addres = v-torgconf-ship-post-addres
     2131            .
     2132         end.
     2133         if v-torgconf-outares = no
     2134         and p-reverse = no
     2135         then do:
     2136            assign
     2137               v-par-consignee-addres = v-torgconf-ship-addres
     2138            .
     2139         end.
     2140         if p-reverse = yes
     2141         then do:
     2142             assign
     2143               v-par-consignee-addres = v-torgconf-ship-addres
     2144             .
     2145         end.
     2146           assign
     2147               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2148                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2149               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2150                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2151               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2152                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2153               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2154               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2155               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2156               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2157               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2158               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2159               v-torgconf-saler-type       = v-torgconf-cli-type
     2160               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2161               v-torgconf-consignee-type   = v-torgconf-ship-type
     2162               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2163               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2164               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2165               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2166               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2167               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2168               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2169               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2170               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2171               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2172               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2173               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2174               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
