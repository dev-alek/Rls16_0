     3721   define variable vss-include-info15 as character format "X(65)" no-undo
     3722   initial "@(#)$Workfile$ $Revision$".
     3723   define temp-table temp_p-fmt_string-part no-undo
     3724       field str-key       as integer
     3725       field string-part   as character
     3726       index pi is primary unique
     3727           str-key
     3728   .
     3729   define variable v-p-fmt-15-str-key    as integer      no-undo.
     3730   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     3731                                     iInput AS INTEGER).
     3732     def var v-start-print as integer no-undo .
     3733     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     3734     assign
     3735       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     3736     .
     3737     RETURN v-start-print .
     3738   END FUNCTION.
     3739   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     3740                                     iInput AS INTEGER).
     3741     def var v-start-print as integer no-undo .
     3742     assign
     3743       v-start-print = INTEGER(iEndPix - 1 - iInput)
     3744     .
     3745     if v-start-print < 0 then return 0.
     3746     RETURN v-start-print .
     3747   END FUNCTION.
     3748   function p-fmt-align-string returns character (
     3749         p-in-string      as character
     3750       , p-page-width     as integer
     3751       , p-align-type     as character
     3752   ).
     3753       define variable v-string-length     as integer      no-undo.
     3754       define variable v-out-string        as character    no-undo.
     3755       assign
     3756           v-string-length = length( trim( p-in-string ) )
     3757       .
     3758       if v-string-length >= p-page-width
     3759       then do:
     3760           assign
     3761               v-out-string = trim( p-in-string )
     3762           .
     3763       end.
     3764       else do:
     3765           case p-align-type
     3766           :
     3767               when 'left':U
     3768               then do:
     3769                   assign
     3770                       v-out-string = trim( p-in-string )
     3771                   .
     3772               end.
     3773               when 'right':U
     3774               then do:
     3775                   assign
     3776                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     3777                   .
     3778               end.
     3779               when 'center':U
     3780               then do:
     3781                   assign
     3782                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     3783                   .
     3784               end.
     3785           end case.
     3786       end.
     3787       return v-out-string .
     3788   end function.
     3789   procedure p-fmt-split-string :
     3790   define input parameter p-source-string  as character        no-undo.
     3791   define input parameter p-split-length   as integer          no-undo.
     3792   define output parameter p-string-1      as character        no-undo.
     3793   define output parameter p-string-2      as character        no-undo.
     3794   do
     3795   on error undo, return error
     3796   :
     3797       define variable v-space-pos    as integer      no-undo.
     3798       if length( p-source-string ) <= p-split-length
     3799       then do:
     3800           assign
     3801               p-string-1 = p-source-string
     3802           .
     3803       end.
     3804       else do:
     3805           assign
     3806               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     3807           .
     3808           if v-space-pos = 0
     3809           then do:
     3810               assign
     3811                   v-space-pos = index( p-source-string, " ":U )
     3812               .
     3813           end.
     3814           if v-space-pos = 0
     3815           then do:
     3816               assign
     3817                   p-string-1 = substring( p-source-string, 1, p-split-length )
     3818                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     3819               .
     3820           end.
     3821           else do:
     3822               assign
     3823                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     3824                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     3825               .
     3826           end.
     3827       end.
     3828   end.
     3829   end procedure.
     3830   procedure p-fmt-round :
     3831   define input parameter p-qnty               as decimal          no-undo.
     3832   define input parameter p-price-no-VAT       as decimal          no-undo.
     3833   define input parameter p-VAT                as decimal          no-undo.
     3834   define input parameter p-SLT                as decimal          no-undo.
     3835   define input parameter p-road-tax           as decimal          no-undo.
     3836   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     3837   define output parameter p-new-VAT           as decimal          no-undo.
     3838   define output parameter p-new-SLT           as decimal          no-undo.
     3839   define output parameter p-new-sum-VAT       as decimal          no-undo.
     3840   define output parameter p-new-sum-SLT       as decimal          no-undo.
     3841   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     3842   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     3843   define output parameter p-new-sum-full      as decimal          no-undo.
     3844       define variable v-vat-pc    as decimal      no-undo.
     3845       define variable v-slt-pc    as decimal      no-undo.
     3846   do
     3847   on error undo, return error
     3848   :
     3849       if p-price-no-VAT = 0
     3850       then do:
     3851           assign
     3852               p-new-price-no-VAT = 0.0
     3853               p-new-VAT          = ?
     3854               p-new-SLT          = ?
     3855               p-new-sum-VAT      = 0.0
     3856               p-new-sum-SLT      = 0.0
     3857               p-new-sum-no-VAT   = 0.0
     3858               p-new-sum-road-tax = 0.0
     3859               p-new-sum-full     = 0.0
     3860           .
     3861       end.
     3862       else do:
     3863           assign
     3864               v-vat-pc            = p-VAT / p-price-no-VAT
     3865               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     3866               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     3867               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     3868               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     3869               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     3870               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     3871               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     3872               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     3873               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     3874           .
     3875       end.
     3876   end.
     3877   end procedure.
     3878   procedure p-fmt-split :
     3879   define input parameter p-in-string      as character        no-undo.
     3880   define input parameter p-split-length   as integer          no-undo.
     3881       define variable v-start-pos     as integer      no-undo.
     3882       define variable v-end-pos       as integer      no-undo.
     3883       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     3884   do
     3885   for buf_temp_p-fmt_string-part
     3886   on error undo, return error
     3887   :
     3888       empty temp-table buf_temp_p-fmt_string-part.
     3889       if p-split-length < 1
     3890       then do:
     3891           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     3892       end.
     3893       assign
     3894           p-in-string                 = trim( p-in-string )
     3895           v-p-fmt-15-str-key   = 0
     3896           v-start-pos                 = 1
     3897           v-end-pos                   = length( p-in-string )
     3898       .
     3899       run p-fmt-get-string-range in this-procedure (
     3900             input p-in-string
     3901           , input p-split-length
     3902           , input v-start-pos
     3903           , output v-start-pos
     3904           , output v-end-pos
     3905       ).
     3906       do while v-end-pos <> 0
     3907       :
     3908           create buf_temp_p-fmt_string-part.
     3909           assign
     3910               v-p-fmt-15-str-key = v-p-fmt-15-str-key + 1
     3911           .
     3912           assign
     3913               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-15-str-key
     3914               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     3915           .
     3916           assign
     3917               v-start-pos = v-end-pos + 1
     3918           .
     3919           run p-fmt-get-string-range in this-procedure (
     3920                 input p-in-string
     3921               , input p-split-length
     3922               , input v-start-pos
     3923               , output v-start-pos
     3924               , output v-end-pos
     3925           ).
     3926       end.
     3927   end.
     3928   end procedure.
     3929   procedure p-fmt-get-string-range :
     3930   define input parameter p-in-string      as character        no-undo.
     3931   define input parameter p-split-length   as integer          no-undo.
     3932   define input parameter p-old-start-pos  as integer          no-undo.
     3933   define output parameter p-start-pos     as integer          no-undo.
     3934   define output parameter p-end-pos       as integer          no-undo.
     3935       define variable v-init-string    as character    no-undo.
     3936       define variable v-temp-char      as character    no-undo.
     3937       define variable v-temp-pos       as integer      no-undo.
     3938       define variable v-counter        as integer      no-undo.
     3939   do
     3940   on error undo, return error
     3941   :
     3942       assign
     3943           p-start-pos   = p-old-start-pos
     3944           v-init-string = substring( p-in-string, p-start-pos )
     3945       no-error.
     3946       if error-status :error
     3947       or trim( v-init-string ) = "":U
     3948       then do:
     3949           assign
     3950               p-end-pos = 0
     3951           .
     3952           undo, return .
     3953       end.
     3954       assign
     3955           v-temp-char   = substring( v-init-string, 1, 1 )
     3956       .
     3957       do
     3958       while trim( v-temp-char ) = "":U
     3959       :
     3960           assign
     3961               p-start-pos     = p-start-pos + 1
     3962               v-init-string   = substring( p-in-string, p-start-pos )
     3963               v-temp-char     = substring( v-init-string, 1, 1 )
     3964           .
     3965       end.
     3966       assign
     3967           v-temp-pos  = p-split-length
     3968           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     3969           v-counter   = 0
     3970       .
     3971       search-word-end:
     3972       do
     3973       while trim( v-temp-char ) <> "":U
     3974       :
     3975           assign
     3976               v-counter   = v-counter + 1
     3977           .
     3978           if v-counter > 20
     3979           then do:
     3980               assign
     3981                   v-temp-pos  = p-split-length
     3982               .
     3983               leave search-word-end.
     3984           end.
     3985           assign
     3986               v-temp-pos  = v-temp-pos - 1
     3987               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     3988           .
     3989       end.
     3990       assign
     3991           p-end-pos = p-start-pos + v-temp-pos - 1
     3992       .
     3993   end.
     3994   end procedure.
     3995   define variable vss-include-info16 as character format "X(65)" no-undo
     3996   initial "@(#)$Workfile$ $Revision$".
     3997   define temp-table temp_wthgds_price-group no-undo
     3998       field gds-code      as integer
     3999       field price-rubl    as decimal
     4000       field vat-pc        as decimal
     4001       field sum-rubl      as decimal
     4002       field sum-base      as decimal
     4003       field sum-vat-rubl  as decimal
     4004       field sum-vat-base  as decimal
     4005       field price-base    as decimal
     4006       field qnty          as decimal
     4007       field fact-qnty     as decimal
     4008       index pi is primary unique
     4009           gds-code
     4010           price-rubl
     4011           vat-pc
     4012   .
     4013   define temp-table temp_wthgds_price-goods   no-undo
     4014       field gds-code      as integer
     4015       field sum-rubl      as decimal
     4016       field sum-base      as decimal
     4017       field sum-vat-rubl  as decimal
     4018       field sum-vat-base  as decimal
     4019       field vat-pc        as decimal
     4020       field qnty          as decimal
     4021       field fact-qnty     as decimal
     4022       field price-rubl    as decimal
     4023       field price-base    as decimal
     4024       index pi is primary unique
     4025           gds-code
     4026   .
     4027   procedure wthgds-calc-price-group:
     4028   define input parameter p-doc-code as character no-undo.
     4029       define variable v-gds-qnty          as decimal      no-undo.
     4030       define variable v-gds-price-rubl    as decimal      no-undo.
     4031       define buffer buf_wth-parts                 for ub.wth-parts.
     4032       define buffer buf_wth-par                   for ub.wth-par.
     4033       define buffer buf_temp_wthgds_price-group   for temp_wthgds_price-group.
     4034   do
     4035   for buf_wth-parts
     4036     , buf_wth-par
     4037     , buf_temp_wthgds_price-group
     4038   on error undo, return error
     4039   :
     4040       empty temp-table temp_wthgds_price-group.
     4041       for each buf_wth-parts no-lock
     4042          where buf_wth-parts.out-code = p-doc-code
     4043       :
     4044           find first buf_wth-par no-lock
     4045                where buf_wth-par.wth-code = buf_wth-parts.wth-code
     4046                  and buf_wth-par.par-code = buf_wth-parts.par-code
     4047           .
     4048           assign
     4049               v-gds-qnty          = buf_wth-par.par-val * buf_wth-parts.fact-qnty
     4050               v-gds-price-rubl    = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty, 2 )
     4051           .
     4052           find first buf_temp_wthgds_price-group no-lock
     4053                where buf_temp_wthgds_price-group.gds-code     = buf_wth-parts.gds-code
     4054                  and buf_temp_wthgds_price-group.price-rubl   = v-gds-price-rubl
     4055                  and buf_temp_wthgds_price-group.vat-pc       = buf_wth-parts.vat-pc
     4056           no-error.
     4057           if not available buf_temp_wthgds_price-group
     4058           then do:
     4059               create buf_temp_wthgds_price-group.
     4060               assign
     4061                   buf_temp_wthgds_price-group.gds-code        = buf_wth-parts.gds-code
     4062                   buf_temp_wthgds_price-group.price-rubl      = v-gds-price-rubl
     4063                   buf_temp_wthgds_price-group.vat-pc          = buf_wth-parts.vat-pc
     4064                   buf_temp_wthgds_price-group.price-base      = round( ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty, 2 )
     4065                   buf_temp_wthgds_price-group.qnty            = 0.0
     4066                   buf_temp_wthgds_price-group.fact-qnty       = 0.0
     4067                   buf_temp_wthgds_price-group.sum-rubl        = 0.0
     4068                   buf_temp_wthgds_price-group.sum-base        = 0.0
     4069                   buf_temp_wthgds_price-group.sum-vat-rubl    = 0.0
     4070                   buf_temp_wthgds_price-group.sum-vat-base    = 0.0
     4071               .
     4072           end.
     4073           assign
     4074               buf_temp_wthgds_price-group.qnty            = buf_temp_wthgds_price-group.qnty          + v-gds-qnty
     4075               buf_temp_wthgds_price-group.fact-qnty       = buf_temp_wthgds_price-group.fact-qnty     + buf_wth-parts.fact-qnty
     4076               buf_temp_wthgds_price-group.sum-rubl        = buf_temp_wthgds_price-group.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
     4077               buf_temp_wthgds_price-group.sum-base        = buf_temp_wthgds_price-group.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
     4078               buf_temp_wthgds_price-group.sum-vat-rubl    = buf_temp_wthgds_price-group.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
     4079               buf_temp_wthgds_price-group.sum-vat-base    = buf_temp_wthgds_price-group.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
     4080           .
     4081       end.
     4082   end.
     4083   end procedure.
     4084   procedure wthgds-calc-price-goods:
     4085   define input parameter p-doc-code as character no-undo.
     4086       define variable v-gds-qnty          as decimal      no-undo.
     4087       define buffer buf_wth-parts                 for ub.wth-parts.
     4088       define buffer buf_wth-par                   for ub.wth-par.
     4089       define buffer buf_temp_wthgds_price-goods   for temp_wthgds_price-goods.
     4090   do
     4091   for buf_wth-parts
     4092     , buf_wth-par
     4093     , buf_temp_wthgds_price-goods
     4094   on error undo, return error
     4095   :
     4096       empty temp-table buf_temp_wthgds_price-goods.
     4097       for each buf_wth-parts no-lock
     4098          where buf_wth-parts.out-code = p-doc-code
     4099       :
     4100           find first buf_wth-par no-lock
     4101                where buf_wth-par.wth-code = buf_wth-parts.wth-code
     4102                  and buf_wth-par.par-code = buf_wth-parts.par-code
     4103           .
     4104           find first buf_temp_wthgds_price-goods no-lock
     4105                where buf_temp_wthgds_price-goods.gds-code     = buf_wth-parts.gds-code
     4106           no-error.
     4107           if not available buf_temp_wthgds_price-goods
     4108           then do:
     4109               create buf_temp_wthgds_price-goods.
     4110               assign
     4111                   buf_temp_wthgds_price-goods.gds-code        = buf_wth-parts.gds-code
     4112                   buf_temp_wthgds_price-goods.qnty            = 0.0
     4113                   buf_temp_wthgds_price-goods.fact-qnty       = 0.0
     4114                   buf_temp_wthgds_price-goods.sum-rubl        = 0.0
     4115                   buf_temp_wthgds_price-goods.sum-base        = 0.0
     4116                   buf_temp_wthgds_price-goods.sum-vat-rubl    = 0.0
     4117                   buf_temp_wthgds_price-goods.sum-vat-base    = 0.0
     4118               .
     4119           end.
     4120           assign
     4121               v-gds-qnty                                  = buf_wth-par.par-val * buf_wth-parts.fact-qnty
     4122               buf_temp_wthgds_price-goods.qnty            = buf_temp_wthgds_price-goods.qnty          + v-gds-qnty
     4123               buf_temp_wthgds_price-goods.fact-qnty       = buf_temp_wthgds_price-goods.fact-qnty     + buf_wth-parts.fact-qnty
     4124               buf_temp_wthgds_price-goods.sum-rubl        = buf_temp_wthgds_price-goods.sum-rubl      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl )
     4125               buf_temp_wthgds_price-goods.sum-base        = buf_temp_wthgds_price-goods.sum-base      + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base )
     4126               buf_temp_wthgds_price-goods.sum-vat-rubl    = buf_temp_wthgds_price-goods.sum-vat-rubl  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl * buf_wth-parts.vat-pc / 100.0 )
     4127               buf_temp_wthgds_price-goods.sum-vat-base    = buf_temp_wthgds_price-goods.sum-vat-base  + ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base * buf_wth-parts.vat-pc / 100.0 )
     4128               buf_temp_wthgds_price-goods.vat-pc          = buf_wth-parts.vat-pc
     4129               buf_temp_wthgds_price-goods.price-rubl      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-rubl ) / v-gds-qnty
     4130               buf_temp_wthgds_price-goods.price-base      = ( buf_wth-parts.fact-qnty * buf_wth-parts.price-base ) / v-gds-qnty
     4131           .
     4132       end.
     4133   end.
     4134   end procedure.
     4135   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4136   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     4137   procedure paramls-clear :
     4138     define buffer buf_temp-param for temp-param .
     4139     do
     4140     on error undo, return error return-value
     4141     :
     4142       for each buf_temp-param
     4143       on error undo, return error
     4144       :
     4145         delete buf_temp-param .
     4146       end.
     4147     end.
     4148   end procedure.
     4149   procedure paramls-write :
     4150     define input  parameter p-code     as character no-undo .
     4151     define input  parameter p-sub-code as character no-undo .
     4152     define input  parameter p-value    as character no-undo .
     4153     define buffer buf_temp-param for temp-param .
     4154     do
     4155     on error undo, return error return-value
     4156     :
     4157       find first buf_temp-param
     4158         where buf_temp-param.param-code     = p-code
     4159           and buf_temp-param.param-sub-code = p-sub-code
     4160         no-error .
     4161       if not available buf_temp-param then do:
     4162         create buf_temp-param .
     4163         assign
     4164           buf_temp-param.param-code     = p-code
     4165           buf_temp-param.param-sub-code = p-sub-code
     4166         .
     4167       end.
     4168       assign
     4169         buf_temp-param.param-value = p-value
     4170       .
     4171     end.
     4172   end procedure.
     4173   procedure paramls-read :
     4174     define input  parameter p-code          as character no-undo .
     4175     define input  parameter p-sub-code      as character no-undo .
     4176     define input  parameter p-default-value as character no-undo .
     4177     define output parameter p-value         as character no-undo .
     4178     define buffer buf_temp-param for temp-param .
     4179     do
     4180     on error undo, return error return-value
     4181     :
     4182       find first buf_temp-param
     4183         where buf_temp-param.param-code     = p-code
     4184           and buf_temp-param.param-sub-code = p-sub-code
     4185         no-error .
     4186       if available buf_temp-param then do:
     4187         assign
     4188           p-value = buf_temp-param.param-value
     4189         .
     4190       end.
     4191       else do:
     4192         assign
     4193           p-value = p-default-value
     4194         .
     4195       end.
     4196     end.
     4197   end procedure.
     4198   procedure paramls-append :
     4199     define input  parameter p-code     as character no-undo .
     4200     define input  parameter p-sub-code as character no-undo .
     4201     define input  parameter p-value    as character no-undo .
     4202     define buffer buf_temp-param for temp-param .
     4203     do
     4204     on error undo, return error return-value
     4205     :
     4206       find first buf_temp-param
     4207            where buf_temp-param.param-code     = p-code
     4208              and buf_temp-param.param-sub-code = p-sub-code
     4209         no-error .
     4210       if not available buf_temp-param then do:
     4211         create buf_temp-param .
     4212         assign
     4213           buf_temp-param.param-code     = p-code
     4214           buf_temp-param.param-sub-code = p-sub-code
     4215           buf_temp-param.param-value    = p-value
     4216         .
     4217       end.
     4218       else do:
     4219           assign
     4220               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4221           .
     4222       end.
     4223     end.
     4224   end procedure.
     4225   define variable vss-include-info18 as character format "X(65)" no-undo
     4226   initial "@(#)$Workfile$ $Revision$".
     4227   define stream excel-line.
     4228   define stream excel-cell.
     4229   define temp-table temp_cell-data no-undo
     4230       field data-key as character
     4231       field data-value as character
     4232       index pi is primary unique data-key
     4233   .
     4234   define temp-table temp_line-data no-undo
     4235       field data-key     as character
     4236       field xl-line-id   as integer
     4237       field ID           as integer
     4238       field Name         as character
     4239       field gdscode      as character
     4240       field EI           as character
     4241       field OKEI         as character
     4242       field pack         as character
     4243       field AmountInPl   as character
     4244       field PlaceAmount  as character
     4245       field Mass         as character
     4246       field qnty         as character
     4247       field price        as character
     4248       field SumNoVAT     as character
     4249       field VATpc        as character
     4250       field VATsum       as character
     4251       field sum          as character
     4252       field cntrycode    as character
     4253       field cntryorg     as character
     4254       field numgtd       as character
     4255       index pi is primary unique xl-line-id
     4256   .
     4257   define variable v-torg12xl-current-data-row     as integer      no-undo.
     4258   define variable v-torg12xl-cell-file-name       as character    no-undo.
     4259   define variable v-torg12xl-data-file-name       as character    no-undo.
     4260   procedure torg12xl-init :
     4261       define buffer buf_temp_cell-data        for temp_cell-data.
     4262       define buffer buf_usr-flt               for ubflt.usr-flt.
     4263   do
     4264   for buf_temp_cell-data
     4265     , buf_usr-flt
     4266   on error undo, return error
     4267   :
     4268       assign
     4269           v-torg12xl-current-data-row = 0
     4270       .
     4271       run gbl/_tmpfile.p (
     4272             input "xd"
     4273           , input ".txt"
     4274           , output v-torg12xl-data-file-name
     4275       ).
     4276       output stream excel-line to value( v-torg12xl-data-file-name ).
     4277       run gbl/_tmpfile.p (
     4278             input "xc"
     4279           , input ".txt"
     4280           , output v-torg12xl-cell-file-name
     4281       ).
     4282       output stream excel-cell to value( v-torg12xl-cell-file-name ).
     4283       if printrubl
     4284       then do:
     4285           run torg12xl-write-cell-data in this-procedure (
     4286                 input "valutCode":U
     4287               , input "0":U
     4288           ).
     4289       end.
     4290       else do:
     4291           run torg12xl-write-cell-data in this-procedure (
     4292                 input "valutCode":U
     4293               , input "1":U
     4294           ).
     4295       end.
     4296       if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     4297       then do:
     4298         run torg12xl-write-cell-data in this-procedure (
     4299               input "columnList":U
     4300             , input "ID,Name,gdscode,EI,OKEI,pack,AmountInPl,PlaceAmount,Mass,qnty,price,SumNoVAT,VATpc,VATsum,sum,cntrycode,cntryorg,numgtd":U
     4301         ).
     4302         run torg12xl-write-cell-data in this-procedure (
     4303               input "columnType":U
     4304             , input "I,S,I,S,S,S,D,D,D,D,C,C,D,C,C,S,S,S":U
     4305         ).
     4306         run torg12xl-write-cell-data in this-procedure (
     4307               input "columnAmount":U
     4308             , input "18":U
     4309         ).
     4310       end.
     4311       else do:
     4312         run torg12xl-write-cell-data in this-procedure (
     4313               input "columnList":U
     4314             , input "ID,Name,gdscode,EI,OKEI,pack,AmountInPl,PlaceAmount,Mass,qnty,price,SumNoVAT,VATpc,VATsum,sum":U
     4315         ).
     4316         run torg12xl-write-cell-data in this-procedure (
     4317               input "columnType":U
     4318             , input "I,S,I,S,S,S,S,S,S,D,C,C,D,C,C":U
     4319         ).
     4320         run torg12xl-write-cell-data in this-procedure (
     4321               input "columnAmount":U
     4322             , input "15":U
     4323         ).
     4324       end.
     4325       run torg12xl-write-cell-data in this-procedure (
     4326             input "subtotalList":U
     4327           , input "qnty,SumNoVAT,VATsum,sum":U
     4328       ).
     4329       run torg12xl-write-cell-data in this-procedure (
     4330             input "subtotalType":U
     4331           , input "S,S,S,S":U
     4332       ).
     4333       run torg12xl-write-cell-data in this-procedure (
     4334             input "subtotalAmount":U
     4335           , input "4":U
     4336       ).
     4337   end.
     4338   end procedure.
     4339   procedure torg12xl-close :
     4340   define input parameter p-mode               as character        no-undo.
     4341   do
     4342   on error undo, return error
     4343   :
     4344       output stream excel-line close.
     4345       output stream excel-cell close.
     4346       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4347           if lookup( "KEDR":U , p-mode ) <> 0 then do:
     4348             export "exe/t12_97Kedr.xlt":U.
     4349           end.
     4350           else do:
     4351             if lookup( "TOPAUKC":U, p-mode ) <> 0
     4352             then do:
     4353               if lookup( "GTD":U, p-mode ) <> 0
     4354               then do:
     4355                 export "exe/t12_97bb.xlt":U.
     4356               end.
     4357               else do:
     4358                 export "exe/t12_97b.xlt":U.
     4359               end.
     4360             end.
     4361             else do:
     4362               export "exe/t12_97.xlt":U.
     4363             end.
     4364           end.
     4365           export "exe/t_97.bas":U.
     4366           export v-torg12xl-cell-file-name.
     4367           export v-torg12xl-data-file-name.
     4368       output close.
     4369   end.
     4370   end procedure.
     4371   procedure torg12xl-write-cell-data :
     4372   define input parameter p-data-key   as character        no-undo.
     4373   define input parameter p-data-value as character        no-undo.
     4374       define buffer buf_temp_cell-data     for temp_cell-data.
     4375   do
     4376   for buf_temp_cell-data
     4377   on error undo, return error
     4378   :
     4379       find first buf_temp_cell-data
     4380            where buf_temp_cell-data.data-key = p-data-key
     4381       no-error.
     4382       if not available buf_temp_cell-data
     4383       then do:
     4384           create buf_temp_cell-data.
     4385           assign
     4386               buf_temp_cell-data.data-key = p-data-key
     4387           .
     4388       end.
     4389       assign
     4390           buf_temp_cell-data.data-value = p-data-value
     4391       .
     4392       put stream excel-cell unformatted
     4393                           buf_temp_cell-data.data-key
     4394           chr(9)   buf_temp_cell-data.data-value
     4395           chr(10)
     4396       .
     4397   end.
     4398   end procedure.
