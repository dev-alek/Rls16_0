     1237   procedure torgconf-get-self-param :
     1238   define input parameter p-obj-type           as character        no-undo.
     1239   define input parameter p-obj-code           as integer          no-undo.
     1240   define input parameter p-curr-code          as integer          no-undo.
     1241       define variable v-host-code    as integer      no-undo.
     1242       define variable v-par-type     as character    no-undo.
     1243   do
     1244   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1245   :
     1246   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1247   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1248     (input  p-obj-type
     1249     ,input  p-obj-code
     1250     ,output v-host-code
     1251     )  .
     1252       if v-torgconf-outhold = yes
     1253       then do:
     1254           run torgconf-get-holdfirm-code in this-procedure (
     1255                 input p-obj-type
     1256               , input p-obj-code
     1257               , output v-torgconf-self-host-code
     1258           ).
     1259           if v-torgconf-self-host-code = 0
     1260           then do:
     1261               return error.
     1262           end.
     1263       end.
     1264       else do:
     1265           assign
     1266               v-torgconf-self-host-code = v-host-code
     1267           .
     1268       end.
     1269       if v-torgconf-self-host-code = 0
     1270       then do:
     1271           assign
     1272               v-torgconf-self-host-name           = "":U
     1273               v-torgconf-self-host-addres         = "":U
     1274               v-torgconf-self-host-post-addres    = "":U
     1275               v-torgconf-self-host-phone          = "":U
     1276               v-torgconf-self-host-inn            = "":U
     1277               v-torgconf-self-host-kpp            = "":U
     1278               v-torgconf-self-host-okpo           = "":U
     1279               v-torgconf-self-host-egrip-date     = "":U
     1280               v-torgconf-self-host-egrip-num      = "":U
     1281           .
     1282       end.
     1283       else do:
     1284           run fmtcli-get-client in this-procedure (
     1285                 input 'орг':U
     1286               , input v-torgconf-self-host-code
     1287           ).
     1288           assign
     1289               v-torgconf-self-host-name        = v-fmtcli-name
     1290               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1291               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1292               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1293               v-torgconf-self-host-phone       = v-fmtcli-phone
     1294               v-torgconf-self-host-inn         = v-fmtcli-inn
     1295               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1296               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1297           .
     1298           run gbl/clntat-v.p (
     1299                 input 'орг':U
     1300               , input v-torgconf-self-host-code
     1301               , input 'egrip-date':U
     1302               , output v-torgconf-self-host-egrip-date
     1303               , output v-par-type
     1304           ).
     1305           run gbl/clntat-v.p (
     1306                 input 'орг':U
     1307               , input v-torgconf-self-host-code
     1308               , input 'egrip-num':U
     1309               , output v-torgconf-self-host-egrip-num
     1310               , output v-par-type
     1311           ).
     1312           run fmtcli-get-bank in this-procedure (
     1313                 input v-host-code
     1314               , input 'орг':U
     1315               , input v-torgconf-self-host-code
     1316               , input p-curr-code
     1317           ).
     1318       end.
     1319       assign
     1320           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1321           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1322           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1323           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1324           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1325           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1326           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1327           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1328       .
     1329       assign
     1330           v-torgconf-self-obj-type = p-obj-type
     1331           v-torgconf-self-obj-code = p-obj-code
     1332       .
     1333       run fmtcli-get-client in this-procedure (
     1334             input p-obj-type
     1335           , input p-obj-code
     1336       ).
     1337       assign
     1338           v-torgconf-self-obj-name       = v-fmtcli-name
     1339           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1340           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1341           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1342           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1343           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1344           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1345       .
     1346   end.
     1347   end procedure.
     1348   procedure torgconf-get-recepient-param :
     1349   define input parameter torgconfdoc-code   as character                  no-undo.
     1350   define output parameter v-code-rec        as integer                    no-undo .
     1351   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1352   define output parameter v-codefirm-rec    as integer                    no-undo .
     1353   define output parameter v-curcode-rec     as integer                    no-undo .
     1354        define variable  v-recipient-code  as character                  no-undo .
     1355        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1356        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1357   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1358                           input 'Recipient':U ,
     1359                          output v-recipient-code ,
     1360                          output v-trdcattr-type ) no-error .
     1361       if error-status :error then do:
     1362        message
     1363         vss-workfile vss-revision vss-description skip
     1364         "Ошибка при вызове процедуры tdat-val":U skip
     1365         "Документ: " torgconfdoc-code skip
     1366         "Атрибут: " 'Recipient':U skip
     1367         "Значение: " v-recipient skip
     1368         trim( error-status :get-message (1) ) skip
     1369         return-value skip
     1370         view-as alert-box error.
     1371       undo, return error return-value.
     1372       end.
     1373     assign
     1374       v-recipient  = v-recipient-code
     1375       v-type-rec = substring(v-recipient-code,1,3)
     1376       v-code-rec  = int(substring(v-recipient-code,4,15))
     1377       no-error
     1378     .
     1379     if v-type-rec = ? then v-type-rec = "" .
     1380     if v-code-rec  = ? then v-code-rec  =  0 .
     1381     end procedure.
     1382   procedure torgconf-get-wthrecepient-param :
     1383   define input parameter torgconfdoc-code   as character                  no-undo.
     1384   define output parameter v-code-rec        as integer                    no-undo .
     1385   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1386   define output parameter v-codefirm-rec    as integer                    no-undo .
     1387   define output parameter v-curcode-rec     as integer                    no-undo .
     1388        define variable  v-recipient-code  as character                  no-undo .
     1389        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1390        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1391   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input torgconfdoc-code ,
     1392                           input 'wthconsignee':U ,
     1393                          output v-recipient-code ,
     1394                          output v-trdcattr-type ) no-error .
     1395       if error-status :error then do:
     1396        message
     1397         vss-workfile vss-revision vss-description skip
     1398         "Ошибка при вызове процедуры tdat-val":U skip
     1399         "Документ: " torgconfdoc-code skip
     1400         "Атрибут: " 'wthconsignee':U skip
     1401         "Значение: " v-recipient skip
     1402         trim( error-status :get-message (1) ) skip
     1403         return-value skip
     1404         view-as alert-box error.
     1405       undo, return error return-value.
     1406       end.
     1407     assign
     1408       v-recipient  = v-recipient-code
     1409       v-type-rec = substring(v-recipient-code,1,3)
     1410       v-code-rec  = int(substring(v-recipient-code,4,15))
     1411       no-error
