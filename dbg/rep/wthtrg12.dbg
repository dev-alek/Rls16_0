     3684   define variable g#quest-print   as logical      no-undo.
     3685   define variable g#log           as logical      no-undo.
     3686   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3687     define variable v-cntxp-doc-prt         like ub.store.doc-prt         no-undo.
