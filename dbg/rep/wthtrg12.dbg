     1034           v-torgconf-outdisc  = no
     1035           v-torgconf-outsubs  = no
     1036           v-torgconf-outrecv  = no
     1037           v-torgconf-outegrp  = no
     1038           v-torgconf-outt12   = no
     1039           v-torgconf-outappr  = no
     1040           v-torgconf-outrubl  = no
     1041           v-torgconf-outhold  = no
