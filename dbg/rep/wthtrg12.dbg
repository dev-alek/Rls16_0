        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-doc-code           as character        no-undo.
        4   define input parameter Invers               as logical          no-undo.
        5   define input parameter p-mode               as character        no-undo.
        6   define input parameter p-round              as character        no-undo.
        7   define input parameter p-reverse              as character        no-undo.
        8   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        9   define variable vss-author      as character no-undo init "$Author: expertek $":U .
       10   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       11   define variable vss-workfile    as character no-undo init "$Workfile: wthtrg12.p $":U .
       12   define variable vss-archive     as character no-undo init "$Archive: rep/wthtrg12.p $":U .
       13   define variable vss-description as character no-undo init "Печатные формы. Торг-12 для внешнего прихода, расхода и возврата поставщику".
       14   procedure vss-get-info :
       15     define output parameter p-vss-revision    like vss-revision    no-undo .
       16     define output parameter p-vss-author      like vss-author      no-undo .
       17     define output parameter p-vss-date        like vss-date        no-undo .
       18     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       19     define output parameter p-vss-archive     like vss-archive     no-undo .
       20     define output parameter p-vss-description like vss-description no-undo .
       21     assign
       22       p-vss-revision    = vss-revision
       23       p-vss-author      = vss-author
       24       p-vss-date        = vss-date
       25       p-vss-workfile    = vss-workfile
       26       p-vss-archive     = vss-archive
       27       p-vss-description = vss-description
       28     .
       29   end procedure.
       30   procedure vss-get-parameters :
       31     define output parameter p-vss-parameters as character no-undo .
       32   end procedure.
       33   define new global shared variable g#vssrevis-logger as handle    no-undo .
       34   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       35   define variable v-vssrevis-logger                   as handle    no-undo .
       36   procedure vss-logevent :
       37     define input  parameter p-extra-paramters as character no-undo .
       38     define variable v-vssrevis-parameters as character no-undo .
       39     do
       40     on error undo, return error return-value
       41     :
       42       if  valid-handle(v-vssrevis-logger)
       43       and v-vssrevis-logger :get-signature("logevent") <> ""
       44       then do:
       45         run vss-get-parameters in this-procedure
       46           (output v-vssrevis-parameters
       47           ).
       48         run logevent in v-vssrevis-logger
       49           (input vss-workfile
       50           ,input vss-revision
       51           ,input v-vssrevis-parameters
       52           ,input p-extra-paramters
       53           ).
       54       end.
       55     end.
       56   end procedure.
       57   assign
       58     v-vssrevis-logger = g#vssrevis-logger
       59   .
       60   if  valid-handle(v-vssrevis-logger)
       61   and v-vssrevis-logger :get-signature("logevent") <> ""
       62   then do:
       63     assign
       64       v-vssrevis-logevent = true
       65     .
       66     run vss-logevent in this-procedure (input vss-description) .
       67   end.
       68   define new global shared variable g#language as character no-undo .
       69   if g#language <> '' and g#language <> 'rus':U then do:
       70     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       71   end.
       72   define new global shared variable g#library  as handle no-undo .
       73   define new global shared variable g#library2 as handle no-undo .
       74   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       75   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       76   define  shared variable RepPathName        as character no-undo .
       77   define  shared variable PrintRubl          as logical   no-undo .
       78   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       79   function breakstr returns character ( input        for-name    as character,
       80                                         input        line-length as integer,
       81                                         input-output line1       as character,
       82                                         input-output line2       as character ) :
       83     define variable ii as integer no-undo.
       84     if length( for-name ) > line-length then do:
       85       assign ii    = 1
       86              line1 = "":u
       87              line2 = "":u.
       88       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       89         assign line1 =       substring( for-name, 1, line-length     )
       90                line2 = trim( substring( for-name,    line-length + 1 ) ).
       91       end.                                                     else do:
       92         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       93           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       94                  ii    = ii    + 1.
       95           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       96             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       97           end.
       98         end.
       99         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      100       end.
      101     end.                                else do:
      102       assign line1 = for-name
      103              line2 = "":u.
      104     end.
      105     return ( line1 ).
      106   end function.
      107   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      108   procedure cur-time :
      109      define output parameter p-today as date      no-undo .
      110      define output parameter p-time  as integer   no-undo .
      111     do
      112     on error undo, return error
      113     :
      114       define variable v-date1 as date      no-undo .
      115       define variable v-date2 as date      no-undo .
      116       define variable v-time  as integer   no-undo .
      117       assign
      118         v-date1 = today
      119         v-time  = time
      120         v-date2 = today
      121       .
      122       if v-date1 <> v-date2
      123       then do:
      124         assign
      125           v-date1 = today
      126           v-time  = v-time
      127         .
      128       end.
      129       assign
      130         p-today = v-date1
      131         p-time  = v-time
      132       .
      133     end.
      134   end.
      135   function cur-time-date returns character
      136   :
      137     return string(today, '99/99/9999':U) .
      138   end.
      139   function cur-time-mjd returns decimal
      140   :
      141     define variable v-date as date      no-undo .
      142     define variable v-time as integer   no-undo .
      143     run cur-time in this-procedure
      144       (output v-date
      145       ,output v-time
      146       ) .
      147     return integer(v-date) - 2400002 + (v-time / 86400) .
      148   end.
      149   function cur-time-get-ending-index returns integer
      150   (input p-number as integer
      151   )
      152   :
      153     if p-number < 0
      154     or p-number = ?
      155     then do:
      156       return 1 .
      157     end.
      158     define variable v-rest as integer   no-undo .
      159     assign
      160       p-number = p-number modulo 100
      161     .
      162     if p-number < 20
      163     then do:
      164       assign
      165         v-rest = p-number
      166       .
      167     end.
      168     else do:
      169       assign
      170         v-rest = p-number modulo 10
      171       .
      172     end.
      173     case v-rest :
      174       when 1
      175       then do:
      176         return 2 .
      177       end.
      178       when 2 or
      179       when 3 or
      180       when 4
      181       then do:
      182         return 3 .
      183       end.
      184       otherwise do:
      185         return 1 .
      186       end.
      187     end case .
      188   end.
      189   procedure cur-time-mjd-to-date :
      190      define input  parameter i-mjd-diff as decimal no-undo.
      191      define output parameter o-Date     as date    no-undo.
      192      define output parameter o-Time     as integer no-undo.
      193      define variable v-day-number as integer   no-undo .
      194      if    i-mjd-diff < 0
      195         or i-mjd-diff = ?
      196      then do:
      197         return "?" .
      198      end.
      199      assign
      200         v-day-number = truncate(i-mjd-diff,0).
      201         o-Date = date(v-day-number + 2400002).
      202         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      203     .
      204   end.
      205   function cur-time-mjd-to-string returns character
      206   (input p-mjd-diff as decimal
      207   )
      208   :
      209     define variable v-day-number as integer   no-undo .
      210     define variable v-seconds    as integer   no-undo .
      211     define variable v-hour       as integer   no-undo .
      212     define variable v-min        as integer   no-undo .
      213     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      214     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      215     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      216     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      217     if p-mjd-diff < 0
      218     or p-mjd-diff = ?
      219     then do:
      220       return "?" .
      221     end.
      222     assign
      223       v-day-number = integer(truncate(p-mjd-diff,0))
      224       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      225     .
      226     if v-seconds > 86400
      227     then do:
      228       assign
      229         v-seconds = 86400 - 1
      230       .
      231     end.
      232     if v-seconds < 0
      233     then do:
      234       assign
      235         v-seconds = 0
      236       .
      237     end.
      238     assign
      239       v-hour = truncate(v-seconds / 3600, 0)
      240     .
      241     assign
      242       v-seconds = v-seconds modulo 3600
      243     .
      244     assign
      245       v-min = truncate(v-seconds / 60, 0)
      246     .
      247     assign
      248       v-seconds = v-seconds modulo 60
      249     .
      250     return
      251         (if v-day-number <> 0
      252           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      253           else ""
      254         )
      255       + (if v-day-number <> 0 or v-hour <> 0
      256           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      257           else ""
      258         )
      259       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      260           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      261           else ""
      262         )
      263       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      264       .
      265   end.
      266   function cur-time-string returns character
      267   :
      268     define variable v-date as date      no-undo .
      269     define variable v-time as integer   no-undo .
      270     run cur-time in this-procedure
      271       (output v-date
      272       ,output v-time
      273       ) .
      274     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      275   end.
      276   function cur-time-string-sec returns character
      277   :
      278     define variable v-date as date      no-undo .
      279     define variable v-time as integer   no-undo .
      280     run cur-time in this-procedure
      281       (output v-date
      282       ,output v-time
      283       ) .
      284     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      285   end.
      286   function cur-time-custom  returns character
      287   (input p-prefix as character
      288   ,input p-date-format as character
      289   ,input p-delimiter as character
      290   ,input p-time-format as character
      291   ,input p-suffix as character
      292   )
      293   :
      294     define variable v-date as date      no-undo .
      295     define variable v-time as integer   no-undo .
      296     run cur-time in this-procedure
      297       (output v-date
      298       ,output v-time
      299       ) .
      300     return
      301       p-prefix
      302       + string(v-date, p-date-format)
      303       + p-delimiter
      304       + string(v-time, p-time-format)
      305       + p-suffix
      306       .
      307   end.
      308   function cur-time-print  returns character
      309   :
      310     define variable v-date as date      no-undo .
      311     define variable v-time as integer   no-undo .
      312     run cur-time in this-procedure
      313       (output v-date
      314       ,output v-time
      315       ) .
      316     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      317   end.
      318   function cur-time-datetime returns datetime
      319   :
      320     define variable v-char as character no-undo .
      321     define variable v-datetime as datetime no-undo .
      322     v-char = cur-time-string().
      323     v-datetime = datetime(v-char).
      324     return  v-datetime.
      325   end.
      326   function cur-time-string-msec returns character
      327   :
      328     define variable v-date as datetime  no-undo .
      329     v-date = now.
      330     return string(v-date) .
      331   end.
      332   define variable vss-include-info3 as character format "X(65)" no-undo
      333   initial "@(#)$Workfile$ $Revision$".
      334   define variable v-fmtcli-name          as character    no-undo.
      335   define variable v-fmtcli-engl-name     as character    no-undo.
      336   define variable v-fmtcli-addres        as character    no-undo.
      337   define variable v-fmtcli-post-addres   as character    no-undo.
      338   define variable v-fmtcli-full-addres   as character    no-undo.
      339   define variable v-fmtcli-phone         as character    no-undo.
      340   define variable v-fmtcli-inn           as character    no-undo.
      341   define variable v-fmtcli-kpp           as character    no-undo.
      342   define variable v-fmtcli-okpo          as character    no-undo.
      343   define variable v-fmtcli-country       as character    no-undo.
      344   define variable v-fmtcli-city          as character    no-undo.
      345   define variable v-fmtcli-index         as character    no-undo.
      346   define variable v-fmtcli-schet-exists  as logical      no-undo.
      347   define variable v-fmtcli-bank-exists   as logical      no-undo.
      348   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      349   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      350   define variable v-fmtcli-bank-bik      as character    no-undo.
      351   define variable v-fmtcli-bank-name     as character    no-undo.
      352   define variable v-fmtcli-bank-addres   as character    no-undo.
      353   define variable v-fmtcli-bank-city     as character    no-undo.
      354   procedure fmtcli-get-bank :
      355   define input parameter p-host-code      as integer          no-undo.
      356   define input parameter p-obj-type       as character        no-undo.
      357   define input parameter p-obj-code       as integer          no-undo.
      358   define input parameter p-curr-code      as integer          no-undo.
      359       define buffer buf_fin-schet     for ub.fin-schet.
      360       define buffer buf_fin-bank      for ub.fin-bank.
      361   do
      362   for buf_fin-schet
      363     , buf_fin-bank
      364   on error undo, return error
      365   :
      366       assign
      367           v-fmtcli-schet-exists       = no
      368           v-fmtcli-bank-exists        = no
      369           v-fmtcli-bank-r-schet       = "":U
      370           v-fmtcli-bank-c-schet       = "":U
      371           v-fmtcli-bank-bik           = "":U
      372           v-fmtcli-bank-name          = "":U
      373           v-fmtcli-bank-addres        = "":U
      374           v-fmtcli-bank-city          = "":U
      375       .
      376       search-for-schet:
      377       for each buf_fin-schet no-lock
      378          where buf_fin-schet.host-code = p-host-code
      379            and buf_fin-schet.cli-type  = p-obj-type
      380            and buf_fin-schet.cli-code  = p-obj-code
      381            and buf_fin-schet.curr-code = p-curr-code
      382       on error undo, return error
      383       :
      384           if buf_fin-schet.status_   = 'удал':U
      385           then do:
      386           end.
      387           else do:
      388               assign
      389                   v-fmtcli-schet-exists   = yes
      390                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      391                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      392               .
      393               find first buf_fin-bank no-lock
      394                    where buf_fin-bank.host-code = p-host-code
      395                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      396               no-error.
      397               if available buf_fin-bank
      398               then do:
      399                   assign
      400                       v-fmtcli-bank-exists      = yes
      401                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      402                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      403                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      404                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      405                   .
      406               end.
      407               else do:
      408                   assign
      409                       v-fmtcli-bank-exists    = no
      410                       v-fmtcli-bank-bik       = "":U
      411                       v-fmtcli-bank-name      = "":U
      412                       v-fmtcli-bank-addres    = "":U
      413                       v-fmtcli-bank-city      = "":U
      414                   .
      415               end.
      416               leave search-for-schet.
      417           end.
      418       end.
      419   end.
      420   end procedure.
      421   procedure fmtcli-get-client :
      422   define input parameter p-obj-type       as character    no-undo.
      423   define input parameter p-obj-code       as integer      no-undo.
      424       define variable v-temp-fmtcli-address      as character     no-undo.
      425       define variable v-num-country-city    as integer      no-undo.
      426       define buffer buf_clients   for ub.clients.
      427       define buffer buf_firm      for ub.firm.
      428       define buffer buf_store     for ub.store.
      429       define buffer buf_shop      for ub.shop.
      430       define buffer buf_person    for ub.person.
      431   do
      432   for buf_clients
      433     , buf_firm
      434     , buf_store
      435     , buf_shop
      436     , buf_person
      437   on error undo, return error
      438   :
      439       assign
      440           v-fmtcli-name           = "":U
      441           v-fmtcli-addres         = "":U
      442           v-fmtcli-post-addres    = "":U
      443           v-fmtcli-full-addres    = "":U
      444           v-fmtcli-phone          = "":U
      445           v-fmtcli-inn            = "":U
      446           v-fmtcli-kpp            = "":U
      447           v-fmtcli-okpo           = "":U
      448           v-fmtcli-city           = "":U
      449           v-fmtcli-index          = "":U
      450           v-fmtcli-country        = "":U
      451       .
      452       find first buf_clients no-lock
      453            where buf_clients.obj-type = p-obj-type
      454              and buf_clients.obj-code = p-obj-code
      455       .
      456       assign
      457           v-fmtcli-name = buf_clients.obj-name
      458       .
      459       case buf_clients.obj-type:
      460          when 'орг':U
      461          then do:
      462               find first buf_firm no-lock
      463                    where buf_firm.firm-code = buf_clients.obj-code
      464                    no-error
      465               .
      466               if available buf_firm
      467               then do:
      468                   assign
      469                       v-num-country-city = num-entries( buf_firm.city )
      470                       v-fmtcli-engl-name = buf_firm.engl-name
      471                   .
      472                   if v-num-country-city > 0
      473                   then do:
      474                       assign
      475                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      476                       .
      477                   end.
      478                   if v-num-country-city > 1
      479                   then do:
      480                       assign
      481                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      482                       .
      483                   end.
      484                   run fmtcli-concatenate-strings in this-procedure (
      485                         input v-fmtcli-full-addres
      486                       , input v-fmtcli-country
      487                       , input ", ":U
      488                       , input 50
      489                       , output v-fmtcli-full-addres
      490                   ).
      491                   run fmtcli-concatenate-strings in this-procedure (
      492                         input v-fmtcli-full-addres
      493                       , input v-fmtcli-city
      494                       , input ", ":U
      495                       , input 50
      496                       , output v-fmtcli-full-addres
      497                   ).
      498                   run fmtcli-concatenate-strings in this-procedure (
      499                         input v-fmtcli-full-addres
      500                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      501                       , input ", ":U
      502                       , input 50
      503                       , output v-fmtcli-full-addres
      504                   ).
      505                   run fmtcli-concatenate-strings in this-procedure (
      506                         input v-fmtcli-post-addres
      507                       , input v-fmtcli-country
      508                       , input ", ":U
      509                       , input 50
      510                       , output v-fmtcli-post-addres
      511                   ).
      512                   run fmtcli-concatenate-strings in this-procedure (
      513                         input v-fmtcli-post-addres
      514                       , input v-fmtcli-city
      515                       , input ", ":U
      516                       , input 50
      517                       , output v-fmtcli-post-addres
      518                   ).
      519                   run fmtcli-concatenate-strings in this-procedure (
      520                         input v-fmtcli-post-addres
      521                       , input string( buf_firm.ind )
      522                       , input ", ":U
      523                       , input 50
      524                       , output v-fmtcli-post-addres
      525                   ).
      526                   run fmtcli-concatenate-strings in this-procedure (
      527                         input substring( buf_firm.addres1, 1, 50 )
      528                       , input buf_firm.addres2
      529                       , input " ":U
      530                       , input 50
      531                       , output v-temp-fmtcli-address
      532                   ).
      533                   run fmtcli-concatenate-strings in this-procedure (
      534                         input v-temp-fmtcli-address
      535                       , input substring( buf_firm.addres1, 51, 50 )
      536                       , input " ":U
      537                       , input 50
      538                       , output v-temp-fmtcli-address
      539                   ).
      540                   run fmtcli-concatenate-strings in this-procedure (
      541                         input v-temp-fmtcli-address
      542                       , input substring( buf_firm.addres1, 101, 50 )
      543                       , input " ":U
      544                       , input 50
      545                       , output v-temp-fmtcli-address
      546                   ).
      547                   assign
      548                       v-fmtcli-addres = v-temp-fmtcli-address
      549                   .
      550                   if buf_firm.addres1 <> ?
      551                   then do:
      552                       run fmtcli-concatenate-strings in this-procedure (
      553                             input v-fmtcli-full-addres
      554                           , input v-fmtcli-addres
      555                           , input ", ":U
      556                           , input 0
      557                           , output v-fmtcli-full-addres
      558                       ).
      559                   end.
      560                   run fmtcli-concatenate-strings in this-procedure (
      561                         input substring( buf_firm.post-addr1, 1, 50 )
      562                       , input buf_firm.post-addr2
      563                       , input " ":U
      564                       , input 50
      565                       , output v-fmtcli-post-addres
      566                   ).
      567                   run fmtcli-concatenate-strings in this-procedure (
      568                         input v-fmtcli-post-addres
      569                       , input substring( buf_firm.post-addr1, 51, 50 )
      570                       , input " ":U
      571                       , input 50
      572                       , output v-fmtcli-post-addres
      573                   ).
      574                   run fmtcli-concatenate-strings in this-procedure (
      575                         input v-fmtcli-post-addres
      576                       , input substring( buf_firm.post-addr1, 101, 50 )
      577                       , input " ":U
      578                       , input 50
      579                       , output v-fmtcli-post-addres
      580                   ).
      581                   assign
      582                       v-fmtcli-phone         = buf_firm.phone
      583                       v-fmtcli-inn           = buf_firm.inn
      584                       v-fmtcli-kpp           = buf_firm.kpp
      585                       v-fmtcli-okpo          = buf_firm.okpo
      586                       v-fmtcli-index         = string( buf_firm.ind )
      587                   .
      588               end.
      589          end.
      590          when 'маг':U
      591          then do:
      592               find first buf_shop no-lock
      593                    where buf_shop.obj-code = buf_clients.obj-code
      594               .
      595               if available buf_shop
      596               then do:
      597                   run fmtcli-concatenate-strings in this-procedure (
      598                         input buf_shop.addres1
      599                       , input buf_shop.addres2
      600                       , input " ":U
      601                       , input 50
      602                       , output v-fmtcli-addres
      603                   ).
      604                   assign
      605                       v-fmtcli-full-addres = v-fmtcli-addres
      606                       v-fmtcli-post-addres = v-fmtcli-addres
      607                       v-fmtcli-phone       = buf_shop.phone
      608                       v-fmtcli-inn         = "":U
      609                       v-fmtcli-kpp         = "":U
      610                       v-fmtcli-okpo        = "":U
      611                       v-fmtcli-city        = "":U
      612                       v-fmtcli-index       = "":U
      613                   .
      614               end.
      615          end.
      616          when 'скл':U
      617          then do:
      618               find first buf_store no-lock
      619                    where buf_store.obj-code = buf_clients.obj-code
      620               .
      621               if available buf_store
      622               then do:
      623                   run fmtcli-concatenate-strings in this-procedure (
      624                         input buf_store.addres1
      625                       , input buf_store.addres2
      626                       , input " ":U
      627                       , input 50
      628                       , output v-fmtcli-addres
      629                   ).
      630                   assign
      631                       v-fmtcli-full-addres = v-fmtcli-addres
      632                       v-fmtcli-phone       = buf_store.phone
      633                       v-fmtcli-inn         = "":U
      634                       v-fmtcli-kpp         = "":U
      635                       v-fmtcli-okpo        = "":U
      636                       v-fmtcli-city        = "":U
      637                       v-fmtcli-index       = "":U
      638                   .
      639               end.
      640          end.
      641          when 'чел':U
      642          then do:
      643               find first buf_person no-lock
      644                    where buf_person.psn-code = buf_clients.obj-code
      645               .
      646               if available buf_person
      647               then do:
      648                   run fmtcli-concatenate-strings in this-procedure (
      649                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      650                                 then "":U
      651                                 else string( buf_person.ind, "999999")
      652                                 )
      653                       , input buf_person.city
      654                       , input ", ":U
      655                       , input 0
      656                       , output v-fmtcli-full-addres
      657                   ).
      658                   assign
      659                       v-fmtcli-addres = buf_person.address
      660                   .
      661                   run fmtcli-concatenate-strings in this-procedure (
      662                         input v-fmtcli-full-addres
      663                       , input v-fmtcli-addres
      664                       , input ", ":U
      665                       , input 0
      666                       , output v-fmtcli-full-addres
      667                   ).
      668                   assign
      669                       v-fmtcli-phone     = buf_person.phone1
      670                       v-fmtcli-inn       = buf_person.inn
      671                       v-fmtcli-kpp       = buf_person.kpp
      672                       v-fmtcli-okpo      = buf_person.okpo
      673                       v-fmtcli-city      = buf_person.city
      674                       v-fmtcli-index     = string( buf_person.ind )
      675                   .
      676               end.
      677          end.
      678       end case.
      679   end.
      680   end procedure.
      681   procedure fmtcli-concatenate-strings :
      682   define input parameter p-string-1       as character        no-undo.
      683   define input parameter p-string-2       as character        no-undo.
      684   define input parameter p-delimiter      as character        no-undo.
      685   define input parameter p-length         as integer          no-undo.
      686   define output parameter p-out-string    as character        no-undo.
      687   do
      688   on error undo, return error
      689   :
      690       assign
      691           p-out-string = ( if p-string-1 = ?
      692                            then "":U
      693                            else trim( p-string-1 ) )
      694       .
      695       assign
      696           p-out-string = p-out-string
      697                        + ( if p-out-string = "":U
      698                            or length( p-out-string ) = p-length
      699                            or p-string-2 = ?
      700                            or trim( p-string-2 ) = "":U
      701                            then "":U
      702                            else p-delimiter )
      703                        + ( if p-string-2 = ?
      704                            or trim( p-string-2 ) = "":U
      705                            then "":U
      706                            else trim( p-string-2 ) )
      707       .
      708   end.
      709   end procedure.
