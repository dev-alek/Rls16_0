     4546   procedure torg12xl-run-excel :
     4547   define input parameter p-header-filename    as character        no-undo.
     4548   define input parameter p-data-filename      as character        no-undo.
     4549       define variable v-template-file-name    as character    no-undo.
     4550       define variable v-vb-file-name          as character    no-undo.
     4551       define buffer buf_temp-param for temp-param .
     4552   do
     4553   for buf_temp-param
     4554   on error undo, return error
     4555   :
     4556       create buf_temp-param.
     4557       if lookup( "TOPAUKC":U, p-mode ) <> 0
     4558       then do:
     4559         if lookup( "GTD":U, p-mode ) <> 0
     4560         then do:
     4561           assign
     4562               v-template-file-name    = search( "exe/t12_97bb.xlt" )
     4563           .
     4564         end.
     4565         else do:
     4566           assign
     4567               v-template-file-name    = search( "exe/t12_97b.xlt" )
     4568           .
     4569         end.
     4570       end.
     4571       else do:
     4572         assign
     4573             v-template-file-name    = search( "exe/t12_97.xlt" )
     4574           .
     4575         end.
     4576       assign
     4577           v-vb-file-name          = search( "exe/t_97.bas")
     4578       .
     4579       if v-template-file-name = ?
     4580       or v-template-file-name = "":U
     4581       then do:
     4582           message
     4583               "Ошибка имени файла шаблона."
     4584           view-as alert-box error.
     4585       end.
     4586       if v-vb-file-name = ?
     4587       or v-vb-file-name = "":U
     4588       then do:
     4589           message
     4590               "Ошибка имени файла кода обработки."
     4591           view-as alert-box error.
     4592       end.
     4593       run paramls-write in this-procedure (
     4594             input "template":U
     4595           , input "template-file-name":U
     4596           , input v-template-file-name
     4597       ).
     4598       run paramls-write in this-procedure (
     4599             input "template":U
     4600           , input "vb-file-name":U
     4601           , input v-vb-file-name
     4602       ).
     4603       run paramls-write in this-procedure (
     4604             input "data":U
     4605           , input "data-header-filename":U
     4606           , input p-header-filename
     4607       ).
     4608       run paramls-write in this-procedure (
     4609             input "data":U
     4610           , input "data-filename":U
     4611           , input p-data-filename
     4612       ).
     4613       run gbl/macroxlt.p (
     4614           input-output table buf_temp-param
     4615       ) no-error.
     4616       if error-status :error
     4617       then do:
     4618           message
     4619                    vss-workfile vss-revision vss-description
     4620               skip(1)
     4621               skip "Ошибка создания файла Excel."
     4622               skip return-value
     4623               skip trim(error-status :get-message(1))
     4624                    trim(error-status :get-message(2))
     4625                    trim(error-status :get-message(3))
     4626           view-as alert-box error.
     4627           undo, return error .
     4628       end.
     4629   end.
     4630   end procedure.
