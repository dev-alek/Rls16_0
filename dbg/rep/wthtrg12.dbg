     1577   procedure torgconf-get-sup-param :
     1578   define input parameter p-obj-type           as character        no-undo.
     1579   define input parameter p-obj-code           as integer          no-undo.
     1580   define input parameter p-curr-code          as integer          no-undo.
     1581       define variable v-host-code    as integer      no-undo.
     1582       define variable v-par-type     as character    no-undo.
     1583   do
     1584   on error undo, return error
     1585   :
     1586       assign
     1587          v-torgconf-sup-host-code = v-host-code
     1588       .
     1589       if v-torgconf-sup-host-code = 0
     1590       then do:
     1591           assign
     1592               v-torgconf-sup-host-name           = "":U
     1593               v-torgconf-sup-host-addres         = "":U
     1594               v-torgconf-sup-host-post-addres    = "":U
     1595               v-torgconf-sup-host-phone          = "":U
     1596               v-torgconf-sup-host-inn            = "":U
     1597               v-torgconf-sup-host-kpp            = "":U
     1598               v-torgconf-sup-host-okpo           = "":U
     1599               v-torgconf-sup-host-egrip-date     = "":U
     1600               v-torgconf-sup-host-egrip-num      = "":U
     1601           .
     1602       end.
     1603       else do:
     1604           run fmtcli-get-client in this-procedure (
     1605                 input 'орг':U
     1606               , input v-torgconf-sup-host-code
     1607           ).
     1608           assign
     1609               v-torgconf-sup-host-name        = v-fmtcli-name
     1610               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1611               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1612               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1613               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1614               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1615               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1616               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1617           .
     1618           run gbl/clntat-v.p (
     1619                 input 'орг':U
     1620               , input v-torgconf-sup-host-code
     1621               , input 'egrip-date':U
     1622               , output v-torgconf-sup-host-egrip-date
     1623               , output v-par-type
     1624           ).
     1625           run gbl/clntat-v.p (
     1626                 input 'орг':U
     1627               , input v-torgconf-sup-host-code
     1628               , input 'egrip-num':U
     1629               , output v-torgconf-sup-host-egrip-num
     1630               , output v-par-type
     1631           ).
     1632           run fmtcli-get-bank in this-procedure (
     1633                 input v-host-code
     1634               , input 'орг':U
     1635               , input v-torgconf-sup-host-code
     1636               , input p-curr-code
     1637           ).
     1638       end.
     1639       assign
     1640           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1641           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1642           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1643           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1644           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1645           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1646           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1647           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1648       .
     1649       assign
     1650           v-torgconf-sup-obj-type = p-obj-type
     1651           v-torgconf-sup-obj-code = p-obj-code
     1652       .
     1653       if trim(p-obj-type) <> ""
     1654       and p-obj-code <> 0
     1655       then do:
     1656       run fmtcli-get-client in this-procedure (
     1657             input p-obj-type
     1658           , input p-obj-code
     1659       ).
     1660       assign
     1661           v-torgconf-sup-obj-name        = v-fmtcli-name
     1662           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1663           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1664           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1665           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1666           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1667           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1668       .
     1669      end.
     1670      end.
     1671   end procedure.
