      585   procedure prn-lib-prn-file :
      586     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      587     define input parameter p-DIsabledoptions as integer no-undo .
      588     define variable v-report-name as character no-undo .
      589     define variable v-user-action as character no-undo .
      590     define variable v-printed     as logical   no-undo .
      591     define variable v-exist       as logical   no-undo .
      592     do
      593       on error undo, return error
      594       :
      595       run prn-lib-get-report-name  in this-procedure (
      596         input parParentProc
      597         ,output v-report-name
      598         ).
      599   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      600   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      601     (input  v-report-name
      602     ,input  2
      603     ,output v-exist
      604     )  .
      605       if NOT v-exist then
      606       DO:
      607         Message
      608           "Нет заданий на печать ! "
      609           view-as alert-box .
      610         Return  .
      611       End.
      612       run gbl/prnfilen.w
      613         (input  ""
      614         ,input  p-DisabledOptions
      615         ,input  string(v-report-name )
      616         ,input  7
      617         ,output v-user-action
      618         ,output v-printed
      619         ) .
      620       if v-printed then
      621       do:
      622         return "YES" .
      623       end.
      624       else
      625       do:
      626         return "NO" .
      627       end.
      628     end.
      629   end procedure.
      630   procedure prn-lib-open-stream :
      631     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      632     define input parameter p-page-size    as integer no-undo .
      633     define input parameter p-is-stream    as logical no-undo .
      634     define input parameter p-append       as logical no-undo .
      635     define variable v-report-name as character no-undo .
      636     do
      637       on error undo, return error
      638       :
      639       run prn-lib-get-report-name  in this-procedure (
      640         input parParentProc
      641         ,output v-report-name
      642         ).
      643       if p-is-stream then
      644       do:
      645         if p-append then
      646         do:
      647           output stream PrnLibStream to value( v-report-name )
      648             page-size value(p-page-size) append .
      649         end.
      650         if not p-append then
      651         do:
      652           output stream PrnLibStream to value( v-report-name )
      653             page-size value(p-page-size) .
      654         end.
      655       end.
      656       if not p-is-stream then
      657       do:
      658         if p-append then
      659         do:
      660           output to value( v-report-name )
      661             page-size value(p-page-size) append .
      662         end.
      663         if not p-append then
      664         do:
      665           output to value( v-report-name )
      666             page-size value(p-page-size) .
      667         end.
      668       end.
      669     end.
      670   end procedure.
      671   procedure prn-lib-open-exp :
      672     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      673     define input parameter p-is-stream    as logical no-undo .
      674     define input parameter p-is-append    as logical no-undo .
      675     define output parameter p-ReportFileName as char init "report" no-undo.
      676     define output parameter p-process as logical no-undo .
      677     define variable glog as logical no-undo .
      678     do
      679       on error undo, return error
      680       :
      681       SYSTEM-DIALOG GET-FILE p-ReportFileName
      682         TITLE      "Укажите путь"
      683         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      684         ASK-OVERWRITE
      685         CREATE-TEST-FILE
      686         SAVE-AS
      687         USE-FILENAME
      688         DEFAULT-EXTENSION "txt"
      689         UPDATE glog
      690         .
      691       if not glog then  return.
      692       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      693       if p-is-stream then
      694       do:
      695         if p-is-append then
      696         do:
      697           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      698         end.
      699         else
      700         do:
      701           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      702         end.
      703       end.
      704       else
      705       do:
      706         if p-is-append then
      707         do:
      708           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      709         end.
      710         else
      711         do:
      712           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      713         end.
      714       end.
      715       p-process = yes.
      716     end.
      717   end procedure.
      718   procedure prn-lib-get-report-name :
      719     define input parameter parParentProc  as widget-handle no-undo.
      720     define output parameter p-report-name as character no-undo .
      721     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      722   end procedure.
      723   procedure prn-lib-reportviewer-report-name :
      724     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      725     define input parameter p-report-name-html as character no-undo .
      726     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      727   end procedure.
      728   procedure prn-lib-reportviewer :
      729     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      730     define input parameter p-report-name-html as character no-undo .
      731     define input parameter p-param        as character no-undo .
      732     define variable v-excel           as character no-undo init 'TRUE' .
      733     define variable v-value-character as character no-undo .
      734     define variable v-value-integer   as character no-undo .
      735     define variable v-value-date      as date      no-undo .
      736     define variable v-value-decimal   as decimal   no-undo .
      737     define variable rep-excel         as logical   no-undo .
      738     define variable excel-string      as character no-undo .
      739     define variable v-param-type      as character no-undo .
      740     define variable v-tth             as handle    no-undo .
      741     run adm/shattri.p (
      742       input "get":U
      743       ,input  ""
      744       ,input  0
      745       ,input  'report-glob':U
      746       ,input  'rep-excel':U
      747       ,output v-value-character
      748       ,output v-value-date
      749       ,output v-value-decimal
      750       ,output v-value-integer
      751       ,output rep-excel
      752       ,output v-param-type
      753       ,INPUT-OUTPUT table-handle v-tth
      754       )  .
      755     if rep-excel then v-excel = "TRUE" .
      756     else v-excel = "FALSE" .
      757     if p-param eq ""
      758     then
      759        p-param = "EXCEL:" + v-excel.
      760     else
      761        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      762     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      763   end procedure.
      764   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      765   PROCEDURE LastDate:
      766       def input parameter in-date as date no-undo.
      767       def output parameter LastDate as date no-undo.
      768       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      769   END PROCEDURE.
      770   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      771   procedure cur-time :
      772      define output parameter p-today as date      no-undo .
      773      define output parameter p-time  as integer   no-undo .
      774     do
      775     on error undo, return error
      776     :
      777       define variable v-date1 as date      no-undo .
      778       define variable v-date2 as date      no-undo .
      779       define variable v-time  as integer   no-undo .
      780       assign
      781         v-date1 = today
      782         v-time  = time
      783         v-date2 = today
      784       .
      785       if v-date1 <> v-date2
      786       then do:
      787         assign
      788           v-date1 = today
      789           v-time  = v-time
      790         .
      791       end.
      792       assign
      793         p-today = v-date1
      794         p-time  = v-time
      795       .
      796     end.
      797   end.
      798   function cur-time-date returns character
      799   :
      800     return string(today, '99/99/9999':U) .
      801   end.
      802   function cur-time-mjd returns decimal
      803   :
      804     define variable v-date as date      no-undo .
      805     define variable v-time as integer   no-undo .
      806     run cur-time in this-procedure
      807       (output v-date
      808       ,output v-time
      809       ) .
      810     return integer(v-date) - 2400002 + (v-time / 86400) .
      811   end.
      812   function cur-time-get-ending-index returns integer
      813   (input p-number as integer
      814   )
      815   :
      816     if p-number < 0
      817     or p-number = ?
      818     then do:
      819       return 1 .
      820     end.
      821     define variable v-rest as integer   no-undo .
      822     assign
      823       p-number = p-number modulo 100
      824     .
      825     if p-number < 20
      826     then do:
      827       assign
      828         v-rest = p-number
      829       .
      830     end.
      831     else do:
      832       assign
      833         v-rest = p-number modulo 10
      834       .
      835     end.
      836     case v-rest :
      837       when 1
      838       then do:
      839         return 2 .
      840       end.
      841       when 2 or
      842       when 3 or
      843       when 4
      844       then do:
      845         return 3 .
      846       end.
      847       otherwise do:
      848         return 1 .
      849       end.
      850     end case .
      851   end.
      852   procedure cur-time-mjd-to-date :
      853      define input  parameter i-mjd-diff as decimal no-undo.
      854      define output parameter o-Date     as date    no-undo.
      855      define output parameter o-Time     as integer no-undo.
      856      define variable v-day-number as integer   no-undo .
      857      if    i-mjd-diff < 0
      858         or i-mjd-diff = ?
      859      then do:
      860         return "?" .
      861      end.
      862      assign
      863         v-day-number = truncate(i-mjd-diff,0).
      864         o-Date = date(v-day-number + 2400002).
      865         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      866     .
      867   end.
      868   function cur-time-mjd-to-string returns character
      869   (input p-mjd-diff as decimal
      870   )
      871   :
      872     define variable v-day-number as integer   no-undo .
      873     define variable v-seconds    as integer   no-undo .
      874     define variable v-hour       as integer   no-undo .
      875     define variable v-min        as integer   no-undo .
      876     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      877     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      878     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      879     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      880     if p-mjd-diff < 0
      881     or p-mjd-diff = ?
      882     then do:
      883       return "?" .
      884     end.
      885     assign
      886       v-day-number = integer(truncate(p-mjd-diff,0))
      887       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      888     .
      889     if v-seconds > 86400
      890     then do:
      891       assign
      892         v-seconds = 86400 - 1
      893       .
      894     end.
      895     if v-seconds < 0
      896     then do:
      897       assign
      898         v-seconds = 0
      899       .
      900     end.
      901     assign
      902       v-hour = truncate(v-seconds / 3600, 0)
      903     .
      904     assign
      905       v-seconds = v-seconds modulo 3600
      906     .
      907     assign
      908       v-min = truncate(v-seconds / 60, 0)
      909     .
      910     assign
      911       v-seconds = v-seconds modulo 60
      912     .
      913     return
      914         (if v-day-number <> 0
      915           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      916           else ""
      917         )
      918       + (if v-day-number <> 0 or v-hour <> 0
      919           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      920           else ""
      921         )
      922       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      923           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      924           else ""
      925         )
      926       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      927       .
      928   end.
      929   function cur-time-string returns character
      930   :
      931     define variable v-date as date      no-undo .
      932     define variable v-time as integer   no-undo .
      933     run cur-time in this-procedure
      934       (output v-date
      935       ,output v-time
      936       ) .
      937     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      938   end.
      939   function cur-time-string-sec returns character
      940   :
      941     define variable v-date as date      no-undo .
      942     define variable v-time as integer   no-undo .
      943     run cur-time in this-procedure
      944       (output v-date
      945       ,output v-time
      946       ) .
      947     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      948   end.
      949   function cur-time-custom  returns character
      950   (input p-prefix as character
      951   ,input p-date-format as character
      952   ,input p-delimiter as character
      953   ,input p-time-format as character
      954   ,input p-suffix as character
      955   )
      956   :
      957     define variable v-date as date      no-undo .
      958     define variable v-time as integer   no-undo .
      959     run cur-time in this-procedure
      960       (output v-date
      961       ,output v-time
      962       ) .
      963     return
      964       p-prefix
      965       + string(v-date, p-date-format)
      966       + p-delimiter
      967       + string(v-time, p-time-format)
      968       + p-suffix
      969       .
      970   end.
      971   function cur-time-print  returns character
      972   :
      973     define variable v-date as date      no-undo .
      974     define variable v-time as integer   no-undo .
      975     run cur-time in this-procedure
      976       (output v-date
      977       ,output v-time
      978       ) .
      979     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      980   end.
      981   function cur-time-datetime returns datetime
      982   :
      983     define variable v-char as character no-undo .
      984     define variable v-datetime as datetime no-undo .
      985     v-char = cur-time-string().
      986     v-datetime = datetime(v-char).
      987     return  v-datetime.
      988   end.
      989   function cur-time-string-msec returns character
      990   :
      991     define variable v-date as datetime  no-undo .
      992     v-date = now.
      993     return string(v-date) .
      994   end.
