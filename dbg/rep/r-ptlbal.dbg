     1436     STRING(":   Номер   ", "X(12)") STRING(":  № резер- ", "X(12)") STRING(":   Вид   ", "X(12)") STRING(": Остаток  ", "X(12)") STRING(":на начало ", "X(11)") STRING(":___________", "X(12)") STRING("____________", "X(12)") STRING("____________", "X(12)") STRING("___________", "X(11)") STRING(": Расход   ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(11)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(":Остаток на", "X(12)") STRING(":Остаток на", "X(12)") STRING(": Баланс :", "X(10)") skip
     1437     STRING(":   смены   ", "X(12)") STRING(":    вуара  ", "X(12)") STRING(":  нефте  ", "X(12)") STRING(":на начало ", "X(12)") STRING(":расчетно- ", "X(11)") STRING(":           ", "X(12)") STRING(":    По     ", "X(12)") STRING(":           ", "X(12)") STRING(":Отклонение", "X(11)") STRING(":по данным ", "X(12)") STRING(": Списание ", "X(12)") STRING(": Инвентари", "X(11)") STRING(": Расход   ", "X(12)") STRING(": Возврат  ", "X(12)") STRING(":Остальное ", "X(12)") STRING(":  конец   ", "X(12)") STRING(":  конец   ", "X(12)") STRING(":+излишки:", "X(10)") skip
     1438     STRING(": и дата ее ", "X(12)") STRING(":           ", "X(12)") STRING(": продукта", "X(12)") STRING(":   факт   ", "X(12)") STRING(": книжный  ", "X(11)") STRING(": По ТТН    ", "X(12)") STRING(":измер-ию в ", "X(12)") STRING(":По факту   ", "X(12)") STRING(":от принят.", "X(11)") STRING(": с касс   ", "X(12)") STRING(":          ", "X(12)") STRING(":  зация   ", "X(11)") STRING(": внешний  ", "X(12)") STRING(":поставщику", "X(12)") STRING(":          ", "X(12)") STRING(":фактически", "X(12)") STRING(":расчетно- ", "X(12)") STRING(":-недост.:", "X(10)") skip
     1439     STRING(":  начала   ", "X(12)") STRING(":           ", "X(12)") STRING(":         ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(11)") STRING(":           ", "X(12)") STRING(":резервуаре ", "X(12)") STRING(":           ", "X(12)") STRING(":количества", "X(11)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(11)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(":          ", "X(12)") STRING(": книжный  ", "X(12)") STRING(":        :", "X(10)") skip
     1440     v-line
     1441     .
     1442   form header
     1443     v-line1 at 1 skip
     1444       "Дата:" at 60
     1445       v-print-time format "x(20)"
     1446       "Стр." at 182 string( page-number(PrnLibStream), ">>>9" )  skip
     1447     v-line2 at 1 skip
     1448     with frame topframe
     1449     width 213 page-top no-labels no-box .
     1450   view stream PrnLibStream frame topframe .
     1451   form header
     1452     v-line skip
     1453     "Продолжение на следующей странице " at 30 skip
     1454     with frame bottomframe
     1455     width 213 page-bottom no-labels no-box .
     1456   view stream PrnLibStream frame bottomframe .
     1457   for each sheetf
     1458     where sheetf.sheet-num > 1
     1459   :
     1460     delete sheetf .
     1461   end.
     1462   find first sheetf
     1463     where sheetf.sheet-num = 1
     1464     no-error.
     1465   assign
     1466     sheetf.sizes = "":u
     1467   .
     1468   assign
     1469     Sheetf.MergeCellsH = "6:9"
     1470     Sheetf.MergeCellsV = "1=1:2/2=1:2/3=1:2/4=1:2/5=1:2/10=1:2/11=1:2/12=1:2/13=1:2/14=1:2/15=1:2/16=1:2/17=1:2/18=1:2"
     1471     Sheetf.Sizes       = "10,11,6,11,11,10,11,10,8,11,11,11,11,11,11,11,11,11"
     1472     Sheetf.Excel-Column-Lable = "Номер смены и дата ее начала"       + chr(44) +
     1473                                 "N резервуара"                       + chr(44) +
     1474                                 "Вид нефтепродукта"                  + chr(44) +
     1475                                 "Остаток на начало ФАКТ"             + chr(44) +
     1476                                 "Остаток на начало РАСЧЕТНО-КНИЖНЫЙ" + chr(44) +
     1477                                 "Внешний приход"                     + chr(44) +
     1478                                                                        chr(44) +
     1479                                                                        chr(44) +
     1480                                                                        chr(44) +
     1481                                 "Расход по данным с касс"            + chr(44) +
     1482                                 "Списание"                           + chr(44) +
     1483                                 "Инвентаризация"                     + chr(44) +
     1484                                 "Расход внешний"                     + chr(44) +
     1485                                 "Возврат поставщику"                 + chr(44) +
     1486                                 "Остальное"                          + chr(44) +
     1487                                 "Остаток на конец ФАКТ"              + chr(44) +
     1488                                 "Остаток на конец РАСЧЕТНО-КНИЖНЫЙ"  + chr(44) +
     1489                                 "Баланс +излишки -недостача"         + chr(10)   +
     1490                                                                        chr(44) +
     1491                                                                        chr(44) +
     1492                                                                        chr(44) +
     1493                                                                        chr(44) +
     1494                                                                        chr(44) +
     1495                                 "По ТТН"                             + chr(44) +
     1496                                 "По измерению в резервуаре"          + chr(44) +
     1497                                 "По факту"                           + chr(44) +
     1498                                 "Отклонение от принятого количества" + chr(44) +
     1499                                                                        chr(44) +
     1500                                                                        chr(44) +
     1501                                                                        chr(44) +
     1502                                                                        chr(44) +
     1503                                                                        chr(44) +
     1504                                                                        chr(44) +
     1505                                                                        chr(44) +
     1506                                                                        chr(44) +
     1507                                                                        chr(10)   +
     1508                                  '="1"'                              + chr(44) +
     1509                                  '="2"'                              + chr(44) +
     1510                                  '="3"'                              + chr(44) +
     1511                                  '="4"'                              + chr(44) +
     1512                                  '="5"'                              + chr(44) +
     1513                                  '="6"'                              + chr(44) +
     1514                                  '="7"'                              + chr(44) +
     1515                                  '="8"'                              + chr(44) +
     1516                                  '="9=6-7"'                          + chr(44) +
     1517                                  '="10"'                             + chr(44) +
     1518                                  '="11"'                             + chr(44) +
     1519                                  '="12"'                             + chr(44) +
     1520                                  '="13"'                             + chr(44) +
     1521                                  '="14"'                             + chr(44) +
     1522                                  '="15"'                             + chr(44) +
     1523                                  '="16"'                             + chr(44) +
     1524                                  '="17"'                             + chr(44) +
     1525                                  '="18=16-17"'
     1526   .
     1527   run rep/extitle.p  ( input 1 ) no-error.
     1528   define frame doc-line-frm
     1529     sym01 space(0) vardate-shift         format "x(11)" column-label "1":C10 space(0)
     1530     sym02 space(0) varpl-code            format "99999999999" column-label "2":C8 space(0)
     1531     sym03 space(0) vargoods-name         format "x(10)" column-label "3":C11 space(0)
     1532     sym04 space(0) varrest_start_measure format "->,>>>,>>9.<<<" column-label "4":C9 space(0)
     1533     sym05 space(0) varrest_start_book    format "->,>>>,>>9.<<<" column-label "5":C9 space(0)
     1534     sym06 space(0) varwayb               format "->,>>>,>>9.<<<" column-label "6":C9 space(0)
     1535     sym07 space(0) varwayb_measure       format "->,>>>,>>9.<<<" column-label "7":C9 space(0)
     1536     sym08 space(0) varwayb_fact          format "->,>>>,>>9.<<<" column-label "8":C9 space(0)
     1537     sym09 space(0) varwayb_difference    format "->,>>9.<<<" column-label "9=6-7":C10 space(0)
     1538     sym10 space(0) varexp_kass           format "->,>>>,>>9.<<<" column-label "10":C9 space(0)
     1539     sym11 space(0) varwrite-off          format "->,>>>,>>9.<<<" column-label "11":C9 space(0)
     1540     sym12 space(0) varinvent             format "->>>>,>>9.<<<" column-label "12":C9 space(0)
     1541     sym13 space(0) varexp_gross          format "->,>>>,>>9.<<<" column-label "13":C9 space(0)
     1542     sym14 space(0) varret_supp           format "->,>>>,>>9.<<<" column-label "14":C9 space(0)
     1543     sym15 space(0) varanother            format "->,>>>,>>9.<<<" column-label "15":C9 space(0)
     1544     sym16 space(0) varrest_end_measure   format "->,>>>,>>9.<<<" column-label "16":C9 space(0)
     1545     sym17 space(0) varrest_end_book      format "->,>>>,>>9.<<<" column-label "17":C9 space(0)
     1546     sym18 space(0) varrest_end_balans    format "->>,>>9.<<<" column-label "18=16-17":C8 space(0)
     1547     sym19 space(0)
     1548     with width 213 down stream-io use-text .
     1549   form with frame doc-line-frm .
     1550   CASE pardate-shift :
     1551       WHEN 2 THEN DO:
     1552               for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             buf_trn-doc.shift-date >= parstart_date and buf_trn-doc.shift-date <= parend_date and                             buf_trn-doc.status_     = 'факт':U                              ,                              each gds-list, first buf_goods where buf_goods.artic      = gds-list.artic  and buf_goods.prod-type  = gds-list.prod-type and buf_goods.prod-code  = gds-list.prod-code no-lock,                         each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                             , each buf_doc-pl where buf_doc-pl.out-code = buf_trn-doc.doc-code and buf_doc-pl.gds-code = buf_goods.gds-code and buf_doc-pl.obj-type = buf_trn-doc.obj-type and buf_doc-pl.obj-code = buf_trn-doc.obj-code                      BREAK BY buf_trn-doc.shift-date BY buf_trn-doc.shift-num BY buf_doc-pl.pl-code BY buf_doc-pl.gds-code  :
     1553   if first-of (buf_trn-doc.shift-num) then do:
     1554     find first bef-rvs-doc no-lock
     1555       where bef-rvs-doc.obj-type   = parobj-type
     1556         and bef-rvs-doc.obj-code    = parobj-code
     1557         and ( (bef-rvs-doc.shift-date = buf_trn-doc.shift-date
     1558                and bef-rvs-doc.shift-num  <  buf_trn-doc.shift-num
     1559               )
     1560               or bef-rvs-doc.shift-date <  buf_trn-doc.shift-date
     1561             )
     1562         and bef-rvs-doc.status_     = 'факт':U
     1563         and bef-rvs-doc.rvs-type    = 'смена':U
     1564       no-error.
     1565     assign
     1566       bef-rvs-doc-rec = (if available bef-rvs-doc then recid(bef-rvs-doc) else ?)
     1567     .
     1568     find first buf_rvs-doc no-lock
     1569       where buf_rvs-doc.obj-type    = parobj-type
     1570         and buf_rvs-doc.obj-code    = parobj-code
     1571         and buf_rvs-doc.shift-date  = buf_trn-doc.shift-date
     1572         and buf_rvs-doc.shift-num   = buf_trn-doc.shift-num
     1573         and buf_rvs-doc.status_     = 'факт':U
     1574         and buf_rvs-doc.rvs-type    = 'смена':U
     1575       no-error.
     1576     assign
     1577       rvs-doc-rec = (if available buf_rvs-doc then recid(buf_rvs-doc) else ?)
     1578     .
     1579     assign
     1580       vardate-shift = string(buf_trn-doc.shift-name,"x(2)") + " " + string(buf_trn-doc.shift-date, "99/99/99")
     1581     .
     1582     display stream prnlibstream
     1583       sym01 vardate-shift
     1584       with frame doc-line-frm.
     1585     if Make-Excel then  put   stream ForExcel unformatted
     1586     vardate-shift
     1587     .
     1588   end.
     1589   if first-of (buf_trn-doc.shift-date) then do:
     1590     if p-tog-shift = true then do:
     1591       find first start-date-rvs-doc no-lock
     1592         where start-date-rvs-doc.obj-type         = parobj-type
     1593           and start-date-rvs-doc.obj-code         = parobj-code
     1594           and ( (start-date-rvs-doc.shift-date    = buf_trn-doc.shift-date
     1595                 and start-date-rvs-doc.shift-num  <  buf_trn-doc.shift-num
     1596                 )
     1597                 or start-date-rvs-doc.shift-date  <  buf_trn-doc.shift-date
     1598               )
     1599           and start-date-rvs-doc.status_          = 'факт':U
     1600           and start-date-rvs-doc.rvs-type         = 'смена':U
     1601         no-error.
     1602     end.
     1603     else do:
     1604       find first start-date-rvs-doc no-lock
     1605         where start-date-rvs-doc.obj-type   = parobj-type
     1606           and start-date-rvs-doc.obj-code   = parobj-code
     1607           and start-date-rvs-doc.shift-date < buf_trn-doc.shift-date
     1608           and start-date-rvs-doc.status_    = 'факт':U
     1609           and start-date-rvs-doc.rvs-type   = 'смена':U
     1610         no-error.
     1611     end.
     1612     assign start-date-rvs-doc-rec = (if available start-date-rvs-doc then recid(start-date-rvs-doc) else ?).
     1613     find first end-date-rvs-doc no-lock
     1614       where end-date-rvs-doc.obj-type     = parobj-type
     1615         and end-date-rvs-doc.obj-code     = parobj-code
     1616         and end-date-rvs-doc.shift-date   = buf_trn-doc.shift-date
     1617         and end-date-rvs-doc.status_      = 'факт':U
     1618         and end-date-rvs-doc.rvs-type     = 'смена':U
     1619       no-error.
     1620     assign end-date-rvs-doc-rec = (if available end-date-rvs-doc then recid(end-date-rvs-doc) else ?).
     1621   end.
     1622   if first-of(buf_doc-pl.gds-code) then do:
     1623     assign
     1624       varrest_start_measure   = 0
     1625       varrest_start_book      = 0
     1626       varwayb                 = 0
     1627       varwayb_measure         = 0
     1628       varwayb_fact            = 0
     1629       varwayb_difference      = 0
     1630       varexp_kass             = 0
     1631       varwrite-off            = 0
     1632       varinvent               = 0
     1633       varexp_gross            = 0
     1634       varret_supp             = 0
     1635       varanother              = 0
     1636       varrest_end_measure     = 0
     1637       varrest_end_book        = 0
     1638       varrest_end_balans      = 0
     1639     .
     1640     if bef-rvs-doc-rec <> ? then do:
     1641       find first bef-rvs-doc no-lock
     1642         where recid(bef-rvs-doc) = bef-rvs-doc-rec
     1643         no-error.
     1644       find first bef-rvs-line no-lock
     1645         where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code
     1646           and bef-rvs-line.obj-type = bef-rvs-doc.obj-type
     1647           and bef-rvs-line.obj-code = bef-rvs-doc.obj-code
     1648           and bef-rvs-line.pl-code  = buf_doc-pl.pl-code
     1649           and bef-rvs-line.gds-code = buf_doc-pl.gds-code
     1650         no-error.
     1651     end.
     1652     if rvs-doc-rec <> ? then do:
     1653     find first buf_rvs-doc no-lock
     1654       where recid(buf_rvs-doc) = rvs-doc-rec
     1655       .
     1656     find first buf_rvs-line no-lock
     1657       where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     1658         and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     1659         and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     1660         and buf_rvs-line.pl-code  = buf_doc-pl.pl-code
     1661         and buf_rvs-line.gds-code = buf_doc-pl.gds-code
     1662       no-error.
     1663     end.
     1664     assign
     1665       varrest_start_measure = ?
     1666       varrest_start_book    = ?
     1667       varrest_end_measure   = ?
     1668       varrest_end_book      = ?
     1669       varrest_end_balans    = ?
     1670     .
     1671     if p-tog-weight = true then do:
     1672       if available bef-rvs-line then do:
     1673         assign
     1674           varrest_start_measure = bef-rvs-line.state-measure-cli-qnty + bef-rvs-line.state-add-qnty * bef-rvs-line.state-density
     1675           varrest_start_book    = bef-rvs-line.system-cli-qnty
     1676         .
     1677       end.
     1678       if available buf_rvs-line then do:
     1679         assign
     1680           varrest_end_measure   = buf_rvs-line.state-measure-cli-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     1681           varrest_end_book      = buf_rvs-line.system-cli-qnty
     1682           varrest_end_balans    = varrest_end_measure - varrest_end_book
     1683         .
     1684       end.
     1685     end.
     1686     else do:
     1687       if available bef-rvs-line then do:
     1688         assign
     1689           varrest_start_measure = bef-rvs-line.state-measure-qnty + bef-rvs-line.state-add-qnty
     1690           varrest_start_book    = bef-rvs-line.system-qnty
     1691         .
     1692       end.
     1693       if available buf_rvs-line then do:
     1694         assign
     1695           varrest_end_measure   = buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty
     1696           varrest_end_book      = buf_rvs-line.system-qnty
     1697           varrest_end_balans    = varrest_end_measure - varrest_end_book
     1698         .
     1699       end.
     1700     end.
     1701   end.
     1702   assign
     1703     varrev = (if p-tog-weight = true then buf_doc-pl.cli-fact-qnty else buf_doc-pl.fact-qnty)
     1704   .
     1705   case buf_trn-doc.doc-type:
     1706     when 'при':U then do:
     1707       if not buf_trn-doc.internal then do:
     1708         assign
     1709           varwayb      = varwayb      + (if p-tog-weight = true then buf_doc-pl.cli-doc-qnty  else buf_doc-pl.doc-qnty )
     1710           varwayb_fact = varwayb_fact + varrev
     1711         .
     1712         find first bef-doc-rvs-doc no-lock
     1713           where bef-doc-rvs-doc.out-code = buf_trn-doc.doc-code
     1714             and bef-doc-rvs-doc.rvs-type = 'перед_док':U
     1715           no-error.
     1716         find first aft-doc-rvs-doc no-lock
     1717           where aft-doc-rvs-doc.out-code = buf_trn-doc.doc-code
     1718             and aft-doc-rvs-doc.rvs-type = 'после_док':U
     1719           no-error.
     1720         if available bef-doc-rvs-doc
     1721           and available aft-doc-rvs-doc
     1722         then do:
     1723           find first bef-doc-rvs-line no-lock
     1724             where bef-doc-rvs-line.rvs-code = bef-doc-rvs-doc.rvs-code
     1725               and bef-doc-rvs-line.obj-type = bef-doc-rvs-doc.obj-type
     1726               and bef-doc-rvs-line.obj-code = bef-doc-rvs-doc.obj-code
     1727               and bef-doc-rvs-line.pl-code  = buf_doc-pl.pl-code
     1728               and bef-doc-rvs-line.gds-code = buf_doc-pl.gds-code
     1729               no-error .
     1730           find first aft-doc-rvs-line no-lock
     1731             where aft-doc-rvs-line.rvs-code = aft-doc-rvs-doc.rvs-code
     1732               and aft-doc-rvs-line.obj-type = aft-doc-rvs-doc.obj-type
     1733               and aft-doc-rvs-line.obj-code = aft-doc-rvs-doc.obj-code
     1734               and aft-doc-rvs-line.pl-code  = buf_doc-pl.pl-code
     1735               and aft-doc-rvs-line.gds-code = buf_doc-pl.gds-code
     1736               no-error .
     1737         if available bef-doc-rvs-line   and available aft-doc-rvs-line
     1738         then do:
     1739           assign
     1740             varwayb_measure    = varwayb_measure + (if p-tog-weight = true then aft-doc-rvs-line.measure-cli-qnty - bef-doc-rvs-line.measure-cli-qnty else aft-doc-rvs-line.measure-qnty - bef-doc-rvs-line.measure-qnty)
     1741             varwayb_difference = varwayb - varwayb_measure
     1742           .
     1743          end.
     1744         end.
     1745       end.
     1746       else do:
     1747         assign
     1748           varanother = varanother + varrev
     1749         .
     1750       end.
     1751     end.
     1752     when 'рас':U then do:
     1753       if not buf_trn-doc.internal then do:
     1754         if buf_trn-doc.discnt-type = 'касс':U then do:
     1755           assign
     1756             varexp_kass = varexp_kass + varrev
     1757           .
     1758         end.
     1759         else do:
     1760           if buf_trn-doc.ext-doc-type = 'ep':U then do:
     1761             assign
     1762               varret_supp  = varret_supp + varrev
     1763             .
     1764           end.
     1765           else do:
     1766             assign
     1767               varexp_gross = varexp_gross + varrev
     1768             .
     1769           end.
     1770           end.
     1771         end.
     1772       else do:
     1773         assign
     1774           varanother = varanother + varrev
     1775         .
     1776       end.
     1777     end.
     1778     when 'возврат':U then do:
     1779       if not buf_trn-doc.internal then do:
     1780         if buf_trn-doc.discnt-type = 'касс':U then do:
     1781           assign
     1782             varexp_kass = varexp_kass - varrev
     1783           .
     1784         end.
     1785         else do:
     1786           if buf_trn-doc.ext-doc-type = 'ep':U then do:
     1787             assign
     1788               varret_supp = varret_supp - varrev
     1789             .
     1790           end.
     1791           else do:
     1792             assign
     1793               varexp_gross = varexp_gross - varrev
     1794             .
     1795           end.
     1796           end.
     1797         end.
     1798       else do:
     1799         assign
     1800           varanother = varanother - varrev
     1801         .
     1802       end.
     1803     end.
     1804     when 'спи':U then do:
     1805       assign
     1806         varwrite-off = varwrite-off + varrev
     1807       .
     1808     end.
     1809     when 'инв':U then do:
     1810       assign
     1811         varinvent = varinvent + varrev
     1812       .
     1813     end.
     1814     otherwise do:
     1815       assign
     1816         varanother = varanother + varrev
     1817       .
     1818     end.
     1819   end case.
     1820   if last-of(buf_doc-pl.gds-code) then do:
     1821     assign
     1822       vargoods-name = buf_goods.gds-name
     1823       varpl-code    = buf_doc-pl.pl-code
     1824     .
     1825     display stream prnlibstream
     1826       sym01
     1827       sym02 varpl-code
     1828       sym03 vargoods-name
     1829       sym04 varrest_start_measure
     1830       sym05 varrest_start_book format "->>>>>>>9.<<<"
     1831       sym06 varwayb
     1832       sym07 varwayb_measure
     1833       sym08 varwayb_fact
     1834       sym09 varwayb_difference
     1835       sym10 varexp_kass
     1836       sym11 varwrite-off
     1837       sym12 varinvent
     1838       sym13 varexp_gross
     1839       sym14 varret_supp
     1840       sym15 varanother
     1841       sym16 varrest_end_measure
     1842       sym17 varrest_end_book format "->>>>>>>>9.<<<"
     1843       sym18 varrest_end_balans
     1844       sym19
     1845      with frame doc-line-frm.
     1846      down stream prnlibstream with frame doc-line-frm.
     1847     if Make-Excel then  put   stream ForExcel unformatted
     1848     CHR(9)
     1849     varpl-code            CHR(9)
     1850     vargoods-name         CHR(9)
     1851     varrest_start_measure CHR(9)
     1852     varrest_start_book    CHR(9)
     1853     varwayb               CHR(9)
     1854     varwayb_measure       CHR(9)
     1855     varwayb_fact          CHR(9)
     1856     varwayb_difference    CHR(9)
     1857     varexp_kass           CHR(9)
     1858     varwrite-off          CHR(9)
     1859     varinvent             CHR(9)
     1860     varexp_gross          CHR(9)
     1861     varret_supp           CHR(9)
     1862     varanother            CHR(9)
     1863     varrest_end_measure   CHR(9)
     1864     varrest_end_book      CHR(9)
     1865     varrest_end_balans    chr(10)
     1866     .
     1867     find first tt-rev-day
     1868       where tt-rev-day.shift-date = buf_trn-doc.shift-date
     1869         and tt-rev-day.pl-code    = buf_doc-pl.pl-code
     1870         and tt-rev-day.gds-code   = buf_doc-pl.gds-code
     1871       no-error.
     1872     if not available tt-rev-day then do:
     1873       create tt-rev-day.
     1874       assign
     1875         tt-rev-day.shift-date = buf_trn-doc.shift-date
     1876         tt-rev-day.pl-code    = buf_doc-pl.pl-code
     1877         tt-rev-day.gds-code   = buf_doc-pl.gds-code
     1878       .
     1879       if start-date-rvs-doc-rec <> ? then do:
     1880         find first start-date-rvs-doc no-lock
     1881           where recid(start-date-rvs-doc) = start-date-rvs-doc-rec.
     1882         find first start-date-rvs-line no-lock
     1883           where start-date-rvs-line.rvs-code = start-date-rvs-doc.rvs-code
     1884             and start-date-rvs-line.obj-type = start-date-rvs-doc.obj-type
     1885             and start-date-rvs-line.obj-code = start-date-rvs-doc.obj-code
     1886             and start-date-rvs-line.pl-code  = buf_doc-pl.pl-code
     1887             and start-date-rvs-line.gds-code = buf_doc-pl.gds-code
     1888           no-error.
     1889       end.
     1890       if end-date-rvs-doc-rec <> ? then do:
     1891         find first end-date-rvs-doc no-lock
     1892           where recid(end-date-rvs-doc) = end-date-rvs-doc-rec
     1893           .
     1894         find first end-date-rvs-line no-lock
     1895           where end-date-rvs-line.rvs-code = end-date-rvs-doc.rvs-code
     1896             and end-date-rvs-line.obj-type = end-date-rvs-doc.obj-type
     1897             and end-date-rvs-line.obj-code = end-date-rvs-doc.obj-code
     1898             and end-date-rvs-line.pl-code  = buf_doc-pl.pl-code
     1899             and end-date-rvs-line.gds-code = buf_doc-pl.gds-code
     1900           no-error.
     1901       end.
     1902       assign
     1903         tt-rev-day.rest_start_measure = ?
     1904         tt-rev-day.rest_start_book    = ?
     1905         tt-rev-day.rest_end_measure   = ?
     1906         tt-rev-day.rest_end_book      = ?
     1907         tt-rev-day.rest_end_balans    = ?
     1908       .
     1909       if p-tog-weight = true then do:
     1910         if available start-date-rvs-line then do:
     1911           assign
     1912             tt-rev-day.rest_start_measure = start-date-rvs-line.state-measure-cli-qnty + start-date-rvs-line.state-add-qnty * start-date-rvs-line.state-density
     1913             tt-rev-day.rest_start_book    = start-date-rvs-line.system-cli-qnty
     1914           .
     1915         end.
     1916         if available end-date-rvs-line then do:
     1917           assign
     1918             tt-rev-day.rest_end_measure   = end-date-rvs-line.state-measure-cli-qnty + end-date-rvs-line.state-add-qnty * end-date-rvs-line.state-density
     1919             tt-rev-day.rest_end_book      = end-date-rvs-line.system-cli-qnty
     1920             tt-rev-day.rest_end_balans    = varrest_end_measure - varrest_end_book
     1921           .
     1922         end.
     1923       end.
     1924       else do:
     1925         if available start-date-rvs-line then do:
     1926           assign
     1927             tt-rev-day.rest_start_measure = start-date-rvs-line.state-measure-qnty + start-date-rvs-line.state-add-qnty
     1928             tt-rev-day.rest_start_book    = start-date-rvs-line.system-qnty
     1929           .
     1930         end.
     1931         if available end-date-rvs-line then do:
     1932           assign
     1933             tt-rev-day.rest_end_measure   = end-date-rvs-line.state-measure-qnty + end-date-rvs-line.state-add-qnty
     1934             tt-rev-day.rest_end_book      = end-date-rvs-line.system-qnty
     1935             tt-rev-day.rest_end_balans    = tt-rev-day.rest_end_measure - tt-rev-day.rest_end_book
     1936           .
     1937         end.
     1938       end.
     1939     end.
     1940     assign
     1941       tt-rev-day.goods-name           = buf_goods.gds-name
     1942       tt-rev-day.wayb                 = tt-rev-day.wayb                + varwayb
     1943       tt-rev-day.wayb_measure         = tt-rev-day.wayb_measure        + varwayb_measure
     1944       tt-rev-day.wayb_fact            = tt-rev-day.wayb_fact           + varwayb_fact
     1945       tt-rev-day.wayb_difference      = tt-rev-day.wayb_difference     + varwayb_difference
     1946       tt-rev-day.exp_kass             = tt-rev-day.exp_kass            + varexp_kass
     1947       tt-rev-day.write-off            = tt-rev-day.write-off           + varwrite-off
     1948       tt-rev-day.invent               = tt-rev-day.invent              + varinvent
     1949       tt-rev-day.exp_gross            = tt-rev-day.exp_gross           + varexp_gross
     1950       tt-rev-day.ret_supp             = tt-rev-day.ret_supp            + varret_supp
     1951       tt-rev-day.another              = tt-rev-day.another             + varanother
     1952     .
     1953   end.
     1954   if last-of(buf_trn-doc.shift-date) then do:
     1955     if p-tog-with-tot-day = true
     1956       and p-tog-shift = false
     1957     then do:
     1958       assign
     1959         vardate-shift = "За сутки"
     1960       .
     1961       display stream prnlibstream
     1962         vardate-shift
     1963         with frame doc-line-frm.
     1964       if Make-Excel then  put   stream ForExcel unformatted
     1965       vardate-shift
     1966       .
     1967     end.
     1968     for each tt-rev-day
     1969       where tt-rev-day.shift-date = buf_trn-doc.shift-date
     1970     :
     1971       if p-tog-with-tot-day = true
     1972         and p-tog-shift = false
     1973       then do:
     1974         display stream prnlibstream
     1975           sym01
     1976           sym02 tt-rev-day.pl-code            @ varpl-code
     1977           sym03 tt-rev-day.goods-name         @ vargoods-name
     1978           sym04 tt-rev-day.rest_start_measure @ varrest_start_measure
     1979           sym05 tt-rev-day.rest_start_book    @ varrest_start_book
     1980           sym06 tt-rev-day.wayb               @ varwayb
     1981           sym07 tt-rev-day.wayb_measure       @ varwayb_measure
     1982           sym08 tt-rev-day.wayb_fact          @ varwayb_fact
     1983           sym09 tt-rev-day.wayb_difference    @ varwayb_difference
     1984           sym10 tt-rev-day.exp_kass           @ varexp_kass
     1985           sym11 tt-rev-day.write-off          @ varwrite-off
     1986           sym12 tt-rev-day.invent             @ varinvent
     1987           sym13 tt-rev-day.exp_gross          @ varexp_gross
     1988           sym14 tt-rev-day.ret_supp           @ varret_supp
     1989           sym15 tt-rev-day.another            @ varanother
     1990           sym16 tt-rev-day.rest_end_measure   @ varrest_end_measure
     1991           sym17 tt-rev-day.rest_end_book      @ varrest_end_book
     1992           sym18 tt-rev-day.rest_end_balans    @ varrest_end_balans
     1993           sym19
     1994         with frame doc-line-frm.
     1995         down stream prnlibstream with frame doc-line-frm.
     1996         if Make-Excel then  put   stream ForExcel unformatted
     1997         CHR(9)
     1998         tt-rev-day.pl-code            CHR(9)
     1999         tt-rev-day.goods-name         CHR(9)
     2000         tt-rev-day.rest_start_measure CHR(9)
     2001         tt-rev-day.rest_start_book    CHR(9)
     2002         tt-rev-day.wayb               CHR(9)
     2003         tt-rev-day.wayb_measure       CHR(9)
     2004         tt-rev-day.wayb_fact          CHR(9)
     2005         tt-rev-day.wayb_difference    CHR(9)
     2006         tt-rev-day.exp_kass           CHR(9)
     2007         tt-rev-day.write-off          CHR(9)
     2008         tt-rev-day.invent             CHR(9)
     2009         tt-rev-day.exp_gross          CHR(9)
     2010         tt-rev-day.ret_supp           CHR(9)
     2011         tt-rev-day.another            CHR(9)
     2012         tt-rev-day.rest_end_measure   CHR(9)
     2013         tt-rev-day.rest_end_book      CHR(9)
     2014         tt-rev-day.rest_end_balans    chr(10)
     2015         .
     2016       end.
     2017       find first tt-rev-gds
     2018         where tt-rev-gds.pl-code  = tt-rev-day.pl-code
     2019           and tt-rev-gds.gds-code = tt-rev-day.gds-code
     2020         no-error .
     2021       if not available tt-rev-gds then do:
     2022         create tt-rev-gds.
     2023         buffer-copy tt-rev-day to tt-rev-gds.
     2024       end.
     2025       else do:
     2026         assign
     2027           tt-rev-gds.wayb               =  tt-rev-gds.wayb               +  tt-rev-day.wayb
     2028           tt-rev-gds.wayb_measure       =  tt-rev-gds.wayb_measure       +  tt-rev-day.wayb_measure
     2029           tt-rev-gds.wayb_fact          =  tt-rev-gds.wayb_fact          +  tt-rev-day.wayb_fact
     2030           tt-rev-gds.wayb_difference    =  tt-rev-gds.wayb_difference    +  tt-rev-day.wayb_difference
     2031           tt-rev-gds.exp_kass           =  tt-rev-gds.exp_kass           +  tt-rev-day.exp_kass
     2032           tt-rev-gds.write-off          =  tt-rev-gds.write-off          +  tt-rev-day.write-off
     2033           tt-rev-gds.invent             =  tt-rev-gds.invent             +  tt-rev-day.invent
     2034           tt-rev-gds.exp_gross          =  tt-rev-gds.exp_gross          +  tt-rev-day.exp_gross
     2035           tt-rev-gds.ret_supp           =  tt-rev-gds.ret_supp           +  tt-rev-day.ret_supp
     2036           tt-rev-gds.another            =  tt-rev-gds.another            +  tt-rev-day.another
     2037           tt-rev-gds.rest_end_measure   =  tt-rev-day.rest_end_measure
     2038           tt-rev-gds.rest_end_book      =  tt-rev-day.rest_end_book
     2039           tt-rev-gds.rest_end_balans    =  tt-rev-day.rest_end_balans
     2040         .
     2041       end.
     2042     end.
     2043   end.
     2044                        end.
     2045       END.
     2046       WHEN 3 THEN DO:
     2047                 for each buf_trn-doc where                             buf_trn-doc.obj-type    = parobj-type and                             buf_trn-doc.obj-code    = parobj-code and                             ( buf_trn-doc.shift-date >  parstart_date        or                                buf_trn-doc.shift-date  = parstart_date        and                               buf_trn-doc.shift-num  >= parstart_shift_num ) and                             ( buf_trn-doc.shift-date <  parend_date          or                                buf_trn-doc.shift-date  = parend_date          and                               buf_trn-doc.shift-num  <= parend_shift_num )   and                             buf_trn-doc.status_     = 'факт':U                              ,                              each gds-list, first buf_goods where buf_goods.artic      = gds-list.artic  and buf_goods.prod-type  = gds-list.prod-type and buf_goods.prod-code  = gds-list.prod-code no-lock,                         each buf_doc-line no-lock where                             buf_doc-line.doc-code   = buf_trn-doc.doc-code     and                             buf_doc-line.artic      = buf_goods.artic     and                             buf_doc-line.prod-type  = buf_goods.prod-type and                             buf_doc-line.prod-code  = buf_goods.prod-code                             , each buf_doc-pl where buf_doc-pl.out-code = buf_trn-doc.doc-code and buf_doc-pl.gds-code = buf_goods.gds-code and buf_doc-pl.obj-type = buf_trn-doc.obj-type and buf_doc-pl.obj-code = buf_trn-doc.obj-code                      BREAK BY buf_trn-doc.shift-date BY buf_trn-doc.shift-num BY buf_doc-pl.pl-code BY buf_doc-pl.gds-code  :
     2048   if first-of (buf_trn-doc.shift-num) then do:
     2049     find first bef-rvs-doc no-lock
     2050       where bef-rvs-doc.obj-type   = parobj-type
     2051         and bef-rvs-doc.obj-code    = parobj-code
     2052         and ( (bef-rvs-doc.shift-date = buf_trn-doc.shift-date
     2053                and bef-rvs-doc.shift-num  <  buf_trn-doc.shift-num
     2054               )
     2055               or bef-rvs-doc.shift-date <  buf_trn-doc.shift-date
     2056             )
     2057         and bef-rvs-doc.status_     = 'факт':U
     2058         and bef-rvs-doc.rvs-type    = 'смена':U
     2059       no-error.
     2060     assign
     2061       bef-rvs-doc-rec = (if available bef-rvs-doc then recid(bef-rvs-doc) else ?)
     2062     .
     2063     find first buf_rvs-doc no-lock
     2064       where buf_rvs-doc.obj-type    = parobj-type
     2065         and buf_rvs-doc.obj-code    = parobj-code
     2066         and buf_rvs-doc.shift-date  = buf_trn-doc.shift-date
     2067         and buf_rvs-doc.shift-num   = buf_trn-doc.shift-num
     2068         and buf_rvs-doc.status_     = 'факт':U
     2069         and buf_rvs-doc.rvs-type    = 'смена':U
     2070       no-error.
     2071     assign
     2072       rvs-doc-rec = (if available buf_rvs-doc then recid(buf_rvs-doc) else ?)
     2073     .
     2074     assign
     2075       vardate-shift = string(buf_trn-doc.shift-name,"x(2)") + " " + string(buf_trn-doc.shift-date, "99/99/99")
     2076     .
     2077     display stream prnlibstream
     2078       sym01 vardate-shift
     2079       with frame doc-line-frm.
     2080     if Make-Excel then  put   stream ForExcel unformatted
     2081     vardate-shift
     2082     .
     2083   end.
     2084   if first-of (buf_trn-doc.shift-date) then do:
     2085     if p-tog-shift = true then do:
     2086       find first start-date-rvs-doc no-lock
     2087         where start-date-rvs-doc.obj-type         = parobj-type
     2088           and start-date-rvs-doc.obj-code         = parobj-code
     2089           and ( (start-date-rvs-doc.shift-date    = buf_trn-doc.shift-date
     2090                 and start-date-rvs-doc.shift-num  <  buf_trn-doc.shift-num
     2091                 )
     2092                 or start-date-rvs-doc.shift-date  <  buf_trn-doc.shift-date
     2093               )
     2094           and start-date-rvs-doc.status_          = 'факт':U
     2095           and start-date-rvs-doc.rvs-type         = 'смена':U
     2096         no-error.
     2097     end.
     2098     else do:
     2099       find first start-date-rvs-doc no-lock
     2100         where start-date-rvs-doc.obj-type   = parobj-type
     2101           and start-date-rvs-doc.obj-code   = parobj-code
     2102           and start-date-rvs-doc.shift-date < buf_trn-doc.shift-date
     2103           and start-date-rvs-doc.status_    = 'факт':U
     2104           and start-date-rvs-doc.rvs-type   = 'смена':U
     2105         no-error.
     2106     end.
     2107     assign start-date-rvs-doc-rec = (if available start-date-rvs-doc then recid(start-date-rvs-doc) else ?).
     2108     find first end-date-rvs-doc no-lock
     2109       where end-date-rvs-doc.obj-type     = parobj-type
     2110         and end-date-rvs-doc.obj-code     = parobj-code
     2111         and end-date-rvs-doc.shift-date   = buf_trn-doc.shift-date
     2112         and end-date-rvs-doc.status_      = 'факт':U
     2113         and end-date-rvs-doc.rvs-type     = 'смена':U
     2114       no-error.
     2115     assign end-date-rvs-doc-rec = (if available end-date-rvs-doc then recid(end-date-rvs-doc) else ?).
     2116   end.
     2117   if first-of(buf_doc-pl.gds-code) then do:
     2118     assign
     2119       varrest_start_measure   = 0
     2120       varrest_start_book      = 0
     2121       varwayb                 = 0
     2122       varwayb_measure         = 0
     2123       varwayb_fact            = 0
     2124       varwayb_difference      = 0
     2125       varexp_kass             = 0
     2126       varwrite-off            = 0
     2127       varinvent               = 0
     2128       varexp_gross            = 0
     2129       varret_supp             = 0
     2130       varanother              = 0
     2131       varrest_end_measure     = 0
     2132       varrest_end_book        = 0
     2133       varrest_end_balans      = 0
     2134     .
     2135     if bef-rvs-doc-rec <> ? then do:
     2136       find first bef-rvs-doc no-lock
     2137         where recid(bef-rvs-doc) = bef-rvs-doc-rec
     2138         no-error.
     2139       find first bef-rvs-line no-lock
     2140         where bef-rvs-line.rvs-code = bef-rvs-doc.rvs-code
     2141           and bef-rvs-line.obj-type = bef-rvs-doc.obj-type
     2142           and bef-rvs-line.obj-code = bef-rvs-doc.obj-code
     2143           and bef-rvs-line.pl-code  = buf_doc-pl.pl-code
     2144           and bef-rvs-line.gds-code = buf_doc-pl.gds-code
     2145         no-error.
     2146     end.
     2147     if rvs-doc-rec <> ? then do:
     2148     find first buf_rvs-doc no-lock
     2149       where recid(buf_rvs-doc) = rvs-doc-rec
     2150       .
     2151     find first buf_rvs-line no-lock
     2152       where buf_rvs-line.rvs-code = buf_rvs-doc.rvs-code
     2153         and buf_rvs-line.obj-type = buf_rvs-doc.obj-type
     2154         and buf_rvs-line.obj-code = buf_rvs-doc.obj-code
     2155         and buf_rvs-line.pl-code  = buf_doc-pl.pl-code
     2156         and buf_rvs-line.gds-code = buf_doc-pl.gds-code
     2157       no-error.
     2158     end.
     2159     assign
     2160       varrest_start_measure = ?
     2161       varrest_start_book    = ?
     2162       varrest_end_measure   = ?
     2163       varrest_end_book      = ?
     2164       varrest_end_balans    = ?
     2165     .
     2166     if p-tog-weight = true then do:
     2167       if available bef-rvs-line then do:
     2168         assign
     2169           varrest_start_measure = bef-rvs-line.state-measure-cli-qnty + bef-rvs-line.state-add-qnty * bef-rvs-line.state-density
     2170           varrest_start_book    = bef-rvs-line.system-cli-qnty
     2171         .
     2172       end.
     2173       if available buf_rvs-line then do:
     2174         assign
     2175           varrest_end_measure   = buf_rvs-line.state-measure-cli-qnty + buf_rvs-line.state-add-qnty * buf_rvs-line.state-density
     2176           varrest_end_book      = buf_rvs-line.system-cli-qnty
     2177           varrest_end_balans    = varrest_end_measure - varrest_end_book
     2178         .
     2179       end.
     2180     end.
     2181     else do:
     2182       if available bef-rvs-line then do:
     2183         assign
     2184           varrest_start_measure = bef-rvs-line.state-measure-qnty + bef-rvs-line.state-add-qnty
     2185           varrest_start_book    = bef-rvs-line.system-qnty
     2186         .
     2187       end.
     2188       if available buf_rvs-line then do:
     2189         assign
     2190           varrest_end_measure   = buf_rvs-line.state-measure-qnty + buf_rvs-line.state-add-qnty
     2191           varrest_end_book      = buf_rvs-line.system-qnty
     2192           varrest_end_balans    = varrest_end_measure - varrest_end_book
     2193         .
     2194       end.
     2195     end.
     2196   end.
     2197   assign
     2198     varrev = (if p-tog-weight = true then buf_doc-pl.cli-fact-qnty else buf_doc-pl.fact-qnty)
     2199   .
     2200   case buf_trn-doc.doc-type:
     2201     when 'при':U then do:
     2202       if not buf_trn-doc.internal then do:
     2203         assign
     2204           varwayb      = varwayb      + (if p-tog-weight = true then buf_doc-pl.cli-doc-qnty  else buf_doc-pl.doc-qnty )
     2205           varwayb_fact = varwayb_fact + varrev
     2206         .
     2207         find first bef-doc-rvs-doc no-lock
     2208           where bef-doc-rvs-doc.out-code = buf_trn-doc.doc-code
     2209             and bef-doc-rvs-doc.rvs-type = 'перед_док':U
     2210           no-error.
     2211         find first aft-doc-rvs-doc no-lock
     2212           where aft-doc-rvs-doc.out-code = buf_trn-doc.doc-code
     2213             and aft-doc-rvs-doc.rvs-type = 'после_док':U
     2214           no-error.
     2215         if available bef-doc-rvs-doc
     2216           and available aft-doc-rvs-doc
     2217         then do:
     2218           find first bef-doc-rvs-line no-lock
     2219             where bef-doc-rvs-line.rvs-code = bef-doc-rvs-doc.rvs-code
     2220               and bef-doc-rvs-line.obj-type = bef-doc-rvs-doc.obj-type
     2221               and bef-doc-rvs-line.obj-code = bef-doc-rvs-doc.obj-code
     2222               and bef-doc-rvs-line.pl-code  = buf_doc-pl.pl-code
     2223               and bef-doc-rvs-line.gds-code = buf_doc-pl.gds-code
     2224               no-error .
     2225           find first aft-doc-rvs-line no-lock
     2226             where aft-doc-rvs-line.rvs-code = aft-doc-rvs-doc.rvs-code
     2227               and aft-doc-rvs-line.obj-type = aft-doc-rvs-doc.obj-type
     2228               and aft-doc-rvs-line.obj-code = aft-doc-rvs-doc.obj-code
     2229               and aft-doc-rvs-line.pl-code  = buf_doc-pl.pl-code
     2230               and aft-doc-rvs-line.gds-code = buf_doc-pl.gds-code
     2231               no-error .
     2232         if available bef-doc-rvs-line   and available aft-doc-rvs-line
     2233         then do:
     2234           assign
     2235             varwayb_measure    = varwayb_measure + (if p-tog-weight = true then aft-doc-rvs-line.measure-cli-qnty - bef-doc-rvs-line.measure-cli-qnty else aft-doc-rvs-line.measure-qnty - bef-doc-rvs-line.measure-qnty)
     2236             varwayb_difference = varwayb - varwayb_measure
     2237           .
     2238          end.
     2239         end.
     2240       end.
     2241       else do:
     2242         assign
     2243           varanother = varanother + varrev
     2244         .
     2245       end.
     2246     end.
     2247     when 'рас':U then do:
     2248       if not buf_trn-doc.internal then do:
     2249         if buf_trn-doc.discnt-type = 'касс':U then do:
     2250           assign
     2251             varexp_kass = varexp_kass + varrev
     2252           .
     2253         end.
     2254         else do:
     2255           if buf_trn-doc.ext-doc-type = 'ep':U then do:
     2256             assign
     2257               varret_supp  = varret_supp + varrev
     2258             .
     2259           end.
     2260           else do:
     2261             assign
     2262               varexp_gross = varexp_gross + varrev
     2263             .
     2264           end.
     2265           end.
     2266         end.
     2267       else do:
     2268         assign
     2269           varanother = varanother + varrev
     2270         .
     2271       end.
     2272     end.
     2273     when 'возврат':U then do:
     2274       if not buf_trn-doc.internal then do:
     2275         if buf_trn-doc.discnt-type = 'касс':U then do:
     2276           assign
     2277             varexp_kass = varexp_kass - varrev
     2278           .
     2279         end.
     2280         else do:
     2281           if buf_trn-doc.ext-doc-type = 'ep':U then do:
     2282             assign
     2283               varret_supp = varret_supp - varrev
     2284             .
     2285           end.
     2286           else do:
     2287             assign
     2288               varexp_gross = varexp_gross - varrev
     2289             .
     2290           end.
     2291           end.
     2292         end.
     2293       else do:
     2294         assign
     2295           varanother = varanother - varrev
     2296         .
     2297       end.
     2298     end.
     2299     when 'спи':U then do:
     2300       assign
     2301         varwrite-off = varwrite-off + varrev
     2302       .
     2303     end.
     2304     when 'инв':U then do:
     2305       assign
     2306         varinvent = varinvent + varrev
     2307       .
     2308     end.
     2309     otherwise do:
     2310       assign
     2311         varanother = varanother + varrev
     2312       .
     2313     end.
     2314   end case.
     2315   if last-of(buf_doc-pl.gds-code) then do:
     2316     assign
     2317       vargoods-name = buf_goods.gds-name
     2318       varpl-code    = buf_doc-pl.pl-code
     2319     .
     2320     display stream prnlibstream
     2321       sym01
     2322       sym02 varpl-code
     2323       sym03 vargoods-name
     2324       sym04 varrest_start_measure
     2325       sym05 varrest_start_book format "->>>>>>>9.<<<"
     2326       sym06 varwayb
     2327       sym07 varwayb_measure
     2328       sym08 varwayb_fact
     2329       sym09 varwayb_difference
     2330       sym10 varexp_kass
     2331       sym11 varwrite-off
     2332       sym12 varinvent
     2333       sym13 varexp_gross
     2334       sym14 varret_supp
     2335       sym15 varanother
     2336       sym16 varrest_end_measure
     2337       sym17 varrest_end_book format "->>>>>>>>9.<<<"
     2338       sym18 varrest_end_balans
     2339       sym19
     2340      with frame doc-line-frm.
     2341      down stream prnlibstream with frame doc-line-frm.
     2342     if Make-Excel then  put   stream ForExcel unformatted
     2343     CHR(9)
     2344     varpl-code            CHR(9)
     2345     vargoods-name         CHR(9)
     2346     varrest_start_measure CHR(9)
     2347     varrest_start_book    CHR(9)
     2348     varwayb               CHR(9)
     2349     varwayb_measure       CHR(9)
     2350     varwayb_fact          CHR(9)
     2351     varwayb_difference    CHR(9)
     2352     varexp_kass           CHR(9)
     2353     varwrite-off          CHR(9)
     2354     varinvent             CHR(9)
     2355     varexp_gross          CHR(9)
     2356     varret_supp           CHR(9)
     2357     varanother            CHR(9)
     2358     varrest_end_measure   CHR(9)
     2359     varrest_end_book      CHR(9)
     2360     varrest_end_balans    chr(10)
     2361     .
     2362     find first tt-rev-day
     2363       where tt-rev-day.shift-date = buf_trn-doc.shift-date
     2364         and tt-rev-day.pl-code    = buf_doc-pl.pl-code
     2365         and tt-rev-day.gds-code   = buf_doc-pl.gds-code
     2366       no-error.
     2367     if not available tt-rev-day then do:
     2368       create tt-rev-day.
     2369       assign
     2370         tt-rev-day.shift-date = buf_trn-doc.shift-date
     2371         tt-rev-day.pl-code    = buf_doc-pl.pl-code
     2372         tt-rev-day.gds-code   = buf_doc-pl.gds-code
     2373       .
     2374       if start-date-rvs-doc-rec <> ? then do:
     2375         find first start-date-rvs-doc no-lock
     2376           where recid(start-date-rvs-doc) = start-date-rvs-doc-rec.
     2377         find first start-date-rvs-line no-lock
     2378           where start-date-rvs-line.rvs-code = start-date-rvs-doc.rvs-code
     2379             and start-date-rvs-line.obj-type = start-date-rvs-doc.obj-type
     2380             and start-date-rvs-line.obj-code = start-date-rvs-doc.obj-code
     2381             and start-date-rvs-line.pl-code  = buf_doc-pl.pl-code
     2382             and start-date-rvs-line.gds-code = buf_doc-pl.gds-code
     2383           no-error.
     2384       end.
     2385       if end-date-rvs-doc-rec <> ? then do:
     2386         find first end-date-rvs-doc no-lock
     2387           where recid(end-date-rvs-doc) = end-date-rvs-doc-rec
     2388           .
     2389         find first end-date-rvs-line no-lock
     2390           where end-date-rvs-line.rvs-code = end-date-rvs-doc.rvs-code
     2391             and end-date-rvs-line.obj-type = end-date-rvs-doc.obj-type
     2392             and end-date-rvs-line.obj-code = end-date-rvs-doc.obj-code
     2393             and end-date-rvs-line.pl-code  = buf_doc-pl.pl-code
     2394             and end-date-rvs-line.gds-code = buf_doc-pl.gds-code
     2395           no-error.
     2396       end.
     2397       assign
     2398         tt-rev-day.rest_start_measure = ?
     2399         tt-rev-day.rest_start_book    = ?
     2400         tt-rev-day.rest_end_measure   = ?
     2401         tt-rev-day.rest_end_book      = ?
     2402         tt-rev-day.rest_end_balans    = ?
     2403       .
     2404       if p-tog-weight = true then do:
     2405         if available start-date-rvs-line then do:
     2406           assign
     2407             tt-rev-day.rest_start_measure = start-date-rvs-line.state-measure-cli-qnty + start-date-rvs-line.state-add-qnty * start-date-rvs-line.state-density
     2408             tt-rev-day.rest_start_book    = start-date-rvs-line.system-cli-qnty
     2409           .
     2410         end.
     2411         if available end-date-rvs-line then do:
     2412           assign
     2413             tt-rev-day.rest_end_measure   = end-date-rvs-line.state-measure-cli-qnty + end-date-rvs-line.state-add-qnty * end-date-rvs-line.state-density
     2414             tt-rev-day.rest_end_book      = end-date-rvs-line.system-cli-qnty
     2415             tt-rev-day.rest_end_balans    = varrest_end_measure - varrest_end_book
     2416           .
     2417         end.
     2418       end.
     2419       else do:
     2420         if available start-date-rvs-line then do:
     2421           assign
     2422             tt-rev-day.rest_start_measure = start-date-rvs-line.state-measure-qnty + start-date-rvs-line.state-add-qnty
     2423             tt-rev-day.rest_start_book    = start-date-rvs-line.system-qnty
     2424           .
     2425         end.
     2426         if available end-date-rvs-line then do:
     2427           assign
     2428             tt-rev-day.rest_end_measure   = end-date-rvs-line.state-measure-qnty + end-date-rvs-line.state-add-qnty
     2429             tt-rev-day.rest_end_book      = end-date-rvs-line.system-qnty
     2430             tt-rev-day.rest_end_balans    = tt-rev-day.rest_end_measure - tt-rev-day.rest_end_book
     2431           .
     2432         end.
     2433       end.
     2434     end.
     2435     assign
     2436       tt-rev-day.goods-name           = buf_goods.gds-name
     2437       tt-rev-day.wayb                 = tt-rev-day.wayb                + varwayb
     2438       tt-rev-day.wayb_measure         = tt-rev-day.wayb_measure        + varwayb_measure
     2439       tt-rev-day.wayb_fact            = tt-rev-day.wayb_fact           + varwayb_fact
     2440       tt-rev-day.wayb_difference      = tt-rev-day.wayb_difference     + varwayb_difference
     2441       tt-rev-day.exp_kass             = tt-rev-day.exp_kass            + varexp_kass
     2442       tt-rev-day.write-off            = tt-rev-day.write-off           + varwrite-off
     2443       tt-rev-day.invent               = tt-rev-day.invent              + varinvent
     2444       tt-rev-day.exp_gross            = tt-rev-day.exp_gross           + varexp_gross
     2445       tt-rev-day.ret_supp             = tt-rev-day.ret_supp            + varret_supp
     2446       tt-rev-day.another              = tt-rev-day.another             + varanother
     2447     .
     2448   end.
     2449   if last-of(buf_trn-doc.shift-date) then do:
     2450     if p-tog-with-tot-day = true
     2451       and p-tog-shift = false
     2452     then do:
     2453       assign
     2454         vardate-shift = "За сутки"
     2455       .
     2456       display stream prnlibstream
     2457         vardate-shift
     2458         with frame doc-line-frm.
     2459       if Make-Excel then  put   stream ForExcel unformatted
     2460       vardate-shift
     2461       .
     2462     end.
     2463     for each tt-rev-day
     2464       where tt-rev-day.shift-date = buf_trn-doc.shift-date
     2465     :
     2466       if p-tog-with-tot-day = true
     2467         and p-tog-shift = false
     2468       then do:
     2469         display stream prnlibstream
     2470           sym01
     2471           sym02 tt-rev-day.pl-code            @ varpl-code
     2472           sym03 tt-rev-day.goods-name         @ vargoods-name
     2473           sym04 tt-rev-day.rest_start_measure @ varrest_start_measure
     2474           sym05 tt-rev-day.rest_start_book    @ varrest_start_book
     2475           sym06 tt-rev-day.wayb               @ varwayb
     2476           sym07 tt-rev-day.wayb_measure       @ varwayb_measure
     2477           sym08 tt-rev-day.wayb_fact          @ varwayb_fact
     2478           sym09 tt-rev-day.wayb_difference    @ varwayb_difference
     2479           sym10 tt-rev-day.exp_kass           @ varexp_kass
     2480           sym11 tt-rev-day.write-off          @ varwrite-off
     2481           sym12 tt-rev-day.invent             @ varinvent
     2482           sym13 tt-rev-day.exp_gross          @ varexp_gross
     2483           sym14 tt-rev-day.ret_supp           @ varret_supp
     2484           sym15 tt-rev-day.another            @ varanother
     2485           sym16 tt-rev-day.rest_end_measure   @ varrest_end_measure
     2486           sym17 tt-rev-day.rest_end_book      @ varrest_end_book
     2487           sym18 tt-rev-day.rest_end_balans    @ varrest_end_balans
     2488           sym19
     2489         with frame doc-line-frm.
     2490         down stream prnlibstream with frame doc-line-frm.
     2491         if Make-Excel then  put   stream ForExcel unformatted
     2492         CHR(9)
     2493         tt-rev-day.pl-code            CHR(9)
     2494         tt-rev-day.goods-name         CHR(9)
     2495         tt-rev-day.rest_start_measure CHR(9)
     2496         tt-rev-day.rest_start_book    CHR(9)
     2497         tt-rev-day.wayb               CHR(9)
     2498         tt-rev-day.wayb_measure       CHR(9)
     2499         tt-rev-day.wayb_fact          CHR(9)
     2500         tt-rev-day.wayb_difference    CHR(9)
     2501         tt-rev-day.exp_kass           CHR(9)
     2502         tt-rev-day.write-off          CHR(9)
     2503         tt-rev-day.invent             CHR(9)
     2504         tt-rev-day.exp_gross          CHR(9)
     2505         tt-rev-day.ret_supp           CHR(9)
     2506         tt-rev-day.another            CHR(9)
     2507         tt-rev-day.rest_end_measure   CHR(9)
     2508         tt-rev-day.rest_end_book      CHR(9)
     2509         tt-rev-day.rest_end_balans    chr(10)
     2510         .
     2511       end.
     2512       find first tt-rev-gds
     2513         where tt-rev-gds.pl-code  = tt-rev-day.pl-code
     2514           and tt-rev-gds.gds-code = tt-rev-day.gds-code
     2515         no-error .
     2516       if not available tt-rev-gds then do:
     2517         create tt-rev-gds.
     2518         buffer-copy tt-rev-day to tt-rev-gds.
     2519       end.
     2520       else do:
     2521         assign
     2522           tt-rev-gds.wayb               =  tt-rev-gds.wayb               +  tt-rev-day.wayb
     2523           tt-rev-gds.wayb_measure       =  tt-rev-gds.wayb_measure       +  tt-rev-day.wayb_measure
     2524           tt-rev-gds.wayb_fact          =  tt-rev-gds.wayb_fact          +  tt-rev-day.wayb_fact
     2525           tt-rev-gds.wayb_difference    =  tt-rev-gds.wayb_difference    +  tt-rev-day.wayb_difference
     2526           tt-rev-gds.exp_kass           =  tt-rev-gds.exp_kass           +  tt-rev-day.exp_kass
     2527           tt-rev-gds.write-off          =  tt-rev-gds.write-off          +  tt-rev-day.write-off
     2528           tt-rev-gds.invent             =  tt-rev-gds.invent             +  tt-rev-day.invent
     2529           tt-rev-gds.exp_gross          =  tt-rev-gds.exp_gross          +  tt-rev-day.exp_gross
     2530           tt-rev-gds.ret_supp           =  tt-rev-gds.ret_supp           +  tt-rev-day.ret_supp
     2531           tt-rev-gds.another            =  tt-rev-gds.another            +  tt-rev-day.another
     2532           tt-rev-gds.rest_end_measure   =  tt-rev-day.rest_end_measure
     2533           tt-rev-gds.rest_end_book      =  tt-rev-day.rest_end_book
     2534           tt-rev-gds.rest_end_balans    =  tt-rev-day.rest_end_balans
     2535         .
     2536       end.
     2537     end.
     2538   end.
     2539                        end.
     2540       END.
     2541   END CASE.
     2542   put stream PrnLibStream
     2543     v-line  skip
     2544     .
     2545   hide stream PrnLibStream frame bottomframe .
     2546   assign
     2547     v-count = 4
     2548   .
     2549   for each  tt-rev-gds :
     2550     assign
     2551       v-count = v-count + 1
     2552     .
     2553   end.
     2554   if line-counter( PrnLibstream ) + v-count > page-size( PrnLibstream ) then do:
     2555     page stream PrnLibstream .
     2556   end.
     2557   assign
     2558     vardate-shift = "За период"
     2559   .
     2560   display stream PrnLibStream
     2561     vardate-shift
     2562     with frame doc-line-frm.
     2563   if Make-Excel then  put   stream ForExcel unformatted
     2564   vardate-shift
     2565   .
     2566   for each  tt-rev-gds :
     2567     display stream PrnLibStream
     2568       sym01
     2569       sym02 tt-rev-gds.pl-code            @ varpl-code
     2570       sym03 tt-rev-gds.goods-name         @ vargoods-name
     2571       sym04 tt-rev-gds.rest_start_measure @ varrest_start_measure
     2572       sym05 tt-rev-gds.rest_start_book    @ varrest_start_book
     2573       sym06 tt-rev-gds.wayb               @ varwayb
     2574       sym07 tt-rev-gds.wayb_measure       @ varwayb_measure
     2575       sym08 tt-rev-gds.wayb_fact          @ varwayb_fact
     2576       sym09 tt-rev-gds.wayb_difference    @ varwayb_difference
     2577       sym10 tt-rev-gds.exp_kass           @ varexp_kass
     2578       sym11 tt-rev-gds.write-off          @ varwrite-off
     2579       sym12 tt-rev-gds.invent             @ varinvent
     2580       sym13 tt-rev-gds.exp_gross          @ varexp_gross
     2581       sym14 tt-rev-gds.ret_supp           @ varret_supp
     2582       sym15 tt-rev-gds.another            @ varanother
     2583       sym16 tt-rev-gds.rest_end_measure   @ varrest_end_measure
     2584       sym17 tt-rev-gds.rest_end_book      @ varrest_end_book
     2585       sym18 tt-rev-gds.rest_end_balans    @ varrest_end_balans
     2586       sym19
     2587       with frame doc-line-frm.
     2588     down stream PrnLibStream with frame doc-line-frm.
     2589     if Make-Excel then  put   stream ForExcel unformatted
     2590     CHR(9)
     2591     tt-rev-gds.pl-code            CHR(9)
     2592     tt-rev-gds.goods-name         CHR(9)
     2593     tt-rev-gds.rest_start_measure CHR(9)
     2594     tt-rev-gds.rest_start_book    CHR(9)
     2595     tt-rev-gds.wayb               CHR(9)
     2596     tt-rev-gds.wayb_measure       CHR(9)
     2597     tt-rev-gds.wayb_fact          CHR(9)
     2598     tt-rev-gds.wayb_difference    CHR(9)
     2599     tt-rev-gds.exp_kass           CHR(9)
     2600     tt-rev-gds.write-off          CHR(9)
     2601     tt-rev-gds.invent             CHR(9)
     2602     tt-rev-gds.exp_gross          CHR(9)
     2603     tt-rev-gds.ret_supp           CHR(9)
     2604     tt-rev-gds.another            CHR(9)
     2605     tt-rev-gds.rest_end_measure   CHR(9)
     2606     tt-rev-gds.rest_end_book      CHR(9)
     2607     tt-rev-gds.rest_end_balans    chr(10)
     2608     .
     2609   end.
     2610   put stream PrnLibStream
     2611     v-line  skip
     2612     .
     2613   hide frame input-frm .
     2614   put stream PrnLibStream
     2615     skip(2)
     2616     .
     2617   put stream PrnLibStream unformatted
     2618     "   Управляющий АЗС___________________________"
     2619     .
     2620   output stream PrnLibStream close.
     2621   run waitfram-hide in this-procedure .
     2622   if Make-Excel then output stream ForExcel close.
     2623   run prn-lib-prn-file in this-procedure
     2624     ( input parParentProc
     2625     , input 8
     2626     ).
