      996   define variable v-waitfram-action01         as character   no-undo .
      997   define variable v-waitfram-action02         as character   no-undo .
      998   define variable v-waitfram-action03         as character   no-undo .
      999   define variable mWaitFramTextBeg            as character   no-undo.
     1000   define variable mWaitFramTextEnd            as character   no-undo.
     1001   define variable mWaitFramView               as logical     no-undo.
     1002   define variable mWaitProcEvent              as logical     no-undo init yes.
     1003   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1004   define variable mWaitFramStop               as logical     no-undo.
     1005   define variable mWaitFramStopUser           as logical     no-undo.
     1006   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1007   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1008   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1009   define button B-WaitFramStop auto-end-key
     1010        label "Стоп"
     1011        size 10 by 1 tooltip "Остоновить процесс".
     1012   define button B-viewProcInfo
     1013        label "Информация"
     1014        size 15 by 1 tooltip "Информация о процесс".
     1015   define frame waitfram
     1016     v-waitfram-action01 format "x(72)" no-label skip
     1017     v-waitfram-action02 format "x(72)" no-label skip
     1018     v-waitfram-action03 format "x(72)" no-label skip
     1019     B-viewProcInfo
     1020     B-WaitFramStop at row 4 col 30
     1021     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1022     .
     1023   define new global shared variable mBatchMode as logical no-undo init ?.
     1024   define variable mFramBachModHandle as handle no-undo.
     1025   mFramBachModHandle = frame waitfram:handle.
     1026   define variable mFameOldVis as logical no-undo.
     1027   define variable mVisCUrentVin as logical no-undo.
     1028   if session:batch-mode
     1029   then
     1030      mBatchMode = yes.
     1031   if mBatchMode = ? then do:
     1032     mVisCUrentVin = current-window:visible.
     1033     mFameOldVis = mFramBachModHandle:visible.
     1034     mFramBachModHandle:visible  = yes.
     1035     mBatchMode = mFramBachModHandle:visible ne yes.
     1036     mFramBachModHandle:visible = mFameOldVis.
     1037     current-window:visible = mVisCUrentVin.
     1038   end.
     1039    if  log-manager:logfile-name ne ?
     1040     then DO:
     1041         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1042         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1043         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1044     end.
     1045   on choose of B-WaitFramStop in frame waitfram
     1046   do:
     1047     mWaitFramStop = yes.
     1048     mWaitFramStopUser = yes.
     1049   end.
     1050   function waitfram-check-timeout returns logical():
     1051      define variable vtime as int64 no-undo.
     1052      if mWaitFramStopTimeOut
     1053      then
     1054         return yes.
     1055      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1056      if     mWaitFramTimeOut ne ?
     1057         and mWaitFramTimeOut ne 0
     1058         and mWaitFramTimeOut lt vtime
     1059      then do:
     1060         mWaitFramStopTimeOut = yes.
     1061      end.
     1062      return mWaitFramStopTimeOut.
     1063   end.
     1064   procedure waitfram-hide :
     1065     if not session:batch-mode
     1066     then do
     1067     on error undo, return error return-value
     1068     :
     1069       pause 0 before-hide .
     1070       if not mBatchMode then
     1071         hide frame waitfram .
     1072     if     not mWaitFramView
     1073        and mWaitProcEvent
     1074     then
     1075       process events .
     1076     end.
     1077   end procedure.
     1078   procedure waitfram-show :
     1079     define input  parameter p-message as character no-undo .
     1080     define variable v-left-margin as integer   no-undo .
     1081     if not session:batch-mode
     1082     then do
     1083     on error undo, return error return-value
     1084     :
     1085       if length(p-message) <= 70 then do:
     1086         assign
     1087           v-left-margin = integer((70 - length(p-message)) / 2)
     1088         .
     1089         assign
     1090           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1091         .
     1092         assign
     1093           v-waitfram-action01 = " "
     1094           v-waitfram-action02 = " "
     1095                                    + fill(" ", v-left-margin)
     1096                                    + p-message
     1097           v-waitfram-action03 = " "
     1098         .
     1099       end.
     1100       else do:
     1101         define variable vRindex1 as integer no-undo.
     1102         define variable vRindex2 as integer no-undo.
     1103         vRindex1 = r-index(p-message," ",70).
     1104         if vRindex1 = 0
     1105         then
     1106            vRindex1 = 70.
     1107         if length(p-message)  <= vRindex1 + 70 then do:
     1108           assign
     1109             v-waitfram-action01 = " "
     1110             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1111             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1112           .
     1113         end.
     1114         else do:
     1115           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1116           if vRindex2 <= vRindex1
     1117           then
     1118              vRindex2 = vRindex1 + 70.
     1119           assign
     1120             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1121             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1122             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1123           .
     1124         end.
     1125       end.
     1126       B-viewProcInfo:visible   in frame waitfram = no.
     1127       B-viewProcInfo:sensitive in frame waitfram = no.
     1128       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1129       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1130       if  (   mWaitFramView
     1131          or  mWaitProcEvent)
     1132          and not mBatchMode
     1133       then
     1134          display
     1135             v-waitfram-action01 skip
     1136             v-waitfram-action02 skip
     1137             v-waitfram-action03 skip
     1138          with frame waitfram .
     1139       if     mWaitFramView
     1140          then do:
     1141             if     mWaitFramInterval ne ?
     1142                and not mBatchMode
     1143             then
     1144                wait-for go of frame waitfram pause mWaitFramInterval.
     1145          end.
     1146          else
     1147             if     mWaitProcEvent
     1148                and not mBatchMode
     1149             then
     1150                process events .
     1151     end.
     1152   end procedure.
     1153      procedure waitfram-show-this:
     1154         define input  parameter iInterval as int64 no-undo.
     1155         define variable vtime as int64 no-undo.
     1156         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1157         mWaitFramInterval = iInterval.
     1158         run waitfram-show (substitute("&1&2 &3&4" ,
     1159                                       mWaitFramTextBeg ,
     1160                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1161                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1162                                       mWaitFramTextEnd
     1163                                      )
     1164                           ).
     1165      end.
     1166      procedure WaitFramRunPause:
     1167         define input  parameter iInterval as dec no-undo.
     1168         define variable vStart  as datetime-tz no-undo.
     1169         define variable vend    as datetime-tz no-undo.
     1170         define variable vint as int64 no-undo.
     1171         define variable vOk as logical no-undo.
     1172         vStart = now.
     1173         vend   = vStart.
     1174         publish "WaitFramPause" (iInterval,output vOk).
     1175         vend   =  now.
     1176         vint = vend - vStart.
     1177         vint = iInterval - vint / 1000.
     1178         if     not mWaitFramStop
     1179            and (   vint > 0
     1180                 or (    not vOk
     1181                     and iInterval eq ?
     1182                     )
     1183                 )
     1184         then
     1185            run waitfram-show-this (iInterval).
     1186         vend   =  now.
     1187         vint = vend - vStart.
     1188         vint = iInterval - vint / 1000.
     1189         if     not mWaitFramStop
     1190            and vint > 0
     1191         then do:
     1192            run gbl/pause.p (vint * 1000).
     1193         end.
     1194         if iInterval ne ?
     1195         then
     1196            publish "WaitFramStop".
     1197         waitfram-check-timeout().
     1198      end.
     1199      procedure WaitFramWaitFor:
     1200         define input  parameter iInterval as dec no-undo.
     1201         assign
     1202            mWaitFramStartProc   = now
     1203            mWaitFramStopUser    = no
     1204            mWaitFramStopTimeOut = no
     1205         .
     1206         block-wait:
     1207         do while not mWaitFramStop:
     1208            run WaitFramRunPause (iInterval).
     1209            if  waitfram-check-timeout()
     1210            then do:
     1211               leave block-wait.
     1212            end.
     1213         end.
     1214         run waitfram-hide.
     1215      end.
     1216   procedure waitfram-join :
     1217     define input  parameter p-line-1  as character no-undo .
     1218     define input  parameter p-line-2  as character no-undo .
     1219     define input  parameter p-line-3  as character no-undo .
     1220     define output parameter p-message as character no-undo .
     1221     do
     1222     on error undo, return error return-value
     1223     :
     1224       assign
     1225         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1226                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1227                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1228       .
     1229     end.
     1230   end procedure.
     1231   function waitfram-join-function returns character
     1232     (input p-line-1 as character
     1233     ,input p-line-2 as character
     1234     ,input p-line-3 as character
     1235     ).
     1236     define variable v-message as character no-undo .
     1237     run waitfram-join in this-procedure
     1238       (input  p-line-1
     1239       ,input  p-line-2
     1240       ,input  p-line-3
     1241       ,output v-message
     1242       ) .
     1243     return v-message .
     1244   end function .
