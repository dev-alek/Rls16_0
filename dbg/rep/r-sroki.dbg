     2346   end procedure.
     2347   define variable vss-include-info25 as character format "X(65)" no-undo
     2348   initial "@(#)$Workfile$ $Revision$".
     2349   procedure grplib-get-full-name :
     2350      define input parameter p-node-code  as integer      no-undo.
     2351      define output parameter p-full-name as character    no-undo.
     2352      do
     2353   on error undo, return error
     2354   :
     2355       define variable v-upper-code    as integer           no-undo.
     2356       define buffer buf_gds-grp       for ub.gds-grp.
     2357       define buffer buf_upper_gds-grp for ub.gds-grp.
     2358       find first buf_gds-grp no-lock
     2359            where buf_gds-grp.node-code = p-node-code
     2360       no-error.
     2361       if not available buf_gds-grp
     2362       then do:
     2363           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2364       end.
     2365       assign
     2366           p-full-name  = ""
     2367           v-upper-code = 1
     2368       .
     2369       do while buf_gds-grp.upper-code <> 0
     2370       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2371       :
     2372           assign
     2373               p-full-name  = buf_gds-grp.node-name
     2374                            + (if p-full-name <> "" then chr(47) else "")
     2375                            + p-full-name
     2376               v-upper-code = buf_gds-grp.upper-code
     2377           .
     2378           find first buf_gds-grp no-lock
     2379                where buf_gds-grp.node-code = v-upper-code
     2380           no-error.
     2381           if not available buf_gds-grp
     2382           then do:
     2383               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2384                                   + string( v-upper-code )
     2385                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2386           end.
     2387       end.
     2388       assign
     2389       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2390       .
     2391   end.
     2392   end .
     2393   procedure grplib-get-node-from-full-name :
     2394   define input parameter p-full-name as character no-undo .
     2395   define output parameter p-node-code as integer no-undo .
     2396   define variable v-ii as integer no-undo .
     2397   define variable v-upper-code as integer no-undo .
     2398   define variable v-root-code as integer no-undo .
     2399   define variable v-entry as character no-undo .
     2400   define buffer buf_gds-grp       for ub.gds-grp.
     2401   do
     2402   on error undo, return error
     2403   :
     2404     find first buf_gds-grp no-lock
     2405         where buf_gds-grp.upper-code = 0
     2406     no-error .
     2407     if not available buf_gds-grp
     2408     then do:
     2409         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2410     end.
     2411     else do:
     2412       assign
     2413       v-root-code = buf_gds-grp.node-code
     2414       .
     2415     end.
     2416     v-upper-code = v-root-code.
     2417     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2418       assign
     2419       v-entry = entry(v-ii, p-full-name, chr(47)).
     2420       if v-entry = '' then leave.
     2421       find first buf_gds-grp no-lock where
     2422                 buf_gds-grp.node-name = v-entry
     2423             and buf_gds-grp.upper-code = v-upper-code
     2424             no-error.
     2425       if not available buf_gds-grp then do:
     2426         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2427       end.
     2428       else do:
     2429         p-node-code = buf_gds-grp.node-code.
     2430         v-upper-code = buf_gds-grp.node-code.
     2431       end.
     2432     end.
     2433   end.
     2434   end .
     2435   define temp-table temp_result-line no-undo
     2436       field line-order      as integer
     2437       field artic         as character
     2438       field prod-type     as character
     2439       field prod-code     as integer
     2440       field prod-string   as character
     2441       field in-code       as character
     2442       field part-code     as character
     2443       field gds-code      as integer
     2444       field gds-name      as character
     2445       field grp-name      as character
     2446       field supp-string   as character
     2447       field supp-name     as character
     2448       field class-order   as integer
     2449       field pl-name       as character
     2450       field last-date     as date
     2451       field free-qnty     as decimal
     2452       field fact-qnty     as decimal
     2453       field obj-type      as character
     2454       field obj-code      as integer
     2455       field b-code      as integer
     2456       index pi is primary unique
     2457           line-order
     2458       index gds-code
     2459           gds-code
     2460       index artic
     2461           artic
     2462       index gds-name
     2463           gds-name
     2464       index class
     2465           class-order
     2466   .
     2467   define temp-table temp_classificator no-undo
     2468       field class-order   as integer
     2469       field class-code    as character
     2470       field class1-key    as character
     2471       field class2-key    as character
     2472       field class1-value  as character
     2473       field class2-value  as character
     2474       index pi is primary unique
     2475           class-order
     2476       index code
     2477           class-code
     2478           class1-key
     2479           class2-key
     2480   .
     2481   define variable v-summi as decimal   no-undo .
     2482   define stream out-stream .
     2483   define variable v-r-sroki-line-counter          as integer      no-undo.
     2484   define variable v-r-sroki-single-line           as character    no-undo.
     2485   define variable v-r-sroki-first-line-printed    as logical      no-undo.
     2486   define variable v-r-sroki-class-order   as integer      no-undo.
     2487   define variable v-today         as date         no-undo.
     2488   define variable v-time          as integer      no-undo.
     2489   define variable v-last-date     as date         no-undo.
     2490   define buffer buf_goods                 for goods.
     2491   define buffer buf_temp_goods            for gds-list.
     2492   define buffer buf_temp_result-line      for temp_result-line.
     2493   define buffer buf_temp_classificator    for temp_classificator.
     2494   define buffer buf_temp_prod             for g#cli.
     2495   define buffer buf_temp_goods-grp        for tmp#grp.
     2496   define variable v-file-name as character no-undo .
     2497   define variable v-ind       as integer   no-undo .
     2498   define variable tmp#stroka as character no-undo .
     2499   define variable num#col# as integer no-undo .
     2500   define variable C-c    as integer no-undo .
     2501   define variable C-str  as character no-undo .
     2502   define variable str--1 as character Format "x(60)" no-undo.
     2503   define variable str--2 as integer no-undo .
     2504   define variable C-i    as integer no-undo .
     2505   define variable p-var  as integer no-undo .
     2506   define variable var-1 as integer no-undo .
     2507   define variable var-2 as integer no-undo .
     2508   define stream  macr_excel .
     2509       run gbl/_tmpfile.p ( "wb", ".txt", output v-file-name) .
     2510       output stream macr_excel to value(v-file-name)   .
     2511       v-ind = 1    .
     2512       num#str# = 0 .
     2513   do
     2514   on error undo, return error
     2515   :
     2516       define variable v-data-present                  as logical      no-undo.
     2517   define variable v-account as integer init 0 no-undo .
     2518   define variable v-account-lavel as character no-undo .
     2519   define variable v-button-stop as logical no-undo .
     2520   define variable v-kol-spice as integer no-undo .
     2521   define variable v-kol-spice2 as integer no-undo .
     2522   define variable v-kol-spice3 as integer no-undo .
     2523   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     2524   DEFINE BUTTON StopBtn AUTO-END-KEY
     2525        LABEL "Стоп"
     2526        SIZE 10 BY 1.
     2527   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     2528        LABEL "Обработано записей"
     2529         VIEW-AS TEXT
     2530        SIZE 14 BY .67 NO-UNDO.
     2531   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     2532         VIEW-AS TEXT
     2533        SIZE 53.25 BY .67
     2534        FGCOLOR 1  NO-UNDO.
     2535   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     2536         VIEW-AS TEXT
     2537        SIZE 53.25 BY .67
     2538        FGCOLOR 1  NO-UNDO.
     2539   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2540         VIEW-AS TEXT
     2541        SIZE 53.25 BY .67
     2542        FGCOLOR 1  NO-UNDO.
     2543   DEFINE RECTANGLE RECT-1
     2544        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2545        SIZE 55.13 BY 4.46.
     2546   DEFINE FRAME InfoFrame
     2547        StopBtn AT ROW 4.25 COL 21.75
     2548        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2549        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2550        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2551        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2552        RECT-1 AT ROW 1 COL 1
     2553       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2554            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2555            TITLE "Процесс"
     2556            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2557   define variable mFrameView      as logical   no-undo init yes.
     2558     define variable mFramHandle as handle no-undo.
     2559     mFramHandle = frame InfoFrame:handle.
     2560     if  log-manager:logfile-name ne ?
     2561     then DO:
     2562         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2563         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2564         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2565     end.
     2566     mFrameView = not session:batch-mode and mFramHandle:visible.
     2567     if mFrameView
     2568     then do:
     2569       ASSIGN
     2570          FRAME InfoFrame:HIDDEN                           = TRUE
     2571          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2572     end.
     2573   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2574   DO:
     2575     IF not StopProcessing THEN
     2576       Message "Вы действительно хотите прервать" SKIP
     2577               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2578                 UPDATE StopProcessing.
     2579     IF StopProcessing THEN do:
     2580        if mFrameView
     2581        then do:
     2582           HIDE FRAME InfoFrame.
     2583        end.
     2584     End.
     2585   END.
     2586   assign v-account = ( if integer( 20 ) = 0 then 100 else integer( 20 ) ).
     2587     if  log-manager:logfile-name ne ?
     2588     then DO:
     2589         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2590     end.
     2591     if not session:batch-mode then
     2592     do:
     2593       VIEW FRAME InfoFrame.
     2594       mFrameView = true.
     2595     end.
     2596      v-button-stop = false .
     2597         if mFrameView
     2598         then do:
     2599         if v-button-stop then view STOPBTN in frame InfoFrame.
     2600                          else Hide STOPBTN in frame InfoFrame.
     2601         end.
     2602       assign
     2603           v-r-sroki-line-counter  = 0
     2604           v-r-sroki-single-line   = fill( "-", 195 )
     2605           v-r-sroki-class-order   = 0
     2606       .
     2607       run cur-time in this-procedure (
     2608             output v-today
     2609           , output v-time
     2610       ).
     2611       run godendo-offset-to-date in this-procedure (
     2612             input v-today
     2613           , input p-days-amount
     2614           , output v-last-date
     2615       ).
     2616       case x-SelectGood
     2617       :
     2618           when 1
     2619           then do:
     2620               for each buf_goods no-lock
     2621               on error undo, return error
     2622               :
     2623               for each obj-list :
     2624                   run fill-result-line in this-procedure (
     2625                         input obj-list.obj-type
     2626                       , input obj-list.obj-code
     2627                       , input buf_goods.artic
     2628                       , input buf_goods.prod-type
     2629                       , input buf_goods.prod-code
     2630                       , input p-days-amount
     2631                       , input p-classificator
     2632                   ).
     2633               end.
     2634               end.
     2635           end.
     2636           when 3
     2637           then do:
     2638               for each buf_temp_prod
     2639               on error undo, return error
     2640               :
     2641                   for each buf_goods no-lock
     2642                      where buf_goods.prod-type = buf_temp_prod.obj-type
     2643                        and buf_goods.prod-code = buf_temp_prod.obj-code
     2644                   on error undo, return error
     2645                   :
     2646                       for each obj-list :
     2647                       run fill-result-line in this-procedure (
     2648                             input obj-list.obj-type
     2649                           , input obj-list.obj-code
     2650                           , input buf_goods.artic
     2651                           , input buf_goods.prod-type
     2652                           , input buf_goods.prod-code
     2653                           , input p-days-amount
     2654                           , input p-classificator
     2655                       ).
     2656                       end.
     2657                   end.
     2658               end.
     2659           end.
     2660           when 2
     2661           then do:
     2662           define variable v-curr-grp-name               as character no-undo .
     2663               for each buf_temp_goods-grp
     2664               on error undo, return error
     2665               :
     2666             run grplib-get-full-name in this-procedure( input buf_temp_goods-grp.node-code, output v-curr-grp-name ) .
     2667             for each buf_goods no-lock
     2668               where buf_goods.grp-name begins v-curr-grp-name
     2669                   on error undo, return error
     2670                   :
     2671                       for each obj-list :
     2672                       run fill-result-line in this-procedure (
     2673                             input obj-list.obj-type
     2674                           , input obj-list.obj-code
     2675                           , input buf_goods.artic
     2676                           , input buf_goods.prod-type
     2677                           , input buf_goods.prod-code
     2678                           , input p-days-amount
     2679                           , input p-classificator
     2680                       ).
     2681                       end.
     2682                   end.
     2683               end.
     2684           end.
     2685           otherwise do:
     2686               for each buf_temp_goods
     2687               on error undo, return error
     2688               :
     2689                   for each obj-list :
     2690                   run fill-result-line in this-procedure (
     2691                         input obj-list.obj-type
     2692                       , input obj-list.obj-code
     2693                       , input buf_temp_goods.artic
     2694                       , input buf_temp_goods.prod-type
     2695                       , input buf_temp_goods.prod-code
     2696                       , input p-days-amount
     2697                       , input p-classificator
     2698                   ).
     2699                   end.
     2700               end.
     2701           end.
     2702       end case.
     2703       run check-data-presence in this-procedure (
     2704           output v-data-present
     2705       ).
     2706       if v-data-present = yes
     2707       then do:
     2708   output stream out-stream to value( string( session:temp-directory +
     2709                                        "rpt" + string( g#report-num ) ) )
     2710                                        page-size  value(ReportPageHeight) .
     2711           form header
     2712               space(2) v-r-sroki-single-line format "X(195)"
     2713               skip "Продолжение - на следующей странице" at 90
     2714               with frame BottomFrame
     2715                   width 232
     2716                   page-bottom
     2717                   no-labels
     2718                   no-box
     2719           .
     2720           view stream out-stream frame BottomFrame .
     2721           run print-header in this-procedure.
     2722       end.
     2723       else do:
     2724           message
     2725               substitute("Нет товаров с истекающими сроками годности до &1" , string( v-last-date , "99/99/9999") )
     2726           view-as alert-box information
     2727           title "Нет строк для печати".
     2728           undo, return .
     2729       end.
     2730       define variable old1 as character no-undo .
     2731       define variable v-p as logical   no-undo .
     2732       old1 = "".
     2733       v-summi = 0.
     2734       for each buf_temp_classificator
     2735          where buf_temp_classificator.class-code = p-classificator
     2736       on error undo, return error
     2737       :
     2738           if old1 <> buf_temp_classificator.class1-key then v-p = true .
     2739           else v-p =  false .
     2740           run print-classificator in this-procedure (
     2741               input v-p ,
     2742               input buf_temp_classificator.class-order
     2743           ).
     2744           case p-sort-type
     2745           :
     2746               when "sort-code":U
     2747               then do:
     2748                   for each buf_temp_result-line
     2749                      where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     2750                   by buf_temp_result-line.b-code
     2751                   on error undo, return error
     2752                   :
     2753                       run print-line in this-procedure (
     2754                           input buf_temp_result-line.line-order
     2755                       ).
     2756                   end.
     2757               end.
     2758               when "sort-artic":U
     2759               then do:
     2760                   for each buf_temp_result-line
     2761                      where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     2762                   by buf_temp_result-line.artic
     2763                   on error undo, return error
     2764                   :
     2765                       run print-line in this-procedure (
     2766                           input buf_temp_result-line.line-order
     2767                       ).
     2768                   end.
     2769               end.
     2770               when "sort-name":U
     2771               then do:
     2772                   for each buf_temp_result-line
     2773                      where buf_temp_result-line.class-order = buf_temp_classificator.class-order
     2774                   by buf_temp_result-line.gds-name
     2775                   on error undo, return error
     2776                   :
     2777                       run print-line in this-procedure (
     2778                           input buf_temp_result-line.line-order
     2779                       ).
     2780                   end.
     2781               end.
     2782           end case.
     2783           old1 = buf_temp_classificator.class1-key.
     2784       end.
     2785       run print-footer in this-procedure .
     2786       hide stream out-stream frame BottomFrame .
     2787       output stream out-stream close.
     2788       run paramls-write in this-procedure
     2789         (input "file"
     2790         ,input string(v-ind)
     2791         ,input v-file-name
     2792         ) .
     2793       run paramls-write in this-procedure
     2794           (input "charcol"
     2795           ,input ""
     2796           ,input "1,2,3,4,5,6,7,9,10"
     2797           ) .
     2798     run end-proc .
     2799     Output stream Macr_Excel  close .
     2800   if mFrameView
     2801   then do:
     2802      HIDE FRAME InfoFrame.
     2803   end.
     2804       define variable v-user-action           as character            no-undo.
     2805       define variable v-printed               as logical              no-undo.
     2806       define variable v-orient-page as character no-undo .
     2807       define variable DisabledOptions as integer   no-undo .
     2808       run How-name in this-procedure (
     2809           input ReportPageHeight,
     2810           input ReportPageWidth,
     2811           output v-orient-page )
     2812           .
     2813       if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2814                                      else DisabledOptions = 0 .
     2815       run gbl/prnfilen.w (
     2816             input "":U
     2817           , input DisabledOptions
     2818           , input string( session :temp-directory ) + "rpt" + string( g#report-num )
     2819           , input REportFontNum
     2820           , output v-user-action
     2821           , output v-printed
     2822       ) .
     2823   end.
     2824   procedure fill-result-line :
     2825   define input parameter p-obj-type       as character        no-undo.
     2826   define input parameter p-obj-code       as integer          no-undo.
     2827   define input parameter p-artic          as character        no-undo.
     2828   define input parameter p-prod-type      as character        no-undo.
     2829   define input parameter p-prod-code      as integer          no-undo.
     2830   define input parameter p-days-amount    as integer          no-undo.
     2831   define input parameter p-classificator  as character        no-undo.
     2832       define variable v-supp-string   as character    no-undo.
     2833       define variable v-supp-name     as character    no-undo.
     2834       define variable v-pl-name       as character    no-undo.
     2835       define variable v-class1-key    as character    no-undo.
     2836       define variable v-class1-value  as character    no-undo.
     2837       define variable v-class2-key    as character    no-undo.
     2838       define variable v-class2-value  as character    no-undo.
     2839       define buffer buf_goods                 for goods.
     2840       define buffer buf_pl-gds                for pl-gds.
     2841       define buffer buf_place                 for place.
     2842       define buffer buf_supp_clients          for clients.
     2843       define buffer buf_temp_parts            for temp-parts.
     2844       define buffer buf_temp_result-line      for temp_result-line.
     2845       define buffer buf_temp_classificator    for temp_classificator.
     2846   do
     2847   for buf_goods
     2848     , buf_place
     2849     , buf_supp_clients
     2850     , buf_temp_parts
     2851     , buf_temp_result-line
     2852     , buf_temp_classificator
     2853   on error undo, return error
     2854   :
     2855       run partslib-init-temp-parts in this-procedure (
     2856             input p-obj-type
     2857           , input p-obj-code
     2858           , input p-artic
     2859           , input p-prod-type
     2860           , input p-prod-code
     2861       ).
     2862       find first buf_goods no-lock
     2863            where buf_goods.artic     = p-artic
     2864              and buf_goods.prod-type = p-prod-type
     2865              and buf_goods.prod-code = p-prod-code
     2866       .
     2867       for each buf_pl-gds no-lock
     2868          where buf_pl-gds.gds-code  = buf_goods.gds-code
     2869            and buf_pl-gds.obj-type  = p-obj-type
     2870            and buf_pl-gds.obj-code  = p-obj-code
     2871       on error undo, return error
     2872       :
     2873           find first buf_place no-lock
     2874                where buf_place.obj-type   = p-obj-type
     2875                  and buf_place.obj-code   = p-obj-code
     2876                  and buf_place.pl-code    = buf_pl-gds.pl-code
     2877           no-error.
     2878           if available buf_place
     2879           then do:
     2880               assign
     2881                   v-pl-name = v-pl-name
     2882                               + ( if v-pl-name = "" then "" else "," )
     2883                               + buf_place.pl-name
     2884               .
     2885           end.
     2886       end.
     2887       cycle-parts-of-goods:
     2888       for each buf_temp_parts
     2889       on error undo, return error
     2890       :
     2891           if p-empty-disabled = yes
     2892           and buf_temp_parts.last-date = ?
     2893           then do:
     2894               undo cycle-parts-of-goods, next cycle-parts-of-goods.
     2895           end.
     2896           if p-days-amount = 0
     2897           or buf_temp_parts.last-date <= v-last-date
     2898           then do:
     2899               assign
     2900                   v-r-sroki-line-counter = v-r-sroki-line-counter + 1
     2901               .
     2902               find first buf_supp_clients no-lock
     2903                    where buf_supp_clients.obj-type = buf_temp_parts.supp-type
     2904                      and buf_supp_clients.obj-code = buf_temp_parts.supp-code
     2905               no-error.
     2906               if available buf_supp_clients
     2907               then do:
     2908                   assign
     2909                       v-supp-string   = substitute( "&1 &2", buf_temp_parts.supp-type, buf_temp_parts.supp-code )
     2910                       v-supp-name     = buf_supp_clients.obj-name
     2911                   .
     2912               end.
     2913               else do:
     2914                   assign
     2915                       v-supp-string   = "нет"
     2916                       v-supp-name     = ""
     2917                   .
     2918               end.
     2919               find first ub.bar-code no-lock where
     2920                          ub.bar-code.gds-code   = buf_goods.gds-code and
     2921                          ub.bar-code.in-code    = buf_temp_parts.in-code  and
     2922                          ub.bar-code.part-code  = buf_temp_parts.part-code and
     2923                          ub.bar-code.unit-cli   = buf_goods.unit-base
     2924                          no-error .
     2925               create buf_temp_result-line.
     2926               assign
     2927                   buf_temp_result-line.line-order     = v-r-sroki-line-counter * 10
     2928                   buf_temp_result-line.artic          = p-artic
     2929                   buf_temp_result-line.prod-type      = p-prod-type
     2930                   buf_temp_result-line.prod-code      = p-prod-code
     2931                   buf_temp_result-line.prod-string    = substitute( "&1 &2", p-prod-type, p-prod-code )
     2932                   buf_temp_result-line.in-code        = buf_temp_parts.in-code
     2933                   buf_temp_result-line.supp-string    = v-supp-string
     2934                   buf_temp_result-line.supp-name      = v-supp-name
     2935                   buf_temp_result-line.part-code      = buf_temp_parts.part-code
     2936                   buf_temp_result-line.gds-code       = buf_goods.gds-code
     2937                   buf_temp_result-line.b-code         = if available ub.bar-code then ub.bar-code.b-code else 0
     2938                   buf_temp_result-line.gds-name       = buf_goods.gds-name
     2939                   buf_temp_result-line.grp-name       = buf_goods.grp-name
     2940                   buf_temp_result-line.pl-name        = v-pl-name
     2941                   buf_temp_result-line.last-date      = buf_temp_parts.last-date
     2942                   buf_temp_result-line.free-qnty      = buf_temp_parts.free-qnty
     2943                   buf_temp_result-line.fact-qnty      = buf_temp_parts.fact-qnty
     2944                   buf_temp_result-line.obj-type       = p-obj-type
     2945                   buf_temp_result-line.obj-code       = p-obj-code
     2946               .
     2947               case p-classificator
     2948               :
     2949                   when "no-classify":U
     2950                   then do:
     2951                       assign
     2952                           v-class1-key   = ""
     2953                           v-class1-value = ""
     2954                           v-class2-key   = ""
     2955                           v-class2-value = ""
     2956                       .
     2957                   end.
     2958                   when "prod":U
     2959                   then do:
     2960                       assign
     2961                           v-class1-key   = substitute( "&1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2962                           v-class1-value = substitute( "Производитель: &1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2963                           v-class2-key   = ""
     2964                           v-class2-value = ""
     2965                       .
     2966                   end.
     2967                   when "grp-goods":U
     2968                   then do:
     2969                       assign
     2970                           v-class1-key   = buf_temp_result-line.grp-name
     2971                           v-class1-value = substitute( "Группа: &1", buf_temp_result-line.grp-name )
     2972                           v-class2-key   = ""
     2973                           v-class2-value = ""
     2974                       .
     2975                   end.
     2976                   when "prod/grp-goods":U
     2977                   then do:
     2978                       assign
     2979                           v-class1-key   = substitute( "&1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2980                           v-class1-value = substitute( "Производитель: &1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2981                           v-class2-key   = buf_temp_result-line.grp-name
     2982                           v-class2-value = substitute( "Группа: &1", buf_temp_result-line.grp-name )
     2983                       .
     2984                   end.
     2985                   when "grp-goods/prod":U
     2986                   then do:
     2987                       assign
     2988                           v-class1-key   = buf_temp_result-line.grp-name
     2989                           v-class1-value = substitute( "Группа: &1", buf_temp_result-line.grp-name )
     2990                           v-class2-key   = substitute( "&1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2991                           v-class2-value = substitute( "Производитель: &1 &2", buf_temp_result-line.prod-type, buf_temp_result-line.prod-code )
     2992                       .
     2993                   end.
     2994               end case.
     2995               find first buf_temp_classificator
     2996                    where buf_temp_classificator.class-code   = p-classificator
     2997                      and buf_temp_classificator.class1-key   = v-class1-key
     2998                      and buf_temp_classificator.class2-key   = v-class2-key
     2999               no-error.
     3000               if not available buf_temp_classificator
     3001               then do:
     3002                   assign
     3003                       v-r-sroki-class-order = v-r-sroki-class-order + 1
     3004                   .
     3005                   create buf_temp_classificator.
     3006                   assign
     3007                       buf_temp_classificator.class-order  = v-r-sroki-class-order
     3008                       buf_temp_classificator.class-code   = p-classificator
     3009                       buf_temp_classificator.class1-key   = v-class1-key
     3010                       buf_temp_classificator.class2-key   = v-class2-key
     3011                       buf_temp_classificator.class1-value = v-class1-value
     3012                       buf_temp_classificator.class2-value = v-class2-value
     3013                   .
     3014               end.
     3015               assign
     3016                   buf_temp_result-line.class-order = buf_temp_classificator.class-order
     3017               .
     3018   IF ( v-r-sroki-line-counter modulo v-account = 0 )  then DO:
     3019    Assign
     3020       v-kol-spice = (50 - LENGTH(reportname)) / 2
     3021       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     3022       .
     3023             if  log-manager:logfile-name ne ?
     3024             then DO:
     3025                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     3026             end.
     3027              if mFrameView
     3028              then do:
     3029               DISPLAY
     3030                 v-r-sroki-line-counter @ RecordsDone
     3031                 RecordsString   @ RecordsString
     3032                 WITH FRAME InfoFrame.
     3033              end.
     3034   End.
     3035      if v-button-stop then  DO:
     3036            if mFrameView
     3037            then
     3038               PROCESS EVENTS.
     3039            IF StopProcessing THEN DO:
     3040            RETURN error.
     3041            End.
     3042      end.
     3043           end.
     3044       end.
     3045   end.
     3046   end procedure.
     3047   procedure check-data-presence :
     3048   define output parameter p-data-present  as logical          no-undo.
     3049       define buffer buf_temp_result-line      for temp_result-line.
     3050   do
     3051   for buf_temp_result-line
     3052   on error undo, return error
     3053   :
     3054       find first buf_temp_result-line
     3055       no-error.
     3056       if available buf_temp_result-line
     3057       then do:
     3058           assign
     3059               p-data-present = yes
     3060           .
     3061       end.
     3062       else do:
     3063           assign
     3064               p-data-present = no
     3065           .
     3066       end.
     3067   end.
     3068   end procedure.
     3069   procedure print-header :
     3070   define variable i as integer         no-undo .
     3071   do
     3072   on error undo, return error
     3073   :
     3074   if p-days-amount = 0 then tmp#stroka  = substitute("Отчет по товарам по срокам годности на &1 (без проверки срока)" ,string( v-today, "99/99/9999") ).
     3075   else tmp#stroka  = substitute ("Отчет по товарам по срокам годности на &1 (последний срок до &2)" , string( v-today, "99/99/9999") , string( v-last-date, "99/99/9999" ) ).
     3076       put stream out-stream unformatted
     3077           skip(1)
     3078           skip space( 22 )
     3079           tmp#stroka
     3080           skip
     3081       .
     3082       str1 = tmp#stroka .
     3083       if p-empty-disabled then str1 = str1 + " товары с указанным сроком годности" .
     3084        put stream out-stream str2 at 1 format "x(200)"  skip .
     3085        repeat i = 1 to num-entries(str4,chr(10)) :
     3086          put stream out-stream  entry(i,str4,chr(10))  at 1 format "x(170)" skip .
     3087        end.
     3088        repeat i = 1 to num-entries(reportheader,chr(10)) :
     3089          put stream out-stream  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip .
     3090        end.
     3091         num#str# = num#str# + 1 .
     3092         num#col# =  1 .
     3093         run macr_excel_char_with_format ( ReportNAme , num#str# , num#col#  ).
     3094         run macr_cell_format
     3095             ( 12    ,
     3096               true  ,
     3097               false ,
     3098               ?     ,
     3099               num#str# ,
     3100               num#col# ,
     3101               ? ,
     3102               ?         ) .
     3103   define variable l-ii  as integer no-undo .
     3104   define variable l-jj  as integer no-undo .
     3105   define variable l-len as integer no-undo .
     3106   define variable l-m   as integer no-undo .
     3107   do l-ii = 1 to num-entries( str1 , "chr(10)"  )    :        l-len = length (entry( l-ii , str1  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                           substring(entry( l-ii , str1  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3108   do l-ii = 1 to num-entries( str2 , "chr(10)"  )    :        l-len = length (entry( l-ii , str2  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                           substring(entry( l-ii , str2  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3109   do l-ii = 1 to num-entries( str3 , "chr(10)"  )    :        l-len = length (entry( l-ii , str3  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                           substring(entry( l-ii , str3  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3110   do l-ii = 1 to num-entries( str4 , "chr(10)"  )    :        l-len = length (entry( l-ii , str4  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                           substring(entry( l-ii , str4  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3111   do l-ii = 1 to num-entries( reportheader , "chr(10)"  )    :        l-len = length (entry( l-ii , reportheader  , "chr(10)")) .                       l-m = integer( l-len / 220 ) + 1 .                                                      do l-jj = 1 to  l-m  :                                                                      num#str# = num#str# + 1 .                                                               run macr_excel_char_with_format (                                                           substring(entry( l-ii , reportheader  , "chr(10)") , (( 220 * l-jj ) - 219 )  , 220 )  , num#str# , num#col# ) .      end.                                                                                                         end.
     3112     num#str# = num#str# + 1.
     3113     num#col# = 1.
     3114       put stream out-stream
     3115           skip(1)
     3116           space(2)
     3117               v-r-sroki-single-line   format "X(195)"
     3118           skip space(2)  "|"
     3119               "БарКод"                at center-field(2 + 1, 2 + 11, 3)
     3120               "|"                     at 2 + 11
     3121               "Артикул"               at center-field(2 + 11, 2 + 28, 7)
     3122               "|"                     at 2 + 28
     3123               "Производитель"         at center-field(2 + 28, 2 + 42, 13)
     3124               "|"                     at 2 + 42
     3125               "Наименование товара"   at 2 + 42 + 2
     3126               "|"                     at 2 + 82
     3127               "Поставщик"             at center-field(2 + 82, 2 + 96, 9)
     3128               "|"                     at 2 + 96
     3129               "Имя поставщика"        at 2 + 96 + 2
     3130               "|"                     at 2 + 121
     3131               "Партия"                at center-field(2 + 121, 2 + 142, 6)
     3132               "|"                     at 2 + 142
     3133               "Количество"            at center-field(2 + 142, 2 + 154, 10)
     3134               "|"                     at 2 + 154
     3135               "Объект и Место хранения"        at 2 + 154 + 2
     3136               "|"                     at 2 + 184
     3137               "Дата"                  at center-field(2 + 184, 2 + 195, 4)
     3138               "|"                     at 2 + 195
     3139           skip space(2)
     3140               "|" v-r-sroki-single-line format "X(193)" "|"
     3141       .
     3142       run proc-print-header.
     3143   end.
     3144   end procedure.
     3145   procedure print-line :
     3146   define input parameter p-line-order     as integer          no-undo.
     3147       define buffer buf_temp_result-line          for temp_result-line.
     3148   do
     3149   for buf_temp_result-line
     3150   on error undo, return error
     3151   :
     3152       find first buf_temp_result-line
     3153            where buf_temp_result-line.line-order = p-line-order
     3154       .
     3155       put stream out-stream
     3156           skip space(2) "|"
     3157               buf_temp_result-line.b-code        format "999999999"
     3158               "|"                     at 2 + 11
     3159               buf_temp_result-line.artic           format "X(16)"
     3160               "|"                     at 2 + 28
     3161               buf_temp_result-line.prod-string     format "X(13)"
     3162               "|"                     at 2 + 42
     3163               buf_temp_result-line.gds-name        format "X(39)"
     3164               "|"                     at 2 + 82
     3165               buf_temp_result-line.supp-string     format "X(13)"
     3166               "|"                     at 2 + 96
     3167               buf_temp_result-line.supp-name       format "X(24)"
     3168               "|"                     at 2 + 121
     3169               buf_temp_result-line.part-code       format "X(20)"
     3170               "|"                     at 2 + 142
     3171               (if p-free then buf_temp_result-line.free-qnty else buf_temp_result-line.fact-qnty)       format "->>>>>>9.99"
     3172               "|"                     at 2 + 154
     3173               substitute("&1&2 &3" , buf_temp_result-line.obj-type ,buf_temp_result-line.obj-code, buf_temp_result-line.pl-name )   format "X(29)"
     3174               "|"                     at 2 + 184
     3175               buf_temp_result-line.last-date       format "99.99.9999"
     3176               "|"                     at 2 + 195
     3177       .
     3178     num#str# = num#str# + 1 .
     3179     num#col# =  1 .
     3180     run macr_excel_char ( buf_temp_result-line.b-code       , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3181     run macr_excel_char ( buf_temp_result-line.artic        , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3182     run macr_excel_char ( buf_temp_result-line.prod-string  , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3183     run macr_excel_char ( buf_temp_result-line.gds-name     , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3184     run macr_excel_char ( buf_temp_result-line.supp-string  , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3185     run macr_excel_char ( buf_temp_result-line.supp-name    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3186     run macr_excel_char ( buf_temp_result-line.part-code    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3187     run macr_excel_dec  ( (if p-free then buf_temp_result-line.free-qnty else buf_temp_result-line.fact-qnty)    , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3188     run macr_excel_char ( substitute("&1&2 &3" , buf_temp_result-line.obj-type ,buf_temp_result-line.obj-code, buf_temp_result-line.pl-name )  , num#str#,  num#col# )              . num#col# = num#col# + 1 .
     3189     run macr_excel_char ( string ( buf_temp_result-line.last-date, "99/99/9999"), num#str#, num#col#  ). num#col# = num#col# + 1 .
     3190     v-summi = v-summi + (if p-free then buf_temp_result-line.free-qnty else buf_temp_result-line.fact-qnty) .
     3191   end.
     3192   end procedure.
     3193   procedure print-classificator :
     3194   define input parameter p-one as logical   no-undo .
     3195   define input parameter p-class-order    as integer          no-undo.
     3196       define buffer buf_temp_classificator        for temp_classificator.
     3197   do
     3198   for buf_temp_classificator
     3199   on error undo, return error
     3200   :
     3201       find first buf_temp_classificator
     3202            where buf_temp_classificator.class-order = p-class-order
     3203       .
     3204       if buf_temp_classificator.class-code = "no-classify":U
     3205       then do:
     3206           undo, return .
     3207       end.
     3208   if p-one = true then do:
     3209       if v-r-sroki-first-line-printed = no
     3210       then do:
     3211           assign
     3212               v-r-sroki-first-line-printed = yes
     3213           .
     3214       end.
     3215       else do:
     3216           put stream out-stream
     3217               skip space(2)
     3218                   "|" v-r-sroki-single-line format "X(193)" "|"
     3219           .
     3220       end.
     3221       put stream out-stream
     3222           skip space(2)
     3223                   "|"
     3224                   buf_temp_classificator.class1-value format "X(193)"
     3225                   "|"             at 2 + 195
     3226       .
     3227     num#str# = num#str# + 1 .
     3228     num#col# =  1 .
     3229     var-1 = num#str# .
     3230     var-2 = num#col# .
     3231     run macr_excel_char(  buf_temp_classificator.class1-value , num#str# , num#col#  ).  num#col# = num#col# + 1.
     3232     run macr_cell_format
     3233     ( 10    ,
     3234       true  ,
     3235       true  ,
     3236       40    ,
     3237       var-1 ,
     3238       var-2 ,
     3239       num#str# ,
     3240       10 ) .
     3241   end.
     3242       if buf_temp_classificator.class2-key <> ""
     3243       then do:
     3244           put stream out-stream
     3245               skip space(2)
     3246                   "|" v-r-sroki-single-line format "X(193)" "|"
     3247               skip space(2)
     3248                   "|"
     3249                   buf_temp_classificator.class2-value format "X(193)"
     3250                   "|"             at 2 + 195
     3251           .
     3252           num#str# = num#str# + 1 .
     3253           num#col# =  1 .
     3254           var-1 = num#str# .
     3255           var-2 = num#col# .
     3256           run macr_excel_char ( buf_temp_classificator.class2-value     , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3257           run macr_cell_format
     3258           ( 10    ,
     3259             true  ,
     3260             true  ,
     3261             33    ,
     3262             var-1 ,
     3263             var-2 ,
     3264             num#str# ,
     3265             10 ) .
     3266       end.
     3267   end.
     3268   end procedure.
     3269   procedure print-footer :
     3270   do
     3271   on error undo, return error
     3272   :
     3273       put stream out-stream
     3274           skip space(2)
     3275               v-r-sroki-single-line   format "X(195)" skip
     3276       .
     3277       put stream out-stream unformatted  " Итого количество: "  v-summi skip.
     3278           num#str# = num#str# + 1 .
     3279           num#col# =  1 .
     3280           var-1 = num#str# .
     3281           var-2 = num#col# .
     3282           run macr_excel_char ( "ИТОГО"     , num#str# , num#col#  ) . num#col# = num#col# + 7 .
     3283           run macr_excel_dec ( v-summi     , num#str# , num#col#  ) . num#col# = num#col# + 1 .
     3284           run macr_cell_format
     3285           ( 10     ,
     3286             true   ,
     3287             false  ,
     3288             ?    ,
     3289             var-1 ,
     3290             var-2 ,
     3291             num#str# ,
     3292             10 ) .
     3293   end.
     3294   end procedure.
     3295   def var vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3296   procedure macr_excel_char :
     3297    do
     3298    on error undo, return error return-value
     3299    :
     3300    define input parameter  p-val as character no-undo .
     3301    define input parameter  p-row as integer no-undo .
     3302    define input parameter  p-col as integer no-undo .
     3303    if p-val = ? then p-val = "" .
     3304       put stream macr_excel unformatted
     3305             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3306    end.
     3307   end procedure.
     3308   procedure macr_excel_char_with_format :
     3309    do
     3310    on error undo, return error return-value
     3311    :
     3312    define input parameter  p-val as character no-undo .
     3313    define input parameter  p-row as integer no-undo .
     3314    define input parameter  p-col as integer no-undo .
     3315    if p-val = ? then p-val = "" .
     3316       put stream macr_excel unformatted
     3317             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3318       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     3319       put stream macr_excel unformatted
     3320             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3321    end.
     3322   end procedure.
     3323   procedure macr_excel_cell_format :
     3324    do
     3325    on error undo, return error return-value
     3326    :
     3327    define input parameter  p-val    as character no-undo .
     3328    define input parameter  p-row    as integer   no-undo .
     3329    define input parameter  p-col    as integer   no-undo .
     3330    define input parameter  p-format as character no-undo .
     3331    if p-val = ? then p-val = "" .
     3332       put stream macr_excel unformatted
     3333             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3334       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     3335       put stream macr_excel unformatted
     3336             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3337    end.
     3338   end procedure.
     3339   procedure macr_excel_sum :
     3340    do
     3341    on error undo, return error return-value
     3342    :
     3343    define input parameter  p-row as integer no-undo .
     3344    define input parameter  p-col as integer no-undo .
     3345    define input parameter  p-row1 as integer no-undo .
     3346    define input parameter  p-col1 as integer no-undo .
     3347    define input parameter  p-row2 as integer no-undo .
     3348    define input parameter  p-col2 as integer no-undo .
     3349       put stream macr_excel unformatted
     3350             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     3351    end.
     3352   end procedure.
     3353   procedure macr_excel_dec :
     3354    do
     3355    on error undo, return error return-value
     3356    :
     3357    define input parameter  p-val as character no-undo .
     3358    define input parameter  p-row as integer   no-undo .
     3359    define input parameter  p-col as integer   no-undo .
     3360     if p-val = ? then p-val =  "" .
     3361      put  stream macr_excel unformatted
     3362           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     3363    end.
     3364   end procedure.
     3365   procedure macr_cell_format :
     3366    do
     3367    on error undo, return error return-value
     3368    :
     3369    define input parameter  p-size   as integer   no-undo .
     3370    define input parameter  p-bold   as logical   no-undo .
     3371    define input parameter  p-italic as logical   no-undo .
     3372    define input parameter  p-color  as integer   no-undo .
     3373    define input parameter  p-row    as integer   no-undo .
     3374    define input parameter  p-col    as integer   no-undo .
     3375    define input parameter  p-row-2  as integer   no-undo .
     3376    define input parameter  p-col-2  as integer   no-undo .
     3377     if p-size = ? then p-size = 10 .
     3378     if p-bold = ? then p-bold = false .
     3379     if p-italic = ? then p-italic = false .
     3380     if p-row-2 = ? then p-row-2 = p-row .
     3381     if p-col-2 = ? then p-col-2 = p-col .
     3382     put  stream macr_excel unformatted
     3383      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     3384     if p-color <> ? then do:
     3385        put  stream macr_excel unformatted
     3386          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     3387     end.
     3388     put  stream macr_excel unformatted
     3389          substitute('format.font(,&1,&2,&3)' , p-size,
     3390                                           string ( p-bold  , "true/false" ) ,
     3391                                           string ( p-italic , "true/false" )
     3392                                           ) + chr(10) .
     3393    end.
     3394   end procedure.
     3395   procedure macr_cell_size :
     3396    do
     3397    on error undo, return error return-value
     3398    :
     3399    define input parameter  p-w   as integer   no-undo .
     3400    define input parameter  p-l   as integer   no-undo .
     3401    define input parameter  p-row    as integer   no-undo .
     3402    define input parameter  p-col    as integer   no-undo .
     3403    define input parameter  p-row-2  as integer   no-undo .
     3404    define input parameter  p-col-2  as integer   no-undo .
     3405     if p-row-2 = ? then p-row-2 = p-row .
     3406     if p-col-2 = ? then p-col-2 = p-col .
     3407     if p-w = ? then    p-w = 0 .
     3408     if p-l = ? then    p-l = 0 .
     3409    define variable s-w as character no-undo .
     3410    define variable s-l as character no-undo .
     3411    if p-w = 0 then s-w = "" .
     3412               else s-w = string(p-w)  .
     3413    if p-l = 0 then s-l = "" .
     3414               else s-l = string(p-l)  .
     3415   put  stream macr_excel unformatted
     3416        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     3417   put  stream macr_excel unformatted
     3418        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     3419   put  stream macr_excel unformatted
     3420        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     3421    end.
     3422   end procedure.
     3423   procedure proc-print-header :
     3424    do
     3425    on error undo, return error return-value
     3426    :
     3427      find first sheetf .
     3428        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3429        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3430        var-1 =  num#str# .
     3431        repeat c-c = 1 to sheetf.excel-row-title :
     3432        num#str# = num#str# + 1 .
     3433        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3434        do c-i = 1 to p-var :
     3435           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3436           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3437           num#col# = c-i .
     3438           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     3439           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3440        end.
     3441       c-i = 0.
     3442       end.
     3443       run macr_cell_format (
     3444           10       ,
     3445           true     ,
     3446           false    ,
     3447           35       ,
     3448           var-1 + 1,
     3449           1        ,
     3450           num#str# ,
     3451           num#col# )
     3452           .
     3453     put  stream macr_excel unformatted
     3454          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3455          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     3456          .
     3457    end.
     3458   end procedure.
     3459   procedure end-proc :
     3460    do
     3461    on error undo, return error return-value
     3462    :
     3463     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     3464     OUTPUT to VALUE (v-file-name) .
     3465     for each temp-param :
     3466       export  temp-param  .
     3467     end.
     3468    end.
     3469   end procedure.
