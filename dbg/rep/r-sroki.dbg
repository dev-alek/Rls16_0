     1902   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1903   procedure godendo-date-to-offset :
     1904     define input  parameter p-today  as date      no-undo .
     1905     define input  parameter p-date   as date      no-undo .
     1906     define output parameter p-offset as integer   no-undo .
     1907     do
     1908     on error undo, return error return-value
     1909     :
     1910       if p-date  = ?
     1911       or p-today = ?
     1912       then do:
     1913         assign
     1914           p-offset = ?
     1915         .
     1916       end.
     1917       else do:
     1918         assign
     1919           p-offset = p-date - p-today + 1
     1920         .
     1921       end.
     1922     end.
     1923   end procedure.
     1924   procedure godendo-offset-to-date :
     1925     define input  parameter p-today  as date      no-undo .
     1926     define input  parameter p-offset as integer   no-undo .
     1927     define output parameter p-date   as date      no-undo .
     1928     do
     1929     on error undo, return error return-value
     1930     :
     1931       if p-today  = ?
     1932       or p-offset = ?
     1933       then do:
     1934         assign
     1935           p-date = ?
     1936         .
     1937       end.
     1938       else do:
     1939         assign
     1940           p-date = p-offset + p-today - 1
     1941         .
     1942       end.
     1943     end.
     1944   end procedure.
