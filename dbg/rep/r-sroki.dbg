     2318     end.
     2319   end procedure.
     2320   procedure paramls-append :
     2321     define input  parameter p-code     as character no-undo .
     2322     define input  parameter p-sub-code as character no-undo .
     2323     define input  parameter p-value    as character no-undo .
     2324     define buffer buf_temp-param for temp-param .
     2325     do
     2326     on error undo, return error return-value
     2327     :
     2328       find first buf_temp-param
     2329            where buf_temp-param.param-code     = p-code
     2330              and buf_temp-param.param-sub-code = p-sub-code
     2331         no-error .
     2332       if not available buf_temp-param then do:
