      572   define variable var-report-r-b as character no-undo .
      573   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      575     (output var-report-r-b
      576     )  .
      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      579   define  shared variable RepPathName        as character no-undo .
      580   define  shared variable PrintRubl          as logical   no-undo .
      581   define variable vss-include-info8 as character format "X(65)" no-undo
      582   initial "@(#)$Workfile$ $Revision$".
      583   define temp-table temp_p-fmt_string-part no-undo
      584       field str-key       as integer
      585       field string-part   as character
      586       index pi is primary unique
      587           str-key
      588   .
      589   define variable v-p-fmt-8-str-key    as integer      no-undo.
      590   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
      591                                     iInput AS INTEGER).
      592     def var v-start-print as integer no-undo .
      593     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      594     assign
      595       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      596     .
      597     RETURN v-start-print .
      598   END FUNCTION.
      599   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      600                                     iInput AS INTEGER).
      601     def var v-start-print as integer no-undo .
      602     assign
      603       v-start-print = INTEGER(iEndPix - 1 - iInput)
      604     .
      605     if v-start-print < 0 then return 0.
      606     RETURN v-start-print .
      607   END FUNCTION.
      608   function p-fmt-align-string returns character (
      609         p-in-string      as character
      610       , p-page-width     as integer
      611       , p-align-type     as character
      612   ).
      613       define variable v-string-length     as integer      no-undo.
      614       define variable v-out-string        as character    no-undo.
      615       assign
      616           v-string-length = length( trim( p-in-string ) )
      617       .
      618       if v-string-length >= p-page-width
      619       then do:
      620           assign
      621               v-out-string = trim( p-in-string )
      622           .
      623       end.
      624       else do:
      625           case p-align-type
      626           :
      627               when 'left':U
      628               then do:
      629                   assign
      630                       v-out-string = trim( p-in-string )
      631                   .
      632               end.
      633               when 'right':U
      634               then do:
      635                   assign
      636                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      637                   .
      638               end.
      639               when 'center':U
      640               then do:
      641                   assign
      642                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      643                   .
      644               end.
      645           end case.
      646       end.
      647       return v-out-string .
      648   end function.
      649   procedure p-fmt-split-string :
      650   define input parameter p-source-string  as character        no-undo.
      651   define input parameter p-split-length   as integer          no-undo.
      652   define output parameter p-string-1      as character        no-undo.
      653   define output parameter p-string-2      as character        no-undo.
      654   do
      655   on error undo, return error
      656   :
      657       define variable v-space-pos    as integer      no-undo.
      658       if length( p-source-string ) <= p-split-length
      659       then do:
      660           assign
      661               p-string-1 = p-source-string
      662           .
      663       end.
      664       else do:
      665           assign
      666               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      667           .
      668           if v-space-pos = 0
      669           then do:
      670               assign
      671                   v-space-pos = index( p-source-string, " ":U )
      672               .
      673           end.
      674           if v-space-pos = 0
      675           then do:
      676               assign
      677                   p-string-1 = substring( p-source-string, 1, p-split-length )
      678                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      679               .
      680           end.
      681           else do:
      682               assign
      683                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      684                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      685               .
      686           end.
      687       end.
      688   end.
      689   end procedure.
      690   procedure p-fmt-round :
      691   define input parameter p-qnty               as decimal          no-undo.
      692   define input parameter p-price-no-VAT       as decimal          no-undo.
      693   define input parameter p-VAT                as decimal          no-undo.
      694   define input parameter p-SLT                as decimal          no-undo.
      695   define input parameter p-road-tax           as decimal          no-undo.
      696   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      697   define output parameter p-new-VAT           as decimal          no-undo.
      698   define output parameter p-new-SLT           as decimal          no-undo.
      699   define output parameter p-new-sum-VAT       as decimal          no-undo.
      700   define output parameter p-new-sum-SLT       as decimal          no-undo.
      701   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      702   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      703   define output parameter p-new-sum-full      as decimal          no-undo.
      704       define variable v-vat-pc    as decimal      no-undo.
      705       define variable v-slt-pc    as decimal      no-undo.
      706   do
      707   on error undo, return error
      708   :
      709       if p-price-no-VAT = 0
      710       then do:
      711           assign
      712               p-new-price-no-VAT = 0.0
      713               p-new-VAT          = ?
      714               p-new-SLT          = ?
      715               p-new-sum-VAT      = 0.0
      716               p-new-sum-SLT      = 0.0
      717               p-new-sum-no-VAT   = 0.0
      718               p-new-sum-road-tax = 0.0
      719               p-new-sum-full     = 0.0
      720           .
      721       end.
      722       else do:
      723           assign
      724               v-vat-pc            = p-VAT / p-price-no-VAT
      725               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      726               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      727               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      728               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      729               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      730               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      731               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      732               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      733               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      734           .
      735       end.
      736   end.
      737   end procedure.
      738   procedure p-fmt-split :
      739   define input parameter p-in-string      as character        no-undo.
      740   define input parameter p-split-length   as integer          no-undo.
      741       define variable v-start-pos     as integer      no-undo.
      742       define variable v-end-pos       as integer      no-undo.
      743       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      744   do
      745   for buf_temp_p-fmt_string-part
      746   on error undo, return error
      747   :
      748       empty temp-table buf_temp_p-fmt_string-part.
      749       if p-split-length < 1
      750       then do:
      751           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      752       end.
      753       assign
      754           p-in-string                 = trim( p-in-string )
      755           v-p-fmt-8-str-key   = 0
      756           v-start-pos                 = 1
      757           v-end-pos                   = length( p-in-string )
      758       .
      759       run p-fmt-get-string-range in this-procedure (
      760             input p-in-string
      761           , input p-split-length
      762           , input v-start-pos
      763           , output v-start-pos
      764           , output v-end-pos
      765       ).
      766       do while v-end-pos <> 0
      767       :
      768           create buf_temp_p-fmt_string-part.
      769           assign
      770               v-p-fmt-8-str-key = v-p-fmt-8-str-key + 1
      771           .
      772           assign
      773               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-8-str-key
      774               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      775           .
      776           assign
      777               v-start-pos = v-end-pos + 1
      778           .
      779           run p-fmt-get-string-range in this-procedure (
      780                 input p-in-string
      781               , input p-split-length
      782               , input v-start-pos
      783               , output v-start-pos
      784               , output v-end-pos
      785           ).
      786       end.
      787   end.
      788   end procedure.
      789   procedure p-fmt-get-string-range :
      790   define input parameter p-in-string      as character        no-undo.
      791   define input parameter p-split-length   as integer          no-undo.
      792   define input parameter p-old-start-pos  as integer          no-undo.
      793   define output parameter p-start-pos     as integer          no-undo.
      794   define output parameter p-end-pos       as integer          no-undo.
      795       define variable v-init-string    as character    no-undo.
      796       define variable v-temp-char      as character    no-undo.
      797       define variable v-temp-pos       as integer      no-undo.
      798       define variable v-counter        as integer      no-undo.
      799   do
      800   on error undo, return error
      801   :
      802       assign
      803           p-start-pos   = p-old-start-pos
      804           v-init-string = substring( p-in-string, p-start-pos )
      805       no-error.
      806       if error-status :error
      807       or trim( v-init-string ) = "":U
      808       then do:
      809           assign
      810               p-end-pos = 0
      811           .
      812           undo, return .
      813       end.
      814       assign
      815           v-temp-char   = substring( v-init-string, 1, 1 )
      816       .
      817       do
      818       while trim( v-temp-char ) = "":U
      819       :
      820           assign
      821               p-start-pos     = p-start-pos + 1
      822               v-init-string   = substring( p-in-string, p-start-pos )
      823               v-temp-char     = substring( v-init-string, 1, 1 )
      824           .
      825       end.
      826       assign
      827           v-temp-pos  = p-split-length
      828           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      829           v-counter   = 0
      830       .
      831       search-word-end:
      832       do
      833       while trim( v-temp-char ) <> "":U
      834       :
      835           assign
      836               v-counter   = v-counter + 1
      837           .
      838           if v-counter > 20
      839           then do:
      840               assign
      841                   v-temp-pos  = p-split-length
      842               .
      843               leave search-word-end.
      844           end.
      845           assign
      846               v-temp-pos  = v-temp-pos - 1
      847               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      848           .
      849       end.
      850       assign
      851           p-end-pos = p-start-pos + v-temp-pos - 1
      852       .
      853   end.
      854   end procedure.
      855   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      856     if num-entries(string(p-dec), '.') = 2
      857       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      858       else return( string(p-dec)) .
      859   end function.
      860   function format-point-to-comma returns char (input orig as char ) .
      861   define variable rtext as character no-undo .
      862   define variable strt as integer no-undo .
      863   define variable leng as integer no-undo .
      864   assign rtext = orig .
      865   repeat:
      866     strt =  index(rtext,'.').
      867     if strt = 0 then leave.
      868     leng = 1.
      869     substring(rtext,strt,leng,"character") = v-delim .
      870   end.
      871   return rtext.
      872   end function.
      873   function format-excel-text returns char ( input start-text as char ) :
      874   def var  i    as int no-undo.
      875   def var  ch   as char no-undo.
      876   def var  n    as int no-undo.
      877   def var  ipos as int no-undo.
      878     n = num-entries(trim(start-text), chr(10)) - 1 .
      879     do i = 1 to n :
      880       ipos = index( start-text, chr(10)).
      881       if ipos > 0 then
      882         substr( start-text, ipos, 1 ) = ' '.
      883     end.
      884     n = num-entries(trim(start-text), chr(13)) - 1 .
      885     do i = 1 to n :
      886       ipos = index( start-text, chr(13)).
      887       if ipos > 0 then
      888         substr( start-text, ipos, 1 ) = ' '.
      889     end.
      890     if index( start-text, '"' ) = 0 then
      891       start-text =  '="'   + trim( start-text) + '"'   .
      892       else do:
      893         n = num-entries(trim(start-text), '"') - 1.
      894         do i = 1 to n :
      895           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      896         end.
      897         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      898         start-text = '="'  + ch  + '"' .
      899       end.
      900     return start-text.
      901   end.
      902   function excel-sum returns char (input p-dec as decimal ).
      903     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      904   end function.
      905   function excel-qnty returns char (input p-dec as decimal ).
      906     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      907   end function.
      908   function format-excel-text-macr returns char ( input start-text as char ) :
      909   def var  i    as int no-undo.
      910   def var  ch   as char no-undo.
      911   def var  n    as int no-undo.
      912   def var  ipos as int no-undo.
      913     n = num-entries(trim(start-text), chr(10)) - 1 .
      914     do i = 1 to n :
      915       ipos = index( start-text, chr(10)).
      916       if ipos > 0 then
      917         substring( start-text, ipos , 1 ) = ' '.
      918     end.
      919     n = num-entries(trim(start-text), chr(13)) - 1 .
      920     do i = 1 to n :
      921       ipos = index( start-text, chr(13)).
      922       if ipos > 0 then
      923         substring( start-text, ipos, 1 ) = ' '.
      924     end.
      925     if index( start-text, '"' ) = 0 then
      926       start-text =  '"'   + trim( start-text) + '"'   .
      927       else do:
      928         n = num-entries(trim(start-text), '"') - 1.
      929         do i = 1 to n :
      930           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      931         end.
      932         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      933         start-text = '"'  + ch  + '"' .
      934       end.
      935     n = num-entries(trim(start-text), chr(10)) - 1 .
      936     do i = 1 to n :
      937       ipos = index( start-text, chr(10)).
      938       if ipos > 0 then
      939         substring( start-text, ipos , 1 ) = ' '.
      940     end.
      941       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      942     return start-text.
      943   end.
      944   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      945   define temp-table temp-parts no-undo   like ub.parts   field free-qnty as decimal   field free-cli-qnty as decimal .
      946   procedure partslib-clear-temp-parts :
      947     define buffer buf_temp-parts for temp-parts .
      948     do
      949     on error undo, return error
      950     :
      951       for each buf_temp-parts
      952       on error undo, return error
      953       :
      954         delete buf_temp-parts .
      955       end.
      956     end.
      957   end procedure.
      958   procedure partslib-create-temp-parts :
      959     define parameter buffer buf_parts       for ub.parts .
      960     define parameter buffer buf_temp-parts  for temp-parts .
      961     define input  parameter p-goods-twounit as logical   no-undo .
      962     define variable v-base-part-code as character no-undo .
      963     do
      964     on error undo, return error
      965     :
      966       if p-goods-twounit = true
      967       then do:
      968         assign
      969           v-base-part-code = entry(1, buf_parts.part-code, '#':U)
      970         .
      971       end.
      972       else do:
      973         assign
      974           v-base-part-code = buf_parts.part-code
      975         .
      976       end.
      977       find first buf_temp-parts exclusive-lock
      978         where buf_temp-parts.obj-type  = buf_parts.obj-type
      979           and buf_temp-parts.obj-code  = buf_parts.obj-code
      980           and buf_temp-parts.artic     = buf_parts.artic
      981           and buf_temp-parts.prod-type = buf_parts.prod-type
      982           and buf_temp-parts.prod-code = buf_parts.prod-code
      983           and buf_temp-parts.in-code   = buf_parts.in-code
      984           and buf_temp-parts.out-code  = 'free-zone':U
      985           and buf_temp-parts.part-code = v-base-part-code
      986         no-error.
      987       if not available buf_temp-parts
      988       then do:
      989         create buf_temp-parts .
      990         buffer-copy buf_parts to buf_temp-parts
      991         assign
      992           buf_temp-parts.out-code  = 'free-zone':U
      993           buf_temp-parts.part-code = v-base-part-code
      994           buf_temp-parts.rsrv-free = yes
      995           buf_temp-parts.status_   = no
      996           buf_temp-parts.qnty      = 0
      997           buf_temp-parts.fact-qnty = 0
      998           buf_temp-parts.real-qnty = 0
      999           buf_temp-parts.cli-qnty  = 0
     1000         .
     1001       end.
     1002     end.
     1003   end procedure.
     1004   procedure partslib-init-temp-parts :
     1005     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1006     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1007     define input parameter p-artic           like ub.parts.artic     no-undo .
     1008     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1009     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1010     define buffer buf_parts      for ub.parts .
     1011     define buffer buf_temp-parts for temp-parts .
     1012     define variable v-goods-twounit    as logical   no-undo .
     1013     do
     1014     on error undo, return error
     1015     :
     1016   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1017   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1018     (input  p-artic
     1019     ,input  p-prod-type
     1020     ,input  p-prod-code
     1021     ,input  'twounit=request':u
     1022     ,output v-goods-twounit
     1023     ) no-error .
     1024       if error-status :error
     1025       then do:
     1026         message
     1027           vss-workfile vss-revision vss-description skip
     1028           vss-include-info9 skip
     1029           "Ошибка при определении атрибута товара" skip
     1030           "Артикул" p-artic p-prod-type p-prod-code skip
     1031           "twounit=request" skip
     1032           error-status :get-message(1) skip
     1033           return-value skip
     1034           view-as alert-box error .
     1035         undo, return error return-value .
     1036       end.
     1037       run partslib-clear-temp-parts in this-procedure .
     1038       for each buf_parts
     1039         where buf_parts.obj-type  = p-obj-type
     1040           and buf_parts.obj-code  = p-obj-code
     1041           and buf_parts.artic     = p-artic
     1042           and buf_parts.prod-type = p-prod-type
     1043           and buf_parts.prod-code = p-prod-code
     1044           and buf_parts.rsrv-free = yes
     1045           and buf_parts.status_   = no
     1046           and buf_parts.in-code   <> buf_parts.out-code
     1047       on error undo, return error
     1048       :
     1049         run partslib-create-temp-parts in this-procedure
     1050           (buffer buf_parts
     1051           ,buffer buf_temp-parts
     1052           ,input  v-goods-twounit
     1053           ) .
     1054         define variable v-parts-qnty          as decimal   no-undo .
     1055         define variable v-parts-cli-qnty      as decimal   no-undo .
     1056         define variable v-parts-free-qnty     as decimal   no-undo .
     1057         define variable v-parts-free-cli-qnty as decimal   no-undo .
     1058         if buf_parts.out-code = 'free-zone':U
     1059         then do:
     1060           assign
     1061             v-parts-qnty          = buf_parts.qnty
     1062             v-parts-cli-qnty      = buf_parts.cli-qnty
     1063             v-parts-free-qnty     = buf_parts.qnty
     1064             v-parts-free-cli-qnty = buf_parts.cli-qnty
     1065           .
     1066         end.
     1067         else do:
     1068           assign
     1069             v-parts-qnty          = abs(buf_parts.qnty)
     1070             v-parts-cli-qnty      = abs(buf_parts.cli-qnty)
     1071             v-parts-free-qnty     = 0
     1072             v-parts-free-cli-qnty = 0
     1073           .
     1074         end.
     1075         assign
     1076           buf_temp-parts.qnty          = buf_temp-parts.qnty          + v-parts-qnty
     1077           buf_temp-parts.fact-qnty     = buf_temp-parts.fact-qnty     + v-parts-qnty
     1078           buf_temp-parts.real-qnty     = 0
     1079           buf_temp-parts.cli-qnty      = buf_temp-parts.cli-qnty      + v-parts-cli-qnty
     1080           buf_temp-parts.free-qnty     = buf_temp-parts.free-qnty     + v-parts-free-qnty
     1081           buf_temp-parts.free-cli-qnty = buf_temp-parts.free-cli-qnty + v-parts-free-cli-qnty
     1082         .
     1083       end.
     1084     end.
     1085   end procedure.
     1086   procedure partslib-init-temp-parts-by-factord :
     1087     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1088     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1089     define input parameter p-artic              like ub.parts.artic     no-undo .
     1090     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1091     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1092     define input parameter p-fact-order         as decimal   no-undo .
     1093     define input parameter p-include-fact-order as logical   no-undo .
     1094     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1095     define buffer buf_gds-obj  for ub.gds-obj .
     1096     do
     1097     on error undo, return error
     1098     :
     1099       do transaction
     1100       on error undo, return error
     1101       :
     1102   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1103   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1104     (input  p-obj-type
     1105     ,input  p-obj-code
     1106     ,input  p-artic
     1107     ,input  p-prod-type
     1108     ,input  p-prod-code
     1109     ,buffer buf_gds-obj
     1110     ) no-error .
     1111         if error-status :error
     1112         then do:
     1113           message
     1114             vss-workfile vss-revision vss-description skip
     1115             vss-include-info9 skip
     1116             "Невозможно найти товар на объекте" skip
     1117             "Объект" p-obj-type p-obj-code skip
     1118             "Артикул" p-artic p-prod-type p-prod-code skip
     1119             error-status :get-message(1) skip
     1120             return-value skip
     1121             view-as alert-box error .
     1122           undo, return error .
     1123         end.
     1124         find current buf_gds-obj exclusive-lock .
     1125       end.
     1126       run partslib-init-temp-parts in this-procedure
     1127         (input p-obj-type
     1128         ,input p-obj-code
     1129         ,input p-artic
     1130         ,input p-prod-type
     1131         ,input p-prod-code
     1132         ) no-error .
     1133       if error-status :error
     1134       then do:
     1135         message
     1136           vss-workfile vss-revision vss-description skip
     1137           vss-include-info9 skip
     1138           "Ошибка при инициализации текущего остатка по партиям свободной зоны" skip
     1139           "Объект" p-obj-type p-obj-code skip
     1140           "Артикул" p-artic p-prod-type p-prod-code skip
     1141           "p-fact-order" p-fact-order skip
     1142           view-as alert-box error .
     1143         undo, return error .
     1144       end.
     1145       if p-include-fact-order = true
     1146       then do:
     1147         assign
     1148           p-fact-order = p-fact-order - 0.0000000001
     1149         .
     1150       end.
     1151       define variable v-max-fact-order as character no-undo .
     1152       run factord-max-fact-order in this-procedure
     1153         (output v-max-fact-order
     1154         ) no-error .
     1155       if error-status :error
     1156       then do:
     1157         message
     1158           vss-workfile vss-revision vss-description skip
     1159           vss-include-info9 skip
     1160           "Ошибка при вызове процедуры factord-max-fact-order" skip
     1161           "Объект" p-obj-type p-obj-code skip
     1162           "Артикул" p-artic p-prod-type p-prod-code skip
     1163           "p-fact-order" p-fact-order skip
     1164           view-as alert-box error .
     1165         undo, return error .
     1166       end.
     1167       run partslib-update-by-factord in this-procedure
     1168         (input p-obj-type
     1169         ,input p-obj-code
     1170         ,input p-artic
     1171         ,input p-prod-type
     1172         ,input p-prod-code
     1173         ,input p-fact-order
     1174         ,input v-max-fact-order
     1175         ,input false
     1176         ) no-error .
     1177       if error-status :error
     1178       then do:
     1179         message
     1180           vss-workfile vss-revision vss-description skip
     1181           vss-include-info9 skip
     1182           "Ошибка при вызове процедуры partslib-update-by-factord" skip
     1183           "Объект" p-obj-type p-obj-code skip
     1184           "Артикул" p-artic p-prod-type p-prod-code skip
     1185           "p-fact-order" p-fact-order skip
     1186           "v-max-fact-order" v-max-fact-order skip
     1187           view-as alert-box error .
     1188         undo, return error .
     1189       end.
     1190     end.
     1191   end procedure.
     1192   procedure partslib-update-by-factord :
     1193     define input parameter p-obj-type           like ub.parts.obj-type  no-undo .
     1194     define input parameter p-obj-code           like ub.parts.obj-code  no-undo .
     1195     define input parameter p-artic              like ub.parts.artic     no-undo .
     1196     define input parameter p-prod-type          like ub.parts.prod-type no-undo .
     1197     define input parameter p-prod-code          like ub.parts.prod-code no-undo .
     1198     define input parameter p-start-fact-order   as decimal   no-undo .
     1199     define input parameter p-end-fact-order     as decimal   no-undo .
     1200     define input parameter p-lock-gds-obj       as logical   no-undo .
     1201     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-factord: определение партий свободной зоны на любую дату".
     1202     define buffer buf_gds-obj  for ub.gds-obj .
     1203     define buffer buf_doc-line for ub.doc-line .
     1204     define variable v-total-parts-qnty as decimal   no-undo .
     1205     define variable v-goods-gds-goods  as logical   no-undo .
     1206     define variable v-goods-twounit    as logical   no-undo .
     1207     do
     1208     on error undo, return error
     1209     :
     1210       if p-start-fact-order > p-end-fact-order
     1211       then do:
     1212         message
     1213           vss-workfile vss-revision vss-description skip
     1214           vss-include-info9 skip
     1215           "Ошибка задания входных параметров" skip
     1216           "Начало интервала превышает конец интервала" skip
     1217           "Объект" p-obj-type p-obj-code skip
     1218           "Артикул" p-artic p-prod-type p-prod-code skip
     1219           "p-start-fact-order" p-start-fact-order skip
     1220           "p-end-fact-order"   p-end-fact-order skip
     1221           view-as alert-box error .
     1222         undo, return error .
     1223       end.
     1224       if p-lock-gds-obj = true
     1225       then do:
     1226         do transaction
     1227         on error undo, return error
     1228         :
     1229   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1230   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     1231     (input  p-obj-type
     1232     ,input  p-obj-code
     1233     ,input  p-artic
     1234     ,input  p-prod-type
     1235     ,input  p-prod-code
     1236     ,buffer buf_gds-obj
     1237     ) no-error .
     1238           if error-status :error
     1239           then do:
     1240             message
     1241               vss-workfile vss-revision vss-description skip
     1242               vss-include-info9 skip
     1243               "Невозможно найти gds-obj" skip
     1244               error-status :get-message(1) skip
     1245               return-value skip
     1246               view-as alert-box error .
     1247             undo, return error .
     1248           end.
     1249           find current buf_gds-obj exclusive-lock .
     1250         end.
     1251       end.
     1252   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1253   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1254     (input  p-artic
     1255     ,input  p-prod-type
     1256     ,input  p-prod-code
     1257     ,input  'gds-goods=request':u
     1258     ,output v-goods-gds-goods
     1259     ) no-error .
     1260       if error-status :error
     1261       then do:
     1262         message
     1263           vss-workfile vss-revision vss-description skip
     1264           vss-include-info9 skip
     1265           "Ошибка при определении атрибута товара" skip
     1266           "Артикул" p-artic p-prod-type p-prod-code skip
     1267           "gds-goods=request" skip
     1268           error-status :get-message(1) skip
     1269           return-value skip
     1270           view-as alert-box error .
     1271         undo, return error return-value .
     1272       end.
     1273   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1274   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     1275     (input  p-artic
     1276     ,input  p-prod-type
     1277     ,input  p-prod-code
     1278     ,input  'twounit=request':u
     1279     ,output v-goods-twounit
     1280     ) no-error .
     1281       if error-status :error
     1282       then do:
     1283         message
     1284           vss-workfile vss-revision vss-description skip
     1285           vss-include-info9 skip
     1286           "Ошибка при определении атрибута товара" skip
     1287           "Артикул" p-artic p-prod-type p-prod-code skip
     1288           "twounit=request" skip
     1289           error-status :get-message(1) skip
     1290           return-value skip
     1291           view-as alert-box error .
     1292         undo, return error return-value .
     1293       end.
     1294       for each buf_doc-line no-lock
     1295         where buf_doc-line.obj-type   = p-obj-type
     1296           and buf_doc-line.obj-code   = p-obj-code
     1297           and buf_doc-line.artic      = p-artic
     1298           and buf_doc-line.prod-type  = p-prod-type
     1299           and buf_doc-line.prod-code  = p-prod-code
     1300           and buf_doc-line.status_    = 'факт':U
     1301           and buf_doc-line.fact-order > p-start-fact-order
     1302           and buf_doc-line.fact-order <= p-end-fact-order
     1303       on error undo, return error
     1304       :
     1305         run partslib-process-document in this-procedure
     1306           (input  buf_doc-line.doc-code
     1307           ,input  p-obj-type
     1308           ,input  p-obj-code
     1309           ,input  p-artic
     1310           ,input  p-prod-type
     1311           ,input  p-prod-code
     1312           ,input  v-goods-gds-goods
     1313           ,input  v-goods-twounit
     1314           ,output v-total-parts-qnty
     1315           ) no-error .
     1316         if error-status :error
     1317         then do:
     1318           message
     1319             vss-workfile vss-revision vss-description skip
     1320             vss-include-info9 skip
     1321             "Ошибка при вызове процедуры partslib-process-document" skip
     1322             "Документ" buf_doc-line.doc-code skip
     1323             "Объект" p-obj-type p-obj-code skip
     1324             "Артикул" p-artic p-prod-type p-prod-code skip
     1325             "p-start-fact-order" p-start-fact-order skip
     1326             "p-end-fact-order" p-end-fact-order skip
     1327             error-status :get-message(1) skip
     1328             return-value skip
     1329             view-as alert-box error .
     1330           undo, return error return-value .
     1331         end.
     1332       end.
     1333     end.
     1334   end procedure.
     1335   procedure partslib-process-document :
     1336     define input  parameter p-doc-code         as character no-undo .
     1337     define input  parameter p-obj-type         as character no-undo .
     1338     define input  parameter p-obj-code         as integer   no-undo .
     1339     define input  parameter p-artic            as character no-undo .
     1340     define input  parameter p-prod-type        as character no-undo .
     1341     define input  parameter p-prod-code        as integer   no-undo .
     1342     define input  parameter p-goods-gds-goods  as logical   no-undo .
     1343     define input  parameter p-goods-twounit    as logical   no-undo .
     1344     define output parameter p-total-parts-qnty as decimal   no-undo .
     1345     define variable v-parts-sign as integer   no-undo .
     1346     define buffer buf_trn-doc    for ub.trn-doc .
     1347     define buffer buf_doc-line   for ub.doc-line .
     1348     define buffer buf_parts      for ub.parts .
     1349     define buffer buf_temp-parts for temp-parts .
     1350     do
     1351     on error undo, return error return-value
     1352     :
     1353       find first buf_trn-doc no-lock
     1354         where buf_trn-doc.doc-code = p-doc-code
     1355         no-error .
     1356       if not available buf_trn-doc
     1357       then do:
     1358         undo, return error substitute("Ошибка при поиске документа. Документ &1"
     1359                                      ,p-doc-code
     1360                                      ) .
     1361       end.
     1362       case buf_trn-doc.doc-type
     1363       :
     1364         when 'при':U or
     1365         when 'возврат':U or
     1366         when 'инв':U
     1367         then do:
     1368           assign
     1369             v-parts-sign = -1
     1370           .
     1371         end.
     1372         when 'рас':U or
     1373         when 'спи':U
     1374         then do:
     1375           assign
     1376             v-parts-sign = 1
     1377           .
     1378         end.
     1379         otherwise do:
     1380           undo, return error substitute("Неизвестный тип документа &1"
     1381                                       ,buf_trn-doc.doc-type
     1382                                       ) .
     1383         end.
     1384       end.
     1385       find first buf_doc-line no-lock
     1386         where buf_doc-line.doc-code  = p-doc-code
     1387           and buf_doc-line.artic     = p-artic
     1388           and buf_doc-line.prod-type = p-prod-type
     1389           and buf_doc-line.prod-code = p-prod-code
     1390         no-error .
     1391       if not available buf_doc-line
     1392       then do:
     1393         undo, return error substitute("Ошибка при поиске строки документа. Документ &1. Артикул &2 &3 &4"
     1394                                      ,p-doc-code
     1395                                      ,artic
     1396                                      ,prod-type
     1397                                      ,prod-code
     1398                                      ) .
     1399       end.
     1400       assign
     1401         p-total-parts-qnty = 0
     1402       .
     1403       if p-goods-gds-goods = true
     1404       then do:
     1405         for each buf_parts no-lock
     1406           where buf_parts.out-code  = p-doc-code
     1407             and buf_parts.obj-type  = p-obj-type
     1408             and buf_parts.obj-code  = p-obj-code
     1409             and buf_parts.artic     = p-artic
     1410             and buf_parts.prod-type = p-prod-type
     1411             and buf_parts.prod-code = p-prod-code
     1412         on error undo, return error
     1413         :
     1414           run partslib-create-temp-parts in this-procedure
     1415             (buffer buf_parts
     1416             ,buffer buf_temp-parts
     1417             ,input  p-goods-twounit
     1418             ) .
     1419           assign
     1420             p-total-parts-qnty        = p-total-parts-qnty
     1421                                       + v-parts-sign * buf_parts.fact-qnty
     1422             buf_temp-parts.qnty       = buf_temp-parts.qnty
     1423                                       + v-parts-sign * buf_parts.fact-qnty
     1424             buf_temp-parts.fact-qnty  = buf_temp-parts.fact-qnty
     1425                                       + v-parts-sign * buf_parts.fact-qnty
     1426             buf_temp-parts.cli-qnty   = buf_temp-parts.cli-qnty
     1427                                       + v-parts-sign * buf_parts.cli-qnty
     1428           .
     1429           if buf_temp-parts.qnty = 0
     1430           then do:
     1431             delete buf_temp-parts .
     1432           end.
     1433         end.
     1434       end.
     1435       else do:
     1436         assign
     1437           p-total-parts-qnty = p-total-parts-qnty
     1438                              + v-parts-sign * buf_doc-line.fact-qnty
     1439         .
     1440       end.
     1441     end.
     1442   end procedure.
     1443   procedure partslib-init-temp-parts-by-date :
     1444     define input parameter p-obj-type        like ub.parts.obj-type  no-undo .
     1445     define input parameter p-obj-code        like ub.parts.obj-code  no-undo .
     1446     define input parameter p-artic           like ub.parts.artic     no-undo .
     1447     define input parameter p-prod-type       like ub.parts.prod-type no-undo .
     1448     define input parameter p-prod-code       like ub.parts.prod-code no-undo .
     1449     define input parameter p-fact-date       as date      no-undo .
     1450     define variable vss-description as character no-undo init "partslib-init-temp-parts-by-date: определение партий свободной зоны на любую дату".
     1451     do
     1452     on error undo, return error
     1453     :
     1454       define variable v-fact-order                as decimal   no-undo .
     1455       define variable v-shift-end-fact-order      as decimal   no-undo .
     1456       define variable v-day-end-fact-order        as decimal   no-undo .
     1457       run factord in this-procedure
     1458         (input  p-fact-date
     1459         ,input  1
     1460         ,input  1
     1461         ,input  ?
     1462         ,input  0
     1463         ,input  false
     1464         ,output v-fact-order
     1465         ,output v-shift-end-fact-order
     1466         ,output v-day-end-fact-order
     1467         ) no-error .
     1468       if error-status :error
     1469       then do:
     1470         message
     1471           vss-workfile vss-revision vss-description skip
     1472           vss-include-info9 skip
     1473           "Ошибка при определении момента времени, на который требуется остаток" skip
     1474           "Объект" p-obj-type p-obj-code skip
     1475           "Артикул" p-artic p-prod-type p-prod-code skip
     1476           "Дата" p-fact-date skip
     1477           view-as alert-box error .
     1478         undo, return error .
     1479       end.
     1480       run partslib-init-temp-parts-by-factord in this-procedure
     1481         (input p-obj-type
     1482         ,input p-obj-code
     1483         ,input p-artic
     1484         ,input p-prod-type
     1485         ,input p-prod-code
     1486         ,input v-day-end-fact-order
     1487         ,input false
     1488         ) no-error .
     1489       if error-status :error
     1490       then do:
     1491         message
     1492           vss-workfile vss-revision vss-description skip
     1493           vss-include-info9 skip
     1494           "Ошибка при вызове метода partslib-init-temp-parts-by-factord" skip
     1495           "Объект" p-obj-type p-obj-code skip
     1496           "Артикул" p-artic p-prod-type p-prod-code skip
     1497           "Дата" p-fact-date skip
     1498           view-as alert-box error .
     1499         undo, return error .
     1500       end.
     1501     end.
     1502   end procedure.
     1503   procedure partslib-calc-cost :
     1504     define output parameter p-fact-qnty      as decimal   no-undo .
     1505     define output parameter p-vat-pc         as decimal   no-undo .
     1506     define output parameter p-slt-pc         as decimal   no-undo .
     1507     define output parameter p-sum-base       as decimal   no-undo .
     1508     define output parameter p-sum-rubl       as decimal   no-undo .
     1509     define output parameter p-vat-base       as decimal   no-undo .
     1510     define output parameter p-vat-rubl       as decimal   no-undo .
     1511     define output parameter p-slt-base       as decimal   no-undo .
     1512     define output parameter p-slt-rubl       as decimal   no-undo .
     1513     define output parameter p-road-tax-base  as decimal   no-undo .
     1514     define output parameter p-road-tax-rubl  as decimal   no-undo .
     1515     define output parameter p-transport-base as decimal   no-undo .
     1516     define output parameter p-transport-rubl as decimal   no-undo .
     1517     define output parameter p-other-base     as decimal   no-undo .
     1518     define output parameter p-other-rubl     as decimal   no-undo .
     1519     define output parameter p-excise-base    as decimal   no-undo .
     1520     define output parameter p-excise-rubl    as decimal   no-undo .
     1521     define variable vss-description as character no-undo init "partslib-calc-cost: расчет сумм в учетных ценах".
     1522     do
     1523     on error undo, return error return-value
     1524     :
     1525       define buffer buf_temp-parts for temp-parts .
     1526       define buffer   in-vatp-trn-doc  for ub.trn-doc .
     1527       define buffer   in-vatp-parts    for ub.parts   .
     1528       define buffer   in-vatp-doc      for ub.trn-doc .
     1529       define buffer   in-vatp-goods    for ub.goods   .
     1530       define buffer   in-vatp-sysconf  for ub.sysconf .
     1531       define buffer   in-vatp_doc-attr for ub.doc-attr.
     1532       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
     1533       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
     1534       define variable varinvprb                  as   character              no-undo.
     1535       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
     1536       define variable cli-base-rate              as   decimal                no-undo.
     1537       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
     1538       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
     1539       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
     1540       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
     1541       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
     1542       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
     1543       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
     1544       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1545       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
     1546       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
     1547       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
     1548       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
     1549       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
     1550       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
     1551       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
     1552       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
     1553       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
     1554       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
     1555       define variable other-base-loc             like ub.doc-line.price-base no-undo.
     1556       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
     1557       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
     1558       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
     1559       define variable varinvatp-envd             as   character              no-undo.
     1560       define variable varinvatp-type             as   character              no-undo.
     1561       for each buf_temp-parts
     1562       on error undo, return error
     1563       :
     1564   assign
     1565     price-rubl-with-tax-loc = buf_temp-parts.price-rubl
     1566     price-base-with-tax-loc = buf_temp-parts.price-base
     1567   .
     1568   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1569   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1570     (output varinvprb
     1571     )  .
     1572     if buf_temp-parts.out-code = 'free-zone':U     or
     1573        buf_temp-parts.out-code = 'out-zone':U   or
     1574        buf_temp-parts.doc-type = 'акт':U then do:
     1575       assign
     1576         in-vatp-have-vat-slt = yes.
     1577     end.
     1578     else do:
     1579       find first in-vatp_doc-attr no-lock
     1580         where in-vatp_doc-attr.doc-code  = buf_temp-parts.out-code
     1581           and in-vatp_doc-attr.attr-code = 'envd':U
     1582         no-error .
     1583       if not available in-vatp_doc-attr then do:
     1584         assign
     1585           in-vatp-have-vat-slt = yes.
     1586       end.
     1587       else do:
     1588            in-vatp-have-vat-slt = no.
     1589       end.
     1590     end.
     1591     assign
     1592      price-cli-with-tax-loc = buf_temp-parts.price-cli
     1593      cli-base-rate          = buf_temp-parts.cli-base-rate.
     1594     ASSIGN   road-tax-base-loc  = (if buf_temp-parts.road-tax-base  = ? then 0 else buf_temp-parts.road-tax-base)
     1595              road-tax-rubl-loc  = (if buf_temp-parts.road-tax-rubl  = ? then 0 else buf_temp-parts.road-tax-rubl).
     1596     ASSIGN  transport-base-loc = (if buf_temp-parts.transport-base = ? then 0 else buf_temp-parts.transport-base)
     1597             transport-rubl-loc = (if buf_temp-parts.transport-rubl = ? then 0 else buf_temp-parts.transport-rubl)
     1598             other-base-loc     = (if buf_temp-parts.other-base     = ? then 0 else buf_temp-parts.other-base)
     1599             other-rubl-loc     = (if buf_temp-parts.other-rubl     = ? then 0 else buf_temp-parts.other-rubl)
     1600             vat-pc-loc         = (if buf_temp-parts.vat-pc         = ? then 0 else buf_temp-parts.vat-pc)
     1601             slt-pc-loc         = (if buf_temp-parts.slt-pc         = ? then 0 else buf_temp-parts.slt-pc).
     1602             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1603       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1604     assign
     1605       exch-rate-cli-loc = (buf_temp-parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if buf_temp-parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if buf_temp-parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / buf_temp-parts.price-cli .
     1606     assign
     1607       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     1608       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     1609       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     1610       transport-cli-loc  = 0
     1611       other-cli-loc      = 0
     1612     .
     1613   ASSIGN
     1614             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1615       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1616   .
     1617         assign
     1618           p-fact-qnty      = p-fact-qnty      + buf_temp-parts.fact-qnty
     1619           p-vat-pc         = p-vat-pc         + vat-pc-loc
     1620           p-slt-pc         = p-slt-pc         + slt-pc-loc
     1621           p-sum-base       = p-sum-base       + price-base-with-tax-loc * buf_temp-parts.fact-qnty
     1622           p-sum-rubl       = p-sum-rubl       + price-rubl-with-tax-loc * buf_temp-parts.fact-qnty
     1623           p-vat-base       = p-vat-base       + vat-base-loc            * buf_temp-parts.fact-qnty
     1624           p-vat-rubl       = p-vat-rubl       + vat-rubl-loc            * buf_temp-parts.fact-qnty
     1625           p-slt-base       = p-slt-base       + slt-base-loc            * buf_temp-parts.fact-qnty
     1626           p-slt-rubl       = p-slt-rubl       + slt-rubl-loc            * buf_temp-parts.fact-qnty
     1627           p-road-tax-base  = p-road-tax-base  + road-tax-base-loc       * buf_temp-parts.fact-qnty
     1628           p-road-tax-rubl  = p-road-tax-rubl  + road-tax-rubl-loc       * buf_temp-parts.fact-qnty
     1629           p-transport-base = p-transport-base + transport-base-loc      * buf_temp-parts.fact-qnty
     1630           p-transport-rubl = p-transport-rubl + transport-rubl-loc      * buf_temp-parts.fact-qnty
     1631           p-other-base     = p-other-base     + other-base-loc          * buf_temp-parts.fact-qnty
     1632           p-other-rubl     = p-other-rubl     + other-rubl-loc          * buf_temp-parts.fact-qnty
     1633           p-excise-base    = p-excise-base    + 0
     1634           p-excise-rubl    = p-excise-rubl    + 0
     1635         .
     1636       end.
     1637       if p-fact-qnty      = ?
     1638       or p-sum-base       = ?
     1639       or p-sum-rubl       = ?
     1640       or p-vat-base       = ?
     1641       or p-vat-rubl       = ?
     1642       or p-slt-base       = ?
     1643       or p-slt-rubl       = ?
     1644       or p-road-tax-base  = ?
     1645       or p-road-tax-rubl  = ?
     1646       or p-transport-base = ?
     1647       or p-transport-rubl = ?
     1648       or p-other-base     = ?
     1649       or p-other-rubl     = ?
     1650       or p-excise-base    = ?
     1651       or p-excise-rubl    = ?
     1652       then do:
     1653         message
     1654           vss-workfile vss-revision vss-description skip
     1655           vss-include-info9 skip
     1656           "Программа in-vatp.i вернула неопределенные значения" skip
     1657           "p-fact-qnty"      p-fact-qnty      skip
     1658           "p-sum-base"       p-sum-base       skip
     1659           "p-sum-rubl"       p-sum-rubl       skip
     1660           "p-vat-base"       p-vat-base       skip
     1661           "p-vat-rubl"       p-vat-rubl       skip
     1662           "p-slt-base"       p-slt-base       skip
     1663           "p-slt-rubl"       p-slt-rubl       skip
     1664           "p-road-tax-base"  p-road-tax-base  skip
     1665           "p-road-tax-rubl"  p-road-tax-rubl  skip
     1666           "p-transport-base" p-transport-base skip
     1667           "p-transport-rubl" p-transport-rubl skip
     1668           "p-other-base"     p-other-base     skip
     1669           "p-other-rubl"     p-other-rubl     skip
     1670           "p-excise-base"    p-excise-base    skip
     1671           "p-excise-rubl"    p-excise-rubl    skip
     1672           view-as alert-box error .
     1673         undo, return error .
     1674       end.
     1675     end.
     1676   end procedure.
     1677   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1678   procedure cur-time :
     1679      define output parameter p-today as date      no-undo .
     1680      define output parameter p-time  as integer   no-undo .
     1681     do
     1682     on error undo, return error
     1683     :
     1684       define variable v-date1 as date      no-undo .
     1685       define variable v-date2 as date      no-undo .
     1686       define variable v-time  as integer   no-undo .
     1687       assign
     1688         v-date1 = today
     1689         v-time  = time
     1690         v-date2 = today
     1691       .
     1692       if v-date1 <> v-date2
     1693       then do:
     1694         assign
     1695           v-date1 = today
     1696           v-time  = v-time
     1697         .
     1698       end.
     1699       assign
     1700         p-today = v-date1
     1701         p-time  = v-time
     1702       .
     1703     end.
     1704   end.
     1705   function cur-time-date returns character
     1706   :
     1707     return string(today, '99/99/9999':U) .
     1708   end.
     1709   function cur-time-mjd returns decimal
     1710   :
     1711     define variable v-date as date      no-undo .
     1712     define variable v-time as integer   no-undo .
     1713     run cur-time in this-procedure
     1714       (output v-date
     1715       ,output v-time
     1716       ) .
     1717     return integer(v-date) - 2400002 + (v-time / 86400) .
     1718   end.
     1719   function cur-time-get-ending-index returns integer
     1720   (input p-number as integer
     1721   )
     1722   :
     1723     if p-number < 0
     1724     or p-number = ?
     1725     then do:
     1726       return 1 .
     1727     end.
     1728     define variable v-rest as integer   no-undo .
     1729     assign
     1730       p-number = p-number modulo 100
     1731     .
     1732     if p-number < 20
     1733     then do:
     1734       assign
     1735         v-rest = p-number
     1736       .
     1737     end.
     1738     else do:
     1739       assign
     1740         v-rest = p-number modulo 10
     1741       .
     1742     end.
     1743     case v-rest :
     1744       when 1
     1745       then do:
     1746         return 2 .
     1747       end.
     1748       when 2 or
     1749       when 3 or
     1750       when 4
     1751       then do:
     1752         return 3 .
     1753       end.
     1754       otherwise do:
     1755         return 1 .
     1756       end.
     1757     end case .
     1758   end.
     1759   procedure cur-time-mjd-to-date :
     1760      define input  parameter i-mjd-diff as decimal no-undo.
     1761      define output parameter o-Date     as date    no-undo.
     1762      define output parameter o-Time     as integer no-undo.
     1763      define variable v-day-number as integer   no-undo .
     1764      if    i-mjd-diff < 0
     1765         or i-mjd-diff = ?
     1766      then do:
     1767         return "?" .
     1768      end.
     1769      assign
     1770         v-day-number = truncate(i-mjd-diff,0).
     1771         o-Date = date(v-day-number + 2400002).
     1772         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1773     .
     1774   end.
     1775   function cur-time-mjd-to-string returns character
     1776   (input p-mjd-diff as decimal
     1777   )
     1778   :
     1779     define variable v-day-number as integer   no-undo .
     1780     define variable v-seconds    as integer   no-undo .
     1781     define variable v-hour       as integer   no-undo .
     1782     define variable v-min        as integer   no-undo .
     1783     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1784     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1785     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1786     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1787     if p-mjd-diff < 0
     1788     or p-mjd-diff = ?
     1789     then do:
     1790       return "?" .
     1791     end.
     1792     assign
     1793       v-day-number = integer(truncate(p-mjd-diff,0))
     1794       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1795     .
     1796     if v-seconds > 86400
     1797     then do:
     1798       assign
     1799         v-seconds = 86400 - 1
     1800       .
     1801     end.
     1802     if v-seconds < 0
     1803     then do:
     1804       assign
     1805         v-seconds = 0
     1806       .
     1807     end.
     1808     assign
     1809       v-hour = truncate(v-seconds / 3600, 0)
     1810     .
     1811     assign
     1812       v-seconds = v-seconds modulo 3600
     1813     .
     1814     assign
     1815       v-min = truncate(v-seconds / 60, 0)
     1816     .
     1817     assign
     1818       v-seconds = v-seconds modulo 60
     1819     .
     1820     return
     1821         (if v-day-number <> 0
     1822           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1823           else ""
     1824         )
     1825       + (if v-day-number <> 0 or v-hour <> 0
     1826           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1827           else ""
     1828         )
     1829       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1830           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1831           else ""
     1832         )
     1833       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1834       .
     1835   end.
     1836   function cur-time-string returns character
     1837   :
     1838     define variable v-date as date      no-undo .
     1839     define variable v-time as integer   no-undo .
     1840     run cur-time in this-procedure
     1841       (output v-date
     1842       ,output v-time
     1843       ) .
     1844     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1845   end.
     1846   function cur-time-string-sec returns character
     1847   :
     1848     define variable v-date as date      no-undo .
     1849     define variable v-time as integer   no-undo .
     1850     run cur-time in this-procedure
     1851       (output v-date
     1852       ,output v-time
     1853       ) .
     1854     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1855   end.
     1856   function cur-time-custom  returns character
     1857   (input p-prefix as character
     1858   ,input p-date-format as character
     1859   ,input p-delimiter as character
     1860   ,input p-time-format as character
     1861   ,input p-suffix as character
     1862   )
     1863   :
     1864     define variable v-date as date      no-undo .
     1865     define variable v-time as integer   no-undo .
     1866     run cur-time in this-procedure
     1867       (output v-date
     1868       ,output v-time
     1869       ) .
     1870     return
     1871       p-prefix
     1872       + string(v-date, p-date-format)
     1873       + p-delimiter
     1874       + string(v-time, p-time-format)
     1875       + p-suffix
     1876       .
     1877   end.
     1878   function cur-time-print  returns character
     1879   :
     1880     define variable v-date as date      no-undo .
     1881     define variable v-time as integer   no-undo .
     1882     run cur-time in this-procedure
