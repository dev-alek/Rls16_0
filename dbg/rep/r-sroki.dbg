     2286           buf_temp-param.param-code     = p-code
     2287           buf_temp-param.param-sub-code = p-sub-code
     2288         .
     2289       end.
     2290       assign
     2291         buf_temp-param.param-value = p-value
     2292       .
     2293     end.
     2294   end procedure.
     2295   procedure paramls-read :
     2296     define input  parameter p-code          as character no-undo .
     2297     define input  parameter p-sub-code      as character no-undo .
     2298     define input  parameter p-default-value as character no-undo .
     2299     define output parameter p-value         as character no-undo .
     2300     define buffer buf_temp-param for temp-param .
     2301     do
     2302     on error undo, return error return-value
     2303     :
     2304       find first buf_temp-param
     2305         where buf_temp-param.param-code     = p-code
     2306           and buf_temp-param.param-sub-code = p-sub-code
     2307         no-error .
     2308       if available buf_temp-param then do:
     2309         assign
