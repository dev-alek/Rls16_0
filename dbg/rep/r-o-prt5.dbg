     5436   END PROCEDURE.
     5437   PROCEDURE foreach3 :
     5438   for each obj-list no-lock with frame zapas :
     5439   if not( classify = 1 and itog = true) then do:
     5440     if c-f-gds-name <>  ?  then do :
     5441       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     5442       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5443           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5444           display STREAM OutStream    with frame top-frame .
     5445       End.
     5446     End.
     5447   if c-f-qnty <>  ?  then do :
     5448   Assign
     5449       l1f-qnty  = c-f-qnty:DATA-TYPE
     5450       l2f-qnty  = c-f-qnty:FORMAT
     5451       c-f-qnty:DATA-TYPE = "CHARACTER"
     5452       c-f-qnty:FORMAT    = "x(" + string(C-f-qnty:WIDTH-CHARS) + ")"
     5453       c-f-qnty:screen-value = string('')  .
     5454   End.
     5455   if c-f-cost-sum <>  ?  then do :
