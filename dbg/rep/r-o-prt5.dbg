     5459       c-f-cost-sum:DATA-TYPE = "CHARACTER"
     5460       c-f-cost-sum:FORMAT    = "x(" + string(C-f-cost-sum:WIDTH-CHARS) + ")"
     5461       c-f-cost-sum:screen-value = string('')  .
     5462   End.
