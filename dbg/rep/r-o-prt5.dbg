     1550     )  .
     1551   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1552   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1553     (input  p-obj-type
     1554     ,input  p-obj-code
     1555     ,input  v-root-b-code
     1556     ,input  v-root-b-code
     1557     ,input  0
     1558     ,output v-doc-num
     1559     ,output v-price-sale
     1560     ,output v-road-tax
     1561     ,output v-excise
     1562     ) no-error .
     1563       if error-status :error
     1564       then do:
     1565         message
     1566           vss-workfile vss-revision vss-description skip
     1567           vss-include-info16 skip
     1568           "Ошибка при определении цены признака на объекте" skip
     1569           "Объект"     p-obj-type p-obj-code  skip
     1570           "Бар-код"    v-root-b-code skip
     1571           error-status :get-message(1) skip
     1572           return-value skip
     1573           view-as alert-box error .
     1574         undo, return error .
     1575       end.
     1576       run prdoclib-init-temp-prt-obj in this-procedure
     1577         (input p-obj-type
     1578         ,input p-obj-code
     1579         ,input p-artic
     1580         ,input p-prod-type
     1581         ,input p-prod-code
     1582         ,input v-price-sale
     1583         ) .
     1584       find first buf_price-list no-lock
     1585         where buf_price-list.doc-num    = v-doc-num
     1586           and buf_price-list.price-type = ""
     1587           and buf_price-list.b-code     = v-root-b-code
     1588         .
     1589       find first buf_temp-prt-obj
     1590         where buf_temp-prt-obj.prt-code = v-root-node
     1591         .
     1592       assign
     1593         buf_temp-prt-obj.price-sale       = v-price-sale
     1594         buf_temp-prt-obj.price-list-qnty  = buf_price-list.doc-qnty
     1595         buf_temp-prt-obj.price-list-recid = recid(buf_price-list)
     1596       .
     1597       define variable l-empty-scale as logical no-undo .
     1598   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1599     (input  v-root-node
     1600     ,input  'empty-scale=request'
     1601     ,output l-empty-scale
     1602     ) no-error .
     1603       if error-status :error
     1604       then do:
     1605         message
     1606           vss-workfile vss-revision vss-description skip
     1607           vss-include-info16 skip
     1608           "Ошибка при определении атрибута шкалы" skip
     1609           "Код признака" v-root-node skip
     1610           "Запрашивался атрибут" "empty-scale=request" skip
     1611           error-status :get-message(1) skip
     1612           return-value skip
     1613           view-as alert-box error .
     1614         undo, return error .
     1615       end.
     1616       assign
     1617         v-total-term-fact-qnty = 0
     1618         v-total-fact-sale      = 0
     1619       .
     1620       if l-empty-scale = true
     1621       then do:
     1622         for each buf_price-list
     1623           where buf_price-list.doc-num    = v-doc-num
     1624             and buf_price-list.main-price = false
     1625             and buf_price-list.artic      = p-artic
     1626             and buf_price-list.prod-type  = p-prod-type
     1627             and buf_price-list.prod-code  = p-prod-code
     1628             and buf_price-list.price-type = ""
     1629         on error undo, return error return-value
     1630         :
     1631           if buf_price-list.doc-qnty <> ? and p-check-price-parts
     1632           then do:
     1633             message
     1634               vss-workfile vss-revision vss-description skip
     1635               vss-include-info16 skip
     1636               "Ошибка при закрытии переоценки" skip
     1637               "Для неосновного бар-кода товара с пустой шкалой" skip
     1638               "указано количество отличное от ?" skip
     1639               "Переоценка" v-doc-num skip
     1640               "Бар-код" buf_price-list.b-code skip
     1641               "Артикул" p-artic p-prod-type p-prod-code skip
     1642               "Количество" buf_price-list.doc-qnty skip
     1643               view-as alert-box error .
     1644             undo, return error .
     1645           end.
     1646         end.
     1647       end.
     1648       if l-empty-scale = false
     1649       then do:
     1650         define variable v-unit-base like ub.goods.unit-base no-undo .
     1651   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1652   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     1653     (input  v-gds-code
     1654     ,output v-unit-base
     1655     ) no-error .
     1656         if error-status :error
     1657         then do:
     1658           message
     1659             vss-workfile vss-revision vss-description skip
     1660             vss-include-info16 skip
     1661             "Ошибка при определении базовой единицы измерения товара" skip
     1662             "Код товара" v-gds-code skip
     1663             error-status :get-message(1) skip
     1664             return-value skip
     1665             view-as alert-box error .
     1666           undo, return error .
     1667         end.
     1668         for each buf_price-list
     1669           where buf_price-list.doc-num    = v-doc-num
     1670             and buf_price-list.main-price = false
     1671             and buf_price-list.artic      = p-artic
     1672             and buf_price-list.prod-type  = p-prod-type
     1673             and buf_price-list.prod-code  = p-prod-code
     1674             and buf_price-list.price-type = ""
     1675         on error undo, return error
     1676         :
     1677           if buf_price-list.doc-qnty = ?
     1678           then do:
     1679             find first buf_bar-code no-lock
     1680               where buf_bar-code.b-code = buf_price-list.b-code
     1681               no-error .
     1682             if  available buf_bar-code
     1683             and buf_bar-code.unit-cli = v-unit-base
     1684             then do:
     1685               message
     1686                 vss-workfile vss-revision vss-description skip
     1687                 vss-include-info16 skip
     1688                 "Ошибка при закрытии переоценки" skip
     1689                 "Не задано количество для бар-кода с основной единицей измерения" skip
     1690                 "Переоценка" v-doc-num skip
     1691                 "Бар-код" buf_price-list.b-code skip
     1692                 "Артикул" p-artic p-prod-type p-prod-code skip
     1693                 "Количество" buf_price-list.doc-qnty skip
     1694                 "Основная единица измерения" v-unit-base skip
     1695                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     1696                 view-as alert-box error .
     1697               undo, return error .
     1698             end.
     1699             next .
     1700           end.
     1701           find first buf_bar-code no-lock
     1702             where buf_bar-code.b-code = buf_price-list.b-code
     1703             no-error .
     1704           if not available buf_bar-code
     1705           then do:
     1706             message
     1707               vss-workfile vss-revision vss-description skip
     1708               vss-include-info16 skip
     1709               "В переоценке задан несуществующий бар-код" skip
     1710               "Переоценка" v-doc-num skip
     1711               "Артикул" p-artic p-prod-type p-prod-code skip
     1712               "Бар-код" buf_price-list.b-code skip
     1713               view-as alert-box error .
     1714             undo, return error .
     1715           end.
     1716           if buf_bar-code.in-code <> ""
     1717           or buf_bar-code.part-code <> ""
     1718           then do:
     1719             message
     1720               vss-workfile vss-revision vss-description skip
     1721               vss-include-info16 skip
     1722               "В переоценке задан бар-код партии" skip
     1723               "Данная версия системы не рассчитана на работу со специальными ценами по партиям" skip
     1724               "Переоценка" v-doc-num skip
     1725               "Бар-код" buf_price-list.b-code skip
     1726               "Артикул" p-artic p-prod-type p-prod-code skip
     1727               "Код ПН" buf_bar-code.in-code buf_bar-code.part-code skip
     1728               view-as alert-box error .
     1729             undo, return error .
     1730           end.
     1731           if buf_bar-code.node-code <> v-root-node
     1732           then do:
     1733   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1734   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtobjcr in g#library
     1735     (input  p-obj-type
     1736     ,input  p-obj-code
     1737     ,input  p-artic
     1738     ,input  p-prod-type
     1739     ,input  p-prod-code
     1740     ,input  buf_bar-code.node-code
     1741     ,buffer buf_prt-obj
     1742     ) no-error .
