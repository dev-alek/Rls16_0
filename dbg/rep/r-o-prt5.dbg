     5522       l2f-cost-sum-o  = c-f-cost-sum-o:FORMAT
     5523       c-f-cost-sum-o:DATA-TYPE = "CHARACTER"
     5524       c-f-cost-sum-o:FORMAT    = "x(" + string(C-f-cost-sum-o:WIDTH-CHARS) + ")"
     5525       c-f-cost-sum-o:screen-value = string('')  .
     5526   End.
     5527   if c-f-crsa-sum-o <>  ?  then do :
     5528   Assign
