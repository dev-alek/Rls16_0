     6116           display STREAM OutStream    with frame top-frame .
     6117       End.
     6118     End.
     6119       display stream outstream with frame zapas no-error .
     6120       down stream outstream with frame zapas.
     6121     run u-line.
     6122         if Make-Excel then  put   stream ForExcel unformatted
     6123         "ИТОГО"                       CHR(9)
     6124         "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9)     CHR(9)
     6125         excel-qnty(accum total f-qnty           )   CHR(9)
     6126         excel-sum (accum total f-cost-sum       )   CHR(9)
     6127         excel-sum (accum total f-sale-sum       )   CHR(9)
     6128         excel-sum (accum total f-sale-other     )   CHR(9)
     6129         excel-sum (accum total f-crsa-sum       )   CHR(9)
     6130         excel-sum (accum total f-qnty-all       )   CHR(9)
     6131         excel-sum (accum total f-cost-sum-all   )   CHR(9)
     6132         excel-sum (accum total f-crsa-sum-all   )   CHR(9)
     6133         excel-sum (accum total f-qnty-o         )   CHR(9)
     6134         excel-sum (accum total f-cost-sum-o     )   CHR(9)
     6135         excel-sum (accum total f-crsa-sum-o     )   chr(10) .
     6136   end.
     6137   END PROCEDURE.
     6138   PROCEDURE foreach4 :
     6139   for each obj-list no-lock with frame zapas :
     6140       for each gds-obj where
     6141                gds-obj.obj-code    = obj-list.obj-code and
     6142                gds-obj.obj-type    = obj-list.obj-type
     6143                and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     6144                no-lock,
     6145                first goods where   goods.gds-code    = gds-obj.gds-code  and
     6146                                    goods.gds-type    = 'т':U
     6147                no-lock ,
     6148                first gds-list where   gds-list.prod-type = gds-obj.prod-type and
     6149                                       gds-list.prod-code = gds-obj.prod-code and
     6150                                       gds-list.artic     = gds-obj.artic
     6151           :
     6152           gds-list.qnty = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     6153         end.
     6154   if not( classify = 1 and itog = true) then do:
     6155     if c-f-gds-name <>  ?  then do :
     6156       c-f-gds-name:screen-value = string(obj-list.obj-name) .
     6157       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6158           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6159           display STREAM OutStream    with frame top-frame .
     6160       End.
     6161     End.
     6162   if c-f-qnty <>  ?  then do :
