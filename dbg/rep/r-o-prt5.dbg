     4442               .
     4443             end.
     4444             else do:
     4445               assign
     4446                 f-qnty-o     = gds-obj.fact-qnty
     4447                 f-cost-sum-o = gds-obj.fact-rubl
     4448                 f-crsa-sum-o = gds-obj.fact-sale .
     4449             end.
     4450           end.
     4451             if itog = false and
     4452               not(f-qnty        = 0 and
     4453                   f-qnty-o      = 0 and
     4454                   f-cost-sum    = 0 and
     4455                   f-sale-sum    = 0 and
     4456                   f-sale-other  = 0 and
     4457                   f-crsa-sum    = 0 and
     4458                   f-qnty-all    = 0 and
     4459                   f-cost-sum-all =0 and
     4460                   f-crsa-sum-all =0      )
     4461               then  do:
     4462                   n-nn = n-nn + 1 .
     4463   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4464     (input  goods.gds-code
     4465     ,input  ?
     4466     ,output v-bar-code
     4467     )  .
     4468                     run display-str-cr in this-procedure .
     4469                     run display-prt in this-procedure  .
     4470             end.
