     7922   if c-f-qnty <>  ?  then do :
     7923   Assign
     7924       l1f-qnty  = c-f-qnty:DATA-TYPE
     7925       l2f-qnty  = c-f-qnty:FORMAT
     7926       c-f-qnty:DATA-TYPE = "CHARACTER"
