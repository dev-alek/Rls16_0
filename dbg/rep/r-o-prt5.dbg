     7015   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7016     n-nn = 0.
     7017     n-no = n-no + 1 .
     7018    For Each gds-obj where
     7019             gds-obj.obj-code    = obj-list.obj-code and
     7020             gds-obj.obj-type    = obj-list.obj-type
     7021             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7022             no-lock,
     7023             first goods where   goods.gds-code    = gds-obj.gds-code  and
     7024                                 goods.gds-type    = 'т':U
     7025                                 no-lock
     7026             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     7027                                      gds-list.prod-code = gds-obj.prod-code and
     7028                                      gds-list.artic     = gds-obj.artic
     7029               break
     7030                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7031                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     7032                   with FRAME Zapas :
     7033                IF first-of(gds-obj.artic) then DO:
     7034                   assign
     7035                     f-qnty         = 0
     7036                     f-cost-sum     = 0
     7037                     f-sale-sum     = 0
     7038                     f-sale-other   = 0
     7039                     f-crsa-sum     = 0
     7040                     f-qnty-all     = 0
     7041                     f-cost-sum-all = 0
     7042                     f-crsa-sum-all = 0
     7043                     f-qnty-o       = 0
     7044                     f-cost-sum-o   = 0
     7045                     f-crsa-sum-o   = 0.
     7046                 For Each temp-doc-code  : delete temp-doc-code . end.
     7047                 For Each ub.ot-line where
     7048                           ub.ot-line.fact-order <= fact-order-2 and
     7049                           ub.ot-line.fact-order >= fact-order-1 and
     7050                           ub.ot-line.obj-code    = obj-list.obj-code and
     7051                           ub.ot-line.obj-type    = obj-list.obj-type  and
     7052                           ub.ot-line.artic     = gds-obj.artic  and
     7053                           ub.ot-line.prod-type = gds-obj.prod-type and
     7054                           ub.ot-line.prod-code = gds-obj.prod-code and
     7055                           (ub.ot-line.sum-type = 'sale':U OR
     7056                             ub.ot-line.sum-type = 'crsa':U OR
     7057                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     7058                       run in-proc.
     7059                 End.
     7060               End.
     7061             if last-of(gds-obj.artic) then DO:
     7062             run last-of-artic.
     7063                 accumulate f-qnty           (TOTAL ) .
     7064                 accumulate f-cost-sum       (TOTAL ) .
     7065                 accumulate f-sale-sum       (TOTAL ) .
     7066                 accumulate f-sale-other     (TOTAL ) .
     7067                 accumulate f-crsa-sum       (TOTAL ) .
     7068                 accumulate f-qnty-all       (TOTAL ) .
     7069                 accumulate f-cost-sum-all   (TOTAL ) .
     7070                 accumulate f-crsa-sum-all   (TOTAL ) .
     7071                 accumulate f-qnty-o         (TOTAL ) .
     7072                 accumulate f-cost-sum-o     (TOTAL ) .
     7073                 accumulate f-crsa-sum-o     (TOTAL ) .
     7074                   Assign
     7075                     f-qnty          = 0
     7076                     f-crsa-sum      = 0
     7077                     f-qnty          = 0
     7078                     f-cost-sum      = 0
     7079                     f-sale-sum      = 0
     7080                     f-sale-other    = 0
     7081                     f-crsa-sum      = 0
     7082                     f-qnty-all      = 0
     7083                     f-cost-sum-all  = 0
     7084                     f-crsa-sum-all  = 0
     7085                     f-qnty-o        = 0
     7086                     f-cost-sum-o    = 0
     7087                     f-crsa-sum-o    = 0
     7088                    .
     7089             End.
     7090   End.
     7091    run u-line.
     7092     if c-nn <>  ?  then do :
     7093       c-nn:screen-value = string('ИТОГО') .
     7094       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7095           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7096           display STREAM OutStream    with frame top-frame .
