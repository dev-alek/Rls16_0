     7193     if Make-Excel then  put   stream ForExcel unformatted
     7194             "ИТОГО"                         CHR(9)
     7195             "по объекту"                    CHR(9)
     7196             obj-list.obj-name               CHR(9)
     7197             excel-qnty(accum TOTAL f-qnty           )  CHR(9)
