     4413               output  coast_v1  ,
     4414               output  vat_r1    ,
     4415               output  vat_v1    ,
     4416               output  slt_r1    ,
     4417               output  slt_v1     ).
     4418             assign
     4419               f-qnty-o       = quantity1
     4420               f-crsa-sum-o   = if tprintrubl then coast_r1 else coast_v1
     4421               .
     4422               run ost-line in this-procedure
     4423               (input   gds-obj.obj-code  ,
     4424               input   gds-obj.obj-type  ,
     4425               input   gds-obj.artic     ,
     4426               input   gds-obj.prod-code ,
