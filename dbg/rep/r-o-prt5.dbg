     5530       l2f-crsa-sum-o  = c-f-crsa-sum-o:FORMAT
     5531       c-f-crsa-sum-o:DATA-TYPE = "CHARACTER"
     5532       c-f-crsa-sum-o:FORMAT    = "x(" + string(C-f-crsa-sum-o:WIDTH-CHARS) + ")"
     5533       c-f-crsa-sum-o:screen-value = string('')  .
     5534   End.
     5535   display stream outstream no-error .
     5536   down stream outstream .
     5537   if c-f-qnty <>  ?  then do :
