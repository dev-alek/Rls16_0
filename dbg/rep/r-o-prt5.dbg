     5514       l2f-qnty-o  = c-f-qnty-o:FORMAT
     5515       c-f-qnty-o:DATA-TYPE = "CHARACTER"
     5516       c-f-qnty-o:FORMAT    = "x(" + string(C-f-qnty-o:WIDTH-CHARS) + ")"
     5517       c-f-qnty-o:screen-value = string('')  .
     5518   End.
     5519   if c-f-cost-sum-o <>  ?  then do :
