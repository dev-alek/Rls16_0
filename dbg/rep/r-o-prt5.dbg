     9969             if x-zero = true and v-show-all-goods = false and
     9970                (f-qnty        = 0 and
     9971                 f-cost-sum    = 0 and
     9972                 f-sale-sum    = 0 and
     9973                 f-sale-other  = 0 and
     9974                 f-crsa-sum    = 0 and
