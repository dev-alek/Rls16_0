     5310   if Make-Excel then  put   stream ForExcel unformatted
     5311         "ИТОГО"                         CHR(9)
     5312         "по объекту"                    CHR(9)  CHR(9)
     5313         obj-list.obj-name               CHR(9)
     5314         excel-qnty(accum total f-qnty           )  CHR(9)
     5315         excel-sum (accum total f-cost-sum       )  CHR(9)
     5316         excel-sum (accum total f-sale-sum       )  CHR(9)
     5317         excel-sum (accum total f-sale-other    )   CHR(9)
     5318         excel-sum (accum total f-crsa-sum      )   CHR(9)
     5319         excel-sum (accum total f-qnty-all      )   CHR(9)
