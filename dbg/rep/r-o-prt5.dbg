     6279       c-f-qnty-all:DATA-TYPE = l1f-qnty-all
     6280       c-f-qnty-all:FORMAT    = l2f-qnty-all.
     6281   End.
     6282   if c-f-cost-sum-all <>  ?  then do :
     6283   Assign
     6284       c-f-cost-sum-all:DATA-TYPE = l1f-cost-sum-all
     6285       c-f-cost-sum-all:FORMAT    = l2f-cost-sum-all.
