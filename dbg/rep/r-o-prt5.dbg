     9771       c-nn:screen-value = string(string(n-nn)) .
     9772       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9773           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9774           display STREAM OutStream    with frame top-frame .
