     3182   procedure prdoclib-clear-temp-pl-gds :
     3183     define buffer buf_temp-pl-gds for temp-pl-gds .
     3184     do
     3185     on error undo, return error return-value
     3186     :
     3187       for each buf_temp-pl-gds
     3188       on error undo, return error return-value
     3189       :
     3190         delete buf_temp-pl-gds .
     3191       end.
     3192     end.
     3193   end procedure.
     3194   procedure prdoclib-init-temp-pl-gds :
     3195     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3196     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3197     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3198     define buffer buf_pl-gds      for ub.pl-gds .
     3199     define buffer buf_temp-pl-gds for temp-pl-gds .
     3200     do
     3201     on error undo, return error return-value
     3202     :
     3203       run prdoclib-clear-temp-pl-gds in this-procedure .
     3204       for each buf_pl-gds
     3205         where buf_pl-gds.obj-type = p-obj-type
     3206           and buf_pl-gds.obj-code = p-obj-code
     3207           and buf_pl-gds.gds-code = p-gds-code
     3208       on error undo, return error return-value
     3209       :
     3210         create buf_temp-pl-gds .
     3211         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3212       end.
     3213     end.
     3214   end procedure.
     3215   procedure prdoclib-init-pl-gds-by-factord :
     3216     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3217     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3218     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3219     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3220     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3221     define input parameter p-fact-order         as decimal   no-undo .
     3222     define input parameter p-include-fact-order as logical   no-undo .
     3223     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3224     define buffer buf_goods       for ub.goods .
     3225     define buffer buf_gds-obj     for ub.gds-obj .
     3226     define buffer buf_doc-line    for ub.doc-line .
     3227     define buffer buf_temp-pl-gds for temp-pl-gds .
     3228     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3229     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3230     do
     3231     on error undo, return error return-value
     3232     :
     3233       do transaction
     3234       on error undo, return error return-value
     3235       :
     3236   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3238     (input  p-obj-type
     3239     ,input  p-obj-code
     3240     ,input  p-artic
     3241     ,input  p-prod-type
     3242     ,input  p-prod-code
     3243     ,buffer buf_gds-obj
     3244     ) no-error .
     3245         if error-status :error
     3246         then do:
     3247           message
     3248             vss-workfile vss-revision vss-description skip
     3249             vss-include-info16 skip
     3250             "Невозможно найти gds-obj" skip
     3251             error-status :get-message(1) skip
     3252             return-value skip
     3253             view-as alert-box error .
     3254           undo, return error return-value .
     3255         end.
     3256         find current buf_gds-obj exclusive-lock .
     3257       end.
     3258       find first buf_goods no-lock
     3259         where buf_goods.artic     = p-artic
     3260           and buf_goods.prod-type = p-prod-type
     3261           and buf_goods.prod-code = p-prod-code
     3262         .
     3263       run prdoclib-init-temp-pl-gds in this-procedure
     3264         (input p-obj-type
     3265         ,input p-obj-code
     3266         ,input buf_goods.gds-code
     3267         ) .
     3268       if p-include-fact-order = true
     3269       then do:
     3270         assign
     3271          p-fact-order = p-fact-order - 0.0000000001
     3272         .
     3273       end.
     3274       for each buf_doc-line no-lock
     3275         where buf_doc-line.obj-type   = p-obj-type
     3276           and buf_doc-line.obj-code   = p-obj-code
     3277           and buf_doc-line.artic      = p-artic
     3278           and buf_doc-line.prod-type  = p-prod-type
     3279           and buf_doc-line.prod-code  = p-prod-code
     3280           and buf_doc-line.status_    = 'факт':U
     3281           and buf_doc-line.fact-order >= p-fact-order
     3282       on error undo, return error return-value
     3283       :
