     1931   procedure prdoclib-clear-temp-prt-obj :
     1932     define buffer buf_temp-prt-obj for temp-prt-obj .
     1933     do
     1934     on error undo, return error return-value
     1935     :
     1936       for each buf_temp-prt-obj
     1937       on error undo, return error return-value
     1938       :
     1939         delete buf_temp-prt-obj .
     1940       end.
     1941     end.
     1942   end procedure.
     1943   procedure prdoclib-create-temp-prt-obj :
     1944     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     1945     define parameter buffer buf_prt-obj       for ub.prt-obj .
     1946     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1947     define buffer buf_gds-prt for ub.gds-prt .
     1948     do
     1949     on error undo, return error return-value
     1950     :
     1951       find first buf_temp-prt-obj
     1952         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     1953         no-error .
     1954       if not available buf_temp-prt-obj
     1955       then do:
     1956         create buf_temp-prt-obj .
     1957         assign
     1958           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     1959           buf_temp-prt-obj.price-sale       = ?
     1960           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     1961           buf_temp-prt-obj.price-list-qnty  = ?
     1962           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     1963           buf_temp-prt-obj.price-list-recid = ?
     1964         .
     1965         find first buf_gds-prt no-lock
     1966           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     1967           .
     1968         assign
     1969           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     1970         .
     1971         if buf_temp-prt-obj.is-term
     1972         then do:
     1973           assign
     1974             buf_temp-prt-obj.price-sale = p-root-price-sale
     1975           .
     1976         end.
     1977       end.
     1978     end.
     1979   end procedure.
     1980   procedure prdoclib-temp-prt-obj-by-prt-root :
     1981     define input parameter  p-prt-code like ub.prt-obj.prt-code no-undo .
     1982     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
     1983     define buffer buf_gds-prt for ub.gds-prt .
     1984     do
     1985     on error undo, return error return-value
     1986     :
     1987       find first buf_temp-prt-obj
     1988         where buf_temp-prt-obj.prt-code = p-prt-code
     1989         no-error .
     1990       if not available buf_temp-prt-obj
     1991       then do:
     1992         create buf_temp-prt-obj .
     1993         assign
     1994           buf_temp-prt-obj.prt-code         = p-prt-code
     1995           buf_temp-prt-obj.price-sale       = ?
     1996           buf_temp-prt-obj.fact-qnty        = 0
     1997           buf_temp-prt-obj.price-list-qnty  = ?
     1998           buf_temp-prt-obj.prt-obj-recid    = ?
     1999           buf_temp-prt-obj.price-list-recid = ?
     2000         .
     2001         find first buf_gds-prt no-lock
     2002           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2003           .
     2004         assign
     2005           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2006         .
     2007         if buf_temp-prt-obj.is-term
     2008         then do:
     2009           assign
     2010             buf_temp-prt-obj.price-sale = 0
     2011           .
     2012         end.
     2013       end.
     2014     end.
     2015   end procedure.
     2016   procedure prdoclib-init-temp-prt-obj :
     2017     define input parameter p-obj-type        like ub.prt-obj.obj-type  no-undo .
     2018     define input parameter p-obj-code        like ub.prt-obj.obj-code  no-undo .
     2019     define input parameter p-artic           like ub.prt-obj.artic     no-undo .
     2020     define input parameter p-prod-type       like ub.prt-obj.prod-type no-undo .
     2021     define input parameter p-prod-code       like ub.prt-obj.prod-code no-undo .
     2022     define input parameter p-root-price-sale like ub.prt-obj.price-sale no-undo .
     2023     define buffer buf_prt-obj      for ub.prt-obj .
     2024     define buffer buf_temp-prt-obj for temp-prt-obj .
     2025     do
     2026     on error undo, return error return-value
     2027     :
     2028       run prdoclib-clear-temp-prt-obj in this-procedure .
     2029       for each buf_prt-obj
     2030         where buf_prt-obj.obj-type  = p-obj-type
     2031           and buf_prt-obj.obj-code  = p-obj-code
     2032           and buf_prt-obj.artic     = p-artic
     2033           and buf_prt-obj.prod-type = p-prod-type
     2034           and buf_prt-obj.prod-code = p-prod-code
     2035       on error undo, return error return-value
     2036       :
     2037         run prdoclib-create-temp-prt-obj in this-procedure
     2038           (input  p-root-price-sale
     2039           ,buffer buf_prt-obj
     2040           ,buffer buf_temp-prt-obj
     2041           ).
     2042       end.
     2043     end.
     2044   end procedure.
     2045   procedure prdoclib-calc-fact-sale :
     2046     define input  parameter p-price-list-recid   as recid     no-undo .
     2047     define output parameter p-fact-qnty          as decimal   no-undo .
     2048     define output parameter p-cur-base           as decimal   no-undo .
     2049     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2050     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2051     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2052     define output parameter p-cur-excise-base    as decimal   no-undo .
     2053     define buffer buf_main_price-list for ub.price-list .
     2054     define buffer buf_price-list      for ub.price-list .
     2055     define buffer buf_goods           for ub.goods .
     2056     define buffer buf_gds-obj         for ub.gds-obj .
     2057     define buffer buf_bar-code        for ub.bar-code .
     2058     define variable l-empty-scale   as logical   no-undo .
     2059     do
     2060     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2061     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2062     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2063     :
     2064       find first buf_main_price-list no-lock
     2065         where recid(buf_main_price-list) = p-price-list-recid
     2066         no-error .
     2067       if not available buf_main_price-list
     2068       then do:
     2069         message
     2070           vss-workfile vss-revision vss-description skip
     2071           vss-include-info16 skip
     2072           "Ошибка задания входных параметров" skip
     2073           "Не найдена строка переоценки" skip
     2074           "Код записи (recid)" p-price-list-recid skip
     2075           view-as alert-box error .
     2076         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2077       end.
     2078       if buf_main_price-list.main-price <> true
     2079       then do:
     2080         message
     2081           vss-workfile vss-revision vss-description skip
     2082           vss-include-info16 skip
     2083           "Ошибка задания входных параметров" skip
     2084           "Строка переоценки не является основной" skip
     2085           "Код записи (recid)" p-price-list-recid skip
     2086           "Переоценка" buf_main_price-list.doc-num skip
     2087           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2088           "Бар-код" buf_main_price-list.b-code skip
     2089           view-as alert-box error .
     2090         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2091       end.
     2092       find first buf_goods no-lock
     2093         where buf_goods.artic     = buf_main_price-list.artic
     2094           and buf_goods.prod-type = buf_main_price-list.prod-type
     2095           and buf_goods.prod-code = buf_main_price-list.prod-code
     2096         no-error .
     2097       if not available buf_goods
     2098       then do:
     2099         message
     2100           vss-workfile vss-revision vss-description skip
     2101           vss-include-info16 skip
     2102           "Не найден товар" skip
     2103           "Переоценка" buf_main_price-list.doc-num skip
     2104           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2105           view-as alert-box error .
     2106         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2107       end.
