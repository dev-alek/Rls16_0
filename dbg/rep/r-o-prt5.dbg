     6287   if c-f-crsa-sum-all <>  ?  then do :
     6288   Assign
     6289       c-f-crsa-sum-all:DATA-TYPE = l1f-crsa-sum-all
     6290       c-f-crsa-sum-all:FORMAT    = l2f-crsa-sum-all.
