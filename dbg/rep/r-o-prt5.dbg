     9103   END PROCEDURE.
     9104   PROCEDURE Display-prt :
     9105   if goods.prt-root <> Prtroot Then DO:
     9106   If v-var = "no-today"  then
     9107   run prdoclib-init-prt-obj-by-factord in this-procedure
     9108   ( input gds-obj.obj-type  ,
     9109   input gds-obj.obj-code  ,
     9110   input gds-obj.artic     ,
     9111   input gds-obj.prod-type ,
     9112   input gds-obj.prod-code ,
     9113   input fact-order-2 ,
     9114   input false ) .
     9115   for each ub.prt-obj where
     9116     ub.prt-obj.artic     = goods.artic         and
     9117     ub.prt-obj.prod-type = goods.prod-type and
     9118     ub.prt-obj.prod-code = goods.prod-code and
     9119     ub.prt-obj.obj-code  = obj-list.obj-code   and
     9120     ub.prt-obj.obj-type  = obj-list.obj-type   and
     9121     ub.prt-obj.IS-term   =  true no-lock
     9122           BREAK BY ub.prt-obj.prt-code with FRAME Zapas:
     9123                 if v-var <> "no-today" then do:
     9124                   Assign
     9125                     p-qnty-o     = p-qnty-o     + ub.prt-obj.fact-qnty
     9126                     p-crsa-sum-o = p-crsa-sum-o + ub.prt-obj.fact-qnty * ub.prt-obj.price-sale .
     9127                 End.
     9128   IF last-of(prt-obj.prt-code) THEN DO:
     9129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     9130     (input  gds-obj.gds-code
     9131     ,input  ub.prt-obj.prt-code
     9132     ,output v-bar-code
     9133     )  .
     9134             if v-var = "no-today" then do:
     9135               find first temp-prt-obj no-lock
     9136                     where temp-prt-obj.prt-obj-recid   = recid (prt-obj) no-error .
     9137                     if avail temp-prt-obj then do :
     9138                       run calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     9139                       Assign
     9140                         p-qnty-o      = temp-prt-obj.fact-qnty
     9141                         p-crsa-sum-o  = temp-prt-obj.fact-qnty * v-price-sale      .
     9142                     End.
     9143                     Else
     9144                       Assign
     9145                         p-qnty-o      = 0
     9146                         p-crsa-sum-o  = 0   .
     9147             End.
     9148       FIND first ub.gds-prt  where ub.gds-prt.node-code = ub.prt-obj.prt-code NO-LOCK no-error .
     9149       for each ub.gds-dtl no-lock where
     9150           ub.gds-dtl.artic      = goods.artic     and
     9151           ub.gds-dtl.prod-code  = goods.prod-code and
     9152           ub.gds-dtl.prod-type  = goods.prod-type and
     9153           ub.gds-dtl.prt-code   = ub.prt-obj.prt-code  and
     9154           ub.gds-dtl.obj-code   = obj-list.obj-code  and
     9155           ub.gds-dtl.obj-type   = obj-list.obj-type :
     9156               find first temp-doc-code where temp-doc-code.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     9157                 if avail temp-doc-code then DO:
     9158                 Assign
     9159                     t-qnty = if temp-doc-code.ext-doc-type = 'vt':U
     9160                                 then ub.gds-dtl.doc-qnty
     9161                                 else ( ub.gds-dtl.fact-qnty * temp-doc-code.si )
     9162                     p-qnty       = p-qnty       + t-qnty
     9163                     p-sale-sum   = p-sale-sum   + (gds-dtl.price-rubl * t-qnty)
     9164                     p-sale-other = p-sale-other + (gds-dtl.discnt-rubl * temp-doc-code.si2)
     9165                     p-crsa-sum   = p-crsa-sum   + (gds-dtl.cur-base * t-qnty)
     9166                     .
     9167               End.
     9168               find first temp-doc-code-all where temp-doc-code-all.doc-code = ub.gds-dtl.doc-code no-lock no-error .
     9169                 if avail temp-doc-code-all then DO:
     9170                     Assign
     9171                     t-qnty-all = if temp-doc-code-all.ext-doc-type = 'vt':U
     9172                                       then ub.gds-dtl.doc-qnty
     9173                                       else ( ub.gds-dtl.fact-qnty * temp-doc-code-all.si )
     9174                       p-qnty-all       = p-qnty-all  + t-qnty-all
     9175                       p-crsa-sum-all   = p-crsa-sum-all   + (gds-dtl.cur-base * t-qnty-all ).
     9176                 End.
     9177       end.
     9178       if f-qnty <> ? and f-qnty <> 0 then
     9179           Assign
     9180             p-cost-sum     = f-cost-sum      * p-qnty     / f-qnty
     9181           .
     9182       else
     9183           Assign
     9184               p-cost-sum     = 0
     9185           .
     9186       if f-qnty-all <> ? and f-qnty-all <> 0 then
     9187           Assign
     9188             p-cost-sum-all = f-cost-sum-all  * p-qnty-all / f-qnty-all
     9189           .
     9190       else
     9191           Assign
     9192               p-cost-sum-all = 0
     9193             .
     9194       if f-qnty-o <> ? and f-qnty-o <> 0 then
     9195           Assign
     9196             p-cost-sum-o   = f-cost-sum-o    * p-qnty-o   / f-qnty-o
     9197           .
     9198       else
     9199           Assign
     9200               p-cost-sum-o   = 0
     9201           .
     9202       if  NOT(p-qnty      =  0 and
     9203             p-cost-sum    =  0     and
     9204             p-sale-sum    =  0     and
     9205             p-sale-other  =  0     and
     9206             p-crsa-sum    =  0     and
     9207             p-qnty-all    =  0     and
     9208             p-cost-sum-all = 0     and
     9209             p-crsa-sum-all=  0    ) then dO:
     9210     if c-nn <>  ?  then do :
     9211       c-nn:screen-value = string('') .
     9212       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9213           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9214           display STREAM OutStream    with frame top-frame .
     9215       End.
     9216     End.
     9217     if c-f-artic <>  ?  then do :
     9218       c-f-artic:screen-value = string('') .
     9219       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9220           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9221           display STREAM OutStream    with frame top-frame .
     9222       End.
     9223     End.
     9224     if c-f-b-code <>  ?  then do :
     9225       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     9226       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9227           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9228           display STREAM OutStream    with frame top-frame .
     9229       End.
     9230     End.
     9231     if c-f-gds-name <>  ?  then do :
     9232       c-f-gds-name:screen-value = string(ub.gds-prt.f-name) .
     9233       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9234           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9235           display STREAM OutStream    with frame top-frame .
     9236       End.
     9237     End.
     9238     if c-f-qnty <>  ?  then do :
     9239       c-f-qnty:screen-value = string(p-qnty) .
     9240       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9241           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9242           display STREAM OutStream    with frame top-frame .
     9243       End.
     9244     End.
     9245     if c-f-cost-sum <>  ?  then do :
     9246       c-f-cost-sum:screen-value = string(p-cost-sum) .
     9247       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9248           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9249           display STREAM OutStream    with frame top-frame .
     9250       End.
     9251     End.
     9252     if c-f-sale-sum <>  ?  then do :
     9253       c-f-sale-sum:screen-value = string(p-sale-sum) .
     9254       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9255           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9256           display STREAM OutStream    with frame top-frame .
     9257       End.
     9258     End.
     9259     if c-f-sale-other <>  ?  then do :
     9260       c-f-sale-other:screen-value = string(p-sale-other) .
     9261       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9262           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9263           display STREAM OutStream    with frame top-frame .
     9264       End.
     9265     End.
     9266     if c-f-crsa-sum <>  ?  then do :
     9267       c-f-crsa-sum:screen-value = string(p-crsa-sum) .
     9268       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9269           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9270           display STREAM OutStream    with frame top-frame .
     9271       End.
     9272     End.
     9273     if c-f-qnty-all <>  ?  then do :
     9274       c-f-qnty-all:screen-value = string(p-qnty-all) .
     9275       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9276           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9277           display STREAM OutStream    with frame top-frame .
     9278       End.
     9279     End.
     9280     if c-f-cost-sum-all <>  ?  then do :
     9281       c-f-cost-sum-all:screen-value = string(p-cost-sum-all) .
     9282       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9283           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9284           display STREAM OutStream    with frame top-frame .
     9285       End.
     9286     End.
     9287     if c-f-crsa-sum-all <>  ?  then do :
     9288       c-f-crsa-sum-all:screen-value = string(p-crsa-sum-all) .
     9289       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9290           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9291           display STREAM OutStream    with frame top-frame .
     9292       End.
     9293     End.
     9294     if c-f-qnty-o <>  ?  then do :
     9295       c-f-qnty-o:screen-value = string(p-qnty-o) .
     9296       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9297           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9298           display STREAM OutStream    with frame top-frame .
     9299       End.
     9300     End.
     9301     if c-f-cost-sum-o <>  ?  then do :
     9302       c-f-cost-sum-o:screen-value = string(p-cost-sum-o) .
     9303       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9304           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9305           display STREAM OutStream    with frame top-frame .
     9306       End.
     9307     End.
     9308     if c-f-crsa-sum-o <>  ?  then do :
     9309       c-f-crsa-sum-o:screen-value = string(p-crsa-sum-o) .
     9310       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     9311           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     9312           display STREAM OutStream    with frame top-frame .
     9313       End.
     9314     End.
     9315           Display stream OutStream no-error.
     9316           DOWN stream OutStream .
     9317       if Make-Excel then  put   stream ForExcel unformatted
     9318             " "                             CHR(9)
     9319             " "                             CHR(9)
     9320             format-excel-text(string(v-bar-code,"999999999"))  CHR(9)
     9321             ub.gds-prt.f-name                 CHR(9)
     9322             round(p-qnty,3)                CHR(9)
     9323             round(p-cost-sum,2)            CHR(9)
     9324             round(p-sale-sum,2)            CHR(9)
     9325             round(p-sale-other,2)          CHR(9)
     9326             round(p-crsa-sum,2)            CHR(9)
     9327             round(p-qnty-all,3)            CHR(9)
     9328             round(p-cost-sum-all,2)        CHR(9)
     9329             round(p-crsa-sum-all,2)        CHR(9)
     9330             round(p-qnty-o,3)              CHR(9)
     9331             round(p-cost-sum-o,2)          CHR(9)
     9332             round(p-crsa-sum-o,2)          chr(10) .
     9333       End.
     9334       Assign
     9335         p-qnty        =  0
     9336         p-cost-sum    =  0
     9337         p-sale-sum    =  0
     9338         p-sale-other  =  0
     9339         p-crsa-sum    =  0
     9340         p-qnty-all    =  0
     9341         p-cost-sum-all = 0
     9342         p-crsa-sum-all=  0
     9343         p-qnty-o      =  0
     9344         p-cost-sum-o  =  0
     9345         p-crsa-sum-o  =  0 .
     9346   End.
     9347   End.
     9348   End.
     9349   END PROCEDURE.
     9350   PROCEDURE on-same-page :
     9351     define input parameter p-line-number as integer  no-undo .
     9352     if p-line-number > page-size( OutStream ) then do:
     9353       return .
     9354     end.
     9355     if line-counter ( OutStream ) + p-line-number > page-size ( OutStream ) then do:
     9356       page stream OutStream .
     9357     end.
     9358   end procedure.
     9359   procedure ost-line :
     9360     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     9361     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     9362     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     9363     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     9364     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     9365     define input  parameter x-tog-shift  as logical no-undo .
     9366     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     9367     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     9368     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     9369     define input  parameter xtog-obj     as logical no-undo .
     9370     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     9371     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     9372     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     9373     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     9374     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     9375     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     9376     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     9377     define buffer buff-obj-list  for obj-list .
     9378     define buffer buff-stk-line  for ub.stk-line .
     9379     assign
     9380       Quantity = 0
     9381       Coast_R  = 0
     9382       Coast_V  = 0
     9383       VAT_R    = 0
     9384       VAT_V    = 0
     9385       SLT_R    = 0
     9386       SLT_V    = 0
     9387     .
     9388     if  x-tog-shift = false then do:
     9389       for each buff-obj-list no-lock
     9390         where xtog-obj = false
     9391            or (buff-obj-list.obj-type = x-store-type
     9392               and buff-obj-list.obj-code = x-store-code
     9393               )
     9394       on error undo, return error
     9395       :
     9396       find last buff-stk-line no-lock
     9397         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9398           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9399           and buff-stk-line.artic      = x-artic
     9400           and buff-stk-line.prod-type  = x-prod-type
     9401           and buff-stk-line.prod-code  = x-prod-code
     9402           and buff-stk-line.sum-type   = x-sum-type
     9403           and buff-stk-line.cat-id     = '##,##':U
     9404           and buff-stk-line.fact-order <= x-fact-order
     9405           and buff-stk-line.shift-num  = 0
     9406         use-index category
     9407         no-error .
     9408       if available buff-stk-line then do:
     9409         assign
     9410           Quantity = Quantity + buff-stk-line.fact-qnty
     9411           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9412           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9413           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9414           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9415           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9416           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9417         .
     9418       end.
     9419      end.
     9420     end.
     9421     else do:
     9422       for each buff-obj-list no-lock
     9423         where xtog-obj = false
     9424            or (buff-obj-list.obj-type = x-store-type
     9425               and buff-obj-list.obj-code = x-store-code
     9426               )
     9427       on error undo, return error
     9428       :
     9429         find last buff-stk-line no-lock
     9430           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9431             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9432             and buff-stk-line.artic      = x-artic
     9433             and buff-stk-line.prod-type  = x-prod-type
     9434             and buff-stk-line.prod-code  = x-prod-code
     9435             and buff-stk-line.sum-type   = x-sum-type
     9436             and buff-stk-line.cat-id     = '##,##':U
     9437             and buff-stk-line.fact-order <= x-fact-order
     9438             and buff-stk-line.shift-num  > 0
     9439           use-index category
     9440           no-error .
     9441         if available buff-stk-line then do:
     9442           assign
     9443             Quantity = Quantity +  buff-stk-line.fact-qnty
     9444             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9445             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9446             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9447             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9448             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9449             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9450           .
     9451         end.
     9452       end.
     9453     end.
     9454   end procedure.
     9455   procedure ost-lineother-tax :
     9456     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     9457     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     9458     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     9459     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     9460     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     9461     define input  parameter x-tog-shift  as logical no-undo .
     9462     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     9463     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     9464     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     9465     define input  parameter xTog-obj     as logical no-undo .
     9466     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     9467     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     9468     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     9469     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     9470     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     9471     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     9472     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     9473     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     9474     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     9475     define buffer buff-obj-list  for obj-list .
     9476     define buffer buff-stk-line  for ub.stk-line .
     9477     assign
     9478       Quantity = 0
     9479       Coast_R  = 0
     9480       Coast_V  = 0
     9481       VAT_R    = 0
     9482       VAT_V    = 0
     9483       SLT_R    = 0
     9484       SLT_V    = 0
     9485       other_R  = 0
     9486       other_V  = 0
     9487     .
     9488     if  x-tog-shift = false then do:
     9489       for each buff-obj-list no-lock
     9490         where xtog-obj = false
     9491            or (buff-obj-list.obj-type = x-store-type
     9492               and buff-obj-list.obj-code = x-store-code
     9493               )
     9494       on error undo, return error
     9495       :
     9496       find last buff-stk-line no-lock
     9497         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9498           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9499           and buff-stk-line.artic      = x-artic
     9500           and buff-stk-line.prod-type  = x-prod-type
     9501           and buff-stk-line.prod-code  = x-prod-code
     9502           and buff-stk-line.sum-type   = x-sum-type
     9503           and buff-stk-line.cat-id     = '##,##':U
     9504           and buff-stk-line.fact-order <= x-fact-order
     9505           and buff-stk-line.shift-num  = 0
     9506         use-index category
     9507         no-error .
     9508       if available buff-stk-line then do:
     9509         assign
     9510           Quantity = Quantity + buff-stk-line.fact-qnty
     9511           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     9512           Coast_V  = Coast_V  + buff-stk-line.sum-base
     9513           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     9514           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     9515           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     9516           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     9517           other_R  = other_R  + buff-stk-line.other-rubl
     9518           other_V  = other_V  + buff-stk-line.other-base
     9519         .
     9520       end.
     9521    end.
     9522     end.
     9523     else do:
     9524       for each buff-obj-list no-lock
     9525         where xtog-obj = false
     9526            or (buff-obj-list.obj-type = x-store-type
     9527               and buff-obj-list.obj-code = x-store-code
     9528               )
     9529       on error undo, return error
     9530       :
     9531         find last buff-stk-line no-lock
     9532           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     9533             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     9534             and buff-stk-line.artic      = x-artic
     9535             and buff-stk-line.prod-type  = x-prod-type
     9536             and buff-stk-line.prod-code  = x-prod-code
     9537             and buff-stk-line.sum-type   = x-sum-type
     9538             and buff-stk-line.cat-id     = '##,##':U
     9539             and buff-stk-line.fact-order <= x-fact-order
     9540             and buff-stk-line.shift-num  > 0
     9541           use-index category
     9542           no-error .
     9543         if available buff-stk-line then do:
     9544           assign
     9545             Quantity = Quantity +  buff-stk-line.fact-qnty
     9546             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     9547             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     9548             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     9549             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     9550             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     9551             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     9552             other_R = other_R   +  buff-stk-line.other-rubl
     9553             other_V = other_V   +  buff-stk-line.other-base
     9554           .
     9555         end.
     9556       end.
     9557     end.
     9558   end procedure.
     9559   procedure ost-line-kg :
     9560     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     9561     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     9562     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     9563     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     9564     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     9565     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     9566     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     9567     define buffer buff-obj-list  for obj-list .
     9568     define buffer buf_doc-line for ub.doc-line .
     9569     define buffer buf_inv-line for ub.inv-line .
     9570     do
     9571     on error undo, return error
     9572     :
     9573       for each buf_doc-line no-lock where
     9574                buf_doc-line.obj-type    = p-obj-type   and
     9575                buf_doc-line.obj-code    = p-obj-code   and
     9576                buf_doc-line.prod-type   = p-prod-type  and
     9577                buf_doc-line.prod-code   = p-prod-code  and
     9578                buf_doc-line.artic       = p-artic      and
     9579                buf_doc-line.status_     = 'факт':U      and
     9580                buf_doc-line.fact-order <= p-fact-order
     9581             by buf_doc-line.fact-order    descending
     9582       :
     9583         find first buf_inv-line no-lock where
     9584                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     9585                    buf_inv-line.artic     = buf_doc-line.artic     and
     9586                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     9587                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     9588         if available buf_inv-line
     9589         then do:
     9590           if buf_inv-line.after-cli-qnty <> ?
     9591           then do:
     9592             assign
     9593               p-quantity-kg = buf_inv-line.after-cli-qnty
     9594             .
     9595             leave .
     9596           end.
     9597         end.
     9598       end.
     9599       if p-quantity-kg = ?
     9600       then do:
     9601         assign
     9602           p-quantity-kg = 0
     9603         .
     9604       end.
     9605     end.
     9606   end procedure.
