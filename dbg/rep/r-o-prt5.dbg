     9894   procedure init-p2:
     9895   run cur-time in this-procedure ( output v-today
     9896                                  , output x-time
     9897                                  ).
     9898   find last ub.ot-tot  no-lock use-index pi .
     9899   if avail  ub.ot-tot then fix-doc-code = ub.ot-tot.doc-code.
     9900                    else fix-doc-code = "".
     9901      FIND first ub.clients where x-store-type = ub.clients.obj-type AND
     9902               x-store-code = ub.clients.obj-code no-lock no-error.
     9903              If available ub.clients then  ObjName = ub.clients.obj-name.
     9904                                            else  ObjName="объект не определен".
     9905        assign
     9906           i=0
     9907           startdate     = x-date-start
     9908           enddate       = x-date-end
     9909           PayType       = x-SET_PAY_TYPE
     9910           v-var         = string("no-today")
     9911           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     9912           Find first ub.gds-prt where ub.gds-prt.node-name = '_Пустая шкала':U no-lock no-error.
     9913           If available  ub.gds-prt then   Prtroot = ub.gds-prt.prt-root.
     9914                                 Else   Prtroot = 0.
     9915     end procedure.
     9916   procedure in-proc:
     9917     if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then DO:
     9918         Case  ub.ot-line.sum-type :
     9919             When 'cost':U then do:
     9920                 f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     9921             End.
     9922             When 'sale':U then do:
     9923                 f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     9924                 f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     9925             End.
     9926             When  'crsa':U then do:
     9927                 f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     9928                 f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     9929                 IF itog = false then do:
     9930                     Create temp-doc-code .
     9931                     Assign
     9932                       temp-doc-code.doc-code = ub.ot-line.doc-code
     9933                       temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     9934                    .
     9935                 End.
     9936             End.
     9937         End case.
     9938       End.
     9939         Case  ub.ot-line.sum-type :
     9940             when 'cost':U then do:
     9941               f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     9942             end.
     9943             when  'crsa':U then do:
     9944               f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     9945               f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     9946             end.
     9947         End case.
     9948     end procedure.
