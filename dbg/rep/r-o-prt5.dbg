     6297   if c-f-cost-sum-o <>  ?  then do :
     6298   Assign
     6299       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     6300       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     6301   End.
     6302   if c-f-crsa-sum-o <>  ?  then do :
     6303   Assign
     6304       c-f-crsa-sum-o:DATA-TYPE = l1f-crsa-sum-o
     6305       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     6306   End.
     6307   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     6308   end.
     6309         n-nn = 0.
     6310         n-no = n-no + 1 .
     6311   for each ub.ot-line where
     6312         ub.ot-line.fact-order <= fact-order-2 and
     6313         ub.ot-line.fact-order >= fact-order-1 and
     6314         ub.ot-line.obj-code    = obj-list.obj-code and
     6315         ub.ot-line.obj-type    = obj-list.obj-type  and
     6316         ( ub.ot-line.sum-type = 'sale':U or
     6317           ub.ot-line.sum-type = 'crsa':U or
     6318           ub.ot-line.sum-type = 'cost':U )
     6319           no-lock ,
     6320         first goods where
     6321               goods.prod-type  = ub.ot-line.prod-type and
     6322               goods.prod-code  = ub.ot-line.prod-code and
     6323               goods.artic      = ub.ot-line.artic     and
     6324               goods.gds-type   = 'т':U
     6325               no-lock ,
     6326          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     6327                                 gds-list.prod-code = ub.ot-line.prod-code and
     6328                                 gds-list.artic     = ub.ot-line.artic
     6329           break
     6330               by  gds-list.qnty
     6331               by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     6332               by ub.ot-line.artic
     6333               with frame zapas :
     6334              n-nm = n-nm + 1.
     6335           if first-of(ub.ot-line.artic) then do:
     6336               assign
     6337                 f-qnty         = 0
     6338                 f-cost-sum     = 0
     6339                 f-sale-sum     = 0
     6340                 f-sale-other   = 0
     6341                 f-crsa-sum     = 0
     6342                 f-qnty-all     = 0
     6343                 f-cost-sum-all = 0
     6344                 f-crsa-sum-all = 0
     6345                 f-qnty-o       = 0
     6346                 f-cost-sum-o   = 0
     6347                 f-crsa-sum-o   = 0.
     6348               for each temp-doc-code  : delete temp-doc-code . end.
     6349               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     6350           end.
     6351           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     6352               case  ub.ot-line.sum-type :
     6353                   when 'cost':U then do:
     6354                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     6355                   end.
     6356                   when 'sale':U then do:
     6357                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     6358                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     6359                   end.
     6360                   when  'crsa':U then do:
     6361                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     6362                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     6363                       if itog = false then do:
     6364                           create temp-doc-code .
     6365                           assign
     6366                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     6367                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     6368                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     6369                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     6370                               .
     6371                       end.
     6372                   end.
     6373               end case.
     6374             end.
     6375               case  ub.ot-line.sum-type :
     6376                   when 'cost':U then do:
     6377                     f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     6378                   end.
     6379                   when  'crsa':U then do:
     6380                     f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     6381                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     6382                   end.
     6383               end case.
     6384               create temp-doc-code-all .
     6385               assign
     6386                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
     6387                   temp-doc-code-all.ext-doc-type = ub.ot-line.ext-doc-type
     6388                   temp-doc-code-all.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     6389                   temp-doc-code-all.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     6390                   .
     6391         if first-of(gds-list.qnty) then do:
     6392             var-client = string(gds-list.qnty) + '%'.
     6393                 if  itog = false then do:
     6394     if c-f-gds-name <>  ?  then do :
     6395       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     6396       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6397           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6398           display STREAM OutStream    with frame top-frame .
     6399       End.
     6400     End.
     6401                   display stream outstream .
     6402                   down stream outstream .
     6403                   if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     6404                 end.
     6405         end.
     6406         if last-of(ub.ot-line.artic) then do:
     6407             find first gds-obj where  ub.ot-line.prod-type = gds-obj.prod-type and
     6408                                       ub.ot-line.prod-code = gds-obj.prod-code and
     6409                                       ub.ot-line.artic     = gds-obj.artic and
     6410                                       ub.ot-line.obj-code  = gds-obj.obj-code and
     6411                                       ub.ot-line.obj-type  = gds-obj.obj-type
     6412                                       no-lock no-error .
     6413           if avail gds-obj then do:
     6414             if v-var = "no-today" then do:
     6415               run ost-line in this-procedure
     6416               (input   gds-obj.obj-code  ,
     6417               input   gds-obj.obj-type  ,
     6418               input   gds-obj.artic     ,
     6419               input   gds-obj.prod-code ,
     6420               input   gds-obj.prod-type ,
     6421               input   0                 ,
     6422               input   fact-order-2      ,
     6423               input   'crsa':U       ,
     6424               input   '##,##':U    ,
     6425               input   yes      ,
     6426               output  quantity1   ,
     6427               output  coast_r1  ,
     6428               output  coast_v1  ,
     6429               output  vat_r1    ,
     6430               output  vat_v1    ,
     6431               output  slt_r1    ,
     6432               output  slt_v1     ).
     6433             assign
     6434               f-qnty-o       = quantity1
     6435               f-crsa-sum-o   = if tprintrubl then coast_r1 else coast_v1
     6436               .
     6437               run ost-line in this-procedure
     6438               (input   gds-obj.obj-code  ,
     6439               input   gds-obj.obj-type  ,
     6440               input   gds-obj.artic     ,
     6441               input   gds-obj.prod-code ,
     6442               input   gds-obj.prod-type ,
     6443               input   0                 ,
     6444               input   fact-order-2      ,
     6445               input   'cost':U       ,
     6446               input   '##,##':U    ,
     6447               input   yes      ,
     6448               output  quantity1   ,
     6449               output  coast_r1  ,
     6450               output  coast_v1  ,
     6451               output  vat_r1    ,
     6452               output  vat_v1    ,
     6453               output  slt_r1    ,
     6454               output  slt_v1    ).
     6455             assign
     6456               f-cost-sum-o   = if tprintrubl then coast_r1 else coast_v1
     6457               .
     6458             end.
     6459             else do:
     6460               assign
     6461                 f-qnty-o     = gds-obj.fact-qnty
     6462                 f-cost-sum-o = gds-obj.fact-rubl
     6463                 f-crsa-sum-o = gds-obj.fact-sale .
     6464             end.
     6465           end.
     6466             if itog = false and
     6467               not(f-qnty        = 0 and
     6468                   f-qnty-o      = 0 and
     6469                   f-cost-sum    = 0 and
     6470                   f-sale-sum    = 0 and
     6471                   f-sale-other  = 0 and
     6472                   f-crsa-sum    = 0 and
     6473                   f-qnty-all    = 0 and
     6474                   f-cost-sum-all =0 and
     6475                   f-crsa-sum-all =0      )
