     6246       c-f-crsa-sum-o:DATA-TYPE = "CHARACTER"
     6247       c-f-crsa-sum-o:FORMAT    = "x(" + string(C-f-crsa-sum-o:WIDTH-CHARS) + ")"
     6248       c-f-crsa-sum-o:screen-value = string('')  .
     6249   End.
     6250   display stream outstream no-error .
     6251   down stream outstream .
     6252   if c-f-qnty <>  ?  then do :
