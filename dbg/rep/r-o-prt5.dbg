     5280       c-f-crsa-sum-all:screen-value = string(accum total f-crsa-sum-all) .
     5281       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5282           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5283           display STREAM OutStream    with frame top-frame .
