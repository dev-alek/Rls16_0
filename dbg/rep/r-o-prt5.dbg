     4310         n-nn = 0.
     4311         n-no = n-no + 1 .
     4312   for each ub.ot-line where
     4313         ub.ot-line.fact-order <= fact-order-2 and
     4314         ub.ot-line.fact-order >= fact-order-1 and
     4315         ub.ot-line.obj-code    = obj-list.obj-code and
     4316         ub.ot-line.obj-type    = obj-list.obj-type  and
     4317         ( ub.ot-line.sum-type = 'sale':U or
     4318           ub.ot-line.sum-type = 'crsa':U or
     4319           ub.ot-line.sum-type = 'cost':U )
     4320           no-lock ,
     4321         first goods where
     4322               goods.prod-type  = ub.ot-line.prod-type and
     4323               goods.prod-code  = ub.ot-line.prod-code and
     4324               goods.artic      = ub.ot-line.artic     and
     4325               goods.gds-type   = 'т':U
     4326               no-lock ,
     4327          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     4328                                 gds-list.prod-code = ub.ot-line.prod-code and
     4329                                 gds-list.artic     = ub.ot-line.artic
     4330           break
     4331               by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     4332               by ub.ot-line.prod-type by ub.ot-line.prod-code by ub.ot-line.artic
     4333               with frame zapas :
     4334              n-nm = n-nm + 1.
     4335           if first-of(ub.ot-line.artic) then do:
     4336               assign
     4337                 f-qnty         = 0
     4338                 f-cost-sum     = 0
     4339                 f-sale-sum     = 0
     4340                 f-sale-other   = 0
     4341                 f-crsa-sum     = 0
     4342                 f-qnty-all     = 0
     4343                 f-cost-sum-all = 0
     4344                 f-crsa-sum-all = 0
     4345                 f-qnty-o       = 0
     4346                 f-cost-sum-o   = 0
     4347                 f-crsa-sum-o   = 0.
     4348               for each temp-doc-code  : delete temp-doc-code . end.
     4349               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     4350           end.
     4351           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     4352               case  ub.ot-line.sum-type :
     4353                   when 'cost':U then do:
     4354                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     4355                   end.
     4356                   when 'sale':U then do:
     4357                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     4358                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     4359                   end.
     4360                   when  'crsa':U then do:
     4361                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     4362                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     4363                       if itog = false then do:
     4364                           create temp-doc-code .
     4365                           assign
     4366                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     4367                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     4368                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4369                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     4370                               .
     4371                       end.
     4372                   end.
     4373               end case.
     4374             end.
     4375               case  ub.ot-line.sum-type :
     4376                   when 'cost':U then do:
     4377                     f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     4378                   end.
     4379                   when  'crsa':U then do:
     4380                     f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     4381                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     4382                   end.
     4383               end case.
     4384               create temp-doc-code-all .
     4385               assign
     4386                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
     4387                   temp-doc-code-all.ext-doc-type = ub.ot-line.ext-doc-type
     4388                   temp-doc-code-all.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     4389                   temp-doc-code-all.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     4390                   .
     4391         if last-of(ub.ot-line.artic) then do:
