     3707                                  and out-vatp_partsprl.obj-type   = varobj-type
     3708                                  and out-vatp_partsprl.obj-code   = varobj-code
     3709                                  and out-vatp_partsprl.artic      = varartic
     3710                                  and out-vatp_partsprl.prod-type  = varprod-type
     3711                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     3712       if out-vatp_partsprl.purch-code = 2 then do:
