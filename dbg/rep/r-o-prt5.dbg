     3561         vardiscnt-rubl = 0
     3562       .
     3563       assign
     3564         varfact-qnty = 0
     3565       .
     3566       for each bf_parts no-lock
     3567         where bf_parts.out-code   = bf_price-list.doc-num
     3568           and bf_parts.obj-type   = bf_price-list.obj-type
     3569           and bf_parts.obj-code   = bf_price-list.obj-code
     3570           and bf_parts.artic      = bf_price-list.artic
     3571           and bf_parts.prod-type  = bf_price-list.prod-type
     3572           and bf_parts.prod-code  = bf_price-list.prod-code
     3573       :
     3574         assign
     3575           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     3576         .
     3577       end.
