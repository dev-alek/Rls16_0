     5498       l2f-cost-sum-all  = c-f-cost-sum-all:FORMAT
     5499       c-f-cost-sum-all:DATA-TYPE = "CHARACTER"
     5500       c-f-cost-sum-all:FORMAT    = "x(" + string(C-f-cost-sum-all:WIDTH-CHARS) + ")"
     5501       c-f-cost-sum-all:screen-value = string('')  .
     5502   End.
