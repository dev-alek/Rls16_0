     7474   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     7475     n-nn = 0.
     7476     n-no = n-no + 1 .
     7477    For Each gds-obj where
     7478             gds-obj.obj-code    = obj-list.obj-code and
     7479             gds-obj.obj-type    = obj-list.obj-type
     7480             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     7481             no-lock,
     7482             first goods where   goods.gds-code    = gds-obj.gds-code  and
     7483                                 goods.gds-type    = 'т':U
     7484                                 no-lock
     7485             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     7486                                      gds-list.prod-code = gds-obj.prod-code and
     7487                                      gds-list.artic     = gds-obj.artic
     7488               break
     7489                   by gds-obj.prod-type By gds-obj.prod-code by gds-obj.artic
     7490                   with FRAME Zapas :
     7491                IF first-of(gds-obj.artic) then DO:
     7492                   assign
     7493                     f-qnty         = 0
     7494                     f-cost-sum     = 0
     7495                     f-sale-sum     = 0
     7496                     f-sale-other   = 0
     7497                     f-crsa-sum     = 0
     7498                     f-qnty-all     = 0
     7499                     f-cost-sum-all = 0
     7500                     f-crsa-sum-all = 0
     7501                     f-qnty-o       = 0
     7502                     f-cost-sum-o   = 0
     7503                     f-crsa-sum-o   = 0.
     7504                 For Each temp-doc-code  : delete temp-doc-code . end.
     7505                 For Each ub.ot-line where
     7506                           ub.ot-line.fact-order <= fact-order-2 and
     7507                           ub.ot-line.fact-order >= fact-order-1 and
     7508                           ub.ot-line.obj-code    = obj-list.obj-code and
     7509                           ub.ot-line.obj-type    = obj-list.obj-type  and
     7510                           ub.ot-line.artic     = gds-obj.artic  and
     7511                           ub.ot-line.prod-type = gds-obj.prod-type and
     7512                           ub.ot-line.prod-code = gds-obj.prod-code and
     7513                           (ub.ot-line.sum-type = 'sale':U OR
     7514                             ub.ot-line.sum-type = 'crsa':U OR
     7515                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     7516                       run in-proc.
     7517                 End.
     7518               End.
     7519             if first-of(gds-obj.prod-code) then DO:
     7520                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     7521                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     7522                  if avail clients-p then var-client = Clients-p.obj-name.
     7523                     if  Itog = false Then do:
     7524     if c-f-gds-name <>  ?  then do :
     7525       c-f-gds-name:screen-value = string(var-client) .
     7526       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7527           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7528           display STREAM OutStream    with frame top-frame .
     7529       End.
     7530     End.
     7531                       Display stream OutStream .
     7532                       DOWN stream OutStream .
     7533                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     7534                     End.
     7535             End.
     7536             if last-of(gds-obj.artic) then DO:
     7537             run last-of-artic.
     7538                 accumulate f-qnty           (TOTAL  by gds-obj.prod-code ) .
     7539                 accumulate f-cost-sum       (TOTAL  by gds-obj.prod-code ) .
     7540                 accumulate f-sale-sum       (TOTAL  by gds-obj.prod-code ) .
     7541                 accumulate f-sale-other     (TOTAL  by gds-obj.prod-code ) .
     7542                 accumulate f-crsa-sum       (TOTAL  by gds-obj.prod-code ) .
     7543                 accumulate f-qnty-all       (TOTAL  by gds-obj.prod-code ) .
     7544                 accumulate f-cost-sum-all   (TOTAL  by gds-obj.prod-code ) .
     7545                 accumulate f-crsa-sum-all   (TOTAL  by gds-obj.prod-code ) .
     7546                 accumulate f-qnty-o         (TOTAL  by gds-obj.prod-code ) .
     7547                 accumulate f-cost-sum-o     (TOTAL  by gds-obj.prod-code ) .
     7548                 accumulate f-crsa-sum-o     (TOTAL  by gds-obj.prod-code ) .
     7549                   Assign
     7550                     f-qnty          = 0
     7551                     f-crsa-sum      = 0
     7552                     f-qnty          = 0
     7553                     f-cost-sum      = 0
     7554                     f-sale-sum      = 0
     7555                     f-sale-other    = 0
     7556                     f-crsa-sum      = 0
     7557                     f-qnty-all      = 0
     7558                     f-cost-sum-all  = 0
     7559                     f-crsa-sum-all  = 0
     7560                     f-qnty-o        = 0
     7561                     f-cost-sum-o    = 0
     7562                     f-crsa-sum-o    = 0
     7563                    .
     7564             End.
     7565             if last-of(gds-obj.prod-code)  then do :
     7566               f-artic = 'по произв.' .
     7567     if c-nn <>  ?  then do :
