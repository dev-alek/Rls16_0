     8627   if c-f-cost-sum-all <>  ?  then do :
     8628   Assign
     8629       c-f-cost-sum-all:DATA-TYPE = l1f-cost-sum-all
     8630       c-f-cost-sum-all:FORMAT    = l2f-cost-sum-all.
