     5540       c-f-qnty:FORMAT    = l2f-qnty.
     5541   End.
     5542   if c-f-cost-sum <>  ?  then do :
     5543   Assign
     5544       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     5545       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     5546   End.
     5547   if c-f-sale-sum <>  ?  then do :
     5548   Assign
     5549       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     5550       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     5551   End.
     5552   if c-f-sale-other <>  ?  then do :
     5553   Assign
     5554       c-f-sale-other:DATA-TYPE = l1f-sale-other
     5555       c-f-sale-other:FORMAT    = l2f-sale-other.
     5556   End.
     5557   if c-f-crsa-sum <>  ?  then do :
     5558   Assign
     5559       c-f-crsa-sum:DATA-TYPE = l1f-crsa-sum
     5560       c-f-crsa-sum:FORMAT    = l2f-crsa-sum.
     5561   End.
     5562   if c-f-qnty-all <>  ?  then do :
     5563   Assign
     5564       c-f-qnty-all:DATA-TYPE = l1f-qnty-all
     5565       c-f-qnty-all:FORMAT    = l2f-qnty-all.
     5566   End.
     5567   if c-f-cost-sum-all <>  ?  then do :
     5568   Assign
     5569       c-f-cost-sum-all:DATA-TYPE = l1f-cost-sum-all
     5570       c-f-cost-sum-all:FORMAT    = l2f-cost-sum-all.
     5571   End.
     5572   if c-f-crsa-sum-all <>  ?  then do :
     5573   Assign
     5574       c-f-crsa-sum-all:DATA-TYPE = l1f-crsa-sum-all
     5575       c-f-crsa-sum-all:FORMAT    = l2f-crsa-sum-all.
     5576   End.
     5577   if c-f-qnty-o <>  ?  then do :
     5578   Assign
     5579       c-f-qnty-o:DATA-TYPE = l1f-qnty-o
     5580       c-f-qnty-o:FORMAT    = l2f-qnty-o.
     5581   End.
     5582   if c-f-cost-sum-o <>  ?  then do :
     5583   Assign
     5584       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     5585       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     5586   End.
     5587   if c-f-crsa-sum-o <>  ?  then do :
     5588   Assign
     5589       c-f-crsa-sum-o:DATA-TYPE = l1f-crsa-sum-o
     5590       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     5591   End.
     5592   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     5593   end.
     5594         n-nn = 0.
     5595         n-no = n-no + 1 .
     5596   for each ub.ot-line where
     5597         ub.ot-line.fact-order <= fact-order-2 and
     5598         ub.ot-line.fact-order >= fact-order-1 and
     5599         ub.ot-line.obj-code    = obj-list.obj-code and
     5600         ub.ot-line.obj-type    = obj-list.obj-type  and
     5601         ( ub.ot-line.sum-type = 'sale':U or
     5602           ub.ot-line.sum-type = 'crsa':U or
     5603           ub.ot-line.sum-type = 'cost':U )
     5604           no-lock ,
     5605         first goods where
     5606               goods.prod-type  = ub.ot-line.prod-type and
     5607               goods.prod-code  = ub.ot-line.prod-code and
     5608               goods.artic      = ub.ot-line.artic     and
     5609               goods.gds-type   = 'т':U
     5610               no-lock ,
     5611          first gds-list where  gds-list.prod-type  = ub.ot-line.prod-type and
     5612                                 gds-list.prod-code = ub.ot-line.prod-code and
     5613                                 gds-list.artic     = ub.ot-line.artic
     5614           break
     5615               by goods.grp-name by ( ub.ot-line.artic + ub.ot-line.prod-type + string ( ub.ot-line.prod-code ))
     5616               by ub.ot-line.artic
     5617               with frame zapas :
     5618              n-nm = n-nm + 1.
     5619           if first-of(ub.ot-line.artic) then do:
     5620               assign
     5621                 f-qnty         = 0
     5622                 f-cost-sum     = 0
     5623                 f-sale-sum     = 0
     5624                 f-sale-other   = 0
     5625                 f-crsa-sum     = 0
     5626                 f-qnty-all     = 0
     5627                 f-cost-sum-all = 0
     5628                 f-crsa-sum-all = 0
     5629                 f-qnty-o       = 0
     5630                 f-cost-sum-o   = 0
     5631                 f-crsa-sum-o   = 0.
     5632               for each temp-doc-code  : delete temp-doc-code . end.
     5633               for each temp-doc-code-all  : delete temp-doc-code-all . end.
     5634           end.
     5635           if can-find( first tdedt where  ub.ot-line.ext-doc-type = tdedt.id no-lock ) then do:
     5636               case  ub.ot-line.sum-type :
     5637                   when 'cost':U then do:
     5638                       f-cost-sum = f-cost-sum + ub.ot-line.sum-rubl .
     5639                   end.
     5640                   when 'sale':U then do:
     5641                       f-sale-sum   = f-sale-sum   +  ub.ot-line.sum-rubl .
     5642                       f-sale-other = f-sale-other + ub.ot-line.other-rubl .
     5643                   end.
     5644                   when  'crsa':U then do:
     5645                       f-crsa-sum = f-crsa-sum + ub.ot-line.sum-rubl  .
     5646                       f-qnty     = f-qnty     + ub.ot-line.fact-qnty .
     5647                       if itog = false then do:
     5648                           create temp-doc-code .
     5649                           assign
     5650                               temp-doc-code.doc-code     = ub.ot-line.doc-code
     5651                               temp-doc-code.ext-doc-type = ub.ot-line.ext-doc-type
     5652                               temp-doc-code.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
     5653                               temp-doc-code.si2 = if  ub.ot-line.other-rubl < 0 then -1 else 1
     5654                               .
     5655                       end.
     5656                   end.
     5657               end case.
     5658             end.
     5659               case  ub.ot-line.sum-type :
     5660                   when 'cost':U then do:
     5661                     f-cost-sum-all = f-cost-sum-all + ub.ot-line.sum-rubl .
     5662                   end.
     5663                   when  'crsa':U then do:
     5664                     f-crsa-sum-all = f-crsa-sum-all + ub.ot-line.sum-rubl  .
     5665                     f-qnty-all     = f-qnty-all     + ub.ot-line.fact-qnty .
     5666                   end.
     5667               end case.
     5668               create temp-doc-code-all .
     5669               assign
     5670                   temp-doc-code-all.doc-code = ub.ot-line.doc-code
     5671                   temp-doc-code-all.ext-doc-type = ub.ot-line.ext-doc-type
     5672                   temp-doc-code-all.si  = if  ub.ot-line.fact-qnty < 0 then -1 else 1
