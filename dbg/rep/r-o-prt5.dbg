     1519     ,input  p-prod-code
     1520     ,input  v-root-node
     1521     ,buffer buf_gds-obj
     1522     ,buffer buf_prt-obj
     1523     ) no-error .
     1524       if error-status :error
     1525       then do:
     1526         message
     1527           vss-workfile vss-revision vss-description skip
     1528           vss-include-info16 skip
     1529           "Ошибка при начале товародвижения товара на объекте" skip
     1530           "Объект" p-obj-type p-obj-code skip
     1531           "Артикул" p-artic p-prod-type p-prod-code skip
     1532           error-status :get-message(1) skip
     1533           return-value skip
     1534           view-as alert-box error .
     1535         undo, return error .
     1536       end.
     1537       find current buf_gds-obj  exclusive-lock .
     1538       find current buf_prt-obj  exclusive-lock .
     1539   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1541     (input  p-artic
     1542     ,input  p-prod-type
     1543     ,input  p-prod-code
     1544     ,output v-gds-code
     1545     )  .
     1546   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1547     (input  v-gds-code
     1548     ,input  v-root-node
