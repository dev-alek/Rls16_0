     1479     define input  parameter p-check-price-parts as logical   no-undo .
     1480     define input  parameter p-doc-num           as character no-undo .
     1481     define input  parameter p-fact-date         as date      no-undo .
     1482     define input  parameter p-corr-user-db-num  as integer   no-undo .
     1483     define input  parameter p-corr-user-name    as character no-undo .
     1484     define input  parameter p-corr-date         as date      no-undo .
     1485     define input  parameter p-corr-time         as integer   no-undo .
     1486     define input  parameter p-corr-time-str     as character no-undo .
     1487     define output parameter p-gds-obj-fact-qnty as decimal   no-undo .
     1488     define variable vss-description as character no-undo initial "prdoclib-process-goods-01: обработка продажных цен товара".
     1489     define buffer buf_gds-obj      for ub.gds-obj .
     1490     define buffer buf_prt-obj      for ub.prt-obj .
