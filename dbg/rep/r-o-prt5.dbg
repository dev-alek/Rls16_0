     3740     assign
     3741      price-cli-with-tax-locoprl = out-vatp_partsprl.price-cli
     3742      cli-base-rateoprl          = out-vatp_partsprl.cli-base-rate.
     3743     ASSIGN   road-tax-base-locoprl  = (if out-vatp_partsprl.road-tax-base  = ? then 0 else out-vatp_partsprl.road-tax-base)
     3744              road-tax-rubl-locoprl  = (if out-vatp_partsprl.road-tax-rubl  = ? then 0 else out-vatp_partsprl.road-tax-rubl).
     3745     ASSIGN  transport-base-locoprl = (if out-vatp_partsprl.transport-base = ? then 0 else out-vatp_partsprl.transport-base)
     3746             transport-rubl-locoprl = (if out-vatp_partsprl.transport-rubl = ? then 0 else out-vatp_partsprl.transport-rubl)
     3747             other-base-locoprl     = (if out-vatp_partsprl.other-base     = ? then 0 else out-vatp_partsprl.other-base)
     3748             other-rubl-locoprl     = (if out-vatp_partsprl.other-rubl     = ? then 0 else out-vatp_partsprl.other-rubl)
     3749             vat-pc-locoprl         = (if out-vatp_partsprl.vat-pc         = ? then 0 else out-vatp_partsprl.vat-pc)
     3750             slt-pc-locoprl         = (if out-vatp_partsprl.slt-pc         = ? then 0 else out-vatp_partsprl.slt-pc).
     3751             ASSIGN   slt-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-base-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-base-with-tax-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3752       ASSIGN   slt-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl)))                           * slt-pc-locoprl / (100 + slt-pc-locoprl))                        vat-rubl-locoprl    = (if in-vatp-have-vat-sltoprl = no then 0 else (price-rubl-with-tax-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))) * (1 - slt-pc-locoprl / (100 + slt-pc-locoprl)) * vat-pc-locoprl / (100 + vat-pc-locoprl)).
     3753     assign
     3754       exch-rate-cli-locoprl = (out-vatp_partsprl.price-rubl - transport-rubl-locoprl - other-rubl-locoprl - road-tax-rubl-locoprl - (if out-vatp_partsprl.vat-type <> 'в т. ч.':U then vat-rubl-locoprl else 0) - (if out-vatp_partsprl.slt-type <> 'в т. ч.':U then slt-rubl-locoprl else 0)) / out-vatp_partsprl.price-cli .
     3755     assign
     3756       slt-cli-locoprl        = slt-rubl-locoprl       / exch-rate-cli-locoprl
     3757       vat-cli-locoprl        = vat-rubl-locoprl       / exch-rate-cli-locoprl
     3758       road-tax-cli-locoprl   = road-tax-rubl-locoprl  / exch-rate-cli-locoprl
     3759       transport-cli-locoprl  = 0
     3760       other-cli-locoprl      = 0
     3761     .
     3762   ASSIGN
     3763             price-base-without-tax-locoprl = price-base-with-tax-locoprl - vat-base-locoprl - slt-base-locoprl - ((if road-tax-base-locoprl  = ? then 0 else road-tax-base-locoprl) + (if transport-base-locoprl = ? then 0 else transport-base-locoprl) + (if other-base-locoprl = ? then 0 else other-base-locoprl))
     3764       price-rubl-without-tax-locoprl = price-rubl-with-tax-locoprl - vat-rubl-locoprl - slt-rubl-locoprl - ((if road-tax-rubl-locoprl  = ? then 0 else road-tax-rubl-locoprl) + (if transport-rubl-locoprl = ? then 0 else transport-rubl-locoprl) + (if other-rubl-locoprl = ? then 0 else other-rubl-locoprl))
     3765   .
     3766         assign
     3767           varprice-base-consprl = varprice-base-consprl + (price-base-with-tax-locoprl - (if road-tax-base-locoprl = ? then 0 else road-tax-base-locoprl))* out-vatp_partsprl.fact-qnty
     3768           varprice-rubl-consprl = varprice-rubl-consprl + (price-rubl-with-tax-locoprl - (if road-tax-rubl-locoprl = ? then 0 else road-tax-rubl-locoprl))* out-vatp_partsprl.fact-qnty.
     3769         assign
     3770           varis-cons-parts-haveprl = yes
     3771           varcons-qntyprl          = varcons-qntyprl + out-vatp_partsprl.fact-qnty.
     3772       end.
     3773       assign
     3774         varfact-qntyprl = varfact-qntyprl + out-vatp_partsprl.fact-qnty.
     3775     end.
     3776   end.
     3777   assign
     3778     varprice-base-consprl = varprice-base-consprl / varcons-qntyprl
     3779     varprice-rubl-consprl = varprice-rubl-consprl / varcons-qntyprl.
     3780   if varprice-base-consprl = ? then do:
     3781     assign
     3782       varprice-base-consprl = 0.
     3783   end.
     3784   if varprice-rubl-consprl = ? then do:
     3785     assign
     3786       varprice-rubl-consprl = 0.
     3787   end.
     3788   assign
     3789       slt-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3790     vat-base-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3791     discnt-base-saleprl            = vardiscnt-base
     3792     price-base-with-tax-saleprl    = (varprice-base - vardiscnt-base)
     3793       slt-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc)
     3794     vat-rubl-buyerprl              = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc)
     3795     discnt-rubl-saleprl            = vardiscnt-rubl
     3796     price-rubl-with-tax-saleprl    = (varprice-rubl - vardiscnt-rubl)
     3797     .
     3798   if vardoc-type = 'инв':U then do:
     3799     assign
     3800       varfact-qntyprl = vardoc-qnty.
     3801   end.
     3802   else do:
     3803     assign
     3804       varfact-qntyprl = varfact-qnty.
     3805   end.
     3806   if varis-cons-parts-haveprl = no then do:
     3807     assign
     3808           vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc)
     3809           vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc).
     3810   end.
     3811   else do:
     3812     if vardoc-type = 'инв':U then do:
     3813       assign
     3814               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3815               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * vardoc-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl) * varvat-pc / (100 + varvat-pc) * vardoc-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3816        .
     3817     end.
     3818     else do:
     3819       assign
     3820               vat-base-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-base-saleprl - varprice-base-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-base - vardiscnt-base) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-base - vardiscnt-base                - road-tax-base-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-base-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3821               vat-rubl-saleprl               = (if out-vatp-have-vat-sltprl = no then 0 else (((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - road-tax-rubl-saleprl - varprice-rubl-consprl) * varcons-vat-pc / (100 + varcons-vat-pc) * varfact-qnty * varcons-qntyprl / varfact-qntyprl + ((varprice-rubl - vardiscnt-rubl) - (if out-vatp-have-vat-sltprl = no then 0 else varprice-rubl - vardiscnt-rubl                - road-tax-rubl-saleprl) * varSLT-pc / (100 + varSLT-pc) - varprice-rubl-consprl) * varvat-pc / (100 + varvat-pc) * varfact-qnty * (varfact-qntyprl - varcons-qntyprl) / varfact-qntyprl) / varfact-qntyprl)
     3822        .
     3823     end.
     3824   end.
     3825   assign
     3826   price-base-without-tax-saleprl = price-base-with-tax-saleprl - vat-base-saleprl - slt-base-saleprl - road-tax-base-saleprl
     3827   price-rubl-without-tax-saleprl = price-rubl-with-tax-saleprl - vat-rubl-saleprl - slt-rubl-saleprl - road-tax-rubl-saleprl.
     3828     end.
     3829   end procedure.
     3830   PROCEDURE report-execute :
     3831     If (ValType=0 and x-base-code=0)  Or ValType=1
     3832                                   then   assign tPrintRubl = yes .
     3833                                   else   assign tPrintRubl = no .
     3834      NO-PRISE = true .
     3835     if var-report-r-b = "rubl"  Then
     3836       if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     3837     else
     3838       if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     3839     If ReportPageHeight = 0 then ReportPageHeight = 43 .
     3840   output stream OutStream to value( string( session:temp-directory +
     3841                                        "rpt" + string( g#report-num ) ) )
     3842                                        page-size  value(ReportPageHeight) .
     3843     FORM with FRAME Zapas .
     3844   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3845   form header
     3846     line format "x(198)" at 1 skip
     3847     "Продолжение - на следующей странице" at 30 skip
     3848     with frame bottomframe width 232 page-bottom no-labels no-box .
     3849   view stream outstream frame bottomframe .
     3850      Line = fill("-", 198).
     3851     Run CalcItog in this-procedure.
     3852     Run Print-Header in this-procedure.
     3853     If x-zero = false then do:
     3854       CAse classify :
     3855         when 1 then do:
     3856           Run Foreach1 in this-procedure.
     3857         end.
     3858         when 2 then do:
     3859           Run Foreach2 in this-procedure.
     3860         end.
     3861         when 3 then do:
     3862           Run Foreach3 in this-procedure.
     3863         end.
     3864         when 4 then do:
     3865           Run Foreach4 in this-procedure.
     3866         end.
     3867       End case.
     3868    End.
     3869    Else do:
     3870       CAse classify :
     3871         when 1 then do:
     3872           Run Foreach1_1 in this-procedure.
     3873         end.
     3874         when 2 then do:
     3875           Run Foreach2_1 in this-procedure.
     3876         end.
     3877         when 3 then do:
     3878           Run Foreach3_1 in this-procedure.
     3879         end.
     3880         when 4 then do:
     3881           Run Foreach4_1 in this-procedure.
     3882         end.
     3883       End case.
     3884    End.
     3885     HIDE stream OutStream FRAME BottomFrame .
     3886     Run  Print-footer in this-procedure.
     3887     HIDE STREAM OutStream FRAME Zapas .
     3888     HIDE   STREAM OutStream FRAME top-Frame .
     3889     DELETE WIDGET-POOL "My-pool".
     3890     Output stream OutStream close.
     3891     if Make-Excel then output stream ForExcel close.
     3892   if mFrameView
     3893   then do:
     3894      HIDE FRAME InfoFrame.
     3895   end.
     3896     define variable v-user-action as character no-undo .
     3897     define variable v-printed as logical   no-undo .
     3898     define variable DisabledOptions as integer   no-undo .
     3899     define variable v-orient-page as character no-undo .
     3900     run How-name in this-procedure (
     3901         input ReportPageHeight,
     3902         input ReportPageWidth,
     3903         output v-orient-page )
     3904         .
     3905     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     3906                                    else DisabledOptions = 0 .
     3907     run gbl/prnfilen.w
     3908       (input  ""
     3909       ,input  DisabledOptions
     3910       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3911       ,input ReportFontNum
     3912       ,output v-user-action
     3913       ,output v-printed
     3914       ) .
     3915   END PROCEDURE.
     3916   PROCEDURE print-header :
     3917      PUT stream OutStream  string(v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName)
     3918            AT 50 format "X(85)" SKIP(2)
     3919            REPORTNAME
     3920            AT 35  format "X(100)" skip.
     3921        PUT stream OutStream   "за период с "  + string(x-date-start,"99/99/9999") +
     3922            " по "  + string(x-date-end,"99/99/9999") +
     3923            " дата и время формирования " + cur-time-string-sec()
     3924                                                       AT 35 format "X(160)" SKIP.
     3925        Repeat i = 1 to NUM-ENTRIES(STR2,chr(10)) :
     3926           PUT stream OutStream  Entry(i,STR2,chr(10))  AT 1 format "X(160)" SKIP.
     3927        End.
     3928        Repeat i = 1 to NUM-ENTRIES(STR3,chr(10)) :
     3929           PUT stream OutStream  Entry(i,STR3,chr(10))  AT 1 format "X(160)" SKIP.
     3930        End.
     3931        Repeat i = 1 to NUM-ENTRIES(STR4,chr(10)) :
     3932           PUT stream OutStream  Entry(i,STR4,chr(10))  AT 1 format "X(160)" SKIP.
     3933        End.
     3934        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     3935           PUT stream OutStream  Entry(i,ReportHeader,chr(10))  AT 1 format "X(160)" SKIP.
     3936        End.
     3937       i=0.
     3938       run rep/extitle.p (1) .
     3939       display STREAM OutStream     with frame top-Frame .
     3940      END PROCEDURE.
     3941   PROCEDURE Print-Footer :
     3942     run cur-time in this-procedure ( output v-today
     3943                                    , output v-time
     3944                                    ).
     3945     PUT STREAM OutStream UNFORMATTED " Печать закончена : " + string(v-time,"HH:MM:SS") SKIP.
     3946     PUT STREAM OutStream UNFORMATTED " ______________________________________________________" SKIP.
     3947      run on-same-page in this-procedure (input 1) .
     3948      END PROCEDURE.
     3949   PROCEDURE U-LINE :
     3950   define variable ff as character no-undo .
     3951   if itog = false
     3952   Then do:
     3953   ff = fill("-",40).
     3954     if c-nn <>  ?  then do :
     3955       c-nn:screen-value = string(ff) .
     3956       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     3957           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     3958           display STREAM OutStream    with frame top-frame .
