     3662   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3664     (output varoutvprbprl
     3665     )  .
     3666   if varoutvprbprl = "base":u then do:
     3667     assign
     3668           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     3669       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     3670     .
     3671   end.
     3672   else do:
     3673     assign
     3674           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     3675       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     3676     .
     3677   end.
     3678   if varoutvprbprl = "rubl":u then do:
     3679     assign
     3680           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     3681       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     3682   end.
     3683   else do:
     3684     assign
     3685           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     3686       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     3687   end.
     3688   assign
     3689     varis-cons-parts-haveprl =  no.
     3690   assign
     3691     varfact-qntyprl       = 0
     3692     varcons-qntyprl       = 0
     3693     varprice-base-consprl = 0
     3694     varprice-rubl-consprl = 0.
