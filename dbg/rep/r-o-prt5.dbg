     8632   if c-f-crsa-sum-all <>  ?  then do :
     8633   Assign
     8634       c-f-crsa-sum-all:DATA-TYPE = l1f-crsa-sum-all
     8635       c-f-crsa-sum-all:FORMAT    = l2f-crsa-sum-all.
     8636   End.
     8637   if c-f-qnty-o <>  ?  then do :
     8638   Assign
     8639       c-f-qnty-o:DATA-TYPE = l1f-qnty-o
     8640       c-f-qnty-o:FORMAT    = l2f-qnty-o.
     8641   End.
     8642   if c-f-cost-sum-o <>  ?  then do :
     8643   Assign
     8644       c-f-cost-sum-o:DATA-TYPE = l1f-cost-sum-o
     8645       c-f-cost-sum-o:FORMAT    = l2f-cost-sum-o.
     8646   End.
     8647   if c-f-crsa-sum-o <>  ?  then do :
     8648   Assign
     8649       c-f-crsa-sum-o:DATA-TYPE = l1f-crsa-sum-o
     8650       c-f-crsa-sum-o:FORMAT    = l2f-crsa-sum-o.
     8651   End.
     8652   if Make-Excel then  put   stream ForExcel unformatted  obj-list.obj-name chr(10).
     8653     n-nn = 0.
     8654     n-no = n-no + 1 .
     8655    for each gds-obj where
     8656             gds-obj.obj-code    = obj-list.obj-code and
     8657             gds-obj.obj-type    = obj-list.obj-type
     8658             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     8659             no-lock,
     8660             first goods where   goods.gds-code    = gds-obj.gds-code  and
     8661                                 goods.gds-type    = 'т':U
     8662                                 no-lock
     8663             , first gds-list where   gds-list.prod-type = gds-obj.prod-type and
     8664                                      gds-list.prod-code = gds-obj.prod-code and
     8665                                      gds-list.artic     = gds-obj.artic     :
     8666        gds-list.qnty = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     8667     end.
     8668    For Each gds-obj where
     8669             gds-obj.obj-code    = obj-list.obj-code and
     8670             gds-obj.obj-type    = obj-list.obj-type
     8671             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     8672             no-lock,
     8673             first goods where   goods.gds-code    = gds-obj.gds-code  and
     8674                                 goods.gds-type    = 'т':U
     8675                                 no-lock
     8676             , First gds-list where   gds-list.prod-type = gds-obj.prod-type and
     8677                                      gds-list.prod-code = gds-obj.prod-code and
     8678                                      gds-list.artic     = gds-obj.artic
     8679               break
     8680                   by gds-list.qnty
     8681                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     8682                   by gds-obj.artic
     8683                   with FRAME Zapas :
     8684                IF first-of(gds-obj.artic) then DO:
     8685                   assign
     8686                     f-qnty         = 0
     8687                     f-cost-sum     = 0
     8688                     f-sale-sum     = 0
     8689                     f-sale-other   = 0
     8690                     f-crsa-sum     = 0
     8691                     f-qnty-all     = 0
     8692                     f-cost-sum-all = 0
     8693                     f-crsa-sum-all = 0
     8694                     f-qnty-o       = 0
     8695                     f-cost-sum-o   = 0
     8696                     f-crsa-sum-o   = 0.
     8697                 For Each temp-doc-code  : delete temp-doc-code . end.
     8698                 For Each ub.ot-line where
     8699                           ub.ot-line.fact-order <= fact-order-2 and
     8700                           ub.ot-line.fact-order >= fact-order-1 and
     8701                           ub.ot-line.obj-code    = obj-list.obj-code and
     8702                           ub.ot-line.obj-type    = obj-list.obj-type  and
     8703                           ub.ot-line.artic     = gds-obj.artic  and
     8704                           ub.ot-line.prod-type = gds-obj.prod-type and
     8705                           ub.ot-line.prod-code = gds-obj.prod-code and
     8706                           (ub.ot-line.sum-type = 'sale':U OR
     8707                             ub.ot-line.sum-type = 'crsa':U OR
     8708                             ub.ot-line.sum-type = 'cost':U ) no-lock :
     8709                       run in-proc.
     8710                 End.
     8711               End.
     8712             if first-of(gds-list.qnty) then DO:
     8713                var-client = string(gds-list.qnty) + '%'.
     8714                     if  Itog = false Then do:
     8715     if c-f-gds-name <>  ?  then do :
     8716       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     8717       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8718           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8719           display STREAM OutStream    with frame top-frame .
     8720       End.
     8721     End.
     8722                       Display stream OutStream .
     8723                       DOWN stream OutStream .
     8724                       if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     8725                     End.
     8726             End.
     8727             if last-of(gds-obj.artic) then DO:
     8728             run last-of-artic.
     8729                 accumulate f-qnty           (TOTAL  by gds-list.qnty ) .
     8730                 accumulate f-cost-sum       (TOTAL  by gds-list.qnty ) .
     8731                 accumulate f-sale-sum       (TOTAL  by gds-list.qnty ) .
     8732                 accumulate f-sale-other     (TOTAL  by gds-list.qnty ) .
     8733                 accumulate f-crsa-sum       (TOTAL  by gds-list.qnty ) .
     8734                 accumulate f-qnty-all       (TOTAL  by gds-list.qnty ) .
     8735                 accumulate f-cost-sum-all   (TOTAL  by gds-list.qnty ) .
     8736                 accumulate f-crsa-sum-all   (TOTAL  by gds-list.qnty ) .
     8737                 accumulate f-qnty-o         (TOTAL  by gds-list.qnty ) .
     8738                 accumulate f-cost-sum-o     (TOTAL  by gds-list.qnty ) .
     8739                 accumulate f-crsa-sum-o     (TOTAL  by gds-list.qnty ) .
     8740                   Assign
     8741                     f-qnty          = 0
     8742                     f-crsa-sum      = 0
     8743                     f-qnty          = 0
     8744                     f-cost-sum      = 0
     8745                     f-sale-sum      = 0
     8746                     f-sale-other    = 0
     8747                     f-crsa-sum      = 0
     8748                     f-qnty-all      = 0
     8749                     f-cost-sum-all  = 0
     8750                     f-crsa-sum-all  = 0
     8751                     f-qnty-o        = 0
     8752                     f-cost-sum-o    = 0
     8753                     f-crsa-sum-o    = 0
     8754                    .
     8755             End.
     8756             if last-of(gds-list.qnty)  then do :
     8757               f-artic = 'по ставке НДС ' .
     8758     if c-nn <>  ?  then do :
     8759       c-nn:screen-value = string('Итого') .
     8760       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8761           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8762           display STREAM OutStream    with frame top-frame .
     8763       End.
     8764     End.
     8765     if c-f-artic <>  ?  then do :
     8766       c-f-artic:screen-value = string(f-artic) .
     8767       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8768           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8769           display STREAM OutStream    with frame top-frame .
     8770       End.
     8771     End.
     8772     if c-f-gds-name <>  ?  then do :
     8773       c-f-gds-name:screen-value = string(var-client) .
     8774       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8775           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8776           display STREAM OutStream    with frame top-frame .
     8777       End.
     8778     End.
     8779     if c-f-qnty <>  ?  then do :
     8780       c-f-qnty:screen-value = string(accum TOTAL by gds-list.qnty f-qnty    ) .
     8781       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8782           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8783           display STREAM OutStream    with frame top-frame .
     8784       End.
     8785     End.
     8786     if c-f-cost-sum <>  ?  then do :
     8787       c-f-cost-sum:screen-value = string(accum TOTAL by gds-list.qnty f-cost-sum ) .
     8788       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8789           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8790           display STREAM OutStream    with frame top-frame .
     8791       End.
     8792     End.
     8793     if c-f-sale-sum <>  ?  then do :
     8794       c-f-sale-sum:screen-value = string(accum TOTAL  by gds-list.qnty  f-sale-sum) .
