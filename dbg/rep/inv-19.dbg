        1   block-level on error undo, throw.
        2   define input parameter parParentProc   as widget-handle no-undo.
        3   define input parameter p-trn-doc-recid as recid         no-undo.
        4   define input parameter p-mode          as character     no-undo.
        5   define stream out-stream .
        6   define shared var PrintScale   as logical                          no-undo.
        7   define shared var CostPrice    as logical                          no-undo.
        8   define shared var sort-name    as logical                          no-undo.
        9   define shared var sort-gr      as logical                          no-undo.
       10   define shared var print-graft  as logical                          no-undo.
       11   define shared var no-vat       as logical                          no-undo .
       12   define variable vss-revision    as character no-undo init "$Revision$":U .
       13   define variable vss-author      as character no-undo init "$Author$":U .
       14   define variable vss-date        as character no-undo init "$Date$":U .
       15   define variable vss-workfile    as character no-undo init "$Workfile$":U .
       16   define variable vss-archive     as character no-undo init "$Archive$":U .
       17   define variable vss-description as character no-undo init "Сличительная ведомость ИНВ-19".
       18   procedure vss-get-info :
       19     define output parameter p-vss-revision    like vss-revision    no-undo .
       20     define output parameter p-vss-author      like vss-author      no-undo .
       21     define output parameter p-vss-date        like vss-date        no-undo .
       22     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       23     define output parameter p-vss-archive     like vss-archive     no-undo .
       24     define output parameter p-vss-description like vss-description no-undo .
       25     assign
       26       p-vss-revision    = vss-revision
       27       p-vss-author      = vss-author
       28       p-vss-date        = vss-date
       29       p-vss-workfile    = vss-workfile
       30       p-vss-archive     = vss-archive
       31       p-vss-description = vss-description
       32     .
       33   end procedure.
       34   procedure vss-get-parameters :
       35     define output parameter p-vss-parameters as character no-undo .
       36   end procedure.
       37   define new global shared variable g#vssrevis-logger as handle    no-undo .
       38   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       39   define variable v-vssrevis-logger                   as handle    no-undo .
       40   procedure vss-logevent :
       41     define input  parameter p-extra-paramters as character no-undo .
       42     define variable v-vssrevis-parameters as character no-undo .
       43     do
       44     on error undo, return error return-value
       45     :
       46       if  valid-handle(v-vssrevis-logger)
       47       and v-vssrevis-logger :get-signature("logevent") <> ""
       48       then do:
       49         run vss-get-parameters in this-procedure
       50           (output v-vssrevis-parameters
       51           ).
       52         run logevent in v-vssrevis-logger
       53           (input vss-workfile
       54           ,input vss-revision
       55           ,input v-vssrevis-parameters
       56           ,input p-extra-paramters
       57           ).
       58       end.
       59     end.
       60   end procedure.
       61   assign
       62     v-vssrevis-logger = g#vssrevis-logger
       63   .
       64   if  valid-handle(v-vssrevis-logger)
       65   and v-vssrevis-logger :get-signature("logevent") <> ""
       66   then do:
       67     assign
       68       v-vssrevis-logevent = true
       69     .
       70     run vss-logevent in this-procedure (input vss-description) .
       71   end.
       72   define variable g#report-num as integer   no-undo .
       73   define variable g#quest-print as logical   no-undo .
       74   define variable g#log as logical   no-undo .
       75   define new global shared variable g#language as character no-undo .
       76   if g#language <> '' and g#language <> 'rus':U then do:
       77     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       78   end.
       79   define new global shared variable g#library  as handle no-undo .
       80   define new global shared variable g#library2 as handle no-undo .
       81   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       82   define new global shared variable g#trdcalib as handle no-undo.
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       85   define  shared variable RepPathName        as character no-undo .
       86   define  shared variable PrintRubl          as logical   no-undo .
       87   define variable vss-include-info2 as character format "X(65)" no-undo
       88   initial "@(#)$Workfile$ $Revision$".
       89   define temp-table temp_p-fmt_string-part no-undo
       90       field str-key       as integer
       91       field string-part   as character
       92       index pi is primary unique
       93           str-key
       94   .
       95   define variable v-p-fmt-2-str-key    as integer      no-undo.
       96   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
       97                                     iInput AS INTEGER).
       98     def var v-start-print as integer no-undo .
       99     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
      100     assign
      101       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
      102     .
      103     RETURN v-start-print .
      104   END FUNCTION.
      105   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
      106                                     iInput AS INTEGER).
      107     def var v-start-print as integer no-undo .
      108     assign
      109       v-start-print = INTEGER(iEndPix - 1 - iInput)
      110     .
      111     if v-start-print < 0 then return 0.
      112     RETURN v-start-print .
      113   END FUNCTION.
      114   function p-fmt-align-string returns character (
      115         p-in-string      as character
      116       , p-page-width     as integer
      117       , p-align-type     as character
      118   ).
      119       define variable v-string-length     as integer      no-undo.
      120       define variable v-out-string        as character    no-undo.
      121       assign
      122           v-string-length = length( trim( p-in-string ) )
      123       .
      124       if v-string-length >= p-page-width
      125       then do:
      126           assign
      127               v-out-string = trim( p-in-string )
      128           .
      129       end.
      130       else do:
      131           case p-align-type
      132           :
      133               when 'left':U
      134               then do:
      135                   assign
      136                       v-out-string = trim( p-in-string )
      137                   .
      138               end.
      139               when 'right':U
      140               then do:
      141                   assign
      142                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
      143                   .
      144               end.
      145               when 'center':U
      146               then do:
      147                   assign
      148                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
      149                   .
      150               end.
      151           end case.
      152       end.
      153       return v-out-string .
      154   end function.
      155   procedure p-fmt-split-string :
      156   define input parameter p-source-string  as character        no-undo.
      157   define input parameter p-split-length   as integer          no-undo.
      158   define output parameter p-string-1      as character        no-undo.
      159   define output parameter p-string-2      as character        no-undo.
      160   do
      161   on error undo, return error
      162   :
      163       define variable v-space-pos    as integer      no-undo.
      164       if length( p-source-string ) <= p-split-length
      165       then do:
      166           assign
      167               p-string-1 = p-source-string
      168           .
      169       end.
      170       else do:
      171           assign
      172               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
      173           .
      174           if v-space-pos = 0
      175           then do:
      176               assign
      177                   v-space-pos = index( p-source-string, " ":U )
      178               .
      179           end.
      180           if v-space-pos = 0
      181           then do:
      182               assign
      183                   p-string-1 = substring( p-source-string, 1, p-split-length )
      184                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
      185               .
      186           end.
      187           else do:
      188               assign
      189                   p-string-1 = substring( p-source-string, 1, v-space-pos )
      190                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
      191               .
      192           end.
      193       end.
      194   end.
      195   end procedure.
      196   procedure p-fmt-round :
      197   define input parameter p-qnty               as decimal          no-undo.
      198   define input parameter p-price-no-VAT       as decimal          no-undo.
      199   define input parameter p-VAT                as decimal          no-undo.
      200   define input parameter p-SLT                as decimal          no-undo.
      201   define input parameter p-road-tax           as decimal          no-undo.
      202   define output parameter p-new-price-no-VAT  as decimal          no-undo.
      203   define output parameter p-new-VAT           as decimal          no-undo.
      204   define output parameter p-new-SLT           as decimal          no-undo.
      205   define output parameter p-new-sum-VAT       as decimal          no-undo.
      206   define output parameter p-new-sum-SLT       as decimal          no-undo.
      207   define output parameter p-new-sum-road-tax  as decimal          no-undo.
      208   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
      209   define output parameter p-new-sum-full      as decimal          no-undo.
      210       define variable v-vat-pc    as decimal      no-undo.
      211       define variable v-slt-pc    as decimal      no-undo.
      212   do
      213   on error undo, return error
      214   :
      215       if p-price-no-VAT = 0
      216       then do:
      217           assign
      218               p-new-price-no-VAT = 0.0
      219               p-new-VAT          = ?
      220               p-new-SLT          = ?
      221               p-new-sum-VAT      = 0.0
      222               p-new-sum-SLT      = 0.0
      223               p-new-sum-no-VAT   = 0.0
      224               p-new-sum-road-tax = 0.0
      225               p-new-sum-full     = 0.0
      226           .
      227       end.
      228       else do:
      229           assign
      230               v-vat-pc            = p-VAT / p-price-no-VAT
      231               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
      232               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
      233               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
      234               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
      235               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
      236               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
      237               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
      238               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
      239               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
      240           .
      241       end.
      242   end.
      243   end procedure.
      244   procedure p-fmt-split :
      245   define input parameter p-in-string      as character        no-undo.
      246   define input parameter p-split-length   as integer          no-undo.
      247       define variable v-start-pos     as integer      no-undo.
      248       define variable v-end-pos       as integer      no-undo.
      249       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
      250   do
      251   for buf_temp_p-fmt_string-part
      252   on error undo, return error
      253   :
      254       empty temp-table buf_temp_p-fmt_string-part.
      255       if p-split-length < 1
      256       then do:
      257           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
      258       end.
      259       assign
      260           p-in-string                 = trim( p-in-string )
      261           v-p-fmt-2-str-key   = 0
      262           v-start-pos                 = 1
      263           v-end-pos                   = length( p-in-string )
      264       .
      265       run p-fmt-get-string-range in this-procedure (
      266             input p-in-string
      267           , input p-split-length
      268           , input v-start-pos
      269           , output v-start-pos
      270           , output v-end-pos
      271       ).
      272       do while v-end-pos <> 0
      273       :
      274           create buf_temp_p-fmt_string-part.
      275           assign
      276               v-p-fmt-2-str-key = v-p-fmt-2-str-key + 1
      277           .
      278           assign
      279               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-2-str-key
      280               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
      281           .
      282           assign
      283               v-start-pos = v-end-pos + 1
      284           .
      285           run p-fmt-get-string-range in this-procedure (
      286                 input p-in-string
      287               , input p-split-length
      288               , input v-start-pos
      289               , output v-start-pos
      290               , output v-end-pos
      291           ).
      292       end.
      293   end.
      294   end procedure.
      295   procedure p-fmt-get-string-range :
      296   define input parameter p-in-string      as character        no-undo.
      297   define input parameter p-split-length   as integer          no-undo.
      298   define input parameter p-old-start-pos  as integer          no-undo.
      299   define output parameter p-start-pos     as integer          no-undo.
      300   define output parameter p-end-pos       as integer          no-undo.
      301       define variable v-init-string    as character    no-undo.
      302       define variable v-temp-char      as character    no-undo.
      303       define variable v-temp-pos       as integer      no-undo.
      304       define variable v-counter        as integer      no-undo.
      305   do
      306   on error undo, return error
      307   :
      308       assign
      309           p-start-pos   = p-old-start-pos
      310           v-init-string = substring( p-in-string, p-start-pos )
      311       no-error.
      312       if error-status :error
      313       or trim( v-init-string ) = "":U
      314       then do:
      315           assign
      316               p-end-pos = 0
      317           .
      318           undo, return .
      319       end.
      320       assign
      321           v-temp-char   = substring( v-init-string, 1, 1 )
      322       .
      323       do
      324       while trim( v-temp-char ) = "":U
      325       :
      326           assign
      327               p-start-pos     = p-start-pos + 1
      328               v-init-string   = substring( p-in-string, p-start-pos )
      329               v-temp-char     = substring( v-init-string, 1, 1 )
      330           .
      331       end.
      332       assign
      333           v-temp-pos  = p-split-length
      334           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      335           v-counter   = 0
      336       .
      337       search-word-end:
      338       do
      339       while trim( v-temp-char ) <> "":U
      340       :
      341           assign
      342               v-counter   = v-counter + 1
      343           .
      344           if v-counter > 20
      345           then do:
      346               assign
      347                   v-temp-pos  = p-split-length
      348               .
      349               leave search-word-end.
      350           end.
      351           assign
      352               v-temp-pos  = v-temp-pos - 1
      353               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
      354           .
      355       end.
      356       assign
      357           p-end-pos = p-start-pos + v-temp-pos - 1
      358       .
      359   end.
      360   end procedure.
      361   define variable vss-include-info3 as character format "X(65)" no-undo
      362   initial "@(#)$Workfile$ $Revision$".
      363   define variable v-fmtcli-name          as character    no-undo.
      364   define variable v-fmtcli-engl-name     as character    no-undo.
      365   define variable v-fmtcli-addres        as character    no-undo.
      366   define variable v-fmtcli-post-addres   as character    no-undo.
      367   define variable v-fmtcli-full-addres   as character    no-undo.
      368   define variable v-fmtcli-phone         as character    no-undo.
      369   define variable v-fmtcli-inn           as character    no-undo.
      370   define variable v-fmtcli-kpp           as character    no-undo.
      371   define variable v-fmtcli-okpo          as character    no-undo.
      372   define variable v-fmtcli-country       as character    no-undo.
      373   define variable v-fmtcli-city          as character    no-undo.
      374   define variable v-fmtcli-index         as character    no-undo.
      375   define variable v-fmtcli-schet-exists  as logical      no-undo.
      376   define variable v-fmtcli-bank-exists   as logical      no-undo.
      377   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      378   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      379   define variable v-fmtcli-bank-bik      as character    no-undo.
      380   define variable v-fmtcli-bank-name     as character    no-undo.
      381   define variable v-fmtcli-bank-addres   as character    no-undo.
      382   define variable v-fmtcli-bank-city     as character    no-undo.
      383   procedure fmtcli-get-bank :
      384   define input parameter p-host-code      as integer          no-undo.
      385   define input parameter p-obj-type       as character        no-undo.
      386   define input parameter p-obj-code       as integer          no-undo.
      387   define input parameter p-curr-code      as integer          no-undo.
      388       define buffer buf_fin-schet     for ub.fin-schet.
      389       define buffer buf_fin-bank      for ub.fin-bank.
      390   do
      391   for buf_fin-schet
      392     , buf_fin-bank
      393   on error undo, return error
      394   :
      395       assign
      396           v-fmtcli-schet-exists       = no
      397           v-fmtcli-bank-exists        = no
      398           v-fmtcli-bank-r-schet       = "":U
      399           v-fmtcli-bank-c-schet       = "":U
      400           v-fmtcli-bank-bik           = "":U
      401           v-fmtcli-bank-name          = "":U
      402           v-fmtcli-bank-addres        = "":U
      403           v-fmtcli-bank-city          = "":U
      404       .
      405       search-for-schet:
      406       for each buf_fin-schet no-lock
      407          where buf_fin-schet.host-code = p-host-code
      408            and buf_fin-schet.cli-type  = p-obj-type
      409            and buf_fin-schet.cli-code  = p-obj-code
      410            and buf_fin-schet.curr-code = p-curr-code
      411       on error undo, return error
      412       :
      413           if buf_fin-schet.status_   = 'удал':U
      414           then do:
      415           end.
      416           else do:
      417               assign
      418                   v-fmtcli-schet-exists   = yes
      419                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      420                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      421               .
      422               find first buf_fin-bank no-lock
      423                    where buf_fin-bank.host-code = p-host-code
      424                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      425               no-error.
      426               if available buf_fin-bank
      427               then do:
      428                   assign
      429                       v-fmtcli-bank-exists      = yes
      430                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      431                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      432                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      433                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      434                   .
      435               end.
      436               else do:
      437                   assign
      438                       v-fmtcli-bank-exists    = no
      439                       v-fmtcli-bank-bik       = "":U
      440                       v-fmtcli-bank-name      = "":U
      441                       v-fmtcli-bank-addres    = "":U
      442                       v-fmtcli-bank-city      = "":U
      443                   .
      444               end.
      445               leave search-for-schet.
      446           end.
      447       end.
      448   end.
      449   end procedure.
      450   procedure fmtcli-get-client :
      451   define input parameter p-obj-type       as character    no-undo.
      452   define input parameter p-obj-code       as integer      no-undo.
      453       define variable v-temp-fmtcli-address      as character     no-undo.
      454       define variable v-num-country-city    as integer      no-undo.
      455       define buffer buf_clients   for ub.clients.
      456       define buffer buf_firm      for ub.firm.
      457       define buffer buf_store     for ub.store.
      458       define buffer buf_shop      for ub.shop.
      459       define buffer buf_person    for ub.person.
      460   do
      461   for buf_clients
      462     , buf_firm
      463     , buf_store
      464     , buf_shop
      465     , buf_person
      466   on error undo, return error
      467   :
      468       assign
      469           v-fmtcli-name           = "":U
      470           v-fmtcli-addres         = "":U
      471           v-fmtcli-post-addres    = "":U
      472           v-fmtcli-full-addres    = "":U
      473           v-fmtcli-phone          = "":U
      474           v-fmtcli-inn            = "":U
      475           v-fmtcli-kpp            = "":U
      476           v-fmtcli-okpo           = "":U
      477           v-fmtcli-city           = "":U
      478           v-fmtcli-index          = "":U
      479           v-fmtcli-country        = "":U
      480       .
      481       find first buf_clients no-lock
      482            where buf_clients.obj-type = p-obj-type
      483              and buf_clients.obj-code = p-obj-code
      484       .
      485       assign
      486           v-fmtcli-name = buf_clients.obj-name
      487       .
      488       case buf_clients.obj-type:
      489          when 'орг':U
      490          then do:
      491               find first buf_firm no-lock
      492                    where buf_firm.firm-code = buf_clients.obj-code
      493                    no-error
      494               .
      495               if available buf_firm
      496               then do:
      497                   assign
      498                       v-num-country-city = num-entries( buf_firm.city )
      499                       v-fmtcli-engl-name = buf_firm.engl-name
      500                   .
      501                   if v-num-country-city > 0
      502                   then do:
      503                       assign
      504                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      505                       .
      506                   end.
      507                   if v-num-country-city > 1
      508                   then do:
      509                       assign
      510                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      511                       .
      512                   end.
      513                   run fmtcli-concatenate-strings in this-procedure (
      514                         input v-fmtcli-full-addres
      515                       , input v-fmtcli-country
      516                       , input ", ":U
      517                       , input 50
      518                       , output v-fmtcli-full-addres
      519                   ).
      520                   run fmtcli-concatenate-strings in this-procedure (
      521                         input v-fmtcli-full-addres
      522                       , input v-fmtcli-city
      523                       , input ", ":U
      524                       , input 50
      525                       , output v-fmtcli-full-addres
      526                   ).
      527                   run fmtcli-concatenate-strings in this-procedure (
      528                         input v-fmtcli-full-addres
      529                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      530                       , input ", ":U
      531                       , input 50
      532                       , output v-fmtcli-full-addres
      533                   ).
      534                   run fmtcli-concatenate-strings in this-procedure (
      535                         input v-fmtcli-post-addres
      536                       , input v-fmtcli-country
      537                       , input ", ":U
      538                       , input 50
      539                       , output v-fmtcli-post-addres
      540                   ).
      541                   run fmtcli-concatenate-strings in this-procedure (
      542                         input v-fmtcli-post-addres
      543                       , input v-fmtcli-city
      544                       , input ", ":U
      545                       , input 50
      546                       , output v-fmtcli-post-addres
      547                   ).
      548                   run fmtcli-concatenate-strings in this-procedure (
      549                         input v-fmtcli-post-addres
      550                       , input string( buf_firm.ind )
      551                       , input ", ":U
      552                       , input 50
      553                       , output v-fmtcli-post-addres
      554                   ).
      555                   run fmtcli-concatenate-strings in this-procedure (
      556                         input substring( buf_firm.addres1, 1, 50 )
      557                       , input buf_firm.addres2
      558                       , input " ":U
      559                       , input 50
      560                       , output v-temp-fmtcli-address
      561                   ).
      562                   run fmtcli-concatenate-strings in this-procedure (
      563                         input v-temp-fmtcli-address
      564                       , input substring( buf_firm.addres1, 51, 50 )
      565                       , input " ":U
      566                       , input 50
      567                       , output v-temp-fmtcli-address
      568                   ).
      569                   run fmtcli-concatenate-strings in this-procedure (
      570                         input v-temp-fmtcli-address
      571                       , input substring( buf_firm.addres1, 101, 50 )
      572                       , input " ":U
      573                       , input 50
      574                       , output v-temp-fmtcli-address
      575                   ).
      576                   assign
      577                       v-fmtcli-addres = v-temp-fmtcli-address
      578                   .
      579                   if buf_firm.addres1 <> ?
      580                   then do:
      581                       run fmtcli-concatenate-strings in this-procedure (
      582                             input v-fmtcli-full-addres
      583                           , input v-fmtcli-addres
      584                           , input ", ":U
      585                           , input 0
      586                           , output v-fmtcli-full-addres
      587                       ).
      588                   end.
      589                   run fmtcli-concatenate-strings in this-procedure (
      590                         input substring( buf_firm.post-addr1, 1, 50 )
      591                       , input buf_firm.post-addr2
      592                       , input " ":U
      593                       , input 50
      594                       , output v-fmtcli-post-addres
      595                   ).
      596                   run fmtcli-concatenate-strings in this-procedure (
      597                         input v-fmtcli-post-addres
      598                       , input substring( buf_firm.post-addr1, 51, 50 )
      599                       , input " ":U
      600                       , input 50
      601                       , output v-fmtcli-post-addres
      602                   ).
      603                   run fmtcli-concatenate-strings in this-procedure (
      604                         input v-fmtcli-post-addres
      605                       , input substring( buf_firm.post-addr1, 101, 50 )
      606                       , input " ":U
      607                       , input 50
      608                       , output v-fmtcli-post-addres
      609                   ).
      610                   assign
      611                       v-fmtcli-phone         = buf_firm.phone
      612                       v-fmtcli-inn           = buf_firm.inn
      613                       v-fmtcli-kpp           = buf_firm.kpp
      614                       v-fmtcli-okpo          = buf_firm.okpo
      615                       v-fmtcli-index         = string( buf_firm.ind )
      616                   .
      617               end.
      618          end.
      619          when 'маг':U
      620          then do:
      621               find first buf_shop no-lock
      622                    where buf_shop.obj-code = buf_clients.obj-code
      623               .
      624               if available buf_shop
      625               then do:
      626                   run fmtcli-concatenate-strings in this-procedure (
      627                         input buf_shop.addres1
      628                       , input buf_shop.addres2
      629                       , input " ":U
      630                       , input 50
      631                       , output v-fmtcli-addres
      632                   ).
      633                   assign
      634                       v-fmtcli-full-addres = v-fmtcli-addres
      635                       v-fmtcli-post-addres = v-fmtcli-addres
      636                       v-fmtcli-phone       = buf_shop.phone
      637                       v-fmtcli-inn         = "":U
      638                       v-fmtcli-kpp         = "":U
      639                       v-fmtcli-okpo        = "":U
      640                       v-fmtcli-city        = "":U
      641                       v-fmtcli-index       = "":U
      642                   .
      643               end.
      644          end.
      645          when 'скл':U
      646          then do:
      647               find first buf_store no-lock
      648                    where buf_store.obj-code = buf_clients.obj-code
      649               .
      650               if available buf_store
      651               then do:
      652                   run fmtcli-concatenate-strings in this-procedure (
      653                         input buf_store.addres1
      654                       , input buf_store.addres2
      655                       , input " ":U
      656                       , input 50
      657                       , output v-fmtcli-addres
      658                   ).
      659                   assign
      660                       v-fmtcli-full-addres = v-fmtcli-addres
      661                       v-fmtcli-phone       = buf_store.phone
      662                       v-fmtcli-inn         = "":U
      663                       v-fmtcli-kpp         = "":U
      664                       v-fmtcli-okpo        = "":U
      665                       v-fmtcli-city        = "":U
      666                       v-fmtcli-index       = "":U
      667                   .
      668               end.
      669          end.
      670          when 'чел':U
      671          then do:
      672               find first buf_person no-lock
      673                    where buf_person.psn-code = buf_clients.obj-code
      674               .
      675               if available buf_person
      676               then do:
      677                   run fmtcli-concatenate-strings in this-procedure (
      678                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      679                                 then "":U
      680                                 else string( buf_person.ind, "999999")
      681                                 )
      682                       , input buf_person.city
      683                       , input ", ":U
      684                       , input 0
      685                       , output v-fmtcli-full-addres
      686                   ).
      687                   assign
      688                       v-fmtcli-addres = buf_person.address
      689                   .
      690                   run fmtcli-concatenate-strings in this-procedure (
      691                         input v-fmtcli-full-addres
      692                       , input v-fmtcli-addres
      693                       , input ", ":U
      694                       , input 0
      695                       , output v-fmtcli-full-addres
      696                   ).
      697                   assign
      698                       v-fmtcli-phone     = buf_person.phone1
      699                       v-fmtcli-inn       = buf_person.inn
      700                       v-fmtcli-kpp       = buf_person.kpp
      701                       v-fmtcli-okpo      = buf_person.okpo
      702                       v-fmtcli-city      = buf_person.city
      703                       v-fmtcli-index     = string( buf_person.ind )
      704                   .
      705               end.
      706          end.
      707       end case.
      708   end.
      709   end procedure.
      710   procedure fmtcli-concatenate-strings :
      711   define input parameter p-string-1       as character        no-undo.
      712   define input parameter p-string-2       as character        no-undo.
      713   define input parameter p-delimiter      as character        no-undo.
      714   define input parameter p-length         as integer          no-undo.
      715   define output parameter p-out-string    as character        no-undo.
      716   do
      717   on error undo, return error
      718   :
      719       assign
      720           p-out-string = ( if p-string-1 = ?
      721                            then "":U
      722                            else trim( p-string-1 ) )
      723       .
      724       assign
      725           p-out-string = p-out-string
      726                        + ( if p-out-string = "":U
      727                            or length( p-out-string ) = p-length
      728                            or p-string-2 = ?
      729                            or trim( p-string-2 ) = "":U
      730                            then "":U
      731                            else p-delimiter )
      732                        + ( if p-string-2 = ?
      733                            or trim( p-string-2 ) = "":U
      734                            then "":U
      735                            else trim( p-string-2 ) )
      736       .
      737   end.
      738   end procedure.
