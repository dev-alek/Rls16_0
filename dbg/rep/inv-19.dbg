     4016             chr(9)   string( buf_temp_sheet1_line-data.utochNedSum  )
     4017             chr(9)   string( buf_temp_sheet1_line-data.peresIzlQnty )
     4018             chr(9)   string( buf_temp_sheet1_line-data.peresIzlSum  )
     4019             chr(9)   string( buf_temp_sheet1_line-data.peresNedQnty )
     4020             chr(9)   string( buf_temp_sheet1_line-data.peresNedSum  )
     4021             chr(9)   string( buf_temp_sheet1_line-data.endIzlQnty   )
     4022             chr(9)   string( buf_temp_sheet1_line-data.endIzlSum    )
     4023             chr(9)   string( buf_temp_sheet1_line-data.endNedQnty1  )
     4024             chr(9)   string( buf_temp_sheet1_line-data.endNedSum1   )
     4025             chr(9)   string( buf_temp_sheet1_line-data.endNedQnty2  )
     4026             chr(9)   string( buf_temp_sheet1_line-data.endNedSum2   )
     4027             chr(9)   string( buf_temp_sheet1_line-data.endNedQnty3  )
     4028             chr(9)   string( buf_temp_sheet1_line-data.endNedSum3   )
     4029             chr(10)
     4030         .
     4031       else
     4032       put stream excel-line unformatted
     4033                           buf_temp_sheet1_line-data.sheet-name
     4034           chr(9)   "DTA":U
     4035           chr(9)   string( buf_temp_sheet1_line-data.num          )
     4036           chr(9)   string( buf_temp_sheet1_line-data.gdsname      )
     4037           chr(9)   string( buf_temp_sheet1_line-data.gdscode      )
     4038           chr(9)   string( buf_temp_sheet1_line-data.OKEI         )
     4039           chr(9)   string( buf_temp_sheet1_line-data.EI           )
     4040           chr(9)   string( buf_temp_sheet1_line-data.rezIzlQnty   )
     4041           chr(9)   string( buf_temp_sheet1_line-data.rezIzlSum    )
     4042           chr(9)   string( buf_temp_sheet1_line-data.rezNedQnty   )
     4043           chr(9)   string( buf_temp_sheet1_line-data.rezNedSum    )
     4044           chr(9)   string( buf_temp_sheet1_line-data.num2         )
     4045           chr(9)   string( buf_temp_sheet1_line-data.utochIzlQnty )
     4046           chr(9)   string( buf_temp_sheet1_line-data.utochIzlSum  )
     4047           chr(9)   string( buf_temp_sheet1_line-data.utochNedQnty )
     4048           chr(9)   string( buf_temp_sheet1_line-data.utochNedSum  )
     4049           chr(9)   string( buf_temp_sheet1_line-data.peresIzlQnty )
     4050           chr(9)   string( buf_temp_sheet1_line-data.peresIzlSum  )
     4051           chr(9)   string( buf_temp_sheet1_line-data.peresNedQnty )
     4052           chr(9)   string( buf_temp_sheet1_line-data.peresNedSum  )
     4053           chr(9)   string( buf_temp_sheet1_line-data.endIzlQnty   )
     4054           chr(9)   string( buf_temp_sheet1_line-data.endIzlSum    )
     4055           chr(9)   string( buf_temp_sheet1_line-data.endNedQnty1  )
     4056           chr(9)   string( buf_temp_sheet1_line-data.endNedSum1   )
     4057           chr(9)   string( buf_temp_sheet1_line-data.endNedQnty2  )
     4058           chr(9)   string( buf_temp_sheet1_line-data.endNedSum2   )
     4059           chr(9)   string( buf_temp_sheet1_line-data.endNedQnty3  )
     4060           chr(9)   string( buf_temp_sheet1_line-data.endNedSum3   )
     4061           chr(10)
     4062       .
     4063   end.
     4064   end procedure.
     4065   procedure inv19xl-write-cell-data :
     4066   define input parameter p-data-key   as character        no-undo.
     4067   define input parameter p-data-value as character        no-undo.
     4068       define buffer buf_temp_cell-data     for temp_cell-data.
     4069   do
     4070   for buf_temp_cell-data
     4071   on error undo, return error
     4072   :
     4073       find first buf_temp_cell-data
     4074            where buf_temp_cell-data.data-key = p-data-key
     4075       no-error.
     4076       if not available buf_temp_cell-data
     4077       then do:
     4078           create buf_temp_cell-data.
     4079           assign
     4080               buf_temp_cell-data.data-key = p-data-key
     4081           .
     4082       end.
     4083       assign
     4084           buf_temp_cell-data.data-value = p-data-value
     4085       .
     4086       put stream excel-cell unformatted
     4087                           buf_temp_cell-data.data-key
     4088           chr(9)   buf_temp_cell-data.data-value
     4089           chr(10)
     4090       .
     4091   end.
     4092   end procedure.
     4093   procedure inv19xl-run-excel :
     4094   define input parameter p-header-filename    as character        no-undo.
     4095   define input parameter p-data-filename      as character        no-undo.
     4096       define variable v-template-file-name    as character    no-undo.
     4097       define variable v-vb-file-name          as character    no-undo.
     4098       define buffer buf_temp-param for temp-param .
     4099   do
     4100   for buf_temp-param
     4101   on error undo, return error
     4102   :
     4103       create buf_temp-param.
     4104       assign
     4105           v-template-file-name    = search( "exe/inv19.xlt" )
     4106           v-vb-file-name          = search( "exe/t_form.bas")
     4107       .
     4108       if v-template-file-name = ?
     4109       or v-template-file-name = "":U
     4110       then do:
     4111           message
     4112               "Ошибка имени файла шаблона."
     4113           view-as alert-box error.
     4114       end.
     4115       if v-vb-file-name = ?
     4116       or v-vb-file-name = "":U
     4117       then do:
     4118           message
     4119               "Ошибка имени файла кода обработки."
     4120           view-as alert-box error.
     4121       end.
     4122       run paramls-write in this-procedure (
     4123             input "template":U
     4124           , input "template-file-name":U
     4125           , input v-template-file-name
     4126       ).
     4127       run paramls-write in this-procedure (
     4128             input "template":U
     4129           , input "vb-file-name":U
     4130           , input v-vb-file-name
     4131       ).
     4132       run paramls-write in this-procedure (
     4133             input "data":U
     4134           , input "data-header-filename":U
     4135           , input p-header-filename
     4136       ).
     4137       run paramls-write in this-procedure (
     4138             input "data":U
     4139           , input "data-filename":U
     4140           , input p-data-filename
     4141       ).
     4142       run gbl/macroxlt.p (
     4143           input-output table buf_temp-param
     4144       ) no-error.
     4145       if error-status :error
     4146       then do:
     4147           message
     4148                    vss-workfile vss-revision vss-description
     4149               skip(1)
     4150               skip "Ошибка создания файла Excel."
     4151               skip return-value
     4152               skip trim(error-status :get-message(1))
     4153                    trim(error-status :get-message(2))
     4154                    trim(error-status :get-message(3))
     4155           view-as alert-box error.
     4156           undo, return error .
     4157       end.
     4158   end.
     4159   end procedure.
     4160   procedure inv19xl-close :
     4161   do
     4162   on error undo, return error
     4163   :
     4164       output stream excel-line close.
     4165       output stream excel-cell close.
     4166       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4167       if p-mode = "OKDP"
     4168       then
     4169           export "exe/inv19_okdp.xlt":U.
     4170       else
     4171           export "exe/inv19.xlt":U.
     4172           export "exe/t_form.bas":U.
     4173           export v-inv19xl-cell-file-name.
     4174           export v-inv19xl-data-file-name.
     4175       output close.
     4176   end.
     4177   end procedure.
     4178       define variable v-host-code                 as integer                  no-undo.
     4179       define variable v-curr-code                 as integer                  no-undo.
     4180       define variable v-inv19-line-counter        as integer      no-undo.
     4181       define variable v-izl-sum           as decimal      no-undo.
     4182       define variable v-ned-sum           as decimal      no-undo.
     4183       define variable v-per-izl-sum       as decimal      no-undo.
     4184       define variable v-per-ned-sum       as decimal      no-undo.
     4185       define variable v-izl-qnty          as decimal      no-undo.
     4186       define variable v-ned-qnty          as decimal      no-undo.
     4187       define variable v-per-izl-qnty      as decimal      no-undo.
     4188       define variable v-per-ned-qnty      as decimal      no-undo.
     4189       define variable v-tot-izl-sum       as decimal      no-undo.
     4190       define variable v-tot-ned-sum       as decimal      no-undo.
     4191       define variable v-tot-per-izl-sum   as decimal      no-undo.
     4192       define variable v-tot-per-ned-sum   as decimal      no-undo.
     4193       define variable v-tot-izl-qnty      as decimal      no-undo.
     4194       define variable v-tot-ned-qnty      as decimal      no-undo.
     4195       define variable v-tot-per-izl-qnty  as decimal      no-undo.
     4196       define variable v-tot-per-ned-qnty  as decimal      no-undo.
     4197       define variable v-par-type          as character    no-undo.
     4198       define buffer buf_trn-doc       for ub.trn-doc.
     4199       define buffer buf_doc-line      for ub.doc-line.
     4200   do
     4201   for buf_trn-doc
     4202     , buf_doc-line
     4203   on error undo, return error
     4204   :
     4205   if session :set-wait-state( "compiler" ) then.
     4206   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     4207   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     4208     (output v-sys-key
     4209     ) no-error .
     4210      run get-report-num  in parParentProc ( output g#report-num ).
     4211      run get-quest-print in parParentProc ( output g#quest-print ).
     4212       find first buf_trn-doc no-lock
     4213            where recid( buf_trn-doc ) = p-trn-doc-recid
     4214       .
     4215       run check-doc-sum in this-procedure (
     4216           input buf_trn-doc.doc-code
     4217       ).
     4218   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4219   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     4220     (input  buf_trn-doc.obj-type
     4221     ,input  buf_trn-doc.obj-code
     4222     ,output v-host-code
     4223     )  .
     4224       if printRubl = yes
     4225       then do:
     4226           assign
     4227               v-curr-code = 0
     4228           .
     4229       end.
     4230       else do:
     4231   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4232   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     4233     (input  v-host-code
     4234     ,output v-curr-code
     4235     )  .
     4236       end.
     4237       run torgconf-read in this-procedure (
     4238             input "inv3"
     4239           , input v-host-code
     4240           , input buf_trn-doc.obj-type
     4241           , input buf_trn-doc.obj-code
     4242       ) no-error.
     4243       if error-status :error
     4244       then do:
     4245           message
     4246           vss-workfile vss-revision vss-description
     4247           skip "Ошибка чтения параметров печати формы."
     4248           skip "Форма будет напечатана с параметрами по умолчанию."
     4249           skip return-value
     4250           skip trim(error-status :get-message(1))
     4251               trim(error-status :get-message(2))
     4252               trim(error-status :get-message(3))
     4253           view-as alert-box error.
     4254       end.
     4255       run torgconf-get-self-param in this-procedure (
     4256             input buf_trn-doc.obj-type
     4257           , input buf_trn-doc.obj-code
     4258           , input v-curr-code
     4259       ) no-error.
     4260       if error-status :error
     4261       then do:
     4262           message
     4263           vss-workfile vss-revision vss-description
     4264           skip "Ошибка чтения параметров объекта документа."
     4265           skip return-value
     4266           skip trim(error-status :get-message(1))
     4267               trim(error-status :get-message(2))
     4268               trim(error-status :get-message(3))
     4269           view-as alert-box warning.
     4270       end.
     4271   output stream out-stream to value( string( session:temp-directory +
     4272                                        "rpt" + string( g#report-num ) ) )
     4273                                        page-size  value(43) .
     4274       run inv19xl-init in this-procedure .
     4275       define variable v-obj-str as character no-undo .
     4276       if lookup( 'L-Rus' , v-sys-key) > 0
     4277       then do:
     4278         assign
     4279           v-obj-str = substitute( "&1, &2"
     4280                                 , v-torgconf-self-obj-name
     4281                                 , v-torgconf-self-obj-addres
     4282                                 )
     4283         .
     4284       end.
     4285       else do:
     4286         assign
     4287           v-obj-str = v-torgconf-self-obj-name
     4288         .
     4289       end.
     4290       run inv19xl-write-cell-data in this-procedure ( input "organization":U  , input v-torgconf-self-host-name                             ).
     4291       run inv19xl-write-cell-data in this-procedure ( input "organization":U  , input v-torgconf-self-host-name                             ).
     4292       run inv19xl-write-cell-data in this-procedure ( input "object":U        , input v-obj-str                                             ).
     4293       if lookup( 'L-Rus' , v-sys-key) = 0
     4294       then do:
     4295         run inv19xl-write-cell-data in this-procedure ( input "docinvcode":U    , input buf_trn-doc.doc-code                                  ).
     4296         run inv19xl-write-cell-data in this-procedure ( input "docdate":U       , input string( buf_trn-doc.doc-date , "99/99/9999" )         ).
     4297         run inv19xl-write-cell-data in this-procedure ( input "startdate":U     , input string( buf_trn-doc.doc-date , "99/99/9999" )         ).
     4298         run inv19xl-write-cell-data in this-procedure ( input "enddate":U       , input string( buf_trn-doc.fact-date, "99/99/9999" )         ).
     4299       end.
     4300       run inv19xl-write-cell-data in this-procedure ( input "doccode":U       , input buf_trn-doc.doc-code                                  ).
     4301       run inv19xl-write-cell-data in this-procedure ( input "factdate":U      , input string( buf_trn-doc.fact-date, "99/99/9999" )         ).
     4302       put stream out-stream unformatted
     4303             chr(10)
     4304           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     4305           + chr(10)
     4306       .
     4307       assign
     4308           v-tot-izl-sum      = 0.0
     4309           v-tot-ned-sum      = 0.0
     4310           v-tot-per-izl-sum  = 0.0
     4311           v-tot-per-ned-sum  = 0.0
     4312           v-tot-izl-qnty     = 0.0
     4313           v-tot-ned-qnty     = 0.0
     4314           v-tot-per-izl-qnty = 0.0
     4315           v-tot-per-ned-qnty = 0.0
     4316       .
     4317       for each buf_doc-line no-lock
     4318          where buf_doc-line.doc-code = buf_trn-doc.doc-code
     4319       on error undo, return error
     4320       :
     4321           run print-line in this-procedure (
     4322                 input buf_doc-line.doc-code
     4323               , input buf_doc-line.artic
     4324               , input buf_doc-line.prod-type
     4325               , input buf_doc-line.prod-code
     4326               , output v-izl-sum
     4327               , output v-ned-sum
     4328               , output v-per-izl-sum
     4329               , output v-per-ned-sum
     4330               , output v-izl-qnty
     4331               , output v-ned-qnty
     4332               , output v-per-izl-qnty
     4333               , output v-per-ned-qnty
     4334           ).
     4335           assign
     4336               v-tot-izl-sum      = v-tot-izl-sum      + v-izl-sum
     4337               v-tot-ned-sum      = v-tot-ned-sum      + v-ned-sum
     4338               v-tot-per-izl-sum  = v-tot-per-izl-sum  + v-per-izl-sum
     4339               v-tot-per-ned-sum  = v-tot-per-ned-sum  + v-per-ned-sum
     4340               v-tot-izl-qnty     = v-tot-izl-qnty     + v-izl-qnty
     4341               v-tot-ned-qnty     = v-tot-ned-qnty     + v-ned-qnty
     4342               v-tot-per-izl-qnty = v-tot-per-izl-qnty + v-per-izl-qnty
     4343               v-tot-per-ned-qnty = v-tot-per-ned-qnty + v-per-ned-qnty
     4344           .
     4345       end.
     4346       run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_rezIzlSum":U    , input string( v-tot-izl-sum  ) ).
     4347       run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_rezNedSum":U    , input string( v-tot-ned-sum  ) ).
     4348       run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_rezIzlQnty":U   , input string( v-tot-izl-Qnty ) ).
     4349       run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_rezNedQnty":U   , input string( v-tot-ned-Qnty ) ).
     4350       if lookup( 'L-Rus' , v-sys-key) > 0
     4351       then do:
     4352         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_utochIzlSum":U  , input string( 0                  ) ).
     4353         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_utochNedSum":U  , input string( 0                  ) ).
     4354         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_peresIzlSum":U  , input string( v-tot-per-izl-sum  ) ).
     4355         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_peresNedSum":U  , input string( v-tot-per-ned-sum  ) ).
     4356         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endIzlSum":U    , input string( v-tot-izl-sum      ) ).
     4357         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedSum1":U   , input string( v-tot-ned-sum      ) ).
     4358         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedSum2":U   , input string( 0                  ) ).
     4359         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedSum3":U   , input string( 0                  ) ).
     4360         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_utochIzlQnty":U , input string( 0                  ) ).
     4361         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_utochNedQnty":U , input string( 0                  ) ).
     4362         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_peresIzlQnty":U , input string( v-tot-per-izl-Qnty ) ).
     4363         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_peresNedQnty":U , input string( v-tot-per-ned-Qnty ) ).
     4364         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endIzlQnty":U   , input string( v-tot-izl-Qnty     ) ).
     4365         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedQnty1":U  , input string( v-tot-ned-Qnty     ) ).
     4366         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedQnty2":U  , input string( 0                  ) ).
     4367         run inv19xl-write-cell-data in this-procedure ( input "ИНВ19_it_endNedQnty3":U  , input string( 0                  ) ).
     4368       end.
     4369       run inv19xl-close in this-procedure .
     4370   if session :set-wait-state( "" ) then.
     4371       output stream out-stream close.
     4372   if g#quest-print = false
     4373   then do:
     4374     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     4375                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     4376                                         OUTPUT g#log ).
     4377   end.
     4378   else do:
     4379     os-command silent
     4380       value( "COPY /b " +
     4381         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     4382         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     4383         string( session:temp-directory) +  "$" + string( g#report-num )
     4384                 ) .
     4385     os-command silent
     4386       value( "COPY /b " +
     4387         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4388         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4389         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4390                 ) .
     4391   end.
     4392   end.
     4393   procedure print-line :
     4394   define input parameter p-doc-code       as character        no-undo.
     4395   define input parameter p-artic          as character        no-undo.
     4396   define input parameter p-prod-type      as character        no-undo.
     4397   define input parameter p-prod-code      as integer          no-undo.
     4398   define output parameter p-izl-sum       as decimal          no-undo.
     4399   define output parameter p-ned-sum       as decimal          no-undo.
     4400   define output parameter p-per-izl-sum   as decimal          no-undo.
     4401   define output parameter p-per-ned-sum   as decimal          no-undo.
     4402   define output parameter p-izl-qnty       as decimal          no-undo.
     4403   define output parameter p-ned-qnty       as decimal          no-undo.
     4404   define output parameter p-per-izl-qnty   as decimal          no-undo.
     4405   define output parameter p-per-ned-qnty   as decimal          no-undo.
     4406       define variable v-per-price         as decimal   no-undo.
     4407       define variable v-inv-peresort-qnty as decimal   no-undo.
     4408       define variable v-gds-name          as character no-undo .
     4409       define buffer buf_doc-line      for ub.doc-line.
     4410       define buffer buf_goods         for ub.goods.
     4411       define buffer buf_units         for ub.units.
     4412       define buffer buf_doc-line-sum  for ub.doc-line-sum.
     4413       define buffer buf_gds-dtl       for ub.gds-dtl.
     4414   do
     4415   for buf_doc-line
     4416     , buf_goods
     4417     , buf_units
     4418     , buf_doc-line-sum
     4419     , buf_gds-dtl
     4420   on error undo, return error
     4421   :
     4422       find first buf_doc-line no-lock
     4423            where buf_doc-line.doc-code   = p-doc-code
     4424              and buf_doc-line.artic      = p-artic
     4425              and buf_doc-line.prod-type  = p-prod-type
     4426              and buf_doc-line.prod-code  = p-prod-code
     4427       .
     4428       if buf_doc-line.fact-qnty = 0
     4429       then do:
     4430         return .
     4431       end.
     4432       assign
     4433           v-inv19-line-counter = v-inv19-line-counter + 1
     4434       .
     4435       find first buf_goods no-lock
     4436            where buf_goods.artic      = p-artic
     4437              and buf_goods.prod-type  = p-prod-type
     4438              and buf_goods.prod-code  = p-prod-code
     4439       .
     4440       find first buf_units no-lock
     4441            where buf_units.unit-name = buf_goods.unit-base
     4442       .
     4443       find first buf_doc-line-sum no-lock
     4444            where buf_doc-line-sum.doc-code = buf_doc-line.doc-code
     4445              and buf_doc-line-sum.gds-code = buf_goods.gds-code
     4446              and buf_doc-line-sum.sum-type = 'gen':U
     4447       no-error.
     4448       if available buf_doc-line-sum
     4449       then do:
     4450           if buf_doc-line-sum.fact-qnty >= 0
     4451           then do:
     4452               assign
     4453                   p-izl-qnty = buf_doc-line-sum.fact-qnty
     4454                   p-ned-qnty = 0.0
     4455               .
     4456               if costprice = yes
     4457               then do:
     4458                   if no-vat = no then do:
     4459                   if PrintRubl = yes
     4460                   then do:
     4461                       assign
     4462                           p-izl-sum  = buf_doc-line-sum.cost-sum-rubl
     4463                           p-ned-sum  = 0.0
     4464                       .
     4465                   end.
     4466                   else do:
     4467                       assign
     4468                           p-izl-sum  = buf_doc-line-sum.cost-sum-base
     4469                           p-ned-sum  = 0.0
     4470                       .
     4471                   end.
     4472                   end.
     4473                   else do:
     4474                   if PrintRubl = yes
     4475                   then do:
     4476                       assign
     4477                           p-izl-sum  = buf_doc-line-sum.cost-sum-rubl - buf_doc-line-sum.cost-VAT-rubl
     4478                           p-ned-sum  = 0.0
     4479                       .
     4480                   end.
     4481                   else do:
     4482                       assign
     4483                           p-izl-sum  = buf_doc-line-sum.cost-sum-base - buf_doc-line-sum.cost-VAT-base
     4484                           p-ned-sum  = 0.0
     4485                       .
     4486                   end.
     4487                   end.
     4488               end.
     4489               else do:
     4490                   if PrintRubl = yes
     4491                   then do:
     4492                       assign
     4493                           p-izl-sum  = buf_doc-line-sum.sale-sum-rubl
     4494                           p-ned-sum  = 0.0
     4495                       .
     4496                   end.
     4497                   else do:
     4498                       assign
     4499                           p-izl-sum  = buf_doc-line-sum.sale-sum-base
     4500                           p-ned-sum  = 0.0
     4501                       .
     4502                   end.
     4503               end.
     4504           end.
     4505           else do:
     4506               assign
     4507                   p-izl-qnty = 0.0
     4508                   p-ned-qnty = (-1) * buf_doc-line-sum.fact-qnty
     4509               .
     4510               if costprice = yes
     4511               then do:
     4512                   if no-vat = no then do:
     4513                       if PrintRubl = yes
     4514                       then do:
     4515                           assign
     4516                               p-izl-sum  = 0.0
     4517                               p-ned-sum  = -1.0 * buf_doc-line-sum.cost-sum-rubl
     4518                           .
     4519                       end.
     4520                       else do:
     4521                           assign
     4522                               p-izl-sum  = 0.0
     4523                               p-ned-sum  = -1.0 * buf_doc-line-sum.cost-sum-base
     4524                           .
     4525                       end.
     4526                    end.
     4527                   else do:
     4528                       if PrintRubl = yes
     4529                       then do:
     4530                           assign
     4531                               p-izl-sum  = 0.0
     4532                               p-ned-sum  = -1.0 * (buf_doc-line-sum.cost-sum-rubl - buf_doc-line-sum.cost-VAT-rubl)
     4533                           .
     4534                       end.
     4535                       else do:
     4536                           assign
     4537                               p-izl-sum  = 0.0
     4538                               p-ned-sum  = -1.0 * (buf_doc-line-sum.cost-sum-base - buf_doc-line-sum.cost-VAT-base)
     4539                           .
     4540                       end.
     4541                    end.
     4542               end.
     4543               else do:
     4544                   if PrintRubl = yes
     4545                   then do:
     4546                       assign
     4547                           p-izl-sum  = 0.0
     4548                           p-ned-sum  = -1.0 * buf_doc-line-sum.sale-sum-rubl
     4549                       .
     4550                   end.
     4551                   else do:
     4552                       assign
     4553                           p-izl-sum  = 0.0
     4554                           p-ned-sum  = -1.0 * buf_doc-line-sum.sale-sum-base
     4555                       .
     4556                   end.
     4557               end.
     4558           end.
     4559       end.
     4560       else do:
     4561           if costprice = yes
     4562           then do:
     4563               if PrintRubl = yes
     4564               then do:
     4565                   if buf_doc-line.fact-qnty >= 0
     4566                   then do:
     4567                       assign
     4568                           p-izl-qnty = buf_doc-line.fact-qnty
     4569                           p-ned-qnty = 0.0
     4570                           p-izl-sum  = buf_doc-line.price-rubl * buf_doc-line.fact-qnty.
     4571                           p-ned-sum  = 0.0
     4572                       .
     4573                   end.
     4574                   else do:
     4575                       assign
     4576                           p-izl-qnty = 0.0
     4577                           p-ned-qnty = -1.0 * buf_doc-line.fact-qnty
     4578                           p-izl-sum  = 0.0
     4579                           p-ned-sum  = -1.0 * buf_doc-line.price-rubl * buf_doc-line.fact-qnty.
     4580                       .
     4581                   end.
     4582               end.
     4583               else do:
     4584                   if buf_doc-line.fact-qnty >= 0
     4585                   then do:
     4586                       assign
     4587                           p-izl-qnty = buf_doc-line.fact-qnty
     4588                           p-ned-qnty = 0.0
     4589                           p-izl-sum  = buf_doc-line.price-base * buf_doc-line.fact-qnty.
     4590                           p-ned-sum  = 0.0
     4591                       .
     4592                   end.
     4593                   else do:
     4594                       assign
     4595                           p-izl-qnty = 0.0
     4596                           p-ned-qnty = -1.0 * buf_doc-line.fact-qnty
     4597                           p-izl-sum  = 0.0
     4598                           p-ned-sum  = -1.0 * buf_doc-line.price-base * buf_doc-line.fact-qnty.
     4599                       .
     4600                   end.
     4601               end.
     4602           end.
     4603           else do:
     4604               assign
     4605                   p-izl-qnty  = 0.0
     4606                   p-izl-sum   = 0.0
     4607                   p-ned-qnty  = 0.0
     4608                   p-ned-sum   = 0.0
     4609               .
     4610               for each buf_gds-dtl no-lock
     4611                   where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     4612                       and buf_gds-dtl.artic     = buf_doc-line.artic
     4613                       and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     4614                       and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     4615               :
     4616                   if buf_gds-dtl.doc-qnty >= 0
     4617                   then do:
     4618                       assign
     4619                           p-izl-qnty  = p-izl-qnty + buf_gds-dtl.doc-qnty
     4620                           p-izl-sum   = p-izl-sum  + ( if PrintRubl = yes then  buf_gds-dtl.price-rubl else buf_gds-dtl.price-base ) * buf_gds-dtl.doc-qnty
     4621                           p-ned-qnty  = 0.0
     4622                           p-ned-sum   = 0.0
     4623                       .
     4624                   end.
     4625                   else do:
     4626                       assign
     4627                           p-izl-qnty  = 0.0
     4628                           p-izl-sum   = 0.0
     4629                           p-ned-qnty  = p-ned-qnty + ( -1.0 * buf_gds-dtl.doc-qnty )
     4630                           p-ned-sum   = p-ned-sum  + ( -1.0 * ( if PrintRubl = yes then  buf_gds-dtl.price-rubl else buf_gds-dtl.price-base ) * buf_gds-dtl.doc-qnty )
     4631                       .
     4632                   end.
     4633               end.
     4634           end.
     4635       end.
     4636       assign
     4637           v-per-price     = 0.0
     4638       .
     4639       assign
     4640           v-per-price = ( if p-izl-qnty = 0
     4641                           then (  if p-ned-qnty = 0
     4642                                   then 0
     4643                                   else p-ned-sum / p-ned-qnty )
     4644                           else p-izl-sum / p-izl-qnty )
     4645           v-inv-peresort-qnty = buf_doc-line.inv-peresort-qnty
     4646       .
     4647       if v-inv-peresort-qnty >= 0
     4648       then do:
     4649           assign
     4650               p-per-izl-qnty  = v-inv-peresort-qnty
     4651               p-per-izl-sum   = v-per-price * v-inv-peresort-qnty
     4652               p-per-ned-qnty  = 0.0
     4653               p-per-ned-sum   = 0.0
     4654           .
     4655       end.
     4656       else do:
     4657           assign
     4658               p-per-izl-qnty = 0.0
     4659               p-per-izl-sum  = 0.0
     4660               p-per-ned-qnty = -1.0 * v-inv-peresort-qnty
     4661               p-per-ned-sum  = -1.0 * v-per-price * v-inv-peresort-qnty
     4662           .
     4663       end.
     4664       assign
     4665         v-gds-name = substitute( "&1 &2"
     4666                                , buf_goods.artic
     4667                                , buf_goods.gds-name
     4668                                )
     4669       .
     4670       if lookup( 'L-Rus' , v-sys-key) > 0
     4671       then do:
     4672         run inv19xl-sheet1-write-line-data in this-procedure (
     4673               input string( v-inv19-line-counter    )
     4674             , input v-gds-name
     4675             , input string( buf_goods.gds-code      )
     4676             , input string( buf_units.OKEI          )
     4677             , input string( buf_goods.unit-base     )
     4678             , input string( buf_goods.OKDP          )
     4679             , input string( p-izl-qnty              )
     4680             , input string( p-izl-sum               )
     4681             , input string( p-ned-qnty              )
     4682             , input string( p-ned-sum               )
     4683             , input string( v-inv19-line-counter    )
     4684             , input "":U
     4685             , input "":U
     4686             , input "":U
     4687             , input "":U
     4688             , input string( p-per-izl-qnty           )
     4689             , input string( p-per-izl-sum            )
     4690             , input string( p-per-ned-qnty           )
     4691             , input string( p-per-ned-sum            )
     4692             , input string( p-izl-qnty               )
     4693             , input string( p-izl-sum                )
     4694             , input string( p-ned-qnty               )
     4695             , input string( p-ned-sum                )
     4696             , input "":U
     4697             , input "":U
     4698             , input "":U
     4699             , input "":U
     4700         ).
     4701       end.
     4702       else do:
     4703         run inv19xl-sheet1-write-line-data in this-procedure (
     4704               input string( v-inv19-line-counter    )
     4705             , input v-gds-name
     4706             , input string( buf_goods.gds-code      )
     4707             , input string( buf_units.OKEI          )
     4708             , input string( buf_goods.unit-base     )
     4709             , input string( buf_goods.OKDP          )
     4710             , input trim(string( p-izl-qnty , '->>>,>>>,>>>,>>9.999' ))
     4711             , input string( p-izl-sum               )
     4712             , input trim(string( p-ned-qnty , '->>>,>>>,>>>,>>9.999' ))
     4713             , input string( p-ned-sum               )
     4714             , input string( v-inv19-line-counter    )
     4715             , input "":U
     4716             , input "":U
     4717             , input "":U
     4718             , input "":U
     4719             , input "":U
     4720             , input "":U
     4721             , input "":U
     4722             , input "":U
     4723             , input "":U
     4724             , input "":U
     4725             , input "":U
     4726             , input "":U
     4727             , input "":U
     4728             , input "":U
     4729             , input "":U
     4730             , input "":U
     4731         ).
     4732       end.
     4733   end.
     4734   end procedure.
     4735   procedure check-doc-sum :
     4736   define input parameter p-trn-doc-code   as character        no-undo.
     4737       define variable v-attr-value as character no-undo .
     4738       define variable v-attr-type as character no-undo .
     4739   do
     4740   on error undo, return error
     4741   :
     4742           run utl/uaddsum.p (
     4743                 input p-trn-doc-code
     4744               , input yes
     4745               , input yes
     4746               , input no
     4747           ) no-error .
     4748           if error-status :error
     4749           then do:
     4750               message
     4751                        vss-workfile vss-revision vss-description
     4752                   skip(1)
     4753                   skip "ошибка расчёта сумм инвентаризации."
     4754                   skip return-value
     4755                   skip trim( error-status :get-message( 1 ) )
     4756                        trim( error-status :get-message( 2 ) )
     4757                        trim( error-status :get-message( 3 ) )
     4758               view-as alert-box error.
     4759               undo, return error.
     4760           end.
     4761   end.
     4762   end procedure.
