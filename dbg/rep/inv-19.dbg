     3314               find first buf_store no-lock
     3315               where buf_store.obj-code = v-torgconf-self-obj-code
     3316               .
     3317               assign
     3318                  v-torgconf-main-boss = buf_store.store-boss
     3319                  v-torgconf-main-boss-post = "Директор"
     3320               .
     3321            END.
     3322            OTHERWISE DO:
     3323               assign
     3324                  v-torgconf-main-boss       = "":U
     3325                  v-torgconf-main-boss-post  = "":U
     3326               .
     3327            END.
     3328            END CASE.
     3329         end.
     3330      if  v-name <> 'wthtrg12':U
     3331      and v-name <> 'wthfct':U
     3332      and v-name <> 'wthm11':U
     3333      then do:
     3334       find first buf_trn-doc no-lock
     3335       where buf_trn-doc.doc-code = p-doc-code
     3336       no-error.
     3337       if available buf_trn-doc
     3338         then do:
     3339   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3340   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3341     (input  buf_trn-doc.obj-type
     3342     ,input  buf_trn-doc.obj-code
     3343     ,output v-host-code
     3344     )  .
     3345         end.
     3346       if v-torgconf-outogr = "no_print"
