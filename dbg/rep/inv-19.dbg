     1061           v-torgconf-outprim  = no
     1062           v-torgconf-outdisc  = no
     1063           v-torgconf-outsubs  = no
     1064           v-torgconf-outrecv  = no
     1065           v-torgconf-outegrp  = no
     1066           v-torgconf-outt12   = no
     1067           v-torgconf-outappr  = no
     1068           v-torgconf-outrubl  = no
     1069           v-torgconf-outhold  = no
