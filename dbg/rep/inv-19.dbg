     3447               assign
     3448                  v-torgconf-ogr-name = ""
     3449                  v-torgconf-ogr-post = ""
     3450               .
     3451            end.
     3452         if v-torgconf-outogr  = "ruk_firm"
     3453               then do:
     3454               find first buf_sysconf no-lock
     3455               where buf_sysconf.host-code = v-host-code
     3456               no-error.
     3457               if available buf_sysconf
