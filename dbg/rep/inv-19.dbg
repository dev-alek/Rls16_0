     3982           buf_temp_sheet1_line-data.utochNedQnty     = p-utochNedQnty
     3983           buf_temp_sheet1_line-data.utochNedSum      = p-utochNedSum
     3984           buf_temp_sheet1_line-data.peresIzlQnty     = p-peresIzlQnty
     3985           buf_temp_sheet1_line-data.peresIzlSum      = p-peresIzlSum
     3986           buf_temp_sheet1_line-data.peresNedQnty     = p-peresNedQnty
     3987           buf_temp_sheet1_line-data.peresNedSum      = p-peresNedSum
