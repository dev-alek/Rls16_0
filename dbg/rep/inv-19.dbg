     1168               .
     1169           end.
     1170           if lookup( p-form-name, v-outnum  ) <> 0
     1171           then do:
     1172               assign
     1173                   v-torgconf-outnum   = yes
     1174               .
     1175           end.
     1176           if lookup( p-form-name, v-outprim ) <> 0
     1177           then do:
     1178               assign
     1179                   v-torgconf-outprim  = yes
     1180               .
     1181           end.
     1182           if lookup( p-form-name, v-outdisc ) <> 0
     1183           then do:
     1184               assign
     1185                   v-torgconf-outdisc  = yes
     1186               .
     1187           end.
     1188           if lookup( p-form-name, v-outsubs ) <> 0
     1189           then do:
     1190               assign
     1191                   v-torgconf-outsubs  = yes
     1192               .
     1193           end.
     1194           if lookup( p-form-name, v-outrecv ) <> 0
     1195           then do:
     1196               assign
     1197                   v-torgconf-outrecv  = yes
     1198               .
     1199           end.
     1200           if lookup( p-form-name, v-outegrp ) <> 0
     1201           then do:
     1202               assign
     1203                   v-torgconf-outegrp  = yes
     1204               .
     1205           end.
     1206           if lookup( p-form-name, v-outt12  ) <> 0
     1207           then do:
     1208               assign
     1209                   v-torgconf-outt12   = yes
     1210               .
     1211           end.
     1212           if lookup( p-form-name, v-outappr  ) <> 0
