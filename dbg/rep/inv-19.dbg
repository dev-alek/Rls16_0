     3019                           .
     3020                       end.
     3021                       if v-torgconf-doc-code = ""
     3022                       then do:
     3023                           assign v-torgconf-doc-code = substr( p-doc-code, 1, 2 )
     3024                                               + string( month( p-doc-date ),  "99" )
     3025                                               + string( day( p-doc-date ),    "99" )
     3026                           .
     3027                       end.
     3028                       else do:
     3029                           assign v-torgconf-doc-code = string( month( p-doc-date ), ">9" )
     3030                                               + trim( string( day( p-doc-date ), ">9" ) )
     3031                                               + string( v-doc-code-integer )
     3032                           .
     3033                       end.
     3034                   end.
     3035                   else do:
     3036                       assign
     3037                           v-torgconf-doc-code = p-doc-code
     3038                       .
     3039                   end.
     3040               end.
     3041           end.
     3042       end.
     3043       if v-torgconf-outnum = yes
     3044       then do:
     3045           assign
     3046               v-torgconf-vdoc-code = " "
     3047           .
     3048       end.
     3049       else do:
     3050         assign
     3051            v-torgconf-vdoc-code = p-doc-code
     3052         .
     3053         if p-doc-type = 'при':U
     3054         then do:
     3055            run gbl/trdcat-v.p (
     3056                       input p-doc-code
     3057                     , input 'nids':U
     3058                     , output v-doc-code-attr
     3059                     , output v-attr-type
     3060                  ).
     3061         end.
     3062         if  p-doc-type =  'рас':U
     3063         or  p-doc-type =  'возврат':U
     3064         then do:
     3065            run gbl/trdcat-v.p (
     3066                       input p-doc-code
     3067                     , input 'print-num':U
     3068                     , output v-doc-code-attr
     3069                     , output v-attr-type
     3070                  ).
     3071         end.
     3072         if trim(v-doc-code-attr) <> ""
     3073         then do:
     3074            assign
     3075               v-torgconf-vdoc-code = v-doc-code-attr
     3076            .
     3077         end.
     3078       end.
     3079       if v-torgconf-outdate = yes
     3080       then do:
     3081           assign
     3082            v-torgconf-doc-date =  "          "
     3083            v-torgconf-vdoc-date = "          "
     3084           .
     3085       end.
     3086       else do:
     3087           if lookup( v-torgconf-ext-doc-type, 'ie,ee,ii,ei,ij,ej,fj,jj,pj,oj,we,ci,ce,iy,rj,ip,ep,rp,ff,ef,rf,pc,ps,pz,df,dp,dc,de,xc':u ) <> 0
     3088           then do:
     3089               run gbl/wthat-v.p (
     3090                     input p-doc-code
     3091                   , input 'wthdsf':U
     3092                   , output v-torgconf-doc-date
     3093                   , output v-attr-type
     3094               ).
     3095               assign
     3096                   v-doc-date-standard = ( trim( v-torgconf-doc-date ) = "":U )
     3097               .
     3098           end.
     3099           else do:
     3100               assign
     3101                   v-doc-date-standard = yes
     3102               .
     3103           end.
     3104           if v-doc-date-standard = yes
     3105           then do:
     3106               assign v-torgconf-doc-date =  ( if p-status_ <> 'факт':U
     3107                                               or p-print-doc = yes
     3108                                               then string( p-doc-date, "99/99/9999" )
     3109                                               else string( p-fact-date, "99/99/9999" )
     3110                                           )
     3111               .
     3112           end.
     3113           assign v-torgconf-vdoc-date = ( if p-status_ <> 'факт':U
     3114                                             then string( p-doc-date, "99/99/9999" )
     3115                                             else string( p-fact-date, "99/99/9999" )
     3116                                         )
     3117           .
     3118           if p-doc-type = 'при':U
     3119              then do:
     3120                 run gbl/trdcat-v.p (
     3121                     input p-doc-code
     3122                   , input 'dids':U
     3123                   , output v-torgconf-doc-date-attr
     3124                   , output v-attr-type
     3125                ).
     3126              end.
     3127           if trim(v-torgconf-doc-date-attr) <> ""
     3128           then do:
     3129               assign v-torgconf-vdoc-date = v-torgconf-doc-date-attr
     3130               .
     3131           end.
     3132       end.
     3133      if  v-name <> 'wthtrg12'
     3134      and v-name <> 'wthfct'
     3135      and v-name <> 'wthm11'
     3136      then do:
     3137       run gbl/trdcat-v.p (
     3138                     input p-doc-code
     3139                   , input 'NFinDoc':U
     3140                   , output v-dcode-attr
     3141                   , output v-par-type
     3142               ) no-error.
     3143       if error-status :error
     3144       then do:
     3145           assign v-dcode-attr = "".
     3146       end.
     3147       run gbl/trdcat-v.p (
     3148                     input p-doc-code
     3149                   , input 'DFinDoc':U
     3150                   , output v-ddate-attr
     3151                   , output v-par-type
     3152               ) no-error.
     3153       if error-status :error
     3154       then do:
     3155           assign v-ddate-attr = "".
     3156       end.
     3157      end.
     3158      else do:
     3159   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3160                           input 'wthpaydoc':U ,
     3161                          output v-attr ,
     3162                          output v-attr-type )  .
     3163      end.
     3164       case v-torgconf-outssdoc
     3165       :
     3166        when "nacl":U
     3167        then do:
     3168            if  v-name <> 'wthtrg12'
     3169            and v-name <> 'wthfct'
     3170            and v-name <> 'wthm11'
     3171            then do:
     3172               assign
     3173                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3"
     3174                                                   , if trim(v-dcode-attr) = "" then v-torgconf-doc-code else v-dcode-attr
     3175                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3176                                                   , ( if p-status_ <> 'факт':U
     3177                                                      then string( "(" + caps( p-status_ ) + ")" )
     3178                                                      else "":U )
     3179                                                )
     3180               .
     3181            end.
     3182            else do:
     3183            if trim(v-attr) = ""
