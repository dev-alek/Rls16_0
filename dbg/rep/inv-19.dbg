     3491               no-error.
     3492               if available buf_wth-doc
     3493               then do:
     3494                  run rep/get-psn.p
     3495                  (input buf_wth-doc.deliver
     3496                  ,output v-torgconf-ogr-name
     3497                  ) .
     3498               end.
