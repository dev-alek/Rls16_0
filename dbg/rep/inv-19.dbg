     1434       end.
     1435     assign
     1436       v-recipient  = v-recipient-code
     1437       v-type-rec = substring(v-recipient-code,1,3)
     1438       v-code-rec  = int(substring(v-recipient-code,4,15))
     1439       no-error
     1440     .
     1441     if v-type-rec = ? then v-type-rec = "" .
     1442     if v-code-rec  = ? then v-code-rec  =  0 .
     1443     end procedure.
