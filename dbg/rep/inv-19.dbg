     1605   procedure torgconf-get-sup-param :
     1606   define input parameter p-obj-type           as character        no-undo.
     1607   define input parameter p-obj-code           as integer          no-undo.
     1608   define input parameter p-curr-code          as integer          no-undo.
     1609       define variable v-host-code    as integer      no-undo.
     1610       define variable v-par-type     as character    no-undo.
     1611   do
     1612   on error undo, return error
     1613   :
     1614       assign
     1615          v-torgconf-sup-host-code = v-host-code
     1616       .
     1617       if v-torgconf-sup-host-code = 0
     1618       then do:
     1619           assign
     1620               v-torgconf-sup-host-name           = "":U
     1621               v-torgconf-sup-host-addres         = "":U
     1622               v-torgconf-sup-host-post-addres    = "":U
     1623               v-torgconf-sup-host-phone          = "":U
     1624               v-torgconf-sup-host-inn            = "":U
     1625               v-torgconf-sup-host-kpp            = "":U
     1626               v-torgconf-sup-host-okpo           = "":U
     1627               v-torgconf-sup-host-egrip-date     = "":U
     1628               v-torgconf-sup-host-egrip-num      = "":U
     1629           .
     1630       end.
     1631       else do:
     1632           run fmtcli-get-client in this-procedure (
     1633                 input 'орг':U
     1634               , input v-torgconf-sup-host-code
     1635           ).
     1636           assign
     1637               v-torgconf-sup-host-name        = v-fmtcli-name
     1638               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1639               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1640               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1641               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1642               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1643               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1644               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1645           .
     1646           run gbl/clntat-v.p (
     1647                 input 'орг':U
     1648               , input v-torgconf-sup-host-code
     1649               , input 'egrip-date':U
     1650               , output v-torgconf-sup-host-egrip-date
     1651               , output v-par-type
     1652           ).
     1653           run gbl/clntat-v.p (
     1654                 input 'орг':U
     1655               , input v-torgconf-sup-host-code
     1656               , input 'egrip-num':U
     1657               , output v-torgconf-sup-host-egrip-num
     1658               , output v-par-type
     1659           ).
     1660           run fmtcli-get-bank in this-procedure (
     1661                 input v-host-code
     1662               , input 'орг':U
     1663               , input v-torgconf-sup-host-code
     1664               , input p-curr-code
     1665           ).
     1666       end.
     1667       assign
     1668           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1669           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1670           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1671           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1672           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1673           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1674           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1675           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1676       .
     1677       assign
     1678           v-torgconf-sup-obj-type = p-obj-type
     1679           v-torgconf-sup-obj-code = p-obj-code
     1680       .
     1681       if trim(p-obj-type) <> ""
     1682       and p-obj-code <> 0
     1683       then do:
     1684       run fmtcli-get-client in this-procedure (
     1685             input p-obj-type
     1686           , input p-obj-code
     1687       ).
     1688       assign
     1689           v-torgconf-sup-obj-name        = v-fmtcli-name
     1690           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1691           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1692           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1693           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1694           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1695           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1696       .
     1697      end.
     1698      end.
     1699   end procedure.
     1700   procedure torgconf-get-cli-param :
     1701   define input parameter p-host-obj-code      as integer          no-undo.
     1702   define input parameter p-obj-type           as character        no-undo.
     1703   define input parameter p-obj-code           as integer          no-undo.
     1704   define input parameter p-curr-code          as integer          no-undo.
     1705       define variable v-host-code    as integer      no-undo.
     1706   do
     1707   on error undo, return error
     1708   :
     1709       assign
     1710           v-torgconf-cli-type = p-obj-type
     1711           v-torgconf-cli-code = p-obj-code
     1712       .
     1713       run fmtcli-get-client in this-procedure (
     1714             input p-obj-type
     1715           , input p-obj-code
     1716       ).
     1717       assign
     1718           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1719           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1720           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1721           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1722           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1723           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1724           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1725           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1726       .
     1727      run fmtcli-get-bank in this-procedure (
     1728             input p-host-obj-code
     1729           , input p-obj-type
     1730           , input p-obj-code
     1731           , input p-curr-code
     1732       ).
     1733       assign
     1734           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1735           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1736           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1737           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1738           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1739           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1740           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1741           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1742       .
     1743   end.
     1744   end procedure.
     1745   procedure torgconf-get-ship-param :
     1746   define input parameter p-host-obj-code      as integer          no-undo.
     1747   define input parameter p-obj-type           as character        no-undo.
     1748   define input parameter p-obj-code           as integer          no-undo.
     1749   define input parameter p-curr-code          as integer          no-undo.
     1750       define variable v-host-code    as integer      no-undo.
     1751   do
     1752   on error undo, return error
     1753   :
     1754       assign
     1755           v-torgconf-ship-type = p-obj-type
     1756           v-torgconf-ship-code = p-obj-code
     1757       .
     1758       if trim(p-obj-type) = ""
     1759       and p-obj-code = 0
     1760       then do:
     1761       assign
     1762           v-torgconf-ship-name         = "":U
     1763           v-torgconf-ship-addres       = "":U
     1764           v-torgconf-ship-post-addres  = "":U
     1765           v-torgconf-ship-phone        = "":U
     1766           v-torgconf-ship-inn          = "":U
     1767           v-torgconf-ship-kpp          = "":U
     1768           v-torgconf-ship-okpo         = "":U
     1769       .
     1770       end.
     1771       else do:
     1772       run fmtcli-get-client in this-procedure (
     1773             input p-obj-type
     1774           , input p-obj-code
     1775       ).
     1776       assign
     1777           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1778           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1779           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1780           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1781           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1782           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1783           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1784           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1785       .
     1786       end.
     1787           run fmtcli-get-bank in this-procedure (
     1788             input p-host-obj-code
     1789           , input p-obj-type
     1790           , input p-obj-code
     1791           , input p-curr-code
     1792       ).
     1793       assign
     1794           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1795           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1796           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1797           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1798           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1799           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1800           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1801           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1802       .
     1803   end.
     1804   end procedure.
     1805   procedure torgconf-get-holdfirm-code :
     1806   define input parameter p-obj-type   as character        no-undo.
     1807   define input parameter p-obj-code   as integer          no-undo.
     1808   define output parameter p-firm-code as integer          no-undo.
     1809       define variable v-firm-code-str     as character    no-undo.
     1810       define variable v-par-type          as character    no-undo.
     1811       define buffer buf_clients       for ub.clients.
     1812   do
     1813   for buf_clients
     1814   on error undo, return error
     1815   :
     1816       run gbl/clntat-v.p (
     1817             input p-obj-type
     1818           , input p-obj-code
     1819           , input 'holdfirm-code':U
     1820           , output v-firm-code-str
     1821           , output v-par-type
     1822       ).
     1823       assign
     1824           p-firm-code = integer( v-firm-code-str )
     1825       no-error.
     1826       if error-status :error
     1827       then do:
     1828           message
     1829               "Неверно задан код фирмы для печати накладных."
     1830           view-as alert-box warning.
     1831           assign
     1832               p-firm-code = 0
     1833           .
     1834       end.
     1835       else do:
     1836           find first buf_clients no-lock
     1837                where buf_clients.obj-type = 'орг':U
     1838                  and buf_clients.obj-code = p-firm-code
     1839           no-error.
     1840           if not available buf_clients
     1841           then do:
     1842               message
     1843                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     1844                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     1845               view-as alert-box warning.
     1846               assign
     1847                   p-firm-code = 0
     1848               .
     1849           end.
     1850       end.
     1851   end.
     1852   end procedure.
     1853   procedure torgconf-get-post-head:
     1854   define input  parameter p-obj-type             as character        no-undo.
     1855   define input  parameter p-obj-code             as integer          no-undo.
     1856   define output parameter p-torgconf-post-head   as character        no-undo.
     1857      define variable v-host-code         as integer      no-undo.
     1858      define buffer buf_sysconf     for ub.sysconf.
     1859        assign
     1860         p-torgconf-post-head  = ""
     1861        .
     1862   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1863   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1864     (input  p-obj-type
     1865     ,input  p-obj-code
     1866     ,output v-host-code
     1867     )  .
     1868      find first buf_sysconf no-lock
     1869      where buf_sysconf.host-code = v-host-code
     1870      no-error.
     1871      if available buf_sysconf
     1872      then do:
     1873         assign
     1874            p-torgconf-post-head = buf_sysconf.head-position
     1875         .
     1876      end.
     1877   end procedure.
     1878   procedure torgconf-get-storekeeper:
     1879   define input  parameter p-wrkr                   as integer          no-undo.
     1880   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     1881   define output parameter p-torgconf-post          as character        no-undo.
     1882      define buffer buf_sysconf     for ub.sysconf.
     1883      define buffer buf_person      for ub.person.
     1884      define buffer buf_shop        for ub.shop .
     1885      define buffer buf_store       for ub.store .
     1886      if v-torgconf-outC = "no_print"
     1887      then do:
     1888         assign p-torgconf-post = ""
     1889                p-torgconf-wrkr-name = ""
     1890                .
     1891      end.
     1892      if v-torgconf-outC = "clad_doc"
     1893      then do:
     1894         run rep/get-psn.p
     1895               (input  p-wrkr
     1896               ,output p-torgconf-wrkr-name
     1897               ) .
     1898         find first buf_person no-lock
     1899         where buf_person.psn-code = p-wrkr
     1900         no-error.
     1901         if available buf_person
     1902         then do:
     1903           p-torgconf-post = buf_person.position.
     1904         end.
     1905         if p-torgconf-post = "?":U then p-torgconf-post = "".
     1906         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1907      end.
     1908      if v-torgconf-outC = "clad_obj"
     1909      then do:
     1910         CASE v-torgconf-self-obj-type:
     1911         WHEN 'маг':U
     1912         THEN DO:
     1913            find first buf_shop no-lock
     1914            where buf_shop.obj-code = v-torgconf-self-obj-code
     1915            .
     1916            assign
     1917               p-torgconf-wrkr-name = buf_shop.store-man
     1918               p-torgconf-post = ""
     1919            .
     1920            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1921         END.
     1922         WHEN 'скл':U
     1923         THEN DO:
     1924            find first buf_store no-lock
     1925            where buf_store.obj-code = v-torgconf-self-obj-code
     1926            .
     1927            assign
     1928               p-torgconf-wrkr-name = buf_store.store-man
     1929               p-torgconf-post = ""
     1930            .
     1931            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     1932         END.
     1933         OTHERWISE DO:
     1934            assign
     1935               p-torgconf-post = "":U
     1936               p-torgconf-wrkr-name = "":U
     1937            .
     1938         END.
     1939         END CASE.
     1940      end.
     1941    end procedure.
     1942   procedure torgconf-get-form-header :
     1943   define input parameter p-for-inverse    as logical          no-undo.
     1944   define input parameter p-doc-code       as character        no-undo.
     1945   define input parameter p-print-doc      as logical          no-undo.
     1946   define input parameter p-doc-date       as date             no-undo.
     1947   define input parameter p-fact-date      as date             no-undo.
     1948   define input parameter p-doc-type       as character        no-undo.
     1949   define input parameter p-status_        as character        no-undo.
     1950   define input parameter p-reverse        as logical          no-undo.
     1951   define input parameter p-sf-par         as logical          no-undo.
     1952       define variable v-attr-type         as character    no-undo.
     1953       define variable v-doc-code-standard as logical      no-undo.
     1954       define variable v-doc-date-standard as logical      no-undo.
     1955       define variable v-par-consignee-addres  as character    no-undo.
     1956       define variable v-host-code         as integer      no-undo.
     1957       define variable v-dcode-attr        as character    no-undo.
     1958       define variable v-ddate-attr        as character    no-undo.
     1959       define variable v-doc-date          as character    no-undo.
     1960       define variable v-doc-code          as character    no-undo.
     1961       define variable v-par-type          as character    no-undo.
     1962       define variable v-attr              as character    no-undo.
     1963       define buffer buf_firm          for ub.firm .
     1964       define buffer buf_clients       for ub.clients .
     1965       define buffer buf_sysconf       for ub.sysconf .
     1966       define buffer buf_shop          for ub.shop .
     1967       define buffer buf_store         for ub.store .
     1968       define buffer buf_person        for ub.person .
     1969       define buffer buf_trn-doc       for ub.trn-doc .
     1970       define buffer buf_wth-doc       for ub.wth-doc .
     1971       do
     1972   for buf_firm
     1973     , buf_clients
     1974     , buf_sysconf
     1975     , buf_shop
     1976     , buf_trn-doc
     1977     , buf_person
     1978     , buf_wth-doc
     1979   on error undo, return error
     1980   :
     1981       if p-doc-type = 'при':U
     1982       or p-doc-type = 'возврат':U
     1983       then do:
     1984           assign
     1985               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1986                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1987               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     1988                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     1989               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     1990                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     1991               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     1992                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     1993               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     1994               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     1995               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     1996               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     1997               v-torgconf-supplier-type    = v-torgconf-cli-type
     1998               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     1999               v-torgconf-saler-type       = v-torgconf-self-host-type
     2000               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2001               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2002               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2003               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2004               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2005               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2006               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2007               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2008               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2009               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2010               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2011               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2012               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2013               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2014               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2015           .
     2016           if v-torgconf-cli-schet-exists = yes
     2017           AND v-form-name                  = "torg12":U
     2018           then do:
     2019               assign
     2020                   v-torgconf-supplier = v-torgconf-supplier
     2021                       + substitute( ", р/с &1 к/с &2"
     2022                                   , v-torgconf-cli-bank-r-schet
     2023                                   , v-torgconf-cli-bank-c-schet
     2024                                   )
     2025                   v-torgconf-suppi = v-torgconf-supplier
     2026                       + substitute( ", р/с &1 к/с &2"
     2027                                   , v-torgconf-cli-bank-r-schet
     2028                                   , v-torgconf-cli-bank-c-schet
     2029                                   )
     2030               .
     2031               if v-torgconf-cli-bank-exists = yes
     2032               then do:
     2033                   assign
     2034                       v-torgconf-supplier = v-torgconf-supplier
     2035                           + substitute( " БИК &1 в &2 &3"
     2036                                       , v-torgconf-cli-bank-bik
     2037                                       , v-torgconf-cli-bank-name
     2038                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2039                                       )
     2040                      v-torgconf-suppi = v-torgconf-supplier
     2041                           + substitute( " БИК &1 в &2 &3"
     2042                                       , v-torgconf-cli-bank-bik
     2043                                       , v-torgconf-cli-bank-name
     2044                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2045                                       )
     2046                   .
     2047               end.
     2048           end.
     2049           if v-torgconf-self-schet-exists = yes
     2050           AND v-form-name                  = "torg12":U
     2051           then do:
     2052               assign
     2053                   v-torgconf-saler = v-torgconf-saler
     2054                       + substitute( ", р/с &1 к/с &2"
     2055                                   , v-torgconf-self-bank-r-schet
     2056                                   , v-torgconf-self-bank-c-schet
     2057                                   )
     2058               .
     2059               if v-torgconf-self-bank-exists = yes
     2060               then do:
     2061                   assign
     2062                       v-torgconf-saler = v-torgconf-saler
     2063                           + substitute( " БИК &1 в &2 &3"
     2064                                       , v-torgconf-self-bank-bik
     2065                                       , v-torgconf-self-bank-name
     2066                                       , v-torgconf-self-bank-addres
     2067                                       )
     2068                   .
     2069               end.
     2070           end.
     2071           if v-torgconf-sup-schet-exists = yes
     2072           AND v-form-name                  = "torg12":U
     2073           then do:
     2074               assign
     2075                   v-torgconf-consignee = v-torgconf-consignee
     2076                       + substitute( ", р/с &1 к/с &2"
     2077                                   , v-torgconf-sup-bank-r-schet
     2078                                   , v-torgconf-sup-bank-c-schet
     2079                                   )
     2080               .
     2081             if v-torgconf-sup-bank-exists = yes
     2082              then do:
     2083                assign
     2084                   v-torgconf-consignee = v-torgconf-consignee
     2085                           + substitute( " БИК &1 в &2 &3"
     2086                                       , v-torgconf-sup-bank-bik
     2087                                       , v-torgconf-sup-bank-name
     2088                                       , v-torgconf-sup-bank-addres
     2089                                       )
     2090                   .
     2091               end.
     2092           end.
     2093      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2094      then do:
     2095          assign
     2096            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2097                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2098                                                   , v-torgconf-cli-name
     2099                                                   , ( if v-torgconf-outprncd = yes
     2100                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2101                                                         else "":U )
     2102                                                   , v-torgconf-cli-post-addres
     2103                                                   , v-torgconf-cli-phone
     2104                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2105                                                       AND v-form-name                  = "torg12":U
     2106                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2107                                                               , v-torgconf-cli-bank-r-schet
     2108                                                               , v-torgconf-cli-bank-c-schet
     2109                                                               , v-torgconf-cli-bank-bik
     2110                                                               , v-torgconf-cli-bank-name
     2111                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2112                                                         else "":U )
     2113                                                )
     2114         .
     2115      end.
     2116       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2117                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2118                                        , v-torgconf-cli-name
     2119                                        , ( if v-torgconf-outprncd = yes
     2120                                            then substitute( " (&1)", v-torgconf-cli-code )
     2121                                            else "":U )
     2122                                        , v-torgconf-cli-addres
     2123                                        , v-torgconf-cli-phone
     2124                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2125                                            AND v-form-name                  = "torg12":U
     2126                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2127                                                           , v-torgconf-cli-bank-r-schet
     2128                                                           , v-torgconf-cli-bank-c-schet
     2129                                                           , v-torgconf-cli-bank-bik
     2130                                                           , v-torgconf-cli-bank-name
     2131                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2132                                                   else "":U )
     2133                                        ).
     2134       end.
     2135       else do:
     2136       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2137                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2138                                        , v-torgconf-self-host-name
     2139                                        , ( if v-torgconf-outprncd = yes
     2140                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2141                                            else "":U )
     2142                                        , v-torgconf-self-host-addres
     2143                                        , v-torgconf-self-host-phone
     2144                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2145                                            AND v-form-name                  = "torg12":U
     2146                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2147                                                           , v-torgconf-self-bank-r-schet
     2148                                                           , v-torgconf-self-bank-c-schet
     2149                                                           , v-torgconf-self-bank-bik
     2150                                                           , v-torgconf-self-bank-name
     2151                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2152                                                   else "":U )
     2153                                           ).
     2154         if v-torgconf-outares = yes
     2155         and p-reverse = no
     2156         then do:
     2157            assign
     2158               v-par-consignee-addres = v-torgconf-ship-post-addres
     2159            .
     2160         end.
     2161         if v-torgconf-outares = no
     2162         and p-reverse = no
     2163         then do:
     2164            assign
     2165               v-par-consignee-addres = v-torgconf-ship-addres
     2166            .
     2167         end.
     2168         if p-reverse = yes
     2169         then do:
     2170             assign
     2171               v-par-consignee-addres = v-torgconf-ship-addres
     2172             .
     2173         end.
     2174           assign
     2175               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2176                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2177               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2178                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2179               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
