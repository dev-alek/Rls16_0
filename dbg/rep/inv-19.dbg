     3989           buf_temp_sheet1_line-data.endIzlSum        = p-endIzlSum
     3990           buf_temp_sheet1_line-data.endNedQnty1      = p-endNedQnty1
     3991           buf_temp_sheet1_line-data.endNedSum1       = p-endNedSum1
     3992           buf_temp_sheet1_line-data.endNedQnty2      = p-endNedQnty2
     3993           buf_temp_sheet1_line-data.endNedSum2       = p-endNedSum2
     3994           buf_temp_sheet1_line-data.endNedQnty3      = p-endNedQnty3
     3995           buf_temp_sheet1_line-data.endNedSum3       = p-endNedSum3
     3996       .
