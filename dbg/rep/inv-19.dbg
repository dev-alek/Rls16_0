      949   procedure wthcattr-sprcli :
      950   define input parameter parparentproc  as widget-handle no-undo.
      951   define input parameter p-mode  as character no-undo.
      952   define input-output parameter p-value as character no-undo .
      953   define output parameter p-setted as logical no-undo .
      954     DEFINE VARIABLE v-value as character no-undo .
      955     define variable v-cli-type as character no-undo .
      956     define variable v-cli-code as integer no-undo .
      957     define buffer buf_clients   for ub.clients.
      958     define variable v_rid as character no-undo.
      959     define variable ref-rec as recid no-undo .
      960     do
      961     on error undo, return error
      962     :
      963         v-value = p-value.
      964      if p-value <> '':U then do:
      965       assign
      966       v-cli-type = substring(p-value, 1, 3)
      967       v-cli-code = integer(substring(p-value, 4))
      968       no-error.
      969       if error-status:error then do:
      970         assign
      971         v-cli-type = '':U
      972         v-cli-code = 0
      973         .
      974       end.
      975      end.
      976      FIND FIRST buf_clients NO-LOCK WHERE
      977               buf_clients.obj-type = v-cli-type AND
      978               buf_clients.obj-code = v-cli-code  NO-ERROR.
      979      IF available(buf_clients) then do:
      980       run ref/cli-all.w (
      981                   input parparentproc
      982                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
      983                  ,input v-cli-type
      984                  ,input 'все':U
      985                  ,input 'все':U
      986                  ,input RECID( buf_clients )
      987                  ,input ",,,,,,NO"
      988                  ,input ?
      989                  ,OUTPUT v_rid ).
      990     END.
      991     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
      992       run ref/cli-all.w (
      993                    input parparentproc
      994                   ,INPUT "b-sel":U
      995                  ,input  v-cli-type
      996                  ,input 'все':U
      997                  ,input 'текущие':U
      998                  ,input ?
      999                  ,input ",,,,,,NO"
     1000                  ,input ?
     1001                  ,OUTPUT v_rid ).
     1002     END.
     1003     else do:
     1004       message
     1005       if p-value = "":U then 'Атрибут не задан!'
     1006       else substitute('Не найден клиент &1',p-value)
     1007       view-as alert-box warning.
     1008     end.
     1009     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1010       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1011       IF ERROR-STATUS:ERROR THEN DO:
     1012           RETURN NO-APPLY.
     1013       END.
     1014       FIND FIRST buf_clients NO-LOCK WHERE
     1015                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1016       IF AVAIL buf_clients THEN DO:
     1017         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1018       end.
     1019     end.
     1020     if v-value <> p-value then do:
     1021       p-value = v-value.
     1022       p-setted = yes.
     1023     end.
     1024     end.
     1025   end procedure.
     1026     define new global shared variable g#wthcalib as handle no-undo.
