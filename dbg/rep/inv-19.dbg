     1252               .
     1253           end.
     1254           if lookup( p-form-name, v-outexlst ) <> 0
     1255           then do:
     1256               assign
     1257                   v-torgconf-outexlst  = yes
     1258               .
     1259           end.
     1260        assign
     1261         v-name = p-form-name.
     1262   end.
     1263   end.
     1264   end procedure.
     1265   procedure torgconf-get-self-param :
     1266   define input parameter p-obj-type           as character        no-undo.
     1267   define input parameter p-obj-code           as integer          no-undo.
     1268   define input parameter p-curr-code          as integer          no-undo.
     1269       define variable v-host-code    as integer      no-undo.
     1270       define variable v-par-type     as character    no-undo.
     1271   do
     1272   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1273   :
     1274   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1275   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1276     (input  p-obj-type
     1277     ,input  p-obj-code
     1278     ,output v-host-code
     1279     )  .
     1280       if v-torgconf-outhold = yes
     1281       then do:
     1282           run torgconf-get-holdfirm-code in this-procedure (
     1283                 input p-obj-type
     1284               , input p-obj-code
     1285               , output v-torgconf-self-host-code
     1286           ).
     1287           if v-torgconf-self-host-code = 0
     1288           then do:
     1289               return error.
     1290           end.
     1291       end.
     1292       else do:
     1293           assign
     1294               v-torgconf-self-host-code = v-host-code
     1295           .
     1296       end.
     1297       if v-torgconf-self-host-code = 0
     1298       then do:
     1299           assign
     1300               v-torgconf-self-host-name           = "":U
     1301               v-torgconf-self-host-addres         = "":U
     1302               v-torgconf-self-host-post-addres    = "":U
     1303               v-torgconf-self-host-phone          = "":U
     1304               v-torgconf-self-host-inn            = "":U
     1305               v-torgconf-self-host-kpp            = "":U
     1306               v-torgconf-self-host-okpo           = "":U
     1307               v-torgconf-self-host-egrip-date     = "":U
     1308               v-torgconf-self-host-egrip-num      = "":U
     1309           .
     1310       end.
     1311       else do:
     1312           run fmtcli-get-client in this-procedure (
     1313                 input 'орг':U
     1314               , input v-torgconf-self-host-code
     1315           ).
     1316           assign
     1317               v-torgconf-self-host-name        = v-fmtcli-name
     1318               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1319               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1320               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1321               v-torgconf-self-host-phone       = v-fmtcli-phone
     1322               v-torgconf-self-host-inn         = v-fmtcli-inn
     1323               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1324               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1325           .
     1326           run gbl/clntat-v.p (
     1327                 input 'орг':U
     1328               , input v-torgconf-self-host-code
     1329               , input 'egrip-date':U
     1330               , output v-torgconf-self-host-egrip-date
     1331               , output v-par-type
     1332           ).
     1333           run gbl/clntat-v.p (
     1334                 input 'орг':U
     1335               , input v-torgconf-self-host-code
     1336               , input 'egrip-num':U
     1337               , output v-torgconf-self-host-egrip-num
     1338               , output v-par-type
     1339           ).
     1340           run fmtcli-get-bank in this-procedure (
     1341                 input v-host-code
     1342               , input 'орг':U
     1343               , input v-torgconf-self-host-code
     1344               , input p-curr-code
     1345           ).
     1346       end.
     1347       assign
     1348           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1349           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1350           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1351           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1352           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1353           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1354           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1355           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1356       .
     1357       assign
     1358           v-torgconf-self-obj-type = p-obj-type
     1359           v-torgconf-self-obj-code = p-obj-code
     1360       .
     1361       run fmtcli-get-client in this-procedure (
     1362             input p-obj-type
     1363           , input p-obj-code
     1364       ).
     1365       assign
     1366           v-torgconf-self-obj-name       = v-fmtcli-name
     1367           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1368           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1369           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1370           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1371           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1372           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1373       .
     1374   end.
     1375   end procedure.
     1376   procedure torgconf-get-recepient-param :
     1377   define input parameter torgconfdoc-code   as character                  no-undo.
     1378   define output parameter v-code-rec        as integer                    no-undo .
     1379   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1380   define output parameter v-codefirm-rec    as integer                    no-undo .
     1381   define output parameter v-curcode-rec     as integer                    no-undo .
     1382        define variable  v-recipient-code  as character                  no-undo .
     1383        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1384        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1385   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1386                           input 'Recipient':U ,
     1387                          output v-recipient-code ,
     1388                          output v-trdcattr-type ) no-error .
     1389       if error-status :error then do:
     1390        message
     1391         vss-workfile vss-revision vss-description skip
     1392         "Ошибка при вызове процедуры tdat-val":U skip
     1393         "Документ: " torgconfdoc-code skip
     1394         "Атрибут: " 'Recipient':U skip
     1395         "Значение: " v-recipient skip
     1396         trim( error-status :get-message (1) ) skip
     1397         return-value skip
     1398         view-as alert-box error.
     1399       undo, return error return-value.
     1400       end.
     1401     assign
     1402       v-recipient  = v-recipient-code
     1403       v-type-rec = substring(v-recipient-code,1,3)
     1404       v-code-rec  = int(substring(v-recipient-code,4,15))
     1405       no-error
     1406     .
     1407     if v-type-rec = ? then v-type-rec = "" .
     1408     if v-code-rec  = ? then v-code-rec  =  0 .
     1409     end procedure.
     1410   procedure torgconf-get-wthrecepient-param :
     1411   define input parameter torgconfdoc-code   as character                  no-undo.
     1412   define output parameter v-code-rec        as integer                    no-undo .
     1413   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1414   define output parameter v-codefirm-rec    as integer                    no-undo .
     1415   define output parameter v-curcode-rec     as integer                    no-undo .
     1416        define variable  v-recipient-code  as character                  no-undo .
     1417        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1418        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1419   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input torgconfdoc-code ,
     1420                           input 'wthconsignee':U ,
