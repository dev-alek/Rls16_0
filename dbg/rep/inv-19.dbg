     1079       .
     1080   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1081   empty temp-table thbjattr_thbj-attr.
     1082   run adm/shattri.p (
     1083      input "get":U
     1084     ,input ''
     1085     ,input 0
     1086     ,input 'prt-glob':U
     1087     ,input  ""
     1088     ,output v-value-character
