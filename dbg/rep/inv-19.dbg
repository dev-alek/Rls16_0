     3365                where buf_clients.obj-type = 'орг':U
     3366                and buf_clients.obj-code = v-host-code
     3367            .
     3368            find first buf_firm no-lock
     3369                where buf_firm.firm-code = buf_clients.obj-code
     3370            .
     3371            assign
     3372                v-torgconf-ogr-name = buf_firm.director
     3373            .
     3374         end.
     3375         if v-torgconf-outogr = "dir_obj"
     3376            then do:
     3377            find first buf_trn-doc no-lock
     3378            where buf_trn-doc.doc-code = p-doc-code
     3379            no-error.
     3380               CASE buf_trn-doc.obj-type:
     3381               WHEN 'маг':U
     3382               THEN DO:
     3383                  find first buf_shop no-lock
     3384                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3385                  .
     3386                  assign
     3387                     v-torgconf-ogr-name = buf_shop.director
     3388                     v-torgconf-ogr-post = "Директор"
     3389                  .
     3390               END.
     3391               WHEN 'скл':U
     3392               THEN DO:
     3393                  find first buf_store no-lock
     3394                  where buf_store.obj-code = buf_trn-doc.obj-code
     3395                  .
     3396                  assign
     3397                     v-torgconf-ogr-name = buf_store.store-boss
     3398                     v-torgconf-ogr-post = "Директор"
     3399                  .
     3400               END.
     3401               OTHERWISE DO:
     3402                  assign
     3403                     v-torgconf-ogr-name = "":U
     3404                     v-torgconf-ogr-post = "":U
     3405                  .
     3406               END.
     3407               END CASE.
     3408            end.
     3409      if v-torgconf-outogr = "manag_doc"
     3410         then do:
     3411            find first buf_trn-doc no-lock
     3412            where buf_trn-doc.doc-code = p-doc-code
     3413            no-error.
     3414            if available buf_trn-doc
