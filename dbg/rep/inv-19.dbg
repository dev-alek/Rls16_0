     3500               where buf_person.psn-code = buf_wth-doc.deliver
     3501               no-error.
     3502               if available buf_person
     3503               then do:
     3504                  v-torgconf-ogr-post = buf_person.position.
     3505               end.
     3506               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3507               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3508            end.
     3509      end.
     3510   end.
     3511   end procedure.
     3512   procedure torgconf-get-outogr-param:
     3513       define input parameter p-form-name  as character    no-undo.
     3514       define input parameter p-host-code  as integer      no-undo.
     3515       define input parameter p-obj-type   as character    no-undo.
     3516       define input parameter p-obj-code   as integer      no-undo.
     3517       define input parameter p-doc-code   as character      no-undo.
     3518       define buffer buf_firm          for ub.firm .
     3519       define buffer buf_clients       for ub.clients .
     3520       define buffer buf_sysconf       for ub.sysconf .
     3521       define buffer buf_shop          for ub.shop .
     3522       define buffer buf_store         for ub.store .
     3523       define buffer buf_person        for ub.person .
     3524       define buffer buf_trn-doc       for ub.trn-doc .
     3525       define buffer buf_wth-doc       for ub.wth-doc .
     3526      if  p-form-name <> 'wthtrg12':U
     3527      and p-form-name <> 'wthfct':U
     3528      and p-form-name <> 'wthm11':U
     3529      then do:
     3530       find first buf_trn-doc no-lock
     3531       where buf_trn-doc.doc-code = p-doc-code
     3532       no-error.
     3533       if v-torgconf-outogr = "no_print"
     3534         then do:
     3535            assign
     3536               v-torgconf-ogr-name = ""
     3537               v-torgconf-ogr-post = ""
     3538            .
     3539         end.
     3540      if v-torgconf-outogr  = "ruk_firm"
     3541            then do:
     3542            find first buf_sysconf no-lock
     3543            where buf_sysconf.host-code = p-host-code
     3544            no-error.
     3545            if available buf_sysconf
     3546            then do:
     3547               assign
     3548                  v-torgconf-ogr-post = buf_sysconf.head-position
     3549               .
     3550            end.
     3551            find first buf_clients no-lock
     3552                where buf_clients.obj-type = 'орг':U
     3553                and buf_clients.obj-code = p-host-code
     3554            .
     3555            find first buf_firm no-lock
     3556                where buf_firm.firm-code = buf_clients.obj-code
     3557            .
     3558            assign
     3559                v-torgconf-ogr-name = buf_firm.director
     3560            .
     3561         end.
     3562         if v-torgconf-outogr = "dir_obj"
     3563            then do:
     3564            find first buf_trn-doc no-lock
     3565            where buf_trn-doc.doc-code = p-doc-code
     3566            no-error.
     3567               CASE buf_trn-doc.obj-type:
     3568               WHEN 'маг':U
     3569               THEN DO:
     3570                  find first buf_shop no-lock
     3571                  where buf_shop.obj-code = buf_trn-doc.obj-code
     3572                  .
     3573                  assign
     3574                     v-torgconf-ogr-name = buf_shop.director
     3575                     v-torgconf-ogr-post = "Директор"
     3576                  .
     3577               END.
     3578               WHEN 'скл':U
     3579               THEN DO:
     3580                  find first buf_store no-lock
     3581                  where buf_store.obj-code = buf_trn-doc.obj-code
     3582                  .
     3583                  assign
     3584                     v-torgconf-ogr-name = buf_store.store-boss
     3585                     v-torgconf-ogr-post = "Директор"
     3586                  .
     3587               END.
     3588               OTHERWISE DO:
     3589                  assign
     3590                     v-torgconf-ogr-name = "":U
     3591                     v-torgconf-ogr-post = "":U
     3592                  .
     3593               END.
     3594               END CASE.
     3595            end.
     3596      if v-torgconf-outogr = "manag_doc"
     3597         then do:
     3598            find first buf_trn-doc no-lock
     3599            where buf_trn-doc.doc-code = p-doc-code
     3600            no-error.
     3601            if available buf_trn-doc
     3602            then do:
     3603               run rep/get-psn.p
     3604               (input buf_trn-doc.boss
     3605               ,output v-torgconf-ogr-name
     3606               ) .
     3607            end.
     3608            find first buf_person no-lock
     3609            where buf_person.psn-code = buf_trn-doc.boss
     3610            no-error.
     3611            if available buf_person
     3612            then do:
     3613               v-torgconf-ogr-post = buf_person.position.
     3614            end.
     3615            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3616            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3617         end.
     3618      end.
     3619      else do:
     3620      find first buf_wth-doc no-lock
     3621         where buf_wth-doc.doc-code = p-doc-code
     3622         no-error.
     3623         if v-torgconf-outogr = "no_print"
     3624            then do:
     3625               assign
     3626                  v-torgconf-ogr-name = ""
     3627                  v-torgconf-ogr-post = ""
     3628               .
     3629            end.
     3630         if v-torgconf-outogr  = "ruk_firm"
     3631               then do:
     3632               find first buf_sysconf no-lock
     3633               where buf_sysconf.host-code = p-host-code
     3634               no-error.
     3635               if available buf_sysconf
     3636               then do:
     3637                  assign
     3638                     v-torgconf-ogr-post = buf_sysconf.head-position
     3639                  .
     3640               end.
     3641               find first buf_clients no-lock
     3642                  where buf_clients.obj-type = 'орг':U
     3643                  and buf_clients.obj-code = p-host-code
     3644               .
     3645               find first buf_firm no-lock
     3646                  where buf_firm.firm-code = buf_clients.obj-code
     3647               .
     3648               assign
     3649                  v-torgconf-ogr-name = buf_firm.director
     3650               .
     3651            end.
     3652            if v-torgconf-outogr = "dir_obj"
     3653               then do:
     3654               find first buf_wth-doc no-lock
     3655               where buf_wth-doc.doc-code = p-doc-code
     3656               no-error.
     3657                  find first buf_shop no-lock
     3658                  where buf_shop.obj-code = buf_wth-doc.obj-code
     3659                  .
     3660                  assign
     3661                     v-torgconf-ogr-name = buf_shop.director
     3662                     v-torgconf-ogr-post = "Директор"
     3663                  .
     3664               end.
     3665         if v-torgconf-outogr = "manag_doc"
     3666            then do:
     3667               find first buf_wth-doc no-lock
     3668               where buf_wth-doc.doc-code = p-doc-code
     3669               no-error.
     3670               if available buf_wth-doc
     3671               then do:
     3672                  run rep/get-psn.p
     3673                  (input buf_wth-doc.deliver
     3674                  ,output v-torgconf-ogr-name
     3675                  ) .
     3676               end.
     3677               find first buf_person no-lock
     3678               where buf_person.psn-code = buf_wth-doc.deliver
     3679               no-error.
     3680               if available buf_person
     3681               then do:
     3682                  v-torgconf-ogr-post = buf_person.position.
     3683               end.
     3684               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     3685               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     3686            end.
     3687      end.
     3688   end.
     3689   procedure torgconf-get-reason  :
     3690   define input parameter  p-doc-code       as character        no-undo.
     3691   define input parameter  p-reason-code    as integer          no-undo .
     3692   define input parameter  p-doc-type       as character        no-undo.
     3693       if p-reason-code > 0
     3694       then do:
     3695           define buffer buf_trn-reason for ub.trn-reason.
     3696           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3697           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3698       end.
     3699       else do:
     3700           if p-doc-type = 'при':U
     3701           then  do:
     3702               define variable v-attr-type     as character    no-undo.
     3703               define variable v-attr-value    as character    no-undo.
     3704               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3705               assign v-torgconf-reason = v-attr-value .
     3706               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3707               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3708           end.
     3709       end.
     3710   end procedure.
     3711   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3712   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3713   procedure paramls-clear :
     3714     define buffer buf_temp-param for temp-param .
     3715     do
     3716     on error undo, return error return-value
     3717     :
     3718       for each buf_temp-param
     3719       on error undo, return error
     3720       :
     3721         delete buf_temp-param .
     3722       end.
     3723     end.
     3724   end procedure.
     3725   procedure paramls-write :
     3726     define input  parameter p-code     as character no-undo .
     3727     define input  parameter p-sub-code as character no-undo .
     3728     define input  parameter p-value    as character no-undo .
     3729     define buffer buf_temp-param for temp-param .
     3730     do
     3731     on error undo, return error return-value
     3732     :
     3733       find first buf_temp-param
     3734         where buf_temp-param.param-code     = p-code
     3735           and buf_temp-param.param-sub-code = p-sub-code
     3736         no-error .
     3737       if not available buf_temp-param then do:
     3738         create buf_temp-param .
     3739         assign
     3740           buf_temp-param.param-code     = p-code
     3741           buf_temp-param.param-sub-code = p-sub-code
     3742         .
     3743       end.
     3744       assign
     3745         buf_temp-param.param-value = p-value
     3746       .
     3747     end.
     3748   end procedure.
     3749   procedure paramls-read :
     3750     define input  parameter p-code          as character no-undo .
     3751     define input  parameter p-sub-code      as character no-undo .
     3752     define input  parameter p-default-value as character no-undo .
     3753     define output parameter p-value         as character no-undo .
     3754     define buffer buf_temp-param for temp-param .
     3755     do
     3756     on error undo, return error return-value
     3757     :
     3758       find first buf_temp-param
     3759         where buf_temp-param.param-code     = p-code
     3760           and buf_temp-param.param-sub-code = p-sub-code
     3761         no-error .
     3762       if available buf_temp-param then do:
     3763         assign
     3764           p-value = buf_temp-param.param-value
     3765         .
     3766       end.
     3767       else do:
     3768         assign
     3769           p-value = p-default-value
     3770         .
     3771       end.
     3772     end.
     3773   end procedure.
     3774   procedure paramls-append :
     3775     define input  parameter p-code     as character no-undo .
     3776     define input  parameter p-sub-code as character no-undo .
     3777     define input  parameter p-value    as character no-undo .
     3778     define buffer buf_temp-param for temp-param .
     3779     do
     3780     on error undo, return error return-value
     3781     :
     3782       find first buf_temp-param
     3783            where buf_temp-param.param-code     = p-code
     3784              and buf_temp-param.param-sub-code = p-sub-code
     3785         no-error .
     3786       if not available buf_temp-param then do:
     3787         create buf_temp-param .
     3788         assign
     3789           buf_temp-param.param-code     = p-code
     3790           buf_temp-param.param-sub-code = p-sub-code
     3791           buf_temp-param.param-value    = p-value
     3792         .
     3793       end.
     3794       else do:
     3795           assign
     3796               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     3797           .
     3798       end.
     3799     end.
     3800   end procedure.
     3801   define variable v-sys-key           as character    no-undo.
     3802   define variable vss-include-info15 as character format "X(65)" no-undo
     3803   initial "@(#)$Workfile$ $Revision$".
