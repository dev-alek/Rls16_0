     1222               .
     1223           end.
     1224           if lookup( p-form-name, v-outhold  ) <> 0
     1225           then do:
     1226               assign
     1227                   v-torgconf-outhold   = yes
     1228               .
     1229           end.
     1230           if lookup( p-form-name, v-outobj   ) <> 0
     1231           then do:
     1232               assign
     1233                   v-torgconf-outobj    = yes
     1234               .
     1235           end.
     1236           if lookup( p-form-name, v-outsend   ) <> 0
     1237           then do:
     1238               assign
     1239                   v-torgconf-outsend    = yes
     1240               .
     1241           end.
     1242           if lookup( p-form-name, v-outasend   ) <> 0
     1243           then do:
     1244               assign
     1245                   v-torgconf-outasend    = yes
     1246               .
     1247           end.
     1248           if lookup( p-form-name, v-outprops   ) <> 0
     1249           then do:
     1250               assign
