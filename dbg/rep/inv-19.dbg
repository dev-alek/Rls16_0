     3844   define variable v-inv19xl-sheet1-cur-data-row     as integer      no-undo.
     3845   define variable v-inv19xl-cell-file-name       as character    no-undo.
     3846   define variable v-inv19xl-data-file-name       as character    no-undo.
     3847   procedure inv19xl-init :
     3848   do
     3849   on error undo, return error
     3850   :
     3851       assign
     3852           v-inv19xl-sheet1-cur-data-row = 0
     3853       .
     3854       run gbl/_tmpfile.p (
     3855             input "xd"
     3856           , input ".txt"
     3857           , output v-inv19xl-data-file-name
     3858       ).
     3859       output stream excel-line to value( v-inv19xl-data-file-name ).
     3860       run gbl/_tmpfile.p (
     3861             input "xc"
     3862           , input ".txt"
     3863           , output v-inv19xl-cell-file-name
     3864       ).
     3865       output stream excel-cell to value( v-inv19xl-cell-file-name ).
     3866       run inv19xl-write-cell-data in this-procedure (
     3867             input "sheetList":U
     3868           , input "ИНВ19":U
     3869       ).
     3870       if printrubl
     3871       then do:
     3872           run inv19xl-write-cell-data in this-procedure (
     3873                 input "ИНВ19_valutCode":U
     3874               , input "0":U
     3875           ).
     3876       end.
     3877       else do:
     3878           run inv19xl-write-cell-data in this-procedure (
     3879                 input "ИНВ19_valutCode":U
     3880               , input "1":U
     3881           ).
     3882       end.
     3883       if p-mode = "OKDP"
     3884       then do :
     3885         run inv19xl-write-cell-data in this-procedure (
     3886               input "ИНВ19_columnList":U
     3887             , input "num,gdsname,gdscode,OKEI,EI,OKDP,rezIzlQnty,rezIzlSum,rezNedQnty,rezNedSum,num2,utochIzlQnty,utochIzlSum,utochNedQnty,utochNedSum,peresIzlQnty,peresIzlSum,peresNedQnty,peresNedSum,endIzlQnty,endIzlSum,endNedQnty1,endNedSum1,endNedQnty2,endNedSum2,endNedQnty3,endNedSum3":U
     3888         ).
     3889         run inv19xl-write-cell-data in this-procedure (
     3890               input "ИНВ19_columnType":U
     3891             , input "I,S,S,S,S,S,C,C,C,C,I":U + fill( ",C,C":U, 8)
     3892         ).
     3893       end.
     3894       else do :
     3895       run inv19xl-write-cell-data in this-procedure (
     3896             input "ИНВ19_columnList":U
     3897           , input "num,gdsname,gdscode,OKEI,EI,rezIzlQnty,rezIzlSum,rezNedQnty,rezNedSum,num2,utochIzlQnty,utochIzlSum,utochNedQnty,utochNedSum,peresIzlQnty,peresIzlSum,peresNedQnty,peresNedSum,endIzlQnty,endIzlSum,endNedQnty1,endNedSum1,endNedQnty2,endNedSum2,endNedQnty3,endNedSum3":U
     3898       ).
     3899       run inv19xl-write-cell-data in this-procedure (
     3900             input "ИНВ19_columnType":U
     3901           , input "I,S,S,S,S,C,C,C,C,I":U + fill( ",C,C":U, 8)
     3902       ).
     3903       end.
     3904       if lookup( 'L-Rus' , v-sys-key) > 0
     3905       then do:
     3906         run inv19xl-write-cell-data in this-procedure (
     3907               input "ИНВ19_subtotalList":U
     3908             , input "rezIzlQnty,rezIzlSum,rezNedQnty,rezNedSum,utochIzlQnty,utochIzlSum,utochNedQnty,utochNedSum,peresIzlQnty,peresIzlSum,peresNedQnty,peresNedSum,endIzlQnty,endIzlSum,endNedQnty1,endNedSum1,endNedQnty2,endNedSum2,endNedQnty3,endNedSum3":U
     3909         ).
     3910         run inv19xl-write-cell-data in this-procedure (
     3911               input "ИНВ19_subtotalType":U
     3912             , input "S":U + fill(",S":U, 19)
     3913         ).
     3914       end.
     3915       else do:
     3916         run inv19xl-write-cell-data in this-procedure (
     3917               input "ИНВ19_subtotalList":U
     3918             , input "rezIzlQnty,rezIzlSum,rezNedQnty,rezNedSum":U
     3919         ).
     3920         run inv19xl-write-cell-data in this-procedure (
     3921               input "ИНВ19_subtotalType":U
     3922             , input "S":U + fill(",S":U, 3)
     3923         ).
     3924       end.
     3925   end.
     3926   end procedure.
     3927   procedure inv19xl-sheet1-write-line-data :
