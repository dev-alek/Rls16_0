     3185               assign
     3186                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3187                                                           v-torgconf-doc-code,
     3188                                                           v-torgconf-doc-date,
     3189                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3190                                                           )
     3191               .
     3192            end.
     3193            else do:
     3194               assign
     3195                  v-torgconf-plat-rasch-doc = v-attr.
     3196            end.
     3197            end.
     3198        end.
     3199        otherwise do:
     3200            if  v-name <> 'wthtrg12'
     3201            and v-name <> 'wthfct'
     3202            and v-name <> 'wthm11'
     3203            then do:
     3204               IF v-dcode-attr <> "":U
     3205               OR v-ddate-attr <> "":U
     3206               THEN
     3207               assign
     3208                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3209                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3210                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3211                                                   )
     3212               .
     3213            end.
     3214            else do:
     3215               assign
     3216                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3217               .
     3218            end.
     3219        end.
     3220       end case.
     3221      if v-torgconf-outB = "no_print"
     3222      then do:
     3223         assign v-torgconf-main-buh = "".
     3224      end.
     3225      if v-torgconf-outB = "glbuh_firm"
     3226      then do:
     3227            if v-torgconf-self-host-code = 0
     3228            then do:
     3229            end.
     3230            else do:
     3231               find first buf_sysconf no-lock
     3232                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3233               .
     3234               assign
     3235                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3236               .
     3237            end.
     3238      end.
     3239      if v-torgconf-outB = "buh_obj"
     3240      then do:
     3241         CASE v-torgconf-self-obj-type:
     3242         WHEN 'маг':U
     3243         THEN DO:
     3244            find first buf_shop no-lock
     3245            where buf_shop.obj-code = v-torgconf-self-obj-code
     3246            .
     3247            assign
     3248               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     3249            .
     3250         END.
     3251         WHEN 'скл':U
     3252         THEN DO:
     3253            find first buf_store no-lock
     3254            where buf_store.obj-code = v-torgconf-self-obj-code
     3255            .
     3256            assign
     3257               v-torgconf-main-buh  = buf_store.store-man
     3258            .
     3259         END.
     3260         OTHERWISE DO:
     3261            assign
     3262               v-torgconf-main-buh  = "":U
     3263            .
     3264         END.
     3265         END CASE.
     3266      end.
     3267      if v-torgconf-outR = "no_print"
     3268         then do:
     3269            assign
     3270               v-torgconf-main-boss = ""
     3271               v-torgconf-main-boss-post = ""
     3272            .
     3273         end.
     3274      if v-torgconf-outR = "ruk_firm"
     3275         then do:
     3276            find first buf_sysconf no-lock
     3277            where buf_sysconf.host-code = v-torgconf-self-host-code
     3278            no-error.
     3279            if available buf_sysconf
     3280            then do:
     3281               assign
     3282                  v-torgconf-main-boss-post = buf_sysconf.head-position
     3283               .
     3284            end.
     3285            find first buf_clients no-lock
     3286            where buf_clients.obj-type = 'орг':U
     3287            and buf_clients.obj-code = v-torgconf-self-host-code
     3288            .
     3289            find first buf_firm no-lock
     3290            where buf_firm.firm-code = buf_clients.obj-code
     3291            no-error.
     3292            if available buf_firm
     3293            then do:
     3294               assign
     3295                  v-torgconf-main-boss = buf_firm.director
     3296               .
     3297            end.
     3298         end.
     3299      if v-torgconf-outR = "dir_obj"
