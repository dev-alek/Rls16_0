     3246               Assign
     3247                   s-bar-code    = ""
     3248                   gds-zap-artic = "        Итого по "
     3249                   gds-zap-gds-name = b1-name
     3250                   .
     3251                 run display-b1.
     3252                 run clear-b1  .
     3253             end.
     3254             Assign
     3255               first-l33 = false
     3256               break_group = true
     3257               break_group1 = true
     3258               .
     3259             end.
     3260         first-l33 = false .
     3261         run item-goods ( "6" , "gds-list" ) .
     3262         last-vat = func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code) .
     3263      end.
     3264       Assign
     3265           s-bar-code   = ""
     3266           gds-zap-artic = "        Итого по "
     3267           gds-zap-gds-name = b1-name
     3268           .
     3269         run display-b1.
     3270         run clear-b1.
     3271   end.
     3272   else do:
     3273      For each obj-list no-lock :
     3274                     FOR EACH gds-obj where
     3275                         gds-obj.obj-type = obj-list.obj-type    and
     3276                         gds-obj.obj-code = obj-list.obj-code
     3277                         and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3278                         no-lock,
     3279                   First gds-list  where gds-obj.gds-code  = gds-list.gds-code
     3280                         no-lock :
     3281                         find first temp-gds-list where temp-gds-list.gds-code = gds-obj.gds-code no-error .
     3282                         if not available temp-gds-list then do:
     3283                             find first goods no-lock  where goods.gds-code  = gds-obj.gds-code .
     3284                             Create temp-gds-list.
     3285   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
