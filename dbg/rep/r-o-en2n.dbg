     3511   PROCEDURE Display-title :
     3512      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     3513             REPORTNAME  AT 20 format "X(170)" SKIP
     3514             Trim(str1)  AT 35 format "X(75)" SKIP.
     3515        Repeat i = 1 to NUM-ENTRIES(str2,chr(10)) :
     3516         PUT stream  OutStream  UNFORMATTED  Entry(i,str2,chr(10))  AT 1 format "X(170)" SKIP.
     3517        End.
     3518       i=0.
     3519        Repeat i = 1 to NUM-ENTRIES(str3,chr(10)) :
     3520         PUT stream  OutStream  UNFORMATTED  Entry(i,str3,chr(10))  AT 1 format "X(170)" SKIP.
     3521        End.
     3522       i=0.
     3523        Repeat i = 1 to NUM-ENTRIES(str4,chr(10)) :
     3524         PUT stream  OutStream  UNFORMATTED  Entry(i,str4,chr(10))  AT 1 format "X(170)" SKIP.
     3525        End.
     3526       i=0.
     3527        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     3528         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     3529        End.
     3530       i=0.
     3531   END PROCEDURE.
     3532   PROCEDURE ob-line  :
     3533   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3534   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3535   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     3536   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3537   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3538   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     3539   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     3540   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3541   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3542   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3543   define input  parameter xTog-obj         as   log                  no-undo.
     3544   define variable  tt#          as   int                 no-undo.
     3545    if x-sum-type = 'cost':U  OR x-sum-type = 'cssr':U  then tt# = 1.
     3546     if x-sum-type = 'crsa':U  OR x-sum-type = 'cgsr':U  then tt# = 2.
     3547     if x-sum-type = 'sale':U  OR x-sum-type = 'sasr':U  then tt# = 3.
     3548     For EAch obj-list no-lock:
     3549      if  xTog-obj THEN
     3550          if   NOT(    x-store-type     = obj-list.obj-type
     3551               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     3552        IF x-ext-doc-type = 'rs':U + ',' + 'es':U  Then DO:
     3553          FOR each ub.ot-line where
     3554                           ub.ot-line.artic         = x-artic
     3555                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3556                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3557                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3558                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3559                     AND   ub.ot-line.prod-code    = x-prod-code
     3560                     AND   ub.ot-line.prod-type    = x-prod-type
     3561                     AND   ub.ot-line.sum-type     = x-sum-type
     3562                     And   (ot-line.ext-doc-type = 'rs':U
     3563                            OR ub.ot-line.ext-doc-type = 'es':U)
     3564                       no-lock :
     3565              If tPrintRubl = yes Then
     3566              ASSIGN qnty       [tt#]     = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3567                     Summ     [tt#]     = Summ      [tt#]      +  ub.ot-line.sum-rubl
     3568                     Vat      [tt#]     = Vat       [tt#]      +  ub.ot-line.VAT-rubl
     3569                     excise   [tt#]     = excise    [tt#]      +  ub.ot-line.excise-rubl
     3570                     road-tax [tt#]     = road-tax  [tt#]      +  ub.ot-line.road-tax-rubl
     3571                     transport[tt#]     = transport [tt#]      +  ub.ot-line.transport-rubl
     3572                     Other    [tt#]     = Other     [tt#]      +  ub.ot-line.Other-rubl           .
     3573              Else
     3574              ASSIGN qnty       [tt#]     = qnty       [tt#]      +  ub.ot-line.fact-qnty
     3575                     Summ      [tt#]     = Summ        [tt#]    +  ub.ot-line.sum-base
     3576                     Vat       [tt#]     = Vat         [tt#]    +  ub.ot-line.VAT-base
     3577                     excise    [tt#]     = excise      [tt#]    +  ub.ot-line.excise-base
     3578                     road-tax  [tt#]     = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3579                     transport [tt#]     = transport   [tt#]    +  ub.ot-line.transport-base
     3580                     Other     [tt#]     = Other       [tt#]    +  ub.ot-line.Other-base           .
     3581           End.
     3582        End.
     3583        Else DO:
     3584          FOR each ub.ot-line where
     3585                           ub.ot-line.artic         = x-artic
     3586                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     3587                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     3588                     AND   ub.ot-line.obj-code     = obj-list.obj-code
     3589                     AND   ub.ot-line.obj-type     = obj-list.obj-type
     3590                     AND   ub.ot-line.prod-code    = x-prod-code
     3591                     AND   ub.ot-line.prod-type    = x-prod-type
     3592                     AND   ub.ot-line.sum-type     = x-sum-type
     3593                     And   ub.ot-line.ext-doc-type = x-ext-doc-type
     3594                       no-lock :
     3595              If tPrintRubl = yes Then
     3596              ASSIGN qnty  [tt#]          = qnty    [tt#]         +  ub.ot-line.fact-qnty
     3597                     Summ       [tt#]    = Summ       [tt#]     +  ub.ot-line.sum-rubl
     3598                     Vat        [tt#]    = Vat        [tt#]     +  ub.ot-line.VAT-rubl
     3599                     excise     [tt#]    = excise     [tt#]     +  ub.ot-line.excise-rubl
     3600                     road-tax   [tt#]    = road-tax   [tt#]     +  ub.ot-line.road-tax-rubl
     3601                     transport  [tt#]    = transport  [tt#]     +  ub.ot-line.transport-rubl
     3602                     Other      [tt#]    = Other      [tt#]     +  ub.ot-line.Other-rubl           .
     3603              Else
     3604              ASSIGN qnty    [tt#]        = qnty     [tt#]        +  ub.ot-line.fact-qnty
     3605                     Summ       [tt#]    = Summ        [tt#]    +  ub.ot-line.sum-base
     3606                     Vat        [tt#]    = Vat         [tt#]    +  ub.ot-line.VAT-base
     3607                     excise     [tt#]    = excise      [tt#]    +  ub.ot-line.excise-base
     3608                     road-tax   [tt#]    = road-tax    [tt#]    +  ub.ot-line.road-tax-base
     3609                     transport  [tt#]    = transport   [tt#]    +  ub.ot-line.transport-base
     3610                     Other      [tt#]    = Other       [tt#]    +  ub.ot-line.Other-base           .
     3611           End.
     3612         End.
     3613     END.
     3614   END PROCEDURE.
     3615   PROCEDURE ostatok :
     3616   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     3617   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     3618   def input parameter x-tog-shift   as   logical             no-undo.
     3619   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     3620   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     3621   def input parameter x-shift-start as integer               no-undo.
     3622   def input parameter x-shift-end   as integer               no-undo.
     3623   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     3624   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     3625   def input parameter xTog-obj   as log no-undo.
     3626   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     3627   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3628   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3629   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3630   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3631   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3632   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3633   def var              Fact-orderS   as char  no-undo.
     3634   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3635      Assign
     3636         Fact-order   = 0
     3637         Quantity     = 0
     3638         Coast_R      = 0
     3639         Coast_V      = 0
     3640         VAT_R        = 0
     3641         VAT_V        = 0 .
     3642    x-date-start-t  = x-date-start + 1 .
     3643   IF x-date-end = date('') then DO:
     3644      Fact-order = 0 .
     3645      for each obj-list
     3646          where  ( not xtog-obj or
     3647                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3648                 no-lock :
     3649         if  x-tog-shift = false then do:
     3650                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3651                               ub.stk-tot.Fact-date <=  x-date-start
     3652                               and ub.stk-tot.shift-num = 0
     3653                               USE-INDEX fact-date no-lock no-error .
     3654              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3655         End.
     3656         Else  DO :
     3657             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3658              (ub.stk-tot.shift-date  = x-date-start-t and
     3659               ub.stk-tot.shift-num  < x-shift-start or
     3660               ub.stk-tot.shift-date  < x-date-start-t  )
     3661               and ub.stk-tot.shift-num  > 0
     3662               USE-INDEX Shift-num no-lock no-error .
     3663            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3664           END.
     3665       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3666     End.
     3667   End.
     3668   Else DO:
     3669     For each obj-list  WHERE
     3670        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3671         no-lock :
     3672      IF  x-TOG-Shift = False Then DO:
     3673          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3674               ub.stk-tot.Fact-date <= x-date-end
     3675               and ub.stk-tot.shift-num = 0
     3676               USE-INDEX fact-date no-lock no-error.
     3677          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3678      END.
     3679      Else DO:
     3680           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3681               (ub.stk-tot.shift-date  = x-date-end and
     3682               ub.stk-tot.shift-num  <= x-shift-end or
     3683               ub.stk-tot.shift-date  < x-date-end       ) and
     3684               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3685               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3686       End.
     3687       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3688     End.
     3689   End.
     3690   END PROCEDURE.
     3691     PROCEDURE Calc-Sub-itog :
     3692     define input parameter tt#          as   int                 no-undo.
     3693     Assign
     3694     B1-qnty     [tt#] = B1-qnty       [tt#] + qnty            [tt#]
     3695     B1-Summ     [tt#]  = B1-Summ     [tt#]    + Summ          [tt#]
     3696     B1-Vat      [tt#]  = B1-Vat      [tt#]    + Vat           [tt#]
     3697     B1-excise   [tt#]  = B1-excise   [tt#]    + excise        [tt#]
     3698     B1-road-tax [tt#]  = B1-road-tax [tt#]    + road-tax      [tt#]
     3699     B1-transport[tt#]  = B1-transport[tt#]    + transport     [tt#]
     3700     B1-Other    [tt#]  = B1-Other    [tt#]    + Other         [tt#]
     3701     B2-qnty     [tt#]   = B2-qnty      [tt#]  + qnty        [tt#]
     3702     B2-Summ     [tt#]  = B2-Summ       [tt#]  + Summ       [tt#]
     3703     B2-Vat      [tt#]  = B2-Vat        [tt#]  + Vat        [tt#]
     3704     B2-excise   [tt#]  = B2-excise     [tt#]  + excise     [tt#]
     3705     B2-road-tax [tt#]  = B2-road-tax   [tt#]  + road-tax   [tt#]
     3706     B2-transport[tt#]  = B2-transport  [tt#]  + transport  [tt#]
     3707     B2-Other    [tt#]  = B2-Other      [tt#]  + Other      [tt#]
     3708     Bi-qnty     [tt#]  = Bi-qnty      [tt#]   + qnty     [tt#]
     3709     Bi-Summ     [tt#]  = Bi-Summ      [tt#]   + Summ     [tt#]
     3710     Bi-Vat      [tt#]  = Bi-Vat       [tt#]   + Vat      [tt#]
     3711     Bi-excise   [tt#]  = Bi-excise    [tt#]   + excise   [tt#]
     3712     Bi-road-tax [tt#]  = Bi-road-tax  [tt#]   + road-tax [tt#]
     3713     Bi-transport[tt#]  = Bi-transport [tt#]   + transport[tt#]
     3714     Bi-Other    [tt#]  = Bi-Other     [tt#]   + Other    [tt#]    .
     3715   END PROCEDURE.
     3716   PROCEDURE Clear-item :
     3717    define input parameter tt#          as   int                 no-undo.
     3718    Assign
     3719     Qnty      [tt#]   = 0
     3720     Summ      [tt#]  = 0
     3721     Vat       [tt#]  = 0
     3722     eff       [tt#]  = 0
     3723     Excise    [tt#]  = 0
     3724     Road-tax  [tt#]  = 0
     3725     Transport [tt#]  = 0
     3726     Other     [tt#]  = 0 .
     3727    END PROCEDURE.
     3728   PROCEDURE Item-Goods :
     3729    define input parameter  par-3 as char no-undo.
     3730    define input parameter  par-4 as char no-undo.
     3731    define variable v-vat-pc        like ub.doc-line.vat-pc    no-undo.
     3732    define variable v-host-code     like ub.sysconf.host-code  no-undo.
     3733    define variable v-gds-code      like ub.goods.gds-code     no-undo.
     3734        if par-4 = "goods":U  Then DO:
     3735             FIND FIRST clients WHERE clients.obj-type = Goods.prod-type AND
     3736                                 clients.obj-code = Goods.prod-code use-index pi NO-LOCK .
     3737                                   assign
     3738                                       gds-zap-unit-base  = Goods.unit-base
     3739                                       gds-zap-prt-root   = Goods.prt-root
     3740                                       gds-zap-prod-type  = Goods.prod-type
     3741                                       gds-zap-prod-code  = Goods.prod-code
     3742                                       gds-zap-artic      = Goods.artic
     3743                                       gds-zap-type       = Goods.gds-type
     3744                                       gds-zap-grp-name   = Goods.grp-name
     3745                                       gds-zap-b-code     = Goods.gds-code
     3746                                       gds-zap-prod-name  = clients.obj-name .
     3747                                   if g#gds-engl then
     3748                                       assign gds-zap-gds-name = Goods.engl-name.
     3749                                   else
     3750                                       assign gds-zap-gds-name = Goods.gds-name.
     3751                               End.
     3752        if par-4 = "gds-list":U  Then DO:
     3753             FIND FIRST clients WHERE clients.obj-type = gds-list.prod-type AND
     3754                                 clients.obj-code = gds-list.prod-code use-index pi NO-LOCK .
     3755                                   assign
     3756                                       gds-zap-unit-base  = gds-list.unit-base
     3757                                       gds-zap-prt-root   = gds-list.prt-root
     3758                                       gds-zap-prod-type  = gds-list.prod-type
     3759                                       gds-zap-prod-code  = gds-list.prod-code
     3760                                       gds-zap-type       = gds-list.gds-type
     3761                                       gds-zap-artic      = gds-list.artic
     3762                                       gds-zap-grp-name   = gds-list.grp-name
     3763                                       gds-zap-b-code     = gds-list.gds-code
     3764                                       gds-zap-prod-name  = clients.obj-name .
     3765                                   if g#gds-engl then
     3766                                       assign gds-zap-gds-name = gds-list.engl-name.
     3767                                   else
     3768                                       assign gds-zap-gds-name = gds-list.gds-name.
     3769                               End.
     3770       Run foreach .
     3771         If  break_group = true and par-3 <> "1"  then DO:
     3772                        If break_group1 = True THEN  DO:
     3773                                  if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3774                                     then temp-str = string("ГРУППА : " + gds-zap-grp-name ).
     3775                                     else temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) .
     3776                                  if par-3 = "6"  then do:
     3777                                     assign
     3778                                         v-gds-code = ( if par-4 = "gds-list" then Gds-list.gds-code
     3779                                                                              else goods.gds-code )
     3780                                     .
     3781   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3782   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3783     (input  x-store-type
     3784     ,input  x-store-code
     3785     ,output v-host-code
     3786     )  .
     3787   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3789     (input  v-gds-code
     3790     ,input  '1':U
     3791     ,input  ?
     3792     ,input  v-host-code
     3793     ,input  x-store-type
     3794     ,input  x-store-code
     3795     ,output v-vat-pc
     3796     ) no-error .
     3797                                     assign
     3798                                       temp-str = string( "СТАВКА НДС : " + string(v-vat-pc) + "%" )
     3799                                     .
     3800                                  end.
     3801                                fr0 = true .
     3802                                tmp#stroka0 = temp-str.
     3803                        End.
     3804                        IF  (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3805                            temp-str =
     3806                                ( if par-3 = "4"
     3807                                     then string("ГРУППА : " + gds-zap-grp-name )
     3808                                     else string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) ).
     3809                                 if NOT xSumsOnly THEN DO :
     3810                                 tmp#stroka = temp-str.
     3811                                 fr = true .
     3812                                 end.
     3813                                 break_group1 = false.
     3814                        END.
     3815                         break_group = false.
     3816       End.
     3817             Run display-line.
     3818    END PROCEDURE.
     3819   PROCEDURE Di :
     3820   define input parameter tt# as int no-undo.
     3821   define input parameter p1 as char no-undo.
     3822   define input parameter p2 as int no-undo.
     3823   define input parameter p3 as char no-undo.
     3824   define input parameter p4 as char no-undo.
     3825   define input parameter p5 as char no-undo.
     3826   define input parameter p6 as char no-undo.
     3827   define input parameter p7 as char no-undo.
     3828    CASE CAPS(p7) :
     3829      WHEN "B1":U  Then  DO:
     3830      IF  NOT (NOT Show-Negativ  AND
     3831        (b1-qnty  [tt#]           = 0 and
     3832          b1-Summ     [tt#] = 0 and
     3833          b1-Vat      [tt#] = 0 and
     3834          b1-excise   [tt#] = 0 and
     3835          b1-road-tax [tt#] = 0 and
     3836          b1-transport[tt#] = 0 and
     3837          b1-Other    [tt#] = 0 ))  THEN DO:
     3838                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3839                   p1   @ type-Sum
     3840                   p3 @ gds-zap-b-code
     3841                   p4 @ gds-zap-artic
     3842                   p5 @ gds-zap-gds-name
     3843                   p6 @ gds-zap-unit-base
     3844                   b1-qnty      @ F-qnty
     3845                   b1-Summ     [tt#]  @ F-Summ
     3846                   b1-Vat      [tt#]  @ F-Vat
     3847                   b1-eff      [tt#] when b1-eff[tt#] <> 0  @ F-eff
     3848                   b1-excise   [tt#]  @ F-excise
     3849                   b1-road-tax [tt#]  @ F-road-tax
     3850                   b1-transport[tt#]  @ F-transport
     3851                   b1-Other    [tt#]  @ F-Other
     3852                  with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3853       End.
     3854      WHEN "B2":U  Then do:
     3855      IF  NOT (NOT Show-Negativ  AND
     3856      (b2-qnty  [tt#]           = 0 and
     3857          b2-Summ     [tt#] = 0 and
     3858          b2-Vat      [tt#] = 0 and
     3859          b2-excise   [tt#] = 0 and
     3860          b2-road-tax [tt#] = 0 and
     3861          b2-transport[tt#] = 0 and
     3862          b2-Other    [tt#] = 0 ))  THEN  DO:
     3863         DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3864                   p1 @ type-Sum
     3865                   p3 @ gds-zap-b-code
     3866                   p4 @ gds-zap-artic
     3867                   p5 @ gds-zap-gds-name
     3868                   p6 @ gds-zap-unit-base
     3869                   b2-qnty    [tt#]    @ F-qnty
     3870                   b2-Summ     [tt#]  @ F-Summ
     3871                   b2-Vat      [tt#]  @ F-Vat
     3872                   b2-eff      [tt#] when b2-eff[tt#] <> 0  @ F-eff
     3873                   b2-excise   [tt#]  @ F-excise
     3874                   b2-road-tax [tt#]  @ F-road-tax
     3875                   b2-transport[tt#]  @ F-transport
     3876                   b2-Other    [tt#]  @ F-Other
     3877                   with FRAME ZAPAS .          DOWN stream   OutStream 1 with FRAME ZAPAS. End.
     3878          End.
     3879      WHEN "BI":U Then DO:
     3880                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3881                   p1   @ type-Sum
     3882                   p3 @ gds-zap-b-code
     3883                   p4 @ gds-zap-artic
     3884                   p5 @ gds-zap-gds-name
     3885                   p6 @ gds-zap-unit-base
     3886                   bi-qnty    [tt#]    @ F-qnty
     3887                   bi-Summ     [tt#]  @ F-Summ
     3888                   bi-Vat      [tt#]  @ F-Vat
     3889                   bi-eff      [tt#] when bi-eff[tt#] <> 0 @ F-eff
     3890                   bi-excise   [tt#]  @ F-excise
     3891                   bi-road-tax [tt#]  @ F-road-tax
     3892                   bi-transport[tt#]  @ F-transport
     3893                   bi-Other    [tt#]  @ F-Other
     3894                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3895               End.
     3896      WHEN ""  Then DO:
     3897                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     3898                   p1   @ type-Sum
     3899                   p3   @ gds-zap-b-code
     3900                   p4 @ gds-zap-artic
     3901                   p5 @ gds-zap-gds-name
     3902                   p6 @ gds-zap-unit-base
     3903                   qnty     [tt#]  @ F-qnty
     3904                   Summ     [tt#]  @ F-Summ
     3905                   Vat      [tt#]  @ F-Vat
     3906                   eff      [tt#]  when eff[tt#] <> 0   @ F-eff
     3907                   excise   [tt#]  @ F-excise
     3908                   road-tax [tt#]  @ F-road-tax
     3909                   transport[tt#]  @ F-transport
     3910                   Other    [tt#]  @ F-Other
     3911                  with FRAME ZAPAS .        DOWN stream   OutStream 1 with FRAME ZAPAS.
     3912                End.
     3913      End case.
     3914    END PROCEDURE.
     3915   PROCEDURE Clear-B1  :
     3916   define variable tt#          as   int                 no-undo.
     3917   repeat tt# = 1 to 3 :
     3918    Assign
     3919       b1-qnty      = 0
     3920       b1-Summ     [tt#]    = 0
     3921       b1-Vat      [tt#]    = 0
     3922       b1-eff      [tt#]    = 0
     3923       b1-excise   [tt#]    = 0
     3924       b1-road-tax [tt#]    = 0
     3925       b1-transport[tt#]    = 0
     3926       b1-Other    [tt#]    = 0  .
     3927      End.
     3928    END PROCEDURE.
     3929   PROCEDURE Clear-B2  :
     3930   define variable tt#          as   int                 no-undo.
     3931   repeat tt# = 1 to 3 :
     3932    Assign
     3933       b2-qnty         = 0
     3934       b2-Summ        [tt#]  = 0
     3935       b2-Vat         [tt#]  = 0
     3936       b2-eff         [tt#]  = 0
     3937       b2-excise      [tt#]  = 0
     3938       b2-road-tax    [tt#]  = 0
     3939       b2-transport   [tt#]  = 0
     3940       b2-Other       [tt#]  = 0  .
     3941       End.
     3942   END PROCEDURE.
     3943   PROCEDURE Clear-Bi  :
     3944   define variable tt#          as   int                 no-undo.
     3945   repeat tt# = 1 to 3 :
     3946    Assign
     3947       bi-qnty         = 0
     3948       bi-Summ        [tt#]  = 0
     3949       bi-Vat         [tt#]  = 0
     3950       bi-eff         [tt#]  = 0
     3951       bi-excise      [tt#]  = 0
     3952       bi-road-tax    [tt#]  = 0
     3953       bi-transport   [tt#]  = 0
     3954       bi-Other       [tt#]  = 0  .
     3955       End.
     3956   END PROCEDURE.
