     3237         no-lock,
     3238         First gds-list  where gds-list.gds-code =  gds-obj.gds-code
     3239         no-lock
     3240         break by func-vat (input gds-obj.gds-code , input x-store-type, input x-store-code)
     3241               by (gds-list.gds-name)
     3242               :
     3243         var-vat-pc = func-vat ( input gds-obj.gds-code, input x-store-type, input x-store-code) .
     3244         if last-vat <> var-vat-pc then do:
