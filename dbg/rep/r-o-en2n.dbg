     3353   PROCEDURE CalcItog :
     3354       run ostatok (
     3355           input x-store-code  ,
     3356           input x-store-type  , x-TOG-Shift,
     3357           input x-date-start - 1 ,
     3358           input date('')      ,  x-Shift-Start,x-Shift-End,
     3359           input 'crsa':U   ,
     3360           input '##,##':U,
     3361           input xTog-obj ,
     3362           output  Quantity1  ,
     3363           output  Coast_R1   ,
     3364           output  Coast_V1   ,
     3365           output  VAT_R1     ,
     3366           output  VAT_V1     ,
     3367           output  Fact-order-1 ).
     3368       run ostatok (
     3369           input x-store-code  ,
     3370           input x-store-type  , x-TOG-Shift,
     3371           input x-date-start  ,
     3372           input x-date-end    , x-Shift-Start,x-Shift-End,
     3373           input 'crsa':U   ,
     3374           input '##,##':U,
     3375           input xTog-obj ,
     3376           output  Quantity1  ,
     3377           output  Coast_R1   ,
     3378           output  Coast_V1   ,
     3379           output  VAT_R1     ,
     3380           output  VAT_V1     ,
     3381           output  Fact-order-2 ).
     3382             Quantity1  = 0.
     3383             Coast_R1   = 0.
     3384             Coast_V1   = 0.
     3385             VAT_R1     = 0.
     3386             VAT_V1     = 0.
     3387   END PROCEDURE.
     3388   PROCEDURE display-str1  :
     3389   define variable jjj as integer no-undo init 0.
     3390   if show-cost and show-sale then
     3391      assign
     3392         eff[1] = Summ[3]  - Summ[1]
     3393         eff[3] = if Summ[1] <> 0 then ((Summ[3]  - Summ[1]) * 100 / Summ[1] )  else 0
     3394       .
     3395              if show-cost then DO:  Run di (1,"учет", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").  jjj = jjj + 1. End.
     3396              if show-crsa then DO:
     3397                if jjj = 0
     3398                   then   Run di (2,"прод", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3399                   Else   Run di (2,"прод", 1, "","","","","").
     3400                  jjj = jjj + 1. End.
     3401              if show-sale then DO:  if jjj = 0
     3402                 then Run di (3,"док.", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3403                 Else Run di (3,"док.", 1, "","","","","").
     3404                 jjj = jjj + 1. End.
     3405   END PROCEDURE.
     3406   PROCEDURE display-Bi  :
     3407   if show-cost and show-sale then
     3408      assign
     3409         bi-eff[1] = bi-Summ [3]  - bi-Summ  [1]
     3410         bi-eff[3] = if bi-Summ  [1] <> 0 then ((bi-Summ [3]  - bi-Summ  [1]) * 100 / bi-Summ  [1] )
     3411                                   else 0
     3412       .
     3413              if show-cost then run di(1,"учет",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3414              if show-crsa then run di(2,"прод",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3415              if show-sale then run di(3,"док.",1,  "", gds-zap-artic ,"" ,"", "BI":U).
     3416   END PROCEDURE.
     3417   PROCEDURE display-B1  :
     3418   IF  NOT (NOT Show-Negativ  AND
     3419    (
     3420   b1-qnty     [1]    = 0 and  b1-qnty     [2]    = 0 and b1-qnty     [3]    = 0  and
     3421   b1-Summ     [1]    = 0 and  b1-Summ     [2]    = 0 and  b1-Summ     [3]    = 0 and
     3422   b1-Vat      [1]    = 0 and  b1-Vat      [2]    = 0 and  b1-Vat      [3]    = 0 and
     3423   b1-excise   [1]    = 0 and  b1-excise   [2]    = 0 and  b1-excise   [3]    = 0 and
     3424   b1-road-tax [1]    = 0 and  b1-road-tax [2]    = 0 and  b1-road-tax [3]    = 0 and
     3425   b1-transport[1]    = 0 and  b1-transport[2]    = 0 and  b1-transport[3]    = 0 and
     3426   b1-Other    [1]    = 0 and  b1-Other    [2]    = 0 and  b1-Other    [3]    = 0 )) Then DO:
     3427     if Sums-Only THEN do:
     3428         if fr0 = true then do:
     3429             PUT stream  OutStream  tmp#stroka0 format "X(100)" SKIP.
     3430             if Make-Excel then  put   stream ForExcel unformatted String(tmp#stroka0) skip.
     3431             fr0 = false .
     3432           end.
     3433       end.
     3434       assign
     3435        gds-zap-artic = "Итого"
     3436        gds-zap-gds-name = temp-str
     3437       .
     3438           if show-cost and show-sale then
     3439             assign
     3440                 b1-eff[1] = b1-Summ [3]  - b1-Summ  [1]
     3441                 b1-eff[3] = if b1-Summ  [1] <> 0 then ((b1-Summ [3]  - b1-Summ  [1]) * 100 / b1-Summ  [1] )
     3442                                           else 0
     3443               .
     3444            if show-cost then  Run di(1,"учет"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3445            if show-crsa then  Run di(2,"прод"  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3446            if show-sale then  Run di(3,"док."  ,1, "", gds-zap-artic, gds-zap-gds-name ,"","B1":U).
     3447     Run u-line.
     3448     End.
     3449   END PROCEDURE.
     3450   PROCEDURE display-B2  :
     3451   IF  NOT (NOT Show-Negativ  AND
     3452     ( b2-qnty     [1]    = 0 and  b2-qnty     [2]    = 0 and  b2-qnty     [3]    = 0 and
     3453       b2-Summ     [1]    = 0 and  b2-Summ     [2]    = 0 and  b2-Summ     [3]    = 0 and
     3454       b2-Vat      [1]    = 0 and  b2-Vat      [2]    = 0 and  b2-Vat      [3]    = 0 and
     3455       b2-excise   [1]    = 0 and  b2-excise   [2]    = 0 and  b2-excise   [3]    = 0 and
     3456       b2-road-tax [1]    = 0 and  b2-road-tax [2]    = 0 and  b2-road-tax [3]    = 0 and
     3457       b2-transport[1]    = 0 and  b2-transport[2]    = 0 and  b2-transport[3]    = 0 and
     3458       b2-Other    [1]    = 0 and  b2-Other    [2]    = 0 and  b2-Other    [3]    = 0 ) )Then dO:
     3459       assign
     3460        gds-zap-artic = ""
     3461        gds-zap-gds-name = tmp#stroka0
     3462       .
     3463           if show-cost and show-sale then
     3464           assign
     3465               b2-eff[1] = b2-Summ [3]  - b2-Summ  [1]
     3466               b2-eff[3] = if b2-Summ  [1] <> 0 then ((b2-Summ [3]  - b2-Summ  [1]) * 100 / b2-Summ  [1] )
     3467                                         else 0
     3468             .
     3469          if show-cost then  Run di (1, "учет", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3470          if show-crsa then  Run di (2, "прод", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3471          if show-sale then  Run di (3, "док.", 1 ,"Итого",gds-zap-artic, gds-zap-gds-name,"", "B2":U).
     3472          Run u-line.
     3473   end.
     3474   END PROCEDURE.
     3475   PROCEDURE Clear--B1  :
     3476   define input parameter tt#          as   int                 no-undo.
     3477    Assign
     3478       b1-qnty     [tt#]   = 0
     3479       b1-Summ     [tt#]    = 0
     3480       b1-Vat      [tt#]    = 0
     3481       b1-eff      [tt#]    = 0
     3482       b1-excise   [tt#]    = 0
     3483       b1-road-tax [tt#]    = 0
     3484       b1-transport[tt#]    = 0
     3485       b1-Other    [tt#]    = 0  .
     3486    END PROCEDURE.
     3487   PROCEDURE Clear--B2  :
     3488   define input parameter tt#          as   int                 no-undo.
     3489    Assign
     3490       b2-qnty         = 0
     3491       b2-Summ        [tt#]  = 0
     3492       b2-Vat         [tt#]  = 0
     3493       b2-eff         [tt#]  = 0
     3494       b2-excise      [tt#]  = 0
     3495       b2-road-tax    [tt#]  = 0
     3496       b2-transport   [tt#]  = 0
     3497       b2-Other       [tt#]  = 0  .
     3498   END PROCEDURE.
     3499   PROCEDURE Clear--Bi  :
     3500   define input parameter tt#          as   int                 no-undo.
     3501    Assign
     3502       bi-qnty         = 0
     3503       bi-Summ        [tt#]  = 0
     3504       bi-Vat         [tt#]  = 0
     3505       bi-eff         [tt#]  = 0
     3506       bi-excise      [tt#]  = 0
     3507       bi-road-tax    [tt#]  = 0
     3508       bi-transport   [tt#]  = 0
     3509       bi-Other       [tt#]  = 0  .
