     4151       and buf_clients.obj-code = v-host-code-1
     4152   no-error .
     4153   if not available buf_clients then do:
     4154       if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input substitute("Не найдена фирма с кодом &1&2" +                                "Отчет не может быть сформирован"                                , v-host-code-1, chr(10))).    end.    else do:       run write-to-log in p-log-handle ( input substitute("Не найдена фирма с кодом &1&2" +                                "Отчет не может быть сформирован"                                , v-host-code-1, chr(10))).    end.
     4155     return error.
