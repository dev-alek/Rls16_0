     3450                                         , input "yes":U
     3451                                         ).
     3452     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     3453     if error-status :error
     3454     then do:
     3455       assign
     3456         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     3457                                                   , vss-workfile
     3458                                                   , vss-revision
     3459                                                   , vss-description
     3460                                                   , chr(10)
     3461                                                   , return-value
     3462                                                   , trim(error-status :get-message(1))
     3463                                                   , trim(error-status :get-message(2))
     3464                                                   , trim(error-status :get-message(3))
     3465                                                   )
     3466       .
     3467       return error v-err-message.
     3468     end.
     3469     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     3470     if error-status :error
     3471     then do:
     3472       assign
     3473         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     3474                                                   , v-filename
     3475                                                   , return-value
     3476                                                   , chr(10)
     3477                                                   )
     3478       .
     3479       return error v-err-message.
     3480     end.
     3481     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     3482     if error-status :error
     3483     then do:
     3484       assign
     3485         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     3486                                                   , v-filename
     3487                                                   , return-value
     3488                                                   , trim(error-status :get-message(1))
     3489                                                   , chr(10)
     3490                                                   )
     3491       .
     3492     end.
     3493     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     3494     if error-status :error
     3495     then do:
     3496       assign
     3497         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     3498                                                   , v-home-dir-filename
     3499                                                   , return-value
     3500                                                   , chr(10)
     3501                                                   )
     3502       .
     3503       return error v-err-message.
     3504     end.
     3505     run gbl/ren-file.p ( input v-excel-file-name
     3506                     , input v-home-dir-filename
     3507                     ) no-error .
     3508     if error-status :error
     3509     then do:
     3510       assign
     3511         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     3512                                                   , v-excel-file-name
     3513                                                   , v-home-dir-filename
     3514                                                   , return-value
     3515                                                   , chr(10)
     3516                                                   )
     3517       .
     3518       return error v-err-message.
     3519     end.
     3520     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     3521                                                   ,input p-report-id
     3522                                                   ,input 'excel':U
     3523                                                   ,input v-home-dir-filename
     3524                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     3525                                                   ).
     3526   end.
     3527   end procedure.
     3528   define variable vss-include-info26 as character format "X(65)" no-undo
     3529   initial "@(#)$Workfile$ $Revision$".
     3530   define stream excel-line.
     3531   define stream excel-cell.
     3532   define temp-table temp_cell-data no-undo
     3533       field data-key as character
     3534       field data-value as character
     3535       index pi is primary unique data-key
     3536   .
     3537   define temp-table temp_sheet1_line-data no-undo
     3538       field sheet-name    as character
     3539       field xl-line-id    as integer
     3540       field gdsname         as character
     3541       field docdate         as character
     3542       field doccode         as character
     3543       field gdssum          as character
     3544       field tarasum         as character
     3545       field buhone          as character
     3546       field buhtwo          as character
     3547       index pi is primary unique
     3548           xl-line-id
     3549   .
     3550   define temp-table temp_sheet2_line-data no-undo
     3551       field sheet-name      as character
     3552       field xl-line-id      as integer
     3553       field gdsname         as character
     3554       field docdate         as character
     3555       field doccode         as character
     3556       field gdssum          as character
     3557       field tarasum         as character
     3558       field buhone          as character
     3559       field buhtwo          as character
     3560   index pi is primary unique
     3561       xl-line-id
     3562   .
     3563   define variable v-torg29xl-sheet1-cur-data-row     as integer      no-undo.
     3564   define variable v-torg29xl-sheet2-cur-data-row     as integer      no-undo.
     3565   define variable v-torg29xl-cell-file-name       as character    no-undo.
     3566   define variable v-torg29xl-data-file-name       as character    no-undo.
     3567   procedure torg29xl-init :
     3568   do
     3569   on error undo, return error
     3570   :
     3571       assign
     3572           v-torg29xl-sheet1-cur-data-row = 0
     3573           v-torg29xl-sheet2-cur-data-row = 0
     3574       .
     3575       run gbl/_tmpfile.p (
     3576             input "xd"
     3577           , input ".txt"
     3578           , output v-torg29xl-data-file-name
     3579       ).
     3580       output stream excel-line to value( v-torg29xl-data-file-name ).
     3581       run gbl/_tmpfile.p (
     3582             input "xc"
     3583           , input ".txt"
     3584           , output v-torg29xl-cell-file-name
     3585       ).
     3586       output stream excel-cell to value( v-torg29xl-cell-file-name ).
     3587       run torg29xl-write-cell-data in this-procedure (
     3588             input "sheetList":U
     3589           , input "лист1,лист2":U
     3590       ).
     3591       if printrubl
     3592       then do:
     3593           run torg29xl-write-cell-data in this-procedure (
     3594                 input "лист1_valutCode":U
     3595               , input "0":U
     3596           ).
     3597           run torg29xl-write-cell-data in this-procedure (
     3598                 input "лист2_valutCode":U
     3599               , input "0":U
     3600           ).
     3601       end.
     3602       else do:
     3603           run torg29xl-write-cell-data in this-procedure (
     3604                 input "лист1_valutCode":U
     3605               , input "1":U
     3606           ).
     3607           run torg29xl-write-cell-data in this-procedure (
     3608                 input "лист2_valutCode":U
     3609               , input "1":U
     3610           ).
     3611       end.
     3612       run torg29xl-write-cell-data in this-procedure (
     3613             input "лист1_columnList":U
     3614           , input "gdsname,docdate,doccode,gdssum,tarasum,buhone,buhtwo":U
     3615       ).
     3616       run torg29xl-write-cell-data in this-procedure (
     3617             input "лист1_columnType":U
     3618           , input "S,S,S,S,S,S,S":U
     3619       ).
     3620       run torg29xl-write-cell-data in this-procedure (
     3621             input "лист1_subtotalList":U
     3622           , input "":U
     3623       ).
     3624       run torg29xl-write-cell-data in this-procedure (
     3625             input "лист1_subtotalType":U
     3626           , input "":U
     3627       ).
     3628       run torg29xl-write-cell-data in this-procedure (
     3629             input "лист2_columnList":U
     3630           , input "gdsname,docdate,doccode,gdssum,tarasum,buhone,buhtwo":U
     3631       ).
     3632       run torg29xl-write-cell-data in this-procedure (
     3633             input "лист2_columnType":U
     3634           , input "S,S,S,S,S,S,S":U
     3635       ).
     3636       run torg29xl-write-cell-data in this-procedure (
     3637             input "лист2_subtotalList":U
     3638           , input "":U
     3639       ).
     3640       run torg29xl-write-cell-data in this-procedure (
     3641             input "лист2_subtotalType":U
     3642           , input "":U
     3643       ).
     3644   end.
     3645   end procedure.
     3646   procedure torg29xl-sheet1-write-line-data :
     3647   define input parameter p-gdsname as character        no-undo.
     3648   define input parameter p-docdate as character        no-undo.
     3649   define input parameter p-doccode as character        no-undo.
     3650   define input parameter p-gdssum  as character        no-undo.
     3651   define input parameter p-tarasum as character        no-undo.
     3652   define input parameter p-buhone  as character        no-undo.
     3653   define input parameter p-buhtwo  as character        no-undo.
     3654       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     3655   do
     3656   for buf_temp_sheet1_line-data
     3657   on error undo, return error
     3658   :
     3659       for each buf_temp_sheet1_line-data
     3660       :
     3661           delete buf_temp_sheet1_line-data.
     3662       end.
     3663       create buf_temp_sheet1_line-data.
     3664       assign
     3665           v-torg29xl-sheet1-cur-data-row       = v-torg29xl-sheet1-cur-data-row + 1
     3666           buf_temp_sheet1_line-data.sheet-name = "лист1":U
     3667           buf_temp_sheet1_line-data.xl-line-id = v-torg29xl-sheet1-cur-data-row
     3668           buf_temp_sheet1_line-data.gdsname    = p-gdsname
     3669           buf_temp_sheet1_line-data.docdate    = p-docdate
     3670           buf_temp_sheet1_line-data.doccode    = p-doccode
     3671           buf_temp_sheet1_line-data.gdssum     = p-gdssum
     3672           buf_temp_sheet1_line-data.tarasum    = p-tarasum
     3673           buf_temp_sheet1_line-data.buhone     = p-buhone
     3674           buf_temp_sheet1_line-data.buhtwo     = p-buhtwo
     3675       .
     3676       put stream excel-line unformatted
     3677                           buf_temp_sheet1_line-data.sheet-name
     3678           CHR(9)   "DTA":U
     3679           CHR(9)   buf_temp_sheet1_line-data.gdsname
     3680           CHR(9)   buf_temp_sheet1_line-data.docdate
     3681           CHR(9)   buf_temp_sheet1_line-data.doccode
     3682           CHR(9)   buf_temp_sheet1_line-data.gdssum
     3683           CHR(9)   buf_temp_sheet1_line-data.tarasum
     3684           CHR(9)   buf_temp_sheet1_line-data.buhone
     3685           CHR(9)   buf_temp_sheet1_line-data.buhtwo
     3686           chr(10)
     3687       .
     3688       .
     3689   end.
     3690   end procedure.
     3691   procedure torg29xl-sheet2-write-line-data :
     3692   define input parameter p-gdsname as character        no-undo.
     3693   define input parameter p-docdate as character        no-undo.
     3694   define input parameter p-doccode as character        no-undo.
     3695   define input parameter p-gdssum  as character        no-undo.
     3696   define input parameter p-tarasum as character        no-undo.
     3697   define input parameter p-buhone  as character        no-undo.
     3698   define input parameter p-buhtwo  as character        no-undo.
     3699       define buffer buf_temp_sheet2_line-data        for temp_sheet2_line-data.
     3700   do
     3701   for buf_temp_sheet2_line-data
     3702   on error undo, return error
     3703   :
     3704       for each buf_temp_sheet2_line-data
     3705       :
     3706           delete buf_temp_sheet2_line-data.
     3707       end.
     3708       create buf_temp_sheet2_line-data.
     3709       assign
     3710           v-torg29xl-sheet2-cur-data-row = v-torg29xl-sheet2-cur-data-row + 1
     3711       .
     3712       assign
     3713           buf_temp_sheet2_line-data.sheet-name = "лист2":U
     3714           buf_temp_sheet2_line-data.xl-line-id = v-torg29xl-sheet2-cur-data-row
     3715           buf_temp_sheet2_line-data.gdsname    = p-gdsname
     3716           buf_temp_sheet2_line-data.docdate    = p-docdate
     3717           buf_temp_sheet2_line-data.doccode    = p-doccode
     3718           buf_temp_sheet2_line-data.gdssum     = p-gdssum
     3719           buf_temp_sheet2_line-data.tarasum    = p-tarasum
     3720           buf_temp_sheet2_line-data.buhone     = p-buhone
     3721           buf_temp_sheet2_line-data.buhtwo     = p-buhtwo
     3722       .
     3723       put stream excel-line unformatted
     3724                           buf_temp_sheet2_line-data.sheet-name
     3725           CHR(9)   "DTA":U
     3726           CHR(9)   buf_temp_sheet2_line-data.gdsname
     3727           CHR(9)   buf_temp_sheet2_line-data.docdate
     3728           CHR(9)   buf_temp_sheet2_line-data.doccode
     3729           CHR(9)   buf_temp_sheet2_line-data.gdssum
     3730           CHR(9)   buf_temp_sheet2_line-data.tarasum
     3731           CHR(9)   buf_temp_sheet2_line-data.buhone
     3732           CHR(9)   buf_temp_sheet2_line-data.buhtwo
     3733           chr(10)
     3734       .
     3735   end.
     3736   end procedure.
     3737   procedure torg29xl-write-cell-data :
     3738   define input parameter p-data-key   as character        no-undo.
     3739   define input parameter p-data-value as character        no-undo.
     3740       define buffer buf_temp_cell-data     for temp_cell-data.
     3741   do
     3742   for buf_temp_cell-data
     3743   on error undo, return error
     3744   :
     3745       find first buf_temp_cell-data
     3746            where buf_temp_cell-data.data-key = p-data-key
     3747       no-error.
     3748       if not available buf_temp_cell-data
     3749       then do:
     3750           create buf_temp_cell-data.
     3751           assign
     3752               buf_temp_cell-data.data-key = p-data-key
     3753           .
     3754       end.
     3755       assign
     3756           buf_temp_cell-data.data-value = p-data-value
     3757       .
     3758       put stream excel-cell unformatted
     3759                           buf_temp_cell-data.data-key
     3760           CHR(9)   buf_temp_cell-data.data-value
     3761           chr(10)
     3762       .
     3763   end.
     3764   end procedure.
     3765   procedure torg29xl-run-excel :
     3766   define input parameter p-header-filename    as character        no-undo.
     3767   define input parameter p-data-filename      as character        no-undo.
     3768       define variable v-template-file-name    as character    no-undo.
     3769       define variable v-vb-file-name          as character    no-undo.
     3770       define buffer buf_temp-param for temp-param .
     3771   do
     3772   for buf_temp-param
     3773   on error undo, return error
     3774   :
     3775       create buf_temp-param.
     3776       assign
     3777           v-template-file-name    = search( "exe/torg29.xlt" )
     3778           v-vb-file-name          = search( "exe/t_form.bas")
     3779       .
     3780       if v-template-file-name = ?
     3781       or v-template-file-name = "":U
     3782       then do:
     3783           message
     3784               "Ошибка имени файла шаблона."
     3785           view-as alert-box error.
     3786       end.
     3787       if v-vb-file-name = ?
     3788       or v-vb-file-name = "":U
     3789       then do:
     3790           message
     3791               "Ошибка имени файла кода обработки."
     3792           view-as alert-box error.
     3793       end.
     3794       run paramls-write in this-procedure (
     3795             input "template":U
     3796           , input "template-file-name":U
     3797           , input v-template-file-name
     3798       ).
     3799       run paramls-write in this-procedure (
     3800             input "template":U
     3801           , input "vb-file-name":U
     3802           , input v-vb-file-name
     3803       ).
     3804       run paramls-write in this-procedure (
     3805             input "data":U
     3806           , input "data-header-filename":U
     3807           , input p-header-filename
     3808       ).
     3809       run paramls-write in this-procedure (
     3810             input "data":U
     3811           , input "data-filename":U
     3812           , input p-data-filename
     3813       ).
     3814       run gbl/macroxlt.p (
     3815           input-output table buf_temp-param
     3816       ) no-error.
     3817       if error-status :error
     3818       then do:
     3819           message
     3820                    vss-workfile vss-revision vss-description
     3821               skip(1)
     3822               skip "Ошибка создания файла Excel."
     3823               skip return-value
     3824               skip trim(error-status :get-message(1))
     3825                    trim(error-status :get-message(2))
     3826                    trim(error-status :get-message(3))
     3827           view-as alert-box error.
     3828           undo, return error .
     3829       end.
     3830   end.
     3831   end procedure.
     3832   procedure torg29xl-close :
     3833   do
     3834   on error undo, return error
     3835   :
     3836       output stream excel-line close.
     3837       output stream excel-cell close.
     3838       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     3839           export "exe/torg29.xlt":U.
     3840           export "exe/t_form.bas":U.
     3841           export v-torg29xl-cell-file-name.
     3842           export v-torg29xl-data-file-name.
     3843       output close.
     3844   end.
     3845   end procedure.
     3846   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3847     define variable v-cntxt-db-num        as integer   no-undo .
     3848     define variable v-cntxt-userid        as character no-undo .
     3849     define variable v-cntxt-level         as character no-undo .
     3850     define variable v-cntxt-host-code-obj as integer   no-undo .
     3851     define variable v-cntxt-obj-type      as character no-undo .
     3852     define variable v-cntxt-obj-code      as integer   no-undo .
     3853     define variable v-cntxt-db-num-obj    as integer   no-undo .
     3854     define variable v-cntxt-is-admin      as logical   no-undo .
     3855   define temp-table tt-goods no-undo
     3856     field gds-code      like ub.goods.gds-code
     3857     field artic         like ub.goods.artic
     3858     field prod-type     like ub.goods.prod-type
