     4268       "Приложение ____________________________________________ документов                    ":U skip
     4269       "                                                                                      ":U skip
     4270       "Отчет с документами                                                                   ":U skip
     4271       "принял и проверил   _________________________ __________________ _____________________":U skip
     4272       "                              должность              подпись      расшифровка подписи ":U skip
     4273       "                                                                                      ":U skip
     4274       "Материально                                                                           ":U skip
     4275       "ответственное лицо  _________________________ __________________ _____________________":U skip
     4276       "                              должность              подпись      расшифровка подписи ":U skip
     4277     .
     4278     end.
     4279   end procedure.
     4280   procedure create-tt-goods :
     4281     define buffer buf_goods   for ub.goods.
     4282     define buffer buf_cli-gds for ub.cli-gds.
     4283     define variable v-curr-grp-name as character no-undo .
     4284     define variable v-host-code     like ub.clients.host-code  no-undo .
     4285     do on error undo, return error return-value :
     4286       run waitfram-show in this-procedure ( "Формирование списка товаров..." ) .
     4287       empty temp-table tt-goods.
     4288       for each buf_obj-list :
     4289         case x-SelectGood :
     4290           when 1 then do:
     4291             for each buf_gds-obj no-lock
     4292               where buf_gds-obj.obj-type  = buf_obj-list.obj-type
     4293                 and buf_gds-obj.obj-code  = buf_obj-list.obj-code
     4294               :
     4295               run fill-tt in this-procedure .
     4296             end.
     4297           end.
     4298           when 3 then do:
     4299             for each G#cli :
     4300               for each buf_gds-obj  no-lock
     4301                 where buf_gds-obj.obj-type  = buf_obj-list.obj-type
     4302                   and buf_gds-obj.obj-code  = buf_obj-list.obj-code
     4303                   and buf_gds-obj.prod-type = G#cli.obj-type
     4304                   and buf_gds-obj.prod-code = G#cli.obj-code
     4305                 use-index pi  :
     4306                 run fill-tt in this-procedure .
     4307               end .
     4308             end .
     4309           end .
     4310           when 2 then do:
     4311             for each tmp#grp :
     4312               run grplib-get-full-name in this-procedure( input tmp#grp.node-code, output v-curr-grp-name ) .
     4313               for each buf_gds-obj no-lock
     4314                 where buf_gds-obj.obj-type = buf_obj-list.obj-type
     4315                   and buf_gds-obj.obj-code = buf_obj-list.obj-code
     4316                   and buf_gds-obj.grp-name begins v-curr-grp-name
     4317                 use-index obj-grp :
     4318                 run fill-tt in this-procedure .
     4319               end .
     4320             end.
     4321           end.
     4322           otherwise do:
     4323             for each gds-list ,
     4324                 each buf_gds-obj no-lock
     4325               where buf_gds-obj.obj-type  = buf_obj-list.obj-type
     4326                 and buf_gds-obj.obj-code  = buf_obj-list.obj-code
     4327                 and buf_gds-obj.artic     = gds-list.artic
     4328                 and buf_gds-obj.prod-type = gds-list.prod-type
     4329                 and buf_gds-obj.prod-code = gds-list.prod-code
     4330               :
     4331               run fill-tt in this-procedure .
     4332             end.
     4333           end.
     4334         end case.
     4335       end.
     4336       run waitfram-hide in this-procedure .
     4337     end.
     4338   end procedure.
     4339   procedure fill-tt :
     4340     do  on error undo, return error return-value :
     4341       find first tt-goods no-lock
     4342         where tt-goods.prod-type = buf_gds-obj.prod-type
     4343           and tt-goods.prod-code = buf_gds-obj.prod-code
     4344           and tt-goods.artic     = buf_gds-obj.artic
     4345       no-error.
     4346       find first buf_goods where buf_goods.gds-code = buf_gds-obj.gds-code.
     4347       v-upper-code = buf_goods.grp-code.
     4348       v-value = "".
     4349       do while v-upper-code > 0 and v-p-accsup = "yes" and p-batch > 0 :
     4350           find first buf_gds-grp where buf_gds-grp.node-code = v-upper-code.
     4351           run ggoattr-value(
     4352             input buf_gds-grp.node-code,
     4353             input 0,
     4354             input "",
     4355             input 0,
     4356             input 'no-inc-auto-rep':U,
     4357             output v-value,
     4358             output v-type
     4359           ).
     4360           if v-value = "yes" then
     4361             leave.
     4362           else
     4363             v-upper-code = buf_gds-grp.upper-code.
     4364       end.
     4365       if not available tt-goods and v-value <> "yes" then do:
     4366         create tt-goods.
     4367         assign
     4368           v-gds-counter      = v-gds-counter + 1
     4369           tt-goods.prod-type = buf_gds-obj.prod-type
     4370           tt-goods.prod-code = buf_gds-obj.prod-code
     4371           tt-goods.artic     = buf_gds-obj.artic
     4372           tt-goods.gds-code  = buf_gds-obj.gds-code
     4373         .
     4374       end.
     4375     end.
     4376   end procedure.
     4377   procedure create-report :
     4378     define variable var-x-store-code    like ub.clients.obj-code    no-undo.
     4379     define variable var-x-store-type    like ub.clients.obj-type    no-undo.
     4380     define variable var-x-date-start    like ub.stk-tot.Fact-date   no-undo.
     4381     define variable var-x-date-endt     like ub.stk-tot.Fact-date   no-undo.
     4382     define variable var-x-sum-type      like ub.stk-tot.sum-type    no-undo.
     4383     define variable var-x-ost-sum-type  like ub.stk-tot.sum-type    no-undo.
     4384     define variable var-x-cat-id        like ub.stk-tot.cat-id      no-undo.
     4385     define variable var-xTog-obj        as   log                 no-undo.
     4386     define variable var-Quantity        like ub.stk-tot.fact-qnty   initial ? no-undo.
     4387     define variable var-Coast_R         like ub.stk-tot.sum-rubl    no-undo.
     4388     define variable var-Coast_V         like ub.stk-tot.sum-rubl    no-undo.
     4389     define variable var-VAT_R           like ub.stk-tot.sum-rubl    no-undo.
     4390     define variable var-VAT_V           like ub.stk-tot.sum-rubl    no-undo.
     4391     define variable var-Fact-order      like ub.stk-tot.Fact-order  no-undo.
     4392     define variable var-x-artic         like ub.stk-line.artic      no-undo.
     4393     define variable var-x-prod-code     like ub.stk-line.prod-code  no-undo.
     4394     define variable var-x-prod-type     like ub.stk-line.prod-type  no-undo.
     4395     define variable var-SLT_R           like ub.stk-tot.sum-rubl    no-undo.
     4396     define variable var-SLT_V           like ub.stk-tot.sum-rubl    no-undo.
     4397     define variable v-ost-gds-1         as decimal   no-undo .
     4398     define variable v-ost-tara-1        as decimal   no-undo .
     4399     define variable v-ost-gds-2         as decimal   no-undo .
     4400     define variable v-ost-tara-2        as decimal   no-undo .
     4401     define variable v-ost-qnty          as decimal   no-undo .
     4402     define variable v-counter           as integer   no-undo .
     4403     define variable v-prg               as class ProgressBar no-undo .
     4404     define variable v-none-sym-1        as character no-undo .
     4405     define variable v-none-sym-2        as character no-undo .
     4406     define buffer buf_tax-rate-gds for ub.tax-rate-gds.
     4407   do
     4408   on error undo, return error return-value
     4409   :
     4410     run create-tt-goods in this-procedure .
     4411     empty temp-table tt-report.
     4412     case x-SET_PAY_TYPE :
     4413       when 2 then do:
     4414         assign
     4415           var-x-sum-type      = 'cost':U
     4416           var-x-ost-sum-type  = 'cost':U
     4417         .
     4418       end.
     4419       when 1 then do:
     4420         assign
     4421           var-x-sum-type      = 'crsa':U
     4422           var-x-ost-sum-type  = 'crsa':U
     4423         .
     4424       end.
     4425       when 3 then do:
     4426         assign
     4427           var-x-sum-type      = 'sale':U
     4428           var-x-ost-sum-type  = 'crsa':U
     4429         .
     4430       end.
     4431       otherwise do:
     4432         assign
     4433           var-x-sum-type      = 'cost':U
     4434           var-x-ost-sum-type  = 'cost':U
     4435         .
     4436       end.
     4437     end case.
     4438     var-x-cat-id      = '##,##':U.
     4439     for each buf_obj-list :
     4440       if v-obj-code = -1 then do:
     4441         assign
     4442         v-obj-type = buf_obj-list.obj-type
     4443         v-obj-code = buf_obj-list.obj-code.
     4444       end.
     4445       else do:
     4446         assign
     4447         v-obj-type = ''
     4448         v-obj-code = 0
     4449         .
     4450       end.
     4451       v-prg = new ProgressBar( 1 , v-gds-counter ).
     4452       assign
     4453         v-prg:frame-title = buf_obj-list.obj-name
     4454         v-prg:fg-color = 9
     4455       .
     4456       v-prg:show-bar().
     4457       if x-TOG-Shift then do:
     4458         run ostatok in this-procedure (
     4459           input buf_obj-list.obj-code
     4460          ,input buf_obj-list.obj-type
     4461          ,input x-TOG-Shift
     4462          ,input x-date-start - 1
     4463          ,input date('')
     4464          ,input x-Shift-Start
     4465          ,input x-Shift-End
     4466          ,input var-x-ost-sum-type
     4467          ,input var-x-cat-id
     4468          ,input true
     4469          ,output  var-Quantity
     4470          ,output  var-Coast_R
     4471          ,output  var-Coast_V
     4472          ,output  var-VAT_R
     4473          ,output  var-VAT_V
     4474          ,output  v-fact-order-1 ).
     4475          run ostatok in this-procedure (
     4476           input buf_obj-list.obj-code
     4477          ,input buf_obj-list.obj-type
     4478          ,input x-TOG-Shift
     4479          ,input x-date-start
     4480          ,input x-date-end
     4481          ,input x-Shift-Start
     4482          ,input x-Shift-End
     4483          ,input var-x-ost-sum-type
     4484          ,input var-x-cat-id
     4485          ,input true
     4486          ,output  var-Quantity
     4487          ,output  var-Coast_R
     4488          ,output  var-Coast_V
     4489          ,output  var-VAT_R
     4490          ,output  var-VAT_V
     4491          ,output v-Fact-order-2 ).
     4492       end.
     4493       if p-break-by-cp  then do:
     4494       run break-by-cp-prep in this-procedure ( input buf_obj-list.obj-type
     4495                                          ,input buf_obj-list.obj-code
     4496                                          ,input v-fact-order-1
     4497                                          ,input v-fact-order-2
     4498                                          ) .
     4499       end.
     4500       _goods-loop:
     4501       for each tt-goods :
     4502         v-prg:increment().
     4503          if p-tax-rate-list > '' then do:
     4504             find last buf_tax-rate-gds no-lock
     4505                 where buf_tax-rate-gds.tax-code  = integer('1':U)
     4506                   and buf_tax-rate-gds.gds-code  = tt-goods.gds-code
     4507                   and buf_tax-rate-gds.host-code  = 0
     4508                   and buf_tax-rate-gds.obj-type  = ''
     4509                   and buf_tax-rate-gds.obj-code  = 0
     4510                   and buf_tax-rate-gds.fact-order <= v-fact-order-1 no-error.
     4511             if not available buf_tax-rate-gds then do:
     4512               next _goods-loop.
     4513             end.
     4514             if lookup(string(buf_tax-rate-gds.rate-code), p-tax-rate-list) = 0
     4515             then do:
     4516               next _goods-loop.
     4517             end.
     4518           end.
     4519         assign
     4520           var-x-store-code  = buf_obj-list.obj-code
     4521           var-x-store-type  = buf_obj-list.obj-type
     4522           var-x-artic       = tt-goods.artic
     4523           var-x-prod-code   = tt-goods.prod-code
     4524           var-x-prod-type   = tt-goods.prod-type
     4525           var-x-cat-id      = '##,##':U
     4526           var-xTog-obj      = yes
     4527           v-counter         = v-counter + 1
     4528         .
     4529         RUN ost-line in this-procedure (
     4530             input   var-x-store-code    ,
     4531             input   var-x-store-type    ,
     4532             input   var-x-artic         ,
     4533             input   var-x-prod-code     ,
     4534             input   var-x-prod-type     ,
     4535             input   X-tog-shift         ,
     4536             input   v-fact-order-1      ,
     4537             input   var-x-ost-sum-type  ,
     4538             input   var-x-cat-id        ,
     4539             input   var-xTog-obj        ,
     4540             output  var-Quantity        ,
     4541             output  var-Coast_R         ,
     4542             output  var-Coast_V         ,
     4543             output  var-VAT_R           ,
     4544             output  var-VAT_V           ,
     4545             output  var-SLT_R           ,
     4546             output  var-SLT_V          ) .
     4547         assign  v-ost-gds-1 = v-ost-gds-1 +
     4548                              ( if v-print-rubl = yes
     4549                              then (var-Coast_R  - (if p-without-vat
     4550                                                    then var-VAT_R
     4551                                                    else 0)
     4552                                   )
     4553                              else (var-Coast_V  - (if p-without-vat
     4554                                                   then var-VAT_V
     4555                                                   else 0)
     4556                                   )
     4557                              )  .
     4558         RUN ost-line in this-procedure (
     4559             input   var-x-store-code    ,
     4560             input   var-x-store-type    ,
     4561             input   var-x-artic         ,
     4562             input   var-x-prod-code     ,
     4563             input   var-x-prod-type     ,
     4564             input   X-tog-shift         ,
     4565             input   v-fact-order-2      ,
     4566             input   var-x-ost-sum-type  ,
     4567             input   var-x-cat-id        ,
     4568             input   var-xTog-obj        ,
     4569             output  var-Quantity        ,
     4570             output  var-Coast_R         ,
     4571             output  var-Coast_V         ,
     4572             output  var-VAT_R           ,
     4573             output  var-VAT_V           ,
     4574             output  var-SLT_R           ,
     4575             output  var-SLT_V          ) .
     4576         assign  v-ost-gds-2 = v-ost-gds-2 +
     4577                              ( if v-print-rubl = yes
     4578                              then (var-Coast_R  - (if p-without-vat
     4579                                                    then var-VAT_R
     4580                                                    else 0)
     4581                                   )
     4582                              else (var-Coast_V  - (if p-without-vat
     4583                                                   then var-VAT_V
     4584                                                   else 0)
     4585                                   )
     4586                              )  .
     4587         _ot-line:
     4588         for each buf_ot-line no-lock
     4589             where buf_ot-line.obj-type     = buf_obj-list.obj-type
     4590               and buf_ot-line.obj-code     = buf_obj-list.obj-code
     4591               and buf_ot-line.artic        = tt-goods.artic
     4592               and buf_ot-line.prod-type    = tt-goods.prod-type
     4593               and buf_ot-line.prod-code    = tt-goods.prod-code
     4594               and buf_ot-line.fact-order   >= v-fact-order-1
     4595               and buf_ot-line.fact-order   <= v-fact-order-2
     4596               and buf_ot-line.sum-type     = var-x-sum-type
     4597         :
     4598           if buf_ot-line.ext-doc-type <>  'ot':U then do:
     4599           find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = buf_ot-line.doc-code  no-error .
     4600           if available buf_trn-doc then do:
     4601              find first buf2_obj-list no-lock
     4602               where buf2_obj-list.obj-type = buf_trn-doc.cli-type
     4603                 and buf2_obj-list.obj-code = buf_trn-doc.cli-code
     4604              no-error .
     4605              if available buf2_obj-list then do:
     4606               next _ot-line.
     4607              end.
     4608           end.
     4609           end.
     4610           case buf_ot-line.ext-doc-type :
     4611             when 'ie':U           or
     4612             when 'iv':U           or
     4613             when 'rv':U       or
     4614             when 'im':U
     4615             then do:
     4616               if x-SET_PAY_TYPE = 3 then do:
     4617                 next _ot-line.
     4618               end.
     4619               run fill-tt-rep ( input tt-goods.gds-code, input "inc":U) .
     4620             end.
     4621             when 're':U       or
     4622             when 'rs':U
     4623             then do:
     4624               run fill-tt-rep ( input tt-goods.gds-code, input "inc":U) .
     4625             end.
     4626             when 'ee':U           or
     4627             when 'es':U      or
     4628             when 'ep':U        or
     4629             when 'we':U           or
     4630             when 'ev':U           or
     4631             when 'em':U            or
     4632             when 'wm':U
     4633             then do:
     4634               run fill-tt-rep ( input tt-goods.gds-code, input "out":U) .
     4635             end.
     4636             when 'vt':U               or
     4637             when 'vp':U          or
     4638             when 'ot':U          or
     4639             when 'ap':U    or
     4640             when 'mp':U
     4641             then do:
     4642               if x-SET_PAY_TYPE = 3 then next _ot-line.
     4643               run fill-tt-rep (
     4644                                  input tt-goods.gds-code
     4645                                 ,input if ( buf_ot-line.sum-base > 0 or buf_ot-line.sum-rubl > 0 )
     4646                                       then "inc":U
     4647                                        else "out":U) .
     4648             end.
     4649             otherwise do:
     4650               next _ot-line.
     4651             end.
     4652           end case.
     4653           assign
     4654             tt-report.doc-sum       = tt-report.doc-sum + abs( if v-print-rubl = yes
     4655                                                                then (buf_ot-line.sum-rubl  - (if p-without-vat
     4656                                                                                               then buf_ot-line.vat-rubl
     4657                                                                                               else 0)
     4658                                                                     )
     4659                                                                else (buf_ot-line.sum-base   - (if p-without-vat
     4660                                                                                               then buf_ot-line.vat-base
     4661                                                                                               else 0)
     4662                                                                      )
     4663                                                                )
     4664             v-counter               = v-counter + 1
     4665            .
     4666         end.
     4667         if x-SET_PAY_TYPE = 3 then do:
     4668           _ot-line-sale :
     4669           for each buf_ot-line no-lock
     4670               where buf_ot-line.obj-type     = buf_obj-list.obj-type
     4671                 and buf_ot-line.obj-code     = buf_obj-list.obj-code
     4672                 and buf_ot-line.artic        = tt-goods.artic
     4673                 and buf_ot-line.prod-type    = tt-goods.prod-type
     4674                 and buf_ot-line.prod-code    = tt-goods.prod-code
     4675                 and buf_ot-line.fact-order   >= v-fact-order-1
     4676                 and buf_ot-line.fact-order   <= v-fact-order-2
     4677                 and buf_ot-line.sum-type     = 'crsa':U
     4678           :
     4679             case buf_ot-line.ext-doc-type :
     4680               when 'ie':U           or
     4681               when 'iv':U           or
     4682               when 'rv':U       or
     4683               when 'im':U
     4684               then do:
     4685                 run fill-tt-rep ( input tt-goods.gds-code
     4686                                  ,input "inc":U) .
     4687               end.
     4688               when 'vt':U               or
     4689               when 'vp':U          or
     4690               when 'ot':U          or
     4691               when 'ap':U    or
     4692               when 'mp':U
     4693               then do:
     4694                 run fill-tt-rep (  input tt-goods.gds-code
     4695                                   ,input if ( buf_ot-line.sum-base > 0 or buf_ot-line.sum-rubl > 0 )
     4696                                         then "inc":U
     4697                                         else "out":U) .
     4698               end.
     4699               otherwise do:
     4700                 next _ot-line-sale.
     4701               end.
     4702             end case.
     4703             assign
     4704               tt-report.doc-sum       = tt-report.doc-sum + abs( if v-print-rubl = yes
     4705                                                                  then (buf_ot-line.sum-rubl - (if p-without-vat
     4706                                                                                                then buf_ot-line.vat-rubl
     4707                                                                                                else 0)
     4708                                                                       )
     4709                                                                  else (buf_ot-line.sum-base  - (if p-without-vat
     4710                                                                                                then buf_ot-line.vat-base
     4711                                                                                                else 0)
     4712                                                                        )
     4713                                                                    )
     4714               v-counter               = v-counter + 1
     4715             .
     4716           end.
     4717         end.
     4718       end.
     4719       create tt-report-object.
     4720       assign
     4721         tt-report-object.obj-type       = buf_obj-list.obj-type
     4722         tt-report-object.obj-code       = buf_obj-list.obj-code
     4723         tt-report-object.ost-gds-sum-1  = v-ost-gds-1
     4724         tt-report-object.ost-gds-sum-2  = v-ost-gds-2
     4725         v-ost-gds-1                     = 0
     4726         v-ost-gds-2                     = 0
     4727       .
     4728       v-prg:hide-bar().
     4729       delete object v-prg.
     4730       assign
     4731           v-prg = ?
     4732       .
     4733     end.
     4734     for each tt-report :
     4735       if tt-report.doc-sum = 0 and tt-report.tara-sum = 0 then delete tt-report.
     4736     end.
     4737     for each tt-ignore-docs,
     4738         each tt-report where
     4739         tt-report.doc-code = tt-ignore-docs.doc-code :
     4740     delete tt-report.
     4741     end.
     4742   end.
     4743   end procedure.
     4744   procedure fill-tt-rep :
     4745     do on error undo, return error return-value :
     4746       define input parameter p-gds-code as integer no-undo .
     4747       define input  parameter p-type as character no-undo .
     4748       DEFINE VARIABLE v-attr-type     as character no-undo .
     4749       DEFINE VARIABLE v-attr-value    as character no-undo .
     4750       define variable v-doc-date          as date      no-undo .
     4751       define variable v-vat-pc            as decimal   no-undo.
     4752       define buffer goods_temp-cp for temp-cp.
     4753       define buffer doc_temp-cp for temp-cp.
     4754       define buffer buf_trn-doc for ub.trn-doc.
     4755       find first tt-report where
     4756                tt-report.doc-code = buf_ot-line.doc-code
     4757            and tt-report.ext-doc-type = p-type no-error .
     4758       if not available tt-report then do:
     4759         run factord-to-date in this-procedure ( input buf_ot-line.fact-order , output v-doc-date ) .
     4760         if buf_ot-line.ext-doc-type <> 'ot':U then do:
     4761           find first buf_trn-doc where
     4762                   buf_trn-doc.doc-code = buf_ot-line.doc-code no-error.
     4763         end.
     4764         if available buf_trn-doc
     4765         and buf_trn-doc.ext-doc-type = 'we':U
     4766         and (buf_trn-doc.out-code <> ?
     4767              and
     4768              buf_trn-doc.out-code <> '') then do:
     4769           if p-no-covered-techrfsl then run  process-covered-techrfsl ( buffer buf_trn-doc) no-error.
     4770         end.
     4771         create tt-report.
     4772         assign
     4773           tt-report.doc-code      = buf_ot-line.doc-code
     4774           tt-report.fact-order    = buf_ot-line.fact-order
     4775           tt-report.fact-date     = v-doc-date
     4776           tt-report.ext-doc-type  = p-type
     4777           tt-report.real-ext-doc-type  = buf_ot-line.ext-doc-type
     4778         tt-report.break-ext-doc-type  = (if p-ext-doc-type-subtotals
     4779                                          then  tt-report.real-ext-doc-type
     4780                                          else '').
     4781         if tt-report.real-ext-doc-type = 'ie':U then do:
     4782                   run gbl/trdcat-v.p   ( input tt-report.doc-code
     4783                              , input 'nids':U
     4784                              , output v-attr-value
     4785                              , output v-attr-type
     4786                              ) NO-ERROR .
     4787           if v-attr-value <> "" then tt-report.num-ship = v-attr-value. else tt-report.num-ship = tt-report.doc-code .
     4788         end.
     4789         if tt-report.real-ext-doc-type <> 'ie':U then do:
     4790                   run gbl/trdcat-v.p   ( input tt-report.doc-code
     4791                              , input 'print-num':U
     4792                              , output v-attr-value
     4793                              , output v-attr-type
     4794                              ) NO-ERROR .
     4795           if v-attr-value <> "" then tt-report.num-ship = v-attr-value. else tt-report.num-ship = tt-report.doc-code .
     4796         end.
     4797         tt-report.cli-name      = (if available buf_trn-doc
     4798                                    then buf_trn-doc.cli-name
     4799                                    else (if buf_ot-line.ext-doc-type = 'ot':U
     4800                                          then "(Переоценка)"
     4801                                          else "")
     4802                                    )
     4803         .
     4804       end.
     4805       if p-break-by-cp
     4806       and (buf_ot-line.ext-doc-type = 'es':U
     4807            or
     4808            buf_ot-line.ext-doc-type = 'rs':U)
     4809       then do:
     4810         for each  goods_temp-cp where
     4811                   goods_temp-cp.gds-code = p-gds-code
     4812               and goods_temp-cp.doc-code = buf_ot-line.doc-code :
     4813            find first doc_temp-cp where
     4814                       doc_temp-cp.gds-code = 0
     4815                   and doc_temp-cp.doc-code = buf_ot-line.doc-code
     4816                   and doc_temp-cp.cdpay-code = goods_temp-cp.cdpay-code
     4817                   and doc_temp-cp.curr-code = goods_temp-cp.curr-code no-error.
     4818            if not available doc_temp-cp then do:
     4819              create doc_temp-cp.
     4820              assign
     4821              doc_temp-cp.gds-code = 0
     4822              doc_temp-cp.doc-code = buf_ot-line.doc-code
     4823              doc_temp-cp.cdpay-code = goods_temp-cp.cdpay-code
     4824              doc_temp-cp.curr-code = goods_temp-cp.curr-code
     4825              .
     4826            end.
     4827            assign
     4828            doc_temp-cp.eff-doc-qnty = doc_temp-cp.eff-doc-qnty  + goods_temp-cp.eff-doc-qnty
     4829            doc_temp-cp.tot-rb = doc_temp-cp.tot-rb + goods_temp-cp.tot-rb
     4830            .
     4831            if x-SET_PAY_TYPE = 3 then do:
     4832                if not p-without-vat then do:
     4833   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4834   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     4835     (input  goods_temp-cp.gds-code
     4836     ,input  '1':U
     4837     ,input  buf_trn-doc.fact-date
     4838     ,input  buf_trn-doc.host-code
     4839     ,input  buf_trn-doc.obj-type
     4840     ,input  buf_trn-doc.obj-code
     4841     ,output v-vat-pc
     4842     ) no-error .
     4843                end.
     4844                doc_temp-cp.sum = doc_temp-cp.sum  + goods_temp-cp.tot-rb - (if p-without-vat then (goods_temp-cp.tot-rb * v-vat-pc / (100 + v-vat-pc)) else 0).
     4845            end.
     4846            else do:
     4847            doc_temp-cp.sum = doc_temp-cp.sum +
     4848                              goods_temp-cp.eff-doc-qnty * abs(if v-print-rubl = yes
     4849                                                               then (buf_ot-line.sum-rubl - (if p-without-vat
     4850                                                                                             then buf_ot-line.vat-rubl
     4851                                                                                             else 0)
     4852                                                                    )
     4853                                                               else (buf_ot-line.sum-base  - (if p-without-vat
     4854                                                                                             then buf_ot-line.vat-base
     4855                                                                                             else 0)
     4856                                                                    )
     4857                                                               ) / if buf_ot-line.fact-qnty <> 0 then abs(buf_ot-line.fact-qnty) else 1.
     4858            end.
     4859            release doc_temp-cp.
     4860         end.
     4861       end.
     4862     end.
     4863   end procedure.
     4864   procedure print-report :
     4865     define variable v-total-gds         as decimal   no-undo .
     4866     define variable v-total-tara        as decimal   no-undo .
     4867     define variable v-ost-gds-1         as decimal   no-undo .
     4868     define variable v-ost-tara-1        as decimal   no-undo .
