     3288   define stream temp-stream.
     3289   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3290   procedure prnexldl_clear:
     3291   define input parameter p-txl-file-name as character no-undo .
     3292   define variable v-template-file-name as character no-undo .
     3293   define variable v-vb-file-name as character no-undo .
     3294   define variable v-data-header-filename as character no-undo .
     3295   define variable v-data-filename as character no-undo .
     3296   if search( p-txl-file-name ) <> ? then do:
     3297     input stream temp-stream from value( p-txl-file-name ).
     3298     repeat
     3299     :
     3300         import stream temp-stream v-template-file-name   .
     3301         import stream temp-stream v-vb-file-name         .
     3302         import stream temp-stream v-data-header-filename .
     3303         os-delete value(v-data-header-filename).
     3304         import stream temp-stream v-data-filename        .
     3305         os-delete value(v-data-filename).
     3306     end.
     3307     input stream temp-stream close.
     3308     os-delete value( p-txl-file-name ).
     3309   end.
     3310   end procedure .
     3311   define stream reprumpr_in.
     3312   procedure reprumpr_print-xlt :
     3313   define input parameter p-dir-name as character no-undo .
     3314   define input parameter p-subdir-name as character no-undo .
     3315   define input parameter p-custom-name as character no-undo .
     3316   define input parameter p-disable-option as integer no-undo .
     3317   define input parameter p-font-number as integer no-undo .
     3318   define buffer buf_temp-param for temp-param .
     3319   define variable v-report-num            as integer no-undo .
     3320   define variable v-filename              as character    no-undo .
     3321   define variable v-obj-dir               as character    no-undo .
     3322   define variable v-report-filename       as character    no-undo .
     3323   define variable v-home-dir-filename     as character    no-undo .
     3324   define variable v-error-num             as integer      no-undo .
     3325   define variable v-template-file-name    as character    no-undo .
     3326   define variable v-vb-file-name          as character    no-undo .
     3327   define variable v-data-header-filename  as character    no-undo .
     3328   define variable v-data-filename         as character    no-undo .
     3329   define variable v-excel-file-name       as character    no-undo .
     3330   define variable v-err-message           as character    no-undo .
     3331   define variable v-os-err-str            as character    no-undo .
     3332   define variable v-report-dir            as character    no-undo .
     3333   do for buf_temp-param
     3334   on error undo, return error return-value
     3335   :
     3336   assign
     3337     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     3338   .
     3339     assign
     3340     v-report-num = g#report-num
     3341     v-obj-dir           = v-report-dir + chr(47) +
     3342                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     3343     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     3344     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     3345     v-home-dir-filename = v-obj-dir +  p-custom-name
     3346     .
     3347     os-delete value( v-filename + ".txl" )  .
     3348     os-rename
     3349       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     3350       value( v-filename + ".txl" )
     3351     .
     3352     assign
     3353       v-filename = search( v-filename + ".txl" )
     3354     .
     3355     if v-filename = "" or v-filename = ?
     3356     then do:
     3357       assign
     3358         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     3359                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     3360                                                   )
     3361       .
     3362       return error v-err-message.
     3363     end.
     3364     input stream reprumpr_in from value( v-filename ).
     3365     import stream reprumpr_in v-template-file-name   no-error .
     3366     import stream reprumpr_in v-vb-file-name         no-error .
     3367     import stream reprumpr_in v-data-header-filename no-error .
     3368     import stream reprumpr_in v-data-filename        no-error .
     3369     input stream reprumpr_in close.
     3370     if search( v-template-file-name ) = ?
     3371     then do:
     3372       assign
     3373         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     3374                                                   , v-template-file-name
     3375                                                   , chr(10)
     3376                                                   )
     3377       .
     3378       return error v-err-message.
     3379     end.
     3380     if search( v-vb-file-name ) = ?
     3381     then do:
     3382       assign
     3383         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     3384                                                   , v-template-file-name
     3385                                                   , v-vb-file-name
     3386                                                   , chr(10)
     3387                                                   )
     3388       .
     3389       return error v-err-message.
     3390     end.
     3391     if v-data-header-filename <> "":U
     3392     and search( v-data-header-filename ) = ?
     3393     then do:
     3394       assign
     3395         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     3396                                                   , v-template-file-name
     3397                                                   , v-data-header-filename
     3398                                                   , chr(10)
     3399                                                   )
     3400       .
     3401       return error v-err-message.
     3402     end.
     3403     if v-data-filename <> "":U
     3404     and search( v-data-filename )   = ?
     3405     then do:
     3406       assign
     3407         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     3408                                                   , v-template-file-name
     3409                                                   , v-data-filename
     3410                                                   , chr(10)
     3411                                                   )
     3412       .
     3413       return error v-err-message.
     3414     end.
     3415     create buf_temp-param.
     3416     assign
     3417       v-template-file-name = search( v-template-file-name )
     3418       file-info :file-name = v-template-file-name
     3419       v-template-file-name = file-info :full-pathname
     3420       v-vb-file-name       = search( v-vb-file-name )
     3421       file-info :file-name = v-vb-file-name
     3422       v-vb-file-name       = file-info :full-pathname
     3423     .
     3424     if v-template-file-name = ? or v-template-file-name = "":U
     3425     then do:
     3426       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     3427     end.
     3428     run paramls-write in this-procedure ( input "template":U
     3429                                         , input "template-file-name":U
     3430                                         , input v-template-file-name
     3431                                         ).
     3432     run paramls-write in this-procedure ( input "template":U
     3433                                         , input "vb-file-name":U
     3434                                         , input v-vb-file-name
     3435                                         ).
     3436     run paramls-write in this-procedure ( input "data":U
     3437                                         , input "data-header-filename":U
     3438                                         , input v-data-header-filename
     3439                                         ).
     3440     run paramls-write in this-procedure ( input "data":U
     3441                                         , input "data-filename":U
