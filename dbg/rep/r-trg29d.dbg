     3234                               then (p-subdir-name + chr(47))
     3235                               else '') +
     3236                 p-custom-name.
     3237   run prn-lib-get-report-name  in this-procedure (
     3238                                                     input parParentProc
     3239                                                     ,output v-report-name
     3240                                                   ).
     3241   os-copy
     3242   value(v-report-name)
     3243   value(v-file-name)
     3244   .
     3245   assign
     3246   v-err-status = os-error
     3247   .
     3248   if v-err-status <> 0 then do:
     3249     run gbl/os-errnm.p ( input v-err-status
     3250                         ,output v-err-mess).
     3251     return error v-err-mess.
     3252   end.
     3253   else do:
     3254     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     3255                                                   ,input p-report-id
     3256                                                   ,input 'text':U
     3257                                                   ,input v-file-name
     3258                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     3259                                                   ).
     3260   end.
     3261   end procedure.
