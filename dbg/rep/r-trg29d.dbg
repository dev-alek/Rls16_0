     4231     run print-table-header in this-procedure .
     4232   end.
     4233   end procedure.
     4234   procedure print-table-header :
     4235     define variable v-str     as character no-undo .
     4236     define variable v-length  as integer   no-undo .
     4237     define variable v-result  as character no-undo .
     4238     define variable v-i       as integer   no-undo .
     4239     define variable v-j       as integer   no-undo .
     4240   do
     4241   :
     4242     assign
     4243       v-str     = "Сумма, руб. коп."
     4244       v-length  = length(v-str)
     4245     .
     4246     if v-length > 31 then do:
     4247       assign  v-result = substring( v-str , 1 , 31 ) .
     4248     end.
     4249     else do:
     4250       assign v-i = center-field( 1, 31, v-length ) .
     4251       do v-j = 1 to 31 :
     4252         if v-j <> v-i then do:
     4253           assign v-result = v-result + " " .
     4254         end.
     4255         else do:
     4256           assign
     4257             v-result  = v-result + v-str
     4258             v-j       = v-j + length(v-str) - 1
     4259           .
     4260         end.
     4261       end.
     4262     end.
     4263   end.
     4264   end procedure.
     4265   procedure print-footer-list-2 :
