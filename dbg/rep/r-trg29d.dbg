     2894   end procedure.
     2895   procedure grp-obj-notcorr-value :
     2896   do
     2897   on error undo, return error
     2898   :
     2899   define input parameter p-node-code             as integer      no-undo.
     2900   define input parameter p-obj-type              as character    no-undo.
     2901   define input parameter p-obj-code              as integer      no-undo.
     2902   define output parameter p-notcorr              as character    no-undo init ?.
     2903   define output parameter p-range-notcorr     as integer      no-undo.
     2904   define output parameter p-exists-notcorr    as logical      no-undo.
     2905   define variable v-host-code as integer      no-undo.
     2906   DEFINE VARIABLE v-found as logical no-undo .
     2907   DEFINE VARIABLE v-exists as logical no-undo .
     2908   DEFINE VARIABLE v-range as integer no-undo .
     2909   DEFINE VARIABLE jj as integer no-undo .
     2910   DEFINE VARIABLE v-notcorr-found as logical no-undo .
     2911   DEFINE VARIABLE v-notcorr-value as char      no-undo.
     2912   define buffer buf_gds-grp for ub.gds-grp.
     2913   define buffer buf_gds-grp-obj-attr for ub.gds-grp-obj-attr  .
     2914   find first buf_gds-grp no-lock where
     2915              buf_gds-grp.node-code = p-node-code no-error .
     2916   if not avail buf_gds-grp and p-node-code <> 0 then do:
     2917     message
     2918       vss-workfile vss-revision vss-description
     2919       skip "Не удалось найти группу товаров с кодом" p-node-code
     2920       view-as alert-box error .
     2921     undo, return error .
     2922   end.
     2923   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2924   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2925     (input  p-obj-type
     2926     ,input  p-obj-code
     2927     ,output v-host-code
     2928     ) no-error .
     2929   if error-status :error
     2930   then do:
     2931       message
     2932         vss-workfile vss-revision vss-description
     2933         skip "Не удалось найти фирму объекта"
     2934         skip p-obj-type p-obj-code
     2935         skip return-value
     2936         skip trim(error-status :get-message(1))
     2937       view-as alert-box error.
     2938       undo, return error .
     2939   end.
     2940   define buffer buf_gds-grp-obj      for ub.gds-grp-obj.
     2941   do while v-found = no and jj < 2:
     2942     if v-range <> 3 then do:
     2943       find first buf_gds-grp-obj no-lock
     2944           where buf_gds-grp-obj.node-code = p-node-code
     2945             and buf_gds-grp-obj.host-code = v-host-code
     2946             and buf_gds-grp-obj.obj-type  = p-obj-type
     2947             and buf_gds-grp-obj.obj-code  = p-obj-code
     2948       no-error .
     2949     end.
     2950     if v-range = 3 or not available buf_gds-grp-obj
     2951     then do:
     2952        if v-range <> 2 then do:
     2953           find first buf_gds-grp-obj no-lock
     2954               where buf_gds-grp-obj.node-code = p-node-code
     2955                 and buf_gds-grp-obj.host-code = v-host-code
     2956                 and buf_gds-grp-obj.obj-type  = ""
     2957                 and buf_gds-grp-obj.obj-code  = 0
     2958           no-error .
     2959         end.
     2960         if v-range = 2 or not available buf_gds-grp-obj
     2961         then do:
     2962             if v-range <> 1 then do:
     2963               find first buf_gds-grp-obj no-lock
     2964                   where buf_gds-grp-obj.node-code = p-node-code
     2965                   and buf_gds-grp-obj.host-code = 0
     2966                   and buf_gds-grp-obj.obj-type  = ""
     2967                   and buf_gds-grp-obj.obj-code  = 0
     2968               no-error .
     2969             end.
     2970             if v-range = 1 or not available buf_gds-grp-obj
     2971             then do:
     2972                 assign
     2973                     v-exists = no
     2974                 .
     2975             end.
     2976             else do:
     2977                 assign
     2978                     v-exists = yes
     2979                     v-range = 1
     2980                 .
     2981             end.
     2982         end.
     2983         else do:
     2984             assign
     2985                 v-exists = yes
     2986                 v-range  = 2
     2987             .
     2988         end.
     2989     end.
     2990     else do:
     2991         assign
     2992             v-exists = yes
     2993             v-range  = 3
     2994         .
     2995     end.
     2996     if available buf_gds-grp-obj
     2997     then do:
     2998       find first buf_gds-grp-obj-attr no-lock
     2999         where buf_gds-grp-obj-attr.node-code   = p-node-code
     3000           and buf_gds-grp-obj-attr.host-code   = buf_gds-grp-obj.host-code
     3001           and buf_gds-grp-obj-attr.obj-type    = buf_gds-grp-obj.obj-type
     3002           and buf_gds-grp-obj-attr.obj-code    = buf_gds-grp-obj.obj-code
     3003           and buf_gds-grp-obj-attr.attr-code   = 'NotCorrOP':U
     3004         no-error .
     3005       if available buf_gds-grp-obj-attr then do:
     3006         assign
     3007           v-notcorr-value = (if buf_gds-grp-obj-attr.attr-value = '' then ? else buf_gds-grp-obj-attr.attr-value)
     3008         .
     3009       end.
     3010       else do:
     3011         assign
     3012           v-notcorr-value = ?
     3013         .
     3014       end.
     3015       assign
     3016       p-exists-notcorr = (if v-notcorr-value <> ? and p-notcorr = ?
     3017                           then yes
     3018                           else p-exists-notcorr)
     3019       p-range-notcorr = if p-exists-notcorr and p-notcorr = ?
     3020                         then v-range
     3021                         else p-range-notcorr
     3022       p-notcorr   =  if p-exists-notcorr and  p-notcorr = ?
     3023                         then v-notcorr-value
     3024                         else p-notcorr
     3025       v-found =  (p-exists-notcorr ) or (v-range <= 1)
     3026       jj = jj + 1
     3027       .
     3028     end.
     3029     else do:
     3030       assign
     3031       v-found =  (p-exists-notcorr  ) or (v-range <= 1)
     3032       jj = jj + 1
     3033       .
     3034     end.
     3035   end.
     3036   end.
     3037   end procedure.
     3038   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3039   define variable g#report-num   as integer no-undo .
     3040   run get-report-num in parparentproc (output g#report-num).
     3041   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3042   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3043   define  stream PrnLibStream.
     3044   procedure prn-lib-prn-file :
     3045     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3046     define input parameter p-DIsabledoptions as integer no-undo .
     3047     define variable v-report-name as character no-undo .
     3048     define variable v-user-action as character no-undo .
     3049     define variable v-printed     as logical   no-undo .
     3050     define variable v-exist       as logical   no-undo .
     3051     do
     3052       on error undo, return error
     3053       :
     3054       run prn-lib-get-report-name  in this-procedure (
     3055         input parParentProc
     3056         ,output v-report-name
     3057         ).
     3058   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3059   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     3060     (input  v-report-name
     3061     ,input  2
     3062     ,output v-exist
     3063     )  .
     3064       if NOT v-exist then
     3065       DO:
     3066         Message
     3067           "Нет заданий на печать ! "
     3068           view-as alert-box .
     3069         Return  .
     3070       End.
     3071       run gbl/prnfilen.w
     3072         (input  ""
     3073         ,input  p-DisabledOptions
     3074         ,input  string(v-report-name )
     3075         ,input  7
     3076         ,output v-user-action
     3077         ,output v-printed
     3078         ) .
     3079       if v-printed then
     3080       do:
     3081         return "YES" .
     3082       end.
     3083       else
     3084       do:
     3085         return "NO" .
     3086       end.
     3087     end.
     3088   end procedure.
     3089   procedure prn-lib-open-stream :
     3090     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3091     define input parameter p-page-size    as integer no-undo .
     3092     define input parameter p-is-stream    as logical no-undo .
     3093     define input parameter p-append       as logical no-undo .
     3094     define variable v-report-name as character no-undo .
     3095     do
     3096       on error undo, return error
     3097       :
     3098       run prn-lib-get-report-name  in this-procedure (
     3099         input parParentProc
     3100         ,output v-report-name
     3101         ).
     3102       if p-is-stream then
     3103       do:
     3104         if p-append then
     3105         do:
     3106           output stream PrnLibStream to value( v-report-name )
     3107             page-size value(p-page-size) append .
     3108         end.
     3109         if not p-append then
     3110         do:
     3111           output stream PrnLibStream to value( v-report-name )
     3112             page-size value(p-page-size) .
     3113         end.
     3114       end.
     3115       if not p-is-stream then
     3116       do:
     3117         if p-append then
     3118         do:
     3119           output to value( v-report-name )
     3120             page-size value(p-page-size) append .
     3121         end.
     3122         if not p-append then
     3123         do:
     3124           output to value( v-report-name )
     3125             page-size value(p-page-size) .
     3126         end.
     3127       end.
     3128     end.
     3129   end procedure.
     3130   procedure prn-lib-open-exp :
     3131     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3132     define input parameter p-is-stream    as logical no-undo .
     3133     define input parameter p-is-append    as logical no-undo .
     3134     define output parameter p-ReportFileName as char init "report" no-undo.
     3135     define output parameter p-process as logical no-undo .
     3136     define variable glog as logical no-undo .
     3137     do
     3138       on error undo, return error
     3139       :
     3140       SYSTEM-DIALOG GET-FILE p-ReportFileName
     3141         TITLE      "Укажите путь"
     3142         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     3143         ASK-OVERWRITE
     3144         CREATE-TEST-FILE
     3145         SAVE-AS
     3146         USE-FILENAME
     3147         DEFAULT-EXTENSION "txt"
     3148         UPDATE glog
     3149         .
     3150       if not glog then  return.
     3151       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     3152       if p-is-stream then
     3153       do:
     3154         if p-is-append then
     3155         do:
     3156           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3157         end.
     3158         else
     3159         do:
     3160           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3161         end.
     3162       end.
     3163       else
     3164       do:
     3165         if p-is-append then
     3166         do:
     3167           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     3168         end.
     3169         else
     3170         do:
     3171           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     3172         end.
     3173       end.
     3174       p-process = yes.
     3175     end.
     3176   end procedure.
     3177   procedure prn-lib-get-report-name :
     3178     define input parameter parParentProc  as widget-handle no-undo.
     3179     define output parameter p-report-name as character no-undo .
     3180     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     3181   end procedure.
     3182   procedure prn-lib-reportviewer-report-name :
     3183     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3184     define input parameter p-report-name-html as character no-undo .
     3185     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     3186   end procedure.
     3187   procedure prn-lib-reportviewer :
     3188     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     3189     define input parameter p-report-name-html as character no-undo .
     3190     define input parameter p-param        as character no-undo .
     3191     define variable v-excel           as character no-undo init 'TRUE' .
     3192     define variable v-value-character as character no-undo .
     3193     define variable v-value-integer   as character no-undo .
     3194     define variable v-value-date      as date      no-undo .
     3195     define variable v-value-decimal   as decimal   no-undo .
     3196     define variable rep-excel         as logical   no-undo .
     3197     define variable excel-string      as character no-undo .
     3198     define variable v-param-type      as character no-undo .
     3199     define variable v-tth             as handle    no-undo .
     3200     run adm/shattri.p (
     3201       input "get":U
     3202       ,input  ""
     3203       ,input  0
     3204       ,input  'report-glob':U
     3205       ,input  'rep-excel':U
     3206       ,output v-value-character
     3207       ,output v-value-date
     3208       ,output v-value-decimal
     3209       ,output v-value-integer
     3210       ,output rep-excel
     3211       ,output v-param-type
     3212       ,INPUT-OUTPUT table-handle v-tth
     3213       )  .
     3214     if rep-excel then v-excel = "TRUE" .
     3215     else v-excel = "FALSE" .
     3216     if p-param eq ""
     3217     then
     3218        p-param = "EXCEL:" + v-excel.
     3219     else
     3220        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     3221     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     3222   end procedure.
     3223   procedure reprumpr_print-plain-text :
     3224   define input parameter p-dir-name as character no-undo .
     3225   define input parameter p-subdir-name as character no-undo .
     3226   define input parameter p-custom-name as character no-undo .
     3227   define input parameter p-disable-option as integer no-undo .
     3228   define input parameter p-font-number as integer no-undo .
