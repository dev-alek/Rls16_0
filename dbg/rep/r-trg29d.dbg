     2865     define output parameter p-section-num    as integer no-undo .
     2866     do
     2867     on error undo, return error
     2868     :
     2869           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-manual-edit in g#attr-lib
     2870         (input  p-code
     2871         ,output p-section-num
     2872         ) no-error .
     2873       if error-status :error
     2874       then do:
     2875         undo, return error return-value .
     2876       end.
     2877     end.
     2878   end procedure.
     2879   procedure ggoattr-batch-edit :
     2880     define input  parameter p-code           as character no-undo .
     2881     define output parameter p-section-num    as integer no-undo .
     2882     do
     2883     on error undo, return error
     2884     :
     2885           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run ggoattr-batch-edit in g#attr-lib
     2886         (input  p-code
     2887         ,output p-section-num
     2888         ) no-error .
     2889       if error-status :error
     2890       then do:
     2891         undo, return error return-value .
