      604   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      605   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      606   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      607   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      608   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      609   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      610   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      611   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      612   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      613   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      614   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      615   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      616   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      617   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      618   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      619   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      620   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      621   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      622   define variable temp1 as integer   no-undo.
      623   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      624   procedure factord :
      625     define input  parameter p-fact-date            as date    no-undo .
      626     define input  parameter p-fact-time            as integer no-undo .
      627     define input  parameter p-fact-num             as integer no-undo .
      628     define input  parameter p-shift-date           as date    no-undo .
      629     define input  parameter p-shift-num            as integer no-undo .
      630     define input  parameter p-shift-on             as logical no-undo .
      631     define output parameter p-fact-order           as decimal no-undo .
      632     define output parameter p-shift-end-fact-order as decimal no-undo .
      633     define output parameter p-day-end-fact-order   as decimal no-undo .
      634     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      635     if p-fact-date = ?
      636     then do:
      637       return error "Не указана фактическая дата" .
      638     end.
      639     define variable v-fact-date-num as integer no-undo .
      640     assign
      641       v-fact-date-num = integer(p-fact-date)
      642     .
      643     if p-fact-num = ?
      644     or p-fact-num = 0
      645     then do:
      646       return error "Не задан p-fact-num " + string(p-fact-num) .
      647     end.
      648     if p-fact-num < 0
      649     then do:
      650       return error "Отрицательный fact-num " + string(p-fact-num) .
      651     end.
      652     if p-fact-num >= 100000000
      653     then do:
      654       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      655     end.
      656     if p-shift-on = true
      657     then do:
      658       if p-shift-date = ?
      659       then do:
      660         return error "Не задана дата смены" .
      661       end.
      662       if p-shift-num = ?
      663       or p-shift-num = 0
      664       then do:
      665         return error "Не задан номер смены" .
      666       end.
      667     end.
      668     else do:
      669       assign
      670         p-shift-date = p-fact-date
      671         p-shift-num  = 24
      672       .
      673     end.
      674     define variable v-shift-offset as integer no-undo .
      675     if p-shift-date = p-fact-date
      676     then do:
      677       assign
      678         v-shift-offset = 1
      679       .
      680     end.
      681     if p-shift-date < p-fact-date
      682     then do:
      683       assign
      684         v-shift-offset = 0
      685       .
      686     end.
      687     if p-shift-date > p-fact-date
      688     then do:
      689       message
      690         vss-workfile vss-revision vss-description skip
      691         "Неправильная дата закрытия смены" skip
      692         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      693         view-as alert-box error .
      694       undo, return error
      695         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      696           ,string(p-fact-date, '99/99/9999':U)
      697           ,string(p-shift-date, '99/99/9999':U)
      698           )
      699       .
      700     end.
      701     if p-shift-num < 1
      702     or p-shift-num > 24
      703     then do:
      704       message
      705         vss-workfile vss-revision vss-description skip
      706         "Неправильный номер смены" skip
      707         "p-shift-num" p-shift-num skip
      708         view-as alert-box error .
      709       undo, return error return-value .
      710     end.
      711     assign
      712       p-fact-order           = v-fact-date-num
      713                              + v-shift-offset * 0.5
      714                              + p-shift-num    * 0.02 - 0.01
      715                              + p-fact-num     * 0.0000000001
      716       p-shift-end-fact-order = v-fact-date-num
      717                              + v-shift-offset * 0.5
      718                              + p-shift-num    * 0.02
      719       p-day-end-fact-order   = v-fact-date-num
      720                              + 0.99
      721     .
      722     if p-fact-order           <= v-fact-date-num
      723     or p-shift-end-fact-order <= v-fact-date-num
      724     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      725     or p-shift-end-fact-order >= p-day-end-fact-order
      726     then do:
      727       message
      728         vss-workfile vss-revision vss-description skip
      729         "Внутренняя ошибка при генерации фактического номера" skip
      730         "p-fact-date"            p-fact-date            skip
      731         "p-fact-time"            p-fact-time            skip
      732         "p-fact-num"             p-fact-num             skip
      733         "p-shift-date"           p-shift-date           skip
      734         "p-shift-num"            p-shift-num            skip
      735         "p-shift-on"             p-shift-on             skip
      736         "p-shift-end-fact-order" p-shift-end-fact-order skip
      737         "p-day-end-fact-order"   p-day-end-fact-order   skip
      738         "v-fact-date-num"        v-fact-date-num        skip
      739         view-as alert-box error .
      740       undo, return error return-value .
      741     end.
      742   end procedure.
      743   procedure day-begin-fact-order :
      744     define input  parameter p-fact-date            as date    no-undo .
      745     define output parameter p-day-begin-fact-order as decimal no-undo .
      746     do
      747     on error undo, return error return-value
      748     :
      749       if p-fact-date = ?
      750       then do:
      751         assign
      752           p-day-begin-fact-order = 0
      753         .
      754       end.
      755       else do:
      756         assign
      757           p-day-begin-fact-order = integer(p-fact-date)
      758         .
      759       end.
      760     end.
      761   end procedure.
      762   procedure factord-max-fact-order :
      763     define output parameter p-max-fact-order as decimal   no-undo .
      764     do
      765     on error undo, return error return-value
      766     :
      767       run day-begin-fact-order in this-procedure
      768         (input  date(1, 1, 5000)
      769         ,output p-max-fact-order
      770         ) .
      771     end.
      772   end procedure.
      773   procedure factord-cut-archive :
      774     define input  parameter p-obj-type             as character no-undo .
      775     define input  parameter p-obj-code             as integer   no-undo .
      776     define input  parameter p-fact-date            as date      no-undo .
      777     define output parameter p-shift-on             as logical   no-undo .
      778     define output parameter p-shift-date           as date      no-undo .
      779     define output parameter p-shift-num            as integer   no-undo .
      780     define output parameter p-day-end-fact-order   as decimal   no-undo .
      781     define output parameter p-shift-end-fact-order as decimal   no-undo .
      782     define variable v-fact-order as decimal   no-undo .
      783     define buffer buf_shift-obj for ub.shift-obj .
      784     do
      785     on error undo, return error return-value
      786     :
      787   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      788   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      789     (input  p-obj-type
      790     ,input  p-obj-code
      791     ,input  'shift-on=request'
      792     ,output p-shift-on
      793     ) no-error .
      794       if error-status :error
      795       then do:
      796         message
      797           vss-workfile vss-revision vss-description skip
      798           "Ошибка при определении атрибута объекта" skip
      799           "Объект" p-obj-type p-obj-code skip
      800           error-status :get-message(1) skip
      801           return-value skip
      802           view-as alert-box error .
      803         undo, return error return-value .
      804       end.
      805       if p-shift-on = false
      806       then do:
      807         assign
      808           p-shift-date               = ?
      809           p-shift-num                = 0
      810         .
      811       end.
      812       else do:
      813         find first buf_shift-obj share-lock
      814           where buf_shift-obj.obj-type   = p-obj-type
      815             and buf_shift-obj.obj-code   = p-obj-code
      816             and buf_shift-obj.shift-date > p-fact-date
      817           use-index pi
      818           no-error .
      819         if not available buf_shift-obj
      820         or buf_shift-obj.status_ <> 'зкр':U
      821         then do:
      822           message
      823             vss-workfile vss-revision vss-description skip
      824             "Невозможно вычислить последнюю смену" skip
      825             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      826             "Объект" p-obj-type p-obj-code skip
      827             "Дата" p-fact-date skip
      828             view-as alert-box error .
      829           undo, return error return-value .
      830         end.
      831         find last buf_shift-obj share-lock
      832           where buf_shift-obj.obj-type = p-obj-type
      833             and buf_shift-obj.obj-code = p-obj-code
      834             and buf_shift-obj.shift-date <= p-fact-date
      835           use-index pi
      836           no-error .
      837         if available buf_shift-obj
      838         then do:
      839           if  buf_shift-obj.status_ = 'зкр':U
      840           then do:
      841             assign
      842               p-shift-date = buf_shift-obj.shift-date
      843               p-shift-num  = buf_shift-obj.shift-num
      844             .
      845           end.
      846           else do:
      847             message
      848               vss-workfile vss-revision vss-description skip
      849               "Невозможно вычислить последнюю смену" skip
      850               "Статус смены отличен от статуса" 'зкр':U skip
      851               "Объект" p-obj-type p-obj-code skip
      852               "Дата" p-fact-date skip
      853               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      854               view-as alert-box error .
      855             undo, return error return-value .
      856           end.
      857         end.
      858         else do:
      859           assign
      860             p-shift-date = p-fact-date - 1
      861             p-shift-num  = 1
      862           .
      863         end.
      864       end.
      865       run factord in this-procedure
      866         (input  p-fact-date
      867         ,input  1
      868         ,input  1
      869         ,input  p-shift-date
      870         ,input  p-shift-num
      871         ,input  p-shift-on
      872         ,output v-fact-order
      873         ,output p-shift-end-fact-order
      874         ,output p-day-end-fact-order
      875         ) no-error .
      876       if error-status :error
      877       then do:
      878         message
      879           vss-workfile vss-revision vss-description skip
      880           "Ошибка при вызове процедуры factord"
      881           error-status :get-message(1) skip
      882           return-value skip
      883           view-as alert-box error .
      884         undo, return error return-value .
      885       end.
      886     end.
      887   end procedure.
      888   procedure factord-lock-shift :
      889     define input  parameter p-obj-type  as character no-undo .
      890     define input  parameter p-obj-code  as integer   no-undo .
      891     define input  parameter p-fact-date as date      no-undo .
      892     define parameter buffer buf_shift-obj for ub.shift-obj .
      893     define variable v-shift-on      as logical   no-undo .
      894     define variable v-extra-message as character no-undo .
      895     define variable v-error as character no-undo .
      896     do
      897     on error undo, return error return-value
      898     :
      899   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      900   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      901     (input  p-obj-type
      902     ,input  p-obj-code
      903     ,input  'shift-on=request'
      904     ,output v-shift-on
      905     ) no-error .
      906       if error-status :error
      907       then do:
      908         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      909         undo, return error v-error .
      910       end.
      911       if v-shift-on = true
      912       then do:
      913         find first buf_shift-obj share-lock
      914           where buf_shift-obj.obj-type   = p-obj-type
      915             and buf_shift-obj.obj-code   = p-obj-code
      916             and buf_shift-obj.shift-date > p-fact-date
      917           use-index pi
      918           no-error .
      919         if not available buf_shift-obj
      920         or buf_shift-obj.status_ <> 'зкр':U
      921         then do:
      922           find last buf_shift-obj
      923             where buf_shift-obj.obj-type = p-obj-type
      924               and buf_shift-obj.obj-code = p-obj-code
      925               and buf_shift-obj.status_  = 'зкр':U
      926             use-index stts
      927             no-error .
      928           if available buf_shift-obj
      929           then do:
      930             assign
      931               v-extra-message =
      932                     substitute("Дата начала последеней закрытой смены на объекте &1"
      933                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      934                               )
      935             .
      936           end.
      937           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      938           undo, return error v-error .
      939         end.
      940       end.
      941     end.
      942   end procedure.
      943   procedure factord-end-day :
      944     define input  parameter p-fact-date            as date    no-undo .
      945     define output parameter p-day-end-fact-order   as decimal no-undo .
      946     do
      947     on error undo, return error return-value
      948     :
      949       if p-fact-date = ?
      950       then do:
      951         return error "Не указана фактическая дата" .
      952       end.
      953       assign
      954         p-day-end-fact-order = integer(p-fact-date) + 0.99
      955       .
      956     end.
      957   end procedure.
      958   procedure factord-to-date :
      959     define input  parameter p-fact-order as decimal no-undo .
      960     define output parameter p-fact-date  as date    no-undo .
      961     define variable v-ref-date  as date      no-undo .
      962     define variable v-ref-delta as integer   no-undo .
      963     do
      964     on error undo, return error return-value
      965     :
      966       if p-fact-order = ?
      967       or p-fact-order = 0
      968       then do:
      969         return error "Не указан fact-order" .
      970       end.
      971       assign
      972         v-ref-date  = date(1, 1, 2000)
      973       .
      974       assign
      975         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      976       .
      977       assign
      978         p-fact-date = v-ref-date + v-ref-delta
      979       .
      980     end.
      981   end procedure.
      982   procedure factord-to-fact-num :
      983     define input  parameter p-fact-order as decimal no-undo .
      984     define output parameter p-fact-num   as integer no-undo .
      985     define variable v-fact-order-trunc as decimal no-undo .
      986     do
      987     on error undo, return error return-value
      988     :
      989       if p-fact-order = ?
      990       or p-fact-order = 0
      991       then do:
      992         return error "Не указан fact-order" .
      993       end.
      994       assign
      995        v-fact-order-trunc = truncate(p-fact-order, 2)
      996       .
      997       assign
      998         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      999       .
     1000     end.
     1001   end procedure.
     1002   procedure factord-to-shift-num :
     1003     define input  parameter p-fact-order as decimal no-undo .
     1004     define output parameter p-shift-num   as integer no-undo .
     1005     define variable  p-shift-numd  as decimal   no-undo .
     1006     define variable v-fact-order-trunc as decimal no-undo .
     1007     do
     1008     on error undo, return error return-value
     1009     :
     1010       if p-fact-order = ?
     1011       or p-fact-order = 0
     1012       then do:
     1013         return error "Не указан fact-order" .
     1014       end.
     1015       assign
     1016        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1017       .
     1018       if v-fact-order-trunc < 0.5 then do:
     1019         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1020       end.
     1021       assign
     1022         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1023         .
     1024        assign
     1025         p-shift-num = truncate (p-shift-numd , 0)
     1026       .
     1027     end.
     1028   end procedure.
     1029   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1030   define variable v-waitfram-action01         as character   no-undo .
     1031   define variable v-waitfram-action02         as character   no-undo .
     1032   define variable v-waitfram-action03         as character   no-undo .
     1033   define variable mWaitFramTextBeg            as character   no-undo.
     1034   define variable mWaitFramTextEnd            as character   no-undo.
     1035   define variable mWaitFramView               as logical     no-undo.
     1036   define variable mWaitProcEvent              as logical     no-undo init yes.
     1037   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1038   define variable mWaitFramStop               as logical     no-undo.
     1039   define variable mWaitFramStopUser           as logical     no-undo.
     1040   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1041   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1042   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1043   define button B-WaitFramStop auto-end-key
     1044        label "Стоп"
     1045        size 10 by 1 tooltip "Остоновить процесс".
     1046   define button B-viewProcInfo
     1047        label "Информация"
     1048        size 15 by 1 tooltip "Информация о процесс".
     1049   define frame waitfram
     1050     v-waitfram-action01 format "x(72)" no-label skip
     1051     v-waitfram-action02 format "x(72)" no-label skip
     1052     v-waitfram-action03 format "x(72)" no-label skip
     1053     B-viewProcInfo
     1054     B-WaitFramStop at row 4 col 30
     1055     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1056     .
     1057   define new global shared variable mBatchMode as logical no-undo init ?.
     1058   define variable mFramBachModHandle as handle no-undo.
     1059   mFramBachModHandle = frame waitfram:handle.
     1060   define variable mFameOldVis as logical no-undo.
     1061   define variable mVisCUrentVin as logical no-undo.
     1062   if session:batch-mode
     1063   then
     1064      mBatchMode = yes.
     1065   if mBatchMode = ? then do:
     1066     mVisCUrentVin = current-window:visible.
     1067     mFameOldVis = mFramBachModHandle:visible.
     1068     mFramBachModHandle:visible  = yes.
     1069     mBatchMode = mFramBachModHandle:visible ne yes.
     1070     mFramBachModHandle:visible = mFameOldVis.
     1071     current-window:visible = mVisCUrentVin.
     1072   end.
     1073    if  log-manager:logfile-name ne ?
     1074     then DO:
     1075         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1076         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1077         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1078     end.
     1079   on choose of B-WaitFramStop in frame waitfram
     1080   do:
     1081     mWaitFramStop = yes.
     1082     mWaitFramStopUser = yes.
     1083   end.
     1084   function waitfram-check-timeout returns logical():
     1085      define variable vtime as int64 no-undo.
     1086      if mWaitFramStopTimeOut
     1087      then
     1088         return yes.
     1089      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1090      if     mWaitFramTimeOut ne ?
     1091         and mWaitFramTimeOut ne 0
     1092         and mWaitFramTimeOut lt vtime
     1093      then do:
     1094         mWaitFramStopTimeOut = yes.
     1095      end.
     1096      return mWaitFramStopTimeOut.
     1097   end.
     1098   procedure waitfram-hide :
     1099     if not session:batch-mode
     1100     then do
     1101     on error undo, return error return-value
     1102     :
     1103       pause 0 before-hide .
     1104       if not mBatchMode then
     1105         hide frame waitfram .
     1106     if     not mWaitFramView
     1107        and mWaitProcEvent
     1108     then
     1109       process events .
     1110     end.
     1111   end procedure.
     1112   procedure waitfram-show :
     1113     define input  parameter p-message as character no-undo .
     1114     define variable v-left-margin as integer   no-undo .
     1115     if not session:batch-mode
     1116     then do
     1117     on error undo, return error return-value
     1118     :
     1119       if length(p-message) <= 70 then do:
     1120         assign
     1121           v-left-margin = integer((70 - length(p-message)) / 2)
     1122         .
     1123         assign
     1124           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1125         .
     1126         assign
     1127           v-waitfram-action01 = " "
     1128           v-waitfram-action02 = " "
     1129                                    + fill(" ", v-left-margin)
     1130                                    + p-message
     1131           v-waitfram-action03 = " "
     1132         .
     1133       end.
     1134       else do:
     1135         define variable vRindex1 as integer no-undo.
     1136         define variable vRindex2 as integer no-undo.
     1137         vRindex1 = r-index(p-message," ",70).
     1138         if vRindex1 = 0
     1139         then
     1140            vRindex1 = 70.
     1141         if length(p-message)  <= vRindex1 + 70 then do:
     1142           assign
     1143             v-waitfram-action01 = " "
     1144             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1145             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1146           .
     1147         end.
     1148         else do:
     1149           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1150           if vRindex2 <= vRindex1
     1151           then
     1152              vRindex2 = vRindex1 + 70.
     1153           assign
     1154             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1155             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1156             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1157           .
     1158         end.
     1159       end.
     1160       B-viewProcInfo:visible   in frame waitfram = no.
     1161       B-viewProcInfo:sensitive in frame waitfram = no.
     1162       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1163       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1164       if  (   mWaitFramView
     1165          or  mWaitProcEvent)
     1166          and not mBatchMode
     1167       then
     1168          display
     1169             v-waitfram-action01 skip
     1170             v-waitfram-action02 skip
     1171             v-waitfram-action03 skip
     1172          with frame waitfram .
     1173       if     mWaitFramView
     1174          then do:
     1175             if     mWaitFramInterval ne ?
     1176                and not mBatchMode
     1177             then
     1178                wait-for go of frame waitfram pause mWaitFramInterval.
     1179          end.
     1180          else
     1181             if     mWaitProcEvent
     1182                and not mBatchMode
     1183             then
     1184                process events .
     1185     end.
     1186   end procedure.
     1187      procedure waitfram-show-this:
     1188         define input  parameter iInterval as int64 no-undo.
     1189         define variable vtime as int64 no-undo.
     1190         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1191         mWaitFramInterval = iInterval.
     1192         run waitfram-show (substitute("&1&2 &3&4" ,
     1193                                       mWaitFramTextBeg ,
     1194                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1195                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1196                                       mWaitFramTextEnd
     1197                                      )
     1198                           ).
     1199      end.
     1200      procedure WaitFramRunPause:
     1201         define input  parameter iInterval as dec no-undo.
     1202         define variable vStart  as datetime-tz no-undo.
     1203         define variable vend    as datetime-tz no-undo.
     1204         define variable vint as int64 no-undo.
     1205         define variable vOk as logical no-undo.
     1206         vStart = now.
     1207         vend   = vStart.
     1208         publish "WaitFramPause" (iInterval,output vOk).
     1209         vend   =  now.
     1210         vint = vend - vStart.
     1211         vint = iInterval - vint / 1000.
     1212         if     not mWaitFramStop
     1213            and (   vint > 0
     1214                 or (    not vOk
     1215                     and iInterval eq ?
     1216                     )
     1217                 )
     1218         then
     1219            run waitfram-show-this (iInterval).
     1220         vend   =  now.
     1221         vint = vend - vStart.
     1222         vint = iInterval - vint / 1000.
     1223         if     not mWaitFramStop
     1224            and vint > 0
     1225         then do:
     1226            run gbl/pause.p (vint * 1000).
     1227         end.
     1228         if iInterval ne ?
     1229         then
     1230            publish "WaitFramStop".
     1231         waitfram-check-timeout().
     1232      end.
     1233      procedure WaitFramWaitFor:
     1234         define input  parameter iInterval as dec no-undo.
     1235         assign
     1236            mWaitFramStartProc   = now
     1237            mWaitFramStopUser    = no
     1238            mWaitFramStopTimeOut = no
     1239         .
     1240         block-wait:
     1241         do while not mWaitFramStop:
     1242            run WaitFramRunPause (iInterval).
     1243            if  waitfram-check-timeout()
     1244            then do:
     1245               leave block-wait.
     1246            end.
     1247         end.
     1248         run waitfram-hide.
     1249      end.
     1250   procedure waitfram-join :
     1251     define input  parameter p-line-1  as character no-undo .
     1252     define input  parameter p-line-2  as character no-undo .
     1253     define input  parameter p-line-3  as character no-undo .
     1254     define output parameter p-message as character no-undo .
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258       assign
     1259         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1260                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1261                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1262       .
     1263     end.
     1264   end procedure.
     1265   function waitfram-join-function returns character
     1266     (input p-line-1 as character
     1267     ,input p-line-2 as character
     1268     ,input p-line-3 as character
     1269     ).
     1270     define variable v-message as character no-undo .
     1271     run waitfram-join in this-procedure
     1272       (input  p-line-1
     1273       ,input  p-line-2
     1274       ,input  p-line-3
     1275       ,output v-message
     1276       ) .
     1277     return v-message .
     1278   end function .
     1279   define variable vss-include-info12 as character format "X(65)" no-undo
     1280   initial "@(#)$Workfile$ $Revision$".
     1281   define temp-table temp_p-fmt_string-part no-undo
     1282       field str-key       as integer
     1283       field string-part   as character
     1284       index pi is primary unique
     1285           str-key
     1286   .
     1287   define variable v-p-fmt-12-str-key    as integer      no-undo.
     1288   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     1289                                     iInput AS INTEGER).
     1290     def var v-start-print as integer no-undo .
     1291     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     1292     assign
     1293       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     1294     .
     1295     RETURN v-start-print .
     1296   END FUNCTION.
     1297   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     1298                                     iInput AS INTEGER).
     1299     def var v-start-print as integer no-undo .
     1300     assign
     1301       v-start-print = INTEGER(iEndPix - 1 - iInput)
     1302     .
     1303     if v-start-print < 0 then return 0.
     1304     RETURN v-start-print .
     1305   END FUNCTION.
     1306   function p-fmt-align-string returns character (
     1307         p-in-string      as character
     1308       , p-page-width     as integer
     1309       , p-align-type     as character
     1310   ).
     1311       define variable v-string-length     as integer      no-undo.
     1312       define variable v-out-string        as character    no-undo.
     1313       assign
     1314           v-string-length = length( trim( p-in-string ) )
     1315       .
     1316       if v-string-length >= p-page-width
     1317       then do:
     1318           assign
     1319               v-out-string = trim( p-in-string )
     1320           .
     1321       end.
     1322       else do:
     1323           case p-align-type
     1324           :
     1325               when 'left':U
     1326               then do:
     1327                   assign
     1328                       v-out-string = trim( p-in-string )
     1329                   .
     1330               end.
     1331               when 'right':U
     1332               then do:
     1333                   assign
     1334                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     1335                   .
     1336               end.
     1337               when 'center':U
     1338               then do:
     1339                   assign
     1340                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     1341                   .
     1342               end.
     1343           end case.
     1344       end.
     1345       return v-out-string .
     1346   end function.
     1347   procedure p-fmt-split-string :
     1348   define input parameter p-source-string  as character        no-undo.
     1349   define input parameter p-split-length   as integer          no-undo.
     1350   define output parameter p-string-1      as character        no-undo.
     1351   define output parameter p-string-2      as character        no-undo.
     1352   do
     1353   on error undo, return error
     1354   :
     1355       define variable v-space-pos    as integer      no-undo.
     1356       if length( p-source-string ) <= p-split-length
     1357       then do:
     1358           assign
     1359               p-string-1 = p-source-string
     1360           .
     1361       end.
     1362       else do:
     1363           assign
     1364               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     1365           .
     1366           if v-space-pos = 0
     1367           then do:
     1368               assign
     1369                   v-space-pos = index( p-source-string, " ":U )
     1370               .
     1371           end.
     1372           if v-space-pos = 0
     1373           then do:
     1374               assign
     1375                   p-string-1 = substring( p-source-string, 1, p-split-length )
     1376                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     1377               .
     1378           end.
     1379           else do:
     1380               assign
     1381                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     1382                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     1383               .
     1384           end.
     1385       end.
     1386   end.
     1387   end procedure.
     1388   procedure p-fmt-round :
     1389   define input parameter p-qnty               as decimal          no-undo.
     1390   define input parameter p-price-no-VAT       as decimal          no-undo.
     1391   define input parameter p-VAT                as decimal          no-undo.
     1392   define input parameter p-SLT                as decimal          no-undo.
     1393   define input parameter p-road-tax           as decimal          no-undo.
     1394   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     1395   define output parameter p-new-VAT           as decimal          no-undo.
     1396   define output parameter p-new-SLT           as decimal          no-undo.
     1397   define output parameter p-new-sum-VAT       as decimal          no-undo.
     1398   define output parameter p-new-sum-SLT       as decimal          no-undo.
     1399   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     1400   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     1401   define output parameter p-new-sum-full      as decimal          no-undo.
     1402       define variable v-vat-pc    as decimal      no-undo.
     1403       define variable v-slt-pc    as decimal      no-undo.
     1404   do
     1405   on error undo, return error
     1406   :
     1407       if p-price-no-VAT = 0
     1408       then do:
     1409           assign
     1410               p-new-price-no-VAT = 0.0
     1411               p-new-VAT          = ?
     1412               p-new-SLT          = ?
     1413               p-new-sum-VAT      = 0.0
     1414               p-new-sum-SLT      = 0.0
     1415               p-new-sum-no-VAT   = 0.0
     1416               p-new-sum-road-tax = 0.0
     1417               p-new-sum-full     = 0.0
     1418           .
     1419       end.
     1420       else do:
     1421           assign
     1422               v-vat-pc            = p-VAT / p-price-no-VAT
     1423               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     1424               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     1425               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     1426               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     1427               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     1428               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     1429               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     1430               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     1431               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     1432           .
     1433       end.
     1434   end.
     1435   end procedure.
     1436   procedure p-fmt-split :
     1437   define input parameter p-in-string      as character        no-undo.
     1438   define input parameter p-split-length   as integer          no-undo.
     1439       define variable v-start-pos     as integer      no-undo.
     1440       define variable v-end-pos       as integer      no-undo.
     1441       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     1442   do
     1443   for buf_temp_p-fmt_string-part
     1444   on error undo, return error
     1445   :
     1446       empty temp-table buf_temp_p-fmt_string-part.
     1447       if p-split-length < 1
     1448       then do:
     1449           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     1450       end.
     1451       assign
     1452           p-in-string                 = trim( p-in-string )
     1453           v-p-fmt-12-str-key   = 0
     1454           v-start-pos                 = 1
     1455           v-end-pos                   = length( p-in-string )
     1456       .
     1457       run p-fmt-get-string-range in this-procedure (
     1458             input p-in-string
     1459           , input p-split-length
     1460           , input v-start-pos
     1461           , output v-start-pos
     1462           , output v-end-pos
     1463       ).
     1464       do while v-end-pos <> 0
     1465       :
     1466           create buf_temp_p-fmt_string-part.
     1467           assign
     1468               v-p-fmt-12-str-key = v-p-fmt-12-str-key + 1
     1469           .
     1470           assign
     1471               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-12-str-key
     1472               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     1473           .
     1474           assign
     1475               v-start-pos = v-end-pos + 1
     1476           .
     1477           run p-fmt-get-string-range in this-procedure (
     1478                 input p-in-string
     1479               , input p-split-length
     1480               , input v-start-pos
     1481               , output v-start-pos
     1482               , output v-end-pos
     1483           ).
     1484       end.
     1485   end.
     1486   end procedure.
     1487   procedure p-fmt-get-string-range :
     1488   define input parameter p-in-string      as character        no-undo.
     1489   define input parameter p-split-length   as integer          no-undo.
     1490   define input parameter p-old-start-pos  as integer          no-undo.
     1491   define output parameter p-start-pos     as integer          no-undo.
     1492   define output parameter p-end-pos       as integer          no-undo.
     1493       define variable v-init-string    as character    no-undo.
     1494       define variable v-temp-char      as character    no-undo.
     1495       define variable v-temp-pos       as integer      no-undo.
     1496       define variable v-counter        as integer      no-undo.
     1497   do
     1498   on error undo, return error
     1499   :
     1500       assign
     1501           p-start-pos   = p-old-start-pos
     1502           v-init-string = substring( p-in-string, p-start-pos )
     1503       no-error.
     1504       if error-status :error
     1505       or trim( v-init-string ) = "":U
     1506       then do:
     1507           assign
     1508               p-end-pos = 0
     1509           .
     1510           undo, return .
     1511       end.
     1512       assign
     1513           v-temp-char   = substring( v-init-string, 1, 1 )
     1514       .
     1515       do
     1516       while trim( v-temp-char ) = "":U
     1517       :
     1518           assign
     1519               p-start-pos     = p-start-pos + 1
     1520               v-init-string   = substring( p-in-string, p-start-pos )
     1521               v-temp-char     = substring( v-init-string, 1, 1 )
     1522           .
     1523       end.
     1524       assign
     1525           v-temp-pos  = p-split-length
     1526           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1527           v-counter   = 0
     1528       .
     1529       search-word-end:
     1530       do
     1531       while trim( v-temp-char ) <> "":U
     1532       :
     1533           assign
     1534               v-counter   = v-counter + 1
     1535           .
     1536           if v-counter > 20
     1537           then do:
     1538               assign
     1539                   v-temp-pos  = p-split-length
     1540               .
     1541               leave search-word-end.
     1542           end.
     1543           assign
     1544               v-temp-pos  = v-temp-pos - 1
     1545               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     1546           .
     1547       end.
     1548       assign
     1549           p-end-pos = p-start-pos + v-temp-pos - 1
     1550       .
     1551   end.
     1552   end procedure.
     1553   define temp-table temp-font no-undo
     1554     field fontnum  as integer
     1555     field fontname as character
     1556     field fontsize as character
     1557     field fonttype as character
     1558     field font-h   as integer
     1559     field font-w   as integer
     1560     field v-row    as integer
     1561     field v-col    as integer
     1562     field v-row-lans as integer
     1563     field v-col-lans as integer
     1564   index pi fontnum
     1565   .
     1566   procedure get-font-ini :
     1567     do
     1568     on error undo, return error return-value
     1569     :
     1570   define variable ii as integer   no-undo .
     1571   define variable v-font7 as character no-undo .
     1572   define variable v-font as character no-undo .
     1573   define variable loc-name as character no-undo .
     1574   define variable loc-size as character no-undo .
     1575   define variable loc-type as character no-undo .
     1576   define variable old_H as integer   no-undo .
     1577   define variable old_w as integer   no-undo .
     1578   define variable old-row  as integer   no-undo .
     1579   define variable old-col  as integer   no-undo .
     1580   define variable old-row-lans  as integer   no-undo .
     1581   define variable old-col-lans  as integer   no-undo .
     1582   define variable vv as integer   no-undo .
     1583   empty temp-table temp-font.
     1584     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1585       case num-entries (v-font7) :
     1586         when 4 then do:
     1587             assign
     1588               loc-name = entry ( 1 , v-font7 )
     1589               loc-size = entry ( 2 , v-font7 )
     1590               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1591             .
     1592         end.
     1593         when 3 then do:
     1594             assign
     1595               loc-name = entry ( 1 , v-font7 )
     1596               loc-size = entry ( 2 , v-font7 )
     1597               loc-type = entry ( 3 , v-font7 )
     1598             .
     1599         end.
     1600         when 2 then  do:
     1601             assign
     1602               loc-name = entry ( 1 , v-font7 )
     1603               loc-size = entry ( 2 , v-font7 )
     1604               loc-type = ""
     1605             .
     1606         end.
     1607         when 1 then do:
     1608             assign
     1609               loc-name = trim(entry ( 1 , v-font7 ))
     1610               loc-size = ""
     1611               loc-type = ""
     1612             .
     1613         end.
     1614       end case.
     1615     create temp-font.
     1616     assign
     1617       temp-font.fontnum  = 7
     1618       temp-font.fontname = trim(loc-name)
     1619       temp-font.fontsize = trim(loc-size)
     1620       temp-font.fonttype = trim(loc-type)
     1621       temp-font.v-row    = 62
     1622       temp-font.v-col    = 136
     1623       temp-font.v-row-lans = 43
     1624       temp-font.v-col-lans = 198
     1625     .
     1626     repeat ii = 16 to 100 :
     1627       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1628       if v-font = "" or v-font = ? then leave.
     1629       case num-entries (v-font) :
     1630         when 4 then do:
     1631             assign
     1632               loc-name = entry ( 1 , v-font )
     1633               loc-size = entry ( 2 , v-font )
     1634               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1635             .
     1636         end.
     1637         when 3 then do:
     1638             assign
     1639               loc-name = entry ( 1 , v-font )
     1640               loc-size = entry ( 2 , v-font )
     1641               loc-type = entry ( 3 , v-font )
     1642             .
     1643         end.
     1644         when 2 then do:
     1645             assign
     1646               loc-name = entry ( 1 , v-font )
     1647               loc-size = entry ( 2 , v-font )
     1648               loc-type = ""
     1649             .
     1650         end.
     1651         when 1 then do:
     1652             assign
     1653               loc-name = trim(entry ( 1 , v-font ))
     1654               loc-size = ""
     1655               loc-type = ""
     1656             .
     1657         end.
     1658       end case.
     1659     create temp-font.
     1660     assign
     1661       temp-font.fontnum  = ii
     1662       temp-font.fontname = trim(loc-name)
     1663       temp-font.fontsize = trim(loc-size)
     1664       temp-font.fonttype = trim(loc-type)
     1665     .
     1666     end.
     1667       for each temp-font :
     1668          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1669          if  vv = ? then vv =  0 .
     1670           run rep/exfont.p (
     1671             input   temp-font.fontname ,
     1672             input   vv ,
     1673             input   temp-font.fonttype ,
     1674             output  temp-font.font-h   ,
     1675             output  temp-font.font-w   )
     1676           .
     1677       end.
     1678   find first temp-font where  temp-font.fontnum  = 7  .
     1679   old_H = temp-font.font-H .
     1680   old_w = temp-font.font-W .
     1681   old-row = temp-font.v-row .
     1682   old-col = temp-font.v-col .
     1683   old-row-lans = temp-font.v-row-lans .
     1684   old-col-lans = temp-font.v-col-lans .
     1685       for each temp-font where
     1686                temp-font.fontnum  <> 7 :
     1687           assign
     1688               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1689               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1690               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1691               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1692           .
     1693       end.
     1694     end.
     1695   end procedure.
     1696   PROCEDURE How-name :
     1697   define input  parameter h as integer no-undo .
     1698   define input  parameter w as integer no-undo .
     1699   define output parameter n as character  no-undo .
     1700   define variable A4port-H as integer   no-undo init 63.
     1701   define variable A4port-W as integer   no-undo init 136.
     1702   define variable A4lans-H as integer   no-undo init 43.
     1703   define variable A4lans-W as integer   no-undo init 198.
     1704   define variable Strim-W  as integer   no-undo init 278.
     1705   run define-a4-size (
     1706        input ReportFontNum
     1707       ,output A4port-H
     1708       ,output A4port-W
     1709       ,output A4lans-H
     1710       ,output A4lans-W ).
     1711   If w >= 1 and w <= A4port-W Then DO:
     1712     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1713     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1714     If h > A4port-H              Then n = "to-file":U.
     1715   End.
     1716   If w > A4port-W and w <= A4lans-W Then DO:
     1717     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1718     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1719     If h > A4port-H              Then n = "to-file":U.
     1720   End.
     1721   If w > A4lans-W and w <= Strim-W Then DO:
     1722     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1723     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1724     If h > A4port-H              Then n = "to-file":U.
     1725   End.
     1726   If w > Strim-W Then DO:
     1727      n = "to-file":U.
     1728   End.
     1729   END PROCEDURE.
     1730   PROCEDURE define-a4-size :
     1731   define input  parameter p-ReportFontNum as integer   no-undo .
     1732   define output parameter A4port-H as integer   no-undo .
     1733   define output parameter A4port-W as integer   no-undo .
     1734   define output parameter A4lans-H as integer   no-undo .
     1735   define output parameter A4lans-W as integer   no-undo .
     1736   if not can-find (first temp-font ) then do:
     1737      run get-font-ini .
     1738   end.
     1739   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1740   if available temp-font then do:
     1741   assign
     1742     A4port-H = temp-font.v-row
     1743     A4port-W = temp-font.v-col
     1744     A4lans-H = temp-font.v-row-lans
     1745     A4lans-W = temp-font.v-col-lans
     1746   .
     1747   end.
     1748   else do:
     1749   assign
     1750     A4port-H = 63
     1751     A4port-W = 136
     1752     A4lans-H = 43
     1753     A4lans-W = 198
     1754   .
     1755   end.
     1756   END PROCEDURE.
     1757   PROCEDURE ostatok :
     1758   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1759   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1760   def input parameter x-tog-shift   as   logical             no-undo.
     1761   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1762   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1763   def input parameter x-shift-start as integer               no-undo.
     1764   def input parameter x-shift-end   as integer               no-undo.
     1765   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1766   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1767   def input parameter xTog-obj   as log no-undo.
     1768   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1769   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1770   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1771   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1772   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1773   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1774   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1775   def var              Fact-orderS   as char  no-undo.
     1776   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1777      Assign
     1778         Fact-order   = 0
     1779         Quantity     = 0
     1780         Coast_R      = 0
     1781         Coast_V      = 0
     1782         VAT_R        = 0
     1783         VAT_V        = 0 .
     1784    x-date-start-t  = x-date-start + 1 .
     1785   IF x-date-end = date('') then DO:
     1786      Fact-order = 0 .
     1787      for each obj-list
     1788          where  ( not xtog-obj or
     1789                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1790                 no-lock :
     1791         if  x-tog-shift = false then do:
     1792                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1793                               ub.stk-tot.Fact-date <=  x-date-start
     1794                               and ub.stk-tot.shift-num = 0
     1795                               USE-INDEX fact-date no-lock no-error .
     1796              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1797         End.
     1798         Else  DO :
     1799             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1800              (ub.stk-tot.shift-date  = x-date-start-t and
     1801               ub.stk-tot.shift-num  < x-shift-start or
     1802               ub.stk-tot.shift-date  < x-date-start-t  )
     1803               and ub.stk-tot.shift-num  > 0
     1804               USE-INDEX Shift-num no-lock no-error .
     1805            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1806           END.
     1807       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1808     End.
     1809   End.
     1810   Else DO:
     1811     For each obj-list  WHERE
     1812        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1813         no-lock :
     1814      IF  x-TOG-Shift = False Then DO:
     1815          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1816               ub.stk-tot.Fact-date <= x-date-end
     1817               and ub.stk-tot.shift-num = 0
     1818               USE-INDEX fact-date no-lock no-error.
     1819          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1820      END.
     1821      Else DO:
     1822           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1823               (ub.stk-tot.shift-date  = x-date-end and
     1824               ub.stk-tot.shift-num  <= x-shift-end or
     1825               ub.stk-tot.shift-date  < x-date-end       ) and
     1826               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1827               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1828       End.
     1829       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1830     End.
     1831   End.
     1832   END PROCEDURE.
     1833   procedure ost-line :
     1834     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1835     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1836     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1837     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1838     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1839     define input  parameter x-tog-shift  as logical no-undo .
     1840     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1841     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1842     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1843     define input  parameter xtog-obj     as logical no-undo .
     1844     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1845     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1846     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1847     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1848     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1849     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1850     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1851     define buffer buff-obj-list  for obj-list .
     1852     define buffer buff-stk-line  for ub.stk-line .
     1853     assign
     1854       Quantity = 0
     1855       Coast_R  = 0
     1856       Coast_V  = 0
     1857       VAT_R    = 0
     1858       VAT_V    = 0
     1859       SLT_R    = 0
     1860       SLT_V    = 0
     1861     .
     1862     if  x-tog-shift = false then do:
     1863       for each buff-obj-list no-lock
     1864         where xtog-obj = false
     1865            or (buff-obj-list.obj-type = x-store-type
     1866               and buff-obj-list.obj-code = x-store-code
     1867               )
     1868       on error undo, return error
     1869       :
     1870         find last buff-stk-line no-lock
     1871           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1872             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1873             and buff-stk-line.artic      = x-artic
     1874             and buff-stk-line.prod-type  = x-prod-type
     1875             and buff-stk-line.prod-code  = x-prod-code
     1876             and buff-stk-line.sum-type   = x-sum-type
     1877             and buff-stk-line.cat-id     = '##,##':U
     1878             and buff-stk-line.fact-order <= x-fact-order
     1879             and buff-stk-line.shift-num  = 0
     1880           use-index category
     1881           no-error .
     1882         if available buff-stk-line then do:
     1883           assign
     1884             Quantity = Quantity +  buff-stk-line.fact-qnty
     1885             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1886             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1887             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1888             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1889             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1890             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1891           .
     1892         end.
     1893       end.
     1894     end.
     1895     else do:
     1896       for each buff-obj-list no-lock
     1897         where xtog-obj = false
     1898            or (buff-obj-list.obj-type = x-store-type
     1899               and buff-obj-list.obj-code = x-store-code
     1900               )
     1901       on error undo, return error
     1902       :
     1903         find last buff-stk-line no-lock
     1904           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1905             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1906             and buff-stk-line.artic      = x-artic
     1907             and buff-stk-line.prod-type  = x-prod-type
     1908             and buff-stk-line.prod-code  = x-prod-code
     1909             and buff-stk-line.sum-type   = x-sum-type
     1910             and buff-stk-line.cat-id     = '##,##':U
     1911             and buff-stk-line.fact-order <= x-fact-order
     1912             and buff-stk-line.shift-num  > 0
     1913           use-index category
     1914           no-error .
     1915         if available buff-stk-line then do:
     1916           assign
     1917             Quantity = Quantity +  buff-stk-line.fact-qnty
     1918             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1919             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1920             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1921             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1922             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1923             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1924           .
     1925         end.
     1926       end.
     1927     end.
     1928   end procedure.
     1929   procedure ost-lineother-tax :
     1930     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1931     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1932     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1933     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1934     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1935     define input  parameter x-tog-shift  as logical no-undo .
     1936     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1937     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1938     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1939     define input  parameter xTog-obj     as logical no-undo .
     1940     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1941     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1942     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1943     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1944     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1945     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1946     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1947     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1948     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1949     define buffer buff-obj-list  for obj-list .
     1950     define buffer buff-stk-line  for ub.stk-line .
     1951     assign
     1952       Quantity = 0
     1953       Coast_R  = 0
     1954       Coast_V  = 0
     1955       VAT_R    = 0
     1956       VAT_V    = 0
     1957       SLT_R    = 0
     1958       SLT_V    = 0
     1959       other_R  = 0
     1960       other_V  = 0
     1961     .
     1962     if  x-tog-shift = false then do:
     1963       for each buff-obj-list no-lock
     1964         where xtog-obj = false
     1965            or (buff-obj-list.obj-type = x-store-type
     1966               and buff-obj-list.obj-code = x-store-code
     1967               )
     1968       on error undo, return error
     1969       :
     1970         find last buff-stk-line no-lock
     1971           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1972             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1973             and buff-stk-line.artic      = x-artic
     1974             and buff-stk-line.prod-type  = x-prod-type
     1975             and buff-stk-line.prod-code  = x-prod-code
     1976             and buff-stk-line.sum-type   = x-sum-type
     1977             and buff-stk-line.cat-id     = '##,##':U
     1978             and buff-stk-line.fact-order <= x-fact-order
     1979             and buff-stk-line.shift-num  = 0
     1980           use-index category
     1981           no-error .
     1982         if available buff-stk-line then do:
     1983           assign
     1984             Quantity = Quantity +  buff-stk-line.fact-qnty
     1985             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1986             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1987             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1988             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1989             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1990             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1991             other_R  = other_R  +  buff-stk-line.other-rubl
     1992             other_V  = other_V  +  buff-stk-line.other-base
     1993           .
     1994         end.
     1995       end.
     1996     end.
     1997     else do:
     1998       for each buff-obj-list no-lock
     1999         where xtog-obj = false
     2000            or (buff-obj-list.obj-type = x-store-type
     2001               and buff-obj-list.obj-code = x-store-code
     2002               )
     2003       on error undo, return error
     2004       :
     2005         find last buff-stk-line no-lock
     2006           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2007             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2008             and buff-stk-line.artic      = x-artic
     2009             and buff-stk-line.prod-type  = x-prod-type
     2010             and buff-stk-line.prod-code  = x-prod-code
     2011             and buff-stk-line.sum-type   = x-sum-type
     2012             and buff-stk-line.cat-id     = '##,##':U
     2013             and buff-stk-line.fact-order <= x-fact-order
     2014             and buff-stk-line.shift-num  > 0
     2015           use-index category
     2016           no-error .
     2017         if available buff-stk-line then do:
     2018           assign
     2019             Quantity = Quantity +  buff-stk-line.fact-qnty
     2020             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2021             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2022             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2023             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2024             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2025             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2026             other_R = other_R   +  buff-stk-line.other-rubl
     2027             other_V = other_V   +  buff-stk-line.other-base
     2028           .
     2029         end.
     2030       end.
     2031     end.
     2032   end procedure.
     2033   procedure ost-line-kg :
     2034     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2035     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2036     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2037     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2038     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2039     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2040     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2041     define buffer buff-obj-list  for obj-list .
     2042     define buffer buf_doc-line for ub.doc-line .
     2043     define buffer buf_inv-line for ub.inv-line .
     2044     do
     2045     on error undo, return error
     2046     :
     2047       for each buf_doc-line no-lock where
     2048                buf_doc-line.obj-type    = p-obj-type   and
     2049                buf_doc-line.obj-code    = p-obj-code   and
     2050                buf_doc-line.prod-type   = p-prod-type  and
     2051                buf_doc-line.prod-code   = p-prod-code  and
     2052                buf_doc-line.artic       = p-artic      and
     2053                buf_doc-line.status_     = 'факт':U      and
     2054                buf_doc-line.fact-order <= p-fact-order
     2055             by buf_doc-line.fact-order    descending
     2056       :
     2057         find first buf_inv-line no-lock where
     2058                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2059                    buf_inv-line.artic     = buf_doc-line.artic     and
     2060                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2061                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2062         if available buf_inv-line
     2063         then do:
     2064           if buf_inv-line.after-cli-qnty <> ?
     2065           then do:
     2066             assign
     2067               p-quantity-kg = buf_inv-line.after-cli-qnty
     2068             .
     2069             leave .
     2070           end.
     2071         end.
     2072       end.
     2073       if p-quantity-kg = ?
     2074       then do:
     2075         assign
     2076           p-quantity-kg = 0
     2077         .
     2078       end.
     2079     end.
     2080   end procedure.
     2081   define variable vss-include-info13 as character format "X(65)" no-undo
     2082   initial "@(#)$Workfile$ $Revision$".
     2083   procedure grplib-get-full-name :
     2084      define input parameter p-node-code  as integer      no-undo.
     2085      define output parameter p-full-name as character    no-undo.
     2086      do
     2087   on error undo, return error
     2088   :
     2089       define variable v-upper-code    as integer           no-undo.
     2090       define buffer buf_gds-grp       for ub.gds-grp.
     2091       define buffer buf_upper_gds-grp for ub.gds-grp.
     2092       find first buf_gds-grp no-lock
     2093            where buf_gds-grp.node-code = p-node-code
     2094       no-error.
     2095       if not available buf_gds-grp
     2096       then do:
     2097           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     2098       end.
     2099       assign
     2100           p-full-name  = ""
     2101           v-upper-code = 1
     2102       .
     2103       do while buf_gds-grp.upper-code <> 0
     2104       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     2105       :
     2106           assign
     2107               p-full-name  = buf_gds-grp.node-name
     2108                            + (if p-full-name <> "" then chr(47) else "")
     2109                            + p-full-name
     2110               v-upper-code = buf_gds-grp.upper-code
     2111           .
     2112           find first buf_gds-grp no-lock
     2113                where buf_gds-grp.node-code = v-upper-code
     2114           no-error.
     2115           if not available buf_gds-grp
     2116           then do:
     2117               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     2118                                   + string( v-upper-code )
     2119                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     2120           end.
     2121       end.
     2122       assign
     2123       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     2124       .
     2125   end.
     2126   end .
     2127   procedure grplib-get-node-from-full-name :
     2128   define input parameter p-full-name as character no-undo .
     2129   define output parameter p-node-code as integer no-undo .
     2130   define variable v-ii as integer no-undo .
     2131   define variable v-upper-code as integer no-undo .
     2132   define variable v-root-code as integer no-undo .
     2133   define variable v-entry as character no-undo .
     2134   define buffer buf_gds-grp       for ub.gds-grp.
     2135   do
     2136   on error undo, return error
     2137   :
     2138     find first buf_gds-grp no-lock
     2139         where buf_gds-grp.upper-code = 0
     2140     no-error .
     2141     if not available buf_gds-grp
     2142     then do:
     2143         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     2144     end.
     2145     else do:
     2146       assign
     2147       v-root-code = buf_gds-grp.node-code
     2148       .
     2149     end.
     2150     v-upper-code = v-root-code.
     2151     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     2152       assign
     2153       v-entry = entry(v-ii, p-full-name, chr(47)).
     2154       if v-entry = '' then leave.
     2155       find first buf_gds-grp no-lock where
     2156                 buf_gds-grp.node-name = v-entry
     2157             and buf_gds-grp.upper-code = v-upper-code
     2158             no-error.
     2159       if not available buf_gds-grp then do:
     2160         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     2161       end.
     2162       else do:
     2163         p-node-code = buf_gds-grp.node-code.
     2164         v-upper-code = buf_gds-grp.node-code.
     2165       end.
     2166     end.
     2167   end.
     2168   end .
     2169   define variable vss-include-info14 as character format "X(65)" no-undo
     2170   initial "@(#)$Workfile$ $Revision$".
     2171   define variable v-fmtcli-name          as character    no-undo.
     2172   define variable v-fmtcli-engl-name     as character    no-undo.
     2173   define variable v-fmtcli-addres        as character    no-undo.
     2174   define variable v-fmtcli-post-addres   as character    no-undo.
     2175   define variable v-fmtcli-full-addres   as character    no-undo.
     2176   define variable v-fmtcli-phone         as character    no-undo.
     2177   define variable v-fmtcli-inn           as character    no-undo.
     2178   define variable v-fmtcli-kpp           as character    no-undo.
     2179   define variable v-fmtcli-okpo          as character    no-undo.
     2180   define variable v-fmtcli-country       as character    no-undo.
     2181   define variable v-fmtcli-city          as character    no-undo.
     2182   define variable v-fmtcli-index         as character    no-undo.
     2183   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2184   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2185   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2186   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2187   define variable v-fmtcli-bank-bik      as character    no-undo.
     2188   define variable v-fmtcli-bank-name     as character    no-undo.
     2189   define variable v-fmtcli-bank-addres   as character    no-undo.
     2190   define variable v-fmtcli-bank-city     as character    no-undo.
     2191   procedure fmtcli-get-bank :
     2192   define input parameter p-host-code      as integer          no-undo.
     2193   define input parameter p-obj-type       as character        no-undo.
     2194   define input parameter p-obj-code       as integer          no-undo.
     2195   define input parameter p-curr-code      as integer          no-undo.
     2196       define buffer buf_fin-schet     for ub.fin-schet.
     2197       define buffer buf_fin-bank      for ub.fin-bank.
     2198   do
     2199   for buf_fin-schet
     2200     , buf_fin-bank
     2201   on error undo, return error
     2202   :
     2203       assign
     2204           v-fmtcli-schet-exists       = no
     2205           v-fmtcli-bank-exists        = no
     2206           v-fmtcli-bank-r-schet       = "":U
     2207           v-fmtcli-bank-c-schet       = "":U
     2208           v-fmtcli-bank-bik           = "":U
     2209           v-fmtcli-bank-name          = "":U
     2210           v-fmtcli-bank-addres        = "":U
     2211           v-fmtcli-bank-city          = "":U
     2212       .
     2213       search-for-schet:
     2214       for each buf_fin-schet no-lock
     2215          where buf_fin-schet.host-code = p-host-code
     2216            and buf_fin-schet.cli-type  = p-obj-type
     2217            and buf_fin-schet.cli-code  = p-obj-code
     2218            and buf_fin-schet.curr-code = p-curr-code
     2219       on error undo, return error
     2220       :
     2221           if buf_fin-schet.status_   = 'удал':U
     2222           then do:
     2223           end.
     2224           else do:
     2225               assign
     2226                   v-fmtcli-schet-exists   = yes
     2227                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2228                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2229               .
     2230               find first buf_fin-bank no-lock
     2231                    where buf_fin-bank.host-code = p-host-code
     2232                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2233               no-error.
     2234               if available buf_fin-bank
     2235               then do:
     2236                   assign
     2237                       v-fmtcli-bank-exists      = yes
     2238                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2239                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2240                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2241                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2242                   .
     2243               end.
     2244               else do:
     2245                   assign
     2246                       v-fmtcli-bank-exists    = no
     2247                       v-fmtcli-bank-bik       = "":U
     2248                       v-fmtcli-bank-name      = "":U
     2249                       v-fmtcli-bank-addres    = "":U
     2250                       v-fmtcli-bank-city      = "":U
     2251                   .
     2252               end.
     2253               leave search-for-schet.
     2254           end.
     2255       end.
     2256   end.
     2257   end procedure.
     2258   procedure fmtcli-get-client :
     2259   define input parameter p-obj-type       as character    no-undo.
     2260   define input parameter p-obj-code       as integer      no-undo.
     2261       define variable v-temp-fmtcli-address      as character     no-undo.
     2262       define variable v-num-country-city    as integer      no-undo.
     2263       define buffer buf_clients   for ub.clients.
     2264       define buffer buf_firm      for ub.firm.
     2265       define buffer buf_store     for ub.store.
     2266       define buffer buf_shop      for ub.shop.
     2267       define buffer buf_person    for ub.person.
     2268   do
     2269   for buf_clients
     2270     , buf_firm
     2271     , buf_store
     2272     , buf_shop
     2273     , buf_person
     2274   on error undo, return error
     2275   :
     2276       assign
     2277           v-fmtcli-name           = "":U
     2278           v-fmtcli-addres         = "":U
     2279           v-fmtcli-post-addres    = "":U
     2280           v-fmtcli-full-addres    = "":U
     2281           v-fmtcli-phone          = "":U
     2282           v-fmtcli-inn            = "":U
     2283           v-fmtcli-kpp            = "":U
     2284           v-fmtcli-okpo           = "":U
     2285           v-fmtcli-city           = "":U
     2286           v-fmtcli-index          = "":U
     2287           v-fmtcli-country        = "":U
     2288       .
     2289       find first buf_clients no-lock
     2290            where buf_clients.obj-type = p-obj-type
     2291              and buf_clients.obj-code = p-obj-code
     2292       .
     2293       assign
     2294           v-fmtcli-name = buf_clients.obj-name
     2295       .
     2296       case buf_clients.obj-type:
     2297          when 'орг':U
     2298          then do:
     2299               find first buf_firm no-lock
     2300                    where buf_firm.firm-code = buf_clients.obj-code
     2301                    no-error
     2302               .
     2303               if available buf_firm
     2304               then do:
     2305                   assign
     2306                       v-num-country-city = num-entries( buf_firm.city )
     2307                       v-fmtcli-engl-name = buf_firm.engl-name
     2308                   .
     2309                   if v-num-country-city > 0
     2310                   then do:
     2311                       assign
     2312                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2313                       .
     2314                   end.
     2315                   if v-num-country-city > 1
     2316                   then do:
     2317                       assign
     2318                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2319                       .
     2320                   end.
     2321                   run fmtcli-concatenate-strings in this-procedure (
     2322                         input v-fmtcli-full-addres
     2323                       , input v-fmtcli-country
     2324                       , input ", ":U
     2325                       , input 50
     2326                       , output v-fmtcli-full-addres
     2327                   ).
     2328                   run fmtcli-concatenate-strings in this-procedure (
     2329                         input v-fmtcli-full-addres
     2330                       , input v-fmtcli-city
     2331                       , input ", ":U
     2332                       , input 50
     2333                       , output v-fmtcli-full-addres
     2334                   ).
     2335                   run fmtcli-concatenate-strings in this-procedure (
     2336                         input v-fmtcli-full-addres
     2337                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2338                       , input ", ":U
     2339                       , input 50
     2340                       , output v-fmtcli-full-addres
     2341                   ).
     2342                   run fmtcli-concatenate-strings in this-procedure (
     2343                         input v-fmtcli-post-addres
     2344                       , input v-fmtcli-country
     2345                       , input ", ":U
     2346                       , input 50
     2347                       , output v-fmtcli-post-addres
     2348                   ).
     2349                   run fmtcli-concatenate-strings in this-procedure (
     2350                         input v-fmtcli-post-addres
     2351                       , input v-fmtcli-city
     2352                       , input ", ":U
     2353                       , input 50
     2354                       , output v-fmtcli-post-addres
     2355                   ).
     2356                   run fmtcli-concatenate-strings in this-procedure (
     2357                         input v-fmtcli-post-addres
     2358                       , input string( buf_firm.ind )
     2359                       , input ", ":U
     2360                       , input 50
     2361                       , output v-fmtcli-post-addres
     2362                   ).
     2363                   run fmtcli-concatenate-strings in this-procedure (
     2364                         input substring( buf_firm.addres1, 1, 50 )
     2365                       , input buf_firm.addres2
     2366                       , input " ":U
     2367                       , input 50
     2368                       , output v-temp-fmtcli-address
     2369                   ).
     2370                   run fmtcli-concatenate-strings in this-procedure (
     2371                         input v-temp-fmtcli-address
     2372                       , input substring( buf_firm.addres1, 51, 50 )
     2373                       , input " ":U
     2374                       , input 50
     2375                       , output v-temp-fmtcli-address
     2376                   ).
     2377                   run fmtcli-concatenate-strings in this-procedure (
     2378                         input v-temp-fmtcli-address
     2379                       , input substring( buf_firm.addres1, 101, 50 )
     2380                       , input " ":U
     2381                       , input 50
     2382                       , output v-temp-fmtcli-address
     2383                   ).
     2384                   assign
     2385                       v-fmtcli-addres = v-temp-fmtcli-address
     2386                   .
     2387                   if buf_firm.addres1 <> ?
     2388                   then do:
     2389                       run fmtcli-concatenate-strings in this-procedure (
     2390                             input v-fmtcli-full-addres
     2391                           , input v-fmtcli-addres
     2392                           , input ", ":U
     2393                           , input 0
     2394                           , output v-fmtcli-full-addres
     2395                       ).
     2396                   end.
     2397                   run fmtcli-concatenate-strings in this-procedure (
     2398                         input substring( buf_firm.post-addr1, 1, 50 )
     2399                       , input buf_firm.post-addr2
     2400                       , input " ":U
     2401                       , input 50
     2402                       , output v-fmtcli-post-addres
     2403                   ).
     2404                   run fmtcli-concatenate-strings in this-procedure (
     2405                         input v-fmtcli-post-addres
     2406                       , input substring( buf_firm.post-addr1, 51, 50 )
     2407                       , input " ":U
     2408                       , input 50
     2409                       , output v-fmtcli-post-addres
     2410                   ).
     2411                   run fmtcli-concatenate-strings in this-procedure (
     2412                         input v-fmtcli-post-addres
     2413                       , input substring( buf_firm.post-addr1, 101, 50 )
     2414                       , input " ":U
     2415                       , input 50
     2416                       , output v-fmtcli-post-addres
     2417                   ).
     2418                   assign
     2419                       v-fmtcli-phone         = buf_firm.phone
     2420                       v-fmtcli-inn           = buf_firm.inn
     2421                       v-fmtcli-kpp           = buf_firm.kpp
     2422                       v-fmtcli-okpo          = buf_firm.okpo
     2423                       v-fmtcli-index         = string( buf_firm.ind )
     2424                   .
     2425               end.
     2426          end.
     2427          when 'маг':U
     2428          then do:
     2429               find first buf_shop no-lock
     2430                    where buf_shop.obj-code = buf_clients.obj-code
     2431               .
     2432               if available buf_shop
     2433               then do:
     2434                   run fmtcli-concatenate-strings in this-procedure (
     2435                         input buf_shop.addres1
     2436                       , input buf_shop.addres2
     2437                       , input " ":U
     2438                       , input 50
     2439                       , output v-fmtcli-addres
     2440                   ).
     2441                   assign
     2442                       v-fmtcli-full-addres = v-fmtcli-addres
     2443                       v-fmtcli-post-addres = v-fmtcli-addres
     2444                       v-fmtcli-phone       = buf_shop.phone
     2445                       v-fmtcli-inn         = "":U
     2446                       v-fmtcli-kpp         = "":U
     2447                       v-fmtcli-okpo        = "":U
     2448                       v-fmtcli-city        = "":U
     2449                       v-fmtcli-index       = "":U
     2450                   .
     2451               end.
     2452          end.
     2453          when 'скл':U
     2454          then do:
     2455               find first buf_store no-lock
     2456                    where buf_store.obj-code = buf_clients.obj-code
     2457               .
     2458               if available buf_store
     2459               then do:
     2460                   run fmtcli-concatenate-strings in this-procedure (
     2461                         input buf_store.addres1
     2462                       , input buf_store.addres2
     2463                       , input " ":U
     2464                       , input 50
     2465                       , output v-fmtcli-addres
     2466                   ).
     2467                   assign
     2468                       v-fmtcli-full-addres = v-fmtcli-addres
     2469                       v-fmtcli-phone       = buf_store.phone
     2470                       v-fmtcli-inn         = "":U
     2471                       v-fmtcli-kpp         = "":U
     2472                       v-fmtcli-okpo        = "":U
     2473                       v-fmtcli-city        = "":U
     2474                       v-fmtcli-index       = "":U
     2475                   .
     2476               end.
     2477          end.
     2478          when 'чел':U
     2479          then do:
     2480               find first buf_person no-lock
     2481                    where buf_person.psn-code = buf_clients.obj-code
     2482               .
     2483               if available buf_person
     2484               then do:
     2485                   run fmtcli-concatenate-strings in this-procedure (
     2486                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2487                                 then "":U
     2488                                 else string( buf_person.ind, "999999")
     2489                                 )
     2490                       , input buf_person.city
     2491                       , input ", ":U
     2492                       , input 0
     2493                       , output v-fmtcli-full-addres
     2494                   ).
     2495                   assign
     2496                       v-fmtcli-addres = buf_person.address
     2497                   .
     2498                   run fmtcli-concatenate-strings in this-procedure (
     2499                         input v-fmtcli-full-addres
     2500                       , input v-fmtcli-addres
     2501                       , input ", ":U
     2502                       , input 0
     2503                       , output v-fmtcli-full-addres
     2504                   ).
     2505                   assign
     2506                       v-fmtcli-phone     = buf_person.phone1
     2507                       v-fmtcli-inn       = buf_person.inn
     2508                       v-fmtcli-kpp       = buf_person.kpp
     2509                       v-fmtcli-okpo      = buf_person.okpo
     2510                       v-fmtcli-city      = buf_person.city
     2511                       v-fmtcli-index     = string( buf_person.ind )
     2512                   .
     2513               end.
     2514          end.
     2515       end case.
     2516   end.
     2517   end procedure.
     2518   procedure fmtcli-concatenate-strings :
     2519   define input parameter p-string-1       as character        no-undo.
     2520   define input parameter p-string-2       as character        no-undo.
     2521   define input parameter p-delimiter      as character        no-undo.
     2522   define input parameter p-length         as integer          no-undo.
     2523   define output parameter p-out-string    as character        no-undo.
     2524   do
     2525   on error undo, return error
     2526   :
     2527       assign
     2528           p-out-string = ( if p-string-1 = ?
     2529                            then "":U
     2530                            else trim( p-string-1 ) )
     2531       .
     2532       assign
     2533           p-out-string = p-out-string
     2534                        + ( if p-out-string = "":U
     2535                            or length( p-out-string ) = p-length
     2536                            or p-string-2 = ?
     2537                            or trim( p-string-2 ) = "":U
     2538                            then "":U
     2539                            else p-delimiter )
     2540                        + ( if p-string-2 = ?
     2541                            or trim( p-string-2 ) = "":U
     2542                            then "":U
     2543                            else trim( p-string-2 ) )
     2544       .
     2545   end.
     2546   end procedure.
     2547   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2548   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     2549   procedure paramls-clear :
     2550     define buffer buf_temp-param for temp-param .
     2551     do
     2552     on error undo, return error return-value
     2553     :
     2554       for each buf_temp-param
     2555       on error undo, return error
     2556       :
     2557         delete buf_temp-param .
     2558       end.
     2559     end.
     2560   end procedure.
     2561   procedure paramls-write :
     2562     define input  parameter p-code     as character no-undo .
     2563     define input  parameter p-sub-code as character no-undo .
     2564     define input  parameter p-value    as character no-undo .
     2565     define buffer buf_temp-param for temp-param .
     2566     do
     2567     on error undo, return error return-value
     2568     :
     2569       find first buf_temp-param
     2570         where buf_temp-param.param-code     = p-code
     2571           and buf_temp-param.param-sub-code = p-sub-code
     2572         no-error .
     2573       if not available buf_temp-param then do:
     2574         create buf_temp-param .
     2575         assign
     2576           buf_temp-param.param-code     = p-code
     2577           buf_temp-param.param-sub-code = p-sub-code
     2578         .
     2579       end.
     2580       assign
     2581         buf_temp-param.param-value = p-value
     2582       .
     2583     end.
     2584   end procedure.
     2585   procedure paramls-read :
     2586     define input  parameter p-code          as character no-undo .
     2587     define input  parameter p-sub-code      as character no-undo .
     2588     define input  parameter p-default-value as character no-undo .
     2589     define output parameter p-value         as character no-undo .
     2590     define buffer buf_temp-param for temp-param .
     2591     do
     2592     on error undo, return error return-value
     2593     :
     2594       find first buf_temp-param
     2595         where buf_temp-param.param-code     = p-code
     2596           and buf_temp-param.param-sub-code = p-sub-code
     2597         no-error .
     2598       if available buf_temp-param then do:
     2599         assign
     2600           p-value = buf_temp-param.param-value
     2601         .
     2602       end.
     2603       else do:
     2604         assign
     2605           p-value = p-default-value
     2606         .
     2607       end.
     2608     end.
     2609   end procedure.
     2610   procedure paramls-append :
     2611     define input  parameter p-code     as character no-undo .
     2612     define input  parameter p-sub-code as character no-undo .
     2613     define input  parameter p-value    as character no-undo .
     2614     define buffer buf_temp-param for temp-param .
     2615     do
     2616     on error undo, return error return-value
     2617     :
     2618       find first buf_temp-param
     2619            where buf_temp-param.param-code     = p-code
     2620              and buf_temp-param.param-sub-code = p-sub-code
     2621         no-error .
     2622       if not available buf_temp-param then do:
     2623         create buf_temp-param .
     2624         assign
     2625           buf_temp-param.param-code     = p-code
     2626           buf_temp-param.param-sub-code = p-sub-code
     2627           buf_temp-param.param-value    = p-value
     2628         .
     2629       end.
     2630       else do:
     2631           assign
     2632               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     2633           .
     2634       end.
     2635     end.
     2636   end procedure.
     2637   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2638   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     2639     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2640     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     2641     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     2642   END FUNCTION.
     2643   PROCEDURE get-right-string :
     2644     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2645     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     2646     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2647     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     2648     DO ON ERROR UNDO, RETURN ERROR :
     2649       ASSIGN p-instring = TRIM(   p-instring )
     2650              j-format   = LENGTH( p-instring ).
     2651       IF           j-format > p-length THEN DO:
     2652         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     2653       END. ELSE IF j-format < p-length THEN DO:
     2654         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     2655       END.                             ELSE DO:
     2656         ASSIGN p-outstring = p-instring.
     2657       END.
     2658     END.
     2659   END PROCEDURE.
     2660   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2661   function func-get-name-from-ext-type   returns char
     2662     ( p-ext-type as character   ,
     2663       p-caps     as logical ).
     2664   define variable v-ext-name as character no-undo .
     2665   run get-name-from-ext-type in this-procedure (
     2666       input p-ext-type  ,
     2667       input p-caps  ,
     2668       output v-ext-name )
     2669       no-error .
     2670       if error-status :error then do:
     2671          assign
     2672            v-ext-name = p-ext-type
     2673          .
     2674       end.
     2675    return (v-ext-name) .
     2676   end.
     2677   procedure get-name-from-ext-type :
     2678    do
     2679    on error undo, return error return-value
     2680    :
     2681   define input  parameter p-ext-type as character no-undo .
     2682   define input  parameter p-caps     as logical no-undo   .
     2683   define output parameter p-ext-name as character no-undo .
     2684   define variable v-num as integer no-undo .
     2685     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
     2686       message
     2687         vss-include-info17 skip
     2688         "Неправильно задано значение входящего параметра! "
     2689         "Нет такого типа документов " p-ext-type
     2690         view-as alert-box error .
     2691         undo, return error .
     2692     end.
     2693     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
     2694     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
     2695     if p-caps  = true then do :
     2696        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
     2697     end .
     2698     end.
     2699   end procedure.
