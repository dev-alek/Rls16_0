     5224           display stream out-stream
     5225           sym7
     5226           substitute("ИТОГО &1", func-get-name-from-ext-type( tt-report.real-ext-doc-type, no)) @ v-name
     5227           sym2    p-fmt-align-string( "X" , 10 , "center")  @ tt-report.fact-date
     5228           sym3    p-fmt-align-string( "X" , 25 , "center")  @ tt-report.num-ship
     5229           sym4 v-ext-doc-type-doc-sum  @ tt-report.doc-sum
     5230           sym5 v-ext-doc-type-tara-sum @ tt-report.tara-sum
     5231           sym6
     5232           sym1
     5233           with frame torg29.
     5234           down stream out-stream with frame torg29.
     5235           run torg29xl-sheet2-write-line-data ( input substitute("ИТОГО &1", func-get-name-from-ext-type( tt-report.real-ext-doc-type, no))
     5236                                               , input "X"
     5237                                               , input "X"
     5238                                               , input string(v-ext-doc-type-doc-sum)
     5239                                               , input string(v-ext-doc-type-tara-sum)
     5240                                               , input ""
     5241                                               , input ""
     5242                                               ) .
     5243         end.
     5244       end.
     5245       if x-SET_PAY_TYPE = 3 then do:
     5246         assign
     5247           v-avt-ovt-gds       = v-itog-s-ost-gds  - (v-total-gds + v-ost-gds-2)
     5248           v-avt-ovt-tara      = v-itog-s-ost-tara - (v-total-tara + v-ost-tara-2)
     5249         .
     5250       end.
     5251       else do:
     5252         assign
     5253           v-avt-ovt-gds       = 0
     5254           v-avt-ovt-tara      = 0
     5255         .
     5256       end.
     5257       assign
     5258         v-total-gds         = v-total-gds  + v-avt-ovt-gds
     5259         v-total-tara        = v-total-tara + v-avt-ovt-tara
     5260       .
     5261       if x-SET_PAY_TYPE = 3 and ( v-avt-ovt-gds <> 0 or v-avt-ovt-tara <> 0 ) then do:
     5262         put stream out-stream v-line format "X(130)" skip.
     5263         display stream out-stream
     5264         sym7 "Автоматическая переоценка" @ v-name
     5265        sym2    p-fmt-align-string( "X" , 10 , "center") @ tt-report.fact-date
     5266        sym3    p-fmt-align-string( "X" , 25 , "center") @ tt-report.num-ship
     5267           sym4   v-avt-ovt-gds @ tt-report.doc-sum
     5268           sym5   v-avt-ovt-tara @ tt-report.tara-sum
     5269         sym6
     5270         sym1
     5271         with frame torg29.
     5272         down stream out-stream with frame torg29.
     5273         run torg29xl-sheet2-write-line-data ( input "Автоматическая переоценка":U
     5274                                             , input ""
     5275                                             , input ""
     5276                                             , input string(v-avt-ovt-gds)
     5277                                             , input string(v-avt-ovt-tara)
     5278                                             , input ""
     5279                                             , input ""
     5280                                             ) .
     5281       end.
     5282       put stream out-stream v-line format "X(130)" skip.
     5283       display stream out-stream
     5284       sym7 "Итого по расходу" @ v-name
     5285       sym2    p-fmt-align-string( "X" , 10 , "center") @ tt-report.fact-date
     5286       sym3    p-fmt-align-string( "X" , 25 , "center") @ tt-report.num-ship
     5287         sym4     v-total-gds @ tt-report.doc-sum
     5288         sym5     v-total-tara @ tt-report.tara-sum
     5289       sym6
     5290       sym1
     5291       with frame torg29.
     5292       down stream out-stream with frame torg29.
     5293       put stream out-stream v-line format "X(130)" skip.
     5294       display stream out-stream
     5295       sym7   substitute("Остаток на &1" , string(x-date-end, "99/99/9999"))   @ v-name
     5296       sym2    p-fmt-align-string( "X" , 10 , "center")  @ tt-report.fact-date
     5297       sym3    p-fmt-align-string( "X" , 25 , "center")  @ tt-report.num-ship
     5298         sym4      v-ost-gds-2   @ tt-report.doc-sum
     5299         sym5      v-ost-tara-2  @ tt-report.tara-sum
     5300       sym6
     5301       sym1
     5302       with frame torg29.
     5303       down stream out-stream with frame torg29.
     5304       put stream out-stream v-line format "X(130)" skip(2).
     5305       run torg29xl-write-cell-data in this-procedure ( input "f_expgds":U       , input string(v-total-gds)  ).
     5306       run torg29xl-write-cell-data in this-procedure ( input "f_exptara":U      , input string(v-total-tara) ).
     5307       run torg29xl-write-cell-data in this-procedure ( input "f_expostdateend":U, input substitute("Остаток на &1 " , w-date(x-Date-End) )  ).
     5308       run torg29xl-write-cell-data in this-procedure ( input "f_expostgds":U    , input string(v-ost-gds-2)  ).
     5309       run torg29xl-write-cell-data in this-procedure ( input "f_exposttara":U   , input string(v-ost-tara-2) ).
     5310     run print-footer-list-2 in this-procedure .
     5311     hide stream out-stream frame BottomFrame .
     5312   end.
     5313   end procedure.
     5314   function w-date returns character ( input p-date as date ) .
     5315   do
     5316   on error undo, return error
     5317   :
     5318     define variable month-str as character init "января;февраля;марта;апреля;мая;июня;июля;августа;сентября;октября;ноября;декабря":U no-undo.
     5319     return ( string( DAY( p-date ) ) + " " + entry( month( p-date ) , month-str , ";" ) + " " + string( year( p-date ) ) + " г." ).
     5320   end.
     5321   end function.
     5322   procedure break-by-cp-prep :
     5323   define input parameter p-obj-type as character no-undo .
     5324   define input parameter p-obj-code as integer no-undo .
     5325   define input parameter p-fact-order-1 as decimal no-undo .
     5326   define input parameter p-fact-order-2 as decimal no-undo .
     5327   define buffer buf_ot-tot for ub.ot-tot.
     5328   define buffer buf_trn-doc for ub.trn-doc.
     5329   define buffer buf_temp-inkas for temp-inkas.
     5330   define buffer buf_goods for ub.goods.
     5331   define buffer buf_temp-cp for temp-cp.
     5332   define buffer buf_chk-gds-pay for ub.chk-gds-pay.
     5333   define buffer buf_bar-code for ub.bar-code.
     5334   if p-obj-type = 'скл':U then return.
     5335   for each buf_ot-tot no-lock where
     5336           buf_ot-tot.obj-type = p-obj-type
     5337       and buf_ot-tot.obj-code = p-obj-code
     5338       and buf_ot-tot.fact-order >= p-fact-order-1
     5339       and buf_ot-tot.fact-order <= p-fact-order-2:
     5340     case buf_ot-tot.ext-doc-type:
     5341       when  'es':U then do:
     5342         find first buf_temp-inkas no-lock where
     5343                   buf_temp-inkas.inkas-code = buf_ot-tot.doc-code no-error.
     5344         if not available buf_temp-inkas then do:
     5345           run rep/rpychk0.p ( input "r-trg29d"
     5346                               ,input p-obj-type
     5347                               ,input p-obj-code
     5348                               ,input ?
     5349                               ,input ?
     5350                               ,input ?
     5351                               ,input ?
     5352                               ,input ?
     5353                               ,input ?
     5354                               ,input buf_ot-tot.doc-code
     5355                               ) no-error.
     5356           create buf_temp-inkas.
     5357           assign
     5358           buf_temp-inkas.inkas-code = buf_ot-tot.doc-code
     5359           buf_temp-inkas.ras-doc-code = buf_ot-tot.doc-code
     5360           buf_temp-inkas.obj-type = p-obj-type
     5361           buf_temp-inkas.obj-code = p-obj-code
     5362           .
     5363         end.
     5364       end.
     5365       when 'rs':U   then do:
     5366         find first buf_trn-doc no-lock where
     5367                  buf_trn-doc.doc-code = buf_ot-tot.doc-code no-error.
     5368         if available buf_trn-doc then do:
     5369           find first buf_temp-inkas no-lock where
     5370                     buf_temp-inkas.inkas-code = buf_trn-doc.out-code
     5371                no-error.
     5372           if not available buf_temp-inkas then do:
     5373             run rep/rpychk0.p ( input "r-trg29d"
     5374                                 ,input p-obj-type
     5375                                 ,input p-obj-code
     5376                                 ,input ?
     5377                                 ,input ?
     5378                                 ,input ?
     5379                                 ,input ?
     5380                                 ,input ?
     5381                                 ,input ?
     5382                                 ,input buf_ot-tot.doc-code
     5383                                 ) no-error.
     5384             create buf_temp-inkas.
     5385             assign
     5386             buf_temp-inkas.inkas-code = buf_trn-doc.out-code
     5387             buf_temp-inkas.ras-doc-code = buf_trn-doc.out-code
     5388             buf_temp-inkas.ret-doc-code = buf_ot-tot.doc-code
     5389             buf_temp-inkas.obj-type = p-obj-type
     5390             buf_temp-inkas.obj-code = p-obj-code
     5391             .
     5392           end.
     5393           else do:
     5394             assign
     5395             buf_temp-inkas.ret-doc-code = buf_ot-tot.doc-code
     5396             .
     5397           end.
     5398         end.
     5399       end.
     5400     end case.
     5401   end.
     5402   define variable v-exp as logical   no-undo .
     5403   define variable v-inc as logical   no-undo .
     5404   for each buf_temp-inkas where
     5405          buf_temp-inkas.obj-type = p-obj-type
     5406      and buf_temp-inkas.obj-code = p-obj-code
     5407    break
     5408    by buf_temp-inkas.inkas-code:
     5409     if first-of(buf_temp-inkas.inkas-code) then do:
     5410       for each buf_chk-gds-pay no-lock where
     5411           buf_chk-gds-pay.out-code = buf_temp-inkas.inkas-code,
     5412       first buf_bar-code no-lock where
     5413             buf_bar-code.b-code = buf_chk-gds-pay.b-code :
     5414         if buf_chk-gds-pay.algo-num <> "1.8" then next.
     5415         if num-entries(buf_chk-gds-pay.line-type, chr(4)) > 1 then do:
     5416           if entry(2, buf_chk-gds-pay.line-type, chr(4)) = 'es':U then do:
     5417             assign
     5418             v-exp = yes
     5419             v-inc = no
     5420             .
     5421           end.
     5422           if entry(2, buf_chk-gds-pay.line-type, chr(4)) = 'rs':U then do:
     5423             assign
     5424             v-exp = no
     5425             v-inc = yes
     5426             .
     5427           end.
     5428         end.
     5429         else do:
     5430           define buffer buf_chk-doc for ub.chk-doc.
     5431           find first buf_chk-doc no-lock where
     5432           buf_chk-doc.doc-code = buf_chk-gds-pay.doc-code .
     5433           assign
     5434           v-exp = lookup(string(buf_chk-doc.chk-type), '1,69,14,15,16,36':U) > 0
     5435           v-inc = lookup(string(buf_chk-doc.chk-type), '6,96':U) > 0
     5436           .
     5437         end.
     5438         if v-exp then do:
     5439       find first buf_temp-cp where
     5440                 buf_temp-cp.doc-code = buf_temp-inkas.ras-doc-code
     5441             and buf_temp-cp.gds-code = buf_bar-code.gds-code
     5442             and buf_temp-cp.cdpay-code = buf_chk-gds-pay.pay-code
     5443             and buf_temp-cp.curr-code = buf_chk-gds-pay.curr-code no-error.
     5444       if not available buf_temp-cp then do:
     5445         create buf_temp-cp.
     5446         assign
     5447         buf_temp-cp.doc-code = buf_temp-inkas.ras-doc-code
     5448         buf_temp-cp.gds-code = buf_bar-code.gds-code
     5449         buf_temp-cp.cdpay-code = buf_chk-gds-pay.pay-code
     5450         buf_temp-cp.curr-code = buf_chk-gds-pay.curr-code
     5451         .
     5452       end .
     5453           assign
     5454             buf_temp-cp.eff-doc-qnty =  buf_temp-cp.eff-doc-qnty + buf_chk-gds-pay.eff-doc-qnty
     5455             buf_temp-cp.tot-rb = buf_temp-cp.tot-rb + buf_chk-gds-pay.tot-r-b
     5456           .
     5457     end.
     5458         if v-inc then do:
     5459       find first buf_temp-cp where
     5460                     buf_temp-cp.doc-code = buf_temp-inkas.ret-doc-code
     5461             and buf_temp-cp.gds-code = buf_bar-code.gds-code
     5462             and buf_temp-cp.cdpay-code = buf_chk-gds-pay.pay-code
     5463             and buf_temp-cp.curr-code = buf_chk-gds-pay.curr-code no-error.
     5464       if not available buf_temp-cp then do:
     5465         create buf_temp-cp.
     5466         assign
     5467             buf_temp-cp.doc-code = buf_temp-inkas.ret-doc-code
     5468         buf_temp-cp.gds-code = buf_bar-code.gds-code
     5469         buf_temp-cp.cdpay-code = buf_chk-gds-pay.pay-code
     5470         buf_temp-cp.curr-code = buf_chk-gds-pay.curr-code
     5471         .
     5472       end.
     5473           assign
     5474             buf_temp-cp.eff-doc-qnty =  buf_temp-cp.eff-doc-qnty + buf_chk-gds-pay.eff-doc-qnty
     5475             buf_temp-cp.tot-rb = buf_temp-cp.tot-rb + buf_chk-gds-pay.tot-r-b
     5476           .
     5477   end.
     5478       end.
     5479     end.
     5480   end.
     5481   end procedure.
     5482   procedure process-covered-techrfsl :
     5483   define parameter buffer buf_trn-doc for ub.trn-doc.
     5484   define variable v-covered as logical no-undo .
     5485   define variable v-doc-qnty as decimal no-undo .
     5486   define buffer buf2_trn-doc for ub.trn-doc.
     5487   define buffer buf_sale-doc for ub.sale-doc.
     5488   define buffer buf2_sale-doc for ub.sale-doc.
     5489   do
     5490   on error undo, return error
     5491   :
     5492     def var v-value as character no-undo.
     5493     def var v-type  as character no-undo.
     5494     def var v-tech-pass as logical no-undo.
     5495   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     5496                           input 'techpass':U ,
     5497                          output v-value ,
     5498                          output v-type ) no-error .
     5499     assign
     5500       v-tech-pass = yes when v-value = "yes".
     5501     find first buf_sale-doc no-lock where
     5502               buf_sale-doc.doc-code = buf_trn-doc.doc-code
     5503           and buf_sale-doc.doc-kind = 'trf':U no-error.
     5504     if available buf_sale-doc then do:
     5505       for each buf2_sale-doc no-lock where
     5506               buf2_sale-doc.inkas-code = buf_sale-doc.inkas-code
     5507           and buf2_sale-doc.doc-kind = 'itr':U ,
     5508           first buf2_trn-doc no-lock where
     5509                 buf2_trn-doc.doc-code = buf2_sale-doc.doc-code:
     5510         assign
     5511         v-covered = (buf2_trn-doc.fact-qnty = buf2_trn-doc.doc-qnty) and v-covered
     5512         v-doc-qnty = v-doc-qnty + buf2_trn-doc.fact-qnty
     5513         .
     5514       end.
     5515       v-covered = (v-doc-qnty = buf_sale-doc.doc-qnty).
     5516       if v-covered then do:
     5517         for each buf2_sale-doc no-lock where
     5518                 buf2_sale-doc.inkas-code = buf_sale-doc.inkas-code
     5519             and buf2_sale-doc.doc-kind = 'itr':U:
     5520           create tt-ignore-docs.
     5521           assign
     5522           tt-ignore-docs.doc-code = buf2_sale-doc.doc-code.
     5523           release tt-ignore-docs.
     5524         end.
     5525         create tt-ignore-docs.
     5526         assign
     5527         tt-ignore-docs.doc-code = buf_trn-doc.doc-code.
     5528       end.
     5529     end.
     5530   end.
     5531   end procedure.
