      591   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      592   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      593   define  shared variable RepPathName        as character no-undo .
      594   define  shared variable PrintRubl          as logical   no-undo .
      595   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      596   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      597   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      598   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
