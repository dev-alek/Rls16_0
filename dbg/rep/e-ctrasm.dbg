      939   define variable v-critical-qnty-sale      as decimal   no-undo .
      940   define variable v-critical-qnty-order     as decimal   no-undo .
      941   define variable v-group-by-post           as logical   no-undo .
      942   define variable v-group-by-order          as logical   no-undo .
      943   define variable v-detailed                as logical   no-undo .
