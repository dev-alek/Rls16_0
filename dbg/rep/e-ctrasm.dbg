     1285   PROCEDURE check-modified :
     1286   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1287   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1288   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1289   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1290     IF check-state = "check":U THEN
     1291     DO:
     1292       RUN get-link-handle IN adm-broker-hdl
     1293         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1294            OUTPUT group-target-list).
     1295       IF group-target-list NE "":U THEN
     1296       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1297         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1298         RUN check-modified IN curr-widget ('group-check':U).
     1299         IF RETURN-VALUE NE "":U THEN
     1300         DO:
     1301           RUN check-modified-message(RETURN-VALUE).
     1302           RETURN "":U.
     1303         END.
     1304       END.
     1305     END.
     1306     RETURN "":U.
     1307   END PROCEDURE.
     1308   PROCEDURE check-modified-message :
     1309     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1310        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1311           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1312        IF RETURN-VALUE = "YES":U THEN
     1313           RUN notify ('view,CONTAINER-SOURCE':U).
     1314        MESSAGE IF p-changed-table NE ? THEN
     1315           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1316           ELSE "Current values have been changed."
     1317           SKIP "  Do you wish to save those changes?"
     1318           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1319        IF ANS THEN
     1320        DO:
     1321           IF group-assign-target THEN
     1322             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1323           ELSE RUN dispatch('update-record':U).
     1324           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1325           DO:
     1326               MESSAGE "Changes to the previous record were not saved."
     1327                 VIEW-AS ALERT-BOX ERROR.
     1328               IF group-assign-target THEN
     1329                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1330               ELSE RUN dispatch ('cancel-record':U).
     1331           END.
     1332        END.
     1333        ELSE DO:
     1334          IF group-assign-target THEN
     1335             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1336          ELSE RUN dispatch('cancel-record':U).
     1337        END.
     1338        RETURN.
     1339   END PROCEDURE.
     1340   PROCEDURE get-rowid :
     1341       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1342       ASSIGN
     1343       p-table   =   adm-first-table.
     1344       RETURN.
     1345   END PROCEDURE.
     1346   PROCEDURE init-group-assign :
     1347       RUN request-attribute IN adm-broker-hdl
     1348         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1349       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1350         group-assign-target = yes.
     1351       ELSE group-assign-target = no.
     1352       RETURN.
     1353   END PROCEDURE.
     1354   PROCEDURE set-editors :
     1355       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1356       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1357       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1358       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1359       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1360       DO WHILE VALID-HANDLE (curr-widget):
     1361           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1362              curr-widget:HIDDEN = no THEN DO:
     1363             CASE p-field-setting:
     1364               WHEN "INITIALIZE":U THEN
     1365               DO:
     1366                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1367                     read-only-list +
     1368                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1369                        STRING(curr-widget).
     1370               END.
     1371               WHEN "DISABLE":U OR
     1372               WHEN "ENABLE":U THEN
     1373               DO:
     1374                   curr-widget:SENSITIVE = yes.
     1375                   RUN get-attribute ('Read-Only-Editors':U).
     1376                   IF RETURN-VALUE = ? OR
     1377                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1378                       curr-widget:READ-ONLY =
     1379                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1380               END.
     1381               WHEN "CLEAR":U THEN
     1382                   curr-widget:SCREEN-VALUE = "":U.
     1383             END CASE.
     1384           END.
     1385           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1386       END.
     1387       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1388         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1389           + '"':U).
     1390       RETURN.
     1391   END PROCEDURE.
     1392   PROCEDURE use-check-modified-all :
     1393    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1394     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1395     RETURN.
     1396   END PROCEDURE.
     1397   PROCEDURE use-create-on-add :
     1398   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1399      RETURN.
     1400   END PROCEDURE.
     1401   PROCEDURE use-initial-lock :
     1402     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1403     ASSIGN adm-initial-lock = p-attr-value.
     1404     RETURN.
     1405   END PROCEDURE.
     1406     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1407   ASSIGN
     1408          FRAME F-Main:SCROLLABLE       = FALSE
     1409          FRAME F-Main:HIDDEN           = TRUE.
     1410   ASSIGN
     1411          fi-gds-qnty:HIDDEN IN FRAME F-Main           = TRUE.
     1412   ASSIGN
     1413          tg-detailed:HIDDEN IN FRAME F-Main           = TRUE.
     1414   ASSIGN
     1415          tg-group-by-post:HIDDEN IN FRAME F-Main           = TRUE.
     1416   ON VALUE-CHANGED OF tg-gds-by-am IN FRAME F-Main
     1417   DO:
     1418     if not tg-gds-by-am:checked then do:
     1419       disable tog-1 tog-2 tog-3 tog-4 tog-5 tog-6 with frame F-Main.
     1420     end.
     1421     else do:
     1422       enable tog-1 tog-2 tog-3 tog-4 tog-5 tog-6 with frame F-Main.
     1423       apply "value-changed" to tog-1.
     1424     end.
     1425   END.
     1426   ON VALUE-CHANGED OF tog-1 IN FRAME F-Main
     1427   DO:
     1428     if tog-1:checked then do :
     1429       disable tog-2 tog-3 tog-4 tog-5 tog-6 with frame F-Main.
     1430     end.
     1431     else do :
     1432       enable tog-2 tog-3 tog-4 tog-5 tog-6 with frame F-Main.
     1433     end.
     1434   END.
     1435   PROCEDURE disable_UI :
     1436     HIDE FRAME F-Main.
     1437     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1438   END PROCEDURE.
     1439   PROCEDURE local-apply-layout :
     1440     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1441   END PROCEDURE.
     1442   PROCEDURE local-initialize :
     1443   define variable v-naim           as character        no-undo.
     1444     define variable v-list           as character        no-undo.
     1445     define variable v-print-graft    as logical          no-undo.
     1446     define variable v-sort-gr        as logical          no-undo.
     1447     define variable v-type-price     as logical          no-undo.
     1448     define variable v-type-val       as logical          no-undo.
     1449     define variable v-i              as integer          no-undo .
     1450     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1451     do with frame F-Main
     1452     :
     1453       assign
     1454         tog-1:label = 'все':U
     1455         tog-2:label = 'Новинка':U
     1456         tog-3:label = 'Основная группа':U
     1457         tog-4:label = 'Нештатный':U
     1458         tog-5:label = 'На вывод из ассортимента':U
     1459         tog-6:label = 'Пусто':U
     1460       .
     1461     end.
     1462     CASE place-call:
     1463       WHEN 'schedule':U THEN DO:
     1464         RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     1465         CASE v-profile-id:
     1466           WHEN 54 THEN DO:
     1467             assign
     1468               fi-days-wt-goods          = v-days-wt-goods
     1469               fi-critical-qnty-balance  = v-critical-qnty-balance
     1470               fi-critical-qnty-sale     = v-critical-qnty-sale
     1471               fi-critical-qnty-order    = v-critical-qnty-order
     1472               tg-gds-by-am              = v-gds-by-am
     1473               tg-group-by-post          = v-group-by-post
     1474               tg-group-by-order         = v-group-by-order
     1475             .
     1476             display
     1477               fi-days-wt-goods
     1478               fi-critical-qnty-balance
     1479               fi-critical-qnty-sale
     1480               fi-critical-qnty-order
     1481               tg-gds-by-am
     1482             with frame F-Main .
     1483             enable
     1484             fi-days-wt-goods
     1485             fi-critical-qnty-balance
     1486             fi-critical-qnty-sale
     1487             fi-critical-qnty-order
     1488             tg-gds-by-am
     1489             tg-group-by-order
     1490             with frame F-Main .
     1491             assign tog-1 = yes.
     1492             display
     1493             tog-1
     1494             with frame F-Main .
     1495             apply "VALUE-CHANGED" to tog-1.
     1496             disable
     1497             tog-1
     1498             with frame F-Main .
     1499           end.
     1500         end case.
     1501       end.
     1502       otherwise do:
     1503         run uf-get( input 'ctrasm':U
     1504                   , input v-cntxt-userid
     1505                   , output v-list
     1506                   , output v-naim
     1507                   , output v-print-graft
     1508                   , output v-sort-gr
     1509                   , output v-type-price
     1510                   , output v-type-val
     1511                   ) .
     1512         if num-entries(v-list , chr(4)) = 15
     1513         then do:
     1514           assign
     1515             tg-gds-by-am              = logical(entry( 1, v-list, chr(4)))
     1516             tg-group-by-post          = logical(entry( 2, v-list, chr(4)))
     1517             tg-detailed               = logical(entry( 3, v-list, chr(4)))
     1518             fi-critical-qnty-balance  = decimal(entry( 4, v-list, chr(4)))
     1519             fi-critical-qnty-sale     = decimal(entry( 5, v-list, chr(4)))
     1520             fi-critical-qnty-order    = decimal(entry( 6, v-list, chr(4)))
     1521             fi-days-wt-goods          = decimal(entry( 7, v-list, chr(4)))
     1522             fi-gds-qnty               = decimal(entry( 8, v-list, chr(4)))
     1523             tog-1                     = logical(entry( 9, v-list, chr(4)))
     1524             tog-2                     = logical(entry( 10, v-list, chr(4)))
     1525             tog-3                     = logical(entry( 11, v-list, chr(4)))
     1526             tog-4                     = logical(entry( 12, v-list, chr(4)))
     1527             tog-5                     = logical(entry( 13, v-list, chr(4)))
     1528             tog-6                     = logical(entry( 14, v-list, chr(4)))
     1529             tg-group-by-order         = logical(entry( 15, v-list, chr(4)))
     1530           no-error .
     1531           display
     1532             tg-gds-by-am
     1533             tg-group-by-order
     1534             fi-critical-qnty-balance
     1535             fi-critical-qnty-sale
     1536             fi-critical-qnty-order
     1537             fi-days-wt-goods
     1538             tog-1
     1539             tog-2
     1540             tog-3
     1541             tog-4
     1542             tog-5
     1543             tog-6
     1544           with frame F-Main.
     1545         end.
     1546         else do:
     1547           display
     1548             tg-gds-by-am
     1549             tg-group-by-order
     1550             fi-critical-qnty-balance
     1551             fi-critical-qnty-sale
     1552             fi-critical-qnty-order
     1553             fi-days-wt-goods
     1554             tog-1
     1555             tog-2
     1556             tog-3
     1557             tog-4
     1558             tog-5
     1559             tog-6
     1560           with frame F-Main.
     1561         end.
     1562       END.
     1563     END CASE.
     1564     assign
     1565       tg-group-by-post = no
     1566     .
     1567   END PROCEDURE.
     1568   PROCEDURE my-params :
     1569   define input parameter p-action as character no-undo .
     1570   define variable v-value-character as character no-undo .
     1571   define variable v-value-date as date no-undo .
     1572   define variable v-value-decimal as decimal no-undo .
     1573   define variable v-value-integer as integer no-undo .
     1574   define variable v-value-logical as logical no-undo .
     1575   DEFINE VARIABLE v-index-id AS INTEGER NO-UNDO.
     1576   define variable v-obj-str as character no-undo .
     1577   CASE p-action:
     1578      WHEN "get" THEN DO:
     1579       IF v-profile-id = 54  THEN DO:
     1580          v-index-id = 0.
     1581          RUN rcps_get-value IN parent-handle (
     1582                                             input "p-gds-by-am"
     1583                                            ,INPUT-output v-index-id
     1584                                            ,output v-value-character
     1585                                            ,output v-value-date
     1586                                            ,output v-value-decimal
     1587                                            ,output v-value-integer
     1588                                            ,output v-gds-by-am
     1589                                            ) no-error .
     1590          v-index-id = 0.
     1591          RUN rcps_get-value IN parent-handle (
     1592                                             input "p-group-by-post"
     1593                                            ,INPUT-output v-index-id
     1594                                            ,output v-value-character
     1595                                            ,output v-value-date
     1596                                            ,output v-value-decimal
     1597                                            ,output v-value-integer
     1598                                            ,output v-group-by-post
     1599                                            ) no-error .
     1600          v-index-id = 0.
     1601          RUN rcps_get-value IN parent-handle (
     1602                                             input "p-critical-qnty-balance"
     1603                                            ,INPUT-output v-index-id
     1604                                            ,output v-value-character
     1605                                            ,output v-value-date
     1606                                            ,output v-critical-qnty-balance
     1607                                            ,output v-value-integer
     1608                                            ,output v-value-logical
     1609                                            ) no-error .
     1610          v-index-id = 0.
     1611          RUN rcps_get-value IN parent-handle (
     1612                                             input "p-critical-qnty-sale"
     1613                                            ,INPUT-output v-index-id
     1614                                            ,output v-value-character
     1615                                            ,output v-value-date
     1616                                            ,output v-critical-qnty-sale
     1617                                            ,output v-value-integer
     1618                                            ,output v-value-logical
     1619                                            ) no-error .
     1620          v-index-id = 0.
     1621          RUN rcps_get-value IN parent-handle (
     1622                                             input "p-critical-qnty-order"
     1623                                            ,INPUT-output v-index-id
     1624                                            ,output v-value-character
     1625                                            ,output v-value-date
     1626                                            ,output v-critical-qnty-order
     1627                                            ,output v-value-integer
     1628                                            ,output v-value-logical
     1629                                            ) no-error .
     1630          v-index-id = 0.
     1631          RUN rcps_get-value IN parent-handle (
     1632                                             input "p-days-wt-goods"
     1633                                            ,INPUT-output v-index-id
     1634                                            ,output v-value-character
     1635                                            ,output v-value-date
     1636                                            ,output v-value-decimal
     1637                                            ,output v-days-wt-goods
     1638                                            ,output v-value-logical
     1639                                            ) no-error .
     1640         empty temp-table X-init_obj-list.
     1641         v-index-id = 1.
     1642         do while v-index-id >= 1 :
     1643           RUN rcps_get-value IN parent-handle (
     1644                                           input "p-objects"
     1645                                           ,INPUT-output v-index-id
     1646                                           ,output v-obj-str
     1647                                           ,output v-value-date
     1648                                           ,output v-value-decimal
     1649                                           ,output v-value-integer
     1650                                           ,output v-value-logical
     1651                                           ) no-error .
     1652           if error-status:error then leave.
     1653           if v-obj-str = '' then leave.
     1654           find first X-init_obj-list where
     1655                     X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
     1656                 and  X-init_obj-list.obj-code = integer(substring(v-obj-str, 4)) no-error.
     1657           if not available X-init_obj-list then do:
     1658             create X-init_obj-list.
     1659             assign
     1660             X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
     1661             X-init_obj-list.obj-code = integer(substring(v-obj-str, 4))
     1662             .
     1663             release X-init_obj-list.
     1664           end.
     1665         end.
     1666         X-selectobject =  "choice":U.
     1667       END.
     1668       RUN local-initialize IN THIS-PROCEDURE.
     1669      END.
     1670      WHEN "set" THEN do:
     1671       IF v-profile-id = 54 THEN DO:
     1672         assign frame F-Main
     1673           fi-days-wt-goods
     1674           fi-gds-qnty
     1675           fi-critical-qnty-balance
     1676           fi-critical-qnty-sale
     1677           fi-critical-qnty-order
     1678           tg-gds-by-am
     1679           tg-group-by-order
     1680           tg-group-by-post
     1681           tg-detailed
     1682         .
     1683         RUN rcps_set-value IN parent-handle (
     1684                                          input "p-gds-by-am"
     1685                                         ,INPUT 0
     1686                                         ,input ''
     1687                                         ,input ?
     1688                                         ,input 0.0
     1689                                         ,input 0
     1690                                         ,input tg-gds-by-am
     1691                                         ) no-error .
     1692         RUN rcps_set-value IN parent-handle (
     1693                                          input "p-group-by-post"
     1694                                         ,INPUT 0
     1695                                         ,input ''
     1696                                         ,input ?
     1697                                         ,input 0.0
     1698                                         ,input 0
     1699                                         ,input tg-group-by-post
     1700                                         ) no-error .
     1701         RUN rcps_set-value IN parent-handle (
     1702                                          input "p-critical-qnty-balance"
     1703                                         ,INPUT 0
     1704                                         ,input ''
     1705                                         ,input ?
     1706                                         ,input fi-critical-qnty-balance
     1707                                         ,input 0
     1708                                         ,input no
     1709                                         ) no-error .
     1710         RUN rcps_set-value IN parent-handle (
     1711                                          input "p-critical-qnty-sale"
     1712                                         ,INPUT 0
     1713                                         ,input ''
     1714                                         ,input ?
     1715                                         ,input fi-critical-qnty-sale
     1716                                         ,input 0
     1717                                         ,input no
     1718                                         ) no-error .
     1719         RUN rcps_set-value IN parent-handle (
     1720                                          input "p-critical-qnty-order"
     1721                                         ,INPUT 0
     1722                                         ,input ''
     1723                                         ,input ?
     1724                                         ,input fi-critical-qnty-order
     1725                                         ,input 0
     1726                                         ,input no
     1727                                         ) no-error .
     1728         RUN rcps_set-value IN parent-handle (
     1729                                          input "p-days-wt-goods"
     1730                                         ,INPUT 0
     1731                                         ,input ''
     1732                                         ,input ?
     1733                                         ,input 0.0
     1734                                         ,input fi-days-wt-goods
     1735                                         ,input no
     1736                                         ) no-error .
     1737         v-index-id = 0.
     1738         for each obj-list :
     1739           v-index-id = v-index-id + 1.
     1740           RUN rcps_set-value IN parent-handle (
     1741                                           input "p-objects"
     1742                                           ,INPUT v-index-id
     1743                                           ,input substitute("&1&2", obj-list.obj-type, obj-list.obj-code)
     1744                                           ,input ?
     1745                                           ,input 0.0
     1746                                           ,input 0
     1747                                           ,input no
     1748                                           ) no-error .
     1749           if error-status:error then do:
     1750             message
     1751             error-status:get-message(1) return-value
     1752             view-as alert-box .
     1753             undo, return error .
     1754           end.
     1755         end.
     1756         v-index-id = v-index-id + 1.
     1757         do while true:
     1758           run rcps_proc-b-del in parent-handle (
     1759                                                  input "p-objects"
     1760                                                 ,input v-index-id) no-error.
     1761           if error-status:error
     1762           or return-value = "not-found" then leave.
     1763           v-index-id = v-index-id + 1.
     1764         end.
     1765         if error-status:error then do:
     1766           message
     1767           error-status:get-message(1) return-value
     1768           view-as alert-box .
     1769           undo, return error .
     1770         end.
     1771       END.
     1772      END.
     1773   END CASE.
     1774   END PROCEDURE.
     1775   PROCEDURE my-report :
     1776   define variable v-naim           as character        no-undo.
     1777   define variable v-list           as character        no-undo.
     1778   define variable v-print-graft    as logical          no-undo.
     1779   define variable v-sort-gr        as logical          no-undo.
     1780   define variable v-type-price     as logical          no-undo.
     1781   define variable v-type-val       as logical          no-undo.
     1782     assign frame F-Main
     1783       fi-days-wt-goods
     1784       fi-gds-qnty
     1785       fi-critical-qnty-balance
     1786       fi-critical-qnty-sale
     1787       fi-critical-qnty-order
     1788       tg-gds-by-am
     1789       tg-group-by-order
     1790       tg-group-by-post
     1791       tg-detailed
     1792       tog-1
     1793       tog-2
     1794       tog-3
     1795       tog-4
     1796       tog-5
     1797       tog-6
     1798     .
     1799     if fi-days-wt-goods > ( x-Date-End - x-Date-Start )
     1800     then do:
     1801       message
     1802         "Количество дней без товара не может превышать количество дней в периоде" skip
     1803       view-as alert-box information.
     1804       assign
     1805         fi-days-wt-goods = ( x-Date-End - x-Date-Start )
     1806       .
     1807       display
     1808         fi-days-wt-goods
     1809       with frame F-Main.
     1810       return .
     1811     end.
     1812     assign
     1813       v-list =  string(tg-gds-by-am     , "yes/no") + chr(4) +
     1814                 string(tg-group-by-post , "yes/no") + chr(4) +
     1815                 string(tg-detailed      , "yes/no") + chr(4) +
     1816                 string(fi-critical-qnty-balance   ) + chr(4) +
     1817                 string(fi-critical-qnty-sale      ) + chr(4) +
     1818                 string(fi-critical-qnty-order     ) + chr(4) +
     1819                 string(fi-days-wt-goods           ) + chr(4) +
     1820                 string(fi-gds-qnty                ) + chr(4) +
     1821                 string(tog-1            , "yes/no") + chr(4) +
     1822                 string(tog-2            , "yes/no") + chr(4) +
     1823                 string(tog-3            , "yes/no") + chr(4) +
     1824                 string(tog-4            , "yes/no") + chr(4) +
     1825                 string(tog-5            , "yes/no") + chr(4) +
     1826                 string(tog-6            , "yes/no") + chr(4) +
     1827                 string(tg-group-by-order, "yes/no")
     1828     .
     1829     run uf-set( input 'ctrasm':U
     1830               , input v-cntxt-userid
     1831               , input v-list
     1832               , input v-naim
     1833               , input v-print-graft
     1834               , input v-sort-gr
     1835               , input v-type-price
     1836               , input v-type-val
     1837               ) .
     1838     run rep/r-ctrasm.p ( input my-handle
     1839                        , input ?
     1840                        , input no
     1841                        , input x-date-start
     1842                        , input x-date-end
     1843                        , input tg-gds-by-am
     1844                        , input tg-group-by-order
     1845                        , input tg-group-by-post
     1846                        , input fi-critical-qnty-balance
     1847                        , input fi-critical-qnty-sale
     1848                        , input fi-critical-qnty-order
     1849                        , input fi-days-wt-goods
     1850                        , input ''
     1851                        , input ''
     1852                        , input tog-1
     1853                        , input tog-2
     1854                        , input tog-3
     1855                        , input tog-4
     1856                        , input tog-5
     1857                        , input tog-6
     1858                        ).
     1859   END PROCEDURE.
     1860   PROCEDURE my-var :
     1861     assign frame F-Main
     1862       fi-days-wt-goods
     1863       fi-gds-qnty
     1864       fi-critical-qnty-balance
     1865       fi-critical-qnty-sale
     1866       fi-critical-qnty-order
     1867       tg-gds-by-am
     1868       tg-group-by-order
     1869       tg-group-by-post
     1870       tg-detailed
     1871       tog-1
     1872       tog-2
     1873       tog-3
     1874       tog-4
     1875       tog-5
     1876       tog-6
     1877     .
     1878     assign
     1879       ReportHeader = "":U
     1880     .
     1881     if tg-gds-by-am = yes
     1882     then do:
     1883       assign
     1884         ReportHeader = chr(10) + "По АМ":U
     1885       .
     1886     end.
     1887     if tg-group-by-post = yes
     1888     then do:
     1889       assign
     1890         ReportHeader = ReportHeader + chr(10) + "Группировка по поставщику":U
     1891       .
     1892     end.
     1893     if tg-detailed = yes
     1894     then do:
     1895       assign
     1896         ReportHeader = ReportHeader + chr(10) + "Детализированный отчет":U
     1897       .
     1898     end.
     1899     assign
     1900       ReportHeader = ReportHeader + chr(10) + substitute( "Критический остаток: &1" , fi-critical-qnty-balance ) +
     1901                                     chr(10) + substitute( "Критическая продажа: &1" , fi-critical-qnty-sale    ) +
     1902                                     chr(10) + substitute( "Критический заказ: &1"   , fi-critical-qnty-order   ) +
     1903                                     chr(10) + substitute( "Фильтры:"                                           ) +
     1904                                     chr(10) + substitute( "Дней без товара: &1"     , fi-days-wt-goods         )
     1905     .
     1906     assign
     1907       ReportHeader = ReportHeader + chr(10) + "Показывать товары с ИЖТ:":U +
     1908         ( if tog-1 = yes then 'все':U else
     1909         ( if tog-2 = yes then 'Новинка':U   + "," else "" ) +
     1910         ( if tog-3 = yes then 'Основная группа':U   + "," else "" ) +
     1911         ( if tog-4 = yes then 'Нештатный':U  + "," else "" ) +
     1912         ( if tog-5 = yes then 'На вывод из ассортимента':U   + "," else "" ) +
     1913         ( if tog-6 = yes then 'Пусто':U       else "" ) )
     1914     .
     1915     assign
     1916       ReportHeader = ReportHeader + chr(10)
     1917     .
     1918   END PROCEDURE.
     1919   PROCEDURE state-changed :
     1920     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1921     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1922     CASE p-state:
     1923     END CASE.
     1924     END PROCEDURE.
