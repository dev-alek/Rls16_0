      907   DEFINE VARIABLE PostName AS CHARACTER
      908        VIEW-AS EDITOR SCROLLBAR-VERTICAL
      909        SIZE 49.75 BY 11.83 TOOLTIP "Список выбранных Поставщиков"
      910        FONT 4 NO-UNDO.
      911   DEFINE VARIABLE RADPost AS INTEGER
      912        VIEW-AS RADIO-SET VERTICAL
      913        RADIO-BUTTONS
      914             "Все", 1,
      915   "Справочник", 2,
      916   "Список", 3
      917        SIZE 15.63 BY 2.75 NO-UNDO.
      918   DEFINE RECTANGLE RECT-7
      919        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      920        SIZE 68.25 BY 15.29.
      921   DEFINE VARIABLE T-null AS LOGICAL INITIAL no
      922        LABEL "Показать нулевые цены"
      923        VIEW-AS TOGGLE-BOX
      924        SIZE 25.38 BY .83 NO-UNDO.
      925   DEFINE FRAME F-Main
      926        PostName AT ROW 2.96 COL 19.38 NO-LABEL
      927        RADPost AT ROW 3 COL 3.25 NO-LABEL
      928        T-null AT ROW 15.42 COL 4
      929        RECT-7 AT ROW 1.29 COL 2.63
      930        "Выбор поставщика:" VIEW-AS TEXT
      931             SIZE 19.38 BY .67 AT ROW 1.71 COL 4.75
      932             FGCOLOR 4
      933       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      934            SIDE-LABELS NO-UNDERLINE THREE-D
      935            AT COL 1 ROW 1 SCROLLABLE .
      936   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
      937     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-p-pl.w should only be RUN PERSISTENT."
      938             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
      939     RETURN.
      940   END.
      941   ASSIGN
      942          FRAME F-Main:SCROLLABLE       = FALSE
      943          FRAME F-Main:HIDDEN           = TRUE.
      944   ASSIGN
      945          PostName:READ-ONLY IN FRAME F-Main        = TRUE.
      946   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      947   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      948   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      949   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      950   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      951   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      952   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      953   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      954         adm-object-hdl = FRAME F-Main:HANDLE.
      955   RUN ensure-broker.
      956   THIS-PROCEDURE:ADM-DATA =
      957        'ADM1.1~`':U +
      958        'SmartViewer~`':U +
      959        '~`':U +
      960        'NO ~`':U +
      961        '~`':U +
      962        '~`':U +
      963        '~`':U +
      964        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      965           + "~`":U +
      966        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      967        'Record-Source,Record-Target,TableIO-Target~`':U +
      968        '~`':U +
      969        '~`~`~`~`~`~`~`~`~`~`~`':U +
      970        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      971            THEN "^^":U
      972        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      973             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      974   PROCEDURE adm-apply-entry :
      975     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      976   END PROCEDURE.
      977   PROCEDURE adm-destroy :
      978    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      979   END PROCEDURE.
      980   PROCEDURE adm-disable :
      981       DISABLE RECT-7 PostName RADPost T-null WITH FRAME F-Main.
      982       RUN dispatch ('disable-fields':U).
      983       RUN set-attribute-list ('ENABLED=no':U).
      984       RETURN.
      985   END PROCEDURE.
      986   PROCEDURE adm-edit-attribute-list :
      987         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      988         RETURN.
      989   END PROCEDURE.
      990   PROCEDURE adm-enable :
      991       ENABLE UNLESS-HIDDEN RECT-7 PostName RADPost T-null WITH FRAME F-Main.
      992       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      993       RUN set-attribute-list ('ENABLED=yes':U).
      994       RETURN.
      995   END PROCEDURE.
      996   PROCEDURE adm-exit :
      997        RUN notify ('exit':U).
      998     RETURN.
      999   END PROCEDURE.
     1000   PROCEDURE adm-hide :
     1001     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1002   END PROCEDURE.
     1003   PROCEDURE adm-initialize :
     1004     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1005   END PROCEDURE.
     1006   PROCEDURE adm-show-errors :
     1007       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1008       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1009           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1010       END.
     1011       RETURN.
     1012   END PROCEDURE.
     1013   PROCEDURE adm-UIB-mode :
     1014     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1015   END PROCEDURE.
     1016   PROCEDURE adm-view :
     1017     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1018   END PROCEDURE.
     1019   PROCEDURE dispatch :
     1020       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1021       RUN broker-dispatch IN adm-broker-hdl
     1022           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1023       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1024   END PROCEDURE.
     1025   PROCEDURE ensure-broker :
     1026   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1027   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1028   DO:
     1029       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1030       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1031   END.
     1032   END PROCEDURE.
     1033   PROCEDURE get-attribute :
     1034     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1035     RUN broker-get-attribute IN adm-broker-hdl
     1036         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1037     RETURN RETURN-VALUE.
     1038   END PROCEDURE.
     1039   PROCEDURE get-attribute-list :
     1040     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1041     RUN broker-get-attribute-list IN adm-broker-hdl
     1042         (INPUT THIS-PROCEDURE,
     1043          INPUT ?,
     1044          OUTPUT p-attr-list) NO-ERROR.
     1045     RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE new-state :
     1048     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1049     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1050     RETURN.
     1051   END PROCEDURE.
     1052   PROCEDURE notify :
     1053     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1054     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1055     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1056         RETURN "ADM-ERROR":U.
     1057     RETURN.
     1058   END PROCEDURE.
     1059   PROCEDURE set-attribute-list :
     1060     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1061     RUN ensure-broker.
     1062     RUN broker-set-attribute-list IN adm-broker-hdl
     1063         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1064     RETURN.
     1065   END PROCEDURE.
     1066   PROCEDURE set-position :
     1067       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1068       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1069       IF VALID-HANDLE(adm-object-hdl) THEN
     1070       DO:
     1071         ASSIGN adm-object-hdl:ROW    =   p-row
     1072                adm-object-hdl:COLUMN =   p-col.
     1073       END.
     1074       RETURN.
     1075   END PROCEDURE.
     1076   PROCEDURE adm-display-fields :
     1077       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1078       RETURN.
     1079   END PROCEDURE.
     1080   PROCEDURE adm-open-query :
     1081     RETURN.
     1082   END PROCEDURE.
     1083   PROCEDURE adm-row-changed :
     1084         IF VALID-HANDLE(adm-object-hdl) THEN
     1085           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1086         RUN notify ('row-available':U).
     1087         RETURN.
     1088   END PROCEDURE.
     1089   PROCEDURE reposition-query :
     1090       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1091       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1092       RETURN.
     1093   END PROCEDURE.
     1094     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1095     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1096     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1097     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1098     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1099     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1100     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1101     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1102     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1103     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1104     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1105     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1106     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1107     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1108     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1109     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1110     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1111     IF "":U = "":U THEN
     1112       RUN modify-list-attribute IN adm-broker-hdl
     1113         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1114     RUN use-create-on-add(?).
     1115   PROCEDURE adm-add-record :
     1116       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1117          "must have at least one Enabled Table to perform Add.":U
     1118          VIEW-AS ALERT-BOX ERROR.
     1119       RETURN.
     1120   END PROCEDURE.
     1121   PROCEDURE adm-assign-record :
     1122    MESSAGE
     1123          "Object ":U THIS-PROCEDURE:FILE-NAME
     1124            "must have at least one Enabled Table to perform Assign.":U
     1125              VIEW-AS ALERT-BOX ERROR.
     1126      RETURN.
     1127     END PROCEDURE.
     1128   PROCEDURE adm-assign-statement :
     1129     RETURN.
     1130   END PROCEDURE.
     1131   PROCEDURE adm-cancel-record :
     1132      RETURN.
     1133     END PROCEDURE.
     1134   PROCEDURE adm-copy-record :
     1135       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1136        "must have at least one Enabled Table to perform Copy.":U
     1137          VIEW-AS ALERT-BOX ERROR.
     1138       RETURN.
     1139   END PROCEDURE.
     1140   PROCEDURE adm-create-record :
     1141      RETURN.
     1142   END PROCEDURE.
     1143   PROCEDURE adm-current-changed :
     1144     RETURN.
     1145   END PROCEDURE.
     1146   PROCEDURE adm-delete-record :
     1147    MESSAGE
     1148          "Object ":U THIS-PROCEDURE:FILE-NAME
     1149            "must have at least one Enabled Table to perform Delete.":U
     1150              VIEW-AS ALERT-BOX ERROR.
     1151       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1152       RETURN.
     1153   END PROCEDURE.
     1154   PROCEDURE adm-disable-fields :
     1155         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1156       RETURN.
     1157   END PROCEDURE.
     1158   PROCEDURE adm-enable-fields :
     1159       RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE adm-end-update :
     1162     RETURN.
     1163   END PROCEDURE.
     1164   PROCEDURE adm-reset-record :
     1165       RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE adm-update-record :
     1168       MESSAGE
     1169         "Object ":U THIS-PROCEDURE:FILE-NAME
     1170           "must have at least one Enabled Table to perform Update.":U
     1171             VIEW-AS ALERT-BOX ERROR.
     1172      RETURN.
     1173   END PROCEDURE.
     1174   PROCEDURE check-modified :
     1175   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1176   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1177   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1178   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1179     IF check-state = "check":U THEN
     1180     DO:
     1181       RUN get-link-handle IN adm-broker-hdl
     1182         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1183            OUTPUT group-target-list).
     1184       IF group-target-list NE "":U THEN
     1185       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1186         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1187         RUN check-modified IN curr-widget ('group-check':U).
     1188         IF RETURN-VALUE NE "":U THEN
     1189         DO:
     1190           RUN check-modified-message(RETURN-VALUE).
     1191           RETURN "":U.
     1192         END.
     1193       END.
     1194     END.
     1195     RETURN "":U.
     1196   END PROCEDURE.
     1197   PROCEDURE check-modified-message :
     1198     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1199        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1200           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1201        IF RETURN-VALUE = "YES":U THEN
     1202           RUN notify ('view,CONTAINER-SOURCE':U).
     1203        MESSAGE IF p-changed-table NE ? THEN
     1204           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1205           ELSE "Current values have been changed."
     1206           SKIP "  Do you wish to save those changes?"
     1207           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1208        IF ANS THEN
     1209        DO:
     1210           IF group-assign-target THEN
     1211             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1212           ELSE RUN dispatch('update-record':U).
     1213           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1214           DO:
     1215               MESSAGE "Changes to the previous record were not saved."
     1216                 VIEW-AS ALERT-BOX ERROR.
     1217               IF group-assign-target THEN
     1218                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1219               ELSE RUN dispatch ('cancel-record':U).
     1220           END.
     1221        END.
     1222        ELSE DO:
     1223          IF group-assign-target THEN
     1224             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1225          ELSE RUN dispatch('cancel-record':U).
     1226        END.
     1227        RETURN.
     1228   END PROCEDURE.
     1229   PROCEDURE get-rowid :
     1230       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1231       ASSIGN
     1232       p-table   =   adm-first-table.
     1233       RETURN.
     1234   END PROCEDURE.
     1235   PROCEDURE init-group-assign :
     1236       RUN request-attribute IN adm-broker-hdl
     1237         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1238       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1239         group-assign-target = yes.
     1240       ELSE group-assign-target = no.
     1241       RETURN.
     1242   END PROCEDURE.
     1243   PROCEDURE set-editors :
     1244       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1245       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1246       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1247       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1248       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1249       DO WHILE VALID-HANDLE (curr-widget):
     1250           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1251              curr-widget:HIDDEN = no THEN DO:
     1252             CASE p-field-setting:
     1253               WHEN "INITIALIZE":U THEN
     1254               DO:
     1255                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1256                     read-only-list +
     1257                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1258                        STRING(curr-widget).
     1259               END.
     1260               WHEN "DISABLE":U OR
     1261               WHEN "ENABLE":U THEN
     1262               DO:
     1263                   curr-widget:SENSITIVE = yes.
     1264                   RUN get-attribute ('Read-Only-Editors':U).
     1265                   IF RETURN-VALUE = ? OR
     1266                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1267                       curr-widget:READ-ONLY =
     1268                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1269               END.
     1270               WHEN "CLEAR":U THEN
     1271                   curr-widget:SCREEN-VALUE = "":U.
     1272             END CASE.
     1273           END.
     1274           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1275       END.
     1276       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1277         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1278           + '"':U).
     1279       RETURN.
     1280   END PROCEDURE.
     1281   PROCEDURE use-check-modified-all :
     1282    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1283     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1284     RETURN.
     1285   END PROCEDURE.
     1286   PROCEDURE use-create-on-add :
     1287   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1288      RETURN.
     1289   END PROCEDURE.
     1290   PROCEDURE use-initial-lock :
     1291     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1292     ASSIGN adm-initial-lock = p-attr-value.
     1293     RETURN.
     1294   END PROCEDURE.
     1295     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1296   ON VALUE-CHANGED OF RADPost IN FRAME F-Main
     1297   DO:
     1298     Assign RadPost.
     1299     for each g#post-f : delete g#post-f. end.
     1300     Case RAdPost :
     1301         when 3 then DO:
     1302           run str/cli-list.w
     1303               ( my-handle,
     1304                 v-cntxt-host-code-obj,
     1305                 v-cntxt-obj-type,
     1306                 v-cntxt-obj-code)
     1307                 .
     1308           Postname = "" .
     1309           For each cli-list :
     1310             find first ub.cli-grp where ub.cli-grp.node-code = cli-list.grp-code no-lock no-error .
     1311             if available ub.cli-grp then do:
     1312                 create g#post-f.
     1313                 assign
     1314                   g#post-f.obj-type = cli-list.obj-type
     1315                   g#post-f.obj-code = cli-list.obj-code
     1316                   g#post-f.obj-name = cli-list.obj-name
     1317                   g#post-f.grp-code = cli-list.grp-code
     1318                   g#post-f.grp-name = cli-list.grp-name
     1319                   g#post-f.lvl-num  = ub.cli-grp.lvl-num
     1320                   Postname = Postname + cli-list.obj-name + chr(10)
     1321                   .
     1322             end.
     1323           End.
     1324           Display PostName with frame F-Main .
     1325         END.
     1326     when 1 then DO:
     1327             Assign  Postname = "".
     1328             Display PostName with frame F-Main .
     1329          END.
     1330     when 2 then
     1331           do:
     1332               run ref/cli-all.w
     1333                             ( my-handle
     1334                            , "b-sel,b-mark"
     1335                            , 'орг':U
     1336                            , 'все':U
     1337                            , 'текущие':U
     1338                            , ?
     1339                            , ",,,,,,NO,,"
     1340                            , ?
     1341                           , output post-grp_recids ) .
     1342               if post-grp_recids = "" then do:
     1343                    Assign  Postname = 'все':U radpost = 1.
     1344                    Display PostName   radpost with frame F-Main.
     1345               end.
     1346               else do:
     1347                   Assign  Postname = ''.
     1348                   v-nn = num-entries( post-grp_recids )  .
     1349                   DO ii = 1 TO v-nn :
     1350                       find cli-post where recid( cli-post ) = int(entry( ii, post-grp_recids )) no-lock no-error .
     1351                       if cli-post.obj-type = 'орг':U
     1352                       or cli-post.obj-type = 'чел':U then do:
     1353                         find first ub.cli-grp where ub.cli-grp.node-code = cli-post.grp-code no-lock no-error .
     1354                         if available cli-post and available ub.cli-grp then do:
     1355                             create g#post-f.
     1356                             assign
     1357                               g#post-f.obj-type = cli-post.obj-type
     1358                               g#post-f.obj-code = cli-post.obj-code
     1359                               g#post-f.obj-name = cli-post.obj-name
     1360                               g#post-f.grp-code = cli-post.grp-code
     1361                               g#post-f.grp-name = cli-post.grp-name
     1362                               g#post-f.lvl-num  = ub.cli-grp.lvl-num
     1363                               Postname = PostName + cli-post.obj-name + chr(10)
     1364                             .
     1365                         end.
     1366                       end.
     1367                   END.
     1368                    Display PostName with frame F-Main .
     1369               end.
     1370           end.
     1371     End case.
     1372     END.
     1373   PROCEDURE disable_UI :
     1374     HIDE FRAME F-Main.
     1375     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1376   END PROCEDURE.
