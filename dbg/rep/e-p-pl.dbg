     1387   assign frame F-Main PostName  RADPost t-null  .
     1388   ReportNAme = "СРАВНИТЕЛЬНЫЙ АНАЛИЗ ЦЕН ПОСТАВЩИКОВ" .
     1389    ReportHeader = "Поставщики : " + (if radpost = 1 then "Все (по выбранным товарам)" else PostName) + chr(10).
     1390    sheetf.Excel-Column-Lable = "Код,Артикул,Название товара,Ед.изм" .
     1391    sheetf.Sizes  = "10,16,60,7" .
     1392    Sheetf.ColFOrmat = "2=@;3=@;4=@"  .
