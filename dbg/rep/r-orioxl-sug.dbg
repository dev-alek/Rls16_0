      912   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      913   define  stream PrnLibStream.
      914   procedure prn-lib-prn-file :
      915     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      916     define input parameter p-DIsabledoptions as integer no-undo .
      917     define variable v-report-name as character no-undo .
      918     define variable v-user-action as character no-undo .
