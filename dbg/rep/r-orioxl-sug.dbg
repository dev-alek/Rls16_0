     2859     run prn-lib-reportviewer-report-name in this-procedure (
     2860       input THIS-PROCEDURE
     2861       ,input v-file-name-rep-htm
     2862       ).
     2863   procedure data-print :
     2864     next_:
     2865     for each  bf_rvs-line no-lock where
     2866       bf_rvs-line.rvs-code = bf_rvs-doc.rvs-code  and
     2867       bf_rvs-line.obj-type = bf_rvs-doc.obj-type  and
     2868       bf_rvs-line.obj-code = bf_rvs-doc.obj-code
     2869       , first bf_goods    no-lock where
     2870       bf_goods.gds-code = bf_rvs-line.gds-code
     2871       , first bf_doc-line no-lock where
     2872       bf_trn-doc.doc-code = bf_doc-line.doc-code and
     2873       bf_goods.prod-code = bf_doc-line.prod-code and
     2874       bf_goods.prod-type = bf_doc-line.prod-type and
     2875       bf_goods.artic =  bf_doc-line.artic
     2876       break
     2877       by bf_rvs-line.gds-code
     2878       by bf_rvs-line.pl-code
     2879       :
     2880       if is-sug(bf_goods.gds-code) then
     2881       do:
     2882         if first-of( bf_rvs-line.gds-code )
     2883           then
     2884         do:
     2885   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2886   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2887     (input  bf_rvs-line.obj-type
     2888     ,input  bf_rvs-line.obj-code
     2889     ,input  bf_rvs-line.gds-code
     2890     ,input  0
     2891     ,input  bf_trn-doc.fact-order
     2892     ,output v-doc-num
     2893     ,output dprice-sale
     2894     ,output droad-tax
     2895     ,output dexcise
     2896     ) no-error .
     2897           if error-status :error
     2898             then
     2899           do:
     2900             run waitfram-hide in this-procedure .
     2901             message
     2902               'Не могу определить текущие продажные цены.'
     2903               view-as alert-box error .
     2904             undo, return error .
     2905           end.
     2906         end.
     2907       end.
     2908       else next next_ .
     2909       find first bf_place no-lock where
     2910         bf_place.obj-type = bf_rvs-line.obj-type and
     2911         bf_place.obj-code = bf_rvs-line.obj-code and
     2912         bf_place.pl-code  = bf_rvs-line.pl-code  .
     2913       find first tt-sug where tt-sug.gds-code = bf_goods.gds-code and tt-sug.pl-code = bf_rvs-line.pl-code no-error .
     2914       if not available (tt-sug) then
     2915       do:
     2916       end.
     2917       create tt-sug .
     2918       assign
     2919         tt-sug.gds-code = bf_goods.gds-code
     2920         tt-sug.gds-name = bf_goods.gds-name
     2921         tt-sug.pl-code  = bf_rvs-line.pl-code
     2922         tt-sug.level    = (bf_rvs-line.state-level-petrol + bf_rvs-line.state-level-water) / bf_rvs-line.state-level-total * 100
     2923         tt-sug.volue    = bf_rvs-line.state-measure-qnty
     2924         tt-sug.density  = bf_rvs-line.state-density
     2925         tt-sug.temp     = bf_rvs-line.state-temperature
     2926         tt-sug.qnty     = bf_rvs-line.state-measure-cli-qnty
     2927         tt-sug.volue-pl = bf_rvs-line.add-qnty
     2928         tt-sug.qnty1    = tt-sug.volue-pl * tt-sug.density
     2929         tt-sug.pl-type  = "трубопровод"
     2930         .
     2931       find first c-rvs-doc no-lock where c-rvs-doc.rvs-code = bf_rvs-doc.rvs-code and c-rvs-doc.obj-code = bf_rvs-doc.obj-code and
     2932         c-rvs-doc.obj-type = bf_rvs-doc.obj-type and c-rvs-doc.status_ = 'разрешен':U .
     2933       for first rvs-line-attr no-lock
     2934            where rvs-line-attr.obj-code  = bf_rvs-line.obj-code
     2935            and rvs-line-attr.obj-type  = bf_rvs-line.obj-type
     2936            and rvs-line-attr.gds-code  = bf_rvs-line.gds-code
     2937            and rvs-line-attr.pl-code   = bf_rvs-line.pl-code
     2938            and rvs-line-attr.rvs-code  = bf_rvs-line.rvs-code
     2939            and rvs-line-attr.attr-code = "delta-mass-qnty"
     2940        :
     2941          delta-mass-qnty = decimal(rvs-line-attr.attr-value) .
     2942       end.
     2943       if delta-mass-qnty = ?
     2944       or delta-mass-qnty = 0
     2945       then
     2946         delta-mass-qnty = 0.65
     2947       .
     2948       tt-sug.log-pl = if tt-sug.volue-pl <> 0 then "заполнено" else "не заполнено" .
     2949       tt-sug.delta  = (tt-sug.qnty * delta-mass-qnty)/ 100 .
     2950       tt-sug.delta1  = (tt-sug.qnty1 * delta-mass-qnty)/ 100 .
     2951       define variable v-value     as character no-undo.
     2952       define variable v-ok        as logical   no-undo.
     2953       define variable pl-rvd-dens as logical   no-undo .
     2954       define variable pl-rvd-lvl  as logical   no-undo .
     2955       define variable pl-rvd-temp as logical   no-undo .
     2956       define variable corr-date as date no-undo .
     2957       define variable corr-time as integer no-undo .
     2958       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = bf_rvs-line.rvs-code and
     2959       ub.inv-doc-attr.attr-code = "create_date" no-error .
     2960       if available (ub.inv-doc-attr) then corr-date = date(ub.inv-doc-attr.attr-value). else corr-date = c-rvs-doc.corr-date .
     2961       find first ub.inv-doc-attr no-lock where ub.inv-doc-attr.doc-code = bf_rvs-line.rvs-code and
     2962       ub.inv-doc-attr.attr-code = "create_time" no-error .
     2963       if available (ub.inv-doc-attr) then corr-time = integer(ub.inv-doc-attr.attr-value). else corr-time = c-rvs-doc.corr-time .
     2964       if not get_meas(bf_rvs-line.obj-code, bf_rvs-line.obj-type, bf_rvs-line.pl-code, corr-date, corr-time) then
     2965         tt-sug.type_dan = "PВД" .
     2966       else
     2967       do:
     2968         run c-place_get-attr (input "place-rvd-lvl"
     2969           ,input bf_rvs-line.obj-code
     2970           ,input bf_rvs-line.obj-type
     2971           ,input bf_rvs-line.pl-code
     2972           ,input corr-date
     2973           ,input corr-time
     2974           ,output v-value ) no-error .
     2975         if v-value = "" then pl-rvd-lvl = false .
     2976         else pl-rvd-lvl = not logical(v-value) .
     2977         run c-place_get-attr (input "place-rvd-tmp"
     2978           ,input bf_rvs-line.obj-code
     2979           ,input bf_rvs-line.obj-type
     2980           ,input bf_rvs-line.pl-code
     2981           ,input corr-date
     2982           ,input corr-time
     2983           ,output v-value ) no-error .
     2984         if v-value = "" then pl-rvd-temp = false .
     2985         else pl-rvd-temp = not logical(v-value) .
     2986         run c-place_get-attr (input "place-rvd-dnsty"
     2987           ,input bf_rvs-line.obj-code
     2988           ,input bf_rvs-line.obj-type
     2989           ,input bf_rvs-line.pl-code
     2990           ,input corr-date
     2991           ,input corr-time
     2992           ,output v-value ) no-error .
     2993         if v-value = "" then pl-rvd-dens = false .
     2994         else pl-rvd-dens = not logical(v-value) .
     2995         if pl-rvd-dens or pl-rvd-lvl or pl-rvd-temp then tt-sug.type_dan = "PВД" .
     2996         else tt-sug.type_dan = "AВД" .
     2997       end.
     2998       run placelib_get-attr  ( input "place-twice-code"
     2999         ,input bf_rvs-line.obj-code
     3000         ,input bf_rvs-line.obj-type
     3001         ,input bf_rvs-line.pl-code
     3002         ,output v-value
     3003         ,output v-ok      ) no-error.
     3004       if v-value <> "" then  tt-sug.pl-code_ = string(bf_place.loc1) + "," + v-value .
     3005       else tt-sug.pl-code_ = string(bf_place.loc1) .
     3006     end.
     3007   end procedure .
     3008     run waitfram-hide  in this-procedure .
     3009   end.
     3010   procedure table-inv:
     3011     put stream OutStr-html unformatted
     3012       '<Thead>' skip
     3013       '<TR><TD colspan="86" style="height: 14px;"></TD></TR>' skip
     3014       '<TR><TD colspan="86">При инвентаризации в резервуарах АГЗС установлено следующее:</TD></TR>' skip
     3015       '</Thead>' skip
     3016       .
     3017     put stream OutStr-html unformatted
     3018       '<TR style="height: 45px">' skip
     3019       '<TD text_wrap="true" colspan = "4" rowspan = "2" style="text-align: center; border: 1px solid black;">№</TD>' skip
     3020       '<TD text_wrap="true" colspan = "14" style="text-align: center; border: 1px solid black;">СУГ</TD>' skip
     3021       '<TD text_wrap="true" colspan = "6" rowspan = "2" style="text-align: center; border: 1px solid black;">Тип, номер резервуара</TD>' skip
     3022       '<TD text_wrap="true" colspan = "6" rowspan = "2" style="text-align: center; border: 1px solid black;">Тип ввода данных</TD>' skip
     3023       '<TD text_wrap="true" colspan = "6" rowspan = "2" style="text-align: center; border: 1px solid black;">Уровень напол. резервуара, %</TD>' skip
     3024       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Объем СУГ, л</TD>' skip
     3025       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Плотность СУГ, г/см3</TD>' skip
     3026       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Температура СУГ, °С</TD>' skip
     3027       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Масса СУГ, кг</TD>' skip
     3028       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Погрешность измерения, кг*</TD>' skip
     3029       '</TR>'skip
     3030       '<TR style="height: 45px">' skip
     3031       '<TD text_wrap="true" colspan = "9" style="text-align: center; border: 1px solid black;">наимен.</TD>' skip
     3032       '<TD text_wrap="true" colspan = "5" style="text-align: center; border: 1px solid black;">код</TD>' skip
     3033       '</TR>'skip
     3034       '<TR>' skip
     3035       '<TD colspan = "4" style="text-align: center; border: 1px solid black;">1</TD>' skip
     3036       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">2</TD>' skip
     3037       '<TD colspan = "5" style="text-align: center; border: 1px solid black;">3</TD>' skip
     3038       '<TD colspan = "6" style="text-align: center; border: 1px solid black;">4</TD>' skip
     3039       '<TD colspan = "6" style="text-align: center; border: 1px solid black;">5</TD>' skip
     3040       '<TD colspan = "6" style="text-align: center; border: 1px solid black;">6</TD>' skip
     3041       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">7</TD>' skip
     3042       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">8</TD>' skip
     3043       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">9</TD>' skip
     3044       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">10</TD>' skip
     3045       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">11</TD>' skip
     3046       '</TR>'skip
     3047       .
     3048       assign
     3049         j_LineCount = 0
     3050         .
     3051     for each tt-sug:
     3052       j_LineCount = j_LineCount + 1 .
     3053       put stream OutStr-html unformatted
     3054         '<TR>' skip
     3055         '<TD colspan = "4" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(j_LineCount) + '</TD>' skip
     3056         '<TD colspan = "9" text_wrap="true" style="text-align: center; border: 1px solid black;">' + tt-sug.gds-name + '</TD>' skip
     3057         '<TD colspan = "5" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.gds-code) + '</TD>' skip
     3058         '<TD colspan = "6" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.pl-code_) + '</TD>' skip
     3059         '<TD colspan = "6" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.type_dan) + '</TD>' skip
     3060         '<TD colspan = "6" text_wrap="true" style="text-align: center; border: 1px solid black;"></TD>' skip
     3061         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.volue,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.volue,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3062         '<TD colspan = "10" text_wrap="true" num="0.0000" val="' + fnc-convert-dot-to-colon(tt-sug.density,"->>>>>>>>>>>9.9999",4) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.density,"->>>>>>>>>>>9.9999",4) + '</TD>' skip
     3063         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.temp,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.temp,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3064         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.qnty,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.qnty,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3065         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.delta,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.delta,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3066         '</TR>'skip
     3067         .
     3068     end.
     3069     put stream OutStr-html unformatted
     3070       '<Thead>' skip
     3071       '<TR><TD colspan="86" style="height: 14px;"></TD></TR>' skip
     3072       '<TR><TD colspan="86">Наличие СУГ  технологических трубопроводах и оборудовании:</TD></TR>' skip
     3073       '</Thead>' skip
     3074       .
     3075     put stream OutStr-html unformatted
     3076       '<TR style="height: 65px">' skip
     3077       '<TD text_wrap="true" colspan = "4" rowspan = "2" style="text-align: center; border: 1px solid black;">№</TD>' skip
     3078       '<TD text_wrap="true" colspan = "14" style="text-align: center; border: 1px solid black;">СУГ</TD>' skip
     3079       '<TD text_wrap="true" colspan = "8" rowspan = "2" style="text-align: center; border: 1px solid black;">Наим. участка техн. трубопровода (оборуд)</TD>' skip
     3080       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Вместимость (объем) участка трубопровода (оборуд), л</TD>' skip
     3081       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Факт заполнения на момент инвентар (заполнено/ не заполнено)</TD>' skip
     3082       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Плотность СУГ, кг/м3</TD>' skip
     3083       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Температура СУГ, °С</TD>' skip
     3084       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Масса СУГ, кг</TD>' skip
     3085       '<TD text_wrap="true" colspan = "10" rowspan = "2" style="text-align: center; border: 1px solid black;">Погрешность измерения, кг**</TD>' skip
     3086       '</TR>'skip
     3087       '<TR style="height: 65px">' skip
     3088       '<TD text_wrap="true" colspan = "9" style="text-align: center; border: 1px solid black;">наимен.</TD>' skip
     3089       '<TD text_wrap="true" colspan = "5" style="text-align: center; border: 1px solid black;">код</TD>' skip
     3090       '</TR>'skip
     3091       '<TR>' skip
     3092       '<TD colspan = "4" style="text-align: center; border: 1px solid black;">1</TD>' skip
     3093       '<TD colspan = "9" style="text-align: center; border: 1px solid black;">2</TD>' skip
     3094       '<TD colspan = "5" style="text-align: center; border: 1px solid black;">3</TD>' skip
     3095       '<TD colspan = "8" style="text-align: center; border: 1px solid black;">4</TD>' skip
     3096       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">5</TD>' skip
     3097       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">6</TD>' skip
     3098       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">7</TD>' skip
     3099       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">8</TD>' skip
     3100       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">9</TD>' skip
     3101       '<TD colspan = "10" style="text-align: center; border: 1px solid black;">10</TD>' skip
     3102       '</TR>'skip
     3103       .
     3104       assign
     3105         j_LineCount = 0
     3106         .
     3107     for each tt-sug:
     3108       j_LineCount = j_LineCount + 1 .
     3109       put stream OutStr-html unformatted
     3110         '<TR>' skip
     3111         '<TD colspan = "4" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(j_LineCount) + '</TD>' skip
     3112         '<TD colspan = "9" text_wrap="true" style="text-align: center; border: 1px solid black;">' + tt-sug.gds-name + '</TD>' skip
     3113         '<TD colspan = "5" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.gds-code) + '</TD>' skip
     3114         '<TD colspan = "8" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.pl-type) + '</TD>' skip
     3115         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.volue-pl,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.volue-pl,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3116         '<TD colspan = "10" text_wrap="true" style="text-align: center; border: 1px solid black;">' + string(tt-sug.log-pl) + '</TD>' skip
     3117         '<TD colspan = "10" text_wrap="true" num="0.0000" val="' + fnc-convert-dot-to-colon(tt-sug.density,"->>>>>>>>>>>9.9999",4) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.density,"->>>>>>>>>>>9.9999",4) + '</TD>' skip
     3118         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.temp,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.temp,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3119         '<TD colspan = "10" text_wrap="true" num="0.000" val="' + fnc-convert-dot-to-colon(tt-sug.qnty1,"->>>>>>>>>>>9.999",3) + '" style="text-align: center; border: 1px solid black;">' + fnc-convert-dot-to-colon(tt-sug.qnty1,"->>>>>>>>>>>9.999",3) + '</TD>' skip
     3120         '<TD colspan = "10" text_wrap="true" style="text-align: center; border: 1px solid black;"></TD>' skip
     3121         '</TR>'skip
     3122         .
     3123     end.
     3124   end procedure .
     3125   PROCEDURE get-report-num :
     3126     define output parameter p-report-num as integer no-undo .
     3127     do
     3128       on error undo, return error return-value
     3129       :
     3130       run gbl/getrpnum.p (output p-report-num).
     3131     end.
     3132   END PROCEDURE.
