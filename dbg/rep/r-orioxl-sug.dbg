     2187     initial "@(#)$Workfile: r-orioxl-sug.i $ $Revision: 096e36ceea80, 2676, rls $":U .
     2188   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
     2189     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     2190     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
     2191     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     2192   END FUNCTION.
     2193   PROCEDURE get-month-name-case :
     2194     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     2195     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
     2196     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     2197     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
     2198       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     2199         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
     2200         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
     2201         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
     2202         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
     2203         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
     2204     DO ON ERROR UNDO, RETURN ERROR :
     2205       IF p-month < 1 OR p-month > 12 OR
     2206          p-case  < 1 OR p-case  >  6 THEN DO:
     2207         ASSIGN p-name = ?.
     2208       END.                           ELSE DO:
     2209         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
     2210       END.
     2211     END.
     2212   END PROCEDURE.
     2213   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     2214     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2215     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     2216     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     2217   END FUNCTION.
     2218   PROCEDURE get-sparsed-string :
     2219     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2220     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2221     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     2222     DO ON ERROR UNDO, RETURN ERROR :
     2223       DO jj = 1 TO LENGTH( p-instring ) :
     2224         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     2225       END.
     2226       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     2227     END.
