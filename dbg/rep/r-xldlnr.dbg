      517     Col-name[208]=   'GZ':U
      518     Col-name[209]=   'HA':U
      519     Col-name[210]=   'HB':U
      520     Col-name[211]=   'HC':U
      521     Col-name[212]=   'HD':U
      522     Col-name[213]=   'HE':U
      523     Col-name[214]=   'HF':U
      524     Col-name[215]=   'HG':U
      525     Col-name[216]=   'HH':U
      526     Col-name[217]=   'HI':U
      527     Col-name[218]=   'HJ':U
      528     Col-name[219]=   'HK':U
      529     Col-name[220]=   'HL':U
      530     Col-name[221]=   'HM':U
      531     Col-name[222]=   'HN':U
      532     Col-name[223]=   'HO':U
      533     Col-name[224]=   'HP':U
      534     Col-name[225]=   'HQ':U
      535     Col-name[226]=   'HR':U
      536     Col-name[227]=   'HS':U
      537     Col-name[228]=   'HT':U
      538     Col-name[229]=   'HU':U
      539     Col-name[230]=   'HV':U
      540     Col-name[231]=   'HW':U
      541     Col-name[232]=   'HX':U
      542     Col-name[233]=   'HY':U
      543     Col-name[234]=   'HZ':U
      544     Col-name[235]=   'IA':U
      545     Col-name[236]=   'IB':U
      546     Col-name[237]=   'IC':U
      547     Col-name[238]=   'ID':U
      548     Col-name[239]=   'IE':U
      549     Col-name[240]=   'IF':U
      550     Col-name[241]=   'IG':U
      551     Col-name[242]=   'IH':U
      552     Col-name[243]=   'II':U
      553     Col-name[244]=   'IJ':U
      554     Col-name[245]=   'IK':U
      555     Col-name[246]=   'IL':U
      556     Col-name[247]=   'IM':U
      557     Col-name[248]=   'IN':U
      558     Col-name[249]=   'IO':U
      559     Col-name[250]=   'IP':U
      560     Col-name[251]=   'IQ':U
      561     Col-name[252]=   'IR':U
      562     Col-name[253]=   'IS':U
      563     Col-name[254]=   'IT':U
      564     Col-name[255]=   'IU':U
      565     Col-name[256]=   'IV':U
      566     .
      567    end.
      568   end procedure.
      569   define new global shared variable g#library  as handle no-undo .
      570   define new global shared variable g#library2 as handle no-undo .
      571   define variable var-report-r-b as character no-undo .
      572   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      573   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      574     (output var-report-r-b
      575     )  .
      576   define variable xml_tmp as character no-undo.
      577   define variable Report as class ReportXml no-undo.
      578   define variable gds-str as character no-undo init "".
      579   define variable xslt-path as character no-undo.
      580   define variable rep-out-unit as class rep-out no-undo.
      581   define variable v-total-qnty as decimal no-undo.
      582   define variable v-total-sum1 as decimal no-undo.
      583   define variable v-total-sum2 as decimal no-undo.
      584   define temp-table tt-line no-undo
      585       field chk-date as date
      586       field chk-time as integer
      587       field d-card as character
      588       field pay-desk as integer
      589       field obj-name as character
      590       field obj-type as character
      591       field obj-code as integer
      592       field gds-name as character
      593       field eff-doc-qnty as decimal
      594       field object-sum as decimal
      595       field discount as decimal
      596       field tot-r-b as decimal
      597       field line-type as character
      598       field doc-code as character
      599       field type-line as character
      600       index pi as primary doc-code
      601   .
      602       run my-report.
      603   procedure my-report:
      604       define variable v-type as integer no-undo.
      605       v-type = if p-cb-disType = '1' then integer('20':U) else integer('22':U).
      606       for each tt-line no-lock:
      607           delete tt-line.
      608       end.
      609       for each obj-list no-lock:
      610            run rep/rpychk0.p (input "r-shftc2"
      611                           ,input obj-list.obj-type
      612                           ,input obj-list.obj-code
      613                           ,input ?
      614                           ,input ?
      615                           ,input X-date-start
      616                           ,input X-date-end
      617                           ,input 1
      618                           ,input 99
      619                           ,input ?
      620                           ) no-error.
      621            if error-status:error then
      622            do:
      623                message error-status:get-message(1) view-as alert-box.
      624            end.
      625            if x-TOG-Shift = yes then
      626            do:
      627               for each ub.chk-doc no-lock
      628                   where ub.chk-doc.obj-type = obj-list.obj-type
      629                   and ub.chk-doc.obj-code = obj-list.obj-code
      630                   and (ub.chk-doc.shift-date > x-Date-Start or
      631                       (ub.chk-doc.shift-date = x-Date-Start and ub.chk-doc.shift-num >= x-Shift-Start))
      632                   and (ub.chk-doc.shift-date < x-Date-End or
      633                       (ub.chk-doc.shift-date = x-Date-End and ub.chk-doc.shift-num <= x-Shift-End))
      634                   and  ub.chk-doc.out-code > "",
      635               first ub.chk-discnt  no-lock
      636                   where ub.chk-discnt.doc-code = ub.chk-doc.doc-code
      637                   and ub.chk-discnt.discnt-type = v-type
      638               :
      639                   for each chk-gds no-lock
      640                   where ub.chk-gds.doc-code = ub.chk-doc.doc-code
      641                   :
      642                       for each ub.chk-gds-pay no-lock
      643                       where ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code
      644                       and ub.chk-gds-pay.b-code = chk-gds.b-code
      645                       and ub.chk-gds-pay.line-num = chk-gds.line-num
      646                       :
      647                           run proc-tt.
      648                       end.
      649                   end.
      650                end.
      651            end.
      652            else
      653            do:
      654               for each ub.chk-doc no-lock
      655                   where ub.chk-doc.obj-type = obj-list.obj-type
      656                   and ub.chk-doc.obj-code = obj-list.obj-code
      657                   and ub.chk-doc.chk-date >= x-Date-Start
      658                   and ub.chk-doc.chk-date <= x-Date-End
      659                   and  ub.chk-doc.out-code > "",
      660               first ub.chk-discnt no-lock
      661                   where ub.chk-discnt.doc-code = ub.chk-doc.doc-code
      662                   and ub.chk-discnt.discnt-type = v-type
      663               :
      664                   for each chk-gds no-lock
      665                   where ub.chk-gds.doc-code = ub.chk-doc.doc-code
      666                   :
      667                       for each ub.chk-gds-pay no-lock
      668                       where ub.chk-gds-pay.doc-code = ub.chk-doc.doc-code
      669                       and ub.chk-gds-pay.b-code = chk-gds.b-code
      670                       and ub.chk-gds-pay.line-num = chk-gds.line-num
      671                       :
      672                           run proc-tt.
      673                       end.
      674                   end.
      675                end.
      676            end.
      677       end.
      678       xml_tmp = string(session:temp-directory + "report-tmp2.xml").
      679       Report = new ReportXml(xml_tmp).
      680       Report:worksheet("Лист 1").
      681       Report:worksheet-header("start").
      682       Report:worksheet-header("Детализированный отчёт по бонусам и картам ЛНР").
      683       str1 = (if X-TOG-Shift then "С " + string(X-Date-Start,"99/99/9999") + ", смена № "  + string(X-Shift-Start) +
      684                                   " по " + string(X-Date-End,"99/99/9999") + ", смена № " + string(X-Shift-End)
      685                              else
      686                                   "За период с " + string(X-Date-Start,"99/99/9999") + " по " + string(X-Date-End,"99/99/9999")
      687       ).
      688       if length(str1) > 115 then
      689       do:
      690           Report:worksheet-header(substring(str1, 1, 115) + "..." ).
      691       end.
      692       else
      693       do:
      694           Report:worksheet-header(str1).
      695       end.
      696       if X-selectGood = 4 then
      697       do:
      698           Report:worksheet-header("По списку товаров: ").
      699           for each gds-list no-lock:
      700               gds-str = gds-str + substitute("&1"
      701                                               , gds-list.gds-name
      702                                             ) + ", "
      703               .
      704           end.
      705           gds-str = right-trim( gds-str, " " ).
      706           gds-str = right-trim( gds-str, "," ).
      707           if length(gds-str) > 115 then
      708           do:
      709               Report:worksheet-header(substring(gds-str, 1, 115)+ "..." ).
      710           end.
      711           else
      712           do:
      713               Report:worksheet-header(gds-str).
      714           end.
      715           gds-str = "".
      716       end.
      717       else
      718           if length(str2) > 115 then
      719           do:
      720               Report:worksheet-header(substring(str2, 1, 115)+ "..." ).
      721           end.
      722           else
      723           do:
      724               Report:worksheet-header(str2).
      725           end.
      726           if length(str4) > 115 then
      727           do:
      728               Report:worksheet-header(substring(str4, 1, 115)+ "..." ).
      729           end.
      730           else
      731           do:
      732               Report:worksheet-header(str4).
      733           end.
      734           if p-cb-disType = "1" then
      735           do:
      736               Report:worksheet-header("Тип скидки: ЛНР.").
      737           end.
      738           else
      739           do:
      740               Report:worksheet-header("Тип скидки: бонусы.").
      741           end.
      742       Report:worksheet-header("end").
      743       Report:table-columns("60,60,120,60,60,60,110,60,60,60").
      744       Report:table-types = "String,String,String,String,String,String,Number,Number,String,Number".
      745       Report:table-header("Дата чека|Время|Номер карты|№ кассы|Объект|Товар|Количество|Сумма без скидки|Скидка|Сумма со скидкой","40","4").
      746       if  p-rs-klass = "object":U and
      747       p-rs-det = "good":U then
      748       do:
      749           for each tt-line no-lock break by tt-line.obj-type by tt-line.obj-code
      750                                          by tt-line.chk-date by tt-line.chk-time
      751                                          by tt-line.doc-code by tt-line.type-line
      752           :
      753           if first-of (tt-line.obj-code) then
      754               Report:table-group("Объект " + tt-line.obj-name).
      755               Report:table-row((if tt-line.chk-date = ? then "" else string(tt-line.chk-date))
      756                       + "|" + (if tt-line.chk-time = ? then "" else string(tt-line.chk-time,"hh:mm"))
      757                       + "|" + (if tt-line.d-card = ? then "" else tt-line.d-card)
      758                       + "|" + (if tt-line.pay-desk = ? then "" else string(tt-line.pay-desk))
      759                       + "|" + (if tt-line.obj-name = ? then "" else tt-line.obj-name)
      760                       + "|" + (if tt-line.gds-name = ? then "" else tt-line.gds-name)
      761                       + "|" + (if tt-line.eff-doc-qnty = ? then "" else string(tt-line.eff-doc-qnty))
      762                       + "|" + (if tt-line.object-sum = ? then "" else string(tt-line.object-sum))
      763                       + "|" + (if tt-line.discount = ? then "" else string(tt-line.discount,"->>>,>>9.99") + "%")
      764                       + "|" + (if tt-line.tot-r-b = ? then "" else string(tt-line.tot-r-b))
      765               ).
      766           accumulate tt-line.eff-doc-qnty (total by tt-line.obj-code).
      767           accumulate tt-line.object-sum (total by tt-line.obj-code).
      768           accumulate tt-line.tot-r-b (total by tt-line.obj-code).
      769           accumulate tt-line.eff-doc-qnty (total).
      770           accumulate tt-line.object-sum (total).
      771           accumulate tt-line.tot-r-b (total).
      772           if last-of (tt-line.obj-code) then
      773               Report:table-subtotal(""
      774                           + "|" + ""
      775                           + "|" + "Итого по объекту"
      776                           + "|" + ""
      777                           + "|" + ""
      778                           + "|" + ""
      779                           + "|" + (if (accum total by tt-line.obj-code tt-line.eff-doc-qnty) = ? then ""
      780                                    else left-trim(string(accum total by tt-line.obj-code tt-line.eff-doc-qnty, "->>>,>>>,>>>,>>>,>>9.99")))
      781                           + "|" + (if (accum total by tt-line.obj-code tt-line.object-sum) = ? then ""
      782                                    else left-trim(string(accum total by tt-line.obj-code tt-line.object-sum, "->>>,>>>,>>>,>>>,>>9.99")))
      783                           + "|" + ""
      784                           + "|" + (if (accum total by tt-line.obj-code tt-line.tot-r-b) = ? then ""
      785                                    else left-trim(string(accum total by tt-line.obj-code tt-line.tot-r-b, "->>>,>>>,>>>,>>>,>>9.99")))
      786                ).
      787           end.
      788       end.
      789       if p-rs-klass = "date":U and
      790       p-rs-det = "good":U then
      791       do:
      792           for each tt-line no-lock break by tt-line.chk-date by tt-line.chk-time by tt-line.doc-code by tt-line.type-line
      793           :
      794               if first-of (tt-line.chk-date) then Report:table-group("Дата " + (if tt-line.chk-date = ? then "" else string(tt-line.chk-date))).
      795               Report:table-row((if tt-line.chk-date = ? then "" else string(tt-line.chk-date))
      796                       + "|" + (if tt-line.chk-time = ? then "" else string(tt-line.chk-time,"hh:mm"))
      797                       + "|" + (if tt-line.d-card = ? then "" else tt-line.d-card)
      798                       + "|" + (if tt-line.pay-desk = ? then "" else string(tt-line.pay-desk))
      799                       + "|" + (if tt-line.obj-name = ? then "" else tt-line.obj-name)
      800                       + "|" + (if tt-line.gds-name = ? then "" else tt-line.gds-name)
      801                       + "|" + (if tt-line.eff-doc-qnty  = ? then "" else string(tt-line.eff-doc-qnty))
      802                       + "|" + (if tt-line.object-sum  = ? then "" else string(tt-line.object-sum))
      803                       + "|" + (if tt-line.discount  = ? then "" else string(tt-line.discount,"->>>,>>9.99") + "%")
      804                       + "|" + (if tt-line.tot-r-b  = ? then "" else string(tt-line.tot-r-b))
      805               ).
      806               accumulate tt-line.eff-doc-qnty  (total by tt-line.chk-date).
      807               accumulate tt-line.object-sum  (total by tt-line.chk-date).
      808               accumulate tt-line.tot-r-b  (total by tt-line.chk-date).
      809               accumulate tt-line.eff-doc-qnty  (total).
      810               accumulate tt-line.object-sum  (total).
      811               accumulate tt-line.tot-r-b  (total).
      812               if last-of (tt-line.chk-date) then
      813                   Report:table-subtotal(""
      814                           + "|" + ""
      815                           + "|" + "Итого по дате"
      816                           + "|" + ""
      817                           + "|" + ""
      818                           + "|" + ""
      819                           + "|" + (if (accum total by tt-line.chk-date tt-line.eff-doc-qnty) = ? then ""
      820                                    else left-trim(string(accum total by tt-line.chk-date tt-line.eff-doc-qnty, "->>>,>>>,>>>,>>>,>>9.99")))
      821                           + "|" + (if (accum total by tt-line.chk-date tt-line.object-sum) = ? then ""
      822                                    else left-trim(string(accum total by tt-line.chk-date tt-line.object-sum, "->>>,>>>,>>>,>>>,>>9.99")))
      823                           + "|" + ""
      824                           + "|" + (if (accum total by tt-line.chk-date tt-line.tot-r-b) = ? then ""
      825                                    else left-trim(string(accum total by tt-line.chk-date tt-line.tot-r-b, "->>>,>>>,>>>,>>>,>>9.99")))
      826                    ).
      827           end.
      828       end.
      829       if p-rs-klass = "card":U and
      830       p-rs-det = "good":U then
      831       do:
      832           for each tt-line no-lock break by tt-line.d-card by tt-line.chk-date by tt-line.chk-time by tt-line.doc-code by tt-line.type-line
      833           :
      834               if first-of (tt-line.d-card) then Report:table-group("Номер карты " + (if tt-line.d-card = ? then "" else tt-line.d-card)).
      835               Report:table-row((if tt-line.chk-date = ? then "" else string(tt-line.chk-date))
      836                       + "|" + (if tt-line.chk-time = ? then "" else string(tt-line.chk-time,"hh:mm"))
      837                       + "|" + (if tt-line.d-card = ? then "" else tt-line.d-card)
      838                       + "|" + (if tt-line.pay-desk = ? then "" else string(tt-line.pay-desk))
      839                       + "|" + (if tt-line.obj-name = ? then "" else tt-line.obj-name)
      840                       + "|" + (if tt-line.gds-name = ? then "" else tt-line.gds-name)
      841                       + "|" + (if tt-line.eff-doc-qnty  = ? then "" else string(tt-line.eff-doc-qnty))
      842                       + "|" + (if tt-line.object-sum  = ? then "" else string(tt-line.object-sum))
      843                       + "|" + (if tt-line.discount  = ? then "" else string(tt-line.discount,"->>>,>>9.99") + "%")
      844                       + "|" + (if tt-line.tot-r-b  = ? then "" else string(tt-line.tot-r-b))
      845               ).
      846               accumulate tt-line.eff-doc-qnty (total by tt-line.d-card).
      847               accumulate tt-line.object-sum (total by tt-line.d-card).
      848               accumulate tt-line.tot-r-b (total by tt-line.d-card).
      849               accumulate tt-line.eff-doc-qnty (total).
      850               accumulate tt-line.object-sum (total).
      851               accumulate tt-line.tot-r-b (total).
      852               if last-of (tt-line.d-card) then
      853                   Report:table-subtotal(""
      854                               + "|" + ""
      855                               + "|" + "Итого по номеру карты"
      856                               + "|" + ""
      857                               + "|" + ""
      858                               + "|" + ""
      859                               + "|" + (if (accum total by tt-line.d-card tt-line.eff-doc-qnty) = ? then ""
      860                                        else left-trim(string(accum total by tt-line.d-card tt-line.eff-doc-qnty, "->>>,>>>,>>>,>>>,>>9.99")))
      861                               + "|" + (if (accum total by tt-line.d-card tt-line.object-sum) = ? then ""
      862                                        else left-trim(string(accum total by tt-line.d-card tt-line.object-sum, "->>>,>>>,>>>,>>>,>>9.99")))
      863                               + "|" + ""
      864                               + "|" + (if (accum total by tt-line.d-card tt-line.tot-r-b) = ? then ""
      865                                        else left-trim(string(accum total by tt-line.d-card tt-line.tot-r-b, "->>>,>>>,>>>,>>>,>>9.99")))
      866                   ).
      867           end.
      868       end.
      869       if p-rs-klass = "object":U and
      870       p-rs-det = "goodtype":U then
      871       do:
      872           for each tt-line no-lock break by tt-line.obj-type by tt-line.obj-code by tt-line.chk-date
      873                                          by tt-line.chk-time by tt-line.doc-code by tt-line.type-line
      874           :
      875               if first-of (tt-line.obj-code) then Report:table-group("Объект " + tt-line.obj-name).
      876               if (tt-line.type-line = "1топливо") then
      877                   Report:table-row((if tt-line.chk-date = ? then "" else string(tt-line.chk-date))
      878                           + "|" + (if tt-line.chk-time = ? then "" else string(tt-line.chk-time,"hh:mm"))
      879                           + "|" + (if tt-line.d-card = ? then "" else tt-line.d-card)
      880                           + "|" + (if tt-line.pay-desk = ? then "" else string(tt-line.pay-desk))
      881                           + "|" + (if tt-line.obj-name = ? then "" else tt-line.obj-name)
      882                           + "|" + (if tt-line.gds-name = ? then "" else tt-line.gds-name)
      883                           + "|" + (if tt-line.eff-doc-qnty = ? then "" else string(tt-line.eff-doc-qnty))
      884                           + "|" + (if tt-line.object-sum = ? then "" else string(tt-line.object-sum))
      885                           + "|" + (if tt-line.discount = ? then "" else string(tt-line.discount,"->>>,>>9.99") + "%")
      886                           + "|" + (if tt-line.tot-r-b = ? then "" else string(tt-line.tot-r-b))
      887                   ).
      888               accumulate tt-line.eff-doc-qnty (total by tt-line.type-line).
      889               accumulate tt-line.object-sum (total by tt-line.type-line).
      890               accumulate tt-line.tot-r-b (total by tt-line.type-line).
      891               accumulate tt-line.eff-doc-qnty (total by tt-line.obj-code).
      892               accumulate tt-line.object-sum (total by tt-line.obj-code).
      893               accumulate tt-line.tot-r-b (total by tt-line.obj-code).
      894               accumulate tt-line.eff-doc-qnty (total).
