     1167                            else left-trim(string(v-total-sum1, "->>>,>>>,>>>,>>>,>>9.99")))
     1168                   + "|" + ""
     1169                   + "|" + (if (v-total-sum2) = ? then ""
     1170                            else left-trim(string(v-total-sum2, "->>>,>>>,>>>,>>>,>>9.99")))
     1171       ).
     1172       report:worksheet("end").
     1173       delete object Report.
     1174       xslt-path = search("exe\template.xsl").
     1175       rep-out-unit = new rep-out ().
     1176       rep-out-unit:office(xml_tmp, xslt-path).
     1177   end procedure.
     1178   procedure proc-tt:
     1179       for first ub.bar-code no-lock where ub.bar-code.b-code = chk-gds-pay.b-code
     1180       :
     1181           if (x-SelectGood = 1) or (can-find(first gds-list no-lock where gds-list.gds-code = ub.bar-code.gds-code)) then
     1182           do:
     1183               create tt-line.
     1184               tt-line.chk-date = ub.chk-doc.chk-date.
     1185               tt-line.chk-time = ub.chk-doc.chk-time.
     1186               tt-line.d-card = ub.chk-discnt.d-card.
     1187               if tt-line.d-card = ? or tt-line.d-card = "" then
     1188               do:
     1189                   for first chk-pay no-lock
     1190                   where chk-pay.doc-code = chk-doc.doc-code
     1191                   and chk-pay.line-num = chk-gds-pay.cpline-num
     1192                   :
     1193                       tt-line.d-card = chk-pay.pay-card.
     1194                   end.
     1195               end.
     1196               tt-line.pay-desk = ub.chk-doc.pay-desk.
     1197               tt-line.obj-name = obj-list.obj-name.
     1198               tt-line.obj-code = obj-list.obj-code.
     1199               tt-line.obj-type = obj-list.obj-type.
     1200               for first ub.goods no-lock
     1201               where ub.goods.gds-code = ub.bar-code.gds-code
     1202               :
     1203                   tt-line.gds-name = ub.goods.gds-name.
     1204               end.
     1205               tt-line.eff-doc-qnty = ub.chk-gds-pay.eff-doc-qnty.
     1206               tt-line.object-sum = chk-gds.src-sum * (chk-gds-pay.eff-doc-qnty / chk-gds.doc-qnty) no-error.
     1207               tt-line.tot-r-b = ub.chk-gds-pay.tot-r-b.
     1208               tt-line.discount = ((tt-line.object-sum - tt-line.tot-r-b) * 100) / tt-line.object-sum no-error.
     1209               tt-line.line-type = entry(1,chk-gds-pay.line-type,chr(4)).
     1210               tt-line.doc-code = chk-doc.doc-code.
     1211               case tt-line.line-type:
     1212                   when 'топ':U then do: tt-line.type-line = "1топливо". end.
     1213                   when 'у':U then do: tt-line.type-line = "2услуги". end.
     1214                   when 'т':U then do: tt-line.type-line = "3соп.тов.". end.
     1215                   otherwise do: tt-line.type-line = "4неуказ.". end.
     1216               end case.
     1217           end.
     1218       end.
     1219   end procedure.
