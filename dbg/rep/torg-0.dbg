     3130       v-recipient  = v-recipient-code
     3131       v-type-rec = substring(v-recipient-code,1,3)
     3132       v-code-rec  = int(substring(v-recipient-code,4,15))
     3133       no-error
     3134     .
     3135     if v-type-rec = ? then v-type-rec = "" .
     3136     if v-code-rec  = ? then v-code-rec  =  0 .
     3137     end procedure.
