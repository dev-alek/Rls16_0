     2675   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2676   define new global shared variable g#trdcalib as handle no-undo.
     2677   procedure wthcattr-sprcli :
     2678   define input parameter parparentproc  as widget-handle no-undo.
     2679   define input parameter p-mode  as character no-undo.
     2680   define input-output parameter p-value as character no-undo .
     2681   define output parameter p-setted as logical no-undo .
     2682     DEFINE VARIABLE v-value as character no-undo .
     2683     define variable v-cli-type as character no-undo .
     2684     define variable v-cli-code as integer no-undo .
     2685     define buffer buf_clients   for ub.clients.
     2686     define variable v_rid as character no-undo.
     2687     define variable ref-rec as recid no-undo .
     2688     do
     2689     on error undo, return error
     2690     :
     2691         v-value = p-value.
     2692      if p-value <> '':U then do:
     2693       assign
     2694       v-cli-type = substring(p-value, 1, 3)
     2695       v-cli-code = integer(substring(p-value, 4))
     2696       no-error.
     2697       if error-status:error then do:
     2698         assign
     2699         v-cli-type = '':U
     2700         v-cli-code = 0
     2701         .
     2702       end.
     2703      end.
     2704      FIND FIRST buf_clients NO-LOCK WHERE
     2705               buf_clients.obj-type = v-cli-type AND
     2706               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2707      IF available(buf_clients) then do:
     2708       run ref/cli-all.w (
     2709                   input parparentproc
     2710                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2711                  ,input v-cli-type
     2712                  ,input 'все':U
     2713                  ,input 'все':U
     2714                  ,input RECID( buf_clients )
     2715                  ,input ",,,,,,NO"
     2716                  ,input ?
     2717                  ,OUTPUT v_rid ).
     2718     END.
     2719     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2720       run ref/cli-all.w (
     2721                    input parparentproc
     2722                   ,INPUT "b-sel":U
     2723                  ,input  v-cli-type
     2724                  ,input 'все':U
     2725                  ,input 'текущие':U
     2726                  ,input ?
     2727                  ,input ",,,,,,NO"
     2728                  ,input ?
     2729                  ,OUTPUT v_rid ).
     2730     END.
     2731     else do:
     2732       message
     2733       if p-value = "":U then 'Атрибут не задан!'
     2734       else substitute('Не найден клиент &1',p-value)
     2735       view-as alert-box warning.
     2736     end.
     2737     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2738       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2739       IF ERROR-STATUS:ERROR THEN DO:
     2740           RETURN NO-APPLY.
     2741       END.
     2742       FIND FIRST buf_clients NO-LOCK WHERE
     2743                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2744       IF AVAIL buf_clients THEN DO:
     2745         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2746       end.
     2747     end.
     2748     if v-value <> p-value then do:
     2749       p-value = v-value.
     2750       p-setted = yes.
     2751     end.
     2752     end.
     2753   end procedure.
     2754     define new global shared variable g#wthcalib as handle no-undo.
     2755   procedure torgconf-read :
     2756   do
     2757   on error undo, return error
     2758   :
     2759       define input parameter p-form-name  as character    no-undo.
     2760       define input parameter p-host-code  as integer      no-undo.
     2761       define input parameter p-obj-type   as character    no-undo.
     2762       define input parameter p-obj-code   as integer      no-undo.
     2763       define variable v-outdate   as character     no-undo.
     2764       define variable v-outares   as character     no-undo.
     2765       define variable v-outsend   as character     no-undo.
     2766       define variable v-outasend  as character     no-undo.
     2767       define variable v-outprops  as character     no-undo.
     2768       define variable v-outnum    as character     no-undo.
     2769       define variable v-outprim   as character     no-undo.
     2770       define variable v-outdisc   as character     no-undo.
     2771       define variable v-outsubs   as character     no-undo.
     2772       define variable v-outrecv   as character     no-undo.
     2773       define variable v-outegrp   as character     no-undo.
     2774       define variable v-outt12    as character     no-undo.
     2775       define variable v-outappr   as character     no-undo.
     2776       define variable v-outrubl   as character     no-undo.
     2777       define variable v-outhold   as character     no-undo.
     2778       define variable v-outobj    as character     no-undo.
     2779       define variable v-outexlst  as character     no-undo.
     2780       define variable v-outprncd  as character     no-undo.
     2781       define variable v-par-type  as character     no-undo.
     2782       define variable v-outogr    as character     no-undo.
     2783       define variable v-outR      as character     no-undo.
     2784       define variable v-outB      as character     no-undo.
     2785       define variable v-outC      as character     no-undo.
     2786       assign
     2787           v-torgconf-outdate  = no
     2788           v-torgconf-outnum   = no
     2789           v-torgconf-outprim  = no
     2790           v-torgconf-outdisc  = no
     2791           v-torgconf-outsubs  = no
     2792           v-torgconf-outrecv  = no
     2793           v-torgconf-outegrp  = no
     2794           v-torgconf-outt12   = no
     2795           v-torgconf-outappr  = no
     2796           v-torgconf-outrubl  = no
     2797           v-torgconf-outhold  = no
     2798           v-torgconf-outobj   = no
     2799           v-torgconf-outexlst = no
     2800           v-torgconf-outexpas = "":U
     2801           v-torgconf-outprncd = yes
     2802           v-torgconf-outares  = no
     2803           v-torgconf-outsend  = no
     2804           v-torgconf-outasend  = no
     2805           v-torgconf-outprops  = no
     2806           v-form-name          = p-form-name
     2807       .
     2808   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2809   empty temp-table thbjattr_thbj-attr.
     2810   run adm/shattri.p (
     2811      input "get":U
     2812     ,input ''
     2813     ,input 0
     2814     ,input 'prt-glob':U
     2815     ,input  ""
     2816     ,output v-value-character
     2817     ,output v-value-date
     2818     ,output v-value-decimal
     2819     ,output v-value-integer
     2820     ,output v-value-logical
     2821     ,output par-type
