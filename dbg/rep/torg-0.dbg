     3333   procedure torgconf-get-sup-param :
     3334   define input parameter p-obj-type           as character        no-undo.
     3335   define input parameter p-obj-code           as integer          no-undo.
     3336   define input parameter p-curr-code          as integer          no-undo.
     3337       define variable v-host-code    as integer      no-undo.
     3338       define variable v-par-type     as character    no-undo.
     3339   do
     3340   on error undo, return error
     3341   :
     3342       assign
     3343          v-torgconf-sup-host-code = v-host-code
     3344       .
     3345       if v-torgconf-sup-host-code = 0
     3346       then do:
     3347           assign
     3348               v-torgconf-sup-host-name           = "":U
     3349               v-torgconf-sup-host-addres         = "":U
     3350               v-torgconf-sup-host-post-addres    = "":U
     3351               v-torgconf-sup-host-phone          = "":U
     3352               v-torgconf-sup-host-inn            = "":U
     3353               v-torgconf-sup-host-kpp            = "":U
     3354               v-torgconf-sup-host-okpo           = "":U
     3355               v-torgconf-sup-host-egrip-date     = "":U
     3356               v-torgconf-sup-host-egrip-num      = "":U
     3357           .
     3358       end.
     3359       else do:
     3360           run fmtcli-get-client in this-procedure (
     3361                 input 'орг':U
     3362               , input v-torgconf-sup-host-code
     3363           ).
     3364           assign
     3365               v-torgconf-sup-host-name        = v-fmtcli-name
     3366               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     3367               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     3368               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     3369               v-torgconf-sup-host-phone       = v-fmtcli-phone
     3370               v-torgconf-sup-host-inn         = v-fmtcli-inn
     3371               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     3372               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     3373           .
     3374           run gbl/clntat-v.p (
     3375                 input 'орг':U
     3376               , input v-torgconf-sup-host-code
     3377               , input 'egrip-date':U
     3378               , output v-torgconf-sup-host-egrip-date
     3379               , output v-par-type
     3380           ).
     3381           run gbl/clntat-v.p (
     3382                 input 'орг':U
     3383               , input v-torgconf-sup-host-code
     3384               , input 'egrip-num':U
     3385               , output v-torgconf-sup-host-egrip-num
     3386               , output v-par-type
     3387           ).
     3388           run fmtcli-get-bank in this-procedure (
     3389                 input v-host-code
     3390               , input 'орг':U
     3391               , input v-torgconf-sup-host-code
     3392               , input p-curr-code
     3393           ).
     3394       end.
     3395       assign
     3396           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     3397           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     3398           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     3399           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     3400           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     3401           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     3402           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     3403           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     3404       .
     3405       assign
     3406           v-torgconf-sup-obj-type = p-obj-type
     3407           v-torgconf-sup-obj-code = p-obj-code
     3408       .
     3409       if trim(p-obj-type) <> ""
     3410       and p-obj-code <> 0
     3411       then do:
     3412       run fmtcli-get-client in this-procedure (
     3413             input p-obj-type
     3414           , input p-obj-code
     3415       ).
     3416       assign
     3417           v-torgconf-sup-obj-name        = v-fmtcli-name
     3418           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     3419           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     3420           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     3421           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     3422           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     3423           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     3424       .
     3425      end.
     3426      end.
     3427   end procedure.
