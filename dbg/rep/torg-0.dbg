     5101            .
     5102         end.
     5103         if v-torgconf-outogr = "dir_obj"
     5104            then do:
     5105            find first buf_trn-doc no-lock
     5106            where buf_trn-doc.doc-code = p-doc-code
     5107            no-error.
     5108               CASE buf_trn-doc.obj-type:
