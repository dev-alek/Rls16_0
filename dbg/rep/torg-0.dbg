     5411               end.
     5412               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5413               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5414            end.
     5415      end.
     5416   end.
     5417   procedure torgconf-get-reason  :
     5418   define input parameter  p-doc-code       as character        no-undo.
     5419   define input parameter  p-reason-code    as integer          no-undo .
     5420   define input parameter  p-doc-type       as character        no-undo.
     5421       if p-reason-code > 0
     5422       then do:
     5423           define buffer buf_trn-reason for ub.trn-reason.
     5424           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     5425           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     5426       end.
     5427       else do:
     5428           if p-doc-type = 'при':U
     5429           then  do:
     5430               define variable v-attr-type     as character    no-undo.
     5431               define variable v-attr-value    as character    no-undo.
     5432               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     5433               assign v-torgconf-reason = v-attr-value .
     5434               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     5435               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     5436           end.
     5437       end.
     5438   end procedure.
     5439   do
     5440   on error undo, return error
     5441   :
     5442   def shared var CostPrice    as logical          no-undo.
     5443   def shared var sort-name    as logical          no-undo.
     5444   def shared var sort-gr      as logical               no-undo.
     5445   def stream out-stream .
     5446   def buffer buf_trn-doc          for ub.trn-doc.
     5447   def buffer buf_goods            for ub.goods.
     5448   def buffer buf_clients          for ub.clients.
     5449   def buffer buf_doc-line         for ub.doc-line.
     5450   def buffer buf_person           for ub.person.
     5451   def var v-line-counter      as integer                  no-undo.
     5452   def var v-single-line       as char                     no-undo.
     5453   def var v-full-type          as char                     no-undo.
     5454   def var v-cli-name          as char                     no-undo.
     5455   def var v-obj-name          as char                     no-undo.
     5456   def var v-income            as logical                  no-undo.
     5457   def var v-valut-abbr        as char                     no-undo.
     5458   def var v-vat-pc            like ub.doc-line.vat-pc        no-undo.
     5459   def var v-slt-pc            like ub.doc-line.slt-pc        no-undo.
     5460   def var v-host-code         like ub.sysconf.host-code      no-undo.
     5461   def var v-doc-sum           like ub.ot-tot.sum-base        no-undo.
     5462   def var v-doc-price         like ub.doc-line.price-base    no-undo.
     5463   def var v-pg-sum-qnty       like ub.doc-line.fact-qnty     no-undo.
     5464   def var v-pg-sum-no-taxes   like ub.ot-line.sum-base       no-undo.
     5465   def var v-pg-sum-no-vat     like ub.ot-line.sum-base       no-undo.
     5466   def var v-pg-sum-slt        like ub.ot-line.sum-base       no-undo.
     5467   def var v-pg-sum-vat        like ub.ot-line.sum-base       no-undo.
     5468   def var v-pg-sum-doc        like ub.ot-line.sum-base       no-undo.
     5469   def var v-tot-sum-qnty      like ub.doc-line.fact-qnty     no-undo.
     5470   def var v-tot-sum-no-taxes  like ub.ot-line.sum-base       no-undo.
     5471   def var v-tot-sum-no-vat    like ub.ot-line.sum-base       no-undo.
     5472   def var v-tot-sum-slt       like ub.ot-line.sum-base       no-undo.
     5473   def var v-tot-sum-vat       like ub.ot-line.sum-base       no-undo.
     5474   def var v-tot-sum-doc       like ub.ot-line.sum-base       no-undo.
     5475   define variable boss-name    like ub.clients.obj-name  no-undo.
     5476   def var v-par-menedger          as char                     no-undo.
     5477   define variable p-torgconf-wrkr-name    as character    no-undo.
     5478   define variable p-torgconf-post         as character    no-undo.
     5479   def var v-first-line        as logical                  no-undo.
     5480   define variable g#report-num    as integer      no-undo.
     5481   define variable g#quest-print   as logical      no-undo.
     5482   define variable g#log           as logical      no-undo.
     5483   run get-report-num in p-mainmenu-handle (
     5484       output g#report-num
     5485   ).
     5486   run get-quest-print in p-mainmenu-handle (
     5487       output g#quest-print
     5488   ).
     5489   find first buf_trn-doc no-lock where recid(buf_trn-doc) = p-trn-doc-recid.
     5490   assign
     5491       v-valut-abbr = ( if PrintRubl = yes then "( РУБ )" else "(Б.Вал)" )
     5492   .
     5493   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5494   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5495     (input  buf_trn-doc.obj-type
     5496     ,input  buf_trn-doc.obj-code
     5497     ,output v-host-code
     5498     )  .
     5499   find first buf_clients no-lock
     5500        where buf_clients.obj-type = buf_trn-doc.obj-type
     5501          and buf_clients.obj-code = buf_trn-doc.obj-code
     5502   .
     5503   assign
     5504           v-obj-name = string(buf_clients.obj-name)
     5505   .
     5506   find first buf_clients no-lock
     5507        where buf_clients.obj-type = buf_trn-doc.cli-type
     5508          and buf_clients.obj-code = buf_trn-doc.cli-code
     5509   .
     5510   if available buf_clients
     5511   then do:
     5512       assign
     5513           v-cli-name = string(buf_clients.obj-name)
     5514       .
     5515   end.
     5516   else do:
     5517       assign
     5518           v-cli-name = ""
     5519       .
     5520   end.
     5521   assign
     5522       v-income = ( if buf_trn-doc.doc-type = 'при':U or buf_trn-doc.doc-type = 'возврат':U then yes else no )
     5523       v-single-line       = fill("-", 230)
     5524       v-line-counter      = 0
     5525   .
     5526   run rep/get-psn.p
     5527         (input buf_trn-doc.boss
     5528         ,output boss-name
     5529         ) .
     5530   find first buf_person no-lock
     5531   where buf_person.psn-code = buf_trn-doc.boss
     5532   no-error.
     5533   if available buf_person
     5534   then do:
     5535      v-par-menedger = buf_person.position.
     5536   end.
     5537   if boss-name = "?":U then boss-name = "".
     5538   if v-par-menedger = ? then  v-par-menedger = "".
     5539   run torgconf-get-warrant in this-procedure(
     5540       input buf_trn-doc.doc-code
     5541   )
     5542   .
     5543   run torgconf-get-storekeeper in this-procedure (
     5544       input buf_trn-doc.wrkr
     5545     , output p-torgconf-wrkr-name
     5546     , output p-torgconf-post
     5547   ).
     5548   output stream out-stream to value( string( session:temp-directory +
     5549                                        "rpt" + string( g#report-num ) ) )
     5550                                        page-size  value(43) .
     5551   form header
     5552       space(5) v-single-line format "X(191)" skip
     5553       'Продолжение - на следующей странице' at 90 skip
     5554       with frame BottomFrame width 235 page-bottom no-labels no-box .
     5555   view stream out-stream frame BottomFrame .
     5556   find first buf_clients no-lock
     5557        where buf_clients.obj-type = 'орг':U
     5558          and buf_clients.obj-code = v-host-code
     5559   .
     5560   if session :set-wait-state( "compiler" ) then.
     5561   put stream out-stream
     5562       buf_clients.obj-name format "X(60)" at 5 + ( ( 5 + 191 - 5) / 2 ) - ( length( buf_clients.obj-name ) / 2 )
     5563   .
     5564   put stream out-stream
     5565       skip (1) space( 44 )
     5566       "Приложение к документу. Тип: "
     5567   .
     5568   v-full-type = ENTRY(lookup(buf_trn-doc.ext-doc-type,'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U),'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U).
     5569   put stream out-stream
     5570          v-full-type                                                format "X(20)"
     5571          "   Номер: "
     5572          buf_trn-doc.doc-code                                     format "X(14)"
     5573          "   Дата: "
     5574          string(buf_trn-doc.doc-date)                             format "X(10)"
     5575          ( if buf_trn-doc.status_ <> 'факт':U then "   Статус: " + caps(buf_trn-doc.status_) else " " )
     5576                                                                   format "X(25)"
     5577       skip space( 44 ) "Поставщик (отправитель): "
     5578           (if v-income = yes then v-cli-name else v-obj-name )    format "X(60)"
     5579       skip space( 44 ) "Покупатель (получатель): "
     5580           (if v-income = yes then v-obj-name else v-cli-name )    format "X(60)"
     5581       skip
     5582   .
     5583   put stream out-stream
     5584           ( if CostPrice = yes then 'Учетные цены' else 'Цены продажи' )
     5585                                                                   format "X(12)"  at right-field( 5 + 191, 12 )
     5586   .
     5587   run print-header in this-procedure .
     5588   assign
     5589       v-pg-sum-qnty       = 0
     5590       v-pg-sum-no-taxes   = 0
     5591       v-pg-sum-no-vat     = 0
     5592       v-pg-sum-slt        = 0
     5593       v-pg-sum-vat        = 0
     5594       v-pg-sum-doc        = 0
     5595       v-tot-sum-qnty      = 0
     5596       v-tot-sum-no-taxes  = 0
     5597       v-tot-sum-no-vat    = 0
     5598       v-tot-sum-slt       = 0
     5599       v-tot-sum-vat       = 0
     5600       v-tot-sum-doc       = 0
     5601   .
     5602   if sort-gr = yes
     5603   then do:
     5604       if sort-name = yes
     5605       then do:
     5606           for each buf_doc-line no-lock
     5607           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5608           , first buf_goods no-lock
     5609             where buf_goods.artic      = buf_doc-line.artic
     5610               and buf_goods.prod-type  = buf_doc-line.prod-type
     5611               and buf_goods.prod-code  = buf_doc-line.prod-code
     5612           break by buf_goods.grp-name
     5613                 by buf_goods.gds-name
     5614           :
     5615               if first-of(buf_goods.grp-name)
     5616               then do:
     5617                   run print-group-line in this-procedure.
     5618               end.
     5619               if last(buf_goods.gds-name)
     5620                   and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream )
     5621               then do:
     5622                   run print-page-result in this-procedure ( input "" ).
     5623                   if line-counter( Out-Stream ) + 2 < page-size( Out-Stream )
     5624                   then do:
     5625                       put stream out-stream
     5626                           skip space(5)
     5627                               "|" v-single-line format "X(189)" "|"
     5628                       .
     5629                   end.
     5630                   page stream Out-Stream .
     5631                   run print-header in this-procedure .
     5632               end.
     5633               run print-line in this-procedure .
     5634           end.
     5635       end.
     5636       else do:
     5637           for each buf_doc-line
     5638           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5639           , first buf_goods no-lock
     5640             where buf_goods.artic      = buf_doc-line.artic
     5641               and buf_goods.prod-type  = buf_doc-line.prod-type
     5642               and buf_goods.prod-code  = buf_doc-line.prod-code
     5643           break by buf_goods.grp-name
     5644                 by buf_doc-line.num-place
     5645           :
     5646               if first-of(buf_goods.grp-name)
     5647               then do:
     5648                   run print-group-line in this-procedure.
     5649               end.
     5650               if last(buf_doc-line.num-place)
     5651                   and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream )
     5652               then do:
     5653                   run print-page-result in this-procedure ( input "" ).
     5654                   if line-counter( Out-Stream ) + 2 < page-size( Out-Stream )
     5655                   then do:
     5656                       put stream out-stream
     5657                           skip space(5)
     5658                               "|" v-single-line format "X(189)" "|"
     5659                       .
     5660                   end.
     5661                   page stream Out-Stream .
     5662                   run print-header in this-procedure .
     5663               end.
     5664               run print-line in this-procedure .
     5665           end.
     5666       end.
     5667   end.
     5668   else do:
     5669       if sort-name = yes
     5670       then do:
     5671           for each buf_doc-line no-lock
     5672           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5673           , first buf_goods no-lock
     5674           where buf_goods.artic      = buf_doc-line.artic
     5675               and buf_goods.prod-type  = buf_doc-line.prod-type
     5676               and buf_goods.prod-code  = buf_doc-line.prod-code
     5677           break by buf_goods.gds-name
     5678           :
     5679               if last(buf_goods.gds-name)
     5680                   and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream )
     5681               then do:
     5682                   run print-page-result in this-procedure ( input "" ).
     5683                   if line-counter( Out-Stream ) + 2 < page-size( Out-Stream )
     5684                   then do:
     5685                       put stream out-stream
     5686                           skip space(5)
     5687                               "|" v-single-line format "X(189)" "|"
     5688                       .
     5689                   end.
     5690                   page stream Out-Stream .
     5691                   run print-header in this-procedure .
     5692               end.
     5693               run print-line in this-procedure .
     5694           end.
     5695       end.
     5696       else do:
     5697           for each buf_doc-line
     5698           where buf_doc-line.doc-code = buf_trn-doc.doc-code
     5699           , first buf_goods no-lock
     5700           where buf_goods.artic      = buf_doc-line.artic
     5701               and buf_goods.prod-type  = buf_doc-line.prod-type
     5702               and buf_goods.prod-code  = buf_doc-line.prod-code
     5703           break by buf_doc-line.num-place
     5704           :
     5705               if last(buf_doc-line.num-place)
     5706                   and line-counter( Out-Stream ) + 12 + 1 > page-size( Out-Stream )
     5707               then do:
     5708                   run print-page-result in this-procedure ( input "" ).
     5709                   if line-counter( Out-Stream ) + 2 < page-size( Out-Stream )
     5710                   then do:
     5711                       put stream out-stream
     5712                           skip space(5)
     5713                               "|" v-single-line format "X(189)" "|"
     5714                       .
     5715                   end.
     5716                   page stream Out-Stream .
     5717                   run print-header in this-procedure .
     5718               end.
     5719               run print-line in this-procedure .
     5720           end.
     5721       end.
     5722   end.
     5723   if page-number ( Out-Stream ) > 1
     5724   then do:
     5725       run print-page-result in this-procedure  ( input "" ) .
     5726   end.
     5727   else do:
     5728       run print-page-result in this-procedure  ( input "no-line" ) .
     5729   end.
     5730   run print-total-result in this-procedure .
     5731   hide stream Out-Stream frame BottomFrame .
     5732   run print-note in this-procedure .
     5733   if session :set-wait-state( "" ) then.
     5734   output stream out-stream close.
     5735   if g#quest-print = false
     5736   then do:
     5737     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     5738                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     5739                                         OUTPUT g#log ).
     5740   end.
     5741   else do:
     5742     os-command silent
     5743       value( "COPY /b " +
     5744         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     5745         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     5746         string( session:temp-directory) +  "$" + string( g#report-num )
     5747                 ) .
     5748     os-command silent
     5749       value( "COPY /b " +
     5750         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     5751         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     5752         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     5753                 ) .
     5754   end.
     5755   end.
     5756   procedure print-header :
     5757   do
     5758   on error undo, return error
     5759   :
     5760   assign
     5761       v-first-line = yes
     5762   .
     5763   put stream out-stream
     5764       skip
     5765       space(5)       v-single-line   format "X(191)"
     5766       skip space(5)  "|"
     5767           "|"                     at 5 + 11
     5768           "|"                     at 5 + 28
     5769           "|"                     at 5 + 79
     5770           "|"                     at 5 + 91
     5771           "Цена без"              at center-field(5 + 91, 5 + 104, 8)
     5772           "|"                     at 5 + 104
     5773           "Сумма без"             at center-field(5 + 104, 5 + 119, 9)
     5774           "|"                     at 5 + 119
     5775           "Цена без"              at center-field(5 + 119, 5 + 132, 8)
     5776           "|"                     at 5 + 132
     5777           "Сумма без"             at center-field(5 + 132, 5 + 147, 9)
     5778           "|"                     at 5 + 147
     5779           "Став-"                 at center-field(5 + 147, 5 + 153, 5)
     5780           "|"                     at 5 + 153
     5781           "Сумма"                 at center-field(5 + 153, 5 + 163, 5)
     5782           "|"                     at 5 + 163
     5783           "|"                     at 5 + 176
     5784           "|"                     at 5 + 191
     5785       skip space(5)  "|"
     5786           "Код"                   at center-field(5 + 1, 5 + 11, 3)
     5787           "|"                     at 5 + 11
     5788           "Артикул"               at center-field(5 + 11, 5 + 28, 7)
     5789           "|"                     at 5 + 28
     5790           "Наименование товара"   at center-field(5 + 28, 5 + 79, 19)
     5791           "|"                     at 5 + 79
     5792           "Количество"            at center-field(5 + 79, 5 + 91, 10)
     5793           "|"                     at 5 + 91
     5794           "налогов"               at center-field(5 + 91, 5 + 104, 7)
     5795           "|"                     at 5 + 104
     5796           "налогов"               at center-field(5 + 104, 5 + 119, 7)
     5797           "|"                     at 5 + 119
     5798           "НДС"                   at center-field(5 + 119, 5 + 132, 3)
     5799           "|"                     at 5 + 132
     5800           "НДС"                   at center-field(5 + 132, 5 + 147, 3)
     5801           "|"                     at 5 + 147
     5802           "ка"                    at center-field(5 + 147, 5 + 153, 2)
     5803           "|"                     at 5 + 153
     5804           "НДС"                   at center-field(5 + 153, 5 + 163, 3)
     5805           "|"                     at 5 + 163
     5806           "Цена"                  at center-field(5 + 163, 5 + 176, 4)
     5807           "|"                     at 5 + 176
     5808           "Сумма"                 at center-field(5 + 176, 5 + 191, 5)
     5809           "|"                     at 5 + 191
     5810       skip space(5)  "|"
     5811           "|"                     at 5 + 11
     5812           "|"                     at 5 + 28
     5813           "|"                     at 5 + 79
     5814           "|"                     at 5 + 91
     5815           v-valut-abbr            at center-field(5 + 91, 5 + 104, 7)
     5816           "|"                     at 5 + 104
     5817           v-valut-abbr            at center-field(5 + 104, 5 + 119, 7)
     5818           "|"                     at 5 + 119
     5819           v-valut-abbr            at center-field(5 + 119, 5 + 132, 7)
     5820           "|"                     at 5 + 132
     5821           v-valut-abbr            at center-field(5 + 132, 5 + 147, 7)
     5822           "|"                     at 5 + 147
     5823           "НДС"                   at center-field(5 + 147, 5 + 153, 3)
     5824           "|"                     at 5 + 153
     5825           v-valut-abbr            at center-field(5 + 153, 5 + 163, 7)
     5826           "|"                     at 5 + 163
     5827           v-valut-abbr            at center-field(5 + 163, 5 + 176, 7)
     5828           "|"                     at 5 + 176
     5829           v-valut-abbr            at center-field(5 + 176, 5 + 191, 7)
     5830           "|"                     at 5 + 191
     5831       skip space(5)
     5832           "|" v-single-line format "X(189)" "|"
     5833   .
     5834   end.
     5835   end procedure.
     5836   procedure print-line :
     5837   do
     5838   on error undo, return error
     5839   :
     5840       define variable v-sign      as integer       no-undo.
     5841       assign
     5842           v-sign =  ( if buf_trn-doc.status_ = 'факт':U
     5843                       and ( buf_trn-doc.ext-doc-type = 'ee':U
     5844                           or buf_trn-doc.ext-doc-type = 'ep':U
     5845                           or buf_trn-doc.ext-doc-type = 'es':U
     5846                           or buf_trn-doc.ext-doc-type = 'we':U
     5847                           or buf_trn-doc.ext-doc-type = 'ev':U
     5848                           or buf_trn-doc.ext-doc-type = 'em':U
     5849                           or buf_trn-doc.ext-doc-type = 'wm':U  )
     5850                       then -1
     5851                       else 1 )
     5852       .
     5853       run r-getsum in this-procedure ( input recid ( buf_doc-line )
     5854                                      ,  input CostPrice
     5855                                      ,  input PrintRubl
     5856                                      ).
     5857       assign
     5858           v-doc-sum   = v-sign * temp_r-getsum.sum-with-taxes
     5859           v-doc-price = (if temp_r-getsum.qnty <> 0 then temp_r-getsum.sum-with-taxes / temp_r-getsum.qnty else ?)
     5860       .
     5861       put stream out-stream
     5862           skip space(5)  "|"
     5863               string(buf_goods.gds-code, "999999999") format "X(9)"
     5864               "|"   at 5 + 11
     5865               string(buf_doc-line.artic)              format "X(16)"
     5866               "|"   at 5 + 28
     5867               buf_goods.gds-name                      format "X(35)"
     5868               "|"   at 5 + 79
     5869               v-sign * temp_r-getsum.qnty             format "->>>>>9.<<<"
     5870               "|"   at 5 + 91
     5871               temp_r-getsum.price-no-taxes            format "->>>>>9.99"
     5872               "|"   at 5 + 104
     5873               v-sign * temp_r-getsum.sum-no-taxes     format "->>,>>>,>>9.99"
     5874               "|"   at 5 + 119
     5875               temp_r-getsum.price-no-vat              format "->>>>>9.99"
     5876               "|"   at 5 + 132
     5877               v-sign * temp_r-getsum.sum-no-vat       format "->>,>>>,>>9.99"
     5878               "|"   at 5 + 147
     5879               ( if temp_r-getsum.vat-pc <> ? then string(temp_r-getsum.vat-pc, ">9.9<") else " " )
     5880                                                       format "X(5)"
     5881               "|"   at 5 + 153
     5882               v-sign * temp_r-getsum.sum-vat          format "->>>>9.99"
     5883               "|"   at 5 + 163
     5884       .
     5885       if v-doc-price <> ?
     5886       then do:
     5887           put stream out-stream
     5888               v-doc-price      format "->>>>>9.99"
     5889           .
     5890       end.
     5891       put stream out-stream
     5892           "|"   at 5 + 176
     5893               v-doc-sum            format "->>,>>>,>>9.99"
     5894           "|"   at 5 + 191
     5895       .
     5896       assign
     5897           v-line-counter      = v-line-counter    + 1
     5898           v-pg-sum-qnty       = v-pg-sum-qnty     + ( v-sign * temp_r-getsum.qnty         )
     5899           v-pg-sum-no-taxes   = v-pg-sum-no-taxes + ( v-sign * temp_r-getsum.sum-no-taxes )
     5900           v-pg-sum-no-vat     = v-pg-sum-no-vat   + ( v-sign * temp_r-getsum.sum-no-vat   )
     5901           v-pg-sum-slt        = v-pg-sum-slt      + ( v-sign * temp_r-getsum.sum-slt      )
     5902           v-pg-sum-vat        = v-pg-sum-vat      + ( v-sign * temp_r-getsum.sum-vat      )
     5903           v-pg-sum-doc        = v-pg-sum-doc      + ( v-doc-sum                           )
     5904       .
     5905       if line-counter( Out-Stream ) + 2 + 2 > page-size( Out-Stream )
     5906       then do:
     5907           run print-page-result in this-procedure ( input "" ) .
     5908           page stream Out-Stream .
     5909           run print-header in this-procedure .
     5910       end.
     5911       assign
     5912           v-first-line = no
     5913       .
     5914   end.
     5915   end procedure.
     5916   procedure print-group-line :
     5917   do
     5918   on error undo, return error
     5919   :
     5920       if line-counter( Out-Stream ) + 2 + 2 + 1 > page-size( Out-Stream )
     5921       then do:
     5922           run print-page-result in this-procedure ( input "" ) .
     5923           page stream out-stream.
     5924           run print-header in this-procedure .
     5925       end.
     5926       if v-first-line <> yes
     5927       then do:
     5928           put stream out-stream
     5929               skip space(5)
     5930                   "|" v-single-line format "X(189)" "|"
     5931           .
     5932       end.
     5933       put stream out-stream
     5934           skip space(5)
     5935               "|   ***  Группа:  "  + buf_goods.grp-name format "X(150)"
     5936               "|" at 5 + 191
     5937       .
     5938   end.
     5939   end procedure.
     5940   procedure print-page-result :
     5941   do
     5942   on error undo, return error
     5943   :
     5944   def input parameter p-print-type as char no-undo.
     5945   if p-print-type <> "no-line"
     5946   then do:
     5947       put stream out-stream
     5948           skip space(5)
     5949               "|" v-single-line format "X(189)" "|"
     5950           skip space(5)  "|        Итого по странице "
     5951               "|"                 at 5 + 79
     5952               v-pg-sum-qnty                       format "->>>>>9.<<<"
     5953               "|"                 at 5 + 91
     5954               "|"                 at 5 + 104
     5955               v-pg-sum-no-taxes                   format "->>,>>>,>>9.99"
     5956               "|"                 at 5 + 119
     5957               "|"                 at 5 + 132
     5958               v-pg-sum-no-vat                     format "->>,>>>,>>9.99"
     5959               "|"                 at 5 + 147
     5960               "|"                 at 5 + 153
     5961               v-pg-sum-vat                        format "->>>>9.99"
     5962               "|"                 at 5 + 163
     5963               "|"                 at 5 + 176
     5964               v-pg-sum-doc                        format "->>,>>>,>>9.99"
     5965               "|"                 at 5 + 191
     5966       .
     5967   end.
     5968   assign
     5969       v-tot-sum-qnty      = v-tot-sum-qnty        + v-pg-sum-qnty
     5970       v-tot-sum-no-taxes  = v-tot-sum-no-taxes    + v-pg-sum-no-taxes
     5971       v-tot-sum-no-vat    = v-tot-sum-no-vat      + v-pg-sum-no-vat
     5972       v-tot-sum-slt       = v-tot-sum-slt         + v-pg-sum-slt
     5973       v-tot-sum-vat       = v-tot-sum-vat         + v-pg-sum-vat
     5974       v-tot-sum-doc       = v-tot-sum-doc         + v-pg-sum-doc
     5975       v-pg-sum-qnty       = 0
     5976       v-pg-sum-no-taxes   = 0
     5977       v-pg-sum-no-vat     = 0
     5978       v-pg-sum-slt        = 0
     5979       v-pg-sum-vat        = 0
     5980       v-pg-sum-doc        = 0
     5981   .
     5982   end.
     5983   end procedure.
     5984   procedure print-total-result :
     5985   do
     5986   on error undo, return error
     5987   :
     5988       put stream out-stream
     5989           skip space(5)
     5990               "|" v-single-line format "X(189)" "|"
     5991           skip space(5)  "|        В С Е Г О "
     5992               "|"                 at 5 + 79
     5993               v-tot-sum-qnty                       format "->>>>>9.<<<"
     5994               "|"                 at 5 + 91
     5995               "|"                 at 5 + 104
     5996               v-tot-sum-no-taxes                   format "->>,>>>,>>9.99"
     5997               "|"                 at 5 + 119
     5998               "|"                 at 5 + 132
     5999               v-tot-sum-no-vat                     format "->>,>>>,>>9.99"
     6000               "|"                 at 5 + 147
     6001               "|"                 at 5 + 153
     6002               v-tot-sum-vat                        format "->>>>9.99"
     6003               "|"                 at 5 + 163
     6004               "|"                 at 5 + 176
     6005               v-tot-sum-doc                        format "->>,>>>,>>9.99"
     6006               "|"                 at 5 + 191
     6007           skip space(5)
     6008               v-single-line format "X(191)"
     6009       .
     6010   end.
     6011   end procedure.
     6012   procedure print-note :
     6013   do
     6014   on error undo, return error
     6015   :
     6016   if trim(p-torgconf-post) = ""
     6017   then do:
     6018       p-torgconf-post = Fill("_", 20).
     6019   end.
     6020   if trim(p-torgconf-wrkr-name ) = ""
     6021   then do:
     6022       p-torgconf-wrkr-name  = Fill("_", 30).
     6023   end.
     6024   if trim(p-torgconf-accept-position) = ""
     6025   then do:
     6026       p-torgconf-accept-position = Fill ("_", 20).
     6027   end.
     6028   if trim(p-torgconf-accept-fname) = ""
     6029   then do:
     6030       p-torgconf-accept-fname = Fill ("_", 30).
     6031   end.
     6032       put stream out-stream
     6033           skip(1) space(44)
     6034               "Всего наименований: "
     6035               v-line-counter  format ">>>>>9"
     6036           skip space(44)
     6037               "Сумма цен по документу составила: "
     6038               v-tot-sum-doc                        format "->>,>>>,>>9.99"
     6039               ", в том числе налог с продаж: "
     6040               v-tot-sum-slt                        format "->>>9.99"
     6041               ", НДС: "
     6042               v-tot-sum-vat                        format "->>>>9.99"
     6043           skip(1) space(44)
     6044               "Сдал:"
     6045           space(25)  p-torgconf-post               format "X(20)" "     __________           "p-torgconf-wrkr-name format "X(40)"
     6046           skip space(78)  "/должность/          /подпись/               /расшифровка подписи/"
     6047               skip(1) space(44)
     6048                   "Принял:"
     6049           space(23)    p-torgconf-accept-position format "X(20)" "     __________           "p-torgconf-accept-fname format "X(40)"
     6050           skip space(78) "/должность/          /подпись/               /расшифровка подписи/"
     6051           skip
     6052           .
     6053       end.
     6054   end procedure.
