     3473   procedure torgconf-get-ship-param :
     3474   define input parameter p-host-obj-code      as integer          no-undo.
     3475   define input parameter p-obj-type           as character        no-undo.
     3476   define input parameter p-obj-code           as integer          no-undo.
     3477   define input parameter p-curr-code          as integer          no-undo.
     3478       define variable v-host-code    as integer      no-undo.
     3479   do
