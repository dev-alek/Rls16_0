     1449   def buffer buf_doc-line     for ub.doc-line.
     1450   def buffer buf_trn-doc      for ub.trn-doc.
     1451   def var v-void-output-parameter         as decimal  no-undo.
     1452   find first buf_doc-line    where recid( buf_doc-line ) = p-doc-line-recid.
     1453   find first buf_trn-doc     where buf_trn-doc.doc-code  = buf_doc-line.doc-code.
     1454   find first temp_r-getsum
     1455        where temp_r-getsum.row-number = 1
     1456   no-error.
     1457   if not available temp_r-getsum
     1458   then do:
     1459       for each temp_r-getsum
     1460       :
     1461           delete temp_r-getsum.
     1462       end.
     1463       create temp_r-getsum.
     1464       assign
     1465           temp_r-getsum.row-number = 1
     1466       .
     1467   end.
     1468   if p-cost-prices = yes
     1469   then do:
     1470       if buf_doc-line.status_ = 'факт':U
     1471       then do:
     1472           if p-rubl-prices = no
     1473           then do:
     1474               run r-cost in this-procedure ( input buf_doc-line.doc-code
     1475                                            , input buf_doc-line.artic
     1476                                            , input buf_doc-line.prod-type
     1477                                            , input buf_doc-line.prod-code
     1478                                            , output temp_r-getsum.qnty
     1479                                            , output temp_r-getsum.vat-pc
     1480                                            , output temp_r-getsum.slt-pc
     1481                                            , output temp_r-getsum.sum-with-taxes
     1482                                            , output v-void-output-parameter
     1483                                            , output temp_r-getsum.sum-vat
     1484                                            , output v-void-output-parameter
     1485                                            , output temp_r-getsum.sum-slt
     1486                                            , output v-void-output-parameter
     1487                                            , output temp_r-getsum.sum-road-tax
     1488                                            , output v-void-output-parameter
     1489                                            , output temp_r-getsum.sum-transport
     1490                                            , output v-void-output-parameter
     1491                                            , output temp_r-getsum.sum-other
     1492                                            , output v-void-output-parameter
     1493                                            , output temp_r-getsum.sum-excise
     1494                                            , output v-void-output-parameter
     1495                                            ).
     1496           end.
     1497           else do:
     1498               run r-cost in this-procedure ( input buf_doc-line.doc-code
     1499                                           , input buf_doc-line.artic
     1500                                           , input buf_doc-line.prod-type
     1501                                           , input buf_doc-line.prod-code
     1502                                           , output temp_r-getsum.qnty
     1503                                           , output temp_r-getsum.vat-pc
     1504                                           , output temp_r-getsum.slt-pc
     1505                                           , output v-void-output-parameter
     1506                                           , output temp_r-getsum.sum-with-taxes
     1507                                           , output v-void-output-parameter
     1508                                           , output temp_r-getsum.sum-vat
     1509                                           , output v-void-output-parameter
     1510                                           , output temp_r-getsum.sum-slt
     1511                                           , output v-void-output-parameter
     1512                                           , output temp_r-getsum.sum-road-tax
     1513                                           , output v-void-output-parameter
     1514                                           , output temp_r-getsum.sum-transport
     1515                                           , output v-void-output-parameter
     1516                                           , output temp_r-getsum.sum-other
     1517                                           , output v-void-output-parameter
     1518                                           , output temp_r-getsum.sum-excise
     1519                                           ).
