     1003               or buf_trn-doc.doc-type = 'возврат':U
     1004               then do:
     1005                   assign
     1006                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1007                   .
     1008               end.
     1009               else do:
     1010                   assign
