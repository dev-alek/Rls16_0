     2004          varvatcons-rubl-docovp  = varvatcons-rubl-docovp  + (((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * out-vatp_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else out-vatp_gds-dtl.price-rubl - out-vatp_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * out-vatp_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty)
     2005          vardsc-rubl-docovp  = vardsc-rubl-docovp  + out-vatp_gds-dtl.discnt-rubl * out-vatp_gds-dtl.doc-qnty   .
     2006       end.
     2007       if buf_trn-doc.doc-type = 'инв':U then do:
     2008         ASSIGN
     2009                   price-base-with-tax-sale    = varsum-base-docovp / varfact-qnty
     2010           slt-base-sale               = varslt-base-docovp / varfact-qnty
     2011           vat-base-buyer              = varvat-base-docovp / varfact-qnty
     2012           discnt-base-sale            = vardsc-base-docovp / varfact-qnty
     2013           vat-base-sale               = varvatcons-base-docovp / varfact-qnty
     2014                   price-rubl-with-tax-sale    = varsum-rubl-docovp / varfact-qnty
     2015           slt-rubl-sale               = varslt-rubl-docovp / varfact-qnty
     2016           vat-rubl-buyer              = varvat-rubl-docovp / varfact-qnty
     2017           discnt-rubl-sale            = vardsc-rubl-docovp / varfact-qnty
     2018           vat-rubl-sale               = varvatcons-rubl-docovp / varfact-qnty.
     2019       end.
     2020       else do:
     2021         ASSIGN
     2022                   price-base-with-tax-sale    = varsum-base-factovp / varfact-qnty
     2023           slt-base-sale               = varslt-base-factovp / varfact-qnty
     2024           vat-base-buyer              = varvat-base-factovp / varfact-qnty
     2025           discnt-base-sale            = vardsc-base-factovp / varfact-qnty
     2026           vat-base-sale               = varvatcons-base-factovp / varfact-qnty
     2027                   price-rubl-with-tax-sale    = varsum-rubl-factovp / varfact-qnty
     2028           slt-rubl-sale               = varslt-rubl-factovp / varfact-qnty
     2029           vat-rubl-buyer              = varvat-rubl-factovp / varfact-qnty
     2030           discnt-rubl-sale            = vardsc-rubl-factovp / varfact-qnty
     2031           vat-rubl-sale               = varvatcons-rubl-factovp / varfact-qnty.
     2032       end.
     2033     end.
     2034   end.
     2035   assign
     2036     price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     2037     price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     2038           assign
     2039               temp_r-getsum.qnty              = buf_doc-line.fact-qnty
     2040               temp_r-getsum.vat-pc            = buf_doc-line.vat-pc
     2041               temp_r-getsum.slt-pc            = buf_doc-line.slt-pc
     2042               temp_r-getsum.sum-with-taxes    = (if p-rubl-prices = no
     2043                                                       then price-base-with-tax-sale
     2044                                                       else price-rubl-with-tax-sale) * buf_doc-line.fact-qnty
     2045               temp_r-getsum.sum-vat           = (if p-rubl-prices = no
     2046                                                       then vat-base-sale
     2047                                                       else vat-rubl-sale) * buf_doc-line.fact-qnty
     2048               temp_r-getsum.sum-slt           = (if p-rubl-prices = no
     2049                                                       then slt-base-sale
     2050                                                       else slt-rubl-sale) * buf_doc-line.fact-qnty
     2051               temp_r-getsum.sum-road-tax      = (if p-rubl-prices = no
     2052                                                       then road-tax-base-sale
     2053                                                       else road-tax-rubl-sale) * buf_doc-line.fact-qnty
     2054               temp_r-getsum.sum-transport     = 0
     2055               temp_r-getsum.sum-other         = (if p-rubl-prices = no
     2056                                                       then discnt-base-sale
     2057                                                       else discnt-rubl-sale) * buf_doc-line.fact-qnty
     2058               temp_r-getsum.sum-excise        = (if p-rubl-prices = no
     2059                                                       then excise-base-sale
     2060                                                       else excise-rubl-sale) * buf_doc-line.fact-qnty
     2061           .
     2062       end.
     2063   end.
     2064   assign
     2065       temp_r-getsum.sum-no-taxes      = temp_r-getsum.sum-with-taxes
     2066                                         - temp_r-getsum.sum-vat
     2067                                         - temp_r-getsum.sum-slt
     2068       temp_r-getsum.sum-no-vat        = temp_r-getsum.sum-with-taxes - temp_r-getsum.sum-vat
     2069       temp_r-getsum.sum-no-slt        = temp_r-getsum.sum-with-taxes - temp_r-getsum.sum-slt
     2070   .
     2071   if temp_r-getsum.qnty = 0 or temp_r-getsum.qnty = ?
     2072   then do:
     2073       assign
     2074           temp_r-getsum.price-no-taxes    = 0
     2075           temp_r-getsum.price-no-vat      = 0
     2076           temp_r-getsum.price-no-slt      = 0
     2077       .
     2078   end.
     2079   else do:
     2080       assign
     2081           temp_r-getsum.price-no-taxes    = temp_r-getsum.sum-no-taxes / temp_r-getsum.qnty
     2082           temp_r-getsum.price-no-vat      = temp_r-getsum.sum-no-vat   / temp_r-getsum.qnty
     2083           temp_r-getsum.price-no-slt      = temp_r-getsum.sum-no-vat   / temp_r-getsum.qnty
     2084       .
     2085   end.
     2086   end.
     2087   end procedure.
     2088   define variable vss-include-info17 as character format "X(65)" no-undo
     2089   initial "@(#)$Workfile$ $Revision$".
     2090   define variable v-fmtcli-name          as character    no-undo.
     2091   define variable v-fmtcli-engl-name     as character    no-undo.
     2092   define variable v-fmtcli-addres        as character    no-undo.
     2093   define variable v-fmtcli-post-addres   as character    no-undo.
     2094   define variable v-fmtcli-full-addres   as character    no-undo.
     2095   define variable v-fmtcli-phone         as character    no-undo.
     2096   define variable v-fmtcli-inn           as character    no-undo.
     2097   define variable v-fmtcli-kpp           as character    no-undo.
     2098   define variable v-fmtcli-okpo          as character    no-undo.
     2099   define variable v-fmtcli-country       as character    no-undo.
     2100   define variable v-fmtcli-city          as character    no-undo.
     2101   define variable v-fmtcli-index         as character    no-undo.
     2102   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2103   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2104   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2105   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2106   define variable v-fmtcli-bank-bik      as character    no-undo.
     2107   define variable v-fmtcli-bank-name     as character    no-undo.
     2108   define variable v-fmtcli-bank-addres   as character    no-undo.
     2109   define variable v-fmtcli-bank-city     as character    no-undo.
     2110   procedure fmtcli-get-bank :
     2111   define input parameter p-host-code      as integer          no-undo.
     2112   define input parameter p-obj-type       as character        no-undo.
     2113   define input parameter p-obj-code       as integer          no-undo.
     2114   define input parameter p-curr-code      as integer          no-undo.
     2115       define buffer buf_fin-schet     for ub.fin-schet.
     2116       define buffer buf_fin-bank      for ub.fin-bank.
     2117   do
     2118   for buf_fin-schet
     2119     , buf_fin-bank
     2120   on error undo, return error
     2121   :
     2122       assign
     2123           v-fmtcli-schet-exists       = no
     2124           v-fmtcli-bank-exists        = no
     2125           v-fmtcli-bank-r-schet       = "":U
     2126           v-fmtcli-bank-c-schet       = "":U
     2127           v-fmtcli-bank-bik           = "":U
     2128           v-fmtcli-bank-name          = "":U
     2129           v-fmtcli-bank-addres        = "":U
     2130           v-fmtcli-bank-city          = "":U
     2131       .
     2132       search-for-schet:
     2133       for each buf_fin-schet no-lock
     2134          where buf_fin-schet.host-code = p-host-code
     2135            and buf_fin-schet.cli-type  = p-obj-type
     2136            and buf_fin-schet.cli-code  = p-obj-code
     2137            and buf_fin-schet.curr-code = p-curr-code
     2138       on error undo, return error
     2139       :
     2140           if buf_fin-schet.status_   = 'удал':U
     2141           then do:
     2142           end.
     2143           else do:
     2144               assign
     2145                   v-fmtcli-schet-exists   = yes
     2146                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2147                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2148               .
     2149               find first buf_fin-bank no-lock
     2150                    where buf_fin-bank.host-code = p-host-code
     2151                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2152               no-error.
     2153               if available buf_fin-bank
     2154               then do:
     2155                   assign
     2156                       v-fmtcli-bank-exists      = yes
     2157                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2158                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2159                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2160                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2161                   .
     2162               end.
     2163               else do:
     2164                   assign
     2165                       v-fmtcli-bank-exists    = no
     2166                       v-fmtcli-bank-bik       = "":U
     2167                       v-fmtcli-bank-name      = "":U
     2168                       v-fmtcli-bank-addres    = "":U
     2169                       v-fmtcli-bank-city      = "":U
     2170                   .
     2171               end.
     2172               leave search-for-schet.
     2173           end.
     2174       end.
     2175   end.
     2176   end procedure.
     2177   procedure fmtcli-get-client :
     2178   define input parameter p-obj-type       as character    no-undo.
     2179   define input parameter p-obj-code       as integer      no-undo.
     2180       define variable v-temp-fmtcli-address      as character     no-undo.
     2181       define variable v-num-country-city    as integer      no-undo.
     2182       define buffer buf_clients   for ub.clients.
     2183       define buffer buf_firm      for ub.firm.
     2184       define buffer buf_store     for ub.store.
     2185       define buffer buf_shop      for ub.shop.
     2186       define buffer buf_person    for ub.person.
     2187   do
     2188   for buf_clients
     2189     , buf_firm
     2190     , buf_store
     2191     , buf_shop
     2192     , buf_person
     2193   on error undo, return error
     2194   :
     2195       assign
     2196           v-fmtcli-name           = "":U
     2197           v-fmtcli-addres         = "":U
     2198           v-fmtcli-post-addres    = "":U
     2199           v-fmtcli-full-addres    = "":U
     2200           v-fmtcli-phone          = "":U
     2201           v-fmtcli-inn            = "":U
     2202           v-fmtcli-kpp            = "":U
     2203           v-fmtcli-okpo           = "":U
     2204           v-fmtcli-city           = "":U
     2205           v-fmtcli-index          = "":U
     2206           v-fmtcli-country        = "":U
     2207       .
     2208       find first buf_clients no-lock
     2209            where buf_clients.obj-type = p-obj-type
     2210              and buf_clients.obj-code = p-obj-code
     2211       .
     2212       assign
     2213           v-fmtcli-name = buf_clients.obj-name
     2214       .
     2215       case buf_clients.obj-type:
     2216          when 'орг':U
     2217          then do:
     2218               find first buf_firm no-lock
     2219                    where buf_firm.firm-code = buf_clients.obj-code
     2220                    no-error
     2221               .
     2222               if available buf_firm
     2223               then do:
     2224                   assign
     2225                       v-num-country-city = num-entries( buf_firm.city )
     2226                       v-fmtcli-engl-name = buf_firm.engl-name
     2227                   .
     2228                   if v-num-country-city > 0
     2229                   then do:
     2230                       assign
     2231                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2232                       .
     2233                   end.
     2234                   if v-num-country-city > 1
     2235                   then do:
     2236                       assign
     2237                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2238                       .
     2239                   end.
     2240                   run fmtcli-concatenate-strings in this-procedure (
     2241                         input v-fmtcli-full-addres
     2242                       , input v-fmtcli-country
     2243                       , input ", ":U
     2244                       , input 50
     2245                       , output v-fmtcli-full-addres
     2246                   ).
     2247                   run fmtcli-concatenate-strings in this-procedure (
     2248                         input v-fmtcli-full-addres
     2249                       , input v-fmtcli-city
     2250                       , input ", ":U
     2251                       , input 50
     2252                       , output v-fmtcli-full-addres
     2253                   ).
     2254                   run fmtcli-concatenate-strings in this-procedure (
     2255                         input v-fmtcli-full-addres
     2256                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2257                       , input ", ":U
     2258                       , input 50
     2259                       , output v-fmtcli-full-addres
     2260                   ).
     2261                   run fmtcli-concatenate-strings in this-procedure (
     2262                         input v-fmtcli-post-addres
     2263                       , input v-fmtcli-country
     2264                       , input ", ":U
     2265                       , input 50
     2266                       , output v-fmtcli-post-addres
     2267                   ).
     2268                   run fmtcli-concatenate-strings in this-procedure (
     2269                         input v-fmtcli-post-addres
     2270                       , input v-fmtcli-city
     2271                       , input ", ":U
     2272                       , input 50
     2273                       , output v-fmtcli-post-addres
     2274                   ).
     2275                   run fmtcli-concatenate-strings in this-procedure (
     2276                         input v-fmtcli-post-addres
     2277                       , input string( buf_firm.ind )
     2278                       , input ", ":U
     2279                       , input 50
     2280                       , output v-fmtcli-post-addres
     2281                   ).
     2282                   run fmtcli-concatenate-strings in this-procedure (
     2283                         input substring( buf_firm.addres1, 1, 50 )
     2284                       , input buf_firm.addres2
     2285                       , input " ":U
     2286                       , input 50
     2287                       , output v-temp-fmtcli-address
     2288                   ).
     2289                   run fmtcli-concatenate-strings in this-procedure (
     2290                         input v-temp-fmtcli-address
     2291                       , input substring( buf_firm.addres1, 51, 50 )
     2292                       , input " ":U
     2293                       , input 50
     2294                       , output v-temp-fmtcli-address
     2295                   ).
     2296                   run fmtcli-concatenate-strings in this-procedure (
     2297                         input v-temp-fmtcli-address
     2298                       , input substring( buf_firm.addres1, 101, 50 )
     2299                       , input " ":U
     2300                       , input 50
     2301                       , output v-temp-fmtcli-address
     2302                   ).
     2303                   assign
     2304                       v-fmtcli-addres = v-temp-fmtcli-address
     2305                   .
     2306                   if buf_firm.addres1 <> ?
     2307                   then do:
     2308                       run fmtcli-concatenate-strings in this-procedure (
     2309                             input v-fmtcli-full-addres
     2310                           , input v-fmtcli-addres
     2311                           , input ", ":U
     2312                           , input 0
     2313                           , output v-fmtcli-full-addres
     2314                       ).
     2315                   end.
     2316                   run fmtcli-concatenate-strings in this-procedure (
     2317                         input substring( buf_firm.post-addr1, 1, 50 )
     2318                       , input buf_firm.post-addr2
     2319                       , input " ":U
     2320                       , input 50
     2321                       , output v-fmtcli-post-addres
     2322                   ).
     2323                   run fmtcli-concatenate-strings in this-procedure (
     2324                         input v-fmtcli-post-addres
     2325                       , input substring( buf_firm.post-addr1, 51, 50 )
     2326                       , input " ":U
     2327                       , input 50
     2328                       , output v-fmtcli-post-addres
     2329                   ).
     2330                   run fmtcli-concatenate-strings in this-procedure (
     2331                         input v-fmtcli-post-addres
     2332                       , input substring( buf_firm.post-addr1, 101, 50 )
     2333                       , input " ":U
     2334                       , input 50
     2335                       , output v-fmtcli-post-addres
     2336                   ).
     2337                   assign
     2338                       v-fmtcli-phone         = buf_firm.phone
     2339                       v-fmtcli-inn           = buf_firm.inn
     2340                       v-fmtcli-kpp           = buf_firm.kpp
     2341                       v-fmtcli-okpo          = buf_firm.okpo
     2342                       v-fmtcli-index         = string( buf_firm.ind )
     2343                   .
     2344               end.
     2345          end.
     2346          when 'маг':U
     2347          then do:
     2348               find first buf_shop no-lock
     2349                    where buf_shop.obj-code = buf_clients.obj-code
     2350               .
     2351               if available buf_shop
     2352               then do:
     2353                   run fmtcli-concatenate-strings in this-procedure (
     2354                         input buf_shop.addres1
     2355                       , input buf_shop.addres2
     2356                       , input " ":U
     2357                       , input 50
     2358                       , output v-fmtcli-addres
     2359                   ).
     2360                   assign
     2361                       v-fmtcli-full-addres = v-fmtcli-addres
     2362                       v-fmtcli-post-addres = v-fmtcli-addres
     2363                       v-fmtcli-phone       = buf_shop.phone
     2364                       v-fmtcli-inn         = "":U
     2365                       v-fmtcli-kpp         = "":U
     2366                       v-fmtcli-okpo        = "":U
     2367                       v-fmtcli-city        = "":U
     2368                       v-fmtcli-index       = "":U
     2369                   .
     2370               end.
     2371          end.
     2372          when 'скл':U
     2373          then do:
     2374               find first buf_store no-lock
     2375                    where buf_store.obj-code = buf_clients.obj-code
     2376               .
     2377               if available buf_store
     2378               then do:
     2379                   run fmtcli-concatenate-strings in this-procedure (
     2380                         input buf_store.addres1
     2381                       , input buf_store.addres2
     2382                       , input " ":U
     2383                       , input 50
     2384                       , output v-fmtcli-addres
     2385                   ).
     2386                   assign
     2387                       v-fmtcli-full-addres = v-fmtcli-addres
     2388                       v-fmtcli-phone       = buf_store.phone
     2389                       v-fmtcli-inn         = "":U
     2390                       v-fmtcli-kpp         = "":U
     2391                       v-fmtcli-okpo        = "":U
     2392                       v-fmtcli-city        = "":U
     2393                       v-fmtcli-index       = "":U
     2394                   .
     2395               end.
     2396          end.
     2397          when 'чел':U
     2398          then do:
     2399               find first buf_person no-lock
     2400                    where buf_person.psn-code = buf_clients.obj-code
     2401               .
     2402               if available buf_person
     2403               then do:
     2404                   run fmtcli-concatenate-strings in this-procedure (
     2405                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2406                                 then "":U
     2407                                 else string( buf_person.ind, "999999")
     2408                                 )
     2409                       , input buf_person.city
     2410                       , input ", ":U
     2411                       , input 0
     2412                       , output v-fmtcli-full-addres
     2413                   ).
     2414                   assign
     2415                       v-fmtcli-addres = buf_person.address
     2416                   .
     2417                   run fmtcli-concatenate-strings in this-procedure (
     2418                         input v-fmtcli-full-addres
     2419                       , input v-fmtcli-addres
     2420                       , input ", ":U
     2421                       , input 0
     2422                       , output v-fmtcli-full-addres
     2423                   ).
     2424                   assign
     2425                       v-fmtcli-phone     = buf_person.phone1
     2426                       v-fmtcli-inn       = buf_person.inn
     2427                       v-fmtcli-kpp       = buf_person.kpp
     2428                       v-fmtcli-okpo      = buf_person.okpo
     2429                       v-fmtcli-city      = buf_person.city
     2430                       v-fmtcli-index     = string( buf_person.ind )
     2431                   .
     2432               end.
     2433          end.
     2434       end case.
     2435   end.
     2436   end procedure.
     2437   procedure fmtcli-concatenate-strings :
     2438   define input parameter p-string-1       as character        no-undo.
     2439   define input parameter p-string-2       as character        no-undo.
     2440   define input parameter p-delimiter      as character        no-undo.
     2441   define input parameter p-length         as integer          no-undo.
     2442   define output parameter p-out-string    as character        no-undo.
     2443   do
     2444   on error undo, return error
     2445   :
     2446       assign
     2447           p-out-string = ( if p-string-1 = ?
     2448                            then "":U
     2449                            else trim( p-string-1 ) )
     2450       .
     2451       assign
     2452           p-out-string = p-out-string
     2453                        + ( if p-out-string = "":U
     2454                            or length( p-out-string ) = p-length
     2455                            or p-string-2 = ?
     2456                            or trim( p-string-2 ) = "":U
     2457                            then "":U
     2458                            else p-delimiter )
     2459                        + ( if p-string-2 = ?
     2460                            or trim( p-string-2 ) = "":U
     2461                            then "":U
     2462                            else trim( p-string-2 ) )
     2463       .
     2464   end.
     2465   end procedure.
