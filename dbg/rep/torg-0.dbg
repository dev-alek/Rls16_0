     3533   procedure torgconf-get-holdfirm-code :
     3534   define input parameter p-obj-type   as character        no-undo.
     3535   define input parameter p-obj-code   as integer          no-undo.
     3536   define output parameter p-firm-code as integer          no-undo.
     3537       define variable v-firm-code-str     as character    no-undo.
     3538       define variable v-par-type          as character    no-undo.
     3539       define buffer buf_clients       for ub.clients.
     3540   do
     3541   for buf_clients
     3542   on error undo, return error
     3543   :
     3544       run gbl/clntat-v.p (
     3545             input p-obj-type
     3546           , input p-obj-code
     3547           , input 'holdfirm-code':U
     3548           , output v-firm-code-str
     3549           , output v-par-type
     3550       ).
     3551       assign
     3552           p-firm-code = integer( v-firm-code-str )
     3553       no-error.
     3554       if error-status :error
     3555       then do:
     3556           message
     3557               "Неверно задан код фирмы для печати накладных."
     3558           view-as alert-box warning.
     3559           assign
     3560               p-firm-code = 0
     3561           .
     3562       end.
     3563       else do:
     3564           find first buf_clients no-lock
     3565                where buf_clients.obj-type = 'орг':U
     3566                  and buf_clients.obj-code = p-firm-code
     3567           no-error.
     3568           if not available buf_clients
     3569           then do:
     3570               message
     3571                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     3572                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     3573               view-as alert-box warning.
     3574               assign
     3575                   p-firm-code = 0
     3576               .
     3577           end.
     3578       end.
     3579   end.
     3580   end procedure.
     3581   procedure torgconf-get-post-head:
     3582   define input  parameter p-obj-type             as character        no-undo.
     3583   define input  parameter p-obj-code             as integer          no-undo.
     3584   define output parameter p-torgconf-post-head   as character        no-undo.
     3585      define variable v-host-code         as integer      no-undo.
     3586      define buffer buf_sysconf     for ub.sysconf.
     3587        assign
     3588         p-torgconf-post-head  = ""
     3589        .
     3590   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3592     (input  p-obj-type
     3593     ,input  p-obj-code
     3594     ,output v-host-code
     3595     )  .
     3596      find first buf_sysconf no-lock
     3597      where buf_sysconf.host-code = v-host-code
     3598      no-error.
     3599      if available buf_sysconf
     3600      then do:
     3601         assign
     3602            p-torgconf-post-head = buf_sysconf.head-position
     3603         .
     3604      end.
     3605   end procedure.
     3606   procedure torgconf-get-storekeeper:
     3607   define input  parameter p-wrkr                   as integer          no-undo.
     3608   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     3609   define output parameter p-torgconf-post          as character        no-undo.
     3610      define buffer buf_sysconf     for ub.sysconf.
     3611      define buffer buf_person      for ub.person.
     3612      define buffer buf_shop        for ub.shop .
     3613      define buffer buf_store       for ub.store .
     3614      if v-torgconf-outC = "no_print"
     3615      then do:
     3616         assign p-torgconf-post = ""
     3617                p-torgconf-wrkr-name = ""
     3618                .
     3619      end.
     3620      if v-torgconf-outC = "clad_doc"
     3621      then do:
     3622         run rep/get-psn.p
     3623               (input  p-wrkr
     3624               ,output p-torgconf-wrkr-name
     3625               ) .
     3626         find first buf_person no-lock
     3627         where buf_person.psn-code = p-wrkr
     3628         no-error.
     3629         if available buf_person
     3630         then do:
     3631           p-torgconf-post = buf_person.position.
     3632         end.
     3633         if p-torgconf-post = "?":U then p-torgconf-post = "".
     3634         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3635      end.
     3636      if v-torgconf-outC = "clad_obj"
     3637      then do:
     3638         CASE v-torgconf-self-obj-type:
     3639         WHEN 'маг':U
     3640         THEN DO:
     3641            find first buf_shop no-lock
     3642            where buf_shop.obj-code = v-torgconf-self-obj-code
     3643            .
     3644            assign
     3645               p-torgconf-wrkr-name = buf_shop.store-man
     3646               p-torgconf-post = ""
     3647            .
     3648            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3649         END.
     3650         WHEN 'скл':U
     3651         THEN DO:
     3652            find first buf_store no-lock
     3653            where buf_store.obj-code = v-torgconf-self-obj-code
     3654            .
     3655            assign
     3656               p-torgconf-wrkr-name = buf_store.store-man
     3657               p-torgconf-post = ""
     3658            .
     3659            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3660         END.
     3661         OTHERWISE DO:
     3662            assign
     3663               p-torgconf-post = "":U
     3664               p-torgconf-wrkr-name = "":U
     3665            .
     3666         END.
     3667         END CASE.
     3668      end.
     3669    end procedure.
     3670   procedure torgconf-get-form-header :
     3671   define input parameter p-for-inverse    as logical          no-undo.
     3672   define input parameter p-doc-code       as character        no-undo.
     3673   define input parameter p-print-doc      as logical          no-undo.
     3674   define input parameter p-doc-date       as date             no-undo.
     3675   define input parameter p-fact-date      as date             no-undo.
     3676   define input parameter p-doc-type       as character        no-undo.
     3677   define input parameter p-status_        as character        no-undo.
     3678   define input parameter p-reverse        as logical          no-undo.
     3679   define input parameter p-sf-par         as logical          no-undo.
     3680       define variable v-attr-type         as character    no-undo.
     3681       define variable v-doc-code-standard as logical      no-undo.
     3682       define variable v-doc-date-standard as logical      no-undo.
     3683       define variable v-par-consignee-addres  as character    no-undo.
     3684       define variable v-host-code         as integer      no-undo.
     3685       define variable v-dcode-attr        as character    no-undo.
     3686       define variable v-ddate-attr        as character    no-undo.
     3687       define variable v-doc-date          as character    no-undo.
     3688       define variable v-doc-code          as character    no-undo.
     3689       define variable v-par-type          as character    no-undo.
     3690       define variable v-attr              as character    no-undo.
     3691       define buffer buf_firm          for ub.firm .
     3692       define buffer buf_clients       for ub.clients .
     3693       define buffer buf_sysconf       for ub.sysconf .
     3694       define buffer buf_shop          for ub.shop .
     3695       define buffer buf_store         for ub.store .
     3696       define buffer buf_person        for ub.person .
     3697       define buffer buf_trn-doc       for ub.trn-doc .
     3698       define buffer buf_wth-doc       for ub.wth-doc .
     3699       do
     3700   for buf_firm
     3701     , buf_clients
     3702     , buf_sysconf
     3703     , buf_shop
     3704     , buf_trn-doc
     3705     , buf_person
     3706     , buf_wth-doc
     3707   on error undo, return error
     3708   :
     3709       if p-doc-type = 'при':U
     3710       or p-doc-type = 'возврат':U
     3711       then do:
     3712           assign
     3713               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3714                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3715               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3716                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3717               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     3718                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     3719               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     3720                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     3721               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     3722               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     3723               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     3724               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     3725               v-torgconf-supplier-type    = v-torgconf-cli-type
     3726               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     3727               v-torgconf-saler-type       = v-torgconf-self-host-type
     3728               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     3729               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     3730               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     3731               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     3732               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     3733               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     3734               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     3735               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     3736               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     3737               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     3738               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     3739               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     3740               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     3741               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     3742               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     3743           .
     3744           if v-torgconf-cli-schet-exists = yes
     3745           AND v-form-name                  = "torg12":U
     3746           then do:
     3747               assign
     3748                   v-torgconf-supplier = v-torgconf-supplier
     3749                       + substitute( ", р/с &1 к/с &2"
     3750                                   , v-torgconf-cli-bank-r-schet
     3751                                   , v-torgconf-cli-bank-c-schet
     3752                                   )
     3753                   v-torgconf-suppi = v-torgconf-supplier
     3754                       + substitute( ", р/с &1 к/с &2"
     3755                                   , v-torgconf-cli-bank-r-schet
     3756                                   , v-torgconf-cli-bank-c-schet
     3757                                   )
     3758               .
     3759               if v-torgconf-cli-bank-exists = yes
     3760               then do:
     3761                   assign
     3762                       v-torgconf-supplier = v-torgconf-supplier
     3763                           + substitute( " БИК &1 в &2 &3"
     3764                                       , v-torgconf-cli-bank-bik
     3765                                       , v-torgconf-cli-bank-name
     3766                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3767                                       )
     3768                      v-torgconf-suppi = v-torgconf-supplier
     3769                           + substitute( " БИК &1 в &2 &3"
     3770                                       , v-torgconf-cli-bank-bik
     3771                                       , v-torgconf-cli-bank-name
     3772                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3773                                       )
     3774                   .
     3775               end.
     3776           end.
     3777           if v-torgconf-self-schet-exists = yes
     3778           AND v-form-name                  = "torg12":U
     3779           then do:
     3780               assign
     3781                   v-torgconf-saler = v-torgconf-saler
     3782                       + substitute( ", р/с &1 к/с &2"
     3783                                   , v-torgconf-self-bank-r-schet
     3784                                   , v-torgconf-self-bank-c-schet
     3785                                   )
     3786               .
     3787               if v-torgconf-self-bank-exists = yes
     3788               then do:
     3789                   assign
     3790                       v-torgconf-saler = v-torgconf-saler
     3791                           + substitute( " БИК &1 в &2 &3"
     3792                                       , v-torgconf-self-bank-bik
     3793                                       , v-torgconf-self-bank-name
     3794                                       , v-torgconf-self-bank-addres
     3795                                       )
     3796                   .
     3797               end.
     3798           end.
     3799           if v-torgconf-sup-schet-exists = yes
     3800           AND v-form-name                  = "torg12":U
     3801           then do:
     3802               assign
     3803                   v-torgconf-consignee = v-torgconf-consignee
     3804                       + substitute( ", р/с &1 к/с &2"
     3805                                   , v-torgconf-sup-bank-r-schet
     3806                                   , v-torgconf-sup-bank-c-schet
     3807                                   )
     3808               .
     3809             if v-torgconf-sup-bank-exists = yes
     3810              then do:
     3811                assign
     3812                   v-torgconf-consignee = v-torgconf-consignee
     3813                           + substitute( " БИК &1 в &2 &3"
     3814                                       , v-torgconf-sup-bank-bik
     3815                                       , v-torgconf-sup-bank-name
     3816                                       , v-torgconf-sup-bank-addres
     3817                                       )
     3818                   .
     3819               end.
     3820           end.
     3821      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     3822      then do:
     3823          assign
     3824            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     3825                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     3826                                                   , v-torgconf-cli-name
     3827                                                   , ( if v-torgconf-outprncd = yes
     3828                                                         then substitute( " (&1)", v-torgconf-cli-code )
     3829                                                         else "":U )
     3830                                                   , v-torgconf-cli-post-addres
     3831                                                   , v-torgconf-cli-phone
     3832                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     3833                                                       AND v-form-name                  = "torg12":U
     3834                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3835                                                               , v-torgconf-cli-bank-r-schet
     3836                                                               , v-torgconf-cli-bank-c-schet
     3837                                                               , v-torgconf-cli-bank-bik
     3838                                                               , v-torgconf-cli-bank-name
     3839                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     3840                                                         else "":U )
     3841                                                )
     3842         .
     3843      end.
     3844       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     3845                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     3846                                        , v-torgconf-cli-name
     3847                                        , ( if v-torgconf-outprncd = yes
     3848                                            then substitute( " (&1)", v-torgconf-cli-code )
     3849                                            else "":U )
     3850                                        , v-torgconf-cli-addres
     3851                                        , v-torgconf-cli-phone
     3852                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     3853                                            AND v-form-name                  = "torg12":U
     3854                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3855                                                           , v-torgconf-cli-bank-r-schet
     3856                                                           , v-torgconf-cli-bank-c-schet
     3857                                                           , v-torgconf-cli-bank-bik
     3858                                                           , v-torgconf-cli-bank-name
     3859                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     3860                                                   else "":U )
     3861                                        ).
     3862       end.
     3863       else do:
     3864       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     3865                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     3866                                        , v-torgconf-self-host-name
     3867                                        , ( if v-torgconf-outprncd = yes
     3868                                            then substitute( " (&1)", v-torgconf-self-host-code )
     3869                                            else "":U )
     3870                                        , v-torgconf-self-host-addres
     3871                                        , v-torgconf-self-host-phone
     3872                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     3873                                            AND v-form-name                  = "torg12":U
     3874                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     3875                                                           , v-torgconf-self-bank-r-schet
     3876                                                           , v-torgconf-self-bank-c-schet
     3877                                                           , v-torgconf-self-bank-bik
     3878                                                           , v-torgconf-self-bank-name
     3879                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     3880                                                   else "":U )
     3881                                           ).
     3882         if v-torgconf-outares = yes
     3883         and p-reverse = no
     3884         then do:
     3885            assign
     3886               v-par-consignee-addres = v-torgconf-ship-post-addres
     3887            .
     3888         end.
     3889         if v-torgconf-outares = no
     3890         and p-reverse = no
     3891         then do:
     3892            assign
     3893               v-par-consignee-addres = v-torgconf-ship-addres
     3894            .
     3895         end.
     3896         if p-reverse = yes
     3897         then do:
     3898             assign
     3899               v-par-consignee-addres = v-torgconf-ship-addres
     3900             .
     3901         end.
     3902           assign
     3903               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     3904                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     3905               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     3906                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3907               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     3908                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     3909               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     3910               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     3911               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     3912               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     3913               v-torgconf-supplier-code    = v-torgconf-self-host-type
     3914               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     3915               v-torgconf-saler-type       = v-torgconf-cli-type
     3916               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     3917               v-torgconf-consignee-type   = v-torgconf-ship-type
     3918               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     3919               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     3920               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     3921               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     3922               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     3923               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     3924               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     3925               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     3926               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     3927               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     3928               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     3929               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     3930               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     3931               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     3932               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     3933               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     3934               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     3935           .
     3936           if v-torgconf-self-schet-exists = yes
     3937           AND v-form-name                  = "torg12":U
     3938           then do:
     3939               assign
     3940                   v-torgconf-supplier = v-torgconf-supplier
     3941                       + substitute( ", р/с &1 к/с &2"
     3942                                   , v-torgconf-self-bank-r-schet
     3943                                   , v-torgconf-self-bank-c-schet
     3944                                   )
     3945               .
     3946               if v-torgconf-self-bank-exists = yes
     3947               then do:
     3948                   assign
     3949                       v-torgconf-supplier = v-torgconf-supplier
     3950                           + substitute( " БИК &1 в &2 &3"
     3951                                       , v-torgconf-self-bank-bik
     3952                                       , v-torgconf-self-bank-name
     3953                                       , v-torgconf-self-bank-addres
     3954                                       )
     3955                   .
     3956               end.
     3957           end.
     3958           if v-torgconf-cli-schet-exists = yes
     3959           AND v-form-name                  = "torg12":U
     3960           then do:
     3961               assign
     3962                   v-torgconf-saler = v-torgconf-saler
     3963                       + substitute( ", р/с &1 к/с &2"
     3964                                   , v-torgconf-cli-bank-r-schet
     3965                                   , v-torgconf-cli-bank-c-schet
     3966                                   )
     3967               .
     3968               if v-torgconf-cli-bank-exists = yes
     3969               then do:
     3970                   assign
     3971                       v-torgconf-saler = v-torgconf-saler
     3972                           + substitute( " БИК &1 в &2 &3"
     3973                                       , v-torgconf-cli-bank-bik
     3974                                       , v-torgconf-cli-bank-name
     3975                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3976                                       )
     3977                   .
     3978               end.
     3979           end.
     3980           if v-torgconf-ship-schet-exists = yes
     3981           AND v-form-name                  = "torg12":U
     3982           then do:
     3983               assign
     3984                   v-torgconf-consignee = v-torgconf-consignee
     3985                       + substitute( ", р/с &1 к/с &2"
     3986                                   , v-torgconf-ship-bank-r-schet
     3987                                   , v-torgconf-ship-bank-c-schet
     3988                                   )
     3989               .
     3990               if v-torgconf-ship-bank-exists = yes
     3991               then do:
     3992                   assign
     3993                       v-torgconf-consignee = v-torgconf-consignee
     3994                           + substitute( " БИК &1 в &2  &3"
     3995                                       , v-torgconf-ship-bank-bik
     3996                                       , v-torgconf-ship-bank-name
     3997                                       , (if v-torgconf-ship-bank-city = "":U then "":U else ( "г. " + v-torgconf-ship-bank-city) )
     3998                                       )
     3999                   .
     4000               end.
     4001           end.
     4002      if p-reverse = yes
     4003         then do:
     4004          if  v-torgconf-outares = yes then v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-post-addres       = "":U then "":U else ", " ), v-torgconf-cli-post-addres       )
     4005            .
     4006          else v-torgconf-saler = substitute( "&1&2&3", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres       ) .
