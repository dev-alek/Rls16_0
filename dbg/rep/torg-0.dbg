     3105   define input parameter torgconfdoc-code   as character                  no-undo.
     3106   define output parameter v-code-rec        as integer                    no-undo .
     3107   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     3108   define output parameter v-codefirm-rec    as integer                    no-undo .
     3109   define output parameter v-curcode-rec     as integer                    no-undo .
     3110        define variable  v-recipient-code  as character                  no-undo .
     3111        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     3112        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     3113   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     3114                           input 'Recipient':U ,
     3115                          output v-recipient-code ,
     3116                          output v-trdcattr-type ) no-error .
     3117       if error-status :error then do:
     3118        message
     3119         vss-workfile vss-revision vss-description skip
     3120         "Ошибка при вызове процедуры tdat-val":U skip
     3121         "Документ: " torgconfdoc-code skip
     3122         "Атрибут: " 'Recipient':U skip
     3123         "Значение: " v-recipient skip
     3124         trim( error-status :get-message (1) ) skip
     3125         return-value skip
     3126         view-as alert-box error.
     3127       undo, return error return-value.
     3128       end.
