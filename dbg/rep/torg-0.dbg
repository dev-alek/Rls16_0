     5123                  .
     5124                  assign
     5125                     v-torgconf-ogr-name = buf_store.store-boss
     5126                     v-torgconf-ogr-post = "Директор"
     5127                  .
     5128               END.
     5129               OTHERWISE DO:
     5130                  assign
     5131                     v-torgconf-ogr-name = "":U
     5132                     v-torgconf-ogr-post = "":U
     5133                  .
     5134               END.
     5135               END CASE.
     5136            end.
     5137      if v-torgconf-outogr = "manag_doc"
     5138         then do:
