     1012                   .
     1013               end.
     1014           end.
     1015           else do:
     1016               assign
     1017                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1018               .
     1019           end.
     1020           if v-gds-dtl-fact-qnty <> 0
     1021           then do:
