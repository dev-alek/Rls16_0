      591      else do:
      592        assign
      593          in-vatp-have-vat-slt = yes.
      594      end.
      595      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
      596                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
      597                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
      598      if (not buf_trn-doc.internal and
      599              buf_trn-doc.doc-type = 'при':U) or
      600         in-vatp-goods.gds-type = 'у':U then do:
      601         if varinvprb = "base":u then do:
      602           assign
      603             road-tax-base-loc = buf_doc-line.road-tax
      604             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
      605         end.
      606         else do:
      607           ASSIGN
      608             road-tax-rubl-loc = buf_doc-line.road-tax
      609             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
      610         end.
      611         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      612         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      613         assign
      614           road-tax-cli-loc = ?.
      615         ASSIGN
      616           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
      617           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
      618           transport-cli-loc  = 0
