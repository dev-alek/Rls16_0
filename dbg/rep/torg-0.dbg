     4894        when "nacl":U
     4895        then do:
     4896            if  v-name <> 'wthtrg12'
     4897            and v-name <> 'wthfct'
     4898            and v-name <> 'wthm11'
     4899            then do:
     4900               assign
     4901                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3"
     4902                                                   , if trim(v-dcode-attr) = "" then v-torgconf-doc-code else v-dcode-attr
     4903                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     4904                                                   , ( if p-status_ <> 'факт':U
     4905                                                      then string( "(" + caps( p-status_ ) + ")" )
     4906                                                      else "":U )
     4907                                                )
     4908               .
     4909            end.
     4910            else do:
     4911            if trim(v-attr) = ""
     4912            then do:
     4913               assign
     4914                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     4915                                                           v-torgconf-doc-code,
     4916                                                           v-torgconf-doc-date,
     4917                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     4918                                                           )
     4919               .
     4920            end.
     4921            else do:
     4922               assign
     4923                  v-torgconf-plat-rasch-doc = v-attr.
     4924            end.
     4925            end.
     4926        end.
     4927        otherwise do:
     4928            if  v-name <> 'wthtrg12'
     4929            and v-name <> 'wthfct'
     4930            and v-name <> 'wthm11'
     4931            then do:
     4932               IF v-dcode-attr <> "":U
     4933               OR v-ddate-attr <> "":U
     4934               THEN
     4935               assign
     4936                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     4937                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     4938                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     4939                                                   )
     4940               .
     4941            end.
     4942            else do:
     4943               assign
     4944                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     4945               .
     4946            end.
     4947        end.
     4948       end case.
     4949      if v-torgconf-outB = "no_print"
     4950      then do:
     4951         assign v-torgconf-main-buh = "".
     4952      end.
     4953      if v-torgconf-outB = "glbuh_firm"
     4954      then do:
     4955            if v-torgconf-self-host-code = 0
     4956            then do:
     4957            end.
     4958            else do:
     4959               find first buf_sysconf no-lock
     4960                  where buf_sysconf.host-code = v-torgconf-self-host-code
     4961               .
     4962               assign
     4963                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     4964               .
     4965            end.
     4966      end.
     4967      if v-torgconf-outB = "buh_obj"
     4968      then do:
     4969         CASE v-torgconf-self-obj-type:
     4970         WHEN 'маг':U
     4971         THEN DO:
     4972            find first buf_shop no-lock
     4973            where buf_shop.obj-code = v-torgconf-self-obj-code
     4974            .
     4975            assign
     4976               v-torgconf-main-buh  = entry(1,buf_shop.acct,"|")
     4977            .
     4978         END.
     4979         WHEN 'скл':U
     4980         THEN DO:
     4981            find first buf_store no-lock
     4982            where buf_store.obj-code = v-torgconf-self-obj-code
     4983            .
     4984            assign
     4985               v-torgconf-main-buh  = buf_store.store-man
     4986            .
     4987         END.
     4988         OTHERWISE DO:
     4989            assign
     4990               v-torgconf-main-buh  = "":U
     4991            .
     4992         END.
     4993         END CASE.
     4994      end.
     4995      if v-torgconf-outR = "no_print"
     4996         then do:
     4997            assign
     4998               v-torgconf-main-boss = ""
     4999               v-torgconf-main-boss-post = ""
     5000            .
     5001         end.
     5002      if v-torgconf-outR = "ruk_firm"
     5003         then do:
     5004            find first buf_sysconf no-lock
     5005            where buf_sysconf.host-code = v-torgconf-self-host-code
     5006            no-error.
     5007            if available buf_sysconf
     5008            then do:
     5009               assign
     5010                  v-torgconf-main-boss-post = buf_sysconf.head-position
     5011               .
     5012            end.
     5013            find first buf_clients no-lock
     5014            where buf_clients.obj-type = 'орг':U
     5015            and buf_clients.obj-code = v-torgconf-self-host-code
     5016            .
     5017            find first buf_firm no-lock
     5018            where buf_firm.firm-code = buf_clients.obj-code
     5019            no-error.
     5020            if available buf_firm
     5021            then do:
     5022               assign
     5023                  v-torgconf-main-boss = buf_firm.director
     5024               .
     5025            end.
     5026         end.
     5027      if v-torgconf-outR = "dir_obj"
     5028         then do:
     5029            CASE v-torgconf-self-obj-type:
     5030            WHEN 'маг':U
     5031            THEN DO:
     5032               find first buf_shop no-lock
     5033               where buf_shop.obj-code = v-torgconf-self-obj-code
     5034               .
     5035               assign
     5036                  v-torgconf-main-boss = buf_shop.director
     5037                  v-torgconf-main-boss-post = "Директор"
     5038               .
     5039            END.
     5040            WHEN 'скл':U
     5041            THEN DO:
     5042               find first buf_store no-lock
     5043               where buf_store.obj-code = v-torgconf-self-obj-code
     5044               .
     5045               assign
     5046                  v-torgconf-main-boss = buf_store.store-boss
     5047                  v-torgconf-main-boss-post = "Директор"
     5048               .
     5049            END.
     5050            OTHERWISE DO:
     5051               assign
     5052                  v-torgconf-main-boss       = "":U
     5053                  v-torgconf-main-boss-post  = "":U
     5054               .
     5055            END.
     5056            END CASE.
     5057         end.
     5058      if  v-name <> 'wthtrg12':U
     5059      and v-name <> 'wthfct':U
     5060      and v-name <> 'wthm11':U
     5061      then do:
     5062       find first buf_trn-doc no-lock
     5063       where buf_trn-doc.doc-code = p-doc-code
     5064       no-error.
     5065       if available buf_trn-doc
     5066         then do:
     5067   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5068   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     5069     (input  buf_trn-doc.obj-type
     5070     ,input  buf_trn-doc.obj-code
     5071     ,output v-host-code
     5072     )  .
     5073         end.
     5074       if v-torgconf-outogr = "no_print"
     5075         then do:
     5076            assign
     5077               v-torgconf-ogr-name = ""
     5078               v-torgconf-ogr-post = ""
     5079            .
     5080         end.
     5081      if v-torgconf-outogr  = "ruk_firm"
