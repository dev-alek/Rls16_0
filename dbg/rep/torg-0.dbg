     3490           v-torgconf-ship-name         = "":U
     3491           v-torgconf-ship-addres       = "":U
     3492           v-torgconf-ship-post-addres  = "":U
     3493           v-torgconf-ship-phone        = "":U
     3494           v-torgconf-ship-inn          = "":U
     3495           v-torgconf-ship-kpp          = "":U
     3496           v-torgconf-ship-okpo         = "":U
     3497       .
     3498       end.
     3499       else do:
     3500       run fmtcli-get-client in this-procedure (
     3501             input p-obj-type
     3502           , input p-obj-code
     3503       ).
     3504       assign
     3505           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     3506           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     3507           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     3508           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     3509           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     3510           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     3511           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     3512           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     3513       .
     3514       end.
     3515           run fmtcli-get-bank in this-procedure (
     3516             input p-host-obj-code
     3517           , input p-obj-type
     3518           , input p-obj-code
     3519           , input p-curr-code
     3520       ).
     3521       assign
     3522           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     3523           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
