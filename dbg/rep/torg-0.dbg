     5246       define buffer buf_firm          for ub.firm .
     5247       define buffer buf_clients       for ub.clients .
     5248       define buffer buf_sysconf       for ub.sysconf .
     5249       define buffer buf_shop          for ub.shop .
     5250       define buffer buf_store         for ub.store .
     5251       define buffer buf_person        for ub.person .
