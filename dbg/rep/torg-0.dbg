     5309                  where buf_store.obj-code = buf_trn-doc.obj-code
     5310                  .
     5311                  assign
     5312                     v-torgconf-ogr-name = buf_store.store-boss
     5313                     v-torgconf-ogr-post = "Директор"
     5314                  .
     5315               END.
