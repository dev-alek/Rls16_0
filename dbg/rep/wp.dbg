        1   block-level on error undo, throw.
        2   DEFINE  INPUT PARAMETER p-parent-proc AS WIDGET-HANDLE NO-UNDO.
        3   DEFINE  INPUT PARAMETER p-InSum       AS DECIMAL       NO-UNDO.
        4   DEFINE OUTPUT PARAMETER p-OutSum      AS CHARACTER     NO-UNDO.
        5   DEFINE OUTPUT PARAMETER p-abbr        AS CHARACTER     NO-UNDO.
        6   DEFINE VARIABLE vss-revision    AS CHARACTER NO-UNDO INITIAL "$Revision: aea5316774be, 0, rls $":U.
        7   DEFINE VARIABLE vss-author      AS CHARACTER NO-UNDO INITIAL "$Author: expertek $":U.
        8   DEFINE VARIABLE vss-date        AS CHARACTER NO-UNDO INITIAL "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U.
        9   DEFINE VARIABLE vss-workfile    AS CHARACTER NO-UNDO INITIAL "$Workfile: wp.p $":U.
       10   DEFINE VARIABLE vss-archive     AS CHARACTER NO-UNDO INITIAL "$Archive: rep/wp.p $":U.
       11   DEFINE VARIABLE vss-description AS CHARACTER NO-UNDO INITIAL "сумма прописью в базовой валюте":U.
       12   procedure vss-get-info :
       13     define output parameter p-vss-revision    like vss-revision    no-undo .
       14     define output parameter p-vss-author      like vss-author      no-undo .
       15     define output parameter p-vss-date        like vss-date        no-undo .
       16     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       17     define output parameter p-vss-archive     like vss-archive     no-undo .
       18     define output parameter p-vss-description like vss-description no-undo .
       19     assign
       20       p-vss-revision    = vss-revision
       21       p-vss-author      = vss-author
       22       p-vss-date        = vss-date
       23       p-vss-workfile    = vss-workfile
       24       p-vss-archive     = vss-archive
       25       p-vss-description = vss-description
       26     .
       27   end procedure.
       28   procedure vss-get-parameters :
       29     define output parameter p-vss-parameters as character no-undo .
       30   end procedure.
       31   define new global shared variable g#vssrevis-logger as handle    no-undo .
       32   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       33   define variable v-vssrevis-logger                   as handle    no-undo .
       34   procedure vss-logevent :
       35     define input  parameter p-extra-paramters as character no-undo .
       36     define variable v-vssrevis-parameters as character no-undo .
       37     do
       38     on error undo, return error return-value
       39     :
       40       if  valid-handle(v-vssrevis-logger)
       41       and v-vssrevis-logger :get-signature("logevent") <> ""
       42       then do:
       43         run vss-get-parameters in this-procedure
       44           (output v-vssrevis-parameters
       45           ).
       46         run logevent in v-vssrevis-logger
       47           (input vss-workfile
       48           ,input vss-revision
       49           ,input v-vssrevis-parameters
       50           ,input p-extra-paramters
       51           ).
       52       end.
       53     end.
       54   end procedure.
       55   assign
       56     v-vssrevis-logger = g#vssrevis-logger
       57   .
       58   if  valid-handle(v-vssrevis-logger)
       59   and v-vssrevis-logger :get-signature("logevent") <> ""
       60   then do:
       61     assign
       62       v-vssrevis-logevent = true
       63     .
       64     run vss-logevent in this-procedure (input vss-description) .
       65   end.
       66   define new global shared variable g#language as character no-undo .
       67   if g#language <> '' and g#language <> 'rus':U then do:
       68     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       69   end.
       70   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
       71     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
       72     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
       73     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
       74   END FUNCTION.
       75   PROCEDURE get-red-line :
       76     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
       77     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
       78     DO ON ERROR UNDO, RETURN ERROR :
       79       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
       80     END.
       81   END PROCEDURE.
       82   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
       83     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
       84     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
       85     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
       86   END FUNCTION.
       87   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
       88     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
       89     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
       90     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
       91   END FUNCTION.
       92   PROCEDURE get-number-grade :
       93     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
       94     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
       95     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
       96     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
       97     DO ON ERROR UNDO, RETURN ERROR :
       98       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
       99       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      100       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      101       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      102                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      103       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      104     END.
      105   END PROCEDURE.
      106   PROCEDURE conv-sum-to-word :
      107     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      108     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      109     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      110     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      111     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      112     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      113     DO ON ERROR UNDO, RETURN ERROR :
      114       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      115       IF ERROR-STATUS :ERROR THEN DO:
      116         ASSIGN p-res = ?.
      117         UNDO, RETURN ERROR.
      118       END.
      119       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      120         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      121         IF jj < 15 THEN DO:
      122           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      123           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      124              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      125           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      126              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      127              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      128             IF jj = 12 THEN DO:
      129               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      130             END.       ELSE DO:
      131               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      132             END.
      133           END.
      134           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      135                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      136                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      137                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      138              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      139           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      140         END.
      141         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      142           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      143           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      144           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      145           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      146           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      147         END.                                        ELSE DO:
      148           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      149         END.
      150         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      151         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      152         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      153       END.
      154       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      155       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      156       ASSIGN p-res = TRIM( OutSum ).
      157     END.
      158   END PROCEDURE.
      159   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      160     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      161     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      162     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      163   END FUNCTION.
      164   PROCEDURE get-total-word :
      165     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      166     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      167     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      168     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      169     DO ON ERROR UNDO, RETURN ERROR :
      170       ASSIGN p-word = Word-Sum( p-sum ).
      171                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      172                         RedLine( p-word )
      173                  ) +
      174                         " ":U + p-curr + " ":U +
      175                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      176                         " ":U + p-part + ".".
      177                           END.
      178   END PROCEDURE.
      179   define new global shared variable g#library  as handle no-undo .
      180   define new global shared variable g#library2 as handle no-undo .
      181   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      182     define variable v-cntxt-db-num        as integer   no-undo .
      183     define variable v-cntxt-userid        as character no-undo .
      184     define variable v-cntxt-level         as character no-undo .
      185     define variable v-cntxt-host-code-obj as integer   no-undo .
      186     define variable v-cntxt-obj-type      as character no-undo .
      187     define variable v-cntxt-obj-code      as integer   no-undo .
      188     define variable v-cntxt-db-num-obj    as integer   no-undo .
      189     define variable v-cntxt-is-admin      as logical   no-undo .
      190   DEFINE VARIABLE parparentproc AS WIDGET-HANDLE NO-UNDO.
      191   DEFINE VARIABLE p-part        AS CHARACTER     NO-UNDO.
      192   DEFINE BUFFER bf_sysconf  FOR ub.sysconf.
      193   DEFINE BUFFER bf_currency FOR ub.currency.
      194   DO ON ERROR UNDO, RETURN ERROR :
      195     ASSIGN parparentproc = p-parent-proc.
      196   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      197     run mainmenu_getcntxt in parparentproc
      198       (output v-cntxt-db-num
      199       ,output v-cntxt-userid
      200       ,output v-cntxt-level
      201       ,output v-cntxt-host-code-obj
      202       ,output v-cntxt-obj-type
      203       ,output v-cntxt-obj-code
      204       ,output v-cntxt-db-num-obj
      205       ,output v-cntxt-is-admin
      206       ) .
      207     FIND FIRST bf_sysconf  NO-LOCK WHERE bf_sysconf.host-code  = v-cntxt-host-code-obj.
      208     FIND FIRST bf_currency NO-LOCK WHERE bf_currency.curr-code = bf_sysconf.base-code.
      209     ASSIGN p-abbr = bf_currency.curr-abbr
      210            p-part = bf_currency.part-abbr.
      211     ASSIGN p-OutSum = Total-Word( p-InSum, p-abbr, p-part ).
      212   END.
