      198   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      199   function getattrUtdex returns char
      200   (idb-num   as integer,
      201    idoc-id   as integer,
      202    iattrcode as character,
      203    iExValue  as character  ):
      204      define buffer utd-attr for utd-attr.
      205      find first utd-attr where utd-attr.db-num eq idb-num
      206                            and utd-attr.doc-id eq idoc-id
      207                            and utd-attr.attr-code eq iattrcode
      208      no-lock no-error.
      209      return if not available utd-attr  then iExValue    else  utd-attr.attr-value.
      210   end.
      211   function getattrUtd returns char
      212   (idb-num   as integer,
      213    idoc-id   as integer,
      214    iattrcode as character ):
      215     return getattrUtdex(idb-num,idoc-id,iattrcode,?).
      216   end.
      217   function setattrUtd returns logical
      218   (idb-num   as integer,
      219    idoc-id   as integer,
      220    iattrcode as character,
      221    iattrval  as character ):
      222      define buffer utd-attr for utd-attr.
      223      find first utd-attr where utd-attr.db-num eq idb-num
      224                            and utd-attr.doc-id eq idoc-id
      225                            and utd-attr.attr-code eq iattrcode
      226      no-lock no-error.
      227      if not available utd-attr
      228      then do:
      229         create utd-attr.
      230         assign
      231            utd-attr.db-num    = idb-num
      232            utd-attr.doc-id    = idoc-id
      233            utd-attr.attr-code = iattrcode
      234            utd-attr.attr-value = iattrval
      235         .
      236      end.
      237      else do:
      238         if utd-attr.attr-value ne iattrval
      239         then do:
      240            find current utd-attr exclusive-lock no-error.
      241            if available utd-attr
      242            then
      243               utd-attr.attr-value = iattrval.
      244         end.
      245      end.
      246      release utd-attr.
      247   end.
      248   function GetAttrUtdlinesEx returns char
      249   (idb-num   as integer,
      250    idoc-id   as integer,
      251    ilinenum  as integer,
      252    iattrcode as character,
      253    iExValue  as character  ):
      254      define buffer utd-lines-attr for utd-lines-attr.
      255      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      256                                  and utd-lines-attr.doc-id    eq idoc-id
      257                                  and utd-lines-attr.lineNum   eq ilineNum
      258                                  and utd-lines-attr.attr-code eq iattrcode
      259      no-lock no-error.
      260      return if not available utd-lines-attr  then iExValue    else  utd-lines-attr.attr-value.
      261   end.
      262   function GetAttrUtdlines returns char
      263   (idb-num   as integer,
      264    idoc-id   as integer,
      265    ilinenum  as integer,
      266    iattrcode as character ):
      267      return GetAttrUtdlinesex (idb-num,idoc-id,ilinenum,iattrcode,?).
      268   end.
      269   function setattrUtdlines returns logical
      270   (idb-num   as integer,
      271    idoc-id   as integer,
      272    ilinenum  as integer,
      273    iattrcode as character,
      274    iattrval  as character ):
      275      define buffer utd-lines-attr for utd-lines-attr.
      276      find first utd-lines-attr where utd-lines-attr.db-num    eq idb-num
      277                                  and utd-lines-attr.doc-id    eq idoc-id
      278                                  and utd-lines-attr.lineNum   eq ilineNum
      279                                  and utd-lines-attr.attr-code eq iattrcode
      280      no-lock no-error.
      281      if not available utd-lines-attr
      282      then do:
      283         if iattrval ne ?
      284            and iattrval ne ""
      285         then do:
      286            create utd-lines-attr.
      287            assign
      288               utd-lines-attr.db-num    = idb-num
      289               utd-lines-attr.doc-id    = idoc-id
      290               utd-lines-attr.lineNum   = ilineNum
      291               utd-lines-attr.attr-code = iattrcode
      292               utd-lines-attr.attr-value = iattrval
      293            .
      294         end.
      295      end.
      296      else do:
      297         if utd-lines-attr.attr-value ne iattrval
      298         then do:
      299            find current utd-lines-attr exclusive-lock no-error.
      300            if available utd-lines-attr
      301            then do:
      302               if    iattrval eq ?
      303                  or iattrval eq ""
      304               then do:
      305                  delete utd-lines-attr.
      306               end.
      307               else do:
      308                  utd-lines-attr.attr-value = iattrval.
      309               end.
      310            end.
      311         end.
      312      end.
      313      release utd-lines-attr.
      314   end.
      315   function GetAttrUtdMarkingLinesEx returns char
      316   (idb-num   as integer,
      317    idoc-id   as integer,
      318    ilinenum  as integer,
      319    imark     as character,
      320    iattrcode as character,
      321    iExValue  as character  ):
      322      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      323      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      324                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      325                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      326                                          and utd-marking-lines-attr.mark      eq imark
      327                                          and utd-marking-lines-attr.attr-code eq iattrcode
      328      no-lock no-error.
      329      return if not available utd-marking-lines-attr  then iExValue    else  utd-marking-lines-attr.attr-value.
      330   end.
      331   function GetAttrUtdMarkingLines returns char
      332   (idb-num   as integer,
      333    idoc-id   as integer,
      334    ilinenum  as integer,
      335    imark     as character,
      336    iattrcode as character ):
      337      return GetAttrUtdMarkingLinesEx (idb-num,idoc-id,ilinenum,imark,iattrcode,?).
      338   end.
      339   function setattrUtdMarkingLines returns logical
      340   (idb-num   as integer,
      341    idoc-id   as integer,
      342    ilinenum  as integer,
      343    imark     as character,
      344    iattrcode as character,
      345    iattrval  as character ):
      346      define buffer utd-marking-lines-attr for utd-marking-lines-attr.
      347      find first utd-marking-lines-attr where utd-marking-lines-attr.db-num    eq idb-num
      348                                          and utd-marking-lines-attr.doc-id    eq idoc-id
      349                                          and utd-marking-lines-attr.lineNum   eq ilineNum
      350                                          and utd-marking-lines-attr.mark      eq imark
      351                                          and utd-marking-lines-attr.attr-code eq iattrcode
      352      no-lock no-error.
      353      if not available utd-marking-lines-attr
      354      then do:
      355         if iattrval ne ?
      356            and iattrval ne ""
      357         then do:
      358            create utd-marking-lines-attr.
      359            assign
      360               utd-marking-lines-attr.db-num     = idb-num
      361               utd-marking-lines-attr.doc-id     = idoc-id
      362               utd-marking-lines-attr.lineNum    = ilineNum
      363               utd-marking-lines-attr.mark       = imark
      364               utd-marking-lines-attr.attr-code  = iattrcode
      365               utd-marking-lines-attr.attr-value = iattrval
      366            .
      367         end.
      368      end.
      369      else do:
      370         if utd-marking-lines-attr.attr-value ne iattrval
      371         then do:
      372            find current utd-marking-lines-attr exclusive-lock no-error.
      373            if available utd-marking-lines-attr
      374            then do:
      375               if    iattrval eq ?
      376                  or iattrval eq ""
      377               then do:
      378                  delete utd-marking-lines-attr.
      379               end.
      380               else do:
      381                  utd-marking-lines-attr.attr-value = iattrval.
      382               end.
      383            end.
      384         end.
      385      end.
      386      release utd-marking-lines-attr.
      387   end.
