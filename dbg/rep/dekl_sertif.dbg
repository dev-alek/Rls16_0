      398   define  stream PrnLibStream.
      399   procedure prn-lib-prn-file :
      400     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      401     define input parameter p-DIsabledoptions as integer no-undo .
      402     define variable v-report-name as character no-undo .
      403     define variable v-user-action as character no-undo .
      404     define variable v-printed     as logical   no-undo .
      405     define variable v-exist       as logical   no-undo .
      406     do
      407       on error undo, return error
      408       :
      409       run prn-lib-get-report-name  in this-procedure (
      410         input parParentProc
      411         ,output v-report-name
      412         ).
      413   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      414   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      415     (input  v-report-name
      416     ,input  2
      417     ,output v-exist
      418     )  .
      419       if NOT v-exist then
      420       DO:
      421         Message
      422           "Нет заданий на печать ! "
      423           view-as alert-box .
      424         Return  .
      425       End.
      426       run gbl/prnfilen.w
      427         (input  ""
      428         ,input  p-DisabledOptions
      429         ,input  string(v-report-name )
      430         ,input  7
      431         ,output v-user-action
      432         ,output v-printed
      433         ) .
      434       if v-printed then
      435       do:
      436         return "YES" .
      437       end.
      438       else
      439       do:
      440         return "NO" .
      441       end.
      442     end.
      443   end procedure.
      444   procedure prn-lib-open-stream :
      445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      446     define input parameter p-page-size    as integer no-undo .
      447     define input parameter p-is-stream    as logical no-undo .
      448     define input parameter p-append       as logical no-undo .
      449     define variable v-report-name as character no-undo .
      450     do
      451       on error undo, return error
      452       :
      453       run prn-lib-get-report-name  in this-procedure (
      454         input parParentProc
      455         ,output v-report-name
      456         ).
      457       if p-is-stream then
      458       do:
      459         if p-append then
      460         do:
      461           output stream PrnLibStream to value( v-report-name )
      462             page-size value(p-page-size) append .
      463         end.
      464         if not p-append then
      465         do:
      466           output stream PrnLibStream to value( v-report-name )
      467             page-size value(p-page-size) .
      468         end.
      469       end.
      470       if not p-is-stream then
      471       do:
      472         if p-append then
      473         do:
      474           output to value( v-report-name )
      475             page-size value(p-page-size) append .
      476         end.
      477         if not p-append then
      478         do:
      479           output to value( v-report-name )
      480             page-size value(p-page-size) .
      481         end.
      482       end.
      483     end.
      484   end procedure.
      485   procedure prn-lib-open-exp :
      486     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      487     define input parameter p-is-stream    as logical no-undo .
      488     define input parameter p-is-append    as logical no-undo .
      489     define output parameter p-ReportFileName as char init "report" no-undo.
      490     define output parameter p-process as logical no-undo .
      491     define variable glog as logical no-undo .
      492     do
      493       on error undo, return error
      494       :
      495       SYSTEM-DIALOG GET-FILE p-ReportFileName
      496         TITLE      "Укажите путь"
      497         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      498         ASK-OVERWRITE
      499         CREATE-TEST-FILE
      500         SAVE-AS
      501         USE-FILENAME
      502         DEFAULT-EXTENSION "txt"
      503         UPDATE glog
      504         .
      505       if not glog then  return.
      506       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      507       if p-is-stream then
      508       do:
      509         if p-is-append then
      510         do:
      511           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      512         end.
      513         else
      514         do:
      515           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      516         end.
      517       end.
      518       else
      519       do:
      520         if p-is-append then
      521         do:
      522           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      523         end.
      524         else
      525         do:
      526           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      527         end.
      528       end.
      529       p-process = yes.
      530     end.
      531   end procedure.
      532   procedure prn-lib-get-report-name :
      533     define input parameter parParentProc  as widget-handle no-undo.
      534     define output parameter p-report-name as character no-undo .
      535     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      536   end procedure.
      537   procedure prn-lib-reportviewer-report-name :
      538     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      539     define input parameter p-report-name-html as character no-undo .
      540     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      541   end procedure.
      542   procedure prn-lib-reportviewer :
      543     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      544     define input parameter p-report-name-html as character no-undo .
      545     define input parameter p-param        as character no-undo .
      546     define variable v-excel           as character no-undo init 'TRUE' .
      547     define variable v-value-character as character no-undo .
      548     define variable v-value-integer   as character no-undo .
      549     define variable v-value-date      as date      no-undo .
      550     define variable v-value-decimal   as decimal   no-undo .
      551     define variable rep-excel         as logical   no-undo .
      552     define variable excel-string      as character no-undo .
      553     define variable v-param-type      as character no-undo .
      554     define variable v-tth             as handle    no-undo .
      555     run adm/shattri.p (
      556       input "get":U
      557       ,input  ""
      558       ,input  0
      559       ,input  'report-glob':U
      560       ,input  'rep-excel':U
      561       ,output v-value-character
      562       ,output v-value-date
      563       ,output v-value-decimal
      564       ,output v-value-integer
      565       ,output rep-excel
      566       ,output v-param-type
      567       ,INPUT-OUTPUT table-handle v-tth
      568       )  .
      569     if rep-excel then v-excel = "TRUE" .
      570     else v-excel = "FALSE" .
      571     if p-param eq ""
      572     then
      573        p-param = "EXCEL:" + v-excel.
      574     else
      575        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      576     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      577   end procedure.
      578   function fnc-convert-dot-to-colon returns character
      579       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
      580   function fnc-convert-dot-to-colon returns character
      581   (input p-data as decimal, input p-accur as character, input p-num as integer):
      582       define variable result as character no-undo.
      583       define variable v-str-result as character no-undo.
      584       if p-data = ? then p-data = 0 .
      585       p-data = round(p-data, p-num).
      586       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
      587       return v-str-result.
      588   END FUNCTION.
      589   def var objSrv as class ibs.th.gbl.sys.objsrv no-undo.
      590   run gbl/getobjsrvhndl.p (input-output ObjSrv).
      591   FUNCTION MonthNameRusCase RETURNS CHARACTER ( INPUT i-month AS INTEGER, INPUT i-case AS INTEGER ) :
      592     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      593     RUN get-month-name-case IN THIS-PROCEDURE ( INPUT i-month, INPUT i-case, OUTPUT v-name ) NO-ERROR.
      594     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      595   END FUNCTION.
      596   PROCEDURE get-month-name-case :
      597     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      598     DEFINE  INPUT PARAMETER p-case  AS INTEGER   NO-UNDO.
      599     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      600     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO EXTENT 6 INITIAL
      601       [ "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      602         "января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря",
      603         "Январю,Февралю,Марту,Апрелю,Маю,Июню,Июлю,Августу,Сентябрю,Октябрю,Ноябрю,Декабрю",
      604         "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь",
      605         "Январем,Февралем,Мартом,Апрелем,Маем,Июнем,Июлем,Августом,Сентябрем,Октябрем,Ноябрем,Декабрем",
      606         "Январе,Феврале,Марте,Апреле,Мае,Июне,Июле,Августе,Сентябре,Октябре,Ноябре,Декабре"              ].
      607     DO ON ERROR UNDO, RETURN ERROR :
      608       IF p-month < 1 OR p-month > 12 OR
      609          p-case  < 1 OR p-case  >  6 THEN DO:
      610         ASSIGN p-name = ?.
      611       END.                           ELSE DO:
      612         ASSIGN p-name = ENTRY( p-month, v-list[ p-case ] ).
      613       END.
      614     END.
      615   END PROCEDURE.
      616   define stream Out-Stream.
      617   define stream OutStr-html.
      618   define VARIABLE p-report-id         as character no-undo .
      619   define variable v-file-name-rep-htm as character no-undo .
      620   define variable ii as integer no-undo .
      621   define buffer buf_utd       for ub.utd .
      622   define buffer buf_utd-lines for ub.utd-lines .
      623   define buffer buf_clients   for ub.clients .
      624   FUNCTION GdsName RETURNS CHARACTER
      625     ( input p-gds-code as integer)  FORWARD.
      626   FUNCTION CliName RETURNS CHARACTER
      627     (input p-cli-code as integer, input p-cli-type as character)  FORWARD.
      628   FUNCTION get-DD-Month-YYYY RETURNS CHARACTER
      629     ( input p-dat-date as date)  FORWARD.
      630   define temp-table tt-sert-lines no-undo
      631     field doc-id   as integer
      632     field db-num   as integer
      633     field gds-name as character
      634     field gds-code as integer
      635     field gds-TH   as character
      636     field sertif   as character
      637     field linenum  as integer
      638     field rowspan  as integer
      639     index pi doc-id db-num gds-code linenum
      640     .
      641   do
      642     on error undo, return error return-value
      643     :
      644     for each tt-sert-utd:
      645     find first buf_utd no-lock where buf_utd.doc-id = tt-sert-utd.doc-id and buf_utd.db-num = tt-sert-utd.db-num no-error .
      646     if not available (buf_utd) then
      647     do:
      648       message "УПД не найден"
      649         view-as alert-box.
      650       return .
      651     end.
      652     for each buf_utd-lines no-lock where buf_utd-lines.doc-id = buf_utd.doc-id and buf_utd-lines.db-num = buf_utd.db-num:
      653       create tt-sert-lines .
      654       assign
      655         tt-sert-lines.db-num   = buf_utd-lines.db-num
      656         tt-sert-lines.doc-id   = buf_utd-lines.doc-id
      657         tt-sert-lines.linenum  = buf_utd-lines.LineNum
      658         tt-sert-lines.gds-code = buf_utd-lines.gds-code
      659         tt-sert-lines.gds-name = buf_utd-lines.ProductCode
      660         .
      661       tt-sert-lines.sertif = GetAttrUtdlines(buf_utd-lines.db-num,buf_utd-lines.doc-id,buf_utd-lines.linenum,"doc_sertif").
      662       tt-sert-lines.gds-TH = GdsName(buf_utd-lines.gds-code) .
      663       tt-sert-lines.rowspan = if tt-sert-lines.sertif <> ? then num-entries(tt-sert-lines.sertif,chr(4)) else 1.
      664     end.
      665     end.
      666     run get-report-num (output p-report-id).
      667     v-file-name-rep-htm = session:temp-directory + string(p-report-id) + ".html".
      668     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8'.
      669     put stream OutStr-html unformatted
      670   "<!DOCTYPE HTML>" skip
      671   ' <html>' skip
      672   '  <head>' skip
      673   '   <meta charset="utf-8">' skip
      674   '    <style type="text/css">' skip
      675   '      table ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      676   '      .class1 ' + chr(123) + ' border-collapse: collapse; ' + chr(125) skip
      677   '      tbody td, th ' + chr(123) + ' border-collapse: collapse; border: 1px solid black;' + chr(125) skip
      678   '   </style>' skip
      679   '  </head>' skip
      680       .
      681     for each tt-sert-utd:
      682         put stream OutStr-html unformatted
      683           '<body>' skip
      684           '<TABLE name="sertif"  fit_to_page="true" orientation="landscape" CELLSPACING="0" BORDER="0">'skip
      685           '<thead>' skip
      686           .
      687         put stream OutStr-html unformatted
      688           '<tr class="set_columns">' skip
      689           '<td style="width: 50px;"></td>' skip
      690           '<td style="width: 100px;"></td>' skip
      691           '<td style="width: 350px;"></td>' skip
      692           '<td style="width: 450px;"></td>' skip
      693           '</tr>' skip
      694           '<tr><td colspan="4">УПД ' + string(tt-sert-utd.DocumentNumber) + ' от ' + string(tt-sert-utd.DocumentDate,"99.99.9999") + '</td></tr>'
      695           '<tr>' skip
      696           '<td colspan="4">' + CliName(tt-sert-utd.cli-code, tt-sert-utd.cli-type) + '</td>' skip
      697           '</tr>' skip
      698           .
      699         put stream OutStr-html unformatted
      700           '<TR><TD colspan="4"></TD></TR>' skip
      701           '</thead>' skip
      702           '<tbody>' skip
      703           .
      704         put stream OutStr-html unformatted
      705           '<TR>' skip
      706           '<TD text_wrap="true" style="text-align: center; font-weight: bold;">№ п/п</TD>' skip
      707           '<TD text_wrap="true" style="text-align: left; font-weight: bold;">Код товара</TD>' skip
      708           '<TD text_wrap="true" style="text-align: left; font-weight: bold;">Наименование ТН</TD>' skip
      709           '<TD text_wrap="true" style="text-align: left; font-weight: bold;">Сертификат/Декларация</TD>' skip
      710           '</TR>' skip .
      711         ii = 0 .
      712         for each tt-sert-lines no-lock where tt-sert-lines.db-num = tt-sert-utd.db-num and
      713           tt-sert-lines.doc-id = tt-sert-utd.doc-id by tt-sert-lines.linenum by tt-sert-lines.rowspan:
      714           put stream OutStr-html unformatted
      715             '<TR>' skip
      716             '<TD text_wrap="true" rowspan="' + string(tt-sert-lines.rowspan)+ '" style="text-align: center;">' + if tt-sert-lines.linenum <> ? then string(tt-sert-lines.linenum) + '</TD>' else ""  + '</TD>' skip
      717             '<TD text_wrap="true" rowspan="' + string(tt-sert-lines.rowspan)+ '" style="text-align: left;">' + if tt-sert-lines.gds-code <> ? then string(tt-sert-lines.gds-code) + '</TD>' else ""  + '</TD>' skip
      718             '<TD text_wrap="true"  rowspan="' + string(tt-sert-lines.rowspan)+ '"style="text-align: left;">' + if tt-sert-lines.gds-TH <> ? then string (tt-sert-lines.gds-TH) + '</TD>' else ""  + '</TD>' skip
      719             .
      720           do ii = 1 to tt-sert-lines.rowspan:
      721             if ii > 1 then
      722             do:
      723               put stream OutStr-html unformatted
      724                 '<TR>'.
      725             end.
      726             put stream OutStr-html unformatted
      727               '<TD text_wrap="true" style="text-align: left;">' + if tt-sert-lines.sertif <> ? then entry(ii,tt-sert-lines.sertif,chr(4)) + '</TD>' else ""  + '</TD>' skip
      728               .
      729             put stream OutStr-html unformatted
      730               '</TR>'.
      731           end.
      732         end.
      733         put stream OutStr-html unformatted
      734           '</tbody>' skip
      735           '<tfoot>' skip
      736           '</tfoot>' skip
      737           '</table>' skip
      738           '</body>' skip .
      739         put stream OutStr-html unformatted
      740           '</html>' skip
      741           .
      742     end.
      743   output stream OutStr-html close.
      744     end.
      745   run prn-lib-reportviewer in this-procedure (
      746     input this-procedure
      747     ,input v-file-name-rep-htm
      748     ,input ""
      749     ) no-error.
      750   if error-status:error then
      751   do:
      752     message return-value view-as alert-box.
      753     return .
      754   end.
      755   function get-DD-Month-YYYY returns character
      756     (input p-dat-date as date):
      757     define variable v-str-date  as character no-undo.
      758     define variable v-str-day   as character no-undo.
      759     define variable v-num-month as character no-undo.
      760     define variable v-str-month as character no-undo.
      761     define variable v-str-year  as character no-undo.
      762     v-str-date = string(p-dat-date).
      763     do:
      764       v-str-day = string(entry(1, v-str-date, "/")).
      765     end.
      766     do:
      767       v-num-month = entry(2, v-str-date, "/").
      768       v-str-month = MonthNameRusCase(integer(v-num-month), 2).
      769     end.
      770     do:
      771       v-str-year = string(year(p-dat-date)).
      772     end.
      773     return '" ' + v-str-day + ' "' + " " + v-str-month + " " + v-str-year + " г.".
      774   end function.
      775   FUNCTION GdsName RETURNS CHARACTER
      776     ( input p-gds-code as integer) :
      777     define variable v-gds-name as character no-undo .
      778     define buffer buf_goods for ub.goods .
      779     find first buf_goods no-lock where buf_goods.gds-code = p-gds-code no-error .
      780     if available (buf_goods) then v-gds-name = buf_goods.gds-name .
      781     RETURN v-gds-name.
      782   END FUNCTION.
      783   FUNCTION CliName RETURNS CHARACTER
      784     (input p-cli-code as integer, input p-cli-type as character) :
      785     define variable v-cli-name as character no-undo .
      786     find first buf_clients no-lock where buf_clients.obj-code = p-cli-code
      787       and buf_clients.obj-type = p-cli-type no-error .
      788     if available (buf_clients) then v-cli-name = buf_clients.obj-name .
      789     RETURN v-cli-name.
      790   END FUNCTION.
      791   PROCEDURE get-report-num :
      792       define output parameter p-report-num as integer no-undo .
      793       do
      794           on error undo, return error return-value
      795           :
      796           run gbl/getrpnum.p (output p-report-num).
      797       end.
      798   END PROCEDURE.
