     1021   .
     1022   define variable v-km7xl-current-data-row     as integer      no-undo.
     1023   define variable v-km7xl-cell-file-name       as character    no-undo.
     1024   define variable v-km7xl-data-file-name       as character    no-undo.
     1025   procedure km7xl-init :
     1026       define buffer buf_temp_cell-data        for temp_cell-data.
     1027       define buffer buf_usr-flt               for ubflt.usr-flt.
     1028   do
     1029   for buf_temp_cell-data
     1030     , buf_usr-flt
     1031   on error undo, return error
     1032   :
     1033       assign
     1034           v-km7xl-current-data-row = 0
     1035       .
     1036       run gbl/_tmpfile.p (
     1037             input "xd"
     1038           , input ".txt"
     1039           , output v-km7xl-data-file-name
     1040       ).
     1041       output stream excel-line to value( v-km7xl-data-file-name ).
     1042       run gbl/_tmpfile.p (
     1043             input "xc"
     1044           , input ".txt"
     1045           , output v-km7xl-cell-file-name
     1046       ).
     1047       output stream excel-cell to value( v-km7xl-cell-file-name ).
     1048       if printrubl = yes
     1049       then do:
     1050           run km7xl-write-cell-data in this-procedure (
     1051                 input "valutCode":U
     1052               , input "0":U
     1053           ).
     1054       end.
     1055       else do:
     1056           run km7xl-write-cell-data in this-procedure (
     1057                 input "valutCode":U
     1058               , input "1":U
     1059           ).
     1060       end.
     1061       run km7xl-write-cell-data in this-procedure (
     1062             input "columnList":U
     1063           , input "desk,kkmprod,kkmreg,z":U
     1064       ).
     1065       run km7xl-write-cell-data in this-procedure (
     1066               input "columnType":U
     1067             , input "I,S,S,I":U
     1068       ).
     1069       run km7xl-write-cell-data in this-procedure (
     1070             input "columnAmount":U
     1071           , input "4":U
     1072       ).
     1073   end.
     1074   end procedure.
     1075   procedure km7xl-close :
     1076   do
     1077   on error undo, return error
     1078   :
     1079       output stream excel-line close.
     1080       output stream excel-cell close.
     1081       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1082           export "exe/km7_97.xlt":U.
     1083           export "exe/t_97.bas":U.
     1084           export v-km7xl-cell-file-name.
     1085           export v-km7xl-data-file-name.
     1086       output close.
     1087   end.
     1088   end procedure.
     1089   procedure km7xl-write-cell-data :
     1090   define input parameter p-data-key   as character        no-undo.
     1091   define input parameter p-data-value as character        no-undo.
     1092       define buffer buf_temp_cell-data     for temp_cell-data.
     1093   do
     1094   for buf_temp_cell-data
     1095   on error undo, return error
     1096   :
     1097       find first buf_temp_cell-data
     1098            where buf_temp_cell-data.data-key = p-data-key
     1099       no-error.
     1100       if not available buf_temp_cell-data
     1101       then do:
     1102           create buf_temp_cell-data.
     1103           assign
     1104               buf_temp_cell-data.data-key = p-data-key
     1105           .
     1106       end.
     1107       assign
     1108           buf_temp_cell-data.data-value = p-data-value
     1109       .
     1110       put stream excel-cell unformatted
     1111                           buf_temp_cell-data.data-key
     1112           CHR(9)   buf_temp_cell-data.data-value
     1113           chr(10)
     1114       .
     1115   end.
     1116   end procedure.
     1117   procedure km7xl-write-line-data :
     1118   define input parameter p-d_desk      as integer          no-undo.
     1119   define input parameter p-d_kkm_prod  as character        no-undo.
     1120   define input parameter p-d_kkm_reg   as character        no-undo.
     1121   define input parameter p-d_z         as character        no-undo.
     1122   define buffer buf_temp_line-data        for temp_line-data.
     1123   do
     1124   for buf_temp_line-data
     1125   on error undo, return error
     1126   :
     1127       for each buf_temp_line-data
     1128       :
     1129           delete buf_temp_line-data.
     1130       end.
     1131       create buf_temp_line-data.
     1132       assign
     1133           v-km7xl-current-data-row = v-km7xl-current-data-row + 1
     1134       .
     1135       assign
     1136           buf_temp_line-data.data-key    = "LD":U
     1137           buf_temp_line-data.xl-line-id  = v-km7xl-current-data-row
     1138           buf_temp_line-data.d_desk      = p-d_desk
     1139           buf_temp_line-data.d_kkm_prod  = p-d_kkm_prod
     1140           buf_temp_line-data.d_kkm_reg   = p-d_kkm_reg
     1141           buf_temp_line-data.d_z         = p-d_z
     1142       .
     1143       put stream excel-line unformatted
     1144                           buf_temp_line-data.data-key
     1145           CHR(9)   buf_temp_line-data.d_desk
     1146           CHR(9)   buf_temp_line-data.d_kkm_prod
     1147           CHR(9)   buf_temp_line-data.d_kkm_reg
     1148           CHR(9)   buf_temp_line-data.d_z
     1149           chr(10)
     1150       .
     1151   end.
     1152   end procedure.
     1153   procedure km7xl-run-excel :
     1154   define input parameter p-header-filename    as character        no-undo.
     1155   define input parameter p-data-filename      as character        no-undo.
     1156       define variable v-template-file-name    as character    no-undo.
     1157       define variable v-vb-file-name          as character    no-undo.
     1158       define buffer buf_temp-param for temp-param .
     1159   do
     1160   for buf_temp-param
     1161   on error undo, return error
     1162   :
     1163       create buf_temp-param.
     1164       assign
     1165           v-template-file-name    = search( "exe/km7_97.xlt" )
     1166           v-vb-file-name          = search( "exe/t_97.bas")
     1167       .
     1168       if v-template-file-name = ?
     1169       or v-template-file-name = "":U
     1170       then do:
     1171           message
     1172               "Ошибка имени файла шаблона."
     1173           view-as alert-box error.
     1174       end.
     1175       if v-vb-file-name = ?
     1176       or v-vb-file-name = "":U
     1177       then do:
     1178           message
     1179               "Ошибка имени файла кода обработки."
     1180           view-as alert-box error.
     1181       end.
     1182       run paramls-write in this-procedure (
     1183             input "template":U
     1184           , input "template-file-name":U
     1185           , input v-template-file-name
     1186       ).
     1187       run paramls-write in this-procedure (
     1188             input "template":U
     1189           , input "vb-file-name":U
     1190           , input v-vb-file-name
     1191       ).
     1192       run paramls-write in this-procedure (
     1193             input "data":U
     1194           , input "data-header-filename":U
     1195           , input p-header-filename
     1196       ).
     1197       run paramls-write in this-procedure (
     1198             input "data":U
     1199           , input "data-filename":U
     1200           , input p-data-filename
     1201       ).
     1202       run gbl/macroxlt.p (
     1203           input-output table buf_temp-param
     1204       ) no-error.
     1205       if error-status :error
     1206       then do:
     1207           message
     1208                    vss-workfile vss-revision vss-description
     1209               skip(1)
     1210               skip "Ошибка создания файла Excel."
     1211               skip return-value
     1212               skip trim(error-status :get-message(1))
     1213                    trim(error-status :get-message(2))
     1214                    trim(error-status :get-message(3))
     1215           view-as alert-box error.
     1216           undo, return error .
     1217       end.
     1218   end.
     1219   end procedure.
     1220   define new global shared variable g#lib-trn  as handle no-undo .
     1221   define new global shared variable g#lib-trn2 as handle no-undo .
     1222   define new global shared variable g#lib-trn3 as handle no-undo .
     1223   define new global shared variable g#lib-trn4 as handle no-undo .
     1224     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1225       define variable v-answ as logical no-undo .
     1226       if ( p-unit-base-cli-eq = true
     1227            and p-density = 1.0
     1228          )
     1229         or ( p-unit-base-cli-eq = false
     1230              and p-density <> ?
     1231              and p-density > 0.0
     1232              and p-density < 1.0
     1233            )
     1234       then do:
     1235         assign
     1236           v-answ = true
     1237         .
     1238       end.
     1239       else do:
     1240         assign
     1241           v-answ = false
     1242         .
     1243       end.
     1244       return v-answ.
     1245     end function.
