     5730         sym10                   no-label format "X(1)"            space(0)
     5731         empty-str09-10          no-label format "x(9)"            space(0)
     5732         sym11                   no-label format "X(1)"            space(0)
     5733         empty-str15-11          no-label format "x(11)"           space(0)
     5734         sym12                   no-label format "X(1)"            space(0)
     5735         empty-str09-12          no-label format "x(9)"            space(0)
     5736         sym13                   no-label format "X(1)"            space(0)
