      190   def
      191    shared
      192   temp-table  obj-list no-undo
      193     field obj-type like ub.clients.obj-type
      194     field obj-code like ub.clients.obj-code
      195     field obj-name like ub.clients.obj-name
      196     field obj-id   as integer
      197     field db-num   as integer
