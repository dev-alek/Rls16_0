     5738         sym14                   no-label format "X(1)"            space(0)
     5739         empty-str09-14          no-label format "x(9)"            space(0)
     5740         sym15                   no-label format "X(1)"            space(0)
     5741        HEADER
     5742   "+---------------------------------------+----------+--------------------------------------------------------+------------------+-----------------------------------------------------------------+" skip
