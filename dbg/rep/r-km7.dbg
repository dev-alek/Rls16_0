      200     index ie2 obj-name
      201   .
      202   procedure create_obj-list :
      203      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      204      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      205      do
      206      on error undo, return error return-value
      207      :
      208         define buffer cli-obj for ub.clients .
      209         define variable p-var as integer no-undo .
      210         define buffer buf_obj-list for obj-list .
      211         find last buf_obj-list  use-index pi no-error .
      212         if available buf_obj-list
      213         then
      214            p-var = buf_obj-list.obj-id + 1.
      215         else
      216            p-var = 1.
      217         find first cli-obj where
      218                   cli-obj.obj-type = p-obj-type
      219               and cli-obj.obj-code = p-obj-code
      220         no-lock no-error.
      221         if available cli-obj
      222         then do:
      223            create buf_obj-list.
      224            assign
      225               buf_obj-list.obj-id   = p-var
      226               buf_obj-list.obj-code = cli-obj.obj-code
      227               buf_obj-list.obj-type = cli-obj.obj-type
      228               buf_obj-list.obj-name = cli-obj.obj-name
      229               buf_obj-list.db-num   = cli-obj.db-num
      230            .
      231         end.
      232      end.
      233   end.
