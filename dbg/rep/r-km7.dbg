     5413               .
     5414            end.
     5415            if v-torgconf-outogr = "dir_obj"
     5416               then do:
     5417               find first buf_wth-doc no-lock
     5418               where buf_wth-doc.doc-code = p-doc-code
     5419               no-error.
     5420                  find first buf_shop no-lock
     5421                  where buf_shop.obj-code = buf_wth-doc.obj-code
     5422                  .
     5423                  assign
     5424                     v-torgconf-ogr-name = buf_shop.director
     5425                     v-torgconf-ogr-post = "Директор"
     5426                  .
     5427               end.
     5428         if v-torgconf-outogr = "manag_doc"
     5429            then do:
     5430               find first buf_wth-doc no-lock
     5431               where buf_wth-doc.doc-code = p-doc-code
     5432               no-error.
     5433               if available buf_wth-doc
     5434               then do:
     5435                  run rep/get-psn.p
     5436                  (input buf_wth-doc.deliver
     5437                  ,output v-torgconf-ogr-name
     5438                  ) .
     5439               end.
     5440               find first buf_person no-lock
     5441               where buf_person.psn-code = buf_wth-doc.deliver
     5442               no-error.
     5443               if available buf_person
     5444               then do:
     5445                  v-torgconf-ogr-post = buf_person.position.
     5446               end.
     5447               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5448               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5449            end.
     5450      end.
     5451   end.
     5452   end procedure.
     5453   procedure torgconf-get-outogr-param:
     5454       define input parameter p-form-name  as character    no-undo.
     5455       define input parameter p-host-code  as integer      no-undo.
     5456       define input parameter p-obj-type   as character    no-undo.
     5457       define input parameter p-obj-code   as integer      no-undo.
     5458       define input parameter p-doc-code   as character      no-undo.
     5459       define buffer buf_firm          for ub.firm .
     5460       define buffer buf_clients       for ub.clients .
     5461       define buffer buf_sysconf       for ub.sysconf .
     5462       define buffer buf_shop          for ub.shop .
     5463       define buffer buf_store         for ub.store .
     5464       define buffer buf_person        for ub.person .
     5465       define buffer buf_trn-doc       for ub.trn-doc .
     5466       define buffer buf_wth-doc       for ub.wth-doc .
     5467      if  p-form-name <> 'wthtrg12':U
     5468      and p-form-name <> 'wthfct':U
     5469      and p-form-name <> 'wthm11':U
     5470      then do:
     5471       find first buf_trn-doc no-lock
     5472       where buf_trn-doc.doc-code = p-doc-code
     5473       no-error.
     5474       if v-torgconf-outogr = "no_print"
     5475         then do:
     5476            assign
     5477               v-torgconf-ogr-name = ""
     5478               v-torgconf-ogr-post = ""
     5479            .
     5480         end.
     5481      if v-torgconf-outogr  = "ruk_firm"
     5482            then do:
     5483            find first buf_sysconf no-lock
     5484            where buf_sysconf.host-code = p-host-code
     5485            no-error.
     5486            if available buf_sysconf
     5487            then do:
     5488               assign
     5489                  v-torgconf-ogr-post = buf_sysconf.head-position
     5490               .
     5491            end.
     5492            find first buf_clients no-lock
     5493                where buf_clients.obj-type = 'орг':U
     5494                and buf_clients.obj-code = p-host-code
     5495            .
     5496            find first buf_firm no-lock
     5497                where buf_firm.firm-code = buf_clients.obj-code
     5498            .
     5499            assign
     5500                v-torgconf-ogr-name = buf_firm.director
     5501            .
     5502         end.
     5503         if v-torgconf-outogr = "dir_obj"
     5504            then do:
     5505            find first buf_trn-doc no-lock
     5506            where buf_trn-doc.doc-code = p-doc-code
     5507            no-error.
     5508               CASE buf_trn-doc.obj-type:
     5509               WHEN 'маг':U
     5510               THEN DO:
     5511                  find first buf_shop no-lock
     5512                  where buf_shop.obj-code = buf_trn-doc.obj-code
     5513                  .
     5514                  assign
     5515                     v-torgconf-ogr-name = buf_shop.director
     5516                     v-torgconf-ogr-post = "Директор"
     5517                  .
     5518               END.
     5519               WHEN 'скл':U
     5520               THEN DO:
     5521                  find first buf_store no-lock
     5522                  where buf_store.obj-code = buf_trn-doc.obj-code
     5523                  .
     5524                  assign
     5525                     v-torgconf-ogr-name = buf_store.store-boss
     5526                     v-torgconf-ogr-post = "Директор"
     5527                  .
     5528               END.
     5529               OTHERWISE DO:
     5530                  assign
     5531                     v-torgconf-ogr-name = "":U
     5532                     v-torgconf-ogr-post = "":U
     5533                  .
     5534               END.
     5535               END CASE.
     5536            end.
     5537      if v-torgconf-outogr = "manag_doc"
     5538         then do:
     5539            find first buf_trn-doc no-lock
     5540            where buf_trn-doc.doc-code = p-doc-code
     5541            no-error.
     5542            if available buf_trn-doc
     5543            then do:
     5544               run rep/get-psn.p
     5545               (input buf_trn-doc.boss
     5546               ,output v-torgconf-ogr-name
     5547               ) .
     5548            end.
     5549            find first buf_person no-lock
     5550            where buf_person.psn-code = buf_trn-doc.boss
     5551            no-error.
     5552            if available buf_person
     5553            then do:
     5554               v-torgconf-ogr-post = buf_person.position.
     5555            end.
     5556            if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5557            if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5558         end.
     5559      end.
     5560      else do:
     5561      find first buf_wth-doc no-lock
     5562         where buf_wth-doc.doc-code = p-doc-code
     5563         no-error.
     5564         if v-torgconf-outogr = "no_print"
     5565            then do:
     5566               assign
     5567                  v-torgconf-ogr-name = ""
     5568                  v-torgconf-ogr-post = ""
     5569               .
     5570            end.
     5571         if v-torgconf-outogr  = "ruk_firm"
     5572               then do:
     5573               find first buf_sysconf no-lock
     5574               where buf_sysconf.host-code = p-host-code
     5575               no-error.
     5576               if available buf_sysconf
     5577               then do:
     5578                  assign
     5579                     v-torgconf-ogr-post = buf_sysconf.head-position
     5580                  .
     5581               end.
     5582               find first buf_clients no-lock
     5583                  where buf_clients.obj-type = 'орг':U
     5584                  and buf_clients.obj-code = p-host-code
     5585               .
     5586               find first buf_firm no-lock
     5587                  where buf_firm.firm-code = buf_clients.obj-code
     5588               .
     5589               assign
     5590                  v-torgconf-ogr-name = buf_firm.director
     5591               .
     5592            end.
     5593            if v-torgconf-outogr = "dir_obj"
     5594               then do:
     5595               find first buf_wth-doc no-lock
     5596               where buf_wth-doc.doc-code = p-doc-code
     5597               no-error.
     5598                  find first buf_shop no-lock
     5599                  where buf_shop.obj-code = buf_wth-doc.obj-code
     5600                  .
     5601                  assign
     5602                     v-torgconf-ogr-name = buf_shop.director
     5603                     v-torgconf-ogr-post = "Директор"
     5604                  .
     5605               end.
     5606         if v-torgconf-outogr = "manag_doc"
     5607            then do:
     5608               find first buf_wth-doc no-lock
     5609               where buf_wth-doc.doc-code = p-doc-code
     5610               no-error.
     5611               if available buf_wth-doc
     5612               then do:
     5613                  run rep/get-psn.p
     5614                  (input buf_wth-doc.deliver
     5615                  ,output v-torgconf-ogr-name
     5616                  ) .
     5617               end.
     5618               find first buf_person no-lock
     5619               where buf_person.psn-code = buf_wth-doc.deliver
     5620               no-error.
     5621               if available buf_person
     5622               then do:
     5623                  v-torgconf-ogr-post = buf_person.position.
     5624               end.
     5625               if v-torgconf-ogr-name = "?":U then v-torgconf-ogr-name = "".
     5626               if v-torgconf-ogr-post = ? then  v-torgconf-ogr-post = "".
     5627            end.
     5628      end.
     5629   end.
     5630   procedure torgconf-get-reason  :
     5631   define input parameter  p-doc-code       as character        no-undo.
     5632   define input parameter  p-reason-code    as integer          no-undo .
     5633   define input parameter  p-doc-type       as character        no-undo.
     5634       if p-reason-code > 0
     5635       then do:
     5636           define buffer buf_trn-reason for ub.trn-reason.
     5637           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     5638           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     5639       end.
     5640       else do:
     5641           if p-doc-type = 'при':U
     5642           then  do:
     5643               define variable v-attr-type     as character    no-undo.
     5644               define variable v-attr-value    as character    no-undo.
     5645               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     5646               assign v-torgconf-reason = v-attr-value .
     5647               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     5648               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     5649           end.
     5650       end.
     5651   end procedure.
