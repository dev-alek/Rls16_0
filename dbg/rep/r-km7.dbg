     1786   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1787   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1788   define  stream PrnLibStream.
     1789   procedure prn-lib-prn-file :
     1790     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1791     define input parameter p-DIsabledoptions as integer no-undo .
     1792     define variable v-report-name as character no-undo .
     1793     define variable v-user-action as character no-undo .
     1794     define variable v-printed     as logical   no-undo .
     1795     define variable v-exist       as logical   no-undo .
     1796     do
     1797       on error undo, return error
     1798       :
     1799       run prn-lib-get-report-name  in this-procedure (
     1800         input parParentProc
     1801         ,output v-report-name
     1802         ).
     1803   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1805     (input  v-report-name
     1806     ,input  2
     1807     ,output v-exist
     1808     )  .
     1809       if NOT v-exist then
     1810       DO:
     1811         Message
     1812           "Нет заданий на печать ! "
     1813           view-as alert-box .
     1814         Return  .
     1815       End.
     1816       run gbl/prnfilen.w
     1817         (input  ""
     1818         ,input  p-DisabledOptions
     1819         ,input  string(v-report-name )
     1820         ,input  7
     1821         ,output v-user-action
     1822         ,output v-printed
     1823         ) .
     1824       if v-printed then
     1825       do:
     1826         return "YES" .
     1827       end.
     1828       else
     1829       do:
     1830         return "NO" .
     1831       end.
     1832     end.
     1833   end procedure.
     1834   procedure prn-lib-open-stream :
     1835     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1836     define input parameter p-page-size    as integer no-undo .
     1837     define input parameter p-is-stream    as logical no-undo .
     1838     define input parameter p-append       as logical no-undo .
     1839     define variable v-report-name as character no-undo .
     1840     do
     1841       on error undo, return error
     1842       :
     1843       run prn-lib-get-report-name  in this-procedure (
     1844         input parParentProc
     1845         ,output v-report-name
     1846         ).
     1847       if p-is-stream then
     1848       do:
     1849         if p-append then
     1850         do:
     1851           output stream PrnLibStream to value( v-report-name )
     1852             page-size value(p-page-size) append .
     1853         end.
     1854         if not p-append then
     1855         do:
     1856           output stream PrnLibStream to value( v-report-name )
     1857             page-size value(p-page-size) .
     1858         end.
     1859       end.
     1860       if not p-is-stream then
     1861       do:
     1862         if p-append then
     1863         do:
     1864           output to value( v-report-name )
     1865             page-size value(p-page-size) append .
     1866         end.
     1867         if not p-append then
     1868         do:
     1869           output to value( v-report-name )
     1870             page-size value(p-page-size) .
     1871         end.
     1872       end.
     1873     end.
     1874   end procedure.
     1875   procedure prn-lib-open-exp :
     1876     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1877     define input parameter p-is-stream    as logical no-undo .
     1878     define input parameter p-is-append    as logical no-undo .
     1879     define output parameter p-ReportFileName as char init "report" no-undo.
     1880     define output parameter p-process as logical no-undo .
     1881     define variable glog as logical no-undo .
     1882     do
     1883       on error undo, return error
     1884       :
     1885       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1886         TITLE      "Укажите путь"
     1887         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1888         ASK-OVERWRITE
     1889         CREATE-TEST-FILE
     1890         SAVE-AS
     1891         USE-FILENAME
     1892         DEFAULT-EXTENSION "txt"
     1893         UPDATE glog
     1894         .
     1895       if not glog then  return.
     1896       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1897       if p-is-stream then
     1898       do:
     1899         if p-is-append then
     1900         do:
     1901           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1902         end.
     1903         else
     1904         do:
     1905           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1906         end.
     1907       end.
     1908       else
     1909       do:
     1910         if p-is-append then
     1911         do:
     1912           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1913         end.
     1914         else
     1915         do:
     1916           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1917         end.
     1918       end.
     1919       p-process = yes.
     1920     end.
     1921   end procedure.
     1922   procedure prn-lib-get-report-name :
     1923     define input parameter parParentProc  as widget-handle no-undo.
     1924     define output parameter p-report-name as character no-undo .
     1925     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1926   end procedure.
     1927   procedure prn-lib-reportviewer-report-name :
     1928     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1929     define input parameter p-report-name-html as character no-undo .
     1930     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1931   end procedure.
     1932   procedure prn-lib-reportviewer :
     1933     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1934     define input parameter p-report-name-html as character no-undo .
     1935     define input parameter p-param        as character no-undo .
     1936     define variable v-excel           as character no-undo init 'TRUE' .
     1937     define variable v-value-character as character no-undo .
     1938     define variable v-value-integer   as character no-undo .
     1939     define variable v-value-date      as date      no-undo .
     1940     define variable v-value-decimal   as decimal   no-undo .
     1941     define variable rep-excel         as logical   no-undo .
     1942     define variable excel-string      as character no-undo .
     1943     define variable v-param-type      as character no-undo .
     1944     define variable v-tth             as handle    no-undo .
     1945     run adm/shattri.p (
     1946       input "get":U
     1947       ,input  ""
     1948       ,input  0
     1949       ,input  'report-glob':U
     1950       ,input  'rep-excel':U
     1951       ,output v-value-character
     1952       ,output v-value-date
     1953       ,output v-value-decimal
     1954       ,output v-value-integer
     1955       ,output rep-excel
     1956       ,output v-param-type
     1957       ,INPUT-OUTPUT table-handle v-tth
     1958       )  .
     1959     if rep-excel then v-excel = "TRUE" .
     1960     else v-excel = "FALSE" .
     1961     if p-param eq ""
     1962     then
     1963        p-param = "EXCEL:" + v-excel.
     1964     else
     1965        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1966     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1967   end procedure.
     1968   procedure reprumpr_print-plain-text :
     1969   define input parameter p-dir-name as character no-undo .
     1970   define input parameter p-subdir-name as character no-undo .
     1971   define input parameter p-custom-name as character no-undo .
     1972   define input parameter p-disable-option as integer no-undo .
     1973   define input parameter p-font-number as integer no-undo .
     1974   define variable v-file-name as character no-undo .
     1975   define variable v-report-name as character no-undo .
     1976   define variable v-err-status as integer no-undo .
     1977   define variable v-err-mess as character no-undo .
     1978   v-file-name = p-dir-name + (if p-subdir-name <> ''
     1979                               then (p-subdir-name + chr(47))
     1980                               else '') +
     1981                 p-custom-name.
     1982   run prn-lib-get-report-name  in this-procedure (
     1983                                                     input parParentProc
     1984                                                     ,output v-report-name
     1985                                                   ).
     1986   os-copy
     1987   value(v-report-name)
     1988   value(v-file-name)
     1989   .
     1990   assign
     1991   v-err-status = os-error
     1992   .
     1993   if v-err-status <> 0 then do:
     1994     run gbl/os-errnm.p ( input v-err-status
     1995                         ,output v-err-mess).
     1996     return error v-err-mess.
     1997   end.
     1998   else do:
     1999     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     2000                                                   ,input p-report-id
     2001                                                   ,input 'text':U
     2002                                                   ,input v-file-name
     2003                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     2004                                                   ).
     2005   end.
     2006   end procedure.
     2007   procedure reprumpr_print-printer :
     2008   define input parameter p-font-number as integer no-undo .
     2009   define input parameter p-flags as integer no-undo .
     2010   define variable v-quest-print as logical no-undo .
     2011   define variable lok as logical no-undo .
     2012   define variable v-report-name as character no-undo .
     2013   run get-quest-print in parparentproc ( output v-quest-print) .
     2014   if not v-quest-print then do:
     2015       .
     2016     run prn-lib-get-report-name  in this-procedure (
     2017                                                       input parParentProc
     2018                                                      ,output v-report-name
     2019                                                     ).
     2020     run adecomm/_osprint.p
     2021       (input  ?
     2022       ,input  v-report-name
     2023       ,input  p-font-number
     2024       ,input  p-flags
     2025       ,input  0
     2026       ,input  0
     2027       ,output lok
     2028       ).
     2029     if not lok then do:
     2030     end.
     2031   end.
     2032   end procedure.
     2033   define stream temp-stream.
     2034   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2035   procedure prnexldl_clear:
     2036   define input parameter p-txl-file-name as character no-undo .
     2037   define variable v-template-file-name as character no-undo .
     2038   define variable v-vb-file-name as character no-undo .
     2039   define variable v-data-header-filename as character no-undo .
     2040   define variable v-data-filename as character no-undo .
     2041   if search( p-txl-file-name ) <> ? then do:
     2042     input stream temp-stream from value( p-txl-file-name ).
     2043     repeat
     2044     :
     2045         import stream temp-stream v-template-file-name   .
     2046         import stream temp-stream v-vb-file-name         .
     2047         import stream temp-stream v-data-header-filename .
     2048         os-delete value(v-data-header-filename).
     2049         import stream temp-stream v-data-filename        .
     2050         os-delete value(v-data-filename).
     2051     end.
     2052     input stream temp-stream close.
     2053     os-delete value( p-txl-file-name ).
     2054   end.
     2055   end procedure .
     2056   define stream reprumpr_in.
     2057   procedure reprumpr_print-xlt :
     2058   define input parameter p-dir-name as character no-undo .
     2059   define input parameter p-subdir-name as character no-undo .
     2060   define input parameter p-custom-name as character no-undo .
     2061   define input parameter p-disable-option as integer no-undo .
     2062   define input parameter p-font-number as integer no-undo .
     2063   define buffer buf_temp-param for temp-param .
     2064   define variable v-report-num            as integer no-undo .
     2065   define variable v-filename              as character    no-undo .
     2066   define variable v-obj-dir               as character    no-undo .
     2067   define variable v-report-filename       as character    no-undo .
     2068   define variable v-home-dir-filename     as character    no-undo .
     2069   define variable v-error-num             as integer      no-undo .
     2070   define variable v-template-file-name    as character    no-undo .
     2071   define variable v-vb-file-name          as character    no-undo .
     2072   define variable v-data-header-filename  as character    no-undo .
     2073   define variable v-data-filename         as character    no-undo .
     2074   define variable v-excel-file-name       as character    no-undo .
     2075   define variable v-err-message           as character    no-undo .
     2076   define variable v-os-err-str            as character    no-undo .
     2077   define variable v-report-dir            as character    no-undo .
     2078   do for buf_temp-param
     2079   on error undo, return error return-value
     2080   :
     2081   assign
     2082     v-report-dir  = trim( replace( p-dir-name, '/' , '\' ) , '\' )
     2083   .
     2084     assign
     2085     v-report-num = g#report-num
     2086     v-obj-dir           = v-report-dir + chr(47) +
     2087                           (if p-subdir-name <> '' then (p-subdir-name + chr(47)) else '')
     2088     v-filename          = string( session:temp-directory ) + "rpt" + string( v-report-num )
     2089     v-excel-file-name   = string( session:temp-directory ) + "rpt" + string( v-report-num ) + ".xls"
     2090     v-home-dir-filename = v-obj-dir +  p-custom-name
     2091     .
     2092     os-delete value( v-filename + ".txl" )  .
     2093     os-rename
     2094       value( string( session:temp-directory ) + "$" + string( v-report-num ) + ".txl" )
     2095       value( v-filename + ".txl" )
     2096     .
     2097     assign
     2098       v-filename = search( v-filename + ".txl" )
     2099     .
     2100     if v-filename = "" or v-filename = ?
     2101     then do:
     2102       assign
     2103         v-err-message = v-err-message + substitute( "Не найден файл &1 для формирования Excel-файла по объекту p-custom-name"
     2104                                                   , string( session:temp-directory ) + "rpt" + string( v-report-num )
     2105                                                   )
     2106       .
     2107       return error v-err-message.
     2108     end.
     2109     input stream reprumpr_in from value( v-filename ).
     2110     import stream reprumpr_in v-template-file-name   no-error .
     2111     import stream reprumpr_in v-vb-file-name         no-error .
     2112     import stream reprumpr_in v-data-header-filename no-error .
     2113     import stream reprumpr_in v-data-filename        no-error .
     2114     input stream reprumpr_in close.
     2115     if search( v-template-file-name ) = ?
     2116     then do:
     2117       assign
     2118         v-err-message = v-err-message + substitute( "Не найден шаблон Excel для вывода данных.&2Указан файл шаблона:&1&2&2"
     2119                                                   , v-template-file-name
     2120                                                   , chr(10)
     2121                                                   )
     2122       .
     2123       return error v-err-message.
     2124     end.
     2125     if search( v-vb-file-name ) = ?
     2126     then do:
     2127       assign
     2128         v-err-message = v-err-message + substitute( "Не найден текст программы заполнения шаблона Excel.&3Файл шаблона:&1&3Указан файл программы:&2&3&3"
     2129                                                   , v-template-file-name
     2130                                                   , v-vb-file-name
     2131                                                   , chr(10)
     2132                                                   )
     2133       .
     2134       return error v-err-message.
     2135     end.
     2136     if v-data-header-filename <> "":U
     2137     and search( v-data-header-filename ) = ?
     2138     then do:
     2139       assign
     2140         v-err-message = v-err-message + substitute( "Не найден файл шапки.&3Файл шаблона:&1&3Указан файл шапки:&2&3&3"
     2141                                                   , v-template-file-name
     2142                                                   , v-data-header-filename
     2143                                                   , chr(10)
     2144                                                   )
     2145       .
     2146       return error v-err-message.
     2147     end.
     2148     if v-data-filename <> "":U
     2149     and search( v-data-filename )   = ?
     2150     then do:
     2151       assign
     2152         v-err-message = v-err-message + substitute( "Не найден файл строк данных.&3Файл шаблона:&1&3Указан файл строк данных:&2&3&3"
     2153                                                   , v-template-file-name
     2154                                                   , v-data-filename
     2155                                                   , chr(10)
     2156                                                   )
     2157       .
     2158       return error v-err-message.
     2159     end.
     2160     create buf_temp-param.
     2161     assign
     2162       v-template-file-name = search( v-template-file-name )
     2163       file-info :file-name = v-template-file-name
     2164       v-template-file-name = file-info :full-pathname
     2165       v-vb-file-name       = search( v-vb-file-name )
     2166       file-info :file-name = v-vb-file-name
     2167       v-vb-file-name       = file-info :full-pathname
     2168     .
     2169     if v-template-file-name = ? or v-template-file-name = "":U
     2170     then do:
     2171       RETURN error substitute("Не найден шаблон &1", v-template-file-name).
     2172     end.
     2173     run paramls-write in this-procedure ( input "template":U
     2174                                         , input "template-file-name":U
     2175                                         , input v-template-file-name
     2176                                         ).
     2177     run paramls-write in this-procedure ( input "template":U
     2178                                         , input "vb-file-name":U
     2179                                         , input v-vb-file-name
     2180                                         ).
     2181     run paramls-write in this-procedure ( input "data":U
     2182                                         , input "data-header-filename":U
     2183                                         , input v-data-header-filename
     2184                                         ).
     2185     run paramls-write in this-procedure ( input "data":U
     2186                                         , input "data-filename":U
     2187                                         , input v-data-filename
     2188                                         ).
     2189     run paramls-write in this-procedure ( input "saveas":U
     2190                                         , input "excel-file-name":U
     2191                                         , input v-excel-file-name
     2192                                         ).
     2193     run paramls-write in this-procedure ( input "file":U
     2194                                         , input "file-no-open":U
     2195                                         , input "yes":U
     2196                                         ).
     2197     run gbl/macroxlt.p ( input-output table buf_temp-param ) no-error.
     2198     if error-status :error
     2199     then do:
     2200       assign
     2201         v-err-message = v-err-message + substitute( "&1&2&3&4Ошибка создания файла Excel.&4&5&4&6&4&7&4&8&4&4"
     2202                                                   , vss-workfile
     2203                                                   , vss-revision
     2204                                                   , vss-description
     2205                                                   , chr(10)
     2206                                                   , return-value
     2207                                                   , trim(error-status :get-message(1))
     2208                                                   , trim(error-status :get-message(2))
     2209                                                   , trim(error-status :get-message(3))
     2210                                                   )
     2211       .
     2212       return error v-err-message.
     2213     end.
     2214     run prnexldl_clear in this-procedure ( input v-filename) no-error.
     2215     if error-status :error
     2216     then do:
     2217       assign
     2218         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     2219                                                   , v-filename
     2220                                                   , return-value
     2221                                                   , chr(10)
     2222                                                   )
     2223       .
     2224       return error v-err-message.
     2225     end.
     2226     run gbl/dir-cre.p ( input v-obj-dir ) no-error  .
     2227     if error-status :error
     2228     then do:
     2229       assign
     2230         v-err-message = v-err-message + substitute( "Ошибка создания директории &1: &2&4&3&4&4"
     2231                                                   , v-filename
     2232                                                   , return-value
     2233                                                   , trim(error-status :get-message(1))
     2234                                                   , chr(10)
     2235                                                   )
     2236       .
     2237     end.
     2238     run gbl/del-file.p ( input v-home-dir-filename ) no-error .
     2239     if error-status :error
     2240     then do:
     2241       assign
     2242         v-err-message = v-err-message + substitute( "Ошибка удаления файла &1: &2 &3&3"
     2243                                                   , v-home-dir-filename
     2244                                                   , return-value
     2245                                                   , chr(10)
     2246                                                   )
     2247       .
     2248       return error v-err-message.
     2249     end.
     2250     run gbl/ren-file.p ( input v-excel-file-name
     2251                     , input v-home-dir-filename
     2252                     ) no-error .
     2253     if error-status :error
     2254     then do:
     2255       assign
     2256         v-err-message = v-err-message + substitute( "Ошибка перемещения файла &1 -> &2: &3&4&4"
     2257                                                   , v-excel-file-name
     2258                                                   , v-home-dir-filename
     2259                                                   , return-value
     2260                                                   , chr(10)
     2261                                                   )
     2262       .
     2263       return error v-err-message.
     2264     end.
     2265     run cb_fill-report-destination in p-parent-handle (  input p-rdbh
     2266                                                   ,input p-report-id
     2267                                                   ,input 'excel':U
     2268                                                   ,input v-home-dir-filename
     2269                                                   ,input string(p-disable-option) + chr(4) + string(p-font-number)
     2270                                                   ).
     2271   end.
     2272   end procedure.
     2273   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2274   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2275   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2276   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2277   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2278   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2279   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2280   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2281   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2282   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2283   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2284   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2285   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2286   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2287   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2288   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2289   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2290   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2291   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2292   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     2293   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2294   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2295   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2296   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2297   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2298   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2299   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     2300   define variable temp1 as integer   no-undo.
     2301   define variable vss-include-info18 as character format "X(65)" no-undo
     2302   initial "@(#)$Workfile$ $Revision$".
     2303   define variable v-fmtcli-name          as character    no-undo.
     2304   define variable v-fmtcli-engl-name     as character    no-undo.
     2305   define variable v-fmtcli-addres        as character    no-undo.
     2306   define variable v-fmtcli-post-addres   as character    no-undo.
     2307   define variable v-fmtcli-full-addres   as character    no-undo.
     2308   define variable v-fmtcli-phone         as character    no-undo.
     2309   define variable v-fmtcli-inn           as character    no-undo.
     2310   define variable v-fmtcli-kpp           as character    no-undo.
     2311   define variable v-fmtcli-okpo          as character    no-undo.
     2312   define variable v-fmtcli-country       as character    no-undo.
     2313   define variable v-fmtcli-city          as character    no-undo.
     2314   define variable v-fmtcli-index         as character    no-undo.
     2315   define variable v-fmtcli-schet-exists  as logical      no-undo.
     2316   define variable v-fmtcli-bank-exists   as logical      no-undo.
     2317   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     2318   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     2319   define variable v-fmtcli-bank-bik      as character    no-undo.
     2320   define variable v-fmtcli-bank-name     as character    no-undo.
     2321   define variable v-fmtcli-bank-addres   as character    no-undo.
     2322   define variable v-fmtcli-bank-city     as character    no-undo.
     2323   procedure fmtcli-get-bank :
     2324   define input parameter p-host-code      as integer          no-undo.
     2325   define input parameter p-obj-type       as character        no-undo.
     2326   define input parameter p-obj-code       as integer          no-undo.
     2327   define input parameter p-curr-code      as integer          no-undo.
     2328       define buffer buf_fin-schet     for ub.fin-schet.
     2329       define buffer buf_fin-bank      for ub.fin-bank.
     2330   do
     2331   for buf_fin-schet
     2332     , buf_fin-bank
     2333   on error undo, return error
     2334   :
     2335       assign
     2336           v-fmtcli-schet-exists       = no
     2337           v-fmtcli-bank-exists        = no
     2338           v-fmtcli-bank-r-schet       = "":U
     2339           v-fmtcli-bank-c-schet       = "":U
     2340           v-fmtcli-bank-bik           = "":U
     2341           v-fmtcli-bank-name          = "":U
     2342           v-fmtcli-bank-addres        = "":U
     2343           v-fmtcli-bank-city          = "":U
     2344       .
     2345       search-for-schet:
     2346       for each buf_fin-schet no-lock
     2347          where buf_fin-schet.host-code = p-host-code
     2348            and buf_fin-schet.cli-type  = p-obj-type
     2349            and buf_fin-schet.cli-code  = p-obj-code
     2350            and buf_fin-schet.curr-code = p-curr-code
     2351       on error undo, return error
     2352       :
     2353           if buf_fin-schet.status_   = 'удал':U
     2354           then do:
     2355           end.
     2356           else do:
     2357               assign
     2358                   v-fmtcli-schet-exists   = yes
     2359                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     2360                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     2361               .
     2362               find first buf_fin-bank no-lock
     2363                    where buf_fin-bank.host-code = p-host-code
     2364                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     2365               no-error.
     2366               if available buf_fin-bank
     2367               then do:
     2368                   assign
     2369                       v-fmtcli-bank-exists      = yes
     2370                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     2371                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     2372                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     2373                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     2374                   .
     2375               end.
     2376               else do:
     2377                   assign
     2378                       v-fmtcli-bank-exists    = no
     2379                       v-fmtcli-bank-bik       = "":U
     2380                       v-fmtcli-bank-name      = "":U
     2381                       v-fmtcli-bank-addres    = "":U
     2382                       v-fmtcli-bank-city      = "":U
     2383                   .
     2384               end.
     2385               leave search-for-schet.
     2386           end.
     2387       end.
     2388   end.
     2389   end procedure.
     2390   procedure fmtcli-get-client :
     2391   define input parameter p-obj-type       as character    no-undo.
     2392   define input parameter p-obj-code       as integer      no-undo.
     2393       define variable v-temp-fmtcli-address      as character     no-undo.
     2394       define variable v-num-country-city    as integer      no-undo.
     2395       define buffer buf_clients   for ub.clients.
     2396       define buffer buf_firm      for ub.firm.
     2397       define buffer buf_store     for ub.store.
     2398       define buffer buf_shop      for ub.shop.
     2399       define buffer buf_person    for ub.person.
     2400   do
     2401   for buf_clients
     2402     , buf_firm
     2403     , buf_store
     2404     , buf_shop
     2405     , buf_person
     2406   on error undo, return error
     2407   :
     2408       assign
     2409           v-fmtcli-name           = "":U
     2410           v-fmtcli-addres         = "":U
     2411           v-fmtcli-post-addres    = "":U
     2412           v-fmtcli-full-addres    = "":U
     2413           v-fmtcli-phone          = "":U
     2414           v-fmtcli-inn            = "":U
     2415           v-fmtcli-kpp            = "":U
     2416           v-fmtcli-okpo           = "":U
     2417           v-fmtcli-city           = "":U
     2418           v-fmtcli-index          = "":U
     2419           v-fmtcli-country        = "":U
     2420       .
     2421       find first buf_clients no-lock
     2422            where buf_clients.obj-type = p-obj-type
     2423              and buf_clients.obj-code = p-obj-code
     2424       .
     2425       assign
     2426           v-fmtcli-name = buf_clients.obj-name
     2427       .
     2428       case buf_clients.obj-type:
     2429          when 'орг':U
     2430          then do:
     2431               find first buf_firm no-lock
     2432                    where buf_firm.firm-code = buf_clients.obj-code
     2433                    no-error
     2434               .
     2435               if available buf_firm
     2436               then do:
     2437                   assign
     2438                       v-num-country-city = num-entries( buf_firm.city )
     2439                       v-fmtcli-engl-name = buf_firm.engl-name
     2440                   .
     2441                   if v-num-country-city > 0
     2442                   then do:
     2443                       assign
     2444                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     2445                       .
     2446                   end.
     2447                   if v-num-country-city > 1
     2448                   then do:
     2449                       assign
     2450                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     2451                       .
     2452                   end.
     2453                   run fmtcli-concatenate-strings in this-procedure (
     2454                         input v-fmtcli-full-addres
     2455                       , input v-fmtcli-country
     2456                       , input ", ":U
     2457                       , input 50
     2458                       , output v-fmtcli-full-addres
     2459                   ).
     2460                   run fmtcli-concatenate-strings in this-procedure (
     2461                         input v-fmtcli-full-addres
     2462                       , input v-fmtcli-city
     2463                       , input ", ":U
     2464                       , input 50
     2465                       , output v-fmtcli-full-addres
     2466                   ).
     2467                   run fmtcli-concatenate-strings in this-procedure (
     2468                         input v-fmtcli-full-addres
     2469                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     2470                       , input ", ":U
     2471                       , input 50
     2472                       , output v-fmtcli-full-addres
     2473                   ).
     2474                   run fmtcli-concatenate-strings in this-procedure (
     2475                         input v-fmtcli-post-addres
     2476                       , input v-fmtcli-country
     2477                       , input ", ":U
     2478                       , input 50
     2479                       , output v-fmtcli-post-addres
     2480                   ).
     2481                   run fmtcli-concatenate-strings in this-procedure (
     2482                         input v-fmtcli-post-addres
     2483                       , input v-fmtcli-city
     2484                       , input ", ":U
     2485                       , input 50
     2486                       , output v-fmtcli-post-addres
     2487                   ).
     2488                   run fmtcli-concatenate-strings in this-procedure (
     2489                         input v-fmtcli-post-addres
     2490                       , input string( buf_firm.ind )
     2491                       , input ", ":U
     2492                       , input 50
     2493                       , output v-fmtcli-post-addres
     2494                   ).
     2495                   run fmtcli-concatenate-strings in this-procedure (
     2496                         input substring( buf_firm.addres1, 1, 50 )
     2497                       , input buf_firm.addres2
     2498                       , input " ":U
     2499                       , input 50
     2500                       , output v-temp-fmtcli-address
     2501                   ).
     2502                   run fmtcli-concatenate-strings in this-procedure (
     2503                         input v-temp-fmtcli-address
     2504                       , input substring( buf_firm.addres1, 51, 50 )
     2505                       , input " ":U
     2506                       , input 50
     2507                       , output v-temp-fmtcli-address
     2508                   ).
     2509                   run fmtcli-concatenate-strings in this-procedure (
     2510                         input v-temp-fmtcli-address
     2511                       , input substring( buf_firm.addres1, 101, 50 )
     2512                       , input " ":U
     2513                       , input 50
     2514                       , output v-temp-fmtcli-address
     2515                   ).
     2516                   assign
     2517                       v-fmtcli-addres = v-temp-fmtcli-address
     2518                   .
     2519                   if buf_firm.addres1 <> ?
     2520                   then do:
     2521                       run fmtcli-concatenate-strings in this-procedure (
     2522                             input v-fmtcli-full-addres
     2523                           , input v-fmtcli-addres
     2524                           , input ", ":U
     2525                           , input 0
     2526                           , output v-fmtcli-full-addres
     2527                       ).
     2528                   end.
     2529                   run fmtcli-concatenate-strings in this-procedure (
     2530                         input substring( buf_firm.post-addr1, 1, 50 )
     2531                       , input buf_firm.post-addr2
     2532                       , input " ":U
     2533                       , input 50
     2534                       , output v-fmtcli-post-addres
     2535                   ).
     2536                   run fmtcli-concatenate-strings in this-procedure (
     2537                         input v-fmtcli-post-addres
     2538                       , input substring( buf_firm.post-addr1, 51, 50 )
     2539                       , input " ":U
     2540                       , input 50
     2541                       , output v-fmtcli-post-addres
     2542                   ).
     2543                   run fmtcli-concatenate-strings in this-procedure (
     2544                         input v-fmtcli-post-addres
     2545                       , input substring( buf_firm.post-addr1, 101, 50 )
     2546                       , input " ":U
     2547                       , input 50
     2548                       , output v-fmtcli-post-addres
     2549                   ).
     2550                   assign
     2551                       v-fmtcli-phone         = buf_firm.phone
     2552                       v-fmtcli-inn           = buf_firm.inn
     2553                       v-fmtcli-kpp           = buf_firm.kpp
     2554                       v-fmtcli-okpo          = buf_firm.okpo
     2555                       v-fmtcli-index         = string( buf_firm.ind )
     2556                   .
     2557               end.
     2558          end.
     2559          when 'маг':U
     2560          then do:
     2561               find first buf_shop no-lock
     2562                    where buf_shop.obj-code = buf_clients.obj-code
     2563               .
     2564               if available buf_shop
     2565               then do:
     2566                   run fmtcli-concatenate-strings in this-procedure (
     2567                         input buf_shop.addres1
     2568                       , input buf_shop.addres2
     2569                       , input " ":U
     2570                       , input 50
     2571                       , output v-fmtcli-addres
     2572                   ).
     2573                   assign
     2574                       v-fmtcli-full-addres = v-fmtcli-addres
     2575                       v-fmtcli-post-addres = v-fmtcli-addres
     2576                       v-fmtcli-phone       = buf_shop.phone
     2577                       v-fmtcli-inn         = "":U
     2578                       v-fmtcli-kpp         = "":U
     2579                       v-fmtcli-okpo        = "":U
     2580                       v-fmtcli-city        = "":U
     2581                       v-fmtcli-index       = "":U
     2582                   .
     2583               end.
     2584          end.
     2585          when 'скл':U
     2586          then do:
     2587               find first buf_store no-lock
     2588                    where buf_store.obj-code = buf_clients.obj-code
     2589               .
     2590               if available buf_store
     2591               then do:
     2592                   run fmtcli-concatenate-strings in this-procedure (
     2593                         input buf_store.addres1
     2594                       , input buf_store.addres2
     2595                       , input " ":U
     2596                       , input 50
     2597                       , output v-fmtcli-addres
     2598                   ).
     2599                   assign
     2600                       v-fmtcli-full-addres = v-fmtcli-addres
     2601                       v-fmtcli-phone       = buf_store.phone
     2602                       v-fmtcli-inn         = "":U
     2603                       v-fmtcli-kpp         = "":U
     2604                       v-fmtcli-okpo        = "":U
     2605                       v-fmtcli-city        = "":U
     2606                       v-fmtcli-index       = "":U
     2607                   .
     2608               end.
     2609          end.
     2610          when 'чел':U
     2611          then do:
     2612               find first buf_person no-lock
     2613                    where buf_person.psn-code = buf_clients.obj-code
     2614               .
     2615               if available buf_person
     2616               then do:
     2617                   run fmtcli-concatenate-strings in this-procedure (
     2618                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     2619                                 then "":U
     2620                                 else string( buf_person.ind, "999999")
     2621                                 )
     2622                       , input buf_person.city
     2623                       , input ", ":U
     2624                       , input 0
     2625                       , output v-fmtcli-full-addres
     2626                   ).
     2627                   assign
     2628                       v-fmtcli-addres = buf_person.address
     2629                   .
     2630                   run fmtcli-concatenate-strings in this-procedure (
     2631                         input v-fmtcli-full-addres
     2632                       , input v-fmtcli-addres
     2633                       , input ", ":U
     2634                       , input 0
     2635                       , output v-fmtcli-full-addres
     2636                   ).
     2637                   assign
     2638                       v-fmtcli-phone     = buf_person.phone1
     2639                       v-fmtcli-inn       = buf_person.inn
     2640                       v-fmtcli-kpp       = buf_person.kpp
     2641                       v-fmtcli-okpo      = buf_person.okpo
     2642                       v-fmtcli-city      = buf_person.city
     2643                       v-fmtcli-index     = string( buf_person.ind )
     2644                   .
     2645               end.
     2646          end.
     2647       end case.
     2648   end.
     2649   end procedure.
     2650   procedure fmtcli-concatenate-strings :
     2651   define input parameter p-string-1       as character        no-undo.
     2652   define input parameter p-string-2       as character        no-undo.
     2653   define input parameter p-delimiter      as character        no-undo.
     2654   define input parameter p-length         as integer          no-undo.
     2655   define output parameter p-out-string    as character        no-undo.
     2656   do
     2657   on error undo, return error
     2658   :
     2659       assign
     2660           p-out-string = ( if p-string-1 = ?
     2661                            then "":U
     2662                            else trim( p-string-1 ) )
     2663       .
     2664       assign
     2665           p-out-string = p-out-string
     2666                        + ( if p-out-string = "":U
     2667                            or length( p-out-string ) = p-length
     2668                            or p-string-2 = ?
     2669                            or trim( p-string-2 ) = "":U
     2670                            then "":U
     2671                            else p-delimiter )
     2672                        + ( if p-string-2 = ?
     2673                            or trim( p-string-2 ) = "":U
     2674                            then "":U
     2675                            else trim( p-string-2 ) )
     2676       .
     2677   end.
     2678   end procedure.
