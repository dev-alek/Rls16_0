     2888   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2889   define new global shared variable g#trdcalib as handle no-undo.
     2890   procedure wthcattr-sprcli :
     2891   define input parameter parparentproc  as widget-handle no-undo.
     2892   define input parameter p-mode  as character no-undo.
     2893   define input-output parameter p-value as character no-undo .
     2894   define output parameter p-setted as logical no-undo .
     2895     DEFINE VARIABLE v-value as character no-undo .
     2896     define variable v-cli-type as character no-undo .
     2897     define variable v-cli-code as integer no-undo .
     2898     define buffer buf_clients   for ub.clients.
     2899     define variable v_rid as character no-undo.
     2900     define variable ref-rec as recid no-undo .
     2901     do
     2902     on error undo, return error
     2903     :
     2904         v-value = p-value.
     2905      if p-value <> '':U then do:
     2906       assign
     2907       v-cli-type = substring(p-value, 1, 3)
     2908       v-cli-code = integer(substring(p-value, 4))
     2909       no-error.
     2910       if error-status:error then do:
     2911         assign
     2912         v-cli-type = '':U
     2913         v-cli-code = 0
     2914         .
     2915       end.
     2916      end.
     2917      FIND FIRST buf_clients NO-LOCK WHERE
     2918               buf_clients.obj-type = v-cli-type AND
     2919               buf_clients.obj-code = v-cli-code  NO-ERROR.
     2920      IF available(buf_clients) then do:
     2921       run ref/cli-all.w (
     2922                   input parparentproc
     2923                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     2924                  ,input v-cli-type
     2925                  ,input 'все':U
     2926                  ,input 'все':U
     2927                  ,input RECID( buf_clients )
     2928                  ,input ",,,,,,NO"
     2929                  ,input ?
     2930                  ,OUTPUT v_rid ).
     2931     END.
     2932     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     2933       run ref/cli-all.w (
     2934                    input parparentproc
     2935                   ,INPUT "b-sel":U
     2936                  ,input  v-cli-type
     2937                  ,input 'все':U
     2938                  ,input 'текущие':U
     2939                  ,input ?
     2940                  ,input ",,,,,,NO"
     2941                  ,input ?
     2942                  ,OUTPUT v_rid ).
     2943     END.
     2944     else do:
     2945       message
     2946       if p-value = "":U then 'Атрибут не задан!'
     2947       else substitute('Не найден клиент &1',p-value)
     2948       view-as alert-box warning.
     2949     end.
     2950     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     2951       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     2952       IF ERROR-STATUS:ERROR THEN DO:
     2953           RETURN NO-APPLY.
     2954       END.
     2955       FIND FIRST buf_clients NO-LOCK WHERE
     2956                  RECID( buf_clients ) = ref-rec NO-ERROR.
     2957       IF AVAIL buf_clients THEN DO:
     2958         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     2959       end.
     2960     end.
     2961     if v-value <> p-value then do:
     2962       p-value = v-value.
     2963       p-setted = yes.
     2964     end.
     2965     end.
     2966   end procedure.
     2967     define new global shared variable g#wthcalib as handle no-undo.
