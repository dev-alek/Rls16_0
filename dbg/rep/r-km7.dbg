     5699   define variable PropisSumAll-2  as character format "x(100)" no-undo .
     5700   define variable abbr            as character             no-undo .
     5701   define variable v-kkm-code-reg  as character             no-undo .
     5702   define variable v-kkm-code-prod as character             no-undo .
     5703   define variable v-par-code      as character             no-undo .
     5704   define variable v-par-type      as character             no-undo .
     5705   define variable v-outprncd      as character             no-undo .
     5706   define variable v-pril-kass     as character             no-undo .
     5707   define variable v-pril-kass1    as character             no-undo .
     5708   define variable v-pril-kass2    as character             no-undo .
     5709   define variable v-pril-kass_    as character             no-undo .
     5710   define variable v-z-num         as character             no-undo .
     5711   define FRAME km-frame
     5712         sym1                    no-label format "X(1)"            space(0)
     5713         temp-str.cash-num       no-label format "99999"           space(0)
     5714         sym3                    no-label format "X(1)"            space(0)
