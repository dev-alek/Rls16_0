     3206   procedure torgconf-get-self-param :
     3207   define input parameter p-obj-type           as character        no-undo.
     3208   define input parameter p-obj-code           as integer          no-undo.
     3209   define input parameter p-curr-code          as integer          no-undo.
     3210       define variable v-host-code    as integer      no-undo.
     3211       define variable v-par-type     as character    no-undo.
     3212   do
     3213   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     3214   :
     3215   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3216   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3217     (input  p-obj-type
     3218     ,input  p-obj-code
     3219     ,output v-host-code
     3220     )  .
     3221       if v-torgconf-outhold = yes
     3222       then do:
     3223           run torgconf-get-holdfirm-code in this-procedure (
     3224                 input p-obj-type
     3225               , input p-obj-code
     3226               , output v-torgconf-self-host-code
     3227           ).
     3228           if v-torgconf-self-host-code = 0
     3229           then do:
     3230               return error.
     3231           end.
     3232       end.
     3233       else do:
     3234           assign
     3235               v-torgconf-self-host-code = v-host-code
     3236           .
     3237       end.
     3238       if v-torgconf-self-host-code = 0
     3239       then do:
     3240           assign
     3241               v-torgconf-self-host-name           = "":U
     3242               v-torgconf-self-host-addres         = "":U
     3243               v-torgconf-self-host-post-addres    = "":U
     3244               v-torgconf-self-host-phone          = "":U
     3245               v-torgconf-self-host-inn            = "":U
     3246               v-torgconf-self-host-kpp            = "":U
     3247               v-torgconf-self-host-okpo           = "":U
     3248               v-torgconf-self-host-egrip-date     = "":U
     3249               v-torgconf-self-host-egrip-num      = "":U
     3250           .
     3251       end.
     3252       else do:
     3253           run fmtcli-get-client in this-procedure (
     3254                 input 'орг':U
     3255               , input v-torgconf-self-host-code
     3256           ).
     3257           assign
     3258               v-torgconf-self-host-name        = v-fmtcli-name
     3259               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     3260               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     3261               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     3262               v-torgconf-self-host-phone       = v-fmtcli-phone
     3263               v-torgconf-self-host-inn         = v-fmtcli-inn
     3264               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     3265               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     3266           .
     3267           run gbl/clntat-v.p (
     3268                 input 'орг':U
     3269               , input v-torgconf-self-host-code
     3270               , input 'egrip-date':U
     3271               , output v-torgconf-self-host-egrip-date
     3272               , output v-par-type
     3273           ).
     3274           run gbl/clntat-v.p (
     3275                 input 'орг':U
     3276               , input v-torgconf-self-host-code
     3277               , input 'egrip-num':U
     3278               , output v-torgconf-self-host-egrip-num
     3279               , output v-par-type
     3280           ).
     3281           run fmtcli-get-bank in this-procedure (
     3282                 input v-host-code
