     5747   "|     +----------------+----------------+ (отчета  |    контрольного  +------------------+------------------+     согласно     |           |Подтвер- |           |Подтвер- |           |Подтвер- |" skip
     5748   "|     |                |                |фискальной|     счетчика     |                  |                  |    показаниям    |  выручка  |ждаю.Под-|  выручка  |ждаю.Под-|  выручка  |ждаю.Под-|" skip
     5749   "|Кассы|                |                | памяти)  |      (отчета     |     на начало    |     на конец     |     счетчика     |  в сумме  |пись зав.|  в сумме  |пись зав.|  в сумме  |пись зав.|" skip
     5750   "|     | Производителя  |Регистрационный | на конец |     фискальной   |    рабочего дня  |   рабочего дня   |     в сумме,     |  руб.коп. |отделом  |  руб.коп. |отделом  |  руб.коп. |отделом  |" skip
     5751   "|     |                |                | рабочего |      памяти)     |      (смены)     |      (смены)     |     руб.коп.     |           |(секцией)|           |(секцией)|           |(секцией)|" skip
     5752   "|     |                |                |дня(смены)|                  |                  |                  |                  |           |         |           |         |           |         |" skip
     5753   "+-----+----------------+----------------+----------+------------------+------------------+------------------+------------------+-----------+---------+-----------+---------+-----------+---------+" skip
     5754         with width 232 down stream-io no-box no-underline no-labels .
     5755   FUNCTION f-wp-qnty returns character ( INPUT p-dec as decimal ) :
     5756     define variable pr as character no-undo .
     5757     run rep/wp-qnty.p ( input p-dec, output Pr ).
     5758     if Pr = '' then do:
     5759        Pr = 'Ноль'.
     5760     end.
     5761     RETURN ( Pr ) .
     5762   END FUNCTION.
     5763   do on error undo, return error
     5764      :
     5765      run get-report-num  in parparentproc (output  g#report-num).
     5766      output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     5767      output close.
     5768      if session:set-wait-state("compiler") then.
     5769   output STREAM Out-Stream to value( string( session:temp-directory +
     5770                                        "rpt" + string( g#report-num ) ) )
     5771                                        page-size  value(43) .
     5772      run km7xl-init in this-procedure .
     5773   define variable v-account as integer init 0 no-undo .
     5774   define variable v-account-lavel as character no-undo .
     5775   define variable v-button-stop as logical no-undo .
     5776   define variable v-kol-spice as integer no-undo .
     5777   define variable v-kol-spice2 as integer no-undo .
     5778   define variable v-kol-spice3 as integer no-undo .
     5779   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     5780   DEFINE BUTTON StopBtn AUTO-END-KEY
     5781        LABEL "Стоп"
     5782        SIZE 10 BY 1.
     5783   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     5784        LABEL "Обработано записей"
     5785         VIEW-AS TEXT
     5786        SIZE 14 BY .67 NO-UNDO.
     5787   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     5788         VIEW-AS TEXT
     5789        SIZE 53.25 BY .67
     5790        FGCOLOR 1  NO-UNDO.
     5791   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     5792         VIEW-AS TEXT
     5793        SIZE 53.25 BY .67
     5794        FGCOLOR 1  NO-UNDO.
     5795   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     5796         VIEW-AS TEXT
     5797        SIZE 53.25 BY .67
     5798        FGCOLOR 1  NO-UNDO.
     5799   DEFINE RECTANGLE RECT-1
     5800        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     5801        SIZE 55.13 BY 4.46.
     5802   DEFINE FRAME InfoFrame
     5803        StopBtn AT ROW 4.25 COL 21.75
     5804        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     5805        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     5806        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     5807        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     5808        RECT-1 AT ROW 1 COL 1
     5809       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     5810            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     5811            TITLE "Процесс"
     5812            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     5813   define variable mFrameView      as logical   no-undo init yes.
     5814     define variable mFramHandle as handle no-undo.
     5815     mFramHandle = frame InfoFrame:handle.
     5816     if  log-manager:logfile-name ne ?
     5817     then DO:
     5818         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     5819         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     5820         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     5821     end.
     5822     mFrameView = not session:batch-mode and mFramHandle:visible.
     5823     if mFrameView
     5824     then do:
     5825       ASSIGN
     5826          FRAME InfoFrame:HIDDEN                           = TRUE
     5827          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     5828     end.
     5829   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     5830   DO:
     5831     IF not StopProcessing THEN
     5832       Message "Вы действительно хотите прервать" SKIP
     5833               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     5834                 UPDATE StopProcessing.
     5835     IF StopProcessing THEN do:
     5836        if mFrameView
     5837        then do:
     5838           HIDE FRAME InfoFrame.
     5839        end.
     5840     End.
     5841   END.
     5842      assign
     5843        UndLine = fill("_", 230)
     5844        Line    = fill("-", 230)
     5845      .
     5846      find first obj-list no-lock no-error.
     5847      if not AVAILABLE obj-list THEN DO:
     5848         RETURN.
     5849      END.
     5850      find first This_Object  WHERE This_Object.obj-type = obj-list.obj-type
     5851                                AND This_Object.obj-code = obj-list.obj-code
     5852                              no-lock.
     5853      find first clients      WHERE clients.obj-type     = 'орг':U
     5854                                AND clients.obj-code     = This_Object.host-code
     5855                              no-lock.
     5856      find first buf_firm where buf_firm.firm-code = clients.obj-code
     5857                          no-lock
     5858                          .
     5859   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     5860     if  log-manager:logfile-name ne ?
     5861     then DO:
     5862         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     5863     end.
     5864     if not session:batch-mode then
     5865     do:
     5866       VIEW FRAME InfoFrame.
     5867       mFrameView = true.
     5868     end.
     5869      v-button-stop = false .
     5870         if mFrameView
     5871         then do:
     5872         if v-button-stop then view STOPBTN in frame InfoFrame.
     5873                          else Hide STOPBTN in frame InfoFrame.
     5874         end.
     5875      for each buf_cash-desk
     5876         where buf_cash-desk.obj-code = This_Object.obj-code
     5877         no-lock :
     5878   define variable vss-include-info29 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5879   for each buf_chk-doc
     5880       where buf_chk-doc.obj-type    = 'маг':U
     5881         and buf_chk-doc.obj-code    = This_Object.obj-code
     5882         and (buf_chk-doc.shift-date = x-date-start
     5883           or buf_chk-doc.chk-date   = x-date-start)
     5884         and buf_chk-doc.pay-desk = buf_cash-desk.cash-num
     5885             :
     5886         if X-tog-shift then do :
     5887           if buf_chk-doc.shift-num <> x-shift-alone then next.
     5888         end.
     5889         else do :
     5890           if buf_chk-doc.chk-date <> x-date-start then next.
     5891         end.
     5892         if lookup(string(buf_chk-doc.chk-type), '6,96':U) > 0 then do :
     5893             assign
     5894               v-summ-return = v-summ-return + ABS(buf_chk-doc.netto)
     5895             .
     5896         end.
     5897         find first temp-str
     5898               where temp-str.cash-num = buf_chk-doc.pay-desk
     5899               no-error.
     5900             if available temp-str then do :
     5901               if buf_chk-doc.z-number > temp-str.z-number then do :
     5902                 assign temp-str.z-number = buf_chk-doc.z-number .
     5903               end.
     5904             end.
     5905             else do :
     5906               CREATE temp-str.
     5907             assign
     5908                 temp-str.kkm-code-reg  = buf_cash-desk.registration-code
     5909                 temp-str.kkm-code-prod = buf_cash-desk.serial-code
     5910                 temp-str.cash-num      = buf_cash-desk.cash-num
     5911                 temp-str.z-number      = buf_chk-doc.z-number
     5912             .
     5913             end.
     5914   end.
     5915   find first temp-str
     5916        where temp-str.cash-num = buf_cash-desk.cash-num
     5917        no-error.
     5918        if not available temp-str then do :
     5919         find first buf_chk-doc
     5920             where buf_chk-doc.obj-type    = 'маг':U
     5921               and buf_chk-doc.obj-code    = This_Object.obj-code
     5922               and (buf_chk-doc.shift-date <= x-date-start
     5923                 or buf_chk-doc.chk-date   <= x-date-start)
     5924               and buf_chk-doc.pay-desk    = buf_cash-desk.cash-num
     5925               and buf_chk-doc.z-number    <> 0
     5926               use-index shift no-error .
     5927               if available buf_chk-doc then do :
     5928                   if X-tog-shift then do:
     5929                     if ( buf_chk-doc.shift-num >= x-shift-alone
     5930                       and buf_chk-doc.shift-date = x-date-start )
     5931                       then next.
     5932                   end.
     5933                   else do :
     5934                     if buf_chk-doc.chk-date >= x-date-start then next.
     5935                   end.
     5936                   create temp-str.
     5937                   assign
     5938                     temp-str.kkm-code-reg  = buf_cash-desk.registration-code
     5939                     temp-str.kkm-code-prod = buf_cash-desk.serial-code
     5940                     temp-str.cash-num      = buf_cash-desk.cash-num
     5941                     temp-str.z-number      = buf_chk-doc.z-number
     5942                   .
     5943               end.
     5944        end.
     5945   release temp-str.
     5946      end.
     5947      for each temp-str no-lock
     5948            by temp-str.cash-num
     5949            by temp-str.z-num
     5950                        :
     5951          assign v-z-num = (if v-z-num = "" then string(temp-str.z-num) else (v-z-num + "," + string(temp-str.z-num))).
     5952      end.
     5953      run PrintTitul in this-procedure .
     5954      FORM with frame km-frame .
     5955      for each temp-str no-lock
     5956            by temp-str.cash-num
     5957            by temp-str.z-num
     5958                        :
     5959          run print-line in this-procedure .
     5960      end.
     5961      PUT STREAM Out-Stream
     5962          Line format "X(194)" .
     5963      display stream Out-Stream
     5964             "          ИТОГО" @ temp-str.summ-end
     5965             "    X   "        @ empty-str09-10
     5966             "    X   "        @ empty-str09-12
     5967             sym8 sym9 sym10 sym11 sym12 sym13 sym14
     5968      with FRAME km-frame.
     5969      PUT STREAM Out-Stream
     5970          "+------------------+-----------+---------+-----------+---------+-----------+"  AT 109 SKIP
     5971      .
     5972      run PrintPodval in this-procedure .
     5973      output stream Out-Stream CLOSE .
     5974   if mFrameView
     5975   then do:
     5976      HIDE FRAME InfoFrame.
     5977   end.
     5978      run km7xl-close in this-procedure .
     5979      define variable disabledoptions   as integer   no-undo .
     5980      define variable v-user-action   as character no-undo .
     5981      define variable v-printed       as logical   no-undo .
     5982      DisabledOptions = 8.
     5983      ReportFontNum = 7.
     5984     if p-batch > 0 then do:
     5985       run reprumpr_print-printer in this-procedure ( input ReportFontNum
     5986                                                     ,input 0
     5987                                                     ) no-error.
     5988       if error-status:error then do:
     5989               if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input "Печать на принтер завершилась ошибкой...").    end.    else do:       run write-to-log in p-log-handle ( input "Печать на принтер завершилась ошибкой...").    end.
     5990       end.
     5991       if p-xls THEN DO:
     5992         if p-report-id = "74/2070" then do:
     5993           RUN reprumpr_print-xlt ( input p-dir-name
     5994                                   ,input ''
     5995                                   ,input substitute("km-7_&1&2_&3&4&5_&6.xls"
     5996                                                     , obj-list.obj-type
     5997                                                     , obj-list.obj-code
     5998                                                     , string(year(X-date-end), "9999")
     5999                                                     , string(month(X-date-end), "99")
     6000                                                     , string(day(X-date-end), "99")
     6001                                                     , X-shift-end)
     6002                                   ,input DisabledOptions
     6003                                   ,input ReportFontNum
     6004                                     ) .
     6005         end.
     6006         if error-status:error then do:
     6007                   if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     6008         end.
     6009       END.
     6010       if p-plain-txt then do:
     6011         if p-report-id = "74/2070" then do:
     6012           run reprumpr_print-plain-text in this-procedure ( input p-dir-name
     6013                                                             ,input ''
     6014                                                             ,input substitute("km-7_&1&2_&3&4&5_&6.txt"
     6015                                                                             , obj-list.obj-type
     6016                                                                             , obj-list.obj-code
     6017                                                                             , string(year(X-date-end), "9999")
     6018                                                                             , string(month(X-date-end), "99")
     6019                                                                             , string(day(X-date-end), "99")
     6020                                                                             , X-shift-end)
     6021                                                             ,input DisabledOptions
     6022                                                             ,input ReportFontNum
     6023                                                             ) no-error.
     6024         end.
     6025         if error-status:error then do:
     6026                   if p-batch > 0 then do:      run write-log-and-file in p-log-handle (                 input 1                                          , input p-log-file-name                              , input 1                                          , input return-value).    end.    else do:       run write-to-log in p-log-handle ( input return-value).    end.
     6027         end.
     6028       end.
     6029     end.
     6030     else do:
     6031       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     6032       os-rename
     6033       value( string( session:temp-directory ) + "$" + string( g#report-num ) + ".txl" )
     6034       value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )
     6035       .
     6036       run gbl/prnfilen.w
     6037           ( input  ""
     6038           , input  DisabledOptions
     6039           , input  string(session :temp-directory) + "rpt" + string( g#report-num )
     6040           , input  ReportFontNum
     6041           , output v-user-action
     6042           , output v-printed
     6043           ) .
     6044       os-delete value( string( session:temp-directory ) + "rpt" + string( g#report-num ) + ".txl" )  .
     6045     end.
     6046   end.
     6047   procedure print-line :
     6048     do on error undo, return error return-value :
     6049   define variable vss-include-info30 as character format "X(65)" no-undo
     6050   initial "@(#)$Workfile$ $Revision$".
     6051   DO:
     6052     if line-counter( Out-Stream ) + 4 > page-size( Out-Stream )
     6053     then  PAGE STREAM Out-Stream.
     6054     display stream Out-Stream
     6055             sym1  temp-str.cash-num
     6056             sym3  temp-str.kkm-code-prod
     6057             sym2  temp-str.kkm-code-reg
     6058             Sym4  temp-str.z-number
     6059             sym5  empty-str15-5
     6060             sym6  temp-str.summ-begin
     6061             sym7  temp-str.summ-end
     6062             sym8  empty-str20-8
     6063             sym9  empty-str15-9
     6064             sym10 empty-str09-10
     6065             sym11 empty-str15-11
     6066             sym12 empty-str09-12
     6067             sym13 empty-str15-13
     6068             sym14 empty-str09-14
     6069             sym15
     6070     with FRAME km-frame.
     6071     DOWN stream Out-Stream 1 with FRAME km-frame
     6072     .
     6073     run km7xl-write-line-data in this-procedure (
     6074           input temp-str.cash-num
     6075         , input temp-str.kkm-code-prod
     6076         , input temp-str.kkm-code-reg
     6077         , input temp-str.z-number
     6078     ).
     6079   end.
     6080     end.
     6081   end procedure.
     6082   procedure PrintTitul :
     6083   define variable v-organization  as character    no-undo.
     6084   define variable v-object        as character    no-undo.
     6085   define variable v-object-addr   as character    no-undo.
     6086   define variable v-r-index       as integer      no-undo.
     6087   do on error undo, return error return-value  :
     6088      for each thbjattr_thbj-attr :
     6089          if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd  = string( thbjattr_thbj-attr.property-value-logical) .
     6090      end.
     6091       case clients.obj-type:
     6092          when 'орг':U
     6093          then do:
     6094               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6095               if available ub.firm
     6096               then do:
     6097                   assign
     6098                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6099                       t-addres = t-addres
     6100                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6101                               then ""
     6102                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6103                             )
     6104                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6105                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6106                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6107                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6108                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6109                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6110                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6111                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6112                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6113                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6114                       t-phone = ub.firm.phone
     6115                       t-inn   = ub.firm.inn
     6116                       t-okpo  = ub.firm.okpo
     6117                   .
     6118               end.
     6119          end.
     6120          when 'маг':U
     6121          then do:
     6122               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     6123               if available ub.shop
     6124               then do:
     6125                   assign
     6126                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6127                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6128                       t-phone = shop.phone
     6129                       t-inn = ""
     6130                       t-okpo = ""
     6131                   .
     6132               end.
     6133          end.
     6134          when 'скл':U
     6135          then do:
     6136               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6137               if available ub.store
     6138               then do:
     6139                   assign
     6140                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6141                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6142                       t-phone = ub.store.phone
     6143                       t-inn = ""
     6144                       t-okpo = ""
     6145                   .
     6146               end.
     6147          end.
     6148          when 'чел':U
     6149          then do:
     6150               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     6151               if available ub.person
     6152               then do:
     6153                   assign
     6154                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     6155                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     6156                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     6157                       t-phone = ub.person.phone1
     6158                       t-inn = ub.person.inn
     6159                       t-okpo = ub.person.okpo
     6160                   .
     6161               end.
     6162          end.
     6163       end case.
     6164     Case This_Object.obj-type :
     6165       when 'маг':U then do:
     6166         find first ub.shop
     6167         where ub.shop.obj-code = This_Object.obj-code
     6168           no-error.
     6169           if available ub.shop then do:
     6170             assign v-object-addr = ub.shop.addres1.
     6171           end.
     6172       end.
     6173       when 'скл':U then do:
     6174         find first ub.store
     6175         where ub.store.obj-code = This_Object.obj-code
     6176           no-error.
     6177           if available ub.store then do:
     6178             assign v-object-addr = ub.store.addres1.
     6179           end.
     6180       end.
     6181     end case.
     6182     if v-outprncd = "yes" then
     6183     do:
     6184      assign
     6185         v-organization = string( CAPS( ub.clients.obj-name )  + " (" + string(ub.clients.obj-code) + ") " ) + t-addres + " " + t-phone
     6186         v-object       = string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ") " ) + v-object-addr
     6187      .
     6188     end.
     6189     else do:
     6190       assign
     6191         v-organization = string( CAPS( ub.clients.obj-name ) ) + " " + t-addres + " " + t-phone
     6192         v-object       = string( CAPS( This_Object.obj-name ) ) + " " + v-object-addr
     6193       .
     6194     end.
     6195     assign v-pril-kass = "Z " + v-z-num + " от " + string(x-date-start) + "г".
     6196     if length(v-pril-kass) > 18 then do:
     6197       assign
     6198       v-pril-kass1 = substring(v-pril-kass, 1, 18)
     6199       v-pril-kass2 = substring(v-pril-kass, 19 )
     6200       v-r-index = r-index(v-pril-kass1 , ",")
     6201       .
     6202       assign
     6203       v-pril-kass_ = substring(v-pril-kass1, (v-r-index + 1))
     6204       v-pril-kass1 = substring(v-pril-kass1, 1, v-r-index)
     6205       v-pril-kass2 = v-pril-kass_ + v-pril-kass2
     6206       .
     6207     end.
     6208     else do:
     6209       assign v-pril-kass1 = v-pril-kass.
     6210     end.
     6211      run km7xl-write-cell-data in this-procedure (
     6212          input "h_organization":U
     6213          , input v-organization
     6214      ).
     6215      run km7xl-write-cell-data in this-procedure (
     6216          input "h_object":U
     6217          , input v-object
     6218      ).
     6219      run km7xl-write-cell-data in this-procedure (
     6220          input "h_OKPO":U
     6221          , input t-okpo
     6222      ).
     6223      run km7xl-write-cell-data in this-procedure (
     6224          input "h_INN":U
     6225          , input t-inn
     6226      ).
     6227      run km7xl-write-cell-data in this-procedure (
     6228          input "h_docDate":U
     6229          , input string( today, "99/99/9999")
     6230      ).
     6231      run km7xl-write-cell-data in this-procedure (
     6232          input "h_docTime":U
     6233          , input string( TIME, "HH:MM:SS")
     6234      ).
     6235      run km7xl-write-cell-data in this-procedure (
     6236          input "h_pril_kass1":U
     6237          , input string( v-pril-kass1 )
     6238      ).
     6239      run km7xl-write-cell-data in this-procedure (
     6240          input "h_pril_kass2":U
     6241          , input string( v-pril-kass2 )
     6242      ).
     6243      PUT STREAM Out-Stream
     6244                                                                                                 "Унифицированная форма № КМ-7"          AT 158 skip
     6245                                                                                                 "Утверждена постановлением Госкомстата" AT 158 skip
     6246                                                                                                 "России от 25.12.98 г. № 132"           AT 158 skip
     6247                                                                                                                    "+----------------+" AT 177 skip
     6248                                                                                                                    "|      Код       |" AT 177 skip
     6249                                                                                                                    "+----------------+" AT 177 skip
     6250                                                                                                       "Форма по ОКУД|     0330107    |" AT 164 skip
     6251          space(5) v-organization format "X(140)"                                                                   "+----------------+" AT 177 skip
     6252          space(5) Line           format "X(140)"  "по ОКРО" format "X(7)" AT 167 "|"  AT 177 t-okpo format "X(16)" "|" AT 194 skip
     6253          space(30) "организация, адрес, номер телефона" format "X(120)"                                            "+----------------+" AT 177 skip
     6254          space(5) v-object format "X(120)"                                    "ИНН|" AT 174  t-INN format "X(15)"  "|" AT 194 skip
     6255          space(5)                                                                           Line format  "X(140)"  "+----------------+" AT 177 skip
     6256          space(35) "структурное подразделение" format "x(85)"                                 "Вид деятельности" AT 161 "| " AT 177 "|" AT 194 skip
     6257                                                                                                                    "+----------------+" AT 177 skip
     6258                                                                                       "Вид деятельности по ОКДП" AT 153 "| " AT 177 "|" AT 194 skip
     6259                                                                                                                    "+----------------+" AT 177 skip
     6260                                                                                                        "Вид операции|                |" AT 165 skip
     6261                                                                                                                    "+----------------+" AT 177 skip
     6262                               "+----------------+----------------+-----------------+" AT 101 "Приложение"   AT 158                             skip
     6263                        "| Номер документа|Дата составления|Время составления|" AT 101 "к кассовым отчетам " AT 158
     6264                                                        substitute("_&1&2", v-pril-kass1, fill("_", 17 - length(v-pril-kass1))) format "X(18)"  skip
     6265                               "+----------------+----------------+-----------------+" AT 101 "(номер, дата)" AT 180 skip
     6266                               "|"    AT 101
     6267                        "|   " AT 118 STRING(TODAY, "99/99/9999") format "x(10)" AT 122 "|" AT 135 STRING(time,"HH:MM:SS") AT 138 "   |  " AT 150
     6268                                                  substitute("_&1&2", v-pril-kass2, fill("_", 35 - length(v-pril-kass2))) format "X(36)" AT 158 skip
     6269          space(90) "СВЕДЕНИЯ" "+----------------+----------------+-----------------+" AT 101 skip
     6270          space(64) "О ПОКАЗАНИЯХ СЧЕТЧИКОВ КОНТРОЛЬНО-КАССОВЫХ МАШИН И ВЫРУЧКЕ ОРГАНИЗАЦИИ"  skip
     6271      .
     6272   END.
     6273   end procedure.
     6274   procedure PrintPodval :
     6275   do on error undo, return error return-value  :
     6276      run  rep/wp-qnty.p ( TRUNCATE(v-summ-return,0), output PropisSumAll  ).
     6277      if PropisSumAll = ''
     6278      Then PropisSumAll = 'Ноль'.
     6279      ASSIGN
     6280         v-kop = ABSOLUTE(INTEGER((v-summ-return - TRUNCATE(v-summ-return,0)) * 100))
     6281      .
     6282      define variable v-length       AS integer no-undo.
     6283      define variable v-spase-pos-r  AS integer no-undo.
     6284      define variable v-out-str      AS character no-undo EXTENT 2.
     6285      define variable v-out-str-ex   AS character no-undo EXTENT 2.
     6286      define variable o-head-position AS character no-undo.
     6287      define variable o-director     AS character no-undo.
     6288      define variable v-head-position AS character no-undo.
     6289      define variable v-director     AS character no-undo.
     6290      define variable o-cassir       as integer no-undo.
     6291      define variable v-cassir       as character no-undo.
     6292      define buffer   buf_shop       FOR ub.shop.
     6293      define buffer   buf_store      FOR ub.store.
     6294      define buffer   buf_thbj-attr  FOR ub.thbj-attr.
     6295      define buffer   buf_sysconf    FOR ub.sysconf.
     6296      define buffer   buf_shift-staff FOR ub.shift-staff.
     6297      v-out-str[1] =  PropisSumall + " руб. " + STRING(v-kop,"99") + " коп.".
     6298      v-length = LENGTH(v-out-str[1]).
     6299      if v-length > 110
     6300      THEN DO:
     6301         ASSIGN
     6302            v-spase-pos-r   = R-INDEX(SUBSTRING(v-out-str[1], 1, 110)," ")
     6303            v-out-str[2] = SUBSTRING(v-out-str[1], v-spase-pos-r + 1)
     6304            v-out-str[1] = SUBSTRING(v-out-str[1], 1, v-spase-pos-r - 1)
     6305         .
     6306      END.
     6307      v-out-str-ex[1] = PropisSumall.
     6308      v-length = LENGTH(v-out-str-ex[1]).
     6309      if v-length > 30
     6310      THEN DO:
     6311         ASSIGN
     6312            v-spase-pos-r   = R-INDEX(SUBSTRING(v-out-str-ex[1], 1, 30)," ")
     6313            v-out-str-ex[2] = SUBSTRING(v-out-str-ex[1], v-spase-pos-r + 1)
     6314            v-out-str-ex[1] = SUBSTRING(v-out-str-ex[1], 1, v-spase-pos-r - 1)
     6315         .
     6316      END.
     6317         define variable mCashBook as class ibs.th.ref.cashbookstorage no-undo .
     6318         mCashBook = new ibs.th.ref.cashbookstorage () .
     6319         o-head-position = mCashBook:getSinglRule(0 , This_Object.obj-type, This_Object.obj-code, "ManagerPosition") .
     6320         o-director      = mCashBook:getSinglRule(0 , This_Object.obj-type, This_Object.obj-code, "ManagerFIO") .
     6321         delete object mCashBook no-error .
     6322         case o-head-position:
     6323           when '1':U then do:
     6324             v-head-position = "Директор".
     6325           end.
     6326           when '2':U then do:
     6327             v-head-position = "Управляющий".
     6328           end.
     6329           when '0':U then do:
     6330               for first buf_sysconf where buf_sysconf.host-code = This_Object.host-code:
     6331               v-head-position = buf_sysconf.head-position.
     6332               end.
     6333           end.
     6334         end case.
     6335         case o-director:
     6336           when '1':U then do:
     6337             if This_Object.obj-type = 'маг':U then do:
     6338               find first buf_shop no-lock where
     6339                         buf_shop.obj-code = This_Object.obj-code no-error .
     6340               if available buf_shop then do:
     6341                 v-director = buf_shop.director.
     6342               end.
     6343             end.
     6344             if This_Object.obj-type = 'скл':U then do:
     6345               find first buf_store no-lock where
     6346                         buf_store.obj-code = This_Object.obj-code no-error .
     6347               if available buf_store then do:
     6348                 v-director = buf_store.store-boss.
     6349               end.
     6350             end.
     6351           end.
     6352           when '0':U then do:
     6353             v-director = buf_firm.director.
     6354           end.
     6355         end case.
     6356       for first buf_shift-staff
     6357       where buf_shift-staff.obj-type    = 'маг':U
     6358         and buf_shift-staff.obj-code    = This_Object.obj-code
     6359         and buf_shift-staff.shift-date  = x-date-start
     6360         and buf_shift-staff.shift-num   = x-shift-alone
     6361         and buf_shift-staff.staff-role  = yes
     6362       :
     6363           v-cassir = buf_shift-staff.name.
     6364       end.
     6365       if v-cassir = "" then do:
     6366           for first buf_shift-staff
     6367       where buf_shift-staff.obj-type    = 'маг':U
     6368         and buf_shift-staff.obj-code    = This_Object.obj-code
     6369         and buf_shift-staff.shift-date  = x-date-start
     6370         and buf_shift-staff.shift-num   = x-shift-alone
     6371       :
     6372           v-cassir = buf_shift-staff.name.
     6373       end.
     6374       end.
     6375      run km7xl-write-cell-data in this-procedure (
     6376            input "it_Summ":U
     6377          , input v-summ-total
     6378      ).
     6379      run km7xl-write-cell-data in this-procedure (
     6380            input "it_s_Summ_2":U
     6381          , input v-out-str-ex[2]
     6382      ).
     6383      run km7xl-write-cell-data in this-procedure (
     6384            input "it_s_Summ_1":U
     6385          , input v-out-str-ex[1]
     6386      ).
     6387      run km7xl-write-cell-data in this-procedure (
     6388            input "f_post":U
     6389          , input v-head-position
     6390      ).
     6391      run km7xl-write-cell-data in this-procedure (
     6392            input "f_boss":U
     6393          , input v-director
     6394      ).
     6395      run km7xl-write-cell-data in this-procedure (
     6396            input "f_cashier":U
     6397          , input v-cassir
     6398      ).
     6399      run km7xl-write-cell-data in this-procedure (
     6400            input "it_kop":U
     6401          , input v-kop
     6402      ).
     6403   end.
     6404   if v-head-position = "" then v-head-position = "____________________".
     6405   if v-director      = "" then v-director      = "_________________________".
     6406   if v-cassir        = "" then v-cassir        = "_________________________".
     6407      PAGE STREAM Out-Stream.
     6408      PUT STREAM Out-Stream
     6409          "Выдано покупателям (клиентам) по возвращенным ими чекам (ошибочно пробитым чекам) согласно акту в сумме " v-out-str[1] format "x(60)" Skip
     6410          v-out-str[2]  format "x(180)" SKIP
     6411          "Руководитель"
     6412          v-head-position format "X(20)" AT 15
     6413          UndLine format "X(20)" AT 37
     6414          v-director format "X(30)" AT 59
     6415          "Старший кассир" AT 90
     6416          UndLine format "X(20)" AT 105
     6417          v-cassir format "X(25)" AT 127 SKIP
     6418          "(должность)" format "X(15)" AT 20  "(подпись)" format "X(10)" AT 42  "(расшифровка подписи)" format "X(25)" AT 61
     6419          "(подпись)" format "X(10)" AT 110  "(расшифровка подписи)" format "X(25)" AT 129 SKIP
     6420          "Печатать с оборотом. Подписи печатать на обороте." AT 120
     6421      .
     6422   end procedure.
     6423   PROCEDURE on-same-page :
     6424     define input parameter p-line-number as integer  no-undo .
     6425     if p-line-number > page-size( Out-Stream ) then return .
     6426     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
     6427   end procedure.
