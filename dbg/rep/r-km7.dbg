      735   procedure cur-time :
      736      define output parameter p-today as date      no-undo .
      737      define output parameter p-time  as integer   no-undo .
      738     do
      739     on error undo, return error
      740     :
      741       define variable v-date1 as date      no-undo .
      742       define variable v-date2 as date      no-undo .
      743       define variable v-time  as integer   no-undo .
      744       assign
      745         v-date1 = today
      746         v-time  = time
      747         v-date2 = today
      748       .
      749       if v-date1 <> v-date2
      750       then do:
      751         assign
      752           v-date1 = today
      753           v-time  = v-time
      754         .
      755       end.
      756       assign
      757         p-today = v-date1
      758         p-time  = v-time
      759       .
      760     end.
      761   end.
      762   function cur-time-date returns character
      763   :
      764     return string(today, '99/99/9999':U) .
      765   end.
      766   function cur-time-mjd returns decimal
      767   :
      768     define variable v-date as date      no-undo .
      769     define variable v-time as integer   no-undo .
      770     run cur-time in this-procedure
      771       (output v-date
      772       ,output v-time
      773       ) .
      774     return integer(v-date) - 2400002 + (v-time / 86400) .
      775   end.
      776   function cur-time-get-ending-index returns integer
      777   (input p-number as integer
      778   )
      779   :
      780     if p-number < 0
      781     or p-number = ?
      782     then do:
      783       return 1 .
      784     end.
      785     define variable v-rest as integer   no-undo .
      786     assign
      787       p-number = p-number modulo 100
      788     .
      789     if p-number < 20
      790     then do:
      791       assign
      792         v-rest = p-number
      793       .
      794     end.
      795     else do:
      796       assign
      797         v-rest = p-number modulo 10
      798       .
      799     end.
      800     case v-rest :
      801       when 1
      802       then do:
      803         return 2 .
      804       end.
      805       when 2 or
      806       when 3 or
      807       when 4
      808       then do:
      809         return 3 .
      810       end.
      811       otherwise do:
      812         return 1 .
      813       end.
      814     end case .
      815   end.
      816   procedure cur-time-mjd-to-date :
      817      define input  parameter i-mjd-diff as decimal no-undo.
      818      define output parameter o-Date     as date    no-undo.
      819      define output parameter o-Time     as integer no-undo.
      820      define variable v-day-number as integer   no-undo .
      821      if    i-mjd-diff < 0
      822         or i-mjd-diff = ?
      823      then do:
      824         return "?" .
      825      end.
      826      assign
      827         v-day-number = truncate(i-mjd-diff,0).
      828         o-Date = date(v-day-number + 2400002).
      829         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      830     .
      831   end.
      832   function cur-time-mjd-to-string returns character
      833   (input p-mjd-diff as decimal
      834   )
      835   :
      836     define variable v-day-number as integer   no-undo .
      837     define variable v-seconds    as integer   no-undo .
      838     define variable v-hour       as integer   no-undo .
      839     define variable v-min        as integer   no-undo .
      840     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      841     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      842     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      843     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      844     if p-mjd-diff < 0
      845     or p-mjd-diff = ?
      846     then do:
      847       return "?" .
      848     end.
      849     assign
      850       v-day-number = integer(truncate(p-mjd-diff,0))
      851       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      852     .
      853     if v-seconds > 86400
      854     then do:
      855       assign
      856         v-seconds = 86400 - 1
      857       .
      858     end.
      859     if v-seconds < 0
      860     then do:
      861       assign
      862         v-seconds = 0
      863       .
      864     end.
      865     assign
      866       v-hour = truncate(v-seconds / 3600, 0)
      867     .
      868     assign
      869       v-seconds = v-seconds modulo 3600
      870     .
      871     assign
      872       v-min = truncate(v-seconds / 60, 0)
      873     .
      874     assign
      875       v-seconds = v-seconds modulo 60
      876     .
      877     return
      878         (if v-day-number <> 0
      879           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      880           else ""
      881         )
      882       + (if v-day-number <> 0 or v-hour <> 0
      883           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      884           else ""
      885         )
      886       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      887           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      888           else ""
      889         )
      890       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      891       .
      892   end.
      893   function cur-time-string returns character
      894   :
      895     define variable v-date as date      no-undo .
      896     define variable v-time as integer   no-undo .
      897     run cur-time in this-procedure
      898       (output v-date
      899       ,output v-time
      900       ) .
      901     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      902   end.
      903   function cur-time-string-sec returns character
      904   :
      905     define variable v-date as date      no-undo .
      906     define variable v-time as integer   no-undo .
      907     run cur-time in this-procedure
      908       (output v-date
      909       ,output v-time
      910       ) .
      911     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      912   end.
      913   function cur-time-custom  returns character
      914   (input p-prefix as character
      915   ,input p-date-format as character
      916   ,input p-delimiter as character
      917   ,input p-time-format as character
      918   ,input p-suffix as character
      919   )
      920   :
      921     define variable v-date as date      no-undo .
      922     define variable v-time as integer   no-undo .
      923     run cur-time in this-procedure
      924       (output v-date
      925       ,output v-time
      926       ) .
      927     return
      928       p-prefix
      929       + string(v-date, p-date-format)
      930       + p-delimiter
      931       + string(v-time, p-time-format)
      932       + p-suffix
      933       .
      934   end.
      935   function cur-time-print  returns character
      936   :
      937     define variable v-date as date      no-undo .
      938     define variable v-time as integer   no-undo .
      939     run cur-time in this-procedure
      940       (output v-date
      941       ,output v-time
      942       ) .
      943     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      944   end.
      945   function cur-time-datetime returns datetime
      946   :
      947     define variable v-char as character no-undo .
      948     define variable v-datetime as datetime no-undo .
      949     v-char = cur-time-string().
      950     v-datetime = datetime(v-char).
      951     return  v-datetime.
      952   end.
      953   function cur-time-string-msec returns character
      954   :
      955     define variable v-date as datetime  no-undo .
      956     v-date = now.
      957     return string(v-date) .
      958   end.
      959   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      960   function breakstr returns character ( input        for-name    as character,
      961                                         input        line-length as integer,
      962                                         input-output line1       as character,
      963                                         input-output line2       as character ) :
      964     define variable ii as integer no-undo.
      965     if length( for-name ) > line-length then do:
      966       assign ii    = 1
      967              line1 = "":u
      968              line2 = "":u.
      969       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      970         assign line1 =       substring( for-name, 1, line-length     )
      971                line2 = trim( substring( for-name,    line-length + 1 ) ).
      972       end.                                                     else do:
      973         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      974           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      975                  ii    = ii    + 1.
      976           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      977             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      978           end.
      979         end.
      980         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      981       end.
      982     end.                                else do:
      983       assign line1 = for-name
      984              line2 = "":u.
      985     end.
      986     return ( line1 ).
      987   end function.
