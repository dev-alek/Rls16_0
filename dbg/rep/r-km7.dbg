     3546   procedure torgconf-get-sup-param :
     3547   define input parameter p-obj-type           as character        no-undo.
     3548   define input parameter p-obj-code           as integer          no-undo.
     3549   define input parameter p-curr-code          as integer          no-undo.
     3550       define variable v-host-code    as integer      no-undo.
     3551       define variable v-par-type     as character    no-undo.
     3552   do
     3553   on error undo, return error
     3554   :
     3555       assign
     3556          v-torgconf-sup-host-code = v-host-code
     3557       .
     3558       if v-torgconf-sup-host-code = 0
     3559       then do:
     3560           assign
     3561               v-torgconf-sup-host-name           = "":U
     3562               v-torgconf-sup-host-addres         = "":U
     3563               v-torgconf-sup-host-post-addres    = "":U
     3564               v-torgconf-sup-host-phone          = "":U
     3565               v-torgconf-sup-host-inn            = "":U
     3566               v-torgconf-sup-host-kpp            = "":U
     3567               v-torgconf-sup-host-okpo           = "":U
     3568               v-torgconf-sup-host-egrip-date     = "":U
     3569               v-torgconf-sup-host-egrip-num      = "":U
     3570           .
     3571       end.
     3572       else do:
     3573           run fmtcli-get-client in this-procedure (
     3574                 input 'орг':U
     3575               , input v-torgconf-sup-host-code
     3576           ).
     3577           assign
     3578               v-torgconf-sup-host-name        = v-fmtcli-name
     3579               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     3580               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     3581               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     3582               v-torgconf-sup-host-phone       = v-fmtcli-phone
     3583               v-torgconf-sup-host-inn         = v-fmtcli-inn
     3584               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     3585               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     3586           .
     3587           run gbl/clntat-v.p (
     3588                 input 'орг':U
     3589               , input v-torgconf-sup-host-code
     3590               , input 'egrip-date':U
     3591               , output v-torgconf-sup-host-egrip-date
     3592               , output v-par-type
     3593           ).
     3594           run gbl/clntat-v.p (
     3595                 input 'орг':U
     3596               , input v-torgconf-sup-host-code
     3597               , input 'egrip-num':U
     3598               , output v-torgconf-sup-host-egrip-num
     3599               , output v-par-type
     3600           ).
     3601           run fmtcli-get-bank in this-procedure (
     3602                 input v-host-code
     3603               , input 'орг':U
     3604               , input v-torgconf-sup-host-code
     3605               , input p-curr-code
     3606           ).
     3607       end.
     3608       assign
     3609           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     3610           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     3611           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     3612           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     3613           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     3614           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     3615           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     3616           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     3617       .
     3618       assign
     3619           v-torgconf-sup-obj-type = p-obj-type
     3620           v-torgconf-sup-obj-code = p-obj-code
     3621       .
     3622       if trim(p-obj-type) <> ""
     3623       and p-obj-code <> 0
     3624       then do:
     3625       run fmtcli-get-client in this-procedure (
     3626             input p-obj-type
     3627           , input p-obj-code
     3628       ).
     3629       assign
     3630           v-torgconf-sup-obj-name        = v-fmtcli-name
     3631           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     3632           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     3633           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     3634           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     3635           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     3636           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     3637       .
     3638      end.
     3639      end.
     3640   end procedure.
     3641   procedure torgconf-get-cli-param :
     3642   define input parameter p-host-obj-code      as integer          no-undo.
     3643   define input parameter p-obj-type           as character        no-undo.
     3644   define input parameter p-obj-code           as integer          no-undo.
     3645   define input parameter p-curr-code          as integer          no-undo.
     3646       define variable v-host-code    as integer      no-undo.
     3647   do
     3648   on error undo, return error
     3649   :
     3650       assign
     3651           v-torgconf-cli-type = p-obj-type
     3652           v-torgconf-cli-code = p-obj-code
     3653       .
     3654       run fmtcli-get-client in this-procedure (
     3655             input p-obj-type
     3656           , input p-obj-code
     3657       ).
     3658       assign
     3659           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     3660           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     3661           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     3662           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     3663           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     3664           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     3665           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     3666           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     3667       .
     3668      run fmtcli-get-bank in this-procedure (
     3669             input p-host-obj-code
     3670           , input p-obj-type
     3671           , input p-obj-code
     3672           , input p-curr-code
     3673       ).
     3674       assign
     3675           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     3676           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     3677           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     3678           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     3679           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     3680           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     3681           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     3682           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     3683       .
     3684   end.
     3685   end procedure.
     3686   procedure torgconf-get-ship-param :
     3687   define input parameter p-host-obj-code      as integer          no-undo.
     3688   define input parameter p-obj-type           as character        no-undo.
     3689   define input parameter p-obj-code           as integer          no-undo.
     3690   define input parameter p-curr-code          as integer          no-undo.
     3691       define variable v-host-code    as integer      no-undo.
     3692   do
     3693   on error undo, return error
     3694   :
     3695       assign
     3696           v-torgconf-ship-type = p-obj-type
     3697           v-torgconf-ship-code = p-obj-code
     3698       .
     3699       if trim(p-obj-type) = ""
     3700       and p-obj-code = 0
     3701       then do:
     3702       assign
     3703           v-torgconf-ship-name         = "":U
     3704           v-torgconf-ship-addres       = "":U
     3705           v-torgconf-ship-post-addres  = "":U
     3706           v-torgconf-ship-phone        = "":U
     3707           v-torgconf-ship-inn          = "":U
     3708           v-torgconf-ship-kpp          = "":U
     3709           v-torgconf-ship-okpo         = "":U
     3710       .
     3711       end.
     3712       else do:
     3713       run fmtcli-get-client in this-procedure (
     3714             input p-obj-type
     3715           , input p-obj-code
     3716       ).
     3717       assign
     3718           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     3719           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     3720           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     3721           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     3722           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     3723           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     3724           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     3725           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     3726       .
     3727       end.
     3728           run fmtcli-get-bank in this-procedure (
     3729             input p-host-obj-code
     3730           , input p-obj-type
     3731           , input p-obj-code
     3732           , input p-curr-code
     3733       ).
     3734       assign
     3735           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     3736           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     3737           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     3738           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     3739           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     3740           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     3741           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     3742           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     3743       .
     3744   end.
     3745   end procedure.
     3746   procedure torgconf-get-holdfirm-code :
     3747   define input parameter p-obj-type   as character        no-undo.
     3748   define input parameter p-obj-code   as integer          no-undo.
     3749   define output parameter p-firm-code as integer          no-undo.
     3750       define variable v-firm-code-str     as character    no-undo.
     3751       define variable v-par-type          as character    no-undo.
     3752       define buffer buf_clients       for ub.clients.
     3753   do
     3754   for buf_clients
     3755   on error undo, return error
     3756   :
     3757       run gbl/clntat-v.p (
     3758             input p-obj-type
     3759           , input p-obj-code
     3760           , input 'holdfirm-code':U
     3761           , output v-firm-code-str
     3762           , output v-par-type
     3763       ).
     3764       assign
     3765           p-firm-code = integer( v-firm-code-str )
     3766       no-error.
     3767       if error-status :error
     3768       then do:
     3769           message
     3770               "Неверно задан код фирмы для печати накладных."
     3771           view-as alert-box warning.
     3772           assign
     3773               p-firm-code = 0
     3774           .
     3775       end.
     3776       else do:
     3777           find first buf_clients no-lock
     3778                where buf_clients.obj-type = 'орг':U
     3779                  and buf_clients.obj-code = p-firm-code
     3780           no-error.
     3781           if not available buf_clients
     3782           then do:
     3783               message
     3784                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     3785                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     3786               view-as alert-box warning.
     3787               assign
     3788                   p-firm-code = 0
     3789               .
     3790           end.
     3791       end.
     3792   end.
     3793   end procedure.
     3794   procedure torgconf-get-post-head:
     3795   define input  parameter p-obj-type             as character        no-undo.
     3796   define input  parameter p-obj-code             as integer          no-undo.
     3797   define output parameter p-torgconf-post-head   as character        no-undo.
     3798      define variable v-host-code         as integer      no-undo.
     3799      define buffer buf_sysconf     for ub.sysconf.
     3800        assign
     3801         p-torgconf-post-head  = ""
     3802        .
     3803   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3804   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     3805     (input  p-obj-type
     3806     ,input  p-obj-code
     3807     ,output v-host-code
     3808     )  .
     3809      find first buf_sysconf no-lock
     3810      where buf_sysconf.host-code = v-host-code
     3811      no-error.
     3812      if available buf_sysconf
     3813      then do:
     3814         assign
     3815            p-torgconf-post-head = buf_sysconf.head-position
     3816         .
     3817      end.
     3818   end procedure.
     3819   procedure torgconf-get-storekeeper:
     3820   define input  parameter p-wrkr                   as integer          no-undo.
     3821   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     3822   define output parameter p-torgconf-post          as character        no-undo.
     3823      define buffer buf_sysconf     for ub.sysconf.
     3824      define buffer buf_person      for ub.person.
     3825      define buffer buf_shop        for ub.shop .
     3826      define buffer buf_store       for ub.store .
     3827      if v-torgconf-outC = "no_print"
     3828      then do:
     3829         assign p-torgconf-post = ""
     3830                p-torgconf-wrkr-name = ""
     3831                .
     3832      end.
     3833      if v-torgconf-outC = "clad_doc"
     3834      then do:
     3835         run rep/get-psn.p
     3836               (input  p-wrkr
     3837               ,output p-torgconf-wrkr-name
     3838               ) .
     3839         find first buf_person no-lock
     3840         where buf_person.psn-code = p-wrkr
     3841         no-error.
     3842         if available buf_person
     3843         then do:
     3844           p-torgconf-post = buf_person.position.
     3845         end.
     3846         if p-torgconf-post = "?":U then p-torgconf-post = "".
     3847         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3848      end.
     3849      if v-torgconf-outC = "clad_obj"
     3850      then do:
     3851         CASE v-torgconf-self-obj-type:
     3852         WHEN 'маг':U
     3853         THEN DO:
     3854            find first buf_shop no-lock
     3855            where buf_shop.obj-code = v-torgconf-self-obj-code
     3856            .
     3857            assign
     3858               p-torgconf-wrkr-name = buf_shop.store-man
     3859               p-torgconf-post = ""
     3860            .
     3861            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3862         END.
     3863         WHEN 'скл':U
     3864         THEN DO:
     3865            find first buf_store no-lock
     3866            where buf_store.obj-code = v-torgconf-self-obj-code
     3867            .
     3868            assign
     3869               p-torgconf-wrkr-name = buf_store.store-man
     3870               p-torgconf-post = ""
     3871            .
     3872            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     3873         END.
     3874         OTHERWISE DO:
     3875            assign
     3876               p-torgconf-post = "":U
     3877               p-torgconf-wrkr-name = "":U
     3878            .
     3879         END.
     3880         END CASE.
     3881      end.
     3882    end procedure.
     3883   procedure torgconf-get-form-header :
     3884   define input parameter p-for-inverse    as logical          no-undo.
     3885   define input parameter p-doc-code       as character        no-undo.
     3886   define input parameter p-print-doc      as logical          no-undo.
     3887   define input parameter p-doc-date       as date             no-undo.
     3888   define input parameter p-fact-date      as date             no-undo.
     3889   define input parameter p-doc-type       as character        no-undo.
     3890   define input parameter p-status_        as character        no-undo.
     3891   define input parameter p-reverse        as logical          no-undo.
     3892   define input parameter p-sf-par         as logical          no-undo.
     3893       define variable v-attr-type         as character    no-undo.
     3894       define variable v-doc-code-standard as logical      no-undo.
     3895       define variable v-doc-date-standard as logical      no-undo.
     3896       define variable v-par-consignee-addres  as character    no-undo.
     3897       define variable v-host-code         as integer      no-undo.
     3898       define variable v-dcode-attr        as character    no-undo.
     3899       define variable v-ddate-attr        as character    no-undo.
     3900       define variable v-doc-date          as character    no-undo.
     3901       define variable v-doc-code          as character    no-undo.
     3902       define variable v-par-type          as character    no-undo.
     3903       define variable v-attr              as character    no-undo.
     3904       define buffer buf_firm          for ub.firm .
     3905       define buffer buf_clients       for ub.clients .
     3906       define buffer buf_sysconf       for ub.sysconf .
     3907       define buffer buf_shop          for ub.shop .
     3908       define buffer buf_store         for ub.store .
     3909       define buffer buf_person        for ub.person .
     3910       define buffer buf_trn-doc       for ub.trn-doc .
     3911       define buffer buf_wth-doc       for ub.wth-doc .
     3912       do
     3913   for buf_firm
     3914     , buf_clients
     3915     , buf_sysconf
     3916     , buf_shop
     3917     , buf_trn-doc
     3918     , buf_person
     3919     , buf_wth-doc
     3920   on error undo, return error
     3921   :
     3922       if p-doc-type = 'при':U
     3923       or p-doc-type = 'возврат':U
     3924       then do:
     3925           assign
     3926               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3927                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3928               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     3929                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     3930               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     3931                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     3932               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     3933                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     3934               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     3935               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     3936               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     3937               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     3938               v-torgconf-supplier-type    = v-torgconf-cli-type
     3939               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     3940               v-torgconf-saler-type       = v-torgconf-self-host-type
     3941               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     3942               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     3943               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     3944               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     3945               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     3946               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     3947               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     3948               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     3949               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     3950               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     3951               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     3952               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     3953               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     3954               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     3955               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     3956           .
     3957           if v-torgconf-cli-schet-exists = yes
     3958           AND v-form-name                  = "torg12":U
     3959           then do:
     3960               assign
     3961                   v-torgconf-supplier = v-torgconf-supplier
     3962                       + substitute( ", р/с &1 к/с &2"
     3963                                   , v-torgconf-cli-bank-r-schet
     3964                                   , v-torgconf-cli-bank-c-schet
     3965                                   )
     3966                   v-torgconf-suppi = v-torgconf-supplier
     3967                       + substitute( ", р/с &1 к/с &2"
     3968                                   , v-torgconf-cli-bank-r-schet
     3969                                   , v-torgconf-cli-bank-c-schet
     3970                                   )
     3971               .
     3972               if v-torgconf-cli-bank-exists = yes
     3973               then do:
     3974                   assign
     3975                       v-torgconf-supplier = v-torgconf-supplier
     3976                           + substitute( " БИК &1 в &2 &3"
     3977                                       , v-torgconf-cli-bank-bik
     3978                                       , v-torgconf-cli-bank-name
     3979                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3980                                       )
     3981                      v-torgconf-suppi = v-torgconf-supplier
     3982                           + substitute( " БИК &1 в &2 &3"
     3983                                       , v-torgconf-cli-bank-bik
     3984                                       , v-torgconf-cli-bank-name
     3985                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     3986                                       )
     3987                   .
     3988               end.
     3989           end.
     3990           if v-torgconf-self-schet-exists = yes
     3991           AND v-form-name                  = "torg12":U
     3992           then do:
     3993               assign
     3994                   v-torgconf-saler = v-torgconf-saler
     3995                       + substitute( ", р/с &1 к/с &2"
     3996                                   , v-torgconf-self-bank-r-schet
     3997                                   , v-torgconf-self-bank-c-schet
     3998                                   )
     3999               .
     4000               if v-torgconf-self-bank-exists = yes
     4001               then do:
     4002                   assign
     4003                       v-torgconf-saler = v-torgconf-saler
     4004                           + substitute( " БИК &1 в &2 &3"
     4005                                       , v-torgconf-self-bank-bik
     4006                                       , v-torgconf-self-bank-name
     4007                                       , v-torgconf-self-bank-addres
     4008                                       )
     4009                   .
     4010               end.
     4011           end.
     4012           if v-torgconf-sup-schet-exists = yes
     4013           AND v-form-name                  = "torg12":U
     4014           then do:
     4015               assign
     4016                   v-torgconf-consignee = v-torgconf-consignee
     4017                       + substitute( ", р/с &1 к/с &2"
     4018                                   , v-torgconf-sup-bank-r-schet
     4019                                   , v-torgconf-sup-bank-c-schet
     4020                                   )
     4021               .
     4022             if v-torgconf-sup-bank-exists = yes
     4023              then do:
     4024                assign
     4025                   v-torgconf-consignee = v-torgconf-consignee
     4026                           + substitute( " БИК &1 в &2 &3"
     4027                                       , v-torgconf-sup-bank-bik
     4028                                       , v-torgconf-sup-bank-name
     4029                                       , v-torgconf-sup-bank-addres
     4030                                       )
     4031                   .
     4032               end.
     4033           end.
     4034      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     4035      then do:
     4036          assign
     4037            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     4038                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     4039                                                   , v-torgconf-cli-name
     4040                                                   , ( if v-torgconf-outprncd = yes
     4041                                                         then substitute( " (&1)", v-torgconf-cli-code )
     4042                                                         else "":U )
     4043                                                   , v-torgconf-cli-post-addres
     4044                                                   , v-torgconf-cli-phone
     4045                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     4046                                                       AND v-form-name                  = "torg12":U
     4047                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     4048                                                               , v-torgconf-cli-bank-r-schet
     4049                                                               , v-torgconf-cli-bank-c-schet
     4050                                                               , v-torgconf-cli-bank-bik
     4051                                                               , v-torgconf-cli-bank-name
     4052                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     4053                                                         else "":U )
     4054                                                )
     4055         .
