      636   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      637   procedure paramls-clear :
      638     define buffer buf_temp-param for temp-param .
      639     do
      640     on error undo, return error return-value
      641     :
      642       for each buf_temp-param
      643       on error undo, return error
      644       :
      645         delete buf_temp-param .
      646       end.
      647     end.
      648   end procedure.
      649   procedure paramls-write :
      650     define input  parameter p-code     as character no-undo .
      651     define input  parameter p-sub-code as character no-undo .
      652     define input  parameter p-value    as character no-undo .
      653     define buffer buf_temp-param for temp-param .
      654     do
      655     on error undo, return error return-value
      656     :
      657       find first buf_temp-param
      658         where buf_temp-param.param-code     = p-code
      659           and buf_temp-param.param-sub-code = p-sub-code
      660         no-error .
      661       if not available buf_temp-param then do:
      662         create buf_temp-param .
      663         assign
      664           buf_temp-param.param-code     = p-code
      665           buf_temp-param.param-sub-code = p-sub-code
      666         .
      667       end.
      668       assign
      669         buf_temp-param.param-value = p-value
      670       .
      671     end.
      672   end procedure.
      673   procedure paramls-read :
      674     define input  parameter p-code          as character no-undo .
      675     define input  parameter p-sub-code      as character no-undo .
      676     define input  parameter p-default-value as character no-undo .
      677     define output parameter p-value         as character no-undo .
      678     define buffer buf_temp-param for temp-param .
      679     do
      680     on error undo, return error return-value
      681     :
      682       find first buf_temp-param
      683         where buf_temp-param.param-code     = p-code
      684           and buf_temp-param.param-sub-code = p-sub-code
      685         no-error .
      686       if available buf_temp-param then do:
      687         assign
      688           p-value = buf_temp-param.param-value
      689         .
      690       end.
      691       else do:
      692         assign
      693           p-value = p-default-value
      694         .
      695       end.
      696     end.
      697   end procedure.
      698   procedure paramls-append :
      699     define input  parameter p-code     as character no-undo .
      700     define input  parameter p-sub-code as character no-undo .
      701     define input  parameter p-value    as character no-undo .
      702     define buffer buf_temp-param for temp-param .
      703     do
      704     on error undo, return error return-value
      705     :
      706       find first buf_temp-param
      707            where buf_temp-param.param-code     = p-code
      708              and buf_temp-param.param-sub-code = p-sub-code
      709         no-error .
      710       if not available buf_temp-param then do:
      711         create buf_temp-param .
      712         assign
      713           buf_temp-param.param-code     = p-code
      714           buf_temp-param.param-sub-code = p-sub-code
      715           buf_temp-param.param-value    = p-value
      716         .
      717       end.
      718       else do:
      719           assign
      720               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      721           .
      722       end.
      723     end.
      724   end procedure.
