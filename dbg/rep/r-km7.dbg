       17   define variable vss-revision    as character no-undo initial "$Revision: 71d18cf8f6ea, 2244, rls $":U .
       18   define variable vss-author      as character no-undo initial "$Author: druban $":U .
       19   define variable vss-date        as character no-undo initial "$Date: Wed Dec 25 15:24:00 2019 +0300 $":U .
       20   define variable vss-workfile    as character no-undo initial "$Workfile: r-km7.p $":U .
       21   define variable vss-archive     as character no-undo initial "$Archive: rep/r-km7.p $":U .
