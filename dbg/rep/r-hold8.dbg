      589   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      590   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      591   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      592   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      593   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      594   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      595   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      596   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
