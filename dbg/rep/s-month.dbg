        1   CREATE WIDGET-POOL.
        2   define variable vss-revision    as character no-undo init "$Revision$":U .
        3   define variable vss-author      as character no-undo init "$Author$":U .
        4   define variable vss-date        as character no-undo init "$Date$":U .
        5   define variable vss-workfile    as character no-undo init "$Workfile$":U .
        6   define variable vss-archive     as character no-undo init "$Archive$":U .
        7   define variable vss-description as character no-undo init "Окно выбора месяца для помесячных отчетов".
        8   procedure vss-get-info :
        9     define output parameter p-vss-revision    like vss-revision    no-undo .
       10     define output parameter p-vss-author      like vss-author      no-undo .
       11     define output parameter p-vss-date        like vss-date        no-undo .
       12     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       13     define output parameter p-vss-archive     like vss-archive     no-undo .
       14     define output parameter p-vss-description like vss-description no-undo .
       15     assign
       16       p-vss-revision    = vss-revision
       17       p-vss-author      = vss-author
       18       p-vss-date        = vss-date
       19       p-vss-workfile    = vss-workfile
       20       p-vss-archive     = vss-archive
       21       p-vss-description = vss-description
       22     .
       23   end procedure.
       24   procedure vss-get-parameters :
       25     define output parameter p-vss-parameters as character no-undo .
       26   end procedure.
       27   define new global shared variable g#vssrevis-logger as handle    no-undo .
       28   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       29   define variable v-vssrevis-logger                   as handle    no-undo .
       30   procedure vss-logevent :
       31     define input  parameter p-extra-paramters as character no-undo .
       32     define variable v-vssrevis-parameters as character no-undo .
       33     do
       34     on error undo, return error return-value
       35     :
       36       if  valid-handle(v-vssrevis-logger)
       37       and v-vssrevis-logger :get-signature("logevent") <> ""
       38       then do:
       39         run vss-get-parameters in this-procedure
       40           (output v-vssrevis-parameters
       41           ).
       42         run logevent in v-vssrevis-logger
       43           (input vss-workfile
       44           ,input vss-revision
       45           ,input v-vssrevis-parameters
       46           ,input p-extra-paramters
       47           ).
       48       end.
       49     end.
       50   end procedure.
       51   assign
       52     v-vssrevis-logger = g#vssrevis-logger
       53   .
       54   if  valid-handle(v-vssrevis-logger)
       55   and v-vssrevis-logger :get-signature("logevent") <> ""
       56   then do:
       57     assign
       58       v-vssrevis-logevent = true
       59     .
       60     run vss-logevent in this-procedure (input vss-description) .
       61   end.
       62   define new global shared variable g#language as character no-undo .
       63   if g#language <> '' and g#language <> 'rus':U then do:
       64     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       65   end.
       66   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       67   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       68   def
       69    shared
       70   temp-table  obj-list no-undo
       71     field obj-type like ub.clients.obj-type
       72     field obj-code like ub.clients.obj-code
       73     field obj-name like ub.clients.obj-name
       74     field obj-id   as integer
       75     field db-num   as integer
       76     index pi is primary unique obj-id
       77     index ie1 obj-type obj-code
       78     index ie2 obj-name
       79   .
       80   procedure create_obj-list :
       81      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       82      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       83      do
       84      on error undo, return error return-value
       85      :
       86         define buffer cli-obj for ub.clients .
       87         define variable p-var as integer no-undo .
       88         define buffer buf_obj-list for obj-list .
       89         find last buf_obj-list  use-index pi no-error .
       90         if available buf_obj-list
       91         then
       92            p-var = buf_obj-list.obj-id + 1.
       93         else
       94            p-var = 1.
       95         find first cli-obj where
       96                   cli-obj.obj-type = p-obj-type
       97               and cli-obj.obj-code = p-obj-code
       98         no-lock no-error.
       99         if available cli-obj
      100         then do:
      101            create buf_obj-list.
      102            assign
      103               buf_obj-list.obj-id   = p-var
      104               buf_obj-list.obj-code = cli-obj.obj-code
      105               buf_obj-list.obj-type = cli-obj.obj-type
      106               buf_obj-list.obj-name = cli-obj.obj-name
      107               buf_obj-list.db-num   = cli-obj.db-num
      108            .
      109         end.
      110      end.
      111   end.
      112   DEFINE  shared VARIABLE loc#log as LOGICAL NO-UNDO.
      113   DEFINE  shared VARIABLE loc#db-num as integer NO-UNDO.
      114   DEFINE  shared VARIABLE loc#host-code as integer NO-UNDO.
      115   DEFINE  shared VARIABLE loc#store-code as integer NO-UNDO.
      116   DEFINE  shared VAR vStartPoint        as      date       NO-UNDO.
      117   DEFINE  shared VAR vEndPoint          as      date       NO-UNDO.
      118   DEFINE  shared VAR vStrBuf          as      char       NO-UNDO.
      119   DEFINE  shared VAR vEndLastDay      as  integer     no-undo.
      120   define variable State-source as WIDGET-HANDLE.
      121   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      122   procedure cur-time :
      123      define output parameter p-today as date      no-undo .
      124      define output parameter p-time  as integer   no-undo .
      125     do
      126     on error undo, return error
      127     :
      128       define variable v-date1 as date      no-undo .
      129       define variable v-date2 as date      no-undo .
      130       define variable v-time  as integer   no-undo .
      131       assign
      132         v-date1 = today
      133         v-time  = time
      134         v-date2 = today
      135       .
      136       if v-date1 <> v-date2
      137       then do:
      138         assign
      139           v-date1 = today
      140           v-time  = v-time
      141         .
      142       end.
      143       assign
      144         p-today = v-date1
      145         p-time  = v-time
      146       .
      147     end.
      148   end.
      149   function cur-time-date returns character
      150   :
      151     return string(today, '99/99/9999':U) .
      152   end.
      153   function cur-time-mjd returns decimal
      154   :
      155     define variable v-date as date      no-undo .
      156     define variable v-time as integer   no-undo .
      157     run cur-time in this-procedure
      158       (output v-date
      159       ,output v-time
      160       ) .
      161     return integer(v-date) - 2400002 + (v-time / 86400) .
      162   end.
      163   function cur-time-get-ending-index returns integer
      164   (input p-number as integer
      165   )
      166   :
      167     if p-number < 0
      168     or p-number = ?
      169     then do:
      170       return 1 .
      171     end.
      172     define variable v-rest as integer   no-undo .
      173     assign
      174       p-number = p-number modulo 100
      175     .
      176     if p-number < 20
      177     then do:
      178       assign
      179         v-rest = p-number
      180       .
      181     end.
      182     else do:
      183       assign
      184         v-rest = p-number modulo 10
      185       .
      186     end.
      187     case v-rest :
      188       when 1
      189       then do:
      190         return 2 .
      191       end.
      192       when 2 or
      193       when 3 or
      194       when 4
      195       then do:
      196         return 3 .
      197       end.
      198       otherwise do:
      199         return 1 .
      200       end.
      201     end case .
      202   end.
      203   procedure cur-time-mjd-to-date :
      204      define input  parameter i-mjd-diff as decimal no-undo.
      205      define output parameter o-Date     as date    no-undo.
      206      define output parameter o-Time     as integer no-undo.
      207      define variable v-day-number as integer   no-undo .
      208      if    i-mjd-diff < 0
      209         or i-mjd-diff = ?
      210      then do:
      211         return "?" .
      212      end.
      213      assign
      214         v-day-number = truncate(i-mjd-diff,0).
      215         o-Date = date(v-day-number + 2400002).
      216         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      217     .
      218   end.
      219   function cur-time-mjd-to-string returns character
      220   (input p-mjd-diff as decimal
      221   )
      222   :
      223     define variable v-day-number as integer   no-undo .
      224     define variable v-seconds    as integer   no-undo .
      225     define variable v-hour       as integer   no-undo .
      226     define variable v-min        as integer   no-undo .
      227     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      228     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      229     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      230     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      231     if p-mjd-diff < 0
      232     or p-mjd-diff = ?
      233     then do:
      234       return "?" .
      235     end.
      236     assign
      237       v-day-number = integer(truncate(p-mjd-diff,0))
      238       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      239     .
      240     if v-seconds > 86400
      241     then do:
      242       assign
      243         v-seconds = 86400 - 1
      244       .
      245     end.
      246     if v-seconds < 0
      247     then do:
      248       assign
      249         v-seconds = 0
      250       .
      251     end.
      252     assign
      253       v-hour = truncate(v-seconds / 3600, 0)
      254     .
      255     assign
      256       v-seconds = v-seconds modulo 3600
      257     .
      258     assign
      259       v-min = truncate(v-seconds / 60, 0)
      260     .
      261     assign
      262       v-seconds = v-seconds modulo 60
      263     .
      264     return
      265         (if v-day-number <> 0
      266           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      267           else ""
      268         )
      269       + (if v-day-number <> 0 or v-hour <> 0
      270           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      271           else ""
      272         )
      273       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      274           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      275           else ""
      276         )
      277       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      278       .
      279   end.
      280   function cur-time-string returns character
      281   :
      282     define variable v-date as date      no-undo .
      283     define variable v-time as integer   no-undo .
      284     run cur-time in this-procedure
      285       (output v-date
      286       ,output v-time
      287       ) .
      288     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      289   end.
      290   function cur-time-string-sec returns character
      291   :
      292     define variable v-date as date      no-undo .
      293     define variable v-time as integer   no-undo .
      294     run cur-time in this-procedure
      295       (output v-date
      296       ,output v-time
      297       ) .
      298     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      299   end.
      300   function cur-time-custom  returns character
      301   (input p-prefix as character
      302   ,input p-date-format as character
      303   ,input p-delimiter as character
      304   ,input p-time-format as character
      305   ,input p-suffix as character
      306   )
      307   :
      308     define variable v-date as date      no-undo .
      309     define variable v-time as integer   no-undo .
      310     run cur-time in this-procedure
      311       (output v-date
      312       ,output v-time
      313       ) .
      314     return
      315       p-prefix
      316       + string(v-date, p-date-format)
      317       + p-delimiter
      318       + string(v-time, p-time-format)
      319       + p-suffix
      320       .
      321   end.
      322   function cur-time-print  returns character
      323   :
      324     define variable v-date as date      no-undo .
      325     define variable v-time as integer   no-undo .
      326     run cur-time in this-procedure
      327       (output v-date
      328       ,output v-time
      329       ) .
      330     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      331   end.
      332   function cur-time-datetime returns datetime
      333   :
      334     define variable v-char as character no-undo .
      335     define variable v-datetime as datetime no-undo .
      336     v-char = cur-time-string().
      337     v-datetime = datetime(v-char).
      338     return  v-datetime.
      339   end.
      340   function cur-time-string-msec returns character
      341   :
      342     define variable v-date as datetime  no-undo .
      343     v-date = now.
      344     return string(v-date) .
      345   end.
      346   procedure proc-alt-shift-f2:
      347     if not ibs.th.gbl.gbl-var:rcode
      348   then
      349     run gbl\inidebug.p .
      350   end.
      351   procedure proc-alt-shift-f3:
      352     run gbl/prvssinf.p
      353       ( input this-procedure
      354       ) .
      355   end.
      356   define variable v-inform-launched as logical no-undo initial false .
      357   procedure proc-alt-shift-f4:
      358     define variable v-action as character no-undo .
      359     if v-inform-launched = false then do:
      360       assign
      361         v-inform-launched = true
      362       .
      363       run gbl/d-inform.w
      364         (  input self
      365         ,  input this-procedure
      366         , output v-action
      367         ) no-error .
      368       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      369       assign
      370         v-inform-launched = false
      371       .
      372     end.
      373   end.
      374   procedure proc-alt-f1:
      375     run gbl/corrhelp.p
      376       (input this-procedure
      377       ) .
      378   end .
      379   on alt-shift-f2 anywhere do:
      380     run proc-alt-shift-f2.
      381   end.
      382   on alt-shift-f3 anywhere do:
      383     run proc-alt-shift-f3 in this-procedure .
      384   end.
      385   on alt-shift-f4 anywhere do:
      386     run proc-alt-shift-f4 in this-procedure.
      387   end.
      388   on alt-f1 anywhere do:
      389     run proc-alt-f1 in this-procedure .
      390   end.
      391   define variable stat            as logical      no-undo.
      392   define variable LifeStartDate   as character    no-undo.
      393   define variable v-today         as date         no-undo.
      394   define variable v-time          as integer      no-undo.
      395   RUN set-attribute-list (
      396       'Keys-Accepted = "",
      397        Keys-Supplied = ""':U).
      398   DEFINE RECTANGLE RECT-TimePeriod
      399        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      400        SIZE 24.75 BY 8.92.
      401   DEFINE VARIABLE TimePeriod AS CHARACTER
      402        VIEW-AS SELECTION-LIST SINGLE SCROLLBAR-VERTICAL
      403        SIZE 20.75 BY 8 NO-UNDO.
      404   DEFINE FRAME F-Main
      405        TimePeriod AT ROW 2.5 COL 6.13 NO-LABEL
      406        "Период" VIEW-AS TEXT
      407             SIZE 11.75 BY .75 AT ROW 1.21 COL 9.38
      408             FGCOLOR 4
      409        RECT-TimePeriod AT ROW 2.04 COL 4.13
      410       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      411            SIDE-LABELS NO-UNDERLINE THREE-D
      412            AT COL 1 ROW 1 SCROLLABLE .
      413   ASSIGN
      414          FRAME F-Main:SCROLLABLE       = FALSE
      415          FRAME F-Main:HIDDEN           = TRUE.
      416   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      417   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      418   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      419   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      420   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      421   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      422   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      423   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      424         adm-object-hdl = FRAME F-Main:HANDLE.
      425   RUN ensure-broker.
      426   THIS-PROCEDURE:ADM-DATA =
      427        'ADM1.1~`':U +
      428        'SmartObject~`':U +
      429        '~`':U +
      430        'NO ~`':U +
      431        '~`':U +
      432        '~`':U +
      433        '~`':U +
      434        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      435           + "~`":U +
      436        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      437        'Record-Source,Record-Target,TableIO-Target~`':U +
      438        '~`':U +
      439        '~`~`~`~`~`~`~`~`~`~`~`':U +
      440        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      441            THEN "^^":U
      442        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      443             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      444   PROCEDURE adm-apply-entry :
      445     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      446   END PROCEDURE.
      447   PROCEDURE adm-destroy :
      448    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      449   END PROCEDURE.
      450   PROCEDURE adm-disable :
      451       DISABLE RECT-TimePeriod TimePeriod WITH FRAME F-Main.
      452       RUN dispatch ('disable-fields':U).
      453       RUN set-attribute-list ('ENABLED=no':U).
      454       RETURN.
      455   END PROCEDURE.
      456   PROCEDURE adm-edit-attribute-list :
      457         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      458         RETURN.
      459   END PROCEDURE.
      460   PROCEDURE adm-enable :
      461       ENABLE UNLESS-HIDDEN RECT-TimePeriod TimePeriod WITH FRAME F-Main.
      462       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      463       RUN set-attribute-list ('ENABLED=yes':U).
      464       RETURN.
      465   END PROCEDURE.
      466   PROCEDURE adm-exit :
      467        RUN notify ('exit':U).
      468     RETURN.
      469   END PROCEDURE.
      470   PROCEDURE adm-hide :
      471     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      472   END PROCEDURE.
      473   PROCEDURE adm-initialize :
      474     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      475   END PROCEDURE.
      476   PROCEDURE adm-show-errors :
      477       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      478       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      479           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      480       END.
      481       RETURN.
      482   END PROCEDURE.
      483   PROCEDURE adm-UIB-mode :
      484     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      485   END PROCEDURE.
      486   PROCEDURE adm-view :
      487     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      488   END PROCEDURE.
      489   PROCEDURE dispatch :
      490       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      491       RUN broker-dispatch IN adm-broker-hdl
      492           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      493       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      494   END PROCEDURE.
      495   PROCEDURE ensure-broker :
      496   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      497   IF RETURN-VALUE NE "ADM-Broker":U THEN
      498   DO:
      499       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      500       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      501   END.
      502   END PROCEDURE.
      503   PROCEDURE get-attribute :
      504     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      505     RUN broker-get-attribute IN adm-broker-hdl
      506         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      507     RETURN RETURN-VALUE.
      508   END PROCEDURE.
      509   PROCEDURE get-attribute-list :
      510     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      511     RUN broker-get-attribute-list IN adm-broker-hdl
      512         (INPUT THIS-PROCEDURE,
      513          INPUT ?,
      514          OUTPUT p-attr-list) NO-ERROR.
      515     RETURN.
      516   END PROCEDURE.
      517   PROCEDURE new-state :
      518     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      519     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      520     RETURN.
      521   END PROCEDURE.
      522   PROCEDURE notify :
      523     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      524     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      525     IF RETURN-VALUE = "ADM-ERROR":U THEN
      526         RETURN "ADM-ERROR":U.
      527     RETURN.
      528   END PROCEDURE.
      529   PROCEDURE set-attribute-list :
      530     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      531     RUN ensure-broker.
      532     RUN broker-set-attribute-list IN adm-broker-hdl
      533         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      534     RETURN.
      535   END PROCEDURE.
      536   PROCEDURE set-position :
      537       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      538       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      539       IF VALID-HANDLE(adm-object-hdl) THEN
      540       DO:
      541         ASSIGN adm-object-hdl:ROW    =   p-row
      542                adm-object-hdl:COLUMN =   p-col.
      543       END.
      544       RETURN.
      545   END PROCEDURE.
      546   PROCEDURE adm-display-fields :
      547       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      548       RETURN.
      549   END PROCEDURE.
      550   PROCEDURE adm-open-query :
      551     RETURN.
      552   END PROCEDURE.
      553   PROCEDURE adm-row-changed :
      554         IF VALID-HANDLE(adm-object-hdl) THEN
      555           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      556         RUN notify ('row-available':U).
      557         RETURN.
      558   END PROCEDURE.
      559   PROCEDURE reposition-query :
      560       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      561       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      562       RETURN.
      563   END PROCEDURE.
      564     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      565     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      566     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      567     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      568     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      569     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      570     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      571     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      572     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      573     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      574     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      575     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      576     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      577     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      578     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      579     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      580     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      581     IF "":U = "":U THEN
      582       RUN modify-list-attribute IN adm-broker-hdl
      583         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      584     RUN use-create-on-add(?).
