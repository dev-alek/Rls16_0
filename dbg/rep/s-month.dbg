      644   PROCEDURE check-modified :
      645   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      646   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      647   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      648   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      649     IF check-state = "check":U THEN
      650     DO:
      651       RUN get-link-handle IN adm-broker-hdl
      652         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      653            OUTPUT group-target-list).
      654       IF group-target-list NE "":U THEN
      655       DO i = 1 TO NUM-ENTRIES(group-target-list):
      656         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      657         RUN check-modified IN curr-widget ('group-check':U).
      658         IF RETURN-VALUE NE "":U THEN
      659         DO:
      660           RUN check-modified-message(RETURN-VALUE).
      661           RETURN "":U.
      662         END.
      663       END.
      664     END.
      665     RETURN "":U.
      666   END PROCEDURE.
      667   PROCEDURE check-modified-message :
      668     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      669        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      670           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      671        IF RETURN-VALUE = "YES":U THEN
      672           RUN notify ('view,CONTAINER-SOURCE':U).
      673        MESSAGE IF p-changed-table NE ? THEN
      674           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      675           ELSE "Current values have been changed."
      676           SKIP "  Do you wish to save those changes?"
      677           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      678        IF ANS THEN
      679        DO:
      680           IF group-assign-target THEN
      681             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      682           ELSE RUN dispatch('update-record':U).
      683           IF RETURN-VALUE = "ADM-ERROR":U THEN
      684           DO:
      685               MESSAGE "Changes to the previous record were not saved."
      686                 VIEW-AS ALERT-BOX ERROR.
      687               IF group-assign-target THEN
      688                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      689               ELSE RUN dispatch ('cancel-record':U).
      690           END.
      691        END.
      692        ELSE DO:
      693          IF group-assign-target THEN
      694             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      695          ELSE RUN dispatch('cancel-record':U).
      696        END.
      697        RETURN.
      698   END PROCEDURE.
      699   PROCEDURE get-rowid :
      700       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      701       ASSIGN
      702       p-table   =   adm-first-table.
      703       RETURN.
      704   END PROCEDURE.
      705   PROCEDURE init-group-assign :
      706       RUN request-attribute IN adm-broker-hdl
      707         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      708       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      709         group-assign-target = yes.
      710       ELSE group-assign-target = no.
      711       RETURN.
      712   END PROCEDURE.
      713   PROCEDURE set-editors :
      714       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      715       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      716       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      717       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      718       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      719       DO WHILE VALID-HANDLE (curr-widget):
      720           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      721              curr-widget:HIDDEN = no THEN DO:
      722             CASE p-field-setting:
      723               WHEN "INITIALIZE":U THEN
      724               DO:
      725                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      726                     read-only-list +
      727                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      728                        STRING(curr-widget).
      729               END.
      730               WHEN "DISABLE":U OR
      731               WHEN "ENABLE":U THEN
      732               DO:
      733                   curr-widget:SENSITIVE = yes.
      734                   RUN get-attribute ('Read-Only-Editors':U).
      735                   IF RETURN-VALUE = ? OR
      736                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      737                       curr-widget:READ-ONLY =
      738                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      739               END.
      740               WHEN "CLEAR":U THEN
      741                   curr-widget:SCREEN-VALUE = "":U.
      742             END CASE.
      743           END.
      744           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      745       END.
      746       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      747         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      748           + '"':U).
      749       RETURN.
      750   END PROCEDURE.
      751   PROCEDURE use-check-modified-all :
      752    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      753     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
      754     RETURN.
      755   END PROCEDURE.
      756   PROCEDURE use-create-on-add :
      757   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      758      RETURN.
      759   END PROCEDURE.
      760   PROCEDURE use-initial-lock :
      761     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      762     ASSIGN adm-initial-lock = p-attr-value.
      763     RETURN.
      764   END PROCEDURE.
      765     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
      766   if not this-procedure :persistent
      767   then do:
      768     message
      769       vss-workfile vss-revision vss-description skip
      770       "Ошибка при запуске процедуры" skip
      771       "Данную процедуру следует запускать только с параметром persistent" skip
      772       view-as alert-box error .
      773     undo, return error .
      774   end.
      775   PROCEDURE adm-row-available :
      776     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
      777     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
      778     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
      779     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
      780     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
      781     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
      782     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
      783     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
      784     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
      785     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
      786     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
      787     IF adm-updating-record THEN RETURN.
      788     RUN get-attribute ('FIELDS-ENABLED':U).
      789     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
      790     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
      791         OUTPUT link-handle) NO-ERROR.
      792     IF link-handle = "":U THEN
      793         RETURN.
      794     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
      795     IF NUM-ENTRIES(link-handle) > 1 THEN
      796         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
      797             "encountered more than one RECORD-SOURCE.":U SKIP
      798             "The first - ":U record-source-hdl:file-name " - will be used.":U
      799                VIEW-AS ALERT-BOX ERROR.
      800     RUN get-attribute ('Key-Name':U).
      801     key-name = RETURN-VALUE.
      802     IF key-name = "":U THEN key-name = ?.
      803     IF key-name NE ? THEN DO:
      804       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
      805         NO-ERROR.
      806       IF key-value NE ? THEN
      807         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
      808     END.
      809   IF VALID-HANDLE (adm-object-hdl) THEN
      810       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      811   RUN notify IN THIS-PROCEDURE ('row-available':U).
      812   END PROCEDURE.
      813   PROCEDURE Assign-Frame :
      814   ASSIGN frame F-Main
      815   TimePeriod
      816   .
      817   vStrBuf  = TimePeriod:screen-value .
      818   assign
      819   vStartPoint = date ( integer ( substring ( vStrBuf, 1, 2 ) ),
      820                       integer ( "01" ) , integer( trim( substring( vStrBuf, 3 ) ) ) )
      821   vEndPoint = date ( integer ( substring ( vStrBuf, 1, 2 ) ), integer ( "01" ) ,
      822                     integer ( trim ( substring ( vStrBuf , 3 ) ) ) ) .
      823   run gbl/lastday.p ( input vEndPoint, output vEndLastDay ) .
      824   vEndPoint = date( integer( substring( vStrBuf, 1, 2 ) ), vEndLastDay,
      825                    integer( trim( substring( vStrBuf, 3 ) ) ) ) .
      826   END PROCEDURE.
      827   PROCEDURE disable_UI :
      828     HIDE FRAME F-Main.
      829     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
      830   END PROCEDURE.
      831   PROCEDURE local-initialize :
      832     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
      833     run cur-time in this-procedure ( output v-today
      834                                    , output v-time
      835                                    ).
      836   define variable CurrMonth  as       integer    no-undo.
      837   define variable CurrYear   as      integer    no-undo.
      838   define variable DatasBuf   as      character  no-undo.
      839       get-key-value section "REP-SETS" key "StartDate" value LifeStartDate.
      840       assign
      841           CurrMonth = month ( date ( LifeStartDate ) )
      842           CurrYear = year ( date ( LifeStartDate ) ) .
      843       do while CurrYear < year ( today ) :
      844           do while CurrMonth <= 12 :
      845               DatasBuf = DatasBuf +
      846                   string ( CurrMonth, "99" ) + fill( " ", 5 ) + string ( CurrYear, "9999" ) + "," .
      847               CurrMonth = CurrMonth + 1 .
      848           end.
      849           assign
      850               CurrMonth = 1
      851               CurrYear = CurrYear + 1 .
      852       end.
      853       do CurrMonth = 1 to month ( today ) :
      854           DatasBuf = DatasBuf +
      855                               string ( CurrMonth, "99" ) + fill( " ", 5 ) + string ( CurrYear, "9999" ) + "," .
      856       end.
      857       TimePeriod:list-items in frame F-Main = right-trim ( datasbuf, "," ) .
      858       stat = TimePeriod:scroll-to-item( TimePeriod:num-items in frame F-Main )
      859           in frame F-Main .
      860     stat = TimePeriod :scroll-to-item( TimePeriod:num-items in frame F-Main) in frame F-Main .
      861     TimePeriod:screen-value in frame F-Main = entry( TimePeriod:num-items, TimePeriod:list-items ) .
      862     apply "value-changed" to TimePeriod in FRAME F-Main.
      863   END PROCEDURE.
      864   PROCEDURE send-records :
      865   END PROCEDURE.
      866   PROCEDURE state-changed :
      867     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
      868     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
      869     CASE p-state:
      870       WHEN 'update-begin':U THEN DO:
      871           RUN dispatch('enable-fields':U).
      872           IF RETURN-VALUE = "ADM-ERROR":U THEN
      873           DO:
      874             RUN new-state('update-failed,TABLEIO-SOURCE':U).
      875             RUN new-state('update-complete':U).
      876           END.
      877           ELSE RUN new-state ('update':U).
      878       END.
      879       WHEN 'update-complete':U THEN DO:
      880           RUN new-state ('update-complete':U).
      881       END.
      882     END CASE.
      883   END PROCEDURE.
