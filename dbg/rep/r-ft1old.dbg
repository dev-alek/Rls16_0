     9540                       p-avg-prt-price-no-tax      = price-noNDS
     9541                       p-avg-VAT                   = prt-VAT-gds
     9542                       p-avg-prt-sum-with-tax      = prt-stoim
     9543                       p-avg-prt-sum-without-tax   = prt-stoim-noNDS
     9544                   .
     9545                   else assign
     9546                       v-avg-VAT-out                 = p-avg-VAT                  * gds-dtl.fact-qnty
     9547                       v-avg-prt-sum-with-tax-out    = p-avg-prt-sum-with-tax     * gds-dtl.fact-qnty
     9548                       v-avg-prt-sum-without-tax-out = p-avg-prt-sum-without-tax  * gds-dtl.fact-qnty
     9549                   .
