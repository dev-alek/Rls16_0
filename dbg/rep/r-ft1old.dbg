     3457            .
     3458         END.
     3459         OTHERWISE DO:
     3460            assign
     3461               v-torgconf-main-buh  = "":U
     3462            .
     3463         END.
     3464         END CASE.
     3465      end.
     3466      if v-torgconf-outR = "no_print"
     3467         then do:
     3468            assign
     3469               v-torgconf-main-boss = ""
     3470               v-torgconf-main-boss-post = ""
     3471            .
     3472         end.
