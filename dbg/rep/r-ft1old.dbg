     9606           end.
     9607   end.
     9608   end procedure.
     9609   procedure print-header :
     9610   define input parameter p-trn-doc-code   as character        no-undo.
     9611   define variable v-print-doc                 as character                no-undo.
     9612       define buffer buf_trn-doc       for trn-doc.
     9613       define buffer buf_clients           for clients .
     9614       define buffer buf_temp_p-fmt_string-part    for temp_p-fmt_string-part.
     9615   do
     9616   for buf_trn-doc
     9617     , buf_clients
     9618     , buf_temp_p-fmt_string-part
     9619   on error undo, return error
     9620   :
     9621       find first buf_trn-doc no-lock
     9622            where buf_trn-doc.doc-code = p-trn-doc-code
     9623       .
     9624       run gbl/conf-rd.p ( "factur01", "", "", 0, "", "", "", no, output v-print-doc, output v-par-type ) no-error.
     9625       if error-status :error
     9626       then do:
     9627           assign
     9628               v-print-doc = "no"
     9629           .
     9630       end.
     9631       assign
     9632       p-sf-par = no
     9633       .
     9634       run torgconf-get-form-header in this-procedure (
     9635             input Invers
     9636           , input buf_trn-doc.doc-code
     9637           , input ( v-print-doc = "yes" )
     9638           , input buf_trn-doc.doc-date
     9639           , input buf_trn-doc.fact-date
     9640           , input buf_trn-doc.doc-type
     9641           , input buf_trn-doc.status_
     9642           , input p-reverse
     9643           , input p-sf-par
     9644       ).
     9645       run r-f_t1xl-write-cell-data in this-procedure (
     9646             input "h_docCode":U
     9647           , input v-torgconf-doc-code
     9648       ).
     9649       run r-f_t1xl-write-cell-data in this-procedure (
     9650             input "h_tbl_docCode":U
     9651           , input v-torgconf-vdoc-code
     9652       ).
     9653       run r-f_t1xl-write-cell-data in this-procedure (
     9654             input "h_docDate":U
     9655           , input v-torgconf-doc-date
     9656       ).
