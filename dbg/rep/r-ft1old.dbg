     9658             input "h_tbl_docDate":U
     9659           , input v-torgconf-vdoc-date
     9660       ).
     9661       find first buf_clients no-lock
     9662            where buf_clients.obj-type = buf_trn-doc.obj-type
     9663              and buf_clients.obj-code = buf_trn-doc.obj-code
     9664       no-error.
     9665       case buf_clients.obj-type :
     9666           when 'маг':U
     9667           then do:
     9668               find first shop where shop.obj-code = buf_clients.obj-code no-lock .
     9669               tdoc-prt = shop.doc-prt.
     9670           end.
     9671           when 'скл':U
     9672           then do:
     9673               find first store where store.obj-code = buf_clients.obj-code no-lock .
     9674               tdoc-prt = store.doc-prt .
     9675           end.
     9676       end case.
     9677       if not tdoc-prt or Invers = yes
     9678       then do:
     9679           assign
     9680               PrintScale = no
     9681           .
     9682       end.
     9683       find first pay-type no-lock
     9684            where pay-type.obj-code = buf_trn-doc.pay-code
     9685       no-error .
     9686       run r-f_t1xl-write-cell-data in this-procedure (
     9687           input "h_orgFrom":U
     9688         , input v-torgconf-organization
     9689       ).
     9690       define var v-temp-phone as character.
