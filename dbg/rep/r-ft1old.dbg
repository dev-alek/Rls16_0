     9854                           input 'ndog':U ,
     9855                          output v-osnov-num-attr ,
     9856                          output v-attr-type ) no-error .
     9857   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     9858                           input 'ddog':U ,
     9859                          output v-osnov-date-attr ,
     9860                          output v-attr-type ) no-error .
     9861   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     9862                           input 'nosn':U ,
     9863                          output v-osnov-attr ,
     9864                          output v-attr-type ) no-error .
     9865      if trim(v-osnov-num-attr)  = ""
     9866      or trim(v-osnov-date-attr) = ""
     9867      or trim(v-osnov-attr)      = ""
     9868      then do:
     9869       if buf_trn-doc.ext-doc-type = 'ie':U
     9870       or buf_trn-doc.ext-doc-type = 'ee':U
     9871       then do:
     9872           FIND FIRST buf_contract
     9873                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
     9874                     NO-LOCK
     9875                     NO-ERROR
     9876                     .
     9877               IF AVAILABLE  buf_contract
     9878               THEN DO:
     9879               ASSIGN
     9880                  v-osnov-num-doc   = buf_contract.contract-prn-code
     9881                  v-osnov-date-doc  = STRING(buf_contract.contract-date)
     9882                  v-osnov-doc       = buf_contract.contract-name
     9883               .
     9884               END.
     9885       end.
     9886       run gbl/conf-rd.p ( "is-fin"
     9887                     , v-host-code
     9888                     , buf_trn-doc.obj-type
     9889                     , buf_trn-doc.obj-code
     9890                     , ""
     9891                     , ""
     9892                     , ""
     9893                     , no
     9894                     , output v-is-fin
     9895                     , output v-par-type
     9896                     ) no-error .
     9897       if error-status :error
     9898       then  do:
     9899          assign
     9900                v-is-fin           = ""
     9901          .
     9902       end.
     9903       IF v-is-fin = "yes"
     9904       THEN DO:
     9905         CASE buf_trn-doc.doc-type:
     9906            WHEN 'при':U then  do:
     9907               FIND FIRST buf_contract
     9908                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
     9909                     NO-LOCK
     9910                     NO-ERROR
     9911                     .
     9912               IF AVAILABLE  buf_contract
     9913               THEN DO:
     9914               ASSIGN
     9915                  v-osnov-num   = buf_contract.contract-prn-code
     9916                  v-osnov-date  = STRING(buf_contract.contract-date)
     9917                  v-osnov       = buf_contract.contract-name
     9918               .
     9919               END.
     9920            end.
     9921            WHEN 'рас':U THEN DO:
     9922            v-ind = 0.
     9923               _single-reason:
     9924               FOR EACH bf_doc-line
     9925                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
     9926                  NO-LOCK
     9927                  ,
     9928                  FIRST bf_goods
     9929                  WHERE bf_goods.artic      = bf_doc-line.artic
     9930                  and bf_goods.prod-type    = bf_doc-line.prod-type
     9931                  and bf_goods.prod-code    = bf_doc-line.prod-code
     9932                  NO-LOCK
     9933                  ,
     9934                  EACH bf_parts
     9935                  where bf_parts.obj-type   = bf_doc-line.obj-type
     9936                  and bf_parts.obj-code     = bf_doc-line.obj-code
     9937                  and bf_parts.artic        = bf_doc-line.artic
     9938                  and bf_parts.prod-type    = bf_doc-line.prod-type
     9939                  and bf_parts.prod-code    = bf_doc-line.prod-code
     9940                  and bf_parts.out-code     = bf_doc-line.doc-code
     9941                  NO-LOCK
     9942                  :
     9943                  assign
     9944                     v-ind = v-ind + 1.
     9945                     FIND FIRST buf_contract
     9946                           WHERE buf_contract.contract-code = bf_parts.contract-code
     9947                           NO-LOCK
     9948                           NO-ERROR
     9949                           .
     9950                     IF AVAILABLE  buf_contract
     9951                     THEN DO:
     9952                     ASSIGN
     9953                        v-osnov-num-1   = buf_contract.contract-prn-code
     9954                        v-osnov-date    = STRING(buf_contract.contract-date)
     9955                        v-osnov         = buf_contract.contract-name
     9956                     .
     9957                     END.
     9958                     IF v-osnov-num = ?
     9959                     and v-ind = 1
     9960                     THEN DO:
     9961                        ASSIGN
     9962                           v-osnov-num = v-osnov-num-1
     9963                        .
     9964                     END.
     9965                     IF v-osnov-num  <> v-osnov-num-1
     9966                     THEN DO:
     9967                        ASSIGN
     9968                           v-osnov-num   = ?
     9969                           v-osnov-date  = ?
     9970                           v-osnov       = ""
     9971                        .
     9972                        LEAVE _single-reason.
     9973                     END.
     9974               END.
     9975               IF v-osnov-num   = ?
     9976               THEN
     9977               _single-income-reason:
     9978               FOR EACH bf_doc-line
     9979                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
     9980                  NO-LOCK
     9981                  ,
     9982                  FIRST bf_goods
     9983                  WHERE bf_goods.artic      = bf_doc-line.artic
     9984                  and bf_goods.prod-type    = bf_doc-line.prod-type
     9985                  and bf_goods.prod-code    = bf_doc-line.prod-code
     9986                  NO-LOCK
     9987                  ,
     9988                  EACH bf_parts
     9989                  where bf_parts.obj-type   = bf_doc-line.obj-type
     9990                  and bf_parts.obj-code     = bf_doc-line.obj-code
     9991                  and bf_parts.artic        = bf_doc-line.artic
     9992                  and bf_parts.prod-type    = bf_doc-line.prod-type
     9993                  and bf_parts.prod-code    = bf_doc-line.prod-code
     9994                  and bf_parts.out-code     = bf_doc-line.doc-code
     9995                  NO-LOCK
     9996                  :
     9997                     FIND FIRST bf_trn-doc
     9998                        WHERE bf_trn-doc.doc-code     = bf_parts.in-code
     9999                        NO-LOCK
    10000                        NO-ERROR
    10001                        .
    10002                     IF AVAILABLE bf_trn-doc THEN DO:
    10003                        IF bf_trn-doc.ext-doc-type <> 'ie':U
    10004                        THEN DO:
    10005                           run find-income-doc-code ( input bf_parts.in-code
    10006                                                      , input bf_goods.gds-code
    10007                                                      , input bf_parts.part-code
    10008                                                      , output v-income-doc-code
    10009                                                      ) .
    10010                           if v-income-doc-code <> ? then do:
    10011                              find first bf_trn-doc
    10012                                    no-lock
    10013                                    where bf_trn-doc.doc-code = v-income-doc-code
    10014                                    no-error
    10015                                    .
    10016                              IF NOT AVAILABLE bf_trn-doc
    10017                              THEN DO:
    10018                                 ASSIGN
    10019                                    v-osnov-num   = ?
    10020                                    v-osnov-date  = ?
    10021                                    v-osnov       = ""
    10022                                 .
    10023                                 LEAVE _single-income-reason.
    10024                              END.
    10025                           END.
    10026                        END.
    10027                     END.
    10028                     ELSE DO:
    10029                        ASSIGN
    10030                           v-osnov-num   = ?
    10031                           v-osnov-date  = ?
    10032                           v-osnov       = ""
    10033                        .
    10034                        LEAVE _single-income-reason.
    10035                     END.
    10036                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
    10037                                       , input  'ndog':U
    10038                                       , output v-osnov-num-1
    10039                                       , output v-attr-type
    10040                                       ) .
    10041                     IF v-osnov-num = ?
    10042                     THEN DO:
    10043                        ASSIGN
    10044                           v-osnov-num = v-osnov-num-1
    10045                        .
    10046                     END.
    10047                     run gbl/trdcat-v.p  ( input bf_trn-doc.doc-code
    10048                                       , input 'ddog':U
    10049                                       , output v-osnov-date-1
    10050                                       , output v-attr-type
    10051                                       ) .
    10052                     IF v-osnov-date = ?
    10053                     THEN DO:
    10054                        ASSIGN
    10055                           v-osnov-date = v-osnov-date-1
    10056                        .
    10057                     END.
    10058                     IF v-osnov-num  <> v-osnov-num-1
    10059                     OR v-osnov-date <> v-osnov-date-1
    10060                     THEN DO:
    10061                        ASSIGN
    10062                           v-osnov-num   = ?
    10063                           v-osnov-date  = ?
    10064                           v-osnov       = ""
    10065                        .
    10066                        LEAVE _single-income-reason.
    10067                     END.
    10068               END.
    10069            END.
    10070            OTHERWISE DO:
    10071            END.
    10072         END case.
    10073       END.
    10074       ELSE DO:
    10075         CASE buf_trn-doc.doc-type:
    10076            WHEN 'рас':U THEN DO:
    10077            v-ind2 = 0.
    10078               _single-reason:
    10079               FOR EACH bf_doc-line
    10080                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
    10081                  NO-LOCK
    10082                  ,
    10083                  FIRST bf_goods
    10084                  WHERE bf_goods.artic      = bf_doc-line.artic
    10085                  and bf_goods.prod-type    = bf_doc-line.prod-type
    10086                  and bf_goods.prod-code    = bf_doc-line.prod-code
    10087                  NO-LOCK
    10088                  ,
    10089                  EACH bf_parts
    10090                  where bf_parts.obj-type   = bf_doc-line.obj-type
    10091                  and bf_parts.obj-code     = bf_doc-line.obj-code
    10092                  and bf_parts.artic        = bf_doc-line.artic
    10093                  and bf_parts.prod-type    = bf_doc-line.prod-type
    10094                  and bf_parts.prod-code    = bf_doc-line.prod-code
    10095                  and bf_parts.out-code     = bf_doc-line.doc-code
    10096                  NO-LOCK
    10097                  :
    10098                  assign
    10099                  v-ind2 = v-ind2 + 1.
    10100                     FIND FIRST bf_trn-doc
    10101                        WHERE bf_trn-doc.doc-code   = bf_parts.in-code
    10102                        NO-LOCK
    10103                        NO-ERROR
    10104                        .
    10105                     IF AVAILABLE bf_trn-doc THEN DO:
    10106                        IF bf_trn-doc.ext-doc-type <> 'ie':U
    10107                        THEN DO:
    10108                           run find-income-doc-code ( input bf_parts.in-code
    10109                                                      , input bf_goods.gds-code
    10110                                                      , input bf_parts.part-code
    10111                                                      , output v-income-doc-code
    10112                                                      ) .
    10113                           if v-income-doc-code <> ? then do:
    10114                              find first bf_trn-doc
    10115                                    no-lock
    10116                                    where bf_trn-doc.doc-code = v-income-doc-code
    10117                                    no-error
    10118                                    .
    10119                              IF NOT AVAILABLE bf_trn-doc
    10120                              THEN DO:
    10121                                 ASSIGN
    10122                                    v-osnov-num   = ?
    10123                                    v-osnov-date  = ?
    10124                                    v-osnov       = ""
    10125                                 .
    10126                                 LEAVE _single-reason.
    10127                              END.
    10128                           END.
    10129                        END.
    10130                     END.
    10131                     ELSE DO:
    10132                     ASSIGN
    10133                        v-osnov-num   = ?
    10134                        v-osnov-date  = ?
    10135                        v-osnov       = ""
    10136                     .
    10137                     LEAVE _single-reason.
    10138                     END.
    10139                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
    10140                                       , input  'ndog':U
    10141                                       , output v-osnov-num-1
    10142                                       , output v-attr-type
    10143                                       ) .
    10144                     IF v-osnov-num = ?
    10145                     and v-ind2 = 1
    10146                     THEN DO:
    10147                        ASSIGN
    10148                           v-osnov-num = v-osnov-num-1
    10149                        .
    10150                     END.
    10151                     run gbl/trdcat-v.p  ( input bf_trn-doc.doc-code
    10152                                       , input 'ddog':U
    10153                                       , output v-osnov-date-1
    10154                                       , output v-attr-type
    10155                                       ) .
    10156                     IF v-osnov-date = "":U
    10157                     and v-ind2 = 1
    10158                     THEN DO:
    10159                        ASSIGN
    10160                           v-osnov-date = v-osnov-date-1
    10161                        .
    10162                     END.
    10163                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
    10164                                       , input  'nosn':U
    10165                                       , output v-osnov-1
    10166                                       , output v-attr-type
    10167                                       ) .
    10168                     IF v-osnov = "":U
    10169                     and v-ind2 = 1
    10170                     THEN DO:
    10171                        ASSIGN
    10172                           v-osnov = v-osnov-1
    10173                        .
    10174                     END.
    10175                     IF v-osnov-num  <> v-osnov-num-1
    10176                     OR v-osnov-date <> v-osnov-date-1
    10177                     or v-osnov      <> v-osnov-1
    10178                     THEN DO:
    10179                        ASSIGN
    10180                           v-osnov-num   = ?
    10181                           v-osnov-date  = ?
    10182                           v-osnov       = ""
    10183                        .
    10184                        LEAVE _single-reason.
    10185                     END.
    10186               END.
    10187            END.
    10188            OTHERWISE DO:
    10189            END.
    10190         END CASE.
    10191       END.
    10192       end.
    10193       if buf_trn-doc.ext-doc-type = 'ie':U
    10194       or buf_trn-doc.ext-doc-type = 'ee':U
    10195       then do:
    10196           assign
    10197            v-osnov-num  = v-osnov-num-doc
    10198            v-osnov-date = v-osnov-date-doc
    10199            v-osnov      = v-osnov-doc
    10200           .
    10201       end.
    10202       if trim(v-osnov-num-attr)  <> ""
    10203       then do:
    10204           v-osnov-num = v-osnov-num-attr.
    10205       end.
    10206       if trim(v-osnov-date-attr)  <> ""
    10207       then do:
    10208           v-osnov-date = v-osnov-date-attr.
    10209       end.
    10210       if trim(v-osnov-attr)  <> ""
    10211       then do:
    10212           v-osnov = v-osnov-attr.
    10213       end.
    10214       IF v-osnov-date  = ?
    10215       THEN DO:
    10216         ASSIGN
    10217            v-osnov-date  = ""
    10218         .
    10219       END.
    10220       IF v-osnov-num   = ?
    10221       THEN DO:
    10222         ASSIGN
    10223            v-osnov-num   = ""
    10224            v-osnov-date  = ""
    10225            v-osnov       = ""
    10226         .
    10227       END.
    10228       run r-f_t1xl-write-cell-data in this-procedure (
    10229           input "h_saler":U
    10230           , input SUBSTITUTE( "&1 ИНН &2 КПП &3"
    10231                                                             , v-torgconf-saler
    10232                                                             , v-torgconf-saler-inn
    10233                                                             , v-torgconf-saler-kpp
    10234                                                             )
    10235       ).
    10236       run r-f_t1xl-write-cell-data in this-procedure (
    10237           input "h_saler1":U
    10238           , input SUBSTITUTE( "&1 ИНН &2 КПП &3"
    10239                                                             , v-torgconf-saler
    10240                                                             , v-torgconf-saler-inn
    10241                                                             , v-torgconf-saler-kpp
    10242                                                             )
    10243       ).
    10244       run r-f_t1xl-write-cell-data in this-procedure (
    10245             input "h_osn_doc_code"
    10246           , input v-osnov-num
    10247       ).
    10248       run r-f_t1xl-write-cell-data in this-procedure (
    10249             input "h_osn_doc_date"
    10250           , input v-osnov-date
    10251       ).
    10252       run r-f_t1xl-write-cell-data in this-procedure (
    10253           input "h_reason":U
    10254           , input v-osnov
    10255       ).
    10256       run r-f_t1xl-write-cell-data in this-procedure (
    10257           input "h_reason_num":U
    10258           , input v-osnov-num
    10259       ).
    10260       run r-f_t1xl-write-cell-data in this-procedure (
    10261           input "h_reason_date":U
    10262           , input v-osnov-date
    10263       ).
    10264       define variable v-operation-type    as character    no-undo.
    10265       assign
    10266           v-operation-type = ( if v-ext-doc-type = 'ep':U
    10267                                then ( if lookup( "MARI":U, p-mode ) = 0
    10268                                       then "возврат пост-ку"
    10269                                       else "":U )
    10270                                else ( if buf_trn-doc.doc-type = 'при':U and not Invers
    10271                                       then " приход"
    10272                                       else ( if buf_trn-doc.doc-type = 'возврат':U
    10273                                              then ( if lookup( "MARI":U, p-mode ) = 0
    10274                                                     then " возврат"
    10275                                                     else "":U )
    10276                                              else " расход" ) )
    10277                              )
    10278       .
    10279       run r-f_t1xl-write-cell-data in this-procedure (
    10280             input "h_operationType":U
    10281           , input v-operation-type
    10282       ).
    10283   end.
    10284   end procedure.
    10285   procedure print-line-sj :
    10286   define input parameter p-doc-code       as character        no-undo.
    10287   define input parameter p-sj-b-code      as integer          no-undo.
    10288       define variable v-price-is-changed      as logical  no-undo.
    10289       define variable v-sum-prt-qnty                  as decimal      no-undo.
    10290       define variable v-avg-prt-price                 as decimal      no-undo.
    10291       define variable v-avg-prt-price-no-tax          as decimal      no-undo.
    10292       define variable v-sum-SLT                       as decimal      no-undo.
    10293       define variable v-sum-VAT                       as decimal      no-undo.
    10294       define variable v-avg-VAT                       as decimal      no-undo.
    10295       define variable v-avg-VAT-out                   as decimal      no-undo.
    10296       define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
    10297       define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
    10298       define variable v-avg-prt-sum-with-tax-out      as decimal      no-undo.
    10299       define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
    10300       define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
    10301       define variable v-avg-prt-sum-without-tax-out   as decimal      no-undo.
    10302       define variable v-vat-pc                        as decimal      no-undo.
    10303       define variable v-slt-pc                        as decimal      no-undo.
    10304       define variable v-void-decimal                  as decimal      no-undo.
    10305       define variable v-gds-name                      as character    no-undo.
    10306       define buffer buf_trn-doc       for trn-doc.
    10307       define buffer buf_sj-t12        for sj-t12.
    10308       define buffer buf_tax_parts     for parts.
    10309       define buffer buf_temp_gds-name for temp_gds-name.
    10310   do
    10311   for buf_trn-doc
    10312     , buf_sj-t12
    10313     , buf_tax_parts
    10314     , buf_temp_gds-name
    10315   on error undo, return error
    10316   :
    10317       empty temp-table buf_temp_gds-name.
    10318       find first buf_trn-doc no-lock
    10319            where buf_trn-doc.doc-code = p-doc-code
    10320       .
    10321       find first buf_sj-t12
    10322            where buf_sj-t12.b-code = p-sj-b-code
    10323       .
    10324       run writelog in this-procedure (log-file-name, 1, "Печать строки товара по чекам").
    10325       assign
    10326           v-torg-12-gds-name-key  = 0
    10327           v-gds-name              = goods.gds-name
    10328       .
    10329       if FullGdsName
    10330       and v-gds-name <> "":U
    10331       then do:
    10332           do
    10333           while v-gds-name <> "":U
    10334           :
    10335               assign
    10336                   v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
    10337               .
    10338               create buf_temp_gds-name.
    10339               assign
    10340                   buf_temp_gds-name.gdn-key = v-torg-12-gds-name-key
    10341               .
    10342               run p-fmt-split-string in this-procedure (
    10343                     input v-gds-name
    10344                   , input v-torg-12-gds-name-length
    10345                   , output buf_temp_gds-name.gdnString
    10346                   , output v-gds-name
    10347               ).
    10348           end.
    10349           assign
    10350               v-gds-name    = goods.gds-name
    10351           .
    10352       end.
    10353       else do:
    10354           assign
    10355               v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
    10356           .
    10357           create buf_temp_gds-name.
    10358           assign
    10359               buf_temp_gds-name.gdn-key   = v-torg-12-gds-name-key
    10360               buf_temp_gds-name.gdnString = v-gds-name
    10361           .
    10362       end.
    10363       run writelog in this-procedure( log-file-name, 2, substitute( "Товар: &1 &2 ", goods.artic, goods.gds-name ) ).
    10364       find first gds-prt no-lock
    10365            where gds-prt.upper-code = goods.prt-root
    10366       .
    10367       assign
    10368           v-rootnode-code = gds-prt.node-code
    10369       .
    10370       if ( ( gds-prt.node-name <> '_Пустая шкала':U )
    10371           and v-cntxp-doc-prt = yes )
    10372       and ( not Invers )
    10373       then do:
    10374           run writelog in this-procedure (log-file-name, 2, "Не пустая шкала, не отключена печать по шкалам и накладная не от имени поставщика").
    10375           find first gds-dtl no-lock
    10376                where gds-dtl.prod-type = buf_sj-t12.prod-type
    10377                  and gds-dtl.prod-code = buf_sj-t12.prod-code
    10378                  and gds-dtl.artic     = buf_sj-t12.artic
    10379                  and gds-dtl.doc-code  = p-doc-code
    10380           no-error.
    10381           if not available gds-dtl
    10382           then do:
    10383               assign
    10384                   price-noNDS   = 0
    10385                   price-withNDS = 0
    10386               .
    10387           end.
    10388           if PrintScale
    10389           then do:
    10390               if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10391               run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10392                     input v-doc-line-counter
    10393                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
    10394                   , input "":U
    10395                   , input "":U
    10396                   , input "":U
    10397                   , input "":U
    10398                   , input "":U
    10399                   , input "":U
    10400                   , input "":U
    10401                   , input "":U
    10402               ).
    10403               end.
    10404               assign
    10405                   v-line-counter = v-line-counter + 1
    10406                   v-doc-line-counter = v-doc-line-counter + 1
    10407               .
    10408           end.
    10409           for each gds-dtl no-lock
    10410              where gds-dtl.prod-type  = buf_sj-t12.prod-type
    10411                and gds-dtl.prod-code  = buf_sj-t12.prod-code
    10412                and gds-dtl.artic      = buf_sj-t12.artic
    10413                and gds-dtl.doc-code   = p-doc-code
    10414           :
    10415               find first gds-prt no-lock
    10416                    where gds-prt.node-code = gds-dtl.prt-code
    10417               .
    10418               assign
    10419                   v-sum-prt-qnty  = v-sum-prt-qnty + buf_sj-t12.fact-qnty
    10420                   VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-buyer            else buf_sj-t12.vat-base-buyer           )
    10421                   SLT-gds         = ( if PrintRubl then buf_sj-t12.slt-rubl-sale             else buf_sj-t12.slt-base-sale            )
    10422                   price-withNDS   = ( if PrintRubl then buf_sj-t12.price-rubl-with-tax-sale  else buf_sj-t12.price-base-with-tax-sale )
    10423               .
    10424               run writelog in this-procedure (log-file-name, 1, substitute( "Цена НДС: &1 ", v-sum-VAT ) ).
    10425               if VAT-gds = ?       then assign  VAT-gds       = 0.
    10426               if SLT-gds = ?       then assign  SLT-gds       = 0.
    10427               if price-withNDS = ? then assign  price-withNDS = 0.
    10428               assign
    10429                   v-sum-VAT                 = v-sum-VAT                   + VAT-gds * buf_sj-t12.fact-qnty
    10430                   v-sum-prt-sum-with-tax    = v-sum-prt-sum-with-tax      + ( price-withNDS * buf_sj-t12.fact-qnty )
    10431                   v-sum-prt-sum-without-tax = v-sum-prt-sum-without-tax   + ( ( price-withNDS - VAT-gds - SLT-gds )
    10432                                                                               * buf_sj-t12.fact-qnty )
    10433               .
    10434               run writelog in this-procedure (log-file-name, 1, substitute( "Сумма НДС: &1 ", v-sum-VAT ) ).
    10435           end.
    10436           assign
    10437               v-avg-VAT                   = ( if v-sum-VAT = ? or v-sum-VAT = 0
    10438                                             then 0
    10439                                             else v-sum-VAT / v-sum-prt-qnty )
    10440               v-avg-prt-price             = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
    10441                                             then 0
    10442                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
    10443               v-avg-prt-price-no-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
    10444                                             then 0
    10445                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
    10446               v-avg-prt-sum-with-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
    10447                                             then 0
    10448                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
    10449               v-avg-prt-sum-without-tax   = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
    10450                                             then 0
    10451                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
    10452           .
    10453           for each gds-dtl no-lock
    10454              where gds-dtl.prod-type  = buf_sj-t12.prod-type
    10455                and gds-dtl.prod-code  = buf_sj-t12.prod-code
    10456                and gds-dtl.artic      = buf_sj-t12.artic
    10457                and gds-dtl.doc-code   = p-doc-code
    10458           :
    10459               find first gds-prt no-lock
    10460                    where gds-prt.node-code = gds-dtl.prt-code
    10461               .
    10462               if buf_trn-doc.doc-type = 'при':U
    10463               or v-ext-doc-type = 'ep':U
    10464               then do:
    10465                   assign
    10466                       VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-sale              else buf_sj-t12.vat-base-sale               )
    10467                   .
    10468               end.
    10469               else do:
    10470                   assign
    10471                       VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-buyer             else buf_sj-t12.vat-base-buyer              )
    10472                   .
    10473               end.
    10474               assign
    10475                   VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-buyer             else buf_sj-t12.vat-base-buyer              )
    10476                   SLT-gds         = ( if PrintRubl then buf_sj-t12.slt-rubl-sale              else buf_sj-t12.slt-base-sale               )
    10477                   price-withNDS   = ( if PrintRubl then buf_sj-t12.price-rubl-with-tax-sale   else buf_sj-t12.price-base-with-tax-sale    )
    10478               .
    10479               if VAT-gds = ? then VAT-gds = 0.
    10480               if SLT-gds = ? then SLT-gds = 0.
    10481               assign
    10482                   price-noNDS     = price-withNDS - VAT-gds - SLT-gds
    10483                   prt-tqnty       = buf_sj-t12.fact-qnty
    10484                   prt-VAT-gds     = VAT-gds           * prt-tqnty
    10485                   prt-SLT-gds     = SLT-gds           * prt-tqnty
    10486                   prt-stoim-noNDS = price-noNDS       * prt-tqnty
    10487                   prt-stoim       = prt-stoim-noNDS   + prt-VAT-gds
    10488               .
    10489               if p-round = "round":U
    10490               then do:
    10491                   run p-fmt-round in this-procedure (
    10492                         input prt-tqnty
    10493                       , input price-noNDS
    10494                       , input VAT-gds
    10495                       , input SLT-gds
    10496                       , input 0
    10497                       , output price-noNDS
    10498                       , output v-vat-pc
    10499                       , output v-slt-pc
    10500                       , output prt-VAT-gds
    10501                       , output prt-SLT-gds
    10502                       , output v-void-decimal
    10503                       , output prt-stoim-noNDS
    10504                       , output prt-stoim
    10505                   ).
    10506                   assign
    10507                       prt-stoim  = prt-stoim - prt-SLT-gds
    10508                   .
    10509               end.
    10510               accumulate
    10511                   prt-tqnty ( TOTAL )
    10512                   prt-VAT-gds ( TOTAL )
    10513                   prt-SLT-gds ( TOTAL )
    10514                   prt-stoim-noNDS ( TOTAL )
    10515                   prt-stoim ( TOTAL )
    10516               .
    10517               if PrintScale
    10518               then do:
    10519                   find first bar-code no-lock
    10520                        where bar-code.gds-code = goods.gds-code
    10521                          and bar-code.unit-cli = goods.unit-base
    10522                          and bar-code.node-code = gds-dtl.prt-code
    10523                          and bar-code.part-code = ""
    10524                          and bar-code.in-code = ""
    10525                   .
    10526                   assign
    10527                    v-ext-artic = ""
    10528                   .
    10529                   find first ub.ext-artic no-lock
    10530                        where ub.ext-artic.gds-code = bar-code.gds-code
    10531                          and ub.ext-artic.cli-code = v-cli-code
    10532                          and ub.ext-artic.cli-type = v-cli-type
    10533                          and ub.ext-artic.status_  = 'тек':U no-error.
    10534                   if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
    10535                   v-prt-name = "".
    10536                   do while available gds-prt:
    10537                       if available gds-prt
    10538                       then assign
    10539                           v-prt-name = "\" + string( gds-prt.node-name, "x(10)" ) + v-prt-name
    10540                       .
    10541                       assign
    10542                           v-node-code = gds-prt.upper-code
    10543                       .
    10544                       find first gds-prt no-lock
    10545                            where gds-prt.node-code = v-node-code
    10546                              and gds-prt.root <> yes
    10547                       no-error.
    10548                   end.
    10549                   if buf_trn-doc.doc-type = 'при':U
    10550                   or v-ext-doc-type = 'ep':U
    10551                   then do:
    10552                       assign
    10553                           v-avg-prt-price             = price-withNDS
    10554                           v-avg-prt-price-no-tax      = price-noNDS
    10555                           v-avg-VAT                   = prt-VAT-gds
    10556                           v-avg-prt-sum-with-tax      = prt-stoim
    10557                           v-avg-prt-sum-without-tax   = prt-stoim-noNDS
    10558                       .
    10559                   end.
    10560                   else do:
    10561                       assign
    10562                           v-avg-VAT-out                 = v-avg-VAT                  * buf_sj-t12.fact-qnty
    10563                           v-avg-prt-sum-with-tax-out    = v-avg-prt-sum-with-tax     * buf_sj-t12.fact-qnty
    10564                           v-avg-prt-sum-without-tax-out = v-avg-prt-sum-without-tax  * buf_sj-t12.fact-qnty
    10565                       .
    10566                   end.
    10567                   if v-ext-doc-type = 'ep':U
    10568                   then do:
    10569                       if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10570                       run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10571                             input 0
    10572                           , input substitute( "&1 &2", goods.artic, v-prt-name )
    10573                           , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10574                           , input goods.unit-base
    10575                           , input "":U
    10576                           , input "":U
    10577                           , input "":U
    10578                           , input string( prt-tqnty )
    10579                           , input string( v-avg-prt-price-no-tax + v-avg-VAT-out )
    10580                           , input string( v-avg-prt-sum-with-tax-out + prt-SLT-gds )
    10581                       ).
    10582                       end.
    10583                   end.
    10584                   else do:
    10585                       if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10586                       run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10587                             input 0
    10588                           , input substitute( "&1 &2", goods.artic, v-prt-name )
    10589                           , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10590                           , input goods.unit-base
    10591                           , input "":U
    10592                           , input "":U
    10593                           , input "":U
    10594                           , input string( prt-tqnty               )
    10595                           , input string( price-noNDS + prt-VAT-gds )
    10596                           , input string( prt-stoim + prt-SLT-gds )
    10597                       ).
    10598                       end.
    10599                   end.
    10600               end.
    10601           end.
    10602           assign
    10603               tqnty = ( ACCUM TOTAL prt-tqnty )
    10604               VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
    10605               SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
    10606               stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
    10607               stoim = ( ACCUM TOTAL prt-stoim )
    10608           .
    10609           if not PrintScale
    10610           then do:
    10611               find first bar-code no-lock
    10612                    where bar-code.gds-code = goods.gds-code
    10613                      and bar-code.unit-cli = goods.unit-base
    10614                      and bar-code.node-code = v-rootnode-code
    10615                      and bar-code.part-code = ""
    10616                      and bar-code.in-code = ""
    10617               .
    10618               assign
    10619                v-ext-artic = ""
    10620               .
    10621               find first ub.ext-artic no-lock
    10622                    where ub.ext-artic.gds-code = bar-code.gds-code
    10623                      and ub.ext-artic.cli-code = v-cli-code
    10624                      and ub.ext-artic.cli-type = v-cli-type
    10625                      and ub.ext-artic.status_  = 'тек':U no-error.
    10626               if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
    10627               if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10628               run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10629                     input v-doc-line-counter
    10630                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
    10631                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10632                   , input goods.unit-base
    10633                   , input "":U
    10634                   , input "":U
    10635                   , input "":U
    10636                   , input string( tqnty )
    10637                   , input string( stoim-noNDS / tqnty + VAT-gds )
    10638                   , input string( stoim + SLT-gds )
    10639               ).
    10640               end.
    10641               assign
    10642                   v-line-counter     = v-line-counter + 1
    10643                   v-doc-line-counter = v-doc-line-counter + 1
    10644               .
    10645           end.
    10646       end.
    10647       else do:
    10648           run writelog in this-procedure (log-file-name, 2, "Пустая шкала или отключена печать по шкалам или накладная от имени поставщика").
    10649           find first bar-code no-lock
    10650               where bar-code.gds-code = goods.gds-code
    10651               and bar-code.unit-cli   = goods.unit-base
    10652               and bar-code.node-code  = v-rootnode-code
    10653               and bar-code.part-code  = ""
    10654               and bar-code.in-code    = ""
    10655           .
    10656           assign
    10657            v-ext-artic = ""
    10658           .
    10659           find first ub.ext-artic no-lock
    10660                where ub.ext-artic.gds-code = bar-code.gds-code
    10661                  and ub.ext-artic.cli-code = v-cli-code
    10662                  and ub.ext-artic.cli-type = v-cli-type
    10663                  and ub.ext-artic.status_  = 'тек':U no-error.
    10664           if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
    10665           if v-ext-doc-type = 'ep':U
    10666           and PrintScale = no
    10667           then do:
    10668               run writelog in this-procedure (log-file-name, 3, "Возврат поставщику при печати по партиям "
    10669                                                   ).
    10670               find first gds-dtl no-lock
    10671                    where gds-dtl.doc-code    = p-doc-code
    10672                      and gds-dtl.artic       = buf_sj-t12.artic
    10673                      and gds-dtl.prod-code   = buf_sj-t12.prod-code
    10674                      and gds-dtl.prod-type   = buf_sj-t12.prod-type
    10675                      and gds-dtl.prt-code    = v-rootnode-code
    10676               no-error.
    10677               if available gds-dtl
    10678               and doc-line.price-rubl - doc-line.transport-rubl - doc-line.other-rubl <> gds-dtl.price-rubl
    10679               then do:
    10680                   assign
    10681                       v-price-is-changed  =  yes
    10682                   .
    10683                   assign
    10684                       v-VAT-gds           = ( if PrintRubl then buf_sj-t12.vat-rubl-buyer             else buf_sj-t12.vat-base-buyer              )
    10685                       v-SLT-gds           = ( if PrintRubl then buf_sj-t12.slt-rubl-sale              else buf_sj-t12.slt-base-sale               )
    10686                       v-price-withNDS     = ( if PrintRubl then buf_sj-t12.price-rubl-with-tax-sale   else buf_sj-t12.price-base-with-tax-sale    )
    10687                   .
    10688                   run writelog in this-procedure (log-file-name, 4, "В возврате поставщику изменяли цену ( с НДС -     "
    10689                                                                            + dtm-char(string(v-price-withNDS)) + " )"
    10690                                                       ).
    10691               end.
    10692               else do:
    10693                   assign
    10694                       v-price-is-changed  =  no
    10695                   .
    10696               end.
    10697               if v-price-is-changed  =  no
    10698               or CostPrice = yes
    10699               then do:
    10700                   assign
    10701                       v-VAT-gds       = ( if PrintRubl then buf_sj-t12.vat-rubl-sale       else buf_sj-t12.vat-base-sale        )
    10702                       v-SLT-gds       = ( if PrintRubl then buf_sj-t12.slt-rubl-sale       else buf_sj-t12.slt-base-sale        )
    10703                       v-tax-price     = ( if PrintRubl then buf_sj-t12.road-tax-rubl-sale  else buf_sj-t12.road-tax-base-sale   )
    10704                       v-price-withNDS = ( if PrintRubl
    10705                           then buf_sj-t12.price-rubl-with-tax-sale - v-tax-price
    10706                           else buf_sj-t12.price-base-with-tax-sale - v-tax-price
    10707                                           )
    10708                       v-tax           = v-tax-price * buf_sj-t12.fact-qnty
    10709                       v-tax-sum       = v-tax-sum + v-tax
    10710                   .
    10711               end.
    10712               if VAT-gds = ? then VAT-gds = 0.
    10713               if SLT-gds = ? then SLT-gds = 0.
    10714               assign
    10715                   tqnty           = buf_sj-t12.fact-qnty
    10716                   unit-str        = goods.unit-base
    10717                   price-noNDS     = v-price-withNDS - v-VAT-gds - v-SLT-gds
    10718                   VAT-gds         = v-VAT-gds * tqnty
    10719                   SLT-gds         = v-SLT-gds * tqnty
    10720                   stoim-noNDS     = price-noNDS * tqnty
    10721                   stoim           = stoim-noNDS + VAT-gds
    10722                   price-withNDS   = v-price-withNDS
    10723               .
    10724               run writelog in this-procedure (log-file-name, 5, "Партия: Кол-во ( " + dtm-char ( string(tqnty) )
    10725                                                           + " ) c НДС ( " + dtm-char( string(price-withNDS)) + " )"
    10726                                                   ).
    10727               if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10728               run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10729                     input v-doc-line-counter
    10730                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
    10731                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10732                   , input unit-str
    10733                   , input "":U
    10734                   , input "":U
    10735                   , input "":U
    10736                   , input string( tqnty )
    10737                   , input string( price-noNDS + VAT-gds )
    10738                   , input string( stoim + SLT-gds )
    10739               ).
    10740               end.
    10741               assign
    10742                   prt-tqnty =  tqnty
    10743                   prt-VAT-gds = VAT-gds
    10744                   prt-SLT-gds = SLT-gds
    10745                   prt-stoim-noNDS = price-noNDS * prt-tqnty
    10746                   prt-stoim = prt-stoim-noNDS + prt-VAT-gds
    10747               .
    10748               if hvrdtax (recid(goods))
    10749               then do:
    10750                   run tax-name (  input 'rdt':U
    10751                               , output v-tax-name
    10752                               ).
    10753                   run writelog in this-procedure (log-file-name, 4, "Есть третий налог ( " + dtm-char( v-tax-name )
    10754                                                           + " ) сумма ( " + dtm-char( string( v-tax ) ) + " )"
    10755                                                       ).
    10756                   if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10757                   run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10758                         input 0
    10759                       , input v-tax-name
    10760                       , input "":U
    10761                       , input "":U
    10762                       , input "":U
    10763                       , input "":U
    10764                       , input "":U
    10765                       , input string( tqnty )
    10766                       , input string( v-tax-price )
    10767                       , input string( v-tax )
    10768                   ).
    10769                   end.
    10770                   assign
    10771                       price-withNDS   = v-price-withNDS + v-tax-price
    10772                       price-noNDS     = price-withNDS - v-VAT-gds - v-SLT-gds
    10773                       prt-stoim-noNDS = price-noNDS * tqnty
    10774                       prt-stoim       = prt-stoim-noNDS + VAT-gds
    10775                       v-line-counter  = v-line-counter + 1
    10776                   .
    10777                   run writelog in this-procedure (log-file-name, 4, "Еще раз вычислили сумму с НДС ( "
    10778                                                           + dtm-char( string(prt-stoim) )
    10779                                                           + " ) для общего итога"
    10780                                                       ).
    10781               end.
    10782               accumulate
    10783                   prt-tqnty ( TOTAL )
    10784                   prt-VAT-gds ( TOTAL )
    10785                   prt-SLT-gds ( TOTAL )
    10786                   prt-stoim-noNDS ( TOTAL )
    10787                   prt-stoim ( TOTAL )
    10788               .
    10789               assign
    10790                   v-line-counter     = v-line-counter + 1
    10791                   v-doc-line-counter = v-doc-line-counter + 1
    10792               .
    10793               assign
    10794                   tqnty = ( ACCUM TOTAL prt-tqnty )
    10795                   VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
    10796                   SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
    10797                   stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
    10798                   stoim = ( ACCUM TOTAL prt-stoim )
    10799               .
    10800               run writelog in this-procedure (log-file-name, 3,
    10801                                                               "После цикла по партиям: Установили количество ( "
    10802                                                               + dtm-char( string(tqnty) )
    10803                                                               + " ) и сумму ( "
    10804                                                               + dtm-char( string( stoim ) )
    10805                                                               + " ) для общего итога "
    10806                                                   ).
    10807           end.
    10808           else do:
    10809               find first gds-dtl no-lock
    10810                    where gds-dtl.doc-code    = p-doc-code
    10811                      and gds-dtl.prod-type   = buf_sj-t12.prod-type
    10812                      and gds-dtl.prod-code   = buf_sj-t12.prod-code
    10813                      and gds-dtl.artic       = buf_sj-t12.artic
    10814                      and gds-dtl.prt-code    = v-rootnode-code
    10815               no-error.
    10816               if available gds-dtl
    10817               then do:
    10818                   assign
    10819                       tqnty    = buf_sj-t12.fact-qnty
    10820                   .
    10821               end.
    10822               else do:
    10823                   assign
    10824                       tqnty    = buf_sj-t12.fact-qnty
    10825                   .
    10826               end.
    10827               assign
    10828                   unit-str = goods.unit-base
    10829               .
    10830               if buf_trn-doc.doc-type = 'при':U
    10831               or v-ext-doc-type = 'ep':U
    10832               then do:
    10833                   assign
    10834                       VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-sale       else buf_sj-t12.vat-base-sale        )
    10835                       SLT-gds         = ( if PrintRubl then buf_sj-t12.slt-rubl-sale       else buf_sj-t12.slt-base-sale        )
    10836                       v-tax-price     = ( if PrintRubl then buf_sj-t12.road-tax-rubl-sale  else buf_sj-t12.road-tax-base-sale   )
    10837                       price-withNDS   = ( if PrintRubl
    10838                                           then buf_sj-t12.price-rubl-with-tax-sale - v-tax-price
    10839                                           else buf_sj-t12.price-base-with-tax-sale - v-tax-price
    10840                                           )
    10841                       v-tax           = v-tax-price * tqnty
    10842                       v-tax-sum       = v-tax-sum + v-tax
    10843                   .
    10844               end.
    10845               else do:
    10846                   assign
    10847                       VAT-gds         = ( if PrintRubl then buf_sj-t12.vat-rubl-buyer     else buf_sj-t12.vat-base-buyer      )
    10848                       SLT-gds         = ( if PrintRubl then buf_sj-t12.slt-rubl-sale      else buf_sj-t12.slt-base-sale       )
    10849                       v-tax-price     = ( if PrintRubl then buf_sj-t12.road-tax-rubl-sale else buf_sj-t12.road-tax-base-sale  )
    10850                       price-withNDS   = ( if PrintRubl
    10851                                           then buf_sj-t12.price-rubl-with-tax-sale - v-tax-price
    10852                                           else buf_sj-t12.price-base-with-tax-sale - v-tax-price
    10853                                           )
    10854                       v-tax           = v-tax-price * tqnty
    10855                       v-tax-sum       = v-tax-sum + v-tax
    10856                   .
    10857               end.
    10858               if VAT-gds = ? then assign VAT-gds = 0.
    10859               if SLT-gds = ? then assign SLT-gds = 0.
    10860               assign
    10861                   price-noNDS = price-withNDS - VAT-gds - SLT-gds
    10862                   VAT-gds     = VAT-gds * tqnty
    10863                   SLT-gds     = SLT-gds * tqnty
    10864                   stoim-noNDS = price-noNDS * tqnty
    10865                   stoim       = stoim-noNDS + VAT-gds
    10866               .
    10867               run writelog in this-procedure (log-file-name, 3, "Печать не по партиям. Стоимость с НДС ( "
    10868                                                                           + dtm-char( string( stoim ) )
    10869                                                                           + " ). Количество ( "
    10870                                                                           + dtm-char( string( tqnty ) )
    10871                                                                           + " ). Третий налог ( "
    10872                                                                           + dtm-char( string( v-tax ) )
    10873                                                                           + " )"
    10874                                                   ).
    10875               if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10876               run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10877                     input v-doc-line-counter
    10878                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
    10879                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10880                   , input unit-str
    10881                   , input "":U
    10882                   , input "":U
    10883                   , input "":U
    10884                   , input string( tqnty )
    10885                   , input string( price-noNDS + VAT-gds )
    10886                   , input string( stoim + SLT-gds )
    10887               ).
    10888               end.
    10889               if hvrdtax (recid(goods))
    10890               then do:
    10891                   run tax-name (  input 'rdt':U
    10892                                , output v-tax-name
    10893                                ).
    10894                   run writelog in this-procedure (log-file-name, 4, "Есть третий налог ( " + dtm-char( v-tax-name )
    10895                                                           + " ) сумма ( " + dtm-char( string( v-tax ) ) + " )"
    10896                                                       ).
    10897                   parts-for-tax:
    10898                   for each buf_tax_parts
    10899                      where buf_tax_parts.obj-type     = doc-line.obj-type
    10900                        and buf_tax_parts.obj-code     = doc-line.obj-code
    10901                        and buf_tax_parts.artic        = goods.artic
    10902                        and buf_tax_parts.prod-type    = goods.prod-type
    10903                        and buf_tax_parts.prod-code    = goods.prod-code
    10904                        and buf_tax_parts.out-code     = doc-line.doc-code
    10905                   break by buf_tax_parts.road-tax-base
    10906                   :
    10907                       if first-of (buf_tax_parts.road-tax-base)
    10908                       then do:
    10909                           assign
    10910                               v-parts-tax-qnty    = 0
    10911                               v-tax               = 0
    10912                               v-tax-parts-price   =  ( if PrintRubl
    10913                                                       then buf_tax_parts.road-tax-rubl
    10914                                                       else buf_tax_parts.road-tax-base )
    10915                           .
    10916                       end.
    10917                       assign
    10918                           v-parts-tax-qnty    = v-parts-tax-qnty + buf_tax_parts.fact-qnty
    10919                           v-tax               = v-tax + ( v-tax-parts-price * buf_tax_parts.fact-qnty )
    10920                       .
    10921                       if not last-of (buf_tax_parts.road-tax-base)
    10922                       then do:
    10923                           next parts-for-tax.
    10924                       end.
    10925                       if lookup( "TopAukc":U, p-mode ) = 0 then do:
    10926                       run r-f_t1xl-sheet1-write-line-data in this-procedure (
    10927                             input 0
    10928                           , input v-tax-name
    10929                           , input "":U
    10930                           , input "":U
    10931                           , input "":U
    10932                           , input "":U
    10933                           , input "":U
    10934                           , input string( v-parts-tax-qnty  )
    10935                           , input string( v-tax-parts-price )
    10936                           , input string( v-tax )
    10937                       ).
    10938                       end.
    10939                   end.
    10940                   assign
    10941                       v-tax           = v-tax-price * tqnty
    10942                       price-noNDS     = price-noNDS + v-tax-price
    10943                       stoim-noNDS     = price-noNDS * tqnty
    10944                       stoim           = stoim-noNDS + VAT-gds
    10945                       v-line-counter  = v-line-counter + 1
    10946                   .
    10947                   run writelog in this-procedure (log-file-name, 4,
    10948                                           "Снова вычислили суммы для строки. Сумма с НДС ( "
    10949                                           + dtm-char( string( stoim ) )
    10950                                           + " )"
    10951                                                       ).
    10952               end.
    10953               assign
    10954                   v-line-counter     = v-line-counter + 1
    10955                   v-doc-line-counter = v-doc-line-counter + 1
    10956               .
    10957           end.
    10958       end.
    10959   end.
    10960   end procedure.
    10961   procedure trdcattr-value :
    10962   define input parameter p-doc-code       as character        no-undo.
    10963   define input parameter p-attr-code      as character        no-undo.
    10964   define output parameter p-attr-value    as character        no-undo.
    10965   define output parameter p-attr-type     as character        no-undo.
    10966   do
    10967   on error undo, return error
    10968   :
    10969       run gbl/trdcat-v.p (
    10970             input p-doc-code
    10971           , input p-attr-code
    10972           , output p-attr-value
    10973           , output p-attr-type
    10974       ).
    10975   end.
    10976   end procedure.
    10977   procedure disc-mpl :
    10978   define input  parameter p-doc-code        as character      no-undo .
    10979   define output parameter v-price-sale-all  as decimal        no-undo .
    10980   define variable p-main-b-code             as integer        no-undo .
    10981   define variable v-fact-order              as decimal        no-undo .
    10982   define variable v-doc-num     like ub.price-list.doc-num    no-undo .
    10983   define variable v-price-sale  like ub.price-list.price-sale no-undo .
    10984   define variable v-road-tax    like ub.price-list.road-tax   no-undo .
    10985   define variable v-excise      like ub.price-list.excise     no-undo .
    10986   define buffer buf_trn-doc     for ub.trn-doc.
    10987   define buffer buf_doc-line    for ub.doc-line.
    10988   define buffer buf_goods       for ub.goods.
    10989   define buffer buf_price-doc   for ub.price-doc.
    10990   do
    10991   on error undo, return error
    10992   :
    10993   find first buf_trn-doc
    10994        where buf_trn-doc.doc-code = p-doc-code
    10995     no-error.
    10996     if available buf_trn-doc then do:
    10997       for each buf_doc-line
    10998          where buf_doc-line.doc-code = buf_trn-doc.doc-code
    10999          no-lock :
    11000            find first buf_goods
    11001                 where buf_goods.artic     = buf_doc-line.artic
    11002                   and buf_goods.prod-type = buf_doc-line.prod-type
    11003                   and buf_goods.prod-code = buf_doc-line.prod-code
    11004               no-error.
    11005               if available buf_goods then do:
    11006   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    11007     (input  buf_goods.gds-code
    11008     ,input  ?
    11009     ,output p-main-b-code
    11010     )  .
    11011                 assign v-fact-order = (if buf_trn-doc.fact-order <> ? then buf_trn-doc.fact-order else 0) .
    11012   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11013   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    11014     (input  buf_trn-doc.obj-type
    11015     ,input  buf_trn-doc.obj-code
    11016     ,input  p-main-b-code
    11017     ,input  0
    11018     ,input  v-fact-order
    11019     ,output v-doc-num
    11020     ,output v-price-sale
    11021     ,output v-road-tax
    11022     ,output v-excise
    11023     ) no-error .
    11024                 if v-doc-num <> ? then do:
    11025                   find first buf_price-doc
    11026                   where buf_price-doc.doc-num = v-doc-num no-error.
    11027                   if available buf_price-doc then do:
    11028                     if not printRubl then do :
    11029                         assign v-price-sale = v-price-sale / buf_price-doc.base-rate .
    11030                     end.
    11031                   end.
    11032                   else do:
    11033                       assign v-price-sale = 0.
    11034                   end.
    11035                 end.
    11036                 else do:
    11037                     assign v-price-sale = 0.
    11038                 end.
    11039                 assign v-price-sale-all = v-price-sale-all + v-price-sale * buf_doc-line.fact-qnty.
    11040              end.
    11041       end.
    11042     end.
    11043   end.
    11044   end procedure.
    11045   procedure get-okei :
    11046   define input parameter p-unit-base as character        no-undo.
    11047   define output parameter p-okei as character        no-undo.
    11048       define buffer buf_units         for units.
    11049   do
    11050   for buf_units
    11051   on error undo, return error
    11052   :
    11053       find first buf_units no-lock
    11054            where buf_units.unit-name = p-unit-base
    11055       no-error.
    11056       if available buf_units
    11057       and buf_units.OKEI <> 0
    11058       then do:
    11059           assign
    11060               p-okei = string( buf_units.OKEI, ">999":U )
    11061           .
    11062       end.
    11063       else do:
    11064           assign
    11065               p-okei = "":U
    11066           .
    11067       end.
    11068   end.
    11069   end procedure.
    11070   PROCEDURE find-income-doc-code :
    11071   define input  parameter p-in-code         like parts.in-code    no-undo .
    11072   define input  parameter p-gds-code        like goods.gds-code   no-undo .
    11073   define input  parameter p-part-code       like parts.part-code  no-undo .
    11074   define output parameter p-income-doc-code like parts.in-code    no-undo .
    11075   define buffer buf_parts-attr for ub.parts-attr .
    11076   define buffer buf_income_parts-attr for ub.parts-attr .
    11077   do on error undo, return error return-value :
    11078     assign
    11079       p-income-doc-code = ?
    11080     .
    11081     find first buf_parts-attr no-lock
    11082       where buf_parts-attr.in-code   = p-in-code
    11083         and buf_parts-attr.gds-code  = p-gds-code
    11084         and buf_parts-attr.part-code = p-part-code
    11085     no-error .
    11086     if available buf_parts-attr then do:
    11087       find first buf_income_parts-attr no-lock
    11088         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
    11089           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
    11090           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
    11091         no-error .
    11092       if available buf_income_parts-attr then do:
    11093         assign
    11094           p-income-doc-code = buf_parts-attr.income-in-code
    11095         .
    11096       end.
    11097       else do:
    11098         assign
    11099           p-income-doc-code = ?
    11100         .
    11101       end.
    11102     end.
    11103     else do:
    11104       assign
    11105         p-income-doc-code = ?
    11106       .
    11107     end.
    11108   end.
    11109   END PROCEDURE.
