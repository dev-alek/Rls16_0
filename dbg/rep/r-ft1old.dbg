     9693       else if  v-torgconf-organization matches "*" +   v-torgconf-sup-host-phone  + "*"   and  v-torgconf-sup-host-phone  <> ""  then  v-temp-phone =  v-torgconf-sup-host-phone .
     9694       else if  v-torgconf-organization matches "*" +   v-torgconf-self-obj-phone  + "*"   and  v-torgconf-self-obj-phone  <> ""  then  v-temp-phone =  v-torgconf-self-obj-phone .
