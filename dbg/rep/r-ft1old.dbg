     6092   field shift-2 as int
     6093   field time-1 as int
     6094   field time-2 as int
     6095   field grp-name as char
     6096   field interv-name as char
     6097   field pay-name as char
     6098   field unit-cli as char
     6099   index pi
     6100   plt-priority DESCENDING
     6101   fact-order DESCENDING
     6102   qnty-from asc
     6103   sum-from asc
     6104   turnover-from asc
     6105   date-1 DESCENDING
     6106   time-1 DESCENDING
     6107   date-2 DESCENDING
     6108   time-2 DESCENDING
     6109   type-price DESCENDING
     6110   .
     6111   procedure mpl-autoprice :
     6112   define input  parameter p-only-b-code as logical   no-undo .
     6113   define input  parameter p-cli-type    as character no-undo .
     6114   define input  parameter p-cli-code    as integer   no-undo .
     6115   define input  parameter p-main-b-code as integer   no-undo .
     6116   define input  parameter p-b-code      as integer   no-undo .
     6117   define input  parameter p-obj-type    as character no-undo .
     6118   define input  parameter p-obj-code    as integer   no-undo .
     6119   define input  parameter p-qnty-doc    as decimal   no-undo .
     6120   define input  parameter p-sum-doc     as decimal   no-undo .
     6121   define input  parameter p-vid-pay        as character no-undo .
     6122   define input  parameter p-cash-pay-type  as character no-undo .
     6123   define input  parameter p-fact-order  as decimal   no-undo .
     6124   define output parameter p-plt-id          as integer   no-undo .
     6125   define output parameter p-plt-db-num      as integer   no-undo .
     6126   define output parameter p-pdf-id          as integer   no-undo .
     6127   define output parameter p-pdf-db-num      as integer   no-undo .
     6128   define output parameter p-sale-price-base as decimal   no-undo .
     6129   define output parameter p-sale-price-rubl as decimal   no-undo .
     6130   define output parameter p-road-tax-base as decimal   no-undo .
     6131   define output parameter p-road-tax-rubl as decimal   no-undo .
     6132   define output parameter p-excise-base   as decimal   no-undo .
     6133   define output parameter p-excise-rubl   as decimal   no-undo .
     6134   define variable v-cli-oborot-ALL as decimal   no-undo .
     6135   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6136   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6137   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6138   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6139   define buffer buf_price-all              for ub.price-all  .
     6140   define buffer buf_goods                  for ub.goods      .
     6141   define buffer buf_global-state           for ub.global-state  .
     6142   define buffer buf_buyer-group            for ub.buyer-group  .
     6143   define buffer buf_turnover-group         for ub.turnover-group  .
     6144   define buffer buf_main-code              for ub.bar-code  .
     6145   define buffer buf_bar-code               for ub.bar-code  .
     6146   define buffer buf_pay-type               for ub.pay-type  .
     6147   define buffer buf_cash-pay               for ub.cash-pay  .
     6148   define variable to-day          as date      no-undo .
     6149   define variable v-base-rate0    as decimal   no-undo .
     6150   define variable v-base-scale0   as decimal   no-undo .
     6151   define variable v-exch-rate0    as decimal   no-undo .
     6152   define variable v-exch-scale0   as decimal   no-undo .
     6153   define variable v-base-rate     as decimal   no-undo .
     6154   define variable v-base-scale    as decimal   no-undo .
     6155   define variable v-exch-rate     as decimal   no-undo .
     6156   define variable v-exch-scale    as decimal   no-undo .
     6157   define variable v-host-code     as integer   no-undo .
     6158   define variable v-curr-abbr     as character no-undo .
     6159   define variable v-grp-name      as character no-undo .
     6160   define variable v-date-1        as date      no-undo .
     6161   define variable v-date-2        as date      no-undo .
     6162   define variable v-interv        as character no-undo .
     6163   define variable v-pay-name      as character no-undo .
     6164   define variable v-cli-oborot    as decimal   no-undo .
     6165   define variable v-trn-pay-code  as integer   no-undo .
     6166   define variable v-cash-pay-curr as integer   no-undo .
     6167   define variable v-cash-pay-code as integer   no-undo .
     6168   do
     6169   on error undo, return error return-value
     6170   :
     6171   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6172   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6173   if p-fact-order = ? then do:
     6174     run fact-order-mpl (
     6175         input   today       ,
     6176         input   p-obj-type  ,
     6177         input   p-obj-code  ,
     6178         output  p-fact-order ).
     6179   end.
     6180   if p-vid-pay <> "" then do:
     6181      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6182      if available buf_pay-type
     6183         then v-trn-pay-code = buf_pay-type.obj-code.
     6184         else v-trn-pay-code =  0.
     6185   end.
     6186   else v-trn-pay-code = 0 .
     6187   if p-cash-pay-type <> "" then do:
     6188      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6189      if available buf_pay-type
     6190         then
     6191           assign
     6192             v-cash-pay-curr = buf_cash-pay.curr-code
     6193             v-cash-pay-code = buf_cash-pay.cdpay-code
     6194           .
     6195         else
     6196           assign
     6197             v-cash-pay-curr = 0
     6198             v-cash-pay-code = 0
     6199             .
     6200   end.
     6201   else
     6202     assign
     6203       v-cash-pay-curr = 0
     6204       v-cash-pay-code = 0
     6205       .
     6206   for each tt_price-all  : delete tt_price-all . end.
     6207   assign
     6208     p-plt-id             = ?
     6209     p-plt-db-num         = ?
     6210     p-pdf-id             = ?
     6211     p-pdf-db-num         = ?
     6212     p-sale-price-base    = ?
     6213     p-sale-price-rubl    = ?
     6214     v-cli-oborot         = 0
     6215   .
     6216   find first buf_global-state no-lock no-error .
     6217   if not available buf_global-state then do:
     6218      message
     6219        "Не заданы параметры ценообразования!"
     6220        view-as alert-box error
     6221      .
     6222      return error return-value .
     6223   end.
     6224   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6225   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6226     (input  p-obj-type
     6227     ,input  p-obj-code
     6228     ,output to-day
     6229     )  .
     6230   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6231   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6232     (input  p-obj-type
     6233     ,input  p-obj-code
     6234     ,output v-host-code
     6235     )  .
     6236   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6237   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6238     (input  v-host-code
     6239     ,input  to-day
     6240     ,output v-base-rate0
     6241     ,output v-base-scale0
     6242     )  .
     6243     v-cli-oborot-ALL  = 0 .
     6244     for each buf_turnover-buyer-main no-lock  where
     6245              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6246              buf_turnover-buyer-main.cli-code = p-cli-code
     6247              :
     6248              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6249     end.
     6250   for each buf_price-all no-lock where
     6251            buf_price-all.obj-type = p-obj-type and
     6252            buf_price-all.obj-code = p-obj-code and
     6253            buf_price-all.gds-code = buf_goods.gds-code and
     6254            buf_price-all.status_  = 'акт':U  and
     6255          ( p-only-b-code = false   or
     6256          ( buf_price-all.b-code = p-main-b-code or
     6257            buf_price-all.b-code = p-b-code))    and
     6258           ( p-only-b-code = true  or
     6259             buf_price-all.b-code = p-b-code)
     6260             and
     6261             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6262           ( buf_price-all.fact-order-sys-to = ? or
     6263             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6264           :
     6265            v-interv   = "" .
     6266            v-grp-name = "" .
     6267            v-pay-name = "" .
     6268            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6269            if buf_price-all.bgr-id > 0 then do:
     6270               find first buf_buyer-group no-lock where
     6271                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6272                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6273               if available buf_buyer-group then do:
     6274                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6275                  find first buf_buyer-in-buyer-group no-lock where
     6276                             buf_buyer-in-buyer-group.stts         = 0 and
     6277                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6278                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6279                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6280                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6281                             no-error .
     6282                             if not available buf_buyer-in-buyer-group then do:
     6283                                v-grp-name = "".
     6284                                next.
     6285                             end.
     6286                             v-grp-name = buf_buyer-group.name .
     6287                  end.
     6288               end.
     6289               else do:
     6290                    v-grp-name = "".
     6291                    next.
     6292               end.
     6293            end.
     6294            if buf_price-all.tog-id > 0 then do:
     6295               find first buf_turnover-group no-lock where
     6296                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6297                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6298               if available buf_turnover-group then do:
     6299                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6300                     v-cli-oborot = v-cli-oborot-all  .
     6301                     find first buf1_tnv-in-turnover-group no-lock where
     6302                                buf1_tnv-in-turnover-group.stts       =  0     and
     6303                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6304                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6305                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6306                     find first buf2_tnv-in-turnover-group no-lock where
     6307                                buf2_tnv-in-turnover-group.stts       =  0     and
     6308                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6309                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6310                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6311                     if not (available buf1_tnv-in-turnover-group and
     6312                             available buf2_tnv-in-turnover-group ) then do:
     6313                             v-grp-name = "".
     6314                             next .
     6315                     end.
     6316                     v-grp-name = buf_turnover-group.name.
     6317                  end.
     6318               end.
     6319               else do:
     6320                    v-grp-name = "".
     6321                    next.
     6322               end.
     6323            end.
     6324            if buf_price-all.plt-fix-cource-crc-base = true then
     6325               assign
     6326                 v-base-rate  = buf_price-all.pdf-base-rate
     6327                 v-base-scale = buf_price-all.pdf-base-scale
     6328               .
     6329               else
     6330               assign
     6331                 v-base-rate  = v-base-rate0
     6332                 v-base-scale = v-base-scale0
     6333               .
     6334            if buf_price-all.plt-fix-cource-crc-doc = true then
     6335               assign
     6336                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6337                 v-exch-scale = buf_price-all.pdf-exch-scale
     6338               .
     6339               else do:
     6340   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6341   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6342     (input  buf_price-all.curr-code
     6343     ,input  to-day
     6344     ,output v-exch-rate0
     6345     ,output v-exch-scale0
     6346     ,output v-curr-abbr
     6347     )  .
     6348               assign
     6349                 v-exch-rate  = v-exch-rate0
     6350                 v-exch-scale = v-exch-scale0
     6351                 .
     6352              end.
     6353              v-date-1 = date ( "" )  .
     6354              if buf_price-all.fact-order-sys-from > 0 then do:
     6355                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6356                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6357                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6358              end.
     6359              v-date-2 =  date ( "" )  .
     6360              if buf_price-all.fact-order-sys-to > 0 then do:
     6361                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6362                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6363                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6364              end.
     6365              if buf_price-all.qnty-from <> ? then do :
     6366                 if not (
     6367                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6368                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6369                 ) then do:
     6370                        v-interv = "".
     6371                        next.
     6372                 end.
     6373                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6374              end.
     6375              if buf_price-all.sum-from <> ? then do :
     6376                 if not (
     6377                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6378                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6379                 ) then do:
     6380                    v-interv = "".
     6381                    next.
     6382                 end.
     6383                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6384              end.
     6385              if buf_price-all.turnover-from <> ? then do :
     6386                 if not (
     6387                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6388                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6389                 ) then do:
     6390                    v-interv = "".
     6391                    next.
     6392                 end.
     6393                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6394              end.
     6395              if buf_price-all.use-pay-type = 1 then do :
     6396                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6397                    v-pay-name = "" .
     6398                    next.
     6399                  end.
     6400                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6401              end.
     6402              if buf_price-all.use-cash-pay = 1 then do :
     6403                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6404                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6405                   v-pay-name = "" .
     6406                   next.
     6407                 end.
     6408                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6409              end.
     6410             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6411             create tt_price-all .
     6412             buffer-copy buf_price-all to tt_price-all
     6413             assign
     6414               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6415               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6416               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6417               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6418               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6419               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6420               tt_price-all.price-sale     = buf_price-all.price-sale
     6421               tt_price-all.road-tax       = buf_price-all.road-tax
     6422               tt_price-all.excise         = buf_price-all.excise
     6423               tt_price-all.pdf-exch-rate   = v-exch-rate
     6424               tt_price-all.pdf-exch-scale  = v-exch-scale
     6425               tt_price-all.pdf-base-rate   = v-base-rate
     6426               tt_price-all.pdf-base-scale  = v-base-scale
     6427               tt_price-all.grp-name        = v-grp-name
     6428               tt_price-all.date-1          = v-date-1
     6429               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6430               tt_price-all.time-1          = buf_price-all.start-sys-time
     6431               tt_price-all.date-2          = v-date-2
     6432               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6433               tt_price-all.time-2          = buf_price-all.end-sys-time
     6434               tt_price-all.interv-name     = v-interv
     6435               tt_price-all.pay-name        = v-pay-name
     6436               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6437             .
     6438   end.
     6439   define variable vt-plt-id as integer   no-undo .
     6440   define variable vt-plt-db as integer   no-undo .
     6441   define variable vt-pdf-id as integer   no-undo .
     6442   define variable vt-pdf-db as integer   no-undo .
     6443   define buffer neos_price-all for tt_price-all  .
     6444   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6445       if available tt_price-all then do:
     6446        assign
     6447          vt-plt-id = tt_price-all.plt-id
     6448          vt-plt-db = tt_price-all.plt-db-num
     6449          vt-pdf-id = tt_price-all.pdf-id
     6450          vt-pdf-db = tt_price-all.pdf-db
     6451        .
     6452        if tt_price-all.b-code = p-b-code then do:
     6453             assign
     6454               p-plt-id           = tt_price-all.plt-id
     6455               p-plt-db-num       = tt_price-all.plt-db-num
     6456               p-pdf-id           = tt_price-all.pdf-id
     6457               p-pdf-db-num       = tt_price-all.pdf-db
     6458               p-sale-price-base  = tt_price-all.price-sale-base
     6459               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6460               p-road-tax-base    = tt_price-all.road-tax-base
     6461               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6462               p-excise-base      = tt_price-all.excise-base
     6463               p-excise-rubl      = tt_price-all.excise-rubl
     6464               .
     6465        end.
     6466        else do:
     6467          find first neos_price-all where
     6468                     neos_price-all.b-code     = p-b-code  and
     6469                     neos_price-all.plt-id     = vt-plt-id and
     6470                     neos_price-all.plt-db-num = vt-plt-db and
     6471                     neos_price-all.pdf-id     = vt-pdf-id and
     6472                     neos_price-all.pdf-db     = vt-pdf-db
     6473                     use-index pi no-error .
     6474            if available neos_price-all then do:
     6475             assign
     6476               p-plt-id           = tt_price-all.plt-id
     6477               p-plt-db-num       = tt_price-all.plt-db-num
     6478               p-pdf-id           = tt_price-all.pdf-id
     6479               p-pdf-db-num       = tt_price-all.pdf-db
     6480               p-sale-price-base  = neos_price-all.price-sale-base
     6481               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6482               p-road-tax-base    = neos_price-all.road-tax-base
     6483               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6484               p-excise-base      = neos_price-all.excise-base
     6485               p-excise-rubl      = neos_price-all.excise-rubl
     6486               .
     6487            end.
     6488            else do:
     6489                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6490                 if error-status :error    then do:
     6491                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6492                   return error return-value .
     6493                 end.
     6494             assign
     6495               p-plt-id           = tt_price-all.plt-id
     6496               p-plt-db-num       = tt_price-all.plt-db-num
     6497               p-pdf-id           = tt_price-all.pdf-id
     6498               p-pdf-db-num       = tt_price-all.pdf-db
     6499               p-sale-price-base  = tt_price-all.price-sale-base
     6500               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6501               p-road-tax-base    = tt_price-all.road-tax-base
     6502               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6503               p-excise-base      = tt_price-all.excise-base
     6504               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6505               .
     6506            end.
     6507        end.
     6508     end.
     6509   end.
     6510   end procedure.
     6511   procedure mpl-tpl-auto :
     6512   define input  parameter p-b-code     as integer   no-undo .
     6513   define input  parameter p-obj-type   as character no-undo .
     6514   define input  parameter p-obj-code   as integer   no-undo .
     6515   define input  parameter p-plt-id     as integer   no-undo .
     6516   define input  parameter p-plt-db-num as integer   no-undo .
     6517   define input  parameter p-fact-order as decimal   no-undo .
     6518   define output parameter p-sale-price as decimal   no-undo .
     6519   define output parameter p-pdf-id     as integer   no-undo .
     6520   define output parameter p-pdf-db-num as integer   no-undo .
     6521     do
     6522     on error undo, return error return-value
     6523     :
     6524   if p-fact-order = ? then do:
     6525     run fact-order-mpl (
     6526         input   today       ,
     6527         input   p-obj-type  ,
     6528         input   p-obj-code  ,
     6529         output  p-fact-order ) .
     6530   end.
     6531   assign
     6532     p-pdf-id      = ?
     6533     p-pdf-db-num  = ?
     6534     p-sale-price  = ?
     6535   .
     6536   define buffer buf_bar-code for ub.bar-code  .
     6537   define buffer buf_goods for ub.goods  .
     6538   find first buf_bar-code no-lock where
     6539              buf_bar-code.b-code = p-b-code
     6540              no-error .
     6541   if error-status :error then return error return-value .
     6542   find first buf_goods no-lock where
     6543              buf_goods.gds-code = buf_bar-code.gds-code
     6544              no-error .
     6545   if error-status :error then return error return-value .
     6546   define variable v-main-b-code as integer   no-undo .
     6547   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6548     (input  buf_goods.gds-code
     6549     ,input  ?
     6550     ,output v-main-b-code
     6551     )  .
     6552   define buffer buf_price-all for ub.price-all  .
     6553   for each tt_price-all : delete tt_price-all. end.
     6554       for each buf_price-all no-lock where
     6555               buf_price-all.plt-id     = p-plt-id                 and
     6556               buf_price-all.plt-db-num = p-plt-db-num             and
     6557               buf_price-all.obj-type   = p-obj-type               and
     6558               buf_price-all.obj-code   = p-obj-code               and
     6559               buf_price-all.gds-code   = buf_goods.gds-code       and
     6560             ( buf_price-all.b-code = v-main-b-code or
     6561               buf_price-all.b-code = p-b-code)    and
     6562               buf_price-all.status_    = 'акт':U         and
     6563               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6564             ( buf_price-all.fact-order-sys-to = ? or
     6565               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6566               :
     6567                 create tt_price-all .
     6568                 buffer-copy buf_price-all to tt_price-all
     6569                 assign
     6570                   tt_price-all.price-sale  = buf_price-all.price-sale
     6571                 .
     6572       end.
     6573   define variable vt-plt-id as integer   no-undo .
     6574   define variable vt-plt-db as integer   no-undo .
     6575   define variable vt-pdf-id as integer   no-undo .
     6576   define variable vt-pdf-db as integer   no-undo .
     6577   define buffer neos_price-all for tt_price-all  .
     6578   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6579       if available tt_price-all then do:
     6580        assign
     6581          vt-plt-id = tt_price-all.plt-id
     6582          vt-plt-db = tt_price-all.plt-db-num
     6583          vt-pdf-id = tt_price-all.pdf-id
     6584          vt-pdf-db = tt_price-all.pdf-db
     6585        .
     6586        if tt_price-all.b-code = p-b-code then do:
     6587             assign
     6588               p-plt-id           = tt_price-all.plt-id
     6589               p-plt-db-num       = tt_price-all.plt-db-num
     6590               p-pdf-id           = tt_price-all.pdf-id
     6591               p-pdf-db-num       = tt_price-all.pdf-db
     6592               p-sale-price       = tt_price-all.price-sale
     6593               .
     6594        end.
     6595        else do:
     6596          find first neos_price-all where
     6597                     neos_price-all.b-code     = p-b-code  and
     6598                     neos_price-all.plt-id     = vt-plt-id and
     6599                     neos_price-all.plt-db-num = vt-plt-db and
     6600                     neos_price-all.pdf-id     = vt-pdf-id and
     6601                     neos_price-all.pdf-db     = vt-pdf-db
     6602                     use-index pi no-error .
     6603            if available neos_price-all then do:
     6604             assign
     6605               p-plt-id           = tt_price-all.plt-id
     6606               p-plt-db-num       = tt_price-all.plt-db-num
     6607               p-pdf-id           = tt_price-all.pdf-id
     6608               p-pdf-db-num       = tt_price-all.pdf-db
     6609               p-sale-price       = neos_price-all.price-sale
     6610               .
     6611            end.
     6612            else do:
     6613           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
