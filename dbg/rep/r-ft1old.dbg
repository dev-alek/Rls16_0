     4591   .
     4592   procedure fill-sjt12 :
     4593     _main:
     4594     do
     4595     on error undo, return error
     4596     :
     4597       define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     4598       define variable v-inkas-code like ub.inkas.inkas-code no-undo .
     4599       define variable v-trn-doc-code like ub.trn-doc.doc-code no-undo .
     4600       define variable v-ret-doc-code like ub.trn-doc.out-code no-undo .
     4601       define variable v-doc-code     like ub.trn-doc.doc-code no-undo .
     4602       define variable check-v-doc-code     like ub.trn-doc.doc-code no-undo .
     4603       define buffer buf_trn-doc for ub.trn-doc.
     4604       define buffer buf_ret-doc for ub.trn-doc.
     4605       define buffer buf_inkas for ub.inkas.
     4606       define buffer buf_chk-doc for ub.chk-doc.
     4607       define buffer buf_chk-gds for ub.chk-gds.
     4608       define buffer buf_goods for ub.goods.
     4609       define buffer buf_bar-code for ub.bar-code.
     4610       define buffer buf_sj-t12 for sj-t12.
     4611       define buffer buf_gds-dtl for ub.gds-dtl.
     4612       define buffer buf_doc-line for ub.doc-line.
     4613       define buffer buf_sale-doc for ub.sale-doc.
     4614         FOR EACH sj-t12 :
     4615           delete sj-t12 .
     4616         END .
     4617         find first buf_trn-doc no-lock where
     4618                   buf_trn-doc.doc-code = p-doc-code no-error .
     4619         if not available buf_trn-doc then do:
     4620           undo _main, return error substitute("Не найден документ с номером &1", p-doc-code).
     4621         end.
     4622         if NOT (buf_trn-doc.ext-doc-type = 'es':U
     4623                 or
     4624                 buf_trn-doc.ext-doc-type = 'rs':U
     4625                 ) then do:
     4626           undo _main, return error substitute("Неверный тип документа &1: &2", p-doc-code, buf_trn-doc.ext-doc-type).
     4627         end.
     4628         if buf_trn-doc.ext-doc-type = 'es':U then do:
     4629           assign
     4630           v-inkas-code = buf_trn-doc.doc-code
     4631           v-trn-doc-code = buf_trn-doc.doc-code
     4632           v-ret-doc-code = buf_trn-doc.out-code
     4633           v-doc-code     = v-trn-doc-code
     4634           .
     4635         end.
     4636         else do:
     4637           assign
     4638           v-inkas-code = buf_trn-doc.out-code
     4639           v-trn-doc-code = buf_trn-doc.out-code
     4640           v-ret-doc-code = buf_trn-doc.doc-code
     4641           v-doc-code     = v-ret-doc-code
     4642           .
     4643         end.
     4644         _chk-doc:
     4645         FOR EACH buf_chk-doc No-LOCK WHERE
     4646                   buf_chk-doc.obj-type = buf_trn-doc.obj-type AND
     4647                   buf_chk-doc.obj-code = buf_trn-doc.obj-code AND
     4648                   buf_chk-doc.out-code = v-inkas-code,
     4649             EACH buf_chk-gds WHERE
     4650                   buf_chk-gds.doc-code = buf_chk-doc.doc-code NO-LOCK,
     4651             FIRST buf_bar-code WHERE
     4652                   buf_bar-code.b-code = buf_chk-gds.b-code NO-LOCK,
     4653             FIRST buf_goods WHERE
     4654                   buf_goods.gds-code = buf_bar-code.gds-code
     4655                   :
     4656           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     4657           if num-entries(buf_chk-gds.line-type, chr(4)) > 1 then do:
     4658             find first buf_sale-doc no-lock where
     4659                       buf_sale-doc.inkas-code = v-inkas-code
     4660                   and buf_sale-doc.doc-kind = entry(1, entry(2, buf_chk-gds.line-type, chr(4))) no-error .
     4661             if available buf_sale-doc then do:
     4662               assign
     4663               check-v-doc-code = buf_sale-doc.doc-code.
     4664             end.
     4665           end.
     4666           if v-doc-code = '':U then do:
     4667             if buf_chk-doc.netto >= 0 then
     4668             check-v-doc-code = v-trn-doc-code.
     4669             else
     4670             check-v-doc-code = v-ret-doc-code.
     4671           end.
     4672           if check-v-doc-code <> v-doc-code then do:
     4673            next _chk-doc.
     4674          end.
     4675           FIND FIRST buf_gds-dtl WHERE
     4676                     buf_gds-dtl.doc-code  = v-doc-code AND
     4677                     buf_gds-dtl.artic     = buf_goods.artic AND
     4678                     buf_gds-dtl.prod-type = buf_goods.prod-type AND
     4679                     buf_gds-dtl.prod-code = buf_goods.prod-code AND
     4680                     buf_gds-dtl.prt-code  = buf_bar-code.node-code NO-LOCK NO-ERROR .
     4681           if available buf_gds-dtl then do:
     4682             FIND FIRST buf_doc-line WHERE
     4683                       buf_doc-line.doc-code  = buf_gds-dtl.doc-code AND
     4684                       buf_doc-line.prod-type = buf_gds-dtl.prod-type AND
     4685                       buf_doc-line.prod-code = buf_gds-dtl.prod-code  AND
     4686                       buf_doc-line.artic     = buf_gds-dtl.artic NO-LOCK NO-ERROR.
     4687           end.
     4688           find first buf_sj-t12 where
     4689                     buf_sj-t12.b-code   = buf_chk-gds.b-code
     4690                 AND buf_sj-t12.gds-code = buf_goods.gds-code no-error .
     4691           if not available buf_sj-t12
     4692           and available buf_gds-dtl
     4693           then do:
     4694             create buf_sj-t12.
     4695             buffer-copy buf_gds-dtl
     4696             using
     4697             artic
     4698             prod-type
     4699             prod-code
     4700             cur-base
     4701             discnt-base
     4702             discnt-pc
     4703             discnt-rubl
     4704             discnt-type
     4705             doc-code
     4706             obj-code
     4707             obj-type
     4708             ov
     4709             price-base
     4710             price-rubl
     4711             to  buf_sj-t12
     4712             assign
     4713             buf_sj-t12.b-code    = buf_Chk-gds.b-code
     4714             buf_sj-t12.gds-code  = buf_goods.gds-code
     4715             buf_sj-t12.prt-code  = buf_bar-code.node-code
     4716             buf_sj-t12.gds-dtl-qnty = buf_gds-dtl.doc-qnty
     4717             .
     4718           end.
     4719           if available buf_sj-t12 then do:
     4720             assign
     4721             buf_sj-t12.doc-qnty    = buf_sj-t12.doc-qnty + (if buf_chk-doc.netto >= 0 then 1 else - 1) * buf_chk-gds.doc-qnty
     4722             buf_sj-t12.fact-qnty    = buf_sj-t12.fact-qnty + (if buf_chk-doc.netto >= 0 then 1 else - 1) * buf_chk-gds.doc-qnty
     4723             buf_sj-t12.gds-dtl-qnty = buf_gds-dtl.doc-qnty
     4724             buf_sj-t12.IS-OK        = (buf_sj-t12.gds-dtl-qnty = buf_sj-t12.fact-qnty)
     4725             .
     4726           end.
     4727           if available buf_gds-dtl
     4728           and available buf_doc-line
     4729           and buf_doc-line.doc-qnty <> 0
     4730           and available buf_sj-t12
     4731           and not buf_sj-t12.calced
     4732           then do:
     4733   if buf_trn-doc.ext-doc-type = 'ot':U or
     4734      buf_trn-doc.ext-doc-type = ?                 then do:
     4735     assign
     4736      out-vatp-have-vat-slt = yes.
     4737   end.
     4738   else do:
     4739     find first out-vatp_doc-attr no-lock
     4740       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     4741         and out-vatp_doc-attr.attr-code = 'envd':U
     4742         no-error .
     4743     if not available out-vatp_doc-attr then do:
     4744       assign
     4745         out-vatp-have-vat-slt = yes.
     4746     end.
     4747     else do:
     4748        out-vatp-have-vat-slt = no.
     4749     end.
     4750   end.
     4751   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     4752                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     4753                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     4754   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4755   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     4756     (input  buf_doc-line.artic
     4757     ,input  buf_doc-line.prod-type
     4758     ,input  buf_doc-line.prod-code
     4759     ,output varroot-node
     4760     ) no-error .
     4761   if error-status :error then do:
     4762     message
     4763       vss-workfile vss-revision vss-description skip
     4764       "Ошибка при определении корневого признака товара" skip
     4765       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4766       error-status :get-message(1) skip
     4767       return-value skip
     4768       view-as alert-box error .
     4769     undo, return error .
     4770   end.
     4771   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     4772     (input  varroot-node
     4773     ,input  'empty-scale=request'
     4774     ,output varempty-scale
     4775     ) no-error .
     4776   if error-status :error then do:
     4777     message
     4778       vss-workfile vss-revision vss-description skip
     4779       "Ошибка при определении атрибута признака" skip
     4780       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     4781       "Признак" varroot-node skip
     4782       "Запрашивался атрибут" "empty-scale=request" skip
     4783       error-status :get-message(1) skip
     4784       return-value skip
     4785       view-as alert-box error .
     4786     undo, return error .
     4787   end.
     4788   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     4789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     4790     (output varoutvprb
     4791     )  .
     4792   if varoutvprb = "base":u then do:
     4793     assign
     4794           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4795       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     4796     .
     4797   end.
     4798   else do:
     4799     assign
     4800           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4801       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     4802     .
     4803   end.
     4804   if varoutvprb = "rubl":u then do:
     4805     assign
     4806           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     4807       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     4808   end.
