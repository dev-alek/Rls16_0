     3415                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3416               .
     3417            end.
     3418        end.
     3419       end case.
     3420      if v-torgconf-outB = "no_print"
     3421      then do:
     3422         assign v-torgconf-main-buh = "".
     3423      end.
     3424      if v-torgconf-outB = "glbuh_firm"
     3425      then do:
     3426            if v-torgconf-self-host-code = 0
     3427            then do:
     3428            end.
     3429            else do:
     3430               find first buf_sysconf no-lock
     3431                  where buf_sysconf.host-code = v-torgconf-self-host-code
     3432               .
     3433               assign
     3434                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3435               .
     3436            end.
     3437      end.
     3438      if v-torgconf-outB = "buh_obj"
     3439      then do:
     3440         CASE v-torgconf-self-obj-type:
     3441         WHEN 'маг':U
     3442         THEN DO:
     3443            find first buf_shop no-lock
     3444            where buf_shop.obj-code = v-torgconf-self-obj-code
     3445            .
