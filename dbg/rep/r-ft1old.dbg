     9328          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     9329   if available out-vatp_doc-line           and
     9330     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     9331     assign
     9332       varfact-qnty = out-vatp_doc-line.fact-qnty.
     9333   end.
     9334   else do:
     9335     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     9336                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     9337                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     9338                                  and out-vatp_parts.artic      = buf_doc-line.artic
     9339                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     9340                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     9341       if out-vatp_parts.purch-code = 2 then do:
     9342   assign
     9343     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     9344     price-base-with-tax-loco = out-vatp_parts.price-base
     9345   .
     9346   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9347   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9348     (output varinvprbo
