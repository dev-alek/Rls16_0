     1146   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147   define new global shared variable g#trdcalib as handle no-undo.
     1148   procedure wthcattr-sprcli :
     1149   define input parameter parparentproc  as widget-handle no-undo.
     1150   define input parameter p-mode  as character no-undo.
     1151   define input-output parameter p-value as character no-undo .
     1152   define output parameter p-setted as logical no-undo .
     1153     DEFINE VARIABLE v-value as character no-undo .
     1154     define variable v-cli-type as character no-undo .
     1155     define variable v-cli-code as integer no-undo .
     1156     define buffer buf_clients   for ub.clients.
     1157     define variable v_rid as character no-undo.
     1158     define variable ref-rec as recid no-undo .
     1159     do
     1160     on error undo, return error
     1161     :
     1162         v-value = p-value.
     1163      if p-value <> '':U then do:
     1164       assign
     1165       v-cli-type = substring(p-value, 1, 3)
     1166       v-cli-code = integer(substring(p-value, 4))
     1167       no-error.
     1168       if error-status:error then do:
     1169         assign
     1170         v-cli-type = '':U
     1171         v-cli-code = 0
     1172         .
     1173       end.
     1174      end.
     1175      FIND FIRST buf_clients NO-LOCK WHERE
     1176               buf_clients.obj-type = v-cli-type AND
     1177               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1178      IF available(buf_clients) then do:
     1179       run ref/cli-all.w (
     1180                   input parparentproc
     1181                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1182                  ,input v-cli-type
     1183                  ,input 'все':U
     1184                  ,input 'все':U
     1185                  ,input RECID( buf_clients )
     1186                  ,input ",,,,,,NO"
     1187                  ,input ?
     1188                  ,OUTPUT v_rid ).
     1189     END.
     1190     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1191       run ref/cli-all.w (
     1192                    input parparentproc
     1193                   ,INPUT "b-sel":U
     1194                  ,input  v-cli-type
     1195                  ,input 'все':U
     1196                  ,input 'текущие':U
     1197                  ,input ?
     1198                  ,input ",,,,,,NO"
     1199                  ,input ?
     1200                  ,OUTPUT v_rid ).
     1201     END.
     1202     else do:
     1203       message
     1204       if p-value = "":U then 'Атрибут не задан!'
     1205       else substitute('Не найден клиент &1',p-value)
     1206       view-as alert-box warning.
     1207     end.
     1208     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1209       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1210       IF ERROR-STATUS:ERROR THEN DO:
     1211           RETURN NO-APPLY.
     1212       END.
     1213       FIND FIRST buf_clients NO-LOCK WHERE
     1214                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1215       IF AVAIL buf_clients THEN DO:
     1216         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1217       end.
     1218     end.
     1219     if v-value <> p-value then do:
     1220       p-value = v-value.
     1221       p-setted = yes.
     1222     end.
     1223     end.
     1224   end procedure.
     1225     define new global shared variable g#wthcalib as handle no-undo.
     1226   procedure torgconf-read :
     1227   do
     1228   on error undo, return error
     1229   :
     1230       define input parameter p-form-name  as character    no-undo.
     1231       define input parameter p-host-code  as integer      no-undo.
     1232       define input parameter p-obj-type   as character    no-undo.
     1233       define input parameter p-obj-code   as integer      no-undo.
     1234       define variable v-outdate   as character     no-undo.
     1235       define variable v-outares   as character     no-undo.
     1236       define variable v-outsend   as character     no-undo.
     1237       define variable v-outasend  as character     no-undo.
     1238       define variable v-outprops  as character     no-undo.
     1239       define variable v-outnum    as character     no-undo.
     1240       define variable v-outprim   as character     no-undo.
     1241       define variable v-outdisc   as character     no-undo.
     1242       define variable v-outsubs   as character     no-undo.
     1243       define variable v-outrecv   as character     no-undo.
     1244       define variable v-outegrp   as character     no-undo.
     1245       define variable v-outt12    as character     no-undo.
     1246       define variable v-outappr   as character     no-undo.
     1247       define variable v-outrubl   as character     no-undo.
     1248       define variable v-outhold   as character     no-undo.
     1249       define variable v-outobj    as character     no-undo.
     1250       define variable v-outexlst  as character     no-undo.
     1251       define variable v-outprncd  as character     no-undo.
     1252       define variable v-par-type  as character     no-undo.
     1253       define variable v-outogr    as character     no-undo.
     1254       define variable v-outR      as character     no-undo.
     1255       define variable v-outB      as character     no-undo.
     1256       define variable v-outC      as character     no-undo.
     1257       assign
     1258           v-torgconf-outdate  = no
     1259           v-torgconf-outnum   = no
     1260           v-torgconf-outprim  = no
     1261           v-torgconf-outdisc  = no
     1262           v-torgconf-outsubs  = no
     1263           v-torgconf-outrecv  = no
     1264           v-torgconf-outegrp  = no
     1265           v-torgconf-outt12   = no
     1266           v-torgconf-outappr  = no
     1267           v-torgconf-outrubl  = no
     1268           v-torgconf-outhold  = no
     1269           v-torgconf-outobj   = no
     1270           v-torgconf-outexlst = no
     1271           v-torgconf-outexpas = "":U
     1272           v-torgconf-outprncd = yes
     1273           v-torgconf-outares  = no
     1274           v-torgconf-outsend  = no
     1275           v-torgconf-outasend  = no
     1276           v-torgconf-outprops  = no
     1277           v-form-name          = p-form-name
     1278       .
     1279   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1280   empty temp-table thbjattr_thbj-attr.
     1281   run adm/shattri.p (
     1282      input "get":U
     1283     ,input ''
     1284     ,input 0
     1285     ,input 'prt-glob':U
     1286     ,input  ""
     1287     ,output v-value-character
     1288     ,output v-value-date
     1289     ,output v-value-decimal
     1290     ,output v-value-integer
     1291     ,output v-value-logical
     1292     ,output par-type
     1293     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1294     ) no-error .
     1295   for each thbjattr_thbj-attr :
     1296       if thbjattr_thbj-attr.prop-code = 'outprncd':U then v-outprncd =  string(thbjattr_thbj-attr.property-value-logical) .
     1297       if thbjattr_thbj-attr.prop-code = 'outrecv':U  then v-outrecv  =  thbjattr_thbj-attr.property-value-character .
     1298       if thbjattr_thbj-attr.prop-code = 'outprops':U then v-outprops =  thbjattr_thbj-attr.property-value-character .
     1299   end.
     1300   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1301   empty temp-table thbjattr_thbj-attr.
     1302   run adm/shattri.p (
     1303      input "get":U
     1304     ,input p-obj-type
     1305     ,input p-obj-code
     1306     ,input 'prt-obj':U
     1307     ,input  ""
     1308     ,output v-value-character
     1309     ,output v-value-date
     1310     ,output v-value-decimal
     1311     ,output v-value-integer
     1312     ,output v-value-logical
     1313     ,output par-type
     1314     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     1315     ) no-error .
     1316   for each thbjattr_thbj-attr :
     1317       if thbjattr_thbj-attr.prop-code = 'outdate':U  then v-outdate  =  thbjattr_thbj-attr.property-value-character .
     1318       if thbjattr_thbj-attr.prop-code = 'outares':U  then v-outares  =  thbjattr_thbj-attr.property-value-character .
     1319       if thbjattr_thbj-attr.prop-code = 'outnum':U   then v-outnum   =  thbjattr_thbj-attr.property-value-character .
     1320       if thbjattr_thbj-attr.prop-code = 'outprim':U  then v-outprim  =  thbjattr_thbj-attr.property-value-character .
     1321       if thbjattr_thbj-attr.prop-code = 'outdisc':U  then v-outdisc  =  thbjattr_thbj-attr.property-value-character .
     1322       if thbjattr_thbj-attr.prop-code = 'outsubs':U  then v-outsubs  =  thbjattr_thbj-attr.property-value-character .
     1323       if thbjattr_thbj-attr.prop-code = 'outegrp':U  then v-outegrp  =  thbjattr_thbj-attr.property-value-character .
