     1464   procedure torgconf-get-self-param :
     1465   define input parameter p-obj-type           as character        no-undo.
     1466   define input parameter p-obj-code           as integer          no-undo.
     1467   define input parameter p-curr-code          as integer          no-undo.
     1468       define variable v-host-code    as integer      no-undo.
     1469       define variable v-par-type     as character    no-undo.
     1470   do
     1471   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1472   :
     1473   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1474   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1475     (input  p-obj-type
     1476     ,input  p-obj-code
     1477     ,output v-host-code
     1478     )  .
     1479       if v-torgconf-outhold = yes
     1480       then do:
     1481           run torgconf-get-holdfirm-code in this-procedure (
     1482                 input p-obj-type
     1483               , input p-obj-code
     1484               , output v-torgconf-self-host-code
     1485           ).
     1486           if v-torgconf-self-host-code = 0
     1487           then do:
     1488               return error.
     1489           end.
     1490       end.
     1491       else do:
     1492           assign
     1493               v-torgconf-self-host-code = v-host-code
     1494           .
     1495       end.
     1496       if v-torgconf-self-host-code = 0
     1497       then do:
     1498           assign
     1499               v-torgconf-self-host-name           = "":U
     1500               v-torgconf-self-host-addres         = "":U
     1501               v-torgconf-self-host-post-addres    = "":U
     1502               v-torgconf-self-host-phone          = "":U
     1503               v-torgconf-self-host-inn            = "":U
     1504               v-torgconf-self-host-kpp            = "":U
     1505               v-torgconf-self-host-okpo           = "":U
     1506               v-torgconf-self-host-egrip-date     = "":U
     1507               v-torgconf-self-host-egrip-num      = "":U
     1508           .
     1509       end.
     1510       else do:
     1511           run fmtcli-get-client in this-procedure (
     1512                 input 'орг':U
     1513               , input v-torgconf-self-host-code
     1514           ).
     1515           assign
     1516               v-torgconf-self-host-name        = v-fmtcli-name
     1517               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1518               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1519               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1520               v-torgconf-self-host-phone       = v-fmtcli-phone
     1521               v-torgconf-self-host-inn         = v-fmtcli-inn
     1522               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1523               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1524           .
     1525           run gbl/clntat-v.p (
     1526                 input 'орг':U
     1527               , input v-torgconf-self-host-code
     1528               , input 'egrip-date':U
     1529               , output v-torgconf-self-host-egrip-date
     1530               , output v-par-type
     1531           ).
     1532           run gbl/clntat-v.p (
     1533                 input 'орг':U
     1534               , input v-torgconf-self-host-code
     1535               , input 'egrip-num':U
     1536               , output v-torgconf-self-host-egrip-num
     1537               , output v-par-type
     1538           ).
     1539           run fmtcli-get-bank in this-procedure (
     1540                 input v-host-code
     1541               , input 'орг':U
     1542               , input v-torgconf-self-host-code
     1543               , input p-curr-code
     1544           ).
     1545       end.
     1546       assign
     1547           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1548           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1549           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1550           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1551           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1552           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1553           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1554           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1555       .
     1556       assign
     1557           v-torgconf-self-obj-type = p-obj-type
     1558           v-torgconf-self-obj-code = p-obj-code
     1559       .
     1560       run fmtcli-get-client in this-procedure (
     1561             input p-obj-type
     1562           , input p-obj-code
     1563       ).
     1564       assign
     1565           v-torgconf-self-obj-name       = v-fmtcli-name
     1566           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1567           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1568           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1569           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1570           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1571           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1572       .
     1573   end.
     1574   end procedure.
     1575   procedure torgconf-get-recepient-param :
     1576   define input parameter torgconfdoc-code   as character                  no-undo.
     1577   define output parameter v-code-rec        as integer                    no-undo .
     1578   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1579   define output parameter v-codefirm-rec    as integer                    no-undo .
     1580   define output parameter v-curcode-rec     as integer                    no-undo .
     1581        define variable  v-recipient-code  as character                  no-undo .
     1582        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1583        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1584   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1585                           input 'Recipient':U ,
     1586                          output v-recipient-code ,
     1587                          output v-trdcattr-type ) no-error .
     1588       if error-status :error then do:
     1589        message
     1590         vss-workfile vss-revision vss-description skip
     1591         "Ошибка при вызове процедуры tdat-val":U skip
     1592         "Документ: " torgconfdoc-code skip
     1593         "Атрибут: " 'Recipient':U skip
     1594         "Значение: " v-recipient skip
     1595         trim( error-status :get-message (1) ) skip
     1596         return-value skip
     1597         view-as alert-box error.
     1598       undo, return error return-value.
     1599       end.
     1600     assign
     1601       v-recipient  = v-recipient-code
     1602       v-type-rec = substring(v-recipient-code,1,3)
     1603       v-code-rec  = int(substring(v-recipient-code,4,15))
     1604       no-error
     1605     .
     1606     if v-type-rec = ? then v-type-rec = "" .
     1607     if v-code-rec  = ? then v-code-rec  =  0 .
     1608     end procedure.
