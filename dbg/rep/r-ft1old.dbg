     9551                   then do:
     9552                       if p-round = "round":U
     9553                       then do:
     9554                           run p-fmt-round in this-procedure (
     9555                                 input prt-tqnty
     9556                               , input p-avg-prt-price-no-tax
     9557                               , input v-avg-VAT-out     / tqnty
     9558                               , input prt-SLT-gds       / tqnty
     9559                               , input 0
     9560                               , output p-avg-prt-price-no-tax
     9561                               , output v-vat-pc
     9562                               , output v-slt-pc
     9563                               , output v-avg-VAT-out
     9564                               , output prt-SLT-gds
     9565                               , output v-void-decimal
     9566                               , output v-avg-prt-sum-without-tax-out
     9567                               , output v-avg-prt-sum-with-tax-out
     9568                           ).
     9569                           assign
     9570                               v-avg-prt-sum-with-tax-out  = v-avg-prt-sum-with-tax-out - prt-SLT-gds
     9571                               p-avg-prt-price             = v-avg-prt-sum-with-tax-out / prt-tqnty
     9572                           .
