     9577                           , input substitute( "&1 &2", goods.artic, v-prt-name )
     9578                           , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
     9579                           , input goods.unit-base
