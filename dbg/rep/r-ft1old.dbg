      457       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      458       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      459       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      460       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      461       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      462       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      463       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      464       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      465       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      466       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      467       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      468       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      469       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      470       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      471       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      472       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      473       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      474       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      475       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      476       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      477       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      478       define variable varinvatp-envdo             as   character              no-undo.
      479       define variable varinvatp-typeo             as   character              no-undo.
      480   function cross-list returns logical (
      481     input parfirst-stream  as character,
      482     input parsecond-stream as character,
      483     input pardelim         as character).
      484     if pardelim = ""
      485     or pardelim = ?
      486     then do:
      487       assign
      488         pardelim = ","
      489       .
      490     end.
      491     define variable vari            as integer no-undo .
      492     define variable varresult-cross as logical no-undo .
      493     assign
      494       varresult-cross = no
      495     .
      496     def var v-num-parfirst-stream as integer no-undo .
      497     assign
      498       v-num-parfirst-stream = num-entries(parfirst-stream, pardelim)
      499     .
      500     do vari = 1 to v-num-parfirst-stream
      501     :
      502       if lookup(entry(vari, parfirst-stream, pardelim)
      503                ,parsecond-stream
      504                ,pardelim
      505                ) > 0 then do:
      506         assign
      507           varresult-cross = yes
      508         .
      509         leave.
      510       end.
      511     end.
      512     return varresult-cross .
      513   end function.
      514   function hvrdtax return logical (input parrecid as recid):
      515   define variable varresult as logical no-undo.
      516   run hvrdtax-proc (input parrecid, output varresult).
      517   return varresult.
      518   end function.
      519   procedure hvrdtax-proc:
      520   define input  parameter parrecid  as recid   no-undo.
      521   define output parameter parresult as logical no-undo.
      522   define buffer bf_goods for ub.goods.
      523   define buffer bf_units for ub.units.
      524   define buffer rt_tax   for ub.tax.
      525   find first rt_tax   where rt_tax.tax-code    = integer('3':U) no-lock no-error.
      526   find first bf_goods where recid(bf_goods)    = parrecid              no-lock.
      527   find first bf_units where bf_units.unit-name = bf_goods.unit-base    no-lock.
      528   if available rt_tax and
      529       can-find(first ub.tax-units No-LOCK WHERE
      530                      ub.tax-units.tax-code = rt_tax.tax-code AND
      531                      LOOKUP(ub.tax-units.type, bf_units.type) > 0) then assign parresult = yes.
      532                                                       else assign parresult = no.
      533   end procedure.
      534   def var vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      535   procedure tax-name:
      536   define input  parameter pardef-tax  as character           no-undo.
      537   define output parameter parname-tax as character initial ? no-undo.
      538   define buffer bf_tax for ub.tax.
      539   do on error undo, return error :
      540      case pardef-tax:
      541         when 'vat':U then do:
      542                     find first bf_tax where bf_tax.tax-code = integer('1':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '1':U(не задействован)".
      543         end.
      544         when 'slt':U then do:
      545                     find first bf_tax where bf_tax.tax-code = integer('2':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '2':U(не задействован)".
      546         end.
      547         when 'rdt':U then do:
      548                     find first bf_tax where bf_tax.tax-code = integer('3':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '3':U(не задействован)".
      549         end.
      550         when 'exc':U then do:
      551                     find first bf_tax where bf_tax.tax-code = integer('4':U) no-lock no-error.                     if available bf_tax then do:                                                                              assign parname-tax = bf_tax.tax-name.                                                               end.                                                                                                   else assign parname-tax = "Налог '4':U(не задействован)".
      552         end.
      553         otherwise do:
      554            return error "Задан неверный параметр " + pardef-tax + " .".
      555         end.
      556      end case.
      557   end.
      558   end procedure.
      559   define variable vss-include-info5 as character format "X(65)" no-undo
      560   initial "@(#)$Workfile$ $Revision$".
      561   define variable v-fmtcli-name          as character    no-undo.
      562   define variable v-fmtcli-engl-name     as character    no-undo.
      563   define variable v-fmtcli-addres        as character    no-undo.
      564   define variable v-fmtcli-post-addres   as character    no-undo.
      565   define variable v-fmtcli-full-addres   as character    no-undo.
      566   define variable v-fmtcli-phone         as character    no-undo.
      567   define variable v-fmtcli-inn           as character    no-undo.
      568   define variable v-fmtcli-kpp           as character    no-undo.
      569   define variable v-fmtcli-okpo          as character    no-undo.
      570   define variable v-fmtcli-country       as character    no-undo.
      571   define variable v-fmtcli-city          as character    no-undo.
      572   define variable v-fmtcli-index         as character    no-undo.
      573   define variable v-fmtcli-schet-exists  as logical      no-undo.
      574   define variable v-fmtcli-bank-exists   as logical      no-undo.
      575   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      576   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      577   define variable v-fmtcli-bank-bik      as character    no-undo.
      578   define variable v-fmtcli-bank-name     as character    no-undo.
      579   define variable v-fmtcli-bank-addres   as character    no-undo.
      580   define variable v-fmtcli-bank-city     as character    no-undo.
      581   procedure fmtcli-get-bank :
      582   define input parameter p-host-code      as integer          no-undo.
      583   define input parameter p-obj-type       as character        no-undo.
      584   define input parameter p-obj-code       as integer          no-undo.
      585   define input parameter p-curr-code      as integer          no-undo.
      586       define buffer buf_fin-schet     for ub.fin-schet.
      587       define buffer buf_fin-bank      for ub.fin-bank.
      588   do
      589   for buf_fin-schet
      590     , buf_fin-bank
      591   on error undo, return error
      592   :
      593       assign
      594           v-fmtcli-schet-exists       = no
      595           v-fmtcli-bank-exists        = no
      596           v-fmtcli-bank-r-schet       = "":U
      597           v-fmtcli-bank-c-schet       = "":U
      598           v-fmtcli-bank-bik           = "":U
      599           v-fmtcli-bank-name          = "":U
      600           v-fmtcli-bank-addres        = "":U
      601           v-fmtcli-bank-city          = "":U
      602       .
      603       search-for-schet:
      604       for each buf_fin-schet no-lock
      605          where buf_fin-schet.host-code = p-host-code
      606            and buf_fin-schet.cli-type  = p-obj-type
      607            and buf_fin-schet.cli-code  = p-obj-code
      608            and buf_fin-schet.curr-code = p-curr-code
      609       on error undo, return error
      610       :
      611           if buf_fin-schet.status_   = 'удал':U
      612           then do:
      613           end.
      614           else do:
      615               assign
      616                   v-fmtcli-schet-exists   = yes
      617                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      618                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      619               .
      620               find first buf_fin-bank no-lock
      621                    where buf_fin-bank.host-code = p-host-code
      622                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      623               no-error.
      624               if available buf_fin-bank
      625               then do:
      626                   assign
      627                       v-fmtcli-bank-exists      = yes
      628                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      629                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      630                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      631                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      632                   .
      633               end.
      634               else do:
      635                   assign
      636                       v-fmtcli-bank-exists    = no
      637                       v-fmtcli-bank-bik       = "":U
      638                       v-fmtcli-bank-name      = "":U
      639                       v-fmtcli-bank-addres    = "":U
      640                       v-fmtcli-bank-city      = "":U
      641                   .
      642               end.
      643               leave search-for-schet.
      644           end.
      645       end.
      646   end.
      647   end procedure.
      648   procedure fmtcli-get-client :
      649   define input parameter p-obj-type       as character    no-undo.
      650   define input parameter p-obj-code       as integer      no-undo.
      651       define variable v-temp-fmtcli-address      as character     no-undo.
      652       define variable v-num-country-city    as integer      no-undo.
      653       define buffer buf_clients   for ub.clients.
      654       define buffer buf_firm      for ub.firm.
      655       define buffer buf_store     for ub.store.
      656       define buffer buf_shop      for ub.shop.
      657       define buffer buf_person    for ub.person.
      658   do
      659   for buf_clients
      660     , buf_firm
      661     , buf_store
      662     , buf_shop
      663     , buf_person
      664   on error undo, return error
      665   :
      666       assign
      667           v-fmtcli-name           = "":U
      668           v-fmtcli-addres         = "":U
      669           v-fmtcli-post-addres    = "":U
      670           v-fmtcli-full-addres    = "":U
      671           v-fmtcli-phone          = "":U
      672           v-fmtcli-inn            = "":U
      673           v-fmtcli-kpp            = "":U
      674           v-fmtcli-okpo           = "":U
      675           v-fmtcli-city           = "":U
      676           v-fmtcli-index          = "":U
      677           v-fmtcli-country        = "":U
      678       .
      679       find first buf_clients no-lock
      680            where buf_clients.obj-type = p-obj-type
      681              and buf_clients.obj-code = p-obj-code
      682       .
      683       assign
      684           v-fmtcli-name = buf_clients.obj-name
      685       .
      686       case buf_clients.obj-type:
      687          when 'орг':U
      688          then do:
      689               find first buf_firm no-lock
      690                    where buf_firm.firm-code = buf_clients.obj-code
      691                    no-error
      692               .
      693               if available buf_firm
      694               then do:
      695                   assign
      696                       v-num-country-city = num-entries( buf_firm.city )
      697                       v-fmtcli-engl-name = buf_firm.engl-name
      698                   .
      699                   if v-num-country-city > 0
      700                   then do:
      701                       assign
      702                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      703                       .
      704                   end.
      705                   if v-num-country-city > 1
      706                   then do:
      707                       assign
      708                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      709                       .
      710                   end.
      711                   run fmtcli-concatenate-strings in this-procedure (
      712                         input v-fmtcli-full-addres
      713                       , input v-fmtcli-country
      714                       , input ", ":U
      715                       , input 50
      716                       , output v-fmtcli-full-addres
      717                   ).
      718                   run fmtcli-concatenate-strings in this-procedure (
      719                         input v-fmtcli-full-addres
      720                       , input v-fmtcli-city
      721                       , input ", ":U
      722                       , input 50
      723                       , output v-fmtcli-full-addres
      724                   ).
      725                   run fmtcli-concatenate-strings in this-procedure (
      726                         input v-fmtcli-full-addres
      727                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      728                       , input ", ":U
      729                       , input 50
      730                       , output v-fmtcli-full-addres
      731                   ).
      732                   run fmtcli-concatenate-strings in this-procedure (
      733                         input v-fmtcli-post-addres
      734                       , input v-fmtcli-country
      735                       , input ", ":U
      736                       , input 50
      737                       , output v-fmtcli-post-addres
      738                   ).
      739                   run fmtcli-concatenate-strings in this-procedure (
      740                         input v-fmtcli-post-addres
      741                       , input v-fmtcli-city
      742                       , input ", ":U
      743                       , input 50
      744                       , output v-fmtcli-post-addres
      745                   ).
      746                   run fmtcli-concatenate-strings in this-procedure (
      747                         input v-fmtcli-post-addres
      748                       , input string( buf_firm.ind )
      749                       , input ", ":U
      750                       , input 50
      751                       , output v-fmtcli-post-addres
      752                   ).
      753                   run fmtcli-concatenate-strings in this-procedure (
      754                         input substring( buf_firm.addres1, 1, 50 )
      755                       , input buf_firm.addres2
      756                       , input " ":U
      757                       , input 50
      758                       , output v-temp-fmtcli-address
      759                   ).
      760                   run fmtcli-concatenate-strings in this-procedure (
      761                         input v-temp-fmtcli-address
      762                       , input substring( buf_firm.addres1, 51, 50 )
      763                       , input " ":U
      764                       , input 50
      765                       , output v-temp-fmtcli-address
      766                   ).
      767                   run fmtcli-concatenate-strings in this-procedure (
      768                         input v-temp-fmtcli-address
      769                       , input substring( buf_firm.addres1, 101, 50 )
      770                       , input " ":U
      771                       , input 50
      772                       , output v-temp-fmtcli-address
      773                   ).
      774                   assign
      775                       v-fmtcli-addres = v-temp-fmtcli-address
      776                   .
      777                   if buf_firm.addres1 <> ?
      778                   then do:
      779                       run fmtcli-concatenate-strings in this-procedure (
      780                             input v-fmtcli-full-addres
      781                           , input v-fmtcli-addres
      782                           , input ", ":U
      783                           , input 0
      784                           , output v-fmtcli-full-addres
      785                       ).
      786                   end.
      787                   run fmtcli-concatenate-strings in this-procedure (
      788                         input substring( buf_firm.post-addr1, 1, 50 )
      789                       , input buf_firm.post-addr2
      790                       , input " ":U
      791                       , input 50
      792                       , output v-fmtcli-post-addres
      793                   ).
      794                   run fmtcli-concatenate-strings in this-procedure (
      795                         input v-fmtcli-post-addres
      796                       , input substring( buf_firm.post-addr1, 51, 50 )
      797                       , input " ":U
      798                       , input 50
      799                       , output v-fmtcli-post-addres
      800                   ).
      801                   run fmtcli-concatenate-strings in this-procedure (
      802                         input v-fmtcli-post-addres
      803                       , input substring( buf_firm.post-addr1, 101, 50 )
      804                       , input " ":U
      805                       , input 50
      806                       , output v-fmtcli-post-addres
      807                   ).
      808                   assign
      809                       v-fmtcli-phone         = buf_firm.phone
      810                       v-fmtcli-inn           = buf_firm.inn
      811                       v-fmtcli-kpp           = buf_firm.kpp
      812                       v-fmtcli-okpo          = buf_firm.okpo
      813                       v-fmtcli-index         = string( buf_firm.ind )
      814                   .
      815               end.
      816          end.
      817          when 'маг':U
      818          then do:
      819               find first buf_shop no-lock
      820                    where buf_shop.obj-code = buf_clients.obj-code
      821               .
      822               if available buf_shop
      823               then do:
      824                   run fmtcli-concatenate-strings in this-procedure (
      825                         input buf_shop.addres1
      826                       , input buf_shop.addres2
      827                       , input " ":U
      828                       , input 50
      829                       , output v-fmtcli-addres
      830                   ).
      831                   assign
      832                       v-fmtcli-full-addres = v-fmtcli-addres
      833                       v-fmtcli-post-addres = v-fmtcli-addres
      834                       v-fmtcli-phone       = buf_shop.phone
      835                       v-fmtcli-inn         = "":U
      836                       v-fmtcli-kpp         = "":U
      837                       v-fmtcli-okpo        = "":U
      838                       v-fmtcli-city        = "":U
      839                       v-fmtcli-index       = "":U
      840                   .
      841               end.
      842          end.
      843          when 'скл':U
      844          then do:
      845               find first buf_store no-lock
      846                    where buf_store.obj-code = buf_clients.obj-code
      847               .
      848               if available buf_store
      849               then do:
      850                   run fmtcli-concatenate-strings in this-procedure (
      851                         input buf_store.addres1
      852                       , input buf_store.addres2
      853                       , input " ":U
      854                       , input 50
      855                       , output v-fmtcli-addres
      856                   ).
      857                   assign
      858                       v-fmtcli-full-addres = v-fmtcli-addres
      859                       v-fmtcli-phone       = buf_store.phone
      860                       v-fmtcli-inn         = "":U
      861                       v-fmtcli-kpp         = "":U
      862                       v-fmtcli-okpo        = "":U
      863                       v-fmtcli-city        = "":U
      864                       v-fmtcli-index       = "":U
      865                   .
      866               end.
      867          end.
      868          when 'чел':U
      869          then do:
      870               find first buf_person no-lock
      871                    where buf_person.psn-code = buf_clients.obj-code
      872               .
      873               if available buf_person
      874               then do:
      875                   run fmtcli-concatenate-strings in this-procedure (
      876                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      877                                 then "":U
      878                                 else string( buf_person.ind, "999999")
      879                                 )
      880                       , input buf_person.city
      881                       , input ", ":U
      882                       , input 0
      883                       , output v-fmtcli-full-addres
      884                   ).
      885                   assign
      886                       v-fmtcli-addres = buf_person.address
      887                   .
      888                   run fmtcli-concatenate-strings in this-procedure (
      889                         input v-fmtcli-full-addres
      890                       , input v-fmtcli-addres
      891                       , input ", ":U
      892                       , input 0
      893                       , output v-fmtcli-full-addres
      894                   ).
      895                   assign
      896                       v-fmtcli-phone     = buf_person.phone1
      897                       v-fmtcli-inn       = buf_person.inn
      898                       v-fmtcli-kpp       = buf_person.kpp
      899                       v-fmtcli-okpo      = buf_person.okpo
      900                       v-fmtcli-city      = buf_person.city
      901                       v-fmtcli-index     = string( buf_person.ind )
      902                   .
      903               end.
      904          end.
      905       end case.
      906   end.
      907   end procedure.
      908   procedure fmtcli-concatenate-strings :
      909   define input parameter p-string-1       as character        no-undo.
      910   define input parameter p-string-2       as character        no-undo.
      911   define input parameter p-delimiter      as character        no-undo.
      912   define input parameter p-length         as integer          no-undo.
      913   define output parameter p-out-string    as character        no-undo.
      914   do
      915   on error undo, return error
      916   :
      917       assign
      918           p-out-string = ( if p-string-1 = ?
      919                            then "":U
      920                            else trim( p-string-1 ) )
      921       .
      922       assign
      923           p-out-string = p-out-string
      924                        + ( if p-out-string = "":U
      925                            or length( p-out-string ) = p-length
      926                            or p-string-2 = ?
      927                            or trim( p-string-2 ) = "":U
      928                            then "":U
      929                            else p-delimiter )
      930                        + ( if p-string-2 = ?
      931                            or trim( p-string-2 ) = "":U
      932                            then "":U
      933                            else trim( p-string-2 ) )
      934       .
      935   end.
      936   end procedure.
      937   define variable vss-include-info6 as character format "X(65)" no-undo
      938   initial "@(#)$Workfile$ $Revision$".
      939   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      940   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      941   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
      942   define variable par-type          as character no-undo.
      943   define variable v-value-character as character no-undo .
      944   define variable v-value-date      as date      no-undo .
      945   define variable v-value-decimal   as decimal   no-undo .
      946   define variable v-value-integer   as integer   no-undo .
      947   define variable v-value-logical   as logical   no-undo .
      948   define variable v-torgconf-ext-doc-type as character    no-undo.
      949   define variable v-torgconf-outdate   as logical  init no    no-undo.
      950   define variable v-torgconf-outnum    as logical  init no    no-undo.
      951   define variable v-torgconf-outprim   as logical  init no    no-undo.
      952   define variable v-torgconf-outdisc   as logical  init no    no-undo.
      953   define variable v-torgconf-outsubs   as logical  init no    no-undo.
      954   define variable v-torgconf-outrecv   as logical  init no    no-undo.
      955   define variable v-torgconf-outegrp   as logical  init no    no-undo.
      956   define variable v-torgconf-outt12    as logical  init no    no-undo.
      957   define variable v-torgconf-outappr   as logical  init no    no-undo.
      958   define variable v-torgconf-outrubl   as logical  init no    no-undo.
      959   define variable v-torgconf-outhold   as logical  init no    no-undo.
      960   define variable v-torgconf-outobj    as logical  init no    no-undo.
