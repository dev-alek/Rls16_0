     9528                       .
     9529                       assign
     9530                           v-node-code = gds-prt.upper-code
     9531                       .
     9532                       find first gds-prt no-lock
     9533                            where gds-prt.node-code = v-node-code
     9534                              and gds-prt.root <> yes
     9535                       no-error.
     9536                   end.
