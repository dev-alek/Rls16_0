     5258     define variable v-cntxp-par-type        as   character                no-undo.
     5259     define variable v-cntxp-curr-host-code  like ub.store.host-code       no-undo.
     5260     define variable v-cntxp-obj-type        like ub.clients.obj-type      no-undo.
     5261     define variable v-cntxp-obj-code        like ub.clients.obj-code      no-undo.
     5262     define variable v-cntxp-db-num          as integer   no-undo .
     5263     define variable v-cntxp-userid          as character no-undo .
     5264     define variable v-cntxp-level           as character no-undo .
     5265     define variable v-cntxp-db-num-obj      as integer   no-undo .
     5266     define variable v-cntxp-is-admin        as logical   no-undo .
     5267     define buffer bf-cntxp_store for ub.store.
     5268     define buffer bf-cntxp_shop  for ub.shop.
     5269     define buffer bf-cntxp_sysconf for ub.sysconf.
     5270   define variable vss-include-info27 as character format "X(65)" no-undo
     5271   initial "@(#)$Workfile$ $Revision$".
     5272   define temp-table temp_p-fmt_string-part no-undo
     5273       field str-key       as integer
     5274       field string-part   as character
     5275       index pi is primary unique
     5276           str-key
     5277   .
     5278   define variable v-p-fmt-27-str-key    as integer      no-undo.
     5279   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     5280                                     iInput AS INTEGER).
     5281     def var v-start-print as integer no-undo .
     5282     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     5283     assign
     5284       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     5285     .
     5286     RETURN v-start-print .
     5287   END FUNCTION.
     5288   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     5289                                     iInput AS INTEGER).
     5290     def var v-start-print as integer no-undo .
     5291     assign
     5292       v-start-print = INTEGER(iEndPix - 1 - iInput)
     5293     .
     5294     if v-start-print < 0 then return 0.
     5295     RETURN v-start-print .
     5296   END FUNCTION.
     5297   function p-fmt-align-string returns character (
     5298         p-in-string      as character
     5299       , p-page-width     as integer
     5300       , p-align-type     as character
     5301   ).
     5302       define variable v-string-length     as integer      no-undo.
     5303       define variable v-out-string        as character    no-undo.
     5304       assign
     5305           v-string-length = length( trim( p-in-string ) )
     5306       .
     5307       if v-string-length >= p-page-width
     5308       then do:
     5309           assign
     5310               v-out-string = trim( p-in-string )
     5311           .
     5312       end.
     5313       else do:
     5314           case p-align-type
     5315           :
     5316               when 'left':U
     5317               then do:
     5318                   assign
     5319                       v-out-string = trim( p-in-string )
     5320                   .
     5321               end.
     5322               when 'right':U
     5323               then do:
     5324                   assign
     5325                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     5326                   .
     5327               end.
     5328               when 'center':U
     5329               then do:
     5330                   assign
     5331                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     5332                   .
     5333               end.
     5334           end case.
     5335       end.
     5336       return v-out-string .
     5337   end function.
     5338   procedure p-fmt-split-string :
     5339   define input parameter p-source-string  as character        no-undo.
     5340   define input parameter p-split-length   as integer          no-undo.
     5341   define output parameter p-string-1      as character        no-undo.
     5342   define output parameter p-string-2      as character        no-undo.
     5343   do
     5344   on error undo, return error
     5345   :
     5346       define variable v-space-pos    as integer      no-undo.
     5347       if length( p-source-string ) <= p-split-length
     5348       then do:
     5349           assign
     5350               p-string-1 = p-source-string
     5351           .
     5352       end.
     5353       else do:
     5354           assign
     5355               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     5356           .
     5357           if v-space-pos = 0
     5358           then do:
     5359               assign
     5360                   v-space-pos = index( p-source-string, " ":U )
     5361               .
     5362           end.
     5363           if v-space-pos = 0
     5364           then do:
     5365               assign
     5366                   p-string-1 = substring( p-source-string, 1, p-split-length )
     5367                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     5368               .
     5369           end.
     5370           else do:
     5371               assign
     5372                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     5373                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     5374               .
     5375           end.
     5376       end.
     5377   end.
     5378   end procedure.
     5379   procedure p-fmt-round :
     5380   define input parameter p-qnty               as decimal          no-undo.
     5381   define input parameter p-price-no-VAT       as decimal          no-undo.
     5382   define input parameter p-VAT                as decimal          no-undo.
     5383   define input parameter p-SLT                as decimal          no-undo.
     5384   define input parameter p-road-tax           as decimal          no-undo.
     5385   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     5386   define output parameter p-new-VAT           as decimal          no-undo.
     5387   define output parameter p-new-SLT           as decimal          no-undo.
     5388   define output parameter p-new-sum-VAT       as decimal          no-undo.
     5389   define output parameter p-new-sum-SLT       as decimal          no-undo.
     5390   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     5391   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     5392   define output parameter p-new-sum-full      as decimal          no-undo.
     5393       define variable v-vat-pc    as decimal      no-undo.
     5394       define variable v-slt-pc    as decimal      no-undo.
     5395   do
     5396   on error undo, return error
     5397   :
     5398       if p-price-no-VAT = 0
     5399       then do:
     5400           assign
     5401               p-new-price-no-VAT = 0.0
     5402               p-new-VAT          = ?
     5403               p-new-SLT          = ?
     5404               p-new-sum-VAT      = 0.0
     5405               p-new-sum-SLT      = 0.0
     5406               p-new-sum-no-VAT   = 0.0
     5407               p-new-sum-road-tax = 0.0
     5408               p-new-sum-full     = 0.0
     5409           .
     5410       end.
     5411       else do:
     5412           assign
     5413               v-vat-pc            = p-VAT / p-price-no-VAT
     5414               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     5415               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     5416               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     5417               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     5418               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     5419               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     5420               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     5421               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     5422               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     5423           .
     5424       end.
     5425   end.
     5426   end procedure.
     5427   procedure p-fmt-split :
     5428   define input parameter p-in-string      as character        no-undo.
     5429   define input parameter p-split-length   as integer          no-undo.
     5430       define variable v-start-pos     as integer      no-undo.
     5431       define variable v-end-pos       as integer      no-undo.
     5432       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     5433   do
     5434   for buf_temp_p-fmt_string-part
     5435   on error undo, return error
     5436   :
     5437       empty temp-table buf_temp_p-fmt_string-part.
     5438       if p-split-length < 1
     5439       then do:
     5440           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     5441       end.
     5442       assign
     5443           p-in-string                 = trim( p-in-string )
     5444           v-p-fmt-27-str-key   = 0
     5445           v-start-pos                 = 1
     5446           v-end-pos                   = length( p-in-string )
     5447       .
     5448       run p-fmt-get-string-range in this-procedure (
     5449             input p-in-string
     5450           , input p-split-length
     5451           , input v-start-pos
     5452           , output v-start-pos
     5453           , output v-end-pos
     5454       ).
     5455       do while v-end-pos <> 0
     5456       :
     5457           create buf_temp_p-fmt_string-part.
     5458           assign
     5459               v-p-fmt-27-str-key = v-p-fmt-27-str-key + 1
     5460           .
     5461           assign
     5462               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-27-str-key
     5463               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     5464           .
     5465           assign
     5466               v-start-pos = v-end-pos + 1
     5467           .
     5468           run p-fmt-get-string-range in this-procedure (
     5469                 input p-in-string
     5470               , input p-split-length
     5471               , input v-start-pos
     5472               , output v-start-pos
     5473               , output v-end-pos
     5474           ).
     5475       end.
     5476   end.
     5477   end procedure.
     5478   procedure p-fmt-get-string-range :
     5479   define input parameter p-in-string      as character        no-undo.
     5480   define input parameter p-split-length   as integer          no-undo.
     5481   define input parameter p-old-start-pos  as integer          no-undo.
     5482   define output parameter p-start-pos     as integer          no-undo.
     5483   define output parameter p-end-pos       as integer          no-undo.
     5484       define variable v-init-string    as character    no-undo.
     5485       define variable v-temp-char      as character    no-undo.
     5486       define variable v-temp-pos       as integer      no-undo.
     5487       define variable v-counter        as integer      no-undo.
     5488   do
     5489   on error undo, return error
     5490   :
     5491       assign
     5492           p-start-pos   = p-old-start-pos
     5493           v-init-string = substring( p-in-string, p-start-pos )
     5494       no-error.
     5495       if error-status :error
     5496       or trim( v-init-string ) = "":U
     5497       then do:
     5498           assign
     5499               p-end-pos = 0
     5500           .
     5501           undo, return .
     5502       end.
     5503       assign
     5504           v-temp-char   = substring( v-init-string, 1, 1 )
     5505       .
     5506       do
     5507       while trim( v-temp-char ) = "":U
     5508       :
     5509           assign
     5510               p-start-pos     = p-start-pos + 1
     5511               v-init-string   = substring( p-in-string, p-start-pos )
     5512               v-temp-char     = substring( v-init-string, 1, 1 )
     5513           .
     5514       end.
     5515       assign
     5516           v-temp-pos  = p-split-length
     5517           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5518           v-counter   = 0
     5519       .
     5520       search-word-end:
     5521       do
     5522       while trim( v-temp-char ) <> "":U
     5523       :
     5524           assign
     5525               v-counter   = v-counter + 1
     5526           .
     5527           if v-counter > 20
     5528           then do:
     5529               assign
     5530                   v-temp-pos  = p-split-length
     5531               .
     5532               leave search-word-end.
     5533           end.
     5534           assign
     5535               v-temp-pos  = v-temp-pos - 1
     5536               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5537           .
     5538       end.
     5539       assign
     5540           p-end-pos = p-start-pos + v-temp-pos - 1
     5541       .
     5542   end.
     5543   end procedure.
     5544   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5545   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5546   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5547   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5548   procedure factord :
     5549     define input  parameter p-fact-date            as date    no-undo .
     5550     define input  parameter p-fact-time            as integer no-undo .
     5551     define input  parameter p-fact-num             as integer no-undo .
     5552     define input  parameter p-shift-date           as date    no-undo .
     5553     define input  parameter p-shift-num            as integer no-undo .
     5554     define input  parameter p-shift-on             as logical no-undo .
     5555     define output parameter p-fact-order           as decimal no-undo .
     5556     define output parameter p-shift-end-fact-order as decimal no-undo .
     5557     define output parameter p-day-end-fact-order   as decimal no-undo .
     5558     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     5559     if p-fact-date = ?
     5560     then do:
     5561       return error "Не указана фактическая дата" .
     5562     end.
     5563     define variable v-fact-date-num as integer no-undo .
     5564     assign
     5565       v-fact-date-num = integer(p-fact-date)
     5566     .
     5567     if p-fact-num = ?
     5568     or p-fact-num = 0
     5569     then do:
     5570       return error "Не задан p-fact-num " + string(p-fact-num) .
     5571     end.
     5572     if p-fact-num < 0
     5573     then do:
     5574       return error "Отрицательный fact-num " + string(p-fact-num) .
     5575     end.
     5576     if p-fact-num >= 100000000
     5577     then do:
     5578       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     5579     end.
     5580     if p-shift-on = true
     5581     then do:
     5582       if p-shift-date = ?
     5583       then do:
     5584         return error "Не задана дата смены" .
     5585       end.
     5586       if p-shift-num = ?
     5587       or p-shift-num = 0
     5588       then do:
     5589         return error "Не задан номер смены" .
     5590       end.
     5591     end.
     5592     else do:
     5593       assign
     5594         p-shift-date = p-fact-date
     5595         p-shift-num  = 24
     5596       .
     5597     end.
     5598     define variable v-shift-offset as integer no-undo .
     5599     if p-shift-date = p-fact-date
     5600     then do:
     5601       assign
     5602         v-shift-offset = 1
     5603       .
     5604     end.
     5605     if p-shift-date < p-fact-date
     5606     then do:
     5607       assign
     5608         v-shift-offset = 0
     5609       .
     5610     end.
     5611     if p-shift-date > p-fact-date
     5612     then do:
     5613       message
     5614         vss-workfile vss-revision vss-description skip
     5615         "Неправильная дата закрытия смены" skip
     5616         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     5617         view-as alert-box error .
     5618       undo, return error
     5619         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     5620           ,string(p-fact-date, '99/99/9999':U)
     5621           ,string(p-shift-date, '99/99/9999':U)
     5622           )
     5623       .
     5624     end.
     5625     if p-shift-num < 1
     5626     or p-shift-num > 24
     5627     then do:
     5628       message
     5629         vss-workfile vss-revision vss-description skip
     5630         "Неправильный номер смены" skip
     5631         "p-shift-num" p-shift-num skip
     5632         view-as alert-box error .
     5633       undo, return error return-value .
     5634     end.
     5635     assign
     5636       p-fact-order           = v-fact-date-num
     5637                              + v-shift-offset * 0.5
     5638                              + p-shift-num    * 0.02 - 0.01
     5639                              + p-fact-num     * 0.0000000001
     5640       p-shift-end-fact-order = v-fact-date-num
     5641                              + v-shift-offset * 0.5
     5642                              + p-shift-num    * 0.02
     5643       p-day-end-fact-order   = v-fact-date-num
     5644                              + 0.99
     5645     .
     5646     if p-fact-order           <= v-fact-date-num
     5647     or p-shift-end-fact-order <= v-fact-date-num
     5648     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     5649     or p-shift-end-fact-order >= p-day-end-fact-order
     5650     then do:
     5651       message
     5652         vss-workfile vss-revision vss-description skip
     5653         "Внутренняя ошибка при генерации фактического номера" skip
     5654         "p-fact-date"            p-fact-date            skip
     5655         "p-fact-time"            p-fact-time            skip
     5656         "p-fact-num"             p-fact-num             skip
     5657         "p-shift-date"           p-shift-date           skip
     5658         "p-shift-num"            p-shift-num            skip
     5659         "p-shift-on"             p-shift-on             skip
     5660         "p-shift-end-fact-order" p-shift-end-fact-order skip
     5661         "p-day-end-fact-order"   p-day-end-fact-order   skip
     5662         "v-fact-date-num"        v-fact-date-num        skip
     5663         view-as alert-box error .
     5664       undo, return error return-value .
     5665     end.
     5666   end procedure.
     5667   procedure day-begin-fact-order :
     5668     define input  parameter p-fact-date            as date    no-undo .
     5669     define output parameter p-day-begin-fact-order as decimal no-undo .
     5670     do
     5671     on error undo, return error return-value
     5672     :
     5673       if p-fact-date = ?
     5674       then do:
     5675         assign
     5676           p-day-begin-fact-order = 0
     5677         .
     5678       end.
     5679       else do:
     5680         assign
     5681           p-day-begin-fact-order = integer(p-fact-date)
     5682         .
     5683       end.
     5684     end.
     5685   end procedure.
     5686   procedure factord-max-fact-order :
     5687     define output parameter p-max-fact-order as decimal   no-undo .
     5688     do
     5689     on error undo, return error return-value
     5690     :
     5691       run day-begin-fact-order in this-procedure
     5692         (input  date(1, 1, 5000)
     5693         ,output p-max-fact-order
     5694         ) .
     5695     end.
     5696   end procedure.
     5697   procedure factord-cut-archive :
     5698     define input  parameter p-obj-type             as character no-undo .
     5699     define input  parameter p-obj-code             as integer   no-undo .
     5700     define input  parameter p-fact-date            as date      no-undo .
     5701     define output parameter p-shift-on             as logical   no-undo .
     5702     define output parameter p-shift-date           as date      no-undo .
     5703     define output parameter p-shift-num            as integer   no-undo .
     5704     define output parameter p-day-end-fact-order   as decimal   no-undo .
     5705     define output parameter p-shift-end-fact-order as decimal   no-undo .
     5706     define variable v-fact-order as decimal   no-undo .
     5707     define buffer buf_shift-obj for ub.shift-obj .
     5708     do
     5709     on error undo, return error return-value
     5710     :
     5711   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5712   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5713     (input  p-obj-type
     5714     ,input  p-obj-code
     5715     ,input  'shift-on=request'
     5716     ,output p-shift-on
     5717     ) no-error .
     5718       if error-status :error
     5719       then do:
     5720         message
     5721           vss-workfile vss-revision vss-description skip
     5722           "Ошибка при определении атрибута объекта" skip
     5723           "Объект" p-obj-type p-obj-code skip
     5724           error-status :get-message(1) skip
     5725           return-value skip
     5726           view-as alert-box error .
     5727         undo, return error return-value .
     5728       end.
     5729       if p-shift-on = false
     5730       then do:
     5731         assign
     5732           p-shift-date               = ?
     5733           p-shift-num                = 0
     5734         .
     5735       end.
     5736       else do:
     5737         find first buf_shift-obj share-lock
     5738           where buf_shift-obj.obj-type   = p-obj-type
     5739             and buf_shift-obj.obj-code   = p-obj-code
     5740             and buf_shift-obj.shift-date > p-fact-date
     5741           use-index pi
     5742           no-error .
     5743         if not available buf_shift-obj
     5744         or buf_shift-obj.status_ <> 'зкр':U
     5745         then do:
     5746           message
     5747             vss-workfile vss-revision vss-description skip
     5748             "Невозможно вычислить последнюю смену" skip
     5749             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     5750             "Объект" p-obj-type p-obj-code skip
     5751             "Дата" p-fact-date skip
     5752             view-as alert-box error .
     5753           undo, return error return-value .
     5754         end.
     5755         find last buf_shift-obj share-lock
     5756           where buf_shift-obj.obj-type = p-obj-type
     5757             and buf_shift-obj.obj-code = p-obj-code
     5758             and buf_shift-obj.shift-date <= p-fact-date
     5759           use-index pi
     5760           no-error .
     5761         if available buf_shift-obj
     5762         then do:
     5763           if  buf_shift-obj.status_ = 'зкр':U
     5764           then do:
     5765             assign
     5766               p-shift-date = buf_shift-obj.shift-date
     5767               p-shift-num  = buf_shift-obj.shift-num
     5768             .
     5769           end.
     5770           else do:
     5771             message
     5772               vss-workfile vss-revision vss-description skip
     5773               "Невозможно вычислить последнюю смену" skip
     5774               "Статус смены отличен от статуса" 'зкр':U skip
     5775               "Объект" p-obj-type p-obj-code skip
     5776               "Дата" p-fact-date skip
     5777               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     5778               view-as alert-box error .
     5779             undo, return error return-value .
     5780           end.
     5781         end.
     5782         else do:
     5783           assign
     5784             p-shift-date = p-fact-date - 1
     5785             p-shift-num  = 1
     5786           .
     5787         end.
     5788       end.
     5789       run factord in this-procedure
     5790         (input  p-fact-date
     5791         ,input  1
     5792         ,input  1
     5793         ,input  p-shift-date
     5794         ,input  p-shift-num
     5795         ,input  p-shift-on
     5796         ,output v-fact-order
     5797         ,output p-shift-end-fact-order
     5798         ,output p-day-end-fact-order
     5799         ) no-error .
     5800       if error-status :error
     5801       then do:
     5802         message
     5803           vss-workfile vss-revision vss-description skip
     5804           "Ошибка при вызове процедуры factord"
     5805           error-status :get-message(1) skip
     5806           return-value skip
     5807           view-as alert-box error .
     5808         undo, return error return-value .
     5809       end.
     5810     end.
     5811   end procedure.
     5812   procedure factord-lock-shift :
     5813     define input  parameter p-obj-type  as character no-undo .
     5814     define input  parameter p-obj-code  as integer   no-undo .
     5815     define input  parameter p-fact-date as date      no-undo .
     5816     define parameter buffer buf_shift-obj for ub.shift-obj .
     5817     define variable v-shift-on      as logical   no-undo .
     5818     define variable v-extra-message as character no-undo .
     5819     define variable v-error as character no-undo .
     5820     do
     5821     on error undo, return error return-value
     5822     :
     5823   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5824   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5825     (input  p-obj-type
     5826     ,input  p-obj-code
     5827     ,input  'shift-on=request'
     5828     ,output v-shift-on
     5829     ) no-error .
     5830       if error-status :error
     5831       then do:
     5832         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     5833         undo, return error v-error .
     5834       end.
     5835       if v-shift-on = true
     5836       then do:
     5837         find first buf_shift-obj share-lock
     5838           where buf_shift-obj.obj-type   = p-obj-type
     5839             and buf_shift-obj.obj-code   = p-obj-code
     5840             and buf_shift-obj.shift-date > p-fact-date
     5841           use-index pi
     5842           no-error .
     5843         if not available buf_shift-obj
     5844         or buf_shift-obj.status_ <> 'зкр':U
     5845         then do:
     5846           find last buf_shift-obj
     5847             where buf_shift-obj.obj-type = p-obj-type
     5848               and buf_shift-obj.obj-code = p-obj-code
     5849               and buf_shift-obj.status_  = 'зкр':U
     5850             use-index stts
     5851             no-error .
     5852           if available buf_shift-obj
     5853           then do:
     5854             assign
     5855               v-extra-message =
     5856                     substitute("Дата начала последеней закрытой смены на объекте &1"
     5857                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     5858                               )
     5859             .
     5860           end.
     5861           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     5862           undo, return error v-error .
     5863         end.
     5864       end.
     5865     end.
     5866   end procedure.
     5867   procedure factord-end-day :
     5868     define input  parameter p-fact-date            as date    no-undo .
     5869     define output parameter p-day-end-fact-order   as decimal no-undo .
     5870     do
     5871     on error undo, return error return-value
     5872     :
     5873       if p-fact-date = ?
     5874       then do:
     5875         return error "Не указана фактическая дата" .
     5876       end.
     5877       assign
     5878         p-day-end-fact-order = integer(p-fact-date) + 0.99
     5879       .
     5880     end.
     5881   end procedure.
     5882   procedure factord-to-date :
     5883     define input  parameter p-fact-order as decimal no-undo .
     5884     define output parameter p-fact-date  as date    no-undo .
     5885     define variable v-ref-date  as date      no-undo .
     5886     define variable v-ref-delta as integer   no-undo .
     5887     do
     5888     on error undo, return error return-value
     5889     :
     5890       if p-fact-order = ?
     5891       or p-fact-order = 0
     5892       then do:
     5893         return error "Не указан fact-order" .
     5894       end.
     5895       assign
     5896         v-ref-date  = date(1, 1, 2000)
     5897       .
     5898       assign
     5899         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     5900       .
     5901       assign
     5902         p-fact-date = v-ref-date + v-ref-delta
     5903       .
     5904     end.
     5905   end procedure.
     5906   procedure factord-to-fact-num :
     5907     define input  parameter p-fact-order as decimal no-undo .
     5908     define output parameter p-fact-num   as integer no-undo .
     5909     define variable v-fact-order-trunc as decimal no-undo .
     5910     do
     5911     on error undo, return error return-value
     5912     :
     5913       if p-fact-order = ?
     5914       or p-fact-order = 0
     5915       then do:
     5916         return error "Не указан fact-order" .
     5917       end.
     5918       assign
     5919        v-fact-order-trunc = truncate(p-fact-order, 2)
     5920       .
     5921       assign
     5922         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     5923       .
     5924     end.
     5925   end procedure.
     5926   procedure factord-to-shift-num :
     5927     define input  parameter p-fact-order as decimal no-undo .
     5928     define output parameter p-shift-num   as integer no-undo .
     5929     define variable  p-shift-numd  as decimal   no-undo .
     5930     define variable v-fact-order-trunc as decimal no-undo .
     5931     do
     5932     on error undo, return error return-value
     5933     :
     5934       if p-fact-order = ?
     5935       or p-fact-order = 0
     5936       then do:
     5937         return error "Не указан fact-order" .
     5938       end.
     5939       assign
     5940        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     5941       .
     5942       if v-fact-order-trunc < 0.5 then do:
     5943         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     5944       end.
     5945       assign
     5946         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     5947         .
     5948        assign
     5949         p-shift-num = truncate (p-shift-numd , 0)
     5950       .
     5951     end.
     5952   end procedure.
     5953   procedure fact-order-mpl :
     5954     do
     5955     on error undo, return error return-value
     5956     :
     5957   define input  parameter p-doc-date as date     no-undo .
     5958   define input  parameter p-obj-type as character no-undo .
     5959   define input  parameter p-obj-code as integer   no-undo .
     5960   define output parameter p-fact-order as decimal   no-undo .
     5961   define variable v-fact-date            as date    no-undo .
     5962   define variable v-fact-time            as integer no-undo .
     5963   define variable v-fact-order           as decimal no-undo .
     5964   define variable v-shift-end-fact-order as decimal no-undo .
     5965   define variable v-day-end-fact-order   as decimal no-undo .
     5966   define variable l-shift-on as logical no-undo .
     5967   define variable l-date as date      no-undo .
     5968   define variable l-time as integer   no-undo .
     5969   define variable shift-date as date      no-undo .
     5970   define variable shift-num  as integer   no-undo .
     5971   define variable shift-name as character no-undo .
     5972   define variable max-fact-order as decimal   no-undo .
     5973   define buffer buf_global-state for ub.global-state  .
     5974   find first buf_global-state no-lock no-error .
     5975   if not available buf_global-state then do:
     5976      message
     5977        "Не заданы параметры ценообразования!"
     5978        view-as alert-box error
     5979      .
     5980      return error return-value .
     5981   end.
     5982     run cur-time in this-procedure
     5983     ( output v-fact-date ,
     5984       output v-fact-time  ).
     5985   if p-doc-date = ? then do:
     5986   if buf_global-state.pl-use-sys-date-time  = true then do:
     5987         run factord in this-procedure
     5988           (input  v-fact-date
     5989           ,input  v-fact-time
     5990           ,input  v-fact-time
     5991           ,input  ?
     5992           ,input  ?
     5993           ,input  false
     5994           ,output v-fact-order
     5995           ,output v-shift-end-fact-order
     5996           ,output v-day-end-fact-order
     5997           ) no-error .
     5998         if error-status :error
     5999         or v-fact-order = ?
     6000         or v-fact-order = 0 then do:
     6001           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6002         end.
     6003         p-fact-order = v-fact-order .
     6004   end.
     6005   else do:
     6006   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6007   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6008     (input  p-obj-type
     6009     ,input  p-obj-code
     6010     ,input  'shift-on=request'
     6011     ,output l-shift-on
     6012     ) no-error .
     6013         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6014         if p-doc-date <> ? then do:
     6015         end.
     6016          run gbl/factdate.p
     6017          ( input        p-obj-type  ,
     6018            input        p-obj-code  ,
     6019            input-output v-fact-date ,
     6020            input-output v-fact-time ,
     6021            input-output shift-date      ,
     6022            input-output shift-num       ,
     6023            input-output shift-name      ,
     6024            input        yes
     6025            ) no-error .
     6026         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6027         run factord in this-procedure
     6028           (input  v-fact-date
     6029           ,input  v-fact-time
     6030           ,input  v-fact-time
     6031           ,input  shift-date
     6032           ,input  shift-num
     6033           ,input  l-shift-on
     6034           ,output v-fact-order
     6035           ,output v-shift-end-fact-order
     6036           ,output v-day-end-fact-order
     6037           ) no-error .
     6038         if error-status :error
     6039         or v-fact-order = ?
     6040         or v-fact-order = 0 then do:
     6041           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6042         end.
     6043         p-fact-order = v-fact-order .
     6044   end.
     6045   end.
     6046   else do:
     6047          run gbl/factdate.p
     6048          ( input        p-obj-type  ,
     6049            input        p-obj-code  ,
     6050            input-output v-fact-date ,
     6051            input-output v-fact-time ,
     6052            input-output shift-date      ,
     6053            input-output shift-num       ,
     6054            input-output shift-name      ,
     6055            input        yes
     6056            ) no-error .
     6057         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6058         v-fact-date = p-doc-date .
     6059         run factord in this-procedure
     6060           (input  v-fact-date
     6061           ,input  v-fact-time
     6062           ,input  v-fact-time
     6063           ,input  shift-date
     6064           ,input  shift-num
     6065           ,input  l-shift-on
     6066           ,output v-fact-order
     6067           ,output v-shift-end-fact-order
     6068           ,output v-day-end-fact-order
     6069           ) no-error .
     6070         if error-status :error
     6071         or v-fact-order = ?
     6072         or v-fact-order = 0 then do:
     6073           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6074         end.
     6075         p-fact-order = v-fact-order .
     6076   end.
     6077     end.
     6078   end procedure.
     6079   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     6080   field sale-qnty as decimal
     6081   field sale-sum  as decimal
     6082   field sale-tnv  as decimal
     6083   field price-sale-base as decimal
     6084   field price-sale-rubl as decimal
     6085   field road-tax-base   as decimal
     6086   field road-tax-rubl   as decimal
     6087   field excise-base as decimal
     6088   field excise-rubl as decimal
     6089   field date-1 as date
     6090   field date-2 as date
