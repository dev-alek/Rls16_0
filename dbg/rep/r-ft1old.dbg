     5191           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
