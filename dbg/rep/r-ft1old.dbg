     8709                   run p-fmt-round in this-procedure (
     8710                         input tqnty
     8711                       , input price-noNDS
     8712                       , input VAT-gds
     8713                       , input SLT-gds
     8714                       , input 0
     8715                       , output price-noNDS
     8716                       , output v-VAT-pc
     8717                       , output v-SLT-pc
     8718                       , output VAT-gds
     8719                       , output SLT-gds
     8720                       , output v-void-decimal
     8721                       , output stoim-noNDS
     8722                       , output stoim
     8723                   ).
     8724                   assign
     8725                       stoim           = stoim - SLT-gds
     8726                       price-withNDS   = stoim / tqnty
     8727                   .
     8728               end.
     8729               else do:
     8730                   assign
     8731                       VAT-gds     = VAT-gds * tqnty
     8732                       SLT-gds     = SLT-gds * tqnty
     8733                       stoim-noNDS = price-noNDS * tqnty
     8734                       stoim       = stoim-noNDS + VAT-gds
     8735                   .
     8736               end.
     8737               run writelog in this-procedure (log-file-name, 3, "Печать не по партиям. Стоимость с НДС ( "
     8738                                                                           + dtm-char( string( stoim ) )
     8739                                                                           + " ). Количество ( "
     8740                                                                           + dtm-char( string( tqnty ) )
     8741                                                                           + " ). Третий налог ( "
     8742                                                                           + dtm-char( string( v-tax ) )
     8743                                                                           + " )"
     8744                                                   ).
     8745               if lookup( "TopAukc":U, p-mode ) = 0 then do:
     8746               run r-f_t1xl-sheet1-write-line-data in this-procedure (
     8747                     input v-doc-line-counter
     8748                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
     8749                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
     8750                   , input unit-str
     8751                   , input "":U
     8752                   , input "":U
     8753                   , input "":U
     8754                   , input string( tqnty )
     8755                   , input string( price-noNDS + VAT-gds )
     8756                   , input string( stoim + SLT-gds )
     8757               ).
     8758               end.
     8759               if hvrdtax (recid(goods))
     8760               then do:
     8761                   run tax-name (  input 'rdt':U
     8762                                , output v-tax-name
     8763                                ).
     8764                   run writelog in this-procedure (log-file-name, 4, "Есть третий налог ( " + dtm-char( v-tax-name )
     8765                                                           + " ) сумма ( " + dtm-char( string( v-tax ) ) + " )"
     8766                                                       ).
     8767                   parts-for-tax:
     8768                   for each buf_tax_parts
     8769                      where buf_tax_parts.obj-type     = doc-line.obj-type
     8770                        and buf_tax_parts.obj-code     = doc-line.obj-code
     8771                        and buf_tax_parts.artic        = goods.artic
     8772                        and buf_tax_parts.prod-type    = goods.prod-type
     8773                        and buf_tax_parts.prod-code    = goods.prod-code
     8774                        and buf_tax_parts.out-code     = doc-line.doc-code
     8775                   break by buf_tax_parts.road-tax-base
     8776                   :
     8777                       if first-of (buf_tax_parts.road-tax-base)
     8778                       then do:
     8779                           assign
     8780                               v-parts-tax-qnty    = 0
     8781                               v-tax               = 0
     8782                               v-tax-parts-price   =  ( if PrintRubl
     8783                                                       then buf_tax_parts.road-tax-rubl
     8784                                                       else buf_tax_parts.road-tax-base )
     8785                           .
     8786                       end.
     8787                       assign
     8788                           v-parts-tax-qnty    = v-parts-tax-qnty + buf_tax_parts.fact-qnty
     8789                           v-tax               = v-tax + ( v-tax-parts-price * buf_tax_parts.fact-qnty )
     8790                       .
     8791                       if not last-of (buf_tax_parts.road-tax-base)
     8792                       then do:
     8793                           next parts-for-tax.
     8794                       end.
     8795                       if p-round = "round":U
     8796                       then do:
     8797                           run p-fmt-round in this-procedure (
     8798                                 input v-parts-tax-qnty
     8799                               , input v-tax-parts-price
     8800                               , input 0
     8801                               , input 0
     8802                               , input 0
     8803                               , output v-tax-parts-price
     8804                               , output v-void-decimal
     8805                               , output v-void-decimal
     8806                               , output v-void-decimal
     8807                               , output v-void-decimal
     8808                               , output v-void-decimal
     8809                               , output v-tax
     8810                               , output v-void-decimal
     8811                           ).
     8812                       end.
     8813                   end.
     8814                   if lookup( "TopAukc":U, p-mode ) = 0 then do:
     8815                   run r-f_t1xl-sheet1-write-line-data in this-procedure (
     8816                         input 0
     8817                       , input v-tax-name
     8818                       , input "":U
     8819                       , input "":U
     8820                       , input "":U
     8821                       , input "":U
     8822                       , input "":U
     8823                       , input string( v-parts-tax-qnty )
     8824                       , input string( v-tax-parts-price )
     8825                       , input string( v-tax )
     8826                   ).
     8827                   end.
     8828                   assign
     8829                       v-tax           = v-tax-price * tqnty
     8830                       price-noNDS     = price-noNDS + v-tax-price
     8831                       stoim-noNDS     = price-noNDS * tqnty
     8832                       stoim           = stoim-noNDS + VAT-gds
     8833                       v-line-counter  = v-line-counter + 1
     8834                   .
     8835                   run writelog in this-procedure (log-file-name, 4,
     8836                                           "Снова вычислили суммы для строки. Сумма с НДС ( "
     8837                                           + dtm-char( string( stoim ) )
     8838                                           + " )"
     8839                                                       ).
     8840               end.
     8841               assign
     8842                   v-line-counter     = v-line-counter + 1
     8843                   v-doc-line-counter = v-doc-line-counter + 1
     8844               .
     8845           end.
     8846       end.
     8847   end.
     8848   end procedure.
     8849   procedure print-line-parts :
     8850   define input parameter p-trn-doc-code           as character        no-undo.
     8851   define input parameter p-price-is-changed       as logical          no-undo.
     8852   define input parameter p-gds-name               as character        no-undo.
     8853   define input-output parameter p-VAT-gds         as decimal          no-undo.
     8854   define input-output parameter p-SLT-gds         as decimal          no-undo.
     8855   define input-output parameter p-price-withNDS   as decimal          no-undo.
     8856   define input-output parameter p-tax             as decimal          no-undo.
     8857   define input-output parameter p-tax-price       as decimal          no-undo.
     8858   define input-output parameter p-tax-sum         as decimal          no-undo.
     8859       define variable v-tax-name          as character    no-undo.
     8860       define variable v-VAT-pc            as decimal      no-undo.
     8861       define variable v-SLT-pc            as decimal      no-undo.
     8862       define variable v-void-decimal      as decimal      no-undo.
     8863       define buffer buf_trn-doc       for trn-doc.
     8864   do
     8865   for buf_trn-doc
     8866   on error undo, return error
     8867   :
     8868       find first buf_trn-doc no-lock
     8869            where buf_trn-doc.doc-code = p-trn-doc-code
     8870       .
     8871       if p-price-is-changed  =  no
     8872       or CostPrice = yes
     8873       then do:
     8874   assign
     8875     price-rubl-with-tax-loc = parts.price-rubl
     8876     price-base-with-tax-loc = parts.price-base
     8877   .
     8878   define variable vss-include-info50 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     8879   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     8880     (output varinvprb
     8881     )  .
     8882     if parts.out-code = 'free-zone':U     or
     8883        parts.out-code = 'out-zone':U   or
     8884        parts.doc-type = 'акт':U then do:
     8885       assign
     8886         in-vatp-have-vat-slt = yes.
     8887     end.
     8888     else do:
     8889       find first in-vatp_doc-attr no-lock
     8890         where in-vatp_doc-attr.doc-code  = parts.out-code
     8891           and in-vatp_doc-attr.attr-code = 'envd':U
     8892         no-error .
     8893       if not available in-vatp_doc-attr then do:
     8894         assign
     8895           in-vatp-have-vat-slt = yes.
     8896       end.
     8897       else do:
     8898            in-vatp-have-vat-slt = no.
     8899       end.
     8900     end.
     8901     assign
     8902      price-cli-with-tax-loc = parts.price-cli
     8903      cli-base-rate          = parts.cli-base-rate.
     8904     ASSIGN   road-tax-base-loc  = (if parts.road-tax-base  = ? then 0 else parts.road-tax-base)
     8905              road-tax-rubl-loc  = (if parts.road-tax-rubl  = ? then 0 else parts.road-tax-rubl).
     8906     ASSIGN  transport-base-loc = (if parts.transport-base = ? then 0 else parts.transport-base)
     8907             transport-rubl-loc = (if parts.transport-rubl = ? then 0 else parts.transport-rubl)
     8908             other-base-loc     = (if parts.other-base     = ? then 0 else parts.other-base)
     8909             other-rubl-loc     = (if parts.other-rubl     = ? then 0 else parts.other-rubl)
     8910             vat-pc-loc         = (if parts.vat-pc         = ? then 0 else parts.vat-pc)
     8911             slt-pc-loc         = (if parts.slt-pc         = ? then 0 else parts.slt-pc).
     8912             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8913       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     8914     assign
     8915       exch-rate-cli-loc = (parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / parts.price-cli .
     8916     assign
     8917       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
     8918       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
     8919       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
     8920       transport-cli-loc  = 0
     8921       other-cli-loc      = 0
     8922     .
     8923   ASSIGN
     8924             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     8925       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     8926   .
     8927           assign
     8928               p-VAT-gds       = ( if PrintRubl then vat-rubl-loc else vat-base-loc )
     8929               p-SLT-gds       = ( if PrintRubl then slt-rubl-loc else slt-base-loc )
     8930               p-tax-price     = ( if PrintRubl then road-tax-rubl-loc else road-tax-base-loc )
     8931               p-price-withNDS = ( if PrintRubl
     8932                                 then price-rubl-with-tax-loc - transport-rubl-loc - other-rubl-loc - p-tax-price
     8933                                 else price-base-with-tax-loc - transport-base-loc - other-base-loc - p-tax-price )
     8934               p-tax           = p-tax-price * parts.qnty
     8935               p-tax-sum       = p-tax-sum + p-tax
     8936           .
     8937       end.
     8938       if VAT-gds = ? then VAT-gds = 0.
     8939       if SLT-gds = ? then SLT-gds = 0.
     8940       assign
     8941           tqnty           = parts.fact-qnty
     8942           unit-str        = goods.unit-base
     8943           price-noNDS     = p-price-withNDS - p-VAT-gds - p-SLT-gds
     8944           VAT-gds         = p-VAT-gds * tqnty
     8945           SLT-gds         = p-SLT-gds * tqnty
     8946           stoim-noNDS     = price-noNDS * tqnty
     8947           stoim           = stoim-noNDS + VAT-gds
     8948           price-withNDS   = p-price-withNDS
     8949       .
     8950       run writelog in this-procedure (
     8951             input log-file-name
     8952           , input 5
     8953           , input substitute( "Партия: Кол-во ( &1 ) c НДС ( &2 )"
     8954                               , dtm-char( string( tqnty ) )
     8955                               , dtm-char( string( price-withNDS ) ) )
     8956       ).
     8957       if p-round = "round":U
     8958       then do:
     8959           run p-fmt-round in this-procedure (
     8960                 input tqnty
     8961               , input price-noNDS
     8962               , input VAT-gds     / tqnty
     8963               , input SLT-gds     / tqnty
     8964               , input 0
     8965               , output price-noNDS
     8966               , output v-VAT-pc
     8967               , output v-SLT-pc
     8968               , output VAT-gds
     8969               , output SLT-gds
     8970               , output v-void-decimal
     8971               , output stoim-noNDS
     8972               , output stoim
     8973           ).
     8974           assign
     8975               stoim           = stoim - SLT-gds
     8976           .
     8977       end.
     8978       assign
     8979         v-ext-artic = ""
     8980       .
     8981       find first ub.ext-artic no-lock
     8982             where ub.ext-artic.gds-code = bar-code.gds-code
     8983               and ub.ext-artic.cli-code = v-cli-code
     8984               and ub.ext-artic.cli-type = v-cli-type
     8985               and ub.ext-artic.status_  = 'тек':U no-error.
     8986       if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     8987       if lookup( "TopAukc":U, p-mode ) = 0 then do:
     8988       run r-f_t1xl-sheet1-write-line-data in this-procedure (
     8989             input v-doc-line-counter
     8990           , input substitute( "&1 &2", goods.artic, goods.gds-name )
     8991           , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
     8992           , input unit-str
     8993           , input "":U
     8994           , input "":U
     8995           , input "":U
     8996           , input string( tqnty )
     8997           , input string( price-noNDS )
     8998           , input string( stoim + SLT-gds )
     8999       ).
     9000       end.
     9001       assign
     9002           prt-tqnty =  tqnty
     9003           prt-VAT-gds = VAT-gds
     9004           prt-SLT-gds = SLT-gds
     9005           prt-stoim-noNDS = price-noNDS * prt-tqnty
     9006           prt-stoim = prt-stoim-noNDS + prt-VAT-gds
     9007       .
     9008       if hvrdtax (recid(goods))
     9009       then do:
     9010           run tax-name (  input 'rdt':U
     9011                       , output v-tax-name
     9012                       ).
     9013           run writelog in this-procedure (
     9014                 input log-file-name
     9015               , input 4
     9016               , input substitute( "Есть третий налог ( &1 ) сумма ( &2 )"
     9017                                   , dtm-char( v-tax-name )
     9018                                   , dtm-char( string( p-tax ) ) )
     9019           ).
     9020           if p-round = "round":U
     9021           then do:
     9022               run p-fmt-round in this-procedure (
     9023                     input tqnty
     9024                   , input p-tax-price
     9025                   , input 0
     9026                   , input 0
     9027                   , input 0
     9028                   , output p-tax-price
     9029                   , output v-void-decimal
     9030                   , output v-void-decimal
     9031                   , output v-void-decimal
     9032                   , output v-void-decimal
     9033                   , output v-void-decimal
     9034                   , output p-tax
     9035                   , output v-void-decimal
     9036               ).
     9037           end.
     9038           if lookup( "TopAukc":U, p-mode ) = 0 then do:
     9039           run r-f_t1xl-sheet1-write-line-data in this-procedure (
     9040                 input 0
     9041               , input v-tax-name
     9042               , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
     9043               , input unit-str
     9044               , input "":U
     9045               , input "":U
     9046               , input "":U
     9047               , input string( tqnty )
     9048               , input string( p-tax-price )
     9049               , input string( p-tax )
     9050           ).
     9051           end.
     9052           assign
     9053               price-withNDS   = p-price-withNDS + p-tax-price
     9054               price-noNDS     = price-withNDS - p-VAT-gds - p-SLT-gds
     9055               prt-stoim-noNDS = price-noNDS * tqnty
     9056               prt-stoim       = prt-stoim-noNDS + VAT-gds
     9057               v-line-counter  = v-line-counter + 1
     9058           .
     9059           run writelog in this-procedure (
     9060                 input log-file-name
     9061               , input 4
     9062               , input substitute( "Еще раз вычислили сумму с НДС ( &1 ) для общего итога"
     9063                                   , dtm-char( string(prt-stoim) ) )
     9064           ).
     9065       end.
     9066   end.
     9067   end procedure.
     9068   procedure print-line-dtl :
     9069   define input parameter p-doc-line-recid                     as recid            no-undo.
     9070   define input-output parameter p-avg-VAT                     as decimal          no-undo.
     9071   define input-output parameter p-avg-prt-price               as decimal          no-undo.
     9072   define input-output parameter p-avg-prt-price-no-tax        as decimal          no-undo.
     9073   define input-output parameter p-avg-prt-sum-with-tax        as decimal          no-undo.
     9074   define input-output parameter p-avg-prt-sum-without-tax     as decimal          no-undo.
     9075   define output parameter p-prt-tqnty                         as decimal          no-undo.
     9076   define output parameter p-prt-VAT-gds                       as decimal          no-undo.
     9077   define output parameter p-prt-SLT-gds                       as decimal          no-undo.
     9078   define output parameter p-prt-stoim-noNDS                   as decimal          no-undo.
     9079   define output parameter p-prt-stoim                         as decimal          no-undo.
     9080       define variable v-avg-prt-sum-without-tax-out   as decimal      no-undo.
     9081       define variable v-avg-prt-sum-with-tax-out      as decimal      no-undo.
     9082       define variable v-avg-VAT-out                   as decimal      no-undo.
     9083       define variable v-VAT-pc                        as decimal      no-undo.
     9084       define variable v-SLT-pc                        as decimal      no-undo.
     9085       define variable v-void-decimal                  as decimal      no-undo.
     9086       define buffer buf_trn-doc       for trn-doc.
     9087       define buffer buf_doc-line      for doc-line.
     9088   do
     9089   for buf_trn-doc
     9090     , buf_doc-line
     9091   on error undo, return error
     9092   :
     9093       find first buf_doc-line no-lock
     9094            where recid( buf_doc-line ) = p-doc-line-recid
     9095       .
     9096       find first buf_trn-doc no-lock
     9097            where buf_trn-doc.doc-code = buf_doc-line.doc-code
     9098       .
     9099       assign
     9100           p-prt-tqnty       = 0.0
     9101           p-prt-VAT-gds     = 0.0
     9102           p-prt-SLT-gds     = 0.0
     9103           p-prt-stoim-noNDS = 0.0
     9104           p-prt-stoim       = 0.0
     9105       .
     9106           for each gds-dtl no-lock
     9107              where gds-dtl.prod-type = buf_doc-line.prod-type
     9108                and gds-dtl.prod-code = buf_doc-line.prod-code
     9109                and gds-dtl.artic     = buf_doc-line.artic
     9110                and gds-dtl.doc-code  = buf_doc-line.doc-code
     9111           :
     9112               find first gds-prt no-lock
     9113                    where gds-prt.node-code = gds-dtl.prt-code
     9114               .
     9115               if CostPrice = yes
     9116               then do:
     9117   assign
     9118     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     9119     price-base-with-tax-loc = buf_doc-line.price-base
     9120   .
     9121   define variable vss-include-info51 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9122   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9123     (output varinvprb
     9124     )  .
     9125      find first in-vatp_doc-attr no-lock
     9126       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     9127         and in-vatp_doc-attr.attr-code = 'envd':U
     9128       no-error .
     9129       if available in-vatp_doc-attr
     9130          then do:
     9131          assign
