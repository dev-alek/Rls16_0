     9401       end.
     9402       assign
     9403         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     9404     end.
     9405   end.
     9406   assign
     9407     varprice-base-cons = varprice-base-cons / varcons-qnty
     9408     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     9409   if varprice-base-cons = ? then do:
     9410     assign
     9411       varprice-base-cons = 0.
     9412   end.
     9413   if varprice-rubl-cons = ? then do:
     9414     assign
     9415       varprice-rubl-cons = 0.
     9416   end.
     9417   assign
     9418       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     9419     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9420     discnt-base-sale            = gds-dtl.discnt-base
     9421     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     9422       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     9423     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9424     discnt-rubl-sale            = gds-dtl.discnt-rubl
     9425     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     9426     .
     9427   if buf_trn-doc.doc-type = 'инв':U then do:
     9428     assign
     9429       varfact-qnty = gds-dtl.doc-qnty.
     9430   end.
     9431   else do:
     9432     assign
     9433       varfact-qnty = gds-dtl.fact-qnty.
     9434   end.
     9435   if varis-cons-parts-have = no then do:
     9436     assign
     9437           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     9438           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     9439   end.
     9440   else do:
     9441     if buf_trn-doc.doc-type = 'инв':U then do:
     9442       assign
     9443               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9444               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9445        .
     9446     end.
     9447     else do:
     9448       assign
     9449               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9450               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9451        .
     9452     end.
     9453   end.
     9454   assign
     9455   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     9456   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     9457                   assign
     9458                       VAT-gds = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
     9459                       SLT-gds = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
     9460                       price-withNDS = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
     9461                   .
     9462               end.
     9463               if VAT-gds = ? then VAT-gds = 0.
     9464               if SLT-gds = ? then SLT-gds = 0.
     9465               assign
     9466                   price-noNDS     = price-withNDS - VAT-gds - SLT-gds
     9467                   prt-tqnty       = gds-dtl.fact-qnty
     9468               .
     9469               if p-round = "round":U
     9470               then do:
     9471                   run p-fmt-round in this-procedure (
     9472                         input prt-tqnty
     9473                       , input price-noNDS
     9474                       , input VAT-gds
     9475                       , input SLT-gds
     9476                       , input 0
     9477                       , output price-noNDS
     9478                       , output v-vat-pc
     9479                       , output v-slt-pc
     9480                       , output prt-VAT-gds
     9481                       , output prt-SLT-gds
     9482                       , output v-void-decimal
     9483                       , output prt-stoim-noNDS
     9484                       , output prt-stoim
     9485                   ).
     9486                   assign
     9487                       prt-stoim       = prt-stoim - prt-SLT-gds
     9488                   .
     9489               end.
     9490               else do:
     9491                   assign
     9492                       prt-VAT-gds     = VAT-gds * prt-tqnty
     9493                       prt-SLT-gds     = SLT-gds * prt-tqnty
     9494                       prt-stoim-noNDS = price-noNDS * prt-tqnty
     9495                       prt-stoim       = prt-stoim-noNDS + prt-VAT-gds
     9496                   .
     9497               end.
     9498               assign
     9499                   p-prt-tqnty       = p-prt-tqnty       + prt-tqnty
     9500                   p-prt-VAT-gds     = p-prt-VAT-gds     + prt-VAT-gds
     9501                   p-prt-SLT-gds     = p-prt-SLT-gds     + prt-SLT-gds
     9502                   p-prt-stoim-noNDS = p-prt-stoim-noNDS + prt-stoim-noNDS
     9503                   p-prt-stoim       = p-prt-stoim       + prt-stoim
     9504               .
     9505               if PrintScale
     9506               then do:
     9507                   find first bar-code no-lock
     9508                        where bar-code.gds-code = goods.gds-code
     9509                          and bar-code.unit-cli = goods.unit-base
     9510                          and bar-code.node-code = gds-dtl.prt-code
     9511                          and bar-code.part-code = ""
     9512                          and bar-code.in-code = ""
     9513                   .
     9514                   assign
     9515                    v-ext-artic = ""
     9516                   .
     9517                   find first ub.ext-artic no-lock
     9518                        where ub.ext-artic.gds-code = bar-code.gds-code
     9519                          and ub.ext-artic.cli-code = v-cli-code
     9520                          and ub.ext-artic.cli-type = v-cli-type
     9521                          and ub.ext-artic.status_  = 'тек':U no-error.
     9522                   if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     9523                   v-prt-name = "".
