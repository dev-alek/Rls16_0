     4382   procedure r-f_t1xl-sheet1-write-line-data :
     4383   define input parameter p-ID             as integer          no-undo.
     4384   define input parameter p-Name           as character        no-undo.
     4385   define input parameter p-art            as character        no-undo.
     4386   define input parameter p-EI             as character        no-undo.
     4387   define input parameter p-pack           as character        no-undo.
     4388   define input parameter p-PlaceAmount    as character        no-undo.
     4389   define input parameter p-Mass           as character        no-undo.
     4390   define input parameter p-qnty           as character        no-undo.
     4391   define input parameter p-price          as character        no-undo.
     4392   define input parameter p-sum            as character        no-undo.
     4393       define buffer buf_temp_sheet1_line-data        for temp_sheet1_line-data.
     4394   do
     4395   for buf_temp_sheet1_line-data
     4396   on error undo, return error
     4397   :
     4398       for each buf_temp_sheet1_line-data
     4399       :
     4400           delete buf_temp_sheet1_line-data.
     4401       end.
     4402       create buf_temp_sheet1_line-data.
     4403       assign
     4404           v-r-f_t1xl-sheet1-cur-data-row         = v-r-f_t1xl-sheet1-cur-data-row + 1
     4405           buf_temp_sheet1_line-data.sheet-name    = "T_1":U
     4406           buf_temp_sheet1_line-data.xl-line-id    = v-r-f_t1xl-sheet1-cur-data-row
     4407           buf_temp_sheet1_line-data.id           = p-id
     4408           buf_temp_sheet1_line-data.Name         = p-Name
     4409           buf_temp_sheet1_line-data.art          = p-art
     4410           buf_temp_sheet1_line-data.EI           = p-EI
     4411           buf_temp_sheet1_line-data.pack         = p-pack
     4412           buf_temp_sheet1_line-data.PlaceAmount  = p-PlaceAmount
     4413           buf_temp_sheet1_line-data.Mass         = p-Mass
     4414           buf_temp_sheet1_line-data.qnty         = p-qnty
     4415           buf_temp_sheet1_line-data.price        = p-price
     4416           buf_temp_sheet1_line-data.sum          = p-sum
     4417       .
     4418       put stream excel-line unformatted
     4419                           buf_temp_sheet1_line-data.sheet-name
     4420           chr(9)   "DTA":U
     4421           chr(9)   ( if buf_temp_sheet1_line-data.id = 0 then "":U else string( buf_temp_sheet1_line-data.id ) )
     4422           chr(9)   buf_temp_sheet1_line-data.Name
     4423           chr(9)   buf_temp_sheet1_line-data.art
     4424           chr(9)   buf_temp_sheet1_line-data.EI
     4425           chr(9)   buf_temp_sheet1_line-data.pack
     4426           chr(9)   buf_temp_sheet1_line-data.PlaceAmount
     4427           chr(9)   buf_temp_sheet1_line-data.Mass
     4428           chr(9)   buf_temp_sheet1_line-data.qnty
     4429           chr(9)   buf_temp_sheet1_line-data.price
     4430           chr(9)   buf_temp_sheet1_line-data.sum
     4431           chr(10)
     4432       .
     4433   end.
     4434   end procedure.
     4435   procedure r-f_t1xl-write-cell-data :
     4436   define input parameter p-data-key   as character        no-undo.
     4437   define input parameter p-data-value as character        no-undo.
     4438       define buffer buf_temp_cell-data     for temp_cell-data.
     4439   do
     4440   for buf_temp_cell-data
     4441   on error undo, return error
     4442   :
     4443       find first buf_temp_cell-data
     4444            where buf_temp_cell-data.data-key = p-data-key
     4445       no-error.
     4446       if not available buf_temp_cell-data
     4447       then do:
     4448           create buf_temp_cell-data.
     4449           assign
     4450               buf_temp_cell-data.data-key = p-data-key
     4451           .
     4452       end.
     4453       assign
     4454           buf_temp_cell-data.data-value = p-data-value
     4455       .
     4456       put stream excel-cell unformatted
     4457                           buf_temp_cell-data.data-key
     4458           chr(9)   buf_temp_cell-data.data-value
     4459           chr(10)
     4460       .
     4461   end.
     4462   end procedure.
     4463   procedure r-f_t1xl-run-excel :
     4464   define input parameter p-header-filename    as character        no-undo.
     4465   define input parameter p-data-filename      as character        no-undo.
     4466       define variable v-template-file-name    as character    no-undo.
     4467       define variable v-vb-file-name          as character    no-undo.
     4468       define buffer buf_temp-param for temp-param .
     4469   do
     4470   for buf_temp-param
     4471   on error undo, return error
     4472   :
     4473       create buf_temp-param.
     4474       assign
     4475           v-template-file-name    = search( "exe/T_1.xlt" )
     4476           v-vb-file-name          = search( "exe/t_form.bas")
     4477       .
     4478       if v-template-file-name = ?
     4479       or v-template-file-name = "":U
     4480       then do:
     4481           message
     4482               "Ошибка имени файла шаблона."
     4483           view-as alert-box error.
     4484       end.
     4485       if v-vb-file-name = ?
     4486       or v-vb-file-name = "":U
     4487       then do:
     4488           message
     4489               "Ошибка имени файла кода обработки."
     4490           view-as alert-box error.
     4491       end.
     4492       run paramls-write in this-procedure (
     4493             input "template":U
     4494           , input "template-file-name":U
     4495           , input v-template-file-name
     4496       ).
     4497       run paramls-write in this-procedure (
     4498             input "template":U
     4499           , input "vb-file-name":U
     4500           , input v-vb-file-name
     4501       ).
     4502       run paramls-write in this-procedure (
     4503             input "data":U
     4504           , input "data-header-filename":U
     4505           , input p-header-filename
     4506       ).
     4507       run paramls-write in this-procedure (
     4508             input "data":U
     4509           , input "data-filename":U
     4510           , input p-data-filename
     4511       ).
     4512       run gbl/macroxlt.p (
     4513           input-output table buf_temp-param
     4514       ) no-error.
     4515       if error-status :error
     4516       then do:
     4517           message
     4518                    vss-workfile vss-revision vss-description
     4519               skip(1)
     4520               skip "Ошибка создания файла Excel."
     4521               skip return-value
     4522               skip trim(error-status :get-message(1))
     4523                    trim(error-status :get-message(2))
     4524                    trim(error-status :get-message(3))
     4525           view-as alert-box error.
     4526           undo, return error .
     4527       end.
     4528   end.
     4529   end procedure.
     4530   procedure r-f_t1xl-close :
     4531   do
     4532   on error undo, return error
     4533   :
     4534       output stream excel-line close.
     4535       output stream excel-cell close.
     4536       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4537           export "exe/T_1.xlt":U.
     4538           export "exe/t_form.bas":U.
     4539           export v-r-f_t1xl-cell-file-name.
     4540           export v-r-f_t1xl-data-file-name.
     4541       output close.
     4542   end.
     4543   end procedure.
     4544   define variable vss-include-info19 as character format "X(65)" no-undo
     4545   initial "@(#)$Workfile$ $Revision$".
     4546   define temp-table sj-t12 no-undo
