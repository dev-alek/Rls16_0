     7539         run rep\wp-qnty.p (
     7540               input v-cargo-mass-brutto
     7541             , output v-input-value
     7542         ).
     7543         run r-f_t1xl-write-cell-data in this-procedure (
     7544               input "f_massBruttoSTR":U
     7545             , input (v-input-value)
     7546         ).
     7547         run r-f_t1xl-write-cell-data in this-procedure (
     7548               input "h_massBruttoSTR":U
     7549             , input (v-input-value)
     7550         ).
     7551         v-input-value = "".
     7552       end.
     7553       if lookup( "TopAukc":U, p-mode ) <> 0 then do:
     7554       run r-f_t1xl-write-cell-data in this-procedure (
     7555             input "f_qntyname":U
     7556           ,input "Одно"
     7557       ).
     7558       end.
     7559       else do:
     7560       if v-input-value = "Один" then v-input-value = "Одно".
     7561       run r-f_t1xl-write-cell-data in this-procedure (
     7562            input "f_qntyname":U
     7563           ,input txt-LC
     7564       ).
     7565       end.
     7566       run r-f_t1xl-write-cell-data in this-procedure (
     7567         input "f_exptrans"
     7568       , input (v-exp-trans)
     7569       ).
     7570       run r-f_t1xl-write-cell-data in this-procedure (
     7571             input "it_sum":U
     7572           , input string( (accum total stoim) + (accum total SLT-gds) + v-exp-trans )
     7573       ).
     7574                 if lookup( "TopAukc":U, p-mode ) <> 0 then do:
     7575                     run r-f_t1xl-sheet1-write-line-data in this-procedure (
     7576                           input "1"
     7577                         , input v-cargo-name
     7578                         , input ""
     7579                         , input (if v-cargo-pack = ""  then "паллет" else v-cargo-pack)
     7580                         , input (if v-cargo-pack = ""  then "паллет" else v-cargo-pack)
     7581                         , input v-doc-places
     7582                         , input (if v-cargo-mass-netto <> 0 and v-cargo-mass-netto <> ? then string(v-cargo-mass-netto) else "")
     7583                         , input "1"
     7584                         , input string(accum total stoim-noNDS)
     7585                         , input string(accum total stoim-noNDS)
     7586                     ).
     7587                     run r-f_t1xl-write-cell-data in this-procedure (
     7588                          input "margin":U
     7589                         ,input string( round ( ((accum total VAT-gds) + (accum total SLT-gds)) / (accum total stoim), 4 ) )
     7590                     ).
     7591                end.
     7592       run r-f_t1xl-write-cell-data in this-procedure (
     7593             input "N_warrant_char"
     7594           , input ( p-torgconf-N-warrant)
     7595       ).
     7596       run r-f_t1xl-write-cell-data in this-procedure (
     7597             input "N_ndovwho"
     7598           , input(p-torgconf-ndovwho)
     7599       ).
     7600       if p-torgconf-date-warrant <> ?
     7601       then do:
     7602         run r-f_t1xl-write-cell-data in this-procedure (
     7603             input "Day_warrant"
     7604           , input (DAY(p-torgconf-date-warrant) )
     7605       ).
     7606               run r-f_t1xl-write-cell-data in this-procedure (
     7607             input "Date_warrant"
     7608           , input (substitute("&1&2&3",MonthNameRusGen(MONTH ( p-torgconf-date-warrant )),"  ", YEAR(p-torgconf-date-warrant) ))
     7609       ).
     7610       end.
     7611       if p-torgconf-date-warrant <> ?
     7612       then do:
     7613           assign
     7614              month =  MONTH ( p-torgconf-date-warrant )
     7615              p-torgconf-date-char = substitute( "&1&2&3&4&5&6", DAY(p-torgconf-date-warrant), "  ", MonthNameRusGen(month), " ", YEAR(p-torgconf-date-warrant), " года")
     7616           .
     7617       end.
     7618       if lookup( "TopAukc":U, p-mode ) <> 0 then
     7619       run r-f_t1xl-write-cell-data in this-procedure (
     7620             input "f_lineAmount":U
     7621           , input "Один"
     7622       ).
     7623       else
     7624       run r-f_t1xl-write-cell-data in this-procedure (
     7625             input "f_lineAmount":U
     7626           , input ( txt-LC )
     7627       ).
     7628       assign
     7629           s1 = breakstr( s1, 500, input-output s1, input-output s2)
     7630       .
     7631       run r-f_t1xl-write-cell-data in this-procedure (
     7632             input "f_sumLiteral1":U
     7633           , input s1
     7634       ).
     7635       run r-f_t1xl-write-cell-data in this-procedure (
     7636             input "f_sumLiteral2":U
     7637           , input s2
     7638       ).
     7639       if v-ext-doc-type <> 'ie':U
     7640       then do:
     7641         run r-f_t1xl-write-cell-data in this-procedure (
     7642              input "f_permitterStatus":U
     7643            , input ( if v-torgconf-outsubs = no then v-torgconf-ogr-post else "":U )
     7644         ).
     7645         run r-f_t1xl-write-cell-data in this-procedure (
     7646              input "f_permitterName":U
     7647            , input ( if v-torgconf-outsubs = no  then v-torgconf-ogr-name else "":U )
     7648         ).
     7649         run r-f_t1xl-write-cell-data in this-procedure (
     7650              input "f_buhName":U
     7651            , input ( if v-torgconf-outsubs = no then v-torgconf-main-buh else "":U )
     7652         ).
     7653         run r-f_t1xl-write-cell-data in this-procedure (
     7654             input "accept_position"
     7655           , input ( if v-torgconf-outsubs = no  then p-torgconf-accept-position else "":U )
     7656         ).
     7657         run r-f_t1xl-write-cell-data in this-procedure (
     7658             input "accept_fname"
     7659           , input ( if v-torgconf-outsubs = no  then p-torgconf-accept-fname else "":U )
     7660         ).
     7661         run r-f_t1xl-write-cell-data in this-procedure (
     7662             input "f_post"
     7663           , input ( if v-torgconf-outsubs = no  then p-torgconf-post else "":U )
     7664         ).
     7665         run r-f_t1xl-write-cell-data in this-procedure (
     7666             input "f_post1"
     7667           , input ( if v-torgconf-outsubs = no  then p-torgconf-post else "":U )
     7668         ).
     7669         run r-f_t1xl-write-cell-data in this-procedure (
     7670             input "f_wkr_name"
     7671           , input ( if v-torgconf-outsubs = no  then p-torgconf-wrkr-name else "":U )
     7672         ).
     7673         run r-f_t1xl-write-cell-data in this-procedure (
     7674             input "f_wkr_name1"
     7675           , input ( if v-torgconf-outsubs = no  then p-torgconf-wrkr-name else "":U )
     7676         ).
     7677         end.
     7678       else do:
     7679         run r-f_t1xl-write-cell-data in this-procedure (
     7680             input "loadtplace"
     7681           , input (if v-torgconf-outsubs = no  then p-torgconf-post else "":U )
     7682         ).
     7683         run r-f_t1xl-write-cell-data in this-procedure (
     7684               input "loadtname"
     7685            , input (if v-torgconf-outsubs = no  then p-torgconf-wrkr-name else "":U )
     7686         ).
     7687       end.
     7688       v-loadtplace = p-torgconf-post.
     7689       v-loadtname = p-torgconf-wrkr-name.
     7690       put stream out-stream unformatted
     7691             chr(10)
     7692           + "Печатная форма предназначена только для вывода в Microsoft Excel."
     7693           + chr(10)
     7694       .
     7695       run r-f_t1xl-close in this-procedure .
     7696   if session :set-wait-state( "" ) then.
     7697       output stream out-stream close.
     7698   if g#quest-print = false
     7699   then do:
     7700     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     7701                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     7702                                         OUTPUT g#log ).
     7703   end.
     7704   else do:
     7705     os-command silent
     7706       value( "COPY /b " +
     7707         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     7708         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     7709         string( session:temp-directory) +  "$" + string( g#report-num )
     7710                 ) .
     7711     os-command silent
     7712       value( "COPY /b " +
     7713         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     7714         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     7715         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     7716                 ) .
     7717   end.
     7718   end.
     7719   procedure print-line :
     7720   define input parameter p-trn-doc-code   as character        no-undo.
     7721   define input parameter p-sort-type      as character        no-undo.
     7722   define variable v-price-is-changed      as logical  no-undo.
     7723   define variable v-sum-prt-qnty                  as decimal      no-undo.
     7724   define variable v-avg-prt-price                 as decimal      no-undo.
     7725   define variable v-avg-prt-price-no-tax          as decimal      no-undo.
     7726   define variable v-sum-SLT                       as decimal      no-undo.
     7727   define variable v-sum-VAT                       as decimal      no-undo.
     7728   define variable v-avg-VAT                       as decimal      no-undo.
     7729   define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
     7730   define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
     7731   define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
     7732   define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
     7733   define variable v-gds-name-length               as integer      no-undo.
     7734   define variable v-gds-name                      as character    no-undo.
     7735   define variable v-void-decimal                  as decimal      no-undo.
     7736   define variable v-price-no-VAT                  as decimal      no-undo.
     7737   define variable v-VAT-pc                        as decimal      no-undo.
     7738   define variable v-SLT-pc                        as decimal      no-undo.
     7739       define buffer buf_trn-doc       for trn-doc.
     7740       define buffer buf_tax_parts         for parts.
     7741       define buffer buf_temp_gds-name for temp_gds-name.
     7742   do
     7743   for buf_trn-doc
     7744     , buf_tax_parts
     7745     , buf_temp_gds-name
     7746   on error undo, return error
     7747   :
     7748       run writelog in this-procedure (log-file-name, 1, "Печать строки товара").
     7749       find first buf_trn-doc no-lock
     7750            where buf_trn-doc.doc-code = p-trn-doc-code
     7751       .
     7752       empty temp-table buf_temp_gds-name.
     7753       assign
     7754           v-torg-12-gds-name-key  = 0
     7755           v-gds-name              = goods.gds-name
     7756       .
     7757       if FullGdsName
     7758       and v-gds-name <> "":U
     7759       then do:
     7760           do
     7761           while v-gds-name <> "":U
     7762           :
     7763               assign
     7764                   v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     7765               .
     7766               create buf_temp_gds-name.
     7767               assign
     7768                   buf_temp_gds-name.gdn-key = v-torg-12-gds-name-key
     7769               .
     7770               run p-fmt-split-string in this-procedure (
     7771                     input v-gds-name
     7772                   , input v-torg-12-gds-name-length
     7773                   , output buf_temp_gds-name.gdnString
     7774                   , output v-gds-name
     7775               ).
     7776           end.
     7777           find first buf_temp_gds-name
     7778                where buf_temp_gds-name.gdn-key = 1
     7779           no-error.
     7780           if available buf_temp_gds-name
     7781           then do:
     7782           assign
     7783                   v-gds-name    = buf_temp_gds-name.gdnString
     7784           .
     7785       end.
     7786       else do:
     7787           assign
     7788                   v-gds-name    = goods.gds-name
     7789           .
     7790       end.
     7791       end.
     7792       else do:
     7793           assign
     7794               v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     7795           .
     7796           create buf_temp_gds-name.
     7797           assign
     7798               buf_temp_gds-name.gdn-key   = v-torg-12-gds-name-key
     7799               buf_temp_gds-name.gdnString = v-gds-name
     7800           .
     7801       end.
     7802       run writelog in this-procedure (
     7803           log-file-name,
     7804           2,
     7805           substitute( "Определили наименование товара ( &1 )", v-gds-name )
     7806                                           ).
     7807       find first gds-prt no-lock
     7808            where gds-prt.upper-code = goods.prt-root
     7809       .
     7810       assign
     7811           v-rootnode-code = gds-prt.node-code
     7812       .
     7813       if ( ( gds-prt.node-name <> '_Пустая шкала':U )
     7814           and v-cntxp-doc-prt = yes )
     7815       and ( not Invers )
     7816       then do:
     7817           run writelog in this-procedure (log-file-name, 2, "Не пустая шкала, не отключена печать по шкалам и накладная не от имени поставщика").
     7818           find first gds-dtl no-lock
     7819               where gds-dtl.prod-type = doc-line.prod-type
     7820                 and gds-dtl.prod-code = doc-line.prod-code
     7821                 and gds-dtl.artic     = doc-line.artic
     7822                 and gds-dtl.doc-code  = doc-line.doc-code
     7823           no-error.
     7824           if not available (gds-dtl)
     7825           then assign
     7826               price-noNDS   = 0
     7827               price-withNDS = 0
     7828           .
     7829           if PrintScale
     7830           then do:
     7831               if lookup( "TopAukc":U, p-mode ) = 0 then do:
     7832               run r-f_t1xl-sheet1-write-line-data in this-procedure (
     7833                     input v-doc-line-counter
     7834                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
     7835                   , input "":U
     7836                   , input "":U
     7837                   , input "":U
     7838                   , input "":U
     7839                   , input "":U
     7840                   , input "":U
     7841                   , input "":U
     7842                   , input "":U
     7843               ).
     7844               end.
     7845               assign
     7846                   v-line-counter = v-line-counter + 1
     7847                   v-doc-line-counter = v-doc-line-counter + 1
     7848               .
     7849           end.
     7850           for each gds-dtl no-lock
     7851              where gds-dtl.prod-type  = doc-line.prod-type
     7852                and gds-dtl.prod-code  = doc-line.prod-code
     7853                and gds-dtl.artic      = doc-line.artic
     7854                and gds-dtl.doc-code   = doc-line.doc-code
     7855           :
     7856               find first gds-prt no-lock
     7857                       where gds-prt.node-code = gds-dtl.prt-code
     7858               .
     7859   if buf_trn-doc.ext-doc-type = 'ot':U or
     7860      buf_trn-doc.ext-doc-type = ?                 then do:
     7861     assign
     7862      out-vatp-have-vat-slt = yes.
     7863   end.
     7864   else do:
     7865     find first out-vatp_doc-attr no-lock
     7866       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     7867         and out-vatp_doc-attr.attr-code = 'envd':U
     7868         no-error .
     7869     if not available out-vatp_doc-attr then do:
     7870       assign
     7871         out-vatp-have-vat-slt = yes.
     7872     end.
     7873     else do:
     7874        out-vatp-have-vat-slt = no.
     7875     end.
     7876   end.
     7877   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     7878                                      out-vatp_goods.prod-type = doc-line.prod-type and
     7879                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     7880   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7881   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7882     (input  doc-line.artic
     7883     ,input  doc-line.prod-type
     7884     ,input  doc-line.prod-code
     7885     ,output varroot-node
     7886     ) no-error .
     7887   if error-status :error then do:
     7888     message
     7889       vss-workfile vss-revision vss-description skip
     7890       "Ошибка при определении корневого признака товара" skip
     7891       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     7892       error-status :get-message(1) skip
     7893       return-value skip
     7894       view-as alert-box error .
     7895     undo, return error .
     7896   end.
     7897   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     7898     (input  varroot-node
     7899     ,input  'empty-scale=request'
     7900     ,output varempty-scale
     7901     ) no-error .
     7902   if error-status :error then do:
     7903     message
     7904       vss-workfile vss-revision vss-description skip
     7905       "Ошибка при определении атрибута признака" skip
     7906       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     7907       "Признак" varroot-node skip
     7908       "Запрашивался атрибут" "empty-scale=request" skip
     7909       error-status :get-message(1) skip
     7910       return-value skip
     7911       view-as alert-box error .
     7912     undo, return error .
     7913   end.
     7914   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7915   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7916     (output varoutvprb
     7917     )  .
     7918   if varoutvprb = "base":u then do:
     7919     assign
     7920           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     7921       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     7922     .
     7923   end.
     7924   else do:
     7925     assign
     7926           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     7927       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     7928     .
     7929   end.
     7930   if varoutvprb = "rubl":u then do:
     7931     assign
     7932           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     7933       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     7934   end.
     7935   else do:
     7936     assign
     7937           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     7938       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     7939   end.
     7940   assign
     7941     varis-cons-parts-have =  no.
     7942   assign
     7943     varfact-qnty       = 0
     7944     varcons-qnty       = 0
     7945     varprice-base-cons = 0
     7946     varprice-rubl-cons = 0.
     7947   find first out-vatp_doc-line where
     7948              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     7949          and out-vatp_doc-line.artic      = doc-line.artic
     7950          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     7951          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     7952   if available out-vatp_doc-line           and
     7953     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     7954     assign
     7955       varfact-qnty = out-vatp_doc-line.fact-qnty.
     7956   end.
     7957   else do:
     7958     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     7959                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     7960                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     7961                                  and out-vatp_parts.artic      = doc-line.artic
     7962                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     7963                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     7964       if out-vatp_parts.purch-code = 2 then do:
     7965   assign
     7966     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     7967     price-base-with-tax-loco = out-vatp_parts.price-base
     7968   .
     7969   define variable vss-include-info45 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7970   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7971     (output varinvprbo
     7972     )  .
     7973     if out-vatp_parts.out-code = 'free-zone':U     or
     7974        out-vatp_parts.out-code = 'out-zone':U   or
     7975        out-vatp_parts.doc-type = 'акт':U then do:
     7976       assign
     7977         in-vatp-have-vat-slto = yes.
     7978     end.
     7979     else do:
     7980       find first in-vatp_doc-attro no-lock
     7981         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     7982           and in-vatp_doc-attro.attr-code = 'envd':U
     7983         no-error .
     7984       if not available in-vatp_doc-attro then do:
     7985         assign
     7986           in-vatp-have-vat-slto = yes.
     7987       end.
     7988       else do:
     7989            in-vatp-have-vat-slto = no.
     7990       end.
     7991     end.
     7992     assign
     7993      price-cli-with-tax-loco = out-vatp_parts.price-cli
     7994      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     7995     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     7996              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     7997     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     7998             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     7999             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     8000             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     8001             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     8002             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     8003             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8004       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     8005     assign
     8006       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     8007     assign
     8008       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     8009       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     8010       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     8011       transport-cli-loco  = 0
     8012       other-cli-loco      = 0
     8013     .
     8014   ASSIGN
     8015             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     8016       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     8017   .
     8018         assign
     8019           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     8020           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     8021         assign
     8022           varis-cons-parts-have = yes
     8023           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     8024       end.
     8025       assign
     8026         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     8027     end.
     8028   end.
     8029   assign
     8030     varprice-base-cons = varprice-base-cons / varcons-qnty
     8031     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     8032   if varprice-base-cons = ? then do:
     8033     assign
     8034       varprice-base-cons = 0.
     8035   end.
     8036   if varprice-rubl-cons = ? then do:
     8037     assign
     8038       varprice-rubl-cons = 0.
     8039   end.
     8040   assign
     8041       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8042     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8043     discnt-base-sale            = gds-dtl.discnt-base
     8044     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     8045       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     8046     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8047     discnt-rubl-sale            = gds-dtl.discnt-rubl
     8048     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     8049     .
     8050   if buf_trn-doc.doc-type = 'инв':U then do:
     8051     assign
     8052       varfact-qnty = gds-dtl.doc-qnty.
     8053   end.
     8054   else do:
     8055     assign
     8056       varfact-qnty = gds-dtl.fact-qnty.
     8057   end.
     8058   if varis-cons-parts-have = no then do:
     8059     assign
     8060           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     8061           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     8062   end.
     8063   else do:
     8064     if buf_trn-doc.doc-type = 'инв':U then do:
     8065       assign
     8066               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8067               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8068        .
     8069     end.
     8070     else do:
     8071       assign
     8072               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8073               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     8074        .
     8075     end.
     8076   end.
     8077   assign
     8078   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     8079   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     8080               assign
     8081                   v-sum-prt-qnty  = v-sum-prt-qnty + gds-dtl.fact-qnty
     8082                   VAT-gds         = ( if PrintRubl then vat-rubl-buyer            else vat-base-buyer           )
     8083                   SLT-gds         = ( if PrintRubl then slt-rubl-sale             else slt-base-sale            )
     8084                   price-withNDS   = ( if PrintRubl then price-rubl-with-tax-sale  else price-base-with-tax-sale )
     8085               .
     8086               if VAT-gds = ?       then assign  VAT-gds       = 0.
     8087               if SLT-gds = ?       then assign  SLT-gds       = 0.
     8088               if price-withNDS = ? then assign  price-withNDS = 0.
     8089               assign
     8090                   v-sum-VAT                 = v-sum-VAT                   + VAT-gds * gds-dtl.fact-qnty
     8091                   v-sum-prt-sum-with-tax    = v-sum-prt-sum-with-tax      + ( price-withNDS * gds-dtl.fact-qnty )
     8092                   v-sum-prt-sum-without-tax = v-sum-prt-sum-without-tax   + ( ( price-withNDS - VAT-gds - SLT-gds )
     8093                                                                               * gds-dtl.fact-qnty )
     8094               .
     8095           end.
     8096           assign
     8097               v-avg-VAT                   = ( if v-sum-VAT = ? or v-sum-VAT = 0
     8098                                             then 0
     8099                                             else v-sum-VAT / v-sum-prt-qnty )
     8100               v-avg-prt-price             = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     8101                                             then 0
     8102                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     8103               v-avg-prt-price-no-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     8104                                             then 0
     8105                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     8106               v-avg-prt-sum-with-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     8107                                             then 0
     8108                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     8109               v-avg-prt-sum-without-tax   = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     8110                                             then 0
     8111                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     8112           .
     8113           run print-line-dtl in this-procedure (
     8114                 recid( doc-line )
     8115               , input-output v-avg-VAT
     8116               , input-output v-avg-prt-price
     8117               , input-output v-avg-prt-price-no-tax
     8118               , input-output v-avg-prt-sum-with-tax
     8119               , input-output v-avg-prt-sum-without-tax
     8120               , output prt-tqnty
     8121               , output prt-VAT-gds
     8122               , output prt-SLT-gds
     8123               , output prt-stoim-noNDS
     8124               , output prt-stoim
     8125           ).
     8126           accumulate
     8127               prt-tqnty ( TOTAL )
     8128               prt-VAT-gds ( TOTAL )
     8129               prt-SLT-gds ( TOTAL )
     8130               prt-stoim-noNDS ( TOTAL )
     8131               prt-stoim ( TOTAL )
     8132           .
     8133           assign
     8134               tqnty = ( ACCUM TOTAL prt-tqnty )
     8135               VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
     8136               SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
     8137               stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
     8138               stoim = ( ACCUM TOTAL prt-stoim )
     8139           .
     8140           if not PrintScale
     8141           then do:
     8142               find first bar-code no-lock
     8143                    where bar-code.gds-code = goods.gds-code
     8144                      and bar-code.unit-cli = goods.unit-base
     8145                      and bar-code.node-code = v-rootnode-code
     8146                      and bar-code.part-code = ""
     8147                      and bar-code.in-code = ""
     8148               .
     8149               assign
     8150                 v-ext-artic = ""
     8151               .
     8152               find first ub.ext-artic no-lock
     8153                    where ub.ext-artic.gds-code = bar-code.gds-code
     8154                      and ub.ext-artic.cli-code = v-cli-code
     8155                      and ub.ext-artic.cli-type = v-cli-type
     8156                      and ub.ext-artic.status_  = 'тек':U no-error.
     8157               if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     8158               if lookup( "TopAukc":U, p-mode ) = 0 then do:
     8159               run r-f_t1xl-sheet1-write-line-data in this-procedure (
     8160                     input v-doc-line-counter
     8161                   , input substitute( "&1 &2", goods.artic, goods.gds-name )
     8162                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
     8163                   , input goods.unit-base
     8164                   , input "":U
     8165                   , input "":U
     8166                   , input "":U
     8167                   , input string( tqnty )
     8168                   , input string( stoim / tqnty )
     8169                   , input string( stoim + SLT-gds )
     8170               ).
     8171               end.
     8172               assign
     8173                   v-line-counter     = v-line-counter + 1
     8174                   v-doc-line-counter = v-doc-line-counter + 1
     8175               .
     8176           end.
     8177       end.
     8178       else do:
     8179           run writelog in this-procedure (log-file-name, 2, "Пустая шкала или отключена печать по шкалам или накладная от имени поставщика").
     8180           find first bar-code no-lock
     8181               where bar-code.gds-code = goods.gds-code
     8182               and bar-code.unit-cli   = goods.unit-base
     8183               and bar-code.node-code  = v-rootnode-code
     8184               and bar-code.part-code  = ""
     8185               and bar-code.in-code    = ""
     8186           .
     8187           assign
     8188             v-ext-artic = ""
     8189           .
     8190           find first ub.ext-artic no-lock
     8191                where ub.ext-artic.gds-code = bar-code.gds-code
     8192                  and ub.ext-artic.cli-code = v-cli-code
     8193                  and ub.ext-artic.cli-type = v-cli-type
     8194                  and ub.ext-artic.status_  = 'тек':U no-error.
     8195           if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     8196           if v-ext-doc-type = 'ep':U
     8197           then do:
     8198               run writelog in this-procedure (log-file-name, 3, "Возврат поставщику при печати по партиям "
     8199                                                   ).
     8200               assign
     8201                   v-price-is-changed  =  no
     8202               .
     8203               for each parts
     8204                  where parts.obj-type     = doc-line.obj-type
     8205                    and parts.obj-code     = doc-line.obj-code
     8206                    and parts.artic        = goods.artic
     8207                    and parts.prod-type    = goods.prod-type
     8208                    and parts.prod-code    = goods.prod-code
     8209                    and parts.out-code     = doc-line.doc-code
     8210               :
     8211                   run print-line-parts in this-procedure (
     8212                         input buf_trn-doc.doc-code
     8213                       , input v-price-is-changed
     8214                       , input v-gds-name
     8215                       , input-output v-VAT-gds
     8216                       , input-output v-SLT-gds
     8217                       , input-output v-price-withNDS
     8218                       , input-output v-tax
     8219                       , input-output v-tax-price
     8220                       , input-output v-tax-sum
     8221                   ).
     8222                   accumulate
     8223                       prt-tqnty ( TOTAL )
     8224                       prt-VAT-gds ( TOTAL )
     8225                       prt-SLT-gds ( TOTAL )
     8226                       prt-stoim-noNDS ( TOTAL )
     8227                       prt-stoim ( TOTAL )
     8228                   .
     8229                   assign
     8230                       v-line-counter     = v-line-counter + 1
     8231                       v-doc-line-counter = v-doc-line-counter + 1
     8232                   .
     8233               end.
     8234               assign
     8235                   tqnty = ( ACCUM TOTAL prt-tqnty )
     8236                   VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
     8237                   SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
     8238                   stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
     8239                   stoim = ( ACCUM TOTAL prt-stoim )
     8240               .
