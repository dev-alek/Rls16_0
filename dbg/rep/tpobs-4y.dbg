     2640   define variable bi-overturn         as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2641   define variable bo-prih             as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2642   define variable bo-rash             as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2643   define variable bo-kassa            as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2644   define variable bo-inv              as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2645   define variable bo-overturn         as   decimal extent 20 format "->>>>>>>>>>9.<<<" no-undo.
     2646   define variable gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2647   define variable bo-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2648   define variable bi-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2649   define variable b1-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2650   define variable b2-gds-zap-other         like ub.stk-tot.sum-base no-undo.
     2651   define variable  fact-order-1   like ub.stk-tot.fact-order no-undo.
     2652   define variable  quantity1      like ub.stk-tot.fact-qnty  no-undo.
     2653   define variable  coast_r1       like ub.stk-tot.sum-rubl   no-undo.
     2654   define variable  coast_v1       like ub.stk-tot.sum-rubl   no-undo.
     2655   define variable  vat_r1         like ub.stk-tot.sum-rubl   no-undo.
     2656   define variable  vat_v1         like ub.stk-tot.sum-rubl   no-undo.
     2657   define variable  fact-order-2   like ub.stk-tot.fact-order no-undo.
     2658   define variable  quantity2      like ub.stk-tot.fact-qnty  no-undo.
     2659   define variable  coast2         like ub.stk-tot.sum-rubl   no-undo.
     2660   define variable  coast_r2       like ub.stk-tot.sum-rubl   no-undo.
     2661   define variable  coast_v2       like ub.stk-tot.sum-rubl   no-undo.
     2662   define variable  vat_r2         like ub.stk-tot.sum-rubl   no-undo.
     2663   define variable  vat_v2         like ub.stk-tot.sum-rubl   no-undo.
     2664   define variable  quantity    like ub.stk-tot.fact-qnty  no-undo.
     2665   define variable  coast       like ub.stk-tot.sum-rubl   no-undo.
     2666   define variable  coast_r     like ub.stk-tot.sum-rubl   no-undo.
     2667   define variable  coast_v     like ub.stk-tot.sum-rubl   no-undo.
     2668   define variable  vat_r       like ub.stk-tot.sum-rubl   no-undo.
     2669   define variable  vat_v       like ub.stk-tot.sum-rubl   no-undo.
     2670   define variable  slt_r       like ub.stk-tot.sum-rubl   no-undo.
     2671   define variable  slt_v       like ub.stk-tot.sum-rubl   no-undo.
     2672   define variable  coast3       like ub.stk-tot.sum-rubl   no-undo.
     2673   define variable  coast4       like ub.stk-tot.sum-rubl   no-undo.
     2674   define variable  temp-str as char no-undo.
     2675   define variable xshowcost as logical no-undo .
     2676   define variable xshowsale as logical no-undo .
     2677   define variable xshowcrsa as logical no-undo .
     2678   define variable arh-type-sale as character no-undo .
     2679   define variable arh-type-crsa as character no-undo .
     2680   define variable arh-type-cost as character no-undo .
     2681   define variable arh-type-sadt as character no-undo .
     2682   define variable arh-type-cgdt as character no-undo .
     2683   define variable arh-type-csdt as character no-undo .
     2684   define variable arh-type-allsum  as character no-undo .
     2685   define variable str as char format "x(60)" no-undo.
     2686   define variable i#i as int no-undo.
     2687   define variable xlavel as int  no-undo.
     2688   define variable list-field as char no-undo.
     2689   define variable str10 as char no-undo.
     2690   define frame zapas
     2691           s-bar-code column-label  "Код! ! ":c9 space(0)
     2692           sym1 column-label ":!:!:" format "x(1)"       space(0)
     2693           gds-zap-artic column-label "Артикул! ! ":c16 format "x(16)" space(0)
     2694           sym2 column-label ":!:!:" format "x(1)"                         space(0)
     2695           gds-zap-gds-name column-label "Название товара! ! ":c36 format "x(36)" space(0)
     2696           sym3 column-label ":!:!:" format "x(1)"                                     space(0)
     2697           gds-zap-unit-base column-label "Ед.!изм! " format "x(3)"                  space(0)
     2698           sym4 column-label ":!:!:" format "x(1)"                                     space(0)
     2699           gds-type column-label "Тип!данных! ":c6 format "x(6)"                  space(0)
     2700           sym5 column-label ":!:!:" format "x(1)" space(0)
     2701           f-ostatok-start     column-label "Остаток на!начало! ":c14 format "x(14)"           space(0)
     2702           sym6 column-label ":!:!:" format "x(1)" space(0)
     2703           f-prih       column-label "Приход! ! ":c14     format "x(14)"     space(0)
     2704           sym7 column-label ":!:!:" format "x(1)" space(0)
     2705           f-rash       column-label "Расход! ! ":c14  format "x(14)"   space(0)
     2706           sym8 column-label ":!:!:" format "x(1)" space(0)
     2707           f-kassa             column-label "Касса! ! ":c14  format "x(14)"   space(0)
     2708           sym9  column-label ":!:!:" format "x(1)" space(0)
     2709           f-inv               column-label "Инвентаризация!Смена типа!приобретения":c14  format "x(14)"   space(0)
     2710           sym10 column-label ":!:!:" format "x(1)" space(0)
     2711           f-overturn         column-label "Переоценка!продажной и!учетной цен":c14  format "x(14)"   space(0)
     2712           sym11 column-label ":!:!:" format "x(1)" space(0)
     2713           gds-zap-other      column-label "Скидка! ! ":c13     space(0)
     2714           sym12 column-label ":!:!:" format "x(1)" space(0)
     2715           f-ostatok-end     column-label "Остаток!на конец! ":c14 format "x(14)"           space(0)
     2716       header
     2717           string( "Дата печати : " + string(today,"99.99.9999") +  " , " + string(time, "hh:mm") ) at 5 format "x(35)"
     2718           "Цены указаны в" (if tprintrubl then "руб" else x-base-type )
     2719           string( "Страница " + string( page-number( outstream ), ">>>>>9") ) at 147 format "x(53)" skip
     2720           line format "x(194)" at 1
     2721      with width 232 down stream-io use-text no-box.
     2722        assign
     2723           i = 0
     2724           xlavel        = xvar-lavel
     2725           select-good   = x-selectgood
     2726           paytype       = x-set_pay_type
     2727           retclassify   = xclassify
     2728           retsorttype   = xsorttype
     2729           sums-only     = xsumsonly
     2730           show-negativ  = xshowzero
     2731           show-negativ-2  = xshowzero-2
     2732           xshowcost     = show-cost
     2733           xshowsale     = show-sale
     2734           xshowcrsa     = show-crsa
     2735           firstline     = false
     2736           line          = fill("-", 232)
     2737           valtype       = if (paytype = 1) then 0  else x-set_val_type.
     2738      run report-execute.
     2739   procedure report-execute :
     2740   define variable gj as integer no-undo init 0.
     2741     if (valtype=0 and x-base-code=0)  or valtype=1
     2742                                   then   assign tprintrubl = yes .
     2743                                   else   assign tprintrubl = no .
     2744     if reportpageheight = 0 then reportpageheight  = 43.
     2745   output stream outstream to value( string( session:temp-directory +
     2746                                        "rpt" + string( g#report-num ) ) )
     2747                                        page-size  value(reportpageheight) .
     2748     find first clients where x-store-type = clients.obj-type and
     2749                              x-store-code = clients.obj-code no-lock no-error.
     2750     if available clients then  objname = clients.obj-name.
     2751                                   else  objname="объект не определен".
     2752   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2753   form header
     2754     line format "x(194)" at 1 skip
     2755     "Продолжение - на следующей странице" at 30 skip
     2756     with frame bottomframe width 232 page-bottom no-labels no-box .
     2757   view stream outstream frame bottomframe .
     2758          for each obj-list no-lock:
     2759             x-store-type = obj-list.obj-type.
     2760             x-store-code = obj-list.obj-code.
     2761             x-db-num     = obj-list.db-num.
     2762             gj = gj + 1.
     2763             run report-exec1.
     2764         end.
     2765         if gj > 1 then do:
     2766           hide stream outstream frame bottomframe .
     2767           run display-bo.
     2768           run u-line.
     2769         end.
     2770     hide stream outstream frame bottomframe .
     2771     hide   stream outstream frame zapas .
     2772     output stream outstream close.
     2773   if mFrameView
     2774   then do:
     2775      HIDE FRAME InfoFrame.
     2776   end.
     2777     if Make-Excel then output stream ForExcel close.
     2778     define variable v-user-action as character no-undo .
     2779     define variable v-printed as logical   no-undo .
     2780     define variable DisabledOptions as integer   no-undo .
     2781     define variable v-orient-page as character no-undo .
     2782     run How-name in this-procedure (
     2783         input ReportPageHeight,
     2784         input ReportPageWidth,
     2785         output v-orient-page )
     2786         .
     2787     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2788                                    else DisabledOptions = 0 .
     2789     run gbl/prnfilen.w
     2790       (input  ""
     2791       ,input  DisabledOptions
     2792       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2793       ,input reportfontNum
     2794       ,output v-user-action
     2795       ,output v-printed
     2796       ) .
     2797   end procedure.
     2798   procedure clear-line :
     2799    do on error undo, return error return-value :
     2800    define variable l as integer   no-undo init 1.
     2801    repeat L = 1 to 20 :
     2802       assign
     2803           ostatok-start[L]  = 0
     2804           ostatok-end[L]  = 0
     2805     .
     2806    end.
     2807    end.
     2808   end procedure.
     2809   procedure ost-line :
     2810   do
     2811   on error undo, return error return-value
     2812   :
     2813   define input parameter p-store-type like ub.clients.obj-type no-undo .
     2814   define input parameter p-store-code like ub.clients.obj-code no-undo.
     2815   define input parameter p-gds-code   like goods.gds-code no-undo .
     2816   define input parameter p-db-num as integer   no-undo .
     2817   define variable p-ok as logical   no-undo .
     2818   if  p-tpsy = true then do:
     2819       run ver-owner
     2820       ( input  p-gds-code,
     2821         input  p-db-num  ,
     2822         output p-ok ) .
     2823         if p-ok = true  then
     2824             run ost-line-body(10 , p-store-type , p-store-code) .
     2825         if p-type-tpsy-goods = 2 then
     2826             run ost-line-body(0 , p-store-type , p-store-code) .
     2827   end.
     2828   if  p-tpsy = false  then do:
     2829    run ost-line-body(0 , p-store-type , p-store-code) .
     2830   end.
     2831   end.
     2832   end procedure.
     2833   procedure foreach :
     2834   define variable old-type as character no-undo .
     2835   define variable old-gds-zap-gds-name as character no-undo .
     2836      old-type = x-type-pr.
     2837   IF ( i modulo v-account = 0 )  then DO:
     2838    Assign
     2839       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2840       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2841       .
     2842    Assign
     2843       v-kol-spice = (50 - LENGTH(objname)) / 2
     2844       RecordsString2 = fill(' ',v-kol-spice) + string(objname)
     2845       .
     2846             if  log-manager:logfile-name ne ?
     2847             then DO:
     2848                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2849             end.
     2850              if mFrameView
     2851              then do:
     2852               DISPLAY
     2853                 i @ RecordsDone
     2854                 RecordsString   @ RecordsString
     2855                 RecordsString2  @ RecordsString2
     2856                 WITH FRAME InfoFrame.
     2857              end.
     2858   End.
     2859      if v-button-stop then  DO:
     2860            if mFrameView
     2861            then
     2862               PROCESS EVENTS.
     2863            IF StopProcessing THEN DO:
     2864            RETURN error.
     2865            End.
     2866      end.
     2867     run clear-item.
     2868     run clear-line.
     2869     if x-type-pr = "cb" then do:
     2870       x-type-pr = "b".
     2871       run ost-line (x-store-type , x-store-code  , gds-zap-b-code , x-db-num) .
     2872       x-type-pr = "c".
     2873       run ost-line (x-store-type , x-store-code  , gds-zap-b-code , x-db-num) .
     2874       x-type-pr = old-type .
     2875     end.
     2876     else run ost-line (x-store-type , x-store-code  , gds-zap-b-code , x-db-num) .
     2877      run ob-line (
     2878             input   x-store-code   ,
     2879             input   x-store-type   ,
     2880             input   gds-zap-b-code ,
     2881             input   fact-order-1,
     2882             input   fact-order-2,
     2883             input   x-type-pr     ,
     2884             input   xtog-obj) .
     2885      run calc-sub-itog .
     2886   end procedure.
     2887   procedure display-line :
     2888   if num-entries(gds-zap-gds-name, "|") = 2 then
     2889   assign
     2890     g1 =  entry(1 ,gds-zap-gds-name, "|")
     2891     g2 =  entry(2 ,gds-zap-gds-name, "|")
     2892   .
     2893   assign
     2894     g1 =  gds-zap-gds-name
     2895     g2 =  ""
     2896   .
     2897        i = i + 1.
     2898           if not( not show-negativ-2 and
     2899            ( prih         [1]   = 0 and
     2900             rash          [1]   = 0 and
     2901             kassa         [1]   = 0 and
     2902             inv           [1]   = 0 and
     2903             overturn      [1]   = 0 and
     2904             overturn      [5]   = 0 and
     2905             overturn      [8]   = 0 ) ) then do:
     2906           if  not (not show-negativ  and (
     2907                 prih          [1]   = 0 and
     2908                 rash          [1]   = 0 and
     2909                 kassa         [1]   = 0 and
     2910                 inv           [1]   = 0 and
     2911                 overturn      [1]   = 0 and
     2912                 overturn      [5]   = 0 and
     2913                 ostatok-start [1]   = 0 and
     2914                 ostatok-end   [1]   = 0   )) then do:
     2915           if not sums-only then do:
     2916               if fr0 = true then do:
     2917                 put stream  outstream  tmp#stroka0 format "x(100)" skip.
     2918                 if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     2919                 fr0 = false .
     2920               end.
     2921               if fr = true then do:
     2922                 put stream outstream space(10) temp-str format "x(100)" skip.
     2923                 if Make-Excel then  put   stream ForExcel unformatted CHR(9) string(temp-str) skip.
     2924                 fr = false .
     2925               end.
     2926              run display-str1 in this-procedure.
     2927             end.
     2928           end.
     2929        end.
     2930     end procedure.
     2931   procedure print-header :
     2932   if not firstline then do:
     2933      run display-title.
     2934      form with FRAME ZAPAS .  DOWN stream   OutStream 1 with FRAME ZAPAS .
     2935   end.
     2936    firstline = true .
     2937       if xtog-obj and   x-selectobject <> "currency":u   then  do:
     2938             PUT stream  OutStream  UNFORMATTED     "ПО ОБЪЕКТУ : " + caps(clients.obj-name)  at 30 format "x(170)" skip.
     2939             if Make-Excel then  put   stream ForExcel unformatted   "ПО ОБЪЕКТУ : " + caps(clients.obj-name) format "x(170)" skip.
     2940         end.
     2941         run clear-b1 .
     2942         run clear-b2.
     2943         run clear-bi .
     2944         break_group = true.
     2945         break_group1 = true.
     2946      end procedure.
     2947   procedure print-footer :
     2948         if retclassify = "no-classify":u  then run u-line.
     2949          gds-zap-artic = "ИТОГО" .
     2950          run display-bi.
     2951          run u-line.
     2952          end procedure.
     2953   procedure u-line :
     2954   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2955     s-bar-code
     2956     gds-zap-artic
     2957     gds-zap-gds-name
     2958     gds-zap-unit-base
     2959     gds-type
     2960     f-ostatok-start
     2961     f-prih
     2962     f-rash
     2963     f-kassa
     2964     f-inv
     2965     f-overturn
     2966     f-ostatok-end
     2967     gds-zap-other
     2968     with FRAME ZAPAS .
     2969     DOWN stream   OutStream 1 with FRAME ZAPAS.
     2970   end procedure.
     2971   procedure p-line :
     2972   underline stream outstream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     2973           gds-zap-artic
     2974           gds-zap-gds-name
     2975           gds-zap-unit-base
     2976           gds-type
     2977           f-ostatok-start
     2978           f-prih
     2979           f-rash
     2980           f-kassa
     2981           f-inv
     2982           f-overturn
     2983           f-ostatok-end
     2984           gds-zap-other
     2985           with FRAME ZAPAS .
     2986           DOWN stream   OutStream 1 with FRAME ZAPAS.
     2987   end procedure.
     2988   procedure run4 :
     2989     run run4sort2 .
     2990     end procedure .
     2991   procedure run4sort2 :
     2992         case select-good :
     2993            when 1  then do:
     2994   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2995   IF x-SelectObject = "currency":U  OR  xTog-obj THEN DO :
     2996       for each gds-obj  where
     2997             gds-obj.obj-type = x-store-type  and
     2998             gds-obj.obj-code = x-store-code
     2999             and ( (v-show-all-goods = true ) or   ( gds-obj.last-doc = ? or gds-obj.last-doc >= x-date-start or gds-obj.fact-qnty <> 0 or gds-obj.avrg-qnty <> 0 or gds-obj.fact-sale <> 0 or gds-obj.fact-base <> 0 ) )
     3000         no-lock,
     3001   First clients  where  clients.obj-code = gds-obj.prod-code and
     3002                         clients.obj-type = gds-obj.prod-type
     3003                   no-lock,
     3004             First goods  where  gds-obj.gds-code   = goods.gds-code
     3005   no-lock
     3006   BREAK BY ((substring(clients.obj-name,1,10) + string(gds-obj.prod-code)))
     3007         BY (gds-obj.grp-name)
     3008       BY (goods.gds-code) :
     3009         run item-goods ( "4" , "goods" ) .
     3010         if return-value <> "" then NEXT.
     3011           If Last-of(gds-obj.grp-name) Then Do:
     3012           If String(Entry(2,"gds-obj.grp-name",".")) = "Grp-name"
     3013             Then  Assign
     3014                     S-bar-code   = " Итого по "
     3015                     Gds-zap-artic = Substring(
     3016                                          B2-name
     3017                                         ,1,16)
     3018                     Gds-zap-gds-name = Substring(
     3019                                          B2-name
     3020                                         ,17,40)
     3021                                   .
     3022             Else  Assign
     3023                     S-bar-code   = ""
     3024                     Gds-zap-artic = "        Итого по "
     3025                     Gds-zap-gds-name =   B2-name
     3026                                   .
     3027               Run Display-b1 In This-procedure .
     3028               Run Clear-b1 In This-procedure .
     3029               Assign Break_Group = True.
     3030           End.
     3031           If Last-of((substring(clients.obj-name,1,10) + string(gds-obj.prod-code))) Then Do:
     3032           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-obj.prod-code))",".")) = "Grp-name"
     3033             Then  Assign
     3034                 S-bar-code   = "Итого по "
     3035                 Gds-zap-artic = Substring(
     3036                                      B1-name
     3037                                     ,1,16)
     3038                 Gds-zap-gds-name = Substring(
     3039                                      B1-name
     3040                                     ,17,40)
     3041                               .
     3042             Else Assign
     3043                 S-bar-code = ""
     3044                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3045                                                                    Else "  Итого по "
     3046                 Gds-zap-gds-name =   B1-name
     3047                 .
     3048             Run Display-b2 In This-procedure .
     3049             Run Clear-b2 In This-procedure .
     3050             Run Clear-b1 In This-procedure .
     3051             Assign  Break_Group1 = True.
     3052           End.
     3053       End.
     3054     END.
     3055     Else DO:
     3056      For each obj-list no-lock :
     3057                     FOR EACH gds-obj where
     3058                   gds-obj.obj-type = obj-list.obj-type    and
