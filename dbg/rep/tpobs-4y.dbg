     3497   BY (substring(clients.obj-name,1,10) + string(gds-list.prod-code))
     3498   BY (gds-list.grp-name)
     3499       BY gds-list.gds-code :
     3500       run item-goods ( "4" , "gds-list" ) .
     3501         if return-value <> "" then NEXT.
     3502           If Last-of(gds-list.grp-name) Then Do:
     3503           If String(Entry(2,"gds-list.grp-name",".")) = "Grp-name"
     3504             Then  Assign
     3505                     S-bar-code   = " Итого по "
     3506                     Gds-zap-artic = Substring(
     3507                                          B2-name
     3508                                         ,1,16)
     3509                     Gds-zap-gds-name = Substring(
     3510                                          B2-name
     3511                                         ,17,40)
     3512                                   .
     3513             Else  Assign
     3514                     S-bar-code   = ""
     3515                     Gds-zap-artic = "        Итого по "
     3516                     Gds-zap-gds-name =   B2-name
     3517                                   .
     3518               Run Display-b1 In This-procedure .
     3519               Run Clear-b1 In This-procedure .
     3520               Assign Break_Group = True.
     3521           End.
     3522           If Last-of((substring(clients.obj-name,1,10) + string(gds-list.prod-code))) Then Do:
     3523           If String(Entry(2,"(substring(clients.obj-name,1,10) + string(gds-list.prod-code))",".")) = "Grp-name"
     3524             Then  Assign
     3525                 S-bar-code   = "Итого по "
     3526                 Gds-zap-artic = Substring(
     3527                                      B1-name
     3528                                     ,1,16)
     3529                 Gds-zap-gds-name = Substring(
     3530                                      B1-name
     3531                                     ,17,40)
     3532                               .
     3533             Else Assign
     3534                 S-bar-code = ""
     3535                 Gds-zap-artic = If  ("4" = "4"  Or  "4" = "5") Then "Итого по "
     3536                                                                    Else "  Итого по "
     3537                 Gds-zap-gds-name =   B1-name
     3538                 .
     3539             Run Display-b2 In This-procedure .
     3540             Run Clear-b2 In This-procedure .
     3541             Run Clear-b1 In This-procedure .
     3542             Assign  Break_Group1 = True.
     3543           End.
     3544     End.
     3545   End.
     3546            end.
     3547         end case.
     3548   end procedure.
     3549   procedure calcitog :
     3550       run aht-ostatok (
     3551           input x-store-code     ,
     3552           input x-store-type     ,
     3553           input x-tog-shift      ,
     3554           input x-date-start - 1 ,
     3555           input date('')         ,
     3556           input x-shift-start    ,
     3557           input x-shift-end      ,
     3558           input "n"    ,
     3559           input xtog-obj         ,
     3560           output  fact-order-1 ) .
     3561       run aht-ostatok (
     3562           input x-store-code  ,
     3563           input x-store-type  , x-tog-shift,
     3564           input x-date-start  ,
     3565           input x-date-end    , x-shift-start,x-shift-end,
     3566           input "n" ,
     3567           input xtog-obj ,
     3568           output  fact-order-2 ).
     3569   end procedure.
     3570   procedure display-str1  :
     3571      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3572            run di-qnty ("кол-во", 1, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3573            if xshowcost   then do: run di ( "учет." , 2,"","","","","" ). end.
     3574            if xshowcrsa   then do: run di ( "прод." , 5,"","","","","" ). end.
     3575            if xshowsale   then do: run di ( "док."  , 8,"","","","","" ). end.
     3576            if vat-cost    then do: run di ( "уч.НДС", 3,"","","","","" ). end.
     3577            if vat-crsa    then do: run di ( "пр.НДС", 6,"","","","","" ). end.
     3578            if vat-sale    then do: run di ( "дк.НДС", 9,"","","","","" ). end.
     3579      end.
     3580      if p-tpsy = true  then do:
     3581            if  p-type-tpsy-goods = 3 then
     3582                run di-qnty ("кол-во", 11, s-bar-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     3583            else
     3584               run di-qnty ("кол-во", 11, "","",str_svoi,"","").
     3585            if xshowcost   then do: run di ( "учет." , 12,"","","","","" ). end.
     3586            if xshowcrsa   then do: run di ( "прод." , 15,"","","","","" ). end.
     3587            if xshowsale   then do: run di ( "док."  , 18,"","","","","" ). end.
     3588            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","" ). end.
     3589            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","" ). end.
     3590            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","" ). end.
     3591      end.
     3592   end procedure.
