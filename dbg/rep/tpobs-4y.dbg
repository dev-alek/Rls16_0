     4516     excel-sum(bo-Inv          [5  + f_e ])  CHR(9)
     4517     excel-sum(bo-Inv          [8  + f_e ])  CHR(9)
     4518     excel-sum(bo-Inv          [3  + f_e ])  CHR(9)
     4519     excel-sum(bo-Inv          [6  + f_e ])  CHR(9)
     4520     excel-sum(bo-Inv          [9  + f_e ])  CHR(9)
     4521     .
     4522     if Make-Excel then  put   stream ForExcel unformatted
     4523     excel-qnty(bo-Overturn    [1  + f_e ])  CHR(9)
     4524     excel-sum(bo-Overturn     [2  + f_e ])  CHR(9)
     4525     excel-sum(bo-Overturn     [5  + f_e ])  CHR(9)
     4526     excel-sum(bo-Overturn     [8  + f_e ])  CHR(9)
     4527     excel-sum(bo-Overturn     [3  + f_e ])  CHR(9)
     4528     excel-sum(bo-Overturn     [6  + f_e ])  CHR(9)
     4529     excel-sum(bo-Overturn     [9  + f_e ])  CHR(9)
     4530     excel-qnty(bo-Ostatok-end [1  + f_e ])  CHR(9)
     4531     excel-sum(bo-Ostatok-end  [2  + f_e ])  CHR(9)
     4532     excel-sum(bo-Ostatok-end  [5  + f_e ])  CHR(9)
     4533     excel-sum(bo-Ostatok-end  [8  + f_e ])  CHR(9)
     4534     excel-sum(bo-Ostatok-end  [3  + f_e ])  CHR(9)
     4535     excel-sum(bo-Ostatok-end  [6  + f_e ])  CHR(9)
     4536     excel-sum(bo-Ostatok-end  [9  + f_e ])  CHR(9)
     4537     g2
     4538     skip.
     4539                end.
     4540      when ""  then     do :
     4541       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4542         p3 @ s-bar-code
     4543         p4 @ gds-zap-artic
     4544         p5 @ gds-zap-gds-name
     4545         p6 @ gds-zap-unit-base
     4546         p1 @ gds-type
     4547         ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4548         Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4549         RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4550         KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4551         Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4552         Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4553         Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4554         gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4555         with FRAME ZAPAS .
     4556    if  p2 > 10  then f_e = 10 .
     4557                 else f_e =  0 .
     4558   if Make-Excel then  put   stream ForExcel unformatted
     4559     p3 CHR(9)
     4560     p4 CHR(9)
     4561     if f_e = 0 then g1 else p5 CHR(9)
     4562     p6 CHR(9)
     4563     gds-zap-type CHR(9)
     4564     excel-sum(gds-zap-other   )  CHR(9)
     4565     excel-qnty(ostatok-start[1  + f_e ])  CHR(9)
     4566     excel-sum(ostatok-start[2  + f_e ])  CHR(9)
     4567     excel-sum(ostatok-start[5  + f_e ])  CHR(9)
     4568     excel-sum(ostatok-start[8  + f_e ])  CHR(9)
     4569     .
     4570     if Make-Excel then  put   stream ForExcel unformatted
     4571     excel-sum(ostatok-start[3  + f_e ])  CHR(9)
     4572     excel-sum(ostatok-start[6  + f_e ])  CHR(9)
     4573     excel-sum(ostatok-start[9  + f_e ])  CHR(9)
     4574     excel-qnty(Prih        [1  + f_e ])  CHR(9)
     4575     excel-sum(Prih         [2  + f_e ])  CHR(9)
     4576     excel-sum(Prih         [5  + f_e ])  CHR(9)
     4577     excel-sum(Prih         [8  + f_e ])  CHR(9)
     4578     excel-sum(Prih         [3  + f_e ])  CHR(9)
     4579     excel-sum(Prih         [6  + f_e ])  CHR(9)
     4580     excel-sum(Prih         [9  + f_e ])  CHR(9)
     4581     .
     4582     if Make-Excel then  put   stream ForExcel unformatted
     4583     excel-qnty(RAsh        [1  + f_e ])  CHR(9)
     4584     excel-sum(RAsh         [2  + f_e ])  CHR(9)
     4585     excel-sum(RAsh         [5  + f_e ])  CHR(9)
     4586     excel-sum(RAsh         [8  + f_e ])  CHR(9)
     4587     excel-sum(RAsh         [3  + f_e ])  CHR(9)
     4588     excel-sum(RAsh         [6  + f_e ])  CHR(9)
     4589     excel-sum(RAsh         [9  + f_e ])  CHR(9)
     4590     excel-qnty(KAssa       [1  + f_e ])  CHR(9)
     4591     excel-sum(KAssa        [2  + f_e ])  CHR(9)
     4592     excel-sum(KAssa        [5  + f_e ])  CHR(9)
     4593     excel-sum(KAssa        [8  + f_e ])  CHR(9)
     4594     excel-sum(KAssa        [3  + f_e ])  CHR(9)
     4595     excel-sum(KAssa        [6  + f_e ])  CHR(9)
     4596     .
     4597     if Make-Excel then  put   stream ForExcel unformatted
     4598     excel-sum(KAssa        [9  + f_e ])  CHR(9)
     4599     excel-qnty(Inv         [1  + f_e ])  CHR(9)
     4600     excel-sum(Inv          [2  + f_e ])  CHR(9)
     4601     excel-sum(Inv          [5  + f_e ])  CHR(9)
     4602     excel-sum(Inv          [8  + f_e ])  CHR(9)
     4603     excel-sum(Inv          [3  + f_e ])  CHR(9)
     4604     excel-sum(Inv          [6  + f_e ])  CHR(9)
     4605     excel-sum(Inv          [9  + f_e ])  CHR(9)
     4606     .
     4607     if Make-Excel then  put   stream ForExcel unformatted
     4608     excel-qnty(Overturn    [1  + f_e ])  CHR(9)
     4609     excel-sum(Overturn     [2  + f_e ])  CHR(9)
     4610     excel-sum(Overturn     [5  + f_e ])  CHR(9)
     4611     excel-sum(Overturn     [8  + f_e ])  CHR(9)
     4612     excel-sum(Overturn     [3  + f_e ])  CHR(9)
     4613     excel-sum(Overturn     [6  + f_e ])  CHR(9)
     4614     excel-sum(Overturn     [9  + f_e ])  CHR(9)
     4615     excel-qnty(Ostatok-end [1  + f_e ])  CHR(9)
     4616     excel-sum(Ostatok-end  [2  + f_e ])  CHR(9)
     4617     excel-sum(Ostatok-end  [5  + f_e ])  CHR(9)
     4618     excel-sum(Ostatok-end  [8  + f_e ])  CHR(9)
     4619     excel-sum(Ostatok-end  [3  + f_e ])  CHR(9)
     4620     excel-sum(Ostatok-end  [6  + f_e ])  CHR(9)
     4621     excel-sum(Ostatok-end  [9  + f_e ])  CHR(9)
     4622     g2
     4623     skip.
     4624                 end.
     4625      end case.
     4626                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4627    end procedure.
     4628   procedure ost-line-body :
     4629   do on error undo, return error return-value :
     4630   define input parameter p-num        as   integer   no-undo .
     4631   define input parameter p-store-type like ub.clients.obj-type no-undo .
     4632   define input parameter p-store-code like ub.clients.obj-code no-undo .
     4633    find last  ub.aht-stk-line where
     4634                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4635                     and   ub.aht-stk-line.fact-order <= fact-order-1
     4636                     and   ub.aht-stk-line.obj-code   = p-store-code
     4637                     and   ub.aht-stk-line.obj-type   = p-store-type
     4638                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4639                           use-index category no-lock no-error.
     4640           if available ub.aht-stk-line then do:
     4641               if  tprintrubl  then
     4642                     assign
     4643                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4644                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4645                           ostatok-start[2 + p-num]  =ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-rubl ,2)
     4646                           ostatok-start[3 + p-num]  =ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-rubl ,2)
     4647                           ostatok-start[4 + p-num]  =ostatok-start[4 + p-num] +  0
     4648                           ostatok-start[5 + p-num]  =ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4649                           ostatok-start[6 + p-num]  =ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4650                           ostatok-start[7 + p-num]  =ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4651                           ostatok-start[8 + p-num]  =ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4652                           ostatok-start[9 + p-num]  =ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4653                           ostatok-start[10 + p-num] =ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4654                           .
     4655                 else
     4656                     assign
     4657                           ostatok-start[1 + p-num]  = ostatok-start[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4658                                                                      then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4659                           ostatok-start[2 + p-num]  = ostatok-start[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4660                           ostatok-start[3 + p-num]  = ostatok-start[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4661                           ostatok-start[4 + p-num]  = ostatok-start[4 + p-num] +  0
     4662                           ostatok-start[5 + p-num]  = ostatok-start[5 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4663                           ostatok-start[6 + p-num]  = ostatok-start[6 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4664                           ostatok-start[7 + p-num]  = ostatok-start[7 + p-num]  + round( ub.aht-stk-line.sale-discnt-base ,2)
     4665                           ostatok-start[8 + p-num]  = ostatok-start[8 + p-num]  + round( ub.aht-stk-line.crsa-sum-base ,2)
     4666                           ostatok-start[9 + p-num]  = ostatok-start[9 + p-num]  + round( ub.aht-stk-line.crsa-vat-base ,2)
     4667                           ostatok-start[10 + p-num] = ostatok-start[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4668                     .
     4669                end.
     4670    find last  ub.aht-stk-line where
     4671                           ub.aht-stk-line.gds-code   = gds-zap-b-code
     4672                     and   ub.aht-stk-line.fact-order <= fact-order-2
     4673                     and   ub.aht-stk-line.obj-code   = p-store-code
     4674                     and   ub.aht-stk-line.obj-type   = p-store-type
     4675                     and   ub.aht-stk-line.sum-type   = x-type-pr
     4676                           use-index category no-lock no-error.
     4677           if available ub.aht-stk-line then do:
     4678               if  tprintrubl  then
     4679                     assign
     4680                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] + (if ub.aht-stk-line.sum-type <> "b"
     4681                                                                  then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4682                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] + round( ub.aht-stk-line.cost-sum-rubl ,2)
     4683                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] + round( ub.aht-stk-line.cost-vat-rubl ,2)
     4684                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] + 0
     4685                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4686                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4687                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] + round( ub.aht-stk-line.sale-discnt-rubl ,2)
     4688                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] + round( ub.aht-stk-line.crsa-sum-rubl ,2)
     4689                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] + round( ub.aht-stk-line.crsa-vat-rubl ,2)
     4690                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-rubl ,2)
     4691                           .
     4692                 else
     4693                     assign
     4694                           ostatok-end[1 + p-num]  = ostatok-end[1 + p-num] +  (if ub.aht-stk-line.sum-type <> "b"
     4695                                                                   then round( ub.aht-stk-line.fact-qnty,3) else 0 )
     4696                           ostatok-end[2 + p-num]  = ostatok-end[2 + p-num] +  round( ub.aht-stk-line.cost-sum-base ,2)
     4697                           ostatok-end[3 + p-num]  = ostatok-end[3 + p-num] +  round( ub.aht-stk-line.cost-vat-base ,2)
     4698                           ostatok-end[4 + p-num]  = ostatok-end[4 + p-num] +  0
     4699                           ostatok-end[5 + p-num]  = ostatok-end[5 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4700                           ostatok-end[6 + p-num]  = ostatok-end[6 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4701                           ostatok-end[7 + p-num]  = ostatok-end[7 + p-num] +  round( ub.aht-stk-line.sale-discnt-base ,2)
     4702                           ostatok-end[8 + p-num]  = ostatok-end[8 + p-num] +  round( ub.aht-stk-line.crsa-sum-base ,2)
     4703                           ostatok-end[9 + p-num]  = ostatok-end[9 + p-num] +  round( ub.aht-stk-line.crsa-vat-base ,2)
     4704                           ostatok-end[10 + p-num] = ostatok-end[10 + p-num] + round( ub.aht-stk-line.crsa-slt-base ,2)
     4705                     .
     4706                end.
     4707   end.
     4708   end procedure.
     4709   procedure ob-line  :
     4710   do on error undo, return error return-value :
     4711   def input  parameter x-store-code     like ub.clients.obj-code         no-undo .
     4712   def input  parameter x-store-type     like ub.clients.obj-type         no-undo .
     4713   def input  parameter x-gds-code       like ub.aht-ot-line.gds-code     no-undo .
     4714   def input  parameter x-fact-order-1   like ub.aht-ot-line.fact-order   no-undo .
     4715   def input  parameter x-fact-order-2   like ub.aht-ot-line.fact-order   no-undo .
     4716   def input  parameter x-sum-type       like ub.aht-ot-line.sum-type     no-undo .
     4717   def input  parameter xtog-obj         as logical no-undo .
     4718   define variable      tt#              as integer no-undo .
     4719   define variable x-type-pr1 as character no-undo .
     4720   define variable x-type-pr2 as character no-undo .
     4721   define variable p-ok as logical   no-undo .
     4722    if x-sum-type = arh-type-cost then tt# = 0 .
     4723    if x-sum-type = arh-type-crsa then tt# = 3 .
     4724    if x-sum-type = arh-type-sale then tt# = 6 .
     4725   if  x-sum-type = "cb" then
     4726    assign
     4727       x-type-pr1 = "c"
     4728       x-type-pr2 = "b"
     4729    .
     4730   else
     4731    assign
     4732       x-type-pr1 = x-sum-type
     4733       x-type-pr2 = x-sum-type
     4734    .
     4735        for each ub.aht-ot-line where
     4736                     (      ub.aht-ot-line.gds-code     = x-gds-code
     4737                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4738                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4739                     and   ub.aht-ot-line.obj-code     = x-store-code
     4740                     and   ub.aht-ot-line.obj-type     = x-store-type
     4741                     and   ub.aht-ot-line.sum-type     = x-type-pr1)
     4742                     or
     4743                     (     ub.aht-ot-line.gds-code     = x-gds-code
     4744                     and   ub.aht-ot-line.fact-order   <= x-fact-order-2
     4745                     and   ub.aht-ot-line.fact-order   >= x-fact-order-1
     4746                     and   ub.aht-ot-line.obj-code     = x-store-code
     4747                     and   ub.aht-ot-line.obj-type     = x-store-type
     4748                     and   ub.aht-ot-line.sum-type     = x-type-pr2 )
     4749                     no-lock :
     4750       if  p-tpsy = true then do:
     4751           run ver-owner2
     4752           ( input  ub.aht-ot-line.gds-code,
     4753             input  ub.aht-ot-line.obj-type,
     4754             input  ub.aht-ot-line.obj-code,
     4755             output p-ok ) .
     4756       end.
     4757       case ub.aht-ot-line.ext-doc-type:
     4758                 when        'ie':U  or
     4759                 when        're':U  or
     4760                 when        'iv':U    or
     4761                 when        'rv':U or
     4762                 when        'im':U     then
     4763                 do:
     4764                 assign
     4765                        prih[1 ]   = prih[1 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4766                        prih[2 ]   = prih[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4767                        prih[3 ]   = prih[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4768                        prih[4 ]   = prih[4 ]
     4769                        prih[5 ]   = prih[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4770                        prih[6 ]   = prih[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4771                        prih[7 ]   = prih[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4772                        prih[8 ]   = prih[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4773                        prih[9 ]   = prih[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4774                        gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4775                  .
     4776        if p-ok = true then do:
     4777           assign
     4778             prih[11 ]   = prih[11 ]   + (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4779             prih[12 ]   = prih[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4780             prih[13 ]   = prih[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4781             prih[14 ]   = prih[14 ]
     4782             prih[15 ]   = prih[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4783             prih[16 ]   = prih[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4784             prih[17 ]   = prih[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4785             prih[18 ]   = prih[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4786             prih[19 ]   = prih[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4787             .
     4788        end.
     4789                 end.
     4790                 when       'ee':U      or
     4791                 when       'ep':U    or
     4792                 when       'ev':U     or
     4793                 when       'em':U       or
     4794                 when       'wm':U       or
     4795                 when       'we':U     then
     4796                 do:
     4797                   assign
     4798                       rash[1  ]   = rash[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4799                       rash[2  ]   = rash[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4800                       rash[3 ]   = rash[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4801                       rash[4 ]   = rash[4 ]
     4802                       rash[5 ]   = rash[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4803                       rash[6 ]   = rash[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4804                       rash[7 ]   = rash[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4805                       rash[8 ]   = rash[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4806                       rash[9 ]   = rash[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4807                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4808                 .
     4809                   if p-ok = true then do:
     4810                     assign
     4811                       rash[11  ]   = rash[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4812                       rash[12  ]   = rash[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4813                       rash[13 ]   = rash[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4814                       rash[14 ]   = rash[14 ]
     4815                       rash[15 ]   = rash[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4816                       rash[16 ]   = rash[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4817                       rash[17 ]   = rash[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4818                       rash[18 ]   = rash[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4819                       rash[19 ]   = rash[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4820                     .
     4821                   end.
     4822                 end.
     4823                 when       'es':U  or
     4824                 when       'rs':U then
     4825                 do:
     4826                     assign
     4827                       kassa[1  ]   = kassa[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4828                       kassa[2  ]   = kassa[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4829                       kassa[3  ]   = kassa[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4830                       kassa[4  ]   = kassa[4 ]
     4831                       kassa[5  ]   = kassa[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4832                       kassa[6  ]   = kassa[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4833                       kassa[7  ]   = kassa[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4834                       kassa[8  ]   = kassa[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4835                       kassa[9  ]   = kassa[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4836                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4837                       .
     4838                     if p-ok = true then
     4839                     assign
     4840                       kassa[11  ]   = kassa[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4841                       kassa[12  ]   = kassa[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4842                       kassa[13  ]   = kassa[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4843                       kassa[14  ]   = kassa[14 ]
     4844                       kassa[15  ]   = kassa[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4845                       kassa[16  ]   = kassa[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4846                       kassa[17  ]   = kassa[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4847                       kassa[18  ]   = kassa[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4848                       kassa[19  ]   = kassa[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4849                       .
     4850                 end.
     4851             when       'vt':U            or
     4852             when       'pc':U or
     4853             when       'vp':U       then do:
     4854                 assign
     4855                   inv[1  ]   = inv[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4856                   inv[2  ]   = inv[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4857                   inv[3  ]   = inv[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4858                   inv[4  ]   = inv[4 ]
     4859                   inv[5  ]   = inv[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4860                   inv[6  ]   = inv[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4861                   inv[7  ]   = inv[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4862                   inv[8  ]   = inv[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4863                   inv[9  ]   = inv[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4864                   gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4865                   .
     4866                 if p-ok = true then
     4867                 assign
     4868                   inv[11  ]   = inv[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4869                   inv[12  ]   = inv[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4870                   inv[13  ]   = inv[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4871                   inv[14  ]   = inv[14 ]
     4872                   inv[15  ]   = inv[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4873                   inv[16  ]   = inv[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4874                   inv[17  ]   = inv[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4875                   inv[18  ]   = inv[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4876                   inv[19  ]   = inv[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4877                   .
     4878                 end.
     4879             when       'ot':U or
     4880             when       'ap':U then
     4881                 do:
     4882                    assign
     4883                       overturn[1  ]   = overturn[1 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4884                       overturn[2  ]   = overturn[2 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4885                       overturn[3  ]   = overturn[3 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4886                       overturn[4  ]   = overturn[4 ]
     4887                       overturn[5  ]   = overturn[5 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4888                       overturn[6  ]   = overturn[6 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4889                       overturn[7  ]   = overturn[7 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4890                       overturn[8  ]   = overturn[8 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4891                       overturn[9  ]   = overturn[9 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4892                       gds-zap-other   = gds-zap-other  +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4893                       .
     4894                    if p-ok = true then
     4895                    assign
     4896                       overturn[11  ]   = overturn[11 ]   +  (if ub.aht-ot-line.sum-type <> "b" then round( ub.aht-ot-line.fact-qnty,3) else 0 )
     4897                       overturn[12  ]   = overturn[12 ]   +  if tprintrubl then ub.aht-ot-line.cost-sum-rubl else  ub.aht-ot-line.cost-sum-base
     4898                       overturn[13  ]   = overturn[13 ]   +  if tprintrubl then ub.aht-ot-line.cost-vat-rubl else  ub.aht-ot-line.cost-vat-base
     4899                       overturn[14  ]   = overturn[14 ]
     4900                       overturn[15  ]   = overturn[15 ]   +  if tprintrubl then ub.aht-ot-line.crsa-sum-rubl else  ub.aht-ot-line.crsa-sum-base
     4901                       overturn[16  ]   = overturn[16 ]   +  if tprintrubl then ub.aht-ot-line.crsa-vat-rubl else  ub.aht-ot-line.crsa-vat-base
     4902                       overturn[17  ]   = overturn[17 ]   +  if tprintrubl then ub.aht-ot-line.sale-discnt-rubl else  ub.aht-ot-line.sale-discnt-base
     4903                       overturn[18  ]   = overturn[18 ]   +  if tprintrubl then ub.aht-ot-line.sale-sum-rubl else  ub.aht-ot-line.sale-sum-base
     4904                       overturn[19  ]   = overturn[19 ]   +  if tprintrubl then ub.aht-ot-line.sale-vat-rubl else  ub.aht-ot-line.sale-vat-base
     4905                       .
     4906                 end.
     4907         end case.
     4908     end.
     4909     assign
     4910       tt# = 6
     4911       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4912       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4913       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4914     .
     4915     if p-ok = true then
     4916     assign
     4917       tt# = 6
     4918       overturn[1 + tt# ]   = (ostatok-end[1 + tt# ]  - ostatok-start[1 + tt# ] )  -  (inv[1 + tt# ] + prih[1 + tt# ] + kassa[1 + tt# ] + rash[1 + tt# ]  )
     4919       overturn[2 + tt# ]   = (ostatok-end[2 + tt# ]  - ostatok-start[2 + tt# ] )  -  (inv[2 + tt# ] + prih[2 + tt# ] + kassa[2 + tt# ] + rash[2 + tt# ]  )
     4920       overturn[3 + tt# ]   = (ostatok-end[3 + tt# ]  - ostatok-start[3 + tt# ] )  -  (inv[3 + tt# ] + prih[3 + tt# ] + kassa[3 + tt# ] + rash[3 + tt# ]  )
     4921     .
     4922   end.
     4923   end procedure.
     4924   procedure ver-owner :
     4925     do
     4926     on error undo, return error return-value
     4927     :
     4928   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4929   define input  parameter p-db-num as integer   no-undo .
     4930   define output parameter p-ok as logical   no-undo .
     4931   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4932   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4933   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4934   p-ok = false .
     4935   if  p-tpsy = false  then return.
     4936     run tpsi-gds-proprietor (
     4937         input  p-gds-code             ,
     4938         input  p-db-num               ,
     4939         output p-proprietor-host-code ,
     4940         output p-proprietor-obj-type  ,
     4941         output p-proprietor-obj-code )  .
     4942    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4943   end.
     4944   end procedure.
     4945   procedure ver-owner2 :
     4946     do
     4947     on error undo, return error return-value
     4948     :
     4949   define input  parameter p-gds-code like ub.goods.gds-code no-undo .
     4950   define input  parameter p-obj-type  like ub.clients.obj-type no-undo .
     4951   define input  parameter p-obj-code  like ub.clients.obj-code no-undo .
     4952   define output parameter p-ok as logical   no-undo .
     4953   define variable  p-proprietor-host-code like ub.clients.host-code no-undo .
     4954   define variable  p-proprietor-obj-type  like ub.clients.obj-type no-undo .
     4955   define variable  p-proprietor-obj-code  like ub.clients.obj-code no-undo .
     4956   p-ok = false .
     4957   if  p-tpsy = false  then return.
     4958   define buffer buf_obj-list for obj-list.
     4959   find first buf_obj-list where
     4960         buf_obj-list.obj-type = p-obj-type and
     4961         buf_obj-list.obj-code = p-obj-code
     4962         no-error .
     4963   if error-status :error then return .
     4964     run tpsi-gds-proprietor (
     4965         input  p-gds-code             ,
     4966         input  buf_obj-list.db-num     ,
     4967         output p-proprietor-host-code ,
     4968         output p-proprietor-obj-type  ,
     4969         output p-proprietor-obj-code )  .
     4970    if p-proprietor-host-code = v-cntxt-host-code-obj then p-ok = true  .
     4971   end.
     4972   end procedure.
