     3639   procedure display-b1  :
     3640         if not( not show-negativ-2 and
     3641            ( b1-prih          [1]   = 0 and
     3642              b1-rash          [1]   = 0 and
     3643              b1-kassa         [1]   = 0 and
     3644              b1-inv           [1]   = 0 and
     3645              b1-overturn      [1]   = 0 and
     3646              b1-overturn      [5]   = 0 and
     3647              b1-overturn      [8]   = 0 ) ) then do:
     3648           if  not (not show-negativ  and (
     3649                 b1-prih          [1]   = 0 and
     3650                 b1-rash          [1]   = 0 and
     3651                 b1-kassa         [1]   = 0 and
     3652                 b1-inv           [1]   = 0 and
     3653                 b1-overturn      [1]   = 0 and
     3654                 b1-overturn      [5]   = 0 and
     3655                 b1-ostatok-start [1]   = 0 and
     3656                 b1-ostatok-end   [1]   = 0   )) then do:
     3657                 if sums-only then do:
     3658                     if fr0 = true then do:
     3659                         put stream  outstream  tmp#stroka0 format "x(100)" skip.
     3660                         if Make-Excel then  put   stream ForExcel unformatted string(tmp#stroka0) skip.
     3661                         fr0 = false .
     3662                       end.
     3663                  end.
     3664      if p-tpsy = no  or ( p-tpsy = true and  p-type-tpsy-goods = 2 ) then do:
     3665           run di-qnty in this-procedure ("кол-во"  ,1, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3666           if xshowcost    then do: run di in this-procedure ("учет." ,2 ,"","", "", "", "b1":u).  end.
     3667           if xshowcrsa    then do: run di in this-procedure ("прод." , 5, "","", "", "", "b1":u).  end.
     3668           if xshowsale    then do: run di in this-procedure ("док." , 8, "","", "", "", "b1":u).  end.
     3669           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 3,"","","","","b1":u ). end.
     3670           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 6,"","","","","b1":u ).  end.
     3671           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 9,"","","","","b1":u ).  end.
     3672      end.
     3673      if p-tpsy = true  then do:
     3674            if  p-type-tpsy-goods = 3 then
     3675                run di-qnty ("кол-во"  ,11, s-bar-code, gds-zap-artic, gds-zap-gds-name  ,"","b1":u).
     3676            else
     3677               run di-qnty in this-procedure ("кол-во"  ,11, "","", str_svoi, "","b1":u).
     3678           if xshowcost    then do: run di in this-procedure ("учет." ,12 ,"","", "", "", "b1":u).  end.
     3679           if xshowcrsa    then do: run di in this-procedure ("прод." ,15, "","", "", "", "b1":u).  end.
     3680           if xshowsale    then do: run di in this-procedure ("док." , 18, "","", "", "", "b1":u).  end.
     3681           if vat-cost    then do: run di in this-procedure ( "уч.НДС", 13,"","","","","b1":u ). end.
     3682           if vat-crsa    then do: run di in this-procedure ( "пр.НДС", 16,"","","","","b1":u ).  end.
     3683           if vat-sale    then do: run di in this-procedure ( "дк.НДС", 19,"","","","","b1":u ).  end.
     3684      end.
     3685          if not sums-only then run p-line.
     3686    end.
     3687    end.
     3688   end procedure.
