     4077   procedure di :
     4078   def input parameter p1 as char no-undo.
     4079   def input parameter p2 as int no-undo.
     4080   def input parameter p3 as char no-undo.
     4081   def input parameter p4 as char no-undo.
     4082   def input parameter p5 as char no-undo.
     4083   def input parameter p6 as char no-undo.
     4084   def input parameter p7 as char no-undo.
     4085    case caps(p7) :
     4086      when "b1":u  then do:
     4087       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4088         p3 @ s-bar-code
     4089         p4 @ gds-zap-artic
     4090         p5 @ gds-zap-gds-name
     4091         p6 @ gds-zap-unit-base
     4092         p1 @ gds-type
     4093         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4094         b1-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4095         b1-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4096         b1-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4097         b1-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4098         b1-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4099         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4100         b1-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4101         with FRAME ZAPAS .
     4102                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4103                   end.
     4104      when "b2":u  then  do:
     4105       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4106         p3 @ s-bar-code
     4107         p4 @ gds-zap-artic
     4108         p5 @ gds-zap-gds-name
     4109         p6 @ gds-zap-unit-base
     4110         p1 @ gds-type
     4111         b2-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4112         b2-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4113         b2-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4114         b2-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4115         b2-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4116         b2-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4117         b2-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4118         b2-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4119         with FRAME ZAPAS .
     4120                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4121                 end.
     4122      when "bi":u then  do:
     4123       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4124         p3 @ s-bar-code
     4125         p4 @ gds-zap-artic
     4126         p5 @ gds-zap-gds-name
     4127         p6 @ gds-zap-unit-base
     4128         p1 @ gds-type
     4129         bi-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4130         bi-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4131         bi-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4132         bi-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4133         bi-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4134         bi-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4135         bi-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4136         bi-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4137         with FRAME ZAPAS .
     4138                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4139                 end.
     4140      when "bo":u then  do:
     4141       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4142         p3 @ s-bar-code
     4143         p4 @ gds-zap-artic
     4144         p5 @ gds-zap-gds-name
     4145         p6 @ gds-zap-unit-base
     4146         p1 @ gds-type
     4147         bo-ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4148         bo-Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4149         bo-RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4150         bo-KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4151         bo-Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4152         bo-Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4153         bo-Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4154         bo-gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4155         with FRAME ZAPAS .
     4156                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4157                 end.
     4158      when ""  then  do:
     4159       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4160         p3 @ s-bar-code
     4161         p4 @ gds-zap-artic
     4162         p5 @ gds-zap-gds-name
     4163         p6 @ gds-zap-unit-base
     4164         p1 @ gds-type
     4165         ostatok-start [p2] format "->>>>>>>>>>9.<<" @  F-ostatok-start
     4166         Prih          [p2] format "->>>>>>>>>>9.<<" @  F-Prih
     4167         RAsh          [p2] format "->>>>>>>>>>9.<<" @  F-RAsh
     4168         KAssa         [p2] format "->>>>>>>>>>9.<<" @  F-KAssa
     4169         Inv           [p2] format "->>>>>>>>>>9.<<" @  F-Inv
     4170         Overturn      [p2] format "->>>>>>>>>>9.<<" @  F-Overturn
     4171         Ostatok-end   [p2] format "->>>>>>>>>>9.<<" @  F-Ostatok-end
     4172         gds-zap-other      format "->>>>>>>>>>9.<<" when (p2 = 1) @  gds-zap-other
     4173         with FRAME ZAPAS .
     4174                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4175                 end.
     4176      end case.
     4177    end procedure.
     4178   procedure di-qnty :
     4179   def input parameter p1 as char no-undo.
     4180   def input parameter p2 as int no-undo.
     4181   def input parameter p3 as char no-undo.
     4182   def input parameter p4 as char no-undo.
     4183   def input parameter p5 as char no-undo.
     4184   def input parameter p6 as char no-undo.
     4185   def input parameter p7 as char no-undo.
     4186    case caps(p7) :
     4187      when "b1":u  then do :
     4188       DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4189         p3 @ s-bar-code
     4190         p4 @ gds-zap-artic
     4191         p5 @ gds-zap-gds-name
     4192         p6 @ gds-zap-unit-base
     4193         p1 @ gds-type
     4194         b1-ostatok-start [p2] format "->>>>>>>>>>9.<<<" @  F-ostatok-start
     4195         b1-Prih          [p2] format "->>>>>>>>>>9.<<<" @  F-Prih
     4196         b1-RAsh          [p2] format "->>>>>>>>>>9.<<<" @  F-RAsh
     4197         b1-KAssa         [p2] format "->>>>>>>>>>9.<<<" @  F-KAssa
     4198         b1-Inv           [p2] format "->>>>>>>>>>9.<<<" @  F-Inv
     4199         b1-Overturn      [p2] format "->>>>>>>>>>9.<<<" @  F-Overturn
     4200         b1-Ostatok-end   [p2] format "->>>>>>>>>>9.<<<" @  F-Ostatok-end
     4201         b1-gds-zap-other      format "->>>>>>>>>>9.<<<" when (p2 = 1) @  gds-zap-other
     4202         with FRAME ZAPAS .
     4203                 if num-entries(g1, "|") = 2 then assign  g1 =  "" .
     4204                 p6 = "" .
     4205                 gds-zap-type = "" .
     4206    if  p2 > 10  then f_e = 10 .
     4207                 else f_e =  0 .
     4208   if Make-Excel then  put   stream ForExcel unformatted
     4209     p3 CHR(9)
     4210     p4 CHR(9)
     4211     if f_e = 0 then g1 else p5 CHR(9)
