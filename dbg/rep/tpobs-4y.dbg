     3770   procedure display-title :
     3771   define variable v-nn as integer   no-undo .
     3772      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + objname) at 50 format "x(85)" skip(2)
     3773             reportname  at 20 format "x(170)" skip
     3774             trim(str1)  at 35 format "x(75)" skip.
     3775        v-nn = num-entries(str2,chr(10)) .
     3776        repeat i = 1 to v-nn :
     3777         PUT stream  OutStream  UNFORMATTED  entry(i,str2,chr(10))  at 1 format "x(170)" skip.
     3778        end.
     3779       i=0.
     3780        PUT stream  OutStream  UNFORMATTED  trim(str3)  at 35 format "x(75)" skip.
     3781        v-nn = num-entries(str4,chr(10)) .
     3782        repeat i = 1 to v-nn:
     3783          PUT stream  OutStream  UNFORMATTED  entry(i,str4,chr(10))  at 1 format "x(170)" skip.
     3784        end.
     3785       i=0.
     3786        v-nn = num-entries( reportheader,chr(10)) .
     3787        repeat i = 1 to v-nn :
     3788         PUT stream  OutStream  UNFORMATTED  entry(i,reportheader,chr(10))  at 1 format "x(170)" skip.
     3789        end.
     3790       i=0.
     3791       run rep/extitle.p (1) .
     3792   end procedure.
     3793   procedure report-exec1  :
     3794      find first clients where x-store-type = clients.obj-type and
     3795                               x-store-code = clients.obj-code no-lock no-error.
     3796     run calcitog.
     3797     run print-header.
     3798      case retclassify :
     3799         when "prod/grp-goods":u then run run4 in this-procedure .
     3800         otherwise do:
     3801           message "error" view-as alert-box error .
     3802         end.
     3803      end case.
     3804     run print-footer.
     3805     end procedure.
     3806   procedure calc-sub-itog :
     3807   define variable b  as int no-undo.
     3808   assign
     3809     b1-gds-zap-other = b1-gds-zap-other +  gds-zap-other
     3810     b2-gds-zap-other = b2-gds-zap-other +  gds-zap-other
     3811     bi-gds-zap-other = bi-gds-zap-other +  gds-zap-other
     3812     bo-gds-zap-other = bo-gds-zap-other +  gds-zap-other
     3813     .
     3814   repeat b = 1 to 20 :
     3815     assign
     3816     b1-ostatok-start[b ]    = b1-ostatok-start[b ]    +  ostatok-start[b ]
     3817     b1-ostatok-end  [b ]    = b1-ostatok-end  [b ]    +  ostatok-end  [b ]
     3818     b2-ostatok-start[b ]    = b2-ostatok-start[b ]    +  ostatok-start[b ]
     3819     b2-ostatok-end  [b ]    = b2-ostatok-end  [b ]    +  ostatok-end  [b ]
     3820     bi-ostatok-start[b ]    = bi-ostatok-start[b ]    +  ostatok-start[b ]
     3821     bi-ostatok-end  [b ]    = bi-ostatok-end  [b ]    +  ostatok-end  [b ]
     3822     bo-ostatok-start[b ]    = bo-ostatok-start[b ]    +  ostatok-start[b ]
     3823     bo-ostatok-end  [b ]    = bo-ostatok-end  [b ]    +  ostatok-end  [b ]
     3824     b1-prih[b ]    = b1-prih[b ]    +  prih[b ]
     3825     b2-prih[b ]    = b2-prih[b ]    +  prih[b ]
     3826     bi-prih[b ]    = bi-prih[b ]    +  prih[b ]
     3827     bo-prih[b ]    = bo-prih[b ]    +  prih[b ]
     3828     b1-rash[b ]    = b1-rash[b ]    +  rash[b ]
     3829     b2-rash[b ]    = b2-rash[b ]    +  rash[b ]
     3830     bi-rash[b ]    = bi-rash[b ]    +  rash[b ]
     3831     bo-rash[b ]    = bo-rash[b ]    +  rash[b ]
     3832     b1-kassa[b ]    = b1-kassa[b ]    +  kassa[b ]
     3833     b2-kassa[b ]    = b2-kassa[b ]    +  kassa[b ]
     3834     bi-kassa[b ]    = bi-kassa[b ]    +  kassa[b ]
     3835     bo-kassa[b ]    = bo-kassa[b ]    +  kassa[b ]
     3836     b1-inv[b ]    = b1-inv[b ]    +  inv[b ]
     3837     b2-inv[b ]    = b2-inv[b ]    +  inv[b ]
     3838     bi-inv[b ]    = bi-inv[b ]    +  inv[b ]
     3839     bo-inv[b ]    = bo-inv[b ]    +  inv[b ]
     3840     b1-overturn[b ]    = b1-overturn[b ]    +  overturn[b ]
     3841     b2-overturn[b ]    = b2-overturn[b ]    +  overturn[b ]
     3842     bi-overturn[b ]    = bi-overturn[b ]    +  overturn[b ]
     3843     bo-overturn[b ]    = bo-overturn[b ]    +  overturn[b ]
     3844     .
     3845   end.
     3846   end procedure.
     3847   procedure clear-item :
     3848   define variable kk as int no-undo.
     3849    gds-zap-other = 0 .
     3850    repeat kk = 1 to 20 :
     3851    assign
     3852       prih            [kk]    = 0
     3853       rash            [kk]    = 0
     3854       kassa           [kk]    = 0
     3855       inv             [kk]    = 0
     3856       overturn        [kk]    = 0
     3857       ostatok-end     [kk]    = 0
     3858       ostatok-start   [kk]    = 0 .
     3859          end.
     3860    end procedure.
     3861   procedure item-goods :
     3862      def input parameter  par-3 as char no-undo.
     3863      def input parameter  par-4 as char no-undo.
     3864        if par-4 = "goods":u  then do:
     3865           assign
     3866               gds-zap-unit-base  = goods.unit-base
     3867               gds-zap-prt-root   = goods.prt-root
     3868               gds-zap-prod-type  = goods.prod-type
