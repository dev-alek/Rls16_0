     2174   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     2175         VIEW-AS TEXT
     2176        SIZE 53.25 BY .67
     2177        FGCOLOR 1  NO-UNDO.
     2178   DEFINE RECTANGLE RECT-1
     2179        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     2180        SIZE 55.13 BY 4.46.
     2181   DEFINE FRAME InfoFrame
     2182        StopBtn AT ROW 4.25 COL 21.75
     2183        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     2184        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     2185        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     2186        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     2187        RECT-1 AT ROW 1 COL 1
     2188       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     2189            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     2190            TITLE "Процесс"
     2191            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     2192   define variable mFrameView      as logical   no-undo init yes.
     2193     define variable mFramHandle as handle no-undo.
     2194     mFramHandle = frame InfoFrame:handle.
     2195     if  log-manager:logfile-name ne ?
     2196     then DO:
     2197         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     2198         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     2199         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     2200     end.
     2201     mFrameView = not session:batch-mode and mFramHandle:visible.
     2202     if mFrameView
     2203     then do:
     2204       ASSIGN
     2205          FRAME InfoFrame:HIDDEN                           = TRUE
     2206          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     2207     end.
     2208   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     2209   DO:
     2210     IF not StopProcessing THEN
     2211       Message "Вы действительно хотите прервать" SKIP
     2212               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     2213                 UPDATE StopProcessing.
     2214     IF StopProcessing THEN do:
     2215        if mFrameView
     2216        then do:
     2217           HIDE FRAME InfoFrame.
     2218        end.
     2219     End.
     2220   END.
     2221   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     2222     if  log-manager:logfile-name ne ?
     2223     then DO:
     2224         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     2225     end.
     2226     if not session:batch-mode then
     2227     do:
     2228       VIEW FRAME InfoFrame.
     2229       mFrameView = true.
     2230     end.
     2231      v-button-stop = false .
     2232         if mFrameView
     2233         then do:
     2234         if v-button-stop then view STOPBTN in frame InfoFrame.
     2235                          else Hide STOPBTN in frame InfoFrame.
     2236         end.
     2237   define temp-table temp-tpsi-clients no-undo like ub.clients.
     2238   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2239   procedure tpsi-gds-fill-tpsi-obj-table :
     2240   define input parameter p-db-num like ub.db.db-num no-undo .
     2241   define variable v-is-tpsi-obj as logical no-undo .
     2242   define buffer buf_clients for ub.clients.
     2243     do
     2244     on error undo, return error return-value
     2245     :
     2246       for each temp-tpsi-clients :
     2247         delete temp-tpsi-clients.
     2248       end.
     2249       _clients:
     2250       for each buf_clients no-lock where
     2251             buf_clients.db-num = p-db-num:
     2252         assign
     2253         v-is-tpsi-obj = no.
     2254         run gbl/tpsi-obj.p (
     2255                         input buf_clients.obj-type
     2256                       ,input buf_clients.obj-code
     2257                       ,output v-is-tpsi-obj) .
     2258         if not v-is-tpsi-obj then NEXT _clients.
     2259         create temp-tpsi-clients.
     2260         buffer-copy
     2261         buf_clients to
     2262         temp-tpsi-clients.
     2263       end.
     2264     end.
     2265   end procedure.
     2266   procedure tpsi-gds-proprietor :
     2267   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     2268   define input parameter p-db-num   like ub.db.db-num      no-undo .
     2269   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     2270   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     2271   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     2272   define variable v-is-tpsi-obj as logical no-undo .
     2273   do
     2274   on error undo, return error return-value
     2275   :
     2276       define buffer buf_clients for ub.clients.
     2277       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     2278       assign
     2279       p-proprietor-obj-type = "":U
     2280       p-proprietor-obj-code = ?
     2281       p-proprietor-host-code = ?
     2282       .
     2283       _gds-obj-attr:
     2284       for each buf_clients no-lock where
     2285               buf_clients.db-num = p-db-num,
     2286         each buf_gds-obj-attr no-lock where
     2287             buf_gds-obj-attr.obj-type = buf_Clients.obj-type
     2288         AND buf_gds-obj-attr.obj-code = buf_clients.obj-code
     2289         AND buf_gds-obj-attr.gds-code = p-gds-code
     2290         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     2291         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     2292           assign
     2293           v-is-tpsi-obj = no.
     2294           run gbl/tpsi-obj.p (
     2295                           input buf_gds-obj-attr.obj-type
     2296                         ,input buf_gds-obj-attr.obj-code
     2297                         ,output v-is-tpsi-obj) .
     2298           if not v-is-tpsi-obj then NEXT _gds-obj-attr.
     2299           assign
     2300           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     2301           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     2302           p-proprietor-host-code = buf_clients.host-code
     2303           .
     2304           LEAVE.
     2305         end.
     2306       end.
     2307   end.
     2308   end procedure.
     2309   procedure tpsi-preselect-gds-proprietor :
     2310   define input parameter p-gds-code like ub.goods.gds-code no-undo .
     2311   define input parameter p-db-num   like ub.db.db-num      no-undo .
     2312   define output parameter p-proprietor-host-code like ub.clients.host-code no-undo .
     2313   define output parameter p-proprietor-obj-type like ub.clients.obj-type no-undo .
     2314   define output parameter p-proprietor-obj-code like ub.clients.obj-code no-undo .
     2315   do
     2316   on error undo, return error return-value
     2317   :
     2318       define buffer buf_clients for ub.clients.
     2319       define buffer buf_gds-obj-attr for ub.gds-obj-attr.
     2320       assign
     2321       p-proprietor-obj-type = "":U
     2322       p-proprietor-obj-code = ?
     2323       p-proprietor-host-code = ?
     2324       .
     2325       _gds-obj-attr:
     2326       for each temp-tpsi-clients no-lock where
     2327               temp-tpsi-clients.db-num = p-db-num,
     2328         each buf_gds-obj-attr no-lock where
     2329             buf_gds-obj-attr.obj-type = temp-tpsi-clients.obj-type
     2330         AND buf_gds-obj-attr.obj-code = temp-tpsi-clients.obj-code
     2331         AND buf_gds-obj-attr.gds-code = p-gds-code
     2332         AND buf_gds-obj-attr.attr-code = 'proprietor':U:
     2333         if logical(buf_gds-obj-attr.attr-value) = yes then do:
     2334           assign
     2335           p-proprietor-obj-type = buf_gds-obj-attr.obj-type
     2336           p-proprietor-obj-code = buf_gds-obj-attr.obj-code
     2337           p-proprietor-host-code = temp-tpsi-clients.host-code
     2338           .
     2339           LEAVE.
     2340         end.
     2341       end.
     2342   end.
     2343   end procedure.
     2344   define temp-table temp-font no-undo
     2345     field fontnum  as integer
     2346     field fontname as character
     2347     field fontsize as character
     2348     field fonttype as character
     2349     field font-h   as integer
     2350     field font-w   as integer
     2351     field v-row    as integer
     2352     field v-col    as integer
     2353     field v-row-lans as integer
     2354     field v-col-lans as integer
     2355   index pi fontnum
     2356   .
     2357   procedure get-font-ini :
     2358     do
     2359     on error undo, return error return-value
     2360     :
     2361   define variable ii as integer   no-undo .
     2362   define variable v-font7 as character no-undo .
     2363   define variable v-font as character no-undo .
     2364   define variable loc-name as character no-undo .
     2365   define variable loc-size as character no-undo .
     2366   define variable loc-type as character no-undo .
     2367   define variable old_H as integer   no-undo .
     2368   define variable old_w as integer   no-undo .
     2369   define variable old-row  as integer   no-undo .
     2370   define variable old-col  as integer   no-undo .
     2371   define variable old-row-lans  as integer   no-undo .
     2372   define variable old-col-lans  as integer   no-undo .
     2373   define variable vv as integer   no-undo .
     2374   empty temp-table temp-font.
     2375     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     2376       case num-entries (v-font7) :
     2377         when 4 then do:
     2378             assign
     2379               loc-name = entry ( 1 , v-font7 )
     2380               loc-size = entry ( 2 , v-font7 )
     2381               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     2382             .
     2383         end.
     2384         when 3 then do:
     2385             assign
     2386               loc-name = entry ( 1 , v-font7 )
     2387               loc-size = entry ( 2 , v-font7 )
     2388               loc-type = entry ( 3 , v-font7 )
     2389             .
     2390         end.
     2391         when 2 then  do:
     2392             assign
     2393               loc-name = entry ( 1 , v-font7 )
     2394               loc-size = entry ( 2 , v-font7 )
     2395               loc-type = ""
     2396             .
     2397         end.
     2398         when 1 then do:
     2399             assign
     2400               loc-name = trim(entry ( 1 , v-font7 ))
     2401               loc-size = ""
     2402               loc-type = ""
     2403             .
     2404         end.
     2405       end case.
     2406     create temp-font.
     2407     assign
     2408       temp-font.fontnum  = 7
     2409       temp-font.fontname = trim(loc-name)
     2410       temp-font.fontsize = trim(loc-size)
     2411       temp-font.fonttype = trim(loc-type)
     2412       temp-font.v-row    = 62
     2413       temp-font.v-col    = 136
     2414       temp-font.v-row-lans = 43
     2415       temp-font.v-col-lans = 198
     2416     .
     2417     repeat ii = 16 to 100 :
     2418       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     2419       if v-font = "" or v-font = ? then leave.
     2420       case num-entries (v-font) :
     2421         when 4 then do:
     2422             assign
     2423               loc-name = entry ( 1 , v-font )
     2424               loc-size = entry ( 2 , v-font )
     2425               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     2426             .
     2427         end.
     2428         when 3 then do:
     2429             assign
     2430               loc-name = entry ( 1 , v-font )
     2431               loc-size = entry ( 2 , v-font )
     2432               loc-type = entry ( 3 , v-font )
     2433             .
     2434         end.
     2435         when 2 then do:
     2436             assign
     2437               loc-name = entry ( 1 , v-font )
     2438               loc-size = entry ( 2 , v-font )
     2439               loc-type = ""
     2440             .
     2441         end.
     2442         when 1 then do:
     2443             assign
     2444               loc-name = trim(entry ( 1 , v-font ))
     2445               loc-size = ""
     2446               loc-type = ""
     2447             .
     2448         end.
     2449       end case.
     2450     create temp-font.
     2451     assign
     2452       temp-font.fontnum  = ii
     2453       temp-font.fontname = trim(loc-name)
     2454       temp-font.fontsize = trim(loc-size)
     2455       temp-font.fonttype = trim(loc-type)
     2456     .
     2457     end.
     2458       for each temp-font :
     2459          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     2460          if  vv = ? then vv =  0 .
     2461           run rep/exfont.p (
     2462             input   temp-font.fontname ,
     2463             input   vv ,
     2464             input   temp-font.fonttype ,
     2465             output  temp-font.font-h   ,
     2466             output  temp-font.font-w   )
     2467           .
     2468       end.
     2469   find first temp-font where  temp-font.fontnum  = 7  .
     2470   old_H = temp-font.font-H .
     2471   old_w = temp-font.font-W .
     2472   old-row = temp-font.v-row .
     2473   old-col = temp-font.v-col .
     2474   old-row-lans = temp-font.v-row-lans .
     2475   old-col-lans = temp-font.v-col-lans .
     2476       for each temp-font where
     2477                temp-font.fontnum  <> 7 :
     2478           assign
     2479               temp-font.v-row    = old_H * old-row / temp-font.font-h
     2480               temp-font.v-col    = old_W * old-col / temp-font.font-W
     2481               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     2482               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     2483           .
     2484       end.
     2485     end.
     2486   end procedure.
     2487   PROCEDURE How-name :
     2488   define input  parameter h as integer no-undo .
     2489   define input  parameter w as integer no-undo .
     2490   define output parameter n as character  no-undo .
     2491   define variable A4port-H as integer   no-undo init 63.
     2492   define variable A4port-W as integer   no-undo init 136.
     2493   define variable A4lans-H as integer   no-undo init 43.
     2494   define variable A4lans-W as integer   no-undo init 198.
     2495   define variable Strim-W  as integer   no-undo init 278.
     2496   run define-a4-size (
     2497        input ReportFontNum
     2498       ,output A4port-H
     2499       ,output A4port-W
     2500       ,output A4lans-H
     2501       ,output A4lans-W ).
     2502   If w >= 1 and w <= A4port-W Then DO:
     2503     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2504     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     2505     If h > A4port-H              Then n = "to-file":U.
     2506   End.
     2507   If w > A4port-W and w <= A4lans-W Then DO:
     2508     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     2509     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2510     If h > A4port-H              Then n = "to-file":U.
     2511   End.
     2512   If w > A4lans-W and w <= Strim-W Then DO:
     2513     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     2514     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     2515     If h > A4port-H              Then n = "to-file":U.
     2516   End.
     2517   If w > Strim-W Then DO:
     2518      n = "to-file":U.
     2519   End.
     2520   END PROCEDURE.
     2521   PROCEDURE define-a4-size :
     2522   define input  parameter p-ReportFontNum as integer   no-undo .
     2523   define output parameter A4port-H as integer   no-undo .
     2524   define output parameter A4port-W as integer   no-undo .
     2525   define output parameter A4lans-H as integer   no-undo .
     2526   define output parameter A4lans-W as integer   no-undo .
     2527   if not can-find (first temp-font ) then do:
     2528      run get-font-ini .
     2529   end.
     2530   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     2531   if available temp-font then do:
     2532   assign
     2533     A4port-H = temp-font.v-row
     2534     A4port-W = temp-font.v-col
     2535     A4lans-H = temp-font.v-row-lans
     2536     A4lans-W = temp-font.v-col-lans
     2537   .
     2538   end.
     2539   else do:
     2540   assign
     2541     A4port-H = 63
     2542     A4port-W = 136
     2543     A4lans-H = 43
     2544     A4lans-W = 198
     2545   .
     2546   end.
     2547   END PROCEDURE.
