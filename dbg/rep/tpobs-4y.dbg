     3875               assign gds-zap-gds-name = goods.engl-name.
     3876           else
     3877               assign gds-zap-gds-name = goods.gds-name.
     3878        end.
     3879        if par-4 = "gds-list":u  then do:
     3880           assign
     3881               gds-zap-unit-base  = gds-list.unit-base
     3882               gds-zap-prt-root   = gds-list.prt-root
