     1231   procedure aht_get-sum-type :
     1232     define input  parameter p-aht-type        as character no-undo .
     1233     define output parameter p-allsum-sum-type as character no-undo .
     1234     do
     1235     on error undo, return error return-value
     1236     :
     1237       case p-aht-type :
     1238         when 'r':U then do:
     1239           assign
     1240             p-allsum-sum-type = 'сумма_по_выкупу_со_знаком':U
     1241           .
     1242         end.
     1243         when 'c':U then do:
     1244           assign
     1245             p-allsum-sum-type = 'сумма_по_консигнации_закупка_со_знаком':U
     1246           .
     1247         end.
     1248         when 'b':U then do:
     1249           assign
     1250             p-allsum-sum-type = 'сумма_по_консигнации_выгода_со_знаком':U
     1251           .
     1252         end.
     1253         when 's':U then do:
     1254           assign
     1255             p-allsum-sum-type = 'сумма_по_ответственному_хранению_со_знаком':U
     1256           .
     1257         end.
     1258         when 'o':U then do:
     1259           assign
     1260             p-allsum-sum-type = 'сумма_по_старой_консигнации_со_знаком':U
     1261           .
     1262         end.
     1263         when 'v':U then do:
     1264           assign
     1265             p-allsum-sum-type = 'сумма_по_услуге_со_знаком':U
     1266           .
     1267         end.
     1268         otherwise do:
     1269           message
     1270             vss-workfile vss-revision vss-description skip
     1271             vss-include-info17 skip
     1272             "Неизвестное значение типа приобретения" skip
     1273             "Тип приобретения" p-aht-type skip
     1274             view-as alert-box error .
     1275           undo, return error .
     1276         end.
     1277       end.
     1278     end.
     1279   end procedure.
     1280   procedure aht_get-stk-sum-type :
