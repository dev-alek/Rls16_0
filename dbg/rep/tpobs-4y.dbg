     3891           else
     3892               assign gds-zap-gds-name = gds-list.gds-name.
     3893        end.
     3894       define variable old-gds-zap-gds-name as character no-undo .
     3895       old-gds-zap-gds-name = gds-zap-gds-name.
     3896       x-type-pr = "r".
     3897       run foreach.
     3898   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3899     (input  gds-zap-b-code
     3900     ,input  ?
     3901     ,output v-bar-code
     3902     )  .
     3903   s-bar-code = string (v-bar-code,"999999999").
     3904       If  break_group = true  and par-3 <> "1"  then DO :
     3905            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     3906            gds-zap-prod-name  = clients.obj-name.
     3907             If break_group1 = true  THEN  DO :
     3908               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     3909                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     3910                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     3911               if par-3 = "6"  then  dO:
     3912                  if xTog-obj = true then do:
     3913                    var-vat-pc = func-vat (input gds-zap-b-code , input x-store-type, input x-store-code)
     3914                     .
     3915                   end.
     3916                  else do:
     3917                   var-vat-pc = temp-gds-list.vat-pc .
     3918                   end.
     3919                   assign
     3920                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     3921                       b1-name = temp-str.
     3922                   end.
     3923               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     3924                   fr0 = true .
     3925                   tmp#stroka0 = temp-str.
     3926               End.
     3927             End.
     3928               IF (par-3 = "4"  OR  par-3 = "5")  THEN DO:
     3929                 if par-3 = "4"
     3930                   then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name .
     3931                   else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name.
     3932                 if NOT xSumsOnly THEN DO:
     3933                     fr = true .
     3934                 End.
     3935                 break_group1 = false.
     3936               END.
     3937          break_group = false.
     3938       End.
     3939       gds-zap-gds-name = string(old-gds-zap-gds-name,"x(28)") + "|" + "Выкуп".
