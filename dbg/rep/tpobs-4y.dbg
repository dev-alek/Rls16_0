     3722           if xshowcrsa    then do: run di ("прод.", 15 ,"","", "", "", "b2":u).  end.
     3723           if xshowsale    then do: run di ("док.", 18 ,"","", "", "", "b2":u).  end.
     3724            if vat-cost    then do: run di ( "уч.НДС", 13,"","","","","b2":u ). end.
     3725            if vat-crsa    then do: run di ( "пр.НДС", 16,"","","","","b2":u ).  end.
     3726            if vat-sale    then do: run di ( "дк.НДС", 19,"","","","","b2":u ).  end.
     3727      end.
     3728    end.
     3729   end.
     3730   end procedure.
