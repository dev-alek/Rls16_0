     1111   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1112   procedure paramls-clear :
     1113     define buffer buf_temp-param for temp-param .
     1114     do
     1115     on error undo, return error return-value
     1116     :
     1117       for each buf_temp-param
     1118       on error undo, return error
     1119       :
     1120         delete buf_temp-param .
     1121       end.
     1122     end.
     1123   end procedure.
     1124   procedure paramls-write :
     1125     define input  parameter p-code     as character no-undo .
     1126     define input  parameter p-sub-code as character no-undo .
     1127     define input  parameter p-value    as character no-undo .
     1128     define buffer buf_temp-param for temp-param .
     1129     do
     1130     on error undo, return error return-value
     1131     :
     1132       find first buf_temp-param
     1133         where buf_temp-param.param-code     = p-code
     1134           and buf_temp-param.param-sub-code = p-sub-code
     1135         no-error .
     1136       if not available buf_temp-param then do:
     1137         create buf_temp-param .
     1138         assign
     1139           buf_temp-param.param-code     = p-code
     1140           buf_temp-param.param-sub-code = p-sub-code
     1141         .
     1142       end.
     1143       assign
     1144         buf_temp-param.param-value = p-value
     1145       .
     1146     end.
     1147   end procedure.
     1148   procedure paramls-read :
     1149     define input  parameter p-code          as character no-undo .
     1150     define input  parameter p-sub-code      as character no-undo .
     1151     define input  parameter p-default-value as character no-undo .
     1152     define output parameter p-value         as character no-undo .
     1153     define buffer buf_temp-param for temp-param .
     1154     do
     1155     on error undo, return error return-value
     1156     :
     1157       find first buf_temp-param
     1158         where buf_temp-param.param-code     = p-code
     1159           and buf_temp-param.param-sub-code = p-sub-code
     1160         no-error .
     1161       if available buf_temp-param then do:
     1162         assign
     1163           p-value = buf_temp-param.param-value
     1164         .
     1165       end.
     1166       else do:
     1167         assign
     1168           p-value = p-default-value
     1169         .
     1170       end.
     1171     end.
     1172   end procedure.
     1173   procedure paramls-append :
     1174     define input  parameter p-code     as character no-undo .
     1175     define input  parameter p-sub-code as character no-undo .
     1176     define input  parameter p-value    as character no-undo .
     1177     define buffer buf_temp-param for temp-param .
     1178     do
     1179     on error undo, return error return-value
     1180     :
     1181       find first buf_temp-param
     1182            where buf_temp-param.param-code     = p-code
     1183              and buf_temp-param.param-sub-code = p-sub-code
     1184         no-error .
     1185       if not available buf_temp-param then do:
     1186         create buf_temp-param .
     1187         assign
     1188           buf_temp-param.param-code     = p-code
     1189           buf_temp-param.param-sub-code = p-sub-code
     1190           buf_temp-param.param-value    = p-value
     1191         .
     1192       end.
     1193       else do:
     1194           assign
     1195               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1196           .
     1197       end.
     1198     end.
     1199   end procedure.
