      497     then DO:
      498         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      499         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      500         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
      501     end.
      502     mFrameView = not session:batch-mode and mFramHandle:visible.
      503     if mFrameView
      504     then do:
      505       ASSIGN
      506          FRAME InfoFrame:HIDDEN                           = TRUE
      507          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
      508     end.
      509   ON CHOOSE OF StopBtn IN FRAME InfoFrame
      510   DO:
      511     IF not StopProcessing THEN
      512       Message "Вы действительно хотите прервать" SKIP
      513               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
      514                 UPDATE StopProcessing.
      515     IF StopProcessing THEN do:
      516        if mFrameView
      517        then do:
      518           HIDE FRAME InfoFrame.
      519        end.
      520     End.
      521   END.
      522   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
      523     if  log-manager:logfile-name ne ?
      524     then DO:
      525         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
      526     end.
      527     if not session:batch-mode then
      528     do:
      529       VIEW FRAME InfoFrame.
      530       mFrameView = true.
      531     end.
      532      v-button-stop = false .
      533         if mFrameView
      534         then do:
      535         if v-button-stop then view STOPBTN in frame InfoFrame.
      536                          else Hide STOPBTN in frame InfoFrame.
      537         end.
      538    run make-tt in this-procedure .
      539       if sort-group = yes then do:
      540         for each temp-str no-lock break by temp-str.grp-name by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
      541           if first-of( temp-str.grp-name) then run print-grp in this-procedure .
      542           run print-line in this-procedure .
      543           if last-of( temp-str.grp-name ) then  run print-grp-itog in this-procedure .
      544         end.
      545       end.
      546       else do:
      547         for each temp-str no-lock break by if sort-name then  temp-str.gds-name Else string(temp-str.np,"999999999") :
      548           run print-line in this-procedure .
      549         end.
      550       end.
      551     run on-same-page in this-procedure (input 5) .
      552     run print-all-itog in this-procedure .
      553     run PrintPodval in this-procedure .
      554     HIDE stream Out-Stream FRAME plan-menu .
      555     HIDE stream Out-Stream FRAME BottomFrame .
      556     HIDE stream Out-Stream FRAME BottomFrame2 .
      557     output stream Out-Stream CLOSE .
      558   if mFrameView
      559   then do:
      560      HIDE FRAME InfoFrame.
      561   end.
      562   if g#quest-print = false
      563   then do:
      564     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      565                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      566                                         OUTPUT g#log ).
      567   end.
      568   else do:
      569     os-command silent
      570       value( "COPY /b " +
      571         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      572         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      573         string( session:temp-directory) +  "$" + string( g#report-num )
      574                 ) .
      575     os-command silent
      576       value( "COPY /b " +
      577         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      578         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      579         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      580                 ) .
      581   end.
      582   end.
      583   procedure print-grp :
      584     do  on error undo, return error return-value  :
      585       DOWN stream Out-Stream 1 with FRAME plan-menu .
      586       PUT stream Out-Stream UNFORMATTED String("_______________" + TRIM(CAPS(temp-str.grp-name)) + UndLine)  FORMAT "x(132)"  skip  .
      587     end.
      588   end procedure.
      589   procedure print-line :
      590     do on error undo, return error return-value :
      591     assign
      592        Lines_Counter = Lines_Counter + 1
      593        summ = summ  + temp-str.stoim
      594       .
      595     if line-counter( out-stream ) + 2 > page-size( out-stream ) then page stream out-stream.
      596     if line-counter( Out-Stream ) < Tmp_Counter then
      597       assign
      598       .
      599     assign
      600       Tmp_Counter  = line-counter( Out-Stream )
      601       num-ln = num-ln + 1
      602     .
      603     FullNameGds = temp-str.gds-name .
      604     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
      605     assign j = 0.
      606     DO WHILE gds-str2 <> "" :
      607       assign gds-str = gds-str2.
      608       gds-str1 = breakstr(gds-str, 40, input-output gds-str1, input-output gds-str2).
      609       assign j = j + 1.
      610     END.
      611     if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then  PAGE STREAM Out-Stream.
      612     gds-str1 = breakstr(FullNameGds, 40, input-output  gds-str1, input-output gds-str2).
      613     display stream Out-Stream
      614       sym1     num-ln @ Lines_Counter
      615       sym2     temp-str.gds-name
      616       sym3     temp-str.b-code
      617       sym4     temp-str.qnty
      618       sym5     temp-str.stoim
      619       sym6     temp-str.price
      620       sym7     sym8 sym9 sym10
      621       temp-str.norma
      622       temp-str.num-rcp
      623       temp-str.p-inp
      624       with FRAME plan-menu.
      625       DOWN stream Out-Stream 1 with FRAME plan-menu.
      626     end.
      627   end procedure.
      628   procedure print-grp-itog :
      629     do on error undo, return error return-value :
      630     end.
      631   end procedure.
      632   procedure print-all-itog :
      633     underline stream Out-Stream
      634       sym1     Lines_Counter
      635       sym2     temp-str.gds-name
      636       sym3     temp-str.b-code
      637       sym4     temp-str.qnty
      638       sym5     temp-str.stoim
      639       sym6     temp-str.price
      640       sym7     sym8 sym9 sym10
      641       temp-str.norma
      642       temp-str.num-rcp
      643       temp-str.p-inp
      644       with FRAME plan-menu.
      645     DOWN stream Out-Stream 1 with FRAME plan-menu.
      646         PUT STREAM Out-Stream "Итого  " +   string(summ , "->>>,>>>,>>9.99") + ":" format "X(23)"  at 110 skip.
      647     underline stream Out-Stream
      648               sym9
      649               sym10
      650               temp-str.stoim
      651       with FRAME plan-menu.
      652     DOWN stream Out-Stream 1 with FRAME plan-menu.
      653   end procedure.
      654   procedure PrintTitul :
      655     do  on error undo, return error return-value  :
      656       case clients.obj-type:
      657          when 'орг':U
      658          then do:
      659               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
      660               if available ub.firm
      661               then do:
      662                   assign
      663                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
      664                       t-addres = t-addres
      665                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
      666                               then ""
      667                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
      668                             )
      669                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
      670                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      671                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      672                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
      673                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
      674                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      675                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      676                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
      677                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
      678                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
      679                       t-phone = ub.firm.phone
      680                       t-inn   = ub.firm.inn
      681                       t-okpo  = ub.firm.okpo
      682                   .
      683               end.
      684          end.
      685          when 'маг':U
      686          then do:
      687               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
      688               if available ub.shop
      689               then do:
      690                   assign
      691                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
      692                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
      693                       t-phone = shop.phone
      694                       t-inn = ""
      695                       t-okpo = ""
      696                   .
      697               end.
      698          end.
      699          when 'скл':U
      700          then do:
      701               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
      702               if available ub.store
      703               then do:
      704                   assign
      705                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
      706                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
      707                       t-phone = ub.store.phone
      708                       t-inn = ""
      709                       t-okpo = ""
      710                   .
      711               end.
      712          end.
      713          when 'чел':U
      714          then do:
      715               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
      716               if available ub.person
      717               then do:
      718                   assign
      719                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
      720                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
      721                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
      722                       t-phone = ub.person.phone1
      723                       t-inn = ub.person.inn
      724                       t-okpo = ub.person.okpo
      725                   .
      726               end.
      727          end.
      728       end case.
      729         PUT STREAM Out-Stream
      730           space(5) "Унифицированная форма № ОП-2"  AT 5
      731           space(5) Line format  "X(19)" AT 117 skip
      732           space(5) "| "                 AT 117 'код':U AT 125 "|" AT 135 skip
      733           space(5) "Форма по ОКУД" format "X(14)" AT 103 "| " AT 117 "0330502" "|" AT 135 skip
      734           space(5) string( "ИНН " + t-inn + " " + CAPS( clients.obj-name ) + " (" + string(clients.obj-code) + ")"
      735                                 + t-addres + t-phone) format "X(60)"
      736               "по ОКПО" format "X(7)"  AT 109
      737                                   "| " AT 117
      738             t-okpo format "X(16)" "|"  AT 135 skip
      739           space(5) string( CAPS( This_Object.obj-name ) + " (" + string(This_Object.obj-code) + ")" ) format "X(60)"
      740           "| " AT 117  "|" AT 135 skip
      741           space(5) "Вид деятельности по ОКДП" format "X(25)" AT 92 "| " AT 117 "|" AT 135 skip
      742                          "Вид операции" format "X(12)" AT 102       "| " AT 117 "|" AT 135 skip
      743                                                                     "| " AT 117 "|" AT 135 skip
      744           space(5)  Line format  "X(19)" AT 117 skip
      745           space(87) "УТВЕРЖДАЮ" format "X(9)"               AT 87  skip
      746           space(87) "______________________" format "X(20)" AT 87  skip
      747           space(87) "______________________" format "X(20)" AT 87 "/___________________/" AT 109 SKIP
      748           space(87) "подпись"                               AT 87 "расшифровка подписи"   AT 109 SKIP
      749           space(65) Line format "X(50)" skip
      750           space(54) string( "ПЛАН-МЕНЮ | "
      751                                       + string( tdoc-code , "X(16)") + " | "
      752                                       + string( tdoc-date, "99/99/9999")
      753                                       + " | "  + (if fbr-pln.status_ <> 'факт':U then string( "(" + CAPS(fbr-pln.status_) + ")" ) else "")
      754                                       ) format "X(60)" skip
      755            space(65) Line format "X(50)" skip .
      756         .
      757     end.
      758   end procedure.
      759   procedure PrintPodval :
      760     do on error undo, return error return-value  :
      761     PUT  STREAM Out-Stream " "   skip
      762   LineBuf format "X(25)" AT 10 LineBuf format "X(25)"   AT 40 LineBuf format "X(50)"               AT 70 SKIP
      763   "должность" format "X(25)" AT 10 "подпись" format "X(25)" AT 40 "расшифровка подписи" format "X(50)" AT 70 SKIP
      764   "<<       >> _________________        г. "
      765         .
      766     end.
      767   end procedure.
      768   PROCEDURE on-same-page :
      769     define input parameter p-line-number as integer  no-undo .
      770     if p-line-number > page-size( Out-Stream ) then return .
      771     if line-counter( Out-Stream ) + p-line-number > page-size( Out-Stream ) then  page stream Out-Stream .
      772   end procedure.
      773   procedure make-tt :
      774     do
      775     on error undo, return error return-value
      776     :
      777   define buffer buf_fbr-pln-line for fbr-pln-line .
      778   define buffer buf_recipe for recipe .
      779   define buffer buf_goods  for goods .
      780   define variable v-cur-dn as character no-undo .
      781   define variable v-cur-pr as decimal no-undo .
      782   define variable v-cur-rt as decimal no-undo .
      783   define variable v-cur-ex as decimal no-undo .
      784   define variable v-bar-code like bar-code.b-code no-undo .
      785    for each  buf_fbr-pln-line no-lock where buf_fbr-pln-line.doc-code = fbr-pln.doc-code
      786                                       break by  buf_fbr-pln-line.line-num :
      787     find first buf_recipe  where buf_recipe.recipe-code = buf_fbr-pln-line.recipe-code  no-lock  .
      788     find first buf_goods   where buf_goods.gds-code = buf_fbr-pln-line.gds-code         no-lock  .
      789   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      790     (input  buf_goods.gds-code
      791     ,input  ?
      792     ,output v-bar-code
      793     )  .
      794   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
      796     (input  buf_fbr-pln-line.obj-type
      797     ,input  buf_fbr-pln-line.obj-code
      798     ,input  v-bar-code
      799     ,input  0
      800     ,input  0
      801     ,output v-cur-dn
      802     ,output v-cur-pr
      803     ,output v-cur-rt
      804     ,output v-cur-ex
      805     )  .
      806     define variable v-grp-fbr-name as character no-undo .
      807     find first fbr-gds-obj no-lock where
      808                fbr-gds-obj.gds-code = buf_goods.gds-code and
      809                fbr-gds-obj.obj-code = buf_fbr-pln-line.obj-code and
      810                fbr-gds-obj.obj-type = buf_fbr-pln-line.obj-type
      811                no-error .
      812     if error-status :error then v-grp-fbr-name = "Блюдо и гарнир" .
      813     find first fbr-gds-grp no-lock where fbr-gds-grp.node-code = fbr-gds-obj.fbr-grp-code and
      814                                          fbr-gds-grp.obj-code = fbr-gds-obj.obj-code     and
      815                                          fbr-gds-grp.obj-type = fbr-gds-obj.obj-type    no-error .
      816     if available fbr-gds-grp then v-grp-fbr-name = fbr-gds-grp.node-name .
      817     else do:
      818       v-grp-fbr-name = "Блюдо и гарнир" .
      819     end.
      820     create temp-str .
      821     assign
      822       temp-str.np         = buf_fbr-pln-line.line-num
      823       temp-str.grp-name   = v-grp-fbr-name
      824       temp-str.gds-name   = buf_goods.gds-name
      825       temp-str.b-code     = string(v-bar-code)
      826       temp-str.p-inp      = if buf_recipe.portion-qnty <> 0 and buf_recipe.portion-qnty <> ? then  buf_recipe.qnty / buf_recipe.portion-qnty else 0
      827       temp-str.norma      = temp-str.p-inp
      828       temp-str.num-rcp    = string(buf_recipe.recipe-ref-num)
      829       temp-str.qnty       = buf_fbr-pln-line.fact-qnty
      830       temp-str.price      = if v-cur-pr = ? then 0 else v-cur-pr
      831       temp-str.stoim      = temp-str.qnty  * temp-str.price
      832       .
      833     end.
      834     end.
      835    end procedure.
