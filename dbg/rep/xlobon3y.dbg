     4947   procedure ex-display :
     4948   define input parameter par-1 as int no-undo.
     4949   define input parameter par-2 like  ostatok-start[1] no-undo.
     4950   define input parameter par-i as int no-undo.
     4951     assign num#col#  = par-1.
     4952     if par-i = 13 then do:
     4953       run macr_excel_dec ( round (par-2 ,4)  , num#str# , num#col#   ).
     4954     end.
     4955     else do:
     4956       if par-i = 1 or par-i = 11 or par-i = 12 then do :
     4957         run macr_excel_dec ( round (par-2 ,3)  , num#str# , num#col#   ).
     4958       end.
     4959       else do :
     4960         run macr_excel_dec ( round (par-2 ,2)  , num#str# , num#col#   ).
     4961       end.
     4962     end.
     4963   end procedure.
     4964   procedure u-line:
     4965   end procedure.
     4966   procedure p-line:
     4967   end procedure.
     4968   procedure make-col :
     4969    define variable l#1 as int  no-undo.
     4970    define variable l#2 as int  no-undo.
     4971    define variable l as int  no-undo.
     4972     assign
     4973       nk = 0
     4974       kk = 0
     4975     .
     4976     if xshowcost     then do: kk = kk + 1. end.
     4977     if xshowcostnds  then do: kk = kk + 1. end.
     4978     if xshowcrsa     then do: kk = kk + 1. end.
     4979     if xshowcrsands  then do: kk = kk + 1. end.
     4980     if xshowsale     then do: kk = kk + 1. end.
     4981     if xshowsalends  then do: kk = kk + 1. end.
     4982     if xshowsaleslt  then do: kk = kk + 1. end.
     4983     if xshowmediator then do: kk = kk + 1. end.
     4984     if x-tog-wt      then do: kk = kk + 1. end.
     4985     if x-tog-ms      then do: kk = kk + 1. end.
     4986     if xDens         then do: kk = kk + 1. end.
     4987    assign
     4988     num#str# = num#str# + 1
     4989     num#col#  = 0
     4990    .
     4991    if use-column[28] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "№ "              , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4992    if use-column[1]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Код "            , num#str# , num#col# ) . run macr_cell_size (10, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4993    if use-column[2]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Артикул"         , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4994    if use-column[3]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Название товара" , num#str# , num#col# ) . run macr_cell_size (60, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4995    if use-column[4]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Ед.изм "         , num#str# , num#col# ) . run macr_cell_size (7 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4996    if use-column[5]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "т/у"             , num#str# , num#col# ) . run macr_cell_size (4 , ? , num#str# , num#col# , num#str# , num#col# ). end.
     4997    if use-column[21] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Скидка"          , num#str# , num#col# ) . run macr_cell_size (15, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4998    if use-column[23] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "Эффективность"   , num#str# , num#col# ) . run macr_cell_size (16, ? , num#str# , num#col# , num#str# , num#col# ). end.
     4999    if use-column[24] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format( "% наценки"       , num#str# , num#col# ) . run macr_cell_size (13, ? , num#str# , num#col# , num#str# , num#col# ). end.
     5000       mp = num#col#  + 1.
     5001       mp-1 = num#col#  .
     5002    if use-column[6]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на начало "               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5003    if use-column[7]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5004    if use-column[8]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5005    if use-column[9]  then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот приход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5006    if use-column[10] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход внешний"            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5007    if use-column[11] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход перемещение"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5008    if use-column[12] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот расход производство"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5009    if use-column[13] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  списание"                 , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5010    if use-column[14] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса продажа "            , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5011    if use-column[15] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот касса возврат"             , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5012    if use-column[16] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат внешний"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5013    if use-column[17] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат поставщику"        , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5014    if use-column[18] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот возврат перемещение"       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5015    if use-column[19] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  инвентаризация"           , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5016    if use-column[20] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Оборот  переоценка"               , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5017    if use-column[22] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Остаток на конец "                , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5018    if use-column[25] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('коррекция учетных цен':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5019    if use-column[26] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format('смена типа приобретения':U       , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5020    if use-column[27] then  do: assign num#col#  = num#col#  + 1 nk  = nk  + 1 . run macr_excel_char_with_format("Расход-Возврат"                   , num#str# , (num#col#  + (kk * (num#col#  - mp)) ))  .   end.
     5021       run macr_cell_size (16, ? , num#str# , mp, num#str# , (num#col#  + (kk * (num#col#  - mp)) + kk) ).
     5022      num#str# = num#str# + 1.
     5023      repeat l#1 = mp to nk :
     5024            l#2 = 0.
     5025                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "количество"  , num#str# , num#col#  ) .
     5026            if xshowcost    then do:
     5027                l#2 = l#2 + 1.
     5028                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн. сумма"  , num#str# , num#col#  ) .
     5029                end.
     5030            if xshowcostnds then do:
     5031                l#2 = l#2 + 1.
     5032                num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "учетн.НДС"  , num#str# , num#col#  ) .
     5033               end.
     5034            if xshowmediator then do:
     5035               l#2 = l#2 + 1.
     5036               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "цены поср."  , num#str# , num#col#  ) .
     5037               end.
     5038            if xshowcrsa    then do:
     5039               l#2 = l#2 + 1.
     5040               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж. сумма"  , num#str# , num#col#  ) .
     5041               end.
     5042            if xshowcrsands then do:
     5043               l#2 = l#2 + 1.
     5044               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "продаж.НДС"  , num#str# , num#col#  ) .
     5045               end.
     5046             if xshowsale    then do:
     5047               l#2 = l#2 + 1.
     5048               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док. сумма"  , num#str# , num#col#  ) .
     5049               end.
     5050            if xshowsalends then do:
     5051               l#2 = l#2 + 1.
     5052               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НДС"  , num#str# , num#col#  ) .
     5053               end.
     5054            if xshowsaleslt then do:
     5055               l#2 = l#2 + 1.
     5056               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2  . run macr_excel_char_with_format( "док.НсП"  , num#str# , num#col#  ) .
     5057            end.
     5058            if x-tog-wt then do:
     5059             assign
     5060               l#2 = l#2 + 1
     5061               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5062             .
     5063             run macr_excel_char_with_format( "вес"  , num#str# , num#col#  ) .
     5064            end.
     5065            if x-tog-ms then do:
     5066             assign
     5067               l#2 = l#2 + 1
     5068               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5069             .
     5070             run macr_excel_char_with_format( "объем"  , num#str# , num#col#  ) .
     5071            end.
     5072            if xDens then do:
     5073             assign
     5074               l#2 = l#2 + 1
     5075               num#col# =  l#1 +  (kk * (l#1 - mp))  + l#2
     5076             .
     5077             run macr_excel_char_with_format( "плотность"  , num#str# , num#col#  ) .
     5078            end.
     5079        end.
     5080   end procedure .
