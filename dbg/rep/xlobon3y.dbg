     4868   Procedure Null-str-pr :
     4869    if (
     4870        oborot-im                 [1] = 0 and
     4871        oborot-wm                 [1] = 0 and
     4872        oborot-em                 [1] = 0 and
     4873        oborot-ie                 [1] = 0 and
