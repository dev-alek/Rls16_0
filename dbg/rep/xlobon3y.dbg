     3799   procedure ob-line  :
     3800   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     3801   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     3802   define input  parameter x-artic          like ub.ot-line.artic        no-undo.
     3803   define input  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     3804   define input  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     3805   define input  parameter x-fact-order-1   like ub.ot-line.fact-order   no-undo.
     3806   define input  parameter x-fact-order-2   like ub.ot-line.fact-order   no-undo.
     3807   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     3808   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     3809   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     3810   define input  parameter xtog-obj           as log no-undo.
     3811   define variable  quantity#    like ub.ot-line.fact-qnty   no-undo.
     3812   define variable  coast_r#     like ub.ot-line.sum-rubl    no-undo.
     3813   define variable  coast_v#     like ub.ot-line.sum-rubl    no-undo.
     3814   define variable  vat_r#       like ub.ot-line.sum-rubl    no-undo.
     3815   define variable  vat_v#       like ub.ot-line.sum-rubl    no-undo.
     3816   define variable  slt_r#       like ub.ot-line.sum-rubl    no-undo.
     3817   define variable  slt_v#       like ub.ot-line.sum-rubl    no-undo.
     3818   define variable  v-summa  as decimal extent 4 no-undo .
     3819   define variable  tt#          as int no-undo.
     3820   define variable v-ii as integer no-undo .
     3821   define variable slt  as decimal no-undo .
     3822   define variable disc  as decimal no-undo .
     3823   define variable xi as integer no-undo .
     3824   define variable v-tt as integer no-undo .
     3825    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then assign tt# = 0 v-tt = 0.
     3826       else
     3827       if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then assign tt# = 3  v-tt = 100.
     3828       else
     3829       assign tt# = 6  v-tt = 200.
     3830     if long-p = false then do :
     3831     for each obj-list no-lock:
     3832      if  xtog-obj then
     3833          if   not(x-store-type     = obj-list.obj-type
     3834               and x-store-code    = obj-list.obj-code ) then next.
     3835           for each ub.ot-line where
     3836                     ub.ot-line.artic         = x-artic
     3837               and   ub.ot-line.prod-code    = x-prod-code
     3838               and   ub.ot-line.prod-type    = x-prod-type
     3839               and   ub.ot-line.fact-order   <= x-fact-order-2
     3840               and   ub.ot-line.fact-order   >= x-fact-order-1
     3841               and   ub.ot-line.obj-code     = obj-list.obj-code
     3842               and   ub.ot-line.obj-type     = obj-list.obj-type
     3843               and   ub.ot-line.sum-type     = x-sum-type
     3844               no-lock :
     3845               case ub.ot-line.ext-doc-type:
     3846     WHEN 'ie':U THEN DO:
     3847       ASSIGN oborot-ie[1 + tt#]   = oborot-ie[1 + tt#]   +  ub.ot-line.fact-qnty
     3848             oborot-ie[2 + tt#]   = oborot-ie[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3849             oborot-ie[3 + tt#]   = oborot-ie[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3850         if tt# = 6 Then   assign
     3851             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3852             oborot-ie[10]   = oborot-ie[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3853             End.
     3854     WHEN 'ee':U THEN DO:
     3855       ASSIGN oborot-ee[1 + tt#]   = oborot-ee[1 + tt#]   +  ub.ot-line.fact-qnty
     3856             oborot-ee[2 + tt#]   = oborot-ee[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3857             oborot-ee[3 + tt#]   = oborot-ee[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3858         if tt# = 6 Then   assign
     3859             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3860             oborot-ee[10]   = oborot-ee[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3861             End.
     3862     WHEN 'ep':U THEN DO:
     3863       ASSIGN oborot-ep[1 + tt#]   = oborot-ep[1 + tt#]   +  ub.ot-line.fact-qnty
     3864             oborot-ep[2 + tt#]   = oborot-ep[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3865             oborot-ep[3 + tt#]   = oborot-ep[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3866         if tt# = 6 Then   assign
     3867             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3868             oborot-ep[10]   = oborot-ep[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3869             End.
     3870     WHEN 'es':U THEN DO:
     3871       ASSIGN oborot-es[1 + tt#]   = oborot-es[1 + tt#]   +  ub.ot-line.fact-qnty
     3872             oborot-es[2 + tt#]   = oborot-es[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3873             oborot-es[3 + tt#]   = oborot-es[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3874         if tt# = 6 Then   assign
     3875             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3876             oborot-es[10]   = oborot-es[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3877             End.
     3878     WHEN 're':U THEN DO:
     3879       ASSIGN oborot-re[1 + tt#]   = oborot-re[1 + tt#]   +  ub.ot-line.fact-qnty
     3880             oborot-re[2 + tt#]   = oborot-re[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3881             oborot-re[3 + tt#]   = oborot-re[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3882         if tt# = 6 Then   assign
     3883             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3884             oborot-re[10]   = oborot-re[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3885             End.
     3886     WHEN 'rs':U THEN DO:
     3887       ASSIGN oborot-rs[1 + tt#]   = oborot-rs[1 + tt#]   +  ub.ot-line.fact-qnty
     3888             oborot-rs[2 + tt#]   = oborot-rs[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3889             oborot-rs[3 + tt#]   = oborot-rs[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3890         if tt# = 6 Then   assign
     3891             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3892             oborot-rs[10]   = oborot-rs[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3893             End.
     3894     WHEN 'we':U THEN DO:
     3895       ASSIGN oborot-we[1 + tt#]   = oborot-we[1 + tt#]   +  ub.ot-line.fact-qnty
     3896             oborot-we[2 + tt#]   = oborot-we[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3897             oborot-we[3 + tt#]   = oborot-we[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3898         if tt# = 6 Then   assign
     3899             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3900             oborot-we[10]   = oborot-we[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3901             End.
     3902     WHEN 'vt':U  OR  WHEN 'mp':U OR WHEN 'vp':U THEN DO:
     3903       ASSIGN oborot-vt[1 + tt#]   = oborot-vt[1 + tt#]   +  ub.ot-line.fact-qnty
     3904             oborot-vt[2 + tt#]   = oborot-vt[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3905             oborot-vt[3 + tt#]   = oborot-vt[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3906           if tt# = 6 Then  assign
     3907             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3908             oborot-vt[10]   = oborot-vt[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3909             End.
     3910     WHEN 'iv':U THEN DO:
     3911       ASSIGN oborot-iv[1 + tt#]   = oborot-iv[1 + tt#]   +  ub.ot-line.fact-qnty
     3912             oborot-iv[2 + tt#]   = oborot-iv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3913             oborot-iv[3 + tt#]   = oborot-iv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3914         if tt# = 6 Then   assign
     3915             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3916             oborot-iv[10]   = oborot-iv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3917             End.
     3918     WHEN 'ev':U THEN DO:
     3919       ASSIGN oborot-ev[1 + tt#]   = oborot-ev[1 + tt#]   +  ub.ot-line.fact-qnty
     3920             oborot-ev[2 + tt#]   = oborot-ev[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3921             oborot-ev[3 + tt#]   = oborot-ev[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3922         if tt# = 6 Then   assign
     3923             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3924             oborot-ev[10]   = oborot-ev[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3925             End.
     3926     WHEN 'rv':U THEN DO:
     3927       ASSIGN oborot-rv[1 + tt#]   = oborot-rv[1 + tt#]   +  ub.ot-line.fact-qnty
     3928             oborot-rv[2 + tt#]   = oborot-rv[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3929             oborot-rv[3 + tt#]   = oborot-rv[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3930         if tt# = 6 Then   assign
     3931             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3932             oborot-rv[10]   = oborot-rv[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3933             End.
     3934     WHEN 'wm':U  OR  WHEN 'em':U THEN DO:
     3935       ASSIGN oborot-em[1 + tt#]   = oborot-em[1 + tt#]   +  ub.ot-line.fact-qnty
     3936             oborot-em[2 + tt#]   = oborot-em[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3937             oborot-em[3 + tt#]   = oborot-em[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3938           if tt# = 6 Then  assign
     3939             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3940             oborot-em[10]   = oborot-em[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3941             End.
     3942     WHEN 'im':U THEN DO:
     3943       ASSIGN oborot-im[1 + tt#]   = oborot-im[1 + tt#]   +  ub.ot-line.fact-qnty
     3944             oborot-im[2 + tt#]   = oborot-im[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3945             oborot-im[3 + tt#]   = oborot-im[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3946         if tt# = 6 Then   assign
     3947             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3948             oborot-im[10]   = oborot-im[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3949             End.
     3950     WHEN 'ot':U THEN DO:
     3951       ASSIGN oborot-ot[1 + tt#]   = oborot-ot[1 + tt#]   +  ub.ot-line.fact-qnty
     3952             oborot-ot[2 + tt#]   = oborot-ot[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3953             oborot-ot[3 + tt#]   = oborot-ot[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3954         if tt# = 6 Then   assign
     3955             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3956             oborot-ot[10]   = oborot-ot[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3957             End.
     3958     WHEN 'ap':U THEN DO:
     3959       ASSIGN oborot-ap[1 + tt#]   = oborot-ap[1 + tt#]   +  ub.ot-line.fact-qnty
     3960             oborot-ap[2 + tt#]   = oborot-ap[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3961             oborot-ap[3 + tt#]   = oborot-ap[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3962         if tt# = 6 Then   assign
     3963             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3964             oborot-ap[10]   = oborot-ap[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3965             End.
     3966     WHEN 'pc':U THEN DO:
     3967       ASSIGN oborot-pc[1 + tt#]   = oborot-pc[1 + tt#]   +  ub.ot-line.fact-qnty
     3968             oborot-pc[2 + tt#]   = oborot-pc[2 + tt#]   +  if tprintrubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     3969             oborot-pc[3 + tt#]   = oborot-pc[3 + tt#]   +  if tprintrubl then ub.ot-line.vat-rubl else ub.ot-line.vat-base  .
     3970         if tt# = 6 Then   assign
     3971             oborot-disc[1]   = oborot-disc[1]   +  if tprintrubl then ub.ot-line.other-rubl else ub.ot-line.other-base
     3972             oborot-pc[10]   = oborot-pc[10]   +  if tprintrubl then ub.ot-line.slt-rubl else ub.ot-line.slt-base  .
     3973             End.
     3974               end case.
     3975           end.
     3976      end.
     3977   end.
     3978   else do:
     3979   xi = 1 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ie [1 + tt#] ,output  oborot-ie [2 + tt#] ,output  oborot-ie [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ie[10]    = oborot-ie[10]    + slt  .
     3980   xi = 2 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ee [1 + tt#] ,output  oborot-ee [2 + tt#] ,output  oborot-ee [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ee[10]    = oborot-ee[10]    + slt  .
     3981   xi = 3 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ep [1 + tt#] ,output  oborot-ep [2 + tt#] ,output  oborot-ep [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ep[10]    = oborot-ep[10]    + slt  .
     3982   xi = 4 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-es [1 + tt#] ,output  oborot-es [2 + tt#] ,output  oborot-es [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-es[10]    = oborot-es[10]    + slt  .
     3983   xi = 5 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-re [1 + tt#] ,output  oborot-re [2 + tt#] ,output  oborot-re [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-re[10]    = oborot-re[10]    + slt  .
     3984   xi = 6 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rs [1 + tt#] ,output  oborot-rs [2 + tt#] ,output  oborot-rs [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rs[10]    = oborot-rs[10]    + slt  .
     3985   xi = 7 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-we [1 + tt#] ,output  oborot-we [2 + tt#] ,output  oborot-we [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-we[10]    = oborot-we[10]    + slt  .
     3986   xi = 8 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-vt [1 + tt#] ,output  oborot-vt [2 + tt#] ,output  oborot-vt [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-vt[10]    = oborot-vt[10]    + slt  .
     3987   xi = 9 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-iv [1 + tt#] ,output  oborot-iv [2 + tt#] ,output  oborot-iv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-iv[10]    = oborot-iv[10]    + slt  .
     3988   xi = 10 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ev [1 + tt#] ,output  oborot-ev [2 + tt#] ,output  oborot-ev [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ev[10]    = oborot-ev[10]    + slt  .
     3989   xi = 11 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-rv [1 + tt#] ,output  oborot-rv [2 + tt#] ,output  oborot-rv [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-rv[10]    = oborot-rv[10]    + slt  .
     3990   xi = 12 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-em [1 + tt#] ,output  oborot-em [2 + tt#] ,output  oborot-em [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-em[10]    = oborot-em[10]    + slt  .
     3991   xi = 13 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-im [1 + tt#] ,output  oborot-im [2 + tt#] ,output  oborot-im [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-im[10]    = oborot-im[10]    + slt  .
     3992   xi = 14 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ot [1 + tt#] ,output  oborot-ot [2 + tt#] ,output  oborot-ot [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ot[10]    = oborot-ot[10]    + slt  .
     3993   xi = 15 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-ap [1 + tt#] ,output  oborot-ap [2 + tt#] ,output  oborot-ap [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-ap[10]    = oborot-ap[10]    + slt  .
     3994   xi = 16 + v-tt. run ob-line-stk ( input   x-store-code    ,input   x-store-type    ,input   x-artic         ,input   x-prod-code     ,input   x-prod-type     ,input   x-fact-order-1  ,input   x-fact-order-2  ,input   x-sum-type      ,input   x-cat-id        ,input   x-ext-doc-type  ,input   xtog-obj        ,input   xi              ,output  oborot-pc [1 + tt#] ,output  oborot-pc [2 + tt#] ,output  oborot-pc [3 + tt#] ,output  slt      ,output  disc ).    if tt# = 6 then   assign              oborot-disc[1] = oborot-disc[1] + disc     oborot-pc[10]    = oborot-pc[10]    + slt  .
     3995   end.
     3996     if tt# = 6 then do:
     3997     if  xshowmediator = false then
     3998         oborot-sum-cost[1] =
     3999         oborot-ee[2]      +
     4000         oborot-es[2] +
     4001         oborot-re[2]  +
     4002         oborot-rs[2]
     4003         .
     4004         else
     4005         oborot-sum-cost[1] =
     4006         oborot-ee[4]      +
     4007         oborot-es[4] +
     4008         oborot-re[4]  +
     4009         oborot-rs[4]
     4010         .
     4011        repeat v-ii = 1 to 1 :
     4012        v-summa[v-ii ]  =
     4013           oborot-ie[v-ii ] + oborot-ee[v-ii ] + oborot-ep[v-ii ] +
     4014           oborot-es[v-ii ] + oborot-re[v-ii ] + oborot-rs[v-ii ] +
     4015           oborot-we[v-ii ] + oborot-vt[v-ii ] + oborot-iv[v-ii ] +
     4016           oborot-ev[v-ii ] + oborot-rv[v-ii ] + oborot-em[v-ii ] +
     4017           oborot-im[v-ii ] .
     4018        end.
     4019        repeat v-ii = 2 to 4 :
     4020        v-summa[v-ii ]  =
     4021           oborot-ie[v-ii + tt#] + oborot-ee[v-ii + tt#] + oborot-ep[v-ii + tt#] +
     4022           oborot-es[v-ii + tt#] + oborot-re[v-ii + tt#] + oborot-rs[v-ii + tt#] +
     4023           oborot-we[v-ii + tt#] + oborot-vt[v-ii + tt#] + oborot-iv[v-ii + tt#] +
     4024           oborot-ev[v-ii + tt#] + oborot-rv[v-ii + tt#] + oborot-em[v-ii + tt#] +
     4025           oborot-im[v-ii + tt#] .
     4026        end.
     4027         oborot-sum-sale[1] =
     4028         oborot-ee[2 + tt#] +
     4029         oborot-es[2 + tt#] +
     4030         oborot-re[2 + tt#] +
     4031         oborot-rs[2 + tt#]
     4032         .
     4033          assign oborot-ot[1 + tt#] = (ostatok-end[1 + tt#]  - ostatok-start[1 + tt#])  -  (v-summa[1])
     4034           oborot-ot[2 + tt#] = (ostatok-end[2 + tt#]  - ostatok-start[2 + tt#])  -  (v-summa[2])
     4035                                                                                                     -  oborot-disc[1]
     4036           oborot-ot[3 + tt#] = (ostatok-end[3 + tt#]  - ostatok-start[3 + tt#])  -  (v-summa[3])
     4037           oborot-ot[10] = (ostatok-end[10]  - ostatok-start[10])                 -  (v-summa[4])
     4038           .
     4039           oborot-eff[1] = -1 * (oborot-sum-sale[1] - oborot-sum-cost[1]) .
     4040           if oborot-sum-cost[1] <>  0 then
     4041             oborot-prc[1] = 100 * (oborot-sum-sale[1] - oborot-sum-cost[1] ) / oborot-sum-cost[1].
     4042             else oborot-prc[1] = 0.
     4043     end.
     4044   oborot-ie[4]   = Round(oborot-ie[1]   *  p-price-med , 2) .
     4045   oborot-ee[4]   = Round(oborot-ee[1]   *  p-price-med , 2) .
     4046   oborot-ep[4]   = Round(oborot-ep[1]   *  p-price-med , 2) .
     4047   oborot-es[4]   = Round(oborot-es[1]   *  p-price-med , 2) .
     4048   oborot-re[4]   = Round(oborot-re[1]   *  p-price-med , 2) .
     4049   oborot-rs[4]   = Round(oborot-rs[1]   *  p-price-med , 2) .
     4050   oborot-we[4]   = Round(oborot-we[1]   *  p-price-med , 2) .
     4051   oborot-vt[4]   = Round(oborot-vt[1]   *  p-price-med , 2) .
     4052   oborot-iv[4]   = Round(oborot-iv[1]   *  p-price-med , 2) .
     4053   oborot-ev[4]   = Round(oborot-ev[1]   *  p-price-med , 2) .
     4054   oborot-rv[4]   = Round(oborot-rv[1]   *  p-price-med , 2) .
     4055   oborot-em[4]   = Round(oborot-em[1]   *  p-price-med , 2) .
     4056   oborot-im[4]   = Round(oborot-im[1]   *  p-price-med , 2) .
     4057   oborot-ot[4]   = Round(oborot-ot[1]   *  p-price-med , 2) .
     4058   oborot-ap[4]   = Round(oborot-ap[1]   *  p-price-med , 2) .
     4059   oborot-pc[4]   = Round(oborot-pc[1]   *  p-price-med , 2) .
     4060   end procedure.
     4061   procedure ost-line :
     4062     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     4063     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     4064     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     4065     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     4066     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     4067     define input  parameter x-tog-shift  as logical no-undo .
     4068     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     4069     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     4070     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     4071     define input  parameter xtog-obj     as logical no-undo .
     4072     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     4073     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     4074     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     4075     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     4076     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     4077     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     4078     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     4079     define buffer buff-obj-list  for obj-list .
     4080     define buffer buff-stk-line  for ub.stk-line .
     4081     assign
     4082       Quantity = 0
     4083       Coast_R  = 0
     4084       Coast_V  = 0
     4085       VAT_R    = 0
     4086       VAT_V    = 0
     4087       SLT_R    = 0
     4088       SLT_V    = 0
     4089     .
     4090     if  x-tog-shift = false then do:
     4091       for each buff-obj-list no-lock
     4092         where xtog-obj = false
     4093            or (buff-obj-list.obj-type = x-store-type
     4094               and buff-obj-list.obj-code = x-store-code
     4095               )
     4096       on error undo, return error
     4097       :
     4098       find last buff-stk-line no-lock
     4099         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4100           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4101           and buff-stk-line.artic      = x-artic
     4102           and buff-stk-line.prod-type  = x-prod-type
     4103           and buff-stk-line.prod-code  = x-prod-code
     4104           and buff-stk-line.sum-type   = x-sum-type
     4105           and buff-stk-line.cat-id     = '##,##':U
     4106           and buff-stk-line.fact-order <= x-fact-order
     4107           and buff-stk-line.shift-num  = 0
     4108         use-index category
     4109         no-error .
     4110       if available buff-stk-line then do:
     4111         assign
     4112           Quantity = Quantity + buff-stk-line.fact-qnty
     4113           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4114           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4115           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4116           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4117           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4118           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4119         .
     4120       end.
     4121      end.
     4122     end.
     4123     else do:
     4124       for each buff-obj-list no-lock
     4125         where xtog-obj = false
     4126            or (buff-obj-list.obj-type = x-store-type
     4127               and buff-obj-list.obj-code = x-store-code
     4128               )
     4129       on error undo, return error
     4130       :
     4131         find last buff-stk-line no-lock
     4132           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4133             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4134             and buff-stk-line.artic      = x-artic
     4135             and buff-stk-line.prod-type  = x-prod-type
     4136             and buff-stk-line.prod-code  = x-prod-code
     4137             and buff-stk-line.sum-type   = x-sum-type
     4138             and buff-stk-line.cat-id     = '##,##':U
     4139             and buff-stk-line.fact-order <= x-fact-order
     4140             and buff-stk-line.shift-num  > 0
     4141           use-index category
     4142           no-error .
     4143         if available buff-stk-line then do:
     4144           assign
     4145             Quantity = Quantity +  buff-stk-line.fact-qnty
     4146             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4147             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4148             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4149             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4150             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4151             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4152           .
     4153         end.
     4154       end.
     4155     end.
     4156   end procedure.
     4157   procedure ost-lineother-tax :
     4158     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     4159     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     4160     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     4161     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     4162     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     4163     define input  parameter x-tog-shift  as logical no-undo .
     4164     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     4165     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     4166     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     4167     define input  parameter xTog-obj     as logical no-undo .
     4168     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     4169     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     4170     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     4171     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     4172     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     4173     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     4174     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     4175     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     4176     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     4177     define buffer buff-obj-list  for obj-list .
     4178     define buffer buff-stk-line  for ub.stk-line .
     4179     assign
     4180       Quantity = 0
     4181       Coast_R  = 0
     4182       Coast_V  = 0
     4183       VAT_R    = 0
     4184       VAT_V    = 0
     4185       SLT_R    = 0
     4186       SLT_V    = 0
     4187       other_R  = 0
     4188       other_V  = 0
     4189     .
     4190     if  x-tog-shift = false then do:
     4191       for each buff-obj-list no-lock
     4192         where xtog-obj = false
     4193            or (buff-obj-list.obj-type = x-store-type
     4194               and buff-obj-list.obj-code = x-store-code
     4195               )
     4196       on error undo, return error
     4197       :
     4198       find last buff-stk-line no-lock
     4199         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4200           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4201           and buff-stk-line.artic      = x-artic
     4202           and buff-stk-line.prod-type  = x-prod-type
     4203           and buff-stk-line.prod-code  = x-prod-code
     4204           and buff-stk-line.sum-type   = x-sum-type
     4205           and buff-stk-line.cat-id     = '##,##':U
     4206           and buff-stk-line.fact-order <= x-fact-order
     4207           and buff-stk-line.shift-num  = 0
     4208         use-index category
     4209         no-error .
     4210       if available buff-stk-line then do:
     4211         assign
     4212           Quantity = Quantity + buff-stk-line.fact-qnty
     4213           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     4214           Coast_V  = Coast_V  + buff-stk-line.sum-base
     4215           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     4216           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     4217           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     4218           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     4219           other_R  = other_R  + buff-stk-line.other-rubl
     4220           other_V  = other_V  + buff-stk-line.other-base
     4221         .
     4222       end.
     4223    end.
     4224     end.
     4225     else do:
     4226       for each buff-obj-list no-lock
     4227         where xtog-obj = false
     4228            or (buff-obj-list.obj-type = x-store-type
     4229               and buff-obj-list.obj-code = x-store-code
     4230               )
     4231       on error undo, return error
     4232       :
     4233         find last buff-stk-line no-lock
     4234           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     4235             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     4236             and buff-stk-line.artic      = x-artic
     4237             and buff-stk-line.prod-type  = x-prod-type
     4238             and buff-stk-line.prod-code  = x-prod-code
     4239             and buff-stk-line.sum-type   = x-sum-type
     4240             and buff-stk-line.cat-id     = '##,##':U
     4241             and buff-stk-line.fact-order <= x-fact-order
     4242             and buff-stk-line.shift-num  > 0
     4243           use-index category
     4244           no-error .
     4245         if available buff-stk-line then do:
     4246           assign
     4247             Quantity = Quantity +  buff-stk-line.fact-qnty
     4248             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     4249             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     4250             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     4251             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     4252             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     4253             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     4254             other_R = other_R   +  buff-stk-line.other-rubl
     4255             other_V = other_V   +  buff-stk-line.other-base
     4256           .
     4257         end.
     4258       end.
     4259     end.
     4260   end procedure.
     4261   procedure ost-line-kg :
     4262     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     4263     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     4264     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     4265     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     4266     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     4267     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     4268     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     4269     define buffer buff-obj-list  for obj-list .
     4270     define buffer buf_doc-line for ub.doc-line .
     4271     define buffer buf_inv-line for ub.inv-line .
     4272     do
     4273     on error undo, return error
     4274     :
     4275       for each buf_doc-line no-lock where
     4276                buf_doc-line.obj-type    = p-obj-type   and
     4277                buf_doc-line.obj-code    = p-obj-code   and
     4278                buf_doc-line.prod-type   = p-prod-type  and
     4279                buf_doc-line.prod-code   = p-prod-code  and
     4280                buf_doc-line.artic       = p-artic      and
     4281                buf_doc-line.status_     = 'факт':U      and
     4282                buf_doc-line.fact-order <= p-fact-order
     4283             by buf_doc-line.fact-order    descending
     4284       :
     4285         find first buf_inv-line no-lock where
     4286                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     4287                    buf_inv-line.artic     = buf_doc-line.artic     and
     4288                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     4289                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     4290         if available buf_inv-line
     4291         then do:
     4292           if buf_inv-line.after-cli-qnty <> ?
     4293           then do:
     4294             assign
     4295               p-quantity-kg = buf_inv-line.after-cli-qnty
     4296             .
     4297             leave .
     4298           end.
     4299         end.
     4300       end.
     4301       if p-quantity-kg = ?
     4302       then do:
     4303         assign
     4304           p-quantity-kg = 0
     4305         .
     4306       end.
     4307     end.
     4308   end procedure.
     4309   PROCEDURE ostatok :
     4310   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     4311   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     4312   def input parameter x-tog-shift   as   logical             no-undo.
     4313   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     4314   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     4315   def input parameter x-shift-start as integer               no-undo.
     4316   def input parameter x-shift-end   as integer               no-undo.
     4317   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     4318   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     4319   def input parameter xTog-obj   as log no-undo.
     4320   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     4321   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     4322   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     4323   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     4324   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     4325   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     4326   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     4327   def var              Fact-orderS   as char  no-undo.
     4328   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     4329      Assign
     4330         Fact-order   = 0
     4331         Quantity     = 0
     4332         Coast_R      = 0
     4333         Coast_V      = 0
     4334         VAT_R        = 0
     4335         VAT_V        = 0 .
     4336    x-date-start-t  = x-date-start + 1 .
     4337   IF x-date-end = date('') then DO:
     4338      Fact-order = 0 .
     4339      for each obj-list
     4340          where  ( not xtog-obj or
     4341                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     4342                 no-lock :
     4343         if  x-tog-shift = false then do:
     4344                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4345                               ub.stk-tot.Fact-date <=  x-date-start
     4346                               and ub.stk-tot.shift-num = 0
     4347                               USE-INDEX fact-date no-lock no-error .
     4348              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4349         End.
     4350         Else  DO :
     4351             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4352              (ub.stk-tot.shift-date  = x-date-start-t and
     4353               ub.stk-tot.shift-num  < x-shift-start or
     4354               ub.stk-tot.shift-date  < x-date-start-t  )
     4355               and ub.stk-tot.shift-num  > 0
     4356               USE-INDEX Shift-num no-lock no-error .
     4357            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4358           END.
     4359       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     4360     End.
     4361   End.
     4362   Else DO:
     4363     For each obj-list  WHERE
     4364        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     4365         no-lock :
     4366      IF  x-TOG-Shift = False Then DO:
     4367          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4368               ub.stk-tot.Fact-date <= x-date-end
     4369               and ub.stk-tot.shift-num = 0
     4370               USE-INDEX fact-date no-lock no-error.
     4371          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4372      END.
     4373      Else DO:
     4374           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     4375               (ub.stk-tot.shift-date  = x-date-end and
     4376               ub.stk-tot.shift-num  <= x-shift-end or
     4377               ub.stk-tot.shift-date  < x-date-end       ) and
     4378               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     4379               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     4380       End.
     4381       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     4382     End.
     4383   End.
     4384   END PROCEDURE.
     4385   procedure report-exec1  :
     4386      find first clients where x-store-type = clients.obj-type and
     4387                               x-store-code = clients.obj-code
     4388                               no-lock no-error.
     4389              if available clients then assign  objname = clients.obj-name
     4390                                                x-db-num     = clients.db-num.
     4391                                            else  objname="объект не определен".
     4392     run calcitog in this-procedure .
     4393     run print-header in this-procedure .      case retclassify :
     4394      when "prod":u           then  run run3 in this-procedure .
     4395      otherwise do:
     4396        message "Ошибка вызова" view-as alert-box error .
     4397      end.
     4398      end case.
     4399     run print-footer in this-procedure .
     4400     end procedure.
     4401   procedure calc-sub-itog :
     4402   define input parameter tt as int no-undo.
     4403   define variable tt2 as integer no-undo .
     4404     if tt = 6 then tt2 = 7 .
     4405               else tt2 = tt.
     4406   repeat i# = 1 + tt to 3 + tt2 :
     4407   run sum-i (
     4408    input oborot-vt[i#]
     4409   ,input tt
     4410   ,input-output b1-oborot-vt[i#]
     4411   ,input-output b2-oborot-vt[i#]
     4412   ,input-output bi-oborot-vt[i#]
     4413   ,input-output bo-oborot-vt[i#]
     4414   ,input oborot-ie[i#]
     4415   ,input-output b1-oborot-ie[i#]
     4416   ,input-output b2-oborot-ie[i#]
     4417   ,input-output bi-oborot-ie[i#]
     4418   ,input-output bo-oborot-ie[i#]
     4419   ) .
     4420   run sum-i (
     4421    input oborot-iv[i#]
     4422   ,input tt
     4423   ,input-output b1-oborot-iv[i#]
     4424   ,input-output b2-oborot-iv[i#]
     4425   ,input-output bi-oborot-iv[i#]
     4426   ,input-output bo-oborot-iv[i#]
     4427   ,input oborot-ee[i#]
     4428   ,input-output b1-oborot-ee[i#]
     4429   ,input-output b2-oborot-ee[i#]
     4430   ,input-output bi-oborot-ee[i#]
     4431   ,input-output bo-oborot-ee[i#]
     4432   ) .
     4433   run sum-i (
     4434    input oborot-ev[i#]
     4435   ,input tt
     4436   ,input-output b1-oborot-ev[i#]
     4437   ,input-output b2-oborot-ev[i#]
     4438   ,input-output bi-oborot-ev[i#]
     4439   ,input-output bo-oborot-ev[i#]
     4440   ,input oborot-ep[i#]
     4441   ,input-output b1-oborot-ep[i#]
     4442   ,input-output b2-oborot-ep[i#]
     4443   ,input-output bi-oborot-ep[i#]
     4444   ,input-output bo-oborot-ep[i#]
     4445   ) .
     4446   run sum-i (
     4447    input oborot-rv[i#]
     4448   ,input tt
     4449   ,input-output b1-oborot-rv[i#]
     4450   ,input-output b2-oborot-rv[i#]
     4451   ,input-output bi-oborot-rv[i#]
     4452   ,input-output bo-oborot-rv[i#]
     4453   ,input oborot-es[i#]
     4454   ,input-output b1-oborot-es[i#]
     4455   ,input-output b2-oborot-es[i#]
     4456   ,input-output bi-oborot-es[i#]
     4457   ,input-output bo-oborot-es[i#]
     4458   ) .
     4459   run sum-i (
     4460    input oborot-em[i#]
     4461   ,input tt
     4462   ,input-output b1-oborot-em[i#]
     4463   ,input-output b2-oborot-em[i#]
     4464   ,input-output bi-oborot-em[i#]
     4465   ,input-output bo-oborot-em[i#]
     4466   ,input oborot-re[i#]
     4467   ,input-output b1-oborot-re[i#]
     4468   ,input-output b2-oborot-re[i#]
     4469   ,input-output bi-oborot-re[i#]
     4470   ,input-output bo-oborot-re[i#]
     4471   ) .
     4472   run sum-i (
     4473    input oborot-im[i#]
     4474   ,input tt
     4475   ,input-output b1-oborot-im[i#]
     4476   ,input-output b2-oborot-im[i#]
     4477   ,input-output bi-oborot-im[i#]
     4478   ,input-output bo-oborot-im[i#]
     4479   ,input oborot-rs[i#]
     4480   ,input-output b1-oborot-rs[i#]
     4481   ,input-output b2-oborot-rs[i#]
     4482   ,input-output bi-oborot-rs[i#]
     4483   ,input-output bo-oborot-rs[i#]
     4484   ) .
     4485   run sum-i (
     4486    input oborot-ot[i#]
     4487   ,input tt
     4488   ,input-output b1-oborot-ot[i#]
     4489   ,input-output b2-oborot-ot[i#]
     4490   ,input-output bi-oborot-ot[i#]
     4491   ,input-output bo-oborot-ot[i#]
     4492   ,input oborot-we[i#]
     4493   ,input-output b1-oborot-we[i#]
     4494   ,input-output b2-oborot-we[i#]
     4495   ,input-output bi-oborot-we[i#]
     4496   ,input-output bo-oborot-we[i#]
     4497   ) .
     4498   run sum-i (
     4499    input oborot-ap[i#]
     4500   ,input tt
     4501   ,input-output b1-oborot-ap[i#]
     4502   ,input-output b2-oborot-ap[i#]
     4503   ,input-output bi-oborot-ap[i#]
     4504   ,input-output bo-oborot-ap[i#]
     4505   ,input oborot-pc[i#]
     4506   ,input-output b1-oborot-pc[i#]
     4507   ,input-output b2-oborot-pc[i#]
     4508   ,input-output bi-oborot-pc[i#]
     4509   ,input-output bo-oborot-pc[i#]
     4510   ) .
     4511     b1-oborot-em[ i#] = b1-oborot-em[ i#] + oborot-wm[ i#].
     4512     b2-oborot-em[ i#] = b2-oborot-em[ i#] + oborot-wm[ i#].
     4513     bi-oborot-em[ i#] = bi-oborot-em[ i#] + oborot-wm[ i#].
     4514     bo-oborot-em[ i#] = bo-oborot-em[ i#] + oborot-wm[ i#].
     4515     bo-ostatok-start[ i#]  = bo-ostatok-start[i#]  + ostatok-start[ i#]  .
     4516     bo-ostatok-end[ i#]    = bo-ostatok-end[i#]    + ostatok-end[ i#]    .
     4517     if i# = 7 then b1-oborot-disc[1 ]  = b1-oborot-disc[1]  + oborot-disc[1]  .
     4518     if i# = 7 then b2-oborot-disc[1 ]  = b2-oborot-disc[1]  + oborot-disc[1]  .
     4519     if i# = 7 then bi-oborot-disc[1 ]  = bi-oborot-disc[1]  + oborot-disc[1]  .
     4520     if i# = 7 then bo-oborot-disc[1 ]  = bo-oborot-disc[1]  + oborot-disc[1]  .
     4521     if i# = 8 then
     4522       assign
     4523         bi-oborot-sum-sale[ i#]  = bi-oborot-ee[ i#] +
     4524                                 bi-oborot-re[ i#]         +
     4525                                 bi-oborot-rs[ i#]    +
     4526                                 bi-oborot-es[ i#]
     4527         b1-oborot-sum-sale[ i#]  = b1-oborot-ee[ i#] +
     4528                                 b1-oborot-re[ i#]         +
     4529                                 b1-oborot-rs[ i#]    +
     4530                                 b1-oborot-es[ i#]
     4531         b2-oborot-sum-sale[ i#]  = b2-oborot-ee[ i#] +
     4532                                 b2-oborot-re[ i#]         +
     4533                                 b2-oborot-rs[ i#]    +
     4534                                 b2-oborot-es[ i#]
     4535         bo-oborot-sum-sale[ i#]  = bo-oborot-ee[ i#] +
     4536                                 bo-oborot-re[ i#]         +
     4537                                 bo-oborot-rs[ i#]    +
     4538                                 bo-oborot-es[ i#]
     4539         .
     4540     if  xshowmediator = true  then do:
     4541         if i# = 8 then b1-oborot-sum-cost[2 ]  = b1-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4542         if i# = 8 then b2-oborot-sum-cost[2 ]  = b2-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4543         if i# = 8 then bi-oborot-sum-cost[2 ]  = bi-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4544         if i# = 8 then bo-oborot-sum-cost[2 ]  = bo-oborot-sum-cost[2]  + oborot-sum-cost[1]  .
     4545     end.
     4546     if i# = 2 and xshowmediator = false  then
     4547         assign
     4548           bi-oborot-sum-cost[ i#]  = bi-oborot-ee[ i#] +
     4549                                   bi-oborot-re[ i#]         +
     4550                                   bi-oborot-rs[ i#]    +
     4551                                   bi-oborot-es[ i#]
     4552           b1-oborot-sum-cost[ i#]  = b1-oborot-ee[ i#] +
     4553                                   b1-oborot-re[ i#]         +
     4554                                   b1-oborot-rs[ i#]    +
     4555                                   b1-oborot-es[ i#]
     4556           b2-oborot-sum-cost[ i#]  = b2-oborot-ee[ i#] +
     4557                                   b2-oborot-re[ i#]         +
     4558                                   b2-oborot-rs[ i#]    +
     4559                                   b2-oborot-es[ i#]
     4560           bo-oborot-sum-cost[ i#]  = bo-oborot-ee[ i#] +
     4561                                   bo-oborot-re[ i#]         +
     4562                                   bo-oborot-rs[ i#]    +
     4563                                   bo-oborot-es[ i#]
     4564           .
     4565     if i# = 8 then b1-oborot-eff[1 ]  = b1-oborot-eff[1]  + oborot-eff[1]  .
     4566     if i# = 8 then b2-oborot-eff[1 ]  = b2-oborot-eff[1]  + oborot-eff[1]  .
     4567     if i# = 8 then bi-oborot-eff[1 ]  = bi-oborot-eff[1]  + oborot-eff[1]  .
     4568     if i# = 8 then bo-oborot-eff[1 ]  = bo-oborot-eff[1]  + oborot-eff[1]  .
     4569     if i# = 8 then    if  bi-oborot-sum-cost[2] <>  0 then
     4570                           bi-oborot-prc[1] = 100 * (bi-oborot-sum-sale[8] - bi-oborot-sum-cost[2] ) / bi-oborot-sum-cost[2] .
     4571                      else bi-oborot-prc[1] = 0.
     4572     if i# = 8 then    if  bo-oborot-sum-cost[2] <>  0 then
     4573                           bo-oborot-prc[1] = 100 * (bo-oborot-sum-sale[8] - bo-oborot-sum-cost[2] ) / bo-oborot-sum-cost[2] .
     4574                      else bo-oborot-prc[1] = 0.
     4575     if i# = 8 then    if  b1-oborot-sum-cost[2] <>  0 then
     4576                           b1-oborot-prc[1] = 100 * (b1-oborot-sum-sale[8] - b1-oborot-sum-cost[2] ) / b1-oborot-sum-cost[2] .
     4577                      else b1-oborot-prc[1] = 0.
     4578     if i# = 8 then    if  b2-oborot-sum-cost[2] <>  0 then
     4579                           b2-oborot-prc[1] = 100 * (b2-oborot-sum-sale[8] - b2-oborot-sum-cost[2] ) / b2-oborot-sum-cost[2] .
     4580                      else b2-oborot-prc[1] = 0.
     4581    end.
     4582   end procedure.
     4583   procedure sum-i :
     4584   define input parameter ob like oborot-ot[1] no-undo.
     4585   define input parameter tt as int  no-undo.
     4586   define input-output parameter b1 like b1-oborot-ot[1] no-undo.
     4587   define input-output parameter b2 like b1-oborot-ot[1] no-undo.
     4588   define input-output parameter bi like b1-oborot-ot[1] no-undo.
     4589   define input-output parameter bo like b1-oborot-ot[1] no-undo.
     4590   define input parameter ob2 like oborot-ot[1] no-undo.
     4591   define input-output parameter b1- like b1-oborot-ot[1] no-undo.
     4592   define input-output parameter b2- like b1-oborot-ot[1] no-undo.
     4593   define input-output parameter bi- like b1-oborot-ot[1] no-undo.
     4594   define input-output parameter bo- like b1-oborot-ot[1] no-undo.
     4595   assign
     4596    b1  = b1 + ob
     4597    b2  = b2 + ob
     4598    b1- = b1- + ob2
     4599    b2- = b2- + ob2
     4600    .
     4601       assign
     4602       bi = bi + ob
     4603       bo = bo + ob
     4604       bi- = bi- + ob2
     4605       bo- = bo- + ob2
     4606       .
     4607   end procedure.
     4608   procedure clear-item :
     4609   define variable kk as int no-undo.
     4610    repeat kk = 1 to 13 :
     4611    assign
     4612       oborot-ie                 [kk]    = 0
     4613       oborot-ee                 [kk]    = 0
     4614       oborot-ep              [kk]    = 0
     4615       oborot-es            [kk]    = 0
     4616       oborot-re             [kk]    = 0
     4617       oborot-rs        [kk]    = 0
     4618       oborot-we                 [kk]    = 0
     4619       oborot-vt                       [kk]    = 0
     4620       oborot-iv                 [kk]    = 0
     4621       oborot-ev                 [kk]    = 0
     4622       oborot-rv             [kk]    = 0
     4623       oborot-em                  [kk]    = 0
     4624       oborot-wm                  [kk]    = 0
     4625       oborot-im                  [kk]    = 0
     4626       oborot-ot                  [kk]    = 0
     4627       oborot-disc                             [kk]    = 0
     4628       oborot-eff                              [kk]    = 0
     4629       oborot-prc                              [kk]    = 0
     4630       oborot-ap            [kk]    = 0
     4631       oborot-pc            [kk]    = 0
     4632       ostatok-end                                    [kk]    = 0
     4633       ostatok-start                                  [kk]    = 0
     4634     .
     4635    end.
     4636   end procedure.
     4637   procedure item-goods :
     4638    define input parameter  par-3 as char no-undo.
     4639    define input parameter  par-4 as char no-undo.
     4640        if par-4 = "goods":u  then  assign
     4641                                       gds-zap-unit-base  = goods.unit-base
     4642                                       gds-zap-prt-root   = goods.prt-root
     4643                                       gds-zap-prod-type  = goods.prod-type
     4644                                       gds-zap-prod-code  = goods.prod-code
     4645                                       gds-zap-artic      = goods.artic
     4646                                       gds-zap-type       = goods.gds-type
     4647                                       gds-zap-grp-name   = goods.grp-name
     4648                                       gds-zap-b-code     = goods.gds-code
     4649                                       gds-zap-gds-name   = if g#gds-engl then goods.engl-name
     4650                                                                          else goods.gds-name
     4651                                       gds-zap-gds-long-name = substring ((if goods.engl-name <> ? then trim(goods.engl-name) else "" ) +
     4652                                                               ( if goods.label-name <> ? then trim(goods.label-name) else "" ),1,120).
     4653        if par-4 = "gds-list":u  then  assign
     4654                                       gds-zap-unit-base  = gds-list.unit-base
     4655                                       gds-zap-prt-root   = gds-list.prt-root
     4656                                       gds-zap-prod-type  = gds-list.prod-type
     4657                                       gds-zap-prod-code  = gds-list.prod-code
     4658                                       gds-zap-artic      = gds-list.artic
     4659                                       gds-zap-type       = gds-list.gds-type
     4660                                       gds-zap-grp-name   = gds-list.grp-name
     4661                                       gds-zap-b-code     = gds-list.gds-code
     4662                                       gds-zap-gds-name   = if g#gds-engl then gds-list.engl-name
     4663                                                                          else gds-list.gds-name
     4664                                       gds-zap-gds-long-name = substring ((if gds-list.engl-name <> ? then trim(gds-list.engl-name) else "" ) +
     4665                                                               ( if gds-list.label-name <> ? then trim(gds-list.label-name) else ""), 1,120).
     4666       run foreach in this-procedure .
     4667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     4668     (input  gds-zap-b-code
     4669     ,input  ?
     4670     ,output v-bar-code
     4671     )  .
     4672   s-bar-code = string (v-bar-code,"999999999").
     4673       If  break_group = true  and par-3 <> "1"  then DO :
     4674            FIND FIRST clients WHERE clients.obj-type = gds-zap-prod-type AND clients.obj-code = gds-zap-prod-code use-index pi NO-LOCK .
     4675            gds-zap-prod-name  = clients.obj-name.
     4676             If break_group1 = true  THEN  DO :
     4677               if (par-3 = "3"  OR  par-3 = "5" ) and  par-3 <> "6"
     4678                 then DO: Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )         b1-name = gds-zap-grp-name . end.
     4679                 else DO: Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name ) b1-name = gds-zap-prod-name. end.
     4680               if par-3 = "6"  then  dO:
     4681                  if xTog-obj = true then do:
     4682                   var-vat-pc = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     4683                   end.
     4684                  else do:
     4685                   var-vat-pc = temp-gds-list.vat-pc  .
     4686                   end.
     4687                   assign
     4688                       temp-str = string( "СТАВКА НДС : " + string(var-vat-pc) + "%" )
     4689                       b1-name = temp-str .
     4690                   end.
     4691               if NOT xSumsOnly or (par-3 = "4" Or par-3 = "5" ) THEN DO :
     4692                   fr0 = true .
     4693                   tmp#stroka0 = temp-str.
     4694               End .
     4695             End .
     4696             IF (par-3 = "4"  OR  par-3 = "5")  THEN DO :
     4697               if par-3 = "4"
     4698                 then Assign temp-str = string("ГРУППА : " + gds-zap-grp-name )          b2-name = gds-zap-grp-name  .
     4699                 else Assign temp-str = string("ПРОИЗВОДИТЕЛЬ : " + gds-zap-prod-name )  b2-name = gds-zap-prod-name .
     4700               if NOT xSumsOnly THEN DO :
     4701               fr = true .
     4702               End.
     4703               break_group1 = false.
     4704             END.
     4705          break_group = false.
     4706       End.
     4707       run display-line in this-procedure .
     4708    end procedure.
