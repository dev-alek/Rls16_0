     2914   procedure calcitog :
     2915       run ostatok  in this-procedure (
     2916           input x-store-code  ,
     2917           input x-store-type  , x-tog-shift ,
     2918           input x-date-start - 1 ,
     2919           input date('')      , x-Shift-Start,x-Shift-End,
     2920           input 'crsa':U   ,
     2921           input '##,##':U,
     2922           input xtog-obj ,
     2923           output  quantity1  ,
     2924           output  coast_r1   ,
     2925           output  coast_v1   ,
     2926           output  vat_r1     ,
     2927           output  vat_v1     ,
     2928           output  fact-order-1 ).
     2929       run ostatok  in this-procedure (
     2930           input x-store-code  ,
     2931           input x-store-type  , x-tog-shift ,
     2932           input x-date-start  ,
     2933           input x-date-end    , x-Shift-Start,x-Shift-End,
     2934           input 'crsa':U   ,
     2935           input '##,##':U,
     2936           input xtog-obj ,
     2937           output  quantity1  ,
     2938           output  coast_r1   ,
     2939           output  coast_v1   ,
     2940           output  vat_r1     ,
     2941           output  vat_v1     ,
     2942           output  fact-order-2 ).
     2943             quantity1  = 0.
     2944             coast_r1   = 0.
     2945             coast_v1   = 0.
     2946             vat_r1     = 0.
     2947             vat_v1     = 0.
     2948   end procedure.
     2949   procedure display-str1  :
     2950   define variable ll as int no-undo.
     2951     assign
     2952       num#str# = num#str# + 1
     2953       num#col# = 0
     2954       v-gds-num = v-gds-num + 1
     2955     .
     2956     if use-column[28] then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( v-gds-num , num#str# , num#col#   ) .   end.
     2957     if use-column[1]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_dec ( gds-zap-b-code , num#str# , num#col#   ) .   end.
     2958     if use-column[2]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-artic, num#str# , num#col#   )   .   end.
     2959     if use-column[3]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( if xlongName then gds-zap-gds-long-name else gds-zap-gds-name, num#str# , num#col#   ) .  end.
     2960     if use-column[4]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-unit-base, num#str# , num#col#   ) . end.
     2961     if use-column[5]  then do: assign num#col#  = num#col# + 1 .   run macr_excel_char ( gds-zap-type, num#str# , num#col#   ) .      end.
     2962   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     2963   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     2964   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     2965   def var l-nk as integer no-undo .
     2966     Assign
     2967       LL = 0
     2968       KK = 1
     2969     .
     2970     if xShowCost      Then DO: KK = KK + 1. End.
     2971     if xShowCostNDS   Then DO: KK = KK + 1. End.
     2972     if xShowCrsa      Then DO: KK = KK + 1. End.
     2973     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     2974     if xShowSale      Then DO: KK = KK + 1. End.
     2975     if xShowSaleNds   Then DO: KK = KK + 1. End.
     2976     if xShowSaleslt   Then DO: KK = KK + 1. End.
     2977     if xShowmediator  Then DO: KK = KK + 1. End.
     2978     if x-tog-wt       then do: KK = KK + 1. End.
     2979     if x-tog-ms       then do: KK = KK + 1. End.
     2980     if xDens          then do: KK = KK + 1. End.
     2981     repeat i = 1 to 13 :
     2982       if i = 7 then next.
     2983       if NOT xShowCost      and i = 2   Then  next.
     2984       if NOT xShowCostNDS   and i = 3   Then  next.
     2985       if NOT xShowCrsa      and i = 5   Then  next.
     2986       if NOT xShowCrsaNds   and i = 6   Then  next.
     2987       if NOT xShowSale      and i = 8   Then  next.
     2988       if NOT xShowSaleNds   and i = 9   Then  next.
     2989       if NOT xShowSaleSlt   and i = 10  Then  next.
     2990       if NOT xShowmediator  and i = 4   Then  next.
     2991       if not x-tog-wt       and i = 11  then  next.
