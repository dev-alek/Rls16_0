     3204     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-rv      [i] -  bi-oborot-rv      [3] ),  i). end.
     3205     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-vt                [i] -  bi-oborot-vt                [3] ),  i). end.
     3206     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ot           [i] -  bi-oborot-ot           [3] ),  i). end.
     3207     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-ostatok-end                            [i] -  bi-ostatok-end                            [3] ),  i). end.
     3208     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-ap [i] -  bi-oborot-ap[3] ),  i). end.
     3209     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bi-oborot-pc [i] -  bi-oborot-pc[3] ),  i). end.
     3210     if i = 13 then do :
     3211       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3212     end.
     3213     else do:
     3214       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3215       (                                                                                      (bi-oborot-ee         [i] +
     3216                                                                                               bi-oborot-re     [i] +
     3217                                                                                               bi-oborot-es    [i] +
     3218                                                                                               bi-oborot-rs[i]) -
     3219                                                                                             (bi-oborot-ee         [3] +
     3220                                                                                               bi-oborot-re     [3] +
     3221                                                                                               bi-oborot-es    [3] +
     3222                                                                                               bi-oborot-rs[3] ) ) , i ). end.
     3223     end.
     3224     end.
     3225     end.
     3226    run new-tmp-page .
     3227   end procedure.
     3228   procedure display-bo  :
     3229   define variable ll as int no-undo.
     3230   define variable kk as int no-undo.
     3231     num#str# = num#str# + 1.
     3232     num#col# = 1.
     3233     run macr_excel_char_with_format( string("ИТОГО ПО ОБЪЕКТАМ")  , num#str# , num#col#  ) .
     3234     num#col#  = 0 .
     3235     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3236     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3237     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3238     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3239     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3240     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3241     run macr_cell_format
     3242         ( 10    ,
     3243           true  ,
     3244           false ,
     3245           ?    ,
     3246           num#str# ,
     3247           1 ,
     3248           num#str# ,
     3249           (mp + ll + (kk * (27 - 8)))
     3250           ) .
     3251   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3252   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3253   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bo-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3254   def var l-nk as integer no-undo .
     3255     Assign
     3256       LL = 0
     3257       KK = 1
     3258     .
     3259     if xShowCost      Then DO: KK = KK + 1. End.
     3260     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3261     if xShowCrsa      Then DO: KK = KK + 1. End.
     3262     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3263     if xShowSale      Then DO: KK = KK + 1. End.
     3264     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3265     if xShowSaleslt   Then DO: KK = KK + 1. End.
     3266     if xShowmediator  Then DO: KK = KK + 1. End.
     3267     if x-tog-wt       then do: KK = KK + 1. End.
     3268     if x-tog-ms       then do: KK = KK + 1. End.
     3269     if xDens          then do: KK = KK + 1. End.
     3270     repeat i = 1 to 13 :
     3271       if i = 7 then next.
     3272       if NOT xShowCost      and i = 2   Then  next.
     3273       if NOT xShowCostNDS   and i = 3   Then  next.
     3274       if NOT xShowCrsa      and i = 5   Then  next.
     3275       if NOT xShowCrsaNds   and i = 6   Then  next.
     3276       if NOT xShowSale      and i = 8   Then  next.
     3277       if NOT xShowSaleNds   and i = 9   Then  next.
     3278       if NOT xShowSaleSlt   and i = 10  Then  next.
     3279       if NOT xShowmediator  and i = 4   Then  next.
     3280       if not x-tog-wt       and i = 11  then  next.
     3281       if not x-tog-ms       and i = 12  then  next.
     3282       if not xDens          and i = 13  then  next.
     3283       assign
     3284         LL = LL + 1
     3285         l-nk = mp-1
     3286       .
     3287     if x-vat or i <> 2  then do:
     3288     if use-column[6]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-start                          [i] ,  i). end.
     3289     if use-column[7]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ie          [i] ,  i). end.
     3290     if use-column[8]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-iv          [i] ,  i). end.
     3291     if use-column[9]  then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-im           [i] ,  i). end.
     3292     if use-column[10] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ee          [i] ,  i). end.
     3293     if use-column[11] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ev          [i] ,  i). end.
     3294     if use-column[12] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-em           [i] ,  i). end.
     3295     if use-column[13] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-we          [i] ,  i). end.
     3296     if use-column[14] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-es     [i] ,  i). end.
     3297     if use-column[15] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rs [i] ,  i). end.
     3298     if use-column[16] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-re      [i] ,  i). end.
     3299     if use-column[17] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ep       [i] ,  i). end.
     3300     if use-column[18] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-rv      [i] ,  i). end.
     3301     if use-column[19] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-vt                [i] ,  i). end.
     3302     if use-column[20] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ot           [i] ,  i). end.
     3303     if use-column[22] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-ostatok-end                            [i] ,  i). end.
     3304     if use-column[25] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-ap [i] ,  i). end.
     3305     if use-column[26] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , bo-oborot-pc [i] ,  i). end.
     3306     if i = 13 then do:
     3307       if "bo-" = "b1-" or "bo-" = "b2-" or "bo-" = "bi-" or "bo-" = "bo-" then do:
     3308          if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , 0 ,  i). end.
     3309       end.
     3310       else do:
     3311         if use-column[27] then do: l-nk = l-nk + 1 .  run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , ( if ABS(bo-oborot-ee         [1] +
     3312                                                                                                                                       bo-oborot-re     [1] +
     3313                                                                                                                                       bo-oborot-es    [1] +
     3314                                                                                                                                       bo-oborot-rs[1] ) <> 0
     3315                                                                                                                               then
     3316                                                                                                                                   ABS(bo-oborot-ee         [11] +
     3317                                                                                                                                       bo-oborot-re     [11] +
     3318                                                                                                                                       bo-oborot-es    [11] +
     3319                                                                                                                                       bo-oborot-rs[11] )
     3320                                                                                                                                   /
     3321                                                                                                                                   ABS(bo-oborot-ee         [1] +
     3322                                                                                                                                       bo-oborot-re     [1] +
     3323                                                                                                                                       bo-oborot-es    [1] +
     3324                                                                                                                                       bo-oborot-rs[1] )
     3325                                                                                                                               else 0 )
     3326         ,  i). end.
     3327       end.
     3328     end.
     3329     else do:
     3330     if use-column[27] then do: l-nk = l-nk + 1 .    run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  , (bo-oborot-ee         [i] +
     3331                                                                                                                           bo-oborot-re     [i] +
     3332                                                                                                                           bo-oborot-es    [i] +
     3333                                                                                                                           bo-oborot-rs[i] )
     3334     ,  i). end.
     3335     end.
     3336     end.
     3337     if x-vat = false  and i = 2 then do:
     3338     if use-column[6]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-ostatok-start                          [i] -  bo-ostatok-start                          [3] ),  i). end.
     3339     if use-column[7]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ie          [i] -  bo-oborot-ie          [3] ),  i). end.
     3340     if use-column[8]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-iv          [i] -  bo-oborot-iv          [3] ),  i). end.
     3341     if use-column[9]  then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-im           [i] -  bo-oborot-im           [3] ),  i). end.
     3342     if use-column[10] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ee          [i] -  bo-oborot-ee          [3] ),  i). end.
     3343     if use-column[11] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-ev          [i] -  bo-oborot-ev          [3] ),  i). end.
     3344     if use-column[12] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( bo-oborot-em           [i] -  bo-oborot-em           [3] ),  i). end.
