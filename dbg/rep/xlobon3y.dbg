     3669     if use-column[13] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-we          [i] -  b2-oborot-we          [3] ),  i). end.
     3670     if use-column[14] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-es     [i] -  b2-oborot-es     [3] ),  i). end.
     3671     if use-column[15] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rs [i] -  b2-oborot-rs [3] ),  i). end.
     3672     if use-column[16] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-re      [i] -  b2-oborot-re      [3] ),  i). end.
     3673     if use-column[17] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ep       [i] -  b2-oborot-ep       [3] ),  i). end.
     3674     if use-column[18] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-rv      [i] -  b2-oborot-rv      [3] ),  i). end.
     3675     if use-column[19] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-vt                [i] -  b2-oborot-vt                [3] ),  i). end.
     3676     if use-column[20] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ot           [i] -  b2-oborot-ot           [3] ),  i). end.
     3677     if use-column[22] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-ostatok-end                            [i] -  b2-ostatok-end                            [3] ),  i). end.
     3678     if use-column[25] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-ap [i] -  b2-oborot-ap[3] ),  i). end.
     3679     if use-column[26] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,( b2-oborot-pc [i] -  b2-oborot-pc[3] ),  i). end.
     3680     if i = 13 then do :
     3681       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure (mp-1 + ll + (kk * (l-nk - mp))  , 0  , i ). end.
     3682     end.
     3683     else do:
     3684       if use-column[27] then do: l-nk = l-nk + 1 . run ex-display in this-procedure  (mp-1 + ll + (kk * (l-nk - mp))  ,
     3685       (                                                                                      (b2-oborot-ee         [i] +
     3686                                                                                               b2-oborot-re     [i] +
     3687                                                                                               b2-oborot-es    [i] +
     3688                                                                                               b2-oborot-rs[i]) -
     3689                                                                                             (b2-oborot-ee         [3] +
     3690                                                                                               b2-oborot-re     [3] +
     3691                                                                                               b2-oborot-es    [3] +
     3692                                                                                               b2-oborot-rs[3] ) ) , i ). end.
     3693     end.
     3694     end.
     3695     end.
     3696    run new-tmp-page .
     3697     run macr_cell_format
     3698     ( 10    ,
     3699       true  ,
     3700       true  ,
     3701       33    ,
     3702       num#str# ,
     3703       1 ,
     3704       num#str# ,
     3705       num#col# ) .
     3706     end.
     3707     end.
     3708   end procedure.
