     5125   assign temp#sum-type.sum-type = 'sadt':U + 're':U temp#sum-type.xi = 205 . create temp#sum-type.
     5126   assign temp#sum-type.sum-type = 'sadt':U + 'rs':U temp#sum-type.xi = 206 . create temp#sum-type.
     5127   assign temp#sum-type.sum-type = 'sadt':U + 'we':U temp#sum-type.xi = 207 . create temp#sum-type.
     5128   assign temp#sum-type.sum-type = 'sadt':U + 'vt':U temp#sum-type.xi = 208 . create temp#sum-type.
     5129   assign temp#sum-type.sum-type = 'sadt':U + 'iv':U temp#sum-type.xi = 209 . create temp#sum-type.
     5130   assign temp#sum-type.sum-type = 'sadt':U + 'ev':U temp#sum-type.xi = 210 . create temp#sum-type.
     5131   assign temp#sum-type.sum-type = 'sadt':U + 'rv':U temp#sum-type.xi = 211 . create temp#sum-type.
     5132   assign temp#sum-type.sum-type = 'sadt':U + 'em':U temp#sum-type.xi = 212 . create temp#sum-type.
     5133   assign temp#sum-type.sum-type = 'sadt':U + 'wm':U temp#sum-type.xi = 212 . create temp#sum-type.
     5134   assign temp#sum-type.sum-type = 'sadt':U + 'im':U temp#sum-type.xi = 213 . create temp#sum-type.
     5135   assign temp#sum-type.sum-type = 'sadt':U + 'ot':U temp#sum-type.xi = 214 .
     5136   create temp#sum-type.
     5137   assign temp#sum-type.sum-type = 'sadt':U + 'ap':U temp#sum-type.xi = 215 . create temp#sum-type.
     5138   assign temp#sum-type.sum-type = 'sadt':U + 'pc':U temp#sum-type.xi = 216 .
     5139   end procedure.
     5140   procedure new-tmp-page :
     5141    do
     5142    on error undo, return error return-value
     5143    :
     5144       if   num#str#  >=  63000  then do:
     5145           output stream macr_excel  close .
     5146           run paramls-write in this-procedure
     5147             (input "file"
     5148             ,input string(v-ind)
     5149             ,input v-file-name
     5150             ) .
     5151           run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5152           output stream  macr_excel to value(v-file-name) .
     5153           v-ind = v-ind + 1 .
     5154           num#str# = 0 .
     5155   define variable old-s as integer no-undo .
     5156   define variable old-s2 as integer no-undo .
     5157       assign
     5158       old-s =   num#str#
     5159       .
     5160       run make-col .
     5161       assign
     5162         old-s2 =   num#str#
     5163       .
     5164      num#str# = old-s + 1  .
     5165      run proc-print-header .
     5166      num#str# = old-s2     .
     5167       end.
     5168    end.
     5169   end procedure.
     5170   procedure pp :
     5171   define input parameter ll as integer no-undo .
     5172   define input parameter uu as integer no-undo .
     5173   define input parameter ff as character no-undo .
     5174   End procedure.
     5175   procedure find-last-prise-med :
     5176   define input parameter p-artic     like ub.goods.artic no-undo .
     5177   define input parameter p-prod-type like ub.goods.prod-type no-undo .
     5178   define input parameter p-prod-code like ub.goods.prod-code no-undo .
     5179   define input parameter p-host-code like ub.gds-obj.host-code no-undo .
     5180   define output parameter  p-price   like ub.gds-obj.last-base no-undo .
     5181   define buffer p-gds-obj   for  ub.gds-obj .
     5182   define buffer buf_trn-doc for  ub.trn-doc .
     5183   define variable v-fact-order as decimal no-undo .
     5184   p-price = 0 .
     5185     define variable v-in-date as date      no-undo .
     5186     define variable fl as logical no-undo .
     5187     fl = yes.
     5188     v-fact-order = 0 .
     5189     for each tt-obj-list no-lock break by tt-obj-list.obj-type by tt-obj-list.obj-code
     5190     :
     5191       find first p-gds-obj no-lock
     5192         where p-gds-obj.artic     = p-artic         and
     5193                 p-gds-obj.prod-type = p-prod-type     and
     5194                 p-gds-obj.prod-code = p-prod-code     and
     5195                 p-gds-obj.obj-code  = tt-obj-list.obj-code and
     5196                 p-gds-obj.obj-type  = tt-obj-list.obj-type
     5197         no-error .
     5198       if available p-gds-obj then do:
     5199       if p-gds-obj.in-date = ?  then next .
     5200       if fl = yes then do:
     5201         assign
     5202           v-in-date = p-gds-obj.in-date
     5203           p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5204           fl = no
     5205       .
     5206        find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error  .
     5207        if available buf_trn-doc  then  v-fact-order = buf_trn-doc.fact-order .
     5208       end.
     5209         if p-gds-obj.in-date >= v-in-date   then do:
     5210            if p-gds-obj.in-date = v-in-date then do:
     5211               find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5212               if available buf_trn-doc  then
     5213                   if buf_trn-doc.fact-order >  v-fact-order   then do:
     5214                     assign
     5215                       v-fact-order = buf_trn-doc.fact-order
     5216                       p-price   =  if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5217                       v-in-date =   p-gds-obj.in-date
     5218                     .
     5219                   end.
     5220            end.
     5221            else do:
     5222             find first buf_trn-doc no-lock  where buf_trn-doc.doc-code = p-gds-obj.in-code no-error .
     5223             if available buf_trn-doc  then
     5224                 assign
     5225                   p-price   =    if tPrintRubl then  p-gds-obj.last-rubl else  p-gds-obj.last-base
     5226                   v-in-date =    p-gds-obj.in-date
     5227                   v-fact-order = buf_trn-doc.fact-order .
     5228                 .
     5229             end.
     5230           if p-price = ? then   p-price  = 0 .
     5231         end.
     5232       end.
     5233     End .
     5234     if p-price = ? then   p-price  = 0 .
     5235   end procedure.
     5236   procedure find-mediator :
     5237   define input  parameter c-host-code as integer no-undo .
     5238   define input  parameter p-Showmediatr as logical no-undo .
     5239   define output parameter p-host-code as integer no-undo .
     5240   define output parameter p-flag as logical no-undo .
     5241   define buffer b-sysconf  for ub.sysconf.
     5242    p-host-code = 0 .
     5243    p-flag  = true .
     5244       if p-Showmediatr = true then do:
     5245       find first ub.sysconf where ub.sysconf.avrg-price = true no-lock no-error .
     5246             if avail ub.sysconf then DO :
     5247               p-host-code = ub.sysconf.host-code.
     5248               if tPrintRubl = false then do:
     5249                     find first b-sysconf where b-sysconf.host-code = c-host-code no-lock no-error .
     5250                           if  ub.sysconf.base-code <> b-sysconf.base-code then DO:
     5251                                 p-flag  = false  .
     5252                                 message "Базовая валюта посредника и базовая валюта текущей фирмы не совпадает . Нельзя получить отчет в валюте !"
     5253                                 view-as alert-box error.
     5254                           end.
     5255               end.
     5256             end.
     5257             for each ub.shop no-lock where ub.shop.host-code = p-host-code :
     5258                 create tt-obj-list no-error .
     5259                 assign tt-obj-list.obj-type = 'маг':U
     5260                        tt-obj-list.obj-code = ub.shop.obj-code no-error .
     5261             end.
     5262             for each ub.store no-lock where ub.store.host-code = p-host-code :
     5263                 create tt-obj-list no-error .
     5264                 assign tt-obj-list.obj-type = 'скл':U
     5265                        tt-obj-list.obj-code = ub.store.obj-code no-error .
     5266             end.
     5267       End.
     5268    End procedure .
     5269   PROCEDURE ob-line-stk  :
     5270   define input  parameter x-store-code     like ub.clients.obj-code      no-undo.
     5271   define input  parameter x-store-type     like ub.clients.obj-type      no-undo.
     5272   define INPUT  parameter x-artic          like ub.stk-line.artic        no-undo.
     5273   define INPUT  parameter x-prod-code      like ub.stk-line.prod-code    no-undo.
     5274   define INPUT  parameter x-prod-type      like ub.stk-line.prod-type    no-undo.
     5275   define INPUT  parameter x-Fact-order-1   like ub.stk-line.Fact-order   no-undo.
     5276   define INPUT  parameter x-Fact-order-2   like ub.stk-line.Fact-order   no-undo.
     5277   define input  parameter x-sum-type       like ub.stk-line.sum-type     no-undo.
     5278   define input  parameter x-cat-id         like ub.stk-line.cat-id       no-undo.
     5279   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type  no-undo.
     5280   define input  parameter xTog-obj         as log                     no-undo.
     5281   define input  parameter xi               as int                     no-undo.
     5282   define output  parameter Quntity         like ub.stk-line.fact-qnty   no-undo.
     5283   define output  parameter sum             like ub.stk-line.sum-base    no-undo.
     5284   define output  parameter vat             like ub.stk-line.sum-base    no-undo.
     5285   define output  parameter slt             like ub.stk-line.sum-base    no-undo.
     5286   define output  parameter disc            like ub.stk-line.sum-base    no-undo.
     5287   define variable  First-qnty   like ub.stk-line.fact-qnty   no-undo.
     5288   define variable  Second-qnty  like ub.stk-line.fact-qnty   no-undo.
     5289   define variable  First-sum   like ub.stk-line.sum-base   no-undo.
     5290   define variable  Second-sum  like ub.stk-line.sum-base   no-undo.
     5291   define variable  First-vat   like ub.stk-line.sum-base   no-undo.
     5292   define variable  Second-vat  like ub.stk-line.sum-base   no-undo.
     5293   define variable  First-slt   like ub.stk-line.sum-base   no-undo.
     5294   define variable  Second-slt  like ub.stk-line.sum-base   no-undo.
     5295   define variable  First-disc   like ub.stk-line.sum-base   no-undo.
     5296   define variable  Second-disc  like ub.stk-line.sum-base   no-undo.
     5297   define buffer stk-line2 for ub.stk-line .
     5298   if x-Fact-order-2 < x-Fact-order-1 Then x-Fact-order-2 = x-Fact-order-1.
     5299    Assign
     5300      First-qnty  = 0
     5301      Second-qnty = 0
     5302      Quntity     = 0
     5303      First-sum  = 0
     5304      Second-sum = 0
     5305      sum        = 0
     5306      First-vat  = 0
     5307      Second-vat = 0
     5308      vat        = 0
     5309      First-slt   = 0
     5310      Second-slt  = 0
     5311      slt         = 0
     5312      First-disc  = 0
     5313      Second-disc = 0
     5314      disc        = 0
     5315     .
     5316     For each obj-list  no-lock :
     5317      if  xTog-obj THEN
     5318          if   NOT(    x-store-type     = obj-list.obj-type
     5319               AND    x-store-code      = obj-list.obj-code ) Then NEXT.
     5320      FOR each temp#sum-type where temp#sum-type.xi = xi no-lock :
     5321         find last ub.stk-line no-lock
     5322           where ub.stk-line.obj-type   = obj-list.obj-type
     5323             and ub.stk-line.obj-code   = obj-list.obj-code
     5324             and ub.stk-line.artic      = x-artic
     5325             and ub.stk-line.prod-type  = x-prod-type
     5326             and ub.stk-line.prod-code  = x-prod-code
     5327             and ub.stk-line.sum-type   = temp#sum-type.sum-type
     5328             and ub.stk-line.cat-id     = '##,##':U
     5329             and ub.stk-line.fact-order <= x-fact-order-1
     5330           use-index category
     5331           no-error .
     5332         if available ub.stk-line then do:
     5333           assign
     5334             First-qnty = First-qnty + ub.stk-line.fact-qnty
     5335             First-sum  = First-sum  + (if tprintrubl then ub.stk-line.sum-rubl   else ub.stk-line.sum-base  )
     5336             First-vat  = First-vat  + (if tprintrubl then ub.stk-line.vat-rubl   else ub.stk-line.vat-base  )
     5337             First-disc = First-disc + (if tprintrubl then ub.stk-line.other-rubl else ub.stk-line.other-base )
     5338             First-slt  = First-slt  + (if tprintrubl then ub.stk-line.slt-rubl   else ub.stk-line.slt-base   )
     5339           .
     5340         end.
     5341         find last stk-line2 no-lock
     5342           where stk-line2.obj-code   = obj-list.obj-code
     5343             and stk-line2.obj-type   = obj-list.obj-type
     5344             and stk-line2.artic      = x-artic
     5345             and stk-line2.prod-type  = x-prod-type
     5346             and stk-line2.prod-code  = x-prod-code
     5347             and stk-line2.sum-type   = temp#sum-type.sum-type
     5348             and stk-line2.cat-id     = '##,##':U
     5349             and stk-line2.fact-order <= x-fact-order-2
     5350           use-index category
     5351           no-error .
     5352         if available stk-line2 then do:
     5353           assign
     5354             Second-qnty = Second-qnty + Stk-line2.fact-qnty
     5355             Second-sum  = Second-sum  + (if tprintrubl then stk-line2.sum-rubl else stk-line2.sum-base    )
     5356             Second-vat  = Second-vat  + (if tprintrubl then stk-line2.vat-rubl else stk-line2.vat-base    )
     5357             second-disc = second-disc + (if tprintrubl then stk-line2.other-rubl else stk-line2.other-base )
     5358             second-slt  = second-slt  + (if tprintrubl then stk-line2.slt-rubl   else stk-line2.slt-base   )
     5359           .
     5360         end.
     5361      end.
     5362    end.
     5363    Assign
     5364      Quntity = Second-qnty - first-qnty
     5365      sum     = Second-sum  - first-sum
     5366      vat     = Second-vat  - first-vat
     5367      slt     = Second-slt  - first-slt
     5368      disc    = Second-disc  - first-disc
     5369      .
     5370   END PROCEDURE.
     5371   procedure calc-ms-wt :
     5372   define input        parameter p-oborot-num      as decimal   no-undo .
     5373   define input        parameter p-gds-wt-ms-base  as decimal   no-undo .
     5374   define input-output parameter p-oborot          as decimal   no-undo .
     5375   define input-output parameter p-bi-oborot       as decimal   no-undo .
     5376   define input-output parameter p-bo-oborot       as decimal   no-undo .
     5377   define input-output parameter p-b1-oborot       as decimal   no-undo .
     5378   define input-output parameter p-b2-oborot       as decimal   no-undo .
     5379   do
     5380   on error undo, return error return-value
     5381   :
     5382   if p-is-petrol = true then return .
     5383     assign
     5384       p-oborot    = p-oborot-num * p-gds-wt-ms-base
     5385       p-bi-oborot = p-bi-oborot + p-oborot
     5386       p-bo-oborot = p-bo-oborot + p-oborot
     5387       p-b1-oborot = p-b1-oborot + p-oborot
     5388       p-b2-oborot = p-b2-oborot + p-oborot
     5389     .
     5390   end.
     5391   end procedure.
     5392   procedure calc-dens :
     5393   define input        parameter p-ostatok-wt       as decimal   no-undo .
     5394   define input        parameter p-ostatok          as decimal   no-undo .
     5395   define input-output parameter p-density          as decimal   no-undo .
     5396   define input-output parameter p-bi-density       as decimal   no-undo .
     5397   define input-output parameter p-bo-density       as decimal   no-undo .
     5398   define input-output parameter p-b1-density       as decimal   no-undo .
     5399   define input-output parameter p-b2-density       as decimal   no-undo .
     5400   do
     5401   on error undo, return error return-value
     5402   :
     5403   if p-is-petrol = false then return .
     5404     assign
     5405       p-density    = if abs(p-ostatok) < abs(p-ostatok-wt) then abs(p-ostatok / p-ostatok-wt) else 0
     5406       p-bi-density = 0
     5407       p-bo-density = 0
     5408       p-b1-density = 0
     5409       p-b2-density = 0
     5410     .
     5411   end.
     5412   end procedure.
     5413   procedure calc-pt-ob :
     5414   define input  parameter p-ext-doc-type    as character no-undo .
     5415   define input  parameter x-store-type      as character no-undo .
     5416   define input  parameter x-store-code      as integer   no-undo .
     5417   define input  parameter p-artic           as character no-undo .
     5418   define input  parameter p-prod-type       as character no-undo .
     5419   define input  parameter p-prod-code       as integer   no-undo .
     5420   define input-output parameter p-oborot    as decimal   no-undo .
     5421   define input-output parameter p-bi-oborot as decimal   no-undo .
     5422   define input-output parameter p-bo-oborot as decimal   no-undo .
     5423   define input-output parameter p-b1-oborot as decimal   no-undo .
     5424   define input-output parameter p-b2-oborot as decimal   no-undo .
     5425     do
     5426     on error undo, return error return-value
     5427     :
     5428   define variable v-oborot as decimal   no-undo .
     5429   define buffer buf_doc-line  for ub.doc-line  .
     5430   define buffer buf_inv-line  for ub.inv-line  .
     5431   define buffer buf1_obj-list for obj-list .
     5432   assign
     5433     v-oborot = 0
     5434   .
     5435   if p-is-petrol = false   then return .
     5436     for each buf1_obj-list no-lock :
     5437      if  xtog-obj then
     5438          if   not(x-store-type     = buf1_obj-list.obj-type
     5439               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5440       for each buf_doc-line  no-lock where
     5441             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5442             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5443             buf_doc-line.artic        = p-artic and
     5444             buf_doc-line.prod-type    = p-prod-type and
     5445             buf_doc-line.prod-code    = p-prod-code and
     5446             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5447             buf_doc-line.status_      = 'факт':U        and
     5448             buf_doc-line.fact-order   <= fact-order-2  and
     5449             buf_doc-line.fact-order   >= fact-order-1
     5450             :
     5451             for each buf_inv-line  no-lock where
     5452                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5453                 buf_inv-line.artic        = buf_doc-line.artic and
     5454                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5455                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5456                 :
     5457                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5458                     else do:
     5459                     if p-ext-doc-type = 'we':U    or
     5460                        p-ext-doc-type = 'ee':U    or
     5461                        p-ext-doc-type = 'ev':U    or
     5462                        p-ext-doc-type = 'ep':U or
     5463                        p-ext-doc-type = 'em':U     or
     5464                        p-ext-doc-type = 'wm':U     or
     5465                        p-ext-doc-type = 'es':U   then
     5466                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5467                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5468                     end.
     5469             end.
     5470       end.
     5471   end.
     5472   assign
     5473     p-oborot    = v-oborot
     5474     p-bi-oborot = p-bi-oborot + v-oborot
     5475     p-bo-oborot = p-bo-oborot + v-oborot
     5476     p-b1-oborot = p-b1-oborot + v-oborot
     5477     p-b2-oborot = p-b2-oborot + v-oborot
     5478   .
     5479   end.
     5480   end procedure.
     5481   procedure calc-density :
     5482   define input        parameter p-ext-doc-type  as character no-undo .
     5483   define input        parameter x-store-type    as character no-undo .
     5484   define input        parameter x-store-code    as integer   no-undo .
     5485   define input        parameter p-artic         as character no-undo .
     5486   define input        parameter p-prod-type     as character no-undo .
     5487   define input        parameter p-prod-code     as integer   no-undo .
     5488   define input-output parameter p-density       as decimal   no-undo .
     5489   define input-output parameter p-bi-density    as decimal   no-undo .
     5490   define input-output parameter p-bo-density    as decimal   no-undo .
     5491   define input-output parameter p-b1-density    as decimal   no-undo .
     5492   define input-output parameter p-b2-density    as decimal   no-undo .
     5493     do
     5494     on error undo, return error return-value
     5495     :
     5496   define variable v-oborot    as decimal   no-undo .
     5497   define variable v-fact-qnty as decimal   no-undo .
     5498   define buffer buf_doc-line  for ub.doc-line  .
     5499   define buffer buf_inv-line  for ub.inv-line  .
     5500   define buffer buf1_obj-list for obj-list .
     5501   assign
     5502     v-oborot     = 0
     5503     v-fact-qnty  = 0
     5504   .
     5505   if p-is-petrol = false   then return .
     5506     for each buf1_obj-list no-lock :
     5507      if  xtog-obj then
     5508          if   not(x-store-type     = buf1_obj-list.obj-type
     5509               and x-store-code     = buf1_obj-list.obj-code ) then next.
     5510       for each buf_doc-line  no-lock where
     5511             buf_doc-line.obj-type     = buf1_obj-list.obj-type and
     5512             buf_doc-line.obj-code     = buf1_obj-list.obj-code and
     5513             buf_doc-line.artic        = p-artic and
     5514             buf_doc-line.prod-type    = p-prod-type and
     5515             buf_doc-line.prod-code    = p-prod-code and
     5516             buf_doc-line.ext-doc-type = p-ext-doc-type and
     5517             buf_doc-line.status_      = 'факт':U        and
     5518             buf_doc-line.fact-order   <= fact-order-2  and
     5519             buf_doc-line.fact-order   >= fact-order-1
     5520             :
     5521             assign v-fact-qnty = v-fact-qnty + buf_doc-line.fact-qnty.
     5522             for each buf_inv-line  no-lock where
     5523                 buf_inv-line.doc-code     = buf_doc-line.doc-code and
     5524                 buf_inv-line.artic        = buf_doc-line.artic and
     5525                 buf_inv-line.prod-type    = buf_doc-line.prod-type and
     5526                 buf_inv-line.prod-code    = buf_doc-line.prod-code
     5527                 :
     5528                 if p-ext-doc-type = 'vt':U  then v-oborot = v-oborot + buf_doc-line.cli-qnty .
     5529                     else do:
     5530                     if p-ext-doc-type = 'we':U    or
     5531                        p-ext-doc-type = 'ee':U    or
     5532                        p-ext-doc-type = 'ev':U    or
     5533                        p-ext-doc-type = 'ep':U or
     5534                        p-ext-doc-type = 'em':U     or
     5535                        p-ext-doc-type = 'wm':U     or
     5536                        p-ext-doc-type = 'es':U   then
     5537                           v-oborot = v-oborot - buf_inv-line.wast-cli-qnty .
     5538                           else v-oborot = v-oborot + buf_inv-line.wast-cli-qnty .
     5539                     end.
     5540             end.
     5541       end.
     5542       assign
     5543         p-density    = if ( v-fact-qnty <> 0 and ABS(v-oborot) < ABS(v-fact-qnty)) then ABS(v-oborot / v-fact-qnty) else 0
     5544       .
     5545       assign
     5546         p-bi-density = p-density
     5547         p-bo-density = 0
     5548         p-b1-density = 0
     5549         p-b2-density = 0
     5550       .
     5551   end.
     5552   end.
     5553   end procedure.
