     3085   procedure display-bi  :
     3086   define variable ll as int no-undo.
     3087   define variable kk as int no-undo.
     3088     num#col#  = 0 .
     3089     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3090     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3091     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3092     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3093     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3094     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3095     run macr_cell_format
     3096                                 ( 10    ,
     3097                                   true  ,
     3098                                   false ,
     3099                                   ?    ,
     3100                                   num#str# ,
     3101                                   1 ,
     3102                                   num#str# ,
     3103                                   (mp + ll + (kk * (27 - 8)))
     3104                                   ) .
     3105   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3106   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3107   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(bi-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3108   def var l-nk as integer no-undo .
     3109     Assign
     3110       LL = 0
