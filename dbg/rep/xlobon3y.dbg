     3374   procedure display-b1  :
     3375   define variable ll as int no-undo.
     3376   define variable kk as int no-undo.
     3377     b1-null-str# = 1.
     3378     b1-null-str2# = 1.
     3379     if not show-negativ   then  run b1-null-str-pr   in this-procedure .
     3380     if not show-negativ-2 then  run b1-null-str-pr2  in this-procedure .
     3381      if not     ( not show-negativ   and b1-null-str#  = 0  ) then do :
     3382         if not  ( not show-negativ-2 and b1-null-str2# = 0  ) then do :
     3383                 if sums-only then do:
     3384                     if fr0 = true then do:
     3385                           num#str# = num#str# + 1     .
     3386                           num#col# = 1.
     3387                           run macr_excel_char_with_format(  caps(tmp#stroka0)  , num#str# , num#col#  ) .
     3388                           run macr_cell_format
     3389                           ( 10    ,
     3390                             true  ,
     3391                             true  ,
     3392                             36    ,
     3393                             num#str# ,
     3394                             num#col# ,
     3395                             num#str# ,
     3396                             5 ) .
     3397                         fr0 = false .
     3398                       end.
     3399                  end.
     3400     num#str# = num#str# + 1     .
     3401     num#col# = 2 .
     3402     if substitute( "&1", sf1:screen-value )  <> "?" then
     3403       run macr_excel_char_with_format(  string(s-bar-code +
     3404                                    sf1:screen-value +
     3405                                    gds-zap-artic +
     3406                                    sf2:screen-value +
     3407                                    gds-zap-gds-name +
     3408                                    temp-str-2    )  , num#str# , num#col#  ) .
     3409      else
     3410       run macr_excel_char_with_format(  string(s-bar-code +
     3411                                    gds-zap-artic +
     3412                                    gds-zap-gds-name +
     3413                                    temp-str-2    )  , num#str# , num#col#  ) .
     3414     num#col#  = 0 .
     3415     if use-column[28] then assign num#col#  = num#col#  + 1 .
     3416     if use-column[1] then  assign num#col#  = num#col#  + 1 .
     3417     if use-column[2] then  assign num#col#  = num#col#  + 1 .
     3418     if use-column[3] then  assign num#col#  = num#col#  + 1 .
     3419     if use-column[4] then  assign num#col#  = num#col#  + 1 .
     3420     if use-column[5] then  assign num#col#  = num#col#  + 1 .
     3421   if use-column[21] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-disc [1],2 ), num#str# , num#col#   ).     end.
     3422   if use-column[23] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-eff  [1],2 ), num#str# , num#col#   ).     end.
     3423   if use-column[24] then do: Assign num#col#  = num#col#  + 1.   run macr_excel_dec ( Round(b1-oborot-prc  [1],2 ), num#str# , num#col#   ).     end.
     3424   def var l-nk as integer no-undo .
     3425     Assign
     3426       LL = 0
     3427       KK = 1
     3428     .
     3429     if xShowCost      Then DO: KK = KK + 1. End.
     3430     if xShowCostNDS   Then DO: KK = KK + 1. End.
     3431     if xShowCrsa      Then DO: KK = KK + 1. End.
     3432     if xShowCrsaNds   Then DO: KK = KK + 1. End.
     3433     if xShowSale      Then DO: KK = KK + 1. End.
     3434     if xShowSaleNds   Then DO: KK = KK + 1. End.
     3435     if xShowSaleslt   Then DO: KK = KK + 1. End.
