      184   .
      185   procedure create_obj-list :
      186      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      187      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      188      do
      189      on error undo, return error return-value
      190      :
      191         define buffer cli-obj for ub.clients .
      192         define variable p-var as integer no-undo .
      193         define buffer buf_obj-list for obj-list .
      194         find last buf_obj-list  use-index pi no-error .
      195         if available buf_obj-list
      196         then
      197            p-var = buf_obj-list.obj-id + 1.
      198         else
      199            p-var = 1.
      200         find first cli-obj where
      201                   cli-obj.obj-type = p-obj-type
      202               and cli-obj.obj-code = p-obj-code
      203         no-lock no-error.
      204         if available cli-obj
      205         then do:
      206            create buf_obj-list.
      207            assign
      208               buf_obj-list.obj-id   = p-var
      209               buf_obj-list.obj-code = cli-obj.obj-code
      210               buf_obj-list.obj-type = cli-obj.obj-type
      211               buf_obj-list.obj-name = cli-obj.obj-name
      212               buf_obj-list.db-num   = cli-obj.db-num
      213            .
      214         end.
      215      end.
      216   end.
