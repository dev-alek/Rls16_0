      173   def
      174    shared
      175   temp-table  obj-list no-undo
      176     field obj-type like ub.clients.obj-type
      177     field obj-code like ub.clients.obj-code
      178     field obj-name like ub.clients.obj-name
      179     field obj-id   as integer
