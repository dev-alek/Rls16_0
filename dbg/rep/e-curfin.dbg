      641   DEFINE VARIABLE RADIO-sort AS INTEGER
      642        VIEW-AS RADIO-SET VERTICAL
      643        RADIO-BUTTONS
      644             "по наименованию", 1,
      645   "по валюте", 2,
      646   "по сумме в вал. счета", 3,
      647   "по сумме в рублях", 4,
      648   "по сумме в баз. валюте", 5
      649        SIZE 30 BY 4.88 NO-UNDO.
      650   DEFINE RECTANGLE RECT-6
      651        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      652        SIZE 41.5 BY 10.75.
      653   DEFINE FRAME F-Main
      654        RADIO-sort AT ROW 2.88 COL 4.13 NO-LABEL
      655        "Сортировка:" VIEW-AS TEXT
      656             SIZE 13.25 BY 1 AT ROW 1.63 COL 4.13
      657             FGCOLOR 4
      658        RECT-6 AT ROW 1.25 COL 2.25
      659       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      660            SIDE-LABELS NO-UNDERLINE THREE-D
      661            AT COL 1 ROW 1 SCROLLABLE .
      662   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      663   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      664   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      665   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      666   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      667   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      668   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      669   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      670         adm-object-hdl = FRAME F-Main:HANDLE.
      671   RUN ensure-broker.
      672   THIS-PROCEDURE:ADM-DATA =
      673        'ADM1.1~`':U +
      674        'SmartObject~`':U +
      675        '~`':U +
      676        'NO ~`':U +
      677        '~`':U +
      678        '~`':U +
      679        '~`':U +
      680        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      681           + "~`":U +
      682        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      683        'Record-Source,Record-Target,TableIO-Target~`':U +
      684        '~`':U +
      685        '~`~`~`~`~`~`~`~`~`~`~`':U +
      686        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      687            THEN "^^":U
      688        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      689             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      690   PROCEDURE adm-apply-entry :
      691     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      692   END PROCEDURE.
      693   PROCEDURE adm-destroy :
      694    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      695   END PROCEDURE.
      696   PROCEDURE adm-disable :
      697       DISABLE RECT-6 RADIO-sort WITH FRAME F-Main.
      698       RUN dispatch ('disable-fields':U).
      699       RUN set-attribute-list ('ENABLED=no':U).
      700       RETURN.
      701   END PROCEDURE.
      702   PROCEDURE adm-edit-attribute-list :
      703         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      704         RETURN.
      705   END PROCEDURE.
      706   PROCEDURE adm-enable :
      707       ENABLE UNLESS-HIDDEN RECT-6 RADIO-sort WITH FRAME F-Main.
      708       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      709       RUN set-attribute-list ('ENABLED=yes':U).
      710       RETURN.
      711   END PROCEDURE.
      712   PROCEDURE adm-exit :
      713        RUN notify ('exit':U).
      714     RETURN.
      715   END PROCEDURE.
      716   PROCEDURE adm-hide :
      717     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      718   END PROCEDURE.
      719   PROCEDURE adm-initialize :
      720     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      721   END PROCEDURE.
      722   PROCEDURE adm-show-errors :
      723       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      724       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      725           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      726       END.
      727       RETURN.
      728   END PROCEDURE.
      729   PROCEDURE adm-UIB-mode :
      730     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      731   END PROCEDURE.
      732   PROCEDURE adm-view :
      733     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      734   END PROCEDURE.
      735   PROCEDURE dispatch :
      736       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      737       RUN broker-dispatch IN adm-broker-hdl
      738           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      739       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      740   END PROCEDURE.
      741   PROCEDURE ensure-broker :
      742   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      743   IF RETURN-VALUE NE "ADM-Broker":U THEN
      744   DO:
      745       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      746       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      747   END.
      748   END PROCEDURE.
      749   PROCEDURE get-attribute :
      750     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      751     RUN broker-get-attribute IN adm-broker-hdl
      752         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      753     RETURN RETURN-VALUE.
      754   END PROCEDURE.
      755   PROCEDURE get-attribute-list :
      756     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      757     RUN broker-get-attribute-list IN adm-broker-hdl
      758         (INPUT THIS-PROCEDURE,
      759          INPUT ?,
      760          OUTPUT p-attr-list) NO-ERROR.
      761     RETURN.
      762   END PROCEDURE.
      763   PROCEDURE new-state :
      764     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      765     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      766     RETURN.
      767   END PROCEDURE.
      768   PROCEDURE notify :
      769     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      770     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      771     IF RETURN-VALUE = "ADM-ERROR":U THEN
      772         RETURN "ADM-ERROR":U.
      773     RETURN.
      774   END PROCEDURE.
      775   PROCEDURE set-attribute-list :
      776     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      777     RUN ensure-broker.
      778     RUN broker-set-attribute-list IN adm-broker-hdl
      779         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      780     RETURN.
      781   END PROCEDURE.
      782   PROCEDURE set-position :
      783       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      784       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      785       IF VALID-HANDLE(adm-object-hdl) THEN
      786       DO:
      787         ASSIGN adm-object-hdl:ROW    =   p-row
      788                adm-object-hdl:COLUMN =   p-col.
      789       END.
      790       RETURN.
      791   END PROCEDURE.
      792   PROCEDURE adm-display-fields :
      793       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      794       RETURN.
      795   END PROCEDURE.
      796   PROCEDURE adm-open-query :
      797     RETURN.
      798   END PROCEDURE.
      799   PROCEDURE adm-row-changed :
      800         IF VALID-HANDLE(adm-object-hdl) THEN
      801           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      802         RUN notify ('row-available':U).
      803         RETURN.
      804   END PROCEDURE.
      805   PROCEDURE reposition-query :
      806       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      807       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      808       RETURN.
      809   END PROCEDURE.
      810     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      811     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      812     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      813     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      814     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      815     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      816     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      817     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      818     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      819     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      820     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      821     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      822     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      823     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      824     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      825     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      826     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      827     IF "":U = "":U THEN
      828       RUN modify-list-attribute IN adm-broker-hdl
      829         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      830     RUN use-create-on-add(?).
      831   PROCEDURE adm-add-record :
