      616   DEFINE VARIABLE parParentProc     AS WIDGET-HANDLE NO-UNDO.
      617   def var cli-list as char no-undo.
      618   define variable  p-radio-schet as integer   no-undo .
      619   define variable  p-curr-code   as integer   no-undo .
