      845     RETURN.
      846   END PROCEDURE.
      847   PROCEDURE adm-cancel-record :
      848      RETURN.
      849     END PROCEDURE.
      850   PROCEDURE adm-copy-record :
      851       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      852        "must have at least one Enabled Table to perform Copy.":U
      853          VIEW-AS ALERT-BOX ERROR.
      854       RETURN.
      855   END PROCEDURE.
      856   PROCEDURE adm-create-record :
      857      RETURN.
      858   END PROCEDURE.
      859   PROCEDURE adm-current-changed :
      860     RETURN.
      861   END PROCEDURE.
      862   PROCEDURE adm-delete-record :
      863    MESSAGE
      864          "Object ":U THIS-PROCEDURE:FILE-NAME
      865            "must have at least one Enabled Table to perform Delete.":U
      866              VIEW-AS ALERT-BOX ERROR.
