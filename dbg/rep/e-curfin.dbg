      883   PROCEDURE adm-update-record :
      884       MESSAGE
      885         "Object ":U THIS-PROCEDURE:FILE-NAME
      886           "must have at least one Enabled Table to perform Update.":U
      887             VIEW-AS ALERT-BOX ERROR.
      888      RETURN.
      889   END PROCEDURE.
      890   PROCEDURE check-modified :
      891   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      892   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      893   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      894   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      895     IF check-state = "check":U THEN
      896     DO:
      897       RUN get-link-handle IN adm-broker-hdl
      898         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      899            OUTPUT group-target-list).
      900       IF group-target-list NE "":U THEN
      901       DO i = 1 TO NUM-ENTRIES(group-target-list):
      902         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      903         RUN check-modified IN curr-widget ('group-check':U).
      904         IF RETURN-VALUE NE "":U THEN
      905         DO:
      906           RUN check-modified-message(RETURN-VALUE).
      907           RETURN "":U.
      908         END.
      909       END.
      910     END.
      911     RETURN "":U.
      912   END PROCEDURE.
      913   PROCEDURE check-modified-message :
      914     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      915        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      916           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      917        IF RETURN-VALUE = "YES":U THEN
      918           RUN notify ('view,CONTAINER-SOURCE':U).
      919        MESSAGE IF p-changed-table NE ? THEN
      920           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      921           ELSE "Current values have been changed."
      922           SKIP "  Do you wish to save those changes?"
      923           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      924        IF ANS THEN
      925        DO:
      926           IF group-assign-target THEN
      927             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      928           ELSE RUN dispatch('update-record':U).
      929           IF RETURN-VALUE = "ADM-ERROR":U THEN
      930           DO:
      931               MESSAGE "Changes to the previous record were not saved."
      932                 VIEW-AS ALERT-BOX ERROR.
      933               IF group-assign-target THEN
      934                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      935               ELSE RUN dispatch ('cancel-record':U).
      936           END.
      937        END.
      938        ELSE DO:
      939          IF group-assign-target THEN
      940             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      941          ELSE RUN dispatch('cancel-record':U).
      942        END.
      943        RETURN.
      944   END PROCEDURE.
      945   PROCEDURE get-rowid :
      946       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      947       ASSIGN
      948       p-table   =   adm-first-table.
      949       RETURN.
      950   END PROCEDURE.
      951   PROCEDURE init-group-assign :
      952       RUN request-attribute IN adm-broker-hdl
      953         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
      954       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
      955         group-assign-target = yes.
      956       ELSE group-assign-target = no.
      957       RETURN.
      958   END PROCEDURE.
      959   PROCEDURE set-editors :
      960       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
      961       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
      962       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
      963       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
      964       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
      965       DO WHILE VALID-HANDLE (curr-widget):
      966           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
      967              curr-widget:HIDDEN = no THEN DO:
      968             CASE p-field-setting:
      969               WHEN "INITIALIZE":U THEN
      970               DO:
      971                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
      972                     read-only-list +
      973                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
      974                        STRING(curr-widget).
      975               END.
      976               WHEN "DISABLE":U OR
      977               WHEN "ENABLE":U THEN
      978               DO:
      979                   curr-widget:SENSITIVE = yes.
      980                   RUN get-attribute ('Read-Only-Editors':U).
      981                   IF RETURN-VALUE = ? OR
      982                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
      983                       curr-widget:READ-ONLY =
      984                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
      985               END.
      986               WHEN "CLEAR":U THEN
      987                   curr-widget:SCREEN-VALUE = "":U.
      988             END CASE.
      989           END.
      990           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
      991       END.
      992       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
      993         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
      994           + '"':U).
      995       RETURN.
      996   END PROCEDURE.
      997   PROCEDURE use-check-modified-all :
      998    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
      999     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1000     RETURN.
     1001   END PROCEDURE.
     1002   PROCEDURE use-create-on-add :
     1003   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1004      RETURN.
     1005   END PROCEDURE.
     1006   PROCEDURE use-initial-lock :
     1007     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1008     ASSIGN adm-initial-lock = p-attr-value.
     1009     RETURN.
     1010   END PROCEDURE.
     1011     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1012   ASSIGN
     1013          FRAME F-Main:SCROLLABLE       = FALSE
     1014          FRAME F-Main:HIDDEN           = TRUE.
     1015   if not this-procedure :persistent
     1016   then do:
     1017     message
     1018       vss-workfile vss-revision vss-description skip
     1019       "Ошибка при запуске процедуры" skip
     1020       "Данную процедуру следует запускать только с параметром persistent" skip
     1021       view-as alert-box error .
     1022     undo, return error .
     1023   end.
     1024   PROCEDURE disable_UI :
     1025     HIDE FRAME F-Main.
     1026     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1027   END PROCEDURE.
     1028   PROCEDURE local-apply-layout :
     1029     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1030   END PROCEDURE.
     1031   PROCEDURE my-report :
     1032   run rep/r-curfin.p (input p-radio-schet, input p-curr-code, input RADIO-sort) .
     1033   END PROCEDURE.
     1034   PROCEDURE my-var :
     1035     Assign frame F-Main RADIO-sort .
     1036   define variable v-radio-customer as integer no-undo .
     1037   define variable v-radio-schet    as integer no-undo .
     1038   define variable v-curr-code      as integer no-undo .
     1039   define variable v-radio-period   as character no-undo .
     1040   define variable v-keep-spis      as character no-undo .
     1041   run get-var-from-1-report-page (
     1042       output v-radio-customer ,
     1043       output v-radio-schet,
     1044       output v-curr-code,
     1045       output v-radio-period ,
     1046       output v-keep-spis ) .
     1047     assign
     1048       p-radio-schet = v-radio-schet
     1049       p-curr-code   = v-curr-code
     1050     .
     1051     find first clients no-lock where clients.obj-type = 'орг':U and clients.obj-code = v-cntxt-host-code-obj .
     1052     assign
     1053       ReportNAme = "Состояние финансов на " + string(x-Date-Alone,"99/99/9999") + "г.".
     1054       str1 = "Фирма: " + clients.obj-name .
     1055     .
     1056   END PROCEDURE.
     1057   procedure get-var-from-1-report-page :
     1058    do
     1059    on error undo, return error return-value
     1060    :
     1061   define output parameter p-customer as integer no-undo .
     1062   define output parameter p-schet    as integer no-undo .
     1063   define output parameter p-curr-code as integer no-undo .
     1064   define output parameter p-period    as character no-undo .
     1065   define output parameter p-keep-spis  as character no-undo .
     1066   define variable v-res as character no-undo .
     1067     RUN get-attribute IN THIS-PROCEDURE ('UIB-MODE').
     1068     IF RETURN-VALUE NE "DESIGN" THEN DO:
     1069       RUN get-link-handle IN adm-broker-hdl ( THIS-PROCEDURE, 'State':U , OUTPUT source-str ).
     1070       State-source = WIDGET-HANDLE ( source-str ).
     1071       IF not VALID-HANDLE ( State-source ) THEN
     1072         Message "Не определен линк " 'State':U view-as alert-box error.
     1073     END.
     1074    run get-attribute in state-source  ( 'KEEP-SPIS':U ).
     1075     v-res = return-value .
     1076     if v-res = ? or v-res = "" then p-keep-spis = ? .
     1077                                else p-keep-spis = return-value .
     1078    run get-attribute in state-source  ( 'RADIO-PERIOD':U ).
     1079     v-res = return-value .
     1080     if v-res = ? or v-res = "" then p-period = ? .
     1081                                else p-period = return-value .
     1082    run get-attribute in state-source  ( 'RADIO-CUSTOMER':U ).
     1083     v-res = return-value .
     1084     if v-res = ? or v-res = "" then p-customer = ? .
     1085                                else p-customer = integer (return-value) .
     1086    run get-attribute in state-source  ( 'RADIO-SCHET':U ).
     1087     v-res = return-value .
     1088     if v-res = ? or v-res = "" then p-schet = ? .
     1089                                else p-schet = integer (return-value) .
     1090    run get-attribute in state-source  ( 'EX-CURR-CODE':U ).
     1091     v-res = return-value .
     1092     if v-res = ? or v-res = "" then p-curr-code = ? .
     1093                                else p-curr-code = integer (return-value) .
     1094    end.
     1095   end procedure.
     1096   PROCEDURE state-changed :
     1097     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1098     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1099     CASE p-state:
     1100       when "link-changed":U then  DO:
     1101            Run my-var.
     1102            End.
     1103     END CASE.
     1104   END PROCEDURE.
