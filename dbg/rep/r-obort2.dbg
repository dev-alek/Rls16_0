     2292   end procedure.
     2293   procedure prdoclib-calc-fact-sale :
     2294     define input  parameter p-price-list-recid   as recid     no-undo .
     2295     define output parameter p-fact-qnty          as decimal   no-undo .
     2296     define output parameter p-cur-base           as decimal   no-undo .
     2297     define output parameter p-cur-VAT-base       as decimal   no-undo .
     2298     define output parameter p-cur-SLT-base       as decimal   no-undo .
     2299     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     2300     define output parameter p-cur-excise-base    as decimal   no-undo .
     2301     define buffer buf_main_price-list for ub.price-list .
     2302     define buffer buf_price-list      for ub.price-list .
     2303     define buffer buf_goods           for ub.goods .
     2304     define buffer buf_gds-obj         for ub.gds-obj .
     2305     define buffer buf_bar-code        for ub.bar-code .
     2306     define variable l-empty-scale   as logical   no-undo .
     2307     do
     2308     on error undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )
     2309     on stop undo, return error substitute(" stop &1 &2" , return-value , error-status :get-message(1)  )
     2310     on end-key undo, return error substitute(" end-key &1 &2" , return-value , error-status :get-message(1)  )
     2311     :
     2312       find first buf_main_price-list no-lock
     2313         where recid(buf_main_price-list) = p-price-list-recid
     2314         no-error .
     2315       if not available buf_main_price-list
     2316       then do:
     2317         message
     2318           vss-workfile vss-revision vss-description skip
     2319           vss-include-info20 skip
     2320           "Ошибка задания входных параметров" skip
     2321           "Не найдена строка переоценки" skip
     2322           "Код записи (recid)" p-price-list-recid skip
     2323           view-as alert-box error .
     2324         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )   .
     2325       end.
     2326       if buf_main_price-list.main-price <> true
     2327       then do:
     2328         message
     2329           vss-workfile vss-revision vss-description skip
     2330           vss-include-info20 skip
     2331           "Ошибка задания входных параметров" skip
     2332           "Строка переоценки не является основной" skip
     2333           "Код записи (recid)" p-price-list-recid skip
     2334           "Переоценка" buf_main_price-list.doc-num skip
     2335           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2336           "Бар-код" buf_main_price-list.b-code skip
     2337           view-as alert-box error .
     2338         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  )  .
     2339       end.
     2340       find first buf_goods no-lock
     2341         where buf_goods.artic     = buf_main_price-list.artic
     2342           and buf_goods.prod-type = buf_main_price-list.prod-type
     2343           and buf_goods.prod-code = buf_main_price-list.prod-code
     2344         no-error .
     2345       if not available buf_goods
     2346       then do:
     2347         message
     2348           vss-workfile vss-revision vss-description skip
     2349           vss-include-info20 skip
     2350           "Не найден товар" skip
     2351           "Переоценка" buf_main_price-list.doc-num skip
     2352           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2353           view-as alert-box error .
     2354         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2355       end.
     2356   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2357   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsat in g#library
     2358     (input  buf_main_price-list.artic
     2359     ,input  buf_main_price-list.prod-type
     2360     ,input  buf_main_price-list.prod-code
     2361     ,input  'empty-scale=request':u
     2362     ,output l-empty-scale
     2363     ) no-error .
     2364       if error-status :error
     2365       then do:
     2366         message
     2367           vss-workfile vss-revision vss-description skip
     2368           vss-include-info20 skip
     2369           "Ошибка при определении атрибута товара" skip
     2370           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2371           'empty-scale=request':u skip
     2372           error-status :get-message(1) skip
     2373           return-value skip
     2374           view-as alert-box error .
     2375         undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2376       end.
     2377       find first buf_gds-obj no-lock
     2378         where buf_gds-obj.gds-code = buf_goods.gds-code
     2379           and buf_gds-obj.obj-type = buf_main_price-list.obj-type
     2380           and buf_gds-obj.obj-code = buf_main_price-list.obj-code
     2381         no-error .
     2382         if not available buf_gds-obj then do:
     2383   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2385     (input  buf_main_price-list.obj-type
     2386     ,input  buf_main_price-list.obj-code
     2387     ,input  buf_goods.artic
     2388     ,input  buf_goods.prod-type
     2389     ,input  buf_goods.prod-code
     2390     ,buffer buf_gds-obj
     2391     ) no-error .
     2392           if error-status :error then do:
     2393              undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2394           end.
     2395         end.
     2396       define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     2397       define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     2398       define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     2399       define variable price-base-without-tax-sale-prl as decimal   no-undo .
     2400       define variable vat-base-sale-prl               as decimal   no-undo .
     2401       define variable vat-rubl-sale-prl               as decimal   no-undo .
     2402       define variable vat-base-buyer-prl              as decimal   no-undo .
     2403       define variable vat-rubl-buyer-prl              as decimal   no-undo .
     2404       define variable slt-base-sale-prl               as decimal   no-undo .
     2405       define variable slt-rubl-sale-prl               as decimal   no-undo .
     2406       define variable road-tax-base-sale-prl          as decimal   no-undo .
     2407       define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     2408       define variable excise-base-sale-prl            as decimal   no-undo .
     2409       define variable excise-rubl-sale-prl            as decimal   no-undo .
     2410       define variable discnt-base-sale-prl            as decimal   no-undo .
     2411       define variable discnt-rubl-sale-prl            as decimal   no-undo .
     2412       if buf_main_price-list.doc-qnty <> 0
     2413       then do:
     2414         run prl-vat in this-procedure
     2415           (input  recid(buf_main_price-list)
     2416           ,output price-rubl-with-tax-sale-prl
     2417           ,output price-base-with-tax-sale-prl
     2418           ,output price-rubl-without-tax-sale-prl
     2419           ,output price-base-without-tax-sale-prl
     2420           ,output vat-base-sale-prl
     2421           ,output vat-rubl-sale-prl
     2422           ,output vat-base-buyer-prl
     2423           ,output vat-rubl-buyer-prl
     2424           ,output slt-base-sale-prl
     2425           ,output slt-rubl-sale-prl
     2426           ,output road-tax-base-sale-prl
     2427           ,output road-tax-rubl-sale-prl
     2428           ,output excise-base-sale-prl
     2429           ,output excise-rubl-sale-prl
     2430           ,output discnt-base-sale-prl
     2431           ,output discnt-rubl-sale-prl
     2432           ) no-error .
     2433         if error-status :error
     2434         then do:
     2435           message
     2436             vss-workfile vss-revision vss-description skip
     2437             vss-include-info20 skip
     2438             "Ошибка при вызове процеды prl-vat" skip
     2439             "Документ" buf_main_price-list.doc-num skip
     2440             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2441             error-status :get-message(1) skip
     2442             return-value skip
     2443             view-as alert-box error .
     2444           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2445         end.
     2446       end.
     2447       else do:
     2448         assign
     2449           price-rubl-with-tax-sale-prl    = 0
     2450           price-base-with-tax-sale-prl    = 0
     2451           price-rubl-without-tax-sale-prl = 0
     2452           price-base-without-tax-sale-prl = 0
     2453           vat-base-sale-prl               = 0
     2454           vat-rubl-sale-prl               = 0
     2455           vat-base-buyer-prl              = 0
     2456           vat-rubl-buyer-prl              = 0
     2457           slt-base-sale-prl               = 0
     2458           slt-rubl-sale-prl               = 0
     2459           road-tax-base-sale-prl          = 0
     2460           road-tax-rubl-sale-prl          = 0
     2461           excise-base-sale-prl            = 0
     2462           excise-rubl-sale-prl            = 0
     2463           discnt-base-sale-prl            = 0
     2464           discnt-rubl-sale-prl            = 0
     2465         .
     2466       end.
     2467       define variable v-curr-r-b as character no-undo .
     2468   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2469   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2470     (output v-curr-r-b
     2471     )  .
     2472       if v-curr-r-b = 'base':U
     2473       then do:
     2474         assign
     2475           p-fact-qnty         = buf_main_price-list.doc-qnty
     2476           p-cur-base          = price-base-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2477           p-cur-VAT-base      = vat-base-sale-prl * buf_main_price-list.doc-qnty
     2478           p-cur-SLT-base      = slt-base-sale-prl * buf_main_price-list.doc-qnty
     2479           p-cur-road-tax-base = road-tax-base-sale-prl * buf_main_price-list.doc-qnty
     2480           p-cur-excise-base   = excise-base-sale-prl * buf_main_price-list.doc-qnty
     2481         .
     2482       end.
     2483       else do:
     2484         assign
     2485           p-fact-qnty         = buf_main_price-list.doc-qnty
     2486           p-cur-base          = price-rubl-with-tax-sale-prl * buf_main_price-list.doc-qnty
     2487           p-cur-VAT-base      = vat-rubl-sale-prl * buf_main_price-list.doc-qnty
     2488           p-cur-SLT-base      = slt-rubl-sale-prl * buf_main_price-list.doc-qnty
     2489           p-cur-road-tax-base = road-tax-rubl-sale-prl * buf_main_price-list.doc-qnty
     2490           p-cur-excise-base   = excise-rubl-sale-prl * buf_main_price-list.doc-qnty
     2491         .
     2492       end.
     2493         define variable v-unit-base like ub.goods.unit-base no-undo .
     2494   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2495   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run unitbase in g#library
     2496     (input  buf_goods.gds-code
     2497     ,output v-unit-base
     2498     ) no-error .
     2499         if error-status :error
     2500         then do:
     2501           message
     2502             vss-workfile vss-revision vss-description skip
     2503             vss-include-info20 skip
     2504             "Ошибка при определении базовой единицы измерения товара" skip
     2505             "Код товара" buf_goods.gds-code skip
     2506             error-status :get-message(1) skip
     2507             return-value skip
     2508             view-as alert-box error .
     2509           undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2510         end.
     2511         for each buf_price-list no-lock
     2512           where buf_price-list.doc-num    = buf_main_price-list.doc-num
     2513             and buf_price-list.main-price = false
     2514             and buf_price-list.artic      = buf_main_price-list.artic
     2515             and buf_price-list.prod-type  = buf_main_price-list.prod-type
     2516             and buf_price-list.prod-code  = buf_main_price-list.prod-code
     2517         :
     2518           if buf_price-list.doc-qnty = ?
     2519           then do:
     2520             find first buf_bar-code no-lock
     2521               where buf_bar-code.b-code = buf_price-list.b-code
     2522               no-error .
     2523             if available buf_bar-code
     2524             and buf_bar-code.unit-cli = v-unit-base
     2525             then do:
     2526               message
     2527                 vss-workfile vss-revision vss-description skip
     2528                 vss-include-info20 skip
     2529                 "Ошибка при закрытии переоценки" skip
     2530                 "Не задано количество для бар-кода с основной единицей измерения" skip
     2531                 "Переоценка" buf_main_price-list.doc-num skip
     2532                 "Бар-код" buf_price-list.b-code skip
     2533                 "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2534                 "Количество" buf_price-list.doc-qnty skip
     2535                 "Основная единица измерения" v-unit-base skip
     2536                 "Единица измерения бар-кода" buf_bar-code.unit-cli skip
     2537                 view-as alert-box error .
     2538               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2539             end.
     2540             next .
     2541           end.
     2542           if not can-find
     2543             (first buf_bar-code
     2544             where buf_bar-code.b-code = buf_price-list.b-code
     2545             )
     2546           then do:
     2547             message
     2548               vss-workfile vss-revision vss-description skip
     2549               vss-include-info20 skip
     2550               "В переоценке задан несуществующий бар-код" skip
     2551               "Переоценка" buf_price-list.doc-num skip
     2552               "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2553               "Бар-код" buf_price-list.b-code skip
     2554               view-as alert-box error .
     2555             undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2556           end.
     2557           if buf_price-list.doc-qnty <> 0
     2558           then do:
     2559             run prl-vat in this-procedure
     2560               (input  recid(buf_price-list)
     2561               ,output price-rubl-with-tax-sale-prl
     2562               ,output price-base-with-tax-sale-prl
     2563               ,output price-rubl-without-tax-sale-prl
     2564               ,output price-base-without-tax-sale-prl
     2565               ,output vat-base-sale-prl
     2566               ,output vat-rubl-sale-prl
     2567               ,output vat-base-buyer-prl
     2568               ,output vat-rubl-buyer-prl
     2569               ,output slt-base-sale-prl
     2570               ,output slt-rubl-sale-prl
     2571               ,output road-tax-base-sale-prl
     2572               ,output road-tax-rubl-sale-prl
     2573               ,output excise-base-sale-prl
     2574               ,output excise-rubl-sale-prl
     2575               ,output discnt-base-sale-prl
     2576               ,output discnt-rubl-sale-prl
     2577               ) no-error .
     2578             if error-status :error
     2579             then do:
     2580               message
     2581                 vss-workfile vss-revision vss-description skip
     2582                 vss-include-info20 skip
     2583                 "Ошибка при вызове процеды prl-vat" skip
     2584                 "Документ" buf_price-list.doc-num skip
     2585                 "Артикул" buf_price-list.artic buf_price-list.prod-type buf_price-list.prod-code skip
     2586                 error-status :get-message(1) skip
     2587                 return-value skip
     2588                 view-as alert-box error .
     2589               undo, return error substitute("  &1 &2 " , return-value , error-status :get-message(1)  ) .
     2590             end.
     2591           end.
     2592           else do:
     2593             assign
     2594               price-rubl-with-tax-sale-prl    = 0
     2595               price-base-with-tax-sale-prl    = 0
     2596               price-rubl-without-tax-sale-prl = 0
     2597               price-base-without-tax-sale-prl = 0
     2598               vat-base-sale-prl               = 0
     2599               vat-rubl-sale-prl               = 0
     2600               vat-base-buyer-prl              = 0
     2601               vat-rubl-buyer-prl              = 0
     2602               slt-base-sale-prl               = 0
     2603               slt-rubl-sale-prl               = 0
     2604               road-tax-base-sale-prl          = 0
     2605               road-tax-rubl-sale-prl          = 0
     2606               excise-base-sale-prl            = 0
     2607               excise-rubl-sale-prl            = 0
     2608               discnt-base-sale-prl            = 0
     2609               discnt-rubl-sale-prl            = 0
     2610             .
     2611           end.
     2612           if v-curr-r-b = 'base':U
     2613           then do:
     2614             assign
     2615               p-fact-qnty         = p-fact-qnty
     2616                                   + buf_price-list.doc-qnty
     2617               p-cur-base          = p-cur-base
     2618                                   + price-base-with-tax-sale-prl * buf_price-list.doc-qnty
     2619               p-cur-VAT-base      = p-cur-VAT-base
     2620                                   + vat-base-sale-prl * buf_price-list.doc-qnty
     2621               p-cur-SLT-base      = p-cur-SLT-base
     2622                                   + slt-base-sale-prl * buf_price-list.doc-qnty
     2623               p-cur-road-tax-base = p-cur-road-tax-base
     2624                                   + road-tax-base-sale-prl * buf_price-list.doc-qnty
     2625               p-cur-excise-base   = p-cur-excise-base
     2626                                   + excise-base-sale-prl * buf_price-list.doc-qnty
     2627             .
     2628           end.
     2629           else do:
     2630             assign
     2631               p-fact-qnty         = p-fact-qnty
     2632                                   + buf_price-list.doc-qnty
     2633               p-cur-base          = p-cur-base
     2634                                   + price-rubl-with-tax-sale-prl * buf_price-list.doc-qnty
     2635               p-cur-VAT-base      = p-cur-VAT-base
     2636                                   + vat-rubl-sale-prl * buf_price-list.doc-qnty
     2637               p-cur-SLT-base      = p-cur-SLT-base
     2638                                   + slt-rubl-sale-prl * buf_price-list.doc-qnty
     2639               p-cur-road-tax-base = p-cur-road-tax-base
     2640                                   + road-tax-rubl-sale-prl * buf_price-list.doc-qnty
     2641               p-cur-excise-base   = p-cur-excise-base
     2642                                   + excise-rubl-sale-prl * buf_price-list.doc-qnty
     2643             .
     2644           end.
     2645         end.
     2646     end.
     2647   end procedure.
     2648   procedure prdoclib-calc-prc :
     2649     define input  parameter p-price-doc-recid as   recid                  no-undo.
     2650     define input  parameter p-cons-pay        as   integer                no-undo.
     2651     define output parameter p-ov-cons         like ub.doc-line.price-base no-undo.
     2652     define output parameter p-ov-VAT-cons     like ub.doc-line.price-base no-undo.
     2653     define output parameter p-ov-SLT-cons     like ub.doc-line.price-base no-undo.
     2654     define output parameter p-ov-prch         like ub.doc-line.price-base no-undo.
     2655     define output parameter p-ov-VAT-prch     like ub.doc-line.price-base no-undo.
     2656     define output parameter p-ov-SLT-prch     like ub.doc-line.price-base no-undo.
     2657     do
     2658     on error undo, return error return-value
     2659     :
     2660       define buffer buf_price-doc       for ub.price-doc .
     2661       define buffer buf_price-list      for ub.price-list .
     2662       define buffer buf_parts           for ub.parts .
     2663       define variable v-ov-qnty     as decimal   no-undo .
     2664       define variable v-ov-base     as decimal   no-undo .
     2665       define variable v-ov-VAT-base as decimal   no-undo .
     2666       define variable v-ov-SLT-base as decimal   no-undo .
     2667       define variable v-cons-qnty   as decimal   no-undo .
     2668       define variable v-prch-qnty   as decimal   no-undo .
     2669       define variable v-cons-mult   as decimal   no-undo .
     2670       define variable v-prch-mult   as decimal   no-undo .
     2671       find first buf_price-doc no-lock
     2672         where recid(buf_price-doc) = p-price-doc-recid
     2673         no-error .
     2674       if not available buf_price-doc
     2675       then do:
     2676         message
     2677           vss-workfile vss-revision vss-description skip
     2678           vss-include-info20 skip
     2679           "Ошибка задания входных параметров" skip
     2680           "Не найден документ переоценки" skip
     2681           "Код записи (recid)" p-price-doc-recid skip
     2682           view-as alert-box error .
     2683         undo, return error .
     2684       end.
     2685       for each buf_price-list no-lock
     2686         where buf_price-list.doc-num    = buf_price-doc.doc-num
     2687           and buf_price-list.main-price = true
     2688       on error undo, return error return-value
     2689       :
     2690         run prdoclib-calc-ov
     2691           (input recid(buf_price-list)
     2692           ,output v-ov-qnty
     2693           ,output v-ov-base
     2694           ,output v-ov-VAT-base
     2695           ,output v-ov-SLT-base
     2696           ) no-error .
     2697         if error-status :error
     2698         then do:
     2699           if error-status :get-message(1) <> ""
     2700           then do:
     2701             message
     2702               vss-workfile vss-revision vss-description skip
     2703               vss-include-info20 skip
     2704               "Ошибка при вызове процедуры prdoclib-calc-ov" skip
     2705               error-status :get-message(1) skip
     2706               return-value skip
     2707               view-as alert-box error .
     2708           end.
     2709           undo, return error return-value .
     2710         end.
     2711         assign
     2712           v-cons-qnty = 0
     2713           v-prch-qnty = 0
     2714         .
     2715         for each buf_parts no-lock
     2716           where buf_parts.out-code  = buf_price-list.doc-num
     2717             and buf_parts.obj-type  = buf_price-list.obj-type
     2718             and buf_parts.obj-code  = buf_price-list.obj-code
     2719             and buf_parts.artic     = buf_price-list.artic
     2720             and buf_parts.prod-type = buf_price-list.prod-type
     2721             and buf_parts.prod-code = buf_price-list.prod-code
     2722         on error undo, return error return-value
     2723         :
     2724           if buf_parts.pay-code = p-cons-pay
     2725           then do:
     2726             assign
     2727               v-cons-qnty = v-cons-qnty + buf_parts.fact-qnty
     2728             .
     2729           end.
     2730           else do:
     2731             assign
     2732               v-prch-qnty = v-prch-qnty + buf_parts.fact-qnty
     2733             .
     2734           end.
     2735         end.
     2736         if (v-cons-qnty + v-prch-qnty) = 0
     2737         then do:
     2738           assign
     2739             v-cons-mult = 0
     2740             v-prch-mult = 1
     2741           .
     2742         end.
     2743         else do:
     2744           assign
     2745             v-cons-mult = v-cons-qnty / (v-cons-qnty + v-prch-qnty)
     2746             v-prch-mult = v-prch-qnty / (v-cons-qnty + v-prch-qnty)
     2747           .
     2748         end.
     2749         assign
     2750           p-ov-cons     = p-ov-cons     + v-ov-base     * v-cons-mult
     2751           p-ov-VAT-cons = p-ov-VAT-cons + v-ov-VAT-base * v-cons-mult
     2752           p-ov-SLT-cons = p-ov-SLT-cons + v-ov-SLT-base * v-cons-mult
     2753           p-ov-prch     = p-ov-prch     + v-ov-base     * v-prch-mult
     2754           p-ov-VAT-prch = p-ov-VAT-prch + v-ov-VAT-base * v-prch-mult
     2755           p-ov-SLT-prch = p-ov-SLT-prch + v-ov-SLT-base * v-prch-mult
     2756         .
     2757       end.
     2758     end.
     2759   end procedure.
     2760   procedure prdoclib-calc-ov :
     2761     define input  parameter p-price-list-recid as recid     no-undo .
     2762     define output parameter p-fact-qnty        as decimal   no-undo .
     2763     define output parameter p-ov-base          as decimal   no-undo .
     2764     define output parameter p-ov-VAT-base      as decimal   no-undo .
     2765     define output parameter p-ov-SLT-base      as decimal   no-undo .
     2766     do
     2767     on error undo, return error return-value
     2768     :
     2769       define buffer buf_main_price-list    for ub.price-list .
     2770       define buffer buf_prev_price-list    for ub.price-list .
     2771       define buffer buf_special_price-list for ub.price-list .
     2772       define buffer buf_goods              for ub.goods .
     2773       define variable v-fact-qnty             like ub.doc-line.price-base no-undo.
     2774       define variable v-cur-base              like ub.doc-line.price-base no-undo.
     2775       define variable v-cur-VAT-base          like ub.doc-line.price-base no-undo.
     2776       define variable v-cur-SLT-base          like ub.doc-line.price-base no-undo.
     2777       define variable v-cur-road-tax-base     like ub.doc-line.price-base no-undo.
     2778       define variable v-cur-excise-base       like ub.doc-line.price-base no-undo.
     2779       define variable v-prev-price-list-recid as   recid                  no-undo.
     2780       define variable v-prev-cli-base-rate    like ub.goods.cli-base-rate no-undo.
     2781       define variable v-prev-fact-qnty        like ub.doc-line.price-base no-undo.
     2782       define variable v-prev-cur-base         like ub.doc-line.price-base no-undo.
     2783       define variable v-prev-cur-VAT-base     like ub.doc-line.price-base no-undo.
     2784       define variable v-prev-cur-SLT-base     like ub.doc-line.price-base no-undo.
     2785       find first buf_main_price-list no-lock
     2786         where recid(buf_main_price-list) = p-price-list-recid
     2787         no-error .
     2788       if not available buf_main_price-list
     2789       then do:
     2790         message
     2791           vss-workfile vss-revision vss-description skip
     2792           vss-include-info20 skip
     2793           "Ошибка задания входных параметров" skip
     2794           "Не найдена строка переоценки" skip
     2795           "Код записи (recid)" p-price-list-recid skip
     2796           view-as alert-box error .
     2797         undo, return error .
     2798       end.
     2799       if buf_main_price-list.main-price <> true
     2800       then do:
     2801         message
     2802           vss-workfile vss-revision vss-description skip
     2803           vss-include-info20 skip
     2804           "Ошибка задания входных параметров" skip
     2805           "Строка переоценки не является основной" skip
     2806           "Код записи (recid)" p-price-list-recid skip
     2807           "Переоценка" buf_main_price-list.doc-num skip
     2808           "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2809           "Бар-код" buf_main_price-list.b-code skip
     2810           view-as alert-box error .
     2811         undo, return error .
     2812       end.
     2813       run prdoclib-calc-fact-sale in this-procedure
     2814         (input  recid(buf_main_price-list)
     2815         ,output v-fact-qnty
     2816         ,output v-cur-base
     2817         ,output v-cur-VAT-base
     2818         ,output v-cur-SLT-base
     2819         ,output v-cur-road-tax-base
     2820         ,output v-cur-excise-base
     2821         ) no-error.
     2822       if error-status :error
     2823       then do:
     2824         message
     2825           vss-workfile vss-revision vss-description skip
     2826           vss-include-info20 skip
     2827           "Ошибка при расчете сумм переоценки." skip
     2828           "Документ переоценки" buf_main_price-list.doc-num skip
     2829           "Товар" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2830           error-status :get-message(1) skip
     2831           return-value skip
     2832           view-as alert-box error .
     2833         undo, return error .
     2834       end.
     2835   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     2837     (input  buf_main_price-list.obj-type
     2838     ,input  buf_main_price-list.obj-code
     2839     ,input  buf_main_price-list.b-code
     2840     ,input  buf_main_price-list.b-code
     2841     ,input  buf_main_price-list.fact-order
     2842     ,output v-prev-price-list-recid
     2843     ,output v-prev-cli-base-rate
     2844     ) no-error .
     2845       if error-status :error
     2846       then do:
     2847         message
     2848           vss-workfile vss-revision vss-description skip
     2849           vss-include-info20 skip
     2850           "Ошибка при поиске предыдущей переоценки." skip
     2851           "Документ переоценки " buf_main_price-list.doc-num skip
     2852           "Товар " buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2853           error-status :get-message(1) skip
     2854           return-value skip
     2855           view-as alert-box error .
     2856         undo, return error .
     2857       end.
     2858       if v-prev-price-list-recid <> ?
     2859       then do:
     2860         find first buf_prev_price-list no-lock
     2861           where recid(buf_prev_price-list) = v-prev-price-list-recid
     2862           .
     2863         find first buf_special_price-list no-lock
     2864           where buf_special_price-list.doc-num    = buf_prev_price-list.doc-num
     2865             and buf_special_price-list.main-price = false
     2866             and buf_special_price-list.artic      = buf_prev_price-list.artic
     2867             and buf_special_price-list.prod-type  = buf_prev_price-list.prod-type
     2868             and buf_special_price-list.prod-code  = buf_prev_price-list.prod-code
     2869             and buf_special_price-list.doc-qnty   <> ?
     2870           no-error .
     2871         if available buf_special_price-list
     2872         then do:
     2873           message
     2874             "Товар имеет специальные цены на признаки" skip
     2875             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2876             "Переоценка" buf_prev_price-list.doc-num skip
     2877             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2878             view-as alert-box error .
     2879           undo, return error .
     2880         end.
     2881         find first buf_goods no-lock
     2882           where buf_goods.artic     = buf_main_price-list.artic
     2883             and buf_goods.prod-type = buf_main_price-list.prod-type
     2884             and buf_goods.prod-code = buf_main_price-list.prod-code
     2885           no-error .
     2886         if not available buf_goods
     2887         then do:
     2888           message
     2889             vss-workfile vss-revision vss-description skip
     2890             vss-include-info20 skip
     2891             "Не найден товар" skip
     2892             "Переоценка" buf_main_price-list.doc-num skip
     2893             "Артикул" buf_main_price-list.artic buf_main_price-list.prod-type buf_main_price-list.prod-code skip
     2894             view-as alert-box error .
     2895           undo, return error .
     2896         end.
     2897         if buf_prev_price-list.vat-pc = ?
     2898         or buf_prev_price-list.slt-pc = ?
     2899         then do:
     2900           message
     2901             "В переоценке не заданы налоги товара" skip
     2902             "Разбиение суммы переоценки по консигнации, выкупу невозможно" skip
     2903             "Переоценка" buf_prev_price-list.doc-num skip
     2904             "Товар" buf_prev_price-list.artic buf_prev_price-list.prod-type buf_prev_price-list.prod-code skip
     2905             "НДС" buf_prev_price-list.vat-pc skip
     2906             "НП" buf_prev_price-list.slt-pc skip
     2907             view-as alert-box error .
     2908           undo, return error return-value .
     2909         end.
     2910         define variable v-prev-cur-SLT-pc as decimal no-undo .
     2911         assign
     2912           v-prev-cur-SLT-pc   = buf_prev_price-list.price-sale * buf_prev_price-list.slt-pc / (100 + buf_prev_price-list.slt-pc)
     2913         .
     2914         assign
     2915           v-prev-cur-base     = v-fact-qnty * buf_prev_price-list.price-sale
     2916           v-prev-cur-VAT-base = v-fact-qnty
     2917                               * (buf_prev_price-list.price-sale - v-prev-cur-SLT-pc)
     2918                               * buf_prev_price-list.vat-pc / (100 + buf_prev_price-list.vat-pc)
     2919           v-prev-cur-SLT-base = v-fact-qnty * v-prev-cur-SLT-pc
     2920         .
     2921         assign
     2922           p-fact-qnty   = v-fact-qnty
     2923           p-ov-base     = v-cur-base     - v-prev-cur-base
     2924           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2925           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2926         .
     2927       end.
     2928       else do:
     2929         assign
     2930           v-prev-cur-base     = 0
     2931           v-prev-cur-VAT-base = 0
     2932           v-prev-cur-SLT-base = 0
     2933           .
     2934         assign
     2935           p-fact-qnty   = v-fact-qnty
     2936           p-ov-base     = v-cur-base     - v-prev-cur-base
     2937           p-ov-VAT-base = v-cur-VAT-base - v-prev-cur-VAT-base
     2938           p-ov-SLT-base = v-cur-SLT-base - v-prev-cur-SLT-base
     2939         .
     2940       end.
     2941     end.
     2942   end procedure.
     2943   procedure prdoclib-init-prt-obj-by-factord :
     2944     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     2945     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     2946     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     2947     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     2948     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     2949     define input parameter p-fact-order         as decimal   no-undo .
     2950     define input parameter p-include-fact-order as logical   no-undo .
     2951     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-factord: определение остатков по признакам на любой момент времени".
     2952     define buffer buf_gds-obj      for ub.gds-obj .
     2953     define buffer buf_doc-line     for ub.doc-line .
     2954     define buffer buf_temp-prt-obj for temp-prt-obj .
     2955     define variable v-total-gds-dtl-qnty as decimal   no-undo .
     2956     do
     2957     on error undo, return error return-value
     2958     :
     2959       do transaction
     2960       on error undo, return error return-value
     2961       :
     2962   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2963   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     2964     (input  p-obj-type
     2965     ,input  p-obj-code
     2966     ,input  p-artic
     2967     ,input  p-prod-type
     2968     ,input  p-prod-code
     2969     ,buffer buf_gds-obj
     2970     ) no-error .
     2971         if error-status :error
     2972         then do:
     2973           message
     2974             vss-workfile vss-revision vss-description skip
     2975             vss-include-info20 skip
     2976             "Невозможно найти gds-obj" skip
     2977             error-status :get-message(1) skip
     2978             return-value skip
     2979             view-as alert-box error .
     2980           undo, return error .
     2981         end.
     2982         find current buf_gds-obj exclusive-lock .
     2983       end.
     2984       run prdoclib-init-temp-prt-obj in this-procedure
     2985         (input p-obj-type
     2986         ,input p-obj-code
     2987         ,input p-artic
     2988         ,input p-prod-type
     2989         ,input p-prod-code
     2990         ,input 0
     2991         ) .
     2992       for each buf_temp-prt-obj
     2993         where buf_temp-prt-obj.is-term <> true
     2994       on error undo, return error return-value
     2995       :
     2996         delete buf_temp-prt-obj .
     2997       end.
     2998       if p-include-fact-order = true
     2999       then do:
     3000         assign
     3001          p-fact-order = p-fact-order - 0.0000000001
     3002         .
     3003       end.
     3004       for each buf_doc-line no-lock
     3005         where buf_doc-line.obj-type   = p-obj-type
     3006           and buf_doc-line.obj-code   = p-obj-code
     3007           and buf_doc-line.artic      = p-artic
     3008           and buf_doc-line.prod-type  = p-prod-type
     3009           and buf_doc-line.prod-code  = p-prod-code
     3010           and buf_doc-line.status_    = 'факт':U
     3011           and buf_doc-line.fact-order >= p-fact-order
     3012       on error undo, return error return-value
     3013       :
     3014         run prdoclib-process-document in this-procedure
     3015           (input  buf_doc-line.doc-code
     3016           ,input  p-obj-type
     3017           ,input  p-obj-code
     3018           ,input  p-artic
     3019           ,input  p-prod-type
     3020           ,input  p-prod-code
     3021           ,output v-total-gds-dtl-qnty
     3022           ) .
     3023       end.
     3024     end.
     3025   end procedure.
     3026   procedure prdoclib-process-document :
     3027     define input  parameter p-doc-code           as character no-undo .
     3028     define input  parameter p-obj-type           as character no-undo .
     3029     define input  parameter p-obj-code           as integer   no-undo .
     3030     define input  parameter p-artic              as character no-undo .
     3031     define input  parameter p-prod-type          as character no-undo .
     3032     define input  parameter p-prod-code          as integer   no-undo .
     3033     define output parameter p-total-gds-dtl-qnty as decimal   no-undo .
     3034     define buffer buf_trn-doc      for ub.trn-doc .
     3035     define buffer buf_gds-dtl      for ub.gds-dtl .
     3036     define buffer buf_temp-prt-obj for temp-prt-obj .
     3037     do
     3038     on error undo, return error return-value
     3039     :
     3040       find first buf_trn-doc no-lock
     3041         where buf_trn-doc.doc-code = p-doc-code
     3042         no-error .
     3043       if not available buf_trn-doc then do:
     3044         message
     3045           vss-workfile vss-revision vss-description skip
     3046           vss-include-info20 skip
     3047           "Ошибка при поиске документа" skip
     3048           "Документ" p-doc-code skip
     3049           "Объект" p-obj-type p-obj-code skip
     3050           "Артикул" p-artic p-prod-type p-prod-code skip
     3051           view-as alert-box error .
     3052         undo, return error .
     3053       end.
     3054       assign
     3055         p-total-gds-dtl-qnty = 0
     3056       .
     3057       for each buf_gds-dtl no-lock
     3058         where buf_gds-dtl.doc-code  = p-doc-code
     3059           and buf_gds-dtl.artic     = p-artic
     3060           and buf_gds-dtl.prod-type = p-prod-type
     3061           and buf_gds-dtl.prod-code = p-prod-code
     3062       on error undo, return error
     3063       :
     3064         define variable v-term-node as integer   no-undo .
     3065   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run termnode in g#library
     3066     (input  buf_gds-dtl.prt-code
     3067     ,output v-term-node
     3068     )  .
     3069         run prdoclib-temp-prt-obj-by-prt-root in this-procedure
     3070           (input  v-term-node
     3071           ,buffer buf_temp-prt-obj
     3072           ) .
     3073         if buf_temp-prt-obj.is-term <> true then do:
     3074           undo, return error substitute("Документ ссылается на нетерминальный признак. Код признака &1"
     3075                                        ,buf_gds-dtl.prt-code
     3076                                        ) .
     3077         end.
     3078         case buf_trn-doc.doc-type :
     3079           when 'при':U or
     3080           when 'возврат':U
     3081           then do:
     3082             assign
     3083               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3084                                           - buf_gds-dtl.fact-qnty
     3085               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3086                                           - buf_gds-dtl.fact-qnty
     3087             .
     3088           end.
     3089           when 'рас':U or
     3090           when 'спи':U
     3091           then do:
     3092             assign
     3093               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3094                                           + buf_gds-dtl.fact-qnty
     3095               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3096                                           + buf_gds-dtl.fact-qnty
     3097             .
     3098           end.
     3099           when 'инв':U
     3100           then do:
     3101             assign
     3102               p-total-gds-dtl-qnty        = p-total-gds-dtl-qnty
     3103                                           - buf_gds-dtl.doc-qnty
     3104               buf_temp-prt-obj.fact-qnty  = buf_temp-prt-obj.fact-qnty
     3105                                           - buf_gds-dtl.doc-qnty
     3106             .
     3107           end.
     3108           otherwise do:
     3109             undo, return error substitute("Неизвестный тип документа &1"
     3110                                          ,buf_trn-doc.doc-type
     3111                                          ) .
     3112           end.
     3113         end.
     3114       end.
     3115     end.
     3116   end procedure.
     3117   procedure prdoclib-prc-pl-document :
     3118     define input  parameter p-doc-code              as character no-undo .
     3119     define input  parameter p-obj-type              as character no-undo .
     3120     define input  parameter p-obj-code              as integer   no-undo .
     3121     define input  parameter p-gds-code              as integer   no-undo .
     3122     define output parameter p-total-pl-gds-qnty     as decimal   no-undo .
     3123     define output parameter p-total-pl-gds-cli-qnty as decimal   no-undo .
     3124     do
     3125     on error undo, return error return-value
     3126     :
     3127       define buffer buf_trn-doc      for ub.trn-doc .
     3128       define buffer buf_doc-pl       for ub.doc-pl .
     3129       define buffer buf_temp-pl-gds for temp-pl-gds .
     3130       define variable v-sign as decimal   no-undo .
     3131       find first buf_trn-doc no-lock
     3132         where buf_trn-doc.doc-code = p-doc-code
     3133         no-error .
     3134       if not available buf_trn-doc then do:
     3135         message
     3136           vss-workfile vss-revision vss-description skip
     3137           vss-include-info20 skip
     3138           "Ошибка при поиске документа" skip
     3139           "Документ" p-doc-code skip
     3140           "Объект" p-obj-type p-obj-code skip
     3141           "Товар" p-gds-code skip
     3142           view-as alert-box error .
     3143         undo, return error .
     3144       end.
     3145       assign
     3146         p-total-pl-gds-qnty     = 0
     3147         p-total-pl-gds-cli-qnty = 0
     3148       .
     3149       for each buf_doc-pl no-lock
     3150         where buf_doc-pl.out-code  = p-doc-code
     3151           and buf_doc-pl.gds-code  = p-gds-code
     3152       on error undo, return error return-value
     3153       :
     3154         find first buf_temp-pl-gds
     3155           where buf_temp-pl-gds.obj-type = buf_trn-doc.obj-type
     3156             and buf_temp-pl-gds.obj-code = buf_trn-doc.obj-code
     3157             and buf_temp-pl-gds.pl-code  = buf_doc-pl.pl-code
     3158           .
     3159         case buf_trn-doc.doc-type :
     3160           when 'при':U
     3161           or when 'возврат':U
     3162           or when 'инв':U
     3163           then do:
     3164             assign
     3165               v-sign = -1.0
     3166             .
     3167           end.
     3168           when 'рас':U or
     3169           when 'спи':U
     3170           then do:
     3171             assign
     3172               v-sign = 1.0
     3173             .
     3174           end.
     3175           otherwise do:
     3176             undo, return error substitute("(prdoclib-prc-pl-document) Неизвестный тип документа &1", buf_trn-doc.doc-type ) .
     3177           end.
     3178         end case.
     3179         assign
     3180           p-total-pl-gds-qnty           = p-total-pl-gds-qnty           + buf_doc-pl.fact-qnty     * v-sign
     3181           p-total-pl-gds-cli-qnty       = p-total-pl-gds-cli-qnty       + buf_doc-pl.cli-fact-qnty * v-sign
     3182           buf_temp-pl-gds.fact-qnty     = buf_temp-pl-gds.fact-qnty     + buf_doc-pl.fact-qnty     * v-sign
     3183           buf_temp-pl-gds.cli-fact-qnty = buf_temp-pl-gds.cli-fact-qnty + buf_doc-pl.cli-fact-qnty * v-sign
     3184         .
     3185       end.
     3186     end.
     3187   end procedure.
     3188   procedure prdoclib-init-prt-obj-by-date :
     3189     define input parameter p-obj-type   like ub.gds-obj.obj-type  no-undo .
     3190     define input parameter p-obj-code   like ub.gds-obj.obj-code  no-undo .
     3191     define input parameter p-artic      like ub.gds-obj.artic     no-undo .
     3192     define input parameter p-prod-type  like ub.gds-obj.prod-type no-undo .
     3193     define input parameter p-prod-code  like ub.gds-obj.prod-code no-undo .
     3194     define input parameter p-fact-date  as date      no-undo .
     3195     define variable vss-description as character no-undo init "prdoclib-init-prt-obj-by-date: определение остатков по признакам на конец дня".
     3196     do
     3197     on error undo, return error return-value
     3198     :
     3199       define variable v-fact-order                as decimal   no-undo .
     3200       define variable v-shift-end-fact-order      as decimal   no-undo .
     3201       define variable v-day-end-fact-order        as decimal   no-undo .
     3202       run factord in this-procedure
     3203         (input  p-fact-date
     3204         ,input  1
     3205         ,input  1
     3206         ,input  ?
     3207         ,input  0
     3208         ,input  false
     3209         ,output v-fact-order
     3210         ,output v-shift-end-fact-order
     3211         ,output v-day-end-fact-order
     3212         ) no-error .
     3213       if error-status :error
     3214       then do:
     3215         message
     3216           vss-workfile vss-revision vss-description skip
     3217           vss-include-info20 skip
     3218           "Ошибка при определении момента времени, на который требуется остаток" skip
     3219           "Объект" p-obj-type p-obj-code skip
     3220           "Артикул" p-artic p-prod-type p-prod-code skip
     3221           "Дата" p-fact-date skip
     3222           view-as alert-box error .
     3223         undo, return error .
     3224       end.
     3225       run prdoclib-init-prt-obj-by-date-factord in this-procedure
     3226         (input p-obj-type
     3227         ,input p-obj-code
     3228         ,input p-artic
     3229         ,input p-prod-type
     3230         ,input p-prod-code
     3231         ,input v-day-end-fact-order
     3232         ,input false
     3233         ) no-error .
     3234       if error-status :error
     3235       then do:
     3236         message
     3237           vss-workfile vss-revision vss-description skip
     3238           vss-include-info20 skip
     3239           "Ошибка при вызове метода prdoclib-init-prt-obj-by-date-factord" skip
     3240           "Объект" p-obj-type p-obj-code skip
     3241           "Артикул" p-artic p-prod-type p-prod-code skip
     3242           "Дата" p-fact-date skip
     3243           view-as alert-box error .
     3244         undo, return error .
     3245       end.
     3246     end.
     3247   end procedure.
     3248   procedure prdoclib-calc-temp-fact-sale :
     3249     define input  parameter p-obj-type           as character no-undo .
     3250     define input  parameter p-obj-code           as integer   no-undo .
     3251     define input  parameter p-gds-code           as integer   no-undo .
     3252     define input  parameter p-day-end-fact-order as decimal   no-undo .
     3253     define input  parameter p-curr-r-b           as character no-undo .
     3254     define output parameter p-fact-qnty          as decimal   no-undo .
     3255     define output parameter p-cur-base           as decimal   no-undo .
     3256     define output parameter p-cur-VAT-base       as decimal   no-undo .
     3257     define output parameter p-cur-SLT-base       as decimal   no-undo .
     3258     define output parameter p-cur-road-tax-base  as decimal   no-undo .
     3259     define output parameter p-cur-excise-base    as decimal   no-undo .
     3260     define buffer buf_temp-prt-obj for temp-prt-obj .
     3261     define variable v-prt-b-code        like ub.bar-code.b-code no-undo .
     3262     define variable v-cli-base-rate     like ub.bar-code.cli-base-rate no-undo .
     3263     define variable parrecid-prl        as recid     no-undo .
     3264     define variable v-fact-qnty         as decimal   no-undo .
     3265     define variable v-cur-base          as decimal   no-undo .
     3266     define variable v-cur-VAT-base      as decimal   no-undo .
     3267     define variable v-cur-SLT-base      as decimal   no-undo .
     3268     define variable v-cur-road-tax-base as decimal   no-undo .
     3269     define variable v-cur-excise-base   as decimal   no-undo .
     3270     define variable price-rubl-with-tax-sale-prl    as decimal   no-undo .
     3271     define variable price-base-with-tax-sale-prl    as decimal   no-undo .
     3272     define variable price-rubl-without-tax-sale-prl as decimal   no-undo .
     3273     define variable price-base-without-tax-sale-prl as decimal   no-undo .
     3274     define variable vat-base-sale-prl               as decimal   no-undo .
     3275     define variable vat-rubl-sale-prl               as decimal   no-undo .
     3276     define variable vat-base-buyer-prl              as decimal   no-undo .
     3277     define variable vat-rubl-buyer-prl              as decimal   no-undo .
     3278     define variable slt-base-sale-prl               as decimal   no-undo .
     3279     define variable slt-rubl-sale-prl               as decimal   no-undo .
     3280     define variable road-tax-base-sale-prl          as decimal   no-undo .
     3281     define variable road-tax-rubl-sale-prl          as decimal   no-undo .
     3282     define variable excise-base-sale-prl            as decimal   no-undo .
     3283     define variable excise-rubl-sale-prl            as decimal   no-undo .
     3284     define variable discnt-base-sale-prl            as decimal   no-undo .
     3285     define variable discnt-rubl-sale-prl            as decimal   no-undo .
     3286     do
     3287     on error undo, return error return-value
     3288     :
     3289       for each buf_temp-prt-obj no-lock
     3290       on error undo, return error return-value
     3291       :
     3292   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     3293     (input  p-gds-code
     3294     ,input  buf_temp-prt-obj.prt-code
     3295     ,output v-prt-b-code
     3296     ) no-error .
     3297         if error-status :error
     3298         then do:
     3299           message
     3300             vss-workfile vss-revision vss-description skip
     3301             "Ошибка при определении бар-кода признака" skip
     3302             "Код товара"   p-gds-code skip
     3303             "Код признака" buf_temp-prt-obj.prt-code skip
     3304             error-status :get-message(1) skip
     3305             return-value skip
     3306             view-as alert-box error .
     3307           undo, return error .
     3308         end.
     3309   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3310   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodepls in g#library
     3311     (input  p-obj-type
     3312     ,input  p-obj-code
     3313     ,input  v-prt-b-code
     3314     ,input  0
     3315     ,input  p-day-end-fact-order
     3316     ,output parrecid-prl
     3317     ,output v-cli-base-rate
     3318     ) no-error .
     3319         if error-status :error
     3320         then do:
     3321           message
     3322             vss-workfile vss-revision vss-description skip
     3323             "Ошибка при определении цены бар-кода" skip
     3324             "Объект" p-obj-type p-obj-code skip
     3325             "Бар-код" v-prt-b-code skip
     3326             "fact-order" p-day-end-fact-order skip
     3327             error-status :get-message(1) skip
     3328             return-value skip
     3329             view-as alert-box error .
     3330           undo, return error .
     3331         end.
     3332         if parrecid-prl <> ?
     3333         then do:
     3334           run prl-vat in this-procedure
     3335             (input  parrecid-prl
     3336             ,output price-rubl-with-tax-sale-prl
     3337             ,output price-base-with-tax-sale-prl
     3338             ,output price-rubl-without-tax-sale-prl
     3339             ,output price-base-without-tax-sale-prl
     3340             ,output vat-base-sale-prl
     3341             ,output vat-rubl-sale-prl
     3342             ,output vat-base-buyer-prl
     3343             ,output vat-rubl-buyer-prl
     3344             ,output slt-base-sale-prl
     3345             ,output slt-rubl-sale-prl
     3346             ,output road-tax-base-sale-prl
     3347             ,output road-tax-rubl-sale-prl
     3348             ,output excise-base-sale-prl
     3349             ,output excise-rubl-sale-prl
     3350             ,output discnt-base-sale-prl
     3351             ,output discnt-rubl-sale-prl
     3352             ) no-error .
     3353           if error-status :error
     3354           then do:
     3355             message
     3356               vss-workfile vss-revision vss-description skip
     3357               "Ошибка при вызове процеды prl-vat" skip
     3358               "Объект" p-obj-type p-obj-code skip
     3359               "Код товара" p-gds-code skip
     3360               "Указатель на запись переоценки" parrecid-prl skip
     3361               error-status :get-message(1) skip
     3362               return-value skip
     3363               view-as alert-box error .
     3364             undo, return error .
     3365           end.
     3366         end.
     3367         else do:
     3368           assign
     3369             price-rubl-with-tax-sale-prl    = 0
     3370             price-base-with-tax-sale-prl    = 0
     3371             price-rubl-without-tax-sale-prl = 0
     3372             price-base-without-tax-sale-prl = 0
     3373             vat-base-sale-prl               = 0
     3374             vat-rubl-sale-prl               = 0
     3375             slt-base-sale-prl               = 0
     3376             slt-rubl-sale-prl               = 0
     3377             road-tax-base-sale-prl          = 0
     3378             road-tax-rubl-sale-prl          = 0
     3379             excise-base-sale-prl            = 0
     3380             excise-rubl-sale-prl            = 0
     3381             discnt-base-sale-prl            = 0
     3382             discnt-rubl-sale-prl            = 0
     3383           .
     3384         end.
     3385         assign
     3386           v-fact-qnty         = v-fact-qnty
     3387                               + buf_temp-prt-obj.fact-qnty
     3388           v-cur-base          = v-cur-base
     3389                               + (if p-curr-r-b = 'base':U
     3390                                   then price-base-with-tax-sale-prl
     3391                                   else price-rubl-with-tax-sale-prl
     3392                                 )
     3393                               * buf_temp-prt-obj.fact-qnty
     3394           v-cur-VAT-base      = v-cur-VAT-base
     3395                               + (if p-curr-r-b = 'base':U
     3396                                   then vat-base-sale-prl
     3397                                   else vat-rubl-sale-prl
     3398                                 )
     3399                               * buf_temp-prt-obj.fact-qnty
     3400           v-cur-SLT-base      = v-cur-SLT-base
     3401                               + (if p-curr-r-b = 'base':U
     3402                                   then slt-base-sale-prl
     3403                                   else slt-rubl-sale-prl
     3404                                 )
     3405                               * buf_temp-prt-obj.fact-qnty
     3406           v-cur-road-tax-base = v-cur-road-tax-base
     3407                               + (if p-curr-r-b = 'base':U
     3408                                   then road-tax-base-sale-prl
     3409                                   else road-tax-rubl-sale-prl
     3410                                 )
     3411                               * buf_temp-prt-obj.fact-qnty
     3412           v-cur-excise-base   = v-cur-excise-base
     3413                               + (if p-curr-r-b = 'base':U
     3414                                   then excise-base-sale-prl
     3415                                   else excise-rubl-sale-prl
     3416                                 )
     3417                               * buf_temp-prt-obj.fact-qnty
     3418         .
     3419       end.
     3420       assign
     3421         p-fact-qnty         = v-fact-qnty
     3422         p-cur-base          = v-cur-base
     3423         p-cur-VAT-base      = v-cur-VAT-base
     3424         p-cur-SLT-base      = v-cur-SLT-base
     3425         p-cur-road-tax-base = v-cur-road-tax-base
     3426         p-cur-excise-base   = v-cur-excise-base
     3427       .
     3428     end.
     3429   end procedure.
     3430   procedure prdoclib-clear-temp-pl-gds :
     3431     define buffer buf_temp-pl-gds for temp-pl-gds .
     3432     do
     3433     on error undo, return error return-value
     3434     :
     3435       for each buf_temp-pl-gds
     3436       on error undo, return error return-value
     3437       :
     3438         delete buf_temp-pl-gds .
     3439       end.
     3440     end.
     3441   end procedure.
     3442   procedure prdoclib-init-temp-pl-gds :
     3443     define input parameter p-obj-type        like ub.pl-gds.obj-type  no-undo .
     3444     define input parameter p-obj-code        like ub.pl-gds.obj-code  no-undo .
     3445     define input parameter p-gds-code        like ub.pl-gds.gds-code  no-undo .
     3446     define buffer buf_pl-gds      for ub.pl-gds .
     3447     define buffer buf_temp-pl-gds for temp-pl-gds .
     3448     do
     3449     on error undo, return error return-value
     3450     :
     3451       run prdoclib-clear-temp-pl-gds in this-procedure .
     3452       for each buf_pl-gds
     3453         where buf_pl-gds.obj-type = p-obj-type
     3454           and buf_pl-gds.obj-code = p-obj-code
     3455           and buf_pl-gds.gds-code = p-gds-code
     3456       on error undo, return error return-value
     3457       :
     3458         create buf_temp-pl-gds .
     3459         buffer-copy buf_pl-gds to buf_temp-pl-gds .
     3460       end.
     3461     end.
     3462   end procedure.
     3463   procedure prdoclib-init-pl-gds-by-factord :
     3464     define input parameter p-obj-type           like ub.gds-obj.obj-type  no-undo .
     3465     define input parameter p-obj-code           like ub.gds-obj.obj-code  no-undo .
     3466     define input parameter p-artic              like ub.gds-obj.artic     no-undo .
     3467     define input parameter p-prod-type          like ub.gds-obj.prod-type no-undo .
     3468     define input parameter p-prod-code          like ub.gds-obj.prod-code no-undo .
     3469     define input parameter p-fact-order         as decimal   no-undo .
     3470     define input parameter p-include-fact-order as logical   no-undo .
     3471     define variable vss-description as character no-undo init "prdoclib-init-pl-gds-by-factord: определение остатков по признакам на любой момент времени".
     3472     define buffer buf_goods       for ub.goods .
     3473     define buffer buf_gds-obj     for ub.gds-obj .
     3474     define buffer buf_doc-line    for ub.doc-line .
     3475     define buffer buf_temp-pl-gds for temp-pl-gds .
     3476     define variable v-total-pl-gds-qnty     as decimal   no-undo .
     3477     define variable v-total-pl-gds-cli-qnty as decimal   no-undo .
     3478     do
     3479     on error undo, return error return-value
     3480     :
     3481       do transaction
     3482       on error undo, return error return-value
     3483       :
     3484   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3485   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsobjcr in g#library
     3486     (input  p-obj-type
     3487     ,input  p-obj-code
     3488     ,input  p-artic
     3489     ,input  p-prod-type
     3490     ,input  p-prod-code
     3491     ,buffer buf_gds-obj
     3492     ) no-error .
     3493         if error-status :error
     3494         then do:
     3495           message
     3496             vss-workfile vss-revision vss-description skip
     3497             vss-include-info20 skip
     3498             "Невозможно найти gds-obj" skip
     3499             error-status :get-message(1) skip
     3500             return-value skip
     3501             view-as alert-box error .
     3502           undo, return error return-value .
     3503         end.
     3504         find current buf_gds-obj exclusive-lock .
     3505       end.
     3506       find first buf_goods no-lock
     3507         where buf_goods.artic     = p-artic
     3508           and buf_goods.prod-type = p-prod-type
     3509           and buf_goods.prod-code = p-prod-code
     3510         .
     3511       run prdoclib-init-temp-pl-gds in this-procedure
     3512         (input p-obj-type
     3513         ,input p-obj-code
     3514         ,input buf_goods.gds-code
     3515         ) .
     3516       if p-include-fact-order = true
     3517       then do:
     3518         assign
     3519          p-fact-order = p-fact-order - 0.0000000001
     3520         .
     3521       end.
     3522       for each buf_doc-line no-lock
     3523         where buf_doc-line.obj-type   = p-obj-type
     3524           and buf_doc-line.obj-code   = p-obj-code
     3525           and buf_doc-line.artic      = p-artic
     3526           and buf_doc-line.prod-type  = p-prod-type
     3527           and buf_doc-line.prod-code  = p-prod-code
     3528           and buf_doc-line.status_    = 'факт':U
     3529           and buf_doc-line.fact-order >= p-fact-order
     3530       on error undo, return error return-value
     3531       :
     3532         run prdoclib-prc-pl-document in this-procedure
     3533           ( input  buf_doc-line.doc-code
     3534            ,input  p-obj-type
     3535            ,input  p-obj-code
     3536            ,input  buf_goods.gds-code
     3537            ,output v-total-pl-gds-qnty
     3538            ,output v-total-pl-gds-cli-qnty
     3539           ) .
     3540       end.
     3541     end.
     3542   end procedure.
     3543   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3544   procedure prl-vat:
     3545     define input parameter parrecid as recid no-undo.
     3546       define output parameter price-rubl-with-tax-saleprl    like ub.doc-line.price-rubl no-undo.
     3547       define output parameter price-base-with-tax-saleprl    like ub.doc-line.price-base no-undo.
     3548       define output parameter price-rubl-without-tax-saleprl like ub.doc-line.price-rubl no-undo.
     3549       define output parameter price-base-without-tax-saleprl like ub.doc-line.price-base no-undo.
     3550       define output parameter vat-base-saleprl               like ub.doc-line.price-base no-undo.
     3551       define output parameter vat-rubl-saleprl               like ub.doc-line.price-rubl no-undo.
     3552       define output parameter vat-base-buyerprl              like ub.doc-line.price-base no-undo.
     3553       define output parameter vat-rubl-buyerprl              like ub.doc-line.price-rubl no-undo.
