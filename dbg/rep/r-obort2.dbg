     3668     do
     3669     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     3670     :
     3671       find first bf_price-list no-lock
     3672         where recid(bf_price-list) = parrecid
     3673         no-error .
     3674       if not available bf_price-list
     3675       then do:
     3676         return error "Ошибка во входящих параметрах prl-vat.i" .
     3677       end.
     3678       find first bf_goods no-lock
     3679         where bf_goods.artic     = bf_price-list.artic
     3680           and bf_goods.prod-type = bf_price-list.prod-type
     3681           and bf_goods.prod-code = bf_price-list.prod-code
     3682         no-error .
     3683       if not available bf_goods
     3684       then do:
     3685         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     3686       end.
     3687       assign
     3688         varvat-pc = bf_price-list.vat-pc
     3689         varslt-pc = bf_price-list.slt-pc
     3690       .
     3691       if varvat-pc = ?
     3692       then do:
     3693         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3694       end.
     3695       if varslt-pc = ?
     3696       then do:
     3697         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     3698       end.
     3699       assign
     3700         varbase-rate   = 1
     3701         varbase-scale  = 1
     3702         varroad-tax    = bf_price-list.road-tax
     3703         varexcise      = bf_price-list.excise
