      593   define variable vss-include-info7 as character format "X(65)" no-undo
      594   initial "@(#)$Workfile$ $Revision$".
      595   procedure grplib-get-full-name :
      596      define input parameter p-node-code  as integer      no-undo.
      597      define output parameter p-full-name as character    no-undo.
      598      do
      599   on error undo, return error
      600   :
      601       define variable v-upper-code    as integer           no-undo.
      602       define buffer buf_gds-grp       for ub.gds-grp.
      603       define buffer buf_upper_gds-grp for ub.gds-grp.
      604       find first buf_gds-grp no-lock
      605            where buf_gds-grp.node-code = p-node-code
      606       no-error.
      607       if not available buf_gds-grp
      608       then do:
      609           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      610       end.
      611       assign
      612           p-full-name  = ""
      613           v-upper-code = 1
      614       .
      615       do while buf_gds-grp.upper-code <> 0
      616       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      617       :
      618           assign
      619               p-full-name  = buf_gds-grp.node-name
      620                            + (if p-full-name <> "" then chr(47) else "")
      621                            + p-full-name
      622               v-upper-code = buf_gds-grp.upper-code
      623           .
      624           find first buf_gds-grp no-lock
      625                where buf_gds-grp.node-code = v-upper-code
      626           no-error.
      627           if not available buf_gds-grp
      628           then do:
      629               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      630                                   + string( v-upper-code )
      631                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      632           end.
      633       end.
      634       assign
      635       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      636       .
      637   end.
      638   end .
      639   procedure grplib-get-node-from-full-name :
      640   define input parameter p-full-name as character no-undo .
      641   define output parameter p-node-code as integer no-undo .
      642   define variable v-ii as integer no-undo .
      643   define variable v-upper-code as integer no-undo .
      644   define variable v-root-code as integer no-undo .
      645   define variable v-entry as character no-undo .
      646   define buffer buf_gds-grp       for ub.gds-grp.
      647   do
      648   on error undo, return error
      649   :
      650     find first buf_gds-grp no-lock
      651         where buf_gds-grp.upper-code = 0
      652     no-error .
      653     if not available buf_gds-grp
      654     then do:
      655         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      656     end.
      657     else do:
      658       assign
      659       v-root-code = buf_gds-grp.node-code
      660       .
      661     end.
      662     v-upper-code = v-root-code.
      663     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      664       assign
      665       v-entry = entry(v-ii, p-full-name, chr(47)).
      666       if v-entry = '' then leave.
      667       find first buf_gds-grp no-lock where
      668                 buf_gds-grp.node-name = v-entry
      669             and buf_gds-grp.upper-code = v-upper-code
      670             no-error.
      671       if not available buf_gds-grp then do:
      672         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      673       end.
      674       else do:
      675         p-node-code = buf_gds-grp.node-code.
      676         v-upper-code = buf_gds-grp.node-code.
      677       end.
      678     end.
      679   end.
      680   end .
      681   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      682   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      683   procedure paramls-clear :
      684     define buffer buf_temp-param for temp-param .
      685     do
      686     on error undo, return error return-value
      687     :
      688       for each buf_temp-param
      689       on error undo, return error
      690       :
      691         delete buf_temp-param .
      692       end.
      693     end.
      694   end procedure.
      695   procedure paramls-write :
      696     define input  parameter p-code     as character no-undo .
      697     define input  parameter p-sub-code as character no-undo .
      698     define input  parameter p-value    as character no-undo .
      699     define buffer buf_temp-param for temp-param .
      700     do
      701     on error undo, return error return-value
      702     :
      703       find first buf_temp-param
      704         where buf_temp-param.param-code     = p-code
      705           and buf_temp-param.param-sub-code = p-sub-code
      706         no-error .
      707       if not available buf_temp-param then do:
      708         create buf_temp-param .
      709         assign
      710           buf_temp-param.param-code     = p-code
      711           buf_temp-param.param-sub-code = p-sub-code
      712         .
      713       end.
      714       assign
      715         buf_temp-param.param-value = p-value
      716       .
      717     end.
      718   end procedure.
      719   procedure paramls-read :
      720     define input  parameter p-code          as character no-undo .
      721     define input  parameter p-sub-code      as character no-undo .
      722     define input  parameter p-default-value as character no-undo .
      723     define output parameter p-value         as character no-undo .
      724     define buffer buf_temp-param for temp-param .
      725     do
      726     on error undo, return error return-value
      727     :
      728       find first buf_temp-param
      729         where buf_temp-param.param-code     = p-code
      730           and buf_temp-param.param-sub-code = p-sub-code
      731         no-error .
      732       if available buf_temp-param then do:
      733         assign
      734           p-value = buf_temp-param.param-value
      735         .
      736       end.
      737       else do:
      738         assign
      739           p-value = p-default-value
      740         .
      741       end.
      742     end.
      743   end procedure.
      744   procedure paramls-append :
      745     define input  parameter p-code     as character no-undo .
      746     define input  parameter p-sub-code as character no-undo .
      747     define input  parameter p-value    as character no-undo .
      748     define buffer buf_temp-param for temp-param .
      749     do
      750     on error undo, return error return-value
      751     :
      752       find first buf_temp-param
      753            where buf_temp-param.param-code     = p-code
      754              and buf_temp-param.param-sub-code = p-sub-code
      755         no-error .
      756       if not available buf_temp-param then do:
      757         create buf_temp-param .
      758         assign
      759           buf_temp-param.param-code     = p-code
      760           buf_temp-param.param-sub-code = p-sub-code
      761           buf_temp-param.param-value    = p-value
      762         .
      763       end.
      764       else do:
      765           assign
      766               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      767           .
      768       end.
      769     end.
      770   end procedure.
      771   define variable vss-include-info9 as character format "X(65)" no-undo
      772   initial "@(#)$Workfile$ $Revision$".
      773   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      774   procedure r-cost :
      775     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      776     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      777     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      778     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      779     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      780     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      781     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      782     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      783     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      784     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      785     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      786     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      787     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      788     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      789     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      790     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      791     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      792     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      793     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      794     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      795     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      796     do
      797     on error undo, return error
      798     :
      799       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      800       define buffer   in-vatp-parts    for ub.parts   .
      801       define buffer   in-vatp-doc      for ub.trn-doc .
      802       define buffer   in-vatp-goods    for ub.goods   .
      803       define buffer   in-vatp-sysconf  for ub.sysconf .
      804       define buffer   in-vatp_doc-attr for ub.doc-attr.
      805       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      806       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      807       define variable varinvprb                  as   character              no-undo.
      808       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      809       define variable cli-base-rate              as   decimal                no-undo.
      810       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      811       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      812       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      813       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      814       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      815       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      816       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      817       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      818       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      819       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      820       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      821       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      822       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      823       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      824       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      825       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      826       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      827       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      828       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      829       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      830       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      831       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      832       define variable varinvatp-envd             as   character              no-undo.
      833       define variable varinvatp-type             as   character              no-undo.
      834       def var v-parts-fact-qnty as decimal   no-undo .
      835       define buffer buf_parts    for ub.parts    .
      836       define buffer buf_goods    for ub.goods    .
      837       define buffer buf_trn-doc  for ub.trn-doc  .
      838       define buffer buf_doc-line for ub.doc-line .
      839       find first buf_doc-line no-lock
      840         where buf_doc-line.doc-code  = v-doc-code
      841           and buf_doc-line.artic     = v-artic
      842           and buf_doc-line.prod-type = v-prod-type
      843           and buf_doc-line.prod-code = v-prod-code
      844         no-error .
      845       if not available buf_doc-line then do:
      846         message
      847           vss-workfile vss-revision vss-description skip
      848           vss-include-info10 skip
      849           "Ошибка задания входных параметров" skip
      850           "Не найдена строка документа"  skip
      851           "Документ" v-doc-code skip
      852           "Артикул" v-artic v-prod-type v-prod-code skip
      853           view-as alert-box error .
      854         return error .
      855       end.
      856       find first buf_trn-doc no-lock
      857         where buf_trn-doc.doc-code = v-doc-code
      858         no-error .
      859       if not available buf_trn-doc then do:
      860         message
      861           vss-workfile vss-revision vss-description skip
      862           vss-include-info10 skip
      863           "Ошибка задания входных параметров" skip
      864           "Не найден документ" skip
      865           "Документ" v-doc-code skip
      866           "Артикул" v-artic v-prod-type v-prod-code skip
      867           view-as alert-box error .
      868         undo, return error .
      869       end.
      870       find first buf_goods no-lock
      871         where buf_goods.artic     = buf_doc-line.artic
      872           and buf_goods.prod-type = buf_doc-line.prod-type
      873           and buf_goods.prod-code = buf_doc-line.prod-code
      874         no-error .
      875       if not available buf_goods then do:
      876         message
      877           vss-workfile vss-revision vss-description skip
      878           vss-include-info10 skip
      879           "Ошибка задания входных параметров" skip
      880           "Не найден товар" skip
      881           "Документ" v-doc-code skip
      882           "Артикул" v-artic v-prod-type v-prod-code skip
      883           view-as alert-box error .
      884         undo, return error .
      885       end.
      886       if buf_goods.gds-type = 'т':U then do:
      887             for each buf_parts no-lock
      888               where buf_parts.out-code  = buf_trn-doc.doc-code
      889                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      890                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      891                 and buf_parts.artic     = buf_doc-line.artic
      892                 and buf_parts.prod-type = buf_doc-line.prod-type
      893                 and buf_parts.prod-code = buf_doc-line.prod-code
      894             on error undo, return error
      895             :
      896   assign
      897     price-rubl-with-tax-loc = buf_parts.price-rubl
      898     price-base-with-tax-loc = buf_parts.price-base
      899   .
      900   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      901   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      902     (output varinvprb
      903     )  .
      904     if buf_parts.out-code = 'free-zone':U     or
      905        buf_parts.out-code = 'out-zone':U   or
      906        buf_parts.doc-type = 'акт':U then do:
      907       assign
      908         in-vatp-have-vat-slt = yes.
      909     end.
      910     else do:
      911       find first in-vatp_doc-attr no-lock
      912         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      913           and in-vatp_doc-attr.attr-code = 'envd':U
      914         no-error .
      915       if not available in-vatp_doc-attr then do:
      916         assign
      917           in-vatp-have-vat-slt = yes.
      918       end.
      919       else do:
      920            in-vatp-have-vat-slt = no.
      921       end.
      922     end.
      923     assign
      924      price-cli-with-tax-loc = buf_parts.price-cli
      925      cli-base-rate          = buf_parts.cli-base-rate.
      926     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      927              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      928     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      929             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      930             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      931             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      932             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      933             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      934             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      935       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
