     6150                   and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6151                   and buf_temp-prt.sum-type = 5            and buf_temp-prt.doc-type = 're':U
     6152               no-error .
