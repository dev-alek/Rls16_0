     3987   define variable v-inform-launched as logical no-undo initial false .
     3988   procedure proc-alt-shift-f4:
     3989     define variable v-action as character no-undo .
     3990     if v-inform-launched = false then do:
     3991       assign
     3992         v-inform-launched = true
     3993       .
     3994       run gbl/d-inform.w
     3995         (  input self
     3996         ,  input this-procedure
     3997         , output v-action
     3998         ) no-error .
     3999       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     4000       assign
