     6403             assign v-col = v-col + 1    beg = beg + 15 .
     6404           end.
     6405           if use-column[8]  = yes then do:
     6406             if ExportZUM then put stream txt-file gds-prop.LastPer-Date format "99/99/9999"   CHR(9) .
     6407             assign v-col = v-col + 1    beg = beg + 11 .
     6408           end.
     6409           if use-column[9]  = yes then do:
     6410             if ExportZUM then put stream txt-file gds-prop.LastPer-Num format "X(10)" CHR(9) .
     6411             assign v-col = v-col + 1    beg = beg + 11 .
     6412           end.
     6413           for each temp-sum where temp-sum.level = -2 :
     6414             case temp-sum.sum-type :
     6415               when 0 then do:
     6416                 put stream outstream  "|" at beg temp-sum.sum format frm-qnty  .
     6417                 if ExportZUM then put stream txt-file UNFORMATTED  replace(string(temp-sum.sum,frm-qnty1),".",",") CHR(9) .
     6418                 run macr_excel_sum (temp-sum.sum, v-row, v-col, sz-qnty) .
     6419                 assign  beg = beg + 15 .
     6420               end.
     6421               when  2 then do:
     6422                 put stream outstream  "|" at beg temp-sum.sum format frm-sum .
     6423                 if ExportZUM then put stream txt-file UNFORMATTED  replace(string(temp-sum.sum,frm-sum1),".",",")  CHR(9) .
     6424                 run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     6425                 assign  beg = beg + 15 .
     6426               end.
     6427               when 1 or when 3 then do:
     6428                 if ExportZUM then put stream txt-file  CHR(9) .
     6429                 put stream outstream  "|" at beg .
     6430                 assign  beg = beg + 15 .
     6431               end.
     6432               when 4 then do:
     6433                 if ExportZUM then put stream txt-file  CHR(9) .
     6434                 put stream outstream  "|" at beg .
     6435                 assign  beg = beg + 10 .
     6436               end.
     6437             end.
     6438             assign v-col = v-col + 1 .
     6439           end.
     6440           put stream outstream   "|"  skip .
     6441           if ExportZUM then put stream txt-file  chr(10) .
     6442           assign v-row = v-row + 1 .
     6443         end.
     6444       end.
     6445     end.
     6446   end procedure.
     6447   procedure GetBegSum :
     6448     do on error undo, return error return-value :
     6449       define input  parameter p-find as character no-undo .
     6450       define output parameter p-sum as decimal   no-undo .
     6451       define buffer buf_stk-line for stk-line.
     6452       find last buf_stk-line no-lock
     6453         where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     6454           and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     6455           and buf_stk-line.artic     = buf_gds-obj.artic
     6456           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     6457           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     6458           and buf_stk-line.cat-id    = '##,##'
     6459           and buf_stk-line.sum-type  = p-find
     6460           and buf_stk-line.fact-order <= v-fact-order-start
     6461         use-index category no-error .
     6462       if available buf_stk-line then do:
     6463         if x-SET_val_TYPE = 1  then assign p-sum = buf_stk-line.sum-rubl .
     6464         else                        assign p-sum = buf_stk-line.sum-base .
     6465       end.
     6466     end.
     6467   end procedure.
     6468   procedure GetEndSum :
     6469     do on error undo, return error return-value :
     6470       define input  parameter p-find as character no-undo .
     6471       define output parameter p-sum as decimal   no-undo .
     6472       define buffer buf_stk-line for stk-line.
     6473       find last buf_stk-line no-lock
     6474         where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     6475           and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     6476           and buf_stk-line.artic     = buf_gds-obj.artic
     6477           and buf_stk-line.prod-type = buf_gds-obj.prod-type
     6478           and buf_stk-line.prod-code = buf_gds-obj.prod-code
     6479           and buf_stk-line.cat-id    = '##,##'
     6480           and buf_stk-line.sum-type  = p-find
     6481           and buf_stk-line.fact-order < v-fact-order-end
     6482         use-index category no-error .
     6483       if available buf_stk-line then do:
     6484         if x-SET_val_TYPE = 1  then assign p-sum = buf_stk-line.sum-rubl .
     6485         else                        assign p-sum = buf_stk-line.sum-base .
     6486       end.
     6487     end.
     6488   end procedure.
     6489   PROCEDURE foreach1 :
     6490     if tog-obj = true then do:
     6491       for each obj-list no-lock :
     6492         assign  titul = 0 .
     6493         for each temp-sum where temp-sum.level = 2 : assign temp-sum.sum = 0 . end.
     6494         for each gds-prop where gds-prop.obj-type = obj-list.obj-type and gds-prop.obj-code = obj-list.obj-code by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic :
     6495           run PrintLine in this-procedure .
     6496         End.
     6497         run PutItogSum in this-procedure (2) .
     6498       end.
     6499     end.
     6500     else do:
     6501       for each gds-prop by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic :
     6502         run PrintLine in this-procedure .
     6503       End.
     6504     end.
     6505     run PutItogSum in this-procedure (1) .
     6506   END PROCEDURE.
     6507   PROCEDURE foreach2 :
     6508     if tog-obj = true then do:
     6509       for each obj-list no-lock :
     6510         assign  titul = 0 .
     6511         for each temp-sum where temp-sum.level = 2 : assign temp-sum.sum = 0 . end.
     6512         for each gds-prop where gds-prop.obj-type = obj-list.obj-type and gds-prop.obj-code = obj-list.obj-code break by gds-prop.prod-name by if SortType = "sort-code":U   then  gds-prop.b-code Else  gds-prop.artic :
     6513   define variable vss-include-info66 as character format "X(65)" no-undo
     6514   initial "@(#)$Workfile$ $Revision$".
     6515           if first-of(gds-prop.prod-name) then do:
     6516             assign var-client = "Производитель " + gds-prop.prod-name .
     6517             for each temp-sum where temp-sum.level = 3 : assign temp-sum.sum = 0 . end.
     6518           End.
     6519           run PrintLine in this-procedure .
     6520           if NullStr < 2 then run CalculSum in this-procedure (3) .
     6521           if last-of(gds-prop.prod-name) then do:
     6522             assign ItogStr = "Итого по производителю " + gds-prop.prod-name + ":"  .
     6523             run PutItogSum in this-procedure (3) .
     6524           End.
     6525         End.
     6526         run PutItogSum in this-procedure (2).
     6527       end.
     6528     end.
