      162   procedure create_obj-list :
      163      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      164      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      165      do
      166      on error undo, return error return-value
      167      :
      168         define buffer cli-obj for ub.clients .
      169         define variable p-var as integer no-undo .
      170         define buffer buf_obj-list for obj-list .
      171         find last buf_obj-list  use-index pi no-error .
      172         if available buf_obj-list
      173         then
      174            p-var = buf_obj-list.obj-id + 1.
      175         else
      176            p-var = 1.
      177         find first cli-obj where
      178                   cli-obj.obj-type = p-obj-type
      179               and cli-obj.obj-code = p-obj-code
      180         no-lock no-error.
      181         if available cli-obj
      182         then do:
      183            create buf_obj-list.
      184            assign
      185               buf_obj-list.obj-id   = p-var
      186               buf_obj-list.obj-code = cli-obj.obj-code
      187               buf_obj-list.obj-type = cli-obj.obj-type
      188               buf_obj-list.obj-name = cli-obj.obj-name
      189               buf_obj-list.db-num   = cli-obj.db-num
      190            .
      191         end.
      192      end.
      193   end.
