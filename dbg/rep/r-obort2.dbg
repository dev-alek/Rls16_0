     3705         varprice-rubl  = bf_price-list.price-sale
     3706         vardiscnt-base = 0
     3707         vardiscnt-rubl = 0
     3708       .
     3709       assign
     3710         varfact-qnty = 0
     3711       .
     3712       for each bf_parts no-lock
     3713         where bf_parts.out-code   = bf_price-list.doc-num
     3714           and bf_parts.obj-type   = bf_price-list.obj-type
     3715           and bf_parts.obj-code   = bf_price-list.obj-code
     3716           and bf_parts.artic      = bf_price-list.artic
     3717           and bf_parts.prod-type  = bf_price-list.prod-type
     3718           and bf_parts.prod-code  = bf_price-list.prod-code
     3719       :
