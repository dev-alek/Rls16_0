     6133             when "eff-val" or when "eff-prc" then do:
     6134               define variable sm1 as decimal initial 0 no-undo .
     6135               define variable sm2 as decimal initial 0 no-undo .
     6136               find first buf_temp-prt
     6137                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6138                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6139                   and buf_temp-prt.sum-type = 5               and buf_temp-prt.doc-type = 'ee':U
     6140               no-error .
     6141               if available buf_temp-prt then assign sm2 = buf_temp-prt.sum .
     6142               find first buf_temp-prt
     6143                 where buf_temp-prt.obj-type = p-obj-type   and buf_temp-prt.obj-code = p-obj-code
     6144                   and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6145                   and buf_temp-prt.sum-type = 5            and buf_temp-prt.doc-type = 'es':U
