     3760       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     3761         and out-vatp_doc-attrprl.attr-code = 'envd':U
     3762         no-error .
     3763     if not available out-vatp_doc-attrprl then do:
     3764       assign
