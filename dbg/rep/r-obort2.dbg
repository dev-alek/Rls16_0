     5264   end.
     5265   END PROCEDURE.
     5266   PROCEDURE CalcOborot :
     5267   define variable vss-include-info64 as character format "X(65)" no-undo
     5268   initial "@(#)$Workfile$ $Revision$".
     5269   define variable v1-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     5270   define variable v1-vat-pc            like ub.doc-line.vat-pc         no-undo .
     5271   define variable v1-slt-pc            like ub.doc-line.slt-pc         no-undo .
     5272   define variable v1-sum-base          like ub.ot-line.sum-base        no-undo .
     5273   define variable v1-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     5274   define variable v1-vat-base          like ub.ot-line.vat-base        no-undo .
     5275   define variable v1-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     5276   define variable v1-slt-base          like ub.ot-line.slt-base        no-undo .
     5277   define variable v1-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     5278   define variable v1-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     5279   define variable v1-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     5280   define variable v1-transport-base    like ub.ot-line.transport-base  no-undo .
     5281   define variable v1-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     5282   define variable v1-other-base        like ub.ot-line.other-base      no-undo .
     5283   define variable v1-other-rubl        like ub.ot-line.other-rubl      no-undo .
     5284   define variable v1-excise-base       like ub.ot-line.excise-base     no-undo .
     5285   define variable v1-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     5286   define variable v2-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     5287   define variable v2-vat-pc            like ub.doc-line.vat-pc         no-undo .
     5288   define variable v2-slt-pc            like ub.doc-line.slt-pc         no-undo .
     5289   define variable v2-sum-base          like ub.ot-line.sum-base        no-undo .
     5290   define variable v2-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     5291   define variable v2-vat-base          like ub.ot-line.vat-base        no-undo .
     5292   define variable v2-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     5293   define variable v2-slt-base          like ub.ot-line.slt-base        no-undo .
     5294   define variable v2-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     5295   define variable v2-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     5296   define variable v2-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     5297   define variable v2-transport-base    like ub.ot-line.transport-base  no-undo .
     5298   define variable v2-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     5299   define variable v2-other-base        like ub.ot-line.other-base      no-undo .
     5300   define variable v2-other-rubl        like ub.ot-line.other-rubl      no-undo .
     5301   define variable v2-excise-base       like ub.ot-line.excise-base     no-undo .
     5302   define variable v2-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     5303   define variable v-prt-b-code like ub.bar-code.b-code no-undo .
     5304   define buffer buf_gds-dtl for gds-dtl.
     5305     for each buf_doc-line no-lock
     5306       where buf_doc-line.obj-type   = buf_gds-obj.obj-type
     5307         and buf_doc-line.obj-code   = buf_gds-obj.obj-code
     5308         and buf_doc-line.prod-type  = buf_gds-obj.prod-type
     5309         and buf_doc-line.prod-code  = buf_gds-obj.prod-code
     5310         and buf_doc-line.artic      = buf_gds-obj.artic
     5311         and buf_doc-line.status_    = 'факт':U
     5312         and buf_doc-line.fact-order >= v-fact-order-start
     5313         and buf_doc-line.fact-order <  v-fact-order-end
     5314       :
     5315       run r-cost in this-procedure ( input buf_doc-line.doc-code   , input buf_doc-line.artic , input buf_doc-line.prod-type
     5316                                    , input buf_doc-line.prod-code  , output v1-fact-qnty        , output v1-vat-pc
     5317                                    , output v1-slt-pc              , output v1-sum-base         , output v1-sum-rubl
     5318                                    , output v1-vat-base            , output v1-vat-rubl         , output v1-slt-base
     5319                                    , output v1-slt-rubl            , output v1-road-tax-base    , output v1-road-tax-rubl
     5320                                    , output v1-transport-base      , output v1-transport-rubl   , output v1-other-base
     5321                                    , output v1-other-rubl          , output v1-excise-base      , output v1-excise-rubl ).
     5322       run r-sale in this-procedure ( input buf_doc-line.doc-code   , input buf_doc-line.artic   , input buf_doc-line.prod-type
     5323                                      , input buf_doc-line.prod-code , output v2-fact-qnty       , output v2-vat-pc
     5324                                      , output v2-slt-pc            , output v2-sum-base         , output v2-sum-rubl
     5325                                      , output v2-vat-base          , output v2-vat-rubl         , output v2-slt-base
     5326                                      , output v2-slt-rubl          , output v2-road-tax-base    , output v2-road-tax-rubl
     5327                                      , output v2-transport-base    , output v2-transport-rubl   , output v2-other-base
     5328                                      , output v2-other-rubl        , output v2-excise-base      , output v2-excise-rubl ).
     5329       if gds-prop.empty-scale = no then do:
     5330         FOR EACH buf_gds-dtl no-lock
     5331           where buf_gds-dtl.artic     = buf_doc-line.artic
     5332             AND buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     5333             AND buf_gds-dtl.prod-code = buf_doc-line.prod-code
     5334             AND buf_gds-dtl.prod-type = buf_doc-line.prod-type
     5335           :
     5336   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5337     (input  buf_gds-obj.gds-code
     5338     ,input  buf_gds-dtl.prt-code
     5339     ,output v-prt-b-code
     5340     ) no-error .
     5341           if error-status :error then do:
     5342             message  vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода признака" skip
     5343                 "Код товара"   buf_gds-obj.gds-code skip  "Код признака" buf_gds-dtl.prt-code skip error-status :get-message(1) skip
     5344             return-value skip
     5345             view-as alert-box error .
     5346             undo, return error .
     5347           end.
     5348           if buf_doc-line.ext-doc-type = 'vt':U or buf_doc-line.ext-doc-type = 'vp':U then do:
     5349             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.doc-qnty ) .
     5350             if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.doc-qnty * v1-sum-rubl / v1-fact-qnty ) .
     5351             else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.doc-qnty * v1-sum-base / v1-fact-qnty ) .
     5352             if buf_doc-line.ext-doc-type <> 'ie':U         and
     5353                buf_doc-line.ext-doc-type <> 'ep':U      then do:
     5354               if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.doc-qnty * buf_gds-dtl.price-rubl ) .
     5355               else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.doc-qnty * buf_gds-dtl.price-base ) .
     5356             end.
     5357           end.
     5358           else do:
     5359             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty ) .
     5360             if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * v1-sum-rubl / v1-fact-qnty ) .
     5361             else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * v1-sum-base / v1-fact-qnty ) .
     5362             if buf_doc-line.ext-doc-type <> 'ie':U         and
     5363                buf_doc-line.ext-doc-type <> 'ep':U      then do:
     5364               if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * buf_gds-dtl.price-rubl ) .
     5365               else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code, buf_gds-dtl.fact-qnty * buf_gds-dtl.price-base ) .
     5366               if   buf_doc-line.ext-doc-type = 'ee':U
     5367                 or buf_doc-line.ext-doc-type = 'es':U
     5368                 or buf_doc-line.ext-doc-type = 're':U
     5369                 or buf_doc-line.ext-doc-type = 'rs':U
     5370               then do:
     5371                 if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 3, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code,  buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-rubl ) .
     5372                 else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 3, buf_doc-line.ext-doc-type, buf_gds-dtl.prt-code, v-prt-b-code,  buf_gds-dtl.fact-qnty * buf_gds-dtl.discnt-base ) .
     5373               end.
     5374             end.
     5375           end.
     5376         end.
     5377       end.
     5378       if buf_doc-line.ext-doc-type = 'ee':U      or
     5379          buf_doc-line.ext-doc-type = 'es':U or
     5380          buf_doc-line.ext-doc-type = 'ep':U   or
     5381          buf_doc-line.ext-doc-type = 'ev':U      or
     5382          buf_doc-line.ext-doc-type = 'we':U      or
     5383          buf_doc-line.ext-doc-type = 'wm':U       then
     5384         assign
     5385           v1-fact-qnty  = - v1-fact-qnty
     5386           v1-sum-rubl   = - v1-sum-rubl
     5387           v1-sum-base   = - v1-sum-base
     5388           v2-sum-rubl   = - v2-sum-rubl
     5389           v2-sum-base   = - v2-sum-base
     5390           v2-other-rubl = - v2-other-rubl
     5391           v2-other-base = - v2-other-base
     5392         .
     5393       run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v1-fact-qnty) .
     5394       if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v1-sum-rubl) .
     5395       else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v1-sum-base) .
     5396       if buf_doc-line.ext-doc-type <> 'ie':U and  buf_doc-line.ext-doc-type <> 'ep':U  then do:
     5397         if   buf_doc-line.ext-doc-type = 'ee':U
     5398           or buf_doc-line.ext-doc-type = 'es':U
     5399           or buf_doc-line.ext-doc-type = 're':U
     5400           or buf_doc-line.ext-doc-type = 'rs':U
     5401         then do:
     5402           if x-SET_val_TYPE = 1  then do:
     5403             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 3, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-other-rubl) .
     5404             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 4, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-other-rubl * 100 / v2-sum-rubl) .
     5405             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 5, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-sum-rubl) .
     5406           end.
     5407           else do:
     5408             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 3, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-other-base) .
     5409             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 4, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-other-base * 100 / v2-sum-base) .
     5410             run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 5, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-sum-base) .
     5411           end.
     5412         end.
     5413         else do:
     5414           if x-SET_val_TYPE = 1  then run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-sum-rubl) .
     5415           else                        run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, buf_doc-line.ext-doc-type, -1, gds-prop.b-code, v2-sum-base) .
     5416         end.
     5417       end.
     5418     end.
     5419     assign
     5420       v1-sum-rubl = 0
     5421       v2-sum-rubl = 0
     5422     .
     5423     if buf_goods.gds-type = 'у':U then assign line1 = 'gdsr':U .
     5424     else                                       assign line1 = 'cgdt':U .
     5425     if use-column[67] = yes then do:
     5426       run GetEndSum (input (line1 + 'ot':U) ,output v1-sum-rubl ) .
     5427       run GetBegSum (input (line1 + 'ot':U) ,output v2-sum-rubl ) .
     5428       run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, 'ot':U, -1, gds-prop.b-code, v1-sum-rubl - v2-sum-rubl) .
     5429     end.
     5430     run GetEndSum (input (line1 + 'ee':U) ,output v1-sum-rubl ) .
     5431     run GetBegSum (input (line1 + 'ee':U) ,output v2-sum-rubl ) .
     5432     run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, 'ee':U, -1, gds-prop.b-code, v2-sum-rubl - v1-sum-rubl) .
     5433     run GetEndSum (input (line1 + 'es':U) ,output v1-sum-rubl ) .
     5434     run GetBegSum (input (line1 + 'es':U) ,output v2-sum-rubl ) .
     5435     run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, 'es':U, -1, gds-prop.b-code, v2-sum-rubl - v1-sum-rubl) .
     5436     run GetEndSum (input (line1 + 're':U) ,output v1-sum-rubl ) .
     5437     run GetBegSum (input (line1 + 're':U) ,output v2-sum-rubl ) .
     5438     run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, 're':U, -1, gds-prop.b-code, v1-sum-rubl - v2-sum-rubl) .
     5439     run GetEndSum (input (line1 + 'rs':U) ,output v1-sum-rubl ) .
     5440     run GetBegSum (input (line1 + 'rs':U) ,output v2-sum-rubl ) .
     5441     run Add-temp-prt ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, 'rs':U, -1, gds-prop.b-code, v1-sum-rubl - v2-sum-rubl) .
     5442   END PROCEDURE.
     5443   procedure CalculSum :
     5444     define input  parameter p-num as integer   no-undo .
     5445     define buffer buf_temp-sum for temp-sum .
     5446     for each temp-sum where temp-sum.level = -1 :
     5447       find first buf_temp-sum
     5448         where buf_temp-sum.level    = p-num
     5449           and buf_temp-sum.num      = temp-sum.num
     5450           and buf_temp-sum.doc-type = temp-sum.doc-type
     5451           and buf_temp-sum.sum-type = temp-sum.sum-type
     5452       no-error .
     5453       if not available buf_temp-sum then do:
     5454         create buf_temp-sum .
     5455         assign
     5456           buf_temp-sum.level    = p-num
     5457           buf_temp-sum.num      = temp-sum.num
     5458           buf_temp-sum.doc-type = temp-sum.doc-type
     5459           buf_temp-sum.sum-type = temp-sum.sum-type
     5460           buf_temp-sum.sum      = temp-sum.sum
     5461         .
     5462       end.
     5463       else assign buf_temp-sum.sum = buf_temp-sum.sum + temp-sum.sum .
     5464     end.
     5465   end procedure.
     5466   procedure PrintLine :
     5467   define variable vss-include-info65 as character format "X(65)" no-undo
     5468   initial "@(#)$Workfile$ $Revision$".
     5469     if line-counter( Outstream ) + 3 > page-size( Outstream ) then do:
     5470       put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     5471       page stream OutStream .
     5472       run rep/r-obrt21.p (input 2, input RADIO-AltObj, input end-sum, output ii, output ii   ) .
     5473     end.
     5474     if  ( v-row ) >= 63000 then do:
     5475       Output stream Macr_Excel  close .
     5476       run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     5477       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     5478       output stream  Macr_Excel to value(v-file-name) .
     5479       v-ind = v-ind + 1 .
     5480       run rep/r-obrt21.p (input 1, input RADIO-AltObj, input end-sum, output start-col, output v-row) .
     5481     end.
     5482     for each temp-sum where temp-sum.level = -1 :
     5483       assign temp-sum.sum = 0  .
     5484     end.
     5485     assign jj = 1 .
     5486     do ii = 1 to 9 :
     5487       if use-column[ii]  = yes then assign jj = jj + 1 .
     5488     end.
     5489     if use-column[12] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, "ost-beg", -1, jj ) .          assign jj = jj + 1 . end.
     5490     if use-column[31] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, "ost-beg", -1, jj ) .          assign jj = jj + 1 . end.
     5491     if use-column[50] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, "ost-beg", -1, jj ) .          assign jj = jj + 1 . end.
     5492     if use-column[14] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, 'ie':U, -1, jj ) . assign jj = jj + 1 . end.
     5493     if use-column[33] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, 'ie':U, -1, jj ) . assign jj = jj + 1 . end.
     5494     if use-column[15] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, 'ep':U, -1, jj ) . assign jj = jj + 1 . end.
     5495     if use-column[34] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, 'ep':U, -1, jj ) . assign jj = jj + 1 . end.
     5496     if use-column[16] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, 'ee':U, -1, jj ) . assign jj = jj + 1 . end.
