     2197     on error undo, return error return-value
     2198     :
     2199       find first buf_temp-prt-obj
     2200         where buf_temp-prt-obj.prt-code = buf_prt-obj.prt-code
     2201         no-error .
     2202       if not available buf_temp-prt-obj
     2203       then do:
     2204         create buf_temp-prt-obj .
     2205         assign
     2206           buf_temp-prt-obj.prt-code         = buf_prt-obj.prt-code
     2207           buf_temp-prt-obj.price-sale       = ?
     2208           buf_temp-prt-obj.fact-qnty        = buf_prt-obj.fact-qnty
     2209           buf_temp-prt-obj.price-list-qnty  = ?
     2210           buf_temp-prt-obj.prt-obj-recid    = recid(buf_prt-obj)
     2211           buf_temp-prt-obj.price-list-recid = ?
     2212         .
     2213         find first buf_gds-prt no-lock
     2214           where buf_gds-prt.node-code = buf_temp-prt-obj.prt-code
     2215           .
     2216         assign
     2217           buf_temp-prt-obj.is-term = buf_gds-prt.is-term
     2218         .
     2219         if buf_temp-prt-obj.is-term
     2220         then do:
     2221           assign
     2222             buf_temp-prt-obj.price-sale = p-root-price-sale
     2223           .
     2224         end.
     2225       end.
     2226     end.
