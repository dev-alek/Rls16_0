     3737     (input  bf_price-list.obj-type
     3738     ,input  bf_price-list.obj-code
     3739     ,output v-host-code
     3740     )  .
     3741       find first bf_sysconf no-lock
     3742         where bf_sysconf.host-code = v-host-code
     3743         .
     3744       if bf_sysconf.cons-vat-pc = ?
     3745       then do:
     3746         return error "Не задан консигнационный НДС по фирме." .
     3747       end.
     3748       else do:
