     6969   END PROCEDURE.
     6970   procedure end-proc :
     6971    do
     6972    on error undo, return error return-value
     6973    :
     6974     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     6975     OUTPUT to VALUE (v-file-name) .
     6976     for each temp-param :
     6977       export  temp-param  .
     6978     end.
     6979    end.
     6980   end procedure.
     6981   FUNCTION format-excel-text-macr RETURNS CHAR ( INPUT Start-Text AS CHAR ) :
     6982   def var  i    AS INT NO-UNDO.
     6983   def var  ch   AS CHAR NO-UNDO.
     6984   def var  N    AS INT NO-UNDO.
     6985   def var  iPos AS INT NO-UNDO.
     6986     N = NUM-ENTRIES(TRIM(Start-Text), CHR(10)) - 1 .
     6987     DO i = 1 TO N :
     6988       iPos = INDEX( Start-Text, CHR(10)).
     6989       IF iPos > 0 THEN
     6990         SUBSTRing( Start-Text, iPos , 1 ) = ' '.
     6991     END.
     6992     N = NUM-ENTRIES(TRIM(Start-Text), CHR(13)) - 1 .
     6993     DO i = 1 TO N :
     6994       iPos = INDEX( Start-Text, CHR(13)).
     6995       IF iPos > 0 THEN
     6996         SUBSTRing( Start-Text, iPos, 1 ) = ' '.
     6997     END.
     6998     IF INDEX( Start-Text, '"' ) = 0 THEN
     6999       Start-Text =  '"'   + TRIM( Start-Text) + '"'   .
     7000       ELSE DO:
     7001         N = NUM-ENTRIES(TRIM(Start-Text), '"') - 1.
     7002         DO i = 1 TO N :
     7003           ch = ch + ENTRY(i,TRIM(Start-Text), '"' ) + '""'.
     7004         END.
     7005         ch = ch + ENTRY(NUM-ENTRIES(TRIM(Start-Text), '"'),TRIM(Start-Text), '"' ).
     7006         Start-Text = '"'  + ch  + '"' .
     7007       END.
     7008     N = NUM-ENTRIES(TRIM(Start-Text), CHR(10)) - 1 .
     7009     DO i = 1 TO N :
     7010       iPos = INDEX( Start-Text, CHR(10)).
     7011       IF iPos > 0 THEN
     7012         SUBSTRing( Start-Text, iPos , 1 ) = ' '.
     7013     END.
     7014       if NUM-ENTRIES(TRIM(Start-Text), CHR(10)) > 1 then  message NUM-ENTRIES(TRIM(Start-Text), CHR(10)) Start-Text.
     7015     RETURN Start-Text.
     7016   END.
     7017   procedure macr_excel_char :
     7018    do
     7019    on error undo, return error return-value
     7020    :
     7021    define input parameter  p-val as character no-undo .
     7022    define input parameter  p-row as integer no-undo .
     7023    define input parameter  p-col as integer no-undo .
     7024         put  stream macr_excel unformatted
     7025           substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) skip  .
     7026    end.
     7027   end procedure.
     7028   procedure macr_excel_sum :
     7029    do
     7030    on error undo, return error return-value
     7031    :
     7032    define input parameter  p-val as decimal   no-undo .
     7033    define input parameter  p-row as integer   no-undo .
     7034    define input parameter  p-col as integer   no-undo .
     7035    define input parameter  p-typ as integer   no-undo .
     7036    if p-val = ? then assign p-val = 0 .
     7037    define variable ss as character no-undo .
     7038    assign ss = string( Round( p-val, p-typ) ) .
     7039    put  stream macr_excel unformatted substitute('formula(&3,"r&1c&2")', p-row , p-col , ss ) skip  .
     7040    end.
     7041   END procedure.
     7042   procedure macr_cell_format :
     7043    do
     7044    on error undo, return error return-value
     7045    :
     7046    define input parameter  p-size   as integer   no-undo .
     7047    define input parameter  p-bold   as logical   no-undo .
     7048    define input parameter  p-italic as logical   no-undo .
     7049    define input parameter  p-color  as integer   no-undo .
     7050    define input parameter  p-row    as integer   no-undo .
     7051    define input parameter  p-col    as integer   no-undo .
     7052    define input parameter  p-row-2  as integer   no-undo .
     7053    define input parameter  p-col-2  as integer   no-undo .
     7054     if p-size = ? then p-size = 10 .
     7055     if p-bold = ? then p-bold = false .
     7056     if p-italic = ? then p-italic = false .
     7057     if p-row-2 = ? then p-row-2 = p-row .
     7058     if p-col-2 = ? then p-col-2 = p-col .
     7059     put  stream macr_excel unformatted
     7060      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     7061     if p-color <> ? then do:
     7062        put  stream macr_excel unformatted
     7063          substitute('patterns(1,,&1,true)', p-color )  skip  .
     7064     end.
     7065     put  stream macr_excel unformatted
     7066          substitute('format.font(,&1,&2,&3)' , p-size,
     7067                                           string ( p-bold  , "true/false" ) ,
     7068                                           string ( p-italic , "true/false" )
     7069                                           ) skip .
     7070    end.
     7071   end procedure.
     7072   procedure macr_cell_bordur :
     7073    do
     7074    on error undo, return error return-value
     7075    :
     7076    define input parameter  p-row    as integer   no-undo .
     7077    define input parameter  p-col    as integer   no-undo .
     7078    define input parameter  p-row-2  as integer   no-undo .
     7079    define input parameter  p-col-2  as integer   no-undo .
     7080     if p-row-2 = ? then p-row-2 = p-row .
     7081     if p-col-2 = ? then p-col-2 = p-col .
     7082     put  stream macr_excel unformatted
     7083      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) skip .
     7084     put  stream macr_excel unformatted
     7085          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  skip
     7086          'ALIGNMENT(3 , , 4 , 4 ,)'   skip
     7087          .
     7088    end.
     7089   end procedure.
     7090   procedure macr_cell_size :
     7091    do
     7092    on error undo, return error return-value
     7093    :
     7094    define input parameter  p-w   as integer   no-undo .
     7095    define input parameter  p-l   as integer   no-undo .
     7096    define input parameter  p-row    as integer   no-undo .
     7097    define input parameter  p-col    as integer   no-undo .
     7098    define input parameter  p-row-2  as integer   no-undo .
     7099    define input parameter  p-col-2  as integer   no-undo .
     7100     if p-row-2 = ? then p-row-2 = p-row .
     7101     if p-col-2 = ? then p-col-2 = p-col .
     7102     if p-w = ? then    p-w = 0 .
     7103     if p-l = ? then    p-l = 0 .
     7104    define variable s-w as character no-undo .
     7105    define variable s-l as character no-undo .
     7106    if p-w = 0 then s-w = "" .
     7107               else s-w = string(p-w)  .
     7108    if p-l = 0 then s-l = "" .
     7109               else s-l = string(p-l)  .
     7110   put  stream macr_excel unformatted     substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     7111   put  stream macr_excel unformatted     substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     7112   put  stream macr_excel unformatted     'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     7113    end.
     7114   end procedure.
