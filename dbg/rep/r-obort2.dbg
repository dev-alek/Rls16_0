     6160               find first buf_temp-prt
     6161                 where buf_temp-prt.obj-type = p-obj-type   and buf_temp-prt.obj-code = p-obj-code
     6162                   and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6163                   and buf_temp-prt.sum-type = 1            and buf_temp-prt.doc-type = 'ee':U
     6164               no-error .
     6165               if available buf_temp-prt then assign sm1 = buf_temp-prt.sum .
     6166               find first buf_temp-prt
     6167                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6168                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6169                   and buf_temp-prt.sum-type = 1            and buf_temp-prt.doc-type = 'es':U
     6170               no-error .
     6171               if available buf_temp-prt then assign sm1 = sm1 + buf_temp-prt.sum .
     6172               find first buf_temp-prt
     6173                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6174                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6175                   and buf_temp-prt.sum-type = 1            and buf_temp-prt.doc-type = 're':U
     6176               no-error .
     6177               if available buf_temp-prt then assign sm1 = sm1 - buf_temp-prt.sum .
     6178               find first buf_temp-prt
     6179                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6180                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6181                   and buf_temp-prt.sum-type = 1            and buf_temp-prt.doc-type = 'rs':U
     6182               no-error .
     6183               if available buf_temp-prt then assign sm1 = sm1 - buf_temp-prt.sum .
     6184               if p-type = "eff-prc" then assign temp-sum.sum = (sm2 - sm1) * 100 / sm1 .
     6185               else                       assign temp-sum.sum = sm2 - sm1 .
     6186             end.
     6187           end.
     6188         end.
     6189       end.
     6190       if temp-sum.sum = ? then assign temp-sum.sum = 0 .
     6191     end.
     6192   end procedure.
     6193   procedure PrintScale :
     6194     do
     6195     on error undo, return error return-value
     6196     :
     6197       if line-counter( Outstream ) + 2 > page-size( Outstream ) then do:
     6198         put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     6199         page stream OutStream .
     6200         run rep/r-obrt21.p (input 2, input RADIO-AltObj, input end-sum, output ii, output ii) .
     6201       end.
     6202       if  ( v-row ) >= 63000 then do:
     6203         Output stream Macr_Excel  close .
     6204         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     6205         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     6206         output stream  Macr_Excel to value(v-file-name) .
     6207         v-ind = v-ind + 1 .
     6208         run rep/r-obrt21.p (input 1, input RADIO-AltObj, input end-sum, output start-col, output v-row) .
     6209       end.
     6210       define variable  null-ostat1  as logical initial yes no-undo .
