     2191   procedure prdoclib-create-temp-prt-obj :
     2192     define input parameter  p-root-price-sale like ub.price-list.price-sale no-undo .
     2193     define parameter buffer buf_prt-obj       for ub.prt-obj .
     2194     define parameter buffer buf_temp-prt-obj  for temp-prt-obj .
