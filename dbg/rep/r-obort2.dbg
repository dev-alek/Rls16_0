     1354       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
     1355       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
     1356       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
     1357       define variable varinvatp-envdo             as   character              no-undo.
     1358       define variable varinvatp-typeo             as   character              no-undo.
     1359       define variable v-gds-dtl-fact-qnty as decimal no-undo .
     1360       define buffer buf_gds-dtl  for ub.gds-dtl .
     1361       define buffer buf_goods    for ub.goods .
     1362       define buffer buf_trn-doc  for ub.trn-doc .
     1363       define buffer buf_doc-line for ub.doc-line .
     1364       find first buf_doc-line no-lock
     1365         where buf_doc-line.doc-code  = p-doc-code
     1366           and buf_doc-line.artic     = p-artic
     1367           and buf_doc-line.prod-type = p-prod-type
     1368           and buf_doc-line.prod-code = p-prod-code
     1369         no-error .
     1370       if not available buf_doc-line then do:
     1371         message
     1372           vss-workfile vss-revision vss-description skip
     1373           vss-include-info15 skip
     1374           "Ошибка задания входных параметров" skip
     1375           "Не найдена строка документа" skip
     1376           "Документ" p-doc-code skip
     1377           "Артикул" p-artic p-prod-type p-prod-code skip
     1378           view-as alert-box error .
     1379         undo, return error .
     1380       end.
     1381       find first buf_trn-doc no-lock
     1382         where buf_trn-doc.doc-code = buf_doc-line.doc-code
     1383         no-error .
     1384       if not available buf_trn-doc then do:
     1385         message
     1386           vss-workfile vss-revision vss-description skip
     1387           vss-include-info15 skip
     1388           "Не найден документ" skip
     1389           "Документ" p-doc-code skip
     1390           "Артикул" p-artic p-prod-type p-prod-code skip
     1391           view-as alert-box error .
     1392         undo, return error .
     1393       end.
     1394       for each buf_gds-dtl no-lock
     1395         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
     1396           and buf_gds-dtl.artic     = buf_doc-line.artic
     1397           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
     1398           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
     1399       on error undo, return error
     1400       :
     1401           if buf_trn-doc.doc-type <> 'инв':U
     1402           then do:
     1403               if buf_trn-doc.doc-type = 'при':U
     1404               or buf_trn-doc.doc-type = 'возврат':U
     1405               then do:
     1406                   assign
     1407                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
     1408                   .
     1409               end.
     1410               else do:
     1411                   assign
     1412                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
     1413                   .
     1414               end.
     1415           end.
     1416           else do:
     1417               assign
     1418                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
     1419               .
     1420           end.
     1421           if v-gds-dtl-fact-qnty <> 0
     1422           then do:
     1423   if buf_trn-doc.ext-doc-type = 'ot':U or
     1424      buf_trn-doc.ext-doc-type = ?                 then do:
     1425     assign
     1426      out-vatp-have-vat-slt = yes.
     1427   end.
     1428   else do:
     1429     find first out-vatp_doc-attr no-lock
     1430       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1431         and out-vatp_doc-attr.attr-code = 'envd':U
     1432         no-error .
     1433     if not available out-vatp_doc-attr then do:
     1434       assign
     1435         out-vatp-have-vat-slt = yes.
     1436     end.
     1437     else do:
     1438        out-vatp-have-vat-slt = no.
     1439     end.
     1440   end.
     1441   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
     1442                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
     1443                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
     1444   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1445   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     1446     (input  buf_doc-line.artic
     1447     ,input  buf_doc-line.prod-type
     1448     ,input  buf_doc-line.prod-code
     1449     ,output varroot-node
     1450     ) no-error .
     1451   if error-status :error then do:
     1452     message
     1453       vss-workfile vss-revision vss-description skip
     1454       "Ошибка при определении корневого признака товара" skip
     1455       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1456       error-status :get-message(1) skip
     1457       return-value skip
     1458       view-as alert-box error .
     1459     undo, return error .
     1460   end.
     1461   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     1462     (input  varroot-node
     1463     ,input  'empty-scale=request'
     1464     ,output varempty-scale
     1465     ) no-error .
     1466   if error-status :error then do:
     1467     message
     1468       vss-workfile vss-revision vss-description skip
     1469       "Ошибка при определении атрибута признака" skip
     1470       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
     1471       "Признак" varroot-node skip
     1472       "Запрашивался атрибут" "empty-scale=request" skip
     1473       error-status :get-message(1) skip
     1474       return-value skip
     1475       view-as alert-box error .
     1476     undo, return error .
     1477   end.
     1478   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1479   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1480     (output varoutvprb
     1481     )  .
     1482   if varoutvprb = "base":u then do:
     1483     assign
     1484           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1485       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1486     .
     1487   end.
     1488   else do:
     1489     assign
     1490           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1491       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1492     .
     1493   end.
     1494   if varoutvprb = "rubl":u then do:
     1495     assign
     1496           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1497       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1498   end.
     1499   else do:
     1500     assign
     1501           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1502       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1503   end.
     1504   assign
     1505     varis-cons-parts-have =  no.
     1506   assign
     1507     varfact-qnty       = 0
     1508     varcons-qnty       = 0
     1509     varprice-base-cons = 0
     1510     varprice-rubl-cons = 0.
     1511   find first out-vatp_doc-line where
     1512              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1513          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1514          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1515          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1516   if available out-vatp_doc-line           and
     1517     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1518     assign
     1519       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1520   end.
     1521   else do:
     1522     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1523                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1524                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1525                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1526                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1527                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1528       if out-vatp_parts.purch-code = 2 then do:
     1529   assign
     1530     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1531     price-base-with-tax-loco = out-vatp_parts.price-base
     1532   .
     1533   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1534   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1535     (output varinvprbo
     1536     )  .
     1537     if out-vatp_parts.out-code = 'free-zone':U     or
     1538        out-vatp_parts.out-code = 'out-zone':U   or
     1539        out-vatp_parts.doc-type = 'акт':U then do:
     1540       assign
     1541         in-vatp-have-vat-slto = yes.
     1542     end.
     1543     else do:
     1544       find first in-vatp_doc-attro no-lock
     1545         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1546           and in-vatp_doc-attro.attr-code = 'envd':U
     1547         no-error .
     1548       if not available in-vatp_doc-attro then do:
     1549         assign
     1550           in-vatp-have-vat-slto = yes.
     1551       end.
     1552       else do:
     1553            in-vatp-have-vat-slto = no.
     1554       end.
     1555     end.
     1556     assign
     1557      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1558      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1559     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1560              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1561     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1562             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1563             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1564             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1565             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1566             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1567             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1568       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1569     assign
     1570       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1571     assign
     1572       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1573       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1574       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1575       transport-cli-loco  = 0
     1576       other-cli-loco      = 0
     1577     .
     1578   ASSIGN
     1579             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1580       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1581   .
