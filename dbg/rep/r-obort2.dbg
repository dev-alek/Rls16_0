     6154               find first buf_temp-prt
     6155                 where buf_temp-prt.obj-type = p-obj-type   and buf_temp-prt.obj-code = p-obj-code
     6156                   and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6157                   and buf_temp-prt.sum-type = 5            and buf_temp-prt.doc-type = 'rs':U
     6158               no-error .
