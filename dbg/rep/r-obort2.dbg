     5567     if use-column[11] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 4, "eff-prc", -1, jj ) . assign jj = jj + 1 . end.
     5568     if RADIO-AltObj > 1     then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, "alt-ost", -1, jj ) . assign jj = jj + 1 . end.
     5569     if use-column[6] = yes or use-column[7] = yes  then do:
     5570       define variable smm1 as decimal initial 0 no-undo .
     5571       define variable smm2 as decimal initial 0 no-undo .
     5572       define variable tp  as integer   no-undo .
     5573       find first temp-prt
     5574         where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5575           and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5576           and temp-prt.sum-type = 2            and temp-prt.doc-type = 'ee':U
     5577       no-error .
     5578       if available temp-prt then assign smm2 = temp-prt.sum .
     5579       find first temp-prt
     5580         where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5581           and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5582           and temp-prt.sum-type = 2            and temp-prt.doc-type = 'es':U
     5583       no-error .
     5584       if available temp-prt then assign smm2 = smm2 + temp-prt.sum .
     5585       find first temp-prt
     5586         where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5587           and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5588           and temp-prt.sum-type = 2            and temp-prt.doc-type = 're':U
     5589       no-error .
     5590       if available temp-prt then assign smm2 = smm2 - temp-prt.sum .
     5591       find first temp-prt
     5592         where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5593           and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5594           and temp-prt.sum-type = 2            and temp-prt.doc-type = 'rs':U
     5595       no-error .
     5596       if available temp-prt then assign smm2 = smm2 - temp-prt.sum .
     5597       if use-column[6] = yes then do:
     5598         find first temp-prt
     5599           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5600             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5601             and temp-prt.sum-type = 0            and temp-prt.doc-type = 'ee':U
     5602         no-error .
     5603         if available temp-prt then assign smm1 = temp-prt.sum .
     5604         find first temp-prt
     5605           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5606             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5607             and temp-prt.sum-type = 0            and temp-prt.doc-type = 'es':U
     5608         no-error .
     5609         if available temp-prt then assign smm1 = smm1 + temp-prt.sum .
     5610         find first temp-prt
     5611           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5612             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5613             and temp-prt.sum-type = 0            and temp-prt.doc-type = 're':U
     5614         no-error .
     5615         if available temp-prt then assign smm1 = smm1 - temp-prt.sum .
     5616         find first temp-prt
     5617           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5618             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5619             and temp-prt.sum-type = 0            and temp-prt.doc-type = 'rs':U
     5620         no-error .
     5621         if available temp-prt then assign smm1 = smm1 - temp-prt.sum .
     5622         assign gds-prop.Avrg-Sale-Price = smm2 / smm1 .
     5623       end.
     5624       if use-column[7] = yes then do:
     5625         find first temp-prt
     5626           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5627             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5628             and temp-prt.sum-type = 1            and temp-prt.doc-type = 'ee':U
     5629         no-error .
     5630         if available temp-prt then assign smm1 = temp-prt.sum .
     5631         find first temp-prt
     5632           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5633             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5634             and temp-prt.sum-type = 1            and temp-prt.doc-type = 'es':U
     5635         no-error .
     5636         if available temp-prt then assign smm1 = smm1 + temp-prt.sum .
     5637         find first temp-prt
     5638           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5639             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5640             and temp-prt.sum-type = 1            and temp-prt.doc-type = 're':U
     5641         no-error .
     5642         if available temp-prt then assign smm1 = smm1 - temp-prt.sum .
     5643         find first temp-prt
     5644           where temp-prt.obj-type = gds-prop.obj-type   and temp-prt.obj-code = gds-prop.obj-code
     5645             and temp-prt.gds-code = gds-prop.gds-code   and temp-prt.prt-code = -1
     5646             and temp-prt.sum-type = 1            and temp-prt.doc-type = 'rs':U
     5647         no-error .
     5648         if available temp-prt then assign smm1 = smm1 - temp-prt.sum .
     5649         assign gds-prop.Up-Plan = (smm2 - smm1) * 100 / smm1 .
     5650       end.
     5651     end.
     5652     define variable  null-ostat  as logical initial yes no-undo .
     5653     define variable  null-oborot as logical initial yes no-undo .
     5654     assign NullStr = 0 .
     5655     for each temp-sum where temp-sum.level = -1 and ( temp-sum.doc-type = "ost-beg" or temp-sum.doc-type = "ost-end" ) :
     5656       if temp-sum.sum <> 0 then do:
     5657         assign null-ostat = no .
     5658         leave.
     5659       end.
     5660     end.
     5661     for each temp-sum  where temp-sum.level = -1 and temp-sum.doc-type <> "ost-beg"  and temp-sum.doc-type <> "ost-end" :
     5662       if temp-sum.sum <> 0 then do:
     5663         assign null-oborot = no .
     5664         leave.
     5665       end.
     5666     end.
     5667     if ShowZero = no and ShowZero-2 = no then do:
     5668       if null-oborot = yes then do:
     5669         if null-ostat = yes then NullStr = 2 .
     5670         else                     NullStr = 1 .
     5671       end.
     5672       else NullStr = 0 .
     5673     end.
     5674     if ShowZero = yes and ShowZero-2 = no then do:
     5675       if null-oborot = yes then do:
     5676         if null-ostat = yes then NullStr = 2 .
     5677         else                     NullStr = 1 .
     5678       end.
     5679       else do:
     5680         if null-ostat = yes then NullStr = 2 .
     5681         else                     NullStr = 0 .
     5682       end.
     5683     end.
     5684     if ShowZero = no and ShowZero-2 = yes then do:
     5685       if null-oborot = yes then do:
     5686         if null-ostat = yes then NullStr = 2 .
     5687         else                     NullStr = 0 .
     5688       end.
     5689       else NullStr = 0 .
     5690     end.
     5691     if NullStr = 0 and SumsOnly = no then do:
     5692       assign  is-prn-titul = yes  .
     5693       run PutTitul in this-procedure .
     5694       assign
     5695         v-col = 1
     5696         beg   = 1
     5697       .
     5698       if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then do:
     5699         if tog-obj = true then do:
     5700           put stream txt-file
     5701             gds-prop.obj-type format "X(5)"   CHR(9)
     5702             gds-prop.obj-code format ">>>>>>>9" CHR(9)
     5703             gds-prop.obj-name format "X(50)"   CHR(9)
     5704           .
     5705         end.
     5706         put stream txt-file
     5707           gds-prop.grp-name format "X(70)"  CHR(9)
     5708           gds-prop.prod-type format "X(5)"   CHR(9)
     5709           gds-prop.prod-code format ">>>>>>>>>>>9" CHR(9)
     5710           gds-prop.prod-name format "X(50)"  CHR(9)
     5711         .
     5712       end.
     5713       if use-column[1]  = yes then do:
     5714         put stream outstream  "|" at beg gds-prop.b-code format "X(13)" .
     5715         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.b-code format "X(13)" CHR(9).
     5716         run macr_excel_char (string(gds-prop.b-code), v-row, v-col) .
     5717         assign v-col = v-col + 1    beg = beg + 14 .
     5718       end.
     5719       if use-column[2]  = yes then do:
     5720         put stream outstream  "|" at beg gds-prop.artic format "X(16)" .
     5721         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.artic format "X(16)" CHR(9) .
     5722         run macr_excel_char (gds-prop.artic, v-row, v-col) .
     5723         assign v-col = v-col + 1    beg = beg + 17 .
     5724       end.
     5725       if use-column[3]  = yes then do:
     5726         put stream outstream  "|" at beg gds-prop.gds-name format "X(40)" .
     5727         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.gds-name format "X(40)" CHR(9) .
     5728         run macr_excel_char (gds-prop.gds-name, v-row, v-col) .
     5729         assign v-col = v-col + 1    beg = beg + 41 .
     5730       end.
     5731       if ExportZUM and (SumsOnly2 or gds-prop.empty-scale)  then put stream txt-file  CHR(9) .
     5732       if use-column[4]  = yes then do:
     5733         put stream outstream  "|" at beg gds-prop.unit-base format "X(4)" .
     5734         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.unit-base format "X(4)" CHR(9) .
     5735         run macr_excel_char (gds-prop.unit-base, v-row, v-col) .
     5736         assign v-col = v-col + 1    beg = beg + 5 .
     5737       end.
     5738       if use-column[5]  = yes then do:
     5739         put stream outstream  "|" at beg gds-prop.Cost-Price format ">>>,>>>,>>9.99" .
     5740         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file UNFORMATTED  replace(string(gds-prop.Cost-Price,frm-sum1),".",",")  CHR(9) .
     5741         run macr_excel_sum  ( gds-prop.Cost-Price, v-row, v-col, 2) .
     5742         assign v-col = v-col + 1    beg = beg + 15 .
     5743       end.
     5744       if use-column[6]  = yes then do:
     5745         if prod-zen = yes then do:
     5746           put stream outstream  "|" at beg gds-prop.Avrg-Sale-Price format ">>>,>>>,>>9.99" .
     5747           if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file UNFORMATTED  replace(string(gds-prop.Avrg-Sale-Price,frm-sum1),".",",")  CHR(9) .
     5748           run macr_excel_sum  ( gds-prop.Avrg-Sale-Price, v-row, v-col, 2) .
     5749         end.
     5750         else do:
     5751           put stream outstream  "|" at beg gds-prop.Last-Sale-Price format ">>>,>>>,>>9.99" .
     5752           if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file UNFORMATTED  replace(string(gds-prop.Last-Sale-Price,frm-sum1),".",",")  CHR(9) .
     5753           run macr_excel_sum  ( gds-prop.Last-Sale-Price, v-row, v-col, 2) .
     5754         end.
     5755         assign v-col = v-col + 1    beg = beg + 15 .
     5756       end.
     5757       if use-column[7]  = yes then do:
     5758         put stream outstream  "|" at beg gds-prop.Up-Plan format "->>,>>>,>>9.99" .
     5759         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  UNFORMATTED  replace(string(gds-prop.Up-Plan,frm-sum1),".",",")   CHR(9) .
     5760         run macr_excel_sum  ( gds-prop.Up-Plan, v-row, v-col, 2) .
     5761         assign v-col = v-col + 1    beg = beg + 15 .
     5762       end.
     5763       if use-column[8]  = yes then do:
     5764         if gds-prop.LastPer-Date <> ? then do:
     5765           put stream outstream  "|" at beg gds-prop.LastPer-Date format "99/99/9999" .
     5766           if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.LastPer-Date format "99/99/9999" CHR(9) .
     5767           run macr_excel_char (string(gds-prop.LastPer-Date,"99.99.9999"), v-row, v-col) .
     5768         end.
     5769         assign v-col = v-col + 1    beg = beg + 11 .
     5770       end.
     5771       if use-column[9]  = yes then do:
     5772         put stream outstream  "|" at beg gds-prop.LastPer-Num format "X(10)" .
     5773         if ExportZUM and (SumsOnly2 or gds-prop.empty-scale) then put stream txt-file  gds-prop.LastPer-Num format "X(10)" CHR(9) .
     5774         run macr_excel_char (gds-prop.LastPer-Num, v-row, v-col) .
     5775         assign v-col = v-col + 1    beg = beg + 11 .
     5776       end.
     5777       if SumsOnly2 or gds-prop.empty-scale then do:
     5778         for each temp-sum where temp-sum.level = -1 :
     5779           case temp-sum.sum-type :
     5780             when 0 then do:
     5781               put stream outstream  "|" at beg temp-sum.sum format frm-qnty  .
     5782               if ExportZUM then put stream txt-file UNFORMATTED  replace(string(temp-sum.sum,frm-qnty1),".",",")  CHR(9) .
     5783               run macr_excel_sum (temp-sum.sum, v-row, v-col, sz-qnty) .
     5784               assign  beg = beg + 15 .
     5785             end.
     5786             when 1 or when 2 or when 3 then do:
     5787               put stream outstream  "|" at beg temp-sum.sum format frm-sum .
     5788               if ExportZUM then put stream txt-file UNFORMATTED  replace(string(temp-sum.sum,frm-sum1),".",",")  CHR(9) .
     5789               run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     5790               assign  beg = beg + 15 .
     5791             end.
     5792             when 4 then do:
     5793               put stream outstream  "|" at beg temp-sum.sum format frm-prc .
     5794               if ExportZUM then put stream txt-file  UNFORMATTED  replace(string(temp-sum.sum,frm-sum1),".",",")  CHR(9) .
     5795               run macr_excel_sum (temp-sum.sum, v-row, v-col, 2) .
     5796               assign  beg = beg + 10 .
     5797             end.
     5798           end.
     5799           assign v-col = v-col + 1 .
     5800         end.
     5801       end.
     5802       else do:
     5803         for each temp-sum where temp-sum.level = -1 :
     5804           case temp-sum.sum-type :
     5805             when 0 or when 1 or when 2 or when 3 then do:
     5806               put stream outstream  "|" at beg  .     assign  beg = beg + 15 .
     5807             end.
     5808             when 4 then do:
     5809               put stream outstream  "|" at beg  .     assign  beg = beg + 10 .
     5810             end.
     5811           end.
     5812           assign v-col = v-col + 1 .
     5813         end.
     5814       end.
     5815       put stream outstream   "|"  skip .
     5816       if ExportZUM then put stream txt-file  chr(10) .
     5817       assign v-row = v-row + 1 .
     5818       if name-tov = 3 and use-column[3]  = yes then do:
     5819         assign   v-col = 1     beg   = 1 .
     5820         put stream outstream  "|"  .
     5821         if use-column[1]  = yes then  assign v-col = v-col + 1    beg = beg + 14 .
     5822         if use-column[2]  = yes then  assign v-col = v-col + 1    beg = beg + 17 .
     5823         put stream outstream  "|" at beg gds-prop.gds-name1 format "X(40)"  "|"   "|" at end-sum skip .
     5824         run macr_excel_char (gds-prop.gds-name1, v-row, v-col) .
     5825         assign v-row = v-row + 1 .
     5826       end.
     5827     end.
     5828     if NullStr < 2 then do:
     5829       if tog-obj = true then run CalculSum in this-procedure (2) .
     5830       run CalculSum in this-procedure (1) .
     5831     end.
     5832     if gds-prop.empty-scale = no and NullStr = 0 and SumsOnly = no then do:
     5833       run PrintScale .
     5834     end.
     5835   end procedure.
     5836   procedure PutItogSum :
     5837     define input  parameter p-num as integer   no-undo .
     5838     define buffer buf_temp-sum for temp-sum .
     5839     if p-num = 2 then do:
     5840       assign ItogStr = "Итого по объекту " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ") :" .
     5841     end.
     5842     else do:
     5843       if p-num = 1 then assign  ItogStr = "ИТОГО: " .
     5844       else do:
     5845         for each  buf_temp-sum where buf_temp-sum.level = p-num :
     5846           if buf_temp-sum.sum <> 0 then assign is-prn-titul = yes .
     5847         end.
     5848         run PutTitul in this-procedure .
     5849       end.
     5850     end.
     5851     if p-num < 2 or ( p-num < 4 and var-client = "" ) or var-client1 = "" then do:
     5852       assign v-col = 1 .
     5853       if line-counter( Outstream ) + 5 > page-size( Outstream ) then do:
     5854         put stream outstream  skip Line format frmt skip "продолжение - на следующей странице" AT 30 SKIP .
     5855         page stream OutStream .
     5856         run rep/r-obrt21.p (input 2, input RADIO-AltObj, input end-sum, output ii, output ii   ) .
     5857       end.
     5858       run macr_excel_char (ItogStr, v-row, v-col) .
     5859       put stream outstream "| " ItogStr format "X(60)" .
     5860       assign
     5861         beg = start-sum
     5862         v-col = start-col
     5863       .
     5864       for each  buf_temp-sum where buf_temp-sum.level = p-num :
     5865         case buf_temp-sum.sum-type :
     5866           when 0 then do:
     5867             put stream outstream  "|" at beg buf_temp-sum.sum format frm-qnty  .
     5868             run macr_excel_sum (buf_temp-sum.sum, v-row, v-col, sz-qnty) .
     5869             assign  beg = beg + 15 .
     5870           end.
     5871           when 1 or when 2 or when 3 then do:
     5872             put stream outstream  "|" at beg buf_temp-sum.sum format frm-sum .
     5873             run macr_excel_sum (buf_temp-sum.sum, v-row, v-col, 2) .
     5874             assign  beg = beg + 15 .
     5875           end.
     5876           when 4 then do:
     5877             put stream outstream  "|" at beg .
     5878             assign  beg = beg + 10 .
     5879           end.
     5880         end.
     5881         assign v-col = v-col + 1 .
     5882       end.
     5883       put stream outstream   "|"  skip Line format frmt skip.
     5884       assign v-row = v-row + 1 .
     5885     end.
     5886   end procedure.
     5887   procedure PutTitul :
     5888     if titul = 0 and tog-obj = true  then do:
     5889       define variable line1 as character no-undo .
     5890       assign
     5891         line1 = ""
     5892         titul = 1
     5893       .
     5894       assign  line1 = "По объекту: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code) + ")" .
     5895       run macr_excel_char (line1, v-row, 1) .
     5896       assign v-row = v-row + 1 .
     5897       put stream outstream   Line format frmt skip .
     5898       PUT stream OutStream "| " line1 format "X(60)" "|" at beg  SKIP .
     5899     end.
     5900     if SumsOnly = no and is-prn-titul then do:
     5901       assign is-prn-titul = no .
     5902       if var-client <> "" then do:
     5903         run macr_excel_char (var-client, v-row, 1) .
     5904         assign v-row = v-row + 1 .
     5905         PUT stream OutStream "| " var-client format "X(60)" "|" at beg  SKIP .
     5906         assign  var-client = "" .
     5907       end.
     5908       if var-client1 <> "" then do:
     5909         run macr_excel_char (var-client1, v-row, 1) .
     5910         assign v-row = v-row + 1 .
     5911         PUT stream OutStream "| " var-client1 format "X(60)" "|" at beg  SKIP .
     5912         assign  var-client1 = "" .
     5913       end.
     5914     end.
     5915   end procedure.
     5916   procedure Add-temp-prt :
     5917     define input  parameter p-obj-code as integer   no-undo .
     5918     define input  parameter p-obj-type as character no-undo .
     5919     define input  parameter p-gds-code as integer   no-undo .
     5920     define input  parameter p-num      as integer   no-undo .
     5921     define input  parameter p-type     as character no-undo .
     5922     define input  parameter p-prt-code as integer   no-undo .
     5923     define input  parameter p-b-code   as integer   no-undo .
     5924     define input  parameter p-val      as decimal   no-undo .
     5925     do on error undo, return error return-value :
     5926       find first temp-prt
     5927         where temp-prt.obj-type = p-obj-type
     5928           and temp-prt.obj-code = p-obj-code
     5929           and temp-prt.gds-code = p-gds-code
     5930           and temp-prt.prt-code = p-prt-code
     5931           and temp-prt.sum-type = p-num
     5932           and temp-prt.doc-type = p-type
     5933       no-error .
     5934       if not available temp-prt then do:
     5935         create temp-prt .
     5936         ASSIGN
     5937           temp-prt.obj-type = p-obj-type
     5938           temp-prt.obj-code = p-obj-code
     5939           temp-prt.gds-code = p-gds-code
     5940           temp-prt.prt-code = p-prt-code
     5941           temp-prt.b-code   = p-b-code
     5942           temp-prt.doc-type = p-type
     5943           temp-prt.sum-type = p-num
     5944         .
     5945       end.
     5946       assign temp-prt.sum = temp-prt.sum + p-val .
     5947     end.
     5948   end procedure.
     5949   procedure Add-temp-sum :
     5950     define input  parameter p-obj-code as integer   no-undo .
     5951     define input  parameter p-obj-type as character no-undo .
     5952     define input  parameter p-gds-code as integer   no-undo .
     5953     define input  parameter p-num      as integer   no-undo .
     5954     define input  parameter p-type     as character no-undo .
     5955     define input  parameter p-prt-code as integer   no-undo .
     5956     define input  parameter p-count    as integer   no-undo .
     5957     define buffer buf_temp-prt for temp-prt .
     5958     define variable lvl as integer  no-undo .
     5959     if p-prt-code <> -1 then  assign lvl = - 2 .
     5960     else                      assign lvl = - 1 .
     5961     do on error undo, return error return-value :
     5962       find first temp-sum
     5963         where temp-sum.level    = lvl
     5964           and temp-sum.num      = p-count
     5965           and temp-sum.doc-type = p-type
     5966           and temp-sum.sum-type = p-num
     5967       no-error  .
     5968       if not available temp-sum then do:
     5969         create temp-sum .
     5970         assign
     5971           temp-sum.doc-type = p-type
     5972           temp-sum.num      = p-count
     5973           temp-sum.level    = lvl
     5974           temp-sum.sum-type = p-num
     5975           temp-sum.sum      = 0
     5976         .
     5977       end.
     5978       if     p-type <> "rs-vz"     and p-type <> "rs-vz-k" and p-type <> "rs-all"  and p-type <> "vz-all"
     5979          and p-type <> "rs-vz-all" and p-type <> "eff-val" and p-type <> "eff-prc" then do:
     5980         find first buf_temp-prt
     5981           where buf_temp-prt.obj-type = p-obj-type          and buf_temp-prt.obj-code = p-obj-code
     5982             and buf_temp-prt.gds-code = p-gds-code          and buf_temp-prt.prt-code = p-prt-code
     5983             and buf_temp-prt.sum-type = p-num               and buf_temp-prt.doc-type = p-type
     5984         no-error .
     5985         if available buf_temp-prt then assign temp-sum.sum  = buf_temp-prt.sum  .
     5986       end.
     5987       else do:
     5988         if p-num = 4 and p-type <> "eff-prc" then do:
     5989           define buffer buf1_temp-sum for temp-sum .
     5990           find first buf1_temp-sum where buf1_temp-sum.level = lvl and buf1_temp-sum.sum-type = 3 and buf1_temp-sum.doc-type = p-type no-error .
     5991           if available buf1_temp-sum then assign temp-sum.sum  = buf1_temp-sum.sum * 100 .
     5992           find first buf1_temp-sum where buf1_temp-sum.level = lvl and buf1_temp-sum.sum-type = 4 and buf1_temp-sum.doc-type = p-type no-error .
     5993           if available buf1_temp-sum then assign temp-sum.sum  = temp-sum.sum / buf1_temp-sum.sum .
     5994         end.
     5995         else do:
     5996           case p-type :
     5997             when "rs-vz" then do:
     5998               find first buf_temp-prt
     5999                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6000                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6001                   and buf_temp-prt.sum-type = p-num            and buf_temp-prt.doc-type = 'ee':U
     6002               no-error .
     6003               if available buf_temp-prt then assign temp-sum.sum = buf_temp-prt.sum .
     6004               find first buf_temp-prt
     6005                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6006                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6007                   and buf_temp-prt.sum-type = p-num            and buf_temp-prt.doc-type = 're':U
     6008               no-error .
     6009               if available buf_temp-prt then assign temp-sum.sum = temp-sum.sum - buf_temp-prt.sum .
     6010               if p-num = 2 then do:
     6011                 find first buf_temp-prt
     6012                   where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6013                     and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6014                     and buf_temp-prt.sum-type = 3            and buf_temp-prt.doc-type = 'ee':U
     6015                 no-error .
     6016                 if available buf_temp-prt then assign temp-sum.sum = temp-sum.sum - buf_temp-prt.sum .
     6017                 find first buf_temp-prt
     6018                   where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6019                     and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6020                     and buf_temp-prt.sum-type = 3            and buf_temp-prt.doc-type = 're':U
     6021                 no-error .
     6022                 if available buf_temp-prt then assign temp-sum.sum = temp-sum.sum + buf_temp-prt.sum .
     6023               end.
     6024             end.
     6025             when "rs-vz-k" then do:
     6026               find first buf_temp-prt
     6027                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6028                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6029                   and buf_temp-prt.sum-type = p-num            and buf_temp-prt.doc-type = 'es':U
     6030               no-error .
     6031               if available buf_temp-prt then assign temp-sum.sum = buf_temp-prt.sum .
     6032               find first buf_temp-prt
     6033                 where buf_temp-prt.obj-type = p-obj-type       and buf_temp-prt.obj-code = p-obj-code
     6034                   and buf_temp-prt.gds-code = p-gds-code       and buf_temp-prt.prt-code = p-prt-code
     6035                   and buf_temp-prt.sum-type = p-num            and buf_temp-prt.doc-type = 'rs':U
     6036               no-error .
     6037               if available buf_temp-prt then assign temp-sum.sum = temp-sum.sum - buf_temp-prt.sum .
     6038               if p-num = 2 then do:
     6039                 find first buf_temp-prt
     6040                   where buf_temp-prt.obj-type = p-obj-type   and buf_temp-prt.obj-code = p-obj-code
     6041                     and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6042                     and buf_temp-prt.sum-type = 3            and buf_temp-prt.doc-type = 'es':U
     6043                 no-error .
     6044                 if available buf_temp-prt then assign temp-sum.sum = temp-sum.sum - buf_temp-prt.sum .
     6045                 find first buf_temp-prt
     6046                   where buf_temp-prt.obj-type = p-obj-type   and buf_temp-prt.obj-code = p-obj-code
     6047                     and buf_temp-prt.gds-code = p-gds-code   and buf_temp-prt.prt-code = p-prt-code
     6048                     and buf_temp-prt.sum-type = 3            and buf_temp-prt.doc-type = 'rs':U
     6049                 no-error .
