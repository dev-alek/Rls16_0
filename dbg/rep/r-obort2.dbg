     1310       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1311       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1312       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1313       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
     1314       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
     1315       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
     1316       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
     1317       define variable varis-one-gds-dtl        as   logical                             no-undo.
     1318       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
