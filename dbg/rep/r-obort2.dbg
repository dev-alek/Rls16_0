     1094               v-parts-fact-qnty           = (if buf_trn-doc.doc-type = 'при':U
     1095                                         or buf_trn-doc.doc-type = 'возврат':U
     1096                                         or buf_trn-doc.doc-type = 'инв':U
     1097                                         then buf_doc-line.fact-qnty
     1098                                         else - buf_doc-line.fact-qnty
     1099                                       )
     1100             .
     1101   assign
     1102     price-rubl-with-tax-loc = buf_doc-line.price-rubl
     1103     price-base-with-tax-loc = buf_doc-line.price-base
     1104   .
     1105   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1106   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1107     (output varinvprb
     1108     )  .
     1109      find first in-vatp_doc-attr no-lock
     1110       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     1111         and in-vatp_doc-attr.attr-code = 'envd':U
     1112       no-error .
     1113       if available in-vatp_doc-attr
     1114          then do:
     1115          assign
     1116            in-vatp-have-vat-slt = no.
     1117      end.
     1118      else do:
     1119        assign
     1120          in-vatp-have-vat-slt = yes.
     1121      end.
     1122      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
     1123                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
     1124                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
     1125      if (not buf_trn-doc.internal and
     1126              buf_trn-doc.doc-type = 'при':U) or
     1127         in-vatp-goods.gds-type = 'у':U then do:
     1128         if varinvprb = "base":u then do:
     1129           assign
     1130             road-tax-base-loc = buf_doc-line.road-tax
     1131             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
     1132         end.
     1133         else do:
     1134           ASSIGN
     1135             road-tax-rubl-loc = buf_doc-line.road-tax
     1136             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
     1137         end.
     1138         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     1139         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     1140         assign
     1141           road-tax-cli-loc = ?.
     1142         ASSIGN
     1143           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
     1144           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
     1145           transport-cli-loc  = 0
     1146           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
     1147           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
     1148           other-cli-loc      = 0
     1149           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
     1150           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
     1151                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1152               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     1153         assign
     1154           vat-cli-loc            = ?
     1155           slt-cli-loc            = ?
     1156           price-cli-with-tax-loc = ?.
     1157      end.
     1158      else do:
     1159                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
     1160                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
     1161                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
     1162                                         in-vatp-parts.artic     = buf_doc-line.artic     and
     1163                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
     1164                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
     1165                            use-index out-code no-lock:
     1166             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     1167                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     1168                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     1169                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     1170                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     1171                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     1172                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1173                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1174                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1175                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1176                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     1177                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     1178                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
     1179                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
     1180                         .
     1181         end.
     1182         ASSIGN
     1183           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1184           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1185           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1186           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1187           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1188           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
     1189                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1190           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1191                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
     1192           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
     1193           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
     1194           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
     1195         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
     1196         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
     1197         if transport-base-loc = ? then transport-base-loc = 0.
     1198         if transport-rubl-loc = ? then transport-rubl-loc = 0.
     1199         if other-base-loc     = ? then other-base-loc     = 0.
     1200         if other-rubl-loc     = ? then other-rubl-loc     = 0.
     1201         assign
     1202           transport-cli-loc      = 0
     1203           other-cli-loc          = 0
     1204           road-tax-cli-loc       = ?
     1205           vat-cli-loc            = ?
     1206           slt-cli-loc            = ?
     1207           price-cli-with-tax-loc = ?.
     1208      end.
     1209   ASSIGN
     1210             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
     1211       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
     1212   .
     1213             assign
     1214               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
     1215               v-vat-pc              = vat-pc-loc
     1216               v-slt-pc              = slt-pc-loc
     1217               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
     1218               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
     1219               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
     1220               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
     1221               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
     1222               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
     1223               v-road-tax-base       =  0
     1224               v-road-tax-rubl       =  0
     1225               v-excise-base         =  0
     1226               v-excise-rubl         =  0
     1227               v-transport-base      =  0
     1228               v-transport-rubl      =  0
     1229               v-other-base          =  0
     1230               v-other-rubl          =  0
     1231             .
     1232       end.
     1233     end.
     1234   end procedure.
     1235   define variable vss-include-info14 as character format "X(65)" no-undo
     1236   initial "@(#)$Workfile$ $Revision$".
     1237   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   procedure r-sale :
     1239     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
     1240     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
     1241     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
     1242     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
     1243     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
     1244     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
     1245     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
     1246     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
     1247     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
     1248     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
     1249     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
     1250     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
     1251     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
     1252     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
     1253     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
     1254     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
     1255     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
     1256     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
     1257     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
     1258     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
     1259     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
     1260     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
     1261     do
     1262     on error undo, return error
     1263     :
     1264       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
     1265       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
     1266       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
     1267       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
     1268       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
     1269       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1270       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
     1271       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
     1272       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
     1273       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
     1274       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
     1275       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
     1276       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
     1277       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
     1278       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
