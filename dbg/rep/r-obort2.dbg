     1337       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
     1338       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
     1339       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
     1340       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
     1341       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
     1342       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1343       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
     1344       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
     1345       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
     1346       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
     1347       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
     1348       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
     1349       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
