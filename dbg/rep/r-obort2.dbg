     6300           if use-column[13] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 0, "ost-end",                   temp-prt.prt-code, jj ) . assign jj = jj + 1 . end.
     6301           if use-column[32] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 1, "ost-end",                   temp-prt.prt-code, jj ) . assign jj = jj + 1 . end.
     6302           if use-column[51] = yes then do:  run Add-temp-sum ( gds-prop.obj-code, gds-prop.obj-type,  gds-prop.gds-code, 2, "ost-end",                   temp-prt.prt-code, jj ) . assign jj = jj + 1 . end.
     6303           assign
     6304             null-ostat1  = yes
     6305             null-oborot1 = yes
     6306             NullStr1     = 0
     6307           .
     6308           for each temp-sum where temp-sum.level = -2 and ( temp-sum.doc-type = "ost-beg" or temp-sum.doc-type = "ost-end" ) :
     6309             if temp-sum.sum <> 0 then do:
     6310               assign null-ostat1 = no .
     6311               leave.
     6312             end.
     6313           end.
     6314           for each temp-sum  where temp-sum.level = -2 and temp-sum.doc-type <> "ost-beg"  and temp-sum.doc-type <> "ost-end" :
     6315             if temp-sum.sum <> 0 then do:
     6316               assign null-oborot1 = no .
     6317               leave.
     6318             end.
     6319           end.
     6320           if ShowZero = no and ShowZero-2 = no then do:
     6321             if null-oborot1 = yes then do:
     6322               if null-ostat1 = yes then NullStr1 = 2 .
     6323               else                      NullStr1 = 1 .
     6324             end.
     6325             else NullStr1 = 0 .
     6326           end.
     6327           if ShowZero = yes and ShowZero-2 = no then do:
     6328             if null-oborot1 = yes then do:
     6329               if null-ostat1 = yes then NullStr1 = 2 .
     6330               else                      NullStr1 = 1 .
     6331             end.
     6332             else do:
     6333               if null-ostat1 = yes then NullStr1 = 2 .
     6334               else                      NullStr1 = 0 .
     6335             end.
     6336           end.
     6337           if ShowZero = no and ShowZero-2 = yes then do:
     6338             if null-oborot1 = yes then do:
     6339               if null-ostat1 = yes then NullStr1 = 2 .
     6340               else                      NullStr1 = 0 .
     6341             end.
     6342             else NullStr1 = 0 .
     6343           end.
     6344           if NullStr1 > 0 then next .
     6345           assign
     6346             v-col = 1
     6347             beg   = 1
     6348           .
     6349           if ExportZUM then do:
     6350             if tog-obj = true then do:
     6351               put stream txt-file
     6352                 gds-prop.obj-type format "X(5)"   CHR(9)
     6353                 gds-prop.obj-code format ">>>>>>>9" CHR(9)
     6354                 gds-prop.obj-name format "X(50)"   CHR(9)
     6355               .
     6356             end.
     6357             put stream txt-file
     6358               gds-prop.grp-name format "X(70)"  CHR(9)
     6359               gds-prop.prod-type format "X(5)"   CHR(9)
     6360               gds-prop.prod-code format ">>>>>>>>>>>9" CHR(9)
     6361               gds-prop.prod-name format "X(50)"  CHR(9)
     6362             .
     6363           end.
     6364           if use-column[1]  = yes then do:
     6365             put stream outstream  "|" at beg temp-prt.b-code format ">>>>>>>>>>>>9" .
     6366             if ExportZUM then put stream txt-file  temp-prt.b-code format ">>>>>>>>>>>>9" CHR(9) .
     6367             run macr_excel_char (string(temp-prt.b-code), v-row, v-col) .
     6368             assign v-col = v-col + 1    beg = beg + 14 .
     6369           end.
     6370           if use-column[2]  = yes then do:
     6371              if ExportZUM then put stream txt-file gds-prop.artic format "X(16)" CHR(9) .
     6372              assign v-col = v-col + 1    beg = beg + 17 .
     6373           end.
     6374           FIND FIRST gds-prt WHERE gds-prt.node-code  = temp-prt.prt-code NO-LOCK no-error .
     6375           if use-column[3]  = yes then do:
     6376             put stream outstream  "|" at beg '  /'+ gds-prt.f-name format "X(40)" .
     6377             run macr_excel_char ('  /'+ gds-prt.f-name, v-row, v-col) .
     6378             if ExportZUM then put stream txt-file  gds-prop.gds-name format "X(40)" CHR(9) .
     6379             assign v-col = v-col + 1    beg = beg + 41 .
     6380           end.
     6381           if ExportZUM then put stream txt-file  ' /'+ gds-prt.f-name format "X(60)" CHR(9) .
     6382           if use-column[4]  = yes then do:
     6383             put stream outstream  "|" at beg gds-prop.unit-base format "X(4)" .
     6384             if ExportZUM then put stream txt-file  gds-prop.unit-base format "X(4)" CHR(9) .
     6385             run macr_excel_char (gds-prop.unit-base, v-row, v-col) .
     6386             assign v-col = v-col + 1    beg = beg + 5 .
     6387           end.
     6388           if use-column[5]  = yes then do:
     6389             if ExportZUM then put stream txt-file UNFORMATTED  replace(string(gds-prop.Cost-Price,frm-sum1),".",",")  CHR(9) .
     6390             assign v-col = v-col + 1    beg = beg + 15 .
     6391           end.
     6392           if use-column[6]  = yes then do:
     6393             if prod-zen = yes then do:
     6394               if ExportZUM then put stream txt-file UNFORMATTED  replace(string(gds-prop.Avrg-Sale-Price,frm-sum1),".",",")  CHR(9) .
     6395             end.
     6396             else do:
     6397               if ExportZUM then put stream txt-file UNFORMATTED  replace(string(gds-prop.Last-Sale-Price,frm-sum1),".",",")  CHR(9) .
     6398             end.
