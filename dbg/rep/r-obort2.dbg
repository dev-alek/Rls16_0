     3843          and out-vatp_doc-lineprl.artic      = varartic
     3844          and out-vatp_doc-lineprl.prod-type  = varprod-type
     3845          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     3846   if available out-vatp_doc-lineprl           and
