       80   procedure create_obj-list :
       81      define input parameter p-obj-type like ub.clients.obj-type no-undo .
       82      define input parameter p-obj-code like ub.clients.obj-code no-undo .
       83      do
       84      on error undo, return error return-value
       85      :
       86         define buffer cli-obj for ub.clients .
       87         define variable p-var as integer no-undo .
       88         define buffer buf_obj-list for obj-list .
       89         find last buf_obj-list  use-index pi no-error .
       90         if available buf_obj-list
       91         then
       92            p-var = buf_obj-list.obj-id + 1.
       93         else
       94            p-var = 1.
       95         find first cli-obj where
       96                   cli-obj.obj-type = p-obj-type
       97               and cli-obj.obj-code = p-obj-code
       98         no-lock no-error.
       99         if available cli-obj
      100         then do:
      101            create buf_obj-list.
      102            assign
      103               buf_obj-list.obj-id   = p-var
      104               buf_obj-list.obj-code = cli-obj.obj-code
      105               buf_obj-list.obj-type = cli-obj.obj-type
      106               buf_obj-list.obj-name = cli-obj.obj-name
      107               buf_obj-list.db-num   = cli-obj.db-num
      108            .
      109         end.
      110      end.
      111   end.
