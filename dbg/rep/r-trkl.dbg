        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter p-trn-doc-recid      as recid            no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: r-trkl.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/r-trkl.p $":U .
        9   define variable vss-description as character no-undo init "Требование в кладовую.".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       71   procedure cur-time :
       72      define output parameter p-today as date      no-undo .
       73      define output parameter p-time  as integer   no-undo .
       74     do
       75     on error undo, return error
       76     :
       77       define variable v-date1 as date      no-undo .
       78       define variable v-date2 as date      no-undo .
       79       define variable v-time  as integer   no-undo .
       80       assign
       81         v-date1 = today
       82         v-time  = time
       83         v-date2 = today
       84       .
       85       if v-date1 <> v-date2
       86       then do:
       87         assign
       88           v-date1 = today
       89           v-time  = v-time
       90         .
       91       end.
       92       assign
       93         p-today = v-date1
       94         p-time  = v-time
       95       .
       96     end.
       97   end.
       98   function cur-time-date returns character
       99   :
      100     return string(today, '99/99/9999':U) .
      101   end.
      102   function cur-time-mjd returns decimal
      103   :
      104     define variable v-date as date      no-undo .
      105     define variable v-time as integer   no-undo .
      106     run cur-time in this-procedure
      107       (output v-date
      108       ,output v-time
      109       ) .
      110     return integer(v-date) - 2400002 + (v-time / 86400) .
      111   end.
      112   function cur-time-get-ending-index returns integer
      113   (input p-number as integer
      114   )
      115   :
      116     if p-number < 0
      117     or p-number = ?
      118     then do:
      119       return 1 .
      120     end.
      121     define variable v-rest as integer   no-undo .
      122     assign
      123       p-number = p-number modulo 100
      124     .
      125     if p-number < 20
      126     then do:
      127       assign
      128         v-rest = p-number
      129       .
      130     end.
      131     else do:
      132       assign
      133         v-rest = p-number modulo 10
      134       .
      135     end.
      136     case v-rest :
      137       when 1
      138       then do:
      139         return 2 .
      140       end.
      141       when 2 or
      142       when 3 or
      143       when 4
      144       then do:
      145         return 3 .
      146       end.
      147       otherwise do:
      148         return 1 .
      149       end.
      150     end case .
      151   end.
      152   procedure cur-time-mjd-to-date :
      153      define input  parameter i-mjd-diff as decimal no-undo.
      154      define output parameter o-Date     as date    no-undo.
      155      define output parameter o-Time     as integer no-undo.
      156      define variable v-day-number as integer   no-undo .
      157      if    i-mjd-diff < 0
      158         or i-mjd-diff = ?
      159      then do:
      160         return "?" .
      161      end.
      162      assign
      163         v-day-number = truncate(i-mjd-diff,0).
      164         o-Date = date(v-day-number + 2400002).
      165         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      166     .
      167   end.
      168   function cur-time-mjd-to-string returns character
      169   (input p-mjd-diff as decimal
      170   )
      171   :
      172     define variable v-day-number as integer   no-undo .
      173     define variable v-seconds    as integer   no-undo .
      174     define variable v-hour       as integer   no-undo .
      175     define variable v-min        as integer   no-undo .
      176     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      177     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      178     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      179     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      180     if p-mjd-diff < 0
      181     or p-mjd-diff = ?
      182     then do:
      183       return "?" .
      184     end.
      185     assign
      186       v-day-number = integer(truncate(p-mjd-diff,0))
      187       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      188     .
      189     if v-seconds > 86400
      190     then do:
      191       assign
      192         v-seconds = 86400 - 1
      193       .
      194     end.
      195     if v-seconds < 0
      196     then do:
      197       assign
      198         v-seconds = 0
      199       .
      200     end.
      201     assign
      202       v-hour = truncate(v-seconds / 3600, 0)
      203     .
      204     assign
      205       v-seconds = v-seconds modulo 3600
      206     .
      207     assign
      208       v-min = truncate(v-seconds / 60, 0)
      209     .
      210     assign
      211       v-seconds = v-seconds modulo 60
      212     .
      213     return
      214         (if v-day-number <> 0
      215           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      216           else ""
      217         )
      218       + (if v-day-number <> 0 or v-hour <> 0
      219           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      220           else ""
      221         )
      222       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      223           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      224           else ""
      225         )
      226       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      227       .
      228   end.
      229   function cur-time-string returns character
      230   :
      231     define variable v-date as date      no-undo .
      232     define variable v-time as integer   no-undo .
      233     run cur-time in this-procedure
      234       (output v-date
      235       ,output v-time
      236       ) .
      237     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      238   end.
      239   function cur-time-string-sec returns character
      240   :
      241     define variable v-date as date      no-undo .
      242     define variable v-time as integer   no-undo .
      243     run cur-time in this-procedure
      244       (output v-date
      245       ,output v-time
      246       ) .
      247     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      248   end.
      249   function cur-time-custom  returns character
      250   (input p-prefix as character
      251   ,input p-date-format as character
      252   ,input p-delimiter as character
      253   ,input p-time-format as character
      254   ,input p-suffix as character
      255   )
      256   :
      257     define variable v-date as date      no-undo .
      258     define variable v-time as integer   no-undo .
      259     run cur-time in this-procedure
      260       (output v-date
      261       ,output v-time
      262       ) .
      263     return
      264       p-prefix
      265       + string(v-date, p-date-format)
      266       + p-delimiter
      267       + string(v-time, p-time-format)
      268       + p-suffix
      269       .
      270   end.
      271   function cur-time-print  returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-datetime returns datetime
      282   :
      283     define variable v-char as character no-undo .
      284     define variable v-datetime as datetime no-undo .
      285     v-char = cur-time-string().
      286     v-datetime = datetime(v-char).
      287     return  v-datetime.
      288   end.
      289   function cur-time-string-msec returns character
      290   :
      291     define variable v-date as datetime  no-undo .
      292     v-date = now.
      293     return string(v-date) .
      294   end.
      295   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      296   define new shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      297   define new shared variable RepPathName        as character no-undo .
      298   define new shared variable PrintRubl          as logical   no-undo .
      299   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      300   define  stream PrnLibStream.
      301   procedure prn-lib-prn-file :
      302     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      303     define input parameter p-DIsabledoptions as integer no-undo .
      304     define variable v-report-name as character no-undo .
      305     define variable v-user-action as character no-undo .
      306     define variable v-printed     as logical   no-undo .
      307     define variable v-exist       as logical   no-undo .
      308     do
      309       on error undo, return error
      310       :
      311       run prn-lib-get-report-name  in this-procedure (
      312         input parParentProc
      313         ,output v-report-name
      314         ).
      315   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      316   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      317     (input  v-report-name
      318     ,input  2
      319     ,output v-exist
      320     )  .
      321       if NOT v-exist then
      322       DO:
      323         Message
      324           "Нет заданий на печать ! "
      325           view-as alert-box .
      326         Return  .
      327       End.
      328       run gbl/prnfilen.w
      329         (input  ""
      330         ,input  p-DisabledOptions
      331         ,input  string(v-report-name )
      332         ,input  7
      333         ,output v-user-action
      334         ,output v-printed
      335         ) .
      336       if v-printed then
      337       do:
      338         return "YES" .
      339       end.
      340       else
      341       do:
      342         return "NO" .
      343       end.
      344     end.
      345   end procedure.
      346   procedure prn-lib-open-stream :
      347     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      348     define input parameter p-page-size    as integer no-undo .
      349     define input parameter p-is-stream    as logical no-undo .
      350     define input parameter p-append       as logical no-undo .
      351     define variable v-report-name as character no-undo .
      352     do
      353       on error undo, return error
      354       :
      355       run prn-lib-get-report-name  in this-procedure (
      356         input parParentProc
      357         ,output v-report-name
      358         ).
      359       if p-is-stream then
      360       do:
      361         if p-append then
      362         do:
      363           output stream PrnLibStream to value( v-report-name )
      364             page-size value(p-page-size) append .
      365         end.
      366         if not p-append then
      367         do:
      368           output stream PrnLibStream to value( v-report-name )
      369             page-size value(p-page-size) .
      370         end.
      371       end.
      372       if not p-is-stream then
      373       do:
      374         if p-append then
      375         do:
      376           output to value( v-report-name )
      377             page-size value(p-page-size) append .
      378         end.
      379         if not p-append then
      380         do:
      381           output to value( v-report-name )
      382             page-size value(p-page-size) .
      383         end.
      384       end.
      385     end.
      386   end procedure.
      387   procedure prn-lib-open-exp :
      388     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      389     define input parameter p-is-stream    as logical no-undo .
      390     define input parameter p-is-append    as logical no-undo .
      391     define output parameter p-ReportFileName as char init "report" no-undo.
      392     define output parameter p-process as logical no-undo .
      393     define variable glog as logical no-undo .
      394     do
      395       on error undo, return error
      396       :
      397       SYSTEM-DIALOG GET-FILE p-ReportFileName
      398         TITLE      "Укажите путь"
      399         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      400         ASK-OVERWRITE
      401         CREATE-TEST-FILE
      402         SAVE-AS
      403         USE-FILENAME
      404         DEFAULT-EXTENSION "txt"
      405         UPDATE glog
      406         .
      407       if not glog then  return.
      408       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      409       if p-is-stream then
      410       do:
      411         if p-is-append then
      412         do:
      413           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      414         end.
      415         else
      416         do:
      417           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      418         end.
      419       end.
      420       else
      421       do:
      422         if p-is-append then
      423         do:
      424           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      425         end.
      426         else
      427         do:
      428           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      429         end.
      430       end.
      431       p-process = yes.
      432     end.
      433   end procedure.
      434   procedure prn-lib-get-report-name :
      435     define input parameter parParentProc  as widget-handle no-undo.
      436     define output parameter p-report-name as character no-undo .
      437     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      438   end procedure.
      439   procedure prn-lib-reportviewer-report-name :
      440     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      441     define input parameter p-report-name-html as character no-undo .
      442     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      443   end procedure.
      444   procedure prn-lib-reportviewer :
      445     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      446     define input parameter p-report-name-html as character no-undo .
      447     define input parameter p-param        as character no-undo .
      448     define variable v-excel           as character no-undo init 'TRUE' .
      449     define variable v-value-character as character no-undo .
      450     define variable v-value-integer   as character no-undo .
      451     define variable v-value-date      as date      no-undo .
      452     define variable v-value-decimal   as decimal   no-undo .
      453     define variable rep-excel         as logical   no-undo .
      454     define variable excel-string      as character no-undo .
      455     define variable v-param-type      as character no-undo .
      456     define variable v-tth             as handle    no-undo .
      457     run adm/shattri.p (
      458       input "get":U
      459       ,input  ""
      460       ,input  0
      461       ,input  'report-glob':U
      462       ,input  'rep-excel':U
      463       ,output v-value-character
      464       ,output v-value-date
      465       ,output v-value-decimal
      466       ,output v-value-integer
      467       ,output rep-excel
      468       ,output v-param-type
      469       ,INPUT-OUTPUT table-handle v-tth
      470       )  .
      471     if rep-excel then v-excel = "TRUE" .
      472     else v-excel = "FALSE" .
      473     if p-param eq ""
      474     then
      475        p-param = "EXCEL:" + v-excel.
      476     else
      477        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      478     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      479   end procedure.
      480   do
      481   on error undo, return error return-value
      482   :
      483   define variable v-doc-code                          as character        no-undo.
      484   define variable v-doc-date                          as date             no-undo.
      485   define variable v-counter                           as integer          no-undo.
      486   define variable v-line-string                       as character        no-undo.
      487   define variable v-host-code                         as integer          no-undo.
      488   define variable v-base-code                         as integer          no-undo.
      489   define variable v-units-okei                        as integer          no-undo.
      490   define variable v-sum-qnty                          as decimal          no-undo.
      491   define variable v-prim                              as character     no-undo.
      492   define variable v-artic                             as character     no-undo.
      493   define variable v-gds-name                          as character     no-undo.
      494   define variable v-unit-base                         as character     no-undo.
      495   define variable v-barcode                           as character     no-undo.
      496   define buffer buf_doc-line  for doc-line.
