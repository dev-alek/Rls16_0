      498   define buffer buf_fbr-doc   for fbr-doc.
      499   define buffer buf_fbr-line  for fbr-line.
      500   define buffer buf_goods     for goods.
      501   define buffer buf_units     for units.
      502   define variable sym1 as character init ":"   no-undo.
      503   define variable sym2 as character init ":"   no-undo.
      504   define variable sym3 as character init ":"   no-undo.
      505   define variable sym4 as character init ":"   no-undo.
      506   define variable sym5 as character init ":"   no-undo.
      507   define variable sym6 as character init ":"   no-undo.
      508   define variable sym7 as character init ":"   no-undo.
      509   define variable sym8 as character init ":"   no-undo.
      510   define variable g#report-num    as integer      no-undo.
      511   define variable g#quest-print   as logical      no-undo.
      512   define variable g#log           as logical      no-undo.
      513   define frame fbr-not-in-rb
      514       sym1                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
      515       v-counter               column-label "!п/п  ! ! !------!1  !"                        format ">>9"            space(0)
      516       sym2                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
      517       v-gds-name              column-label "                   Продукты        и !-----------------------------------------!           Наименование!-----------------------------------------!              2" format "X(41)"          space(0)
      518       sym3                    column-label "!|!|!|!"                                 format "X(1)"           space(0)
      519       v-barcode               column-label "товары    !-----------!    Код!-----------!   3  "                 format "X(10)" space(0)
      520       sym4                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
      521       v-unit-base             column-label "   Единица!-------------!    Наиме-!   нование!-------------!      4"                   format "X(3)"           space(0)
      522       sym5                    column-label "!|!|!|!|"                                format "X(1)"           space(0)
      523       v-units-okei            column-label "измерения  !-------------!Код по  ! ОКЕИ   !-------------!5      "       format ">>>"          space(0)
      524       sym6                    column-label "|!|!|!|!|!|"                                format "X(1)"           space(0)
      525       v-sum-qnty              column-label " !Количество !--------------!6       "                   format ">>,>>9.999"     space(0)
      526       sym7                    column-label "|!|!|!|!|!|"                                format "X(1)"          space(0)
      527       v-prim                  column-label " !    Примечание!---------------------!        7"                   format "X(4)"          space(0)
      528       sym8                    column-label "|!|!|!|!|!|"                                format "X(1)"          space(0)
      529       HEADER
      530       skip v-line-string format  "X(127)" AT 1
      531       with width 136 down stream-io NO-BOX.
      532   run get-report-num in p-mainmenu-handle (
      533       output g#report-num
      534   ).
      535   run get-quest-print in p-mainmenu-handle (
      536       output g#quest-print
      537   ).
      538   find first buf_trn-doc no-lock
      539        where recid(buf_trn-doc) = p-trn-doc-recid
      540   no-error.
      541   if not available buf_trn-doc
      542   then do:
      543       message
      544           "Не найден документ для печати."
      545       view-as alert-box error.
      546       return error.
      547   end.
      548   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      549   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      550     (input  buf_trn-doc.obj-type
      551     ,input  buf_trn-doc.obj-code
      552     ,output v-host-code
      553     )  .
      554   run prn-lib-open-stream in this-procedure ( input p-mainmenu-handle, input 62, input yes, input no ).
      555   session :set-wait-state( "COMPILER":U ).
      556    assign
      557       v-line-string = fill( "-", 127 )
      558   .
      559   assign
      560       v-doc-code      = buf_trn-doc.doc-code
      561       v-doc-date      = ( if buf_trn-doc.status_ = 'факт':U then buf_trn-doc.fact-date else buf_trn-doc.doc-date )
      562    .
      563   find first clients no-lock
      564        where clients.obj-type = buf_trn-doc.obj-type
      565          and clients.obj-code = buf_trn-doc.obj-code
      566   .
      567   put stream PrnLibStream
      568       "Унифицированная форма №ОП-3"
      569       skip
      570       "Утверждена постановлением Госкомстата" space (63) "_ _ _ _ _ _ _ _ _ _ _ _"
      571       skip
      572       "России от 25.12.98 № 132" space (75)  "|_ _ _ _ _ Код _ _ _ _ _|"
      573       skip
      574                              "Форма по ОКУД|_ _ _ _ _0330503_ _ _ _|" at 87
      575       skip
      576                                                         "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
      577       skip
      578       string(  '"' + trim(clients.obj-name) + '"' ) format "X(40)"  at 35    "по ОКПО |_ _ _ _ _ _ _ _ _ _ _ _|" at 92
      579       skip
      580            "____________________________________"   at 29   "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
      581       skip
      582           "предприятие (организация)" at 31       "Вид деятельности по ОКДП|_ _ _ _ _ _ _ _ _ _ _ _|" at 76
      583       skip
      584       string(  buf_trn-doc.obj-type + " " + string(buf_trn-doc.obj-code)  ) format "X(40)" at 10   "|_ _ _ _ _ _ _ _ _ _ _ _|" at 100
      585       skip
      586        "____________________________________"    "Вид операции|_ _ _ _ _ _ _ _ _ _ _ _|" at 88
      587        skip
      588       "подразделение"
      589       skip
      590       string(  string(buf_trn-doc.cli-name) ) format "X(40)"  at 10
      591       skip
      592                    "___________________________"
      593       skip
      594             "подразделение получатель "
      595        skip
      596        "_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _"   at 90
      597        skip
      598        "|           Номер |Дата             |" at 89
      599        skip
      600        "|_ _ _ _документа |составления _ _ _|"   at 89
      601        skip
      602               "Требование в кладовую" at 50 space(18) "|_ _ _ _ _" (string(v-doc-code)) format "X(8)" at 99 "|_"   string( v-doc-date, "99/99/9999" ) format "x(10)"  at 110 "_ _ _|"
      603        skip(1)
      604        "Через кого___________________________________________________________" at 55
      605         skip
      606         "фамилия, имя, отчество" at 80
      607     .
      608       form with frame fbr-not-in-rb.
      609       for each buf_doc-line no-lock
      610          where buf_doc-line.doc-code = buf_trn-doc.doc-code
      611                   :
      612           assign
      613               v-counter = v-counter + 1
      614           .
      615           run print-doc-line in this-procedure (
      616                 input recid( buf_doc-line )
      617               , input v-counter
      618               , input buf_doc-line.fact-qnty
      619               , input v-prim
      620               ).
      621       end.
      622       put stream PrnLibStream
      623           v-line-string format "X(127)"
      624            skip (2)
      625           "Затребовал заведующий производством:                ____________________                   //_________________"
      626            skip
      627           "подпись" at 60 "расшифровка подписи" at 95
      628           skip(1)
      629           "Отпуск разрешил:                                    ____________________ "
      630                   skip(1)
      631           "Руководитель организации:         _____________              _________                    //_________________ "
      632            skip
      633             "должность" at 36  "подпись" at 64     "расшифровка подписи"  at 95
      634           skip(1)
      635              .
      636       hide   stream PrnLibStream frame Bottomframe .
      637       output stream PrnLibStream close.
      638       session :set-wait-state( "":U ).
      639       run prn-lib-prn-file in this-procedure ( input p-mainmenu-handle, input 0 ).
      640     end.
      641   procedure print-doc-line :
      642   do
      643   on error undo, return error
      644   :
      645   define input parameter p-doc-line-recid     as recid        no-undo.
      646   define input parameter p-counter            as integer      no-undo.
      647   define input parameter p-fact-qnty          as decimal      no-undo.
      648   define input parameter p-prim               as character      no-undo.
      649   define variable v-bar-code                  as character        no-undo.
      650   define buffer buf_doc-line  for doc-line.
      651   define buffer buf_goods     for goods.
      652   find first buf_doc-line no-lock
      653       where recid( buf_doc-line ) = p-doc-line-recid
      654   .
      655   find first buf_goods no-lock
      656        where buf_goods.artic      = buf_doc-line.artic
      657          and buf_goods.prod-type  = buf_doc-line.prod-type
      658          and buf_goods.prod-code  = buf_doc-line.prod-code
      659   .
      660   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
      661     (input  buf_goods.gds-code
      662     ,input  ?
      663     ,output v-bar-code
      664     ) no-error .
      665    .
      666   display stream PrnLibStream
      667     sym1 p-counter                                                  @ v-counter
      668     sym2 buf_goods.gds-name                                         @ v-gds-name
      669     sym3 string( v-bar-code )                                       @ v-barcode
      670     sym4 buf_goods.unit-base                                        @ v-unit-base
      671     sym5
      672     sym6 p-fact-qnty                                                @ v-sum-qnty
      673     sym7 p-prim                                                     @ v-prim
      674     sym8
      675   with frame fbr-not-in-rb.
      676   down    stream PrnLibStream 1 with frame fbr-not-in-rb.
      677   if line-counter( PrnLibStream ) + 2 > page-size( PrnLibStream )
      678   then do:
      679     page stream PrnLibStream .
      680   end.
      681   end.
      682   end procedure.
