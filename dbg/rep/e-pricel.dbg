      563   define new global shared variable g#library  as handle no-undo .
      564   define new global shared variable g#library2 as handle no-undo .
      565   define variable var-report-r-b as character no-undo .
      566   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      567   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      568     (output var-report-r-b
      569     )  .
      570   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617     define variable v-cntxt-db-num        as integer   no-undo .
      618     define variable v-cntxt-userid        as character no-undo .
      619     define variable v-cntxt-level         as character no-undo .
      620     define variable v-cntxt-host-code-obj as integer   no-undo .
      621     define variable v-cntxt-obj-type      as character no-undo .
      622     define variable v-cntxt-obj-code      as integer   no-undo .
      623     define variable v-cntxt-db-num-obj    as integer   no-undo .
      624     define variable v-cntxt-is-admin      as logical   no-undo .
      625   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      626     run mainmenu_getcntxt in my-handle
      627       (output v-cntxt-db-num
      628       ,output v-cntxt-userid
      629       ,output v-cntxt-level
      630       ,output v-cntxt-host-code-obj
      631       ,output v-cntxt-obj-type
      632       ,output v-cntxt-obj-code
      633       ,output v-cntxt-db-num-obj
      634       ,output v-cntxt-is-admin
      635       ) .
      636   define variable base-type as character no-undo .
      637   define variable base-code as integer   no-undo .
      638   define variable g#report-num as integer   no-undo .
      639   define variable g#gds-engl as logical   no-undo .
      640   define variable vv-exch-rate  as decimal   no-undo .
      641   define variable vv-exch-scale as decimal   no-undo .
      642   define variable v-cntxt-host-name-obj as character no-undo .
      643   if v-cntxt-level = 'object':U then do:
      644   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      645   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      646     (input  v-cntxt-obj-type
      647     ,input  v-cntxt-obj-code
      648     ,output v-cntxt-host-code-obj
      649     ,output v-cntxt-host-name-obj
      650     )  .
      651   end.
      652   if v-cntxt-level = 'firm':U then do:
      653     find first ub.clients no-lock where
      654                ub.clients.obj-type = 'орг':U and
      655                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      656   if error-status :error then v-cntxt-host-name-obj = ? .
      657      else v-cntxt-host-name-obj = ub.clients.obj-name.
      658   end.
      659   if v-cntxt-level = 'object':U
      660   or v-cntxt-level = 'firm':U
      661   then do:
      662   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      663   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      664     (input  v-cntxt-host-code-obj
      665     ,output base-code
      666     )  .
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      669     (input  base-code
      670     ,input  today
      671     ,output vv-exch-rate
      672     ,output vv-exch-scale
      673     ,output base-type
      674     )  .
      675   end.
      676   run get-report-num in my-handle ( output g#report-num ).
      677   run get-gds-engl in my-handle ( output g#gds-engl ) .
      678   def var   ChosedType    as   integer.
      679   def var   PayType       as   integer.
      680   def var   Sort-Type     as   char   .
      681   def var   NoPrt         as   log    .
      682   def var State-source as  WIDGET-HANDLE.
      683   def var stat                as      log       init no           no-undo.
      684   RUN set-attribute-list (
      685       'Keys-Accepted = "",
      686        Keys-Supplied = ""':U).
      687   DEFINE VARIABLE MainTypes AS INTEGER
      688        VIEW-AS RADIO-SET VERTICAL
      689        RADIO-BUTTONS
      690             "Фактическое наличие", 1,
      691   "Только цены", 2
      692        SIZE 24 BY 2.33 NO-UNDO.
      693   DEFINE VARIABLE SET_PAY_TYPE AS INTEGER
      694        VIEW-AS RADIO-SET VERTICAL
      695        RADIO-BUTTONS
      696             "В валюте", 1,
      697   "В рублях", 2
      698        SIZE 12 BY 2.33
      699        FGCOLOR 0  NO-UNDO.
      700   DEFINE VARIABLE SortType AS CHARACTER
      701        VIEW-AS RADIO-SET VERTICAL
      702        RADIO-BUTTONS
      703             "По группам товаров ( и артикулу )", "По группам товаров ( и артикулу )",
      704   "Только по артикулу", "Только по артикулу"
      705        SIZE 36.5 BY 2.33 NO-UNDO.
      706   DEFINE RECTANGLE RECT-1
      707        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      708        SIZE 40 BY 3.17.
      709   DEFINE RECTANGLE RECT-3
      710        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      711        SIZE 40 BY 4.17.
      712   DEFINE RECTANGLE RECT-4
      713        EDGE-PIXELS 3 GRAPHIC-EDGE  NO-FILL
      714        SIZE 40 BY 1.67.
      715   DEFINE VARIABLE No-Prt AS LOGICAL INITIAL no
      716        LABEL "Без детализации по признакам"
      717        VIEW-AS TOGGLE-BOX
      718        SIZE 33.5 BY .83 NO-UNDO.
      719   DEFINE FRAME F-Main
      720        MainTypes AT ROW 1.75 COL 3.5 NO-LABEL
      721        SET_PAY_TYPE AT ROW 1.75 COL 28.5 NO-LABEL
      722        SortType AT ROW 5.75 COL 3.5 NO-LABEL
      723        No-Prt AT ROW 8.92 COL 4.5
      724        RECT-1 AT ROW 1.25 COL 2
      725        RECT-3 AT ROW 4.42 COL 2
      726        "Сортировка :" VIEW-AS TEXT
      727             SIZE 13.5 BY .75 AT ROW 4.75 COL 15
      728        RECT-4 AT ROW 8.58 COL 2
      729       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      730            SIDE-LABELS NO-UNDERLINE THREE-D
      731            AT COL 1 ROW 1 SCROLLABLE .
      732   ASSIGN
      733          FRAME F-Main:SCROLLABLE       = FALSE
      734          FRAME F-Main:HIDDEN           = TRUE.
      735   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      736   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      737   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      738   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      739   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      740   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      741   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      742   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      743         adm-object-hdl = FRAME F-Main:HANDLE.
      744   RUN ensure-broker.
      745   THIS-PROCEDURE:ADM-DATA =
      746        'ADM1.1~`':U +
      747        'SmartObject~`':U +
      748        '~`':U +
      749        'NO ~`':U +
      750        '~`':U +
      751        '~`':U +
      752        '~`':U +
      753        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      754           + "~`":U +
      755        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      756        'Record-Source,Record-Target,TableIO-Target~`':U +
      757        '~`':U +
      758        '~`~`~`~`~`~`~`~`~`~`~`':U +
      759        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      760            THEN "^^":U
      761        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      762             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      763   PROCEDURE adm-apply-entry :
      764     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      765   END PROCEDURE.
      766   PROCEDURE adm-destroy :
      767    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      768   END PROCEDURE.
      769   PROCEDURE adm-disable :
      770       DISABLE RECT-1 RECT-3 RECT-4 MainTypes SET_PAY_TYPE SortType No-Prt WITH FRAME F-Main.
      771       RUN dispatch ('disable-fields':U).
      772       RUN set-attribute-list ('ENABLED=no':U).
      773       RETURN.
      774   END PROCEDURE.
      775   PROCEDURE adm-edit-attribute-list :
      776         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      777         RETURN.
      778   END PROCEDURE.
      779   PROCEDURE adm-enable :
      780       ENABLE UNLESS-HIDDEN RECT-1 RECT-3 RECT-4 MainTypes SET_PAY_TYPE SortType No-Prt WITH FRAME F-Main.
      781       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      782       RUN set-attribute-list ('ENABLED=yes':U).
      783       RETURN.
      784   END PROCEDURE.
      785   PROCEDURE adm-exit :
      786        RUN notify ('exit':U).
      787     RETURN.
      788   END PROCEDURE.
      789   PROCEDURE adm-hide :
      790     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      791   END PROCEDURE.
      792   PROCEDURE adm-initialize :
      793     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      794   END PROCEDURE.
      795   PROCEDURE adm-show-errors :
      796       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      797       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      798           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      799       END.
      800       RETURN.
      801   END PROCEDURE.
      802   PROCEDURE adm-UIB-mode :
      803     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      804   END PROCEDURE.
      805   PROCEDURE adm-view :
      806     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      807   END PROCEDURE.
      808   PROCEDURE dispatch :
      809       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      810       RUN broker-dispatch IN adm-broker-hdl
      811           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      812       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      813   END PROCEDURE.
      814   PROCEDURE ensure-broker :
      815   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      816   IF RETURN-VALUE NE "ADM-Broker":U THEN
      817   DO:
      818       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      819       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      820   END.
      821   END PROCEDURE.
      822   PROCEDURE get-attribute :
      823     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      824     RUN broker-get-attribute IN adm-broker-hdl
      825         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      826     RETURN RETURN-VALUE.
      827   END PROCEDURE.
      828   PROCEDURE get-attribute-list :
      829     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      830     RUN broker-get-attribute-list IN adm-broker-hdl
      831         (INPUT THIS-PROCEDURE,
      832          INPUT ?,
      833          OUTPUT p-attr-list) NO-ERROR.
      834     RETURN.
      835   END PROCEDURE.
      836   PROCEDURE new-state :
      837     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      838     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      839     RETURN.
      840   END PROCEDURE.
      841   PROCEDURE notify :
      842     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      843     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      844     IF RETURN-VALUE = "ADM-ERROR":U THEN
      845         RETURN "ADM-ERROR":U.
      846     RETURN.
      847   END PROCEDURE.
      848   PROCEDURE set-attribute-list :
      849     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      850     RUN ensure-broker.
      851     RUN broker-set-attribute-list IN adm-broker-hdl
      852         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      853     RETURN.
      854   END PROCEDURE.
      855   PROCEDURE set-position :
      856       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      857       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      858       IF VALID-HANDLE(adm-object-hdl) THEN
      859       DO:
      860         ASSIGN adm-object-hdl:ROW    =   p-row
      861                adm-object-hdl:COLUMN =   p-col.
      862       END.
      863       RETURN.
      864   END PROCEDURE.
      865   PROCEDURE adm-display-fields :
      866       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      867       RETURN.
      868   END PROCEDURE.
      869   PROCEDURE adm-open-query :
      870     RETURN.
      871   END PROCEDURE.
      872   PROCEDURE adm-row-changed :
      873         IF VALID-HANDLE(adm-object-hdl) THEN
      874           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      875         RUN notify ('row-available':U).
      876         RETURN.
      877   END PROCEDURE.
      878   PROCEDURE reposition-query :
      879       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      880       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      881       RETURN.
      882   END PROCEDURE.
      883     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      884     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      885     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      886     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      887     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      888     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      889     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      890     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      891     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      892     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      893     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      894     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      895     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      896     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      897     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      898     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      899     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      900     IF "":U = "":U THEN
      901       RUN modify-list-attribute IN adm-broker-hdl
      902         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      903     RUN use-create-on-add(?).
      904   PROCEDURE adm-add-record :
      905       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      906          "must have at least one Enabled Table to perform Add.":U
      907          VIEW-AS ALERT-BOX ERROR.
      908       RETURN.
      909   END PROCEDURE.
      910   PROCEDURE adm-assign-record :
      911    MESSAGE
      912          "Object ":U THIS-PROCEDURE:FILE-NAME
      913            "must have at least one Enabled Table to perform Assign.":U
      914              VIEW-AS ALERT-BOX ERROR.
      915      RETURN.
      916     END PROCEDURE.
      917   PROCEDURE adm-assign-statement :
      918     RETURN.
      919   END PROCEDURE.
      920   PROCEDURE adm-cancel-record :
      921      RETURN.
      922     END PROCEDURE.
      923   PROCEDURE adm-copy-record :
      924       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      925        "must have at least one Enabled Table to perform Copy.":U
      926          VIEW-AS ALERT-BOX ERROR.
      927       RETURN.
      928   END PROCEDURE.
      929   PROCEDURE adm-create-record :
      930      RETURN.
      931   END PROCEDURE.
      932   PROCEDURE adm-current-changed :
      933     RETURN.
      934   END PROCEDURE.
      935   PROCEDURE adm-delete-record :
      936    MESSAGE
      937          "Object ":U THIS-PROCEDURE:FILE-NAME
      938            "must have at least one Enabled Table to perform Delete.":U
      939              VIEW-AS ALERT-BOX ERROR.
      940       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      941       RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-disable-fields :
      944         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      945       RETURN.
      946   END PROCEDURE.
      947   PROCEDURE adm-enable-fields :
      948       RETURN.
      949   END PROCEDURE.
      950   PROCEDURE adm-end-update :
      951     RETURN.
      952   END PROCEDURE.
      953   PROCEDURE adm-reset-record :
      954       RETURN.
      955   END PROCEDURE.
      956   PROCEDURE adm-update-record :
      957       MESSAGE
      958         "Object ":U THIS-PROCEDURE:FILE-NAME
      959           "must have at least one Enabled Table to perform Update.":U
      960             VIEW-AS ALERT-BOX ERROR.
      961      RETURN.
      962   END PROCEDURE.
      963   PROCEDURE check-modified :
      964   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      965   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      966   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      967   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      968     IF check-state = "check":U THEN
      969     DO:
      970       RUN get-link-handle IN adm-broker-hdl
      971         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      972            OUTPUT group-target-list).
      973       IF group-target-list NE "":U THEN
      974       DO i = 1 TO NUM-ENTRIES(group-target-list):
      975         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      976         RUN check-modified IN curr-widget ('group-check':U).
      977         IF RETURN-VALUE NE "":U THEN
      978         DO:
      979           RUN check-modified-message(RETURN-VALUE).
      980           RETURN "":U.
      981         END.
      982       END.
      983     END.
      984     RETURN "":U.
      985   END PROCEDURE.
      986   PROCEDURE check-modified-message :
      987     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      988        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      989           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      990        IF RETURN-VALUE = "YES":U THEN
      991           RUN notify ('view,CONTAINER-SOURCE':U).
      992        MESSAGE IF p-changed-table NE ? THEN
      993           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      994           ELSE "Current values have been changed."
      995           SKIP "  Do you wish to save those changes?"
      996           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      997        IF ANS THEN
      998        DO:
      999           IF group-assign-target THEN
     1000             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1001           ELSE RUN dispatch('update-record':U).
     1002           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1003           DO:
     1004               MESSAGE "Changes to the previous record were not saved."
     1005                 VIEW-AS ALERT-BOX ERROR.
     1006               IF group-assign-target THEN
     1007                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1008               ELSE RUN dispatch ('cancel-record':U).
     1009           END.
     1010        END.
     1011        ELSE DO:
     1012          IF group-assign-target THEN
     1013             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1014          ELSE RUN dispatch('cancel-record':U).
     1015        END.
     1016        RETURN.
     1017   END PROCEDURE.
     1018   PROCEDURE get-rowid :
     1019       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1020       ASSIGN
     1021       p-table   =   adm-first-table.
     1022       RETURN.
     1023   END PROCEDURE.
     1024   PROCEDURE init-group-assign :
     1025       RUN request-attribute IN adm-broker-hdl
     1026         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1027       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1028         group-assign-target = yes.
     1029       ELSE group-assign-target = no.
     1030       RETURN.
     1031   END PROCEDURE.
     1032   PROCEDURE set-editors :
     1033       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1034       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1035       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1036       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1037       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1038       DO WHILE VALID-HANDLE (curr-widget):
     1039           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1040              curr-widget:HIDDEN = no THEN DO:
     1041             CASE p-field-setting:
     1042               WHEN "INITIALIZE":U THEN
     1043               DO:
     1044                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1045                     read-only-list +
     1046                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1047                        STRING(curr-widget).
     1048               END.
     1049               WHEN "DISABLE":U OR
     1050               WHEN "ENABLE":U THEN
     1051               DO:
     1052                   curr-widget:SENSITIVE = yes.
     1053                   RUN get-attribute ('Read-Only-Editors':U).
     1054                   IF RETURN-VALUE = ? OR
     1055                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1056                       curr-widget:READ-ONLY =
     1057                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1058               END.
     1059               WHEN "CLEAR":U THEN
     1060                   curr-widget:SCREEN-VALUE = "":U.
     1061             END CASE.
     1062           END.
     1063           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1064       END.
     1065       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1066         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1067           + '"':U).
     1068       RETURN.
     1069   END PROCEDURE.
     1070   PROCEDURE use-check-modified-all :
     1071    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1072     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1073     RETURN.
     1074   END PROCEDURE.
     1075   PROCEDURE use-create-on-add :
     1076   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1077      RETURN.
     1078   END PROCEDURE.
     1079   PROCEDURE use-initial-lock :
     1080     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1081     ASSIGN adm-initial-lock = p-attr-value.
     1082     RETURN.
     1083   END PROCEDURE.
     1084     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1085   if not this-procedure :persistent
     1086   then do:
     1087     message
     1088       vss-workfile vss-revision vss-description skip
     1089       "Ошибка при запуске процедуры" skip
     1090       "Данную процедуру следует запускать только с параметром persistent" skip
     1091       view-as alert-box error .
     1092     undo, return error .
     1093   end.
     1094   PROCEDURE adm-row-available :
     1095     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1096     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1097     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1098     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1099     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1100     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1101     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1102     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1103     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1104     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1105     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1106     IF adm-updating-record THEN RETURN.
     1107     RUN get-attribute ('FIELDS-ENABLED':U).
     1108     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1109     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1110         OUTPUT link-handle) NO-ERROR.
     1111     IF link-handle = "":U THEN
     1112         RETURN.
     1113     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1114     IF NUM-ENTRIES(link-handle) > 1 THEN
     1115         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     1116             "encountered more than one RECORD-SOURCE.":U SKIP
     1117             "The first - ":U record-source-hdl:file-name " - will be used.":U
     1118                VIEW-AS ALERT-BOX ERROR.
     1119     RUN get-attribute ('Key-Name':U).
     1120     key-name = RETURN-VALUE.
     1121     IF key-name = "":U THEN key-name = ?.
     1122     IF key-name NE ? THEN DO:
     1123       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     1124         NO-ERROR.
     1125       IF key-value NE ? THEN
     1126         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     1127     END.
     1128   IF VALID-HANDLE (adm-object-hdl) THEN
     1129       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1130   RUN notify IN THIS-PROCEDURE ('row-available':U).
     1131   END PROCEDURE.
     1132   PROCEDURE disable_UI :
     1133     HIDE FRAME F-Main.
     1134     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1135   END PROCEDURE.
     1136   PROCEDURE local-initialize :
     1137     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1138      if base-code = 0 then
     1139       stat = SET_PAY_TYPE:DISABLE("В валюте") in frame F-Main .
     1140   END PROCEDURE.
     1141   PROCEDURE my-report :
     1142   run rep/r-pricel.p
     1143       ( ChosedType ,
     1144         PayType   ,
     1145         Sort-Type ,
     1146         NoPrt ).
     1147   END PROCEDURE.
     1148   PROCEDURE my-var :
     1149    assign frame F-Main
     1150        No-Prt .
     1151       ChosedType = integer(MainTypes:screen-value).
     1152       PayType = integer(SET_PAY_TYPE:screen-value).
     1153       Sort-Type = SortType:screen-value .
     1154       NoPrt = No-Prt.
     1155   END PROCEDURE.
     1156   PROCEDURE send-records :
     1157   END PROCEDURE.
     1158   PROCEDURE state-changed :
     1159     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1160     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1161     CASE p-state:
     1162       WHEN 'update-begin':U THEN DO:
     1163           RUN dispatch('enable-fields':U).
     1164           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1165           DO:
     1166             RUN new-state('update-failed,TABLEIO-SOURCE':U).
     1167             RUN new-state('update-complete':U).
     1168           END.
     1169           ELSE RUN new-state ('update':U).
     1170       END.
     1171       WHEN 'update-complete':U THEN DO:
     1172           RUN new-state ('update-complete':U).
     1173       END.
     1174     END CASE.
     1175   END PROCEDURE.
