      598             v-cntxp-out-pay         = bf-cntxp_store.out-pay
      599             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
      600             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
      601             v-cntxp-down-pay        = bf-cntxp_store.down-pay
      602             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
      603             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
      604             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
