      788              Our_Host.obj-type = 'орг':U and
      789              Our_Host.obj-code = t-doc.host-code.
      790   output stream s-out to value( string( session:temp-directory +
      791                                        "rpt" + string( g#report-num ) ) )
      792                                        page-size  value(43) .
      793   put stream s-out space( 90 ) Our_Host.obj-name format "x(40)":U skip( 2 )
      794                    space( 20 ) "А К Т   П Е Р Е О Ц Е Н К И   ( автоматической ) по документу  N " format "x(80)":U
      795                    t-doc.doc-code format "x(10)":U "  от  " t-doc.doc-date format "99.99.9999":U skip( 1 ).
      796   if lookup( "ParCom":U, p-mode ) <> 0 then do:
      797     if t-doc.doc-type = 'при':U and t-doc.internal <> yes then do:
      798       put stream s-out substitute( "Основание: накладная поставщика N &1 от &2", t-doc.ord-num,
      799                        string( t-doc.ship-date, "99.99.9999":U ) ) format "x(110)":U skip( 1 ).
      800     end.
      801   end.
      802   else do:
      803     if t-doc.doc-type = 'при':U and t-doc.internal <> yes then do:
      804   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
      805                           input 'nids':U ,
      806                          output v-nids ,
      807                          output v-parameter-type )  .
      808       if v-nids <> "":U and v-nids <> ? then do:
      809         put stream s-out space( 20 ) "Основание: накладная поставщика N: " v-nids format "x(110)":U skip( 1 ).
      810       end.
      811     end.
      812   end.
      813   if t-doc.doc-type = 'при':U
      814     or t-doc.ext-doc-type = 'ep':U
      815   then do:
      816     put stream s-out space( 20 ) string( "ПОСТАВЩИК : " + t-doc.cli-name ) format "x(90)":U skip( 1 ).
      817   end.
      818   form header
      819     v-single-line format "x(136)":U       at  1 skip
      820     "Продолжение - на следующей странице" at 30 skip
      821   with frame Bottomframe width 235 page-bottom no-labels no-box.
      822   view stream s-out frame Bottomframe.
      823   if v-rb-is-base = yes then do: form with frame PrintFrame_Act-base. end.
      824                         else do: form with frame PrintFrame_Act-rubl. end.
      825   for each ub.doc-line no-lock where ub.doc-line.doc-code = t-doc.doc-code
      826     , each ub.gds-dtl  no-lock where
      827            ub.gds-dtl.doc-code  = ub.doc-line.doc-code  and
      828            ub.gds-dtl.artic     = ub.doc-line.artic     and
      829            ub.gds-dtl.prod-type = ub.doc-line.prod-type and
      830            ub.gds-dtl.prod-code = ub.doc-line.prod-code and
      831            ub.gds-dtl.ov        = yes
      832     , each ub.goods    no-lock where
      833            ub.goods.prod-type = ub.gds-dtl.prod-type and
      834            ub.goods.prod-code = ub.gds-dtl.prod-code and
      835            ub.goods.artic     = ub.gds-dtl.artic
      836   break by ub.gds-dtl.artic
      837         by ub.gds-dtl.prt-code
      838   :
      839   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
      840     (
      841        input ub.goods.artic
      842     ,  input ub.goods.prod-type
      843     ,  input ub.goods.prod-code
      844     , output is-petrol
      845     , output is-pieces
      846     ) no-error.
      847     if error-status :error or is-petrol <> yes or is-pieces <> no then do: next. end.
      848     find first ub.bar-code no-lock where
      849                ub.bar-code.gds-code  = ub.goods.gds-code   and
      850                ub.bar-code.unit-cli  = ub.goods.unit-base  and
      851                ub.bar-code.node-code = ub.gds-dtl.prt-code and
      852                ub.bar-code.part-code = "":U                and
      853                ub.bar-code.in-code   = "":U                no-error.
      854     assign j_total          =   j_total                      + 1
      855            d_qnty-kg        =
      856       invlnsum_cli-qnty (
      857                      ub.gds-dtl.doc-code
      858                    , ub.goods.artic
      859                    , ub.goods.prod-type
      860                    , ub.goods.prod-code
      861                    )
      862            d_cli-rate       =   ub.gds-dtl.fact-qnty         / d_qnty-kg
      863            d_obj-price      =   ub.gds-dtl.cur-base          * d_cli-rate
      864            d_obj-sum        =   d_obj-price                  * d_qnty-kg
      865            d_sale-price     =
      866       invlnsum_sale-price (
      867                      ub.gds-dtl.doc-code
      868                    , ub.goods.artic
      869                    , ub.goods.prod-type
      870                    , ub.goods.prod-code
      871                    , print_rubl
      872                    )
      873            d_sale-sum       =   d_sale-price                 * d_qnty-kg
      874            d_delta          = ( d_obj-price - d_sale-price ) / d_sale-price * 100
      875            total_qnty-kg    = total_qnty-kg                  + d_qnty-kg
      876            total_sale-sum   = total_sale-sum                 + d_sale-sum
      877            total_obj-sum    = total_obj-sum                  + d_obj-sum
      878            total_delta      = total_delta                    + d_obj-sum    - d_sale-sum.
      879     if v-rb-is-base = yes then do:
      880       display stream s-out sym1   trim( string( ub.bar-code.b-code ) )         @ tb-code
      881                                                 ub.gds-dtl.artic
      882                                                 ub.goods.gds-name
      883                                                 d_qnty-kg                      @ ub.gds-dtl.fact-qnty
      884                                                 d_sale-price                   @ price-doc
      885                                                 d_sale-sum                     @ doc-sum
      886                                                 d_obj-price                    @ ub.gds-dtl.cur-base
      887                                                 d_obj-sum                      @ obj-sum
      888                                 string( string( d_delta, "->>>9.9":U ) + "%" ) @ Delt sym2
      889       with frame PrintFrame_Act-base.
      890       down stream s-out 1 with frame PrintFrame_Act-base.
      891       IF LENGTH(ub.goods.gds-name, "CHARACTER") > 30 and FullGdsName THEN  do:
      892         assign propis = SUBSTRING(ub.goods.gds-name,31) .
      893         DISPLAY stream s-out sym1 propis @ ub.goods.gds-name  sym2   with frame PrintFrame_Act-base .
      894         down stream s-out 1 with frame PrintFrame_Act-base .
      895       end.
      896     end.
      897     else do:
      898       display stream s-out sym1   trim( string( ub.bar-code.b-code ) )         @ tb-code
      899                                                 ub.gds-dtl.artic
      900                                                 ub.goods.gds-name
      901                                                 d_qnty-kg                      @ ub.gds-dtl.fact-qnty
      902                                                 d_sale-price                   @ price-doc
      903                                                 d_sale-sum                     @ doc-sum
      904                                                 d_obj-price                    @ ub.gds-dtl.cur-base
      905                                                 d_obj-sum                      @ obj-sum
      906                                 string( string( d_delta, "->>>9.9":U ) + "%" ) @ Delt sym2
      907       with frame PrintFrame_Act-rubl.
      908       down stream s-out 1 with frame PrintFrame_Act-rubl.
      909       IF LENGTH(ub.goods.gds-name, "CHARACTER") > 30 and FullGdsName THEN  do:
      910         assign propis = SUBSTRING(ub.goods.gds-name,31) .
      911         DISPLAY stream s-out sym1 propis @ ub.goods.gds-name  sym2   with frame PrintFrame_Act-rubl .
      912         down stream s-out 1 with frame PrintFrame_Act-rubl .
      913       end.
      914     end.
      915     if last( ub.gds-dtl.artic ) then do:
      916       assign total_percent = total_delta / total_sale-sum * 100.
      917       if v-rb-is-base = yes then do:
      918         put     stream s-out v-single-line format "x(136)":U skip.
      919         display stream s-out "  ИТОГО"                                            @ ub.goods.gds-name
      920                                              total_qnty-kg                        @ ub.gds-dtl.fact-qnty
      921                                              total_sale-sum                       @ doc-sum
      922                                              total_obj-sum                        @ obj-sum
      923                              string( string( total_percent, "->>>9.9":U ) + "%" ) @ Delt
      924         with frame PrintFrame_Act-base.
      925         underline stream s-out ub.goods.gds-name
      926                                ub.gds-dtl.fact-qnty
      927                                doc-sum
      928                                obj-sum
      929                                Delt
      930         with frame PrintFrame_Act-base.
      931         down stream s-out 2 with frame PrintFrame_Act-base.
      932       end.
      933       else do:
      934         put     stream s-out v-single-line format "x(136)":U skip.
      935         display stream s-out "  ИТОГО"                                            @ ub.goods.gds-name
      936                                              total_qnty-kg                        @ ub.gds-dtl.fact-qnty
      937                                              total_sale-sum                       @ doc-sum
      938                                              total_obj-sum                        @ obj-sum
      939                              string( string( total_percent, "->>>9.9":U ) + "%" ) @ Delt
      940         with frame PrintFrame_Act-rubl.
      941         underline stream s-out ub.goods.gds-name
      942                                ub.gds-dtl.fact-qnty
      943                                doc-sum
      944                                obj-sum
      945                                Delt
      946         with frame PrintFrame_Act-rubl.
      947         down stream s-out 2 with frame PrintFrame_Act-rubl.
      948       end.
      949     end.
      950   end.
      951   hide stream s-out frame Bottomframe.
      952   if v-rb-is-base = yes then do:
      953     assign propis = Total-Word(          absolute( total_delta ), base-type, base-part )
      954            abbr   = base-type.
      955   end.                  else do:
      956     assign propis = Total-Word(          absolute( total_delta ),
      957                                 Roubles( absolute( total_delta ) ),
      958                                 Copecks( absolute( total_delta ) ) )
      959            abbr   = " руб.".
      960   end.
      961   put stream s-out space( 10 ) "Всего  " j_total                format ">>>>9":U
      962                                " наименований."                 format "x(15)":U skip( 1 )
      963                    space( 10 ) "Разница в суммах составила :  " format "x(35)":U
      964                                total_delta                      format "->,>>>,>>>,>>9.99":U
      965                    space(  2 ) trim( abbr )                     format "x(3)":U  skip( 1 ).
      966   if line-counter( s-out ) + 4 > page-size( s-out ) then do: page stream s-out. end.
      967   put stream s-out space( 10 ) ( if trim( propis ) begins trim( abbr ) then "0 " else "":U ) + propis format "x(120)":U skip( 2 ).
      968   put stream s-out space( 20 ) "Зав. складом/Зав. секцией : " format "x(30)":U skip.
      969   output stream s-out close.
      970   if g#quest-print = false
      971   then do:
      972     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      973                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
      974                                         OUTPUT g#log ).
      975   end.
      976   else do:
      977     os-command silent
      978       value( "COPY /b " +
      979         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      980         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      981         string( session:temp-directory) +  "$" + string( g#report-num )
      982                 ) .
      983     os-command silent
      984       value( "COPY /b " +
      985         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      986         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      987         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      988                 ) .
      989   end.
