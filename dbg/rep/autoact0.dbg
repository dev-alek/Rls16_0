      762   find first t-doc no-lock where recid( t-doc ) = rec_id.
      763   define variable FullGdsName as logical   no-undo .
      764   define variable tmp-var  as character no-undo .
      765   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      766   empty temp-table thbjattr_thbj-attr.
      767   run adm/shattri.p (
      768      input "get":U
      769     ,input t-doc.obj-type
      770     ,input t-doc.obj-code
      771     ,input 'prt-obj':U
      772     ,input  ""
      773     ,output v-value-character
      774     ,output v-value-date
      775     ,output v-value-decimal
      776     ,output v-value-integer
      777     ,output v-value-logical
      778     ,output par-type
