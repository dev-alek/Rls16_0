        1   block-level on error undo, throw.
        2   define input parameter parparentproc as widget-handle no-undo.
        3   define input parameter rec_id        as recid         no-undo.
        4   define input parameter p-mode        as character     no-undo.
        5   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U.
        6   define variable vss-author      as character no-undo initial "$Author: expertek $":U.
        7   define variable vss-date        as character no-undo initial "$date: 12.09.03 15:57 $":U.
        8   define variable vss-workfile    as character no-undo initial "$Workfile: autoact0.p $":U.
        9   define variable vss-archive     as character no-undo initial "$Archive: rep/autoact0.p $":U.
       10   define variable vss-description as character no-undo initial "Печать акта автоматической переоценки (весовой учет топлива)".
       11   procedure vss-get-info :
       12     define output parameter p-vss-revision    like vss-revision    no-undo .
       13     define output parameter p-vss-author      like vss-author      no-undo .
       14     define output parameter p-vss-date        like vss-date        no-undo .
       15     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       16     define output parameter p-vss-archive     like vss-archive     no-undo .
       17     define output parameter p-vss-description like vss-description no-undo .
       18     assign
       19       p-vss-revision    = vss-revision
       20       p-vss-author      = vss-author
       21       p-vss-date        = vss-date
       22       p-vss-workfile    = vss-workfile
       23       p-vss-archive     = vss-archive
       24       p-vss-description = vss-description
       25     .
       26   end procedure.
       27   procedure vss-get-parameters :
       28     define output parameter p-vss-parameters as character no-undo .
       29   end procedure.
       30   define new global shared variable g#vssrevis-logger as handle    no-undo .
       31   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       32   define variable v-vssrevis-logger                   as handle    no-undo .
       33   procedure vss-logevent :
       34     define input  parameter p-extra-paramters as character no-undo .
       35     define variable v-vssrevis-parameters as character no-undo .
       36     do
       37     on error undo, return error return-value
       38     :
       39       if  valid-handle(v-vssrevis-logger)
       40       and v-vssrevis-logger :get-signature("logevent") <> ""
       41       then do:
       42         run vss-get-parameters in this-procedure
       43           (output v-vssrevis-parameters
       44           ).
       45         run logevent in v-vssrevis-logger
       46           (input vss-workfile
       47           ,input vss-revision
       48           ,input v-vssrevis-parameters
       49           ,input p-extra-paramters
       50           ).
       51       end.
       52     end.
       53   end procedure.
       54   assign
       55     v-vssrevis-logger = g#vssrevis-logger
       56   .
       57   if  valid-handle(v-vssrevis-logger)
       58   and v-vssrevis-logger :get-signature("logevent") <> ""
       59   then do:
       60     assign
       61       v-vssrevis-logevent = true
       62     .
       63     run vss-logevent in this-procedure (input vss-description) .
       64   end.
       65   define new global shared variable g#language as character no-undo .
       66   if g#language <> '' and g#language <> 'rus':U then do:
       67     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       68   end.
       69   define new global shared variable g#library  as handle no-undo .
       70   define new global shared variable g#library2 as handle no-undo .
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
      296   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      298   define  shared variable RepPathName        as character no-undo .
      299   define  shared variable PrintRubl          as logical   no-undo .
      300   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      301   define new global shared variable g#trdcalib as handle no-undo.
      302   define new global shared variable g#lib-trn  as handle no-undo .
      303   define new global shared variable g#lib-trn2 as handle no-undo .
      304   define new global shared variable g#lib-trn3 as handle no-undo .
      305   define new global shared variable g#lib-trn4 as handle no-undo .
      306   FUNCTION RedLine RETURNS CHARACTER ( INPUT i-str AS CHARACTER ) :
      307     DEFINE VARIABLE v-str AS CHARACTER NO-UNDO.
      308     RUN get-red-line IN THIS-PROCEDURE ( INPUT i-str, OUTPUT v-str ) NO-ERROR.
      309     RETURN ( IF ERROR-STATUS :ERROR THEN i-str ELSE v-str ).
      310   END FUNCTION.
      311   PROCEDURE get-red-line :
      312     DEFINE  INPUT PARAMETER p-str AS CHARACTER NO-UNDO.
      313     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      314     DO ON ERROR UNDO, RETURN ERROR :
      315       ASSIGN p-res = CAPS( SUBSTRING( p-str, 1, 1 ) ) + LC( SUBSTRING( p-str, 2 ) ).
      316     END.
      317   END PROCEDURE.
      318   FUNCTION Roubles RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      319     DEFINE VARIABLE Rouble AS CHARACTER NO-UNDO.
      320     RUN get-roubles IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Rouble ) NO-ERROR.
      321     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Rouble ).
      322   END FUNCTION.
      323   PROCEDURE get-roubles :
      324     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      325     DEFINE OUTPUT PARAMETER p-rub AS CHARACTER NO-UNDO.
      326     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      327     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      328     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      329     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      330     DO ON ERROR UNDO, RETURN ERROR :
      331       ASSIGN Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      332              jj     = LENGTH( Word )
      333              j_last = INTEGER( SUBSTRING( Word, jj - 3, 1 ) )
      334              l_prev =        ( SUBSTRING( Word, jj - 4, 1 ) = "1" ).
      335       IF      j_last = 1                THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубль" ).  END.
      336       ELSE IF j_last > 1 AND j_last < 5 THEN DO: ASSIGN p-rub = ( IF l_prev = YES THEN "рублей" ELSE "рубля" ). END.
      337                                         ELSE DO: ASSIGN p-rub = "рублей". END.
      338     END.
      339   END PROCEDURE.
      340   FUNCTION Copecks RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      341     DEFINE VARIABLE Copeck AS CHARACTER NO-UNDO.
      342     RUN get-copecks IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT Copeck ) NO-ERROR.
      343     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE Copeck ).
      344   END FUNCTION.
      345   PROCEDURE get-copecks :
      346     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      347     DEFINE OUTPUT PARAMETER p-kop AS CHARACTER NO-UNDO.
      348     DEFINE VARIABLE Word   AS CHARACTER NO-UNDO.
      349     DEFINE VARIABLE jj     AS INTEGER   NO-UNDO.
      350     DEFINE VARIABLE j_last AS INTEGER   NO-UNDO.
      351     DEFINE VARIABLE l_prev AS LOGICAL   NO-UNDO.
      352     DO ON ERROR UNDO, RETURN ERROR :
      353       ASSIGN  Word   = STRING( ABS( p-sum ), "999999999999999999999999999999.99":U )
      354               jj     = LENGTH( Word )
      355               j_last = INTEGER( SUBSTRING( Word, jj,     1 ) )
      356               l_prev =        ( SUBSTRING( Word, jj - 1, 1 ) = "1" ).
      357       IF           j_last = 1                THEN DO:
      358         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейка" ).
      359       END. ELSE IF j_last > 1 AND j_last < 5 THEN DO:
      360         ASSIGN p-kop = ( IF l_prev = YES THEN "копеек" ELSE "копейки" ).
      361       END.                                   ELSE DO:
      362         ASSIGN p-kop = "копеек".
      363       END.
      364     END.
      365   END PROCEDURE.
      366   FUNCTION get-decade-word RETURNS CHARACTER ( INPUT i-dec AS INTEGER, INPUT i-num AS INTEGER ) :
      367     DEFINE VARIABLE v-grade AS CHARACTER NO-UNDO.
      368     RUN get-number-grade IN THIS-PROCEDURE ( INPUT i-dec, INPUT i-num, OUTPUT v-grade ) NO-ERROR.
      369     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-grade ).
      370   END FUNCTION.
      371   FUNCTION Word-Sum RETURNS CHARACTER ( INPUT i-sum AS DECIMAL ) :
      372     DEFINE VARIABLE OutSum AS CHARACTER NO-UNDO.
      373     RUN conv-sum-to-word IN THIS-PROCEDURE ( INPUT i-sum, OUTPUT OutSum ) NO-ERROR.
      374     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE OutSum ).
      375   END FUNCTION.
      376   PROCEDURE get-number-grade :
      377     DEFINE  INPUT PARAMETER p-dec AS INTEGER   NO-UNDO.
      378     DEFINE  INPUT PARAMETER p-num AS INTEGER   NO-UNDO.
      379     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      380     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO.
      381     DO ON ERROR UNDO, RETURN ERROR :
      382       IF      p-dec = 1 THEN DO: ASSIGN v-list = ",один,два,три,четыре,пять,шесть,семь,восемь,девять".    END.
      383       ELSE IF p-dec = 2 THEN DO: ASSIGN v-list = "десять,одиннадцать,двенадцать,тринадцать,четырнадцать,пятнадцать,шестнадцать,семнадцать,восемнадцать,девятнадцать".    END.
      384       ELSE IF p-dec = 3 THEN DO: ASSIGN v-list = ",,двадцать,тридцать,сорок,пятьдесят,шестьдесят,семьдесят,восемьдесят,девяносто".   END.
      385       ELSE IF p-dec = 4 THEN DO: ASSIGN v-list = ",сто,двести,триста,четыреста,пятьсот,шестьсот,семьсот,восемьсот,девятьсот".  END.
      386                         ELSE DO: ASSIGN v-list = ",,,,,,,,,". END.
      387       ASSIGN p-res = ENTRY( p-num + 1, v-list ).
      388     END.
      389   END PROCEDURE.
      390   PROCEDURE conv-sum-to-word :
      391     DEFINE  INPUT PARAMETER p-sum AS DECIMAL   NO-UNDO.
      392     DEFINE OUTPUT PARAMETER p-res AS CHARACTER NO-UNDO.
      393     DEFINE VARIABLE Formatted  AS CHARACTER NO-UNDO.
      394     DEFINE VARIABLE Word       AS CHARACTER NO-UNDO.
      395     DEFINE VARIABLE OutSum     AS CHARACTER NO-UNDO.
      396     DEFINE VARIABLE jj         AS INTEGER   NO-UNDO.
      397     DO ON ERROR UNDO, RETURN ERROR :
      398       ASSIGN Formatted = STRING( ABS( p-sum ), "999999999999999.99":U ) NO-ERROR.
      399       IF ERROR-STATUS :ERROR THEN DO:
      400         ASSIGN p-res = ?.
      401         UNDO, RETURN ERROR.
      402       END.
      403       DO jj = ( LENGTH( Formatted ) - 3 ) TO 3 BY -3 :
      404         IF SUBSTRING( Formatted, jj - 2, 3 ) = "000" THEN DO: NEXT. END.
      405         IF jj < 15 THEN DO:
      406           ASSIGN Word = ENTRY( jj, ",,триллион,,,миллиард,,,миллион,,,тысяч" ).
      407           IF SUBSTRING( Formatted, jj,     1 )  = "1" AND
      408              SUBSTRING( Formatted, jj - 1, 1 ) <> "1" AND jj = 12 THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      409           IF SUBSTRING( Formatted, jj, 1 ) = "2" OR
      410              SUBSTRING( Formatted, jj, 1 ) = "3" OR
      411              SUBSTRING( Formatted, jj, 1 ) = "4" THEN DO:
      412             IF jj = 12 THEN DO:
      413               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "и". END.
      414             END.       ELSE DO:
      415               IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO: ASSIGN Word = TRIM( Word ) + "а". END.
      416             END.
      417           END.
      418           IF ( SUBSTRING( Formatted, jj,     1 ) <> "1" AND
      419                SUBSTRING( Formatted, jj,     1 ) <> "2" AND
      420                SUBSTRING( Formatted, jj,     1 ) <> "3" AND
      421                SUBSTRING( Formatted, jj,     1 ) <> "4" AND jj <> 12 ) OR
      422              ( SUBSTRING( Formatted, jj - 1, 1 )  = "1" AND jj <  12 ) THEN DO: ASSIGN Word = TRIM( Word ) + "ов". END.
      423           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      424         END.
      425         IF SUBSTRING( Formatted, jj - 1, 1 ) <> "1" THEN DO:
      426           IF      jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "1" THEN DO: ASSIGN Word = "одна". END.
      427           ELSE IF jj = 12 AND SUBSTRING( Formatted, jj, 1 ) = "2" THEN DO: ASSIGN Word = "две".  END.
      428           ELSE DO: ASSIGN Word = get-decade-word( 1, INTEGER( SUBSTRING( Formatted, jj, 1 ) ) ). END.
      429           IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      430           ASSIGN Word = get-decade-word( 3, INTEGER( SUBSTRING( Formatted, jj - 1, 1 ) ) ).
      431         END.                                        ELSE DO:
      432           ASSIGN Word = get-decade-word( 2, INTEGER( SUBSTRING( Formatted, jj,     1 ) ) ).
      433         END.
      434         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      435         ASSIGN Word = get-decade-word( 4, INTEGER( SUBSTRING( Formatted, jj - 2, 1 ) ) ).
      436         IF Word <> "":U THEN DO: ASSIGN OutSum = TRIM( Word ) + " ":U + TRIM( OutSum ). END.
      437       END.
      438       ASSIGN OutSum = CAPS( SUBSTRING( OutSum, 1, 1 ) ) + SUBSTRING( OutSum, 2 ).
      439       IF OutSum = "":U AND TRUNCATE( p-sum, 0 ) = 0 THEN DO: ASSIGN OutSum = "Ноль". END.
      440       ASSIGN p-res = TRIM( OutSum ).
      441     END.
      442   END PROCEDURE.
      443   FUNCTION Total-Word RETURNS CHARACTER ( INPUT i-sum AS DECIMAL, INPUT i-curr AS CHARACTER, INPUT i-part AS CHARACTER ) :
      444     DEFINE VARIABLE word_sum AS CHARACTER NO-UNDO.
      445     RUN get-total-word IN THIS-PROCEDURE ( INPUT i-sum, INPUT i-curr, INPUT i-part, OUTPUT word_sum ) NO-ERROR.
      446     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE word_sum ).
      447   END FUNCTION.
      448   PROCEDURE get-total-word :
      449     DEFINE  INPUT PARAMETER p-sum  AS DECIMAL   NO-UNDO.
      450     DEFINE  INPUT PARAMETER p-curr AS CHARACTER NO-UNDO.
      451     DEFINE  INPUT PARAMETER p-part AS CHARACTER NO-UNDO.
      452     DEFINE OUTPUT PARAMETER p-word AS CHARACTER NO-UNDO.
      453     DO ON ERROR UNDO, RETURN ERROR :
      454       ASSIGN p-word = Word-Sum( p-sum ).
      455                  ASSIGN p-word = ( IF p-sum < 0 THEN "- " ELSE "":U ) + TRIM(
      456                         RedLine( p-word )
      457                  ) +
      458                         " ":U + p-curr + " ":U +
      459                         SUBSTRING( STRING( ABS( p-sum ), "999999999999999999999999999999.99" ), 32, 2 ) +
      460                         " ":U + p-part + ".".
      461                           END.
      462   END PROCEDURE.
