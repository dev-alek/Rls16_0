      464         function invlnsum_sale-price returns decimal ( input p-doc-code   as character,
      465                                                          input p-artic      as character,
      466                                                          input p-prod-type  as character,
      467                                                          input p-prod-code  as integer,
      468                                                          input p-print-rubl as logical    ) :
      469           define variable d_out-kg-sale-price as decimal no-undo initial ?.
