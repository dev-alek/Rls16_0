     1468   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1469   define variable acc-count-ln as integer no-undo .
     1470   define variable acc-count-step as integer no-undo .
     1471   define variable acc-day-base as decimal no-undo .
     1472   define variable acc-day-rubl as decimal no-undo .
     1473   define variable acc-day-cnt  as integer no-undo .
     1474   define variable acc-day-nf   as integer no-undo .
     1475   define variable acc-desk-rubl  as decimal no-undo .
     1476   define variable acc-desk-base  as decimal no-undo .
     1477   define variable acc-desk-count as integer no-undo .
     1478   define variable acc-desk-count-nf as integer no-undo .
