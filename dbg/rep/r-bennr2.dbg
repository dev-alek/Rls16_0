     1494   procedure cur-time :
     1495      define output parameter p-today as date      no-undo .
     1496      define output parameter p-time  as integer   no-undo .
     1497     do
     1498     on error undo, return error
     1499     :
     1500       define variable v-date1 as date      no-undo .
     1501       define variable v-date2 as date      no-undo .
     1502       define variable v-time  as integer   no-undo .
     1503       assign
     1504         v-date1 = today
     1505         v-time  = time
     1506         v-date2 = today
     1507       .
     1508       if v-date1 <> v-date2
     1509       then do:
     1510         assign
     1511           v-date1 = today
     1512           v-time  = v-time
     1513         .
     1514       end.
     1515       assign
     1516         p-today = v-date1
     1517         p-time  = v-time
     1518       .
     1519     end.
     1520   end.
     1521   function cur-time-date returns character
     1522   :
     1523     return string(today, '99/99/9999':U) .
     1524   end.
     1525   function cur-time-mjd returns decimal
     1526   :
     1527     define variable v-date as date      no-undo .
     1528     define variable v-time as integer   no-undo .
     1529     run cur-time in this-procedure
     1530       (output v-date
     1531       ,output v-time
     1532       ) .
     1533     return integer(v-date) - 2400002 + (v-time / 86400) .
     1534   end.
     1535   function cur-time-get-ending-index returns integer
     1536   (input p-number as integer
     1537   )
     1538   :
     1539     if p-number < 0
     1540     or p-number = ?
     1541     then do:
     1542       return 1 .
     1543     end.
     1544     define variable v-rest as integer   no-undo .
     1545     assign
     1546       p-number = p-number modulo 100
     1547     .
     1548     if p-number < 20
     1549     then do:
     1550       assign
     1551         v-rest = p-number
     1552       .
     1553     end.
     1554     else do:
     1555       assign
     1556         v-rest = p-number modulo 10
     1557       .
     1558     end.
     1559     case v-rest :
     1560       when 1
     1561       then do:
     1562         return 2 .
     1563       end.
     1564       when 2 or
     1565       when 3 or
     1566       when 4
     1567       then do:
     1568         return 3 .
     1569       end.
     1570       otherwise do:
     1571         return 1 .
     1572       end.
     1573     end case .
     1574   end.
     1575   procedure cur-time-mjd-to-date :
     1576      define input  parameter i-mjd-diff as decimal no-undo.
     1577      define output parameter o-Date     as date    no-undo.
     1578      define output parameter o-Time     as integer no-undo.
     1579      define variable v-day-number as integer   no-undo .
     1580      if    i-mjd-diff < 0
     1581         or i-mjd-diff = ?
     1582      then do:
     1583         return "?" .
     1584      end.
     1585      assign
     1586         v-day-number = truncate(i-mjd-diff,0).
     1587         o-Date = date(v-day-number + 2400002).
     1588         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1589     .
     1590   end.
     1591   function cur-time-mjd-to-string returns character
     1592   (input p-mjd-diff as decimal
     1593   )
     1594   :
     1595     define variable v-day-number as integer   no-undo .
     1596     define variable v-seconds    as integer   no-undo .
     1597     define variable v-hour       as integer   no-undo .
     1598     define variable v-min        as integer   no-undo .
     1599     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1600     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1601     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1602     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1603     if p-mjd-diff < 0
     1604     or p-mjd-diff = ?
     1605     then do:
     1606       return "?" .
     1607     end.
     1608     assign
     1609       v-day-number = integer(truncate(p-mjd-diff,0))
     1610       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1611     .
     1612     if v-seconds > 86400
     1613     then do:
     1614       assign
     1615         v-seconds = 86400 - 1
     1616       .
     1617     end.
     1618     if v-seconds < 0
     1619     then do:
     1620       assign
     1621         v-seconds = 0
     1622       .
     1623     end.
     1624     assign
     1625       v-hour = truncate(v-seconds / 3600, 0)
     1626     .
     1627     assign
     1628       v-seconds = v-seconds modulo 3600
     1629     .
     1630     assign
     1631       v-min = truncate(v-seconds / 60, 0)
     1632     .
     1633     assign
     1634       v-seconds = v-seconds modulo 60
     1635     .
     1636     return
     1637         (if v-day-number <> 0
     1638           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1639           else ""
     1640         )
     1641       + (if v-day-number <> 0 or v-hour <> 0
     1642           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1643           else ""
     1644         )
     1645       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1646           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1647           else ""
     1648         )
     1649       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1650       .
     1651   end.
     1652   function cur-time-string returns character
     1653   :
     1654     define variable v-date as date      no-undo .
     1655     define variable v-time as integer   no-undo .
     1656     run cur-time in this-procedure
     1657       (output v-date
     1658       ,output v-time
     1659       ) .
     1660     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1661   end.
     1662   function cur-time-string-sec returns character
     1663   :
     1664     define variable v-date as date      no-undo .
     1665     define variable v-time as integer   no-undo .
     1666     run cur-time in this-procedure
     1667       (output v-date
     1668       ,output v-time
     1669       ) .
     1670     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1671   end.
     1672   function cur-time-custom  returns character
     1673   (input p-prefix as character
     1674   ,input p-date-format as character
     1675   ,input p-delimiter as character
     1676   ,input p-time-format as character
     1677   ,input p-suffix as character
     1678   )
     1679   :
     1680     define variable v-date as date      no-undo .
     1681     define variable v-time as integer   no-undo .
     1682     run cur-time in this-procedure
     1683       (output v-date
     1684       ,output v-time
     1685       ) .
     1686     return
     1687       p-prefix
     1688       + string(v-date, p-date-format)
     1689       + p-delimiter
     1690       + string(v-time, p-time-format)
     1691       + p-suffix
     1692       .
     1693   end.
     1694   function cur-time-print  returns character
     1695   :
     1696     define variable v-date as date      no-undo .
     1697     define variable v-time as integer   no-undo .
     1698     run cur-time in this-procedure
     1699       (output v-date
     1700       ,output v-time
     1701       ) .
     1702     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1703   end.
     1704   function cur-time-datetime returns datetime
     1705   :
     1706     define variable v-char as character no-undo .
     1707     define variable v-datetime as datetime no-undo .
     1708     v-char = cur-time-string().
     1709     v-datetime = datetime(v-char).
     1710     return  v-datetime.
     1711   end.
     1712   function cur-time-string-msec returns character
     1713   :
     1714     define variable v-date as datetime  no-undo .
     1715     v-date = now.
     1716     return string(v-date) .
     1717   end.
     1718   function fnc-convert-dot-to-colon returns character
     1719       (input p-data as decimal, input p-accur as character, input p-num as integer) forward.
     1720   function fnc-convert-dot-to-colon returns character
     1721   (input p-data as decimal, input p-accur as character, input p-num as integer):
     1722       define variable result as character no-undo.
     1723       define variable v-str-result as character no-undo.
     1724       if p-data = ? then p-data = 0 .
     1725       p-data = round(p-data, p-num).
     1726       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     1727       return v-str-result.
     1728   END FUNCTION.
     1729   function putRowAmount1 returns character private
     1730   (input p-curr-name as character
     1731   ,input p-total1    as decimal
     1732   ) :
     1733   define variable v-row-amount as character no-undo .
     1734   define variable v-curr-name  as character no-undo .
     1735     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1736     v-row-amount = substitute (
     1737         '<td>&1</td><td num="0.00" val="&2">&2</td><td><br /></td><td><br /></td>'
     1738         , v-curr-name
     1739         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1740     ) .
     1741     return v-row-amount .
     1742   end function .
     1743   function putRowAmount returns character private
     1744   (input p-curr-name as character
     1745   ,input p-total1    as decimal
     1746   ,input p-total2    as decimal
     1747   ,input p-total3    as decimal
     1748   ) :
     1749   define variable v-row-amount as character no-undo .
     1750   define variable v-curr-name  as character no-undo .
     1751     v-curr-name = if p-curr-name > "" then p-curr-name else "<br />":U .
     1752     v-row-amount = substitute (
     1753         '<td>&1</td><td num="0.00" val="&2">&2</td><td num="0.00" val="&3">&3</td><td num="0.00" val="&4">&4</td>'
     1754         , v-curr-name
     1755         , fnc-convert-dot-to-colon(p-total1, "->>>>>>>>>>>9.99", 2)
     1756         , fnc-convert-dot-to-colon(p-total2, "->>>>>>>>>>>9.99", 2)
     1757         , fnc-convert-dot-to-colon(p-total3, "->>>>>>>>>>>9.99", 2)
     1758     ) .
     1759     return v-row-amount .
     1760   end function .
     1761   procedure CreateBenefits2 private :
     1762   define input parameter p-obj-type  as character no-undo .
     1763   define input parameter p-obj-code  as integer no-undo .
     1764   define input parameter p-pay-code  as integer no-undo .
     1765   define input parameter p-curr-code as integer no-undo .
     1766   define input parameter p-pay-desk  as integer no-undo .
     1767   define input parameter p-sum       as decimal no-undo .
     1768   define input parameter p-base      as decimal no-undo .
     1769   define input parameter p-rubl      as decimal no-undo .
     1770   define buffer buf_benefits for benefits .
     1771   define buffer buf_cash-pay for ub.cash-pay .
     1772   define buffer buf_currency for ub.currency .
     1773     find first buf_benefits
     1774          where buf_benefits.obj-type  = p-obj-type
     1775            and buf_benefits.obj-code  = p-obj-code
     1776            and buf_benefits.pay-code  = p-pay-code
     1777            and buf_benefits.curr-code = p-curr-code
     1778     and buf_benefits.pay-desk  = p-pay-desk no-error .
     1779     if not available buf_benefits then do:
     1780       FIND FIRST buf_cash-pay NO-LOCK
     1781            WHERE buf_cash-pay.cdpay-code = p-pay-code
     1782              AND buf_cash-pay.curr-code  = p-curr-code NO-ERROR.
     1783       FIND FIRST buf_currency NO-LOCK
     1784            WHERE buf_currency.curr-code = p-curr-code NO-ERROR.
     1785       create buf_benefits.
     1786       assign
     1787         buf_benefits.pay-desk  = p-pay-desk
     1788         buf_benefits.obj-type  = p-obj-type
     1789         buf_benefits.obj-code  = p-obj-code
     1790         buf_benefits.pay-code  = p-pay-code
     1791         buf_benefits.pay-name  = if available buf_cash-pay then buf_cash-pay.obj-name  else "Неопознанная оплата"
     1792         buf_benefits.curr-code = p-curr-code
     1793         buf_benefits.curr-name = if available buf_currency then buf_currency.curr-name else "Неопознанная валюта"
     1794         buf_benefits.tot-sum   = p-sum
     1795         buf_benefits.tot-base  = p-base
     1796         buf_benefits.tot-rubl  = p-rubl
     1797       .
     1798     end .
     1799     else assign
     1800       buf_benefits.tot-sum  = buf_benefits.tot-sum  + p-sum
     1801       buf_benefits.tot-base = buf_benefits.tot-base + p-base
     1802       buf_benefits.tot-rubl = buf_benefits.tot-rubl + p-rubl
     1803     .
     1804   end procedure .
     1805   empty temp-table benefits .
     1806   empty temp-table inkas-num .
     1807   empty temp-table day_sum .
     1808   empty temp-table all-days_sum .
     1809   empty temp-table ben-chk-count .
     1810   assign
     1811   date_string = cur-time-print()
     1812   .
     1813   assign
     1814   ChkAmount = 0
     1815   ObjAmount = 0
     1816   AllDay-BaseSum = 0
     1817   AllDay-RublSum = 0
     1818     acc-count-ln = 0
     1819     acc-count-step = 0
     1820   .
     1821   FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     1822     ACCUMULATE obj-list.obj-code ( COUNT ).
     1823     assign
     1824     acc-day-base = 0
     1825     acc-day-rubl = 0
     1826     acc-day-cnt = 0
     1827     acc-day-nf  = 0
     1828     .
     1829     CASE X-radio-Task > 1 :
     1830       WHEN YES THEN DO:
     1831         _chk-doc3:
     1832         FOR EACH chk-doc WHERE
     1833                   chk-doc.obj-type = obj-list.obj-type AND
     1834                 chk-doc.obj-code = obj-list.obj-code AND
     1835                 chk-doc.shift-date >= x-date-start AND
     1836                 chk-doc.shift-date <= x-date-end AND
     1837                 (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1838         BREAK
     1839         by chk-doc.obj-type
     1840         by chk-doc.obj-code
     1841         by chk-doc.pay-desk :
     1842           IF FIRST-OF(chk-doc.pay-desk) then assign
     1843             acc-desk-rubl = 0
     1844             acc-desk-base = 0
     1845             acc-desk-count = 0
     1846             acc-desk-count-nf = 0
     1847           .
     1848           v-skip-line =
     1849           (
     1850                X-Radio-task = 3 AND
     1851                ((chk-doc.shift-date = x-date-start AND chk-doc.shift-num < X-shift-start) OR
     1852                 (chk-doc.shift-date = x-date-end   AND chk-doc.shift-num > X-shift-end))
     1853           ) OR (
     1854                X-radio-task = 4 AND
     1855                chk-doc.shift-num <> X-Shift-Alone
     1856           ) .
     1857           if not v-skip-line then do :
     1858             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1859             found = false .
     1860             if v-is-sub-count then do :
     1861               for EACH chk-pay NO-LOCK
     1862                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1863                 if chk-pay.tot-sum <> 0 then do :
     1864                   found = true .
     1865                   leave .
     1866                 end .
     1867               END .
     1868             end .
     1869             else do :
     1870               for EACH chk-pay NO-LOCK
     1871                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1872               BREAK
     1873               BY chk-pay.pay-code
     1874               BY chk-pay.curr-code:
     1875                 if chk-pay.tot-sum <> 0 then do :
     1876                   found = true .
     1877   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1878           acc-count-ln = acc-count-ln + 1.
     1879   if acc-count-ln > acc-count-step then do:
     1880     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1881                                     ", обработано строк чеков : " +
     1882                                     string( ACC-count-ln) ) .
     1883     acc-count-step = acc-count-ln + 96 .
     1884   end.
     1885           if FIRST-of( chk-pay.curr-code ) then assign
     1886             acc-curr-sum  = 0
     1887             acc-curr-base = 0
     1888             acc-curr-rubl = 0
     1889           .
     1890         assign
     1891             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     1892             acc-curr-base = acc-curr-base + chk-pay.tot-base
     1893             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     1894             acc-desk-base = acc-desk-base + chk-pay.tot-base
     1895             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     1896         .
     1897   if last-of( chk-pay.curr-code ) then do:
     1898     run CreateBenefits2 in this-procedure
     1899     ( obj-list.obj-type
     1900     , obj-list.obj-code
     1901     , chk-pay.pay-code
     1902     , chk-pay.curr-code
     1903     , chk-doc.pay-desk
     1904     , acc-curr-sum
     1905     , acc-curr-base
     1906     , acc-curr-rubl
     1907     ) .
     1908     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     1909                                            and ben-chk-count.obj-type  = obj-list.obj-type
     1910                                            and ben-chk-count.obj-code  = obj-list.obj-code
     1911                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     1912                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     1913                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     1914       create ben-chk-count.
     1915       assign
     1916         ben-chk-count.doc-code  = chk-pay.doc-code
     1917         ben-chk-count.obj-type  = obj-list.obj-type
     1918         ben-chk-count.obj-code  = obj-list.obj-code
     1919         ben-chk-count.pay-desk  = chk-doc.pay-desk
     1920         ben-chk-count.pay-code  = chk-pay.pay-code
     1921         ben-chk-count.curr-code = chk-pay.curr-code
     1922       .
     1923     end.
     1924   end.
     1925                 end .
     1926               END .
     1927             end .
     1928             if found then assign
     1929               acc-desk-count    = acc-desk-count    + 1
     1930               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     1931             .
     1932           end .
     1933           if last-of( chk-doc.pay-desk ) then do:
     1934             create day_sum.
     1935             assign
     1936               day_sum.obj-type = obj-list.obj-type
     1937               day_sum.obj-code = obj-list.obj-code
     1938               day_sum.pay-desk = chk-doc.pay-desk
     1939               day_sum.tot-rubl = acc-desk-rubl
     1940               day_sum.tot-base = acc-desk-base
     1941               day_sum.chk-cnt-all =  acc-desk-count
     1942               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     1943             .
     1944             assign
     1945               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     1946               acc-day-base = acc-day-base + day_sum.tot-base
     1947               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     1948               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     1949             .
     1950           end.
     1951         END.
     1952       END.
     1953       WHEN NO THEN DO:
     1954         _chk-doc4:
     1955         FOR EACH chk-doc WHERE
     1956                     chk-doc.obj-type = obj-list.obj-type AND
     1957                   chk-doc.obj-code = obj-list.obj-code AND
     1958                   chk-doc.chk-date >= x-date-start AND
     1959                   chk-doc.chk-date <= x-date-end AND
     1960                   (IF cas-num > 0 then chk-doc.pay-desk = cas-num else TRUE) NO-LOCK
     1961           BREAK
     1962           by chk-doc.obj-type
     1963           by chk-doc.obj-code
     1964           by chk-doc.pay-desk :
     1965           IF FIRST-OF(chk-doc.pay-desk) then assign
     1966             acc-desk-rubl = 0
     1967             acc-desk-base = 0
     1968             acc-desk-count = 0
     1969             acc-desk-count-nf = 0
     1970           .
     1971           v-skip-line = false .
     1972           if not v-skip-line then do :
     1973             v-is-sub-count = (  lookup(string(chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0  ).
     1974             found = false .
     1975             if v-is-sub-count then do :
     1976               for EACH chk-pay NO-LOCK
     1977                  WHERE chk-pay.doc-code = chk-doc.doc-code :
     1978                 if chk-pay.tot-sum <> 0 then do :
     1979                   found = true .
     1980                   leave .
     1981                 end .
     1982               END .
     1983             end .
     1984             else do :
     1985               for EACH chk-pay NO-LOCK
     1986                  WHERE chk-pay.doc-code = chk-doc.doc-code
     1987               BREAK
     1988               BY chk-pay.pay-code
     1989               BY chk-pay.curr-code:
     1990                 if chk-pay.tot-sum <> 0 then do :
     1991                   found = true .
     1992   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1993           acc-count-ln = acc-count-ln + 1.
     1994   if acc-count-ln > acc-count-step then do:
     1995     run waitfram-show in this-procedure ( obj-list.obj-type + string( obj-list.obj-code ) +
     1996                                     ", обработано строк чеков : " +
     1997                                     string( ACC-count-ln) ) .
     1998     acc-count-step = acc-count-ln + 96 .
     1999   end.
     2000           if FIRST-of( chk-pay.curr-code ) then assign
     2001             acc-curr-sum  = 0
     2002             acc-curr-base = 0
     2003             acc-curr-rubl = 0
     2004           .
     2005         assign
     2006             acc-curr-sum  = acc-curr-sum  + chk-pay.tot-sum
     2007             acc-curr-base = acc-curr-base + chk-pay.tot-base
     2008             acc-curr-rubl = acc-curr-rubl + chk-pay.tot-rubl
     2009             acc-desk-base = acc-desk-base + chk-pay.tot-base
     2010             acc-desk-rubl = acc-desk-rubl + chk-pay.tot-rubl
     2011         .
     2012   if last-of( chk-pay.curr-code ) then do:
     2013     run CreateBenefits2 in this-procedure
     2014     ( obj-list.obj-type
     2015     , obj-list.obj-code
     2016     , chk-pay.pay-code
     2017     , chk-pay.curr-code
     2018     , chk-doc.pay-desk
     2019     , acc-curr-sum
     2020     , acc-curr-base
     2021     , acc-curr-rubl
     2022     ) .
     2023     if not can-find (first ben-chk-count where ben-chk-count.doc-code  = chk-pay.doc-code
     2024                                            and ben-chk-count.obj-type  = obj-list.obj-type
     2025                                            and ben-chk-count.obj-code  = obj-list.obj-code
     2026                                            and ben-chk-count.pay-desk  = chk-doc.pay-desk
     2027                                            and ben-chk-count.pay-code  = chk-pay.pay-code
     2028                                            and ben-chk-count.curr-code = chk-pay.curr-code) then do:
     2029       create ben-chk-count.
     2030       assign
     2031         ben-chk-count.doc-code  = chk-pay.doc-code
     2032         ben-chk-count.obj-type  = obj-list.obj-type
     2033         ben-chk-count.obj-code  = obj-list.obj-code
     2034         ben-chk-count.pay-desk  = chk-doc.pay-desk
     2035         ben-chk-count.pay-code  = chk-pay.pay-code
     2036         ben-chk-count.curr-code = chk-pay.curr-code
     2037       .
     2038     end.
     2039   end.
     2040                 end .
     2041               END .
     2042             end .
     2043             if found then assign
     2044               acc-desk-count    = acc-desk-count    + 1
     2045               acc-desk-count-nf = acc-desk-count-nf + 1 when (v-is-sub-count)
     2046             .
     2047           end .
     2048           if last-of( chk-doc.pay-desk ) then do:
     2049             create day_sum.
     2050             assign
     2051               day_sum.obj-type = obj-list.obj-type
     2052               day_sum.obj-code = obj-list.obj-code
     2053               day_sum.pay-desk = chk-doc.pay-desk
     2054               day_sum.tot-rubl = acc-desk-rubl
     2055               day_sum.tot-base = acc-desk-base
     2056               day_sum.chk-cnt-all =  acc-desk-count
     2057               day_sum.chk-cnt-nf  =  acc-desk-count-nf
     2058             .
     2059             assign
     2060               acc-day-rubl = acc-day-rubl + day_sum.tot-rubl
     2061               acc-day-base = acc-day-base + day_sum.tot-base
     2062               acc-day-cnt  = acc-day-cnt  + day_sum.chk-cnt-all
     2063               acc-day-nf   = acc-day-nf   + day_sum.chk-cnt-nf
     2064             .
     2065           end.
     2066         END.
     2067       END.
     2068     END CASE.
     2069     CREATE all-days_sum .
     2070     assign
     2071       all-days_sum.obj-type = obj-list.obj-type
     2072       all-days_sum.obj-code = obj-list.obj-code
     2073       all-days_sum.tot-base = acc-day-base
     2074       all-days_sum.tot-rubl = acc-day-rubl
     2075       all-days_sum.chk-cnt-all  = acc-day-cnt
     2076       all-days_sum.chk-cnt-nf   = acc-day-nf
     2077     .
     2078     assign
     2079       AllDay-BaseSum = AllDay-BaseSum + acc-day-base
     2080       AllDay-RublSum = AllDay-RublSum + acc-day-rubl
     2081       ObjAmount      = ObjAmount + 1
     2082       ChkAmount      = ChkAmount + (all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf)
     2083     .
     2084   END.
     2085   if not can-find (first benefits) then do:
     2086     message "Не было никакой выручки на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2087     return.
     2088   end.
     2089   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2090   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2091     (output v-curr-r-b
     2092     )  .
     2093   if v-curr-r-b = 'base':U then do:
     2094   sale-price-type = "рублей".
     2095   end.
     2096   else sale-price-type = "рублей".
     2097   for each benefits :
     2098     benefits.tot-r-b = if v-curr-r-b = 'base':U then benefits.tot-base else benefits.tot-rubl .
     2099   end .
     2100   for each day_sum :
     2101     day_sum.tot-r-b = if v-curr-r-b = 'base':U then day_sum.tot-base else day_sum.tot-rubl .
     2102   end .
     2103   for each all-days_sum :
     2104     all-days_sum.tot-r-b = if v-curr-r-b = 'rubl':U then all-days_sum.tot-rubl else all-days_sum.tot-base .
     2105   end .
     2106   run waitfram-hide in this-procedure .
     2107       run prn-lib-get-report-name  in this-procedure (
     2108                                                          input parParentProc
     2109                                                         ,output v-report-name
     2110                                                       ).
     2111     assign
     2112       v-file-name-rep-htm = v-report-name + ".html"
     2113       v-vsex-cas = IF cas-num = 0 then "ВСЕХ КАСС" ELSE ("КАССЫ " + string(cas-num))
     2114       v-avg-chk  = if ChkAmount > 0 then round(
     2115         (if v-curr-r-b = 'rubl':U then AllDay-RublSum else AllDay-BaseSum)  /  ChkAmount
     2116                                                , 2 ) else 0
     2117     .
     2118     v-times = "" .
     2119     IF T-time then
     2120       FOR EACH times No-LOCK :
     2121         v-times = v-times + times + chr(32) .
     2122       END .
     2123   do :
     2124     output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     2125     put stream OutStr-html unformatted
     2126       "<!DOCTYPE HTML>" skip
     2127       '<html>' skip
     2128       '<head>' skip
     2129       '  <meta charset="utf-8">' skip
     2130       '  <style type="text/css">' skip
     2131       '      table ~{border-collapse: collapse~;~}' skip
     2132       '      tbody td, th ~{border: 1px solid black~; height: 14px~;}' skip
     2133       '      tbody td:nth-child(4), tbody td:nth-child(5), tbody td:nth-child(6) ~{text-align: right~; padding-right: 4px~;~}' skip
     2134       '      tfoot td ~{height: 14px~;}' skip
     2135       '      .sumtotal ~{text-align: right~; padding-right: 4px~;~}' skip
     2136       '  </style>' skip
     2137       '</head>' skip
     2138       '<body>' skip
     2139       '<TABLE name="1" fit_to_page="true" orientation="portrait">' skip
     2140       '<thead>' skip
     2141       '  <tr>' skip
     2142       '    <td style="width:  35px;"></td>' skip
     2143       '    <td style="width: 124px;"></td>' skip
     2144       '    <td style="width: 31px;"></td>' skip
     2145       '    <td style="width: 71px;"></td>' skip
     2146       '    <td style="width: 63px;"></td>' skip
     2147       '    <td style="width: 63px;"></td>' skip
     2148       '    <td style="width: 49px;"></td>' skip
     2149       '    <td style="width: 41px;"></td>' skip
     2150       '  </tr>' skip
     2151       '  <tr>' skip
     2152       '    <td colspan="8">' + date_string + '</td>' skip
     2153       '  </tr>' skip
     2154       '  <tr>' skip
     2155       '    <td colspan="8">ОТЧЕТ  О  ВЫРУЧКЕ ' + str1
     2156            + '<br />' + str4
     2157            + '<br />( сформирован по ВСЕМ ЧЕКАМ '
     2158            + (IF NotInc then v-vsex-cas + ", включая невошедшие в отчеты о продажах" else v-vsex-cas)
     2159            + ' )'
     2160            + '<br />'
     2161            + substitute("( всего чеков : &1, в среднем &2 &3 / чек )",  ChkAmount,  v-avg-chk,  sale-price-type  )
     2162            + '</td>' skip
     2163       '  </tr>' skip
     2164     .
     2165     IF T-time then do:
     2166       put stream OutStr-html unformatted
     2167         '  <tr>' skip
     2168         '    <td colspan="7">Выборочно по времени: '
     2169            + v-times
     2170            + '</td>' skip
     2171         '  </tr>' skip
     2172       .
     2173     end.
     2174     put stream OutStr-html unformatted
     2175       '</thead>' skip
     2176       '<tbody>' skip
     2177       '  <tr>' skip
     2178       '    <th>Касса</th>' skip
     2179       '    <th>Вид оплаты</th>' skip
     2180       '    <th></th>' skip
     2181       '    <th>Сумма в рублях</th>' skip
     2182       '    <th></th>' skip
     2183       '    <th></th>' skip
     2184       '    <th>~% от суммы</th>' skip
     2185       '    <th>Кол-во фиск. чеков</th>' skip
     2186       '  </tr>' skip
     2187     .
     2188   end .
     2189   FOR EACH obj-list WHERE
     2190             obj-list.obj-type = 'маг':U ,
     2191       EACH all-days_sum WHERE
     2192             all-days_sum.obj-type = obj-list.obj-type AND
     2193             all-days_sum.obj-code = obj-list.obj-code
     2194   BREAK
     2195   BY obj-list.obj-type
     2196   BY obj-list.obj-code :
     2197     ACCUMULATE
     2198     all-days_sum.tot-base ( TOTAL )
     2199     all-days_sum.tot-rubl ( TOTAL )
     2200     all-days_sum.tot-r-b ( TOTAL )
     2201     all-days_sum.chk-cnt-all ( TOTAL )
     2202     all-days_sum.chk-cnt-nf  ( TOTAL )
     2203     obj-list.obj-code ( COUNT ) .
     2204       if first-of( obj-list.obj-code ) then do:
     2205         FIND FIRST clients WHERE
     2206                      clients.obj-type = obj-list.obj-type  AND
     2207                      clients.obj-code = obj-list.obj-code  NO-LOCK no-error .
     2208         put stream OutStr-html unformatted
     2209             '  <tr><td colspan="8">'
     2210             if available clients then clients.obj-name else '<br />'
     2211             '</td></tr>'
     2212         .
     2213       end.
     2214     FOR EACH benefits WHERE
     2215                 benefits.obj-type = obj-list.obj-type AND
     2216                 benefits.obj-code = obj-list.obj-code
     2217     BREAK
     2218     BY benefits.obj-type
     2219     BY benefits.obj-code
     2220     BY benefits.pay-desk
     2221     BY benefits.pay-code
     2222     BY benefits.curr-code :
     2223       if first-of( benefits.pay-desk ) then do:
     2224           FIND FIRST day_sum WHERE
     2225                       day_sum.obj-type = obj-list.obj-type AND
     2226                       day_sum.obj-code = obj-list.obj-code AND
     2227                       day_sum.pay-desk = benefits.pay-desk NO-ERROR.
     2228           DatePrinted = FALSE .
     2229       end.
     2230       benefits.pcnt = round( benefits.tot-rubl / day_sum.tot-rubl * 100 , 2 ) .
     2231       if benefits.tot-base  <> 0
     2232       or (day_sum.chk-cnt-all > day_sum.chk-cnt-nf)
     2233       then do:
     2234         if DatePrinted then assign
     2235           v-td-date = '<br />'
     2236         .
     2237         else assign
     2238           v-td-date   = string(benefits.pay-desk)
     2239           DatePrinted = TRUE
     2240         .
     2241         open query qben-chk-count
     2242          preselect each ben-chk-count
     2243                   where ben-chk-count.obj-type  = obj-list.obj-type
     2244                     and ben-chk-count.obj-code  = obj-list.obj-code
     2245                     and ben-chk-count.pay-desk  = benefits.pay-desk
     2246                     and ben-chk-count.pay-code  = benefits.pay-code
     2247                     and ben-chk-count.curr-code = benefits.curr-code.
     2248         v-chk-count = query qben-chk-count:num-results .
     2249         close query qben-chk-count.
     2250         put stream OutStr-html unformatted
     2251           '  <tr>'
     2252           '<td>' + v-td-date + '</td>'
     2253           '<td>' + benefits.pay-name + '</td>'
     2254           putRowAmount1 ("", benefits.tot-rubl)
     2255           substitute(  '<td num="0.00" val="&1">&1</td>',  fnc-convert-dot-to-colon(benefits.pcnt,    "->>9.99",2)  )
     2256           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2257           '</tr>' skip
     2258         .
     2259       end.
     2260       if last-of( benefits.pay-desk ) then do:
     2261         if day_sum.chk-cnt-all > day_sum.chk-cnt-nf then do:
     2262           put stream OutStr-html unformatted
     2263             substitute(  '  <td colspan="3">средн.чек: &1</td>',
     2264               ROUND(day_sum.tot-rubl / (day_sum.chk-cnt-all - day_sum.chk-cnt-nf), 2)  )
     2265             substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(day_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2266             '<td></td>'
     2267             '<td></td>'
     2268             '<td>100.00%</td>'
     2269             substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  day_sum.chk-cnt-all - day_sum.chk-cnt-nf  )
     2270             '</tr>' skip
     2271           .
     2272         end.
     2273       end.
     2274       if last-of( benefits.obj-code ) then do:
     2275         put stream OutStr-html unformatted
     2276           '  <tr><td colspan="3">ИТОГО:</td>'
     2277           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2278           '<td></td>'
     2279           '<td></td>'
     2280           '<td></td>'
     2281           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  all-days_sum.chk-cnt-all - all-days_sum.chk-cnt-nf  )
     2282           '</tr>' skip
     2283         .
     2284       end.
     2285     END.
     2286     if last( obj-list.obj-code ) AND ( ACCUM COUNT obj-list.obj-code ) > 1 then do:
     2287       put stream OutStr-html unformatted
     2288         '  <tr><td colspan="3">ИТОГО по всем</td>'
     2289         substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM TOTAL all-days_sum.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2290         '<td></td>'
     2291         '<td></td>'
     2292         '<td></td>'
     2293         substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',
     2294           (ACCUM TOTAL all-days_sum.chk-cnt-all) - (ACCUM TOTAL all-days_sum.chk-cnt-nf)  )
     2295         '</tr>' skip
     2296       .
     2297     end.
     2298   END.
     2299   if  ObjAmount > 1  then do:
     2300     FOR EACH benefits
     2301     BREAK
     2302     BY benefits.pay-code :
     2303       ACCUMULATE
     2304       benefits.tot-base ( SUB-TOTAL BY benefits.pay-code )
     2305       benefits.tot-rubl ( SUB-TOTAL BY benefits.pay-code )
     2306       benefits.tot-r-b  ( SUB-TOTAL BY benefits.pay-code )
     2307       .
     2308       if last-of( benefits.pay-code ) AND
     2309           ( ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-base ) <> 0 then do:
     2310         open query qben-chk-count
     2311          preselect each ben-chk-count
     2312                   where ben-chk-count.pay-code  = benefits.pay-code.
     2313         v-chk-count = query qben-chk-count:num-results .
     2314         close query qben-chk-count.
     2315         put stream OutStr-html unformatted
     2316           substitute(  '  <tr><td colspan="3">/итого по &1</td>',  benefits.pay-name  )
     2317           substitute(  '<td num="0.00" val="&1" class="sumtotal">&1</td>',  fnc-convert-dot-to-colon(ACCUM SUB-TOTAL BY benefits.pay-code benefits.tot-rubl,"->>>>>>>>>>>9.99",2)  )
     2318           '<td></td>'
     2319           '<td></td>'
     2320           '<td></td>'
     2321           substitute(  '<td num="0" val="&1" class="sumtotal">&1</td>',  v-chk-count  )
     2322           '</tr>' skip
     2323         .
     2324       end.
     2325     END.
     2326   end.
     2327   put stream OutStr-html unformatted
     2328     '</tbody>' skip
     2329     '<tfoot>' skip
     2330   .
     2331   if ( ACCUM COUNT obj-list.obj-code ) < 2 then do:
     2332     put stream OutStr-html unformatted
     2333       '  <tr><td colspan="8"><br /></td></tr>' skip
     2334       '  <tr><td colspan="4">Директор _______________</td><td colspan="4">Старший продавец ______________</td></tr>' skip
     2335       '  <tr><td colspan="8"><br /></td></tr>' skip
     2336       '  <tr><td colspan="4">Бухгалтер ______________</td><td colspan="4">Кассир ________________________</td></tr>' skip
     2337     .
     2338   end.
     2339   put stream OutStr-html unformatted
     2340     '</tfoot>' skip
     2341     '</table>' skip
     2342     '</body>' skip
     2343     '</html>' skip
     2344   .
     2345   output stream OutStr-html close.
     2346   run prn-lib-reportviewer in this-procedure (
     2347       input this-procedure
     2348       ,input v-file-name-rep-htm
     2349       ,input ""
     2350       ) no-error.
     2351   if error-status:error then
     2352   do:
     2353       message return-value view-as alert-box.
     2354       return .
     2355   end.
