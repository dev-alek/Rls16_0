     1406       END.
     1407     END.
     1408     WHEN NO THEN DO:
     1409       FOR EACH obj-list WHERE
     1410               obj-list.obj-type = 'маг':U NO-LOCK :
     1411         FOR EACH buf_sale-doc NO-LOCK WHERE
     1412                 buf_sale-doc.obj-type = obj-list.obj-type
     1413            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1414            AND  buf_sale-doc.status_ = 'факт':U
     1415            AND  buf_sale-doc.chr-office = 'у':U
     1416            AND  buf_sale-doc.doc-date >= X-date-start
     1417            AND  buf_sale-doc.doc-date <= X-date-end :
