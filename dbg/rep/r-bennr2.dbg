     1390                  buf_Sale-doc.obj-type = obj-list.obj-type
     1391              AND buf_sale-doc.obj-code = obj-list.obj-code
     1392              AND buf_sale-doc.status_ = 'факт':U
     1393              AND buf_sale-doc.chr-office = 'у':U
     1394              AND (
     1395                 buf_sale-doc.shift-date >= X-date-start
     1396                 AND
     1397                 buf_sale-doc.shift-date <= X-date-end):
     1398           IF X-Radio-Task = 3 AND
     1399           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1400             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1401           IF X-Radio-Task = 4 AND
