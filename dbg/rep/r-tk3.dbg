     4860   function nutro_get-carbohydrate returns decimal
     4861     ( input p-artic     as character
     4862     , input p-prod-type as character
     4863     , input p-prod-code as integer
     4864     , input p-obj-type  as character
     4865     , input p-obj-code  as integer
     4866     )
     4867   :
     4868     define variable v-carbohydrate as decimal   no-undo .
     4869     run nutro_proc-get-carbohydrate in this-procedure ( input p-artic
     4870                                                       , input p-prod-type
     4871                                                       , input p-prod-code
     4872                                                       , input p-obj-type
     4873                                                       , input p-obj-code
     4874                                                       , output v-carbohydrate
     4875                                                       ) no-error .
     4876     if error-status :error = yes
     4877     then do:
     4878       assign
     4879         v-carbohydrate = ?
     4880       .
     4881     end.
     4882     return v-carbohydrate.
     4883   end function.
