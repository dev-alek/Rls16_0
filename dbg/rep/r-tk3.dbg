      601   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      602   PROCEDURE ostatok :
      603   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
      604   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
      605   def input parameter x-tog-shift   as   logical             no-undo.
      606   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
      607   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
      608   def input parameter x-shift-start as integer               no-undo.
      609   def input parameter x-shift-end   as integer               no-undo.
      610   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
      611   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
      612   def input parameter xTog-obj   as log no-undo.
      613   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
      614   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
      615   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
      616   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
      617   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
      618   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
      619   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
      620   def var              Fact-orderS   as char  no-undo.
      621   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
      622      Assign
      623         Fact-order   = 0
      624         Quantity     = 0
      625         Coast_R      = 0
      626         Coast_V      = 0
      627         VAT_R        = 0
      628         VAT_V        = 0 .
      629    x-date-start-t  = x-date-start + 1 .
      630   IF x-date-end = date('') then DO:
      631      Fact-order = 0 .
      632      for each obj-list
      633          where  ( not xtog-obj or
      634                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
      635                 no-lock :
      636         if  x-tog-shift = false then do:
      637                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      638                               ub.stk-tot.Fact-date <=  x-date-start
      639                               and ub.stk-tot.shift-num = 0
      640                               USE-INDEX fact-date no-lock no-error .
      641              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      642         End.
      643         Else  DO :
      644             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      645              (ub.stk-tot.shift-date  = x-date-start-t and
      646               ub.stk-tot.shift-num  < x-shift-start or
      647               ub.stk-tot.shift-date  < x-date-start-t  )
      648               and ub.stk-tot.shift-num  > 0
      649               USE-INDEX Shift-num no-lock no-error .
      650            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      651           END.
      652       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
      653     End.
      654   End.
      655   Else DO:
      656     For each obj-list  WHERE
      657        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
      658         no-lock :
      659      IF  x-TOG-Shift = False Then DO:
      660          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      661               ub.stk-tot.Fact-date <= x-date-end
      662               and ub.stk-tot.shift-num = 0
      663               USE-INDEX fact-date no-lock no-error.
      664          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      665      END.
      666      Else DO:
      667           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
      668               (ub.stk-tot.shift-date  = x-date-end and
      669               ub.stk-tot.shift-num  <= x-shift-end or
      670               ub.stk-tot.shift-date  < x-date-end       ) and
      671               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
      672               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
      673       End.
      674       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
      675     End.
      676   End.
      677   END PROCEDURE.
      678   procedure get-factord:
      679       define input parameter  p-obj-type       as character no-undo.
      680       define input parameter  p-obj-code       as integer   no-undo.
      681       define input parameter  p-shift-date     as date    format "99/99/9999" no-undo.
      682       define input parameter  p-shift-num      as integer   no-undo.
      683       define input parameter  p-type           as integer   no-undo.
      684       define output parameter p-factord        as decimal   no-undo.
      685       define variable tmp as decimal no-undo.
      686       if p-type = 1 and p-shift-num > 0 then do:
      687           run ostatok(
      688               p-obj-code,
      689               p-obj-type,
      690               true,
      691               p-shift-date - 1,
      692               date(''),
      693               p-shift-num,
      694               p-shift-num,
      695               'cost':U,
      696               '##,##':U,
      697               true,
      698               output tmp,
      699               output tmp,
      700               output tmp,
      701               output tmp,
      702               output tmp,
      703               output p-factord
      704           ).
      705       end.
      706       else if p-type = 2 and p-shift-num > 0 then
      707           run ostatok(
      708               p-obj-code,
      709               p-obj-type,
      710               true,
      711               p-shift-date,
      712               date(''),
      713               p-shift-num,
      714               p-shift-num,
      715               'cost':U,
      716               '##,##':U,
      717               true,
      718               output tmp,
      719               output tmp,
      720               output tmp,
      721               output tmp,
      722               output tmp,
      723               output p-factord
      724           ).
      725       else if p-type = 1 then
      726           run day-begin-fact-order(p-shift-date, output p-factord).
      727       else if p-type = 2 then
      728           run factord-end-day(p-shift-date, output p-factord).
      729   end.
