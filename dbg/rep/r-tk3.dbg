      786   procedure cur-time :
      787      define output parameter p-today as date      no-undo .
      788      define output parameter p-time  as integer   no-undo .
      789     do
      790     on error undo, return error
      791     :
      792       define variable v-date1 as date      no-undo .
      793       define variable v-date2 as date      no-undo .
      794       define variable v-time  as integer   no-undo .
      795       assign
      796         v-date1 = today
      797         v-time  = time
      798         v-date2 = today
      799       .
      800       if v-date1 <> v-date2
      801       then do:
      802         assign
      803           v-date1 = today
      804           v-time  = v-time
      805         .
      806       end.
      807       assign
      808         p-today = v-date1
      809         p-time  = v-time
      810       .
      811     end.
      812   end.
      813   function cur-time-date returns character
      814   :
      815     return string(today, '99/99/9999':U) .
      816   end.
      817   function cur-time-mjd returns decimal
      818   :
      819     define variable v-date as date      no-undo .
      820     define variable v-time as integer   no-undo .
      821     run cur-time in this-procedure
      822       (output v-date
      823       ,output v-time
      824       ) .
      825     return integer(v-date) - 2400002 + (v-time / 86400) .
      826   end.
      827   function cur-time-get-ending-index returns integer
      828   (input p-number as integer
      829   )
      830   :
      831     if p-number < 0
      832     or p-number = ?
      833     then do:
      834       return 1 .
      835     end.
      836     define variable v-rest as integer   no-undo .
      837     assign
      838       p-number = p-number modulo 100
      839     .
      840     if p-number < 20
      841     then do:
      842       assign
      843         v-rest = p-number
      844       .
      845     end.
      846     else do:
      847       assign
      848         v-rest = p-number modulo 10
      849       .
      850     end.
      851     case v-rest :
      852       when 1
      853       then do:
      854         return 2 .
      855       end.
      856       when 2 or
      857       when 3 or
      858       when 4
      859       then do:
      860         return 3 .
      861       end.
      862       otherwise do:
      863         return 1 .
      864       end.
      865     end case .
      866   end.
      867   procedure cur-time-mjd-to-date :
      868      define input  parameter i-mjd-diff as decimal no-undo.
      869      define output parameter o-Date     as date    no-undo.
      870      define output parameter o-Time     as integer no-undo.
      871      define variable v-day-number as integer   no-undo .
      872      if    i-mjd-diff < 0
      873         or i-mjd-diff = ?
      874      then do:
      875         return "?" .
      876      end.
      877      assign
      878         v-day-number = truncate(i-mjd-diff,0).
      879         o-Date = date(v-day-number + 2400002).
      880         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      881     .
      882   end.
      883   function cur-time-mjd-to-string returns character
      884   (input p-mjd-diff as decimal
      885   )
      886   :
      887     define variable v-day-number as integer   no-undo .
      888     define variable v-seconds    as integer   no-undo .
      889     define variable v-hour       as integer   no-undo .
      890     define variable v-min        as integer   no-undo .
      891     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      892     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      893     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      894     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      895     if p-mjd-diff < 0
      896     or p-mjd-diff = ?
      897     then do:
      898       return "?" .
      899     end.
      900     assign
      901       v-day-number = integer(truncate(p-mjd-diff,0))
      902       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      903     .
      904     if v-seconds > 86400
      905     then do:
      906       assign
      907         v-seconds = 86400 - 1
      908       .
      909     end.
      910     if v-seconds < 0
      911     then do:
      912       assign
      913         v-seconds = 0
      914       .
      915     end.
      916     assign
      917       v-hour = truncate(v-seconds / 3600, 0)
      918     .
      919     assign
      920       v-seconds = v-seconds modulo 3600
      921     .
      922     assign
      923       v-min = truncate(v-seconds / 60, 0)
      924     .
      925     assign
      926       v-seconds = v-seconds modulo 60
      927     .
      928     return
      929         (if v-day-number <> 0
      930           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      931           else ""
      932         )
      933       + (if v-day-number <> 0 or v-hour <> 0
      934           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      935           else ""
      936         )
      937       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      938           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      939           else ""
      940         )
      941       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      942       .
      943   end.
      944   function cur-time-string returns character
      945   :
      946     define variable v-date as date      no-undo .
      947     define variable v-time as integer   no-undo .
      948     run cur-time in this-procedure
      949       (output v-date
      950       ,output v-time
      951       ) .
      952     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      953   end.
      954   function cur-time-string-sec returns character
      955   :
      956     define variable v-date as date      no-undo .
      957     define variable v-time as integer   no-undo .
      958     run cur-time in this-procedure
      959       (output v-date
      960       ,output v-time
      961       ) .
      962     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      963   end.
      964   function cur-time-custom  returns character
      965   (input p-prefix as character
      966   ,input p-date-format as character
      967   ,input p-delimiter as character
      968   ,input p-time-format as character
      969   ,input p-suffix as character
      970   )
      971   :
      972     define variable v-date as date      no-undo .
      973     define variable v-time as integer   no-undo .
      974     run cur-time in this-procedure
      975       (output v-date
      976       ,output v-time
      977       ) .
      978     return
      979       p-prefix
      980       + string(v-date, p-date-format)
      981       + p-delimiter
      982       + string(v-time, p-time-format)
      983       + p-suffix
      984       .
      985   end.
      986   function cur-time-print  returns character
      987   :
      988     define variable v-date as date      no-undo .
      989     define variable v-time as integer   no-undo .
      990     run cur-time in this-procedure
      991       (output v-date
      992       ,output v-time
      993       ) .
      994     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      995   end.
      996   function cur-time-datetime returns datetime
      997   :
      998     define variable v-char as character no-undo .
      999     define variable v-datetime as datetime no-undo .
     1000     v-char = cur-time-string().
     1001     v-datetime = datetime(v-char).
     1002     return  v-datetime.
     1003   end.
     1004   function cur-time-string-msec returns character
     1005   :
     1006     define variable v-date as datetime  no-undo .
     1007     v-date = now.
     1008     return string(v-date) .
     1009   end.
     1010   procedure fbrlib_create-fbr-doc :
     1011   define input parameter p-obj-type as character no-undo .
     1012   define input parameter p-obj-code as integer no-undo .
     1013   define input parameter p-userid as character no-undo .
     1014   define output parameter p-fbr-doc-code as character no-undo .
     1015   define output parameter p-recid as recid no-undo .
     1016   define variable v-host-code as integer no-undo .
     1017   define variable v-base-code as integer no-undo .
     1018   define variable v-obj-db-num as integer no-undo .
     1019   define variable v-db-num as integer no-undo .
     1020   DEFINE VARIABLE v-today as date no-undo .
     1021   DEFINE VARIABLE v-time as integer no-undo .
     1022   define variable v-doc-code as character no-undo .
     1023   define variable fi-pay-code as integer no-undo .
     1024   define buffer buf_fbr-doc for ub.fbr-doc.
     1025   define buffer buf_curr-accnt for ub.curr-accnt.
     1026   do
     1027   on error  undo , return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     1028   on stop   undo , return error substitute( "&1. stop", vss-workfile )
     1029   on endkey undo , return error substitute( "&1. endkey", vss-workfile )
     1030   :
     1031   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1032   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1033     (input  p-obj-type
     1034     ,input  p-obj-code
     1035     ,output v-host-code
     1036     )  .
     1037   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1038   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdbnum in g#library
     1039     (input  p-obj-type
     1040     ,input  p-obj-code
     1041     ,output v-obj-db-num
     1042     )  .
     1043   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1044   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curdbnum in g#library
     1045     (output v-db-num
     1046     )  .
     1047   if v-obj-db-num <> v-db-num then do:
     1048     return error substitute("Запрещено создание документа производства в чужой БД:&1БД &2&3 - &4&1текущая БД - &5"
     1049                             , chr(10)
     1050                             , p-obj-type
     1051                             , p-obj-code
     1052                             , v-obj-db-num
     1053                             , v-db-num).
     1054   end.
     1055   run cur-time in this-procedure ( output v-today, output v-time).
     1056   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     1058     (input  p-obj-type
     1059     ,input  p-obj-code
     1060     ,output v-today
     1061     )  .
     1062   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1063   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1064     (input  v-host-code
     1065     ,output v-base-code
     1066     )  .
     1067   find last buf_curr-accnt no-lock
     1068       where buf_curr-accnt.curr-code = v-base-code
     1069         and buf_curr-accnt.exch-date <= v-today use-index pi
     1070   no-error.
     1071   if not available buf_curr-accnt
     1072   then do:
     1073     undo, return error substitute("На дату &1 неизвестен курс базовой валюты с кодом &2"
     1074                                     , string(v-today, "99/99/9999")
     1075                                     , v-base-code).
     1076   end.
     1077   run doc-code in this-procedure (
     1078         input  "main"
     1079       , input  p-obj-type
     1080       , input  p-obj-code
     1081       , input  ?
     1082       , output v-doc-code
     1083   ) no-error.
     1084   if error-status:error
     1085   then do:
     1086     undo, return error substitute("Ошибка при генерации номера документа производства&1&2&1&3"
     1087                                   , chr(10)
     1088                                   , error-status:get-message(1)
     1089                                   , return-value ).
     1090   end.
     1091   run trg/chkdocnm.p (
     1092         input v-doc-code
     1093       , input 'fbr-doc':U
     1094       , input ?
     1095   ) no-error.
     1096   if error-status:error
     1097   then do:
     1098     undo, return error substitute("Ошибка при проверке номера для нового документа производства&1&2&1&3"
     1099                                   , chr(10)
     1100                                   , error-status:get-message(1)
     1101                                   , return-value ).
     1102   end.
     1103   create buf_fbr-doc.
     1104   assign
     1105   buf_fbr-doc.doc-code  = v-doc-code
     1106   buf_fbr-doc.creid     = p-userid
     1107   buf_fbr-doc.doc-date  = v-today
     1108   buf_fbr-doc.doc-type  = 'производство':U
     1109   buf_fbr-doc.host-code = v-host-code
     1110   buf_fbr-doc.obj-code  = p-obj-code
     1111   buf_fbr-doc.obj-type  = p-obj-type
     1112   buf_fbr-doc.PS        = "@"
     1113   buf_fbr-doc.status_   = 'новый':U
     1114   buf_fbr-doc.user-db-num = v-obj-db-num
     1115   buf_fbr-doc.user-name   = p-userid
     1116   .
     1117   run fbrlib_get-default-pay-code in this-procedure (
     1118         input buf_fbr-doc.obj-type
     1119       , input buf_fbr-doc.obj-code
     1120       , output fi-pay-code
     1121   ).
     1122   buf_fbr-doc.pay-code = fi-pay-code.
     1123   p-recid = recid(buf_fbr-doc).
     1124   p-fbr-doc-code = buf_fbr-doc.doc-code.
     1125   end.
     1126   end procedure.
     1127   procedure fbrlib_get-default-pay-code :
     1128   define input parameter p-obj-type   as character        no-undo.
     1129   define input parameter p-obj-code   as integer          no-undo.
     1130   define output parameter p-pay-code  as integer          no-undo.
     1131   define variable v-host-code as integer no-undo .
     1132   define buffer buf_shop          for ub.shop.
     1133   define buffer buf_store         for ub.store.
     1134   define buffer buf_sysconf       for ub.sysconf.
     1135   do
     1136   for buf_shop
     1137     , buf_store
     1138     , buf_sysconf
     1139   on error undo, return error
     1140   :
     1141     case p-obj-type  :
     1142       when 'маг':U then do:
     1143           find first buf_shop no-lock
     1144                 where buf_shop.obj-code = p-obj-code
     1145           no-error.
     1146           if available buf_shop
     1147           then do:
     1148               assign
     1149                   p-pay-code = buf_shop.fbr-pay
     1150               .
     1151           end.
     1152       end.
     1153       when 'скл':U then do:
     1154           find first buf_store no-lock
     1155                 where buf_store.obj-code = p-obj-code
     1156           no-error.
     1157           if available buf_store
     1158           then do:
     1159               assign
     1160                   p-pay-code = buf_store.fbr-pay
     1161               .
     1162           end.
     1163       end.
     1164     end case.
     1165     if p-pay-code = ?
     1166     or p-pay-code = 0
     1167     then do:
     1168   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1169   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1170     (input  p-obj-type
     1171     ,input  p-obj-code
     1172     ,output v-host-code
     1173     )  .
     1174         find first buf_sysconf no-lock
     1175               where buf_sysconf.host-code = v-host-code
     1176         no-error.
     1177         if available buf_sysconf
     1178         then do:
     1179             assign
     1180                 p-pay-code = buf_sysconf.fbr-pay
     1181             .
     1182         end.
     1183     end.
     1184     if p-pay-code = ?
     1185     or p-pay-code = 0
     1186     then do:
     1187   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objdnpay in g#library
     1189     (input  p-obj-type
     1190     ,input  p-obj-code
     1191     ,output p-pay-code
     1192     )  .
     1193     end.
     1194   end.
     1195   end procedure.
     1196   procedure fbrlib-fill-and-check-temp_fbrlib_recipe :
     1197   do
     1198   on error undo, return error
     1199   :
     1200   define input parameter p-fbr-doc-code as character    no-undo.
     1201       define variable vss-description as character    no-undo init "fbrlib-fill-and-check-temp_fbrlib_recipe: ".
     1202       define variable v-gds-name      as character    no-undo.
     1203       define buffer buf_fbr-doc               for ub.fbr-doc.
     1204       define buffer buf_fbr-line              for ub.fbr-line.
     1205       define buffer buf_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1206       define buffer buf_out_temp_fbrlib_recipe    for temp_fbrlib_recipe.
     1207       find first buf_fbr-doc no-lock
     1208            where buf_fbr-doc.doc-code = p-fbr-doc-code
     1209       .
     1210       for each buf_temp_fbrlib_recipe
     1211       :
     1212           delete buf_temp_fbrlib_recipe.
     1213       end.
     1214       for each buf_fbr-line no-lock
     1215          where buf_fbr-line.doc-code = p-fbr-doc-code
     1216       :
     1217           find first buf_temp_fbrlib_recipe
     1218                where buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1219           no-error.
     1220           if not available buf_temp_fbrlib_recipe
     1221           then do:
     1222               create buf_temp_fbrlib_recipe.
     1223               assign
     1224                   buf_temp_fbrlib_recipe.recipe-code = buf_fbr-line.recipe-code
     1225                   buf_temp_fbrlib_recipe.fbr-doc-code = buf_fbr-line.doc-code
     1226               .
     1227           end.
     1228       end.
     1229       for each buf_temp_fbrlib_recipe
     1230       :
     1231           assign
     1232               buf_temp_fbrlib_recipe.count-income                = 0
     1233               buf_temp_fbrlib_recipe.qnty-income                 = 0
     1234               buf_temp_fbrlib_recipe.sum-income-sale             = 0
     1235               buf_temp_fbrlib_recipe.sum-income-cost-base        = 0
     1236               buf_temp_fbrlib_recipe.sum-income-cost-rubl        = 0
     1237               buf_temp_fbrlib_recipe.sum-income-vat-cost-base    = 0
     1238               buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl    = 0
     1239               buf_temp_fbrlib_recipe.count-write-off             = 0
     1240               buf_temp_fbrlib_recipe.qnty-write-off              = 0
     1241               buf_temp_fbrlib_recipe.sum-write-off-sale          = 0
     1242               buf_temp_fbrlib_recipe.sum-write-off-cost-base     = 0
     1243               buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = 0
     1244               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = 0
     1245               buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = 0
     1246           .
     1247           for each buf_fbr-line no-lock
     1248              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1249                and buf_fbr-line.trn-type     = 'при':U
     1250                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1251           :
     1252               if ( buf_fbr-line.price-base   = ?
     1253                   or buf_fbr-line.price-rubl = ?
     1254                   or buf_fbr-line.price-base <= 0
     1255                   or buf_fbr-line.price-rubl <= 0 )
     1256               and buf_fbr-line.fact-qnty <> 0
     1257               and buf_fbr-line.rsrv-qnty <> ?
     1258               and buf_fbr-doc.is-free    = no
     1259               then do:
     1260   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1262     (input  buf_fbr-line.artic
     1263     ,input  buf_fbr-line.prod-type
     1264     ,input  buf_fbr-line.prod-code
     1265     ,output v-gds-name
     1266     ) no-error .
     1267                   if error-status :error
     1268                   then do:
     1269                       assign
     1270                           v-gds-name = ""
     1271                       .
     1272                   end.
     1273                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1274                                                 ,vss-description
     1275                                                 ,buf_fbr-doc.doc-code
     1276                                                 ,chr(10)
     1277                                                 ,buf_fbr-line.recipe-code
     1278                                                 ,buf_fbr-line.artic
     1279                                                 ,v-gds-name).
     1280               end.
     1281               assign
     1282                   buf_temp_fbrlib_recipe.count-income             = buf_temp_fbrlib_recipe.count-income + 1
     1283                   buf_temp_fbrlib_recipe.qnty-income              = buf_temp_fbrlib_recipe.qnty-income
     1284                                                                   + buf_fbr-line.fact-qnty
     1285                   buf_temp_fbrlib_recipe.sum-income-sale          = buf_temp_fbrlib_recipe.sum-income-sale
     1286                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1287               .
     1288               if buf_fbr-line.is-waste = no
     1289               then do:
     1290                   assign
     1291                       buf_temp_fbrlib_recipe.sum-income-cost-base     = buf_temp_fbrlib_recipe.sum-income-cost-base
     1292                                                                       + buf_fbr-line.price-sum-base
     1293                       buf_temp_fbrlib_recipe.sum-income-cost-rubl     = buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1294                                                                       + buf_fbr-line.price-sum-rubl
     1295                       buf_temp_fbrlib_recipe.sum-income-vat-cost-base = buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1296                                                                       + buf_fbr-line.price-sum-vat-base
     1297                       buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1298                                                                       + buf_fbr-line.price-sum-vat-rubl
     1299                   .
     1300               end.
     1301           end.
     1302           for each buf_fbr-line no-lock
     1303              where buf_fbr-line.doc-code     = p-fbr-doc-code
     1304                and buf_fbr-line.trn-type     = 'спи':U
     1305                and buf_fbr-line.recipe-code  = buf_temp_fbrlib_recipe.recipe-code
     1306           :
     1307               if ( buf_fbr-line.price-base   = ?
     1308                   or buf_fbr-line.price-rubl = ?
     1309                   or buf_fbr-line.price-base <= 0
     1310                   or buf_fbr-line.price-rubl <= 0 )
     1311               and buf_fbr-line.fact-qnty <> 0
     1312               and buf_fbr-line.rsrv-qnty <> ?
     1313               and buf_fbr-doc.is-free    = no
     1314               and buf_fbr-doc.status_    = 'разрешен':U
     1315               then do:
     1316   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1317   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-arnm in g#library
     1318     (input  buf_fbr-line.artic
     1319     ,input  buf_fbr-line.prod-type
     1320     ,input  buf_fbr-line.prod-code
     1321     ,output v-gds-name
     1322     ) no-error .
     1323                   if error-status :error
     1324                   then do:
     1325                       assign
     1326                           v-gds-name = ""
     1327                       .
     1328                   end.
     1329                   undo, return error  substitute("&1 В документе пр-ва &2 учетная цена не определена или нулевая!&3Рецепт &4&3Товар: &5 &6"
     1330                                                 ,vss-description
     1331                                                 ,buf_fbr-doc.doc-code
     1332                                                 ,chr(10)
     1333                                                 ,buf_fbr-line.recipe-code
     1334                                                 ,buf_fbr-line.artic
     1335                                                 ,v-gds-name).
     1336               end.
     1337               assign
     1338                   buf_temp_fbrlib_recipe.count-write-off             = buf_temp_fbrlib_recipe.count-write-off + 1
     1339                   buf_temp_fbrlib_recipe.qnty-write-off              = buf_temp_fbrlib_recipe.qnty-write-off
     1340                                                                   + buf_fbr-line.fact-qnty
     1341                   buf_temp_fbrlib_recipe.sum-write-off-sale          = buf_temp_fbrlib_recipe.sum-write-off-sale
     1342                                                                   + buf_fbr-line.price-sale * buf_fbr-line.fact-qnty
     1343               .
     1344               if buf_fbr-line.is-waste = no
     1345               then do:
     1346                   assign
     1347                       buf_temp_fbrlib_recipe.sum-write-off-cost-base     = buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1348                                                                       + buf_fbr-line.price-sum-base
     1349                       buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     = buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1350                                                                       + buf_fbr-line.price-sum-rubl
     1351                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1352                                                                       + buf_fbr-line.price-sum-vat-base
     1353                       buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl = buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1354                                                                       + buf_fbr-line.price-sum-vat-rubl
     1355                   .
     1356               end.
     1357           end.
     1358           if buf_fbr-doc.status_    = 'разрешен':U
     1359           and ( abs( buf_temp_fbrlib_recipe.sum-write-off-cost-base     - buf_temp_fbrlib_recipe.sum-income-cost-base     ) > 0.01
     1360           or abs( buf_temp_fbrlib_recipe.sum-write-off-cost-rubl     - buf_temp_fbrlib_recipe.sum-income-cost-rubl     ) > 0.01
     1361           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base - buf_temp_fbrlib_recipe.sum-income-vat-cost-base ) > 0.01
     1362           or abs( buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl - buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl ) > 0.01
     1363               )
     1364           then do:
     1365            undo, return error
     1366               substitute("В документе пр-ва &1 Не совпадают суммы учетных цен для списанного и оприходованного по рецепту товара.&2" +
     1367                           "Рецепт: &3&2&4&4по списанному товару&4по оприходованному товару&2"  +
     1368                           "Сумма в баз.вал.&4&5&4&4&6&2" +
     1369                           "Сумма в &9.&4&7&4&4&8&2"
     1370                          , buf_fbr-doc.doc-code
     1371                          , chr(10)
     1372                          , buf_temp_fbrlib_recipe.recipe-code
     1373                          , CHR(9)
     1374                          , buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1375                          , buf_temp_fbrlib_recipe.sum-income-cost-base
     1376                          , buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1377                          , buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1378                          , "руб"
     1379                          )
     1380              +
     1381              substitute("НДС в баз.вал.&1&2&1&1&3&4" +
     1382                         "НДС в &7.&1&5&1&1&6&4"
     1383                        ,  CHR(9)
     1384                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1385                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1386                        ,chr(10)
     1387                        ,buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1388                        ,buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1389                        ,"руб"
     1390                        )       .
     1391           end.
     1392       end.
     1393   end.
     1394   end procedure.
     1395   procedure fbrlib-fill-sum-fbr-doc :
     1396   do
     1397   on error undo, return error
     1398   :
     1399   define input parameter p-fbr-doc-recid  as recid        no-undo.
     1400   define input parameter p-mode           as character    no-undo.
     1401       define variable vss-description as character init "fbrlib-fill-sum-fbr-doc: "  no-undo.
     1402       define buffer buf_fbr-doc           for ub.fbr-doc.
     1403       define buffer buf_fbr-line          for ub.fbr-line.
     1404       define buffer buf_temp_fbrlib_recipe   for temp_fbrlib_recipe.
     1405       define variable v-in-count          as integer       no-undo.
     1406       define variable v-out-count         as integer       no-undo.
     1407       find first buf_fbr-doc exclusive-lock
     1408            where recid ( buf_fbr-doc ) = p-fbr-doc-recid
     1409       .
     1410       find first buf_temp_fbrlib_recipe no-error.
     1411       if not available buf_temp_fbrlib_recipe
     1412       then do:
     1413           run fbrlib-fill-and-check-temp_fbrlib_recipe in this-procedure (
     1414               input buf_fbr-doc.doc-code
     1415           ) no-error.
     1416           if error-status :error
     1417           then do:
     1418               undo, return error substitute("&1 Ошибка расчета сумм при заполнении шапки документа производства.&2&3&2&4"
     1419                                              , vss-description
     1420                                              , chr(10)
     1421                                              , error-status:get-message(1)
     1422                                              , return-value ).
     1423           end.
     1424       end.
     1425       assign
     1426           v-in-count                  = 0
     1427           buf_fbr-doc.in-qnty         = 0
     1428           buf_fbr-doc.in-sale         = 0
     1429           buf_fbr-doc.in-base         = 0
     1430           buf_fbr-doc.in-rubl         = 0
     1431           buf_fbr-doc.in-vat-base     = 0
     1432           buf_fbr-doc.in-vat-rubl     = 0
     1433           v-out-count                 = 0
     1434           buf_fbr-doc.out-qnty        = 0
     1435           buf_fbr-doc.out-sale        = 0
     1436           buf_fbr-doc.out-base        = 0
     1437           buf_fbr-doc.out-rubl        = 0
     1438           buf_fbr-doc.out-vat-base    = 0
     1439           buf_fbr-doc.out-vat-rubl    = 0
     1440       .
     1441       for each buf_temp_fbrlib_recipe
     1442       :
     1443           assign
     1444               v-in-count                  = v-in-count                + buf_temp_fbrlib_recipe.count-income
     1445               buf_fbr-doc.in-qnty         = buf_fbr-doc.in-qnty       + buf_temp_fbrlib_recipe.qnty-income
     1446               buf_fbr-doc.in-sale         = buf_fbr-doc.in-sale       + buf_temp_fbrlib_recipe.sum-income-sale
     1447               buf_fbr-doc.in-base         = buf_fbr-doc.in-base       + buf_temp_fbrlib_recipe.sum-income-cost-base
     1448               buf_fbr-doc.in-rubl         = buf_fbr-doc.in-rubl       + buf_temp_fbrlib_recipe.sum-income-cost-rubl
     1449               buf_fbr-doc.in-vat-base     = buf_fbr-doc.in-vat-base   + buf_temp_fbrlib_recipe.sum-income-vat-cost-base
     1450               buf_fbr-doc.in-vat-rubl     = buf_fbr-doc.in-vat-rubl   + buf_temp_fbrlib_recipe.sum-income-vat-cost-rubl
     1451               v-out-count                 = v-out-count               + buf_temp_fbrlib_recipe.count-write-off
     1452               buf_fbr-doc.out-qnty        = buf_fbr-doc.out-qnty      + buf_temp_fbrlib_recipe.qnty-write-off
     1453               buf_fbr-doc.out-sale        = buf_fbr-doc.out-sale      + buf_temp_fbrlib_recipe.sum-write-off-sale
     1454               buf_fbr-doc.out-base        = buf_fbr-doc.out-base      + buf_temp_fbrlib_recipe.sum-write-off-cost-base
     1455               buf_fbr-doc.out-rubl        = buf_fbr-doc.out-rubl      + buf_temp_fbrlib_recipe.sum-write-off-cost-rubl
     1456               buf_fbr-doc.out-vat-base    = buf_fbr-doc.out-vat-base  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-base
     1457               buf_fbr-doc.out-vat-rubl    = buf_fbr-doc.out-vat-rubl  + buf_temp_fbrlib_recipe.sum-write-off-vat-cost-rubl
     1458           .
     1459       end.
     1460       if ( abs (buf_fbr-doc.in-rubl - buf_fbr-doc.out-rubl) <= 0.01
     1461       and   abs (buf_fbr-doc.in-base - buf_fbr-doc.out-base) <= 0.01 )
     1462       or p-mode <> 'факт':U
     1463       then do:
     1464           if substring( buf_fbr-doc.PS, 1, 1 ) = "@"
     1465           then do:
     1466               assign
     1467                   buf_fbr-doc.PS = "@ Строк полученных товаров : "
     1468                                   + string( v-out-count, ">>>,>>9" )
     1469                                   + chr(10) + "Строк исходных товаров : "
     1470                                   + string( v-in-count, ">>>,>>9" )
     1471               .
     1472           end.
     1473       end.
     1474       else do:
     1475         undo, return error substitute("В док-те пр-ва &1 не совпадают суммы списанных и оприходованных товаров.&2" +
     1476                                       "Сумма списанных товаров в &3 - &4&2" +
     1477                                       "Сумма оприходованных товаров в &3 - &5&2" +
     1478                                       "Сумма оприходованных товаров в &3 - &6&2" +
     1479                                       "Сумма списанных товаров в баз.вал. - &7&2" +
     1480                                       "Сумма оприходованных товаров в баз.вал. - &8&2"
     1481                                       , buf_fbr-doc.doc-code
     1482                                       , chr(10)
     1483                                       , "рублях"
     1484                                       , round( buf_fbr-doc.out-rubl, 2 )
     1485                                       , round( buf_fbr-doc.in-rubl,  2 )
     1486                                       , round( buf_fbr-doc.in-rubl,  2 )
     1487                                       , round( buf_fbr-doc.out-base, 2 )
     1488                                       , round( buf_fbr-doc.in-base,  2 )).
     1489       end.
     1490   end.
     1491   end procedure.
     1492   procedure fbrlib-calc-prices :
     1493   do
     1494   on error undo, return error
     1495   :
     1496   define input parameter p-fbr-line-recid as recid        no-undo.
     1497   define input parameter p-price-obj-type as character    no-undo.
     1498   define input parameter p-price-obj-code as integer      no-undo.
     1499   define output parameter p-current-price as decimal      no-undo.
     1500       define variable v-void          as decimal       no-undo.
     1501       define variable v-void-char     as character     no-undo.
     1502       define variable v-gds-code      as integer       no-undo.
     1503       define variable v-b-code        as integer       no-undo.
     1504       define buffer buf_fbr-doc   for ub.fbr-doc.
     1505       define buffer buf_fbr-line  for ub.fbr-line.
     1506       define buffer buf_gds-prt   for ub.gds-prt.
     1507       define buffer buf_bar-code  for ub.bar-code.
     1508       find first buf_fbr-line no-lock
     1509           where recid( buf_fbr-line ) = p-fbr-line-recid
     1510       .
     1511   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1512   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-code in g#library
     1513     (input  buf_fbr-line.artic
     1514     ,input  buf_fbr-line.prod-type
     1515     ,input  buf_fbr-line.prod-code
     1516     ,output v-gds-code
     1517     ) no-error .
     1518       if error-status :error
     1519       then do:
     1520         undo, return error substitute("&1 &2 &3&4Ошибка определения кода товара (артикул &7).&4&5&4&6"
     1521                                         ,vss-workfile
     1522                                         ,vss-revision
     1523                                         ,vss-description
     1524                                         ,chr(10)
     1525                                         , error-status:get-message(1)
     1526                                         , return-value
     1527                                         , buf_fbr-line.artic
     1528                                         ).
     1529       end.
     1530   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1531     (input  v-gds-code
     1532     ,input  ?
     1533     ,output v-b-code
     1534     ) no-error .
     1535       if error-status :error
     1536       then do:
     1537         undo, return error substitute("&1 &2 &3&4Ошибка определения основного бар-кода товара (код товара) &7.&4&5&4&6"
     1538                                         ,vss-workfile
     1539                                         ,vss-revision
     1540                                         ,vss-description
     1541                                         ,chr(10)
     1542                                         , error-status:get-message(1)
     1543                                         , return-value
     1544                                         , v-gds-code
     1545                                         ).
     1546       end.
     1547       if buf_fbr-line.is-calc = no
     1548       then do:
     1549   define variable vss-include-info21 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     1551     (input  p-price-obj-type
     1552     ,input  p-price-obj-code
     1553     ,input  v-b-code
     1554     ,input  0
     1555     ,input  0
     1556     ,output v-void-char
     1557     ,output p-current-price
     1558     ,output v-void
     1559     ,output v-void
     1560     ) no-error .
     1561           if error-status :error
     1562           then do:
     1563             undo, return error substitute("&1 &2 &3&4Ошибка определения продажной цены основного бар-кода товара (код товара) &7.&4&5&4&6"
     1564                                             ,vss-workfile
     1565                                             ,vss-revision
     1566                                             ,vss-description
     1567                                             ,chr(10)
     1568                                             , error-status:get-message(1)
     1569                                             , return-value
     1570                                             , v-gds-code
     1571                                             ).
     1572           end.
     1573       end.
     1574       else do:
     1575           assign
     1576               p-current-price = buf_fbr-line.price-sale
     1577           .
     1578       end.
     1579   end.
     1580   end procedure.
     1581   procedure fbrlib-put-in-order-recipe :
     1582   do
     1583   on error undo, return error
     1584   :
     1585   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     1586       define variable v-recipe-counter    as integer          no-undo.
     1587       define variable v-recipe-amount     as integer init 0   no-undo.
     1588       define variable v-child-counter     as integer          no-undo.
     1589       define variable v-is-call-cycle     as logical          no-undo.
     1590       define variable v-str as character     no-undo.
     1591       define buffer buf_in_fbr-line       for ub.fbr-line.
     1592       define buffer buf_dress_fbr-line    for ub.fbr-line.
     1593       define buffer buf_fbr-line          for ub.fbr-line.
     1594       define buffer buf_recipe-gds        for ub.recipe-gds.
     1595       define buffer buf_recipe            for ub.recipe.
     1596       for each temp_recipe-childs-qnty
     1597       :
     1598           delete temp_recipe-childs-qnty.
     1599       end.
     1600       for each temp_recipe-childs
     1601       :
     1602           delete temp_recipe-childs.
     1603       end.
     1604       for each temp_recipe-order
     1605       :
     1606           delete temp_recipe-order.
     1607       end.
     1608       for each buf_fbr-line no-lock
     1609          where buf_fbr-line.doc-code = p-fbr-doc-doc-code
     1610       on error undo, return error
     1611       :
     1612           find first temp_recipe-childs-qnty
     1613                where temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1614           no-error.
     1615           if not available temp_recipe-childs-qnty
     1616           then do:
     1617               create temp_recipe-childs-qnty.
     1618               assign
     1619                   v-recipe-amount                     = v-recipe-amount + 1
     1620                   temp_recipe-childs-qnty.recipe-code = buf_fbr-line.recipe-code
     1621                   temp_recipe-childs-qnty.order       = v-recipe-amount
     1622                   temp_recipe-childs-qnty.childs-qnty = 0
     1623                   v-child-counter                     = 0
     1624               .
     1625           end.
     1626       end.
     1627       for each buf_in_fbr-line no-lock
     1628          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1629            and buf_in_fbr-line.trn-type = 'спи':U
     1630       on error undo, return error
     1631       :
     1632           for each buf_dress_fbr-line no-lock
     1633              where buf_dress_fbr-line.doc-code    = p-fbr-doc-doc-code
     1634                and buf_dress_fbr-line.trn-type    = 'при':U
     1635                and buf_dress_fbr-line.artic       = buf_in_fbr-line.artic
     1636                and buf_dress_fbr-line.prod-type   = buf_in_fbr-line.prod-type
     1637                and buf_dress_fbr-line.prod-code   = buf_in_fbr-line.prod-code
     1638           on error undo, return error
     1639           :
     1640               find first buf_recipe no-lock
     1641                    where buf_recipe.recipe-code = buf_dress_fbr-line.recipe-code
     1642               .
     1643               if buf_in_fbr-line.is-comp = yes
     1644               then do:
     1645                   find last temp_recipe-childs-qnty
     1646                       where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1647                   .
     1648                   assign
     1649                       temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1650                   .
     1651                   create temp_recipe-childs.
     1652                   assign
     1653                       temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1654                       temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1655                       temp_recipe-childs.child-recipe-code    = buf_dress_fbr-line.recipe-code
     1656                   .
     1657               end.
     1658               else do:
     1659               end.
     1660           end.
     1661       end.
     1662       for each buf_in_fbr-line no-lock
     1663          where buf_in_fbr-line.doc-code = p-fbr-doc-doc-code
     1664            and buf_in_fbr-line.trn-type = 'при':U
     1665       on error undo, return error
     1666       :
     1667           find first buf_recipe no-lock
     1668                where buf_recipe.recipe-code = buf_in_fbr-line.recipe-code
     1669           no-error.
     1670           if buf_in_fbr-line.is-comp = no
     1671           then do:
     1672           end.
     1673           else do:
     1674               for each buf_recipe-gds no-lock
     1675               where buf_recipe-gds.recipe-code = buf_in_fbr-line.recipe-code
     1676               :
     1677                   for each buf_fbr-line no-lock
     1678                   where buf_fbr-line.doc-code    = p-fbr-doc-doc-code
     1679                       and buf_fbr-line.trn-type    = 'при':U
     1680                       and buf_fbr-line.artic       = buf_recipe-gds.artic
     1681                       and buf_fbr-line.prod-type   = buf_recipe-gds.prod-type
     1682                       and buf_fbr-line.prod-code   = buf_recipe-gds.prod-code
     1683                   on error undo, return error
     1684                   :
     1685                       find first buf_recipe no-lock
     1686                            where buf_recipe.recipe-code = buf_fbr-line.recipe-code
     1687                       .
     1688                       if buf_recipe.recipe-type = 'разделка':U
     1689                       then do:
     1690                       end.
     1691                       else do:
     1692                           find last temp_recipe-childs-qnty
     1693                               where temp_recipe-childs-qnty.recipe-code = buf_in_fbr-line.recipe-code
     1694                           .
     1695                           assign
     1696                               temp_recipe-childs-qnty.childs-qnty = temp_recipe-childs-qnty.childs-qnty + 1
     1697                           .
     1698                           create temp_recipe-childs.
     1699                           assign
     1700                               temp_recipe-childs.recipe-code          = buf_in_fbr-line.recipe-code
     1701                               temp_recipe-childs.child-code           = temp_recipe-childs-qnty.childs-qnty
     1702                               temp_recipe-childs.child-recipe-code    = buf_fbr-line.recipe-code
     1703                           .
     1704                       end.
     1705                   end.
     1706               end.
     1707           end.
     1708       end.
     1709       for each temp_recipe-order
     1710       on error undo, return error
     1711       :
     1712           delete temp_recipe-order.
     1713       end.
     1714       assign
     1715           v-fbrlib-recipe-order = 0
     1716       .
     1717       do v-recipe-counter = 1 to v-recipe-amount
     1718       on error undo, return error
     1719       :
     1720           run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1721                 input v-recipe-counter
     1722               , input 0
     1723               , output v-is-call-cycle
     1724           ).
     1725           if v-is-call-cycle = yes
     1726           then do:
     1727               message
     1728                       "Достигнут максимальный уровень вложенности рецептов."
     1729                   skip(1)
     1730                   skip "Невозможно упорядочить рецепты."
     1731                   skip(1)
     1732                   skip "Необходимо изменить структуру рецептов,"
     1733                   skip "используемых при формировании"
     1734                   skip "данного документа производства."
     1735               view-as alert-box error
     1736               title "Невозможно рассчитать документ производства".
     1737               for each temp_recipe-childs-qnty
     1738               :
     1739                   delete temp_recipe-childs-qnty.
     1740               end.
     1741               for each temp_recipe-childs
     1742               :
     1743                   delete temp_recipe-childs.
     1744               end.
     1745               for each temp_recipe-order
     1746               :
     1747                   delete temp_recipe-order.
     1748               end.
     1749               for each temp_recipe-order
     1750               on error undo, return error
     1751               :
     1752                   delete temp_recipe-order.
     1753               end.
     1754               for each temp_fbrlib_recipe
     1755               on error undo, return error
     1756               :
     1757                   delete temp_recipe-order.
     1758               end.
     1759               undo, return error.
     1760           end.
     1761       end.
     1762   end.
     1763   end procedure.
     1764   procedure fbrlib-add-recipe-in-tmp-order :
     1765   do
     1766   on error undo, return error
     1767   :
     1768   define input parameter p-order              as integer      no-undo.
     1769   define input parameter p-call-counter       as integer      no-undo.
     1770   define output parameter p-is-call-cycle     as logical      no-undo.
     1771       define variable v-nodes-counter     as integer       no-undo.
     1772       define buffer buf_c_temp_recipe-childs-qnty for temp_recipe-childs-qnty.
     1773       define buffer buf_temp_recipe-childs-qnty   for temp_recipe-childs-qnty.
     1774       define buffer buf_temp_recipe-childs        for temp_recipe-childs     .
     1775       define buffer buf_temp_recipe-order         for temp_recipe-order.
     1776       assign
     1777           p-call-counter = p-call-counter + 1
     1778       .
     1779       if p-call-counter > 50
     1780       then do:
     1781           assign
     1782               p-is-call-cycle = yes
     1783           .
     1784       end.
     1785       else do:
     1786           find first buf_temp_recipe-childs-qnty
     1787                where buf_temp_recipe-childs-qnty.order = p-order
     1788           .
     1789           find first buf_temp_recipe-order
     1790                where buf_temp_recipe-order.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1791           no-error.
     1792           if not available buf_temp_recipe-order
     1793           then do:
     1794               do v-nodes-counter = 1 to buf_temp_recipe-childs-qnty.childs-qnty
     1795               :
     1796                   find first buf_temp_recipe-childs
     1797                        where buf_temp_recipe-childs.recipe-code = buf_temp_recipe-childs-qnty.recipe-code
     1798                          and buf_temp_recipe-childs.child-code  = v-nodes-counter
     1799                   .
     1800                   find first buf_c_temp_recipe-childs-qnty
     1801                        where buf_c_temp_recipe-childs-qnty.recipe-code = buf_temp_recipe-childs.child-recipe-code
     1802                   .
     1803                   run fbrlib-add-recipe-in-tmp-order in this-procedure (
     1804                         input buf_c_temp_recipe-childs-qnty.order
     1805                       , input p-call-counter
     1806                       , output p-is-call-cycle
     1807                   ).
     1808                   if p-is-call-cycle = yes
     1809                   then do:
     1810                       return.
     1811                   end.
     1812               end.
     1813               assign
     1814                   v-fbrlib-recipe-order = v-fbrlib-recipe-order + 1
     1815               .
     1816               create buf_temp_recipe-order.
     1817               assign
     1818                   buf_temp_recipe-order.recipe-code   = buf_temp_recipe-childs-qnty.recipe-code
     1819                   buf_temp_recipe-order.order         = v-fbrlib-recipe-order
     1820               .
     1821           end.
     1822       end.
     1823   end.
     1824   end procedure.
     1825   procedure fbrlib-get-trn-type :
     1826   define input parameter p-recipe-code    as character    no-undo.
     1827   define input parameter p-goods-recid    as recid        no-undo.
     1828   define input parameter p-is-integration as logical      no-undo.
     1829   define output parameter p-is-comp       as logical      no-undo.
     1830   define output parameter p-trn-type      as character    no-undo.
     1831   define buffer buf_recipe    for ub.recipe.
     1832   define buffer buf_goods     for ub.goods.
     1833   do
     1834   for buf_recipe
     1835     , buf_goods
     1836   on error undo, return error
     1837   :
     1838       find first buf_goods no-lock
     1839            where recid( buf_goods ) = p-goods-recid
     1840       .
     1841       find first buf_recipe no-lock
     1842            where buf_recipe.recipe-code = p-recipe-code
     1843       no-error.
     1844       if not available buf_recipe
     1845       then do:
     1846           assign
     1847               p-is-comp = no
     1848               p-trn-type = "":U
     1849           .
     1850           undo, return.
     1851       end.
     1852       if  buf_recipe.artic        = buf_goods.artic
     1853       and buf_recipe.prod-type    = buf_goods.prod-type
     1854       and buf_recipe.prod-code    = buf_goods.prod-code
     1855       then do:
     1856           assign
     1857               p-is-comp = yes
     1858           .
     1859       end.
     1860       else do:
     1861           assign
     1862               p-is-comp = no
     1863           .
     1864       end.
     1865       case buf_recipe.recipe-type
     1866       :
     1867           when 'производство':U
     1868           then do:
     1869               if p-is-comp = yes
     1870               then do:
     1871                   assign
     1872                       p-trn-type = 'при':U
     1873                   .
     1874               end.
     1875               else do:
     1876                   assign
     1877                       p-trn-type = 'спи':U
     1878                   .
     1879               end.
     1880           end.
     1881           when 'альтернатива':U
     1882           then do:
     1883               if p-is-comp = yes
     1884               then do:
     1885                   assign
     1886                       p-trn-type = 'при':U
     1887                   .
     1888               end.
     1889               else do:
     1890                   assign
     1891                       p-trn-type = 'спи':U
     1892                   .
     1893               end.
     1894           end.
     1895           when 'разделка':U
     1896           then do:
     1897               if p-is-comp = no
     1898               then do:
     1899                   assign
     1900                       p-trn-type = 'при':U
     1901                   .
     1902               end.
     1903               else do:
     1904                   assign
     1905                       p-trn-type = 'спи':U
     1906                   .
     1907               end.
     1908           end.
     1909           when 'комплектация':U
     1910           then do:
     1911               if p-is-integration = ?
     1912               then do:
     1913                   message
     1914                       "Выберите тип операции по рецепту комплектации:"
     1915                       skip (2) "YES - комплектация"
     1916                       skip     "NO - разукомплектация"
     1917                   view-as alert-box question
     1918                   buttons YES-NO
     1919                   update p-is-integration.
     1920               end.
     1921               if p-is-integration = yes
     1922               then do:
     1923                   if p-is-comp = yes
     1924                   then do:
     1925                       assign
     1926                           p-trn-type = 'при':U
     1927                       .
     1928                   end.
     1929                   else do:
     1930                       assign
     1931                           p-trn-type = 'спи':U
     1932                       .
     1933                   end.
     1934               end.
     1935               else do:
     1936                   if p-is-comp = yes
     1937                   then do:
     1938                       assign
     1939                           p-trn-type = 'спи':U
     1940                       .
     1941                   end.
     1942                   else do:
     1943                       assign
     1944                           p-trn-type = 'при':U
     1945                       .
     1946                   end.
     1947               end.
     1948           end.
     1949       end case.
     1950   end.
     1951   end procedure.
     1952   procedure fbrlib-get-mark :
     1953   define input parameter p-recipe-code    as character    no-undo.
     1954   define output parameter p-mark          as logical    no-undo.
     1955   define buffer buf_goods-attr     for ub.goods-attr.
     1956   define buffer buf_recipe-gds for ub.recipe-gds .
     1957       for each buf_recipe-gds no-lock where buf_recipe-gds.recipe-code = p-recipe-code,
     1958            first buf_goods-attr no-lock where buf_goods-attr.gds-code = buf_recipe-gds.gds-code and
     1959                                               buf_goods-attr.attr-code = 'mark-type':U:
     1960            if buf_goods-attr.attr-value <> "" and buf_goods-attr.attr-value <> "not-type" then do:
     1961               p-mark = true .
     1962               return .
     1963            end.
     1964       end.
     1965   end procedure.
     1966   procedure fbrlib-check-temp-tables :
     1967   do
     1968   on error undo, return error
     1969   :
     1970   define input parameter p-title  as character    no-undo.
     1971       define variable v-str               as character        no-undo.
     1972       assign
     1973           v-str = v-str + chr(10) + "temp_recipe-childs-qnty:" + chr(10)
     1974       .
     1975       for each temp_recipe-childs-qnty
     1976       on error undo, return error
     1977       :
     1978           assign
     1979               v-str   = v-str + string( temp_recipe-childs-qnty.recipe-code )
     1980                       + "   " + string( temp_recipe-childs-qnty.childs-qnty )
     1981                       + "   " + string( temp_recipe-childs-qnty.order )
     1982                       + chr(10)
     1983           .
     1984       end.
     1985       assign
     1986           v-str = v-str + "temp_recipe-childs:" + chr(10)
     1987       .
     1988       for each temp_recipe-childs
     1989       on error undo, return error
     1990       :
     1991           assign
     1992               v-str   = v-str + string( temp_recipe-childs.recipe-code )
     1993                       + "   " + string( temp_recipe-childs.child-code )
     1994                       + "   " + string( temp_recipe-childs.child-recipe-code )
     1995                       + chr(10)
     1996           .
     1997       end.
     1998       assign
     1999           v-str = v-str + chr(10) + "temp_recipe-order:" + chr(10)
     2000       .
     2001       for each temp_recipe-order
     2002       on error undo, return error
     2003       :
     2004           assign
     2005               v-str   = v-str + string( temp_recipe-order.recipe-code )
     2006                       + "   " + string( temp_recipe-order.order )
     2007                       + chr(10)
     2008           .
     2009       end.
     2010       assign
     2011           v-str = v-str + chr(10) + "temp_fbrlib_recipe:" + chr(10)
     2012       .
     2013       run writelog in this-procedure ( input "fbr.log", input 0, input p-title ).
     2014       run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2015       for each temp_fbrlib_recipe
     2016       on error undo, return error
     2017       :
     2018           assign
     2019               v-str   = "recipe-code: "                   + string( temp_fbrlib_recipe.recipe-code                 )
     2020                       + "   " + "count-income: "                  + string( temp_fbrlib_recipe.count-income                )
     2021                       + "   " + "qnty-income: "                   + string( temp_fbrlib_recipe.qnty-income                 )
     2022                       + "   " + "sum-income-sale: "               + string( temp_fbrlib_recipe.sum-income-sale             )
     2023                       + "   " + "sum-income-cost-base: "          + string( temp_fbrlib_recipe.sum-income-cost-base        )
     2024                       + "   " + "sum-income-cost-rubl: "          + string( temp_fbrlib_recipe.sum-income-cost-rubl        )
     2025                       + "   " + "sum-income-vat-cost-base: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-base    )
     2026                       + "   " + "sum-income-vat-cost-rubl: "      + string( temp_fbrlib_recipe.sum-income-vat-cost-rubl    )
     2027                       + "   " + "count-write-off: "               + string( temp_fbrlib_recipe.count-write-off             )
     2028                       + "   " + "qnty-write-off: "                + string( temp_fbrlib_recipe.qnty-write-off              )
     2029                       + "   " + "sum-write-off-sale: "            + string( temp_fbrlib_recipe.sum-write-off-sale          )
     2030                       + "   " + "sum-write-off-cost-base: "       + string( temp_fbrlib_recipe.sum-write-off-cost-base     )
     2031                       + "   " + "sum-write-off-cost-rubl: "       + string( temp_fbrlib_recipe.sum-write-off-cost-rubl     )
     2032                       + "   " + "sum-write-off-vat-cost-base: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-base )
     2033                       + "   " + "sum-write-off-vat-cost-rubl: "   + string( temp_fbrlib_recipe.sum-write-off-vat-cost-rubl )
     2034                       + chr(10)
     2035           .
     2036           run writelog in this-procedure ( input "fbr.log", input 0, input v-str ).
     2037       end.
     2038   end.
     2039   end procedure.
     2040   procedure fbrlib-s-coeff-value :
     2041   define input  parameter p-gds-code    as integer        no-undo.
     2042   define input  parameter p-date        as date           no-undo.
     2043   define input  parameter p-obj-type    as character      no-undo.
     2044   define input  parameter p-obj-code    as integer        no-undo.
     2045   define output parameter p-coeff-value as decimal        no-undo.
     2046   define variable vss-description as character init "fbrlib-s-coeff-value-01: определяет значение сезонного коэффициента" no-undo.
     2047       define variable v-date          as date         no-undo.
     2048       define variable v-host-code     as integer      no-undo.
     2049       define buffer buf_goods       for ub.goods.
     2050       define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     2051       define buffer buf_clients     for ub.clients.
     2052       define buffer buf_s-coeff     for ub.s-coeff.
     2053   do
     2054   for buf_goods
     2055     , buf_fbr-gds-obj
     2056     , buf_clients
     2057     , buf_s-coeff
     2058   on error undo, return error return-value
     2059   :
     2060       find first buf_goods no-lock
     2061            where buf_goods.gds-code = p-gds-code
     2062       no-error .
     2063       if not available buf_goods
     2064       then do:
     2065          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден товар с кодом &1", p-gds-code).
     2066       end.
     2067       find first buf_clients no-lock
     2068            where buf_clients.obj-type = p-obj-type
     2069              and buf_clients.obj-code = p-obj-code
     2070       no-error.
     2071       if not available buf_clients
     2072       then do:
     2073          undo, return error substitute("Ошибка при определении сезонного коэффициента - не найден объект &1&2", p-obj-type, p-obj-code).
     2074       end.
     2075       assign
     2076           v-date = date(month(p-date), day(p-date), Year(01/01/1996))
     2077       .
     2078       find first buf_fbr-gds-obj no-lock
     2079            where buf_fbr-gds-obj.gds-code = p-gds-code
     2080              and buf_fbr-gds-obj.obj-type = p-obj-type
     2081              and buf_fbr-gds-obj.obj-code = p-obj-code
     2082       no-error.
     2083       if not available buf_fbr-gds-obj
     2084       or buf_fbr-gds-obj.is-season = no
     2085       then do:
     2086           assign
     2087               p-coeff-value = 0
     2088           .
     2089           return.
     2090       end.
     2091   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2092   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2093     (input  p-obj-type
     2094     ,input  p-obj-code
     2095     ,output v-host-code
     2096     )  .
     2097       find last buf_s-coeff no-lock
     2098           where buf_s-coeff.gds-code = p-gds-code
     2099             and buf_s-coeff.host-code = v-host-code
     2100             and buf_s-coeff.obj-type = p-obj-type
     2101             and buf_s-coeff.obj-code = p-obj-code
     2102             and buf_s-coeff.s-date <= v-date
     2103       no-error.
     2104       if available buf_s-coeff
     2105       then do:
     2106           assign
     2107               p-coeff-value = buf_s-coeff.coeff-value
     2108           .
     2109           return.
     2110       end.
     2111       find last buf_s-coeff no-lock
     2112           where buf_s-coeff.gds-code = p-gds-code
     2113             and buf_s-coeff.host-code = v-host-code
     2114             and buf_s-coeff.obj-type = "":U
     2115             and buf_s-coeff.obj-code = 0
     2116             and buf_s-coeff.s-date <= v-date
     2117       no-error.
     2118       if available buf_s-coeff
     2119       then do:
     2120           assign
     2121               p-coeff-value = buf_s-coeff.coeff-value
     2122           .
     2123           return.
     2124       end.
     2125       find last buf_s-coeff no-lock
     2126           where buf_s-coeff.gds-code = p-gds-code
     2127             and buf_s-coeff.host-code = 0
     2128             and buf_s-coeff.obj-type = "":U
     2129             and buf_s-coeff.obj-code = 0
     2130             and buf_s-coeff.s-date <= v-date
     2131       no-error.
     2132       if available buf_s-coeff
     2133       then do:
     2134           assign
     2135               p-coeff-value = buf_s-coeff.coeff-value
     2136           .
     2137       end.
     2138       else do:
     2139           assign
     2140               p-coeff-value = 0
     2141           .
     2142       end.
     2143   end.
     2144   end procedure.
     2145   procedure fbrlib_create-fbr-recipe-gds :
     2146   define input parameter p-doc-code         as character      no-undo.
     2147   define input parameter p-recipe-code      as character      no-undo.
     2148   define input parameter p-prod-type        as character      no-undo.
     2149   define input parameter p-prod-code        as integer        no-undo.
     2150   define input parameter p-artic            as character      no-undo.
     2151   define input parameter p-gds-code         as integer        no-undo.
     2152   define input parameter p-is-waste         as logical        no-undo.
     2153   define input parameter p-proc-number      as integer        no-undo.
     2154   define input parameter p-obj-date         as date           no-undo.
     2155   define input parameter p-obj-type         as character      no-undo.
     2156   define input parameter p-obj-code         as integer        no-undo.
     2157   define input parameter p-calc-method      as decimal        no-undo.
     2158   define input parameter p-coeff-waste      as decimal        no-undo.
     2159   define input parameter p-orig-qnty        as decimal        no-undo.
     2160   define input parameter p-orig-brutto-qnty as decimal        no-undo.
     2161       define variable v-coeff-season  as decimal      no-undo.
     2162       define variable v-void-decimal  as decimal      no-undo.
     2163       define variable v-void-integer  as integer      no-undo.
     2164       define variable v-recipe-type   as character    no-undo.
     2165       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     2166       define buffer buf_goods             for ub.goods.
     2167       define buffer buf_recipe            for ub.recipe.
     2168   do
     2169   for buf_fbr-recipe-gds
     2170     , buf_recipe
     2171     , buf_goods
     2172   on error undo, return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2))
     2173   :
     2174       find first buf_fbr-recipe-gds exclusive-lock
     2175            where buf_fbr-recipe-gds.doc-code    = p-doc-code
     2176              and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     2177              and buf_fbr-recipe-gds.prod-type   = p-prod-type
     2178              and buf_fbr-recipe-gds.prod-code   = p-prod-code
     2179              and buf_fbr-recipe-gds.artic       = p-artic
     2180       no-error.
     2181       if not available buf_fbr-recipe-gds
     2182       then do:
     2183           create buf_fbr-recipe-gds.
     2184           assign
     2185               buf_fbr-recipe-gds.doc-code           = p-doc-code
     2186               buf_fbr-recipe-gds.recipe-code        = p-recipe-code
     2187               buf_fbr-recipe-gds.prod-type          = p-prod-type
     2188               buf_fbr-recipe-gds.prod-code          = p-prod-code
     2189               buf_fbr-recipe-gds.artic              = p-artic
     2190               buf_fbr-recipe-gds.gds-code           = p-gds-code
     2191               buf_fbr-recipe-gds.is-waste           = p-is-waste
     2192               buf_fbr-recipe-gds.proc-number        = p-proc-number
     2193               buf_fbr-recipe-gds.recipe-qnty        = p-orig-qnty
     2194               buf_fbr-recipe-gds.recipe-brutto-qnty = p-orig-brutto-qnty
     2195           .
     2196           find first buf_goods no-lock
     2197                where buf_goods.prod-type = buf_fbr-recipe-gds.prod-type
     2198                  and buf_goods.prod-code = buf_fbr-recipe-gds.prod-code
     2199                  and buf_goods.artic     = buf_fbr-recipe-gds.artic
     2200           .
     2201           run fbrlib-s-coeff-value in this-procedure (
     2202                 input buf_goods.gds-code
     2203               , input p-obj-date
     2204               , input p-obj-type
     2205               , input p-obj-code
     2206               , output v-coeff-season
     2207           ) no-error.
     2208           if error-status:error
     2209           then do:
     2210               return error substitute ("&1 &2 &3", return-value, error-status:get-message(1), error-status:get-message(2)).
     2211           end.
     2212           assign
     2213               buf_fbr-recipe-gds.qnty         = p-orig-qnty
     2214               buf_fbr-recipe-gds.coeff-value  = v-coeff-season
     2215               buf_fbr-recipe-gds.coeff-waste  = p-coeff-waste
     2216           .
     2217           run fbrlib-get-recipe-type in this-procedure (
     2218                 input buf_fbr-recipe-gds.doc-code
     2219               , input buf_fbr-recipe-gds.recipe-code
     2220               , output v-recipe-type
     2221           ).
     2222           if v-recipe-type <> 'производство':U
     2223           then do:
     2224               assign
     2225                   buf_fbr-recipe-gds.coeff-value  = 0
     2226                   buf_fbr-recipe-gds.coeff-waste  = 0
     2227                   buf_fbr-recipe-gds.calc-method  = 1
     2228                   buf_fbr-recipe-gds.brutto-qnty  = buf_fbr-recipe-gds.qnty
     2229               .
     2230           end.
     2231           else do:
     2232               run fbrlib-calc-brutto in this-procedure (
     2233                     input v-recipe-type
     2234                   , input buf_fbr-recipe-gds.qnty
     2235                   , input buf_fbr-recipe-gds.coeff-value
     2236                   , input buf_fbr-recipe-gds.coeff-waste
     2237                   , input 0
     2238                   , input 3
     2239                   , output v-void-decimal
     2240                   , output v-void-decimal
     2241                   , output buf_fbr-recipe-gds.brutto-qnty
     2242                   , output v-void-integer
     2243               ).
     2244               assign
     2245                   buf_fbr-recipe-gds.calc-method  = p-calc-method
     2246               .
     2247               run fbrlib-calc-brutto in this-procedure (
     2248                     input v-recipe-type
     2249                   , input buf_fbr-recipe-gds.qnty
     2250                   , input buf_fbr-recipe-gds.coeff-value
     2251                   , input buf_fbr-recipe-gds.coeff-waste
     2252                   , input buf_fbr-recipe-gds.brutto-qnty
     2253                   , input buf_fbr-recipe-gds.calc-method
     2254                   , output buf_fbr-recipe-gds.qnty
     2255                   , output v-void-decimal
     2256                   , output v-void-decimal
     2257                   , output v-void-integer
     2258               ).
     2259           end.
     2260       end.
     2261   end.
     2262   end procedure.
     2263   procedure fbrlib-set-default-recipe :
     2264   define input parameter p-obj-type   as character    no-undo.
     2265   define input parameter p-obj-code   as integer      no-undo.
     2266   define input parameter p-gds-code   as integer      no-undo.
     2267       define variable v-artic             as character    no-undo.
     2268       define variable v-prod-type         as character    no-undo.
     2269       define variable v-prod-code         as character    no-undo.
     2270       define variable v-recipe-code       as character    no-undo.
     2271       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2272       define variable v-recipe-found      as logical      no-undo.
     2273       define buffer buf_recipe        for ub.recipe.
     2274       define buffer buf_other_recipe  for ub.recipe.
     2275       define buffer buf_goods         for ub.goods.
     2276       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2277   do
     2278   for buf_recipe
     2279     , buf_goods
     2280     , buf_fbr-gds-obj
     2281   on error undo, return error
     2282   :
     2283       find first buf_goods no-lock
     2284            where buf_goods.gds-code = p-gds-code
     2285       .
     2286       run fbrlib-get-obj-recipe in this-procedure (
     2287             input p-obj-type
     2288           , input p-obj-code
     2289           , input p-gds-code
     2290           , output v-recipe-code
     2291       ).
     2292       if v-recipe-code <> ""
     2293       then do:
     2294           find first buf_recipe no-lock
     2295               where buf_recipe.recipe-code = v-recipe-code
     2296           no-error.
     2297           if not available buf_recipe
     2298           then do:
     2299               assign
     2300                   v-recipe-code = ""
     2301               .
     2302           end.
     2303       end.
     2304       if v-recipe-code = ""
     2305       then do:
     2306           find first buf_fbr-gds-obj exclusive-lock
     2307                where buf_fbr-gds-obj.obj-type = p-obj-type
     2308                  and buf_fbr-gds-obj.obj-code = p-obj-code
     2309                  and buf_fbr-gds-obj.gds-code = p-gds-code
     2310           no-error.
     2311           if not available buf_fbr-gds-obj
     2312           then do:
     2313               run ref/fgdsobj1.p (
     2314                     input-output v-fbr-gds-obj-recid
     2315                   , input 'ДОБАВЛЕНИЕ':U
     2316                   , input no
     2317                   , input p-gds-code
     2318                   , input p-obj-type
     2319                   , input p-obj-code
     2320                   , input 0
     2321                   , input ""
     2322                   , input 0
     2323                   , input no
     2324                   , input no
     2325                   , input no
     2326                   , input no
     2327                   , input no
     2328                   , input no
     2329               ) no-error.
     2330               if error-status:error
     2331               then do:
     2332                   message
     2333                           vss-workfile vss-revision vss-description
     2334                       skip "Ошибка изменения атрибутов товара на объекте"
     2335                       skip return-value
     2336                       skip trim(error-status :get-message(1))
     2337                               trim(error-status :get-message(2))
     2338                               trim(error-status :get-message(3))
     2339                   view-as alert-box error.
     2340                   undo, return error .
     2341               end.
     2342               find first buf_fbr-gds-obj exclusive-lock
     2343                    where recid( buf_fbr-gds-obj ) = v-fbr-gds-obj-recid
     2344               .
     2345           end.
     2346           assign
     2347               v-recipe-found = no
     2348           .
     2349           for first buf_recipe no-lock
     2350               where buf_recipe.obj-type    = p-obj-type
     2351                 and buf_recipe.obj-code    = p-obj-code
     2352                 and buf_recipe.artic       = buf_goods.artic
     2353                 and buf_recipe.prod-type   = buf_goods.prod-type
     2354                 and buf_recipe.prod-code   = buf_goods.prod-code
     2355                 and buf_recipe.recipe-type = 'производство':U
     2356                 or (
     2357                     buf_recipe.obj-type    = ""
     2358                 and buf_recipe.obj-code    = 0
     2359                 and buf_recipe.artic       = buf_goods.artic
     2360                 and buf_recipe.prod-type   = buf_goods.prod-type
     2361                 and buf_recipe.prod-code   = buf_goods.prod-code
     2362                 and buf_recipe.recipe-type = 'производство':U
     2363                     )
     2364           :
     2365               assign
     2366                   v-recipe-found = yes
     2367                   buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2368               .
     2369           end.
     2370           if v-recipe-found = no
     2371           then do:
     2372               for first buf_recipe no-lock
     2373                   where buf_recipe.obj-type    = p-obj-type
     2374                     and buf_recipe.obj-code    = p-obj-code
     2375                     and buf_recipe.artic       = buf_goods.artic
     2376                     and buf_recipe.prod-type   = buf_goods.prod-type
     2377                     and buf_recipe.prod-code   = buf_goods.prod-code
     2378                     and buf_recipe.recipe-type <> 'альтернатива':U
     2379                     or (
     2380                         buf_recipe.obj-type    = ""
     2381                     and buf_recipe.obj-code    = 0
     2382                     and buf_recipe.artic       = buf_goods.artic
     2383                     and buf_recipe.prod-type   = buf_goods.prod-type
     2384                     and buf_recipe.prod-code   = buf_goods.prod-code
     2385                     and buf_recipe.recipe-type <> 'альтернатива':U
     2386                         )
     2387               :
     2388                   assign
     2389                       v-recipe-found = yes
     2390                       buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2391                   .
     2392               end.
     2393               if v-recipe-found = no
     2394               then do:
     2395                   for first buf_recipe no-lock
     2396                       where buf_recipe.obj-type    = p-obj-type
     2397                         and buf_recipe.obj-code    = p-obj-code
     2398                         and buf_recipe.artic       = buf_goods.artic
     2399                         and buf_recipe.prod-type   = buf_goods.prod-type
     2400                         and buf_recipe.prod-code   = buf_goods.prod-code
     2401                         or (
     2402                             buf_recipe.obj-type    = ""
     2403                         and buf_recipe.obj-code    = 0
     2404                         and buf_recipe.artic       = buf_goods.artic
     2405                         and buf_recipe.prod-type   = buf_goods.prod-type
     2406                         and buf_recipe.prod-code   = buf_goods.prod-code
     2407                             )
     2408                   :
     2409                       assign
     2410                           v-recipe-found = yes
     2411                           buf_fbr-gds-obj.default-recipe-code = buf_recipe.recipe-code
     2412                       .
     2413                   end.
     2414                   if v-recipe-found = no
     2415                   then do:
     2416                       assign
     2417                           buf_fbr-gds-obj.default-recipe-code = ""
     2418                       .
     2419                   end.
     2420               end.
     2421           end.
     2422       end.
     2423   end.
     2424   end procedure.
     2425   procedure fbrlib-get-obj-recipe :
     2426   define input parameter p-obj-type       as character    no-undo.
     2427   define input parameter p-obj-code       as integer      no-undo.
     2428   define input parameter p-gds-code       as integer      no-undo.
     2429   define output parameter p-recipe-code   as character    no-undo.
     2430       define buffer buf_fbr-gds-obj   for ub.fbr-gds-obj.
     2431   do
     2432   for buf_fbr-gds-obj
     2433   on error undo, return error
     2434   :
     2435       find first buf_fbr-gds-obj no-lock
     2436            where buf_fbr-gds-obj.obj-type = p-obj-type
     2437              and buf_fbr-gds-obj.obj-code = p-obj-code
     2438              and buf_fbr-gds-obj.gds-code = p-gds-code
     2439       no-error.
     2440       if available buf_fbr-gds-obj
     2441       then do:
     2442           assign
     2443               p-recipe-code = buf_fbr-gds-obj.default-recipe-code
     2444           .
     2445       end.
     2446       else do:
     2447           assign
     2448               p-recipe-code = ""
     2449           .
     2450       end.
     2451   end.
     2452   end procedure.
     2453   procedure fbrlib-create-or-update-recipe-gds :
     2454   define input parameter p-recipe-code    as character        no-undo.
     2455   define input parameter p-gds-code       as integer          no-undo.
     2456   define input parameter p-is-waste       as logical          no-undo.
     2457   define input parameter p-qnty           as decimal          no-undo.
     2458   define input parameter p-proc-number    as integer          no-undo.
     2459   define input parameter p-nws-self       as logical          no-undo.
     2460       define variable v-max-proc-num  as integer      no-undo.
     2461       define variable v-recipe-type   as character    no-undo.
     2462       define buffer buf_goods             for ub.goods.
     2463       define buffer buf_recipe-gds        for ub.recipe-gds.
     2464       define buffer buf_recipe            for ub.recipe.
     2465       define buffer buf_proc_recipe-gds   for ub.recipe-gds.
     2466   do
     2467   for buf_goods
     2468     , buf_recipe-gds
     2469     , buf_recipe
     2470     , buf_proc_recipe-gds
     2471   on error undo, return error
     2472   :
     2473       find first buf_recipe no-lock
     2474            where buf_recipe.recipe-code = p-recipe-code
     2475       .
     2476       find first buf_goods no-lock
     2477            where buf_goods.gds-code = p-gds-code
     2478       .
     2479       find first buf_recipe-gds
     2480            where buf_recipe-gds.recipe-code = p-recipe-code
     2481              and buf_recipe-gds.prod-type   = buf_goods.prod-type
     2482              and buf_recipe-gds.prod-code   = buf_goods.prod-code
     2483              and buf_recipe-gds.artic       = buf_goods.artic
     2484       no-error.
     2485       if not available buf_recipe-gds
     2486       then do:
     2487           create buf_recipe-gds.
     2488           assign
     2489               buf_recipe-gds.recipe-code = p-recipe-code
     2490               buf_recipe-gds.gds-code    = p-gds-code
     2491               buf_recipe-gds.prod-type   = buf_goods.prod-type
     2492               buf_recipe-gds.prod-code   = buf_goods.prod-code
     2493               buf_recipe-gds.artic       = buf_goods.artic
     2494           .
     2495           assign
     2496               buf_recipe-gds.is-waste    = no
     2497               buf_recipe-gds.qnty        = 0
     2498               buf_recipe-gds.coeff-waste = 0
     2499               buf_recipe-gds.brutto-qnty = 0
     2500               buf_recipe-gds.proc-number = 0
     2501               buf_recipe-gds.nws-self    = no
     2502           .
     2503       end.
     2504       assign
     2505           buf_recipe-gds.is-waste    = p-is-waste
     2506       .
     2507       run fbrlib-get-recipe-type in this-procedure (
     2508             input "":U
     2509           , input buf_recipe-gds.recipe-code
     2510           , output v-recipe-type
     2511       ).
     2512       if v-recipe-type <> 'производство':U
     2513       then do:
     2514           assign
     2515               buf_recipe-gds.calc-method = 1
     2516               buf_recipe-gds.qnty        = p-qnty
     2517               buf_recipe-gds.brutto-qnty = p-qnty
     2518               buf_recipe-gds.coeff-waste = 0
     2519           .
     2520       end.
     2521       else do:
     2522           assign
     2523               buf_recipe-gds.calc-method = 1
     2524               buf_recipe-gds.brutto-qnty = p-qnty
     2525           .
     2526           run fbrlib-calc-brutto in this-procedure (
     2527                 input v-recipe-type
     2528               , input 0
     2529               , input 0
     2530               , input buf_recipe-gds.coeff-waste
     2531               , input buf_recipe-gds.brutto-qnty
     2532               , input 1
     2533               , output buf_recipe-gds.qnty
     2534               , output buf_recipe-gds.coeff-waste
     2535               , output buf_recipe-gds.brutto-qnty
     2536               , output buf_recipe-gds.calc-method
     2537           ).
     2538       end.
     2539       assign
     2540           buf_recipe-gds.nws-self    = p-nws-self
     2541       .
     2542       if buf_recipe.recipe-type = 'альтернатива':U
     2543       and buf_recipe-gds.proc-number <> 0
     2544       then do:
     2545       end.
     2546       else do:
     2547           if p-proc-number <> 0
     2548           then do:
     2549               assign
     2550                   buf_recipe-gds.proc-number = p-proc-number
     2551               .
     2552           end.
     2553           else do:
     2554               assign
     2555                   v-max-proc-num = 0
     2556               .
     2557               for each buf_proc_recipe-gds no-lock
     2558                  where buf_proc_recipe-gds.recipe-code = p-recipe-code
     2559               :
     2560                   if recid( buf_proc_recipe-gds ) <> recid( buf_recipe-gds )
     2561                   then do:
     2562                       assign
     2563                           v-max-proc-num = ( if v-max-proc-num < buf_proc_recipe-gds.proc-number then buf_proc_recipe-gds.proc-number else v-max-proc-num )
     2564                       .
     2565                   end.
     2566               end.
     2567               assign
     2568                   buf_recipe-gds.proc-number = v-max-proc-num + 1
     2569               .
     2570           end.
     2571       end.
     2572   end.
     2573   end procedure.
     2574   PROCEDURE fbrlib-create-or-update-recipe :
     2575   define input parameter p-mode               as character    no-undo.
     2576   define input parameter p-obj-type           as character    no-undo.
     2577   define input parameter p-obj-code           as integer      no-undo.
     2578   define input parameter p-recipe-code        as character    no-undo.
     2579   define input parameter p-recipe-type        as character    no-undo.
     2580   define input parameter p-gds-code           as integer      no-undo.
     2581   define input parameter p-name               as character    no-undo.
     2582   define input parameter p-design             as character    no-undo.
     2583   define input parameter p-order              as integer      no-undo.
     2584   define input parameter p-quality            as character    no-undo.
     2585   define input parameter p-ref-num            as character    no-undo.
     2586   define input parameter p-technique          as character    no-undo.
     2587   define input parameter p-template           as character    no-undo.
     2588   define input parameter p-qnty               as decimal      no-undo.
     2589   define input parameter p-portion-qnty       as integer      no-undo.
     2590   define input parameter p-portion-weight     as decimal      no-undo.
     2591   define output parameter p-new-recipe-code   as character    no-undo.
     2592       define variable v-host-code         as integer      no-undo.
     2593       define variable v-fbr-gds-obj-recid as recid        no-undo.
     2594       define buffer buf_recipe    for ub.recipe.
     2595       define buffer buf_goods     for ub.goods.
     2596   do
     2597   for buf_recipe
     2598     , buf_goods
     2599   on error undo, return error
     2600   :
     2601       if p-mode <> 'ДОБАВЛЕНИЕ':U
     2602       and p-mode <> 'ИЗМЕНЕНИЕ':U
     2603       then do:
     2604           message
     2605               skip "Ошибка задания типа операции для создания или измения рецепта."
     2606               skip (1)
     2607               skip "Задан тип операции:" p-mode
     2608           view-as alert-box error.
     2609           undo, return error .
     2610       end.
     2611       if p-recipe-code = ""
     2612       then do:
     2613   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2614   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2615     (input  p-obj-type
     2616     ,input  p-obj-code
     2617     ,output v-host-code
     2618     )  .
     2619           find first buf_goods no-lock
     2620                where buf_goods.gds-code = p-gds-code
     2621           .
     2622           create buf_recipe .
     2623           run fbrcode-gen-recipe-code in this-procedure (
     2624                 input p-obj-type
     2625               , input p-obj-code
     2626               , output buf_recipe.recipe-code
     2627           ).
     2628           assign
     2629               buf_recipe.artic               = buf_goods.artic
     2630               buf_recipe.prod-type           = buf_goods.prod-type
     2631               buf_recipe.prod-code           = buf_goods.prod-code
     2632               buf_recipe.recipe-type         = p-recipe-type
     2633               buf_recipe.recipe-name         = ( if p-name = "" then buf_goods.gds-name else p-name )
     2634               buf_recipe.gds-code            = p-gds-code
     2635               buf_recipe.host-code           = v-host-code
     2636               buf_recipe.obj-type            = p-obj-type
     2637               buf_recipe.obj-code            = p-obj-code
     2638               buf_recipe.recipe-design       = ""
     2639               buf_recipe.recipe-order        = 0
     2640               buf_recipe.recipe-quality      = ""
     2641               buf_recipe.recipe-ref-num      = ""
     2642               buf_recipe.recipe-technique    = ""
     2643               buf_recipe.recipe-template     = ""
     2644               buf_recipe.qnty                = 1.0
     2645               buf_recipe.portion-qnty        = 1
     2646               buf_recipe.portion-weight      = 0
     2647           .
     2648       end.
     2649       if p-name <> ""
     2650       then do:
     2651           assign
     2652               buf_recipe.recipe-name = p-name
     2653           .
     2654       end.
     2655       assign
     2656           buf_recipe.recipe-design       = p-design
     2657           buf_recipe.recipe-order        = p-order
     2658           buf_recipe.recipe-quality      = p-quality
     2659           buf_recipe.recipe-ref-num      = p-ref-num
     2660           buf_recipe.recipe-technique    = p-technique
     2661           buf_recipe.recipe-template     = p-template
     2662           buf_recipe.qnty                = p-qnty
     2663           buf_recipe.portion-qnty        = p-portion-qnty
     2664           buf_recipe.portion-weight      = p-portion-weight
     2665       .
     2666       assign
     2667           p-new-recipe-code = buf_recipe.recipe-code
     2668       .
     2669       run fbrlib-set-default-recipe in this-procedure (
     2670             input p-obj-type
     2671           , input p-obj-code
     2672           , input buf_goods.gds-code
     2673       ).
     2674   end.
     2675   END PROCEDURE.
     2676   PROCEDURE fbrlib-delete-fact-fbr-doc :
     2677   define input parameter parparentproc-handle as widget-handle no-undo .
     2678   define input parameter p-doc-code   as character no-undo.
     2679   define input parameter p-chip-num   like ub.c-trn-doc.chip-num no-undo .
     2680       define variable v-shift-on      as logical      no-undo.
     2681       define variable v-shift-date    as date         no-undo.
     2682       define variable v-shift-num     as integer      no-undo.
     2683       define variable v-shift-name    as character    no-undo.
     2684       define variable v-obj-date      as date         no-undo.
     2685       define variable v-chip-num      as integer      no-undo.
     2686       define buffer buf_fbr-doc       for ub.fbr-doc.
     2687       define buffer buf_fbr-line      for ub.fbr-line.
     2688       define buffer buf_c-fbr-doc     for ub.c-fbr-doc.
     2689       define buffer buf_fbr-recipe     for ub.fbr-recipe.
     2690       define buffer buf_fbr-recipe-gds for ub.fbr-recipe-gds.
     2691       define buffer buf_marking-lines for ub.marking-lines .
     2692       define buffer buf_marking       for ub.marking .
     2693       define buffer buf_goods         for ub.goods .
     2694   do
     2695   for buf_fbr-doc
     2696     , buf_fbr-line
     2697     , buf_c-fbr-doc
     2698     , buf_fbr-recipe
     2699     , buf_fbr-recipe-gds
     2700     , buf_goods
     2701     , buf_marking
     2702     , buf_marking-lines
     2703   on error undo, return error
     2704   :
     2705   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2706     define variable v-cntxt-db-num        as integer   no-undo .
     2707     define variable v-cntxt-userid        as character no-undo .
     2708     define variable v-cntxt-level         as character no-undo .
     2709     define variable v-cntxt-host-code-obj as integer   no-undo .
     2710     define variable v-cntxt-obj-type      as character no-undo .
     2711     define variable v-cntxt-obj-code      as integer   no-undo .
     2712     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2713     define variable v-cntxt-is-admin      as logical   no-undo .
     2714   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2715     run mainmenu_getcntxt in parparentproc-handle
     2716       (output v-cntxt-db-num
     2717       ,output v-cntxt-userid
     2718       ,output v-cntxt-level
     2719       ,output v-cntxt-host-code-obj
     2720       ,output v-cntxt-obj-type
     2721       ,output v-cntxt-obj-code
     2722       ,output v-cntxt-db-num-obj
     2723       ,output v-cntxt-is-admin
     2724       ) .
     2725       if search ("delfbr.err") <> ?
     2726       then do:
     2727           os-delete "delfbr.err".
     2728       end.
     2729     _del-block:
     2730       do transaction
     2731     on error undo _del-block, return error return-value
     2732     on endkey undo _del-block , return error return-value
     2733     on stop undo _del-block , return error return-value
     2734       :
     2735           find first buf_fbr-doc exclusive-lock
     2736                where buf_fbr-doc.doc-code = p-doc-code
     2737           no-error.
     2738           if not available buf_fbr-doc
     2739           then do:
     2740         undo _del-block, return error substitute("&1 &2 &3&4Не найден документ производства &5 для удаления."
     2741                                           ,vss-workfile
     2742                                           ,vss-revision
     2743                                           ,vss-description
     2744                                           ,chr(10)
     2745                                           , p-doc-code).
     2746           end.
     2747           run fbrlib-delete-fact-trn-doc in this-procedure (
     2748               input parparentproc-handle
     2749              ,input p-doc-code
     2750              ,input 'при':U
     2751              ,input p-chip-num
     2752              ,output v-chip-num
     2753           ) no-error.
     2754           if error-status :error
     2755           then do:
     2756               run fbrlib-print-del-error-message in this-procedure .
     2757         undo _del-block, return error.
     2758           end.
     2759           assign
     2760           p-chip-num = (if p-chip-num = ?
     2761                         then v-chip-num
     2762                         else p-chip-num).
     2763           run fbrlib-delete-fact-trn-doc in this-procedure (
     2764               input parparentproc-handle
     2765              ,input p-doc-code
     2766              ,input 'рас':U
     2767              ,input p-chip-num
     2768              ,output v-chip-num
     2769           ) no-error.
     2770           if error-status :error
     2771           then do:
     2772               run fbrlib-print-del-error-message in this-procedure .
     2773         undo _del-block, return error.
     2774           end.
     2775           run fbrlib-delete-fact-trn-doc in this-procedure (
     2776               input parparentproc-handle
     2777              ,input p-doc-code
     2778              ,input 'спи':U
     2779              ,input p-chip-num
     2780              ,output v-chip-num
     2781           ) no-error.
     2782           if error-status :error
     2783           then do:
     2784               run fbrlib-print-del-error-message in this-procedure .
     2785         undo _del-block, return error.
     2786           end.
     2787           create buf_c-fbr-doc.
     2788           buffer-copy buf_fbr-doc to buf_c-fbr-doc.
     2789   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2790   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     2791     (input  buf_fbr-doc.obj-type
     2792     ,input  buf_fbr-doc.obj-code
     2793     ,output v-obj-date
     2794     ) no-error .
     2795           if error-status :error
     2796           or v-obj-date = ?
     2797           then do:
     2798         undo _del-block, return error "Нет текущей даты на объекте документа.".
     2799           end.
     2800   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2801   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     2802     (input  buf_fbr-doc.obj-type
     2803     ,input  buf_fbr-doc.obj-code
     2804     ,input  'shift-on=request'
     2805     ,output v-shift-on
     2806     )  .
     2807           if v-shift-on
     2808           then do:
     2809   define variable vss-include-info28 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curshift in g#library
     2811     (input  buf_fbr-doc.obj-type
     2812     ,input  buf_fbr-doc.obj-code
     2813     ,output v-shift-date
     2814     ,output v-shift-num
     2815     ,output v-shift-name
     2816     ) no-error .
     2817               if error-status :error
     2818               then do:
     2819           undo _del-block, return error "Ошибка при поиске текущей смены на объекте".
     2820               end.
     2821           end.
     2822           else do:
     2823               assign
     2824                   v-shift-date = ?
     2825                   v-shift-num  = ?
     2826                   v-shift-name = ?
     2827               .
     2828           end.
     2829           define variable v-today       as date         no-undo.
     2830           define variable v-time        as integer      no-undo.
     2831           run cur-time in this-procedure (
     2832                 output v-today
     2833               , output v-time
     2834           ).
     2835           assign
     2836               buf_c-fbr-doc.chip-num         = (if p-chip-num <> ? then p-chip-num else next-value( s-corr-chip, ub  ))
     2837               buf_c-fbr-doc.corr-user-name   = v-cntxt-userid
     2838               buf_c-fbr-doc.corr-user-db-num = v-cntxt-db-num
     2839               buf_c-fbr-doc.corr-date        = v-today
     2840               buf_c-fbr-doc.corr-time        = v-time
     2841               buf_c-fbr-doc.corr-shift-date  = v-shift-date
     2842               buf_c-fbr-doc.corr-shift-num   = v-shift-num
     2843               buf_c-fbr-doc.corr-shift-name  = v-shift-name
     2844               buf_c-fbr-doc.is-del           = yes
     2845           .
     2846           assign
     2847               buf_fbr-doc.is-del = yes
     2848           .
     2849           for each buf_fbr-line exclusive-lock
     2850              where buf_fbr-line.doc-code = p-doc-code
     2851       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2852       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2853       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2854           :
     2855               for first buf_goods no-lock where buf_goods.artic      = buf_fbr-line.artic
     2856                                             and buf_goods.prod-type  = buf_fbr-line.prod-type
     2857                                             and buf_goods.prod-code  = buf_fbr-line.prod-code,
     2858               each buf_marking-lines exclusive-lock where buf_marking-lines.gds-code = buf_goods.gds-code
     2859                                                       and buf_marking-lines.obj-type = buf_fbr-doc.obj-type
     2860                                                       and buf_marking-lines.obj-code = buf_fbr-doc.obj-code
     2861                                                       and buf_marking-lines.in-code  = "manufacturing"
     2862                                                       and buf_marking-lines.out-code = buf_fbr-line.doc-code
     2863                                                       and buf_marking-lines.part-code = buf_fbr-line.recipe-code
     2864                                                       and buf_marking-lines.prt-code = 0
     2865               :
     2866                 for first buf_marking exclusive-lock where buf_marking.mark begins buf_marking-lines.mark :
     2867                   assign
     2868                     buf_marking.sts = objSrv:Env:Marking:Sts:Mark:UsedInProduction:KeyIntDB when buf_fbr-line.is-comp
     2869                   .
     2870                 end .
     2871                 delete buf_marking-lines.
     2872               end .
     2873               delete buf_fbr-line.
     2874           end.
     2875           for each buf_fbr-recipe exclusive-lock
     2876              where buf_fbr-recipe.doc-code = p-doc-code
     2877       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2878       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2879       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2880           :
     2881               delete buf_fbr-recipe.
     2882           end.
     2883           for each buf_fbr-recipe-gds exclusive-lock
     2884              where buf_fbr-recipe-gds.doc-code = p-doc-code
     2885       on error  undo _del-block, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message (1))
     2886       on stop   undo _del-block, return error substitute( "&1. stop", vss-workfile )
     2887       on endkey undo _del-block, return error substitute( "&1. endkey", vss-workfile )
     2888           :
     2889               delete buf_fbr-recipe-gds.
     2890           end.
     2891           delete buf_fbr-doc.
     2892       end.
     2893   end.
     2894   END PROCEDURE.
     2895   PROCEDURE fbrlib-del-trn-doc :
     2896   do
     2897   on error undo, return error
     2898   :
     2899   define input parameter parparentproc        as widget-handle no-undo .
     2900   define input parameter p-fbr-doc-doc-code   as character    no-undo.
     2901   define input parameter p-trn-doc-type       as character    no-undo.
     2902   define input parameter p-phchip-num         like ub.c-trn-doc.chip-num no-undo .
     2903   define output parameter p-chip-num           like ub.c-trn-doc.chip-num no-undo .
     2904       define variable v-trn-doc-doc-code  as character     no-undo.
     2905       define buffer buf_trn-doc       for ub.trn-doc.
     2906   define variable vss-include-info29 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2907     define variable v-cntxt-db-num        as integer   no-undo .
     2908     define variable v-cntxt-userid        as character no-undo .
     2909     define variable v-cntxt-level         as character no-undo .
     2910     define variable v-cntxt-host-code-obj as integer   no-undo .
     2911     define variable v-cntxt-obj-type      as character no-undo .
     2912     define variable v-cntxt-obj-code      as integer   no-undo .
     2913     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2914     define variable v-cntxt-is-admin      as logical   no-undo .
     2915   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2916     run mainmenu_getcntxt in parparentproc
     2917       (output v-cntxt-db-num
     2918       ,output v-cntxt-userid
     2919       ,output v-cntxt-level
     2920       ,output v-cntxt-host-code-obj
     2921       ,output v-cntxt-obj-type
     2922       ,output v-cntxt-obj-code
     2923       ,output v-cntxt-db-num-obj
     2924       ,output v-cntxt-is-admin
     2925       ) .
     2926       run fbrcode-trn-doc in this-procedure (
     2927             input 'производство':U
     2928           , input p-fbr-doc-doc-code
     2929           , input p-trn-doc-type
     2930           , output v-trn-doc-doc-code
     2931       ).
     2932       find first buf_trn-doc no-lock
     2933            where buf_trn-doc.doc-code = v-trn-doc-doc-code
     2934       no-error.
     2935       if available buf_trn-doc
     2936       then do:
     2937           run str/del-doc.p (
     2938                 input parparentproc
     2939               , input buf_trn-doc.doc-code
     2940               , input v-cntxt-db-num
     2941               , input "del-doc.err"
     2942               , input ?
     2943               , input p-fbr-doc-doc-code
     2944               , input v-cntxt-userid
     2945               , input 0
     2946               , input p-phchip-num
     2947               , output p-chip-num
     2948           ) no-error.
     2949           if error-status :error
     2950           then do:
     2951             undo, return error substitute("Не удалось удалить складской документ &1, созданный по документу производства &2.&3&4&3&5"
     2952                                           ,v-trn-doc-doc-code
     2953                                           ,p-fbr-doc-doc-code
     2954                                           , chr(10)
     2955                                           , error-status:get-message(1)
     2956                                           , return-value ).
     2957           end.
     2958       end.
     2959   end.
     2960   END PROCEDURE.
     2961   PROCEDURE fbrlib-delete-fact-trn-doc :
     2962   define input parameter parparentproc    as widget-handle    no-undo.
     2963   define input parameter p-fbr-doc-code   as character        no-undo.
     2964   define input parameter p-doc-type       as character    no-undo.
     2965   define input parameter p-ph-chip-num       like ub.c-trn-doc.chip-num no-undo .
     2966   define output parameter p-chip-num      like ub.c-trn-doc.chip-num no-undo .
     2967       define variable v-doc-code          as character        no-undo.
     2968       define variable v-ext-doc-type      as character        no-undo.
     2969       define variable v-trn-doc-recid     as recid            no-undo.
     2970       define variable varchip-code        as integer          no-undo.
     2971       define variable varchip-code2       as integer          no-undo.
     2972       define variable v-chip-counter      as integer          no-undo.
     2973       define buffer buf_trn-doc       for ub.trn-doc.
     2974       define buffer buf_pri_trn-doc   for ub.trn-doc.
     2975       define buffer buf_cons_trn-doc  for ub.trn-doc.
     2976   do
     2977   for buf_trn-doc
     2978     , buf_pri_trn-doc
     2979     , buf_cons_trn-doc
     2980   on error undo, return error
     2981   :
     2982   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2983     define variable v-cntxt-db-num        as integer   no-undo .
     2984     define variable v-cntxt-userid        as character no-undo .
     2985     define variable v-cntxt-level         as character no-undo .
     2986     define variable v-cntxt-host-code-obj as integer   no-undo .
     2987     define variable v-cntxt-obj-type      as character no-undo .
     2988     define variable v-cntxt-obj-code      as integer   no-undo .
     2989     define variable v-cntxt-db-num-obj    as integer   no-undo .
     2990     define variable v-cntxt-is-admin      as logical   no-undo .
     2991   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2992     run mainmenu_getcntxt in parparentproc
     2993       (output v-cntxt-db-num
     2994       ,output v-cntxt-userid
     2995       ,output v-cntxt-level
     2996       ,output v-cntxt-host-code-obj
     2997       ,output v-cntxt-obj-type
     2998       ,output v-cntxt-obj-code
     2999       ,output v-cntxt-db-num-obj
     3000       ,output v-cntxt-is-admin
     3001       ) .
     3002       run fbrcode-trn-doc in this-procedure (
     3003             input 'производство':U
     3004           , input p-fbr-doc-code
     3005           , input p-doc-type
     3006           , output v-doc-code
     3007       ).
     3008       find first buf_trn-doc no-lock
     3009            where buf_trn-doc.doc-code = v-doc-code
     3010       no-error.
     3011       if not available buf_trn-doc
     3012       then do:
     3013           if p-doc-type <> 'спи':U
     3014           then do:
     3015               message
     3016                   "Не найден документ '" p-doc-type "'"
     3017                   "по документу производства " p-fbr-doc-code
     3018               view-as alert-box.
     3019               undo, return error.
     3020           end.
     3021           else do:
     3022           end.
     3023       end.
     3024       else do:
     3025           assign
     3026               v-trn-doc-recid = recid( buf_trn-doc )
     3027               v-ext-doc-type  = buf_trn-doc.ext-doc-type
     3028           .
     3029           if v-ext-doc-type = 'ev':U
     3030           then do:
     3031               find first buf_pri_trn-doc no-lock
     3032                    where buf_pri_trn-doc.out-code     = v-doc-code
     3033                      and buf_pri_trn-doc.ext-doc-type = 'iv':U
     3034               no-error.
     3035               if available buf_pri_trn-doc
     3036               then do:
     3037                   run str/del-doc.p (
     3038                         input parparentproc
     3039                       , input buf_pri_trn-doc.doc-code
     3040                       , input v-cntxt-db-num
     3041                       , input "delfbr.err"
     3042                       , input ?
     3043                       , input p-fbr-doc-code
     3044                       , input v-cntxt-userid
     3045                       , input 0
     3046                       , input (if p-ph-chip-num <> ?
     3047                               then p-ph-chip-num
     3048                               else (if varchip-code <> 0
     3049                                   then varchip-code
     3050                                   else ?)
     3051                               )
     3052                       , output varchip-code2
     3053                   ) no-error.
     3054                   if error-status :error
     3055                   then do:
     3056                     undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3057                                                   ,buf_pri_trn-doc.doc-code
     3058                                                   ,p-fbr-doc-code
     3059                                                   , chr(10)
     3060                                                   , error-status:get-message(1)
     3061                                                   , return-value ).
     3062                   end.
     3063               end.
     3064           end.
     3065           define buffer buf_out_trn-doc       for ub.trn-doc.
     3066           if p-doc-type = 'при':U
     3067           then do:
     3068               assign
     3069                   v-chip-counter = 0
     3070               .
     3071               for each buf_out_trn-doc exclusive-lock
     3072                  where buf_out_trn-doc.out-code = buf_trn-doc.doc-code
     3073               on error undo, return error
     3074               :
     3075                   assign
     3076                       v-chip-counter = v-chip-counter + 1
     3077                   .
     3078                   if v-chip-counter > 1
     3079                   then do:
     3080                       assign
     3081                           varchip-code = varchip-code2
     3082                       .
     3083                   end.
     3084                   run str/del-doc.p (
     3085                         input parparentproc
     3086                       , input buf_out_trn-doc.doc-code
     3087                       , input v-cntxt-db-num
     3088                       , input "delfbr.err"
     3089                       , input ?
     3090                       , input p-fbr-doc-code
     3091                       , input v-cntxt-userid
     3092                       , input 0
     3093                       , input (if p-ph-chip-num <> ?
     3094                               then p-ph-chip-num
     3095                               else (if varchip-code <> 0
     3096                                   then varchip-code
     3097                                   else ?)
     3098                               )
     3099                       , output varchip-code2
     3100                   ) no-error.
     3101                   if error-status :error
     3102                   then do:
     3103                     undo, return error substitute("Ошибка при удалении складского документа &1, связанного со складским документов прихода &2, созданный по документу производства &3.&4&5&4&6"
     3104                                                   ,buf_out_trn-doc.doc-code
     3105                                                   ,buf_trn-doc.doc-code
     3106                                                   ,p-fbr-doc-code
     3107                                                   , chr(10)
     3108                                                   , error-status:get-message(1)
     3109                                                   , return-value ).
     3110                   end.
     3111               end.
     3112           end.
     3113           run str/del-doc.p (
     3114                 input parparentproc
     3115               , input buf_trn-doc.doc-code
     3116               , input v-cntxt-db-num
     3117               , input "delfbr.err"
     3118               , input ?
     3119               , input p-fbr-doc-code
     3120               , input v-cntxt-userid
     3121               , input 0
     3122               , input (if p-ph-chip-num <> ?
     3123                        then p-ph-chip-num
     3124                        else (if varchip-code <> 0
     3125                              then varchip-code
     3126                              else ?)
     3127                        )
     3128               , output varchip-code2
     3129           ) no-error.
     3130           if error-status :error
     3131           then do:
     3132               undo, return error substitute("Ошибка при удалении складского документа &1, созданный по документу производства &2.&3&4&3&5"
     3133                                             ,buf_trn-doc.doc-code
     3134                                             ,p-fbr-doc-code
     3135                                             , chr(10)
     3136                                             , error-status:get-message(1)
     3137                                             , return-value ).
     3138           end.
     3139           if p-doc-type = 'рас':U
     3140           or p-doc-type = 'спи':U
     3141           then do:
     3142               assign
     3143                   v-chip-counter = 0
     3144               .
     3145               for each buf_cons_trn-doc no-lock
     3146                  where buf_cons_trn-doc.out-code      = v-doc-code
     3147                    and buf_cons_trn-doc.ext-doc-type  = 'pc':U
     3148               :
     3149                   assign
     3150                       v-trn-doc-recid = recid( buf_cons_trn-doc )
     3151                       v-chip-counter = v-chip-counter + 1
     3152                   .
     3153                   assign
     3154                   varchip-code = if v-chip-counter = 2
     3155                                  then varchip-code2
     3156                                  else varchip-code.
     3157                   run str/del-doc.p (
     3158                         input parparentproc
     3159                       , input buf_cons_trn-doc.doc-code
     3160                       , input v-cntxt-db-num
     3161                       , input "delfbr.err"
     3162                       , input ?
     3163                       , input ?
     3164                       , input v-cntxt-userid
     3165                       , input 0
     3166                       , input (if p-ph-chip-num <> ?
     3167                                then p-ph-chip-num
     3168                                else ( if v-chip-counter = 1
     3169                                       then ?
     3170                                       else varchip-code )
     3171                                )
     3172                       , output varchip-code2
     3173                   ) no-error.
     3174                   if error-status :error
     3175                   then do:
     3176                       undo, return error substitute("Ошибка при удалении складского документа смены типа приобретения &1, созданный по документу производства &2.&3&4&3&5"
     3177                                                     ,buf_cons_trn-doc.doc-code
     3178                                                     ,p-fbr-doc-code
     3179                                                     , chr(10)
     3180                                                     , error-status:get-message(1)
     3181                                                     , return-value ).
     3182                   end.
     3183                   assign
     3184                       p-chip-num = varchip-code2
     3185                   .
     3186               end.
     3187           end.
     3188           assign
     3189               p-chip-num = varchip-code2
     3190           .
     3191       end.
     3192   end.
     3193   END PROCEDURE.
     3194   PROCEDURE fbrlib-print-del-error-message :
     3195   do
     3196   on error undo, return error
     3197   :
     3198       define variable v-user-action   as character    no-undo.
     3199       define variable v-printed       as logical      no-undo.
     3200       message
     3201           vss-workfile vss-revision vss-description
     3202           skip "Ошибка при удалении документа."
     3203           skip return-value
     3204           skip trim(error-status :get-message(1))
     3205           skip trim(error-status :get-message(2))
     3206           skip trim(error-status :get-message(3))
     3207       view-as alert-box error.
     3208       if search ("delfbr.err") <> ?
     3209       then do:
     3210         run gbl/prnfilen.w
     3211           (input  "Ошибки при удалении документа производства"
     3212           ,input  0
     3213           ,input  "delfbr.err"
     3214           ,input  7
     3215           ,output v-user-action
     3216           ,output v-printed
     3217           ).
     3218       end.
     3219   end.
     3220   END PROCEDURE.
     3221   procedure fbrlib-calc-brutto :
     3222   define input parameter p-recipe-type        as character        no-undo.
     3223   define input parameter p-netto              as decimal          no-undo.
     3224   define input parameter p-coeff-value        as decimal          no-undo.
     3225   define input parameter p-coeff-waste        as decimal          no-undo.
     3226   define input parameter p-brutto             as decimal          no-undo.
     3227   define input parameter p-calc-method        as integer          no-undo.
     3228   define output parameter p-new-netto         as decimal          no-undo.
     3229   define output parameter p-new-coeff-waste   as decimal          no-undo.
     3230   define output parameter p-new-brutto        as decimal          no-undo.
     3231   define output parameter p-new-calc-method   as integer          no-undo.
     3232   do
     3233   on error undo, return error
     3234   :
     3235       if p-recipe-type <> 'производство':U
     3236       then do:
     3237           assign
     3238               p-new-coeff-waste = 0
     3239               p-new-calc-method = 1
     3240               p-new-netto       = ( if p-calc-method = 1 then p-brutto else p-netto )
     3241               p-new-brutto      = ( if p-calc-method = 1 then p-brutto else p-netto )
     3242           .
     3243       end.
     3244       else do:
     3245           assign
     3246               p-new-calc-method = p-calc-method
     3247           .
     3248           if p-coeff-waste = 0
     3249           then do:
     3250               assign
     3251                   p-coeff-value = 0
     3252               .
     3253           end.
     3254           case p-calc-method
     3255           :
     3256               when 1
     3257               then do:
     3258                   assign
     3259                       p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3260                       p-new-coeff-waste   = p-coeff-waste
     3261                       p-new-brutto        = p-brutto
     3262                   .
     3263               end.
     3264               when 2
     3265               then do:
     3266                   assign
     3267                       p-new-netto         = p-netto
     3268                       p-new-coeff-waste   = 100 - p-coeff-value - ( 100 * p-netto / p-brutto )
     3269                       p-new-brutto        = p-brutto
     3270                   .
     3271               end.
     3272               when 3
     3273               then do:
     3274                   assign
     3275                       p-new-netto         = p-netto
     3276                       p-new-coeff-waste   = p-coeff-waste
     3277                       p-new-brutto        = 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste )
     3278                   .
     3279               end.
     3280               otherwise do:
     3281                   define variable v-yesno    as logical      no-undo.
     3282                   assign
     3283                       v-yesno = yes
     3284                   .
     3285                   message
     3286                       "Неверный метод для расчета брутто, нетто и процента потерь."
     3287                       skip "Значение метода должно быть 1, 2 или 3."
     3288                       skip(1)
     3289                       skip "Заданное значение:" p-calc-method
     3290                       skip(1)
     3291                       skip "Установить значение метода расчета 1"
     3292                       skip "(расчет нетто по брутто и проценту потерь)?"
     3293                   view-as alert-box warning
     3294                   buttons yes-no
     3295                   title "Неверное значение метода пересчета в строках документа-производства"
     3296                   update v-yesno
     3297                   .
     3298                   if v-yesno = yes
     3299                   then do:
     3300                       assign
     3301                           p-new-calc-method   = 1
     3302                           p-new-netto         = p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100
     3303                           p-new-coeff-waste   = p-coeff-waste
     3304                           p-new-brutto        = p-brutto
     3305                       .
     3306                   end.
     3307                   else do:
     3308                       message
     3309                               vss-workfile vss-revision vss-description
     3310                           skip(1)
     3311                           skip "Ошибка расчета брутто, нетто и процента потерь."
     3312                           skip return-value
     3313                           skip trim(error-status :get-message(1))
     3314                               trim(error-status :get-message(2))
     3315                               trim(error-status :get-message(3))
     3316                       view-as alert-box error
     3317                       title "Неверное значение метода расчета"
     3318                       .
     3319                       undo, return error .
     3320                   end.
     3321               end.
     3322           end case.
     3323       end.
     3324   end.
     3325   end procedure.
     3326   procedure fbrlib-check-brutto :
     3327   define input parameter p-recipe-type        as character        no-undo.
     3328   define input parameter p-netto              as decimal          no-undo.
     3329   define input parameter p-coeff-value        as decimal          no-undo.
     3330   define input parameter p-coeff-waste        as decimal          no-undo.
     3331   define input parameter p-brutto             as decimal          no-undo.
     3332   define input parameter p-calc-method        as integer          no-undo.
     3333   define output parameter p-error-message     as character        no-undo.
     3334   define output parameter p-not-good          as logical          no-undo.
     3335   do
     3336   on error undo, return error
     3337   :
     3338       if p-recipe-type <> 'производство':U
     3339       then do:
     3340           if p-netto <> p-brutto
     3341           or p-coeff-waste <> 0
     3342           then do:
     3343               assign
     3344                   p-not-good      = yes
     3345                   p-error-message = substitute( "Во всех рецептах кроме рецепта производства должно выполняться:&1брутто = нетто и процент потерь = 0.&1&1Тип рецепта: &2&1Брутто: &3&1Нетто: &4&1Процент потерь: &5"
     3346                                           , chr(10), p-recipe-type, p-brutto, p-netto, p-coeff-waste )
     3347               .
     3348           end.
     3349       end.
     3350       else do:
     3351           if p-coeff-waste = 0
     3352           then do:
     3353               assign
     3354                   p-coeff-value = 0
     3355               .
     3356           end.
     3357           case p-calc-method
     3358           :
     3359               when 1
     3360               then do:
     3361                   if round( p-netto, 9 ) <> round( p-brutto * ( 100 - p-coeff-value - p-coeff-waste ) / 100, 9 )
     3362                   then do:
     3363                       assign
     3364                           p-not-good      = yes
     3365                           p-error-message = substitute( "Ошибка расчета нетто ( &2 ) &1 по брутто ( &3 ) &1 и процентам потерь ( &4, &5 )."
     3366                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3367                       .
     3368                   end.
     3369               end.
     3370               when 2
     3371               then do:
     3372                   if round( p-coeff-waste, 9 ) <> round( 100 - p-coeff-value - ( 100 * p-netto / p-brutto ), 9 )
     3373                   then do:
     3374                       assign
     3375                           p-not-good      = yes
     3376                           p-error-message =  substitute( "Ошибка расчета процента потерь ( &2 ) &1 по нетто ( &3 ) &1 брутто ( &4 ) &1 и cезонному проценту ( &5 )."
     3377                                                   , chr(10), p-coeff-waste, p-netto, p-brutto, p-coeff-value )
     3378                       .
     3379                   end.
     3380               end.
     3381               when 3
     3382               then do:
     3383                   if round( p-brutto, 9 ) <> round( 100 * p-netto / ( 100 - p-coeff-value - p-coeff-waste ), 9 )
     3384                   then do:
     3385                       assign
     3386                           p-not-good      = yes
     3387                           p-error-message = substitute( "Ошибка расчета брутто ( &3 ) &1 по нетто ( &2 ) &1 и процентам потерь ( &4, &5 )."
     3388                                                   , chr(10), p-netto, p-brutto, p-coeff-value, p-coeff-waste )
     3389                       .
     3390                   end.
     3391               end.
     3392               otherwise do:
     3393                   assign
     3394                       p-not-good      = yes
     3395                       p-error-message = substitute( "Ошибка ввода метода расчета ( &1 ).", p-calc-method )
     3396                   .
     3397               end.
     3398           end case.
     3399       end.
     3400   end.
     3401   end procedure.
     3402   procedure fbrlib-check-fbr-recipe :
     3403   define input parameter p-doc-code       as character        no-undo.
     3404   define input parameter p-recipe-code    as character        no-undo.
     3405   define output parameter p-is-correct    as logical          no-undo.
     3406       define variable v-comp-factor    as decimal      no-undo.
     3407       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3408       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3409       define buffer buf_fbr-line          for ub.fbr-line.
     3410   do
     3411   for buf_fbr-recipe
     3412     , buf_fbr-recipe-gds
     3413     , buf_fbr-line
     3414   on error undo, return error
     3415   :
     3416       assign
     3417           p-is-correct = yes
     3418       .
     3419       find first buf_fbr-recipe no-lock
     3420            where buf_fbr-recipe.doc-code    = p-doc-code
     3421              and buf_fbr-recipe.recipe-code = p-recipe-code no-error
     3422       .
     3423       if not available buf_fbr-recipe then do:
     3424         undo, return error substitute("Не найден рецепт (fbr-recipe) с кодом &1 для  документа пр-ва &2", p-recipe-code, p-doc-code).
     3425       end.
     3426       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3427       then do:
     3428       end.
     3429       else do:
     3430           find first buf_fbr-line no-lock
     3431                where buf_fbr-line.doc-code    = buf_fbr-recipe.doc-code
     3432                  and buf_fbr-line.is-comp     = yes
     3433                  and buf_fbr-line.recipe-code = buf_fbr-recipe.recipe-code
     3434                  and buf_fbr-line.artic       = buf_fbr-recipe.artic
     3435                  and buf_fbr-line.prod-type   = buf_fbr-recipe.prod-type
     3436                  and buf_fbr-line.prod-code   = buf_fbr-recipe.prod-code
     3437           .
     3438           assign
     3439               v-comp-factor = buf_fbr-line.fact-qnty / buf_fbr-recipe.qnty
     3440           .
     3441           recipe-line-cycle:
     3442           for each buf_fbr-recipe-gds no-lock
     3443              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3444                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3445           on error undo, return error
     3446           :
     3447               find first buf_fbr-line no-lock
     3448                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3449                      and buf_fbr-line.is-comp     = no
     3450                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3451                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3452                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3453                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3454               .
     3455               if absolute( buf_fbr-line.fact-qnty / buf_fbr-recipe-gds.brutto-qnty - v-comp-factor ) > 0.000000001
     3456               then do:
     3457                   assign
     3458                       p-is-correct = no
     3459                   .
     3460                   leave recipe-line-cycle.
     3461               end.
     3462           end.
     3463       end.
     3464   end.
     3465   end procedure.
     3466   procedure fbrlib-get-recipe-type :
     3467   define input parameter p-fbr-doc-code   as character        no-undo.
     3468   define input parameter p-recipe-code    as character        no-undo.
     3469   define output parameter p-recipe-type   as character        no-undo.
     3470       define buffer buf_recipe        for ub.recipe.
     3471       define buffer buf_fbr-recipe    for ub.fbr-recipe.
     3472   do
     3473   for buf_recipe
     3474     , buf_fbr-recipe
     3475   on error undo, return error
     3476   :
     3477       if p-fbr-doc-code = ""
     3478       then do:
     3479           find first buf_recipe no-lock
     3480                where buf_recipe.recipe-code = p-recipe-code
     3481           no-error.
     3482           if available buf_recipe
     3483           then do:
     3484               assign
     3485                   p-recipe-type = buf_recipe.recipe-type
     3486               .
     3487           end.
     3488           else do:
     3489               assign
     3490                   p-recipe-type = "":U
     3491               .
     3492           end.
     3493       end.
     3494       else do:
     3495           find first buf_fbr-recipe no-lock
     3496                where buf_fbr-recipe.doc-code      = p-fbr-doc-code
     3497                  and buf_fbr-recipe.recipe-code   = p-recipe-code
     3498           no-error.
     3499           if available buf_fbr-recipe
     3500           then do:
     3501               assign
     3502                   p-recipe-type = buf_fbr-recipe.recipe-type
     3503               .
     3504           end.
     3505           else do:
     3506               assign
     3507                   p-recipe-type = "":U
     3508               .
     3509           end.
     3510       end.
     3511   end.
     3512   end procedure.
     3513   PROCEDURE calc-comp-from-ingr :
     3514   define input parameter p-fbr-v-fbr-doc-line-recid           as recid        no-undo.
     3515   define input parameter p-fact-qnty                          as decimal      no-undo.
     3516   define output parameter p-comp-fbr-v-fbr-doc-line-recid     as recid        no-undo.
     3517   define output parameter p-comp-qnty                         as decimal      no-undo.
     3518       define variable v-ingr-qnty     as decimal       no-undo.
     3519       define buffer buf_i_fbr-line    for ub.fbr-line.
     3520       define buffer buf_fbr-line      for ub.fbr-line.
     3521       define buffer buf_recipe        for ub.fbr-recipe.
     3522       define buffer buf_recipe-gds    for ub.fbr-recipe-gds.
     3523   do
     3524   for buf_i_fbr-line
     3525     , buf_fbr-line
     3526     , buf_recipe
     3527     , buf_recipe-gds
     3528   on error undo, return error
     3529   :
     3530       find first buf_i_fbr-line no-lock
     3531            where recid( buf_i_fbr-line ) = p-fbr-v-fbr-doc-line-recid
     3532       .
     3533       find first buf_recipe no-lock
     3534            where buf_recipe.doc-code      = buf_i_fbr-line.doc-code
     3535              and buf_recipe.recipe-code   = buf_i_fbr-line.recipe-code
     3536       no-error.
     3537       if not available buf_recipe
     3538       then do:
     3539           message
     3540                   vss-workfile vss-revision vss-description
     3541               skip "В строке производства не указан рецепт."
     3542               skip "Невозможно рассчитать количество составного товара."
     3543               skip return-value
     3544               skip trim(error-status :get-message(1))
     3545                   trim(error-status :get-message(2))
     3546                   trim(error-status :get-message(3))
     3547           view-as alert-box error.
     3548           undo, return error .
     3549       end.
     3550       if buf_recipe.recipe-type = 'альтернатива':U
     3551       then do:
     3552           for each buf_fbr-line no-lock
     3553              where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3554                and buf_fbr-line.trn-type    = buf_i_fbr-line.trn-type
     3555                and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3556           on error undo, return error
     3557           :
     3558               find first buf_recipe-gds no-lock
     3559                    where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3560                      and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3561                      and buf_recipe-gds.artic       = buf_fbr-line.artic
     3562                      and buf_recipe-gds.prod-type   = buf_fbr-line.prod-type
     3563                      and buf_recipe-gds.prod-code   = buf_fbr-line.prod-code
     3564               .
     3565               assign
     3566                   p-comp-qnty         = p-comp-qnty       + ( buf_fbr-line.fact-qnty * buf_recipe-gds.brutto-qnty )
     3567               .
     3568           end.
     3569           assign
     3570               p-comp-qnty         = p-comp-qnty       / buf_recipe.qnty
     3571           .
     3572       end.
     3573       else do:
     3574           find first buf_recipe-gds no-lock
     3575                where buf_recipe-gds.doc-code    = buf_i_fbr-line.doc-code
     3576                  and buf_recipe-gds.recipe-code = buf_i_fbr-line.recipe-code
     3577                  and buf_recipe-gds.artic       = buf_i_fbr-line.artic
     3578                  and buf_recipe-gds.prod-type   = buf_i_fbr-line.prod-type
     3579                  and buf_recipe-gds.prod-code   = buf_i_fbr-line.prod-code
     3580           .
     3581           assign
     3582               p-comp-qnty = p-fact-qnty / buf_recipe-gds.brutto-qnty * buf_recipe.qnty
     3583           .
     3584       end.
     3585       find first buf_fbr-line no-lock
     3586            where buf_fbr-line.doc-code    = buf_i_fbr-line.doc-code
     3587              and buf_fbr-line.is-comp     = yes
     3588              and buf_fbr-line.recipe-code = buf_i_fbr-line.recipe-code
     3589       .
     3590       assign
     3591           p-comp-fbr-v-fbr-doc-line-recid = recid( buf_fbr-line )
     3592       .
     3593   end.
     3594   END PROCEDURE.
     3595   PROCEDURE get-temp_dressing-ingr-used-qnty :
     3596   define input parameter p-recipe-code    as character    no-undo.
     3597   define input parameter p-gds-code       as integer      no-undo.
     3598   define output parameter p-line-qnty     as decimal      no-undo.
     3599   define output parameter p-used-qnty     as decimal      no-undo.
     3600   define output parameter p-recipe-qnty   as decimal      no-undo.
     3601       define buffer buf_temp_dressing-ingr    for temp_dressing-ingr.
     3602   do
     3603   for buf_temp_dressing-ingr
     3604   on error undo, return error
     3605   :
     3606       find first buf_temp_dressing-ingr no-lock
     3607            where buf_temp_dressing-ingr.recipe-code = p-recipe-code
     3608              and buf_temp_dressing-ingr.gds-code    = p-gds-code
     3609       no-error.
     3610       if available buf_temp_dressing-ingr
     3611       then do:
     3612           assign
     3613               p-line-qnty     = buf_temp_dressing-ingr.line-qnty
     3614               p-used-qnty     = buf_temp_dressing-ingr.used-qnty
     3615               p-recipe-qnty   = buf_temp_dressing-ingr.recipe-qnty
     3616           .
     3617       end.
     3618       else do:
     3619           assign
     3620               p-line-qnty     = 0
     3621               p-used-qnty     = 0
     3622               p-recipe-qnty   = 0
     3623           .
     3624       end.
     3625   end.
     3626   END PROCEDURE.
     3627   PROCEDURE fbrlib_adjust-recipe :
     3628   do
     3629   on error undo, return error
     3630   :
     3631   define input parameter parparentproc as widget-handle no-undo .
     3632   define input parameter p-fbrhist-handle as handle no-undo .
     3633   define input parameter p-doc-code       as character    no-undo.
     3634   define input parameter p-recipe-code    as character    no-undo.
     3635   define input parameter p-price-sale-obj-type as character no-undo .
     3636   define input parameter p-price-sale-obj-code as integer no-undo .
     3637       define variable v-recipe-qnty       as decimal      no-undo.
     3638       define variable v-comp-qnty         as decimal      no-undo.
     3639       define variable v-recipe-gds-qnty   as decimal      no-undo.
     3640       define variable v-ingr-qnty         as decimal      no-undo.
     3641       define variable v-qnty              as decimal      no-undo.
     3642       define variable v-coeff-waste       as decimal      no-undo.
     3643       define variable v-brutto-qnty       as decimal      no-undo.
     3644       define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3645       define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3646       define buffer buf_fbr-line          for ub.fbr-line.
     3647       define buffer buf_el_fbr-recipe-gds for ub.fbr-recipe-gds.
     3648       find first buf_fbr-recipe no-lock
     3649            where buf_fbr-recipe.doc-code      = p-doc-code
     3650              and buf_fbr-recipe.recipe-code   = p-recipe-code
     3651       .
     3652       assign
     3653           v-recipe-qnty = buf_fbr-recipe.qnty
     3654       .
     3655       find first buf_fbr-line no-lock
     3656            where buf_fbr-line.doc-code    = p-doc-code
     3657              and buf_fbr-line.is-comp     = yes
     3658              and buf_fbr-line.recipe-code = p-recipe-code
     3659       .
     3660       assign
     3661           v-comp-qnty = buf_fbr-line.fact-qnty
     3662       .
     3663       if buf_fbr-recipe.recipe-type = 'альтернатива':U
     3664       then do:
     3665       end.
     3666       else do:
     3667           for each buf_fbr-recipe-gds no-lock
     3668              where buf_fbr-recipe-gds.doc-code    = p-doc-code
     3669                and buf_fbr-recipe-gds.recipe-code = p-recipe-code
     3670           on error undo, return error
     3671           :
     3672               find first buf_fbr-line no-lock
     3673                    where buf_fbr-line.doc-code    = p-doc-code
     3674                      and buf_fbr-line.is-comp     = no
     3675                      and buf_fbr-line.recipe-code = p-recipe-code
     3676                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3677                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3678                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3679               .
     3680               if buf_fbr-line.fact-qnty / v-comp-qnty <> buf_fbr-recipe-gds.brutto-qnty / v-recipe-qnty
     3681               then do:
     3682                   do transaction
     3683                   on error undo, return error
     3684                   :
     3685                       find first buf_el_fbr-recipe-gds exclusive-lock
     3686                            where recid( buf_el_fbr-recipe-gds ) = recid( buf_fbr-recipe-gds )
     3687                       .
     3688                       assign
     3689                           buf_el_fbr-recipe-gds.calc-method   = 1
     3690                           buf_el_fbr-recipe-gds.brutto-qnty   = buf_fbr-line.fact-qnty * v-recipe-qnty / v-comp-qnty
     3691                       .
     3692                       run fbrlib-calc-brutto in this-procedure (
     3693                             input buf_fbr-recipe.recipe-type
     3694                           , input 0
     3695                           , input buf_el_fbr-recipe-gds.coeff-value
     3696                           , input buf_el_fbr-recipe-gds.coeff-waste
     3697                           , input buf_el_fbr-recipe-gds.brutto-qnty
     3698                           , input 1
     3699                           , output buf_el_fbr-recipe-gds.qnty
     3700                           , output buf_el_fbr-recipe-gds.coeff-waste
     3701                           , output buf_el_fbr-recipe-gds.brutto-qnty
     3702                           , output buf_el_fbr-recipe-gds.calc-method
     3703                       ).
     3704                   end.
     3705               end.
     3706           end.
     3707           run fbrlib_adjust-doc-lines in this-procedure (
     3708                 input parparentproc
     3709               , input p-fbrhist-handle
     3710               , input p-doc-code
     3711               , input p-recipe-code
     3712               , input p-price-sale-obj-type
     3713               , input p-price-sale-obj-code
     3714           ).
     3715       end.
     3716   end.
     3717   END PROCEDURE.
     3718   PROCEDURE fbrlib_adjust-doc-lines :
     3719   define input parameter parparentproc as widget-handle no-undo .
     3720   define input parameter p-fbrhist-handle as handle no-undo .
     3721   define input parameter p-doc-code       as character    no-undo.
     3722   define input parameter p-recipe-code    as character    no-undo.
     3723   define input parameter p-price-sale-obj-type as character no-undo .
     3724   define input parameter p-price-sale-obj-code as integer no-undo .
     3725   define variable v-comp-qnty         as decimal      no-undo.
     3726   define variable v-trn-type          as character    no-undo.
     3727   define variable v-ingr-qnty         as decimal      no-undo.
     3728   define variable v-recipe-qnty       as decimal      no-undo.
     3729   define variable v-fbr-v-fbr-doc-line-recid    as recid        no-undo.
     3730   define buffer buf_fbr-recipe        for ub.fbr-recipe.
     3731   define buffer buf_fbr-recipe-gds    for ub.fbr-recipe-gds.
     3732   define buffer buf_fbr-line          for ub.fbr-line.
     3733   define buffer buf_coeff_fbr-line    for ub.fbr-line.
     3734   define buffer buf_goods             for ub.goods.
     3735   define buffer buf_fbr-doc           for ub.fbr-doc.
     3736   do
     3737   for buf_fbr-recipe
     3738     , buf_fbr-recipe-gds
     3739     , buf_fbr-line
     3740     , buf_coeff_fbr-line
     3741     , buf_goods
     3742     , buf_fbr-doc
     3743   on error undo, return error
     3744   :
     3745       find first buf_fbr-line no-lock
     3746            where buf_fbr-line.doc-code      = p-doc-code
     3747              and buf_fbr-line.is-comp       = yes
     3748              and buf_fbr-line.recipe-code   = p-recipe-code
     3749       .
     3750       find first buf_fbr-doc no-lock
     3751            where buf_fbr-doc.doc-code      = p-doc-code
     3752       .
     3753       assign
     3754           v-comp-qnty = buf_fbr-line.fact-qnty
     3755           v-trn-type  = buf_fbr-line.trn-type
     3756       .
     3757       find first buf_fbr-recipe no-lock
     3758            where buf_fbr-recipe.doc-code    = p-doc-code
     3759              and buf_fbr-recipe.recipe-code = p-recipe-code
     3760       .
     3761       assign
     3762       v-recipe-qnty = buf_fbr-recipe.qnty
     3763       .
     3764       do transaction
     3765       on error undo, return error
     3766       :
     3767           for each buf_fbr-recipe-gds no-lock
     3768              where buf_fbr-recipe-gds.doc-code      = p-doc-code
     3769                and buf_fbr-recipe-gds.recipe-code   = p-recipe-code
     3770           on error undo, return error
     3771           :
     3772               find first buf_fbr-line no-lock
     3773                    where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3774                      and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3775                      and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3776                      and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3777                      and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3778               no-error.
     3779               if not available buf_fbr-line
     3780               then do:
     3781                   find first buf_goods no-lock
     3782                        where buf_goods.artic      = buf_fbr-recipe-gds.artic
     3783                          and buf_goods.prod-type  = buf_fbr-recipe-gds.prod-type
     3784                          and buf_goods.prod-code  = buf_fbr-recipe-gds.prod-code
     3785                   .
     3786                   run str/fbr-crln.p (
     3787                         input parparentproc
     3788                       , input recid( buf_fbr-doc )
     3789                       , input recid( buf_goods )
     3790                       , input buf_fbr-recipe-gds.recipe-code
     3791                       , input v-trn-type
     3792                       , input no
     3793                       , input no
     3794                       , input buf_fbr-doc.obj-type
     3795                       , input buf_fbr-doc.obj-code
     3796                       , output v-fbr-v-fbr-doc-line-recid
     3797                   ).
     3798                   find first buf_fbr-line no-lock
     3799                        where buf_fbr-line.doc-code    = buf_fbr-recipe-gds.doc-code
     3800                          and buf_fbr-line.recipe-code = buf_fbr-recipe-gds.recipe-code
     3801                          and buf_fbr-line.prod-type   = buf_fbr-recipe-gds.prod-type
     3802                          and buf_fbr-line.prod-code   = buf_fbr-recipe-gds.prod-code
     3803                          and buf_fbr-line.artic       = buf_fbr-recipe-gds.artic
     3804                   no-error.
     3805                   if not available buf_fbr-line
     3806                   then do:
     3807                       undo, return error substitute("Не удалось создать строку документа производства &1 &2&3&4"
     3808                                                      , p-doc-code
     3809                                                      , buf_fbr-recipe-gds.artic
     3810                                                      , buf_fbr-recipe-gds.prod-type
     3811                                                      , buf_fbr-recipe-gds.prod-code).
     3812                   end.
     3813               end.
     3814               find first buf_coeff_fbr-line exclusive-lock
     3815                    where recid( buf_coeff_fbr-line ) = recid( buf_fbr-line )
     3816               .
     3817               if buf_coeff_fbr-line.calc-method <> buf_fbr-recipe-gds.calc-method
     3818               or buf_coeff_fbr-line.coeff-value <> buf_fbr-recipe-gds.coeff-value
     3819               or buf_coeff_fbr-line.coeff-waste <> buf_fbr-recipe-gds.coeff-waste
     3820               then do:
     3821                   assign
     3822                       buf_coeff_fbr-line.calc-method = buf_fbr-recipe-gds.calc-method
     3823                       buf_coeff_fbr-line.coeff-value = buf_fbr-recipe-gds.coeff-value
     3824                       buf_coeff_fbr-line.coeff-waste = buf_fbr-recipe-gds.coeff-waste
     3825                   .
     3826               end.
     3827           end.
     3828       end.
     3829       define variable v-need-goods    as logical       no-undo.
     3830       define variable v-need-goods-list       as character     no-undo.
     3831       define variable v-need-goods-qnty-list  as character     no-undo.
     3832       find first buf_fbr-line no-lock
     3833            where buf_fbr-line.doc-code    = buf_fbr-doc.doc-code
     3834              and buf_fbr-line.is-comp     = yes
     3835              and buf_fbr-line.recipe-code = p-recipe-code
     3836       .
     3837       run str/fbr-qnty.p (
     3838             input parparentproc
     3839           , input p-fbrhist-handle
     3840           , input recid( buf_fbr-doc )
     3841           , input recid( buf_fbr-line )
     3842           , input no
     3843           , input "ingr"
     3844           , input no
     3845           , input p-price-sale-obj-type
     3846           , input p-price-sale-obj-code
     3847           , input no
     3848           , input no
     3849           , input no
     3850           , output v-need-goods
     3851           , output v-need-goods-list
     3852           , output v-need-goods-qnty-list
     3853       ).
     3854   end.
     3855   END PROCEDURE.
     3856   procedure fbrlib_check-before-close :
     3857   define input parameter p-doc-code as character no-undo .
     3858   define variable same-sale as decimal no-undo .
     3859   define variable is-waste as logical no-undo .
     3860   define variable fix-price as logical no-undo .
     3861   define buffer buf_fbr-doc for ub.fbr-doc.
     3862   define buffer buf_fbr-line for ub.fbr-line.
     3863   define buffer buf_goods for ub.goods.
     3864   define buffer buf_fbr-gds-obj for ub.fbr-gds-obj.
     3865   do
     3866   on error undo, return error
     3867   :
     3868     for each buf_fbr-line no-lock
     3869         where buf_fbr-line.doc-code = p-doc-code
     3870       , each buf_goods no-lock
     3871         where buf_goods.artic     = buf_fbr-line.artic
     3872           and buf_goods.prod-type = buf_fbr-line.prod-type
     3873           and buf_goods.prod-code = buf_fbr-line.prod-code
     3874     break by buf_fbr-line.prod-type
     3875           by buf_fbr-line.prod-code
     3876           by buf_fbr-line.artic
     3877     :
     3878       if first-of (buf_fbr-line.artic)
     3879       then do:
     3880         assign
     3881         same-sale = buf_fbr-line.price-sale
     3882         is-waste = (buf_fbr-line.rsrv-qnty = ?)
     3883         fix-price = buf_fbr-line.is-calc
     3884         .
     3885       end.
     3886       if same-sale <> buf_fbr-line.price-sale
     3887       then do:
     3888           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром должна быть указана одна и та же цена продажи."
     3889                                         ,p-doc-code
     3890                                         ,buf_goods.artic
     3891                                         ,buf_goods.gds-name
     3892                                         ,chr(10)).
     3893       end.
     3894       if fix-price <> buf_fbr-line.is-calc then do:
     3895           undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа с этим товаром цена должна быть фиксирована или нет."
     3896                                         ,p-doc-code
     3897                                         ,buf_goods.artic
     3898                                         ,buf_goods.gds-name
     3899                                         ,chr(10)).
     3900       end.
     3901       if is-waste <> (buf_fbr-line.rsrv-qnty = ?)
     3902       then do:
     3903         undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4&4Во всех строках документа этот товар должен быть отходом либо не отходом."
     3904                                         ,p-doc-code
     3905                                         ,buf_goods.artic
     3906                                         ,buf_goods.gds-name
     3907                                         ,chr(10)).
     3908       end.
     3909       if buf_fbr-line.rsrv-qnty <> ?
     3910       and buf_goods.gds-type <> 'у':U
     3911       and ( buf_fbr-line.price-sale <= 0 or buf_fbr-line.price-sale = ?  )
     3912       and buf_fbr-line.fact-qnty <> 0
     3913       then do:
     3914         if buf_fbr-line.trn-type     = 'при':U  then for first buf_fbr-doc where buf_fbr-doc.doc-code =  p-doc-code no-lock:
     3915           if  can-find(first buf_fbr-gds-obj no-lock where
     3916                   buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     3917               AND buf_fbr-gds-obj.obj-type = buf_fbr-doc.obj-type
     3918               AND buf_fbr-gds-obj.obj-code = buf_fbr-doc.obj-code
     3919               and buf_fbr-gds-obj.is-null-price  )  then .
     3920                     else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3921                                         ,p-doc-code
     3922                                         ,buf_goods.artic
     3923                                         ,buf_goods.gds-name
     3924                                         ,chr(10)
     3925                                         ,buf_fbr-line.recipe-code
     3926                                         ).
     3927         end.
     3928         else undo, return error substitute("Док-нт пр-ва &1 Артикул: &2 &3&4Рецепт &5&4Неправильная (нулевая) цена продажи."
     3929                                         ,p-doc-code
     3930                                         ,buf_goods.artic
     3931                                         ,buf_goods.gds-name
     3932                                         ,chr(10)
     3933                                         ,buf_fbr-line.recipe-code
     3934                                         ).
     3935       end.
     3936     end.
     3937   end.
     3938   end procedure.
     3939   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3940   define new global shared variable g#attr-lib  as handle no-undo .
     3941   define variable v-attr-lib-variable as handle no-undo .
     3942   procedure gds-attr-name :
     3943     define input  parameter p-code           as character no-undo .
     3944     define output parameter p-type           as character no-undo .
     3945     define output parameter p-format         as character no-undo .
     3946     define output parameter p-label          as character no-undo .
     3947     define output parameter p-user-can-edit  as logical   no-undo .
     3948     define output parameter p-output-display as logical   no-undo .
     3949     define output parameter p-other          as character no-undo .
     3950     do
     3951     on error undo, return error
     3952     :
     3953           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     3954         (input  p-code
     3955         ,output p-type
     3956         ,output p-format
     3957         ,output p-label
     3958         ,output p-user-can-edit
     3959         ,output p-output-display
     3960         ,output p-other
     3961         ) no-error .
     3962       if error-status :error
     3963       then do:
     3964         undo, return error return-value .
     3965       end.
     3966     end.
