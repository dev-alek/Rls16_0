     4110   procedure gds-attr_check-ptrl-divis :
     4111     define input  parameter p-gds-code    like ub.goods-attr.gds-code     no-undo .
     4112     define input  parameter p-code        like ub.goods-attr.attr-code  no-undo .
     4113     define input  parameter p-value       as character no-undo .
     4114     define input  parameter p-mode        as character no-undo .
     4115     define output parameter p-correct     as logical no-undo .
     4116     define output parameter p-error-code  as character no-undo .
     4117     do
     4118     on error undo, return error return-value
     4119     :
     4120           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr_check-ptrl-divis in g#attr-lib
     4121         (input  p-gds-code
     4122         ,input  p-code
     4123         ,input  p-value
