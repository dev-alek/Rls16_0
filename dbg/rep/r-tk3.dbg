      147   def
      148   new shared
      149   temp-table  obj-list no-undo
      150     field obj-type like ub.clients.obj-type
      151     field obj-code like ub.clients.obj-code
      152     field obj-name like ub.clients.obj-name
      153     field obj-id   as integer
