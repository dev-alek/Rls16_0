     5112   procedure nutro_get-nutrition-info :
     5113     define input  parameter p-artic         as character no-undo .
     5114     define input  parameter p-prod-type     as character no-undo .
     5115     define input  parameter p-prod-code     as integer   no-undo .
     5116     define input  parameter p-obj-type      as character no-undo .
     5117     define input  parameter p-obj-code      as integer   no-undo .
     5118     define output parameter p-calories      as decimal   no-undo .
     5119     define output parameter p-protein       as decimal   no-undo .
     5120     define output parameter p-carbohydrate  as decimal   no-undo .
     5121     define output parameter p-fat           as decimal   no-undo .
     5122     define buffer buf_goods    for ub.goods .
     5123     define variable v-attr-value    as character no-undo .
     5124     define variable v-attr-type     as character no-undo .
     5125     define variable v-attr-code     as character no-undo .
     5126     define variable v-exist         as logical   no-undo .
     5127     define variable v-is-global     as logical   no-undo .
     5128     define variable v-nutro-value   as decimal   no-undo .
     5129     define buffer buf_fbr-gds-obj  for ub.fbr-gds-obj.
     5130     define buffer buf_recipe       for ub.recipe.
     5131   do
     5132   on error undo, return error return-value
     5133   :
     5134     assign
     5135       p-carbohydrate  = ?
     5136       p-fat           = ?
     5137       p-protein       = ?
     5138       p-calories      = ?
     5139     .
     5140     find first buf_goods no-lock
     5141       where buf_goods.artic     = p-artic
     5142         and buf_goods.prod-type = p-prod-type
     5143         and buf_goods.prod-code = p-prod-code
     5144     no-error .
     5145     if not available buf_goods
     5146     then do:
     5147       return .
     5148     end.
     5149     assign
     5150       v-is-global = yes
     5151     .
     5152     find first buf_fbr-gds-obj no-lock
     5153       where buf_fbr-gds-obj.obj-type = p-obj-type
     5154         and buf_fbr-gds-obj.obj-code = p-obj-code
     5155         and buf_fbr-gds-obj.gds-code = buf_goods.gds-code
     5156     no-error .
     5157     if available buf_fbr-gds-obj
     5158     then do:
     5159       if  buf_fbr-gds-obj.is-semi-finished or
     5160           buf_fbr-gds-obj.is-menu
     5161       then do:
     5162         assign
     5163           v-is-global = no
     5164         .
     5165         find first buf_recipe no-lock
     5166           where buf_recipe.recipe-code = buf_fbr-gds-obj.default-recipe-code
     5167         no-error .
     5168         if available buf_recipe
     5169         then do:
     5170           assign
     5171             v-is-global = ( buf_recipe.host-code = 0    ) and
     5172                           ( buf_recipe.obj-type  = "":U ) and
     5173                           ( buf_recipe.obj-code  = 0    )
     5174           .
     5175         end.
     5176       end.
     5177     end.
     5178     if v-is-global = yes
     5179     then do:
     5180       assign
     5181         v-attr-code = 'calories':U
     5182       .
     5183       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5184       assign
     5185         p-calories  = v-nutro-value
     5186         v-attr-code = 'carbohydrate':U
     5187       .
     5188       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5189       assign
     5190         p-carbohydrate  = v-nutro-value
     5191         v-attr-code     = 'fat':U
     5192       .
     5193       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5194       assign
     5195         p-fat       = v-nutro-value
     5196         v-attr-code = 'protein':U
     5197       .
     5198       assign                       v-nutro-value = ?                     .                     run gds-attr-exist in this-procedure ( input  buf_goods.gds-code                                                          , input  v-attr-code                                                          , output v-exist                                                          ) no-error .                     if error-status :error = yes or                         v-exist = no                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     else do:                       run gds-attr-value in this-procedure ( input  buf_goods.gds-code                                                           , input  v-attr-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                       if error-status :error                       then do:                         assign                           v-nutro-value = ?                         .                       end.                       assign                         v-nutro-value = decimal( v-attr-value )                       no-error .                       if error-status :error = yes                       then do:                         assign                           v-nutro-value = ?                         .                       end.                     end.
     5199       assign
     5200         p-protein = v-nutro-value
     5201       .
     5202     end.
     5203     else do:
     5204       assign
     5205         v-attr-code = 'calories-o':U
     5206       .
     5207       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5208       assign
     5209         p-calories  = v-nutro-value
     5210         v-attr-code = 'carbohydrate-o':U
     5211       .
     5212       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5213       assign
     5214         p-carbohydrate  = v-nutro-value
     5215         v-attr-code     = 'fat-o':U
     5216       .
     5217       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5218       assign
     5219         p-fat       = v-nutro-value
     5220         v-attr-code = 'protein-o':U
     5221       .
     5222       assign                      v-nutro-value = ?                    .                    run gdsoattr-exist in this-procedure ( input buf_goods.gds-code                                                         , input p-obj-type                                                         , input p-obj-code                                                         , input v-attr-code                                                         , output v-exist                                                         ) no-error .                    if error-status :error = yes or                       v-exist = no                    then do:                     assign                       v-nutro-value = ?                     .                    end.                    else do:                     run gdsoattr-value in this-procedure ( input  v-attr-code                                                           , input  buf_goods.gds-code                                                           , input  p-obj-type                                                           , input  p-obj-code                                                           , output v-attr-value                                                           , output v-attr-type                                                           ) no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                     assign                       v-nutro-value = decimal(v-attr-value)                     no-error .                     if error-status :error = yes                     then do:                       assign                         v-nutro-value = ?                       .                     end.                    end.
     5223       assign
     5224         p-protein = v-nutro-value
     5225       .
     5226     end.
     5227   end.
     5228   end procedure.
     5229   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5230     define variable v-cntxt-db-num        as integer   no-undo .
     5231     define variable v-cntxt-userid        as character no-undo .
     5232     define variable v-cntxt-level         as character no-undo .
     5233     define variable v-cntxt-host-code-obj as integer   no-undo .
     5234     define variable v-cntxt-obj-type      as character no-undo .
     5235     define variable v-cntxt-obj-code      as integer   no-undo .
     5236     define variable v-cntxt-db-num-obj    as integer   no-undo .
     5237     define variable v-cntxt-is-admin      as logical   no-undo .
     5238   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5239     run mainmenu_getcntxt in parparentproc
     5240       (output v-cntxt-db-num
     5241       ,output v-cntxt-userid
     5242       ,output v-cntxt-level
     5243       ,output v-cntxt-host-code-obj
     5244       ,output v-cntxt-obj-type
     5245       ,output v-cntxt-obj-code
     5246       ,output v-cntxt-db-num-obj
     5247       ,output v-cntxt-is-admin
     5248       ) .
     5249   define temp-table tt-line no-undo
     5250       field gds-name as character
     5251       field gds-unit as character
     5252       field brutto as decimal
     5253       field waste-pc as decimal
     5254       field netto as decimal
     5255       field netto-1 as decimal
     5256       field final-weight as decimal
     5257   .
     5258   run main no-error.
     5259   if error-status:error then
     5260       message return-value
     5261       view-as alert-box.
     5262   procedure main:
     5263       define variable v-file-name as character no-undo.
     5264       run prepare-info no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     5265       run create-rep(output v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     5266       if v-file-name = ? then
     5267           return error "файл созданного отчёта не найден".
     5268       else
     5269           run open-ie(v-file-name) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     5270   end.
     5271   procedure prepare-info:
     5272       define variable v-type as character no-undo.
     5273       define variable v-val as character no-undo.
     5274       define variable v-host-code as integer no-undo .
     5275       find first ub.recipe no-lock where recid(ub.recipe) = p-recid.
     5276   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5277   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     5278     (input  v-cntxt-obj-type
     5279     ,input  v-cntxt-obj-code
     5280     ,output v-host-code
     5281     ,output v-orgname
     5282     )  .
     5283       find first ub.goods no-lock
     5284           where ub.goods.artic = ub.recipe.artic
     5285           and ub.goods.prod-type = ub.recipe.prod-type
     5286           and ub.goods.prod-code = ub.recipe.prod-code.
     5287       assign
     5288           v-ps1 = ub.recipe.recipe-quality
     5289           v-ps = ub.recipe.recipe-technique
     5290           v-num = ub.recipe.recipe-ref-num
     5291           v-name = ub.recipe.recipe-name
     5292           v-weight = string(ub.recipe.portion-weight, "->>>,>>>,>>9.999") + " кг"
     5293       .
     5294       run gds-attr-value(
     5295           ub.goods.gds-code,
     5296           'calories':U,
     5297           output v-val,
     5298           output v-type
     5299       ).
     5300       v-calories = decimal(v-val).
     5301       run gds-attr-value(
     5302           ub.goods.gds-code,
     5303           'fat':U,
     5304           output v-val,
     5305           output v-type
     5306       ).
     5307       v-fat = decimal(v-val).
     5308       run gds-attr-value(
     5309           ub.goods.gds-code,
     5310           'carbohydrate':U,
     5311           output v-val,
     5312           output v-type
     5313       ).
     5314       v-carbohydrate = decimal(v-val).
     5315       run gds-attr-value(
     5316           ub.goods.gds-code,
     5317           'protein':U,
     5318           output v-val,
     5319           output v-type
     5320       ).
     5321       v-protein = decimal(v-val).
     5322       v-show-t2 = (if
     5323           (v-calories = 0 OR v-calories = ?) AND
     5324           (v-fat = 0 OR v-fat = ?) AND
     5325           (v-carbohydrate = 0 OR v-carbohydrate = ?) AND
     5326           (v-protein = 0 OR v-protein = ?)
     5327               then false else true
     5328           ).
     5329       for each ub.recipe-gds no-lock
     5330           where ub.recipe-gds.recipe-code = ub.recipe.recipe-code,
     5331       first ub.goods no-lock
     5332           where ub.goods.gds-code = ub.recipe-gds.gds-code:
     5333           create tt-line.
     5334           assign
     5335               tt-line.gds-name = ub.goods.gds-name
     5336               tt-line.gds-unit = ub.goods.unit-base
     5337               tt-line.brutto = ub.recipe-gds.brutto-qnty
     5338               tt-line.netto = ub.recipe-gds.qnty
     5339               tt-line.final-weight = tt-line.netto
     5340               tt-line.waste-pc = ub.recipe-gds.coeff-waste
     5341               tt-line.netto-1 = tt-line.netto / ub.recipe.portion-qnty
     5342           .
     5343       end.
     5344   end.
     5345   procedure create-rep:
     5346       define output parameter p-filename as character no-undo.
     5347       define variable v-rls-file as character no-undo.
     5348       define variable v-data-file as character no-undo.
     5349       define variable v-xsl-file as character no-undo.
     5350       define variable v-tmp-file as character no-undo.
     5351       define variable hw as handle no-undo.
     5352       define variable rep-out as class Rep-Out no-undo.
     5353       assign
     5354           v-xsl-file = search("exe/tk3.xsl.html")
     5355           v-data-file = session:temp-directory + string(time) + ".xml"
     5356           v-tmp-file = session:temp-directory + string(time) + ".html".
     5357       .
     5358       create sax-writer hw.
     5359       hw:formatted = true.
     5360       hw:set-output-destination ("file", v-data-file).
     5361       run write-data(hw) no-error. if error-status:ERROR then return error subst("&1 &2 &3", return-value, ERROR-STATUS:get-message(1), ERROR-STATUS:get-message(2)).
     5362       rep-out = new rep-out().
     5363       v-rls-file = rep-out:xsl-transform(v-data-file, v-xsl-file).
     5364       os-delete value(v-tmp-file).
     5365       os-copy value(v-rls-file) value(v-tmp-file).
     5366       os-delete value(v-rls-file).
     5367       delete object rep-out.
     5368       p-filename = v-tmp-file.
     5369   end.
     5370   procedure write-data:
     5371       define input parameter hw as handle no-undo.
     5372       hw:start-document ().
     5373       hw:start-element ("rep").
     5374       hw:start-element ("card").
     5375       hw:insert-attribute ("name", v-name).
     5376       hw:insert-attribute ("num", v-num).
     5377       hw:insert-attribute ("org", v-orgname).
     5378       hw:insert-attribute ("ps", v-ps).
     5379       hw:insert-attribute ("ps1", v-ps1).
     5380       hw:insert-attribute ("weight", v-weight).
     5381       hw:insert-attribute ("show-t2", string(v-show-t2)).
     5382       hw:insert-attribute ("fat", string(if v-fat = ? then 0 else v-fat, "->>>,>>>,>>9.999")).
     5383       hw:insert-attribute ("protein", string(if v-protein = ? then 0 else v-protein, "->>>,>>>,>>9.999")).
     5384       hw:insert-attribute ("carbohydrate", string(if v-carbohydrate = ? then 0 else v-carbohydrate, "->>>,>>>,>>9.999")).
     5385       hw:insert-attribute ("calories", string(if v-calories = ? then 0 else v-calories, "->>>,>>>,>>9.999")).
     5386       for each tt-line no-lock:
     5387           hw:start-element ("line").
     5388           hw:insert-attribute ("name", tt-line.gds-name).
     5389           hw:insert-attribute ("unit", tt-line.gds-unit).
     5390           hw:insert-attribute ("brutto", string(tt-line.brutto, "->>>,>>>,>>9.999")).
     5391           hw:insert-attribute ("netto", string(tt-line.netto, "->>>,>>>,>>9.999")).
     5392           hw:insert-attribute ("netto-1",  if tt-line.netto-1 = ? then "" else string(tt-line.netto-1, "->>>,>>>,>>9.999") ).
     5393           hw:insert-attribute ("waste-pc", string(tt-line.waste-pc, "->>9.999")).
     5394           hw:insert-attribute ("final-weight", string(tt-line.final-weight, "->>>,>>>,>>9.999")).
     5395           hw:end-element ("line").
     5396       end.
     5397       hw:end-element ("card").
     5398       hw:end-element ("rep").
     5399       hw:end-document ().
     5400   end.
     5401   procedure open-ie:
     5402       define input parameter p-filename as character no-undo.
     5403       define variable o-IE as com-handle no-undo.
     5404       create "InternetExplorer.Application" o-IE.
     5405       o-IE:addressbar = false.
     5406       o-IE:Navigate(p-filename).
     5407       o-IE:visible = true.
     5408       release object o-IE.
     5409   end.
