      703             SIZE 11.5 BY .75 AT ROW 1.33 COL 36.88
      704             FGCOLOR 4
      705        "Классификация :" VIEW-AS TEXT
      706             SIZE 15 BY .75 AT ROW 1.33 COL 9.5
      707             FGCOLOR 4
      708        RECT-5 AT ROW 1.13 COL 1.63
      709        RECT-6 AT ROW 1.13 COL 34.25
      710       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      711            SIDE-LABELS NO-UNDERLINE THREE-D
      712            AT COL 1 ROW 1 SCROLLABLE .
      713   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      714   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      715   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      716   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      717   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      718   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      719   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      720   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      721         adm-object-hdl = FRAME F-Main:HANDLE.
      722   RUN ensure-broker.
      723   THIS-PROCEDURE:ADM-DATA =
      724        'ADM1.1~`':U +
      725        'SmartObject~`':U +
      726        '~`':U +
      727        'NO ~`':U +
      728        '~`':U +
      729        '~`':U +
      730        '~`':U +
      731        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      732           + "~`":U +
      733        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      734        'Record-Source,Record-Target,TableIO-Target~`':U +
      735        '~`':U +
      736        '~`~`~`~`~`~`~`~`~`~`~`':U +
      737        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      738            THEN "^^":U
      739        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      740             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      741   PROCEDURE adm-apply-entry :
      742     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      743   END PROCEDURE.
      744   PROCEDURE adm-destroy :
      745    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      746   END PROCEDURE.
      747   PROCEDURE adm-disable :
      748       DISABLE RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      749       RUN dispatch ('disable-fields':U).
      750       RUN set-attribute-list ('ENABLED=no':U).
      751       RETURN.
      752   END PROCEDURE.
      753   PROCEDURE adm-edit-attribute-list :
      754         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      755         RETURN.
      756   END PROCEDURE.
      757   PROCEDURE adm-enable :
      758       ENABLE UNLESS-HIDDEN RECT-5 RECT-6 Classify SortType WITH FRAME F-Main.
      759       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      760       RUN set-attribute-list ('ENABLED=yes':U).
      761       RETURN.
      762   END PROCEDURE.
      763   PROCEDURE adm-exit :
      764        RUN notify ('exit':U).
      765     RETURN.
      766   END PROCEDURE.
      767   PROCEDURE adm-hide :
      768     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      769   END PROCEDURE.
      770   PROCEDURE adm-initialize :
      771     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      772   END PROCEDURE.
      773   PROCEDURE adm-show-errors :
      774       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      775       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      776           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      777       END.
      778       RETURN.
      779   END PROCEDURE.
      780   PROCEDURE adm-UIB-mode :
      781     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      782   END PROCEDURE.
      783   PROCEDURE adm-view :
      784     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      785   END PROCEDURE.
      786   PROCEDURE dispatch :
      787       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      788       RUN broker-dispatch IN adm-broker-hdl
      789           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      790       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      791   END PROCEDURE.
      792   PROCEDURE ensure-broker :
      793   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      794   IF RETURN-VALUE NE "ADM-Broker":U THEN
      795   DO:
      796       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      797       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      798   END.
      799   END PROCEDURE.
      800   PROCEDURE get-attribute :
      801     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      802     RUN broker-get-attribute IN adm-broker-hdl
      803         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      804     RETURN RETURN-VALUE.
      805   END PROCEDURE.
      806   PROCEDURE get-attribute-list :
      807     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      808     RUN broker-get-attribute-list IN adm-broker-hdl
      809         (INPUT THIS-PROCEDURE,
      810          INPUT ?,
      811          OUTPUT p-attr-list) NO-ERROR.
      812     RETURN.
      813   END PROCEDURE.
      814   PROCEDURE new-state :
      815     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      816     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      817     RETURN.
      818   END PROCEDURE.
      819   PROCEDURE notify :
      820     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      821     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      822     IF RETURN-VALUE = "ADM-ERROR":U THEN
      823         RETURN "ADM-ERROR":U.
      824     RETURN.
      825   END PROCEDURE.
      826   PROCEDURE set-attribute-list :
      827     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      828     RUN ensure-broker.
      829     RUN broker-set-attribute-list IN adm-broker-hdl
      830         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      831     RETURN.
      832   END PROCEDURE.
      833   PROCEDURE set-position :
      834       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      835       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      836       IF VALID-HANDLE(adm-object-hdl) THEN
      837       DO:
      838         ASSIGN adm-object-hdl:ROW    =   p-row
      839                adm-object-hdl:COLUMN =   p-col.
      840       END.
      841       RETURN.
      842   END PROCEDURE.
      843   PROCEDURE adm-display-fields :
      844       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      845       RETURN.
      846   END PROCEDURE.
      847   PROCEDURE adm-open-query :
      848     RETURN.
      849   END PROCEDURE.
      850   PROCEDURE adm-row-changed :
      851         IF VALID-HANDLE(adm-object-hdl) THEN
      852           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      853         RUN notify ('row-available':U).
      854         RETURN.
      855   END PROCEDURE.
      856   PROCEDURE reposition-query :
      857       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      858       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      859       RETURN.
      860   END PROCEDURE.
      861     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
