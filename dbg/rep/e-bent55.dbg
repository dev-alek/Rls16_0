      941   PROCEDURE check-modified :
      942   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      943   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      944   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      945   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      946     IF check-state = "check":U THEN
      947     DO:
      948       RUN get-link-handle IN adm-broker-hdl
      949         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      950            OUTPUT group-target-list).
      951       IF group-target-list NE "":U THEN
      952       DO i = 1 TO NUM-ENTRIES(group-target-list):
      953         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      954         RUN check-modified IN curr-widget ('group-check':U).
      955         IF RETURN-VALUE NE "":U THEN
      956         DO:
      957           RUN check-modified-message(RETURN-VALUE).
      958           RETURN "":U.
      959         END.
      960       END.
      961     END.
      962     RETURN "":U.
      963   END PROCEDURE.
      964   PROCEDURE check-modified-message :
      965     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      966        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
      967           'CONTAINER-SOURCE':U, 'HIDDEN':U).
      968        IF RETURN-VALUE = "YES":U THEN
      969           RUN notify ('view,CONTAINER-SOURCE':U).
      970        MESSAGE IF p-changed-table NE ? THEN
      971           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
      972           ELSE "Current values have been changed."
      973           SKIP "  Do you wish to save those changes?"
      974           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
      975        IF ANS THEN
      976        DO:
      977           IF group-assign-target THEN
      978             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
      979           ELSE RUN dispatch('update-record':U).
      980           IF RETURN-VALUE = "ADM-ERROR":U THEN
      981           DO:
      982               MESSAGE "Changes to the previous record were not saved."
      983                 VIEW-AS ALERT-BOX ERROR.
      984               IF group-assign-target THEN
      985                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      986               ELSE RUN dispatch ('cancel-record':U).
      987           END.
      988        END.
      989        ELSE DO:
      990          IF group-assign-target THEN
      991             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
      992          ELSE RUN dispatch('cancel-record':U).
      993        END.
      994        RETURN.
      995   END PROCEDURE.
      996   PROCEDURE get-rowid :
      997       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
      998       ASSIGN
      999       p-table   =   adm-first-table.
     1000       RETURN.
     1001   END PROCEDURE.
     1002   PROCEDURE init-group-assign :
     1003       RUN request-attribute IN adm-broker-hdl
     1004         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1005       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1006         group-assign-target = yes.
     1007       ELSE group-assign-target = no.
     1008       RETURN.
     1009   END PROCEDURE.
     1010   PROCEDURE set-editors :
     1011       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1012       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1013       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1014       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1015       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1016       DO WHILE VALID-HANDLE (curr-widget):
     1017           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1018              curr-widget:HIDDEN = no THEN DO:
     1019             CASE p-field-setting:
     1020               WHEN "INITIALIZE":U THEN
     1021               DO:
     1022                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1023                     read-only-list +
     1024                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1025                        STRING(curr-widget).
     1026               END.
     1027               WHEN "DISABLE":U OR
     1028               WHEN "ENABLE":U THEN
     1029               DO:
     1030                   curr-widget:SENSITIVE = yes.
     1031                   RUN get-attribute ('Read-Only-Editors':U).
     1032                   IF RETURN-VALUE = ? OR
     1033                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1034                       curr-widget:READ-ONLY =
     1035                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1036               END.
     1037               WHEN "CLEAR":U THEN
     1038                   curr-widget:SCREEN-VALUE = "":U.
     1039             END CASE.
     1040           END.
     1041           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1042       END.
     1043       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1044         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1045           + '"':U).
     1046       RETURN.
     1047   END PROCEDURE.
     1048   PROCEDURE use-check-modified-all :
     1049    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1050     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1051     RETURN.
     1052   END PROCEDURE.
     1053   PROCEDURE use-create-on-add :
     1054   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1055      RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE use-initial-lock :
     1058     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1059     ASSIGN adm-initial-lock = p-attr-value.
     1060     RETURN.
     1061   END PROCEDURE.
     1062     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1063   ASSIGN
     1064          FRAME F-Main:SCROLLABLE       = FALSE
     1065          FRAME F-Main:HIDDEN           = TRUE.
     1066   ASSIGN
     1067          ShowZero:HIDDEN IN FRAME F-Main           = TRUE.
     1068   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1069   DO:
     1070       Assign Classify.
     1071       if Classify  Begins "prod":U OR
     1072          Classify  Begins "grp-goods":U then
     1073           enable SumsOnly with frame F-Main .
     1074       else
     1075           do:
     1076               SumsOnly = FALSE .
     1077               display SumsOnly with frame F-Main .
     1078               disable SumsOnly with frame F-Main .
     1079           end.
     1080    if Classify = "grp-goods":U
     1081            Then do:
     1082               display TOG-lavel   with frame F-Main .
     1083               enable  TOG-lavel   with frame F-Main .
     1084           end.
     1085            Else do:
     1086               display  TOG-lavel  var-Lavel with frame F-Main .
     1087               disable  TOG-lavel  var-Lavel with frame F-Main .
     1088           end.
     1089   END.
     1090   ON VALUE-CHANGED OF Tog-lavel IN FRAME F-Main
     1091   DO:
     1092      Assign tog-lavel.
     1093     if tog-lavel = TRUE
     1094           Then do:
     1095               display  var-Lavel  with frame F-Main .
     1096               enable   var-Lavel  with frame F-Main .
     1097           end.
     1098            Else do:
     1099               display    var-Lavel with frame F-Main .
     1100               disable    var-Lavel with frame F-Main .
     1101           end.
     1102   END.
     1103   if not this-procedure :persistent
     1104   then do:
     1105     message
     1106       vss-workfile vss-revision vss-description skip
     1107       "Ошибка при запуске процедуры" skip
     1108       "Данную процедуру следует запускать только с параметром persistent" skip
     1109       view-as alert-box error .
     1110     undo, return error .
     1111   end.
     1112   PROCEDURE disable_UI :
     1113     HIDE FRAME F-Main.
     1114     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1115   END PROCEDURE.
     1116   PROCEDURE my-report :
     1117   if Classify = "no-classify":U then do:
     1118   run cus/r-benet5.p   (
     1119    input  v-cntxt-obj-code,
     1120    input  v-cntxt-obj-type,
     1121    input  base-type ,
     1122    input  base-code ,
     1123    input  Classify  ,
     1124    input  SortType  ,
     1125    input  SumsOnly  ,
     1126    input  ShowZero  ,
     1127    false ,
     1128    input   tog-lavel,
     1129    input   var-lavel )
     1130   .
     1131   End.
     1132   Else do:
     1133     if  classify = "prod":u then do:
     1134     run cus/r-bent53.p   (
     1135     input  v-cntxt-obj-code,
     1136     input  v-cntxt-obj-type,
     1137     input  base-type ,
     1138     input  base-code ,
     1139     input  classify  ,
     1140     input  sorttype  ,
     1141     input  sumsonly  ,
     1142     input  showzero  ,
     1143     false ,
     1144     input   tog-lavel,
     1145     input   var-lavel )
     1146     .
     1147     end.
     1148     else do:
     1149     run cus/r-bene52.p   (
     1150     input  v-cntxt-obj-code,
     1151     input  v-cntxt-obj-type,
     1152     input  base-type ,
     1153     input  base-code ,
     1154     input  Classify  ,
     1155     input  SortType  ,
     1156     input  SumsOnly  ,
     1157     input  ShowZero  ,
     1158     false ,
     1159     input   tog-lavel,
     1160     input   var-lavel )
     1161     .
     1162   End.
     1163   End.
     1164   END PROCEDURE.
     1165   PROCEDURE my-var :
     1166   assign frame F-Main SumsOnly ShowZero  Classify SortType
     1167   Tog-lavel var-lavel.
     1168   def var t-class as char no-undo.
     1169   def var t-sort as char no-undo.
     1170     case classify:
     1171       when "no-classify":u    then t-class =   "Без классификации" .
     1172       when "prod":u           then t-class =   "Производители"   .
     1173       when "post":u           then t-class =   "Поставщики"   .
     1174       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1175       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1176       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1177       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1178       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1179       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1180       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1181       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1182       when  "t-level":u       then t-class =   "Терминальные группы" .
     1183    end case.
     1184     case sorttype:
     1185       when "sort-pp":u               then t-sort =   "по порядку" .
     1186       when "sort-code":u             then t-sort =   "по коду" .
     1187       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1188       when "sort-qunty":u            then t-sort =   "по реализации".
     1189       when "sort-name":u             then t-sort =   "по наименованию".
     1190       when "sort-type":u             then t-sort =   "по типу ткани".
     1191       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1192       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1193    end case.
     1194   ReportNAme = "С О С Т О Я Н И Е    З А П А С А ".
     1195   ReportHeader = "Классификация : " + t-class + chr(10) +
     1196                  (if SumsOnly then "Только итоги "  else " " )  +  chr(10) +
     1197                 "Сортировка " + t-sort  + chr(10) +
     1198                  (if ShowZero then "Показывать нулевые остатки "  else "Не показывать нулевые остатки" ) .
     1199     if X-SET_PAY_TYPE <> 2 then str3 =  "в ценах РЕАЛИЗАЦИИ".
     1200    str2 = "" .
     1201    sheetf.Excel-Column-Lable =
     1202             "Код"
     1203     + ","  + "Артикул"
     1204     + ","  + "Название товара"
     1205     + ","  + "Ед. изм" .
     1206     define variable t-str as character no-undo .
     1207     For each obj-list no-lock :
     1208       t-str = obj-list.obj-name .
     1209       repeat :
     1210           if index ( t-str , "," ) > 0 then do:
     1211              substring ( t-str ,  index ( t-str , "," ) ) = "." .
     1212           end.
     1213           else leave.
     1214       end.
     1215       sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество "  + t-str + ","  + "Стоимость" .
     1216     End.
     1217     sheetf.Excel-Column-Lable = sheetf.Excel-Column-Lable   + ","  + "Количество ИТОГО,Стоимость ИТОГО" .
     1218    sheetf.Sizes =  "10,16,40,5".
     1219     For each obj-list no-lock :
     1220       sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1221     End.
     1222     sheetf.Sizes = sheetf.Sizes   + ","  + "15"  + ","  + "15" .
     1223     sheetf.Sizes = sheetf.Sizes   + ",".
     1224     sheetf.colformat = "2=@;3=@":U .
     1225   END PROCEDURE.
