     4757   if Show-cost-vat  then (     excel-sum  (   p-RAsh[3] )  + CHR(9)   ) else ("")
     4758   if Showsale       then (     excel-sum  (   p-RAsh[5] )  + CHR(9)   ) else ("")
     4759   if Show-sale-vat  then (     excel-sum  (   p-RAsh[6] )  + CHR(9)   ) else ("")
     4760                    excel-qnty(p-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4761   if Showcost       then (     excel-sum  (   p-KAssa[2])  + CHR(9)    ) else ("")
     4762   if Show-cost-vat  then (     excel-sum  (   p-KAssa[3])  + CHR(9)    ) else ("")
     4763   if Showsale       then (     excel-sum  (   p-KAssa[5])  + CHR(9)    ) else ("")
     4764   if Show-sale-vat  then (     excel-sum  (   p-KAssa[6])  + CHR(9)    ) else ("")
     4765   .
     4766   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( p-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4767   if Showcost       then (     excel-sum  (   p-Inv [2] ) + CHR(9)    ) else ("")
     4768   if Show-cost-vat  then (     excel-sum  (   p-Inv [3] ) + CHR(9)    ) else ("")
     4769   if Showsale       then (     excel-sum  (   p-Inv [5] ) + CHR(9)    ) else ("")
     4770   if Show-sale-vat  then (     excel-sum  (   p-Inv [6] ) + CHR(9)    ) else ("")
     4771                    excel-qnty(p-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4772   if Showcost       then (     excel-sum  (   p-vzvr [2] ) + CHR(9)    ) else ("")
     4773   if Show-cost-vat  then (     excel-sum  (   p-vzvr [3] ) + CHR(9)    ) else ("")
     4774   if Showsale       then (     excel-sum  (   p-vzvr [5] ) + CHR(9)    ) else ("")
     4775   if Show-sale-vat  then (     excel-sum  (   p-vzvr [6] ) + CHR(9)    ) else ("")
     4776                   excel-qnty(p-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4777   if Showcost       then (     excel-sum  (   p-vzvr-post[2] ) + CHR(9)     ) else ("")
     4778   if Show-cost-vat  then (     excel-sum  (   p-vzvr-post[3] ) + CHR(9)     ) else ("")
     4779   if Showsale       then (     excel-sum  (   p-vzvr-post[5] ) + CHR(9)     ) else ("")
     4780   if Show-sale-vat  then (     excel-sum  (   p-vzvr-post[6] ) + CHR(9)     ) else ("")
     4781                   excel-qnty(p-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4782   if Showcost       then (     excel-sum  (   p-spis[2] ) + CHR(9)     ) else ("")
     4783   if Show-cost-vat  then (     excel-sum  (   p-spis[3] ) + CHR(9)     ) else ("")
     4784   if Showsale       then (     excel-sum  (   p-spis[5] ) + CHR(9)     ) else ("")
     4785   if Show-sale-vat  then (     excel-sum  (   p-spis[6] ) + CHR(9)     ) else ("")
     4786            chr(10).
     4787                End.
     4788      WHEN "B1":U  Then DO :
     4789                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4790                   p3 @ gds-zap-b-code
     4791                   p4 @ gds-zap-artic
     4792                   p5 @ gds-zap-gds-name
     4793                   p6 @ gds-zap-unit-base
     4794                   p1 @ gds-type
     4795                  b1-vzvr      [p2]    @  F-vzvr
     4796                  b1-vzvr-post [p2]    @  F-vzvr-post
     4797                  b1-RAsh      [p2]    @  F-RAsh
     4798                  b1-KAssa     [p2]    @  F-KAssa
     4799                  b1-Inv       [p2]    @  F-Inv
     4800                  b1-spis      [p2]    @  F-spis
     4801                  with FRAME ZAPAS .
     4802       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4803                   p4 CHR(9)
     4804                   p5 CHR(9)
     4805                   p6 CHR(9)
     4806                   gds-zap-type CHR(9)
     4807                    excel-qnty(b1-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4808   if Showcost       then (     excel-sum  (   b1-RAsh[2] )  + CHR(9)   ) else ("")
     4809   if Show-cost-vat  then (     excel-sum  (   b1-RAsh[3] )  + CHR(9)   ) else ("")
     4810   if Showsale       then (     excel-sum  (   b1-RAsh[5] )  + CHR(9)   ) else ("")
     4811   if Show-sale-vat  then (     excel-sum  (   b1-RAsh[6] )  + CHR(9)   ) else ("")
