     4847                  b2-vzvr      [p2]    @  F-vzvr
     4848                  b2-vzvr-post [p2]    @  F-vzvr-post
     4849                  b2-RAsh      [p2]    @  F-RAsh
     4850                  b2-KAssa     [p2]    @  F-KAssa
     4851                  b2-Inv       [p2]    @  F-Inv
     4852                  b2-spis      [p2]    @  F-spis
     4853                  with FRAME ZAPAS .
     4854       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4855                   p4 CHR(9)
     4856                   p5 CHR(9)
     4857                   p6 CHR(9)
     4858                   gds-zap-type CHR(9)
     4859                    excel-qnty(b2-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4860   if Showcost       then (     excel-sum  (   b2-RAsh[2] )  + CHR(9)   ) else ("")
     4861   if Show-cost-vat  then (     excel-sum  (   b2-RAsh[3] )  + CHR(9)   ) else ("")
     4862   if Showsale       then (     excel-sum  (   b2-RAsh[5] )  + CHR(9)   ) else ("")
     4863   if Show-sale-vat  then (     excel-sum  (   b2-RAsh[6] )  + CHR(9)   ) else ("")
     4864                    excel-qnty(b2-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4865   if Showcost       then (     excel-sum  (   b2-KAssa[2])  + CHR(9)    ) else ("")
     4866   if Show-cost-vat  then (     excel-sum  (   b2-KAssa[3])  + CHR(9)    ) else ("")
     4867   if Showsale       then (     excel-sum  (   b2-KAssa[5])  + CHR(9)    ) else ("")
     4868   if Show-sale-vat  then (     excel-sum  (   b2-KAssa[6])  + CHR(9)    ) else ("")
     4869   .
     4870   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( b2-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4871   if Showcost       then (     excel-sum  (   b2-Inv [2] ) + CHR(9)    ) else ("")
     4872   if Show-cost-vat  then (     excel-sum  (   b2-Inv [3] ) + CHR(9)    ) else ("")
     4873   if Showsale       then (     excel-sum  (   b2-Inv [5] ) + CHR(9)    ) else ("")
     4874   if Show-sale-vat  then (     excel-sum  (   b2-Inv [6] ) + CHR(9)    ) else ("")
     4875                    excel-qnty(b2-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4876   if Showcost       then (     excel-sum  (   b2-vzvr [2] ) + CHR(9)    ) else ("")
     4877   if Show-cost-vat  then (     excel-sum  (   b2-vzvr [3] ) + CHR(9)    ) else ("")
     4878   if Showsale       then (     excel-sum  (   b2-vzvr [5] ) + CHR(9)    ) else ("")
     4879   if Show-sale-vat  then (     excel-sum  (   b2-vzvr [6] ) + CHR(9)    ) else ("")
     4880                   excel-qnty(b2-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4881   if Showcost       then (     excel-sum  (   b2-vzvr-post[2] ) + CHR(9)     ) else ("")
     4882   if Show-cost-vat  then (     excel-sum  (   b2-vzvr-post[3] ) + CHR(9)     ) else ("")
     4883   if Showsale       then (     excel-sum  (   b2-vzvr-post[5] ) + CHR(9)     ) else ("")
     4884   if Show-sale-vat  then (     excel-sum  (   b2-vzvr-post[6] ) + CHR(9)     ) else ("")
     4885                   excel-qnty(b2-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4886   if Showcost       then (     excel-sum  (   b2-spis[2] ) + CHR(9)     ) else ("")
     4887   if Show-cost-vat  then (     excel-sum  (   b2-spis[3] ) + CHR(9)     ) else ("")
     4888   if Showsale       then (     excel-sum  (   b2-spis[5] ) + CHR(9)     ) else ("")
     4889   if Show-sale-vat  then (     excel-sum  (   b2-spis[6] ) + CHR(9)     ) else ("")
     4890            chr(10).
     4891                End.
     4892      WHEN "BI":U Then  DO :
     4893                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4894                   p3 @ gds-zap-b-code
     4895                   p4 @ gds-zap-artic
     4896                   p5 @ gds-zap-gds-name
     4897                   p6 @ gds-zap-unit-base
     4898                   p1 @ gds-type
     4899                  bi-vzvr      [p2]    @  F-vzvr
     4900                  bi-vzvr-post [p2]    @  F-vzvr-post
     4901                  bi-RAsh      [p2]    @  F-RAsh
     4902                  bi-KAssa     [p2]    @  F-KAssa
     4903                  bi-Inv       [p2]    @  F-Inv
     4904                  bi-spis      [p2]    @  F-spis
     4905                  with FRAME ZAPAS .
     4906       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4907                   p4 CHR(9)
     4908                   p5 CHR(9)
     4909                   p6 CHR(9)
     4910                   gds-zap-type CHR(9)
     4911                    excel-qnty(bi-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4912   if Showcost       then (     excel-sum  (   bi-RAsh[2] )  + CHR(9)   ) else ("")
     4913   if Show-cost-vat  then (     excel-sum  (   bi-RAsh[3] )  + CHR(9)   ) else ("")
     4914   if Showsale       then (     excel-sum  (   bi-RAsh[5] )  + CHR(9)   ) else ("")
     4915   if Show-sale-vat  then (     excel-sum  (   bi-RAsh[6] )  + CHR(9)   ) else ("")
     4916                    excel-qnty(bi-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4917   if Showcost       then (     excel-sum  (   bi-KAssa[2])  + CHR(9)    ) else ("")
     4918   if Show-cost-vat  then (     excel-sum  (   bi-KAssa[3])  + CHR(9)    ) else ("")
     4919   if Showsale       then (     excel-sum  (   bi-KAssa[5])  + CHR(9)    ) else ("")
     4920   if Show-sale-vat  then (     excel-sum  (   bi-KAssa[6])  + CHR(9)    ) else ("")
     4921   .
     4922   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( bi-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4923   if Showcost       then (     excel-sum  (   bi-Inv [2] ) + CHR(9)    ) else ("")
     4924   if Show-cost-vat  then (     excel-sum  (   bi-Inv [3] ) + CHR(9)    ) else ("")
     4925   if Showsale       then (     excel-sum  (   bi-Inv [5] ) + CHR(9)    ) else ("")
     4926   if Show-sale-vat  then (     excel-sum  (   bi-Inv [6] ) + CHR(9)    ) else ("")
     4927                    excel-qnty(bi-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4928   if Showcost       then (     excel-sum  (   bi-vzvr [2] ) + CHR(9)    ) else ("")
     4929   if Show-cost-vat  then (     excel-sum  (   bi-vzvr [3] ) + CHR(9)    ) else ("")
     4930   if Showsale       then (     excel-sum  (   bi-vzvr [5] ) + CHR(9)    ) else ("")
     4931   if Show-sale-vat  then (     excel-sum  (   bi-vzvr [6] ) + CHR(9)    ) else ("")
     4932                   excel-qnty(bi-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4933   if Showcost       then (     excel-sum  (   bi-vzvr-post[2] ) + CHR(9)     ) else ("")
     4934   if Show-cost-vat  then (     excel-sum  (   bi-vzvr-post[3] ) + CHR(9)     ) else ("")
     4935   if Showsale       then (     excel-sum  (   bi-vzvr-post[5] ) + CHR(9)     ) else ("")
     4936   if Show-sale-vat  then (     excel-sum  (   bi-vzvr-post[6] ) + CHR(9)     ) else ("")
     4937                   excel-qnty(bi-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4938   if Showcost       then (     excel-sum  (   bi-spis[2] ) + CHR(9)     ) else ("")
     4939   if Show-cost-vat  then (     excel-sum  (   bi-spis[3] ) + CHR(9)     ) else ("")
     4940   if Showsale       then (     excel-sum  (   bi-spis[5] ) + CHR(9)     ) else ("")
     4941   if Show-sale-vat  then (     excel-sum  (   bi-spis[6] ) + CHR(9)     ) else ("")
     4942            chr(10).
     4943                End.
     4944      WHEN ""  Then     DO :
     4945                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4946                   p3 @ gds-zap-b-code
     4947                   p4 @ gds-zap-artic
     4948                   p5 @ gds-zap-gds-name
     4949                   p6 @ gds-zap-unit-base
     4950                   p1 @ gds-type
     4951                  vzvr      [p2]    @  F-vzvr
     4952                  vzvr-post [p2]    @  F-vzvr-post
     4953                  RAsh      [p2]    @  F-RAsh
     4954                  KAssa     [p2]    @  F-KAssa
     4955                  Inv       [p2]    @  F-Inv
     4956                  spis      [p2]    @  F-spis
     4957                  with FRAME ZAPAS .
     4958       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4959                   p4 CHR(9)
     4960                   p5 CHR(9)
     4961                   p6 CHR(9)
     4962                   gds-zap-type CHR(9)
     4963                    excel-qnty(RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4964   if Showcost       then (     excel-sum  (   RAsh[2] )  + CHR(9)   ) else ("")
     4965   if Show-cost-vat  then (     excel-sum  (   RAsh[3] )  + CHR(9)   ) else ("")
     4966   if Showsale       then (     excel-sum  (   RAsh[5] )  + CHR(9)   ) else ("")
     4967   if Show-sale-vat  then (     excel-sum  (   RAsh[6] )  + CHR(9)   ) else ("")
     4968                    excel-qnty(KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4969   if Showcost       then (     excel-sum  (   KAssa[2])  + CHR(9)    ) else ("")
     4970   if Show-cost-vat  then (     excel-sum  (   KAssa[3])  + CHR(9)    ) else ("")
     4971   if Showsale       then (     excel-sum  (   KAssa[5])  + CHR(9)    ) else ("")
     4972   if Show-sale-vat  then (     excel-sum  (   KAssa[6])  + CHR(9)    ) else ("")
     4973   .
     4974   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4975   if Showcost       then (     excel-sum  (   Inv [2] ) + CHR(9)    ) else ("")
     4976   if Show-cost-vat  then (     excel-sum  (   Inv [3] ) + CHR(9)    ) else ("")
     4977   if Showsale       then (     excel-sum  (   Inv [5] ) + CHR(9)    ) else ("")
     4978   if Show-sale-vat  then (     excel-sum  (   Inv [6] ) + CHR(9)    ) else ("")
     4979                    excel-qnty(vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4980   if Showcost       then (     excel-sum  (   vzvr [2] ) + CHR(9)    ) else ("")
     4981   if Show-cost-vat  then (     excel-sum  (   vzvr [3] ) + CHR(9)    ) else ("")
     4982   if Showsale       then (     excel-sum  (   vzvr [5] ) + CHR(9)    ) else ("")
     4983   if Show-sale-vat  then (     excel-sum  (   vzvr [6] ) + CHR(9)    ) else ("")
     4984                   excel-qnty(vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4985   if Showcost       then (     excel-sum  (   vzvr-post[2] ) + CHR(9)     ) else ("")
     4986   if Show-cost-vat  then (     excel-sum  (   vzvr-post[3] ) + CHR(9)     ) else ("")
     4987   if Showsale       then (     excel-sum  (   vzvr-post[5] ) + CHR(9)     ) else ("")
     4988   if Show-sale-vat  then (     excel-sum  (   vzvr-post[6] ) + CHR(9)     ) else ("")
     4989                   excel-qnty(spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4990   if Showcost       then (     excel-sum  (   spis[2] ) + CHR(9)     ) else ("")
     4991   if Show-cost-vat  then (     excel-sum  (   spis[3] ) + CHR(9)     ) else ("")
     4992   if Showsale       then (     excel-sum  (   spis[5] ) + CHR(9)     ) else ("")
     4993   if Show-sale-vat  then (     excel-sum  (   spis[6] ) + CHR(9)     ) else ("")
     4994            chr(10).
     4995                 End.
     4996      End case.
     4997                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4998    END PROCEDURE.
     4999   PROCEDURE Clear-item :
     5000   def var kk as int no-undo.
     5001    REPEAT kk = 1 to 9:
     5002    Assign
     5003       rash             [kk]  = 0
     5004       kassa            [kk]  = 0
     5005       Inv              [kk]  = 0
     5006       vzvr-post        [kk]  = 0
     5007       vzvr             [kk]  = 0
     5008       spis             [kk]  = 0 .
     5009          End.
     5010    END PROCEDURE.
     5011   PROCEDURE ob-line :
     5012   def input  parameter x-store-code   like ub.clients.obj-code     no-undo.
     5013   def input  parameter x-store-type   like ub.clients.obj-type     no-undo.
     5014   def input  parameter x-cli-code     like ub.clients.obj-code     no-undo.
     5015   def input  parameter x-cli-type     like ub.clients.obj-type     no-undo.
     5016   def INPUT  parameter x-artic        like post-ot-line.artic        no-undo.
     5017   def INPUT  parameter x-prod-code    like post-ot-line.prod-code    no-undo.
     5018   def INPUT  parameter x-prod-type    like post-ot-line.prod-type    no-undo.
     5019   def INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     5020   def INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     5021   def input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     5022   def input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     5023   def input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     5024   def input  parameter xTog-obj           as log no-undo .
     5025   def var  tt#          as   int                 no-undo .
     5026   def var tt-cost like  ub.gds-dtl.price-rubl no-undo .
     5027   def var tt-sale like  ub.gds-dtl.price-rubl no-undo .
     5028    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     5029    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 3.
     5030    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 6.
     5031        FOR each post-ot-line where
     5032                 post-ot-line.artic        = x-artic
     5033           AND   post-ot-line.fact-order  <= fact-order-2  AND   post-ot-line.fact-order  >= fact-order-1
     5034           AND   post-ot-line.obj-code     = x-store-code
     5035           AND   post-ot-line.obj-type     = x-store-type
     5036           AND   post-ot-line.prod-code    = x-prod-code
     5037           AND   post-ot-line.prod-type    = x-prod-type
     5038           AND   post-ot-line.cli-code     = x-cli-code
     5039           AND   post-ot-line.cli-type     = x-cli-type
     5040           AND   post-ot-line.sum-type     = x-sum-type
     5041           and   post-ot-line.cat-id       = x-cat-id
     5042           no-lock :
     5043           For each ub.parts no-lock where
     5044                       post-ot-line.artic        = ub.parts.artic
     5045                 AND   post-ot-line.prod-code    = ub.parts.prod-code
     5046                 AND   post-ot-line.prod-type    = ub.parts.prod-type
     5047                 AND   post-ot-line.cli-code     = ub.parts.supp-code
     5048                 AND   post-ot-line.cli-type     = ub.parts.supp-type
     5049                 AND   post-ot-line.obj-code     = ub.parts.obj-code
     5050                 AND   post-ot-line.obj-type     = ub.parts.obj-type
     5051                 AND   post-ot-line.doc-code     = ub.parts.out-code
     5052                 AND   ub.parts.fact-date >= x-date-start
     5053                 AND   ub.parts.fact-date <= x-date-end  :
     5054           CASE post-ot-line.ext-doc-type:
     5055                WHEN         're':U      THEN DO :
     5056              ASSIGN vzvr[1 + tt#]   = vzvr[1 + tt#]   +  ub.parts.fact-qnty
     5057                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else   (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5058                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else   (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5059                    End.
     5060                WHEN       'ep':U    Then DO:
     5061              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  ub.parts.fact-qnty
     5062                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5063                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5064                     End.
     5065                WHEN       'ee':U       THEN  DO:
     5066              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  ub.parts.fact-qnty
     5067                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5068                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5069                    End.
     5070                WHEN      'we':U       THEN  DO:
     5071              ASSIGN spis[1 + tt#]   = spis[1 + tt#]   +  ub.parts.fact-qnty
     5072                     spis[2 + tt#]   = spis[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5073                     spis[3 + tt#]   = spis[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5074                    End.
     5075                WHEN       'es':U  then do:
     5076              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   +  ub.parts.fact-qnty
     5077                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5078                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  (ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5079                    End.
     5080                WHEN       'rs':U THEN  DO:
     5081              ASSIGN kassa[1 + tt#]   = kassa[1 + tt#]   -  ub.parts.fact-qnty
     5082                     kassa[2 + tt#]   = kassa[2 + tt#]   +  if tprintrubl then  ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.sum-rubl else ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5083                     kassa[3 + tt#]   = kassa[3 + tt#]   +  if tprintrubl then  ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) * post-ot-line.vat-rubl else ( ( -1 ) * ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base .
     5084                    End.
     5085                when 'vt':U  or
     5086                when 'vp':U   or
     5087                when 'ap':U   or
     5088                when 'mp':U or
     5089                when 'pc':U     then  do:
     5090                 assign inv[1 + tt#] = inv[1 + tt#]   +  ub.parts.fact-qnty
     5091                        inv[2 + tt#] = inv[2 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.sum-base
     5092                        Inv[3 + tt#] = Inv[3 + tt#]   +  if tprintrubl then (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-rubl else (ub.parts.fact-qnty / post-ot-line.fact-qnty) *  post-ot-line.vat-base  .
     5093              end.
     5094             End CASE.
     5095        End.
     5096      End.
     5097   END PROCEDURE.
     5098   PROCEDURE Calc-Sub-itog :
     5099   def input parameter tt as int no-undo.
     5100   def var b as int no-undo.
     5101   repeat b = 1 to 3:
     5102     Assign
     5103     B1-RAsh[b + TT]    = B1-RAsh[b + TT]    +  RAsh[b + TT]
     5104     B2-RAsh[b + TT]    = B2-RAsh[b + TT]    +  RAsh[b + TT]
     5105     Bi-RAsh[b + TT]    = Bi-RAsh[b + TT]    +  RAsh[b + TT]
     5106     p-RAsh[b + TT]    = p-RAsh[b + TT]    +  RAsh[b + TT]
     5107     o-RAsh[b + TT]    = o-RAsh[b + TT]    +  RAsh[b + TT]
     5108     B1-KAssa[b + TT]    = B1-KAssa[b + TT]    +  KAssa[b + TT]
     5109     B2-kassa[b + TT]    = B2-kassa[b + TT]    +  kassa[b + TT]
     5110     Bi-Kassa[b + TT]    = Bi-Kassa[b + TT]    +  Kassa[b + TT]
     5111     p-Kassa[b + TT]    = p-Kassa[b + TT]    +  Kassa[b + TT]
     5112     o-Kassa[b + TT]    = o-Kassa[b + TT]    +  Kassa[b + TT]
     5113     B1-Inv[b + TT]    = B1-Inv[b + TT]    +  Inv[b + TT]
     5114     B2-Inv[b + TT]    = B2-Inv[b + TT]    +  Inv[b + TT]
     5115     Bi-Inv[b + TT]    = Bi-Inv[b + TT]    +  Inv[b + TT]
     5116     p-Inv[b + TT]    = p-Inv[b + TT]    +  Inv[b + TT]
     5117     o-Inv[b + TT]    = o-Inv[b + TT]    +  Inv[b + TT]
     5118     B1-vzvr[b + TT]    = B1-vzvr[b + TT]    + vzvr[b + TT]
     5119     B2-vzvr[b + TT]    = B2-vzvr[b + TT]    + vzvr[b + TT]
     5120     Bi-vzvr[b + TT]    = Bi-vzvr[b + TT]    + vzvr[b + TT]
     5121     p-vzvr[b + TT]    = p-vzvr[b + TT]    + vzvr[b + TT]
     5122     o-vzvr[b + TT]    = o-vzvr[b + TT]    + vzvr[b + TT]
     5123     B1-spis[b + TT]    = B1-spis[b + TT]    + spis[b + TT]
     5124     B2-spis[b + TT]    = B2-spis[b + TT]    + spis[b + TT]
     5125     Bi-spis[b + TT]    = Bi-spis[b + TT]    + spis[b + TT]
     5126     p-spis[b + TT]     = p-spis[b + TT]    + spis[b + TT]
     5127     o-spis[b + TT]     = o-spis[b + TT]    + spis[b + TT]
     5128     B1-vzvr-post[b + TT]    = B1-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5129     B2-vzvr-post[b + TT]    = B2-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5130     Bi-vzvr-post[b + TT]    = Bi-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5131     p-vzvr-post[b + TT]    = p-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5132     o-vzvr-post[b + TT]    = o-vzvr-post[b + TT]    + vzvr-post[b + TT]
     5133   .
     5134      .
     5135   End.
     5136   END PROCEDURE.
     5137   PROCEDURE U-LINE :
     5138   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     5139           gds-zap-b-code
     5140           gds-zap-artic
     5141           gds-zap-gds-name
     5142           gds-zap-unit-base
     5143           gds-type
     5144           F-Rash
     5145           F-KAssa
     5146           F-Inv
     5147           F-vzvr
     5148           F-vzvr-post
     5149           F-spis
     5150           with FRAME ZAPAS .
     5151           DOWN stream   OutStream 1 with FRAME ZAPAS.
     5152           END PROCEDURE.
     5153   procedure Print-Footer :
     5154   define input parameter Nx as integer no-undo .
     5155   define input parameter Name as char no-undo .
     5156       if Nx = 1 Then DO:
     5157            run di-qnty ("кол-во", 1,"","Итого по : ",trim(name),"","b1").
     5158            if show-cost then do :     run di ( "учет." , 2, "","","","","b1" ).  end.
     5159            if show-cost-vat then do : run di ( "уч.НДС", 3, "","","","","b1" ).  end.
     5160            if show-sale then do :     run di ( "док-т.", 5, "","","","","b1" ).  end.
     5161            if show-sale-vat then do : run di ( "д. НДС", 6, "","","","","b1" ).  end.
     5162            if not sums-only then run u-line.
     5163            run clear-itemb1-.
     5164            end.
     5165    if nx = 2 then do:
     5166            run di-qnty ("кол-во", 1,"","","Итого по : " + trim(name),"","b2").
     5167            if show-cost then do :      run di ( "учет." , 2, "","","","","b2" ).  end.
     5168            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","b2" ).  end.
     5169            if show-sale then do :      run di ( "док-т.", 5, "","","","","b2" ).  end.
     5170            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","b2" ).  end.
     5171            if not sums-only then run u-line.
     5172            run clear-itemb2-.
     5173           end.
     5174    if nx = 3 then do:
     5175            if not sums-only then run u-line.
     5176            run di-qnty ("кол-во", 1,"","Итого по пост-ку" , trim(name),"","p").
     5177            if show-cost then do :      run di ( "учет." , 2, "","","","","p" ).  end.
     5178            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","p" ).  end.
     5179            if show-sale then do :      run di ( "док-т.", 5, "","","","","p" ).  end.
     5180            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","p" ).  end.
     5181            if not sums-only then run u-line.
     5182            run clear-itemp-.
     5183             end.
     5184    if nx = 0 then do:
     5185            run di-qnty ("кол-во", 1,"","Итого  объект: " , trim(name),"","o").
     5186            if show-cost then do :      run di ( "учет." , 2, "","","","","o" ).  end.
     5187            if show-cost-vat  then do : run di ( "уч.НДС", 3, "","","","","o" ).  end.
     5188            if show-sale then do :      run di ( "док-т.", 5, "","","","","o" ).  end.
     5189            if show-sale-vat  then do : run di ( "д. НДС", 6, "","","","","o" ).  end.
     5190            if not sums-only then run u-line.
     5191            run clear-itemo-.
     5192             end.
     5193    END PROCEDURE.
     5194   PROCEDURE Clear-itemb1- :
     5195   def var kk as int no-undo.
     5196    REPEAT kk = 1 to 9:
     5197    Assign
     5198      b1-rash             [kk]  = 0
     5199      b1-kassa            [kk]  = 0
     5200      b1-Inv              [kk]  = 0
     5201      b1-spis             [kk]  = 0
     5202      b1-vzvr             [kk]  = 0
     5203      b1-vzvr-post        [kk]  = 0
     5204      .
     5205          End.
     5206    END PROCEDURE.
     5207   PROCEDURE Clear-itemb2- :
     5208   def var kk as int no-undo.
     5209    REPEAT kk = 1 to 9:
     5210    Assign
     5211      b2-rash             [kk]  = 0
     5212      b2-kassa            [kk]  = 0
     5213      b2-Inv              [kk]  = 0
     5214      b2-spis             [kk]  = 0
     5215      b2-vzvr             [kk]  = 0
     5216      b2-vzvr-post        [kk]  = 0
     5217      .
     5218      End.
     5219    END PROCEDURE.
     5220   PROCEDURE Clear-itemp- :
     5221   def var kk as int no-undo.
     5222    REPEAT kk = 1 to 9:
     5223    Assign
     5224      p-rash             [kk]  = 0
     5225      p-kassa            [kk]  = 0
     5226      p-Inv              [kk]  = 0
     5227      p-spis              [kk]  = 0
     5228      p-vzvr             [kk]  = 0
     5229      p-vzvr-post        [kk]  = 0
     5230      .
     5231      End.
     5232    END PROCEDURE.
     5233   PROCEDURE Clear-itemo- :
     5234   def var kk as int no-undo.
     5235    REPEAT kk = 1 to 9:
     5236    Assign
     5237      o-rash             [kk]  = 0
     5238      o-kassa            [kk]  = 0
     5239      o-Inv              [kk]  = 0
     5240      o-spis             [kk]  = 0
     5241      o-vzvr             [kk]  = 0
     5242      o-vzvr-post        [kk]  = 0
     5243      .
     5244      End.
     5245    END PROCEDURE.
     5246   Procedure Tmp-create :
     5247   define input parameter p1   like ub.clients.obj-code  no-undo .
     5248   define input parameter p2   like ub.clients.obj-type  no-undo .
     5249   define input parameter Name like ub.clients.obj-name  no-undo .
     5250   define input parameter p3   like obj-list.obj-code no-undo .
     5251   define input parameter p4   like obj-list.obj-type no-undo .
     5252     Create tmp-cli-gds.
     5253    def var kk as int no-undo.
     5254    REPEAT kk = 1 to 9 :
     5255      Assign
     5256         tmp-cli-gds.p-rash[kk]           = p-rash[kk]
     5257         tmp-cli-gds.p-kassa[kk]          = p-kassa[kk]
     5258         tmp-cli-gds.p-Inv[kk]            = p-Inv[kk]
     5259         tmp-cli-gds.p-spis[kk]           = p-spis[kk]
     5260         tmp-cli-gds.p-vzvr[kk]           = p-vzvr[kk]
     5261         tmp-cli-gds.p-vzvr-post[kk]      = p-vzvr-post[kk]
     5262         .
     5263    end.
     5264         assign
     5265         tmp-cli-gds.cli-code         = p1
     5266         tmp-cli-gds.cli-type         = p2
     5267         tmp-cli-gds.Name             = Name
     5268         tmp-cli-gds.obj-code         = p3
     5269         tmp-cli-gds.obj-type         = p4
     5270         .
     5271    END PROCEDURE.
     5272   Procedure Tmp-clear :
     5273    def var kk as int no-undo.
     5274    REPEAT kk = 1 to 9 :
     5275    Assign
     5276        p-rash[kk]          = 0
     5277        p-kassa[kk]         = 0
     5278        p-Inv[kk]           = 0
     5279        p-spis[kk]          = 0
     5280        p-vzvr[kk]          = 0
     5281        p-vzvr-post[kk]     = 0
     5282       .
     5283       end.
     5284   END PROCEDURE.
     5285   Procedure Tmp-assign :
     5286    def var kk as int no-undo.
     5287    REPEAT kk = 1 to 9 :
     5288       Assign
     5289       p-rash[kk]           = p-rash[kk]            + tmp-cli-gds.p-rash[kk]
     5290       p-kassa[kk]          = p-kassa[kk]           + tmp-cli-gds.p-kassa[kk]
     5291       p-Inv[kk]            = p-Inv[kk]             + tmp-cli-gds.p-Inv[kk]
     5292       p-spis[kk]           = p-spis[kk]            + tmp-cli-gds.p-spis[kk]
     5293       p-vzvr[kk]           = p-vzvr[kk]            + tmp-cli-gds.p-vzvr[kk]
     5294       p-vzvr-post[kk]      = p-vzvr-post[kk]       + tmp-cli-gds.p-vzvr-post[kk]
     5295       .
     5296    end.
     5297   END PROCEDURE.
