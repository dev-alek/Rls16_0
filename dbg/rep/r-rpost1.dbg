     4814   if Show-cost-vat  then (     excel-sum  (   b1-KAssa[3])  + CHR(9)    ) else ("")
     4815   if Showsale       then (     excel-sum  (   b1-KAssa[5])  + CHR(9)    ) else ("")
     4816   if Show-sale-vat  then (     excel-sum  (   b1-KAssa[6])  + CHR(9)    ) else ("")
     4817   .
     4818   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( b1-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4819   if Showcost       then (     excel-sum  (   b1-Inv [2] ) + CHR(9)    ) else ("")
     4820   if Show-cost-vat  then (     excel-sum  (   b1-Inv [3] ) + CHR(9)    ) else ("")
     4821   if Showsale       then (     excel-sum  (   b1-Inv [5] ) + CHR(9)    ) else ("")
