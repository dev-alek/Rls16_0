     4833                   excel-qnty(b1-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4834   if Showcost       then (     excel-sum  (   b1-spis[2] ) + CHR(9)     ) else ("")
