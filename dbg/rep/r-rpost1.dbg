     3559                    each ub.goods no-lock where
     3560                                               ub.goods.artic     = post-stk-line.artic     and
     3561                                               ub.goods.prod-type = post-stk-line.prod-type and
     3562                                               ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     3563                                               :
