     4507   PROCEDURE display-line :
     4508     i = i + 1.
     4509   If Integer(10) = 0 Then Temp1  = 100  .
     4510                         Else Temp1 = Integer(10) .
     4511        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4512            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4513     run clear-item in this-procedure .
     4514       assign
     4515             gds-zap-gds-name   = temp-t-post-stk-line.gds-name
     4516             gds-zap-unit-base  = temp-t-post-stk-line.unit-base
     4517             gds-zap-prt-root   = temp-t-post-stk-line.prt-root
     4518             gds-zap-prod-type  = temp-t-post-stk-line.prod-type
     4519             gds-zap-prod-code  = temp-t-post-stk-line.prod-code
     4520             gds-zap-artic      = temp-t-post-stk-line.artic
     4521             gds-zap-grp-name   = temp-t-post-stk-line.Goods-grp-name
     4522             gds-zap-b-code     = temp-t-post-stk-line.gds-code
     4523             gds-zap-type       = temp-t-post-stk-line.gds-type
     4524             pos-cli-type       = temp-t-post-stk-line.Cli-type
     4525             pos-cli-code       = temp-t-post-stk-line.Cli-code
     4526             pos-cli-grp-name   = temp-t-post-stk-line.Clients-grp-name.
     4527       run ob-line (
     4528                temp-t-post-stk-line.obj-code    ,
     4529                temp-t-post-stk-line.obj-type    ,
     4530                temp-t-post-stk-line.cli-code    ,
     4531                temp-t-post-stk-line.cli-type    ,
     4532                temp-t-post-stk-line.artic       ,
     4533                temp-t-post-stk-line.prod-code   ,
     4534                temp-t-post-stk-line.prod-type   ,
     4535                Fact-order-1   ,
     4536                Fact-order-2   ,
     4537                t#sum-type     ,
     4538                t#cat-id       ,
     4539                ""             ,
     4540                yes) .
     4541      if Show-Sale Then  run ob-line (
     4542                temp-t-post-stk-line.obj-code    ,
     4543                temp-t-post-stk-line.obj-type    ,
     4544                temp-t-post-stk-line.cli-code    ,
     4545                temp-t-post-stk-line.cli-type    ,
     4546                temp-t-post-stk-line.artic       ,
     4547                temp-t-post-stk-line.prod-code   ,
     4548                temp-t-post-stk-line.prod-type   ,
     4549                Fact-order-1   ,
     4550                Fact-order-2   ,
     4551                'sale':U    ,
     4552                '##':U ,
     4553                ""             ,
     4554                yes) .
     4555            run calc-sub-itog in this-procedure (0).
     4556               if Show-Sale Then run calc-sub-itog in this-procedure (3).
     4557               IF  NOT (NOT Show-Negativ  AND (
     4558                                          RAsh         [1] = 0  AND
     4559                                          KAssa        [1] = 0  AND
     4560                                          Inv          [1] = 0  AND
     4561                                          vzvr         [1] = 0  AND
     4562                                          vzvr-post    [1] = 0
     4563                                          ))
     4564            then DO:
     4565              IF NOT Sums-Only then DO:
     4566                 run display-str1.
     4567              End.
     4568            End.
     4569            run clear-item.
     4570     END PROCEDURE.
     4571   PROCEDURE display-str1  :
     4572        run di-qnty ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4573            if show-cost        then do: run di ("учет."  , 2 , "","", "", "", "":u).  end.
     4574            if show-cost-vat    then do: run di ("уч.НДС" , 3 , "","", "", "", "":u).  end.
     4575            if show-sale        then do: run di ("док-т." , 5 , "","", "", "", "":u).  end.
     4576            if show-sale-vat    then do: run di ("д .НДС" , 6 , "","", "", "", "":u).  end.
     4577   END PROCEDURE.
     4578   PROCEDURE Di :
     4579   def input parameter p1 as char no-undo.
     4580   def input parameter p2 as int no-undo.
     4581   def input parameter p3 as char no-undo.
     4582   def input parameter p4 as char no-undo.
     4583   def input parameter p5 as char no-undo.
     4584   def input parameter p6 as char no-undo.
     4585   def input parameter p7 as char no-undo.
     4586    CASE CAPS(p7) :
     4587      WHEN "P":U  Then
     4588                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4589                   p3 @ gds-zap-b-code
     4590                   p4 @ gds-zap-artic
     4591                   p5 @ gds-zap-gds-name
     4592                   p6 @ gds-zap-unit-base
     4593                   p1 @ gds-type
     4594                  p-vzvr      [p2]    @  F-vzvr
     4595                  p-vzvr-post [p2]    @  F-vzvr-post
     4596                  p-RAsh      [p2]    @  F-RAsh
     4597                  p-KAssa     [p2]    @  F-KAssa
     4598                  p-Inv       [p2]    @  F-Inv
     4599                  p-spis      [p2]    @  F-spis
     4600                  with FRAME ZAPAS .
     4601      WHEN "O":U  Then
     4602                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4603                   p3 @ gds-zap-b-code
     4604                   p4 @ gds-zap-artic
     4605                   p5 @ gds-zap-gds-name
     4606                   p6 @ gds-zap-unit-base
     4607                   p1 @ gds-type
     4608                  o-vzvr      [p2]    @  F-vzvr
     4609                  o-vzvr-post [p2]    @  F-vzvr-post
     4610                  o-RAsh      [p2]    @  F-RAsh
     4611                  o-KAssa     [p2]    @  F-KAssa
     4612                  o-Inv       [p2]    @  F-Inv
     4613                  o-spis      [p2]    @  F-spis
     4614                  with FRAME ZAPAS .
     4615      WHEN "B1":U  Then
     4616                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4617                   p3 @ gds-zap-b-code
     4618                   p4 @ gds-zap-artic
     4619                   p5 @ gds-zap-gds-name
     4620                   p6 @ gds-zap-unit-base
     4621                   p1 @ gds-type
     4622                  b1-vzvr      [p2]    @  F-vzvr
     4623                  b1-vzvr-post [p2]    @  F-vzvr-post
     4624                  b1-RAsh      [p2]    @  F-RAsh
     4625                  b1-KAssa     [p2]    @  F-KAssa
     4626                  b1-Inv       [p2]    @  F-Inv
     4627                  b1-spis      [p2]    @  F-spis
     4628                  with FRAME ZAPAS .
     4629      WHEN "B2":U  Then
     4630                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4631                   p3 @ gds-zap-b-code
     4632                   p4 @ gds-zap-artic
     4633                   p5 @ gds-zap-gds-name
     4634                   p6 @ gds-zap-unit-base
     4635                   p1 @ gds-type
     4636                  b2-vzvr      [p2]    @  F-vzvr
     4637                  b2-vzvr-post [p2]    @  F-vzvr-post
     4638                  b2-RAsh      [p2]    @  F-RAsh
     4639                  b2-KAssa     [p2]    @  F-KAssa
     4640                  b2-Inv       [p2]    @  F-Inv
     4641                  b2-spis      [p2]    @  F-spis
     4642                  with FRAME ZAPAS .
     4643      WHEN "BI":U Then
     4644                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4645                   p3 @ gds-zap-b-code
     4646                   p4 @ gds-zap-artic
     4647                   p5 @ gds-zap-gds-name
     4648                   p6 @ gds-zap-unit-base
     4649                   p1 @ gds-type
     4650                  bi-vzvr      [p2]    @  F-vzvr
     4651                  bi-vzvr-post [p2]    @  F-vzvr-post
     4652                  bi-RAsh      [p2]    @  F-RAsh
     4653                  bi-KAssa     [p2]    @  F-KAssa
     4654                  bi-Inv       [p2]    @  F-Inv
     4655                  bi-spis      [p2]    @  F-spis
     4656                  with FRAME ZAPAS .
     4657      WHEN ""  Then DO:
     4658                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4659                   p3 @ gds-zap-b-code
     4660                   p4 @ gds-zap-artic
     4661                   p5 @ gds-zap-gds-name
     4662                   p6 @ gds-zap-unit-base
     4663                   p1 @ gds-type
     4664                  vzvr      [p2]    @  F-vzvr
     4665                  vzvr-post [p2]    @  F-vzvr-post
     4666                  RAsh      [p2]    @  F-RAsh
     4667                  KAssa     [p2]    @  F-KAssa
     4668                  Inv       [p2]    @  F-Inv
     4669                  spis      [p2]    @  F-spis
     4670                  with FRAME ZAPAS .
     4671                 End.
     4672      End case.
     4673                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4674    END PROCEDURE.
     4675   PROCEDURE Di-qnty :
     4676   def input parameter p1 as char no-undo.
     4677   def input parameter p2 as int no-undo.
     4678   def input parameter p3 as char no-undo.
     4679   def input parameter p4 as char no-undo.
     4680   def input parameter p5 as char no-undo.
     4681   def input parameter p6 as char no-undo.
     4682   def input parameter p7 as char no-undo.
     4683    CASE CAPS(p7) :
     4684      WHEN "O":U  Then DO :
     4685                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4686                   p3 @ gds-zap-b-code
     4687                   p4 @ gds-zap-artic
     4688                   p5 @ gds-zap-gds-name
     4689                   p6 @ gds-zap-unit-base
     4690                   p1 @ gds-type
     4691                  o-vzvr      [p2]    @  F-vzvr
     4692                  o-vzvr-post [p2]    @  F-vzvr-post
     4693                  o-RAsh      [p2]    @  F-RAsh
     4694                  o-KAssa     [p2]    @  F-KAssa
     4695                  o-Inv       [p2]    @  F-Inv
     4696                  o-spis      [p2]    @  F-spis
     4697                  with FRAME ZAPAS .
     4698       if Make-Excel then  put   stream ForExcel unformatted p3 CHR(9)
     4699                   p4 CHR(9)
     4700                   p5 CHR(9)
     4701                   p6 CHR(9)
     4702                   gds-zap-type CHR(9)
     4703                    excel-qnty(o-RAsh         [1]  ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4704   if Showcost       then (     excel-sum  (   o-RAsh[2] )  + CHR(9)   ) else ("")
     4705   if Show-cost-vat  then (     excel-sum  (   o-RAsh[3] )  + CHR(9)   ) else ("")
     4706   if Showsale       then (     excel-sum  (   o-RAsh[5] )  + CHR(9)   ) else ("")
     4707   if Show-sale-vat  then (     excel-sum  (   o-RAsh[6] )  + CHR(9)   ) else ("")
     4708                    excel-qnty(o-KAssa        [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4709   if Showcost       then (     excel-sum  (   o-KAssa[2])  + CHR(9)    ) else ("")
     4710   if Show-cost-vat  then (     excel-sum  (   o-KAssa[3])  + CHR(9)    ) else ("")
     4711   if Showsale       then (     excel-sum  (   o-KAssa[5])  + CHR(9)    ) else ("")
     4712   if Show-sale-vat  then (     excel-sum  (   o-KAssa[6])  + CHR(9)    ) else ("")
     4713   .
     4714   if Make-Excel then  put   stream ForExcel unformatted     excel-qnty( o-Inv            [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4715   if Showcost       then (     excel-sum  (   o-Inv [2] ) + CHR(9)    ) else ("")
     4716   if Show-cost-vat  then (     excel-sum  (   o-Inv [3] ) + CHR(9)    ) else ("")
     4717   if Showsale       then (     excel-sum  (   o-Inv [5] ) + CHR(9)    ) else ("")
     4718   if Show-sale-vat  then (     excel-sum  (   o-Inv [6] ) + CHR(9)    ) else ("")
     4719                    excel-qnty(o-vzvr         [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4720   if Showcost       then (     excel-sum  (   o-vzvr [2] ) + CHR(9)    ) else ("")
     4721   if Show-cost-vat  then (     excel-sum  (   o-vzvr [3] ) + CHR(9)    ) else ("")
     4722   if Showsale       then (     excel-sum  (   o-vzvr [5] ) + CHR(9)    ) else ("")
     4723   if Show-sale-vat  then (     excel-sum  (   o-vzvr [6] ) + CHR(9)    ) else ("")
     4724                   excel-qnty(o-vzvr-post    [1]) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4725   if Showcost       then (     excel-sum  (   o-vzvr-post[2] ) + CHR(9)     ) else ("")
     4726   if Show-cost-vat  then (     excel-sum  (   o-vzvr-post[3] ) + CHR(9)     ) else ("")
     4727   if Showsale       then (     excel-sum  (   o-vzvr-post[5] ) + CHR(9)     ) else ("")
     4728   if Show-sale-vat  then (     excel-sum  (   o-vzvr-post[6] ) + CHR(9)     ) else ("")
     4729                   excel-qnty(o-spis    [1] ) FORMAT "->>>>>>>>>>>9.<<<"  CHR(9)
     4730   if Showcost       then (     excel-sum  (   o-spis[2] ) + CHR(9)     ) else ("")
     4731   if Show-cost-vat  then (     excel-sum  (   o-spis[3] ) + CHR(9)     ) else ("")
     4732   if Showsale       then (     excel-sum  (   o-spis[5] ) + CHR(9)     ) else ("")
     4733   if Show-sale-vat  then (     excel-sum  (   o-spis[6] ) + CHR(9)     ) else ("")
     4734            chr(10).
     4735                   End.
     4736      WHEN "P":U  Then DO :
     4737                DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12
     4738                   p3 @ gds-zap-b-code
     4739                   p4 @ gds-zap-artic
     4740                   p5 @ gds-zap-gds-name
     4741                   p6 @ gds-zap-unit-base
     4742                   p1 @ gds-type
     4743                  p-vzvr      [p2]    @  F-vzvr
     4744                  p-vzvr-post [p2]    @  F-vzvr-post
     4745                  p-RAsh      [p2]    @  F-RAsh
