     4178   procedure Print-Header :
     4179   define input parameter N as integer no-undo .
     4180   define input parameter Name as char no-undo .
     4181   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
