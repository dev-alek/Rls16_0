     4830   if Show-cost-vat  then (     excel-sum  (   b1-vzvr-post[3] ) + CHR(9)     ) else ("")
     4831   if Showsale       then (     excel-sum  (   b1-vzvr-post[5] ) + CHR(9)     ) else ("")
