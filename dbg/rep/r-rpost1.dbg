     1193   procedure create-temp-t-post-stk-line :
     1194       define variable str  as char      format "X(60)" no-undo.
     1195       define variable str2 as char      no-undo.
     1196       define variable v-r  as character no-undo init "" .
     1197       define variable i#i  as int       no-undo.
     1198    do
     1199    on error undo, return error return-value
     1200    :
     1201    if available ub.goods and
     1202       available ub.clients and
     1203       available prod-cli then do:
     1204     create temp-t-post-stk-line .
     1205     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1206     assign
     1207       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1208       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1209       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1210       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1211       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1212       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1213       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1214       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1215       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1216       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1217       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1218     .
     1219               if xlavel > 0 then
     1220               do:
     1221                   repeat i#i =1 to xlavel:
     1222                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1223                       else
     1224                       do:
     1225                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1226                           if not error-status:error  and str2 <> "":u then
     1227                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1228                       end.
     1229                   end.
     1230                   if str <> ? then
     1231                   do:
     1232                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1233                   end.
     1234               end.
     1235               else
     1236               do :
     1237                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1238               end.
     1239           end.
     1240    end.
     1241   end procedure.
     1242   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1243     if num-entries(string(p-dec), '.') = 2
     1244       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1245       else return( string(p-dec)) .
     1246   end function.
     1247   function format-point-to-comma returns char (input orig as char ) .
     1248   define variable rtext as character no-undo .
     1249   define variable strt as integer no-undo .
     1250   define variable leng as integer no-undo .
     1251   assign rtext = orig .
     1252   repeat:
     1253     strt =  index(rtext,'.').
     1254     if strt = 0 then leave.
     1255     leng = 1.
     1256     substring(rtext,strt,leng,"character") = v-delim .
     1257   end.
     1258   return rtext.
     1259   end function.
     1260   function format-excel-text returns char ( input start-text as char ) :
     1261   def var  i    as int no-undo.
     1262   def var  ch   as char no-undo.
     1263   def var  n    as int no-undo.
     1264   def var  ipos as int no-undo.
     1265     n = num-entries(trim(start-text), chr(10)) - 1 .
     1266     do i = 1 to n :
     1267       ipos = index( start-text, chr(10)).
     1268       if ipos > 0 then
     1269         substr( start-text, ipos, 1 ) = ' '.
     1270     end.
     1271     n = num-entries(trim(start-text), chr(13)) - 1 .
     1272     do i = 1 to n :
     1273       ipos = index( start-text, chr(13)).
     1274       if ipos > 0 then
     1275         substr( start-text, ipos, 1 ) = ' '.
     1276     end.
     1277     if index( start-text, '"' ) = 0 then
     1278       start-text =  '="'   + trim( start-text) + '"'   .
     1279       else do:
     1280         n = num-entries(trim(start-text), '"') - 1.
     1281         do i = 1 to n :
     1282           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1283         end.
     1284         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1285         start-text = '="'  + ch  + '"' .
     1286       end.
     1287     return start-text.
     1288   end.
     1289   function excel-sum returns char (input p-dec as decimal ).
     1290     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1291   end function.
     1292   function excel-qnty returns char (input p-dec as decimal ).
     1293     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1294   end function.
     1295   function format-excel-text-macr returns char ( input start-text as char ) :
     1296   def var  i    as int no-undo.
     1297   def var  ch   as char no-undo.
     1298   def var  n    as int no-undo.
     1299   def var  ipos as int no-undo.
     1300     n = num-entries(trim(start-text), chr(10)) - 1 .
     1301     do i = 1 to n :
     1302       ipos = index( start-text, chr(10)).
     1303       if ipos > 0 then
     1304         substring( start-text, ipos , 1 ) = ' '.
     1305     end.
     1306     n = num-entries(trim(start-text), chr(13)) - 1 .
     1307     do i = 1 to n :
     1308       ipos = index( start-text, chr(13)).
     1309       if ipos > 0 then
     1310         substring( start-text, ipos, 1 ) = ' '.
     1311     end.
     1312     if index( start-text, '"' ) = 0 then
     1313       start-text =  '"'   + trim( start-text) + '"'   .
     1314       else do:
     1315         n = num-entries(trim(start-text), '"') - 1.
     1316         do i = 1 to n :
     1317           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1318         end.
     1319         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1320         start-text = '"'  + ch  + '"' .
     1321       end.
     1322     n = num-entries(trim(start-text), chr(10)) - 1 .
     1323     do i = 1 to n :
     1324       ipos = index( start-text, chr(10)).
     1325       if ipos > 0 then
     1326         substring( start-text, ipos , 1 ) = ' '.
     1327     end.
     1328       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1329     return start-text.
     1330   end.
     1331   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1332   define variable  str  as char format "X(60)"  no-undo.
     1333   define variable  str2 as char no-undo.
     1334   define variable v-r as character no-undo init "" .
     1335   define variable  i#i as int no-undo.
     1336   STR = "".
     1337   repeat i#i =1 to lavel#:
     1338       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1339       else do:
     1340           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1341           if not error-status:error  and str2 <> "":u then
     1342                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1343           end.
     1344   end.
     1345   if str <> ? then do:
     1346   v-r = str + chr(47) .
     1347   end.
     1348   RETURN v-r .
     1349   END FUNCTION.
     1350   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1351   define variable v-waitfram-action01         as character   no-undo .
     1352   define variable v-waitfram-action02         as character   no-undo .
     1353   define variable v-waitfram-action03         as character   no-undo .
     1354   define variable mWaitFramTextBeg            as character   no-undo.
     1355   define variable mWaitFramTextEnd            as character   no-undo.
     1356   define variable mWaitFramView               as logical     no-undo.
     1357   define variable mWaitProcEvent              as logical     no-undo init yes.
     1358   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1359   define variable mWaitFramStop               as logical     no-undo.
     1360   define variable mWaitFramStopUser           as logical     no-undo.
     1361   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1362   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1363   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1364   define button B-WaitFramStop auto-end-key
     1365        label "Стоп"
     1366        size 10 by 1 tooltip "Остоновить процесс".
     1367   define button B-viewProcInfo
     1368        label "Информация"
     1369        size 15 by 1 tooltip "Информация о процесс".
     1370   define frame waitfram
     1371     v-waitfram-action01 format "x(72)" no-label skip
     1372     v-waitfram-action02 format "x(72)" no-label skip
     1373     v-waitfram-action03 format "x(72)" no-label skip
     1374     B-viewProcInfo
     1375     B-WaitFramStop at row 4 col 30
     1376     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1377     .
     1378   define new global shared variable mBatchMode as logical no-undo init ?.
     1379   define variable mFramBachModHandle as handle no-undo.
     1380   mFramBachModHandle = frame waitfram:handle.
     1381   define variable mFameOldVis as logical no-undo.
     1382   define variable mVisCUrentVin as logical no-undo.
     1383   if session:batch-mode
     1384   then
     1385      mBatchMode = yes.
     1386   if mBatchMode = ? then do:
     1387     mVisCUrentVin = current-window:visible.
     1388     mFameOldVis = mFramBachModHandle:visible.
     1389     mFramBachModHandle:visible  = yes.
     1390     mBatchMode = mFramBachModHandle:visible ne yes.
     1391     mFramBachModHandle:visible = mFameOldVis.
     1392     current-window:visible = mVisCUrentVin.
     1393   end.
     1394    if  log-manager:logfile-name ne ?
     1395     then DO:
     1396         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1397         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1398         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1399     end.
     1400   on choose of B-WaitFramStop in frame waitfram
     1401   do:
     1402     mWaitFramStop = yes.
     1403     mWaitFramStopUser = yes.
     1404   end.
     1405   function waitfram-check-timeout returns logical():
     1406      define variable vtime as int64 no-undo.
     1407      if mWaitFramStopTimeOut
     1408      then
     1409         return yes.
     1410      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1411      if     mWaitFramTimeOut ne ?
     1412         and mWaitFramTimeOut ne 0
     1413         and mWaitFramTimeOut lt vtime
     1414      then do:
     1415         mWaitFramStopTimeOut = yes.
     1416      end.
     1417      return mWaitFramStopTimeOut.
     1418   end.
     1419   procedure waitfram-hide :
     1420     if not session:batch-mode
     1421     then do
     1422     on error undo, return error return-value
     1423     :
     1424       pause 0 before-hide .
     1425       if not mBatchMode then
     1426         hide frame waitfram .
     1427     if     not mWaitFramView
     1428        and mWaitProcEvent
     1429     then
     1430       process events .
     1431     end.
     1432   end procedure.
     1433   procedure waitfram-show :
     1434     define input  parameter p-message as character no-undo .
     1435     define variable v-left-margin as integer   no-undo .
     1436     if not session:batch-mode
     1437     then do
     1438     on error undo, return error return-value
     1439     :
     1440       if length(p-message) <= 70 then do:
     1441         assign
     1442           v-left-margin = integer((70 - length(p-message)) / 2)
     1443         .
     1444         assign
     1445           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1446         .
     1447         assign
     1448           v-waitfram-action01 = " "
     1449           v-waitfram-action02 = " "
     1450                                    + fill(" ", v-left-margin)
     1451                                    + p-message
     1452           v-waitfram-action03 = " "
     1453         .
     1454       end.
     1455       else do:
     1456         define variable vRindex1 as integer no-undo.
     1457         define variable vRindex2 as integer no-undo.
     1458         vRindex1 = r-index(p-message," ",70).
     1459         if vRindex1 = 0
     1460         then
     1461            vRindex1 = 70.
     1462         if length(p-message)  <= vRindex1 + 70 then do:
     1463           assign
     1464             v-waitfram-action01 = " "
     1465             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1466             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1467           .
     1468         end.
     1469         else do:
     1470           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1471           if vRindex2 <= vRindex1
     1472           then
     1473              vRindex2 = vRindex1 + 70.
     1474           assign
     1475             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1476             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1477             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1478           .
     1479         end.
     1480       end.
     1481       B-viewProcInfo:visible   in frame waitfram = no.
     1482       B-viewProcInfo:sensitive in frame waitfram = no.
     1483       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1484       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1485       if  (   mWaitFramView
     1486          or  mWaitProcEvent)
     1487          and not mBatchMode
     1488       then
     1489          display
     1490             v-waitfram-action01 skip
     1491             v-waitfram-action02 skip
     1492             v-waitfram-action03 skip
     1493          with frame waitfram .
     1494       if     mWaitFramView
     1495          then do:
     1496             if     mWaitFramInterval ne ?
     1497                and not mBatchMode
     1498             then
     1499                wait-for go of frame waitfram pause mWaitFramInterval.
     1500          end.
     1501          else
     1502             if     mWaitProcEvent
     1503                and not mBatchMode
     1504             then
     1505                process events .
     1506     end.
     1507   end procedure.
     1508      procedure waitfram-show-this:
     1509         define input  parameter iInterval as int64 no-undo.
     1510         define variable vtime as int64 no-undo.
     1511         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1512         mWaitFramInterval = iInterval.
     1513         run waitfram-show (substitute("&1&2 &3&4" ,
     1514                                       mWaitFramTextBeg ,
     1515                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1516                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1517                                       mWaitFramTextEnd
     1518                                      )
     1519                           ).
     1520      end.
     1521      procedure WaitFramRunPause:
     1522         define input  parameter iInterval as dec no-undo.
     1523         define variable vStart  as datetime-tz no-undo.
     1524         define variable vend    as datetime-tz no-undo.
     1525         define variable vint as int64 no-undo.
     1526         define variable vOk as logical no-undo.
     1527         vStart = now.
     1528         vend   = vStart.
     1529         publish "WaitFramPause" (iInterval,output vOk).
     1530         vend   =  now.
     1531         vint = vend - vStart.
     1532         vint = iInterval - vint / 1000.
     1533         if     not mWaitFramStop
     1534            and (   vint > 0
     1535                 or (    not vOk
     1536                     and iInterval eq ?
     1537                     )
     1538                 )
     1539         then
     1540            run waitfram-show-this (iInterval).
     1541         vend   =  now.
     1542         vint = vend - vStart.
     1543         vint = iInterval - vint / 1000.
     1544         if     not mWaitFramStop
     1545            and vint > 0
     1546         then do:
     1547            run gbl/pause.p (vint * 1000).
     1548         end.
     1549         if iInterval ne ?
     1550         then
     1551            publish "WaitFramStop".
     1552         waitfram-check-timeout().
     1553      end.
     1554      procedure WaitFramWaitFor:
     1555         define input  parameter iInterval as dec no-undo.
     1556         assign
     1557            mWaitFramStartProc   = now
     1558            mWaitFramStopUser    = no
     1559            mWaitFramStopTimeOut = no
     1560         .
     1561         block-wait:
     1562         do while not mWaitFramStop:
     1563            run WaitFramRunPause (iInterval).
     1564            if  waitfram-check-timeout()
     1565            then do:
     1566               leave block-wait.
     1567            end.
     1568         end.
     1569         run waitfram-hide.
     1570      end.
     1571   procedure waitfram-join :
     1572     define input  parameter p-line-1  as character no-undo .
     1573     define input  parameter p-line-2  as character no-undo .
     1574     define input  parameter p-line-3  as character no-undo .
     1575     define output parameter p-message as character no-undo .
     1576     do
     1577     on error undo, return error return-value
     1578     :
     1579       assign
     1580         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1581                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1582                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1583       .
     1584     end.
     1585   end procedure.
     1586   function waitfram-join-function returns character
     1587     (input p-line-1 as character
     1588     ,input p-line-2 as character
     1589     ,input p-line-3 as character
     1590     ).
     1591     define variable v-message as character no-undo .
     1592     run waitfram-join in this-procedure
     1593       (input  p-line-1
     1594       ,input  p-line-2
     1595       ,input  p-line-3
     1596       ,output v-message
     1597       ) .
     1598     return v-message .
     1599   end function .
     1600   define buffer goods   for ub.goods  .
     1601   define buffer gds-obj for ub.gds-obj  .
     1602   define buffer clients for ub.clients  .
     1603   define variable ii like i init 0 no-undo .
     1604   define variable t#cat-id like stk-line.cat-id no-undo .
     1605   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1606   define variable t#kol-rec-obj like i init 0  no-undo .
     1607   if Show-Negativ then null-fact-order = 0 .
     1608      else  null-fact-order = fact-order-1 .
     1609   for each obj-list no-lock :
     1610     t#kol-rec-obj = t#kol-rec-obj + 1.
     1611   End.
     1612   case type-stor  :
     1613     when 1 then  do:
     1614       Assign
     1615         t#cat-id   = '##':U
     1616         t#sum-type = 'cost':U  .
     1617     end.
     1618     when 2 then do:
     1619       Assign
     1620         t#cat-id   = 'prch':U
     1621         t#sum-type = 'cost':U + 'p':U .
     1622     end.
     1623     when 3 then do:
     1624       Assign
     1625         t#cat-id   = 'cacc':U
     1626         t#sum-type = 'cost':U + 'p':U .
     1627     end.
     1628     when 4 then do:
     1629       Assign
     1630         t#cat-id   = 'stor':U
     1631         t#sum-type = 'cost':U + 'p':U .
     1632     end.
     1633     when 5 then do:
     1634       Assign
     1635         t#cat-id   = 'cons':U
     1636         t#sum-type = 'cost':U + 'p':U .
     1637     end.
     1638   End case.
     1639   if xTogobj = false  then DO:
     1640     Case Select-Good :
     1641       when 1   then    RUN Run1-0.
     1642       when 2   then    run run2-0.
     1643       when 3  then    run run3-0.
     1644       otherwise do:
     1645           run run45-0.
     1646       end.
     1647     End case.
     1648   End.
     1649   Else do:
     1650     Case Select-Good :
     1651       when 1  then    RUN Run1.
     1652       when 2  then    run run2.
     1653       when 3 then    run run3.
     1654       otherwise do:
     1655         run run45.
     1656       end.
     1657     End case.
     1658   End.
     1659   procedure run1 :
     1660   CASE RetClassify :
     1661     when "no-classify":U then  DO:
     1662          For each obj-list no-lock :
     1663            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1664            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1665             For each post-stk-line  no-lock where
     1666                                               post-stk-line.obj-type = obj-list.obj-type and
     1667                                               post-stk-line.obj-code = obj-list.obj-code and
     1668                                               post-stk-line.fact-order >= null-fact-order   and
     1669                                               post-stk-line.fact-order <= fact-order-2   and
     1670                                               post-stk-line.sum-type    = 'cost':U    and
     1671                                               post-stk-line.cat-id      = '##':U
     1672                                               :
     1673                    find first  temp-t-post-stk-line where
     1674                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1675                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1676                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1677                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1678                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1679                      if not available  temp-t-post-stk-line then do:
     1680                         find first  ub.goods no-lock where
     1681                                               ub.goods.artic     = post-stk-line.artic     and
     1682                                               ub.goods.prod-type = post-stk-line.prod-type and
     1683                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1684                         find first  prod-cli no-lock  where
     1685                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1686                                                   prod-cli.obj-code = post-stk-line.prod-code
     1687                                                   no-error .
     1688                         find first  ub.clients  no-lock  where
     1689                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1690                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1691                           run create-temp-t-post-stk-line .
     1692                    end.
     1693                    else do:
     1694                            assign
     1695                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1696                            .
     1697                    end.
     1698             end.
     1699             For each temp-t-post-stk-line no-lock   ,
     1700                    Last temp-post-stk-line  where
     1701                         temp-post-stk-line.fact-order <= fact-order-2   and
     1702                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1703                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1704                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1705                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1706                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1707                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1708                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1709                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1710                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1711                         no-lock
     1712                         on error undo , next
     1713                         break
     1714                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1715                         By temp-t-post-stk-line.artic
     1716                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1717                         By Temp-t-post-stk-line.Fact-order
     1718                        :
     1719                 if NOT(Sums-Only = true ) then DO:
     1720                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1721                 End.
     1722                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1723                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1724                                            run display-line .
     1725                                       End.
     1726                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1727             End.
     1728            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1729           .
     1730          End.
     1731     End.
     1732     when "grp-goods":U  then     DO:
     1733       if xLavel = 0 THEN  DO:
     1734          For each obj-list no-lock :
     1735            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1736            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1737             For each post-stk-line  no-lock where
     1738                                               post-stk-line.obj-type = obj-list.obj-type and
     1739                                               post-stk-line.obj-code = obj-list.obj-code and
     1740                                               post-stk-line.fact-order >= null-fact-order   and
     1741                                               post-stk-line.fact-order <= fact-order-2   and
     1742                                               post-stk-line.sum-type    = 'cost':U    and
     1743                                               post-stk-line.cat-id      = '##':U
     1744                                               :
     1745                    find first  temp-t-post-stk-line where
     1746                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1747                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1748                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1749                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1750                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1751                      if not available  temp-t-post-stk-line then do:
     1752                         find first  ub.goods no-lock where
     1753                                               ub.goods.artic     = post-stk-line.artic     and
     1754                                               ub.goods.prod-type = post-stk-line.prod-type and
     1755                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1756                         find first  prod-cli no-lock  where
     1757                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1758                                                   prod-cli.obj-code = post-stk-line.prod-code
     1759                                                   no-error .
     1760                         find first  ub.clients  no-lock  where
     1761                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1762                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1763                           run create-temp-t-post-stk-line .
     1764                    end.
     1765                    else do:
     1766                            assign
     1767                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1768                            .
     1769                    end.
     1770             end.
     1771             For each temp-t-post-stk-line no-lock   ,
     1772                    Last temp-post-stk-line  where
     1773                         temp-post-stk-line.fact-order <= fact-order-2   and
     1774                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1775                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1776                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1777                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1778                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1779                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1780                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1781                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1782                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1783                         no-lock
     1784                         on error undo , next
     1785                         break
