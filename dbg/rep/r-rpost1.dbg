     3569                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     3570                      if not available  temp-t-post-stk-line then do:
     3571                         find first  prod-cli no-lock  where
     3572                                                   prod-cli.obj-type = post-stk-line.prod-type and
     3573                                                   prod-cli.obj-code = post-stk-line.prod-code
     3574                                                   no-error .
     3575                         find first  ub.clients  no-lock  where
     3576                                                   ub.clients.obj-type = post-stk-line.cli-type and
     3577                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     3578                           run create-temp-t-post-stk-line .
     3579                    end.
     3580                    else do:
     3581                            assign
