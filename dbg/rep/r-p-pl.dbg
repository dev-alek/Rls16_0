     1066     define variable v-cntxt-obj-code      as integer   no-undo .
     1067     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1068     define variable v-cntxt-is-admin      as logical   no-undo .
     1069   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1070     run mainmenu_getcntxt in my-handle
     1071       (output v-cntxt-db-num
     1072       ,output v-cntxt-userid
     1073       ,output v-cntxt-level
     1074       ,output v-cntxt-host-code-obj
     1075       ,output v-cntxt-obj-type
     1076       ,output v-cntxt-obj-code
     1077       ,output v-cntxt-db-num-obj
     1078       ,output v-cntxt-is-admin
     1079       ) .
     1080   define variable base-type as character no-undo .
     1081   define variable base-code as integer   no-undo .
     1082   define variable g#report-num as integer   no-undo .
     1083   define variable g#gds-engl as logical   no-undo .
     1084   define variable vv-exch-rate  as decimal   no-undo .
     1085   define variable vv-exch-scale as decimal   no-undo .
     1086   define variable v-cntxt-host-name-obj as character no-undo .
     1087   if v-cntxt-level = 'object':U then do:
     1088   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1089   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1090     (input  v-cntxt-obj-type
     1091     ,input  v-cntxt-obj-code
     1092     ,output v-cntxt-host-code-obj
     1093     ,output v-cntxt-host-name-obj
     1094     )  .
     1095   end.
     1096   if v-cntxt-level = 'firm':U then do:
     1097     find first ub.clients no-lock where
     1098                ub.clients.obj-type = 'орг':U and
     1099                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1100   if error-status :error then v-cntxt-host-name-obj = ? .
     1101      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1102   end.
     1103   if v-cntxt-level = 'object':U
     1104   or v-cntxt-level = 'firm':U
     1105   then do:
     1106   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1107   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1108     (input  v-cntxt-host-code-obj
     1109     ,output base-code
     1110     )  .
     1111   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1112   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1113     (input  base-code
     1114     ,input  today
     1115     ,output vv-exch-rate
     1116     ,output vv-exch-scale
     1117     ,output base-type
     1118     )  .
     1119   end.
     1120   run get-report-num in my-handle ( output g#report-num ).
     1121   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1122   define variable parhost-code as integer   no-undo .
     1123   parhost-code = v-cntxt-host-code-obj.
     1124   define variable kol-post as integer   no-undo .
     1125   def SHARED temp-table g#post-f NO-UNDO
     1126       field obj-type like ub.clients.obj-type
     1127       field obj-code like ub.clients.obj-code
     1128       field obj-name like ub.clients.obj-name
     1129       field grp-code like ub.clients.grp-code
     1130       field grp-name like ub.clients.grp-name
     1131       field lvl-num like  ub.cli-grp.lvl-num
     1132       INDEX pi IS UNIQUE PRIMARY obj-type obj-code
     1133       INDEX p1  obj-name
     1134       .
     1135       if radpost <> 1 and not can-find (first g#post-f) then do:
     1136           message "Не выбран ни один ПОСТАВЩИК ! " view-as alert-box error .
     1137           return error.
     1138       end.
     1139   define variable v-kol-col as integer   no-undo .
     1140   v-kol-col = 0.
     1141       for each g#post-f :
     1142          v-kol-col =v-kol-col + 1 .
     1143       end.
     1144   if v-kol-col > 256 then do:
     1145      message 'Разрешено выводить не более 256 колонок. Очень большое количество поставщиков' v-kol-col .
     1146      return .
     1147   end.
     1148       if not can-find (first gds-list) then do:
     1149           message "Не выбран ни один товар !" view-as alert-box error .
     1150           return error.
     1151       end.
     1152   define buffer bf_cli-gds  for ub.cli-gds .
     1153   define buffer bf_doc-line for ub.doc-line.
     1154   define buffer buf_cli-post for ub.clients.
     1155   define variable v-price-rubl as decimal decimals 2  no-undo .
     1156   define variable v-price-cli  as decimal   no-undo .
     1157   define variable v-goods as logical   no-undo .
     1158   define temp-table tt-temp no-undo
     1159   field cli-code   as integer
     1160   field cli-type   as character
     1161   field gds-code   as integer
     1162   field price-rubl  as decimal decimals 2 format ">>>>>>>>>>>>9.99"
     1163   field price-cli   as decimal
     1164   index cli-gds cli-code cli-type gds-code
     1165   .
     1166   CASE radpost:
     1167     when 1 then do:
     1168       _gds-list:
     1169       for each gds-list,
     1170           each bf_cli-gds where
     1171                bf_cli-gds.artic = gds-list.artic
     1172            AND bf_cli-gds.prod-type = gds-list.prod-type
     1173            AND bf_cli-gds.prod-code = gds-list.prod-code
     1174            AND bf_cli-gds.host-code = parhost-code:
     1175         if bf_cli-gds.cli-type = 'маг':U
     1176         or bf_cli-gds.cli-type = 'скл':U then NEXT _gds-list.
     1177         assign
     1178         v-price-cli = bf_cli-gds.price-cli
     1179         .
     1180         find first bf_doc-line where bf_doc-line.doc-code  = bf_cli-gds.in-code   and
     1181                                     bf_doc-line.artic     = bf_cli-gds.artic     and
     1182                                     bf_doc-line.prod-type = bf_cli-gds.prod-type and
     1183                                     bf_doc-line.prod-code = bf_cli-gds.prod-code no-lock no-error.
     1184         if available bf_doc-line
     1185         and bf_doc-line.ext-doc-type = 'ie':U
     1186         and bf_doc-line.status_ = 'факт':U
     1187         then do:
     1188           v-price-rubl = bf_doc-line.price-rubl .
     1189           create tt-temp.
     1190           assign
     1191             tt-temp.cli-code   = bf_cli-gds.cli-code
     1192             tt-temp.cli-type   = bf_cli-gds.cli-type
     1193             tt-temp.gds-code   = gds-list.gds-code
     1194             tt-temp.price-rubl = v-price-rubl
     1195             tt-temp.price-cli  = v-price-cli
     1196           .
     1197           find first g#post-f  where
     1198                     g#post-f.obj-type = bf_cli-gds.cli-type
     1199               AND  g#post-f.obj-code = bf_cli-gds.cli-code no-error .
     1200           if not available g#post-f then do:
     1201             find first buf_cli-post no-lock where
     1202                       buf_Cli-post.obj-type = bf_cli-gds.cli-type
     1203                   AND buf_Cli-post.obj-code = bf_cli-gds.cli-code no-error .
     1204             create g#post-f.
     1205             assign
     1206             g#post-f.obj-type = bf_cli-gds.cli-type
     1207             g#post-f.obj-code = bf_cli-gds.cli-code
     1208             g#post-f.obj-name = (if available buf_cli-post then buf_cli-post.obj-name else '':U)
     1209             kol-post = kol-post + 1
     1210             .
     1211           end.
     1212         end.
     1213       end.
     1214     end.
     1215     when 2  or when 3 then do:
     1216       for each g#post-f :
     1217         kol-post = kol-post + 1.
     1218         for each gds-list :
     1219           v-price-rubl = 0.
     1220           v-goods = false .
     1221           v-price-cli = 0 .
     1222           find first bf_cli-gds where bf_cli-gds.cli-code  = g#post-f.obj-code
     1223                                   and bf_cli-gds.cli-type  = g#post-f.obj-type
     1224                                   and bf_cli-gds.host-code = parhost-code
     1225                                   and bf_cli-gds.artic     = gds-list.artic
     1226                                   and bf_cli-gds.prod-code = gds-list.prod-code
     1227                                   and bf_cli-gds.prod-type = gds-list.prod-type no-lock no-error.
     1228           if available bf_cli-gds then do:
     1229             assign
     1230               v-price-cli = bf_cli-gds.price-cli
     1231               v-goods = true
     1232               .
     1233             find first bf_doc-line where bf_doc-line.doc-code  = bf_cli-gds.in-code   and
     1234                                         bf_doc-line.artic     = bf_cli-gds.artic     and
     1235                                         bf_doc-line.prod-type = bf_cli-gds.prod-type and
     1236                                         bf_doc-line.prod-code = bf_cli-gds.prod-code no-lock no-error.
     1237             if available bf_doc-line
     1238             and bf_doc-line.ext-doc-type = 'ie':U
     1239             and bf_doc-line.status_ = 'факт':U
     1240             then do:
     1241               v-price-rubl = bf_doc-line.price-rubl .
     1242               create tt-temp.
     1243               assign
     1244                 tt-temp.cli-code   = g#post-f.obj-code
     1245                 tt-temp.cli-type   = g#post-f.obj-type
     1246                 tt-temp.gds-code   = gds-list.gds-code
     1247                 tt-temp.price-rubl = v-price-rubl
     1248                 tt-temp.price-cli  = v-price-cli
     1249               .
     1250             end.
     1251           end.
     1252         end.
     1253       end.
     1254     end.
     1255   END CASE.
