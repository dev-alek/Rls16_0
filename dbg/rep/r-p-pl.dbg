     1452       (input "file"
     1453       ,input string(v-ind)
     1454       ,input v-file-name
     1455       ) .
     1456        page stream OutStream .
     1457   HIDE STREAM OutStream FRAME plan-menu.
     1458   HIDE stream OutStream FRAME BottomFrame .
     1459   HIDE stream OutStream FRAME BottomFrame2 .
     1460   output stream OutStream CLOSE .
     1461   Output stream Macr_Excel  close .
     1462   if mFrameView
     1463   then do:
     1464      HIDE FRAME InfoFrame.
     1465   end.
     1466       run paramls-write in this-procedure
     1467           (input "charcol"
     1468           ,input ""
     1469           ,input "2,3,4"
     1470           ) .
     1471     run end-proc in this-procedure .
     1472   define variable v-user-action as character no-undo .
     1473   define variable v-printed as logical   no-undo .
     1474   define variable DisabledOptions as integer   no-undo .
     1475     if kol-post >= 9 then do:
     1476        DisabledOptions = 1 .
     1477     end.
     1478     else do:
     1479       if kol-post >= 6
     1480         then DisabledOptions = 8 .
     1481         else  DisabledOptions = 0 .
     1482     end.
     1483   run gbl/prnfilen.w
     1484     (input  ""
     1485     ,input  DisabledOptions
     1486     ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     1487     ,input 7
     1488     ,output v-user-action
     1489     ,output v-printed
     1490     ) .
     1491   if radpost = 1 then do:
     1492     for each g#post-f:
     1493       delete g#post-f.
     1494     end.
     1495   end.
     1496   procedure print-line :
     1497     do on error undo, return error return-value :
     1498     define variable v-all-null as logical   no-undo .
     1499     v-all-null = true  .
     1500     if p-null = false then do:
     1501         for each g#post-f :
     1502               find first tt-temp where
     1503                     tt-temp.cli-code = g#post-f.obj-code and
     1504                     tt-temp.cli-type = g#post-f.obj-type and
     1505                     tt-temp.gds-code = gds-list.gds-code no-error .
     1506               if available tt-temp then do:
     1507                     if tt-temp.price-rubl <> 0 then  v-all-null = false .
     1508               end.
     1509         end.
     1510         if v-all-null = true then return .
     1511     end.
     1512     assign
     1513        Lines_Counter = Lines_Counter + 1
     1514       .
     1515     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     1516        page stream OutStream.
     1517        PUT STREAM OutStream UNFORMATTED
     1518            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     1519        run print-1 in this-procedure.
     1520        end.
     1521     if line-counter( OutStream ) < Tmp_Counter then
     1522       assign
     1523       .
     1524     assign
     1525       Tmp_Counter  = line-counter( OutStream )
     1526       num-ln = num-ln + 1
     1527     .
     1528     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     1529   PUT STREAM OutStream UNFORMATTED
     1530       sym1                format "X(1)" space(0)
     1531       string(gds-list.gds-code)    format "X(10)" space(0)
     1532       sym2                format "X(1)" space(0)
     1533       string(gds-list.gds-name)    format "X(30)" space(0)
     1534       sym3                format "X(1)" space(0)
     1535       string(gds-list.unit-base)    format "X(3)" space(0)
     1536   .
     1537       num#col# = 1.
     1538       num#str# = num#str# + 1.
     1539       run macr_excel_char in this-procedure(gds-list.gds-code  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1540       run macr_excel_char in this-procedure(gds-list.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1541       run macr_excel_char in this-procedure(gds-list.unit-base  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1542    for each g#post-f :
     1543         find first tt-temp where
     1544               tt-temp.cli-code = g#post-f.obj-code and
     1545               tt-temp.cli-type = g#post-f.obj-type and
     1546               tt-temp.gds-code = gds-list.gds-code no-error .
     1547         if available tt-temp then do:
     1548           PUT STREAM OutStream UNFORMATTED
     1549               sym1                          format "X(1)" space(0)
     1550               string(tt-temp.price-rubl,">>>>>>>>>>>>9.99")    format "X(16)" space(0)
     1551           .
     1552             run macr_excel_dec in this-procedure(tt-temp.price-rubl  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1553         end.
     1554         else do:
     1555             PUT STREAM OutStream UNFORMATTED
     1556                 sym1                format "X(1)" space(0)
     1557                 " "                 format "X(16)" space(0)
     1558             .
     1559             run macr_excel_dec in this-procedure(0 , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1560         end.
     1561    end.
     1562     PUT STREAM OutStream UNFORMATTED
     1563         sym2                format "X(1)" space(0)
     1564         skip
     1565     .
     1566     end.
     1567   end procedure.
     1568   procedure print-all-itog :
     1569   end procedure.
     1570   procedure PrintTitul :
     1571     do  on error undo, return error return-value  :
     1572     define variable cc as integer no-undo .
     1573     define variable tt as integer no-undo .
     1574     define variable pp as integer no-undo .
     1575   PUT STREAM OutStream UNFORMATTED
     1576   space(1)
     1577      ReportNAme skip
     1578      "по фирме "  ub.clients.obj-name skip
     1579      "Дата составления " + cur-time-date()  skip
     1580         .
     1581     define variable i as integer no-undo .
     1582     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     1583       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     1584     End.
     1585       num#str# = 1.
     1586       num#col# = 1.
     1587       run macr_excel_char in this-procedure( Reportname , num#str# , num#col#   ) .
     1588       num#str# = num#str# + 1.
     1589       run macr_excel_char in this-procedure( "по фирме " + CAPS( ub.clients.obj-name)   , num#str# , num#col#   ) .
     1590       num#str# = num#str# + 1.
     1591       run macr_excel_char in this-procedure( ReportHeader , num#str# , num#col#   ) .
     1592       num#str# = num#str# + 1.
     1593       run macr_excel_char in this-procedure("Дата составления " + cur-time-date()   , num#str# , num#col#   ) .
     1594       num#str# = num#str# + 1.
     1595       run macr_excel_char in this-procedure("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1596       num#col# = 2.
     1597       run macr_excel_char in this-procedure("Наименование"  , num#str# , num#col#   ) .  run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     1598       num#col# = 3.
     1599       run macr_excel_char in this-procedure("Ед.Изм"  , num#str# , num#col#   ) . run macr_cell_size ( 3 , ? , num#str# , num#col# , ?, ? ) .
     1600       for each g#post-f :
     1601         num#col# = num#col# + 1.
     1602         run macr_excel_char in this-procedure( "(" + string(g#post-f.obj-code) + " " + g#post-f.obj-type + ") " + g#post-f.obj-name , num#str# , num#col#   ) .
     1603         run macr_cell_size in this-procedure ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1604       end.
     1605     run print-1 in this-procedure .
     1606       run macr_cell_format in this-procedure
     1607       ( 10    ,
     1608         true  ,
     1609         false  ,
     1610         ?    ,
     1611         1 ,
     1612         1 ,
     1613         num#str# ,
     1614         num#col# ) .
     1615        put  stream macr_excel unformatted
     1616          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     1617          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1618          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1619          .
     1620       put  stream macr_excel unformatted
     1621          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     1622          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     1623     end.
     1624   end procedure.
     1625   procedure PrintPodval :
     1626     do on error undo, return error return-value  :
     1627     define variable pp as integer no-undo .
     1628     define variable rr as integer no-undo .
     1629     end.
     1630   end procedure.
     1631   PROCEDURE on-same-page :
     1632     define input parameter p-line-number as integer  no-undo .
     1633     if p-line-number > page-size( OutStream ) then return .
     1634     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then  page stream OutStream .
     1635   end procedure.
     1636   procedure print-1 :
     1637     do
     1638     on error undo, return error return-value
     1639     :
     1640       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     1641       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     1642       PUT STREAM OutStream UNFORMATTED  fill("-",4)  format "X(4)" .
     1643       for each g#post-f :
     1644         PUT STREAM OutStream UNFORMATTED fill("-",17) format "X(17)" .
     1645       end.
     1646       PUT STREAM OutStream UNFORMATTED  skip .
     1647       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     1648       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     1649       PUT STREAM OutStream UNFORMATTED  ":Е.И"  format "X(4)" .
     1650       for each g#post-f :
     1651         PUT STREAM OutStream UNFORMATTED  ":" + string(g#post-f.obj-code) + " " + g#post-f.obj-type + " " + g#post-f.obj-name  format "X(17)" .
     1652       end.
     1653       PUT STREAM OutStream UNFORMATTED  skip .
     1654       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     1655       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     1656       PUT STREAM OutStream UNFORMATTED  fill("-",4)  format "X(4)" .
     1657       for each g#post-f :
     1658         PUT STREAM OutStream UNFORMATTED fill("-",17) format "X(17)" .
     1659       end.
     1660       PUT STREAM OutStream UNFORMATTED  skip .
     1661     end.
     1662   end procedure.
     1663   def var vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1664   procedure macr_excel_char :
     1665    do
     1666    on error undo, return error return-value
     1667    :
     1668    define input parameter  p-val as character no-undo .
     1669    define input parameter  p-row as integer no-undo .
     1670    define input parameter  p-col as integer no-undo .
     1671    if p-val = ? then p-val = "" .
     1672       put stream macr_excel unformatted
     1673             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1674    end.
     1675   end procedure.
     1676   procedure macr_excel_char_with_format :
     1677    do
     1678    on error undo, return error return-value
     1679    :
     1680    define input parameter  p-val as character no-undo .
     1681    define input parameter  p-row as integer no-undo .
     1682    define input parameter  p-col as integer no-undo .
     1683    if p-val = ? then p-val = "" .
     1684       put stream macr_excel unformatted
     1685             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1686       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1687       put stream macr_excel unformatted
     1688             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1689    end.
     1690   end procedure.
     1691   procedure macr_excel_cell_format :
     1692    do
     1693    on error undo, return error return-value
     1694    :
     1695    define input parameter  p-val    as character no-undo .
     1696    define input parameter  p-row    as integer   no-undo .
     1697    define input parameter  p-col    as integer   no-undo .
     1698    define input parameter  p-format as character no-undo .
     1699    if p-val = ? then p-val = "" .
     1700       put stream macr_excel unformatted
     1701             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1702       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1703       put stream macr_excel unformatted
     1704             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1705    end.
     1706   end procedure.
     1707   procedure macr_excel_sum :
     1708    do
     1709    on error undo, return error return-value
     1710    :
     1711    define input parameter  p-row as integer no-undo .
     1712    define input parameter  p-col as integer no-undo .
     1713    define input parameter  p-row1 as integer no-undo .
     1714    define input parameter  p-col1 as integer no-undo .
     1715    define input parameter  p-row2 as integer no-undo .
     1716    define input parameter  p-col2 as integer no-undo .
     1717       put stream macr_excel unformatted
     1718             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1719    end.
     1720   end procedure.
     1721   procedure macr_excel_dec :
     1722    do
     1723    on error undo, return error return-value
     1724    :
     1725    define input parameter  p-val as character no-undo .
     1726    define input parameter  p-row as integer   no-undo .
     1727    define input parameter  p-col as integer   no-undo .
     1728     if p-val = ? then p-val =  "" .
     1729      put  stream macr_excel unformatted
     1730           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1731    end.
     1732   end procedure.
     1733   procedure macr_cell_format :
     1734    do
     1735    on error undo, return error return-value
     1736    :
     1737    define input parameter  p-size   as integer   no-undo .
     1738    define input parameter  p-bold   as logical   no-undo .
     1739    define input parameter  p-italic as logical   no-undo .
     1740    define input parameter  p-color  as integer   no-undo .
     1741    define input parameter  p-row    as integer   no-undo .
     1742    define input parameter  p-col    as integer   no-undo .
     1743    define input parameter  p-row-2  as integer   no-undo .
     1744    define input parameter  p-col-2  as integer   no-undo .
     1745     if p-size = ? then p-size = 10 .
     1746     if p-bold = ? then p-bold = false .
     1747     if p-italic = ? then p-italic = false .
     1748     if p-row-2 = ? then p-row-2 = p-row .
     1749     if p-col-2 = ? then p-col-2 = p-col .
     1750     put  stream macr_excel unformatted
     1751      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1752     if p-color <> ? then do:
     1753        put  stream macr_excel unformatted
     1754          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1755     end.
     1756     put  stream macr_excel unformatted
     1757          substitute('format.font(,&1,&2,&3)' , p-size,
     1758                                           string ( p-bold  , "true/false" ) ,
     1759                                           string ( p-italic , "true/false" )
     1760                                           ) + chr(10) .
     1761    end.
     1762   end procedure.
     1763   procedure macr_cell_size :
     1764    do
     1765    on error undo, return error return-value
     1766    :
     1767    define input parameter  p-w   as integer   no-undo .
     1768    define input parameter  p-l   as integer   no-undo .
     1769    define input parameter  p-row    as integer   no-undo .
     1770    define input parameter  p-col    as integer   no-undo .
     1771    define input parameter  p-row-2  as integer   no-undo .
     1772    define input parameter  p-col-2  as integer   no-undo .
     1773     if p-row-2 = ? then p-row-2 = p-row .
     1774     if p-col-2 = ? then p-col-2 = p-col .
     1775     if p-w = ? then    p-w = 0 .
     1776     if p-l = ? then    p-l = 0 .
     1777    define variable s-w as character no-undo .
     1778    define variable s-l as character no-undo .
     1779    if p-w = 0 then s-w = "" .
     1780               else s-w = string(p-w)  .
     1781    if p-l = 0 then s-l = "" .
     1782               else s-l = string(p-l)  .
     1783   put  stream macr_excel unformatted
     1784        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1785   put  stream macr_excel unformatted
     1786        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1787   put  stream macr_excel unformatted
     1788        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1789    end.
     1790   end procedure.
     1791   procedure proc-print-header :
     1792    do
     1793    on error undo, return error return-value
     1794    :
     1795      find first sheetf .
     1796        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1797        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1798        var-1 =  num#str# .
     1799        repeat c-c = 1 to sheetf.excel-row-title :
     1800        num#str# = num#str# + 1 .
     1801        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1802        do c-i = 1 to p-var :
     1803           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1804           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1805           num#col# = c-i .
     1806           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1807           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1808        end.
     1809       c-i = 0.
     1810       end.
     1811       run macr_cell_format (
     1812           10       ,
     1813           true     ,
     1814           false    ,
     1815           35       ,
     1816           var-1 + 1,
     1817           1        ,
     1818           num#str# ,
     1819           num#col# )
     1820           .
     1821     put  stream macr_excel unformatted
     1822          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1823          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1824          .
     1825    end.
     1826   end procedure.
     1827   procedure end-proc :
     1828    do
     1829    on error undo, return error return-value
     1830    :
     1831     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1832     OUTPUT to VALUE (v-file-name) .
     1833     for each temp-param :
     1834       export  temp-param  .
     1835     end.
     1836    end.
     1837   end procedure.
