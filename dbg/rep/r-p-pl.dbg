      801   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      802   function breakstr returns character ( input        for-name    as character,
      803                                         input        line-length as integer,
      804                                         input-output line1       as character,
      805                                         input-output line2       as character ) :
      806     define variable ii as integer no-undo.
      807     if length( for-name ) > line-length then do:
      808       assign ii    = 1
      809              line1 = "":u
      810              line2 = "":u.
      811       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
      812         assign line1 =       substring( for-name, 1, line-length     )
      813                line2 = trim( substring( for-name,    line-length + 1 ) ).
      814       end.                                                     else do:
      815         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
      816           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
      817                  ii    = ii    + 1.
      818           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      819             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      820           end.
      821         end.
      822         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      823       end.
      824     end.                                else do:
      825       assign line1 = for-name
      826              line2 = "":u.
      827     end.
      828     return ( line1 ).
      829   end function.
      830       def var t-addres        like ub.firm.addres1   no-undo.
      831       def var t-phone         like ub.firm.phone     no-undo.
