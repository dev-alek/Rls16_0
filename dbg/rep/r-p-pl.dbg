      835   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      836   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      837   procedure paramls-clear :
      838     define buffer buf_temp-param for temp-param .
      839     do
      840     on error undo, return error return-value
      841     :
      842       for each buf_temp-param
      843       on error undo, return error
      844       :
      845         delete buf_temp-param .
      846       end.
      847     end.
      848   end procedure.
      849   procedure paramls-write :
      850     define input  parameter p-code     as character no-undo .
      851     define input  parameter p-sub-code as character no-undo .
      852     define input  parameter p-value    as character no-undo .
      853     define buffer buf_temp-param for temp-param .
      854     do
      855     on error undo, return error return-value
      856     :
      857       find first buf_temp-param
      858         where buf_temp-param.param-code     = p-code
      859           and buf_temp-param.param-sub-code = p-sub-code
      860         no-error .
      861       if not available buf_temp-param then do:
      862         create buf_temp-param .
      863         assign
      864           buf_temp-param.param-code     = p-code
      865           buf_temp-param.param-sub-code = p-sub-code
      866         .
      867       end.
      868       assign
      869         buf_temp-param.param-value = p-value
      870       .
      871     end.
      872   end procedure.
      873   procedure paramls-read :
      874     define input  parameter p-code          as character no-undo .
      875     define input  parameter p-sub-code      as character no-undo .
      876     define input  parameter p-default-value as character no-undo .
      877     define output parameter p-value         as character no-undo .
      878     define buffer buf_temp-param for temp-param .
      879     do
      880     on error undo, return error return-value
      881     :
      882       find first buf_temp-param
      883         where buf_temp-param.param-code     = p-code
      884           and buf_temp-param.param-sub-code = p-sub-code
      885         no-error .
      886       if available buf_temp-param then do:
      887         assign
      888           p-value = buf_temp-param.param-value
      889         .
      890       end.
      891       else do:
      892         assign
      893           p-value = p-default-value
      894         .
      895       end.
      896     end.
      897   end procedure.
      898   procedure paramls-append :
      899     define input  parameter p-code     as character no-undo .
      900     define input  parameter p-sub-code as character no-undo .
      901     define input  parameter p-value    as character no-undo .
      902     define buffer buf_temp-param for temp-param .
      903     do
      904     on error undo, return error return-value
      905     :
      906       find first buf_temp-param
      907            where buf_temp-param.param-code     = p-code
      908              and buf_temp-param.param-sub-code = p-sub-code
      909         no-error .
      910       if not available buf_temp-param then do:
      911         create buf_temp-param .
      912         assign
      913           buf_temp-param.param-code     = p-code
      914           buf_temp-param.param-sub-code = p-sub-code
      915           buf_temp-param.param-value    = p-value
      916         .
      917       end.
      918       else do:
      919           assign
      920               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      921           .
      922       end.
      923     end.
      924   end procedure.
      925   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      926     if num-entries(string(p-dec), '.') = 2
      927       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      928       else return( string(p-dec)) .
      929   end function.
      930   function format-point-to-comma returns char (input orig as char ) .
      931   define variable rtext as character no-undo .
      932   define variable strt as integer no-undo .
      933   define variable leng as integer no-undo .
      934   assign rtext = orig .
      935   repeat:
      936     strt =  index(rtext,'.').
      937     if strt = 0 then leave.
      938     leng = 1.
      939     substring(rtext,strt,leng,"character") = v-delim .
      940   end.
      941   return rtext.
      942   end function.
      943   function format-excel-text returns char ( input start-text as char ) :
      944   def var  i    as int no-undo.
      945   def var  ch   as char no-undo.
      946   def var  n    as int no-undo.
      947   def var  ipos as int no-undo.
      948     n = num-entries(trim(start-text), chr(10)) - 1 .
      949     do i = 1 to n :
      950       ipos = index( start-text, chr(10)).
      951       if ipos > 0 then
      952         substr( start-text, ipos, 1 ) = ' '.
      953     end.
      954     n = num-entries(trim(start-text), chr(13)) - 1 .
      955     do i = 1 to n :
      956       ipos = index( start-text, chr(13)).
      957       if ipos > 0 then
      958         substr( start-text, ipos, 1 ) = ' '.
      959     end.
      960     if index( start-text, '"' ) = 0 then
      961       start-text =  '="'   + trim( start-text) + '"'   .
      962       else do:
      963         n = num-entries(trim(start-text), '"') - 1.
      964         do i = 1 to n :
      965           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      966         end.
      967         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      968         start-text = '="'  + ch  + '"' .
      969       end.
      970     return start-text.
      971   end.
      972   function excel-sum returns char (input p-dec as decimal ).
      973     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      974   end function.
      975   function excel-qnty returns char (input p-dec as decimal ).
      976     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      977   end function.
      978   function format-excel-text-macr returns char ( input start-text as char ) :
      979   def var  i    as int no-undo.
      980   def var  ch   as char no-undo.
      981   def var  n    as int no-undo.
      982   def var  ipos as int no-undo.
      983     n = num-entries(trim(start-text), chr(10)) - 1 .
      984     do i = 1 to n :
      985       ipos = index( start-text, chr(10)).
      986       if ipos > 0 then
      987         substring( start-text, ipos , 1 ) = ' '.
      988     end.
      989     n = num-entries(trim(start-text), chr(13)) - 1 .
      990     do i = 1 to n :
      991       ipos = index( start-text, chr(13)).
      992       if ipos > 0 then
      993         substring( start-text, ipos, 1 ) = ' '.
      994     end.
      995     if index( start-text, '"' ) = 0 then
      996       start-text =  '"'   + trim( start-text) + '"'   .
      997       else do:
      998         n = num-entries(trim(start-text), '"') - 1.
      999         do i = 1 to n :
     1000           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1001         end.
     1002         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1003         start-text = '"'  + ch  + '"' .
     1004       end.
     1005     n = num-entries(trim(start-text), chr(10)) - 1 .
     1006     do i = 1 to n :
     1007       ipos = index( start-text, chr(10)).
     1008       if ipos > 0 then
     1009         substring( start-text, ipos , 1 ) = ' '.
     1010     end.
     1011       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1012     return start-text.
     1013   end.
