     1025   define variable v-inform-launched as logical no-undo initial false .
     1026   procedure proc-alt-shift-f4:
     1027     define variable v-action as character no-undo .
     1028     if v-inform-launched = false then do:
     1029       assign
     1030         v-inform-launched = true
     1031       .
     1032       run gbl/d-inform.w
     1033         (  input self
     1034         ,  input this-procedure
     1035         , output v-action
     1036         ) no-error .
     1037       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
     1038       assign
     1039         v-inform-launched = false
     1040       .
     1041     end.
     1042   end.
