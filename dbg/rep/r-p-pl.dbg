     1060   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1061     define variable v-cntxt-db-num        as integer   no-undo .
     1062     define variable v-cntxt-userid        as character no-undo .
