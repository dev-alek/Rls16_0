     2118             v-cntxp-chk-pay         = bf-cntxp_shop.chk-pay
     2119             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     2120             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2121             .
     2122         end.
     2123       end case.
     2124     end.
