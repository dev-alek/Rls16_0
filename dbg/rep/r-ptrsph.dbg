     3696         (
     3697             input  ""
     3698            ,input  0
     3699            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3700            ,input  7
     3701            ,output v-user-action
     3702            ,output v-printed
     3703         ) .
     3704     end.
     3705   end.
     3706   procedure get-fo-range :
     3707     define  input parameter p-obj-type   as character no-undo .
     3708     define  input parameter p-obj-code   as integer   no-undo .
     3709     define  input parameter p-date-from  as date      no-undo .
     3710     define  input parameter p-date-till  as date      no-undo .
     3711     define  input parameter p-shift-from as integer   no-undo .
     3712     define  input parameter p-shift-till as integer   no-undo .
     3713     define  input parameter p-is-shift   as logical   no-undo .
     3714     define output parameter p-fo-from    as decimal   no-undo initial 0.00 .
     3715     define output parameter p-fo-till    as decimal   no-undo initial 0.00 .
     3716     define variable v-shift-end-fact-order as decimal no-undo .
     3717     define variable v-day-end-fact-order   as decimal no-undo .
     3718     define variable v-fact-order           as decimal no-undo .
     3719     do
     3720     on error undo, return error return-value
     3721     :
     3722       if p-is-shift = yes
     3723       then do:
     3724         run factord in this-procedure
     3725           (
     3726              input p-date-from
     3727           ,  input 1
     3728           ,  input 1
     3729           ,  input p-date-from
     3730           ,  input p-shift-from
     3731           ,  input p-is-shift
     3732           , output p-fo-from
     3733           , output v-shift-end-fact-order
     3734           , output v-day-end-fact-order
     3735           ) no-error .
     3736         if error-status :error
     3737         then do:
     3738           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     3739                   "Ошибка при вызове процедуры factord" skip( 0 )
     3740                   error-status :get-message( 1 ) skip( 0 )
     3741                   return-value skip( 1 )
     3742           view-as alert-box error .
     3743           undo, return error return-value .
     3744         end.
     3745         run factord in this-procedure
     3746           (
     3747              input p-date-till
     3748           ,  input 1
     3749           ,  input 1
     3750           ,  input p-date-till
     3751           ,  input p-shift-till
     3752           ,  input p-is-shift
     3753           , output v-fact-order
     3754           , output p-fo-till
     3755           , output v-day-end-fact-order
     3756           ) no-error .
     3757         if error-status :error
     3758         then do:
     3759           message vss-workfile skip( 0 ) vss-date skip( 0 ) vss-revision skip( 1 ) vss-description skip( 1 )
     3760                   "Ошибка при вызове процедуры factord" skip( 0 )
     3761                   error-status :get-message( 1 ) skip( 0 )
     3762                   return-value skip( 1 )
     3763           view-as alert-box error .
     3764           undo, return error return-value .
     3765         end.
     3766       end.
     3767       else do:
     3768         run day-begin-fact-order in this-procedure
     3769           (
     3770              input p-date-from
     3771           , output p-fo-from
     3772           ) no-error .
     3773         if error-status :error or
     3774            p-fo-from = ?
     3775         then do:
     3776           assign
     3777             p-fo-from = 0.00
     3778           .
     3779         end.
     3780         run factord-end-day in this-procedure
     3781           (
     3782              input p-date-till
     3783           , output p-fo-till
     3784           ) no-error .
     3785         if error-status :error or
     3786            p-fo-till = ?
     3787         then do:
     3788           assign
     3789             p-fo-till = truncate( p-fo-from, 0 ) + 0.99
     3790           .
     3791         end.
     3792       end.
     3793       if p-fo-till < p-fo-from
     3794       then do:
     3795         assign
     3796           p-fo-till = p-fo-from
     3797         .
     3798       end.
     3799     end.
     3800   end procedure.
     3801   procedure get-hour-range :
     3802     define  input parameter p-time as integer no-undo .
     3803     define output parameter p-from as integer no-undo .
     3804     define output parameter p-till as integer no-undo .
     3805     define variable j-hour as integer no-undo .
     3806     do
     3807     on error undo, return error return-value
     3808     :
     3809       assign
     3810         j-hour = integer( substring( string( p-time, "hh:mm:ss":U ), 1, 2 ) )
     3811         p-from = j-hour * 3600
     3812         p-till = p-from + 3599
     3813       .
     3814     end.
     3815   end procedure.
     3816   procedure get-label-lines :
     3817     define output parameter p-label-line-1 as character no-undo initial "":U .
     3818     define output parameter p-label-line-2 as character no-undo initial "":U .
     3819     define output parameter p-label-line-3 as character no-undo initial "":U .
     3820     define output parameter p-label-line-4 as character no-undo initial "":U .
     3821     define output parameter p-label-line-5 as character no-undo initial "":U .
     3822     define output parameter p-text-length  as integer   no-undo initial 0    .
     3823     define output parameter p-columns-no   as integer   no-undo initial 0    .
     3824     define output parameter p-total-length as integer   no-undo initial 0    .
     3825     define variable v_list-length as character no-undo initial "":U .
     3826     define variable v_list-label  as character no-undo initial "":U .
     3827     define variable v_list-types  as character no-undo initial "":U .
     3828     define variable jj            as integer   no-undo initial 0    .
     3829     define variable j_length      as integer   no-undo initial 0    .
     3830     define variable v_length      as character no-undo initial "":U .
     3831     define variable v_label       as character no-undo initial "":U .
     3832     define variable v_data-type   as character no-undo initial "":U .
     3833     do
     3834     on error undo, return error return-value
     3835     :
     3836       assign
     3837         p-label-line-1 = "-":U
     3838         p-label-line-2 = ":":U
     3839         p-label-line-3 = ":":U
     3840         p-label-line-4 = ":":U
     3841         p-label-line-5 = ":":U
     3842         p-text-length  = 0
     3843         p-columns-no   = 0
     3844       .
     3845       run get-lbl-data in this-procedure
     3846         (
     3847           output v_list-label
     3848         , output v_list-length
     3849         , output v_list-types
     3850         ) .
     3851       find first SheetF where
     3852                  SheetF.Sheet-Num = XLS-page-num .
     3853       do jj = 1 to num-entries( v_list-label )
     3854       :
     3855         if use-column[ jj ] <> yes
     3856         then do:
     3857           next .
     3858         end.
     3859         assign
     3860           v_label     = trim( entry( jj, v_list-label  ) )
     3861           v_length    = trim( entry( jj, v_list-length ) )
     3862           v_data-type = trim( entry( jj, v_list-types  ) )
     3863         .
     3864         assign
     3865           j_length = integer( v_length )
     3866         no-error .
     3867         assign
     3868           p-text-length  = p-text-length  + j_length
     3869           p-columns-no   = p-columns-no   + 1
     3870           p-label-line-1 = p-label-line-1 + fill( "-", j_length ) + "-"
     3871           p-label-line-2 = p-label-line-2 + substring( Centering( v_label, j_length ) + fill( " ":U, j_length )
     3872                                                      , 1
     3873                                                      , j_length
     3874                                                      ) + ":"
     3875           p-label-line-3 = p-label-line-3 + fill( "-", j_length ) + ":"
     3876           p-label-line-4 = p-label-line-4 + substring( Centering( string( p-columns-no ), j_length ) +
     3877                                                        fill( " ":U, j_length )
     3878                                                      , 1
     3879                                                      , j_length
     3880                                                      ) + ":"
     3881           p-label-line-5 = p-label-line-5 + fill( "-", j_length ) + ":"
     3882         .
     3883         assign
     3884           SheetF.Excel-Column-Lable = SheetF.Excel-Column-Lable
     3885                                     + ( if SheetF.Excel-Column-Lable = "":U then "":U else chr(44) )
     3886                                     + v_label
     3887           SheetF.Sizes              = SheetF.Sizes
     3888                                     + ( if SheetF.Sizes = "":U then "":U else chr(44) )
     3889                                     + v_length
     3890         .
     3891         case v_data-type :
     3892           when "D":U
     3893           then do:
     3894             assign
     3895               SheetF.ColFormat = SheetF.ColFormat
     3896                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3897                                + string( p-columns-no ) + "=":U + "@":U
     3898             .
     3899             assign
     3900               v-column-list = v-column-list
     3901                             + ( if v-column-list = "":U then "":U else ";" )
     3902                             + "@":U
     3903             .
     3904           end.
     3905           when "T":U
     3906           then do:
     3907             assign
     3908               SheetF.ColFormat = SheetF.ColFormat
     3909                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3910                                + string( p-columns-no ) + "=":U + "@":U
     3911             .
     3912             assign
     3913               v-column-list = v-column-list
     3914                             + ( if v-column-list = "":U then "":U else ";" )
     3915                             + "@":U
     3916             .
     3917           end.
     3918           when "Z":U
     3919           then do:
     3920             assign
     3921               SheetF.ColFormat = SheetF.ColFormat
     3922                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3923                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U
     3924             .
     3925             assign
     3926               v-column-list = v-column-list
     3927                             + ( if v-column-list = "":U then "":U else ";" )
     3928                             + "#":U + v-del-1 + "##":U + "0":U
     3929             .
     3930           end.
     3931           when "C":U
     3932           then do:
     3933             assign
     3934               SheetF.ColFormat = SheetF.ColFormat
     3935                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3936                                + string( p-columns-no ) + "=":U + "@":U
     3937             .
     3938             assign
     3939               v-column-list = v-column-list
     3940                             + ( if v-column-list = "":U then "":U else ";" )
     3941                             + "@":U
     3942             .
     3943           end.
     3944           when "I":U
     3945           then do:
     3946             assign
     3947               SheetF.ColFormat = SheetF.ColFormat
     3948                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3949                                + string( p-columns-no ) + "=":U + "0":U
     3950             .
     3951             assign
     3952               v-column-list = v-column-list
     3953                             + ( if v-column-list = "":U then "":U else ";" )
     3954                             + "0":U
     3955             .
     3956           end.
     3957           when "Q":U
     3958           then do:
     3959             assign
     3960               SheetF.ColFormat = SheetF.ColFormat
     3961                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3962                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U + v-delim + "000":U
     3963             .
     3964             assign
     3965               v-column-list = v-column-list
     3966                             + ( if v-column-list = "":U then "":U else ";" )
     3967                             + "#":U + v-del-1 + "##":U + "0":U + v-delim + "000":U
     3968             .
     3969           end.
     3970           when "S":U
     3971           then do:
     3972             assign
     3973               SheetF.ColFormat = SheetF.ColFormat
     3974                                + ( if SheetF.ColFormat = "":U then "":U else ";":U )
     3975                                + string( p-columns-no ) + "=":U + "#":U + v-del-1 + "##":U + "0":U + v-delim + "00":U
     3976             .
     3977             assign
     3978               v-column-list = v-column-list
     3979                             + ( if v-column-list = "":U then "":U else ";" )
     3980                             + "#":U + v-del-1 + "##":U + "0":U + v-delim + "00":U
     3981             .
     3982           end.
     3983         end case.
     3984       end.
     3985       assign
     3986         SheetF.ColFormat = SheetF.ColFormat
     3987                          + chr(4)
     3988                          + chr(4)
     3989                          + trim( string( XLS-page-num, ">>>>>>>>>9":U ) ) + "-й Лист"
     3990       .
     3991       assign
     3992         p-total-length = p-text-length + p-columns-no + 1
     3993       .
     3994     end.
     3995   end procedure.
     3996   procedure get-print-line :
     3997     define  input parameter p-temp-rec-id as recid     no-undo .
     3998     define output parameter p-print-line  as character no-undo initial "":U .
     3999     define output parameter p-excel-line  as character no-undo initial "":U .
     4000     define variable v_list-label  as character no-undo initial "":U .
     4001     define variable v_list-types  as character no-undo initial "":U .
     4002     define variable v_list-length as character no-undo initial "":U .
     4003     define variable v_data-type   as character no-undo initial "":U .
     4004     define variable v_length      as character no-undo initial "":U .
     4005     define variable j_length      as integer   no-undo initial 0    .
     4006     define variable jj            as integer   no-undo initial 0    .
     4007     define variable j_time-top    as integer   no-undo .
     4008     define variable j_time-bottom as integer   no-undo .
     4009     define buffer bf_print-line for tt_line .
     4010     do
     4011     on error undo, return error return-value
     4012     :
     4013       find first bf_print-line no-lock where
     4014           recid( bf_print-line ) = p-temp-rec-id .
     4015       run get-lbl-data in this-procedure
     4016         (
     4017           output v_list-label
     4018         , output v_list-length
     4019         , output v_list-types
     4020         ) .
     4021       assign
     4022         p-print-line = ":":U
     4023         p-excel-line = "":U
     4024       .
     4025       do jj = 1 to num-entries( v_list-length )
     4026       :
     4027         if use-column[ jj ] <> yes
     4028         then do:
     4029           next .
     4030         end.
     4031         assign
     4032           v_length    = trim( entry( jj, v_list-length ) )
     4033           v_data-type = trim( entry( jj, v_list-types  ) )
     4034         .
     4035         assign
     4036           j_length = integer( v_length )
     4037         no-error .
     4038         case v_data-type :
     4039           when "D":U
     4040           then do:
     4041             assign
     4042               p-print-line = p-print-line + string( bf_print-line.chk-date, "99/99/9999":U ) + ":":U
     4043               p-excel-line = p-excel-line + string( bf_print-line.chk-date, "99/99/9999":U ) + CHR(9)
     4044             .
     4045           end.
     4046           when "T":U
     4047           then do:
     4048             assign
     4049               p-print-line = p-print-line + string( bf_print-line.chk-time, "hh:mm:ss":U ) + ":":U
     4050               p-excel-line = p-excel-line + string( bf_print-line.chk-time, "hh:mm:ss":U ) + CHR(9)
     4051             .
     4052           end.
     4053           when "Z":U
     4054           then do:
     4055             case j_length :
     4056               when 10
     4057               then do:
     4058                 assign
     4059                   p-print-line = p-print-line + " ":U + string( bf_print-line.gds-code, "999999999":U ) + ":":U
     4060                   p-excel-line = p-excel-line         + string( bf_print-line.gds-code, "999999999":U ) + CHR(9)
     4061                 .
     4062               end.
     4063             end case.
     4064           end.
     4065           when "C":U
     4066           then do:
     4067             case j_length :
     4068               when 10
     4069               then do:
     4070                 assign
     4071                   p-print-line = p-print-line + string( bf_print-line.artic, "x(10)":U ) + ":":U
     4072                   p-excel-line = p-excel-line + string( bf_print-line.artic, "x(10)":U ) + CHR(9)
     4073                 .
     4074               end.
     4075               when 15
     4076               then
     4077                 do:
     4078                   case jj :
     4079                     when 12
     4080                     then
     4081                       do:
     4082                         assign
     4083                           p-print-line = p-print-line + string( bf_print-line.chk-num, "x(15)":U ) + ":":U
     4084                           p-excel-line = p-excel-line + string( bf_print-line.chk-num, "x(15)":U ) + CHR(9)
     4085                           .
     4086                       end.
     4087                     when 13
     4088                     then
     4089                       do:
     4090                         assign
     4091                           p-print-line = p-print-line + string( bf_print-line.pass-gds, "x(15)":U ) + ":":U
     4092                           p-excel-line = p-excel-line + string( bf_print-line.pass-gds, "x(15)":U ) + CHR(9)
     4093                           .
     4094                       end.
     4095                     when 14
     4096                     then
     4097                       do:
     4098                         assign
     4099                           p-print-line = p-print-line + "  ":U + string( bf_print-line.doc-num2, "x(12)":U ) + " ":U + ":":U
     4100                           p-excel-line = p-excel-line          + string( bf_print-line.doc-num2, "x(12)":U ) + CHR(9)
     4101                           .
     4102                       end.
     4103                   end case.
     4104                 end.
     4105               when 17
     4106               then do:
     4107                 case jj :
     4108                   when 2
     4109                   then do:
     4110                     run get-hour-range in this-procedure
     4111                       (
     4112                          input bf_print-line.chk-time
     4113                       , output j_time-top
     4114                       , output j_time-bottom
     4115                       ) .
     4116                     assign
     4117                       p-print-line = p-print-line + string( j_time-top,    "hh:mm:ss":U ) + "-":U
     4118                                                   + string( j_time-bottom, "hh:mm:ss":U ) + ":":U
     4119                       p-excel-line = p-excel-line + string( j_time-top,    "hh:mm:ss":U ) + "-":U
     4120                                                   + string( j_time-bottom, "hh:mm:ss":U ) + CHR(9)
     4121                     .
     4122                   end.
     4123                 end case.
     4124               end.
     4125               when 24
     4126               then do:
     4127                 case jj :
     4128                   when 5
     4129                   then do:
     4130                     assign
     4131                       p-print-line = p-print-line + string( bf_print-line.gds-name, "x(24)":U ) + ":":U
     4132                       p-excel-line = p-excel-line + string( bf_print-line.gds-name, "x(24)":U ) + CHR(9)
     4133                     .
     4134                   end.
     4135                   when 11
     4136                   then do:
     4137                     assign
     4138                       p-print-line = p-print-line + string( bf_print-line.pay-name, "x(24)":U ) + ":":U
     4139                       p-excel-line = p-excel-line + string( bf_print-line.pay-name, "x(24)":U ) + CHR(9)
     4140                     .
     4141                   end.
     4142                 end case.
     4143               end.
     4144             end case.
     4145           end.
     4146           when "I":U
     4147           then do:
     4148             case jj :
     4149               when 6
     4150               then do:
     4151                 assign
     4152                   p-print-line = p-print-line + "  ":U + string( bf_print-line.pump-code, ">9":U ) + " ":U + ":":U
     4153                   p-excel-line = p-excel-line          + string( bf_print-line.pump-code, ">9":U ) + CHR(9)
     4154                 .
     4155               end.
     4156               when 7
     4157               then do:
     4158                 assign
     4159                   p-print-line = p-print-line + "   ":U + string( bf_print-line.nozzle-code, ">9":U ) + "   ":U + ":":U
     4160                   p-excel-line = p-excel-line           + string( bf_print-line.nozzle-code, ">9":U ) + CHR(9)
     4161                 .
     4162               end.
     4163               when 8
     4164               then do:
     4165                 assign
     4166                   p-print-line = p-print-line + string( bf_print-line.chk-count, ">>>>9":U ) + ":":U
     4167                   p-excel-line = p-excel-line + string( bf_print-line.chk-count, ">>>>9":U ) + CHR(9)
     4168                 .
     4169               end.
     4170             end case.
     4171           end.
     4172           when "Q":U
     4173           then do:
     4174             assign
     4175               p-print-line = p-print-line + string( bf_print-line.base-qnty, "->>>>,>>9.999":U ) + ":":U
     4176               p-excel-line = p-excel-line + string( bf_print-line.base-qnty, "->>>>>>>9.999":U ) + CHR(9)
     4177             .
     4178           end.
     4179           when "S":U
     4180           then do:
     4181             assign
     4182               p-print-line = p-print-line + string( bf_print-line.sum-sale, "->,>>>,>>>,>>>,>>9.99":U ) + ":":U
     4183               p-excel-line = p-excel-line + string( bf_print-line.sum-sale, "->>>>>>>>>>>>>>>>9.99":U ) + CHR(9)
     4184             .
     4185           end.
     4186         end case.
     4187       end.
     4188     end.
     4189   end procedure.
     4190   procedure get-lbl-data :
     4191     define output parameter p-list-label  as character no-undo .
     4192     define output parameter p-list-length as character no-undo .
     4193     define output parameter p-list-types  as character no-undo .
     4194     do
     4195     on error undo, return error return-value
     4196     :
     4197       assign
     4198         p-list-length = "10,8,10,10,24,5,8,5,13,21,24,15,15,15":U
     4199         p-list-label  = "Дата,Время,Код товара,Артикул,Наименование товара,№ ТРК,Пистолет,Чеков,Количество,":U +
     4200                         "Сумма продаж,Вид оплаты,Номер чека,Сухой чек,№ заказа":U
     4201         p-list-types  = "D,T,Z,C,C,I,I,I,Q,S,C,C,C,C":U
     4202       .
     4203       if num-entries( p-list-length ) <> num-entries( p-list-label ) or
     4204          num-entries( p-list-length ) <> num-entries( p-list-types )
     4205       then do:
     4206         message "Заголовки:"   p-list-label  num-entries( p-list-label  ) skip( 0 )
     4207                 "Длины полей:" p-list-length num-entries( p-list-length ) skip( 0 )
     4208                 "Типы данных:" p-list-types  num-entries( p-list-types  ) skip( 1 )
     4209         view-as alert-box .
     4210         undo, return error "Размерности массивов: заголовков, длин полей и типов данных  НЕ СОВПАДАЮТ." .
     4211       end.
     4212     end.
     4213   end procedure.
     4214   procedure get-indent :
     4215     define  input parameter p-for-column-no as integer   no-undo .
     4216     define output parameter p-indent-length as integer   no-undo initial 0 .
     4217     define output parameter p-text-indent   as character no-undo initial "":U .
     4218     define output parameter p-excel-indent  as character no-undo initial "":U .
     4219     define variable v_list-label  as character no-undo initial "":U .
     4220     define variable v_list-types  as character no-undo initial "":U .
     4221     define variable v_list-length as character no-undo initial "":U .
     4222     define variable v_length      as character no-undo initial "":U .
     4223     define variable j_length      as integer   no-undo initial 0    .
     4224     define variable jj            as integer   no-undo initial 0    .
     4225     do
     4226     on error undo, return error return-value
     4227     :
     4228       run get-lbl-data in this-procedure
     4229         (
     4230           output v_list-label
     4231         , output v_list-length
     4232         , output v_list-types
     4233         ) .
     4234       do jj = 1 to min( num-entries( v_list-length ), p-for-column-no - 1 )
     4235       :
     4236         if use-column[ jj ] <> yes
     4237         then do:
     4238           next .
     4239         end.
     4240         assign
     4241           v_length = trim( entry( jj, v_list-length ) )
     4242         .
     4243         assign
     4244           j_length = integer( v_length )
     4245         no-error .
     4246         assign
     4247           p-indent-length = p-indent-length + j_length + 1
     4248           p-excel-indent  = p-excel-indent  + CHR(9)
     4249         .
     4250       end.
     4251       assign
     4252         p-indent-length = p-indent-length + 1
     4253       .
     4254       assign
     4255         p-text-indent = fill( " ":U, p-indent-length )
     4256       .
     4257     end.
     4258   end procedure.
     4259   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4260   PROCEDURE create-b2-treal-2.
     4261   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     4262   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     4263   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     4264   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     4265   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
     4266   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     4267   DEFINE INPUT PARAMETER pout-name as character no-undo.
     4268   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     4269   DEFINE INPUT PARAMETER pii as integer no-undo.
     4270   DEFINE INPUT PARAMETER p-pay-desk as integer no-undo.
     4271   define input parameter p-prefix   as character no-undo .
     4272   define input parameter p-pump as integer no-undo .
     4273   define input parameter p-nozzle-code as integer no-undo .
     4274   _main:
     4275   DO ON ERROR UNDO _main, return error:
     4276       create b2-treal-2.
     4277       assign
     4278       b2-treal-2.gds-code = pgds-code
     4279       b2-treal-2.cpay-code = pcpay-code
     4280       b2-treal-2.curr-code = pcurr-code
     4281       b2-treal-2.qnty1  =  pqnty1
     4282       b2-treal-2.qnty2  = pqnty2
     4283       b2-treal-2.netto = pnetto
     4284       b2-treal-2.out-name = pout-name
     4285       b2-treal-2.is-pay = pis-pay
     4286       b2-treal-2.ii = pii
     4287       b2-treal-2.pay-desk = p-pay-desk
     4288       b2-treal-2.prefix   = p-prefix
     4289       b2-treal-2.pump   = p-pump
     4290       b2-treal-2.nozzle-code   = p-nozzle-code
     4291       no-error
     4292       .
     4293       if error-status:error then undo _main, return error.
     4294   END.
     4295   END PROCEDURE.
     4296   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4297   PROCEDURE create-g-b2-treal-3.
     4298   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     4299   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     4300   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     4301   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     4302   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
