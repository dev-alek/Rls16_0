     2105             v-cntxp-out-line-discnt = bf-cntxp_shop.out-line-discnt
     2106             v-cntxp-in-ov           = bf-cntxp_shop.in-ov
     2107             v-cntxp-in-perm         = bf-cntxp_shop.in-perm
     2108             v-cntxp-no-eq           = bf-cntxp_shop.no-eq
     2109             v-cntxp-rsrv-time       = bf-cntxp_shop.rsrv-time
     2110             v-cntxp-load-time       = bf-cntxp_shop.load-time
     2111             v-cntxp-holidays        = bf-cntxp_shop.holidays
     2112             v-cntxp-in-pay          = bf-cntxp_shop.in-pay
     2113             v-cntxp-out-pay         = bf-cntxp_shop.out-pay
     2114             v-cntxp-ret-pay         = bf-cntxp_shop.ret-pay
     2115             v-cntxp-ret-sup-pay     = bf-cntxp_shop.ret-sup-pay
