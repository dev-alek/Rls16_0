     1770   PROCEDURE create-treal-2.
     1771   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
     1772   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
     1773   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
     1774   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
     1775   DEFINE INPUT PARAMETER pqnty2 as decimal no-undo.
     1776   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
     1777   DEFINE INPUT PARAMETER pout-name as character no-undo.
     1778   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
     1779   DEFINE INPUT PARAMETER pii as integer no-undo.
     1780   DEFINE INPUT PARAMETER p-pay-desk as integer no-undo.
     1781   define input parameter p-prefix   as character no-undo .
     1782   define input parameter p-pump as integer no-undo .
     1783   define input parameter p-nozzle-code as integer no-undo .
     1784   _main:
     1785   DO ON ERROR UNDO _main, return error:
     1786       create treal-2.
     1787       assign
     1788       treal-2.gds-code = pgds-code
     1789       treal-2.cpay-code = pcpay-code
     1790       treal-2.curr-code = pcurr-code
     1791       treal-2.qnty1  =  pqnty1
     1792       treal-2.qnty2  = pqnty2
     1793       treal-2.netto = pnetto
     1794       treal-2.out-name = pout-name
     1795       treal-2.is-pay = pis-pay
     1796       treal-2.ii = pii
     1797       treal-2.pay-desk = p-pay-desk
     1798       treal-2.prefix   = p-prefix
     1799       treal-2.pump   = p-pump
     1800       treal-2.nozzle-code   = p-nozzle-code
     1801       no-error
     1802       .
     1803       if error-status:error then undo _main, return error.
     1804   END.
     1805   END PROCEDURE.
