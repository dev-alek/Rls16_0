     2281   FUNCTION Centering RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     2282     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2283     RUN get-centre-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     2284     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     2285   END FUNCTION.
     2286   PROCEDURE get-centre-string :
     2287     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2288     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     2289     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2290     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     2291     DEFINE VARIABLE j-left   AS INTEGER NO-UNDO.
     2292     DO ON ERROR UNDO, RETURN ERROR :
     2293       ASSIGN p-instring = TRIM(   p-instring )
     2294              j-format   = LENGTH( p-instring ).
     2295       IF           j-format > p-length THEN DO:
     2296         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     2297       END. ELSE IF j-format < p-length THEN DO:
     2298         ASSIGN j-left      = INTEGER( ( p-length - ( j-format + 1 ) ) * 0.5 )
     2299                p-outstring = FILL( " ":U, j-left ) + p-instring + FILL( " ":U, p-length - ( j-left + j-format ) ).
     2300       END.                             ELSE DO:
     2301         ASSIGN p-outstring = p-instring.
     2302       END.
     2303     END.
     2304   END PROCEDURE.
     2305   FUNCTION ShiftRight RETURNS CHARACTER ( INPUT i-string AS CHARACTER, INPUT i-length AS INTEGER ) :
     2306     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2307     RUN get-right-string IN THIS-PROCEDURE ( INPUT i-string, INPUT i-length, OUTPUT v-outstring ) NO-ERROR.
     2308     RETURN ( IF ERROR-STATUS :ERROR THEN i-string ELSE v-outstring ).
     2309   END FUNCTION.
     2310   PROCEDURE get-right-string :
     2311     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2312     DEFINE  INPUT PARAMETER p-length    AS INTEGER   NO-UNDO.
     2313     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2314     DEFINE VARIABLE j-format AS INTEGER NO-UNDO.
     2315     DO ON ERROR UNDO, RETURN ERROR :
     2316       ASSIGN p-instring = TRIM(   p-instring )
     2317              j-format   = LENGTH( p-instring ).
     2318       IF           j-format > p-length THEN DO:
     2319         ASSIGN p-outstring = SUBSTRING( p-instring, 1, p-length ).
     2320       END. ELSE IF j-format < p-length THEN DO:
     2321         ASSIGN p-outstring = FILL( " ":U, p-length - j-format ) + p-instring.
     2322       END.                             ELSE DO:
     2323         ASSIGN p-outstring = p-instring.
     2324       END.
     2325     END.
     2326   END PROCEDURE.
     2327   FUNCTION Sparse RETURNS CHARACTER ( INPUT p-instring AS CHARACTER ) :
     2328     DEFINE VARIABLE v-outstring AS CHARACTER NO-UNDO.
     2329     RUN get-sparsed-string IN THIS-PROCEDURE ( INPUT p-instring, OUTPUT v-outstring ) NO-ERROR.
     2330     RETURN ( IF ERROR-STATUS :ERROR THEN p-instring ELSE v-outstring ).
     2331   END FUNCTION.
     2332   PROCEDURE get-sparsed-string :
     2333     DEFINE  INPUT PARAMETER p-instring  AS CHARACTER NO-UNDO.
     2334     DEFINE OUTPUT PARAMETER p-outstring AS CHARACTER NO-UNDO INITIAL "":U.
     2335     DEFINE VARIABLE jj AS INTEGER NO-UNDO.
     2336     DO ON ERROR UNDO, RETURN ERROR :
     2337       DO jj = 1 TO LENGTH( p-instring ) :
     2338         ASSIGN p-outstring = p-outstring + ( IF p-outstring = "":U THEN "":U ELSE " ":U ) + SUBSTRING( p-instring, jj, 1 ).
     2339       END.
     2340       ASSIGN p-outstring = CAPS( TRIM( p-outstring ) ).
     2341     END.
     2342   END PROCEDURE.
     2343   form header
     2344     Centering( Sparse( "Почасовая статистика продаж ТРК с детализацией по пистолетам" )
     2345                             , j_total-length ) format "x(198)":U at 1 skip( 1 )
     2346     ShiftRight( substitute( "Дата печати: &1, время: &2.   Страница: &3."
     2347                           , string( t_today,                 "99.99.9999":U )
     2348                           , string( j_time,                  "HH:MM:SS":U   )
     2349                           , string( page-number( text_out ), ">>>9":U        )
     2350                           ) , j_total-length ) format "x(198)":U at 1 skip( 0 )
     2351     v_label-line1                              format "x(198)":U at 1 skip( 0 )
     2352     v_label-line2                              format "x(198)":U at 1 skip( 0 )
