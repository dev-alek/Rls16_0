     2393   define variable v-value-decimal   as decimal   no-undo .
     2394   define variable v-value-integer   as integer   no-undo .
     2395   define variable v-value-logical   as logical   no-undo .
     2396   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2397   empty temp-table thbjattr_thbj-attr.
     2398   run adm/shattri.p (
     2399      input "get":U
     2400     ,input v-cntxt-obj-type
     2401     ,input v-cntxt-obj-code
     2402     ,input 'report-firm':U
     2403     ,input  ""
     2404     ,output v-value-character
     2405     ,output v-value-date
     2406     ,output v-value-decimal
     2407     ,output v-value-integer
     2408     ,output v-value-logical
     2409     ,output par-type
     2410     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     2411     ) no-error .
     2412     for each thbjattr_thbj-attr :
     2413         if thbjattr_thbj-attr.prop-code = 'XL-delim'  then v_temp-param   = thbjattr_thbj-attr.property-value-character.
     2414     end.
     2415     IF v_temp-param = "" then XL-delim = ";".
     2416     else XL-delim = v_temp-param.
     2417     run gbl/getlocal.p
     2418       ( output v-del-0
     2419       , output v-del-1
     2420       , output v-del-2
     2421       , output v-short-date
     2422       ) no-error .
     2423     if error-status :error
     2424     then do:
     2425       assign
     2426         v-del-1 = " ":U
     2427       .
     2428     end.
     2429     assign
     2430       XLS-page-num = XLS-page-num + 1
     2431     .
     2432     for each SheetF where
     2433              SheetF.Sheet-Num > XLS-page-num
     2434     :
     2435       delete SheetF .
     2436     end.
     2437     find first SheetF where
     2438                SheetF.Sheet-Num = XLS-page-num no-error .
     2439     if not available SheetF
     2440     then do:
     2441       create SheetF .
     2442       assign
     2443         SheetF.Sheet-Num = XLS-page-num
     2444       .
     2445     end.
     2446     assign
     2447       SheetF.MergeCellsH        = "":U
     2448       SheetF.MergeCellsV        = "":U
     2449       SheetF.Excel-Column-Lable = "":U
     2450       SheetF.ColFormat          = "":U
     2451       SheetF.Sizes              = "":U
     2452       Sheetf.Bas-File           = "ptrlhour.bas"
     2453       Sheetf.Bas-Param-Add      = yes
     2454     .
     2455     run get-fo-range in this-procedure
     2456       (
     2457          input p-obj-type
     2458       ,  input p-obj-code
     2459       ,  input x-Date-Start
     2460       ,  input x-Date-End
     2461       ,  input x-Shift-Start
     2462       ,  input x-Shift-End
     2463       ,  input x-TOG-Shift
     2464       , output fact-order-from
     2465       , output fact-order-till
     2466       ) no-error .
     2467     if error-status :error
     2468     then do:
     2469       message return-value skip( 0 )
     2470               error-status :get-message( 1 ) skip( 0 )
     2471               error-status :get-message( 2 ) skip( 0 )
     2472       view-as alert-box error .
     2473       return error .
     2474     end.
     2475     if x-TOG-Shift = yes
     2476     then do:
     2477       find first bf_shift-obj_from no-lock where
     2478                  bf_shift-obj_from.obj-type    = p-obj-type     and
     2479                  bf_shift-obj_from.obj-code    = p-obj-code     and
     2480                ( bf_shift-obj_from.shift-date  = x-Date-Start   and
     2481                  bf_shift-obj_from.shift-num  >= x-Shift-Start  or
     2482                  bf_shift-obj_from.shift-date >  x-Date-Start ) no-error .
     2483       if not available bf_shift-obj_from
     2484       then do:
     2485         message "Не найдена смена начала отчета." skip( 0 )
     2486                 "Дата:"    string( x-Date-Start, "99/99/9999":U ) skip( 0 )
     2487                 "Порядок:" x-Shift-Start skip( 1 )
     2488         view-as alert-box error .
     2489         return error .
     2490       end.
     2491       find last bf_shift-obj_till no-lock where
     2492                 bf_shift-obj_till.obj-type    = p-obj-type   and
     2493                 bf_shift-obj_till.obj-code    = p-obj-code   and
     2494               ( bf_shift-obj_till.shift-date  = x-Date-End   and
     2495                 bf_shift-obj_till.shift-num  <= x-Shift-End  or
     2496                 bf_shift-obj_till.shift-date <  x-Date-End ) no-error .
     2497       if not available bf_shift-obj_from
     2498       then do:
     2499         message "Не найдена смена окончания отчета." skip( 0 )
     2500                 "Дата:"    string( x-Date-End, "99/99/9999":U ) skip( 0 )
     2501                 "Порядок:" x-Shift-Start skip( 1 )
     2502         view-as alert-box error .
     2503         return error .
     2504       end.
     2505     end.
     2506     else do:
     2507       find first bf_shift-obj_from no-lock where
     2508                  bf_shift-obj_from.obj-type    = p-obj-type   and
     2509                  bf_shift-obj_from.obj-code    = p-obj-code   and
     2510                  bf_shift-obj_from.shift-date >= x-Date-Start no-error .
     2511       if not available bf_shift-obj_from
     2512       then do:
     2513         message "Не найдена смена начала отчета." skip( 0 )
     2514                 "Дата:" string( x-Date-Start, "99/99/9999":U ) skip( 1 )
     2515         view-as alert-box error .
     2516         return error .
     2517       end.
     2518       find last bf_shift-obj_till no-lock where
     2519                 bf_shift-obj_till.obj-type    = p-obj-type and
     2520                 bf_shift-obj_till.obj-code    = p-obj-code and
     2521                 bf_shift-obj_till.shift-date <= x-Date-End no-error .
     2522       if not available bf_shift-obj_from
     2523       then do:
     2524         message "Не найдена смена окончания отчета." skip( 0 )
     2525                 "Дата:" string( x-Date-End, "99/99/9999":U ) skip( 1 )
     2526         view-as alert-box error .
     2527         return error .
     2528       end.
     2529     end.
     2530   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2531   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2532     (output v-curr-r-b
     2533     )  .
     2534   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2535   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2536     (input  p-obj-type
     2537     ,input  p-obj-code
     2538     ,output v-host-code
     2539     )  .
     2540   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2541   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     2542     (input  v-host-code
     2543     ,output v-base-code
     2544     )  .
     2545     if v-curr-r-b = 'base':U or
     2546     v-base-code = 0 then pychk_NO-exch = yes.
     2547     else pychk_No-exch = no.
     2548     if v-curr-r-b = 'rubl':U or
     2549     v-base-code = 0 then pychk_NO-exch-rubl = yes.
     2550     else pychk_No-exch-rubl = no.
     2551     for each bf_shift-obj no-lock where
     2552              bf_shift-obj.obj-type    = p-obj-type                   and
     2553              bf_shift-obj.obj-code    = p-obj-code                   and
     2554              bf_shift-obj.shift-date >= bf_shift-obj_from.shift-date and
     2555              bf_shift-obj.shift-date <= bf_shift-obj_till.shift-date
     2556     :
     2557       if bf_shift-obj.shift-date = bf_shift-obj_from.shift-date and
     2558          bf_shift-obj.shift-num  < bf_shift-obj_from.shift-num  or
     2559          bf_shift-obj.shift-date = bf_shift-obj_till.shift-date and
     2560          bf_shift-obj.shift-num  > bf_shift-obj_till.shift-num
     2561       then do:
     2562         next .
     2563       end.
     2564       _chk-doc:
     2565       for each chk-doc no-lock where
     2566                chk-doc.obj-type    = bf_shift-obj.obj-type   and
     2567                chk-doc.obj-code    = bf_shift-obj.obj-code   and
     2568                chk-doc.shift-date  = bf_shift-obj.shift-date and
     2569                chk-doc.shift-num   = bf_shift-obj.shift-num  and
     2570                chk-doc.out-code   <> ? :
     2571         find first buf_inkas where buf_inkas.inkas-code = chk-doc.out-code no-lock no-error.
     2572         if not available buf_inkas then do:
     2573           next.
     2574         end.
     2575         if lookup( string( chk-doc.chk-type ), '14,15,16,36,8,101,106,108,11,12,13,40,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U ) > 0
     2576         then do:
     2577           next _chk-doc .
     2578         end.
     2579         for each treal-2 :
     2580           delete treal-2.
     2581         end.
     2582         for each treal-vat :
     2583           delete treal-vat.
     2584         end.
     2585         for each chk-pay no-lock where
     2586                  chk-pay.doc-code = chk-doc.doc-code
     2587           BREAK
     2588           BY CHK-pay.DOC-CODE
     2589           BY CHK-pay.LINE-NUM:
     2590   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2591   if first-of(CHK-pay.DOC-CODE) THEN Do:
     2592     assign
     2593     pychk_kk = 0
     2594     pychk_jj = 1
     2595     pychk_jjp = 0
     2596     pychk_jjo = 0
     2597     pychk_pay-sum = chk-doc.netto
     2598     pychk_dop-sumg = 0
     2599     .
     2600     if p-by-pay-card-prefix  then do:
     2601       find first buf_temp-cpa-pcep no-lock where
     2602                 buf_temp-cpa-pcep.cdpay-code = ub.chk-pay.pay-code
     2603             AND buf_temp-cpa-pcep.curr-code = ub.chk-pay.curr-code
     2604             AND ub.chk-pay.pay-card begins buf_temp-cpa-pcep.prefix no-error .
     2605       if available buf_temp-cpa-pcep then
     2606       assign
     2607       pychk_pay-card = buf_temp-cpa-pcep.prefix
     2608       .
     2609       else
     2610       assign
     2611       pychk_pay-card = 'other':U
     2612       .
     2613     end.
     2614     else do:
     2615       assign
     2616       pychk_pay-card = '':U
     2617       .
     2618     end.
     2619    if ub.chk-doc.netto < 0 then do:
     2620           if pychk_doc-code-r <> ub.chk-doc.out-code
     2621           then do:
     2622             find first pychk_ras-doc no-lock
     2623               where pychk_ras-doc.doc-code = ub.chk-doc.out-code
     2624               no-error .
     2625             if not available pychk_ras-doc then do:
     2626               message
     2627                 substitute("Отсутствует документ расхода по чеку &1"
     2628                           , ub.chk-doc.doc-code
     2629                           )   skip
     2630                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     2631                 view-as alert-box error .
     2632               return error .
     2633             end.
     2634             pychk_doc-code-r = pychk_ras-doc.doc-code.
     2635             find first pychk_ret-doc no-lock
     2636               where pychk_ret-doc.doc-code = pychk_ras-doc.out-code
     2637               no-error .
     2638             if not available pychk_ret-doc then do:
     2639               message
     2640                 substitute("Отсутствует документ возврата по чеку &1"
     2641                           , ub.chk-doc.doc-code
     2642                           )   skip
     2643                 "ЭКСПОРТ НЕ МОЖЕТ БЫТЬ ОСУЩЕСТВЛЕН" SKIP
     2644                 view-as alert-box error .
     2645               return error .
     2646             end.
     2647             pychk_doc-code-v = pychk_ret-doc.doc-code.
     2648           end.
     2649           assign
     2650             pychk_doc-code = pychk_doc-code-v
     2651           .
     2652         end.
     2653         else do:
     2654           assign
     2655             pychk_doc-code = ub.chk-doc.out-code
     2656           .
     2657         end.
     2658     FOR EACH ub.chk-gds No-LOCK WHERE
     2659              ub.chk-gds.doc-code = ub.chk-pay.doc-code
     2660     BY ub.chk-gds.line-num:
     2661     pychk_density = 0.
     2662     if ub.chk-gds.write-off-code <> ?
     2663     and ub.chk-gds.write-off-code > 0 then NEXT.
     2664       if chk-gds.pump <> 0 then do:
     2665         find first ub.bar-code no-lock where ub.bar-code.b-code = ub.chk-gds.b-code    no-error.
     2666         find first ub.goods    no-lock where ub.goods.gds-code  = ub.bar-code.gds-code no-error.
     2667         find first ub.doc-line no-lock where
     2668                   ub.doc-line.doc-code  = pychk_doc-code and
     2669                   ub.doc-line.artic     = ub.goods.artic      and
     2670                   ub.doc-line.prod-type = ub.goods.prod-type  and
     2671                   ub.doc-line.prod-code = ub.goods.prod-code  no-error.
     2672         assign pychk_density = ( if available ub.doc-line then ub.doc-line.fact-density else 0 ).
     2673         find first temp-chk-gds where
     2674                   temp-chk-gds.b-code = chk-gds.b-code
     2675              AND  temp-chk-gds.doc-code = chk-gds.doc-code
     2676              and temp-chk-gds.pump = chk-gds.pump
     2677              and temp-chk-gds.nozzle-code = (if chk-gds.nozzle-code = ? then 0 else chk-gds.nozzle-code)
     2678              and temp-chk-gds.rec-type = 1 no-error.
     2679         if available temp-chk-gds then do:
     2680           assign
     2681           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.doc-qnty
     2682           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     2683           temp-chk-gds.sum-change = temp-chk-gds.sum
     2684           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + ub.chk-gds.doc-qnty * pychk_density
     2685           .
     2686         end.
     2687         else do:
     2688           find first temp-chk-gds use-index ijj where temp-chk-gds.jj_ = pychk_jj no-error.
     2689           if not available temp-chk-gds then do:
     2690             create temp-chk-gds.
     2691             assign
     2692             temp-chk-gds.jj_ = pychk_jj
     2693             pychk_jj = pychk_jj + 1
     2694             temp-chk-gds.qnty2 = 0
     2695             temp-chk-gds.qnty = 0
     2696             temp-chk-gds.sum = 0
     2697             temp-chk-gds.sum-change = temp-chk-gds.sum
     2698             .
     2699           end.
     2700           else do:
     2701             assign
     2702             temp-chk-gds.qnty2 = 0
     2703             temp-chk-gds.qnty = 0
     2704             temp-chk-gds.sum = 0
     2705             temp-chk-gds.sum-change = temp-chk-gds.sum
     2706             pychk_jj = pychk_jj + 1
     2707             .
     2708           end.
     2709           ASSIGN
     2710           temp-chk-gds.doc-code = chk-gds.doc-code
     2711           temp-chk-gds.b-code = chk-gds.b-code
     2712           temp-chk-gds.rec-type = 1
     2713           temp-chk-gds.gds-type = 1
     2714           temp-chk-gds.pump = chk-gds.pump
     2715           temp-chk-gds.nozzle-code = (if chk-gds.nozzle-code = ? then 0 else chk-gds.nozzle-code)
     2716           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.doc-qnty
     2717           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     2718           temp-chk-gds.sum-change = temp-chk-gds.sum
     2719           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + ub.chk-gds.doc-qnty * pychk_density
     2720           pychk_jjp = pychk_jjp + 1
     2721           temp-chk-gds.jjp_  = pychk_jjp
     2722           temp-chk-gds.jjo_  = 0
     2723           .
     2724         end.
     2725       end.
     2726       else do:
     2727         find first temp-chk-gds where
     2728                   temp-chk-gds.b-code = chk-gds.b-code
     2729              AND  temp-chk-gds.doc-code = chk-gds.doc-code
     2730              and temp-chk-gds.pump = chk-gds.pump
     2731              and temp-chk-gds.nozzle-code = (if chk-gds.nozzle-code = ? then 0 else chk-gds.nozzle-code)
     2732              and temp-chk-gds.rec-type = 0  no-error.
     2733         IF AVAILABLE TEMP-CHK-GDS THEN DO:
     2734           assign
     2735           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     2736           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     2737           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     2738           temp-chk-gds.sum-change = temp-chk-gds.sum
     2739           .
     2740         end.
     2741         else do:
     2742           find first temp-chk-gds where temp-chk-gds.jj_ = pychk_jj use-index ijj no-error.
     2743           if not available temp-chk-gds then do:
     2744             create temp-chk-gds.
     2745             assign
     2746             temp-chk-gds.jj_ = pychk_jj
     2747             temp-chk-gds.qnty2 = 0
     2748             temp-chk-gds.qnty = 0
     2749             temp-chk-gds.sum = 0
     2750             temp-chk-gds.sum-change = temp-chk-gds.sum
     2751             pychk_jj = pychk_jj + 1
     2752             .
     2753           end.
     2754           else do:
     2755             assign
     2756             pychk_jj = pychk_jj + 1
     2757             temp-chk-gds.qnty2 = 0
     2758             temp-chk-gds.qnty = 0
     2759             temp-chk-gds.sum = 0
     2760             temp-chk-gds.sum-change = temp-chk-gds.sum
     2761             .
     2762           end.
     2763           ASSIGN
     2764           temp-chk-gds.doc-code = chk-gds.doc-code
     2765           temp-chk-gds.b-code = chk-gds.b-code
     2766           temp-chk-gds.qnty = temp-chk-gds.qnty  + chk-gds.DOC-qnty
     2767           temp-chk-gds.sum  = temp-chk-gds.sum  + chk-gds.doc-qnty * (chk-gds.price-base - chk-gds.discnt + chk-gds.price-service)
     2768           temp-chk-gds.qnty2 = temp-chk-gds.qnty2 + chk-gds.doc-qnty * pychk_density
     2769           temp-chk-gds.sum-change = temp-chk-gds.sum
     2770           temp-chk-gds.rec-type = 0
     2771           temp-chk-gds.pump = 0
     2772           temp-chk-gds.nozzle-code = 0
     2773           temp-chk-gds.gds-type =
     2774                                     (if chk-doc.office = 'у':U then 3 else 2)
     2775           pychk_jjo = pychk_jjo + 1
     2776           temp-chk-gds.jjp_  = 0
     2777           temp-chk-gds.jjo_  = pychk_jjo
     2778           .
     2779         end.
     2780       end.
     2781     END.
     2782   end.
     2783   FIND FIRST ub.cash-pay No-LOCK WHERE
     2784             ub.cash-pay.cdpay-code = ub.chk-pay.pay-code AND
     2785             ub.cash-pay.curr-code = ub.chk-pay.curr-code No-ERROR.
     2786   if available ub.cash-pay then do:
     2787     find first temp-chk-pay where
     2788             temp-chk-pay.line-num = chk-pay.line-num
     2789         AND  temp-chk-pay.doc-code = chk-pay.doc-code  no-error.
     2790     find first temp-chk-pay use-index pi where
     2791             temp-chk-pay.line-num = chk-pay.line-num no-error.
     2792     if not available temp-chk-pay then do:
     2793       create temp-chk-pay.
     2794     end.
     2795     buffer-copy chk-pay to temp-chk-pay
     2796     assign
     2797     temp-chk-pay.pet-good = integer(cash-pay.atr64) * 2 + integer(cash-pay.is-cash)
     2798     temp-chk-pay.obj-name = cash-pay.obj-name
     2799     temp-chk-pay.is-cash  = cash-pay.is-cash
     2800     temp-chk-pay.register = cash-pay.register
     2801     .
     2802   end.
     2803   if last-of(chk-pay.doc-code) then do:
     2804     for each temp-chk-pay where
     2805             temp-chk-pay.doc-code = chk-pay.doc-code
     2806     by temp-chk-pay.pet-good descending
     2807     by temp-chk-pay.line-num:
     2808       assign
     2809       pychk_dop-sump = (if v-curr-r-b = 'rubl':U then temp-chk-pay.tot-rubl else temp-chk-pay.tot-base)
     2810       pychk_exch = if pychk_No-exch then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     2811       pychk_exch-rubl = if pychk_No-exch-rubl then 1 else temp-chk-pay.tot-rubl / temp-chk-pay.tot-base
     2812       .
     2813       _repeat:
     2814       REPEAT WHILE  abs(pychk_dop-sump) > 0 :
     2815         if pychk_dop-sumg = 0 then do:
     2816           assign
     2817           pychk_kk = pychk_kk + 1
     2818           .
     2819           if pychk_kk >= pychk_jj then LEAVE _repeat.
     2820           if pychk_kk <= pychk_jjp then
     2821           find first temp-chk-gds where
     2822                     temp-chk-gds.doc-code = chk-doc.doc-code
     2823               AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     2824           else
     2825           find first temp-chk-gds where
     2826                     temp-chk-gds.doc-code = chk-doc.doc-code
     2827               AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     2828           if not available temp-chk-gds or temp-chk-gds.sum = 0 then do:
     2829             NEXT _repeat.
     2830           end.
     2831           assign
     2832           pychk_dop-sumg = temp-chk-gds.sum
     2833           .
     2834         end.
     2835         assign
     2836         pychk_dop-sumk = min(abs(pychk_dop-sumg), abs(pychk_dop-sump))  * (if pychk_dop-sump > 0 then 1 else -1 )
     2837         pychk_pay-sum = pychk_pay-sum - pychk_dop-sumk
     2838         pychk_dop-sump = pychk_dop-sump - pychk_dop-sumk
     2839         pychk_dop-sumg = pychk_dop-sumg - pychk_dop-sumk
     2840         .
     2841         FIND FIRST ub.bar-code No-LOCK WHERE
     2842                   ub.bar-code.b-code =  temp-chk-gds.b-code No-ERROR.
     2843         IF NOT AVAIL ub.bar-code then NEXT _repeat.
     2844         CASE temp-chk-gds.gds-type:
     2845           WHEN 1   then do:
     2846             if pychk_sheet2 then do:
     2847               if p-by-pay-card-prefix
     2848               and pychk_pay-card <> "other"
     2849               then do:
     2850                 FIND FIRST b2-treal-2 No-LOCK WHERE
     2851                           b2-treal-2.gds-code = ub.bar-code.gds-code AND
     2852                           b2-treal-2.cpay-code = temp-chk-pay.pay-code AND
     2853                           b2-treal-2.curr-code = temp-chk-pay.curr-code AND
     2854                           b2-treal-2.is-pay = yes
     2855                           AND b2-treal-2.pay-desk = pychk_pay-desk
     2856                           AND b2-treal-2.prefix = pychk_pay-card
     2857                      AND b2-treal-2.pump = temp-chk-gds.pump
     2858                      AND b2-treal-2.nozzle-code = temp-chk-gds.nozzle-code
     2859                           No-ERROR.
     2860                 IF NOT AVAIL  b2-treal-2 then do:
     2861                   FIND last b3-treal-2 No-LOCK WHERE
     2862                             b3-treal-2.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
     2863                   run create-b2-treal-2 in this-procedure (
     2864                                   INPUT ub.bar-code.gds-code,
     2865                                   INPUT temp-chk-pay.pay-code,
     2866                                   INPUT temp-chk-pay.curr-code,
     2867                                   INPUT 0,
     2868                                   INPUT 0,
     2869                                   INPUT 0,
     2870                                   INPUT temp-chk-pay.obj-name,
     2871                                   INPUT yes,
     2872                                   INPUT (if avail b3-treal-2
     2873                                         then b3-treal-2.ii + 1
     2874                                         else 1)
     2875                                   ,INPUT  pychk_pay-desk
     2876                                   ,INPUT pychk_pay-card
     2877                                   ,input temp-chk-gds.pump
     2878                                   ,input temp-chk-gds.nozzle-code
     2879                                   ) no-error.
     2880                 END.
     2881                 assign
     2882                 b2-treal-2.netto = b2-treal-2.netto + pychk_dop-sumk / pychk_exch
     2883                 b2-treal-2.qnty1 = b2-treal-2.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     2884                 b2-treal-2.qnty2 = b2-treal-2.qnty2 + temp-chk-gds.qnty2 * ( pychk_dop-sumk / temp-chk-gds.sum )
     2885                 b2-treal-2.netto-rubl = b2-treal-2.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     2886                 .
     2887               end.
     2888               FIND FIRST treal-2 No-LOCK WHERE
     2889                         treal-2.gds-code = ub.bar-code.gds-code AND
     2890                         treal-2.cpay-code = temp-chk-pay.pay-code AND
     2891                         treal-2.curr-code = temp-chk-pay.curr-code AND
     2892                         treal-2.is-pay = yes
     2893                         AND treal-2.pay-desk = pychk_pay-desk
     2894                         AND treal-2.prefix = ''
     2895                         AND treal-2.pump = temp-chk-gds.pump
     2896                         AND treal-2.nozzle-code = temp-chk-gds.nozzle-code
     2897                         No-ERROR.
     2898               IF NOT AVAIL treal-2 then do:
     2899                 FIND last b-treal-2 No-LOCK WHERE
     2900                           b-treal-2.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
     2901                 run create-treal-2 in this-procedure (
     2902                                 INPUT ub.bar-code.gds-code,
     2903                                 INPUT temp-chk-pay.pay-code,
     2904                                 INPUT temp-chk-pay.curr-code,
     2905                                 INPUT 0,
     2906                                 INPUT 0,
     2907                                 INPUT 0,
     2908                                 INPUT temp-chk-pay.obj-name,
     2909                                 INPUT yes,
     2910                                 INPUT (if avail b-treal-2
     2911                                       then b-treal-2.ii + 1
     2912                                       else 1)
     2913                                 , INPUT  pychk_pay-desk
     2914                                 ,INPUT '':U
     2915                                 ,input temp-chk-gds.pump
     2916                                 ,input temp-chk-gds.nozzle-code
     2917                                 ) no-error.
     2918               END.
     2919               assign
     2920               treal-2.netto = treal-2.netto + pychk_dop-sumk / pychk_exch
     2921               treal-2.qnty1 = treal-2.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     2922               treal-2.qnty2 = treal-2.qnty2 + temp-chk-gds.qnty2 * ( pychk_dop-sumk / temp-chk-gds.sum )
     2923               treal-2.netto-rubl = treal-2.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     2924               .
     2925             end.
     2926           END.
     2927           WHEN 2   then do:
     2928                   if pychk_sheet3 then do:
     2929               FIND FIRST ub.goods No-LOCK WHERE
     2930                           ub.goods.gds-code = ub.bar-code.gds-code No-ERROR.
     2931               IF NOT AVAIL ub.goods then NEXT _repeat.
     2932               if p-by-pay-card-prefix
     2933               and pychk_pay-card <> "other"
     2934               then do:
     2935                 FIND FIRST b2-treal-3 No-LOCK WHERE
     2936                           b2-treal-3.gds-code = ub.goods.gds-code AND
     2937                           b2-treal-3.cpay-code = temp-chk-pay.pay-code AND
     2938                           b2-treal-3.curr-code = temp-chk-pay.curr-code
     2939                           AND b2-treal-3.pay-desk = pychk_pay-desk
     2940                           AND b2-treal-3.prefix = pychk_pay-card
     2941                           No-ERROR.
     2942                 IF NOT AVAIL b2-treal-3 then do:
     2943                   FIND last b3-treal-3 No-LOCK WHERE
     2944                             b3-treal-3.gds-code = ub.goods.gds-code use-index vi No-ERROR.
     2945                   run create-g-b2-treal-3 in this-procedure (
     2946                                 INPUT ub.goods.gds-code,
     2947                                 INPUT temp-chk-pay.pay-code,
     2948                                 INPUT temp-chk-pay.curr-code,
     2949                                 INPUT 0,
     2950                                 INPUT 0,
     2951                                 INPUT temp-chk-pay.obj-name,
     2952                                 INPUT yes,
     2953                                 INPUT (if avail b-treal-3
     2954                                         then b3-treal-3.ii + 1
     2955                                         else 1)
     2956                               , INPUT  pychk_pay-desk
     2957                               , INPUT  pychk_pay-card
     2958                                       ) no-error.
     2959                 END.
     2960                 assign
     2961                 b2-treal-3.netto = b2-treal-3.netto + pychk_dop-sumk / pychk_exch
     2962                 b2-treal-3.qnty1 = b2-treal-3.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     2963                 b2-treal-3.netto-rubl = b2-treal-3.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     2964                 .
     2965               end.
     2966               FIND FIRST treal-3 No-LOCK WHERE
     2967                         treal-3.gds-code = ub.goods.gds-code AND
     2968                         treal-3.cpay-code = temp-chk-pay.pay-code AND
     2969                         treal-3.curr-code = temp-chk-pay.curr-code
     2970                         AND treal-3.pay-desk = pychk_pay-desk
     2971                         AND treal-3.prefix = '':U
     2972                         No-ERROR.
     2973               IF NOT AVAIL treal-3 then do:
     2974                 FIND last b-treal-3 No-LOCK WHERE
     2975                           b-treal-3.gds-code = ub.goods.gds-code use-index vi No-ERROR.
     2976                 run create-g-treal-3  in this-procedure (
     2977                               INPUT ub.goods.gds-code,
     2978                               INPUT temp-chk-pay.pay-code,
     2979                               INPUT temp-chk-pay.curr-code,
     2980                               INPUT 0,
     2981                               INPUT 0,
     2982                               INPUT temp-chk-pay.obj-name,
     2983                               INPUT yes,
     2984                               INPUT (if avail b-treal-3
     2985                                       then b-treal-3.ii + 1
     2986                                       else 1)
     2987                             , INPUT  pychk_pay-desk
     2988                             , INPUT  '':U
     2989                                     ) no-error.
     2990               END.
     2991               assign
     2992               treal-3.netto = treal-3.netto + pychk_dop-sumk / pychk_exch
     2993               treal-3.qnty1 = treal-3.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     2994               treal-3.netto-rubl = treal-3.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     2995               .
     2996             END.
     2997           END.
     2998           WHEN 3  then do:
     2999             if pychk_sheet4 then do:
     3000               if p-by-pay-card-prefix
     3001               and pychk_pay-card <> "other"
     3002               then do:
     3003                 FIND FIRST b2-treal-4 No-LOCK WHERE
     3004                           b2-treal-4.gds-code = ub.bar-code.gds-code AND
     3005                           b2-treal-4.cpay-code = temp-chk-pay.pay-code AND
     3006                           b2-treal-4.curr-code = temp-chk-pay.curr-code AND
     3007                           b2-treal-4.is-pay = yes
     3008                           AND b2-treal-4.pay-desk = pychk_pay-desk
     3009                           AND b2-treal-4.prefix = pychk_pay-card
     3010                           No-ERROR.
     3011                 IF NOT AVAIL b2-treal-4 then do:
     3012                   FIND last b3-treal-4 No-LOCK WHERE
     3013                             b3-treal-4.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
     3014                   run create-b2-treal-4 in this-procedure (
     3015                                   INPUT ub.bar-code.gds-code,
     3016                                   INPUT temp-chk-pay.pay-code,
     3017                                   INPUT temp-chk-pay.curr-code,
     3018                                   INPUT 0,
     3019                                   INPUT 0,
     3020                                   INPUT temp-chk-pay.obj-name,
     3021                                   INPUT yes,
     3022                                   INPUT (if avail b3-treal-4
     3023                                         then b3-treal-4.ii + 1
     3024                                         else 1)
     3025                                   , INPUT  pychk_pay-desk
     3026                                   , INPUT pychk_pay-card
     3027                                   ) no-error.
     3028                 END.
     3029                 assign
     3030                 b2-treal-4.netto = b2-treal-4.netto + pychk_dop-sumk / pychk_exch
     3031                 b2-treal-4.qnty1 = b2-treal-4.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     3032                 b2-treal-4.netto-rubl = b2-treal-4.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     3033                 .
     3034               end.
     3035               FIND FIRST treal-4 No-LOCK WHERE
     3036                         treal-4.gds-code = ub.bar-code.gds-code AND
     3037                         treal-4.cpay-code = temp-chk-pay.pay-code AND
     3038                         treal-4.curr-code = temp-chk-pay.curr-code AND
     3039                         treal-4.is-pay = yes
     3040                         AND treal-4.pay-desk = pychk_pay-desk
     3041                         AND treal-4.prefix = '':U
     3042                         No-ERROR.
     3043               IF NOT AVAIL treal-4 then do:
     3044                 FIND last b-treal-4 No-LOCK WHERE
     3045                           b-treal-4.gds-code = ub.bar-code.gds-code use-index vi No-ERROR.
     3046                 run create-treal-4  in this-procedure (
     3047                                 INPUT ub.bar-code.gds-code,
     3048                                 INPUT temp-chk-pay.pay-code,
     3049                                 INPUT temp-chk-pay.curr-code,
     3050                                 INPUT 0,
     3051                                 INPUT 0,
     3052                                 INPUT temp-chk-pay.obj-name,
     3053                                 INPUT yes,
     3054                                 INPUT (if avail b-treal-4
     3055                                       then b-treal-4.ii + 1
     3056                                       else 1)
     3057                                 , INPUT  pychk_pay-desk
     3058                                 , INPUT '':U
     3059                                 ) no-error.
     3060               END.
     3061               assign
     3062               treal-4.netto = treal-4.netto + pychk_dop-sumk / pychk_exch
     3063               treal-4.qnty1 = treal-4.qnty1 + temp-chk-gds.qnty * (pychk_dop-sumk / temp-chk-gds.sum)
     3064               treal-4.netto-rubl = treal-4.netto-rubl + pychk_dop-sumk * pychk_exch-rubl
     3065               .
     3066               END.
     3067           END.
     3068         END CASE.
     3069         if pychk_dop-sumg <= 0 then do:
     3070           assign
     3071           pychk_kk = pychk_kk + 1.
     3072           if pychk_kk >= pychk_jj then LEAVE _repeat.
     3073           if pychk_kk <= pychk_jjp then do:
     3074             find first temp-chk-gds where
     3075                       temp-chk-gds.doc-code = chk-doc.doc-code
     3076                 AND  temp-chk-gds.jjp_ = pychk_kk no-error .
     3077           end.
     3078           else do:
     3079             find first temp-chk-gds where
     3080                       temp-chk-gds.doc-code = chk-doc.doc-code
     3081                 AND  temp-chk-gds.jjo_ = pychk_kk - pychk_jjp no-error .
     3082             if not available temp-chk-gds then do:
     3083               LEAVE _repeat.
     3084             end.
     3085           end.
     3086           pychk_dop-sumg = temp-chk-gds.sum.
     3087           pychk_dop-sumg = temp-chk-gds.sum.
     3088         end.
     3089       END.
     3090     end.
     3091   output close.
     3092   end.
     3093         end.
     3094         for each treal-2 :
     3095           find first bf_goods no-lock where
     3096                      bf_goods.gds-code = treal-2.gds-code .
     3097   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     3098     (
     3099        input bf_goods.artic
     3100     ,  input bf_goods.prod-type
     3101     ,  input bf_goods.prod-code
     3102     , output is-petrol
     3103     , output is-pieces
     3104     ) no-error.
     3105           if error-status :error or
     3106              is-petrol <> yes    or
     3107              is-pieces <> no
     3108           then do:
     3109             next .
     3110           end.
     3111           assign
     3112             j_pump-code = treal-2.pump
     3113           no-error .
     3114           if j_pump-code  = ?    or
     3115              j_pump-code  = 0
     3116           then do:
     3117             message substitute( 'r-ptrsph.p: не удалось найти ТРК (из чека &4), '
     3118                               + 'из которого продано топливо &1 &2&3 (&5) смена за &6.'
     3119                               , bf_goods.artic
     3120                               , bf_goods.prod-type
     3121                               , bf_goods.prod-code
     3122                               , chk-doc.doc-code
     3123                               , treal-2.pump
     3124                               , string(chk-doc.shift-date, "99/99/9999")
     3125                               )
     3126             view-as alert-box error .
     3127             return error .
     3128           end.
     3129           assign
     3130           varnozzle-code = treal-2.nozzle-code
     3131           no-error .
     3132           if varnozzle-code = 0
     3133           or varnozzle-code = ?
     3134           then do:
     3135             varnozzle-code = 0.
     3136             run find-nzl-without-pl in this-procedure (
     3137                                              input  chk-doc.obj-type
     3138                                             ,input  chk-doc.obj-code
     3139                                             ,input  j_pump-code
     3140                                             ,input  bf_goods.gds-code
     3141                                             ,output varnozzle-code    ) no-error .
     3142             if error-status :error or
     3143               varnozzle-code  = ?    or
     3144               varnozzle-code  = 0
     3145             then do:
     3146               message substitute( 'r-ptrsph.p (find-nzl): не удалось найти пистолет (из чека &4), '
     3147                                 + 'из которого продано топливо &1 &2&3 (&5) смена за &6.'
     3148                                 , bf_goods.artic
     3149                                 , bf_goods.prod-type
     3150                                 , bf_goods.prod-code
     3151                                 , chk-doc.doc-code
     3152                                 , treal-2.pump
     3153                                 , string(chk-doc.shift-date, "99/99/9999")
     3154                                 )
     3155               view-as alert-box error .
     3156               return error .
     3157             end.
     3158           end.
     3159           find first tt_line where
     3160                       tt_line.pump-code   = j_pump-code
     3161                   and tt_line.nozzle-code = varnozzle-code
     3162                   and tt_line.pay-code    = treal-2.cpay-code
     3163                   and tt_line.curr-code   = treal-2.curr-code
     3164                   and tt_line.chk-date    = chk-doc.chk-date
     3165                   and tt_line.chk-time    = chk-doc.chk-time
     3166                   and tt_line.gds-code    = treal-2.gds-code
     3167                   no-error .
     3168           if not available tt_line
     3169           then do:
     3170             find first bf_cash-pay no-lock where
     3171                         bf_cash-pay.cdpay-code = treal-2.cpay-code and
     3172                         bf_cash-pay.curr-code  = treal-2.curr-code .
     3173             assign
     3174               j_order = j_order + 1
     3175             .
     3176             for first ub.bar-code no-lock where ub.bar-code.gds-code = treal-2.gds-code,
     3177             first ub.chk-gds no-lock where ub.chk-gds.b-code = ub.bar-code.b-code
     3178             and ub.chk-gds.doc-code = chk-doc.doc-code:
     3179             create tt_line .
     3180             assign
     3181               tt_line.artic       = bf_goods.artic
     3182               tt_line.prod-type   = bf_goods.prod-type
     3183               tt_line.prod-code   = bf_goods.prod-code
     3184               tt_line.gds-code    = bf_goods.gds-code
     3185               tt_line.gds-name    = bf_goods.gds-name
     3186               tt_line.pump-code   = j_pump-code
     3187               tt_line.nozzle-code = varnozzle-code
     3188               tt_line.chk-count   = 0
     3189               tt_line.base-qnty   = 0.00
     3190               tt_line.cli-qnty    = 0.00
     3191               tt_line.sum-sale    = 0.00
     3192               tt_line.pay-code    = bf_cash-pay.cdpay-code
     3193               tt_line.pay-name    = bf_cash-pay.obj-name
     3194               tt_line.curr-code   = bf_cash-pay.curr-code
     3195               tt_line.order       = j_order
     3196               tt_line.chk-date    = chk-doc.chk-date
     3197               tt_line.chk-time    = chk-doc.chk-time
     3198               tt_line.chk-code    = chk-doc.doc-code
     3199               tt_line.chk-num     = chk-doc.doc-num + ":" + STRING (chk-doc.z-number)
     3200               tt_line.pass-gds    = if chk-gds.pass-gds = 1 then "+" else "-"
     3201               tt_line.doc-num2    = chk-doc.doc-num2
     3202             .
     3203             end.
     3204           end.
     3205           assign
     3206           tt_line.sum-sale = tt_line.sum-sale   + treal-2.netto-rubl
     3207           tt_line.base-qnty = tt_line.base-qnty + treal-2.qnty1
     3208           .
     3209         end.
     3210       end.
     3211     end.
     3212     assign
     3213       j_chk-count     = 0
     3214       j_row-counter   = 0
     3215       j_total-lines   = 0
     3216       v_total-lines   = "":U
     3217       v_chk-code-list = "":U
     3218     .
     3219     for each tt_line no-lock
     3220     break by tt_line.chk-date
     3221           by tt_line.chk-time
     3222     :
     3223       if first-of( tt_line.chk-date )
     3224       then do:
     3225         assign
     3226           t_tmp-date      = tt_line.chk-date
     3227           v_chk-code-list = "":U
     3228         .
     3229         run get-hour-range in this-procedure
     3230           (
     3231              input tt_line.chk-time
     3232           , output j_hour-from
     3233           , output j_hour-till
     3234           ) .
     3235         do vari = 0 to 23 :
     3236           assign
     3237             j_chk-count = 0.
     3238           for each bf_line where
     3239                    bf_line.chk-date  = t_tmp-date  and
     3240                    bf_line.chk-time >= vari * 3600 and
     3241                    bf_line.chk-time <= vari * 3600 + 3599
     3242           by bf_line.chk-date by bf_line.chk-time
     3243           :
     3244             assign
     3245               j_chk-count = j_chk-count + 1
     3246             .
     3247             assign
     3248             bf_line.chk-count = j_chk-count.
     3249           end.
     3250         end.
     3251         if not first( tt_line.chk-date )
     3252         then do:
     3253           assign
     3254             j_row-counter = j_row-counter + 1
     3255             j_total-lines = j_total-lines + 1
     3256             v_total-lines = v_total-lines
     3257                           + ( if v_total-lines = "":U then "":U else chr(44) )
     3258                           + string( j_row-counter )
     3259           .
     3260         end.
     3261       end.
     3262       run get-hour-range in this-procedure
     3263         (
     3264            input tt_line.chk-time
     3265         , output j_tmp-hour-from
     3266         , output j_tmp-hour-till
     3267         ) .
     3268       if j_tmp-hour-from = j_hour-from and
     3269          j_tmp-hour-till = j_hour-till and
     3270          t_tmp-date      = tt_line.chk-date
     3271       then do:
     3272         if lookup( tt_line.chk-code, v_chk-code-list ) = 0
     3273         then do:
     3274           assign
     3275             v_chk-code-list = v_chk-code-list + ( if v_chk-code-list = "":U then "":U else chr(44) )
     3276                                               + tt_line.chk-code
     3277           .
     3278         end.
     3279       end.
     3280       else do:
     3281         assign
     3282           j_hour-from     = j_tmp-hour-from
     3283           j_hour-till     = j_tmp-hour-till
     3284           t_tmp-date      = tt_line.chk-date
     3285           v_chk-code-list = tt_line.chk-code
     3286         .
     3287         assign
     3288           j_row-counter = j_row-counter + 1
     3289           j_total-lines = j_total-lines + 1
     3290           v_total-lines = v_total-lines
     3291                         + ( if v_total-lines = "":U then "":U else chr(44) )
     3292                         + string( j_row-counter )
     3293         .
     3294       end.
     3295       assign
     3296         j_row-counter = j_row-counter + 1
     3297       .
     3298     end.
     3299     assign
     3300       j_row-counter = j_row-counter + 1
     3301       j_total-lines = j_total-lines + 1
     3302       v_total-lines = v_total-lines
     3303                     + ( if v_total-lines = "":U then "":U else chr(44) )
     3304                     + string( j_row-counter )
     3305     .
     3306     assign
     3307       t_tmp-date      = ?
     3308       j_hour-from     = 0
     3309       j_hour-till     = 0
     3310       v_chk-code-list = "":U
     3311     .
     3312     run get-label-lines in this-procedure
     3313       (
     3314         output v_label-line1
     3315       , output v_label-line2
     3316       , output v_label-line3
     3317       , output v_label-line4
     3318       , output v_label-line5
     3319       , output j_text-length
     3320       , output j_column-no
     3321       , output j_total-length
     3322       ) no-error .
     3323     if error-status :error
     3324     then do:
     3325       message return-value skip( 0 )
     3326               error-status :get-message( 1 ) skip( 1 )
     3327       view-as alert-box.
     3328       return error .
     3329     end.
     3330     find first SheetF where
     3331                SheetF.Sheet-Num = XLS-page-num .
     3332     assign
     3333       Sheetf.Bas-Params = string( j_row-counter ) + chr(4)
     3334                         + string( j_column-no   ) + chr(4)
     3335                         + string( j_total-lines ) + "#"
     3336                         +         v_total-lines   + chr(4)
     3337                         +         v-column-list
     3338     .
     3339     assign
     3340       Under_Line = fill( '-', j_total-length )
     3341     .
     3342     run cur-time in this-procedure
     3343       ( output t_today
     3344       , output j_time
     3345       ) .
     3346     if j_total-length > 136
     3347     then do:
     3348   output stream text_out to value( string( session:temp-directory +
     3349                                        "rpt" + string( g#report-num ) ) )
     3350                                        page-size  value(43) .
     3351     end.
     3352     else do:
     3353   output stream text_out to value( string( session:temp-directory +
     3354                                        "rpt" + string( g#report-num ) ) )
     3355                                        page-size  value(62) .
     3356     end.
     3357     if XLS-page-num > 1
     3358     then do:
     3359       if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     3360     end.
     3361     assign
     3362       ReportName   = "Почасовая статистика продаж ТРК с детализацией по пистолетам"
     3363       ReportHeader = substitute( "Дата печати: &1, время: &2."
     3364                                , string( t_today, "99.99.9999":U )
     3365                                , string( j_time,  "hh:mm:ss":U   )
     3366                                )
     3367     .
     3368     run rep/extitle.p
     3369       ( input XLS-page-num
     3370       ) no-error .
     3371     view stream text_out frame    Top_Page .
     3372     view stream text_out frame Bottom_Page .
     3373     assign
     3374       t_tmp-date  = ?
     3375       d_sum-sale  = 0.00
     3376       d_base-qnty = 0.00
     3377     .
     3378     for each tt_line no-lock
     3379     break by tt_line.chk-date
     3380           by tt_line.chk-time
     3381     :
     3382       if first-of( tt_line.chk-date )
     3383       then do:
     3384         assign
     3385           t_tmp-date = tt_line.chk-date
     3386         .
     3387         run get-hour-range in this-procedure
     3388           (
     3389              input tt_line.chk-time
     3390           , output j_hour-from
     3391           , output j_hour-till
     3392           ) .
     3393       end.
     3394       run get-hour-range in this-procedure
     3395         (
     3396            input tt_line.chk-time
     3397         , output j_tmp-hour-from
     3398         , output j_tmp-hour-till
     3399         ) .
     3400       if j_tmp-hour-from = j_hour-from and
     3401          j_tmp-hour-till = j_hour-till and
     3402          t_tmp-date      = tt_line.chk-date
     3403       then do:
     3404         if use-column[  9 ] = yes
     3405         then do:
     3406           assign
     3407             d_base-qnty = d_base-qnty + tt_line.base-qnty
     3408           .
     3409         end.
     3410         if use-column[ 10 ] = yes
     3411         then do:
     3412           assign
     3413             d_sum-sale  = d_sum-sale  + tt_line.sum-sale
     3414           .
     3415         end.
     3416       end.
     3417       else do:
     3418         if use-column[  9 ] = yes or
     3419            use-column[ 10 ] = yes
     3420         then do:
     3421           if use-column[  9 ] = yes
     3422           then do:
     3423             run get-indent in this-procedure
     3424               (
     3425                  input 9
     3426               , output j_indent
     3427               , output v_text-indent
     3428               , output v_excel-indent
     3429               ) .
     3430             put stream text_out unformatted
     3431               v_text-indent
     3432               fill( "-", 13 )
     3433             .
     3434           end.
     3435           if use-column[ 10 ] = yes
     3436           then do:
     3437             if use-column[  9 ] <> yes
     3438             then do:
     3439               run get-indent in this-procedure
     3440                 (
     3441                    input 10
     3442                 , output j_indent
     3443                 , output v_text-indent
     3444                 , output v_excel-indent
     3445                 ) .
     3446               put stream text_out unformatted
     3447                 v_text-indent
     3448               .
     3449             end.
     3450             else do:
     3451               put stream text_out unformatted
     3452                 " ":U
     3453               .
     3454             end.
     3455             put stream text_out unformatted
     3456               fill( "-", 21 )
     3457             .
     3458           end.
     3459           put stream text_out unformatted
     3460             skip
     3461           .
     3462         end.
     3463         if use-column[  9 ] = yes or
     3464            use-column[ 10 ] = yes
     3465         then do:
     3466           if use-column[  9 ] = yes
     3467           then do:
     3468             run get-indent in this-procedure
     3469               (
     3470                  input 9
     3471               , output j_indent
     3472               , output v_text-indent
     3473               , output v_excel-indent
     3474               ) .
     3475             put stream text_out unformatted
     3476               v_text-indent
     3477               string( d_base-qnty, "->>>>,>>9.999":U )
     3478             .
     3479             if Make-Excel then  put   stream ForExcel unformatted
     3480               v_excel-indent
     3481               string( d_base-qnty, "->>>>>>>9.999":U )
     3482             .
     3483           end.
     3484           if use-column[ 10 ] = yes
     3485           then do:
     3486             if use-column[  9 ] <> yes
     3487             then do:
     3488               run get-indent in this-procedure
     3489                 (
     3490                    input 10
     3491                 , output j_indent
     3492                 , output v_text-indent
     3493                 , output v_excel-indent
     3494                 ) .
     3495               put stream text_out unformatted
     3496                 v_text-indent
     3497               .
     3498               if Make-Excel then  put   stream ForExcel unformatted
     3499                 v_excel-indent
     3500               .
     3501             end.
     3502             else do:
     3503               put stream text_out unformatted
     3504                 " ":U
     3505               .
     3506             end.
     3507             put stream text_out unformatted
     3508               string( d_sum-sale, "->,>>>,>>>,>>>,>>9.99":U )
     3509             .
     3510             if Make-Excel then  put   stream ForExcel unformatted
     3511               CHR(9)
     3512               string( d_sum-sale, "->>>>>>>>>>>>>>>>9.99":U )
     3513             .
     3514           end.
     3515           put stream text_out unformatted
     3516             skip Under_Line skip
     3517           .
     3518           if Make-Excel then  put   stream ForExcel unformatted
     3519             skip
     3520           .
     3521         end.
     3522         assign
     3523           j_hour-from = j_tmp-hour-from
     3524           j_hour-till = j_tmp-hour-till
     3525           t_tmp-date  = tt_line.chk-date
     3526           d_sum-sale  = tt_line.sum-sale
     3527           d_base-qnty = tt_line.base-qnty
     3528         .
     3529       end.
     3530       run get-print-line in this-procedure
     3531         (
     3532            input recid( tt_line )
     3533         , output v_print-line
     3534         , output v_excel-line
     3535         ) no-error .
     3536       if error-status :error or
     3537          v_print-line = ?    or
     3538          v_print-line = "":U
     3539       then do:
     3540         return error substitute( 'Ошибка печати строки отчета.&1 ТРК &2, Пистолет &3, &4.&1'
     3541                                + 'Чек &5, Оплата &6, Код валюты &7.'
     3542                                , chr(10)
     3543                                , tt_line.pump-code
     3544                                , tt_line.nozzle-code
     3545                                , substitute( 'Топливо &1 &2&3 "&4"'
     3546                                            , tt_line.artic
     3547                                            , tt_line.prod-type
     3548                                            , tt_line.prod-code
     3549                                            , tt_line.gds-code
     3550                                            )
     3551                                , tt_line.chk-code
     3552                                , tt_line.pay-code
     3553                                , tt_line.curr-code
     3554                                ) .
     3555       end.
     3556       put stream text_out unformatted
     3557         v_print-line skip
     3558       .
     3559       if Make-Excel then  put   stream ForExcel unformatted
     3560         v_excel-line skip
     3561       .
     3562       if last-of( tt_line.chk-date )
     3563       then do:
     3564         if use-column[  9 ] = yes or
     3565            use-column[ 10 ] = yes
     3566         then do:
     3567           if use-column[  9 ] = yes
     3568           then do:
     3569             run get-indent in this-procedure
     3570               (
     3571                  input 9
     3572               , output j_indent
     3573               , output v_text-indent
     3574               , output v_excel-indent
     3575               ) .
     3576             put stream text_out unformatted
     3577               v_text-indent
     3578               fill( "-", 13 )
     3579             .
     3580           end.
     3581           if use-column[ 10 ] = yes
     3582           then do:
     3583             if use-column[  9 ] <> yes
     3584             then do:
     3585               run get-indent in this-procedure
     3586                 (
     3587                    input 10
     3588                 , output j_indent
     3589                 , output v_text-indent
     3590                 , output v_excel-indent
     3591                 ) .
     3592               put stream text_out unformatted
     3593                 v_text-indent
     3594               .
     3595             end.
     3596             else do:
     3597               put stream text_out unformatted
     3598                 " ":U
     3599               .
     3600             end.
     3601             put stream text_out unformatted
     3602               fill( "-", 21 )
     3603             .
     3604           end.
     3605           put stream text_out unformatted
     3606             skip
     3607           .
     3608         end.
     3609         if use-column[  9 ] = yes or
     3610            use-column[ 10 ] = yes
     3611         then do:
     3612           if use-column[  9 ] = yes
     3613           then do:
     3614             run get-indent in this-procedure
     3615               (
     3616                  input 9
     3617               , output j_indent
     3618               , output v_text-indent
     3619               , output v_excel-indent
     3620               ) .
     3621             put stream text_out unformatted
     3622               v_text-indent
     3623               string( d_base-qnty, "->>>>,>>9.999":U )
     3624             .
     3625             if Make-Excel then  put   stream ForExcel unformatted
     3626               v_excel-indent
     3627               string( d_base-qnty, "->>>>>>>9.999":U )
     3628             .
     3629           end.
     3630           if use-column[ 10 ] = yes
     3631           then do:
     3632             if use-column[  9 ] <> yes
     3633             then do:
