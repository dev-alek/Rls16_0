     2086             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     2087             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     2088             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     2089             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     2090             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     2091             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     2092             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     2093             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     2094             .
     2095         end.
     2096         when 'маг':U then do:
     2097           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     2098           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     2099           assign
     2100             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     2101             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
