     1966     function valid-density returns logical ( input p-density as decimal, input p-unit-base-cli-eq as logical ) :
     1967       define variable v-answ as logical no-undo .
     1968       if ( p-unit-base-cli-eq = true
     1969            and p-density = 1.0
     1970          )
     1971         or ( p-unit-base-cli-eq = false
     1972              and p-density <> ?
     1973              and p-density > 0.0
     1974              and p-density < 1.0
     1975            )
     1976       then do:
     1977         assign
     1978           v-answ = true
     1979         .
     1980       end.
     1981       else do:
     1982         assign
     1983           v-answ = false
     1984         .
     1985       end.
     1986       return v-answ.
     1987     end function.
