      572   define variable var-report-r-b as character no-undo .
      573   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      574   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      575     (output var-report-r-b
      576     )  .
      577   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      578   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      579   define  shared variable RepPathName        as character no-undo .
      580   define  shared variable PrintRubl          as logical   no-undo .
      581   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      582   define variable v-waitfram-action01         as character   no-undo .
      583   define variable v-waitfram-action02         as character   no-undo .
      584   define variable v-waitfram-action03         as character   no-undo .
      585   define variable mWaitFramTextBeg            as character   no-undo.
      586   define variable mWaitFramTextEnd            as character   no-undo.
      587   define variable mWaitFramView               as logical     no-undo.
      588   define variable mWaitProcEvent              as logical     no-undo init yes.
      589   define variable mWaitFramInterval           as integer     no-undo init 1 .
      590   define variable mWaitFramStop               as logical     no-undo.
      591   define variable mWaitFramStopUser           as logical     no-undo.
      592   define variable mWaitFramStopTimeOut        as logical     no-undo.
      593   define variable mWaitFramStartProc          as datetime-tz no-undo.
      594   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      595   define button B-WaitFramStop auto-end-key
      596        label "Стоп"
      597        size 10 by 1 tooltip "Остоновить процесс".
      598   define button B-viewProcInfo
      599        label "Информация"
      600        size 15 by 1 tooltip "Информация о процесс".
      601   define frame waitfram
      602     v-waitfram-action01 format "x(72)" no-label skip
      603     v-waitfram-action02 format "x(72)" no-label skip
      604     v-waitfram-action03 format "x(72)" no-label skip
      605     B-viewProcInfo
      606     B-WaitFramStop at row 4 col 30
      607     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      608     .
      609   define new global shared variable mBatchMode as logical no-undo init ?.
      610   define variable mFramBachModHandle as handle no-undo.
      611   mFramBachModHandle = frame waitfram:handle.
      612   define variable mFameOldVis as logical no-undo.
      613   define variable mVisCUrentVin as logical no-undo.
      614   if session:batch-mode
      615   then
      616      mBatchMode = yes.
      617   if mBatchMode = ? then do:
      618     mVisCUrentVin = current-window:visible.
      619     mFameOldVis = mFramBachModHandle:visible.
      620     mFramBachModHandle:visible  = yes.
      621     mBatchMode = mFramBachModHandle:visible ne yes.
      622     mFramBachModHandle:visible = mFameOldVis.
      623     current-window:visible = mVisCUrentVin.
      624   end.
      625    if  log-manager:logfile-name ne ?
      626     then DO:
      627         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      628         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      629         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      630     end.
      631   on choose of B-WaitFramStop in frame waitfram
      632   do:
      633     mWaitFramStop = yes.
      634     mWaitFramStopUser = yes.
      635   end.
      636   function waitfram-check-timeout returns logical():
      637      define variable vtime as int64 no-undo.
      638      if mWaitFramStopTimeOut
      639      then
      640         return yes.
      641      vtime = ( now - mWaitFramStartProc ) / 1000 .
      642      if     mWaitFramTimeOut ne ?
      643         and mWaitFramTimeOut ne 0
      644         and mWaitFramTimeOut lt vtime
      645      then do:
      646         mWaitFramStopTimeOut = yes.
      647      end.
      648      return mWaitFramStopTimeOut.
      649   end.
      650   procedure waitfram-hide :
      651     if not session:batch-mode
      652     then do
      653     on error undo, return error return-value
      654     :
      655       pause 0 before-hide .
      656       if not mBatchMode then
      657         hide frame waitfram .
      658     if     not mWaitFramView
      659        and mWaitProcEvent
      660     then
      661       process events .
      662     end.
      663   end procedure.
      664   procedure waitfram-show :
      665     define input  parameter p-message as character no-undo .
      666     define variable v-left-margin as integer   no-undo .
      667     if not session:batch-mode
      668     then do
      669     on error undo, return error return-value
      670     :
      671       if length(p-message) <= 70 then do:
      672         assign
      673           v-left-margin = integer((70 - length(p-message)) / 2)
      674         .
      675         assign
      676           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      677         .
      678         assign
      679           v-waitfram-action01 = " "
      680           v-waitfram-action02 = " "
      681                                    + fill(" ", v-left-margin)
      682                                    + p-message
      683           v-waitfram-action03 = " "
      684         .
      685       end.
      686       else do:
      687         define variable vRindex1 as integer no-undo.
      688         define variable vRindex2 as integer no-undo.
      689         vRindex1 = r-index(p-message," ",70).
      690         if vRindex1 = 0
      691         then
      692            vRindex1 = 70.
      693         if length(p-message)  <= vRindex1 + 70 then do:
      694           assign
      695             v-waitfram-action01 = " "
      696             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      697             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      698           .
      699         end.
      700         else do:
      701           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      702           if vRindex2 <= vRindex1
      703           then
      704              vRindex2 = vRindex1 + 70.
      705           assign
      706             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      707             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      708             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      709           .
      710         end.
      711       end.
      712       B-viewProcInfo:visible   in frame waitfram = no.
      713       B-viewProcInfo:sensitive in frame waitfram = no.
      714       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      715       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      716       if  (   mWaitFramView
      717          or  mWaitProcEvent)
      718          and not mBatchMode
      719       then
      720          display
      721             v-waitfram-action01 skip
      722             v-waitfram-action02 skip
      723             v-waitfram-action03 skip
      724          with frame waitfram .
      725       if     mWaitFramView
      726          then do:
      727             if     mWaitFramInterval ne ?
      728                and not mBatchMode
      729             then
      730                wait-for go of frame waitfram pause mWaitFramInterval.
      731          end.
      732          else
      733             if     mWaitProcEvent
      734                and not mBatchMode
      735             then
      736                process events .
      737     end.
      738   end procedure.
      739      procedure waitfram-show-this:
      740         define input  parameter iInterval as int64 no-undo.
      741         define variable vtime as int64 no-undo.
      742         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      743         mWaitFramInterval = iInterval.
      744         run waitfram-show (substitute("&1&2 &3&4" ,
      745                                       mWaitFramTextBeg ,
      746                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      747                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      748                                       mWaitFramTextEnd
      749                                      )
      750                           ).
      751      end.
      752      procedure WaitFramRunPause:
      753         define input  parameter iInterval as dec no-undo.
      754         define variable vStart  as datetime-tz no-undo.
      755         define variable vend    as datetime-tz no-undo.
      756         define variable vint as int64 no-undo.
      757         define variable vOk as logical no-undo.
      758         vStart = now.
      759         vend   = vStart.
      760         publish "WaitFramPause" (iInterval,output vOk).
      761         vend   =  now.
      762         vint = vend - vStart.
      763         vint = iInterval - vint / 1000.
      764         if     not mWaitFramStop
      765            and (   vint > 0
      766                 or (    not vOk
      767                     and iInterval eq ?
      768                     )
      769                 )
      770         then
      771            run waitfram-show-this (iInterval).
      772         vend   =  now.
      773         vint = vend - vStart.
      774         vint = iInterval - vint / 1000.
      775         if     not mWaitFramStop
      776            and vint > 0
      777         then do:
      778            run gbl/pause.p (vint * 1000).
      779         end.
      780         if iInterval ne ?
      781         then
      782            publish "WaitFramStop".
      783         waitfram-check-timeout().
      784      end.
      785      procedure WaitFramWaitFor:
      786         define input  parameter iInterval as dec no-undo.
      787         assign
      788            mWaitFramStartProc   = now
      789            mWaitFramStopUser    = no
      790            mWaitFramStopTimeOut = no
      791         .
      792         block-wait:
      793         do while not mWaitFramStop:
      794            run WaitFramRunPause (iInterval).
      795            if  waitfram-check-timeout()
      796            then do:
      797               leave block-wait.
      798            end.
      799         end.
      800         run waitfram-hide.
      801      end.
      802   procedure waitfram-join :
      803     define input  parameter p-line-1  as character no-undo .
      804     define input  parameter p-line-2  as character no-undo .
      805     define input  parameter p-line-3  as character no-undo .
      806     define output parameter p-message as character no-undo .
      807     do
      808     on error undo, return error return-value
      809     :
      810       assign
      811         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      812                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      813                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      814       .
      815     end.
      816   end procedure.
      817   function waitfram-join-function returns character
      818     (input p-line-1 as character
      819     ,input p-line-2 as character
      820     ,input p-line-3 as character
      821     ).
      822     define variable v-message as character no-undo .
      823     run waitfram-join in this-procedure
      824       (input  p-line-1
      825       ,input  p-line-2
      826       ,input  p-line-3
      827       ,output v-message
      828       ) .
      829     return v-message .
      830   end function .
      831   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      832   procedure factord :
      833     define input  parameter p-fact-date            as date    no-undo .
      834     define input  parameter p-fact-time            as integer no-undo .
      835     define input  parameter p-fact-num             as integer no-undo .
      836     define input  parameter p-shift-date           as date    no-undo .
      837     define input  parameter p-shift-num            as integer no-undo .
      838     define input  parameter p-shift-on             as logical no-undo .
      839     define output parameter p-fact-order           as decimal no-undo .
      840     define output parameter p-shift-end-fact-order as decimal no-undo .
      841     define output parameter p-day-end-fact-order   as decimal no-undo .
      842     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      843     if p-fact-date = ?
      844     then do:
      845       return error "Не указана фактическая дата" .
      846     end.
      847     define variable v-fact-date-num as integer no-undo .
      848     assign
      849       v-fact-date-num = integer(p-fact-date)
      850     .
      851     if p-fact-num = ?
      852     or p-fact-num = 0
      853     then do:
      854       return error "Не задан p-fact-num " + string(p-fact-num) .
      855     end.
      856     if p-fact-num < 0
      857     then do:
      858       return error "Отрицательный fact-num " + string(p-fact-num) .
      859     end.
      860     if p-fact-num >= 100000000
      861     then do:
      862       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      863     end.
      864     if p-shift-on = true
      865     then do:
      866       if p-shift-date = ?
      867       then do:
      868         return error "Не задана дата смены" .
      869       end.
      870       if p-shift-num = ?
      871       or p-shift-num = 0
      872       then do:
      873         return error "Не задан номер смены" .
      874       end.
      875     end.
      876     else do:
      877       assign
      878         p-shift-date = p-fact-date
      879         p-shift-num  = 24
      880       .
      881     end.
      882     define variable v-shift-offset as integer no-undo .
      883     if p-shift-date = p-fact-date
      884     then do:
      885       assign
      886         v-shift-offset = 1
      887       .
      888     end.
      889     if p-shift-date < p-fact-date
      890     then do:
      891       assign
      892         v-shift-offset = 0
      893       .
      894     end.
      895     if p-shift-date > p-fact-date
      896     then do:
      897       message
      898         vss-workfile vss-revision vss-description skip
      899         "Неправильная дата закрытия смены" skip
      900         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      901         view-as alert-box error .
      902       undo, return error
      903         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      904           ,string(p-fact-date, '99/99/9999':U)
      905           ,string(p-shift-date, '99/99/9999':U)
      906           )
      907       .
      908     end.
      909     if p-shift-num < 1
      910     or p-shift-num > 24
      911     then do:
      912       message
      913         vss-workfile vss-revision vss-description skip
      914         "Неправильный номер смены" skip
      915         "p-shift-num" p-shift-num skip
      916         view-as alert-box error .
      917       undo, return error return-value .
      918     end.
      919     assign
      920       p-fact-order           = v-fact-date-num
      921                              + v-shift-offset * 0.5
      922                              + p-shift-num    * 0.02 - 0.01
      923                              + p-fact-num     * 0.0000000001
      924       p-shift-end-fact-order = v-fact-date-num
      925                              + v-shift-offset * 0.5
      926                              + p-shift-num    * 0.02
      927       p-day-end-fact-order   = v-fact-date-num
      928                              + 0.99
      929     .
      930     if p-fact-order           <= v-fact-date-num
      931     or p-shift-end-fact-order <= v-fact-date-num
      932     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      933     or p-shift-end-fact-order >= p-day-end-fact-order
      934     then do:
      935       message
      936         vss-workfile vss-revision vss-description skip
      937         "Внутренняя ошибка при генерации фактического номера" skip
      938         "p-fact-date"            p-fact-date            skip
      939         "p-fact-time"            p-fact-time            skip
      940         "p-fact-num"             p-fact-num             skip
      941         "p-shift-date"           p-shift-date           skip
      942         "p-shift-num"            p-shift-num            skip
      943         "p-shift-on"             p-shift-on             skip
      944         "p-shift-end-fact-order" p-shift-end-fact-order skip
      945         "p-day-end-fact-order"   p-day-end-fact-order   skip
      946         "v-fact-date-num"        v-fact-date-num        skip
      947         view-as alert-box error .
      948       undo, return error return-value .
      949     end.
      950   end procedure.
      951   procedure day-begin-fact-order :
      952     define input  parameter p-fact-date            as date    no-undo .
      953     define output parameter p-day-begin-fact-order as decimal no-undo .
      954     do
      955     on error undo, return error return-value
      956     :
      957       if p-fact-date = ?
      958       then do:
      959         assign
      960           p-day-begin-fact-order = 0
      961         .
      962       end.
      963       else do:
      964         assign
      965           p-day-begin-fact-order = integer(p-fact-date)
      966         .
      967       end.
      968     end.
      969   end procedure.
      970   procedure factord-max-fact-order :
      971     define output parameter p-max-fact-order as decimal   no-undo .
      972     do
      973     on error undo, return error return-value
      974     :
      975       run day-begin-fact-order in this-procedure
      976         (input  date(1, 1, 5000)
      977         ,output p-max-fact-order
      978         ) .
      979     end.
      980   end procedure.
      981   procedure factord-cut-archive :
      982     define input  parameter p-obj-type             as character no-undo .
      983     define input  parameter p-obj-code             as integer   no-undo .
      984     define input  parameter p-fact-date            as date      no-undo .
      985     define output parameter p-shift-on             as logical   no-undo .
      986     define output parameter p-shift-date           as date      no-undo .
      987     define output parameter p-shift-num            as integer   no-undo .
      988     define output parameter p-day-end-fact-order   as decimal   no-undo .
      989     define output parameter p-shift-end-fact-order as decimal   no-undo .
      990     define variable v-fact-order as decimal   no-undo .
      991     define buffer buf_shift-obj for ub.shift-obj .
      992     do
      993     on error undo, return error return-value
      994     :
      995   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      996   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      997     (input  p-obj-type
      998     ,input  p-obj-code
      999     ,input  'shift-on=request'
     1000     ,output p-shift-on
     1001     ) no-error .
     1002       if error-status :error
     1003       then do:
     1004         message
     1005           vss-workfile vss-revision vss-description skip
     1006           "Ошибка при определении атрибута объекта" skip
     1007           "Объект" p-obj-type p-obj-code skip
     1008           error-status :get-message(1) skip
     1009           return-value skip
     1010           view-as alert-box error .
     1011         undo, return error return-value .
     1012       end.
     1013       if p-shift-on = false
     1014       then do:
     1015         assign
     1016           p-shift-date               = ?
     1017           p-shift-num                = 0
     1018         .
     1019       end.
     1020       else do:
     1021         find first buf_shift-obj share-lock
     1022           where buf_shift-obj.obj-type   = p-obj-type
     1023             and buf_shift-obj.obj-code   = p-obj-code
     1024             and buf_shift-obj.shift-date > p-fact-date
     1025           use-index pi
     1026           no-error .
     1027         if not available buf_shift-obj
     1028         or buf_shift-obj.status_ <> 'зкр':U
     1029         then do:
     1030           message
     1031             vss-workfile vss-revision vss-description skip
     1032             "Невозможно вычислить последнюю смену" skip
     1033             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1034             "Объект" p-obj-type p-obj-code skip
     1035             "Дата" p-fact-date skip
     1036             view-as alert-box error .
     1037           undo, return error return-value .
     1038         end.
     1039         find last buf_shift-obj share-lock
     1040           where buf_shift-obj.obj-type = p-obj-type
     1041             and buf_shift-obj.obj-code = p-obj-code
     1042             and buf_shift-obj.shift-date <= p-fact-date
     1043           use-index pi
     1044           no-error .
     1045         if available buf_shift-obj
     1046         then do:
     1047           if  buf_shift-obj.status_ = 'зкр':U
     1048           then do:
     1049             assign
     1050               p-shift-date = buf_shift-obj.shift-date
     1051               p-shift-num  = buf_shift-obj.shift-num
     1052             .
     1053           end.
     1054           else do:
     1055             message
     1056               vss-workfile vss-revision vss-description skip
     1057               "Невозможно вычислить последнюю смену" skip
     1058               "Статус смены отличен от статуса" 'зкр':U skip
     1059               "Объект" p-obj-type p-obj-code skip
     1060               "Дата" p-fact-date skip
     1061               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1062               view-as alert-box error .
     1063             undo, return error return-value .
     1064           end.
     1065         end.
     1066         else do:
     1067           assign
     1068             p-shift-date = p-fact-date - 1
     1069             p-shift-num  = 1
     1070           .
     1071         end.
     1072       end.
     1073       run factord in this-procedure
     1074         (input  p-fact-date
     1075         ,input  1
     1076         ,input  1
     1077         ,input  p-shift-date
     1078         ,input  p-shift-num
     1079         ,input  p-shift-on
     1080         ,output v-fact-order
     1081         ,output p-shift-end-fact-order
     1082         ,output p-day-end-fact-order
     1083         ) no-error .
     1084       if error-status :error
     1085       then do:
     1086         message
     1087           vss-workfile vss-revision vss-description skip
     1088           "Ошибка при вызове процедуры factord"
     1089           error-status :get-message(1) skip
     1090           return-value skip
     1091           view-as alert-box error .
     1092         undo, return error return-value .
     1093       end.
     1094     end.
     1095   end procedure.
     1096   procedure factord-lock-shift :
     1097     define input  parameter p-obj-type  as character no-undo .
     1098     define input  parameter p-obj-code  as integer   no-undo .
     1099     define input  parameter p-fact-date as date      no-undo .
     1100     define parameter buffer buf_shift-obj for ub.shift-obj .
     1101     define variable v-shift-on      as logical   no-undo .
     1102     define variable v-extra-message as character no-undo .
     1103     define variable v-error as character no-undo .
     1104     do
     1105     on error undo, return error return-value
     1106     :
     1107   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1108   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1109     (input  p-obj-type
     1110     ,input  p-obj-code
     1111     ,input  'shift-on=request'
     1112     ,output v-shift-on
     1113     ) no-error .
     1114       if error-status :error
     1115       then do:
     1116         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1117         undo, return error v-error .
     1118       end.
     1119       if v-shift-on = true
     1120       then do:
     1121         find first buf_shift-obj share-lock
     1122           where buf_shift-obj.obj-type   = p-obj-type
     1123             and buf_shift-obj.obj-code   = p-obj-code
     1124             and buf_shift-obj.shift-date > p-fact-date
     1125           use-index pi
     1126           no-error .
     1127         if not available buf_shift-obj
     1128         or buf_shift-obj.status_ <> 'зкр':U
     1129         then do:
     1130           find last buf_shift-obj
     1131             where buf_shift-obj.obj-type = p-obj-type
     1132               and buf_shift-obj.obj-code = p-obj-code
     1133               and buf_shift-obj.status_  = 'зкр':U
     1134             use-index stts
     1135             no-error .
     1136           if available buf_shift-obj
     1137           then do:
     1138             assign
     1139               v-extra-message =
     1140                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1141                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1142                               )
     1143             .
     1144           end.
     1145           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1146           undo, return error v-error .
     1147         end.
     1148       end.
     1149     end.
     1150   end procedure.
     1151   procedure factord-end-day :
     1152     define input  parameter p-fact-date            as date    no-undo .
     1153     define output parameter p-day-end-fact-order   as decimal no-undo .
     1154     do
     1155     on error undo, return error return-value
     1156     :
     1157       if p-fact-date = ?
     1158       then do:
     1159         return error "Не указана фактическая дата" .
     1160       end.
     1161       assign
     1162         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1163       .
     1164     end.
     1165   end procedure.
     1166   procedure factord-to-date :
     1167     define input  parameter p-fact-order as decimal no-undo .
     1168     define output parameter p-fact-date  as date    no-undo .
     1169     define variable v-ref-date  as date      no-undo .
     1170     define variable v-ref-delta as integer   no-undo .
     1171     do
     1172     on error undo, return error return-value
     1173     :
     1174       if p-fact-order = ?
     1175       or p-fact-order = 0
     1176       then do:
     1177         return error "Не указан fact-order" .
     1178       end.
     1179       assign
     1180         v-ref-date  = date(1, 1, 2000)
     1181       .
     1182       assign
     1183         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1184       .
     1185       assign
     1186         p-fact-date = v-ref-date + v-ref-delta
     1187       .
     1188     end.
     1189   end procedure.
     1190   procedure factord-to-fact-num :
     1191     define input  parameter p-fact-order as decimal no-undo .
     1192     define output parameter p-fact-num   as integer no-undo .
     1193     define variable v-fact-order-trunc as decimal no-undo .
     1194     do
     1195     on error undo, return error return-value
     1196     :
     1197       if p-fact-order = ?
     1198       or p-fact-order = 0
     1199       then do:
     1200         return error "Не указан fact-order" .
     1201       end.
     1202       assign
     1203        v-fact-order-trunc = truncate(p-fact-order, 2)
     1204       .
     1205       assign
     1206         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1207       .
     1208     end.
     1209   end procedure.
     1210   procedure factord-to-shift-num :
     1211     define input  parameter p-fact-order as decimal no-undo .
     1212     define output parameter p-shift-num   as integer no-undo .
     1213     define variable  p-shift-numd  as decimal   no-undo .
     1214     define variable v-fact-order-trunc as decimal no-undo .
     1215     do
     1216     on error undo, return error return-value
     1217     :
     1218       if p-fact-order = ?
     1219       or p-fact-order = 0
     1220       then do:
     1221         return error "Не указан fact-order" .
     1222       end.
     1223       assign
     1224        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1225       .
     1226       if v-fact-order-trunc < 0.5 then do:
     1227         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1228       end.
     1229       assign
     1230         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1231         .
     1232        assign
     1233         p-shift-num = truncate (p-shift-numd , 0)
     1234       .
     1235     end.
     1236   end procedure.
     1237   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1238   procedure cur-time :
     1239      define output parameter p-today as date      no-undo .
     1240      define output parameter p-time  as integer   no-undo .
     1241     do
     1242     on error undo, return error
     1243     :
     1244       define variable v-date1 as date      no-undo .
     1245       define variable v-date2 as date      no-undo .
     1246       define variable v-time  as integer   no-undo .
     1247       assign
     1248         v-date1 = today
     1249         v-time  = time
     1250         v-date2 = today
     1251       .
     1252       if v-date1 <> v-date2
     1253       then do:
     1254         assign
     1255           v-date1 = today
     1256           v-time  = v-time
     1257         .
     1258       end.
     1259       assign
     1260         p-today = v-date1
     1261         p-time  = v-time
     1262       .
     1263     end.
     1264   end.
     1265   function cur-time-date returns character
     1266   :
     1267     return string(today, '99/99/9999':U) .
     1268   end.
     1269   function cur-time-mjd returns decimal
     1270   :
     1271     define variable v-date as date      no-undo .
     1272     define variable v-time as integer   no-undo .
     1273     run cur-time in this-procedure
     1274       (output v-date
     1275       ,output v-time
     1276       ) .
     1277     return integer(v-date) - 2400002 + (v-time / 86400) .
     1278   end.
     1279   function cur-time-get-ending-index returns integer
     1280   (input p-number as integer
     1281   )
     1282   :
     1283     if p-number < 0
     1284     or p-number = ?
     1285     then do:
     1286       return 1 .
     1287     end.
     1288     define variable v-rest as integer   no-undo .
     1289     assign
     1290       p-number = p-number modulo 100
     1291     .
     1292     if p-number < 20
     1293     then do:
     1294       assign
     1295         v-rest = p-number
     1296       .
     1297     end.
     1298     else do:
     1299       assign
     1300         v-rest = p-number modulo 10
     1301       .
     1302     end.
     1303     case v-rest :
     1304       when 1
     1305       then do:
     1306         return 2 .
     1307       end.
     1308       when 2 or
     1309       when 3 or
     1310       when 4
     1311       then do:
     1312         return 3 .
     1313       end.
     1314       otherwise do:
     1315         return 1 .
     1316       end.
     1317     end case .
     1318   end.
     1319   procedure cur-time-mjd-to-date :
     1320      define input  parameter i-mjd-diff as decimal no-undo.
     1321      define output parameter o-Date     as date    no-undo.
     1322      define output parameter o-Time     as integer no-undo.
     1323      define variable v-day-number as integer   no-undo .
     1324      if    i-mjd-diff < 0
     1325         or i-mjd-diff = ?
     1326      then do:
     1327         return "?" .
     1328      end.
     1329      assign
     1330         v-day-number = truncate(i-mjd-diff,0).
     1331         o-Date = date(v-day-number + 2400002).
     1332         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1333     .
     1334   end.
     1335   function cur-time-mjd-to-string returns character
     1336   (input p-mjd-diff as decimal
     1337   )
     1338   :
     1339     define variable v-day-number as integer   no-undo .
     1340     define variable v-seconds    as integer   no-undo .
     1341     define variable v-hour       as integer   no-undo .
     1342     define variable v-min        as integer   no-undo .
     1343     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1344     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1345     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1346     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1347     if p-mjd-diff < 0
     1348     or p-mjd-diff = ?
     1349     then do:
     1350       return "?" .
     1351     end.
     1352     assign
     1353       v-day-number = integer(truncate(p-mjd-diff,0))
     1354       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1355     .
     1356     if v-seconds > 86400
     1357     then do:
     1358       assign
     1359         v-seconds = 86400 - 1
     1360       .
     1361     end.
     1362     if v-seconds < 0
     1363     then do:
     1364       assign
     1365         v-seconds = 0
     1366       .
     1367     end.
     1368     assign
     1369       v-hour = truncate(v-seconds / 3600, 0)
     1370     .
     1371     assign
     1372       v-seconds = v-seconds modulo 3600
     1373     .
     1374     assign
     1375       v-min = truncate(v-seconds / 60, 0)
     1376     .
     1377     assign
     1378       v-seconds = v-seconds modulo 60
     1379     .
     1380     return
     1381         (if v-day-number <> 0
     1382           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1383           else ""
     1384         )
     1385       + (if v-day-number <> 0 or v-hour <> 0
     1386           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1387           else ""
     1388         )
     1389       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1390           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1391           else ""
     1392         )
     1393       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1394       .
     1395   end.
     1396   function cur-time-string returns character
     1397   :
     1398     define variable v-date as date      no-undo .
     1399     define variable v-time as integer   no-undo .
     1400     run cur-time in this-procedure
     1401       (output v-date
     1402       ,output v-time
     1403       ) .
     1404     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1405   end.
     1406   function cur-time-string-sec returns character
     1407   :
     1408     define variable v-date as date      no-undo .
     1409     define variable v-time as integer   no-undo .
     1410     run cur-time in this-procedure
     1411       (output v-date
     1412       ,output v-time
     1413       ) .
     1414     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1415   end.
     1416   function cur-time-custom  returns character
     1417   (input p-prefix as character
     1418   ,input p-date-format as character
     1419   ,input p-delimiter as character
     1420   ,input p-time-format as character
     1421   ,input p-suffix as character
     1422   )
     1423   :
     1424     define variable v-date as date      no-undo .
     1425     define variable v-time as integer   no-undo .
     1426     run cur-time in this-procedure
     1427       (output v-date
     1428       ,output v-time
     1429       ) .
     1430     return
     1431       p-prefix
     1432       + string(v-date, p-date-format)
     1433       + p-delimiter
     1434       + string(v-time, p-time-format)
     1435       + p-suffix
     1436       .
     1437   end.
     1438   function cur-time-print  returns character
     1439   :
     1440     define variable v-date as date      no-undo .
     1441     define variable v-time as integer   no-undo .
     1442     run cur-time in this-procedure
     1443       (output v-date
     1444       ,output v-time
     1445       ) .
     1446     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1447   end.
     1448   function cur-time-datetime returns datetime
     1449   :
     1450     define variable v-char as character no-undo .
     1451     define variable v-datetime as datetime no-undo .
     1452     v-char = cur-time-string().
     1453     v-datetime = datetime(v-char).
     1454     return  v-datetime.
     1455   end.
     1456   function cur-time-string-msec returns character
     1457   :
     1458     define variable v-date as datetime  no-undo .
     1459     v-date = now.
     1460     return string(v-date) .
     1461   end.
     1462   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1463   procedure findtank:
     1464     define input  parameter p-obj-type     as character no-undo.
     1465     define input  parameter p-obj-code     as integer   no-undo.
     1466     define input  parameter p-pump-code    as integer   no-undo.
     1467     define input  parameter p-nozzle-code  as integer   no-undo .
     1468     define input  parameter p-from-pl-code as integer   no-undo .
     1469     define input  parameter p-gds-code     as integer   no-undo.
     1470     define output parameter p-pl-code      as integer   no-undo .
     1471     define variable v-pl-code            like ub.place.pl-code no-undo .
     1472     define variable v-dopstr             as character no-undo .
     1473     define buffer buf_place for ub.place.
     1474     define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1475     define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1476     define buffer buf_pl-gds for ub.pl-gds.
     1477     do
     1478     on error undo, return error return-value
     1479     :
     1480       assign
     1481         v-pl-code = 0
     1482         p-pl-code = ?
     1483       .
     1484       if p-from-pl-code <> ?
     1485         and p-from-pl-code <> 0
     1486       then do:
     1487         find first buf_pl-gds no-lock
     1488           where buf_pl-gds.obj-type  = p-obj-type
     1489             and buf_pl-gds.obj-code  = p-obj-code
     1490             and buf_pl-gds.pl-code   = p-from-pl-code
     1491             and buf_pl-gds.gds-code  = p-gds-code
     1492           no-error.
     1493         if available buf_pl-gds then do:
     1494           assign
     1495             v-pl-code = buf_pl-gds.pl-code
     1496           .
     1497         end.
     1498       end.
     1499       if v-pl-code <> 0
     1500         and p-nozzle-code <> ?
     1501         and p-nozzle-code <> 0
     1502       then do:
     1503         find first buf_pl-pump-nozzle no-lock
     1504           where buf_pl-pump-nozzle.obj-type    = p-obj-type
     1505             and buf_pl-pump-nozzle.obj-code    = p-obj-code
     1506             and buf_pl-pump-nozzle.pl-code     = v-pl-code
     1507             and buf_pl-pump-nozzle.pump-code   = p-pump-code
     1508             and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1509           no-error .
     1510         if not available buf_pl-pump-nozzle then do:
     1511           return.
     1512         end.
     1513       end.
     1514       if v-pl-code = 0 then do:
     1515         if p-nozzle-code = 0 then do:
     1516           find first buf_pl-gds-pump no-lock
     1517             where buf_pl-gds-pump.obj-type  = p-obj-type
     1518               and buf_pl-gds-pump.obj-code  = p-obj-code
     1519               and buf_pl-gds-pump.pump-code = p-pump-code
     1520               and buf_pl-gds-pump.gds-code  = p-gds-code
     1521               and buf_pl-gds-pump.status_   = 'тек':U
     1522             no-error.
     1523           if available buf_pl-gds-pump then do:
     1524             assign
     1525               v-pl-code = buf_pl-gds-pump.pl-code
     1526             .
     1527           end.
     1528         end.
     1529         else do:
     1530           _ppnz:
     1531           for each buf_pl-pump-nozzle no-lock
     1532             where buf_pl-pump-nozzle.obj-type = p-obj-type
     1533               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1534               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1535               and buf_pl-pump-nozzle.nozzle-code = p-nozzle-code
     1536             ,first buf_pl-gds-pump no-lock
     1537             where buf_pl-gds-pump.obj-type  = p-obj-type
     1538               and buf_pl-gds-pump.obj-code  = p-obj-code
     1539               and buf_pl-gds-pump.pump-code = p-pump-code
     1540               and buf_pl-gds-pump.gds-code  = p-gds-code
     1541               and buf_pl-gds-pump.status_   = 'тек':U
     1542               and buf_pl-gds-pump.pl-code   = buf_pl-pump-nozzle.pl-code
     1543           on error undo, return error return-value
     1544           :
     1545             assign
     1546               v-pl-code = buf_pl-pump-nozzle.pl-code
     1547             .
     1548             leave _ppnz.
     1549           end.
     1550         end.
     1551       end.
     1552       if v-pl-code <> 0 then do:
     1553         assign
     1554           p-pl-code = v-pl-code
     1555         .
     1556       end.
     1557     end.
     1558   end procedure.
     1559   procedure find-nzl:
     1560   define input  parameter p-obj-type   as character no-undo.
     1561   define input  parameter p-obj-code   as integer   no-undo.
     1562   define input  parameter p-pump-code  as integer   no-undo.
     1563   define input  parameter p-gds-code   as integer   no-undo.
     1564   define input  parameter p-pl-code    as integer no-undo .
     1565   define output parameter p-nozzle-code    as integer   no-undo.
     1566   define variable v-nozzle-code        like ub.nozzle.nozzle-code no-undo .
     1567   define variable v-pl-code            like ub.place.pl-code no-undo .
     1568   define variable v-pump-code          like ub.pump.pump-code no-undo .
     1569   define variable v-loc1-code          like ub.place.loc1 no-undo .
     1570   define variable v-dopstr             as character no-undo .
     1571   define buffer buf_place for ub.place.
     1572   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1573   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1574   define buffer buf_pl-gds for ub.pl-gds.
     1575   do on error undo, return error return-value :
     1576     v-pump-code = p-pump-code.
     1577     find first buf_pl-pump-nozzle no-lock where
     1578                   buf_pl-pump-nozzle.obj-type = p-obj-type
     1579               and buf_pl-pump-nozzle.obj-code = p-obj-code
     1580               and buf_pl-pump-nozzle.pump-code = p-pump-code
     1581               and buf_pl-pump-nozzle.pl-code = p-pl-code no-error.
     1582     if not available buf_pl-pump-nozzle then do:
     1583       assign
     1584       p-nozzle-code = ?.
     1585       return .
     1586     end.
     1587     assign
     1588     p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1589     return.
     1590     .
     1591   end.
     1592   end procedure.
     1593   procedure find-nzl-without-pl:
     1594   define input  parameter p-obj-type   as character no-undo.
     1595   define input  parameter p-obj-code   as integer   no-undo.
     1596   define input  parameter p-pump-code  as integer   no-undo.
     1597   define input  parameter p-gds-code   as integer   no-undo.
     1598   define output parameter p-nozzle-code    as integer   no-undo.
     1599   define buffer buf_pl-gds-pump for ub.pl-gds-pump.
     1600   define buffer buf_pl-gds for ub.pl-gds.
     1601   define buffer buf_pl-pump-nozzle for ub.pl-pump-nozzle.
     1602   do on error undo, return error return-value :
     1603     for each buf_pl-gds-pump no-lock where
     1604               buf_pl-gds-pump.obj-type  = p-obj-type
     1605           and buf_pl-gds-pump.obj-code  = p-obj-code
     1606           and buf_pl-gds-pump.pump-code = p-pump-code
     1607           and buf_pl-gds-pump.gds-code  = p-gds-code
     1608           and buf_pl-gds-pump.status_   = 'тек':U,
     1609         first buf_pl-gds no-lock where
     1610                   buf_pl-gds.obj-type = p-obj-type
     1611               AND buf_pl-gds.obj-code = p-obj-code
     1612               AND buf_pl-gds.pl-code = buf_pl-gds-pump.pl-code
     1613               AND buf_pl-gds.gds-code = p-gds-code
     1614               AND buf_pl-gds.status_ = 'тек':U,
     1615        first buf_pl-pump-nozzle no-lock where
     1616                 buf_pl-pump-nozzle.obj-type = p-obj-type
     1617             and buf_pl-pump-nozzle.obj-code = p-obj-code
     1618             and buf_pl-pump-nozzle.pl-code = buf_pl-gds.pl-code
     1619             and buf_pl-pump-nozzle.pump-code = p-pump-code:
     1620       assign
     1621       p-nozzle-code = buf_pl-pump-nozzle.nozzle-code.
     1622       return .
     1623     end.
     1624     assign
     1625     p-nozzle-code = ?.
     1626     return.
     1627     .
     1628   end.
     1629   end procedure.
