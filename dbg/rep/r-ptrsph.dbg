     3638                 , output v_text-indent
     3639                 , output v_excel-indent
     3640                 ) .
     3641               put stream text_out unformatted
     3642                 v_text-indent
     3643               .
     3644               if Make-Excel then  put   stream ForExcel unformatted
     3645                 v_excel-indent
     3646               .
     3647             end.
     3648             else do:
     3649               put stream text_out unformatted
     3650                 " ":U
     3651               .
     3652             end.
     3653             put stream text_out unformatted
     3654               string( d_sum-sale, "->,>>>,>>>,>>>,>>9.99":U )
     3655             .
     3656             if Make-Excel then  put   stream ForExcel unformatted
     3657               CHR(9)
     3658               string( d_sum-sale, "->>>>>>>>>>>>>>>>9.99":U )
     3659             .
     3660           end.
     3661           put stream text_out unformatted
     3662             skip Under_Line skip
     3663           .
     3664           if Make-Excel then  put   stream ForExcel unformatted
     3665             skip
     3666           .
     3667         end.
     3668         assign
     3669           d_sum-sale  = 0.00
     3670           d_base-qnty = 0.00
     3671         .
     3672         if last-of( tt_line.chk-date )
     3673         then do:
     3674           hide stream text_out frame Bottom_Page no-pause .
     3675         end.
     3676       end.
     3677     end.
     3678     hide stream text_out frame Bottom_Page no-pause .
     3679     output stream text_out close .
     3680     if Make-Excel then output stream ForExcel close.
     3681     run WaitFram-Hide in this-procedure .
     3682     if j_total-length > 136
     3683     then do:
     3684       run gbl/prnfilen.w
     3685         (
     3686             input  ""
     3687            ,input  8
     3688            ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     3689            ,input  7
     3690            ,output v-user-action
     3691            ,output v-printed
     3692         ) .
     3693     end.
     3694     else do:
