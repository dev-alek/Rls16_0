     3275                                                         and tt-rvs-line-pump-delta.gds-code    = buf_rvs-line-pump.gds-code
     3276                                                         and tt-rvs-line-pump-delta.pump-code   = buf_rvs-line-pump.pump-code
     3277                                                         and tt-rvs-line-pump-delta.nozzle-code = buf_rvs-line-pump.nozzle-code
     3278                                                         no-error .
     3279                     if not available tt-rvs-line-pump-delta
     3280                     then do :
     3281                       create tt-rvs-line-pump-delta .
     3282                       buffer-copy buf_rvs-line-pump to tt-rvs-line-pump-delta
     3283                       assign
     3284                         tt-rvs-line-pump-delta.rvs-code = "after-doc" + entry(2, buf_rvs-line-pump.rvs-code, "-")
     3285                         tt-rvs-line-pump-delta.is-err = yes
     3286                       .
     3287                     end .
     3288                     else do :
     3289                       tt-rvs-line-pump-delta.find-pair = yes .
     3290                       if tt-rvs-line-pump-delta.state-el-cnt > buf_rvs-line-pump.state-el-cnt
     3291                       then do :
     3292                         tt-rvs-line-pump-delta.is-err = yes .
     3293                       end .
     3294                       else do :
     3295                         tt-rvs-line-pump-delta.deltaVol = buf_rvs-line-pump.state-el-cnt - tt-rvs-line-pump-delta.state-el-cnt .
     3296                       end .
     3297                     end .
     3298                   end .
     3299                 end .
     3300               end .
     3301               assign
     3302                 tt-rep.col38 = tt-rep.col37 / tt-rep.col36
     3303                 tt-rep.col39 = tt-rep.col39 / v-num-com-tanks
     3304               .
     3305             end .
     3306             for each tt-rvs-line-pump-delta :
     3307               if not tt-rvs-line-pump-delta.find-pair
     3308               then do :
     3309                 tt-rvs-line-pump-delta.is-err = yes .
     3310               end .
     3311               if tt-rvs-line-pump-delta.is-err = yes
     3312               then do :
     3313                 tt-rvs-line-pump-delta.deltaVol = 0 .
     3314                 tt-rep.col35 = "Есть" .
     3315               end .
     3316               tt-rep.col33 = tt-rep.col33 + tt-rvs-line-pump-delta.deltaVol .
     3317             end .
     3318             assign tt-rep.col34 = tt-rep.col33 * v-avrg-dens .
     3319             assign
     3320               tt-rep.col29str = trim(tt-rep.col29str, "<br>" + chr(10))
     3321               tt-rep.col30str = trim(tt-rep.col30str, "<br>" + chr(10))
     3322               tt-rep.col31str = trim(tt-rep.col31str, "<br>" + chr(10))
     3323               tt-rep.col32str = trim(tt-rep.col32str, "<br>" + chr(10))
     3324               tt-rep.col36str = trim(tt-rep.col36str, "<br>" + chr(10))
     3325               tt-rep.col37str = trim(tt-rep.col37str, "<br>" + chr(10))
     3326               tt-rep.col38str = trim(tt-rep.col38str, "<br>" + chr(10))
     3327               tt-rep.col39str = trim(tt-rep.col39str, "<br>" + chr(10))
     3328             .
     3329           end .
     3330           if tt-rep.col34 = ? then tt-rep.col34 = 0 .
     3331           assign
     3332             tt-rep.col40  = v-InfoSection:FactQnty
     3333             tt-rep.col41  = v-InfoSection:FactKgQnty
     3334           .
     3335           if v-InfoSection:TankWeight > 0
     3336           then do :
     3337             assign
     3338               tt-rep.col42  = tt-rep.col25 - tt-rep.col21
     3339               tt-rep.col43  = tt-rep.col42 / tt-rep.col21 * 100
     3340             .
     3341             assign
     3342               tt-rep.col44  = tt-rep.col37 + tt-rep.col34 - tt-rep.col30 - tt-rep.col25
     3343               tt-rep.col45  = tt-rep.col44 / tt-rep.col25 * 100
     3344             .
     3345           end .
     3346           assign
     3347             tt-rep.col46  = tt-rep.col37 + tt-rep.col34 - tt-rep.col30 - tt-rep.col41
     3348             tt-rep.col47  = tt-rep.col46 / tt-rep.col41 * 100
     3349           .
     3350           v-delta-ac = sqrt(exp((tt-rep.col37 * tt-rep.delta-mass-qnty-after), 2) + exp((tt-rep.col30 * tt-rep.delta-mass-qnty-before), 2) + exp((tt-rep.col34 * 0.5), 2) + exp((tt-rep.col25 * tt-rep.delta-mass-qnty-ac), 2)) / 100 .
     3351           v-delta-fact = sqrt(exp((tt-rep.col37 * tt-rep.delta-mass-qnty-after), 2) + exp((tt-rep.col34 * 0.5), 2) + exp((tt-rep.col30 * tt-rep.delta-mass-qnty-before), 2)) / 100 .
     3352           if v-delta-ac > abs(tt-rep.col44)
     3353           then do :
     3354             tt-rep.col48 = 0 .
     3355           end .
     3356           else do :
     3357             tt-rep.col48 = abs(tt-rep.col44) - v-delta-ac .
     3358             if tt-rep.col44 < 0
     3359             then
     3360               tt-rep.col48 = tt-rep.col48 * -1
     3361             .
     3362           end .
     3363           if v-is-sug-gds
     3364           then do :
     3365             tt-rep.col48 = 0 .
     3366           end .
     3367           if v-delta-fact > abs(tt-rep.col46)
     3368           then do :
     3369             tt-rep.col49 = 0 .
     3370           end .
     3371           else do :
     3372             tt-rep.col49 = abs(tt-rep.col46) - v-delta-fact .
     3373             if tt-rep.col46 < 0
     3374             then
     3375               tt-rep.col49 = tt-rep.col49 * -1
     3376             .
     3377           end .
     3378         end .
     3379         else do :
     3380           if v-InfoSection:isKP
     3381           then do :
     3382             if v-InfoSection:AccMeth = 1
     3383             then do :
     3384               tt-rep.col50 = "Да (резервуар)" .
     3385             end .
     3386             else do :
     3387               tt-rep.col50 = "Да (АЦ)" .
     3388             end .
     3389           end .
     3390           if v-InfoSection:TankWeight > 0
     3391           and tt-rep.ac-measured = yes
     3392           then
     3393             tt-rep.ac-measured = yes
     3394           .
     3395           else
     3396             tt-rep.ac-measured = no
     3397           .
     3398           assign
     3399             tt-rep.col15 = tt-rep.col15 + "," + v-SectionName
     3400             tt-rep.col18 = tt-rep.col18 + "<br>" + chr(10) + (if v-sep = "АЦ без СЭП" then "" else if v-InfoSection:alarm-SGDKK then "ВУ" else "НУ")
     3401             tt-rep.col19 = tt-rep.col19 + "<br>" + chr(10) + v-InfoSection:AukKey
     3402           .
     3403           v-delta-mass-qnty-ac = v-InfoSection:AccPomi .
     3404           if v-delta-mass-qnty-ac = 0
     3405           or v-delta-mass-qnty-ac = ?
     3406           then do :
     3407             v-delta-mass-qnty-ac = v-InfoSectionsTotal:PercAcc .
     3408           end .
     3409           if v-delta-mass-qnty-ac = 0
     3410           or v-delta-mass-qnty-ac = ?
     3411           then do :
     3412             v-delta-mass-qnty-ac = 0.65 .
     3413           end .
     3414           if v-delta-mass-qnty-ac > 0.65 then v-delta-mass-qnty-ac = 0.65 .
     3415           assign
     3416             tt-rep.delta-mass-qnty-ac = tt-rep.delta-mass-qnty-ac + v-delta-mass-qnty-ac
     3417           .
     3418           assign
     3419             tt-rep.col20  = tt-rep.col20 + if v-InfoSection:DocVolume > 0 then v-InfoSection:DocVolume else v-InfoSection:DocQnty
     3420             tt-rep.col21  = tt-rep.col21 + v-InfoSection:CliQnty
     3421             tt-rep.col22  = tt-rep.col22 + v-InfoSection:DocDensity
     3422             tt-rep.col23  = tt-rep.col23 + v-InfoSection:TTNTemp
     3423           .
     3424           assign
     3425             tt-rep.col24  = tt-rep.col24 + (if v-InfoSection:TankVolPomi > 0 then v-InfoSection:TankVolPomi else v-InfoSection:TankVol)
     3426             tt-rep.col25  = tt-rep.col25 + v-InfoSection:TankWeight
     3427             tt-rep.col26  = tt-rep.col26 + v-InfoSection:NaturalLoss
     3428             tt-rep.col27  = tt-rep.col27 + (if v-InfoSection:TankDensityPomi > 0 then v-InfoSection:TankDensityPomi else v-InfoSection:TankDensity)
     3429             tt-rep.col28  = tt-rep.col28 + v-InfoSection:TankTemp
     3430           .
     3431           assign
     3432             tt-rep.col20str = tt-rep.col20str + "<br>" + chr(10) + fDec2Str((if v-InfoSection:DocVolume > 0 then v-InfoSection:DocVolume else v-InfoSection:DocQnty), "->>>>>>>>>>>9"  )
     3433             tt-rep.col21str = tt-rep.col21str + "<br>" + chr(10) + fDec2Str(v-InfoSection:CliQnty, "->>>>>>>>>>>9.9")
     3434             tt-rep.col22str = tt-rep.col22str + "<br>" + chr(10) + fDec2Str(v-InfoSection:DocDensity, "->>>>>>>>9.9999")
     3435             tt-rep.col23str = tt-rep.col23str + "<br>" + chr(10) + fDec2Str(v-InfoSection:TTNTemp, "->>>>>>>>>>>9.9")
     3436             tt-rep.col24str = tt-rep.col24str + "<br>" + chr(10) + fDec2Str((if v-InfoSection:TankVolPomi > 0 then v-InfoSection:TankVolPomi else v-InfoSection:TankVol), "->>>>>>>>>>>9"  )
     3437             tt-rep.col25str = tt-rep.col25str + "<br>" + chr(10) + fDec2Str(v-InfoSection:TankWeight, "->>>>>>>>>>>9.9")
     3438             tt-rep.col26str = tt-rep.col26str + "<br>" + chr(10) + fDec2Str(v-InfoSection:NaturalLoss, "->>>>>>>>>>9.99")
     3439             tt-rep.col27str = tt-rep.col27str + "<br>" + chr(10) + fDec2Str((if v-InfoSection:TankDensityPomi > 0 then v-InfoSection:TankDensityPomi else v-InfoSection:TankDensity), "->>>>>>>>9.9999")
     3440             tt-rep.col28str = tt-rep.col28str + "<br>" + chr(10) + fDec2Str(v-InfoSection:TankTemp, "->>>>>>>>>>>9.9")
     3441           .
     3442           assign
     3443             tt-rep.col40  = tt-rep.col40 + v-InfoSection:FactQnty
     3444             tt-rep.col41  = tt-rep.col41 + v-InfoSection:FactKgQnty
     3445           .
     3446           if tt-rep.ac-measured
     3447           then do :
     3448             assign
     3449               tt-rep.col42  = tt-rep.col25 - tt-rep.col21
     3450               tt-rep.col43  = tt-rep.col42 / tt-rep.col21 * 100
     3451             .
     3452             assign
     3453               tt-rep.col44  = tt-rep.col37 + tt-rep.col34 - tt-rep.col30 - tt-rep.col25
     3454               tt-rep.col45  = tt-rep.col44 / tt-rep.col25 * 100
     3455             .
     3456           end .
     3457           else do :
     3458             assign
     3459               tt-rep.col42  = 0
     3460               tt-rep.col43  = 0
     3461               tt-rep.col44  = 0
     3462               tt-rep.col45  = 0
     3463             .
     3464           end .
     3465           assign
     3466             tt-rep.col46  = tt-rep.col37 + tt-rep.col34 - tt-rep.col30 - tt-rep.col41
     3467             tt-rep.col47  = tt-rep.col46 / tt-rep.col41 * 100
     3468           .
     3469         end .
     3470       end .
     3471       delete object v-InfoSectionsTotal no-error .
     3472       for each tt-rep where tt-rep.obj-type   = obj-list.obj-type
     3473                         and tt-rep.obj-code   = obj-list.obj-code
     3474                         and tt-rep.gds-code   = buf_goods.gds-code
     3475                         and tt-rep.col3       = buf_trn-doc.doc-code
     3476                         and num-entries(tt-rep.col15) > 1
     3477       :
     3478         assign
     3479           tt-rep.col22  = tt-rep.col22 / num-entries(tt-rep.col15)
     3480           tt-rep.col23  = tt-rep.col23 / num-entries(tt-rep.col15)
     3481           tt-rep.col27  = tt-rep.col27 / num-entries(tt-rep.col15)
     3482           tt-rep.col28  = tt-rep.col28 / num-entries(tt-rep.col15)
     3483         .
     3484         assign
     3485           tt-rep.delta-mass-qnty-ac = tt-rep.delta-mass-qnty-ac / num-entries(tt-rep.col15)
     3486         .
     3487         v-delta-ac = sqrt(exp((tt-rep.col37 * tt-rep.delta-mass-qnty-after), 2) + exp((tt-rep.col30 * tt-rep.delta-mass-qnty-before), 2) + exp((tt-rep.col34 * 0.5), 2) + exp((tt-rep.col25 * tt-rep.delta-mass-qnty-ac), 2)) / 100 .
     3488         v-delta-fact = sqrt(exp((tt-rep.col37 * tt-rep.delta-mass-qnty-after), 2) + exp((tt-rep.col34 * 0.5), 2) + exp((tt-rep.col30 * tt-rep.delta-mass-qnty-before), 2)) / 100 .
     3489         if v-delta-ac > abs(tt-rep.col44)
     3490         then do :
     3491           tt-rep.col48 = 0 .
     3492         end .
     3493         else do :
     3494           tt-rep.col48 = abs(tt-rep.col44) - v-delta-ac .
     3495           if tt-rep.col44 < 0
     3496           then
     3497             tt-rep.col48 = tt-rep.col48 * -1
     3498           .
     3499         end .
     3500         if v-is-sug-gds
     3501         then do :
     3502           tt-rep.col48 = 0 .
     3503         end .
     3504         if v-delta-fact > abs(tt-rep.col46)
     3505         then do :
     3506           tt-rep.col49 = 0 .
     3507         end .
     3508         else do :
     3509           tt-rep.col49 = abs(tt-rep.col46) - v-delta-fact .
     3510           if tt-rep.col46 < 0
     3511           then
     3512             tt-rep.col49 = tt-rep.col49 * -1
     3513           .
     3514         end .
     3515       end .
     3516     end .
     3517   end procedure .
     3518   procedure calc-itog :
     3519     for each tt-rep :
     3520       tt-rep.no-itog = no .
     3521       if iDelta-tank-ac
     3522       and iDelta-tank-fact
     3523       then do :
     3524         if tt-rep.col48 = 0
     3525         and tt-rep.col49 = 0
     3526         then tt-rep.no-itog = yes .
     3527       end .
     3528       else
     3529       if iDelta-tank-ac
     3530       then do :
     3531         if tt-rep.col48 = 0 then tt-rep.no-itog = yes .
     3532       end .
     3533       else
     3534       if iDelta-tank-fact
     3535       then do :
     3536         if tt-rep.col49 = 0 then tt-rep.no-itog = yes .
     3537       end .
     3538       if iTranTimeMax > 0
     3539       then do :
     3540         if tt-rep.min-pour <= iTranTimeMax then tt-rep.no-itog = yes .
     3541       end .
     3542       if (iTrkErr = 2 and tt-rep.col35 = "Нет")
     3543       or (iTrkErr = 3 and tt-rep.col35 = "Есть")
     3544       then do :
     3545         tt-rep.no-itog = yes .
     3546       end .
     3547     end .
     3548     for each tt-rep where not tt-rep.no-itog :
     3549       if not i-NoAzkItog
     3550       then do :
     3551         find first tt-itog where tt-itog.obj-type = tt-rep.obj-type
     3552                              and tt-itog.obj-code = tt-rep.obj-code
     3553                              no-error .
     3554         if not available tt-itog
     3555         then do :
     3556           create tt-itog .
     3557           assign
     3558             tt-itog.obj-type = tt-rep.obj-type
     3559             tt-itog.obj-code = tt-rep.obj-code
     3560             tt-itog.col1     = tt-rep.col1
     3561             tt-itog.col43red = no
     3562             tt-itog.col45red = no
     3563             tt-itog.col47red = no
     3564           .
     3565         end .
     3566         assign
     3567           tt-itog.col20 = tt-itog.col20 + tt-rep.col20
     3568           tt-itog.col21 = tt-itog.col21 + tt-rep.col21
     3569           tt-itog.col24 = tt-itog.col24 + (if tt-rep.col24 = ? then 0 else tt-rep.col24)
     3570           tt-itog.col25 = tt-itog.col25 + (if tt-rep.col25 = ? then 0 else tt-rep.col25)
     3571           tt-itog.col26 = tt-itog.col26 + (if tt-rep.col26 = ? then 0 else tt-rep.col26)
     3572           tt-itog.col29 = tt-itog.col29 + (if tt-rep.col29 = ? then 0 else tt-rep.col29)
     3573           tt-itog.col30 = tt-itog.col30 + (if tt-rep.col30 = ? then 0 else tt-rep.col30)
     3574           tt-itog.col33 = tt-itog.col33 + (if tt-rep.col33 = ? then 0 else tt-rep.col33)
     3575           tt-itog.col34 = tt-itog.col34 + (if tt-rep.col34 = ? then 0 else tt-rep.col34)
     3576           tt-itog.col36 = tt-itog.col36 + (if tt-rep.col36 = ? then 0 else tt-rep.col36)
     3577           tt-itog.col37 = tt-itog.col37 + (if tt-rep.col37 = ? then 0 else tt-rep.col37)
     3578           tt-itog.col40 = tt-itog.col40 + tt-rep.col40
     3579           tt-itog.col41 = tt-itog.col41 + tt-rep.col41
     3580           tt-itog.col42 = tt-itog.col42 + (if tt-rep.col42 = ? then 0 else tt-rep.col42)
     3581           tt-itog.col43 = tt-itog.col42 / tt-itog.col21 * 100
     3582           tt-itog.col44 = tt-itog.col44 + (if tt-rep.col44 = ? then 0 else tt-rep.col44)
     3583           tt-itog.col45 = tt-itog.col44 / tt-itog.col25 * 100
     3584           tt-itog.col46 = tt-itog.col46 + (if tt-rep.col46 = ? then 0 else tt-rep.col46)
     3585           tt-itog.col47 = tt-itog.col46 / tt-itog.col41 * 100
     3586           tt-itog.col48 = tt-itog.col48 + (if tt-rep.col48 = ? then 0 else tt-rep.col48)
     3587           tt-itog.col49 = tt-itog.col49 + (if tt-rep.col49 = ? then 0 else tt-rep.col49)
     3588         .
     3589       end .
     3590       find first tt-all-itog no-error .
     3591       if not available tt-all-itog
     3592       then do :
     3593         create tt-all-itog .
     3594         assign
     3595           tt-all-itog.col43red = no
     3596           tt-all-itog.col45red = no
     3597           tt-all-itog.col47red = no
     3598         .
     3599       end .
     3600       assign
     3601         tt-all-itog.col20 = tt-all-itog.col20 + tt-rep.col20
     3602         tt-all-itog.col21 = tt-all-itog.col21 + tt-rep.col21
     3603         tt-all-itog.col24 = tt-all-itog.col24 + (if tt-rep.col24 = ? then 0 else tt-rep.col24)
     3604         tt-all-itog.col25 = tt-all-itog.col25 + (if tt-rep.col25 = ? then 0 else tt-rep.col25)
     3605         tt-all-itog.col26 = tt-all-itog.col26 + (if tt-rep.col26 = ? then 0 else tt-rep.col26)
     3606         tt-all-itog.col29 = tt-all-itog.col29 + (if tt-rep.col29 = ? then 0 else tt-rep.col29)
     3607         tt-all-itog.col30 = tt-all-itog.col30 + (if tt-rep.col30 = ? then 0 else tt-rep.col30)
     3608         tt-all-itog.col33 = tt-all-itog.col33 + (if tt-rep.col33 = ? then 0 else tt-rep.col33)
     3609         tt-all-itog.col34 = tt-all-itog.col34 + (if tt-rep.col34 = ? then 0 else tt-rep.col34)
     3610         tt-all-itog.col36 = tt-all-itog.col36 + (if tt-rep.col36 = ? then 0 else tt-rep.col36)
     3611         tt-all-itog.col37 = tt-all-itog.col37 + (if tt-rep.col37 = ? then 0 else tt-rep.col37)
     3612         tt-all-itog.col40 = tt-all-itog.col40 + tt-rep.col40
     3613         tt-all-itog.col41 = tt-all-itog.col41 + tt-rep.col41
     3614         tt-all-itog.col42 = tt-all-itog.col42 + (if tt-rep.col42 = ? then 0 else tt-rep.col42)
     3615         tt-all-itog.col43 = tt-all-itog.col42 / tt-all-itog.col21 * 100
     3616         tt-all-itog.col44 = tt-all-itog.col44 + (if tt-rep.col44 = ? then 0 else tt-rep.col44)
     3617         tt-all-itog.col45 = tt-all-itog.col44 / tt-all-itog.col25 * 100
     3618         tt-all-itog.col46 = tt-all-itog.col46 + (if tt-rep.col46 = ? then 0 else tt-rep.col46)
     3619         tt-all-itog.col47 = tt-all-itog.col46 / tt-all-itog.col41 * 100
     3620         tt-all-itog.col48 = tt-all-itog.col48 + (if tt-rep.col48 = ? then 0 else tt-rep.col48)
     3621         tt-all-itog.col49 = tt-all-itog.col49 + (if tt-rep.col49 = ? then 0 else tt-rep.col49)
     3622       .
     3623       if abs(tt-rep.col43) > tt-rep.delta-mass-qnty-ac
     3624       then do :
     3625         assign
     3626           tt-itog.col43red = yes when available tt-itog
     3627           tt-all-itog.col43red = yes
     3628         .
     3629       end .
     3630       if abs(tt-rep.col45) > 0.65
     3631       then do :
     3632         assign
     3633           tt-itog.col45red = yes when available tt-itog
     3634           tt-all-itog.col45red = yes
     3635         .
     3636       end .
     3637       if abs(tt-rep.col47) > 0.65
     3638       then do :
     3639         assign
     3640           tt-itog.col47red = yes when available tt-itog
     3641           tt-all-itog.col47red = yes
     3642         .
     3643       end .
     3644     end .
     3645   end procedure .
     3646   procedure PrintTT:
     3647      define variable vReportId     as character no-undo.
     3648      define variable vFileNameRep  as character no-undo.
     3649      define variable vStr          as character no-undo.
     3650      define variable vI            as integer   no-undo.
     3651      do on error undo, return error return-value:
     3652         run get-report-num(output vReportId).
     3653         vFileNameRep = session:temp-directory + string(vReportId) + ".html".
     3654         output stream sOutStr-html to value(vFileNameRep) convert target 'UTF-8'.
     3655         put stream sOutStr-html unformatted
     3656   "<!DOCTYPE HTML>" skip
     3657   ' <html>' skip
     3658   '  <head>' skip
     3659   '   <meta charset="utf-8">' skip
     3660   '    <style type="text/css">' skip
