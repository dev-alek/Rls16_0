       15   define variable vss-author      as character     no-undo init "$ $":U .
       16   define variable vss-date        as character     no-undo init "$ $":U .
       17   define variable vss-workfile    as character     no-undo init "$ $":U .
       18   define variable vss-archive     as character     no-undo init "$ $":U .
       19   define variable vss-description as character     no-undo init "Сводный отчёт по поставкам НП".
