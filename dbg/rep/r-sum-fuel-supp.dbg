     1927   procedure BeforeCalc:
     1928      define variable vI       as integer   no-undo.
     1929      define variable vJ       as integer   no-undo.
     1930      define variable vStr     as character no-undo.
     1931      define variable vChkCode as character no-undo.
     1932      if x-tog-shift then do:
     1933        vI = vI + 1.
     1934        mParamStr[vI] = "По сменам: c " + string(X-shift-start) + " по " + string(X-shift-end).
     1935      end.
     1936      vI = vI + 1.
     1937      if X-date-start = X-date-end then
     1938        mParamStr[vI] = "За дату : " + string(X-date-start, "99.99.9999").
     1939      else
     1940        mParamStr[vI] = "За период c " + string(X-date-start, "99.99.9999") + " по " + string(X-date-end, "99.99.9999").
     1941      vI = vI + 1.
     1942      mParamStr[vI] = "Выбор объекта: ".
     1943      for each obj-list:
     1944        mParamStr[vI] = mParamStr[vI] + obj-list.obj-name + "," .
     1945      end.
     1946      mParamStr[vI] = trim(mParamStr[vI], ",").
     1947      vI = vI + 1.
     1948      if iGdsCodeList = "*" then do:
     1949        mParamStr[vI] = "Вся номенклатура".
     1950        mProdBcStrList = "*".
     1951      end.
     1952      else do:
     1953        mParamStr[vI] = "Номенклатура: ".
     1954        vStr = "".
     1955        for each goods where
     1956                  can-do(iGdsCodeList, string(goods.gds-code))
     1957        no-lock:
     1958          vStr = vStr + "," + string(goods.gds-code) + "(" + goods.gds-name + ")".
     1959          for each prod-bc where
     1960                   prod-bc.b-code = goods.gds-code
     1961          no-lock:
     1962            mProdBcStrList = mProdBcStrList + "," + prod-bc.b-str.
     1963          end.
     1964        end.
     1965        vStr = trim(vStr, ",").
     1966        mProdBcStrList = trim(mProdBcStrList, ",").
     1967        mParamStr[vI] = mParamStr[vI] + vStr.
     1968      end.
     1969      vI = vI + 1.
     1970      if iSuppsList = "*" then do:
     1971        mParamStr[vI] = "Все поставщики".
     1972        mSuppStrList = "*".
     1973      end.
     1974      else do:
     1975        mParamStr[vI] = "Поставщики: ".
     1976        vStr = "".
     1977        for each clients where can-do(iSuppsList, string(clients.obj-code))
     1978                           and clients.obj-type = "орг"
     1979        no-lock:
     1980          vStr = vStr + ", Орг" + string(clients.obj-code) + " " + clients.obj-name + "".
     1981        end.
     1982        vStr = trim(vStr, ", ").
     1983        mParamStr[vI] = mParamStr[vI] + vStr.
     1984      end.
     1985      if iTranTimeMax > 0
     1986      then do:
     1987        vI = vI + 1.
     1988        mParamStr[vI] = "Только со временем слива секции НП более " + string(iTranTimeMax) + " минут".
     1989      end.
     1990      if iDelta-tank-ac
     1991      and iDelta-tank-fact
     1992      then do :
     1993        vI = vI + 1.
     1994        mParamStr[vI] = "Только со сверхнормативным расхождением между резервуаром и АЦ, либо между резервуаром и принятым НП".
     1995      end.
     1996      else
     1997      if iDelta-tank-ac
     1998      then do :
     1999        vI = vI + 1.
     2000        mParamStr[vI] = "Только со сверхнормативным расхождением между резервуаром и АЦ".
     2001      end.
     2002      else
     2003      if iDelta-tank-fact
     2004      then do :
     2005        vI = vI + 1.
     2006        mParamStr[vI] = "Только со сверхнормативным расхождением между резервуаром и принятым НП".
     2007      end.
     2008      vI = vI + 1.
     2009      if i-Itog
     2010      then do :
     2011        mParamStr[vI] = "Только итоги".
     2012      end .
     2013      else do :
     2014        mParamStr[vI] = "В т.ч. итоги".
     2015      end .
     2016      vI = vI + 1.
     2017      mPrim1[1] = "Объем в ИТОГО: отображается в виде справочной информации." .
     2018      mPrim1[2] = "<u>Расчет отклонения АЦ к ТТН</u> " + fill("&nbsp;" , 11) + " <u>Расчет отклонения резервуара к АЦ</u>" .
     2019      mPrim1[3] = "Масса = (1.25-1.21)      " + fill("&nbsp;" , 28) + "Масса = ((1.37+1.34)-1.30)-1.25" .
     2020      mPrim1[4] = "% = (1.42/1.21*100)      " + fill("&nbsp;" , 28) + "% = (1.44/1.25*100)" .
     2021      mPrim1[5] = "<u>Расчет отклонения между резервуаром и принятым к учету топливом</u>" .
     2022      mPrim1[6] = "Масса = ((1.37+1.34)-1.30)-1.41" .
     2023      mPrim1[7] = "% = (1.46/1.41*100)" .
     2024      mPrim2[1] = "Расчет сверхнормативного расхождения между резервуаром и АЦ" .
     2025      mPrim2[2] = "Если 1.44 < 0 1.44+Корень((1.37*Пр)^2+(1.30*Пр)^2+(1.34*Птрк)^2+(1.25*Пац)^2)/100" .
     2026      mPrim2[3] = "Если 1.44 > 0 1.44-Корень((1.37*Пр)^2+(1.30*Пр)^2+(1.34*Птрк)^2+(1.25*Пац)^2)/100" .
     2027      mPrim2[4] = "Пр - относительная погрешность измерения массы нефтепродукта в резервуаре (в сверках)" .
     2028      mPrim2[5] = "Пац - погрешность измерения массы в АЦ" .
     2029      mPrim2[6] = "Результат расчета округляется до десятых." .
     2030      mPrim2[7] = "Птрк - погрешность ТРК, равная 0,5%" .
     2031      mPrim3[1] = "Расчет сверхнормативного расхождения между резервуаром и принятым к учету топливом" .
     2032      mPrim3[2] = "Если 1.46 < 0 1.46+Корень((1.37*Пр)^2+(1.34*Птрк)^2+(1.30*Пр)^2)/100" .
     2033      mPrim3[3] = "Если 1.46 > 0 1.46-Корень((1.37*Пр)^2+(1.34*Птрк)^2+(1.30*Пр)^2)/100" .
     2034      mPrim3[4] = "Пр - относительная погрешность измерения массы нефтепродукта в резервуаре (в сверках)" .
     2035      mPrim3[5] = "Результат расчета округляется до десятых." .
     2036      mPrim3[6] = "Птрк - погрешность ТРК, равная 0,5%" .
     2037   end procedure.
     2038   procedure initTT :
     2039     define buffer buf_trn-doc       for ub.trn-doc .
     2040     for each obj-list :
     2041       if x-TOG-Shift
     2042       then do :
     2043         for each buf_trn-doc no-lock where buf_trn-doc.obj-type     = obj-list.obj-type
     2044                                        and buf_trn-doc.obj-code     = obj-list.obj-code
     2045                                        and buf_trn-doc.ext-doc-type = 'ie':U
     2046                                        and buf_trn-doc.status_      = 'факт':U
     2047                                        and can-do(iSuppsList, string(buf_trn-doc.cli-code))
     2048                                        and (buf_trn-doc.shift-date > X-date-Start or (buf_trn-doc.shift-date = X-date-Start and buf_trn-doc.shift-num >= x-Shift-Start))
     2049                                        and (buf_trn-doc.shift-date < X-date-End or (buf_trn-doc.shift-date = X-date-End and buf_trn-doc.shift-num <= x-Shift-End))
     2050         :
     2051           run processTrn(input buf_trn-doc.doc-code) .
     2052         end .
     2053       end .
     2054       else do :
     2055         for each buf_trn-doc no-lock where buf_trn-doc.obj-type     = obj-list.obj-type
     2056                                        and buf_trn-doc.obj-code     = obj-list.obj-code
     2057                                        and buf_trn-doc.ext-doc-type = 'ie':U
     2058                                        and buf_trn-doc.status_      = 'факт':U
     2059                                        and can-do(iSuppsList, string(buf_trn-doc.cli-code))
     2060                                        and buf_trn-doc.fact-date >= X-date-Start
     2061                                        and buf_trn-doc.fact-date <= X-date-End
     2062         :
     2063           run processTrn(input buf_trn-doc.doc-code) .
     2064         end .
     2065       end .
     2066     end .
     2067   end procedure .
