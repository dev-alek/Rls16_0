     4066         output stream sOutStr-html close.
     4067         run prn-lib-reportviewer in this-procedure (
     4068             input parparentproc
     4069             ,input vFileNameRep
     4070             ,input ""
     4071             ) no-error.
     4072         if error-status:error then
     4073         do:
     4074             message return-value view-as alert-box.
     4075             return .
     4076         end.
     4077      end.
     4078   end procedure.
     4079   PROCEDURE get-report-num :
     4080     define output parameter p-report-num as integer no-undo .
     4081     do
     4082       on error undo, return error return-value
     4083       :
     4084       run gbl/getrpnum.p (output p-report-num).
     4085     end.
     4086   END PROCEDURE.
