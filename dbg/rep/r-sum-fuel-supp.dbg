      603   FUNCTION gbclcode-is-this-db-code returns logical ( input p-db-num as integer
      604                                                       ,input p-range-type as character
      605                                                       ,input p-code as integer):
      606   define variable v-seq-val as integer no-undo .
      607   define buffer buf_code-range for ub.code-range.
      608   find first buf_code-range no-lock where
      609             buf_code-range.db-num = p-db-num
      610       and  buf_code-range.range-type = p-range-type
      611       and  buf_code-range.stts = 'u'
      612       and buf_code-range.first-code <= p-code
      613       and buf_code-range.last-code >= p-code no-error .
      614   if available buf_code-range then return yes.
      615   CASE p-range-type:
      616     when 'pngb':U then do:
      617       v-seq-val = current-value(s-pngb-code, ub).
      618     end.
      619     when 'fmgb':U then do:
      620       v-seq-val = current-value(s-fmgb-code, ub).
      621     end.
      622   END CASE.
      623   if p-code <= v-seq-val then do:
      624     find first buf_code-range no-lock where
      625               buf_code-range.db-num = p-db-num
      626         and  buf_code-range.range-type = p-range-type
      627         and  buf_code-range.stts = 'a'
      628         and buf_code-range.first-code <= p-code
      629         no-error .
      630    if available buf_code-range then return yes.
      631   end.
      632   find first buf_code-range no-lock where
      633             buf_code-range.db-num = p-db-num
      634       and  buf_code-range.range-type = p-range-type
      635       and  buf_code-range.stts = 'f'
      636       and buf_code-range.first-code <= p-code
      637       and buf_code-range.last-code >= p-code
      638       no-error .
      639   if available buf_code-range then return yes.
      640   return no.
      641   END FUNCTION.
      642   FUNCTION gbclcode-is-this-db-code-short returns logical ( input p-db-num as integer
      643                                                       ,input p-range-type as character
      644                                                       ,input p-code as integer):
      645   define variable v-seq-val as integer no-undo .
      646   define buffer buf_code-range for ub.code-range.
      647   CASE p-range-type:
      648     when 'pngb':U then do:
      649       v-seq-val = current-value(s-pngb-code, ub).
      650     end.
      651     when 'fmgb':U then do:
      652       v-seq-val = current-value(s-fmgb-code, ub).
      653     end.
      654   END CASE.
      655   if p-code <= v-seq-val then do:
      656     find first buf_code-range no-lock where
      657               buf_code-range.db-num = p-db-num
      658         and  buf_code-range.range-type = p-range-type
      659         and buf_code-range.first-code <= p-code
      660         and buf_code-range.last-code >= p-code no-error .
      661     if available buf_code-range then return yes.
      662   end.
      663   return no.
      664   END FUNCTION.
      665   FUNCTION gbclcode-is-this-db-role returns integer ( input p-role as character
      666                                                       ,input p-db-num as integer
      667                                                       ,input p-staff-code as integer
      668                                                       ,input p-date as date
      669                                                        ):
      670   define buffer buf_staff for ub.staff.
      671   if p-date = ? then do:
      672     p-date = today .
      673   end.
      674   find first buf_staff no-lock where
      675             buf_staff.role = p-role
      676         and buf_staff.role-level = 'db':U
      677         and buf_staff.db-num = p-db-num
      678         and buf_staff.staff-code = p-staff-code
      679         and buf_staff.date-end >= p-date use-index pi  no-error .
      680   if available buf_staff then do:
      681     return buf_staff.psn-code.
      682   end.
      683   return 0.
      684   end FUNCTION.
      685   FUNCTION gbclcode-get-this-db-first-role returns integer ( input p-role as character
      686                                                             ,input p-db-num as integer
      687                                                             ,input p-date as date
      688                                                                 ):
      689   define buffer buf_staff for ub.staff.
      690   define buffer buf2_staff for ub.staff.
      691   if p-date = ? then do:
      692     p-date = today .
      693   end.
      694   for each  buf_staff no-lock where
      695             buf_staff.role = p-role
      696         and buf_staff.db-num = p-db-num,
      697   first buf2_staff no-lock where
      698         buf2_staff.role = p-role
      699     and buf2_staff.role-level = 'db':U
      700     and buf2_staff.staff-code = buf_staff.staff-code
      701     and buf2_staff.date-start <= p-date
      702     and buf2_staff.date-end >= p-date
      703   by buf_staff.staff-code
      704   by date-start descending:
      705     return buf_staff.staff-code.
      706   end.
      707   end FUNCTION.
      708   FUNCTION gbclcode-get-db-role returns integer ( input p-role as character
      709                                                  ,input p-db-num as integer
      710                                                  ,input p-psn-code as integer
      711                                                  ,input p-date as date
      712                                                  ,output p-c-password as character
      713                                                        ):
      714   define buffer buf_staff for ub.staff.
      715   if p-date = ? then do:
      716     p-date = today .
      717   end.
      718   find first buf_staff no-lock where
      719             buf_staff.role = p-role
      720         and buf_staff.role-level = 'db':U
      721         and buf_staff.db-num = p-db-num
      722        and buf_staff.date-end >= p-date
      723        and buf_staff.psn-code = p-psn-code use-index irole-psn no-error .
      724   if available buf_staff
      725   then do:
      726     assign
      727     p-c-password = buf_staff.password.
      728     return buf_staff.staff-code.
      729   end.
      730   p-c-password = ''.
      731   return 0.
      732   end FUNCTION.
      733   FUNCTION gbclcode-is-psn-role returns integer (
      734                                                 input p-role as character
      735                                                 ,input p-psn-code as integer
      736                                                 ,input p-date as date
      737                                                     ):
      738   define buffer buf_staff for ub.staff.
      739   if p-date = ? then do:
      740     p-date = today .
      741   end.
      742   for each buf_staff no-lock where
      743             buf_staff.psn-code = p-psn-code
      744        and  buf_staff.role = p-role
      745   by buf_staff.role-level
      746   by buf_staff.date-start
      747        :
      748     if  buf_staff.date-start <= p-date and
      749     buf_staff.date-end >= p-date  then do:
      750       return buf_staff.staff-code.
      751     end.
      752   end.
      753   return 0.
      754   end FUNCTION.
      755   FUNCTION gbclcode-get-role-name returns character ( input p-role as character):
      756   define variable v-role-name as character no-undo .
      757   assign
      758   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      759   no-error .
      760   return v-role-name.
      761   END.
      762   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      763   FUNCTION gbclcode-get-position returns character ( input p-role as character
      764                                                     ,input p-role-level as character
      765                                                     ,input p-work-place as character
      766                                                     ,input p-staff-code as integer
      767                                                                ):
      768   define variable v-role-name as character no-undo .
      769   define variable v-role-level as character no-undo .
      770   define variable v-staff-code as integer no-undo .
      771   assign
      772   v-role-name = entry (lookup (p-role, 'C,S':U) + 1, ',':U + 'Кассир,Продавец':U)
      773   v-role-level = substitute("&1 &2", entry (lookup (p-role-level, 'global,db,firm,object':U) + 1, ',':U + 'Глобально,БД,Фирма,Объект':U) , p-work-place)
      774   v-staff-code = p-staff-code
      775   no-error .
      776   return substitute("&1, &2, Код &3"
      777                   ,v-role-name
      778                   ,v-role-level
      779                   ,(if p-staff-code = 0 then chr(63) else string(p-staff-code))).
      780   END.
      781   FUNCTION gbclcode-get-work-place returns character (
      782                                                   input p-role as character
      783                                                  ,input p-role-level as character
      784                                                  ,input p-db-num as integer
      785                                                  ,input p-host-code as integer
      786                                                  ,input p-obj-type as character
      787                                                  ,input p-obj-code as integer
      788                                                  ) :
      789   define variable v-work-place as character no-undo .
      790   define variable v-obj-type as character no-undo .
      791     case p-role-level:
      792       when 'db':U then do:
      793         v-work-place = string(p-db-num, "99999").
      794       end.
      795       when 'firm':U then do:
      796         v-work-place = string(p-host-code, "99999").
      797       end.
      798       when 'object':U then do:
      799         assign
      800         v-work-place = p-obj-type + string(p-obj-code, "999999999")
      801         .
      802       end.
      803     END CASE.
      804     return v-work-place.
      805   END FUNCTION.
      806   FUNCTION gbclcode-get-level-last-code returns integer (
      807                                                           input p-role as character
      808                                                         , input p-role-level as character
      809                                                         , input p-work-place as character
      810                                                         , input p-date-start as date
      811                                                         ):
      812   DEFINE VARIABLE v-today as date no-undo .
      813   define buffer buf_staff for ub.staff.
      814   if p-work-place = chr(63) then return ?.
      815   if p-date-start = ? then do:
      816     v-today = today .
      817   end.
      818   else do:
      819     v-today = p-date-start.
      820   end.
      821   find last buf_staff no-lock where
      822             buf_staff.role = p-role
      823        and  buf_staff.role-level = p-role-level
      824        and  buf_staff.work-place = p-work-place
      825        and  buf_staff.date-start <= v-today + 1
      826        and  buf_staff.date-end >= v-today + 1
      827        use-index pi  no-error .
      828   if available buf_staff
      829   then return buf_staff.staff-code.
      830   return 0.
      831   end FUNCTION.
