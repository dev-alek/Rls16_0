     1417   define new shared stream PrnLibStream.
     1418   procedure prn-lib-prn-file :
     1419     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1420     define input parameter p-DIsabledoptions as integer no-undo .
     1421     define variable v-report-name as character no-undo .
     1422     define variable v-user-action as character no-undo .
     1423     define variable v-printed     as logical   no-undo .
     1424     define variable v-exist       as logical   no-undo .
     1425     do
     1426       on error undo, return error
     1427       :
     1428       run prn-lib-get-report-name  in this-procedure (
     1429         input parParentProc
     1430         ,output v-report-name
     1431         ).
     1432   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1433   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
     1434     (input  v-report-name
     1435     ,input  2
     1436     ,output v-exist
     1437     )  .
     1438       if NOT v-exist then
     1439       DO:
     1440         Message
     1441           "Нет заданий на печать ! "
     1442           view-as alert-box .
     1443         Return  .
     1444       End.
     1445       run gbl/prnfilen.w
     1446         (input  ""
     1447         ,input  p-DisabledOptions
     1448         ,input  string(v-report-name )
     1449         ,input  7
     1450         ,output v-user-action
     1451         ,output v-printed
     1452         ) .
     1453       if v-printed then
     1454       do:
     1455         return "YES" .
     1456       end.
     1457       else
     1458       do:
     1459         return "NO" .
     1460       end.
     1461     end.
     1462   end procedure.
     1463   procedure prn-lib-open-stream :
     1464     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1465     define input parameter p-page-size    as integer no-undo .
     1466     define input parameter p-is-stream    as logical no-undo .
     1467     define input parameter p-append       as logical no-undo .
     1468     define variable v-report-name as character no-undo .
     1469     do
     1470       on error undo, return error
     1471       :
     1472       run prn-lib-get-report-name  in this-procedure (
     1473         input parParentProc
     1474         ,output v-report-name
     1475         ).
     1476       if p-is-stream then
     1477       do:
     1478         if p-append then
     1479         do:
     1480           output stream PrnLibStream to value( v-report-name )
     1481             page-size value(p-page-size) append .
     1482         end.
     1483         if not p-append then
     1484         do:
     1485           output stream PrnLibStream to value( v-report-name )
     1486             page-size value(p-page-size) .
     1487         end.
     1488       end.
     1489       if not p-is-stream then
     1490       do:
     1491         if p-append then
     1492         do:
     1493           output to value( v-report-name )
     1494             page-size value(p-page-size) append .
     1495         end.
     1496         if not p-append then
     1497         do:
     1498           output to value( v-report-name )
     1499             page-size value(p-page-size) .
     1500         end.
     1501       end.
     1502     end.
     1503   end procedure.
     1504   procedure prn-lib-open-exp :
     1505     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1506     define input parameter p-is-stream    as logical no-undo .
     1507     define input parameter p-is-append    as logical no-undo .
     1508     define output parameter p-ReportFileName as char init "report" no-undo.
     1509     define output parameter p-process as logical no-undo .
     1510     define variable glog as logical no-undo .
     1511     do
     1512       on error undo, return error
     1513       :
     1514       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1515         TITLE      "Укажите путь"
     1516         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1517         ASK-OVERWRITE
     1518         CREATE-TEST-FILE
     1519         SAVE-AS
     1520         USE-FILENAME
     1521         DEFAULT-EXTENSION "txt"
     1522         UPDATE glog
     1523         .
     1524       if not glog then  return.
     1525       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1526       if p-is-stream then
     1527       do:
     1528         if p-is-append then
     1529         do:
     1530           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1531         end.
     1532         else
     1533         do:
     1534           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1535         end.
     1536       end.
     1537       else
     1538       do:
     1539         if p-is-append then
     1540         do:
     1541           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1542         end.
     1543         else
     1544         do:
     1545           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1546         end.
     1547       end.
     1548       p-process = yes.
     1549     end.
     1550   end procedure.
     1551   procedure prn-lib-get-report-name :
     1552     define input parameter parParentProc  as widget-handle no-undo.
     1553     define output parameter p-report-name as character no-undo .
     1554     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1555   end procedure.
     1556   procedure prn-lib-reportviewer-report-name :
     1557     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1558     define input parameter p-report-name-html as character no-undo .
     1559     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1560   end procedure.
     1561   procedure prn-lib-reportviewer :
     1562     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1563     define input parameter p-report-name-html as character no-undo .
     1564     define input parameter p-param        as character no-undo .
     1565     define variable v-excel           as character no-undo init 'TRUE' .
     1566     define variable v-value-character as character no-undo .
     1567     define variable v-value-integer   as character no-undo .
     1568     define variable v-value-date      as date      no-undo .
     1569     define variable v-value-decimal   as decimal   no-undo .
     1570     define variable rep-excel         as logical   no-undo .
     1571     define variable excel-string      as character no-undo .
     1572     define variable v-param-type      as character no-undo .
     1573     define variable v-tth             as handle    no-undo .
     1574     run adm/shattri.p (
     1575       input "get":U
     1576       ,input  ""
     1577       ,input  0
     1578       ,input  'report-glob':U
     1579       ,input  'rep-excel':U
     1580       ,output v-value-character
     1581       ,output v-value-date
     1582       ,output v-value-decimal
     1583       ,output v-value-integer
     1584       ,output rep-excel
     1585       ,output v-param-type
     1586       ,INPUT-OUTPUT table-handle v-tth
     1587       )  .
     1588     if rep-excel then v-excel = "TRUE" .
     1589     else v-excel = "FALSE" .
     1590     if p-param eq ""
     1591     then
     1592        p-param = "EXCEL:" + v-excel.
     1593     else
     1594        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1595     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1596   end procedure.
     1597   function is-gas returns logical
     1598           (input p-gds-code as integer):
     1599   define variable result as logical no-undo.
     1600   define variable c-value as character no-undo.
     1601   define variable c-type as character no-undo.
     1602   do on error undo, return error:
     1603           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1604         (input  p-gds-code
     1605         ,input  'fuel-type':U
     1606         ,output c-value
     1607         ,output c-type) no-error.
     1608   end.
     1609   result = logical(c-value = 'metan':U) no-error.
     1610   return result.
     1611   end function.
     1612   function is-sug returns logical
     1613           (input p-gds-code as integer):
     1614   define variable result as logical no-undo.
     1615   define variable c-value as character no-undo.
     1616   define variable c-type as character no-undo.
     1617   do on error undo, return error:
     1618           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     1619         (input  p-gds-code
     1620         ,input  'fuel-type':U
     1621         ,output c-value
     1622         ,output c-type) no-error.
     1623   end.
     1624   result = logical(c-value = 'lgas':U) no-error.
     1625   return result.
     1626   end function.
     1627   procedure placelib_write-attr:
     1628   define input  parameter p-code     like ub.place-attr.attr-code .
     1629   define input  parameter p-obj-code like ub.place-attr.obj-code .
     1630   define input  parameter p-obj-type like ub.place-attr.obj-type .
     1631   define input  parameter p-pl-code  like ub.place-attr.pl-code .
     1632   define input  parameter p-value    like ub.place-attr.attr-value .
     1633   define output parameter p-ok       as logical.
     1634   define buffer buf_place-attr for ub.place-attr .
     1635     do on error undo, return error return-value :
     1636        p-ok = false.
     1637        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1638                                                   and buf_place-attr.obj-code    = p-obj-code
     1639                                                   and buf_place-attr.obj-type    = p-obj-type
     1640                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1641        if not available buf_place-attr then do :
     1642           create buf_place-attr.
     1643           assign
     1644             buf_place-attr.attr-code   = p-code
     1645             buf_place-attr.attr-value  = p-value
     1646             buf_place-attr.obj-code    = p-obj-code
     1647             buf_place-attr.obj-type    = p-obj-type
     1648             buf_place-attr.pl-code     = p-pl-code
     1649           .
     1650           p-ok = true.
     1651        end.
     1652        else do:
     1653           buf_place-attr.attr-value  = p-value .
     1654           p-ok = true.
     1655        end.
     1656     end.
     1657   end.
     1658   procedure placelib_get-attr:
     1659   define input  parameter  p-code     like ub.place-attr.attr-code .
     1660   define input  parameter  p-obj-code like ub.place-attr.obj-code .
     1661   define input  parameter  p-obj-type like ub.place-attr.obj-type .
     1662   define input  parameter  p-pl-code  like ub.place-attr.pl-code .
     1663   define output parameter  p-value    like ub.place-attr.attr-value .
     1664   define output parameter  p-ok       as logical.
     1665   define buffer buf_place-attr for ub.place-attr .
     1666     do on error undo, return error return-value :
     1667        p-ok = false.
     1668        find first buf_place-attr no-lock where buf_place-attr.attr-code   = p-code
     1669                                                   and buf_place-attr.obj-code    = p-obj-code
     1670                                                   and buf_place-attr.obj-type    = p-obj-type
     1671                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1672        if available buf_place-attr then do :
     1673          p-value = buf_place-attr.attr-value.
     1674          p-ok = true.
     1675        end.
     1676        else do :
     1677          p-ok = false.
     1678        end.
     1679     end.
     1680   end.
     1681   procedure placelib_del-attr:
     1682   define input parameter  p-code     like ub.place-attr.attr-code .
     1683   define input parameter  p-obj-code like ub.place-attr.obj-code .
     1684   define input parameter  p-obj-type like ub.place-attr.obj-type .
     1685   define input parameter  p-pl-code  like ub.place-attr.pl-code .
     1686   define input parameter  p-value    like ub.place-attr.attr-value .
     1687   define output parameter p-ok       as logical.
     1688   define buffer buf_place-attr for ub.place-attr .
     1689     do on error undo, return error return-value :
     1690        p-ok = false.
     1691        find first buf_place-attr exclusive-lock where buf_place-attr.attr-code   = p-code
     1692                                                   and buf_place-attr.obj-code    = p-obj-code
     1693                                                   and buf_place-attr.obj-type    = p-obj-type
     1694                                                   and buf_place-attr.pl-code     = p-pl-code no-error.
     1695        if available buf_place-attr then do :
     1696           delete buf_place-attr.
     1697           p-ok = true.
     1698        end.
     1699     end.
     1700   end.
