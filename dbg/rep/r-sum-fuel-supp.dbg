     1873   function f_disp_time returns character
     1874      (input iTime as integer):
     1875      define variable vHour    as integer   no-undo.
     1876      define variable vMinute  as integer   no-undo.
     1877      define variable vSec     as integer   no-undo.
     1878      define variable vTimeStr as character no-undo.
     1879      if iTime < 0 then return "".
     1880      vHour = truncate(iTime / 3600, 0).
     1881      vMinute = truncate((iTime - vHour * 3600) / 60, 0).
     1882      vSec = iTime - vHour * 3600 - vMinute * 60.
     1883      vTimeStr = trim(string(vHour, ">>>99")) + ":" +
     1884                 string(vMinute, "99")  + ":" +
     1885                 string(vSec,    "99").
     1886      return vTimeStr.
     1887   end function.
     1888   function fDate2Str returns character
     1889      (input idate as date,
     1890       input iformat as char):
     1891      define variable vdatestr as character no-undo.
     1892      if idate = ? then
     1893         vdatestr = "".
     1894      else
     1895         vdatestr = trim(string(idate, iformat)).
     1896      return vdatestr.
     1897   end function.
     1898   function fDec2Str returns character
     1899      (input idec as decimal,
     1900       input iformat as char):
     1901      define variable vdecstr as character no-undo.
     1902      if idec = ? then
     1903         vdecstr = "".
     1904      else
     1905         vdecstr = trim(string(idec, iformat)).
     1906      return vdecstr.
     1907   end function.
     1908   function fInt2Str returns character
     1909      (input iInt as integer,
     1910       input iformat as char):
     1911      define variable vIntStr as character no-undo.
     1912      if iInt = ? then
     1913         vIntStr = "".
     1914      else
     1915         vIntStr = trim(string(iInt, iformat)).
     1916      return vIntStr.
     1917   end function.
     1918   function fStrNvl returns character
     1919      (input iStr     as character,
     1920       input iDefault as character):
     1921      return if iStr > "" then iStr else iDefault.
     1922   end function.
