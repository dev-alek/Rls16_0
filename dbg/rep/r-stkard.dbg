     1507     do
     1508     on error undo, return error "Ошибка при вызове процедуры prl-vat."
     1509     :
     1510       find first bf_price-list no-lock
     1511         where recid(bf_price-list) = parrecid
     1512         no-error .
     1513       if not available bf_price-list
     1514       then do:
     1515         return error "Ошибка во входящих параметрах prl-vat.i" .
     1516       end.
     1517       find first bf_goods no-lock
     1518         where bf_goods.artic     = bf_price-list.artic
     1519           and bf_goods.prod-type = bf_price-list.prod-type
     1520           and bf_goods.prod-code = bf_price-list.prod-code
     1521         no-error .
     1522       if not available bf_goods
     1523       then do:
     1524         undo, return error substitute("Не найден товар &1 &2 &3 для переоценки с кодом &4",bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code,parrecid).
     1525       end.
     1526       assign
     1527         varvat-pc = bf_price-list.vat-pc
     1528         varslt-pc = bf_price-list.slt-pc
     1529       .
     1530       if varvat-pc = ?
     1531       then do:
     1532         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НДС",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     1533       end.
     1534       if varslt-pc = ?
     1535       then do:
     1536         undo, return error substitute("В переоценке &1 для товара &2 &3 &4 не задан НП",bf_price-list.doc-num,bf_price-list.artic,bf_price-list.prod-type,bf_price-list.prod-code).
     1537       end.
     1538       assign
     1539         varbase-rate   = 1
     1540         varbase-scale  = 1
     1541         varroad-tax    = bf_price-list.road-tax
     1542         varexcise      = bf_price-list.excise
     1543         varprice-base  = bf_price-list.price-sale
     1544         varprice-rubl  = bf_price-list.price-sale
     1545         vardiscnt-base = 0
     1546         vardiscnt-rubl = 0
     1547       .
     1548       assign
     1549         varfact-qnty = 0
     1550       .
     1551       for each bf_parts no-lock
     1552         where bf_parts.out-code   = bf_price-list.doc-num
     1553           and bf_parts.obj-type   = bf_price-list.obj-type
     1554           and bf_parts.obj-code   = bf_price-list.obj-code
     1555           and bf_parts.artic      = bf_price-list.artic
     1556           and bf_parts.prod-type  = bf_price-list.prod-type
     1557           and bf_parts.prod-code  = bf_price-list.prod-code
     1558       :
     1559         assign
     1560           varfact-qnty = varfact-qnty + bf_parts.fact-qnty
     1561         .
     1562       end.
     1563       assign
     1564         vardoc-num   = bf_price-list.doc-num
     1565         vardoc-code  = bf_price-list.doc-num
     1566         varobj-type  = bf_price-list.obj-type
     1567         varobj-code  = bf_price-list.obj-code
     1568         varartic     = bf_price-list.artic
     1569         varprod-type = bf_price-list.prod-type
     1570         varprod-code = bf_price-list.prod-code
     1571         vardoc-qnty  = varfact-qnty
     1572         varext-doc-type = 'ot':U
     1573       .
     1574   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1575   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1576     (input  bf_price-list.obj-type
     1577     ,input  bf_price-list.obj-code
     1578     ,output v-host-code
     1579     )  .
     1580       find first bf_sysconf no-lock
     1581         where bf_sysconf.host-code = v-host-code
     1582         .
     1583       if bf_sysconf.cons-vat-pc = ?
     1584       then do:
     1585         return error "Не задан консигнационный НДС по фирме." .
     1586       end.
     1587       else do:
     1588         assign
