     1631     (input  varroot-nodeprl
     1632     ,input  'empty-scale=request'
     1633     ,output varempty-scaleprl
     1634     ) no-error .
     1635   if error-status :error then do:
     1636     message
     1637       vss-workfile vss-revision vss-description skip
     1638       "Ошибка при определении атрибута признака" skip
     1639       "Артикул" varartic varprod-type varprod-code skip
     1640       "Признак" varroot-nodeprl skip
     1641       "Запрашивался атрибут" "empty-scale=request" skip
     1642       error-status :get-message(1) skip
     1643       return-value skip
     1644       view-as alert-box error .
     1645     undo, return error .
     1646   end.
     1647   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1648   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1649     (output varoutvprbprl
     1650     )  .
     1651   if varoutvprbprl = "base":u then do:
     1652     assign
     1653           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax * 1)
     1654       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   * 1)
     1655     .
     1656   end.
     1657   else do:
     1658     assign
     1659           road-tax-base-saleprl    =  (if varroad-tax = ? then 0 else varroad-tax / varbase-rate * varbase-scale)
     1660       excise-base-saleprl      =  (if varexcise   = ? then 0 else varexcise   / varbase-rate * varbase-scale)
     1661     .
     1662   end.
     1663   if varoutvprbprl = "rubl":u then do:
     1664     assign
     1665           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * 1)
     1666       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * 1) .
     1667   end.
     1668   else do:
     1669     assign
     1670           road-tax-rubl-saleprl    = (if varroad-tax = ? then 0 else varroad-tax * varbase-rate / varbase-scale)
     1671       excise-rubl-saleprl      = (if varexcise   = ? then 0 else varexcise   * varbase-rate / varbase-scale) .
     1672   end.
     1673   assign
     1674     varis-cons-parts-haveprl =  no.
     1675   assign
     1676     varfact-qntyprl       = 0
     1677     varcons-qntyprl       = 0
     1678     varprice-base-consprl = 0
     1679     varprice-rubl-consprl = 0.
     1680   find first out-vatp_doc-lineprl where
     1681              out-vatp_doc-lineprl.doc-code   = vardoc-num
     1682          and out-vatp_doc-lineprl.artic      = varartic
     1683          and out-vatp_doc-lineprl.prod-type  = varprod-type
     1684          and out-vatp_doc-lineprl.prod-code  = varprod-code no-lock no-error.
     1685   if available out-vatp_doc-lineprl           and
     1686     (out-vatp_doc-lineprl.status_ = 'запрос':U or out-vatp_goodsprl.gds-type = 'у':U) then do:
     1687     assign
     1688       varfact-qntyprl = out-vatp_doc-lineprl.fact-qnty.
     1689   end.
     1690   else do:
     1691     for each out-vatp_partsprl where out-vatp_partsprl.out-code   = vardoc-num
     1692                                  and out-vatp_partsprl.obj-type   = varobj-type
     1693                                  and out-vatp_partsprl.obj-code   = varobj-code
     1694                                  and out-vatp_partsprl.artic      = varartic
     1695                                  and out-vatp_partsprl.prod-type  = varprod-type
     1696                                  and out-vatp_partsprl.prod-code  = varprod-code no-lock :
     1697       if out-vatp_partsprl.purch-code = 2 then do:
     1698   assign
     1699     price-rubl-with-tax-locoprl = out-vatp_partsprl.price-rubl
     1700     price-base-with-tax-locoprl = out-vatp_partsprl.price-base
     1701   .
     1702   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1703   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1704     (output varinvprboprl
     1705     )  .
     1706     if out-vatp_partsprl.out-code = 'free-zone':U     or
     1707        out-vatp_partsprl.out-code = 'out-zone':U   or
     1708        out-vatp_partsprl.doc-type = 'акт':U then do:
     1709       assign
     1710         in-vatp-have-vat-sltoprl = yes.
     1711     end.
     1712     else do:
     1713       find first in-vatp_doc-attroprl no-lock
     1714         where in-vatp_doc-attroprl.doc-code  = out-vatp_partsprl.out-code
     1715           and in-vatp_doc-attroprl.attr-code = 'envd':U
     1716         no-error .
     1717       if not available in-vatp_doc-attroprl then do:
