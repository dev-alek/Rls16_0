     2451   define variable vss-include-info21 as character format "X(65)" no-undo
     2452   initial "@(#)$Workfile$ $Revision$".
     2453   define temp-table temp_p-fmt_string-part no-undo
     2454       field str-key       as integer
     2455       field string-part   as character
     2456       index pi is primary unique
     2457           str-key
     2458   .
     2459   define variable v-p-fmt-21-str-key    as integer      no-undo.
     2460   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     2461                                     iInput AS INTEGER).
     2462     def var v-start-print as integer no-undo .
     2463     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     2464     assign
     2465       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     2466     .
     2467     RETURN v-start-print .
     2468   END FUNCTION.
     2469   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     2470                                     iInput AS INTEGER).
     2471     def var v-start-print as integer no-undo .
     2472     assign
     2473       v-start-print = INTEGER(iEndPix - 1 - iInput)
     2474     .
     2475     if v-start-print < 0 then return 0.
     2476     RETURN v-start-print .
     2477   END FUNCTION.
     2478   function p-fmt-align-string returns character (
     2479         p-in-string      as character
     2480       , p-page-width     as integer
     2481       , p-align-type     as character
     2482   ).
     2483       define variable v-string-length     as integer      no-undo.
     2484       define variable v-out-string        as character    no-undo.
     2485       assign
     2486           v-string-length = length( trim( p-in-string ) )
     2487       .
     2488       if v-string-length >= p-page-width
     2489       then do:
     2490           assign
     2491               v-out-string = trim( p-in-string )
     2492           .
     2493       end.
     2494       else do:
     2495           case p-align-type
     2496           :
     2497               when 'left':U
     2498               then do:
     2499                   assign
     2500                       v-out-string = trim( p-in-string )
     2501                   .
     2502               end.
     2503               when 'right':U
     2504               then do:
     2505                   assign
     2506                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     2507                   .
     2508               end.
     2509               when 'center':U
     2510               then do:
     2511                   assign
     2512                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     2513                   .
     2514               end.
     2515           end case.
     2516       end.
     2517       return v-out-string .
     2518   end function.
     2519   procedure p-fmt-split-string :
     2520   define input parameter p-source-string  as character        no-undo.
     2521   define input parameter p-split-length   as integer          no-undo.
     2522   define output parameter p-string-1      as character        no-undo.
     2523   define output parameter p-string-2      as character        no-undo.
     2524   do
     2525   on error undo, return error
     2526   :
     2527       define variable v-space-pos    as integer      no-undo.
     2528       if length( p-source-string ) <= p-split-length
     2529       then do:
     2530           assign
     2531               p-string-1 = p-source-string
     2532           .
     2533       end.
     2534       else do:
     2535           assign
     2536               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     2537           .
     2538           if v-space-pos = 0
     2539           then do:
     2540               assign
     2541                   v-space-pos = index( p-source-string, " ":U )
     2542               .
     2543           end.
     2544           if v-space-pos = 0
     2545           then do:
     2546               assign
     2547                   p-string-1 = substring( p-source-string, 1, p-split-length )
     2548                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     2549               .
     2550           end.
     2551           else do:
     2552               assign
     2553                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     2554                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     2555               .
     2556           end.
     2557       end.
     2558   end.
     2559   end procedure.
     2560   procedure p-fmt-round :
     2561   define input parameter p-qnty               as decimal          no-undo.
     2562   define input parameter p-price-no-VAT       as decimal          no-undo.
     2563   define input parameter p-VAT                as decimal          no-undo.
     2564   define input parameter p-SLT                as decimal          no-undo.
     2565   define input parameter p-road-tax           as decimal          no-undo.
     2566   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     2567   define output parameter p-new-VAT           as decimal          no-undo.
     2568   define output parameter p-new-SLT           as decimal          no-undo.
     2569   define output parameter p-new-sum-VAT       as decimal          no-undo.
     2570   define output parameter p-new-sum-SLT       as decimal          no-undo.
     2571   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     2572   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     2573   define output parameter p-new-sum-full      as decimal          no-undo.
     2574       define variable v-vat-pc    as decimal      no-undo.
     2575       define variable v-slt-pc    as decimal      no-undo.
     2576   do
     2577   on error undo, return error
     2578   :
     2579       if p-price-no-VAT = 0
     2580       then do:
     2581           assign
     2582               p-new-price-no-VAT = 0.0
     2583               p-new-VAT          = ?
     2584               p-new-SLT          = ?
     2585               p-new-sum-VAT      = 0.0
     2586               p-new-sum-SLT      = 0.0
     2587               p-new-sum-no-VAT   = 0.0
     2588               p-new-sum-road-tax = 0.0
     2589               p-new-sum-full     = 0.0
     2590           .
     2591       end.
     2592       else do:
     2593           assign
     2594               v-vat-pc            = p-VAT / p-price-no-VAT
     2595               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     2596               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     2597               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     2598               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     2599               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     2600               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     2601               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     2602               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     2603               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     2604           .
     2605       end.
     2606   end.
     2607   end procedure.
     2608   procedure p-fmt-split :
     2609   define input parameter p-in-string      as character        no-undo.
     2610   define input parameter p-split-length   as integer          no-undo.
     2611       define variable v-start-pos     as integer      no-undo.
     2612       define variable v-end-pos       as integer      no-undo.
     2613       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     2614   do
     2615   for buf_temp_p-fmt_string-part
     2616   on error undo, return error
     2617   :
     2618       empty temp-table buf_temp_p-fmt_string-part.
     2619       if p-split-length < 1
     2620       then do:
     2621           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     2622       end.
     2623       assign
     2624           p-in-string                 = trim( p-in-string )
     2625           v-p-fmt-21-str-key   = 0
     2626           v-start-pos                 = 1
     2627           v-end-pos                   = length( p-in-string )
     2628       .
     2629       run p-fmt-get-string-range in this-procedure (
     2630             input p-in-string
     2631           , input p-split-length
     2632           , input v-start-pos
     2633           , output v-start-pos
     2634           , output v-end-pos
     2635       ).
     2636       do while v-end-pos <> 0
     2637       :
     2638           create buf_temp_p-fmt_string-part.
     2639           assign
     2640               v-p-fmt-21-str-key = v-p-fmt-21-str-key + 1
     2641           .
     2642           assign
     2643               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-21-str-key
     2644               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     2645           .
     2646           assign
     2647               v-start-pos = v-end-pos + 1
     2648           .
     2649           run p-fmt-get-string-range in this-procedure (
     2650                 input p-in-string
     2651               , input p-split-length
     2652               , input v-start-pos
     2653               , output v-start-pos
     2654               , output v-end-pos
     2655           ).
     2656       end.
     2657   end.
     2658   end procedure.
     2659   procedure p-fmt-get-string-range :
     2660   define input parameter p-in-string      as character        no-undo.
     2661   define input parameter p-split-length   as integer          no-undo.
     2662   define input parameter p-old-start-pos  as integer          no-undo.
     2663   define output parameter p-start-pos     as integer          no-undo.
     2664   define output parameter p-end-pos       as integer          no-undo.
     2665       define variable v-init-string    as character    no-undo.
     2666       define variable v-temp-char      as character    no-undo.
     2667       define variable v-temp-pos       as integer      no-undo.
     2668       define variable v-counter        as integer      no-undo.
     2669   do
     2670   on error undo, return error
     2671   :
     2672       assign
     2673           p-start-pos   = p-old-start-pos
     2674           v-init-string = substring( p-in-string, p-start-pos )
     2675       no-error.
     2676       if error-status :error
     2677       or trim( v-init-string ) = "":U
     2678       then do:
     2679           assign
     2680               p-end-pos = 0
     2681           .
     2682           undo, return .
     2683       end.
     2684       assign
     2685           v-temp-char   = substring( v-init-string, 1, 1 )
     2686       .
     2687       do
     2688       while trim( v-temp-char ) = "":U
     2689       :
     2690           assign
     2691               p-start-pos     = p-start-pos + 1
     2692               v-init-string   = substring( p-in-string, p-start-pos )
     2693               v-temp-char     = substring( v-init-string, 1, 1 )
     2694           .
     2695       end.
     2696       assign
     2697           v-temp-pos  = p-split-length
     2698           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     2699           v-counter   = 0
     2700       .
     2701       search-word-end:
     2702       do
     2703       while trim( v-temp-char ) <> "":U
     2704       :
     2705           assign
     2706               v-counter   = v-counter + 1
     2707           .
     2708           if v-counter > 20
     2709           then do:
     2710               assign
     2711                   v-temp-pos  = p-split-length
     2712               .
     2713               leave search-word-end.
     2714           end.
     2715           assign
     2716               v-temp-pos  = v-temp-pos - 1
     2717               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     2718           .
     2719       end.
     2720       assign
     2721           p-end-pos = p-start-pos + v-temp-pos - 1
     2722       .
     2723   end.
     2724   end procedure.
     2725   define buffer buf_trn-doc       for ub.trn-doc  .
     2726   define buffer buf_doc-line      for ub.doc-line .
     2727   define buffer buf_goods         for ub.goods    .
     2728   define buffer buf_prod-bc       for ub.prod-bc  .
     2729   define buffer buf_bar-code      for ub.bar-code .
     2730   define buffer buf_parts         for ub.parts    .
     2731   define buffer buf_clients       for ub.clients  .
     2732   define buffer buf_temp_p-fmt_string-part for temp_p-fmt_string-part.
     2733   define shared variable CostPrice as logical no-undo.
     2734   define variable g#report-num     as integer no-undo.
     2735   define variable Rubl_Coeff       as decimal  no-undo.
     2736   my-handle = p-parent-proc.
     2737   run get-report-num in my-handle (output g#report-num).
     2738   DEFINE VARIABLE sym1  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2739   DEFINE VARIABLE sym2  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2740   DEFINE VARIABLE sym3  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2741   DEFINE VARIABLE sym4  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2742   DEFINE VARIABLE sym5  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2743   DEFINE VARIABLE sym6  AS CHARACTER NO-UNDO FORMAT "x(1)":U INITIAL ":":U.
     2744   procedure OpenForExcel :
     2745      define variable v-ch#ExcelApplication as com-handle no-undo .
     2746      define variable v-ch#Workbook         as com-handle no-undo .
     2747      define variable v-ch#Worksheet        as com-handle no-undo .
     2748      os-delete value( string( session:temp-directory ) +
     2749                                 "rpt" + string( g#report-num ) + ".txt":U ) .
     2750      os-delete value( string( session:temp-directory ) +
     2751                                 "rpt" + string( g#report-num ) + ".frm":U ) .
     2752      os-delete value( string( session:temp-directory ) +
     2753                                 "rpt" + string( g#report-num ) + ".txl":U ) .
     2754      if Make-Excel
     2755      then do:
     2756         output stream ForExcel to value( string( session:temp-directory +
     2757                                        "rpt" + string( g#report-num ) + ".txt":U ) ) .
     2758         assign
     2759            v-excel-file = string( session:temp-directory + "rpt" + string( g#report-num ) )
     2760            number-list = 1
     2761         .
     2762         if make-excel-com
     2763         then do:
     2764   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2765   if valid-handle(ch#WorkSheet) then
     2766   RELEASE OBJECT ch#WorkSheet no-error.
     2767   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2768   if valid-handle(ch#Workbook) then
     2769   RELEASE OBJECT ch#Workbook no-error.
     2770   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2771   if valid-handle(ch#ExcelApplication) then
     2772   RELEASE OBJECT ch#ExcelApplication no-error.
     2773            create "Excel.Application" ch#excelApplication connect no-error.
     2774            if error-status:error
     2775            then do :
     2776           create "Excel.Application" ch#excelApplication no-error.
     2777       if error-status :error then do:
     2778           message
     2779           "Ошибка при запуске Excel" skip
     2780           error-status :get-message(1) skip
     2781           view-as alert-box error .
     2782           undo, return error .
     2783       end.
     2784            end.
     2785            assign
     2786               num#str#  = 0.
     2787               v-ch#excelApplication  = ch#excelApplication.
     2788               v-ch#excelApplication:Interactive = false.
     2789               v-ch#excelApplication:ScreenUpdating = false.
     2790               v-ch#excelApplication:Visible = false.
     2791               ch#Workbook  = v-ch#excelApplication:Workbooks:add ().
     2792               ch#WorkSheet = v-ch#excelApplication:Sheets:Item (1).
     2793               v-ch#Worksheet = ch#WorkSheet.
     2794               v-ch#Worksheet:Range ("A1"):Font:Bold = true.
     2795               v-ch#Worksheet:Range ("A1"):Font:Size = 14.
     2796               v-ch#Worksheet:Range ("A1"):HorizontalAlignment = -4131.
     2797               v-ch#Worksheet:Range ("A1"):VerticalAlignment   = -4160
     2798            no-error .
     2799            if error-status:error
     2800            then do:
     2801               Make-Excel-com = false .
     2802               Make-Excel = false .
     2803               output Stream  ForExcel close.
     2804               os-delete value( string( session:temp-directory ) +
     2805                              "rpt" + string( g#report-num ) + ".txt":U ) .
     2806               os-delete value( string( session:temp-directory ) +
     2807                              "rpt" + string( g#report-num ) + ".frm":U ) .
     2808               return.
     2809            end.
     2810         end.
     2811      end.
     2812   end.
     2813   procedure CloseForExcel :
     2814      define variable ii as integer no-undo .
     2815      define variable vsheet-num as integer no-undo.
     2816      if Make-Excel
     2817      then  do:
     2818         output Stream  ForExcel close.
     2819         os-delete value( string( session:temp-directory ) +
     2820                                "rpt" + string( g#report-num ) + ".txt":U ) .
     2821         os-delete value( string( session:temp-directory ) +
     2822                                "rpt" + string( g#report-num ) + ".frm":U ) .
     2823         define buffer buf_sheetf for sheetf.
     2824         find last buf_sheetf no-error .
     2825         if available buf_sheetf
     2826         then
     2827            vsheet-num = buf_sheetf.sheet-num.
     2828         if vsheet-num > 1
     2829         then do:
     2830            do ii = 2 to vsheet-num:
     2831               os-delete value( string( session:temp-directory ) +
     2832                                     "rpt" + string( g#report-num ) + ".":U  + string(ii)) .
     2833            end.
     2834         end.
     2835   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2836   if valid-handle(ch#WorkSheet) then
     2837   RELEASE OBJECT ch#WorkSheet no-error.
     2838   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2839   if valid-handle(ch#Workbook) then
     2840   RELEASE OBJECT ch#Workbook no-error.
     2841   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2842   if valid-handle(ch#ExcelApplication) then
     2843   RELEASE OBJECT ch#ExcelApplication no-error.
     2844      end.
     2845   end.
     2846   define buffer buf_doc  for ub.trn-doc.
     2847   Main-Block:
     2848   do on error   undo Main-Block, leave Main-Block
     2849     on end-key undo Main-Block, leave Main-Block :
     2850     find buf_doc no-lock where recid( buf_doc ) = p-rec-id no-error.
     2851     if not available buf_doc then do:
     2852       message "Накладная не найдена!" view-as alert-box error.
     2853       undo Main-Block, leave Main-Block.
     2854     end.
     2855     RUN WaitFram-Show IN THIS-PROCEDURE ( INPUT "Ждите..." ).
     2856     IF SESSION :SET-WAIT-STATE( "COMPILER" ) THEN DO: END.
     2857     RUN prn-lib-open-stream IN THIS-PROCEDURE ( INPUT p-parent-proc, INPUT 43, INPUT YES, INPUT NO ).
     2858     Make-Excel = true.
     2859     run  OpenForExcel.
     2860     run print-header in this-procedure .
     2861     if error-status :error then
     2862     do:
     2863       undo Main-Block, leave Main-Block.
     2864     end.
     2865     run print (p-rec-id)  no-error .
     2866     if error-status :error then
     2867     do:
     2868       undo Main-Block, leave Main-Block.
     2869     end.
     2870     if Make-Excel then output stream ForExcel close.
     2871     output stream PrnLibStream close.
     2872     if session :SET-WAIT-STATE( "":U       ) then do: end.
     2873     run WaitFram-Hide in this-procedure.
     2874     RUN prn-lib-prn-file IN THIS-PROCEDURE ( INPUT p-parent-proc, INPUT 8 ).
     2875   end.
     2876   run WaitFram-Hide in this-procedure.
     2877   procedure print-header :
     2878     assign
     2879       sheetf.MergeCellsH = ""
     2880       Sheetf.MergeCellsV = ""
     2881       Sheetf.Excel-Column-Lable = "" + chr(44) + "" + chr(44) + "" +  chr(44) + "" + chr(44) + ""
     2882       Sheetf.Sizes = "15" + chr(44) + "15" + chr(44) + "15" + chr(44) + "15"
     2883   + chr(44) + "15"
     2884       Sheetf.colformat = "1=@;2=@;3=@;4=dd/mm/yyyy;5=@"
     2885       ReportHeader = ""
     2886       Sheetf.Bas-File = "exe/r-stkard.bas"
     2887       .
     2888     run rep/extitle.p(1).
     2889   end.
     2890   procedure print:
     2891     define input parameter p-doc-recid as recid  no-undo.
     2892     define variable v-article     as character no-undo .
     2893     define variable v-attr-value  as character no-undo .
     2894     define variable v-attr-type   as character no-undo .
     2895     define variable v-obj-name as char no-undo.
     2896     define variable v-cli-name as char no-undo.
     2897     define variable str        as char no-undo.
     2898     DEFINE FRAME r-stkard
     2899       sym1  SPACE( 0 ) str                  FORMAT "x(16)"        SPACE( 1 )
     2900       sym2  SPACE( 0 ) buf_goods.gds-name   FORMAT "x(73)"        SPACE( 0 )
     2901       sym3  SPACE( 0 ) buf_parts.part-code  FORMAT "x(20)"        SPACE( 0 )
     2902       sym4  SPACE( 0 ) buf_parts.last-date  FORMAT "99/99/9999"   SPACE( 0 )
     2903       sym5  SPACE( 0 ) buf_clients.obj-name FORMAT "X(67)"        SPACE( 0 )
     2904       sym6  SPACE( 0 )
     2905       WITH WIDTH 195 DOWN USE-TEXT STREAM-IO NO-BOX NO-LABELS.
     2906     find buf_trn-doc no-lock where recid( buf_trn-doc ) = p-doc-recid .
     2907     for each buf_doc-line no-lock where
     2908       buf_trn-doc.doc-code = buf_doc-line.doc-code :
     2909       find first buf_goods no-lock
     2910         where buf_goods.prod-type = buf_doc-line.prod-type
     2911         and buf_goods.prod-code = buf_doc-line.prod-code
     2912         and buf_goods.artic = buf_doc-line.artic.
     2913       find first buf_clients no-lock
     2914         where  buf_clients.obj-type = buf_goods.prod-type
     2915         and buf_clients.obj-code = buf_goods.prod-code
     2916         no-error .
     2917       for each buf_parts no-lock
     2918         where buf_parts.out-code   = buf_doc-line.doc-code
     2919         and buf_parts.obj-type   = buf_doc-line.obj-type
     2920         and buf_parts.obj-code   = buf_doc-line.obj-code
     2921         and buf_parts.artic      = buf_doc-line.artic
     2922         and buf_parts.prod-type  = buf_doc-line.prod-type
     2923         and buf_parts.prod-code  = buf_doc-line.prod-code
     2924         :
     2925         if Make-Excel then  put   stream ForExcel unformatted
     2926         "Cтеллажная карта"   CHR(9)
     2927         buf_goods.gds-name   CHR(9)
     2928         buf_parts.part-code  CHR(9)
     2929         buf_parts.last-date  CHR(9)
     2930         buf_clients.obj-name CHR(9)
     2931         skip.
     2932         run p-fmt-split in this-procedure (
     2933           input buf_goods.gds-name
     2934           , input 73
     2935           ).
     2936         find first buf_temp_p-fmt_string-part where buf_temp_p-fmt_string-part.str-key = 1 .
     2937         display stream PrnLibStream
     2938           sym1 "Cтеллажная карта" @ str
     2939           sym2  buf_temp_p-fmt_string-part.string-part @ buf_goods.gds-name
     2940           sym3  buf_parts.part-code
     2941           when buf_parts.part-code <> ?
     2942           sym4  buf_parts.last-date
     2943           when buf_parts.last-date   <> ?
     2944           sym5  buf_clients.obj-name
     2945           when buf_clients.obj-name <> ?
     2946           sym6
     2947           with frame r-stkard.
     2948         down stream PrnLibStream with frame r-stkard.
     2949         for each buf_temp_p-fmt_string-part where buf_temp_p-fmt_string-part.str-key <> 1:
     2950           display stream PrnLibStream
     2951             sym1 "" @ str
     2952             sym2
     2953             buf_temp_p-fmt_string-part.string-part @ buf_goods.gds-name
     2954             sym3
     2955             sym4
     2956             sym5
     2957             sym6
     2958             with frame r-stkard.
     2959           down stream PrnLibStream with frame r-stkard.
     2960         end.
     2961       end.
     2962     end.
     2963   end.
