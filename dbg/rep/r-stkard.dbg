     1595      out-vatp-have-vat-sltprl = yes.
     1596   end.
     1597   else do:
     1598     find first out-vatp_doc-attrprl no-lock
     1599       where out-vatp_doc-attrprl.doc-code  = vardoc-code
     1600         and out-vatp_doc-attrprl.attr-code = 'envd':U
     1601         no-error .
     1602     if not available out-vatp_doc-attrprl then do:
     1603       assign
     1604         out-vatp-have-vat-sltprl = yes.
     1605     end.
     1606     else do:
