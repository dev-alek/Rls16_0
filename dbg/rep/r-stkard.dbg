     1611                                      out-vatp_goodsprl.prod-type = varprod-type and
     1612                                      out-vatp_goodsprl.prod-code = varprod-code no-lock.
     1613   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
