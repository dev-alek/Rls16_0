      588   define  stream PrnLibStream.
      589   procedure prn-lib-prn-file :
      590     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      591     define input parameter p-DIsabledoptions as integer no-undo .
      592     define variable v-report-name as character no-undo .
      593     define variable v-user-action as character no-undo .
      594     define variable v-printed     as logical   no-undo .
      595     define variable v-exist       as logical   no-undo .
      596     do
      597       on error undo, return error
      598       :
      599       run prn-lib-get-report-name  in this-procedure (
      600         input parParentProc
      601         ,output v-report-name
      602         ).
      603   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      605     (input  v-report-name
      606     ,input  2
      607     ,output v-exist
      608     )  .
      609       if NOT v-exist then
      610       DO:
      611         Message
      612           "Нет заданий на печать ! "
      613           view-as alert-box .
      614         Return  .
      615       End.
      616       run gbl/prnfilen.w
      617         (input  ""
      618         ,input  p-DisabledOptions
      619         ,input  string(v-report-name )
      620         ,input  7
      621         ,output v-user-action
      622         ,output v-printed
      623         ) .
      624       if v-printed then
      625       do:
      626         return "YES" .
      627       end.
      628       else
      629       do:
      630         return "NO" .
      631       end.
      632     end.
      633   end procedure.
      634   procedure prn-lib-open-stream :
      635     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      636     define input parameter p-page-size    as integer no-undo .
      637     define input parameter p-is-stream    as logical no-undo .
      638     define input parameter p-append       as logical no-undo .
      639     define variable v-report-name as character no-undo .
      640     do
      641       on error undo, return error
      642       :
      643       run prn-lib-get-report-name  in this-procedure (
      644         input parParentProc
      645         ,output v-report-name
      646         ).
      647       if p-is-stream then
      648       do:
      649         if p-append then
      650         do:
      651           output stream PrnLibStream to value( v-report-name )
      652             page-size value(p-page-size) append .
      653         end.
      654         if not p-append then
      655         do:
      656           output stream PrnLibStream to value( v-report-name )
      657             page-size value(p-page-size) .
      658         end.
      659       end.
      660       if not p-is-stream then
      661       do:
      662         if p-append then
      663         do:
      664           output to value( v-report-name )
      665             page-size value(p-page-size) append .
      666         end.
      667         if not p-append then
      668         do:
      669           output to value( v-report-name )
      670             page-size value(p-page-size) .
      671         end.
      672       end.
      673     end.
      674   end procedure.
      675   procedure prn-lib-open-exp :
      676     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      677     define input parameter p-is-stream    as logical no-undo .
      678     define input parameter p-is-append    as logical no-undo .
      679     define output parameter p-ReportFileName as char init "report" no-undo.
      680     define output parameter p-process as logical no-undo .
      681     define variable glog as logical no-undo .
      682     do
      683       on error undo, return error
      684       :
      685       SYSTEM-DIALOG GET-FILE p-ReportFileName
      686         TITLE      "Укажите путь"
      687         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      688         ASK-OVERWRITE
      689         CREATE-TEST-FILE
      690         SAVE-AS
      691         USE-FILENAME
      692         DEFAULT-EXTENSION "txt"
      693         UPDATE glog
      694         .
      695       if not glog then  return.
      696       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      697       if p-is-stream then
      698       do:
      699         if p-is-append then
      700         do:
      701           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      702         end.
      703         else
      704         do:
      705           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      706         end.
      707       end.
      708       else
      709       do:
      710         if p-is-append then
      711         do:
      712           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      713         end.
      714         else
      715         do:
      716           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      717         end.
      718       end.
      719       p-process = yes.
      720     end.
      721   end procedure.
      722   procedure prn-lib-get-report-name :
      723     define input parameter parParentProc  as widget-handle no-undo.
      724     define output parameter p-report-name as character no-undo .
      725     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      726   end procedure.
      727   procedure prn-lib-reportviewer-report-name :
      728     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      729     define input parameter p-report-name-html as character no-undo .
      730     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      731   end procedure.
      732   procedure prn-lib-reportviewer :
      733     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      734     define input parameter p-report-name-html as character no-undo .
      735     define input parameter p-param        as character no-undo .
      736     define variable v-excel           as character no-undo init 'TRUE' .
      737     define variable v-value-character as character no-undo .
      738     define variable v-value-integer   as character no-undo .
      739     define variable v-value-date      as date      no-undo .
      740     define variable v-value-decimal   as decimal   no-undo .
      741     define variable rep-excel         as logical   no-undo .
      742     define variable excel-string      as character no-undo .
      743     define variable v-param-type      as character no-undo .
      744     define variable v-tth             as handle    no-undo .
      745     run adm/shattri.p (
      746       input "get":U
      747       ,input  ""
      748       ,input  0
      749       ,input  'report-glob':U
      750       ,input  'rep-excel':U
      751       ,output v-value-character
      752       ,output v-value-date
      753       ,output v-value-decimal
      754       ,output v-value-integer
      755       ,output rep-excel
      756       ,output v-param-type
      757       ,INPUT-OUTPUT table-handle v-tth
      758       )  .
      759     if rep-excel then v-excel = "TRUE" .
      760     else v-excel = "FALSE" .
      761     if p-param eq ""
      762     then
      763        p-param = "EXCEL:" + v-excel.
      764     else
      765        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      766     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      767   end procedure.
      768   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   define variable v-waitfram-action01         as character   no-undo .
      770   define variable v-waitfram-action02         as character   no-undo .
      771   define variable v-waitfram-action03         as character   no-undo .
      772   define variable mWaitFramTextBeg            as character   no-undo.
      773   define variable mWaitFramTextEnd            as character   no-undo.
      774   define variable mWaitFramView               as logical     no-undo.
      775   define variable mWaitProcEvent              as logical     no-undo init yes.
      776   define variable mWaitFramInterval           as integer     no-undo init 1 .
      777   define variable mWaitFramStop               as logical     no-undo.
      778   define variable mWaitFramStopUser           as logical     no-undo.
      779   define variable mWaitFramStopTimeOut        as logical     no-undo.
      780   define variable mWaitFramStartProc          as datetime-tz no-undo.
      781   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      782   define button B-WaitFramStop auto-end-key
      783        label "Стоп"
      784        size 10 by 1 tooltip "Остоновить процесс".
      785   define button B-viewProcInfo
      786        label "Информация"
      787        size 15 by 1 tooltip "Информация о процесс".
      788   define frame waitfram
      789     v-waitfram-action01 format "x(72)" no-label skip
      790     v-waitfram-action02 format "x(72)" no-label skip
      791     v-waitfram-action03 format "x(72)" no-label skip
      792     B-viewProcInfo
      793     B-WaitFramStop at row 4 col 30
      794     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      795     .
      796   define new global shared variable mBatchMode as logical no-undo init ?.
      797   define variable mFramBachModHandle as handle no-undo.
      798   mFramBachModHandle = frame waitfram:handle.
      799   define variable mFameOldVis as logical no-undo.
      800   define variable mVisCUrentVin as logical no-undo.
      801   if session:batch-mode
      802   then
      803      mBatchMode = yes.
      804   if mBatchMode = ? then do:
      805     mVisCUrentVin = current-window:visible.
      806     mFameOldVis = mFramBachModHandle:visible.
      807     mFramBachModHandle:visible  = yes.
      808     mBatchMode = mFramBachModHandle:visible ne yes.
      809     mFramBachModHandle:visible = mFameOldVis.
      810     current-window:visible = mVisCUrentVin.
      811   end.
      812    if  log-manager:logfile-name ne ?
      813     then DO:
      814         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      815         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      816         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      817     end.
      818   on choose of B-WaitFramStop in frame waitfram
      819   do:
      820     mWaitFramStop = yes.
      821     mWaitFramStopUser = yes.
      822   end.
      823   function waitfram-check-timeout returns logical():
      824      define variable vtime as int64 no-undo.
      825      if mWaitFramStopTimeOut
      826      then
      827         return yes.
      828      vtime = ( now - mWaitFramStartProc ) / 1000 .
      829      if     mWaitFramTimeOut ne ?
      830         and mWaitFramTimeOut ne 0
      831         and mWaitFramTimeOut lt vtime
      832      then do:
      833         mWaitFramStopTimeOut = yes.
      834      end.
      835      return mWaitFramStopTimeOut.
      836   end.
      837   procedure waitfram-hide :
      838     if not session:batch-mode
      839     then do
      840     on error undo, return error return-value
      841     :
      842       pause 0 before-hide .
      843       if not mBatchMode then
      844         hide frame waitfram .
      845     if     not mWaitFramView
      846        and mWaitProcEvent
      847     then
      848       process events .
      849     end.
      850   end procedure.
      851   procedure waitfram-show :
      852     define input  parameter p-message as character no-undo .
      853     define variable v-left-margin as integer   no-undo .
      854     if not session:batch-mode
      855     then do
      856     on error undo, return error return-value
      857     :
      858       if length(p-message) <= 70 then do:
      859         assign
      860           v-left-margin = integer((70 - length(p-message)) / 2)
      861         .
      862         assign
      863           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      864         .
      865         assign
      866           v-waitfram-action01 = " "
      867           v-waitfram-action02 = " "
      868                                    + fill(" ", v-left-margin)
      869                                    + p-message
      870           v-waitfram-action03 = " "
      871         .
      872       end.
      873       else do:
      874         define variable vRindex1 as integer no-undo.
      875         define variable vRindex2 as integer no-undo.
      876         vRindex1 = r-index(p-message," ",70).
      877         if vRindex1 = 0
      878         then
      879            vRindex1 = 70.
      880         if length(p-message)  <= vRindex1 + 70 then do:
      881           assign
      882             v-waitfram-action01 = " "
      883             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      884             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      885           .
      886         end.
      887         else do:
      888           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      889           if vRindex2 <= vRindex1
      890           then
      891              vRindex2 = vRindex1 + 70.
      892           assign
      893             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      894             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      895             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      896           .
      897         end.
      898       end.
      899       B-viewProcInfo:visible   in frame waitfram = no.
      900       B-viewProcInfo:sensitive in frame waitfram = no.
      901       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      902       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      903       if  (   mWaitFramView
      904          or  mWaitProcEvent)
      905          and not mBatchMode
      906       then
      907          display
      908             v-waitfram-action01 skip
      909             v-waitfram-action02 skip
      910             v-waitfram-action03 skip
      911          with frame waitfram .
      912       if     mWaitFramView
      913          then do:
      914             if     mWaitFramInterval ne ?
      915                and not mBatchMode
      916             then
      917                wait-for go of frame waitfram pause mWaitFramInterval.
      918          end.
      919          else
      920             if     mWaitProcEvent
      921                and not mBatchMode
      922             then
      923                process events .
      924     end.
      925   end procedure.
      926      procedure waitfram-show-this:
      927         define input  parameter iInterval as int64 no-undo.
      928         define variable vtime as int64 no-undo.
      929         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      930         mWaitFramInterval = iInterval.
      931         run waitfram-show (substitute("&1&2 &3&4" ,
      932                                       mWaitFramTextBeg ,
      933                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      934                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      935                                       mWaitFramTextEnd
      936                                      )
      937                           ).
      938      end.
      939      procedure WaitFramRunPause:
      940         define input  parameter iInterval as dec no-undo.
      941         define variable vStart  as datetime-tz no-undo.
      942         define variable vend    as datetime-tz no-undo.
      943         define variable vint as int64 no-undo.
      944         define variable vOk as logical no-undo.
      945         vStart = now.
      946         vend   = vStart.
      947         publish "WaitFramPause" (iInterval,output vOk).
      948         vend   =  now.
      949         vint = vend - vStart.
      950         vint = iInterval - vint / 1000.
      951         if     not mWaitFramStop
      952            and (   vint > 0
      953                 or (    not vOk
      954                     and iInterval eq ?
      955                     )
      956                 )
      957         then
      958            run waitfram-show-this (iInterval).
      959         vend   =  now.
      960         vint = vend - vStart.
      961         vint = iInterval - vint / 1000.
      962         if     not mWaitFramStop
      963            and vint > 0
      964         then do:
      965            run gbl/pause.p (vint * 1000).
      966         end.
      967         if iInterval ne ?
      968         then
      969            publish "WaitFramStop".
      970         waitfram-check-timeout().
      971      end.
      972      procedure WaitFramWaitFor:
      973         define input  parameter iInterval as dec no-undo.
      974         assign
      975            mWaitFramStartProc   = now
      976            mWaitFramStopUser    = no
      977            mWaitFramStopTimeOut = no
      978         .
      979         block-wait:
      980         do while not mWaitFramStop:
      981            run WaitFramRunPause (iInterval).
      982            if  waitfram-check-timeout()
      983            then do:
      984               leave block-wait.
      985            end.
      986         end.
      987         run waitfram-hide.
      988      end.
      989   procedure waitfram-join :
      990     define input  parameter p-line-1  as character no-undo .
      991     define input  parameter p-line-2  as character no-undo .
      992     define input  parameter p-line-3  as character no-undo .
      993     define output parameter p-message as character no-undo .
      994     do
      995     on error undo, return error return-value
      996     :
      997       assign
      998         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      999                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1000                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1001       .
     1002     end.
     1003   end procedure.
     1004   function waitfram-join-function returns character
     1005     (input p-line-1 as character
     1006     ,input p-line-2 as character
     1007     ,input p-line-3 as character
     1008     ).
     1009     define variable v-message as character no-undo .
     1010     run waitfram-join in this-procedure
     1011       (input  p-line-1
     1012       ,input  p-line-2
     1013       ,input  p-line-3
     1014       ,output v-message
     1015       ) .
     1016     return v-message .
     1017   end function .
     1018   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1019   procedure cur-time :
     1020      define output parameter p-today as date      no-undo .
     1021      define output parameter p-time  as integer   no-undo .
     1022     do
     1023     on error undo, return error
     1024     :
     1025       define variable v-date1 as date      no-undo .
     1026       define variable v-date2 as date      no-undo .
     1027       define variable v-time  as integer   no-undo .
     1028       assign
     1029         v-date1 = today
     1030         v-time  = time
     1031         v-date2 = today
     1032       .
     1033       if v-date1 <> v-date2
     1034       then do:
     1035         assign
     1036           v-date1 = today
     1037           v-time  = v-time
     1038         .
     1039       end.
     1040       assign
     1041         p-today = v-date1
     1042         p-time  = v-time
     1043       .
     1044     end.
     1045   end.
     1046   function cur-time-date returns character
     1047   :
     1048     return string(today, '99/99/9999':U) .
     1049   end.
     1050   function cur-time-mjd returns decimal
     1051   :
     1052     define variable v-date as date      no-undo .
     1053     define variable v-time as integer   no-undo .
     1054     run cur-time in this-procedure
     1055       (output v-date
     1056       ,output v-time
     1057       ) .
     1058     return integer(v-date) - 2400002 + (v-time / 86400) .
     1059   end.
     1060   function cur-time-get-ending-index returns integer
     1061   (input p-number as integer
     1062   )
     1063   :
     1064     if p-number < 0
     1065     or p-number = ?
     1066     then do:
     1067       return 1 .
     1068     end.
     1069     define variable v-rest as integer   no-undo .
     1070     assign
     1071       p-number = p-number modulo 100
     1072     .
     1073     if p-number < 20
     1074     then do:
     1075       assign
     1076         v-rest = p-number
     1077       .
     1078     end.
     1079     else do:
     1080       assign
     1081         v-rest = p-number modulo 10
     1082       .
     1083     end.
     1084     case v-rest :
     1085       when 1
     1086       then do:
     1087         return 2 .
     1088       end.
     1089       when 2 or
     1090       when 3 or
     1091       when 4
     1092       then do:
     1093         return 3 .
     1094       end.
     1095       otherwise do:
     1096         return 1 .
     1097       end.
     1098     end case .
     1099   end.
     1100   procedure cur-time-mjd-to-date :
     1101      define input  parameter i-mjd-diff as decimal no-undo.
     1102      define output parameter o-Date     as date    no-undo.
     1103      define output parameter o-Time     as integer no-undo.
     1104      define variable v-day-number as integer   no-undo .
     1105      if    i-mjd-diff < 0
     1106         or i-mjd-diff = ?
     1107      then do:
     1108         return "?" .
     1109      end.
     1110      assign
     1111         v-day-number = truncate(i-mjd-diff,0).
     1112         o-Date = date(v-day-number + 2400002).
     1113         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1114     .
     1115   end.
     1116   function cur-time-mjd-to-string returns character
     1117   (input p-mjd-diff as decimal
     1118   )
     1119   :
     1120     define variable v-day-number as integer   no-undo .
     1121     define variable v-seconds    as integer   no-undo .
     1122     define variable v-hour       as integer   no-undo .
     1123     define variable v-min        as integer   no-undo .
     1124     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1125     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1126     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1127     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1128     if p-mjd-diff < 0
     1129     or p-mjd-diff = ?
     1130     then do:
     1131       return "?" .
     1132     end.
     1133     assign
     1134       v-day-number = integer(truncate(p-mjd-diff,0))
     1135       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1136     .
     1137     if v-seconds > 86400
     1138     then do:
     1139       assign
     1140         v-seconds = 86400 - 1
     1141       .
     1142     end.
     1143     if v-seconds < 0
     1144     then do:
     1145       assign
     1146         v-seconds = 0
     1147       .
     1148     end.
     1149     assign
     1150       v-hour = truncate(v-seconds / 3600, 0)
     1151     .
     1152     assign
     1153       v-seconds = v-seconds modulo 3600
     1154     .
     1155     assign
     1156       v-min = truncate(v-seconds / 60, 0)
     1157     .
     1158     assign
     1159       v-seconds = v-seconds modulo 60
     1160     .
     1161     return
     1162         (if v-day-number <> 0
     1163           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1164           else ""
     1165         )
     1166       + (if v-day-number <> 0 or v-hour <> 0
     1167           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1168           else ""
     1169         )
     1170       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1171           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1172           else ""
     1173         )
     1174       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1175       .
     1176   end.
     1177   function cur-time-string returns character
     1178   :
     1179     define variable v-date as date      no-undo .
     1180     define variable v-time as integer   no-undo .
     1181     run cur-time in this-procedure
     1182       (output v-date
     1183       ,output v-time
     1184       ) .
     1185     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1186   end.
     1187   function cur-time-string-sec returns character
     1188   :
     1189     define variable v-date as date      no-undo .
     1190     define variable v-time as integer   no-undo .
     1191     run cur-time in this-procedure
     1192       (output v-date
     1193       ,output v-time
     1194       ) .
     1195     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1196   end.
     1197   function cur-time-custom  returns character
     1198   (input p-prefix as character
     1199   ,input p-date-format as character
     1200   ,input p-delimiter as character
     1201   ,input p-time-format as character
     1202   ,input p-suffix as character
     1203   )
     1204   :
     1205     define variable v-date as date      no-undo .
     1206     define variable v-time as integer   no-undo .
     1207     run cur-time in this-procedure
     1208       (output v-date
     1209       ,output v-time
     1210       ) .
     1211     return
     1212       p-prefix
     1213       + string(v-date, p-date-format)
     1214       + p-delimiter
     1215       + string(v-time, p-time-format)
     1216       + p-suffix
     1217       .
     1218   end.
     1219   function cur-time-print  returns character
     1220   :
     1221     define variable v-date as date      no-undo .
     1222     define variable v-time as integer   no-undo .
     1223     run cur-time in this-procedure
     1224       (output v-date
     1225       ,output v-time
     1226       ) .
     1227     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1228   end.
     1229   function cur-time-datetime returns datetime
     1230   :
     1231     define variable v-char as character no-undo .
     1232     define variable v-datetime as datetime no-undo .
     1233     v-char = cur-time-string().
     1234     v-datetime = datetime(v-char).
     1235     return  v-datetime.
     1236   end.
     1237   function cur-time-string-msec returns character
     1238   :
     1239     define variable v-date as datetime  no-undo .
     1240     v-date = now.
     1241     return string(v-date) .
     1242   end.
