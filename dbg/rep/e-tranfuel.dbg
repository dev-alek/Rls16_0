     1094   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1095   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1096   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1097   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1098   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1099   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1100   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1101   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1102         adm-object-hdl = FRAME F-Main:HANDLE.
     1103   RUN ensure-broker.
     1104   THIS-PROCEDURE:ADM-DATA =
     1105        'ADM1.1~`':U +
     1106        'SmartObject~`':U +
     1107        '~`':U +
     1108        'NO ~`':U +
     1109        '~`':U +
     1110        '~`':U +
     1111        '~`':U +
     1112        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1113           + "~`":U +
     1114        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1115        'Record-Source,Record-Target,TableIO-Target~`':U +
     1116        '~`':U +
     1117        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1118        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1119            THEN "^^":U
     1120        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1121             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1122   PROCEDURE adm-apply-entry :
     1123     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1124   END PROCEDURE.
     1125   PROCEDURE adm-destroy :
     1126    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1127   END PROCEDURE.
     1128   PROCEDURE adm-disable :
     1129       DISABLE RECT-5 RECT-8 RECT-6 RECT-9 RECT-7 RECT-10 mGds mTRK mGds-list mTRKList mTranTimeMax mCashPay mCashPay-list mChkType mChkType-list mGrpChk mGrpTran WITH FRAME F-Main.
     1130       RUN dispatch ('disable-fields':U).
     1131       RUN set-attribute-list ('ENABLED=no':U).
     1132       RETURN.
     1133   END PROCEDURE.
     1134   PROCEDURE adm-edit-attribute-list :
     1135         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1136         RETURN.
     1137   END PROCEDURE.
     1138   PROCEDURE adm-enable :
     1139       ENABLE UNLESS-HIDDEN RECT-5 RECT-8 RECT-6 RECT-9 RECT-7 RECT-10 mGds mTRK mGds-list mTRKList mTranTimeMax mCashPay mCashPay-list mChkType mChkType-list mGrpChk mGrpTran WITH FRAME F-Main.
     1140       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1141       RUN set-attribute-list ('ENABLED=yes':U).
     1142       RETURN.
     1143   END PROCEDURE.
     1144   PROCEDURE adm-exit :
     1145        RUN notify ('exit':U).
     1146     RETURN.
     1147   END PROCEDURE.
     1148   PROCEDURE adm-hide :
     1149     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1150   END PROCEDURE.
     1151   PROCEDURE adm-initialize :
     1152     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1153   END PROCEDURE.
     1154   PROCEDURE adm-show-errors :
     1155       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1156       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1157           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1158       END.
     1159       RETURN.
     1160   END PROCEDURE.
     1161   PROCEDURE adm-UIB-mode :
     1162     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1163   END PROCEDURE.
     1164   PROCEDURE adm-view :
     1165     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1166   END PROCEDURE.
     1167   PROCEDURE dispatch :
     1168       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1169       RUN broker-dispatch IN adm-broker-hdl
     1170           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1171       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1172   END PROCEDURE.
     1173   PROCEDURE ensure-broker :
     1174   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1175   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1176   DO:
     1177       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1178       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1179   END.
     1180   END PROCEDURE.
     1181   PROCEDURE get-attribute :
     1182     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1183     RUN broker-get-attribute IN adm-broker-hdl
     1184         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1185     RETURN RETURN-VALUE.
     1186   END PROCEDURE.
     1187   PROCEDURE get-attribute-list :
     1188     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1189     RUN broker-get-attribute-list IN adm-broker-hdl
     1190         (INPUT THIS-PROCEDURE,
     1191          INPUT ?,
     1192          OUTPUT p-attr-list) NO-ERROR.
     1193     RETURN.
     1194   END PROCEDURE.
     1195   PROCEDURE new-state :
     1196     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1197     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1198     RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE notify :
     1201     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1202     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1203     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1204         RETURN "ADM-ERROR":U.
     1205     RETURN.
     1206   END PROCEDURE.
     1207   PROCEDURE set-attribute-list :
     1208     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1209     RUN ensure-broker.
     1210     RUN broker-set-attribute-list IN adm-broker-hdl
     1211         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1212     RETURN.
     1213   END PROCEDURE.
     1214   PROCEDURE set-position :
     1215       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1216       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1217       IF VALID-HANDLE(adm-object-hdl) THEN
     1218       DO:
     1219         ASSIGN adm-object-hdl:ROW    =   p-row
     1220                adm-object-hdl:COLUMN =   p-col.
     1221       END.
     1222       RETURN.
     1223   END PROCEDURE.
     1224   PROCEDURE adm-display-fields :
     1225       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1226       RETURN.
     1227   END PROCEDURE.
     1228   PROCEDURE adm-open-query :
     1229     RETURN.
     1230   END PROCEDURE.
     1231   PROCEDURE adm-row-changed :
     1232         IF VALID-HANDLE(adm-object-hdl) THEN
     1233           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1234         RUN notify ('row-available':U).
     1235         RETURN.
     1236   END PROCEDURE.
     1237   PROCEDURE reposition-query :
     1238       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1239       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1240       RETURN.
     1241   END PROCEDURE.
     1242     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1243     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1244     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1245     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1246     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1247     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1248     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1249     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1250     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1251     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1252     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1253     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1254     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1255     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1256     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1257     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1258     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1259     IF "":U = "":U THEN
     1260       RUN modify-list-attribute IN adm-broker-hdl
     1261         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1262     RUN use-create-on-add(?).
     1263   PROCEDURE adm-add-record :
     1264       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1265          "must have at least one Enabled Table to perform Add.":U
     1266          VIEW-AS ALERT-BOX ERROR.
     1267       RETURN.
     1268   END PROCEDURE.
     1269   PROCEDURE adm-assign-record :
     1270    MESSAGE
     1271          "Object ":U THIS-PROCEDURE:FILE-NAME
     1272            "must have at least one Enabled Table to perform Assign.":U
     1273              VIEW-AS ALERT-BOX ERROR.
     1274      RETURN.
     1275     END PROCEDURE.
     1276   PROCEDURE adm-assign-statement :
     1277     RETURN.
     1278   END PROCEDURE.
     1279   PROCEDURE adm-cancel-record :
     1280      RETURN.
     1281     END PROCEDURE.
     1282   PROCEDURE adm-copy-record :
     1283       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1284        "must have at least one Enabled Table to perform Copy.":U
     1285          VIEW-AS ALERT-BOX ERROR.
     1286       RETURN.
     1287   END PROCEDURE.
     1288   PROCEDURE adm-create-record :
     1289      RETURN.
     1290   END PROCEDURE.
     1291   PROCEDURE adm-current-changed :
     1292     RETURN.
     1293   END PROCEDURE.
     1294   PROCEDURE adm-delete-record :
     1295    MESSAGE
     1296          "Object ":U THIS-PROCEDURE:FILE-NAME
     1297            "must have at least one Enabled Table to perform Delete.":U
     1298              VIEW-AS ALERT-BOX ERROR.
     1299       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1300       RETURN.
     1301   END PROCEDURE.
     1302   PROCEDURE adm-disable-fields :
     1303         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1304       RETURN.
     1305   END PROCEDURE.
     1306   PROCEDURE adm-enable-fields :
     1307       RETURN.
     1308   END PROCEDURE.
     1309   PROCEDURE adm-end-update :
     1310     RETURN.
     1311   END PROCEDURE.
     1312   PROCEDURE adm-reset-record :
     1313       RETURN.
     1314   END PROCEDURE.
     1315   PROCEDURE adm-update-record :
     1316       MESSAGE
     1317         "Object ":U THIS-PROCEDURE:FILE-NAME
     1318           "must have at least one Enabled Table to perform Update.":U
     1319             VIEW-AS ALERT-BOX ERROR.
     1320      RETURN.
     1321   END PROCEDURE.
     1322   PROCEDURE check-modified :
     1323   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1324   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1325   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1326   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1327     IF check-state = "check":U THEN
     1328     DO:
     1329       RUN get-link-handle IN adm-broker-hdl
     1330         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1331            OUTPUT group-target-list).
     1332       IF group-target-list NE "":U THEN
     1333       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1334         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1335         RUN check-modified IN curr-widget ('group-check':U).
     1336         IF RETURN-VALUE NE "":U THEN
     1337         DO:
     1338           RUN check-modified-message(RETURN-VALUE).
     1339           RETURN "":U.
     1340         END.
     1341       END.
     1342     END.
     1343     RETURN "":U.
     1344   END PROCEDURE.
     1345   PROCEDURE check-modified-message :
     1346     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1347        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1348           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1349        IF RETURN-VALUE = "YES":U THEN
     1350           RUN notify ('view,CONTAINER-SOURCE':U).
     1351        MESSAGE IF p-changed-table NE ? THEN
     1352           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1353           ELSE "Current values have been changed."
     1354           SKIP "  Do you wish to save those changes?"
     1355           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1356        IF ANS THEN
     1357        DO:
     1358           IF group-assign-target THEN
     1359             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1360           ELSE RUN dispatch('update-record':U).
     1361           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1362           DO:
     1363               MESSAGE "Changes to the previous record were not saved."
     1364                 VIEW-AS ALERT-BOX ERROR.
     1365               IF group-assign-target THEN
     1366                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1367               ELSE RUN dispatch ('cancel-record':U).
     1368           END.
     1369        END.
     1370        ELSE DO:
     1371          IF group-assign-target THEN
     1372             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1373          ELSE RUN dispatch('cancel-record':U).
     1374        END.
     1375        RETURN.
     1376   END PROCEDURE.
     1377   PROCEDURE get-rowid :
     1378       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1379       ASSIGN
     1380       p-table   =   adm-first-table.
     1381       RETURN.
     1382   END PROCEDURE.
     1383   PROCEDURE init-group-assign :
     1384       RUN request-attribute IN adm-broker-hdl
     1385         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1386       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1387         group-assign-target = yes.
     1388       ELSE group-assign-target = no.
     1389       RETURN.
     1390   END PROCEDURE.
     1391   PROCEDURE set-editors :
     1392       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1393       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1394       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1395       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1396       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1397       DO WHILE VALID-HANDLE (curr-widget):
     1398           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1399              curr-widget:HIDDEN = no THEN DO:
     1400             CASE p-field-setting:
     1401               WHEN "INITIALIZE":U THEN
     1402               DO:
     1403                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1404                     read-only-list +
     1405                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1406                        STRING(curr-widget).
     1407               END.
     1408               WHEN "DISABLE":U OR
     1409               WHEN "ENABLE":U THEN
     1410               DO:
     1411                   curr-widget:SENSITIVE = yes.
     1412                   RUN get-attribute ('Read-Only-Editors':U).
     1413                   IF RETURN-VALUE = ? OR
     1414                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1415                       curr-widget:READ-ONLY =
     1416                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1417               END.
     1418               WHEN "CLEAR":U THEN
     1419                   curr-widget:SCREEN-VALUE = "":U.
     1420             END CASE.
     1421           END.
     1422           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1423       END.
     1424       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1425         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1426           + '"':U).
     1427       RETURN.
     1428   END PROCEDURE.
     1429   PROCEDURE use-check-modified-all :
     1430    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1431     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1432     RETURN.
     1433   END PROCEDURE.
     1434   PROCEDURE use-create-on-add :
     1435   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1436      RETURN.
     1437   END PROCEDURE.
     1438   PROCEDURE use-initial-lock :
     1439     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1440     ASSIGN adm-initial-lock = p-attr-value.
     1441     RETURN.
     1442   END PROCEDURE.
     1443     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1444   ASSIGN
     1445          FRAME F-Main:SCROLLABLE       = FALSE
     1446          FRAME F-Main:HIDDEN           = TRUE.
     1447   ASSIGN
     1448          mCashPay-list:HIDDEN IN FRAME F-Main           = TRUE
     1449          mCashPay-list:READ-ONLY IN FRAME F-Main        = TRUE.
     1450   ASSIGN
     1451          mChkType-list:HIDDEN IN FRAME F-Main           = TRUE
     1452          mChkType-list:READ-ONLY IN FRAME F-Main        = TRUE.
     1453   ASSIGN
     1454          mGds-list:HIDDEN IN FRAME F-Main           = TRUE
     1455          mGds-list:READ-ONLY IN FRAME F-Main        = TRUE.
     1456   ASSIGN
     1457          mTRKList:HIDDEN IN FRAME F-Main           = TRUE.
     1458   ON MOUSE-SELECT-DBLCLICK OF mCashPay IN FRAME F-Main
     1459   DO:
     1460      apply "VALUE-CHANGED" to mCashPay in frame F-Main.
     1461   END.
     1462   ON VALUE-CHANGED OF mCashPay IN FRAME F-Main
     1463   DO:
     1464      do with frame F-Main:
     1465         assign mCashPay.
     1466         if mCashPay = "All" then do:
     1467            disable mCashPay-list.
     1468            mCashPay-list:visible = no.
     1469            mCashPayList = "*".
     1470         end.
     1471         else do:
     1472            run select-cash-pays.
     1473            enable mCashPay-list.
     1474            mCashPay-list:visible = yes.
     1475         end.
     1476      end.
     1477   END.
     1478   ON MOUSE-SELECT-DBLCLICK OF mChkType IN FRAME F-Main
     1479   DO:
     1480      apply "VALUE-CHANGED" to mChkType in frame F-Main.
     1481   END.
     1482   ON VALUE-CHANGED OF mChkType IN FRAME F-Main
     1483   DO:
     1484      do with frame F-Main:
     1485         assign mChkType.
     1486         if mChkType = "All" then do:
     1487            disable mChkType-list.
     1488            mChkType-list:visible = no.
     1489            mChkTypeCodeList = "*".
     1490         end.
     1491         else do:
     1492            run select-chk-type.
     1493            enable mChkType-list.
     1494            mChkType-list:visible = yes.
     1495         end.
     1496      end.
     1497   END.
     1498   ON MOUSE-SELECT-DBLCLICK OF mGds IN FRAME F-Main
     1499   DO:
     1500      apply "VALUE-CHANGED" to mGds in frame F-Main.
     1501   END.
     1502   ON VALUE-CHANGED OF mGds IN FRAME F-Main
     1503   DO:
     1504      do with frame F-Main:
     1505         assign mGds.
     1506         if mGds = "All" then do:
     1507            disable mGds-list.
     1508            mGds-list:visible = no.
     1509            mGdsCodeList = "*".
     1510         end.
     1511         else do:
     1512            run select-gds.
     1513            enable mGds-list.
     1514            mGds-list:visible = yes.
     1515         end.
     1516      end.
     1517   END.
     1518   ON LEAVE OF mTranTimeMax IN FRAME F-Main
     1519   DO:
     1520      assign frame F-Main mTranTimeMax.
     1521   END.
     1522   ON VALUE-CHANGED OF mTRK IN FRAME F-Main
     1523   DO:
     1524      do with frame F-Main:
     1525         assign mTrk.
     1526         if mTrk = "All" then do:
     1527            disable mTRKList.
     1528            mTRKList:visible = no.
     1529         end.
     1530         else do:
     1531            enable mTRKList.
     1532            mTRKList:visible = yes.
     1533         end.
     1534      end.
     1535   END.
     1536   ON LEAVE OF mTRKList IN FRAME F-Main
     1537   DO:
     1538      assign frame F-Main mTRKList.
     1539   END.
     1540   if not this-procedure :persistent
     1541   then do:
     1542     message
     1543       vss-workfile vss-revision vss-description skip
     1544       "Ошибка при запуске процедуры" skip
     1545       "Данную процедуру следует запускать только с параметром persistent" skip
     1546       view-as alert-box error .
     1547     undo, return error .
     1548   end.
     1549   parParentProc = my-handle.
     1550   display mTranTimeMax with frame F-Main.
     1551   PROCEDURE cb_set-cp-list :
     1552     define output parameter o-rid-list as character no-undo.
     1553     assign
     1554       o-rid-list = m-rid-list
     1555     .
     1556   END PROCEDURE.
     1557   PROCEDURE disable_UI :
     1558     HIDE FRAME F-Main.
     1559     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1560   END PROCEDURE.
     1561   PROCEDURE my-report :
     1562      assign frame F-Main
     1563         mTrk
     1564         mGrpChk
     1565         mGrpTran.
     1566      run rep/r-tranfuel.p (v-cntxt-host-code-obj,
     1567                            mChkTypeCodeList,
     1568                            mGdsCodeList,
     1569                            mCashPayList,
     1570                            (if mTrk = "All" then "*" else mTRKList),
     1571                            mTranTimeMax,
     1572                            mGrpChk,
     1573                            mGrpTran
     1574                           ).
     1575   END PROCEDURE.
     1576   PROCEDURE my-var :
     1577   END PROCEDURE.
     1578   PROCEDURE select-cash-pays :
     1579      define buffer cash-pay for cash-pay.
     1580      define variable vI            as int64     no-undo.
     1581      define variable vCashPay-list as character no-undo.
     1582      run ref/cashpays.w
     1583          ( input parparentproc
     1584          , input "b-mark,b-sel"
     1585          , input 'все':U
     1586          , input v-cntxt-host-code-obj
     1587          , input v-cntxt-obj-type
     1588          , input v-cntxt-obj-code
     1589          , output m-rid-list ) no-error .
     1590      mCashPayList = "".
     1591      do vI = 1 to num-entries(m-rid-list):
     1592         find first cash-pay where
     1593                    recid(cash-pay) = integer(entry(vI, m-rid-list))
     1594         no-lock no-error.
     1595         if available cash-pay then do:
     1596            assign
     1597               mCashPayList  = mCashPayList  + "," + string(cash-pay.cdpay-code)
     1598               vCashPay-list = vCashPay-list + "," + cash-pay.obj-name.
     1599         end.
     1600      end.
     1601      vCashPay-list = trim(vCashPay-list, ",").
     1602      mCashPayList = trim(mCashPayList, ",").
     1603      mCashPay-list:screen-value in frame F-Main = vCashPay-list.
     1604   END PROCEDURE.
     1605   PROCEDURE select-chk-type :
     1606      define variable vChkType-list as character no-undo.
     1607      run ref/chk-type.w(input parparentproc) no-error.
     1608      mChkTypeCodeList = "".
     1609      for each tt-chk-type where
     1610               tt-chk-type.sel = yes:
     1611         assign
     1612            vChkType-list    = vChkType-list    + "," + tt-chk-type.name
     1613            mChkTypeCodeList = mChkTypeCodeList + "," + string(tt-chk-type.code)
     1614            .
     1615      end.
     1616      assign
     1617         vChkType-list    = trim(vChkType-list, ",")
     1618         mChkTypeCodeList = trim(mChkTypeCodeList, ",")
     1619         .
     1620      mChkType-list:screen-value in frame F-Main = vChkType-list.
     1621   END PROCEDURE.
     1622   PROCEDURE select-gds :
     1623      define buffer goods for goods.
     1624      define buffer units for units.
     1625      define variable vGdsName-list as character no-undo.
     1626      define variable v-recid-list  as character no-undo.
     1627      define variable vRecId        as recid     no-undo.
     1628      define variable vAnswer       as logical   no-undo.
     1629      define variable vI            as integer   no-undo.
     1630      run ref/gds-ref.p (
     1631                          input parparentproc
     1632                         ,input "b-mark,b-sel"
     1633                         ,input 'все':U
     1634                         ,input "ptrl"
     1635                         ,input ?
     1636                         ,input ?
     1637                         ,input ?
     1638                         ,input ?
     1639                         ,input ?
     1640                         ,input v-cntxt-obj-type
     1641                         ,input v-cntxt-obj-code
     1642                         ,input ?
     1643                         ,output v-recid-list).
     1644      if v-recid-list = "" and can-find(first gds-list) then do:
     1645         message
     1646            "Не было выбрано ни одного товара. Очистить список ранее выбранных товаров?"
     1647         view-as alert-box QUESTION buttons YES-NO update vAnswer.
     1648         if not vAnswer then return.
     1649      end.
     1650      mGdsCodeList = "".
     1651      empty temp-table gds-list.
     1652      do vI = 1 to num-entries(v-recid-list):
     1653         vRecId = integer(entry(vI, v-recid-list)).
     1654         find first goods where
     1655                    recid(goods) = vRecId
     1656         no-lock no-error.
     1657         if avail goods then do:
     1658            create gds-list.
     1659            buffer-copy goods to gds-list.
     1660         end.
     1661      end.
     1662      for each gds-list no-lock:
     1663         find first goods where
     1664                    goods.artic     = gds-list.artic
     1665                and goods.prod-type = gds-list.prod-type
     1666                and goods.prod-code = gds-list.prod-code
     1667         no-lock no-error .
     1668         if not available goods then do:
     1669            delete gds-list.
     1670            next.
     1671         end.
     1672         find first units where
     1673                    units.unit-name = goods.unit-base
     1674         no-lock no-error .
     1675         if not available units then do:
     1676            delete gds-list.
     1677            next.
     1678         end.
     1679         if not can-do(units.type, 'топ':U) then do:
     1680            delete gds-list .
     1681            next.
     1682         end.
     1683         assign
     1684            vGdsName-list = vGdsName-list + "," + string(goods.gds-code) + "(" + goods.gds-name + ")"
     1685            mGdsCodeList  = mGdsCodeList  + "," + string(goods.gds-code)
     1686            .
     1687      end.
     1688      assign
     1689         vGdsName-list = trim(vGdsName-list, ",")
     1690         mGdsCodeList  = trim(mGdsCodeList, ",")
     1691         .
     1692      mGds-list:screen-value in frame F-Main = vGdsName-list.
     1693   END PROCEDURE.
     1694   PROCEDURE state-changed :
     1695     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1696     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1697     CASE p-state:
     1698     END CASE.
     1699   END PROCEDURE.
