    11491   end.
    11492   assign
    11493   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
    11494   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
    11495                   assign
    11496                       VAT-gds = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
    11497                       SLT-gds = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
    11498                       price-withNDS = ( if PrintRubl then price-rubl-with-tax-sale else price-base-with-tax-sale )
    11499                   .
    11500               end.
    11501               if VAT-gds = ? then VAT-gds = 0.
    11502               if SLT-gds = ? then SLT-gds = 0.
