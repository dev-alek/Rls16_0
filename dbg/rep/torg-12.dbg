    14149                       v-line-counter  = v-line-counter + 1
    14150                   .
    14151                   run writelog in this-procedure (log-file-name, 4,
    14152                                           "Снова вычислили суммы для строки. Сумма с НДС ( "
    14153                                           + dtm-char( string( stoim ) )
    14154                                           + " )"
    14155                                                       ).
    14156               end.
    14157   define variable vss-include-info76 as character format "X(65)" no-undo
    14158   initial "@(#)$Workfile$ $Revision$".
    14159       if FullGdsName
