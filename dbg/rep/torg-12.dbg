     4619   procedure torg12xl-run-excel :
     4620   define input parameter p-header-filename    as character        no-undo.
     4621   define input parameter p-data-filename      as character        no-undo.
     4622       define variable v-template-file-name    as character    no-undo.
     4623       define variable v-vb-file-name          as character    no-undo.
     4624       define buffer buf_temp-param for temp-param .
     4625   do
     4626   for buf_temp-param
     4627   on error undo, return error
     4628   :
     4629       create buf_temp-param.
     4630       if lookup( "TOPAUKC":U, p-mode ) <> 0
     4631       then do:
     4632         if lookup( "GTD":U, p-mode ) <> 0
     4633         then do:
     4634           assign
     4635               v-template-file-name    = search( "exe/t12_97bb.xlt" )
     4636           .
     4637         end.
     4638         else do:
     4639           assign
     4640               v-template-file-name    = search( "exe/t12_97b.xlt" )
     4641           .
     4642         end.
     4643       end.
     4644       else do:
     4645         assign
     4646             v-template-file-name    = search( "exe/t12_97.xlt" )
     4647           .
     4648         end.
     4649       assign
     4650           v-vb-file-name          = search( "exe/t_97.bas")
     4651       .
     4652       if v-template-file-name = ?
     4653       or v-template-file-name = "":U
     4654       then do:
     4655           message
     4656               "Ошибка имени файла шаблона."
     4657           view-as alert-box error.
     4658       end.
     4659       if v-vb-file-name = ?
     4660       or v-vb-file-name = "":U
     4661       then do:
     4662           message
     4663               "Ошибка имени файла кода обработки."
     4664           view-as alert-box error.
     4665       end.
     4666       run paramls-write in this-procedure (
     4667             input "template":U
     4668           , input "template-file-name":U
     4669           , input v-template-file-name
     4670       ).
     4671       run paramls-write in this-procedure (
     4672             input "template":U
     4673           , input "vb-file-name":U
     4674           , input v-vb-file-name
     4675       ).
     4676       run paramls-write in this-procedure (
     4677             input "data":U
     4678           , input "data-header-filename":U
     4679           , input p-header-filename
     4680       ).
     4681       run paramls-write in this-procedure (
     4682             input "data":U
     4683           , input "data-filename":U
     4684           , input p-data-filename
     4685       ).
     4686       run gbl/macroxlt.p (
     4687           input-output table buf_temp-param
     4688       ) no-error.
     4689       if error-status :error
     4690       then do:
     4691           message
     4692                    vss-workfile vss-revision vss-description
     4693               skip(1)
     4694               skip "Ошибка создания файла Excel."
     4695               skip return-value
     4696               skip trim(error-status :get-message(1))
     4697                    trim(error-status :get-message(2))
     4698                    trim(error-status :get-message(3))
     4699           view-as alert-box error.
     4700           undo, return error .
     4701       end.
     4702   end.
     4703   end procedure.
     4704   define variable vss-include-info22 as character format "X(65)" no-undo
     4705   initial "@(#)$Workfile$ $Revision$".
     4706   define temp-table sj-t12 no-undo
     4707   field b-code                          like ub.bar-code.b-code
     4708   field gds-code                        like ub.goods.gds-code
     4709   field prt-code                        like ub.gds-dtl.prt-code
     4710   field artic                           like ub.goods.artic
     4711   field prod-type                       like ub.goods.prod-type
     4712   field prod-code                       like ub.goods.prod-code
     4713   field doc-qnty                        like ub.gds-dtl.doc-qnty
     4714   field fact-qnty                       like ub.gds-dtl.fact-qnty
     4715   field gds-dtl-qnty                    like ub.gds-dtl.doc-qnty
     4716   field cur-base                        like ub.gds-dtl.cur-base
     4717   field discnt-base                     like ub.gds-dtl.discnt-base
     4718   field discnt-pc                       like ub.gds-dtl.discnt-pc
     4719   field discnt-rubl                     like ub.gds-dtl.discnt-rubl
     4720   field discnt-type                     like ub.gds-dtl.discnt-type
     4721   field doc-code                        like ub.gds-dtl.doc-code
     4722   field obj-code                        like ub.gds-dtl.obj-code
     4723   field obj-type                        like ub.gds-dtl.obj-type
     4724   field ov                              like ub.gds-dtl.ov
     4725   field price-base                      like ub.gds-dtl.price-base
     4726   field price-rubl                      like ub.gds-dtl.price-rubl
     4727   field vat-pc                           like ub.doc-line.vat-pc
     4728   field slt-pc                           like ub.doc-line.slt-pc
     4729   field price-rubl-with-tax-sale         like ub.gds-dtl.price-rubl
     4730   field price-base-with-tax-sale         like ub.gds-dtl.price-base
     4731   field price-rubl-without-tax-sale      like ub.gds-dtl.price-rubl
     4732   field price-base-without-tax-sale      like ub.gds-dtl.price-base
     4733   field vat-base-sale                    like ub.gds-dtl.price-base
     4734   field vat-rubl-sale                    like ub.gds-dtl.price-rubl
     4735   field vat-base-buyer                   like ub.gds-dtl.price-base
     4736   field vat-rubl-buyer                   like ub.gds-dtl.price-rubl
     4737   field slt-base-sale                    like ub.gds-dtl.price-base
     4738   field slt-rubl-sale                    like ub.gds-dtl.price-rubl
     4739   field road-tax-base-sale               like ub.gds-dtl.price-base
     4740   field road-tax-rubl-sale               like ub.gds-dtl.price-rubl
     4741   field excise-base-sale                 like ub.gds-dtl.price-base
     4742   field excise-rubl-sale                 like ub.gds-dtl.price-rubl
     4743   field discnt-base-sale                 like ub.gds-dtl.price-base
     4744   field discnt-rubl-sale                 like ub.gds-dtl.price-rubl
     4745   field is-ok                            as logical
     4746   field calced                           as logical
     4747   index pi is unique primary
     4748   b-code
     4749   index iok
     4750   is-ok
     4751   .
     4752   procedure fill-sjt12 :
     4753     _main:
     4754     do
     4755     on error undo, return error
     4756     :
     4757       define input parameter p-doc-code like ub.trn-doc.doc-code no-undo .
     4758       define variable v-inkas-code like ub.inkas.inkas-code no-undo .
     4759       define variable v-trn-doc-code like ub.trn-doc.doc-code no-undo .
     4760       define variable v-ret-doc-code like ub.trn-doc.out-code no-undo .
     4761       define variable v-doc-code     like ub.trn-doc.doc-code no-undo .
     4762       define variable check-v-doc-code     like ub.trn-doc.doc-code no-undo .
     4763       define buffer buf_trn-doc for ub.trn-doc.
     4764       define buffer buf_ret-doc for ub.trn-doc.
     4765       define buffer buf_inkas for ub.inkas.
     4766       define buffer buf_chk-doc for ub.chk-doc.
     4767       define buffer buf_chk-gds for ub.chk-gds.
     4768       define buffer buf_goods for ub.goods.
     4769       define buffer buf_bar-code for ub.bar-code.
     4770       define buffer buf_sj-t12 for sj-t12.
     4771       define buffer buf_gds-dtl for ub.gds-dtl.
     4772       define buffer buf_doc-line for ub.doc-line.
     4773       define buffer buf_sale-doc for ub.sale-doc.
     4774         FOR EACH sj-t12 :
     4775           delete sj-t12 .
     4776         END .
     4777         find first buf_trn-doc no-lock where
     4778                   buf_trn-doc.doc-code = p-doc-code no-error .
     4779         if not available buf_trn-doc then do:
     4780           undo _main, return error substitute("Не найден документ с номером &1", p-doc-code).
     4781         end.
     4782         if NOT (buf_trn-doc.ext-doc-type = 'es':U
     4783                 or
     4784                 buf_trn-doc.ext-doc-type = 'rs':U
     4785                 ) then do:
     4786           undo _main, return error substitute("Неверный тип документа &1: &2", p-doc-code, buf_trn-doc.ext-doc-type).
     4787         end.
     4788         if buf_trn-doc.ext-doc-type = 'es':U then do:
     4789           assign
     4790           v-inkas-code = buf_trn-doc.doc-code
     4791           v-trn-doc-code = buf_trn-doc.doc-code
     4792           v-ret-doc-code = buf_trn-doc.out-code
     4793           v-doc-code     = v-trn-doc-code
     4794           .
     4795         end.
     4796         else do:
     4797           assign
     4798           v-inkas-code = buf_trn-doc.out-code
     4799           v-trn-doc-code = buf_trn-doc.out-code
     4800           v-ret-doc-code = buf_trn-doc.doc-code
     4801           v-doc-code     = v-ret-doc-code
     4802           .
     4803         end.
     4804         _chk-doc:
     4805         FOR EACH buf_chk-doc No-LOCK WHERE
     4806                   buf_chk-doc.obj-type = buf_trn-doc.obj-type AND
     4807                   buf_chk-doc.obj-code = buf_trn-doc.obj-code AND
     4808                   buf_chk-doc.out-code = v-inkas-code,
     4809             EACH buf_chk-gds WHERE
     4810                   buf_chk-gds.doc-code = buf_chk-doc.doc-code NO-LOCK,
     4811             FIRST buf_bar-code WHERE
     4812                   buf_bar-code.b-code = buf_chk-gds.b-code NO-LOCK,
     4813             FIRST buf_goods WHERE
     4814                   buf_goods.gds-code = buf_bar-code.gds-code
     4815                   :
     4816           if lookup(string(buf_chk-doc.chk-type), '14,15,16,36,17,8,11,12,13,40,101,106,108,169,196,114,115,116,117,111,112,136,113,201,206,208,301,306,2,3,4,5,7,43,44':U) > 0 then next _chk-doc.
     4817           if num-entries(buf_chk-gds.line-type, chr(4)) > 1 then do:
     4818             find first buf_sale-doc no-lock where
     4819                       buf_sale-doc.inkas-code = v-inkas-code
     4820                   and buf_sale-doc.doc-kind = entry(1, entry(2, buf_chk-gds.line-type, chr(4))) no-error .
     4821             if available buf_sale-doc then do:
     4822               assign
     4823               check-v-doc-code = buf_sale-doc.doc-code.
     4824             end.
     4825           end.
     4826           if v-doc-code = '':U then do:
     4827             if buf_chk-doc.netto >= 0 then
     4828             check-v-doc-code = v-trn-doc-code.
     4829             else
     4830             check-v-doc-code = v-ret-doc-code.
     4831           end.
     4832           if check-v-doc-code <> v-doc-code then do:
     4833            next _chk-doc.
     4834          end.
     4835           FIND FIRST buf_gds-dtl WHERE
     4836                     buf_gds-dtl.doc-code  = v-doc-code AND
     4837                     buf_gds-dtl.artic     = buf_goods.artic AND
     4838                     buf_gds-dtl.prod-type = buf_goods.prod-type AND
     4839                     buf_gds-dtl.prod-code = buf_goods.prod-code AND
     4840                     buf_gds-dtl.prt-code  = buf_bar-code.node-code NO-LOCK NO-ERROR .
     4841           if available buf_gds-dtl then do:
