     4500       .
     4501       assign
     4502           buf_temp_line-data.data-key     = "LD":U
     4503           buf_temp_line-data.xl-line-id   = v-torg12xl-current-data-row
     4504           buf_temp_line-data.id           = p-id
     4505           buf_temp_line-data.Name         = p-Name
