    10997                                   , dtm-char( v-tax-name )
    10998                                   , dtm-char( string( p-tax ) ) )
    10999           ).
    11000           if p-round = "round":U
    11001           then do:
    11002               run p-fmt-round in this-procedure (
    11003                     input tqnty
    11004                   , input p-tax-price
    11005                   , input 0
    11006                   , input 0
    11007                   , input 0
    11008                   , output p-tax-price
