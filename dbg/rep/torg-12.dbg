     8716           string( "Главный бухгалтер:                               _________________  " + v-torgconf-main-buh ) format "X(93)" " |"
     8717           at 96 string( "Груз принял:                   " + string(p-torgconf-accept-position,"X(17)") + "  ___________________ " + string(p-torgconf-accept-fname,"X(24)")) format "X(100)" at 99 skip
     8718                    "                             (подпись)       (расшифровка подписи)" at 25 "|" at 97  "     (должность)       (подпись)        (расшифровка подписи)" at 131 skip.
     8719       if lookup( "KEDR":U, p-mode ) <> 0
     8720       then do:
     8721           put stream out-stream
     8722                   "по приказу №            ____________             _________________  ________________________"   "|" at 97 skip
     8723                   "                        (должность)                  (подпись)       (расшифровка подписи)"   "|" at 97 skip
     8724           .
     8725       end.
     8726       put stream out-stream
     8727       "Отпуск груза произвел: "
     8728       .
     8729         if trim(p-torgconf-post) = ""
     8730         or v-torgconf-outsubs <> no
     8731         or v-ext-doc-type = 'ie':U
     8732         then do:
     8733           put stream out-stream
     8734               " ____________ " format "X(25)"
     8735           .
     8736         end.
     8737         else do:
     8738           put stream out-stream
     8739               p-torgconf-post format "X(25)"
     8740           .
     8741         end.
     8742       put stream out-stream
     8743           string(  " _________________  " + p-torgconf-wrkr-name ) format "X(48)" "|" at 97  "Груз получил грузополучатель:    " v-loadtplace Format "x(17)" " ___________________ " v-loadtname Format "X(26)" skip
     8744                    "(должность)                  (подпись)       (расшифровка подписи)" at 25 "|" at 97  "     (должность)       (подпись)        (расшифровка подписи)" at 131 skip
     8745           "М.П." at 15  '    "___"___________ ___ года' "|" at 97 "М.П." at 99  '     "___"___________ ___ года' skip
     8746       .
     8747       run torg12xl-close in this-procedure  (input p-mode).
     8748   if session :set-wait-state( "" ) then.
     8749       output stream out-stream close.
     8750   if g#quest-print = false
     8751   then do:
     8752     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     8753                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     8754                                         OUTPUT g#log ).
     8755   end.
     8756   else do:
     8757     os-command silent
     8758       value( "COPY /b " +
     8759         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     8760         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     8761         string( session:temp-directory) +  "$" + string( g#report-num )
     8762                 ) .
     8763     os-command silent
     8764       value( "COPY /b " +
     8765         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     8766         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     8767         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     8768                 ) .
     8769   end.
     8770   end.
     8771   procedure print-line :
     8772   define input parameter p-trn-doc-code   as character        no-undo.
     8773   define input parameter p-sort-type      as character        no-undo.
     8774   define variable v-price-is-changed      as logical  no-undo.
     8775   define variable v-sum-prt-qnty                  as decimal      no-undo.
     8776   define variable v-avg-prt-price                 as decimal      no-undo.
     8777   define variable v-avg-prt-price-no-tax          as decimal      no-undo.
     8778   define variable v-sum-SLT                       as decimal      no-undo.
     8779   define variable v-sum-VAT                       as decimal      no-undo.
     8780   define variable v-avg-VAT                       as decimal      no-undo.
     8781   define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
     8782   define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
     8783   define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
     8784   define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
     8785   define variable v-gds-name-length               as integer      no-undo.
     8786   define variable v-gds-name                      as character    no-undo.
     8787   define variable v-void-decimal                  as decimal      no-undo.
     8788   define variable v-price-no-VAT                  as decimal      no-undo.
     8789   define variable v-VAT-pc                        as decimal      no-undo.
     8790   define variable v-SLT-pc                        as decimal      no-undo.
     8791       define buffer buf_trn-doc       for ub.trn-doc.
     8792       define buffer buf_tax_parts     for ub.parts.
     8793       define buffer buf_temp_gds-name for temp_gds-name.
     8794   do
     8795   for buf_trn-doc
     8796     , buf_tax_parts
     8797     , buf_temp_gds-name
     8798   on error undo, return error
     8799   :
     8800       run writelog in this-procedure (log-file-name, 1, "Печать строки товара").
     8801       find first buf_trn-doc no-lock
     8802            where buf_trn-doc.doc-code = p-trn-doc-code
     8803       .
     8804       empty temp-table buf_temp_gds-name.
     8805       assign
     8806           v-torg-12-gds-name-key  = 0
     8807           v-gds-name              = (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
     8808       .
     8809       if FullGdsName
     8810       and v-gds-name <> "":U
     8811       then do:
     8812           do
     8813           while v-gds-name <> "":U
     8814           :
     8815               assign
     8816                   v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     8817               .
     8818               create buf_temp_gds-name.
     8819               assign
     8820                   buf_temp_gds-name.gdn-key = v-torg-12-gds-name-key
     8821               .
     8822               run p-fmt-split-string in this-procedure (
     8823                     input v-gds-name
     8824                   , input v-torg-12-gds-name-length
     8825                   , output buf_temp_gds-name.gdnString
     8826                   , output v-gds-name
     8827               ).
     8828           end.
     8829           if line-counter( out-stream ) + v-torg-12-gds-name-key > page-size( out-stream )
     8830           then do:
     8831   define variable vss-include-info52 as character format "X(65)" no-undo
     8832   initial "@(#)$Workfile$ $Revision$".
     8833   if page-number( out-stream ) > prevpage then
     8834       assign
     8835           Pg-tqnty = 0
     8836           Pg-VAT-gds = 0
     8837           Pg-SLT-gds = 0
     8838           Pg-stoim-noNDS = 0
     8839           Pg-stoim = 0
     8840           .
     8841           do:
     8842               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     8843               then do:
     8844                 put stream out-stream "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip.
     8845               end.
     8846               else do:
     8847                 put stream out-stream v-single-line format "x(198)" skip.
     8848               end.
     8849               if v-torgconf-outt12 = yes
     8850               then do:
     8851                                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     8852                 then do:
     8853                   display stream out-stream
     8854                       "Итого" @ ub.goods.gds-name
     8855                       Pg-tqnty @ tqnty
     8856                       Pg-stoim-noNDS @ stoim-noNDS
     8857                       Pg-VAT-gds  @ VAT-gds
     8858                       Pg-stoim @ stoim
     8859                   with frame f-doc-m-bb .
     8860                   down stream out-stream 1 with frame f-doc-m-bb .
     8861                 end.
     8862                 else do:
     8863                     display stream out-stream
     8864                         "Итого" @ ub.goods.gds-name
     8865                         Pg-tqnty @ tqnty
     8866                         Pg-stoim-noNDS @ stoim-noNDS
     8867                         Pg-VAT-gds  @ VAT-gds
     8868                         Pg-stoim @ stoim
     8869                     with frame f-doc-m .
     8870                     down stream out-stream 1 with frame f-doc-m .
     8871                 end.
     8872               end.
     8873               else do:
     8874                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     8875                 then do:
     8876                   display stream out-stream
     8877                       "Итого" @ ub.goods.gds-name
     8878                       Pg-tqnty @ tqnty
     8879                       Pg-stoim-noNDS @ stoim-noNDS
     8880                       Pg-VAT-gds  @ VAT-gds
     8881                       Pg-stoim @ stoim
     8882                   with frame f-doc-bb .
     8883                   down stream out-stream 1 with frame f-doc-bb .
     8884                 end.
     8885                 else do:
     8886                   display stream out-stream
     8887                       "Итого" @ ub.goods.gds-name
     8888                       Pg-tqnty @ tqnty
     8889                       Pg-stoim-noNDS @ stoim-noNDS
     8890                       Pg-VAT-gds  @ VAT-gds
     8891                       Pg-stoim @ stoim
     8892                   with frame f-doc .
     8893                   down stream out-stream 1 with frame f-doc .
     8894                 end.
     8895               end.
     8896           end.
     8897               PAGE stream out-stream.
     8898           end.
     8899           find first buf_temp_gds-name
     8900                where buf_temp_gds-name.gdn-key = 1
     8901           no-error.
     8902           if available buf_temp_gds-name
     8903           then do:
     8904           assign
     8905                   v-gds-name    = buf_temp_gds-name.gdnString
     8906           .
     8907       end.
     8908       else do:
     8909           assign
     8910                       v-gds-name    = (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
     8911           .
     8912       end.
     8913       end.
     8914       else do:
     8915           assign
     8916               v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
     8917           .
     8918           create buf_temp_gds-name.
     8919           assign
     8920               buf_temp_gds-name.gdn-key   = v-torg-12-gds-name-key
     8921               buf_temp_gds-name.gdnString = v-gds-name
     8922           .
     8923       end.
     8924       run writelog in this-procedure (
     8925           log-file-name,
     8926           2,
     8927           substitute( "Определили наименование товара ( &1 )", v-gds-name )
     8928                                           ).
     8929       find first ub.gds-prt no-lock
     8930            where ub.gds-prt.upper-code = ub.goods.prt-root
     8931       .
     8932       assign
     8933           v-rootnode-code = gds-prt.node-code
     8934       .
     8935       if ( ( gds-prt.node-name <> '_Пустая шкала':U )
     8936           and v-cntxp-doc-prt = yes )
     8937       and ( not Invers )
     8938       and ( lookup( "TOPAUKC":U, p-mode ) = 0 and lookup( "GTD":U, p-mode ) = 0 )
     8939       then do:
     8940           run writelog in this-procedure (log-file-name, 2, "Не пустая шкала, не отключена печать по шкалам и накладная не от имени поставщика").
     8941           find first ub.gds-dtl no-lock
     8942               where ub.gds-dtl.prod-type = ub.doc-line.prod-type
     8943                 and ub.gds-dtl.prod-code = doc-line.prod-code
     8944                 and ub.gds-dtl.artic     = doc-line.artic
     8945                 and ub.gds-dtl.doc-code  = doc-line.doc-code
     8946           no-error.
     8947           if not available (gds-dtl)
     8948           then assign
     8949               price-noNDS   = 0
     8950               price-withNDS = 0
     8951           .
     8952           if PrintScale
     8953           then do:
     8954               if v-torgconf-outt12 = yes
     8955               then do:
     8956                   display stream out-stream
     8957                       v-doc-line-counter
     8958                       v-gds-name @ ub.goods.gds-name
     8959                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8960                       sym11 sym12 sym13 sym14 sym15 sym16
     8961                       with frame f-doc-m .
     8962                   down stream out-stream  with frame f-doc-m .
     8963               end.
     8964               else do:
     8965                   display stream out-stream
     8966                       v-doc-line-counter
     8967                       v-gds-name @ ub.goods.gds-name
     8968                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     8969                       sym11 sym12 sym13 sym14 sym15 sym16  sym18
     8970                       with frame f-doc .
     8971                   down stream out-stream  with frame f-doc .
     8972               end.
     8973               run torg12xl-write-line-data in this-procedure (
     8974                     input v-doc-line-counter
     8975                   , input (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
     8976                   , input "":U
     8977                   , input "":U
     8978                   , input "":U
     8979                   , input "":U
     8980                   , input "":U
     8981                   , input "":U
     8982                   , input "":U
     8983                   , input "":U
     8984                   , input "":U
     8985                   , input "":U
     8986                   , input "":U
     8987                   , input "":U
     8988                   , input "":U
     8989               ).
     8990   define variable vss-include-info53 as character format "X(65)" no-undo
     8991   initial "@(#)$Workfile$ $Revision$".
     8992       if FullGdsName
     8993       then do:
     8994           for each temp_gds-name
     8995              where temp_gds-name.gdn-key > 1
     8996           :
     8997               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     8998               then do:
     8999                 if v-torgconf-outt12 = yes
     9000                 then do:
     9001                     display stream out-stream
     9002                         temp_gds-name.gdnString     @ ub.goods.gds-name
     9003                         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     9004                         sym11 sym12 sym13 sym14 sym15 sym16  sym20 sym21
     9005                     with frame f-doc-m-bb .
     9006                     down stream out-stream 1 with frame f-doc-m-bb .
     9007                 end.
     9008                 else do:
     9009                     display stream out-stream
     9010                         temp_gds-name.gdnString @ ub.goods.gds-name
     9011                         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     9012                         sym11 sym12 sym13 sym14 sym15 sym16  sym18  sym20 sym21
     9013                     with frame f-doc-bb .
     9014                     down stream out-stream 1 with frame f-doc-bb .
     9015                 end.
     9016               end.
     9017               else do:
     9018                 if v-torgconf-outt12 = yes
     9019                 then do:
     9020                     display stream out-stream
     9021                         temp_gds-name.gdnString     @ ub.goods.gds-name
     9022                         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     9023                         sym11 sym12 sym13 sym14 sym15 sym16
     9024                     with frame f-doc-m .
     9025                     down stream out-stream 1 with frame f-doc-m .
     9026                 end.
     9027                 else do:
     9028                     display stream out-stream
     9029                         temp_gds-name.gdnString @ ub.goods.gds-name
     9030                         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
     9031                         sym11 sym12 sym13 sym14 sym15 sym16  sym18
     9032                     with frame f-doc .
     9033                     down stream out-stream 1 with frame f-doc .
     9034                 end.
     9035               end.
     9036           end.
     9037       end.
     9038   if page-number( out-stream ) > prevpage then
     9039       assign
     9040           Pg-tqnty = 0
     9041           Pg-VAT-gds = 0
     9042           Pg-SLT-gds = 0
     9043           Pg-stoim-noNDS = 0
     9044           Pg-stoim = 0
     9045           .
     9046       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
     9047           do:
     9048               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     9049               then do:
     9050                 put stream out-stream "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip.
     9051               end.
     9052               else do:
     9053                 put stream out-stream v-single-line format "x(198)" skip.
     9054               end.
     9055               if v-torgconf-outt12 = yes
     9056               then do:
     9057                                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     9058                 then do:
     9059                   display stream out-stream
     9060                       "Итого" @ ub.goods.gds-name
     9061                       Pg-tqnty @ tqnty
     9062                       Pg-stoim-noNDS @ stoim-noNDS
     9063                       Pg-VAT-gds  @ VAT-gds
     9064                       Pg-stoim @ stoim
     9065                   with frame f-doc-m-bb .
     9066                   down stream out-stream 1 with frame f-doc-m-bb .
     9067                 end.
     9068                 else do:
     9069                     display stream out-stream
     9070                         "Итого" @ ub.goods.gds-name
     9071                         Pg-tqnty @ tqnty
     9072                         Pg-stoim-noNDS @ stoim-noNDS
     9073                         Pg-VAT-gds  @ VAT-gds
     9074                         Pg-stoim @ stoim
     9075                     with frame f-doc-m .
     9076                     down stream out-stream 1 with frame f-doc-m .
     9077                 end.
     9078               end.
     9079               else do:
     9080                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     9081                 then do:
     9082                   display stream out-stream
     9083                       "Итого" @ ub.goods.gds-name
     9084                       Pg-tqnty @ tqnty
     9085                       Pg-stoim-noNDS @ stoim-noNDS
     9086                       Pg-VAT-gds  @ VAT-gds
     9087                       Pg-stoim @ stoim
     9088                   with frame f-doc-bb .
     9089                   down stream out-stream 1 with frame f-doc-bb .
     9090                 end.
     9091                 else do:
     9092                   display stream out-stream
     9093                       "Итого" @ ub.goods.gds-name
     9094                       Pg-tqnty @ tqnty
     9095                       Pg-stoim-noNDS @ stoim-noNDS
     9096                       Pg-VAT-gds  @ VAT-gds
     9097                       Pg-stoim @ stoim
     9098                   with frame f-doc .
     9099                   down stream out-stream 1 with frame f-doc .
     9100                 end.
     9101               end.
     9102           end.
     9103               assign
     9104                   v-line-counter = v-line-counter + 1
     9105                   v-doc-line-counter = v-doc-line-counter + 1
     9106               .
     9107           end.
     9108           for each ub.gds-dtl no-lock
     9109              where ub.gds-dtl.prod-type  = ub.doc-line.prod-type
     9110                and gds-dtl.prod-code  = doc-line.prod-code
     9111                and gds-dtl.artic      = doc-line.artic
     9112                and gds-dtl.doc-code   = doc-line.doc-code
     9113           :
     9114               find first gds-prt no-lock
     9115                       where gds-prt.node-code = gds-dtl.prt-code
     9116               .
     9117   if buf_trn-doc.ext-doc-type = 'ot':U or
     9118      buf_trn-doc.ext-doc-type = ?                 then do:
     9119     assign
     9120      out-vatp-have-vat-slt = yes.
     9121   end.
     9122   else do:
     9123     find first out-vatp_doc-attr no-lock
     9124       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
     9125         and out-vatp_doc-attr.attr-code = 'envd':U
     9126         no-error .
     9127     if not available out-vatp_doc-attr then do:
     9128       assign
     9129         out-vatp-have-vat-slt = yes.
     9130     end.
     9131     else do:
     9132        out-vatp-have-vat-slt = no.
     9133     end.
     9134   end.
     9135   find first out-vatp_goods where out-vatp_goods.artic     = doc-line.artic     and
     9136                                      out-vatp_goods.prod-type = doc-line.prod-type and
     9137                                      out-vatp_goods.prod-code = doc-line.prod-code no-lock.
     9138   define variable vss-include-info54 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     9139   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     9140     (input  doc-line.artic
     9141     ,input  doc-line.prod-type
     9142     ,input  doc-line.prod-code
     9143     ,output varroot-node
     9144     ) no-error .
     9145   if error-status :error then do:
     9146     message
