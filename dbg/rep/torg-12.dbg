        1   block-level on error undo, throw.
        2   define input parameter p-mainmenu-handle    as handle           no-undo.
        3   define input parameter rec_id               as recid            no-undo.
        4   define input parameter Invers               as logical          no-undo.
        5   define input parameter p-mode               as character        no-undo.
        6   define input parameter p-round              as character        no-undo.
        7   define input parameter p-from-check         as logical          no-undo.
        8   define input parameter p-reverse            as logical          no-undo.
        9   define variable vss-revision    as character no-undo init "$Revision: c2e03acbfec4, 3152, rls $":U .
       10   define variable vss-author      as character no-undo init "$Author: VSpiridonov $":U .
       11   define variable vss-date        as character no-undo init "$Date: 2022/12/27 12:54:22 $":U .
       12   define variable vss-workfile    as character no-undo init "$Workfile: torg-12.p $":U .
       13   define variable vss-archive     as character no-undo init "$Archive: rep/torg-12.p $":U .
       14   define variable vss-description as character no-undo init "Печатные формы. Торг-12 для внешнего прихода, расхода и возврата поставщику".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   define new global shared variable g#language as character no-undo .
       70   if g#language <> '' and g#language <> 'rus':U then do:
       71     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       72   end.
       73   define new global shared variable g#library  as handle no-undo .
       74   define new global shared variable g#library2 as handle no-undo .
       75   define new global shared variable g#lib-trn  as handle no-undo .
       76   define new global shared variable g#lib-trn2 as handle no-undo .
       77   define new global shared variable g#lib-trn3 as handle no-undo .
       78   define new global shared variable g#lib-trn4 as handle no-undo .
       79   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       80   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
       81   define  shared variable RepPathName        as character no-undo .
       82   define  shared variable PrintRubl          as logical   no-undo .
       83   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       84   function breakstr returns character ( input        for-name    as character,
       85                                         input        line-length as integer,
       86                                         input-output line1       as character,
       87                                         input-output line2       as character ) :
       88     define variable ii as integer no-undo.
       89     if length( for-name ) > line-length then do:
       90       assign ii    = 1
       91              line1 = "":u
       92              line2 = "":u.
       93       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       94         assign line1 =       substring( for-name, 1, line-length     )
       95                line2 = trim( substring( for-name,    line-length + 1 ) ).
       96       end.                                                     else do:
       97         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       98           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       99                  ii    = ii    + 1.
      100           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
      101             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
      102           end.
      103         end.
      104         assign line2 = trim( substring( for-name, length( line1 ) ) ).
      105       end.
      106     end.                                else do:
      107       assign line1 = for-name
      108              line2 = "":u.
      109     end.
      110     return ( line1 ).
      111   end function.
      112   define variable vss-include-info2 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      113   procedure cur-time :
      114      define output parameter p-today as date      no-undo .
      115      define output parameter p-time  as integer   no-undo .
      116     do
      117     on error undo, return error
      118     :
      119       define variable v-date1 as date      no-undo .
      120       define variable v-date2 as date      no-undo .
      121       define variable v-time  as integer   no-undo .
      122       assign
      123         v-date1 = today
      124         v-time  = time
      125         v-date2 = today
      126       .
      127       if v-date1 <> v-date2
      128       then do:
      129         assign
      130           v-date1 = today
      131           v-time  = v-time
      132         .
      133       end.
      134       assign
      135         p-today = v-date1
      136         p-time  = v-time
      137       .
      138     end.
      139   end.
      140   function cur-time-date returns character
      141   :
      142     return string(today, '99/99/9999':U) .
      143   end.
      144   function cur-time-mjd returns decimal
      145   :
      146     define variable v-date as date      no-undo .
      147     define variable v-time as integer   no-undo .
      148     run cur-time in this-procedure
      149       (output v-date
      150       ,output v-time
      151       ) .
      152     return integer(v-date) - 2400002 + (v-time / 86400) .
      153   end.
      154   function cur-time-get-ending-index returns integer
      155   (input p-number as integer
      156   )
      157   :
      158     if p-number < 0
      159     or p-number = ?
      160     then do:
      161       return 1 .
      162     end.
      163     define variable v-rest as integer   no-undo .
      164     assign
      165       p-number = p-number modulo 100
      166     .
      167     if p-number < 20
      168     then do:
      169       assign
      170         v-rest = p-number
      171       .
      172     end.
      173     else do:
      174       assign
      175         v-rest = p-number modulo 10
      176       .
      177     end.
      178     case v-rest :
      179       when 1
      180       then do:
      181         return 2 .
      182       end.
      183       when 2 or
      184       when 3 or
      185       when 4
      186       then do:
      187         return 3 .
      188       end.
      189       otherwise do:
      190         return 1 .
      191       end.
      192     end case .
      193   end.
      194   procedure cur-time-mjd-to-date :
      195      define input  parameter i-mjd-diff as decimal no-undo.
      196      define output parameter o-Date     as date    no-undo.
      197      define output parameter o-Time     as integer no-undo.
      198      define variable v-day-number as integer   no-undo .
      199      if    i-mjd-diff < 0
      200         or i-mjd-diff = ?
      201      then do:
      202         return "?" .
      203      end.
      204      assign
      205         v-day-number = truncate(i-mjd-diff,0).
      206         o-Date = date(v-day-number + 2400002).
      207         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      208     .
      209   end.
      210   function cur-time-mjd-to-string returns character
      211   (input p-mjd-diff as decimal
      212   )
      213   :
      214     define variable v-day-number as integer   no-undo .
      215     define variable v-seconds    as integer   no-undo .
      216     define variable v-hour       as integer   no-undo .
      217     define variable v-min        as integer   no-undo .
      218     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      219     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      220     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      221     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      222     if p-mjd-diff < 0
      223     or p-mjd-diff = ?
      224     then do:
      225       return "?" .
      226     end.
      227     assign
      228       v-day-number = integer(truncate(p-mjd-diff,0))
      229       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      230     .
      231     if v-seconds > 86400
      232     then do:
      233       assign
      234         v-seconds = 86400 - 1
      235       .
      236     end.
      237     if v-seconds < 0
      238     then do:
      239       assign
      240         v-seconds = 0
      241       .
      242     end.
      243     assign
      244       v-hour = truncate(v-seconds / 3600, 0)
      245     .
      246     assign
      247       v-seconds = v-seconds modulo 3600
      248     .
      249     assign
      250       v-min = truncate(v-seconds / 60, 0)
      251     .
      252     assign
      253       v-seconds = v-seconds modulo 60
      254     .
      255     return
      256         (if v-day-number <> 0
      257           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      258           else ""
      259         )
      260       + (if v-day-number <> 0 or v-hour <> 0
      261           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      262           else ""
      263         )
      264       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      265           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      266           else ""
      267         )
      268       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      269       .
      270   end.
      271   function cur-time-string returns character
      272   :
      273     define variable v-date as date      no-undo .
      274     define variable v-time as integer   no-undo .
      275     run cur-time in this-procedure
      276       (output v-date
      277       ,output v-time
      278       ) .
      279     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      280   end.
      281   function cur-time-string-sec returns character
      282   :
      283     define variable v-date as date      no-undo .
      284     define variable v-time as integer   no-undo .
      285     run cur-time in this-procedure
      286       (output v-date
      287       ,output v-time
      288       ) .
      289     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      290   end.
      291   function cur-time-custom  returns character
      292   (input p-prefix as character
      293   ,input p-date-format as character
      294   ,input p-delimiter as character
      295   ,input p-time-format as character
      296   ,input p-suffix as character
      297   )
      298   :
      299     define variable v-date as date      no-undo .
      300     define variable v-time as integer   no-undo .
      301     run cur-time in this-procedure
      302       (output v-date
      303       ,output v-time
      304       ) .
      305     return
      306       p-prefix
      307       + string(v-date, p-date-format)
      308       + p-delimiter
      309       + string(v-time, p-time-format)
      310       + p-suffix
      311       .
      312   end.
      313   function cur-time-print  returns character
      314   :
      315     define variable v-date as date      no-undo .
      316     define variable v-time as integer   no-undo .
      317     run cur-time in this-procedure
      318       (output v-date
      319       ,output v-time
      320       ) .
      321     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      322   end.
      323   function cur-time-datetime returns datetime
      324   :
      325     define variable v-char as character no-undo .
      326     define variable v-datetime as datetime no-undo .
      327     v-char = cur-time-string().
      328     v-datetime = datetime(v-char).
      329     return  v-datetime.
      330   end.
      331   function cur-time-string-msec returns character
      332   :
      333     define variable v-date as datetime  no-undo .
      334     v-date = now.
      335     return string(v-date) .
      336   end.
      337   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      338   FUNCTION determined RETURNS DECIMAL (INPUT parundefine-var AS DECIMAL):
      339      IF parundefine-var = ? THEN RETURN 0.00.
      340                             ELSE RETURN parundefine-var.
      341   END FUNCTION.
      342   FUNCTION dtm-char RETURNS CHARACTER (INPUT p-undef-char AS CHARACTER):
      343      IF p-undef-char = ? THEN do:
      344        RETURN "?".
      345      end.
      346      ELSE do:
      347        RETURN p-undef-char .
      348      end.
      349   END FUNCTION.
