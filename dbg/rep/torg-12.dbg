    14214               PrevPage = page-number( Out-Stream )
    14215               Pg-tqnty = Pg-tqnty +  tqnty
    14216               Pg-VAT-gds = Pg-VAT-gds +  VAT-gds
    14217               Pg-SLT-gds = Pg-SLT-gds +  SLT-gds
    14218               Pg-stoim-noNDS = Pg-stoim-noNDS +  stoim-noNDS
    14219               Pg-stoim = Pg-stoim +  stoim
    14220               .
    14221       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
    14222           do:
    14223               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    14224               then do:
