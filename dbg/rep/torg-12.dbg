     9148       "Ошибка при определении корневого признака товара" skip
     9149       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     9150       error-status :get-message(1) skip
     9151       return-value skip
     9152       view-as alert-box error .
     9153     undo, return error .
     9154   end.
     9155   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     9156     (input  varroot-node
     9157     ,input  'empty-scale=request'
     9158     ,output varempty-scale
     9159     ) no-error .
     9160   if error-status :error then do:
     9161     message
     9162       vss-workfile vss-revision vss-description skip
     9163       "Ошибка при определении атрибута признака" skip
     9164       "Артикул" doc-line.artic doc-line.prod-type doc-line.prod-code skip
     9165       "Признак" varroot-node skip
     9166       "Запрашивался атрибут" "empty-scale=request" skip
     9167       error-status :get-message(1) skip
     9168       return-value skip
     9169       view-as alert-box error .
     9170     undo, return error .
     9171   end.
     9172   define variable vss-include-info55 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9173   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9174     (output varoutvprb
     9175     )  .
     9176   if varoutvprb = "base":u then do:
     9177     assign
     9178           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     9179       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   * 1)
     9180     .
     9181   end.
     9182   else do:
     9183     assign
     9184           road-tax-base-sale    =  (if doc-line.road-tax = ? then 0 else doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     9185       excise-base-sale      =  (if doc-line.excise   = ? then 0 else doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     9186     .
     9187   end.
     9188   if varoutvprb = "rubl":u then do:
     9189     assign
     9190           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * 1)
     9191       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * 1) .
     9192   end.
     9193   else do:
     9194     assign
     9195           road-tax-rubl-sale    = (if doc-line.road-tax = ? then 0 else doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     9196       excise-rubl-sale      = (if doc-line.excise   = ? then 0 else doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     9197   end.
     9198   assign
     9199     varis-cons-parts-have =  no.
     9200   assign
     9201     varfact-qnty       = 0
     9202     varcons-qnty       = 0
     9203     varprice-base-cons = 0
     9204     varprice-rubl-cons = 0.
     9205   find first out-vatp_doc-line where
     9206              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     9207          and out-vatp_doc-line.artic      = doc-line.artic
     9208          and out-vatp_doc-line.prod-type  = doc-line.prod-type
     9209          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
     9210   if available out-vatp_doc-line           and
     9211     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     9212     assign
     9213       varfact-qnty = out-vatp_doc-line.fact-qnty.
     9214   end.
     9215   else do:
     9216     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     9217                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     9218                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     9219                                  and out-vatp_parts.artic      = doc-line.artic
     9220                                  and out-vatp_parts.prod-type  = doc-line.prod-type
     9221                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
     9222       if out-vatp_parts.purch-code = 2 then do:
     9223   assign
     9224     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     9225     price-base-with-tax-loco = out-vatp_parts.price-base
     9226   .
     9227   define variable vss-include-info56 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     9228   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     9229     (output varinvprbo
     9230     )  .
     9231     if out-vatp_parts.out-code = 'free-zone':U     or
     9232        out-vatp_parts.out-code = 'out-zone':U   or
     9233        out-vatp_parts.doc-type = 'акт':U then do:
     9234       assign
     9235         in-vatp-have-vat-slto = yes.
     9236     end.
     9237     else do:
     9238       find first in-vatp_doc-attro no-lock
     9239         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     9240           and in-vatp_doc-attro.attr-code = 'envd':U
     9241         no-error .
     9242       if not available in-vatp_doc-attro then do:
     9243         assign
     9244           in-vatp-have-vat-slto = yes.
     9245       end.
     9246       else do:
     9247            in-vatp-have-vat-slto = no.
     9248       end.
     9249     end.
     9250     assign
     9251      price-cli-with-tax-loco = out-vatp_parts.price-cli
     9252      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     9253     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     9254              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     9255     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     9256             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     9257             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     9258             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     9259             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     9260             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     9261             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     9262       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     9263     assign
     9264       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     9265     assign
     9266       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     9267       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     9268       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     9269       transport-cli-loco  = 0
     9270       other-cli-loco      = 0
     9271     .
     9272   ASSIGN
     9273             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     9274       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     9275   .
     9276         assign
     9277           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     9278           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     9279         assign
     9280           varis-cons-parts-have = yes
     9281           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     9282       end.
     9283       assign
     9284         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     9285     end.
     9286   end.
     9287   assign
     9288     varprice-base-cons = varprice-base-cons / varcons-qnty
     9289     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     9290   if varprice-base-cons = ? then do:
     9291     assign
     9292       varprice-base-cons = 0.
     9293   end.
     9294   if varprice-rubl-cons = ? then do:
     9295     assign
     9296       varprice-rubl-cons = 0.
     9297   end.
     9298   assign
     9299       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     9300     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     9301     discnt-base-sale            = gds-dtl.discnt-base
     9302     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
     9303       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
     9304     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     9305     discnt-rubl-sale            = gds-dtl.discnt-rubl
     9306     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
     9307     .
     9308   if buf_trn-doc.doc-type = 'инв':U then do:
     9309     assign
     9310       varfact-qnty = gds-dtl.doc-qnty.
     9311   end.
     9312   else do:
     9313     assign
     9314       varfact-qnty = gds-dtl.fact-qnty.
     9315   end.
     9316   if varis-cons-parts-have = no then do:
     9317     assign
     9318           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
     9319           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
     9320   end.
     9321   else do:
     9322     if buf_trn-doc.doc-type = 'инв':U then do:
     9323       assign
     9324               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9325               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9326        .
     9327     end.
     9328     else do:
     9329       assign
     9330               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9331               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     9332        .
     9333     end.
     9334   end.
     9335   assign
     9336   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     9337   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     9338               assign
     9339                   v-sum-prt-qnty  = v-sum-prt-qnty + gds-dtl.fact-qnty
     9340                   VAT-gds         = ( if PrintRubl then vat-rubl-buyer            else vat-base-buyer           )
     9341                   SLT-gds         = ( if PrintRubl then slt-rubl-sale             else slt-base-sale            )
     9342                   price-withNDS   = ( if PrintRubl then price-rubl-with-tax-sale  else price-base-with-tax-sale )
     9343               .
     9344               if VAT-gds = ?       then assign  VAT-gds       = 0.
     9345               if SLT-gds = ?       then assign  SLT-gds       = 0.
     9346               if price-withNDS = ? then assign  price-withNDS = 0.
     9347               assign
     9348                   v-sum-VAT                 = v-sum-VAT                   + VAT-gds * gds-dtl.fact-qnty
     9349                   v-sum-prt-sum-with-tax    = v-sum-prt-sum-with-tax      + ( price-withNDS * gds-dtl.fact-qnty )
     9350                   v-sum-prt-sum-without-tax = v-sum-prt-sum-without-tax   + ( ( price-withNDS - VAT-gds - SLT-gds )
     9351                                                                               * gds-dtl.fact-qnty )
     9352               .
     9353           end.
     9354           assign
     9355               v-avg-VAT                   = ( if v-sum-VAT = ? or v-sum-VAT = 0
     9356                                             then 0
     9357                                             else v-sum-VAT / v-sum-prt-qnty )
     9358               v-avg-prt-price             = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     9359                                             then 0
     9360                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     9361               v-avg-prt-price-no-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     9362                                             then 0
     9363                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     9364               v-avg-prt-sum-with-tax      = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     9365                                             then 0
     9366                                             else v-sum-prt-sum-with-tax / v-sum-prt-qnty )
     9367               v-avg-prt-sum-without-tax   = ( if v-sum-prt-qnty = ? or v-sum-prt-qnty = 0
     9368                                             then 0
     9369                                             else v-sum-prt-sum-without-tax / v-sum-prt-qnty )
     9370           .
     9371           run print-line-dtl in this-procedure (
     9372                 recid( doc-line )
     9373               , input-output v-avg-VAT
     9374               , input-output v-avg-prt-price
     9375               , input-output v-avg-prt-price-no-tax
     9376               , input-output v-avg-prt-sum-with-tax
     9377               , input-output v-avg-prt-sum-without-tax
     9378               , output prt-tqnty
     9379               , output prt-VAT-gds
     9380               , output prt-SLT-gds
     9381               , output prt-stoim-noNDS
     9382               , output prt-stoim
     9383           ).
     9384           accumulate
     9385               prt-tqnty ( TOTAL )
     9386               prt-VAT-gds ( TOTAL )
     9387               prt-SLT-gds ( TOTAL )
     9388               prt-stoim-noNDS ( TOTAL )
     9389               prt-stoim ( TOTAL )
     9390           .
     9391           assign
     9392               tqnty = ( ACCUM TOTAL prt-tqnty )
     9393               VAT-gds = ( ACCUM TOTAL prt-VAT-gds )
     9394               SLT-gds = ( ACCUM TOTAL prt-SLT-gds )
     9395               stoim-noNDS = ( ACCUM TOTAL prt-stoim-noNDS )
     9396               stoim = ( ACCUM TOTAL prt-stoim )
     9397           .
     9398           if not PrintScale
     9399           then do:
     9400               find first ub.bar-code no-lock
     9401                    where bar-code.gds-code = ub.goods.gds-code
     9402                      and bar-code.unit-cli = goods.unit-base
     9403                      and bar-code.node-code = v-rootnode-code
     9404                      and bar-code.part-code = ""
     9405                      and bar-code.in-code = ""
     9406               .
     9407               assign
     9408                 v-ext-artic = ""
     9409               .
     9410               find first ub.ext-artic no-lock
     9411                    where ub.ext-artic.gds-code = bar-code.gds-code
     9412                      and ub.ext-artic.cli-code = v-cli-code
     9413                      and ub.ext-artic.cli-type = v-cli-type
     9414                      and ub.ext-artic.status_  = 'тек':U no-error.
     9415               if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
     9416               if v-torgconf-outt12 = yes
     9417               then do:
     9418                   display stream out-stream
