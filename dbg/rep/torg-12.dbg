     5356               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_sj-t12.price-base - buf_sj-t12.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-base - buf_sj-t12.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_sj-t12.doc-qnty * varcons-qnty / varfact-qnty + ((buf_sj-t12.price-base - buf_sj-t12.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-base - buf_sj-t12.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_sj-t12.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5357               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_sj-t12.doc-qnty * varcons-qnty / varfact-qnty + ((buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_sj-t12.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5358        .
     5359     end.
     5360     else do:
     5361       assign
     5362               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_sj-t12.price-base - buf_sj-t12.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-base - buf_sj-t12.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_sj-t12.fact-qnty * varcons-qnty / varfact-qnty + ((buf_sj-t12.price-base - buf_sj-t12.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-base - buf_sj-t12.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_sj-t12.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5363               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_sj-t12.fact-qnty * varcons-qnty / varfact-qnty + ((buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_sj-t12.price-rubl - buf_sj-t12.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_sj-t12.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     5364        .
     5365     end.
     5366   end.
     5367   assign
     5368   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     5369   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     5370             assign
     5371             buf_sj-t12.price-rubl-with-tax-sale     = price-rubl-with-tax-sale
     5372             buf_sj-t12.price-base-with-tax-sale     = price-base-with-tax-sale
     5373             buf_sj-t12.price-rubl-without-tax-sale  = price-rubl-without-tax-sale
     5374             buf_sj-t12.price-base-without-tax-sale  = price-base-without-tax-sale
     5375             buf_sj-t12.vat-base-sale                = vat-base-sale
     5376             buf_sj-t12.vat-rubl-sale                = vat-rubl-sale
     5377             buf_sj-t12.vat-base-buyer               = vat-base-buyer
     5378             buf_sj-t12.vat-rubl-buyer               = vat-rubl-buyer
     5379             buf_sj-t12.slt-base-sale                = slt-base-sale
     5380             buf_sj-t12.slt-rubl-sale                = slt-rubl-sale
     5381             buf_sj-t12.road-tax-base-sale           = road-tax-base-sale
     5382             buf_sj-t12.road-tax-rubl-sale           = road-tax-rubl-sale
     5383             buf_sj-t12.excise-base-sale             = excise-base-sale
     5384             buf_sj-t12.excise-rubl-sale             = excise-rubl-sale
     5385             buf_sj-t12.discnt-base-sale             = discnt-base-sale
     5386             buf_sj-t12.discnt-rubl-sale             = discnt-rubl-sale
     5387             buf_sj-t12.vat-pc                       = buf_doc-line.vat-pc
     5388             buf_sj-t12.slt-pc                       = buf_doc-line.slt-pc
     5389             buf_sj-t12.calced                       = yes
     5390             .
     5391           end.
     5392         END.
     5393     end.
     5394   end procedure.
