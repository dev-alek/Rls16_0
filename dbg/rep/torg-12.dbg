    10105              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
    10106          and out-vatp_doc-line.artic      = doc-line.artic
    10107          and out-vatp_doc-line.prod-type  = doc-line.prod-type
    10108          and out-vatp_doc-line.prod-code  = doc-line.prod-code no-lock no-error.
    10109   if available out-vatp_doc-line           and
    10110     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
    10111     assign
    10112       varfact-qnty = out-vatp_doc-line.fact-qnty.
    10113   end.
    10114   else do:
    10115     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
    10116                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
    10117                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
    10118                                  and out-vatp_parts.artic      = doc-line.artic
    10119                                  and out-vatp_parts.prod-type  = doc-line.prod-type
    10120                                  and out-vatp_parts.prod-code  = doc-line.prod-code no-lock :
    10121       if out-vatp_parts.purch-code = 2 then do:
    10122   assign
    10123     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
    10124     price-base-with-tax-loco = out-vatp_parts.price-base
    10125   .
