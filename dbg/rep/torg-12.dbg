    14286   procedure trdcattr-value :
    14287   define input parameter p-doc-code       as character        no-undo.
    14288   define input parameter p-attr-code      as character        no-undo.
    14289   define output parameter p-attr-value    as character        no-undo.
    14290   define output parameter p-attr-type     as character        no-undo.
    14291   do
    14292   on error undo, return error
    14293   :
    14294       run gbl/trdcat-v.p (
    14295             input p-doc-code
    14296           , input p-attr-code
    14297           , output p-attr-value
    14298           , output p-attr-type
    14299       ).
    14300   end.
    14301   end procedure.
    14302   procedure disc-mpl :
    14303   define input  parameter p-doc-code        as character      no-undo .
    14304   define output parameter v-price-sale-all  as decimal        no-undo .
    14305   define variable p-main-b-code             as integer        no-undo .
    14306   define variable v-fact-order              as decimal        no-undo .
    14307   define variable v-doc-num     like ub.price-list.doc-num    no-undo .
    14308   define variable v-price-sale  like ub.price-list.price-sale no-undo .
    14309   define variable v-road-tax    like ub.price-list.road-tax   no-undo .
    14310   define variable v-excise      like ub.price-list.excise     no-undo .
    14311   define buffer buf_trn-doc     for ub.trn-doc.
    14312   define buffer buf_doc-line    for ub.doc-line.
    14313   define buffer buf_goods       for ub.goods.
    14314   define buffer buf_price-doc   for ub.price-doc.
    14315   do
    14316   on error undo, return error
    14317   :
    14318   find first buf_trn-doc
    14319        where buf_trn-doc.doc-code = p-doc-code
    14320     no-error.
    14321     if available buf_trn-doc then do:
    14322       for each buf_doc-line
    14323          where buf_doc-line.doc-code = buf_trn-doc.doc-code
    14324          no-lock :
    14325            find first buf_goods
    14326                 where buf_goods.artic     = buf_doc-line.artic
    14327                   and buf_goods.prod-type = buf_doc-line.prod-type
    14328                   and buf_goods.prod-code = buf_doc-line.prod-code
    14329               no-error.
    14330               if available buf_goods then do:
    14331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
    14332     (input  buf_goods.gds-code
    14333     ,input  ?
    14334     ,output p-main-b-code
    14335     )  .
    14336                 assign v-fact-order = (if buf_trn-doc.fact-order <> ? then buf_trn-doc.fact-order else 0) .
    14337   define variable vss-include-info77 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    14338   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
    14339     (input  buf_trn-doc.obj-type
    14340     ,input  buf_trn-doc.obj-code
    14341     ,input  p-main-b-code
    14342     ,input  0
    14343     ,input  v-fact-order
    14344     ,output v-doc-num
    14345     ,output v-price-sale
    14346     ,output v-road-tax
    14347     ,output v-excise
    14348     ) no-error .
    14349                 if v-doc-num <> ? then do:
    14350                   find first buf_price-doc
    14351                   where buf_price-doc.doc-num = v-doc-num no-error.
    14352                   if available buf_price-doc then do:
    14353                     if not printRubl then do :
    14354                         assign v-price-sale = v-price-sale / buf_price-doc.base-rate .
    14355                     end.
    14356                   end.
    14357                   else do:
    14358                       assign v-price-sale = 0.
    14359                   end.
    14360                 end.
    14361                 else do:
    14362                     assign v-price-sale = 0.
    14363                 end.
    14364                 assign v-price-sale-all = v-price-sale-all + v-price-sale * buf_doc-line.fact-qnty.
    14365              end.
    14366       end.
    14367     end.
    14368   end.
    14369   end procedure.
    14370   procedure get-okei :
    14371   define input parameter p-unit-base as character        no-undo.
    14372   define output parameter p-okei as character        no-undo.
    14373       define buffer buf_units         for ub.units.
    14374   do
    14375   for buf_units
    14376   on error undo, return error
    14377   :
    14378       find first buf_units no-lock
    14379            where buf_units.unit-name = p-unit-base
    14380       no-error.
    14381       if available buf_units
    14382       and buf_units.OKEI <> 0
    14383       then do:
    14384           assign
    14385               p-okei = string( buf_units.OKEI, ">999":U )
    14386           .
    14387       end.
    14388       else do:
    14389           assign
    14390               p-okei = "":U
    14391           .
    14392       end.
    14393   end.
    14394   end procedure.
    14395   PROCEDURE find-income-doc-code :
    14396   define input  parameter p-in-code         like ub.parts.in-code    no-undo .
    14397   define input  parameter p-gds-code        like ub.goods.gds-code   no-undo .
    14398   define input  parameter p-part-code       like ub.parts.part-code  no-undo .
    14399   define output parameter p-income-doc-code like ub.parts.in-code    no-undo .
    14400   define buffer buf_parts-attr for ub.parts-attr .
    14401   define buffer buf_income_parts-attr for ub.parts-attr .
    14402   do on error undo, return error return-value :
    14403     assign
    14404       p-income-doc-code = ?
    14405     .
    14406     find first buf_parts-attr no-lock
    14407       where buf_parts-attr.in-code   = p-in-code
    14408         and buf_parts-attr.gds-code  = p-gds-code
    14409         and buf_parts-attr.part-code = p-part-code
    14410     no-error .
    14411     if available buf_parts-attr then do:
    14412       find first buf_income_parts-attr no-lock
    14413         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
    14414           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
    14415           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
    14416         no-error .
    14417       if available buf_income_parts-attr then do:
    14418         assign
    14419           p-income-doc-code = buf_parts-attr.income-in-code
    14420         .
    14421       end.
    14422       else do:
    14423         assign
    14424           p-income-doc-code = ?
    14425         .
    14426       end.
    14427     end.
    14428     else do:
    14429       assign
    14430         p-income-doc-code = ?
    14431       .
    14432     end.
    14433   end.
    14434   END PROCEDURE.
    14435   function w-date returns character ( input p-date as date ) .
    14436   do
    14437   on error undo, return error
    14438   :
    14439     return ( string( DAY( p-date ) ) + " " + MonthNameRusGen( month( p-date ) ) + " " + string( year( p-date ) ) + " г." ).
    14440   end.
    14441   end function.
