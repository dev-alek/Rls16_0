     6877      define output parameter p-user-can-edit  as logical   no-undo .
     6878      define output parameter p-output-display as logical   no-undo .
     6879      define output parameter p-other          as character no-undo .
     6880      define output parameter p-prop-list      as character no-undo .
     6881      define output parameter p-prop-type-list as character no-undo .
     6882      define output parameter p-prop-label-list as character no-undo .
     6883      define output parameter p-global          as logical no-undo .
     6884      define output parameter p-host           as logical no-undo .
     6885      define output parameter p-shop           as logical no-undo .
     6886      define output parameter p-store          as logical no-undo .
