    10919           then do:
    10920               find first buf_country
    10921               where buf_country.num-code = buf_parts-attr.country-code
    10922               no-error.
    10923               if available buf_country
    10924               and buf_country.num-code <> ub.country.num-code
    10925               and buf_country.short-name <> ""
    10926               then do :
    10927                   assign
    10928                       v-country = buf_country.short-name
    10929                       v-country-code = string(buf_country.num-code)
    10930                     .
    10931                   if buf_country.alpha1 = "RU":U
    10932                   then do :
    10933                       assign
    10934                         v-country   = "":U
    10935                         v-country-code = ""
    10936                       .
    10937                   end .
    10938               end.
    10939         end.
    10940         if v-country-code = "0" then v-country-code = "".
    10941         run torg12bbxl-write-line-data in this-procedure (
    10942               input v-doc-line-counter
    10943             , input (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
    10944             , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )
    10945             , input unit-str
    10946             , input v-okei
    10947             , input "":U
    10948             , input "":U
    10949             , input "":U
    10950             , input "":U
    10951             , input string( tqnty )
    10952             , input string( price-noNDS )
    10953             , input string( stoim-noNDS )
    10954             , input string( parts.VAT-pc )
    10955             , input string( VAT-gds )
    10956             , input string( VAT-gds )
    10957             , input v-country-code
    10958             , input v-country
    10959             , input v-cst-code
    10960         ).
    10961       end.
    10962       else do:
    10963         run torg12xl-write-line-data in this-procedure (
    10964               input v-doc-line-counter
    10965             , input (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
    10966             , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )
    10967             , input unit-str
    10968             , input v-okei
    10969             , input "-":U
    10970             , input "-":U
    10971             , input "-":U
    10972             , input "-":U
    10973             , input string( tqnty )
    10974             , input string( price-noNDS )
    10975             , input string( stoim-noNDS )
    10976             , input string( parts.VAT-pc )
    10977             , input string( VAT-gds )
    10978             , input string( stoim + SLT-gds )
    10979         ).
    10980       end.
    10981       assign
    10982           prt-tqnty =  tqnty
    10983           prt-VAT-gds = VAT-gds
    10984           prt-SLT-gds = SLT-gds
    10985           prt-stoim-noNDS = price-noNDS * prt-tqnty
    10986           prt-stoim = prt-stoim-noNDS + prt-VAT-gds
    10987       .
    10988       if hvrdtax (recid(goods))
    10989       then do:
    10990           run tax-name (  input 'rdt':U
    10991                       , output v-tax-name
    10992                       ).
    10993           run writelog in this-procedure (
