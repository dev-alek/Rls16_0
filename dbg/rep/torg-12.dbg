    10587               end.
    10588           end.
    10589               assign
    10590                   v-line-counter     = v-line-counter + 1
    10591                   v-doc-line-counter = v-doc-line-counter + 1
    10592               .
    10593           end.
    10594       end.
    10595   end.
    10596   end procedure.
    10597   procedure print-group-line :
    10598   do
    10599   on error undo, return error
