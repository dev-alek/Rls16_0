     7023   procedure thbjattr_get-section :
     7024   define input  parameter p-obj-type like ub.thbj-attr.obj-type   no-undo .
     7025   define input  parameter p-obj-code like ub.thbj-attr.obj-code   no-undo .
     7026   define input  parameter p-upper-param-code  like ub.thbj-attr.upper-prop-code  no-undo .
     7027   define input  parameter p-mode as character no-undo .
     7028   define input-output parameter table-handle p-tth.
     7029   define output parameter p-all-found as decimal no-undo .
     7030   do
