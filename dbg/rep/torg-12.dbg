    11737           Pg-tqnty = 0
    11738           Pg-VAT-gds = 0
    11739           Pg-SLT-gds = 0
    11740           Pg-stoim-noNDS = 0
    11741           Pg-stoim = 0
    11742           .
    11743           assign
    11744               PrevPage = page-number( Out-Stream )
    11745               Pg-tqnty = Pg-tqnty + prt-tqnty
    11746               Pg-VAT-gds = Pg-VAT-gds + prt-VAT-gds
    11747               Pg-SLT-gds = Pg-SLT-gds + prt-SLT-gds
    11748               Pg-stoim-noNDS = Pg-stoim-noNDS + prt-stoim-noNDS
    11749               Pg-stoim = Pg-stoim + prt-stoim
    11750               .
    11751       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
    11752           do:
    11753               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    11754               then do:
    11755                 put stream out-stream "--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------" skip.
    11756               end.
    11757               else do:
    11758                 put stream out-stream v-single-line format "x(198)" skip.
    11759               end.
    11760               if v-torgconf-outt12 = yes
    11761               then do:
    11762                                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    11763                 then do:
    11764                   display stream out-stream
    11765                       "Итого" @ ub.goods.gds-name
    11766                       Pg-tqnty @ tqnty
    11767                       Pg-stoim-noNDS @ stoim-noNDS
    11768                       Pg-VAT-gds  @ VAT-gds
    11769                       Pg-stoim @ stoim
    11770                   with frame f-doc-m-bb .
    11771                   down stream out-stream 1 with frame f-doc-m-bb .
    11772                 end.
    11773                 else do:
    11774                     display stream out-stream
    11775                         "Итого" @ ub.goods.gds-name
    11776                         Pg-tqnty @ tqnty
    11777                         Pg-stoim-noNDS @ stoim-noNDS
    11778                         Pg-VAT-gds  @ VAT-gds
    11779                         Pg-stoim @ stoim
    11780                     with frame f-doc-m .
    11781                     down stream out-stream 1 with frame f-doc-m .
    11782                 end.
    11783               end.
    11784               else do:
    11785                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    11786                 then do:
    11787                   display stream out-stream
    11788                       "Итого" @ ub.goods.gds-name
    11789                       Pg-tqnty @ tqnty
    11790                       Pg-stoim-noNDS @ stoim-noNDS
    11791                       Pg-VAT-gds  @ VAT-gds
    11792                       Pg-stoim @ stoim
    11793                   with frame f-doc-bb .
    11794                   down stream out-stream 1 with frame f-doc-bb .
    11795                 end.
    11796                 else do:
    11797                   display stream out-stream
    11798                       "Итого" @ ub.goods.gds-name
    11799                       Pg-tqnty @ tqnty
    11800                       Pg-stoim-noNDS @ stoim-noNDS
    11801                       Pg-VAT-gds  @ VAT-gds
    11802                       Pg-stoim @ stoim
    11803                   with frame f-doc .
    11804                   down stream out-stream 1 with frame f-doc .
    11805                 end.
    11806               end.
    11807           end.
    11808               end.
    11809           end.
    11810   end.
    11811   end procedure.
    11812   procedure print-header :
    11813   define input parameter p-trn-doc-code   as character        no-undo.
    11814   define variable v-print-doc                 as character                no-undo.
    11815       define buffer buf_trn-doc       for ub.trn-doc.
    11816       define buffer buf_clients           for ub.clients .
    11817       define buffer buf_temp_p-fmt_string-part    for temp_p-fmt_string-part.
    11818   do
    11819   for buf_trn-doc
    11820     , buf_clients
    11821     , buf_temp_p-fmt_string-part
    11822   on error undo, return error
    11823   :
    11824       find first buf_trn-doc no-lock
    11825            where buf_trn-doc.doc-code = p-trn-doc-code
    11826       .
    11827   define variable vss-include-info70 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
    11828   empty temp-table thbjattr_thbj-attr.
    11829   run adm/shattri.p (
    11830      input "get":U
    11831     ,input buf_trn-doc.obj-type
    11832     ,input buf_trn-doc.obj-code
    11833     ,input 'prt-firm':U
    11834     ,input  ""
    11835     ,output v-value-character
    11836     ,output v-value-date
    11837     ,output v-value-decimal
    11838     ,output v-value-integer
    11839     ,output v-value-logical
    11840     ,output par-type
    11841     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
    11842     ) no-error .
    11843       for each thbjattr_thbj-attr :
    11844           if thbjattr_thbj-attr.prop-code = 'factur01' then v-print-doc =  string(thbjattr_thbj-attr.property-value-logical) .
    11845       end.
    11846       assign
    11847       p-sf-par = no
    11848       .
    11849       run torgconf-get-form-header in this-procedure (
    11850             input Invers
    11851           , input buf_trn-doc.doc-code
    11852           , input ( v-print-doc = "yes" )
    11853           , input buf_trn-doc.doc-date
    11854           , input buf_trn-doc.fact-date
    11855           , input buf_trn-doc.doc-type
    11856           , input buf_trn-doc.status_
    11857           , input p-reverse
    11858           , input p-sf-par
    11859       ).
    11860       run torg12xl-write-cell-data in this-procedure (
    11861             input "h_docCode":U
    11862           , input v-torgconf-doc-code
    11863       ).
    11864       run torg12xl-write-cell-data in this-procedure (
    11865             input "h_tbl_docCode":U
    11866           , input v-torgconf-vdoc-code
    11867       ).
    11868       run torg12xl-write-cell-data in this-procedure (
    11869             input "h_docDate":U
    11870           , input v-torgconf-doc-date
    11871       ).
    11872       run torg12xl-write-cell-data in this-procedure (
    11873             input "h_tbl_docDate":U
    11874           , input v-torgconf-vdoc-date
    11875       ).
    11876       find first buf_clients no-lock
    11877            where buf_clients.obj-type = buf_trn-doc.obj-type
    11878              and buf_clients.obj-code = buf_trn-doc.obj-code
    11879       no-error.
    11880       case buf_clients.obj-type :
    11881           when 'маг':U
    11882           then do:
    11883               find first ub.shop where ub.shop.obj-code = buf_clients.obj-code no-lock .
    11884               tdoc-prt = ub.shop.doc-prt.
    11885           end.
    11886           when 'скл':U
    11887           then do:
    11888               find first ub.store where ub.store.obj-code = buf_clients.obj-code no-lock .
    11889               tdoc-prt = ub.store.doc-prt .
    11890           end.
    11891       end case.
    11892       if not tdoc-prt or Invers = yes
    11893       then do:
    11894           assign
    11895               PrintScale = no
    11896           .
    11897       end.
    11898       form header
    11899           v-single-line format "X(198)" at 1 SKIP
    11900           "Продолжение - на следующей странице" at 30 SKIP
    11901           with frame BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
    11902       view stream out-stream frame BottomFrame .
    11903           assign
    11904           val-str = ( if Invers then ub.currency.curr-abbr else ( if PrintRubl then "рублях" else "баз.вал" ) )
    11905       .
    11906       find first ub.pay-type no-lock
    11907            where ub.pay-type.obj-code = buf_trn-doc.pay-code
    11908       no-error .
    11909       if lookup( "TOPAUKC":U, p-mode ) <> 0
    11910       then do:
    11911         assign
    11912           v-Uvd = Get-contract-attr(
    11913                     buf_trn-doc.Host-code,
    11914                     buf_trn-doc.Contract-code,
    11915                     v-gl-Uvedomlenie)
    11916           v-Uvd = replace (v-Uvd, chr(10), " ")
    11917         .
    11918         if v-Uvd <> ? and v-Uvd <> ""
    11919         then do:
    11920           run torg12xl-write-cell-data in this-procedure (
    11921                 input "h_uvd":U
    11922               , input v-Uvd
    11923           ).
    11924           run p-fmt-split in this-procedure (
    11925                 input v-Uvd
    11926               , input 110
    11927           ) .
    11928           for each buf_temp_p-fmt_string-part
    11929           :
    11930             put stream out-stream space(30) buf_temp_p-fmt_string-part.string-part format "X(110)" skip .
    11931           end.
    11932         end.
    11933       end.
    11934       if v-torgconf-outappr = yes
    11935       then do:
    11936           put stream out-stream
    11937                    "Унифицированная форма № ТОРГ-12 Утверждена постановлением Госкомстата России от 25.12.98 N 132" at 105
    11938           .
    11939       end.
    11940       put stream out-stream
    11941           space(5) v-single-line          format  "X(19)"     at 180 skip
    11942           space(5) "Форма по ОКУД"        format "X(14)"      at 166
    11943           "| "                                                at 180
    11944           "0330212"
    11945           "|"                                                 at 198 skip
    11946       .
    11947       if v-torgconf-outrecv = yes
    11948       then do:
    11949           run p-fmt-split in this-procedure (
    11950                 input v-torgconf-organization
    11951               , input 150
    11952           ).
    11953           for each buf_temp_p-fmt_string-part
    11954           :
    11955               if buf_temp_p-fmt_string-part.str-key = 1
    11956               then do:
    11957                   put stream out-stream
    11958                       space(5) buf_temp_p-fmt_string-part.string-part format "X(160)"
    11959                               "по ОКПО"                               format "X(7)"   at 172
    11960                               "| "                                        at 180
    11961                               v-torgconf-okpo                         format "X(16)"
    11962                               "|"                                         at 198 skip
    11963                   .
    11964               end.
    11965               else do:
    11966                   put stream out-stream
    11967                       space(16) buf_temp_p-fmt_string-part.string-part format "X(149)"
    11968                               "       "                               format "X(7)"   at 172
    11969                               "| "                                        at 180
    11970                               " "                                     format "X(16)"
    11971                               "|"                                         at 198 skip
    11972                   .
    11973               end.
    11974           end.
    11975       end.
    11976       else do:
    11977           put stream out-stream
    11978           space(5) v-torgconf-organization    format "X(160)"
    11979                    "по ОКПО"                  format "X(7)"   at 172
    11980                    "| "                                       at 180
    11981                    v-torgconf-okpo            format "X(16)"
    11982                    "|"                                        at 198 skip
    11983           .
    11984       end.
    11985       put stream out-stream
    11986           space(5)  v-torgconf-client-from    format "X(160)"
    11987                    "| "                                       at 180
    11988                    "|"                                        at 198 skip
    11989           space(5) "Вид деятельности по ОКДП" format "X(25)"  at 155
    11990                    "| "                                       at 180
    11991                    "|"                                        at 198 skip
    11992       .
    11993       run torg12xl-write-cell-data in this-procedure (
    11994             input "h_OKPO_0":U
    11995           , input v-torgconf-okpo
    11996       ).
    11997       run torg12xl-write-cell-data in this-procedure (
    11998           input "h_orgFrom":U
    11999           , input v-torgconf-organization
    12000       ).
    12001       run torg12xl-write-cell-data in this-procedure (
    12002           input "h_cliFrom":U
    12003           , input v-torgconf-client-from
    12004       ).
    12005       run torg12xl-write-cell-data in this-procedure (
    12006             input "h_cargoTo":U
    12007           , input v-torgconf-torg12-cargo-label
    12008       ).
    12009       if ( buf_trn-doc.doc-type = 'при':U
    12010       or   buf_trn-doc.doc-type = 'возврат':U )
    12011       and not invers
    12012       and buf_trn-doc.ext-doc-type <> 're':U
    12013       then do:
    12014       run torg12xl-write-cell-data in this-procedure (
    12015             input "h_from_to_uderline"
    12016           , input "(организация-грузополучатель, адрес, телефон, факс, банковские реквизиты)"
    12017       ).
    12018       end.
    12019       ELSE DO:
    12020       run torg12xl-write-cell-data in this-procedure (
    12021             input "h_from_to_uderline"
    12022           , input "(организация-грузоотправитель, адрес, телефон, факс, банковские реквизиты)"
    12023       ).
    12024       end.
    12025       if v-torgconf-outrecv = yes
    12026       then do:
    12027           run p-fmt-split in this-procedure (
    12028                 input v-torgconf-torg12-cargo-string
    12029               , input 150
    12030           ).
    12031           for each buf_temp_p-fmt_string-part
    12032           :
    12033               if buf_temp_p-fmt_string-part.str-key = 1
    12034               then do:
    12035                   put stream out-stream
    12036                       space(5) buf_temp_p-fmt_string-part.string-part     format "X(160)"
    12037                               "по ОКПО"                                   format "X(7)"       at 172
    12038                               "| "                                                            at 180
    12039                               v-torgconf-torg12-cargo-okpo                format "X(16)"
    12040                               "|"                                                             at 198
    12041                       skip
    12042                   .
    12043               end.
    12044               else do:
    12045                   put stream out-stream
    12046                       space(16) buf_temp_p-fmt_string-part.string-part    format "X(149)"
    12047                               "       "                                   format "X(7)"       at 172
    12048                               "| "                                                            at 180
    12049                               " "                                         format "X(16)"
    12050                               "|"                                                             at 198
    12051                       skip
    12052                   .
    12053               end.
    12054           end.
    12055       end.
    12056       else do:
    12057       put stream out-stream
    12058           space(5) (
    12059                       if lookup("TOPAUKC", p-mode) = 0
    12060                           then
    12061                               v-torgconf-torg12-cargo-string
    12062                           else
    12063                               "Грузополучатель: " + v-torgconf-cargo-to-value
    12064                    )      format "X(160)"
    12065                   "по ОКПО"          format "X(7)"       at 172
    12066                   "| "                                   at 180
    12067                   v-torgconf-torg12-cargo-okpo         format "X(16)"
    12068                   "|"                                    at 198
    12069           skip
    12070       .
    12071       end.
    12072      if ( buf_trn-doc.doc-type = 'при':U
    12073      or buf_trn-doc.doc-type = 'возврат':U )
    12074      and buf_trn-doc.ext-doc-type <> 're':U
    12075      and buf_trn-doc.ext-doc-type <> 'pz':U
    12076      then do:
    12077       run torg12xl-write-cell-data in this-procedure (
    12078             input "h_cargoToValue":U
    12079           , input v-torgconf-torg12-cargo-value
    12080       ).
    12081      end.
    12082      else do:
    12083          run torg12xl-write-cell-data in this-procedure (
    12084             input "h_cargoToValue":U
    12085           , input ( if lookup("TOPAUKC", p-mode) = 0
    12086                then
    12087                   v-torgconf-torg12-cargo-value
    12088                else
    12089                   v-torgconf-cargo-to-value
    12090                   )
    12091       ).
    12092      end.
    12093       run torg12xl-write-cell-data in this-procedure (
    12094             input "h_OKPO":U
    12095           , input v-torgconf-torg12-cargo-okpo
    12096       ).
    12097       run torg12xl-write-cell-data in this-procedure (
    12098             input "h_OKPO2":U
    12099           , input v-torgconf-supplier-okpo
    12100       ).
    12101       run torg12xl-write-cell-data in this-procedure (
    12102             input "h_OKPO3":U
    12103           , input v-torgconf-saler-okpo
    12104       ).
    12105       if v-torgconf-outrecv = yes
    12106       then do:
    12107           run p-fmt-split in this-procedure (
    12108                 input v-torgconf-suppi
    12109               , input 150
    12110           ).
    12111           for each buf_temp_p-fmt_string-part
    12112           :
    12113               if buf_temp_p-fmt_string-part.str-key = 1
    12114               then do:
    12115                   put stream out-stream
    12116                       space(5) string( "Поставщик: " + buf_temp_p-fmt_string-part.string-part)            format "X(160)"
    12117                               "по ОКПО"                                          format "X(7)"   at 172
    12118                               "| "                                                               at 180
    12119                               v-torgconf-supplier-okpo                            format "X(16)"
    12120                               "|"                                                                at 198 skip
    12121                   .
    12122               end.
    12123               else do:
    12124                   put stream out-stream
    12125                       space(16) buf_temp_p-fmt_string-part.string-part           format "X(149)"
    12126                               "       "                                          format "X(7)"   at 172
    12127                               "| "                                                               at 180
    12128                               " "                                                format "X(16)"
    12129                               "|"                                                                at 198 skip
    12130                   .
    12131               end.
    12132           end.
    12133       end.
    12134       else do:
    12135       put stream out-stream
    12136           space(5) string( "Поставщик: " +  v-torgconf-suppi   )      format "X(160)"
    12137                    "по ОКПО"                                          format "X(7)"   at 172
    12138                    "| "                                                               at 180
    12139                    v-torgconf-supplier-okpo                            format "X(16)"
    12140                    "|"                                                                at 198 skip
    12141       .
    12142       end.
    12143       run torg12xl-write-cell-data in this-procedure (
    12144             input "h_supplier":U
    12145           , input v-torgconf-suppi
    12146       ).
    12147       define variable v-attr-value       as character            no-undo .
    12148       define variable v-attr-type        as character            no-undo .
    12149       define variable v-osnov            as character initial "" no-undo .
    12150       define variable v-osnov-doc        as character initial "" no-undo .
    12151       define variable v-osnov-1          as character initial "" no-undo .
    12152       define variable v-osnov-attr       as character initial "" no-undo .
    12153       define variable v-osnov-num        as character initial ?  no-undo .
    12154       define variable v-osnov-num-doc    as character initial "" no-undo .
    12155       define variable v-osnov-date       as character initial ?  no-undo .
    12156       define variable v-osnov-date-doc   as character initial "" no-undo .
    12157       define variable v-osnov-num-attr   as character initial "" no-undo .
    12158       define variable v-osnov-date-attr  as character initial "" no-undo .
    12159       define variable v-is-fin           as character            no-undo .
    12160       define variable v-osnov-num-1      as character initial "" no-undo .
    12161       define variable v-osnov-date-1     as character initial "" no-undo .
    12162       define variable v-ind              as integer              no-undo .
    12163       define variable v-ind2             as integer              no-undo .
    12164       define variable v-num-zak          as character            no-undo .
    12165       define variable v-mag-number       as character            no-undo .
    12166       define variable v-post-number      as character            no-undo .
    12167       define buffer bf_doc-line     for ub.doc-line .
    12168       define buffer bf_parts        for ub.parts .
    12169       define buffer bf_trn-doc      for ub.trn-doc .
    12170       define buffer bf_goods        for ub.goods .
    12171       define buffer buf_contract    for ub.contract .
    12172       define buffer buf_ext-classif for ub.ext-classif.
    12173       define variable v-income-doc-code like ub.parts.in-code no-undo .
    12174       define variable v-torg12-saler as char no-undo.
    12175   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
    12176                           input 'ndog':U ,
    12177                          output v-osnov-num-attr ,
    12178                          output v-attr-type ) no-error .
    12179     run gbl/trdcat-v.p  ( input buf_trn-doc.doc-code
    12180                                 , input 'ddog':U
    12181                                 , output v-osnov-date-attr
    12182                                 , output v-attr-type
    12183                          ) .
    12184    run gbl/trdcat-v.p  ( input buf_trn-doc.doc-code
    12185                                 , input 'nosn':U
    12186                                 , output v-osnov-attr
    12187                                 , output v-attr-type
    12188                          ) .
    12189      if trim(v-osnov-num-attr)  = ""
    12190      or trim(v-osnov-date-attr) = ""
    12191      or trim(v-osnov-attr)      = ""
    12192      then do:
    12193       if buf_trn-doc.ext-doc-type = 'ie':U
    12194       or buf_trn-doc.ext-doc-type = 'ee':U
    12195       then do:
    12196           FIND FIRST buf_contract
    12197                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
    12198                     NO-LOCK
    12199                     NO-ERROR
    12200                     .
    12201               IF AVAILABLE  buf_contract
    12202               THEN DO:
    12203               ASSIGN
    12204                  v-osnov-num-doc   = buf_contract.contract-prn-code
    12205                  v-osnov-date-doc  = STRING(buf_contract.contract-date)
    12206                  v-osnov-doc       = buf_contract.contract-name
    12207               .
    12208               END.
    12209       end.
    12210       run gbl/conf-rd.p ( "is-fin"
    12211                     , v-host-code
    12212                     , buf_trn-doc.obj-type
    12213                     , buf_trn-doc.obj-code
    12214                     , ""
    12215                     , ""
    12216                     , ""
    12217                     , no
    12218                     , output v-is-fin
    12219                     , output v-par-type
    12220                     ) no-error .
    12221       if error-status :error
    12222       then  do:
    12223          assign
    12224                v-is-fin           = ""
    12225          .
    12226       end.
    12227       IF v-is-fin = "yes"
    12228       THEN DO:
    12229         CASE buf_trn-doc.doc-type:
    12230            WHEN 'при':U then  do:
    12231               FIND FIRST buf_contract
    12232                     WHERE buf_contract.contract-code = buf_trn-doc.contract-code
    12233                     NO-LOCK
    12234                     NO-ERROR
    12235                     .
    12236               IF AVAILABLE  buf_contract
    12237               THEN DO:
    12238               ASSIGN
    12239                  v-osnov-num   = buf_contract.contract-prn-code
    12240                  v-osnov-date  = STRING(buf_contract.contract-date)
    12241                  v-osnov       = buf_contract.contract-name
    12242               .
    12243               END.
    12244            end.
    12245            WHEN 'рас':U THEN DO:
    12246            v-ind = 0.
    12247               _single-reason:
    12248               FOR EACH bf_doc-line
    12249                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
    12250                  NO-LOCK
    12251                  ,
    12252                  FIRST bf_goods
    12253                  WHERE bf_goods.artic      = bf_doc-line.artic
    12254                  and bf_goods.prod-type    = bf_doc-line.prod-type
    12255                  and bf_goods.prod-code    = bf_doc-line.prod-code
    12256                  NO-LOCK
    12257                  ,
    12258                  EACH bf_parts
    12259                  where bf_parts.obj-type   = bf_doc-line.obj-type
    12260                  and bf_parts.obj-code     = bf_doc-line.obj-code
    12261                  and bf_parts.artic        = bf_doc-line.artic
    12262                  and bf_parts.prod-type    = bf_doc-line.prod-type
    12263                  and bf_parts.prod-code    = bf_doc-line.prod-code
    12264                  and bf_parts.out-code     = bf_doc-line.doc-code
    12265                  NO-LOCK
    12266                  :
    12267                  assign
    12268                     v-ind = v-ind + 1.
    12269                     FIND FIRST buf_contract
    12270                           WHERE buf_contract.contract-code = bf_parts.contract-code
    12271                           NO-LOCK
    12272                           NO-ERROR
    12273                           .
    12274                     IF AVAILABLE  buf_contract
    12275                     THEN DO:
    12276                     ASSIGN
    12277                        v-osnov-num-1   = buf_contract.contract-prn-code
    12278                        v-osnov-date    = STRING(buf_contract.contract-date)
    12279                        v-osnov         = buf_contract.contract-name
    12280                     .
    12281                     END.
    12282                     IF v-osnov-num = ?
    12283                     THEN DO:
    12284                        ASSIGN
    12285                           v-osnov-num = v-osnov-num-1
    12286                        .
    12287                     END.
    12288                     IF v-osnov-num  <> v-osnov-num-1
    12289                     THEN DO:
    12290                        ASSIGN
    12291                           v-osnov-num   = ""
    12292                           v-osnov-date  = ""
    12293                           v-osnov       = ""
    12294           .
    12295                        LEAVE _single-reason.
    12296                     END.
    12297               END.
    12298            END.
    12299            OTHERWISE DO:
    12300            END.
    12301         END case.
    12302       END.
    12303       ELSE DO:
    12304         CASE buf_trn-doc.doc-type:
    12305            WHEN 'рас':U THEN DO:
    12306               _single-reason:
    12307               FOR EACH bf_doc-line
    12308                  WHERE bf_doc-line.doc-code = buf_trn-doc.doc-code
    12309                  NO-LOCK
    12310                  ,
    12311                  FIRST bf_goods
    12312                  WHERE bf_goods.artic        = bf_doc-line.artic
    12313                  and bf_goods.prod-type    = bf_doc-line.prod-type
    12314                  and bf_goods.prod-code    = bf_doc-line.prod-code
    12315                  NO-LOCK
    12316                  ,
    12317                  EACH bf_parts
    12318                  where bf_parts.obj-type     = bf_doc-line.obj-type
    12319                  and bf_parts.obj-code     = bf_doc-line.obj-code
    12320                  and bf_parts.artic        = bf_doc-line.artic
    12321                  and bf_parts.prod-type    = bf_doc-line.prod-type
    12322                  and bf_parts.prod-code    = bf_doc-line.prod-code
    12323                  and bf_parts.out-code     = bf_doc-line.doc-code
    12324                  NO-LOCK
    12325                  :
    12326                     FIND FIRST bf_trn-doc
    12327                        WHERE bf_trn-doc.doc-code     = bf_parts.in-code
    12328                        NO-LOCK
    12329                        NO-ERROR
    12330                        .
    12331                     IF AVAILABLE bf_trn-doc THEN DO:
    12332                        IF bf_trn-doc.ext-doc-type <> 'ie':U
    12333                        THEN DO:
    12334                           run find-income-doc-code ( input bf_parts.in-code
    12335                                                      , input bf_goods.gds-code
    12336                                                      , input bf_parts.part-code
    12337                                                      , output v-income-doc-code
    12338                                                      ) .
    12339                           if v-income-doc-code <> ? then do:
    12340                              find first bf_trn-doc
    12341                                    no-lock
    12342                                    where bf_trn-doc.doc-code = v-income-doc-code
    12343                                    no-error
    12344                                    .
    12345                              IF NOT AVAILABLE bf_trn-doc
    12346                              THEN DO:
    12347                                 ASSIGN
    12348                                    v-osnov-num   = ""
    12349                                    v-osnov-date  = ""
    12350                                    v-osnov       = ""
    12351                                 .
    12352                                 LEAVE _single-reason.
    12353                              END.
    12354                           END.
    12355                        END.
    12356                     END.
    12357                     ELSE DO:
    12358                     ASSIGN
    12359                        v-osnov-num   = ""
    12360                        v-osnov-date  = ""
    12361                        v-osnov       = ""
    12362                     .
    12363                     LEAVE _single-reason.
    12364                     END.
    12365                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
    12366                                       , input  'ndog':U
    12367                                       , output v-osnov-num-1
    12368                                       , output v-attr-type
    12369                                       ) .
    12370                     IF v-osnov-num = "":U
    12371                     THEN DO:
    12372                        ASSIGN
    12373                           v-osnov-num = v-osnov-num-1
    12374                        .
    12375                     END.
    12376                     run gbl/trdcat-v.p  ( input bf_trn-doc.doc-code
    12377                                       , input 'ddog':U
    12378                                       , output v-osnov-date-1
    12379                                       , output v-attr-type
    12380                                       ) .
    12381                     IF v-osnov-date = "":U
    12382                     THEN DO:
    12383                        ASSIGN
    12384                           v-osnov-date = v-osnov-date-1
    12385                        .
    12386                     END.
    12387                     run gbl/trdcat-v.p  ( input  bf_trn-doc.doc-code
    12388                                       , input  'nosn':U
    12389                                       , output v-osnov-1
    12390                                       , output v-attr-type
    12391                                       ) .
    12392                     IF v-osnov = "":U
    12393                     THEN DO:
    12394                        ASSIGN
    12395                           v-osnov = v-osnov-1
    12396                        .
    12397                     END.
    12398                     IF v-osnov-num  <> v-osnov-num-1
    12399                     OR v-osnov-date <> v-osnov-date-1
    12400                     or v-osnov      <> v-osnov-1
    12401                     THEN DO:
    12402                        ASSIGN
    12403                           v-osnov-num   = ""
    12404                           v-osnov-date  = ""
    12405                           v-osnov       = ""
    12406                        .
    12407                        LEAVE _single-reason.
    12408                     END.
    12409               END.
    12410            END.
    12411            OTHERWISE DO:
    12412            END.
    12413         END CASE.
    12414       END.
    12415       end.
    12416       if buf_trn-doc.ext-doc-type = 'ie':U
    12417       or buf_trn-doc.ext-doc-type = 'ee':U
    12418       then do:
    12419           assign
    12420            v-osnov-num  = v-osnov-num-doc
    12421            v-osnov-date = v-osnov-date-doc
    12422            v-osnov      = v-osnov-doc
    12423           .
    12424       end.
    12425       if trim(v-osnov-num-attr)  <> ""
    12426       then do:
    12427           v-osnov-num = v-osnov-num-attr.
    12428       end.
    12429       if trim(v-osnov-date-attr)  <> ""
    12430       then do:
    12431           v-osnov-date = v-osnov-date-attr.
    12432       end.
    12433       if trim(v-osnov-attr)  <> ""
    12434       then do:
    12435           v-osnov = v-osnov-attr.
    12436       end.
    12437       IF v-osnov-date  = ?
    12438       THEN DO:
    12439         ASSIGN
    12440            v-osnov-date  = ""
    12441         .
    12442       END.
    12443       IF v-osnov-num   = ?
    12444       THEN DO:
    12445         ASSIGN
    12446            v-osnov-num   = ""
    12447            v-osnov-date  = ""
    12448            v-osnov       = ""
    12449         .
    12450       END.
    12451       if lookup( "TOPAUKC":U, p-mode ) <> 0 then do:
    12452         if v-osnov-num > "" and v-osnov-date > "" then do:
    12453           v-osnov = substitute( "&1 &2 от &3"
    12454                                 , (if v-osnov = '' then "Договор" else "" )
    12455                                 , v-osnov-num
    12456                                 , w-date( date( v-osnov-date ) )
    12457                               ).
    12458         end.
    12459         run gbl/trdcat-v.p( input  buf_trn-doc.doc-code
    12460                           , input  'zakaz-number':U
    12461                           , output v-num-zak
    12462                           , output v-attr-type
    12463                           ) .
    12464               if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run clntattr-value in g#attr-lib
    12465           ( input v-torgconf-sup-obj-type
    12466            ,input v-torgconf-sup-obj-code
    12467            ,input 'division-code':U
    12468            ,output v-mag-number
    12469            ,output v-attr-type
    12470           ).
    12471         for each buf_ext-classif no-lock
    12472           where buf_ext-classif.classif-subject = 'clients':U
    12473             and buf_ext-classif.classif-name = 'code_firm_ext':U
    12474             and buf_ext-classif.db-num = -1
    12475             and buf_ext-classif.Key#_One = v-torgconf-self-host-code
    12476             and buf_ext-classif.Key#_Two = v-torgconf-sup-obj-code
    12477             and buf_ext-classif.Key#_Three = 0
    12478             and buf_ext-classif.CharKey_One = ''
    12479             and buf_ext-classif.CharKey_Two = v-torgconf-sup-obj-type
    12480         :
    12481           v-post-number = buf_ext-classif.CharKey_Three.
    12482         end.
    12483       end.
    12484       v-torg12-saler = v-torgconf-saler.
    12485       if lookup("TOPAUKC", p-mode) = 0 then
    12486           do:
    12487               v-torg12-saler =
    12488                   v-torg12-saler +
    12489                   " ИНН " +
    12490                   v-torgconf-saler-inn +
    12491                   " КПП " +
    12492                   v-torgconf-saler-kpp.
    12493           end.
    12494       if v-torgconf-outrecv = yes
    12495       then do:
    12496           run p-fmt-split in this-procedure (
    12497                 input string( "Плательщик: " + v-torg12-saler )
    12498               , input 150
    12499           ).
    12500           for each buf_temp_p-fmt_string-part
    12501           :
    12502               if buf_temp_p-fmt_string-part.str-key = 1
    12503               then do:
    12504                   put stream out-stream
    12505                       space(5) buf_temp_p-fmt_string-part.string-part            format "X(160)"
    12506                               "по ОКПО"                                          format "X(7)"   at 172
    12507                               "| "                                                               at 180
    12508                               v-torgconf-saler-okpo                              format "X(16)"
    12509                               "|"                                                                at 198 skip
    12510                   .
    12511               end.
    12512               else do:
    12513                   put stream out-stream
    12514                       space(16) buf_temp_p-fmt_string-part.string-part           format "X(149)"
    12515                               "       "                                          format "X(7)"   at 172
    12516                               "| "                                                               at 180
    12517                               " "                                                format "X(16)"
    12518                               "|"                                                                at 198 skip
    12519                   .
    12520               end.
    12521           end.
    12522       end.
    12523       else do:
    12524           put stream out-stream
    12525               space(5) string( "Плательщик: " + v-torg12-saler )        format "X(160)"
    12526                       "по ОКПО"                                           format "X(7)"   at 172
    12527                       "| "                                                                at 180
    12528                       v-torgconf-saler-okpo                               format "X(16)"
    12529                       "|"                                                                 at 198 skip
    12530           .
    12531       end.
    12532       put stream out-stream
    12533           space(5) string( "Основание: " + v-osnov ) format "X(160)"
    12534                           "номер" format "X(5)" at 174 "| " at 180  v-osnov-num FORMAT "x(16)" "|" at 198 skip
    12535       .
    12536       run torg12xl-write-cell-data in this-procedure (
    12537           input "h_saler":U
    12538           , input v-torg12-saler
    12539       ).
    12540       run torg12xl-write-cell-data in this-procedure (
    12541             input "h_osn_doc_code"
    12542           , input v-osnov-num
    12543       ).
    12544       run torg12xl-write-cell-data in this-procedure (
    12545             input "h_osn_doc_date"
    12546           , input v-osnov-date
    12547       ).
    12548       run torg12xl-write-cell-data in this-procedure (
    12549           input "h_reason":U
    12550           , input v-osnov
    12551       ).
    12552       run torg12xl-write-cell-data in this-procedure (
    12553           input "h_reason_num":U
    12554           , input v-osnov-num
    12555       ).
    12556       run torg12xl-write-cell-data in this-procedure (
    12557           input "h_reason_date":U
    12558           , input v-osnov-date
    12559       ).
    12560       if v-num-zak > '' then do:
    12561         run torg12xl-write-cell-data in this-procedure (
    12562             input "h_number_zak"
    12563             , input v-num-zak
    12564         ).
    12565       end.
    12566       if v-mag-number > '' then do:
    12567         run torg12xl-write-cell-data in this-procedure (
    12568             input "h_number_mag"
    12569             , input v-mag-number
    12570         ).
    12571       end.
    12572       if v-post-number > '' then do:
    12573         run torg12xl-write-cell-data in this-procedure (
    12574             input "h_number_post"
    12575             , input v-post-number
    12576         ).
    12577       end.
    12578       if v-torgconf-outprim = yes
    12579       OR ( buf_trn-doc.PS begins "@" )
    12580       then do:
    12581       end.
    12582       else do:
    12583           put stream out-stream
    12584                  space(5) string( "Примечание: " + replace( buf_trn-doc.PS, chr(10), " " ))   format "X(163)"
    12585           .
    12586       end.
    12587       if lookup( "TOPAUKC":U, p-mode ) <> 0 then do:
    12588         put stream out-stream
    12589           space(5) substitute( "Номер магазина: &1", v-mag-number )  format "X(130)"
    12590                           "дата" format "X(4)" at 175 "| " at 180 v-osnov-date FORMAT "X(16)" "|" at 198 skip
    12591           space(5) substitute( "Номер поставщика: &1", v-post-number )  format "X(130)"
    12592                           string( "Транспортная накладная " ) format "X(23)" at 147 "номер" format "X(5)" at 174 "| " at 180 v-torgconf-vdoc-code format "X(16)" "|" at 198 skip
    12593           space(5) substitute( "Номер заказа: &1", v-num-zak )  format "X(130)"
    12594                           "дата" format "X(4)" at 175 "| " at 180 v-torgconf-vdoc-date format "X(10)" "|" at 198 skip
    12595           space(64) v-single-line format "X(33)"
    12596         .
    12597       end.
    12598       else do:
    12599         put stream out-stream
    12600                           "дата" format "X(4)" at 175 "| " at 180 v-osnov-date FORMAT "X(16)" "|" at 198 skip
    12601           space(5) ""  format "X(130)"
    12602                           string( "Транспортная накладная " ) format "X(23)" at 147
    12603                           "номер" format "X(5)" at 174 "| " at 180 v-torgconf-vdoc-code format "X(16)" "|" at 198 skip
    12604           space(64) v-single-line format "X(33)"
    12605           space(5) "дата" format "X(4)" at 175 "| " at 180 v-torgconf-vdoc-date format "X(10)" "|" at 198 skip
    12606         .
    12607       end.
    12608       define variable v-operation-type    as character    no-undo.
    12609       assign
    12610           v-operation-type = ( if v-ext-doc-type = 'ep':U
    12611                                then ( if lookup( "MARI":U, p-mode ) = 0 and lookup( "KEDR":U, p-mode ) = 0
    12612                                       then "возврат пост-ку"
    12613                                       else "":U )
    12614                                else ( if buf_trn-doc.doc-type = 'при':U and not Invers
    12615                                       then " приход"
    12616                                       else ( if buf_trn-doc.doc-type = 'возврат':U
    12617                                              then ( if lookup( "MARI":U, p-mode ) = 0
    12618                                                     then " возврат"
    12619                                                     else "":U )
    12620                                              else " расход" ) )
    12621                              )
    12622       .
    12623       if lookup( "KEDR":U, p-mode ) = 0 then
    12624       run torg12xl-write-cell-data in this-procedure (
    12625             input "h_operationType":U
    12626           , input v-operation-type
    12627       ).
    12628       if lookup( "TOPAUKC":U, p-mode ) <> 0 then do:
    12629         put stream out-stream
    12630           space(5) "Вид операции"   format "X(12)"    at 167
    12631                    "| "                               at 180
    12632                    v-operation-type format "X(16)"
    12633                    "|"                                at 198 skip
    12634           space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | "
    12635                                       + string( v-torgconf-doc-code, "X(16)") + " | "
    12636                                       + v-torgconf-doc-date
    12637                                       + " | " + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
    12638                                       ) format "X(100)" space(5) v-single-line format  "X(19)" at 180 skip
    12639           space(64) v-single-line format "X(33)"
    12640         .
    12641       end.
    12642       else do:
    12643         put stream out-stream
    12644           space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | "
    12645                                       + string( v-torgconf-doc-code, "X(16)") + " | "
    12646                                       + v-torgconf-doc-date
    12647                                       + " | " + (if buf_trn-doc.status_ <> 'факт':U then string( "(" + CAPS(buf_trn-doc.status_) + ")" ) else "")
    12648                                       ) format "X(100)"
    12649           space(5) "Вид операции"   format "X(12)"    at 167
    12650                    "| "                               at 180
    12651                    v-operation-type format "X(16)"
    12652                    "|"                                at 198 skip
    12653           space(64) v-single-line format "X(33)"
    12654           space(5) v-single-line format  "X(19)" at 180
    12655         .
    12656       end.
    12657       if v-ext-doc-type = 'ep':U
    12658       then do:
    12659           if lookup( "MARI":U, p-mode ) = 0
    12660           then do:
    12661               put stream out-stream
    12662                   skip space(10) "Возврат товара поставщику" format "X(120)"
    12663               .
    12664           end.
    12665       end.
    12666   end.
    12667   end procedure.
    12668   procedure print-line-sj :
    12669   define input parameter p-doc-code       as character        no-undo.
    12670   define input parameter p-sj-b-code      as integer          no-undo.
    12671       define variable v-price-is-changed      as logical  no-undo.
    12672       define variable v-sum-prt-qnty                  as decimal      no-undo.
    12673       define variable v-avg-prt-price                 as decimal      no-undo.
    12674       define variable v-avg-prt-price-no-tax          as decimal      no-undo.
    12675       define variable v-sum-SLT                       as decimal      no-undo.
    12676       define variable v-sum-VAT                       as decimal      no-undo.
    12677       define variable v-avg-VAT                       as decimal      no-undo.
    12678       define variable v-avg-VAT-out                   as decimal      no-undo.
    12679       define variable v-sum-prt-sum-with-tax          as decimal      no-undo.
    12680       define variable v-avg-prt-sum-with-tax          as decimal      no-undo.
    12681       define variable v-avg-prt-sum-with-tax-out      as decimal      no-undo.
    12682       define variable v-sum-prt-sum-without-tax       as decimal      no-undo.
    12683       define variable v-avg-prt-sum-without-tax       as decimal      no-undo.
    12684       define variable v-avg-prt-sum-without-tax-out   as decimal      no-undo.
    12685       define variable v-vat-pc                        as decimal      no-undo.
    12686       define variable v-slt-pc                        as decimal      no-undo.
    12687       define variable v-void-decimal                  as decimal      no-undo.
    12688       define variable v-gds-name                      as character    no-undo.
    12689       define buffer buf_trn-doc       for ub.trn-doc.
    12690       define buffer buf_sj-t12        for sj-t12.
    12691       define buffer buf_tax_parts     for ub.parts.
    12692       define buffer buf_temp_gds-name for temp_gds-name.
    12693   do
    12694   for buf_trn-doc
    12695     , buf_sj-t12
    12696     , buf_tax_parts
    12697     , buf_temp_gds-name
    12698   on error undo, return error
    12699   :
    12700       empty temp-table buf_temp_gds-name.
    12701       find first buf_trn-doc no-lock
    12702            where buf_trn-doc.doc-code = p-doc-code
    12703       .
    12704       find first buf_sj-t12
    12705            where buf_sj-t12.b-code = p-sj-b-code
    12706       .
    12707       run writelog in this-procedure (log-file-name, 1, "Печать строки товара по чекам").
    12708       assign
    12709           v-torg-12-gds-name-key  = 0
    12710           v-gds-name              = (if rep-artic then (string(ub.goods.artic) + " ") else "") + ub.goods.gds-name
    12711       .
    12712       if FullGdsName
    12713       and v-gds-name <> "":U
    12714       then do:
    12715           do
    12716           while v-gds-name <> "":U
    12717           :
    12718               assign
    12719                   v-torg-12-gds-name-key = v-torg-12-gds-name-key + 1
    12720               .
    12721               create buf_temp_gds-name.
    12722               assign
    12723                   buf_temp_gds-name.gdn-key = v-torg-12-gds-name-key
    12724               .
    12725               run p-fmt-split-string in this-procedure (
    12726                     input v-gds-name
    12727                   , input v-torg-12-gds-name-length
    12728                   , output buf_temp_gds-name.gdnString
    12729                   , output v-gds-name
    12730               ).
    12731           end.
    12732           if line-counter( out-stream ) + v-torg-12-gds-name-key > page-size( out-stream )
    12733           then do:
