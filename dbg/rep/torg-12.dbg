    10516   if page-number( out-stream ) > prevpage then
    10517       assign
    10518           Pg-tqnty = 0
    10519           Pg-VAT-gds = 0
    10520           Pg-SLT-gds = 0
    10521           Pg-stoim-noNDS = 0
    10522           Pg-stoim = 0
    10523           .
    10524           assign
    10525               PrevPage = page-number( Out-Stream )
    10526               Pg-tqnty = Pg-tqnty +  tqnty
    10527               Pg-VAT-gds = Pg-VAT-gds +  VAT-gds
    10528               Pg-SLT-gds = Pg-SLT-gds +  SLT-gds
    10529               Pg-stoim-noNDS = Pg-stoim-noNDS +  stoim-noNDS
    10530               Pg-stoim = Pg-stoim +  stoim
    10531               .
    10532       if line-counter( Out-Stream ) + 1 > page-size( Out-Stream ) then
    10533           do:
