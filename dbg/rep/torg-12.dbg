    10450                       , input string( v-tax )
    10451                       , input "":U
    10452                       , input "":U
    10453                       , input string( v-tax )
    10454                   ).
    10455                   assign
    10456                       v-tax           = v-tax-price * tqnty
    10457                       price-noNDS     = price-noNDS + v-tax-price
    10458                       stoim-noNDS     = price-noNDS * tqnty
    10459                       stoim           = stoim-noNDS + VAT-gds
    10460                       v-line-counter  = v-line-counter + 1
    10461                   .
    10462                   run writelog in this-procedure (log-file-name, 4,
    10463                                           "Снова вычислили суммы для строки. Сумма с НДС ( "
    10464                                           + dtm-char( string( stoim ) )
    10465                                           + " )"
    10466                                                       ).
    10467               end.
    10468   define variable vss-include-info63 as character format "X(65)" no-undo
    10469   initial "@(#)$Workfile$ $Revision$".
    10470       if FullGdsName
    10471       then do:
    10472           for each temp_gds-name
    10473              where temp_gds-name.gdn-key > 1
    10474           :
    10475               if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10476               then do:
    10477                 if v-torgconf-outt12 = yes
    10478                 then do:
    10479                     display stream out-stream
    10480                         temp_gds-name.gdnString     @ ub.goods.gds-name
    10481                         sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10482                         sym11 sym12 sym13 sym14 sym15 sym16  sym20 sym21
    10483                     with frame f-doc-m-bb .
