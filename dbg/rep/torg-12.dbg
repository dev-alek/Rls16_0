    10613   end.
    10614   end procedure.
    10615   procedure print-line-parts :
    10616   define input parameter p-trn-doc-code           as character        no-undo.
    10617   define input parameter p-price-is-changed       as logical          no-undo.
    10618   define input parameter p-gds-name               as character        no-undo.
    10619   define input-output parameter p-VAT-gds         as decimal          no-undo.
    10620   define input-output parameter p-SLT-gds         as decimal          no-undo.
    10621   define input-output parameter p-price-withNDS   as decimal          no-undo.
    10622   define input-output parameter p-tax             as decimal          no-undo.
    10623   define input-output parameter p-tax-price       as decimal          no-undo.
    10624   define input-output parameter p-tax-sum         as decimal          no-undo.
    10625       define variable v-tax-name          as character    no-undo.
    10626       define variable v-VAT-pc            as decimal      no-undo.
    10627       define variable v-SLT-pc            as decimal      no-undo.
    10628       define variable v-void-decimal      as decimal      no-undo.
    10629       define buffer buf_trn-doc       for ub.trn-doc.
    10630       define buffer buf_parts-attr    for ub.parts-attr.
    10631       define buffer buf_country       for ub.country.
    10632   do
    10633   for buf_trn-doc
    10634   on error undo, return error
    10635   :
    10636       find first buf_trn-doc no-lock
    10637            where buf_trn-doc.doc-code = p-trn-doc-code
    10638       .
    10639       if p-price-is-changed  =  no
    10640       or CostPrice = yes
    10641       then do:
    10642   assign
    10643     price-rubl-with-tax-loc = ub.parts.price-rubl
    10644     price-base-with-tax-loc = ub.parts.price-base
    10645   .
    10646   define variable vss-include-info64 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    10647   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    10648     (output varinvprb
    10649     )  .
    10650     if ub.parts.out-code = 'free-zone':U     or
    10651        ub.parts.out-code = 'out-zone':U   or
    10652        ub.parts.doc-type = 'акт':U then do:
    10653       assign
    10654         in-vatp-have-vat-slt = yes.
    10655     end.
    10656     else do:
    10657       find first in-vatp_doc-attr no-lock
    10658         where in-vatp_doc-attr.doc-code  = ub.parts.out-code
    10659           and in-vatp_doc-attr.attr-code = 'envd':U
    10660         no-error .
    10661       if not available in-vatp_doc-attr then do:
    10662         assign
    10663           in-vatp-have-vat-slt = yes.
    10664       end.
    10665       else do:
    10666            in-vatp-have-vat-slt = no.
    10667       end.
    10668     end.
    10669     assign
    10670      price-cli-with-tax-loc = ub.parts.price-cli
    10671      cli-base-rate          = ub.parts.cli-base-rate.
    10672     ASSIGN   road-tax-base-loc  = (if ub.parts.road-tax-base  = ? then 0 else ub.parts.road-tax-base)
    10673              road-tax-rubl-loc  = (if ub.parts.road-tax-rubl  = ? then 0 else ub.parts.road-tax-rubl).
    10674     ASSIGN  transport-base-loc = (if ub.parts.transport-base = ? then 0 else ub.parts.transport-base)
    10675             transport-rubl-loc = (if ub.parts.transport-rubl = ? then 0 else ub.parts.transport-rubl)
    10676             other-base-loc     = (if ub.parts.other-base     = ? then 0 else ub.parts.other-base)
    10677             other-rubl-loc     = (if ub.parts.other-rubl     = ? then 0 else ub.parts.other-rubl)
    10678             vat-pc-loc         = (if ub.parts.vat-pc         = ? then 0 else ub.parts.vat-pc)
    10679             slt-pc-loc         = (if ub.parts.slt-pc         = ? then 0 else ub.parts.slt-pc).
    10680             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    10681       ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    10682     assign
    10683       exch-rate-cli-loc = (ub.parts.price-rubl - transport-rubl-loc - other-rubl-loc - road-tax-rubl-loc - (if ub.parts.vat-type <> 'в т. ч.':U then vat-rubl-loc else 0) - (if ub.parts.slt-type <> 'в т. ч.':U then slt-rubl-loc else 0)) / ub.parts.price-cli .
    10684     assign
    10685       slt-cli-loc        = slt-rubl-loc       / exch-rate-cli-loc
    10686       vat-cli-loc        = vat-rubl-loc       / exch-rate-cli-loc
    10687       road-tax-cli-loc   = road-tax-rubl-loc  / exch-rate-cli-loc
    10688       transport-cli-loc  = 0
    10689       other-cli-loc      = 0
    10690     .
    10691   ASSIGN
    10692             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
    10693       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
    10694   .
    10695           assign
    10696               p-VAT-gds       = ( if PrintRubl then vat-rubl-loc else vat-base-loc )
    10697               p-SLT-gds       = ( if PrintRubl then slt-rubl-loc else slt-base-loc )
    10698               p-tax-price     = ( if PrintRubl then road-tax-rubl-loc else road-tax-base-loc )
    10699               p-price-withNDS = ( if PrintRubl
    10700                                 then price-rubl-with-tax-loc - transport-rubl-loc - other-rubl-loc - p-tax-price
    10701                                 else price-base-with-tax-loc - transport-base-loc - other-base-loc - p-tax-price )
    10702               p-tax           = p-tax-price * parts.qnty
    10703               p-tax-sum       = p-tax-sum + p-tax
    10704           .
    10705       end.
    10706       if VAT-gds = ? then VAT-gds = 0.
    10707       if SLT-gds = ? then SLT-gds = 0.
    10708       if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10709           then do:
    10710               find first country where country.alpha1 = goods.alpha1.
    10711               v-cst-code = ( if avail country and country.alpha1 <> "RU"
    10712                   then parts.cst-code else "" ).
    10713           end.
    10714       assign
    10715           tqnty           = ub.parts.fact-qnty
    10716           unit-str        = ub.goods.unit-base
    10717           price-noNDS     = p-price-withNDS - p-VAT-gds - p-SLT-gds
    10718           VAT-gds         = p-VAT-gds * tqnty
    10719           SLT-gds         = p-SLT-gds * tqnty
    10720           stoim-noNDS     = price-noNDS * tqnty
    10721           stoim           = stoim-noNDS + VAT-gds
    10722           price-withNDS   = p-price-withNDS
    10723       .
    10724       run writelog in this-procedure (
    10725             input log-file-name
    10726           , input 5
    10727           , input substitute( "Партия: Кол-во ( &1 ) c НДС ( &2 )"
    10728                               , dtm-char( string( tqnty ) )
    10729                               , dtm-char( string( price-withNDS ) ) )
    10730       ).
    10731       if p-round = "round":U
    10732       then do:
    10733           run p-fmt-round in this-procedure (
    10734                 input tqnty
    10735               , input price-noNDS
    10736               , input VAT-gds     / tqnty
    10737               , input SLT-gds     / tqnty
    10738               , input 0
    10739               , output price-noNDS
    10740               , output v-VAT-pc
    10741               , output v-SLT-pc
    10742               , output VAT-gds
    10743               , output SLT-gds
    10744               , output v-void-decimal
    10745               , output stoim-noNDS
    10746               , output stoim
    10747           ).
    10748           assign
    10749               stoim           = stoim - SLT-gds
    10750           .
    10751       end.
    10752       assign
    10753         v-ext-artic = ""
    10754       .
    10755       find first ub.ext-artic no-lock
    10756             where ub.ext-artic.gds-code = bar-code.gds-code
    10757               and ub.ext-artic.cli-code = v-cli-code
    10758               and ub.ext-artic.cli-type = v-cli-type
    10759               and ub.ext-artic.status_  = 'тек':U no-error.
    10760       if available ub.ext-artic then v-ext-artic = ub.ext-artic.ext-artic.
    10761       if v-torgconf-outt12 = yes
    10762       then do:
    10763           if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10764           then do:
    10765             find first ub.country no-lock
    10766               where ub.country.alpha1 = ub.goods.alpha1
    10767               no-error.
    10768             if available ub.country
    10769             then do:
    10770               assign
    10771                 v-country = ub.country.short-name
    10772                 v-country-code = string(ub.country.num-code).
    10773               .
    10774             end.
    10775             else do:
    10776               assign
    10777                 v-country = ""
    10778                 v-country-code = ""
    10779               .
    10780             end.
    10781             if v-country-code = "0" then v-country-code = "".
    10782             display stream out-stream
    10783                 v-doc-line-counter
    10784                 p-gds-name                  @ ub.goods.gds-name
    10785                 if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )   @ tb-code
    10786                 unit-str                    @ ub.goods.unit-base
    10787                 v-okei
    10788                 tqnty
    10789                 price-noNDS
    10790                 stoim-noNDS
    10791                 parts.VAT-pc                @ ub.doc-line.VAT-pc
    10792                 VAT-gds when tqnty <> 0
    10793                 stoim
    10794                 v-cst-code
    10795                 v-country-code
    10796                 v-country
    10797                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10798                 sym11 sym12 sym13 sym14 sym15 sym16  sym20 sym21
    10799             with frame f-doc-m-bb.
    10800             down stream out-stream  with frame f-doc-m-bb.
    10801           end.
    10802           else do:
    10803             display stream out-stream
    10804                 v-doc-line-counter
    10805                 p-gds-name                  @ ub.goods.gds-name
    10806                 if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )   @ tb-code
    10807                 unit-str                    @ ub.goods.unit-base
    10808                 v-okei
    10809                 tqnty
    10810                 price-noNDS
    10811                 stoim-noNDS
    10812                 parts.VAT-pc                @ ub.doc-line.VAT-pc
    10813                 VAT-gds when tqnty <> 0
    10814                 stoim
    10815                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10816                 sym11 sym12 sym13 sym14 sym15 sym16
    10817             with frame f-doc-m.
    10818             down stream out-stream  with frame f-doc-m.
    10819           end.
    10820       end.
    10821       else do:
    10822           if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10823           then do:
    10824             find first ub.country no-lock
    10825               where ub.country.alpha1 = ub.goods.alpha1
    10826               no-error.
    10827             if available ub.country AND ub.country.alpha1 <> "RU"
    10828             then do:
    10829               assign
    10830                 v-country = ub.country.short-name
    10831                 v-country-code = string(ub.country.num-code)
    10832               .
    10833             end.
    10834             else do:
    10835               assign
    10836                 v-country = ""
    10837                 v-country-code = ""
    10838               .
    10839             end.
    10840             if v-country-code = "0" then v-country-code = "".
    10841             display stream out-stream
    10842                 v-doc-line-counter
    10843                 p-gds-name                  @ ub.goods.gds-name
    10844                 if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )   @ tb-code
    10845                 unit-str                    @ ub.goods.unit-base
    10846                 v-okei
    10847                 tqnty
    10848                 price-noNDS
    10849                 stoim-noNDS
    10850                 ub.parts.VAT-pc             @ ub.doc-line.VAT-pc
    10851                 VAT-gds when tqnty <> 0
    10852                 stoim
    10853                 ( stoim + SLT-gds ) / tqnty               @ price-withNDS
    10854                 v-cst-code
    10855                 v-country-code
    10856                 v-country
    10857                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10858                 sym11 sym12 sym13 sym14 sym15 sym16  sym18 sym22  sym20 sym21
    10859             with frame f-doc-bb.
    10860             down stream out-stream  with frame f-doc-bb.
    10861           end.
    10862           else do:
    10863             display stream out-stream
    10864               v-doc-line-counter
    10865                 p-gds-name                  @ ub.goods.gds-name
    10866                 if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )   @ tb-code
    10867                 unit-str                    @ ub.goods.unit-base
    10868                 v-okei
    10869                 " -":C   @ pack-type
    10870                 "  -":C   @ qnty-opl
    10871                 " -":C   @ qnty-pl
    10872                 " -":C   @ mass
    10873                 tqnty
    10874                 price-noNDS
    10875                 stoim-noNDS
    10876                 ub.parts.VAT-pc             @ ub.doc-line.VAT-pc
    10877                 VAT-gds when tqnty <> 0
    10878                 stoim
    10879                 ( stoim + SLT-gds ) / tqnty               @ price-withNDS
    10880                 sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10881                 sym11 sym12 sym13 sym14 sym15 sym16  sym18
    10882             with frame f-doc.
    10883             down stream out-stream  with frame f-doc.
    10884           end.
    10885       end.
    10886       if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10887       then do:
    10888         find first ub.country no-lock
    10889               where ub.country.alpha1 = goods.alpha1
    10890         no-error.
    10891         if available country
    10892         then do:
    10893             assign
    10894                 v-country = ub.country.short-name
    10895                 v-country-code = string(ub.country.num-code)
    10896             .
    10897         end.
    10898         else do:
    10899             assign
    10900                 v-country = ""
    10901                 v-country-code = ""
    10902             .
    10903         end.
    10904         if available country
    10905         and ub.country.alpha1 = "RU":U
    10906         then do:
    10907             assign
    10908                 v-country   = "":U
    10909                 v-country-code = ""
    10910             .
    10911         end.
    10912         find first buf_parts-attr no-lock
    10913           where buf_parts-attr.in-code   = ub.parts.in-code
    10914             and buf_parts-attr.gds-code  = ub.goods.gds-code
    10915             and buf_parts-attr.part-code = ub.parts.part-code
    10916         no-error .
