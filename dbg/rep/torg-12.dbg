    10570                       Pg-tqnty @ tqnty
    10571                       Pg-stoim-noNDS @ stoim-noNDS
    10572                       Pg-VAT-gds  @ VAT-gds
    10573                       Pg-stoim @ stoim
    10574                   with frame f-doc-bb .
    10575                   down stream out-stream 1 with frame f-doc-bb .
    10576                 end.
    10577                 else do:
    10578                   display stream out-stream
    10579                       "Итого" @ ub.goods.gds-name
    10580                       Pg-tqnty @ tqnty
    10581                       Pg-stoim-noNDS @ stoim-noNDS
    10582                       Pg-VAT-gds  @ VAT-gds
    10583                       Pg-stoim @ stoim
    10584                   with frame f-doc .
