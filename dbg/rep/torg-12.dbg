    10385                       assign
    10386                           v-parts-tax-qnty    = v-parts-tax-qnty + buf_tax_parts.fact-qnty
    10387                           v-tax               = v-tax + ( v-tax-parts-price * buf_tax_parts.fact-qnty )
    10388                       .
    10389                       if not last-of (buf_tax_parts.road-tax-base)
    10390                       then do:
    10391                           next parts-for-tax.
    10392                       end.
    10393                       if p-round = "round":U
    10394                       then do:
    10395                           run p-fmt-round in this-procedure (
    10396                                 input v-parts-tax-qnty
    10397                               , input v-tax-parts-price
    10398                               , input 0
    10399                               , input 0
    10400                               , input 0
    10401                               , output v-tax-parts-price
    10402                               , output v-void-decimal
    10403                               , output v-void-decimal
    10404                               , output v-void-decimal
    10405                               , output v-void-decimal
    10406                               , output v-void-decimal
    10407                               , output v-tax
    10408                               , output v-void-decimal
    10409                           ).
    10410                       end.
    10411                       if v-torgconf-outt12 = yes
    10412                       then do:
    10413                           display stream out-stream
    10414                               fill(" ", 2) + v-tax-name   @ goods.gds-name
    10415                               v-parts-tax-qnty            @ tqnty
    10416                               0                           @ VAT-gds
    10417                               v-tax-parts-price           @ price-noNDS
    10418                               v-tax                       @ stoim-noNDS
    10419                               v-tax                       @ stoim
    10420                               sym1 sym10 sym11 sym12 sym13 sym14 sym15 sym16
    10421                           with frame f-doc-m.
    10422                           down stream out-stream  with frame f-doc-m.
    10423                       end.
    10424                       else do:
    10425                           display stream out-stream
    10426                               fill(" ", 2) + v-tax-name   @ goods.gds-name
    10427                               v-parts-tax-qnty            @ tqnty
    10428                               0                           @ VAT-gds
    10429                               v-tax-parts-price           @ price-noNDS
    10430                               v-tax                       @ stoim-noNDS
    10431                               v-tax-parts-price           @ price-withNDS
    10432                               v-tax                       @ stoim
    10433                               sym1 sym10 sym11 sym12 sym13 sym14 sym15 sym16  sym18
    10434                           with frame f-doc.
    10435                           down stream out-stream  with frame f-doc.
    10436                       end.
    10437                   end.
    10438                   run torg12xl-write-line-data in this-procedure (
    10439                         input 0
    10440                       , input v-tax-name
    10441                       , input "":U
