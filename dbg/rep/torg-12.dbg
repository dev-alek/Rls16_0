     7339   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     7340     (input  'is-prt'
     7341     ,input  0
     7342     ,input  ''
     7343     ,input  0
     7344     ,input  ''
     7345     ,input  ''
     7346     ,input  ''
     7347     ,input  yes
     7348     ,output v-cntxp-conf-par
     7349     ,output v-cntxp-par-type
     7350     ) no-error .
     7351       case v-cntxp-obj-type :
     7352         when 'скл':U then do:
     7353           find first bf-cntxp_store where bf-cntxp_store.obj-code = v-cntxp-obj-code no-lock.
     7354           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_store.host-code no-lock.
     7355           assign
     7356             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_store.doc-prt
     7357             v-cntxp-price-calc      = bf-cntxp_store.price-calc
     7358             v-cntxp-inout-price     = bf-cntxp_store.inout-price
     7359             v-cntxp-unit-cli-perm   = bf-cntxp_store.unit-cli-perm
     7360             v-cntxp-out-rate        = bf-cntxp_store.out-rate
     7361             v-cntxp-out-line-discnt = bf-cntxp_store.out-line-discnt
     7362             v-cntxp-in-ov           = bf-cntxp_store.in-ov
     7363             v-cntxp-in-perm         = bf-cntxp_store.in-perm
     7364             v-cntxp-no-eq           = bf-cntxp_store.no-eq
     7365             v-cntxp-rsrv-time       = bf-cntxp_store.rsrv-time
     7366             v-cntxp-load-time       = bf-cntxp_store.load-time
     7367             v-cntxp-holidays        = bf-cntxp_store.holidays
     7368             v-cntxp-in-pay          = bf-cntxp_store.in-pay
     7369             v-cntxp-out-pay         = bf-cntxp_store.out-pay
     7370             v-cntxp-ret-pay         = bf-cntxp_store.ret-pay
     7371             v-cntxp-ret-sup-pay     = bf-cntxp_store.ret-sup-pay
     7372             v-cntxp-down-pay        = bf-cntxp_store.down-pay
     7373             v-cntxp-inv-pay         = bf-cntxp_store.inv-pay
     7374             v-cntxp-chk-pay         = bf-cntxp_store.chk-pay
     7375             v-cntxp-retail          = bf-cntxp_sysconf.ord-prt
     7376             v-cntxp-osn-base        = bf-cntxp_sysconf.osn-base
     7377             .
     7378         end.
     7379         when 'маг':U then do:
     7380           find first bf-cntxp_shop where bf-cntxp_shop.obj-code = v-cntxp-obj-code no-lock.
     7381           find first bf-cntxp_sysconf where bf-cntxp_sysconf.host-code = bf-cntxp_shop.host-code no-lock.
     7382           assign
     7383             v-cntxp-doc-prt         = (v-cntxp-conf-par = "yes") and bf-cntxp_shop.doc-prt
     7384             v-cntxp-price-calc      = bf-cntxp_shop.price-calc
