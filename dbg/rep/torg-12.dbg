    11010                   , output v-void-decimal
    11011                   , output v-void-decimal
    11012                   , output v-void-decimal
    11013                   , output v-void-decimal
    11014                   , output p-tax
    11015                   , output v-void-decimal
    11016               ).
    11017           end.
    11018           if v-torgconf-outt12 = yes
    11019           then do:
    11020               display stream out-stream
    11021                   fill(" ", 2) + v-tax-name @ ub.goods.gds-name
    11022                   "  -":C   @ v-okei
    11023                   " -":C   @ pack-type
    11024                   "  -":C   @ qnty-opl
    11025                   " -":C   @ qnty-pl
    11026                   " -":C   @ mass
    11027                   tqnty
    11028                   0             @ VAT-gds
    11029                   p-tax-price   @ price-noNDS
    11030                   p-tax         @ stoim-noNDS
    11031                   p-tax         @ stoim
    11032                   sym1 sym10 sym11 sym12 sym13 sym14 sym15 sym16
    11033               with frame f-doc-m.
    11034               down stream out-stream  with frame f-doc-m.
    11035           end.
    11036           else do:
    11037               display stream out-stream
    11038                   fill(" ", 2) + v-tax-name @ ub.goods.gds-name
    11039                   tqnty
    11040                   0             @ VAT-gds
    11041                   p-tax-price   @ price-noNDS
    11042                   p-tax         @ stoim-noNDS
    11043                   p-tax-price   @ price-withNDS
    11044                   p-tax         @ stoim
    11045                   sym1 sym10 sym11 sym12 sym13 sym14 sym15 sym16  sym18
    11046               with frame f-doc.
    11047               down stream out-stream  with frame f-doc.
    11048           end.
    11049           if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    11050           then do:
    11051             run torg12xl-write-line-data in this-procedure (
    11052                   input 0
    11053                 , input v-tax-name
    11054                 , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )
    11055                 , input unit-str
    11056                 , input "":U
    11057                 , input "":U
    11058                 , input "":U
    11059                 , input "":U
    11060                 , input "":U
    11061                 , input string( tqnty )
    11062                 , input string( p-tax-price )
    11063                 , input string( p-tax )
    11064                 , input "":U
    11065                 , input "":U
    11066                 , input string( p-tax )
    11067                 , input "":U
    11068                 , input "":U
    11069             ).
    11070           end.
    11071           else do:
    11072             run torg12xl-write-line-data in this-procedure (
    11073                   input 0
    11074                 , input v-tax-name
    11075                 , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( ub.bar-code.b-code )
    11076                 , input unit-str
    11077                 , input "-":U
    11078                 , input "-":U
    11079                 , input "-":U
    11080                 , input "-":U
    11081                 , input "-":U
    11082                 , input string( tqnty )
    11083                 , input string( p-tax-price )
    11084                 , input string( p-tax )
    11085                 , input "":U
    11086                 , input "":U
    11087                 , input string( p-tax )
    11088             ).
    11089           end.
    11090           assign
    11091               price-withNDS   = p-price-withNDS + p-tax-price
    11092               price-noNDS     = price-withNDS - p-VAT-gds - p-SLT-gds
    11093               prt-stoim-noNDS = price-noNDS * tqnty
    11094               prt-stoim       = prt-stoim-noNDS + VAT-gds
    11095               v-line-counter  = v-line-counter + 1
    11096           .
    11097           run writelog in this-procedure (
    11098                 input log-file-name
    11099               , input 4
    11100               , input substitute( "Еще раз вычислили сумму с НДС ( &1 ) для общего итога"
    11101                                   , dtm-char( string(prt-stoim) ) )
    11102           ).
    11103       end.
    11104   end.
    11105   end procedure.
    11106   procedure print-line-dtl :
    11107   define input parameter p-doc-line-recid                     as recid            no-undo.
    11108   define input-output parameter p-avg-VAT                     as decimal          no-undo.
    11109   define input-output parameter p-avg-prt-price               as decimal          no-undo.
    11110   define input-output parameter p-avg-prt-price-no-tax        as decimal          no-undo.
    11111   define input-output parameter p-avg-prt-sum-with-tax        as decimal          no-undo.
    11112   define input-output parameter p-avg-prt-sum-without-tax     as decimal          no-undo.
    11113   define output parameter p-prt-tqnty                         as decimal          no-undo.
    11114   define output parameter p-prt-VAT-gds                       as decimal          no-undo.
    11115   define output parameter p-prt-SLT-gds                       as decimal          no-undo.
    11116   define output parameter p-prt-stoim-noNDS                   as decimal          no-undo.
    11117   define output parameter p-prt-stoim                         as decimal          no-undo.
    11118       define variable v-avg-prt-sum-without-tax-out   as decimal      no-undo.
    11119       define variable v-avg-prt-sum-with-tax-out      as decimal      no-undo.
    11120       define variable v-avg-VAT-out                   as decimal      no-undo.
    11121       define variable v-VAT-pc                        as decimal      no-undo.
    11122       define variable v-SLT-pc                        as decimal      no-undo.
    11123       define variable v-void-decimal                  as decimal      no-undo.
    11124       define buffer buf_trn-doc       for ub.trn-doc.
    11125       define buffer buf_doc-line      for ub.doc-line.
    11126   do
    11127   for buf_trn-doc
    11128     , buf_doc-line
    11129   on error undo, return error
    11130   :
    11131       find first buf_doc-line no-lock
    11132            where recid( buf_doc-line ) = p-doc-line-recid
    11133       .
    11134       find first buf_trn-doc no-lock
    11135            where buf_trn-doc.doc-code = buf_doc-line.doc-code
    11136       .
    11137       assign
    11138           p-prt-tqnty       = 0.0
    11139           p-prt-VAT-gds     = 0.0
    11140           p-prt-SLT-gds     = 0.0
    11141           p-prt-stoim-noNDS = 0.0
    11142           p-prt-stoim       = 0.0
    11143       .
    11144           for each ub.gds-dtl no-lock
    11145              where ub.gds-dtl.prod-type = buf_doc-line.prod-type
    11146                and ub.gds-dtl.prod-code = buf_doc-line.prod-code
    11147                and ub.gds-dtl.artic     = buf_doc-line.artic
    11148                and ub.gds-dtl.doc-code  = buf_doc-line.doc-code
    11149           :
    11150               find first ub.gds-prt no-lock
    11151                    where ub.gds-prt.node-code = ub.gds-dtl.prt-code
    11152               .
    11153               if CostPrice = yes
    11154               then do:
    11155   assign
    11156     price-rubl-with-tax-loc = buf_doc-line.price-rubl
    11157     price-base-with-tax-loc = buf_doc-line.price-base
    11158   .
    11159   define variable vss-include-info65 as character format "x(65)" no-undo initial "@(#)$Workfile$".
    11160   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
    11161     (output varinvprb
    11162     )  .
    11163      find first in-vatp_doc-attr no-lock
    11164       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
    11165         and in-vatp_doc-attr.attr-code = 'envd':U
    11166       no-error .
    11167       if available in-vatp_doc-attr
    11168          then do:
    11169          assign
    11170            in-vatp-have-vat-slt = no.
    11171      end.
    11172      else do:
    11173        assign
    11174          in-vatp-have-vat-slt = yes.
    11175      end.
    11176      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
    11177                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
    11178                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
    11179      if (not buf_trn-doc.internal and
    11180              buf_trn-doc.doc-type = 'при':U) or
    11181         in-vatp-goods.gds-type = 'у':U then do:
    11182         if varinvprb = "base":u then do:
    11183           assign
    11184             road-tax-base-loc = buf_doc-line.road-tax
    11185             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
    11186         end.
    11187         else do:
    11188           ASSIGN
    11189             road-tax-rubl-loc = buf_doc-line.road-tax
    11190             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
    11191         end.
    11192         if road-tax-base-loc = ? then road-tax-base-loc = 0.
    11193         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
    11194         assign
    11195           road-tax-cli-loc = ?.
    11196         ASSIGN
    11197           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
    11198           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
    11199           transport-cli-loc  = 0
    11200           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
    11201           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
    11202           other-cli-loc      = 0
    11203           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
    11204           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
    11205                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    11206               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
    11207         assign
    11208           vat-cli-loc            = ?
    11209           slt-cli-loc            = ?
    11210           price-cli-with-tax-loc = ?.
    11211      end.
    11212      else do:
    11213                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
    11214                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
    11215                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
    11216                                         in-vatp-parts.artic     = buf_doc-line.artic     and
    11217                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
    11218                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
    11219                            use-index out-code no-lock:
    11220             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
    11221                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
    11222                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
    11223                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
    11224                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
    11225                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
    11226                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
    11227                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
    11228                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
    11229                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
