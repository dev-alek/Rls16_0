     1804   procedure torgconf-get-sup-param :
     1805   define input parameter p-obj-type           as character        no-undo.
     1806   define input parameter p-obj-code           as integer          no-undo.
     1807   define input parameter p-curr-code          as integer          no-undo.
     1808       define variable v-host-code    as integer      no-undo.
     1809       define variable v-par-type     as character    no-undo.
     1810   do
     1811   on error undo, return error
     1812   :
     1813       assign
     1814          v-torgconf-sup-host-code = v-host-code
     1815       .
     1816       if v-torgconf-sup-host-code = 0
     1817       then do:
     1818           assign
     1819               v-torgconf-sup-host-name           = "":U
     1820               v-torgconf-sup-host-addres         = "":U
     1821               v-torgconf-sup-host-post-addres    = "":U
     1822               v-torgconf-sup-host-phone          = "":U
     1823               v-torgconf-sup-host-inn            = "":U
     1824               v-torgconf-sup-host-kpp            = "":U
     1825               v-torgconf-sup-host-okpo           = "":U
     1826               v-torgconf-sup-host-egrip-date     = "":U
     1827               v-torgconf-sup-host-egrip-num      = "":U
     1828           .
     1829       end.
     1830       else do:
     1831           run fmtcli-get-client in this-procedure (
     1832                 input 'орг':U
     1833               , input v-torgconf-sup-host-code
     1834           ).
     1835           assign
     1836               v-torgconf-sup-host-name        = v-fmtcli-name
     1837               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1838               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1839               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1840               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1841               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1842               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1843               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1844           .
     1845           run gbl/clntat-v.p (
     1846                 input 'орг':U
     1847               , input v-torgconf-sup-host-code
     1848               , input 'egrip-date':U
     1849               , output v-torgconf-sup-host-egrip-date
     1850               , output v-par-type
     1851           ).
     1852           run gbl/clntat-v.p (
     1853                 input 'орг':U
     1854               , input v-torgconf-sup-host-code
     1855               , input 'egrip-num':U
     1856               , output v-torgconf-sup-host-egrip-num
     1857               , output v-par-type
     1858           ).
     1859           run fmtcli-get-bank in this-procedure (
     1860                 input v-host-code
     1861               , input 'орг':U
     1862               , input v-torgconf-sup-host-code
     1863               , input p-curr-code
     1864           ).
     1865       end.
     1866       assign
     1867           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1868           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1869           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1870           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1871           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1872           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1873           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1874           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1875       .
     1876       assign
     1877           v-torgconf-sup-obj-type = p-obj-type
     1878           v-torgconf-sup-obj-code = p-obj-code
     1879       .
     1880       if trim(p-obj-type) <> ""
     1881       and p-obj-code <> 0
     1882       then do:
     1883       run fmtcli-get-client in this-procedure (
     1884             input p-obj-type
     1885           , input p-obj-code
     1886       ).
     1887       assign
     1888           v-torgconf-sup-obj-name        = v-fmtcli-name
     1889           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1890           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1891           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1892           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1893           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1894           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1895       .
     1896      end.
     1897      end.
     1898   end procedure.
     1899   procedure torgconf-get-cli-param :
     1900   define input parameter p-host-obj-code      as integer          no-undo.
     1901   define input parameter p-obj-type           as character        no-undo.
     1902   define input parameter p-obj-code           as integer          no-undo.
     1903   define input parameter p-curr-code          as integer          no-undo.
     1904       define variable v-host-code    as integer      no-undo.
     1905   do
     1906   on error undo, return error
     1907   :
     1908       assign
     1909           v-torgconf-cli-type = p-obj-type
     1910           v-torgconf-cli-code = p-obj-code
     1911       .
     1912       run fmtcli-get-client in this-procedure (
     1913             input p-obj-type
     1914           , input p-obj-code
     1915       ).
     1916       assign
     1917           v-torgconf-cli-name         = trim( v-fmtcli-name          )
     1918           v-torgconf-cli-engl-name    = trim( v-fmtcli-engl-name          )
     1919           v-torgconf-cli-addres       = trim( v-fmtcli-full-addres   )
     1920           v-torgconf-cli-post-addres  = trim( v-fmtcli-post-addres   )
     1921           v-torgconf-cli-phone        = trim( v-fmtcli-phone         )
     1922           v-torgconf-cli-inn          = trim( v-fmtcli-inn           )
     1923           v-torgconf-cli-kpp          = trim( v-fmtcli-kpp           )
     1924           v-torgconf-cli-okpo         = trim( v-fmtcli-okpo          )
     1925       .
     1926      run fmtcli-get-bank in this-procedure (
     1927             input p-host-obj-code
     1928           , input p-obj-type
     1929           , input p-obj-code
     1930           , input p-curr-code
     1931       ).
     1932       assign
     1933           v-torgconf-cli-schet-exists = v-fmtcli-schet-exists
     1934           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1935           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1936           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1937           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
     1938           v-torgconf-cli-bank-name    = v-fmtcli-bank-name
     1939           v-torgconf-cli-bank-addres  = v-fmtcli-bank-addres
     1940           v-torgconf-cli-bank-city    = v-fmtcli-bank-city
     1941       .
     1942   end.
     1943   end procedure.
     1944   procedure torgconf-get-ship-param :
     1945   define input parameter p-host-obj-code      as integer          no-undo.
     1946   define input parameter p-obj-type           as character        no-undo.
     1947   define input parameter p-obj-code           as integer          no-undo.
     1948   define input parameter p-curr-code          as integer          no-undo.
     1949       define variable v-host-code    as integer      no-undo.
     1950   do
     1951   on error undo, return error
     1952   :
     1953       assign
     1954           v-torgconf-ship-type = p-obj-type
     1955           v-torgconf-ship-code = p-obj-code
     1956       .
     1957       if trim(p-obj-type) = ""
     1958       and p-obj-code = 0
     1959       then do:
     1960       assign
     1961           v-torgconf-ship-name         = "":U
     1962           v-torgconf-ship-addres       = "":U
     1963           v-torgconf-ship-post-addres  = "":U
     1964           v-torgconf-ship-phone        = "":U
     1965           v-torgconf-ship-inn          = "":U
     1966           v-torgconf-ship-kpp          = "":U
     1967           v-torgconf-ship-okpo         = "":U
     1968       .
     1969       end.
     1970       else do:
     1971       run fmtcli-get-client in this-procedure (
     1972             input p-obj-type
     1973           , input p-obj-code
     1974       ).
     1975       assign
     1976           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1977           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1978           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1979           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1980           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1981           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1982           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1983           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1984       .
     1985       end.
     1986           run fmtcli-get-bank in this-procedure (
     1987             input p-host-obj-code
     1988           , input p-obj-type
     1989           , input p-obj-code
     1990           , input p-curr-code
     1991       ).
     1992       assign
     1993           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1994           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1995           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1996           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1997           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1998           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1999           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     2000           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     2001       .
     2002   end.
     2003   end procedure.
     2004   procedure torgconf-get-holdfirm-code :
     2005   define input parameter p-obj-type   as character        no-undo.
     2006   define input parameter p-obj-code   as integer          no-undo.
     2007   define output parameter p-firm-code as integer          no-undo.
     2008       define variable v-firm-code-str     as character    no-undo.
     2009       define variable v-par-type          as character    no-undo.
     2010       define buffer buf_clients       for ub.clients.
     2011   do
     2012   for buf_clients
     2013   on error undo, return error
     2014   :
     2015       run gbl/clntat-v.p (
     2016             input p-obj-type
     2017           , input p-obj-code
     2018           , input 'holdfirm-code':U
     2019           , output v-firm-code-str
     2020           , output v-par-type
     2021       ).
     2022       assign
     2023           p-firm-code = integer( v-firm-code-str )
     2024       no-error.
     2025       if error-status :error
     2026       then do:
     2027           message
     2028               "Неверно задан код фирмы для печати накладных."
     2029           view-as alert-box warning.
     2030           assign
     2031               p-firm-code = 0
     2032           .
     2033       end.
     2034       else do:
     2035           find first buf_clients no-lock
     2036                where buf_clients.obj-type = 'орг':U
     2037                  and buf_clients.obj-code = p-firm-code
     2038           no-error.
     2039           if not available buf_clients
     2040           then do:
     2041               message
     2042                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2043                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2044               view-as alert-box warning.
     2045               assign
     2046                   p-firm-code = 0
     2047               .
     2048           end.
     2049       end.
     2050   end.
     2051   end procedure.
     2052   procedure torgconf-get-post-head:
     2053   define input  parameter p-obj-type             as character        no-undo.
     2054   define input  parameter p-obj-code             as integer          no-undo.
     2055   define output parameter p-torgconf-post-head   as character        no-undo.
     2056      define variable v-host-code         as integer      no-undo.
     2057      define buffer buf_sysconf     for ub.sysconf.
     2058        assign
     2059         p-torgconf-post-head  = ""
     2060        .
     2061   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2062   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2063     (input  p-obj-type
     2064     ,input  p-obj-code
     2065     ,output v-host-code
     2066     )  .
     2067      find first buf_sysconf no-lock
     2068      where buf_sysconf.host-code = v-host-code
     2069      no-error.
     2070      if available buf_sysconf
     2071      then do:
     2072         assign
     2073            p-torgconf-post-head = buf_sysconf.head-position
     2074         .
     2075      end.
     2076   end procedure.
     2077   procedure torgconf-get-storekeeper:
     2078   define input  parameter p-wrkr                   as integer          no-undo.
     2079   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2080   define output parameter p-torgconf-post          as character        no-undo.
     2081      define buffer buf_sysconf     for ub.sysconf.
     2082      define buffer buf_person      for ub.person.
     2083      define buffer buf_shop        for ub.shop .
     2084      define buffer buf_store       for ub.store .
     2085      if v-torgconf-outC = "no_print"
     2086      then do:
     2087         assign p-torgconf-post = ""
     2088                p-torgconf-wrkr-name = ""
     2089                .
     2090      end.
     2091      if v-torgconf-outC = "clad_doc"
     2092      then do:
     2093         run rep/get-psn.p
     2094               (input  p-wrkr
     2095               ,output p-torgconf-wrkr-name
     2096               ) .
     2097         find first buf_person no-lock
     2098         where buf_person.psn-code = p-wrkr
     2099         no-error.
     2100         if available buf_person
     2101         then do:
     2102           p-torgconf-post = buf_person.position.
     2103         end.
     2104         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2105         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2106      end.
     2107      if v-torgconf-outC = "clad_obj"
     2108      then do:
     2109         CASE v-torgconf-self-obj-type:
     2110         WHEN 'маг':U
     2111         THEN DO:
     2112            find first buf_shop no-lock
     2113            where buf_shop.obj-code = v-torgconf-self-obj-code
     2114            .
     2115            assign
     2116               p-torgconf-wrkr-name = buf_shop.store-man
     2117               p-torgconf-post = ""
     2118            .
     2119            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2120         END.
     2121         WHEN 'скл':U
     2122         THEN DO:
     2123            find first buf_store no-lock
     2124            where buf_store.obj-code = v-torgconf-self-obj-code
     2125            .
     2126            assign
     2127               p-torgconf-wrkr-name = buf_store.store-man
     2128               p-torgconf-post = ""
     2129            .
     2130            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2131         END.
     2132         OTHERWISE DO:
     2133            assign
     2134               p-torgconf-post = "":U
     2135               p-torgconf-wrkr-name = "":U
     2136            .
     2137         END.
     2138         END CASE.
     2139      end.
     2140    end procedure.
     2141   procedure torgconf-get-form-header :
     2142   define input parameter p-for-inverse    as logical          no-undo.
     2143   define input parameter p-doc-code       as character        no-undo.
     2144   define input parameter p-print-doc      as logical          no-undo.
