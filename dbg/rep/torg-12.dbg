    14137                           , input string( v-tax-parts-price )
    14138                           , input string( v-tax )
    14139                           , input "":U
    14140                           , input "":U
    14141                           , input string( v-tax )
    14142                       ).
    14143                   end.
    14144                   assign
    14145                       v-tax           = v-tax-price * tqnty
    14146                       price-noNDS     = price-noNDS + v-tax-price
    14147                       stoim-noNDS     = price-noNDS * tqnty
