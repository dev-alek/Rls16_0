    10360                                , output v-tax-name
    10361                                ).
    10362                   run writelog in this-procedure (log-file-name, 4, "Есть третий налог ( " + dtm-char( v-tax-name )
    10363                                                           + " ) сумма ( " + dtm-char( string( v-tax ) ) + " )"
    10364                                                       ).
    10365                   parts-for-tax:
    10366                   for each buf_tax_parts
    10367                      where buf_tax_parts.obj-type     = doc-line.obj-type
    10368                        and buf_tax_parts.obj-code     = doc-line.obj-code
    10369                        and buf_tax_parts.artic        = goods.artic
    10370                        and buf_tax_parts.prod-type    = goods.prod-type
    10371                        and buf_tax_parts.prod-code    = goods.prod-code
    10372                        and buf_tax_parts.out-code     = doc-line.doc-code
    10373                   break by buf_tax_parts.road-tax-base
    10374                   :
    10375                       if first-of (buf_tax_parts.road-tax-base)
    10376                       then do:
    10377                           assign
    10378                               v-parts-tax-qnty    = 0
    10379                               v-tax               = 0
    10380                               v-tax-parts-price   =  ( if PrintRubl
    10381                                                       then buf_tax_parts.road-tax-rubl
