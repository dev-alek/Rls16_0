    10145       else do:
    10146            in-vatp-have-vat-slto = no.
    10147       end.
    10148     end.
    10149     assign
    10150      price-cli-with-tax-loco = out-vatp_parts.price-cli
    10151      cli-base-rateo          = out-vatp_parts.cli-base-rate.
    10152     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
    10153              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
    10154     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
    10155             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
    10156             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
    10157             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
    10158             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
    10159             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
    10160             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
    10161       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
    10162     assign
    10163       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
    10164     assign
    10165       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
    10166       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
    10167       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
    10168       transport-cli-loco  = 0
    10169       other-cli-loco      = 0
    10170     .
    10171   ASSIGN
    10172             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
    10173       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
    10174   .
    10175         assign
    10176           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
    10177           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
    10178         assign
    10179           varis-cons-parts-have = yes
    10180           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
    10181       end.
    10182       assign
    10183         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
    10184     end.
    10185   end.
    10186   assign
    10187     varprice-base-cons = varprice-base-cons / varcons-qnty
    10188     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
    10189   if varprice-base-cons = ? then do:
    10190     assign
    10191       varprice-base-cons = 0.
    10192   end.
    10193   if varprice-rubl-cons = ? then do:
    10194     assign
    10195       varprice-rubl-cons = 0.
    10196   end.
    10197   assign
    10198       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
    10199     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
    10200     discnt-base-sale            = gds-dtl.discnt-base
    10201     price-base-with-tax-sale    = (gds-dtl.price-base - gds-dtl.discnt-base)
    10202       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc)
    10203     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
    10204     discnt-rubl-sale            = gds-dtl.discnt-rubl
    10205     price-rubl-with-tax-sale    = (gds-dtl.price-rubl - gds-dtl.discnt-rubl)
    10206     .
    10207   if buf_trn-doc.doc-type = 'инв':U then do:
    10208     assign
    10209       varfact-qnty = gds-dtl.doc-qnty.
    10210   end.
    10211   else do:
    10212     assign
    10213       varfact-qnty = gds-dtl.fact-qnty.
    10214   end.
    10215   if varis-cons-parts-have = no then do:
    10216     assign
    10217           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc)
    10218           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc).
    10219   end.
    10220   else do:
    10221     if buf_trn-doc.doc-type = 'инв':U then do:
    10222       assign
    10223               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
    10224               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
    10225        .
    10226     end.
    10227     else do:
    10228       assign
    10229               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-base - gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-base - gds-dtl.discnt-base                - road-tax-base-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-base-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
    10230               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * doc-line.cons-vat-pc / (100 + doc-line.cons-vat-pc) * gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((gds-dtl.price-rubl - gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else gds-dtl.price-rubl - gds-dtl.discnt-rubl                - road-tax-rubl-sale) * doc-line.SLT-pc / (100 + doc-line.SLT-pc) - varprice-rubl-cons) * doc-line.vat-pc / (100 + doc-line.vat-pc) * gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
    10231        .
    10232     end.
    10233   end.
    10234   assign
    10235   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
    10236   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
    10237                         assign
    10238                             VAT-gds         = ( if PrintRubl then vat-rubl-buyer else vat-base-buyer )
    10239                             SLT-gds         = ( if PrintRubl then slt-rubl-sale  else slt-base-sale  )
    10240                             v-tax-price     = ( if PrintRubl then road-tax-rubl-sale else road-tax-base-sale )
    10241                             price-withNDS   = ( if PrintRubl
    10242                                                 then price-rubl-with-tax-sale - v-tax-price
    10243                                                 else price-base-with-tax-sale - v-tax-price
    10244                                               )
    10245                             v-tax           = v-tax-price * tqnty
    10246                             v-tax-sum       = v-tax-sum + v-tax
    10247                         .
    10248                       end.
    10249                   end.
    10250               end.
    10251               if VAT-gds = ? then assign VAT-gds = 0.
    10252               if SLT-gds = ? then assign SLT-gds = 0.
    10253               assign
    10254                   price-noNDS = price-withNDS - VAT-gds - SLT-gds
    10255               .
    10256               if p-round = "round":U
    10257               then do:
    10258                   run p-fmt-round in this-procedure (
    10259                         input tqnty
    10260                       , input price-noNDS
    10261                       , input VAT-gds
    10262                       , input SLT-gds
    10263                       , input 0
    10264                       , output price-noNDS
    10265                       , output v-VAT-pc
    10266                       , output v-SLT-pc
    10267                       , output VAT-gds
    10268                       , output SLT-gds
    10269                       , output v-void-decimal
    10270                       , output stoim-noNDS
    10271                       , output stoim
    10272                   ).
    10273                   assign
    10274                       stoim           = stoim - SLT-gds
    10275                       price-withNDS   = stoim / tqnty
    10276                   .
    10277               end.
    10278               else do:
    10279                   assign
    10280                       VAT-gds     = VAT-gds * tqnty
    10281                       SLT-gds     = SLT-gds * tqnty
    10282                       stoim-noNDS = price-noNDS * tqnty
    10283                       stoim       = stoim-noNDS + VAT-gds
    10284                   .
    10285               end.
    10286               run writelog in this-procedure (log-file-name, 3, "Печать не по партиям. Стоимость с НДС ( "
    10287                                                                           + dtm-char( string( stoim ) )
    10288                                                                           + " ). Количество ( "
    10289                                                                           + dtm-char( string( tqnty ) )
    10290                                                                           + " ). Третий налог ( "
    10291                                                                           + dtm-char( string( v-tax ) )
    10292                                                                           + " )"
    10293                                                   ).
    10294               if v-torgconf-outt12 = yes
    10295               then do:
    10296                   display stream out-stream
    10297                       v-doc-line-counter
    10298                       v-gds-name @ goods.gds-name
    10299                       if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code ) @ tb-code
    10300                       unit-str @ goods.unit-base
    10301                       v-okei
    10302                       " -":C   @ pack-type
    10303                       "  -":C   @ qnty-opl
    10304                       " -":C   @ qnty-pl
    10305                       " -":C   @ mass
    10306                       tqnty
    10307                       price-noNDS
    10308                       stoim-noNDS
    10309                       doc-line.VAT-pc
    10310                       VAT-gds when tqnty <> 0
    10311                       stoim
    10312                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10313                       sym11 sym12 sym13 sym14 sym15 sym16
    10314                   with frame f-doc-m.
    10315                   down stream out-stream  with frame f-doc-m.
    10316               end.
    10317               else do:
    10318                   display stream out-stream
    10319                       v-doc-line-counter
    10320                       v-gds-name @ goods.gds-name
    10321                       if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code ) @ tb-code
    10322                       unit-str @ goods.unit-base
    10323                       v-okei
    10324                       " -":C   @ pack-type
    10325                       "  -":C   @ qnty-opl
    10326                       " -":C   @ qnty-pl
    10327                       " -":C   @ mass
    10328                       tqnty
    10329                       price-noNDS
    10330                       stoim-noNDS
    10331                       doc-line.VAT-pc
    10332                       VAT-gds when tqnty <> 0
    10333                       stoim
    10334                       price-withNDS
    10335                       sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10
    10336                       sym11 sym12 sym13 sym14 sym15 sym16  sym18
    10337                   with frame f-doc.
    10338                   down stream out-stream  with frame f-doc.
    10339               end.
    10340               run torg12xl-write-line-data in this-procedure (
    10341                     input v-doc-line-counter
    10342                   , input (if rep-artic then (string(goods.artic) + " ") else "") + goods.gds-name
    10343                   , input if lookup( "VNESH_ART":U, p-mode ) <> 0 then v-ext-artic else string( bar-code.b-code )
    10344                   , input unit-str
    10345                   , input v-okei
    10346                   , input "-":U
    10347                   , input "-":U
    10348                   , input "-":U
    10349                   , input "-":U
    10350                   , input string( tqnty )
    10351                   , input string( price-noNDS )
    10352                   , input string( stoim-noNDS )
    10353                   , input string( doc-line.VAT-pc )
    10354                   , input string( VAT-gds )
