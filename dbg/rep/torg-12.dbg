     4478   define input parameter p-pack           as character        no-undo.
     4479   define input parameter p-AmountInPl     as character        no-undo.
     4480   define input parameter p-PlaceAmount    as character        no-undo.
     4481   define input parameter p-Mass           as character        no-undo.
     4482   define input parameter p-qnty           as character        no-undo.
     4483   define input parameter p-price          as character        no-undo.
     4484   define input parameter p-SumNoVAT       as character        no-undo.
