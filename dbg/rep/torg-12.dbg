     6923   do
     6924   on error undo, return error return-value
     6925   :
     6926       if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run thbjattr_code in g#attr-lib
     6927       (input  p-upper-code
     6928       ,input  p-code
     6929       ,output p-label
     6930       ,output p-user-can-edit
     6931       ,output p-output-display
     6932       ,output p-other
     6933       ,output p-prop-list
     6934       ,output p-prop-type-list
     6935       ,output p-prop-label-list
     6936       ,output p-global
     6937       ,output p-host
     6938       ,output p-shop
