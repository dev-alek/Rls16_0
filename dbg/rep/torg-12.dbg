     3888   procedure torgconf-get-reason  :
     3889   define input parameter  p-doc-code       as character        no-undo.
     3890   define input parameter  p-reason-code    as integer          no-undo .
     3891   define input parameter  p-doc-type       as character        no-undo.
     3892       if p-reason-code > 0
     3893       then do:
     3894           define buffer buf_trn-reason for ub.trn-reason.
     3895           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3896           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3897       end.
     3898       else do:
     3899           if p-doc-type = 'при':U
     3900           then  do:
     3901               define variable v-attr-type     as character    no-undo.
     3902               define variable v-attr-value    as character    no-undo.
     3903               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3904               assign v-torgconf-reason = v-attr-value .
     3905               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3906               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3907           end.
     3908       end.
     3909   end procedure.
     3910   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3911       def var log-file-name as char no-undo.
     3912       assign
     3913           log-file-name = ''
     3914       .
     3915       if log-file-name <> "":U
     3916       then do:
     3917           if search( '' ) = ?
     3918           then do:
     3919               output to value( '' ).
     3920               output close.
     3921           end.
     3922       end.
     3923       DEF STREAM stm-log.
     3924       PROCEDURE writelog:
     3925       DEF INPUT PARAMETER p-file-name AS CHAR     NO-UNDO.
     3926       DEF INPUT PARAMETER p-log-level AS INTEGER  NO-UNDO.
     3927       DEF INPUT PARAMETER p-log-string  AS CHAR     NO-UNDO.
     3928       if p-file-name <> ""
     3929       then do:
     3930       OUTPUT STREAM stm-log TO VALUE(p-file-name) APPEND.
     3931           PUT STREAM stm-log UNFORMATTED chr(10).
     3932           PUT STREAM stm-log UNFORMATTED (IF (p-log-level = 0 OR p-log-string = "&DLine"
     3933                                           OR p-log-string = "&Line") THEN "" ELSE
     3934                                           cur-time-string-sec() + " ").
     3935           PUT STREAM stm-log UNFORMATTED
     3936                   (IF p-log-string = "&Line" THEN FILL("-", 80)
     3937                   ELSE IF p-log-string = "&DLine" THEN FILL("=", 80)
     3938                   ELSE fill(" ", p-log-level * 2) + p-log-string).
     3939       OUTPUT STREAM stm-log CLOSE.
     3940       end.
     3941       END PROCEDURE.
     3942   def var vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3943   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     3944   procedure paramls-clear :
     3945     define buffer buf_temp-param for temp-param .
     3946     do
     3947     on error undo, return error return-value
     3948     :
     3949       for each buf_temp-param
     3950       on error undo, return error
     3951       :
     3952         delete buf_temp-param .
     3953       end.
     3954     end.
     3955   end procedure.
     3956   procedure paramls-write :
     3957     define input  parameter p-code     as character no-undo .
     3958     define input  parameter p-sub-code as character no-undo .
     3959     define input  parameter p-value    as character no-undo .
     3960     define buffer buf_temp-param for temp-param .
     3961     do
     3962     on error undo, return error return-value
     3963     :
     3964       find first buf_temp-param
     3965         where buf_temp-param.param-code     = p-code
     3966           and buf_temp-param.param-sub-code = p-sub-code
     3967         no-error .
     3968       if not available buf_temp-param then do:
     3969         create buf_temp-param .
     3970         assign
     3971           buf_temp-param.param-code     = p-code
     3972           buf_temp-param.param-sub-code = p-sub-code
     3973         .
     3974       end.
     3975       assign
     3976         buf_temp-param.param-value = p-value
     3977       .
     3978     end.
     3979   end procedure.
     3980   procedure paramls-read :
     3981     define input  parameter p-code          as character no-undo .
     3982     define input  parameter p-sub-code      as character no-undo .
     3983     define input  parameter p-default-value as character no-undo .
     3984     define output parameter p-value         as character no-undo .
     3985     define buffer buf_temp-param for temp-param .
     3986     do
     3987     on error undo, return error return-value
     3988     :
     3989       find first buf_temp-param
     3990         where buf_temp-param.param-code     = p-code
     3991           and buf_temp-param.param-sub-code = p-sub-code
     3992         no-error .
     3993       if available buf_temp-param then do:
     3994         assign
     3995           p-value = buf_temp-param.param-value
     3996         .
     3997       end.
     3998       else do:
     3999         assign
     4000           p-value = p-default-value
     4001         .
     4002       end.
     4003     end.
     4004   end procedure.
     4005   procedure paramls-append :
     4006     define input  parameter p-code     as character no-undo .
     4007     define input  parameter p-sub-code as character no-undo .
     4008     define input  parameter p-value    as character no-undo .
     4009     define buffer buf_temp-param for temp-param .
     4010     do
     4011     on error undo, return error return-value
     4012     :
     4013       find first buf_temp-param
     4014            where buf_temp-param.param-code     = p-code
     4015              and buf_temp-param.param-sub-code = p-sub-code
     4016         no-error .
     4017       if not available buf_temp-param then do:
     4018         create buf_temp-param .
     4019         assign
     4020           buf_temp-param.param-code     = p-code
     4021           buf_temp-param.param-sub-code = p-sub-code
     4022           buf_temp-param.param-value    = p-value
     4023         .
     4024       end.
     4025       else do:
     4026           assign
     4027               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     4028           .
     4029       end.
     4030     end.
     4031   end procedure.
     4032   FUNCTION LastMonthDate RETURNS DATE    ( INPUT i-date AS DATE ) :
     4033     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4034     RUN get-last-month-date IN THIS-PROCEDURE ( INPUT i-date, OUTPUT t_date ) NO-ERROR.
     4035     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     4036   END FUNCTION.
     4037   PROCEDURE get-last-month-date :
     4038     DEFINE  INPUT PARAMETER p-curr-date AS DATE NO-UNDO.
     4039     DEFINE OUTPUT PARAMETER p-last-date AS DATE NO-UNDO.
     4040     DO ON ERROR UNDO, RETURN ERROR :
     4041       ASSIGN p-last-date = DATE( MONTH( p-curr-date ), 28,  YEAR( p-curr-date ) ).
     4042       ASSIGN p-last-date = p-last-date - DAY( p-last-date + 4 ) + 4.
     4043     END.
     4044   END PROCEDURE.
     4045   FUNCTION LastMonthDay  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4046     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     4047     RUN get-last-month-day IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_day ) NO-ERROR.
     4048     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     4049   END FUNCTION.
     4050   PROCEDURE get-last-month-day :
     4051     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4052     DEFINE OUTPUT PARAMETER p-day  AS INTEGER NO-UNDO.
     4053     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4054     DO ON ERROR UNDO, RETURN ERROR :
     4055       ASSIGN t_date = DATE( MONTH( p-date ), 28,  YEAR( p-date ) ).
     4056       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     4057     END.
     4058   END PROCEDURE.
     4059   FUNCTION LastDay-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4060     DEFINE VARIABLE j_day AS INTEGER NO-UNDO.
     4061     RUN get-last-day-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_day ) NO-ERROR.
     4062     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_day ).
     4063   END FUNCTION.
     4064   PROCEDURE get-last-day-MY :
     4065     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4066     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     4067     DEFINE OUTPUT PARAMETER p-day   AS INTEGER NO-UNDO.
     4068     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4069     DO ON ERROR UNDO, RETURN ERROR :
     4070       ASSIGN t_date = DATE( p-month, 28, p-year ).
     4071       ASSIGN p-day  = DAY( t_date - DAY( t_date + 4 ) + 4 ).
     4072     END.
     4073   END PROCEDURE.
     4074   FUNCTION LastDate-MY RETURNS DATE    ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4075     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4076     RUN get-last-date-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT t_date ) NO-ERROR.
     4077     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE t_date ).
     4078   END FUNCTION.
     4079   PROCEDURE get-last-date-MY :
     4080     DEFINE  INPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4081     DEFINE  INPUT PARAMETER p-year  AS INTEGER NO-UNDO.
     4082     DEFINE OUTPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4083     DO ON ERROR UNDO, RETURN ERROR :
     4084       ASSIGN p-date = DATE( p-month, 28, p-year ).
     4085       ASSIGN p-date = p-date - DAY( p-date + 4 ) + 4.
     4086     END.
     4087   END PROCEDURE.
     4088   FUNCTION NextMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4089     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4090     RUN get-next-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     4091     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4092   END FUNCTION.
     4093   PROCEDURE get-next-month :
     4094     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4095     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4096     DO ON ERROR UNDO, RETURN ERROR :
     4097       ASSIGN p-month = ( MONTH( p-date ) MODULO 12 ) + 1.
     4098     END.
     4099   END PROCEDURE.
     4100   FUNCTION NextYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4101     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4102     RUN get-next-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     4103     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4104   END FUNCTION.
     4105   PROCEDURE get-next-year :
     4106     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4107     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4108     DO ON ERROR UNDO, RETURN ERROR :
     4109       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) < 12 THEN 0 ELSE 1 ).
     4110     END.
     4111   END PROCEDURE.
     4112   FUNCTION PrevMonth RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4113     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4114     RUN get-prev-month IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_month ) NO-ERROR.
     4115     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4116   END FUNCTION.
     4117   PROCEDURE get-prev-month :
     4118     DEFINE  INPUT PARAMETER p-date  AS DATE    NO-UNDO.
     4119     DEFINE OUTPUT PARAMETER p-month AS INTEGER NO-UNDO.
     4120     DO ON ERROR UNDO, RETURN ERROR :
     4121       ASSIGN p-month = ( ( ( MONTH( p-date ) + 10 ) MODULO 12 ) MODULO 12 ) + 1.
     4122     END.
     4123   END PROCEDURE.
     4124   FUNCTION PrevYear  RETURNS INTEGER ( INPUT i-date AS DATE ) :
     4125     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4126     RUN get-prev-year IN THIS-PROCEDURE ( INPUT i-date, OUTPUT j_year ) NO-ERROR.
     4127     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4128   END FUNCTION.
     4129   PROCEDURE get-prev-year :
     4130     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4131     DEFINE OUTPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4132     DO ON ERROR UNDO, RETURN ERROR :
     4133       ASSIGN p-year = YEAR( p-date ) + ( IF MONTH( p-date ) = 1 THEN -1 ELSE 0 ).
     4134     END.
     4135   END PROCEDURE.
     4136   FUNCTION NextMonth-MY RETURNS INTEGER ( INPUT i-month AS INTEGER ) :
     4137     DEFINE VARIABLE j_month AS INTEGER NO-UNDO.
     4138     RUN get-next-month-MY IN THIS-PROCEDURE ( INPUT i-month, OUTPUT j_month ) NO-ERROR.
     4139     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month ).
     4140   END FUNCTION.
     4141   PROCEDURE get-next-month-MY :
     4142     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     4143     DEFINE OUTPUT PARAMETER p-next-month AS INTEGER NO-UNDO.
     4144     DO ON ERROR UNDO, RETURN ERROR :
     4145       ASSIGN p-next-month = ( p-curr-month MODULO 12 ) + 1.
     4146     END.
     4147   END PROCEDURE.
     4148   FUNCTION NextYear-MY  RETURNS INTEGER ( INPUT i-month AS INTEGER, INPUT i-year AS INTEGER ) :
     4149     DEFINE VARIABLE j_year AS INTEGER NO-UNDO.
     4150     RUN get-next-year-MY IN THIS-PROCEDURE ( INPUT i-month, INPUT i-year, OUTPUT j_year ) NO-ERROR.
     4151     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_year ).
     4152   END FUNCTION.
     4153   PROCEDURE get-next-year-MY :
     4154     DEFINE  INPUT PARAMETER p-curr-month AS INTEGER NO-UNDO.
     4155     DEFINE  INPUT PARAMETER p-curr-year  AS INTEGER NO-UNDO.
     4156     DEFINE OUTPUT PARAMETER p-next-year  AS INTEGER NO-UNDO.
     4157     DO ON ERROR UNDO, RETURN ERROR :
     4158       ASSIGN p-next-year = p-curr-year + ( IF p-curr-month < 12 THEN 0 ELSE 1 ).
     4159     END.
     4160   END PROCEDURE.
     4161   FUNCTION MonthNameRus RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4162     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4163     RUN get-month-name-rus IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4164     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4165   END FUNCTION.
     4166   PROCEDURE get-month-name-rus :
     4167     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4168     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4169     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь".
     4170     DO ON ERROR UNDO, RETURN ERROR :
     4171       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4172     END.
     4173   END PROCEDURE.
     4174   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
     4175     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
     4176     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
     4177     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
     4178   END FUNCTION.
     4179   PROCEDURE get-month-name-gen :
     4180     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
     4181     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
     4182     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
     4183     DO ON ERROR UNDO, RETURN ERROR :
     4184       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
     4185     END.
     4186   END PROCEDURE.
     4187   FUNCTION CalcMonthes  RETURNS INTEGER ( INPUT i-date-from AS DATE, INPUT i-date-till AS DATE ) :
     4188     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     4189     RUN get-month-number IN THIS-PROCEDURE ( INPUT i-date-from, INPUT i-date-till, OUTPUT j_month-num ) NO-ERROR.
     4190     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     4191   END FUNCTION.
     4192   PROCEDURE get-month-number :
     4193     DEFINE  INPUT PARAMETER p-date-from AS DATE    NO-UNDO.
     4194     DEFINE  INPUT PARAMETER p-date-till AS DATE    NO-UNDO.
     4195     DEFINE OUTPUT PARAMETER p-month-num AS INTEGER NO-UNDO.
     4196     DO ON ERROR UNDO, RETURN ERROR :
     4197       ASSIGN p-month-num = ( YEAR(  p-date-till ) - YEAR(  p-date-from ) ) * 12 +
     4198                              MONTH( p-date-till ) - MONTH( p-date-from )   +  1 .
     4199     END.
     4200   END PROCEDURE.
     4201   FUNCTION CalcMonth-MY RETURNS INTEGER ( INPUT i-year-from  AS INTEGER,
     4202                                           INPUT i-month-from AS INTEGER,
     4203                                           INPUT i-year-till  AS INTEGER,
     4204                                           INPUT i-month-till AS INTEGER  ) :
     4205     DEFINE VARIABLE j_month-num AS INTEGER NO-UNDO.
     4206     RUN get-month-num-MY IN THIS-PROCEDURE (  INPUT i-year-from,
     4207                                               INPUT i-month-from,
     4208                                               INPUT i-year-till,
     4209                                               INPUT i-month-till,
     4210                                              OUTPUT j_month-num   ) NO-ERROR.
     4211     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE j_month-num ).
     4212   END FUNCTION.
     4213   PROCEDURE get-month-num-MY :
     4214     DEFINE  INPUT PARAMETER p-year-from  AS INTEGER NO-UNDO.
     4215     DEFINE  INPUT PARAMETER p-month-from AS INTEGER NO-UNDO.
     4216     DEFINE  INPUT PARAMETER p-year-till  AS INTEGER NO-UNDO.
     4217     DEFINE  INPUT PARAMETER p-month-till AS INTEGER NO-UNDO.
     4218     DEFINE OUTPUT PARAMETER p-month-num  AS INTEGER NO-UNDO.
     4219     DO ON ERROR UNDO, RETURN ERROR :
     4220       ASSIGN p-month-num = ( p-year-till - p-year-from ) * 12 + p-month-till - p-month-from + 1.
     4221     END.
     4222   END PROCEDURE.
     4223   FUNCTION DateTimeHeader RETURNS CHARACTER ( INPUT i-date AS DATE ) :
     4224     DEFINE VARIABLE v-header AS CHARACTER NO-UNDO.
     4225     RUN get-date-time-header IN THIS-PROCEDURE ( INPUT i-date, OUTPUT v-header ) NO-ERROR.
     4226     RETURN ( IF ERROR-STATUS :ERROR THEN "":U ELSE v-header ).
     4227   END FUNCTION.
     4228   PROCEDURE get-date-time-header :
     4229     DEFINE  INPUT PARAMETER p-date AS DATE      NO-UNDO.
     4230     DEFINE OUTPUT PARAMETER p-head AS CHARACTER NO-UNDO.
     4231     DO ON ERROR UNDO, RETURN ERROR :
     4232       IF p-date = ? THEN DO: ASSIGN p-date = TODAY. END.
     4233       ASSIGN p-head = "Дата печати: " + STRING( p-date, "99.99.9999":U ) + ", ":U + STRING( TIME, "HH:MM":U ).
     4234     END.
     4235   END PROCEDURE.
     4236   FUNCTION Leap-Year RETURNS LOGICAL ( INPUT i-year AS INTEGER ) :
     4237     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     4238     RUN get-leap-year-sign IN THIS-PROCEDURE ( INPUT i-year, OUTPUT bissextile ) NO-ERROR.
     4239     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     4240   END FUNCTION.
     4241   PROCEDURE get-leap-year-sign :
     4242     DEFINE  INPUT PARAMETER p-year AS INTEGER NO-UNDO.
     4243     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     4244     DEFINE VARIABLE t_date AS DATE NO-UNDO.
     4245     DO ON ERROR UNDO, RETURN ERROR :
     4246       IF p-year = ? OR p-year = 0 THEN DO:
     4247         ASSIGN t_date = TODAY.
     4248         IF t_date <> TODAY THEN DO: ASSIGN t_date = TODAY. END.
     4249         ASSIGN p-year = YEAR( t_date ).
     4250       END.
     4251       ASSIGN p-sign = ( INTEGER( TRUNCATE( p-year * 0.25, 0 ) ) * 4 = p-year ).
     4252     END.
     4253   END PROCEDURE.
     4254   FUNCTION Leap-Year-d RETURNS LOGICAL ( INPUT i-date AS DATE ) :
     4255     DEFINE VARIABLE bissextile AS LOGICAL NO-UNDO.
     4256     RUN get-leap-year-sign-d IN THIS-PROCEDURE ( INPUT i-date, OUTPUT bissextile ) NO-ERROR.
     4257     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE bissextile ).
     4258   END FUNCTION.
     4259   PROCEDURE get-leap-year-sign-d :
     4260     DEFINE  INPUT PARAMETER p-date AS DATE    NO-UNDO.
     4261     DEFINE OUTPUT PARAMETER p-sign AS LOGICAL NO-UNDO.
     4262     DEFINE VARIABLE j-year AS INTEGER NO-UNDO.
     4263     DO ON ERROR UNDO, RETURN ERROR :
     4264       IF p-date = ? THEN DO:
     4265         ASSIGN p-date = TODAY.
     4266         IF p-date <> TODAY THEN DO: ASSIGN p-date = TODAY. END.
     4267       END.
     4268       ASSIGN j-year = YEAR( p-date ).
     4269       ASSIGN p-sign = ( INTEGER( TRUNCATE( j-year * 0.25, 0 ) ) * 4 = j-year ).
     4270     END.
     4271   END PROCEDURE.
     4272   define new global shared variable g#attr-lib  as handle no-undo .
     4273   define variable v-attr-lib-variable as handle no-undo .
     4274   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4275     define variable v-cntxt-db-num        as integer   no-undo .
     4276     define variable v-cntxt-userid        as character no-undo .
     4277     define variable v-cntxt-level         as character no-undo .
     4278     define variable v-cntxt-host-code-obj as integer   no-undo .
     4279     define variable v-cntxt-obj-type      as character no-undo .
     4280     define variable v-cntxt-obj-code      as integer   no-undo .
     4281     define variable v-cntxt-db-num-obj    as integer   no-undo .
     4282     define variable v-cntxt-is-admin      as logical   no-undo .
     4283   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4284     run mainmenu_getcntxt in p-mainmenu-handle
     4285       (output v-cntxt-db-num
     4286       ,output v-cntxt-userid
     4287       ,output v-cntxt-level
     4288       ,output v-cntxt-host-code-obj
     4289       ,output v-cntxt-obj-type
     4290       ,output v-cntxt-obj-code
     4291       ,output v-cntxt-db-num-obj
     4292       ,output v-cntxt-is-admin
     4293       ) .
     4294   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4295   define variable g#report-num    as integer      no-undo.
     4296   define variable g#quest-print   as logical      no-undo.
     4297   define variable g#log           as logical      no-undo.
     4298   define variable vss-include-info21 as character format "X(65)" no-undo
     4299   initial "@(#)$Workfile$ $Revision$".
     4300   define stream excel-line.
     4301   define stream excel-cell.
     4302   define temp-table temp_cell-data no-undo
     4303       field data-key as character
     4304       field data-value as character
     4305       index pi is primary unique data-key
     4306   .
     4307   define temp-table temp_line-data no-undo
     4308       field data-key     as character
     4309       field xl-line-id   as integer
     4310       field ID           as integer
     4311       field Name         as character
     4312       field gdscode      as character
     4313       field EI           as character
     4314       field OKEI         as character
     4315       field pack         as character
     4316       field AmountInPl   as character
     4317       field PlaceAmount  as character
     4318       field Mass         as character
     4319       field qnty         as character
     4320       field price        as character
     4321       field SumNoVAT     as character
     4322       field VATpc        as character
     4323       field VATsum       as character
     4324       field sum          as character
     4325       field cntrycode    as character
     4326       field cntryorg     as character
     4327       field numgtd       as character
     4328       index pi is primary unique xl-line-id
     4329   .
     4330   define variable v-torg12xl-current-data-row     as integer      no-undo.
     4331   define variable v-torg12xl-cell-file-name       as character    no-undo.
     4332   define variable v-torg12xl-data-file-name       as character    no-undo.
     4333   procedure torg12xl-init :
     4334       define buffer buf_temp_cell-data        for temp_cell-data.
     4335       define buffer buf_usr-flt               for ubflt.usr-flt.
     4336   do
     4337   for buf_temp_cell-data
     4338     , buf_usr-flt
     4339   on error undo, return error
     4340   :
     4341       assign
     4342           v-torg12xl-current-data-row = 0
     4343       .
     4344       run gbl/_tmpfile.p (
     4345             input "xd"
     4346           , input ".txt"
     4347           , output v-torg12xl-data-file-name
     4348       ).
     4349       output stream excel-line to value( v-torg12xl-data-file-name ).
     4350       run gbl/_tmpfile.p (
     4351             input "xc"
     4352           , input ".txt"
     4353           , output v-torg12xl-cell-file-name
     4354       ).
     4355       output stream excel-cell to value( v-torg12xl-cell-file-name ).
     4356       if printrubl
     4357       then do:
     4358           run torg12xl-write-cell-data in this-procedure (
     4359                 input "valutCode":U
     4360               , input "0":U
     4361           ).
     4362       end.
     4363       else do:
     4364           run torg12xl-write-cell-data in this-procedure (
     4365                 input "valutCode":U
     4366               , input "1":U
     4367           ).
     4368       end.
     4369       if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
     4370       then do:
     4371         run torg12xl-write-cell-data in this-procedure (
     4372               input "columnList":U
     4373             , input "ID,Name,gdscode,EI,OKEI,pack,AmountInPl,PlaceAmount,Mass,qnty,price,SumNoVAT,VATpc,VATsum,sum,cntrycode,cntryorg,numgtd":U
     4374         ).
     4375         run torg12xl-write-cell-data in this-procedure (
     4376               input "columnType":U
     4377             , input "I,S,I,S,S,S,D,D,D,D,C,C,D,C,C,S,S,S":U
     4378         ).
     4379         run torg12xl-write-cell-data in this-procedure (
     4380               input "columnAmount":U
     4381             , input "18":U
     4382         ).
     4383       end.
     4384       else do:
     4385         run torg12xl-write-cell-data in this-procedure (
     4386               input "columnList":U
     4387             , input "ID,Name,gdscode,EI,OKEI,pack,AmountInPl,PlaceAmount,Mass,qnty,price,SumNoVAT,VATpc,VATsum,sum":U
     4388         ).
     4389         run torg12xl-write-cell-data in this-procedure (
     4390               input "columnType":U
     4391             , input "I,S,I,S,S,S,S,S,S,D,C,C,D,C,C":U
     4392         ).
     4393         run torg12xl-write-cell-data in this-procedure (
     4394               input "columnAmount":U
     4395             , input "15":U
     4396         ).
     4397       end.
     4398       run torg12xl-write-cell-data in this-procedure (
     4399             input "subtotalList":U
     4400           , input "qnty,SumNoVAT,VATsum,sum":U
     4401       ).
     4402       run torg12xl-write-cell-data in this-procedure (
     4403             input "subtotalType":U
     4404           , input "S,S,S,S":U
     4405       ).
     4406       run torg12xl-write-cell-data in this-procedure (
     4407             input "subtotalAmount":U
     4408           , input "4":U
     4409       ).
     4410   end.
     4411   end procedure.
     4412   procedure torg12xl-close :
     4413   define input parameter p-mode               as character        no-undo.
     4414   do
     4415   on error undo, return error
     4416   :
     4417       output stream excel-line close.
     4418       output stream excel-cell close.
     4419       output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) append.
     4420           if lookup( "KEDR":U , p-mode ) <> 0 then do:
     4421             export "exe/t12_97Kedr.xlt":U.
     4422           end.
     4423           else do:
     4424             if lookup( "TOPAUKC":U, p-mode ) <> 0
     4425             then do:
     4426               if lookup( "GTD":U, p-mode ) <> 0
     4427               then do:
     4428                 export "exe/t12_97bb.xlt":U.
     4429               end.
     4430               else do:
     4431                 export "exe/t12_97b.xlt":U.
     4432               end.
     4433             end.
     4434             else do:
     4435               export "exe/t12_97.xlt":U.
     4436             end.
     4437           end.
     4438           export "exe/t_97.bas":U.
     4439           export v-torg12xl-cell-file-name.
     4440           export v-torg12xl-data-file-name.
     4441       output close.
     4442   end.
     4443   end procedure.
     4444   procedure torg12xl-write-cell-data :
     4445   define input parameter p-data-key   as character        no-undo.
     4446   define input parameter p-data-value as character        no-undo.
     4447       define buffer buf_temp_cell-data     for temp_cell-data.
     4448   do
     4449   for buf_temp_cell-data
     4450   on error undo, return error
     4451   :
     4452       find first buf_temp_cell-data
     4453            where buf_temp_cell-data.data-key = p-data-key
     4454       no-error.
     4455       if not available buf_temp_cell-data
     4456       then do:
     4457           create buf_temp_cell-data.
     4458           assign
     4459               buf_temp_cell-data.data-key = p-data-key
     4460           .
     4461       end.
     4462       assign
     4463           buf_temp_cell-data.data-value = p-data-value
     4464       .
     4465       put stream excel-cell unformatted
     4466                           buf_temp_cell-data.data-key
     4467           chr(9)   buf_temp_cell-data.data-value
     4468           chr(10)
     4469       .
     4470   end.
     4471   end procedure.
     4472   procedure torg12xl-write-line-data :
