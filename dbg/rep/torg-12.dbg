     4507           buf_temp_line-data.EI           = p-EI
     4508           buf_temp_line-data.OKEI         = p-OKEI
     4509           buf_temp_line-data.pack         = p-pack
     4510           buf_temp_line-data.AmountInPl   = p-AmountInPl
     4511           buf_temp_line-data.PlaceAmount  = p-PlaceAmount
     4512           buf_temp_line-data.Mass         = p-Mass
     4513           buf_temp_line-data.qnty         = p-qnty
     4514           buf_temp_line-data.price        = p-price
     4515           buf_temp_line-data.SumNoVAT     = p-SumNoVAT
     4516           buf_temp_line-data.VATpc        = p-VATpc
     4517           buf_temp_line-data.VATsum       = p-VATsum
     4518           buf_temp_line-data.sum          = p-sum
     4519       .
     4520       put stream excel-line unformatted
     4521                           buf_temp_line-data.data-key
     4522           chr(9)   ( if buf_temp_line-data.id = 0 then "":U else string( buf_temp_line-data.id ) )
     4523           chr(9)   buf_temp_line-data.Name
     4524           chr(9)   buf_temp_line-data.gdscode
     4525           chr(9)   buf_temp_line-data.EI
     4526           chr(9)   buf_temp_line-data.OKEI
     4527           chr(9)   buf_temp_line-data.pack
     4528           chr(9)   buf_temp_line-data.AmountInPl
     4529           chr(9)   buf_temp_line-data.PlaceAmount
     4530           chr(9)   buf_temp_line-data.Mass
     4531           chr(9)   buf_temp_line-data.qnty
     4532           chr(9)   buf_temp_line-data.price
     4533           chr(9)   buf_temp_line-data.SumNoVAT
     4534           chr(9)   buf_temp_line-data.VATpc
     4535           chr(9)   buf_temp_line-data.VATsum
     4536           chr(9)   buf_temp_line-data.sum
     4537           chr(10)
     4538       .
     4539   end.
