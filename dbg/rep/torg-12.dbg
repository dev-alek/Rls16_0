    10540               end.
    10541               if v-torgconf-outt12 = yes
    10542               then do:
    10543                                 if lookup( "TOPAUKC":U, p-mode ) <> 0 and lookup( "GTD":U, p-mode ) <> 0
    10544                 then do:
    10545                   display stream out-stream
    10546                       "Итого" @ ub.goods.gds-name
    10547                       Pg-tqnty @ tqnty
    10548                       Pg-stoim-noNDS @ stoim-noNDS
    10549                       Pg-VAT-gds  @ VAT-gds
    10550                       Pg-stoim @ stoim
    10551                   with frame f-doc-m-bb .
