     5430   define variable vss-include-info30 as character format "X(65)" no-undo
     5431   initial "@(#)$Workfile$ $Revision$".
     5432   define temp-table temp_p-fmt_string-part no-undo
     5433       field str-key       as integer
     5434       field string-part   as character
     5435       index pi is primary unique
     5436           str-key
     5437   .
     5438   define variable v-p-fmt-30-str-key    as integer      no-undo.
     5439   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     5440                                     iInput AS INTEGER).
     5441     def var v-start-print as integer no-undo .
     5442     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     5443     assign
     5444       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     5445     .
     5446     RETURN v-start-print .
     5447   END FUNCTION.
     5448   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     5449                                     iInput AS INTEGER).
     5450     def var v-start-print as integer no-undo .
     5451     assign
     5452       v-start-print = INTEGER(iEndPix - 1 - iInput)
     5453     .
     5454     if v-start-print < 0 then return 0.
     5455     RETURN v-start-print .
     5456   END FUNCTION.
     5457   function p-fmt-align-string returns character (
     5458         p-in-string      as character
     5459       , p-page-width     as integer
     5460       , p-align-type     as character
     5461   ).
     5462       define variable v-string-length     as integer      no-undo.
     5463       define variable v-out-string        as character    no-undo.
     5464       assign
     5465           v-string-length = length( trim( p-in-string ) )
     5466       .
     5467       if v-string-length >= p-page-width
     5468       then do:
     5469           assign
     5470               v-out-string = trim( p-in-string )
     5471           .
     5472       end.
     5473       else do:
     5474           case p-align-type
     5475           :
     5476               when 'left':U
     5477               then do:
     5478                   assign
     5479                       v-out-string = trim( p-in-string )
     5480                   .
     5481               end.
     5482               when 'right':U
     5483               then do:
     5484                   assign
     5485                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     5486                   .
     5487               end.
     5488               when 'center':U
     5489               then do:
     5490                   assign
     5491                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     5492                   .
     5493               end.
     5494           end case.
     5495       end.
     5496       return v-out-string .
     5497   end function.
     5498   procedure p-fmt-split-string :
     5499   define input parameter p-source-string  as character        no-undo.
     5500   define input parameter p-split-length   as integer          no-undo.
     5501   define output parameter p-string-1      as character        no-undo.
     5502   define output parameter p-string-2      as character        no-undo.
     5503   do
     5504   on error undo, return error
     5505   :
     5506       define variable v-space-pos    as integer      no-undo.
     5507       if length( p-source-string ) <= p-split-length
     5508       then do:
     5509           assign
     5510               p-string-1 = p-source-string
     5511           .
     5512       end.
     5513       else do:
     5514           assign
     5515               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     5516           .
     5517           if v-space-pos = 0
     5518           then do:
     5519               assign
     5520                   v-space-pos = index( p-source-string, " ":U )
     5521               .
     5522           end.
     5523           if v-space-pos = 0
     5524           then do:
     5525               assign
     5526                   p-string-1 = substring( p-source-string, 1, p-split-length )
     5527                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     5528               .
     5529           end.
     5530           else do:
     5531               assign
     5532                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     5533                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     5534               .
     5535           end.
     5536       end.
     5537   end.
     5538   end procedure.
     5539   procedure p-fmt-round :
     5540   define input parameter p-qnty               as decimal          no-undo.
     5541   define input parameter p-price-no-VAT       as decimal          no-undo.
     5542   define input parameter p-VAT                as decimal          no-undo.
     5543   define input parameter p-SLT                as decimal          no-undo.
     5544   define input parameter p-road-tax           as decimal          no-undo.
     5545   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     5546   define output parameter p-new-VAT           as decimal          no-undo.
     5547   define output parameter p-new-SLT           as decimal          no-undo.
     5548   define output parameter p-new-sum-VAT       as decimal          no-undo.
     5549   define output parameter p-new-sum-SLT       as decimal          no-undo.
     5550   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     5551   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     5552   define output parameter p-new-sum-full      as decimal          no-undo.
     5553       define variable v-vat-pc    as decimal      no-undo.
     5554       define variable v-slt-pc    as decimal      no-undo.
     5555   do
     5556   on error undo, return error
     5557   :
     5558       if p-price-no-VAT = 0
     5559       then do:
     5560           assign
     5561               p-new-price-no-VAT = 0.0
     5562               p-new-VAT          = ?
     5563               p-new-SLT          = ?
     5564               p-new-sum-VAT      = 0.0
     5565               p-new-sum-SLT      = 0.0
     5566               p-new-sum-no-VAT   = 0.0
     5567               p-new-sum-road-tax = 0.0
     5568               p-new-sum-full     = 0.0
     5569           .
     5570       end.
     5571       else do:
     5572           assign
     5573               v-vat-pc            = p-VAT / p-price-no-VAT
     5574               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     5575               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     5576               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     5577               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     5578               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     5579               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     5580               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     5581               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     5582               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     5583           .
     5584       end.
     5585   end.
     5586   end procedure.
     5587   procedure p-fmt-split :
     5588   define input parameter p-in-string      as character        no-undo.
     5589   define input parameter p-split-length   as integer          no-undo.
     5590       define variable v-start-pos     as integer      no-undo.
     5591       define variable v-end-pos       as integer      no-undo.
     5592       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     5593   do
     5594   for buf_temp_p-fmt_string-part
     5595   on error undo, return error
     5596   :
     5597       empty temp-table buf_temp_p-fmt_string-part.
     5598       if p-split-length < 1
     5599       then do:
     5600           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     5601       end.
     5602       assign
     5603           p-in-string                 = trim( p-in-string )
     5604           v-p-fmt-30-str-key   = 0
     5605           v-start-pos                 = 1
     5606           v-end-pos                   = length( p-in-string )
     5607       .
     5608       run p-fmt-get-string-range in this-procedure (
     5609             input p-in-string
     5610           , input p-split-length
     5611           , input v-start-pos
     5612           , output v-start-pos
     5613           , output v-end-pos
     5614       ).
     5615       do while v-end-pos <> 0
     5616       :
     5617           create buf_temp_p-fmt_string-part.
     5618           assign
     5619               v-p-fmt-30-str-key = v-p-fmt-30-str-key + 1
     5620           .
     5621           assign
     5622               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-30-str-key
     5623               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     5624           .
     5625           assign
     5626               v-start-pos = v-end-pos + 1
     5627           .
     5628           run p-fmt-get-string-range in this-procedure (
     5629                 input p-in-string
     5630               , input p-split-length
     5631               , input v-start-pos
     5632               , output v-start-pos
     5633               , output v-end-pos
     5634           ).
     5635       end.
     5636   end.
     5637   end procedure.
     5638   procedure p-fmt-get-string-range :
     5639   define input parameter p-in-string      as character        no-undo.
     5640   define input parameter p-split-length   as integer          no-undo.
     5641   define input parameter p-old-start-pos  as integer          no-undo.
     5642   define output parameter p-start-pos     as integer          no-undo.
     5643   define output parameter p-end-pos       as integer          no-undo.
     5644       define variable v-init-string    as character    no-undo.
     5645       define variable v-temp-char      as character    no-undo.
     5646       define variable v-temp-pos       as integer      no-undo.
     5647       define variable v-counter        as integer      no-undo.
     5648   do
     5649   on error undo, return error
     5650   :
     5651       assign
     5652           p-start-pos   = p-old-start-pos
     5653           v-init-string = substring( p-in-string, p-start-pos )
     5654       no-error.
     5655       if error-status :error
     5656       or trim( v-init-string ) = "":U
     5657       then do:
     5658           assign
     5659               p-end-pos = 0
     5660           .
     5661           undo, return .
     5662       end.
     5663       assign
     5664           v-temp-char   = substring( v-init-string, 1, 1 )
     5665       .
     5666       do
     5667       while trim( v-temp-char ) = "":U
     5668       :
     5669           assign
     5670               p-start-pos     = p-start-pos + 1
     5671               v-init-string   = substring( p-in-string, p-start-pos )
     5672               v-temp-char     = substring( v-init-string, 1, 1 )
     5673           .
     5674       end.
     5675       assign
     5676           v-temp-pos  = p-split-length
     5677           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5678           v-counter   = 0
     5679       .
     5680       search-word-end:
     5681       do
     5682       while trim( v-temp-char ) <> "":U
     5683       :
     5684           assign
     5685               v-counter   = v-counter + 1
     5686           .
     5687           if v-counter > 20
     5688           then do:
     5689               assign
     5690                   v-temp-pos  = p-split-length
     5691               .
     5692               leave search-word-end.
     5693           end.
     5694           assign
     5695               v-temp-pos  = v-temp-pos - 1
     5696               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     5697           .
     5698       end.
     5699       assign
     5700           p-end-pos = p-start-pos + v-temp-pos - 1
     5701       .
     5702   end.
     5703   end procedure.
     5704   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5705   define variable vss-include-info32 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5706   define variable vss-include-info33 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5707   define variable vss-include-info34 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5708   procedure factord :
     5709     define input  parameter p-fact-date            as date    no-undo .
     5710     define input  parameter p-fact-time            as integer no-undo .
     5711     define input  parameter p-fact-num             as integer no-undo .
     5712     define input  parameter p-shift-date           as date    no-undo .
     5713     define input  parameter p-shift-num            as integer no-undo .
     5714     define input  parameter p-shift-on             as logical no-undo .
     5715     define output parameter p-fact-order           as decimal no-undo .
     5716     define output parameter p-shift-end-fact-order as decimal no-undo .
     5717     define output parameter p-day-end-fact-order   as decimal no-undo .
     5718     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     5719     if p-fact-date = ?
     5720     then do:
     5721       return error "Не указана фактическая дата" .
     5722     end.
     5723     define variable v-fact-date-num as integer no-undo .
     5724     assign
     5725       v-fact-date-num = integer(p-fact-date)
     5726     .
     5727     if p-fact-num = ?
     5728     or p-fact-num = 0
     5729     then do:
     5730       return error "Не задан p-fact-num " + string(p-fact-num) .
     5731     end.
     5732     if p-fact-num < 0
     5733     then do:
     5734       return error "Отрицательный fact-num " + string(p-fact-num) .
     5735     end.
     5736     if p-fact-num >= 100000000
     5737     then do:
     5738       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     5739     end.
     5740     if p-shift-on = true
     5741     then do:
     5742       if p-shift-date = ?
     5743       then do:
     5744         return error "Не задана дата смены" .
     5745       end.
     5746       if p-shift-num = ?
     5747       or p-shift-num = 0
     5748       then do:
     5749         return error "Не задан номер смены" .
     5750       end.
     5751     end.
     5752     else do:
     5753       assign
     5754         p-shift-date = p-fact-date
     5755         p-shift-num  = 24
     5756       .
     5757     end.
     5758     define variable v-shift-offset as integer no-undo .
     5759     if p-shift-date = p-fact-date
     5760     then do:
     5761       assign
     5762         v-shift-offset = 1
     5763       .
     5764     end.
     5765     if p-shift-date < p-fact-date
     5766     then do:
     5767       assign
     5768         v-shift-offset = 0
     5769       .
     5770     end.
     5771     if p-shift-date > p-fact-date
     5772     then do:
     5773       message
     5774         vss-workfile vss-revision vss-description skip
     5775         "Неправильная дата закрытия смены" skip
     5776         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     5777         view-as alert-box error .
     5778       undo, return error
     5779         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     5780           ,string(p-fact-date, '99/99/9999':U)
     5781           ,string(p-shift-date, '99/99/9999':U)
     5782           )
     5783       .
     5784     end.
     5785     if p-shift-num < 1
     5786     or p-shift-num > 24
     5787     then do:
     5788       message
     5789         vss-workfile vss-revision vss-description skip
     5790         "Неправильный номер смены" skip
     5791         "p-shift-num" p-shift-num skip
     5792         view-as alert-box error .
     5793       undo, return error return-value .
     5794     end.
     5795     assign
     5796       p-fact-order           = v-fact-date-num
     5797                              + v-shift-offset * 0.5
     5798                              + p-shift-num    * 0.02 - 0.01
     5799                              + p-fact-num     * 0.0000000001
     5800       p-shift-end-fact-order = v-fact-date-num
     5801                              + v-shift-offset * 0.5
     5802                              + p-shift-num    * 0.02
     5803       p-day-end-fact-order   = v-fact-date-num
     5804                              + 0.99
     5805     .
     5806     if p-fact-order           <= v-fact-date-num
     5807     or p-shift-end-fact-order <= v-fact-date-num
     5808     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     5809     or p-shift-end-fact-order >= p-day-end-fact-order
     5810     then do:
     5811       message
     5812         vss-workfile vss-revision vss-description skip
     5813         "Внутренняя ошибка при генерации фактического номера" skip
     5814         "p-fact-date"            p-fact-date            skip
     5815         "p-fact-time"            p-fact-time            skip
     5816         "p-fact-num"             p-fact-num             skip
     5817         "p-shift-date"           p-shift-date           skip
     5818         "p-shift-num"            p-shift-num            skip
     5819         "p-shift-on"             p-shift-on             skip
     5820         "p-shift-end-fact-order" p-shift-end-fact-order skip
     5821         "p-day-end-fact-order"   p-day-end-fact-order   skip
     5822         "v-fact-date-num"        v-fact-date-num        skip
     5823         view-as alert-box error .
     5824       undo, return error return-value .
     5825     end.
     5826   end procedure.
     5827   procedure day-begin-fact-order :
     5828     define input  parameter p-fact-date            as date    no-undo .
     5829     define output parameter p-day-begin-fact-order as decimal no-undo .
     5830     do
     5831     on error undo, return error return-value
     5832     :
     5833       if p-fact-date = ?
     5834       then do:
     5835         assign
     5836           p-day-begin-fact-order = 0
     5837         .
     5838       end.
     5839       else do:
     5840         assign
     5841           p-day-begin-fact-order = integer(p-fact-date)
     5842         .
     5843       end.
     5844     end.
     5845   end procedure.
     5846   procedure factord-max-fact-order :
     5847     define output parameter p-max-fact-order as decimal   no-undo .
     5848     do
     5849     on error undo, return error return-value
     5850     :
     5851       run day-begin-fact-order in this-procedure
     5852         (input  date(1, 1, 5000)
     5853         ,output p-max-fact-order
     5854         ) .
     5855     end.
     5856   end procedure.
     5857   procedure factord-cut-archive :
     5858     define input  parameter p-obj-type             as character no-undo .
     5859     define input  parameter p-obj-code             as integer   no-undo .
     5860     define input  parameter p-fact-date            as date      no-undo .
     5861     define output parameter p-shift-on             as logical   no-undo .
     5862     define output parameter p-shift-date           as date      no-undo .
     5863     define output parameter p-shift-num            as integer   no-undo .
     5864     define output parameter p-day-end-fact-order   as decimal   no-undo .
     5865     define output parameter p-shift-end-fact-order as decimal   no-undo .
     5866     define variable v-fact-order as decimal   no-undo .
     5867     define buffer buf_shift-obj for ub.shift-obj .
     5868     do
     5869     on error undo, return error return-value
     5870     :
     5871   define variable vss-include-info35 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5873     (input  p-obj-type
     5874     ,input  p-obj-code
     5875     ,input  'shift-on=request'
     5876     ,output p-shift-on
     5877     ) no-error .
     5878       if error-status :error
     5879       then do:
     5880         message
     5881           vss-workfile vss-revision vss-description skip
     5882           "Ошибка при определении атрибута объекта" skip
     5883           "Объект" p-obj-type p-obj-code skip
     5884           error-status :get-message(1) skip
     5885           return-value skip
     5886           view-as alert-box error .
     5887         undo, return error return-value .
     5888       end.
     5889       if p-shift-on = false
     5890       then do:
     5891         assign
     5892           p-shift-date               = ?
     5893           p-shift-num                = 0
     5894         .
     5895       end.
     5896       else do:
     5897         find first buf_shift-obj share-lock
     5898           where buf_shift-obj.obj-type   = p-obj-type
     5899             and buf_shift-obj.obj-code   = p-obj-code
     5900             and buf_shift-obj.shift-date > p-fact-date
     5901           use-index pi
     5902           no-error .
     5903         if not available buf_shift-obj
     5904         or buf_shift-obj.status_ <> 'зкр':U
     5905         then do:
     5906           message
     5907             vss-workfile vss-revision vss-description skip
     5908             "Невозможно вычислить последнюю смену" skip
     5909             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     5910             "Объект" p-obj-type p-obj-code skip
     5911             "Дата" p-fact-date skip
     5912             view-as alert-box error .
     5913           undo, return error return-value .
     5914         end.
     5915         find last buf_shift-obj share-lock
     5916           where buf_shift-obj.obj-type = p-obj-type
     5917             and buf_shift-obj.obj-code = p-obj-code
     5918             and buf_shift-obj.shift-date <= p-fact-date
     5919           use-index pi
     5920           no-error .
     5921         if available buf_shift-obj
     5922         then do:
     5923           if  buf_shift-obj.status_ = 'зкр':U
     5924           then do:
     5925             assign
     5926               p-shift-date = buf_shift-obj.shift-date
     5927               p-shift-num  = buf_shift-obj.shift-num
     5928             .
     5929           end.
     5930           else do:
     5931             message
     5932               vss-workfile vss-revision vss-description skip
     5933               "Невозможно вычислить последнюю смену" skip
     5934               "Статус смены отличен от статуса" 'зкр':U skip
     5935               "Объект" p-obj-type p-obj-code skip
     5936               "Дата" p-fact-date skip
     5937               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     5938               view-as alert-box error .
     5939             undo, return error return-value .
     5940           end.
     5941         end.
     5942         else do:
     5943           assign
     5944             p-shift-date = p-fact-date - 1
     5945             p-shift-num  = 1
     5946           .
     5947         end.
     5948       end.
     5949       run factord in this-procedure
     5950         (input  p-fact-date
     5951         ,input  1
     5952         ,input  1
     5953         ,input  p-shift-date
     5954         ,input  p-shift-num
     5955         ,input  p-shift-on
     5956         ,output v-fact-order
     5957         ,output p-shift-end-fact-order
     5958         ,output p-day-end-fact-order
     5959         ) no-error .
     5960       if error-status :error
     5961       then do:
     5962         message
     5963           vss-workfile vss-revision vss-description skip
     5964           "Ошибка при вызове процедуры factord"
     5965           error-status :get-message(1) skip
     5966           return-value skip
     5967           view-as alert-box error .
     5968         undo, return error return-value .
     5969       end.
     5970     end.
     5971   end procedure.
     5972   procedure factord-lock-shift :
     5973     define input  parameter p-obj-type  as character no-undo .
     5974     define input  parameter p-obj-code  as integer   no-undo .
     5975     define input  parameter p-fact-date as date      no-undo .
     5976     define parameter buffer buf_shift-obj for ub.shift-obj .
     5977     define variable v-shift-on      as logical   no-undo .
     5978     define variable v-extra-message as character no-undo .
     5979     define variable v-error as character no-undo .
     5980     do
     5981     on error undo, return error return-value
     5982     :
     5983   define variable vss-include-info36 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     5984   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     5985     (input  p-obj-type
     5986     ,input  p-obj-code
     5987     ,input  'shift-on=request'
     5988     ,output v-shift-on
     5989     ) no-error .
     5990       if error-status :error
     5991       then do:
     5992         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     5993         undo, return error v-error .
     5994       end.
     5995       if v-shift-on = true
     5996       then do:
     5997         find first buf_shift-obj share-lock
     5998           where buf_shift-obj.obj-type   = p-obj-type
     5999             and buf_shift-obj.obj-code   = p-obj-code
     6000             and buf_shift-obj.shift-date > p-fact-date
     6001           use-index pi
     6002           no-error .
     6003         if not available buf_shift-obj
     6004         or buf_shift-obj.status_ <> 'зкр':U
     6005         then do:
     6006           find last buf_shift-obj
     6007             where buf_shift-obj.obj-type = p-obj-type
     6008               and buf_shift-obj.obj-code = p-obj-code
     6009               and buf_shift-obj.status_  = 'зкр':U
     6010             use-index stts
     6011             no-error .
     6012           if available buf_shift-obj
     6013           then do:
     6014             assign
     6015               v-extra-message =
     6016                     substitute("Дата начала последеней закрытой смены на объекте &1"
     6017                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     6018                               )
     6019             .
     6020           end.
     6021           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     6022           undo, return error v-error .
     6023         end.
     6024       end.
     6025     end.
     6026   end procedure.
     6027   procedure factord-end-day :
     6028     define input  parameter p-fact-date            as date    no-undo .
     6029     define output parameter p-day-end-fact-order   as decimal no-undo .
     6030     do
     6031     on error undo, return error return-value
     6032     :
     6033       if p-fact-date = ?
     6034       then do:
     6035         return error "Не указана фактическая дата" .
     6036       end.
     6037       assign
     6038         p-day-end-fact-order = integer(p-fact-date) + 0.99
     6039       .
     6040     end.
     6041   end procedure.
     6042   procedure factord-to-date :
     6043     define input  parameter p-fact-order as decimal no-undo .
     6044     define output parameter p-fact-date  as date    no-undo .
     6045     define variable v-ref-date  as date      no-undo .
     6046     define variable v-ref-delta as integer   no-undo .
     6047     do
     6048     on error undo, return error return-value
     6049     :
     6050       if p-fact-order = ?
     6051       or p-fact-order = 0
     6052       then do:
     6053         return error "Не указан fact-order" .
     6054       end.
     6055       assign
     6056         v-ref-date  = date(1, 1, 2000)
     6057       .
     6058       assign
     6059         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     6060       .
     6061       assign
     6062         p-fact-date = v-ref-date + v-ref-delta
     6063       .
     6064     end.
     6065   end procedure.
     6066   procedure factord-to-fact-num :
     6067     define input  parameter p-fact-order as decimal no-undo .
     6068     define output parameter p-fact-num   as integer no-undo .
     6069     define variable v-fact-order-trunc as decimal no-undo .
     6070     do
     6071     on error undo, return error return-value
     6072     :
     6073       if p-fact-order = ?
     6074       or p-fact-order = 0
     6075       then do:
     6076         return error "Не указан fact-order" .
     6077       end.
     6078       assign
     6079        v-fact-order-trunc = truncate(p-fact-order, 2)
     6080       .
     6081       assign
     6082         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     6083       .
     6084     end.
     6085   end procedure.
     6086   procedure factord-to-shift-num :
     6087     define input  parameter p-fact-order as decimal no-undo .
     6088     define output parameter p-shift-num   as integer no-undo .
     6089     define variable  p-shift-numd  as decimal   no-undo .
     6090     define variable v-fact-order-trunc as decimal no-undo .
     6091     do
     6092     on error undo, return error return-value
     6093     :
     6094       if p-fact-order = ?
     6095       or p-fact-order = 0
     6096       then do:
     6097         return error "Не указан fact-order" .
     6098       end.
     6099       assign
     6100        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     6101       .
     6102       if v-fact-order-trunc < 0.5 then do:
     6103         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     6104       end.
     6105       assign
     6106         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     6107         .
     6108        assign
     6109         p-shift-num = truncate (p-shift-numd , 0)
     6110       .
     6111     end.
     6112   end procedure.
     6113   procedure fact-order-mpl :
     6114     do
     6115     on error undo, return error return-value
     6116     :
     6117   define input  parameter p-doc-date as date     no-undo .
     6118   define input  parameter p-obj-type as character no-undo .
     6119   define input  parameter p-obj-code as integer   no-undo .
     6120   define output parameter p-fact-order as decimal   no-undo .
     6121   define variable v-fact-date            as date    no-undo .
     6122   define variable v-fact-time            as integer no-undo .
     6123   define variable v-fact-order           as decimal no-undo .
     6124   define variable v-shift-end-fact-order as decimal no-undo .
     6125   define variable v-day-end-fact-order   as decimal no-undo .
     6126   define variable l-shift-on as logical no-undo .
     6127   define variable l-date as date      no-undo .
     6128   define variable l-time as integer   no-undo .
     6129   define variable shift-date as date      no-undo .
     6130   define variable shift-num  as integer   no-undo .
     6131   define variable shift-name as character no-undo .
     6132   define variable max-fact-order as decimal   no-undo .
     6133   define buffer buf_global-state for ub.global-state  .
     6134   find first buf_global-state no-lock no-error .
     6135   if not available buf_global-state then do:
     6136      message
     6137        "Не заданы параметры ценообразования!"
     6138        view-as alert-box error
     6139      .
     6140      return error return-value .
     6141   end.
     6142     run cur-time in this-procedure
     6143     ( output v-fact-date ,
     6144       output v-fact-time  ).
     6145   if p-doc-date = ? then do:
     6146   if buf_global-state.pl-use-sys-date-time  = true then do:
     6147         run factord in this-procedure
     6148           (input  v-fact-date
     6149           ,input  v-fact-time
     6150           ,input  v-fact-time
     6151           ,input  ?
     6152           ,input  ?
     6153           ,input  false
     6154           ,output v-fact-order
     6155           ,output v-shift-end-fact-order
     6156           ,output v-day-end-fact-order
     6157           ) no-error .
     6158         if error-status :error
     6159         or v-fact-order = ?
     6160         or v-fact-order = 0 then do:
     6161           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6162         end.
     6163         p-fact-order = v-fact-order .
     6164   end.
     6165   else do:
     6166   define variable vss-include-info37 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6167   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     6168     (input  p-obj-type
     6169     ,input  p-obj-code
     6170     ,input  'shift-on=request'
     6171     ,output l-shift-on
     6172     ) no-error .
     6173         if error-status :error then return error "Неопределена дата на объекте " + return-value .
     6174         if p-doc-date <> ? then do:
     6175         end.
     6176          run gbl/factdate.p
     6177          ( input        p-obj-type  ,
     6178            input        p-obj-code  ,
     6179            input-output v-fact-date ,
     6180            input-output v-fact-time ,
     6181            input-output shift-date      ,
     6182            input-output shift-num       ,
     6183            input-output shift-name      ,
     6184            input        yes
     6185            ) no-error .
     6186         if error-status :error then return error substitute(" Ошибка из factdate.p: &1 &2"  , return-value , error-status :get-message(1)   ) .
     6187         run factord in this-procedure
     6188           (input  v-fact-date
     6189           ,input  v-fact-time
     6190           ,input  v-fact-time
     6191           ,input  shift-date
     6192           ,input  shift-num
     6193           ,input  l-shift-on
     6194           ,output v-fact-order
     6195           ,output v-shift-end-fact-order
     6196           ,output v-day-end-fact-order
     6197           ) no-error .
     6198         if error-status :error
     6199         or v-fact-order = ?
     6200         or v-fact-order = 0 then do:
     6201           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6202         end.
     6203         p-fact-order = v-fact-order .
     6204   end.
     6205   end.
     6206   else do:
     6207          run gbl/factdate.p
     6208          ( input        p-obj-type  ,
     6209            input        p-obj-code  ,
     6210            input-output v-fact-date ,
     6211            input-output v-fact-time ,
     6212            input-output shift-date      ,
     6213            input-output shift-num       ,
     6214            input-output shift-name      ,
     6215            input        yes
     6216            ) no-error .
     6217         if error-status :error then return error "Ошибка factdate.p " + return-value .
     6218         v-fact-date = p-doc-date .
     6219         run factord in this-procedure
     6220           (input  v-fact-date
     6221           ,input  v-fact-time
     6222           ,input  v-fact-time
     6223           ,input  shift-date
     6224           ,input  shift-num
     6225           ,input  l-shift-on
     6226           ,output v-fact-order
     6227           ,output v-shift-end-fact-order
     6228           ,output v-day-end-fact-order
     6229           ) no-error .
     6230         if error-status :error
     6231         or v-fact-order = ?
     6232         or v-fact-order = 0 then do:
     6233           undo, return error "Не определен факт-ордер " + return-value + error-status :get-message(1) .
     6234         end.
     6235         p-fact-order = v-fact-order .
     6236   end.
     6237     end.
     6238   end procedure.
     6239   DEFINE TEMP-TABLE tt_price-all NO-UNDO LIKE ub.price-all
     6240   field sale-qnty as decimal
     6241   field sale-sum  as decimal
     6242   field sale-tnv  as decimal
     6243   field price-sale-base as decimal
     6244   field price-sale-rubl as decimal
     6245   field road-tax-base   as decimal
     6246   field road-tax-rubl   as decimal
     6247   field excise-base as decimal
     6248   field excise-rubl as decimal
     6249   field date-1 as date
     6250   field date-2 as date
     6251   field shift-1 as int
     6252   field shift-2 as int
     6253   field time-1 as int
     6254   field time-2 as int
     6255   field grp-name as char
     6256   field interv-name as char
     6257   field pay-name as char
     6258   field unit-cli as char
     6259   index pi
     6260   plt-priority DESCENDING
     6261   fact-order DESCENDING
     6262   qnty-from asc
     6263   sum-from asc
     6264   turnover-from asc
     6265   date-1 DESCENDING
     6266   time-1 DESCENDING
     6267   date-2 DESCENDING
     6268   time-2 DESCENDING
     6269   type-price DESCENDING
     6270   .
     6271   procedure mpl-autoprice :
     6272   define input  parameter p-only-b-code as logical   no-undo .
     6273   define input  parameter p-cli-type    as character no-undo .
     6274   define input  parameter p-cli-code    as integer   no-undo .
     6275   define input  parameter p-main-b-code as integer   no-undo .
     6276   define input  parameter p-b-code      as integer   no-undo .
     6277   define input  parameter p-obj-type    as character no-undo .
     6278   define input  parameter p-obj-code    as integer   no-undo .
     6279   define input  parameter p-qnty-doc    as decimal   no-undo .
     6280   define input  parameter p-sum-doc     as decimal   no-undo .
     6281   define input  parameter p-vid-pay        as character no-undo .
     6282   define input  parameter p-cash-pay-type  as character no-undo .
     6283   define input  parameter p-fact-order  as decimal   no-undo .
     6284   define output parameter p-plt-id          as integer   no-undo .
     6285   define output parameter p-plt-db-num      as integer   no-undo .
     6286   define output parameter p-pdf-id          as integer   no-undo .
     6287   define output parameter p-pdf-db-num      as integer   no-undo .
     6288   define output parameter p-sale-price-base as decimal   no-undo .
     6289   define output parameter p-sale-price-rubl as decimal   no-undo .
     6290   define output parameter p-road-tax-base as decimal   no-undo .
     6291   define output parameter p-road-tax-rubl as decimal   no-undo .
     6292   define output parameter p-excise-base   as decimal   no-undo .
     6293   define output parameter p-excise-rubl   as decimal   no-undo .
     6294   define variable v-cli-oborot-ALL as decimal   no-undo .
     6295   define buffer buf_buyer-in-buyer-group   for ub.buyer-in-buyer-group  .
     6296   define buffer buf_turnover-buyer-main    for ub.turnover-buyer-main  .
     6297   define buffer buf1_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6298   define buffer buf2_tnv-in-turnover-group for ub.tnv-in-turnover-group  .
     6299   define buffer buf_price-all              for ub.price-all  .
     6300   define buffer buf_goods                  for ub.goods      .
     6301   define buffer buf_global-state           for ub.global-state  .
     6302   define buffer buf_buyer-group            for ub.buyer-group  .
     6303   define buffer buf_turnover-group         for ub.turnover-group  .
     6304   define buffer buf_main-code              for ub.bar-code  .
     6305   define buffer buf_bar-code               for ub.bar-code  .
     6306   define buffer buf_pay-type               for ub.pay-type  .
     6307   define buffer buf_cash-pay               for ub.cash-pay  .
     6308   define variable to-day          as date      no-undo .
     6309   define variable v-base-rate0    as decimal   no-undo .
     6310   define variable v-base-scale0   as decimal   no-undo .
     6311   define variable v-exch-rate0    as decimal   no-undo .
     6312   define variable v-exch-scale0   as decimal   no-undo .
     6313   define variable v-base-rate     as decimal   no-undo .
     6314   define variable v-base-scale    as decimal   no-undo .
     6315   define variable v-exch-rate     as decimal   no-undo .
     6316   define variable v-exch-scale    as decimal   no-undo .
     6317   define variable v-host-code     as integer   no-undo .
     6318   define variable v-curr-abbr     as character no-undo .
     6319   define variable v-grp-name      as character no-undo .
     6320   define variable v-date-1        as date      no-undo .
     6321   define variable v-date-2        as date      no-undo .
     6322   define variable v-interv        as character no-undo .
     6323   define variable v-pay-name      as character no-undo .
     6324   define variable v-cli-oborot    as decimal   no-undo .
     6325   define variable v-trn-pay-code  as integer   no-undo .
     6326   define variable v-cash-pay-curr as integer   no-undo .
     6327   define variable v-cash-pay-code as integer   no-undo .
     6328   do
     6329   on error undo, return error return-value
     6330   :
     6331   find first buf_main-code no-lock where buf_main-code.b-code = p-main-b-code .
     6332   find first buf_goods no-lock where buf_goods.gds-code = buf_main-code.gds-code.
     6333   if p-fact-order = ? then do:
     6334     run fact-order-mpl (
     6335         input   today       ,
     6336         input   p-obj-type  ,
     6337         input   p-obj-code  ,
     6338         output  p-fact-order ).
     6339   end.
     6340   if p-vid-pay <> "" then do:
     6341      find first buf_pay-type no-lock where  buf_pay-type.obj-code = integer(p-vid-pay) no-error .
     6342      if available buf_pay-type
     6343         then v-trn-pay-code = buf_pay-type.obj-code.
     6344         else v-trn-pay-code =  0.
     6345   end.
     6346   else v-trn-pay-code = 0 .
     6347   if p-cash-pay-type <> "" then do:
     6348      find first buf_cash-pay no-lock where  recid(buf_cash-pay) = integer(p-cash-pay-type) no-error .
     6349      if available buf_pay-type
     6350         then
     6351           assign
     6352             v-cash-pay-curr = buf_cash-pay.curr-code
     6353             v-cash-pay-code = buf_cash-pay.cdpay-code
     6354           .
     6355         else
     6356           assign
     6357             v-cash-pay-curr = 0
     6358             v-cash-pay-code = 0
     6359             .
     6360   end.
     6361   else
     6362     assign
     6363       v-cash-pay-curr = 0
     6364       v-cash-pay-code = 0
     6365       .
     6366   for each tt_price-all  : delete tt_price-all . end.
     6367   assign
     6368     p-plt-id             = ?
     6369     p-plt-db-num         = ?
     6370     p-pdf-id             = ?
     6371     p-pdf-db-num         = ?
     6372     p-sale-price-base    = ?
     6373     p-sale-price-rubl    = ?
     6374     v-cli-oborot         = 0
     6375   .
     6376   find first buf_global-state no-lock no-error .
     6377   if not available buf_global-state then do:
     6378      message
     6379        "Не заданы параметры ценообразования!"
     6380        view-as alert-box error
     6381      .
     6382      return error return-value .
     6383   end.
     6384   define variable vss-include-info38 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6385   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curobjdt in g#library
     6386     (input  p-obj-type
     6387     ,input  p-obj-code
     6388     ,output to-day
     6389     )  .
     6390   define variable vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6391   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     6392     (input  p-obj-type
     6393     ,input  p-obj-code
     6394     ,output v-host-code
     6395     )  .
     6396   define variable vss-include-info40 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6397   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run baserate in g#library
     6398     (input  v-host-code
     6399     ,input  to-day
     6400     ,output v-base-rate0
     6401     ,output v-base-scale0
     6402     )  .
     6403     v-cli-oborot-ALL  = 0 .
     6404     for each buf_turnover-buyer-main no-lock  where
     6405              buf_turnover-buyer-main.cli-type = p-cli-type  and
     6406              buf_turnover-buyer-main.cli-code = p-cli-code
     6407              :
     6408              v-cli-oborot-ALL = v-cli-oborot-ALL + buf_turnover-buyer-main.sum-doc-rubl-itog .
     6409     end.
     6410   for each buf_price-all no-lock where
     6411            buf_price-all.obj-type = p-obj-type and
     6412            buf_price-all.obj-code = p-obj-code and
     6413            buf_price-all.gds-code = buf_goods.gds-code and
     6414            buf_price-all.status_  = 'акт':U  and
     6415          ( p-only-b-code = false   or
     6416          ( buf_price-all.b-code = p-main-b-code or
     6417            buf_price-all.b-code = p-b-code))    and
     6418           ( p-only-b-code = true  or
     6419             buf_price-all.b-code = p-b-code)
     6420             and
     6421             buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6422           ( buf_price-all.fact-order-sys-to = ? or
     6423             buf_price-all.fact-order-sys-to    >= p-fact-order)
     6424           :
     6425            v-interv   = "" .
     6426            v-grp-name = "" .
     6427            v-pay-name = "" .
     6428            if buf_price-all.fact-order = 0  and buf_price-all.plt-priority = 0  then next.
     6429            if buf_price-all.bgr-id > 0 then do:
     6430               find first buf_buyer-group no-lock where
     6431                          buf_buyer-group.bgr-id     = buf_price-all.bgr-id  and
     6432                          buf_buyer-group.bgr-db-num = buf_price-all.bgr-db-num  no-error .
     6433               if available buf_buyer-group then do:
     6434                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6435                  find first buf_buyer-in-buyer-group no-lock where
     6436                             buf_buyer-in-buyer-group.stts         = 0 and
     6437                             buf_buyer-in-buyer-group.bgr-id       = buf_buyer-group.bgr-id     and
     6438                             buf_buyer-in-buyer-group.bgr-db-num   = buf_buyer-group.bgr-db-num  and
     6439                             buf_buyer-in-buyer-group.bbg-obj-type = p-cli-type and
     6440                             buf_buyer-in-buyer-group.bbg-obj-code = p-cli-code
     6441                             no-error .
     6442                             if not available buf_buyer-in-buyer-group then do:
     6443                                v-grp-name = "".
     6444                                next.
     6445                             end.
     6446                             v-grp-name = buf_buyer-group.name .
     6447                  end.
     6448               end.
     6449               else do:
     6450                    v-grp-name = "".
     6451                    next.
     6452               end.
     6453            end.
     6454            if buf_price-all.tog-id > 0 then do:
     6455               find first buf_turnover-group no-lock where
     6456                          buf_turnover-group.tog-id     = buf_price-all.tog-id      and
     6457                          buf_turnover-group.tog-db-num = buf_price-all.tog-db-num  no-error .
     6458               if available buf_turnover-group then do:
     6459                  if p-cli-type <> "" and p-cli-type <> ? then do:
     6460                     v-cli-oborot = v-cli-oborot-all  .
     6461                     find first buf1_tnv-in-turnover-group no-lock where
     6462                                buf1_tnv-in-turnover-group.stts       =  0     and
     6463                                buf1_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6464                                buf1_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6465                                buf1_tnv-in-turnover-group.ttg-summa  <=  v-cli-oborot no-error .
     6466                     find first buf2_tnv-in-turnover-group no-lock where
     6467                                buf2_tnv-in-turnover-group.stts       =  0     and
     6468                                buf2_tnv-in-turnover-group.tog-id     =  buf_turnover-group.tog-id     and
     6469                                buf2_tnv-in-turnover-group.tog-db-num =  buf_turnover-group.tog-db-num and
     6470                                buf2_tnv-in-turnover-group.ttg-summa  >=  v-cli-oborot no-error .
     6471                     if not (available buf1_tnv-in-turnover-group and
     6472                             available buf2_tnv-in-turnover-group ) then do:
     6473                             v-grp-name = "".
     6474                             next .
     6475                     end.
     6476                     v-grp-name = buf_turnover-group.name.
     6477                  end.
     6478               end.
     6479               else do:
     6480                    v-grp-name = "".
     6481                    next.
     6482               end.
     6483            end.
     6484            if buf_price-all.plt-fix-cource-crc-base = true then
     6485               assign
     6486                 v-base-rate  = buf_price-all.pdf-base-rate
     6487                 v-base-scale = buf_price-all.pdf-base-scale
     6488               .
     6489               else
     6490               assign
     6491                 v-base-rate  = v-base-rate0
     6492                 v-base-scale = v-base-scale0
     6493               .
     6494            if buf_price-all.plt-fix-cource-crc-doc = true then
     6495               assign
     6496                 v-exch-rate  = buf_price-all.pdf-exch-rate
     6497                 v-exch-scale = buf_price-all.pdf-exch-scale
     6498               .
     6499               else do:
     6500   define variable vss-include-info41 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6501   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     6502     (input  buf_price-all.curr-code
     6503     ,input  to-day
     6504     ,output v-exch-rate0
     6505     ,output v-exch-scale0
     6506     ,output v-curr-abbr
     6507     )  .
     6508               assign
     6509                 v-exch-rate  = v-exch-rate0
     6510                 v-exch-scale = v-exch-scale0
     6511                 .
     6512              end.
     6513              v-date-1 = date ( "" )  .
     6514              if buf_price-all.fact-order-sys-from > 0 then do:
     6515                 if buf_price-all.start-sys-date <> ?   then  v-date-1 = buf_price-all.start-sys-date.
     6516                 if buf_price-all.start-shift-date <> ? then  v-date-1 = buf_price-all.start-shift-date.
     6517                 if buf_price-all.start-date <> ?       then  v-date-1 = buf_price-all.start-date.
     6518              end.
     6519              v-date-2 =  date ( "" )  .
     6520              if buf_price-all.fact-order-sys-to > 0 then do:
     6521                 if buf_price-all.end-sys-date <> ?     then  v-date-2 = buf_price-all.end-sys-date.
     6522                 if buf_price-all.end-shift-date <> ?   then  v-date-2 = buf_price-all.end-shift-date.
     6523                 if buf_price-all.end-date <> ?         then  v-date-2 = buf_price-all.end-date.
     6524              end.
     6525              if buf_price-all.qnty-from <> ? then do :
     6526                 if not (
     6527                 ( p-qnty-doc  >= buf_price-all.qnty-from and buf_price-all.qnty-to = ? ) or
     6528                 ( p-qnty-doc  >= buf_price-all.qnty-from and p-qnty-doc <= buf_price-all.qnty-to and buf_price-all.qnty-to <> ?)
     6529                 ) then do:
     6530                        v-interv = "".
     6531                        next.
     6532                 end.
     6533                 v-interv = "К: " + string(buf_price-all.qnty-from) + " - " + ( if buf_price-all.qnty-to = ? then "и более" else string(buf_price-all.qnty-to)) .
     6534              end.
     6535              if buf_price-all.sum-from <> ? then do :
     6536                 if not (
     6537                 ( p-sum-doc  >= buf_price-all.sum-from and buf_price-all.sum-to = ? ) or
     6538                 ( p-sum-doc  >= buf_price-all.sum-from and p-sum-doc <= buf_price-all.sum-to and buf_price-all.sum-to <> ?)
     6539                 ) then do:
     6540                    v-interv = "".
     6541                    next.
     6542                 end.
     6543                 v-interv = "C: " +  string(buf_price-all.sum-from) + " - " + ( if buf_price-all.sum-to = ? then "и более" else string(buf_price-all.sum-to)) .
     6544              end.
     6545              if buf_price-all.turnover-from <> ? then do :
     6546                 if not (
     6547                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and buf_price-all.turnover-to = ? ) or
     6548                 ( v-cli-oborot-ALL  >= buf_price-all.turnover-from and v-cli-oborot-ALL <= buf_price-all.turnover-to and buf_price-all.turnover-to <> ?)
     6549                 ) then do:
     6550                    v-interv = "".
     6551                    next.
     6552                 end.
     6553                 v-interv = "O: " +  string(buf_price-all.turnover-from) + " - " + ( if buf_price-all.turnover-to = ? then "и более" else string(buf_price-all.turnover-to)) .
     6554              end.
     6555              if buf_price-all.use-pay-type = 1 then do :
     6556                 if buf_price-all.pay-code <> v-trn-pay-code then do:
     6557                    v-pay-name = "" .
     6558                    next.
     6559                  end.
     6560                  v-pay-name = 'Оплата':U +  ":" + string(buf_price-all.pay-code) .
     6561              end.
     6562              if buf_price-all.use-cash-pay = 1 then do :
     6563                 if v-cash-pay-code <> 0 and  not ( buf_price-all.curr-pay-code = v-cash-pay-curr and
     6564                                                    buf_price-all.cdpay-code    = v-cash-pay-code ) then do:
     6565                   v-pay-name = "" .
     6566                   next.
     6567                 end.
     6568                 v-pay-name = 'Касс.платеж':U + ":" + string(buf_price-all.cdpay-code) + "_" + string(buf_price-all.curr-pay-code).
     6569              end.
     6570             find first buf_bar-code no-lock where buf_bar-code.b-code = buf_price-all.b-code no-error .
     6571             create tt_price-all .
     6572             buffer-copy buf_price-all to tt_price-all
     6573             assign
     6574               tt_price-all.price-sale-rubl = buf_price-all.price-sale  * v-exch-rate / v-exch-scale
     6575               tt_price-all.road-tax-rubl   = buf_price-all.road-tax    * v-exch-rate / v-exch-scale
     6576               tt_price-all.excise-rubl     = buf_price-all.excise      * v-exch-rate / v-exch-scale
     6577               tt_price-all.price-sale-base = tt_price-all.price-sale-rubl  / v-base-rate * v-base-scale
     6578               tt_price-all.road-tax-base   = tt_price-all.road-tax-rubl    / v-base-rate * v-base-scale
     6579               tt_price-all.excise-base     = tt_price-all.excise-rubl      / v-base-rate * v-base-scale
     6580               tt_price-all.price-sale     = buf_price-all.price-sale
     6581               tt_price-all.road-tax       = buf_price-all.road-tax
     6582               tt_price-all.excise         = buf_price-all.excise
     6583               tt_price-all.pdf-exch-rate   = v-exch-rate
     6584               tt_price-all.pdf-exch-scale  = v-exch-scale
     6585               tt_price-all.pdf-base-rate   = v-base-rate
     6586               tt_price-all.pdf-base-scale  = v-base-scale
     6587               tt_price-all.grp-name        = v-grp-name
     6588               tt_price-all.date-1          = v-date-1
     6589               tt_price-all.shift-1         = buf_price-all.start-shift-num
     6590               tt_price-all.time-1          = buf_price-all.start-sys-time
     6591               tt_price-all.date-2          = v-date-2
     6592               tt_price-all.shift-2         = buf_price-all.end-shift-num
     6593               tt_price-all.time-2          = buf_price-all.end-sys-time
     6594               tt_price-all.interv-name     = v-interv
     6595               tt_price-all.pay-name        = v-pay-name
     6596               tt_price-all.unit-cli        = buf_bar-code.unit-cli
     6597             .
     6598   end.
     6599   define variable vt-plt-id as integer   no-undo .
     6600   define variable vt-plt-db as integer   no-undo .
     6601   define variable vt-pdf-id as integer   no-undo .
     6602   define variable vt-pdf-db as integer   no-undo .
     6603   define buffer neos_price-all for tt_price-all  .
     6604   find first tt_price-all where tt_price-all.b-code = p-main-b-code use-index pi no-error .
     6605       if available tt_price-all then do:
     6606        assign
     6607          vt-plt-id = tt_price-all.plt-id
     6608          vt-plt-db = tt_price-all.plt-db-num
     6609          vt-pdf-id = tt_price-all.pdf-id
     6610          vt-pdf-db = tt_price-all.pdf-db
     6611        .
     6612        if tt_price-all.b-code = p-b-code then do:
     6613             assign
     6614               p-plt-id           = tt_price-all.plt-id
     6615               p-plt-db-num       = tt_price-all.plt-db-num
     6616               p-pdf-id           = tt_price-all.pdf-id
     6617               p-pdf-db-num       = tt_price-all.pdf-db
     6618               p-sale-price-base  = tt_price-all.price-sale-base
     6619               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6620               p-road-tax-base    = tt_price-all.road-tax-base
     6621               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6622               p-excise-base      = tt_price-all.excise-base
     6623               p-excise-rubl      = tt_price-all.excise-rubl
     6624               .
     6625        end.
     6626        else do:
     6627          find first neos_price-all where
     6628                     neos_price-all.b-code     = p-b-code  and
     6629                     neos_price-all.plt-id     = vt-plt-id and
     6630                     neos_price-all.plt-db-num = vt-plt-db and
     6631                     neos_price-all.pdf-id     = vt-pdf-id and
     6632                     neos_price-all.pdf-db     = vt-pdf-db
     6633                     use-index pi no-error .
     6634            if available neos_price-all then do:
     6635             assign
     6636               p-plt-id           = tt_price-all.plt-id
     6637               p-plt-db-num       = tt_price-all.plt-db-num
     6638               p-pdf-id           = tt_price-all.pdf-id
     6639               p-pdf-db-num       = tt_price-all.pdf-db
     6640               p-sale-price-base  = neos_price-all.price-sale-base
     6641               p-sale-price-rubl  = neos_price-all.price-sale-rubl
     6642               p-road-tax-base    = neos_price-all.road-tax-base
     6643               p-road-tax-rubl    = neos_price-all.road-tax-rubl
     6644               p-excise-base      = neos_price-all.excise-base
     6645               p-excise-rubl      = neos_price-all.excise-rubl
     6646               .
     6647            end.
     6648            else do:
     6649                 find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6650                 if error-status :error    then do:
     6651                   message "Не найден бар-код" p-b-code view-as alert-box error .
     6652                   return error return-value .
     6653                 end.
     6654             assign
     6655               p-plt-id           = tt_price-all.plt-id
     6656               p-plt-db-num       = tt_price-all.plt-db-num
     6657               p-pdf-id           = tt_price-all.pdf-id
     6658               p-pdf-db-num       = tt_price-all.pdf-db
     6659               p-sale-price-base  = tt_price-all.price-sale-base
     6660               p-sale-price-rubl  = tt_price-all.price-sale-rubl
     6661               p-road-tax-base    = tt_price-all.road-tax-base
     6662               p-road-tax-rubl    = tt_price-all.road-tax-rubl
     6663               p-excise-base      = tt_price-all.excise-base
     6664               p-excise-rubl      = tt_price-all.excise-rubl * buf_bar-code.cli-base-rate
     6665               .
     6666            end.
     6667        end.
     6668     end.
     6669   end.
     6670   end procedure.
     6671   procedure mpl-tpl-auto :
     6672   define input  parameter p-b-code     as integer   no-undo .
     6673   define input  parameter p-obj-type   as character no-undo .
     6674   define input  parameter p-obj-code   as integer   no-undo .
     6675   define input  parameter p-plt-id     as integer   no-undo .
     6676   define input  parameter p-plt-db-num as integer   no-undo .
     6677   define input  parameter p-fact-order as decimal   no-undo .
     6678   define output parameter p-sale-price as decimal   no-undo .
     6679   define output parameter p-pdf-id     as integer   no-undo .
     6680   define output parameter p-pdf-db-num as integer   no-undo .
     6681     do
     6682     on error undo, return error return-value
     6683     :
     6684   if p-fact-order = ? then do:
     6685     run fact-order-mpl (
     6686         input   today       ,
     6687         input   p-obj-type  ,
     6688         input   p-obj-code  ,
     6689         output  p-fact-order ) .
     6690   end.
     6691   assign
     6692     p-pdf-id      = ?
     6693     p-pdf-db-num  = ?
     6694     p-sale-price  = ?
     6695   .
     6696   define buffer buf_bar-code for ub.bar-code  .
     6697   define buffer buf_goods for ub.goods  .
     6698   find first buf_bar-code no-lock where
     6699              buf_bar-code.b-code = p-b-code
     6700              no-error .
     6701   if error-status :error then return error return-value .
     6702   find first buf_goods no-lock where
     6703              buf_goods.gds-code = buf_bar-code.gds-code
     6704              no-error .
     6705   if error-status :error then return error return-value .
     6706   define variable v-main-b-code as integer   no-undo .
     6707   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6708     (input  buf_goods.gds-code
     6709     ,input  ?
     6710     ,output v-main-b-code
     6711     )  .
     6712   define buffer buf_price-all for ub.price-all  .
     6713   for each tt_price-all : delete tt_price-all. end.
     6714       for each buf_price-all no-lock where
     6715               buf_price-all.plt-id     = p-plt-id                 and
     6716               buf_price-all.plt-db-num = p-plt-db-num             and
     6717               buf_price-all.obj-type   = p-obj-type               and
     6718               buf_price-all.obj-code   = p-obj-code               and
     6719               buf_price-all.gds-code   = buf_goods.gds-code       and
     6720             ( buf_price-all.b-code = v-main-b-code or
     6721               buf_price-all.b-code = p-b-code)    and
     6722               buf_price-all.status_    = 'акт':U         and
     6723               buf_price-all.fact-order-sys-from  <= p-fact-order  and
     6724             ( buf_price-all.fact-order-sys-to = ? or
     6725               buf_price-all.fact-order-sys-to >=  p-fact-order)
     6726               :
     6727                 create tt_price-all .
     6728                 buffer-copy buf_price-all to tt_price-all
     6729                 assign
     6730                   tt_price-all.price-sale  = buf_price-all.price-sale
     6731                 .
     6732       end.
     6733   define variable vt-plt-id as integer   no-undo .
     6734   define variable vt-plt-db as integer   no-undo .
     6735   define variable vt-pdf-id as integer   no-undo .
     6736   define variable vt-pdf-db as integer   no-undo .
     6737   define buffer neos_price-all for tt_price-all  .
     6738   find first tt_price-all where tt_price-all.b-code = v-main-b-code use-index pi no-error .
     6739       if available tt_price-all then do:
     6740        assign
     6741          vt-plt-id = tt_price-all.plt-id
     6742          vt-plt-db = tt_price-all.plt-db-num
     6743          vt-pdf-id = tt_price-all.pdf-id
     6744          vt-pdf-db = tt_price-all.pdf-db
     6745        .
     6746        if tt_price-all.b-code = p-b-code then do:
     6747             assign
     6748               p-plt-id           = tt_price-all.plt-id
     6749               p-plt-db-num       = tt_price-all.plt-db-num
     6750               p-pdf-id           = tt_price-all.pdf-id
     6751               p-pdf-db-num       = tt_price-all.pdf-db
     6752               p-sale-price       = tt_price-all.price-sale
     6753               .
     6754        end.
     6755        else do:
     6756          find first neos_price-all where
     6757                     neos_price-all.b-code     = p-b-code  and
     6758                     neos_price-all.plt-id     = vt-plt-id and
     6759                     neos_price-all.plt-db-num = vt-plt-db and
     6760                     neos_price-all.pdf-id     = vt-pdf-id and
     6761                     neos_price-all.pdf-db     = vt-pdf-db
     6762                     use-index pi no-error .
     6763            if available neos_price-all then do:
     6764             assign
     6765               p-plt-id           = tt_price-all.plt-id
     6766               p-plt-db-num       = tt_price-all.plt-db-num
     6767               p-pdf-id           = tt_price-all.pdf-id
     6768               p-pdf-db-num       = tt_price-all.pdf-db
     6769               p-sale-price       = neos_price-all.price-sale
     6770               .
     6771            end.
     6772            else do:
     6773           find first buf_bar-code no-lock where buf_bar-code.b-code = p-b-code no-error .
     6774           if error-status :error    then do:
     6775              message "Не найден бар-код" p-b-code view-as alert-box error .
     6776              return error return-value .
     6777           end.
     6778             assign
     6779               p-plt-id           = tt_price-all.plt-id
     6780               p-plt-db-num       = tt_price-all.plt-db-num
     6781               p-pdf-id           = tt_price-all.pdf-id
     6782               p-pdf-db-num       = tt_price-all.pdf-db
     6783               p-sale-price       = tt_price-all.price-sale * buf_bar-code.cli-base-rate
     6784               .
     6785            end.
     6786        end.
     6787     end.
     6788     end.
     6789   end procedure.
     6790   define variable v-Uvd           as character no-undo.
     6791   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     6792   DEFINE VARIABLE v-gl-UVEDOMLENIE as CHARACTER NO-UNDO INITIAL "Uvedomlenie":U.
     6793   FUNCTION Get-Contract-Attr RETURN CHARACTER(
     6794            INPUT iHost-Code AS INTEGER,
     6795            INPUT iContract-Code  AS INTEGER,
     6796            INPUT cAttr-code      AS CHARACTER):
     6797      DEFINE BUFFER buf_Contract-Attr FOR ub.Contract-Attr.
     6798      FIND FIRST buf_Contract-Attr WHERE
     6799                 buf_Contract-Attr.Host-code     = iHost-Code
     6800             AND buf_Contract-Attr.Contract-code = iContract-Code
     6801             AND buf_Contract-Attr.Attr-code     = cAttr-code
     6802           NO-LOCK NO-ERROR.
     6803      RETURN (IF AVAILABLE buf_Contract-Attr THEN buf_Contract-Attr.Attr-value ELSE ?).
     6804   END FUNCTION.
     6805   PROCEDURE Modify-Contract-Attr:
     6806      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     6807      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     6808      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     6809      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     6810      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     6811      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     6812      Tran:
     6813      DO TRANSACTION
     6814         ON ENDKEY UNDO Tran, RETRY Tran
     6815         ON ERROR  UNDO Tran, RETRY Tran
     6816         ON QUIT   UNDO Tran, RETRY Tran
     6817         ON STOP   UNDO Tran, RETRY Tran:
     6818         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     6819         FIND FIRST buf_Contract-Attr WHERE
     6820                    buf_Contract-Attr.Host-Code      = iHost-Code
     6821                AND buf_Contract-Attr.Contract-Code  = iContract-Code
     6822                AND buf_Contract-Attr.Attr-code      = cAttr-code
     6823              NO-LOCK NO-ERROR.
     6824         IF NOT AVAILABLE buf_Contract-Attr THEN DO:
     6825            CREATE buf_Contract-Attr NO-ERROR.
     6826            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6827         END. ELSE DO:
     6828            FIND CURRENT buf_Contract-Attr EXCLUSIVE-LOCK NO-ERROR.
     6829            IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6830         END.
     6831         ASSIGN
     6832            buf_Contract-Attr.Host-Code      = iHost-Code
     6833            buf_Contract-Attr.Contract-Code  = iContract-Code
     6834            buf_Contract-Attr.Attr-code      = cAttr-code
     6835            buf_Contract-Attr.Attr-value     = cAttr-value
     6836            NO-ERROR.
     6837         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6838         RELEASE buf_Contract-Attr NO-ERROR.
     6839         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6840      END.
     6841      RETURN.
     6842   END PROCEDURE.
     6843   PROCEDURE Create-Contract-Attr:
     6844      DEFINE INPUT  PARAMETER iHost-Code      AS INTEGER   NO-UNDO.
     6845      DEFINE INPUT  PARAMETER iContract-Code  AS INTEGER   NO-UNDO.
     6846      DEFINE INPUT  PARAMETER cAttr-code      AS CHARACTER NO-UNDO.
     6847      DEFINE INPUT  PARAMETER cAttr-value     AS CHARACTER NO-UNDO.
     6848      DEFINE OUTPUT PARAMETER cError          AS CHARACTER NO-UNDO INITIAL "".
     6849      DEFINE BUFFER buf_Contract-Attr FOR  ub.Contract-Attr.
     6850      Tran:
     6851      DO TRANSACTION
     6852         ON ENDKEY UNDO Tran, RETRY Tran
     6853         ON ERROR  UNDO Tran, RETRY Tran
     6854         ON QUIT   UNDO Tran, RETRY Tran
     6855         ON STOP   UNDO Tran, RETRY Tran:
     6856         IF RETRY THEN DO:       cError = "Ошибка транзакции:":U + PROGRAM-NAME(1) + ERROR-STATUS:GET-MESSAGE(1) + " " + RETURN-VALUE.        UNDO Tran, LEAVE Tran.    END.
     6857         CREATE buf_Contract-Attr NO-ERROR.
     6858         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6859         ASSIGN
     6860            buf_Contract-Attr.Host-Code      = iHost-Code
     6861            buf_Contract-Attr.Contract-Code  = iContract-Code
     6862            buf_Contract-Attr.Attr-code      = cAttr-code
     6863            buf_Contract-Attr.Attr-value     = cAttr-value
     6864            NO-ERROR.
     6865         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6866         RELEASE buf_Contract-Attr NO-ERROR.
     6867         IF ERROR-STATUS:ERROR THEN          UNDO Tran, RETRY Tran.
     6868      END.
     6869      RETURN.
     6870   END PROCEDURE.
