     6748               if available ub.shop
     6749               then do:
     6750                   assign
     6751                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6752                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6753                       t-phone = shop.phone
     6754                       t-inn = ""
     6755                       t-okpo = ""
     6756                   .
     6757               end.
     6758          end.
     6759          when 'скл':U
