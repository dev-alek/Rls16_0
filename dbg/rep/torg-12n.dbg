     3856   procedure torgconf-get-reason  :
     3857   define input parameter  p-doc-code       as character        no-undo.
     3858   define input parameter  p-reason-code    as integer          no-undo .
     3859   define input parameter  p-doc-type       as character        no-undo.
     3860       if p-reason-code > 0
     3861       then do:
     3862           define buffer buf_trn-reason for ub.trn-reason.
     3863           find first buf_trn-reason no-lock where buf_trn-reason.reason-code = p-reason-code no-error .
     3864           if available buf_trn-reason then assign v-torgconf-reason =  buf_trn-reason.reason-name .
     3865       end.
     3866       else do:
     3867           if p-doc-type = 'при':U
     3868           then  do:
     3869               define variable v-attr-type     as character    no-undo.
     3870               define variable v-attr-value    as character    no-undo.
     3871               run gbl/trdcat-v.p (input p-doc-code,input 'nids':U,output v-attr-value,output v-attr-type) .
     3872               assign v-torgconf-reason = v-attr-value .
     3873               run gbl/trdcat-v.p (input p-doc-code,input 'dids':U,output v-attr-value,output v-attr-type) .
     3874               assign v-torgconf-reason = v-torgconf-reason + " от " + v-attr-value .
     3875           end.
     3876       end.
     3877   end procedure.
     3878   define variable vss-include-info15 as character format "X(65)" no-undo
     3879   initial "@(#)$Workfile$ $Revision$".
     3880   define temp-table temp_p-fmt_string-part no-undo
     3881       field str-key       as integer
     3882       field string-part   as character
     3883       index pi is primary unique
     3884           str-key
     3885   .
     3886   define variable v-p-fmt-15-str-key    as integer      no-undo.
     3887   FUNCTION center-field RETURNS INTEGER (INPUT iStartPix AS INTEGER, iEndPix AS INTEGER,
     3888                                     iInput AS INTEGER).
     3889     def var v-start-print as integer no-undo .
     3890     if (iStartPix < 0) or (iEndPix < iStartPix) then return 0.
     3891     assign
     3892       v-start-print = INTEGER(iStartPix + ((iEndPix - iStartPix) / 2) - (iInput / 2))
     3893     .
     3894     RETURN v-start-print .
     3895   END FUNCTION.
     3896   FUNCTION right-field RETURNS INTEGER ( iEndPix AS INTEGER,
     3897                                     iInput AS INTEGER).
     3898     def var v-start-print as integer no-undo .
     3899     assign
     3900       v-start-print = INTEGER(iEndPix - 1 - iInput)
     3901     .
     3902     if v-start-print < 0 then return 0.
     3903     RETURN v-start-print .
     3904   END FUNCTION.
     3905   function p-fmt-align-string returns character (
     3906         p-in-string      as character
     3907       , p-page-width     as integer
     3908       , p-align-type     as character
     3909   ).
     3910       define variable v-string-length     as integer      no-undo.
     3911       define variable v-out-string        as character    no-undo.
     3912       assign
     3913           v-string-length = length( trim( p-in-string ) )
     3914       .
     3915       if v-string-length >= p-page-width
     3916       then do:
     3917           assign
     3918               v-out-string = trim( p-in-string )
     3919           .
     3920       end.
     3921       else do:
     3922           case p-align-type
     3923           :
     3924               when 'left':U
     3925               then do:
     3926                   assign
     3927                       v-out-string = trim( p-in-string )
     3928                   .
     3929               end.
     3930               when 'right':U
     3931               then do:
     3932                   assign
     3933                       v-out-string = fill( " ":U, p-page-width - v-string-length ) + trim( p-in-string )
     3934                   .
     3935               end.
     3936               when 'center':U
     3937               then do:
     3938                   assign
     3939                       v-out-string = fill( " ":U, integer( ( p-page-width - v-string-length ) / 2 ) ) + trim( p-in-string )
     3940                   .
     3941               end.
     3942           end case.
     3943       end.
     3944       return v-out-string .
     3945   end function.
     3946   procedure p-fmt-split-string :
     3947   define input parameter p-source-string  as character        no-undo.
     3948   define input parameter p-split-length   as integer          no-undo.
     3949   define output parameter p-string-1      as character        no-undo.
     3950   define output parameter p-string-2      as character        no-undo.
     3951   do
     3952   on error undo, return error
     3953   :
     3954       define variable v-space-pos    as integer      no-undo.
     3955       if length( p-source-string ) <= p-split-length
     3956       then do:
     3957           assign
     3958               p-string-1 = p-source-string
     3959           .
     3960       end.
     3961       else do:
     3962           assign
     3963               v-space-pos = r-index( p-source-string, " ":U, p-split-length )
     3964           .
     3965           if v-space-pos = 0
     3966           then do:
     3967               assign
     3968                   v-space-pos = index( p-source-string, " ":U )
     3969               .
     3970           end.
     3971           if v-space-pos = 0
     3972           then do:
     3973               assign
     3974                   p-string-1 = substring( p-source-string, 1, p-split-length )
     3975                   p-string-2 = trim( substring( p-source-string, p-split-length, p-split-length ) )
     3976               .
     3977           end.
     3978           else do:
     3979               assign
     3980                   p-string-1 = substring( p-source-string, 1, v-space-pos )
     3981                   p-string-2 = trim( substring( p-source-string, v-space-pos ) )
     3982               .
     3983           end.
     3984       end.
     3985   end.
     3986   end procedure.
     3987   procedure p-fmt-round :
     3988   define input parameter p-qnty               as decimal          no-undo.
     3989   define input parameter p-price-no-VAT       as decimal          no-undo.
     3990   define input parameter p-VAT                as decimal          no-undo.
     3991   define input parameter p-SLT                as decimal          no-undo.
     3992   define input parameter p-road-tax           as decimal          no-undo.
     3993   define output parameter p-new-price-no-VAT  as decimal          no-undo.
     3994   define output parameter p-new-VAT           as decimal          no-undo.
     3995   define output parameter p-new-SLT           as decimal          no-undo.
     3996   define output parameter p-new-sum-VAT       as decimal          no-undo.
     3997   define output parameter p-new-sum-SLT       as decimal          no-undo.
     3998   define output parameter p-new-sum-road-tax  as decimal          no-undo.
     3999   define output parameter p-new-sum-no-VAT    as decimal          no-undo.
     4000   define output parameter p-new-sum-full      as decimal          no-undo.
     4001       define variable v-vat-pc    as decimal      no-undo.
     4002       define variable v-slt-pc    as decimal      no-undo.
     4003   do
     4004   on error undo, return error
     4005   :
     4006       if p-price-no-VAT = 0
     4007       then do:
     4008           assign
     4009               p-new-price-no-VAT = 0.0
     4010               p-new-VAT          = ?
     4011               p-new-SLT          = ?
     4012               p-new-sum-VAT      = 0.0
     4013               p-new-sum-SLT      = 0.0
     4014               p-new-sum-no-VAT   = 0.0
     4015               p-new-sum-road-tax = 0.0
     4016               p-new-sum-full     = 0.0
     4017           .
     4018       end.
     4019       else do:
     4020           assign
     4021               v-vat-pc            = p-VAT / p-price-no-VAT
     4022               v-slt-pc            = p-SLT / ( p-price-no-VAT + p-VAT )
     4023               p-new-price-no-VAT  = round( p-price-no-VAT, 2 )
     4024               p-new-VAT           = round( p-new-price-no-VAT * v-vat-pc, 2 )
     4025               p-new-SLT           = round( ( p-new-price-no-VAT + p-new-VAT ) * v-slt-pc, 2 )
     4026               p-new-sum-VAT       = round( p-new-VAT          * p-qnty, 2 )
     4027               p-new-sum-SLT       = round( ( p-new-price-no-VAT + p-new-VAT ) * p-qnty * v-slt-pc, 2 )
     4028               p-new-sum-no-VAT    = round( p-new-price-no-VAT * p-qnty, 2 )
     4029               p-new-sum-road-tax  = round( p-road-tax * p-qnty, 2 )
     4030               p-new-sum-full      = round( ( p-new-price-no-VAT + p-new-VAT + p-new-SLT + p-road-tax ) * p-qnty, 2 )
     4031           .
     4032       end.
     4033   end.
     4034   end procedure.
     4035   procedure p-fmt-split :
     4036   define input parameter p-in-string      as character        no-undo.
     4037   define input parameter p-split-length   as integer          no-undo.
     4038       define variable v-start-pos     as integer      no-undo.
     4039       define variable v-end-pos       as integer      no-undo.
     4040       define buffer buf_temp_p-fmt_string-part        for temp_p-fmt_string-part.
     4041   do
     4042   for buf_temp_p-fmt_string-part
     4043   on error undo, return error
     4044   :
     4045       empty temp-table buf_temp_p-fmt_string-part.
     4046       if p-split-length < 1
     4047       then do:
     4048           undo, return error substitute( "p-fmt-split: Строка не может быть разбита на &1 частей", p-split-length ).
     4049       end.
     4050       assign
     4051           p-in-string                 = trim( p-in-string )
     4052           v-p-fmt-15-str-key   = 0
     4053           v-start-pos                 = 1
     4054           v-end-pos                   = length( p-in-string )
     4055       .
     4056       run p-fmt-get-string-range in this-procedure (
     4057             input p-in-string
     4058           , input p-split-length
     4059           , input v-start-pos
     4060           , output v-start-pos
     4061           , output v-end-pos
     4062       ).
     4063       do while v-end-pos <> 0
     4064       :
     4065           create buf_temp_p-fmt_string-part.
     4066           assign
     4067               v-p-fmt-15-str-key = v-p-fmt-15-str-key + 1
     4068           .
     4069           assign
     4070               buf_temp_p-fmt_string-part.str-key      = v-p-fmt-15-str-key
     4071               buf_temp_p-fmt_string-part.string-part  = substring( p-in-string, v-start-pos, v-end-pos - v-start-pos )
     4072           .
     4073           assign
     4074               v-start-pos = v-end-pos + 1
     4075           .
     4076           run p-fmt-get-string-range in this-procedure (
     4077                 input p-in-string
     4078               , input p-split-length
     4079               , input v-start-pos
     4080               , output v-start-pos
     4081               , output v-end-pos
     4082           ).
     4083       end.
     4084   end.
     4085   end procedure.
     4086   procedure p-fmt-get-string-range :
     4087   define input parameter p-in-string      as character        no-undo.
     4088   define input parameter p-split-length   as integer          no-undo.
     4089   define input parameter p-old-start-pos  as integer          no-undo.
     4090   define output parameter p-start-pos     as integer          no-undo.
     4091   define output parameter p-end-pos       as integer          no-undo.
     4092       define variable v-init-string    as character    no-undo.
     4093       define variable v-temp-char      as character    no-undo.
     4094       define variable v-temp-pos       as integer      no-undo.
     4095       define variable v-counter        as integer      no-undo.
     4096   do
     4097   on error undo, return error
     4098   :
     4099       assign
     4100           p-start-pos   = p-old-start-pos
     4101           v-init-string = substring( p-in-string, p-start-pos )
     4102       no-error.
     4103       if error-status :error
     4104       or trim( v-init-string ) = "":U
     4105       then do:
     4106           assign
     4107               p-end-pos = 0
     4108           .
     4109           undo, return .
     4110       end.
     4111       assign
     4112           v-temp-char   = substring( v-init-string, 1, 1 )
     4113       .
     4114       do
     4115       while trim( v-temp-char ) = "":U
     4116       :
     4117           assign
     4118               p-start-pos     = p-start-pos + 1
     4119               v-init-string   = substring( p-in-string, p-start-pos )
     4120               v-temp-char     = substring( v-init-string, 1, 1 )
     4121           .
     4122       end.
     4123       assign
     4124           v-temp-pos  = p-split-length
     4125           v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     4126           v-counter   = 0
     4127       .
     4128       search-word-end:
     4129       do
     4130       while trim( v-temp-char ) <> "":U
     4131       :
     4132           assign
     4133               v-counter   = v-counter + 1
     4134           .
     4135           if v-counter > 20
     4136           then do:
     4137               assign
     4138                   v-temp-pos  = p-split-length
     4139               .
     4140               leave search-word-end.
     4141           end.
     4142           assign
     4143               v-temp-pos  = v-temp-pos - 1
     4144               v-temp-char = substring( v-init-string, v-temp-pos, 1 )
     4145           .
     4146       end.
     4147       assign
     4148           p-end-pos = p-start-pos + v-temp-pos - 1
     4149       .
     4150   end.
     4151   end procedure.
