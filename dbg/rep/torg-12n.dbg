     6700           space(5) string( "ИНН " + t-inn + " " + CAPS( ub.clients.obj-name ) + " (" + string(ub.clients.obj-code) + ")"
     6701                                   + t-addres + t-phone) format "X(160)"
     6702                       "по ОКПО" format "X(7)" AT 172 "| " AT 180 t-okpo format "X(16)" "|" AT 198 skip
     6703           space(5) ( if t-doc.doc-type <> 'при':U then
