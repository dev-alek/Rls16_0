     3400               .
     3401               assign
     3402                  v-torgconf-main-buh  = buf_sysconf.snr-accnt
     3403               .
     3404            end.
     3405      end.
     3406      if v-torgconf-outB = "buh_obj"
     3407      then do:
     3408         CASE v-torgconf-self-obj-type:
     3409         WHEN 'маг':U
     3410         THEN DO:
     3411            find first buf_shop no-lock
     3412            where buf_shop.obj-code = v-torgconf-self-obj-code
     3413            .
     3414            assign
