     5135                       , input price-noNDS
     5136                       , input price-noNDS * ub.doc-line.vat-pc / 100
     5137                       , input price-noNDS * ( 1 + ( ub.doc-line.vat-pc / 100 ) ) * torg-SLT-pc / 100
     5138                       , input v-void-decimal
