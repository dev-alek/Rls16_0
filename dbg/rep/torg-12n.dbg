     1383               .
     1384           end.
     1385           if lookup( p-form-name, v-outrubl  ) <> 0
     1386           then do:
     1387               assign
     1388                   v-torgconf-outrubl   = yes
     1389               .
     1390           end.
     1391           if lookup( p-form-name, v-outhold  ) <> 0
     1392           then do:
     1393               assign
     1394                   v-torgconf-outhold   = yes
     1395               .
     1396           end.
     1397           if lookup( p-form-name, v-outobj   ) <> 0
     1398           then do:
     1399               assign
     1400                   v-torgconf-outobj    = yes
     1401               .
     1402           end.
