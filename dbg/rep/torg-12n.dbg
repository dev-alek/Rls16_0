     4872         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     4873         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     4874         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     4875                 ) .
     4876   end.
