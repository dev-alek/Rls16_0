     6945           space(45) string( "ТОВАРНАЯ НАКЛАДНАЯ | "
     6946                                       + string( tdoc-code, "X(16)") + " | "
     6947                                       + v-doc-date-string
     6948                                       + " | " + (if t-doc.status_ <> 'факт':U then string( "(" + CAPS(t-doc.status_) + ")" ) else "")
     6949                                       ) format "X(100)" skip
