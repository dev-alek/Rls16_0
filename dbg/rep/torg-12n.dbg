       75   define  shared variable PrintRubl          as logical   no-undo .
       76   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       77   function breakstr returns character ( input        for-name    as character,
       78                                         input        line-length as integer,
       79                                         input-output line1       as character,
       80                                         input-output line2       as character ) :
       81     define variable ii as integer no-undo.
       82     if length( for-name ) > line-length then do:
       83       assign ii    = 1
       84              line1 = "":u
       85              line2 = "":u.
       86       if length( entry( ii, for-name , " ":u ) ) > line-length then do:
       87         assign line1 =       substring( for-name, 1, line-length     )
       88                line2 = trim( substring( for-name,    line-length + 1 ) ).
       89       end.                                                     else do:
       90         do while length( line1 + entry( ii, for-name, " ":u ) ) < ( line-length + 1 ) :
       91           assign line1 = line1 + entry( ii, for-name, " ":u ) + " ":u
       92                  ii    = ii    + 1.
       93           if length( entry( ii, for-name, " ":u ) ) > line-length then do:
       94             assign line1 = line1 + substring( for-name, length( line1 ), line-length - length( line1 ) + 1 ).
       95           end.
       96         end.
       97         assign line2 = trim( substring( for-name, length( line1 ) ) ).
       98       end.
       99     end.                                else do:
      100       assign line1 = for-name
      101              line2 = "":u.
      102     end.
      103     return ( line1 ).
      104   end function.
