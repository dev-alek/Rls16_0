     4935                       "Итого" @ ub.goods.gds-name
     4936                       Pg-tqnty @ tqnty
     4937                       Pg-stoim-noNDS @ stoim-noNDS
     4938                       Pg-VAT-gds  @ VAT-gds
     4939                       Pg-stoim @ stoim
     4940                       Pg-SLT-gds  @ SLT-gds
     4941                   with frame f-doc .
     4942                   down stream out-stream 1 with frame f-doc .
     4943               end.
     4944           end.
     4945                       PAGE STREAM Out-Stream.
     4946                   end.
     4947               gds-str1 = breakstr(ub.goods.gds-name, 30, input-output gds-str1, input-output gds-str2).
     4948       end.
     4949       else do:
     4950               assign gds-str1 = ub.goods.gds-name.
     4951       end.
     4952       FIND ub.gds-prt where ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK .
     4953       v-rootnode-code = ub.gds-prt.node-code.
