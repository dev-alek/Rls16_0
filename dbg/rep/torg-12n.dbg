     5111               if session:set-wait-state("compiler") then.
     5112               FOR EACH ub.gds-dtl WHERE
     5113                               ub.gds-dtl.prod-type = ub.doc-line.prod-type AND
     5114                               ub.gds-dtl.prod-code = ub.doc-line.prod-code AND
