     4878   procedure print-doc-line :
     4879   do
     4880   on error undo, return error
     4881   :
     4882   for each ub.doc-line no-lock
     4883      where ub.doc-line.doc-code = t-doc.doc-code
     4884   break   BY ub.doc-line.artic
     4885   :
     4886       FIND ub.goods WHERE ub.goods.prod-type = ub.doc-line.prod-type AND
     4887                                         ub.goods.prod-code = ub.doc-line.prod-code AND
     4888                                         ub.goods.artic = ub.doc-line.artic NO-LOCK .
     4889       if v-sys-key = "iab" then do:
     4890         FIND ub.sysconf WHERE ub.sysconf.host-code = t-doc.host-code NO-LOCK.
     4891         if t-doc.doc-type = 'рас':U AND t-doc.internal = no AND t-doc.pay-code = ub.sysconf.cash-pay then
     4892             assign torg-SLT-pc = 5.
     4893         else
     4894             assign torg-SLT-pc = 0.
     4895       end.
     4896       else do:
     4897         assign torg-SLT-pc = ub.doc-line.SLT-pc.
     4898       end.
     4899       if FullGdsName
     4900       then do:
     4901               gds-str1 = breakstr(ub.goods.gds-name, 30, input-output gds-str1, input-output gds-str2).
     4902               assign j = 0.
