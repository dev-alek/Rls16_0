     6915           space(5) string( "Вид оплаты: " + ( if available ub.pay-type and ( lookup( "Mari":U, p-mode ) = 0 or index( ub.pay-type.obj-name, "озврат":U ) = 0 ) then ub.pay-type.obj-name else "":U ) ) format "X(130)"
     6916                           string( "Транспортная накладная " ) format "X(23)" AT 147
     6917                           "номер" format "X(5)" AT 174 "| " AT 180
