     7086   procedure calc-out-vat-gds-dtl :
     7087   define output parameter p-price-no-vat  as decimal          no-undo.
     7088   do
     7089   on error undo, return error
     7090   :
     7091   if t-doc.ext-doc-type = 'ot':U or
     7092      t-doc.ext-doc-type = ?                 then do:
     7093     assign
     7094      out-vatp-have-vat-slt = yes.
     7095   end.
     7096   else do:
     7097     find first out-vatp_doc-attr no-lock
     7098       where out-vatp_doc-attr.doc-code  = t-doc.doc-code
     7099         and out-vatp_doc-attr.attr-code = 'envd':U
     7100         no-error .
     7101     if not available out-vatp_doc-attr then do:
     7102       assign
     7103         out-vatp-have-vat-slt = yes.
     7104     end.
     7105     else do:
     7106        out-vatp-have-vat-slt = no.
     7107     end.
     7108   end.
     7109   find first out-vatp_goods where out-vatp_goods.artic     = ub.doc-line.artic     and
     7110                                      out-vatp_goods.prod-type = ub.doc-line.prod-type and
     7111                                      out-vatp_goods.prod-code = ub.doc-line.prod-code no-lock.
     7112   define variable vss-include-info43 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     7113   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rootnode in g#library
     7114     (input  ub.doc-line.artic
     7115     ,input  ub.doc-line.prod-type
     7116     ,input  ub.doc-line.prod-code
     7117     ,output varroot-node
     7118     ) no-error .
     7119   if error-status :error then do:
     7120     message
     7121       vss-workfile vss-revision vss-description skip
     7122       "Ошибка при определении корневого признака товара" skip
     7123       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     7124       error-status :get-message(1) skip
     7125       return-value skip
     7126       view-as alert-box error .
     7127     undo, return error .
     7128   end.
     7129   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run prtat in g#library
     7130     (input  varroot-node
     7131     ,input  'empty-scale=request'
     7132     ,output varempty-scale
     7133     ) no-error .
     7134   if error-status :error then do:
     7135     message
     7136       vss-workfile vss-revision vss-description skip
     7137       "Ошибка при определении атрибута признака" skip
     7138       "Артикул" ub.doc-line.artic ub.doc-line.prod-type ub.doc-line.prod-code skip
     7139       "Признак" varroot-node skip
     7140       "Запрашивался атрибут" "empty-scale=request" skip
     7141       error-status :get-message(1) skip
     7142       return-value skip
     7143       view-as alert-box error .
     7144     undo, return error .
     7145   end.
     7146   define variable vss-include-info44 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     7147   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     7148     (output varoutvprb
     7149     )  .
     7150   if varoutvprb = "base":u then do:
     7151     assign
     7152           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     7153       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1)
     7154     .
     7155   end.
     7156   else do:
     7157     assign
     7158           road-tax-base-sale    =  (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale)
     7159       excise-base-sale      =  (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   / t-doc.base-rate * t-doc.base-scale)
     7160     .
     7161   end.
     7162   if varoutvprb = "rubl":u then do:
     7163     assign
     7164           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * 1)
     7165       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * 1) .
     7166   end.
     7167   else do:
     7168     assign
     7169           road-tax-rubl-sale    = (if ub.doc-line.road-tax = ? then 0 else ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale)
     7170       excise-rubl-sale      = (if ub.doc-line.excise   = ? then 0 else ub.doc-line.excise   * t-doc.base-rate / t-doc.base-scale) .
     7171   end.
     7172   assign
     7173     varis-cons-parts-have =  no.
