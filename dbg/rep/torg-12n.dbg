     4658       assign v-doc-date-string =  ( if t-doc.status_ <> 'факт':U or v-print-doc = "yes"
     4659                           then string( t-doc.doc-date, "99/99/9999" )
     4660                           else string( t-doc.fact-date, "99/99/9999" )
     4661                           )
     4662       .
     4663   end.
     4664   FIND OurObject WHERE OurObject.obj-type = t-doc.obj-type AND
     4665                                             OurObject.obj-code = t-doc.obj-code NO-LOCK NO-ERROR.
     4666   CASE OurObject.obj-type :
     4667       when 'маг':U then
     4668           do:
     4669               FIND ub.shop WHERE ub.shop.obj-code = OurObject.obj-code NO-LOCK .
     4670               tdoc-prt = ub.shop.doc-prt.
     4671           end.
     4672       when 'скл':U then
     4673           do:
     4674               FIND ub.store WHERE ub.store.obj-code = OurObject.obj-code NO-LOCK .
     4675               tdoc-prt = ub.store.doc-prt .
     4676           end.
     4677   END CASE.
     4678   if NOT tdoc-prt OR Invers then
     4679       PrintScale = no .
     4680   if session:set-wait-state("compiler") then.
     4681   output STREAM Out-Stream to value( string( session:temp-directory +
     4682                                        "rpt" + string( g#report-num ) ) )
     4683                                        page-size  value(43) .
     4684   FORM HEADER
     4685       v-single-line format "X(198)" AT 1 SKIP
     4686       "Продолжение - на следующей странице" AT 30 SKIP
     4687       with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     4688   VIEW STREAM Out-Stream FRAME BottomFrame .
     4689   run print-header in this-procedure .
     4690   FIND ub.currency WHERE ub.currency.curr-code = t-doc.exch-code NO-LOCK.
     4691   if v-torgconf-outt12 = yes
     4692   then do:
     4693       form with frame f-doc-m .
     4694   end.
     4695   else do:
     4696       form with frame f-doc .
     4697   end.
     4698   run print-doc-line in this-procedure .
     4699   if line-counter( Out-Stream ) + 20 > page-size( Out-Stream ) then
     4700       do:
     4701   define variable vss-include-info23 as character format "X(65)" no-undo
     4702   initial "@(#)$Workfile$ $Revision$".
     4703   if page-number( out-stream ) > prevpage then
     4704       assign
     4705           Pg-tqnty = 0
     4706           Pg-VAT-gds = 0
     4707           Pg-SLT-gds = 0
     4708           Pg-stoim-noNDS = 0
     4709           Pg-stoim = 0
     4710           .
     4711           do:
     4712               put stream out-stream v-single-line format "x(198)" skip.
     4713               if v-torgconf-outt12 = yes
     4714               then do:
     4715                   display stream out-stream
     4716                       "Итого" @ ub.goods.gds-name
     4717                       Pg-tqnty @ tqnty
     4718                       Pg-stoim-noNDS @ stoim-noNDS
     4719                       Pg-VAT-gds  @ VAT-gds
     4720                       Pg-stoim @ stoim
     4721                   with frame f-doc-m .
     4722                   down stream out-stream 1 with frame f-doc-m .
     4723               end.
     4724               else do:
     4725                   display stream out-stream
     4726                       "Итого" @ ub.goods.gds-name
     4727                       Pg-tqnty @ tqnty
     4728                       Pg-stoim-noNDS @ stoim-noNDS
     4729                       Pg-VAT-gds  @ VAT-gds
     4730                       Pg-stoim @ stoim
     4731                       Pg-SLT-gds  @ SLT-gds
     4732                   with frame f-doc .
     4733                   down stream out-stream 1 with frame f-doc .
     4734               end.
     4735           end.
     4736           page STREAM Out-Stream .
     4737       end.
     4738   HIDE STREAM Out-Stream FRAME BottomFrame .
     4739   define variable vss-include-info24 as character format "X(65)" no-undo
     4740   initial "@(#)$Workfile$ $Revision$".
     4741   if page-number( out-stream ) > prevpage then
     4742       assign
     4743           Pg-tqnty = 0
     4744           Pg-VAT-gds = 0
     4745           Pg-SLT-gds = 0
     4746           Pg-stoim-noNDS = 0
     4747           Pg-stoim = 0
     4748           .
     4749           do:
     4750               put stream out-stream v-single-line format "x(198)" skip.
     4751               if v-torgconf-outt12 = yes
     4752               then do:
     4753                   display stream out-stream
     4754                       "Итого" @ ub.goods.gds-name
     4755                       Pg-tqnty @ tqnty
     4756                       Pg-stoim-noNDS @ stoim-noNDS
     4757                       Pg-VAT-gds  @ VAT-gds
     4758                       Pg-stoim @ stoim
     4759                   with frame f-doc-m .
     4760                   down stream out-stream 1 with frame f-doc-m .
     4761               end.
     4762               else do:
     4763                   display stream out-stream
     4764                       "Итого" @ ub.goods.gds-name
     4765                       Pg-tqnty @ tqnty
     4766                       Pg-stoim-noNDS @ stoim-noNDS
     4767                       Pg-VAT-gds  @ VAT-gds
     4768                       Pg-stoim @ stoim
     4769                       Pg-SLT-gds  @ SLT-gds
     4770                   with frame f-doc .
     4771                   down stream out-stream 1 with frame f-doc .
     4772               end.
     4773           end.
     4774   if v-torgconf-outt12 = yes
     4775   then do:
     4776       DISPLAY STREAM Out-Stream
     4777           "Всего по накладной" @ ub.goods.gds-name
     4778           t-doc.fact-qnty @ tqnty
     4779           v-sum-stoim-noNDS @ stoim-noNDS
     4780           v-sum-VAT-gds  @ VAT-gds
     4781           v-sum-stoim @ stoim
     4782       with frame f-doc-m .
     4783       DOWN STREAM Out-Stream 2 with FRAME f-doc-m .
     4784   end.
     4785   else do:
     4786       DISPLAY STREAM Out-Stream
     4787           "Всего по накладной" @ ub.goods.gds-name
     4788           t-doc.fact-qnty @ tqnty
     4789           v-sum-stoim-noNDS @ stoim-noNDS
     4790           v-sum-VAT-gds  @ VAT-gds
     4791           v-sum-stoim @ stoim
     4792           v-sum-SLT-gds  @ SLT-gds
     4793       with frame f-doc .
     4794       DOWN STREAM Out-Stream 2 with FRAME f-doc .
     4795   end.
     4796   if PrintRubl then
     4797       run rep/wp-rub.p ( ( v-sum-stoim + v-sum-SLT-gds ), output s1, output s2 ) .
     4798   else
     4799       run rep/wp.p ( input p-mainmenu-handle, ( v-sum-stoim + v-sum-SLT-gds ), output s1, output s2 ) .
     4800   run rep/wp-qnty.p ( input ( LineCounter - 1 ), output txt-LC).
     4801   PUT STREAM Out-Stream
     4802       space(10) string( "Всего на сумму: " + trim( string( ( v-sum-stoim + v-sum-SLT-gds ), "->>>,>>>,>>>,>>>,>>9.99") ) + " (" +
     4803                                   trim( ( if Invers then ub.currency.curr-abbr else ( if PrintRubl then "РУБ" else "баз.вал" ) ) ) + ")" ) format "X(180)"
     4804   .
     4805   if t-doc.doc-type <> 'при':U
     4806   then put stream out-stream
     4807       skip
     4808       space(15) string( "В том числе " + (if NOT Invers AND ( if PrintRubl then t-doc.discnt-rubl else t-doc.tot-calc ) < 0 then "наценка: " else "скидка: " ) +
     4809                                   (if NOT Invers then trim( string( ABS( ( if PrintRubl then t-doc.discnt-rubl else t-doc.tot-calc ) ), ">>>,>>>,>>>,>>>,>>9.99") ) else "0.00" ) +
     4810                                   " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)"
     4811   .
     4812   PUT STREAM Out-Stream
     4813       skip
     4814       space(30) string( "НДС: " + trim( string( v-sum-VAT-gds, "->>>,>>>,>>>,>>>,>>9.99") ) +
     4815                                   " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)"
     4816   .
     4817   if v-sum-SLT-gds <> 0
     4818   then do:
     4819       PUT STREAM Out-Stream
     4820           SKIP
     4821           space(19) string( "налог с продаж: " + trim( string( v-sum-SLT-gds, "->>>,>>>,>>>,>>>,>>9.99") ) +
     4822                                       " (" + trim( ( if PrintRubl then "РУБ" else "баз.вал" ) ) + ")" ) format "X(160)"
     4823       .
     4824   end.
     4825   define variable v-doc-places    as character    no-undo.
     4826   define variable v-attr-type     as character    no-undo.
     4827   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     4828                           input 'QntyPlace':U ,
     4829                          output v-doc-places ,
     4830                          output v-attr-type )  .
     4831   if v-doc-places = "":U
     4832   then do:
     4833       assign
     4834           v-doc-places = UndLine
     4835       .
     4836   end.
     4837   PUT STREAM Out-Stream
     4838       SKIP(2)
     4839       space(10) string( "Товарная накладная имеет приложение на " + UndLine ) format "X(125)" SKIP
     4840       space(10) string( "и содержит " + CAPS( txt-LC ) + " порядковый(ых) номер(ов) записей") format "X(180)" SKIP
     4841       UndLine format "X(29)" AT 151 SKIP
     4842       string( "Масса груза (нетто) " + UndLine ) format "X(85)" AT 60
     4843               string( "|" + UndLine ) format "X(30)" AT 150 "|" SKIP
     4844       space(10) string( "Всего мест " + v-doc-places ) format "X(45)"
     4845               string( "Масса груза (брутто) " + UndLine ) format "X(85)" AT 60
     4846               string( "|" + UndLine ) format "X(30)" AT 150 "|" SKIP(1)
     4847       string( "Приложение (паспорта, сертификаты, и т.д.) на " + string( UndLine, "X(42)" ) + " листах" ) format "X(95)" "|" AT 97
     4848           string( "По доверенности N " + string( UndLine, "X(39)" ) + " от " + UndLine ) format "X(100)" AT 99 SKIP
     4849       "Всего отпущено на сумму " format "X(95)" "|" AT 97 string( "выданной " + UndLine ) format "X(100)" AT 99 SKIP
     4850       space(2) CAPS(s1) format "X(93)" "|" AT 97 SKIP
     4851       string( "Отпуск разрешил " + UndLine ) format "X(95)" "|" AT 97 SKIP
     4852       "|" AT 97 string( "Груз принял " + UndLine ) format "X(100)" AT 99 SKIP
     4853       UndLine format "X(95)" "|" AT 97 string( "Груз получил грузополучатель " + UndLine ) format "X(100)" AT 99 SKIP
     4854       "М.П." AT 15  "|" AT 97 "М.П." AT 99 SKIP
     4855       .
