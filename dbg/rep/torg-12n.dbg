     1352                   v-torgconf-outdisc  = yes
     1353               .
     1354           end.
     1355           if lookup( p-form-name, v-outsubs ) <> 0
     1356           then do:
     1357               assign
     1358                   v-torgconf-outsubs  = yes
     1359               .
     1360           end.
     1361           if lookup( p-form-name, v-outrecv ) <> 0
