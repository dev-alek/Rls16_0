     1902           v-torgconf-cli-bank-exists  = v-fmtcli-bank-exists
     1903           v-torgconf-cli-bank-r-schet = v-fmtcli-bank-r-schet
     1904           v-torgconf-cli-bank-c-schet = v-fmtcli-bank-c-schet
     1905           v-torgconf-cli-bank-bik     = v-fmtcli-bank-bik
