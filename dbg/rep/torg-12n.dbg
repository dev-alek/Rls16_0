     1432   procedure torgconf-get-self-param :
     1433   define input parameter p-obj-type           as character        no-undo.
     1434   define input parameter p-obj-code           as integer          no-undo.
     1435   define input parameter p-curr-code          as integer          no-undo.
     1436       define variable v-host-code    as integer      no-undo.
     1437       define variable v-par-type     as character    no-undo.
     1438   do
     1439   on error  undo, return error substitute( "&1. &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message(1))
     1440   :
     1441   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1442   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1443     (input  p-obj-type
     1444     ,input  p-obj-code
     1445     ,output v-host-code
     1446     )  .
     1447       if v-torgconf-outhold = yes
     1448       then do:
     1449           run torgconf-get-holdfirm-code in this-procedure (
     1450                 input p-obj-type
     1451               , input p-obj-code
     1452               , output v-torgconf-self-host-code
     1453           ).
     1454           if v-torgconf-self-host-code = 0
     1455           then do:
     1456               return error.
     1457           end.
     1458       end.
     1459       else do:
     1460           assign
     1461               v-torgconf-self-host-code = v-host-code
     1462           .
     1463       end.
     1464       if v-torgconf-self-host-code = 0
     1465       then do:
     1466           assign
     1467               v-torgconf-self-host-name           = "":U
     1468               v-torgconf-self-host-addres         = "":U
     1469               v-torgconf-self-host-post-addres    = "":U
     1470               v-torgconf-self-host-phone          = "":U
     1471               v-torgconf-self-host-inn            = "":U
     1472               v-torgconf-self-host-kpp            = "":U
     1473               v-torgconf-self-host-okpo           = "":U
     1474               v-torgconf-self-host-egrip-date     = "":U
     1475               v-torgconf-self-host-egrip-num      = "":U
     1476           .
     1477       end.
     1478       else do:
     1479           run fmtcli-get-client in this-procedure (
     1480                 input 'орг':U
     1481               , input v-torgconf-self-host-code
     1482           ).
     1483           assign
     1484               v-torgconf-self-host-name        = v-fmtcli-name
     1485               v-torgconf-self-host-engl-name   = v-fmtcli-engl-name
     1486               v-torgconf-self-host-addres      = v-fmtcli-full-addres
     1487               v-torgconf-self-host-post-addres = v-fmtcli-post-addres
     1488               v-torgconf-self-host-phone       = v-fmtcli-phone
     1489               v-torgconf-self-host-inn         = v-fmtcli-inn
     1490               v-torgconf-self-host-kpp         = v-fmtcli-kpp
     1491               v-torgconf-self-host-okpo        = v-fmtcli-okpo
     1492           .
     1493           run gbl/clntat-v.p (
     1494                 input 'орг':U
     1495               , input v-torgconf-self-host-code
     1496               , input 'egrip-date':U
     1497               , output v-torgconf-self-host-egrip-date
     1498               , output v-par-type
     1499           ).
     1500           run gbl/clntat-v.p (
     1501                 input 'орг':U
     1502               , input v-torgconf-self-host-code
     1503               , input 'egrip-num':U
     1504               , output v-torgconf-self-host-egrip-num
     1505               , output v-par-type
     1506           ).
     1507           run fmtcli-get-bank in this-procedure (
     1508                 input v-host-code
     1509               , input 'орг':U
     1510               , input v-torgconf-self-host-code
     1511               , input p-curr-code
     1512           ).
     1513       end.
     1514       assign
     1515           v-torgconf-self-schet-exists = v-fmtcli-schet-exists
     1516           v-torgconf-self-bank-exists  = v-fmtcli-bank-exists
     1517           v-torgconf-self-bank-r-schet = v-fmtcli-bank-r-schet
     1518           v-torgconf-self-bank-c-schet = v-fmtcli-bank-c-schet
     1519           v-torgconf-self-bank-bik     = v-fmtcli-bank-bik
     1520           v-torgconf-self-bank-name    = v-fmtcli-bank-name
     1521           v-torgconf-self-bank-addres  = v-fmtcli-bank-addres
     1522           v-torgconf-self-bank-city    = v-fmtcli-bank-city
     1523       .
     1524       assign
     1525           v-torgconf-self-obj-type = p-obj-type
     1526           v-torgconf-self-obj-code = p-obj-code
     1527       .
     1528       run fmtcli-get-client in this-procedure (
     1529             input p-obj-type
     1530           , input p-obj-code
     1531       ).
     1532       assign
     1533           v-torgconf-self-obj-name       = v-fmtcli-name
     1534           v-torgconf-self-obj-engl-name  = v-fmtcli-engl-name
     1535           v-torgconf-self-obj-addres     = v-fmtcli-full-addres
     1536           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1537           v-torgconf-self-obj-phone      = v-fmtcli-phone
     1538           v-torgconf-self-obj-inn        = v-fmtcli-inn
     1539           v-torgconf-self-obj-okpo       = v-fmtcli-okpo
     1540       .
     1541   end.
     1542   end procedure.
     1543   procedure torgconf-get-recepient-param :
     1544   define input parameter torgconfdoc-code   as character                  no-undo.
     1545   define output parameter v-code-rec        as integer                    no-undo .
     1546   define output parameter v-type-rec        as character                  no-undo initial 'C':U.
     1547   define output parameter v-codefirm-rec    as integer                    no-undo .
     1548   define output parameter v-curcode-rec     as integer                    no-undo .
     1549        define variable  v-recipient-code  as character                  no-undo .
     1550        define variable  v-recipient       like ub.doc-attr.attr-value   no-undo.
     1551        define variable  v-trdcattr-type   as character                  no-undo initial 'C':U.
     1552   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input torgconfdoc-code ,
     1553                           input 'Recipient':U ,
     1554                          output v-recipient-code ,
     1555                          output v-trdcattr-type ) no-error .
     1556       if error-status :error then do:
     1557        message
     1558         vss-workfile vss-revision vss-description skip
     1559         "Ошибка при вызове процедуры tdat-val":U skip
     1560         "Документ: " torgconfdoc-code skip
     1561         "Атрибут: " 'Recipient':U skip
     1562         "Значение: " v-recipient skip
     1563         trim( error-status :get-message (1) ) skip
     1564         return-value skip
     1565         view-as alert-box error.
     1566       undo, return error return-value.
     1567       end.
     1568     assign
     1569       v-recipient  = v-recipient-code
     1570       v-type-rec = substring(v-recipient-code,1,3)
     1571       v-code-rec  = int(substring(v-recipient-code,4,15))
     1572       no-error
     1573     .
     1574     if v-type-rec = ? then v-type-rec = "" .
     1575     if v-code-rec  = ? then v-code-rec  =  0 .
     1576     end procedure.
