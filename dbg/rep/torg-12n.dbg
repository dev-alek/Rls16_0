     6962   end procedure.
     6963   procedure calc-in-vat-doc-line :
     6964   define output parameter p-price-no-vat  as decimal          no-undo.
     6965   do
     6966   on error undo, return error
     6967   :
     6968   assign
     6969     price-rubl-with-tax-loc = ub.doc-line.price-rubl
     6970     price-base-with-tax-loc = ub.doc-line.price-base
     6971   .
     6972   define variable vss-include-info42 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     6973   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     6974     (output varinvprb
     6975     )  .
     6976      find first in-vatp_doc-attr no-lock
     6977       where in-vatp_doc-attr.doc-code  = t-doc.doc-code
     6978         and in-vatp_doc-attr.attr-code = 'envd':U
     6979       no-error .
     6980       if available in-vatp_doc-attr
     6981          then do:
     6982          assign
     6983            in-vatp-have-vat-slt = no.
     6984      end.
     6985      else do:
     6986        assign
     6987          in-vatp-have-vat-slt = yes.
     6988      end.
     6989      find first in-vatp-goods where in-vatp-goods.artic     = ub.doc-line.artic     and
     6990                                        in-vatp-goods.prod-type = ub.doc-line.prod-type and
     6991                                        in-vatp-goods.prod-code = ub.doc-line.prod-code no-lock.
     6992      if (not t-doc.internal and
     6993              t-doc.doc-type = 'при':U) or
     6994         in-vatp-goods.gds-type = 'у':U then do:
     6995         if varinvprb = "base":u then do:
     6996           assign
     6997             road-tax-base-loc = ub.doc-line.road-tax
     6998             road-tax-rubl-loc = ub.doc-line.road-tax * t-doc.base-rate / t-doc.base-scale.
     6999         end.
     7000         else do:
     7001           ASSIGN
     7002             road-tax-rubl-loc = ub.doc-line.road-tax
     7003             road-tax-base-loc = ub.doc-line.road-tax / t-doc.base-rate * t-doc.base-scale.
     7004         end.
     7005         if road-tax-base-loc = ? then road-tax-base-loc = 0.
     7006         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
     7007         assign
     7008           road-tax-cli-loc = ?.
     7009         ASSIGN
     7010           transport-base-loc = (if ub.doc-line.transport-base = ? then 0 else ub.doc-line.transport-base)
     7011           transport-rubl-loc = (if ub.doc-line.transport-rubl = ? then 0 else ub.doc-line.transport-rubl)
     7012           transport-cli-loc  = 0
     7013           other-base-loc     = (if ub.doc-line.other-base     = ? then 0 else ub.doc-line.other-base)
     7014           other-rubl-loc     = (if ub.doc-line.other-rubl     = ? then 0 else ub.doc-line.other-rubl)
     7015           other-cli-loc      = 0
     7016           vat-pc-loc         = (if ub.doc-line.vat-pc         = ? then 0 else ub.doc-line.vat-pc)
     7017           slt-pc-loc         = (if ub.doc-line.slt-pc         = ? then 0 else ub.doc-line.slt-pc).
     7018                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7019               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
     7020         assign
     7021           vat-cli-loc            = ?
     7022           slt-cli-loc            = ?
     7023           price-cli-with-tax-loc = ?.
     7024      end.
     7025      else do:
     7026                                                   for each in-vatp-parts where in-vatp-parts.out-code  = ub.doc-line.doc-code  and
     7027                                         in-vatp-parts.obj-type  = ub.doc-line.obj-type  and
     7028                                         in-vatp-parts.obj-code  = ub.doc-line.obj-code  and
     7029                                         in-vatp-parts.artic     = ub.doc-line.artic     and
     7030                                         in-vatp-parts.prod-type = ub.doc-line.prod-type and
     7031                                         in-vatp-parts.prod-code = ub.doc-line.prod-code
     7032                            use-index out-code no-lock:
     7033             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
     7034                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
     7035                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
     7036                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
     7037                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
     7038                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
     7039                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
     7040                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
     7041                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
