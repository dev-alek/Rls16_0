     6604   procedure print-header :
     6605   do
     6606   on error undo, return error
     6607   :
     6608       FIND ub.currency WHERE ub.currency.curr-code = t-doc.exch-code NO-LOCK.
     6609       assign val-str = ( if Invers then ub.currency.curr-abbr else ( if PrintRubl then "рублях" else "баз.вал" ) ).
     6610       FIND ub.pay-type WHERE ub.pay-type.obj-code = t-doc.pay-code NO-LOCK NO-ERROR .
     6611       if Invers then
     6612           FIND ub.clients WHERE ub.clients.obj-type = t-doc.cli-type AND
     6613                                           ub.clients.obj-code = t-doc.cli-code NO-LOCK .
     6614       else
     6615           FIND ub.clients WHERE ub.clients.obj-type = 'орг':U AND
     6616                                           ub.clients.obj-code = t-doc.host-code NO-LOCK .
     6617       case clients.obj-type:
     6618          when 'орг':U
     6619          then do:
     6620               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6621               if available ub.firm
     6622               then do:
     6623                   assign
     6624                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6625                       t-addres = t-addres
     6626                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6627                               then ""
     6628                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6629                             )
     6630                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6631                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6632                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6633                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6634                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6635                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6636                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6637                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6638                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6639                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6640                       t-phone = ub.firm.phone
     6641                       t-inn   = ub.firm.inn
     6642                       t-okpo  = ub.firm.okpo
     6643                   .
     6644               end.
     6645          end.
     6646          when 'маг':U
     6647          then do:
     6648               FIND ub.shop WHERE ub.shop.obj-code = clients.obj-code NO-LOCK .
     6649               if available ub.shop
     6650               then do:
     6651                   assign
     6652                       t-addres = ( if trim( shop.addres1 ) <> "" then ( trim( shop.addres1 ) ) else "" )
     6653                               + ( if trim( shop.addres2 ) <> "" then ( ", " + trim( shop.addres2 ) ) else "" )
     6654                       t-phone = shop.phone
     6655                       t-inn = ""
     6656                       t-okpo = ""
     6657                   .
     6658               end.
     6659          end.
     6660          when 'скл':U
     6661          then do:
     6662               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6663               if available ub.store
     6664               then do:
     6665                   assign
     6666                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6667                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6668                       t-phone = ub.store.phone
     6669                       t-inn = ""
     6670                       t-okpo = ""
     6671                   .
     6672               end.
     6673          end.
     6674          when 'чел':U
     6675          then do:
     6676               find ub.person where ub.person.psn-code = clients.obj-code no-lock .
     6677               if available ub.person
     6678               then do:
     6679                   assign
     6680                       t-addres = ( if ub.person.ind <> 0 and ub.person.ind <> ? then string( ub.person.ind ) else "" )
     6681                                   + ( if  ub.person.city <> ? and trim(ub.person.city) <> "" then ( ", " + trim( ub.person.city ) ) else "" )
     6682                                   + ( if  ub.person.address <> ? and trim(ub.person.address) <> "" then ( ", " + trim( ub.person.address ) ) else "" )
     6683                       t-phone = ub.person.phone1
     6684                       t-inn = ub.person.inn
     6685                       t-okpo = ub.person.okpo
     6686                   .
     6687               end.
     6688          end.
