     1772   procedure torgconf-get-sup-param :
     1773   define input parameter p-obj-type           as character        no-undo.
     1774   define input parameter p-obj-code           as integer          no-undo.
     1775   define input parameter p-curr-code          as integer          no-undo.
     1776       define variable v-host-code    as integer      no-undo.
     1777       define variable v-par-type     as character    no-undo.
     1778   do
     1779   on error undo, return error
     1780   :
     1781       assign
     1782          v-torgconf-sup-host-code = v-host-code
     1783       .
     1784       if v-torgconf-sup-host-code = 0
     1785       then do:
     1786           assign
     1787               v-torgconf-sup-host-name           = "":U
     1788               v-torgconf-sup-host-addres         = "":U
     1789               v-torgconf-sup-host-post-addres    = "":U
     1790               v-torgconf-sup-host-phone          = "":U
     1791               v-torgconf-sup-host-inn            = "":U
     1792               v-torgconf-sup-host-kpp            = "":U
     1793               v-torgconf-sup-host-okpo           = "":U
     1794               v-torgconf-sup-host-egrip-date     = "":U
     1795               v-torgconf-sup-host-egrip-num      = "":U
     1796           .
     1797       end.
     1798       else do:
     1799           run fmtcli-get-client in this-procedure (
     1800                 input 'орг':U
     1801               , input v-torgconf-sup-host-code
     1802           ).
     1803           assign
     1804               v-torgconf-sup-host-name        = v-fmtcli-name
     1805               v-torgconf-sup-host-engl-name   = v-fmtcli-engl-name
     1806               v-torgconf-sup-host-addres      = v-fmtcli-full-addres
     1807               v-torgconf-sup-host-post-addres = v-fmtcli-post-addres
     1808               v-torgconf-sup-host-phone       = v-fmtcli-phone
     1809               v-torgconf-sup-host-inn         = v-fmtcli-inn
     1810               v-torgconf-sup-host-kpp         = v-fmtcli-kpp
     1811               v-torgconf-sup-host-okpo        = v-fmtcli-okpo
     1812           .
     1813           run gbl/clntat-v.p (
     1814                 input 'орг':U
     1815               , input v-torgconf-sup-host-code
     1816               , input 'egrip-date':U
     1817               , output v-torgconf-sup-host-egrip-date
     1818               , output v-par-type
     1819           ).
     1820           run gbl/clntat-v.p (
     1821                 input 'орг':U
     1822               , input v-torgconf-sup-host-code
     1823               , input 'egrip-num':U
     1824               , output v-torgconf-sup-host-egrip-num
     1825               , output v-par-type
     1826           ).
     1827           run fmtcli-get-bank in this-procedure (
     1828                 input v-host-code
     1829               , input 'орг':U
     1830               , input v-torgconf-sup-host-code
     1831               , input p-curr-code
     1832           ).
     1833       end.
     1834       assign
     1835           v-torgconf-sup-schet-exists = v-fmtcli-schet-exists
     1836           v-torgconf-sup-bank-exists  = v-fmtcli-bank-exists
     1837           v-torgconf-sup-bank-r-schet = v-fmtcli-bank-r-schet
     1838           v-torgconf-sup-bank-c-schet = v-fmtcli-bank-c-schet
     1839           v-torgconf-sup-bank-bik     = v-fmtcli-bank-bik
     1840           v-torgconf-sup-bank-name    = v-fmtcli-bank-name
     1841           v-torgconf-sup-bank-addres  = v-fmtcli-bank-addres
     1842           v-torgconf-sup-bank-city    = v-fmtcli-bank-city
     1843       .
     1844       assign
     1845           v-torgconf-sup-obj-type = p-obj-type
     1846           v-torgconf-sup-obj-code = p-obj-code
     1847       .
     1848       if trim(p-obj-type) <> ""
     1849       and p-obj-code <> 0
     1850       then do:
     1851       run fmtcli-get-client in this-procedure (
     1852             input p-obj-type
     1853           , input p-obj-code
     1854       ).
     1855       assign
     1856           v-torgconf-sup-obj-name        = v-fmtcli-name
     1857           v-torgconf-sup-obj-engl-name   = v-fmtcli-engl-name
     1858           v-torgconf-sup-obj-addres      = v-fmtcli-full-addres
     1859           v-torgconf-temp-post-addres    = v-fmtcli-post-addres
     1860           v-torgconf-sup-obj-phone       = v-fmtcli-phone
     1861           v-torgconf-sup-obj-inn         = v-fmtcli-inn
     1862           v-torgconf-sup-obj-okpo        = v-fmtcli-okpo
     1863       .
     1864      end.
     1865      end.
     1866   end procedure.
     1867   procedure torgconf-get-cli-param :
     1868   define input parameter p-host-obj-code      as integer          no-undo.
     1869   define input parameter p-obj-type           as character        no-undo.
