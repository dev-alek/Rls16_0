     4920           do:
     4921               put stream out-stream v-single-line format "x(198)" skip.
     4922               if v-torgconf-outt12 = yes
     4923               then do:
     4924                   display stream out-stream
     4925                       "Итого" @ ub.goods.gds-name
     4926                       Pg-tqnty @ tqnty
     4927                       Pg-stoim-noNDS @ stoim-noNDS
     4928                       Pg-VAT-gds  @ VAT-gds
     4929                       Pg-stoim @ stoim
     4930                   with frame f-doc-m .
     4931                   down stream out-stream 1 with frame f-doc-m .
     4932               end.
     4933               else do:
