     5141                       , output v-void-decimal
     5142                       , output v-void-decimal
     5143                       , output SLT-gds
     5144                       , output v-void-decimal
     5145                       , output v-void-decimal
     5146                       , output price-withNDS
     5147                   ).
     5148                   if VAT-gds = ? then VAT-gds = 0.
     5149                   if SLT-gds = ? then SLT-gds = 0.
