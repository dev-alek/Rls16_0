      261   define variable v-fmtcli-bank-exists   as logical      no-undo.
      262   define variable v-fmtcli-bank-r-schet  as character    no-undo.
      263   define variable v-fmtcli-bank-c-schet  as character    no-undo.
      264   define variable v-fmtcli-bank-bik      as character    no-undo.
      265   define variable v-fmtcli-bank-name     as character    no-undo.
      266   define variable v-fmtcli-bank-addres   as character    no-undo.
      267   define variable v-fmtcli-bank-city     as character    no-undo.
      268   procedure fmtcli-get-bank :
      269   define input parameter p-host-code      as integer          no-undo.
      270   define input parameter p-obj-type       as character        no-undo.
      271   define input parameter p-obj-code       as integer          no-undo.
      272   define input parameter p-curr-code      as integer          no-undo.
      273       define buffer buf_fin-schet     for ub.fin-schet.
      274       define buffer buf_fin-bank      for ub.fin-bank.
      275   do
      276   for buf_fin-schet
      277     , buf_fin-bank
      278   on error undo, return error
      279   :
      280       assign
      281           v-fmtcli-schet-exists       = no
      282           v-fmtcli-bank-exists        = no
      283           v-fmtcli-bank-r-schet       = "":U
      284           v-fmtcli-bank-c-schet       = "":U
      285           v-fmtcli-bank-bik           = "":U
      286           v-fmtcli-bank-name          = "":U
      287           v-fmtcli-bank-addres        = "":U
      288           v-fmtcli-bank-city          = "":U
      289       .
      290       search-for-schet:
      291       for each buf_fin-schet no-lock
      292          where buf_fin-schet.host-code = p-host-code
      293            and buf_fin-schet.cli-type  = p-obj-type
      294            and buf_fin-schet.cli-code  = p-obj-code
      295            and buf_fin-schet.curr-code = p-curr-code
      296       on error undo, return error
      297       :
      298           if buf_fin-schet.status_   = 'удал':U
      299           then do:
      300           end.
      301           else do:
      302               assign
      303                   v-fmtcli-schet-exists   = yes
      304                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
      305                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
      306               .
      307               find first buf_fin-bank no-lock
      308                    where buf_fin-bank.host-code = p-host-code
      309                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
      310               no-error.
      311               if available buf_fin-bank
      312               then do:
      313                   assign
      314                       v-fmtcli-bank-exists      = yes
      315                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
      316                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
      317                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
      318                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
      319                   .
      320               end.
      321               else do:
      322                   assign
      323                       v-fmtcli-bank-exists    = no
      324                       v-fmtcli-bank-bik       = "":U
      325                       v-fmtcli-bank-name      = "":U
      326                       v-fmtcli-bank-addres    = "":U
      327                       v-fmtcli-bank-city      = "":U
      328                   .
      329               end.
      330               leave search-for-schet.
      331           end.
      332       end.
      333   end.
      334   end procedure.
      335   procedure fmtcli-get-client :
      336   define input parameter p-obj-type       as character    no-undo.
      337   define input parameter p-obj-code       as integer      no-undo.
      338       define variable v-temp-fmtcli-address      as character     no-undo.
      339       define variable v-num-country-city    as integer      no-undo.
      340       define buffer buf_clients   for ub.clients.
      341       define buffer buf_firm      for ub.firm.
      342       define buffer buf_store     for ub.store.
      343       define buffer buf_shop      for ub.shop.
      344       define buffer buf_person    for ub.person.
      345   do
      346   for buf_clients
      347     , buf_firm
      348     , buf_store
      349     , buf_shop
      350     , buf_person
      351   on error undo, return error
      352   :
      353       assign
      354           v-fmtcli-name           = "":U
      355           v-fmtcli-addres         = "":U
      356           v-fmtcli-post-addres    = "":U
      357           v-fmtcli-full-addres    = "":U
      358           v-fmtcli-phone          = "":U
      359           v-fmtcli-inn            = "":U
      360           v-fmtcli-kpp            = "":U
      361           v-fmtcli-okpo           = "":U
      362           v-fmtcli-city           = "":U
      363           v-fmtcli-index          = "":U
      364           v-fmtcli-country        = "":U
      365       .
      366       find first buf_clients no-lock
      367            where buf_clients.obj-type = p-obj-type
      368              and buf_clients.obj-code = p-obj-code
      369       .
      370       assign
      371           v-fmtcli-name = buf_clients.obj-name
      372       .
      373       case buf_clients.obj-type:
      374          when 'орг':U
      375          then do:
      376               find first buf_firm no-lock
      377                    where buf_firm.firm-code = buf_clients.obj-code
      378                    no-error
      379               .
      380               if available buf_firm
      381               then do:
      382                   assign
      383                       v-num-country-city = num-entries( buf_firm.city )
      384                       v-fmtcli-engl-name = buf_firm.engl-name
      385                   .
      386                   if v-num-country-city > 0
      387                   then do:
      388                       assign
      389                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
      390                       .
      391                   end.
      392                   if v-num-country-city > 1
      393                   then do:
      394                       assign
      395                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
      396                       .
      397                   end.
      398                   run fmtcli-concatenate-strings in this-procedure (
      399                         input v-fmtcli-full-addres
      400                       , input v-fmtcli-country
      401                       , input ", ":U
      402                       , input 50
      403                       , output v-fmtcli-full-addres
      404                   ).
      405                   run fmtcli-concatenate-strings in this-procedure (
      406                         input v-fmtcli-full-addres
      407                       , input v-fmtcli-city
      408                       , input ", ":U
      409                       , input 50
      410                       , output v-fmtcli-full-addres
      411                   ).
      412                   run fmtcli-concatenate-strings in this-procedure (
      413                         input v-fmtcli-full-addres
      414                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
      415                       , input ", ":U
      416                       , input 50
      417                       , output v-fmtcli-full-addres
      418                   ).
      419                   run fmtcli-concatenate-strings in this-procedure (
      420                         input v-fmtcli-post-addres
      421                       , input v-fmtcli-country
      422                       , input ", ":U
      423                       , input 50
      424                       , output v-fmtcli-post-addres
      425                   ).
      426                   run fmtcli-concatenate-strings in this-procedure (
      427                         input v-fmtcli-post-addres
      428                       , input v-fmtcli-city
      429                       , input ", ":U
      430                       , input 50
      431                       , output v-fmtcli-post-addres
      432                   ).
      433                   run fmtcli-concatenate-strings in this-procedure (
      434                         input v-fmtcli-post-addres
      435                       , input string( buf_firm.ind )
      436                       , input ", ":U
      437                       , input 50
      438                       , output v-fmtcli-post-addres
      439                   ).
      440                   run fmtcli-concatenate-strings in this-procedure (
      441                         input substring( buf_firm.addres1, 1, 50 )
      442                       , input buf_firm.addres2
      443                       , input " ":U
      444                       , input 50
      445                       , output v-temp-fmtcli-address
      446                   ).
      447                   run fmtcli-concatenate-strings in this-procedure (
      448                         input v-temp-fmtcli-address
      449                       , input substring( buf_firm.addres1, 51, 50 )
      450                       , input " ":U
      451                       , input 50
      452                       , output v-temp-fmtcli-address
      453                   ).
      454                   run fmtcli-concatenate-strings in this-procedure (
      455                         input v-temp-fmtcli-address
      456                       , input substring( buf_firm.addres1, 101, 50 )
      457                       , input " ":U
      458                       , input 50
      459                       , output v-temp-fmtcli-address
      460                   ).
      461                   assign
      462                       v-fmtcli-addres = v-temp-fmtcli-address
      463                   .
      464                   if buf_firm.addres1 <> ?
      465                   then do:
      466                       run fmtcli-concatenate-strings in this-procedure (
      467                             input v-fmtcli-full-addres
      468                           , input v-fmtcli-addres
      469                           , input ", ":U
      470                           , input 0
      471                           , output v-fmtcli-full-addres
      472                       ).
      473                   end.
      474                   run fmtcli-concatenate-strings in this-procedure (
      475                         input substring( buf_firm.post-addr1, 1, 50 )
      476                       , input buf_firm.post-addr2
      477                       , input " ":U
      478                       , input 50
      479                       , output v-fmtcli-post-addres
      480                   ).
      481                   run fmtcli-concatenate-strings in this-procedure (
      482                         input v-fmtcli-post-addres
      483                       , input substring( buf_firm.post-addr1, 51, 50 )
      484                       , input " ":U
      485                       , input 50
      486                       , output v-fmtcli-post-addres
      487                   ).
      488                   run fmtcli-concatenate-strings in this-procedure (
      489                         input v-fmtcli-post-addres
      490                       , input substring( buf_firm.post-addr1, 101, 50 )
      491                       , input " ":U
      492                       , input 50
      493                       , output v-fmtcli-post-addres
      494                   ).
      495                   assign
      496                       v-fmtcli-phone         = buf_firm.phone
      497                       v-fmtcli-inn           = buf_firm.inn
      498                       v-fmtcli-kpp           = buf_firm.kpp
      499                       v-fmtcli-okpo          = buf_firm.okpo
      500                       v-fmtcli-index         = string( buf_firm.ind )
      501                   .
      502               end.
      503          end.
      504          when 'маг':U
      505          then do:
      506               find first buf_shop no-lock
      507                    where buf_shop.obj-code = buf_clients.obj-code
      508               .
      509               if available buf_shop
      510               then do:
      511                   run fmtcli-concatenate-strings in this-procedure (
      512                         input buf_shop.addres1
      513                       , input buf_shop.addres2
      514                       , input " ":U
      515                       , input 50
      516                       , output v-fmtcli-addres
      517                   ).
      518                   assign
      519                       v-fmtcli-full-addres = v-fmtcli-addres
      520                       v-fmtcli-post-addres = v-fmtcli-addres
      521                       v-fmtcli-phone       = buf_shop.phone
      522                       v-fmtcli-inn         = "":U
      523                       v-fmtcli-kpp         = "":U
      524                       v-fmtcli-okpo        = "":U
      525                       v-fmtcli-city        = "":U
      526                       v-fmtcli-index       = "":U
      527                   .
      528               end.
      529          end.
      530          when 'скл':U
      531          then do:
      532               find first buf_store no-lock
      533                    where buf_store.obj-code = buf_clients.obj-code
      534               .
      535               if available buf_store
      536               then do:
      537                   run fmtcli-concatenate-strings in this-procedure (
      538                         input buf_store.addres1
      539                       , input buf_store.addres2
      540                       , input " ":U
      541                       , input 50
      542                       , output v-fmtcli-addres
      543                   ).
      544                   assign
      545                       v-fmtcli-full-addres = v-fmtcli-addres
      546                       v-fmtcli-phone       = buf_store.phone
      547                       v-fmtcli-inn         = "":U
      548                       v-fmtcli-kpp         = "":U
      549                       v-fmtcli-okpo        = "":U
      550                       v-fmtcli-city        = "":U
      551                       v-fmtcli-index       = "":U
      552                   .
      553               end.
      554          end.
      555          when 'чел':U
      556          then do:
      557               find first buf_person no-lock
      558                    where buf_person.psn-code = buf_clients.obj-code
      559               .
      560               if available buf_person
      561               then do:
      562                   run fmtcli-concatenate-strings in this-procedure (
      563                         input ( if buf_person.ind = 0 or buf_person.ind = ?
      564                                 then "":U
      565                                 else string( buf_person.ind, "999999")
      566                                 )
      567                       , input buf_person.city
      568                       , input ", ":U
      569                       , input 0
      570                       , output v-fmtcli-full-addres
      571                   ).
      572                   assign
      573                       v-fmtcli-addres = buf_person.address
      574                   .
      575                   run fmtcli-concatenate-strings in this-procedure (
      576                         input v-fmtcli-full-addres
      577                       , input v-fmtcli-addres
      578                       , input ", ":U
      579                       , input 0
      580                       , output v-fmtcli-full-addres
      581                   ).
      582                   assign
      583                       v-fmtcli-phone     = buf_person.phone1
      584                       v-fmtcli-inn       = buf_person.inn
      585                       v-fmtcli-kpp       = buf_person.kpp
      586                       v-fmtcli-okpo      = buf_person.okpo
      587                       v-fmtcli-city      = buf_person.city
      588                       v-fmtcli-index     = string( buf_person.ind )
      589                   .
      590               end.
      591          end.
      592       end case.
      593   end.
      594   end procedure.
      595   procedure fmtcli-concatenate-strings :
      596   define input parameter p-string-1       as character        no-undo.
      597   define input parameter p-string-2       as character        no-undo.
      598   define input parameter p-delimiter      as character        no-undo.
      599   define input parameter p-length         as integer          no-undo.
      600   define output parameter p-out-string    as character        no-undo.
      601   do
      602   on error undo, return error
      603   :
      604       assign
      605           p-out-string = ( if p-string-1 = ?
      606                            then "":U
      607                            else trim( p-string-1 ) )
      608       .
      609       assign
      610           p-out-string = p-out-string
      611                        + ( if p-out-string = "":U
      612                            or length( p-out-string ) = p-length
      613                            or p-string-2 = ?
      614                            or trim( p-string-2 ) = "":U
      615                            then "":U
      616                            else p-delimiter )
      617                        + ( if p-string-2 = ?
      618                            or trim( p-string-2 ) = "":U
      619                            then "":U
      620                            else trim( p-string-2 ) )
      621       .
      622   end.
      623   end procedure.
