     4636                                   + string( month( t-doc.doc-date ),  "99" )
     4637                                   + string( day( t-doc.doc-date ),    "99" )
     4638               .
     4639           end.
     4640           else do:
     4641               assign tdoc-code = string( month( t-doc.doc-date ), ">9" )
     4642                                   + trim( string( day( t-doc.doc-date ), ">9" ) )
     4643                                   + string( integer( tdoc-code ))
     4644               .
