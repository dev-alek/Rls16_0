     1912   procedure torgconf-get-ship-param :
     1913   define input parameter p-host-obj-code      as integer          no-undo.
     1914   define input parameter p-obj-type           as character        no-undo.
     1915   define input parameter p-obj-code           as integer          no-undo.
     1916   define input parameter p-curr-code          as integer          no-undo.
     1917       define variable v-host-code    as integer      no-undo.
     1918   do
     1919   on error undo, return error
     1920   :
     1921       assign
     1922           v-torgconf-ship-type = p-obj-type
     1923           v-torgconf-ship-code = p-obj-code
     1924       .
     1925       if trim(p-obj-type) = ""
     1926       and p-obj-code = 0
     1927       then do:
     1928       assign
     1929           v-torgconf-ship-name         = "":U
     1930           v-torgconf-ship-addres       = "":U
     1931           v-torgconf-ship-post-addres  = "":U
     1932           v-torgconf-ship-phone        = "":U
     1933           v-torgconf-ship-inn          = "":U
     1934           v-torgconf-ship-kpp          = "":U
     1935           v-torgconf-ship-okpo         = "":U
     1936       .
     1937       end.
     1938       else do:
     1939       run fmtcli-get-client in this-procedure (
     1940             input p-obj-type
     1941           , input p-obj-code
     1942       ).
     1943       assign
     1944           v-torgconf-ship-name         = trim( v-fmtcli-name          )
     1945           v-torgconf-ship-engl-name    = trim( v-fmtcli-engl-name          )
     1946           v-torgconf-ship-addres       = trim( v-fmtcli-full-addres   )
     1947           v-torgconf-ship-post-addres  = trim( v-fmtcli-post-addres   )
     1948           v-torgconf-ship-phone        = trim( v-fmtcli-phone         )
     1949           v-torgconf-ship-inn          = trim( v-fmtcli-inn           )
     1950           v-torgconf-ship-kpp          = trim( v-fmtcli-kpp           )
     1951           v-torgconf-ship-okpo         = trim( v-fmtcli-okpo          )
     1952       .
     1953       end.
     1954           run fmtcli-get-bank in this-procedure (
     1955             input p-host-obj-code
     1956           , input p-obj-type
     1957           , input p-obj-code
     1958           , input p-curr-code
     1959       ).
     1960       assign
     1961           v-torgconf-ship-schet-exists = v-fmtcli-schet-exists
     1962           v-torgconf-ship-bank-exists  = v-fmtcli-bank-exists
     1963           v-torgconf-ship-bank-r-schet = v-fmtcli-bank-r-schet
     1964           v-torgconf-ship-bank-c-schet = v-fmtcli-bank-c-schet
     1965           v-torgconf-ship-bank-bik     = v-fmtcli-bank-bik
     1966           v-torgconf-ship-bank-name    = v-fmtcli-bank-name
     1967           v-torgconf-ship-bank-addres  = v-fmtcli-bank-addres
     1968           v-torgconf-ship-bank-city    = v-fmtcli-bank-city
     1969       .
     1970   end.
     1971   end procedure.
     1972   procedure torgconf-get-holdfirm-code :
     1973   define input parameter p-obj-type   as character        no-undo.
     1974   define input parameter p-obj-code   as integer          no-undo.
     1975   define output parameter p-firm-code as integer          no-undo.
     1976       define variable v-firm-code-str     as character    no-undo.
     1977       define variable v-par-type          as character    no-undo.
     1978       define buffer buf_clients       for ub.clients.
     1979   do
     1980   for buf_clients
     1981   on error undo, return error
     1982   :
     1983       run gbl/clntat-v.p (
     1984             input p-obj-type
     1985           , input p-obj-code
     1986           , input 'holdfirm-code':U
     1987           , output v-firm-code-str
     1988           , output v-par-type
     1989       ).
     1990       assign
     1991           p-firm-code = integer( v-firm-code-str )
     1992       no-error.
     1993       if error-status :error
     1994       then do:
     1995           message
     1996               "Неверно задан код фирмы для печати накладных."
     1997           view-as alert-box warning.
     1998           assign
     1999               p-firm-code = 0
     2000           .
     2001       end.
     2002       else do:
     2003           find first buf_clients no-lock
     2004                where buf_clients.obj-type = 'орг':U
     2005                  and buf_clients.obj-code = p-firm-code
     2006           no-error.
     2007           if not available buf_clients
     2008           then do:
     2009               message
     2010                   "Включен параметр 'Список печатных форм, для которых должна быть задана фирма для печати накладных' (outhold)" skip
     2011                   "Не найдена фирма по заданному коду фирмы для печати накладных."
     2012               view-as alert-box warning.
     2013               assign
     2014                   p-firm-code = 0
     2015               .
     2016           end.
     2017       end.
     2018   end.
     2019   end procedure.
     2020   procedure torgconf-get-post-head:
     2021   define input  parameter p-obj-type             as character        no-undo.
     2022   define input  parameter p-obj-code             as integer          no-undo.
     2023   define output parameter p-torgconf-post-head   as character        no-undo.
     2024      define variable v-host-code         as integer      no-undo.
     2025      define buffer buf_sysconf     for ub.sysconf.
     2026        assign
     2027         p-torgconf-post-head  = ""
     2028        .
     2029   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2030   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2031     (input  p-obj-type
     2032     ,input  p-obj-code
     2033     ,output v-host-code
     2034     )  .
     2035      find first buf_sysconf no-lock
     2036      where buf_sysconf.host-code = v-host-code
     2037      no-error.
     2038      if available buf_sysconf
     2039      then do:
     2040         assign
     2041            p-torgconf-post-head = buf_sysconf.head-position
     2042         .
     2043      end.
     2044   end procedure.
     2045   procedure torgconf-get-storekeeper:
     2046   define input  parameter p-wrkr                   as integer          no-undo.
     2047   define output parameter p-torgconf-wrkr-name     as character        no-undo.
     2048   define output parameter p-torgconf-post          as character        no-undo.
     2049      define buffer buf_sysconf     for ub.sysconf.
     2050      define buffer buf_person      for ub.person.
     2051      define buffer buf_shop        for ub.shop .
     2052      define buffer buf_store       for ub.store .
     2053      if v-torgconf-outC = "no_print"
     2054      then do:
     2055         assign p-torgconf-post = ""
     2056                p-torgconf-wrkr-name = ""
     2057                .
     2058      end.
     2059      if v-torgconf-outC = "clad_doc"
     2060      then do:
     2061         run rep/get-psn.p
     2062               (input  p-wrkr
     2063               ,output p-torgconf-wrkr-name
     2064               ) .
     2065         find first buf_person no-lock
     2066         where buf_person.psn-code = p-wrkr
     2067         no-error.
     2068         if available buf_person
     2069         then do:
     2070           p-torgconf-post = buf_person.position.
     2071         end.
     2072         if p-torgconf-post = "?":U then p-torgconf-post = "".
     2073         if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2074      end.
     2075      if v-torgconf-outC = "clad_obj"
     2076      then do:
     2077         CASE v-torgconf-self-obj-type:
     2078         WHEN 'маг':U
     2079         THEN DO:
     2080            find first buf_shop no-lock
     2081            where buf_shop.obj-code = v-torgconf-self-obj-code
     2082            .
     2083            assign
     2084               p-torgconf-wrkr-name = buf_shop.store-man
     2085               p-torgconf-post = ""
     2086            .
     2087            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2088         END.
     2089         WHEN 'скл':U
     2090         THEN DO:
     2091            find first buf_store no-lock
     2092            where buf_store.obj-code = v-torgconf-self-obj-code
     2093            .
     2094            assign
     2095               p-torgconf-wrkr-name = buf_store.store-man
     2096               p-torgconf-post = ""
     2097            .
     2098            if p-torgconf-wrkr-name = "?":U then p-torgconf-wrkr-name = "".
     2099         END.
     2100         OTHERWISE DO:
     2101            assign
     2102               p-torgconf-post = "":U
     2103               p-torgconf-wrkr-name = "":U
     2104            .
     2105         END.
     2106         END CASE.
     2107      end.
     2108    end procedure.
     2109   procedure torgconf-get-form-header :
     2110   define input parameter p-for-inverse    as logical          no-undo.
     2111   define input parameter p-doc-code       as character        no-undo.
     2112   define input parameter p-print-doc      as logical          no-undo.
     2113   define input parameter p-doc-date       as date             no-undo.
     2114   define input parameter p-fact-date      as date             no-undo.
     2115   define input parameter p-doc-type       as character        no-undo.
     2116   define input parameter p-status_        as character        no-undo.
     2117   define input parameter p-reverse        as logical          no-undo.
     2118   define input parameter p-sf-par         as logical          no-undo.
     2119       define variable v-attr-type         as character    no-undo.
     2120       define variable v-doc-code-standard as logical      no-undo.
     2121       define variable v-doc-date-standard as logical      no-undo.
     2122       define variable v-par-consignee-addres  as character    no-undo.
     2123       define variable v-host-code         as integer      no-undo.
     2124       define variable v-dcode-attr        as character    no-undo.
     2125       define variable v-ddate-attr        as character    no-undo.
     2126       define variable v-doc-date          as character    no-undo.
     2127       define variable v-doc-code          as character    no-undo.
     2128       define variable v-par-type          as character    no-undo.
     2129       define variable v-attr              as character    no-undo.
     2130       define buffer buf_firm          for ub.firm .
     2131       define buffer buf_clients       for ub.clients .
     2132       define buffer buf_sysconf       for ub.sysconf .
     2133       define buffer buf_shop          for ub.shop .
     2134       define buffer buf_store         for ub.store .
     2135       define buffer buf_person        for ub.person .
     2136       define buffer buf_trn-doc       for ub.trn-doc .
     2137       define buffer buf_wth-doc       for ub.wth-doc .
     2138       do
     2139   for buf_firm
     2140     , buf_clients
     2141     , buf_sysconf
     2142     , buf_shop
     2143     , buf_trn-doc
     2144     , buf_person
     2145     , buf_wth-doc
     2146   on error undo, return error
     2147   :
     2148       if p-doc-type = 'при':U
     2149       or p-doc-type = 'возврат':U
     2150       then do:
     2151           assign
     2152               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2153                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2154               v-torgconf-suppi            = substitute( "&1&2&3&4&5", v-torgconf-cli-name, ( if v-torgconf-cli-addres = "":U then "":U else ", " ),
     2155                                             v-torgconf-cli-addres, ( if v-torgconf-cli-phone = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2156               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ),
     2157                                             v-torgconf-self-host-addres, ( if v-torgconf-self-host-phone = "":U then "":U else ", " ),v-torgconf-self-host-phone )
     2158               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-sup-host-name, ( if v-torgconf-sup-host-addres = "":U then "":U else ", " ),
     2159                                             v-torgconf-sup-host-addres, ( if v-torgconf-sup-host-phone = "":U then "":U else ", " ), v-torgconf-sup-host-phone  )
     2160               v-torgconf-supplier-okpo    = v-torgconf-cli-okpo
     2161               v-torgconf-saler-okpo       = v-torgconf-self-host-okpo
     2162               v-torgconf-consignee-okpo   = v-torgconf-sup-host-okpo
     2163               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-cli-code         )
     2164               v-torgconf-supplier-type    = v-torgconf-cli-type
     2165               v-torgconf-saler-code       = substitute( "&1", v-torgconf-self-host-code   )
     2166               v-torgconf-saler-type       = v-torgconf-self-host-type
     2167               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-sup-host-code   )
     2168               v-torgconf-consignee-type   = v-torgconf-sup-host-type
     2169               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-cli-name         )
     2170               v-torgconf-saler-name       = substitute( "&1", v-torgconf-self-host-name   )
     2171               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-sup-host-name   )
     2172               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-cli-addres       )
     2173               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-self-host-addres )
     2174               v-torgconf-consignee-addr   = substitute( "&1", v-torgconf-sup-host-addres )
     2175               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-cli-inn          )
     2176               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-cli-engl-name          )
     2177               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-self-host-inn    )
     2178               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-sup-host-inn    )
     2179               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-cli-kpp          )
     2180               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-self-host-kpp    )
     2181               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-sup-host-kpp    )
     2182           .
     2183           if v-torgconf-cli-schet-exists = yes
     2184           AND v-form-name                  = "torg12":U
     2185           then do:
     2186               assign
     2187                   v-torgconf-supplier = v-torgconf-supplier
     2188                       + substitute( ", р/с &1 к/с &2"
     2189                                   , v-torgconf-cli-bank-r-schet
     2190                                   , v-torgconf-cli-bank-c-schet
     2191                                   )
     2192                   v-torgconf-suppi = v-torgconf-supplier
     2193                       + substitute( ", р/с &1 к/с &2"
     2194                                   , v-torgconf-cli-bank-r-schet
     2195                                   , v-torgconf-cli-bank-c-schet
     2196                                   )
     2197               .
     2198               if v-torgconf-cli-bank-exists = yes
     2199               then do:
     2200                   assign
     2201                       v-torgconf-supplier = v-torgconf-supplier
     2202                           + substitute( " БИК &1 в &2 &3"
     2203                                       , v-torgconf-cli-bank-bik
     2204                                       , v-torgconf-cli-bank-name
     2205                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2206                                       )
     2207                      v-torgconf-suppi = v-torgconf-supplier
     2208                           + substitute( " БИК &1 в &2 &3"
     2209                                       , v-torgconf-cli-bank-bik
     2210                                       , v-torgconf-cli-bank-name
     2211                                       ,(if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2212                                       )
     2213                   .
     2214               end.
     2215           end.
     2216           if v-torgconf-self-schet-exists = yes
     2217           AND v-form-name                  = "torg12":U
     2218           then do:
     2219               assign
     2220                   v-torgconf-saler = v-torgconf-saler
     2221                       + substitute( ", р/с &1 к/с &2"
     2222                                   , v-torgconf-self-bank-r-schet
     2223                                   , v-torgconf-self-bank-c-schet
     2224                                   )
     2225               .
     2226               if v-torgconf-self-bank-exists = yes
     2227               then do:
     2228                   assign
     2229                       v-torgconf-saler = v-torgconf-saler
     2230                           + substitute( " БИК &1 в &2 &3"
     2231                                       , v-torgconf-self-bank-bik
     2232                                       , v-torgconf-self-bank-name
     2233                                       , v-torgconf-self-bank-addres
     2234                                       )
     2235                   .
     2236               end.
     2237           end.
     2238           if v-torgconf-sup-schet-exists = yes
     2239           AND v-form-name                  = "torg12":U
     2240           then do:
     2241               assign
     2242                   v-torgconf-consignee = v-torgconf-consignee
     2243                       + substitute( ", р/с &1 к/с &2"
     2244                                   , v-torgconf-sup-bank-r-schet
     2245                                   , v-torgconf-sup-bank-c-schet
     2246                                   )
     2247               .
     2248             if v-torgconf-sup-bank-exists = yes
     2249              then do:
     2250                assign
     2251                   v-torgconf-consignee = v-torgconf-consignee
     2252                           + substitute( " БИК &1 в &2 &3"
     2253                                       , v-torgconf-sup-bank-bik
     2254                                       , v-torgconf-sup-bank-name
     2255                                       , v-torgconf-sup-bank-addres
     2256                                       )
     2257                   .
     2258               end.
     2259           end.
     2260      if v-torgconf-outares = yes  AND v-form-name  = "torg12":U
     2261      then do:
     2262          assign
     2263            v-torgconf-supplier = substitute(  "&1&2&3 &4 &5&6"
     2264                                                   , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2265                                                   , v-torgconf-cli-name
     2266                                                   , ( if v-torgconf-outprncd = yes
     2267                                                         then substitute( " (&1)", v-torgconf-cli-code )
     2268                                                         else "":U )
     2269                                                   , v-torgconf-cli-post-addres
     2270                                                   , v-torgconf-cli-phone
     2271                                                   , ( if v-torgconf-cli-bank-r-schet <> "":U
     2272                                                       AND v-form-name                  = "torg12":U
     2273                                                         then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2274                                                               , v-torgconf-cli-bank-r-schet
     2275                                                               , v-torgconf-cli-bank-c-schet
     2276                                                               , v-torgconf-cli-bank-bik
     2277                                                               , v-torgconf-cli-bank-name
     2278                                                               , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )     )
     2279                                                         else "":U )
     2280                                                )
     2281         .
     2282      end.
     2283       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2284                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-cli-inn, v-torgconf-cli-kpp) ELSE "":U
     2285                                        , v-torgconf-cli-name
     2286                                        , ( if v-torgconf-outprncd = yes
     2287                                            then substitute( " (&1)", v-torgconf-cli-code )
     2288                                            else "":U )
     2289                                        , v-torgconf-cli-addres
     2290                                        , v-torgconf-cli-phone
     2291                                        , ( if v-torgconf-cli-bank-r-schet <> "":U
     2292                                            AND v-form-name                  = "torg12":U
     2293                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2294                                                           , v-torgconf-cli-bank-r-schet
     2295                                                           , v-torgconf-cli-bank-c-schet
     2296                                                           , v-torgconf-cli-bank-bik
     2297                                                           , v-torgconf-cli-bank-name
     2298                                                           , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) ))
     2299                                                   else "":U )
     2300                                        ).
     2301       end.
     2302       else do:
     2303       v-torgconf-suppi = substitute(  "&1&2&3 &4 &5&6"
     2304                                        , IF v-form-name = "torg12":U THEN SUBSTITUTE("ИНН &1 КПП &2 ", v-torgconf-self-host-inn, v-torgconf-self-host-kpp) ELSE "":U
     2305                                        , v-torgconf-self-host-name
     2306                                        , ( if v-torgconf-outprncd = yes
     2307                                            then substitute( " (&1)", v-torgconf-self-host-code )
     2308                                            else "":U )
     2309                                        , v-torgconf-self-host-addres
     2310                                        , v-torgconf-self-host-phone
     2311                                        , ( if v-torgconf-self-bank-r-schet <> "":U
     2312                                            AND v-form-name                  = "torg12":U
     2313                                            then substitute( ", р/с &1 к/с &2, БИК &3 в &4, &5"
     2314                                                           , v-torgconf-self-bank-r-schet
     2315                                                           , v-torgconf-self-bank-c-schet
     2316                                                           , v-torgconf-self-bank-bik
     2317                                                           , v-torgconf-self-bank-name
     2318                                                           , (if v-torgconf-self-bank-city = "":U then "":U else ( "г. " + v-torgconf-self-bank-city) )     )
     2319                                                   else "":U )
     2320                                           ).
     2321         if v-torgconf-outares = yes
     2322         and p-reverse = no
     2323         then do:
     2324            assign
     2325               v-par-consignee-addres = v-torgconf-ship-post-addres
     2326            .
     2327         end.
     2328         if v-torgconf-outares = no
     2329         and p-reverse = no
     2330         then do:
     2331            assign
     2332               v-par-consignee-addres = v-torgconf-ship-addres
     2333            .
     2334         end.
     2335         if p-reverse = yes
     2336         then do:
     2337             assign
     2338               v-par-consignee-addres = v-torgconf-ship-addres
     2339             .
     2340         end.
     2341           assign
     2342               v-torgconf-supplier         = substitute( "&1&2&3&4&5", v-torgconf-self-host-name, ( if v-torgconf-self-host-addres = "":U then "":U else ", " ), v-torgconf-self-host-addres,
     2343                                             ( if v-torgconf-self-host-phone = "":U then "":U else ", " ), v-torgconf-self-host-phone )
     2344               v-torgconf-saler            = substitute( "&1&2&3&4&5", v-torgconf-cli-name      , ( if v-torgconf-cli-addres       = "":U then "":U else ", " ), v-torgconf-cli-addres,
     2345                                             ( if v-torgconf-cli-phone       = "":U then "":U else ", " ), v-torgconf-cli-phone )
     2346               v-torgconf-consignee        = substitute( "&1&2&3&4&5", v-torgconf-ship-name      , ( if v-par-consignee-addres   = "":U then "":U else ", " ), v-par-consignee-addres,
     2347                                              ( if v-torgconf-ship-phone   = "":U then "":U else ", " ), v-torgconf-ship-phone)
     2348               v-torgconf-supplier-okpo    = v-torgconf-self-host-okpo
     2349               v-torgconf-saler-okpo       = v-torgconf-cli-okpo
     2350               v-torgconf-consignee-okpo   = v-torgconf-ship-okpo
     2351               v-torgconf-supplier-code    = substitute( "&1", v-torgconf-self-host-code   )
     2352               v-torgconf-supplier-code    = v-torgconf-self-host-type
     2353               v-torgconf-saler-code       = substitute( "&1", v-torgconf-cli-code         )
     2354               v-torgconf-saler-type       = v-torgconf-cli-type
     2355               v-torgconf-consignee-code   = substitute( "&1", v-torgconf-ship-code         )
     2356               v-torgconf-consignee-type   = v-torgconf-ship-type
     2357               v-torgconf-supplier-name    = substitute( "&1", v-torgconf-self-host-name   )
     2358               v-torgconf-saler-name       = substitute( "&1", v-torgconf-cli-name         )
     2359               v-torgconf-consignee-name   = substitute( "&1", v-torgconf-ship-name         )
     2360               v-torgconf-supplier-addr    = substitute( "&1", v-torgconf-self-host-addres )
     2361               v-torgconf-saler-addr       = substitute( "&1", v-torgconf-cli-addres       )
     2362               v-torgconf-consignee-addr   = substitute( "&1", v-par-consignee-addres                )
     2363               v-torgconf-supplier-inn     = substitute( "&1", v-torgconf-self-host-inn    )
     2364               v-torgconf-supplier-engl-name     = substitute( "&1", v-torgconf-self-host-engl-name    )
     2365               v-torgconf-saler-inn        = substitute( "&1", v-torgconf-cli-inn          )
     2366               v-torgconf-consignee-inn    = substitute( "&1", v-torgconf-ship-inn          )
     2367               v-torgconf-supplier-kpp     = substitute( "&1", v-torgconf-self-host-kpp    )
     2368               v-torgconf-saler-kpp        = substitute( "&1", v-torgconf-cli-kpp          )
     2369               v-torgconf-consignee-kpp    = substitute( "&1", v-torgconf-ship-kpp          )
     2370               v-torgconf-sf-buyer-name    = v-torgconf-consignee-name
     2371               v-torgconf-sf-buyer-code    = v-torgconf-consignee-code
     2372               v-torgconf-sf-buyer-type    = v-torgconf-consignee-type
     2373               v-torgconf-sf-buyer-addr    = v-torgconf-consignee-addr
     2374           .
     2375           if v-torgconf-self-schet-exists = yes
     2376           AND v-form-name                  = "torg12":U
     2377           then do:
     2378               assign
     2379                   v-torgconf-supplier = v-torgconf-supplier
     2380                       + substitute( ", р/с &1 к/с &2"
     2381                                   , v-torgconf-self-bank-r-schet
     2382                                   , v-torgconf-self-bank-c-schet
     2383                                   )
     2384               .
     2385               if v-torgconf-self-bank-exists = yes
     2386               then do:
     2387                   assign
     2388                       v-torgconf-supplier = v-torgconf-supplier
     2389                           + substitute( " БИК &1 в &2 &3"
     2390                                       , v-torgconf-self-bank-bik
     2391                                       , v-torgconf-self-bank-name
     2392                                       , v-torgconf-self-bank-addres
     2393                                       )
     2394                   .
     2395               end.
     2396           end.
     2397           if v-torgconf-cli-schet-exists = yes
     2398           AND v-form-name                  = "torg12":U
     2399           then do:
     2400               assign
     2401                   v-torgconf-saler = v-torgconf-saler
     2402                       + substitute( ", р/с &1 к/с &2"
     2403                                   , v-torgconf-cli-bank-r-schet
     2404                                   , v-torgconf-cli-bank-c-schet
     2405                                   )
     2406               .
     2407               if v-torgconf-cli-bank-exists = yes
     2408               then do:
     2409                   assign
     2410                       v-torgconf-saler = v-torgconf-saler
     2411                           + substitute( " БИК &1 в &2 &3"
     2412                                       , v-torgconf-cli-bank-bik
     2413                                       , v-torgconf-cli-bank-name
     2414                                       , (if v-torgconf-cli-bank-city = "":U then "":U else ( "г. " + v-torgconf-cli-bank-city) )
     2415                                       )
     2416                   .
     2417               end.
     2418           end.
     2419           if v-torgconf-ship-schet-exists = yes
     2420           AND v-form-name                  = "torg12":U
     2421           then do:
     2422               assign
     2423                   v-torgconf-consignee = v-torgconf-consignee
     2424                       + substitute( ", р/с &1 к/с &2"
     2425                                   , v-torgconf-ship-bank-r-schet
     2426                                   , v-torgconf-ship-bank-c-schet
     2427                                   )
     2428               .
     2429               if v-torgconf-ship-bank-exists = yes
     2430               then do:
     2431                   assign
     2432                       v-torgconf-consignee = v-torgconf-consignee
     2433                           + substitute( " БИК &1 в &2  &3"
     2434                                       , v-torgconf-ship-bank-bik
     2435                                       , v-torgconf-ship-bank-name
