     6716       case clients.obj-type:
     6717          when 'орг':U
     6718          then do:
     6719               FIND ub.firm WHERE ub.firm.firm-code = clients.obj-code NO-LOCK .
     6720               if available ub.firm
     6721               then do:
     6722                   assign
     6723                       t-addres = ( if ub.firm.ind = 0 or ub.firm.ind = ? then "" else string( ub.firm.ind ) )
     6724                       t-addres = t-addres
     6725                           + ( if ub.firm.city = ? or trim(ub.firm.city) = ""
     6726                               then ""
     6727                               else ( (if t-addres = "" then "" else ", ") + trim( ub.firm.city ) )
     6728                             )
     6729                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 1, 50 ) ) )
     6730                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6731                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6732                           + ( if  ub.firm.addres2 = ? or trim(ub.firm.addres2) = "" then "" else ( ", " + trim( ub.firm.addres2 ) ) )
     6733                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 51, 50 ) ) )
     6734                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6735                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6736                       t-temp-address = ( if ub.firm.addres1 = ? then "" else trim( substring( ub.firm.addres1, 101, 50 ) ) )
     6737                       t-addres = t-addres + ( if t-addres = "" or t-temp-address = "" then "" else ", " )
     6738                           + ( if t-temp-address = "" then "" else ( trim( t-temp-address ) ) )
     6739                       t-phone = ub.firm.phone
     6740                       t-inn   = ub.firm.inn
     6741                       t-okpo  = ub.firm.okpo
     6742                   .
     6743               end.
     6744          end.
     6745          when 'маг':U
     6746          then do:
