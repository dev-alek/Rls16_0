     3326   if valid-handle( g#wthcalib ) <> yes then do:       run str/wthcalib.p persistent no-error.       if error-status :error or valid-handle( g#wthcalib ) <> yes then do:         message "Error starting wthcalib.p"    skip( 0 )                 g#wthcalib                     skip( 0 )                 g#wthcalib   :type             skip( 0 )                 g#wthcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run wthcalib_wthat-val in g#wthcalib (  input p-doc-code ,
     3327                           input 'wthpaydoc':U ,
     3328                          output v-attr ,
     3329                          output v-attr-type )  .
     3330      end.
     3331       case v-torgconf-outssdoc
     3332       :
     3333        when "nacl":U
     3334        then do:
     3335            if  v-name <> 'wthtrg12'
     3336            and v-name <> 'wthfct'
     3337            and v-name <> 'wthm11'
     3338            then do:
     3339               assign
     3340                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3"
     3341                                                   , if trim(v-dcode-attr) = "" then v-torgconf-doc-code else v-dcode-attr
     3342                                                   , if trim(v-ddate-attr) = "" then v-torgconf-doc-date else v-ddate-attr
     3343                                                   , ( if p-status_ <> 'факт':U
     3344                                                      then string( "(" + caps( p-status_ ) + ")" )
     3345                                                      else "":U )
     3346                                                )
     3347               .
     3348            end.
     3349            else do:
     3350            if trim(v-attr) = ""
     3351            then do:
     3352               assign
     3353                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2 &3",
     3354                                                           v-torgconf-doc-code,
     3355                                                           v-torgconf-doc-date,
     3356                                                            ( if p-status_ <> 'факт':U then string( "(" + caps( p-status_ ) + ")" ) else "":U )
     3357                                                           )
     3358               .
     3359            end.
     3360            else do:
     3361               assign
     3362                  v-torgconf-plat-rasch-doc = v-attr.
     3363            end.
     3364            end.
     3365        end.
     3366        otherwise do:
     3367            if  v-name <> 'wthtrg12'
     3368            and v-name <> 'wthfct'
     3369            and v-name <> 'wthm11'
     3370            then do:
     3371               IF v-dcode-attr <> "":U
     3372               OR v-ddate-attr <> "":U
     3373               THEN
     3374               assign
     3375                  v-torgconf-plat-rasch-doc   = substitute( "&1 от &2"
     3376                                                      , if trim(v-dcode-attr) = "" then "" else v-dcode-attr
     3377                                                      , if trim(v-ddate-attr) = "" then "" else v-ddate-attr
     3378                                                   )
     3379               .
     3380            end.
     3381            else do:
     3382               assign
     3383                  v-torgconf-plat-rasch-doc   = substitute( "&1", if trim(v-attr) = "" then "" else v-attr)
     3384               .
     3385            end.
     3386        end.
     3387       end case.
     3388      if v-torgconf-outB = "no_print"
     3389      then do:
     3390         assign v-torgconf-main-buh = "".
     3391      end.
     3392      if v-torgconf-outB = "glbuh_firm"
     3393      then do:
     3394            if v-torgconf-self-host-code = 0
     3395            then do:
     3396            end.
     3397            else do:
     3398               find first buf_sysconf no-lock
