     7192                                  and out-vatp_parts.obj-code   = t-doc.obj-code
     7193                                  and out-vatp_parts.artic      = ub.doc-line.artic
     7194                                  and out-vatp_parts.prod-type  = ub.doc-line.prod-type
     7195                                  and out-vatp_parts.prod-code  = ub.doc-line.prod-code no-lock :
     7196       if out-vatp_parts.purch-code = 2 then do:
     7197   assign
