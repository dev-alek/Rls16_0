     6761               FIND ub.store WHERE ub.store.obj-code = clients.obj-code NO-LOCK .
     6762               if available ub.store
     6763               then do:
     6764                   assign
     6765                       t-addres = ( if trim( ub.store.addres1 ) <> "" then ( trim( ub.store.addres1 ) ) else "" )
     6766                               + ( if trim( ub.store.addres2 ) <> "" then ( ", " + trim( ub.store.addres2 ) ) else "" )
     6767                       t-phone = ub.store.phone
