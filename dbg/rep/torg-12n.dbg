     1369               assign
     1370                   v-torgconf-outegrp  = yes
     1371               .
     1372           end.
     1373           if lookup( p-form-name, v-outt12  ) <> 0
     1374           then do:
     1375               assign
     1376                   v-torgconf-outt12   = yes
     1377               .
     1378           end.
     1379           if lookup( p-form-name, v-outappr  ) <> 0
