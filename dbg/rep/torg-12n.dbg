     4906                   assign j = j + 1.
     4907               END.
     4908               if line-counter( Out-Stream ) + j > page-size( Out-Stream ) then
     4909                   do:
     4910   define variable vss-include-info25 as character format "X(65)" no-undo
     4911   initial "@(#)$Workfile$ $Revision$".
     4912   if page-number( out-stream ) > prevpage then
