     1116   procedure wthcattr-sprcli :
     1117   define input parameter parparentproc  as widget-handle no-undo.
     1118   define input parameter p-mode  as character no-undo.
     1119   define input-output parameter p-value as character no-undo .
     1120   define output parameter p-setted as logical no-undo .
     1121     DEFINE VARIABLE v-value as character no-undo .
     1122     define variable v-cli-type as character no-undo .
     1123     define variable v-cli-code as integer no-undo .
     1124     define buffer buf_clients   for ub.clients.
     1125     define variable v_rid as character no-undo.
     1126     define variable ref-rec as recid no-undo .
     1127     do
     1128     on error undo, return error
     1129     :
     1130         v-value = p-value.
     1131      if p-value <> '':U then do:
     1132       assign
     1133       v-cli-type = substring(p-value, 1, 3)
     1134       v-cli-code = integer(substring(p-value, 4))
     1135       no-error.
     1136       if error-status:error then do:
     1137         assign
     1138         v-cli-type = '':U
     1139         v-cli-code = 0
     1140         .
     1141       end.
     1142      end.
     1143      FIND FIRST buf_clients NO-LOCK WHERE
     1144               buf_clients.obj-type = v-cli-type AND
     1145               buf_clients.obj-code = v-cli-code  NO-ERROR.
     1146      IF available(buf_clients) then do:
     1147       run ref/cli-all.w (
     1148                   input parparentproc
     1149                  ,input if p-mode = 'ИЗМЕНЕНИЕ':U then "b-sel":U else "":U
     1150                  ,input v-cli-type
     1151                  ,input 'все':U
     1152                  ,input 'все':U
     1153                  ,input RECID( buf_clients )
     1154                  ,input ",,,,,,NO"
     1155                  ,input ?
     1156                  ,OUTPUT v_rid ).
     1157     END.
     1158     ELSE if p-mode = 'ИЗМЕНЕНИЕ':U then DO:
     1159       run ref/cli-all.w (
     1160                    input parparentproc
     1161                   ,INPUT "b-sel":U
     1162                  ,input  v-cli-type
     1163                  ,input 'все':U
     1164                  ,input 'текущие':U
     1165                  ,input ?
     1166                  ,input ",,,,,,NO"
     1167                  ,input ?
     1168                  ,OUTPUT v_rid ).
     1169     END.
     1170     else do:
     1171       message
     1172       if p-value = "":U then 'Атрибут не задан!'
     1173       else substitute('Не найден клиент &1',p-value)
     1174       view-as alert-box warning.
     1175     end.
     1176     IF v_rid <> ? AND v_rid <> "":U THEN DO:
     1177       ASSIGN ref-rec = INT( v_rid ) NO-ERROR.
     1178       IF ERROR-STATUS:ERROR THEN DO:
     1179           RETURN NO-APPLY.
     1180       END.
     1181       FIND FIRST buf_clients NO-LOCK WHERE
     1182                  RECID( buf_clients ) = ref-rec NO-ERROR.
     1183       IF AVAIL buf_clients THEN DO:
     1184         v-value = buf_clients.obj-type + string(buf_clients.obj-code, ">>>>>>>>9").
     1185       end.
     1186     end.
     1187     if v-value <> p-value then do:
     1188       p-value = v-value.
     1189       p-setted = yes.
     1190     end.
     1191     end.
     1192   end procedure.
     1193     define new global shared variable g#wthcalib as handle no-undo.
     1194   procedure torgconf-read :
     1195   do
     1196   on error undo, return error
     1197   :
     1198       define input parameter p-form-name  as character    no-undo.
     1199       define input parameter p-host-code  as integer      no-undo.
     1200       define input parameter p-obj-type   as character    no-undo.
     1201       define input parameter p-obj-code   as integer      no-undo.
     1202       define variable v-outdate   as character     no-undo.
     1203       define variable v-outares   as character     no-undo.
     1204       define variable v-outsend   as character     no-undo.
     1205       define variable v-outasend  as character     no-undo.
     1206       define variable v-outprops  as character     no-undo.
     1207       define variable v-outnum    as character     no-undo.
     1208       define variable v-outprim   as character     no-undo.
     1209       define variable v-outdisc   as character     no-undo.
     1210       define variable v-outsubs   as character     no-undo.
     1211       define variable v-outrecv   as character     no-undo.
     1212       define variable v-outegrp   as character     no-undo.
     1213       define variable v-outt12    as character     no-undo.
     1214       define variable v-outappr   as character     no-undo.
     1215       define variable v-outrubl   as character     no-undo.
     1216       define variable v-outhold   as character     no-undo.
     1217       define variable v-outobj    as character     no-undo.
     1218       define variable v-outexlst  as character     no-undo.
     1219       define variable v-outprncd  as character     no-undo.
     1220       define variable v-par-type  as character     no-undo.
     1221       define variable v-outogr    as character     no-undo.
     1222       define variable v-outR      as character     no-undo.
     1223       define variable v-outB      as character     no-undo.
     1224       define variable v-outC      as character     no-undo.
     1225       assign
     1226           v-torgconf-outdate  = no
     1227           v-torgconf-outnum   = no
     1228           v-torgconf-outprim  = no
     1229           v-torgconf-outdisc  = no
     1230           v-torgconf-outsubs  = no
     1231           v-torgconf-outrecv  = no
     1232           v-torgconf-outegrp  = no
     1233           v-torgconf-outt12   = no
     1234           v-torgconf-outappr  = no
     1235           v-torgconf-outrubl  = no
     1236           v-torgconf-outhold  = no
     1237           v-torgconf-outobj   = no
     1238           v-torgconf-outexlst = no
     1239           v-torgconf-outexpas = "":U
     1240           v-torgconf-outprncd = yes
     1241           v-torgconf-outares  = no
