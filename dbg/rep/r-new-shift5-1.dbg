      599   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      600   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      601   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      602   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      603   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      604   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      605   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      606   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
      607   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      608   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      609   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      610   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      611   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
      612   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
