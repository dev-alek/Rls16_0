     2007   procedure report-exec :
     2008   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2009   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     2010     (input  p-obj-type
     2011     ,input  p-obj-code
     2012     ,output v-host-code
     2013     )  .
     2014     find first ub.cashbook no-lock where ub.cashbook.Status_ = 0 no-error .
     2015     if not available (ub.cashbook) then do:
     2016     assign
     2017       v-ost-begin         = 0
     2018       v-ost-begin-all     = 0
     2019       v-income-realiZ-all = 0
     2020       v-income-other-all  = 0
     2021       v-expense-bank-all  = 0
     2022       v-expense-other-all = 0
     2023       v-ost-end-all       = 0
     2024     .
     2025       assign
     2026         fact-order-1     = 0
     2027         fact-order-2     = 0
     2028         v-ost-begin      = 0
     2029         v-income-realiZ  = 0
     2030         v-income-other   = 0
     2031         v-expense-bank   = 0
     2032         v-expense-other  = 0
     2033         v-ost-end        = 0
     2034       .
     2035       run fostatok in this-procedure (
     2036            input   v-host-code
     2037           ,input   p-obj-code
     2038           ,input   p-obj-type
     2039           ,input   x-tog-shift
     2040           ,input   x-date-start - 1
     2041           ,input   date('')
     2042           ,input   x-shift-start
     2043           ,input   X-shift-end
     2044           ,input   yes
     2045           ,input   0
     2046           ,input   0
     2047           ,output  v-sum-begin
     2048           ,output  Fact-order-1)
     2049           no-error .
     2050       run fostatok in this-procedure (
     2051            input   v-host-code
     2052           ,input   p-obj-code
     2053           ,input   p-obj-type
     2054           ,input   x-tog-shift
     2055           ,input   x-date-end
     2056           ,input   x-date-end
     2057           ,input   X-shift-end
     2058           ,input   X-shift-end
     2059           ,input   yes
     2060           ,input   0
     2061           ,input   0
     2062           ,output  sum1
     2063           ,output  Fact-order-2)
     2064           no-error .
     2065    for each buf_arh-fin-doc-schet-nal-obj no-lock
     2066       where buf_arh-fin-doc-schet-nal-obj.host-code         = v-host-code
     2067         and buf_arh-fin-doc-schet-nal-obj.obj-type          = p-obj-type
     2068         and buf_arh-fin-doc-schet-nal-obj.obj-code          = p-obj-code
     2069         and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     2070         and buf_arh-fin-doc-schet-nal-obj.cli-code          = v-host-code
     2071         and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     2072         and buf_arh-fin-doc-schet-nal-obj.cashbookid        = 0
     2073         and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     2074         and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     2075         and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     2076         and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     2077         and buf_arh-fin-doc-schet-nal-obj.fact-order       > fact-order-1
     2078         and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     2079           :
     2080        find first buf_fin-doc
     2081             where buf_fin-doc.host-code         = v-host-code
     2082               and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     2083               and buf_fin-doc.CashBookId        = buf_arh-fin-doc-schet-nal-obj.cashbookid
     2084               and buf_fin-doc.obj-type          = p-obj-type
     2085               and buf_fin-doc.obj-code          = p-obj-code
     2086               and buf_fin-doc.status_           = 'факт':U
     2087               and (buf_fin-doc.fin-ext-doc-type = 'пко':U
     2088               or buf_fin-doc.fin-ext-doc-type   = 'рко':U )
     2089             no-error.
     2090             if available buf_fin-doc then do :
     2091                                          if buf_fin-doc.trn-doc-code = (if buf_fin-doc.obj-code > 0 then substitute('&1&2', buf_fin-doc.obj-type, string(buf_fin-doc.obj-code, '99999')) else '') then do:
     2092                   assign Counter1 = Counter1 + 1.
     2093   IF ( Counter1 modulo v-account = 0 )  then DO:
     2094             if  log-manager:logfile-name ne ?
     2095             then DO:
     2096                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2097             end.
     2098              if mFrameView
     2099              then do:
     2100               DISPLAY
     2101                 Counter1 @ RecordsDone
     2102                 WITH FRAME InfoFrame.
     2103              end.
     2104   End.
     2105      if v-button-stop then  DO:
     2106            if mFrameView
     2107            then
     2108               PROCESS EVENTS.
     2109            IF StopProcessing THEN DO:
     2110            RETURN error.
     2111            End.
     2112      end.
     2113                   if buf_fin-doc.fin-ext-doc-type = 'пко':U then do :
     2114                         find first buf_sysconf no-lock
     2115                              where buf_sysconf.host-code = v-host-code
     2116                              no-error.
     2117                         if available buf_sysconf
     2118                         and buf_fin-doc.payer-type = buf_sysconf.sale-type
     2119                         and buf_fin-doc.payer-code = buf_sysconf.sale-code
     2120                         then do:
     2121                           assign
     2122                             v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2123                           .
     2124                         end.
     2125                         else do:
     2126                           find first ub.CashBook no-lock where ub.CashBook.cli-code = buf_fin-doc.payer-code
     2127                           and ub.CashBook.cli-type = buf_fin-doc.payer-type no-error .
     2128                           if available (ub.CashBook) then do:
     2129                           assign
     2130                             v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2131                           .
     2132                           end.
     2133                           else do:
     2134                           assign
     2135                             v-income-other = v-income-other + buf_fin-doc.sum-doc
     2136                           .
     2137                           end.
     2138                         end.
     2139                   end.
     2140                   else do :
     2141                       find first buf_clients-attr
     2142                       where buf_clients-attr.obj-type  = buf_fin-doc.receiver-type
     2143                         and buf_clients-attr.obj-code  = buf_fin-doc.receiver-code
     2144                         and buf_clients-attr.attr-code = 'is-inkassator':U
     2145                         use-index pi no-error.
     2146                         if available buf_clients-attr then do :
     2147                           assign
     2148                             v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc
     2149                           .
     2150                         end.
     2151                         else do :
     2152                           assign
     2153                             v-expense-other = v-expense-other + buf_fin-doc.sum-doc
     2154                           .
     2155                         end.
     2156                   end.
     2157                end.
     2158             end.
     2159       end.
     2160       assign
     2161         v-ost-begin = v-ost-begin + v-sum-begin
     2162       .
     2163             create temp-fin-doc.
     2164             assign
     2165                   temp-fin-doc.cashbookid     = 0
     2166                   temp-fin-doc.cashbook       = "Основная деятельность"
     2167                   temp-fin-doc.ost-begin      = v-ost-begin
     2168                   temp-fin-doc.income-realiZ  = v-income-realiZ
     2169                   temp-fin-doc.income-other   = v-income-other
     2170                   temp-fin-doc.expense-bank   = v-expense-bank
     2171                   temp-fin-doc.expense-other  = v-expense-other
     2172                   temp-fin-doc.ost-end        = v-ost-begin + ( v-income-realiZ + v-income-other ) - ( v-expense-bank + v-expense-other )
     2173           .
     2174   end.
     2175   else do:
     2176   for each buf_cashbook no-lock where buf_cashbook.Status_ = 0:
     2177       assign
     2178       v-ost-begin         = 0
     2179       v-ost-begin-all     = 0
     2180       v-income-realiZ-all = 0
     2181       v-income-other-all  = 0
     2182       v-expense-bank-all  = 0
     2183       v-expense-other-all = 0
     2184       v-ost-end-all       = 0
     2185     .
     2186       assign
     2187         fact-order-1     = 0
     2188         fact-order-2     = 0
     2189         v-ost-begin      = 0
     2190         v-income-realiZ  = 0
     2191         v-income-other   = 0
     2192         v-expense-bank   = 0
     2193         v-expense-other  = 0
     2194         v-ost-end        = 0
     2195       .
     2196       run fostatok in this-procedure (
     2197            input   v-host-code
     2198           ,input   p-obj-code
     2199           ,input   p-obj-type
     2200           ,input   x-tog-shift
     2201           ,input   x-date-start - 1
     2202           ,input   date('')
     2203           ,input   x-shift-start
     2204           ,input   X-shift-end
     2205           ,input   yes
     2206           ,input   0
     2207           ,input   buf_cashbook.id
     2208           ,output  v-sum-begin
     2209           ,output  Fact-order-1)
     2210           no-error .
     2211       run fostatok in this-procedure (
     2212            input   v-host-code
     2213           ,input   p-obj-code
     2214           ,input   p-obj-type
     2215           ,input   x-tog-shift
     2216           ,input   x-date-end
     2217           ,input   x-date-end
     2218           ,input   X-shift-end
     2219           ,input   X-shift-end
     2220           ,input   yes
     2221           ,input   0
     2222           ,input   buf_cashbook.id
     2223           ,output  sum1
     2224           ,output  Fact-order-2)
     2225           no-error .
     2226    for each buf_arh-fin-doc-schet-nal-obj no-lock
     2227       where buf_arh-fin-doc-schet-nal-obj.host-code         = v-host-code
     2228         and buf_arh-fin-doc-schet-nal-obj.obj-type          = p-obj-type
     2229         and buf_arh-fin-doc-schet-nal-obj.obj-code          = p-obj-code
     2230         and buf_arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U
     2231         and buf_arh-fin-doc-schet-nal-obj.cli-code          = v-host-code
     2232         and buf_arh-fin-doc-schet-nal-obj.fin-code-acc      = 0
     2233         and buf_arh-fin-doc-schet-nal-obj.cashbookid        = buf_cashbook.id
     2234         and buf_arh-fin-doc-schet-nal-obj.curr-code         = 0
     2235         and buf_arh-fin-doc-schet-nal-obj.fin-ext-doc-type  = "":U
     2236         and buf_arh-fin-doc-schet-nal-obj.calc-curr-code    = 0
     2237         and buf_arh-fin-doc-schet-nal-obj.sum-type          = (if x-tog-shift then 'shift-obj':U else 'obj':U )
     2238         and buf_arh-fin-doc-schet-nal-obj.fact-order       > fact-order-1
     2239         and buf_arh-fin-doc-schet-nal-obj.fact-order       <= fact-order-2
     2240           :
     2241        find first buf_fin-doc
     2242             where buf_fin-doc.host-code         = v-host-code
     2243               and buf_fin-doc.fin-doc-code      = buf_arh-fin-doc-schet-nal-obj.fin-doc-code
     2244               and buf_fin-doc.CashBookId        = buf_arh-fin-doc-schet-nal-obj.cashbookid
     2245               and buf_fin-doc.obj-type          = p-obj-type
     2246               and buf_fin-doc.obj-code          = p-obj-code
     2247               and buf_fin-doc.status_           = 'факт':U
     2248               and (buf_fin-doc.fin-ext-doc-type = 'пко':U
     2249               or buf_fin-doc.fin-ext-doc-type   = 'рко':U )
     2250             no-error.
     2251             if available buf_fin-doc then do :
     2252                                          if buf_fin-doc.trn-doc-code = (if buf_fin-doc.obj-code > 0 then substitute('&1&2', buf_fin-doc.obj-type, string(buf_fin-doc.obj-code, '99999')) else '') then do:
     2253                   assign Counter1 = Counter1 + 1.
     2254   IF ( Counter1 modulo v-account = 0 )  then DO:
     2255             if  log-manager:logfile-name ne ?
     2256             then DO:
     2257                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2258             end.
     2259              if mFrameView
     2260              then do:
     2261               DISPLAY
     2262                 Counter1 @ RecordsDone
     2263                 WITH FRAME InfoFrame.
     2264              end.
     2265   End.
     2266      if v-button-stop then  DO:
     2267            if mFrameView
     2268            then
     2269               PROCESS EVENTS.
     2270            IF StopProcessing THEN DO:
     2271            RETURN error.
     2272            End.
     2273      end.
     2274                   if buf_fin-doc.fin-ext-doc-type = 'пко':U then do :
     2275                         find first buf_sysconf no-lock
     2276                              where buf_sysconf.host-code = v-host-code
     2277                              no-error.
     2278                         if available buf_sysconf
     2279                         and buf_fin-doc.payer-type = buf_sysconf.sale-type
     2280                         and buf_fin-doc.payer-code = buf_sysconf.sale-code
     2281                         then do:
     2282                           assign
     2283                             v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2284                           .
     2285                         end.
     2286                         else do:
     2287                           find first ub.CashBook no-lock where ub.CashBook.cli-code = buf_fin-doc.payer-code
     2288                           and ub.CashBook.cli-type = buf_fin-doc.payer-type no-error .
     2289                           if available (ub.CashBook) then do:
     2290                           assign
     2291                             v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2292                           .
     2293                           end.
     2294                           else do:
     2295                           find first ub.CashBookRule no-lock where ub.CashBookRule.CashBookID = buf_fin-doc.CashBookId and
     2296                           ub.CashBookRule.Code = "Avanscli-code" and ub.CashBookRule.RuleValue = string(buf_fin-doc.payer-code) no-error .
     2297                           if available (ub.CashBookRule) and buf_fin-doc.payer-type = 'орг':U then do:
     2298                           assign
     2299                             v-income-realiZ = v-income-realiZ + buf_fin-doc.sum-doc
     2300                           .
     2301                           end.
     2302                           else do:
     2303                           assign
     2304                             v-income-other = v-income-other + buf_fin-doc.sum-doc
     2305                           .
     2306                           end.
     2307                           end.
     2308                         end.
     2309                   end.
     2310                   else do :
     2311                       find first buf_clients-attr
     2312                       where buf_clients-attr.obj-type  = buf_fin-doc.receiver-type
     2313                         and buf_clients-attr.obj-code  = buf_fin-doc.receiver-code
     2314                         and buf_clients-attr.attr-code = 'is-inkassator':U
     2315                         use-index pi no-error.
     2316                         if available buf_clients-attr then do :
     2317                           assign
     2318                             v-expense-bank = v-expense-bank + buf_fin-doc.sum-doc
     2319                           .
     2320                         end.
     2321                         else do :
     2322                           assign
     2323                             v-expense-other = v-expense-other + buf_fin-doc.sum-doc
     2324                           .
     2325                         end.
     2326                   end.
     2327                end.
     2328             end.
     2329       end.
     2330       assign
     2331         v-ost-begin = v-ost-begin + v-sum-begin
     2332       .
     2333             create temp-fin-doc.
     2334             assign
     2335                   temp-fin-doc.cashbookid     = buf_cashbook.id
     2336                   temp-fin-doc.ost-begin      = v-ost-begin
     2337                   temp-fin-doc.income-realiZ  = v-income-realiZ
     2338                   temp-fin-doc.income-other   = v-income-other
     2339                   temp-fin-doc.expense-bank   = v-expense-bank
     2340                   temp-fin-doc.expense-other  = v-expense-other
     2341                   temp-fin-doc.ost-end        = v-ost-begin + ( v-income-realiZ + v-income-other ) - ( v-expense-bank + v-expense-other )
     2342           .
     2343           if buf_cashbook.id = 0 then temp-fin-doc.cashbook       = "Основная деятельность" . else temp-fin-doc.cashbook = buf_cashbook.CashBookName .
     2344   end.
     2345   end.
     2346   end procedure .
