      614   define variable temp1 as integer   no-undo.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616   procedure factord :
      617     define input  parameter p-fact-date            as date    no-undo .
      618     define input  parameter p-fact-time            as integer no-undo .
      619     define input  parameter p-fact-num             as integer no-undo .
      620     define input  parameter p-shift-date           as date    no-undo .
      621     define input  parameter p-shift-num            as integer no-undo .
      622     define input  parameter p-shift-on             as logical no-undo .
      623     define output parameter p-fact-order           as decimal no-undo .
      624     define output parameter p-shift-end-fact-order as decimal no-undo .
      625     define output parameter p-day-end-fact-order   as decimal no-undo .
      626     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      627     if p-fact-date = ?
      628     then do:
      629       return error "Не указана фактическая дата" .
      630     end.
      631     define variable v-fact-date-num as integer no-undo .
      632     assign
      633       v-fact-date-num = integer(p-fact-date)
      634     .
      635     if p-fact-num = ?
      636     or p-fact-num = 0
      637     then do:
      638       return error "Не задан p-fact-num " + string(p-fact-num) .
      639     end.
      640     if p-fact-num < 0
      641     then do:
      642       return error "Отрицательный fact-num " + string(p-fact-num) .
      643     end.
      644     if p-fact-num >= 100000000
      645     then do:
      646       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      647     end.
      648     if p-shift-on = true
      649     then do:
      650       if p-shift-date = ?
      651       then do:
      652         return error "Не задана дата смены" .
      653       end.
      654       if p-shift-num = ?
      655       or p-shift-num = 0
      656       then do:
      657         return error "Не задан номер смены" .
      658       end.
      659     end.
      660     else do:
      661       assign
      662         p-shift-date = p-fact-date
      663         p-shift-num  = 24
      664       .
      665     end.
      666     define variable v-shift-offset as integer no-undo .
      667     if p-shift-date = p-fact-date
      668     then do:
      669       assign
      670         v-shift-offset = 1
      671       .
      672     end.
      673     if p-shift-date < p-fact-date
      674     then do:
      675       assign
      676         v-shift-offset = 0
      677       .
      678     end.
      679     if p-shift-date > p-fact-date
      680     then do:
      681       message
      682         vss-workfile vss-revision vss-description skip
      683         "Неправильная дата закрытия смены" skip
      684         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      685         view-as alert-box error .
      686       undo, return error
      687         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      688           ,string(p-fact-date, '99/99/9999':U)
      689           ,string(p-shift-date, '99/99/9999':U)
      690           )
      691       .
      692     end.
      693     if p-shift-num < 1
      694     or p-shift-num > 24
      695     then do:
      696       message
      697         vss-workfile vss-revision vss-description skip
      698         "Неправильный номер смены" skip
      699         "p-shift-num" p-shift-num skip
      700         view-as alert-box error .
      701       undo, return error return-value .
      702     end.
      703     assign
      704       p-fact-order           = v-fact-date-num
      705                              + v-shift-offset * 0.5
      706                              + p-shift-num    * 0.02 - 0.01
      707                              + p-fact-num     * 0.0000000001
      708       p-shift-end-fact-order = v-fact-date-num
      709                              + v-shift-offset * 0.5
      710                              + p-shift-num    * 0.02
      711       p-day-end-fact-order   = v-fact-date-num
      712                              + 0.99
      713     .
      714     if p-fact-order           <= v-fact-date-num
      715     or p-shift-end-fact-order <= v-fact-date-num
      716     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      717     or p-shift-end-fact-order >= p-day-end-fact-order
      718     then do:
      719       message
      720         vss-workfile vss-revision vss-description skip
      721         "Внутренняя ошибка при генерации фактического номера" skip
      722         "p-fact-date"            p-fact-date            skip
      723         "p-fact-time"            p-fact-time            skip
      724         "p-fact-num"             p-fact-num             skip
      725         "p-shift-date"           p-shift-date           skip
      726         "p-shift-num"            p-shift-num            skip
      727         "p-shift-on"             p-shift-on             skip
      728         "p-shift-end-fact-order" p-shift-end-fact-order skip
      729         "p-day-end-fact-order"   p-day-end-fact-order   skip
      730         "v-fact-date-num"        v-fact-date-num        skip
      731         view-as alert-box error .
      732       undo, return error return-value .
      733     end.
      734   end procedure.
      735   procedure day-begin-fact-order :
      736     define input  parameter p-fact-date            as date    no-undo .
      737     define output parameter p-day-begin-fact-order as decimal no-undo .
      738     do
      739     on error undo, return error return-value
      740     :
      741       if p-fact-date = ?
      742       then do:
      743         assign
      744           p-day-begin-fact-order = 0
      745         .
      746       end.
      747       else do:
      748         assign
      749           p-day-begin-fact-order = integer(p-fact-date)
      750         .
      751       end.
      752     end.
      753   end procedure.
      754   procedure factord-max-fact-order :
      755     define output parameter p-max-fact-order as decimal   no-undo .
      756     do
      757     on error undo, return error return-value
      758     :
      759       run day-begin-fact-order in this-procedure
      760         (input  date(1, 1, 5000)
      761         ,output p-max-fact-order
      762         ) .
      763     end.
      764   end procedure.
      765   procedure factord-cut-archive :
      766     define input  parameter p-obj-type             as character no-undo .
      767     define input  parameter p-obj-code             as integer   no-undo .
      768     define input  parameter p-fact-date            as date      no-undo .
      769     define output parameter p-shift-on             as logical   no-undo .
      770     define output parameter p-shift-date           as date      no-undo .
      771     define output parameter p-shift-num            as integer   no-undo .
      772     define output parameter p-day-end-fact-order   as decimal   no-undo .
      773     define output parameter p-shift-end-fact-order as decimal   no-undo .
      774     define variable v-fact-order as decimal   no-undo .
      775     define buffer buf_shift-obj for ub.shift-obj .
      776     do
      777     on error undo, return error return-value
      778     :
      779   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      780   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      781     (input  p-obj-type
      782     ,input  p-obj-code
      783     ,input  'shift-on=request'
      784     ,output p-shift-on
      785     ) no-error .
      786       if error-status :error
      787       then do:
      788         message
      789           vss-workfile vss-revision vss-description skip
      790           "Ошибка при определении атрибута объекта" skip
      791           "Объект" p-obj-type p-obj-code skip
      792           error-status :get-message(1) skip
      793           return-value skip
      794           view-as alert-box error .
      795         undo, return error return-value .
      796       end.
      797       if p-shift-on = false
      798       then do:
      799         assign
      800           p-shift-date               = ?
      801           p-shift-num                = 0
      802         .
      803       end.
      804       else do:
      805         find first buf_shift-obj share-lock
      806           where buf_shift-obj.obj-type   = p-obj-type
      807             and buf_shift-obj.obj-code   = p-obj-code
      808             and buf_shift-obj.shift-date > p-fact-date
      809           use-index pi
      810           no-error .
      811         if not available buf_shift-obj
      812         or buf_shift-obj.status_ <> 'зкр':U
      813         then do:
      814           message
      815             vss-workfile vss-revision vss-description skip
      816             "Невозможно вычислить последнюю смену" skip
      817             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      818             "Объект" p-obj-type p-obj-code skip
      819             "Дата" p-fact-date skip
      820             view-as alert-box error .
      821           undo, return error return-value .
      822         end.
      823         find last buf_shift-obj share-lock
      824           where buf_shift-obj.obj-type = p-obj-type
      825             and buf_shift-obj.obj-code = p-obj-code
      826             and buf_shift-obj.shift-date <= p-fact-date
      827           use-index pi
      828           no-error .
      829         if available buf_shift-obj
      830         then do:
      831           if  buf_shift-obj.status_ = 'зкр':U
      832           then do:
      833             assign
      834               p-shift-date = buf_shift-obj.shift-date
      835               p-shift-num  = buf_shift-obj.shift-num
      836             .
      837           end.
      838           else do:
      839             message
      840               vss-workfile vss-revision vss-description skip
      841               "Невозможно вычислить последнюю смену" skip
      842               "Статус смены отличен от статуса" 'зкр':U skip
      843               "Объект" p-obj-type p-obj-code skip
      844               "Дата" p-fact-date skip
      845               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      846               view-as alert-box error .
      847             undo, return error return-value .
      848           end.
      849         end.
      850         else do:
      851           assign
      852             p-shift-date = p-fact-date - 1
      853             p-shift-num  = 1
      854           .
      855         end.
      856       end.
      857       run factord in this-procedure
      858         (input  p-fact-date
      859         ,input  1
      860         ,input  1
      861         ,input  p-shift-date
      862         ,input  p-shift-num
      863         ,input  p-shift-on
      864         ,output v-fact-order
      865         ,output p-shift-end-fact-order
      866         ,output p-day-end-fact-order
      867         ) no-error .
      868       if error-status :error
      869       then do:
      870         message
      871           vss-workfile vss-revision vss-description skip
      872           "Ошибка при вызове процедуры factord"
      873           error-status :get-message(1) skip
      874           return-value skip
      875           view-as alert-box error .
      876         undo, return error return-value .
      877       end.
      878     end.
      879   end procedure.
      880   procedure factord-lock-shift :
      881     define input  parameter p-obj-type  as character no-undo .
      882     define input  parameter p-obj-code  as integer   no-undo .
      883     define input  parameter p-fact-date as date      no-undo .
      884     define parameter buffer buf_shift-obj for ub.shift-obj .
      885     define variable v-shift-on      as logical   no-undo .
      886     define variable v-extra-message as character no-undo .
      887     define variable v-error as character no-undo .
      888     do
      889     on error undo, return error return-value
      890     :
      891   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      892   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      893     (input  p-obj-type
      894     ,input  p-obj-code
      895     ,input  'shift-on=request'
      896     ,output v-shift-on
      897     ) no-error .
      898       if error-status :error
      899       then do:
      900         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
      901         undo, return error v-error .
      902       end.
      903       if v-shift-on = true
      904       then do:
      905         find first buf_shift-obj share-lock
      906           where buf_shift-obj.obj-type   = p-obj-type
      907             and buf_shift-obj.obj-code   = p-obj-code
      908             and buf_shift-obj.shift-date > p-fact-date
      909           use-index pi
      910           no-error .
      911         if not available buf_shift-obj
      912         or buf_shift-obj.status_ <> 'зкр':U
      913         then do:
      914           find last buf_shift-obj
      915             where buf_shift-obj.obj-type = p-obj-type
      916               and buf_shift-obj.obj-code = p-obj-code
      917               and buf_shift-obj.status_  = 'зкр':U
      918             use-index stts
      919             no-error .
      920           if available buf_shift-obj
      921           then do:
      922             assign
      923               v-extra-message =
      924                     substitute("Дата начала последеней закрытой смены на объекте &1"
      925                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
      926                               )
      927             .
      928           end.
      929           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
      930           undo, return error v-error .
      931         end.
      932       end.
      933     end.
      934   end procedure.
      935   procedure factord-end-day :
      936     define input  parameter p-fact-date            as date    no-undo .
      937     define output parameter p-day-end-fact-order   as decimal no-undo .
      938     do
      939     on error undo, return error return-value
      940     :
      941       if p-fact-date = ?
      942       then do:
      943         return error "Не указана фактическая дата" .
      944       end.
      945       assign
      946         p-day-end-fact-order = integer(p-fact-date) + 0.99
      947       .
      948     end.
      949   end procedure.
      950   procedure factord-to-date :
      951     define input  parameter p-fact-order as decimal no-undo .
      952     define output parameter p-fact-date  as date    no-undo .
      953     define variable v-ref-date  as date      no-undo .
      954     define variable v-ref-delta as integer   no-undo .
      955     do
      956     on error undo, return error return-value
      957     :
      958       if p-fact-order = ?
      959       or p-fact-order = 0
      960       then do:
      961         return error "Не указан fact-order" .
      962       end.
      963       assign
      964         v-ref-date  = date(1, 1, 2000)
      965       .
      966       assign
      967         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
      968       .
      969       assign
      970         p-fact-date = v-ref-date + v-ref-delta
      971       .
      972     end.
      973   end procedure.
      974   procedure factord-to-fact-num :
      975     define input  parameter p-fact-order as decimal no-undo .
      976     define output parameter p-fact-num   as integer no-undo .
      977     define variable v-fact-order-trunc as decimal no-undo .
      978     do
      979     on error undo, return error return-value
      980     :
      981       if p-fact-order = ?
      982       or p-fact-order = 0
      983       then do:
      984         return error "Не указан fact-order" .
      985       end.
      986       assign
      987        v-fact-order-trunc = truncate(p-fact-order, 2)
      988       .
      989       assign
      990         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
      991       .
      992     end.
      993   end procedure.
      994   procedure factord-to-shift-num :
      995     define input  parameter p-fact-order as decimal no-undo .
      996     define output parameter p-shift-num   as integer no-undo .
      997     define variable  p-shift-numd  as decimal   no-undo .
      998     define variable v-fact-order-trunc as decimal no-undo .
      999     do
     1000     on error undo, return error return-value
     1001     :
     1002       if p-fact-order = ?
     1003       or p-fact-order = 0
     1004       then do:
     1005         return error "Не указан fact-order" .
     1006       end.
     1007       assign
     1008        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1009       .
     1010       if v-fact-order-trunc < 0.5 then do:
     1011         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1012       end.
     1013       assign
     1014         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1015         .
     1016        assign
     1017         p-shift-num = truncate (p-shift-numd , 0)
     1018       .
     1019     end.
     1020   end procedure.
     1021   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1022   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1023   procedure paramls-clear :
     1024     define buffer buf_temp-param for temp-param .
     1025     do
     1026     on error undo, return error return-value
     1027     :
     1028       for each buf_temp-param
     1029       on error undo, return error
     1030       :
     1031         delete buf_temp-param .
     1032       end.
     1033     end.
     1034   end procedure.
     1035   procedure paramls-write :
     1036     define input  parameter p-code     as character no-undo .
     1037     define input  parameter p-sub-code as character no-undo .
     1038     define input  parameter p-value    as character no-undo .
     1039     define buffer buf_temp-param for temp-param .
     1040     do
     1041     on error undo, return error return-value
     1042     :
     1043       find first buf_temp-param
     1044         where buf_temp-param.param-code     = p-code
     1045           and buf_temp-param.param-sub-code = p-sub-code
     1046         no-error .
     1047       if not available buf_temp-param then do:
     1048         create buf_temp-param .
     1049         assign
     1050           buf_temp-param.param-code     = p-code
     1051           buf_temp-param.param-sub-code = p-sub-code
     1052         .
     1053       end.
     1054       assign
     1055         buf_temp-param.param-value = p-value
     1056       .
     1057     end.
     1058   end procedure.
     1059   procedure paramls-read :
     1060     define input  parameter p-code          as character no-undo .
     1061     define input  parameter p-sub-code      as character no-undo .
     1062     define input  parameter p-default-value as character no-undo .
     1063     define output parameter p-value         as character no-undo .
     1064     define buffer buf_temp-param for temp-param .
     1065     do
     1066     on error undo, return error return-value
     1067     :
     1068       find first buf_temp-param
     1069         where buf_temp-param.param-code     = p-code
     1070           and buf_temp-param.param-sub-code = p-sub-code
     1071         no-error .
     1072       if available buf_temp-param then do:
     1073         assign
     1074           p-value = buf_temp-param.param-value
     1075         .
     1076       end.
     1077       else do:
     1078         assign
     1079           p-value = p-default-value
     1080         .
     1081       end.
     1082     end.
     1083   end procedure.
     1084   procedure paramls-append :
     1085     define input  parameter p-code     as character no-undo .
     1086     define input  parameter p-sub-code as character no-undo .
     1087     define input  parameter p-value    as character no-undo .
     1088     define buffer buf_temp-param for temp-param .
     1089     do
     1090     on error undo, return error return-value
     1091     :
     1092       find first buf_temp-param
     1093            where buf_temp-param.param-code     = p-code
     1094              and buf_temp-param.param-sub-code = p-sub-code
     1095         no-error .
     1096       if not available buf_temp-param then do:
     1097         create buf_temp-param .
     1098         assign
     1099           buf_temp-param.param-code     = p-code
     1100           buf_temp-param.param-sub-code = p-sub-code
     1101           buf_temp-param.param-value    = p-value
     1102         .
     1103       end.
     1104       else do:
     1105           assign
     1106               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1107           .
     1108       end.
     1109     end.
     1110   end procedure.
     1111   PROCEDURE ostatok :
     1112   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1113   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1114   def input parameter x-tog-shift   as   logical             no-undo.
     1115   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1116   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1117   def input parameter x-shift-start as integer               no-undo.
     1118   def input parameter x-shift-end   as integer               no-undo.
     1119   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1120   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1121   def input parameter xTog-obj   as log no-undo.
     1122   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1123   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1124   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1125   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1126   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1127   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1128   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1129   def var              Fact-orderS   as char  no-undo.
     1130   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1131      Assign
     1132         Fact-order   = 0
     1133         Quantity     = 0
     1134         Coast_R      = 0
     1135         Coast_V      = 0
     1136         VAT_R        = 0
     1137         VAT_V        = 0 .
     1138    x-date-start-t  = x-date-start + 1 .
     1139   IF x-date-end = date('') then DO:
     1140      Fact-order = 0 .
     1141      for each obj-list
     1142          where  ( not xtog-obj or
     1143                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1144                 no-lock :
     1145         if  x-tog-shift = false then do:
     1146                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1147                               ub.stk-tot.Fact-date <=  x-date-start
     1148                               and ub.stk-tot.shift-num = 0
     1149                               USE-INDEX fact-date no-lock no-error .
     1150              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1151         End.
     1152         Else  DO :
     1153             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1154              (ub.stk-tot.shift-date  = x-date-start-t and
     1155               ub.stk-tot.shift-num  < x-shift-start or
     1156               ub.stk-tot.shift-date  < x-date-start-t  )
     1157               and ub.stk-tot.shift-num  > 0
     1158               USE-INDEX Shift-num no-lock no-error .
     1159            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1160           END.
     1161       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1162     End.
     1163   End.
     1164   Else DO:
     1165     For each obj-list  WHERE
     1166        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1167         no-lock :
     1168      IF  x-TOG-Shift = False Then DO:
     1169          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1170               ub.stk-tot.Fact-date <= x-date-end
     1171               and ub.stk-tot.shift-num = 0
     1172               USE-INDEX fact-date no-lock no-error.
     1173          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1174      END.
     1175      Else DO:
     1176           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1177               (ub.stk-tot.shift-date  = x-date-end and
     1178               ub.stk-tot.shift-num  <= x-shift-end or
     1179               ub.stk-tot.shift-date  < x-date-end       ) and
     1180               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1181               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1182       End.
     1183       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1184     End.
     1185   End.
     1186   END PROCEDURE.
     1187   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1189   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1190   PROCEDURE fostatok :
     1191   define input parameter p-host-code   as integer no-undo .
     1192   define input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1193   define input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1194   define input parameter x-tog-shift   as   logical             no-undo.
     1195   define input parameter x-date-start  as date        no-undo.
     1196   define input parameter x-date-end    as date        no-undo.
     1197   define input parameter x-shift-start as integer     no-undo.
     1198   define input parameter x-shift-end   as integer     no-undo.
     1199   define input parameter xTog-obj   as logical no-undo.
     1200   define input parameter p-curr-code as integer no-undo .
     1201   define input parameter p-cashbookid as integer  no-undo .
     1202   define output parameter sum       as decimal   no-undo.
     1203   define output parameter Fact-order  as decimal  no-undo.
     1204   define variable Fact-order#   as decimal  no-undo.
     1205   define variable Fact-orderS   as character  no-undo.
     1206   define variable x-date-start-t  as date   no-undo.
     1207   define variable x-sum-type as character no-undo .
     1208       if x-tog-shift then do:
     1209         assign
     1210         x-sum-type = 'shift-obj':U.
     1211       end.
     1212       else do:
     1213         x-sum-type = 'obj':U.
     1214       end.
     1215   Assign
     1216   Fact-order   = 0
     1217   sum     = 0
     1218   x-date-start-t  = x-date-start + 1 .
     1219   IF x-date-end = date('') then DO:
     1220     Fact-order = 0 .
     1221     For each obj-list no-lock
     1222         WHERE  (NOT xTog-obj OR
     1223                 (x-store-type = obj-list.obj-type
     1224                 AND
     1225                 x-store-code = obj-list.obj-code))
     1226     :
     1227      fact-order# = 0.
     1228      IF  x-TOG-Shift = False Then DO:
     1229         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1230             arh-fin-doc-schet-nal-obj.Fact-date <=  x-date-start
     1231             USE-INDEX fact-date  no-error .
     1232        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1233          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1234        end.
     1235      End.
     1236      Else  DO :
     1237         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1238              (arh-fin-doc-schet-nal-obj.shift-date  = x-date-start-t and
     1239               arh-fin-doc-schet-nal-obj.shift-num  < x-shift-start or
     1240               arh-fin-doc-schet-nal-obj.shift-date  < x-date-start-t  )
     1241               and arh-fin-doc-schet-nal-obj.shift-num  > 0
     1242               USE-INDEX Shift-num no-error .
     1243         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1244           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1245         end.
     1246       END.
     1247       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1248     End.
     1249   End.
     1250   Else DO:
     1251     For each obj-list  no-lock WHERE
     1252        (NOT xTog-obj
     1253         OR
     1254         (x-store-type = obj-list.obj-type
     1255         AND
     1256         x-store-code = obj-list.obj-code))
     1257      :
     1258      IF  x-TOG-Shift = False Then DO:
     1259         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1260               arh-fin-doc-schet-nal-obj.Fact-date <= x-date-end
     1261               and arh-fin-doc-schet-nal-obj.shift-num = 0
     1262               USE-INDEX fact-date no-error.
     1263        if Available arh-fin-doc-schet-nal-obj THEN  do:
     1264          Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1265        end.
     1266      END.
     1267      Else DO:
     1268         find last arh-fin-doc-schet-nal-obj no-lock where     arh-fin-doc-schet-nal-obj.obj-type = obj-list.obj-type and arh-fin-doc-schet-nal-obj.obj-code = obj-list.obj-code and arh-fin-doc-schet-nal-obj.cli-code          = p-host-code and arh-fin-doc-schet-nal-obj.cli-type          = 'орг':U and arh-fin-doc-schet-nal-obj.calc-curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.cashbookid    = p-cashbookid and arh-fin-doc-schet-nal-obj.curr-code    = p-curr-code and arh-fin-doc-schet-nal-obj.sum-type = x-sum-type and
     1269               (arh-fin-doc-schet-nal-obj.shift-date  = x-date-end and
     1270               arh-fin-doc-schet-nal-obj.shift-num  <= x-shift-end or
     1271               arh-fin-doc-schet-nal-obj.shift-date  < x-date-end       ) and
     1272               arh-fin-doc-schet-nal-obj.shift-num   > 0      use-index shift-num no-error.
     1273         if Available arh-fin-doc-schet-nal-obj THEN  do:
     1274           Assign                          sum     = arh-fin-doc-schet-nal-obj.income - arh-fin-doc-schet-nal-obj.expense                          Fact-order#  = arh-fin-doc-schet-nal-obj.Fact-order.
     1275         end.
     1276       End.
     1277       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1278     End.
     1279   End.
     1280   END PROCEDURE.
     1281   procedure ost-line :
     1282     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1283     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1284     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1285     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1286     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1287     define input  parameter x-tog-shift  as logical no-undo .
     1288     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1289     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1290     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1291     define input  parameter xtog-obj     as logical no-undo .
     1292     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1293     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1294     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1295     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1296     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1297     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1298     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1299     define buffer buff-obj-list  for obj-list .
     1300     define buffer buff-stk-line  for ub.stk-line .
     1301     assign
     1302       Quantity = 0
     1303       Coast_R  = 0
     1304       Coast_V  = 0
     1305       VAT_R    = 0
     1306       VAT_V    = 0
     1307       SLT_R    = 0
     1308       SLT_V    = 0
     1309     .
     1310     if  x-tog-shift = false then do:
     1311       for each buff-obj-list no-lock
     1312         where xtog-obj = false
     1313            or (buff-obj-list.obj-type = x-store-type
     1314               and buff-obj-list.obj-code = x-store-code
     1315               )
     1316       on error undo, return error
     1317       :
     1318         find last buff-stk-line no-lock
     1319           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1320             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1321             and buff-stk-line.artic      = x-artic
     1322             and buff-stk-line.prod-type  = x-prod-type
     1323             and buff-stk-line.prod-code  = x-prod-code
     1324             and buff-stk-line.sum-type   = x-sum-type
     1325             and buff-stk-line.cat-id     = '##,##':U
     1326             and buff-stk-line.fact-order <= x-fact-order
     1327             and buff-stk-line.shift-num  = 0
     1328           use-index category
     1329           no-error .
     1330         if available buff-stk-line then do:
     1331           assign
     1332             Quantity = Quantity +  buff-stk-line.fact-qnty
     1333             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1334             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1335             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1336             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1337             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1338             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1339           .
     1340         end.
     1341       end.
     1342     end.
     1343     else do:
     1344       for each buff-obj-list no-lock
     1345         where xtog-obj = false
     1346            or (buff-obj-list.obj-type = x-store-type
     1347               and buff-obj-list.obj-code = x-store-code
     1348               )
     1349       on error undo, return error
     1350       :
     1351         find last buff-stk-line no-lock
     1352           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1353             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1354             and buff-stk-line.artic      = x-artic
     1355             and buff-stk-line.prod-type  = x-prod-type
     1356             and buff-stk-line.prod-code  = x-prod-code
     1357             and buff-stk-line.sum-type   = x-sum-type
     1358             and buff-stk-line.cat-id     = '##,##':U
     1359             and buff-stk-line.fact-order <= x-fact-order
     1360             and buff-stk-line.shift-num  > 0
     1361           use-index category
     1362           no-error .
     1363         if available buff-stk-line then do:
     1364           assign
     1365             Quantity = Quantity +  buff-stk-line.fact-qnty
     1366             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1367             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1368             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1369             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1370             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1371             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1372           .
     1373         end.
     1374       end.
     1375     end.
     1376   end procedure.
     1377   procedure ost-lineother-tax :
     1378     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1379     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1380     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1381     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1382     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1383     define input  parameter x-tog-shift  as logical no-undo .
     1384     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1385     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1386     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1387     define input  parameter xTog-obj     as logical no-undo .
     1388     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1389     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1390     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1391     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1392     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1393     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1394     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1395     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1396     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1397     define buffer buff-obj-list  for obj-list .
     1398     define buffer buff-stk-line  for ub.stk-line .
     1399     assign
     1400       Quantity = 0
     1401       Coast_R  = 0
     1402       Coast_V  = 0
     1403       VAT_R    = 0
     1404       VAT_V    = 0
     1405       SLT_R    = 0
     1406       SLT_V    = 0
     1407       other_R  = 0
     1408       other_V  = 0
     1409     .
     1410     if  x-tog-shift = false then do:
     1411       for each buff-obj-list no-lock
     1412         where xtog-obj = false
     1413            or (buff-obj-list.obj-type = x-store-type
     1414               and buff-obj-list.obj-code = x-store-code
     1415               )
     1416       on error undo, return error
     1417       :
     1418         find last buff-stk-line no-lock
     1419           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1420             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1421             and buff-stk-line.artic      = x-artic
     1422             and buff-stk-line.prod-type  = x-prod-type
     1423             and buff-stk-line.prod-code  = x-prod-code
     1424             and buff-stk-line.sum-type   = x-sum-type
     1425             and buff-stk-line.cat-id     = '##,##':U
     1426             and buff-stk-line.fact-order <= x-fact-order
     1427             and buff-stk-line.shift-num  = 0
     1428           use-index category
     1429           no-error .
     1430         if available buff-stk-line then do:
     1431           assign
     1432             Quantity = Quantity +  buff-stk-line.fact-qnty
     1433             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1434             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1435             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1436             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1437             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1438             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1439             other_R  = other_R  +  buff-stk-line.other-rubl
     1440             other_V  = other_V  +  buff-stk-line.other-base
     1441           .
     1442         end.
     1443       end.
     1444     end.
     1445     else do:
     1446       for each buff-obj-list no-lock
     1447         where xtog-obj = false
     1448            or (buff-obj-list.obj-type = x-store-type
     1449               and buff-obj-list.obj-code = x-store-code
     1450               )
     1451       on error undo, return error
     1452       :
     1453         find last buff-stk-line no-lock
     1454           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1455             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1456             and buff-stk-line.artic      = x-artic
     1457             and buff-stk-line.prod-type  = x-prod-type
     1458             and buff-stk-line.prod-code  = x-prod-code
     1459             and buff-stk-line.sum-type   = x-sum-type
     1460             and buff-stk-line.cat-id     = '##,##':U
     1461             and buff-stk-line.fact-order <= x-fact-order
     1462             and buff-stk-line.shift-num  > 0
     1463           use-index category
     1464           no-error .
     1465         if available buff-stk-line then do:
     1466           assign
     1467             Quantity = Quantity +  buff-stk-line.fact-qnty
     1468             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1469             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1470             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1471             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1472             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1473             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1474             other_R = other_R   +  buff-stk-line.other-rubl
     1475             other_V = other_V   +  buff-stk-line.other-base
     1476           .
     1477         end.
     1478       end.
     1479     end.
     1480   end procedure.
     1481   procedure ost-line-kg :
     1482     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     1483     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     1484     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     1485     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     1486     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     1487     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     1488     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     1489     define buffer buff-obj-list  for obj-list .
     1490     define buffer buf_doc-line for ub.doc-line .
     1491     define buffer buf_inv-line for ub.inv-line .
     1492     do
     1493     on error undo, return error
     1494     :
     1495       for each buf_doc-line no-lock where
     1496                buf_doc-line.obj-type    = p-obj-type   and
     1497                buf_doc-line.obj-code    = p-obj-code   and
     1498                buf_doc-line.prod-type   = p-prod-type  and
     1499                buf_doc-line.prod-code   = p-prod-code  and
     1500                buf_doc-line.artic       = p-artic      and
     1501                buf_doc-line.status_     = 'факт':U      and
     1502                buf_doc-line.fact-order <= p-fact-order
     1503             by buf_doc-line.fact-order    descending
     1504       :
     1505         find first buf_inv-line no-lock where
     1506                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     1507                    buf_inv-line.artic     = buf_doc-line.artic     and
     1508                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     1509                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     1510         if available buf_inv-line
     1511         then do:
     1512           if buf_inv-line.after-cli-qnty <> ?
     1513           then do:
     1514             assign
     1515               p-quantity-kg = buf_inv-line.after-cli-qnty
     1516             .
     1517             leave .
     1518           end.
     1519         end.
     1520       end.
     1521       if p-quantity-kg = ?
     1522       then do:
     1523         assign
     1524           p-quantity-kg = 0
     1525         .
     1526       end.
     1527     end.
     1528   end procedure.
