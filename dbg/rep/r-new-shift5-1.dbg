     1643   define variable x-store-code    like ub.clients.obj-code   no-undo .
     1644   define variable x-store-type    like ub.clients.obj-type   no-undo .
     1645   define variable Fact-order-1    like ub.stk-tot.Fact-order no-undo .
     1646   define variable Fact-order-2    like ub.stk-tot.Fact-order no-undo .
     1647   define variable v-obj-type as character no-undo .
