     1664   define variable v-cashbookid      as integer   no-undo .
     1665   if session :set-wait-state( "compiler" ) then.
     1666       assign  Counter1 = 0 .
     1667   define variable v-account as integer init 0 no-undo .
     1668   define variable v-account-lavel as character no-undo .
     1669   define variable v-button-stop as logical no-undo .
     1670   define variable v-kol-spice as integer no-undo .
     1671   define variable v-kol-spice2 as integer no-undo .
     1672   define variable v-kol-spice3 as integer no-undo .
     1673   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1674   DEFINE BUTTON StopBtn AUTO-END-KEY
     1675        LABEL "Стоп"
     1676        SIZE 10 BY 1.
     1677   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1678        LABEL "Обработано записей"
     1679         VIEW-AS TEXT
     1680        SIZE 14 BY .67 NO-UNDO.
     1681   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1682         VIEW-AS TEXT
     1683        SIZE 53.25 BY .67
     1684        FGCOLOR 1  NO-UNDO.
     1685   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1686         VIEW-AS TEXT
     1687        SIZE 53.25 BY .67
     1688        FGCOLOR 1  NO-UNDO.
     1689   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1690         VIEW-AS TEXT
     1691        SIZE 53.25 BY .67
     1692        FGCOLOR 1  NO-UNDO.
     1693   DEFINE RECTANGLE RECT-1
     1694        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1695        SIZE 55.13 BY 4.46.
     1696   DEFINE FRAME InfoFrame
     1697        StopBtn AT ROW 4.25 COL 21.75
     1698        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1699        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1700        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1701        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1702        RECT-1 AT ROW 1 COL 1
     1703       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1704            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1705            TITLE "Процесс"
     1706            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1707   define variable mFrameView      as logical   no-undo init yes.
     1708     define variable mFramHandle as handle no-undo.
     1709     mFramHandle = frame InfoFrame:handle.
     1710     if  log-manager:logfile-name ne ?
     1711     then DO:
     1712         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1713         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1714         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1715     end.
     1716     mFrameView = not session:batch-mode and mFramHandle:visible.
     1717     if mFrameView
     1718     then do:
     1719       ASSIGN
     1720          FRAME InfoFrame:HIDDEN                           = TRUE
     1721          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1722     end.
     1723   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1724   DO:
     1725     IF not StopProcessing THEN
     1726       Message "Вы действительно хотите прервать" SKIP
     1727               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1728                 UPDATE StopProcessing.
     1729     IF StopProcessing THEN do:
     1730        if mFrameView
     1731        then do:
     1732           HIDE FRAME InfoFrame.
     1733        end.
     1734     End.
     1735   END.
     1736   assign v-account = ( if integer( 1 ) = 0 then 100 else integer( 1 ) ).
     1737     if  log-manager:logfile-name ne ?
     1738     then DO:
     1739         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1740     end.
     1741     if not session:batch-mode then
     1742     do:
     1743       VIEW FRAME InfoFrame.
     1744       mFrameView = true.
     1745     end.
     1746      v-button-stop = false .
     1747         if mFrameView
     1748         then do:
     1749         if v-button-stop then view STOPBTN in frame InfoFrame.
     1750                          else Hide STOPBTN in frame InfoFrame.
     1751         end.
     1752       find first buf_clients
     1753             where buf_clients.obj-type = 'орг':U
     1754             and   buf_clients.obj-code = v-cntxt-host-code-obj
     1755             no-lock
     1756             .
     1757       assign v-firm = buf_clients.obj-name  .
     1758           for each   temp-fin-doc :
     1759               delete temp-fin-doc .
     1760           end .
     1761           assign
     1762             v-ost-begin = 0
     1763           .
     1764           run report-exec in this-procedure .
     1765       find first buf_clients
     1766             where buf_clients.obj-type = 'орг':U
     1767             and   buf_clients.obj-code = v-cntxt-host-code-obj
     1768             no-lock
     1769             .
     1770       assign v-firm = buf_clients.obj-name  .
