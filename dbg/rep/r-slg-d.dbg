     1011   initial "@(#)$Workfile$ $Revision$".
     1012   procedure grplib-get-full-name :
     1013      define input parameter p-node-code  as integer      no-undo.
     1014      define output parameter p-full-name as character    no-undo.
     1015      do
     1016   on error undo, return error
     1017   :
     1018       define variable v-upper-code    as integer           no-undo.
     1019       define buffer buf_gds-grp       for ub.gds-grp.
     1020       define buffer buf_upper_gds-grp for ub.gds-grp.
     1021       find first buf_gds-grp no-lock
     1022            where buf_gds-grp.node-code = p-node-code
     1023       no-error.
     1024       if not available buf_gds-grp
     1025       then do:
     1026           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
     1027       end.
     1028       assign
     1029           p-full-name  = ""
     1030           v-upper-code = 1
     1031       .
     1032       do while buf_gds-grp.upper-code <> 0
     1033       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
     1034       :
     1035           assign
     1036               p-full-name  = buf_gds-grp.node-name
     1037                            + (if p-full-name <> "" then chr(47) else "")
     1038                            + p-full-name
     1039               v-upper-code = buf_gds-grp.upper-code
     1040           .
     1041           find first buf_gds-grp no-lock
     1042                where buf_gds-grp.node-code = v-upper-code
     1043           no-error.
     1044           if not available buf_gds-grp
     1045           then do:
     1046               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
     1047                                   + string( v-upper-code )
     1048                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
     1049           end.
     1050       end.
     1051       assign
     1052       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
     1053       .
     1054   end.
     1055   end .
     1056   procedure grplib-get-node-from-full-name :
     1057   define input parameter p-full-name as character no-undo .
     1058   define output parameter p-node-code as integer no-undo .
     1059   define variable v-ii as integer no-undo .
     1060   define variable v-upper-code as integer no-undo .
     1061   define variable v-root-code as integer no-undo .
     1062   define variable v-entry as character no-undo .
     1063   define buffer buf_gds-grp       for ub.gds-grp.
     1064   do
     1065   on error undo, return error
     1066   :
     1067     find first buf_gds-grp no-lock
     1068         where buf_gds-grp.upper-code = 0
     1069     no-error .
     1070     if not available buf_gds-grp
     1071     then do:
     1072         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
     1073     end.
     1074     else do:
     1075       assign
     1076       v-root-code = buf_gds-grp.node-code
     1077       .
     1078     end.
     1079     v-upper-code = v-root-code.
     1080     do v-ii = 1 to num-entries(p-full-name, chr(47)):
     1081       assign
     1082       v-entry = entry(v-ii, p-full-name, chr(47)).
     1083       if v-entry = '' then leave.
     1084       find first buf_gds-grp no-lock where
     1085                 buf_gds-grp.node-name = v-entry
     1086             and buf_gds-grp.upper-code = v-upper-code
     1087             no-error.
     1088       if not available buf_gds-grp then do:
     1089         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
     1090       end.
     1091       else do:
     1092         p-node-code = buf_gds-grp.node-code.
     1093         v-upper-code = buf_gds-grp.node-code.
     1094       end.
     1095     end.
     1096   end.
     1097   end .
     1098   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1099     if num-entries(string(p-dec), '.') = 2
     1100       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1101       else return( string(p-dec)) .
     1102   end function.
     1103   function format-point-to-comma returns char (input orig as char ) .
     1104   define variable rtext as character no-undo .
     1105   define variable strt as integer no-undo .
     1106   define variable leng as integer no-undo .
     1107   assign rtext = orig .
     1108   repeat:
     1109     strt =  index(rtext,'.').
     1110     if strt = 0 then leave.
     1111     leng = 1.
     1112     substring(rtext,strt,leng,"character") = v-delim .
     1113   end.
     1114   return rtext.
     1115   end function.
     1116   function format-excel-text returns char ( input start-text as char ) :
     1117   def var  i    as int no-undo.
     1118   def var  ch   as char no-undo.
     1119   def var  n    as int no-undo.
     1120   def var  ipos as int no-undo.
     1121     n = num-entries(trim(start-text), chr(10)) - 1 .
     1122     do i = 1 to n :
     1123       ipos = index( start-text, chr(10)).
     1124       if ipos > 0 then
     1125         substr( start-text, ipos, 1 ) = ' '.
     1126     end.
     1127     n = num-entries(trim(start-text), chr(13)) - 1 .
     1128     do i = 1 to n :
     1129       ipos = index( start-text, chr(13)).
     1130       if ipos > 0 then
     1131         substr( start-text, ipos, 1 ) = ' '.
     1132     end.
     1133     if index( start-text, '"' ) = 0 then
     1134       start-text =  '="'   + trim( start-text) + '"'   .
     1135       else do:
     1136         n = num-entries(trim(start-text), '"') - 1.
     1137         do i = 1 to n :
     1138           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1139         end.
     1140         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1141         start-text = '="'  + ch  + '"' .
     1142       end.
     1143     return start-text.
     1144   end.
     1145   function excel-sum returns char (input p-dec as decimal ).
     1146     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1147   end function.
     1148   function excel-qnty returns char (input p-dec as decimal ).
     1149     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1150   end function.
     1151   function format-excel-text-macr returns char ( input start-text as char ) :
     1152   def var  i    as int no-undo.
     1153   def var  ch   as char no-undo.
     1154   def var  n    as int no-undo.
     1155   def var  ipos as int no-undo.
     1156     n = num-entries(trim(start-text), chr(10)) - 1 .
     1157     do i = 1 to n :
     1158       ipos = index( start-text, chr(10)).
     1159       if ipos > 0 then
     1160         substring( start-text, ipos , 1 ) = ' '.
     1161     end.
     1162     n = num-entries(trim(start-text), chr(13)) - 1 .
     1163     do i = 1 to n :
     1164       ipos = index( start-text, chr(13)).
     1165       if ipos > 0 then
     1166         substring( start-text, ipos, 1 ) = ' '.
     1167     end.
     1168     if index( start-text, '"' ) = 0 then
     1169       start-text =  '"'   + trim( start-text) + '"'   .
     1170       else do:
     1171         n = num-entries(trim(start-text), '"') - 1.
     1172         do i = 1 to n :
     1173           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1174         end.
     1175         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1176         start-text = '"'  + ch  + '"' .
     1177       end.
     1178     n = num-entries(trim(start-text), chr(10)) - 1 .
     1179     do i = 1 to n :
     1180       ipos = index( start-text, chr(10)).
     1181       if ipos > 0 then
     1182         substring( start-text, ipos , 1 ) = ' '.
     1183     end.
     1184       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1185     return start-text.
     1186   end.
     1187   def var vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1188   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
     1189   procedure paramls-clear :
     1190     define buffer buf_temp-param for temp-param .
     1191     do
     1192     on error undo, return error return-value
     1193     :
     1194       for each buf_temp-param
     1195       on error undo, return error
     1196       :
     1197         delete buf_temp-param .
     1198       end.
     1199     end.
     1200   end procedure.
     1201   procedure paramls-write :
     1202     define input  parameter p-code     as character no-undo .
     1203     define input  parameter p-sub-code as character no-undo .
     1204     define input  parameter p-value    as character no-undo .
     1205     define buffer buf_temp-param for temp-param .
     1206     do
     1207     on error undo, return error return-value
     1208     :
     1209       find first buf_temp-param
     1210         where buf_temp-param.param-code     = p-code
     1211           and buf_temp-param.param-sub-code = p-sub-code
     1212         no-error .
     1213       if not available buf_temp-param then do:
     1214         create buf_temp-param .
     1215         assign
     1216           buf_temp-param.param-code     = p-code
     1217           buf_temp-param.param-sub-code = p-sub-code
     1218         .
     1219       end.
     1220       assign
     1221         buf_temp-param.param-value = p-value
     1222       .
     1223     end.
     1224   end procedure.
     1225   procedure paramls-read :
     1226     define input  parameter p-code          as character no-undo .
     1227     define input  parameter p-sub-code      as character no-undo .
     1228     define input  parameter p-default-value as character no-undo .
     1229     define output parameter p-value         as character no-undo .
     1230     define buffer buf_temp-param for temp-param .
     1231     do
     1232     on error undo, return error return-value
     1233     :
     1234       find first buf_temp-param
     1235         where buf_temp-param.param-code     = p-code
     1236           and buf_temp-param.param-sub-code = p-sub-code
     1237         no-error .
     1238       if available buf_temp-param then do:
     1239         assign
     1240           p-value = buf_temp-param.param-value
     1241         .
     1242       end.
     1243       else do:
     1244         assign
     1245           p-value = p-default-value
     1246         .
     1247       end.
     1248     end.
     1249   end procedure.
     1250   procedure paramls-append :
     1251     define input  parameter p-code     as character no-undo .
     1252     define input  parameter p-sub-code as character no-undo .
     1253     define input  parameter p-value    as character no-undo .
     1254     define buffer buf_temp-param for temp-param .
     1255     do
     1256     on error undo, return error return-value
     1257     :
     1258       find first buf_temp-param
     1259            where buf_temp-param.param-code     = p-code
     1260              and buf_temp-param.param-sub-code = p-sub-code
     1261         no-error .
     1262       if not available buf_temp-param then do:
     1263         create buf_temp-param .
     1264         assign
     1265           buf_temp-param.param-code     = p-code
     1266           buf_temp-param.param-sub-code = p-sub-code
     1267           buf_temp-param.param-value    = p-value
     1268         .
     1269       end.
     1270       else do:
     1271           assign
     1272               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
     1273           .
     1274       end.
     1275     end.
     1276   end procedure.
