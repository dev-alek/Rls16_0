     2315           fo   = buf_stk-line.fact-order
     2316         .
     2317         do while stat = no :
     2318           find last buf_stk-line no-lock
     2319             where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     2320             and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     2321             and buf_stk-line.artic     = buf_goods.artic
     2322             and buf_stk-line.prod-type = buf_gds-obj.prod-type
     2323             and buf_stk-line.prod-code = buf_gds-obj.prod-code
     2324             and buf_stk-line.sum-type  = 'crsa':U
     2325             and buf_stk-line.cat-id    = '##,##'
     2326             and buf_stk-line.fact-order  < fo
     2327           use-index category no-error .
     2328           if not available buf_stk-line then assign stat = yes .
     2329           else do:
     2330             assign fo   = buf_stk-line.fact-order .
     2331             if buf_stk-line.fact-qnty <> 0 then do:
     2332               assign
     2333                 temp-DiscSales.day = x-date - buf_stk-line.fact-date
     2334                 stat = yes
     2335               .
     2336             end.
     2337           end.
     2338         end.
     2339       end.
     2340       do ii = 1 to 8 :
     2341         case ii :
     2342           when 1 then assign str-find = 'sadt':U + 'ee':U .
     2343           when 2 then assign str-find = 'sadt':U + 'es':U .
     2344           when 3 then assign str-find = 'sadt':U + 're':U .
     2345           when 4 then assign str-find = 'sadt':U + 'rs':U .
     2346           when 5 then assign str-find = 'csdt':U + 'ee':U .
     2347           when 6 then assign str-find = 'csdt':U + 'es':U .
     2348           when 7 then assign str-find = 'csdt':U + 're':U .
     2349           when 8 then assign str-find = 'csdt':U + 'rs':U .
     2350         end.
     2351         find last buf_stk-line no-lock
     2352           where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     2353             and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     2354             and buf_stk-line.artic     = buf_goods.artic
     2355             and buf_stk-line.prod-type = buf_gds-obj.prod-type
     2356             and buf_stk-line.prod-code = buf_gds-obj.prod-code
     2357             and buf_stk-line.sum-type  = str-find
     2358             and buf_stk-line.cat-id    = '##,##'
     2359             and buf_stk-line.fact-order  <= v-fact-order-start
     2360         use-index category no-error .
     2361         if available buf_stk-line then do:
     2362           case ii :
     2363             when 1 or when 2 then assign temp-DiscSales.sum-sale = temp-DiscSales.sum-sale + buf_stk-line.sum-rubl .
     2364             when 3 or when 4 then assign temp-DiscSales.sum-sale = temp-DiscSales.sum-sale - buf_stk-line.sum-rubl .
     2365             when 5 or when 6 then assign temp-DiscSales.sum-cost = temp-DiscSales.sum-cost + buf_stk-line.sum-rubl .
     2366             when 7 or when 8 then assign temp-DiscSales.sum-cost = temp-DiscSales.sum-cost - buf_stk-line.sum-rubl .
     2367           end.
     2368         end.
     2369         find last buf_stk-line no-lock
     2370           where buf_stk-line.obj-type  = buf_gds-obj.obj-type
     2371             and buf_stk-line.obj-code  = buf_gds-obj.obj-code
     2372             and buf_stk-line.artic     = buf_goods.artic
     2373             and buf_stk-line.prod-type = buf_gds-obj.prod-type
     2374             and buf_stk-line.prod-code = buf_gds-obj.prod-code
     2375             and buf_stk-line.sum-type  = str-find
     2376             and buf_stk-line.cat-id    = '##,##'
     2377             and buf_stk-line.fact-order  < v-fact-order-end
     2378         use-index category no-error .
     2379         if available buf_stk-line then do:
     2380           case ii :
     2381             when 1 or when 2 then assign temp-DiscSales.sum-sale = temp-DiscSales.sum-sale - buf_stk-line.sum-rubl .
     2382             when 3 or when 4 then assign temp-DiscSales.sum-sale = temp-DiscSales.sum-sale + buf_stk-line.sum-rubl .
     2383             when 5 or when 6 then assign temp-DiscSales.sum-cost = temp-DiscSales.sum-cost - buf_stk-line.sum-rubl .
     2384             when 7 or when 8 then assign temp-DiscSales.sum-cost = temp-DiscSales.sum-cost + buf_stk-line.sum-rubl .
     2385           end.
     2386         end.
     2387       end.
     2388     end.
     2389             end.
     2390           end.
     2391         end case.
     2392       end.
     2393     end.
     2394     assign
     2395       make-excel = yes
     2396       v-file-name = string(session :temp-directory) + "rpt" + string( g#report-num ) + ".txt"
     2397     .
     2398     output stream macr_excel to value(v-file-name) .
     2399   if session :set-wait-state( "compiler" ) then.
     2400     Line = fill("-", 250).
     2401     DEFINE frame f-doc
     2402         sym1  temp-DiscSales.artic      column-label " Артикул!       "            format "X(12)"                space(0)
     2403         sym2  v-prod                    column-label " Произ-!водитель"            format "X(8)"                 space(0)
     2404         sym3  temp-DiscSales.gds-name   column-label " Наименование товара! "      format "X(40)"                space(0)
     2405         sym4  temp-DiscSales.sum-sale   column-label "Реализовано !в розн. ценах"  format "->>>,>>>,>>>,>>9.99"  space(0)
     2406         sym5  v-prc                     column-label "Наценка! % "                 format "->>>>9.99"            space(0)
     2407         sym6  temp-DiscSales.day        column-label "Дни без!товара"              format ">>>>>9"                space(0)
     2408         sym7  temp-DiscSales.last-post  column-label "Послед.!постав"              format "99/99/99"             space(0)
     2409         sym8
     2410     HEADER
     2411         string( "Дата печати : " + string(TODAY , "99.99.9999") + " , " + string(TIME, "HH:MM") ) AT 5 format "X(60)"
     2412         string( "Страница " + string( PAGE-NUMBER( OutStream )  , ">>9") ) AT 70 format "X(15)" SKIP
     2413         Line format "X(118)" AT 1
     2414     with width 160 down stream-io.
     2415   output stream OutStream to value( string( session:temp-directory +
     2416                                        "rpt" + string( g#report-num ) ) )
     2417                                        page-size  value(62) .
     2418     FORM HEADER
     2419         Line format "X(118)" AT 1 SKIP
     2420         "Продолжение - на следующей странице" AT 30 SKIP
     2421         with FRAME BottomFrame width 160 PAGE-BOTTOM NO-LABELS NO-BOX .
     2422     VIEW stream OutStream FRAME BottomFrame .
     2423     FORM with FRAME f-doc .
     2424     PUT stream OutStream SPACE(30) "Отчет по закончившимся наименованиям"  SKIP .
     2425     PUT stream OutStream str1 format "X(100)" SKIP .
     2426     PUT stream OutStream "присутствовал с: " x-date-start format "99/99/9999" "г. по: " x-date-end format "99/99/9999" "г." SKIP .
     2427     assign  v-NameString = "Выбор объекта: " .
     2428     for each obj-list no-lock:
     2429       Assign  v-NameString = v-NameString + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), " .
     2430       PUT stream OutStream v-NameString format "X(100)" SKIP .
     2431     end.
     2432     assign  v-NameString = "Выбор товара: " .
     2433     case x-SelectGood :
     2434       when 1        then assign v-NameString = v-NameString + "по всем товарам"  .
     2435       when 2        then assign v-NameString = v-NameString + "по группам"  .
     2436       when 3       then assign v-NameString = v-NameString + "по производителям"  .
     2437       when 4     then assign v-NameString = v-NameString + "выборочно"  .
     2438       when 5        then assign v-NameString = v-NameString + "выборочно"  .
     2439       when 6       then assign v-NameString = v-NameString + "хранимый список"  .
     2440       when 7   then assign v-NameString = v-NameString + "по группам и по производителям"  .
     2441     end case .
     2442     PUT stream OutStream v-NameString format "X(100)" SKIP .
     2443     run PutColumnTitulExcel in this-procedure .
     2444     if NullStr = no then do:
     2445       for each temp-DiscSales : if temp-DiscSales.sum-sale = 0 and temp-DiscSales.sum-cost = 0 then delete temp-DiscSales . end.
     2446     end.
     2447     for each temp-DiscSales break by temp-DiscSales.grp-name :
     2448       if  ( v-row ) >= 63000 then do:
     2449         Output stream Macr_Excel  close .
     2450         run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name ) .
     2451         run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     2452         output stream  Macr_Excel to value(v-file-name) .
     2453         run PutColumnTitulExcel in this-procedure .
     2454       end.
     2455       if first-of(temp-DiscSales.grp-name) then do:
     2456         display stream outstream  sym1  string("Группа " + temp-DiscSales.grp-name) @ temp-DiscSales.gds-name  sym2  sym3  sym4  with frame f-doc.
     2457         down stream outstream with frame f-doc .
     2458         run macr_excel_char("Группа " + temp-DiscSales.grp-name ,  v-row, 3) .       assign v-row = v-row + 1 .
     2459         assign
     2460           v-sum-cost = 0
     2461           v-sum-sale = 0
     2462         .
     2463       end.
     2464       assign
     2465         v-prc = (temp-DiscSales.sum-sale - temp-DiscSales.sum-cost) * 100 / temp-DiscSales.sum-cost
     2466         v-sum-cost = v-sum-cost + temp-DiscSales.sum-cost
     2467         v-sum-sale = v-sum-sale + temp-DiscSales.sum-sale
     2468         v-prod = string(temp-DiscSales.prod-type + " " + string(temp-DiscSales.prod-code))
     2469       .
     2470       if v-prc = ? then v-prc = 0 .
     2471       display stream outstream
     2472         sym1  temp-DiscSales.artic
     2473         sym2  v-prod
     2474         sym3  temp-DiscSales.gds-name
     2475         sym4  temp-DiscSales.sum-sale
     2476         sym5  v-prc
     2477         sym6  temp-DiscSales.day
     2478         sym7  temp-DiscSales.last-post
     2479         sym8
     2480       with frame f-doc.
     2481       down stream outstream with frame f-doc .
     2482       assign v-col = 1 .
     2483       run macr_excel_char( temp-DiscSales.artic     ,  v-row, v-col) .       assign v-col = v-col + 1 .
     2484       run macr_excel_char( v-prod                   ,  v-row, v-col) .       assign v-col = v-col + 1 .
     2485       run macr_excel_char( temp-DiscSales.gds-name  ,  v-row, v-col) .       assign v-col = v-col + 1 .
     2486       run macr_excel_sum ( temp-DiscSales.sum-sale  ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     2487       run macr_excel_sum ( v-prc                    ,  v-row, v-col,  2) .   assign v-col = v-col + 1 .
     2488       run macr_excel_sum ( temp-DiscSales.day       ,  v-row, v-col,  0) .   assign v-col = v-col + 1 .
     2489       run macr_excel_char( if temp-DiscSales.last-post <> ? then string(temp-DiscSales.last-post,"99/99/99") else "01/01/90" ,  v-row, v-col) .       assign v-col = v-col + 1 .
     2490       assign v-row = v-row + 1 .
     2491       if last-of(temp-DiscSales.grp-name) then do:
     2492         assign v-prc = (v-sum-sale - v-sum-cost) * 100 / v-sum-cost .
     2493         if v-prc = ? then v-prc = 0 .
     2494         display stream outstream
     2495           sym1  string("Итого по " + temp-DiscSales.grp-name) @ temp-DiscSales.gds-name
     2496           sym2  v-sum-sale @ temp-DiscSales.sum-sale
     2497           sym3  v-prc
     2498           sym4
     2499           sym5
     2500           sym6
     2501           sym7
     2502           sym8
     2503         with frame f-doc.
     2504         down stream outstream with frame f-doc .
     2505         run macr_excel_char("Итого по " + temp-DiscSales.grp-name ,  v-row, 3) .
     2506         run macr_excel_sum ( v-sum-sale ,  v-row, 4,  2) .
     2507         run macr_excel_sum ( v-prc ,  v-row, 5,  2) .
     2508         assign v-row = v-row + 1 .
     2509       end.
     2510     End.
     2511     PUT STREAM OutStream Line format "X(118)".
     2512     HIDE stream OutStream FRAME BottomFrame .
     2513     OUTPUT stream OutStream CLOSE.
     2514   if mFrameView
     2515   then do:
     2516      HIDE FRAME InfoFrame.
     2517   end.
     2518   if session :set-wait-state( "" ) then.
     2519     output stream macr_excel close .
     2520     run paramls-write in this-procedure (input "file",input string(v-ind),input v-file-name) .
     2521     run end-proc .
     2522     define variable v-user-action as character no-undo .
     2523     define variable v-printed as logical   no-undo .
     2524     run gbl/prnfilen.w
     2525       (input  ""
     2526       ,input  0
     2527       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2528       ,input  7
     2529       ,output v-user-action
     2530       ,output v-printed
     2531       ) .
     2532   end.
     2533   procedure PutColumnTitulExcel :
     2534     do
     2535     on error undo, return error return-value
     2536     :
     2537     assign
     2538       v-ind = v-ind + 1
     2539       v-row = 4
     2540       v-col = 1
     2541     .
     2542     run macr_excel_char ("Отчет по закончившимся наименованиям", 1, 3) .
     2543     run macr_cell_format( 11, yes, no, ?, 1, 3, 1, 3) .
     2544     run macr_excel_char (Str1 , 2, 1) .
     2545     run macr_excel_char (String("присутствовал с: " + string(x-date-start,"99/99/9999") + "г. по: " + string(x-date-end,"99/99/9999") + "г.") , 3, 1) .
     2546     for each obj-list no-lock:
     2547       run macr_excel_char ( string("Выбор объекта: " + obj-list.obj-name + " (" + obj-list.obj-type + '#' + string(obj-list.obj-code)  + "), ") , v-row, v-col) .
     2548       assign v-col = v-col + 1 .
     2549     end.
     2550     assign
     2551       v-col = 1
     2552       v-row = v-row + 1
     2553     .
     2554     case x-SelectGood :
     2555       when 1       then run macr_excel_char ("Выбор товара: по всем товарам" , v-row, v-col) .
     2556       when 2       then run macr_excel_char ("Выбор товара: по группам" , v-row, v-col) .
     2557       when 3      then run macr_excel_char ("Выбор товара: по производителям" , v-row, v-col) .
     2558       when 4    then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     2559       when 5       then run macr_excel_char ("Выбор товара: выборочно" , v-row, v-col) .
     2560       when 6      then run macr_excel_char ("Выбор товара: хранимый список" , v-row, v-col) .
     2561       when 7  then run macr_excel_char ("Выбор товара: по группам и по производителям" , v-row, v-col) .
     2562     end case .
     2563     assign  v-row = v-row + 1 .
     2564     run macr_excel_char("Артикул", v-row, v-col) .
     2565     run macr_cell_size (12,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2566     run macr_excel_char("Производитель", v-row, v-col) .
     2567     run macr_cell_size (15,?, v-row, v-col,?,?).       assign v-col = v-col + 1 .
     2568     run macr_excel_char("Наименование товара", v-row, v-col) .
     2569     run macr_cell_size (40,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2570     run macr_excel_char("Реализовано в розн. ценах.", v-row, v-col) .
     2571     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2572     run macr_excel_char("Наценка %", v-row, v-col) .
     2573     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2574     run macr_excel_char("Дни без товара.", v-row, v-col) .
     2575     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2576     run macr_excel_char("Послед. поставка", v-row, v-col) .
     2577     run macr_cell_size (14,?, v-row, v-col,?,?).      assign v-col = v-col + 1 .
     2578     run macr_cell_bordur ( v-row , 1, v-row, 7) .
     2579     run macr_cell_format ( 10, yes, no, 35, v-row , 1, v-row, 7) .
     2580     assign
     2581       v-row = v-row + 1
     2582       v-col = 1
     2583     .
     2584     end.
     2585   end procedure.
