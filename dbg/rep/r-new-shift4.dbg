      100   def
      101    shared
      102   temp-table  obj-list no-undo
      103     field obj-type like ub.clients.obj-type
      104     field obj-code like ub.clients.obj-code
      105     field obj-name like ub.clients.obj-name
      106     field obj-id   as integer
      107     field db-num   as integer
      108     index pi is primary unique obj-id
      109     index ie1 obj-type obj-code
      110     index ie2 obj-name
      111   .
      112   procedure create_obj-list :
      113      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      114      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      115      do
      116      on error undo, return error return-value
      117      :
      118         define buffer cli-obj for ub.clients .
      119         define variable p-var as integer no-undo .
      120         define buffer buf_obj-list for obj-list .
      121         find last buf_obj-list  use-index pi no-error .
      122         if available buf_obj-list
      123         then
      124            p-var = buf_obj-list.obj-id + 1.
      125         else
      126            p-var = 1.
      127         find first cli-obj where
      128                   cli-obj.obj-type = p-obj-type
      129               and cli-obj.obj-code = p-obj-code
      130         no-lock no-error.
      131         if available cli-obj
      132         then do:
      133            create buf_obj-list.
      134            assign
      135               buf_obj-list.obj-id   = p-var
      136               buf_obj-list.obj-code = cli-obj.obj-code
      137               buf_obj-list.obj-type = cli-obj.obj-type
      138               buf_obj-list.obj-name = cli-obj.obj-name
      139               buf_obj-list.db-num   = cli-obj.db-num
      140            .
      141         end.
      142      end.
      143   end.
