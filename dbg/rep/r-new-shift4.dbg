      640   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      641   PROCEDURE create-treal-4.
      642   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      643   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      644   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      645   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      646   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      647   DEFINE INPUT PARAMETER pout-name as character no-undo.
      648   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      649   DEFINE INPUT PARAMETER pii as integer no-undo.
      650   _main:
      651   DO ON ERROR UNDO _main, return error:
      652       create treal-4.
      653       assign
      654       treal-4.gds-code = pgds-code
      655       treal-4.cpay-code = pcpay-code
      656       treal-4.curr-code = pcurr-code
      657       treal-4.qnty1  =  pqnty1
      658       treal-4.netto = pnetto
      659       treal-4.out-name = pout-name
      660       treal-4.is-pay = pis-pay
      661       treal-4.ii = pii
      662       no-error
      663       .
      664       if error-status:error then undo _main, return error.
      665   END.
      666   END PROCEDURE.
      667   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   PROCEDURE create-actreal-4.
      669   DEFINE INPUT PARAMETER pgds-code like ub.goods.gds-code no-undo.
      670   DEFINE INPUT PARAMETER pcpay-code like ub.cash-pay.cdpay-code no-undo.
      671   DEFINE INPUT PARAMETER pcurr-code like ub.cash-pay.curr-code no-undo.
      672   DEFINE INPUT PARAMETER pqnty1 as decimal no-undo.
      673   DEFINE INPUT PARAMETER pnetto as decimal no-undo.
      674   DEFINE INPUT PARAMETER pout-name as character no-undo.
      675   DEFINE INPUT PARAMETER pis-pay as logical no-undo.
      676   DEFINE INPUT PARAMETER pii as integer no-undo.
      677   _main:
      678   DO ON ERROR UNDO _main, return error:
      679       create actreal-4.
      680       assign
      681       actreal-4.gds-code = pgds-code
      682       actreal-4.cpay-code = pcpay-code
      683       actreal-4.curr-code = pcurr-code
      684       actreal-4.qnty1  =  pqnty1
      685       actreal-4.netto = pnetto
      686       actreal-4.out-name = pout-name
      687       actreal-4.is-pay = pis-pay
      688       actreal-4.ii = pii
      689       no-error
      690       .
      691       if error-status:error then undo _main, return error.
      692   END.
      693   END PROCEDURE.
      694   define NEW SHARED temp-table tmat-4 no-undo
      695     field netto-before as decimal   format "-999,999,999.99":U
      696     field netto-after  as decimal   format "-999,999,999.99":U
      697     field in-benefit   as decimal   format "999,999,999.99":U
      698     field in-other     as decimal   format "999,999,999.99":U
      699     field out-bank     as decimal   format "999,999,999.99":U
      700     field out-other    as decimal   format "999,999,999.99":U
      701     field out-name     as character format "x(16)":U
      702     field gg           as integer
      703     index igg          is primary   unique gg
      704   .
      705   define shared stream  PrnLibstream.
      706   define variable pol1 as character no-undo .
      707   define variable pol2 as integer no-undo .
      708   define variable pol3 as decimal no-undo .
      709   define variable pol4 as character no-undo .
      710   define variable pol5 as decimal no-undo .
      711   define variable pol6 as decimal no-undo .
      712   define stream Out-Stream.
      713   define stream OutStr-html.
      714   define variable line as character no-undo .
      715   DEFINE VARIABLE  areal-is-pay-qnty1 as decimal no-undo.
      716   DEFINE VARIABLE  areal-is-pay-netto as decimal no-undo.
      717   DEFINE VARIABLE  areal-no-pay-qnty1 as decimal no-undo.
      718   DEFINE VARIABLE  areal-no-pay-netto as decimal no-undo.
      719   DEFINE VARIABLE  areal-qnty1 as decimal no-undo.
      720   DEFINE VARIABLE  areal-netto as decimal no-undo.
      721   DEFINE VARIABLE  v-total-is-pay-qnty1 as decimal no-undo.
      722   DEFINE VARIABLE  v-total-is-pay-netto as decimal no-undo.
      723   DEFINE VARIABLE  v-total-no-pay-qnty1 as decimal no-undo.
      724   DEFINE VARIABLE  v-total-no-pay-netto as decimal no-undo.
      725   DEFINE VARIABLE  v-total-qnty1 as decimal no-undo.
      726   DEFINE VARIABLE  v-total-netto as decimal no-undo.
      727   DEFINE VARIABLE  a-qnty1 as decimal no-undo.
      728   DEFINE VARIABLE  a-netto as decimal no-undo.
      729   DEFINE VARIABLE  loc-real-ii as integer no-undo.
      730   DEFINE VARIABLE  curr-real-ii as integer no-undo.
      731   DEFINE VARIABLE  jj as integer no-undo.
      732   DEFINE VARIABLE  loc-jj as integer no-undo.
      733   DEFINE VARIABLE main-line as logical no-undo.
      734   DEFINE VARIABLE mat-line as logical no-undo.
      735   DEFINE VARIABLE pay-line as logical no-undo.
      736   DEFINE VARIABLE a-line as logical no-undo.
      737   DEFINE VARIABLE max-line as integer no-undo.
      738   DEFINE VARIABLE max-real as integer no-undo.
      739   DEFINE VARIABLE rc as recid no-undo.
      740   DEFINE VARIABLE acii as integer no-undo .
      741     procedure on-same-page :
      742       define input parameter p-line-number as integer no-undo .
      743       if p-line-number > page-size( PrnLibstream )
      744       then do:
      745         return .
      746       end.
      747       if line-counter( PrnLibstream ) + p-line-number > page-size( PrnLibstream )
      748       then do:
      749         page stream PrnLibstream .
      750       end.
      751     end procedure.
      752   run rep/r-shft4r.p
      753     (input p-obj-type,
      754     input p-obj-code,
      755     input X-date-Start,
      756     input X-Shift-Start,
      757     input X-date-End,
      758     input X-Shift-End,
      759     input p-previous-shift-date
      760     ) no-error.
      761   output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
      762   put stream OutStr-html unformatted
      763     substitute (
      764     '<tbody> <!-- Здесь начинается таблица отчета -->
      765                   <tr> <!-- Первые строки – шапка таблицы с тэгами tr -->
      766                   <th colspan="3" style="text-align: center;">Информация об услуге</th>
      767                   <th colspan="3" style="text-align: center;">Расшифровка реализации услуг</th>
      768               </tr>
      769               <tr>
      770                   <th style="text-align: center;">Наименование услуги</th>
      771                   <th style="text-align: center;">Код услуги</th>
      772                   <th style="text-align: center;">Цена рознич. на конец смены</th>
      773                   <th style="text-align: center;">Тип расхода (тип платежа)</th>
      774                   <th style="text-align: center;">Кол-во</th>
      775                   <th style="text-align: center;">Сумма</th>
      776               </tr>
      777               <tr>
      778                   <th style="text-align: center;">4.1</th>
      779                   <th style="text-align: center;">4.2</th>
      780                   <th style="text-align: center;">4.3</th>
      781                   <th style="text-align: center;">4.4</th>
      782                   <th style="text-align: center;">4.5</th>
      783                   <th style="text-align: center;">4.6</th>
      784               </tr>
      785               '
      786     , chr(123), chr(125)
      787     ).
      788   for each actreal-4:
      789     delete actreal-4.
      790   end.
      791   FOR EACH t-4 use-index pi:
      792     assign
      793     areal-is-pay-qnty1 = 0
      794     areal-is-pay-netto = 0
      795     areal-no-pay-qnty1 = 0
      796     areal-no-pay-netto = 0
      797     areal-qnty1 = 0
      798     areal-netto = 0
      799     loc-real-ii = 1
      800     curr-real-ii = 1
      801     .
      802     FIND LAST treal-4 No-LOCK WHERE
      803               treal-4.gds-code = t-4.gds-code AND
      804               treal-4.is-pay = yes use-index vi No-ERROR.
      805     if avail treal-4 then
      806     assign
      807     loc-real-ii = treal-4.ii + 1
      808     curr-real-ii = treal-4.ii + 1
      809     .
      810     IF can-find(first treal-4 WHERE
      811                       treal-4.gds-code = t-4.gds-code) then do:
      812       FOR EACh  treal-4 where
      813                 treal-4.gds-code = t-4.gds-code use-index pi:
      814         assign
      815         areal-qnty1 = areal-qnty1 + treal-4.qnty1
      816         areal-netto = areal-netto + treal-4.netto
      817         .
      818         if treal-4.is-pay then
      819         assign
      820         areal-is-pay-qnty1 = areal-is-pay-qnty1 + treal-4.qnty1
      821         areal-is-pay-netto = areal-is-pay-netto + treal-4.netto
      822         .
      823        else
      824         assign
      825         rc = recid(treal-4)
      826         curr-real-ii = (if curr-real-ii = loc-real-ii AND
      827                            (loc-real-ii > 1   OR
      828                             can-find(first treal-4 No-LOCK WHERE
      829                                            treal-4.gds-code = t-4.gds-code AND
      830                                            treal-4.is-pay = no AND
      831                                            recid(treal-4) <> rc)
      832                             )
      833                         then (curr-real-ii + 1)
      834                         else curr-real-ii
      835                        )
      836         treal-4.ii = curr-real-ii
      837         curr-real-ii = curr-real-ii + 1
      838         areal-no-pay-qnty1 = areal-no-pay-qnty1 + treal-4.qnty1
      839         areal-no-pay-netto = areal-no-pay-netto + treal-4.netto
      840         .
      841       END.
      842       if curr-real-ii > 2 then do:
      843         run create-treal-4 (
      844                             INPUT t-4.gds-code,
      845                             INPUT 0,
      846                             INPUT 0,
      847                             INPUT areal-is-pay-qnty1,
      848                             INPUT areal-is-pay-netto,
      849                             INPUT "ИТОГО ОПЛАЧ.РАСХОД",
      850                             INPUT yes,
      851                             INPUT loc-real-ii) no-error.
      852         if loc-real-ii = curr-real-ii then
      853         curr-real-ii = curr-real-ii + 1.
      854         run create-treal-4 (
      855                             INPUT t-4.gds-code,
      856                             INPUT 0,
      857                             INPUT 0,
      858                             INPUT areal-no-pay-qnty1,
      859                             INPUT areal-no-pay-netto,
      860                             INPUT "ИТОГО ПРОЧ.РАСХОДОВ",
      861                             INPUT no,
      862                             INPUT curr-real-ii) no-error.
      863         curr-real-ii = curr-real-ii + 1.
      864         run create-treal-4 (
      865                             INPUT t-4.gds-code,
      866                             INPUT 0,
      867                             INPUT 0,
      868                             INPUT areal-qnty1,
      869                             INPUT areal-netto,
      870                             INPUT "ВСЕГО  РАСХОД",
      871                             INPUT ?,
      872                             INPUT curr-real-ii) no-error.
      873       END.
      874     END.
      875     assign
      876     t-4.lines = MAX(curr-real-ii, 1)
      877     .
      878   END.
      879   FOR EACH t-4 No-LOCK,
      880       EACH treal-4 No-LOCK WHERE
      881            treal-4.gds-code = t-4.gds-code
      882      BREAK BY treal-4.gds-code
      883            BY treal-4.is-pay descending
      884            BY treal-4.ii:
      885       assign
      886       pol1 = ""
      887       pol2 = 0
      888       pol3 = 0
      889       pol4 = ""
      890       pol5 = 0
      891       pol6 = 0
      892       main-line = no
      893       pay-line = no
      894       .
      895      IF FIRST-OF(treal-4.gds-code) then do:
      896         assign
      897         pol1 = t-4.gds-name
      898         pol2 = t-4.main-code
      899         pol3 = t-4.last-price
      900         main-line = yes
      901         a-netto = a-netto + treal-4.netto
      902         a-qnty1 = a-qnty1 + treal-4.qnty1
      903         .
      904      END.
      905      assign
      906      pol4 = treal-4.out-name
      907      pol5 = treal-4.qnty1
      908      pol6 = treal-4.netto
      909      .
      910      if treal-4.cpay-code <> 0 then dO:
      911       FIND FIRST actreal-4 WHERE
      912                     actreal-4.gds-code = 0 AND
      913                     actreal-4.cpay-code = treal-4.cpay-code AND
      914                     actreal-4.curr-code = treal-4.curr-code AND
      915                     actreal-4.is-pay = treal-4.is-pay NO-ERROR.
      916           if not avail actreal-4 then do:
      917             acii = acii + 1.
      918             run create-actreal-4 (
      919                                 INPUT 0,
      920                                 INPUT treal-4.cpay-code,
      921                                 INPUT treal-4.curr-code,
      922                                 INPUT treal-4.qnty1,
      923                                 INPUT treal-4.netto,
      924                                 INPUT treal-4.out-name,
      925                                 INPUT treal-4.is-pay,
      926                                 INPUT acii) no-error.
      927           end.
      928           else
      929           assign
      930           actreal-4.qnty1 = actreal-4.qnty1 + treal-4.qnty1
      931           actreal-4.netto = actreal-4.netto + treal-4.netto
      932           .
      933      end.
      934       put stream OutStr-html unformatted
      935         substitute (
      936         '<tr>
      937                   <td text_wrap="true">&1</td>
      938                   <td style="text-align: right;">&2</td>
      939                   <td style="text-align: right;">&3</td>
      940                   <td text_wrap="true">&4</td>
      941                   <td style="text-align: right;">&5</td>
      942                   <td style="text-align: right;">&6</td>
      943               </tr>    
      944                   '
      945         ,
      946         if main-line = no then "" else string(pol1),
      947         if main-line = no then "" else string(pol2),
      948         if main-line = no then "" else string(pol3,"->>>>>>>>>>>9.99"),
      949         pol4,
      950         string(pol5,"->>>>>>>>>>>9"),
      951         string(pol6,"->>>>>>>>>>>9.99")
      952         ).
      953       IF LAST(treal-4.gds-code) then do:
      954         assign
      955         pol1 = "ВСЕГО РЕАЛИЗОВАНО УСЛУГ  :"
      956         pol5 = a-qnty1
      957         pol6 = a-netto
      958         .
      959       put stream OutStr-html unformatted
      960         substitute (
      961         '<tr>
      962                   <th text_wrap="true" style="text-align: left">&1</th>
      963                   <th></th>
      964                   <th></th>
      965                   <th></th>
      966                   <th style="text-align: right;">&2</th>
      967                   <th style="text-align: right;">&3</th>
      968               </tr>    
      969                   '
      970         ,
      971         pol1,
      972         string(pol5,"->>>>>>>>>>>9"),
      973         string(pol6,"->>>>>>>>>>>9.99")
      974         ).
      975         if can-find(first actreal-4) then do:
      976           pol4 = "     в том числе:".
      977       put stream OutStr-html unformatted
      978         substitute (
      979         '<tr>
      980                   <td></td>
      981                   <td></td>
      982                   <td></td>
      983                   <td text_wrap="true" style="text-align: left;">&1</td>
      984                   <td></td>
      985                   <td></td>
      986               </tr>    
      987                   '
      988         ,
      989         pol4
      990         ).
      991           assign
      992           areal-is-pay-qnty1 = 0
      993           areal-is-pay-netto = 0
      994           areal-no-pay-qnty1 = 0
      995           areal-no-pay-netto = 0
      996           .
      997           FOR EACH actreal-4 No-LOCK
      998           BREAK
      999           BY actreal-4.gds-code
     1000           By actreal-4.is-pay descending
     1001           BY actreal-4.cpay-code descending
     1002           BY actreal-4.curr-code:
     1003             if actreal-4.is-pay = yes then
     1004             assign
     1005             areal-is-pay-qnty1 = areal-is-pay-qnty1 + actreal-4.qnty1
     1006             areal-is-pay-netto = areal-is-pay-netto + actreal-4.netto
     1007             .
     1008             else
     1009             assign
     1010             areal-no-pay-qnty1 = areal-no-pay-qnty1 + actreal-4.qnty1
     1011             areal-no-pay-netto = areal-no-pay-netto + actreal-4.netto
     1012             .
     1013             assign
     1014             pol4 = actreal-4.out-name
     1015             pol5 = actreal-4.qnty1
     1016             pol6 = actreal-4.netto
     1017             .
     1018       put stream OutStr-html unformatted
     1019         substitute (
     1020         '<tr>
     1021                   <td></td>
     1022                   <td></td>
     1023                   <td></td>
     1024                   <td>&1</td>
     1025                   <td style="text-align: right;">&2</td>
     1026                   <td style="text-align: right;">&3</td>
     1027               </tr>    
     1028                   '
     1029         ,
     1030         pol4,
     1031         string(pol5,"->>>>>>>>>>>9"),
     1032         string(pol6,"->>>>>>>>>>>9.99")
     1033         ).
     1034           if last-of(actreal-4.is-pay)  then do:
     1035               if actreal-4.is-pay = yes then
     1036               assign
     1037               pol4 = "ИТОГО ОПЛАЧ.РАСХОД"
     1038               pol5 = areal-is-pay-qnty1
     1039               pol6 = areal-is-pay-netto
     1040               .
     1041               else
     1042               assign
     1043               pol4 = "ИТОГО ПРОЧ.РАСХОД"
     1044               pol5 = areal-no-pay-qnty1
     1045               pol6 = areal-no-pay-netto
     1046               .
     1047       put stream OutStr-html unformatted
     1048         substitute (
     1049         '<tr>
     1050                   <td></td>
     1051                   <td></td>
     1052                   <td></td>
     1053                   <td text_wrap="true">&1</td>
     1054                   <td style="text-align: right;">&2</td>
     1055                   <td style="text-align: right;">&3</td>
     1056               </tr>    
     1057                   '
     1058         ,
     1059         pol4,
     1060         string(pol5,"->>>>>>>>>>>9"),
     1061         string(pol6,"->>>>>>>>>>>9.99")
     1062         ).          end.
     1063           END.
     1064         end.
     1065      end.
     1066   END.
     1067        output stream OutStr-html close.
     1068        output stream OutStr-html to value(v-report-name-html) append convert target 'UTF-8' .
     1069        put stream OutStr-html unformatted
     1070           substitute (
     1071           '
     1072           </tbody>
     1073           '
     1074               , chr(123), chr(125)
     1075          ).
     1076         output stream OutStr-html close.
