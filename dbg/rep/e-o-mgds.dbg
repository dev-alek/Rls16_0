      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      570   procedure proc-alt-shift-f2:
      571     if not ibs.th.gbl.gbl-var:rcode
      572   then
      573     run gbl\inidebug.p .
      574   end.
      575   procedure proc-alt-shift-f3:
      576     run gbl/prvssinf.p
      577       ( input this-procedure
      578       ) .
      579   end.
      580   define variable v-inform-launched as logical no-undo initial false .
      581   procedure proc-alt-shift-f4:
      582     define variable v-action as character no-undo .
      583     if v-inform-launched = false then do:
      584       assign
      585         v-inform-launched = true
      586       .
      587       run gbl/d-inform.w
      588         (  input self
      589         ,  input this-procedure
      590         , output v-action
      591         ) no-error .
      592       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      593       assign
      594         v-inform-launched = false
      595       .
      596     end.
      597   end.
      598   procedure proc-alt-f1:
      599     run gbl/corrhelp.p
      600       (input this-procedure
      601       ) .
      602   end .
      603   on alt-shift-f2 anywhere do:
      604     run proc-alt-shift-f2.
      605   end.
      606   on alt-shift-f3 anywhere do:
      607     run proc-alt-shift-f3 in this-procedure .
      608   end.
      609   on alt-shift-f4 anywhere do:
      610     run proc-alt-shift-f4 in this-procedure.
      611   end.
      612   on alt-f1 anywhere do:
      613     run proc-alt-f1 in this-procedure .
      614   end.
      615   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      616     define variable v-cntxt-db-num        as integer   no-undo .
      617     define variable v-cntxt-userid        as character no-undo .
      618     define variable v-cntxt-level         as character no-undo .
      619     define variable v-cntxt-host-code-obj as integer   no-undo .
      620     define variable v-cntxt-obj-type      as character no-undo .
      621     define variable v-cntxt-obj-code      as integer   no-undo .
      622     define variable v-cntxt-db-num-obj    as integer   no-undo .
      623     define variable v-cntxt-is-admin      as logical   no-undo .
      624   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      625     run mainmenu_getcntxt in my-handle
      626       (output v-cntxt-db-num
      627       ,output v-cntxt-userid
      628       ,output v-cntxt-level
      629       ,output v-cntxt-host-code-obj
      630       ,output v-cntxt-obj-type
      631       ,output v-cntxt-obj-code
      632       ,output v-cntxt-db-num-obj
      633       ,output v-cntxt-is-admin
      634       ) .
      635   define variable base-type as character no-undo .
      636   define variable base-code as integer   no-undo .
      637   define variable g#report-num as integer   no-undo .
      638   define variable g#gds-engl as logical   no-undo .
      639   define variable vv-exch-rate  as decimal   no-undo .
      640   define variable vv-exch-scale as decimal   no-undo .
      641   define variable v-cntxt-host-name-obj as character no-undo .
      642   if v-cntxt-level = 'object':U then do:
      643   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      644   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
      645     (input  v-cntxt-obj-type
      646     ,input  v-cntxt-obj-code
      647     ,output v-cntxt-host-code-obj
      648     ,output v-cntxt-host-name-obj
      649     )  .
      650   end.
      651   if v-cntxt-level = 'firm':U then do:
      652     find first ub.clients no-lock where
      653                ub.clients.obj-type = 'орг':U and
      654                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
      655   if error-status :error then v-cntxt-host-name-obj = ? .
      656      else v-cntxt-host-name-obj = ub.clients.obj-name.
      657   end.
      658   if v-cntxt-level = 'object':U
      659   or v-cntxt-level = 'firm':U
      660   then do:
      661   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      662   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
      663     (input  v-cntxt-host-code-obj
      664     ,output base-code
      665     )  .
      666   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      667   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
      668     (input  base-code
      669     ,input  today
      670     ,output vv-exch-rate
      671     ,output vv-exch-scale
      672     ,output base-type
      673     )  .
      674   end.
      675   run get-report-num in my-handle ( output g#report-num ).
      676   run get-gds-engl in my-handle ( output g#gds-engl ) .
      677   CREATE WIDGET-POOL.
      678   def var State-source as  WIDGET-HANDLE.
      679   DEFINE VARIABLE COMBO-node AS CHARACTER FORMAT "X(40)":U INITIAL "касса"
      680        LABEL "Типы документов"
      681        VIEW-AS COMBO-BOX INNER-LINES 6
      682        LIST-ITEMS "касса"
      683        DROP-DOWN-LIST
      684        SIZE 40.75 BY 1
      685        BGCOLOR 15  NO-UNDO.
      686   DEFINE VARIABLE FILL-IN-1 AS CHARACTER FORMAT "X(256)":U INITIAL "Сортировка:"
      687         VIEW-AS TEXT
      688        SIZE 11.88 BY .67
      689        FGCOLOR 4  NO-UNDO.
      690   DEFINE VARIABLE Classify AS CHARACTER
      691        VIEW-AS RADIO-SET VERTICAL
      692        RADIO-BUTTONS
      693             "Без классификации", "no-classify":U,
      694   "Производители", "prod":U,
      695   "Группы товаров", "grp-goods":U,
      696   "Производители/Группы товаров", "prod/grp-goods":U,
      697   "Группы товаров/Производители", "grp-goods/prod":U,
      698   "Ставка НДС", "vat-ps":U,
      699   "Проба(Сорт)", "sort":U
      700        SIZE 31.88 BY 6.04 NO-UNDO.
      701   DEFINE VARIABLE SortType AS CHARACTER
      702        VIEW-AS RADIO-SET VERTICAL
      703        RADIO-BUTTONS
      704             "по коду", "sort-code":U,
      705   "по артикулу", "sort-article":U
      706        SIZE 14 BY 1.96 NO-UNDO.
      707   DEFINE RECTANGLE RECT-10
      708        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      709        SIZE 48 BY 7.96.
      710   DEFINE RECTANGLE RECT-11
      711        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      712        SIZE 18.38 BY 7.96.
      713   DEFINE RECTANGLE RECT-9
      714        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      715        SIZE 67.75 BY 8.17.
      716   DEFINE VARIABLE SumsOnly AS LOGICAL INITIAL no
      717        LABEL "Только итоги"
      718        VIEW-AS TOGGLE-BOX
      719        SIZE 19 BY .83 NO-UNDO.
      720   DEFINE VARIABLE TOG-inv AS LOGICAL INITIAL no
      721        LABEL "С момента последней инвентаризации"
      722        VIEW-AS TOGGLE-BOX
      723        SIZE 37.13 BY .83 NO-UNDO.
      724   DEFINE VARIABLE TOG-tow AS LOGICAL INITIAL yes
      725        LABEL "В двух ед.изм."
      726        VIEW-AS TOGGLE-BOX
      727        SIZE 17.5 BY .83
      728        FGCOLOR 4  NO-UNDO.
      729   DEFINE FRAME F-Main
      730        Classify AT ROW 2.63 COL 2.88 NO-LABEL
      731        SortType AT ROW 2.63 COL 52.63 NO-LABEL
      732        COMBO-node AT ROW 9.58 COL 2.63
      733        TOG-inv AT ROW 10.75 COL 2.88
      734        SumsOnly AT ROW 11.79 COL 2.88
      735        TOG-tow AT ROW 12.83 COL 2.88
      736        FILL-IN-1 AT ROW 1.46 COL 51.75 COLON-ALIGNED NO-LABEL
      737        "Классификация :" VIEW-AS TEXT
      738             SIZE 15 BY .75 AT ROW 1.67 COL 10.13
      739             FGCOLOR 4
      740        RECT-10 AT ROW 1.21 COL 2.25
      741        RECT-11 AT ROW 1.25 COL 50.88
      742        RECT-9 AT ROW 9.29 COL 1.75
      743       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      744            SIDE-LABELS NO-UNDERLINE THREE-D
      745            AT COL 1 ROW 1 SCROLLABLE .
      746   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      747   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      748   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      749   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      750   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      751   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      752   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      753   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      754         adm-object-hdl = FRAME F-Main:HANDLE.
      755   RUN ensure-broker.
      756   THIS-PROCEDURE:ADM-DATA =
      757        'ADM1.1~`':U +
      758        'SmartObject~`':U +
      759        '~`':U +
      760        'NO ~`':U +
      761        '~`':U +
      762        '~`':U +
      763        '~`':U +
      764        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      765           + "~`":U +
      766        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      767        'Record-Source,Record-Target,TableIO-Target~`':U +
      768        '~`':U +
      769        '~`~`~`~`~`~`~`~`~`~`~`':U +
      770        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      771            THEN "^^":U
      772        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      773             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      774   PROCEDURE adm-apply-entry :
      775     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      776   END PROCEDURE.
      777   PROCEDURE adm-destroy :
      778    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      779   END PROCEDURE.
      780   PROCEDURE adm-disable :
      781       DISABLE RECT-10 RECT-11 RECT-9 Classify SortType COMBO-node TOG-inv TOG-tow WITH FRAME F-Main.
      782       RUN dispatch ('disable-fields':U).
      783       RUN set-attribute-list ('ENABLED=no':U).
      784       RETURN.
      785   END PROCEDURE.
      786   PROCEDURE adm-edit-attribute-list :
      787         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      788         RETURN.
      789   END PROCEDURE.
      790   PROCEDURE adm-enable :
      791       ENABLE UNLESS-HIDDEN RECT-10 RECT-11 RECT-9 Classify SortType COMBO-node TOG-inv TOG-tow WITH FRAME F-Main.
      792       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      793       RUN set-attribute-list ('ENABLED=yes':U).
      794       RETURN.
      795   END PROCEDURE.
      796   PROCEDURE adm-exit :
      797        RUN notify ('exit':U).
      798     RETURN.
      799   END PROCEDURE.
      800   PROCEDURE adm-hide :
      801     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      802   END PROCEDURE.
      803   PROCEDURE adm-initialize :
      804     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      805   END PROCEDURE.
      806   PROCEDURE adm-show-errors :
      807       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      808       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      809           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      810       END.
      811       RETURN.
      812   END PROCEDURE.
      813   PROCEDURE adm-UIB-mode :
      814     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      815   END PROCEDURE.
      816   PROCEDURE adm-view :
      817     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      818   END PROCEDURE.
      819   PROCEDURE dispatch :
      820       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      821       RUN broker-dispatch IN adm-broker-hdl
      822           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      823       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      824   END PROCEDURE.
      825   PROCEDURE ensure-broker :
      826   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      827   IF RETURN-VALUE NE "ADM-Broker":U THEN
      828   DO:
      829       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      830       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      831   END.
      832   END PROCEDURE.
      833   PROCEDURE get-attribute :
      834     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      835     RUN broker-get-attribute IN adm-broker-hdl
      836         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      837     RETURN RETURN-VALUE.
      838   END PROCEDURE.
      839   PROCEDURE get-attribute-list :
      840     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      841     RUN broker-get-attribute-list IN adm-broker-hdl
      842         (INPUT THIS-PROCEDURE,
      843          INPUT ?,
      844          OUTPUT p-attr-list) NO-ERROR.
      845     RETURN.
      846   END PROCEDURE.
      847   PROCEDURE new-state :
      848     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      849     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      850     RETURN.
      851   END PROCEDURE.
      852   PROCEDURE notify :
      853     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      854     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      855     IF RETURN-VALUE = "ADM-ERROR":U THEN
      856         RETURN "ADM-ERROR":U.
      857     RETURN.
      858   END PROCEDURE.
      859   PROCEDURE set-attribute-list :
      860     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      861     RUN ensure-broker.
      862     RUN broker-set-attribute-list IN adm-broker-hdl
      863         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      864     RETURN.
      865   END PROCEDURE.
      866   PROCEDURE set-position :
      867       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      868       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      869       IF VALID-HANDLE(adm-object-hdl) THEN
      870       DO:
      871         ASSIGN adm-object-hdl:ROW    =   p-row
      872                adm-object-hdl:COLUMN =   p-col.
      873       END.
      874       RETURN.
      875   END PROCEDURE.
      876   PROCEDURE adm-display-fields :
      877       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      878       RETURN.
      879   END PROCEDURE.
      880   PROCEDURE adm-open-query :
      881     RETURN.
      882   END PROCEDURE.
      883   PROCEDURE adm-row-changed :
      884         IF VALID-HANDLE(adm-object-hdl) THEN
      885           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      886         RUN notify ('row-available':U).
      887         RETURN.
      888   END PROCEDURE.
      889   PROCEDURE reposition-query :
      890       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      891       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      892       RETURN.
      893   END PROCEDURE.
      894     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      895     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      896     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      897     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      898     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      899     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      900     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      901     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      902     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      903     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      904     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      905     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      906     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
      907     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
      908     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
      909     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
      910     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
      911     IF "":U = "":U THEN
      912       RUN modify-list-attribute IN adm-broker-hdl
      913         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
      914     RUN use-create-on-add(?).
      915   PROCEDURE adm-add-record :
      916       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      917          "must have at least one Enabled Table to perform Add.":U
      918          VIEW-AS ALERT-BOX ERROR.
      919       RETURN.
      920   END PROCEDURE.
      921   PROCEDURE adm-assign-record :
      922    MESSAGE
      923          "Object ":U THIS-PROCEDURE:FILE-NAME
      924            "must have at least one Enabled Table to perform Assign.":U
      925              VIEW-AS ALERT-BOX ERROR.
      926      RETURN.
      927     END PROCEDURE.
      928   PROCEDURE adm-assign-statement :
      929     RETURN.
      930   END PROCEDURE.
      931   PROCEDURE adm-cancel-record :
      932      RETURN.
      933     END PROCEDURE.
      934   PROCEDURE adm-copy-record :
      935       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
      936        "must have at least one Enabled Table to perform Copy.":U
      937          VIEW-AS ALERT-BOX ERROR.
      938       RETURN.
      939   END PROCEDURE.
      940   PROCEDURE adm-create-record :
      941      RETURN.
      942   END PROCEDURE.
      943   PROCEDURE adm-current-changed :
      944     RETURN.
      945   END PROCEDURE.
      946   PROCEDURE adm-delete-record :
      947    MESSAGE
      948          "Object ":U THIS-PROCEDURE:FILE-NAME
      949            "must have at least one Enabled Table to perform Delete.":U
      950              VIEW-AS ALERT-BOX ERROR.
      951       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
      952       RETURN.
      953   END PROCEDURE.
      954   PROCEDURE adm-disable-fields :
      955         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
      956       RETURN.
      957   END PROCEDURE.
      958   PROCEDURE adm-enable-fields :
      959       RETURN.
      960   END PROCEDURE.
      961   PROCEDURE adm-end-update :
      962     RETURN.
      963   END PROCEDURE.
      964   PROCEDURE adm-reset-record :
      965       RETURN.
      966   END PROCEDURE.
      967   PROCEDURE adm-update-record :
      968       MESSAGE
      969         "Object ":U THIS-PROCEDURE:FILE-NAME
      970           "must have at least one Enabled Table to perform Update.":U
      971             VIEW-AS ALERT-BOX ERROR.
      972      RETURN.
      973   END PROCEDURE.
      974   PROCEDURE check-modified :
      975   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
      976   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
      977   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
      978   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
      979     IF check-state = "check":U THEN
      980     DO:
      981       RUN get-link-handle IN adm-broker-hdl
      982         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
      983            OUTPUT group-target-list).
      984       IF group-target-list NE "":U THEN
      985       DO i = 1 TO NUM-ENTRIES(group-target-list):
      986         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
      987         RUN check-modified IN curr-widget ('group-check':U).
      988         IF RETURN-VALUE NE "":U THEN
      989         DO:
      990           RUN check-modified-message(RETURN-VALUE).
      991           RETURN "":U.
      992         END.
      993       END.
      994     END.
      995     RETURN "":U.
      996   END PROCEDURE.
      997   PROCEDURE check-modified-message :
      998     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
      999        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1000           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1001        IF RETURN-VALUE = "YES":U THEN
     1002           RUN notify ('view,CONTAINER-SOURCE':U).
     1003        MESSAGE IF p-changed-table NE ? THEN
     1004           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1005           ELSE "Current values have been changed."
     1006           SKIP "  Do you wish to save those changes?"
     1007           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1008        IF ANS THEN
     1009        DO:
     1010           IF group-assign-target THEN
     1011             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1012           ELSE RUN dispatch('update-record':U).
     1013           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1014           DO:
     1015               MESSAGE "Changes to the previous record were not saved."
     1016                 VIEW-AS ALERT-BOX ERROR.
     1017               IF group-assign-target THEN
     1018                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1019               ELSE RUN dispatch ('cancel-record':U).
     1020           END.
     1021        END.
     1022        ELSE DO:
     1023          IF group-assign-target THEN
     1024             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1025          ELSE RUN dispatch('cancel-record':U).
     1026        END.
     1027        RETURN.
     1028   END PROCEDURE.
     1029   PROCEDURE get-rowid :
     1030       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1031       ASSIGN
     1032       p-table   =   adm-first-table.
     1033       RETURN.
     1034   END PROCEDURE.
     1035   PROCEDURE init-group-assign :
     1036       RUN request-attribute IN adm-broker-hdl
     1037         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1038       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1039         group-assign-target = yes.
     1040       ELSE group-assign-target = no.
     1041       RETURN.
     1042   END PROCEDURE.
     1043   PROCEDURE set-editors :
     1044       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1045       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1046       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1047       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1048       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1049       DO WHILE VALID-HANDLE (curr-widget):
     1050           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1051              curr-widget:HIDDEN = no THEN DO:
     1052             CASE p-field-setting:
     1053               WHEN "INITIALIZE":U THEN
     1054               DO:
     1055                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1056                     read-only-list +
     1057                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1058                        STRING(curr-widget).
     1059               END.
     1060               WHEN "DISABLE":U OR
     1061               WHEN "ENABLE":U THEN
     1062               DO:
     1063                   curr-widget:SENSITIVE = yes.
     1064                   RUN get-attribute ('Read-Only-Editors':U).
     1065                   IF RETURN-VALUE = ? OR
     1066                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1067                       curr-widget:READ-ONLY =
     1068                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1069               END.
     1070               WHEN "CLEAR":U THEN
     1071                   curr-widget:SCREEN-VALUE = "":U.
     1072             END CASE.
     1073           END.
     1074           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1075       END.
     1076       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1077         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1078           + '"':U).
     1079       RETURN.
     1080   END PROCEDURE.
     1081   PROCEDURE use-check-modified-all :
     1082    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1083     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1084     RETURN.
     1085   END PROCEDURE.
     1086   PROCEDURE use-create-on-add :
     1087   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1088      RETURN.
     1089   END PROCEDURE.
     1090   PROCEDURE use-initial-lock :
     1091     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1092     ASSIGN adm-initial-lock = p-attr-value.
     1093     RETURN.
     1094   END PROCEDURE.
     1095     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1096   ASSIGN
     1097          FRAME F-Main:SCROLLABLE       = FALSE
     1098          FRAME F-Main:HIDDEN           = TRUE
     1099          FRAME F-Main:PRIVATE-DATA     =
     1100                   "DLGCLOSE".
     1101   ASSIGN
     1102          FILL-IN-1:HIDDEN IN FRAME F-Main           = TRUE.
     1103   ASSIGN
     1104          SortType:HIDDEN IN FRAME F-Main           = TRUE.
     1105   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     1106   DO:
     1107      Assign Classify.
     1108       if Classify  Begins "prod":U OR
     1109          Classify  Begins "grp-goods":U OR
     1110          Classify  Begins "vat-ps":U
     1111           then
     1112           enable SumsOnly with frame F-Main .
     1113      if Classify = "no-classify":U
     1114         Then do:
     1115               SumsOnly = FALSE .
     1116               display SumsOnly with frame F-Main .
     1117               disable SumsOnly with frame F-Main .
     1118           end.
     1119   END.
     1120   if not this-procedure :persistent
     1121   then do:
     1122     message
     1123       vss-workfile vss-revision vss-description skip
     1124       "Ошибка при запуске процедуры" skip
     1125       "Данную процедуру следует запускать только с параметром persistent" skip
     1126       view-as alert-box error .
     1127     undo, return error .
     1128   end.
     1129   PROCEDURE disable_UI :
     1130     HIDE FRAME F-Main.
     1131     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1132   END PROCEDURE.
     1133   PROCEDURE local-initialize :
     1134     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1135       Combo-node:list-items In frame F-Main = Combo-node:list-items + ',' + 'все':U      .
     1136       Combo-node:list-items In frame F-Main = Combo-node:list-items + ',' + 'касса продажа':U      .
     1137       Combo-node:list-items = Combo-node:list-items + ',' + 'касса возврат':U  .
     1138       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внешний':U           .
     1139       Combo-node:list-items = Combo-node:list-items + ',' + 'приход внутренний':U           .
     1140       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внешний':U       .
     1141       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат внутренний':U       .
     1142       Combo-node:list-items = Combo-node:list-items + ',' + 'приход  произв.':U            .
     1143       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внешний':U           .
     1144       Combo-node:list-items = Combo-node:list-items + ',' + 'возврат пост.':U        .
     1145       Combo-node:list-items = Combo-node:list-items + ',' + 'списание':U           .
     1146       Combo-node:list-items = Combo-node:list-items + ',' + 'расход внутренний':U           .
     1147       Combo-node:list-items = Combo-node:list-items + ',' + 'расход  произв.':U            .
     1148       Combo-node:list-items = Combo-node:list-items + ',' + 'списан. произв.':U            .
     1149       Combo-node:list-items = Combo-node:list-items + ',' + 'инвентаризация':U                 .
     1150       Combo-node:list-items = Combo-node:list-items + ',' + 'переоценка':U            .
     1151       Combo-node:screen-value in frame F-Main = 'все':U.
     1152       tog-tow:screen-value in frame F-Main = "yes".
     1153       display Combo-node  with frame F-Main .
     1154   END PROCEDURE.
     1155   PROCEDURE my-report :
     1156    run rep/r-o-good.p
     1157         ( input v-cntxt-obj-code ,
     1158           input v-cntxt-obj-type ,
     1159           input base-type  ,
     1160           input base-code  ,
     1161           input COMBO-node ,
     1162           input tog-inv  ,
     1163           input classify ,
     1164           input SortType ,
     1165           input "all," + string(SumsOnly,"yes/no") + "," + string(tog-tow,"yes/no") ).
     1166   END PROCEDURE.
     1167   PROCEDURE my-var :
     1168   assign frame F-Main COMBO-node tog-inv Classify  SumsOnly tog-tow .
     1169   ReportNAme = "О Б О Р О Т Н А Я    В Е Д О М О С Т Ь    Д В И Ж Е Н И Я    Т О В А Р О В".
     1170   def var t-class as char no-undo.
     1171   def var t-sort as char no-undo.
     1172     case classify:
     1173       when "no-classify":u    then t-class =   "Без классификации" .
     1174       when "prod":u           then t-class =   "Производители"   .
     1175       when "post":u           then t-class =   "Поставщики"   .
     1176       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1177       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1178       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1179       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1180       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1181       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1182       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1183       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1184       when  "t-level":u       then t-class =   "Терминальные группы" .
     1185    end case.
     1186     case sorttype:
     1187       when "sort-pp":u               then t-sort =   "по порядку" .
     1188       when "sort-code":u             then t-sort =   "по коду" .
     1189       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1190       when "sort-qunty":u            then t-sort =   "по реализации".
     1191       when "sort-name":u             then t-sort =   "по наименованию".
     1192       when "sort-type":u             then t-sort =   "по типу ткани".
     1193       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1194       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1195    end case.
     1196   ReportHeader = "Классификация : " + t-class + chr(10) .
     1197   ReportHeader = ReportHeader  + chr(10) + " Тип документов : " + COMBO-node + chr(10) + " Остатки на начало, конец периода и оборот указаны по всем типам документов".
     1198   if tog-inv then
     1199   ReportHeader = ReportHeader  + chr(10) + " с момента последней инвентаризации ".
     1200               Case COMBO-node:
     1201                   when  'приход внешний':U             then   COMBO-node = 'ie':U          .
     1202                   when  'расход внешний':U             then   COMBO-node = 'ee':U          .
     1203                   when  'возврат пост.':U          then   COMBO-node = 'ep':U       .
     1204                   when  'касса продажа':U        then   COMBO-node = 'es':U     .
     1205                   when  'возврат внешний':U         then   COMBO-node = 're':U      .
     1206                   when  'касса возврат':U    then   COMBO-node = 'rs':U .
     1207                   when  'списание':U             then   COMBO-node = 'we':U          .
     1208                   when  'инвентаризация':U                   then   COMBO-node = 'vt':U                .
     1209                   when  'приход внутренний':U             then   COMBO-node = 'iv':U          .
     1210                   when  'расход внутренний':U             then   COMBO-node = 'ev':U          .
     1211                   when  'возврат внутренний':U         then   COMBO-node = 'rv':U       .
     1212                   when  'расход  произв.':U              then   COMBO-node = 'em':U            .
     1213                   when  'списан. произв.':U              then   COMBO-node = 'wm':U            .
     1214                   when  'приход  произв.':U              then   COMBO-node = 'im':U            .
     1215                   when  'переоценка':U              then   COMBO-node = 'ot':U            .
     1216                   when  'касса'                             then   COMBO-node = 'rs':U + ',' + 'es':U.
     1217                    when  'все':U                             then   COMBO-node = 'все':U.
     1218               End case.
     1219   END PROCEDURE.
     1220   PROCEDURE state-changed :
     1221     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1222     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1223   END PROCEDURE.
