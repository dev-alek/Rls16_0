     1022   define variable v-value-decimal as decimal no-undo .
     1023   define variable v-value-integer as INTEGER no-undo .
     1024   define variable v-value-logical AS LOGICAL no-undo .
     1025   define variable par-type as character no-undo .
     1026   define variable v-tth as handle no-undo .
     1027   define variable l-ok  as logical no-undo .
     1028   define variable v-hist-name            as character no-undo .
     1029   define variable v-hist-code            as character no-undo .
     1030   define variable p-report-id          as character no-undo .
     1031   define variable v-file-name-rep-html as character no-undo .
     1032   define variable ii                   as integer   no-undo .
     1033   define variable v-name               as character no-undo .
     1034   define variable v-name-report        as character no-undo .
     1035   define variable v-obj-name           as character no-undo .
     1036   define stream Out-Stream.
     1037   define stream OutStr-html.
     1038   define buffer buf_currency for ub.currency.
     1039   do
     1040   on error undo, return error return-value
     1041   :
     1042     message "Печатать отрывной лист квитанции ? " skip
     1043     view-as alert-box question
     1044     buttons yes-no
     1045     update l-ok .
     1046     mCashBook = new ibs.th.ref.cashbookstorage () .
     1047     o-uchet    = mCashBook:getSinglRule(buf_fin-doc.CashBookId, buf_fin-doc.obj-type, buf_fin-doc.obj-code, "uchet") .
     1048     if o-uchet = "0"
     1049     then v-uchet = "cal" .
     1050     else v-uchet = "smen" .
     1051     delete object mCashBook no-error .
     1052     run get-report-num  (output g#report-num).
     1053     v-file-name-rep-html = session:temp-directory + string(g#report-num) + ".html".
     1054     output to value( string( session:temp-directory + "$" + string( g#report-num ) ) + ".txl" ) .
     1055     output close.
     1056    if p-format <> 1
     1057    and p-format <> ?
     1058    and p-append
     1059    then do:
     1060     assign
     1061     p-format = ?
     1062     .
     1063     return.
     1064    end.
     1065     assign
     1066     Line = fill("_":U, 198)
     1067     .
     1068     assign
     1069     v-chernovik = if buf_fin-doc.status_ = 'новый':U
     1070                   then "Ч Е Р Н О В И К"
     1071                   else (fill( chr(32), 15))
     1072     .
     1073     if buf_fin-doc.curr-code = 0 then do:
     1074       assign
     1075       v-rub = " руб.":U
     1076       v-kop = " коп.":U
     1077       v-title-rub = fill(chr(32), 3) +  v-rub + v-kop + fill(chr(32), 4)
     1078       .
     1079     end.
     1080     else do:
     1081       find first buf_currency no-lock where
     1082                  buf_currency.curr-code = buf_fin-doc.curr-code .
     1083       assign
     1084       v-rub = chr(32) + buf_currency.curr-abbr + ".":U
     1085       v-kop = chr(32) + buf_currency.part-abbr + ".":U
     1086       v-title-rub = "    инвалюты     ":U
     1087       v-okv-code = (if buf_currency.okv-code = 0
     1088                     then "Код ОКВ?"
     1089                     else string(buf_Currency.okv-code))
     1090       .
     1091     end.
     1092     assign
     1093     v-payer-name-p1 = Break-n-line(Buf_fin-doc.payer-name, "72,72", output num-lines)
     1094     v-payer-name-p2 = if num-lines >=2
     1095                      then entry(2, v-payer-name-p1, chr(4))
     1096                      else "":U
     1097     v-payer-name-p1 = entry(1, v-payer-name-p1, chr(4))
     1098     .
     1099     assign
     1100     v-naznach-plat-p1 = Break-n-line(trim(Buf_fin-doc.naznach-plat), "28,35,35,35", output num-lines) .
     1101     v-naznach-plat-p4 = if num-lines >=4
     1102                         then entry(4, v-naznach-plat-p1, chr(4))
     1103                         else "":U .
     1104     v-naznach-plat-p3 = if num-lines >=3
     1105                         then entry(3, v-naznach-plat-p1, chr(4))
     1106                         else "":U .
     1107     v-naznach-plat-p2 = if num-lines >=2
     1108                         then entry(2, v-naznach-plat-p1, chr(4))
     1109                         else "":U .
     1110     v-naznach-plat-p1 = entry(1, v-naznach-plat-p1, chr(4))
     1111     .
     1112     assign
     1113     v-naznach-plat-l1 = Break-n-line(Buf_fin-doc.naznach-plat, "95,106", output num-lines)
     1114     v-naznach-plat-l2 = if num-lines >=2
     1115                         then entry(2, v-naznach-plat-l1, chr(4))
     1116                         else "":U
     1117     v-naznach-plat-l1 = entry(1, v-naznach-plat-l1, chr(4))
     1118     .
     1119     assign
     1120       v-date-create = buf_fin-doc.doc-date
     1121       v-doc-date-f = string(buf_fin-doc.doc-date, "99.99.9999":U) + " г."
     1122     .
     1123     Case buf_fin-doc.str-podr-type :
     1124       when 'маг':U then do:
     1125         find first ub.shop
     1126         where ub.shop.obj-code = buf_fin-doc.str-podr-code
     1127           no-error.
     1128           if available ub.shop then do:
     1129             assign v-str-podr-name = buf_fin-doc.str-podr-name.
     1130           end.
     1131       end.
     1132       when 'скл':U then do:
     1133         find first ub.store
     1134         where ub.store.obj-code = buf_fin-doc.str-podr-code
     1135           no-error.
     1136           if available ub.store then do:
     1137             assign v-str-podr-name = buf_fin-doc.str-podr-name + " " + ub.store.addres1.
     1138           end.
     1139       end.
     1140     end case.
     1141     if v-str-podr-name = "" then v-str-podr-name = buf_fin-doc.str-podr-name .
     1142     find first ub.firm where ub.firm.firm-code = buf_fin-doc.host-code no-error.
     1143     if available ub.firm then do:
     1144       assign v-inn = (if ub.firm.inn <> "" then (" ИНН " + ub.firm.inn) else "").
     1145     end.
     1146       assign
     1147       v-dops = Sum-in-Words-Without-Dec(buf_fin-doc.sum-doc)
     1148       v-sum-kop-p = string((buf_fin-doc.sum-doc - truncate(buf_fin-doc.sum-doc, 0)) * 100, "99":U)
     1149       v-line3 = 41
     1150       v-line2 = 66
     1151       .
     1152     assign
     1153     v-sum-doc-p1 = Break-n-line(v-dops, ("41,41,":U + string(v-line3)), output num-lines)
     1154     v-sum-doc-p3 = If num-lines >= 3
     1155                    then entry(3, v-sum-doc-p1, chr(4))
     1156                    else "":U
     1157     v-sum-doc-p3 = v-sum-doc-p3 +  fill("-":U, 21 - length(v-sum-doc-p3))
     1158     v-sum-doc-p2 = If num-lines >= 2
     1159                    then entry(2, v-sum-doc-p1, chr(4))
     1160                    else "":U
     1161     v-sum-doc-p2 =  v-sum-doc-p2 +  fill("-":U, 41 - length(v-sum-doc-p2))
     1162     v-sum-doc-p1 =  entry(1, v-sum-doc-p1, chr(4))
     1163     v-sum-doc-p1 = v-sum-doc-p1 +  fill("-":U, 21 - length(v-sum-doc-p1))
     1164     v-sum-doc-p1 = caps(substring(v-sum-doc-p1, 1, 1)) + substring(v-sum-doc-p1, 2)
     1165     .
     1166     assign
     1167     v-sum-doc-l1 = Break-n-line(v-dops, ("66,":U + string(v-line2)), output num-lines)
     1168     v-sum-doc-l2 = If num-lines >= 2
     1169                    then entry(2, v-sum-doc-l1, chr(4))
     1170                    else "":U
     1171     v-sum-doc-l2 =  v-sum-doc-l2 +  fill("-":U, v-line2 - length(v-sum-doc-l2))
     1172     v-sum-doc-l1 =  entry(1, v-sum-doc-l1, chr(4))
     1173     v-sum-doc-l1 = v-sum-doc-l1 +  fill("-":U, 66 - length(v-sum-doc-l1))
     1174     v-sum-doc-l1 = caps(substring(v-sum-doc-l1, 1, 1)) + substring(v-sum-doc-l1, 2)
     1175     .
     1176     assign
     1177     v-including = replace(buf_fin-doc.including, "@":U, "":U)
     1178     v-including = trim(v-including, chr(44))
     1179     v-including = replace(v-including, "в том числе", "")
     1180     v-including = replace(v-including, "в т.ч.:", "")
     1181     v-including = replace(v-including, "в т.ч.", "")
     1182     no-error .
     1183       define variable v-sumRubKop         as character    no-undo.
     1184       define variable v-kop-prop          as character    no-undo.
     1185       define variable v-date-string       as character    no-undo.
     1186       assign
     1187           v-sumRubKop = ( if buf_fin-doc.curr-code = 0
     1188                           then
     1189                           trim( Sum-Rub-Kop-Digit (  INPUT buf_fin-doc.sum-doc
     1190                                               ,INPUT 70
     1191                                               ,INPUT 4
     1192                                               ,INPUT " ":U
     1193                                               ,INPUT "":U
     1194                                               ,INPUT v-rub
     1195                                               ,INPUT v-kop
     1196                                               ) )
     1197                           else
     1198                           Sum-Invalut-Digit ( INPUT buf_fin-doc.sum-doc
     1199                                               ,INPUT 40
     1200                                               ,Input buf_fin-doc.curr-code
     1201                                               ,INPUT " ":U
     1202                                               ,INPUT "":U
     1203                                               ))
     1204       .
     1205       assign
     1206           v-kop-prop = ( if buf_fin-doc.curr-code = 0
     1207                          then substitute( "&1 &2&3", v-rub, v-sum-kop-p, v-kop )
     1208                          else "":U
     1209                        )
     1210       .
     1211       assign
     1212           v-date-string = substitute( '"&1" &2 &3 г.'
     1213                                       , string( day( v-date-create ), "99":U )
     1214                                       , MonthNameRusGen( Month( v-date-create ) )
     1215                                       , string( Year( v-date-create ), "9999":U )
     1216                                     )
     1217       .
     1218     run db-attr-value(INPUT v-cntxt-db-num,INPUT 'hist-code':U,OUTPUT v-hist-code ,OUTPUT par-type) .
     1219   if l-ok then do:
     1220     output stream OutStr-html to value(v-file-name-rep-html) convert target 'UTF-8'.
     1221     put stream OutStr-html unformatted
