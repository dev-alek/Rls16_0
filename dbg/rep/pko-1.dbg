      315   define  stream PrnLibStream.
      316   procedure prn-lib-prn-file :
      317     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      318     define input parameter p-DIsabledoptions as integer no-undo .
      319     define variable v-report-name as character no-undo .
      320     define variable v-user-action as character no-undo .
      321     define variable v-printed     as logical   no-undo .
      322     define variable v-exist       as logical   no-undo .
      323     do
      324       on error undo, return error
      325       :
      326       run prn-lib-get-report-name  in this-procedure (
      327         input parParentProc
      328         ,output v-report-name
      329         ).
      330   define variable vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      331   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      332     (input  v-report-name
      333     ,input  2
      334     ,output v-exist
      335     )  .
      336       if NOT v-exist then
      337       DO:
      338         Message
      339           "Нет заданий на печать ! "
      340           view-as alert-box .
      341         Return  .
      342       End.
      343       run gbl/prnfilen.w
      344         (input  ""
      345         ,input  p-DisabledOptions
      346         ,input  string(v-report-name )
      347         ,input  7
      348         ,output v-user-action
      349         ,output v-printed
      350         ) .
      351       if v-printed then
      352       do:
      353         return "YES" .
      354       end.
      355       else
      356       do:
      357         return "NO" .
      358       end.
      359     end.
      360   end procedure.
      361   procedure prn-lib-open-stream :
      362     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      363     define input parameter p-page-size    as integer no-undo .
      364     define input parameter p-is-stream    as logical no-undo .
      365     define input parameter p-append       as logical no-undo .
      366     define variable v-report-name as character no-undo .
      367     do
      368       on error undo, return error
      369       :
      370       run prn-lib-get-report-name  in this-procedure (
      371         input parParentProc
      372         ,output v-report-name
      373         ).
      374       if p-is-stream then
      375       do:
      376         if p-append then
      377         do:
      378           output stream PrnLibStream to value( v-report-name )
      379             page-size value(p-page-size) append .
      380         end.
      381         if not p-append then
      382         do:
      383           output stream PrnLibStream to value( v-report-name )
      384             page-size value(p-page-size) .
      385         end.
      386       end.
      387       if not p-is-stream then
      388       do:
      389         if p-append then
      390         do:
      391           output to value( v-report-name )
      392             page-size value(p-page-size) append .
      393         end.
      394         if not p-append then
      395         do:
      396           output to value( v-report-name )
      397             page-size value(p-page-size) .
      398         end.
      399       end.
      400     end.
      401   end procedure.
      402   procedure prn-lib-open-exp :
      403     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      404     define input parameter p-is-stream    as logical no-undo .
      405     define input parameter p-is-append    as logical no-undo .
      406     define output parameter p-ReportFileName as char init "report" no-undo.
      407     define output parameter p-process as logical no-undo .
      408     define variable glog as logical no-undo .
      409     do
      410       on error undo, return error
      411       :
      412       SYSTEM-DIALOG GET-FILE p-ReportFileName
      413         TITLE      "Укажите путь"
      414         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      415         ASK-OVERWRITE
      416         CREATE-TEST-FILE
      417         SAVE-AS
      418         USE-FILENAME
      419         DEFAULT-EXTENSION "txt"
      420         UPDATE glog
      421         .
      422       if not glog then  return.
      423       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      424       if p-is-stream then
      425       do:
      426         if p-is-append then
      427         do:
      428           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      429         end.
      430         else
      431         do:
      432           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      433         end.
      434       end.
      435       else
      436       do:
      437         if p-is-append then
      438         do:
      439           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      440         end.
      441         else
      442         do:
      443           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      444         end.
      445       end.
      446       p-process = yes.
      447     end.
      448   end procedure.
      449   procedure prn-lib-get-report-name :
      450     define input parameter parParentProc  as widget-handle no-undo.
      451     define output parameter p-report-name as character no-undo .
      452     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      453   end procedure.
      454   procedure prn-lib-reportviewer-report-name :
      455     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      456     define input parameter p-report-name-html as character no-undo .
      457     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      458   end procedure.
      459   procedure prn-lib-reportviewer :
      460     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      461     define input parameter p-report-name-html as character no-undo .
      462     define input parameter p-param        as character no-undo .
      463     define variable v-excel           as character no-undo init 'TRUE' .
      464     define variable v-value-character as character no-undo .
      465     define variable v-value-integer   as character no-undo .
      466     define variable v-value-date      as date      no-undo .
      467     define variable v-value-decimal   as decimal   no-undo .
      468     define variable rep-excel         as logical   no-undo .
      469     define variable excel-string      as character no-undo .
      470     define variable v-param-type      as character no-undo .
      471     define variable v-tth             as handle    no-undo .
      472     run adm/shattri.p (
      473       input "get":U
      474       ,input  ""
      475       ,input  0
      476       ,input  'report-glob':U
      477       ,input  'rep-excel':U
      478       ,output v-value-character
      479       ,output v-value-date
      480       ,output v-value-decimal
      481       ,output v-value-integer
      482       ,output rep-excel
      483       ,output v-param-type
      484       ,INPUT-OUTPUT table-handle v-tth
      485       )  .
      486     if rep-excel then v-excel = "TRUE" .
      487     else v-excel = "FALSE" .
      488     if p-param eq ""
      489     then
      490        p-param = "EXCEL:" + v-excel.
      491     else
      492        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      493     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      494   end procedure.
      495   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile: frmlib.i $ $Revision: aea5316774be, 0, rls $".
      496   FUNCTION Break-n-line RETURNS CHARACTER
      497     ( INPUT p-ost as char,
      498       INPUT p-lengths  as character,
      499       OUTPUT output-num-lines as integer
      500       ) :
      501   define variable ii as integer no-undo.
      502   define variable jj as integer no-undo.
      503   define variable linei as character no-undo extent 10.
      504   define variable line-length as integer no-undo extent 10.
      505   define variable num-line as integer no-undo .
      506   define variable v-line as character no-undo .
      507   do ii = 1 to MIN(num-entries(p-lengths), 10):
      508     assign
      509     line-length[ii] = integer(entry(ii, p-lengths))
      510     num-line = ii
      511     .
      512   end.
      513   do jj = 1 to num-line:
      514     if Length ( p-ost ) <= line-length[jj] then do:
      515       assign
      516       output-num-lines = jj
      517       v-line = v-line + (if jj = 1 then "":U else chr(4)) + p-ost
      518       .
      519       return v-line.
      520     end.
      521     assign
      522     ii = 1
      523     .
      524     if length( entry( ii, p-ost , chr(32)) ) > line-length[jj]
      525     then do:
      526       assign
      527       linei[jj] = substr( p-ost , 1 , line-length[jj] )
      528       p-ost = trim( substr( p-ost , line-length[jj] + 1 ) )
      529       .
      530     end.
      531     else do:
      532       DO WHILE length( linei[jj] + entry( ii, p-ost , chr(32)) ) < ( line-length[jj] + 1 ) :
      533         assign
      534         linei[jj] = linei[jj] + entry( ii, p-ost , chr(32)) + chr(32)
      535         ii = ii + 1
      536         .
      537         if length( entry( ii, p-ost, chr(32) ) ) > line-length[jj] then
      538         assign
      539         linei[jj] = linei[jj] + substr( p-ost , length( linei[jj] ) , line-length[jj] - length( linei[jj] ) + 1 )
      540         .
      541       END.
      542       assign
      543       p-ost = trim( substr( p-ost , length(linei[jj]) + 1  ))
      544       .
      545     end.
      546     assign
      547     v-line = v-line + (if jj = 1 then "":U else chr(4)) + linei[jj]
      548     .
      549     if p-ost = "":U then LEAVE.
      550   end.
      551   assign
      552   output-num-lines = jj.
      553   RETURN v-line.
      554   END FUNCTION.
      555   FUNCTION Center-Field RETURNS CHARACTER
      556     ( INPUT p-str as char,
      557       INPUT p-format as integer,
      558       INPUT p-Length as integer,
      559       INPUT p-fill as character
      560       ) :
      561   define variable v-str as character no-undo .
      562   define variable v-left as integer no-undo .
      563   define variable v-dop as integer no-undo .
      564   assign
      565   p-str = trim(p-str)
      566   .
      567   if p-str = "":U then return fill(p-fill, p-length).
      568   if length(p-str) >= p-format then
      569   p-str = substr(p-str, 1, p-format).
      570   else do:
      571     p-format = length(p-str).
      572   end.
      573   if p-format < p-length then do:
      574     assign
      575     v-left = (p-length - p-format )
      576     v-dop = (if v-left modulo 2 = 1
      577              then 1
      578              else 0)
      579     v-left = (if (v-left modulo 2 = 1)
      580              then (v-left - 1 ) / 2
      581              else v-left / 2)
      582     v-str =  fill(p-fill, v-left) +
      583              string(p-str, "X(":U + string(p-format) + ")":U) +
      584              fill(p-fill, v-left) + fill(p-fill, v-dop)
      585     .
      586     return v-str.
      587   end.
      588   else do:
      589     return string(p-str, "X(":U + string(p-length) + ")":U).
      590   end.
      591   END FUNCTION.
      592   FUNCTION Left-Field RETURNS CHARACTER
      593     ( INPUT p-str as char,
      594       INPUT p-format as integer,
      595       INPUT p-Length as integer,
      596       INPUT p-fill as character
      597       ) :
      598   define variable v-str as character no-undo .
      599   define variable v-left as integer no-undo .
      600   define variable v-dop as integer no-undo .
      601   assign
      602   p-str = trim(p-str)
      603   .
      604   if p-str = "":U then return fill(p-fill, p-length).
      605   if length(p-str) >= p-format then
      606   p-str = substr(p-str, 1, p-format).
      607   else do:
      608     p-format = length(p-str).
      609   end.
      610   if p-format < p-length then do:
      611     assign
      612     v-dop =  p-length - p-format
      613     v-str =  string(p-str, "X(":U + string(p-format) + ")":U) +
      614              fill(p-fill, v-dop)
      615     .
      616     return v-str.
      617   end.
      618   else do:
      619     return string(p-str, "X(":U + string(p-length) + ")":U).
      620   end.
      621   END FUNCTION.
      622   FUNCTION Sum-Rub-Kop-Digit RETURNS CHARACTER
      623     ( INPUT p-sum as decimal,
      624       INPUT p-rub-length as integer,
      625       INPUT p-kop-length as integer,
      626       INPUT p-fill as character,
      627       INPUT p-razr-delim as character,
      628       INPUT p-rub-str  as character,
      629       INPUT p-kop-str  as character
      630       ) :
      631   define variable v-str as character no-undo .
      632   define variable v-format as character no-undo .
      633   define variable v-dopi as integer no-undo .
      634   define variable v-dopi2 as integer no-undo .
      635   assign
      636   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      637   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      638   .
      639   if v-dopi > p-rub-length or p-kop-length < 2 then return "?".
      640   assign
      641   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9":U
      642   v-dopi = length(trim(string(truncate(p-sum, 0), v-format)))
      643   .
      644   assign
      645   v-str = fill(p-fill, p-rub-length - v-dopi) +
      646           string(truncate(p-sum, 0), v-format) +
      647           p-rub-str +
      648           fill(p-fill, p-kop-length - 2) +
      649           string(truncate((ABS(p-sum) - ABS(truncate(p-sum, 0))), 2) * 100, "99":U) + p-kop-str
      650   .
      651   return v-str.
      652   END FUNCTION.
      653   FUNCTION Sum-Invalut-Digit RETURNS CHARACTER
      654     ( INPUT p-sum as decimal,
      655       INPUT p-sum-length as integer,
      656       INPUT p-curr-code as integer,
      657       INPUT p-fill as character,
      658       INPUT p-razr-delim as character
      659       ) :
      660   define variable v-str as character no-undo .
      661   define variable v-format as character no-undo .
      662   define variable v-dopi as integer no-undo .
      663   define variable v-dopi2 as integer no-undo .
      664   define variable v-curr-name as character no-undo .
      665   define buffer buf_currency for ub.currency.
      666   find first buf_currency no-lock where
      667             buf_currency.curr-code = p-curr-code no-error .
      668   if not avail buf_currency
      669   then v-curr-name = "неизвестная валюта".
      670   else
      671   assign
      672   v-curr-name = buf_currency.curr-name
      673   .
      674   assign
      675   v-dopi = length(string(truncate(ABS(p-sum), 0)))
      676   v-dopi2 = truncate(v-dopi / 3, 0) - (if v-dopi modulo  3 = 0 then 1 else 0)
      677   .
      678   if v-dopi > p-sum-length then return "?".
      679   assign
      680   v-format = (if p-sum < 0 then "-":U else "":U) + fill((">>>":U + p-razr-delim), v-dopi2) + ">>9.99":U
      681   v-dopi = length(trim(string(p-sum, v-format)))
      682   .
      683   assign
      684   v-str = "(":U + chr(32) + v-curr-name +  chr(32) + ")":U +
      685           fill(p-fill, p-sum-length - v-dopi - length(v-curr-name) - 4)  +
      686           trim(string(p-sum, v-format))
      687   .
      688   return v-str.
      689   END FUNCTION.
      690   FUNCTION Sum-in-Words-Without-Dec RETURNS CHARACTER
      691   (input v-sum as decimal
      692   ):
      693   define variable v-str as character no-undo .
      694   run gbl/num-rus.p ( input absolute( v-sum ) , output v-str).
      695   v-str = trim( caps( substring( v-str, 1, 1 ) ) ) + substring( v-str, 2 ).
      696   return v-str.
      697   END FUNCTION.
      698   FUNCTION Sum-in-Words-Invalut RETURNS CHARACTER
      699   (input p-sum as decimal
      700    ,input p-curr-code as integer
      701   ):
      702   define variable v-str as character no-undo .
      703   define variable Copeck as character no-undo.
      704   define variable Rouble as character no-undo.
      705   define variable v-Word as character no-undo.
      706   define variable ii as integer init 18 no-undo.
      707   define variable v-str-rubl as character no-undo .
      708   define variable v-kop as integer no-undo .
      709   define buffer buf_currency for ub.currency.
      710   assign
      711   v-Word = string( absolute( p-sum ) , "999999999999999.99" ).
      712   find first buf_currency no-lock where
      713             buf_currency.curr-code = p-curr-code no-error .
      714   if not available buf_currency then return chr(63).
      715   if decimal( substring(v-Word,1,ii - 3) ) <> 0 then do:
      716     CASE substring(v-Word, ii - 3,1):
      717       WHEN "1" THEN DO:
      718         if substring(v-Word, ii - 4,1) = "1" then
      719             Rouble = buf_currency.curr-name-five .
      720         else
      721             Rouble = buf_currency.curr-name-one .
      722       END.
      723       WHEN "2" OR WHEN "3" OR WHEN "4" THEN  DO:
      724         if substring(v-Word, ii - 4,1) = "1" then
      725            Rouble = buf_currency.curr-name-five .
      726            else
      727            Rouble = buf_currency.curr-name-three .
      728         END.
      729       WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN  DO:
      730          Rouble = buf_currency.curr-name-five .
      731       END.
      732     END CASE.
      733   end.
      734   CASE substring(v-Word, ii, 1):
      735     WHEN "1" THEN DO:
      736       if substring(v-Word, ii - 1, 1) = "1" then
      737           Copeck = buf_currency.part-name-five .
      738       else
      739           Copeck = buf_currency.part-name-one .
      740     END.
      741     WHEN "2" OR WHEN "3" OR WHEN "4" THEN DO:
      742       if substring(v-Word, ii - 1, 1) = "1" then
      743           Copeck = buf_currency.part-name-five .
      744       else
      745           Copeck = buf_currency.part-name-three .
      746     END.
      747     WHEN "0" OR WHEN "5" OR WHEN "6" OR WHEN "7" OR WHEN "8" OR WHEN "9" THEN DO:
      748       Copeck = buf_currency.part-name-five .
      749     END.
      750   END CASE.
      751   run gbl/num-rus.p ( input absolute( p-sum )
      752                , output v-str-rubl).
      753   assign
      754   v-kop = (absolute( p-sum ) - truncate(absolute(p-sum), 0)
      755           ) * 100
      756   .
      757   v-str = ( if p-Sum < 0 then "- " else "" ) +
      758               caps(substring(v-str-rubl, 1, 1)) +  substring(v-str-rubl, 2) + chr(32) + Rouble + chr(32) +
      759               string(v-kop, "99":U) + chr(32) + Copeck .
      760   return v-str.
      761   END FUNCTION.
      762   FUNCTION Sum-delim-with-defis RETURNS CHARACTER
      763   (input v-sum as decimal,
      764   input v-razr as integer
      765   ):
      766   define variable v-str as character no-undo .
      767   define variable v-dec-separ as character no-undo .
      768   case SESSION:NUMERIC-FORMAT:
      769     when "American":U then do:
      770       assign
      771       v-dec-separ = ".":U
      772       .
      773     end.
      774     when "European":U then do:
      775       assign
      776       v-dec-separ = ",":U
      777       .
      778     end.
      779   END CASE.
      780   assign
      781   v-str = replace(string(v-sum, fill(">":U, v-razr - 1) + "9.99"), v-dec-separ, "-":U)
      782   .
      783   return v-str.
      784   END FUNCTION.
      785   FUNCTION MonthNameRusGen RETURNS CHARACTER ( INPUT i-month AS INTEGER ) :
      786     DEFINE VARIABLE v-name AS CHARACTER NO-UNDO.
      787     RUN get-month-name-gen IN THIS-PROCEDURE ( INPUT i-month, OUTPUT v-name ) NO-ERROR.
      788     RETURN ( IF ERROR-STATUS :ERROR THEN ? ELSE v-name ).
      789   END FUNCTION.
      790   PROCEDURE get-month-name-gen :
      791     DEFINE  INPUT PARAMETER p-month AS INTEGER   NO-UNDO.
      792     DEFINE OUTPUT PARAMETER p-name  AS CHARACTER NO-UNDO.
      793     DEFINE VARIABLE v-list AS CHARACTER NO-UNDO INITIAL "Января,Февраля,Марта,Апреля,Мая,Июня,Июля,Августа,Сентября,Октября,Ноября,Декабря".
      794     DO ON ERROR UNDO, RETURN ERROR :
      795       ASSIGN p-name = ( IF p-month >= 1 AND p-month <= 12 THEN ENTRY( p-month, v-list ) ELSE ? ).
      796     END.
      797   END PROCEDURE.
