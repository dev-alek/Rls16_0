     2097         put stream OutStr-html unformatted
     2098       '<tr>' skip
     2099       '<td colspan="15" style="text-align: left;"></td>' skip
     2100       '<td></td>' skip
     2101       '<td colspan="20" style="text-align: center; font-size: 10px;">(подпись)</td>' skip
     2102       '<td></td>' skip
     2103       '<td colspan="25" style="text-align: center; font-size: 10px;">(расшифровка подписи)</td>' skip
     2104       '<td colspan="3"></td>' skip
     2105       '<td></td>' skip
     2106       '</tr>' skip .
     2107         put stream OutStr-html unformatted
     2108       '<tr>' skip
     2109       '<td colspan="15" style="text-align: left;">Получил кассир</td>' skip
     2110       '<td></td>' skip
     2111       '<td colspan="20" style="text-align: center; border-bottom: 1px solid black;"></td>' skip
     2112       '<td></td>' skip
     2113       '<td colspan="25" text_wrap="true" style="text-align: center; border-bottom: 1px solid black;">' + buf_fin-doc.receiver-sign3 + '</td>' skip
     2114       '<td colspan="3"></td>' skip
     2115       '<td></td>' skip
     2116       '</tr>' skip
     2117       '</thead>' skip
     2118       '<tbody>' skip
     2119       .
     2120       put stream OutStr-html unformatted
     2121       '</tbody>' skip
     2122       '</table>' skip
     2123       .
     2124     put stream OutStr-html unformatted
     2125       '</body>' skip
     2126       '</html>' skip
     2127       .
     2128     output stream OutStr-html close.
     2129   end.
     2130     run prn-lib-reportviewer-report-name in this-procedure (
     2131       input THIS-PROCEDURE
     2132       ,input v-file-name-rep-html
     2133       ).
     2134   PROCEDURE get-report-num :
     2135     define output parameter p-report-num as integer no-undo .
     2136     do
     2137       on error undo, return error return-value
     2138       :
     2139       run gbl/getrpnum.p (output p-report-num).
     2140     end.
     2141   END PROCEDURE.
     2142   end.
