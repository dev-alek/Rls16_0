        1   block-level on error undo, throw.
        2   define input parameter parparentproc      as widget-handle no-undo .
        3   define input parameter p-doc-code         as character FORMAT "x(14)"       no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: wth-exch.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/wth-exch.p $":U .
        9   define variable vss-description as character no-undo init "обмен талонов на нефтепродукты".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define new global shared variable g#library  as handle no-undo .
       69   define new global shared variable g#library2 as handle no-undo .
       70   procedure proc-alt-shift-f2:
       71     if not ibs.th.gbl.gbl-var:rcode
       72   then
       73     run gbl\inidebug.p .
       74   end.
       75   procedure proc-alt-shift-f3:
       76     run gbl/prvssinf.p
       77       ( input this-procedure
       78       ) .
       79   end.
       80   define variable v-inform-launched as logical no-undo initial false .
       81   procedure proc-alt-shift-f4:
       82     define variable v-action as character no-undo .
       83     if v-inform-launched = false then do:
       84       assign
       85         v-inform-launched = true
       86       .
       87       run gbl/d-inform.w
       88         (  input self
       89         ,  input this-procedure
       90         , output v-action
       91         ) no-error .
       92       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       93       assign
       94         v-inform-launched = false
       95       .
       96     end.
       97   end.
       98   procedure proc-alt-f1:
       99     run gbl/corrhelp.p
      100       (input this-procedure
      101       ) .
      102   end .
      103   on alt-shift-f2 anywhere do:
      104     run proc-alt-shift-f2.
      105   end.
      106   on alt-shift-f3 anywhere do:
      107     run proc-alt-shift-f3 in this-procedure .
      108   end.
      109   on alt-shift-f4 anywhere do:
      110     run proc-alt-shift-f4 in this-procedure.
      111   end.
      112   on alt-f1 anywhere do:
      113     run proc-alt-f1 in this-procedure .
      114   end.
      115   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      116   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      117   define  shared variable RepPathName        as character no-undo .
      118   define  shared variable PrintRubl          as logical   no-undo .
      119   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      120   define variable v-waitfram-action01         as character   no-undo .
      121   define variable v-waitfram-action02         as character   no-undo .
      122   define variable v-waitfram-action03         as character   no-undo .
      123   define variable mWaitFramTextBeg            as character   no-undo.
      124   define variable mWaitFramTextEnd            as character   no-undo.
      125   define variable mWaitFramView               as logical     no-undo.
      126   define variable mWaitProcEvent              as logical     no-undo init yes.
      127   define variable mWaitFramInterval           as integer     no-undo init 1 .
      128   define variable mWaitFramStop               as logical     no-undo.
      129   define variable mWaitFramStopUser           as logical     no-undo.
      130   define variable mWaitFramStopTimeOut        as logical     no-undo.
      131   define variable mWaitFramStartProc          as datetime-tz no-undo.
      132   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      133   define button B-WaitFramStop auto-end-key
      134        label "Стоп"
      135        size 10 by 1 tooltip "Остоновить процесс".
      136   define button B-viewProcInfo
      137        label "Информация"
      138        size 15 by 1 tooltip "Информация о процесс".
      139   define frame waitfram
      140     v-waitfram-action01 format "x(72)" no-label skip
      141     v-waitfram-action02 format "x(72)" no-label skip
      142     v-waitfram-action03 format "x(72)" no-label skip
      143     B-viewProcInfo
      144     B-WaitFramStop at row 4 col 30
      145     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      146     .
      147   define new global shared variable mBatchMode as logical no-undo init ?.
      148   define variable mFramBachModHandle as handle no-undo.
      149   mFramBachModHandle = frame waitfram:handle.
      150   define variable mFameOldVis as logical no-undo.
      151   define variable mVisCUrentVin as logical no-undo.
      152   if session:batch-mode
      153   then
      154      mBatchMode = yes.
      155   if mBatchMode = ? then do:
      156     mVisCUrentVin = current-window:visible.
      157     mFameOldVis = mFramBachModHandle:visible.
      158     mFramBachModHandle:visible  = yes.
      159     mBatchMode = mFramBachModHandle:visible ne yes.
      160     mFramBachModHandle:visible = mFameOldVis.
      161     current-window:visible = mVisCUrentVin.
      162   end.
      163    if  log-manager:logfile-name ne ?
      164     then DO:
      165         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      166         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      167         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      168     end.
      169   on choose of B-WaitFramStop in frame waitfram
      170   do:
      171     mWaitFramStop = yes.
      172     mWaitFramStopUser = yes.
      173   end.
      174   function waitfram-check-timeout returns logical():
      175      define variable vtime as int64 no-undo.
      176      if mWaitFramStopTimeOut
      177      then
      178         return yes.
      179      vtime = ( now - mWaitFramStartProc ) / 1000 .
      180      if     mWaitFramTimeOut ne ?
      181         and mWaitFramTimeOut ne 0
      182         and mWaitFramTimeOut lt vtime
      183      then do:
      184         mWaitFramStopTimeOut = yes.
      185      end.
      186      return mWaitFramStopTimeOut.
      187   end.
      188   procedure waitfram-hide :
      189     if not session:batch-mode
      190     then do
      191     on error undo, return error return-value
      192     :
      193       pause 0 before-hide .
      194       if not mBatchMode then
      195         hide frame waitfram .
      196     end.
      197   end procedure.
      198   procedure waitfram-show :
      199     define input  parameter p-message as character no-undo .
      200     define variable v-left-margin as integer   no-undo .
      201     if not session:batch-mode
      202     then do
      203     on error undo, return error return-value
      204     :
      205       if length(p-message) <= 70 then do:
      206         assign
      207           v-left-margin = integer((70 - length(p-message)) / 2)
      208         .
      209         assign
      210           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      211         .
      212         assign
      213           v-waitfram-action01 = " "
      214           v-waitfram-action02 = " "
      215                                    + fill(" ", v-left-margin)
      216                                    + p-message
      217           v-waitfram-action03 = " "
      218         .
      219       end.
      220       else do:
      221         define variable vRindex1 as integer no-undo.
      222         define variable vRindex2 as integer no-undo.
      223         vRindex1 = r-index(p-message," ",70).
      224         if vRindex1 = 0
      225         then
      226            vRindex1 = 70.
      227         if length(p-message)  <= vRindex1 + 70 then do:
      228           assign
      229             v-waitfram-action01 = " "
      230             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      231             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      232           .
      233         end.
      234         else do:
      235           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      236           if vRindex2 <= vRindex1
      237           then
      238              vRindex2 = vRindex1 + 70.
      239           assign
      240             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      241             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      242             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      243           .
      244         end.
      245       end.
      246       B-viewProcInfo:visible   in frame waitfram = no.
      247       B-viewProcInfo:sensitive in frame waitfram = no.
      248       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      249       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      250       if  (   mWaitFramView
      251          or  mWaitProcEvent)
      252          and not mBatchMode
      253       then
      254          display
      255             v-waitfram-action01 skip
      256             v-waitfram-action02 skip
      257             v-waitfram-action03 skip
      258          with frame waitfram .
      259     end.
      260   end procedure.
      261      procedure waitfram-show-this:
      262         define input  parameter iInterval as int64 no-undo.
      263         define variable vtime as int64 no-undo.
      264         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      265         mWaitFramInterval = iInterval.
      266         run waitfram-show (substitute("&1&2 &3&4" ,
      267                                       mWaitFramTextBeg ,
      268                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      269                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      270                                       mWaitFramTextEnd
      271                                      )
      272                           ).
      273      end.
      274      procedure WaitFramRunPause:
      275         define input  parameter iInterval as dec no-undo.
      276         define variable vStart  as datetime-tz no-undo.
      277         define variable vend    as datetime-tz no-undo.
      278         define variable vint as int64 no-undo.
      279         define variable vOk as logical no-undo.
      280         vStart = now.
      281         vend   = vStart.
      282         publish "WaitFramPause" (iInterval,output vOk).
      283         vend   =  now.
      284         vint = vend - vStart.
      285         vint = iInterval - vint / 1000.
      286         if     not mWaitFramStop
      287            and (   vint > 0
      288                 or (    not vOk
      289                     and iInterval eq ?
      290                     )
      291                 )
      292         then
      293            run waitfram-show-this (iInterval).
      294         vend   =  now.
      295         vint = vend - vStart.
      296         vint = iInterval - vint / 1000.
      297         if     not mWaitFramStop
      298            and vint > 0
      299         then do:
      300            run gbl/pause.p (vint * 1000).
      301         end.
      302         if iInterval ne ?
      303         then
      304            publish "WaitFramStop".
      305         waitfram-check-timeout().
      306      end.
      307      procedure WaitFramWaitFor:
      308         define input  parameter iInterval as dec no-undo.
      309         assign
      310            mWaitFramStartProc   = now
      311            mWaitFramStopUser    = no
      312            mWaitFramStopTimeOut = no
      313         .
      314         block-wait:
      315         do while not mWaitFramStop:
      316            run WaitFramRunPause (iInterval).
      317            if  waitfram-check-timeout()
      318            then do:
      319               leave block-wait.
      320            end.
      321         end.
      322         run waitfram-hide.
      323      end.
      324   procedure waitfram-join :
      325     define input  parameter p-line-1  as character no-undo .
      326     define input  parameter p-line-2  as character no-undo .
      327     define input  parameter p-line-3  as character no-undo .
      328     define output parameter p-message as character no-undo .
      329     do
      330     on error undo, return error return-value
      331     :
      332       assign
      333         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      334                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      335                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      336       .
      337     end.
      338   end procedure.
      339   function waitfram-join-function returns character
      340     (input p-line-1 as character
      341     ,input p-line-2 as character
      342     ,input p-line-3 as character
      343     ).
      344     define variable v-message as character no-undo .
      345     run waitfram-join in this-procedure
      346       (input  p-line-1
      347       ,input  p-line-2
      348       ,input  p-line-3
      349       ,output v-message
      350       ) .
      351     return v-message .
      352   end function .
      353   define stream Out-Stream.
      354   define variable sym1  as character initial "|"   no-undo.
      355   define variable sym2  as character initial "|"   no-undo.
      356   define variable sym3  as character initial "|"   no-undo.
      357   define variable sym4  as character initial "|"   no-undo.
      358   define variable sym5  as character initial "|"   no-undo.
      359   define variable sym6  as character initial "|"   no-undo.
      360   define variable v-range       as character    no-undo.
      361   define variable v-doc-date    as date         no-undo .
      362   define variable v-firm-name   as character FORMAT "x(40)"    no-undo.
      363   define variable g#quest-print as logical   no-undo .
      364   define variable g#log         as logical   no-undo .
      365   define variable g#report-num as integer   no-undo .
      366   define variable v-counter    as integer      no-undo.
      367   define buffer buf_goods        for ub.goods .
      368   define buffer buf_wth-doc      for ub.wth-doc .
      369   define buffer buf_clients      for ub.clients .
      370   define buffer This_Object      for ub.clients .
      371     DEFINE FRAME frm-exch-1
      372         sym1                 no-label  format "X(1)"  space(0)
      373         ub.goods.gds-name       no-label  format "x(33)" space(0)
      374         sym3                 no-label  format "X(1)"  space(0)
      375         ub.wealth.wth-name      no-label  format "X(33)" space(0)
      376         sym2                 no-label  format "X(1)"  space(0)
      377         ub.wth-ser.series       no-label  format "X(18)" space(0)
      378         Sym4                 no-label  format "X(1)"  space(0)
      379         v-range              no-label  format "x(32)" space(0)
      380         sym5                 no-label  format "X(1)"  space(0)
      381         ub.wth-parts.fact-qnty  no-label  format "->>>,>>>,>>9"  space(0)
      382         sym6                 no-label  format "X(1)"  space(0)
      383        HEADER
      384            "+---------------------------------+---------------------------------+------------------+--------------------------------+------------+" skip
      385            "|                                 |                                 |                  |                                |            |" skip
      386            "|   Наименование нефтепродуктов   |             купюры              |       серия      |           № талона             | количество |" skip
      387            "|                                 |                                 |                  |                                |  талонов   |" skip
      388            "|                                 |                                 |                  |                                |            |" skip
      389            "+---------------------------------+---------------------------------+------------------+--------------------------------+------------+" skip
      390            "|                 1               |               2                 |         3        |                4               |      5     |" skip
      391         with width 136 down stream-io use-text no-label NO-BOX.
      392     DEFINE FRAME frm-exch-2
      393         sym1                 no-label  format "X(1)"  space(0)
      394         ub.goods.gds-name       no-label  format "x(33)" space(0)
      395         sym3                 no-label  format "X(1)"  space(0)
      396         ub.wealth.wth-name      no-label  format "X(33)" space(0)
      397         sym2                 no-label  format "X(1)"  space(0)
      398         ub.wth-ser.series       no-label  format "X(18)" space(0)
      399         Sym4                 no-label  format "X(1)"  space(0)
      400         v-range              no-label  format "x(32)" space(0)
      401         sym5                 no-label  format "X(1)"  space(0)
      402         ub.wth-parts.fact-qnty  no-label  format "->>>,>>>,>>9"  space(0)
      403         sym6                 no-label  format "X(1)"  space(0)
      404        HEADER
      405            "+---------------------------------+---------------------------------+------------------+--------------------------------+------------+" skip
      406            "|                                 |                                 |                  |                                |            |" skip
      407            "|   Наименование нефтепродуктов   |             купюры              |       серия      |           № талона             | количество |" skip
      408            "|                                 |                                 |                  |                                |  талонов   |" skip
      409            "|                                 |                                 |                  |                                |            |" skip
      410            "+---------------------------------+---------------------------------+------------------+--------------------------------+------------+" skip
      411            "|                 1               |               2                 |         3        |                4               |      5     |" skip
      412         with width 136 down stream-io use-text no-label NO-BOX.
      413   MAIN-BLOCK:
      414   do
      415   on error undo, return error
      416   :
      417      run waitfram-show in this-procedure ( input "Заполнение формы. Ждите..." ).
      418      find first buf_wth-doc
      419           where buf_wth-doc.doc-code = p-doc-code
      420           no-lock
      421           .
      422      assign
      423         v-doc-date = buf_wth-doc.fact-date
      424      .
      425      FIND FIRST This_Object
      426           WHERE This_Object.obj-type  = buf_wth-doc.obj-type
      427             AND This_Object.obj-code  = buf_wth-doc.obj-code
      428           NO-LOCK
      429           .
      430      FIND FIRST buf_clients
      431           WHERE buf_clients.obj-type  = 'орг':U
      432             AND buf_clients.obj-code  = buf_wth-doc.host-code
      433           NO-LOCK
      434           .
      435      assign
      436         v-firm-name = buf_clients.obj-name
      437      .
      438      release buf_wth-doc .
      439      run get-report-num  in parParentProc ( output g#report-num ).
      440      run get-quest-print in parParentProc ( output g#quest-print ).
      441   output STREAM Out-Stream to value( string( session:temp-directory +
      442                                        "rpt" + string( g#report-num ) ) )
      443                                        page-size  value(62) .
      444      assign
      445         v-counter = 0
      446      .
      447      run print-header-1 in this-procedure .
      448      run print-body-1   in this-procedure .
      449      run print-footer-1 in this-procedure .
      450      assign
      451         v-counter = 0
      452      .
      453      run print-header-2 in this-procedure .
      454      run print-body-2   in this-procedure .
      455      run print-footer-2 in this-procedure .
      456      run waitfram-hide in this-procedure .
      457      output stream Out-Stream CLOSE .
      458   if g#quest-print = false
      459   then do:
      460     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      461                                         7, (if 0 >= 8 then 2 else 0), 0, 0,
      462                                         OUTPUT g#log ).
      463   end.
      464   else do:
      465     os-command silent
      466       value( "COPY /b " +
      467         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      468         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      469         string( session:temp-directory) +  "$" + string( g#report-num )
      470                 ) .
      471     os-command silent
      472       value( "COPY /b " +
      473         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      474         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      475         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      476                 ) .
      477   end.
      478   end.
      479   procedure print-header-1 :
      480   do
      481   on error undo, return error
      482   :
      483      PUT  STREAM Out-Stream
      484         SPACE(60) "Форма НН-3-ДО" SKIP
      485         SPACE(5) v-firm-name    FORMAT "x(40)"  SKIP
      486         SPACE(5) "_______________________________________" SKIP
      487         SPACE(5) "(наименование предприятия, организации)" SKIP
      488         SPACE(50) "+----------------+--------+" SKIP
      489         SPACE(50) "|   Вид операции | Склад  |" SKIP
      490         SPACE(50) "+----------------+--------+" SKIP
      491         SPACE(50) "|                |        |" SKIP
      492         SPACE(50) "+----------------+--------+" SKIP
      493         SPACE(21) "НАКЛАДНАЯ No." p-doc-code FORMAT "x(14)"  SKIP
      494         SPACE(15) "НА ОБМЕН ТАЛОНОВ НА НЕФТЕПРОДУКТЫ" SKIP
      495         SPACE(25) "(литровые)" SKIP
      496         SPACE(25) v-doc-date FORMAT "99/99/9999" "г." SKIP(1)
      497         SPACE(5) "Основание ____________________________________________________________" SKIP(1)
      498         SPACE(5) "Кому ________________________________ через кого _____________________" SKIP(1)
      499         SPACE(5) "доверенность No. ____________" SKIP(2)
      500         SPACE(11) "РАСШИФРОВКА ПРИНЯТЫХ ТАЛОНОВ НА НЕФТЕПРОДУКТЫ ПО"    SKIP
      501         SPACE(10) "КУПЮРАМ, СЕРИЯМ И НОМЕРАМ (ЕДИНЫХ, РЫНОЧНОГО ФОНДА)" SKIP(1)
      502      .
      503   end.
      504   end procedure.
      505   procedure print-header-2 :
      506   do
      507   on error undo, return error
      508   :
      509      PUT  STREAM Out-Stream
      510         SPACE(11) "РАСШИФРОВКА ВЫДАННЫХ ТАЛОНОВ НА НЕФТЕПРОДУКТЫ ПО" SKIP
      511         SPACE(10) "КУПЮРАМ, СЕРИЯМ И НОМЕРАМ (ЕДИНЫХ, РЫНОЧНОГО ФОНДА)" SKIP
      512      .
      513   end.
      514   end procedure.
      515   procedure print-body-1 :
      516   define buffer buf_wth-parts   for ub.wth-parts .
      517   define buffer buf_wealth      for ub.wealth .
      518   define buffer buf_goods       for ub.goods .
      519   define buffer buf_wth-ser     for ub.wth-ser.
      520   do
      521   on error undo, return error
      522   :
      523      for each buf_wth-parts
      524         where buf_wth-parts.out-code  = p-doc-code
      525         and buf_wth-parts.type      = 'при':U
      526         no-lock
      527         ,
      528         first buf_wealth
      529         where buf_wealth.wth-code     = buf_wth-parts.wth-code
      530         no-lock
      531         ,
      532         first buf_goods
      533         where buf_goods.gds-code      = buf_wth-parts.gds-code
      534         no-lock
      535         ,
      536         first buf_wth-ser
      537         where buf_wth-ser.ser-code    = buf_wth-parts.ser-code
      538         and buf_wth-ser.db-num      = buf_wth-parts.db-num
      539         no-lock
      540         :
      541            assign
      542               v-counter = v-counter + 1
      543            .
      544            display stream Out-Stream
      545               buf_goods.gds-name  @ ub.goods.gds-name
      546               buf_wealth.wth-name @ ub.wealth.wth-name
      547               buf_wth-ser.series  @ ub.wth-ser.series
      548               SUBSTITUTE("&1 - &2", buf_wth-parts.fact-rangeFrom, buf_wth-parts.fact-rangeTo) @ v-range
      549               buf_wth-parts.fact-qnty @ ub.wth-parts.fact-qnty
      550               sym1
      551               sym2
      552               sym3
      553               sym4
      554               sym5
      555               sym6
      556            with FRAME frm-exch-1.
      557      end.
      558   end.
      559   end procedure.
      560   procedure print-body-2 :
      561   define buffer buf_wth-parts   for ub.wth-parts .
      562   define buffer buf_wealth      for ub.wealth .
      563   define buffer buf_goods       for ub.goods .
      564   define buffer buf_wth-ser     for ub.wth-ser.
      565   do
      566   on error undo, return error
      567   :
      568      for each buf_wth-parts
      569         where buf_wth-parts.out-code  = p-doc-code
      570         and buf_wth-parts.type      = 'рас':U
      571         no-lock
      572         ,
      573         first buf_wealth
      574         where buf_wealth.wth-code     = buf_wth-parts.wth-code
      575         no-lock
      576         ,
      577         first buf_goods
      578         where buf_goods.gds-code      = buf_wth-parts.gds-code
      579         no-lock
      580         ,
      581         first buf_wth-ser
      582         where buf_wth-ser.ser-code    = buf_wth-parts.ser-code
      583         and buf_wth-ser.db-num      = buf_wth-parts.db-num
      584         no-lock
      585         :
      586            assign
      587               v-counter = v-counter + 1
      588            .
      589            display stream Out-Stream
      590               buf_goods.gds-name  @ ub.goods.gds-name
      591               buf_wealth.wth-name @ ub.wealth.wth-name
      592               buf_wth-ser.series  @ ub.wth-ser.series
      593               SUBSTITUTE("&1 - &2", buf_wth-parts.fact-rangeFrom, buf_wth-parts.fact-rangeTo) @ v-range
      594               buf_wth-parts.fact-qnty @ ub.wth-parts.fact-qnty
      595               sym1
      596               sym2
      597               sym3
      598               sym4
      599               sym5
      600               sym6
      601            with FRAME frm-exch-2.
      602      end.
      603   end.
      604   end procedure.
      605   procedure print-footer-1 :
      606   do
      607   on error undo, return error
      608   :
      609      PUT  STREAM Out-Stream
      610      "+---------------------------------+---------------------------------+------------------+--------------------------------+------------+" skip
      611      .
      612      PUT  STREAM Out-Stream
      613         SKIP(2)
      614         SPACE(5) "Сдал    _____________________________  Принял _______________________" SKIP(4)
      615      .
      616   end.
      617   end procedure.
