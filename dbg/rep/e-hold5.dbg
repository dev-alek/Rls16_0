      564   define new global shared variable g#library  as handle no-undo .
      565   define new global shared variable g#library2 as handle no-undo .
      566   define variable var-report-r-b as character no-undo .
      567   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      568   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      569     (output var-report-r-b
      570     )  .
      571   procedure proc-alt-shift-f2:
      572     if not ibs.th.gbl.gbl-var:rcode
      573   then
      574     run gbl\inidebug.p .
      575   end.
      576   procedure proc-alt-shift-f3:
      577     run gbl/prvssinf.p
      578       ( input this-procedure
      579       ) .
      580   end.
      581   define variable v-inform-launched as logical no-undo initial false .
      582   procedure proc-alt-shift-f4:
      583     define variable v-action as character no-undo .
      584     if v-inform-launched = false then do:
      585       assign
      586         v-inform-launched = true
      587       .
      588       run gbl/d-inform.w
      589         (  input self
      590         ,  input this-procedure
      591         , output v-action
      592         ) no-error .
      593       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
      594       assign
      595         v-inform-launched = false
      596       .
      597     end.
      598   end.
      599   procedure proc-alt-f1:
      600     run gbl/corrhelp.p
      601       (input this-procedure
      602       ) .
      603   end .
      604   on alt-shift-f2 anywhere do:
      605     run proc-alt-shift-f2.
      606   end.
      607   on alt-shift-f3 anywhere do:
      608     run proc-alt-shift-f3 in this-procedure .
      609   end.
      610   on alt-shift-f4 anywhere do:
      611     run proc-alt-shift-f4 in this-procedure.
      612   end.
      613   on alt-f1 anywhere do:
      614     run proc-alt-f1 in this-procedure .
      615   end.
      616   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      617   procedure holdattr-code :
      618     do
      619     on error undo, return error
      620     :
      621       define input  parameter p-code           as character no-undo .
      622       define output parameter p-type           as character no-undo .
      623       define output parameter p-format         as character no-undo .
      624       define output parameter p-label          as character no-undo .
      625       define output parameter p-user-can-edit  as logical   no-undo .
      626       define output parameter p-output-display as logical   no-undo .
      627       define output parameter p-other          as character no-undo .
      628       case p-code :
      629               when 'begin-date':U then do:     assign     p-label = "Дата начала межфирменного архива"     p-type = 'T':U      p-format = "99/99/9999"     p-label = "Дата начала межфирменного архива"     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      630               when 'is-calc':U then do:     assign     p-label = "Произв.расчет арх."     p-type = 'L':U      p-format = "+/-"     p-label = "Произв.расчет арх."     p-user-can-edit  = false     p-output-display = true     p-other = '':u      .   end.
      631         otherwise do:
      632           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      633         end.
      634       end.
      635     end.
      636   end procedure.
      637   procedure holdattr-tooltip :
      638     do
      639     on error undo, return error
      640     :
      641       define input  parameter p-code    as character no-undo .
      642       define output parameter p-tooltip as character no-undo .
      643       define output parameter p-label   as character no-undo .
      644       case p-code :
      645               when 'begin-date':U then do:     assign     p-tooltip = "Дата начала межфирменного архива"     p-label = "Дата начала межфирменного архива" .   end.
      646               when 'is-calc':U then do:     assign     p-tooltip = "Производится расчет межфирменного архива"     p-label = "Произв.расчет арх." .   end.
      647         otherwise do:
      648           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      649         end.
      650       end.
      651     end.
      652   end procedure.
      653   procedure holdattr-value :
      654     do
      655     on error undo, return error
      656     :
      657       define input  parameter p-cat-code  like ub.hold-attr.cat-code     no-undo .
      658       define input  parameter p-code      like ub.hold-attr.attr-code  no-undo .
      659       define output parameter p-value     like ub.hold-attr.attr-value no-undo .
      660       define output parameter p-type      as character no-undo .
      661       define buffer buf_hold-attr for ub.hold-attr .
      662       def var v-format         as character no-undo .
      663       def var v-label          as character no-undo .
      664       def var v-user-can-edit  as logical   no-undo .
      665       def var v-output-display as logical   no-undo .
      666       def var v-other          as character no-undo .
      667       run holdattr-code in this-procedure
      668         (input  p-code
      669         ,output p-type
      670         ,output v-format
      671         ,output v-label
      672         ,output v-user-can-edit
      673         ,output v-output-display
      674         ,output v-other
      675         ) no-error .
      676       if error-status :error then do:
      677         undo, return error return-value .
      678       end.
      679       find first buf_hold-attr no-lock
      680         where buf_hold-attr.cat-code    = p-cat-code
      681           and buf_hold-attr.attr-code = p-code
      682         no-error .
      683       if avail buf_hold-attr then do:
      684         assign
      685           p-value =  buf_hold-attr.attr-value
      686         .
      687       end.
      688       else do:
      689         assign
      690           p-value = if p-type = 'L':U then "no":U else ""
      691         .
      692       end.
      693     end.
      694   end procedure.
      695   procedure holdattr-write :
      696     do
      697     on error undo, return error
      698     :
      699       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      700       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      701       define input parameter p-value     like ub.hold-attr.attr-value no-undo .
      702       define buffer buf_hold-attr for ub.hold-attr .
      703       def var v-type           as character no-undo .
      704       def var v-format         as character no-undo .
      705       def var v-label          as character no-undo .
      706       def var v-user-can-edit  as logical   no-undo .
      707       def var v-output-display as logical   no-undo .
      708       def var v-other          as character no-undo .
      709       run holdattr-code in this-procedure
      710         (input  p-code
      711         ,output v-type
      712         ,output v-format
      713         ,output v-label
      714         ,output v-user-can-edit
      715         ,output v-output-display
      716         ,output v-other
      717         ) no-error .
      718       if error-status :error then do:
      719         undo, return error return-value .
      720       end.
      721       find first buf_hold-attr exclusive-lock
      722         where buf_hold-attr.cat-code    = p-cat-code
      723           and buf_hold-attr.attr-code = p-code
      724         no-error .
      725       if not available buf_hold-attr then do:
      726         create buf_hold-attr .
      727         assign
      728           buf_hold-attr.cat-code    = p-cat-code
      729           buf_hold-attr.attr-code = p-code
      730         .
      731       end.
      732       assign
      733         buf_hold-attr.attr-value = p-value
      734       .
      735     end.
      736   end procedure.
      737   procedure holdattr-exist :
      738     do
      739     on error undo, return error
      740     :
      741       define input parameter p-cat-code    like ub.hold-attr.cat-code     no-undo .
      742       define input parameter p-code      like ub.hold-attr.attr-code  no-undo .
      743       define output parameter p-exist    as logical  no-undo .
      744       define buffer buf_hold-attr for ub.hold-attr .
      745       def var v-type           as character no-undo .
      746       def var v-format         as character no-undo .
      747       def var v-label          as character no-undo .
      748       def var v-user-can-edit  as logical   no-undo .
      749       def var v-output-display as logical   no-undo .
      750       def var v-other          as character no-undo .
      751       run holdattr-code in this-procedure
      752         (input  p-code
      753         ,output v-type
      754         ,output v-format
      755         ,output v-label
      756         ,output v-user-can-edit
      757         ,output v-output-display
      758         ,output v-other
      759         ) no-error .
      760       if error-status :error then do:
      761         undo, return error return-value .
      762       end.
      763       find first buf_hold-attr no-lock
      764         where buf_hold-attr.cat-code    = p-cat-code
      765           and buf_hold-attr.attr-code = p-code
      766         no-error .
      767       if  available buf_hold-attr then do:
      768         p-exist = yes.
      769       end.
      770     end.
      771   end procedure.
      772   procedure holdattr-delete :
      773     do
      774     on error undo, return error
      775     :
      776       define input parameter p-cat-code   like ub.hold-attr.cat-code     no-undo .
      777       define input parameter p-code     like ub.hold-attr.attr-code  no-undo .
      778       define output parameter p-deleted  as logical no-undo.
      779       define buffer buf_hold-attr for ub.hold-attr .
      780       def var v-type           as character no-undo .
      781       def var v-format         as character no-undo .
      782       def var v-label          as character no-undo .
      783       def var v-user-can-edit  as logical   no-undo .
      784       def var v-output-display as logical   no-undo .
      785       def var v-other          as character no-undo .
      786       run holdattr-code in this-procedure
      787         (input  p-code
      788         ,output v-type
      789         ,output v-format
      790         ,output v-label
      791         ,output v-user-can-edit
      792         ,output v-output-display
      793         ,output v-other
      794         ) no-error .
      795       if error-status :error then do:
      796         undo, return error return-value .
      797       end.
      798       find first buf_hold-attr exclusive-lock
      799         where buf_hold-attr.cat-code    = p-cat-code
      800           and buf_hold-attr.attr-code = p-code
      801         no-error NO-WAIT.
      802       if not available buf_hold-attr then do:
      803         p-deleted = no.
      804       end.
      805       else do:
      806         delete buf_hold-attr.
      807         p-deleted = yes.
      808       end.
      809     end.
      810   end procedure.
      811   procedure holdattr-news :
      812     do
      813     on error undo, return error
      814     :
      815       define input  parameter p-code           as character no-undo .
      816       define output parameter p-news           as logical   no-undo .
      817       case p-code :
      818               when 'begin-date':U then do:     assign     p-news = no.   end.
      819               when 'is-calc':U then do:     assign     p-news = no.   end.
      820         otherwise do:
      821           undo, return error "неизвестный атрибут межфирменного архива" + " " + p-code .
      822         end.
      823       end.
      824     end.
      825   end procedure.
      826   DEFINE VARIABLE dat AS INTEGER FORMAT "9999":U INITIAL 0
      827        LABEL "Отчетный год"
      828        VIEW-AS FILL-IN
      829        SIZE 6.13 BY 1 NO-UNDO.
      830   DEFINE RECTANGLE RECT-5
      831        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
      832        SIZE 25 BY 3.
      833   DEFINE FRAME F-Main
      834        dat AT ROW 2.54 COL 15.38 COLON-ALIGNED
      835        RECT-5 AT ROW 1.08 COL 1.63
      836       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
      837            SIDE-LABELS NO-UNDERLINE THREE-D
      838            AT COL 1 ROW 1 SCROLLABLE .
      839   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
      840   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
      841   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
      842   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
      843   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
      844   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
      845   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
      846   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
      847         adm-object-hdl = FRAME F-Main:HANDLE.
      848   RUN ensure-broker.
      849   THIS-PROCEDURE:ADM-DATA =
      850        'ADM1.1~`':U +
      851        'SmartObject~`':U +
      852        '~`':U +
      853        'NO ~`':U +
      854        '~`':U +
      855        '~`':U +
      856        '~`':U +
      857        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
      858           + "~`":U +
      859        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
      860        'Record-Source,Record-Target,TableIO-Target~`':U +
      861        '~`':U +
      862        '~`~`~`~`~`~`~`~`~`~`~`':U +
      863        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
      864            THEN "^^":U
      865        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
      866             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
      867   PROCEDURE adm-apply-entry :
      868     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      869   END PROCEDURE.
      870   PROCEDURE adm-destroy :
      871    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      872   END PROCEDURE.
      873   PROCEDURE adm-disable :
      874       DISABLE RECT-5 dat WITH FRAME F-Main.
      875       RUN dispatch ('disable-fields':U).
      876       RUN set-attribute-list ('ENABLED=no':U).
      877       RETURN.
      878   END PROCEDURE.
      879   PROCEDURE adm-edit-attribute-list :
      880         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
      881         RETURN.
      882   END PROCEDURE.
      883   PROCEDURE adm-enable :
      884       ENABLE UNLESS-HIDDEN RECT-5 dat WITH FRAME F-Main.
      885       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
      886       RUN set-attribute-list ('ENABLED=yes':U).
      887       RETURN.
      888   END PROCEDURE.
      889   PROCEDURE adm-exit :
      890        RUN notify ('exit':U).
      891     RETURN.
      892   END PROCEDURE.
      893   PROCEDURE adm-hide :
      894     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      895   END PROCEDURE.
      896   PROCEDURE adm-initialize :
      897     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      898   END PROCEDURE.
      899   PROCEDURE adm-show-errors :
      900       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
      901       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
      902           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
      903       END.
      904       RETURN.
      905   END PROCEDURE.
      906   PROCEDURE adm-UIB-mode :
      907     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      908   END PROCEDURE.
      909   PROCEDURE adm-view :
      910     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
      911   END PROCEDURE.
      912   PROCEDURE dispatch :
      913       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
      914       RUN broker-dispatch IN adm-broker-hdl
      915           (THIS-PROCEDURE, p-method-name) NO-ERROR.
      916       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
      917   END PROCEDURE.
      918   PROCEDURE ensure-broker :
      919   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
      920   IF RETURN-VALUE NE "ADM-Broker":U THEN
      921   DO:
      922       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
      923       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
      924   END.
      925   END PROCEDURE.
      926   PROCEDURE get-attribute :
      927     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
      928     RUN broker-get-attribute IN adm-broker-hdl
      929         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
      930     RETURN RETURN-VALUE.
      931   END PROCEDURE.
      932   PROCEDURE get-attribute-list :
      933     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
      934     RUN broker-get-attribute-list IN adm-broker-hdl
      935         (INPUT THIS-PROCEDURE,
      936          INPUT ?,
      937          OUTPUT p-attr-list) NO-ERROR.
      938     RETURN.
      939   END PROCEDURE.
      940   PROCEDURE new-state :
      941     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
      942     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
      943     RETURN.
      944   END PROCEDURE.
      945   PROCEDURE notify :
      946     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
      947     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
      948     IF RETURN-VALUE = "ADM-ERROR":U THEN
      949         RETURN "ADM-ERROR":U.
      950     RETURN.
      951   END PROCEDURE.
      952   PROCEDURE set-attribute-list :
      953     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
      954     RUN ensure-broker.
      955     RUN broker-set-attribute-list IN adm-broker-hdl
      956         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
      957     RETURN.
      958   END PROCEDURE.
      959   PROCEDURE set-position :
      960       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
      961       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
      962       IF VALID-HANDLE(adm-object-hdl) THEN
      963       DO:
      964         ASSIGN adm-object-hdl:ROW    =   p-row
      965                adm-object-hdl:COLUMN =   p-col.
      966       END.
      967       RETURN.
      968   END PROCEDURE.
      969   PROCEDURE adm-display-fields :
      970       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
      971       RETURN.
      972   END PROCEDURE.
      973   PROCEDURE adm-open-query :
      974     RETURN.
      975   END PROCEDURE.
      976   PROCEDURE adm-row-changed :
      977         IF VALID-HANDLE(adm-object-hdl) THEN
      978           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
      979         RUN notify ('row-available':U).
      980         RETURN.
      981   END PROCEDURE.
      982   PROCEDURE reposition-query :
      983       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
      984       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
      985       RETURN.
      986   END PROCEDURE.
      987     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
      988     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
      989     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
      990     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
      991     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
      992     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
      993     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
      994     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
      995     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      996     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
      997     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
      998     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
      999     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1000     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1001     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1002     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1003     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1004     IF "":U = "":U THEN
     1005       RUN modify-list-attribute IN adm-broker-hdl
     1006         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1007     RUN use-create-on-add(?).
     1008   PROCEDURE adm-add-record :
     1009       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1010          "must have at least one Enabled Table to perform Add.":U
     1011          VIEW-AS ALERT-BOX ERROR.
     1012       RETURN.
     1013   END PROCEDURE.
     1014   PROCEDURE adm-assign-record :
     1015    MESSAGE
     1016          "Object ":U THIS-PROCEDURE:FILE-NAME
     1017            "must have at least one Enabled Table to perform Assign.":U
     1018              VIEW-AS ALERT-BOX ERROR.
     1019      RETURN.
     1020     END PROCEDURE.
     1021   PROCEDURE adm-assign-statement :
     1022     RETURN.
     1023   END PROCEDURE.
     1024   PROCEDURE adm-cancel-record :
     1025      RETURN.
     1026     END PROCEDURE.
     1027   PROCEDURE adm-copy-record :
     1028       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1029        "must have at least one Enabled Table to perform Copy.":U
     1030          VIEW-AS ALERT-BOX ERROR.
     1031       RETURN.
     1032   END PROCEDURE.
     1033   PROCEDURE adm-create-record :
     1034      RETURN.
     1035   END PROCEDURE.
     1036   PROCEDURE adm-current-changed :
     1037     RETURN.
     1038   END PROCEDURE.
     1039   PROCEDURE adm-delete-record :
     1040    MESSAGE
     1041          "Object ":U THIS-PROCEDURE:FILE-NAME
     1042            "must have at least one Enabled Table to perform Delete.":U
     1043              VIEW-AS ALERT-BOX ERROR.
     1044       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1045       RETURN.
     1046   END PROCEDURE.
     1047   PROCEDURE adm-disable-fields :
     1048         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1049       RETURN.
     1050   END PROCEDURE.
     1051   PROCEDURE adm-enable-fields :
     1052       RETURN.
     1053   END PROCEDURE.
     1054   PROCEDURE adm-end-update :
     1055     RETURN.
     1056   END PROCEDURE.
     1057   PROCEDURE adm-reset-record :
     1058       RETURN.
     1059   END PROCEDURE.
     1060   PROCEDURE adm-update-record :
     1061       MESSAGE
     1062         "Object ":U THIS-PROCEDURE:FILE-NAME
     1063           "must have at least one Enabled Table to perform Update.":U
     1064             VIEW-AS ALERT-BOX ERROR.
     1065      RETURN.
     1066   END PROCEDURE.
     1067   PROCEDURE check-modified :
     1068   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1069   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1070   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1071   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1072     IF check-state = "check":U THEN
     1073     DO:
     1074       RUN get-link-handle IN adm-broker-hdl
     1075         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1076            OUTPUT group-target-list).
     1077       IF group-target-list NE "":U THEN
     1078       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1079         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1080         RUN check-modified IN curr-widget ('group-check':U).
     1081         IF RETURN-VALUE NE "":U THEN
     1082         DO:
     1083           RUN check-modified-message(RETURN-VALUE).
     1084           RETURN "":U.
     1085         END.
     1086       END.
     1087     END.
     1088     RETURN "":U.
     1089   END PROCEDURE.
     1090   PROCEDURE check-modified-message :
     1091     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1092        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1093           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1094        IF RETURN-VALUE = "YES":U THEN
     1095           RUN notify ('view,CONTAINER-SOURCE':U).
     1096        MESSAGE IF p-changed-table NE ? THEN
     1097           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1098           ELSE "Current values have been changed."
     1099           SKIP "  Do you wish to save those changes?"
     1100           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1101        IF ANS THEN
     1102        DO:
     1103           IF group-assign-target THEN
     1104             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1105           ELSE RUN dispatch('update-record':U).
     1106           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1107           DO:
     1108               MESSAGE "Changes to the previous record were not saved."
     1109                 VIEW-AS ALERT-BOX ERROR.
     1110               IF group-assign-target THEN
     1111                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1112               ELSE RUN dispatch ('cancel-record':U).
     1113           END.
     1114        END.
     1115        ELSE DO:
     1116          IF group-assign-target THEN
     1117             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1118          ELSE RUN dispatch('cancel-record':U).
     1119        END.
     1120        RETURN.
     1121   END PROCEDURE.
     1122   PROCEDURE get-rowid :
     1123       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1124       ASSIGN
     1125       p-table   =   adm-first-table.
     1126       RETURN.
     1127   END PROCEDURE.
     1128   PROCEDURE init-group-assign :
     1129       RUN request-attribute IN adm-broker-hdl
     1130         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1131       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1132         group-assign-target = yes.
     1133       ELSE group-assign-target = no.
     1134       RETURN.
     1135   END PROCEDURE.
     1136   PROCEDURE set-editors :
     1137       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1138       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1139       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1140       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1141       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1142       DO WHILE VALID-HANDLE (curr-widget):
     1143           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1144              curr-widget:HIDDEN = no THEN DO:
     1145             CASE p-field-setting:
     1146               WHEN "INITIALIZE":U THEN
     1147               DO:
     1148                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1149                     read-only-list +
     1150                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1151                        STRING(curr-widget).
     1152               END.
     1153               WHEN "DISABLE":U OR
     1154               WHEN "ENABLE":U THEN
     1155               DO:
     1156                   curr-widget:SENSITIVE = yes.
     1157                   RUN get-attribute ('Read-Only-Editors':U).
     1158                   IF RETURN-VALUE = ? OR
     1159                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1160                       curr-widget:READ-ONLY =
     1161                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1162               END.
     1163               WHEN "CLEAR":U THEN
     1164                   curr-widget:SCREEN-VALUE = "":U.
     1165             END CASE.
     1166           END.
     1167           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1168       END.
     1169       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1170         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1171           + '"':U).
     1172       RETURN.
     1173   END PROCEDURE.
     1174   PROCEDURE use-check-modified-all :
     1175    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1176     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1177     RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE use-create-on-add :
     1180   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1181      RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE use-initial-lock :
     1184     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1185     ASSIGN adm-initial-lock = p-attr-value.
     1186     RETURN.
     1187   END PROCEDURE.
     1188     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1189   ASSIGN
     1190          FRAME F-Main:SCROLLABLE       = FALSE
     1191          FRAME F-Main:HIDDEN           = TRUE.
     1192   if not this-procedure :persistent
     1193   then do:
     1194     message
     1195       vss-workfile vss-revision vss-description skip
     1196       "Ошибка при запуске процедуры" skip
     1197       "Данную процедуру следует запускать только с параметром persistent" skip
     1198       view-as alert-box error .
     1199     undo, return error .
     1200   end.
     1201   PROCEDURE disable_UI :
     1202     HIDE FRAME F-Main.
     1203     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1204   END PROCEDURE.
     1205   PROCEDURE local-initialize :
     1206     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1207     assign
     1208       dat :screen-value in frame F-Main = string(year(x-Date-Start))
     1209     .
     1210   END PROCEDURE.
     1211   PROCEDURE my-report :
     1212     define variable v-hold-date-value as character no-undo .
     1213     define variable v-hold-date-type  as character no-undo .
     1214     define variable v-cat-code as integer initial 1 no-undo .
     1215     run holdattr-value in this-procedure (input v-cat-code, input  'begin-date':U, output v-hold-date-value, output v-hold-date-type) .
     1216     define variable dat1 as date   no-undo .
     1217     assign dat1 = date(1,1,dat) .
     1218     if dat1 < date(v-hold-date-value) then message
     1219       "Дата начала отчетного периода "  dat1 " меньше"  skip
     1220       "даты начала рассчитаных архивов " v-hold-date-value "!" skip
     1221       "Отчет будет сформирован начиная с " v-hold-date-value
     1222       view-as alert-box WARNING TITLE "В Н И М А Н И Е ! " .
     1223    run rep/r-hold5.p  ( input dat ) .
     1224   END PROCEDURE.
     1225   PROCEDURE my-var :
     1226   assign frame F-Main dat .
     1227   ReportNAme = "Рейтинг поставщиков за "  + String(dat) + " год." .
     1228   if x-SET_val_TYPE = 1 then ReportHeader = "Цены указаны в: рублях".
     1229   else                       ReportHeader = "Цены указаны в: валюте".
     1230   END PROCEDURE.
