        1   DEFINE INPUT PARAMETER parParentProc  AS WIDGET-HANDLE NO-UNDO.
        2   define input parameter p-obj-type like ub.clients.obj-type no-undo .
        3   define input parameter p-obj-code like ub.clients.obj-code no-undo .
        4     define input-output parameter s-pole   as integer   no-undo .
        5     define output parameter min-sum  as decimal   no-undo .
        6     define output parameter v-nedost as logical   no-undo .
        7     define output parameter all-grp  as integer   no-undo .
        8     define output parameter list-grp as character no-undo .
        9     def var vss-revision    as character no-undo init "$Revision$":U .
       10     def var vss-author      as character no-undo init "$Author$":U .
       11     def var vss-date        as character no-undo init "$Date$":U .
       12     def var vss-workfile    as character no-undo init "$Workfile$":U .
       13     def var vss-archive     as character no-undo init "$Archive$":U .
       14     def var vss-description as character no-undo init "Формы по инвентаризации ".
       15   procedure vss-get-info :
       16     define output parameter p-vss-revision    like vss-revision    no-undo .
       17     define output parameter p-vss-author      like vss-author      no-undo .
       18     define output parameter p-vss-date        like vss-date        no-undo .
       19     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       20     define output parameter p-vss-archive     like vss-archive     no-undo .
       21     define output parameter p-vss-description like vss-description no-undo .
       22     assign
       23       p-vss-revision    = vss-revision
       24       p-vss-author      = vss-author
       25       p-vss-date        = vss-date
       26       p-vss-workfile    = vss-workfile
       27       p-vss-archive     = vss-archive
       28       p-vss-description = vss-description
       29     .
       30   end procedure.
       31   procedure vss-get-parameters :
       32     define output parameter p-vss-parameters as character no-undo .
       33   end procedure.
       34   define new global shared variable g#vssrevis-logger as handle    no-undo .
       35   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       36   define variable v-vssrevis-logger                   as handle    no-undo .
       37   procedure vss-logevent :
       38     define input  parameter p-extra-paramters as character no-undo .
       39     define variable v-vssrevis-parameters as character no-undo .
       40     do
       41     on error undo, return error return-value
       42     :
       43       if  valid-handle(v-vssrevis-logger)
       44       and v-vssrevis-logger :get-signature("logevent") <> ""
       45       then do:
       46         run vss-get-parameters in this-procedure
       47           (output v-vssrevis-parameters
       48           ).
       49         run logevent in v-vssrevis-logger
       50           (input vss-workfile
       51           ,input vss-revision
       52           ,input v-vssrevis-parameters
       53           ,input p-extra-paramters
       54           ).
       55       end.
       56     end.
       57   end procedure.
       58   assign
       59     v-vssrevis-logger = g#vssrevis-logger
       60   .
       61   if  valid-handle(v-vssrevis-logger)
       62   and v-vssrevis-logger :get-signature("logevent") <> ""
       63   then do:
       64     assign
       65       v-vssrevis-logevent = true
       66     .
       67     run vss-logevent in this-procedure (input vss-description) .
       68   end.
       69   procedure proc-alt-shift-f2:
       70     if not ibs.th.gbl.gbl-var:rcode
       71   then
       72     run gbl\inidebug.p .
       73   end.
       74   procedure proc-alt-shift-f3:
       75     run gbl/prvssinf.p
       76       ( input this-procedure
       77       ) .
       78   end.
       79   define variable v-inform-launched as logical no-undo initial false .
       80   procedure proc-alt-shift-f4:
       81     define variable v-action as character no-undo .
       82     if v-inform-launched = false then do:
       83       assign
       84         v-inform-launched = true
       85       .
       86       run gbl/d-inform.w
       87         (  input self
       88         ,  input this-procedure
       89         , output v-action
       90         ) no-error .
       91       run gbl/infrmact.p (input self, input this-procedure, input v-action) no-error .
       92       assign
       93         v-inform-launched = false
       94       .
       95     end.
       96   end.
       97   procedure proc-alt-f1:
       98     run gbl/corrhelp.p
       99       (input this-procedure
      100       ) .
      101   end .
      102   on alt-shift-f2 anywhere do:
      103     run proc-alt-shift-f2.
      104   end.
      105   on alt-shift-f3 anywhere do:
      106     run proc-alt-shift-f3 in this-procedure .
      107   end.
      108   on alt-shift-f4 anywhere do:
      109     run proc-alt-shift-f4 in this-procedure.
      110   end.
      111   on alt-f1 anywhere do:
      112     run proc-alt-f1 in this-procedure .
      113   end.
      114   DEFINE BUTTON Btn_OK AUTO-GO
      115        LABEL "&Ввод"
      116        SIZE 10 BY 1
      117        BGCOLOR 8 .
      118   DEFINE VARIABLE FILL-IN-1 AS DECIMAL FORMAT ">,>>>,>>>,>>9.99":U INITIAL 0
      119        LABEL "Ра&зница сумма"
      120        VIEW-AS FILL-IN
      121        SIZE 14 BY 1 NO-UNDO.
      122   DEFINE VARIABLE RADIO-SET-1 AS INTEGER
      123        VIEW-AS RADIO-SET VERTICAL
      124        RADIO-BUTTONS
      125             "по &наименованию", 1,
      126   "по &артикулу", 2,
      127   "по &разнице сумм", 3
      128        SIZE 20.88 BY 3 NO-UNDO.
      129   DEFINE VARIABLE RADIO-SET-2 AS INTEGER
      130        VIEW-AS RADIO-SET VERTICAL
      131        RADIO-BUTTONS
      132             "Не&достача", 1,
      133   "&Излишки", 2
      134        SIZE 14.5 BY 1.92 NO-UNDO.
      135   DEFINE VARIABLE RADIO-SET-3 AS INTEGER
      136        VIEW-AS RADIO-SET VERTICAL
      137        RADIO-BUTTONS
      138             "Все", 1,
      139   "Выборочно", 2
      140        SIZE 14.13 BY 1.75 NO-UNDO.
      141   DEFINE FRAME Dialog-Frame
      142        FILL-IN-1 AT ROW 1.54 COL 15.75 COLON-ALIGNED
      143        RADIO-SET-1 AT ROW 2.67 COL 36.88 NO-LABEL
      144        RADIO-SET-2 AT ROW 3.96 COL 3.25 NO-LABEL
      145        RADIO-SET-3 AT ROW 4.13 COL 18.5 NO-LABEL
      146        Btn_OK AT ROW 6.79 COL 20.13
      147        "Группы:" VIEW-AS TEXT
      148             SIZE 9.5 BY .67 AT ROW 3.08 COL 18.88
      149             FGCOLOR 4
      150        "Сортировка:" VIEW-AS TEXT
      151             SIZE 13.13 BY .67 AT ROW 1.79 COL 37.88
      152             FGCOLOR 4
      153        "Анализ:" VIEW-AS TEXT
      154             SIZE 9.5 BY .67 AT ROW 3.08 COL 5.13
      155             FGCOLOR 4
      156        SPACE(43.13) SKIP(4.49)
      157       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
      158            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
      159            TITLE "Инвентаризация (анализ отклонений)"
      160            DEFAULT-BUTTON Btn_OK.
      161   ASSIGN
      162          FRAME Dialog-Frame:SCROLLABLE       = FALSE
      163          FRAME Dialog-Frame:HIDDEN           = TRUE.
      164   ON WINDOW-CLOSE OF FRAME Dialog-Frame
      165   DO:
      166     APPLY "END-ERROR":U TO SELF.
      167   END.
      168   ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame
      169   DO:
      170     assign FILL-IN-1  RADIO-SET-1  RADIO-SET-2  RADIO-SET-3 .
      171     assign
      172       s-pole  = RADIO-SET-1
      173       min-sum = FILL-IN-1
      174       all-grp = RADIO-SET-3
      175     .
      176     if RADIO-SET-2 = 1 then assign v-nedost = yes .
      177     else                    assign v-nedost = no .
      178   END.
      179   ON VALUE-CHANGED OF RADIO-SET-3 IN FRAME Dialog-Frame
      180   DO:
      181     assign RADIO-SET-3 .
      182     if RADIO-SET-3 = 2 then do:
      183       run ref/gds-grp.w ( input parparentproc
      184                    , input "b-sel,b-mark"
      185                    , input p-obj-type
      186                    , input p-obj-code
      187                    , input-output list-grp ).
      188       if list-grp = "" then assign RADIO-SET-3 = 1 .
      189     end.
      190   END.
      191   IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME Dialog-Frame:PARENT eq ?
      192   THEN FRAME Dialog-Frame:PARENT = ACTIVE-WINDOW.
      193   MAIN-BLOCK:
      194   DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
      195      ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
      196     assign  RADIO-SET-1 = s-pole .
      197     RUN enable_UI.
      198     WAIT-FOR GO OF FRAME Dialog-Frame.
      199   END.
      200   RUN disable_UI.
      201   PROCEDURE disable_UI :
      202     HIDE FRAME Dialog-Frame.
      203   END PROCEDURE.
      204   PROCEDURE enable_UI :
      205     DISPLAY FILL-IN-1 RADIO-SET-1 RADIO-SET-2 RADIO-SET-3
      206         WITH FRAME Dialog-Frame.
      207     ENABLE FILL-IN-1 RADIO-SET-1 RADIO-SET-2 RADIO-SET-3 Btn_OK
      208         WITH FRAME Dialog-Frame.
      209     VIEW FRAME Dialog-Frame.
      210   END PROCEDURE.
