     1555       field shift-name as character
     1556       INDEX pi IS PRIMARY
     1557       obj-type
     1558       obj-code
     1559       gds-code
     1560       pump-code
     1561       pl-code
     1562       sale-date
     1563       shift-num
     1564       .
     1565   DEFINE FRAME TopsF
     1566   tops.sale-date column-label "Дата " format "99.99.99"
     1567   tops.shift-name column-label "Смена" format "X(2)"
     1568   tops.gds-code column-label "Код топлива" forMAT ">>>>>>>>>9"
     1569   tops.gds-name column-label "Топливо" format "X(25)"
     1570   tops.pump-code column-label "ТРК" format ">9"
     1571   tops.pl-code column-label "Танк"
     1572   tops.qnty column-label "Кол-во"
     1573   tops.tot-r-b column-label "Сумма брутто" format "->>>,>>>,>>9.99"
     1574   tops.discnt-r-b column-label "Сумма скидок" format "->>>,>>>,>>9.99"
     1575   for-netto column-label "Сумма нетто" format "->>>,>>>,>>9.99"
     1576   HEADER  date_string format "X(35)" AT 5
     1577   v-header-base-curr        format "X(20)" AT 42
     1578   "Страница " AT 65 PAGE-NUMBER( PrnLibStream )  AT 75 FORMAT ">>9" SKIP
     1579   Line format "X(82)" AT 1
     1580   with width 232 down stream-io use-text .
     1581   DEFINE VARIABLE RS-By AS INTEGER INITIAL 1
     1582        VIEW-AS RADIO-SET VERTICAL
     1583        RADIO-BUTTONS
     1584             "Без разбиения по ТРК и бакам", 0,
     1585   "C разбиением по ТРК и бакам", 1
     1586        SIZE 31.63 BY 1.79 NO-UNDO.
     1587   DEFINE FRAME F-Main
     1588        RS-By AT ROW 2.79 COL 4 NO-LABEL
     1589       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1590            SIDE-LABELS NO-UNDERLINE THREE-D
     1591            AT COL 1 ROW 1
     1592            SIZE 42.72 BY 11.88.
     1593   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1594   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1595   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1596   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1597   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1598   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1599   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1600   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1601       ASSIGN adm-object-hdl = FRAME F-Main:HANDLE.
     1602   RUN ensure-broker.
     1603   THIS-PROCEDURE:ADM-DATA =
     1604        'ADM1.1~`':U +
     1605        'SmartObject~`':U +
     1606        'FRAME~`':U +
     1607        'NO ~`':U +
     1608        '~`':U +
     1609        '~`':U +
     1610        '~`':U +
     1611        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1612           + "~`":U +
     1613        'Layout,Hide-on-Init~`':U +
     1614        '~`':U +
     1615        '~`':U +
     1616        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1617        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1618            THEN "^^":U
     1619        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1620             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1621   PROCEDURE adm-apply-entry :
     1622     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1623   END PROCEDURE.
     1624   PROCEDURE adm-destroy :
     1625    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1626   END PROCEDURE.
     1627   PROCEDURE adm-disable :
     1628       DISABLE RS-By WITH FRAME F-Main.
     1629       RUN dispatch ('disable-fields':U).
     1630       RUN set-attribute-list ('ENABLED=no':U).
     1631       RETURN.
     1632   END PROCEDURE.
     1633   PROCEDURE adm-edit-attribute-list :
     1634         RUN adm/support/contnrd.w (INPUT THIS-PROCEDURE).
     1635         RETURN.
     1636   END PROCEDURE.
     1637   PROCEDURE adm-enable :
     1638       ENABLE UNLESS-HIDDEN RS-By WITH FRAME F-Main.
     1639       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1640       RUN set-attribute-list ('ENABLED=yes':U).
     1641       RETURN.
     1642   END PROCEDURE.
     1643   PROCEDURE adm-exit :
     1644        RUN notify ('exit':U).
     1645     RETURN.
     1646   END PROCEDURE.
     1647   PROCEDURE adm-hide :
     1648     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1649   END PROCEDURE.
     1650   PROCEDURE adm-initialize :
     1651     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1652   END PROCEDURE.
     1653   PROCEDURE adm-show-errors :
     1654       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1655       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1656           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1657       END.
     1658       RETURN.
     1659   END PROCEDURE.
     1660   PROCEDURE adm-UIB-mode :
     1661     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1662   END PROCEDURE.
     1663   PROCEDURE adm-view :
     1664     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1665   END PROCEDURE.
     1666   PROCEDURE dispatch :
     1667       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1668       RUN broker-dispatch IN adm-broker-hdl
     1669           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1670       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1671   END PROCEDURE.
     1672   PROCEDURE ensure-broker :
     1673   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1674   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1675   DO:
     1676       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1677       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1678   END.
     1679   END PROCEDURE.
     1680   PROCEDURE get-attribute :
     1681     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1682     RUN broker-get-attribute IN adm-broker-hdl
     1683         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1684     RETURN RETURN-VALUE.
     1685   END PROCEDURE.
     1686   PROCEDURE get-attribute-list :
     1687     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1688     RUN broker-get-attribute-list IN adm-broker-hdl
     1689         (INPUT THIS-PROCEDURE,
     1690          INPUT ?,
     1691          OUTPUT p-attr-list) NO-ERROR.
     1692     RETURN.
     1693   END PROCEDURE.
     1694   PROCEDURE new-state :
     1695     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1696     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1697     RETURN.
     1698   END PROCEDURE.
     1699   PROCEDURE notify :
     1700     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1701     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1702     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1703         RETURN "ADM-ERROR":U.
     1704     RETURN.
     1705   END PROCEDURE.
     1706   PROCEDURE set-attribute-list :
     1707     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1708     RUN ensure-broker.
     1709     RUN broker-set-attribute-list IN adm-broker-hdl
     1710         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1711     RETURN.
     1712   END PROCEDURE.
     1713   PROCEDURE set-position :
     1714       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1715       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1716       IF VALID-HANDLE(adm-object-hdl) THEN
     1717       DO:
     1718           DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
     1719           IF adm-object-hdl:TYPE = "WINDOW":U THEN
     1720           DO:
     1721             IF p-row = 0 THEN p-row =
     1722               (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2.
     1723             IF p-col = 0 THEN p-col =
     1724               (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
     1725           END.
     1726           ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
     1727           DO:
     1728             parent-hdl = adm-object-hdl:PARENT.
     1729             IF p-row = 0 THEN p-row =
     1730               ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2) -
     1731                 parent-hdl:ROW.
     1732             IF p-col = 0 THEN p-col =
     1733               ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2) -
     1734                 parent-hdl:COL.
     1735           END.
     1736           IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
     1737           IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
     1738         ASSIGN adm-object-hdl:ROW    =   p-row
     1739                adm-object-hdl:COLUMN =   p-col.
     1740       END.
     1741       RETURN.
     1742   END PROCEDURE.
     1743   RUN set-attribute-list ("CURRENT-PAGE=0,ADM-OBJECT-HANDLE=":U +
     1744       STRING(adm-object-hdl)).
     1745   PAUSE 0 BEFORE-HIDE.
     1746   PROCEDURE adm-change-page :
     1747     RUN broker-change-page IN adm-broker-hdl (INPUT THIS-PROCEDURE) NO-ERROR.
     1748     END PROCEDURE.
     1749   PROCEDURE delete-page :
     1750     DEFINE INPUT PARAMETER p-page# AS INTEGER NO-UNDO.
     1751     RUN broker-delete-page IN adm-broker-hdl
     1752         (INPUT THIS-PROCEDURE, INPUT p-page#).
     1753     END PROCEDURE.
     1754   PROCEDURE init-object :
     1755     DEFINE INPUT PARAMETER  p-proc-name   AS CHARACTER NO-UNDO.
     1756     DEFINE INPUT PARAMETER  p-parent-hdl  AS HANDLE    NO-UNDO.
     1757     DEFINE INPUT PARAMETER  p-attr-list   AS CHARACTER NO-UNDO.
     1758     DEFINE OUTPUT PARAMETER p-proc-hdl    AS HANDLE    NO-UNDO.
     1759     RUN broker-init-object IN adm-broker-hdl
     1760         (INPUT THIS-PROCEDURE, INPUT p-proc-name, INPUT p-parent-hdl,
     1761          INPUT p-attr-list, OUTPUT p-proc-hdl) NO-ERROR.
     1762     RETURN.
     1763   END PROCEDURE.
     1764   PROCEDURE init-pages :
     1765     DEFINE INPUT PARAMETER p-page-list      AS CHARACTER NO-UNDO.
     1766     RUN broker-init-pages IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1767         INPUT p-page-list) NO-ERROR.
     1768     END PROCEDURE.
     1769   PROCEDURE select-page :
     1770     DEFINE INPUT PARAMETER p-page#     AS INTEGER   NO-UNDO.
     1771     RUN broker-select-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1772         INPUT p-page#) NO-ERROR.
     1773     END PROCEDURE.
     1774   PROCEDURE view-page :
     1775     DEFINE INPUT PARAMETER p-page#      AS INTEGER   NO-UNDO.
     1776     RUN broker-view-page IN adm-broker-hdl (INPUT THIS-PROCEDURE,
     1777         INPUT p-page#).
     1778     END PROCEDURE.
     1779   if not this-procedure :persistent
     1780   then do:
     1781     message
     1782       vss-workfile vss-revision vss-description skip
     1783       "Ошибка при запуске процедуры" skip
     1784       "Данную процедуру следует запускать только с параметром persistent" skip
     1785       view-as alert-box error .
     1786     undo, return error .
     1787   end.
     1788   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1789   PROCEDURE no-benq.
     1790   DEFINE OUTPUT PARAMETER found as logical init no.
     1791   define buffer buf_chk-doc for ub.chk-doc.
     1792   FOR EACH obj-list WHERE
     1793           obj-list.obj-type = 'маг':U NO-LOCK :
     1794     CASE X-Radio-Task > 1 :
     1795       WHEN YES THEN DO:
     1796         FOR EACH buf_chk-doc NO-LOCK WHERE
     1797                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1798                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1799                 (
     1800                   buf_chk-doc.shift-date >= X-date-start AND
     1801                   buf_chk-doc.shift-date <= X-date-end)
     1802                   AND
     1803                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1804           IF X-Radio-Task = 3 AND
     1805           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1806             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1807           IF X-Radio-Task = 4 AND
     1808           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1809           found = yes.
     1810           return.
     1811         END.
     1812       END.
     1813       WHEN NO THEN DO:
     1814         FOR EACH buf_chk-doc NO-LOCK WHERE
     1815               buf_chk-doc.obj-type = obj-list.obj-type AND
     1816               buf_chk-doc.obj-code = obj-list.obj-code AND
     1817               buf_chk-doc.chk-date >= X-date-start AND
     1818               buf_chk-doc.chk-date <= X-date-end   AND
     1819               (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1820           found = yes.
     1821           return.
     1822         END.
     1823        END.
     1824      END CASE.
     1825    END.
     1826   END PROCEDURE.
     1827   PROCEDURE no-benqi.
     1828   DEFINE OUTPUT PARAMETER found as logical init no.
     1829   define buffer buf_chk-doc for ub.chk-doc.
     1830   define buffer buf_inkas for ub.inkas.
     1831   FOR EACH obj-list WHERE
     1832         obj-list.obj-type = 'маг':U NO-LOCK :
     1833     CASE X-Radio-Task > 1 :
     1834       WHEN YES THEN DO:
     1835         FOR EACH buf_chk-doc No-LOCK WHERE
     1836                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1837                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1838                 (
     1839                   buf_chk-doc.shift-date >= X-date-start AND
     1840                   buf_chk-doc.shift-date <= X-date-end)
     1841                   AND
     1842                   buf_Chk-doc.out-code = ? AND
     1843                   (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1844           IF X-Radio-Task = 3 AND
     1845           ((buf_chk-doc.shift-date = X-date-start AND buf_chk-doc.shift-num < X-shift-Start) OR
     1846             (buf_chk-doc.shift-date = X-date-end AND  buf_chk-doc.shift-num > X-shift-End) ) THEN NEXT.
     1847           IF X-Radio-Task = 4 AND
     1848           (buf_chk-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1849           found = yes.
     1850           return.
     1851         END.
     1852         FOR EACH buf_inkas No-LOCK WHERE
     1853                   buf_inkas.obj-type = obj-list.obj-type AND
     1854                   buf_inkas.obj-code = obj-list.obj-code AND
     1855                   (
     1856                   buf_inkas.shift-date >= X-date-start AND
     1857                   buf_inkas.shift-date <= X-date-end):
     1858           if buf_inkas.status_ = 'факт':U
     1859           or buf_inkas.status_ = 'запрос':U then next.
     1860           IF X-Radio-Task = 3 AND
     1861           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1862             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1863           IF X-Radio-Task = 4 AND
     1864           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1865           found = yes.
     1866           return.
     1867         END.
     1868       END.
     1869       WHEN NO THEN DO:
     1870         FOR EACH buf_chk-doc NO-LOCK WHERE
     1871                 buf_chk-doc.obj-type = obj-list.obj-type AND
     1872                 buf_chk-doc.obj-code = obj-list.obj-code AND
     1873                 buf_chk-doc.chk-date >= X-date-start AND
     1874                 buf_chk-doc.chk-date <= X-date-end   AND
     1875                 buf_Chk-doc.out-code = ? AND
     1876                 (IF cas-num > 0 then buf_chk-doc.pay-desk = cas-num ELSE TRUE):
     1877           found = yes.
     1878           return.
     1879         END.
     1880         FOR EACH buf_inkas NO-LOCK WHERE
     1881                 buf_inkas.obj-type = obj-list.obj-type AND
     1882                 buf_inkas.obj-code = obj-list.obj-code AND
     1883                 buf_inkas.doc-date >= X-date-start AND
     1884                 buf_inkas.doc-date <= X-date-end :
     1885           if buf_inkas.status_ = 'факт':U
     1886           or buf_inkas.status_ = 'запрос':U then next.
     1887           found = yes.
     1888           return.
     1889         END.
     1890       END.
     1891     END CASE.
     1892   END.
     1893   END PROCEDURE.
     1894   PROCEDURE no-benq-i.
     1895   DEFINE OUTPUT PARAMETER found as logical init no.
     1896   define buffer buf_inkas for ub.inkas.
     1897   CASE X-Radio-Task > 1:
     1898     WHEN YES then do:
     1899       FOR EACH obj-list WHERE
     1900               obj-list.obj-type = 'маг':U NO-LOCK :
     1901         FOR EACH buf_inkas NO-LOCK WHERE
     1902                 buf_inkas.obj-type = obj-list.obj-type AND
     1903                 buf_inkas.obj-code = obj-list.obj-code AND
     1904                 buf_inkas.status_ = 'факт':U AND
     1905                 (
     1906                 buf_inkas.shift-date >= X-date-start AND
     1907                 buf_inkas.shift-date <= X-date-end):
     1908           IF X-Radio-Task = 3 AND
     1909           ((buf_inkas.shift-date = X-date-start AND buf_inkas.shift-num < X-shift-Start) OR
     1910             (buf_inkas.shift-date = X-date-end AND  buf_inkas.shift-num > X-shift-End) ) THEN NEXT.
     1911           IF X-Radio-Task = 4 AND
     1912           (buf_inkas.shift-num <> X-shift-Alone ) THEN NEXT.
     1913           found = yes.
     1914           return.
     1915         END.
     1916     END.
     1917     END.
     1918     WHEN NO THEN DO:
     1919       FOR EACH obj-list WHERE
     1920               obj-list.obj-type = 'маг':U NO-LOCK :
     1921         FOR EACH buf_inkas NO-LOCK WHERE
     1922                 buf_inkas.obj-type = obj-list.obj-type AND
     1923                 buf_inkas.obj-code = obj-list.obj-code AND
     1924                 buf_inkas.status_ = 'факт':U AND
     1925                 buf_inkas.doc-date >= X-date-start AND
     1926                 buf_inkas.doc-date <= X-date-end :
     1927            found = yes.
     1928            return.
     1929         END.
     1930       END.
     1931     END.
     1932   END CASE.
     1933   END PROCEDURE.
     1934   PROCEDURE no-benq-i-office.
     1935   DEFINE OUTPUT PARAMETER found as logical init no.
     1936   define buffer buf_sale-doc for ub.sale-doc.
     1937   CASE X-Radio-Task > 1:
     1938     WHEN YES then do:
     1939       FOR EACH obj-list WHERE
     1940               obj-list.obj-type = 'маг':U NO-LOCK :
     1941         FOR EACH buf_sale-doc NO-LOCK WHERE
     1942                  buf_Sale-doc.obj-type = obj-list.obj-type
     1943              AND buf_sale-doc.obj-code = obj-list.obj-code
     1944              AND buf_sale-doc.status_ = 'факт':U
     1945              AND buf_sale-doc.chr-office = 'у':U
     1946              AND (
     1947                 buf_sale-doc.shift-date >= X-date-start
     1948                 AND
     1949                 buf_sale-doc.shift-date <= X-date-end):
     1950           IF X-Radio-Task = 3 AND
     1951           ((buf_sale-doc.shift-date = X-date-start AND buf_sale-doc.shift-num < X-shift-Start) OR
     1952             (buf_sale-doc.shift-date = X-date-end AND  buf_sale-doc.shift-num > X-shift-End) ) THEN NEXT.
     1953           IF X-Radio-Task = 4 AND
     1954           (buf_sale-doc.shift-num <> X-shift-Alone ) THEN NEXT.
     1955           found = yes.
     1956           return.
     1957         END.
     1958       END.
     1959     END.
     1960     WHEN NO THEN DO:
     1961       FOR EACH obj-list WHERE
     1962               obj-list.obj-type = 'маг':U NO-LOCK :
     1963         FOR EACH buf_sale-doc NO-LOCK WHERE
     1964                 buf_sale-doc.obj-type = obj-list.obj-type
     1965            AND  buf_sale-doc.obj-code = obj-list.obj-code
     1966            AND  buf_sale-doc.status_ = 'факт':U
     1967            AND  buf_sale-doc.chr-office = 'у':U
     1968            AND  buf_sale-doc.doc-date >= X-date-start
     1969            AND  buf_sale-doc.doc-date <= X-date-end :
     1970           found = yes.
     1971           return.
     1972         END.
     1973       END.
     1974     END.
     1975   END CASE.
     1976   END PROCEDURE.
     1977   PROCEDURE adm-create-objects :
     1978   END PROCEDURE.
     1979   PROCEDURE adm-row-available :
     1980     DEFINE VARIABLE tbl-list           AS CHARACTER INIT "":U NO-UNDO.
     1981     DEFINE VARIABLE rowid-list         AS CHARACTER NO-UNDO.
     1982     DEFINE VARIABLE row-avail-cntr     AS INTEGER INIT 0 NO-UNDO.
     1983     DEFINE VARIABLE row-avail-rowid    AS ROWID NO-UNDO.
     1984     DEFINE VARIABLE row-avail-enabled  AS LOGICAL NO-UNDO.
     1985     DEFINE VARIABLE link-handle        AS CHARACTER NO-UNDO.
     1986     DEFINE VARIABLE record-source-hdl  AS HANDLE NO-UNDO.
     1987     DEFINE VARIABLE different-row      AS LOGICAL NO-UNDO INIT no.
     1988     DEFINE VARIABLE key-name           AS CHARACTER INIT ? NO-UNDO.
     1989     DEFINE VARIABLE key-value          AS CHARACTER INIT ? NO-UNDO.
     1990     RUN check-modified IN THIS-PROCEDURE ('check':U) NO-ERROR.
     1991     IF adm-updating-record THEN RETURN.
     1992     RUN get-attribute ('FIELDS-ENABLED':U).
     1993     row-avail-enabled = IF RETURN-VALUE = "YES":U THEN yes ELSE no.
     1994     RUN get-link-handle IN adm-broker-hdl (THIS-PROCEDURE, 'RECORD-SOURCE':U,
     1995         OUTPUT link-handle) NO-ERROR.
     1996     IF link-handle = "":U THEN
     1997         RETURN.
     1998     ASSIGN record-source-hdl = WIDGET-HANDLE(ENTRY(1,link-handle)).
     1999     IF NUM-ENTRIES(link-handle) > 1 THEN
     2000         MESSAGE "row-available in ":U THIS-PROCEDURE:FILE-NAME
     2001             "encountered more than one RECORD-SOURCE.":U SKIP
     2002             "The first - ":U record-source-hdl:file-name " - will be used.":U
     2003                VIEW-AS ALERT-BOX ERROR.
     2004     RUN get-attribute ('Key-Name':U).
     2005     key-name = RETURN-VALUE.
     2006     IF key-name = "":U THEN key-name = ?.
     2007     IF key-name NE ? THEN DO:
     2008       RUN send-key IN record-source-hdl (INPUT key-name, OUTPUT key-value)
     2009         NO-ERROR.
     2010       IF key-value NE ? THEN
     2011         RUN set-attribute-list (SUBSTITUTE ('Key-Value="&1"':U, key-value)).
     2012     END.
     2013   IF VALID-HANDLE (adm-object-hdl) THEN
     2014       RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2015   RUN notify IN THIS-PROCEDURE ('row-available':U).
     2016   END PROCEDURE.
     2017   PROCEDURE disable_UI :
     2018     HIDE FRAME F-Main.
     2019     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2020   END PROCEDURE.
     2021   PROCEDURE enable_UI :
     2022     DISPLAY RS-By
     2023         WITH FRAME F-Main.
     2024     ENABLE RS-By
     2025         WITH FRAME F-Main.
     2026   END PROCEDURE.
     2027   PROCEDURE My-report :
     2028   assign
     2029   FRAME F-Main RS-BY
     2030   .
     2031   run My-var.
     2032   assign
     2033   date_string = cur-time-print()
     2034   Line = fill( "-", 140 ).
     2035   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     2036   IF RS-By > 0 then HowBreak = YES.
     2037   ELSE HowBreak = No.
     2038   if v-curr-r-b = 'base':U then do:
     2039     sale-price-type = base-type.
     2040   end.
     2041   else do:
     2042     sale-price-type = "рублей".
     2043   end.
     2044   FOR EACH tops:
     2045       delete tops.
     2046   END.
     2047   run no-benq-i(output found).
     2048   if not found then do:
     2049       run waitfram-hide in this-procedure .
     2050       message "Не было закрытах отчетов о продажах топлива на выбранных объектах в течение заданного Вами периода времени." view-as alert-box information .
     2051       return.
     2052   end.
     2053   RUN petsaleq(input X-Radio-Task,
     2054                input cas-shft,
     2055                input X-date-start,
     2056                input X-date-end,
     2057                input X-shift-start,
     2058                input X-shift-end,
     2059                input HowBreak) .
     2060   RUN Print-no-break.
     2061   run prn-lib-prn-file in this-procedure (
     2062                                             input my-handle
     2063                                             ,input 8
     2064                                             ).
     2065   END PROCEDURE.
     2066   PROCEDURE My-var :
     2067   assign frame F-Main
     2068   RS-by.
     2069   Assign
     2070    STR-obj-type = ''
     2071    STR-obj-code = ''
     2072    STR-obj-name = ''
     2073    STR-obj      = ''.
     2074   For each obj-list no-lock:
     2075    Assign
     2076    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     2077    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     2078    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     2079    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     2080   End.
     2081   ReportNAme = "Расход нефтепродуктов через ТРК".
     2082   ReportHeader =  radio-label(string(RS-by), RS-by:radio-buttons) .
     2083   END PROCEDURE.
     2084   PROCEDURE petsaleq :
     2085   DEFINE INPUT PARAMETER period-type as integer no-undo.
     2086   DEFINE INPUT PARAMETER cas-shft as logical no-undo.
     2087   DEFINE INPUT PARAMETER X-date-start as date no-undo.
     2088   DEFINE INPUT PARAMETER X-date-end as date no-undo.
     2089   DEFINE INPUT PARAMETER X-shift-start as integer no-undo.
     2090   DEFINE INPUT PARAMETER X-shift-end as integer no-undo.
     2091   DEFINE INPUT PARAMETER HOWBREAK as logical No-undo.
     2092   define buffer ret-doc for ub.trn-doc.
     2093   CASE Period-Type > 1:
     2094       WHEN yes then do:
     2095           FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     2096               ACCUMULATE obj-list.obj-code ( COUNT ) .
     2097               FOR EACH ub.inkas WHERE inkas.obj-type = obj-list.obj-type AND
     2098                                                             ub.inkas.obj-code = obj-list.obj-code AND
     2099                                                             ub.inkas.status_ = 'факт':U AND
     2100                                                              (
     2101                                                              ub.inkas.shift-date >= X-date-start AND
     2102                                                              ub.inkas.shift-date <= X-date-end)
     2103                                                             NO-LOCK use-index shift:
     2104                      IF Period-Type = 3 AND
     2105                           ((inkas.shift-date = X-date-start AND ub.inkas.shift-num < X-shift-start) OR
     2106                            (inkas.shift-date = X-date-end AND  ub.inkas.shift-num > X-shift-end) ) THEN NEXT.
     2107                      IF Period-type = 4 AND
     2108                            inkas.shift-num <> X-Shift-Alone then NEXT.
     2109                   FIND FIRST ub.trn-doc No-LOCK WHERE trn-doc.doc-code = ub.inkas.inkas-code No-ERROR.
     2110                   FIND FIRST ret-doc No-LOCK WHERE ret-doc.doc-code = ub.trn-doc.out-code No-ERROR.
     2111              FOR EACH ub.doc-pl-pump No-LOCK where ub.doc-pl-pump.out-code = trn-doc.doc-code,
     2112                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl-pump.gds-code,
     2113                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = trn-doc.doc-code AND
     2114                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     2115                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2116                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     2117                   if HOWBREAK then do:
     2118                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2119                                                                 tops.obj-type = ub.inkas.obj-type AND
     2120                                                                 tops.obj-code = ub.inkas.obj-code AND
     2121                                                                 tops.shift-num = ub.inkas.shift-num AND
     2122                                                                 tops.sale-date = ub.inkas.doc-date AND
     2123                                                                 tops.pump-code  = ub.doc-pl-pump.pump-code AND
     2124                                                                 tops.pl-code = ub.doc-pl-pump.pl-code No-ERROR.
     2125                   END.
     2126                   ELSE do:
     2127                       FIND FIRST tops WHERE tops.gds-code = goods.gds-code AND
     2128                                                                 tops.obj-type = "" AND
     2129                                                                 tops.obj-code = 0 AND
     2130                                                                 tops.shift-num = ub.inkas.shift-num AND
     2131                                                                 tops.sale-date = ub.inkas.doc-date AND
     2132                                                                 tops.pump-code  = 0 AND
     2133                                                                 tops.pl-code = 0 No-ERROR.
     2134                   END.
     2135                      IF NOT AVAIL tops then do:
     2136                           create tops.
     2137                           assign
     2138                           tops.gds-code = ub.doc-pl-pump.gds-code
     2139                           tops.gds-name = ub.goods.gds-name
     2140                           tops.obj-type = if HowBreak then ub.inkas.obj-type else ""
     2141                           tops.obj-code = if HowBreak then ub.inkas.obj-code else 0
     2142                           tops.shift-num = ub.inkas.shift-num
     2143                           tops.shift-name = ub.inkas.shift-name
     2144                           tops.sale-date = ub.inkas.doc-date
     2145                           tops.pump-code = if HowBreak then ub.doc-pl-pump.pump-code else 0
     2146                           tops.pl-code = if HowBreak then ub.doc-pl-pump.pl-code else 0
     2147                           .
     2148                      END.
     2149                      assign
     2150                      tops.qnty = tops.qnty + 1 * ub.doc-pl-pump.fact-qnty
     2151                      tops.tot-r-b = tops.tot-r-b +
     2152                                     (if v-curr-r-b = 'base':U
     2153                                      then ub.gds-dtl.price-base
     2154                                      else ub.gds-dtl.price-rubl ) * 1 * ub.doc-pl-pump.fact-qnty
     2155                      tops.discnt-r-b = tops.discnt-r-b +
     2156                                     (if v-curr-r-b = 'base':U
     2157                                      then ub.gds-dtl.discnt-base
     2158                                      else ub.gds-dtl.discnt-rubl ) * 1 * ub.doc-pl-pump.fact-qnty
     2159                      .
     2160           END.
     2161                   if available ret-doc then do:
     2162              FOR EACH ub.doc-pl-pump No-LOCK where ub.doc-pl-pump.out-code = ret-doc.doc-code,
     2163                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl-pump.gds-code,
     2164                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = ret-doc.doc-code AND
     2165                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     2166                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2167                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     2168                   if HOWBREAK then do:
     2169                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2170                                                                 tops.obj-type = ub.inkas.obj-type AND
     2171                                                                 tops.obj-code = ub.inkas.obj-code AND
     2172                                                                 tops.shift-num = ub.inkas.shift-num AND
     2173                                                                 tops.sale-date = ub.inkas.doc-date AND
     2174                                                                 tops.pump-code  = ub.doc-pl-pump.pump-code AND
     2175                                                                 tops.pl-code = ub.doc-pl-pump.pl-code No-ERROR.
     2176                   END.
     2177                   ELSE do:
     2178                       FIND FIRST tops WHERE tops.gds-code = goods.gds-code AND
     2179                                                                 tops.obj-type = "" AND
     2180                                                                 tops.obj-code = 0 AND
     2181                                                                 tops.shift-num = ub.inkas.shift-num AND
     2182                                                                 tops.sale-date = ub.inkas.doc-date AND
     2183                                                                 tops.pump-code  = 0 AND
     2184                                                                 tops.pl-code = 0 No-ERROR.
     2185                   END.
     2186                      IF NOT AVAIL tops then do:
     2187                           create tops.
     2188                           assign
     2189                           tops.gds-code = ub.doc-pl-pump.gds-code
     2190                           tops.gds-name = ub.goods.gds-name
     2191                           tops.obj-type = if HowBreak then ub.inkas.obj-type else ""
     2192                           tops.obj-code = if HowBreak then ub.inkas.obj-code else 0
     2193                           tops.shift-num = ub.inkas.shift-num
     2194                           tops.shift-name = ub.inkas.shift-name
     2195                           tops.sale-date = ub.inkas.doc-date
     2196                           tops.pump-code = if HowBreak then ub.doc-pl-pump.pump-code else 0
     2197                           tops.pl-code = if HowBreak then ub.doc-pl-pump.pl-code else 0
     2198                           .
     2199                      END.
     2200                      assign
     2201                      tops.qnty = tops.qnty + -1 * ub.doc-pl-pump.fact-qnty
     2202                      tops.tot-r-b = tops.tot-r-b +
     2203                                     (if v-curr-r-b = 'base':U
     2204                                      then ub.gds-dtl.price-base
     2205                                      else ub.gds-dtl.price-rubl ) * -1 * ub.doc-pl-pump.fact-qnty
     2206                      tops.discnt-r-b = tops.discnt-r-b +
     2207                                     (if v-curr-r-b = 'base':U
     2208                                      then ub.gds-dtl.discnt-base
     2209                                      else ub.gds-dtl.discnt-rubl ) * -1 * ub.doc-pl-pump.fact-qnty
     2210                      .
     2211           END.
     2212                   end.
     2213               END.
     2214           END.
     2215       END.
     2216       WHEN no then do:
     2217           FOR EACH obj-list WHERE obj-list.obj-type = 'маг':U NO-LOCK :
     2218               ACCUMULATE obj-list.obj-code ( COUNT ) .
     2219               FOR EACH ub.inkas WHERE ub.inkas.obj-type = obj-list.obj-type AND
     2220                                                             ub.inkas.obj-code = obj-list.obj-code AND
     2221                                                             ub.inkas.status_ = 'факт':U AND
     2222                                                             ub.inkas.doc-date >= X-date-start AND
     2223                                                             ub.inkas.doc-date <= X-date-end
     2224                                                             NO-LOCK:
     2225                   FIND FIRST ub.trn-doc No-LOCK WHERE ub.trn-doc.doc-code = ub.inkas.inkas-code No-ERROR.
     2226                   FIND FIRST ret-doc No-LOCK WHERE ret-doc.doc-code = ub.trn-doc.out-code No-ERROR.
     2227              FOR EACH ub.doc-pl-pump No-LOCK where ub.doc-pl-pump.out-code = ub.trn-doc.doc-code,
     2228                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl-pump.gds-code,
     2229                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = ub.trn-doc.doc-code AND
     2230                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     2231                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2232                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     2233                   if HOWBREAK then do:
     2234                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2235                                                                 tops.obj-type = ub.inkas.obj-type AND
     2236                                                                 tops.obj-code = ub.inkas.obj-code AND
     2237                                                                 tops.shift-num = ub.inkas.shift-num AND
     2238                                                                 tops.sale-date = ub.inkas.doc-date AND
     2239                                                                 tops.pump-code  = ub.doc-pl-pump.pump-code AND
     2240                                                                 tops.pl-code = ub.doc-pl-pump.pl-code No-ERROR.
     2241                   END.
     2242                   ELSE do:
     2243                       FIND FIRST tops WHERE tops.gds-code = goods.gds-code AND
     2244                                                                 tops.obj-type = "" AND
     2245                                                                 tops.obj-code = 0 AND
     2246                                                                 tops.shift-num = ub.inkas.shift-num AND
     2247                                                                 tops.sale-date = ub.inkas.doc-date AND
     2248                                                                 tops.pump-code  = 0 AND
     2249                                                                 tops.pl-code = 0 No-ERROR.
     2250                   END.
     2251                      IF NOT AVAIL tops then do:
     2252                           create tops.
     2253                           assign
     2254                           tops.gds-code = ub.doc-pl-pump.gds-code
     2255                           tops.gds-name = ub.goods.gds-name
     2256                           tops.obj-type = if HowBreak then ub.inkas.obj-type else ""
     2257                           tops.obj-code = if HowBreak then ub.inkas.obj-code else 0
     2258                           tops.shift-num = ub.inkas.shift-num
     2259                           tops.shift-name = ub.inkas.shift-name
     2260                           tops.sale-date = ub.inkas.doc-date
     2261                           tops.pump-code = if HowBreak then ub.doc-pl-pump.pump-code else 0
     2262                           tops.pl-code = if HowBreak then ub.doc-pl-pump.pl-code else 0
     2263                           .
     2264                      END.
     2265                      assign
     2266                      tops.qnty = tops.qnty + 1 * ub.doc-pl-pump.fact-qnty
     2267                      tops.tot-r-b = tops.tot-r-b +
     2268                                     (if v-curr-r-b = 'base':U
     2269                                      then ub.gds-dtl.price-base
     2270                                      else ub.gds-dtl.price-rubl ) * 1 * ub.doc-pl-pump.fact-qnty
     2271                      tops.discnt-r-b = tops.discnt-r-b +
     2272                                     (if v-curr-r-b = 'base':U
     2273                                      then ub.gds-dtl.discnt-base
     2274                                      else ub.gds-dtl.discnt-rubl ) * 1 * ub.doc-pl-pump.fact-qnty
     2275                      .
     2276           END.
     2277                   if available ret-doc then do:
     2278              FOR EACH ub.doc-pl-pump No-LOCK where ub.doc-pl-pump.out-code = ret-doc.doc-code,
     2279                   FIRST ub.goods No-LOCK WHERE ub.goods.gds-code = ub.doc-pl-pump.gds-code,
     2280                   FIRST ub.gds-dtl No-LOCK WHERE ub.gds-dtl.doc-code = ret-doc.doc-code AND
     2281                                                                       ub.gds-dtl.artic = ub.goods.artic AND
     2282                                                                       ub.gds-dtl.prod-type = ub.goods.prod-type AND
     2283                                                                       ub.gds-dtl.prod-code = ub.goods.prod-code:
     2284                   if HOWBREAK then do:
     2285                       FIND FIRST tops WHERE tops.gds-code = ub.goods.gds-code AND
     2286                                                                 tops.obj-type = ub.inkas.obj-type AND
     2287                                                                 tops.obj-code = ub.inkas.obj-code AND
     2288                                                                 tops.shift-num = ub.inkas.shift-num AND
     2289                                                                 tops.sale-date = ub.inkas.doc-date AND
     2290                                                                 tops.pump-code  = ub.doc-pl-pump.pump-code AND
     2291                                                                 tops.pl-code = ub.doc-pl-pump.pl-code No-ERROR.
     2292                   END.
     2293                   ELSE do:
     2294                       FIND FIRST tops WHERE tops.gds-code = goods.gds-code AND
     2295                                                                 tops.obj-type = "" AND
     2296                                                                 tops.obj-code = 0 AND
     2297                                                                 tops.shift-num = ub.inkas.shift-num AND
     2298                                                                 tops.sale-date = ub.inkas.doc-date AND
     2299                                                                 tops.pump-code  = 0 AND
     2300                                                                 tops.pl-code = 0 No-ERROR.
     2301                   END.
     2302                      IF NOT AVAIL tops then do:
     2303                           create tops.
     2304                           assign
     2305                           tops.gds-code = ub.doc-pl-pump.gds-code
     2306                           tops.gds-name = ub.goods.gds-name
     2307                           tops.obj-type = if HowBreak then ub.inkas.obj-type else ""
     2308                           tops.obj-code = if HowBreak then ub.inkas.obj-code else 0
     2309                           tops.shift-num = ub.inkas.shift-num
     2310                           tops.shift-name = ub.inkas.shift-name
     2311                           tops.sale-date = ub.inkas.doc-date
     2312                           tops.pump-code = if HowBreak then ub.doc-pl-pump.pump-code else 0
     2313                           tops.pl-code = if HowBreak then ub.doc-pl-pump.pl-code else 0
     2314                           .
     2315                      END.
     2316                      assign
     2317                      tops.qnty = tops.qnty + -1 * ub.doc-pl-pump.fact-qnty
     2318                      tops.tot-r-b = tops.tot-r-b +
     2319                                     (if v-curr-r-b = 'base':U
     2320                                      then ub.gds-dtl.price-base
     2321                                      else ub.gds-dtl.price-rubl ) * -1 * ub.doc-pl-pump.fact-qnty
     2322                      tops.discnt-r-b = tops.discnt-r-b +
     2323                                     (if v-curr-r-b = 'base':U
     2324                                      then ub.gds-dtl.discnt-base
     2325                                      else ub.gds-dtl.discnt-rubl ) * -1 * ub.doc-pl-pump.fact-qnty
     2326                      .
     2327           END.
     2328                   end.
     2329               END.
     2330           END.
     2331       END.
     2332   END CASE.
     2333       ii = ACCUM COUNT obj-list.obj-code.
     2334   END PROCEDURE.
     2335   PROCEDURE Print-no-break :
     2336   define variable     acc-qnty-pump as decimal no-undo.
     2337   define variable    acc-tot-r-b-pump  as decimal no-undo.
     2338   define variable    acc-discnt-r-b-pump  as decimal no-undo.
     2339   define variable    acc-netto-r-b-pump  as decimal no-undo.
     2340   define variable    acc-qnty-gds  as decimal no-undo.
     2341   define variable    acc-tot-r-b-gds  as decimal no-undo.
     2342   define variable    acc-discnt-r-b-gds  as decimal no-undo.
     2343   define variable    acc-netto-r-b-gds  as decimal no-undo.
     2344   define variable    acc-qnty-obj  as decimal no-undo.
     2345   define variable    acc-tot-r-b-obj  as decimal no-undo.
     2346   define variable    acc-discnt-r-b-obj  as decimal no-undo.
     2347   define variable    acc-netto-r-b-obj  as decimal no-undo.
     2348   define variable    acc-qnty  as decimal no-undo.
     2349   define variable    acc-tot-r-b  as decimal no-undo.
     2350   define variable    acc-discnt-r-b  as decimal no-undo.
     2351   define variable    acc-netto-r-b  as decimal no-undo.
     2352   run prn-lib-open-stream  in this-procedure (
     2353                                                input my-handle
     2354                                               ,input 43
     2355                                               ,input yes
     2356                                               ,input no
     2357                                               ).
     2358   FORM HEADER
     2359       Line format "X(136)" AT 1 SKIP
     2360       "Продолжение - на следующей странице" AT 30 SKIP
     2361           with FRAME BottomFrame width 232 PAGE-BOTTOM NO-LABELS NO-BOX .
     2362   VIEW stream PrnLibStream FRAME BottomFrame .
     2363   PUT stream PrnLibStream
     2364   space(5)
     2365   string( "РАСХОД НЕФТЕПРОДУКТОВ ЧЕРЕЗ ТРК " + str1) format "X(120)"
     2366   SKIP(0)
     2367   Radio-Label(string(frame F-Main Rs-by), Rs-by:radio-buttons) format "X(40)" skip(0)
     2368       .
     2369   FOR EACH obj-list No-LOCK WHERE obj-list.obj-type = 'маг':U:
     2370        FIND FIRST ub.clients No-LOCK WHERE ub.clients.obj-type = 'маг':U AND
     2371                                                                     ub.clients.obj-code = obj-list.obj-code No-ERROR.
     2372       PUT STREAM PrnLibStream
     2373       ub.clients.obj-name
     2374       skip(0)
     2375       .
     2376   END.
     2377   PUT stream PrnLibStream skip(1).
     2378   FOR EACH tops No-LOCK break BY tops.obj-type
     2379                                                       BY tops.obj-code
     2380                                                       BY tops.gds-code
     2381                                                       By tops.pump-code
     2382                                                       BY tops.pl-code
     2383                                                       BY tops.sale-date
     2384                                                       By tops.shift-num
     2385                                                       :
     2386       IF HOWbreak AND FIRST-OF(tops.obj-code) then do:
     2387           assign
     2388           acc-qnty-obj = 0
     2389           acc-tot-r-b-obj = 0
     2390           acc-discnt-r-b-obj = 0
     2391           acc-netto-r-b-obj = 0
     2392           .
     2393           FIND FIRST clients No-LOCK WHERE clients.obj-type = tops.obj-type AND
     2394                                                                        clients.obj-code = tops.obj-code No-ERROR.
     2395           DISPLAY STREAM PrnLibStream
     2396           clients.obj-name @ tops.gds-name
     2397           WITH FRAME TopsF.
     2398           UNDERLINE STREAM PrnLibStream
     2399           tops.sale-date
     2400           tops.shift-name
     2401           tops.gds-code
     2402           tops.gds-name
     2403           tops.pump-code
     2404           tops.pl-code
     2405           tops.qnty
     2406           tops.tot-r-b
     2407           tops.discnt-r-b
     2408           for-netto
     2409           WITH FRAME TopsF.
     2410       END.
     2411       IF FIRST-of(tops.gds-code) then
     2412       assign
     2413       acc-qnty-gds = 0
     2414       acc-tot-r-b-gds = 0
     2415       acc-discnt-r-b-gds = 0
     2416       acc-netto-r-b-gds = 0
     2417       .
     2418       If HOWBREAK AND FIrst-of(tops.pump-code) then
     2419       assign
     2420       acc-qnty-pump = 0
     2421       acc-tot-r-b-pump = 0
     2422       acc-discnt-r-b-pump = 0
     2423       acc-netto-r-b-pump = 0
     2424       .
     2425       DISPLAY STREAM PrnLibStream
     2426       tops.sale-date
     2427       tops.shift-name
     2428       tops.gds-code
     2429       tops.gds-name
     2430       tops.pump-code
     2431       tops.pl-code
     2432       tops.qnty
     2433       tops.tot-r-b
     2434       tops.discnt-r-b
     2435       (tops.tot-r-b - tops.discnt-r-b) @ for-netto
     2436       WITH FRAME TopsF.
     2437       DOWN STREAM PrnLibStream 1 with frame TopsF.
     2438       assign
     2439       acc-qnty-pump = acc-qnty-pump + tops.qnty
     2440       acc-tot-r-b-pump = acc-tot-r-b-pump + tops.tot-r-b
     2441       acc-discnt-r-b-pump = acc-discnt-r-b-pump + tops.discnt-r-b
     2442       acc-netto-r-b-pump = acc-netto-r-b-pump + (tops.tot-r-b - tops.discnt-r-b)
     2443       acc-qnty-gds = acc-qnty-gds + tops.qnty
     2444       acc-tot-r-b-gds = acc-tot-r-b-gds + tops.tot-r-b
     2445       acc-discnt-r-b-gds = acc-discnt-r-b-gds + tops.discnt-r-b
     2446       acc-netto-r-b-gds = acc-netto-r-b-gds + (tops.tot-r-b - tops.discnt-r-b)
     2447       acc-qnty-obj = acc-qnty-obj + tops.qnty
     2448       acc-tot-r-b-obj = acc-tot-r-b-obj + tops.tot-r-b
     2449       acc-discnt-r-b-obj = acc-discnt-r-b-obj + tops.discnt-r-b
     2450       acc-netto-r-b-obj = acc-netto-r-b-obj + (tops.tot-r-b - tops.discnt-r-b)
     2451       acc-qnty = acc-qnty + tops.qnty
     2452       acc-tot-r-b = acc-tot-r-b + tops.tot-r-b
     2453       acc-discnt-r-b = acc-discnt-r-b + tops.discnt-r-b
     2454       acc-netto-r-b = acc-netto-r-b + (tops.tot-r-b - tops.discnt-r-b)
     2455       .
     2456       IF HOWBREAK AND LAST-OF(tops.pump-code) then do:
     2457           UNDERLINE STREAM PrnLibStream
     2458           tops.sale-date
     2459           tops.shift-name
     2460           tops.gds-code
     2461           tops.gds-name
     2462           tops.pump-code
     2463           tops.pl-code
     2464           tops.qnty
     2465           tops.tot-r-b
     2466           tops.discnt-r-b
     2467           for-netto
     2468           WITH FRAME TopsF.
     2469           DISPLAY STREAM PrnLibStream
     2470           "Итого по ТРК" @ tops.sale-date
     2471           tops.gds-code
     2472           tops.gds-name
     2473           tops.pump-code
     2474           acc-qnty-pump @ tops.qnty
     2475           acc-tot-r-b-pump @ tops.tot-r-b
     2476           acc-discnt-r-b-pump @ tops.discnt-r-b
     2477           acc-netto-r-b-pump @ for-netto
     2478           WITH FRAME TopsF.
     2479           DOWN STREAM PrnLibStream 1 with frame TopsF.
     2480           UNDERLINE STREAM PrnLibStream
     2481           tops.sale-date
     2482           tops.shift-name
     2483           tops.gds-code
     2484           tops.gds-name
     2485           tops.pump-code
     2486           tops.pl-code
     2487           tops.qnty
     2488           tops.tot-r-b
     2489           tops.discnt-r-b
     2490           for-netto
     2491           WITH FRAME TopsF.
     2492       END.
     2493       IF LAST-OF(tops.gds-code) then do:
     2494           UNDERLINE STREAM PrnLibStream
     2495           tops.sale-date
     2496           tops.shift-name
     2497           tops.gds-code
     2498           tops.gds-name
     2499           tops.pump-code
     2500           tops.pl-code
     2501           tops.qnty
     2502           tops.tot-r-b
     2503           tops.discnt-r-b
     2504           for-netto
     2505           WITH FRAME TopsF.
     2506           DISPLAY STREAM PrnLibStream
     2507           "Итого по товару" @ tops.sale-date
     2508           tops.gds-code
     2509           tops.gds-name
     2510           acc-qnty-gds @ tops.qnty
     2511           acc-tot-r-b-gds @ tops.tot-r-b
     2512           acc-discnt-r-b-gds @ tops.discnt-r-b
     2513           acc-netto-r-b-gds @ for-netto
     2514           WITH FRAME TopsF.
     2515           DOWN STREAM PrnLibStream 1 with frame TopsF.
     2516           UNDERLINE STREAM PrnLibStream
     2517           tops.sale-date
     2518           tops.shift-name
     2519           tops.gds-code
     2520           tops.gds-name
     2521           tops.pump-code
     2522           tops.pl-code
     2523           tops.qnty
     2524           tops.tot-r-b
     2525           tops.discnt-r-b
     2526           for-netto
     2527           WITH FRAME TopsF.
     2528       END.
     2529       IF HOWBreak AND LAST-OF(tops.obj-code) then do:
     2530           UNDERLINE STREAM PrnLibStream
     2531           tops.sale-date
     2532           tops.shift-name
     2533           tops.gds-code
     2534           tops.gds-name
     2535           tops.pump-code
     2536           tops.pl-code
     2537           tops.qnty
     2538           tops.tot-r-b
     2539           tops.discnt-r-b
     2540           for-netto
     2541           WITH FRAME TopsF.
     2542           DISPLAY STREAM PrnLibStream
     2543           "Итого по объекту" @ tops.sale-date
     2544           acc-qnty-obj @ tops.qnty
     2545           acc-tot-r-b-obj @ tops.tot-r-b
     2546           acc-discnt-r-b-obj @ tops.discnt-r-b
     2547           acc-netto-r-b-obj @ for-netto
     2548           WITH FRAME TopsF.
     2549           DOWN STREAM PrnLibStream 1 with frame TopsF.
     2550           UNDERLINE STREAM PrnLibStream
     2551           tops.sale-date
     2552           tops.shift-name
     2553           tops.gds-code
     2554           tops.gds-name
     2555           tops.pump-code
     2556           tops.pl-code
     2557           tops.qnty
     2558           tops.tot-r-b
     2559           tops.discnt-r-b
     2560           for-netto
     2561           WITH FRAME TopsF.
     2562       end.
     2563   END.
     2564   DISPLAY STREAM PrnLibStream
     2565   "ИТОГО" @ tops.sale-date
     2566   acc-qnty @ tops.qnty
     2567   acc-tot-r-b @ tops.tot-r-b
     2568   acc-discnt-r-b @ tops.discnt-r-b
     2569   acc-netto-r-b @ for-netto
     2570   WITH FRAME TopsF.
     2571   DOWN STREAM PrnLibStream 1 with frame TopsF.
     2572   output stream PrnLibStream CLOSE.
     2573   run waitfram-hide in this-procedure .
     2574   END PROCEDURE.
     2575   PROCEDURE send-records :
     2576   END PROCEDURE.
     2577   PROCEDURE state-changed :
