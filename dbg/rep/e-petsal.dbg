      366   procedure create_obj-list :
      367      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      368      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      369      do
      370      on error undo, return error return-value
      371      :
      372         define buffer cli-obj for ub.clients .
      373         define variable p-var as integer no-undo .
      374         define buffer buf_obj-list for obj-list .
      375         find last buf_obj-list  use-index pi no-error .
      376         if available buf_obj-list
      377         then
      378            p-var = buf_obj-list.obj-id + 1.
      379         else
      380            p-var = 1.
      381         find first cli-obj where
      382                   cli-obj.obj-type = p-obj-type
      383               and cli-obj.obj-code = p-obj-code
      384         no-lock no-error.
      385         if available cli-obj
      386         then do:
      387            create buf_obj-list.
      388            assign
      389               buf_obj-list.obj-id   = p-var
      390               buf_obj-list.obj-code = cli-obj.obj-code
      391               buf_obj-list.obj-type = cli-obj.obj-type
      392               buf_obj-list.obj-name = cli-obj.obj-name
      393               buf_obj-list.db-num   = cli-obj.db-num
      394            .
      395         end.
      396      end.
      397   end.
