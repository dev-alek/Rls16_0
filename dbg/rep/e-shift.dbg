      709               when 'chkgdsfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Товарная строка чека - доп поля"     p-tooltip = "Товарная строка чека - доп поля "     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      710               when 'chkdocfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Чек - доп поля"     p-tooltip = "Чек - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      711               when 'barcodfi':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Бар-код - доп поля"     p-tooltip = "Бар-код - доп поля"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      712                when 'UPD':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника Электронного документоборота"     p-tooltip = "Настройки справочника Электронного документоборота"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      713               when 'LK_RECEIPT':U then do:     assign     p-use-List_ = yes      p-type-List_ = 'C':U      p-format-List_ = "X(256)"     p-use-Naim = no      p-type-Naim = 'C':U      p-format-Naim = "X(256)"     p-use-print-graft = no      p-use-sort-gr = no      p-use-type-price = no      p-use-type-val = no      p-label = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-tooltip = "Настройки справочника документов Вывода из оборота (ОСУ)"     p-user-can-edit  = no     p-output-display = no     p-other = ""     .   end.
      714         otherwise do:
      715           undo, return error "неизвестная настройка пользователя usr-flt" + " " + p-code .
      716         end.
      717       end CASE.
      718     end.
      719   end procedure.
      720   procedure uf-get :
      721     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      722     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      723     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      724     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      725     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      726     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      727     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      728     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      729     do
      730     on error undo, return error
      731     :
      732       define buffer buf_usr-flt for ubflt.usr-flt .
      733       define variable v-use-List_     as logical   no-undo .
      734       define variable v-type-List_     as character no-undo .
      735       define variable v-format-List_   as character no-undo .
      736       define variable v-use-Naim      as logical   no-undo .
      737       define variable v-type-Naim      as character no-undo .
      738       define variable v-format-Naim    as character no-undo .
      739       define variable v-use-print-graft as logical   no-undo .
      740       define variable v-use-sort-gr     as logical   no-undo .
      741       define variable v-use-type-price  as logical   no-undo .
      742       define variable v-use-type-val    as logical   no-undo .
      743       define variable v-label          as character no-undo .
      744       define variable v-tooltip        as character no-undo .
      745       define variable v-user-can-edit  as logical   no-undo .
      746       define variable v-output-display as logical   no-undo .
      747       define variable v-other          as character no-undo .
      748       run uf-name in this-procedure
      749          (input  entry(1, p-code, chr(4))
      750         ,output v-use-List_
      751         ,output v-type-List_
      752         ,output v-format-List_
      753         ,output v-use-Naim
      754         ,output v-type-Naim
      755         ,output v-format-Naim
      756         ,output v-use-print-graft
      757         ,output v-use-sort-gr
      758         ,output v-use-type-price
      759         ,output v-use-type-val
      760         ,output v-label
      761         ,output v-tooltip
      762         ,output v-user-can-edit
      763         ,output v-output-display
      764         ,output v-other
      765         ) no-error .
      766       if error-status :error then do:
      767         undo, return error return-value .
      768       end.
      769       find first buf_usr-flt no-lock where
      770                  buf_usr-flt.Call-point     = p-code AND
      771                  buf_usr-flt.user-name       = p-user-name
      772         no-error .
      773       if avail buf_usr-flt then do:
      774         assign
      775         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
      776         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
      777         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
      778         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
      779         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
      780         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
      781         .
      782       end.
      783       else do:
      784         assign
      785         p-List_        = (if v-use-List_       then "":U                    else ?)
      786         p-Naim         = (if v-use-Naim        then "":U                    else ?)
      787         p-print-graft  = (if v-use-print-graft then no                      else ?)
      788         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
      789         p-type-price   = (if v-use-type-price  then no                      else ?)
      790         p-type-val     = (if v-use-List_       then no                      else ?)
      791         .
      792       end.
      793     end.
      794   end procedure.
      795   procedure uf-set :
      796     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      797     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
      798     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
      799     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
      800     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
      801     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
      802     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
      803     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
      804     do
      805     on error undo, return error
      806     :
      807       define buffer buf_usr-flt for ubflt.usr-flt .
      808       define variable v-use-List_     as logical   no-undo .
      809       define variable v-type-List_     as character no-undo .
      810       define variable v-format-List_   as character no-undo .
      811       define variable v-use-Naim      as logical   no-undo .
      812       define variable v-type-Naim      as character no-undo .
      813       define variable v-format-Naim    as character no-undo .
      814       define variable v-use-print-graft as logical   no-undo .
      815       define variable v-use-sort-gr   as logical   no-undo .
      816       define variable v-use-type-price as logical   no-undo .
      817       define variable v-use-type-val  as logical   no-undo .
      818       define variable v-tooltip        as character no-undo .
      819       define variable v-label          as character no-undo .
      820       define variable v-user-can-edit  as logical   no-undo .
      821       define variable v-output-display as logical   no-undo .
      822       define variable v-other          as character no-undo .
      823       run uf-name in this-procedure
      824         (input  entry(1, p-code, chr(4))
      825         ,output v-use-List_
      826         ,output v-type-List_
      827         ,output v-format-List_
      828         ,output v-use-Naim
      829         ,output v-type-Naim
      830         ,output v-format-Naim
      831         ,output v-use-print-graft
      832         ,output v-use-sort-gr
      833         ,output v-use-type-price
      834         ,output v-use-type-val
      835         ,output v-label
      836         ,output v-tooltip
      837         ,output v-user-can-edit
      838         ,output v-output-display
      839         ,output v-other
      840         ) no-error .
      841       if error-status :error then do:
      842         undo, return error return-value .
      843       end.
      844       find first buf_usr-flt where
      845                  buf_usr-flt.Call-point     = p-code AND
      846                  buf_usr-flt.user-name       = p-user-name
      847         no-error .
      848       if not avail buf_usr-flt then do:
      849           create buf_usr-flt .
      850           assign
      851           buf_usr-flt.call-point = p-code
      852           buf_usr-flt.user-name  = p-user-name
      853           .
      854       end.
      855       if avail buf_usr-flt then do:
      856        assign
      857        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
      858        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
      859        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
      860        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
      861        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
      862        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
      863       .
      864       release buf_usr-flt.
      865       end.
      866       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
      867     end.
      868   end procedure.
      869   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      870   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      871   define  shared variable RepPathName        as character no-undo .
      872   define  shared variable PrintRubl          as logical   no-undo .
      873   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      874     define variable v-cntxt-db-num        as integer   no-undo .
      875     define variable v-cntxt-userid        as character no-undo .
      876     define variable v-cntxt-level         as character no-undo .
      877     define variable v-cntxt-host-code-obj as integer   no-undo .
      878     define variable v-cntxt-obj-type      as character no-undo .
      879     define variable v-cntxt-obj-code      as integer   no-undo .
      880     define variable v-cntxt-db-num-obj    as integer   no-undo .
      881     define variable v-cntxt-is-admin      as logical   no-undo .
      882   def var vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      883   procedure gen-key-rec :
      884     define input  parameter p-tbl-name    as character no-undo.
      885     define input  parameter p-bh_tbl-name as handle    no-undo.
      886     define output parameter p-key-rec     as character no-undo.
      887     do
      888     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      889     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      890     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      891     :
      892       define variable fh               as handle    no-undo .
      893       define variable v-ok             as logical   no-undo .
      894       define variable v-inform         as character no-undo .
      895       define variable v-ind            as integer   no-undo .
      896       define variable v-idx-field-qnty as integer   no-undo .
      897       if p-tbl-name = ?
      898         or p-tbl-name = "":U
      899       then do:
      900         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info10 ).
      901       end.
      902       if not p-bh_tbl-name:available then do:
      903         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info10, p-tbl-name ).
      904       end.
      905       assign
      906         p-key-rec = p-tbl-name
      907         v-inform  = p-bh_tbl-name:index-information(1)
      908         v-ind     = 2
      909       .
      910       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      911       on error undo, return error
      912       :
      913         assign
      914           v-inform = p-bh_tbl-name:index-information( v-ind )
      915           v-ind    = v-ind + 1
      916         .
      917       end.
      918       if v-inform = ?
      919         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      920         or entry( 3, v-inform, ",":U ) <> "1":U
      921       then do:
      922         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, p-tbl-name ).
      923       end.
      924       else do:
      925         assign
      926           v-idx-field-qnty = num-entries( v-inform ) - 4
      927         .
      928         if v-idx-field-qnty < 2 then do:
      929           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, p-tbl-name ).
      930         end.
      931         do v-ind = 1 to v-idx-field-qnty by 2
      932         on error undo, return error
      933         :
      934           assign
      935             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      936             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      937           .
      938         end.
      939       end.
      940       if p-key-rec = ? then do:
      941         assign
      942           p-key-rec = "":U
      943         .
      944         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info10, p-tbl-name ).
      945       end.
      946     end.
      947     return.
      948   end procedure.
      949   procedure gen-where-keyr-tab :
      950     define input  parameter i-tableSerach as character no-undo.
      951     define input  parameter i-tablekey   as character  no-undo.
      952     define input  parameter p-key-rec    as character  no-undo.
      953     define input  parameter p-key-handle as handle     no-undo .
      954     define input  parameter p-db-name    as character  no-undo .
      955     define input  parameter p-tt-handle  as handle     no-undo .
      956     define output parameter o-Where      as character  no-undo.
      957     do
      958     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      959     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      960     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      961     :
      962       define variable v-full-tbl-name  as character no-undo .
      963       define variable bh_tbl-name      as handle    no-undo .
      964       define variable fh_key           as handle    no-undo .
      965       define variable fh_search        as handle    no-undo .
      966       define variable v-field-num      as integer   no-undo .
      967       define variable v-count-fld      as integer   no-undo .
      968       define variable v-inform         as character no-undo .
      969       define variable v-ind            as integer   no-undo .
      970       define variable v-idx-field-qnty as integer   no-undo .
      971       define variable v-field-name     as character no-undo .
      972       define variable v-field-val      as character no-undo .
      973       define variable v-word-link      as character no-undo .
      974       define variable vTable           as character no-undo.
      975       define variable bh_tbl-key       as handle    no-undo .
      976       assign
      977         p-key-rec = trim( p-key-rec )
      978       .
      979       if p-key-handle <> ? then do:
      980         if not valid-handle(p-key-handle)
      981            or p-key-handle:type <> "buffer"
      982         then do:
      983           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info10 ).
      984         end.
      985         if num-entries( p-key-rec, chr(3) ) > 1
      986           or p-key-rec = ?
      987           or p-key-rec = "":U
      988         then do:
      989           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info10, p-key-rec ).
      990         end.
      991       end.
      992       else do:
      993         if p-key-rec = ?
      994           or p-key-rec = "":U
      995         then do:
      996           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
      997         end.
      998       end.
      999       assign
     1000         vTable = entry( 1 , p-key-rec, chr(3) )
     1001       .
     1002       if p-tt-handle <> ?
     1003         and ( not valid-handle(p-tt-handle)
     1004               or p-tt-handle:type <> "buffer"
     1005             )
     1006       then do:
     1007         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info10, vTable, chr(10) ).
     1008       end.
     1009       if p-tt-handle = ? then do:
     1010         assign
     1011           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1012         .
     1013         create buffer bh_tbl-name for table v-full-tbl-name .
     1014       end.
     1015       else do:
     1016         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1017       end.
     1018       assign
     1019         v-inform = bh_tbl-name:index-information(1)
     1020         v-ind    = 2
     1021       .
     1022       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1023       on error undo, return error
     1024       :
     1025         assign
     1026           v-inform = bh_tbl-name:index-information( v-ind )
     1027           v-ind    = v-ind + 1
     1028         .
     1029       end.
     1030       if v-inform = ?
     1031         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1032         or entry( 3, v-inform, ",":U ) <> "1":U
     1033       then do:
     1034         delete object bh_tbl-name no-error.
     1035         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info10, vTable ).
     1036       end.
     1037       assign
     1038         v-idx-field-qnty = num-entries( v-inform ) - 4
     1039       .
     1040       if v-idx-field-qnty < 2 then do:
     1041         delete object bh_tbl-name no-error.
     1042         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, vTable ).
     1043       end.
     1044       assign
     1045         o-where     = "where":U
     1046         v-word-link = "":U
     1047         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1048         v-count-fld = 0
     1049       .
     1050       if i-tablekey ne "" and i-tablekey ne ?
     1051       then do:
     1052         assign
     1053           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1054         .
     1055         create buffer bh_tbl-key for table v-full-tbl-name .
     1056       end.
     1057       if i-tableSerach ne "" and i-tableSerach ne ?
     1058       then do:
     1059         delete object bh_tbl-name no-error.
     1060         assign
     1061           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1062         .
     1063         create buffer bh_tbl-name for table v-full-tbl-name .
     1064       end.
     1065       block_where:
     1066       do v-ind = 1 to v-idx-field-qnty by 2
     1067       on error undo, return error
     1068       :
     1069         assign
     1070           v-count-fld = v-count-fld + 1
     1071         .
     1072         if p-key-handle = ?
     1073           and v-count-fld > v-field-num
     1074         then do:
     1075           leave block_where.
     1076         end.
     1077         define variable VfieldKeyTable as handle no-undo.
     1078         assign
     1079           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1080           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1081         .
     1082         if     bh_tbl-key ne ?
     1083         then do:
     1084            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1085            if VfieldKeyTable eq ?
     1086            then next block_where.
     1087         end.
     1088         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1089         then
     1090            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1091         else
     1092            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1093         if p-key-handle = ? then do:
     1094           assign
     1095             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1096           .
     1097         end.
     1098         else do:
     1099           assign
     1100             fh_key = p-key-handle:buffer-field( v-field-name )
     1101           .
     1102           if fh_key = ?
     1103             or not valid-handle( fh_key )
     1104           then do:
     1105             delete object bh_tbl-name.
     1106             if     bh_tbl-key ne ?
     1107             then
     1108                delete object bh_tbl-key.
     1109             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info10, p-key-handle:name, v-field-name ).
     1110           end.
     1111           assign
     1112             v-field-val = fh_key:buffer-value
     1113           .
     1114         end.
     1115         if fh_search:data-type ="character":U then do:
     1116           assign
     1117             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1118             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1119             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1120             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1121             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1122             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1123             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1124             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1125             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1126             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1127             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1128             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1129             v-field-val = substitute( '"&1"', v-field-val )
     1130           .
     1131         end.
     1132         assign
     1133           o-where = substitute( "&1 &2", o-where, v-field-val )
     1134         .
     1135         if v-word-link = "":U then do:
     1136           assign
     1137             v-word-link = "and":U
     1138           .
     1139         end.
     1140       end.
     1141       delete object bh_tbl-name.
     1142       if     bh_tbl-key ne ?
     1143       then
     1144          delete object bh_tbl-key.
     1145       if p-key-handle = ?
     1146         and v-count-fld <> v-field-num
     1147       then do:
     1148         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info10, vTable ).
     1149       end.
     1150     end.
     1151   end procedure.
     1152   procedure gen-hn-keyr-tab :
     1153     define input  parameter i-tableSerach as character no-undo.
     1154     define input  parameter i-tablekey   as character no-undo.
     1155     define input  parameter p-key-rec    as character no-undo.
     1156     define input  parameter p-key-handle as handle    no-undo .
     1157     define input  parameter p-db-name    as character no-undo .
     1158     define input  parameter p-tt-handle  as handle    no-undo .
     1159     define input  parameter p-stts-lock  as integer   no-undo .
     1160     define output parameter o-hn         as handle    no-undo.
     1161     define variable v-full-tbl-name as character no-undo.
     1162     define variable v-where         as character no-undo.
     1163     define variable bh_tbl-name     as handle    no-undo.
     1164     define variable vTable          as character no-undo.
     1165     do
     1166     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1167     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1168     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1169         run gen-where-keyr-tab(i-tableSerach,
     1170                                i-tablekey,
     1171                                p-key-rec,
     1172                                p-key-handle,
     1173                                p-db-name,
     1174                                p-tt-handle,
     1175                                output v-where).
     1176         if i-tableSerach ne "" and i-tableSerach ne ?
     1177         then do:
     1178            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1179            create buffer bh_tbl-name for table v-full-tbl-name .
     1180         end.
     1181         else do:
     1182            if p-tt-handle = ? then do:
     1183               assign
     1184                  vTable = entry( 1 , p-key-rec, chr(3) )
     1185               .
     1186               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1187               create buffer bh_tbl-name for table v-full-tbl-name .
     1188            end.
     1189            else do:
     1190               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1191            end.
     1192         end.
     1193         if p-tt-handle = ? then do:
     1194            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1195         end.
     1196         else do:
     1197            bh_tbl-name:find-first( v-where ) no-error .
     1198         end.
     1199         o-hn = bh_tbl-name.
     1200      end.
     1201   end procedure.
     1202   procedure gen-hn-keyr :
     1203     define input  parameter p-key-rec    as character no-undo.
     1204     define input  parameter p-key-handle as handle    no-undo .
     1205     define input  parameter p-db-name    as character no-undo .
     1206     define input  parameter p-tt-handle  as handle    no-undo .
     1207     define input  parameter p-stts-lock  as integer   no-undo .
     1208     define output parameter o-hn         as handle    no-undo.
     1209     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1210   end.
     1211   procedure gen-row-keyr :
     1212     define input  parameter p-key-rec    as character no-undo.
     1213     define input  parameter p-key-handle as handle    no-undo .
     1214     define input  parameter p-db-name    as character no-undo .
     1215     define input  parameter p-tt-handle  as handle    no-undo .
     1216     define input  parameter p-stts-lock  as integer   no-undo .
     1217     define output parameter p-tbl-row    as rowid     no-undo.
     1218     define output parameter p-tbl-name   as character no-undo.
     1219     define variable vHn as handle no-undo.
     1220       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1221       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1222       p-tbl-name =  vHn:table.
     1223       delete object vHn no-error.
     1224     if p-tbl-row = ? then do:
     1225       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info10, p-tbl-name, p-key-rec ).
     1226     end.
     1227     else do:
     1228       return.
     1229     end.
     1230   end procedure.
     1231   procedure gen-key-fv :
     1232     define input  parameter p-key-rec    as character no-undo .
     1233     define output parameter p-field-list as character no-undo .
     1234     define output parameter p-value-list as character no-undo.
     1235     do
     1236     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1237     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1238     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1239     :
     1240       define variable v-full-tbl-name  as character no-undo .
     1241       define variable bh_tbl-name      as handle    no-undo .
     1242       define variable v-tbl-name       as character no-undo .
     1243       define variable v-field-num      as integer   no-undo .
     1244       define variable v-count-fld      as integer   no-undo .
     1245       define variable v-inform         as character no-undo .
     1246       define variable v-ind            as integer   no-undo .
     1247       define variable v-idx-field-qnty as integer   no-undo .
     1248       define variable v-delim-key      as character no-undo .
     1249       if p-key-rec = ?
     1250         or p-key-rec = "":U
     1251       then do:
     1252         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info10 ).
     1253       end.
     1254       assign
     1255         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1256         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1257       .
     1258       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1259       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info10 ).
     1260       assign
     1261         v-inform = bh_tbl-name:index-information(1)
     1262         v-ind    = 2
     1263       .
     1264       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1265       on error undo, return error
     1266       :
     1267         assign
     1268           v-inform = bh_tbl-name:index-information( v-ind )
     1269           v-ind    = v-ind + 1
     1270         .
     1271       end.
     1272       if v-inform = ?
     1273         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1274         or entry( 3, v-inform, ",":U ) <> "1":U
     1275       then do:
     1276         delete object bh_tbl-name no-error.
     1277         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1278       end.
     1279       assign
     1280         v-idx-field-qnty = num-entries( v-inform ) - 4
     1281       .
     1282       if v-idx-field-qnty < 2 then do:
     1283         delete object bh_tbl-name no-error.
     1284         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1285       end.
     1286       assign
     1287         p-field-list = "":U
     1288         p-value-list = "":U
     1289         v-delim-key  = "":U
     1290         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1291         v-count-fld  = 0
     1292       .
     1293       block_where:
     1294       do v-ind = 1 to v-idx-field-qnty by 2
     1295       on error undo, return error
     1296       :
     1297         assign
     1298           v-count-fld = v-count-fld + 1
     1299         .
     1300         if v-count-fld > v-field-num then do:
     1301           leave block_where.
     1302         end.
     1303         assign
     1304           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1305           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1306         .
     1307         if v-ind = 1 then do:
     1308           assign
     1309             v-delim-key = chr(3)
     1310           .
     1311         end.
     1312       end.
     1313       delete object bh_tbl-name.
     1314       if v-count-fld <> v-field-num then do:
     1315         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info10, v-tbl-name ).
     1316       end.
     1317     end.
     1318   end procedure.
     1319   procedure gen-key-field :
     1320     define input  parameter p-table      as character no-undo .
     1321     define output parameter p-field-list as character no-undo .
     1322     do
     1323     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1324     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1325     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1326     :
     1327       define variable v-full-tbl-name  as character no-undo .
     1328       define variable bh_tbl-name      as handle    no-undo .
     1329       define variable v-tbl-name       as character no-undo .
     1330       define variable v-field-num      as integer   no-undo .
     1331       define variable v-count-fld      as integer   no-undo .
     1332       define variable v-inform         as character no-undo .
     1333       define variable v-ind            as integer   no-undo .
     1334       define variable v-idx-field-qnty as integer   no-undo .
     1335       define variable v-delim-key      as character no-undo .
     1336       if p-table = ?
     1337         or p-table = "":U
     1338       then do:
     1339         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info10 ).
     1340       end.
     1341       assign
     1342         v-tbl-name      = p-table
     1343         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1344       .
     1345       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1346       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info10 ).
     1347       assign
     1348         v-inform = bh_tbl-name:index-information(1)
     1349         v-ind    = 2
     1350       .
     1351       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1352       on error undo, return error
     1353       :
     1354         assign
     1355           v-inform = bh_tbl-name:index-information( v-ind )
     1356           v-ind    = v-ind + 1
     1357         .
     1358       end.
     1359       if v-inform = ?
     1360         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1361         or entry( 3, v-inform, ",":U ) <> "1":U
     1362       then do:
     1363         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info10, v-tbl-name ).
     1364       end.
     1365       assign
     1366         v-idx-field-qnty = num-entries( v-inform ) - 4
     1367       .
     1368       if v-idx-field-qnty < 2 then do:
     1369         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info10, v-inform, v-tbl-name ).
     1370       end.
     1371       assign
     1372         p-field-list = "":U
     1373         v-delim-key  = "":U
     1374         v-count-fld  = 0
     1375       .
     1376       block_where:
     1377       do v-ind = 1 to v-idx-field-qnty by 2
     1378       on error undo, return error
     1379       :
     1380         assign
     1381           v-count-fld = v-count-fld + 1
     1382         .
     1383         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1384         if v-ind = 1 then do:
     1385           assign
     1386             v-delim-key = chr(3)
     1387           .
     1388         end.
     1389       end.
     1390       delete object bh_tbl-name.
     1391     end.
     1392   end procedure.
     1393   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1394   define variable tempcxml_v-num_ as integer no-undo .
     1395   define  temp-table temp-xml-tables no-undo
     1396   field order as integer
     1397   field tbl-name as character
     1398   field tbl-handle_ as handle
     1399   field table-handle_ as handle
     1400   field uniq-gate-rec as character
     1401   field gate-name as character
     1402   field gate-handle_ as handle
     1403   field is-parent as logical
     1404   index pi is unique primary
     1405   uniq-gate-rec
     1406   tbl-name
     1407   index iorder
     1408   order
     1409   index gr
     1410   uniq-gate-rec
     1411   index gh
     1412   gate-handle_
     1413   index iparent
     1414   is-parent
     1415   .
     1416   define  temp-table temp-xml-records no-undo
     1417   field tbl-name as character
     1418   field uniq-key-rec as character
     1419   index pi is unique primary
     1420   tbl-name
     1421   uniq-key-rec
     1422   .
     1423   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1424   procedure factord :
     1425     define input  parameter p-fact-date            as date    no-undo .
     1426     define input  parameter p-fact-time            as integer no-undo .
     1427     define input  parameter p-fact-num             as integer no-undo .
     1428     define input  parameter p-shift-date           as date    no-undo .
     1429     define input  parameter p-shift-num            as integer no-undo .
     1430     define input  parameter p-shift-on             as logical no-undo .
     1431     define output parameter p-fact-order           as decimal no-undo .
     1432     define output parameter p-shift-end-fact-order as decimal no-undo .
     1433     define output parameter p-day-end-fact-order   as decimal no-undo .
     1434     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1435     if p-fact-date = ?
     1436     then do:
     1437       return error "Не указана фактическая дата" .
     1438     end.
     1439     define variable v-fact-date-num as integer no-undo .
     1440     assign
     1441       v-fact-date-num = integer(p-fact-date)
     1442     .
     1443     if p-fact-num = ?
     1444     or p-fact-num = 0
     1445     then do:
     1446       return error "Не задан p-fact-num " + string(p-fact-num) .
     1447     end.
     1448     if p-fact-num < 0
     1449     then do:
     1450       return error "Отрицательный fact-num " + string(p-fact-num) .
     1451     end.
     1452     if p-fact-num >= 100000000
     1453     then do:
     1454       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1455     end.
     1456     if p-shift-on = true
     1457     then do:
     1458       if p-shift-date = ?
     1459       then do:
     1460         return error "Не задана дата смены" .
     1461       end.
     1462       if p-shift-num = ?
     1463       or p-shift-num = 0
     1464       then do:
     1465         return error "Не задан номер смены" .
     1466       end.
     1467     end.
     1468     else do:
     1469       assign
     1470         p-shift-date = p-fact-date
     1471         p-shift-num  = 24
     1472       .
     1473     end.
     1474     define variable v-shift-offset as integer no-undo .
     1475     if p-shift-date = p-fact-date
     1476     then do:
     1477       assign
     1478         v-shift-offset = 1
     1479       .
     1480     end.
     1481     if p-shift-date < p-fact-date
     1482     then do:
     1483       assign
     1484         v-shift-offset = 0
     1485       .
     1486     end.
     1487     if p-shift-date > p-fact-date
     1488     then do:
     1489       message
     1490         vss-workfile vss-revision vss-description skip
     1491         "Неправильная дата закрытия смены" skip
     1492         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1493         view-as alert-box error .
     1494       undo, return error
     1495         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1496           ,string(p-fact-date, '99/99/9999':U)
     1497           ,string(p-shift-date, '99/99/9999':U)
     1498           )
     1499       .
     1500     end.
     1501     if p-shift-num < 1
     1502     or p-shift-num > 24
     1503     then do:
     1504       message
     1505         vss-workfile vss-revision vss-description skip
     1506         "Неправильный номер смены" skip
     1507         "p-shift-num" p-shift-num skip
     1508         view-as alert-box error .
     1509       undo, return error return-value .
     1510     end.
     1511     assign
     1512       p-fact-order           = v-fact-date-num
     1513                              + v-shift-offset * 0.5
     1514                              + p-shift-num    * 0.02 - 0.01
     1515                              + p-fact-num     * 0.0000000001
     1516       p-shift-end-fact-order = v-fact-date-num
     1517                              + v-shift-offset * 0.5
     1518                              + p-shift-num    * 0.02
     1519       p-day-end-fact-order   = v-fact-date-num
     1520                              + 0.99
     1521     .
     1522     if p-fact-order           <= v-fact-date-num
     1523     or p-shift-end-fact-order <= v-fact-date-num
     1524     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1525     or p-shift-end-fact-order >= p-day-end-fact-order
     1526     then do:
     1527       message
     1528         vss-workfile vss-revision vss-description skip
     1529         "Внутренняя ошибка при генерации фактического номера" skip
     1530         "p-fact-date"            p-fact-date            skip
     1531         "p-fact-time"            p-fact-time            skip
     1532         "p-fact-num"             p-fact-num             skip
     1533         "p-shift-date"           p-shift-date           skip
     1534         "p-shift-num"            p-shift-num            skip
     1535         "p-shift-on"             p-shift-on             skip
     1536         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1537         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1538         "v-fact-date-num"        v-fact-date-num        skip
     1539         view-as alert-box error .
     1540       undo, return error return-value .
     1541     end.
     1542   end procedure.
     1543   procedure day-begin-fact-order :
     1544     define input  parameter p-fact-date            as date    no-undo .
     1545     define output parameter p-day-begin-fact-order as decimal no-undo .
     1546     do
     1547     on error undo, return error return-value
     1548     :
     1549       if p-fact-date = ?
     1550       then do:
     1551         assign
     1552           p-day-begin-fact-order = 0
     1553         .
     1554       end.
     1555       else do:
     1556         assign
     1557           p-day-begin-fact-order = integer(p-fact-date)
     1558         .
     1559       end.
     1560     end.
     1561   end procedure.
     1562   procedure factord-max-fact-order :
     1563     define output parameter p-max-fact-order as decimal   no-undo .
     1564     do
     1565     on error undo, return error return-value
     1566     :
     1567       run day-begin-fact-order in this-procedure
     1568         (input  date(1, 1, 5000)
     1569         ,output p-max-fact-order
     1570         ) .
     1571     end.
     1572   end procedure.
     1573   procedure factord-cut-archive :
     1574     define input  parameter p-obj-type             as character no-undo .
     1575     define input  parameter p-obj-code             as integer   no-undo .
     1576     define input  parameter p-fact-date            as date      no-undo .
     1577     define output parameter p-shift-on             as logical   no-undo .
     1578     define output parameter p-shift-date           as date      no-undo .
     1579     define output parameter p-shift-num            as integer   no-undo .
     1580     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1581     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1582     define variable v-fact-order as decimal   no-undo .
     1583     define buffer buf_shift-obj for ub.shift-obj .
     1584     do
     1585     on error undo, return error return-value
     1586     :
     1587   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1588   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1589     (input  p-obj-type
     1590     ,input  p-obj-code
     1591     ,input  'shift-on=request'
     1592     ,output p-shift-on
     1593     ) no-error .
     1594       if error-status :error
     1595       then do:
     1596         message
     1597           vss-workfile vss-revision vss-description skip
     1598           "Ошибка при определении атрибута объекта" skip
     1599           "Объект" p-obj-type p-obj-code skip
     1600           error-status :get-message(1) skip
     1601           return-value skip
     1602           view-as alert-box error .
     1603         undo, return error return-value .
     1604       end.
     1605       if p-shift-on = false
     1606       then do:
     1607         assign
     1608           p-shift-date               = ?
     1609           p-shift-num                = 0
     1610         .
     1611       end.
     1612       else do:
     1613         find first buf_shift-obj share-lock
     1614           where buf_shift-obj.obj-type   = p-obj-type
     1615             and buf_shift-obj.obj-code   = p-obj-code
     1616             and buf_shift-obj.shift-date > p-fact-date
     1617           use-index pi
     1618           no-error .
     1619         if not available buf_shift-obj
     1620         or buf_shift-obj.status_ <> 'зкр':U
     1621         then do:
     1622           message
     1623             vss-workfile vss-revision vss-description skip
     1624             "Невозможно вычислить последнюю смену" skip
     1625             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1626             "Объект" p-obj-type p-obj-code skip
     1627             "Дата" p-fact-date skip
     1628             view-as alert-box error .
     1629           undo, return error return-value .
     1630         end.
     1631         find last buf_shift-obj share-lock
     1632           where buf_shift-obj.obj-type = p-obj-type
     1633             and buf_shift-obj.obj-code = p-obj-code
     1634             and buf_shift-obj.shift-date <= p-fact-date
     1635           use-index pi
     1636           no-error .
     1637         if available buf_shift-obj
     1638         then do:
     1639           if  buf_shift-obj.status_ = 'зкр':U
     1640           then do:
     1641             assign
     1642               p-shift-date = buf_shift-obj.shift-date
     1643               p-shift-num  = buf_shift-obj.shift-num
     1644             .
     1645           end.
     1646           else do:
     1647             message
     1648               vss-workfile vss-revision vss-description skip
     1649               "Невозможно вычислить последнюю смену" skip
     1650               "Статус смены отличен от статуса" 'зкр':U skip
     1651               "Объект" p-obj-type p-obj-code skip
     1652               "Дата" p-fact-date skip
     1653               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1654               view-as alert-box error .
     1655             undo, return error return-value .
     1656           end.
     1657         end.
     1658         else do:
     1659           assign
     1660             p-shift-date = p-fact-date - 1
     1661             p-shift-num  = 1
     1662           .
     1663         end.
     1664       end.
     1665       run factord in this-procedure
     1666         (input  p-fact-date
     1667         ,input  1
     1668         ,input  1
     1669         ,input  p-shift-date
     1670         ,input  p-shift-num
     1671         ,input  p-shift-on
     1672         ,output v-fact-order
     1673         ,output p-shift-end-fact-order
     1674         ,output p-day-end-fact-order
     1675         ) no-error .
     1676       if error-status :error
     1677       then do:
     1678         message
     1679           vss-workfile vss-revision vss-description skip
     1680           "Ошибка при вызове процедуры factord"
     1681           error-status :get-message(1) skip
     1682           return-value skip
     1683           view-as alert-box error .
     1684         undo, return error return-value .
     1685       end.
     1686     end.
     1687   end procedure.
     1688   procedure factord-lock-shift :
     1689     define input  parameter p-obj-type  as character no-undo .
     1690     define input  parameter p-obj-code  as integer   no-undo .
     1691     define input  parameter p-fact-date as date      no-undo .
     1692     define parameter buffer buf_shift-obj for ub.shift-obj .
     1693     define variable v-shift-on      as logical   no-undo .
     1694     define variable v-extra-message as character no-undo .
     1695     define variable v-error as character no-undo .
     1696     do
     1697     on error undo, return error return-value
     1698     :
     1699   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1700   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1701     (input  p-obj-type
     1702     ,input  p-obj-code
     1703     ,input  'shift-on=request'
     1704     ,output v-shift-on
     1705     ) no-error .
     1706       if error-status :error
     1707       then do:
     1708         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1709         undo, return error v-error .
     1710       end.
     1711       if v-shift-on = true
     1712       then do:
     1713         find first buf_shift-obj share-lock
     1714           where buf_shift-obj.obj-type   = p-obj-type
     1715             and buf_shift-obj.obj-code   = p-obj-code
     1716             and buf_shift-obj.shift-date > p-fact-date
     1717           use-index pi
     1718           no-error .
     1719         if not available buf_shift-obj
     1720         or buf_shift-obj.status_ <> 'зкр':U
     1721         then do:
     1722           find last buf_shift-obj
     1723             where buf_shift-obj.obj-type = p-obj-type
     1724               and buf_shift-obj.obj-code = p-obj-code
     1725               and buf_shift-obj.status_  = 'зкр':U
     1726             use-index stts
     1727             no-error .
     1728           if available buf_shift-obj
     1729           then do:
     1730             assign
     1731               v-extra-message =
     1732                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1733                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1734                               )
     1735             .
     1736           end.
     1737           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1738           undo, return error v-error .
     1739         end.
     1740       end.
     1741     end.
     1742   end procedure.
     1743   procedure factord-end-day :
     1744     define input  parameter p-fact-date            as date    no-undo .
     1745     define output parameter p-day-end-fact-order   as decimal no-undo .
     1746     do
     1747     on error undo, return error return-value
     1748     :
     1749       if p-fact-date = ?
     1750       then do:
     1751         return error "Не указана фактическая дата" .
     1752       end.
     1753       assign
     1754         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1755       .
     1756     end.
     1757   end procedure.
     1758   procedure factord-to-date :
     1759     define input  parameter p-fact-order as decimal no-undo .
     1760     define output parameter p-fact-date  as date    no-undo .
     1761     define variable v-ref-date  as date      no-undo .
     1762     define variable v-ref-delta as integer   no-undo .
     1763     do
     1764     on error undo, return error return-value
     1765     :
     1766       if p-fact-order = ?
     1767       or p-fact-order = 0
     1768       then do:
     1769         return error "Не указан fact-order" .
     1770       end.
     1771       assign
     1772         v-ref-date  = date(1, 1, 2000)
     1773       .
     1774       assign
     1775         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1776       .
     1777       assign
     1778         p-fact-date = v-ref-date + v-ref-delta
     1779       .
     1780     end.
     1781   end procedure.
     1782   procedure factord-to-fact-num :
     1783     define input  parameter p-fact-order as decimal no-undo .
     1784     define output parameter p-fact-num   as integer no-undo .
     1785     define variable v-fact-order-trunc as decimal no-undo .
     1786     do
     1787     on error undo, return error return-value
     1788     :
     1789       if p-fact-order = ?
     1790       or p-fact-order = 0
     1791       then do:
     1792         return error "Не указан fact-order" .
     1793       end.
     1794       assign
     1795        v-fact-order-trunc = truncate(p-fact-order, 2)
     1796       .
     1797       assign
     1798         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1799       .
     1800     end.
     1801   end procedure.
     1802   procedure factord-to-shift-num :
     1803     define input  parameter p-fact-order as decimal no-undo .
     1804     define output parameter p-shift-num   as integer no-undo .
     1805     define variable  p-shift-numd  as decimal   no-undo .
     1806     define variable v-fact-order-trunc as decimal no-undo .
     1807     do
     1808     on error undo, return error return-value
     1809     :
     1810       if p-fact-order = ?
     1811       or p-fact-order = 0
     1812       then do:
     1813         return error "Не указан fact-order" .
     1814       end.
     1815       assign
     1816        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1817       .
     1818       if v-fact-order-trunc < 0.5 then do:
     1819         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1820       end.
     1821       assign
     1822         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1823         .
     1824        assign
     1825         p-shift-num = truncate (p-shift-numd , 0)
     1826       .
     1827     end.
     1828   end procedure.
     1829   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1830   procedure cur-time :
     1831      define output parameter p-today as date      no-undo .
     1832      define output parameter p-time  as integer   no-undo .
     1833     do
     1834     on error undo, return error
     1835     :
     1836       define variable v-date1 as date      no-undo .
     1837       define variable v-date2 as date      no-undo .
     1838       define variable v-time  as integer   no-undo .
     1839       assign
     1840         v-date1 = today
     1841         v-time  = time
     1842         v-date2 = today
     1843       .
     1844       if v-date1 <> v-date2
     1845       then do:
     1846         assign
     1847           v-date1 = today
     1848           v-time  = v-time
     1849         .
     1850       end.
     1851       assign
     1852         p-today = v-date1
     1853         p-time  = v-time
     1854       .
     1855     end.
     1856   end.
     1857   function cur-time-date returns character
     1858   :
     1859     return string(today, '99/99/9999':U) .
     1860   end.
     1861   function cur-time-mjd returns decimal
     1862   :
     1863     define variable v-date as date      no-undo .
     1864     define variable v-time as integer   no-undo .
     1865     run cur-time in this-procedure
     1866       (output v-date
     1867       ,output v-time
     1868       ) .
     1869     return integer(v-date) - 2400002 + (v-time / 86400) .
     1870   end.
     1871   function cur-time-get-ending-index returns integer
     1872   (input p-number as integer
     1873   )
     1874   :
     1875     if p-number < 0
     1876     or p-number = ?
     1877     then do:
     1878       return 1 .
     1879     end.
     1880     define variable v-rest as integer   no-undo .
     1881     assign
     1882       p-number = p-number modulo 100
     1883     .
     1884     if p-number < 20
     1885     then do:
     1886       assign
     1887         v-rest = p-number
     1888       .
     1889     end.
     1890     else do:
     1891       assign
     1892         v-rest = p-number modulo 10
     1893       .
     1894     end.
     1895     case v-rest :
     1896       when 1
     1897       then do:
     1898         return 2 .
     1899       end.
     1900       when 2 or
     1901       when 3 or
     1902       when 4
     1903       then do:
     1904         return 3 .
     1905       end.
     1906       otherwise do:
     1907         return 1 .
     1908       end.
     1909     end case .
     1910   end.
     1911   procedure cur-time-mjd-to-date :
     1912      define input  parameter i-mjd-diff as decimal no-undo.
     1913      define output parameter o-Date     as date    no-undo.
     1914      define output parameter o-Time     as integer no-undo.
     1915      define variable v-day-number as integer   no-undo .
     1916      if    i-mjd-diff < 0
     1917         or i-mjd-diff = ?
     1918      then do:
     1919         return "?" .
     1920      end.
     1921      assign
     1922         v-day-number = truncate(i-mjd-diff,0).
     1923         o-Date = date(v-day-number + 2400002).
     1924         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     1925     .
     1926   end.
     1927   function cur-time-mjd-to-string returns character
     1928   (input p-mjd-diff as decimal
     1929   )
     1930   :
     1931     define variable v-day-number as integer   no-undo .
     1932     define variable v-seconds    as integer   no-undo .
     1933     define variable v-hour       as integer   no-undo .
     1934     define variable v-min        as integer   no-undo .
     1935     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     1936     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     1937     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     1938     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     1939     if p-mjd-diff < 0
     1940     or p-mjd-diff = ?
     1941     then do:
     1942       return "?" .
     1943     end.
     1944     assign
     1945       v-day-number = integer(truncate(p-mjd-diff,0))
     1946       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     1947     .
     1948     if v-seconds > 86400
     1949     then do:
     1950       assign
     1951         v-seconds = 86400 - 1
     1952       .
     1953     end.
     1954     if v-seconds < 0
     1955     then do:
     1956       assign
     1957         v-seconds = 0
     1958       .
     1959     end.
     1960     assign
     1961       v-hour = truncate(v-seconds / 3600, 0)
     1962     .
     1963     assign
     1964       v-seconds = v-seconds modulo 3600
     1965     .
     1966     assign
     1967       v-min = truncate(v-seconds / 60, 0)
     1968     .
     1969     assign
     1970       v-seconds = v-seconds modulo 60
     1971     .
     1972     return
     1973         (if v-day-number <> 0
     1974           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1975           else ""
     1976         )
     1977       + (if v-day-number <> 0 or v-hour <> 0
     1978           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1979           else ""
     1980         )
     1981       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1982           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1983           else ""
     1984         )
     1985       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1986       .
     1987   end.
     1988   function cur-time-string returns character
     1989   :
     1990     define variable v-date as date      no-undo .
     1991     define variable v-time as integer   no-undo .
     1992     run cur-time in this-procedure
     1993       (output v-date
     1994       ,output v-time
     1995       ) .
     1996     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1997   end.
     1998   function cur-time-string-sec returns character
     1999   :
     2000     define variable v-date as date      no-undo .
     2001     define variable v-time as integer   no-undo .
     2002     run cur-time in this-procedure
     2003       (output v-date
     2004       ,output v-time
     2005       ) .
     2006     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     2007   end.
     2008   function cur-time-custom  returns character
     2009   (input p-prefix as character
     2010   ,input p-date-format as character
     2011   ,input p-delimiter as character
     2012   ,input p-time-format as character
     2013   ,input p-suffix as character
     2014   )
     2015   :
     2016     define variable v-date as date      no-undo .
     2017     define variable v-time as integer   no-undo .
     2018     run cur-time in this-procedure
     2019       (output v-date
     2020       ,output v-time
     2021       ) .
     2022     return
     2023       p-prefix
     2024       + string(v-date, p-date-format)
     2025       + p-delimiter
     2026       + string(v-time, p-time-format)
     2027       + p-suffix
     2028       .
     2029   end.
     2030   function cur-time-print  returns character
     2031   :
     2032     define variable v-date as date      no-undo .
     2033     define variable v-time as integer   no-undo .
     2034     run cur-time in this-procedure
     2035       (output v-date
     2036       ,output v-time
     2037       ) .
     2038     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     2039   end.
     2040   function cur-time-datetime returns datetime
     2041   :
     2042     define variable v-char as character no-undo .
     2043     define variable v-datetime as datetime no-undo .
     2044     v-char = cur-time-string().
     2045     v-datetime = datetime(v-char).
     2046     return  v-datetime.
     2047   end.
     2048   function cur-time-string-msec returns character
     2049   :
     2050     define variable v-date as datetime  no-undo .
     2051     v-date = now.
     2052     return string(v-date) .
     2053   end.
     2054   DEFINE VARIABLE State-source AS WIDGET-HANDLE.
     2055   DEFINE VARIABLE is-wth       AS LOGICAL   NO-UNDO.
     2056   DEFINE VARIABLE is-elved     AS LOGICAL   NO-UNDO.
     2057   DEFINE VARIABLE dops         AS CHARACTER NO-UNDO .
     2058   DEFINE VARIABLE dopst        AS CHARACTER NO-UNDO .
     2059   define variable v-profile-id as integer   no-undo .
     2060   DEFINE VARIABLE v-esys-id    AS integer   NO-UNDO.
     2061   define variable v-shift-days-to-report as integer no-undo .
     2062   define variable v-tog        as logical   extent 10.
     2063   define variable v-weight     as logical   no-undo .
     2064   define variable v-classify   as character no-undo .
     2065   define variable v-sorttype   as character no-undo .
     2066   define variable v-level      as integer   no-undo .
     2067   define variable v-pump-one   as logical   no-undo .
     2068   define variable v-whole-gds  as logical   no-undo .
     2069   define variable v-el-icnt    as logical   no-undo .
     2070   define variable v-cp-grp     as logical   no-undo .
     2071   define variable v-output-type  as character no-undo .
     2072   define variable v-line-of-page as integer no-undo .
     2073   define temp-table last-shift no-undo
