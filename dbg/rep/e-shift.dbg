     2211        SIZE 60.75 BY .78 TOOLTIP "Лист отчета ~"Статистика реализации по ведомостям~""
     2212        BGCOLOR 8 FGCOLOR 0  NO-UNDO.
     2213   DEFINE VARIABLE tog-9 AS LOGICAL INITIAL no
     2214        LABEL "Часть 9 - Сбросы, переливы и переводы транзакций"
     2215        VIEW-AS TOGGLE-BOX
     2216        SIZE 61.5 BY .78 NO-UNDO.
