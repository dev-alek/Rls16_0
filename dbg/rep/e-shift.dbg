     2876       .
     2877     end.
     2878     else do:
     2879       assign
     2880         is-wth = false
     2881       .
     2882     end.
     2883   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2884     (input  'is-elved'
     2885     ,input  ''
     2886     ,input  ''
     2887     ,input  0
     2888     ,input  ''
     2889     ,input  ''
     2890     ,input  ''
     2891     ,input  no
     2892     ,output dops
     2893     ,output dopst
     2894     ) no-error .
     2895     if not error-status :error
     2896       and dops = "yes":u
     2897     then do:
     2898       assign
     2899         is-elved = true
     2900       .
     2901     end.
     2902     else do:
     2903       assign
     2904         is-elved = false
     2905       .
     2906     end.
     2907     assign
     2908       v-init = false
     2909     .
     2910   CASE place-call:
     2911     WHEN 'schedule':U
     2912     or
     2913     when 'rp-by-call':U
     2914     THEN DO:
     2915       RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     2916       CASE v-profile-id:
     2917         WHEN 53 THEN DO:
     2918          assign
     2919          tog-weight :screen-value in frame F-Main = 'no'
     2920          tog-1 :screen-value in frame F-Main = 'yes'
     2921          tog-1-whole-gds :screen-value in frame F-Main = 'no'
     2922          tog-1-pump-one :screen-value in frame F-Main = 'no'
     2923          tog-2 :screen-value in frame F-Main = 'yes'
     2924          tog-2-cp-grp :screen-value in frame F-Main = 'no'
     2925          tog-3 :screen-value in frame F-Main = 'yes'
     2926          tog-4 :screen-value in frame F-Main = 'no'
     2927          tog-5 :screen-value in frame F-Main = 'no'
     2928          tog-6 :screen-value in frame F-Main = 'no'
     2929          tog-7 :screen-value in frame F-Main = 'no'
     2930          tog-8 :screen-value in frame F-Main = 'no'
     2931          tog-81 :screen-value in frame F-Main = 'no'
     2932          tog-82 :screen-value in frame F-Main = 'no'
     2933          tog-9 :screen-value in frame F-Main = 'no'
     2934          tog-10 :screen-value in frame F-Main = 'no'
     2935          f-line-of-page:screen-value in frame F-Main  = string(43)
     2936          tog-1-out-pump-with-icnt :screen-value in frame F-Main = 'no'
     2937          classify = "no-classify":u
     2938          var-level :screen-value in frame F-Main = '1':U
     2939          .
     2940           RUN ini-from-selgds IN THIS-PROCEDURE.
     2941           apply "value-changed":u to tog-1 in frame F-Main.
     2942           apply "value-changed":u to tog-2 in frame F-Main.
     2943           apply "value-changed":u to tog-3 in frame F-Main.
     2944           f-esys-id = v-esys-id.
     2945           f-shift-days-to-report = v-shift-days-to-report.
     2946           RUN get-ext-system IN THIS-PROCEDURE ( INPUT NO).
     2947           disable
     2948           tog-1-whole-gds
     2949           tog-1-pump-one
     2950           tog-1-out-pump-with-icnt
     2951           tog-2-cp-grp
     2952           classify
     2953           tog-weight
     2954           tog-1
     2955           tog-2
     2956           tog-3
     2957           tog-4
     2958           tog-5
     2959           tog-6
     2960           tog-7
     2961           tog-8
     2962           tog-82
     2963           tog-9
     2964           tog-10
     2965           f-line-of-page
     2966           b-staff
     2967           t-excel
     2968           t-text
     2969           with frame F-Main .
     2970           hide
     2971           tog-weight
     2972           tog-1-whole-gds
     2973           tog-1-pump-one
     2974           tog-1-out-pump-with-icnt
     2975           tog-2-cp-grp
     2976           tog-4
     2977           tog-5
     2978           tog-6
     2979           tog-7
     2980           tog-8
     2981           tog-82
     2982           tog-9
     2983           tog-10
     2984           f-line-of-page
     2985           b-staff
     2986           t-excel
     2987           t-text
     2988           in frame F-Main .
     2989           display
     2990           f-shift-days-to-report
