     2227   DEFINE FRAME F-Main
     2228        tog-weight AT ROW 1.26 COL 2.5
     2229        f-line-of-page AT ROW 1.26 COL 86 COLON-ALIGNED
     2230        tog-1-out-pump-with-icnt AT ROW 2.52 COL 14 WIDGET-ID 4
     2231        TOG-1 AT ROW 3.52 COL 14
     2232        tog-1-pump-one AT ROW 4.26 COL 20
     2233        tog-1-whole-gds AT ROW 4.26 COL 52
     2234        TOG-2 AT ROW 5 COL 14
     2235        tog-2-cp-grp AT ROW 5.8 COL 20
     2236        TOG-3 AT ROW 6.6 COL 14
     2237        Classify AT ROW 7.2 COL 20 NO-LABEL
     2238        SortType AT ROW 7.8 COL 24 NO-LABEL
     2239        Tog-level AT ROW 9 COL 73.5
     2240        var-level AT ROW 9 COL 84 COLON-ALIGNED NO-LABEL
     2241        TOG-4 AT ROW 10.5 COL 14
     2242        TOG-5 AT ROW 11.3 COL 14
     2243        TOG-5-1 AT ROW 11.3 COL 14 WIDGET-ID 22
     2244        f-shift-days-to-report AT ROW 13.19 COL 68 COLON-ALIGNED WIDGET-ID 6
     2245        TOG-6 AT ROW 12.1 COL 14
     2246        b-esys AT ROW 13.41 COL 63 WIDGET-ID 16
     2247        TOG-7 AT ROW 12.9 COL 14
     2248        TOG-8 AT ROW 13.6 COL 14
     2249        TOG-81 AT ROW 13.7 COL 14
     2250        TOG-82 AT ROW 14.5 COL 20
     2251        tog-9 AT ROW 15.3 COL 14 WIDGET-ID 2
     2252        tog-10 AT ROW 16.1 COL 14
     2253        B-staff AT ROW 17.4 COL 2
     2254        t-excel AT ROW 17.4 COL 50.5 WIDGET-ID 20
     2255        t-TEXT AT ROW 18.59 COL 71 WIDGET-ID 8
     2256        f-esys-id AT ROW 14.41 COL 48 COLON-ALIGNED WIDGET-ID 14
     2257        f-esys-name AT ROW 16.52 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 18
     2258        "Показать :" VIEW-AS TEXT
     2259             SIZE 11.5 BY .78 AT ROW 2.52 COL 2.5
     2260             FGCOLOR 4
     2261        RECT-9 AT ROW 2.26 COL 1.5
     2262       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     2263            SIDE-LABELS NO-UNDERLINE THREE-D
     2264            AT COL 1 ROW 1 SCROLLABLE
     2265            BGCOLOR 8 FGCOLOR 0 .
     2266   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     2267   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     2268   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     2269   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     2270   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     2271   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     2272   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     2273   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     2274         adm-object-hdl = FRAME F-Main:HANDLE.
     2275   RUN ensure-broker.
     2276   THIS-PROCEDURE:ADM-DATA =
     2277        'ADM1.1~`':U +
     2278        'SmartObject~`':U +
     2279        '~`':U +
     2280        'NO ~`':U +
     2281        '~`':U +
     2282        '~`':U +
     2283        '~`':U +
     2284        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     2285           + "~`":U +
     2286        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     2287        'Record-Source,Record-Target,TableIO-Target~`':U +
     2288        '~`':U +
     2289        '~`~`~`~`~`~`~`~`~`~`~`':U +
     2290        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     2291            THEN "^^":U
     2292        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     2293             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     2294   PROCEDURE adm-apply-entry :
     2295     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2296   END PROCEDURE.
     2297   PROCEDURE adm-destroy :
     2298    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2299   END PROCEDURE.
     2300   PROCEDURE adm-disable :
     2301       DISABLE RECT-9 tog-weight f-line-of-page tog-1-out-pump-with-icnt TOG-1 tog-1-pump-one tog-1-whole-gds TOG-2 tog-2-cp-grp TOG-3 Classify SortType TOG-4 TOG-5 f-shift-days-to-report TOG-6 b-esys TOG-7 TOG-8 TOG-81 TOG-82 tog-9 tog-10 B-staff t-excel t-TEXT WITH FRAME F-Main.
     2302       RUN dispatch ('disable-fields':U).
     2303       RUN set-attribute-list ('ENABLED=no':U).
     2304       RETURN.
     2305   END PROCEDURE.
     2306   PROCEDURE adm-edit-attribute-list :
     2307         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     2308         RETURN.
     2309   END PROCEDURE.
     2310   PROCEDURE adm-enable :
     2311       ENABLE UNLESS-HIDDEN RECT-9 tog-weight f-line-of-page tog-1-out-pump-with-icnt TOG-1 tog-1-pump-one tog-1-whole-gds TOG-2 tog-2-cp-grp TOG-3 Classify SortType TOG-4 TOG-5 f-shift-days-to-report TOG-6 b-esys TOG-7 TOG-8 TOG-81 TOG-82 tog-9 tog-10 B-staff t-excel t-TEXT WITH FRAME F-Main.
     2312       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     2313       RUN set-attribute-list ('ENABLED=yes':U).
     2314       RETURN.
     2315   END PROCEDURE.
     2316   PROCEDURE adm-exit :
     2317        RUN notify ('exit':U).
     2318     RETURN.
     2319   END PROCEDURE.
     2320   PROCEDURE adm-hide :
     2321     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2322   END PROCEDURE.
     2323   PROCEDURE adm-initialize :
     2324     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2325   END PROCEDURE.
     2326   PROCEDURE adm-show-errors :
     2327       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     2328       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     2329           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     2330       END.
     2331       RETURN.
     2332   END PROCEDURE.
     2333   PROCEDURE adm-UIB-mode :
     2334     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2335   END PROCEDURE.
     2336   PROCEDURE adm-view :
     2337     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     2338   END PROCEDURE.
     2339   PROCEDURE dispatch :
     2340       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     2341       RUN broker-dispatch IN adm-broker-hdl
     2342           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     2343       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     2344   END PROCEDURE.
     2345   PROCEDURE ensure-broker :
     2346   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     2347   IF RETURN-VALUE NE "ADM-Broker":U THEN
     2348   DO:
     2349       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     2350       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     2351   END.
     2352   END PROCEDURE.
     2353   PROCEDURE get-attribute :
     2354     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     2355     RUN broker-get-attribute IN adm-broker-hdl
     2356         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     2357     RETURN RETURN-VALUE.
     2358   END PROCEDURE.
     2359   PROCEDURE get-attribute-list :
     2360     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     2361     RUN broker-get-attribute-list IN adm-broker-hdl
     2362         (INPUT THIS-PROCEDURE,
     2363          INPUT ?,
     2364          OUTPUT p-attr-list) NO-ERROR.
     2365     RETURN.
     2366   END PROCEDURE.
     2367   PROCEDURE new-state :
     2368     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     2369     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     2370     RETURN.
     2371   END PROCEDURE.
     2372   PROCEDURE notify :
     2373     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     2374     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     2375     IF RETURN-VALUE = "ADM-ERROR":U THEN
     2376         RETURN "ADM-ERROR":U.
     2377     RETURN.
     2378   END PROCEDURE.
     2379   PROCEDURE set-attribute-list :
     2380     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     2381     RUN ensure-broker.
     2382     RUN broker-set-attribute-list IN adm-broker-hdl
     2383         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     2384     RETURN.
     2385   END PROCEDURE.
     2386   PROCEDURE set-position :
     2387       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     2388       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     2389       IF VALID-HANDLE(adm-object-hdl) THEN
     2390       DO:
     2391         ASSIGN adm-object-hdl:ROW    =   p-row
     2392                adm-object-hdl:COLUMN =   p-col.
     2393       END.
     2394       RETURN.
     2395   END PROCEDURE.
     2396   PROCEDURE adm-display-fields :
     2397       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     2398       RETURN.
     2399   END PROCEDURE.
     2400   PROCEDURE adm-open-query :
     2401     RETURN.
     2402   END PROCEDURE.
     2403   PROCEDURE adm-row-changed :
     2404         IF VALID-HANDLE(adm-object-hdl) THEN
     2405           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     2406         RUN notify ('row-available':U).
     2407         RETURN.
     2408   END PROCEDURE.
     2409   PROCEDURE reposition-query :
     2410       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     2411       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     2412       RETURN.
     2413   END PROCEDURE.
     2414     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     2415     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     2416     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     2417     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     2418     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     2419     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     2420     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     2421     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     2422     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2423     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     2424     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     2425     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     2426     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     2427     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     2428     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     2429     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     2430     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     2431     IF "":U = "":U THEN
     2432       RUN modify-list-attribute IN adm-broker-hdl
     2433         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     2434     RUN use-create-on-add(?).
     2435   PROCEDURE adm-add-record :
     2436       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2437          "must have at least one Enabled Table to perform Add.":U
     2438          VIEW-AS ALERT-BOX ERROR.
     2439       RETURN.
     2440   END PROCEDURE.
     2441   PROCEDURE adm-assign-record :
     2442    MESSAGE
     2443          "Object ":U THIS-PROCEDURE:FILE-NAME
     2444            "must have at least one Enabled Table to perform Assign.":U
     2445              VIEW-AS ALERT-BOX ERROR.
     2446      RETURN.
     2447     END PROCEDURE.
     2448   PROCEDURE adm-assign-statement :
     2449     RETURN.
     2450   END PROCEDURE.
     2451   PROCEDURE adm-cancel-record :
     2452      RETURN.
     2453     END PROCEDURE.
     2454   PROCEDURE adm-copy-record :
     2455       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     2456        "must have at least one Enabled Table to perform Copy.":U
     2457          VIEW-AS ALERT-BOX ERROR.
     2458       RETURN.
     2459   END PROCEDURE.
     2460   PROCEDURE adm-create-record :
     2461      RETURN.
     2462   END PROCEDURE.
     2463   PROCEDURE adm-current-changed :
     2464     RETURN.
     2465   END PROCEDURE.
     2466   PROCEDURE adm-delete-record :
     2467    MESSAGE
     2468          "Object ":U THIS-PROCEDURE:FILE-NAME
     2469            "must have at least one Enabled Table to perform Delete.":U
     2470              VIEW-AS ALERT-BOX ERROR.
     2471       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     2472       RETURN.
     2473   END PROCEDURE.
     2474   PROCEDURE adm-disable-fields :
     2475         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     2476       RETURN.
     2477   END PROCEDURE.
     2478   PROCEDURE adm-enable-fields :
     2479       RETURN.
     2480   END PROCEDURE.
     2481   PROCEDURE adm-end-update :
     2482     RETURN.
     2483   END PROCEDURE.
     2484   PROCEDURE adm-reset-record :
     2485       RETURN.
     2486   END PROCEDURE.
     2487   PROCEDURE adm-update-record :
     2488       MESSAGE
     2489         "Object ":U THIS-PROCEDURE:FILE-NAME
     2490           "must have at least one Enabled Table to perform Update.":U
     2491             VIEW-AS ALERT-BOX ERROR.
     2492      RETURN.
     2493   END PROCEDURE.
     2494   PROCEDURE check-modified :
     2495   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     2496   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     2497   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     2498   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     2499     IF check-state = "check":U THEN
     2500     DO:
     2501       RUN get-link-handle IN adm-broker-hdl
     2502         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     2503            OUTPUT group-target-list).
     2504       IF group-target-list NE "":U THEN
     2505       DO i = 1 TO NUM-ENTRIES(group-target-list):
     2506         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     2507         RUN check-modified IN curr-widget ('group-check':U).
     2508         IF RETURN-VALUE NE "":U THEN
     2509         DO:
     2510           RUN check-modified-message(RETURN-VALUE).
     2511           RETURN "":U.
     2512         END.
     2513       END.
     2514     END.
     2515     RETURN "":U.
     2516   END PROCEDURE.
     2517   PROCEDURE check-modified-message :
     2518     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     2519        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     2520           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     2521        IF RETURN-VALUE = "YES":U THEN
     2522           RUN notify ('view,CONTAINER-SOURCE':U).
     2523        MESSAGE IF p-changed-table NE ? THEN
     2524           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     2525           ELSE "Current values have been changed."
     2526           SKIP "  Do you wish to save those changes?"
     2527           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     2528        IF ANS THEN
     2529        DO:
     2530           IF group-assign-target THEN
     2531             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     2532           ELSE RUN dispatch('update-record':U).
     2533           IF RETURN-VALUE = "ADM-ERROR":U THEN
     2534           DO:
     2535               MESSAGE "Changes to the previous record were not saved."
     2536                 VIEW-AS ALERT-BOX ERROR.
     2537               IF group-assign-target THEN
     2538                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2539               ELSE RUN dispatch ('cancel-record':U).
     2540           END.
     2541        END.
     2542        ELSE DO:
     2543          IF group-assign-target THEN
     2544             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     2545          ELSE RUN dispatch('cancel-record':U).
     2546        END.
     2547        RETURN.
     2548   END PROCEDURE.
     2549   PROCEDURE get-rowid :
     2550       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2551       ASSIGN
     2552       p-table   =   adm-first-table.
     2553       RETURN.
     2554   END PROCEDURE.
     2555   PROCEDURE init-group-assign :
     2556       RUN request-attribute IN adm-broker-hdl
     2557         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2558       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2559         group-assign-target = yes.
     2560       ELSE group-assign-target = no.
     2561       RETURN.
     2562   END PROCEDURE.
     2563   PROCEDURE set-editors :
     2564       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2565       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2566       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2567       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2568       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2569       DO WHILE VALID-HANDLE (curr-widget):
     2570           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2571              curr-widget:HIDDEN = no THEN DO:
     2572             CASE p-field-setting:
     2573               WHEN "INITIALIZE":U THEN
     2574               DO:
     2575                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2576                     read-only-list +
     2577                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2578                        STRING(curr-widget).
     2579               END.
     2580               WHEN "DISABLE":U OR
     2581               WHEN "ENABLE":U THEN
     2582               DO:
     2583                   curr-widget:SENSITIVE = yes.
     2584                   RUN get-attribute ('Read-Only-Editors':U).
     2585                   IF RETURN-VALUE = ? OR
     2586                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2587                       curr-widget:READ-ONLY =
     2588                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2589               END.
     2590               WHEN "CLEAR":U THEN
     2591                   curr-widget:SCREEN-VALUE = "":U.
     2592             END CASE.
     2593           END.
     2594           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2595       END.
     2596       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2597         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2598           + '"':U).
     2599       RETURN.
     2600   END PROCEDURE.
     2601   PROCEDURE use-check-modified-all :
     2602    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2603     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2604     RETURN.
     2605   END PROCEDURE.
     2606   PROCEDURE use-create-on-add :
     2607   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2608      RETURN.
     2609   END PROCEDURE.
     2610   PROCEDURE use-initial-lock :
     2611     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2612     ASSIGN adm-initial-lock = p-attr-value.
     2613     RETURN.
     2614   END PROCEDURE.
     2615     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2616   ASSIGN
     2617          FRAME F-Main:HEIGHT           = 18.67
     2618          FRAME F-Main:WIDTH            = 92.13.
     2619   ASSIGN
     2620          f-esys-id:READ-ONLY IN FRAME F-Main        = TRUE.
     2621   ASSIGN
     2622          SortType:HIDDEN IN FRAME F-Main           = TRUE.
     2623   ASSIGN
     2624          TOG-5-1:HIDDEN IN FRAME F-Main           = TRUE.
     2625   ASSIGN
     2626          Tog-level:HIDDEN IN FRAME F-Main           = TRUE.
     2627   ASSIGN
     2628          var-level:HIDDEN IN FRAME F-Main           = TRUE.
     2629   ON CHOOSE OF b-esys IN FRAME F-Main
     2630   DO:
     2631   RUN get-ext-system IN THIS-PROCEDURE  ( INPUT YES).
     2632   END.
     2633   ON CHOOSE OF B-staff IN FRAME F-Main
     2634   DO:
     2635       RUN my-var IN THIS-PROCEDURE.
     2636       if X-date-start <> X-date-end or X-Shift-start <> X-Shift-end then
     2637         message "При выборе нескольких смен показывается только персонал последней"  view-as alert-box INFORMATION .
     2638       run ref/shftpers.w ( input my-handle,
     2639                        INPUT v-cntxt-obj-type,
     2640                        INPUT v-cntxt-obj-code,
     2641                        INPUT X-date-end,
     2642                        INPUT X-Shift-end,
     2643                        INPUT "b-add-next":U,
     2644                        INPUT "":U            ) NO-ERROR.
     2645   END.
     2646   ON VALUE-CHANGED OF Classify IN FRAME F-Main
     2647   DO:
     2648     ASSIGN Classify.
     2649     if place-call = "'new-rep'" then do:
     2650         DISABLE
     2651            tog-6
     2652         with frame F-Main .
     2653         HIDE
     2654               tog-8
     2655               in frame F-Main.
     2656          ENABLE
     2657               tog-81
     2658               tog-82
     2659            with frame F-Main .
     2660        if is-wth = true then do:
     2661            ENABLE
     2662               tog-5
     2663            with frame F-Main .
     2664            HIDE
     2665               tog-5-1
     2666            in frame F-Main.
     2667        end.
     2668        else do:
     2669            ENABLE
     2670               tog-5-1
     2671            with frame F-Main .
     2672            HIDE
     2673               tog-5
     2674            in frame F-Main.
     2675        end.
     2676     end.
     2677     if classify = "n-level":u
     2678       and tog-3 = true
     2679     then do:
     2680       enable  tog-level  var-level with frame F-Main .
     2681       display tog-level  var-level with frame F-Main .
     2682     end.
     2683     else do:
     2684       hide    tog-level  var-level   in frame F-Main .
     2685     end.
     2686   END.
     2687   ON VALUE-CHANGED OF TOG-1 IN FRAME F-Main
     2688   DO:
     2689     assign tog-1.
     2690     if tog-1 = true then do:
     2691       enable
     2692         tog-1-whole-gds
     2693         tog-1-pump-one
     2694         tog-1-out-pump-with-icnt
     2695         with frame F-Main .
     2696     end.
     2697     else do:
     2698       disable
     2699         tog-1-whole-gds
     2700         tog-1-pump-one
     2701         tog-1-out-pump-with-icnt
     2702         with frame F-Main .
     2703     end.
     2704   END.
     2705   ON VALUE-CHANGED OF TOG-2 IN FRAME F-Main
     2706   DO:
     2707     assign tog-2.
     2708     if tog-2 = true then do:
     2709       enable  tog-2-cp-grp with frame F-Main .
     2710     end.
     2711     else do:
     2712       disable tog-2-cp-grp with frame F-Main .
     2713     end.
     2714   END.
     2715   ON VALUE-CHANGED OF TOG-3 IN FRAME F-Main
     2716   DO:
     2717     assign tog-3.
     2718     if tog-3 = true then  do:
     2719       enable  classify  with frame F-Main .
     2720     end.
     2721     else do:
     2722       disable classify  with frame F-Main .
     2723     end.
     2724     display classify  with frame F-Main .
     2725     apply "value-changed":u to classify in frame F-Main.
     2726   END.
     2727   ON VALUE-CHANGED OF TOG-5 IN FRAME F-Main
     2728   DO:
     2729     assign tog-5.
     2730   END.
     2731   ON VALUE-CHANGED OF TOG-5-1 IN FRAME F-Main
     2732   DO:
     2733     assign tog-5-1.
     2734   END.
     2735   ON VALUE-CHANGED OF TOG-81 IN FRAME F-Main
     2736   DO:
     2737     assign TOG-81.
     2738     if TOG-81 = true then do:
     2739       enable
     2740         TOG-82
     2741         with frame F-Main .
     2742     end.
     2743     else do:
     2744       TOG-82 = false.
     2745       disable
     2746         TOG-82
     2747         with frame F-Main .
     2748     end.
     2749   END.
     2750   ON VALUE-CHANGED OF Tog-level IN FRAME F-Main
     2751   DO:
     2752     assign tog-level.
     2753     if tog-level = true then do:
     2754       display var-level with frame F-Main .
     2755       enable  var-level with frame F-Main .
     2756     end.
     2757     else do:
     2758       display var-level with frame F-Main .
     2759       disable var-level with frame F-Main .
     2760     end.
     2761   END.
     2762   if not this-procedure :persistent
     2763   then do:
     2764     message
     2765       vss-workfile vss-revision vss-description skip
     2766       "Ошибка при запуске процедуры" skip
     2767       "Данную процедуру следует запускать только с параметром persistent" skip
     2768       view-as alert-box error .
     2769     undo, return error .
     2770   end.
     2771   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2772     run mainmenu_getcntxt in my-handle
     2773       (output v-cntxt-db-num
     2774       ,output v-cntxt-userid
     2775       ,output v-cntxt-level
     2776       ,output v-cntxt-host-code-obj
     2777       ,output v-cntxt-obj-type
     2778       ,output v-cntxt-obj-code
     2779       ,output v-cntxt-db-num-obj
     2780       ,output v-cntxt-is-admin
     2781       ) .
     2782   PROCEDURE disable_UI :
     2783     HIDE FRAME F-Main.
     2784     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2785   END PROCEDURE.
     2786   PROCEDURE get-ext-system :
     2787   DEFINE INPUT PARAMETER p-interface AS LOGICAL NO-UNDO.
     2788   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     2789   DEFINE VARIABLE v-int AS integer NO-UNDO.
     2790   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     2791   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     2792   DEFINE VARIABLE v-tbl-row AS rowid NO-UNDO.
     2793   DEFINE VARIABLE v-tbl-name AS CHARACTER NO-UNDO.
     2794   DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     2795   IF f-esys-id <> 0  THEN DO:
     2796      FIND FIRST buf_ext-system NO-LOCK WHERE
     2797                   buf_ext-system.esys-id = f-esys-id
     2798            AND buf_ext-system.db-num = 0 NO-ERROR.
     2799      IF AVAILABLE buf_ext-system THEN DO:
     2800          RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'ext-system':U
     2801                                             ,INPUT (BUFFER buf_ext-system:HANDLE)
     2802                                             ,OUTPUT v-uniq-key-rec) NO-ERROR.
     2803      END.
     2804   END.
     2805    IF p-interface THEN DO:
     2806         run bge/oxmlexts.p (
     2807               input my-handle
     2808             , input 2
     2809             , input substitute("esys-type > &1", '0':U)
     2810             , input v-uniq-key-rec
     2811             , output v-rid-list
     2812             , output v-ok
     2813         ).
     2814        IF NOT v-ok  THEN RETURN ERROR.
     2815             run gen-row-keyr in this-procedure
     2816             ( input v-rid-list
     2817              ,input ?
     2818              ,input "ub"
     2819              ,input ?
     2820              ,input no-lock
     2821              ,output v-tbl-row
     2822              ,output v-tbl-name
     2823            ).
     2824           find first buf_ext-system no-lock where
     2825                     rowid(buf_ext-system) = v-tbl-row.
     2826     END.
     2827     IF AVAILABLE buf_ext-system
     2828     AND (buf_ext-system.esys-id   <> f-esys-id
     2829     OR NOT p-interface) THEN DO:
     2830       f-esys-id = buf_ext-system.esys-id.
     2831       f-esys-name = buf_ext-system.esys-NAME.
     2832       DISPLAY
     2833       f-esys-id
     2834       f-esys-name
     2835       WITH FRAME F-Main.
     2836     END.
     2837   END PROCEDURE.
     2838   PROCEDURE ini-from-selgds :
     2839     CASE X-SelectGood :
     2840       WHEN 1 THEN DO:
     2841         ASSIGN Classify :RADIO-BUTTONS IN FRAME F-Main =
     2842            "Группы 1-го уровня,"             + "no-classify":U +
     2843           ",Группы с n-уровнeм вложенности," + "n-level":U     +
     2844           ",Терминальные группы,"            + "t-level":U     +
     2845           ",Только итоги,"                   + "totals":U .
     2846       END.
     2847       WHEN 2 THEN DO:
     2848         ASSIGN Classify :RADIO-BUTTONS IN FRAME F-Main =
     2849            "Выбранные группы,"                            + "no-classify":U +
     2850           ",Выбранные группы -> с n-уровнeм вложенности," + "n-level":U     +
     2851           ",Выбранные группы -> терминальные группы,"     + "t-level":U     +
     2852           ",Только итоги по выбранным группам,"           + "totals":U .
     2853       END.
     2854     END CASE.
     2855   END PROCEDURE.
     2856   PROCEDURE local-initialize :
     2857     define variable v-init as logical   no-undo .
     2858     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2859   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run conf-rd in g#library
     2860     (input  'is-wth'
     2861     ,input  ''
     2862     ,input  ''
     2863     ,input  0
     2864     ,input  ''
     2865     ,input  ''
     2866     ,input  ''
     2867     ,input  NO
     2868     ,output dops
     2869     ,output dopst
     2870     ) NO-ERROR .
     2871     if not error-status :error
