      621   define variable v-uf-type-val     like ubflt.usr-flt.type-val     no-undo .
      622   define temp-table usr-flt_custom-labels no-undo like ub.custom-labels.
      623   procedure uf-name :
      624     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
      625     define output parameter p-use-List_     as logical   no-undo .
      626     define output parameter p-type-List_     as character no-undo .
      627     define output parameter p-format-List_   as character no-undo .
      628     define output parameter p-use-Naim      as logical   no-undo .
      629     define output parameter p-type-Naim      as character no-undo .
      630     define output parameter p-format-Naim    as character no-undo .
      631     define output parameter p-use-print-graft as logical   no-undo .
      632     define output parameter p-use-sort-gr   as logical   no-undo .
      633     define output parameter p-use-type-price as logical   no-undo .
      634     define output parameter p-use-type-val  as logical   no-undo .
      635     define output parameter p-label          as character no-undo .
