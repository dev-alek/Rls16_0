     2997           f-shift-days-to-report
     2998           with frame F-Main .
     2999         end.
     3000         when 68 then do:
     3001           assign
     3002           tog-weight :screen-value in frame F-Main = string(v-weight)
     3003           tog-1 :screen-value in frame F-Main = string(v-tog[1])
     3004           tog-1-whole-gds :screen-value in frame F-Main = string(v-whole-gds)
     3005           tog-1-pump-one :screen-value in frame F-Main = string(v-pump-one)
     3006           tog-2 :screen-value in frame F-Main = string(v-tog[2])
     3007           tog-2-cp-grp :screen-value in frame F-Main = string(v-cp-grp)
     3008           tog-3 :screen-value in frame F-Main = string(v-tog[3])
     3009           tog-4 :screen-value in frame F-Main = string(v-tog[4])
     3010           tog-5 :screen-value in frame F-Main = string(v-tog[5])
     3011           tog-6 :screen-value in frame F-Main = string(v-tog[6])
     3012           tog-7 :screen-value in frame F-Main = string(v-tog[7])
     3013           tog-8 :screen-value in frame F-Main = string(v-tog[8])
     3014           tog-9 :screen-value in frame F-Main = string(v-tog[9])
     3015           tog-10 :screen-value in frame F-Main = string(v-tog[10])
     3016           f-line-of-page:screen-value in frame F-Main = string(v-line-of-page)
     3017           tog-1-out-pump-with-icnt :screen-value in frame F-Main = string(v-el-icnt)
     3018           classify:screen-value in frame F-Main  = v-classify
     3019           var-level :screen-value in frame F-Main = string(v-level)
     3020           sorttype:screen-value in frame F-Main  = v-sorttype
     3021           t-excel:screen-value in frame F-Main =  string(lookup('excel':U, v-output-type) > 0)
     3022           t-text:screen-value in frame F-Main = string(lookup('text':U, v-output-type) > 0)
     3023           .
     3024           RUN ini-from-selgds IN THIS-PROCEDURE.
     3025           apply "value-changed":u to tog-1 in frame F-Main.
     3026           apply "value-changed":u to tog-2 in frame F-Main.
     3027           apply "value-changed":u to tog-3 in frame F-Main.
     3028           disable
     3029           b-staff
     3030           b-esys
     3031           f-esys-name
     3032           f-shift-days-to-report
     3033           with frame F-Main .
     3034           hide
     3035           b-staff
     3036           f-shift-days-to-report
     3037           f-esys-name
     3038           f-esys-id
     3039           in frame F-Main .
     3040         end.
     3041       end case.
     3042     end.
     3043     otherwise do:
     3044       disable
     3045       b-esys
     3046       f-esys-id
     3047       f-esys-name
     3048       f-shift-days-to-report
     3049       t-excel
     3050       t-text
     3051       with frame F-Main .
     3052       hide
     3053       b-esys
     3054       f-esys-id
     3055       f-esys-name
     3056       f-shift-days-to-report
     3057       t-excel
     3058       t-text
     3059       in frame F-Main .
     3060       run uf-get in this-procedure(
     3061           input  'e-shift':U
     3062           ,input  v-cntxt-userid
     3063           ,output v-uf-List_
     3064           ,output v-uf-Naim
     3065           ,output v-uf-print-graft
     3066           ,output v-uf-sort-gr
     3067           ,output v-uf-type-price
     3068           ,output v-uf-type-val
     3069       )  no-error.
     3070       if not error-status:error then do:
     3071         if num-entries(v-uf-List_, chr(4)) >= 17 then do:
     3072           assign
     3073             tog-weight                :screen-value in frame F-Main = entry(1, v-uf-List_, chr(4))
     3074             tog-1-whole-gds           :screen-value in frame F-Main = entry(2, v-uf-List_, chr(4))
     3075             tog-1-pump-one            :screen-value in frame F-Main = entry(3, v-uf-List_, chr(4))
     3076             tog-2-cp-grp              :screen-value in frame F-Main = entry(4, v-uf-List_, chr(4))
     3077             tog-1                     :screen-value in frame F-Main = entry(7, v-uf-List_, chr(4))
     3078             tog-2                     :screen-value in frame F-Main = entry(8, v-uf-List_, chr(4))
     3079             tog-3                     :screen-value in frame F-Main = entry(9, v-uf-List_, chr(4))
     3080             tog-4                     :screen-value in frame F-Main = entry(10, v-uf-List_, chr(4))
     3081             tog-5                     :screen-value in frame F-Main = entry(11, v-uf-List_, chr(4))
     3082             tog-6                     :screen-value in frame F-Main = entry(12, v-uf-List_, chr(4))
     3083             tog-7                     :screen-value in frame F-Main = entry(13, v-uf-List_, chr(4))
     3084             tog-8                     :screen-value in frame F-Main = entry(14, v-uf-List_, chr(4))
     3085             f-line-of-page            :screen-value in frame F-Main = entry(15, v-uf-List_, chr(4))
     3086             tog-9                     :screen-value in frame F-Main = entry(16, v-uf-List_, chr(4))
     3087             tog-10                    :screen-value in frame F-Main = entry(17, v-uf-List_, chr(4))
     3088           .
     3089         end.
     3090         if num-entries(v-uf-List_, chr(4)) >= 20 then do:
     3091           assign
     3092             tog-81  :screen-value in frame F-Main = entry(19, v-uf-List_, chr(4))
     3093             tog-82  :screen-value in frame F-Main = entry(20, v-uf-List_, chr(4))
     3094           .
     3095         end.
     3096         assign
     3097           v-init = true
     3098         .
     3099       end.
     3100       if v-init = false then do:
     3101         assign
     3102           tog-1     :screen-value in frame F-Main = 'yes':u
     3103           tog-2     :screen-value in frame F-Main = 'yes':u
     3104           tog-3     :screen-value in frame F-Main = 'yes':u
     3105           tog-4     :screen-value in frame F-Main = 'yes':u
     3106           tog-5     :screen-value in frame F-Main = 'yes':u
     3107           tog-6     :screen-value in frame F-Main = 'yes':u
     3108           tog-7     :screen-value in frame F-Main = 'yes':u
     3109           tog-8     :screen-value in frame F-Main = 'yes':u
     3110           tog-9     :screen-value in frame F-Main = 'yes':u
     3111           tog-10    :screen-value in frame F-Main = 'yes':u
     3112           tog-81    :screen-value in frame F-Main = 'yes':u
     3113           tog-82    :screen-value in frame F-Main = 'yes':u
     3114         .
     3115       end.
     3116       if integer( f-line-of-page :screen-value in frame F-Main ) = 0
     3117         or integer( f-line-of-page :screen-value in frame F-Main ) = ?
     3118       then do:
     3119         assign
     3120           f-line-of-page :screen-value in frame F-Main = '43':U
     3121         .
     3122       end.
     3123       assign
     3124         classify = "no-classify":u
     3125         var-level :screen-value in frame F-Main = '1':U
     3126       .
     3127       if is-wth = false then do:
     3128         assign
     3129           TOG-5 :screen-value in frame F-Main = 'no':u
     3130         .
     3131         hide tog-5 in frame F-Main.
     3132         enable TOG-5-1 with frame F-Main.
     3133       end.
     3134       if is-elved = false then do:
     3135         assign
     3136           tog-8 :screen-value in frame F-Main = 'no':u
     3137         .
     3138         hide tog-8 in frame F-Main.
     3139       end.
     3140       IF NOT CAN-FIND( FIRST obj-list WHERE obj-list.obj-code = v-cntxt-obj-code AND obj-list.obj-type = v-cntxt-obj-type ) THEN DO:
     3141   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3142   run create_obj-list in this-procedure
     3143    ( input v-cntxt-obj-type ,
     3144      input v-cntxt-obj-code )
     3145      .
     3146       END.
     3147       RUN ini-from-selgds IN THIS-PROCEDURE.
     3148       apply "value-changed":u to tog-1 in frame F-Main.
     3149       apply "value-changed":u to tog-2 in frame F-Main.
     3150       apply "value-changed":u to tog-3 in frame F-Main.
     3151       apply "value-changed":u to tog-81 in frame F-Main.
     3152     end.
     3153   end case.
     3154   END PROCEDURE.
     3155   PROCEDURE my-params :
     3156   define input parameter p-action as character no-undo .
     3157   DEFINE VARIABLE v-today as date no-undo .
     3158   DEFINE VARIABLE v-time as integer no-undo .
     3159   define variable v-obj-str as character no-undo .
     3160   define variable v-index-id as integer no-undo .
     3161   define variable v2-index-id as integer no-undo .
     3162   define variable v-value-character as character no-undo .
     3163   define variable v-value-date as date no-undo .
     3164   define variable v-value-decimal as decimal no-undo .
     3165   define variable v-value-integer as integer no-undo .
     3166   define variable v-value-logical as logical no-undo .
     3167   define variable v-last-shift as decimal no-undo .
     3168   define variable v-fact-order  as decimal no-undo .
     3169   define variable v-shift-end-fact-order as decimal no-undo .
     3170   define variable v-day-end-fact-order as decimal no-undo .
     3171   define variable v-rv as character no-undo .
     3172   CASE p-action :
     3173     WHEN 'get' THEN DO:
     3174       IF v-profile-id = 53  THEN DO:
     3175          v-index-id = 0.
     3176          RUN rcps_get-value IN parent-handle (
     3177                                             input "p-esys-id"
     3178                                            ,INPUT-output v-index-id
     3179                                            ,output v-value-character
     3180                                            ,output v-value-date
     3181                                            ,output v-value-decimal
     3182                                            ,output v-esys-id
     3183                                            ,output v-value-logical
     3184                                            ) no-error .
     3185          v-index-id = 0.
     3186          RUN rcps_get-value IN parent-handle (
     3187                                             input "p-shift-days-to-report"
     3188                                            ,INPUT-output v-index-id
     3189                                            ,output v-value-character
     3190                                            ,output v-value-date
     3191                                            ,output v-value-decimal
     3192                                            ,output v-shift-days-to-report
     3193                                            ,output v-value-logical
     3194                                            ) no-error .
     3195         empty temp-table X-init_obj-list.
     3196         v-index-id = 1.
     3197         v2-index-id = 1.
     3198         do while v-index-id >= 1 :
     3199           RUN rcps_get-value IN parent-handle (
     3200                                           input "p-objects"
     3201                                           ,INPUT-output v-index-id
     3202                                           ,output v-obj-str
     3203                                           ,output v-value-date
     3204                                           ,output v-value-decimal
     3205                                           ,output v-value-integer
     3206                                           ,output v-value-logical
     3207                                           ) no-error .
     3208           if error-status:error then leave.
     3209           if v-obj-str = '' then leave.
     3210           find first X-init_obj-list where
     3211                     X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
     3212                 and  X-init_obj-list.obj-code = integer(substring(v-obj-str, 4)) no-error.
     3213           if not available X-init_obj-list then do:
     3214             create X-init_obj-list.
     3215             assign
     3216             X-init_obj-list.obj-type = substring(v-obj-str, 1, 3)
     3217             X-init_obj-list.obj-code = integer(substring(v-obj-str, 4))
     3218             .
     3219             release X-init_obj-list.
     3220           end.
     3221           create last-shift.
     3222           assign
     3223           last-shift.obj-type = substring(v-obj-str, 1, 3)
     3224           last-shift.obj-code = integer(substring(v-obj-str, 4))
     3225           .
     3226           run cur-time in this-procedure ( output v-today, output v-time).
     3227           run factord in this-procedure
     3228             (input  (v-today - v-shift-days-to-report)
     3229             ,input  v-time
     3230             ,input  1
     3231             ,input  (v-today - v-shift-days-to-report)
     3232             ,input  1
     3233             ,input  yes
     3234             ,output v-fact-order
     3235             ,output v-shift-end-fact-order
     3236             ,output v-day-end-fact-order
     3237             ) no-error .
     3238           RUN rcps_get-value IN parent-handle (
     3239                                           input "last-shift"
     3240                                           ,INPUT-output v2-index-id
     3241                                           ,output v-value-character
     3242                                           ,output v-value-date
     3243                                           ,output v-last-shift
     3244                                           ,output v-value-integer
     3245                                           ,output v-value-logical
     3246                                           ) no-error .
     3247           if error-status:error
     3248           and v-last-shift > 0
     3249           then do:
     3250             last-shift.fact-order = v-last-shift .
     3251           end.
     3252           else do:
     3253             last-shift.fact-order = v-shift-end-fact-order.
     3254           end.
     3255           release last-shift.
     3256           if v-index-id < 1
     3257           then do:
     3258             leave.
     3259           end.
     3260         end.
     3261         X-selectobject =  "choice":U.
     3262       END.
     3263       IF v-profile-id = 68  THEN DO:
     3264         define variable v-ii as integer no-undo .
     3265         v-index-id = 0.
     3266         do v-ii = 1 to 9 :
     3267           v-index-id = v-ii.
     3268           RUN rcps_get-value IN parent-handle (
     3269                                           input "p-tog"
     3270                                           ,INPUT-output v-index-id
     3271                                           ,output v-value-character
     3272                                           ,output v-value-date
     3273                                           ,output v-value-decimal
     3274                                           ,output v-value-integer
     3275                                           ,output v-tog[v-ii]
     3276                                           ) no-error .
     3277           if error-status:error then leave.
     3278         end.
     3279         v-index-id = 0.
     3280         RUN rcps_get-value IN parent-handle (
     3281                                             input "p-weight"
     3282                                            ,INPUT-output v-index-id
     3283                                            ,output v-value-character
     3284                                            ,output v-value-date
     3285                                            ,output v-value-decimal
     3286                                            ,output v-value-integer
     3287                                            ,output v-weight
     3288                                            ) no-error .
     3289          v-index-id = 0.
     3290          RUN rcps_get-value IN parent-handle (
     3291                                             input "p-classify"
     3292                                            ,INPUT-output v-index-id
     3293                                            ,output v-classify
     3294                                            ,output v-value-date
     3295                                            ,output v-value-decimal
     3296                                            ,output v-value-integer
     3297                                            ,output v-value-logical
     3298                                            ) no-error .
     3299          v-index-id = 0.
     3300          RUN rcps_get-value IN parent-handle (
     3301                                             input "p-sorttype"
     3302                                            ,INPUT-output v-index-id
     3303                                            ,output v-sorttype
     3304                                            ,output v-value-date
     3305                                            ,output v-value-decimal
     3306                                            ,output v-value-integer
     3307                                            ,output v-value-logical
     3308                                            ) no-error .
     3309          v-index-id = 0.
     3310          RUN rcps_get-value IN parent-handle (
     3311                                             input "p-level"
     3312                                            ,INPUT-output v-index-id
     3313                                            ,output v-value-character
     3314                                            ,output v-value-date
     3315                                            ,output v-value-decimal
     3316                                            ,output v-level
     3317                                            ,output v-value-logical
     3318                                            ) no-error .
     3319          v-index-id = 0.
     3320          RUN rcps_get-value IN parent-handle (
     3321                                             input "p-pump-one"
     3322                                            ,INPUT-output v-index-id
     3323                                            ,output v-value-character
     3324                                            ,output v-value-date
     3325                                            ,output v-value-decimal
     3326                                            ,output v-value-integer
     3327                                            ,output v-pump-one
     3328                                            ) no-error .
     3329          v-index-id = 0.
     3330          RUN rcps_get-value IN parent-handle (
     3331                                             input "p-whole-gds"
     3332                                            ,INPUT-output v-index-id
     3333                                            ,output v-value-character
     3334                                            ,output v-value-date
     3335                                            ,output v-value-decimal
     3336                                            ,output v-value-integer
     3337                                            ,output v-whole-gds
     3338                                            ) no-error .
     3339          v-index-id = 0.
     3340          RUN rcps_get-value IN parent-handle (
     3341                                             input "p-el-cnt"
     3342                                            ,INPUT-output v-index-id
     3343                                            ,output v-value-character
     3344                                            ,output v-value-date
     3345                                            ,output v-value-decimal
     3346                                            ,output v-value-integer
     3347                                            ,output v-el-icnt
     3348                                            ) no-error .
     3349          v-index-id = 0.
     3350          RUN rcps_get-value IN parent-handle (
     3351                                             input "p-cp-grp"
     3352                                            ,INPUT-output v-index-id
     3353                                            ,output v-value-character
     3354                                            ,output v-value-date
     3355                                            ,output v-value-decimal
     3356                                            ,output v-value-integer
     3357                                            ,output v-cp-grp
     3358                                            ) no-error .
     3359          v-index-id = 0.
     3360          RUN rcps_get-value IN parent-handle (
     3361                                             input "p-output-type"
     3362                                            ,INPUT-output v-index-id
     3363                                            ,output v-output-type
     3364                                            ,output v-value-date
     3365                                            ,output v-value-decimal
     3366                                            ,output v-value-integer
     3367                                            ,output v-value-logical
     3368                                            ) no-error .
     3369          v-index-id = 0.
     3370          RUN rcps_get-value IN parent-handle (
     3371                                             input "p-line-of-page"
     3372                                            ,INPUT-output v-index-id
     3373                                            ,output v-value-character
     3374                                            ,output v-value-date
     3375                                            ,output v-value-decimal
     3376                                            ,output v-line-of-page
     3377                                            ,output v-value-logical
     3378                                            ) no-error .
     3379       END.
     3380       RUN local-initialize IN THIS-PROCEDURE.
     3381     END.
     3382     WHEN 'set' THEN DO:
     3383       IF v-profile-id = 53 THEN DO:
     3384         ASSIGN
     3385         FRAME F-Main
     3386         f-esys-id
     3387         f-shift-days-to-report
     3388         .
     3389         RUN rcps_set-value IN parent-handle (
     3390                                           input "p-esys-id"
     3391                                         ,INPUT 0
     3392                                         ,input ''
     3393                                         ,input ?
     3394                                         ,input 0.0
     3395                                         ,input f-esys-id
     3396                                         ,input no
     3397                                         ) no-error .
     3398         RUN rcps_set-value IN parent-handle (
     3399                                           input "p-shift-days-to-report"
     3400                                         ,INPUT 0
     3401                                         ,input ''
     3402                                         ,input ?
     3403                                         ,input 0.0
     3404                                         ,input f-shift-days-to-report
     3405                                         ,input no
     3406                                         ) no-error .
     3407         v-index-id = 0.
     3408         for each obj-list :
     3409           v-index-id = v-index-id + 1.
     3410           RUN rcps_set-value IN parent-handle (
     3411                                           input "p-objects"
     3412                                           ,INPUT v-index-id
     3413                                           ,input substitute("&1&2", obj-list.obj-type, obj-list.obj-code)
     3414                                           ,input ?
     3415                                           ,input 0.0
     3416                                           ,input 0
     3417                                           ,input no
     3418                                           ) no-error .
     3419           if error-status:error then do:
     3420             message
     3421             error-status:get-message(1) return-value
     3422             view-as alert-box .
     3423             undo, return error .
     3424           end.
     3425           find first last-shift where
     3426                     last-shift.obj-type = obj-list.obj-type
     3427                 and last-shift.obj-code = obj-list.obj-code no-error.
     3428           if available last-shift then do:
     3429             RUN rcps_set-value IN parent-handle (
     3430                                             input "p-last-shift"
     3431                                             ,INPUT v-index-id
     3432                                             ,input ''
     3433                                             ,input ?
     3434                                             ,input last-shift.fact-order
     3435                                             ,input 0
     3436                                             ,input no
     3437                                             ) no-error .
     3438           end.
     3439         end.
     3440         v-index-id = v-index-id + 1.
     3441         do while true:
     3442           run rcps_proc-b-del in parent-handle (
     3443                                                   input "p-objects"
     3444                                                 ,input v-index-id) no-error.
     3445           v-rv = return-value .
     3446           if error-status:error
     3447           or v-rv = "not-found" then leave.
     3448           run rcps_proc-b-del in parent-handle (
     3449                                                   input "p-last-shift"
     3450                                                 ,input v-index-id) no-error.
     3451           v-index-id = v-index-id + 1.
     3452         end.
     3453         if error-status:error then do:
     3454           message
     3455           error-status:get-message(1) return-value
     3456           view-as alert-box .
     3457           undo, return error .
     3458         end.
     3459       END.
     3460       IF v-profile-id = 68 THEN DO:
     3461         ASSIGN
     3462         FRAME F-Main
     3463         tog-weight
     3464         tog-1
     3465         tog-1-whole-gds
     3466         tog-1-pump-one
     3467         tog-2
     3468         tog-2-cp-grp
     3469         tog-3
     3470         tog-4
     3471         tog-5
     3472         tog-6
     3473         tog-7
     3474         tog-8
     3475         tog-9
     3476         tog-10
     3477         f-line-of-page
     3478         tog-1-out-pump-with-icnt
     3479         classify
     3480         var-level
     3481         t-excel
     3482         t-text
     3483         v-tog[1] = tog-1
     3484         v-tog[2] = tog-2
     3485         v-tog[3] = tog-3
     3486         v-tog[4] = tog-4
     3487         v-tog[5] = tog-5
     3488         v-tog[6] = tog-6
     3489         v-tog[7] = tog-7
     3490         v-tog[8] = tog-8
     3491         v-tog[9] = tog-9
     3492         v-tog[10] = tog-10
     3493         v-output-type = ","
     3494         ENTRY(1, v-output-type) = (IF t-excel THEN 'excel':U ELSE '')
     3495         ENTRY(2, v-output-type) = (IF t-text THEN 'text':U ELSE '')
     3496         v-output-type = TRIM(v-output-type, chr(44))
     3497         .
     3498         if not t-excel
     3499         and not t-text then do:
     3500           define variable glog as logical no-undo .
     3501           message
     3502           "Внимание!! Вы не выбрали ни вывод в текстовый файл, ни вывод в Excel!" skip
     3503           "Продолжить?"
     3504           view-as alert-box question buttons yes-no update glog.
     3505           if not glog then return error.
     3506         end.
     3507         do v-ii = 1 to 9 :
     3508           RUN rcps_set-value IN parent-handle (
     3509                                           input "p-tog"
     3510                                           ,INPUT v-ii
     3511                                           ,input ''
     3512                                           ,input ?
     3513                                           ,input 0.0
     3514                                           ,input 0
     3515                                           ,input v-tog[v-ii]
     3516                                           ) no-error .
     3517           if error-status:error then do:
     3518             message
     3519             error-status:get-message(1) return-value
     3520             view-as alert-box .
     3521             undo, return error .
     3522           end.
     3523         end.
     3524         RUN rcps_set-value IN parent-handle (
     3525                                           input "p-weight"
     3526                                         ,INPUT 0
     3527                                         ,input ''
     3528                                         ,input ?
     3529                                         ,input 0.0
     3530                                         ,input 0
     3531                                         ,input tog-weight
     3532                                         ) no-error .
     3533         RUN rcps_set-value IN parent-handle (
     3534                                           input "p-weight"
     3535                                         ,INPUT 0
     3536                                         ,input classify
     3537                                         ,input ?
     3538                                         ,input 0.0
     3539                                         ,input 0
     3540                                         ,input no
     3541                                         ) no-error .
     3542         RUN rcps_set-value IN parent-handle (
     3543                                           input "p-sorttype"
     3544                                         ,INPUT 0
     3545                                         ,input sorttype
     3546                                         ,input ?
     3547                                         ,input 0.0
     3548                                         ,input 0
     3549                                         ,input no
     3550                                         ) no-error .
     3551         RUN rcps_set-value IN parent-handle (
     3552                                           input "p-level"
     3553                                         ,INPUT 0
     3554                                         ,input ''
     3555                                         ,input ?
     3556                                         ,input 0.0
     3557                                         ,input var-level
     3558                                         ,input no
     3559                                         ) no-error .
     3560         RUN rcps_set-value IN parent-handle (
     3561                                           input "p-pump-one"
     3562                                         ,INPUT 0
     3563                                         ,input ''
     3564                                         ,input ?
     3565                                         ,input 0.0
     3566                                         ,input 0
     3567                                         ,input tog-1-pump-one
     3568                                         ) no-error .
     3569         RUN rcps_set-value IN parent-handle (
     3570                                           input "p-whole-gds"
     3571                                         ,INPUT 0
     3572                                         ,input ''
     3573                                         ,input ?
     3574                                         ,input 0.0
     3575                                         ,input 0
     3576                                         ,input tog-1-whole-gds
     3577                                         ) no-error .
     3578         RUN rcps_set-value IN parent-handle (
     3579                                           input "p-el-cnt"
     3580                                         ,INPUT 0
     3581                                         ,input ''
     3582                                         ,input ?
     3583                                         ,input 0.0
     3584                                         ,input 0
     3585                                         ,input tog-1-out-pump-with-icnt
     3586                                         ) no-error .
     3587         RUN rcps_set-value IN parent-handle (
     3588                                           input "p-cp-grp"
     3589                                         ,INPUT 0
     3590                                         ,input ''
     3591                                         ,input ?
     3592                                         ,input 0.0
     3593                                         ,input 0
     3594                                         ,input tog-2-cp-grp
     3595                                         ) no-error .
     3596         RUN rcps_set-value IN parent-handle (
     3597                                           input "p-output-type"
     3598                                         ,INPUT 0
     3599                                         ,input v-output-type
     3600                                         ,input ?
     3601                                         ,input 0.0
     3602                                         ,input 0
     3603                                         ,input no
     3604                                         ) no-error .
     3605         RUN rcps_set-value IN parent-handle (
     3606                                           input "p-line-of-page"
     3607                                         ,INPUT 0
     3608                                         ,input ''
     3609                                         ,input ?
     3610                                         ,input 0.0
     3611                                         ,input f-line-of-page
     3612                                         ,input no
     3613                                         ) no-error .
     3614       END.
     3615     END.
     3616   END CASE.
     3617   END PROCEDURE.
     3618   PROCEDURE my-report :
     3619   define variable v-base-code like ub.sysconf.base-code no-undo .
     3620   define buffer buf_currency for ub.currency.
     3621   define variable v_dataseth as handle no-undo .
     3622   define variable v-xmlh as handle no-undo .
     3623   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3624   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     3625     (input  v-cntxt-host-code-obj
     3626     ,output v-base-code
     3627     )  .
     3628     find first buf_currency no-lock
     3629       where buf_currency.curr-code = v-base-code
     3630     .
     3631     if place-call = "'new-rep'" then do:
     3632       run rep/r-new-shift.p
     3633         ( input my-handle
     3634          ,input this-procedure:handle
     3635          ,input this-procedure:handle
     3636          ,input this-procedure:handle
     3637          ,input this-procedure:handle
     3638          ,input ?
     3639          ,input ?
     3640          ,input ''
     3641          ,input ''
     3642          ,input ""
     3643          ,input integer('0':U)
     3644          ,input 0
     3645          ,input 0
     3646          ,INPUT v-cntxt-obj-code
     3647          ,INPUT v-cntxt-obj-type
     3648          ,INPUT buf_currency.curr-abbr
     3649          ,INPUT v-base-code
     3650          ,input f-line-of-page
     3651          ,input tog-weight
     3652          ,INPUT Classify
     3653          ,INPUT SortType
     3654          ,input tog-level
     3655          ,input var-level
     3656          ,INPUT tog-1
     3657          ,INPUT tog-2
     3658          ,input tog-3
     3659          ,input tog-4
     3660          ,input tog-5
     3661          ,INPUT TOG-5-1
     3662          ,input tog-6
     3663          ,input tog-7
     3664          ,input tog-81
     3665          ,input tog-82
     3666          ,input tog-9
     3667          ,input tog-10
     3668          ,input tog-1-pump-one
     3669          ,input tog-1-whole-gds
     3670          ,input tog-1-out-pump-with-icnt
     3671          ,input tog-2-cp-grp
     3672          ,input yes
     3673          ,input yes
     3674          ,input ''
     3675          ,input-output v_dataseth
     3676          ,input table temp-xml-tables
     3677         ) .
     3678     end.
     3679     else
     3680       run rep/r-shift.p
     3681         ( input my-handle
     3682          ,input this-procedure:handle
     3683          ,input this-procedure:handle
     3684          ,input this-procedure:handle
     3685          ,input this-procedure:handle
     3686          ,input ?
     3687          ,input ?
     3688          ,input ''
     3689          ,input ''
     3690          ,input ""
     3691          ,input integer('0':U)
     3692          ,input 0
     3693          ,input 0
     3694          ,INPUT v-cntxt-obj-code
     3695          ,INPUT v-cntxt-obj-type
     3696          ,INPUT buf_currency.curr-abbr
     3697          ,INPUT v-base-code
     3698          ,input f-line-of-page
     3699          ,input tog-weight
     3700          ,INPUT Classify
     3701          ,INPUT SortType
     3702          ,input tog-level
     3703          ,input var-level
     3704          ,INPUT tog-1
     3705          ,INPUT tog-2
     3706          ,input tog-3
     3707          ,input tog-4
     3708          ,input tog-5
     3709          ,input tog-6
     3710          ,input tog-7
     3711          ,input tog-8
     3712          ,input tog-9
     3713          ,input tog-10
     3714          ,input tog-1-pump-one
     3715          ,input tog-1-whole-gds
     3716          ,input tog-1-out-pump-with-icnt
     3717          ,input tog-2-cp-grp
     3718          ,input yes
     3719          ,input yes
     3720          ,input ''
     3721          ,input-output v_dataseth
     3722          ,input table temp-xml-tables
     3723         ) .
     3724   END PROCEDURE.
     3725   PROCEDURE my-var :
     3726   case v-profile-id:
     3727     when 53 THEN DO:
     3728       ASSIGN FRAME F-Main
     3729       f-esys-id
     3730       f-shift-days-to-report
     3731       .
     3732       ASSIGN STR-obj-type = ''
     3733             STR-obj-code = ''
     3734             STR-obj-name = ''
     3735             STR-obj      = ''.
     3736       FOR EACH obj-list NO-LOCK :
     3737         ASSIGN STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3738               STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3739               STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3740               STR-obj      = STR-obj      +         obj-list.obj-type   + '#'
     3741                                           + STRING( obj-list.obj-code ) + ',' .
     3742       END.
     3743       ASSIGN ReportHeader = substitute("&1Кол-во дней для расчета ни разу нерассчитанных  объектов: &2&1" +
     3744                                         "Маршрутизация во ВС: &3 &4"
     3745                                         , chr(10)
     3746                                         , f-shift-days-to-report
     3747                                         , F-ESYS-ID
     3748                                         , f-esys-name).
     3749       .
     3750     end.
     3751     when 68 or
     3752     when 0
     3753     then do:
     3754       ASSIGN FRAME F-Main
     3755         f-line-of-page tog-weight
     3756         tog-level var-level Classify
     3757         tog-1 tog-2 tog-3 tog-4 tog-6 tog-7 tog-8 tog-81 tog-82 tog-9 tog-10
     3758         tog-1-whole-gds tog-1-pump-one tog-1-out-pump-with-icnt tog-2-cp-grp
     3759         .
     3760       if is-wth then do:
     3761         assign
     3762           tog-5
     3763         .
     3764       end.
     3765       ELSE TOG-5-1.
     3766       ASSIGN STR-obj-type = ''
     3767             STR-obj-code = ''
     3768             STR-obj-name = ''
     3769             STR-obj      = ''.
     3770       FOR EACH obj-list NO-LOCK :
     3771         ASSIGN STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     3772               STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     3773               STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     3774               STR-obj      = STR-obj      +         obj-list.obj-type   + '#'
     3775                                           + STRING( obj-list.obj-code ) + ',' .
     3776       END.
     3777   def var t-class as char no-undo.
     3778   def var t-sort as char no-undo.
     3779     case classify:
     3780       when "no-classify":u    then t-class =   "Без классификации" .
     3781       when "prod":u           then t-class =   "Производители"   .
     3782       when "post":u           then t-class =   "Поставщики"   .
     3783       when "grp-goods":u      then t-class =   "Группы товаров"  .
     3784       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     3785       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     3786       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     3787       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     3788       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     3789       when  "sort":u          then t-class =   "Проба(Сорт)" .
     3790       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     3791       when  "t-level":u       then t-class =   "Терминальные группы" .
     3792    end case.
     3793     case sorttype:
     3794       when "sort-pp":u               then t-sort =   "по порядку" .
     3795       when "sort-code":u             then t-sort =   "по коду" .
     3796       when "sort-artic":u            then t-sort =   "по артикулу"  .
     3797       when "sort-qunty":u            then t-sort =   "по реализации".
     3798       when "sort-name":u             then t-sort =   "по наименованию".
     3799       when "sort-type":u             then t-sort =   "по типу ткани".
     3800       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     3801       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     3802    end case.
     3803       ASSIGN ReportHeader = "Классификация : " + t-Class +
     3804                             ( IF tog-3 = YES AND Classify = "n-level":U THEN STRING( var-level ) ELSE " " ) + chr(10) +
     3805                             "Сортировка " + t-Sort + chr(10)
     3806       .
     3807     end.
     3808   end case.
     3809   if not (place-call = 'schedule':U
     3810           or
     3811           place-call = 'rp-by-call':U) then do:
     3812     assign
     3813       v-uf-list_ = string( tog-weight )                 + chr(4)
     3814                   + string( tog-1-whole-gds )          + chr(4)
     3815                   + string( tog-1-pump-one )           + chr(4)
     3816                   + string( tog-2-cp-grp )             + chr(4)
     3817                   +  chr(4)
     3818                   +  chr(4)
     3819                   + string( tog-1 )                    + chr(4)
     3820                   + string( tog-2 )                    + chr(4)
     3821                   + string( tog-3 )                    + chr(4)
     3822                   + string( tog-4 )                    + chr(4)
     3823                   + string( tog-5 )                    + chr(4)
     3824                   + string( tog-6 )                    + chr(4)
     3825                   + string( tog-7 )                    + chr(4)
     3826                   + string( tog-8 )                    + chr(4)
     3827                   + string( f-line-of-page )           + chr(4)
     3828                   + string( tog-9 )                    + chr(4)
     3829                   + string( tog-10 )                   + chr(4)
     3830                   + string( tog-1-out-pump-with-icnt )  + chr(4)
     3831                   + string( tog-81 )                    + chr(4)
     3832                   + string( tog-82 )
     3833     .
     3834     run uf-set in this-procedure
     3835       ( input 'e-shift':U
     3836       ,input v-cntxt-userid
     3837       ,input v-uf-List_
     3838       ,input v-uf-Naim
     3839       ,input v-uf-print-graft
     3840       ,input v-uf-sort-gr
     3841       ,input v-uf-type-price
     3842       ,input v-uf-type-val
     3843       ) no-error .
     3844   end .
     3845   END PROCEDURE.
     3846   PROCEDURE state-changed :
     3847     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     3848     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     3849     CASE p-state :
     3850       WHEN "link-changed" THEN DO:
     3851           RUN ini-from-selgds IN THIS-PROCEDURE.
     3852       END.
     3853     END CASE.
     3854   END PROCEDURE.
     3855   PROCEDURE write-to-log :
     3856   define input param p-str as char no-undo.
     3857   do
     3858   on error undo, return error
     3859   :
     3860      message
     3861         p-str
     3862         skip
     3863      view-as alert-box error.
     3864   end.
     3865   END PROCEDURE.
