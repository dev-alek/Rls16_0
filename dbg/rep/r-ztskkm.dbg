      993   define variable v-waitfram-action01         as character   no-undo .
      994   define variable v-waitfram-action02         as character   no-undo .
      995   define variable v-waitfram-action03         as character   no-undo .
      996   define variable mWaitFramTextBeg            as character   no-undo.
      997   define variable mWaitFramTextEnd            as character   no-undo.
      998   define variable mWaitFramView               as logical     no-undo.
      999   define variable mWaitProcEvent              as logical     no-undo init yes.
     1000   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1001   define variable mWaitFramStop               as logical     no-undo.
     1002   define variable mWaitFramStopUser           as logical     no-undo.
     1003   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1004   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1005   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1006   define button B-WaitFramStop auto-end-key
     1007        label "Стоп"
     1008        size 10 by 1 tooltip "Остоновить процесс".
     1009   define button B-viewProcInfo
     1010        label "Информация"
     1011        size 15 by 1 tooltip "Информация о процесс".
     1012   define frame waitfram
     1013     v-waitfram-action01 format "x(72)" no-label skip
     1014     v-waitfram-action02 format "x(72)" no-label skip
     1015     v-waitfram-action03 format "x(72)" no-label skip
     1016     B-viewProcInfo
     1017     B-WaitFramStop at row 4 col 30
     1018     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1019     .
     1020   define new global shared variable mBatchMode as logical no-undo init ?.
     1021   define variable mFramBachModHandle as handle no-undo.
     1022   mFramBachModHandle = frame waitfram:handle.
     1023   define variable mFameOldVis as logical no-undo.
     1024   define variable mVisCUrentVin as logical no-undo.
     1025   if session:batch-mode
     1026   then
     1027      mBatchMode = yes.
     1028   if mBatchMode = ? then do:
     1029     mVisCUrentVin = current-window:visible.
     1030     mFameOldVis = mFramBachModHandle:visible.
     1031     mFramBachModHandle:visible  = yes.
     1032     mBatchMode = mFramBachModHandle:visible ne yes.
     1033     mFramBachModHandle:visible = mFameOldVis.
     1034     current-window:visible = mVisCUrentVin.
     1035   end.
     1036    if  log-manager:logfile-name ne ?
     1037     then DO:
     1038         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1039         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1040         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1041     end.
     1042   on choose of B-WaitFramStop in frame waitfram
     1043   do:
     1044     mWaitFramStop = yes.
     1045     mWaitFramStopUser = yes.
     1046   end.
     1047   function waitfram-check-timeout returns logical():
     1048      define variable vtime as int64 no-undo.
     1049      if mWaitFramStopTimeOut
     1050      then
     1051         return yes.
     1052      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1053      if     mWaitFramTimeOut ne ?
     1054         and mWaitFramTimeOut ne 0
     1055         and mWaitFramTimeOut lt vtime
     1056      then do:
     1057         mWaitFramStopTimeOut = yes.
     1058      end.
     1059      return mWaitFramStopTimeOut.
     1060   end.
     1061   procedure waitfram-hide :
     1062     if not session:batch-mode
     1063     then do
     1064     on error undo, return error return-value
     1065     :
     1066       pause 0 before-hide .
     1067       if not mBatchMode then
     1068         hide frame waitfram .
     1069     if     not mWaitFramView
     1070        and mWaitProcEvent
     1071     then
     1072       process events .
     1073     end.
     1074   end procedure.
     1075   procedure waitfram-show :
     1076     define input  parameter p-message as character no-undo .
     1077     define variable v-left-margin as integer   no-undo .
     1078     if not session:batch-mode
     1079     then do
     1080     on error undo, return error return-value
     1081     :
     1082       if length(p-message) <= 70 then do:
     1083         assign
     1084           v-left-margin = integer((70 - length(p-message)) / 2)
     1085         .
     1086         assign
     1087           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1088         .
     1089         assign
     1090           v-waitfram-action01 = " "
     1091           v-waitfram-action02 = " "
     1092                                    + fill(" ", v-left-margin)
     1093                                    + p-message
     1094           v-waitfram-action03 = " "
     1095         .
     1096       end.
     1097       else do:
     1098         define variable vRindex1 as integer no-undo.
     1099         define variable vRindex2 as integer no-undo.
     1100         vRindex1 = r-index(p-message," ",70).
     1101         if vRindex1 = 0
     1102         then
     1103            vRindex1 = 70.
     1104         if length(p-message)  <= vRindex1 + 70 then do:
     1105           assign
     1106             v-waitfram-action01 = " "
     1107             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1108             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1109           .
     1110         end.
     1111         else do:
     1112           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1113           if vRindex2 <= vRindex1
     1114           then
     1115              vRindex2 = vRindex1 + 70.
     1116           assign
     1117             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1118             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1119             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1120           .
     1121         end.
     1122       end.
     1123       B-viewProcInfo:visible   in frame waitfram = no.
     1124       B-viewProcInfo:sensitive in frame waitfram = no.
     1125       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1126       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1127       if  (   mWaitFramView
     1128          or  mWaitProcEvent)
     1129          and not mBatchMode
     1130       then
     1131          display
     1132             v-waitfram-action01 skip
     1133             v-waitfram-action02 skip
     1134             v-waitfram-action03 skip
     1135          with frame waitfram .
     1136       if     mWaitFramView
     1137          then do:
     1138             if     mWaitFramInterval ne ?
     1139                and not mBatchMode
     1140             then
     1141                wait-for go of frame waitfram pause mWaitFramInterval.
     1142          end.
     1143          else
     1144             if     mWaitProcEvent
     1145                and not mBatchMode
     1146             then
     1147                process events .
     1148     end.
     1149   end procedure.
     1150      procedure waitfram-show-this:
     1151         define input  parameter iInterval as int64 no-undo.
     1152         define variable vtime as int64 no-undo.
     1153         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1154         mWaitFramInterval = iInterval.
     1155         run waitfram-show (substitute("&1&2 &3&4" ,
     1156                                       mWaitFramTextBeg ,
     1157                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1158                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1159                                       mWaitFramTextEnd
     1160                                      )
     1161                           ).
     1162      end.
     1163      procedure WaitFramRunPause:
     1164         define input  parameter iInterval as dec no-undo.
     1165         define variable vStart  as datetime-tz no-undo.
     1166         define variable vend    as datetime-tz no-undo.
     1167         define variable vint as int64 no-undo.
     1168         define variable vOk as logical no-undo.
     1169         vStart = now.
     1170         vend   = vStart.
     1171         publish "WaitFramPause" (iInterval,output vOk).
     1172         vend   =  now.
     1173         vint = vend - vStart.
     1174         vint = iInterval - vint / 1000.
     1175         if     not mWaitFramStop
     1176            and (   vint > 0
     1177                 or (    not vOk
     1178                     and iInterval eq ?
     1179                     )
     1180                 )
     1181         then
     1182            run waitfram-show-this (iInterval).
     1183         vend   =  now.
     1184         vint = vend - vStart.
     1185         vint = iInterval - vint / 1000.
     1186         if     not mWaitFramStop
     1187            and vint > 0
     1188         then do:
     1189            run gbl/pause.p (vint * 1000).
     1190         end.
     1191         if iInterval ne ?
     1192         then
     1193            publish "WaitFramStop".
     1194         waitfram-check-timeout().
     1195      end.
     1196      procedure WaitFramWaitFor:
     1197         define input  parameter iInterval as dec no-undo.
     1198         assign
     1199            mWaitFramStartProc   = now
     1200            mWaitFramStopUser    = no
     1201            mWaitFramStopTimeOut = no
     1202         .
     1203         block-wait:
     1204         do while not mWaitFramStop:
     1205            run WaitFramRunPause (iInterval).
     1206            if  waitfram-check-timeout()
     1207            then do:
     1208               leave block-wait.
     1209            end.
     1210         end.
     1211         run waitfram-hide.
     1212      end.
     1213   procedure waitfram-join :
     1214     define input  parameter p-line-1  as character no-undo .
     1215     define input  parameter p-line-2  as character no-undo .
     1216     define input  parameter p-line-3  as character no-undo .
     1217     define output parameter p-message as character no-undo .
     1218     do
     1219     on error undo, return error return-value
     1220     :
     1221       assign
     1222         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1223                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1224                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1225       .
     1226     end.
     1227   end procedure.
     1228   function waitfram-join-function returns character
     1229     (input p-line-1 as character
     1230     ,input p-line-2 as character
     1231     ,input p-line-3 as character
     1232     ).
     1233     define variable v-message as character no-undo .
     1234     run waitfram-join in this-procedure
     1235       (input  p-line-1
     1236       ,input  p-line-2
     1237       ,input  p-line-3
     1238       ,output v-message
     1239       ) .
     1240     return v-message .
     1241   end function .
     1242   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1243   procedure sys-time_get-sys :
     1244     define output parameter p-year         as integer   no-undo .
     1245     define output parameter p-month        as integer   no-undo .
     1246     define output parameter p-day          as integer   no-undo .
     1247     define output parameter p-hour         as integer   no-undo .
     1248     define output parameter p-minute       as integer   no-undo .
     1249     define output parameter p-second       as integer   no-undo .
     1250     define output parameter p-milliseconds as integer   no-undo .
     1251     define variable v-system-time-structure as memptr    no-undo.
     1252     do
     1253     on error undo, return error return-value
     1254     :
     1255       assign
     1256         set-size(v-system-time-structure) = 16
     1257       .
     1258       run GetSystemTime
     1259         (input  get-pointer-value(v-system-time-structure)
     1260         ) .
     1261       assign
     1262         p-year         = get-short(v-system-time-structure,  1)
     1263         p-month        = get-short(v-system-time-structure,  3)
     1264         p-day          = get-short(v-system-time-structure,  7)
     1265         p-hour         = get-short(v-system-time-structure,  9)
     1266         p-minute       = get-short(v-system-time-structure, 11)
     1267         p-second       = get-short(v-system-time-structure, 13)
     1268         p-milliseconds = get-short(v-system-time-structure, 15)
     1269       .
     1270       assign
     1271         set-size(v-system-time-structure) = 0
     1272       .
     1273     end.
     1274   end procedure.
     1275   procedure sys-time_get-comp-user-name :
     1276     define output parameter p-computer-name as character no-undo .
     1277     define output parameter p-user-name     as character no-undo .
     1278     define output parameter p-process-pid   as integer   no-undo .
     1279     define variable v-return-value  as integer   no-undo .
     1280     define variable v-buffer-length as integer   no-undo .
     1281     define variable v-buffer-memptr as memptr    no-undo .
     1282     do
     1283     on error undo, return error return-value
     1284     :
     1285       assign
     1286         v-buffer-length = 1024
     1287         set-size(v-buffer-memptr) = v-buffer-length + 4
     1288       .
     1289       assign
     1290         put-long(v-buffer-memptr, 1) = v-buffer-length
     1291       .
     1292       run GetComputerNameA
     1293         (input  get-pointer-value(v-buffer-memptr) + 4
     1294         ,input  get-pointer-value(v-buffer-memptr)
     1295         ,output v-return-value
     1296         ) .
     1297       if v-return-value <> 0
     1298       then do:
     1299         assign
     1300           p-computer-name = get-string(v-buffer-memptr, 5)
     1301         .
     1302       end.
     1303       assign
     1304         put-long(v-buffer-memptr, 1) = v-buffer-length
     1305       .
     1306       run GetUserNameA
     1307         (input  get-pointer-value(v-buffer-memptr) + 4
     1308         ,input  get-pointer-value(v-buffer-memptr)
     1309         ,output v-return-value
     1310         ) .
     1311       if v-return-value <> 0
     1312       then do:
     1313         assign
     1314           p-user-name = get-string(v-buffer-memptr, 5)
     1315         .
     1316       end.
     1317       run GetCurrentProcessId
     1318         (output p-process-pid
     1319         ) .
     1320       assign
     1321         set-size(v-buffer-memptr) = 0
     1322       .
     1323     end.
     1324   end procedure.
     1325   procedure sys-time_get-http :
     1326     define output parameter p-http-time as character no-undo .
     1327     define variable v-year         as integer   no-undo .
     1328     define variable v-month        as integer   no-undo .
     1329     define variable v-day-of-week  as integer   no-undo .
     1330     define variable v-day          as integer   no-undo .
     1331     define variable v-hour         as integer   no-undo .
     1332     define variable v-minute       as integer   no-undo .
     1333     define variable v-second       as integer   no-undo .
     1334     define variable v-milliseconds as integer   no-undo .
     1335     do
     1336     on error undo, return error return-value
     1337     :
     1338       run sys-time_get-sys in this-procedure
     1339         (output v-year
     1340         ,output v-month
     1341         ,output v-day
     1342         ,output v-hour
     1343         ,output v-minute
     1344         ,output v-second
     1345         ,output v-milliseconds
     1346         ) .
     1347       assign
     1348         v-day-of-week = weekday(date(v-month, v-day, v-year))
     1349         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     1350                     + ', ':u
     1351                     + string(v-day, '99':u)
     1352                     + ' ':u
     1353                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     1354                     + ' ':u
     1355                     + string(v-year, '9999':u)
     1356                     + ' ':u
     1357                     + string(v-hour, '99':u)
     1358                     + ':':u
     1359                     + string(v-minute, '99':u)
     1360                     + ':':u
     1361                     + string(v-second, '99':u)
     1362                     + ' ':u
     1363                     + 'GMT':u
     1364       .
     1365     end.
     1366   end procedure.
     1367   procedure sys-time_set-sys :
     1368     define input  parameter p-year         as integer   no-undo .
     1369     define input  parameter p-month        as integer   no-undo .
     1370     define input  parameter p-day          as integer   no-undo .
     1371     define input  parameter p-hour         as integer   no-undo .
     1372     define input  parameter p-minute       as integer   no-undo .
     1373     define input  parameter p-second       as integer   no-undo .
     1374     define input  parameter p-milliseconds as integer   no-undo .
     1375     define variable v-system-time-structure as memptr    no-undo.
     1376     define variable v-return-value as integer   no-undo .
     1377     define variable v-day-of-week  as integer   no-undo .
     1378     do
     1379     on error undo, return error return-value
     1380     :
     1381       assign
     1382         v-day-of-week = weekday(date(p-month, p-day, p-year))
     1383       .
     1384       assign
     1385         set-size(v-system-time-structure) = 16
     1386       .
     1387       assign
     1388         put-short(v-system-time-structure,  1) = p-year
     1389         put-short(v-system-time-structure,  3) = p-month
     1390         put-short(v-system-time-structure,  5) = v-day-of-week
     1391         put-short(v-system-time-structure,  7) = p-day
     1392         put-short(v-system-time-structure,  9) = p-hour
     1393         put-short(v-system-time-structure, 11) = p-minute
     1394         put-short(v-system-time-structure, 13) = p-second
     1395         put-short(v-system-time-structure, 15) = p-milliseconds
     1396       .
     1397       run SetSystemTime
     1398         (input  get-pointer-value(v-system-time-structure)
     1399         ,output v-return-value
     1400         ) .
     1401       assign
     1402         set-size(v-system-time-structure) = 0
     1403       .
     1404       if v-return-value = 0
     1405       then do:
     1406         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1407       end.
     1408     end.
     1409   end procedure.
     1410   procedure sys-time_sys-to-mjd :
     1411     define input  parameter p-year         as integer   no-undo .
     1412     define input  parameter p-month        as integer   no-undo .
     1413     define input  parameter p-day          as integer   no-undo .
     1414     define input  parameter p-hour         as integer   no-undo .
     1415     define input  parameter p-minute       as integer   no-undo .
     1416     define input  parameter p-second       as integer   no-undo .
     1417     define input  parameter p-milliseconds as integer   no-undo .
     1418     define output parameter p-mjd          as decimal   no-undo .
     1419     define variable v-year-correction as decimal   no-undo .
     1420     define variable v-shift-year as decimal   no-undo .
     1421     do
     1422     on error undo, return error return-value
     1423     :
     1424       assign
     1425         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     1426         v-shift-year      = decimal(p-year) + v-year-correction
     1427         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     1428               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     1429               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     1430               + decimal(p-day) - 2432076.0
     1431               + p-hour / 24.0
     1432               + p-minute / 1440.0
     1433               + p-second / 86400.0
     1434               + p-milliseconds / 86400000.0
     1435       .
     1436     end.
     1437   end procedure.
     1438   procedure sys-time_sys-to-loc :
     1439     define input  parameter p-sys-year         as integer   no-undo .
     1440     define input  parameter p-sys-month        as integer   no-undo .
     1441     define input  parameter p-sys-day          as integer   no-undo .
     1442     define input  parameter p-sys-hour         as integer   no-undo .
     1443     define input  parameter p-sys-minute       as integer   no-undo .
     1444     define input  parameter p-sys-second       as integer   no-undo .
     1445     define input  parameter p-sys-milliseconds as integer   no-undo .
     1446     define output parameter p-loc-year         as integer   no-undo .
     1447     define output parameter p-loc-month        as integer   no-undo .
     1448     define output parameter p-loc-day          as integer   no-undo .
     1449     define output parameter p-loc-hour         as integer   no-undo .
     1450     define output parameter p-loc-minute       as integer   no-undo .
     1451     define output parameter p-loc-second       as integer   no-undo .
     1452     define output parameter p-loc-milliseconds as integer   no-undo .
     1453     define variable v-system-time-structure as memptr    no-undo.
     1454     define variable v-return-value          as integer   no-undo .
     1455     define variable v-sys-day-of-week       as integer   no-undo .
     1456     do
     1457     on error undo, return error return-value
     1458     :
     1459       assign
     1460         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     1461       .
     1462       assign
     1463         set-size(v-system-time-structure) = 32
     1464       .
     1465       assign
     1466         put-short(v-system-time-structure,  1) = p-sys-year
     1467         put-short(v-system-time-structure,  3) = p-sys-month
     1468         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     1469         put-short(v-system-time-structure,  7) = p-sys-day
     1470         put-short(v-system-time-structure,  9) = p-sys-hour
     1471         put-short(v-system-time-structure, 11) = p-sys-minute
     1472         put-short(v-system-time-structure, 13) = p-sys-second
     1473         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     1474       .
     1475       run SystemTimeToTzSpecificLocalTime
     1476         (input  0
     1477         ,input  get-pointer-value(v-system-time-structure)
     1478         ,input  get-pointer-value(v-system-time-structure) + 16
     1479         ,output v-return-value
     1480         ) .
     1481       assign
     1482         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     1483         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     1484         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     1485         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     1486         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     1487         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     1488         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     1489       .
     1490       assign
     1491         set-size(v-system-time-structure) = 0
     1492       .
     1493       if v-return-value = 0
     1494       then do:
     1495         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     1496       end.
     1497     end.
     1498   end procedure.
     1499   procedure sys-time_mjd-to-sys :
     1500     define input  parameter p-mjd          as decimal   no-undo .
     1501     define output parameter p-year         as integer   no-undo .
     1502     define output parameter p-month        as integer   no-undo .
     1503     define output parameter p-day          as integer   no-undo .
     1504     define output parameter p-hour         as integer   no-undo .
     1505     define output parameter p-minute       as integer   no-undo .
     1506     define output parameter p-second       as integer   no-undo .
     1507     define output parameter p-milliseconds as integer   no-undo .
     1508     define variable v-year-correction as decimal   no-undo .
     1509     define variable v-shift-year      as decimal   no-undo .
     1510     define variable v-conv-date     as date      no-undo .
     1511     define variable v-int-part      as integer   no-undo .
     1512     define variable v-fraction-part as decimal   no-undo .
     1513     do
     1514     on error undo, return error return-value
     1515     :
     1516       assign
     1517         v-int-part      = integer(truncate(p-mjd, 0))
     1518         v-fraction-part = p-mjd - v-int-part
     1519         v-conv-date     = date(11, 17, 1858) + v-int-part
     1520         p-year          = year(v-conv-date)
     1521         p-month         = month(v-conv-date)
     1522         p-day           = day(v-conv-date)
     1523         v-fraction-part = v-fraction-part * 24.0
     1524         p-hour          = integer(truncate(v-fraction-part, 0))
     1525         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     1526         p-minute        = integer(truncate(v-fraction-part, 0))
     1527         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     1528         p-second        = integer(truncate(v-fraction-part, 0))
     1529         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     1530         p-milliseconds  = integer(v-fraction-part)
     1531       .
     1532     end.
     1533   end procedure.
     1534   procedure sys-time_mjd-to-loc :
     1535     define input  parameter p-mjd              as decimal   no-undo .
     1536     define output parameter p-loc-year         as integer   no-undo .
     1537     define output parameter p-loc-month        as integer   no-undo .
     1538     define output parameter p-loc-day          as integer   no-undo .
     1539     define output parameter p-loc-hour         as integer   no-undo .
     1540     define output parameter p-loc-minute       as integer   no-undo .
     1541     define output parameter p-loc-second       as integer   no-undo .
     1542     define output parameter p-loc-milliseconds as integer   no-undo .
     1543     define variable v-sys-year         as integer   no-undo .
     1544     define variable v-sys-month        as integer   no-undo .
     1545     define variable v-sys-day          as integer   no-undo .
     1546     define variable v-sys-hour         as integer   no-undo .
     1547     define variable v-sys-minute       as integer   no-undo .
     1548     define variable v-sys-second       as integer   no-undo .
     1549     define variable v-sys-milliseconds as integer   no-undo .
     1550     do
     1551     on error undo, return error return-value
     1552     :
     1553       run sys-time_mjd-to-sys
     1554         (input  p-mjd
     1555         ,output v-sys-year
     1556         ,output v-sys-month
     1557         ,output v-sys-day
     1558         ,output v-sys-hour
     1559         ,output v-sys-minute
     1560         ,output v-sys-second
     1561         ,output v-sys-milliseconds
     1562         ) .
     1563       run sys-time_sys-to-loc
     1564         (input  v-sys-year
     1565         ,input  v-sys-month
     1566         ,input  v-sys-day
     1567         ,input  v-sys-hour
     1568         ,input  v-sys-minute
     1569         ,input  v-sys-second
     1570         ,input  v-sys-milliseconds
     1571         ,output p-loc-year
     1572         ,output p-loc-month
     1573         ,output p-loc-day
     1574         ,output p-loc-hour
     1575         ,output p-loc-minute
     1576         ,output p-loc-second
     1577         ,output p-loc-milliseconds
     1578         ) .
     1579     end.
     1580   end procedure.
     1581   function sys-time_get-mjd-func returns decimal
     1582   :
     1583     define variable v-year         as integer   no-undo .
     1584     define variable v-month        as integer   no-undo .
     1585     define variable v-day          as integer   no-undo .
     1586     define variable v-hour         as integer   no-undo .
     1587     define variable v-minute       as integer   no-undo .
     1588     define variable v-second       as integer   no-undo .
     1589     define variable v-milliseconds as integer   no-undo .
     1590     define variable v-mjd          as decimal   no-undo .
     1591     run sys-time_get-sys in this-procedure
     1592       (output v-year
     1593       ,output v-month
     1594       ,output v-day
     1595       ,output v-hour
     1596       ,output v-minute
     1597       ,output v-second
     1598       ,output v-milliseconds
     1599       ) .
     1600     run sys-time_sys-to-mjd in this-procedure
     1601       (input  v-year
     1602       ,input  v-month
     1603       ,input  v-day
     1604       ,input  v-hour
     1605       ,input  v-minute
     1606       ,input  v-second
     1607       ,input  v-milliseconds
     1608       ,output v-mjd
     1609       ) .
     1610     return v-mjd .
     1611   end function .
     1612   function sys-time_get-sys-str-func returns character
     1613   :
     1614     define variable v-utc-time as character no-undo .
     1615     define variable v-year         as integer   no-undo .
     1616     define variable v-month        as integer   no-undo .
     1617     define variable v-day          as integer   no-undo .
     1618     define variable v-hour         as integer   no-undo .
     1619     define variable v-minute       as integer   no-undo .
     1620     define variable v-second       as integer   no-undo .
     1621     define variable v-milliseconds as integer   no-undo .
     1622     run sys-time_get-sys in this-procedure
     1623       (output v-year
     1624       ,output v-month
     1625       ,output v-day
     1626       ,output v-hour
     1627       ,output v-minute
     1628       ,output v-second
     1629       ,output v-milliseconds
     1630       ) .
     1631     assign
     1632       v-utc-time  = 'UTC ':u
     1633                   + string(v-year,         '9999':u)
     1634                   + '/':u
     1635                   + string(v-month,        '99':u)
     1636                   + '/':u
     1637                   + string(v-day,          '99':u)
     1638                   + ' ':u
     1639                   + string(v-hour,         '99':u)
     1640                   + ':':u
     1641                   + string(v-minute,       '99':u)
     1642                   + ':':u
     1643                   + string(v-second,       '99':u)
     1644                   + ' ':u
     1645                   + string(v-milliseconds, '999':u)
     1646     .
     1647     return v-utc-time.
     1648   end function .
     1649   function sys-time_mjd-to-loc-str-func returns character
     1650     (v-sys-mjd as decimal)
     1651   :
     1652     define variable v-loc-str          as character no-undo .
     1653     define variable v-loc-year         as integer   no-undo .
     1654     define variable v-loc-month        as integer   no-undo .
     1655     define variable v-loc-day          as integer   no-undo .
     1656     define variable v-loc-hour         as integer   no-undo .
     1657     define variable v-loc-minute       as integer   no-undo .
     1658     define variable v-loc-second       as integer   no-undo .
     1659     define variable v-loc-milliseconds as integer   no-undo .
     1660     run sys-time_mjd-to-loc in this-procedure
     1661       (input  v-sys-mjd
     1662       ,output v-loc-year
     1663       ,output v-loc-month
     1664       ,output v-loc-day
     1665       ,output v-loc-hour
     1666       ,output v-loc-minute
     1667       ,output v-loc-second
     1668       ,output v-loc-milliseconds
     1669       ) .
     1670     assign
     1671       v-loc-str = substitute('&1/&2/&3 &4:&5'
     1672                             ,string(v-loc-day,    '99':U)
     1673                             ,string(v-loc-month,  '99':U)
     1674                             ,string(v-loc-year,   '9999':U)
     1675                             ,string(v-loc-hour,   '99':U)
     1676                             ,string(v-loc-minute, '99':U)
     1677                             )
     1678     .
     1679     return v-loc-str .
     1680   end function .
     1681   PROCEDURE GetSystemTime EXTERNAL "kernel32.dll"
     1682   :
     1683     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1684   END PROCEDURE.
     1685   PROCEDURE SetSystemTime EXTERNAL "kernel32.dll"
     1686   :
     1687     DEFINE INPUT  PARAMETER lpSystemTime AS LONG .
     1688     DEFINE RETURN PARAMETER ReturnValue  AS LONG .
     1689   END PROCEDURE.
     1690   PROCEDURE GetTimeZoneInformation EXTERNAL "kernel32.dll"
     1691   :
     1692     DEFINE INPUT  PARAMETER lpTimeZoneInformation AS LONG .
     1693     DEFINE RETURN PARAMETER ReturnValue           AS LONG .
     1694   END PROCEDURE.
     1695   PROCEDURE SystemTimeToTzSpecificLocalTime EXTERNAL "kernel32.dll"
     1696   :
     1697     DEFINE INPUT  PARAMETER lpTimeZone      AS LONG .
     1698     DEFINE INPUT  PARAMETER lpUniversalTime AS LONG .
     1699     DEFINE INPUT  PARAMETER lpLocalTime     AS LONG .
     1700     DEFINE RETURN PARAMETER ReturnValue     AS LONG .
     1701   END PROCEDURE.
     1702   PROCEDURE GetUserNameA EXTERNAL "advapi32.dll"
     1703   :
     1704     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1705     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1706     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1707   END PROCEDURE.
     1708   PROCEDURE GetComputerNameA EXTERNAL "kernel32.dll"
     1709   :
     1710     DEFINE INPUT  PARAMETER lpBuffer    AS LONG .
     1711     DEFINE INPUT  PARAMETER lpnSize     AS LONG .
     1712     DEFINE RETURN PARAMETER ReturnValue AS LONG .
     1713   END PROCEDURE.
     1714   PROCEDURE GetCurrentProcessId EXTERNAL "kernel32.dll"
     1715   :
     1716     DEFINE RETURN PARAMETER RetVal          AS LONG.
     1717   END PROCEDURE.
     1718   define buffer buf_clients         for ub.clients .
     1719   define variable v-file-name-rep-htm as character no-undo.
     1720   define variable var-report-num as int no-undo.
     1721   define variable varhost-code  like ub.trn-doc.host-code  no-undo.
     1722   define variable v-host-name   as character               no-undo.
     1723   define variable v-obj-name    as character               no-undo.
     1724   define variable var-prev-shift-date like ub.shift-obj.shift-date no-undo.
     1725   define variable var-prev-shift-num like ub.shift-obj.shift-num   no-undo.
     1726   define variable var-shift-staff   like ub.shift-staff.name       no-undo.
     1727   define stream OutStr-html.
     1728   find first buf_clients no-lock
     1729     where buf_clients.obj-type = parobj-type
     1730       and buf_clients.obj-code = parobj-code
     1731     .
     1732   assign
     1733     v-obj-name = buf_clients.obj-name
     1734   .
     1735   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1736   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1737     (input  parobj-type
     1738     ,input  parobj-code
     1739     ,output varhost-code
     1740     )  .
     1741   find first buf_clients no-lock
     1742     where buf_clients.obj-type = 'орг':U
     1743       and buf_clients.obj-code = varhost-code
     1744     .
     1745   assign
     1746     v-host-name = buf_clients.obj-name
     1747   .
     1748       run get-report-num in parParentProc (
     1749       output var-report-num
     1750           ).
     1751           v-file-name-rep-htm = session:temp-directory + "rpt" + string(var-report-num) + ".html".
     1752               output to value(v-file-name-rep-htm).
     1753               output close.
     1754    def var v-first-time as int no-undo.
     1755    def var v-first-date as date no-undo.
     1756    def var v-last-date as date no-undo.
     1757    def var v-last-time as int no-undo.
     1758         output stream OutStr-html to value(v-file-name-rep-htm) convert target 'UTF-8' .
     1759         put stream OutStr-html unformatted
     1760           substitute ('
     1761           <!DOCTYPE HTML>
     1762                 <html>
     1763                 <meta charset="UTF-8">
     1764                 <head>
     1765                       <!-- Стили документа -->
     1766                   <style>
     1767                        table ~{
     1768                            border-collapse: collapse; 
     1769                        ~}
     1770                        tbody td, th ~{
     1771                            border: 1px solid black;
     1772                            border-collapse: collapse;
     1773                      height: 14px;
     1774                        ~}
     1775                   </style> 
     1776                   
     1777                   </head> 
     1778                   
     1779                     <body> 
     1780                      
     1781                       <table orientation="landscape" name = "Отчет по анализу длительности" fit_to_page="true">  <!-- таблица, в которой содержится весь отчет -->
     1782                         <thead>  <!-- Шапка отчета -->
     1783                         <!-- Обязательно создаётся строка таблицы, в которой находятся размеры колонок в px-->
     1784                           <tr class="set_columns">
     1785                             <td style="width:260px"></td>
     1786                             <td style="width:180px"></td>
     1787                             <td style="width:220px"></td>
     1788                             <td style="width:85px"></td>
     1789                             <td style="width:85px"></td>
     1790                             <td style="width:250px"></td>
     1791                             <td style="width:250px"></td>
     1792                             <td style="width:50px"></td>
     1793                             <td style="width:50px"></td>
     1794                         </tr>
     1795                         <tr>
     1796                           <td colspan="9"></td>
     1797                         </tr>
     1798                         <tr style="height:30px;">  
     1799                           <td colspan="9">Отчет по анализу длительности</td>
     1800                         </tr>  
     1801                         <tr style="height:30px;">  
     1802                           <td colspan="9"></td>
     1803                         </tr>  
     1804                         <tr>
     1805                           <td colspan="1"> Фирма </td>
     1806                           <td colspan="8">&1</td>
     1807                         </tr>
     1808                         <tr>
     1809                           <td colspan="1" > Период </td>
     1810                           <td colspan="8" > с &3 по &4</td>
     1811                         </tr>
     1812                         <tr>
     1813                           <td colspan="1"> Фильтры </td>
     1814                           <td colspan="8"></td>
     1815                         </tr>          
     1816                         <tr>
     1817                           <td colspan="1"> Порог </td>
     1818                           <td colspan="8"> &5 </td>
     1819                         </tr>          
     1820                         <tr>
     1821                           <td colspan="1"> Типы касс </td>
     1822                           <td colspan="8"> &6 </td>
     1823                         </tr>          
     1824                       </thead>
     1825                 <tbody> <!-- Здесь начинается таблица отчета -->
     1826                                           <tr bgcolor="#C6E0B4">
     1827                                                           <!-- Первые строки – шапка таблицы с тэгами tr -->
     1828                                                           <th rowspan="1" style="text-align: center;">Наименование объекта</th>
     1829                                                           <th rowspan="1" style="text-align: center;">Дата</th>
     1830                                                           <th rowspan="1" colspan="7"  style="text-align: center;">Простой реализации на АЗК/АЗС</th>
     1831                                                   </tr>
     1832                                                   
     1833                                                   <tr bgcolor="#C6E0B4">
     1834                                                           <th style="text-align: center;"></th>
     1835                                                           <th style="text-align: center;"></th>
     1836                                                           <th style="text-align: center;"></th>
     1837                                                           <th colspan="2" style="text-align: center;">Сверка</th>
     1838                                                           <th colspan="4" style="text-align: center;"></th>
     1839                                                   </tr>
     1840                                                   <tr bgcolor="#C6E0B4">
     1841                                                           <th style="text-align: center;">Номер кассы</th>
     1842                                                           <th style="text-align: center;">Тип кассы</th>
     1843                                                           <th style="text-align: center;">Старший смены</th>
     1844                                                           <th style="text-align: center;">Дата/время</th>
     1845                                                           <th style="text-align: center;">Номер</th>
     1846                                                           <th style="text-align: center;">Время чека закрытия смены</th>
     1847                                                           <th style="text-align: center;">Время чека открытия смены</th>
     1848                                                           <th style="text-align: center;">Длительность закрытия тех.</th>
     1849                                                           <th style="text-align: center;">Время превышения</th>
     1850                                                   </tr>'
     1851                   ,
     1852                   string(v-host-name),
     1853                   string(v-obj-name),
     1854                                   string(x-Date-Start, "99.99.9999") ,
     1855                   string(X-date-End, "99.99.9999"),
     1856                   porog-zn,
     1857                   type-pos
     1858           ).
     1859   DEFINE TEMP-TABLE tt-peresmen NO-UNDO
     1860           FIELD ob-type               LIKE  chk-doc.obj-type
     1861           FIELD ob-code               like  chk-doc.obj-code
     1862           FIELD name-azs              as character
     1863           FIELD kassa                 LIKE  chk-doc.pay-desk
     1864           FIELD kassir                like  chk-doc.cashier
     1865           FIELD kassir2               like  chk-doc.cashier-psn-code
     1866       FIELD shift-num             like  chk-doc.shift-num
     1867       FIELD shift-date            like  chk-doc.shift-date
     1868       FIELD peresm-date           like  chk-doc.chk-date
     1869       FIELD sver-date             like  chk-doc.chk-date
     1870       FIELD shift-time-beg        like  chk-doc.chk-time
     1871       FIELD shift-time-end        like  chk-doc.chk-time
     1872       FIELD time-p                AS INT
     1873           FIELD npp                   AS INT
     1874           FIELD shift-name            like  chk-doc.shift-name
     1875       FIELD flg                   AS INT
     1876       INDEX pi AS UNIQUE PRIMARY  ob-code peresm-date npp
     1877    .
     1878   DEFINE TEMP-TABLE tt-tr NO-UNDO
     1879       FIELD npp               AS INT
     1880           FIELD td_1              as character
     1881           FIELD td_2              as character
     1882           FIELD td_3              as character
     1883           FIELD td_4              as character
     1884           FIELD td_5              as character
     1885           FIELD td_6              as character
     1886           FIELD td_7              as character
     1887       FIELD td_8              as character
     1888       FIELD td_9              as character
     1889       INDEX pi AS UNIQUE PRIMARY npp
     1890    .
     1891   DEFINE VARIABLE shift-date_old as DATE    no-undo.
     1892   DEFINE VARIABLE nom_p as int init 0      NO-UNDO.
     1893    FOR EACH obj-list  NO-LOCK:
     1894           FOR EACH chk-doc WHERE  chk-doc.obj-code = obj-list.obj-code
     1895                               AND chk-doc.chk-date <= x-Date-End
     1896                           AND chk-doc.chk-date >= x-Date-Start
     1897                                                   AND     (chk-doc.chk-type = 13 OR chk-doc.chk-type = 40)
     1898                           NO-LOCK BY chk-doc.chk-num :
     1899                           IF chk-doc.chk-type = 13 THEN DO:
     1900               shift-date_old = chk-doc.chk-date.
     1901                   FIND FIRST cash-desk WHERE cash-desk.obj-code = chk-doc.obj-code AND cash-desk.cash-num = chk-doc.pay-desk no-lock no-error.
     1902                   IF   cash-desk.pos-type  =  type-pos OR  type-pos = 'Все' THEN DO:
     1903                   CREATE tt-peresmen.
     1904                   ASSIGN
     1905                   tt-peresmen.ob-code = chk-doc.obj-code
     1906                   tt-peresmen.kassa = chk-doc.pay-desk
     1907                   tt-peresmen.shift-time-beg = chk-doc.chk-time
     1908                   tt-peresmen.shift-name = chk-doc.shift-name
     1909                   tt-peresmen.sver-date = chk-doc.chk-date
     1910                   .
     1911                   END.
     1912               END.
     1913                           ELSE IF chk-doc.chk-type = 40 AND AVAILABLE(tt-peresmen)
     1914               AND tt-peresmen.ob-code = chk-doc.obj-code
     1915                                                         AND tt-peresmen.kassa = chk-doc.pay-desk
     1916                                             AND shift-date_old = chk-doc.chk-date
     1917                           THEN DO:
     1918                           nom_p = nom_p + 1.
     1919                           ASSIGN
     1920               tt-peresmen.shift-time-end = chk-doc.chk-time
     1921               tt-peresmen.time-p = tt-peresmen.shift-time-end - tt-peresmen.shift-time-beg
     1922                           tt-peresmen.shift-date = chk-doc.shift-date
     1923               tt-peresmen.peresm-date = chk-doc.chk-date
     1924               tt-peresmen.shift-num = chk-doc.shift-num
     1925                           tt-peresmen.npp = nom_p
     1926                           tt-peresmen.name-azs =  obj-list.obj-name
     1927                           tt-peresmen.kassir = chk-doc.cashier
     1928                           tt-peresmen.kassir2 = chk-doc.cashier-psn-code
     1929               tt-peresmen.flg = 1
     1930               .
     1931                           END.
     1932           END.
     1933   END.
     1934   DEFINE VARIABLE itog-time AS INT NO-UNDO.
     1935   DEFINE VARIABLE itog-time-ob AS INT NO-UNDO init 0.
     1936   DEFINE VARIABLE itog-time-date AS INT NO-UNDO init 0.
     1937   DEFINE VARIABLE time-prev AS int NO-UNDO init 0.
     1938   DEFINE VARIABLE itog-time-prev AS int NO-UNDO init 0.
     1939   DEFINE VARIABLE itog-prev-all AS int NO-UNDO init 0.
     1940   DEFINE VARIABLE ob-code2 AS int NO-UNDO init 0.
     1941   DEFINE VARIABLE name-azs2 AS CHARACTER NO-UNDO.
     1942   DEFINE VARIABLE manager AS CHARACTER NO-UNDO.
     1943   DEFINE VARIABLE num_sver AS CHARACTER NO-UNDO.
     1944   DEFINE VARIABLE date_sver AS CHARACTER NO-UNDO.
     1945   DEFINE VARIABLE date_it AS DATE NO-UNDO.
     1946   DEFINE VARIABLE ch-1 AS int NO-UNDO init 1.
     1947   DEFINE VARIABLE kol-prev AS int NO-UNDO init 0.
     1948   DEFINE VARIABLE kol-peresm AS int NO-UNDO init 0.
     1949   DEFINE VARIABLE prm-1 AS int NO-UNDO .
     1950   DEFINE VARIABLE prm-2 AS int NO-UNDO .
     1951   DEFINE VARIABLE prm-3 AS int NO-UNDO .
     1952   DEFINE VARIABLE prm-4 AS int NO-UNDO .
     1953   DEFINE VARIABLE prm-5 AS int NO-UNDO .
     1954        FOR EACH tt-peresmen WHERE tt-peresmen.flg = 1 NO-LOCK BREAK BY tt-peresmen.ob-code BY tt-peresmen.peresm-date:
     1955             FIND FIRST shift-staff WHERE tt-peresmen.shift-name = shift-staff.shift-name
     1956                                                 AND tt-peresmen.ob-code = shift-staff.obj-code
     1957                                                     AND shift-staff.staff-role = yes AND shift-staff.shift-date = tt-peresmen.shift-date no-lock no-error.
     1958             IF AVAILABLE shift-staff THEN manager = shift-staff.name.
     1959                     FIND FIRST cash-desk WHERE cash-desk.obj-code = tt-peresmen.ob-code AND cash-desk.cash-num = tt-peresmen.kassa                                                  no-lock no-error.
     1960             FIND FIRST rvs-doc WHERE rvs-doc.obj-code = tt-peresmen.ob-code
     1961                                  AND rvs-doc.shift-date = tt-peresmen.sver-date
     1962                                  AND rvs-doc.shift-name = tt-peresmen.shift-name no-lock no-error.
     1963                                  IF AVAILABLE rvs-doc THEN DO:
     1964                                  num_sver = rvs-code.
     1965                                  date_sver = string(rvs-doc.fact-date, "99.99.9999") + ' ' +  string(rvs-doc.fact-time, "HH:MM").
     1966                                  END.
     1967                     itog-time = itog-time + tt-peresmen.time-p.
     1968                     itog-time-ob = itog-time-ob + tt-peresmen.time-p.
     1969                     itog-time-date = itog-time-date + tt-peresmen.time-p.
     1970             ch-1 = ch-1 + 1.
     1971             kol-peresm = kol-peresm  + 1.
     1972                     if (tt-peresmen.shift-time-end - tt-peresmen.shift-time-beg) > porog-zn * 60  then do:
     1973                       kol-prev = kol-prev + 1.
     1974                       time-prev = tt-peresmen.shift-time-end - tt-peresmen.shift-time-beg - porog-zn * 60 .
     1975               itog-time-prev = itog-time-prev + time-prev.
     1976               itog-prev-all = itog-prev-all + time-prev.
     1977             end.
     1978                     CREATE tt-tr.
     1979                           ASSIGN
     1980                           tt-tr.npp =  ch-1
     1981                           tt-tr.td_1 = STRING(tt-peresmen.kassa)
     1982                           tt-tr.td_2 = cash-desk.pos-type
     1983                           tt-tr.td_3 = manager
     1984               tt-tr.td_4 = date_sver
     1985               tt-tr.td_5 = num_sver
     1986               tt-tr.td_6 = string(tt-peresmen.shift-time-beg, "HH:MM")
     1987                           tt-tr.td_7 = string(tt-peresmen.shift-time-end, "HH:MM")
     1988                           tt-tr.td_8 = string((tt-peresmen.shift-time-end - tt-peresmen.shift-time-beg), "HH:MM")
     1989                           tt-tr.td_9 = string(time-prev, "HH:MM")
     1990                           .
     1991             ob-code2 = tt-peresmen.ob-code.
     1992                     date_it = tt-peresmen.shift-date.
     1993                     name-azs2 = tt-peresmen.name-azs.
     1994                     manager = ''.
     1995             if LAST-OF(tt-peresmen.peresm-date) THEN DO:
     1996                      RUN itog_str.
     1997                      itog-time-date = 0.
     1998              itog-time-ob = 0.
     1999              itog-time-prev = 0.
     2000              ch-1 = 1.
     2001                     END.
     2002        END.
     2003                           prm-1 = itog-time / kol-peresm .
     2004                           prm-2 = kol-prev .
     2005                           prm-3 = time-prev.
     2006                           prm-4 = itog-prev-all / kol-prev .
     2007               prm-5 = kol-prev / kol-peresm * 100 .
     2008   put stream OutStr-html unformatted
     2009                    '<tr>' skip
     2010               '<th>ИТОГО:</th>' skip
     2011               '<th></th>' skip
     2012               '<th style="text-align:center;">Количество случаев с превышением порога технологического закрытия смены</th>' skip
     2013               '<th style="text-align:center;">Средняя длительность технологического закрытия смены</th>' skip
     2014               '<th style="text-align:center;">Общая длительность превышения порога технологического закрытия смены</th>' skip
     2015               '<th style="text-align:center;">Средняя длительность превышения порога технологического закрытия смены</th>' skip
     2016               '<th style="text-align:center;">Процент случаев технологического закрытия смены с превышением порогового значения от общего кол-ва пересменки</th>' skip
     2017               '<th style="text-align:center;">' '</th>' skip
     2018               '<th></th>' skip
     2019            '</tr>' skip
     2020            '<tr>' skip
     2021               '<td></td>' skip
     2022               '<td></td>' skip
     2023               '<td style="text-align:center;">' kol-prev '</td>' skip
     2024               '<td style="text-align:center;">' string(prm-1, "HH:MM") '</td>' skip
     2025               '<td style="text-align:center;">' string(itog-prev-all, "HH:MM") ' </td>' skip
     2026               '<td style="text-align:center;">' string(prm-1, "HH:MM") '</td>' skip
     2027               '<td  style="text-align:center;">' prm-5 ' %  </td>' skip
     2028               '<td style="text-align:center;">'string(itog-time, "HH:MM") '</td>' skip
     2029               '<td style="text-align:center;">'string(itog-prev-all, "HH:MM") '</td>' skip
     2030               '</tr> ' skip
     2031               '</tbody> 'skip
     2032            '</table> 'skip
     2033            .
     2034   put stream OutStr-html unformatted '</body></html>
     2035   
     2036    'skip.
     2037   PROCEDURE itog_str:
     2038               CREATE tt-tr.
     2039               ASSIGN
     2040                           tt-tr.npp = ch-1 + 1
     2041                           tt-tr.td_1 = 'Итого по:'
     2042               tt-tr.td_8 = string(itog-time-ob, "HH:MM")
     2043                           tt-tr.td_9 = string(itog-time-prev, "HH:MM")
     2044                           .
     2045               CREATE tt-tr.
     2046               ASSIGN
     2047                           tt-tr.npp = 0
     2048                           tt-tr.td_1 = name-azs2
     2049                           tt-tr.td_2 = string(date_it, "99.99.9999")
     2050               tt-tr.td_8 = string(itog-time-ob, "HH:MM")
     2051                           tt-tr.td_9 = string(itog-time-prev, "HH:MM")
     2052                           .
     2053   FOR EACH tt-tr NO-LOCK:
     2054           if tt-tr.npp = 0 then do:
     2055                 put stream OutStr-html unformatted
     2056             '<tr bgcolor="#F8CBAD">' skip
     2057                   '<td style="text-align:center;">' tt-tr.td_1 '</td>' SKIP
     2058                   '<td style="text-align:center;">' tt-tr.td_2 '</td>' skip
     2059                   '<td style="text-align:center;">' tt-tr.td_3 '</td>' skip
     2060                                   '<td style="text-align:center;">' tt-tr.td_4 '</td>' skip
     2061                                   '<td style="text-align:center;">' tt-tr.td_5 '</td>' skip
     2062                                   '<td style="text-align:center;">' tt-tr.td_6 '</td>' skip
     2063                                   '<td style="text-align:center;">' tt-tr.td_7 '</td>' skip
     2064                   '<td style="text-align:center;">' tt-tr.td_8 '</td>' skip
     2065                   '<td style="text-align:center;">' tt-tr.td_9 '</td>' skip
     2066               '</tr>' skip
     2067             .
     2068                     end.
     2069                     else if tt-tr.npp <> 0 then do:
     2070                 put stream OutStr-html unformatted
     2071             '<tr >' skip
     2072                   '<td>' '   ' tt-tr.td_1 '</td>' SKIP
     2073                   '<td style="text-align:center;">' tt-tr.td_2 '</td>' skip
     2074                   '<td style="text-align:center;">' tt-tr.td_3 '</td>' skip
     2075                                   '<td style="text-align:center;">' tt-tr.td_4 '</td>' skip
     2076                                   '<td style="text-align:center;">' tt-tr.td_5 '</td>' skip
     2077                                   '<td style="text-align:center;">' tt-tr.td_6 '</td>' skip
     2078                                   '<td style="text-align:center;">' tt-tr.td_7 '</td>' skip
     2079                                   '<td style="text-align:center;">' tt-tr.td_8 '</td>' skip
     2080                                   '<td style="text-align:center;">' tt-tr.td_9 '</td>' skip
     2081             '</tr>' skip
     2082             .
     2083                     end.
     2084   end.
     2085   EMPTY TEMP-TABLE tt-tr.
     2086   END PROCEDURE.
     2087   output stream OutStr-html close.
     2088       run prn-lib-reportviewer in this-procedure (
     2089           input parparentproc
     2090           ,input v-file-name-rep-htm
     2091           ,input ""
     2092           ) no-error.
     2093       if error-status:error then
     2094       do:
     2095           message return-value view-as alert-box.
     2096           return .
     2097       end.
