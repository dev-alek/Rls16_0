      581   define  stream PrnLibStream.
      582   procedure prn-lib-prn-file :
      583     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      584     define input parameter p-DIsabledoptions as integer no-undo .
      585     define variable v-report-name as character no-undo .
      586     define variable v-user-action as character no-undo .
      587     define variable v-printed     as logical   no-undo .
      588     define variable v-exist       as logical   no-undo .
      589     do
      590       on error undo, return error
      591       :
      592       run prn-lib-get-report-name  in this-procedure (
      593         input parParentProc
      594         ,output v-report-name
      595         ).
      596   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      597   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      598     (input  v-report-name
      599     ,input  2
      600     ,output v-exist
      601     )  .
      602       if NOT v-exist then
      603       DO:
      604         Message
      605           "Нет заданий на печать ! "
      606           view-as alert-box .
      607         Return  .
      608       End.
      609       run gbl/prnfilen.w
      610         (input  ""
      611         ,input  p-DisabledOptions
      612         ,input  string(v-report-name )
      613         ,input  7
      614         ,output v-user-action
      615         ,output v-printed
      616         ) .
      617       if v-printed then
      618       do:
      619         return "YES" .
      620       end.
      621       else
      622       do:
      623         return "NO" .
      624       end.
      625     end.
      626   end procedure.
      627   procedure prn-lib-open-stream :
      628     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      629     define input parameter p-page-size    as integer no-undo .
      630     define input parameter p-is-stream    as logical no-undo .
      631     define input parameter p-append       as logical no-undo .
      632     define variable v-report-name as character no-undo .
      633     do
      634       on error undo, return error
      635       :
      636       run prn-lib-get-report-name  in this-procedure (
      637         input parParentProc
      638         ,output v-report-name
      639         ).
      640       if p-is-stream then
      641       do:
      642         if p-append then
      643         do:
      644           output stream PrnLibStream to value( v-report-name )
      645             page-size value(p-page-size) append .
      646         end.
      647         if not p-append then
      648         do:
      649           output stream PrnLibStream to value( v-report-name )
      650             page-size value(p-page-size) .
      651         end.
      652       end.
      653       if not p-is-stream then
      654       do:
      655         if p-append then
      656         do:
      657           output to value( v-report-name )
      658             page-size value(p-page-size) append .
      659         end.
      660         if not p-append then
      661         do:
      662           output to value( v-report-name )
      663             page-size value(p-page-size) .
      664         end.
      665       end.
      666     end.
      667   end procedure.
      668   procedure prn-lib-open-exp :
      669     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      670     define input parameter p-is-stream    as logical no-undo .
      671     define input parameter p-is-append    as logical no-undo .
      672     define output parameter p-ReportFileName as char init "report" no-undo.
      673     define output parameter p-process as logical no-undo .
      674     define variable glog as logical no-undo .
      675     do
      676       on error undo, return error
      677       :
      678       SYSTEM-DIALOG GET-FILE p-ReportFileName
      679         TITLE      "Укажите путь"
      680         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      681         ASK-OVERWRITE
      682         CREATE-TEST-FILE
      683         SAVE-AS
      684         USE-FILENAME
      685         DEFAULT-EXTENSION "txt"
      686         UPDATE glog
      687         .
      688       if not glog then  return.
      689       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      690       if p-is-stream then
      691       do:
      692         if p-is-append then
      693         do:
      694           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      695         end.
      696         else
      697         do:
      698           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      699         end.
      700       end.
      701       else
      702       do:
      703         if p-is-append then
      704         do:
      705           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      706         end.
      707         else
      708         do:
      709           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      710         end.
      711       end.
      712       p-process = yes.
      713     end.
      714   end procedure.
      715   procedure prn-lib-get-report-name :
      716     define input parameter parParentProc  as widget-handle no-undo.
      717     define output parameter p-report-name as character no-undo .
      718     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      719   end procedure.
      720   procedure prn-lib-reportviewer-report-name :
      721     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      722     define input parameter p-report-name-html as character no-undo .
      723     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      724   end procedure.
      725   procedure prn-lib-reportviewer :
      726     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      727     define input parameter p-report-name-html as character no-undo .
      728     define input parameter p-param        as character no-undo .
      729     define variable v-excel           as character no-undo init 'TRUE' .
      730     define variable v-value-character as character no-undo .
      731     define variable v-value-integer   as character no-undo .
      732     define variable v-value-date      as date      no-undo .
      733     define variable v-value-decimal   as decimal   no-undo .
      734     define variable rep-excel         as logical   no-undo .
      735     define variable excel-string      as character no-undo .
      736     define variable v-param-type      as character no-undo .
      737     define variable v-tth             as handle    no-undo .
      738     run adm/shattri.p (
      739       input "get":U
      740       ,input  ""
      741       ,input  0
      742       ,input  'report-glob':U
      743       ,input  'rep-excel':U
      744       ,output v-value-character
      745       ,output v-value-date
      746       ,output v-value-decimal
      747       ,output v-value-integer
      748       ,output rep-excel
      749       ,output v-param-type
      750       ,INPUT-OUTPUT table-handle v-tth
      751       )  .
      752     if rep-excel then v-excel = "TRUE" .
      753     else v-excel = "FALSE" .
      754     if p-param eq ""
      755     then
      756        p-param = "EXCEL:" + v-excel.
      757     else
      758        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      759     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      760   end procedure.
      761   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      762   PROCEDURE LastDate:
      763       def input parameter in-date as date no-undo.
      764       def output parameter LastDate as date no-undo.
      765       LastDate = ((DATE(MONTH(in-date),28,YEAR(in-date)) + 4) - DAY(DATE(MONTH(in-date),28,YEAR(in-date)) + 4)).
      766   END PROCEDURE.
      767   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      768   procedure cur-time :
      769      define output parameter p-today as date      no-undo .
      770      define output parameter p-time  as integer   no-undo .
      771     do
      772     on error undo, return error
      773     :
      774       define variable v-date1 as date      no-undo .
      775       define variable v-date2 as date      no-undo .
      776       define variable v-time  as integer   no-undo .
      777       assign
      778         v-date1 = today
      779         v-time  = time
      780         v-date2 = today
      781       .
      782       if v-date1 <> v-date2
      783       then do:
      784         assign
      785           v-date1 = today
      786           v-time  = v-time
      787         .
      788       end.
      789       assign
      790         p-today = v-date1
      791         p-time  = v-time
      792       .
      793     end.
      794   end.
      795   function cur-time-date returns character
      796   :
      797     return string(today, '99/99/9999':U) .
      798   end.
      799   function cur-time-mjd returns decimal
      800   :
      801     define variable v-date as date      no-undo .
      802     define variable v-time as integer   no-undo .
      803     run cur-time in this-procedure
      804       (output v-date
      805       ,output v-time
      806       ) .
      807     return integer(v-date) - 2400002 + (v-time / 86400) .
      808   end.
      809   function cur-time-get-ending-index returns integer
      810   (input p-number as integer
      811   )
      812   :
      813     if p-number < 0
      814     or p-number = ?
      815     then do:
      816       return 1 .
      817     end.
      818     define variable v-rest as integer   no-undo .
      819     assign
      820       p-number = p-number modulo 100
      821     .
      822     if p-number < 20
      823     then do:
      824       assign
      825         v-rest = p-number
      826       .
      827     end.
      828     else do:
      829       assign
      830         v-rest = p-number modulo 10
      831       .
      832     end.
      833     case v-rest :
      834       when 1
      835       then do:
      836         return 2 .
      837       end.
      838       when 2 or
      839       when 3 or
      840       when 4
      841       then do:
      842         return 3 .
      843       end.
      844       otherwise do:
      845         return 1 .
      846       end.
      847     end case .
      848   end.
      849   procedure cur-time-mjd-to-date :
      850      define input  parameter i-mjd-diff as decimal no-undo.
      851      define output parameter o-Date     as date    no-undo.
      852      define output parameter o-Time     as integer no-undo.
      853      define variable v-day-number as integer   no-undo .
      854      if    i-mjd-diff < 0
      855         or i-mjd-diff = ?
      856      then do:
      857         return "?" .
      858      end.
      859      assign
      860         v-day-number = truncate(i-mjd-diff,0).
      861         o-Date = date(v-day-number + 2400002).
      862         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      863     .
      864   end.
      865   function cur-time-mjd-to-string returns character
      866   (input p-mjd-diff as decimal
      867   )
      868   :
      869     define variable v-day-number as integer   no-undo .
      870     define variable v-seconds    as integer   no-undo .
      871     define variable v-hour       as integer   no-undo .
      872     define variable v-min        as integer   no-undo .
      873     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      874     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      875     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      876     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      877     if p-mjd-diff < 0
      878     or p-mjd-diff = ?
      879     then do:
      880       return "?" .
      881     end.
      882     assign
      883       v-day-number = integer(truncate(p-mjd-diff,0))
      884       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      885     .
      886     if v-seconds > 86400
      887     then do:
      888       assign
      889         v-seconds = 86400 - 1
      890       .
      891     end.
      892     if v-seconds < 0
      893     then do:
      894       assign
      895         v-seconds = 0
      896       .
      897     end.
      898     assign
      899       v-hour = truncate(v-seconds / 3600, 0)
      900     .
      901     assign
      902       v-seconds = v-seconds modulo 3600
      903     .
      904     assign
      905       v-min = truncate(v-seconds / 60, 0)
      906     .
      907     assign
      908       v-seconds = v-seconds modulo 60
      909     .
      910     return
      911         (if v-day-number <> 0
      912           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      913           else ""
      914         )
      915       + (if v-day-number <> 0 or v-hour <> 0
      916           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      917           else ""
      918         )
      919       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      920           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      921           else ""
      922         )
      923       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      924       .
      925   end.
      926   function cur-time-string returns character
      927   :
      928     define variable v-date as date      no-undo .
      929     define variable v-time as integer   no-undo .
      930     run cur-time in this-procedure
      931       (output v-date
      932       ,output v-time
      933       ) .
      934     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      935   end.
      936   function cur-time-string-sec returns character
      937   :
      938     define variable v-date as date      no-undo .
      939     define variable v-time as integer   no-undo .
      940     run cur-time in this-procedure
      941       (output v-date
      942       ,output v-time
      943       ) .
      944     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      945   end.
      946   function cur-time-custom  returns character
      947   (input p-prefix as character
      948   ,input p-date-format as character
      949   ,input p-delimiter as character
      950   ,input p-time-format as character
      951   ,input p-suffix as character
      952   )
      953   :
      954     define variable v-date as date      no-undo .
      955     define variable v-time as integer   no-undo .
      956     run cur-time in this-procedure
      957       (output v-date
      958       ,output v-time
      959       ) .
      960     return
      961       p-prefix
      962       + string(v-date, p-date-format)
      963       + p-delimiter
      964       + string(v-time, p-time-format)
      965       + p-suffix
      966       .
      967   end.
      968   function cur-time-print  returns character
      969   :
      970     define variable v-date as date      no-undo .
      971     define variable v-time as integer   no-undo .
      972     run cur-time in this-procedure
      973       (output v-date
      974       ,output v-time
      975       ) .
      976     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      977   end.
      978   function cur-time-datetime returns datetime
      979   :
      980     define variable v-char as character no-undo .
      981     define variable v-datetime as datetime no-undo .
      982     v-char = cur-time-string().
      983     v-datetime = datetime(v-char).
      984     return  v-datetime.
      985   end.
      986   function cur-time-string-msec returns character
      987   :
      988     define variable v-date as datetime  no-undo .
      989     v-date = now.
      990     return string(v-date) .
      991   end.
