     1869     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1870     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1871     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1872     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1873     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
