     1777   END PROCEDURE.
     1778   PROCEDURE adm-show-errors :
     1779       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1780       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1781           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1782       END.
     1783       RETURN.
     1784   END PROCEDURE.
     1785   PROCEDURE adm-UIB-mode :
     1786     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1787   END PROCEDURE.
     1788   PROCEDURE adm-view :
