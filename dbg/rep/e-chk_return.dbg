     1790   END PROCEDURE.
     1791   PROCEDURE dispatch :
     1792       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1793       RUN broker-dispatch IN adm-broker-hdl
     1794           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1795       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1796   END PROCEDURE.
     1797   PROCEDURE ensure-broker :
     1798   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1799   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1800   DO:
     1801       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1802       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1803   END.
     1804   END PROCEDURE.
     1805   PROCEDURE get-attribute :
     1806     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1807     RUN broker-get-attribute IN adm-broker-hdl
     1808         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1809     RETURN RETURN-VALUE.
     1810   END PROCEDURE.
     1811   PROCEDURE get-attribute-list :
     1812     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1813     RUN broker-get-attribute-list IN adm-broker-hdl
     1814         (INPUT THIS-PROCEDURE,
     1815          INPUT ?,
     1816          OUTPUT p-attr-list) NO-ERROR.
     1817     RETURN.
     1818   END PROCEDURE.
     1819   PROCEDURE new-state :
     1820     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1821     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1822     RETURN.
     1823   END PROCEDURE.
     1824   PROCEDURE notify :
     1825     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1826     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1827     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1828         RETURN "ADM-ERROR":U.
     1829     RETURN.
     1830   END PROCEDURE.
     1831   PROCEDURE set-attribute-list :
     1832     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1833     RUN ensure-broker.
     1834     RUN broker-set-attribute-list IN adm-broker-hdl
     1835         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1836     RETURN.
     1837   END PROCEDURE.
     1838   PROCEDURE set-position :
     1839       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1840       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1841       IF VALID-HANDLE(adm-object-hdl) THEN
     1842       DO:
     1843         ASSIGN adm-object-hdl:ROW    =   p-row
     1844                adm-object-hdl:COLUMN =   p-col.
     1845       END.
     1846       RETURN.
     1847   END PROCEDURE.
     1848   PROCEDURE adm-display-fields :
     1849       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1850       RETURN.
     1851   END PROCEDURE.
     1852   PROCEDURE adm-open-query :
     1853     RETURN.
     1854   END PROCEDURE.
     1855   PROCEDURE adm-row-changed :
     1856         IF VALID-HANDLE(adm-object-hdl) THEN
     1857           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1858         RUN notify ('row-available':U).
     1859         RETURN.
