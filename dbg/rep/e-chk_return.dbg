     1022   procedure uf-get :
     1023     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1024     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1025     define output parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1026     define output parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1027     define output parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1028     define output parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1029     define output parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1030     define output parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1031     do
     1032     on error undo, return error
     1033     :
     1034       define buffer buf_usr-flt for ubflt.usr-flt .
     1035       define variable v-use-List_     as logical   no-undo .
     1036       define variable v-type-List_     as character no-undo .
     1037       define variable v-format-List_   as character no-undo .
     1038       define variable v-use-Naim      as logical   no-undo .
     1039       define variable v-type-Naim      as character no-undo .
     1040       define variable v-format-Naim    as character no-undo .
     1041       define variable v-use-print-graft as logical   no-undo .
     1042       define variable v-use-sort-gr     as logical   no-undo .
     1043       define variable v-use-type-price  as logical   no-undo .
     1044       define variable v-use-type-val    as logical   no-undo .
     1045       define variable v-label          as character no-undo .
     1046       define variable v-tooltip        as character no-undo .
     1047       define variable v-user-can-edit  as logical   no-undo .
     1048       define variable v-output-display as logical   no-undo .
     1049       define variable v-other          as character no-undo .
     1050       run uf-name in this-procedure
     1051          (input  entry(1, p-code, chr(4))
     1052         ,output v-use-List_
     1053         ,output v-type-List_
     1054         ,output v-format-List_
     1055         ,output v-use-Naim
     1056         ,output v-type-Naim
     1057         ,output v-format-Naim
     1058         ,output v-use-print-graft
     1059         ,output v-use-sort-gr
     1060         ,output v-use-type-price
     1061         ,output v-use-type-val
     1062         ,output v-label
     1063         ,output v-tooltip
     1064         ,output v-user-can-edit
     1065         ,output v-output-display
     1066         ,output v-other
     1067         ) no-error .
     1068       if error-status :error then do:
     1069         undo, return error return-value .
     1070       end.
     1071       find first buf_usr-flt no-lock where
     1072                  buf_usr-flt.Call-point     = p-code AND
     1073                  buf_usr-flt.user-name       = p-user-name
     1074         no-error .
     1075       if avail buf_usr-flt then do:
     1076         assign
     1077         p-List_        = (if v-use-List_       then buf_usr-flt.List_       else ?)
     1078         p-Naim         = (if v-use-Naim        then buf_usr-flt.Naim        else ?)
     1079         p-print-graft  = (if v-use-print-graft then buf_usr-flt.print-graft else ?)
     1080         p-sort-gr      = (if v-use-sort-gr     then buf_usr-flt.sort-gr     else ?)
     1081         p-type-price   = (if v-use-type-price  then buf_usr-flt.type-price  else ?)
     1082         p-type-val     = (if v-use-List_       then buf_usr-flt.type-val    else ?)
     1083         .
     1084       end.
     1085       else do:
     1086         assign
     1087         p-List_        = (if v-use-List_       then "":U                    else ?)
     1088         p-Naim         = (if v-use-Naim        then "":U                    else ?)
     1089         p-print-graft  = (if v-use-print-graft then no                      else ?)
     1090         p-sort-gr      = (if v-use-sort-gr     then no                      else ?)
     1091         p-type-price   = (if v-use-type-price  then no                      else ?)
     1092         p-type-val     = (if v-use-List_       then no                      else ?)
     1093         .
     1094       end.
     1095     end.
     1096   end procedure.
     1097   procedure uf-set :
     1098     define input  parameter p-code         like ubflt.usr-flt.call-point   no-undo .
     1099     define input  parameter p-user-name    like ubflt.usr-flt.user-name    no-undo .
     1100     define input  parameter p-List_        like ubflt.usr-flt.List_        no-undo .
     1101     define input  parameter p-Naim         like ubflt.usr-flt.Naim         no-undo .
     1102     define input  parameter p-print-graft  like ubflt.usr-flt.print-Graft  no-undo .
     1103     define input  parameter p-sort-gr      like ubflt.usr-flt.sort-gr      no-undo .
     1104     define input  parameter p-type-price   like ubflt.usr-flt.type-price   no-undo .
     1105     define input  parameter p-type-val     like ubflt.usr-flt.type-val     no-undo .
     1106     do
     1107     on error undo, return error
     1108     :
     1109       define buffer buf_usr-flt for ubflt.usr-flt .
     1110       define variable v-use-List_     as logical   no-undo .
     1111       define variable v-type-List_     as character no-undo .
     1112       define variable v-format-List_   as character no-undo .
     1113       define variable v-use-Naim      as logical   no-undo .
     1114       define variable v-type-Naim      as character no-undo .
     1115       define variable v-format-Naim    as character no-undo .
     1116       define variable v-use-print-graft as logical   no-undo .
     1117       define variable v-use-sort-gr   as logical   no-undo .
     1118       define variable v-use-type-price as logical   no-undo .
     1119       define variable v-use-type-val  as logical   no-undo .
     1120       define variable v-tooltip        as character no-undo .
     1121       define variable v-label          as character no-undo .
     1122       define variable v-user-can-edit  as logical   no-undo .
     1123       define variable v-output-display as logical   no-undo .
     1124       define variable v-other          as character no-undo .
     1125       run uf-name in this-procedure
     1126         (input  entry(1, p-code, chr(4))
     1127         ,output v-use-List_
     1128         ,output v-type-List_
     1129         ,output v-format-List_
     1130         ,output v-use-Naim
     1131         ,output v-type-Naim
     1132         ,output v-format-Naim
     1133         ,output v-use-print-graft
     1134         ,output v-use-sort-gr
     1135         ,output v-use-type-price
     1136         ,output v-use-type-val
     1137         ,output v-label
     1138         ,output v-tooltip
     1139         ,output v-user-can-edit
     1140         ,output v-output-display
     1141         ,output v-other
     1142         ) no-error .
     1143       if error-status :error then do:
     1144         undo, return error return-value .
     1145       end.
     1146       find first buf_usr-flt where
     1147                  buf_usr-flt.Call-point     = p-code AND
     1148                  buf_usr-flt.user-name       = p-user-name
     1149         no-error .
     1150       if not avail buf_usr-flt then do:
     1151           create buf_usr-flt .
     1152           assign
     1153           buf_usr-flt.call-point = p-code
     1154           buf_usr-flt.user-name  = p-user-name
     1155           .
     1156       end.
     1157       if avail buf_usr-flt then do:
     1158        assign
     1159        buf_usr-flt.List_       =  (if v-use-List_       then  p-List_        else ?)
     1160        buf_usr-flt.Naim        =  (if v-use-Naim        then  p-Naim         else ?)
     1161        buf_usr-flt.print-graft =  (if v-use-print-graft then  p-print-graft  else ?)
     1162        buf_usr-flt.sort-gr     =  (if v-use-sort-gr     then  p-sort-gr      else ?)
     1163        buf_usr-flt.type-price  =  (if v-use-type-price  then  p-type-price   else ?)
     1164        buf_usr-flt.type-val    =  (if v-use-List_       then  p-type-val     else ?)
     1165       .
     1166       release buf_usr-flt.
     1167       end.
     1168       else undo, return error ("Ошибка при записи usr-flt" + substitute(" call-point=&1, user-name=&2", p-code, p-user-name)).
     1169     end.
     1170   end procedure.
     1171   def var vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1172   procedure gen-key-rec :
     1173     define input  parameter p-tbl-name    as character no-undo.
     1174     define input  parameter p-bh_tbl-name as handle    no-undo.
     1175     define output parameter p-key-rec     as character no-undo.
     1176     do
     1177     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1178     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
     1179     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
     1180     :
     1181       define variable fh               as handle    no-undo .
     1182       define variable v-ok             as logical   no-undo .
     1183       define variable v-inform         as character no-undo .
     1184       define variable v-ind            as integer   no-undo .
     1185       define variable v-idx-field-qnty as integer   no-undo .
     1186       if p-tbl-name = ?
     1187         or p-tbl-name = "":U
     1188       then do:
     1189         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info15 ).
     1190       end.
     1191       if not p-bh_tbl-name:available then do:
     1192         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info15, p-tbl-name ).
     1193       end.
     1194       assign
     1195         p-key-rec = p-tbl-name
     1196         v-inform  = p-bh_tbl-name:index-information(1)
     1197         v-ind     = 2
     1198       .
     1199       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1200       on error undo, return error
     1201       :
     1202         assign
     1203           v-inform = p-bh_tbl-name:index-information( v-ind )
     1204           v-ind    = v-ind + 1
     1205         .
     1206       end.
     1207       if v-inform = ?
     1208         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1209         or entry( 3, v-inform, ",":U ) <> "1":U
     1210       then do:
     1211         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, p-tbl-name ).
     1212       end.
     1213       else do:
     1214         assign
     1215           v-idx-field-qnty = num-entries( v-inform ) - 4
     1216         .
     1217         if v-idx-field-qnty < 2 then do:
     1218           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, p-tbl-name ).
     1219         end.
     1220         do v-ind = 1 to v-idx-field-qnty by 2
     1221         on error undo, return error
     1222         :
     1223           assign
     1224             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
     1225             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
     1226           .
     1227         end.
     1228       end.
     1229       if p-key-rec = ? then do:
     1230         assign
     1231           p-key-rec = "":U
     1232         .
     1233         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info15, p-tbl-name ).
     1234       end.
     1235     end.
     1236     return.
     1237   end procedure.
     1238   procedure gen-where-keyr-tab :
     1239     define input  parameter i-tableSerach as character no-undo.
     1240     define input  parameter i-tablekey   as character  no-undo.
     1241     define input  parameter p-key-rec    as character  no-undo.
     1242     define input  parameter p-key-handle as handle     no-undo .
     1243     define input  parameter p-db-name    as character  no-undo .
     1244     define input  parameter p-tt-handle  as handle     no-undo .
     1245     define output parameter o-Where      as character  no-undo.
     1246     do
     1247     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1248     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1249     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
     1250     :
     1251       define variable v-full-tbl-name  as character no-undo .
     1252       define variable bh_tbl-name      as handle    no-undo .
     1253       define variable fh_key           as handle    no-undo .
     1254       define variable fh_search        as handle    no-undo .
     1255       define variable v-field-num      as integer   no-undo .
     1256       define variable v-count-fld      as integer   no-undo .
     1257       define variable v-inform         as character no-undo .
     1258       define variable v-ind            as integer   no-undo .
     1259       define variable v-idx-field-qnty as integer   no-undo .
     1260       define variable v-field-name     as character no-undo .
     1261       define variable v-field-val      as character no-undo .
     1262       define variable v-word-link      as character no-undo .
     1263       define variable vTable           as character no-undo.
     1264       define variable bh_tbl-key       as handle    no-undo .
     1265       assign
     1266         p-key-rec = trim( p-key-rec )
     1267       .
     1268       if p-key-handle <> ? then do:
     1269         if not valid-handle(p-key-handle)
     1270            or p-key-handle:type <> "buffer"
     1271         then do:
     1272           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info15 ).
     1273         end.
     1274         if num-entries( p-key-rec, chr(3) ) > 1
     1275           or p-key-rec = ?
     1276           or p-key-rec = "":U
     1277         then do:
     1278           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info15, p-key-rec ).
     1279         end.
     1280       end.
     1281       else do:
     1282         if p-key-rec = ?
     1283           or p-key-rec = "":U
     1284         then do:
     1285           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     1286         end.
     1287       end.
     1288       assign
     1289         vTable = entry( 1 , p-key-rec, chr(3) )
     1290       .
     1291       if p-tt-handle <> ?
     1292         and ( not valid-handle(p-tt-handle)
     1293               or p-tt-handle:type <> "buffer"
     1294             )
     1295       then do:
     1296         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info15, vTable, chr(10) ).
     1297       end.
     1298       if p-tt-handle = ? then do:
     1299         assign
     1300           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
     1301         .
     1302         create buffer bh_tbl-name for table v-full-tbl-name .
     1303       end.
     1304       else do:
     1305         create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1306       end.
     1307       assign
     1308         v-inform = bh_tbl-name:index-information(1)
     1309         v-ind    = 2
     1310       .
     1311       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1312       on error undo, return error
     1313       :
     1314         assign
     1315           v-inform = bh_tbl-name:index-information( v-ind )
     1316           v-ind    = v-ind + 1
     1317         .
     1318       end.
     1319       if v-inform = ?
     1320         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1321         or entry( 3, v-inform, ",":U ) <> "1":U
     1322       then do:
     1323         delete object bh_tbl-name no-error.
     1324         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info15, vTable ).
     1325       end.
     1326       assign
     1327         v-idx-field-qnty = num-entries( v-inform ) - 4
     1328       .
     1329       if v-idx-field-qnty < 2 then do:
     1330         delete object bh_tbl-name no-error.
     1331         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, vTable ).
     1332       end.
     1333       assign
     1334         o-where     = "where":U
     1335         v-word-link = "":U
     1336         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
     1337         v-count-fld = 0
     1338       .
     1339       if i-tablekey ne "" and i-tablekey ne ?
     1340       then do:
     1341         assign
     1342           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
     1343         .
     1344         create buffer bh_tbl-key for table v-full-tbl-name .
     1345       end.
     1346       if i-tableSerach ne "" and i-tableSerach ne ?
     1347       then do:
     1348         delete object bh_tbl-name no-error.
     1349         assign
     1350           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
     1351         .
     1352         create buffer bh_tbl-name for table v-full-tbl-name .
     1353       end.
     1354       block_where:
     1355       do v-ind = 1 to v-idx-field-qnty by 2
     1356       on error undo, return error
     1357       :
     1358         assign
     1359           v-count-fld = v-count-fld + 1
     1360         .
     1361         if p-key-handle = ?
     1362           and v-count-fld > v-field-num
     1363         then do:
     1364           leave block_where.
     1365         end.
     1366         define variable VfieldKeyTable as handle no-undo.
     1367         assign
     1368           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
     1369           fh_search    = bh_tbl-name:buffer-field( v-field-name )
     1370         .
     1371         if     bh_tbl-key ne ?
     1372         then do:
     1373            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
     1374            if VfieldKeyTable eq ?
     1375            then next block_where.
     1376         end.
     1377         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1378         then
     1379            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1380         else
     1381            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1382         if p-key-handle = ? then do:
     1383           assign
     1384             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1385           .
     1386         end.
     1387         else do:
     1388           assign
     1389             fh_key = p-key-handle:buffer-field( v-field-name )
     1390           .
     1391           if fh_key = ?
     1392             or not valid-handle( fh_key )
     1393           then do:
     1394             delete object bh_tbl-name.
     1395             if     bh_tbl-key ne ?
     1396             then
     1397                delete object bh_tbl-key.
     1398             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info15, p-key-handle:name, v-field-name ).
     1399           end.
     1400           assign
     1401             v-field-val = fh_key:buffer-value
     1402           .
     1403         end.
     1404         if fh_search:data-type ="character":U then do:
     1405           assign
     1406             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1407             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1408             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1409             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1410             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1411             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1412             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1413             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1414             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1415             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1416             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1417             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1418             v-field-val = substitute( '"&1"', v-field-val )
     1419           .
     1420         end.
     1421         assign
     1422           o-where = substitute( "&1 &2", o-where, v-field-val )
     1423         .
     1424         if v-word-link = "":U then do:
     1425           assign
     1426             v-word-link = "and":U
     1427           .
     1428         end.
     1429       end.
     1430       delete object bh_tbl-name.
     1431       if     bh_tbl-key ne ?
     1432       then
     1433          delete object bh_tbl-key.
     1434       if p-key-handle = ?
     1435         and v-count-fld <> v-field-num
     1436       then do:
     1437         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info15, vTable ).
     1438       end.
     1439     end.
     1440   end procedure.
     1441   procedure gen-hn-keyr-tab :
     1442     define input  parameter i-tableSerach as character no-undo.
     1443     define input  parameter i-tablekey   as character no-undo.
     1444     define input  parameter p-key-rec    as character no-undo.
     1445     define input  parameter p-key-handle as handle    no-undo .
     1446     define input  parameter p-db-name    as character no-undo .
     1447     define input  parameter p-tt-handle  as handle    no-undo .
     1448     define input  parameter p-stts-lock  as integer   no-undo .
     1449     define output parameter o-hn         as handle    no-undo.
     1450     define variable v-full-tbl-name as character no-undo.
     1451     define variable v-where         as character no-undo.
     1452     define variable bh_tbl-name     as handle    no-undo.
     1453     define variable vTable          as character no-undo.
     1454     do
     1455     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1456     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1457     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1458         run gen-where-keyr-tab(i-tableSerach,
     1459                                i-tablekey,
     1460                                p-key-rec,
     1461                                p-key-handle,
     1462                                p-db-name,
     1463                                p-tt-handle,
     1464                                output v-where).
     1465         if i-tableSerach ne "" and i-tableSerach ne ?
     1466         then do:
     1467            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1468            create buffer bh_tbl-name for table v-full-tbl-name .
     1469         end.
     1470         else do:
     1471            if p-tt-handle = ? then do:
     1472               assign
     1473                  vTable = entry( 1 , p-key-rec, chr(3) )
     1474               .
     1475               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1476               create buffer bh_tbl-name for table v-full-tbl-name .
     1477            end.
     1478            else do:
     1479               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1480            end.
     1481         end.
     1482         if p-tt-handle = ? then do:
     1483            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1484         end.
     1485         else do:
     1486            bh_tbl-name:find-first( v-where ) no-error .
     1487         end.
     1488         o-hn = bh_tbl-name.
     1489      end.
     1490   end procedure.
     1491   procedure gen-hn-keyr :
     1492     define input  parameter p-key-rec    as character no-undo.
     1493     define input  parameter p-key-handle as handle    no-undo .
     1494     define input  parameter p-db-name    as character no-undo .
     1495     define input  parameter p-tt-handle  as handle    no-undo .
     1496     define input  parameter p-stts-lock  as integer   no-undo .
     1497     define output parameter o-hn         as handle    no-undo.
     1498     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1499   end.
     1500   procedure gen-row-keyr :
     1501     define input  parameter p-key-rec    as character no-undo.
     1502     define input  parameter p-key-handle as handle    no-undo .
     1503     define input  parameter p-db-name    as character no-undo .
     1504     define input  parameter p-tt-handle  as handle    no-undo .
     1505     define input  parameter p-stts-lock  as integer   no-undo .
     1506     define output parameter p-tbl-row    as rowid     no-undo.
     1507     define output parameter p-tbl-name   as character no-undo.
     1508     define variable vHn as handle no-undo.
     1509       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1510       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1511       p-tbl-name =  vHn:table.
     1512       delete object vHn no-error.
     1513     if p-tbl-row = ? then do:
     1514       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info15, p-tbl-name, p-key-rec ).
     1515     end.
     1516     else do:
     1517       return.
     1518     end.
     1519   end procedure.
     1520   procedure gen-key-fv :
     1521     define input  parameter p-key-rec    as character no-undo .
     1522     define output parameter p-field-list as character no-undo .
     1523     define output parameter p-value-list as character no-undo.
     1524     do
     1525     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1526     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1527     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1528     :
     1529       define variable v-full-tbl-name  as character no-undo .
     1530       define variable bh_tbl-name      as handle    no-undo .
     1531       define variable v-tbl-name       as character no-undo .
     1532       define variable v-field-num      as integer   no-undo .
     1533       define variable v-count-fld      as integer   no-undo .
     1534       define variable v-inform         as character no-undo .
     1535       define variable v-ind            as integer   no-undo .
     1536       define variable v-idx-field-qnty as integer   no-undo .
     1537       define variable v-delim-key      as character no-undo .
     1538       if p-key-rec = ?
     1539         or p-key-rec = "":U
     1540       then do:
     1541         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info15 ).
     1542       end.
     1543       assign
     1544         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1545         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1546       .
     1547       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1548       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info15 ).
     1549       assign
     1550         v-inform = bh_tbl-name:index-information(1)
     1551         v-ind    = 2
     1552       .
     1553       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1554       on error undo, return error
     1555       :
     1556         assign
     1557           v-inform = bh_tbl-name:index-information( v-ind )
     1558           v-ind    = v-ind + 1
     1559         .
     1560       end.
     1561       if v-inform = ?
     1562         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1563         or entry( 3, v-inform, ",":U ) <> "1":U
     1564       then do:
     1565         delete object bh_tbl-name no-error.
     1566         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     1567       end.
     1568       assign
     1569         v-idx-field-qnty = num-entries( v-inform ) - 4
     1570       .
     1571       if v-idx-field-qnty < 2 then do:
     1572         delete object bh_tbl-name no-error.
     1573         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     1574       end.
     1575       assign
     1576         p-field-list = "":U
     1577         p-value-list = "":U
     1578         v-delim-key  = "":U
     1579         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1580         v-count-fld  = 0
     1581       .
     1582       block_where:
     1583       do v-ind = 1 to v-idx-field-qnty by 2
     1584       on error undo, return error
     1585       :
     1586         assign
     1587           v-count-fld = v-count-fld + 1
     1588         .
     1589         if v-count-fld > v-field-num then do:
     1590           leave block_where.
     1591         end.
     1592         assign
     1593           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1594           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1595         .
     1596         if v-ind = 1 then do:
     1597           assign
     1598             v-delim-key = chr(3)
     1599           .
     1600         end.
     1601       end.
     1602       delete object bh_tbl-name.
     1603       if v-count-fld <> v-field-num then do:
     1604         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info15, v-tbl-name ).
     1605       end.
     1606     end.
     1607   end procedure.
     1608   procedure gen-key-field :
     1609     define input  parameter p-table      as character no-undo .
     1610     define output parameter p-field-list as character no-undo .
     1611     do
     1612     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1613     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1614     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1615     :
     1616       define variable v-full-tbl-name  as character no-undo .
     1617       define variable bh_tbl-name      as handle    no-undo .
     1618       define variable v-tbl-name       as character no-undo .
     1619       define variable v-field-num      as integer   no-undo .
     1620       define variable v-count-fld      as integer   no-undo .
     1621       define variable v-inform         as character no-undo .
     1622       define variable v-ind            as integer   no-undo .
     1623       define variable v-idx-field-qnty as integer   no-undo .
     1624       define variable v-delim-key      as character no-undo .
     1625       if p-table = ?
     1626         or p-table = "":U
     1627       then do:
     1628         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info15 ).
     1629       end.
     1630       assign
     1631         v-tbl-name      = p-table
     1632         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1633       .
     1634       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1635       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info15 ).
     1636       assign
     1637         v-inform = bh_tbl-name:index-information(1)
     1638         v-ind    = 2
     1639       .
     1640       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1641       on error undo, return error
     1642       :
     1643         assign
     1644           v-inform = bh_tbl-name:index-information( v-ind )
     1645           v-ind    = v-ind + 1
     1646         .
     1647       end.
     1648       if v-inform = ?
     1649         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1650         or entry( 3, v-inform, ",":U ) <> "1":U
     1651       then do:
     1652         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info15, v-tbl-name ).
     1653       end.
     1654       assign
     1655         v-idx-field-qnty = num-entries( v-inform ) - 4
     1656       .
     1657       if v-idx-field-qnty < 2 then do:
     1658         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info15, v-inform, v-tbl-name ).
     1659       end.
     1660       assign
     1661         p-field-list = "":U
     1662         v-delim-key  = "":U
     1663         v-count-fld  = 0
     1664       .
     1665       block_where:
     1666       do v-ind = 1 to v-idx-field-qnty by 2
     1667       on error undo, return error
     1668       :
     1669         assign
     1670           v-count-fld = v-count-fld + 1
     1671         .
     1672         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1673         if v-ind = 1 then do:
     1674           assign
     1675             v-delim-key = chr(3)
     1676           .
     1677         end.
     1678       end.
     1679       delete object bh_tbl-name.
     1680     end.
     1681   end procedure.
     1682   define variable v-profile-id as integer no-undo .
     1683   define variable v-output-type as character no-undo .
     1684   CREATE WIDGET-POOL.
     1685   define variable v-nn as integer   no-undo .
     1686   define variable State-source as  WIDGET-HANDLE.
     1687   define variable g#log as logical   no-undo .
     1688   define variable v-curr-r-b               as character no-undo .
     1689   define variable v-print-rubl             as logical   no-undo .
     1690   define variable p-customer as integer .
     1691   define variable v-res as character .
     1692   define variable ii as integer no-undo .
     1693   DEFINE VARIABLE v-itog AS logical NO-UNDO.
     1694   DEFINE RECTANGLE RECT-13
     1695        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1696        SIZE 42.5 BY 12.
     1697   DEFINE VARIABLE SEL-oplat AS CHARACTER
     1698        VIEW-AS SELECTION-LIST MULTIPLE SCROLLBAR-VERTICAL
     1699        LIST-ITEM-PAIRS "","0",
     1700                        "Получен от поставщика","2",
     1701                        "Требует корректировки","3",
     1702                        "Ожидает поставки","4",
     1703                        "Требует подписания","5"
     1704        SIZE 26.5 BY 9 NO-UNDO.
     1705   DEFINE VARIABLE TOG-itog AS LOGICAL INITIAL no
     1706        LABEL "только итоги"
     1707        VIEW-AS TOGGLE-BOX
     1708        SIZE 30 BY .83 NO-UNDO.
     1709   DEFINE FRAME F-Main
     1710        TOG-itog AT ROW 2.25 COL 4 WIDGET-ID 20
     1711        SEL-oplat AT ROW 3.5 COL 16.5 NO-LABEL WIDGET-ID 28
     1712        "Тип оплаты:" VIEW-AS TEXT
     1713             SIZE 12 BY .67 AT ROW 3.75 COL 4 WIDGET-ID 30
     1714        RECT-13 AT ROW 1.25 COL 2 WIDGET-ID 18
     1715       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1716            SIDE-LABELS NO-UNDERLINE THREE-D
     1717            AT COL 1 ROW 1 SCROLLABLE .
     1718   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1719   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1720   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1721   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1722   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1723   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1724   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1725   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1726         adm-object-hdl = FRAME F-Main:HANDLE.
     1727   RUN ensure-broker.
     1728   THIS-PROCEDURE:ADM-DATA =
     1729        'ADM1.1~`':U +
     1730        'SmartObject~`':U +
     1731        '~`':U +
     1732        'NO ~`':U +
     1733        '~`':U +
     1734        '~`':U +
     1735        '~`':U +
     1736        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1737           + "~`":U +
     1738        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1739        'Record-Source,Record-Target,TableIO-Target~`':U +
     1740        '~`':U +
     1741        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1742        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1743            THEN "^^":U
     1744        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1745             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1746   PROCEDURE adm-apply-entry :
     1747     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1748   END PROCEDURE.
     1749   PROCEDURE adm-destroy :
     1750    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1751   END PROCEDURE.
     1752   PROCEDURE adm-disable :
     1753       DISABLE RECT-13 TOG-itog SEL-oplat WITH FRAME F-Main.
     1754       RUN dispatch ('disable-fields':U).
     1755       RUN set-attribute-list ('ENABLED=no':U).
     1756       RETURN.
     1757   END PROCEDURE.
     1758   PROCEDURE adm-edit-attribute-list :
     1759         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1760         RETURN.
     1761   END PROCEDURE.
     1762   PROCEDURE adm-enable :
     1763       ENABLE UNLESS-HIDDEN RECT-13 TOG-itog SEL-oplat WITH FRAME F-Main.
     1764       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1765       RUN set-attribute-list ('ENABLED=yes':U).
     1766       RETURN.
     1767   END PROCEDURE.
     1768   PROCEDURE adm-exit :
     1769        RUN notify ('exit':U).
     1770     RETURN.
     1771   END PROCEDURE.
     1772   PROCEDURE adm-hide :
