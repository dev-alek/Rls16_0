     1946   PROCEDURE check-modified :
     1947   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1948   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1949   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1950   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1951     IF check-state = "check":U THEN
     1952     DO:
     1953       RUN get-link-handle IN adm-broker-hdl
     1954         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1955            OUTPUT group-target-list).
     1956       IF group-target-list NE "":U THEN
     1957       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1958         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1959         RUN check-modified IN curr-widget ('group-check':U).
     1960         IF RETURN-VALUE NE "":U THEN
     1961         DO:
     1962           RUN check-modified-message(RETURN-VALUE).
     1963           RETURN "":U.
     1964         END.
     1965       END.
     1966     END.
     1967     RETURN "":U.
     1968   END PROCEDURE.
     1969   PROCEDURE check-modified-message :
     1970     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1971        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1972           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1973        IF RETURN-VALUE = "YES":U THEN
     1974           RUN notify ('view,CONTAINER-SOURCE':U).
     1975        MESSAGE IF p-changed-table NE ? THEN
     1976           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1977           ELSE "Current values have been changed."
     1978           SKIP "  Do you wish to save those changes?"
     1979           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1980        IF ANS THEN
     1981        DO:
     1982           IF group-assign-target THEN
     1983             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1984           ELSE RUN dispatch('update-record':U).
     1985           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1986           DO:
     1987               MESSAGE "Changes to the previous record were not saved."
     1988                 VIEW-AS ALERT-BOX ERROR.
     1989               IF group-assign-target THEN
     1990                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1991               ELSE RUN dispatch ('cancel-record':U).
     1992           END.
     1993        END.
     1994        ELSE DO:
     1995          IF group-assign-target THEN
     1996             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1997          ELSE RUN dispatch('cancel-record':U).
     1998        END.
     1999        RETURN.
     2000   END PROCEDURE.
     2001   PROCEDURE get-rowid :
     2002       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     2003       ASSIGN
     2004       p-table   =   adm-first-table.
     2005       RETURN.
     2006   END PROCEDURE.
     2007   PROCEDURE init-group-assign :
     2008       RUN request-attribute IN adm-broker-hdl
     2009         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     2010       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     2011         group-assign-target = yes.
     2012       ELSE group-assign-target = no.
     2013       RETURN.
     2014   END PROCEDURE.
     2015   PROCEDURE set-editors :
     2016       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     2017       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     2018       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     2019       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     2020       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     2021       DO WHILE VALID-HANDLE (curr-widget):
     2022           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     2023              curr-widget:HIDDEN = no THEN DO:
     2024             CASE p-field-setting:
     2025               WHEN "INITIALIZE":U THEN
     2026               DO:
     2027                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     2028                     read-only-list +
     2029                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     2030                        STRING(curr-widget).
     2031               END.
     2032               WHEN "DISABLE":U OR
     2033               WHEN "ENABLE":U THEN
     2034               DO:
     2035                   curr-widget:SENSITIVE = yes.
     2036                   RUN get-attribute ('Read-Only-Editors':U).
     2037                   IF RETURN-VALUE = ? OR
     2038                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     2039                       curr-widget:READ-ONLY =
     2040                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     2041               END.
     2042               WHEN "CLEAR":U THEN
     2043                   curr-widget:SCREEN-VALUE = "":U.
     2044             END CASE.
     2045           END.
     2046           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     2047       END.
     2048       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     2049         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     2050           + '"':U).
     2051       RETURN.
     2052   END PROCEDURE.
     2053   PROCEDURE use-check-modified-all :
     2054    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2055     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     2056     RETURN.
     2057   END PROCEDURE.
     2058   PROCEDURE use-create-on-add :
     2059   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2060      RETURN.
     2061   END PROCEDURE.
     2062   PROCEDURE use-initial-lock :
     2063     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     2064     ASSIGN adm-initial-lock = p-attr-value.
     2065     RETURN.
     2066   END PROCEDURE.
     2067     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     2068   ASSIGN
     2069          FRAME F-Main:SCROLLABLE       = FALSE
     2070          FRAME F-Main:HIDDEN           = TRUE
     2071          FRAME F-Main:PRIVATE-DATA     =
     2072                   "DLGCLOSE".
     2073   ON VALUE-CHANGED OF SEL-oplat IN FRAME F-Main
     2074   DO:
     2075     assign sel-oplat .
     2076   END.
     2077   ON VALUE-CHANGED OF TOG-itog IN FRAME F-Main
     2078   DO:
     2079     assign tog-itog.
     2080   assign
     2081     v-itog = tog-itog
     2082   .
     2083   END.
     2084   if not this-procedure :persistent
     2085   then do:
     2086     message
     2087       vss-workfile vss-revision vss-description skip
     2088       "Ошибка при запуске процедуры" skip
     2089       "Данную процедуру следует запускать только с параметром persistent" skip
     2090       view-as alert-box error .
     2091     undo, return error .
     2092   end.
     2093    run init-temp .
     2094   PROCEDURE disable_UI :
     2095     HIDE FRAME F-Main.
     2096     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     2097   END PROCEDURE.
     2098   PROCEDURE init-temp :
     2099   define variable v-oplat as character no-undo .
     2100   v-oplat = "" + chr(44) + '-1':U .
     2101   for each ub.cash-pay no-lock where ub.cash-pay.status_ = 'тек':U:
     2102       v-oplat = v-oplat + chr(44) + ub.cash-pay.obj-name + chr(44) + string(ub.cash-pay.cdpay-code) .
     2103   end.
     2104   ASSIGN
     2105           SEL-oplat:LIST-ITEM-PAIRS  in frame F-Main = v-oplat .
     2106   END PROCEDURE.
     2107   PROCEDURE local-initialize :
     2108     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     2109   END PROCEDURE.
     2110   PROCEDURE my-params :
     2111   define input parameter p-action as character no-undo .
     2112   define variable v-index-id as integer no-undo .
     2113   define variable v-value-character as character no-undo .
     2114   define variable v-value-date as date no-undo .
     2115   define variable v-value-decimal as decimal no-undo .
     2116   define variable v-value-integer as integer no-undo .
     2117   define variable v-value-logical as logical no-undo .
     2118   END PROCEDURE.
     2119   PROCEDURE my-report :
     2120   run rep/r-chk_return.p
     2121       (
     2122        input my-handle
     2123       ,input TOG-itog
     2124       ,input SEL-oplat
     2125         ) .
     2126   END PROCEDURE.
     2127   PROCEDURE my-var :
     2128   assign frame F-Main TOG-itog
     2129   .
     2130   END PROCEDURE.
     2131   PROCEDURE write-to-log :
     2132   define input param p-str as char no-undo.
     2133   do
     2134   on error undo, return error
     2135   :
     2136      message
     2137         p-str
     2138         skip
     2139      view-as alert-box error.
     2140   end.
     2141   END PROCEDURE.
