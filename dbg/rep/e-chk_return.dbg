     1875     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1876     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1877     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1878     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1879     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1880     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1881     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1882     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1883     IF "":U = "":U THEN
     1884       RUN modify-list-attribute IN adm-broker-hdl
     1885         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1886     RUN use-create-on-add(?).
     1887   PROCEDURE adm-add-record :
