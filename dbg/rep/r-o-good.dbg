     2153        trim( string( (Coast1 - Coast-vat1  ) , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2154        curr-rep
     2155        ) format "x(72)"
     2156        SKIP.
     2157   end.
     2158   Else   PUT STREAM OutStream
     2159   SPACE(23) string(  "Cумма ПРОДАЖНЫХ цен: " +
     2160               trim( string( Coast1, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2161               curr-rep
     2162             ) format "x(72)"
     2163             SKIP.
     2164   .
     2165           if no-prise then do:
     2166   define variable vss-include-info20 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2167   PUT STREAM OutStream
     2168   SPACE(23)
     2169   string( "Cумма ПРОДАЖНЫХ цен: " +
     2170                 trim( string( Coast3, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2171                 curr-rep
     2172               ) format "x(72)"
     2173     SKIP
     2174     .
     2175     end.
     2176           if xtype =  "" then  do: display stream outstream  with frame top-frame . end.
     2177       End.
     2178   END PROCEDURE.
     2179   PROCEDURE Print-Footer :
     2180   IF NOT ( tot-qnty       = 0  and
     2181      tot-SumSALE    = 0  and
     2182      tot-SumCOST    = 0  and
     2183      tot-SumCRSA    = 0  and
     2184      tot-discnt-sum = 0  and
     2185      tot-ov-sum     = 0  and
     2186      tot-VAT-Sum    = 0  and
