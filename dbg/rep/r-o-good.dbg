     1498   DEFINE FRAME InfoFrame
     1499        StopBtn AT ROW 4.25 COL 21.75
     1500        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1501        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1502        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1503        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1504        RECT-1 AT ROW 1 COL 1
     1505       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1506            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1507            TITLE "Процесс"
     1508            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1509   define variable mFrameView      as logical   no-undo init yes.
     1510     define variable mFramHandle as handle no-undo.
     1511     mFramHandle = frame InfoFrame:handle.
     1512     if  log-manager:logfile-name ne ?
     1513     then DO:
     1514         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1515         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1516         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1517     end.
     1518     mFrameView = not session:batch-mode and mFramHandle:visible.
     1519     if mFrameView
     1520     then do:
     1521       ASSIGN
     1522          FRAME InfoFrame:HIDDEN                           = TRUE
     1523          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1524     end.
     1525   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1526   DO:
     1527     IF not StopProcessing THEN
     1528       Message "Вы действительно хотите прервать" SKIP
     1529               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1530                 UPDATE StopProcessing.
     1531     IF StopProcessing THEN do:
     1532        if mFrameView
     1533        then do:
     1534           HIDE FRAME InfoFrame.
     1535        end.
     1536     End.
     1537   END.
     1538   assign v-account = ( if integer( 50 ) = 0 then 100 else integer( 50 ) ).
     1539     if  log-manager:logfile-name ne ?
     1540     then DO:
     1541         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1542     end.
     1543     if not session:batch-mode then
     1544     do:
     1545       VIEW FRAME InfoFrame.
     1546       mFrameView = true.
     1547     end.
     1548      v-button-stop = false .
     1549         if mFrameView
     1550         then do:
     1551         if v-button-stop then view STOPBTN in frame InfoFrame.
     1552                          else Hide STOPBTN in frame InfoFrame.
     1553         end.
     1554   DEFINE FRAME top-frame
