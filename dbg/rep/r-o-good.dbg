      757   procedure partrqst :
      758     define input  parameter p-doc-code                   like ub.doc-line.doc-code  no-undo .
      759     define input  parameter p-obj-type                   like ub.doc-line.obj-type  no-undo .
      760     define input  parameter p-obj-code                   like ub.doc-line.obj-code  no-undo .
      761     define input  parameter p-artic                      like ub.doc-line.artic     no-undo .
      762     define input  parameter p-prod-type                  like ub.doc-line.prod-type no-undo .
      763     define input  parameter p-prod-code                  like ub.doc-line.prod-code no-undo .
      764     define output parameter p-total-parts-qnty           like ub.parts.qnty         no-undo .
      765     define output parameter p-total-parts-fact-qnty      like ub.parts.fact-qnty    no-undo .
      766     define output parameter p-total-parts-cli-qnty       like ub.parts.cli-qnty     no-undo .
      767     define output parameter p-total-parts-fact-cli-qnty  like ub.parts.cli-qnty     no-undo .
      768     define output parameter p-total-parts-price-cli      as decimal                 no-undo .
      769     define output parameter p-total-parts-price-base     as decimal                 no-undo .
      770     define output parameter p-total-parts-price-rubl     as decimal                 no-undo .
      771     define output parameter p-total-parts-transport-base as decimal                 no-undo .
      772     define output parameter p-total-parts-transport-rubl as decimal                 no-undo .
      773     define output parameter p-total-parts-other-base     as decimal                 no-undo .
      774     define output parameter p-total-parts-other-rubl     as decimal                 no-undo .
      775     define variable vss-description as character no-undo init "partrqst: Суммарная информация по всем зарезервированным партиям строки документа".
      776     do
      777     on error undo, return error return-value
      778     :
      779       assign
      780         p-total-parts-qnty           = 0
      781         p-total-parts-fact-qnty      = 0
      782         p-total-parts-cli-qnty       = 0
      783         p-total-parts-fact-cli-qnty  = 0
      784         p-total-parts-price-cli      = 0
      785         p-total-parts-price-base     = 0
      786         p-total-parts-price-rubl     = 0
      787         p-total-parts-transport-base = 0
      788         p-total-parts-transport-rubl = 0
      789         p-total-parts-other-base     = 0
      790         p-total-parts-other-rubl     = 0
      791       .
      792       define buffer buf_parts for ub.parts .
      793       for each buf_parts no-lock
      794         where buf_parts.out-code  = p-doc-code
      795           and buf_parts.obj-type  = p-obj-type
      796           and buf_parts.obj-code  = p-obj-code
      797           and buf_parts.artic     = p-artic
      798           and buf_parts.prod-type = p-prod-type
      799           and buf_parts.prod-code = p-prod-code
      800       on error undo, return error return-value
      801       :
      802         define variable v-parts-fact-multiplier as decimal   no-undo .
      803         assign
      804           v-parts-fact-multiplier = 1
      805         .
      806         if buf_parts.qnty <> 0 then do:
      807           assign
      808             v-parts-fact-multiplier = buf_parts.fact-qnty / buf_parts.qnty
      809           .
      810         end.
      811         assign
      812           p-total-parts-qnty            = p-total-parts-qnty       + buf_parts.qnty
      813           p-total-parts-fact-qnty       = p-total-parts-fact-qnty  + buf_parts.fact-qnty
      814           p-total-parts-cli-qnty        = p-total-parts-cli-qnty   + buf_parts.cli-qnty
      815           p-total-parts-fact-cli-qnty   = p-total-parts-fact-cli-qnty
      816                                         + buf_parts.cli-qnty * v-parts-fact-multiplier
      817           p-total-parts-price-cli       = p-total-parts-price-cli  + buf_parts.cli-qnty  * buf_parts.price-cli
      818           p-total-parts-price-base      = p-total-parts-price-base + buf_parts.fact-qnty * buf_parts.price-base
      819           p-total-parts-price-rubl      = p-total-parts-price-rubl + buf_parts.fact-qnty * buf_parts.price-rubl
      820           p-total-parts-transport-base  = p-total-parts-transport-base
      821                                         + buf_parts.fact-qnty
      822                                           * (if   buf_parts.transport-base <> ?
      823                                             then buf_parts.transport-base
      824                                             else 0
      825                                             )
      826           p-total-parts-transport-rubl  = p-total-parts-transport-rubl
      827                                         + buf_parts.fact-qnty
      828                                           * (if   buf_parts.transport-rubl <> ?
      829                                             then buf_parts.transport-rubl
      830                                             else 0
      831                                             )
      832           p-total-parts-other-base      = p-total-parts-other-base
      833                                         + buf_parts.fact-qnty
      834                                           * (if   buf_parts.other-base <> ?
      835                                             then buf_parts.other-base
      836                                             else 0
      837                                             )
      838           p-total-parts-other-rubl      = p-total-parts-other-rubl
      839                                         + buf_parts.fact-qnty
      840                                           * (if   buf_parts.other-rubl <> ?
      841                                             then buf_parts.other-rubl
      842                                             else 0
      843                                             )
      844         .
      845       end.
      846     end.
      847   end procedure.
      848   function func-vat returns decimal (
      849       input p-gds-code as integer  ,
      850       input p-obj-type as character ,
      851       input p-obj-code as integer  ).
      852   define variable i-vat-pc as decimal no-undo .
      853   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      854   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
      855     (input  p-gds-code
      856     ,input  '1':U
      857     ,input  x-Date-End
      858     ,input  v-cntxt-host-code-obj
      859     ,input  p-obj-type
      860     ,input  p-obj-code
      861     ,output i-vat-pc
      862     ) no-error .
      863   if error-status :error then return 0 .
      864   else return i-vat-pc.
      865   end function .
      866   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      867   procedure cur-time :
      868      define output parameter p-today as date      no-undo .
      869      define output parameter p-time  as integer   no-undo .
      870     do
      871     on error undo, return error
      872     :
      873       define variable v-date1 as date      no-undo .
      874       define variable v-date2 as date      no-undo .
      875       define variable v-time  as integer   no-undo .
      876       assign
      877         v-date1 = today
      878         v-time  = time
      879         v-date2 = today
      880       .
      881       if v-date1 <> v-date2
      882       then do:
      883         assign
      884           v-date1 = today
      885           v-time  = v-time
      886         .
      887       end.
      888       assign
      889         p-today = v-date1
      890         p-time  = v-time
      891       .
      892     end.
      893   end.
      894   function cur-time-date returns character
      895   :
      896     return string(today, '99/99/9999':U) .
      897   end.
      898   function cur-time-mjd returns decimal
      899   :
      900     define variable v-date as date      no-undo .
      901     define variable v-time as integer   no-undo .
      902     run cur-time in this-procedure
      903       (output v-date
      904       ,output v-time
      905       ) .
      906     return integer(v-date) - 2400002 + (v-time / 86400) .
      907   end.
      908   function cur-time-get-ending-index returns integer
      909   (input p-number as integer
      910   )
      911   :
      912     if p-number < 0
      913     or p-number = ?
      914     then do:
      915       return 1 .
      916     end.
      917     define variable v-rest as integer   no-undo .
      918     assign
      919       p-number = p-number modulo 100
      920     .
      921     if p-number < 20
      922     then do:
      923       assign
      924         v-rest = p-number
      925       .
      926     end.
      927     else do:
      928       assign
      929         v-rest = p-number modulo 10
      930       .
      931     end.
      932     case v-rest :
      933       when 1
      934       then do:
      935         return 2 .
      936       end.
      937       when 2 or
      938       when 3 or
      939       when 4
      940       then do:
      941         return 3 .
      942       end.
      943       otherwise do:
      944         return 1 .
      945       end.
      946     end case .
      947   end.
      948   procedure cur-time-mjd-to-date :
      949      define input  parameter i-mjd-diff as decimal no-undo.
      950      define output parameter o-Date     as date    no-undo.
      951      define output parameter o-Time     as integer no-undo.
      952      define variable v-day-number as integer   no-undo .
      953      if    i-mjd-diff < 0
      954         or i-mjd-diff = ?
      955      then do:
      956         return "?" .
      957      end.
      958      assign
      959         v-day-number = truncate(i-mjd-diff,0).
      960         o-Date = date(v-day-number + 2400002).
      961         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      962     .
      963   end.
      964   function cur-time-mjd-to-string returns character
      965   (input p-mjd-diff as decimal
      966   )
      967   :
      968     define variable v-day-number as integer   no-undo .
      969     define variable v-seconds    as integer   no-undo .
      970     define variable v-hour       as integer   no-undo .
      971     define variable v-min        as integer   no-undo .
      972     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      973     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      974     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      975     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      976     if p-mjd-diff < 0
      977     or p-mjd-diff = ?
      978     then do:
      979       return "?" .
      980     end.
      981     assign
      982       v-day-number = integer(truncate(p-mjd-diff,0))
      983       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      984     .
      985     if v-seconds > 86400
      986     then do:
      987       assign
      988         v-seconds = 86400 - 1
      989       .
      990     end.
      991     if v-seconds < 0
      992     then do:
      993       assign
      994         v-seconds = 0
      995       .
      996     end.
      997     assign
      998       v-hour = truncate(v-seconds / 3600, 0)
      999     .
     1000     assign
     1001       v-seconds = v-seconds modulo 3600
     1002     .
     1003     assign
     1004       v-min = truncate(v-seconds / 60, 0)
     1005     .
     1006     assign
     1007       v-seconds = v-seconds modulo 60
     1008     .
     1009     return
     1010         (if v-day-number <> 0
     1011           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     1012           else ""
     1013         )
     1014       + (if v-day-number <> 0 or v-hour <> 0
     1015           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     1016           else ""
     1017         )
     1018       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     1019           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     1020           else ""
     1021         )
     1022       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     1023       .
     1024   end.
     1025   function cur-time-string returns character
     1026   :
     1027     define variable v-date as date      no-undo .
     1028     define variable v-time as integer   no-undo .
     1029     run cur-time in this-procedure
     1030       (output v-date
     1031       ,output v-time
     1032       ) .
     1033     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     1034   end.
     1035   function cur-time-string-sec returns character
     1036   :
     1037     define variable v-date as date      no-undo .
     1038     define variable v-time as integer   no-undo .
     1039     run cur-time in this-procedure
     1040       (output v-date
     1041       ,output v-time
     1042       ) .
     1043     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     1044   end.
     1045   function cur-time-custom  returns character
     1046   (input p-prefix as character
     1047   ,input p-date-format as character
     1048   ,input p-delimiter as character
     1049   ,input p-time-format as character
     1050   ,input p-suffix as character
     1051   )
     1052   :
     1053     define variable v-date as date      no-undo .
     1054     define variable v-time as integer   no-undo .
     1055     run cur-time in this-procedure
     1056       (output v-date
     1057       ,output v-time
     1058       ) .
     1059     return
     1060       p-prefix
     1061       + string(v-date, p-date-format)
     1062       + p-delimiter
     1063       + string(v-time, p-time-format)
     1064       + p-suffix
     1065       .
     1066   end.
     1067   function cur-time-print  returns character
     1068   :
     1069     define variable v-date as date      no-undo .
     1070     define variable v-time as integer   no-undo .
     1071     run cur-time in this-procedure
     1072       (output v-date
     1073       ,output v-time
     1074       ) .
     1075     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     1076   end.
     1077   function cur-time-datetime returns datetime
     1078   :
     1079     define variable v-char as character no-undo .
     1080     define variable v-datetime as datetime no-undo .
     1081     v-char = cur-time-string().
     1082     v-datetime = datetime(v-char).
     1083     return  v-datetime.
     1084   end.
     1085   function cur-time-string-msec returns character
     1086   :
     1087     define variable v-date as datetime  no-undo .
     1088     v-date = now.
     1089     return string(v-date) .
     1090   end.
     1091   define temp-table temp-font no-undo
     1092     field fontnum  as integer
     1093     field fontname as character
     1094     field fontsize as character
     1095     field fonttype as character
     1096     field font-h   as integer
     1097     field font-w   as integer
     1098     field v-row    as integer
     1099     field v-col    as integer
     1100     field v-row-lans as integer
     1101     field v-col-lans as integer
     1102   index pi fontnum
     1103   .
     1104   procedure get-font-ini :
     1105     do
     1106     on error undo, return error return-value
     1107     :
     1108   define variable ii as integer   no-undo .
     1109   define variable v-font7 as character no-undo .
     1110   define variable v-font as character no-undo .
     1111   define variable loc-name as character no-undo .
     1112   define variable loc-size as character no-undo .
     1113   define variable loc-type as character no-undo .
     1114   define variable old_H as integer   no-undo .
     1115   define variable old_w as integer   no-undo .
     1116   define variable old-row  as integer   no-undo .
     1117   define variable old-col  as integer   no-undo .
     1118   define variable old-row-lans  as integer   no-undo .
     1119   define variable old-col-lans  as integer   no-undo .
     1120   define variable vv as integer   no-undo .
     1121   empty temp-table temp-font.
     1122     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1123       case num-entries (v-font7) :
     1124         when 4 then do:
     1125             assign
     1126               loc-name = entry ( 1 , v-font7 )
     1127               loc-size = entry ( 2 , v-font7 )
     1128               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1129             .
     1130         end.
     1131         when 3 then do:
     1132             assign
     1133               loc-name = entry ( 1 , v-font7 )
     1134               loc-size = entry ( 2 , v-font7 )
     1135               loc-type = entry ( 3 , v-font7 )
     1136             .
     1137         end.
     1138         when 2 then  do:
     1139             assign
     1140               loc-name = entry ( 1 , v-font7 )
     1141               loc-size = entry ( 2 , v-font7 )
     1142               loc-type = ""
     1143             .
     1144         end.
     1145         when 1 then do:
     1146             assign
     1147               loc-name = trim(entry ( 1 , v-font7 ))
     1148               loc-size = ""
     1149               loc-type = ""
     1150             .
     1151         end.
     1152       end case.
     1153     create temp-font.
     1154     assign
     1155       temp-font.fontnum  = 7
     1156       temp-font.fontname = trim(loc-name)
     1157       temp-font.fontsize = trim(loc-size)
     1158       temp-font.fonttype = trim(loc-type)
     1159       temp-font.v-row    = 62
     1160       temp-font.v-col    = 136
     1161       temp-font.v-row-lans = 43
     1162       temp-font.v-col-lans = 198
     1163     .
     1164     repeat ii = 16 to 100 :
     1165       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1166       if v-font = "" or v-font = ? then leave.
     1167       case num-entries (v-font) :
     1168         when 4 then do:
     1169             assign
     1170               loc-name = entry ( 1 , v-font )
     1171               loc-size = entry ( 2 , v-font )
     1172               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1173             .
     1174         end.
     1175         when 3 then do:
     1176             assign
     1177               loc-name = entry ( 1 , v-font )
     1178               loc-size = entry ( 2 , v-font )
     1179               loc-type = entry ( 3 , v-font )
     1180             .
     1181         end.
     1182         when 2 then do:
     1183             assign
     1184               loc-name = entry ( 1 , v-font )
     1185               loc-size = entry ( 2 , v-font )
     1186               loc-type = ""
     1187             .
     1188         end.
     1189         when 1 then do:
     1190             assign
     1191               loc-name = trim(entry ( 1 , v-font ))
     1192               loc-size = ""
     1193               loc-type = ""
     1194             .
     1195         end.
     1196       end case.
     1197     create temp-font.
     1198     assign
     1199       temp-font.fontnum  = ii
     1200       temp-font.fontname = trim(loc-name)
     1201       temp-font.fontsize = trim(loc-size)
     1202       temp-font.fonttype = trim(loc-type)
     1203     .
     1204     end.
     1205       for each temp-font :
     1206          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1207          if  vv = ? then vv =  0 .
     1208           run rep/exfont.p (
     1209             input   temp-font.fontname ,
     1210             input   vv ,
     1211             input   temp-font.fonttype ,
     1212             output  temp-font.font-h   ,
     1213             output  temp-font.font-w   )
     1214           .
     1215       end.
     1216   find first temp-font where  temp-font.fontnum  = 7  .
     1217   old_H = temp-font.font-H .
     1218   old_w = temp-font.font-W .
     1219   old-row = temp-font.v-row .
     1220   old-col = temp-font.v-col .
     1221   old-row-lans = temp-font.v-row-lans .
     1222   old-col-lans = temp-font.v-col-lans .
     1223       for each temp-font where
     1224                temp-font.fontnum  <> 7 :
     1225           assign
     1226               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1227               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1228               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1229               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1230           .
     1231       end.
     1232     end.
     1233   end procedure.
     1234   PROCEDURE How-name :
     1235   define input  parameter h as integer no-undo .
     1236   define input  parameter w as integer no-undo .
     1237   define output parameter n as character  no-undo .
     1238   define variable A4port-H as integer   no-undo init 63.
     1239   define variable A4port-W as integer   no-undo init 136.
     1240   define variable A4lans-H as integer   no-undo init 43.
     1241   define variable A4lans-W as integer   no-undo init 198.
     1242   define variable Strim-W  as integer   no-undo init 278.
     1243   run define-a4-size (
     1244        input ReportFontNum
     1245       ,output A4port-H
     1246       ,output A4port-W
     1247       ,output A4lans-H
     1248       ,output A4lans-W ).
     1249   If w >= 1 and w <= A4port-W Then DO:
     1250     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1251     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1252     If h > A4port-H              Then n = "to-file":U.
     1253   End.
     1254   If w > A4port-W and w <= A4lans-W Then DO:
     1255     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1256     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1257     If h > A4port-H              Then n = "to-file":U.
     1258   End.
     1259   If w > A4lans-W and w <= Strim-W Then DO:
     1260     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1261     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1262     If h > A4port-H              Then n = "to-file":U.
     1263   End.
     1264   If w > Strim-W Then DO:
     1265      n = "to-file":U.
     1266   End.
     1267   END PROCEDURE.
     1268   PROCEDURE define-a4-size :
     1269   define input  parameter p-ReportFontNum as integer   no-undo .
     1270   define output parameter A4port-H as integer   no-undo .
     1271   define output parameter A4port-W as integer   no-undo .
     1272   define output parameter A4lans-H as integer   no-undo .
     1273   define output parameter A4lans-W as integer   no-undo .
     1274   if not can-find (first temp-font ) then do:
     1275      run get-font-ini .
     1276   end.
     1277   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1278   if available temp-font then do:
     1279   assign
     1280     A4port-H = temp-font.v-row
     1281     A4port-W = temp-font.v-col
     1282     A4lans-H = temp-font.v-row-lans
     1283     A4lans-W = temp-font.v-col-lans
     1284   .
     1285   end.
     1286   else do:
     1287   assign
     1288     A4port-H = 63
     1289     A4port-W = 136
     1290     A4lans-H = 43
     1291     A4lans-W = 198
     1292   .
     1293   end.
     1294   END PROCEDURE.
