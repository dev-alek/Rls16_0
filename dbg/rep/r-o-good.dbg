     1599      with width 232 down stream-io use-text NO-BOX .
     1600        assign
     1601           i=0
     1602           Select-Good   = x-SelectGood
     1603           PayType       = x-SET_PAY_TYPE
     1604           FirstLine     = FALSE.
     1605           Line          = fill("-", 232).
     1606           startdate     = x-Date-Start           .
     1607           enddate       = x-Date-End             .
     1608           ValType       = IF (PayType = 1) Then 0  else x-SET_val_TYPE.
     1609           tow-unit = false .
     1610           if Num-entries(xType) = 3 then
     1611              If entry(3,xType) = 'yes' Then tow-unit = true .
     1612           sums-only = (if entry(2,xtype) = "yes" then  true
     1613                                                  else false )  no-error .
     1614           if sums-only = ? then sums-only = false .
     1615   define variable vss-include-info17 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1616   do:
     1617     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1618       (input  v-cntxt-db-num
