     2134       ,input  v-cntxt-host-code-obj
     2135       ,input  v-cntxt-obj-type
     2136       ,input  v-cntxt-obj-code
     2137       ,input  0
     2138       ,input  0
     2139       ,input  0
     2140       ,input  false
     2141       ,output v-log
     2142       )  .
     2143   end.
     2144   if  v-log = true  then
     2145   PUT STREAM OutStream
     2146   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     2147               trim( string( Coast1 , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2148               curr-rep
     2149             ) format "x(72)"
     2150             SKIP.
     2151   PUT STREAM OutStream
