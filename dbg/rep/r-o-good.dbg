     2267   PUT STREAM OutStream
     2268   SPACE(23)
     2269   string( "Cумма ПРОДАЖНЫХ цен: " +
     2270                 trim( string( Coast, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2271                 curr-rep
     2272               ) format "x(72)"
     2273     SKIP
     2274     .
     2275   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2276   CASE "2" :
     2277   WHEN  "1" then
     2278   TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     2279   WHEN "2" then
     2280   TEMPSTR = string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     2281   OTHERWISE
     2282   TEMPSTR =string( "Оборот с " + string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) )  .
     2283   end CASE.
     2284   PUT STREAM OutStream
     2285   SKIP
     2286   SPACE(5)
     2287   TEMPSTR format "x(72)"
     2288   SKIP
     2289   SPACE(32) string( "Количество: " + trim( string( Quantity2, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     2290   SKIP.
     2291   IF PayType = 2 OR PayType = 0  then do:
     2292   define variable vss-include-info25 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2293   do:
     2294     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2295       (input  v-cntxt-db-num
     2296       ,input  v-cntxt-userid
     2297       ,input  0
     2298       ,input  'actn_reports_lookup-cost':U
     2299       ,input  'object':U
     2300       ,input  v-cntxt-host-code-obj
     2301       ,input  v-cntxt-obj-type
     2302       ,input  v-cntxt-obj-code
     2303       ,input  0
     2304       ,input  0
     2305       ,input  0
     2306       ,input  false
     2307       ,output v-log
     2308       )  .
     2309   end.
     2310   if  v-log = true  then
     2311   PUT STREAM OutStream
     2312   SPACE(23) string( "Cумма   УЧЕТНЫХ  цен: " +
     2313               trim( string( Coast2 , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2314               curr-rep
     2315             ) format "x(72)"
     2316             SKIP.
     2317   PUT STREAM OutStream
     2318   SPACE(23) string( "Cумма УЧЕТНЫХ цен без НДС: " +
     2319        trim( string( (Coast2 - Coast-vat2  ) , "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2320        curr-rep
     2321        ) format "x(72)"
     2322        SKIP.
     2323   end.
     2324   Else   PUT STREAM OutStream
     2325   SPACE(23) string(  "Cумма ПРОДАЖНЫХ цен: " +
     2326               trim( string( Coast2, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2327               curr-rep
     2328             ) format "x(72)"
     2329             SKIP.
     2330   .
     2331         if NO-PRISE Then DO:
     2332   define variable vss-include-info26 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2333   PUT STREAM OutStream
     2334   SPACE(23)
     2335   string( "Cумма ПРОДАЖНЫХ цен: " +
     2336                 trim( string( Coast4, "->>>,>>>,>>>,>>>,>>9.99" ) ) + " " +
     2337                 curr-rep
     2338               ) format "x(72)"
     2339     SKIP
     2340     .
     2341      End.
     2342      End.
     2343   END PROCEDURE.
     2344   PROCEDURE U-LINE :
     2345   UNDERLINE stream OutStream  sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 Sym13 sym17
     2346   F-fact-date
     2347   f-type-doc
     2348   f-doc-code
     2349   f-cli-name
     2350   F-qnty
     2351   f-SumSALE
     2352   f-SumCOST
     2353   f-SumCRSA
     2354   f-discnt-sum
     2355   f-ov-sum
     2356   F-VAT_pc
     2357   F-VAT-Sum
     2358   F-SLT_pc
     2359   F-SLT-sum
     2360   sym14 when  (h-kol-1 <> ?)
     2361   sym15 when  (h-kol-1 <> ?)
     2362   sym16 when  (h-kol-1 <> ?)
     2363   with FRAME ZAPAS .
     2364   DOWN stream   OutStream 1 with FRAME ZAPAS.
     2365   END PROCEDURE.
     2366   PROCEDURE P-LINE :
     2367   UNDERLINE stream OutStream        with FRAME ZAPAS.        DOWN stream   OutStream 1 with FRAME ZAPAS .
     2368   END PROCEDURE.
     2369   PROCEDURE CalcItog :
     2370       run ostatok (
     2371           input x-store-code  ,
     2372           input x-store-type  ,x-TOG-Shift,
     2373           input x-date-start - 1 ,
     2374           input date('')      ,  x-Shift-Start,x-Shift-End,
     2375           input 'crsa':U   ,
     2376           input '##,##':U,
     2377           input true ,
     2378           output  Quantity1  ,
     2379           output  Coast_R1   ,
     2380           output  Coast_V1   ,
     2381           output  VAT_R1     ,
     2382           output  VAT_V1     ,
     2383           output  Fact-order-1 ).
     2384       run ostatok (
     2385           input x-store-code  ,
     2386           input x-store-type  ,x-TOG-Shift,
     2387           input x-date-start  ,
     2388           input x-date-end    ,  x-Shift-Start,x-Shift-End,
     2389           input 'crsa':U   ,
     2390           input '##,##':U,
     2391           input true ,
     2392           output  Quantity1  ,
     2393           output  Coast_R1   ,
     2394           output  Coast_V1   ,
     2395           output  VAT_R1     ,
     2396           output  VAT_V1     ,
     2397           output  Fact-order-2 ).
     2398       if xtog-inv and inv-fact-order > 0 then  Fact-order-1 = inv-fact-order.
     2399       run ost-line (
     2400           input x-store-code  ,
     2401           input x-store-type  ,
     2402           input gds-list.artic       ,
     2403           input gds-list.prod-code   ,
     2404           input gds-list.prod-type    ,
     2405           input x-TOG-Shift ,
     2406           input Fact-order-1 ,
     2407           input 'cost':U   ,
     2408           input '##,##':U,
     2409           input YES ,
     2410           output  Quantity1  ,
     2411           output  Coast_R1   ,
     2412           output  Coast_V1   ,
     2413           output  VAT_R1     ,
     2414           output  VAT_V1     ,
     2415           output  slt_R1     ,
     2416           output  slt_V1     ).
     2417           Coast1 =  IF tPrintRubl then  Coast_R1
     2418                                   else  Coast_V1 .
     2419           Coast-vat1 =  IF tPrintRubl then  vat_R1
     2420                                       else  vat_V1 .
     2421           run ost-line (
     2422           input x-store-code  ,
     2423           input x-store-type  ,
     2424           input gds-list.artic       ,
     2425           input gds-list.prod-code   ,
     2426           input gds-list.prod-type   ,
     2427           input x-TOG-Shift ,
     2428           input Fact-order-1 ,
     2429           input 'crsa':U   ,
     2430           input '##,##':U,
     2431           input YES ,
     2432           output  Quantity1  ,
     2433           output  Coast_R1   ,
     2434           output  Coast_V1   ,
     2435           output  VAT_R1     ,
     2436           output  VAT_V1     ,
     2437           output  slt_R1     ,
     2438           output  slt_V1     ).
     2439           Coast3 =  IF tPrintRubl then  Coast_R1
     2440                                   else  Coast_V1 .
     2441           Coast-vat3 =  IF tPrintRubl then  vat_R1
     2442                                       else  vat_V1 .
     2443   define variable Quantity2-1 as decimal   no-undo .
     2444       run ost-line (
     2445           input x-store-code  ,
     2446           input x-store-type  ,
     2447           input gds-list.artic       ,
     2448           input gds-list.prod-code   ,
     2449           input gds-list.prod-type    ,
     2450           input x-TOG-Shift ,
     2451           input Fact-order-2 ,
     2452           input 'cost':U   ,
     2453           input '##,##':U,
     2454           input YES ,
     2455           output  Quantity2  ,
     2456           output  Coast_R2   ,
     2457           output  Coast_V2   ,
     2458           output  VAT_R2     ,
     2459           output  VAT_V2     ,
     2460           output  slt_R1     ,
     2461           output  slt_V1     ).
     2462           Coast2 =  IF tPrintRubl then  Coast_R2
     2463                                   else  Coast_V2 .
     2464           Coast-vat2 =  IF tPrintRubl then  vat_R2
     2465                                   else  vat_V2 .
     2466       run ost-line (
     2467           input x-store-code  ,
     2468           input x-store-type  ,
     2469           input gds-list.artic       ,
     2470           input gds-list.prod-code   ,
     2471           input gds-list.prod-type    ,
     2472           input x-TOG-Shift ,
     2473           input Fact-order-2 ,
     2474           input 'crsa':U   ,
     2475           input '##,##':U,
     2476           input YES ,
     2477           output  Quantity2-1  ,
     2478           output  Coast_R2   ,
     2479           output  Coast_V2   ,
     2480           output  VAT_R2     ,
     2481           output  VAT_V2     ,
     2482           output  slt_R1     ,
     2483           output  slt_V1     ).
     2484           Coast4 =  IF tPrintRubl then  Coast_R2
     2485                                   else  Coast_V2 .
     2486           Coast-vat4 =  IF tPrintRubl then  vat_R2
     2487                                   else  vat_V2 .
     2488   END PROCEDURE.
     2489   PROCEDURE Display-main-title :
     2490      PUT stream  OutStream  UNFORMATTED  string( v-cntxt-host-name-obj +  " , " + x-store-type  +  " " + ObjName) AT 50 format "X(85)" SKIP(2)
     2491             REPORTNAME  AT 20 format "X(170)" SKIP
     2492             Trim(str1)  AT 35 format "X(75)" SKIP.
     2493   End procedure.
     2494   PROCEDURE Display-title :
     2495        PUT stream  OutStream  UNFORMATTED "Товар  : "
     2496                 + gds-list.artic + " "
     2497                 + gds-list.gds-name
     2498                 AT 1 format "X(170)" SKIP.
     2499        Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2500         PUT stream  OutStream  UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(170)" SKIP.
     2501        End.
     2502       if xtog-inv and inv-fact-order > 0  then do:
     2503               PUT stream  OutStream  UNFORMATTED  inv-str AT 1 format "X(170)" SKIP. end.
     2504       i=0.
     2505   END PROCEDURE.
     2506   PROCEDURE Display-object :
     2507      FIND FIRST ub.clients where x-store-type = ub.clients.obj-type AND
     2508                               x-store-code = ub.clients.obj-code no-lock no-error.
     2509              If available ub.clients then  ObjName = ub.clients.obj-name.
     2510                                            else  ObjName="объект не определен".
     2511        if xtype <> "" then  do:
     2512        display STREAM OutStream  with frame top-Frame .
     2513        run U-line.
     2514        End.
     2515        PUT stream  OutStream  UNFORMATTED  "Объект  : " + ObjName FORMAT "X(170)" skip.
     2516   end procedure.
     2517   PROCEDURE Display-title-mgds :
     2518        PUT stream  OutStream  UNFORMATTED  "Товар  : " + gds-list.artic + " " + gds-list.gds-name + " " +  gds-list.PS  + " (" + gds-list.sort  + "*)"
     2519                    AT 1 format "X(198)" .
     2520        if xtog-inv and inv-fact-order > 0  then do : PUT stream  OutStream  UNFORMATTED  inv-str AT 1 format "X(170)". end.
     2521        PUT stream  OutStream  UNFORMATTED  SKIP.
     2522        run u-line.
     2523        i = 0.
     2524   END PROCEDURE.
     2525   PROCEDURE ob-line  :
     2526   define input  parameter x-store-code     like ub.clients.obj-code     no-undo.
     2527   define input  parameter x-store-type     like ub.clients.obj-type     no-undo.
     2528   define INPUT  parameter x-artic          like ub.ot-line.artic        no-undo.
     2529   define INPUT  parameter x-prod-code      like ub.ot-line.prod-code    no-undo.
     2530   define INPUT  parameter x-prod-type      like ub.ot-line.prod-type    no-undo.
     2531   define INPUT  parameter x-Fact-order-1   like ub.ot-line.Fact-order   no-undo.
     2532   define INPUT  parameter x-Fact-order-2   like ub.ot-line.Fact-order   no-undo.
     2533   define input  parameter x-sum-type       like ub.ot-line.sum-type     no-undo.
     2534   define input  parameter x-cat-id         like ub.ot-line.cat-id       no-undo.
     2535   define input  parameter x-ext-doc-type   like ub.ot-line.ext-doc-type no-undo.
     2536   define input  parameter xTog-obj         as   log                  no-undo.
     2537    define variable v-total-parts-qnty           like ub.parts.qnty      no-undo .   define variable v-total-parts-fact-qnty      like ub.parts.fact-qnty no-undo .   define variable v-total-parts-cli-qnty       like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-fact-cli-qnty  like ub.parts.cli-qnty  no-undo .   define variable v-total-parts-price-cli      as decimal no-undo .   define variable v-total-parts-price-base     as decimal no-undo .   define variable v-total-parts-price-rubl     as decimal no-undo .   define variable v-total-parts-transport-base as decimal no-undo .   define variable v-total-parts-transport-rubl as decimal no-undo .   define variable v-total-parts-other-base     as decimal no-undo .   define variable v-total-parts-other-rubl     as decimal no-undo .
     2538    FOR each ub.ot-line
     2539                      where ub.ot-line.artic        = x-artic
     2540                     AND   ub.ot-line.fact-order   <= x-fact-order-2
     2541                     AND   ub.ot-line.fact-order   >= x-fact-order-1
     2542                     AND   ub.ot-line.prod-code     = x-prod-code
     2543                     AND   ub.ot-line.prod-type     = x-prod-type
     2544                     AND   ub.ot-line.obj-code      = x-store-code
     2545                     AND   ub.ot-line.obj-type      = x-store-type
     2546                     AND   (ub.ot-line.sum-type     = 'crsa':U OR ub.ot-line.sum-type = 'cgsr':U)
     2547                     And   ((x-ext-doc-type = 'все':U) OR (ub.ot-line.ext-doc-type  = x-ext-doc-type ))
     2548                           no-lock break by ub.ot-line.artic  :
     2549            Find First ot-line-Cost where
     2550                           ot-line-Cost.artic        = x-artic
     2551                     AND   ot-line-Cost.fact-order   = ub.ot-line.fact-order
     2552                     AND   ot-line-Cost.obj-code     = ub.ot-line.obj-code
     2553                     AND   ot-line-Cost.obj-type     = ub.ot-line.obj-type
     2554                     AND   ot-line-Cost.prod-code    = x-prod-code
     2555                     AND   ot-line-Cost.prod-type    = x-prod-type
     2556                     AND   (ot-line-Cost.sum-type    = 'cost':U OR ot-line-cost.sum-type = 'cssr':U)
     2557                     And   ot-line-Cost.doc-code     = ub.ot-line.doc-code
     2558                       no-lock use-Index pi  no-error.
     2559           Find First ot-line-Sale where
     2560                           ot-line-Sale.artic        = x-artic
     2561                     AND   ot-line-Sale.fact-order   = ub.ot-line.fact-order
     2562                     AND   ot-line-Sale.obj-code     = ub.ot-line.obj-code
     2563                     AND   ot-line-Sale.obj-type     = ub.ot-line.obj-type
     2564                     AND   ot-line-Sale.prod-code    = x-prod-code
     2565                     AND   ot-line-Sale.prod-type    = x-prod-type
     2566                     AND   (ot-line-Sale.sum-type    = 'sale':U OR ot-line-sale.sum-type = 'sasr':U)
     2567                     And   ot-line-Sale.doc-code     = ub.ot-line.doc-code
     2568                       no-lock use-Index pi  no-error.
     2569             Assign
     2570               doc-code   = ub.ot-line.doc-code
     2571               qnty       = ub.ot-line.fact-qnty
     2572               .
     2573              If ub.ot-line.ext-doc-type  <> 'ot':U Then DO:
     2574                     Find Last ub.trn-doc  where ub.trn-doc.doc-code = ub.ot-line.doc-code no-lock no-error.
     2575                       If Available ub.trn-doc then DO:
     2576                       Find First ub.doc-line  where ub.trn-doc.doc-code = ub.doc-line.doc-code
     2577                     AND   ub.doc-line.prod-code    = x-prod-code
     2578                     AND   ub.doc-line.prod-type    = x-prod-type
     2579                     AND   ub.doc-line.artic        = x-artic   no-lock no-error.
     2580                       Assign
     2581                       type-doc   =  ub.trn-doc.doc-type
     2582                       fact-date  =  ub.trn-doc.fact-date
     2583                       cli-name   =  ub.trn-doc.cli-name
     2584                       discnt-sum = if avail ot-line-Sale then
     2585                                    ( if tPrintRubl then ot-line-Sale.other-rubl
     2586                                                   Else ot-line-Sale.other-base )
     2587                                     Else 0
     2588                       .
     2589                       if  ub.ot-line.ext-doc-type  = 'vt':U or ub.ot-line.ext-doc-type  = 'vp':U Then DO:
     2590                           Assign  discnt-sum = 0  .
     2591                           End.
     2592                       End.
     2593                     End.
     2594                 Else DO:
     2595                     Find Last ub.price-doc where ub.price-doc.doc-num = ub.ot-line.doc-code no-lock no-error.
     2596                     If Available ub.price-doc then
     2597                       Assign
     2598                       type-doc   = 'пер'
     2599                       fact-date  = ub.price-doc.fact-date
     2600                       cli-name   =  ""
     2601                       discnt-sum = 0
     2602                       qnty       = if available ot-line-Cost then ot-line-Cost.fact-qnty else 0
     2603                       .
     2604                 End.
     2605        If Available ot-line-sale Then
     2606          Assign
     2607                   SumSALE    = if tPrintRubl then ot-line-sale.sum-rubl else ot-line-sale.sum-base
     2608                   VAT-Sum    = if tPrintRubl then ot-line-sale.VAT-rubl else ot-line-sale.VAT-base
     2609                   SLT-sum    = if tPrintRubl then ot-line-sale.SLT-rubl else ot-line-sale.SLT-base
     2610                   VAT_pc     = (Entry(1,ot-line-sale.cat-id))
     2611                   SLT_pc     = (Entry(2,ot-line-sale.cat-id))
     2612                 .
     2613            Else
     2614                  Assign
     2615                   SumSALE    = 0
     2616                   VAT-Sum    = if tPrintRubl then ub.ot-line.VAT-rubl else ub.ot-line.VAT-base
     2617                   SLT-sum    = if tPrintRubl then ub.ot-line.SLT-rubl else ub.ot-line.SLT-base
     2618                   VAT_pc     = (Entry(1,ot-line.cat-id))
     2619                   SLT_pc     = (Entry(2,ot-line.cat-id))
     2620                 .
     2621        If Available ot-line-cost Then
     2622           SumCOST    = if tPrintRubl then ot-line-cost.sum-rubl else ot-line-cost.sum-base.
     2623            Else  SumCOST    = 0.
     2624        Assign
     2625        SumCRSA    = if tPrintRubl then ub.ot-line.sum-rubl else ub.ot-line.sum-base
     2626        .
     2627        If (ub.ot-line.ext-doc-type  = 'ot':U  OR
     2628            ub.ot-line.ext-doc-type  = 'vt':U       OR
     2629            ub.ot-line.ext-doc-type  = 'vp':U  )
     2630           Then ov-sum      = 0.
     2631           Else ov-sum      = SumCRSA   - discnt-sum - SumSALE.
     2632     Assign qnty-1 = 0   qnty-2 = 0 .
     2633     IF  tow-unit = true THEN DO :
     2634          FIND FIRST ub.units no-LOCK WHERE  ub.units.unit-name = gds-list.unit-base No-ERROR.
     2635          define variable var1 as integer no-undo .
     2636        var1 = 0 .
     2637        IF  LOOKUP('2ед':U, ub.units.type ) > 0  THEN  var1 = 1.
     2638        IF  LOOKUP('доп':U, ub.units.type) > 0   THEN  var1 = 2.
     2639       CASE var1:
     2640           when 0 then DO : Assign qnty-1 = 0   qnty-2 = 0 .                              End.
     2641           when 1 then DO :  If avail ub.doc-line then
     2642                             run partrqst in this-procedure
     2643                               (input  ub.doc-line.doc-code
     2644                               ,input  ub.doc-line.obj-type
     2645                               ,input  ub.doc-line.obj-code
     2646                               ,input  ub.doc-line.artic
     2647                               ,input  ub.doc-line.prod-type
     2648                               ,input  ub.doc-line.prod-code
     2649                                                           ,output v-total-parts-qnty   ,output v-total-parts-fact-qnty   ,output v-total-parts-cli-qnty   ,output v-total-parts-fact-cli-qnty   ,output v-total-parts-price-cli   ,output v-total-parts-price-base   ,output v-total-parts-price-rubl   ,output v-total-parts-transport-base   ,output v-total-parts-transport-rubl   ,output v-total-parts-other-base   ,output v-total-parts-other-rubl
     2650                               ).
     2651                               Assign qnty-1 = (If avail ub.doc-line
     2652                                               then  (If  qnty  = 0 Then 0
     2653                                                          Else (If  qnty  < 0
     2654                                                                   Then (-1) * ABSOLUTE(v-total-parts-fact-cli-qnty)
     2655                                                                   Else v-total-parts-fact-cli-qnty)
     2656                                                      )
     2657                                               else  0)
     2658                                      qnty-2 = qnty .
     2659                       End.
     2660           when 2 then DO : Assign qnty-1 = qnty
     2661                                   qnty-2 = gds-list.wt-cart * qnty-1.
     2662                      End.
     2663       End.
     2664        IF h-kol-1 <> ?  THEN h-kol-1:screen-value =  string(qnty-1)  .
     2665        IF h-kol-2 <> ?  THEN h-kol-2:screen-value =  string(qnty-2)  .
     2666        ov-sum      = SumCRSA   - discnt-sum - SumSALE.
     2667        If ub.ot-line.ext-doc-type  = 'ot':U Then ov-sum = 0.
     2668   End.
     2669       Assign
     2670           TOT-SumCRSA    = TOT-SumCRSA + SumCRSA
     2671           TOT-VAT-Sum    = TOT-VAT-Sum + VAT-Sum
     2672           TOT-SLT-sum    = TOT-SLT-sum + SLT-sum
     2673           TOT-SumCOST    = TOT-SumCOST + SumCOST
     2674           TOT-SumSALE    = TOT-SumSALE + SumSALE
     2675           TOT-discnt-sum = TOT-discnt-sum + discnt-sum
     2676           TOT-ov-sum     = TOT-ov-sum     + ov-sum    .
     2677          TOT-qnty  = TOT-qnty  + qnty .
     2678    if first-of(ub.ot-line.artic)  then DO:
     2679         if not sums-only then run print-header.
     2680     End.
     2681     run display-line in this-procedure .
     2682   End.
     2683   END PROCEDURE.
     2684   procedure ost-line :
     2685     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2686     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2687     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2688     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2689     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2690     define input  parameter x-tog-shift  as logical no-undo .
     2691     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2692     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2693     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2694     define input  parameter xtog-obj     as logical no-undo .
     2695     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2696     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2697     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2698     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2699     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2700     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2701     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2702     define buffer buff-obj-list  for obj-list .
     2703     define buffer buff-stk-line  for ub.stk-line .
     2704     assign
     2705       Quantity = 0
     2706       Coast_R  = 0
     2707       Coast_V  = 0
     2708       VAT_R    = 0
     2709       VAT_V    = 0
     2710       SLT_R    = 0
     2711       SLT_V    = 0
     2712     .
     2713     if  x-tog-shift = false then do:
     2714       for each buff-obj-list no-lock
     2715         where xtog-obj = false
     2716            or (buff-obj-list.obj-type = x-store-type
     2717               and buff-obj-list.obj-code = x-store-code
     2718               )
     2719       on error undo, return error
     2720       :
     2721         find last buff-stk-line no-lock
     2722           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2723             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2724             and buff-stk-line.artic      = x-artic
     2725             and buff-stk-line.prod-type  = x-prod-type
     2726             and buff-stk-line.prod-code  = x-prod-code
     2727             and buff-stk-line.sum-type   = x-sum-type
     2728             and buff-stk-line.cat-id     = '##,##':U
     2729             and buff-stk-line.fact-order <= x-fact-order
     2730             and buff-stk-line.shift-num  = 0
     2731           use-index category
     2732           no-error .
     2733         if available buff-stk-line then do:
     2734           assign
     2735             Quantity = Quantity +  buff-stk-line.fact-qnty
     2736             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2737             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2738             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2739             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2740             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2741             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2742           .
     2743         end.
     2744       end.
     2745     end.
     2746     else do:
     2747       for each buff-obj-list no-lock
     2748         where xtog-obj = false
     2749            or (buff-obj-list.obj-type = x-store-type
     2750               and buff-obj-list.obj-code = x-store-code
     2751               )
     2752       on error undo, return error
     2753       :
     2754         find last buff-stk-line no-lock
     2755           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2756             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2757             and buff-stk-line.artic      = x-artic
     2758             and buff-stk-line.prod-type  = x-prod-type
     2759             and buff-stk-line.prod-code  = x-prod-code
     2760             and buff-stk-line.sum-type   = x-sum-type
     2761             and buff-stk-line.cat-id     = '##,##':U
     2762             and buff-stk-line.fact-order <= x-fact-order
     2763             and buff-stk-line.shift-num  > 0
     2764           use-index category
     2765           no-error .
     2766         if available buff-stk-line then do:
     2767           assign
     2768             Quantity = Quantity +  buff-stk-line.fact-qnty
     2769             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2770             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2771             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2772             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2773             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2774             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2775           .
     2776         end.
     2777       end.
     2778     end.
     2779   end procedure.
     2780   procedure ost-lineother-tax :
     2781     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2782     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2783     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2784     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2785     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     2786     define input  parameter x-tog-shift  as logical no-undo .
     2787     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     2788     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     2789     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     2790     define input  parameter xTog-obj     as logical no-undo .
     2791     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     2792     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     2793     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     2794     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     2795     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     2796     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     2797     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     2798     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     2799     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     2800     define buffer buff-obj-list  for obj-list .
     2801     define buffer buff-stk-line  for ub.stk-line .
     2802     assign
     2803       Quantity = 0
     2804       Coast_R  = 0
     2805       Coast_V  = 0
     2806       VAT_R    = 0
     2807       VAT_V    = 0
     2808       SLT_R    = 0
     2809       SLT_V    = 0
     2810       other_R  = 0
     2811       other_V  = 0
     2812     .
     2813     if  x-tog-shift = false then do:
     2814       for each buff-obj-list no-lock
     2815         where xtog-obj = false
     2816            or (buff-obj-list.obj-type = x-store-type
     2817               and buff-obj-list.obj-code = x-store-code
     2818               )
     2819       on error undo, return error
     2820       :
     2821         find last buff-stk-line no-lock
     2822           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2823             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2824             and buff-stk-line.artic      = x-artic
     2825             and buff-stk-line.prod-type  = x-prod-type
     2826             and buff-stk-line.prod-code  = x-prod-code
     2827             and buff-stk-line.sum-type   = x-sum-type
     2828             and buff-stk-line.cat-id     = '##,##':U
     2829             and buff-stk-line.fact-order <= x-fact-order
     2830             and buff-stk-line.shift-num  = 0
     2831           use-index category
     2832           no-error .
     2833         if available buff-stk-line then do:
     2834           assign
     2835             Quantity = Quantity +  buff-stk-line.fact-qnty
     2836             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2837             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2838             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2839             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2840             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2841             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2842             other_R  = other_R  +  buff-stk-line.other-rubl
     2843             other_V  = other_V  +  buff-stk-line.other-base
     2844           .
     2845         end.
     2846       end.
     2847     end.
     2848     else do:
     2849       for each buff-obj-list no-lock
     2850         where xtog-obj = false
     2851            or (buff-obj-list.obj-type = x-store-type
     2852               and buff-obj-list.obj-code = x-store-code
     2853               )
     2854       on error undo, return error
     2855       :
     2856         find last buff-stk-line no-lock
     2857           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2858             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2859             and buff-stk-line.artic      = x-artic
     2860             and buff-stk-line.prod-type  = x-prod-type
     2861             and buff-stk-line.prod-code  = x-prod-code
     2862             and buff-stk-line.sum-type   = x-sum-type
     2863             and buff-stk-line.cat-id     = '##,##':U
     2864             and buff-stk-line.fact-order <= x-fact-order
     2865             and buff-stk-line.shift-num  > 0
     2866           use-index category
     2867           no-error .
     2868         if available buff-stk-line then do:
     2869           assign
     2870             Quantity = Quantity +  buff-stk-line.fact-qnty
     2871             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2872             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2873             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2874             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2875             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2876             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2877             other_R = other_R   +  buff-stk-line.other-rubl
     2878             other_V = other_V   +  buff-stk-line.other-base
     2879           .
     2880         end.
     2881       end.
     2882     end.
     2883   end procedure.
     2884   procedure ost-line-kg :
     2885     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2886     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2887     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2888     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2889     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2890     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2891     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2892     define buffer buff-obj-list  for obj-list .
     2893     define buffer buf_doc-line for ub.doc-line .
     2894     define buffer buf_inv-line for ub.inv-line .
     2895     do
     2896     on error undo, return error
     2897     :
     2898       for each buf_doc-line no-lock where
     2899                buf_doc-line.obj-type    = p-obj-type   and
     2900                buf_doc-line.obj-code    = p-obj-code   and
     2901                buf_doc-line.prod-type   = p-prod-type  and
     2902                buf_doc-line.prod-code   = p-prod-code  and
     2903                buf_doc-line.artic       = p-artic      and
     2904                buf_doc-line.status_     = 'факт':U      and
     2905                buf_doc-line.fact-order <= p-fact-order
     2906             by buf_doc-line.fact-order    descending
     2907       :
     2908         find first buf_inv-line no-lock where
     2909                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2910                    buf_inv-line.artic     = buf_doc-line.artic     and
     2911                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2912                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2913         if available buf_inv-line
     2914         then do:
     2915           if buf_inv-line.after-cli-qnty <> ?
     2916           then do:
     2917             assign
     2918               p-quantity-kg = buf_inv-line.after-cli-qnty
     2919             .
     2920             leave .
     2921           end.
     2922         end.
     2923       end.
     2924       if p-quantity-kg = ?
     2925       then do:
     2926         assign
     2927           p-quantity-kg = 0
     2928         .
     2929       end.
     2930     end.
     2931   end procedure.
     2932   PROCEDURE report-exec1  :
     2933           if xtog-inv then DO:
     2934             For each ub.trn-doc where
     2935               ub.trn-doc.doc-type = 'инв':U and
     2936               ub.trn-doc.ext-doc-type = 'vt':U and
     2937               ub.trn-doc.fact-date >= startdate and
     2938               ub.trn-doc.obj-code   = x-store-code and
     2939               ub.trn-doc.obj-type   = x-store-type and
     2940               ub.trn-doc.status_    = 'факт':U
     2941               no-lock,
     2942               first ub.doc-line where
     2943                   ub.doc-line.artic      = gds-list.artic     and
     2944                   ub.doc-line.prod-type  = gds-list.prod-type and
     2945                   ub.doc-line.prod-code  = gds-list.prod-code and
     2946                   ub.doc-line.doc-code   = ub.trn-doc.doc-code   no-lock :
     2947                   Assign
     2948                      inv-fact-order = ub.trn-doc.fact-order
     2949                      inv-str        = 'Последняя инвентаризация ' +  string(ub.trn-doc.fact-date ,"99/99/9999" ) + " документ № " + ub.doc-line.doc-code.
     2950             End.
     2951            End.
     2952   Assign TOT-SumCRSA = 0
     2953          TOT-VAT-Sum = 0
     2954          TOT-SLT-sum = 0
     2955          TOT-SumCOST = 0
     2956          TOT-SumSALE = 0
     2957          TOT-qnty    = 0
     2958          TOT-discnt-sum = 0
     2959          TOT-ov-sum     = 0.
     2960      FIND FIRST ub.clients where x-store-type = ub.clients.obj-type AND
     2961                               x-store-code = ub.clients.obj-code no-lock no-error.
     2962              If available ub.clients then  ObjName = ub.clients.obj-name.
     2963                                            else  ObjName="объект не определен".
     2964     run calcitog.
     2965     form with frame zapas .
     2966   define variable vss-include-info27 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2967   form header
     2968     line format "x(197)" at 1 skip
     2969     "Продолжение - на следующей странице" at 30 skip
     2970     with frame bottomframe width 232 page-bottom no-labels no-box .
     2971   view stream outstream frame bottomframe .
     2972     run ob-line  in this-procedure (
     2973         input   x-store-code   ,
     2974         input   x-store-type   ,
     2975         input   gds-list.artic       ,
     2976         input   gds-list.prod-code   ,
     2977         input   gds-list.prod-type   ,
     2978         input   fact-order-1,
     2979         input   fact-order-2,
     2980         input   'crsa':U,
     2981         input   '##,##':U,
     2982         input   xcombo-node ,
     2983         input   yes ) .
     2984      hide stream outstream frame bottomframe2 .
     2985     run print-footer.
     2986     end procedure.
     2987   PROCEDURE ostatok :
     2988   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     2989   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     2990   def input parameter x-tog-shift   as   logical             no-undo.
     2991   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     2992   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     2993   def input parameter x-shift-start as integer               no-undo.
     2994   def input parameter x-shift-end   as integer               no-undo.
     2995   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     2996   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     2997   def input parameter xTog-obj   as log no-undo.
     2998   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     2999   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     3000   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     3001   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     3002   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     3003   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     3004   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     3005   def var              Fact-orderS   as char  no-undo.
     3006   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     3007      Assign
     3008         Fact-order   = 0
     3009         Quantity     = 0
     3010         Coast_R      = 0
     3011         Coast_V      = 0
     3012         VAT_R        = 0
     3013         VAT_V        = 0 .
     3014    x-date-start-t  = x-date-start + 1 .
     3015   IF x-date-end = date('') then DO:
     3016      Fact-order = 0 .
     3017      for each obj-list
     3018          where  ( not xtog-obj or
     3019                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     3020                 no-lock :
     3021         if  x-tog-shift = false then do:
     3022                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3023                               ub.stk-tot.Fact-date <=  x-date-start
     3024                               and ub.stk-tot.shift-num = 0
     3025                               USE-INDEX fact-date no-lock no-error .
     3026              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3027         End.
     3028         Else  DO :
     3029             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3030              (ub.stk-tot.shift-date  = x-date-start-t and
     3031               ub.stk-tot.shift-num  < x-shift-start or
     3032               ub.stk-tot.shift-date  < x-date-start-t  )
     3033               and ub.stk-tot.shift-num  > 0
     3034               USE-INDEX Shift-num no-lock no-error .
     3035            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3036           END.
     3037       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     3038     End.
     3039   End.
     3040   Else DO:
     3041     For each obj-list  WHERE
     3042        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     3043         no-lock :
     3044      IF  x-TOG-Shift = False Then DO:
     3045          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3046               ub.stk-tot.Fact-date <= x-date-end
     3047               and ub.stk-tot.shift-num = 0
     3048               USE-INDEX fact-date no-lock no-error.
     3049          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3050      END.
     3051      Else DO:
     3052           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     3053               (ub.stk-tot.shift-date  = x-date-end and
     3054               ub.stk-tot.shift-num  <= x-shift-end or
     3055               ub.stk-tot.shift-date  < x-date-end       ) and
     3056               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     3057               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     3058       End.
     3059       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     3060     End.
     3061   End.
     3062   END PROCEDURE.
     3063   procedure calc-discnt-base.
     3064   discnt-rubl# =  0.
     3065   discnt-base# =  0.
     3066   for each ub.gds-dtl where ub.gds-dtl.doc-code = ub.trn-doc.doc-code and
     3067                   ub.gds-dtl.artic      = ub.doc-line.artic     and
     3068                   ub.gds-dtl.prod-type  = ub.doc-line.prod-type and
     3069                   ub.gds-dtl.prod-code  = ub.doc-line.prod-code no-lock :
     3070     discnt-rubl# = discnt-rubl# + (ub.gds-dtl.discnt-rubl * ub.gds-dtl.doc-qnty ).
     3071     discnt-base# = discnt-base# + (ub.gds-dtl.discnt-base * ub.gds-dtl.doc-qnty ).
     3072     tot-ov#      = tot-ov#      + ((ub.gds-dtl.cur-base - ub.gds-dtl.price-base ) * ub.gds-dtl.fact-qnty ).
     3073     if discnt-rubl# = ? then discnt-rubl# = 0.
     3074     if discnt-base# = ? then discnt-base# = 0.
     3075     if tot-ov# = ?      then tot-ov#      = 0.
     3076   end.
     3077   end procedure.
     3078   procedure subtit-prod.
     3079      define input parameter x-ord  as integer no-undo .
     3080      find first ub.clients where ub.clients.obj-code = gds-list.prod-code and
     3081                               ub.clients.obj-type = gds-list.prod-type no-lock.
     3082      PUT stream  OutStream  UNFORMATTED "Производитель : " + ub.clients.obj-name  at  (x-ord * 10) - 10   format "x(100)" skip.
     3083   end procedure.
     3084   procedure subfoot-prod.
     3085      define input parameter x-ord  as integer no-undo .
     3086      find first ub.clients where ub.clients.obj-code = gds-list.prod-code and
     3087                               ub.clients.obj-type = gds-list.prod-type no-lock.
     3088      PUT stream  OutStream  UNFORMATTED "Итого по пр-лю : " + ub.clients.obj-name at  (x-ord * 10) - 10    format "x(" + string (53 - ((x-ord * 10) - 10) ) + ")"
     3089      s#1 at 56   format "->>>>>>>>>9.<<<"
     3090      s#2 at 68   format "->>>>>>>>>>9.<<"
     3091      s#3 at 83   format "->>>>>>>>>>9.<<"
     3092      s#4 at 123  format "->>>>>>>>>>9.<<"
     3093      s#7 at 141  format "->>>>>>>>>9.<<"
     3094      s#8 at 157  format "->>>>>>>>>9.<<"
     3095      skip.
     3096   end procedure.
     3097   procedure subfoot-grp.
     3098      define input parameter x-ord  as integer no-undo .
     3099      PUT stream  OutStream  UNFORMATTED  "Итого по группе  " +  gds-list.grp-name at  (x-ord * 10) - 10   format "x(" + string (53 - ((x-ord * 10) - 10) ) + ")"
     3100      s1 at 56  format "->>>>>>>>>9.<<<"
     3101      s2 at 68   format "->>>>>>>>>>9.<<"
     3102      s3 at 83   format "->>>>>>>>>>9.<<"
     3103      s4 at 123  format "->>>>>>>>>>9.<<"
     3104      s7 at 141  format "->>>>>>>>>9.<<"
     3105      s8 at 157  format "->>>>>>>>>9.<<"
     3106      skip.
     3107   end procedure.
     3108   procedure subtit-grp.
     3109      define input parameter x-ord  as integer no-undo .
     3110      PUT stream  OutStream  UNFORMATTED "Группа : " + gds-list.grp-name at  (x-ord * 10) - 10   format "x(100)" skip.
     3111   end procedure.
     3112   procedure subfoot-vat-sort.
     3113      define input parameter x-ord  as integer no-undo .
     3114      case x-ord:
     3115      when 1 then str = "Итого по пробе ".
     3116      when 2 then str = "Итого по НДС   ".
     3117      end case.
     3118      PUT stream  OutStream  UNFORMATTED  str + (if x-ord=1 then  gds-list.sort  else string(gds-list.qnty)  )  at  1   format "x(52)"
     3119      s#1 at 56   format "->>>>>>>>>>>9.<<<"
     3120      s#2 at 68   format "->>>>>>>>>>>9.<<"
     3121      s#3 at 83   format "->>>>>>>>>>>9.<<"
     3122      s#4 at 123  format "->>>>>>>>>>>9.<<"
     3123      s#7 at 141  format "->>>>>>>>>>9.<<"
     3124      s#8 at 157  format "->>>>>>>>>>9.<<"
     3125      skip.
     3126   end procedure.
     3127   procedure subtit-vat-sort.
     3128      define input parameter x-ord  as integer no-undo .
     3129      case x-ord:
     3130      when 1 then str = "Проба ".
     3131      when 2 then str = "НДС   ".
     3132      end case.
     3133      PUT stream  OutStream  UNFORMATTED  str + (if x-ord=1 then  gds-list.sort  else string(gds-list.qnty))  at  1   format "x(100)" skip.
     3134   end procedure.
