     1763          else do:
     1764            Assign
     1765               sym14:label in frame zapas = ''
     1766               sym15:label in frame zapas = ''
     1767               sym16:label in frame zapas = ''
     1768               Line         = fill("-", 232 - 28).
     1769               .
     1770          End.
     1771       run report-execute.
     1772   PROCEDURE report-execute :
     1773     If (ValType=0 and x-base-code=0)  Or ValType=1
     1774                                   then   assign tPrintRubl = yes .
     1775                                   else   assign tPrintRubl = no .
     1776     NO-PRISE = true .
     1777       if var-report-r-b = "rubl"  Then    if  x-base-code <> 0 and ValType = 2  then NO-PRISE = false  .
     1778                                   else    if  x-base-code <> 0 and ValType = 1  then NO-PRISE = false  .
     1779   output stream OutStream to value( string( session:temp-directory +
     1780                                        "rpt" + string( g#report-num ) ) )
     1781                                        page-size  value(ReportPageHeight) .
     1782     FORM HEADER
     1783         string( "Страница " + string( PAGE-NUMBER( OutStream ), ">>>>>9") ) AT 170 format "x(24)" SKIP
     1784       with FRAME BottomFrame2 width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1785    VIEW STREAM OutStream FRAME BottomFrame2 .
     1786      run Display-main-title.
     1787      ll = 0.
     1788      FOR EACH OBJ-list no-lock :
     1789      ll = ll + 1 .
     1790         x-store-code = obj-list.obj-code.
     1791         x-store-type = obj-list.obj-type.
     1792         if ll > 1 THEN Page stream OutStream.
     1793         run Display-object.
     1794         Case xClassify :
     1795         When  "no-classify":U THEN DO:
     1796               For each gds-list  no-lock :
     1797                   run report-exec1.
     1798                   HIDE STREAM OutStream FRAME ZAPAS .
     1799               End.
     1800           End.
     1801         When  "prod":U THEN DO:
     1802               For each gds-list no-lock break by gds-list.prod-type by gds-list.prod-code   :
     1803                   if first-of (gds-list.prod-code) Then
     1804                   run subtit-prod (1).
     1805                   run report-exec1.
     1806                   HIDE STREAM OutStream FRAME ZAPAS .
     1807                   accumulate  tot-qnty            (total by  gds-list.prod-code by gds-list.prod-type) .
     1808                   accumulate  tot-SumSALE         (total by  gds-list.prod-code by gds-list.prod-type) .
     1809                   accumulate tot-SumCOST          (total by  gds-list.prod-code by gds-list.prod-type) .
     1810                   accumulate tot-SumCRSA          (total by  gds-list.prod-code by gds-list.prod-type) .
     1811                   accumulate tot-discnt-sum       (total by  gds-list.prod-code by gds-list.prod-type) .
     1812                   accumulate tot-ov-sum           (total by  gds-list.prod-code by gds-list.prod-type) .
     1813                   accumulate tot-VAT-Sum          (total by  gds-list.prod-code by gds-list.prod-type) .
     1814                   accumulate tot-SLT-sum          (total by  gds-list.prod-code by gds-list.prod-type) .
     1815                   if last-of (gds-list.prod-code) Then
     1816                   DO:
     1817                     s#1 = accum total by gds-list.prod-code tot-qnty.
     1818                     s#2 = accum total by gds-list.prod-code tot-SumSALE.
     1819                     s#3 = accum total by gds-list.prod-code tot-SumCOST.
     1820                     s#4 = accum total by gds-list.prod-code tot-SumCRSA .
     1821                     s#5 = accum total by gds-list.prod-code tot-discnt-sum .
     1822                     s#6 = accum total by gds-list.prod-code tot-ov-sum .
     1823                     s#7 = accum total by gds-list.prod-code tot-VAT-Sum.
     1824                     s#8 = accum total by gds-list.prod-code tot-SLT-sum.
     1825                     if not (s#1 = 0 and
     1826                             s#2 = 0 and
     1827                             s#3 = 0 and
     1828                             s#4 = 0 and
     1829                             s#5 = 0 and
     1830                             s#6 = 0 and
     1831                             s#7 = 0 and
     1832                             s#8 = 0) then  run subfoot-prod (1).
     1833                     End.
     1834               End.           End.
     1835         When  "grp-goods":U  Then Do:
     1836               For each gds-list no-lock break by gds-list.grp-name  :
     1837                   if first-of (gds-list.grp-name) Then
     1838                   run subtit-grp (1).
     1839                   run report-exec1.
     1840                   HIDE STREAM OutStream FRAME ZAPAS .
     1841                   accumulate tot-qnty             (total by  gds-list.grp-name) .
     1842                   accumulate tot-SumSALE          (total by  gds-list.grp-name) .
     1843                   accumulate tot-SumCOST          (total by  gds-list.grp-name) .
     1844                   accumulate tot-SumCRSA          (total by  gds-list.grp-name) .
     1845                   accumulate tot-discnt-sum       (total by  gds-list.grp-name) .
     1846                   accumulate tot-ov-sum           (total by  gds-list.grp-name) .
     1847                   accumulate tot-VAT-Sum          (total by  gds-list.grp-name) .
     1848                   accumulate tot-SLT-sum          (total by  gds-list.grp-name) .
     1849                   if last-of (gds-list.grp-name) Then DO:
     1850                               s1 = accum total by gds-list.grp-name tot-qnty.
     1851                               s2 = accum total by gds-list.grp-name tot-SumSALE.
     1852                               s3 = accum total by gds-list.grp-name tot-SumCOST.
     1853                               s4 = accum total by gds-list.grp-name tot-SumCRSA .
     1854                               s5 = accum total by gds-list.grp-name tot-discnt-sum .
     1855                               s6 = accum total by gds-list.grp-name tot-ov-sum .
     1856                               s7 = accum total by gds-list.grp-name tot-VAT-Sum.
     1857                               s8 = accum total by gds-list.grp-name tot-SLT-sum.
     1858                     if not (s1 = 0 and
     1859                             s2 = 0 and
     1860                             s3 = 0 and
     1861                             s4 = 0 and
     1862                             s5 = 0 and
     1863                             s6 = 0 and
     1864                             s7 = 0 and
     1865                             s8 = 0 ) then run subfoot-grp (1).
     1866               End.            End.
     1867             end.
     1868         When  "prod/grp-goods":U Then DO:
     1869               for each gds-list no-lock  break by gds-list.prod-type by gds-list.prod-code  by gds-list.grp-name:
     1870                   if first-of (gds-list.prod-code) then run subtit-prod (1).
     1871                   if first-of (gds-list.grp-name)  then
     1872                      if not sums-only  then run subtit-grp (2).
     1873                   run report-exec1.
     1874                   hide stream outstream frame zapas .
     1875                     s#1 = s#1 + tot-qnty.          s1 = s1 + tot-qnty.
     1876                     s#2 = s#2 + tot-SumSALE.       s2 = s2 + tot-SumSALE.
     1877                     s#3 = s#3 + tot-SumCOST.       s3 = s3 + tot-SumCOST.
     1878                     s#4 = s#4 + tot-SumCRSA .      s4 = s4 + tot-SumCRSA .
     1879                     s#5 = s#5 + tot-discnt-sum .   s5 = s5 + tot-discnt-sum .
     1880                     s#6 = s#6 + tot-ov-sum .       s6 = s6 + tot-ov-sum .
     1881                     s#7 = s#7 + tot-VAT-Sum.       s7 = s7 + tot-VAT-Sum.
     1882                     s#8 = s#8 + tot-SLT-sum.       s8 = s8 + tot-SLT-sum.
     1883                   if last-of (gds-list.grp-name)  Then DO:
     1884                     if not (s1 = 0 and
     1885                             s2 = 0 and
     1886                             s3 = 0 and
     1887                             s4 = 0 and
     1888                             s5 = 0 and
     1889                             s6 = 0 and
     1890                             s7 = 0 and
     1891                             s8 = 0 ) then run subfoot-grp (2).
     1892                     Assign s1 = 0 s2 = 0 s3 = 0  s4 = 0  s5 = 0 s6 = 0 s7 = 0 s8 = 0.
     1893                   End.
     1894                   if last-of (gds-list.prod-code) Then DO:
     1895                     if not (s#1 = 0 and
     1896                             s#2 = 0 and
     1897                             s#3 = 0 and
     1898                             s#4 = 0 and
     1899                             s#5 = 0 and
     1900                             s#6 = 0 and
     1901                             s#7 = 0 and
     1902                             s#8 = 0 ) then  run subfoot-prod (1).
     1903                     Assign s#1 = 0 s#2 = 0 s#3 = 0  s#4 = 0  s#5 = 0 s#6 = 0 s#7 = 0 s#8 = 0.
     1904                     End.
     1905               End.           End.
     1906         When  "grp-goods/prod":U Then DO:
     1907               For each gds-list no-lock  break  by gds-list.grp-name   by gds-list.prod-type by gds-list.prod-code :
     1908                   if first-of (gds-list.grp-name)  then run subtit-grp (1).
     1909                   if first-of (gds-list.prod-code) then
     1910                      if not sums-only  then run subtit-prod (2).
     1911                   run report-exec1.
     1912                   hide stream outstream frame zapas .
     1913                     s#1 = s#1 + tot-qnty.          s1 = s1 + tot-qnty.
     1914                     s#2 = s#2 + tot-SumSALE.       s2 = s2 + tot-SumSALE.
     1915                     s#3 = s#3 + tot-SumCOST.       s3 = s3 + tot-SumCOST.
     1916                     s#4 = s#4 + tot-SumCRSA .      s4 = s4 + tot-SumCRSA .
     1917                     s#5 = s#5 + tot-discnt-sum .   s5 = s5 + tot-discnt-sum .
     1918                     s#6 = s#6 + tot-ov-sum .       s6 = s6 + tot-ov-sum .
     1919                     s#7 = s#7 + tot-VAT-Sum.       s7 = s7 + tot-VAT-Sum.
     1920                     s#8 = s#8 + tot-SLT-sum.       s8 = s8 + tot-SLT-sum.
     1921                   if last-of (gds-list.prod-code) Then DO:
     1922                     if not (s#1 = 0 and
     1923                             s#2 = 0 and
     1924                             s#3 = 0 and
     1925                             s#4 = 0 and
     1926                             s#5 = 0 and
     1927                             s#6 = 0 and
     1928                             s#7 = 0 and
     1929                             s#8 = 0 ) then  run subfoot-prod (2).
     1930                     assign s#1 = 0 s#2 = 0 s#3 = 0  s#4 = 0  s#5 = 0 s#6 = 0 s#7 = 0 s#8 = 0.
     1931                     end.
     1932                     if last-of (gds-list.grp-name)  then do:
     1933                     if not (s1 = 0 and
     1934                             s2 = 0 and
     1935                             s3 = 0 and
     1936                             s4 = 0 and
     1937                             s5 = 0 and
     1938                             s6 = 0 and
     1939                             s7 = 0 and
     1940                             s8 = 0 ) then run subfoot-grp (1).
     1941                       Assign s1 = 0 s2 = 0 s3 = 0  s4 = 0  s5 = 0 s6 = 0 s7 = 0 s8 = 0.
     1942                       End.
     1943                   End.   End.
     1944         When  "sort":U THEN DO:
     1945               For each gds-list no-lock break by gds-list.sort   :
     1946                   if first-of (gds-list.sort) Then
     1947                       if not sums-only  then run subtit-vat-sort (1).
     1948                   run report-exec1.
     1949                   hide stream outstream frame zapas .
     1950                   accumulate  tot-qnty            (total by  gds-list.sort) .
     1951                   accumulate  tot-sumsale         (total by  gds-list.sort) .
     1952                   accumulate tot-sumcost          (total by  gds-list.sort) .
     1953                   accumulate tot-sumcrsa          (total by  gds-list.sort) .
     1954                   accumulate tot-discnt-sum       (total by  gds-list.sort) .
     1955                   accumulate tot-ov-sum           (total by  gds-list.sort) .
     1956                   accumulate tot-vat-sum          (total by  gds-list.sort) .
     1957                   accumulate tot-slt-sum          (total by  gds-list.sort) .
     1958                   if last-of (gds-list.sort) Then
     1959                   DO:
     1960                     s#1 = accum total by gds-list.sort tot-qnty.
     1961                     s#2 = accum total by gds-list.sort tot-SumSALE.
     1962                     s#3 = accum total by gds-list.sort tot-SumCOST.
     1963                     s#4 = accum total by gds-list.sort tot-SumCRSA .
     1964                     s#5 = accum total by gds-list.sort tot-discnt-sum .
     1965                     s#6 = accum total by gds-list.sort tot-ov-sum .
     1966                     s#7 = accum total by gds-list.sort tot-VAT-Sum.
     1967                     s#8 = accum total by gds-list.sort tot-SLT-sum.
     1968                     if not (s#1 = 0 and
     1969                             s#2 = 0 and
     1970                             s#3 = 0 and
     1971                             s#4 = 0 and
     1972                             s#5 = 0 and
     1973                             s#6 = 0 and
     1974                             s#7 = 0 and
     1975                             s#8 = 0 ) then  run subfoot-vat-sort (1).
     1976                     End.
     1977               End.           End.
     1978         When  "vat-ps":U THEN DO:
     1979               For each gds-list no-lock ,
     1980                  first ub.gds-obj where
     1981                        ub.gds-obj.gds-code = gds-list.gds-code and
     1982                        ub.gds-obj.obj-code = x-store-code and
     1983                        ub.gds-obj.obj-type = x-store-type
     1984                        :
     1985                   gds-list.qnty = (func-vat(gds-obj.gds-code,gds-obj.obj-type,gds-obj.obj-code)) .
     1986                end.
     1987               For each gds-list no-lock , first ub.gds-obj where ub.gds-obj.gds-code = gds-list.gds-code and
     1988                   ub.gds-obj.obj-code = x-store-code and
     1989                   ub.gds-obj.obj-type = x-store-type
     1990               break by gds-list.qnty   :
     1991                   if first-of (gds-list.qnty) Then run subtit-vat-sort (2).
     1992                   Run report-exec1.
     1993                   HIDE STREAM OutStream FRAME ZAPAS .
     1994                   accumulate tot-qnty             (total by  gds-list.qnty) .
     1995                   accumulate tot-SumSALE          (total by  gds-list.qnty) .
     1996                   accumulate tot-SumCOST          (total by  gds-list.qnty) .
     1997                   accumulate tot-SumCRSA          (total by  gds-list.qnty) .
     1998                   accumulate tot-discnt-sum       (total by  gds-list.qnty) .
     1999                   accumulate tot-ov-sum           (total by  gds-list.qnty) .
     2000                   accumulate tot-VAT-Sum          (total by  gds-list.qnty) .
     2001                   accumulate tot-SLT-sum          (total by  gds-list.qnty) .
     2002                   if last-of (gds-list.qnty) Then
     2003                   DO:
     2004                     s#1 = accum total by gds-list.qnty tot-qnty.
     2005                     s#2 = accum total by gds-list.qnty tot-SumSALE.
     2006                     s#3 = accum total by gds-list.qnty tot-SumCOST.
     2007                     s#4 = accum total by gds-list.qnty tot-SumCRSA .
     2008                     s#5 = accum total by gds-list.qnty tot-discnt-sum .
     2009                     s#6 = accum total by gds-list.qnty tot-ov-sum .
     2010                     s#7 = accum total by gds-list.qnty tot-VAT-Sum.
     2011                     s#8 = accum total by gds-list.qnty tot-SLT-sum.
     2012                     if not (s#1 = 0 and
     2013                             s#2 = 0 and
     2014                             s#3 = 0 and
     2015                             s#4 = 0 and
     2016                             s#5 = 0 and
     2017                             s#6 = 0 and
     2018                             s#7 = 0 and
     2019                             s#8 = 0 ) then run subfoot-vat-sort (2).
     2020                     End.
     2021               End.           End.
     2022         End case.
     2023     End.
     2024     HIDE STREAM OutStream FRAME top-Frame .
     2025     Output stream OutStream close.
     2026     DELETE WIDGET-POOL "qq".
     2027   if mFrameView
     2028   then do:
     2029      HIDE FRAME InfoFrame.
     2030   end.
     2031     define variable v-user-action as character no-undo .
     2032     define variable v-printed as logical   no-undo .
     2033     define variable DisabledOptions as integer   no-undo .
     2034     define variable v-orient-page as character no-undo .
     2035     run How-name in this-procedure (
     2036         input ReportPageHeight,
     2037         input ReportPageWidth,
     2038         output v-orient-page )
     2039         .
     2040     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2041                                    else DisabledOptions = 0 .
     2042     run gbl/prnfilen.w
     2043       (input  ""
     2044       ,input  DisabledOptions
     2045       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2046       ,input ReportFontNum
     2047       ,output v-user-action
     2048       ,output v-printed
     2049       ) .
     2050   END PROCEDURE.
     2051   PROCEDURE display-line :
     2052      i = i + 1.
     2053      v-ii = v-ii + 1.
     2054   IF ( v-ii modulo v-account = 0 )  then DO:
     2055    Assign
     2056       v-kol-spice = (50 - LENGTH(reportname)) / 2
     2057       RecordsString = fill(' ',v-kol-spice) + string(reportname)
     2058       .
     2059    Assign
     2060       v-kol-spice = (50 - LENGTH(ObjName)) / 2
     2061       RecordsString2 = fill(' ',v-kol-spice) + string(ObjName)
     2062       .
     2063             if  log-manager:logfile-name ne ?
     2064             then DO:
     2065                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     2066             end.
     2067              if mFrameView
     2068              then do:
     2069               DISPLAY
     2070                 v-ii @ RecordsDone
     2071                 RecordsString   @ RecordsString
     2072                 RecordsString2  @ RecordsString2
     2073                 WITH FRAME InfoFrame.
     2074              end.
     2075   End.
     2076      if v-button-stop then  DO:
     2077            if mFrameView
     2078            then
     2079               PROCESS EVENTS.
     2080            IF StopProcessing THEN DO:
     2081            RETURN error.
     2082            End.
     2083      end.
     2084     if NOT (xtype begins "all") OR
     2085       entry(2,xtype) = "no"    then DO:
     2086              DISPLAY stream  OutStream sym1 sym2 sym3 sym4 sym5 sym6 sym7 sym8 sym9 sym10 sym11 sym12 sym13
     2087              fact-date  @  F-fact-date
     2088              type-doc   @  f-type-doc
     2089              doc-code   @  f-doc-code
     2090              cli-name   @  f-cli-name
     2091              qnty       @  F-qnty
     2092              SumSALE    @  f-SumSALE
     2093              SumCOST when (cc = true )    @  f-SumCOST
     2094              SumCRSA    @  f-SumCRSA
     2095              discnt-sum @  f-discnt-sum
     2096              ov-sum      when ( NO-PRISE = true ) @  f-ov-sum
     2097              VAT_pc     @  F-VAT_pc
     2098              VAT-Sum    @  f-VAT-Sum
     2099              SLT_pc     @  F-SLT_pc
     2100              SLT-sum    @  f-SLT-sum
     2101              with FRAME ZAPAS . DOWN stream   OutStream 1 with FRAME ZAPAS.
     2102              End.
     2103   END PROCEDURE.
     2104   PROCEDURE print-header :
     2105      If xtype begins "all":U OR xtype = "goods":U  Then  run display-title-mgds.
     2106      i = 0.
     2107       If NOT (xtype begins "all":U) Then DO:
     2108           run display-title.
     2109   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2110   CASE "1" :
     2111   WHEN  "1" then
     2112   TEMPSTR =  string( "Остаток на начало периода (" + string( startdate, "99/99/9999" ) + ")" )   .
     2113   WHEN "2" then
     2114   TEMPSTR = string( "Остаток на конец периода (" + string( enddate, "99/99/9999" ) + ")" )  .
     2115   OTHERWISE
     2116   TEMPSTR =string( "Оборот с " + string( startdate, "99/99/9999" ) + " по " + string( enddate, "99/99/9999" ) )  .
     2117   end CASE.
     2118   PUT STREAM OutStream
     2119   SKIP
     2120   SPACE(5)
     2121   TEMPSTR format "x(72)"
     2122   SKIP
     2123   SPACE(32) string( "Количество: " + trim( string( Quantity1, "->>>,>>>,>>9.<<<" ) ) ) format "x(72)"
     2124   SKIP.
     2125   IF PayType = 2 OR PayType = 0  then do:
     2126   define variable vss-include-info19 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2127   do:
     2128     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     2129       (input  v-cntxt-db-num
     2130       ,input  v-cntxt-userid
     2131       ,input  0
     2132       ,input  'actn_reports_lookup-cost':U
