      799   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      800   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      801   procedure paramls-clear :
      802     define buffer buf_temp-param for temp-param .
      803     do
      804     on error undo, return error return-value
      805     :
      806       for each buf_temp-param
      807       on error undo, return error
      808       :
      809         delete buf_temp-param .
      810       end.
      811     end.
      812   end procedure.
      813   procedure paramls-write :
      814     define input  parameter p-code     as character no-undo .
      815     define input  parameter p-sub-code as character no-undo .
      816     define input  parameter p-value    as character no-undo .
      817     define buffer buf_temp-param for temp-param .
      818     do
      819     on error undo, return error return-value
      820     :
      821       find first buf_temp-param
      822         where buf_temp-param.param-code     = p-code
      823           and buf_temp-param.param-sub-code = p-sub-code
      824         no-error .
      825       if not available buf_temp-param then do:
      826         create buf_temp-param .
      827         assign
      828           buf_temp-param.param-code     = p-code
      829           buf_temp-param.param-sub-code = p-sub-code
      830         .
      831       end.
      832       assign
      833         buf_temp-param.param-value = p-value
      834       .
      835     end.
      836   end procedure.
      837   procedure paramls-read :
      838     define input  parameter p-code          as character no-undo .
      839     define input  parameter p-sub-code      as character no-undo .
      840     define input  parameter p-default-value as character no-undo .
      841     define output parameter p-value         as character no-undo .
      842     define buffer buf_temp-param for temp-param .
      843     do
      844     on error undo, return error return-value
      845     :
      846       find first buf_temp-param
      847         where buf_temp-param.param-code     = p-code
      848           and buf_temp-param.param-sub-code = p-sub-code
      849         no-error .
      850       if available buf_temp-param then do:
      851         assign
      852           p-value = buf_temp-param.param-value
      853         .
      854       end.
      855       else do:
      856         assign
      857           p-value = p-default-value
      858         .
      859       end.
      860     end.
      861   end procedure.
      862   procedure paramls-append :
      863     define input  parameter p-code     as character no-undo .
      864     define input  parameter p-sub-code as character no-undo .
      865     define input  parameter p-value    as character no-undo .
      866     define buffer buf_temp-param for temp-param .
      867     do
      868     on error undo, return error return-value
      869     :
      870       find first buf_temp-param
      871            where buf_temp-param.param-code     = p-code
      872              and buf_temp-param.param-sub-code = p-sub-code
      873         no-error .
      874       if not available buf_temp-param then do:
      875         create buf_temp-param .
      876         assign
      877           buf_temp-param.param-code     = p-code
      878           buf_temp-param.param-sub-code = p-sub-code
      879           buf_temp-param.param-value    = p-value
      880         .
      881       end.
      882       else do:
      883           assign
      884               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      885           .
      886       end.
      887     end.
      888   end procedure.
      889   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      890     if num-entries(string(p-dec), '.') = 2
      891       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      892       else return( string(p-dec)) .
      893   end function.
      894   function format-point-to-comma returns char (input orig as char ) .
      895   define variable rtext as character no-undo .
      896   define variable strt as integer no-undo .
      897   define variable leng as integer no-undo .
      898   assign rtext = orig .
      899   repeat:
      900     strt =  index(rtext,'.').
      901     if strt = 0 then leave.
      902     leng = 1.
      903     substring(rtext,strt,leng,"character") = v-delim .
      904   end.
      905   return rtext.
      906   end function.
      907   function format-excel-text returns char ( input start-text as char ) :
      908   def var  i    as int no-undo.
      909   def var  ch   as char no-undo.
      910   def var  n    as int no-undo.
      911   def var  ipos as int no-undo.
      912     n = num-entries(trim(start-text), chr(10)) - 1 .
      913     do i = 1 to n :
      914       ipos = index( start-text, chr(10)).
      915       if ipos > 0 then
      916         substr( start-text, ipos, 1 ) = ' '.
      917     end.
      918     n = num-entries(trim(start-text), chr(13)) - 1 .
      919     do i = 1 to n :
      920       ipos = index( start-text, chr(13)).
      921       if ipos > 0 then
      922         substr( start-text, ipos, 1 ) = ' '.
      923     end.
      924     if index( start-text, '"' ) = 0 then
      925       start-text =  '="'   + trim( start-text) + '"'   .
      926       else do:
      927         n = num-entries(trim(start-text), '"') - 1.
      928         do i = 1 to n :
      929           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      930         end.
      931         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      932         start-text = '="'  + ch  + '"' .
      933       end.
      934     return start-text.
      935   end.
      936   function excel-sum returns char (input p-dec as decimal ).
      937     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      938   end function.
      939   function excel-qnty returns char (input p-dec as decimal ).
      940     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      941   end function.
      942   function format-excel-text-macr returns char ( input start-text as char ) :
      943   def var  i    as int no-undo.
      944   def var  ch   as char no-undo.
      945   def var  n    as int no-undo.
      946   def var  ipos as int no-undo.
      947     n = num-entries(trim(start-text), chr(10)) - 1 .
      948     do i = 1 to n :
      949       ipos = index( start-text, chr(10)).
      950       if ipos > 0 then
      951         substring( start-text, ipos , 1 ) = ' '.
      952     end.
      953     n = num-entries(trim(start-text), chr(13)) - 1 .
      954     do i = 1 to n :
      955       ipos = index( start-text, chr(13)).
      956       if ipos > 0 then
      957         substring( start-text, ipos, 1 ) = ' '.
      958     end.
      959     if index( start-text, '"' ) = 0 then
      960       start-text =  '"'   + trim( start-text) + '"'   .
      961       else do:
      962         n = num-entries(trim(start-text), '"') - 1.
      963         do i = 1 to n :
      964           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      965         end.
      966         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      967         start-text = '"'  + ch  + '"' .
      968       end.
      969     n = num-entries(trim(start-text), chr(10)) - 1 .
      970     do i = 1 to n :
      971       ipos = index( start-text, chr(10)).
      972       if ipos > 0 then
      973         substring( start-text, ipos , 1 ) = ' '.
      974     end.
      975       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      976     return start-text.
      977   end.
