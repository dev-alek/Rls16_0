     1049   define variable base-code as integer   no-undo .
     1050   define variable g#report-num as integer   no-undo .
     1051   define variable g#gds-engl as logical   no-undo .
     1052   define variable vv-exch-rate  as decimal   no-undo .
     1053   define variable vv-exch-scale as decimal   no-undo .
     1054   define variable v-cntxt-host-name-obj as character no-undo .
     1055   if v-cntxt-level = 'object':U then do:
     1056   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1057   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1058     (input  v-cntxt-obj-type
     1059     ,input  v-cntxt-obj-code
     1060     ,output v-cntxt-host-code-obj
     1061     ,output v-cntxt-host-name-obj
     1062     )  .
     1063   end.
     1064   if v-cntxt-level = 'firm':U then do:
     1065     find first ub.clients no-lock where
     1066                ub.clients.obj-type = 'орг':U and
     1067                ub.clients.obj-code = v-cntxt-host-code-obj no-error .
     1068   if error-status :error then v-cntxt-host-name-obj = ? .
     1069      else v-cntxt-host-name-obj = ub.clients.obj-name.
     1070   end.
     1071   if v-cntxt-level = 'object':U
     1072   or v-cntxt-level = 'firm':U
     1073   then do:
     1074   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1075   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run basecode in g#library
     1076     (input  v-cntxt-host-code-obj
     1077     ,output base-code
     1078     )  .
     1079   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1080   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run exchrate in g#library
     1081     (input  base-code
     1082     ,input  today
     1083     ,output vv-exch-rate
     1084     ,output vv-exch-scale
     1085     ,output base-type
     1086     )  .
     1087   end.
     1088   run get-report-num in my-handle ( output g#report-num ).
     1089   run get-gds-engl in my-handle ( output g#gds-engl ) .
     1090    do
     1091    on error undo, return error return-value
     1092    :
     1093   x-date-start = x-date-alone .
     1094   DEFINE temp-table temp-str no-undo
     1095     field   np                 as character
     1096     field   date-sm            as character
     1097     field   cli-name           as character
     1098     field   gds-name           as character
     1099     field   b-code             as integer
     1100     field   ostatok-qnty-start as decimal
     1101     field   ostatok-qnty-end   as decimal
     1102     field   ostatok-sum-start  as decimal
     1103     field   ostatok-sum-end    as decimal
     1104     field   prih-qnty          as decimal
     1105     field   prih-sum           as decimal
     1106     field   rash-qnty          as decimal
     1107     field   rash-sum           as decimal
     1108   .
     1109   define stream  macr_excel .
     1110   define variable v-file-name as character no-undo .
     1111   define variable p-file-name as character no-undo .
     1112   define variable v-ind       as integer   no-undo .
     1113   define variable num#col#    as integer no-undo .
     1114   define variable C-c         as integer no-undo .
     1115   define variable C-str       as character no-undo .
     1116   define variable str--1      as character Format "x(60)" no-undo.
     1117   define variable str--2      as integer no-undo .
     1118   define variable C-i         as integer no-undo .
     1119   define variable p-var       as integer no-undo .
     1120   define variable var-1       as integer no-undo .
     1121   define variable var-2       as integer no-undo .
     1122   def buffer buf_clients for ub.clients .
     1123   def buffer This_Object for ub.clients .
     1124   def buffer buf_goods   for ub.goods .
     1125   define variable qnty as decimal   no-undo .
     1126   define variable sum  as decimal   no-undo .
     1127   define variable vv-qnty1 as decimal   no-undo .
     1128   define variable vv-qnty2 as decimal   no-undo .
     1129   define variable num-ln as integer   no-undo .
     1130   def var i as int no-undo.
     1131   def var j as int no-undo.
     1132   define variable Counter1 as integer init 0  no-undo .
     1133   def var LineBuf       as char    no-undo.
     1134   def var Line       as char    no-undo.
     1135   def var UndLine    as char    no-undo.
     1136   def var Lines_Counter as   int  init 0  no-undo.
     1137   def var Tmp_Counter   as   int  init 0  no-undo.
     1138   def var tdoc-date     like fbr-pln.doc-date no-undo.
     1139   def var tdoc-code     like fbr-pln.doc-code no-undo.
     1140   def var  abbr              as  char no-undo.
     1141   def var  pp                as  char no-undo.
     1142     if session:set-wait-state("compiler") then.
     1143     define variable v-prn0 as character no-undo .
     1144     if var-report-r-b = "rubl" then assign pp = "Цены руб.".
     1145                                else assign pp = "Цены  баз.вал." .
     1146   define variable v-account as integer init 0 no-undo .
     1147   define variable v-account-lavel as character no-undo .
     1148   define variable v-button-stop as logical no-undo .
     1149   define variable v-kol-spice as integer no-undo .
     1150   define variable v-kol-spice2 as integer no-undo .
     1151   define variable v-kol-spice3 as integer no-undo .
     1152   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
     1153   DEFINE BUTTON StopBtn AUTO-END-KEY
     1154        LABEL "Стоп"
     1155        SIZE 10 BY 1.
     1156   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
     1157        LABEL "Обработано записей"
     1158         VIEW-AS TEXT
     1159        SIZE 14 BY .67 NO-UNDO.
     1160   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
     1161         VIEW-AS TEXT
     1162        SIZE 53.25 BY .67
     1163        FGCOLOR 1  NO-UNDO.
     1164   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1165         VIEW-AS TEXT
     1166        SIZE 53.25 BY .67
     1167        FGCOLOR 1  NO-UNDO.
     1168   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1169         VIEW-AS TEXT
     1170        SIZE 53.25 BY .67
     1171        FGCOLOR 1  NO-UNDO.
     1172   DEFINE RECTANGLE RECT-1
     1173        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1174        SIZE 55.13 BY 4.46.
     1175   DEFINE FRAME InfoFrame
     1176        StopBtn AT ROW 4.25 COL 21.75
     1177        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1178        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1179        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1180        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1181        RECT-1 AT ROW 1 COL 1
     1182       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1183            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1184            TITLE "Процесс"
     1185            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1186   define variable mFrameView      as logical   no-undo init yes.
     1187     define variable mFramHandle as handle no-undo.
     1188     mFramHandle = frame InfoFrame:handle.
     1189     if  log-manager:logfile-name ne ?
     1190     then DO:
     1191         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1192         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1193         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1194     end.
     1195     mFrameView = not session:batch-mode and mFramHandle:visible.
     1196     if mFrameView
     1197     then do:
     1198       ASSIGN
     1199          FRAME InfoFrame:HIDDEN                           = TRUE
     1200          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1201     end.
     1202   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1203   DO:
     1204     IF not StopProcessing THEN
     1205       Message "Вы действительно хотите прервать" SKIP
     1206               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1207                 UPDATE StopProcessing.
     1208     IF StopProcessing THEN do:
     1209        if mFrameView
     1210        then do:
     1211           HIDE FRAME InfoFrame.
     1212        end.
     1213     End.
     1214   END.
     1215   assign v-account = ( if integer( 25 ) = 0 then 100 else integer( 25 ) ).
     1216     if  log-manager:logfile-name ne ?
     1217     then DO:
     1218         log-manager:write-message("ON mFrameView=" + string(mFrameView), "frameRepError").
     1219     end.
     1220     if not session:batch-mode then
     1221     do:
     1222       VIEW FRAME InfoFrame.
     1223       mFrameView = true.
     1224     end.
     1225      v-button-stop = false .
     1226         if mFrameView
     1227         then do:
     1228         if v-button-stop then view STOPBTN in frame InfoFrame.
     1229                          else Hide STOPBTN in frame InfoFrame.
     1230         end.
     1231   v-ind = 0    .
     1232       Output stream Macr_Excel  close .
     1233       num#str# = 0 .
     1234       run gbl/_tmpfile.p ("wb", ".txt", output v-file-name) .
     1235       output stream macr_excel to value(v-file-name)   .
     1236       v-ind = v-ind + 1.
     1237       p-file-name =  string( session:temp-directory +
     1238                                     "rpt" + string( g#report-num ) + ".txt" ) .
     1239   define variable paris-petrolium as   logical            no-undo.
     1240   define variable paris-pieces    as   logical            no-undo.
     1241   define temp-table tt-gds-list no-undo like ub.goods.
     1242   for each tt-gds-list : delete tt-gds-list. end.
     1243   for each buf_goods no-lock :
     1244   if (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:   run str/lib-trn.p persistent no-error .   if error-status :error or (valid-handle(ibs.th.gbl.gbl-hndllib:g#lib-trn) <> true) then do:     message       "Error starting lib-trn.p" skip       ibs.th.gbl.gbl-hndllib:g#lib-trn skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :type skip       ibs.th.gbl.gbl-hndllib:g#lib-trn :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run lib-trn_is-petrl in g#lib-trn
     1245     (
     1246        input buf_goods.artic
     1247     ,  input buf_goods.prod-type
     1248     ,  input buf_goods.prod-code
     1249     , output paris-petrolium
     1250     , output paris-pieces
     1251     ) .
     1252         if paris-petrolium then do:
     1253             create tt-gds-list.
     1254             BUFFER-COPY buf_goods TO tt-gds-list.
     1255         end.
     1256   end.
     1257   for each obj-list :
     1258     run PrintTitul in this-procedure .
     1259     for each temp-str :
     1260         delete temp-str.
     1261     end.
     1262     run make-tt.
     1263     for each temp-str no-lock break by temp-str.date-sm  :
     1264       if first-of( temp-str.date-sm) then do:
     1265             run print-grp in this-procedure .
     1266             vv-qnty1 = 0 .
     1267             vv-qnty2 = 0 .
     1268          end.
     1269          run print-line in this-procedure .
     1270          vv-qnty1 = vv-qnty1 + temp-str.ostatok-qnty-start.
     1271          vv-qnty2 = vv-qnty2 + temp-str.ostatok-qnty-end.
     1272       if last-of( temp-str.date-sm ) then  run print-grp-itog in this-procedure .
     1273     end.
     1274     run PrintPodval in this-procedure .
     1275   end.
     1276     run paramls-write in this-procedure
     1277       (input "file"
     1278       ,input string(v-ind)
     1279       ,input v-file-name
     1280       ) .
     1281   Output stream Macr_Excel  close .
     1282   if mFrameView
     1283   then do:
     1284      HIDE FRAME InfoFrame.
     1285   end.
     1286       run paramls-write in this-procedure
     1287           (input "charcol"
     1288           ,input ""
     1289           ,input "1,2,3"
     1290           ) .
     1291     run end-proc in this-procedure .
     1292     run rep/runexcel.p (p-file-name ).
     1293   end.
     1294   procedure print-grp :
     1295     do  on error undo, return error return-value  :
     1296       num#str# = num#str# + 1.
     1297       run macr_excel_char ( CAPS(temp-str.date-sm)    , num#str# , 2   ) .
     1298       run macr_cell_format
     1299             ( 12    ,
     1300               true  ,
     1301               false ,
     1302               ?     ,
     1303               num#str# ,
     1304               2 ,
     1305               num#str# ,
     1306               2               ) .
     1307     end.
     1308   end procedure.
     1309   procedure print-line :
     1310     do on error undo, return error return-value :
     1311   num#str# = num#str# + 1.
     1312   num#col# = 1.
     1313   run macr_excel_char ( substring(temp-str.date-sm ,1,8) + "." , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1314   run macr_excel_char ( temp-str.cli-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1315   run macr_excel_char ( temp-str.gds-name  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1316   run macr_excel_dec ( temp-str.ostatok-qnty-start , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1317   run macr_excel_dec ( temp-str.ostatok-sum-start    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1318   run macr_excel_dec ( temp-str.prih-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1319   run macr_excel_dec ( temp-str.prih-sum            , num#str# , num#col#   ) . assign    num#col# = num#col# + 2 .
     1320   run macr_excel_char ( substitute('=r&1c7+r&1c8' , num#str#   ) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1321   run macr_excel_dec ( temp-str.rash-qnty           , num#str# , num#col#   ) . assign    num#col# = num#col# + 2 .
     1322   run macr_excel_char ( substitute('=r&1c9+r&1c11' , num#str#  ) , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1323   run macr_excel_dec ( temp-str.ostatok-qnty-end    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1324   run macr_excel_dec ( temp-str.ostatok-sum-end     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     1325     end.
     1326   end procedure.
     1327   procedure print-grp-itog :
     1328     do on error undo, return error return-value :
     1329       num#str# = num#str# + 1.
     1330       num#col# = 2.
     1331       run macr_excel_char ( "Итого" , num#str# , 2   ) .
     1332       num#col# = 4.
     1333       run macr_excel_dec ( vv-qnty1 , num#str# , num#col#   ) .
     1334       num#col# = 13 .
     1335       run macr_excel_dec ( vv-qnty2 , num#str# , num#col#   ) .
     1336       run macr_cell_format
     1337             ( 12    ,
     1338               true  ,
     1339               false ,
     1340               ?     ,
     1341               num#str# ,
     1342               2 ,
     1343               num#str# ,
     1344               2               ) .
     1345     end.
     1346   end procedure.
     1347   procedure print-all-itog :
     1348   end procedure.
     1349   procedure PrintTitul :
     1350     do  on error undo, return error return-value  :
     1351     define variable cc as integer no-undo .
     1352     define variable tt as integer no-undo .
     1353       num#str# = num#str# + 1.
     1354       num#col# = 2.
     1355       cc = num#str# .
     1356       run macr_excel_char ( "Расчет себестоимости за  " + string(x-date-alone, "99/99/9999" )    , num#str# , num#col#   ) .
     1357       num#str# = num#str# + 1.
     1358       num#col# = 2.
     1359       run macr_excel_char ( string( CAPS( obj-list.obj-name ) + " (" + string(Obj-list.obj-code) + ")" )   , num#str# , num#col#   ) .
     1360       num#str# = num#str# + 1.
     1361       num#col# = 2.
     1362       run macr_excel_char ("Печать " + cur-time-date() + "  " + pp , num#str# , num#col#   ) .
     1363       run macr_cell_format
     1364       ( 12    ,
     1365         true  ,
     1366         false  ,
     1367         ?    ,
     1368         cc ,
     1369         2 ,
     1370         num#str# ,
     1371         2 ) .
     1372       num#str# = num#str# + 1.
     1373       tt = num#str#  .
     1374        put  stream macr_excel unformatted
     1375          substitute('select("r&1c&2:r&3c&4 ")' , tt , 4 , tt , 5 ) + chr(10)  +
     1376          'ALIGNMENT(7,,4,4,)'  + chr(10)
     1377          'BORDER( 2,0,0,0,0,,0,0,0,0,0) '  + chr(10)
     1378          substitute('select("r&1c&2:r&3c&4 ")' , tt , 6 , tt , 9 ) + chr(10)  +
     1379          'ALIGNMENT(7,,4,4,)'  + chr(10)
     1380          'BORDER(2,0,0,0,0,,0,0,0,0,0) '  + chr(10)
     1381          substitute('select("r&1c&2:r&3c&4 ")' , tt , 10 , tt , 12 ) + chr(10)  +
     1382          'ALIGNMENT(7,,4,4,)'  + chr(10)
     1383          'BORDER(2,0,0,0,0,,0,0,0,0,0) '  + chr(10)
     1384          substitute('select("r&1c&2:r&3c&4 ")' , tt , 13 , tt , 14 ) + chr(10)  +
     1385          'ALIGNMENT(7,,4,4,)'  + chr(10)
     1386          'BORDER(2,0,0,0,0,,0,0,0,0,0) '  + chr(10)
     1387          .
     1388       num#col# = 4.
     1389       run macr_excel_char ( "Остаток на начало"   , num#str# , num#col#   ) .
     1390       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1391       num#col# = 6.
     1392       run macr_excel_char ( "Приход"   , num#str# , num#col#   ) .
     1393       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1394       num#col# = 10.
     1395       run macr_excel_char ( "Расход"   , num#str# , num#col#   ) .
     1396       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1397       num#col# = 13.
     1398       run macr_excel_char ( "Остаток на конец"   , num#str# , num#col#   ) .
     1399       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1400       num#str# = num#str# + 1.
     1401       num#col# = 1.
     1402       run macr_excel_char ( "Дата"   , num#str# , num#col#   ) .
     1403       run macr_cell_size ( 7 , ? , num#str# , num#col# , ?, ? ) .
     1404       num#col# = 2.
     1405       run macr_excel_char ( "Отправитель"   , num#str# , num#col#   ) .
     1406       run macr_cell_size ( 40 , ? , num#str# , num#col# , ?, ? ) .
     1407       num#col# = 3.
     1408       run macr_excel_char ( "Вид н/п"   , num#str# , num#col#   ) .
     1409       run macr_cell_size ( 20 , ? , num#str# , num#col# , ?, ? ) .
     1410       num#col# = 4.
     1411       run macr_excel_char ( "Кол-во,л"   , num#str# , num#col#   ) .
     1412       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1413       num#col# = 5.
     1414       run macr_excel_char ( "Себестоимость, руб/л"   , num#str# , num#col#   ) .
     1415       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1416       num#col# = 6.
     1417       run macr_excel_char ( "Кол-во,л"   , num#str# , num#col#   ) .
     1418       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1419       num#col# = 7.
     1420       run macr_excel_char ( "Цена"   , num#str# , num#col#   ) .
     1421       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1422       num#col# = 8.
     1423       run macr_excel_char ( " К1, руб/л"   , num#str# , num#col#   ) .
     1424       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1425       num#col# = 9.
     1426       run macr_excel_char ( "Себестоимость, руб/л"   , num#str# , num#col#   ) .
     1427       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1428       num#col# = 10.
     1429       run macr_excel_char ( "Кол-во,л"   , num#str# , num#col#   ) .
     1430       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1431       num#col# = 11.
     1432       run macr_excel_char ( " К2, руб/л"   , num#str# , num#col#   ) .
     1433       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1434       num#col# = 12.
     1435       run macr_excel_char ( "Себестоимость, руб/л"   , num#str# , num#col#   ) .
     1436       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1437       num#col# = 13.
     1438       run macr_excel_char ( "Кол-во,л"   , num#str# , num#col#   ) .
     1439       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1440       num#col# = 14.
     1441       run macr_excel_char ( "Себестоимость, руб/л"   , num#str# , num#col#   ) .
     1442       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1443       num#str# = num#str# + 1.
     1444       num#col# = 1.
     1445       run macr_excel_char ( "1"   , num#str# , num#col#   ) .
     1446       run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     1447       num#col# = 2.
     1448       run macr_excel_char ( "2"   , num#str# , num#col#   ) .
     1449       run macr_cell_size ( 40 , ? , num#str# , num#col# , ?, ? ) .
     1450       num#col# = 3.
     1451       run macr_excel_char ( "3"   , num#str# , num#col#   ) .
     1452       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1453       num#col# = 4.
     1454       run macr_excel_char ( "4"   , num#str# , num#col#   ) .
     1455       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1456       num#col# = 5.
     1457       run macr_excel_char ( "5"   , num#str# , num#col#   ) .
     1458       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1459       num#col# = 6.
     1460       run macr_excel_char ( "6"   , num#str# , num#col#   ) .
     1461       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1462       num#col# = 7.
     1463       run macr_excel_char ( "7"   , num#str# , num#col#   ) .
     1464       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1465       num#col# = 8.
     1466       run macr_excel_char ( "8"   , num#str# , num#col#   ) .
     1467       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1468       num#col# = 9.
     1469       run macr_excel_char ( "9"   , num#str# , num#col#   ) .
     1470       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1471       num#col# = 10.
     1472       run macr_excel_char ( "10"   , num#str# , num#col#   ) .
     1473       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1474       num#col# = 11.
     1475       run macr_excel_char ( "11"   , num#str# , num#col#   ) .
     1476       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1477       num#col# = 12.
     1478       run macr_excel_char ( "12"   , num#str# , num#col#   ) .
     1479       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1480       num#col# = 13.
     1481       run macr_excel_char ( "13"   , num#str# , num#col#   ) .
     1482       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1483       num#col# = 14.
     1484       run macr_excel_char ( "14"   , num#str# , num#col#   ) .
     1485       run macr_cell_size ( 15 , ? , num#str# , num#col# , ?, ? ) .
     1486       run macr_cell_format
     1487       ( 12    ,
     1488         true  ,
     1489         false  ,
     1490         ?    ,
     1491         num#str# ,
     1492         1 ,
     1493         num#str# ,
     1494         14 ) .
     1495        put  stream macr_excel unformatted
     1496          substitute('select("r&1c&2:r&3c&4 ")' , tt , 1 , num#str# ,  3 ) + chr(10)  +
     1497          'BORDER( 2 , 2 , 0 , 0 , 0 , ,0,0,0,0,0) '  + chr(10) +
     1498          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1499          .
     1500        put  stream macr_excel unformatted
     1501          substitute('select("r&1c&2:r&3c&4 ")' , tt + 1 , 4 , num#str# ,  num#col# ) + chr(10)  +
     1502          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1503          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1504          .
     1505        put  stream macr_excel unformatted
     1506          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# , 3 ) + chr(10)  +
     1507          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     1508          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1509       .
     1510     end.
     1511   end procedure.
     1512   procedure PrintPodval :
     1513     do on error undo, return error return-value  :
     1514       num#str# = num#str# + 3.
     1515       num#col# = 2.
     1516       run macr_excel_char ( "Исполнитель"   , num#str# , num#col#   ) .
     1517     end.
     1518   end procedure.
     1519   procedure make-tt :
     1520     do
     1521     on error undo, return error return-value
     1522     :
     1523     define buffer buf_shift-obj for ub.shift-obj.
     1524     define variable fact-order-1 as decimal   no-undo .
     1525     define variable fact-order-2 as decimal   no-undo .
     1526     define variable    quantity     like ub.stk-line.fact-qnty  no-undo .
     1527     define variable    coast_r      like ub.stk-line.sum-rubl   no-undo .
     1528     define variable    coast_v      like ub.stk-line.sum-rubl   no-undo .
     1529     define variable    vat_r        like ub.stk-line.sum-rubl   no-undo .
     1530     define variable    vat_v        like ub.stk-line.sum-rubl   no-undo .
     1531     define variable    slt_r        like ub.stk-line.sum-rubl   no-undo .
     1532     define variable    slt_v        like ub.stk-line.sum-rubl   no-undo .
     1533     define variable    quantity2     like ub.stk-line.fact-qnty  no-undo .
     1534     define variable    coast_r2      like ub.stk-line.sum-rubl   no-undo .
     1535     define variable    coast_v2      like ub.stk-line.sum-rubl   no-undo .
     1536     define buffer buf_trn-doc for ub.trn-doc.
     1537     define buffer buf_doc-line for ub.doc-line.
     1538     define buffer buf_clients for ub.clients.
     1539     define variable v-qnty as decimal   no-undo .
     1540     define variable v-sum as decimal   no-undo .
     1541     define variable v-cli as character no-undo .
     1542     find last buf_shift-obj no-lock where
     1543              buf_shift-obj.shift-date <= x-date-alone - 1    and
     1544              buf_shift-obj.obj-type   = obj-list.obj-type  and
     1545              buf_shift-obj.obj-code   = obj-list.obj-code  use-index pi no-error .
     1546     if available buf_shift-obj then
     1547          fact-order-2 = buf_shift-obj.fact-order.
     1548     else fact-order-2 = 0 .
     1549     for each buf_shift-obj no-lock where
     1550              buf_shift-obj.shift-date = x-date-alone     and
     1551              buf_shift-obj.obj-type   = obj-list.obj-type  and
     1552              buf_shift-obj.obj-code   = obj-list.obj-code
     1553              :
     1554            fact-order-1 = fact-order-2.
     1555            fact-order-2 = buf_shift-obj.fact-order.
     1556           if fact-order-2 = 0 and buf_shift-obj.status_   <> 'зкр':U   then do:
     1557              fact-order-2 = decimal (x-date-alone + 1 ).
     1558           end.
     1559            for each tt-gds-list :
     1560                     run ost-line (
     1561                        input   obj-list.obj-code
     1562                       ,input   obj-list.obj-type
     1563                       ,input   tt-gds-list.artic
     1564                       ,input   tt-gds-list.prod-code
     1565                       ,input   tt-gds-list.prod-type
     1566                       ,input   true
     1567                       ,input   fact-order-1
     1568                       ,input   'cost':U
     1569                       ,input   '##,##':U
     1570                       ,input   true
     1571                       ,output  quantity
     1572                       ,output  coast_r
     1573                       ,output  coast_v
     1574                       ,output  vat_r
     1575                       ,output  vat_v
     1576                       ,output  slt_r
     1577                       ,output  slt_v
     1578                       ).
     1579                     run ost-line (
     1580                        input   obj-list.obj-code
     1581                       ,input   obj-list.obj-type
     1582                       ,input   tt-gds-list.artic
     1583                       ,input   tt-gds-list.prod-code
     1584                       ,input   tt-gds-list.prod-type
     1585                       ,input   true
     1586                       ,input   fact-order-2
     1587                       ,input   'cost':U
     1588                       ,input   '##,##':U
     1589                       ,input   true
     1590                       ,output  quantity2
     1591                       ,output  coast_r2
     1592                       ,output  coast_v2
     1593                       ,output  vat_r
     1594                       ,output  vat_v
     1595                       ,output  slt_r
     1596                       ,output  slt_v
     1597                       ).
     1598                     assign
     1599                        v-qnty = 0
     1600                        v-sum  = 0
     1601                        v-cli = ""
     1602                     .
     1603                     for each buf_trn-doc no-lock where
     1604                              buf_trn-doc.fact-order >= fact-order-1 and
     1605                              buf_trn-doc.fact-order <= fact-order-2 and
     1606                              buf_trn-doc.doc-type = 'при':U  and
     1607                              buf_trn-doc.host-code = v-cntxt-host-code-obj  and
     1608                              buf_trn-doc.status_   = 'факт':U      and
     1609                              buf_trn-doc.obj-type  = obj-list.obj-type  and
     1610                              buf_trn-doc.obj-code  = obj-list.obj-code
     1611                              break by buf_trn-doc.cli-type by buf_trn-doc.cli-code
     1612                     :
     1613                        for each  buf_doc-line no-lock where
     1614                                   buf_doc-line.doc-code = buf_trn-doc.doc-code and
     1615                                   buf_doc-line.artic    =  tt-gds-list.artic and
     1616                                   buf_doc-line.prod-code =  tt-gds-list.prod-code and
     1617                                   buf_doc-line.prod-type =  tt-gds-list.prod-type
     1618                                  :
     1619                                 assign
     1620                                     v-qnty = v-qnty + buf_doc-line.fact-qnty
     1621                                     v-sum  = v-sum  + buf_doc-line.fact-qnty * (if var-report-r-b = "rubl":u then buf_doc-line.price-rubl else buf_doc-line.price-base )
     1622                                 .
     1623                        end.
     1624                         if first-of( buf_trn-doc.cli-code ) then do:
     1625                             if v-qnty <> 0 and v-sum  <> 0 then do:
     1626                               find first buf_clients no-lock where
     1627                                          buf_clients.obj-type = buf_trn-doc.cli-type and
     1628                                          buf_clients.obj-code = buf_trn-doc.cli-code
     1629                                          no-error .
     1630                               if available buf_clients then  v-cli = v-cli + buf_clients.obj-name  + "," .
     1631                             end.
     1632                         end.
     1633                     end.
     1634                     if not( v-qnty = 0 and quantity = 0 and quantity2 = 0) then do:
     1635                     create temp-str .
     1636                     assign
     1637                         temp-str.np             = buf_shift-obj.shift-name
     1638                         temp-str.date-sm        = string (buf_shift-obj.shift-date, "99/99/99")  + " Смена " + string (buf_shift-obj.shift-name)
     1639                         temp-str.gds-name       = tt-gds-list.gds-name
     1640                         temp-str.b-code         = tt-gds-list.gds-code
     1641                         temp-str.ostatok-qnty-start =  quantity
     1642                         temp-str.ostatok-qnty-end   =  quantity2
     1643                         temp-str.ostatok-sum-start  = round((if var-report-r-b = "rubl":u then coast_r else coast_v )  / quantity   , 2)
     1644                         temp-str.ostatok-sum-end    = round((if var-report-r-b = "rubl":u then coast_r2 else coast_v2) / quantity2  , 2)
     1645                         temp-str.prih-qnty   = v-qnty
     1646                         temp-str.prih-sum    = round( v-sum  / v-qnty   , 2 )
     1647                         temp-str.rash-qnty   = (temp-str.ostatok-qnty-end - temp-str.ostatok-qnty-start - temp-str.prih-qnty) * ( - 1 )
     1648                         temp-str.cli-name    = v-cli
     1649                         no-error .
     1650                         if buf_shift-obj.status_   <> 'зкр':U then
     1651                            temp-str.date-sm        = string (buf_shift-obj.shift-date, "99/99/99")  + " Смена " + string (buf_shift-obj.shift-name) + " текущая"
     1652                            .
     1653                         if temp-str.ostatok-sum-start = ? then temp-str.ostatok-sum-start = 0 .
     1654                         if temp-str.ostatok-sum-end   = ? then temp-str.ostatok-sum-end   = 0 .
     1655                         if temp-str.prih-sum   = ? then temp-str.prih-sum   = 0 .
     1656                     end.
     1657            end.
     1658     end.
     1659     end.
     1660    end procedure.
     1661   def var vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1662   procedure macr_excel_char :
     1663    do
     1664    on error undo, return error return-value
     1665    :
     1666    define input parameter  p-val as character no-undo .
     1667    define input parameter  p-row as integer no-undo .
     1668    define input parameter  p-col as integer no-undo .
     1669    if p-val = ? then p-val = "" .
     1670       put stream macr_excel unformatted
     1671             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1672    end.
     1673   end procedure.
     1674   procedure macr_excel_char_with_format :
     1675    do
     1676    on error undo, return error return-value
     1677    :
     1678    define input parameter  p-val as character no-undo .
     1679    define input parameter  p-row as integer no-undo .
     1680    define input parameter  p-col as integer no-undo .
     1681    if p-val = ? then p-val = "" .
     1682       put stream macr_excel unformatted
     1683             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1684       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     1685       put stream macr_excel unformatted
     1686             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1687    end.
     1688   end procedure.
     1689   procedure macr_excel_cell_format :
     1690    do
     1691    on error undo, return error return-value
     1692    :
     1693    define input parameter  p-val    as character no-undo .
     1694    define input parameter  p-row    as integer   no-undo .
     1695    define input parameter  p-col    as integer   no-undo .
     1696    define input parameter  p-format as character no-undo .
     1697    if p-val = ? then p-val = "" .
     1698       put stream macr_excel unformatted
     1699             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     1700       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     1701       put stream macr_excel unformatted
     1702             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     1703    end.
     1704   end procedure.
     1705   procedure macr_excel_sum :
     1706    do
     1707    on error undo, return error return-value
     1708    :
     1709    define input parameter  p-row as integer no-undo .
     1710    define input parameter  p-col as integer no-undo .
     1711    define input parameter  p-row1 as integer no-undo .
     1712    define input parameter  p-col1 as integer no-undo .
     1713    define input parameter  p-row2 as integer no-undo .
     1714    define input parameter  p-col2 as integer no-undo .
     1715       put stream macr_excel unformatted
     1716             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     1717    end.
     1718   end procedure.
     1719   procedure macr_excel_dec :
     1720    do
     1721    on error undo, return error return-value
     1722    :
     1723    define input parameter  p-val as character no-undo .
     1724    define input parameter  p-row as integer   no-undo .
     1725    define input parameter  p-col as integer   no-undo .
     1726     if p-val = ? then p-val =  "" .
     1727      put  stream macr_excel unformatted
     1728           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     1729    end.
     1730   end procedure.
     1731   procedure macr_cell_format :
     1732    do
     1733    on error undo, return error return-value
     1734    :
     1735    define input parameter  p-size   as integer   no-undo .
     1736    define input parameter  p-bold   as logical   no-undo .
     1737    define input parameter  p-italic as logical   no-undo .
     1738    define input parameter  p-color  as integer   no-undo .
     1739    define input parameter  p-row    as integer   no-undo .
     1740    define input parameter  p-col    as integer   no-undo .
     1741    define input parameter  p-row-2  as integer   no-undo .
     1742    define input parameter  p-col-2  as integer   no-undo .
     1743     if p-size = ? then p-size = 10 .
     1744     if p-bold = ? then p-bold = false .
     1745     if p-italic = ? then p-italic = false .
     1746     if p-row-2 = ? then p-row-2 = p-row .
     1747     if p-col-2 = ? then p-col-2 = p-col .
     1748     put  stream macr_excel unformatted
     1749      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     1750     if p-color <> ? then do:
     1751        put  stream macr_excel unformatted
     1752          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     1753     end.
     1754     put  stream macr_excel unformatted
     1755          substitute('format.font(,&1,&2,&3)' , p-size,
     1756                                           string ( p-bold  , "true/false" ) ,
     1757                                           string ( p-italic , "true/false" )
     1758                                           ) + chr(10) .
     1759    end.
     1760   end procedure.
     1761   procedure macr_cell_size :
     1762    do
     1763    on error undo, return error return-value
     1764    :
     1765    define input parameter  p-w   as integer   no-undo .
     1766    define input parameter  p-l   as integer   no-undo .
     1767    define input parameter  p-row    as integer   no-undo .
     1768    define input parameter  p-col    as integer   no-undo .
     1769    define input parameter  p-row-2  as integer   no-undo .
     1770    define input parameter  p-col-2  as integer   no-undo .
     1771     if p-row-2 = ? then p-row-2 = p-row .
     1772     if p-col-2 = ? then p-col-2 = p-col .
     1773     if p-w = ? then    p-w = 0 .
     1774     if p-l = ? then    p-l = 0 .
     1775    define variable s-w as character no-undo .
     1776    define variable s-l as character no-undo .
     1777    if p-w = 0 then s-w = "" .
     1778               else s-w = string(p-w)  .
     1779    if p-l = 0 then s-l = "" .
     1780               else s-l = string(p-l)  .
     1781   put  stream macr_excel unformatted
     1782        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     1783   put  stream macr_excel unformatted
     1784        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     1785   put  stream macr_excel unformatted
     1786        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     1787    end.
     1788   end procedure.
     1789   procedure proc-print-header :
     1790    do
     1791    on error undo, return error return-value
     1792    :
     1793      find first sheetf .
     1794        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     1795        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     1796        var-1 =  num#str# .
     1797        repeat c-c = 1 to sheetf.excel-row-title :
     1798        num#str# = num#str# + 1 .
     1799        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     1800        do c-i = 1 to p-var :
     1801           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     1802           str--2 = integer(entry( c-i, sheetf.sizes )) .
     1803           num#col# = c-i .
     1804           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     1805           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     1806        end.
     1807       c-i = 0.
     1808       end.
     1809       run macr_cell_format (
     1810           10       ,
     1811           true     ,
     1812           false    ,
     1813           35       ,
     1814           var-1 + 1,
     1815           1        ,
     1816           num#str# ,
     1817           num#col# )
     1818           .
     1819     put  stream macr_excel unformatted
     1820          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     1821          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     1822          .
     1823    end.
     1824   end procedure.
     1825   procedure end-proc :
     1826    do
     1827    on error undo, return error return-value
     1828    :
     1829     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     1830     OUTPUT to VALUE (v-file-name) .
     1831     for each temp-param :
     1832       export  temp-param  .
     1833     end.
     1834    end.
     1835   end procedure.
     1836   procedure ost-line :
     1837     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     1838     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     1839     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     1840     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     1841     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     1842     define input  parameter x-tog-shift  as logical no-undo .
     1843     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     1844     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     1845     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     1846     define input  parameter xtog-obj     as logical no-undo .
     1847     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     1848     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     1849     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     1850     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     1851     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     1852     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     1853     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     1854     define buffer buff-obj-list  for obj-list .
     1855     define buffer buff-stk-line  for ub.stk-line .
     1856     assign
     1857       Quantity = 0
     1858       Coast_R  = 0
     1859       Coast_V  = 0
     1860       VAT_R    = 0
     1861       VAT_V    = 0
     1862       SLT_R    = 0
     1863       SLT_V    = 0
     1864     .
     1865     if  x-tog-shift = false then do:
     1866       for each buff-obj-list no-lock
     1867         where xtog-obj = false
     1868            or (buff-obj-list.obj-type = x-store-type
     1869               and buff-obj-list.obj-code = x-store-code
     1870               )
     1871       on error undo, return error
     1872       :
     1873       find last buff-stk-line no-lock
     1874         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1875           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1876           and buff-stk-line.artic      = x-artic
     1877           and buff-stk-line.prod-type  = x-prod-type
     1878           and buff-stk-line.prod-code  = x-prod-code
     1879           and buff-stk-line.sum-type   = x-sum-type
     1880           and buff-stk-line.cat-id     = '##,##':U
     1881           and buff-stk-line.fact-order <= x-fact-order
     1882           and buff-stk-line.shift-num  = 0
     1883         use-index category
     1884         no-error .
     1885       if available buff-stk-line then do:
     1886         assign
     1887           Quantity = Quantity + buff-stk-line.fact-qnty
     1888           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1889           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1890           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1891           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1892           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1893           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1894         .
     1895       end.
     1896      end.
     1897     end.
     1898     else do:
     1899       for each buff-obj-list no-lock
     1900         where xtog-obj = false
     1901            or (buff-obj-list.obj-type = x-store-type
     1902               and buff-obj-list.obj-code = x-store-code
     1903               )
     1904       on error undo, return error
     1905       :
     1906         find last buff-stk-line no-lock
     1907           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1908             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1909             and buff-stk-line.artic      = x-artic
     1910             and buff-stk-line.prod-type  = x-prod-type
     1911             and buff-stk-line.prod-code  = x-prod-code
     1912             and buff-stk-line.sum-type   = x-sum-type
     1913             and buff-stk-line.cat-id     = '##,##':U
     1914             and buff-stk-line.fact-order <= x-fact-order
     1915             and buff-stk-line.shift-num  > 0
     1916           use-index category
     1917           no-error .
     1918         if available buff-stk-line then do:
     1919           assign
     1920             Quantity = Quantity +  buff-stk-line.fact-qnty
     1921             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     1922             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     1923             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     1924             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     1925             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     1926             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     1927           .
     1928         end.
     1929       end.
     1930     end.
     1931   end procedure.
     1932   procedure ost-lineother-tax :
     1933     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     1934     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     1935     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     1936     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     1937     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     1938     define input  parameter x-tog-shift  as logical no-undo .
     1939     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     1940     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     1941     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     1942     define input  parameter xTog-obj     as logical no-undo .
     1943     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     1944     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     1945     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     1946     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     1947     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     1948     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     1949     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     1950     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     1951     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     1952     define buffer buff-obj-list  for obj-list .
     1953     define buffer buff-stk-line  for ub.stk-line .
     1954     assign
     1955       Quantity = 0
     1956       Coast_R  = 0
     1957       Coast_V  = 0
     1958       VAT_R    = 0
     1959       VAT_V    = 0
     1960       SLT_R    = 0
     1961       SLT_V    = 0
     1962       other_R  = 0
     1963       other_V  = 0
     1964     .
     1965     if  x-tog-shift = false then do:
     1966       for each buff-obj-list no-lock
     1967         where xtog-obj = false
     1968            or (buff-obj-list.obj-type = x-store-type
     1969               and buff-obj-list.obj-code = x-store-code
     1970               )
     1971       on error undo, return error
     1972       :
     1973       find last buff-stk-line no-lock
     1974         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     1975           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     1976           and buff-stk-line.artic      = x-artic
     1977           and buff-stk-line.prod-type  = x-prod-type
     1978           and buff-stk-line.prod-code  = x-prod-code
     1979           and buff-stk-line.sum-type   = x-sum-type
     1980           and buff-stk-line.cat-id     = '##,##':U
     1981           and buff-stk-line.fact-order <= x-fact-order
     1982           and buff-stk-line.shift-num  = 0
     1983         use-index category
     1984         no-error .
     1985       if available buff-stk-line then do:
     1986         assign
     1987           Quantity = Quantity + buff-stk-line.fact-qnty
     1988           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     1989           Coast_V  = Coast_V  + buff-stk-line.sum-base
     1990           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     1991           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     1992           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     1993           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     1994           other_R  = other_R  + buff-stk-line.other-rubl
     1995           other_V  = other_V  + buff-stk-line.other-base
     1996         .
     1997       end.
     1998    end.
     1999     end.
     2000     else do:
     2001       for each buff-obj-list no-lock
     2002         where xtog-obj = false
     2003            or (buff-obj-list.obj-type = x-store-type
     2004               and buff-obj-list.obj-code = x-store-code
     2005               )
     2006       on error undo, return error
     2007       :
     2008         find last buff-stk-line no-lock
     2009           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2010             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2011             and buff-stk-line.artic      = x-artic
     2012             and buff-stk-line.prod-type  = x-prod-type
     2013             and buff-stk-line.prod-code  = x-prod-code
     2014             and buff-stk-line.sum-type   = x-sum-type
     2015             and buff-stk-line.cat-id     = '##,##':U
     2016             and buff-stk-line.fact-order <= x-fact-order
     2017             and buff-stk-line.shift-num  > 0
     2018           use-index category
     2019           no-error .
     2020         if available buff-stk-line then do:
     2021           assign
     2022             Quantity = Quantity +  buff-stk-line.fact-qnty
     2023             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2024             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2025             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2026             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2027             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2028             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2029             other_R = other_R   +  buff-stk-line.other-rubl
     2030             other_V = other_V   +  buff-stk-line.other-base
     2031           .
     2032         end.
     2033       end.
     2034     end.
     2035   end procedure.
     2036   procedure ost-line-kg :
     2037     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2038     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2039     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2040     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2041     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2042     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2043     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2044     define buffer buff-obj-list  for obj-list .
     2045     define buffer buf_doc-line for ub.doc-line .
     2046     define buffer buf_inv-line for ub.inv-line .
     2047     do
     2048     on error undo, return error
     2049     :
     2050       for each buf_doc-line no-lock where
     2051                buf_doc-line.obj-type    = p-obj-type   and
     2052                buf_doc-line.obj-code    = p-obj-code   and
     2053                buf_doc-line.prod-type   = p-prod-type  and
     2054                buf_doc-line.prod-code   = p-prod-code  and
     2055                buf_doc-line.artic       = p-artic      and
     2056                buf_doc-line.status_     = 'факт':U      and
     2057                buf_doc-line.fact-order <= p-fact-order
     2058             by buf_doc-line.fact-order    descending
     2059       :
     2060         find first buf_inv-line no-lock where
     2061                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2062                    buf_inv-line.artic     = buf_doc-line.artic     and
     2063                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2064                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2065         if available buf_inv-line
     2066         then do:
     2067           if buf_inv-line.after-cli-qnty <> ?
     2068           then do:
     2069             assign
     2070               p-quantity-kg = buf_inv-line.after-cli-qnty
     2071             .
     2072             leave .
     2073           end.
     2074         end.
     2075       end.
     2076       if p-quantity-kg = ?
     2077       then do:
     2078         assign
     2079           p-quantity-kg = 0
     2080         .
     2081       end.
     2082     end.
     2083   end procedure.
