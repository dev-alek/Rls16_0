      149   procedure create_obj-list :
      150      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      151      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      152      do
      153      on error undo, return error return-value
      154      :
      155         define buffer cli-obj for ub.clients .
      156         define variable p-var as integer no-undo .
      157         define buffer buf_obj-list for obj-list .
      158         find last buf_obj-list  use-index pi no-error .
      159         if available buf_obj-list
      160         then
      161            p-var = buf_obj-list.obj-id + 1.
      162         else
      163            p-var = 1.
      164         find first cli-obj where
      165                   cli-obj.obj-type = p-obj-type
      166               and cli-obj.obj-code = p-obj-code
      167         no-lock no-error.
      168         if available cli-obj
      169         then do:
      170            create buf_obj-list.
      171            assign
      172               buf_obj-list.obj-id   = p-var
      173               buf_obj-list.obj-code = cli-obj.obj-code
      174               buf_obj-list.obj-type = cli-obj.obj-type
      175               buf_obj-list.obj-name = cli-obj.obj-name
      176               buf_obj-list.db-num   = cli-obj.db-num
      177            .
      178         end.
      179      end.
      180   end.
