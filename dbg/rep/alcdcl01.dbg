     5573                   ,input t-doc.base-scale
     5574                   ,input v-curr-r-b
     5575                   ,input ?
     5576                   ,input ?
     5577                   ,input ?
     5578                   ,input ?
     5579                   ,input ?
     5580                   ,input ?
     5581                   ) no-error .
