     4175     (input  bf_trn-doc.obj-type
     4176     ,input  bf_trn-doc.obj-code
     4177     ,input  varb-code
     4178     ,input  0
     4179     ,input  bf_trn-doc.fact-order
     4180     ,output vardoc-num
     4181     ,output varprice-sale
     4182     ,output varroad-tax
     4183     ,output varexcise
     4184     )  .
     4185             if varprice-sale = ?
     4186             then do:
     4187               assign
     4188                 varprice-sale = 0
     4189                 varroad-tax   = 0
     4190                 varexcise     = 0
     4191               .
     4192             end.
     4193             assign
     4194               varlastcur-base     = varprice-sale
     4195               varlastcur-road-tax = varroad-tax
     4196               varlastcur-excise   = varexcise
     4197               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     4198               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     4199               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     4200               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     4201             .
     4202         end.
     4203       end.
     4204       if varcur-fact-qnty = 0 then do:
     4205         assign
     4206           varcur-base      = varlastcur-base
     4207           varcur-road-tax  = varlastcur-road-tax
     4208           varcur-excise    = varlastcur-excise
     4209         .
     4210       end.
     4211       else do:
     4212         assign
     4213           varcur-base      = varcur-base      / varcur-fact-qnty
     4214           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     4215           varcur-excise    = varcur-excise    / varcur-fact-qnty
     4216         .
     4217       end.
     4218       if varcur-vat-pc = ?
