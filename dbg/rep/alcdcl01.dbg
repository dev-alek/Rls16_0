     2366             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2367             and buff-stk-line.artic      = x-artic
     2368             and buff-stk-line.prod-type  = x-prod-type
     2369             and buff-stk-line.prod-code  = x-prod-code
     2370             and buff-stk-line.sum-type   = x-sum-type
     2371             and buff-stk-line.cat-id     = '##,##':U
     2372             and buff-stk-line.fact-order <= x-fact-order
     2373             and buff-stk-line.shift-num  > 0
