     1999   procedure clntattr-exist :
     2000     define input  parameter p-obj-type like ub.clients-attr.obj-type   no-undo .
     2001     define input  parameter p-obj-code like ub.clients-attr.obj-code   no-undo .
     2002     define input  parameter p-code     like ub.clients-attr.attr-code  no-undo .
     2003     define output parameter p-exist    as logical  no-undo .
     2004     do
