     2192   procedure ost-line :
     2193     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     2194     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     2195     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     2196     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     2197     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     2198     define input  parameter x-tog-shift  as logical no-undo .
     2199     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     2200     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     2201     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     2202     define input  parameter xtog-obj     as logical no-undo .
     2203     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     2204     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     2205     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     2206     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     2207     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     2208     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     2209     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     2210     define buffer buff-obj-list  for obj-list .
     2211     define buffer buff-stk-line  for ub.stk-line .
     2212     assign
     2213       Quantity = 0
     2214       Coast_R  = 0
     2215       Coast_V  = 0
     2216       VAT_R    = 0
     2217       VAT_V    = 0
     2218       SLT_R    = 0
     2219       SLT_V    = 0
     2220     .
     2221     if  x-tog-shift = false then do:
     2222       for each buff-obj-list no-lock
     2223         where xtog-obj = false
     2224            or (buff-obj-list.obj-type = x-store-type
     2225               and buff-obj-list.obj-code = x-store-code
     2226               )
     2227       on error undo, return error
     2228       :
     2229         find last buff-stk-line no-lock
     2230           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2231             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2232             and buff-stk-line.artic      = x-artic
     2233             and buff-stk-line.prod-type  = x-prod-type
     2234             and buff-stk-line.prod-code  = x-prod-code
     2235             and buff-stk-line.sum-type   = x-sum-type
     2236             and buff-stk-line.cat-id     = '##,##':U
     2237             and buff-stk-line.fact-order <= x-fact-order
     2238             and buff-stk-line.shift-num  = 0
     2239           use-index category
     2240           no-error .
     2241         if available buff-stk-line then do:
     2242           assign
     2243             Quantity = Quantity +  buff-stk-line.fact-qnty
     2244             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2245             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2246             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2247             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2248             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2249             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2250           .
     2251         end.
     2252       end.
     2253     end.
     2254     else do:
     2255       for each buff-obj-list no-lock
     2256         where xtog-obj = false
     2257            or (buff-obj-list.obj-type = x-store-type
     2258               and buff-obj-list.obj-code = x-store-code
     2259               )
     2260       on error undo, return error
     2261       :
     2262         find last buff-stk-line no-lock
     2263           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     2264             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2265             and buff-stk-line.artic      = x-artic
     2266             and buff-stk-line.prod-type  = x-prod-type
     2267             and buff-stk-line.prod-code  = x-prod-code
     2268             and buff-stk-line.sum-type   = x-sum-type
     2269             and buff-stk-line.cat-id     = '##,##':U
     2270             and buff-stk-line.fact-order <= x-fact-order
     2271             and buff-stk-line.shift-num  > 0
     2272           use-index category
     2273           no-error .
     2274         if available buff-stk-line then do:
     2275           assign
     2276             Quantity = Quantity +  buff-stk-line.fact-qnty
     2277             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     2278             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     2279             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     2280             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     2281             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     2282             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     2283           .
     2284         end.
     2285       end.
     2286     end.
     2287   end procedure.
     2288   procedure ost-lineother-tax :
     2289     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     2290     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     2291     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     2292     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     2293     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
