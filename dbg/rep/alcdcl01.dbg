     5990       v-str-total-not-local-rus-qnty  = str-format( v-gt-total-not-local-rus-qnty  , ">>>>>>>>>9.9999" , 0 )
     5991       v-str-total-not-local-imp-qnty  = str-format( v-gt-total-not-local-imp-qnty  , ">>>>>>>>>9.9999" , 0 )
     5992       v-str-ras-qnty                  = str-format( v-gt-ras-qnty                  , ">>>>>>>>>9.9999" , 0 )
     5993       v-str-spis-qnty                 = str-format( v-gt-spis-qnty                 , ">>>>>>>>>9.9999" , 0 )
     5994       v-str-ost-end-qnty              = str-format( v-gt-ost-end-qnty              , ">>>>>>>>>9.9999" , 0 )
     5995     .
     5996     if Make-Excel then  put   stream ForExcel unformatted
     5997       ""                              CHR(9)
     5998       "ИТОГО:"                        CHR(9)
