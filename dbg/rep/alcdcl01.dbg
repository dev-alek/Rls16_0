     5658                         v-total-not-local-rus-qnty  = v-total-not-local-rus-qnty + v-part-qnty
     5659                       .
     5660                     end.
     5661                 end.
     5662               end.
     5663             end.
     5664             when 'ee':U  then do:
     5665               assign
     5666                 v-ras       = v-ras + abs(buf_ot-line.sum-rubl  / 1000)
     5667                 v-ras-qnty  = v-ras-qnty + v-ot-line-qnty
     5668               .
     5669             end.
     5670             when 'es':U  then do:
     5671               assign
     5672                 v-ras       = v-ras + abs(buf_ot-line.sum-rubl  / 1000)
     5673                 v-ras-qnty  = v-ras-qnty + v-ot-line-qnty
     5674               .
     5675             end.
     5676             when 're':U  then do:
     5677               assign
