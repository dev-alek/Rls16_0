     5109           v-object = ""
     5110         .
     5111       end.
     5112       else do:
     5113         if v-fmtcli-addres = "" then do:
     5114           assign
     5115             v-object = v-fmtcli-name
     5116           .
     5117         end.
     5118         else do:
     5119           assign
     5120             v-object = substitute("&1, &2", v-fmtcli-name, v-fmtcli-addres)
     5121           .
     5122         end.
     5123       end.
     5124       assign
     5125         v-str = v-object
     5126       .
     5127       if Make-Excel then  put   stream ForExcel unformatted
     5128         if first(obj-list.obj-type) and first (obj-list.obj-code) then
     5129           "Объект торговли и (или) общественного питания, его адрес"
     5130         else ""
     5131         CHR(9)
     5132         v-str               CHR(9)
     5133       skip.
     5134       do while v-str <> ""
     5135       :
     5136         assign
     5137           v-object  = substring(v-str, 1 , 87)
     5138           v-str     = substring(v-str, 87 , length(v-str))
     5139         .
     5140         if first(obj-list.obj-type) and first (obj-list.obj-code) then do:
     5141           put stream out-stream
     5142             ": Объект торговли и (или) общественного питания, его адрес" at 10 ":" at 91 v-object ":" at 179
     5143             v-line format "X(170)" at 10 skip
     5144           .
     5145         end.
     5146         else do:
     5147           put stream out-stream
     5148             ":" at 10 ":" at 91 v-object ":" at 179
     5149             v-line format "X(170)" at 10 skip
     5150           .
     5151         end.
     5152       end.
     5153     end.
     5154     put stream out-stream
     5155       ": Номер, регистрационный номер, дата, срок действия лицензии" at 10 ":" at 91 v-sertificate ":" at 179
     5156       v-line format "X(170)" at 10 skip
     5157     .
     5158     if Make-Excel then  put   stream ForExcel unformatted
     5159       "Номер, регистрационный номер, дата, срок действия лицензии"  CHR(9)
     5160       v-sertificate               CHR(9)
     5161     skip.
     5162     page stream out-stream.
     5163     down stream out-stream 1 .
     5164   end.
     5165   end procedure.
