     2392   procedure ost-line-kg :
     2393     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     2394     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     2395     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     2396     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     2397     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     2398     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     2399     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     2400     define buffer buff-obj-list  for obj-list .
     2401     define buffer buf_doc-line for ub.doc-line .
     2402     define buffer buf_inv-line for ub.inv-line .
     2403     do
     2404     on error undo, return error
     2405     :
     2406       for each buf_doc-line no-lock where
     2407                buf_doc-line.obj-type    = p-obj-type   and
     2408                buf_doc-line.obj-code    = p-obj-code   and
     2409                buf_doc-line.prod-type   = p-prod-type  and
     2410                buf_doc-line.prod-code   = p-prod-code  and
     2411                buf_doc-line.artic       = p-artic      and
     2412                buf_doc-line.status_     = 'факт':U      and
     2413                buf_doc-line.fact-order <= p-fact-order
     2414             by buf_doc-line.fact-order    descending
     2415       :
     2416         find first buf_inv-line no-lock where
     2417                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     2418                    buf_inv-line.artic     = buf_doc-line.artic     and
     2419                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     2420                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     2421         if available buf_inv-line
     2422         then do:
     2423           if buf_inv-line.after-cli-qnty <> ?
     2424           then do:
     2425             assign
     2426               p-quantity-kg = buf_inv-line.after-cli-qnty
     2427             .
     2428             leave .
     2429           end.
     2430         end.
     2431       end.
     2432       if p-quantity-kg = ?
     2433       then do:
     2434         assign
     2435           p-quantity-kg = 0
     2436         .
     2437       end.
     2438     end.
     2439   end procedure.
