     5583                 then do:
     5584                   message
     5585                     vss-workfile vss-revision vss-description skip
     5586                     "Ошибка при вызове процедуры clcprtsl_calc-ttable" skip
     5587                     error-status :get-message(1) skip
     5588                     return-value skip
     5589                   view-as alert-box error .
     5590                   return error.
     5591                 end.
     5592                 find first tt-allsum-line
     5593                       where tt-allsum-line.sum-type = 'основная_сумма':U
     5594                 no-error.
     5595                 if available tt-allsum-line
     5596                 then do:
     5597                     assign
     5598                         v-part-sum-r =  if x-SET_PAY_TYPE = 1 then tt-allsum-line.sum-dsc-rubl-doc / 1000
     5599                                         else tt-allsum-line.sum-dsc-rubl-acc / 1000
     5600                     .
     5601                 end.
     5602                 else do:
     5603                   message
     5604                     vss-workfile vss-revision vss-description skip
     5605                     "Не найдена сумма для партии!" skip
     5606                     error-status :get-message(1) skip
     5607                     return-value skip
     5608                   view-as alert-box error .
     5609                   return error.
     5610                 end.
     5611                 assign
     5612                   v-part-qnty = buf_parts.fact-qnty * tt-gds.ms-base / 10
     5613                 .
     5614                 run clntattr-value in this-procedure  ( input buf_parts.supp-type
     5615                                                       , input buf_parts.supp-code
     5616                                                       , input 'cli-local':U
     5617                                                       , output v-cli-local
     5618                                                       , output v-attr-type
     5619                                                       ) .
