     5542                   message
     5543                     vss-workfile vss-revision vss-description skip
     5544                     "Не найден складской документ" buf_parts.in-code
     5545                     view-as alert-box error .
     5546                   next.
     5547                 end.
     5548                 find first buf_doc-line no-lock
     5549                   where buf_doc-line.doc-code  = buf_parts.in-code
     5550                     and buf_doc-line.artic     = buf_ot-line.artic
     5551                     and buf_doc-line.prod-type = buf_ot-line.prod-type
     5552                     and buf_doc-line.prod-code = buf_ot-line.prod-code
     5553                   no-error .
     5554                 if not available buf_doc-line
     5555                 then do:
     5556                   message
     5557                     vss-workfile vss-revision vss-description skip
     5558                     "Не найдена строка документа" skip
     5559                     "Складской документ" buf_parts.in-code skip
     5560                     "Артикул" buf_ot-line.artic buf_ot-line.prod-type buf_ot-line.prod-code skip
     5561                     view-as alert-box error .
     5562                   next.
     5563                 end.
     5564                 run clcprtsl_calc-ttable in this-procedure
     5565                   (input true
     5566                   ,input true
     5567                   ,input buf_doc-line.road-tax
     5568                   ,input buf_doc-line.excise
     5569                   ,input buf_doc-line.vat-pc
     5570                   ,input buf_doc-line.cons-vat-pc
     5571                   ,input buf_doc-line.slt-pc
