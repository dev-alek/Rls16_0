     4460   define variable vss-include-info30 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4461   define variable gp-doc-num    like ub.price-list.doc-num    no-undo.
     4462   define variable gp-price-sale like ub.price-list.price-sale no-undo.
     4463   define variable gp-road-tax   like ub.price-list.road-tax   no-undo.
     4464   define variable gp-excise     like ub.price-list.excise     no-undo.
     4465   define variable gp-b-code     like ub.bar-code.b-code       no-undo.
     4466   define variable gp-fact-order as decimal   no-undo .
     4467   define variable gp-price-sale-parts as decimal   no-undo .
     4468   define variable vss-include-info31 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4469   define new global shared variable g#trdcalib as handle no-undo.
     4470   define temp-table temp-font no-undo
     4471     field fontnum  as integer
     4472     field fontname as character
     4473     field fontsize as character
     4474     field fonttype as character
     4475     field font-h   as integer
     4476     field font-w   as integer
     4477     field v-row    as integer
     4478     field v-col    as integer
     4479     field v-row-lans as integer
     4480     field v-col-lans as integer
     4481   index pi fontnum
     4482   .
     4483   procedure get-font-ini :
     4484     do
     4485     on error undo, return error return-value
     4486     :
     4487   define variable ii as integer   no-undo .
     4488   define variable v-font7 as character no-undo .
     4489   define variable v-font as character no-undo .
     4490   define variable loc-name as character no-undo .
     4491   define variable loc-size as character no-undo .
     4492   define variable loc-type as character no-undo .
     4493   define variable old_H as integer   no-undo .
     4494   define variable old_w as integer   no-undo .
     4495   define variable old-row  as integer   no-undo .
     4496   define variable old-col  as integer   no-undo .
     4497   define variable old-row-lans  as integer   no-undo .
     4498   define variable old-col-lans  as integer   no-undo .
     4499   define variable vv as integer   no-undo .
     4500   empty temp-table temp-font.
     4501     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     4502       case num-entries (v-font7) :
     4503         when 4 then do:
     4504             assign
     4505               loc-name = entry ( 1 , v-font7 )
     4506               loc-size = entry ( 2 , v-font7 )
     4507               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     4508             .
     4509         end.
     4510         when 3 then do:
     4511             assign
     4512               loc-name = entry ( 1 , v-font7 )
     4513               loc-size = entry ( 2 , v-font7 )
     4514               loc-type = entry ( 3 , v-font7 )
     4515             .
     4516         end.
     4517         when 2 then  do:
     4518             assign
     4519               loc-name = entry ( 1 , v-font7 )
     4520               loc-size = entry ( 2 , v-font7 )
     4521               loc-type = ""
     4522             .
     4523         end.
     4524         when 1 then do:
     4525             assign
     4526               loc-name = trim(entry ( 1 , v-font7 ))
     4527               loc-size = ""
     4528               loc-type = ""
     4529             .
     4530         end.
     4531       end case.
     4532     create temp-font.
     4533     assign
     4534       temp-font.fontnum  = 7
     4535       temp-font.fontname = trim(loc-name)
     4536       temp-font.fontsize = trim(loc-size)
     4537       temp-font.fonttype = trim(loc-type)
     4538       temp-font.v-row    = 62
     4539       temp-font.v-col    = 136
     4540       temp-font.v-row-lans = 43
     4541       temp-font.v-col-lans = 198
     4542     .
     4543     repeat ii = 16 to 100 :
     4544       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     4545       if v-font = "" or v-font = ? then leave.
     4546       case num-entries (v-font) :
     4547         when 4 then do:
     4548             assign
     4549               loc-name = entry ( 1 , v-font )
     4550               loc-size = entry ( 2 , v-font )
     4551               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     4552             .
     4553         end.
     4554         when 3 then do:
     4555             assign
     4556               loc-name = entry ( 1 , v-font )
     4557               loc-size = entry ( 2 , v-font )
     4558               loc-type = entry ( 3 , v-font )
     4559             .
     4560         end.
     4561         when 2 then do:
     4562             assign
     4563               loc-name = entry ( 1 , v-font )
     4564               loc-size = entry ( 2 , v-font )
     4565               loc-type = ""
     4566             .
     4567         end.
     4568         when 1 then do:
     4569             assign
     4570               loc-name = trim(entry ( 1 , v-font ))
     4571               loc-size = ""
     4572               loc-type = ""
     4573             .
     4574         end.
     4575       end case.
     4576     create temp-font.
     4577     assign
     4578       temp-font.fontnum  = ii
     4579       temp-font.fontname = trim(loc-name)
     4580       temp-font.fontsize = trim(loc-size)
     4581       temp-font.fonttype = trim(loc-type)
     4582     .
     4583     end.
     4584       for each temp-font :
     4585          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     4586          if  vv = ? then vv =  0 .
     4587           run rep/exfont.p (
     4588             input   temp-font.fontname ,
     4589             input   vv ,
     4590             input   temp-font.fonttype ,
     4591             output  temp-font.font-h   ,
     4592             output  temp-font.font-w   )
     4593           .
     4594       end.
     4595   find first temp-font where  temp-font.fontnum  = 7  .
     4596   old_H = temp-font.font-H .
     4597   old_w = temp-font.font-W .
     4598   old-row = temp-font.v-row .
     4599   old-col = temp-font.v-col .
     4600   old-row-lans = temp-font.v-row-lans .
     4601   old-col-lans = temp-font.v-col-lans .
     4602       for each temp-font where
     4603                temp-font.fontnum  <> 7 :
     4604           assign
     4605               temp-font.v-row    = old_H * old-row / temp-font.font-h
     4606               temp-font.v-col    = old_W * old-col / temp-font.font-W
     4607               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     4608               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     4609           .
     4610       end.
     4611     end.
     4612   end procedure.
     4613   PROCEDURE How-name :
     4614   define input  parameter h as integer no-undo .
     4615   define input  parameter w as integer no-undo .
     4616   define output parameter n as character  no-undo .
     4617   define variable A4port-H as integer   no-undo init 63.
     4618   define variable A4port-W as integer   no-undo init 136.
     4619   define variable A4lans-H as integer   no-undo init 43.
     4620   define variable A4lans-W as integer   no-undo init 198.
     4621   define variable Strim-W  as integer   no-undo init 278.
     4622   run define-a4-size (
     4623        input ReportFontNum
     4624       ,output A4port-H
     4625       ,output A4port-W
     4626       ,output A4lans-H
     4627       ,output A4lans-W ).
     4628   If w >= 1 and w <= A4port-W Then DO:
     4629     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     4630     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     4631     If h > A4port-H              Then n = "to-file":U.
     4632   End.
     4633   If w > A4port-W and w <= A4lans-W Then DO:
     4634     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     4635     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     4636     If h > A4port-H              Then n = "to-file":U.
     4637   End.
     4638   If w > A4lans-W and w <= Strim-W Then DO:
     4639     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     4640     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     4641     If h > A4port-H              Then n = "to-file":U.
     4642   End.
     4643   If w > Strim-W Then DO:
     4644      n = "to-file":U.
     4645   End.
     4646   END PROCEDURE.
     4647   PROCEDURE define-a4-size :
     4648   define input  parameter p-ReportFontNum as integer   no-undo .
     4649   define output parameter A4port-H as integer   no-undo .
     4650   define output parameter A4port-W as integer   no-undo .
     4651   define output parameter A4lans-H as integer   no-undo .
     4652   define output parameter A4lans-W as integer   no-undo .
     4653   if not can-find (first temp-font ) then do:
     4654      run get-font-ini .
     4655   end.
     4656   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     4657   if available temp-font then do:
     4658   assign
     4659     A4port-H = temp-font.v-row
     4660     A4port-W = temp-font.v-col
     4661     A4lans-H = temp-font.v-row-lans
     4662     A4lans-W = temp-font.v-col-lans
     4663   .
     4664   end.
     4665   else do:
     4666   assign
     4667     A4port-H = 63
     4668     A4port-W = 136
     4669     A4lans-H = 43
     4670     A4lans-W = 198
     4671   .
     4672   end.
     4673   END PROCEDURE.
