     4998       v-str     = substitute("&1, &2", v-fmtcli-addres , v-fmtcli-phone)
     4999       v-host-egrip = v-host-egrip-date + ", " + v-host-egrip-num
     5000     .
     5001     find first buf_clients no-lock
     5002       where buf_clients.obj-type = 'орг':U
     5003         and buf_clients.obj-code = v-host-code
     5004     no-error .
     5005     if not available buf_clients then do:
     5006       message
