      578   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      579     if num-entries(string(p-dec), '.') = 2
      580       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      581       else return( string(p-dec)) .
      582   end function.
      583   function format-point-to-comma returns char (input orig as char ) .
      584   define variable rtext as character no-undo .
      585   define variable strt as integer no-undo .
      586   define variable leng as integer no-undo .
      587   assign rtext = orig .
      588   repeat:
      589     strt =  index(rtext,'.').
      590     if strt = 0 then leave.
      591     leng = 1.
      592     substring(rtext,strt,leng,"character") = v-delim .
      593   end.
      594   return rtext.
      595   end function.
      596   function format-excel-text returns char ( input start-text as char ) :
      597   def var  i    as int no-undo.
      598   def var  ch   as char no-undo.
      599   def var  n    as int no-undo.
      600   def var  ipos as int no-undo.
      601     n = num-entries(trim(start-text), chr(10)) - 1 .
      602     do i = 1 to n :
      603       ipos = index( start-text, chr(10)).
      604       if ipos > 0 then
      605         substr( start-text, ipos, 1 ) = ' '.
      606     end.
      607     n = num-entries(trim(start-text), chr(13)) - 1 .
      608     do i = 1 to n :
      609       ipos = index( start-text, chr(13)).
      610       if ipos > 0 then
      611         substr( start-text, ipos, 1 ) = ' '.
      612     end.
      613     if index( start-text, '"' ) = 0 then
      614       start-text =  '="'   + trim( start-text) + '"'   .
      615       else do:
      616         n = num-entries(trim(start-text), '"') - 1.
      617         do i = 1 to n :
      618           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      619         end.
      620         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      621         start-text = '="'  + ch  + '"' .
      622       end.
      623     return start-text.
      624   end.
      625   function excel-sum returns char (input p-dec as decimal ).
      626     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      627   end function.
      628   function excel-qnty returns char (input p-dec as decimal ).
      629     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      630   end function.
      631   function format-excel-text-macr returns char ( input start-text as char ) :
      632   def var  i    as int no-undo.
      633   def var  ch   as char no-undo.
      634   def var  n    as int no-undo.
      635   def var  ipos as int no-undo.
      636     n = num-entries(trim(start-text), chr(10)) - 1 .
      637     do i = 1 to n :
      638       ipos = index( start-text, chr(10)).
      639       if ipos > 0 then
      640         substring( start-text, ipos , 1 ) = ' '.
      641     end.
      642     n = num-entries(trim(start-text), chr(13)) - 1 .
      643     do i = 1 to n :
      644       ipos = index( start-text, chr(13)).
      645       if ipos > 0 then
      646         substring( start-text, ipos, 1 ) = ' '.
      647     end.
      648     if index( start-text, '"' ) = 0 then
      649       start-text =  '"'   + trim( start-text) + '"'   .
      650       else do:
      651         n = num-entries(trim(start-text), '"') - 1.
      652         do i = 1 to n :
      653           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      654         end.
      655         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      656         start-text = '"'  + ch  + '"' .
      657       end.
      658     n = num-entries(trim(start-text), chr(10)) - 1 .
      659     do i = 1 to n :
      660       ipos = index( start-text, chr(10)).
      661       if ipos > 0 then
      662         substring( start-text, ipos , 1 ) = ' '.
      663     end.
      664       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      665     return start-text.
      666   end.
      667   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      668   define variable v-waitfram-action01         as character   no-undo .
      669   define variable v-waitfram-action02         as character   no-undo .
      670   define variable v-waitfram-action03         as character   no-undo .
      671   define variable mWaitFramTextBeg            as character   no-undo.
      672   define variable mWaitFramTextEnd            as character   no-undo.
      673   define variable mWaitFramView               as logical     no-undo.
      674   define variable mWaitProcEvent              as logical     no-undo init yes.
      675   define variable mWaitFramInterval           as integer     no-undo init 1 .
      676   define variable mWaitFramStop               as logical     no-undo.
      677   define variable mWaitFramStopUser           as logical     no-undo.
      678   define variable mWaitFramStopTimeOut        as logical     no-undo.
      679   define variable mWaitFramStartProc          as datetime-tz no-undo.
      680   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
      681   define button B-WaitFramStop auto-end-key
      682        label "Стоп"
      683        size 10 by 1 tooltip "Остоновить процесс".
      684   define button B-viewProcInfo
      685        label "Информация"
      686        size 15 by 1 tooltip "Информация о процесс".
      687   define frame waitfram
      688     v-waitfram-action01 format "x(72)" no-label skip
      689     v-waitfram-action02 format "x(72)" no-label skip
      690     v-waitfram-action03 format "x(72)" no-label skip
      691     B-viewProcInfo
      692     B-WaitFramStop at row 4 col 30
      693     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
      694     .
      695   define new global shared variable mBatchMode as logical no-undo init ?.
      696   define variable mFramBachModHandle as handle no-undo.
      697   mFramBachModHandle = frame waitfram:handle.
      698   define variable mFameOldVis as logical no-undo.
      699   define variable mVisCUrentVin as logical no-undo.
      700   if session:batch-mode
      701   then
      702      mBatchMode = yes.
      703   if mBatchMode = ? then do:
      704     mVisCUrentVin = current-window:visible.
      705     mFameOldVis = mFramBachModHandle:visible.
      706     mFramBachModHandle:visible  = yes.
      707     mBatchMode = mFramBachModHandle:visible ne yes.
      708     mFramBachModHandle:visible = mFameOldVis.
      709     current-window:visible = mVisCUrentVin.
      710   end.
      711    if  log-manager:logfile-name ne ?
      712     then DO:
      713         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      714         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      715         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      716     end.
      717   on choose of B-WaitFramStop in frame waitfram
      718   do:
      719     mWaitFramStop = yes.
      720     mWaitFramStopUser = yes.
      721   end.
      722   function waitfram-check-timeout returns logical():
      723      define variable vtime as int64 no-undo.
      724      if mWaitFramStopTimeOut
      725      then
      726         return yes.
      727      vtime = ( now - mWaitFramStartProc ) / 1000 .
      728      if     mWaitFramTimeOut ne ?
      729         and mWaitFramTimeOut ne 0
      730         and mWaitFramTimeOut lt vtime
      731      then do:
      732         mWaitFramStopTimeOut = yes.
      733      end.
      734      return mWaitFramStopTimeOut.
      735   end.
      736   procedure waitfram-hide :
      737     if not session:batch-mode
      738     then do
      739     on error undo, return error return-value
      740     :
      741       pause 0 before-hide .
      742       if not mBatchMode then
      743         hide frame waitfram .
      744     if     not mWaitFramView
      745        and mWaitProcEvent
      746     then
      747       process events .
      748     end.
      749   end procedure.
      750   procedure waitfram-show :
      751     define input  parameter p-message as character no-undo .
      752     define variable v-left-margin as integer   no-undo .
      753     if not session:batch-mode
      754     then do
      755     on error undo, return error return-value
      756     :
      757       if length(p-message) <= 70 then do:
      758         assign
      759           v-left-margin = integer((70 - length(p-message)) / 2)
      760         .
      761         assign
      762           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      763         .
      764         assign
      765           v-waitfram-action01 = " "
      766           v-waitfram-action02 = " "
      767                                    + fill(" ", v-left-margin)
      768                                    + p-message
      769           v-waitfram-action03 = " "
      770         .
      771       end.
      772       else do:
      773         define variable vRindex1 as integer no-undo.
      774         define variable vRindex2 as integer no-undo.
      775         vRindex1 = r-index(p-message," ",70).
      776         if vRindex1 = 0
      777         then
      778            vRindex1 = 70.
      779         if length(p-message)  <= vRindex1 + 70 then do:
      780           assign
      781             v-waitfram-action01 = " "
      782             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      783             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      784           .
      785         end.
      786         else do:
      787           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      788           if vRindex2 <= vRindex1
      789           then
      790              vRindex2 = vRindex1 + 70.
      791           assign
      792             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      793             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      794             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      795           .
      796         end.
      797       end.
      798       B-viewProcInfo:visible   in frame waitfram = no.
      799       B-viewProcInfo:sensitive in frame waitfram = no.
      800       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      801       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      802       if  (   mWaitFramView
      803          or  mWaitProcEvent)
      804          and not mBatchMode
      805       then
      806          display
      807             v-waitfram-action01 skip
      808             v-waitfram-action02 skip
      809             v-waitfram-action03 skip
      810          with frame waitfram .
      811       if     mWaitFramView
      812          then do:
      813             if     mWaitFramInterval ne ?
      814                and not mBatchMode
      815             then
      816                wait-for go of frame waitfram pause mWaitFramInterval.
      817          end.
      818          else
      819             if     mWaitProcEvent
      820                and not mBatchMode
      821             then
      822                process events .
      823     end.
      824   end procedure.
      825      procedure waitfram-show-this:
      826         define input  parameter iInterval as int64 no-undo.
      827         define variable vtime as int64 no-undo.
      828         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      829         mWaitFramInterval = iInterval.
      830         run waitfram-show (substitute("&1&2 &3&4" ,
      831                                       mWaitFramTextBeg ,
      832                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      833                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      834                                       mWaitFramTextEnd
      835                                      )
      836                           ).
      837      end.
      838      procedure WaitFramRunPause:
      839         define input  parameter iInterval as dec no-undo.
      840         define variable vStart  as datetime-tz no-undo.
      841         define variable vend    as datetime-tz no-undo.
      842         define variable vint as int64 no-undo.
      843         define variable vOk as logical no-undo.
      844         vStart = now.
      845         vend   = vStart.
      846         publish "WaitFramPause" (iInterval,output vOk).
      847         vend   =  now.
      848         vint = vend - vStart.
      849         vint = iInterval - vint / 1000.
      850         if     not mWaitFramStop
      851            and (   vint > 0
      852                 or (    not vOk
      853                     and iInterval eq ?
      854                     )
      855                 )
      856         then
      857            run waitfram-show-this (iInterval).
      858         vend   =  now.
      859         vint = vend - vStart.
      860         vint = iInterval - vint / 1000.
      861         if     not mWaitFramStop
      862            and vint > 0
      863         then do:
      864            run gbl/pause.p (vint * 1000).
      865         end.
      866         if iInterval ne ?
      867         then
      868            publish "WaitFramStop".
      869         waitfram-check-timeout().
      870      end.
      871      procedure WaitFramWaitFor:
      872         define input  parameter iInterval as dec no-undo.
      873         assign
      874            mWaitFramStartProc   = now
      875            mWaitFramStopUser    = no
      876            mWaitFramStopTimeOut = no
      877         .
      878         block-wait:
      879         do while not mWaitFramStop:
      880            run WaitFramRunPause (iInterval).
      881            if  waitfram-check-timeout()
      882            then do:
      883               leave block-wait.
      884            end.
      885         end.
      886         run waitfram-hide.
      887      end.
      888   procedure waitfram-join :
      889     define input  parameter p-line-1  as character no-undo .
      890     define input  parameter p-line-2  as character no-undo .
      891     define input  parameter p-line-3  as character no-undo .
      892     define output parameter p-message as character no-undo .
      893     do
      894     on error undo, return error return-value
      895     :
      896       assign
      897         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      898                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      899                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      900       .
      901     end.
      902   end procedure.
      903   function waitfram-join-function returns character
      904     (input p-line-1 as character
      905     ,input p-line-2 as character
      906     ,input p-line-3 as character
      907     ).
      908     define variable v-message as character no-undo .
      909     run waitfram-join in this-procedure
      910       (input  p-line-1
      911       ,input  p-line-2
      912       ,input  p-line-3
      913       ,output v-message
      914       ) .
      915     return v-message .
      916   end function .
      917   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      918   define  stream PrnLibStream.
      919   procedure prn-lib-prn-file :
      920     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      921     define input parameter p-DIsabledoptions as integer no-undo .
      922     define variable v-report-name as character no-undo .
      923     define variable v-user-action as character no-undo .
      924     define variable v-printed     as logical   no-undo .
      925     define variable v-exist       as logical   no-undo .
      926     do
      927       on error undo, return error
      928       :
      929       run prn-lib-get-report-name  in this-procedure (
      930         input parParentProc
      931         ,output v-report-name
      932         ).
      933   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      934   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      935     (input  v-report-name
      936     ,input  2
      937     ,output v-exist
      938     )  .
      939       if NOT v-exist then
      940       DO:
      941         Message
      942           "Нет заданий на печать ! "
      943           view-as alert-box .
      944         Return  .
      945       End.
      946       run gbl/prnfilen.w
      947         (input  ""
      948         ,input  p-DisabledOptions
      949         ,input  string(v-report-name )
      950         ,input  7
      951         ,output v-user-action
      952         ,output v-printed
      953         ) .
      954       if v-printed then
      955       do:
      956         return "YES" .
      957       end.
      958       else
      959       do:
      960         return "NO" .
      961       end.
      962     end.
      963   end procedure.
      964   procedure prn-lib-open-stream :
      965     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      966     define input parameter p-page-size    as integer no-undo .
      967     define input parameter p-is-stream    as logical no-undo .
      968     define input parameter p-append       as logical no-undo .
      969     define variable v-report-name as character no-undo .
      970     do
      971       on error undo, return error
      972       :
      973       run prn-lib-get-report-name  in this-procedure (
      974         input parParentProc
      975         ,output v-report-name
      976         ).
      977       if p-is-stream then
      978       do:
      979         if p-append then
      980         do:
      981           output stream PrnLibStream to value( v-report-name )
      982             page-size value(p-page-size) append .
      983         end.
      984         if not p-append then
      985         do:
      986           output stream PrnLibStream to value( v-report-name )
      987             page-size value(p-page-size) .
      988         end.
      989       end.
      990       if not p-is-stream then
      991       do:
      992         if p-append then
      993         do:
      994           output to value( v-report-name )
      995             page-size value(p-page-size) append .
      996         end.
      997         if not p-append then
      998         do:
      999           output to value( v-report-name )
     1000             page-size value(p-page-size) .
     1001         end.
     1002       end.
     1003     end.
     1004   end procedure.
     1005   procedure prn-lib-open-exp :
     1006     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1007     define input parameter p-is-stream    as logical no-undo .
     1008     define input parameter p-is-append    as logical no-undo .
     1009     define output parameter p-ReportFileName as char init "report" no-undo.
     1010     define output parameter p-process as logical no-undo .
     1011     define variable glog as logical no-undo .
     1012     do
     1013       on error undo, return error
     1014       :
     1015       SYSTEM-DIALOG GET-FILE p-ReportFileName
     1016         TITLE      "Укажите путь"
     1017         FILTERS "Текстовый файл (*.txt)"   "*.txt"
     1018         ASK-OVERWRITE
     1019         CREATE-TEST-FILE
     1020         SAVE-AS
     1021         USE-FILENAME
     1022         DEFAULT-EXTENSION "txt"
     1023         UPDATE glog
     1024         .
     1025       if not glog then  return.
     1026       p-ReportFileName = trim( string( p-ReportFileName ) ) .
     1027       if p-is-stream then
     1028       do:
     1029         if p-is-append then
     1030         do:
     1031           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1032         end.
     1033         else
     1034         do:
     1035           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1036         end.
     1037       end.
     1038       else
     1039       do:
     1040         if p-is-append then
     1041         do:
     1042           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
     1043         end.
     1044         else
     1045         do:
     1046           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
     1047         end.
     1048       end.
     1049       p-process = yes.
     1050     end.
     1051   end procedure.
     1052   procedure prn-lib-get-report-name :
     1053     define input parameter parParentProc  as widget-handle no-undo.
     1054     define output parameter p-report-name as character no-undo .
     1055     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
     1056   end procedure.
     1057   procedure prn-lib-reportviewer-report-name :
     1058     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1059     define input parameter p-report-name-html as character no-undo .
     1060     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
     1061   end procedure.
     1062   procedure prn-lib-reportviewer :
     1063     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
     1064     define input parameter p-report-name-html as character no-undo .
     1065     define input parameter p-param        as character no-undo .
     1066     define variable v-excel           as character no-undo init 'TRUE' .
     1067     define variable v-value-character as character no-undo .
     1068     define variable v-value-integer   as character no-undo .
     1069     define variable v-value-date      as date      no-undo .
     1070     define variable v-value-decimal   as decimal   no-undo .
     1071     define variable rep-excel         as logical   no-undo .
     1072     define variable excel-string      as character no-undo .
     1073     define variable v-param-type      as character no-undo .
     1074     define variable v-tth             as handle    no-undo .
     1075     run adm/shattri.p (
     1076       input "get":U
     1077       ,input  ""
     1078       ,input  0
     1079       ,input  'report-glob':U
     1080       ,input  'rep-excel':U
     1081       ,output v-value-character
     1082       ,output v-value-date
     1083       ,output v-value-decimal
     1084       ,output v-value-integer
     1085       ,output rep-excel
     1086       ,output v-param-type
     1087       ,INPUT-OUTPUT table-handle v-tth
     1088       )  .
     1089     if rep-excel then v-excel = "TRUE" .
     1090     else v-excel = "FALSE" .
     1091     if p-param eq ""
     1092     then
     1093        p-param = "EXCEL:" + v-excel.
     1094     else
     1095        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
     1096     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
     1097   end procedure.
     1098   define variable sym1  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1099   define variable sym2  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1100   define variable sym3  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1101   define variable sym4  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1102   define variable sym5  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1103   define variable sym6  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1104   define variable sym7  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1105   define variable sym8  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1106   define variable sym9  as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1107   define variable sym10 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1108   define variable sym11 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1109   define variable sym12 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1110   define variable sym13 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1111   define variable sym14 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1112   define variable sym15 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1113   define variable sym16 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1114   define variable sym17 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1115   define variable sym18 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1116   define variable sym19 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1117   define variable sym20 as character no-undo format "x(1)":U initial ":":U column-label ":!:".
     1118   define variable sym21 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1119   define variable sym22 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1120   define variable sym23 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1121   define variable sym24 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1122   define variable sym25 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1123   define variable sym26 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1124   define variable sym27 as character no-undo format "x(1)":u initial ":":u column-label ":!:".
     1125   define variable temp1 as integer   no-undo.
     1126   define variable vss-include-info11 as character format "X(65)" no-undo
     1127   initial "@(#)$Workfile$ $Revision$".
     1128   define variable v-fmtcli-name          as character    no-undo.
     1129   define variable v-fmtcli-engl-name     as character    no-undo.
     1130   define variable v-fmtcli-addres        as character    no-undo.
     1131   define variable v-fmtcli-post-addres   as character    no-undo.
     1132   define variable v-fmtcli-full-addres   as character    no-undo.
     1133   define variable v-fmtcli-phone         as character    no-undo.
     1134   define variable v-fmtcli-inn           as character    no-undo.
     1135   define variable v-fmtcli-kpp           as character    no-undo.
     1136   define variable v-fmtcli-okpo          as character    no-undo.
     1137   define variable v-fmtcli-country       as character    no-undo.
     1138   define variable v-fmtcli-city          as character    no-undo.
     1139   define variable v-fmtcli-index         as character    no-undo.
     1140   define variable v-fmtcli-schet-exists  as logical      no-undo.
     1141   define variable v-fmtcli-bank-exists   as logical      no-undo.
     1142   define variable v-fmtcli-bank-r-schet  as character    no-undo.
     1143   define variable v-fmtcli-bank-c-schet  as character    no-undo.
     1144   define variable v-fmtcli-bank-bik      as character    no-undo.
     1145   define variable v-fmtcli-bank-name     as character    no-undo.
     1146   define variable v-fmtcli-bank-addres   as character    no-undo.
     1147   define variable v-fmtcli-bank-city     as character    no-undo.
     1148   procedure fmtcli-get-bank :
     1149   define input parameter p-host-code      as integer          no-undo.
     1150   define input parameter p-obj-type       as character        no-undo.
     1151   define input parameter p-obj-code       as integer          no-undo.
     1152   define input parameter p-curr-code      as integer          no-undo.
     1153       define buffer buf_fin-schet     for ub.fin-schet.
     1154       define buffer buf_fin-bank      for ub.fin-bank.
     1155   do
     1156   for buf_fin-schet
     1157     , buf_fin-bank
     1158   on error undo, return error
     1159   :
     1160       assign
     1161           v-fmtcli-schet-exists       = no
     1162           v-fmtcli-bank-exists        = no
     1163           v-fmtcli-bank-r-schet       = "":U
     1164           v-fmtcli-bank-c-schet       = "":U
     1165           v-fmtcli-bank-bik           = "":U
     1166           v-fmtcli-bank-name          = "":U
     1167           v-fmtcli-bank-addres        = "":U
     1168           v-fmtcli-bank-city          = "":U
     1169       .
     1170       search-for-schet:
     1171       for each buf_fin-schet no-lock
     1172          where buf_fin-schet.host-code = p-host-code
     1173            and buf_fin-schet.cli-type  = p-obj-type
     1174            and buf_fin-schet.cli-code  = p-obj-code
     1175            and buf_fin-schet.curr-code = p-curr-code
     1176       on error undo, return error
     1177       :
     1178           if buf_fin-schet.status_   = 'удал':U
     1179           then do:
     1180           end.
     1181           else do:
     1182               assign
     1183                   v-fmtcli-schet-exists   = yes
     1184                   v-fmtcli-bank-r-schet   = trim( buf_fin-schet.r-schet )
     1185                   v-fmtcli-bank-c-schet   = trim( buf_fin-schet.c-schet )
     1186               .
     1187               find first buf_fin-bank no-lock
     1188                    where buf_fin-bank.host-code = p-host-code
     1189                      and buf_fin-bank.code-bank = buf_fin-schet.code-bank
     1190               no-error.
     1191               if available buf_fin-bank
     1192               then do:
     1193                   assign
     1194                       v-fmtcli-bank-exists      = yes
     1195                       v-fmtcli-bank-bik         = trim( buf_fin-bank.bik )
     1196                       v-fmtcli-bank-name        = trim( buf_fin-bank.bank-name )
     1197                       v-fmtcli-bank-addres      = trim(buf_fin-bank.addres)
     1198                       v-fmtcli-bank-city      = trim(buf_fin-bank.bank-city)
     1199                   .
     1200               end.
     1201               else do:
     1202                   assign
     1203                       v-fmtcli-bank-exists    = no
     1204                       v-fmtcli-bank-bik       = "":U
     1205                       v-fmtcli-bank-name      = "":U
     1206                       v-fmtcli-bank-addres    = "":U
     1207                       v-fmtcli-bank-city      = "":U
     1208                   .
     1209               end.
     1210               leave search-for-schet.
     1211           end.
     1212       end.
     1213   end.
     1214   end procedure.
     1215   procedure fmtcli-get-client :
     1216   define input parameter p-obj-type       as character    no-undo.
     1217   define input parameter p-obj-code       as integer      no-undo.
     1218       define variable v-temp-fmtcli-address      as character     no-undo.
     1219       define variable v-num-country-city    as integer      no-undo.
     1220       define buffer buf_clients   for ub.clients.
     1221       define buffer buf_firm      for ub.firm.
     1222       define buffer buf_store     for ub.store.
     1223       define buffer buf_shop      for ub.shop.
     1224       define buffer buf_person    for ub.person.
     1225   do
     1226   for buf_clients
     1227     , buf_firm
     1228     , buf_store
     1229     , buf_shop
     1230     , buf_person
     1231   on error undo, return error
     1232   :
     1233       assign
     1234           v-fmtcli-name           = "":U
     1235           v-fmtcli-addres         = "":U
     1236           v-fmtcli-post-addres    = "":U
     1237           v-fmtcli-full-addres    = "":U
     1238           v-fmtcli-phone          = "":U
     1239           v-fmtcli-inn            = "":U
     1240           v-fmtcli-kpp            = "":U
     1241           v-fmtcli-okpo           = "":U
     1242           v-fmtcli-city           = "":U
     1243           v-fmtcli-index          = "":U
     1244           v-fmtcli-country        = "":U
     1245       .
     1246       find first buf_clients no-lock
     1247            where buf_clients.obj-type = p-obj-type
     1248              and buf_clients.obj-code = p-obj-code
     1249       .
     1250       assign
     1251           v-fmtcli-name = buf_clients.obj-name
     1252       .
     1253       case buf_clients.obj-type:
     1254          when 'орг':U
     1255          then do:
     1256               find first buf_firm no-lock
     1257                    where buf_firm.firm-code = buf_clients.obj-code
     1258                    no-error
     1259               .
     1260               if available buf_firm
     1261               then do:
     1262                   assign
     1263                       v-num-country-city = num-entries( buf_firm.city )
     1264                       v-fmtcli-engl-name = buf_firm.engl-name
     1265                   .
     1266                   if v-num-country-city > 0
     1267                   then do:
     1268                       assign
     1269                           v-fmtcli-country    = trim( entry( 1, buf_firm.city ) )
     1270                       .
     1271                   end.
     1272                   if v-num-country-city > 1
     1273                   then do:
     1274                       assign
     1275                           v-fmtcli-city       = trim( entry( 2, buf_firm.city ) )
     1276                       .
     1277                   end.
     1278                   run fmtcli-concatenate-strings in this-procedure (
     1279                         input v-fmtcli-full-addres
     1280                       , input v-fmtcli-country
     1281                       , input ", ":U
     1282                       , input 50
     1283                       , output v-fmtcli-full-addres
     1284                   ).
     1285                   run fmtcli-concatenate-strings in this-procedure (
     1286                         input v-fmtcli-full-addres
     1287                       , input v-fmtcli-city
     1288                       , input ", ":U
     1289                       , input 50
     1290                       , output v-fmtcli-full-addres
     1291                   ).
     1292                   run fmtcli-concatenate-strings in this-procedure (
     1293                         input v-fmtcli-full-addres
     1294                       , input IF buf_firm.ind = 0 THEN "" ELSE string( buf_firm.ind )
     1295                       , input ", ":U
     1296                       , input 50
     1297                       , output v-fmtcli-full-addres
     1298                   ).
     1299                   run fmtcli-concatenate-strings in this-procedure (
     1300                         input v-fmtcli-post-addres
     1301                       , input v-fmtcli-country
     1302                       , input ", ":U
     1303                       , input 50
     1304                       , output v-fmtcli-post-addres
     1305                   ).
     1306                   run fmtcli-concatenate-strings in this-procedure (
     1307                         input v-fmtcli-post-addres
     1308                       , input v-fmtcli-city
     1309                       , input ", ":U
     1310                       , input 50
     1311                       , output v-fmtcli-post-addres
     1312                   ).
     1313                   run fmtcli-concatenate-strings in this-procedure (
     1314                         input v-fmtcli-post-addres
     1315                       , input string( buf_firm.ind )
     1316                       , input ", ":U
     1317                       , input 50
     1318                       , output v-fmtcli-post-addres
     1319                   ).
     1320                   run fmtcli-concatenate-strings in this-procedure (
     1321                         input substring( buf_firm.addres1, 1, 50 )
     1322                       , input buf_firm.addres2
     1323                       , input " ":U
     1324                       , input 50
     1325                       , output v-temp-fmtcli-address
     1326                   ).
     1327                   run fmtcli-concatenate-strings in this-procedure (
     1328                         input v-temp-fmtcli-address
     1329                       , input substring( buf_firm.addres1, 51, 50 )
     1330                       , input " ":U
     1331                       , input 50
     1332                       , output v-temp-fmtcli-address
     1333                   ).
     1334                   run fmtcli-concatenate-strings in this-procedure (
     1335                         input v-temp-fmtcli-address
     1336                       , input substring( buf_firm.addres1, 101, 50 )
     1337                       , input " ":U
     1338                       , input 50
     1339                       , output v-temp-fmtcli-address
     1340                   ).
     1341                   assign
     1342                       v-fmtcli-addres = v-temp-fmtcli-address
     1343                   .
     1344                   if buf_firm.addres1 <> ?
     1345                   then do:
     1346                       run fmtcli-concatenate-strings in this-procedure (
     1347                             input v-fmtcli-full-addres
     1348                           , input v-fmtcli-addres
     1349                           , input ", ":U
     1350                           , input 0
     1351                           , output v-fmtcli-full-addres
     1352                       ).
     1353                   end.
     1354                   run fmtcli-concatenate-strings in this-procedure (
     1355                         input substring( buf_firm.post-addr1, 1, 50 )
     1356                       , input buf_firm.post-addr2
     1357                       , input " ":U
     1358                       , input 50
     1359                       , output v-fmtcli-post-addres
     1360                   ).
     1361                   run fmtcli-concatenate-strings in this-procedure (
     1362                         input v-fmtcli-post-addres
     1363                       , input substring( buf_firm.post-addr1, 51, 50 )
     1364                       , input " ":U
     1365                       , input 50
     1366                       , output v-fmtcli-post-addres
     1367                   ).
     1368                   run fmtcli-concatenate-strings in this-procedure (
     1369                         input v-fmtcli-post-addres
     1370                       , input substring( buf_firm.post-addr1, 101, 50 )
     1371                       , input " ":U
     1372                       , input 50
     1373                       , output v-fmtcli-post-addres
     1374                   ).
     1375                   assign
     1376                       v-fmtcli-phone         = buf_firm.phone
     1377                       v-fmtcli-inn           = buf_firm.inn
     1378                       v-fmtcli-kpp           = buf_firm.kpp
     1379                       v-fmtcli-okpo          = buf_firm.okpo
     1380                       v-fmtcli-index         = string( buf_firm.ind )
     1381                   .
     1382               end.
     1383          end.
     1384          when 'маг':U
     1385          then do:
     1386               find first buf_shop no-lock
     1387                    where buf_shop.obj-code = buf_clients.obj-code
     1388               .
     1389               if available buf_shop
     1390               then do:
     1391                   run fmtcli-concatenate-strings in this-procedure (
     1392                         input buf_shop.addres1
     1393                       , input buf_shop.addres2
     1394                       , input " ":U
     1395                       , input 50
     1396                       , output v-fmtcli-addres
     1397                   ).
     1398                   assign
     1399                       v-fmtcli-full-addres = v-fmtcli-addres
     1400                       v-fmtcli-post-addres = v-fmtcli-addres
     1401                       v-fmtcli-phone       = buf_shop.phone
     1402                       v-fmtcli-inn         = "":U
     1403                       v-fmtcli-kpp         = "":U
     1404                       v-fmtcli-okpo        = "":U
     1405                       v-fmtcli-city        = "":U
     1406                       v-fmtcli-index       = "":U
     1407                   .
     1408               end.
     1409          end.
     1410          when 'скл':U
     1411          then do:
     1412               find first buf_store no-lock
     1413                    where buf_store.obj-code = buf_clients.obj-code
     1414               .
     1415               if available buf_store
     1416               then do:
     1417                   run fmtcli-concatenate-strings in this-procedure (
     1418                         input buf_store.addres1
     1419                       , input buf_store.addres2
     1420                       , input " ":U
     1421                       , input 50
     1422                       , output v-fmtcli-addres
     1423                   ).
     1424                   assign
     1425                       v-fmtcli-full-addres = v-fmtcli-addres
     1426                       v-fmtcli-phone       = buf_store.phone
     1427                       v-fmtcli-inn         = "":U
     1428                       v-fmtcli-kpp         = "":U
     1429                       v-fmtcli-okpo        = "":U
     1430                       v-fmtcli-city        = "":U
     1431                       v-fmtcli-index       = "":U
     1432                   .
     1433               end.
     1434          end.
     1435          when 'чел':U
     1436          then do:
     1437               find first buf_person no-lock
     1438                    where buf_person.psn-code = buf_clients.obj-code
     1439               .
     1440               if available buf_person
     1441               then do:
     1442                   run fmtcli-concatenate-strings in this-procedure (
     1443                         input ( if buf_person.ind = 0 or buf_person.ind = ?
     1444                                 then "":U
     1445                                 else string( buf_person.ind, "999999")
     1446                                 )
     1447                       , input buf_person.city
     1448                       , input ", ":U
     1449                       , input 0
     1450                       , output v-fmtcli-full-addres
     1451                   ).
     1452                   assign
     1453                       v-fmtcli-addres = buf_person.address
     1454                   .
     1455                   run fmtcli-concatenate-strings in this-procedure (
     1456                         input v-fmtcli-full-addres
     1457                       , input v-fmtcli-addres
     1458                       , input ", ":U
     1459                       , input 0
     1460                       , output v-fmtcli-full-addres
     1461                   ).
     1462                   assign
     1463                       v-fmtcli-phone     = buf_person.phone1
     1464                       v-fmtcli-inn       = buf_person.inn
     1465                       v-fmtcli-kpp       = buf_person.kpp
     1466                       v-fmtcli-okpo      = buf_person.okpo
     1467                       v-fmtcli-city      = buf_person.city
     1468                       v-fmtcli-index     = string( buf_person.ind )
     1469                   .
     1470               end.
     1471          end.
     1472       end case.
     1473   end.
     1474   end procedure.
     1475   procedure fmtcli-concatenate-strings :
     1476   define input parameter p-string-1       as character        no-undo.
     1477   define input parameter p-string-2       as character        no-undo.
     1478   define input parameter p-delimiter      as character        no-undo.
     1479   define input parameter p-length         as integer          no-undo.
     1480   define output parameter p-out-string    as character        no-undo.
     1481   do
     1482   on error undo, return error
     1483   :
     1484       assign
     1485           p-out-string = ( if p-string-1 = ?
     1486                            then "":U
     1487                            else trim( p-string-1 ) )
     1488       .
     1489       assign
     1490           p-out-string = p-out-string
     1491                        + ( if p-out-string = "":U
     1492                            or length( p-out-string ) = p-length
     1493                            or p-string-2 = ?
     1494                            or trim( p-string-2 ) = "":U
     1495                            then "":U
     1496                            else p-delimiter )
     1497                        + ( if p-string-2 = ?
     1498                            or trim( p-string-2 ) = "":U
     1499                            then "":U
     1500                            else trim( p-string-2 ) )
     1501       .
     1502   end.
     1503   end procedure.
     1504   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1505   procedure factord :
     1506     define input  parameter p-fact-date            as date    no-undo .
     1507     define input  parameter p-fact-time            as integer no-undo .
     1508     define input  parameter p-fact-num             as integer no-undo .
     1509     define input  parameter p-shift-date           as date    no-undo .
     1510     define input  parameter p-shift-num            as integer no-undo .
     1511     define input  parameter p-shift-on             as logical no-undo .
     1512     define output parameter p-fact-order           as decimal no-undo .
     1513     define output parameter p-shift-end-fact-order as decimal no-undo .
     1514     define output parameter p-day-end-fact-order   as decimal no-undo .
     1515     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1516     if p-fact-date = ?
     1517     then do:
     1518       return error "Не указана фактическая дата" .
     1519     end.
     1520     define variable v-fact-date-num as integer no-undo .
     1521     assign
     1522       v-fact-date-num = integer(p-fact-date)
     1523     .
     1524     if p-fact-num = ?
     1525     or p-fact-num = 0
     1526     then do:
     1527       return error "Не задан p-fact-num " + string(p-fact-num) .
     1528     end.
     1529     if p-fact-num < 0
     1530     then do:
     1531       return error "Отрицательный fact-num " + string(p-fact-num) .
     1532     end.
     1533     if p-fact-num >= 100000000
     1534     then do:
     1535       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1536     end.
     1537     if p-shift-on = true
     1538     then do:
     1539       if p-shift-date = ?
     1540       then do:
     1541         return error "Не задана дата смены" .
     1542       end.
     1543       if p-shift-num = ?
     1544       or p-shift-num = 0
     1545       then do:
     1546         return error "Не задан номер смены" .
     1547       end.
     1548     end.
     1549     else do:
     1550       assign
     1551         p-shift-date = p-fact-date
     1552         p-shift-num  = 24
     1553       .
     1554     end.
     1555     define variable v-shift-offset as integer no-undo .
     1556     if p-shift-date = p-fact-date
     1557     then do:
     1558       assign
     1559         v-shift-offset = 1
     1560       .
     1561     end.
     1562     if p-shift-date < p-fact-date
     1563     then do:
     1564       assign
     1565         v-shift-offset = 0
     1566       .
     1567     end.
     1568     if p-shift-date > p-fact-date
     1569     then do:
     1570       message
     1571         vss-workfile vss-revision vss-description skip
     1572         "Неправильная дата закрытия смены" skip
     1573         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1574         view-as alert-box error .
     1575       undo, return error
     1576         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1577           ,string(p-fact-date, '99/99/9999':U)
     1578           ,string(p-shift-date, '99/99/9999':U)
     1579           )
     1580       .
     1581     end.
     1582     if p-shift-num < 1
     1583     or p-shift-num > 24
     1584     then do:
     1585       message
     1586         vss-workfile vss-revision vss-description skip
     1587         "Неправильный номер смены" skip
     1588         "p-shift-num" p-shift-num skip
     1589         view-as alert-box error .
     1590       undo, return error return-value .
     1591     end.
     1592     assign
     1593       p-fact-order           = v-fact-date-num
     1594                              + v-shift-offset * 0.5
     1595                              + p-shift-num    * 0.02 - 0.01
     1596                              + p-fact-num     * 0.0000000001
     1597       p-shift-end-fact-order = v-fact-date-num
     1598                              + v-shift-offset * 0.5
     1599                              + p-shift-num    * 0.02
     1600       p-day-end-fact-order   = v-fact-date-num
     1601                              + 0.99
     1602     .
     1603     if p-fact-order           <= v-fact-date-num
     1604     or p-shift-end-fact-order <= v-fact-date-num
     1605     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1606     or p-shift-end-fact-order >= p-day-end-fact-order
     1607     then do:
     1608       message
     1609         vss-workfile vss-revision vss-description skip
     1610         "Внутренняя ошибка при генерации фактического номера" skip
     1611         "p-fact-date"            p-fact-date            skip
     1612         "p-fact-time"            p-fact-time            skip
     1613         "p-fact-num"             p-fact-num             skip
     1614         "p-shift-date"           p-shift-date           skip
     1615         "p-shift-num"            p-shift-num            skip
     1616         "p-shift-on"             p-shift-on             skip
     1617         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1618         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1619         "v-fact-date-num"        v-fact-date-num        skip
     1620         view-as alert-box error .
     1621       undo, return error return-value .
     1622     end.
     1623   end procedure.
     1624   procedure day-begin-fact-order :
     1625     define input  parameter p-fact-date            as date    no-undo .
     1626     define output parameter p-day-begin-fact-order as decimal no-undo .
     1627     do
     1628     on error undo, return error return-value
     1629     :
     1630       if p-fact-date = ?
     1631       then do:
     1632         assign
     1633           p-day-begin-fact-order = 0
     1634         .
     1635       end.
     1636       else do:
     1637         assign
     1638           p-day-begin-fact-order = integer(p-fact-date)
     1639         .
     1640       end.
     1641     end.
     1642   end procedure.
     1643   procedure factord-max-fact-order :
     1644     define output parameter p-max-fact-order as decimal   no-undo .
     1645     do
     1646     on error undo, return error return-value
     1647     :
     1648       run day-begin-fact-order in this-procedure
     1649         (input  date(1, 1, 5000)
     1650         ,output p-max-fact-order
     1651         ) .
     1652     end.
     1653   end procedure.
     1654   procedure factord-cut-archive :
     1655     define input  parameter p-obj-type             as character no-undo .
     1656     define input  parameter p-obj-code             as integer   no-undo .
     1657     define input  parameter p-fact-date            as date      no-undo .
     1658     define output parameter p-shift-on             as logical   no-undo .
     1659     define output parameter p-shift-date           as date      no-undo .
     1660     define output parameter p-shift-num            as integer   no-undo .
     1661     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1662     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1663     define variable v-fact-order as decimal   no-undo .
     1664     define buffer buf_shift-obj for ub.shift-obj .
     1665     do
     1666     on error undo, return error return-value
     1667     :
     1668   define variable vss-include-info13 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1669   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1670     (input  p-obj-type
     1671     ,input  p-obj-code
     1672     ,input  'shift-on=request'
     1673     ,output p-shift-on
     1674     ) no-error .
     1675       if error-status :error
     1676       then do:
     1677         message
     1678           vss-workfile vss-revision vss-description skip
     1679           "Ошибка при определении атрибута объекта" skip
     1680           "Объект" p-obj-type p-obj-code skip
     1681           error-status :get-message(1) skip
     1682           return-value skip
     1683           view-as alert-box error .
     1684         undo, return error return-value .
     1685       end.
     1686       if p-shift-on = false
     1687       then do:
     1688         assign
     1689           p-shift-date               = ?
     1690           p-shift-num                = 0
     1691         .
     1692       end.
     1693       else do:
     1694         find first buf_shift-obj share-lock
     1695           where buf_shift-obj.obj-type   = p-obj-type
     1696             and buf_shift-obj.obj-code   = p-obj-code
     1697             and buf_shift-obj.shift-date > p-fact-date
     1698           use-index pi
     1699           no-error .
     1700         if not available buf_shift-obj
     1701         or buf_shift-obj.status_ <> 'зкр':U
     1702         then do:
     1703           message
     1704             vss-workfile vss-revision vss-description skip
     1705             "Невозможно вычислить последнюю смену" skip
     1706             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1707             "Объект" p-obj-type p-obj-code skip
     1708             "Дата" p-fact-date skip
     1709             view-as alert-box error .
     1710           undo, return error return-value .
     1711         end.
     1712         find last buf_shift-obj share-lock
     1713           where buf_shift-obj.obj-type = p-obj-type
     1714             and buf_shift-obj.obj-code = p-obj-code
     1715             and buf_shift-obj.shift-date <= p-fact-date
     1716           use-index pi
     1717           no-error .
     1718         if available buf_shift-obj
     1719         then do:
     1720           if  buf_shift-obj.status_ = 'зкр':U
     1721           then do:
     1722             assign
     1723               p-shift-date = buf_shift-obj.shift-date
     1724               p-shift-num  = buf_shift-obj.shift-num
     1725             .
     1726           end.
     1727           else do:
     1728             message
     1729               vss-workfile vss-revision vss-description skip
     1730               "Невозможно вычислить последнюю смену" skip
     1731               "Статус смены отличен от статуса" 'зкр':U skip
     1732               "Объект" p-obj-type p-obj-code skip
     1733               "Дата" p-fact-date skip
     1734               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1735               view-as alert-box error .
     1736             undo, return error return-value .
     1737           end.
     1738         end.
     1739         else do:
     1740           assign
     1741             p-shift-date = p-fact-date - 1
     1742             p-shift-num  = 1
     1743           .
     1744         end.
     1745       end.
     1746       run factord in this-procedure
     1747         (input  p-fact-date
     1748         ,input  1
     1749         ,input  1
     1750         ,input  p-shift-date
     1751         ,input  p-shift-num
     1752         ,input  p-shift-on
     1753         ,output v-fact-order
     1754         ,output p-shift-end-fact-order
     1755         ,output p-day-end-fact-order
     1756         ) no-error .
     1757       if error-status :error
     1758       then do:
     1759         message
     1760           vss-workfile vss-revision vss-description skip
     1761           "Ошибка при вызове процедуры factord"
     1762           error-status :get-message(1) skip
     1763           return-value skip
     1764           view-as alert-box error .
     1765         undo, return error return-value .
     1766       end.
     1767     end.
     1768   end procedure.
     1769   procedure factord-lock-shift :
     1770     define input  parameter p-obj-type  as character no-undo .
     1771     define input  parameter p-obj-code  as integer   no-undo .
     1772     define input  parameter p-fact-date as date      no-undo .
     1773     define parameter buffer buf_shift-obj for ub.shift-obj .
     1774     define variable v-shift-on      as logical   no-undo .
     1775     define variable v-extra-message as character no-undo .
     1776     define variable v-error as character no-undo .
     1777     do
     1778     on error undo, return error return-value
     1779     :
     1780   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1781   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1782     (input  p-obj-type
     1783     ,input  p-obj-code
     1784     ,input  'shift-on=request'
     1785     ,output v-shift-on
     1786     ) no-error .
     1787       if error-status :error
     1788       then do:
     1789         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1790         undo, return error v-error .
     1791       end.
     1792       if v-shift-on = true
     1793       then do:
     1794         find first buf_shift-obj share-lock
     1795           where buf_shift-obj.obj-type   = p-obj-type
     1796             and buf_shift-obj.obj-code   = p-obj-code
     1797             and buf_shift-obj.shift-date > p-fact-date
     1798           use-index pi
     1799           no-error .
     1800         if not available buf_shift-obj
     1801         or buf_shift-obj.status_ <> 'зкр':U
     1802         then do:
     1803           find last buf_shift-obj
     1804             where buf_shift-obj.obj-type = p-obj-type
     1805               and buf_shift-obj.obj-code = p-obj-code
     1806               and buf_shift-obj.status_  = 'зкр':U
     1807             use-index stts
     1808             no-error .
     1809           if available buf_shift-obj
     1810           then do:
     1811             assign
     1812               v-extra-message =
     1813                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1814                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1815                               )
     1816             .
     1817           end.
     1818           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1819           undo, return error v-error .
     1820         end.
     1821       end.
     1822     end.
     1823   end procedure.
     1824   procedure factord-end-day :
     1825     define input  parameter p-fact-date            as date    no-undo .
     1826     define output parameter p-day-end-fact-order   as decimal no-undo .
     1827     do
     1828     on error undo, return error return-value
     1829     :
     1830       if p-fact-date = ?
     1831       then do:
     1832         return error "Не указана фактическая дата" .
     1833       end.
     1834       assign
     1835         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1836       .
     1837     end.
     1838   end procedure.
     1839   procedure factord-to-date :
     1840     define input  parameter p-fact-order as decimal no-undo .
     1841     define output parameter p-fact-date  as date    no-undo .
     1842     define variable v-ref-date  as date      no-undo .
     1843     define variable v-ref-delta as integer   no-undo .
     1844     do
     1845     on error undo, return error return-value
     1846     :
     1847       if p-fact-order = ?
     1848       or p-fact-order = 0
     1849       then do:
     1850         return error "Не указан fact-order" .
     1851       end.
     1852       assign
     1853         v-ref-date  = date(1, 1, 2000)
     1854       .
     1855       assign
     1856         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1857       .
     1858       assign
     1859         p-fact-date = v-ref-date + v-ref-delta
     1860       .
     1861     end.
     1862   end procedure.
     1863   procedure factord-to-fact-num :
     1864     define input  parameter p-fact-order as decimal no-undo .
     1865     define output parameter p-fact-num   as integer no-undo .
     1866     define variable v-fact-order-trunc as decimal no-undo .
     1867     do
     1868     on error undo, return error return-value
     1869     :
     1870       if p-fact-order = ?
     1871       or p-fact-order = 0
     1872       then do:
     1873         return error "Не указан fact-order" .
     1874       end.
     1875       assign
     1876        v-fact-order-trunc = truncate(p-fact-order, 2)
     1877       .
     1878       assign
     1879         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1880       .
     1881     end.
     1882   end procedure.
     1883   procedure factord-to-shift-num :
     1884     define input  parameter p-fact-order as decimal no-undo .
     1885     define output parameter p-shift-num   as integer no-undo .
     1886     define variable  p-shift-numd  as decimal   no-undo .
     1887     define variable v-fact-order-trunc as decimal no-undo .
     1888     do
     1889     on error undo, return error return-value
     1890     :
     1891       if p-fact-order = ?
     1892       or p-fact-order = 0
     1893       then do:
     1894         return error "Не указан fact-order" .
     1895       end.
     1896       assign
     1897        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1898       .
     1899       if v-fact-order-trunc < 0.5 then do:
     1900         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1901       end.
     1902       assign
     1903         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1904         .
     1905        assign
     1906         p-shift-num = truncate (p-shift-numd , 0)
     1907       .
     1908     end.
     1909   end procedure.
