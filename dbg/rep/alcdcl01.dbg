     5057       CHR(9) "деклараций о":U  skip
     5058       CHR(9) "розничной продаже алкогольной":U skip
     5059       CHR(9) "продукции на":U  skip
     5060       CHR(9) "территории Приморского края,":U skip
     5061       CHR(9) "утвержденному":U skip
