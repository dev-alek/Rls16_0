     3810       bfacc_tt-allsum.transport-base-acc  = bf_tt-allsum.transport-base-acc
     3811       bfacc_tt-allsum.transport-rubl-acc  = bf_tt-allsum.transport-rubl-acc
     3812       bfacc_tt-allsum.transport-cli-acc   = bf_tt-allsum.transport-cli-acc
     3813       bfacc_tt-allsum.other-base-acc      = bf_tt-allsum.other-base-acc
     3814       bfacc_tt-allsum.other-rubl-acc      = bf_tt-allsum.other-rubl-acc
     3815       bfacc_tt-allsum.other-cli-acc       = bf_tt-allsum.other-cli-acc
     3816       .
     3817     assign
     3818       bfsacc_tt-allsum.fact-qnty           = bfs_tt-allsum.fact-qnty
     3819       bfsacc_tt-allsum.cli-qnty            = bfs_tt-allsum.cli-qnty
     3820       bfsacc_tt-allsum.sum-dsc-base-doc    = bfs_tt-allsum.sum-dsc-base-acc
     3821       bfsacc_tt-allsum.sum-dsc-rubl-doc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3822       bfsacc_tt-allsum.dsc-base-doc        = bfs_tt-allsum.dsc-base-acc
     3823       bfsacc_tt-allsum.dsc-rubl-doc        = bfs_tt-allsum.dsc-rubl-acc
     3824       bfsacc_tt-allsum.vat-base-doc        = 0
     3825       bfsacc_tt-allsum.vat-rubl-doc        = 0
     3826       bfsacc_tt-allsum.vat-base-buyer-doc  = bfs_tt-allsum.vat-base-acc
     3827       bfsacc_tt-allsum.vat-rubl-buyer-doc  = bfs_tt-allsum.vat-rubl-acc
     3828       bfsacc_tt-allsum.slt-base-doc        = bfs_tt-allsum.slt-base-acc
     3829       bfsacc_tt-allsum.slt-rubl-doc        = bfs_tt-allsum.slt-rubl-acc
     3830       bfsacc_tt-allsum.road-tax-base-doc   = bfs_tt-allsum.road-tax-base-acc
     3831       bfsacc_tt-allsum.road-tax-rubl-doc   = bfs_tt-allsum.road-tax-rubl-acc
     3832       bfsacc_tt-allsum.excise-base-doc     = bfs_tt-allsum.excise-base-acc
     3833       bfsacc_tt-allsum.excise-rubl-doc     = bfs_tt-allsum.excise-rubl-acc
     3834       bfsacc_tt-allsum.sum-dsc-base-cur    = bfs_tt-allsum.sum-dsc-base-acc
     3835       bfsacc_tt-allsum.sum-dsc-rubl-cur    = bfs_tt-allsum.sum-dsc-rubl-acc
     3836       bfsacc_tt-allsum.dsc-base-cur        = bfs_tt-allsum.dsc-base-acc
     3837       bfsacc_tt-allsum.dsc-rubl-cur        = bfs_tt-allsum.dsc-rubl-acc
     3838       bfsacc_tt-allsum.vat-base-cur        = 0
     3839       bfsacc_tt-allsum.vat-rubl-cur        = 0
     3840       bfsacc_tt-allsum.vat-base-buyer-cur  = bfs_tt-allsum.vat-base-acc
     3841       bfsacc_tt-allsum.vat-rubl-buyer-cur  = bfs_tt-allsum.vat-rubl-acc
     3842       bfsacc_tt-allsum.slt-base-cur        = bfs_tt-allsum.slt-base-acc
     3843       bfsacc_tt-allsum.slt-rubl-cur        = bfs_tt-allsum.slt-rubl-acc
     3844       bfsacc_tt-allsum.road-tax-base-cur   = bfs_tt-allsum.road-tax-base-acc
     3845       bfsacc_tt-allsum.road-tax-rubl-cur   = bfs_tt-allsum.road-tax-rubl-acc
     3846       bfsacc_tt-allsum.excise-base-cur     = bfs_tt-allsum.excise-base-acc
     3847       bfsacc_tt-allsum.excise-rubl-cur     = bfs_tt-allsum.excise-rubl-acc
     3848       bfsacc_tt-allsum.sum-dsc-base-acc    = bfs_tt-allsum.sum-dsc-base-acc
     3849       bfsacc_tt-allsum.sum-dsc-rubl-acc    = bfs_tt-allsum.sum-dsc-rubl-acc
     3850       bfsacc_tt-allsum.sum-dsc-cli-acc     = bfs_tt-allsum.sum-dsc-cli-acc
     3851       bfsacc_tt-allsum.dsc-base-acc        = bfs_tt-allsum.dsc-base-acc
     3852       bfsacc_tt-allsum.dsc-rubl-acc        = bfs_tt-allsum.dsc-rubl-acc
     3853       bfsacc_tt-allsum.dsc-cli-acc         = bfs_tt-allsum.dsc-cli-acc
     3854       bfsacc_tt-allsum.vat-base-acc        = bfs_tt-allsum.vat-base-acc
     3855       bfsacc_tt-allsum.vat-rubl-acc        = bfs_tt-allsum.vat-rubl-acc
     3856       bfsacc_tt-allsum.vat-cli-acc         = bfs_tt-allsum.vat-cli-acc
     3857       bfsacc_tt-allsum.slt-base-acc        = bfs_tt-allsum.slt-base-acc
     3858       bfsacc_tt-allsum.slt-rubl-acc        = bfs_tt-allsum.slt-rubl-acc
     3859       bfsacc_tt-allsum.slt-cli-acc         = bfs_tt-allsum.slt-cli-acc
     3860       bfsacc_tt-allsum.excise-base-acc     = bfs_tt-allsum.excise-base-acc
     3861       bfsacc_tt-allsum.excise-rubl-acc     = bfs_tt-allsum.excise-rubl-acc
     3862       bfsacc_tt-allsum.excise-cli-acc      = bfs_tt-allsum.excise-cli-acc
     3863       bfsacc_tt-allsum.road-tax-base-acc   = bfs_tt-allsum.road-tax-base-acc
     3864       bfsacc_tt-allsum.road-tax-rubl-acc   = bfs_tt-allsum.road-tax-rubl-acc
     3865       bfsacc_tt-allsum.road-tax-cli-acc    = bfs_tt-allsum.road-tax-cli-acc
     3866       bfsacc_tt-allsum.transport-base-acc  = bfs_tt-allsum.transport-base-acc
     3867       bfsacc_tt-allsum.transport-rubl-acc  = bfs_tt-allsum.transport-rubl-acc
     3868       bfsacc_tt-allsum.transport-cli-acc   = bfs_tt-allsum.transport-cli-acc
     3869       bfsacc_tt-allsum.other-base-acc      = bfs_tt-allsum.other-base-acc
     3870       bfsacc_tt-allsum.other-rubl-acc      = bfs_tt-allsum.other-rubl-acc
     3871       bfsacc_tt-allsum.other-cli-acc       = bfs_tt-allsum.other-cli-acc
     3872       .
     3873   end.
     3874   otherwise do:
     3875     return error substitute ("Неизвестный тип приобретения &1 по партии с кодом &2 по документу &3, порожденную документом &4 по товару &5 &6 &7.",
     3876                              cl_tt-clcparts.purch-code,
     3877                              cl_tt-clcparts.part-code,
     3878                              cl_tt-clcparts.out-code,
     3879                              cl_tt-clcparts.in-code,
     3880                              cl_tt-clcparts.artic,
     3881                              cl_tt-clcparts.prod-type,
     3882                              cl_tt-clcparts.prod-code).
     3883   end.
     3884   end case.
     3885   end.
     3886   end procedure.
     3887   procedure clcprtsl_calc-line :
     3888   define input  parameter parrec-line as recid no-undo.
     3889   define variable v-tax-date         as   date                     no-undo.
     3890   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     3891   define variable varr-b             as   character                no-undo.
     3892   define variable varr-btype         as   character                no-undo.
     3893   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     3894   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     3895   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     3896   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     3897   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     3898   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     3899   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     3900   define variable varb-code          like ub.bar-code.b-code       no-undo.
     3901   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     3902   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     3903   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     3904   define variable varexcise          like ub.price-list.excise     no-undo.
     3905   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     3906   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     3907   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     3908   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     3909   define variable v-varsum           as decimal                  no-undo.
     3910   define variable varprice-salef as decimal   no-undo .
     3911   define buffer bf_trn-doc             for ub.trn-doc.
     3912   define buffer bf_doc-line            for ub.doc-line.
     3913   define buffer bf_gds-dtl             for ub.gds-dtl.
     3914   define buffer bf_goods               for ub.goods.
     3915   define buffer bf_parts               for ub.parts.
     3916   define buffer bf_sysconf             for ub.sysconf.
     3917   define buffer bf_tt-allsum-line      for tt-allsum-line.
     3918   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     3919   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     3920   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     3921   define buffer buf_parts        for ub.parts.
     3922   v-calcbypart = no.
     3923   do on error undo, return error return-value :
     3924   define variable vss-include-info24 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     3925   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     3926     (output varr-b
     3927     )  .
     3928     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     3929     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     3930     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     3931                               bf_goods.prod-type = bf_doc-line.prod-type and
     3932                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     3933     if bf_trn-doc.fact-date <> ?        then do:
     3934       assign v-tax-date = bf_trn-doc.fact-date.
     3935     end.
     3936     else do:
     3937       assign v-tax-date = ?.
     3938     end.
     3939   define variable vss-include-info25 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3940   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run pftxvalg in g#library
     3941     (input  bf_goods.gds-code
     3942     ,input  '1':U
     3943     ,input  v-tax-date
     3944     ,input  bf_trn-doc.host-code
     3945     ,input  bf_trn-doc.obj-type
     3946     ,input  bf_trn-doc.obj-code
     3947     ,output v-vat-pc
     3948     ) no-error .
     3949     if error-status :error
     3950     or v-vat-pc = ? then do:
     3951        return error substitute ("Ошибка при поиске НДС для товара &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     3952     end.
     3953     if bf_goods.gds-type = 'у':U or
     3954        bf_trn-doc.status_ = 'запрос':U then do:
     3955       for each bf_tt-allsum-line
     3956       on error undo, return error return-value
     3957        :
     3958         delete bf_tt-allsum-line.
     3959       end.
     3960       create bf_tt-allsum-line.
     3961       assign
     3962        bf_tt-allsum-line.sum-type = 'основная_сумма':U.
     3963       for each bf_gds-dtl where bf_gds-dtl.doc-code  = bf_doc-line.doc-code  and
     3964                                 bf_gds-dtl.artic     = bf_doc-line.artic     and
     3965                                 bf_gds-dtl.prod-type = bf_doc-line.prod-type and
     3966                                 bf_gds-dtl.prod-code = bf_doc-line.prod-code no-lock on error undo, return error return-value :
     3967         assign
     3968           bf_tt-allsum-line.fact-qnty            =  bf_tt-allsum-line.fact-qnty        + bf_gds-dtl.fact-qnty
     3969           bf_tt-allsum-line.sum-dsc-base-doc     =  bf_tt-allsum-line.sum-dsc-base-doc + (bf_gds-dtl.price-base - bf_gds-dtl.discnt-base) * bf_gds-dtl.fact-qnty
     3970           bf_tt-allsum-line.sum-dsc-rubl-doc     =  bf_tt-allsum-line.sum-dsc-rubl-doc + (bf_gds-dtl.price-rubl - bf_gds-dtl.discnt-rubl) * bf_gds-dtl.fact-qnty
     3971           bf_tt-allsum-line.dsc-base-doc         =  bf_tt-allsum-line.dsc-base-doc     + bf_gds-dtl.discnt-base * bf_gds-dtl.fact-qnty
     3972           bf_tt-allsum-line.dsc-rubl-doc         =  bf_tt-allsum-line.dsc-rubl-doc     + bf_gds-dtl.discnt-rubl * bf_gds-dtl.fact-qnty
     3973           bf_tt-allsum-line.sum-dsc-base-cur     =  bf_tt-allsum-line.sum-dsc-base-cur + (if varr-b = "base" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base / bf_trn-doc.exch-rate * bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3974           bf_tt-allsum-line.sum-dsc-rubl-cur     =  bf_tt-allsum-line.sum-dsc-rubl-cur + (if varr-b = "rubl" then bf_gds-dtl.cur-base else bf_gds-dtl.cur-base * bf_trn-doc.exch-rate / bf_trn-doc.exch-scale) * bf_gds-dtl.fact-qnty
     3975           bf_tt-allsum-line.sum-dsc-base-acc     =  bf_tt-allsum-line.sum-dsc-base-acc + bf_doc-line.price-base * bf_gds-dtl.fact-qnty
     3976           bf_tt-allsum-line.sum-dsc-rubl-acc     =  bf_tt-allsum-line.sum-dsc-rubl-acc + bf_doc-line.price-rubl * bf_gds-dtl.fact-qnty
     3977           bf_tt-allsum-line.sum-dsc-cli-acc      =  ?
     3978           bf_tt-allsum-line.vat-base-acc         =  bf_tt-allsum-line.vat-base-acc     + bf_doc-line.price-base * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3979           bf_tt-allsum-line.vat-rubl-acc         =  bf_tt-allsum-line.vat-rubl-acc     + bf_doc-line.price-rubl * v-vat-pc / (100 + v-vat-pc) * bf_gds-dtl.fact-qnty
     3980           bf_tt-allsum-line.vat-cli-acc          =  ?
     3981           .
     3982       end.
     3983       assign
     3984         bf_tt-allsum-line.cli-qnty             =  ?
     3985         bf_tt-allsum-line.slt-base-doc         =  bf_tt-allsum-line.sum-dsc-base-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3986         bf_tt-allsum-line.slt-rubl-doc         =  bf_tt-allsum-line.sum-dsc-rubl-doc * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3987         bf_tt-allsum-line.vat-base-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-base-doc - bf_tt-allsum-line.slt-base-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3988         bf_tt-allsum-line.vat-rubl-buyer-doc   =  (bf_tt-allsum-line.sum-dsc-rubl-doc - bf_tt-allsum-line.slt-rubl-doc) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     3989         bf_tt-allsum-line.road-tax-base-doc    =  0
     3990         bf_tt-allsum-line.road-tax-rubl-doc    =  0
     3991         bf_tt-allsum-line.excise-base-doc      =  0
     3992         bf_tt-allsum-line.excise-rubl-doc      =  0
     3993         bf_tt-allsum-line.vat-base-doc         =  bf_tt-allsum-line.vat-base-buyer-doc
     3994         bf_tt-allsum-line.vat-rubl-doc         =  bf_tt-allsum-line.vat-rubl-buyer-doc
     3995         bf_tt-allsum-line.dsc-base-cur         =  0
     3996         bf_tt-allsum-line.dsc-rubl-cur         =  0
     3997         bf_tt-allsum-line.slt-base-cur         =  bf_tt-allsum-line.sum-dsc-base-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3998         bf_tt-allsum-line.slt-rubl-cur         =  bf_tt-allsum-line.sum-dsc-rubl-cur * bf_doc-line.slt-pc / (100 + bf_doc-line.slt-pc)
     3999         bf_tt-allsum-line.vat-base-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-base-cur - bf_tt-allsum-line.slt-base-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4000         bf_tt-allsum-line.vat-rubl-buyer-cur   =  (bf_tt-allsum-line.sum-dsc-rubl-cur - bf_tt-allsum-line.slt-rubl-cur) * bf_doc-line.vat-pc / (100 + bf_doc-line.vat-pc)
     4001         bf_tt-allsum-line.road-tax-base-cur    =  0
     4002         bf_tt-allsum-line.road-tax-rubl-cur    =  0
     4003         bf_tt-allsum-line.excise-base-cur      =  0
     4004         bf_tt-allsum-line.excise-rubl-cur      =  0
     4005         bf_tt-allsum-line.vat-base-cur         =  bf_tt-allsum-line.vat-base-buyer-cur
     4006         bf_tt-allsum-line.vat-rubl-cur         =  bf_tt-allsum-line.vat-rubl-buyer-cur
     4007         bf_tt-allsum-line.dsc-base-acc         =  0
     4008         bf_tt-allsum-line.dsc-rubl-acc         =  0
     4009         bf_tt-allsum-line.dsc-cli-acc          =  0
     4010         bf_tt-allsum-line.slt-base-acc         =  0
     4011         bf_tt-allsum-line.slt-rubl-acc         =  0
     4012         bf_tt-allsum-line.slt-cli-acc          =  0
     4013         bf_tt-allsum-line.road-tax-base-acc    =  0
     4014         bf_tt-allsum-line.road-tax-rubl-acc    =  0
     4015         bf_tt-allsum-line.road-tax-cli-acc     =  0
     4016         bf_tt-allsum-line.excise-base-acc      =  0
     4017         bf_tt-allsum-line.excise-rubl-acc      =  0
     4018         bf_tt-allsum-line.excise-cli-acc       =  0
     4019         bf_tt-allsum-line.transport-base-acc   =  0
     4020         bf_tt-allsum-line.transport-rubl-acc   =  0
     4021         bf_tt-allsum-line.transport-cli-acc    =  0
     4022         bf_tt-allsum-line.other-base-acc       =  0
     4023         bf_tt-allsum-line.other-rubl-acc       =  0
     4024         bf_tt-allsum-line.other-cli-acc        =  0
     4025         .
     4026       create bfs_tt-allsum-line.
     4027       assign
     4028       bfs_tt-allsum-line.sum-type = 'основная_сумма_со_знаком':U.
     4029       if bf_trn-doc.doc-type = 'инв':U or
     4030          bf_trn-doc.doc-type = 'при':U    or
     4031          bf_trn-doc.doc-type = 'возврат':U    then do:
     4032          buffer-copy bf_tt-allsum-line except bf_tt-allsum-line.sum-type to bfs_tt-allsum-line.
     4033       end.
     4034       else do:
     4035         assign
     4036           bfs_tt-allsum-line.fact-qnty           =  - bf_tt-allsum-line.fact-qnty
     4037           bfs_tt-allsum-line.cli-qnty            =  - bf_tt-allsum-line.cli-qnty
     4038           bfs_tt-allsum-line.sum-dsc-base-doc    =  - bf_tt-allsum-line.sum-dsc-base-doc
     4039           bfs_tt-allsum-line.sum-dsc-rubl-doc    =  - bf_tt-allsum-line.sum-dsc-rubl-doc
     4040           bfs_tt-allsum-line.dsc-base-doc        =  - bf_tt-allsum-line.dsc-base-doc
     4041           bfs_tt-allsum-line.dsc-rubl-doc        =  - bf_tt-allsum-line.dsc-rubl-doc
     4042           bfs_tt-allsum-line.vat-base-doc        =  - bf_tt-allsum-line.vat-base-doc
     4043           bfs_tt-allsum-line.vat-rubl-doc        =  - bf_tt-allsum-line.vat-rubl-doc
     4044           bfs_tt-allsum-line.vat-base-buyer-doc  =  - bf_tt-allsum-line.vat-base-buyer-doc
     4045           bfs_tt-allsum-line.vat-rubl-buyer-doc  =  - bf_tt-allsum-line.vat-rubl-buyer-doc
     4046           bfs_tt-allsum-line.slt-base-doc        =  - bf_tt-allsum-line.slt-base-doc
     4047           bfs_tt-allsum-line.slt-rubl-doc        =  - bf_tt-allsum-line.slt-rubl-doc
     4048           bfs_tt-allsum-line.road-tax-base-doc   =  - bf_tt-allsum-line.road-tax-base-doc
     4049           bfs_tt-allsum-line.road-tax-rubl-doc   =  - bf_tt-allsum-line.road-tax-rubl-doc
     4050           bfs_tt-allsum-line.excise-base-doc     =  - bf_tt-allsum-line.excise-base-doc
     4051           bfs_tt-allsum-line.excise-rubl-doc     =  - bf_tt-allsum-line.excise-rubl-doc
     4052           bfs_tt-allsum-line.sum-dsc-base-cur    =  - bf_tt-allsum-line.sum-dsc-base-cur
     4053           bfs_tt-allsum-line.sum-dsc-rubl-cur    =  - bf_tt-allsum-line.sum-dsc-rubl-cur
