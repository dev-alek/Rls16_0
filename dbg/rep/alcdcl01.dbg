     4314   procedure clcprtsl_calc-ttable :
     4315   define input parameter paris-doc           as   logical                 no-undo.
     4316   define input parameter paris-cur           as   logical                 no-undo.
     4317   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     4318   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     4319   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     4320   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     4321   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     4322   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     4323   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     4324   define input parameter parr-b              as   character               no-undo.
     4325   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     4326   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     4327   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     4328   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     4329   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     4330   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     4331   define buffer bf_tt-allsum      for tt-allsum.
     4332   define buffer bf_tt-clcparts    for tt-clcparts.
     4333   define buffer bf_tt-allsum-line for tt-allsum-line.
     4334   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     4335   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     4336   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     4337   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     4338   define variable varexcise          like ub.price-list.excise     no-undo.
     4339   do on error undo, return error return-value :
     4340   for each bf_tt-allsum-line
     4341   on error undo, return error return-value
     4342    :
     4343     delete bf_tt-allsum-line.
     4344   end.
     4345   for each bf_tt-allsum
     4346   on error undo, return error return-value
     4347   :
     4348     delete bf_tt-allsum.
     4349   end.
     4350   for each bf_tt-clcparts
     4351   on error undo, return error return-value
     4352   :
     4353   if v-calcbypart then do:
     4354             assign
     4355             parcur-base =   bf_tt-clcparts.part-cur-base
     4356             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     4357             parcur-excise =   bf_tt-clcparts.part-cur-excise
     4358             .
     4359   end.
     4360      run clcprtsl_calc-parts in this-procedure (
     4361        input recid(bf_tt-clcparts),
     4362        input paris-doc,
     4363        input paris-cur,
     4364        input parroad-tax,
     4365        input parexcise,
     4366        input parvat-pc,
     4367        input parcons-vat-pc,
     4368        input parslt-pc,
     4369        input parbase-rate,
     4370        input parbase-scale,
     4371        input parr-b,
     4372        input parcur-base,
     4373        input parcur-road-tax,
     4374        input parcur-excise,
     4375        input parcur-vat-pc,
     4376        input parcurcons-vat-pc,
     4377        input parcurslt-pc
     4378        ) no-error.
     4379     if error-status:error then do:
     4380       message
     4381         vss-workfile vss-revision vss-description skip
     4382         vss-include-info16 skip
     4383         "Ошибка при обсчете партии" skip
     4384         "Документ партии " bf_tt-clcparts.out-code skip
     4385         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     4386         return-value skip
     4387         error-status:get-message(1) skip
     4388         error-status:get-message(2) skip
     4389         error-status:get-message(3) skip
     4390         view-as alert-box error .
     4391       undo, return error .
     4392     end.
     4393     for each bf_tt-allsum on error undo, return error return-value :
     4394       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     4395       if not available bf_tt-allsum-line then do:
     4396         create bf_tt-allsum-line.
     4397         assign
     4398           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     4399       end.
     4400       assign
     4401         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     4402         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     4403         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
