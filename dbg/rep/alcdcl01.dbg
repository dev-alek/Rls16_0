     2331             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     2332             and buff-stk-line.artic      = x-artic
     2333             and buff-stk-line.prod-type  = x-prod-type
     2334             and buff-stk-line.prod-code  = x-prod-code
     2335             and buff-stk-line.sum-type   = x-sum-type
     2336             and buff-stk-line.cat-id     = '##,##':U
     2337             and buff-stk-line.fact-order <= x-fact-order
     2338             and buff-stk-line.shift-num  = 0
     2339           use-index category
     2340           no-error .
     2341         if available buff-stk-line then do:
