     5621                                                       , input buf_parts.supp-code
     5622                                                       , input 'cli-alc-producer':U
     5623                                                       , output v-cli-alc-producer
     5624                                                       , output v-attr-type
     5625                                                       ) .
     5626                 if logical(v-cli-local) then do:
     5627                   if logical(v-cli-alc-producer) then do:
     5628                     assign
     5629                       v-total-local-producer      = v-total-local-producer + v-part-sum-r
     5630                       v-total-local-producer-qnty = v-total-local-producer-qnty + v-part-qnty
     5631                     .
     5632                   end.
     5633                   else do:
     5634                     if v-is-imp-gds then do:
     5635                       assign
     5636                         v-total-local-imp       = v-total-local-imp + v-part-sum-r
     5637                         v-total-local-imp-qnty  = v-total-local-imp-qnty + v-part-qnty
     5638                       .
     5639                     end.
     5640                     else do:
     5641                       assign
     5642                         v-total-local-rus       = v-total-local-rus + v-part-sum-r
     5643                         v-total-local-rus-qnty  = v-total-local-rus-qnty + v-part-qnty
     5644                       .
     5645                     end.
     5646                   end.
     5647                 end.
     5648                 else do:
     5649                     if v-is-imp-gds then do:
     5650                       assign
     5651                         v-total-not-local-imp       = v-total-not-local-imp + v-part-sum-r
     5652                         v-total-not-local-imp-qnty  = v-total-not-local-imp-qnty + v-part-qnty
     5653                       .
     5654                     end.
     5655                     else do:
     5656                       assign
