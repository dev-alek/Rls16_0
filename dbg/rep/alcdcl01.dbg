     6000       v-str-total-qnty                CHR(9)
     6001       v-str-total-local-producer-qnty CHR(9)
     6002       v-str-total-local-rus-qnty      CHR(9)
     6003       v-str-total-local-imp-qnty      CHR(9)
     6004       v-str-total-not-local-rus-qnty  CHR(9)
     6005       v-str-total-not-local-imp-qnty  CHR(9)
     6006       v-str-ras-qnty                  CHR(9)
     6007       v-str-spis-qnty                 CHR(9)
     6008       v-str-ost-end-qnty              CHR(9)
     6009     skip.
     6010     assign
     6011       v-str-ost-qnty                  = str-format( v-gt-ost                  , ">>>>>>>>>>9.999" , 15 )
     6012       v-str-total-qnty                = str-format( v-gt-total                , ">>>>>>>>>>9.999" , 15 )
     6013       v-str-total-local-producer-qnty = str-format( v-gt-total-local-producer , ">>>>>>>>>>9.999" , 15 )
     6014       v-str-total-local-rus-qnty      = str-format( v-gt-total-local-rus      , ">>>>>>>>>>9.999" , 15 )
     6015       v-str-total-local-imp-qnty      = str-format( v-gt-total-local-imp      , ">>>>>>>>>>9.999" , 15 )
     6016       v-str-total-not-local-rus-qnty  = str-format( v-gt-total-not-local-rus  , ">>>>>>>>>>9.999" , 15 )
     6017       v-str-total-not-local-imp-qnty  = str-format( v-gt-total-not-local-imp  , ">>>>>>>>>>9.999" , 15 )
     6018       v-str-ras-qnty                  = str-format( v-gt-ras                  , ">>>>>>>>>>9.999" , 15 )
     6019       v-str-spis-qnty                 = str-format( v-gt-spis                 , ">>>>>>>>>>9.999" , 15 )
     6020       v-str-ost-end-qnty              = str-format( v-gt-ost-end              , ">>>>>>>>>>9.999" , 15 )
     6021     .
