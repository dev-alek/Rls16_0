     6080   procedure find-alc-goods :
     6081   do
     6082   on error undo, return error return-value
     6083   :
     6084     define buffer buf_alc-type      for ub.alc-type.
     6085     define buffer buf_alc-type-gds  for ub.alc-type-gds.
     6086     define buffer buf_goods         for ub.goods.
     6087     empty temp-table tt-gds.
     6088     empty temp-table tt-alc-type.
     6089     for each buf_alc-type no-lock
     6090           where buf_alc-type.alc-type-status = 0
     6091     :
     6092       create tt-alc-type.
     6093       buffer-copy buf_alc-type to tt-alc-type.
     6094       for each buf_alc-type-gds no-lock
     6095             where buf_alc-type-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     6096               AND buf_alc-type-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     6097         , first buf_goods no-lock
     6098             where buf_goods.gds-code = buf_alc-type-gds.gds-code
     6099       :
     6100         find first tt-gds no-lock where tt-gds.gds-code = buf_goods.gds-code no-error .
     6101         if not available tt-gds then do:
     6102           create tt-gds.
     6103           buffer-copy buf_goods to tt-gds
     6104           assign
     6105             tt-gds.alc-type-inner-code = buf_alc-type.alc-type-inner-code
     6106             tt-gds.create-user-db-num  = buf_alc-type.create-user-db-num
     6107             tt-gds.alc-type-code       = buf_alc-type.alc-type-code
     6108             tt-gds.alc-type-name       = buf_alc-type.alc-type-name
     6109           .
     6110         end.
     6111       end.
     6112     end.
     6113   end.
     6114   end procedure.
     6115   procedure find-sert :
     6116   define input  parameter p-cli-type            like ub.trn-doc.cli-type no-undo .
     6117   define input  parameter p-cli-code            like ub.trn-doc.cli-code no-undo .
     6118   define input  parameter p-alc-type-inner-code like ub.alc-type.alc-type-inner-code .
     6119   define output parameter p-sert      as character          no-undo .
     6120   define output parameter p-sert-give as character          no-undo .
     6121   define buffer buf_alc-supp-lic      for ub.alc-supp-lic.
     6122   define buffer buf_alc-supp-lic-type for ub.alc-supp-lic-type.
     6123   do
     6124   on error undo, return error return-value
     6125   :
     6126     define variable v-sert-code             as character no-undo .
     6127     define variable v-sert-date             as character no-undo .
     6128     for each   buf_alc-supp-lic
     6129          where buf_alc-supp-lic.cli-type = p-cli-type
     6130            and buf_alc-supp-lic.cli-code = p-cli-code
     6131            and buf_alc-supp-lic.date-to  > x-Date-Alone
     6132          no-lock
     6133          :
     6134          IF buf_alc-supp-lic.all-type = 0 then do:
     6135             find first buf_alc-supp-lic-type
     6136                  where buf_alc-supp-lic-type.alc-supp-lic-code   = buf_alc-supp-lic.alc-supp-lic-code
     6137                  and buf_alc-supp-lic-type.alc-type-inner-code = p-alc-type-inner-code
     6138                  no-lock
     6139                  no-error.
     6140             if not available buf_alc-supp-lic-type then do:
     6141                next.
     6142             end.
     6143         end.
     6144         assign
     6145           p-sert       =  substitute( "серия &1 № &2 выдана &3 c &4 по &5"
     6146                                     , buf_alc-supp-lic.seria
     6147                                     , buf_alc-supp-lic.number
     6148                                     )
     6149           p-sert-give  = substitute( "выдана &3 c &4 по &5"
     6150                                     , buf_alc-supp-lic.who-are-got
     6151                                     , string( buf_alc-supp-lic.date-from , "99/99/9999")
     6152                                     , string( buf_alc-supp-lic.date-to , "99/99/9999")
     6153                                     )
     6154         .
     6155         return.
     6156     end.
     6157   end.
     6158   end procedure.
     6159   function str-format returns character (val as decimal , v-format as char, v-str-len as integer):
     6160     define variable v-str as character no-undo .
     6161     assign
     6162       v-str = ( if val = 0 then " ------------- ":U else replace( trim(string( val , v-format )) , "." , "," ) )
     6163     .
     6164     if length(v-str) < v-str-len then do:
     6165       assign
     6166         v-str = fill(" ", v-str-len - length(v-str)) + v-str
     6167       .
     6168     end.
     6169     return v-str.
     6170   end function.
     6171   procedure create-tt-alc-pri :
     6172   do
     6173   on error undo, return error return-value
     6174   :
     6175     define buffer buf_tt-alc-pri for tt-alc-pri.
     6176     define buffer t-doc          for ub.trn-doc.
     6177     define buffer buf_goods      for ub.goods.
     6178     define buffer buf_obj-list   for obj-list.
     6179     define variable v-doc-code              like ub.doc-line.doc-code  no-undo .
     6180     define variable v-doc-date              like ub.trn-doc.fact-date  no-undo .
     6181     define variable v-ms-base               like ub.goods.ms-base      no-undo .
     6182     define variable v-qnty                  like ub.doc-line.fact-qnty no-undo .
     6183     define variable v-attr-value            as character            no-undo .
     6184     define variable v-attr-type             as character            no-undo .
     6185     define variable v-fact-order-1          like ub.ot-line.fact-order no-undo .
     6186     define variable v-fact-order-2          like ub.ot-line.fact-order no-undo .
     6187     define variable v-shift-end-fact-order  as decimal              no-undo .
     6188     define variable v-day-end-fact-order    as decimal              no-undo .
     6189     define variable v-income-doc-code       like ub.trn-doc.doc-code   no-undo .
     6190     empty temp-table tt-alc-pri.
     6191     for each tt-alc-type no-lock,
     6192         each obj-list no-lock ,
     6193         each buf_trn-doc no-lock
     6194               where buf_trn-doc.obj-type     = obj-list.obj-type
     6195                 and buf_trn-doc.obj-code     = obj-list.obj-code
     6196                 and buf_trn-doc.status_      = 'факт':U
     6197                 and buf_trn-doc.fact-date   >= v-begin-date
     6198                 and buf_trn-doc.fact-date   <= v-end-date
     6199                 and ( buf_trn-doc.ext-doc-type = 'ie':U
     6200                   or  buf_trn-doc.ext-doc-type = 'iv':U) ,
     6201         each buf_doc-line no-lock
     6202               where buf_doc-line.doc-code    = buf_trn-doc.doc-code ,
     6203         first tt-gds no-lock
     6204               where buf_doc-line.artic       = tt-gds.artic
     6205                 and buf_doc-line.prod-type   = tt-gds.prod-type
     6206                 and buf_doc-line.prod-code   = tt-gds.prod-code
     6207                 and tt-gds.alc-type-inner-code          = tt-alc-type.alc-type-inner-code
     6208                 AND tt-gds.create-user-db-num          = tt-alc-type.create-user-db-num
     6209       :
     6210         if buf_trn-doc.ext-doc-type = 'iv':U then do:
     6211           for each buf_parts no-lock
     6212                 where buf_parts.out-code  = buf_trn-doc.doc-code
     6213                   and buf_parts.obj-type  = buf_trn-doc.obj-type
     6214                   and buf_parts.obj-code  = buf_trn-doc.obj-code
     6215                   and buf_parts.artic     = buf_doc-line.artic
     6216                   and buf_parts.prod-type = buf_doc-line.prod-type
     6217                   and buf_parts.prod-code = buf_doc-line.prod-code
     6218           :
     6219             find first buf_goods no-lock
     6220               where buf_goods.artic     = buf_parts.artic
     6221                 and buf_goods.prod-type = buf_parts.prod-type
     6222                 and buf_goods.prod-code = buf_parts.prod-code
     6223             no-error .
     6224             if not available buf_goods then do:
     6225               message
     6226                 "Не найден товар!" skip
     6227                 buf_parts.artic skip
     6228                 buf_parts.prod-type skip
     6229                 buf_parts.prod-code
     6230               view-as alert-box error.
     6231             end.
     6232             run find-income-doc-code in this-procedure ( input buf_parts.in-code
     6233                                                        , input buf_goods.gds-code
     6234                                                        , input buf_parts.part-code
     6235                                                        , output v-income-doc-code
     6236                                                        ).
     6237             find first t-doc no-lock
     6238               where t-doc.doc-code = v-income-doc-code
     6239             no-error .
     6240             if not available t-doc then do:
     6241               message
     6242                 substitute("Не могу найти накладную с номером: &1", buf_parts.in-code)
     6243               view-as alert-box error .
     6244               next.
     6245             end.
     6246             if    t-doc.ext-doc-type = 'ie':U
     6247               and t-doc.fact-date   >= v-begin-date
     6248               and t-doc.fact-date   <= v-end-date
     6249             then do:
     6250               find first buf_obj-list no-lock
     6251                 where buf_obj-list.obj-type = t-doc.obj-type
     6252                   and buf_obj-list.obj-code = t-doc.obj-code
     6253               no-error .
     6254               if available buf_obj-list then do :
     6255                 next.
     6256               end.
     6257             end.
     6258   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     6259                           input 'dids':U ,
     6260                          output v-attr-value ,
     6261                          output v-attr-type )  .
     6262             assign
     6263               v-doc-date = if v-attr-value = "" or v-attr-value = ? then t-doc.fact-date else date( v-attr-value )
     6264             .
     6265   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input t-doc.doc-code ,
     6266                           input 'nids':U ,
     6267                          output v-attr-value ,
     6268                          output v-attr-type )  .
     6269             assign
     6270               v-doc-code = if v-attr-value = "" or v-attr-value = ? then
     6271                               (if buf_parts.in-code <> ? then buf_parts.in-code else "" )
     6272                            else v-attr-value
     6273             .
     6274             find first buf_tt-alc-pri no-lock
     6275               where buf_tt-alc-pri.alc-type-inner-code = tt-alc-type.alc-type-inner-code
     6276                 AND buf_tt-alc-pri.create-user-db-num  = tt-alc-type.create-user-db-num
     6277                 and buf_tt-alc-pri.doc-code   = v-doc-code
     6278                 and buf_tt-alc-pri.artic      = buf_parts.artic
     6279                 and buf_tt-alc-pri.prod-type  = buf_parts.prod-type
     6280                 and buf_tt-alc-pri.prod-code  = buf_parts.prod-code
     6281             no-error .
     6282             if available buf_tt-alc-pri then do:
     6283               assign
     6284                 v-qnty = buf_tt-alc-pri.fact-qnty
     6285                 buf_tt-alc-pri.fact-qnty = buf_tt-alc-pri.fact-qnty + buf_parts.fact-qnty
     6286               .
     6287             end.
     6288             else do:
     6289               create tt-alc-pri.
     6290               assign
     6291                 tt-alc-pri.alc-type-inner-code  = tt-alc-type.alc-type-inner-code
     6292                 tt-alc-pri.create-user-db-num   = tt-alc-type.create-user-db-num
     6293                 tt-alc-pri.alc-type-code        = tt-alc-type.alc-type-code
     6294                 tt-alc-pri.doc-code             = v-doc-code
     6295                 tt-alc-pri.artic                = buf_parts.artic
     6296                 tt-alc-pri.prod-type            = buf_parts.prod-type
     6297                 tt-alc-pri.prod-code            = buf_parts.prod-code
     6298                 tt-alc-pri.fact-qnty            = buf_parts.fact-qnty
     6299                 tt-alc-pri.cli-type             = t-doc.cli-type
     6300                 tt-alc-pri.cli-code             = t-doc.cli-code
     6301                 tt-alc-pri.fact-date            = v-doc-date
     6302                 tt-alc-pri.ms-base              = if available buf_goods then buf_goods.ms-base else 0
     6303               .
     6304             end.
     6305           end.
     6306         end.
     6307         else do:
     6308           find first buf_goods no-lock
     6309             where buf_goods.artic     = buf_doc-line.artic
     6310               and buf_goods.prod-type = buf_doc-line.prod-type
     6311               and buf_goods.prod-code = buf_doc-line.prod-code
     6312           no-error .
     6313           if not available buf_goods then do:
     6314             message
     6315               "Не найден товар!" skip
     6316               buf_doc-line.artic skip
     6317               buf_doc-line.prod-type skip
     6318               buf_doc-line.prod-code
     6319             view-as alert-box error.
     6320           end.
     6321   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6322                           input 'dids':U ,
     6323                          output v-attr-value ,
     6324                          output v-attr-type )  .
     6325           assign
     6326             v-doc-date = if v-attr-value = "" or v-attr-value = ? then buf_trn-doc.fact-date else date( v-attr-value )
     6327           .
     6328   if valid-handle( g#trdcalib ) <> yes then do:       run str/trdcalib.p persistent no-error.       if error-status :error or valid-handle( g#trdcalib ) <> yes then do:         message "Error starting trdcalib.p"    skip( 0 )                 g#trdcalib                     skip( 0 )                 g#trdcalib   :type             skip( 0 )                 g#trdcalib   :file-name        skip( 0 )                 error-status :get-message( 1 ) skip( 0 )                 return-value                   skip( 0 )         view-as alert-box error.         stop.       end.      end.     run trdcalib_tdat-val in g#trdcalib (  input buf_trn-doc.doc-code ,
     6329                           input 'nids':U ,
     6330                          output v-attr-value ,
     6331                          output v-attr-type )  .
     6332           assign
     6333             v-doc-code = if v-attr-value = "" or v-attr-value = ? then buf_trn-doc.doc-code else v-attr-value
     6334           .
     6335           find first buf_tt-alc-pri no-lock
     6336             where buf_tt-alc-pri.alc-type-inner-code  = tt-alc-type.alc-type-inner-code
     6337               and buf_tt-alc-pri.create-user-db-num   = tt-alc-type.create-user-db-num
     6338               and buf_tt-alc-pri.alc-type-code        = tt-alc-type.alc-type-code
     6339               and buf_tt-alc-pri.doc-code             = v-doc-code
     6340               and buf_tt-alc-pri.artic                = buf_doc-line.artic
     6341               and buf_tt-alc-pri.prod-type            = buf_doc-line.prod-type
     6342               and buf_tt-alc-pri.prod-code            = buf_doc-line.prod-code
     6343           no-error .
     6344           if available buf_tt-alc-pri then do:
     6345             assign
     6346               v-qnty = buf_tt-alc-pri.fact-qnty
     6347               buf_tt-alc-pri.fact-qnty = buf_tt-alc-pri.fact-qnty + buf_doc-line.fact-qnty
     6348             .
     6349           end.
     6350           else do:
     6351             create tt-alc-pri.
     6352             assign
     6353               tt-alc-pri.alc-type-inner-code  = tt-alc-type.alc-type-inner-code
     6354               tt-alc-pri.create-user-db-num   = tt-alc-type.create-user-db-num
     6355               tt-alc-pri.alc-type-code        = tt-alc-type.alc-type-code
     6356               tt-alc-pri.doc-code             = v-doc-code
     6357               tt-alc-pri.artic                = buf_doc-line.artic
     6358               tt-alc-pri.prod-type            = buf_doc-line.prod-type
     6359               tt-alc-pri.prod-code            = buf_doc-line.prod-code
     6360               tt-alc-pri.fact-qnty            = buf_doc-line.fact-qnty
     6361               tt-alc-pri.cli-type             = buf_trn-doc.cli-type
     6362               tt-alc-pri.cli-code             = buf_trn-doc.cli-code
     6363               tt-alc-pri.fact-date            = v-doc-date
     6364               tt-alc-pri.ms-base              = if available buf_goods then buf_goods.ms-base else 0
     6365             .
     6366           end.
     6367         end.
     6368       end.
     6369   end.
     6370   end procedure.
     6371   procedure print-alc-pri2 :
     6372   do
     6373   on error undo, return error return-value
     6374   :
     6375     define buffer buf_parts     for ub.parts.
     6376     define buffer t-doc         for ub.trn-doc.
     6377     define buffer buf_alc-type  for ub.alc-type.
     6378     define variable v-sert-code             as character no-undo .
     6379     define variable v-sert-date             as character no-undo .
     6380     define variable v-is-null-rec           as logical   no-undo .
     6381     define variable v-is-first-alc-type-name-str as logical init yes  no-undo .
     6382     define variable v-alc-type-name              as character no-undo .
     6383     define variable v-doc-num-list          as character no-undo .
     6384     define variable v-doc-date-list         as character no-undo .
     6385     define variable v-dal-list              as character no-undo .
     6386     define variable v-count                 as integer   no-undo .
     6387     define variable v-i                     as integer   no-undo .
     6388     define variable v-doc                   as character no-undo .
     6389     define variable v-date                  as character no-undo .
     6390     define variable v-dal                   as decimal   no-undo .
     6391     if   Make-Excel Then  do:   Output stream ForExcel close.   assign   number-list = number-list + 1   .   os-delete value( v-excel-file + ".":U + string(number-list)).   Output Stream ForExcel to value( v-excel-file + ".":U + string(number-list ) ) . end.
     6392     find first sheetf
     6393       where sheetf.sheet-num = 3
     6394     no-error .
     6395     if not available sheetf then do:
     6396       create sheetf.
     6397     end.
     6398     assign
     6399         sheetf.sheet-num   = 3
     6400         sheetf.MergeCellsH = "3:7/6:7"
     6401         sheetf.MergeCellsV = "1=1:3/2=1:3/3=2:3/4=2:3/5=2:3/8=1:3/9=1:3"
     6402         sheetf.Excel-Column-Lable =
     6403         "№ п/п"                                         + chr(44) +
     6404         "Наименование видов алкогольной продукции"      + chr(44) +
     6405         "Поставщик"                                     + chr(44) +
     6406                                                           chr(44) +
     6407                                                           chr(44) +
     6408                                                           chr(44) +
     6409                                                           chr(44) +
     6410          "Дата и номер товарно-транспортной накладной"  + chr(44) +
     6411          "Объем закупленой продукции"                   + chr(44) +
     6412          chr(10)   +
     6413                                                           chr(44) +
     6414                                                           chr(44) +
     6415          "наименование поставщика"                      + chr(44) +
     6416          "ИНН"                         + chr(44) +
     6417          "место нахождения (юридический адрес)"         + chr(44) +
     6418          "лицензия"                                     + chr(44) +
     6419                                                           chr(44) +
     6420          chr(10)   +
     6421                                                           chr(44) +
     6422                                                           chr(44) +
     6423                                                           chr(44) +
     6424                                                           chr(44) +
     6425                                                           chr(44) +
     6426          "серия номер дата выдачи"                      + chr(44) +
     6427          "кем выдана"                                   + chr(44) +
     6428                                                           chr(44) +
     6429                                                           chr(44) +
     6430          chr(10)   +
     6431          "1"  + chr(44) +
     6432          "2"  + chr(44) +
     6433          "3"  + chr(44) +
     6434          "4"  + chr(44) +
     6435          "5"  + chr(44) +
     6436          "6"  + chr(44) +
     6437          "7"  + chr(44) +
     6438          "8"  + chr(44) +
     6439          "9"  + chr(44)
     6440       sheetf.sizes =
     6441       "3"  + chr(44) +
     6442       "40"  + chr(44) +
     6443       "40"  + chr(44) +
     6444       "15"  + chr(44) +
     6445       "60"  + chr(44) +
     6446       "20"  + chr(44) +
     6447       "20"  + chr(44) +
     6448       "20"  + chr(44) +
     6449       "12"
     6450       Sheetf.colformat = "1=0;2=@;3=@;4=@;5=@;6=@;7=@;8=@;9=@;"
     6451       ReportNAme = "ДЕКЛАРАЦИЯ ОБ ОБЪЕМАХ РОЗНИЧНОЙ ПРОДАЖИ АЛКОГОЛЬНОЙ ПРОДУКЦИИ за " + string(v-begin-date,"99/99/9999") + " - " + string(v-end-date,"99/99/9999")
     6452       str1       = chr(10)
     6453       str2       = ""
     6454       str3       = ""
     6455       str4       = "2. Сведения об объемах закупки и поставщиках алкогольной продукции"
     6456     .
     6457     run rep/extitle.p (3).
     6458     put stream out-stream
     6459           skip (3)
     6460           "2. Сведения об объемах закупки и поставщиках алкогольной продукции"
     6461           skip (2)
     6462     .
     6463     assign
     6464       v-sea-num = 0
     6465     .
     6466     run create-tt-alc-pri in this-procedure .
     6467     for each tt-alc-type no-lock
     6468       use-index i-alc-type-code
     6469       :
     6470       assign
     6471         v-is-null-rec = yes
     6472         v-sea-num     = v-sea-num + 1
     6473         v-alc-type-name  = tt-alc-type.alc-type-name
     6474         v-is-first-alc-type-name-str = yes
     6475       .
     6476       do while length(v-alc-type-name) > 0
     6477       :
     6478         display stream out-stream
     6479           v-sea-num when v-is-first-alc-type-name-str
     6480           substring(v-alc-type-name, 1, 26) @ tt-gds.alc-type-name
     6481           " ------------- ":U @ v-fmtcli-name
     6482           " ------------- ":U @ v-fmtcli-inn
     6483           " ------------- ":U @ v-addres
     6484           " ------------- ":U @ v-sert
     6485           " ------------- ":U @ v-sert-give
     6486           " ------------- ":U @ v-doc-num-date
     6487           " ------------- ":U @ v-str-dal
     6488           sym1
     6489           sym2
     6490           sym3
     6491           sym4
     6492           sym5
     6493           sym6
     6494           sym7
     6495           sym8
     6496           sym9
     6497           sym10
     6498         with frame f-in.
     6499         down stream out-stream with frame f-in.
     6500         assign
     6501           v-alc-type-name = substring(v-alc-type-name, 26 + 1 , length(v-alc-type-name))
     6502           v-is-first-alc-type-name-str = no
     6503         .
     6504       end.
     6505       assign
     6506         v-alc-type-name  = tt-alc-type.alc-type-name
     6507       .
     6508       for each tt-alc-pri no-lock
     6509         where tt-alc-pri.alc-type-inner-code = tt-alc-type.alc-type-inner-code
     6510           and tt-alc-pri.create-user-db-num  = tt-alc-type.create-user-db-num
     6511         break by tt-alc-pri.alc-type-inner-code
     6512               BY tt-alc-pri.create-user-db-num
     6513               by tt-alc-pri.cli-type
     6514               by tt-alc-pri.cli-code
     6515               by tt-alc-pri.fact-date
     6516               by tt-alc-pri.doc-code
     6517       :
     6518         if last-of( tt-alc-pri.doc-code ) then do:
     6519           run fmtcli-get-client in this-procedure
     6520                     ( input  tt-alc-pri.cli-type
     6521                     , input  tt-alc-pri.cli-code
     6522                     ) .
     6523           if v-fmtcli-addres = "" then do:
     6524             assign
     6525               v-addres = " ------------- ":U
     6526             .
     6527           end.
     6528           else do:
     6529             assign
     6530               v-addres = v-fmtcli-addres
     6531             .
     6532           end.
     6533           run find-sert ( input tt-alc-pri.cli-type
     6534                         , input tt-alc-pri.cli-code
     6535                         , input tt-alc-pri.alc-type-inner-code
     6536                         , output v-sert
     6537                         , output v-sert-give
     6538                         ) .
     6539           assign
     6540             v-doc-num-date  = substitute("&1, &2", tt-alc-pri.doc-code , tt-alc-pri.fact-date)
     6541             v-dal           = v-dal + ( tt-alc-pri.fact-qnty * tt-alc-pri.ms-base / 10 )
     6542             v-str-dal       = str-format(v-dal, ">>>>>>>>>9.9999", 15)
     6543             v-fmtcli-name   = if v-fmtcli-name = "" or v-fmtcli-name = ? then " ------------- ":U else v-fmtcli-name
     6544             v-fmtcli-inn    = if v-fmtcli-inn = "" or v-fmtcli-inn = ? then " ------------- ":U else v-fmtcli-inn
     6545           .
     6546           display stream out-stream
     6547             v-fmtcli-name
     6548             v-fmtcli-inn
     6549             v-addres
     6550             v-sert
     6551             v-sert-give
     6552             v-doc-num-date
     6553             v-str-dal
     6554             sym1
     6555             sym2
     6556             sym3
     6557             sym4
     6558             sym5
     6559             sym6
     6560             sym7
     6561             sym8
     6562             sym9
     6563             sym10
     6564           with frame f-in.
     6565           down stream out-stream with frame f-in.
     6566           assign
     6567             v-str-dal       = str-format(v-dal, ">>>>>>>>>9.9999", 0 )
     6568           .
     6569           if Make-Excel then  put   stream ForExcel unformatted
     6570             if v-is-null-rec then string(v-sea-num)  else "" CHR(9)
     6571             if v-is-null-rec then v-alc-type-name else "" CHR(9)
     6572             v-fmtcli-name   CHR(9)
     6573             v-fmtcli-inn    CHR(9)
     6574             v-addres        CHR(9)
     6575             v-sert          CHR(9)
     6576             v-sert-give     CHR(9)
     6577             v-doc-num-date  CHR(9)
     6578             v-str-dal       CHR(9)
     6579           skip.
     6580           assign
     6581             v-dal           = 0
     6582             v-str-dal       = ""
     6583             v-doc-num-date  = ""
     6584             v-is-null-rec   = no
     6585           .
     6586         end.
     6587         else do:
     6588           assign
     6589             v-dal = v-dal + ( tt-alc-pri.fact-qnty * tt-alc-pri.ms-base / 10 )
     6590           .
     6591         end.
     6592       end.
     6593       put stream out-stream v-line format "X(194)" at 1 SKIP.
     6594     end.
     6595     if line-counter( out-stream ) + 13 > page-size( out-stream ) then do:
     6596       page stream out-stream .
     6597     end.
     6598     put stream out-stream
     6599       skip(2)
     6600       "Примечание:" skip
     6601       "Дал(декалитр, десять литров) - единица измерения алкогольной продукции (количество бутылок x емкость : 10)." skip (2)
     6602       "М.П." "Руководитель организации" at 160 skip
     6603       "____________________________________" at 160 skip
     6604       "(Ф.И.О.)" at 170 skip(2)
     6605       "Главный бухгалтер" at 160 skip
     6606       "____________________________________" at 160 skip
     6607       "(Ф.И.О.)" at 170 skip(2)
     6608     .
     6609     if Make-Excel then  put   stream ForExcel unformatted
     6610     skip(2)
     6611     "Примечание:" skip
     6612     "Дал(декалитр, десять литров) - единица измерения алкогольной продукции (количество бутылок x емкость : 10)." skip (2)
     6613     "М.П."
     6614     fill(CHR(9), 6)
     6615     "Руководитель организации" skip(1)
     6616     fill(CHR(9), 6)
     6617     "____________________________________" skip
     6618     fill(CHR(9), 6)
     6619     fill(" ",15) "(Ф.И.О.)" skip(2)
     6620     fill(CHR(9), 6)
     6621     "Главный бухгалтер" skip(1)
     6622     fill(CHR(9), 6)
     6623     "____________________________________" skip
     6624     fill(CHR(9), 6)
     6625     fill(" ",15) "(Ф.И.О.)"
     6626     skip.
     6627     empty temp-table tt-alc-pri.
     6628   end.
     6629   end procedure.
     6630   procedure find-income-doc-code :
     6631   define input  parameter p-in-code         like ub.parts.in-code    no-undo .
     6632   define input  parameter p-gds-code        like ub.goods.gds-code   no-undo .
     6633   define input  parameter p-part-code       like ub.parts.part-code  no-undo .
     6634   define output parameter p-income-doc-code like ub.parts.in-code    no-undo .
     6635   define buffer buf_parts-attr for ub.parts-attr .
     6636   define buffer buf_income_parts-attr for ub.parts-attr .
     6637   do on error undo, return error return-value :
     6638     assign
     6639       p-income-doc-code = ?
     6640     .
     6641     find first buf_parts-attr no-lock
     6642       where buf_parts-attr.in-code   = p-in-code
     6643         and buf_parts-attr.gds-code  = p-gds-code
     6644         and buf_parts-attr.part-code = p-part-code
     6645     no-error .
     6646     if available buf_parts-attr then do:
     6647       find first buf_income_parts-attr no-lock
     6648         where buf_income_parts-attr.in-code   = buf_parts-attr.income-in-code
     6649           and buf_income_parts-attr.gds-code  = buf_parts-attr.income-gds-code
     6650           and buf_income_parts-attr.part-code = buf_parts-attr.income-part-code
     6651         no-error .
     6652       if available buf_income_parts-attr then do:
     6653         assign
     6654           p-income-doc-code = buf_parts-attr.income-in-code
     6655         .
     6656       end.
     6657       else do:
     6658         assign
     6659           p-income-doc-code = ?
     6660         .
     6661       end.
     6662     end.
     6663     else do:
     6664       assign
     6665         p-income-doc-code = ?
     6666       .
     6667     end.
     6668   end.
     6669   end procedure.
