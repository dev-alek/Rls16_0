     5008       view-as alert-box error .
     5009       return error.
     5010     end.
     5011      find first buf_alc-sale-lic
     5012           where buf_alc-sale-lic.cli-type = buf_clients.obj-type
     5013             and buf_alc-sale-lic.cli-code = buf_clients.obj-code
     5014             and buf_alc-sale-lic.date-to  > x-Date-Alone
     5015            no-lock
     5016            no-error
     5017            .
     5018     if available buf_alc-sale-lic then do:
     5019         assign
