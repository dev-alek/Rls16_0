     5021                                     , buf_alc-sale-lic.seria
     5022                                     , buf_alc-sale-lic.number
     5023                                     , buf_alc-sale-lic.who-are-got
     5024                                     , string( buf_alc-sale-lic.date-from , "99/99/9999")
     5025                                     , string( buf_alc-sale-lic.date-to , "99/99/9999")
     5026                                     )
     5027         .
     5028     end.
