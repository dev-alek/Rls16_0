     4943   procedure print-enclosure :
     4944   do
     4945   on error undo, return error return-value
     4946   :
     4947     define variable v-host-egrip-num  as character format "X(75)" no-undo .
     4948     define variable v-host-egrip-date as character format "X(10)" no-undo .
