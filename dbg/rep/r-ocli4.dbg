     1153   procedure create-temp-t-post-stk-line :
     1154       define variable str  as char      format "X(60)" no-undo.
     1155       define variable str2 as char      no-undo.
     1156       define variable v-r  as character no-undo init "" .
     1157       define variable i#i  as int       no-undo.
     1158    do
     1159    on error undo, return error return-value
     1160    :
     1161    if available ub.goods and
     1162       available ub.clients and
     1163       available prod-cli then do:
     1164     create temp-t-post-stk-line .
     1165     BUFFER-COPY post-stk-line  TO temp-t-post-stk-line
     1166     assign
     1167       temp-t-post-stk-line.goods-grp-name    = ub.goods.grp-name
     1168       temp-t-post-stk-line.gds-code          = ub.goods.gds-code
     1169       temp-t-post-stk-line.unit-base         = ub.goods.unit-base
     1170       temp-t-post-stk-line.prt-root          = ub.goods.prt-root
     1171       temp-t-post-stk-line.gds-type          = ub.goods.gds-type
     1172       temp-t-post-stk-line.gds-name          = if g#gds-engl then ub.goods.engl-name else ub.goods.gds-name
     1173       temp-t-post-stk-line.clients-grp-name  = ub.clients.grp-name
     1174       temp-t-post-stk-line.clients-obj-name  = ub.clients.obj-name
     1175       temp-t-post-stk-line.prod-cli-obj-name = prod-cli.obj-name
     1176       temp-t-post-stk-line.prod-cli-obj-code = prod-cli.obj-code
     1177       temp-t-post-stk-line.prod-cli-obj-type = prod-cli.obj-type
     1178     .
     1179               if xlavel > 0 then
     1180               do:
     1181                   repeat i#i =1 to xlavel:
     1182                       if i#i =1 then str   = entry(1,ub.goods.grp-name, chr(47)) .
     1183                       else
     1184                       do:
     1185                           str2 = entry(i#i,ub.goods.grp-name, chr(47)) no-error.
     1186                           if not error-status:error  and str2 <> "":u then
     1187                               str = str +  chr(47) +  entry(i#i,ub.goods.grp-name, chr(47)) no-error .
     1188                       end.
     1189                   end.
     1190                   if str <> ? then
     1191                   do:
     1192                       temp-t-post-stk-line.goods-grp-name = str + chr(47) .
     1193                   end.
     1194               end.
     1195               else
     1196               do :
     1197                   temp-t-post-stk-line.goods-grp-name = ub.goods.grp-name.
     1198               end.
     1199           end.
     1200    end.
     1201   end procedure.
     1202   function excel-format-dec-to-char returns char (input p-dec as decimal ).
     1203     if num-entries(string(p-dec), '.') = 2
     1204       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
     1205       else return( string(p-dec)) .
     1206   end function.
     1207   function format-point-to-comma returns char (input orig as char ) .
     1208   define variable rtext as character no-undo .
     1209   define variable strt as integer no-undo .
     1210   define variable leng as integer no-undo .
     1211   assign rtext = orig .
     1212   repeat:
     1213     strt =  index(rtext,'.').
     1214     if strt = 0 then leave.
     1215     leng = 1.
     1216     substring(rtext,strt,leng,"character") = v-delim .
     1217   end.
     1218   return rtext.
     1219   end function.
     1220   function format-excel-text returns char ( input start-text as char ) :
     1221   def var  i    as int no-undo.
     1222   def var  ch   as char no-undo.
     1223   def var  n    as int no-undo.
     1224   def var  ipos as int no-undo.
     1225     n = num-entries(trim(start-text), chr(10)) - 1 .
     1226     do i = 1 to n :
     1227       ipos = index( start-text, chr(10)).
     1228       if ipos > 0 then
     1229         substr( start-text, ipos, 1 ) = ' '.
     1230     end.
     1231     n = num-entries(trim(start-text), chr(13)) - 1 .
     1232     do i = 1 to n :
     1233       ipos = index( start-text, chr(13)).
     1234       if ipos > 0 then
     1235         substr( start-text, ipos, 1 ) = ' '.
     1236     end.
     1237     if index( start-text, '"' ) = 0 then
     1238       start-text =  '="'   + trim( start-text) + '"'   .
     1239       else do:
     1240         n = num-entries(trim(start-text), '"') - 1.
     1241         do i = 1 to n :
     1242           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1243         end.
     1244         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1245         start-text = '="'  + ch  + '"' .
     1246       end.
     1247     return start-text.
     1248   end.
     1249   function excel-sum returns char (input p-dec as decimal ).
     1250     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
     1251   end function.
     1252   function excel-qnty returns char (input p-dec as decimal ).
     1253     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
     1254   end function.
     1255   function format-excel-text-macr returns char ( input start-text as char ) :
     1256   def var  i    as int no-undo.
     1257   def var  ch   as char no-undo.
     1258   def var  n    as int no-undo.
     1259   def var  ipos as int no-undo.
     1260     n = num-entries(trim(start-text), chr(10)) - 1 .
     1261     do i = 1 to n :
     1262       ipos = index( start-text, chr(10)).
     1263       if ipos > 0 then
     1264         substring( start-text, ipos , 1 ) = ' '.
     1265     end.
     1266     n = num-entries(trim(start-text), chr(13)) - 1 .
     1267     do i = 1 to n :
     1268       ipos = index( start-text, chr(13)).
     1269       if ipos > 0 then
     1270         substring( start-text, ipos, 1 ) = ' '.
     1271     end.
     1272     if index( start-text, '"' ) = 0 then
     1273       start-text =  '"'   + trim( start-text) + '"'   .
     1274       else do:
     1275         n = num-entries(trim(start-text), '"') - 1.
     1276         do i = 1 to n :
     1277           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
     1278         end.
     1279         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
     1280         start-text = '"'  + ch  + '"' .
     1281       end.
     1282     n = num-entries(trim(start-text), chr(10)) - 1 .
     1283     do i = 1 to n :
     1284       ipos = index( start-text, chr(10)).
     1285       if ipos > 0 then
     1286         substring( start-text, ipos , 1 ) = ' '.
     1287     end.
     1288       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
     1289     return start-text.
     1290   end.
     1291   FUNCTION n-lavel RETURNS char (INPUT grp-name as char, INPUT lavel# as int ).
     1292   define variable  str  as char format "X(60)"  no-undo.
     1293   define variable  str2 as char no-undo.
     1294   define variable v-r as character no-undo init "" .
     1295   define variable  i#i as int no-undo.
     1296   STR = "".
     1297   repeat i#i =1 to lavel#:
     1298       if i#i =1 then str   = entry(1,grp-name, chr(47)) .
     1299       else do:
     1300           str2 = entry(i#i,grp-name, chr(47)) no-error.
     1301           if not error-status:error  and str2 <> "":u then
     1302                  str = str +  chr(47) +  entry(i#i,grp-name, chr(47)) no-error .
     1303           end.
     1304   end.
     1305   if str <> ? then do:
     1306   v-r = str + chr(47) .
     1307   end.
     1308   RETURN v-r .
     1309   END FUNCTION.
     1310   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1311   define variable v-waitfram-action01         as character   no-undo .
     1312   define variable v-waitfram-action02         as character   no-undo .
     1313   define variable v-waitfram-action03         as character   no-undo .
     1314   define variable mWaitFramTextBeg            as character   no-undo.
     1315   define variable mWaitFramTextEnd            as character   no-undo.
     1316   define variable mWaitFramView               as logical     no-undo.
     1317   define variable mWaitProcEvent              as logical     no-undo init yes.
     1318   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1319   define variable mWaitFramStop               as logical     no-undo.
     1320   define variable mWaitFramStopUser           as logical     no-undo.
     1321   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1322   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1323   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1324   define button B-WaitFramStop auto-end-key
     1325        label "Стоп"
     1326        size 10 by 1 tooltip "Остоновить процесс".
     1327   define button B-viewProcInfo
     1328        label "Информация"
     1329        size 15 by 1 tooltip "Информация о процесс".
     1330   define frame waitfram
     1331     v-waitfram-action01 format "x(72)" no-label skip
     1332     v-waitfram-action02 format "x(72)" no-label skip
     1333     v-waitfram-action03 format "x(72)" no-label skip
     1334     B-viewProcInfo
     1335     B-WaitFramStop at row 4 col 30
     1336     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1337     .
     1338   define new global shared variable mBatchMode as logical no-undo init ?.
     1339   define variable mFramBachModHandle as handle no-undo.
     1340   mFramBachModHandle = frame waitfram:handle.
     1341   define variable mFameOldVis as logical no-undo.
     1342   define variable mVisCUrentVin as logical no-undo.
     1343   if session:batch-mode
     1344   then
     1345      mBatchMode = yes.
     1346   if mBatchMode = ? then do:
     1347     mVisCUrentVin = current-window:visible.
     1348     mFameOldVis = mFramBachModHandle:visible.
     1349     mFramBachModHandle:visible  = yes.
     1350     mBatchMode = mFramBachModHandle:visible ne yes.
     1351     mFramBachModHandle:visible = mFameOldVis.
     1352     current-window:visible = mVisCUrentVin.
     1353   end.
     1354    if  log-manager:logfile-name ne ?
     1355     then DO:
     1356         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1357         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1358         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1359     end.
     1360   on choose of B-WaitFramStop in frame waitfram
     1361   do:
     1362     mWaitFramStop = yes.
     1363     mWaitFramStopUser = yes.
     1364   end.
     1365   function waitfram-check-timeout returns logical():
     1366      define variable vtime as int64 no-undo.
     1367      if mWaitFramStopTimeOut
     1368      then
     1369         return yes.
     1370      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1371      if     mWaitFramTimeOut ne ?
     1372         and mWaitFramTimeOut ne 0
     1373         and mWaitFramTimeOut lt vtime
     1374      then do:
     1375         mWaitFramStopTimeOut = yes.
     1376      end.
     1377      return mWaitFramStopTimeOut.
     1378   end.
     1379   procedure waitfram-hide :
     1380     if not session:batch-mode
     1381     then do
     1382     on error undo, return error return-value
     1383     :
     1384       pause 0 before-hide .
     1385       if not mBatchMode then
     1386         hide frame waitfram .
     1387     if     not mWaitFramView
     1388        and mWaitProcEvent
     1389     then
     1390       process events .
     1391     end.
     1392   end procedure.
     1393   procedure waitfram-show :
     1394     define input  parameter p-message as character no-undo .
     1395     define variable v-left-margin as integer   no-undo .
     1396     if not session:batch-mode
     1397     then do
     1398     on error undo, return error return-value
     1399     :
     1400       if length(p-message) <= 70 then do:
     1401         assign
     1402           v-left-margin = integer((70 - length(p-message)) / 2)
     1403         .
     1404         assign
     1405           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1406         .
     1407         assign
     1408           v-waitfram-action01 = " "
     1409           v-waitfram-action02 = " "
     1410                                    + fill(" ", v-left-margin)
     1411                                    + p-message
     1412           v-waitfram-action03 = " "
     1413         .
     1414       end.
     1415       else do:
     1416         define variable vRindex1 as integer no-undo.
     1417         define variable vRindex2 as integer no-undo.
     1418         vRindex1 = r-index(p-message," ",70).
     1419         if vRindex1 = 0
     1420         then
     1421            vRindex1 = 70.
     1422         if length(p-message)  <= vRindex1 + 70 then do:
     1423           assign
     1424             v-waitfram-action01 = " "
     1425             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1426             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1427           .
     1428         end.
     1429         else do:
     1430           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1431           if vRindex2 <= vRindex1
     1432           then
     1433              vRindex2 = vRindex1 + 70.
     1434           assign
     1435             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1436             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1437             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1438           .
     1439         end.
     1440       end.
     1441       B-viewProcInfo:visible   in frame waitfram = no.
     1442       B-viewProcInfo:sensitive in frame waitfram = no.
     1443       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1444       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1445       if  (   mWaitFramView
     1446          or  mWaitProcEvent)
     1447          and not mBatchMode
     1448       then
     1449          display
     1450             v-waitfram-action01 skip
     1451             v-waitfram-action02 skip
     1452             v-waitfram-action03 skip
     1453          with frame waitfram .
     1454       if     mWaitFramView
     1455          then do:
     1456             if     mWaitFramInterval ne ?
     1457                and not mBatchMode
     1458             then
     1459                wait-for go of frame waitfram pause mWaitFramInterval.
     1460          end.
     1461          else
     1462             if     mWaitProcEvent
     1463                and not mBatchMode
     1464             then
     1465                process events .
     1466     end.
     1467   end procedure.
     1468      procedure waitfram-show-this:
     1469         define input  parameter iInterval as int64 no-undo.
     1470         define variable vtime as int64 no-undo.
     1471         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1472         mWaitFramInterval = iInterval.
     1473         run waitfram-show (substitute("&1&2 &3&4" ,
     1474                                       mWaitFramTextBeg ,
     1475                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1476                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1477                                       mWaitFramTextEnd
     1478                                      )
     1479                           ).
     1480      end.
     1481      procedure WaitFramRunPause:
     1482         define input  parameter iInterval as dec no-undo.
     1483         define variable vStart  as datetime-tz no-undo.
     1484         define variable vend    as datetime-tz no-undo.
     1485         define variable vint as int64 no-undo.
     1486         define variable vOk as logical no-undo.
     1487         vStart = now.
     1488         vend   = vStart.
     1489         publish "WaitFramPause" (iInterval,output vOk).
     1490         vend   =  now.
     1491         vint = vend - vStart.
     1492         vint = iInterval - vint / 1000.
     1493         if     not mWaitFramStop
     1494            and (   vint > 0
     1495                 or (    not vOk
     1496                     and iInterval eq ?
     1497                     )
     1498                 )
     1499         then
     1500            run waitfram-show-this (iInterval).
     1501         vend   =  now.
     1502         vint = vend - vStart.
     1503         vint = iInterval - vint / 1000.
     1504         if     not mWaitFramStop
     1505            and vint > 0
     1506         then do:
     1507            run gbl/pause.p (vint * 1000).
     1508         end.
     1509         if iInterval ne ?
     1510         then
     1511            publish "WaitFramStop".
     1512         waitfram-check-timeout().
     1513      end.
     1514      procedure WaitFramWaitFor:
     1515         define input  parameter iInterval as dec no-undo.
     1516         assign
     1517            mWaitFramStartProc   = now
     1518            mWaitFramStopUser    = no
     1519            mWaitFramStopTimeOut = no
     1520         .
     1521         block-wait:
     1522         do while not mWaitFramStop:
     1523            run WaitFramRunPause (iInterval).
     1524            if  waitfram-check-timeout()
     1525            then do:
     1526               leave block-wait.
     1527            end.
     1528         end.
     1529         run waitfram-hide.
     1530      end.
     1531   procedure waitfram-join :
     1532     define input  parameter p-line-1  as character no-undo .
     1533     define input  parameter p-line-2  as character no-undo .
     1534     define input  parameter p-line-3  as character no-undo .
     1535     define output parameter p-message as character no-undo .
     1536     do
     1537     on error undo, return error return-value
     1538     :
     1539       assign
     1540         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1541                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1542                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1543       .
     1544     end.
     1545   end procedure.
     1546   function waitfram-join-function returns character
     1547     (input p-line-1 as character
     1548     ,input p-line-2 as character
     1549     ,input p-line-3 as character
     1550     ).
     1551     define variable v-message as character no-undo .
     1552     run waitfram-join in this-procedure
     1553       (input  p-line-1
     1554       ,input  p-line-2
     1555       ,input  p-line-3
     1556       ,output v-message
     1557       ) .
     1558     return v-message .
     1559   end function .
     1560   define buffer goods   for ub.goods  .
     1561   define buffer gds-obj for ub.gds-obj  .
     1562   define buffer clients for ub.clients  .
     1563   define variable ii like i init 0 no-undo .
     1564   define variable t#cat-id like stk-line.cat-id no-undo .
     1565   define variable t#Sum-type like stk-line.Sum-type no-undo .
     1566   define variable t#kol-rec-obj like i init 0  no-undo .
     1567   if Show-Negativ then null-fact-order = 0 .
     1568      else  null-fact-order = fact-order-1 .
     1569   for each obj-list no-lock :
     1570     t#kol-rec-obj = t#kol-rec-obj + 1.
     1571   End.
     1572   case type-stor  :
     1573     when 1 then  do:
     1574       Assign
     1575         t#cat-id   = '##':U
     1576         t#sum-type = 'cost':U  .
     1577     end.
     1578     when 2 then do:
     1579       Assign
     1580         t#cat-id   = 'prch':U
     1581         t#sum-type = 'cost':U + 'p':U .
     1582     end.
     1583     when 3 then do:
     1584       Assign
     1585         t#cat-id   = 'cacc':U
     1586         t#sum-type = 'cost':U + 'p':U .
     1587     end.
     1588     when 4 then do:
     1589       Assign
     1590         t#cat-id   = 'stor':U
     1591         t#sum-type = 'cost':U + 'p':U .
     1592     end.
     1593     when 5 then do:
     1594       Assign
     1595         t#cat-id   = 'cons':U
     1596         t#sum-type = 'cost':U + 'p':U .
     1597     end.
     1598   End case.
     1599   if xTogobj = false  then DO:
     1600     Case Select-Good :
     1601       when 1   then    RUN Run1-0.
     1602       when 2   then    run run2-0.
     1603       when 3  then    run run3-0.
     1604       otherwise do:
     1605           run run45-0.
     1606       end.
     1607     End case.
     1608   End.
     1609   Else do:
     1610     Case Select-Good :
     1611       when 1  then    RUN Run1.
     1612       when 2  then    run run2.
     1613       when 3 then    run run3.
     1614       otherwise do:
     1615         run run45.
     1616       end.
     1617     End case.
     1618   End.
     1619   procedure run1 :
     1620   CASE RetClassify :
     1621     when "no-classify":U then  DO:
     1622          For each obj-list no-lock :
     1623            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1624            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1625             For each post-stk-line  no-lock where
     1626                                               post-stk-line.obj-type = obj-list.obj-type and
     1627                                               post-stk-line.obj-code = obj-list.obj-code and
     1628                                               post-stk-line.fact-order >= null-fact-order   and
     1629                                               post-stk-line.fact-order <= fact-order-2   and
     1630                                               post-stk-line.sum-type    = 'cost':U    and
     1631                                               post-stk-line.cat-id      = '##':U
     1632                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1633                                               :
     1634                    find first  temp-t-post-stk-line where
     1635                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1636                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1637                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1638                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1639                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1640                      if not available  temp-t-post-stk-line then do:
     1641                         find first  ub.goods no-lock where
     1642                                               ub.goods.artic     = post-stk-line.artic     and
     1643                                               ub.goods.prod-type = post-stk-line.prod-type and
     1644                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1645                         find first  prod-cli no-lock  where
     1646                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1647                                                   prod-cli.obj-code = post-stk-line.prod-code
     1648                                                   no-error .
     1649                         find first  ub.clients  no-lock  where
     1650                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1651                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1652                           run create-temp-t-post-stk-line .
     1653                    end.
     1654                    else do:
     1655                            assign
     1656                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1657                            .
     1658                    end.
     1659             end.
     1660             For each temp-t-post-stk-line no-lock   ,
     1661                    Last temp-post-stk-line  where
     1662                         temp-post-stk-line.fact-order <= fact-order-2   and
     1663                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1664                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1665                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1666                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1667                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1668                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1669                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1670                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1671                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1672                         no-lock
     1673                         on error undo , next
     1674                         break
     1675                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1676                         By goods.gds-code
     1677                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1678                         By Temp-t-post-stk-line.Fact-order
     1679                        :
     1680                 if NOT(Sums-Only = true ) then DO:
     1681                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1682                 End.
     1683                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1684                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1685                                            run display-line .
     1686                                       End.
     1687                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1688             End.
     1689            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1690           .
     1691          End.
     1692     End.
     1693     when "grp-goods":U  then     DO:
     1694       if xLavel = 0 THEN  DO:
     1695          For each obj-list no-lock :
     1696            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1697            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1698             For each post-stk-line  no-lock where
     1699                                               post-stk-line.obj-type = obj-list.obj-type and
     1700                                               post-stk-line.obj-code = obj-list.obj-code and
     1701                                               post-stk-line.fact-order >= null-fact-order   and
     1702                                               post-stk-line.fact-order <= fact-order-2   and
     1703                                               post-stk-line.sum-type    = 'cost':U    and
     1704                                               post-stk-line.cat-id      = '##':U
     1705                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1706                                               :
     1707                    find first  temp-t-post-stk-line where
     1708                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1709                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1710                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1711                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1712                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1713                      if not available  temp-t-post-stk-line then do:
     1714                         find first  ub.goods no-lock where
     1715                                               ub.goods.artic     = post-stk-line.artic     and
     1716                                               ub.goods.prod-type = post-stk-line.prod-type and
     1717                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1718                         find first  prod-cli no-lock  where
     1719                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1720                                                   prod-cli.obj-code = post-stk-line.prod-code
     1721                                                   no-error .
     1722                         find first  ub.clients  no-lock  where
     1723                                                   ub.clients.obj-type = post-stk-line.cli-type and
     1724                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     1725                           run create-temp-t-post-stk-line .
     1726                    end.
     1727                    else do:
     1728                            assign
     1729                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     1730                            .
     1731                    end.
     1732             end.
     1733             For each temp-t-post-stk-line no-lock   ,
     1734                    Last temp-post-stk-line  where
     1735                         temp-post-stk-line.fact-order <= fact-order-2   and
     1736                         temp-post-stk-line.cat-id     =  t#cat-id      and
     1737                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     1738                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     1739                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     1740                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
     1741                         temp-post-stk-line.obj-type   =  temp-t-post-stk-line.obj-type    and
     1742                         temp-post-stk-line.obj-code   =  temp-t-post-stk-line.obj-code and
     1743                         temp-post-stk-line.cli-type   =  temp-t-post-stk-line.cli-type  and
     1744                         temp-post-stk-line.cli-code   =  temp-t-post-stk-line.cli-code
     1745                         no-lock
     1746                         on error undo , next
     1747                         break
     1748                         BY
     1749                             temp-t-post-stk-line.goods-grp-name
     1750                         By ((temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)))
     1751                         By goods.gds-code
     1752                         By ((temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)))
     1753                         By Temp-t-post-stk-line.Fact-order
     1754                        :
     1755                  if first-of(  temp-t-post-stk-line.goods-grp-name  )  Then DO : run print-header (1, temp-t-post-stk-line.goods-grp-name ). end.
     1756                 if NOT(Sums-Only = true ) then DO:
     1757                     if first-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-header ( 3,temp-t-post-stk-line.clients-obj-name). end.
     1758                 End.
     1759                                       if first-of( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-start. end .
     1760                                       if last-of ( (temp-t-post-stk-line.artic + temp-t-post-stk-line.prod-type + string(temp-t-post-stk-line.prod-code)) ) then do : run goods-end.
     1761                                            run display-line .
     1762                                       End.
     1763                     if last-of( (temp-t-post-stk-line.cli-type + string(temp-t-post-stk-line.cli-code)) ) Then DO : run print-footer ( 3 , temp-t-post-stk-line.clients-obj-name). end.
     1764                 if last-of( temp-t-post-stk-line.goods-grp-name )  then do : run print-footer ( 1, temp-t-post-stk-line.goods-grp-name ). end.
     1765             End.
     1766            if t#kol-rec-obj > 1 THEN run print-footer ( 0, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1767           .
     1768          End.
     1769       End.
     1770       Else DO:
     1771          For each obj-list no-lock :
     1772            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     1773            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     1774             For each post-stk-line  no-lock where
     1775                                               post-stk-line.obj-type = obj-list.obj-type and
     1776                                               post-stk-line.obj-code = obj-list.obj-code and
     1777                                               post-stk-line.fact-order >= null-fact-order   and
     1778                                               post-stk-line.fact-order <= fact-order-2   and
     1779                                               post-stk-line.sum-type    = 'cost':U    and
     1780                                               post-stk-line.cat-id      = '##':U
     1781                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     1782                                               :
     1783                    find first  temp-t-post-stk-line where
     1784                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     1785                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     1786                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     1787                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     1788                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     1789                      if not available  temp-t-post-stk-line then do:
     1790                         find first  ub.goods no-lock where
     1791                                               ub.goods.artic     = post-stk-line.artic     and
     1792                                               ub.goods.prod-type = post-stk-line.prod-type and
     1793                                               ub.goods.prod-code = post-stk-line.prod-code no-error .
     1794                         find first  prod-cli no-lock  where
     1795                                                   prod-cli.obj-type = post-stk-line.prod-type and
     1796                                                   prod-cli.obj-code = post-stk-line.prod-code
