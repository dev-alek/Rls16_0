     4171   define input parameter N as integer no-undo .
     4172   define input parameter Name as char no-undo .
     4173   PUT stream  OutStream  UNFORMATTED trim(Name) AT ((N - 1) * 10 ) format "x(100)" skip.
     4174   if Make-Excel then  put   stream ForExcel unformatted fill(" " + CHR(9), N - 1) trim(Name) skip.
     4175   END PROCEDURE.
