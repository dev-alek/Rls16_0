     4503   PROCEDURE display-line :
     4504     i = i + 1.
     4505   If Integer(200) = 0 Then Temp1  = 100  .
     4506                         Else Temp1 = Integer(200) .
     4507        IF ( i modulo Temp1 = 0 ) AND ( i >= Temp1 ) then
     4508            RUN waitfram-show( "Обработано строк : " + string( i )) .
     4509     Run Clear-item.
     4510       assign
     4511             gds-zap-gds-name = if g#gds-engl then Goods.engl-name else Goods.gds-name
     4512             gds-zap-unit-base  = Goods.unit-base
     4513             gds-zap-prt-root   = Goods.prt-root
     4514             gds-zap-prod-type  = Goods.prod-type
     4515             gds-zap-prod-code  = Goods.prod-code
     4516             gds-zap-artic      = Goods.artic
     4517             gds-zap-grp-name   = Goods.grp-name
     4518             gds-zap-b-code     = Goods.gds-code
     4519             gds-zap-type       = Goods.gds-type
     4520             pos-cli-type       = ub.clients.obj-type
     4521             pos-cli-code       = ub.clients.obj-code
     4522             pos-cli-grp-name   = ub.clients.grp-name.
     4523      if Show-Cost Then  RUN ob-line (
     4524                post-stk-line.obj-code    ,
     4525                post-stk-line.obj-type    ,
     4526                post-stk-line.cli-code    ,
     4527                post-stk-line.cli-type    ,
     4528                post-stk-line.artic       ,
     4529                post-stk-line.prod-code   ,
     4530                post-stk-line.prod-type   ,
     4531                Fact-order-1   ,
     4532                Fact-order-2   ,
     4533                'cost':U    ,
     4534                '##,##':U ,
     4535                ""             ,
     4536                yes) .
     4537      if Show-Sale Then  RUN ob-line (
     4538                post-stk-line.obj-code    ,
     4539                post-stk-line.obj-type    ,
     4540                post-stk-line.cli-code    ,
     4541                post-stk-line.cli-type    ,
     4542                post-stk-line.artic       ,
     4543                post-stk-line.prod-code   ,
     4544                post-stk-line.prod-type   ,
     4545                Fact-order-1   ,
     4546                Fact-order-2   ,
     4547                'sale':U    ,
     4548                '##,##':U ,
     4549                ""             ,
     4550                yes) .
     4551            Run Display-str1.
     4552            Run Clear-item.
     4553     END PROCEDURE.
     4554   PROCEDURE display-str1  :
     4555        Run di-qnty ("кол-во", 1, gds-zap-b-code,gds-zap-artic,gds-zap-gds-name,gds-zap-unit-base,"").
     4556            if Show-Cost Then DO : Run di ( "учет." , 2, "","","","","" ).  End.
     4557            if Show-Sale Then DO : Run di ( "док-т.", 8, "","","","","" ).  End.
     4558   END PROCEDURE.
     4559   PROCEDURE Di :
     4560   define input parameter p1 as char no-undo.
     4561   define input parameter p2 as int no-undo.
     4562   define input parameter p3 as char no-undo.
     4563   define input parameter p4 as char no-undo.
     4564   define input parameter p5 as char no-undo.
     4565   define input parameter p6 as char no-undo.
     4566   define input parameter p7 as char no-undo.
     4567    CASE CAPS(p7) :
     4568      End case.
     4569                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4570    END PROCEDURE.
     4571   PROCEDURE Di-qnty :
     4572   define input parameter p1 as char no-undo.
     4573   define input parameter p2 as int no-undo.
     4574   define input parameter p3 as char no-undo.
     4575   define input parameter p4 as char no-undo.
     4576   define input parameter p5 as char no-undo.
     4577   define input parameter p6 as char no-undo.
     4578   define input parameter p7 as char no-undo.
     4579    CASE CAPS(p7) :
     4580      End case.
     4581                  DOWN stream   OutStream 1 with FRAME ZAPAS.
     4582    END PROCEDURE.
     4583   procedure Print-Footer :
     4584   define input parameter N as integer no-undo .
     4585   define input parameter Name as char no-undo .
     4586       PUT stream  OutStream  UNFORMATTED    "Итого по : " + trim(Name) AT ((N - 1) * 10 ) format "x(100)"  chr(10).
     4587       if Make-Excel then  put   stream ForExcel unformatted  "Итого по : " +  trim(Name) chr(10).
     4588    END PROCEDURE.
     4589   PROCEDURE Clear-item :
     4590    END PROCEDURE.
     4591   PROCEDURE ob-line :
     4592   define input  parameter x-store-code     like ub.clients.obj-code          no-undo.
     4593   define input  parameter x-store-type     like ub.clients.obj-type          no-undo.
     4594   define input  parameter x-cli-code       like ub.clients.obj-code          no-undo.
     4595   define input  parameter x-cli-type       like ub.clients.obj-type          no-undo.
     4596   define INPUT  parameter x-artic          like post-ot-line.artic        no-undo.
     4597   define INPUT  parameter x-prod-code      like post-ot-line.prod-code    no-undo.
     4598   define INPUT  parameter x-prod-type      like post-ot-line.prod-type    no-undo.
     4599   define INPUT  parameter x-Fact-order-1   like post-ot-line.Fact-order   no-undo.
     4600   define INPUT  parameter x-Fact-order-2   like post-ot-line.Fact-order   no-undo.
     4601   define input  parameter x-sum-type       like post-ot-line.sum-type     no-undo.
     4602   define input  parameter x-cat-id         like post-ot-line.cat-id       no-undo.
     4603   define input  parameter x-ext-doc-type   like post-ot-line.ext-doc-type no-undo.
     4604   define input  parameter xTog-obj         as logical no-undo .
     4605   define variable tt# as int no-undo .
     4606    if (x-sum-type = 'cost':U  or x-sum-type = 'cssr':U) then tt# = 0.
     4607    if (x-sum-type = 'crsa':U  or x-sum-type = 'cgsr':U) then tt# = 3.
     4608    if (x-sum-type = 'sale':U  or x-sum-type = 'sasr':U) then tt# = 6.
     4609        FOR each post-ot-line where
     4610                 post-ot-line.artic        = x-artic
     4611           AND   post-ot-line.fact-order  <= x-fact-order-2
     4612           AND   post-ot-line.fact-order  >= x-fact-order-1
     4613           AND   post-ot-line.obj-code     = x-store-code
     4614           AND   post-ot-line.obj-type     = x-store-type
     4615           AND   post-ot-line.prod-code    = x-prod-code
     4616           AND   post-ot-line.prod-type    = x-prod-type
     4617           AND   post-ot-line.cli-code     = x-cli-code
     4618           AND   post-ot-line.cli-type     = x-cli-type
     4619           AND   post-ot-line.sum-type     = x-sum-type   no-lock :
     4620       CASE post-ot-line.ext-doc-type:
     4621                WHEN        'ie':U      THEN     DO:
     4622              ASSIGN prih[1 + tt#]   = prih[1 + tt#]   +  post-ot-line.fact-qnty
     4623                     prih[2 + tt#]   = prih[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4624                     prih[3 + tt#]   = prih[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4625                    End.
     4626                WHEN       'ee':U       THEN     DO:
     4627              ASSIGN rash[1 + tt#]   = rash[1 + tt#]   +  post-ot-line.fact-qnty
     4628                     rash[2 + tt#]   = rash[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4629                     rash[3 + tt#]   = rash[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4630                    End.
     4631                WHEN        're':U  THEN     DO:
     4632              ASSIGN vzvr[1 + tt#]        = vzvr[1 + tt#]   +  post-ot-line.fact-qnty
     4633                     vzvr[2 + tt#]   = vzvr[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4634                     vzvr[3 + tt#]   = vzvr[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base .
     4635                    End.
     4636                WHEN       'ep':U    THEN     DO:
     4637              ASSIGN vzvr-post[1 + tt#]   = vzvr-post[1 + tt#]   +  post-ot-line.fact-qnty
     4638                     vzvr-post[2 + tt#]   = vzvr-post[2 + tt#]   +  if tprintrubl then post-ot-line.sum-rubl else post-ot-line.sum-base
     4639                     vzvr-post[3 + tt#]   = vzvr-post[3 + tt#]   +  if tprintrubl then post-ot-line.vat-rubl else post-ot-line.vat-base  .
     4640                    End.
     4641                WHEN       'ot':U THEN   DO:
     4642                     End.
     4643             End CASE.
     4644      End.
     4645   END PROCEDURE.
     4646   procedure tmp-assign :
     4647   end procedure.
     4648   procedure tmp-clear :
     4649   end procedure.
     4650   procedure tmp-create :
     4651   define input parameter p-cli-code as integer   no-undo .
     4652   define input parameter p-cli-type as character no-undo .
     4653   define input parameter p-cli-name as character no-undo .
     4654   define input parameter p-obj-code as integer   no-undo .
     4655   define input parameter p-obj-type as character no-undo .
     4656   end procedure.
