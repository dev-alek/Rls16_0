     3529   procedure run45 :
     3530   CASE RetClassify :
     3531     when "no-classify":U  then   DO:
     3532          For each obj-list no-lock :
     3533            for each temp-t-post-stk-line : delete temp-t-post-stk-line. end.
     3534            if t#kol-rec-obj > 1 THEN run print-header (1, '(' + obj-list.obj-type + ' ' + trim(string(obj-list.obj-code)) + ') ' + obj-list.obj-name).
     3535             For each post-stk-line  no-lock where
     3536                                               post-stk-line.obj-type = obj-list.obj-type and
     3537                                               post-stk-line.obj-code = obj-list.obj-code and
     3538                                               post-stk-line.fact-order >= null-fact-order   and
     3539                                               post-stk-line.fact-order <= fact-order-2   and
     3540                                               post-stk-line.sum-type    = 'cost':U    and
     3541                                               post-stk-line.cat-id      = '##':U
     3542                                               and can-find(first g#post  where  post-stk-line.cli-type = g#post.obj-type and  post-stk-line.cli-code = g#post.obj-code ) = TRUE
     3543                                               ,
     3544                    each ub.goods no-lock where
     3545                                               ub.goods.artic     = post-stk-line.artic     and
     3546                                               ub.goods.prod-type = post-stk-line.prod-type and
     3547                                               ub.goods.prod-code = post-stk-line.prod-code  and  can-find(first gds-list where  ub.goods.gds-code = gds-list.gds-code ) = TRUE
     3548                                               :
     3549                    find first  temp-t-post-stk-line where
     3550                      temp-t-post-stk-line.cli-type  = post-stk-line.cli-type  and
     3551                      temp-t-post-stk-line.cli-code  = post-stk-line.cli-code   and
     3552                      temp-t-post-stk-line.artic     = post-stk-line.artic     and
     3553                      temp-t-post-stk-line.prod-type = post-stk-line.prod-type and
     3554                      temp-t-post-stk-line.prod-code = post-stk-line.prod-code no-lock no-error .
     3555                      if not available  temp-t-post-stk-line then do:
     3556                         find first  prod-cli no-lock  where
     3557                                                   prod-cli.obj-type = post-stk-line.prod-type and
     3558                                                   prod-cli.obj-code = post-stk-line.prod-code
     3559                                                   no-error .
     3560                         find first  ub.clients  no-lock  where
     3561                                                   ub.clients.obj-type = post-stk-line.cli-type and
     3562                                                   ub.clients.obj-code = post-stk-line.cli-code no-error .
     3563                           run create-temp-t-post-stk-line .
     3564                    end.
     3565                    else do:
     3566                            assign
     3567                              temp-t-post-stk-line.fact-order = post-stk-line.fact-order  .
     3568                            .
     3569                    end.
     3570             end.
     3571             For each temp-t-post-stk-line no-lock   ,
     3572                    Last temp-post-stk-line  where
     3573                         temp-post-stk-line.fact-order <= fact-order-2   and
     3574                         temp-post-stk-line.cat-id     =  t#cat-id      and
     3575                         temp-post-stk-line.Sum-type   =  t#sum-type    and
     3576                         temp-post-stk-line.artic      =  temp-t-post-stk-line.artic       and
     3577                         temp-post-stk-line.prod-type  =  temp-t-post-stk-line.prod-type   and
     3578                         temp-post-stk-line.prod-code  =  temp-t-post-stk-line.prod-code   and
