      317           view-as alert-box error.
      318           return error.
      319       END.
      320     END CASE.
      321     if varcont5 = yes then do:
      322       if integer( substring( tmp-str5, 1, length( pl-pfx ) ) ) <> 0
      323       then do:
      324         message
      325           "Невозможно сформировать бар-код" SKIP
      326           "для товара с кодом: " internal-b-code
      327           view-as alert-box error title "подрезание кода".
      328         return error.
      329       end.
      330       else do:
      331         assign
      332           full-b-code = pl-pfx + substring( tmp-str5, length( pl-pfx ) + 1, length( tmp-str5 ) - length( pl-pfx ) )
      333           len-code5    = length( full-b-code )
      334         .
      335         define variable v-sum-char5 as character no-undo .
      336         assign
      337           sum5 = 0
      338         .
      339         do i5 = 1 to len-code5 by 2
      340         :
      341           assign
      342             v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      343           .
      344           if v-sum-char5 < "0"
      345           or v-sum-char5 > "9"
      346           then do:
      347             message
      348               "Невозможно сформировать бар-код" skip
      349               "для товара с кодом: " internal-b-code skip
      350               view-as alert-box error title "подсчет контрольной суммы".
      351             return error.
      352           end.
      353           assign
      354             sum5 = sum5 + integer(v-sum-char5)
      355           .
      356         end.
      357         if varcont5 = yes then do:
      358           assign
      359             sum5 = sum5 * 3
      360           .
      361           do i5 = 2 to len-code5 by 2
      362           :
      363             assign
      364               v-sum-char5 = substr(full-b-code, len-code5 - i5 + 1, 1)
      365             .
      366             if v-sum-char5 < "0"
      367             or v-sum-char5 > "9"
      368             then do:
      369               message
      370                 "Невозможно сформировать бар-код" skip
      371                 "для товара с кодом: " internal-b-code skip
      372                 view-as alert-box error title "подсчет контрольной суммы".
      373               return error.
      374             end.
      375             assign
      376               sum5 = sum5 + integer(v-sum-char5)
      377             .
      378           end.
      379           if varcont5 = yes then do:
      380              if sum5 mod 10 = 0 then do:
      381                assign
      382                  full-b-code = full-b-code + '0'
      383                .
      384              end.
      385              else do:
      386                assign
      387                  full-b-code = full-b-code + string(10 - sum5 mod 10)
      388                .
      389              end.
      390           end.
      391         end.
      392       end.
      393     end.
      394   END PROCEDURE.
