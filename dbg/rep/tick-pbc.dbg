      445     ,output tmp-var
      446     ,output type-par
      447     ) no-error .
      448   case p-obj-type :
      449     when 'скл':U then do:
      450       find first new-prn_store where new-prn_store.obj-code = p-obj-code no-lock.
      451       assign
      452         v-cntxp-doc-prt         = (tmp-var = "yes") and new-prn_store.doc-prt
      453         .
      454     end.
