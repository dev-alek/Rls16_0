      456       find first new-prn_shop where new-prn_shop.obj-code = p-obj-code no-lock.
      457       assign
      458         v-cntxp-doc-prt         = (tmp-var = "yes") and new-prn_shop.doc-prt
      459         .
      460     end.
      461   end case.
