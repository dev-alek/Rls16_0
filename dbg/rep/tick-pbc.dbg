      159   def new shared var bc-frmt as character no-undo .
      160   def new shared var bc-pfx  as character no-undo .
      161   def var bc-par-type as character no-undo .
      162       run gbl/conf-rd.p ("bc-frmt", "", "", 0, "", "", "",  no , output bc-frmt, output bc-par-type) no-error.
      163       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U OR not can-do ("EAN8,EAN13", bc-frmt) ) then
      164           do:
      165               message "Не задан или не верно задан ТИП собственного бар-кода!"
      166                   view-as alert-box ERROR TITLE "".
      167               return error.
      168           end.
      169       run gbl/conf-rd.p ("bc-pfx", "", "", 0, "", "", "",  no , output bc-pfx, output bc-par-type) no-error.
      170       if "new" = "bc" AND ( error-status:error OR bc-par-type <> "C":U ) then
      171           do:
      172               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      173                   view-as alert-box ERROR TITLE "".
      174               return error.
      175           end.
      176   PROCEDURE gen-bc:
      177     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      178     def output parameter full-b-code     as character init ""    no-undo .
      179   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      180     define variable tmp-str4  as character no-undo.
      181     define variable tmp-num4  as character no-undo.
      182     define variable i4        as integer   no-undo.
      183     define variable sum4      as integer   no-undo.
      184     define variable len-code4 as integer   no-undo.
      185     define variable varcont4  as logical   initial yes no-undo.
      186     CASE bc-frmt :
      187       WHEN "EAN13" THEN do:
      188         assign
      189           tmp-str4 = string( internal-b-code, "999999999999" )
      190         .
      191       end.
      192       WHEN "EAN8" THEN do:
      193         assign
      194           tmp-str4 = string( internal-b-code, "9999999" )
      195         .
      196       end.
      197       OTHERWISE DO:
      198           message "Неизвестный тип генерации бар-кода процедурой bc-gnrti.i: " bc-frmt " ."
      199           view-as alert-box error.
      200           return error.
      201       END.
      202     END CASE.
      203     if varcont4 = yes then do:
      204       if integer( substring( tmp-str4, 1, length( bc-pfx ) ) ) <> 0
      205       then do:
      206         message
      207           "Невозможно сформировать бар-код" SKIP
      208           "для товара с кодом: " internal-b-code
      209           view-as alert-box error title "подрезание кода".
      210         return error.
      211       end.
      212       else do:
      213         assign
      214           full-b-code = bc-pfx + substring( tmp-str4, length( bc-pfx ) + 1, length( tmp-str4 ) - length( bc-pfx ) )
      215           len-code4    = length( full-b-code )
      216         .
      217         define variable v-sum-char4 as character no-undo .
      218         assign
      219           sum4 = 0
      220         .
      221         do i4 = 1 to len-code4 by 2
      222         :
      223           assign
      224             v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      225           .
      226           if v-sum-char4 < "0"
      227           or v-sum-char4 > "9"
      228           then do:
      229             message
      230               "Невозможно сформировать бар-код" skip
      231               "для товара с кодом: " internal-b-code skip
      232               view-as alert-box error title "подсчет контрольной суммы".
      233             return error.
      234           end.
      235           assign
      236             sum4 = sum4 + integer(v-sum-char4)
      237           .
      238         end.
      239         if varcont4 = yes then do:
      240           assign
      241             sum4 = sum4 * 3
      242           .
      243           do i4 = 2 to len-code4 by 2
      244           :
      245             assign
      246               v-sum-char4 = substr(full-b-code, len-code4 - i4 + 1, 1)
      247             .
      248             if v-sum-char4 < "0"
      249             or v-sum-char4 > "9"
      250             then do:
      251               message
      252                 "Невозможно сформировать бар-код" skip
      253                 "для товара с кодом: " internal-b-code skip
      254                 view-as alert-box error title "подсчет контрольной суммы".
      255               return error.
      256             end.
      257             assign
      258               sum4 = sum4 + integer(v-sum-char4)
      259             .
      260           end.
      261           if varcont4 = yes then do:
      262              if sum4 mod 10 = 0 then do:
      263                assign
      264                  full-b-code = full-b-code + '0'
      265                .
      266              end.
      267              else do:
      268                assign
      269                  full-b-code = full-b-code + string(10 - sum4 mod 10)
      270                .
      271              end.
      272           end.
      273         end.
      274       end.
      275     end.
      276   END PROCEDURE.
      277   def new shared var pl-frmt as character no-undo .
      278   def new shared var pl-pfx  as character no-undo .
      279   def var pl-par-type as character no-undo .
      280       run gbl/conf-rd.p ("pl-frmt", "", "", 0, "", "", "",  no , output pl-frmt, output pl-par-type) no-error.
      281       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U OR not can-do ("EAN8,EAN13", pl-frmt) ) then
      282           do:
      283               message "Не задан или не верно задан ТИП собственного бар-кода!"
      284                   view-as alert-box ERROR TITLE "".
      285               return error.
      286           end.
      287       run gbl/conf-rd.p ("pl-pfx", "", "", 0, "", "", "",  no , output pl-pfx, output pl-par-type) no-error.
      288       if "new" = "bc" AND ( error-status:error OR pl-par-type <> "C":U ) then
      289           do:
      290               message "Не задан или не верно задан ПРЕФИКС бар-кода складского места!"
      291                   view-as alert-box ERROR TITLE "".
      292               return error.
      293           end.
      294   PROCEDURE gen-pl:
      295     def input  parameter internal-b-code like ub.bar-code.b-code no-undo .
      296     def output parameter full-b-code     as character init ""    no-undo .
      297   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      298     define variable tmp-str5  as character no-undo.
      299     define variable tmp-num5  as character no-undo.
