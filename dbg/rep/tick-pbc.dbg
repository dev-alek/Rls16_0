      486     "Неверное значение параметра prod-bc-rid" prod-bc-rid skip
      487     "или параметра p-b-code" p-b-code
      488     view-as alert-box error .
      489     return error.
      490   end.
      491   define variable how-pcnt-kat as character no-undo .
      492   define variable dflt-cd as character no-undo .
      493   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      494   define variable v-param-type8 as character no-undo .
      495   define variable v-value-date8 as date no-undo .
      496   define variable v-value-decimal8 as decimal no-undo .
      497   define variable v-value-integer8 as INTEGER no-undo .
      498   define variable v-value-logical8 AS LOGICAL no-undo .
      499   define variable v-tth8 as handle no-undo .
      500   define variable v-host-code8 as integer no-undo .
      501   define buffer buf_dis-thbj-rule8 for ub.dis-thbj-rule.
      502   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      503   define variable v-param-type9 as character no-undo .
      504   define variable v-value-date9 as date no-undo .
      505   define variable v-value-decimal9 as decimal no-undo .
      506   define variable v-value-integer9 as INTEGER no-undo .
      507   define variable v-value-logical9 AS LOGICAL no-undo .
      508   define variable v-tth9 as handle no-undo .
      509   run adm/shattri.p (
      510       input "get":U
      511       ,input  p-obj-type
      512       ,input  p-obj-code
      513       ,input  'cd-sending':U
      514       ,input  'dflt-cd':U
      515       ,output dflt-cd
      516       ,output v-value-date9
      517       ,output v-value-decimal9
      518       ,output v-value-integer9
      519       ,output v-value-logical9
      520       ,output v-param-type9
      521       ,INPUT-OUTPUT table-handle v-tth9
      522       )  .
      523   delete object v-tth9 no-error.
      524   how-pcnt-kat = ''.
      525   run adm/shattri.p (
      526       input "get":U
      527       ,input  p-obj-type
      528       ,input  p-obj-code
      529       ,input  'cd-inf-send':U
      530       ,input  'how-pcnt-kat':U
      531       ,output how-pcnt-kat
      532       ,output v-value-date8
      533       ,output v-value-decimal8
      534       ,output v-value-integer8
      535       ,output v-value-logical8
      536       ,output v-param-type8
      537       ,INPUT-OUTPUT table-handle v-tth8
      538       ) no-error .
      539   delete object v-tth8.
      540   if how-pcnt-kat = 'pcnt-kat-pdf':U then do:
      541     find first  buf_dis-thbj-rule8 No-LOCK  where
      542                 buf_dis-thbj-rule8.obj-type = p-obj-type
      543           AND  buf_dis-thbj-rule8.obj-code = p-obj-code
      544           and  buf_dis-thbj-rule8.pos-type = dflt-cd
      545           and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      546           and  buf_dis-thbj-rule8.nonunique = ''
      547           no-error .
      548     if not available buf_dis-thbj-rule8 then do:
      549   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      550   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
      551     (input  p-obj-type
      552     ,input  p-obj-code
      553     ,output v-host-code8
      554     )  .
      555       find first  buf_dis-thbj-rule8 No-LOCK  where
      556                   buf_dis-thbj-rule8.obj-code = v-host-code8
      557             AND  buf_dis-thbj-rule8.obj-type = 'орг':U
      558             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      559             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      560             and  buf_dis-thbj-rule8.nonunique = ''
      561             no-error .
      562     end.
      563     if not available buf_dis-thbj-rule8 then do:
      564       find first  buf_dis-thbj-rule8 No-LOCK  where
      565                   buf_dis-thbj-rule8.obj-code = 0
      566             AND  buf_dis-thbj-rule8.obj-type = ''
      567             and  buf_dis-thbj-rule8.pos-type = dflt-cd
      568             and  buf_dis-thbj-rule8.discnt-role = 'pcnt-kat-pdf':U
      569             and  buf_dis-thbj-rule8.nonunique = ''
      570             no-error .
      571     end.
      572     if available buf_dis-thbj-rule8 then do:
      573       how-pcnt-kat = how-pcnt-kat + "=" + string(buf_dis-thbj-rule8.rule-num).
      574     end.
      575     else do:
      576       how-pcnt-kat = how-pcnt-kat + "="  + string(0).
      577     end.
      578   end.
      579   FIND ub.bar-code WHERE
      580        ub.bar-code.b-code = p-b-code NO-LOCK.
      581   FIND ub.goods WHERE
      582        ub.goods.gds-code = ub.bar-code.gds-code NO-LOCK.
      583   FIND ub.gds-prt WHERE ub.gds-prt.upper-code = ub.goods.prt-root NO-LOCK.
      584   assign rootnode_code = ub.gds-prt.node-code.
      585   FIND ub.gds-prt WHERE ub.gds-prt.node-code = ub.bar-code.node-code NO-LOCK.
      586   assign
      587   Action = "PROD-BC"
      588   v-bc-type = "main":U
      589   v-bc-type = (if ub.bar-code.in-code <> ""
      590                then "part":U
      591                else  (if ub.goods.unit-base <> ub.bar-code.unit-cli
      592                       then "subs"
      593                       else v-bc-type)
      594                )
      595   ListProdbc = buf_prod-bc.b-str
      596   .
      597   DEFINE VARIABLE b-count as integer init 0 no-undo.
      598   DEFINE VARIABLE v-fact-order        like ub.trn-doc.fact-order     no-undo.
      599   run rep/tickets.w (input parparentproc, input p-obj-type, input p-obj-code, input Action, input v-bc-type ).
      600   if TicketName = "" then
      601       RETURN.
      602   OUTPUT STREAM OutStream TO VALUE( lbc-tmp + "title" ) CONVERT TARGET TitleCP PAGE-SIZE 0 .
      603   run rep/ticket.p (
      604                  buffer ub.goods
      605                 ,buffer ub.bar-code
      606                 ,buffer ub.scales-gds
      607                 ,input p-obj-type
      608                 ,input p-obj-code
      609                 ,input Action
      610                 ,input rootnode_code
      611                 ,input TickOnw
      612                 ,input TickOnN
      613                 ,input QntyType
      614                 ,input PriceType
      615                 ,input scaleprice
      616                 ,input nakl-qnty
      617                 ,input list-qnty
      618                 ,input pr-doc-rubl
      619                 ,input pr-doc-rb
      620                 ,input pr-doc-rubl-old
      621                 ,input pr-doc-rb-old
      622                 ,input v-fact-order
      623                 ,input ListProdBc
      624                 ,input curr-rate
      625                 ,input TickPS
      626                 ,input dflt-cd
      627                 ,input how-pcnt-kat
      628                 ,input-output b-count
      629                 ,input v-part-code
      630                 ,input v-doc-code
      631                 ,input v-promo-code
      632                 ,input v-ActionId
      633                 ,input v-db-num
      634                 ) no-error .
      635   def var vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      636   OUTPUT STREAM OutStream CLOSE.
      637   message
      638     substitute( "Передано на печать &1 этикеток (ценников)", b-count )
      639     view-as alert-box INFORMATION.
      640   os-command NO-WAIT value( substitute( "start &1run-lbc.bat &1 &2title &3 &4", lbc-path, lbc-tmp, TicketName, v-user-id ) ).
