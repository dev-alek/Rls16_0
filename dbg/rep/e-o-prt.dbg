     1638   run cur-time in this-procedure ( output v-today
     1639                                  , output v-time
     1640                                  ).
     1641         if x-SelectGood = 1 Then DO:
     1642             If x-SET_val_TYPE = 1
     1643               then DO :
     1644                   run rep/r-o-prt5.p
     1645                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero) .
     1646                   End.
     1647               Else do:
     1648                   run rep/r-o-prt6.p
     1649                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero) .
     1650                   End.
     1651         End.
     1652         Else DO:
     1653             If x-SET_val_TYPE = 1
     1654               then do:
     1655                   run rep/r-o-prt7.p
     1656                       (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero) .
     1657                   End.
     1658               Else do:
     1659                   run rep/r-o-prt8.p
     1660                      (input v-cntxt-obj-code ,  input v-cntxt-obj-type ,  input base-type ,  input base-code ,  input Classify,  input Itog, input tog-zero) .
     1661                   End.
     1662         End.
     1663   END PROCEDURE.
     1664   PROCEDURE my-var :
     1665   assign frame F-Main
     1666    ie
     1667    ee
     1668    ep
     1669    es
     1670    re
     1671    rs
     1672    we
     1673    vt
     1674    iv
     1675    ev
     1676    rv
     1677    em
     1678    wm
     1679    im
     1680    ot
     1681    Classify itog tog-zero ShowZero-3.
     1682   v-show-all-goods  = ShowZero-3 .
     1683   run cur-time in this-procedure ( output v-today
     1684                                  , output v-time
     1685                                  ).
     1686   if tog-zero = true and x-date-end <> v-today then do:
     1687     tog-zero = false.
     1688     disable  tog-zero with frame F-Main.
     1689     display  tog-zero with frame F-Main.
     1690   end.
     1691   else do:
     1692     display  tog-zero with frame F-Main.
     1693   end.
     1694   run p-val in this-procedure.
     1695   ReportHeader =  "Оборот (выборочно) по типам документов : "  + chr(10).
     1696   ReportHeader = (ReportHeader) + IF  ie THen      String(ie:label) + ","  else "" .
     1697   ReportHeader = (ReportHeader) + IF  ee then      String(ee:label) + ","  else "".
     1698   ReportHeader = (ReportHeader) + IF  ep then      String(ep:label) + ","  else "".
     1699   ReportHeader = (ReportHeader) + IF  es THen      String(es:label) + ","  else "".
     1700   ReportHeader = (ReportHeader) + IF  re then      String(re:label) + ","  else "".
     1701   ReportHeader = (ReportHeader) + IF  rs then      String(rs:label) + ","  else "".
     1702   ReportHeader = (ReportHeader) + IF  we THen      String(we:label) + ","  else "".
     1703   ReportHeader = (ReportHeader) + IF  vt then      String(vt:label) + " с учетом корр.уч.цены,"  else "".
     1704   ReportHeader = (ReportHeader) + IF  iv then      String(iv:label) + ","  else "".
     1705   ReportHeader = (ReportHeader) + IF  ev THen      String(ev:label) + ","  else "".
     1706   ReportHeader = (ReportHeader) + chr(10).
     1707   ReportHeader = (ReportHeader) + IF  rv then      String(rv:label) + ","  else "".
     1708   ReportHeader = (ReportHeader) + IF  em then      String(em:label) + ","  else "" .
     1709   ReportHeader = (ReportHeader) + IF  wm THen      wm:label + ","  else "" .
     1710   ReportHeader = (ReportHeader) + IF  im then      im:label + ","  else "".
     1711   ReportHeader = (ReportHeader) + IF  ot then      ot:label        else "" .
     1712   if tog-zero then ReportHeader = (ReportHeader) +  chr(10) + 'с нулевыми оборотами '.
     1713   if ShowZero-3 then ReportHeader = (ReportHeader) +  chr(10) + 'все выбранные товары '.
     1714   Sheetf.Excel-Column-Lable =
     1715        "N п\п,Код,Артикул,Название товара ,Оборот выборочно,,,,,Весь оборот за период,,,Остатки,,," + chr(10) +
     1716       ",,,,Количество,Сумма в учетных ценах,Сумма в ценах документа,В том числе скидки,Сумма в продажных ценах," +
     1717      "Количество,Сумма в учетных ценах,Сумма в продажных ценах,Количество,Сумма в учетных ценах,Сумма в продажных ценах," .
     1718   Sheetf.Sizes = "6,10,16,25,12,13,13,10,13,12,13,13,12,13,13,".
     1719   Sheetf.ColFOrmat = "3=@;4=@"  .
     1720    make-correct = Fill("true,", 15).
     1721   END PROCEDURE.
     1722   PROCEDURE state-changed :
     1723     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1724     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1725     CASE p-state:
     1726     END CASE.
     1727   END PROCEDURE.
     1728   PROCEDURE p-val :
     1729     ASSIGN frame F-Main tog-zero.
     1730     IF tog-zero THEN DO:
     1731        enable ShowZero-3 with  frame F-Main .
     1732        display ShowZero-3 with  frame F-Main .
     1733     END.
     1734     ELSE DO:
     1735        ShowZero-3 = false .
     1736        disable ShowZero-3 with  frame F-Main .
     1737        hide ShowZero-3 in frame F-Main .
     1738     END.
     1739   END PROCEDURE.
