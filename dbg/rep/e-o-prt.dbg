     1013        LABEL "Все товары"
     1014        VIEW-AS TOGGLE-BOX
     1015        SIZE 29 BY .83 NO-UNDO.
     1016   DEFINE VARIABLE tog-zero AS LOGICAL INITIAL no
     1017        LABEL "Нулевые обороты"
     1018        VIEW-AS TOGGLE-BOX
     1019        SIZE 28.88 BY .83 NO-UNDO.
     1020   DEFINE VARIABLE vt AS LOGICAL INITIAL yes
     1021        LABEL "инвентаризация":L
