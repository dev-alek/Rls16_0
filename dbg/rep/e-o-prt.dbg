     1029        LABEL "списан. произв.":L
     1030        VIEW-AS TOGGLE-BOX
     1031        SIZE 27.63 BY .75 NO-UNDO.
     1032   DEFINE FRAME F-Main
     1033        Classify AT ROW 2.38 COL 3 NO-LABEL
     1034        ie AT ROW 2.46 COL 49.63
     1035        ee AT ROW 3.42 COL 49.63
     1036        ep AT ROW 4.33 COL 49.63
     1037        es AT ROW 5.25 COL 49.63
     1038        re AT ROW 6.21 COL 49.63
     1039        rs AT ROW 7.08 COL 49.63
     1040        Itog AT ROW 7.75 COL 3
     1041        we AT ROW 8 COL 49.63
     1042        tog-zero AT ROW 8.67 COL 3
     1043        vt AT ROW 8.79 COL 49.63
     1044        ShowZero-3 AT ROW 9.5 COL 3
     1045        iv AT ROW 9.79 COL 49.63
     1046        ev AT ROW 10.75 COL 49.63
     1047        rv AT ROW 11.71 COL 49.63
     1048        em AT ROW 12.63 COL 49.63
     1049        wm AT ROW 13.58 COL 49.63
     1050        im AT ROW 14.5 COL 49.63
     1051        ot AT ROW 15.42 COL 49.63
     1052        "Оборот (выборочно):":C27 VIEW-AS TEXT
     1053             SIZE 27.63 BY .75 AT ROW 1.5 COL 49.75
     1054             FGCOLOR 4
     1055        "Классификация:":C28 VIEW-AS TEXT
     1056             SIZE 28.75 BY .75 AT ROW 1.42 COL 3
     1057             FGCOLOR 4
     1058        "Показать:":C28 VIEW-AS TEXT
     1059             SIZE 28.75 BY .75 AT ROW 6.79 COL 3
     1060             FGCOLOR 4
     1061        RECT-12 AT ROW 1.13 COL 1
     1062        RECT-10 AT ROW 1.13 COL 47.63
     1063       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1064            SIDE-LABELS NO-UNDERLINE THREE-D
     1065            AT COL 1 ROW 1 SCROLLABLE .
     1066   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1067   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1068   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1069   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1070   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1071   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1072   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1073   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1074         adm-object-hdl = FRAME F-Main:HANDLE.
     1075   RUN ensure-broker.
     1076   THIS-PROCEDURE:ADM-DATA =
     1077        'ADM1.1~`':U +
     1078        'SmartObject~`':U +
     1079        '~`':U +
     1080        'NO ~`':U +
     1081        '~`':U +
     1082        '~`':U +
     1083        '~`':U +
     1084        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1085           + "~`":U +
     1086        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1087        'Record-Source,Record-Target,TableIO-Target~`':U +
     1088        '~`':U +
     1089        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1090        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1091            THEN "^^":U
     1092        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1093             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1094   PROCEDURE adm-apply-entry :
     1095     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1096   END PROCEDURE.
     1097   PROCEDURE adm-destroy :
     1098    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1099   END PROCEDURE.
     1100   PROCEDURE adm-disable :
     1101       DISABLE RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv ev rv em wm im ot WITH FRAME F-Main.
     1102       RUN dispatch ('disable-fields':U).
     1103       RUN set-attribute-list ('ENABLED=no':U).
     1104       RETURN.
     1105   END PROCEDURE.
     1106   PROCEDURE adm-edit-attribute-list :
     1107         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1108         RETURN.
     1109   END PROCEDURE.
     1110   PROCEDURE adm-enable :
     1111       ENABLE UNLESS-HIDDEN RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv ev rv em wm im ot WITH FRAME F-Main.
     1112       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1113       RUN set-attribute-list ('ENABLED=yes':U).
     1114       RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE adm-exit :
     1117        RUN notify ('exit':U).
     1118     RETURN.
     1119   END PROCEDURE.
     1120   PROCEDURE adm-hide :
     1121     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1122   END PROCEDURE.
     1123   PROCEDURE adm-initialize :
     1124     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1125   END PROCEDURE.
     1126   PROCEDURE adm-show-errors :
     1127       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1128       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1129           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1130       END.
     1131       RETURN.
     1132   END PROCEDURE.
     1133   PROCEDURE adm-UIB-mode :
     1134     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1135   END PROCEDURE.
     1136   PROCEDURE adm-view :
     1137     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1138   END PROCEDURE.
     1139   PROCEDURE dispatch :
     1140       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1141       RUN broker-dispatch IN adm-broker-hdl
     1142           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1143       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1144   END PROCEDURE.
     1145   PROCEDURE ensure-broker :
     1146   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1147   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1148   DO:
     1149       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1150       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1151   END.
     1152   END PROCEDURE.
     1153   PROCEDURE get-attribute :
     1154     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1155     RUN broker-get-attribute IN adm-broker-hdl
     1156         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1157     RETURN RETURN-VALUE.
     1158   END PROCEDURE.
     1159   PROCEDURE get-attribute-list :
     1160     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1161     RUN broker-get-attribute-list IN adm-broker-hdl
     1162         (INPUT THIS-PROCEDURE,
     1163          INPUT ?,
     1164          OUTPUT p-attr-list) NO-ERROR.
     1165     RETURN.
     1166   END PROCEDURE.
     1167   PROCEDURE new-state :
     1168     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1169     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1170     RETURN.
     1171   END PROCEDURE.
     1172   PROCEDURE notify :
     1173     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1174     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1175     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1176         RETURN "ADM-ERROR":U.
     1177     RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE set-attribute-list :
     1180     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1181     RUN ensure-broker.
     1182     RUN broker-set-attribute-list IN adm-broker-hdl
     1183         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1184     RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE set-position :
     1187       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1188       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1189       IF VALID-HANDLE(adm-object-hdl) THEN
     1190       DO:
     1191         ASSIGN adm-object-hdl:ROW    =   p-row
     1192                adm-object-hdl:COLUMN =   p-col.
     1193       END.
     1194       RETURN.
     1195   END PROCEDURE.
     1196   PROCEDURE adm-display-fields :
     1197       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1198       RETURN.
     1199   END PROCEDURE.
     1200   PROCEDURE adm-open-query :
     1201     RETURN.
     1202   END PROCEDURE.
     1203   PROCEDURE adm-row-changed :
     1204         IF VALID-HANDLE(adm-object-hdl) THEN
     1205           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1206         RUN notify ('row-available':U).
     1207         RETURN.
     1208   END PROCEDURE.
     1209   PROCEDURE reposition-query :
     1210       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1211       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1212       RETURN.
     1213   END PROCEDURE.
     1214     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1215     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1216     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1217     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1218     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1219     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1220     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1221     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1222     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1223     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1224     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1225     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1226     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1227     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1228     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1229     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1230     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1231     IF "":U = "":U THEN
     1232       RUN modify-list-attribute IN adm-broker-hdl
     1233         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1234     RUN use-create-on-add(?).
     1235   PROCEDURE adm-add-record :
     1236       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1237          "must have at least one Enabled Table to perform Add.":U
     1238          VIEW-AS ALERT-BOX ERROR.
     1239       RETURN.
     1240   END PROCEDURE.
     1241   PROCEDURE adm-assign-record :
     1242    MESSAGE
     1243          "Object ":U THIS-PROCEDURE:FILE-NAME
     1244            "must have at least one Enabled Table to perform Assign.":U
     1245              VIEW-AS ALERT-BOX ERROR.
     1246      RETURN.
     1247     END PROCEDURE.
     1248   PROCEDURE adm-assign-statement :
     1249     RETURN.
     1250   END PROCEDURE.
     1251   PROCEDURE adm-cancel-record :
     1252      RETURN.
     1253     END PROCEDURE.
     1254   PROCEDURE adm-copy-record :
     1255       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1256        "must have at least one Enabled Table to perform Copy.":U
     1257          VIEW-AS ALERT-BOX ERROR.
     1258       RETURN.
     1259   END PROCEDURE.
     1260   PROCEDURE adm-create-record :
     1261      RETURN.
     1262   END PROCEDURE.
     1263   PROCEDURE adm-current-changed :
     1264     RETURN.
     1265   END PROCEDURE.
     1266   PROCEDURE adm-delete-record :
     1267    MESSAGE
     1268          "Object ":U THIS-PROCEDURE:FILE-NAME
     1269            "must have at least one Enabled Table to perform Delete.":U
     1270              VIEW-AS ALERT-BOX ERROR.
     1271       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1272       RETURN.
     1273   END PROCEDURE.
     1274   PROCEDURE adm-disable-fields :
     1275         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1276       RETURN.
     1277   END PROCEDURE.
     1278   PROCEDURE adm-enable-fields :
     1279       RETURN.
     1280   END PROCEDURE.
     1281   PROCEDURE adm-end-update :
     1282     RETURN.
     1283   END PROCEDURE.
     1284   PROCEDURE adm-reset-record :
     1285       RETURN.
     1286   END PROCEDURE.
     1287   PROCEDURE adm-update-record :
     1288       MESSAGE
     1289         "Object ":U THIS-PROCEDURE:FILE-NAME
     1290           "must have at least one Enabled Table to perform Update.":U
     1291             VIEW-AS ALERT-BOX ERROR.
     1292      RETURN.
     1293   END PROCEDURE.
     1294   PROCEDURE check-modified :
     1295   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1296   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1297   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1298   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1299     IF check-state = "check":U THEN
     1300     DO:
     1301       RUN get-link-handle IN adm-broker-hdl
     1302         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1303            OUTPUT group-target-list).
     1304       IF group-target-list NE "":U THEN
     1305       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1306         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1307         RUN check-modified IN curr-widget ('group-check':U).
     1308         IF RETURN-VALUE NE "":U THEN
     1309         DO:
     1310           RUN check-modified-message(RETURN-VALUE).
     1311           RETURN "":U.
     1312         END.
     1313       END.
     1314     END.
     1315     RETURN "":U.
     1316   END PROCEDURE.
     1317   PROCEDURE check-modified-message :
     1318     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1319        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1320           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1321        IF RETURN-VALUE = "YES":U THEN
     1322           RUN notify ('view,CONTAINER-SOURCE':U).
     1323        MESSAGE IF p-changed-table NE ? THEN
     1324           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1325           ELSE "Current values have been changed."
     1326           SKIP "  Do you wish to save those changes?"
     1327           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1328        IF ANS THEN
     1329        DO:
     1330           IF group-assign-target THEN
     1331             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1332           ELSE RUN dispatch('update-record':U).
     1333           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1334           DO:
     1335               MESSAGE "Changes to the previous record were not saved."
     1336                 VIEW-AS ALERT-BOX ERROR.
     1337               IF group-assign-target THEN
     1338                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1339               ELSE RUN dispatch ('cancel-record':U).
     1340           END.
     1341        END.
     1342        ELSE DO:
     1343          IF group-assign-target THEN
     1344             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1345          ELSE RUN dispatch('cancel-record':U).
     1346        END.
     1347        RETURN.
     1348   END PROCEDURE.
     1349   PROCEDURE get-rowid :
     1350       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1351       ASSIGN
     1352       p-table   =   adm-first-table.
     1353       RETURN.
     1354   END PROCEDURE.
     1355   PROCEDURE init-group-assign :
     1356       RUN request-attribute IN adm-broker-hdl
     1357         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1358       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1359         group-assign-target = yes.
     1360       ELSE group-assign-target = no.
     1361       RETURN.
     1362   END PROCEDURE.
     1363   PROCEDURE set-editors :
     1364       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1365       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1366       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1367       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1368       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1369       DO WHILE VALID-HANDLE (curr-widget):
     1370           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1371              curr-widget:HIDDEN = no THEN DO:
     1372             CASE p-field-setting:
     1373               WHEN "INITIALIZE":U THEN
     1374               DO:
     1375                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1376                     read-only-list +
     1377                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1378                        STRING(curr-widget).
     1379               END.
     1380               WHEN "DISABLE":U OR
     1381               WHEN "ENABLE":U THEN
     1382               DO:
     1383                   curr-widget:SENSITIVE = yes.
     1384                   RUN get-attribute ('Read-Only-Editors':U).
     1385                   IF RETURN-VALUE = ? OR
     1386                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1387                       curr-widget:READ-ONLY =
     1388                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1389               END.
     1390               WHEN "CLEAR":U THEN
     1391                   curr-widget:SCREEN-VALUE = "":U.
     1392             END CASE.
     1393           END.
     1394           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1395       END.
     1396       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1397         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1398           + '"':U).
     1399       RETURN.
     1400   END PROCEDURE.
     1401   PROCEDURE use-check-modified-all :
     1402    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1403     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1404     RETURN.
     1405   END PROCEDURE.
     1406   PROCEDURE use-create-on-add :
     1407   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1408      RETURN.
     1409   END PROCEDURE.
     1410   PROCEDURE use-initial-lock :
     1411     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1412     ASSIGN adm-initial-lock = p-attr-value.
     1413     RETURN.
     1414   END PROCEDURE.
     1415     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1416   ASSIGN
     1417          FRAME F-Main:SCROLLABLE       = FALSE
     1418          FRAME F-Main:HIDDEN           = TRUE.
     1419   ON VALUE-CHANGED OF tog-zero IN FRAME F-Main
     1420   DO:
     1421      run p-val in this-procedure.
     1422   END.
     1423   if not this-procedure :persistent
     1424   then do:
     1425     message
     1426       vss-workfile vss-revision vss-description skip
     1427       "Ошибка при запуске процедуры" skip
     1428       "Данную процедуру следует запускать только с параметром persistent" skip
     1429       view-as alert-box error .
     1430     undo, return error .
     1431   end.
     1432   PROCEDURE disable_UI :
     1433     HIDE FRAME F-Main.
     1434     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1435   END PROCEDURE.
     1436   PROCEDURE enable_UI :
     1437     DISPLAY Classify ie ee ep es re rs Itog we tog-zero vt ShowZero-3 iv ev rv em
     1438             wm im ot
     1439         WITH FRAME F-Main.
     1440     ENABLE RECT-12 RECT-10 Classify ie ee ep es re rs Itog we tog-zero vt iv ev
     1441            rv em wm im ot
     1442         WITH FRAME F-Main.
     1443   END PROCEDURE.
     1444   PROCEDURE local-apply-layout :
     1445     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1446   run cur-time in this-procedure ( output v-today
     1447                                  , output v-time
     1448                                  ).
     1449   if x-date-end <> v-today then do:
     1450     tog-zero = false.
     1451     disable  tog-zero with frame F-Main.
     1452     display  tog-zero with frame F-Main.
     1453   end.
     1454   else do:
     1455     enable  tog-zero with frame F-Main.
     1456     display  tog-zero with frame F-Main.
     1457   end.
     1458    run p-val in this-procedure.
     1459   END PROCEDURE.
     1460   PROCEDURE my-report :
     1461   fOR EACH tdedt SHARE-LOCK: DELETE tdedt. eND.
     1462   IF ie then  do:
     1463   create tdedt.
     1464   assign tdedt.id =  'ie':U
     1465          tdedt.n  = "01"
     1466   .
     1467   run get-name-from-ext-type in this-procedure (
     1468       input tdedt.id  ,
     1469       input false  ,
     1470       output tdedt.name )
     1471        .
     1472                       END.
     1473   IF ee then  do:
     1474   create tdedt.
     1475   assign tdedt.id =  'ee':U
     1476          tdedt.n  = "02"
     1477   .
     1478   run get-name-from-ext-type in this-procedure (
     1479       input tdedt.id  ,
     1480       input false  ,
