      959        SIZE 46.5 BY 16.83.
      960   DEFINE VARIABLE ee AS LOGICAL INITIAL yes
      961        LABEL "расход внешний":L
      962        VIEW-AS TOGGLE-BOX
      963        SIZE 27.63 BY .75 NO-UNDO.
      964   DEFINE VARIABLE em AS LOGICAL INITIAL yes
      965        LABEL "расход произв.":L
      966        VIEW-AS TOGGLE-BOX
      967        SIZE 27.63 BY .75 NO-UNDO.
      968   DEFINE VARIABLE ep AS LOGICAL INITIAL yes
