      678   procedure cur-time :
      679      define output parameter p-today as date      no-undo .
      680      define output parameter p-time  as integer   no-undo .
      681     do
      682     on error undo, return error
      683     :
      684       define variable v-date1 as date      no-undo .
      685       define variable v-date2 as date      no-undo .
      686       define variable v-time  as integer   no-undo .
      687       assign
      688         v-date1 = today
      689         v-time  = time
      690         v-date2 = today
      691       .
      692       if v-date1 <> v-date2
      693       then do:
      694         assign
      695           v-date1 = today
      696           v-time  = v-time
      697         .
      698       end.
      699       assign
      700         p-today = v-date1
      701         p-time  = v-time
      702       .
      703     end.
      704   end.
      705   function cur-time-date returns character
      706   :
      707     return string(today, '99/99/9999':U) .
      708   end.
      709   function cur-time-mjd returns decimal
      710   :
      711     define variable v-date as date      no-undo .
      712     define variable v-time as integer   no-undo .
      713     run cur-time in this-procedure
      714       (output v-date
      715       ,output v-time
      716       ) .
      717     return integer(v-date) - 2400002 + (v-time / 86400) .
      718   end.
      719   function cur-time-get-ending-index returns integer
      720   (input p-number as integer
      721   )
      722   :
      723     if p-number < 0
      724     or p-number = ?
      725     then do:
      726       return 1 .
      727     end.
      728     define variable v-rest as integer   no-undo .
      729     assign
      730       p-number = p-number modulo 100
      731     .
      732     if p-number < 20
      733     then do:
      734       assign
      735         v-rest = p-number
      736       .
      737     end.
      738     else do:
      739       assign
      740         v-rest = p-number modulo 10
      741       .
      742     end.
      743     case v-rest :
      744       when 1
      745       then do:
      746         return 2 .
      747       end.
      748       when 2 or
      749       when 3 or
      750       when 4
      751       then do:
      752         return 3 .
      753       end.
      754       otherwise do:
      755         return 1 .
      756       end.
      757     end case .
      758   end.
      759   procedure cur-time-mjd-to-date :
      760      define input  parameter i-mjd-diff as decimal no-undo.
      761      define output parameter o-Date     as date    no-undo.
      762      define output parameter o-Time     as integer no-undo.
      763      define variable v-day-number as integer   no-undo .
      764      if    i-mjd-diff < 0
      765         or i-mjd-diff = ?
      766      then do:
      767         return "?" .
      768      end.
      769      assign
      770         v-day-number = truncate(i-mjd-diff,0).
      771         o-Date = date(v-day-number + 2400002).
      772         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      773     .
      774   end.
      775   function cur-time-mjd-to-string returns character
      776   (input p-mjd-diff as decimal
      777   )
      778   :
      779     define variable v-day-number as integer   no-undo .
      780     define variable v-seconds    as integer   no-undo .
      781     define variable v-hour       as integer   no-undo .
      782     define variable v-min        as integer   no-undo .
      783     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      784     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      785     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      786     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      787     if p-mjd-diff < 0
      788     or p-mjd-diff = ?
      789     then do:
      790       return "?" .
      791     end.
      792     assign
      793       v-day-number = integer(truncate(p-mjd-diff,0))
      794       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      795     .
      796     if v-seconds > 86400
      797     then do:
      798       assign
      799         v-seconds = 86400 - 1
      800       .
      801     end.
      802     if v-seconds < 0
      803     then do:
      804       assign
      805         v-seconds = 0
      806       .
      807     end.
      808     assign
      809       v-hour = truncate(v-seconds / 3600, 0)
      810     .
      811     assign
      812       v-seconds = v-seconds modulo 3600
      813     .
      814     assign
      815       v-min = truncate(v-seconds / 60, 0)
      816     .
      817     assign
      818       v-seconds = v-seconds modulo 60
      819     .
      820     return
      821         (if v-day-number <> 0
      822           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      823           else ""
      824         )
      825       + (if v-day-number <> 0 or v-hour <> 0
      826           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      827           else ""
      828         )
      829       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      830           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      831           else ""
      832         )
      833       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      834       .
      835   end.
      836   function cur-time-string returns character
      837   :
      838     define variable v-date as date      no-undo .
      839     define variable v-time as integer   no-undo .
      840     run cur-time in this-procedure
      841       (output v-date
      842       ,output v-time
      843       ) .
      844     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      845   end.
      846   function cur-time-string-sec returns character
      847   :
      848     define variable v-date as date      no-undo .
      849     define variable v-time as integer   no-undo .
      850     run cur-time in this-procedure
      851       (output v-date
      852       ,output v-time
      853       ) .
      854     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      855   end.
      856   function cur-time-custom  returns character
      857   (input p-prefix as character
      858   ,input p-date-format as character
      859   ,input p-delimiter as character
      860   ,input p-time-format as character
      861   ,input p-suffix as character
      862   )
      863   :
      864     define variable v-date as date      no-undo .
      865     define variable v-time as integer   no-undo .
      866     run cur-time in this-procedure
      867       (output v-date
      868       ,output v-time
      869       ) .
      870     return
      871       p-prefix
      872       + string(v-date, p-date-format)
      873       + p-delimiter
      874       + string(v-time, p-time-format)
      875       + p-suffix
      876       .
      877   end.
      878   function cur-time-print  returns character
      879   :
      880     define variable v-date as date      no-undo .
      881     define variable v-time as integer   no-undo .
      882     run cur-time in this-procedure
      883       (output v-date
      884       ,output v-time
      885       ) .
      886     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      887   end.
      888   function cur-time-datetime returns datetime
      889   :
      890     define variable v-char as character no-undo .
      891     define variable v-datetime as datetime no-undo .
      892     v-char = cur-time-string().
      893     v-datetime = datetime(v-char).
      894     return  v-datetime.
      895   end.
      896   function cur-time-string-msec returns character
      897   :
      898     define variable v-date as datetime  no-undo .
      899     v-date = now.
      900     return string(v-date) .
      901   end.
      902   def var vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      903   function func-get-name-from-ext-type   returns char
      904     ( p-ext-type as character   ,
      905       p-caps     as logical ).
      906   define variable v-ext-name as character no-undo .
      907   run get-name-from-ext-type in this-procedure (
      908       input p-ext-type  ,
      909       input p-caps  ,
      910       output v-ext-name )
      911       no-error .
      912       if error-status :error then do:
      913          assign
      914            v-ext-name = p-ext-type
      915          .
      916       end.
      917    return (v-ext-name) .
      918   end.
      919   procedure get-name-from-ext-type :
      920    do
      921    on error undo, return error return-value
      922    :
      923   define input  parameter p-ext-type as character no-undo .
      924   define input  parameter p-caps     as logical no-undo   .
      925   define output parameter p-ext-name as character no-undo .
      926   define variable v-num as integer no-undo .
      927     if lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) = 0 then do :
      928       message
      929         vss-include-info14 skip
      930         "Неправильно задано значение входящего параметра! "
      931         "Нет такого типа документов " p-ext-type
      932         view-as alert-box error .
      933         undo, return error .
      934     end.
      935     v-num      = lookup ( p-ext-type , 'ie,ee,ep,es,re,rs,we,vt,vp,iv,ev,rv,em,wm,im,ot,ap,mp,pc,io,eo':U ) .
      936     p-ext-name = entry  ( v-num , 'приход внешний,расход внешний,возврат пост.,касса продажа,возврат внешний,касса возврат,списание,инвентаризация,пересортица,приход внутренний,расход внутренний,возврат внутренний,расход  произв.,списан. произв.,приход  произв.,переоценка,коррекция учетных цен,корректировка отрицательных партий,смена типа приобретения,приход внутриобъектный,расход внутриобъектный':U ) .
      937     if p-caps  = true then do :
      938        p-ext-name = caps(substring(p-ext-name,1,1) ) + substring(p-ext-name, 2 , length (p-ext-name) - 1 ) .
      939     end .
      940     end.
      941   end procedure.
      942   CREATE WIDGET-POOL.
      943   define variable State-source    as  WIDGET-HANDLE  no-undo.
