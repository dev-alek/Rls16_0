      970        VIEW-AS TOGGLE-BOX
      971        SIZE 27.63 BY .75 NO-UNDO.
      972   DEFINE VARIABLE es AS LOGICAL INITIAL yes
      973        LABEL "касса продажа":L
      974        VIEW-AS TOGGLE-BOX
      975        SIZE 27.63 BY .75 NO-UNDO.
      976   DEFINE VARIABLE ev AS LOGICAL INITIAL yes
      977        LABEL "расход перемещение":L
      978        VIEW-AS TOGGLE-BOX
      979        SIZE 27.63 BY .75 NO-UNDO.
      980   DEFINE VARIABLE ie AS LOGICAL INITIAL yes
      981        LABEL "приход внешний":L
      982        VIEW-AS TOGGLE-BOX
      983        SIZE 27.63 BY .75 NO-UNDO.
      984   DEFINE VARIABLE im AS LOGICAL INITIAL yes
      985        LABEL "приход произв.":L
      986        VIEW-AS TOGGLE-BOX
      987        SIZE 27.63 BY .75 NO-UNDO.
      988   DEFINE VARIABLE Itog AS LOGICAL INITIAL no
      989        LABEL "Только итоги"
      990        VIEW-AS TOGGLE-BOX
      991        SIZE 28.88 BY .83 NO-UNDO.
      992   DEFINE VARIABLE iv AS LOGICAL INITIAL yes
      993        LABEL "приход перемещение":L
      994        VIEW-AS TOGGLE-BOX
      995        SIZE 27.63 BY .75 NO-UNDO.
      996   DEFINE VARIABLE ot AS LOGICAL INITIAL no
      997        LABEL "переоценка":L27
      998        VIEW-AS TOGGLE-BOX
      999        SIZE 27.63 BY .75 NO-UNDO.
     1000   DEFINE VARIABLE re AS LOGICAL INITIAL yes
     1001        LABEL "возврат внешний":L
     1002        VIEW-AS TOGGLE-BOX
     1003        SIZE 27.63 BY .75 NO-UNDO.
     1004   DEFINE VARIABLE rs AS LOGICAL INITIAL yes
     1005        LABEL "касса возврат":L
     1006        VIEW-AS TOGGLE-BOX
     1007        SIZE 27.63 BY .75 NO-UNDO.
     1008   DEFINE VARIABLE rv AS LOGICAL INITIAL yes
     1009        LABEL "возврат перемещение":L
     1010        VIEW-AS TOGGLE-BOX
     1011        SIZE 27.63 BY .75 NO-UNDO.
