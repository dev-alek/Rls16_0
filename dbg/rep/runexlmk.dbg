        1   block-level on error undo, throw.
        2   define input parameter tempfile as char no-undo.
        3   define input parameter p-list-name as char no-undo.
        4   define variable vss-revision    as character no-undo init "$Revision: aea5316774be, 0, rls $":U .
        5   define variable vss-author      as character no-undo init "$Author: expertek $":U .
        6   define variable vss-date        as character no-undo init "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
        7   define variable vss-workfile    as character no-undo init "$Workfile: runexlmk.p $":U .
        8   define variable vss-archive     as character no-undo init "$Archive: rep/runexlmk.p $":U .
        9   define variable vss-description as character no-undo init "Вывод в Excel с запуском дополнительной сессии".
       10   procedure vss-get-info :
       11     define output parameter p-vss-revision    like vss-revision    no-undo .
       12     define output parameter p-vss-author      like vss-author      no-undo .
       13     define output parameter p-vss-date        like vss-date        no-undo .
       14     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       15     define output parameter p-vss-archive     like vss-archive     no-undo .
       16     define output parameter p-vss-description like vss-description no-undo .
       17     assign
       18       p-vss-revision    = vss-revision
       19       p-vss-author      = vss-author
       20       p-vss-date        = vss-date
       21       p-vss-workfile    = vss-workfile
       22       p-vss-archive     = vss-archive
       23       p-vss-description = vss-description
       24     .
       25   end procedure.
       26   procedure vss-get-parameters :
       27     define output parameter p-vss-parameters as character no-undo .
       28   end procedure.
       29   define new global shared variable g#vssrevis-logger as handle    no-undo .
       30   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       31   define variable v-vssrevis-logger                   as handle    no-undo .
       32   procedure vss-logevent :
       33     define input  parameter p-extra-paramters as character no-undo .
       34     define variable v-vssrevis-parameters as character no-undo .
       35     do
       36     on error undo, return error return-value
       37     :
       38       if  valid-handle(v-vssrevis-logger)
       39       and v-vssrevis-logger :get-signature("logevent") <> ""
       40       then do:
       41         run vss-get-parameters in this-procedure
       42           (output v-vssrevis-parameters
       43           ).
       44         run logevent in v-vssrevis-logger
       45           (input vss-workfile
       46           ,input vss-revision
       47           ,input v-vssrevis-parameters
       48           ,input p-extra-paramters
       49           ).
       50       end.
       51     end.
       52   end procedure.
       53   assign
       54     v-vssrevis-logger = g#vssrevis-logger
       55   .
       56   if  valid-handle(v-vssrevis-logger)
       57   and v-vssrevis-logger :get-signature("logevent") <> ""
       58   then do:
       59     assign
       60       v-vssrevis-logevent = true
       61     .
       62     run vss-logevent in this-procedure (input vss-description) .
       63   end.
       64   define new global shared variable g#language as character no-undo .
       65   if g#language <> '' and g#language <> 'rus':U then do:
       66     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       67   end.
       68   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       69   define variable v-waitfram-action01         as character   no-undo .
       70   define variable v-waitfram-action02         as character   no-undo .
       71   define variable v-waitfram-action03         as character   no-undo .
       72   define variable mWaitFramTextBeg            as character   no-undo.
       73   define variable mWaitFramTextEnd            as character   no-undo.
       74   define variable mWaitFramView               as logical     no-undo.
       75   define variable mWaitProcEvent              as logical     no-undo init yes.
       76   define variable mWaitFramInterval           as integer     no-undo init 1 .
       77   define variable mWaitFramStop               as logical     no-undo.
       78   define variable mWaitFramStopUser           as logical     no-undo.
       79   define variable mWaitFramStopTimeOut        as logical     no-undo.
       80   define variable mWaitFramStartProc          as datetime-tz no-undo.
       81   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
       82   define button B-WaitFramStop auto-end-key
       83        label "Стоп"
       84        size 10 by 1 tooltip "Остоновить процесс".
       85   define button B-viewProcInfo
       86        label "Информация"
       87        size 15 by 1 tooltip "Информация о процесс".
       88   define frame waitfram
       89     v-waitfram-action01 format "x(72)" no-label skip
       90     v-waitfram-action02 format "x(72)" no-label skip
       91     v-waitfram-action03 format "x(72)" no-label skip
       92     B-viewProcInfo
       93     B-WaitFramStop at row 4 col 30
       94     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
       95     .
       96   define new global shared variable mBatchMode as logical no-undo init ?.
       97   define variable mFramBachModHandle as handle no-undo.
       98   mFramBachModHandle = frame waitfram:handle.
       99   define variable mFameOldVis as logical no-undo.
      100   define variable mVisCUrentVin as logical no-undo.
      101   if session:batch-mode
      102   then
      103      mBatchMode = yes.
      104   if mBatchMode = ? then do:
      105     mVisCUrentVin = current-window:visible.
      106     mFameOldVis = mFramBachModHandle:visible.
      107     mFramBachModHandle:visible  = yes.
      108     mBatchMode = mFramBachModHandle:visible ne yes.
      109     mFramBachModHandle:visible = mFameOldVis.
      110     current-window:visible = mVisCUrentVin.
      111   end.
      112    if  log-manager:logfile-name ne ?
      113     then DO:
      114         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
      115         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
      116         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
      117     end.
      118   on choose of B-WaitFramStop in frame waitfram
      119   do:
      120     mWaitFramStop = yes.
      121     mWaitFramStopUser = yes.
      122   end.
      123   function waitfram-check-timeout returns logical():
      124      define variable vtime as int64 no-undo.
      125      if mWaitFramStopTimeOut
      126      then
      127         return yes.
      128      vtime = ( now - mWaitFramStartProc ) / 1000 .
      129      if     mWaitFramTimeOut ne ?
      130         and mWaitFramTimeOut ne 0
      131         and mWaitFramTimeOut lt vtime
      132      then do:
      133         mWaitFramStopTimeOut = yes.
      134      end.
      135      return mWaitFramStopTimeOut.
      136   end.
      137   procedure waitfram-hide :
      138     if not session:batch-mode
      139     then do
      140     on error undo, return error return-value
      141     :
      142       pause 0 before-hide .
      143       if not mBatchMode then
      144         hide frame waitfram .
      145     if     not mWaitFramView
      146        and mWaitProcEvent
      147     then
      148       process events .
      149     end.
      150   end procedure.
      151   procedure waitfram-show :
      152     define input  parameter p-message as character no-undo .
      153     define variable v-left-margin as integer   no-undo .
      154     if not session:batch-mode
      155     then do
      156     on error undo, return error return-value
      157     :
      158       if length(p-message) <= 70 then do:
      159         assign
      160           v-left-margin = integer((70 - length(p-message)) / 2)
      161         .
      162         assign
      163           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
      164         .
      165         assign
      166           v-waitfram-action01 = " "
      167           v-waitfram-action02 = " "
      168                                    + fill(" ", v-left-margin)
      169                                    + p-message
      170           v-waitfram-action03 = " "
      171         .
      172       end.
      173       else do:
      174         define variable vRindex1 as integer no-undo.
      175         define variable vRindex2 as integer no-undo.
      176         vRindex1 = r-index(p-message," ",70).
      177         if vRindex1 = 0
      178         then
      179            vRindex1 = 70.
      180         if length(p-message)  <= vRindex1 + 70 then do:
      181           assign
      182             v-waitfram-action01 = " "
      183             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
      184             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
      185           .
      186         end.
      187         else do:
      188           vRindex2 = r-index(p-message," ",vRindex1 + 70).
      189           if vRindex2 <= vRindex1
      190           then
      191              vRindex2 = vRindex1 + 70.
      192           assign
      193             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
      194             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
      195             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
      196           .
      197         end.
      198       end.
      199       B-viewProcInfo:visible   in frame waitfram = no.
      200       B-viewProcInfo:sensitive in frame waitfram = no.
      201       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      202       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
      203       if  (   mWaitFramView
      204          or  mWaitProcEvent)
      205          and not mBatchMode
      206       then
      207          display
      208             v-waitfram-action01 skip
      209             v-waitfram-action02 skip
      210             v-waitfram-action03 skip
      211          with frame waitfram .
      212       if     mWaitFramView
      213          then do:
      214             if     mWaitFramInterval ne ?
      215                and not mBatchMode
      216             then
      217                wait-for go of frame waitfram pause mWaitFramInterval.
      218          end.
      219          else
      220             if     mWaitProcEvent
      221                and not mBatchMode
      222             then
      223                process events .
      224     end.
      225   end procedure.
      226      procedure waitfram-show-this:
      227         define input  parameter iInterval as int64 no-undo.
      228         define variable vtime as int64 no-undo.
      229         vtime = ( now - mWaitFramStartProc  ) / 1000 .
      230         mWaitFramInterval = iInterval.
      231         run waitfram-show (substitute("&1&2 &3&4" ,
      232                                       mWaitFramTextBeg ,
      233                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
      234                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
      235                                       mWaitFramTextEnd
      236                                      )
      237                           ).
      238      end.
      239      procedure WaitFramRunPause:
      240         define input  parameter iInterval as dec no-undo.
      241         define variable vStart  as datetime-tz no-undo.
      242         define variable vend    as datetime-tz no-undo.
      243         define variable vint as int64 no-undo.
      244         define variable vOk as logical no-undo.
      245         vStart = now.
      246         vend   = vStart.
      247         publish "WaitFramPause" (iInterval,output vOk).
      248         vend   =  now.
      249         vint = vend - vStart.
      250         vint = iInterval - vint / 1000.
      251         if     not mWaitFramStop
      252            and (   vint > 0
      253                 or (    not vOk
      254                     and iInterval eq ?
      255                     )
      256                 )
      257         then
      258            run waitfram-show-this (iInterval).
      259         vend   =  now.
      260         vint = vend - vStart.
      261         vint = iInterval - vint / 1000.
      262         if     not mWaitFramStop
      263            and vint > 0
      264         then do:
      265            run gbl/pause.p (vint * 1000).
      266         end.
      267         if iInterval ne ?
      268         then
      269            publish "WaitFramStop".
      270         waitfram-check-timeout().
      271      end.
      272      procedure WaitFramWaitFor:
      273         define input  parameter iInterval as dec no-undo.
      274         assign
      275            mWaitFramStartProc   = now
      276            mWaitFramStopUser    = no
      277            mWaitFramStopTimeOut = no
      278         .
      279         block-wait:
      280         do while not mWaitFramStop:
      281            run WaitFramRunPause (iInterval).
      282            if  waitfram-check-timeout()
      283            then do:
      284               leave block-wait.
      285            end.
      286         end.
      287         run waitfram-hide.
      288      end.
      289   procedure waitfram-join :
      290     define input  parameter p-line-1  as character no-undo .
      291     define input  parameter p-line-2  as character no-undo .
      292     define input  parameter p-line-3  as character no-undo .
      293     define output parameter p-message as character no-undo .
      294     do
      295     on error undo, return error return-value
      296     :
      297       assign
      298         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
      299                   + substring(p-line-2 + fill(' ', 70), 1, 70)
      300                   + substring(p-line-3 + fill(' ', 70), 1, 70)
      301       .
      302     end.
      303   end procedure.
      304   function waitfram-join-function returns character
      305     (input p-line-1 as character
      306     ,input p-line-2 as character
      307     ,input p-line-3 as character
      308     ).
      309     define variable v-message as character no-undo .
      310     run waitfram-join in this-procedure
      311       (input  p-line-1
      312       ,input  p-line-2
      313       ,input  p-line-3
      314       ,output v-message
      315       ) .
      316     return v-message .
      317   end function .
      318   define variable tempfile-frm as character no-undo .
      319   define variable tempfile-t-t as character no-undo .
      320   define variable res          as integer   no-undo .
      321   define variable v-cmdln      as character no-undo .
      322   define variable v-exefile    as character no-undo .
      323   define variable v-inifile    as character no-undo .
      324   define variable err-file     as character no-undo .
      325   define stream forformat .
      326   do
      327   on error undo, return error return-value
      328   :
      329     define variable v-full-path        as character no-undo .
      330     define variable v-path             as character no-undo .
      331     define variable v-file-name        as character no-undo .
      332     define variable v-file-name-no-ext as character no-undo .
      333     define variable v-file-name-ext    as character no-undo .
      334     run gbl/filename.p (input  tempfile, output v-full-path, output v-path, output v-file-name, output v-file-name-no-ext, output v-file-name-ext) .
      335     assign
      336       tempfile-frm = v-path + '/':u + v-file-name-no-ext + '.':U + 'frm':U
      337       tempfile-t-t = v-path + '\':u + v-file-name-no-ext + '.':U + 't-t':U
      338     .
      339     run mcr-rep-mk (input tempfile-t-t, input v-path + '\':u + v-file-name-no-ext, input p-list-name) .
      340     os-delete  value( tempfile-t-t ) .
      341     os-delete  value( tempfile  ) .
      342     define variable err-status as integer   no-undo .
      343     err-status = OS-ERROR.
      344     IF err-status <> 0 THEN  return "disable-button":U.
      345                        else  return.
      346   end.
      347   def var vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      348   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      349   procedure paramls-clear :
      350     define buffer buf_temp-param for temp-param .
      351     do
      352     on error undo, return error return-value
      353     :
      354       for each buf_temp-param
      355       on error undo, return error
      356       :
      357         delete buf_temp-param .
      358       end.
      359     end.
      360   end procedure.
      361   procedure paramls-write :
      362     define input  parameter p-code     as character no-undo .
      363     define input  parameter p-sub-code as character no-undo .
      364     define input  parameter p-value    as character no-undo .
      365     define buffer buf_temp-param for temp-param .
      366     do
      367     on error undo, return error return-value
      368     :
      369       find first buf_temp-param
      370         where buf_temp-param.param-code     = p-code
      371           and buf_temp-param.param-sub-code = p-sub-code
      372         no-error .
      373       if not available buf_temp-param then do:
      374         create buf_temp-param .
      375         assign
      376           buf_temp-param.param-code     = p-code
      377           buf_temp-param.param-sub-code = p-sub-code
      378         .
      379       end.
      380       assign
      381         buf_temp-param.param-value = p-value
      382       .
      383     end.
      384   end procedure.
      385   procedure paramls-read :
      386     define input  parameter p-code          as character no-undo .
      387     define input  parameter p-sub-code      as character no-undo .
      388     define input  parameter p-default-value as character no-undo .
      389     define output parameter p-value         as character no-undo .
      390     define buffer buf_temp-param for temp-param .
      391     do
      392     on error undo, return error return-value
      393     :
      394       find first buf_temp-param
      395         where buf_temp-param.param-code     = p-code
      396           and buf_temp-param.param-sub-code = p-sub-code
      397         no-error .
      398       if available buf_temp-param then do:
      399         assign
      400           p-value = buf_temp-param.param-value
      401         .
      402       end.
      403       else do:
      404         assign
      405           p-value = p-default-value
      406         .
      407       end.
      408     end.
      409   end procedure.
      410   procedure paramls-append :
      411     define input  parameter p-code     as character no-undo .
      412     define input  parameter p-sub-code as character no-undo .
      413     define input  parameter p-value    as character no-undo .
      414     define buffer buf_temp-param for temp-param .
      415     do
      416     on error undo, return error return-value
      417     :
      418       find first buf_temp-param
      419            where buf_temp-param.param-code     = p-code
      420              and buf_temp-param.param-sub-code = p-sub-code
      421         no-error .
      422       if not available buf_temp-param then do:
      423         create buf_temp-param .
      424         assign
      425           buf_temp-param.param-code     = p-code
      426           buf_temp-param.param-sub-code = p-sub-code
      427           buf_temp-param.param-value    = p-value
      428         .
      429       end.
      430       else do:
      431           assign
      432               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      433           .
      434       end.
      435     end.
      436   end procedure.
      437   define stream  inStream  .
      438   procedure mcr-rep-mk :
      439     define input parameter  v-file-name as character no-undo .
      440     define input parameter  v-file-name1 as character no-undo .
      441     define input parameter  v-list-name as character no-undo .
      442     do
      443     on error undo, return error return-value
      444     :
      445     define variable v-count  as integer no-undo .
      446     define variable v-param-code     as character no-undo .
      447     define variable v-param-sub-code as character no-undo .
      448     define variable v-param-value    as character no-undo .
      449     input stream instream from value (v-file-name) .
      450     repeat  :
      451       assign
      452         v-count = v-count + 1
      453         v-param-code     = ''
      454         v-param-sub-code = ''
      455         v-param-value    = ''
      456       .
      457       import stream instream  v-param-code  v-param-sub-code  v-param-value .
      458       create temp-param .
      459       assign
      460         temp-param.param-code     = v-param-code
      461         temp-param.param-sub-code = v-param-sub-code
      462         temp-param.param-value    = v-param-value
      463       .
      464     end.
      465     input stream instream close .
      466     define variable v-ok as logical   no-undo .
      467     run macroexl-mk (input v-file-name1, input v-list-name, input-output table temp-param  ) .
      468     os-delete value (v-file-name) .
      469     define buffer buf_temp-param for temp-param .
      470     for each buf_temp-param  where buf_temp-param.param-code = "file" on error undo, return error :
      471       os-delete value(buf_temp-param.param-value) .
      472     end.
      473     end.
      474   end procedure.
      475   define buffer buf_temp-param for temp-param .
      476   define variable chExcelApp   as com-handle no-undo .
      477   define variable chWorkBook   as com-handle no-undo .
      478   define variable chCodeModule as com-handle no-undo .
      479   define variable v-ind              as integer   no-undo .
      480   define variable v-excel-macro-file as character no-undo .
      481   define variable v-ok               as logical   no-undo .
      482   procedure macroexl-mk :
      483     define input parameter v-file-name as character no-undo .
      484     define input parameter v-list-name as character no-undo .
      485     define input-output parameter table for temp-param .
      486     do
      487     on error undo, return error return-value
      488     :
      489     define variable v-excel-file-name as character no-undo .
      490     define variable v-read-password   as character no-undo .
      491     define variable v-write-password  as character no-undo .
      492     define variable v-excel-dir-name  as character no-undo .
      493     assign
      494       v-excel-file-name = v-file-name + ".xls"
      495     .
      496     if search(v-excel-file-name) <> ? then do:
      497       os-delete value(v-excel-file-name) .
      498     end.
      499     define variable v-column-list as character no-undo .
      500     run paramls-read in this-procedure  (input  "charcol" ,input  "" ,input  "" ,output v-column-list ) .
      501     create "Excel.Application" chExcelApp no-error .
      502     if error-status :error then do:
      503       message
      504         "Ошибка при запуске Excel" skip
      505         error-status :get-message(1) skip
      506         view-as alert-box error .
      507       undo, return error .
      508     end.
      509     define variable v-excel-visible-char as character no-undo .
      510     run paramls-read  (input "option",input "visible",input "true",output v-excel-visible-char ) .
      511     assign
      512       chExcelApp :Visible = lookup(v-excel-visible-char, "true,yes") > 0
      513     .
      514     assign
      515       chExcelApp :WindowState = -4143
      516       chExcelApp :Visible     = True
      517       chExcelApp :Interactive = False
      518     .
      519     assign
      520       chWorkBook = chExcelApp :Workbooks :Add()
      521     .
      522     assign
      523       chCodeModule = chWorkbook :VBProject :VBComponents :Item(1) :CodeModule
      524     .
      525     run export-macro in this-procedure .
      526     for each buf_temp-param
      527       where buf_temp-param.param-code = "file"
      528     by buf_temp-param.param-sub-code descending
      529     on error undo, return error
      530     :
      531       assign
      532         file-info :file-name = buf_temp-param.param-value
      533       .
      534       assign
      535         v-excel-macro-file = file-info :full-pathname
      536       .
      537       if v-excel-macro-file = ?
      538       or v-excel-macro-file = ""
      539       then do:
      540         message
      541           vss-workfile vss-revision vss-description skip
      542           "Ошибка задания входных параметров" skip
      543           "Не найден файл" buf_temp-param.param-value skip
      544           "param-code" buf_temp-param.param-code skip
      545           "param-sub-code" buf_temp-param.param-sub-code skip
      546           view-as alert-box error .
      547         undo, next .
      548       end.
      549       assign  v-ok = chWorkbook :DDEExec(v-excel-macro-file,v-list-name , v-column-list) .
      550     end.
      551     for each buf_temp-param
      552       where buf_temp-param.param-code = "command"
      553     by buf_temp-param.param-sub-code
      554     on error undo, leave
      555     :
      556       assign
      557         v-ok = chWorkbook :DDEExecCommand(buf_temp-param.param-value)
      558       .
      559     end.
      560     run clear-macro in this-procedure .
      561     assign
      562       chExcelApp :DisplayAlerts = False
      563     .
      564     define variable v-default-excel-file-name as character no-undo .
      565     assign
      566       v-default-excel-file-name = chWorkBook :FullName
      567     .
      568     if  v-read-password <> ""  and v-write-password <> "" then do:
      569       assign
      570         v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143  ,v-read-password ,v-write-password , , , ) no-error
      571       .
      572     end.
      573     else do:
      574       if v-write-password <> "" then do:
      575         assign
      576           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , ,v-write-password , , , ) no-error
      577         .
      578       end.
      579       else do:
      580         assign
      581           v-ok = chWorkBook :SaveAs(v-excel-file-name, -4143 , , , , , ) no-error
      582         .
      583       end.
      584     end.
      585     assign
      586       chExcelApp :DisplayAlerts = True
      587     .
      588     assign
      589       v-excel-file-name = chWorkBook :FullName
      590     .
      591     if v-excel-file-name = v-default-excel-file-name
      592     or v-excel-file-name = ? then do:
      593       release object chCodeModule no-error .
      594       release object chWorkBook   no-error .
      595       release object chExcelApp   no-error .
      596       message
      597         "Ошибка при сохранении файла" skip
      598         "Сохраните Excel файл вручную" skip
      599         view-as alert-box information .
      600     end.
      601     else do:
      602       assign
      603         chWorkBook :Saved = true
      604       .
      605       assign
      606         v-ok = chWorkBook :Close
      607       .
      608       release object chCodeModule no-error .
      609       release object chWorkBook   no-error .
      610       assign
      611         v-ok = chExcelApp:Quit() no-error
      612       .
      613       release object chExcelApp   no-error .
      614     end.
      615     end.
      616   end procedure.
      617   procedure append-macro-line :
      618     define input  parameter p-macro-str as character no-undo .
      619     do
      620     on error undo, return error return-value
      621     :
      622       assign
      623         v-ind = v-ind + 1
      624       .
      625       assign
      626         v-ok = chCodeModule :InsertLines(v-ind, p-macro-str )
      627       .
      628     end.
      629   end procedure.
      630   procedure export-test-macro :
      631     assign
      632       v-ind = 0
      633     .
      634     do
      635     on error undo, return error return-value
      636     :
      637       run append-macro-line (input 'Sub HelloWorld()').
      638       run append-macro-line (input '  MsgBox "HelloWorld"').
      639       run append-macro-line (input 'End Sub').
      640     end.
      641   end procedure.
      642   procedure export-macro :
      643     assign
      644       v-ind = 0
      645     .
      646     do
      647     on error undo, return error return-value
      648     :
      649       run append-macro-line (input 'Sub DDEExec(FileName$, SheetName$, numColList$)').
      650       run append-macro-line (input '  Application.ScreenUpdating = False').
      651       run append-macro-line (input '  Application.Interactive = False').
      652       run append-macro-line (input '  Set NewSheet = Sheets.Add(Type:=xlWorksheet)').
      653       run append-macro-line (input '  NewSheet.Name = SheetName$').
      654       run append-macro-line (input '  dim ind as long').
      655       run append-macro-line (input '  dim vshowmess as boolean').
      656       run append-macro-line (input '  vshowmess = true').
      657       run append-macro-line (input '  callList(numColList$)').
      658       run append-macro-line (input '  Open FileName$ For Input As #1').
      659       run append-macro-line (input '  ind = 0').
      660       run append-macro-line (input '  Do Until EOF(1)').
      661       run append-macro-line (input '    Line Input #1, vCommand').
      662       run append-macro-line (input '    ind = ind + 1').
      663       run append-macro-line (input '    if ind mod 3000 = 0 then').
      664       run append-macro-line (input '      Application.StatusBar = "Импорт из " & FileName$ & " Строк " & CStr(ind)').
      665       run append-macro-line (input '      Application.ScreenUpdating = True').
      666       run append-macro-line (input '      Application.ScreenUpdating = False').
      667       run append-macro-line (input '    end if').
      668       run append-macro-line (input '    On Error Resume Next').
      669       run append-macro-line (input '    ExecuteExcel4Macro (vCommand)').
      670       run append-macro-line (input '    If (Err.Number <> 0) and (vshowmess = true) Then').
      671       run append-macro-line (input '      Dim vCancelMacro As Integer').
      672       run append-macro-line (input '      vCancelMacro = MsgBox("Ошибка " & Err.Number & Chr(13) & "Команда " & vCommand & Chr(13) & "Файл " & FileName$ & Chr(13) & "Строка файла " & ind & Chr(13) & "Yes - Продолжить выполнение программы" & Chr(13) & "No - Продолжить выполнение программы и не выводить сообщения об ошибках" & Chr(13) & "Cancel - Прервать выполнение программы" & Chr(13), vbYesNoCancel)').
      673       run append-macro-line (input '      Select Case vCancelMacro').
      674       run append-macro-line (input '        Case vbYes').
      675       run append-macro-line (input '        Case vbNo').
      676       run append-macro-line (input '          vshowmess = false').
      677       run append-macro-line (input '        Case vbCancel').
      678       run append-macro-line (input '          Close #1').
      679       run append-macro-line (input '          Exit Sub').
      680       run append-macro-line (input '      End Select').
      681       run append-macro-line (input '    End If').
      682       run append-macro-line (input '    On Error GoTo 0').
      683       run append-macro-line (input '  Loop').
      684       run append-macro-line (input '  Close #1').
      685       run append-macro-line (input '  Application.StatusBar = "Импорт из " & FileName$ & " завершен"').
      686       run append-macro-line (input '  Application.ScreenUpdating = True').
      687       run append-macro-line (input '  Application.Interactive = True').
      688       run append-macro-line (input 'End Sub').
      689       run append-macro-line (input 'Sub DDEExecCommand(vCommand$)').
      690       run append-macro-line (input '   ExecuteExcel4Macro (vCommand$)').
      691       run append-macro-line (input 'End Sub').
      692       run append-macro-line (input 'Sub FormatColumnNumber(numCol As Integer)').
      693       run append-macro-line (input '  Columns(numCol).NumberFormat = "@"').
      694       run append-macro-line (input 'End Sub').
      695       run append-macro-line (input 'Sub callList(sList As String)').
      696       run append-macro-line (input '  Dim iPos0 As Integer, iPos As Integer').
      697       run append-macro-line (input '  Dim sDelimiter As String').
      698       run append-macro-line (input '  sDelimiter = ","').
      699       run append-macro-line (input '  If sList = "" Then').
      700       run append-macro-line (input '      Exit Sub').
      701       run append-macro-line (input '  End If').
      702       run append-macro-line (input '  iPos0 = 0').
      703       run append-macro-line (input '  iPos = InStr(1, sList, sDelimiter, vbBinaryCompare)').
      704       run append-macro-line (input '  If iPos = 0 Then').
      705       run append-macro-line (input '      FormatColumnNumber(Cint(sList))').
      706       run append-macro-line (input '      Exit Sub').
      707       run append-macro-line (input '  End If').
      708       run append-macro-line (input '  While True').
      709       run append-macro-line (input '      FormatColumnNumber(Cint(Mid(sList, iPos0 + 1, IIf(iPos = 0, Len(sList), iPos - iPos0 - 1))))').
      710       run append-macro-line (input '      If iPos = 0 Then').
      711       run append-macro-line (input '          Exit Sub').
      712       run append-macro-line (input '      End If').
      713       run append-macro-line (input '      iPos0 = iPos').
      714       run append-macro-line (input '      iPos = InStr(iPos + 1, sList, sDelimiter)').
      715       run append-macro-line (input '  Wend').
      716       run append-macro-line (input 'End Sub').
      717     end.
      718   end procedure.
      719   procedure clear-macro :
      720     define variable v-num-lines as integer   no-undo .
      721     do
      722     on error undo, return error return-value
      723     :
      724       assign
      725         v-num-lines = chCodeModule :CountOfLines
      726       .
      727       chCodeModule :DeleteLines(1, v-num-lines) .
      728     end.
      729   end procedure.
