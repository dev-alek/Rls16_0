      581   define variable var-report-r-b as character no-undo .
      582   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      583   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      584     (output var-report-r-b
      585     )  .
      586   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      587   DEFINE SHARED temp-table grp-h no-undo
      588       field grp-code like ub.goods.grp-code
      589       field hour  as decimal extent 24
      590       field qnty  as  decimal
      591       field obj-code like ub.clients.obj-code
      592       INDEX pi IS PRIMARY obj-code grp-code ASCENDING .
      593   DEFINE SHARED temp-table gds-h no-undo
      594       field grp-code like     ub.goods.grp-code
      595       field obj-code like ub.clients.obj-code
      596       field b-code      like      ub.bar-code.b-code
      597       field gds-name like     ub.goods.gds-name
      598       field f-name like     ub.gds-prt.f-name
      599       field is-empty as logical
      600       field uniq          as      char
      601       field artic          like     ub.goods.artic
      602       field hour          as      decimal extent 24
