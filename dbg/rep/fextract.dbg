      372   procedure prn-lib-open-stream :
      373     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      374     define input parameter p-page-size    as integer no-undo .
      375     define input parameter p-is-stream    as logical no-undo .
      376     define input parameter p-append       as logical no-undo .
      377     define variable v-report-name as character no-undo .
      378     do
      379       on error undo, return error
      380       :
      381       run prn-lib-get-report-name  in this-procedure (
      382         input parParentProc
      383         ,output v-report-name
      384         ).
      385       if p-is-stream then
      386       do:
      387         if p-append then
      388         do:
      389           output stream PrnLibStream to value( v-report-name )
      390             page-size value(p-page-size) append .
      391         end.
      392         if not p-append then
      393         do:
      394           output stream PrnLibStream to value( v-report-name )
      395             page-size value(p-page-size) .
      396         end.
      397       end.
      398       if not p-is-stream then
      399       do:
      400         if p-append then
      401         do:
      402           output to value( v-report-name )
      403             page-size value(p-page-size) append .
      404         end.
      405         if not p-append then
      406         do:
      407           output to value( v-report-name )
      408             page-size value(p-page-size) .
      409         end.
      410       end.
      411     end.
      412   end procedure.
      413   procedure prn-lib-open-exp :
      414     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      415     define input parameter p-is-stream    as logical no-undo .
      416     define input parameter p-is-append    as logical no-undo .
      417     define output parameter p-ReportFileName as char init "report" no-undo.
      418     define output parameter p-process as logical no-undo .
      419     define variable glog as logical no-undo .
      420     do
      421       on error undo, return error
      422       :
      423       SYSTEM-DIALOG GET-FILE p-ReportFileName
      424         TITLE      "Укажите путь"
      425         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      426         ASK-OVERWRITE
      427         CREATE-TEST-FILE
      428         SAVE-AS
      429         USE-FILENAME
      430         DEFAULT-EXTENSION "txt"
      431         UPDATE glog
      432         .
      433       if not glog then  return.
      434       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      435       if p-is-stream then
      436       do:
      437         if p-is-append then
      438         do:
      439           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      440         end.
      441         else
      442         do:
      443           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      444         end.
      445       end.
      446       else
      447       do:
      448         if p-is-append then
      449         do:
      450           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      451         end.
      452         else
      453         do:
      454           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      455         end.
      456       end.
      457       p-process = yes.
      458     end.
      459   end procedure.
      460   procedure prn-lib-get-report-name :
      461     define input parameter parParentProc  as widget-handle no-undo.
      462     define output parameter p-report-name as character no-undo .
      463     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      464   end procedure.
      465   procedure prn-lib-reportviewer-report-name :
      466     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      467     define input parameter p-report-name-html as character no-undo .
      468     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      469   end procedure.
      470   procedure prn-lib-reportviewer :
      471     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      472     define input parameter p-report-name-html as character no-undo .
      473     define input parameter p-param        as character no-undo .
      474     define variable v-excel           as character no-undo init 'TRUE' .
      475     define variable v-value-character as character no-undo .
      476     define variable v-value-integer   as character no-undo .
      477     define variable v-value-date      as date      no-undo .
      478     define variable v-value-decimal   as decimal   no-undo .
      479     define variable rep-excel         as logical   no-undo .
      480     define variable excel-string      as character no-undo .
      481     define variable v-param-type      as character no-undo .
      482     define variable v-tth             as handle    no-undo .
      483     run adm/shattri.p (
      484       input "get":U
      485       ,input  ""
      486       ,input  0
      487       ,input  'report-glob':U
      488       ,input  'rep-excel':U
      489       ,output v-value-character
      490       ,output v-value-date
      491       ,output v-value-decimal
      492       ,output v-value-integer
      493       ,output rep-excel
      494       ,output v-param-type
      495       ,INPUT-OUTPUT table-handle v-tth
      496       )  .
      497     if rep-excel then v-excel = "TRUE" .
      498     else v-excel = "FALSE" .
      499     if p-param eq ""
      500     then
      501        p-param = "EXCEL:" + v-excel.
      502     else
      503        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      504     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      505   end procedure.
      506   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      507   procedure cur-time :
      508      define output parameter p-today as date      no-undo .
      509      define output parameter p-time  as integer   no-undo .
      510     do
      511     on error undo, return error
      512     :
      513       define variable v-date1 as date      no-undo .
      514       define variable v-date2 as date      no-undo .
      515       define variable v-time  as integer   no-undo .
      516       assign
      517         v-date1 = today
      518         v-time  = time
      519         v-date2 = today
      520       .
      521       if v-date1 <> v-date2
      522       then do:
      523         assign
      524           v-date1 = today
      525           v-time  = v-time
      526         .
      527       end.
      528       assign
      529         p-today = v-date1
      530         p-time  = v-time
      531       .
      532     end.
      533   end.
      534   function cur-time-date returns character
      535   :
      536     return string(today, '99/99/9999':U) .
      537   end.
      538   function cur-time-mjd returns decimal
      539   :
      540     define variable v-date as date      no-undo .
      541     define variable v-time as integer   no-undo .
      542     run cur-time in this-procedure
      543       (output v-date
      544       ,output v-time
      545       ) .
      546     return integer(v-date) - 2400002 + (v-time / 86400) .
      547   end.
      548   function cur-time-get-ending-index returns integer
      549   (input p-number as integer
      550   )
      551   :
      552     if p-number < 0
      553     or p-number = ?
      554     then do:
      555       return 1 .
      556     end.
      557     define variable v-rest as integer   no-undo .
      558     assign
      559       p-number = p-number modulo 100
      560     .
      561     if p-number < 20
      562     then do:
      563       assign
      564         v-rest = p-number
      565       .
      566     end.
      567     else do:
      568       assign
      569         v-rest = p-number modulo 10
      570       .
      571     end.
      572     case v-rest :
      573       when 1
      574       then do:
      575         return 2 .
      576       end.
      577       when 2 or
      578       when 3 or
      579       when 4
      580       then do:
      581         return 3 .
      582       end.
      583       otherwise do:
      584         return 1 .
      585       end.
      586     end case .
      587   end.
      588   procedure cur-time-mjd-to-date :
      589      define input  parameter i-mjd-diff as decimal no-undo.
      590      define output parameter o-Date     as date    no-undo.
      591      define output parameter o-Time     as integer no-undo.
      592      define variable v-day-number as integer   no-undo .
      593      if    i-mjd-diff < 0
      594         or i-mjd-diff = ?
      595      then do:
      596         return "?" .
      597      end.
      598      assign
      599         v-day-number = truncate(i-mjd-diff,0).
      600         o-Date = date(v-day-number + 2400002).
      601         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      602     .
      603   end.
      604   function cur-time-mjd-to-string returns character
      605   (input p-mjd-diff as decimal
      606   )
      607   :
      608     define variable v-day-number as integer   no-undo .
      609     define variable v-seconds    as integer   no-undo .
      610     define variable v-hour       as integer   no-undo .
      611     define variable v-min        as integer   no-undo .
      612     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      613     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      614     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      615     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      616     if p-mjd-diff < 0
      617     or p-mjd-diff = ?
      618     then do:
      619       return "?" .
      620     end.
      621     assign
      622       v-day-number = integer(truncate(p-mjd-diff,0))
      623       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      624     .
      625     if v-seconds > 86400
      626     then do:
      627       assign
      628         v-seconds = 86400 - 1
      629       .
      630     end.
      631     if v-seconds < 0
      632     then do:
      633       assign
      634         v-seconds = 0
      635       .
      636     end.
      637     assign
      638       v-hour = truncate(v-seconds / 3600, 0)
      639     .
      640     assign
      641       v-seconds = v-seconds modulo 3600
      642     .
      643     assign
      644       v-min = truncate(v-seconds / 60, 0)
      645     .
      646     assign
      647       v-seconds = v-seconds modulo 60
      648     .
      649     return
      650         (if v-day-number <> 0
      651           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      652           else ""
      653         )
      654       + (if v-day-number <> 0 or v-hour <> 0
      655           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      656           else ""
      657         )
      658       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      659           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      660           else ""
      661         )
      662       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      663       .
      664   end.
      665   function cur-time-string returns character
      666   :
      667     define variable v-date as date      no-undo .
      668     define variable v-time as integer   no-undo .
      669     run cur-time in this-procedure
      670       (output v-date
      671       ,output v-time
      672       ) .
      673     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      674   end.
      675   function cur-time-string-sec returns character
      676   :
      677     define variable v-date as date      no-undo .
      678     define variable v-time as integer   no-undo .
      679     run cur-time in this-procedure
      680       (output v-date
      681       ,output v-time
      682       ) .
      683     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      684   end.
      685   function cur-time-custom  returns character
      686   (input p-prefix as character
      687   ,input p-date-format as character
      688   ,input p-delimiter as character
      689   ,input p-time-format as character
      690   ,input p-suffix as character
      691   )
      692   :
      693     define variable v-date as date      no-undo .
      694     define variable v-time as integer   no-undo .
      695     run cur-time in this-procedure
      696       (output v-date
      697       ,output v-time
      698       ) .
      699     return
      700       p-prefix
      701       + string(v-date, p-date-format)
      702       + p-delimiter
      703       + string(v-time, p-time-format)
      704       + p-suffix
      705       .
      706   end.
      707   function cur-time-print  returns character
      708   :
      709     define variable v-date as date      no-undo .
      710     define variable v-time as integer   no-undo .
      711     run cur-time in this-procedure
      712       (output v-date
      713       ,output v-time
      714       ) .
      715     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      716   end.
      717   function cur-time-datetime returns datetime
      718   :
      719     define variable v-char as character no-undo .
      720     define variable v-datetime as datetime no-undo .
      721     v-char = cur-time-string().
      722     v-datetime = datetime(v-char).
      723     return  v-datetime.
      724   end.
      725   function cur-time-string-msec returns character
      726   :
      727     define variable v-date as datetime  no-undo .
      728     v-date = now.
      729     return string(v-date) .
      730   end.
      731   define variable vss-include-info5 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      732   procedure factord :
      733     define input  parameter p-fact-date            as date    no-undo .
      734     define input  parameter p-fact-time            as integer no-undo .
      735     define input  parameter p-fact-num             as integer no-undo .
      736     define input  parameter p-shift-date           as date    no-undo .
      737     define input  parameter p-shift-num            as integer no-undo .
      738     define input  parameter p-shift-on             as logical no-undo .
      739     define output parameter p-fact-order           as decimal no-undo .
      740     define output parameter p-shift-end-fact-order as decimal no-undo .
      741     define output parameter p-day-end-fact-order   as decimal no-undo .
      742     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
      743     if p-fact-date = ?
      744     then do:
      745       return error "Не указана фактическая дата" .
      746     end.
      747     define variable v-fact-date-num as integer no-undo .
      748     assign
      749       v-fact-date-num = integer(p-fact-date)
      750     .
      751     if p-fact-num = ?
      752     or p-fact-num = 0
      753     then do:
      754       return error "Не задан p-fact-num " + string(p-fact-num) .
      755     end.
      756     if p-fact-num < 0
      757     then do:
      758       return error "Отрицательный fact-num " + string(p-fact-num) .
      759     end.
      760     if p-fact-num >= 100000000
      761     then do:
      762       return error "Недопустимо большой fact-num " + string(p-fact-num) .
      763     end.
      764     if p-shift-on = true
      765     then do:
      766       if p-shift-date = ?
      767       then do:
      768         return error "Не задана дата смены" .
      769       end.
      770       if p-shift-num = ?
      771       or p-shift-num = 0
      772       then do:
      773         return error "Не задан номер смены" .
      774       end.
      775     end.
      776     else do:
      777       assign
      778         p-shift-date = p-fact-date
      779         p-shift-num  = 24
      780       .
      781     end.
      782     define variable v-shift-offset as integer no-undo .
      783     if p-shift-date = p-fact-date
      784     then do:
      785       assign
      786         v-shift-offset = 1
      787       .
      788     end.
      789     if p-shift-date < p-fact-date
      790     then do:
      791       assign
      792         v-shift-offset = 0
      793       .
      794     end.
      795     if p-shift-date > p-fact-date
      796     then do:
      797       message
      798         vss-workfile vss-revision vss-description skip
      799         "Неправильная дата закрытия смены" skip
      800         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
      801         view-as alert-box error .
      802       undo, return error
      803         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
      804           ,string(p-fact-date, '99/99/9999':U)
      805           ,string(p-shift-date, '99/99/9999':U)
      806           )
      807       .
      808     end.
      809     if p-shift-num < 1
      810     or p-shift-num > 24
      811     then do:
      812       message
      813         vss-workfile vss-revision vss-description skip
      814         "Неправильный номер смены" skip
      815         "p-shift-num" p-shift-num skip
      816         view-as alert-box error .
      817       undo, return error return-value .
      818     end.
      819     assign
      820       p-fact-order           = v-fact-date-num
      821                              + v-shift-offset * 0.5
      822                              + p-shift-num    * 0.02 - 0.01
      823                              + p-fact-num     * 0.0000000001
      824       p-shift-end-fact-order = v-fact-date-num
      825                              + v-shift-offset * 0.5
      826                              + p-shift-num    * 0.02
      827       p-day-end-fact-order   = v-fact-date-num
      828                              + 0.99
      829     .
      830     if p-fact-order           <= v-fact-date-num
      831     or p-shift-end-fact-order <= v-fact-date-num
      832     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
      833     or p-shift-end-fact-order >= p-day-end-fact-order
      834     then do:
      835       message
      836         vss-workfile vss-revision vss-description skip
      837         "Внутренняя ошибка при генерации фактического номера" skip
      838         "p-fact-date"            p-fact-date            skip
      839         "p-fact-time"            p-fact-time            skip
      840         "p-fact-num"             p-fact-num             skip
      841         "p-shift-date"           p-shift-date           skip
      842         "p-shift-num"            p-shift-num            skip
      843         "p-shift-on"             p-shift-on             skip
      844         "p-shift-end-fact-order" p-shift-end-fact-order skip
      845         "p-day-end-fact-order"   p-day-end-fact-order   skip
      846         "v-fact-date-num"        v-fact-date-num        skip
      847         view-as alert-box error .
      848       undo, return error return-value .
      849     end.
      850   end procedure.
      851   procedure day-begin-fact-order :
      852     define input  parameter p-fact-date            as date    no-undo .
      853     define output parameter p-day-begin-fact-order as decimal no-undo .
      854     do
      855     on error undo, return error return-value
      856     :
      857       if p-fact-date = ?
      858       then do:
      859         assign
      860           p-day-begin-fact-order = 0
      861         .
      862       end.
      863       else do:
      864         assign
      865           p-day-begin-fact-order = integer(p-fact-date)
      866         .
      867       end.
      868     end.
      869   end procedure.
      870   procedure factord-max-fact-order :
      871     define output parameter p-max-fact-order as decimal   no-undo .
      872     do
      873     on error undo, return error return-value
      874     :
      875       run day-begin-fact-order in this-procedure
      876         (input  date(1, 1, 5000)
      877         ,output p-max-fact-order
      878         ) .
      879     end.
      880   end procedure.
      881   procedure factord-cut-archive :
      882     define input  parameter p-obj-type             as character no-undo .
      883     define input  parameter p-obj-code             as integer   no-undo .
      884     define input  parameter p-fact-date            as date      no-undo .
      885     define output parameter p-shift-on             as logical   no-undo .
      886     define output parameter p-shift-date           as date      no-undo .
      887     define output parameter p-shift-num            as integer   no-undo .
      888     define output parameter p-day-end-fact-order   as decimal   no-undo .
      889     define output parameter p-shift-end-fact-order as decimal   no-undo .
      890     define variable v-fact-order as decimal   no-undo .
      891     define buffer buf_shift-obj for ub.shift-obj .
      892     do
      893     on error undo, return error return-value
      894     :
      895   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      896   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
      897     (input  p-obj-type
      898     ,input  p-obj-code
      899     ,input  'shift-on=request'
      900     ,output p-shift-on
      901     ) no-error .
      902       if error-status :error
      903       then do:
      904         message
      905           vss-workfile vss-revision vss-description skip
      906           "Ошибка при определении атрибута объекта" skip
      907           "Объект" p-obj-type p-obj-code skip
      908           error-status :get-message(1) skip
      909           return-value skip
      910           view-as alert-box error .
      911         undo, return error return-value .
      912       end.
      913       if p-shift-on = false
      914       then do:
      915         assign
      916           p-shift-date               = ?
      917           p-shift-num                = 0
      918         .
      919       end.
      920       else do:
      921         find first buf_shift-obj share-lock
      922           where buf_shift-obj.obj-type   = p-obj-type
      923             and buf_shift-obj.obj-code   = p-obj-code
      924             and buf_shift-obj.shift-date > p-fact-date
      925           use-index pi
      926           no-error .
      927         if not available buf_shift-obj
      928         or buf_shift-obj.status_ <> 'зкр':U
      929         then do:
      930           message
      931             vss-workfile vss-revision vss-description skip
      932             "Невозможно вычислить последнюю смену" skip
      933             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
      934             "Объект" p-obj-type p-obj-code skip
      935             "Дата" p-fact-date skip
      936             view-as alert-box error .
      937           undo, return error return-value .
      938         end.
      939         find last buf_shift-obj share-lock
      940           where buf_shift-obj.obj-type = p-obj-type
      941             and buf_shift-obj.obj-code = p-obj-code
      942             and buf_shift-obj.shift-date <= p-fact-date
      943           use-index pi
      944           no-error .
      945         if available buf_shift-obj
      946         then do:
      947           if  buf_shift-obj.status_ = 'зкр':U
      948           then do:
      949             assign
      950               p-shift-date = buf_shift-obj.shift-date
      951               p-shift-num  = buf_shift-obj.shift-num
      952             .
      953           end.
      954           else do:
      955             message
      956               vss-workfile vss-revision vss-description skip
      957               "Невозможно вычислить последнюю смену" skip
      958               "Статус смены отличен от статуса" 'зкр':U skip
      959               "Объект" p-obj-type p-obj-code skip
      960               "Дата" p-fact-date skip
      961               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
      962               view-as alert-box error .
      963             undo, return error return-value .
      964           end.
      965         end.
      966         else do:
      967           assign
      968             p-shift-date = p-fact-date - 1
      969             p-shift-num  = 1
      970           .
      971         end.
      972       end.
      973       run factord in this-procedure
      974         (input  p-fact-date
      975         ,input  1
      976         ,input  1
      977         ,input  p-shift-date
      978         ,input  p-shift-num
      979         ,input  p-shift-on
      980         ,output v-fact-order
      981         ,output p-shift-end-fact-order
      982         ,output p-day-end-fact-order
      983         ) no-error .
      984       if error-status :error
      985       then do:
      986         message
      987           vss-workfile vss-revision vss-description skip
      988           "Ошибка при вызове процедуры factord"
      989           error-status :get-message(1) skip
      990           return-value skip
      991           view-as alert-box error .
      992         undo, return error return-value .
      993       end.
      994     end.
      995   end procedure.
      996   procedure factord-lock-shift :
      997     define input  parameter p-obj-type  as character no-undo .
      998     define input  parameter p-obj-code  as integer   no-undo .
      999     define input  parameter p-fact-date as date      no-undo .
     1000     define parameter buffer buf_shift-obj for ub.shift-obj .
     1001     define variable v-shift-on      as logical   no-undo .
     1002     define variable v-extra-message as character no-undo .
     1003     define variable v-error as character no-undo .
     1004     do
     1005     on error undo, return error return-value
     1006     :
     1007   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1008   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1009     (input  p-obj-type
     1010     ,input  p-obj-code
     1011     ,input  'shift-on=request'
     1012     ,output v-shift-on
     1013     ) no-error .
     1014       if error-status :error
     1015       then do:
     1016         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1017         undo, return error v-error .
     1018       end.
     1019       if v-shift-on = true
     1020       then do:
     1021         find first buf_shift-obj share-lock
     1022           where buf_shift-obj.obj-type   = p-obj-type
     1023             and buf_shift-obj.obj-code   = p-obj-code
     1024             and buf_shift-obj.shift-date > p-fact-date
     1025           use-index pi
     1026           no-error .
     1027         if not available buf_shift-obj
     1028         or buf_shift-obj.status_ <> 'зкр':U
     1029         then do:
     1030           find last buf_shift-obj
     1031             where buf_shift-obj.obj-type = p-obj-type
     1032               and buf_shift-obj.obj-code = p-obj-code
     1033               and buf_shift-obj.status_  = 'зкр':U
     1034             use-index stts
     1035             no-error .
     1036           if available buf_shift-obj
     1037           then do:
     1038             assign
     1039               v-extra-message =
     1040                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1041                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1042                               )
     1043             .
     1044           end.
     1045           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1046           undo, return error v-error .
     1047         end.
     1048       end.
     1049     end.
     1050   end procedure.
     1051   procedure factord-end-day :
     1052     define input  parameter p-fact-date            as date    no-undo .
     1053     define output parameter p-day-end-fact-order   as decimal no-undo .
     1054     do
     1055     on error undo, return error return-value
     1056     :
     1057       if p-fact-date = ?
     1058       then do:
     1059         return error "Не указана фактическая дата" .
     1060       end.
     1061       assign
     1062         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1063       .
     1064     end.
     1065   end procedure.
     1066   procedure factord-to-date :
     1067     define input  parameter p-fact-order as decimal no-undo .
     1068     define output parameter p-fact-date  as date    no-undo .
     1069     define variable v-ref-date  as date      no-undo .
     1070     define variable v-ref-delta as integer   no-undo .
     1071     do
     1072     on error undo, return error return-value
     1073     :
     1074       if p-fact-order = ?
     1075       or p-fact-order = 0
     1076       then do:
     1077         return error "Не указан fact-order" .
     1078       end.
     1079       assign
     1080         v-ref-date  = date(1, 1, 2000)
     1081       .
     1082       assign
     1083         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1084       .
     1085       assign
     1086         p-fact-date = v-ref-date + v-ref-delta
     1087       .
     1088     end.
     1089   end procedure.
     1090   procedure factord-to-fact-num :
     1091     define input  parameter p-fact-order as decimal no-undo .
     1092     define output parameter p-fact-num   as integer no-undo .
     1093     define variable v-fact-order-trunc as decimal no-undo .
     1094     do
     1095     on error undo, return error return-value
     1096     :
     1097       if p-fact-order = ?
     1098       or p-fact-order = 0
     1099       then do:
     1100         return error "Не указан fact-order" .
     1101       end.
     1102       assign
     1103        v-fact-order-trunc = truncate(p-fact-order, 2)
     1104       .
     1105       assign
     1106         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1107       .
     1108     end.
     1109   end procedure.
     1110   procedure factord-to-shift-num :
     1111     define input  parameter p-fact-order as decimal no-undo .
     1112     define output parameter p-shift-num   as integer no-undo .
     1113     define variable  p-shift-numd  as decimal   no-undo .
     1114     define variable v-fact-order-trunc as decimal no-undo .
     1115     do
     1116     on error undo, return error return-value
     1117     :
     1118       if p-fact-order = ?
     1119       or p-fact-order = 0
     1120       then do:
     1121         return error "Не указан fact-order" .
     1122       end.
     1123       assign
     1124        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1125       .
     1126       if v-fact-order-trunc < 0.5 then do:
     1127         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1128       end.
     1129       assign
     1130         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1131         .
     1132        assign
     1133         p-shift-num = truncate (p-shift-numd , 0)
     1134       .
     1135     end.
     1136   end procedure.
     1137   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1138     define variable v-cntxt-db-num        as integer   no-undo .
     1139     define variable v-cntxt-userid        as character no-undo .
     1140     define variable v-cntxt-level         as character no-undo .
     1141     define variable v-cntxt-host-code-obj as integer   no-undo .
     1142     define variable v-cntxt-obj-type      as character no-undo .
     1143     define variable v-cntxt-obj-code      as integer   no-undo .
     1144     define variable v-cntxt-db-num-obj    as integer   no-undo .
     1145     define variable v-cntxt-is-admin      as logical   no-undo .
     1146   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1147     run mainmenu_getcntxt in parparentproc
     1148       (output v-cntxt-db-num
     1149       ,output v-cntxt-userid
     1150       ,output v-cntxt-level
     1151       ,output v-cntxt-host-code-obj
     1152       ,output v-cntxt-obj-type
     1153       ,output v-cntxt-obj-code
     1154       ,output v-cntxt-db-num-obj
     1155       ,output v-cntxt-is-admin
     1156       ) .
     1157   define variable v-is-ok as logical no-undo .
     1158   define variable v-from-date as date no-undo .
     1159   define variable v-to-date as date no-undo .
     1160   DEFINE VARIABLE v-today as date no-undo .
     1161   DEFINE VARIABLE v-time as integer no-undo .
     1162   define variable v-debet like ub.fin-doc.sum-doc no-undo .
     1163   define variable v-credit like ub.fin-doc.sum-doc no-undo .
     1164   define variable v-debet-ob like ub.fin-doc.sum-doc no-undo .
     1165   define variable v-credit-ob like ub.fin-doc.sum-doc no-undo .
     1166   define variable v-my-side as logical no-undo .
     1167   define variable line as character no-undo .
     1168   define variable date_string as character no-undo .
     1169   define variable v-from-sum as decimal no-undo .
     1170   define variable v-from-sum-i as decimal no-undo .
     1171   define variable v-from-sum-e as decimal no-undo .
     1172   define variable v-to-sum-arh as decimal no-undo .
     1173   define variable v-to-sum-doc as decimal no-undo .
     1174   define variable v-last-doc-str as character no-undo .
     1175   define variable v-last-doc-fact-date as date no-undo .
     1176   define variable v-from-fact-order like ub.fin-doc.fact-order no-undo .
     1177   define variable v-from-fact-order-i like ub.fin-doc.fact-order no-undo .
     1178   define variable v-from-fact-order-e like ub.fin-doc.fact-order no-undo .
     1179   define variable v-to-fact-order like ub.fin-doc.fact-order no-undo .
     1180   define variable v-vo as character no-undo .
     1181   define variable v-debet-str as character no-undo .
     1182   define variable v-credit-str as character no-undo .
     1183   define variable v-c-schet like ub.fin-doc.receiver-c-schet no-undo .
     1184   define variable glog as logical no-undo .
     1185   define buffer buf_fin-schet for ub.fin-schet.
     1186   define buffer buf_currency for ub.currency.
     1187   define buffer buf_fin-doc for ub.fin-doc.
     1188   define buffer last_fin-doc for ub.fin-doc.
     1189   define buffer buf_fin-bank for ub.fin-bank.
     1190   define buffer buf_clients for ub.clients.
     1191   define buffer buf_arh-fin-doc-schet for ub.arh-fin-doc-schet.
     1192   define buffer buf_sysconf for ub.sysconf.
     1193   DEFINE FRAME extract
     1194   v-vo COLUMN-LABEL "ВО" format "X(4)"
     1195   buf_fin-doc.prn-doc-code COLUMN-LABEL "Номер документа"
     1196   buf_fin-doc.receiver-c-schet COLUMn-LABEL "Номер корр. счета"
     1197   v-debet COLUMN-LABEL "Дебет!(-)"
     1198   v-credit COLUMN-LABEL "Кредит!(+)"
     1199   HEADER  string( "Страница " ) format "X(9)" AT 105 PAGE-NUMBER(PrnLibStream) AT 115 FORMAT ">>9" SKIP
     1200   Line format "X(134)"
     1201   with width 136 down  stream-io use-text  .
     1202   do
     1203   on error undo, return error return-value
     1204   :
     1205   define variable vss-include-info10 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1206   do:
     1207     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
     1208       (input  v-cntxt-db-num
     1209       ,input  v-cntxt-userid
     1210       ,input  0
     1211       ,input  'actn_reports_print':U
     1212       ,input  'firm':U
     1213       ,input  v-cntxt-host-code-obj
     1214       ,input  '':U
     1215       ,input  0
     1216       ,input  0
     1217       ,input  0
     1218       ,input  0
     1219       ,input  true
     1220       ,output glog
     1221       )  .
     1222   end.
     1223     if not glog then return.
     1224     run cur-time in this-procedure(output v-today, output v-time).
     1225     assign
     1226     v-from-date = v-today - 1
     1227     v-to-date = v-today - 1
     1228     .
     1229     run gbl/get-per.w (
     1230                       OUTPUT v-is-ok
     1231                       ,input-output v-from-date
     1232                       ,input-output v-to-date
     1233                       ).
     1234     if not v-is-ok then return.
     1235     Line = fill("-", 134).
     1236     date_string = replace(cur-time-string-sec(), chr(47), ".":U) .
     1237     find first buf_fin-schet no-lock where
     1238               buf_fin-schet.host-code = p-host-code
     1239           AND buf_fin-schet.code-schet = p-code-schet no-error .
     1240     if not available buf_fin-schet then do:
     1241       return error .
     1242     end.
     1243     find first buf_fin-bank no-lock where
     1244             buf_fin-bank.host-code = buf_fin-schet.host-code
     1245       AND  buf_fin-bank.code-bank = buf_fin-schet.code-bank no-error .
     1246     if not available buf_fin-bank then do:
     1247       return error .
     1248     end.
     1249     find first buf_clients no-lock where
     1250               buf_clients.obj-type = buf_fin-schet.cli-type
     1251           AND buf_clients.obj-code = buf_fin-schet.cli-code no-error .
     1252     if not available buf_clients then do:
     1253       return error .
     1254     end.
     1255     if buf_clients.obj-type = 'орг':U
     1256     and buf_Clients.obj-code = p-host-code
     1257     then do:
     1258       assign
     1259       v-my-side = yes
     1260       .
     1261     end.
     1262     find first buf_currency no-lock where
     1263               buf_currency.curr-code = buf_fin-schet.curr-code no-error .
     1264     if not available buf_currency then do:
     1265       return error .
     1266     end.
     1267     run day-begin-fact-order (
     1268         input  v-from-date
     1269       ,output v-from-fact-order) .
     1270     run factord-end-day (
     1271         input  v-to-date
     1272       ,output v-to-fact-order) .
     1273     find last last_fin-doc no-lock where
     1274               last_fin-doc.host-code = p-host-code
     1275           AND last_fin-doc.status_ = 'факт':U
     1276           AND last_fin-doc.fact-order < v-from-fact-order
     1277           AND last_fin-doc.receiver-code-schet = p-code-schet no-error .
     1278     if available last_fin-doc then do:
     1279       assign
     1280       v-last-doc-fact-date = last_fin-doc.fact-date
     1281       .
     1282     end.
     1283     else do:
     1284       assign
     1285       v-last-doc-fact-date = 01/01/1990
     1286       .
     1287     end.
     1288     find last last_fin-doc no-lock where
     1289               last_fin-doc.host-code = p-host-code
     1290           AND last_fin-doc.status_ = 'факт':U
     1291           AND last_fin-doc.fact-order < v-from-fact-order
     1292           AND last_fin-doc.payer-code-schet = p-code-schet no-error .
     1293     if available last_fin-doc then do:
     1294       assign
     1295       v-last-doc-fact-date = max(last_fin-doc.fact-date, v-last-doc-fact-date)
     1296       .
     1297     end.
     1298     else do:
     1299       assign
     1300       v-last-doc-fact-date = v-last-doc-fact-date
     1301       .
     1302     end.
     1303     assign
     1304     v-last-doc-str = if v-last-doc-fact-date = 01/01/1990
     1305                     then "":U
     1306                     else string(v-last-doc-fact-date, "99.99.9999":U)
     1307     .
     1308     find last  buf_arh-fin-doc-schet no-lock where
     1309               buf_arh-fin-doc-schet.host-code = p-host-code
     1310           AND buf_arh-fin-doc-schet.code-schet = p-code-schet
     1311           AND buf_arh-fin-doc-schet.calc-curr-code = buf_fin-schet.curr-code
     1312           AND buf_arh-fin-doc-schet.sum-type  = "":U
     1313           AND buf_arh-fin-doc-schet.fin-ext-doc-type = 'ппп':U
     1314           AND buf_arh-fin-doc-schet.fact-order < v-from-fact-order no-error .
     1315     if available buf_arh-fin-doc-schet then do:
     1316       assign
     1317       v-from-sum-i = (if v-my-side then buf_arh-fin-doc-schet.income else buf_arh-fin-doc-schet.expense)
     1318       v-from-fact-order-i = buf_arh-fin-doc-schet.fact-order
     1319       .
     1320     end.
     1321     find last  buf_arh-fin-doc-schet no-lock where
     1322               buf_arh-fin-doc-schet.host-code = p-host-code
     1323           AND buf_arh-fin-doc-schet.code-schet = p-code-schet
     1324           AND buf_arh-fin-doc-schet.calc-curr-code = buf_fin-schet.curr-code
     1325           AND buf_arh-fin-doc-schet.sum-type  = "":U
     1326           AND buf_arh-fin-doc-schet.fin-ext-doc-type = 'рпп':U
     1327           AND buf_arh-fin-doc-schet.fact-order < v-from-fact-order no-error .
     1328     if available buf_arh-fin-doc-schet then do:
     1329       assign
     1330       v-from-sum-e = (if v-my-side then buf_arh-fin-doc-schet.expense else buf_arh-fin-doc-schet.income)
     1331       v-from-fact-order-e = buf_arh-fin-doc-schet.fact-order
     1332       .
     1333     end.
     1334     assign
     1335     v-from-sum = if v-my-side
     1336                  then (v-from-sum-i - v-from-sum-e)
     1337                  else (v-from-sum-e - v-from-sum-i)
     1338     .
     1339     run waitfram-show in this-procedure ("Ждите...").
     1340     run prn-lib-open-stream  in this-procedure (
     1341                                                 input parParentProc
     1342                                                 ,input 62
     1343                                                 ,input yes
     1344                                                 ,input no
     1345                                                 ).
     1346     FORM with FRAME extract  .
     1347     FORM HEADER
     1348     Line format "X(134)" SKIP
     1349     "Продолжение - на следующей странице" AT 30 SKIP
     1350     with FRAME BottomFrame width 136 PAGE-BOTTOM NO-LABELS NO-BOX .
     1351     VIEW  STREAM PrnLibStream FRAME BottomFrame .
     1352     PUT  STREAM PrnLibStream unformatted
     1353     line skip(1)
     1354     SPACE(25) "ВЫПИСКА ИЗ ЛИЦЕВОГО СЧЕТА КЛИЕНТА"  space(25) date_string skip(1)
     1355     buf_fin-bank.short-name space(10) "БИК" chr(32) buf_fin-bank.bik space(10) "корр. счет" chr(32) buf_fin-bank.cor-acc skip(1)
     1356     "Наименование клиента: " buf_clients.obj-name skip(1)
     1357     "Валюта счета: " buf_currency.curr-abbr chr(47) buf_currency.okv-code chr(32) buf_currency.curr-name skip(1)
     1358     "Номер счeта: " buf_fin-schet.r-schet
     1359     skip(1)
     1360     line skip(1)
     1361     "Дата последней операции: " v-last-doc-str skip(1)
     1362     "Входящий остаток на начало дня: "  v-from-sum skip(1)
     1363     .
     1364     for each buf_arh-fin-doc-schet  no-lock where
     1365             buf_arh-fin-doc-schet.host-code = p-host-code
     1366         AND buf_arh-fin-doc-schet.code-schet = p-code-schet
     1367         AND buf_arh-fin-doc-schet.fact-order >= v-from-fact-order
     1368         AND buf_arh-fin-doc-schet.fact-order <= v-to-fact-order
     1369         AND buf_arh-fin-doc-schet.calc-curr-code = buf_fin-schet.curr-code
     1370         AND buf_arh-fin-doc-schet.sum-type = "":U,
     1371        first buf_fin-doc no-lock where
     1372                 buf_fin-doc.fin-doc-code = buf_arh-fin-doc-schet.fin-doc-code
     1373             AND buf_fin-doc.host-code = buf_arh-fin-doc-schet.host-code:
     1374       CASE buf_fin-doc.fin-ext-doc-type:
     1375         when 'рпп':U then do:
     1376           assign
     1377           v-vo = "01":U
     1378           v-c-schet = buf_Fin-doc.receiver-c-schet
     1379           v-debet = (if v-my-side then buf_fin-doc.sum-doc else 0)
     1380           v-credit = (if v-my-side then 0 else buf_fin-doc.sum-doc)
     1381           v-debet-str   = (if v-my-side then string(buf_fin-doc.sum-doc) else "":U)
     1382           v-credit-str   = (if v-my-side then "":U else string(buf_fin-doc.sum-doc))
     1383           v-debet-ob = v-debet-ob + v-debet
     1384           v-credit-ob = v-credit-ob + v-credit
     1385           .
     1386         end.
     1387         when 'ппп':U
     1388         then do:
     1389           assign
     1390           v-vo = "01":U
     1391           v-c-schet = buf_Fin-doc.payer-c-schet
     1392           v-credit = (if v-my-side then buf_fin-doc.sum-doc else 0)
     1393           v-debet = (if v-my-side then 0 else buf_fin-doc.sum-doc)
     1394           v-credit-str   = (if v-my-side then string(buf_fin-doc.sum-doc) else "":U)
     1395           v-debet-str = (if v-my-side then "":U else string(buf_fin-doc.sum-doc))
     1396           v-credit-ob = v-credit-ob + v-credit
     1397           v-debet-ob = v-debet-ob + v-debet
     1398           .
     1399         end.
     1400       END CASE.
     1401       Display STREAM PrnLibStream
     1402       v-vo
     1403       buf_fin-doc.prn-doc-code
     1404       v-c-schet @ buf_fin-doc.receiver-c-schet
     1405       v-debet
     1406       v-credit
     1407       with FRAME extract .
     1408       DOWN STREAM PrnLibStream
     1409       with frame extract .
     1410     end.
     1411     assign
     1412     v-to-sum-doc = v-from-sum - v-debet-ob + v-credit-ob
     1413     .
     1414     DOWN STREAM PrnLibStream 1
     1415     with frame extract.
     1416     display stream PrnLibstream
     1417     "ИТОГО" @ buf_fin-doc.prn-doc-code
     1418     "Обороты по дебету" @ v-debet
     1419     "Обороты по кредиту" @ v-credit
     1420     with FRAME extract .
     1421     DOWN STREAM PrnLibStream 2
     1422     with frame extract.
     1423     display stream PrnLibstream
     1424     "Сумма в валюте счета:" @ v-vo
     1425     v-debet-ob @ v-debet
     1426     v-credit-ob @ v-credit
     1427     with FRAME extract .
     1428     DOWN STREAM PrnLibStream 2
     1429     with frame extract.
     1430     Put stream Prnlibstream unformatted
     1431     substitute("Исходящий остаток на конец дня &1: &2", string(v-to-date, "99.99.9999":U) , v-to-sum-doc) skip(1)
     1432     line skip.
     1433     HIDE  STREAM PrnLibStream FRAME BottomFrame .
     1434     HIDE  STREAM PrnLibStream FRAME extract.
     1435     output  STREAM PrnLibStream CLOSE.
     1436     run waitfram-hide in this-procedure .
     1437     run prn-lib-prn-file in this-procedure (
     1438                                               input parParentProc
     1439                                               ,input 0
     1440                                               ).
     1441   end.
