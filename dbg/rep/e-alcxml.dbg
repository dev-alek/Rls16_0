     1049   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1050   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1051   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1052   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1053   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1054   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1055   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1056   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1057         adm-object-hdl = FRAME F-Main:HANDLE.
     1058   RUN ensure-broker.
     1059   THIS-PROCEDURE:ADM-DATA =
     1060        'ADM1.1~`':U +
     1061        'SmartViewer~`':U +
     1062        '~`':U +
     1063        'NO ~`':U +
     1064        '~`':U +
     1065        '~`':U +
     1066        '~`':U +
     1067        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1068           + "~`":U +
     1069        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1070        'Record-Source,Record-Target,TableIO-Target~`':U +
     1071        '~`':U +
     1072        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1073        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1074            THEN "^^":U
     1075        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1076             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1077   PROCEDURE adm-apply-entry :
     1078     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1079   END PROCEDURE.
     1080   PROCEDURE adm-destroy :
     1081    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1082   END PROCEDURE.
     1083   PROCEDURE adm-disable :
     1084       DISABLE RECT-7 fi-dir-full-name b-sel-dir tg-zip WITH FRAME F-Main.
     1085       RUN dispatch ('disable-fields':U).
     1086       RUN set-attribute-list ('ENABLED=no':U).
     1087       RETURN.
     1088   END PROCEDURE.
     1089   PROCEDURE adm-edit-attribute-list :
     1090         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1091         RETURN.
     1092   END PROCEDURE.
     1093   PROCEDURE adm-enable :
     1094       ENABLE UNLESS-HIDDEN RECT-7 fi-dir-full-name b-sel-dir tg-zip WITH FRAME F-Main.
     1095       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1096       RUN set-attribute-list ('ENABLED=yes':U).
     1097       RETURN.
     1098   END PROCEDURE.
     1099   PROCEDURE adm-exit :
     1100        RUN notify ('exit':U).
     1101     RETURN.
     1102   END PROCEDURE.
     1103   PROCEDURE adm-hide :
     1104     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1105   END PROCEDURE.
     1106   PROCEDURE adm-initialize :
     1107     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1108   END PROCEDURE.
     1109   PROCEDURE adm-show-errors :
     1110       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1111       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1112           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1113       END.
     1114       RETURN.
     1115   END PROCEDURE.
     1116   PROCEDURE adm-UIB-mode :
     1117     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1118   END PROCEDURE.
     1119   PROCEDURE adm-view :
     1120     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1121   END PROCEDURE.
     1122   PROCEDURE dispatch :
     1123       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1124       RUN broker-dispatch IN adm-broker-hdl
     1125           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1126       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1127   END PROCEDURE.
     1128   PROCEDURE ensure-broker :
     1129   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1130   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1131   DO:
     1132       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1133       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1134   END.
     1135   END PROCEDURE.
     1136   PROCEDURE get-attribute :
     1137     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1138     RUN broker-get-attribute IN adm-broker-hdl
     1139         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1140     RETURN RETURN-VALUE.
     1141   END PROCEDURE.
     1142   PROCEDURE get-attribute-list :
     1143     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1144     RUN broker-get-attribute-list IN adm-broker-hdl
     1145         (INPUT THIS-PROCEDURE,
     1146          INPUT ?,
     1147          OUTPUT p-attr-list) NO-ERROR.
     1148     RETURN.
     1149   END PROCEDURE.
     1150   PROCEDURE new-state :
     1151     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1152     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1153     RETURN.
     1154   END PROCEDURE.
     1155   PROCEDURE notify :
     1156     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1157     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1158     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1159         RETURN "ADM-ERROR":U.
     1160     RETURN.
     1161   END PROCEDURE.
     1162   PROCEDURE set-attribute-list :
     1163     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1164     RUN ensure-broker.
     1165     RUN broker-set-attribute-list IN adm-broker-hdl
     1166         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1167     RETURN.
     1168   END PROCEDURE.
     1169   PROCEDURE set-position :
     1170       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1171       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1172       IF VALID-HANDLE(adm-object-hdl) THEN
     1173       DO:
     1174         ASSIGN adm-object-hdl:ROW    =   p-row
     1175                adm-object-hdl:COLUMN =   p-col.
     1176       END.
     1177       RETURN.
     1178   END PROCEDURE.
     1179   PROCEDURE adm-display-fields :
     1180       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1181       RETURN.
     1182   END PROCEDURE.
     1183   PROCEDURE adm-open-query :
     1184     RETURN.
     1185   END PROCEDURE.
     1186   PROCEDURE adm-row-changed :
     1187         IF VALID-HANDLE(adm-object-hdl) THEN
     1188           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1189         RUN notify ('row-available':U).
     1190         RETURN.
     1191   END PROCEDURE.
     1192   PROCEDURE reposition-query :
     1193       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1194       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1195       RETURN.
     1196   END PROCEDURE.
     1197     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1198     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1199     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1200     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1201     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1202     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1203     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1204     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1205     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1206     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1207     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1208     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1209     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1210     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1211     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1212     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1213     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1214     IF "":U = "":U THEN
     1215       RUN modify-list-attribute IN adm-broker-hdl
     1216         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1217     RUN use-create-on-add(?).
     1218   PROCEDURE adm-add-record :
     1219       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1220          "must have at least one Enabled Table to perform Add.":U
     1221          VIEW-AS ALERT-BOX ERROR.
     1222       RETURN.
     1223   END PROCEDURE.
     1224   PROCEDURE adm-assign-record :
     1225    MESSAGE
     1226          "Object ":U THIS-PROCEDURE:FILE-NAME
     1227            "must have at least one Enabled Table to perform Assign.":U
     1228              VIEW-AS ALERT-BOX ERROR.
     1229      RETURN.
     1230     END PROCEDURE.
     1231   PROCEDURE adm-assign-statement :
     1232     RETURN.
     1233   END PROCEDURE.
     1234   PROCEDURE adm-cancel-record :
     1235      RETURN.
     1236     END PROCEDURE.
     1237   PROCEDURE adm-copy-record :
     1238       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1239        "must have at least one Enabled Table to perform Copy.":U
     1240          VIEW-AS ALERT-BOX ERROR.
     1241       RETURN.
     1242   END PROCEDURE.
     1243   PROCEDURE adm-create-record :
     1244      RETURN.
     1245   END PROCEDURE.
     1246   PROCEDURE adm-current-changed :
     1247     RETURN.
     1248   END PROCEDURE.
     1249   PROCEDURE adm-delete-record :
     1250    MESSAGE
     1251          "Object ":U THIS-PROCEDURE:FILE-NAME
     1252            "must have at least one Enabled Table to perform Delete.":U
     1253              VIEW-AS ALERT-BOX ERROR.
     1254       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1255       RETURN.
     1256   END PROCEDURE.
     1257   PROCEDURE adm-disable-fields :
     1258         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1259       RETURN.
     1260   END PROCEDURE.
     1261   PROCEDURE adm-enable-fields :
     1262       RETURN.
     1263   END PROCEDURE.
     1264   PROCEDURE adm-end-update :
     1265     RETURN.
     1266   END PROCEDURE.
     1267   PROCEDURE adm-reset-record :
     1268       RETURN.
     1269   END PROCEDURE.
     1270   PROCEDURE adm-update-record :
     1271       MESSAGE
     1272         "Object ":U THIS-PROCEDURE:FILE-NAME
     1273           "must have at least one Enabled Table to perform Update.":U
     1274             VIEW-AS ALERT-BOX ERROR.
     1275      RETURN.
     1276   END PROCEDURE.
     1277   PROCEDURE check-modified :
     1278   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1279   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1280   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1281   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1282     IF check-state = "check":U THEN
     1283     DO:
     1284       RUN get-link-handle IN adm-broker-hdl
     1285         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1286            OUTPUT group-target-list).
     1287       IF group-target-list NE "":U THEN
     1288       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1289         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1290         RUN check-modified IN curr-widget ('group-check':U).
     1291         IF RETURN-VALUE NE "":U THEN
     1292         DO:
     1293           RUN check-modified-message(RETURN-VALUE).
     1294           RETURN "":U.
     1295         END.
     1296       END.
     1297     END.
     1298     RETURN "":U.
     1299   END PROCEDURE.
     1300   PROCEDURE check-modified-message :
     1301     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1302        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1303           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1304        IF RETURN-VALUE = "YES":U THEN
     1305           RUN notify ('view,CONTAINER-SOURCE':U).
     1306        MESSAGE IF p-changed-table NE ? THEN
     1307           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1308           ELSE "Current values have been changed."
     1309           SKIP "  Do you wish to save those changes?"
     1310           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1311        IF ANS THEN
     1312        DO:
     1313           IF group-assign-target THEN
     1314             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1315           ELSE RUN dispatch('update-record':U).
     1316           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1317           DO:
     1318               MESSAGE "Changes to the previous record were not saved."
     1319                 VIEW-AS ALERT-BOX ERROR.
     1320               IF group-assign-target THEN
     1321                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1322               ELSE RUN dispatch ('cancel-record':U).
     1323           END.
     1324        END.
     1325        ELSE DO:
     1326          IF group-assign-target THEN
     1327             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1328          ELSE RUN dispatch('cancel-record':U).
     1329        END.
     1330        RETURN.
     1331   END PROCEDURE.
     1332   PROCEDURE get-rowid :
     1333       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1334       ASSIGN
     1335       p-table   =   adm-first-table.
     1336       RETURN.
     1337   END PROCEDURE.
     1338   PROCEDURE init-group-assign :
     1339       RUN request-attribute IN adm-broker-hdl
     1340         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1341       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1342         group-assign-target = yes.
     1343       ELSE group-assign-target = no.
     1344       RETURN.
     1345   END PROCEDURE.
     1346   PROCEDURE set-editors :
     1347       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1348       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1349       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1350       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1351       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1352       DO WHILE VALID-HANDLE (curr-widget):
     1353           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1354              curr-widget:HIDDEN = no THEN DO:
     1355             CASE p-field-setting:
     1356               WHEN "INITIALIZE":U THEN
     1357               DO:
     1358                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1359                     read-only-list +
     1360                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1361                        STRING(curr-widget).
     1362               END.
     1363               WHEN "DISABLE":U OR
     1364               WHEN "ENABLE":U THEN
     1365               DO:
     1366                   curr-widget:SENSITIVE = yes.
     1367                   RUN get-attribute ('Read-Only-Editors':U).
     1368                   IF RETURN-VALUE = ? OR
     1369                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1370                       curr-widget:READ-ONLY =
     1371                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1372               END.
     1373               WHEN "CLEAR":U THEN
     1374                   curr-widget:SCREEN-VALUE = "":U.
     1375             END CASE.
     1376           END.
     1377           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1378       END.
     1379       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1380         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1381           + '"':U).
     1382       RETURN.
     1383   END PROCEDURE.
     1384   PROCEDURE use-check-modified-all :
     1385    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1386     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1387     RETURN.
     1388   END PROCEDURE.
     1389   PROCEDURE use-create-on-add :
     1390   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1391      RETURN.
     1392   END PROCEDURE.
     1393   PROCEDURE use-initial-lock :
     1394     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1395     ASSIGN adm-initial-lock = p-attr-value.
     1396     RETURN.
     1397   END PROCEDURE.
     1398     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1399   ASSIGN
     1400          FRAME F-Main:SCROLLABLE       = FALSE
     1401          FRAME F-Main:HIDDEN           = TRUE.
     1402   ASSIGN
     1403          fi-dir-full-name:READ-ONLY IN FRAME F-Main        = TRUE.
     1404   ON CHOOSE OF b-sel-dir IN FRAME F-Main
     1405   DO:
     1406   define variable v-dir-name  as character no-undo .
     1407   define variable v-dir-type  as character no-undo .
     1408   define variable v-can-write as logical   no-undo .
     1409   define buffer buf_temp-filelist for temp-filelist .
     1410     do on error undo, return no-apply :
     1411     end.
     1412     run gbl/dir-sel.p ( output v-dir-name
     1413                       , output v-dir-type
     1414                       , output v-can-write
     1415                       ) .
     1416     if v-dir-name = "" or v-dir-name = ? then return no-apply.
     1417     if v-can-write <> yes then do :
     1418       message
     1419         "Выбранная директория не доступна для записи, выберите другую директорию."
     1420       view-as alert-box error.
     1421       return no-apply.
     1422     end.
     1423     run filelist-init in this-procedure ( input v-dir-name
     1424                                         , input yes
     1425                                         , input "xml,zip":U
     1426                                         , input ?
     1427                                         ) .
     1428     find first buf_temp-filelist no-lock no-error .
     1429     if available buf_temp-filelist then do:
     1430       message
     1431         "В директории присутствуют XML или ZIP файлы." skip
     1432         "Для формирования отчета необходимо указать пустую директорию."
     1433       view-as alert-box error.
     1434       return no-apply.
     1435     end.
     1436     assign
     1437       fi-dir-full-name = v-dir-name
     1438     .
     1439     display
     1440       fi-dir-full-name
     1441     with frame F-Main.
     1442   END.
     1443   PROCEDURE disable_UI :
     1444     HIDE FRAME F-Main.
     1445     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1446   END PROCEDURE.
     1447   PROCEDURE local-apply-layout :
     1448     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1449     assign
     1450       tg-zip = yes
     1451     .
     1452     display
     1453       tg-zip
     1454     with frame F-Main.
     1455   END PROCEDURE.
     1456   PROCEDURE local-initialize :
     1457     define buffer buf_usr-flt for ubflt.usr-flt .
     1458   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1459     run mainmenu_getcntxt in my-handle
     1460       (output v-cntxt-db-num
     1461       ,output v-cntxt-userid
     1462       ,output v-cntxt-level
     1463       ,output v-cntxt-host-code-obj
     1464       ,output v-cntxt-obj-type
     1465       ,output v-cntxt-obj-code
     1466       ,output v-cntxt-db-num-obj
     1467       ,output v-cntxt-is-admin
     1468       ) .
     1469     RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1470     find first buf_usr-flt no-lock
     1471       where buf_usr-flt.user-name  = v-cntxt-userid
     1472         and buf_usr-flt.call-point = "rep/e-alcxml.w":U
     1473     no-error .
     1474     if available buf_usr-flt then do:
     1475       assign
     1476         tg-zip           = logical( entry( 1, buf_usr-flt.list_) )
     1477         fi-dir-full-name = entry( 2 , buf_usr-flt.list_ )
     1478       .
     1479       display
     1480         tg-zip
     1481         fi-dir-full-name
     1482       with frame F-Main .
     1483     end.
     1484   END PROCEDURE.
     1485   PROCEDURE my-report :
     1486     define buffer buf_usr-flt for ubflt.usr-flt .
     1487     define buffer buf_temp-filelist for temp-filelist .
     1488     run filelist-init in this-procedure ( input fi-dir-full-name
     1489                                         , input yes
     1490                                         , input "xml,zip":U
     1491                                         , input ?
     1492                                         ) .
     1493     find first buf_temp-filelist no-lock no-error .
     1494     if available buf_temp-filelist then do:
     1495       message
     1496         "В директории присутствуют XML или ZIP файлы." skip
     1497         "Для формирования отчета необходимо указать пустую директорию."
     1498       view-as alert-box error.
     1499       return .
     1500     end.
     1501     find first buf_usr-flt exclusive-lock
     1502       where buf_usr-flt.user-name  = v-cntxt-userid
     1503         and buf_usr-flt.call-point = "rep/e-alcxml.w":U
     1504     no-error .
     1505     if not available buf_usr-flt then do:
     1506       create buf_usr-flt .
     1507       assign
     1508         buf_usr-flt.user-name  = v-cntxt-userid
     1509         buf_usr-flt.call-point = "rep/e-alcxml.w":U
     1510       .
     1511     end.
     1512     assign
     1513       buf_usr-flt.list_ = substitute( "&1,&2"
     1514                                     , string(tg-zip)
     1515                                     , fi-dir-full-name
     1516                                     )
     1517     .
     1518     run rep/alcxml01.p ( input my-handle
     1519                        , input fi-dir-full-name
     1520                        , input tg-zip
     1521                        ) .
     1522   END PROCEDURE.
     1523   PROCEDURE my-var :
     1524     define variable v-zip as logical   no-undo .
     1525     do with frame F-Main :
     1526       assign
     1527         tg-zip
     1528         fi-dir-full-name
     1529       .
     1530       assign
     1531         ReportHeader = substitute( "Формирование XML файлов в директории &1 &2 &3"
     1532                                 , fi-dir-full-name
     1533                                 , ( if tg-zip = yes then "Упаковывать отчет в zip архив" else "" )
     1534                                 )
     1535       .
     1536     end.
     1537   END PROCEDURE.
     1538   PROCEDURE state-changed :
