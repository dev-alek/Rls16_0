      562   define new global shared variable g#library  as handle no-undo .
      563   define new global shared variable g#library2 as handle no-undo .
      564   define variable var-report-r-b as character no-undo .
      565   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      566   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      567     (output var-report-r-b
      568     )  .
      569   define variable vss-include-info7 as character format "X(65)" no-undo
      570   initial "@(#)$Workfile$ $Revision$".
      571   define variable v-filelist-total-file-num           as integer      no-undo .
      572   define variable v-filelist-total-dir-num            as integer      no-undo .
      573   define variable v-filelist-main-procedure-handle    as handle       no-undo .
      574   define variable v-filelist-main-procedure-name      as character    no-undo .
      575   define temp-table temp-dirlist no-undo
      576       field dir-full-name     as character
      577       field dir-short-name    as character
      578       field need-process      as logical
      579       index xpk is primary unique dir-full-name
      580   .
      581   define temp-table temp-filelist no-undo
      582     field file-name        as character
      583     field file-name-no-ext as character
      584     field file-extension   as character
      585     field directory-name   as character
      586     field full-name        as character
      587     field dir-short-name   as character
      588     field need-process     as logical
      589     index xpk is unique primary full-name
      590     index xie1 directory-name file-name
      591     index xie2 directory-name file-name-no-ext
      592     index xie3 file-name
      593     index xie4 file-name-no-ext
      594     index xie5 need-process file-name
      595     .
      596   define stream dir-list .
      597   procedure filelist-get-file-num :
      598     define output parameter p-file-num as integer   no-undo .
      599     do
      600     on error undo, return error return-value
      601     :
      602       assign
      603         p-file-num = v-filelist-total-file-num
      604       .
      605     end.
      606   end procedure.
      607   procedure filelist-clear :
      608     do
      609     on error undo, return error return-value
      610     :
      611       define buffer buf_filelist for temp-filelist .
      612       assign
      613         v-filelist-total-file-num = 0
      614       .
      615       for each buf_filelist
      616       on error undo, return error
      617       :
      618         delete buf_filelist .
      619       end.
      620     end.
      621   end procedure.
      622   procedure filelist-init :
      623     do
      624     on error undo, return error
      625     :
      626       define input parameter p-dir-name       as character no-undo .
      627       define input parameter p-filter-ext     as logical   no-undo .
      628       define input parameter p-ext-list       as character no-undo .
      629       define input parameter p-dir-short-name as character no-undo .
      630       define buffer buf_temp-filelist for temp-filelist .
      631       if p-filter-ext = true
      632          and p-ext-list = ?
      633       or (p-filter-ext = false
      634          and p-ext-list <> ?
      635          and p-ext-list <> "":U
      636          )
      637       then do:
      638         message
      639           vss-workfile vss-revision vss-description skip
      640           "Ошибка задания входных параметров" skip
      641           "p-filter-ext" p-filter-ext skip
      642           "p-ext-list"   p-ext-list   skip
      643           view-as alert-box error .
      644         undo, return error .
      645       end.
      646       for each buf_temp-filelist
      647         where buf_temp-filelist.directory-name = p-dir-name
      648       on error undo, return error return-value
      649       :
      650         delete buf_temp-filelist .
      651       end.
      652       input stream dir-list from os-dir( p-dir-name ).
      653       define variable v-file                  as character no-undo .
      654       define variable v-path                  as character no-undo .
      655       define variable v-mask                  as character no-undo .
      656       define variable v-extension             as character no-undo .
      657       define variable v-file-name-without-ext as character no-undo .
      658       repeat
      659       on error undo, return error
      660       :
      661         import stream dir-list v-file v-path v-mask .
      662         if  v-mask <> ?
      663         and v-mask begins 'F':u
      664         then do:
      665         end.
      666         else do:
      667           next .
      668         end.
      669         if num-entries(v-file, '.':u) > 1
      670         then do:
      671           assign
      672             v-extension = entry(num-entries(v-file, '.':u), v-file,  '.':u )
      673             v-file-name-without-ext = entry(num-entries(v-file, '.':u) - 1, v-file, '.':u )
      674           .
      675         end.
      676         else do:
      677           assign
      678             v-extension = ''
      679             v-file-name-without-ext = v-file
      680           .
      681         end.
      682         if p-filter-ext = true
      683         then do:
      684           if lookup(v-extension, p-ext-list) = 0
      685           then do:
      686             next .
      687           end.
      688         end.
      689         create buf_temp-filelist .
      690         assign
      691           buf_temp-filelist.file-name        = v-file
      692           buf_temp-filelist.directory-name   = p-dir-name
      693           buf_temp-filelist.file-name-no-ext = v-file-name-without-ext
      694           buf_temp-filelist.file-extension   = v-extension
      695           buf_temp-filelist.full-name        = p-dir-name + '/':u + v-file
      696           buf_temp-filelist.dir-short-name   = p-dir-short-name
      697         .
      698         assign
      699           v-filelist-total-file-num = v-filelist-total-file-num + 1
      700         .
      701         if v-filelist-main-procedure-handle <> ?
      702         then do:
      703           run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle
      704             (input "file":U
      705             , input v-filelist-total-file-num
      706             , input buf_temp-filelist.full-name
      707             , input buf_temp-filelist.file-name
      708             ) no-error.
      709           if error-status :error
      710           then do:
      711             message
      712               vss-workfile vss-revision vss-description skip
      713               "filelist-dirlist-subdir-init" skip(1)
      714               skip "Ошибка при вызове процедуры вывода"
      715               skip "результатов сканирования каталогов."
      716               skip return-value
      717               skip trim(error-status :get-message(1))
      718                       trim(error-status :get-message(2))
      719                       trim(error-status :get-message(3))
      720               view-as alert-box error.
      721             undo, return error .
      722           end.
      723         end.
      724       end.
      725       input stream dir-list close .
      726       return.
      727     end.
      728   end procedure.
      729   procedure filelist-dirlist-init-by-list :
      730     do
      731     on error undo, return error
      732     :
      733       define input parameter p-root-dir   as character no-undo .
      734       define input parameter p-dir-list   as character no-undo .
      735       define input parameter p-filter-ext as logical   no-undo .
      736       define input parameter p-ext-list   as character no-undo .
      737       define variable v-num-appdir as integer   no-undo .
      738       do v-num-appdir = 1 to num-entries(p-dir-list)
      739       :
      740         define variable v-curr-dir  as character no-undo .
      741         assign
      742           v-curr-dir = entry(v-num-appdir, p-dir-list)
      743         .
      744         run filelist-init in this-procedure
      745           (input p-root-dir + '/':u + v-curr-dir
      746           ,input p-filter-ext
      747           ,input p-ext-list
      748           ,input v-curr-dir
      749           ) .
      750       end.
      751     end.
      752   end procedure.
      753   procedure filelist-dirlist-clear :
      754     do
      755     on error undo, return error
      756     :
      757       define buffer buf_temp-dirlist for temp-dirlist .
      758       assign
      759           v-filelist-total-dir-num = 0
      760       .
      761       for each buf_temp-dirlist
      762       on error undo, return error
      763       :
      764         delete buf_temp-dirlist .
      765       end.
      766     end.
      767   end procedure.
      768   procedure filelist-dirlist-subdir-init :
      769   define input parameter p-dir-name   as character no-undo .
      770       define buffer buf_temp-dirlist for temp-dirlist .
      771   do
      772   for buf_temp-dirlist
      773   on error undo, return error
      774   :
      775       assign
      776           file-info :file-name = p-dir-name
      777       .
      778       if file-info :full-pathname = ?
      779       or index( file-info :file-type, "D" ) = 0
      780       then do:
      781           message
      782               vss-workfile vss-revision vss-description skip
      783               "filelist-dirlist-init: Заданного каталога не существует."
      784               skip (1)
      785               skip "Задан каталог:"
      786               skip substitute( "'&1'", p-dir-name )
      787           view-as alert-box error .
      788           undo, return error .
      789       end.
      790       input stream dir-list from os-dir( p-dir-name ).
      791       define variable v-file                  as character no-undo .
      792       define variable v-path                  as character no-undo .
      793       define variable v-mask                  as character no-undo .
      794       file-in-directory:
      795       repeat
      796       on error undo, return error
      797       :
      798           import stream dir-list
      799               v-file
      800               v-path
      801               v-mask
      802           .
      803           if  v-mask = ?
      804           or index( v-mask, 'D':u ) = 0
      805           or v-file = ".":U
      806           or v-file = "..":U
      807           then do:
      808               next file-in-directory.
      809           end.
      810           else do:
      811               find first buf_temp-dirlist
      812                    where buf_temp-dirlist.dir-full-name    = v-path
      813               no-error.
      814               if not available buf_temp-dirlist
      815               then do:
      816                   create buf_temp-dirlist .
      817                   assign
      818                       buf_temp-dirlist.dir-full-name    = v-path
      819                       buf_temp-dirlist.dir-short-name   = v-file
      820                       buf_temp-dirlist.need-process     = yes
      821                   .
      822               end.
      823               assign
      824                   v-filelist-total-dir-num = v-filelist-total-dir-num + 1
      825               .
      826               if v-filelist-main-procedure-handle <> ?
      827               then do:
      828                   run value( v-filelist-main-procedure-name ) in v-filelist-main-procedure-handle (
      829                         input "dir":U
      830                       , input v-filelist-total-dir-num
      831                       , input buf_temp-dirlist.dir-full-name
      832                       , input buf_temp-dirlist.dir-short-name
      833                   ) no-error.
      834                   if error-status :error
      835                   then do:
      836                       message
      837                           vss-workfile vss-revision vss-description skip
      838                           "filelist-dirlist-subdir-init"
      839                           skip(1)
      840                           skip "Ошибка при вызове процедуры вывода"
      841                           skip "результатов сканирования каталогов."
      842                           skip return-value
      843                           skip trim(error-status :get-message(1))
      844                                trim(error-status :get-message(2))
      845                                trim(error-status :get-message(3))
      846                       view-as alert-box error.
      847                       undo, return error .
      848                   end.
      849               end.
      850           end.
      851       end.
      852       input stream dir-list close .
      853   end.
      854   end procedure.
      855   procedure filelist-dirlist-init :
      856   define input parameter p-dir-name   as character no-undo .
      857       define variable v-file  as character no-undo.
      858       define variable v-path  as character no-undo.
      859       define variable v-mask  as character no-undo.
      860       define buffer buf_temp-dirlist for temp-dirlist .
      861   do
      862   for buf_temp-dirlist
      863   on error undo, return error
      864   :
      865       assign
      866           file-info :file-name = p-dir-name
      867       .
      868       if file-info :full-pathname = ?
      869       or index( file-info :file-type, "D" ) = 0
      870       then do:
      871           message
      872               vss-workfile vss-revision vss-description skip
      873               "filelist-dirlist-init: Заданного каталога не существует."
      874               skip (1)
      875               skip "Задан каталог:"
      876               skip substitute( "'&1'", p-dir-name )
      877           view-as alert-box error .
      878           undo, return error .
      879       end.
      880       for each buf_temp-dirlist
      881          where buf_temp-dirlist.dir-full-name begins file-info :full-pathname
      882       on error undo, return error return-value
      883       :
      884           delete buf_temp-dirlist .
      885       end.
      886       create buf_temp-dirlist .
      887       assign
      888           buf_temp-dirlist.dir-full-name    = file-info :full-pathname
      889           buf_temp-dirlist.dir-short-name   = file-info :file-name
      890           buf_temp-dirlist.need-process     = yes
      891       .
      892       do
      893       while available buf_temp-dirlist
      894       on error undo, return error
      895       :
      896           run filelist-dirlist-subdir-init in this-procedure (
      897               input buf_temp-dirlist.dir-full-name
      898           ).
      899           assign
      900               buf_temp-dirlist.need-process = no
      901           .
      902           find first buf_temp-dirlist
      903                where buf_temp-dirlist.need-process = yes
      904           no-error.
      905       end.
      906   end.
      907   end procedure.
      908   procedure filelist-set-procedure-handle :
      909   define input parameter p-proc-handle    as handle           no-undo.
      910   define input parameter p-proc-name      as character        no-undo.
      911       define variable v-signature    as character    no-undo.
      912   do
      913   on error undo, return error
      914   :
      915       if p-proc-handle = ?
      916       or not valid-handle( p-proc-handle )
      917       or p-proc-handle :get-signature( p-proc-name ) = ""
      918       then do:
      919           assign
      920               v-filelist-main-procedure-handle = ?
      921               v-filelist-main-procedure-name   = ""
      922           .
      923           undo, return error "filelist-set-procedure-handle: Ошибка передачи handle основной процедуры или имени процедуры обработки результатов сканирования каталогов.".
      924       end.
      925       else do:
      926           assign
      927               v-signature = p-proc-handle :get-signature( p-proc-name )
      928           .
      929           if entry(   1, v-signature )    = "PROCEDURE":U
      930           and entry( 1, entry(  3, v-signature ), " ":U ) = "INPUT":U
      931           and entry( 3, entry(  3, v-signature ), " ":U ) = "CHARACTER":U
      932           and entry( 1, entry(  4, v-signature ), " ":U ) = "INPUT":U
      933           and entry( 3, entry(  4, v-signature ), " ":U ) = "INTEGER":U
      934           and entry( 1, entry(  5, v-signature ), " ":U ) = "INPUT":U
      935           and entry( 3, entry(  5, v-signature ), " ":U ) = "CHARACTER":U
      936           and entry( 1, entry(  6, v-signature ), " ":U ) = "INPUT":U
      937           and entry( 3, entry(  6, v-signature ), " ":U ) = "CHARACTER":U
      938           then do:
      939               assign
      940                   v-filelist-main-procedure-handle = p-proc-handle
      941                   v-filelist-main-procedure-name   = p-proc-name
      942               .
      943           end.
      944           else do:
      945               assign
      946                   v-filelist-main-procedure-handle = ?
      947                   v-filelist-main-procedure-name   = ""
      948               .
      949               undo, return error "filelist-set-procedure-handle: Ошибка задания параметров процедуры обработки результатов сканирования каталогов.".
      950           end.
      951       end.
      952   end.
      953   end procedure.
      954   procedure filelist-clear-procedure-handle :
      955   do
      956   on error undo, return error
      957   :
      958       assign
      959           v-filelist-main-procedure-handle = ?
      960           v-filelist-main-procedure-name   = ?
      961       .
      962   end.
      963   end procedure.
      964   procedure filelist-build-by-dirlist :
      965       define buffer buf_temp-dirlist      for temp-dirlist.
      966   do
      967   for buf_temp-dirlist
      968   on error undo, return error
      969   :
      970       for each buf_temp-dirlist
      971       on error undo, return error
      972       :
      973           run filelist-init in this-procedure (
      974                 input buf_temp-dirlist.dir-full-name
      975               , input no
      976               , input "":U
      977               , input buf_temp-dirlist.dir-short-name
      978           ).
      979       end.
      980   end.
      981   end procedure.
      982   procedure filelist-check-dir-exists :
      983   define input parameter p-dir-name   as character        no-undo.
      984   define output parameter p-exists    as logical          no-undo.
      985   do
      986   on error undo, return error
      987   :
      988       assign
      989           file-info :file-name = p-dir-name
      990       .
      991       if file-info :file-type <> ?
      992       and substring( file-info :file-type, 1, 1 ) = "D":U
      993       then do:
      994           assign
      995               p-exists = yes
      996           .
      997       end.
      998       else do:
      999           assign
     1000               p-exists = no
     1001           .
     1002       end.
     1003   end.
     1004   end procedure.
