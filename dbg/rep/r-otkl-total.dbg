     4086   DEFINE variable pshift-date1           LIKE ub.shift-obj.shift-date NO-UNDO.
     4087   DEFINE variable pshift-num1            LIKE ub.shift-obj.shift-num NO-UNDO.
     4088   DEFINE variable p-previous-shift-date  AS DATE      NO-UNDO.
     4089   DEFINE VARIABLE loc-ii                 AS INTEGER   NO-UNDO INITIAL 1.
     4090   DEFINE VARIABLE for-supp-name          AS CHARACTER NO-UNDO.
     4091   DEFINE VARIABLE vdoc-num               LIKE ub.price-list.doc-num NO-UNDO.
     4092   DEFINE VARIABLE vprice-sale            LIKE ub.price-list.price-sale NO-UNDO.
     4093   DEFINE VARIABLE vroad-tax              AS DECIMAL   NO-UNDO.
     4094   DEFINE VARIABLE vexcise                AS DECIMAL   NO-UNDO.
     4095   DEFINE VARIABLE acc-other-qnty1        AS DECIMAL   NO-UNDO.
     4096   DEFINE VARIABLE acc-other-qnty2        AS DECIMAL   NO-UNDO.
     4097   DEFINE VARIABLE acc-other-netto        AS DECIMAL   NO-UNDO.
     4098   DEFINE VARIABLE acc-other-found        AS LOGICAL   NO-UNDO.
     4099   DEFINE VARIABLE acc-cli-qnty1          AS DECIMAL   NO-UNDO.
     4100   DEFINE VARIABLE acc-cli-qnty2          AS DECIMAL   NO-UNDO.
     4101   DEFINE VARIABLE acc-cli-netto          AS DECIMAL   NO-UNDO.
     4102   DEFINE VARIABLE acc-cli-found          AS LOGICAL   NO-UNDO.
     4103   DEFINE VARIABLE current-cli            AS INTEGER   NO-UNDO.
     4104   DEFINE VARIABLE current-cli-type       AS CHARACTER NO-UNDO.
     4105   DEFINE VARIABLE dop-sum                AS DECIMAL   NO-UNDO.
     4106   DEFINE VARIABLE dop-qnty               AS DECIMAL   NO-UNDO.
     4107   DEFINE VARIABLE dop-kg                 AS DECIMAL   NO-UNDO.
     4108   DEFINE VARIABLE found-in-previous      AS LOGICAL   NO-UNDO.
     4109   DEFINE VARIABLE mc                     LIKE ub.bar-code.b-code NO-UNDO.
     4110   DEFINE VARIABLE v-attr-value           AS CHARACTER NO-UNDO.
     4111   DEFINE VARIABLE v-attr-type            AS CHARACTER NO-UNDO.
     4112   DEFINE VARIABLE v-sum-base             LIKE ub.ot-line.sum-base NO-UNDO.
     4113   DEFINE VARIABLE p-base-code            AS INTEGER   NO-UNDO.
     4114   DEFINE VARIABLE v-qnty1                AS DECIMAL   NO-UNDO.
     4115   DEFINE VARIABLE v-qnty2                AS DECIMAL   NO-UNDO.
     4116   define variable v-InfoSectionsTotal    as class     InfoSectionsTotal no-undo .
     4117   define variable v-InfoSection          as class     InfoSection       no-undo .
     4118   define variable iNum                   as integer   no-undo .
     4119   define variable v-otkl-fact-volue      as decimal   no-undo .
     4120   define variable v-otkl-density         as decimal   no-undo FORMAT "->>,>>9.999":U .
     4121   define variable v-otkl-temp            as decimal   no-undo .
     4122   define variable v-otkl-water           as decimal   no-undo .
     4123   define variable v-value                as character no-undo .
     4124   define variable v-type                 as character no-undo .
     4125   define variable v-date                 as character no-undo .
     4126   define variable v-time                 as character no-undo .
     4127   define variable v-vid-ok               as logical   no-undo .
     4128   define variable v-vid-mes              as character no-undo .
     4129   define variable v-vid-action           as integer   no-undo .
     4130   define variable v-vid-param            as longchar  no-undo .
     4131   define variable v-computer-name        as character no-undo .
     4132   define variable v-computer-tcp-name    as character no-undo .
     4133   define variable v-computer-ip-addr     as character no-undo .
     4134   define variable v-computer-login-name  as character no-undo .
     4135   define variable v-computer-process-pid as integer   no-undo .
     4136   DEFINE TEMP-TABLE t-2 no-undo
     4137     FIELD gds-code     like ub.goods.gds-code
     4138     FIELD artic        like ub.goods.artic
     4139     FIELD prod-type    like ub.goods.prod-type
     4140     FIELD prod-code    like ub.goods.prod-code
     4141     FIELD qnty1-before as decimal FORMAT "->>>>9.99"
     4142     FIELD qnty2-before as decimal FORMAT "->>>>9.99"
     4143     FIELD qnty1-after  as decimal FORMAT "->>>>9.99"
     4144     FIELD qnty2-after  as decimal FORMAT "->>>>9.99"
     4145     FIELD last-price   as decimal FORMAT ">>>>9.99"
     4146     FIELD gds-name     like ub.goods.gds-name FORMAT "X(12)"
     4147     field pl-code      like ub.rvs-line.pl-code
     4148     FIELD lines        as integer
     4149     INDEX pi IS UNIQUE primary
     4150     gds-code pl-code
     4151     INDEX art IS UNIQUE
     4152     artic
     4153     prod-type
     4154     prod-code
     4155     .
     4156   pshift-date1 = pshift-date .
     4157   p-previous-shift-date = pshift-date .
     4158   pshift-num1 = pshift-num .
     4159   define buffer end_shift-obj      for ub.shift-obj .
     4160   define buffer previous-shift-obj for ub.shift-obj.
     4161   define variable fo      as decimal no-undo init 0.
     4162   define variable prev-fo as decimal no-undo init 0.
     4163   define variable moving  as logical no-undo init yes.
     4164   find first end_shift-obj share-lock
     4165     where end_shift-obj.obj-type   = pobj-type
     4166       and end_shift-obj.obj-code   = pobj-code
     4167       and end_shift-obj.shift-date = pshift-date1
     4168       and end_shift-obj.shift-num  = pshift-num1
     4169       no-error.
     4170   if not available end_shift-obj then do:
     4171     message
     4172       vss-workfile vss-revision vss-description skip
     4173       substitute("Не найдена смена с порядковым номером &1 от &2 для объекта &3 &4", pshift-num1, pshift-date1, pobj-type, pobj-code ) skip
     4174       view-as alert-box error .
     4175     return error.
     4176   end.
     4177   else do:
     4178     assign
     4179       fo = end_shift-obj.fact-order
     4180     .
     4181   end.
     4182   find last previous-shift-obj share-lock
     4183     where previous-shift-obj.obj-type = pobj-type
     4184       and previous-shift-obj.obj-code = pobj-code
     4185       and (( previous-shift-obj.shift-date = pshift-date
     4186              and previous-shift-obj.shift-num < pshift-num
     4187            )
     4188            or previous-shift-obj.shift-date < pshift-date
     4189           )
     4190       use-index pi no-error.
     4191   if available previous-shift-obj then do:
     4192       if  previous-shift-obj.shift-date < p-previous-shift-date then do:
     4193         run day-begin-fact-order in this-procedure (
     4194                                                 input  p-previous-shift-date
     4195                                                ,output prev-fo).
     4196       end.
     4197       else do:
     4198       assign
     4199         prev-fo = previous-shift-obj.fact-order
     4200       .
     4201       end.
     4202   end.
     4203   DEFINE BUFFER previous-rvs-doc    FOR ub.rvs-doc.
     4204   DEFINE BUFFER previous-rvs-line   FOR ub.rvs-line.
     4205   DEFINE BUFFER this-shift-rvs-doc  FOR ub.rvs-doc.
     4206   DEFINE BUFFER this-shift-rvs-line FOR ub.rvs-line.
     4207   DEFINE BUFFER buf_doc-line        FOR ub.doc-line.
     4208   DEFINE BUFFER buf_inv-line        FOR ub.inv-line.
     4209   DEFINE BUFFER buf_trn-doc         FOR ub.trn-doc.
     4210   FIND FIRST ub.rvs-doc NO-LOCK WHERE
     4211     ub.rvs-doc.obj-type   = pobj-type    AND
     4212     ub.rvs-doc.obj-code   = pobj-code    AND
     4213     ub.rvs-doc.rvs-code   = prvs-code    AND
     4214     ub.rvs-doc.shift-date = pshift-date  AND
     4215     ub.rvs-doc.shift-num  = pshift-num   NO-ERROR.
     4216   IF NOT AVAILABLE ub.rvs-doc THEN
     4217   DO:
     4218     return error substitute("&1 &2 &3&4Не найдена сверка объект &5&6 смена &7 порядок &8"
     4219       ,vss-workfile
     4220       ,vss-revision
     4221       ,vss-description
     4222       ,chr(10)
     4223       ,pobj-type
     4224       ,pobj-code
     4225       ,pshift-date
     4226       ,pshift-num).
     4227   END.
     4228   FIND FIRST ub.sysconf NO-LOCK WHERE
     4229     ub.sysconf.host-code = ub.rvs-doc.host-code NO-ERROR.
     4230   IF NOT AVAILABLE ub.sysconf THEN
     4231   DO:
     4232     return error substitute("&1 &2 &3&4Не найдена фирма типа &5 СМН объект &6&7 смена &8 порядок &9"
     4233       ,vss-workfile
     4234       ,vss-revision
     4235       ,vss-description
     4236       ,chr(10)
     4237       ,ub.rvs-doc.host-code
     4238       ,pobj-type
     4239       ,pobj-code
     4240       ,pshift-date
     4241       ,pshift-num).
     4242   END.
     4243   ASSIGN
     4244     p-base-code = ub.sysconf.base-code.
     4245   IF AVAILABLE previous-shift-obj THEN
     4246   DO:
     4247     FIND FIRST previous-rvs-doc NO-LOCK WHERE
     4248       previous-rvs-doc.obj-type   = pobj-type                     AND
     4249       previous-rvs-doc.obj-code   = pobj-code                     AND
     4250       previous-rvs-doc.shift-date = previous-shift-obj.shift-date AND
     4251       previous-rvs-doc.shift-num  = previous-shift-obj.shift-num  AND
     4252       previous-rvs-doc.status_    = 'факт':U                       AND
     4253       previous-rvs-doc.rvs-type   = 'смена':U                  NO-ERROR.
     4254   END.
     4255   define temp-table temp-rvs no-undo
     4256     FIELD gds-code      as integer
     4257     FIELD shift-date    like ub.rvs-doc.shift-date
     4258     FIELD shift-num     like ub.rvs-doc.shift-num
     4259     field prod-type     like ub.goods.prod-type
     4260     field prod-code     like ub.goods.prod-code
     4261     field artic         like ub.goods.artic
     4262     Field qnty1         as decimal
     4263     field qnty2         as decimal
     4264     field qnty3         as decimal
     4265     field qnty4         as decimal
     4266     field temp1         as decimal
     4267     field temp2         as decimal
     4268     field density1      as decimal
     4269     field density2      as decimal
     4270     field water1        as decimal
     4271     field water2        as decimal
     4272     field pl-code       as integer
     4273     field rvs-error     as logical
     4274     field delta-qnty    as decimal
     4275     field delta-temp    as decimal
     4276     field delta-density as decimal
     4277     field delta-water   as decimal
     4278     field list-otkl     as character
     4279     INDEX pi IS UNIQUE PRIMARY gds-code pl-code artic prod-type prod-code
     4280     .
     4281   for each temp-rvs:
     4282     delete temp-rvs .
     4283   end.
     4284   FOR EACH ub.rvs-line NO-LOCK WHERE
     4285     ub.rvs-line.rvs-code = ub.rvs-doc.rvs-code AND
     4286     ub.rvs-line.obj-type = ub.rvs-doc.obj-type AND
     4287     ub.rvs-line.obj-code = ub.rvs-doc.obj-code
     4288     BREAK BY ub.rvs-line.gds-code :
     4289     FIND FIRST temp-rvs WHERE temp-rvs.gds-code = ub.rvs-line.gds-code and temp-rvs.pl-code = ub.rvs-line.pl-code NO-ERROR.
     4290     IF NOT AVAILABLE temp-rvs THEN
     4291     DO:
     4292       v-value = ''.
     4293       run gds-attr-value in this-procedure (
     4294         input ub.rvs-line.gds-code
     4295         ,input 'ptrl-as-good':U
     4296         ,output v-value
     4297         ,output v-type) no-error.
     4298       if not logical(v-value) then
     4299       do:
     4300         FIND FIRST ub.goods NO-LOCK WHERE ub.goods.gds-code = ub.rvs-line.gds-code NO-ERROR.
     4301         IF AVAILABLE ub.goods THEN
     4302         DO:
     4303           create temp-rvs .
     4304           assign
     4305             temp-rvs.gds-code  = ub.rvs-line.gds-code
     4306             temp-rvs.pl-code   = ub.rvs-line.pl-code
     4307             temp-rvs.artic     = ub.goods.artic
     4308             temp-rvs.prod-type = ub.goods.prod-type
     4309             temp-rvs.prod-code = ub.goods.prod-code
     4310             temp-rvs.qnty4     = ub.rvs-line.state-measure-qnty
     4311             temp-rvs.density2  = ub.rvs-line.density
     4312             temp-rvs.temp2     = ub.rvs-line.temperature
     4313             temp-rvs.water2    = ub.rvs-line.level-water
     4314             .
     4315         end.
     4316       end.
     4317     end.
     4318   end.
     4319   FOR EACH temp-rvs NO-LOCK BREAK BY temp-rvs.gds-code :
     4320     IF AVAILABLE previous-rvs-doc THEN
     4321     DO:
     4322       FOR EACH previous-rvs-line NO-LOCK WHERE
     4323         previous-rvs-line.rvs-code = previous-rvs-doc.rvs-code AND
     4324         previous-rvs-line.gds-code = temp-rvs.gds-code
     4325         and previous-rvs-line.pl-code = temp-rvs.pl-code              :
     4326         ASSIGN
     4327           temp-rvs.qnty1      = temp-rvs.qnty1 + previous-rvs-line.state-measure-qnty
     4328           temp-rvs.gds-code   = previous-rvs-line.gds-code
     4329           temp-rvs.pl-code    = previous-rvs-line.pl-code
     4330           temp-rvs.shift-date = previous-rvs-doc.shift-date
     4331           temp-rvs.shift-num  = previous-rvs-doc.shift-num
     4332           temp-rvs.density1   = previous-rvs-line.density
     4333           temp-rvs.temp1      = previous-rvs-line.temperature
     4334           temp-rvs.water1     = previous-rvs-line.level-water
     4335           .
     4336       END.
     4337     END.
     4338   end.
     4339   FOR EACH  ub.trn-doc  NO-LOCK
     4340     WHERE ub.trn-doc.obj-type   = pobj-type
     4341     AND ub.trn-doc.obj-code   = pobj-code
     4342     AND ub.trn-doc.fact-order >= prev-fo
     4343     AND ub.trn-doc.status_    = 'факт':U
     4344     AND ub.trn-doc.doc-type   = 'при':U
     4345     , EACH  ub.doc-line NO-LOCK WHERE
     4346     ub.doc-line.doc-code = ub.trn-doc.doc-code
     4347     , FIRST temp-rvs                 WHERE
     4348     temp-rvs.artic     = ub.doc-line.artic     AND
     4349     temp-rvs.prod-type = ub.doc-line.prod-type AND
     4350     temp-rvs.prod-code = ub.doc-line.prod-code
     4351     BREAK BY ub.doc-line.artic
     4352     BY ub.doc-line.prod-type
     4353     BY ub.doc-line.prod-code
     4354     by ub.trn-doc.cli-code
     4355     :
     4356     for each ub.doc-pl no-lock where ub.doc-pl.gds-code = temp-rvs.gds-code and ub.doc-pl.obj-code = pobj-code
     4357       and ub.doc-pl.obj-type = pobj-type and ub.doc-pl.out-code = ub.doc-line.doc-code and temp-rvs.pl-code = ub.doc-pl.pl-code:
     4358       assign
     4359         temp-rvs.qnty2 = temp-rvs.qnty2 + ub.doc-pl.fact-qnty
     4360         .
     4361     end.
     4362   END.
     4363   FOR EACH  ub.trn-doc  NO-LOCK
     4364     WHERE ub.trn-doc.obj-type   = pobj-type
     4365     AND ub.trn-doc.obj-code   = pobj-code
     4366     AND ub.trn-doc.fact-order >= prev-fo
     4367     AND ub.trn-doc.status_    = 'факт':U
     4368     AND ub.trn-doc.doc-type   = 'рас':U
     4369     , EACH  ub.doc-line NO-LOCK WHERE
     4370     ub.doc-line.doc-code = ub.trn-doc.doc-code
     4371     , FIRST temp-rvs                 WHERE
     4372     temp-rvs.artic     = ub.doc-line.artic     AND
     4373     temp-rvs.prod-type = ub.doc-line.prod-type AND
     4374     temp-rvs.prod-code = ub.doc-line.prod-code
     4375     BREAK BY ub.doc-line.artic
     4376     BY ub.doc-line.prod-type
     4377     BY ub.doc-line.prod-code
     4378     by ub.trn-doc.cli-code
     4379     :
     4380     for each ub.doc-pl no-lock where ub.doc-pl.gds-code = temp-rvs.gds-code and ub.doc-pl.obj-code = pobj-code
     4381       and ub.doc-pl.obj-type = pobj-type and ub.doc-pl.out-code = ub.doc-line.doc-code and temp-rvs.pl-code = ub.doc-pl.pl-code:
     4382       assign
     4383         temp-rvs.qnty3 = temp-rvs.qnty3 + ub.doc-pl.fact-qnty
     4384         .
     4385     end.
     4386   END.
     4387   define variable vss-include-info23 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     4388   empty temp-table thbjattr_thbj-attr.
     4389   run adm/shattri.p (
     4390      input "get":U
     4391     ,input pobj-type
     4392     ,input pobj-code
     4393     ,input 'petrol':U
     4394     ,input  ""
     4395     ,output v-value-character
     4396     ,output v-value-date
     4397     ,output v-value-decimal
     4398     ,output v-value-integer
     4399     ,output v-value-logical
     4400     ,output par-type
     4401     ,INPUT-OUTPUT TABLE thbjattr_thbj-attr
     4402     ) no-error .
     4403   for each thbjattr_thbj-attr :
     4404     if thbjattr_thbj-attr.prop-code = 'otkl-fact-volue':U then assign v-otkl-fact-volue = thbjattr_thbj-attr.property-value-decimal .
     4405   end.
     4406   for each thbjattr_thbj-attr :
     4407     if thbjattr_thbj-attr.prop-code = 'otkl-water':U then assign v-otkl-water = thbjattr_thbj-attr.property-value-decimal .
     4408   end.
     4409   for each thbjattr_thbj-attr :
     4410     if thbjattr_thbj-attr.prop-code = 'otkl-temp':U then assign v-otkl-temp = thbjattr_thbj-attr.property-value-decimal .
     4411   end.
     4412   for each thbjattr_thbj-attr :
     4413     if thbjattr_thbj-attr.prop-code = 'otkl-density':U then assign v-otkl-density = decimal(thbjattr_thbj-attr.property-value-character) .
     4414   end.
     4415   if v-otkl-fact-volue = 0 and v-otkl-water = 0 and v-otkl-temp = 0 and (v-otkl-density = 0 or v-otkl-density = ?) then return no-apply .
     4416   for each temp-rvs no-lock:
     4417     if v-otkl-fact-volue < abs(abs(temp-rvs.qnty1 - temp-rvs.qnty4) - abs(temp-rvs.qnty2 - temp-rvs.qnty3)) then
     4418     do:
     4419       temp-rvs.rvs-error = yes .
     4420     end.
     4421     if v-otkl-temp < abs (temp-rvs.temp1 - temp-rvs.temp2) then
     4422     do:
     4423       if temp-rvs.rvs-error <> yes then
     4424       do:
     4425         temp-rvs.rvs-error = yes .
     4426       end.
     4427     end.
     4428     if v-otkl-density < abs (temp-rvs.density1 - temp-rvs.density2) then
     4429     do:
     4430       if temp-rvs.rvs-error <> yes then
     4431       do:
     4432         temp-rvs.rvs-error = yes .
     4433       end.
     4434     end.
     4435     if v-otkl-water < abs (temp-rvs.water1 - temp-rvs.water2) then
     4436     do:
     4437       if temp-rvs.rvs-error <> yes then
     4438       do:
     4439         temp-rvs.rvs-error = yes .
     4440       end.
     4441     end.
     4442     assign
     4443       temp-rvs.delta-qnty    = (abs(temp-rvs.qnty2 - temp-rvs.qnty3) - abs(temp-rvs.qnty1 - temp-rvs.qnty4))
     4444       temp-rvs.delta-density = (temp-rvs.density1 - temp-rvs.density2)
     4445       temp-rvs.delta-temp    = (temp-rvs.temp1 - temp-rvs.temp2)
     4446       temp-rvs.delta-water   = (temp-rvs.water1 - temp-rvs.water2)
     4447       temp-rvs.list-otkl     = "Объем: " + string (v-otkl-fact-volue) + ";" + "Плотность: " + string (v-otkl-density,"9.999") + ";" + "Температура: " + string (v-otkl-temp) + ";" + "Вода: " + string(v-otkl-water) .
     4448   end.
     4449   define buffer buf_temp-rvs for temp-rvs .
     4450   define buffer bf_temp-rvs  for temp-rvs .
     4451   define variable v-time-hour as integer no-undo .
     4452   define variable v-time-min  as integer no-undo .
     4453   for each buf_temp-rvs no-lock where buf_temp-rvs.rvs-error = yes :
     4454     run cur-time in this-procedure ( output v-date, output v-time).
     4455     v-time-hour = truncate(integer(v-time) / 3600, 0).
     4456     v-time-min  = (integer(v-time) - (v-time-hour * 3600)) / 60 .
     4457     run sys-time_get-comp-user-name in this-procedure
     4458       (output v-computer-name
     4459       ,output v-computer-login-name
     4460       ,output v-computer-process-pid
     4461       ) .
     4462     v-vid-action = 65 .
     4463   define variable v-initiator  as character no-undo.
     4464   case true:
     4465     when g#auto then v-initiator = "Auto".
     4466     when g#news then v-initiator = "Nws".
     4467     when g#esys then v-initiator = "Esys".
     4468     otherwise v-initiator = "User".
     4469   end case.
     4470     v-vid-param =
     4471       "UniqueIdRecordARM=" + v-initiator + chr(4) +
     4472       "NumShop=" + string(pobj-code) + chr(4) +
     4473       "PlCode=" + string (buf_temp-rvs.pl-code) + chr(4) +
     4474       "VolumeStart=" + string(buf_temp-rvs.qnty1) + chr(4) +
     4475       "DensityStart=" + string(buf_temp-rvs.density1) + chr(4) +
     4476       "TemperatureStart=" + string(buf_temp-rvs.temp1) + chr(4) +
     4477       "LevelWaterStart=" + string(buf_temp-rvs.water1) + chr(4) +
     4478       "CurrentVolume=" + string(buf_temp-rvs.qnty4) + chr(4) +
     4479       "CurrentDensity=" + string(buf_temp-rvs.density2) + chr(4) +
     4480       "CurrentTemperature=" + string(buf_temp-rvs.temp2) + chr(4) +
     4481       "CurrentLevelWater=" + string(buf_temp-rvs.water2) + chr(4) +
     4482       "DivergenceVolume=" + string(buf_temp-rvs.delta-qnty) + chr(4) +
     4483       "DivergenceDensity=" + string(buf_temp-rvs.delta-density) + chr(4) +
     4484       "DivergenceTemperature=" + string(buf_temp-rvs.delta-temp) + chr(4) +
     4485       "DivergenceLevelWater=" + string(buf_temp-rvs.delta-water) + chr(4) +
     4486       "DocNum=" + string(ub.rvs-doc.rvs-code) + chr(4) +
     4487       "PermissibleDivergence="   + string(buf_temp-rvs.list-otkl) no-error.
     4488           run trg/userlog.p (
     4489               input 'create':U
     4490               , input 'rvs-doc':U
     4491               , input ( buffer ub.rvs-doc :handle )
     4492               , input v-vid-action
     4493               , input v-vid-param
     4494               ) no-error.
     4495           if error-status :error
     4496               then
     4497           do:
     4498             return error substitute( "&2&1Ошибка при записи истории пользователя&1&3&1&4"
     4499                   , chr(10)
     4500                   , vss-workfile
     4501                   , return-value
     4502                   , error-status :get-message ( 1 ) ).
     4503           end.
     4504   end.
     4505   output to value (ibs.th.gbl.gbl-inipar:logDir + "temp-rvs.log") .
     4506   for each temp-rvs:
     4507     export temp-rvs .
     4508   end.
     4509   output close .
     4510   output to value (ibs.th.gbl.gbl-inipar:logDir + "balance.log") append.
     4511   for each temp-rvs no-lock where temp-rvs.rvs-error = yes :
     4512     put unformatted            "Идентификатор пользователя =" + v-computer-login-name skip .
     4513     put unformatted            "Дата события =" + string(v-date, "99999999") skip .
     4514     put unformatted            "Время события =" + string(v-time-hour,"99") + ":" + string(v-time-min,"99") skip .
     4515     put unformatted            "HostName ПК, на котором запущен процесс =" + string(v-computer-name) skip .
     4516     put unformatted            "Номер документа сверки =" + string (ub.rvs-doc.rvs-code) skip .
     4517     put unformatted            "№Резервуара =" + string (temp-rvs.pl-code) skip .
     4518     put unformatted            "Объем на начало смены =" + string(temp-rvs.qnty1) skip .
     4519     put unformatted            "Плотность на начало смены =" + string(temp-rvs.density1) skip .
     4520     put unformatted            "Температура на начало смены =" + string(temp-rvs.temp1) skip .
     4521     put unformatted            "Уровень воды на начало смены =" + string(temp-rvs.water1) skip .
     4522     put unformatted            "Текущий объем =" + string(temp-rvs.qnty4) skip .
     4523     put unformatted            "Текущая плотность =" + string(temp-rvs.density2) skip .
     4524     put unformatted            "Текущая температура =" + string(temp-rvs.temp2) skip .
     4525     put unformatted            "Текущий уровень воды =" + string(temp-rvs.water2) skip .
     4526     put unformatted            "Расхождение объема =" + string(temp-rvs.delta-qnty) skip .
     4527     put unformatted            "Расхождение плотности =" + string(temp-rvs.delta-density) skip .
     4528     put unformatted            "Расхождение температуры =" + string(temp-rvs.delta-temp) skip .
     4529     put unformatted            "Расхождение воды =" + string(temp-rvs.delta-water) skip .
     4530     put unformatted            "Допустимые расхождения ="   + string(temp-rvs.list-otkl) skip.
     4531     put unformatted            "________________________________________________________" skip .
     4532   end.
     4533   output close .
