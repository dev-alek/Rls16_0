     2223   procedure clcprtsl_calc-line :
     2224   define input  parameter parrec-line as recid no-undo.
     2225   define variable v-tax-date         as   date                     no-undo.
     2226   define variable v-vat-pc           like ub.doc-line.vat-pc       no-undo.
     2227   define variable varr-b             as   character                no-undo.
     2228   define variable varr-btype         as   character                no-undo.
     2229   define variable varcur-base        like ub.gds-dtl.price-base    no-undo.
     2230   define variable varcur-road-tax    like ub.doc-line.road-tax     no-undo.
     2231   define variable varcur-excise      like ub.doc-line.excise       no-undo.
     2232   define variable varcur-vat-pc      like ub.doc-line.vat-pc       no-undo.
     2233   define variable varcur-cons-vat-pc like ub.doc-line.cons-vat-pc  no-undo.
     2234   define variable varcur-slt-pc      like ub.doc-line.slt-pc       no-undo.
     2235   define variable varcur-fact-qnty   like ub.gds-dtl.fact-qnty     no-undo.
     2236   define variable varb-code          like ub.bar-code.b-code       no-undo.
     2237   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2238   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2239   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2240   define variable varexcise          like ub.price-list.excise     no-undo.
     2241   define variable varlastcur-base        like ub.gds-dtl.price-base no-undo.
     2242   define variable varlastcur-road-tax    like ub.gds-dtl.price-base no-undo.
     2243   define variable varlastcur-excise      like ub.gds-dtl.price-base     no-undo.
     2244   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2245   define variable v-varsum           as decimal                  no-undo.
     2246   define variable varprice-salef as decimal   no-undo .
     2247   define buffer bf_trn-doc             for ub.trn-doc.
     2248   define buffer bf_doc-line            for ub.doc-line.
     2249   define buffer bf_gds-dtl             for ub.gds-dtl.
     2250   define buffer bf_goods               for ub.goods.
     2251   define buffer bf_parts               for ub.parts.
     2252   define buffer bf_sysconf             for ub.sysconf.
     2253   define buffer bf_tt-allsum-line      for tt-allsum-line.
     2254   define buffer bfs_tt-allsum-line     for tt-allsum-line.
     2255   define buffer bfo_tt-allsum-line     for tt-allsum-line.
     2256   define buffer bfos_tt-allsum-line    for tt-allsum-line.
     2257   define buffer buf_parts        for ub.parts.
     2258   v-calcbypart = no.
     2259   do on error undo, return error return-value :
     2260   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     2261   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     2262     (output varr-b
     2263     )  .
     2264     find first bf_doc-line where recid (bf_doc-line) = parrec-line no-lock.
     2265     find first bf_trn-doc where bf_trn-doc.doc-code = bf_doc-line.doc-code no-lock.
     2266     find first bf_goods where bf_goods.artic     = bf_doc-line.artic     and
     2267                               bf_goods.prod-type = bf_doc-line.prod-type and
     2268                               bf_goods.prod-code = bf_doc-line.prod-code no-lock.
     2269     if bf_trn-doc.fact-date <> ?        then do:
     2270       assign v-tax-date = bf_trn-doc.fact-date.
     2271     end.
     2272     else do:
     2273       assign v-tax-date = ?.
     2274     end.
