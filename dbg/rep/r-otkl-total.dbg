     2841   procedure gds-attr-value :
     2842     define input  parameter p-gds-code as integer   no-undo .
     2843     define input  parameter p-code     as character no-undo .
     2844     define output parameter p-value    as character no-undo .
     2845     define output parameter p-type     as character no-undo .
     2846     do
     2847     on error undo, return error
     2848     :
     2849           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-value in g#attr-lib
     2850         (input  p-gds-code
