     3378   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     3379   define variable par-type          as character no-undo.
     3380   define variable v-value-character as character no-undo .
     3381   define variable v-value-date      as date      no-undo .
     3382   define variable v-value-decimal   as decimal   no-undo .
