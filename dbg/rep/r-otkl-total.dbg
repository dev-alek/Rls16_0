     1800   price-rubl-without-tax-salecur = price-rubl-with-tax-salecur - vat-rubl-salecur - slt-rubl-salecur - road-tax-rubl-salecur.
     1801   end.
     1802   create bf_tt-allsum.
     1803   assign
     1804     bf_tt-allsum.sum-type = 'основная_сумма':U.
     1805   assign
     1806     bf_tt-allsum.fact-qnty          =  cl_tt-clcparts.fact-qnty
