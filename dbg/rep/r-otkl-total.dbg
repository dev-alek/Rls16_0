     2531               varlastcur-road-tax = varroad-tax
     2532               varlastcur-excise   = varexcise
     2533               varcur-base         = varcur-base      + varprice-sale * bf_gds-dtl.fact-qnty
     2534               varcur-road-tax     = varcur-road-tax  + varroad-tax   * bf_gds-dtl.fact-qnty
     2535               varcur-excise       = varcur-excise    + varexcise     * bf_gds-dtl.fact-qnty
     2536               varcur-fact-qnty    = varcur-fact-qnty + bf_gds-dtl.fact-qnty
     2537             .
     2538         end.
     2539       end.
     2540       if varcur-fact-qnty = 0 then do:
     2541         assign
     2542           varcur-base      = varlastcur-base
     2543           varcur-road-tax  = varlastcur-road-tax
     2544           varcur-excise    = varlastcur-excise
     2545         .
     2546       end.
     2547       else do:
     2548         assign
     2549           varcur-base      = varcur-base      / varcur-fact-qnty
     2550           varcur-road-tax  = varcur-road-tax  / varcur-fact-qnty
     2551           varcur-excise    = varcur-excise    / varcur-fact-qnty
     2552         .
     2553       end.
     2554       if varcur-vat-pc = ?
     2555       then do:
     2556         return error substitute ("Нет текущего продажного НДС по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2557       end.
     2558       if varcur-slt-pc = ?
     2559       then do:
     2560         return error substitute ("Нет текущего продажного НП по товару &1 &2 &3", bf_goods.artic, bf_goods.prod-type, bf_goods.prod-code).
     2561       end.
     2562       find first bf_sysconf where bf_sysconf.host-code = bf_trn-doc.host-code no-lock.
     2563       assign
     2564         varcur-cons-vat-pc = bf_sysconf.cons-vat-pc.
     2565       if varcur-cons-vat-pc = ? then do:
     2566         return error substitute ("Нет текущего продажного консигнационного НДС по фирме &1", bf_trn-doc.host-code).
     2567       end.
     2568       define buffer buf_tt-clcparts for tt-clcparts .
     2569       for each buf_tt-clcparts
     2570       on error undo, return error return-value
     2571       :
     2572         delete buf_tt-clcparts.
     2573       end.
     2574       for each bf_parts no-lock
     2575         where bf_parts.out-code  = bf_doc-line.doc-code
     2576           and bf_parts.obj-type  = bf_doc-line.obj-type
     2577           and bf_parts.obj-code  = bf_doc-line.obj-code
     2578           and bf_parts.artic     = bf_doc-line.artic
     2579           and bf_parts.prod-type = bf_doc-line.prod-type
     2580           and bf_parts.prod-code = bf_doc-line.prod-code
     2581       on error undo, return error return-value
     2582       :
     2583         create buf_tt-clcparts .
     2584         buffer-copy bf_parts to buf_tt-clcparts .
     2585         if v-calcbypart = yes   then do:
     2586   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run partbcod in g#library
     2587     (buffer bf_parts
     2588     ,output v-b-pcode
     2589     ) no-error .
     2590   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2591   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run bcodeprc in g#library
     2592     (input  bf_parts.obj-type
     2593     ,input  bf_parts.obj-code
     2594     ,input  v-b-pcode
     2595     ,input  0
     2596     ,input  bf_trn-doc.fact-order
     2597     ,output vardoc-num
     2598     ,output varprice-salef
     2599     ,output varroad-tax
     2600     ,output varexcise
     2601     ) no-error .
     2602             if varprice-sale = ?
     2603             then do:
     2604               assign
     2605                 varprice-salef = 0
     2606                 varroad-tax   = 0
     2607                 varexcise     = 0
     2608               .
     2609             end.
     2610             assign
     2611             part-cur-base  = varprice-salef
     2612             part-cur-road-tax  = varroad-tax
     2613             part-cur-excise = varexcise.
     2614         end.
     2615       end.
     2616       run clcprtsl_calc-ttable in this-procedure
     2617         (input yes,
     2618          input yes,
     2619          input bf_doc-line.road-tax,
     2620          input bf_doc-line.excise,
     2621          input bf_doc-line.vat-pc,
     2622          input bf_doc-line.cons-vat-pc,
     2623          input bf_doc-line.slt-pc,
     2624          input bf_trn-doc.base-rate,
     2625          input bf_trn-doc.base-scale,
     2626          input varr-b,
     2627          input varcur-base,
     2628          input varcur-road-tax,
     2629          input varcur-excise,
     2630          input varcur-vat-pc,
     2631          input varcur-cons-vat-pc,
     2632          input varcur-slt-pc
     2633          ) no-error.
     2634       if error-status:error then do:
     2635         message
     2636           vss-workfile vss-revision vss-description skip
     2637           "Ошибка при вызове процедуры clcprtsl_calc-ttable." skip
     2638           return-value skip
     2639           trim(error-status :get-message(1))
     2640           trim(error-status :get-message(2))
     2641           trim(error-status :get-message(3))
     2642           trim(error-status :get-message(4))
     2643           trim(error-status :get-message(5)) skip
     2644           view-as alert-box error.
     2645         undo, return error .
     2646       end.
     2647     end.
     2648   end.
     2649   end.
     2650   procedure clcprtsl_calc-ttable :
     2651   define input parameter paris-doc           as   logical                 no-undo.
     2652   define input parameter paris-cur           as   logical                 no-undo.
     2653   define input parameter parroad-tax         like ub.doc-line.road-tax    no-undo.
     2654   define input parameter parexcise           like ub.doc-line.excise      no-undo.
     2655   define input parameter parvat-pc           like ub.doc-line.vat-pc      no-undo.
     2656   define input parameter parcons-vat-pc      like ub.doc-line.cons-vat-pc no-undo.
     2657   define input parameter parslt-pc           like ub.doc-line.slt-pc      no-undo.
     2658   define input parameter parbase-rate        like ub.trn-doc.base-rate    no-undo.
     2659   define input parameter parbase-scale       like ub.trn-doc.base-scale   no-undo.
     2660   define input parameter parr-b              as   character               no-undo.
     2661   define input parameter parcur-base         like ub.gds-dtl.cur-base     no-undo.
     2662   define input parameter parcur-road-tax     like ub.doc-line.road-tax    no-undo.
     2663   define input parameter parcur-excise       like ub.doc-line.excise      no-undo.
     2664   define input parameter parcur-vat-pc       like ub.doc-line.vat-pc      no-undo.
     2665   define input parameter parcurcons-vat-pc   like ub.doc-line.cons-vat-pc no-undo.
     2666   define input parameter parcurslt-pc        like ub.doc-line.slt-pc      no-undo.
     2667   define buffer bf_tt-allsum      for tt-allsum.
     2668   define buffer bf_tt-clcparts    for tt-clcparts.
     2669   define buffer bf_tt-allsum-line for tt-allsum-line.
     2670   define variable v-b-pcode          like ub.bar-code.b-code     no-undo.
     2671   define variable vardoc-num         like ub.price-doc.doc-num     no-undo.
     2672   define variable varprice-sale      like ub.price-list.price-sale no-undo.
     2673   define variable varroad-tax        like ub.price-list.road-tax   no-undo.
     2674   define variable varexcise          like ub.price-list.excise     no-undo.
     2675   do on error undo, return error return-value :
     2676   for each bf_tt-allsum-line
     2677   on error undo, return error return-value
     2678    :
     2679     delete bf_tt-allsum-line.
     2680   end.
     2681   for each bf_tt-allsum
     2682   on error undo, return error return-value
     2683   :
     2684     delete bf_tt-allsum.
     2685   end.
     2686   for each bf_tt-clcparts
     2687   on error undo, return error return-value
     2688   :
     2689   if v-calcbypart then do:
     2690             assign
     2691             parcur-base =   bf_tt-clcparts.part-cur-base
     2692             parcur-road-tax = bf_tt-clcparts.part-cur-road-tax
     2693             parcur-excise =   bf_tt-clcparts.part-cur-excise
     2694             .
     2695   end.
     2696      run clcprtsl_calc-parts in this-procedure (
     2697        input recid(bf_tt-clcparts),
     2698        input paris-doc,
     2699        input paris-cur,
     2700        input parroad-tax,
     2701        input parexcise,
     2702        input parvat-pc,
     2703        input parcons-vat-pc,
     2704        input parslt-pc,
     2705        input parbase-rate,
     2706        input parbase-scale,
     2707        input parr-b,
     2708        input parcur-base,
     2709        input parcur-road-tax,
     2710        input parcur-excise,
     2711        input parcur-vat-pc,
     2712        input parcurcons-vat-pc,
     2713        input parcurslt-pc
     2714        ) no-error.
     2715     if error-status:error then do:
     2716       message
     2717         vss-workfile vss-revision vss-description skip
     2718         vss-include-info4 skip
     2719         "Ошибка при обсчете партии" skip
     2720         "Документ партии " bf_tt-clcparts.out-code skip
     2721         "Товар" bf_tt-clcparts.artic bf_tt-clcparts.prod-type bf_tt-clcparts.prod-code skip
     2722         return-value skip
     2723         error-status:get-message(1) skip
     2724         error-status:get-message(2) skip
     2725         error-status:get-message(3) skip
     2726         view-as alert-box error .
     2727       undo, return error .
     2728     end.
     2729     for each bf_tt-allsum on error undo, return error return-value :
     2730       find first bf_tt-allsum-line where bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type no-error.
     2731       if not available bf_tt-allsum-line then do:
     2732         create bf_tt-allsum-line.
     2733         assign
     2734           bf_tt-allsum-line.sum-type = bf_tt-allsum.sum-type.
     2735       end.
     2736       assign
     2737         bf_tt-allsum-line.fact-qnty              = bf_tt-allsum-line.fact-qnty            + bf_tt-allsum.fact-qnty
     2738         bf_tt-allsum-line.cli-qnty               = bf_tt-allsum-line.cli-qnty             + bf_tt-allsum.cli-qnty
     2739         bf_tt-allsum-line.sum-dsc-base-doc       = bf_tt-allsum-line.sum-dsc-base-doc     + bf_tt-allsum.sum-dsc-base-doc
     2740         bf_tt-allsum-line.sum-dsc-rubl-doc       = bf_tt-allsum-line.sum-dsc-rubl-doc     + bf_tt-allsum.sum-dsc-rubl-doc
     2741         bf_tt-allsum-line.dsc-base-doc           = bf_tt-allsum-line.dsc-base-doc         + bf_tt-allsum.dsc-base-doc
     2742         bf_tt-allsum-line.dsc-rubl-doc           = bf_tt-allsum-line.dsc-rubl-doc         + bf_tt-allsum.dsc-rubl-doc
     2743         bf_tt-allsum-line.vat-base-doc           = bf_tt-allsum-line.vat-base-doc         + bf_tt-allsum.vat-base-doc
     2744         bf_tt-allsum-line.vat-rubl-doc           = bf_tt-allsum-line.vat-rubl-doc         + bf_tt-allsum.vat-rubl-doc
     2745         bf_tt-allsum-line.vat-base-buyer-doc     = bf_tt-allsum-line.vat-base-buyer-doc   + bf_tt-allsum.vat-base-buyer-doc
     2746         bf_tt-allsum-line.vat-rubl-buyer-doc     = bf_tt-allsum-line.vat-rubl-buyer-doc   + bf_tt-allsum.vat-rubl-buyer-doc
     2747         bf_tt-allsum-line.slt-base-doc           = bf_tt-allsum-line.slt-base-doc         + bf_tt-allsum.slt-base-doc
     2748         bf_tt-allsum-line.slt-rubl-doc           = bf_tt-allsum-line.slt-rubl-doc         + bf_tt-allsum.slt-rubl-doc
     2749         bf_tt-allsum-line.road-tax-base-doc      = bf_tt-allsum-line.road-tax-base-doc    + bf_tt-allsum.road-tax-base-doc
     2750         bf_tt-allsum-line.road-tax-rubl-doc      = bf_tt-allsum-line.road-tax-rubl-doc    + bf_tt-allsum.road-tax-rubl-doc
     2751         bf_tt-allsum-line.excise-base-doc        = bf_tt-allsum-line.excise-base-doc      + bf_tt-allsum.excise-base-doc
     2752         bf_tt-allsum-line.excise-rubl-doc        = bf_tt-allsum-line.excise-rubl-doc      + bf_tt-allsum.excise-rubl-doc
     2753         bf_tt-allsum-line.sum-dsc-base-cur       = bf_tt-allsum-line.sum-dsc-base-cur     + bf_tt-allsum.sum-dsc-base-cur
     2754         bf_tt-allsum-line.sum-dsc-rubl-cur       = bf_tt-allsum-line.sum-dsc-rubl-cur     + bf_tt-allsum.sum-dsc-rubl-cur
     2755         bf_tt-allsum-line.dsc-base-cur           = bf_tt-allsum-line.dsc-base-cur         + bf_tt-allsum.dsc-base-cur
     2756         bf_tt-allsum-line.dsc-rubl-cur           = bf_tt-allsum-line.dsc-rubl-cur         + bf_tt-allsum.dsc-rubl-cur
     2757         bf_tt-allsum-line.vat-base-cur           = bf_tt-allsum-line.vat-base-cur         + bf_tt-allsum.vat-base-cur
     2758         bf_tt-allsum-line.vat-rubl-cur           = bf_tt-allsum-line.vat-rubl-cur         + bf_tt-allsum.vat-rubl-cur
     2759         bf_tt-allsum-line.vat-base-buyer-cur     = bf_tt-allsum-line.vat-base-buyer-cur   + bf_tt-allsum.vat-base-buyer-cur
     2760         bf_tt-allsum-line.vat-rubl-buyer-cur     = bf_tt-allsum-line.vat-rubl-buyer-cur   + bf_tt-allsum.vat-rubl-buyer-cur
     2761         bf_tt-allsum-line.slt-base-cur           = bf_tt-allsum-line.slt-base-cur         + bf_tt-allsum.slt-base-cur
     2762         bf_tt-allsum-line.slt-rubl-cur           = bf_tt-allsum-line.slt-rubl-cur         + bf_tt-allsum.slt-rubl-cur
     2763         bf_tt-allsum-line.road-tax-base-cur      = bf_tt-allsum-line.road-tax-base-cur    + bf_tt-allsum.road-tax-base-cur
     2764         bf_tt-allsum-line.road-tax-rubl-cur      = bf_tt-allsum-line.road-tax-rubl-cur    + bf_tt-allsum.road-tax-rubl-cur
     2765         bf_tt-allsum-line.excise-base-cur        = bf_tt-allsum-line.excise-base-cur      + bf_tt-allsum.excise-base-cur
     2766         bf_tt-allsum-line.excise-rubl-cur        = bf_tt-allsum-line.excise-rubl-cur      + bf_tt-allsum.excise-rubl-cur
     2767         bf_tt-allsum-line.sum-dsc-base-acc       = bf_tt-allsum-line.sum-dsc-base-acc     + bf_tt-allsum.sum-dsc-base-acc
     2768         bf_tt-allsum-line.sum-dsc-rubl-acc       = bf_tt-allsum-line.sum-dsc-rubl-acc     + bf_tt-allsum.sum-dsc-rubl-acc
     2769         bf_tt-allsum-line.sum-dsc-cli-acc        = bf_tt-allsum-line.sum-dsc-cli-acc      + bf_tt-allsum.sum-dsc-cli-acc
     2770         bf_tt-allsum-line.dsc-base-acc           = bf_tt-allsum-line.dsc-base-acc         + bf_tt-allsum.dsc-base-acc
     2771         bf_tt-allsum-line.dsc-rubl-acc           = bf_tt-allsum-line.dsc-rubl-acc         + bf_tt-allsum.dsc-rubl-acc
     2772         bf_tt-allsum-line.dsc-cli-acc            = bf_tt-allsum-line.dsc-cli-acc          + bf_tt-allsum.dsc-cli-acc
     2773         bf_tt-allsum-line.vat-base-acc           = bf_tt-allsum-line.vat-base-acc         + bf_tt-allsum.vat-base-acc
     2774         bf_tt-allsum-line.vat-rubl-acc           = bf_tt-allsum-line.vat-rubl-acc         + bf_tt-allsum.vat-rubl-acc
     2775         bf_tt-allsum-line.vat-cli-acc            = bf_tt-allsum-line.vat-cli-acc          + bf_tt-allsum.vat-cli-acc
     2776         bf_tt-allsum-line.slt-base-acc           = bf_tt-allsum-line.slt-base-acc         + bf_tt-allsum.slt-base-acc
     2777         bf_tt-allsum-line.slt-rubl-acc           = bf_tt-allsum-line.slt-rubl-acc         + bf_tt-allsum.slt-rubl-acc
     2778         bf_tt-allsum-line.slt-cli-acc            = bf_tt-allsum-line.slt-cli-acc          + bf_tt-allsum.slt-cli-acc
     2779         bf_tt-allsum-line.road-tax-base-acc      = bf_tt-allsum-line.road-tax-base-acc    + bf_tt-allsum.road-tax-base-acc
     2780         bf_tt-allsum-line.road-tax-rubl-acc      = bf_tt-allsum-line.road-tax-rubl-acc    + bf_tt-allsum.road-tax-rubl-acc
     2781         bf_tt-allsum-line.road-tax-cli-acc       = bf_tt-allsum-line.road-tax-cli-acc     + bf_tt-allsum.road-tax-cli-acc
     2782         bf_tt-allsum-line.excise-base-acc        = bf_tt-allsum-line.excise-base-acc      + bf_tt-allsum.excise-base-acc
     2783         bf_tt-allsum-line.excise-rubl-acc        = bf_tt-allsum-line.excise-rubl-acc      + bf_tt-allsum.excise-rubl-acc
     2784         bf_tt-allsum-line.excise-cli-acc         = bf_tt-allsum-line.excise-cli-acc       + bf_tt-allsum.excise-cli-acc
     2785         bf_tt-allsum-line.transport-base-acc     = bf_tt-allsum-line.transport-base-acc   + bf_tt-allsum.transport-base-acc
     2786         bf_tt-allsum-line.transport-rubl-acc     = bf_tt-allsum-line.transport-rubl-acc   + bf_tt-allsum.transport-rubl-acc
     2787         bf_tt-allsum-line.transport-cli-acc      = bf_tt-allsum-line.transport-cli-acc    + bf_tt-allsum.transport-cli-acc
     2788         bf_tt-allsum-line.other-base-acc         = bf_tt-allsum-line.other-base-acc       + bf_tt-allsum.other-base-acc
     2789         bf_tt-allsum-line.other-rubl-acc         = bf_tt-allsum-line.other-rubl-acc       + bf_tt-allsum.other-rubl-acc
     2790         bf_tt-allsum-line.other-cli-acc          = bf_tt-allsum-line.other-cli-acc        + bf_tt-allsum.other-cli-acc
     2791         .
     2792     end.
     2793   end.
     2794   end.
     2795   end procedure.
     2796   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     2797   procedure gds-attr-name :
     2798     define input  parameter p-code           as character no-undo .
     2799     define output parameter p-type           as character no-undo .
     2800     define output parameter p-format         as character no-undo .
     2801     define output parameter p-label          as character no-undo .
     2802     define output parameter p-user-can-edit  as logical   no-undo .
     2803     define output parameter p-output-display as logical   no-undo .
     2804     define output parameter p-other          as character no-undo .
     2805     do
     2806     on error undo, return error
     2807     :
     2808           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-name in g#attr-lib
     2809         (input  p-code
     2810         ,output p-type
     2811         ,output p-format
     2812         ,output p-label
     2813         ,output p-user-can-edit
     2814         ,output p-output-display
     2815         ,output p-other
     2816         ) no-error .
     2817       if error-status :error
     2818       then do:
     2819         undo, return error return-value .
     2820       end.
     2821     end.
     2822   end procedure.
     2823   procedure gds-attr-tooltip :
     2824     define input  parameter p-code    as character no-undo .
     2825     define output parameter p-tooltip as character no-undo .
     2826     define output parameter p-label   as character no-undo .
     2827     do
     2828     on error undo, return error
     2829     :
     2830           if (valid-handle(g#attr-lib) <> true) then do:   run gbl/attr-lib.p persistent no-error .   if error-status :error or (valid-handle(g#attr-lib) <> true) then do:     message       "Error starting attr-lib.p" skip       g#attr-lib skip       g#attr-lib :type skip       g#attr-lib :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gds-attr-tooltip in g#attr-lib
     2831         (input  p-code
     2832         ,output p-tooltip
     2833         ,output p-label
