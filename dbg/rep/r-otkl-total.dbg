     3386   procedure cur-time :
     3387      define output parameter p-today as date      no-undo .
     3388      define output parameter p-time  as integer   no-undo .
     3389     do
     3390     on error undo, return error
     3391     :
     3392       define variable v-date1 as date      no-undo .
     3393       define variable v-date2 as date      no-undo .
     3394       define variable v-time  as integer   no-undo .
     3395       assign
     3396         v-date1 = today
     3397         v-time  = time
     3398         v-date2 = today
     3399       .
     3400       if v-date1 <> v-date2
     3401       then do:
     3402         assign
     3403           v-date1 = today
     3404           v-time  = v-time
     3405         .
     3406       end.
     3407       assign
     3408         p-today = v-date1
     3409         p-time  = v-time
     3410       .
     3411     end.
     3412   end.
     3413   function cur-time-date returns character
     3414   :
     3415     return string(today, '99/99/9999':U) .
     3416   end.
     3417   function cur-time-mjd returns decimal
     3418   :
     3419     define variable v-date as date      no-undo .
     3420     define variable v-time as integer   no-undo .
     3421     run cur-time in this-procedure
     3422       (output v-date
     3423       ,output v-time
     3424       ) .
     3425     return integer(v-date) - 2400002 + (v-time / 86400) .
     3426   end.
     3427   function cur-time-get-ending-index returns integer
     3428   (input p-number as integer
     3429   )
     3430   :
     3431     if p-number < 0
     3432     or p-number = ?
     3433     then do:
     3434       return 1 .
     3435     end.
     3436     define variable v-rest as integer   no-undo .
     3437     assign
     3438       p-number = p-number modulo 100
     3439     .
     3440     if p-number < 20
     3441     then do:
     3442       assign
     3443         v-rest = p-number
     3444       .
     3445     end.
     3446     else do:
     3447       assign
     3448         v-rest = p-number modulo 10
     3449       .
     3450     end.
     3451     case v-rest :
     3452       when 1
     3453       then do:
     3454         return 2 .
     3455       end.
     3456       when 2 or
     3457       when 3 or
     3458       when 4
     3459       then do:
     3460         return 3 .
     3461       end.
     3462       otherwise do:
     3463         return 1 .
     3464       end.
     3465     end case .
     3466   end.
     3467   procedure cur-time-mjd-to-date :
     3468      define input  parameter i-mjd-diff as decimal no-undo.
     3469      define output parameter o-Date     as date    no-undo.
     3470      define output parameter o-Time     as integer no-undo.
     3471      define variable v-day-number as integer   no-undo .
     3472      if    i-mjd-diff < 0
     3473         or i-mjd-diff = ?
     3474      then do:
     3475         return "?" .
     3476      end.
     3477      assign
     3478         v-day-number = truncate(i-mjd-diff,0).
     3479         o-Date = date(v-day-number + 2400002).
     3480         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
     3481     .
     3482   end.
     3483   function cur-time-mjd-to-string returns character
     3484   (input p-mjd-diff as decimal
     3485   )
     3486   :
     3487     define variable v-day-number as integer   no-undo .
     3488     define variable v-seconds    as integer   no-undo .
     3489     define variable v-hour       as integer   no-undo .
     3490     define variable v-min        as integer   no-undo .
     3491     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
     3492     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
     3493     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
     3494     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
     3495     if p-mjd-diff < 0
     3496     or p-mjd-diff = ?
     3497     then do:
     3498       return "?" .
     3499     end.
     3500     assign
     3501       v-day-number = integer(truncate(p-mjd-diff,0))
     3502       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
     3503     .
     3504     if v-seconds > 86400
     3505     then do:
     3506       assign
     3507         v-seconds = 86400 - 1
     3508       .
     3509     end.
     3510     if v-seconds < 0
     3511     then do:
     3512       assign
     3513         v-seconds = 0
     3514       .
     3515     end.
     3516     assign
     3517       v-hour = truncate(v-seconds / 3600, 0)
     3518     .
     3519     assign
     3520       v-seconds = v-seconds modulo 3600
     3521     .
     3522     assign
     3523       v-min = truncate(v-seconds / 60, 0)
     3524     .
     3525     assign
     3526       v-seconds = v-seconds modulo 60
     3527     .
     3528     return
     3529         (if v-day-number <> 0
     3530           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
     3531           else ""
     3532         )
     3533       + (if v-day-number <> 0 or v-hour <> 0
     3534           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
     3535           else ""
     3536         )
     3537       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
     3538           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
     3539           else ""
     3540         )
     3541       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
     3542       .
     3543   end.
     3544   function cur-time-string returns character
     3545   :
     3546     define variable v-date as date      no-undo .
     3547     define variable v-time as integer   no-undo .
     3548     run cur-time in this-procedure
     3549       (output v-date
     3550       ,output v-time
     3551       ) .
     3552     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
     3553   end.
     3554   function cur-time-string-sec returns character
     3555   :
     3556     define variable v-date as date      no-undo .
     3557     define variable v-time as integer   no-undo .
     3558     run cur-time in this-procedure
     3559       (output v-date
     3560       ,output v-time
     3561       ) .
     3562     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
     3563   end.
     3564   function cur-time-custom  returns character
     3565   (input p-prefix as character
     3566   ,input p-date-format as character
     3567   ,input p-delimiter as character
     3568   ,input p-time-format as character
     3569   ,input p-suffix as character
     3570   )
     3571   :
     3572     define variable v-date as date      no-undo .
     3573     define variable v-time as integer   no-undo .
     3574     run cur-time in this-procedure
     3575       (output v-date
     3576       ,output v-time
     3577       ) .
     3578     return
     3579       p-prefix
     3580       + string(v-date, p-date-format)
     3581       + p-delimiter
     3582       + string(v-time, p-time-format)
     3583       + p-suffix
     3584       .
     3585   end.
     3586   function cur-time-print  returns character
     3587   :
     3588     define variable v-date as date      no-undo .
     3589     define variable v-time as integer   no-undo .
     3590     run cur-time in this-procedure
     3591       (output v-date
     3592       ,output v-time
     3593       ) .
     3594     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
     3595   end.
     3596   function cur-time-datetime returns datetime
     3597   :
     3598     define variable v-char as character no-undo .
     3599     define variable v-datetime as datetime no-undo .
     3600     v-char = cur-time-string().
     3601     v-datetime = datetime(v-char).
     3602     return  v-datetime.
     3603   end.
     3604   function cur-time-string-msec returns character
     3605   :
     3606     define variable v-date as datetime  no-undo .
     3607     v-date = now.
     3608     return string(v-date) .
     3609   end.
     3610   define variable vss-include-info22 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3611   procedure sys-time_get-sys :
     3612     define output parameter p-year         as integer   no-undo .
     3613     define output parameter p-month        as integer   no-undo .
     3614     define output parameter p-day          as integer   no-undo .
     3615     define output parameter p-hour         as integer   no-undo .
     3616     define output parameter p-minute       as integer   no-undo .
     3617     define output parameter p-second       as integer   no-undo .
     3618     define output parameter p-milliseconds as integer   no-undo .
     3619     define variable v-system-time-structure as memptr    no-undo.
     3620     do
     3621     on error undo, return error return-value
     3622     :
     3623       assign
     3624         set-size(v-system-time-structure) = 16
     3625       .
     3626       run GetSystemTime
     3627         (input  get-pointer-value(v-system-time-structure)
     3628         ) .
     3629       assign
     3630         p-year         = get-short(v-system-time-structure,  1)
     3631         p-month        = get-short(v-system-time-structure,  3)
     3632         p-day          = get-short(v-system-time-structure,  7)
     3633         p-hour         = get-short(v-system-time-structure,  9)
     3634         p-minute       = get-short(v-system-time-structure, 11)
     3635         p-second       = get-short(v-system-time-structure, 13)
     3636         p-milliseconds = get-short(v-system-time-structure, 15)
     3637       .
     3638       assign
     3639         set-size(v-system-time-structure) = 0
     3640       .
     3641     end.
     3642   end procedure.
     3643   procedure sys-time_get-comp-user-name :
     3644     define output parameter p-computer-name as character no-undo .
     3645     define output parameter p-user-name     as character no-undo .
     3646     define output parameter p-process-pid   as integer   no-undo .
     3647     define variable v-return-value  as integer   no-undo .
     3648     define variable v-buffer-length as integer   no-undo .
     3649     define variable v-buffer-memptr as memptr    no-undo .
     3650     do
     3651     on error undo, return error return-value
     3652     :
     3653       assign
     3654         v-buffer-length = 1024
     3655         set-size(v-buffer-memptr) = v-buffer-length + 4
     3656       .
     3657       assign
     3658         put-long(v-buffer-memptr, 1) = v-buffer-length
     3659       .
     3660       run GetComputerNameA
     3661         (input  get-pointer-value(v-buffer-memptr) + 4
     3662         ,input  get-pointer-value(v-buffer-memptr)
     3663         ,output v-return-value
     3664         ) .
     3665       if v-return-value <> 0
     3666       then do:
     3667         assign
     3668           p-computer-name = get-string(v-buffer-memptr, 5)
     3669         .
     3670       end.
     3671       assign
     3672         put-long(v-buffer-memptr, 1) = v-buffer-length
     3673       .
     3674       run GetUserNameA
     3675         (input  get-pointer-value(v-buffer-memptr) + 4
     3676         ,input  get-pointer-value(v-buffer-memptr)
     3677         ,output v-return-value
     3678         ) .
     3679       if v-return-value <> 0
     3680       then do:
     3681         assign
     3682           p-user-name = get-string(v-buffer-memptr, 5)
     3683         .
     3684       end.
     3685       run GetCurrentProcessId
     3686         (output p-process-pid
     3687         ) .
     3688       assign
     3689         set-size(v-buffer-memptr) = 0
     3690       .
     3691     end.
     3692   end procedure.
     3693   procedure sys-time_get-http :
     3694     define output parameter p-http-time as character no-undo .
     3695     define variable v-year         as integer   no-undo .
     3696     define variable v-month        as integer   no-undo .
     3697     define variable v-day-of-week  as integer   no-undo .
     3698     define variable v-day          as integer   no-undo .
     3699     define variable v-hour         as integer   no-undo .
     3700     define variable v-minute       as integer   no-undo .
     3701     define variable v-second       as integer   no-undo .
     3702     define variable v-milliseconds as integer   no-undo .
     3703     do
     3704     on error undo, return error return-value
     3705     :
     3706       run sys-time_get-sys in this-procedure
     3707         (output v-year
     3708         ,output v-month
     3709         ,output v-day
     3710         ,output v-hour
     3711         ,output v-minute
     3712         ,output v-second
     3713         ,output v-milliseconds
     3714         ) .
     3715       assign
     3716         v-day-of-week = weekday(date(v-month, v-day, v-year))
     3717         p-http-time = entry(v-day-of-week, 'Sun,Mon,Tue,Wed,Thu,Fri,Sat')
     3718                     + ', ':u
     3719                     + string(v-day, '99':u)
     3720                     + ' ':u
     3721                     + entry(v-month, 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec':u)
     3722                     + ' ':u
     3723                     + string(v-year, '9999':u)
     3724                     + ' ':u
     3725                     + string(v-hour, '99':u)
     3726                     + ':':u
     3727                     + string(v-minute, '99':u)
     3728                     + ':':u
     3729                     + string(v-second, '99':u)
     3730                     + ' ':u
     3731                     + 'GMT':u
     3732       .
     3733     end.
     3734   end procedure.
     3735   procedure sys-time_set-sys :
     3736     define input  parameter p-year         as integer   no-undo .
     3737     define input  parameter p-month        as integer   no-undo .
     3738     define input  parameter p-day          as integer   no-undo .
     3739     define input  parameter p-hour         as integer   no-undo .
     3740     define input  parameter p-minute       as integer   no-undo .
     3741     define input  parameter p-second       as integer   no-undo .
     3742     define input  parameter p-milliseconds as integer   no-undo .
     3743     define variable v-system-time-structure as memptr    no-undo.
     3744     define variable v-return-value as integer   no-undo .
     3745     define variable v-day-of-week  as integer   no-undo .
     3746     do
     3747     on error undo, return error return-value
     3748     :
     3749       assign
     3750         v-day-of-week = weekday(date(p-month, p-day, p-year))
     3751       .
     3752       assign
     3753         set-size(v-system-time-structure) = 16
     3754       .
     3755       assign
     3756         put-short(v-system-time-structure,  1) = p-year
     3757         put-short(v-system-time-structure,  3) = p-month
     3758         put-short(v-system-time-structure,  5) = v-day-of-week
     3759         put-short(v-system-time-structure,  7) = p-day
     3760         put-short(v-system-time-structure,  9) = p-hour
     3761         put-short(v-system-time-structure, 11) = p-minute
     3762         put-short(v-system-time-structure, 13) = p-second
     3763         put-short(v-system-time-structure, 15) = p-milliseconds
     3764       .
     3765       run SetSystemTime
     3766         (input  get-pointer-value(v-system-time-structure)
     3767         ,output v-return-value
     3768         ) .
     3769       assign
     3770         set-size(v-system-time-structure) = 0
     3771       .
     3772       if v-return-value = 0
     3773       then do:
     3774         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     3775       end.
     3776     end.
     3777   end procedure.
     3778   procedure sys-time_sys-to-mjd :
     3779     define input  parameter p-year         as integer   no-undo .
     3780     define input  parameter p-month        as integer   no-undo .
     3781     define input  parameter p-day          as integer   no-undo .
     3782     define input  parameter p-hour         as integer   no-undo .
     3783     define input  parameter p-minute       as integer   no-undo .
     3784     define input  parameter p-second       as integer   no-undo .
     3785     define input  parameter p-milliseconds as integer   no-undo .
     3786     define output parameter p-mjd          as decimal   no-undo .
     3787     define variable v-year-correction as decimal   no-undo .
     3788     define variable v-shift-year as decimal   no-undo .
     3789     do
     3790     on error undo, return error return-value
     3791     :
     3792       assign
     3793         v-year-correction = truncate((decimal(p-month) - 14.0) / 12, 0)
     3794         v-shift-year      = decimal(p-year) + v-year-correction
     3795         p-mjd = truncate( (1461.0 * (v-shift-year + 4800.0 ) ) / 4, 0)
     3796               + truncate( (367.0 * (decimal(p-month) - 2.0 - v-year-correction * 12) ) / 12, 0)
     3797               - truncate( (3 * truncate((v-shift-year + 4900 ) / 100,0) ) / 4, 0)
     3798               + decimal(p-day) - 2432076.0
     3799               + p-hour / 24.0
     3800               + p-minute / 1440.0
     3801               + p-second / 86400.0
     3802               + p-milliseconds / 86400000.0
     3803       .
     3804     end.
     3805   end procedure.
     3806   procedure sys-time_sys-to-loc :
     3807     define input  parameter p-sys-year         as integer   no-undo .
     3808     define input  parameter p-sys-month        as integer   no-undo .
     3809     define input  parameter p-sys-day          as integer   no-undo .
     3810     define input  parameter p-sys-hour         as integer   no-undo .
     3811     define input  parameter p-sys-minute       as integer   no-undo .
     3812     define input  parameter p-sys-second       as integer   no-undo .
     3813     define input  parameter p-sys-milliseconds as integer   no-undo .
     3814     define output parameter p-loc-year         as integer   no-undo .
     3815     define output parameter p-loc-month        as integer   no-undo .
     3816     define output parameter p-loc-day          as integer   no-undo .
     3817     define output parameter p-loc-hour         as integer   no-undo .
     3818     define output parameter p-loc-minute       as integer   no-undo .
     3819     define output parameter p-loc-second       as integer   no-undo .
     3820     define output parameter p-loc-milliseconds as integer   no-undo .
     3821     define variable v-system-time-structure as memptr    no-undo.
     3822     define variable v-return-value          as integer   no-undo .
     3823     define variable v-sys-day-of-week       as integer   no-undo .
     3824     do
     3825     on error undo, return error return-value
     3826     :
     3827       assign
     3828         v-sys-day-of-week = weekday(date(p-sys-month, p-sys-day, p-sys-year))
     3829       .
     3830       assign
     3831         set-size(v-system-time-structure) = 32
     3832       .
     3833       assign
     3834         put-short(v-system-time-structure,  1) = p-sys-year
     3835         put-short(v-system-time-structure,  3) = p-sys-month
     3836         put-short(v-system-time-structure,  5) = v-sys-day-of-week
     3837         put-short(v-system-time-structure,  7) = p-sys-day
     3838         put-short(v-system-time-structure,  9) = p-sys-hour
     3839         put-short(v-system-time-structure, 11) = p-sys-minute
     3840         put-short(v-system-time-structure, 13) = p-sys-second
     3841         put-short(v-system-time-structure, 15) = p-sys-milliseconds
     3842       .
     3843       run SystemTimeToTzSpecificLocalTime
     3844         (input  0
     3845         ,input  get-pointer-value(v-system-time-structure)
     3846         ,input  get-pointer-value(v-system-time-structure) + 16
     3847         ,output v-return-value
     3848         ) .
     3849       assign
     3850         p-loc-year         = get-short(v-system-time-structure,  1 + 16)
     3851         p-loc-month        = get-short(v-system-time-structure,  3 + 16)
     3852         p-loc-day          = get-short(v-system-time-structure,  7 + 16)
     3853         p-loc-hour         = get-short(v-system-time-structure,  9 + 16)
     3854         p-loc-minute       = get-short(v-system-time-structure, 11 + 16)
     3855         p-loc-second       = get-short(v-system-time-structure, 13 + 16)
     3856         p-loc-milliseconds = get-short(v-system-time-structure, 15 + 16)
     3857       .
     3858       assign
     3859         set-size(v-system-time-structure) = 0
     3860       .
     3861       if v-return-value = 0
     3862       then do:
     3863         undo, return error "sys-time_set-sys: Ошибка при установке даты" .
     3864       end.
     3865     end.
     3866   end procedure.
     3867   procedure sys-time_mjd-to-sys :
     3868     define input  parameter p-mjd          as decimal   no-undo .
     3869     define output parameter p-year         as integer   no-undo .
     3870     define output parameter p-month        as integer   no-undo .
     3871     define output parameter p-day          as integer   no-undo .
     3872     define output parameter p-hour         as integer   no-undo .
     3873     define output parameter p-minute       as integer   no-undo .
     3874     define output parameter p-second       as integer   no-undo .
     3875     define output parameter p-milliseconds as integer   no-undo .
     3876     define variable v-year-correction as decimal   no-undo .
     3877     define variable v-shift-year      as decimal   no-undo .
     3878     define variable v-conv-date     as date      no-undo .
     3879     define variable v-int-part      as integer   no-undo .
     3880     define variable v-fraction-part as decimal   no-undo .
     3881     do
     3882     on error undo, return error return-value
     3883     :
     3884       assign
     3885         v-int-part      = integer(truncate(p-mjd, 0))
     3886         v-fraction-part = p-mjd - v-int-part
     3887         v-conv-date     = date(11, 17, 1858) + v-int-part
     3888         p-year          = year(v-conv-date)
     3889         p-month         = month(v-conv-date)
     3890         p-day           = day(v-conv-date)
     3891         v-fraction-part = v-fraction-part * 24.0
     3892         p-hour          = integer(truncate(v-fraction-part, 0))
     3893         v-fraction-part = (v-fraction-part - p-hour) * 60.0
     3894         p-minute        = integer(truncate(v-fraction-part, 0))
     3895         v-fraction-part = (v-fraction-part - p-minute) * 60.0
     3896         p-second        = integer(truncate(v-fraction-part, 0))
     3897         v-fraction-part = (v-fraction-part - p-second) * 1000.0
     3898         p-milliseconds  = integer(v-fraction-part)
     3899       .
     3900     end.
     3901   end procedure.
     3902   procedure sys-time_mjd-to-loc :
     3903     define input  parameter p-mjd              as decimal   no-undo .
     3904     define output parameter p-loc-year         as integer   no-undo .
     3905     define output parameter p-loc-month        as integer   no-undo .
     3906     define output parameter p-loc-day          as integer   no-undo .
     3907     define output parameter p-loc-hour         as integer   no-undo .
     3908     define output parameter p-loc-minute       as integer   no-undo .
     3909     define output parameter p-loc-second       as integer   no-undo .
     3910     define output parameter p-loc-milliseconds as integer   no-undo .
     3911     define variable v-sys-year         as integer   no-undo .
     3912     define variable v-sys-month        as integer   no-undo .
     3913     define variable v-sys-day          as integer   no-undo .
     3914     define variable v-sys-hour         as integer   no-undo .
     3915     define variable v-sys-minute       as integer   no-undo .
     3916     define variable v-sys-second       as integer   no-undo .
     3917     define variable v-sys-milliseconds as integer   no-undo .
     3918     do
     3919     on error undo, return error return-value
     3920     :
     3921       run sys-time_mjd-to-sys
     3922         (input  p-mjd
     3923         ,output v-sys-year
     3924         ,output v-sys-month
     3925         ,output v-sys-day
     3926         ,output v-sys-hour
     3927         ,output v-sys-minute
     3928         ,output v-sys-second
     3929         ,output v-sys-milliseconds
     3930         ) .
     3931       run sys-time_sys-to-loc
     3932         (input  v-sys-year
     3933         ,input  v-sys-month
     3934         ,input  v-sys-day
     3935         ,input  v-sys-hour
     3936         ,input  v-sys-minute
     3937         ,input  v-sys-second
     3938         ,input  v-sys-milliseconds
     3939         ,output p-loc-year
     3940         ,output p-loc-month
     3941         ,output p-loc-day
     3942         ,output p-loc-hour
     3943         ,output p-loc-minute
     3944         ,output p-loc-second
     3945         ,output p-loc-milliseconds
     3946         ) .
     3947     end.
     3948   end procedure.
     3949   function sys-time_get-mjd-func returns decimal
     3950   :
     3951     define variable v-year         as integer   no-undo .
     3952     define variable v-month        as integer   no-undo .
     3953     define variable v-day          as integer   no-undo .
     3954     define variable v-hour         as integer   no-undo .
     3955     define variable v-minute       as integer   no-undo .
     3956     define variable v-second       as integer   no-undo .
     3957     define variable v-milliseconds as integer   no-undo .
     3958     define variable v-mjd          as decimal   no-undo .
     3959     run sys-time_get-sys in this-procedure
     3960       (output v-year
     3961       ,output v-month
     3962       ,output v-day
     3963       ,output v-hour
     3964       ,output v-minute
     3965       ,output v-second
     3966       ,output v-milliseconds
     3967       ) .
     3968     run sys-time_sys-to-mjd in this-procedure
     3969       (input  v-year
     3970       ,input  v-month
     3971       ,input  v-day
     3972       ,input  v-hour
     3973       ,input  v-minute
     3974       ,input  v-second
     3975       ,input  v-milliseconds
     3976       ,output v-mjd
     3977       ) .
     3978     return v-mjd .
     3979   end function .
     3980   function sys-time_get-sys-str-func returns character
     3981   :
     3982     define variable v-utc-time as character no-undo .
     3983     define variable v-year         as integer   no-undo .
     3984     define variable v-month        as integer   no-undo .
     3985     define variable v-day          as integer   no-undo .
     3986     define variable v-hour         as integer   no-undo .
     3987     define variable v-minute       as integer   no-undo .
     3988     define variable v-second       as integer   no-undo .
     3989     define variable v-milliseconds as integer   no-undo .
     3990     run sys-time_get-sys in this-procedure
     3991       (output v-year
     3992       ,output v-month
     3993       ,output v-day
     3994       ,output v-hour
     3995       ,output v-minute
     3996       ,output v-second
     3997       ,output v-milliseconds
     3998       ) .
     3999     assign
     4000       v-utc-time  = 'UTC ':u
     4001                   + string(v-year,         '9999':u)
     4002                   + '/':u
     4003                   + string(v-month,        '99':u)
     4004                   + '/':u
     4005                   + string(v-day,          '99':u)
     4006                   + ' ':u
     4007                   + string(v-hour,         '99':u)
     4008                   + ':':u
     4009                   + string(v-minute,       '99':u)
     4010                   + ':':u
     4011                   + string(v-second,       '99':u)
     4012                   + ' ':u
     4013                   + string(v-milliseconds, '999':u)
     4014     .
     4015     return v-utc-time.
     4016   end function .
     4017   function sys-time_mjd-to-loc-str-func returns character
     4018     (v-sys-mjd as decimal)
     4019   :
     4020     define variable v-loc-str          as character no-undo .
     4021     define variable v-loc-year         as integer   no-undo .
     4022     define variable v-loc-month        as integer   no-undo .
     4023     define variable v-loc-day          as integer   no-undo .
     4024     define variable v-loc-hour         as integer   no-undo .
     4025     define variable v-loc-minute       as integer   no-undo .
     4026     define variable v-loc-second       as integer   no-undo .
     4027     define variable v-loc-milliseconds as integer   no-undo .
     4028     run sys-time_mjd-to-loc in this-procedure
     4029       (input  v-sys-mjd
     4030       ,output v-loc-year
     4031       ,output v-loc-month
     4032       ,output v-loc-day
     4033       ,output v-loc-hour
     4034       ,output v-loc-minute
     4035       ,output v-loc-second
     4036       ,output v-loc-milliseconds
     4037       ) .
     4038     assign
     4039       v-loc-str = substitute('&1/&2/&3 &4:&5'
     4040                             ,string(v-loc-day,    '99':U)
     4041                             ,string(v-loc-month,  '99':U)
     4042                             ,string(v-loc-year,   '9999':U)
     4043                             ,string(v-loc-hour,   '99':U)
     4044                             ,string(v-loc-minute, '99':U)
     4045                             )
     4046     .
     4047     return v-loc-str .
     4048   end function .
