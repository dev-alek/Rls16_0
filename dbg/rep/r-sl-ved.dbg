      206     index ie2 obj-name
      207   .
      208   procedure create_obj-list :
      209      define input parameter p-obj-type like ub.clients.obj-type no-undo .
      210      define input parameter p-obj-code like ub.clients.obj-code no-undo .
      211      do
      212      on error undo, return error return-value
      213      :
      214         define buffer cli-obj for ub.clients .
      215         define variable p-var as integer no-undo .
      216         define buffer buf_obj-list for obj-list .
      217         find last buf_obj-list  use-index pi no-error .
      218         if available buf_obj-list
      219         then
      220            p-var = buf_obj-list.obj-id + 1.
      221         else
      222            p-var = 1.
      223         find first cli-obj where
      224                   cli-obj.obj-type = p-obj-type
      225               and cli-obj.obj-code = p-obj-code
      226         no-lock no-error.
      227         if available cli-obj
      228         then do:
      229            create buf_obj-list.
      230            assign
      231               buf_obj-list.obj-id   = p-var
      232               buf_obj-list.obj-code = cli-obj.obj-code
      233               buf_obj-list.obj-type = cli-obj.obj-type
      234               buf_obj-list.obj-name = cli-obj.obj-name
      235               buf_obj-list.db-num   = cli-obj.db-num
      236            .
      237         end.
      238      end.
      239   end.
