     1083           p-transport-base      = 0
     1084           p-transport-rubl      = 0
     1085           p-vat-pc              = buf_doc-line.vat-pc
     1086           p-slt-pc              = buf_doc-line.slt-pc
     1087       .
     1088     end.
     1089     if p-fact-qnty      = ?
     1090     or p-vat-pc         = ?
     1091     or p-slt-pc         = ?
     1092     or p-sum-base       = ?
     1093     or p-sum-rubl       = ?
     1094     or p-vat-base       = ?
     1095     or p-vat-rubl       = ?
     1096     or p-slt-base       = ?
     1097     or p-slt-rubl       = ?
     1098     or p-road-tax-base  = ?
     1099     or p-road-tax-rubl  = ?
     1100     or p-transport-base = ?
     1101     or p-transport-rubl = ?
     1102     or p-other-base     = ?
     1103     or p-other-rubl     = ?
     1104     or p-excise-base    = ?
     1105     or p-excise-rubl    = ?
     1106     then do:
     1107       message
     1108         vss-workfile vss-revision vss-description skip
     1109         vss-include-info11 skip
     1110         "Получены неопределенные значения" skip
     1111         "Документ" p-doc-code skip
     1112         "Артикул" p-artic p-prod-type p-prod-code skip
     1113         "fact-qnty     " p-fact-qnty      skip
     1114         "vat-pc        " p-vat-pc         skip
     1115         "slt-pc        " p-slt-pc         skip
     1116         "sum-base      " p-sum-base       skip
     1117         "sum-rubl      " p-sum-rubl       skip
     1118         "vat-base      " p-vat-base       skip
     1119         "vat-rubl      " p-vat-rubl       skip
     1120         "slt-base      " p-slt-base       skip
     1121         "slt-rubl      " p-slt-rubl       skip
     1122         "road-tax-base " p-road-tax-base  skip
     1123         "road-tax-rubl " p-road-tax-rubl  skip
     1124         "transport-base" p-transport-base skip
     1125         "transport-rubl" p-transport-rubl skip
     1126         "other-base    " p-other-base     skip
     1127         "other-rubl    " p-other-rubl     skip
     1128         "excise-base   " p-excise-base    skip
     1129         "excise-rubl   " p-excise-rubl    skip
     1130         view-as alert-box error .
     1131       undo, return error .
     1132     end.
     1133   end procedure.
     1134   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1135   procedure factord :
     1136     define input  parameter p-fact-date            as date    no-undo .
     1137     define input  parameter p-fact-time            as integer no-undo .
     1138     define input  parameter p-fact-num             as integer no-undo .
     1139     define input  parameter p-shift-date           as date    no-undo .
     1140     define input  parameter p-shift-num            as integer no-undo .
     1141     define input  parameter p-shift-on             as logical no-undo .
     1142     define output parameter p-fact-order           as decimal no-undo .
     1143     define output parameter p-shift-end-fact-order as decimal no-undo .
     1144     define output parameter p-day-end-fact-order   as decimal no-undo .
     1145     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1146     if p-fact-date = ?
     1147     then do:
     1148       return error "Не указана фактическая дата" .
     1149     end.
     1150     define variable v-fact-date-num as integer no-undo .
     1151     assign
     1152       v-fact-date-num = integer(p-fact-date)
     1153     .
     1154     if p-fact-num = ?
     1155     or p-fact-num = 0
     1156     then do:
     1157       return error "Не задан p-fact-num " + string(p-fact-num) .
     1158     end.
     1159     if p-fact-num < 0
     1160     then do:
     1161       return error "Отрицательный fact-num " + string(p-fact-num) .
     1162     end.
     1163     if p-fact-num >= 100000000
     1164     then do:
     1165       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1166     end.
     1167     if p-shift-on = true
     1168     then do:
     1169       if p-shift-date = ?
     1170       then do:
     1171         return error "Не задана дата смены" .
     1172       end.
     1173       if p-shift-num = ?
     1174       or p-shift-num = 0
     1175       then do:
     1176         return error "Не задан номер смены" .
     1177       end.
     1178     end.
     1179     else do:
     1180       assign
     1181         p-shift-date = p-fact-date
     1182         p-shift-num  = 24
     1183       .
     1184     end.
     1185     define variable v-shift-offset as integer no-undo .
     1186     if p-shift-date = p-fact-date
     1187     then do:
     1188       assign
     1189         v-shift-offset = 1
     1190       .
     1191     end.
     1192     if p-shift-date < p-fact-date
     1193     then do:
     1194       assign
     1195         v-shift-offset = 0
     1196       .
     1197     end.
     1198     if p-shift-date > p-fact-date
     1199     then do:
     1200       message
     1201         vss-workfile vss-revision vss-description skip
     1202         "Неправильная дата закрытия смены" skip
     1203         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1204         view-as alert-box error .
     1205       undo, return error
     1206         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1207           ,string(p-fact-date, '99/99/9999':U)
     1208           ,string(p-shift-date, '99/99/9999':U)
     1209           )
     1210       .
     1211     end.
     1212     if p-shift-num < 1
     1213     or p-shift-num > 24
     1214     then do:
     1215       message
     1216         vss-workfile vss-revision vss-description skip
     1217         "Неправильный номер смены" skip
     1218         "p-shift-num" p-shift-num skip
     1219         view-as alert-box error .
     1220       undo, return error return-value .
     1221     end.
     1222     assign
     1223       p-fact-order           = v-fact-date-num
     1224                              + v-shift-offset * 0.5
     1225                              + p-shift-num    * 0.02 - 0.01
     1226                              + p-fact-num     * 0.0000000001
     1227       p-shift-end-fact-order = v-fact-date-num
     1228                              + v-shift-offset * 0.5
     1229                              + p-shift-num    * 0.02
     1230       p-day-end-fact-order   = v-fact-date-num
     1231                              + 0.99
     1232     .
     1233     if p-fact-order           <= v-fact-date-num
     1234     or p-shift-end-fact-order <= v-fact-date-num
     1235     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1236     or p-shift-end-fact-order >= p-day-end-fact-order
     1237     then do:
     1238       message
     1239         vss-workfile vss-revision vss-description skip
     1240         "Внутренняя ошибка при генерации фактического номера" skip
     1241         "p-fact-date"            p-fact-date            skip
     1242         "p-fact-time"            p-fact-time            skip
     1243         "p-fact-num"             p-fact-num             skip
     1244         "p-shift-date"           p-shift-date           skip
     1245         "p-shift-num"            p-shift-num            skip
     1246         "p-shift-on"             p-shift-on             skip
     1247         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1248         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1249         "v-fact-date-num"        v-fact-date-num        skip
     1250         view-as alert-box error .
     1251       undo, return error return-value .
     1252     end.
     1253   end procedure.
     1254   procedure day-begin-fact-order :
     1255     define input  parameter p-fact-date            as date    no-undo .
     1256     define output parameter p-day-begin-fact-order as decimal no-undo .
     1257     do
     1258     on error undo, return error return-value
     1259     :
     1260       if p-fact-date = ?
     1261       then do:
     1262         assign
     1263           p-day-begin-fact-order = 0
     1264         .
     1265       end.
     1266       else do:
     1267         assign
     1268           p-day-begin-fact-order = integer(p-fact-date)
     1269         .
     1270       end.
     1271     end.
     1272   end procedure.
     1273   procedure factord-max-fact-order :
     1274     define output parameter p-max-fact-order as decimal   no-undo .
     1275     do
     1276     on error undo, return error return-value
     1277     :
     1278       run day-begin-fact-order in this-procedure
     1279         (input  date(1, 1, 5000)
     1280         ,output p-max-fact-order
     1281         ) .
     1282     end.
     1283   end procedure.
     1284   procedure factord-cut-archive :
     1285     define input  parameter p-obj-type             as character no-undo .
     1286     define input  parameter p-obj-code             as integer   no-undo .
     1287     define input  parameter p-fact-date            as date      no-undo .
     1288     define output parameter p-shift-on             as logical   no-undo .
     1289     define output parameter p-shift-date           as date      no-undo .
     1290     define output parameter p-shift-num            as integer   no-undo .
     1291     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1292     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1293     define variable v-fact-order as decimal   no-undo .
     1294     define buffer buf_shift-obj for ub.shift-obj .
     1295     do
     1296     on error undo, return error return-value
     1297     :
     1298   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1299   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1300     (input  p-obj-type
     1301     ,input  p-obj-code
     1302     ,input  'shift-on=request'
     1303     ,output p-shift-on
     1304     ) no-error .
     1305       if error-status :error
     1306       then do:
     1307         message
     1308           vss-workfile vss-revision vss-description skip
     1309           "Ошибка при определении атрибута объекта" skip
     1310           "Объект" p-obj-type p-obj-code skip
     1311           error-status :get-message(1) skip
     1312           return-value skip
     1313           view-as alert-box error .
     1314         undo, return error return-value .
     1315       end.
     1316       if p-shift-on = false
     1317       then do:
     1318         assign
     1319           p-shift-date               = ?
     1320           p-shift-num                = 0
     1321         .
     1322       end.
     1323       else do:
     1324         find first buf_shift-obj share-lock
     1325           where buf_shift-obj.obj-type   = p-obj-type
     1326             and buf_shift-obj.obj-code   = p-obj-code
     1327             and buf_shift-obj.shift-date > p-fact-date
     1328           use-index pi
     1329           no-error .
     1330         if not available buf_shift-obj
     1331         or buf_shift-obj.status_ <> 'зкр':U
     1332         then do:
     1333           message
     1334             vss-workfile vss-revision vss-description skip
     1335             "Невозможно вычислить последнюю смену" skip
     1336             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1337             "Объект" p-obj-type p-obj-code skip
     1338             "Дата" p-fact-date skip
     1339             view-as alert-box error .
     1340           undo, return error return-value .
     1341         end.
     1342         find last buf_shift-obj share-lock
     1343           where buf_shift-obj.obj-type = p-obj-type
     1344             and buf_shift-obj.obj-code = p-obj-code
     1345             and buf_shift-obj.shift-date <= p-fact-date
     1346           use-index pi
     1347           no-error .
     1348         if available buf_shift-obj
     1349         then do:
     1350           if  buf_shift-obj.status_ = 'зкр':U
     1351           then do:
     1352             assign
     1353               p-shift-date = buf_shift-obj.shift-date
     1354               p-shift-num  = buf_shift-obj.shift-num
     1355             .
     1356           end.
     1357           else do:
     1358             message
     1359               vss-workfile vss-revision vss-description skip
     1360               "Невозможно вычислить последнюю смену" skip
     1361               "Статус смены отличен от статуса" 'зкр':U skip
     1362               "Объект" p-obj-type p-obj-code skip
     1363               "Дата" p-fact-date skip
     1364               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1365               view-as alert-box error .
     1366             undo, return error return-value .
     1367           end.
     1368         end.
     1369         else do:
     1370           assign
     1371             p-shift-date = p-fact-date - 1
     1372             p-shift-num  = 1
     1373           .
     1374         end.
     1375       end.
     1376       run factord in this-procedure
     1377         (input  p-fact-date
     1378         ,input  1
     1379         ,input  1
     1380         ,input  p-shift-date
     1381         ,input  p-shift-num
     1382         ,input  p-shift-on
     1383         ,output v-fact-order
     1384         ,output p-shift-end-fact-order
     1385         ,output p-day-end-fact-order
     1386         ) no-error .
     1387       if error-status :error
     1388       then do:
     1389         message
     1390           vss-workfile vss-revision vss-description skip
     1391           "Ошибка при вызове процедуры factord"
     1392           error-status :get-message(1) skip
     1393           return-value skip
     1394           view-as alert-box error .
     1395         undo, return error return-value .
     1396       end.
     1397     end.
     1398   end procedure.
     1399   procedure factord-lock-shift :
     1400     define input  parameter p-obj-type  as character no-undo .
     1401     define input  parameter p-obj-code  as integer   no-undo .
     1402     define input  parameter p-fact-date as date      no-undo .
     1403     define parameter buffer buf_shift-obj for ub.shift-obj .
     1404     define variable v-shift-on      as logical   no-undo .
     1405     define variable v-extra-message as character no-undo .
     1406     define variable v-error as character no-undo .
     1407     do
     1408     on error undo, return error return-value
     1409     :
     1410   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1411   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1412     (input  p-obj-type
     1413     ,input  p-obj-code
     1414     ,input  'shift-on=request'
     1415     ,output v-shift-on
     1416     ) no-error .
     1417       if error-status :error
     1418       then do:
     1419         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1420         undo, return error v-error .
     1421       end.
     1422       if v-shift-on = true
     1423       then do:
     1424         find first buf_shift-obj share-lock
     1425           where buf_shift-obj.obj-type   = p-obj-type
     1426             and buf_shift-obj.obj-code   = p-obj-code
     1427             and buf_shift-obj.shift-date > p-fact-date
     1428           use-index pi
     1429           no-error .
     1430         if not available buf_shift-obj
     1431         or buf_shift-obj.status_ <> 'зкр':U
     1432         then do:
     1433           find last buf_shift-obj
     1434             where buf_shift-obj.obj-type = p-obj-type
     1435               and buf_shift-obj.obj-code = p-obj-code
     1436               and buf_shift-obj.status_  = 'зкр':U
     1437             use-index stts
     1438             no-error .
     1439           if available buf_shift-obj
     1440           then do:
     1441             assign
     1442               v-extra-message =
     1443                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1444                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1445                               )
     1446             .
     1447           end.
     1448           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1449           undo, return error v-error .
     1450         end.
     1451       end.
     1452     end.
     1453   end procedure.
     1454   procedure factord-end-day :
     1455     define input  parameter p-fact-date            as date    no-undo .
     1456     define output parameter p-day-end-fact-order   as decimal no-undo .
     1457     do
     1458     on error undo, return error return-value
     1459     :
     1460       if p-fact-date = ?
     1461       then do:
     1462         return error "Не указана фактическая дата" .
     1463       end.
     1464       assign
     1465         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1466       .
     1467     end.
     1468   end procedure.
     1469   procedure factord-to-date :
     1470     define input  parameter p-fact-order as decimal no-undo .
     1471     define output parameter p-fact-date  as date    no-undo .
     1472     define variable v-ref-date  as date      no-undo .
     1473     define variable v-ref-delta as integer   no-undo .
     1474     do
     1475     on error undo, return error return-value
     1476     :
     1477       if p-fact-order = ?
     1478       or p-fact-order = 0
     1479       then do:
     1480         return error "Не указан fact-order" .
     1481       end.
     1482       assign
     1483         v-ref-date  = date(1, 1, 2000)
     1484       .
     1485       assign
     1486         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1487       .
     1488       assign
     1489         p-fact-date = v-ref-date + v-ref-delta
     1490       .
     1491     end.
     1492   end procedure.
     1493   procedure factord-to-fact-num :
     1494     define input  parameter p-fact-order as decimal no-undo .
     1495     define output parameter p-fact-num   as integer no-undo .
     1496     define variable v-fact-order-trunc as decimal no-undo .
     1497     do
     1498     on error undo, return error return-value
     1499     :
     1500       if p-fact-order = ?
     1501       or p-fact-order = 0
     1502       then do:
     1503         return error "Не указан fact-order" .
     1504       end.
     1505       assign
     1506        v-fact-order-trunc = truncate(p-fact-order, 2)
     1507       .
     1508       assign
     1509         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1510       .
     1511     end.
     1512   end procedure.
     1513   procedure factord-to-shift-num :
     1514     define input  parameter p-fact-order as decimal no-undo .
     1515     define output parameter p-shift-num   as integer no-undo .
     1516     define variable  p-shift-numd  as decimal   no-undo .
     1517     define variable v-fact-order-trunc as decimal no-undo .
     1518     do
     1519     on error undo, return error return-value
     1520     :
     1521       if p-fact-order = ?
     1522       or p-fact-order = 0
     1523       then do:
     1524         return error "Не указан fact-order" .
     1525       end.
     1526       assign
     1527        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1528       .
     1529       if v-fact-order-trunc < 0.5 then do:
     1530         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1531       end.
     1532       assign
     1533         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1534         .
     1535        assign
     1536         p-shift-num = truncate (p-shift-numd , 0)
     1537       .
     1538     end.
     1539   end procedure.
     1540   define variable v-sys-key as character no-undo.
     1541   define buffer buf_units    for units.
     1542   define buffer buf_trn-doc  for trn-doc.
     1543   define buffer buf_doc-line for doc-line.
     1544   define buffer buf_goods    for goods.
     1545   define temp-table temp-doc no-undo
     1546       field number     as integer
     1547       field gds-code   like goods.gds-code
     1548       field gds-name   like goods.gds-name
     1549       field izl-sum    as decimal
     1550       field izl-qnty   as decimal
     1551       field ned-sum    as decimal
     1552       field ned-qnty   as decimal
     1553       field obj-code   as integer
     1554       field obj-type   as char
     1555       field doc-code   as char
     1556       field OKEI       as integer
     1557       field grp-code   like goods.grp-code
     1558       field unit-name  as char
     1559       field grp-lvl    as integer
     1560       field lvl-num    as integer
     1561       field upper-code as integer
     1562       field lvl        as integer
     1563       INDEX tt-doc is primary doc-code obj-code obj-type
     1564       index tt-grp            grp-lvl  obj-type obj-code
     1565       .
     1566   function fnc-DD-MM-YYYY returns character
     1567       (input p-dat-date as date) forward.
     1568   function fnc-convert-dot-to-colon returns character
     1569       (input p-data as decimal, input p-accur as character) forward.
     1570   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile:currsysk.i $ $Revision: $".
     1571   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run currsysk in g#library
     1572     (output v-sys-key
     1573     ) no-error .
     1574   if error-status :error then
     1575   do:
     1576       message
     1577           vss-workfile vss-revision vss-description skip
     1578           "Ошибка при чтении параметра конфигурации" '"sys-key"' skip
     1579           error-status :get-message( 1 ) skip
     1580           return-value skip
     1581           view-as alert-box error .
     1582       return.
     1583   end.
     1584   if error-status :error then
     1585   do:
     1586       message
     1587           vss-workfile vss-revision vss-description skip
     1588           "Ошибка при чтении параметра конфигурации" '"sys-key"' skip
     1589           error-status :get-message( 1 ) skip
     1590           return-value skip
     1591           view-as alert-box error .
     1592       return.
     1593   end.
     1594   do
     1595       for buf_trn-doc
     1596       , buf_doc-line
     1597       on error undo, return error
     1598       :
     1599   if session :set-wait-state( "compiler" ) then.
     1600   end.
     1601   case X-selectgood:
     1602       when 2 then
     1603           do:
     1604               for each tmp#grp no-lock
     1605                   :
     1606                   num-g# = num-g# + 1.
     1607                   if num-g# = 1 then FixProdAttr = string(tmp#grp.node-code).
     1608                   if num-g# > 1 then leave.
     1609               end.
     1610           end.
     1611   end case.
     1612   PROCEDURE ostatok :
     1613   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     1614   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     1615   def input parameter x-tog-shift   as   logical             no-undo.
     1616   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     1617   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     1618   def input parameter x-shift-start as integer               no-undo.
     1619   def input parameter x-shift-end   as integer               no-undo.
     1620   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     1621   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     1622   def input parameter xTog-obj   as log no-undo.
     1623   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     1624   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     1625   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     1626   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     1627   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     1628   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     1629   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     1630   def var              Fact-orderS   as char  no-undo.
     1631   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     1632      Assign
     1633         Fact-order   = 0
     1634         Quantity     = 0
     1635         Coast_R      = 0
     1636         Coast_V      = 0
     1637         VAT_R        = 0
     1638         VAT_V        = 0 .
     1639    x-date-start-t  = x-date-start + 1 .
     1640   IF x-date-end = date('') then DO:
     1641      Fact-order = 0 .
     1642      for each obj-list
     1643          where  ( not xtog-obj or
     1644                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     1645                 no-lock :
     1646         if  x-tog-shift = false then do:
     1647                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1648                               ub.stk-tot.Fact-date <=  x-date-start
     1649                               and ub.stk-tot.shift-num = 0
     1650                               USE-INDEX fact-date no-lock no-error .
     1651              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1652         End.
     1653         Else  DO :
     1654             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1655              (ub.stk-tot.shift-date  = x-date-start-t and
     1656               ub.stk-tot.shift-num  < x-shift-start or
     1657               ub.stk-tot.shift-date  < x-date-start-t  )
     1658               and ub.stk-tot.shift-num  > 0
     1659               USE-INDEX Shift-num no-lock no-error .
     1660            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1661           END.
     1662       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     1663     End.
     1664   End.
     1665   Else DO:
     1666     For each obj-list  WHERE
     1667        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     1668         no-lock :
     1669      IF  x-TOG-Shift = False Then DO:
     1670          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1671               ub.stk-tot.Fact-date <= x-date-end
     1672               and ub.stk-tot.shift-num = 0
     1673               USE-INDEX fact-date no-lock no-error.
     1674          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1675      END.
     1676      Else DO:
     1677           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     1678               (ub.stk-tot.shift-date  = x-date-end and
     1679               ub.stk-tot.shift-num  <= x-shift-end or
     1680               ub.stk-tot.shift-date  < x-date-end       ) and
     1681               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     1682               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     1683       End.
     1684       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     1685     End.
     1686   End.
     1687   END PROCEDURE.
     1688   define variable x-date-start-t like stk-tot.shift-date no-undo.
     1689   run ostatok (
     1690       input 0  ,
     1691       input ""  ,yes,
     1692       input x-date-start - 1 ,
     1693       input date('')      ,  x-Shift-Start,x-Shift-End,
     1694       input 'crsa':U   ,
     1695       input '##,##':U,
     1696       input false ,
     1697       output  v-temp-f-o  ,
     1698       output  v-temp-f-o   ,
     1699       output  v-temp-f-o   ,
     1700       output  v-temp-f-o     ,
     1701       output  v-temp-f-o     ,
     1702       output  v-shift-start-fact-order ).
     1703   run ostatok (
     1704       input 0  ,
     1705       input ""  ,yes,
     1706       input x-date-start  ,
     1707       input x-date-end    ,  x-Shift-Start,x-Shift-End,
     1708       input 'crsa':U   ,
     1709       input '##,##':U,
     1710       input false ,
     1711       output  v-temp-f-o  ,
     1712       output  v-temp-f-o   ,
     1713       output  v-temp-f-o   ,
     1714       output  v-temp-f-o     ,
     1715       output  v-temp-f-o     ,
     1716       output  v-shift-end-fact-order ).
     1717   for each obj-list
     1718       :
     1719   define variable vss-include-info19 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1720   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostname in g#library
     1721     (input  obj-list.obj-type
     1722     ,input  obj-list.obj-code
     1723     ,output v-cntxt-host-code-obj
     1724     ,output v-cntxt-host-name-obj
     1725     )  .
     1726       for each ub.trn-doc where
     1727           ub.trn-doc.obj-type = obj-list.obj-type and
     1728           ub.trn-doc.obj-code = obj-list.obj-code
     1729           and
     1730           trn-doc.fact-order  <= v-shift-end-fact-order and
     1731           trn-doc.fact-order   > v-shift-start-fact-order
     1732           :
     1733           case x-SET_PAY_TYPE :
     1734               when 2 then
     1735                   do:
     1736                       assign
     1737                           var-x-sum-type     = 'cost':U
     1738                           var-x-ost-sum-type = 'cost':U
     1739                           .
     1740                   end.
     1741               when 1 then
     1742                   do:
     1743                       assign
     1744                           var-x-sum-type     = 'crsa':U
     1745                           var-x-ost-sum-type = 'crsa':U
     1746                           .
     1747                   end.
     1748               when 3 then
     1749                   do:
     1750                       assign
     1751                           var-x-sum-type     = 'sale':U
     1752                           var-x-ost-sum-type = 'crsa':U
     1753                           .
     1754                   end.
     1755               otherwise
     1756               do:
     1757                   assign
     1758                       var-x-sum-type     = 'cost':U
     1759                       var-x-ost-sum-type = 'cost':U
     1760                       .
     1761               end.
     1762           end case.
     1763           run doc-calc.
     1764       end.
     1765       run transform-tt-level.
     1766   end.
     1767   run get-full-path-RepViewer(output v-full-path-RepView).
     1768   run get-report-num in parParentProc(output g#report-num).
     1769   run define-full-path-Report(input g#report-num, output v-file-name-rep-htm).
     1770   run create-file(v-file-name-rep-htm).
     1771   v-report-name = "Общая сличительная ведомость".
     1772   run proc-create-HTML (input v-file-name-rep-htm
     1773       ,input v-cntxt-host-name-obj
     1774       ,input v-report-name
     1775       ,input p-doc-code
     1776       ,input p-doc-date
     1777       ,input p-object
     1778       ,input v-izl-sum
     1779       ,input v-izl-qnty
     1780       ,input v-ned-sum
     1781       ,input v-ned-qnty
     1782       ).
     1783   run search-full-path-Report(input v-file-name-rep-htm).
     1784   run Report-Viewer(input v-full-path-RepView, input v-file-name-rep-htm).
     1785   procedure doc-calc:
     1786       define variable p-gds-name    as character.
     1787       define variable p-grp-code    as integer.
     1788       define variable p-gds-code    as integer.
     1789       define variable v-gds-name    as char.
     1790       define variable p-okei        as integer.
     1791       define variable p-ned-qnty    as decimal.
     1792       define variable p-unit-name   as char.
     1793       define variable p-ned-sum     as decimal.
     1794       define variable p-izl-sum     as decimal.
     1795       define variable p-izl-qnty    as decimal.
     1796       define variable p-unit-base   as char.
     1797       define variable help-grp-code as integer.
     1798   define variable p-help-grp-code as integer.
     1799       _chk: for each doc-line where doc-line.doc-code = trn-doc.doc-code
     1800           and doc-line.obj-type = obj-list.obj-type
     1801           and doc-line.obj-code = obj-list.obj-code
     1802           and doc-line.ext-doc-type = 'vt':U
     1803           and doc-line.status_ = 'факт':U
     1804           and doc-line.fact-qnty <> 0
     1805           no-lock :
     1806           find first buf_goods where buf_goods.prod-type = doc-line.prod-type and
     1807               buf_goods.prod-code = doc-line.prod-code and
     1808               buf_goods.artic = doc-line.artic .
     1809           p-gds-code = buf_goods.gds-code.
     1810           p-grp-code = buf_goods.grp-code.
     1811           p-gds-name = buf_goods.gds-name.
     1812           p-unit-base = buf_goods.unit-base.
     1813           case x-SelectGood:
     1814               when 4 or
     1815               when 6     or
     1816               when 5   then
     1817                   do:
     1818                                         run tt-lvl (input p-grp-code, output help-grp-code  ) .
     1819                       find  first gds-list no-lock
     1820                           where gds-list.artic     = doc-line.artic
     1821                           and gds-list.prod-type = doc-line.prod-type
     1822                           and gds-list.prod-code = doc-line.prod-code
     1823                           no-error .
     1824                       if not available gds-list then next.
     1825                   end.
     1826               when 1  then
     1827                   do:
     1828                     run tt-lvl (input p-grp-code, output help-grp-code  ) .
     1829                   end.
     1830               when 2 then
     1831                   do :
     1832                       assign
     1833                           v-grp-name = ""
     1834                           v-found    = no
     1835                           .
     1836                       _ii-grp: do ii-grp = 1 to num-entries(buf_goods.grp-name, chr(47)) - 1
     1837                           :
     1838                           assign
     1839                               v-grp-name = v-grp-name + entry(ii-grp, buf_goods.grp-name, chr(47)) + chr(47)
     1840                               .
     1841                           if can-find(first tmp#grp no-lock where
     1842                               tmp#grp.grp-name = v-grp-name) then
     1843                           do:
     1844                               v-found = yes.
     1845                               leave _ii-grp.
     1846                           end.
     1847                       end.
     1848                       if not v-found then next _chk.
     1849                   end.
     1850               otherwise
     1851               do:
     1852                   find  first gds-list no-lock
     1853                       where doc-line.artic     = gds-list.artic
     1854                       and doc-line.prod-type = gds-list.prod-type
     1855                       and doc-line.prod-code = gds-list.prod-code no-error .
     1856                   if not available  gds-list then next.
     1857               end.
     1858           end case.
     1859           if   x-SelectGood = 2 then
     1860           do:
     1861               run tt-grp (input buf_goods.grp-code, output p-help-grp-code) .
     1862               help-grp-code = p-help-grp-code.
     1863           end.
     1864           p-doc-date =  trn-doc.doc-date.
     1865           p-doc-code = doc-line.doc-code.
     1866           p-object = obj-list.obj-name.
     1867           find first temp-doc where temp-doc.gds-code = p-gds-code and
     1868               temp-doc.obj-code = doc-line.obj-code and
     1869               temp-doc.obj-type = doc-line.obj-type
     1870               no-error.
     1871           if not available temp-doc then
     1872           do:
     1873               create temp-doc.
     1874               assign
     1875                   temp-doc.gds-code = p-gds-code
     1876                   temp-doc.doc-code = doc-line.doc-code
     1877                   temp-doc.obj-code = doc-line.obj-code
     1878                   temp-doc.obj-type = doc-line.obj-type
     1879                   temp-doc.gds-name = p-gds-name
     1880                   temp-doc.grp-code = help-grp-code.
     1881               find first units no-lock
     1882                   where units.unit-name = p-unit-base.
     1883               temp-doc.okei = units.OKEI.
     1884               temp-doc.unit-name =  units.unit-name.
     1885           end.
     1886           find first doc-line-sum
     1887               where
     1888               doc-line-sum.doc-code = doc-line.doc-code
     1889               and
     1890               doc-line-sum.gds-code = p-gds-code
     1891               and doc-line-sum.sum-type = 'gen':U
     1892               .
     1893           if  available doc-line-sum
     1894               then
     1895           do:
     1896               if doc-line-sum.fact-qnty >= 0
     1897                   then
     1898               do:
     1899                   assign
     1900                       p-izl-qnty = doc-line-sum.fact-qnty
     1901                       p-ned-qnty = 0.0
     1902                       .
     1903                   if var-x-sum-type = 'crsa':U
     1904                       then
     1905                   do:
     1906                       assign
     1907                           p-izl-sum = doc-line-sum.sale-sum-rubl
     1908                           p-ned-sum = 0.0
     1909                           .
     1910                   end.
     1911                   else
     1912                   do:
     1913                       assign
     1914                           p-izl-sum = doc-line-sum.cost-sum-rubl
     1915                           p-ned-sum = 0.0
     1916                           .
     1917                   end.
     1918               end.
     1919               else
     1920               do:
     1921                   assign
     1922                       p-izl-qnty = 0.0
     1923                       p-ned-qnty = (-1) * doc-line-sum.fact-qnty
     1924                       .
     1925                   if var-x-sum-type = 'crsa':U
     1926                       then
     1927                   do:
     1928                       assign
     1929                           p-izl-sum = 0.0
     1930                           p-ned-sum = (-1.0) * doc-line-sum.sale-sum-rubl
     1931                           .
     1932                   end.
     1933                   else
     1934                   do:
     1935                       assign
     1936                           p-izl-sum = 0.0
     1937                           p-ned-sum = (-1.0) * doc-line-sum.cost-sum-rubl
     1938                           .
     1939                   end.
     1940               end.
     1941           end.
     1942           else
     1943           do:
     1944               if var-x-sum-type = 'crsa':U
     1945                   then
     1946               do:
     1947                   if doc-line.fact-qnty >= 0
     1948                       then
     1949                   do:
     1950                       assign
     1951                           p-izl-qnty = doc-line.fact-qnty
     1952                           p-ned-qnty = 0.0
     1953                           p-izl-sum  = doc-line.price-base * doc-line.fact-qnty.
     1954                       p-ned-sum  = 0.0
     1955                           .
     1956                   end.
     1957                   else
     1958                   do:
     1959                       assign
     1960                           p-izl-qnty = 0.0
     1961                           p-ned-qnty = (-1.0) * doc-line.fact-qnty
     1962                           p-izl-sum  = 0.0
     1963                           p-ned-sum  = (-1.0) * doc-line.price-base * doc-line.fact-qnty.
     1964                       .
     1965                   end.
     1966               end.
     1967               else
     1968               do:
     1969                   if doc-line.fact-qnty >= 0
     1970                       then
     1971                   do:
     1972                       assign
     1973                           p-izl-qnty = doc-line.fact-qnty
     1974                           p-ned-qnty = 0.0
     1975                           p-izl-sum  = doc-line.price-rubl * doc-line.fact-qnty.
     1976                       p-ned-sum  = 0.0
     1977                           .
     1978                   end.
     1979                   else
     1980                   do:
     1981                       assign
     1982                           p-izl-qnty = 0.0
     1983                           p-ned-qnty = (-1.0) * doc-line.fact-qnty
     1984                           p-izl-sum  = 0.0
     1985                           p-ned-sum  = (-1.0) * doc-line.price-rubl * doc-line.fact-qnty.
     1986                   end.
     1987               end.
     1988           end.
     1989           temp-doc.izl-sum = p-izl-sum + temp-doc.izl-sum.
     1990           temp-doc.izl-qnty = p-izl-qnty + temp-doc.izl-qnty.
     1991           temp-doc.ned-sum = p-ned-sum + temp-doc.ned-sum.
     1992           temp-doc.ned-qnty = p-ned-qnty + temp-doc.ned-qnty.
     1993           v-izl-sum = v-izl-sum + p-izl-sum.
     1994           v-izl-qnty = v-izl-qnty + p-izl-qnty.
     1995           v-ned-sum = v-ned-sum + p-ned-sum.
     1996           v-ned-qnty = v-ned-qnty + p-ned-qnty.
     1997       end.
     1998   end procedure.
     1999   procedure tt-grp:
     2000       define input parameter p-grp-code as integer.
     2001       define output parameter tt-hp-grp-code as integer .
     2002           find first gds-grp  no-lock  where gds-grp.node-code = p-grp-code   no-error.
     2003            if available gds-grp then
     2004           do:
     2005       find first tmp#grp where tmp#grp.node-code  =  p-grp-code  no-error.
     2006       if available tmp#grp then
     2007       do:
     2008                tt-hp-grp-code = p-grp-code.
     2009           end.
     2010       else
     2011       do :
     2012           run tt-grp(input gds-grp.upper-code, output tt-hp-grp-code).
     2013       end.
     2014   end.
     2015   end procedure.
     2016   procedure transform-tt-level:
     2017       define buffer buftt_temp-doc for temp-doc.
     2018       define variable v-gds-name     as character no-undo.
     2019       define variable v-cur-lvl      as integer   no-undo.
     2020       define variable v-upper-code   as integer   initial ? no-undo.
     2021       define variable v-ii           as integer   no-undo.
     2022       define variable p-grp-izl-sum  as decimal.
     2023       define variable v-lvl          as integer.
     2024       define variable p-grp-izl-qnty as decimal.
     2025       define variable p-grp-ned-sum  as decimal.
     2026       define variable p-grp-ned-qnty as decimal.
     2027       define buffer buftt2_temp-doc for temp-doc.
     2028       do while v-upper-code <> 0:
     2029           v-upper-code = 0.
     2030           for each temp-doc where temp-doc.grp-lvl =  v-cur-lvl
     2031               and temp-doc.obj-type = obj-list.obj-type
     2032               and  temp-doc.obj-code = obj-list.obj-code
     2033               use-index tt-grp
     2034               break by temp-doc.grp-code
     2035               :
     2036               v-ii = v-ii + 1.
     2037               if first-of (temp-doc.grp-code)  then
     2038               do:
     2039                   assign
     2040                       p-grp-izl-sum  = 0
     2041                       p-grp-izl-qnty = 0
     2042                       p-grp-ned-sum  = 0
     2043                       p-grp-ned-qnty = 0.
     2044                   find first ub.gds-grp where
     2045                       ub.gds-grp.node-code = temp-doc.grp-code
     2046                       no-lock no-error.
     2047                   if available ub.gds-grp then
     2048                   do:
     2049                       assign
     2050                           v-gds-name = ub.gds-grp.node-name
     2051                           v-lvl      = gds-grp.lvl-num.
     2052                       v-upper-code = gds-grp.upper-code.
     2053                   end.
     2054               end.
     2055               assign
     2056                   p-grp-izl-sum  = p-grp-izl-sum + temp-doc.izl-sum
     2057                   p-grp-izl-qnty = p-grp-izl-qnty + temp-doc.izl-qnty
     2058                   p-grp-ned-sum  = p-grp-ned-sum + temp-doc.ned-sum
     2059                   p-grp-ned-qnty = p-grp-ned-qnty + temp-doc.ned-qnty
     2060                   .
     2061               if  temp-doc.grp-lvl <> 0 then
     2062               do:
     2063                   assign
     2064                       temp-doc.gds-name = v-gds-name
     2065                       .
     2066               end.
     2067               if last-of (temp-doc.grp-code) and v-upper-code <> 0  and temp-doc.gds-code <> 0  then
     2068               do :
     2069                   find first  buftt_temp-doc where
     2070                       buftt_temp-doc.obj-code = obj-list.obj-code and
     2071                       buftt_temp-doc.obj-type = obj-list.obj-type and
     2072                       buftt_temp-doc.lvl-num = 2 and
     2073                       buftt_temp-doc.grp-lvl =  buftt_temp-doc.grp-lvl + 1 and
     2074                       buftt_temp-doc.grp-code   =  (if temp-doc.grp-lvl = 0 then temp-doc.grp-code
     2075                       else v-upper-code)
     2076                       and
     2077                       buftt_temp-doc.gds-code = 0 no-error.
     2078                   if not available  buftt_temp-doc  then
     2079                   do:
     2080                       create buftt_temp-doc .
     2081                       assign
     2082                           buftt_temp-doc.lvl-num  = 2
     2083                           buftt_temp-doc.grp-lvl  = buftt_temp-doc.grp-lvl + 1
     2084                           buftt_temp-doc.grp-code = (if temp-doc.grp-lvl = 0 then temp-doc.grp-code
     2085                             else v-upper-code)
     2086                           buftt_temp-doc.obj-code = obj-list.obj-code
     2087                           buftt_temp-doc.obj-type = obj-list.obj-type
     2088                           buftt_temp-doc.gds-code = 0.
     2089                   end.
     2090                   assign
     2091                       buftt_temp-doc.gds-name = v-gds-name
     2092                       buftt_temp-doc.izl-qnty = buftt_temp-doc.izl-qnty + p-grp-izl-qnty
     2093                       buftt_temp-doc.izl-sum  = buftt_temp-doc.izl-sum + p-grp-izl-sum
     2094                       buftt_temp-doc.ned-qnty = buftt_temp-doc.ned-qnty + p-grp-ned-qnty
     2095                       buftt_temp-doc.ned-sum  = buftt_temp-doc.ned-sum +  p-grp-ned-sum .
     2096               end.
     2097           end.
     2098           v-cur-lvl = v-cur-lvl + 1.
     2099       end.
     2100       for each buftt2_temp-doc where buftt2_temp-doc.grp-code <> 0  and
     2101           buftt2_temp-doc.gds-code = 0 and  buftt2_temp-doc.lvl-num = 2 :
     2102           for each buftt_temp-doc where buftt_temp-doc.grp-code = buftt2_temp-doc.grp-code and buftt2_temp-doc.grp-lvl <> buftt_temp-doc.grp-lvl and   buftt2_temp-doc.lvl-num = 2 and   buftt_temp-doc.gds-code = 0   :
     2103               assign
     2104                   buftt2_temp-doc.izl-qnty = buftt_temp-doc.izl-qnty + buftt2_temp-doc.izl-qnty
     2105                   buftt2_temp-doc.izl-sum  = buftt_temp-doc.izl-sum  +  buftt2_temp-doc.izl-sum
     2106                   buftt2_temp-doc.ned-qnty = buftt_temp-doc.ned-qnty  + buftt2_temp-doc.ned-qnty
     2107                   buftt2_temp-doc.ned-sum  = buftt_temp-doc.ned-sum + buftt2_temp-doc.ned-sum .
     2108               delete buftt_temp-doc.
     2109           end.
     2110       end.
     2111   end procedure.
     2112   procedure tt-lvl:
     2113       define input parameter p-grp-code as integer.
     2114       define output parameter hp-grp-code as integer .
     2115       find first gds-grp  no-lock  where gds-grp.node-code = p-grp-code  and gds-grp.upper-code <> 1  no-error.
     2116       if available gds-grp then
     2117       do:
     2118           hp-grp-code = p-grp-code.
     2119           pom-grp = hp-grp-code.
     2120           if gds-grp.upper-code <> 1    then
     2121           do:
     2122               run tt-lvl(input gds-grp.upper-code, output hp-grp-code).
     2123           end.
     2124       end.
     2125       else
     2126       do :
     2127           hp-grp-code =  pom-grp.
     2128       end.
     2129   end procedure.
     2130   procedure proc-create-HTML:
