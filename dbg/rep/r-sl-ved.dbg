      196   def
      197    shared
      198   temp-table  obj-list no-undo
      199     field obj-type like ub.clients.obj-type
      200     field obj-code like ub.clients.obj-code
      201     field obj-name like ub.clients.obj-name
      202     field obj-id   as integer
