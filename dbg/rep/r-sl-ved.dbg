      659   procedure r-sale :
      660     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
      661     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
      662     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
      663     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
      664     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
      665     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
      666     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
      667     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
      668     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
      669     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
      670     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
      671     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
      672     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
      673     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
      674     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
      675     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
      676     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
      677     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
      678     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
      679     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
      680     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
      681     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
      682     do
      683     on error undo, return error
      684     :
      685       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
      686       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
      687       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
      688       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
      689       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
      690       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
      691       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
      692       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
      693       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
      694       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
      695       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
      696       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
      697       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
      698       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
      699       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
      700       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
      701       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
      702       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
      703       define buffer out-vatp_parts       for ub.parts.
      704       define buffer out-vatp_sysconf     for ub.sysconf.
      705       define buffer out-vatp_doc-line    for ub.doc-line.
      706       define buffer out-vatp_goods       for ub.goods.
      707       define buffer out-vatp_trn-doc     for ub.trn-doc.
      708       define buffer out-vatp_doc-attr    for ub.doc-attr.
      709       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
      710       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
      711       define variable varfrm-cnsv-type         as   character                           no-undo.
      712       define variable varfrm-cnsv              as   character                           no-undo.
      713       define variable varroot-node             as   integer                             no-undo.
      714       define variable varempty-scale           as   logical                             no-undo.
      715       define variable varis-cons-parts-have    as   logical                             no-undo.
      716       define variable varsum-base-factovp      like ub.gds-dtl.price-base               no-undo.
      717       define variable varslt-base-factovp      like ub.gds-dtl.price-base               no-undo.
      718       define variable varvat-base-factovp      like ub.gds-dtl.price-base               no-undo.
      719       define variable varvatcons-base-factovp  like ub.gds-dtl.price-base               no-undo.
      720       define variable vardsc-base-factovp      like ub.gds-dtl.price-base               no-undo.
      721       define variable varsum-base-docovp       like ub.gds-dtl.price-base               no-undo.
      722       define variable varslt-base-docovp       like ub.gds-dtl.price-base               no-undo.
      723       define variable varvat-base-docovp       like ub.gds-dtl.price-base               no-undo.
      724       define variable varvatcons-base-docovp   like ub.gds-dtl.price-base               no-undo.
      725       define variable vardsc-base-docovp       like ub.gds-dtl.price-base               no-undo.
      726       define variable varsum-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      727       define variable varslt-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      728       define variable varvat-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      729       define variable varvatcons-rubl-factovp  like ub.gds-dtl.price-base               no-undo.
      730       define variable vardsc-rubl-factovp      like ub.gds-dtl.price-base               no-undo.
      731       define variable varsum-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      732       define variable varslt-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      733       define variable varvat-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      734       define variable varvatcons-rubl-docovp   like ub.gds-dtl.price-base               no-undo.
      735       define variable vardsc-rubl-docovp       like ub.gds-dtl.price-base               no-undo.
      736       define variable varfact-qnty             like ub.parts.fact-qnty                  no-undo.
      737       define variable varcons-qnty             like ub.parts.fact-qnty                  no-undo.
      738       define variable varis-one-gds-dtl        as   logical                             no-undo.
      739       define variable varcurprice-base         like ub.gds-dtl.cur-base                 no-undo.
      740       define variable varcurprice-rubl         like ub.gds-dtl.price-base               no-undo.
      741       define variable varcurdiscnt-base        like ub.gds-dtl.cur-base                 no-undo.
      742       define variable varcurdiscnt-rubl        like ub.gds-dtl.price-base               no-undo.
      743       define variable varoutvprb               as   character                           no-undo.
      744       define variable out-vatp-have-vat-slt    as   logical initial yes                 no-undo.
      745       define buffer   in-vatp-trn-doco  for ub.trn-doc .
      746       define buffer   in-vatp-partso    for ub.parts   .
      747       define buffer   in-vatp-doco      for ub.trn-doc .
      748       define buffer   in-vatp-goodso    for ub.goods   .
      749       define buffer   in-vatp-sysconfo  for ub.sysconf .
      750       define buffer   in-vatp_doc-attro for ub.doc-attr.
      751       define variable in-vatp-have-vat-slto       as   logical initial yes    no-undo.
      752       define variable vat-pc-loco                 like ub.doc-line.vat-pc     no-undo.
      753       define variable varinvprbo                  as   character              no-undo.
      754       define variable slt-pc-loco                 like ub.doc-line.slt-pc     no-undo.
      755       define variable cli-base-rateo              as   decimal                no-undo.
      756       define variable price-rubl-with-tax-loco    like ub.doc-line.price-rubl no-undo.
      757       define variable price-base-with-tax-loco    like ub.doc-line.price-base no-undo.
      758       define variable price-cli-with-tax-loco     like ub.doc-line.price-cli  no-undo.
      759       define variable price-rubl-without-tax-loco like ub.doc-line.price-rubl no-undo.
      760       define variable price-base-without-tax-loco like ub.doc-line.price-base no-undo.
      761       define variable price-cli-without-tax-loco  like ub.doc-line.price-base no-undo.
      762       define variable vat-base-loco               like ub.doc-line.price-base no-undo.
      763       define variable vat-rubl-loco               like ub.doc-line.price-rubl no-undo.
      764       define variable vat-cli-loco                like ub.doc-line.price-rubl no-undo.
      765       define variable slt-base-loco               like ub.doc-line.price-base no-undo.
      766       define variable slt-rubl-loco               like ub.doc-line.price-rubl no-undo.
      767       define variable slt-cli-loco                like ub.doc-line.price-rubl no-undo.
      768       define variable road-tax-base-loco          like ub.doc-line.road-tax   no-undo.
      769       define variable road-tax-rubl-loco          like ub.doc-line.road-tax   no-undo.
      770       define variable road-tax-cli-loco           like ub.doc-line.road-tax   no-undo.
      771       define variable transport-base-loco         like ub.doc-line.price-base no-undo.
      772       define variable transport-rubl-loco         like ub.doc-line.price-rubl no-undo.
      773       define variable transport-cli-loco          like ub.doc-line.price-rubl no-undo.
      774       define variable other-base-loco             like ub.doc-line.price-base no-undo.
      775       define variable other-rubl-loco             like ub.doc-line.price-rubl no-undo.
      776       define variable other-cli-loco              like ub.doc-line.price-rubl no-undo.
      777       define variable exch-rate-cli-loco          like ub.trn-doc.exch-rate   no-undo.
      778       define variable varinvatp-envdo             as   character              no-undo.
      779       define variable varinvatp-typeo             as   character              no-undo.
      780       define variable v-gds-dtl-fact-qnty as decimal no-undo .
      781       define buffer buf_gds-dtl  for ub.gds-dtl .
      782       define buffer buf_goods    for ub.goods .
      783       define buffer buf_trn-doc  for ub.trn-doc .
      784       define buffer buf_doc-line for ub.doc-line .
      785       find first buf_doc-line no-lock
      786         where buf_doc-line.doc-code  = p-doc-code
      787           and buf_doc-line.artic     = p-artic
      788           and buf_doc-line.prod-type = p-prod-type
      789           and buf_doc-line.prod-code = p-prod-code
      790         no-error .
      791       if not available buf_doc-line then do:
      792         message
      793           vss-workfile vss-revision vss-description skip
      794           vss-include-info11 skip
      795           "Ошибка задания входных параметров" skip
      796           "Не найдена строка документа" skip
      797           "Документ" p-doc-code skip
      798           "Артикул" p-artic p-prod-type p-prod-code skip
      799           view-as alert-box error .
      800         undo, return error .
      801       end.
      802       find first buf_trn-doc no-lock
      803         where buf_trn-doc.doc-code = buf_doc-line.doc-code
      804         no-error .
      805       if not available buf_trn-doc then do:
      806         message
      807           vss-workfile vss-revision vss-description skip
      808           vss-include-info11 skip
      809           "Не найден документ" skip
      810           "Документ" p-doc-code skip
      811           "Артикул" p-artic p-prod-type p-prod-code skip
      812           view-as alert-box error .
      813         undo, return error .
      814       end.
      815       for each buf_gds-dtl no-lock
      816         where buf_gds-dtl.doc-code  = buf_doc-line.doc-code
      817           and buf_gds-dtl.artic     = buf_doc-line.artic
      818           and buf_gds-dtl.prod-type = buf_doc-line.prod-type
      819           and buf_gds-dtl.prod-code = buf_doc-line.prod-code
      820       on error undo, return error
      821       :
      822           if buf_trn-doc.doc-type <> 'инв':U
      823           then do:
      824               if buf_trn-doc.doc-type = 'при':U
      825               or buf_trn-doc.doc-type = 'возврат':U
      826               then do:
      827                   assign
      828                       v-gds-dtl-fact-qnty = buf_gds-dtl.fact-qnty
      829                   .
      830               end.
      831               else do:
      832                   assign
      833                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      834                   .
      835               end.
      836           end.
      837           else do:
      838               assign
      839                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      840               .
      841           end.
      842           if v-gds-dtl-fact-qnty <> 0
      843           then do:
      844   if buf_trn-doc.ext-doc-type = 'ot':U or
      845      buf_trn-doc.ext-doc-type = ?                 then do:
      846     assign
      847      out-vatp-have-vat-slt = yes.
      848   end.
      849   else do:
      850     find first out-vatp_doc-attr no-lock
      851       where out-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      852         and out-vatp_doc-attr.attr-code = 'envd':U
      853         no-error .
      854     if not available out-vatp_doc-attr then do:
      855       assign
      856         out-vatp-have-vat-slt = yes.
      857     end.
      858     else do:
      859        out-vatp-have-vat-slt = no.
      860     end.
      861   end.
      862   find first out-vatp_goods where out-vatp_goods.artic     = buf_doc-line.artic     and
      863                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
      864                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
