     3197   end procedure.
     3198   procedure get-full-path-RepViewer:
     3199       define output parameter p-fill-path-RepView as character no-undo.
     3200       if search("exe\ReportViewer\reportviewer.exe") <> ? then
     3201       do:
     3202           p-fill-path-RepView = search("exe\ReportViewer\reportviewer.exe").
     3203       end.
     3204       else
     3205       do:
     3206           message "Не найдена программа просмотра отчёта!" view-as alert-box error.
     3207       end.
     3208   end procedure.
     3209   procedure search-full-path-Report:
     3210       define input parameter p-file-name as character no-undo.
     3211       if search(p-file-name) = ? then
     3212       do:
     3213           message "Не найден файл отчёта: " p-file-name view-as alert-box error.
     3214       end.
     3215       else
     3216       do:
     3217           p-file-name = search(p-file-name).
     3218       end.
     3219   end procedure.
     3220   procedure create-file:
     3221       define input parameter p-file-name as character no-undo.
     3222       output to value(string(p-file-name)).
     3223       output close.
     3224   end procedure.
     3225   procedure define-full-path-Report:
     3226       define input parameter p-rep-num as integer no-undo.
     3227       define output parameter p-file-name-rep-htm as character no-undo.
     3228       p-file-name-rep-htm = session:temp-directory + "rpt" + string(p-rep-num) + ".html".
     3229   end procedure.
     3230   procedure Report-Viewer:
     3231       define input parameter p-full-path-RepView as character no-undo.
     3232       define input parameter p-file-name-rep-htm as character no-undo.
     3233       os-command no-wait value(p-full-path-RepView + " true " + search(p-file-name-rep-htm)).
     3234   end procedure.
     3235   function fnc-DD-MM-YYYY returns character
     3236       (input p-dat-date as date):
     3237       define variable result     as character no-undo.
     3238       define variable p-str-date as character no-undo.
     3239       p-str-date = replace(string(p-dat-date,'99.99.9999'), "/", ".").
     3240       return p-str-date.
     3241   end function.
     3242   function fnc-convert-dot-to-colon returns character
     3243       (input p-data as decimal, input p-accur as character):
     3244       define variable result       as character no-undo.
     3245       define variable v-str-result as character no-undo.
     3246       p-data = round(p-data, 2).
     3247       v-str-result = trim(replace(string(p-data, p-accur), ".", ",")).
     3248       return v-str-result.
     3249   end function.
