      787   define new global shared variable g#library  as handle no-undo .
      788   define new global shared variable g#library2 as handle no-undo .
      789   define variable var-report-r-b as character no-undo .
      790   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      791   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      792     (output var-report-r-b
      793     )  .
      794   def var vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      795   procedure gen-key-rec :
      796     define input  parameter p-tbl-name    as character no-undo.
      797     define input  parameter p-bh_tbl-name as handle    no-undo.
      798     define output parameter p-key-rec     as character no-undo.
      799     do
      800     on error  undo, return error substitute( "&1 (gen-key-rec). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      801     on stop   undo, return error substitute( "&1 (gen-key-rec). stop", vss-workfile )
      802     on endkey undo, return error substitute( "&1 (gen-key-rec). endkey", vss-workfile )
      803     :
      804       define variable fh               as handle    no-undo .
      805       define variable v-ok             as logical   no-undo .
      806       define variable v-inform         as character no-undo .
      807       define variable v-ind            as integer   no-undo .
      808       define variable v-idx-field-qnty as integer   no-undo .
      809       if p-tbl-name = ?
      810         or p-tbl-name = "":U
      811       then do:
      812         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Не задано имя таблицы.", vss-include-info8 ).
      813       end.
      814       if not p-bh_tbl-name:available then do:
      815         return error substitute( "&1 (gen-key-rec). Ошибка задания входных параметров. Переданый буфер таблицы &2 не доступен", vss-include-info8, p-tbl-name ).
      816       end.
      817       assign
      818         p-key-rec = p-tbl-name
      819         v-inform  = p-bh_tbl-name:index-information(1)
      820         v-ind     = 2
      821       .
      822       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      823       on error undo, return error
      824       :
      825         assign
      826           v-inform = p-bh_tbl-name:index-information( v-ind )
      827           v-ind    = v-ind + 1
      828         .
      829       end.
      830       if v-inform = ?
      831         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      832         or entry( 3, v-inform, ",":U ) <> "1":U
      833       then do:
      834         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, p-tbl-name ).
      835       end.
      836       else do:
      837         assign
      838           v-idx-field-qnty = num-entries( v-inform ) - 4
      839         .
      840         if v-idx-field-qnty < 2 then do:
      841           return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, p-tbl-name ).
      842         end.
      843         do v-ind = 1 to v-idx-field-qnty by 2
      844         on error undo, return error
      845         :
      846           assign
      847             fh = p-bh_tbl-name:buffer-field( entry( 4 + v-ind, v-inform, ",":U ) ).
      848             p-key-rec = p-key-rec + chr(3) + substitute("&1", replace(fh:buffer-value(),chr(3),chr(2) + chr(9) + chr (2)))
      849           .
      850         end.
      851       end.
      852       if p-key-rec = ? then do:
      853         assign
      854           p-key-rec = "":U
      855         .
      856         return error substitute( "&1. Поле(поля) первичного ключа таблицы &2 имеет(ют) неопределенное значение", vss-include-info8, p-tbl-name ).
      857       end.
      858     end.
      859     return.
      860   end procedure.
      861   procedure gen-where-keyr-tab :
      862     define input  parameter i-tableSerach as character no-undo.
      863     define input  parameter i-tablekey   as character  no-undo.
      864     define input  parameter p-key-rec    as character  no-undo.
      865     define input  parameter p-key-handle as handle     no-undo .
      866     define input  parameter p-db-name    as character  no-undo .
      867     define input  parameter p-tt-handle  as handle     no-undo .
      868     define output parameter o-Where      as character  no-undo.
      869     do
      870     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
      871     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
      872     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile )
      873     :
      874       define variable v-full-tbl-name  as character no-undo .
      875       define variable bh_tbl-name      as handle    no-undo .
      876       define variable fh_key           as handle    no-undo .
      877       define variable fh_search        as handle    no-undo .
      878       define variable v-field-num      as integer   no-undo .
      879       define variable v-count-fld      as integer   no-undo .
      880       define variable v-inform         as character no-undo .
      881       define variable v-ind            as integer   no-undo .
      882       define variable v-idx-field-qnty as integer   no-undo .
      883       define variable v-field-name     as character no-undo .
      884       define variable v-field-val      as character no-undo .
      885       define variable v-word-link      as character no-undo .
      886       define variable vTable           as character no-undo.
      887       define variable bh_tbl-key       as handle    no-undo .
      888       assign
      889         p-key-rec = trim( p-key-rec )
      890       .
      891       if p-key-handle <> ? then do:
      892         if not valid-handle(p-key-handle)
      893            or p-key-handle:type <> "buffer"
      894         then do:
      895           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Задан невалидный буфер для поиска.", vss-include-info8 ).
      896         end.
      897         if num-entries( p-key-rec, chr(3) ) > 1
      898           or p-key-rec = ?
      899           or p-key-rec = "":U
      900         then do:
      901           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. При поиске по буферу вместо ключа (&2) должено быть 'имя таблицы'.", vss-include-info8, p-key-rec ).
      902         end.
      903       end.
      904       else do:
      905         if p-key-rec = ?
      906           or p-key-rec = "":U
      907         then do:
      908           return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
      909         end.
      910       end.
      911       assign
      912         vTable = entry( 1 , p-key-rec, chr(3) )
      913       .
      914       if p-tt-handle <> ?
      915         and ( not valid-handle(p-tt-handle)
      916               or p-tt-handle:type <> "buffer"
      917             )
      918       then do:
      919         return error substitute( "&1 (gen-row-keyr). Ошибка задания входных параметров. &2&3Передан невалидный handle для поиска или handle не типа BUFFER", vss-include-info8, vTable, chr(10) ).
      920       end.
      921       if p-tt-handle = ? then do:
      922         assign
      923           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable )
      924         .
      925         create buffer bh_tbl-name for table v-full-tbl-name .
      926       end.
      927       else do:
      928         create buffer bh_tbl-name for table p-tt-handle:table-handle .
      929       end.
      930       assign
      931         v-inform = bh_tbl-name:index-information(1)
      932         v-ind    = 2
      933       .
      934       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
      935       on error undo, return error
      936       :
      937         assign
      938           v-inform = bh_tbl-name:index-information( v-ind )
      939           v-ind    = v-ind + 1
      940         .
      941       end.
      942       if v-inform = ?
      943         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
      944         or entry( 3, v-inform, ",":U ) <> "1":U
      945       then do:
      946         delete object bh_tbl-name no-error.
      947         return error substitute( "&1. Таблица &2 не имеет первичного ключа", vss-include-info8, vTable ).
      948       end.
      949       assign
      950         v-idx-field-qnty = num-entries( v-inform ) - 4
      951       .
      952       if v-idx-field-qnty < 2 then do:
      953         delete object bh_tbl-name no-error.
      954         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, vTable ).
      955       end.
      956       assign
      957         o-where     = "where":U
      958         v-word-link = "":U
      959         v-field-num = num-entries( p-key-rec, chr(3) ) - 1
      960         v-count-fld = 0
      961       .
      962       if i-tablekey ne "" and i-tablekey ne ?
      963       then do:
      964         assign
      965           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tablekey )
      966         .
      967         create buffer bh_tbl-key for table v-full-tbl-name .
      968       end.
      969       if i-tableSerach ne "" and i-tableSerach ne ?
      970       then do:
      971         delete object bh_tbl-name no-error.
      972         assign
      973           v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach )
      974         .
      975         create buffer bh_tbl-name for table v-full-tbl-name .
      976       end.
      977       block_where:
      978       do v-ind = 1 to v-idx-field-qnty by 2
      979       on error undo, return error
      980       :
      981         assign
      982           v-count-fld = v-count-fld + 1
      983         .
      984         if p-key-handle = ?
      985           and v-count-fld > v-field-num
      986         then do:
      987           leave block_where.
      988         end.
      989         define variable VfieldKeyTable as handle no-undo.
      990         assign
      991           v-field-name = entry( 4 + v-ind, v-inform, ",":U )
      992           fh_search    = bh_tbl-name:buffer-field( v-field-name )
      993         .
      994         if     bh_tbl-key ne ?
      995         then do:
      996            VfieldKeyTable = bh_tbl-key:buffer-field( v-field-name ) no-error.
      997            if VfieldKeyTable eq ?
      998            then next block_where.
      999         end.
     1000         if v-full-tbl-name ne "" and v-full-tbl-name ne ?
     1001         then
     1002            o-where = substitute( "&1 &2 &3.&4 =", o-where, v-word-link,v-full-tbl-name, v-field-name ).
     1003         else
     1004            o-where = substitute( "&1 &2 &3 =", o-where, v-word-link, v-field-name ).
     1005         if p-key-handle = ? then do:
     1006           assign
     1007             v-field-val = replace (entry( v-count-fld + 1 , p-key-rec, chr(3) ),chr(2) + chr(9) + chr (2),chr(3))
     1008           .
     1009         end.
     1010         else do:
     1011           assign
     1012             fh_key = p-key-handle:buffer-field( v-field-name )
     1013           .
     1014           if fh_key = ?
     1015             or not valid-handle( fh_key )
     1016           then do:
     1017             delete object bh_tbl-name.
     1018             if     bh_tbl-key ne ?
     1019             then
     1020                delete object bh_tbl-key.
     1021             return error substitute( "&1. Буфер &2 не содержит поля &3 необходимого для поиска.", vss-include-info8, p-key-handle:name, v-field-name ).
     1022           end.
     1023           assign
     1024             v-field-val = fh_key:buffer-value
     1025           .
     1026         end.
     1027         if fh_search:data-type ="character":U then do:
     1028           assign
     1029             v-field-val = replace( v-field-val, '~~':U, '~~~~':U )
     1030             v-field-val = replace( v-field-val, '"':U, '~~"':U )
     1031             v-field-val = replace( v-field-val, "'":U, "~~'":U )
     1032             v-field-val = replace( v-field-val, '~{':U, '~~~{':U )
     1033             v-field-val = replace( v-field-val, '~}':U, '~~~}':U )
     1034             v-field-val = replace( v-field-val, '~\':U, '~~~\':U )
     1035             v-field-val = replace( v-field-val, chr(10), '~~n':U )
     1036             v-field-val = replace( v-field-val, chr(9), '~~t':U )
     1037             v-field-val = replace( v-field-val, chr(13), '~~r':U )
     1038             v-field-val = replace( v-field-val, chr(27), '~~E':U )
     1039             v-field-val = replace( v-field-val, chr(8), '~~b':U )
     1040             v-field-val = replace( v-field-val, chr(12), '~~f':U )
     1041             v-field-val = substitute( '"&1"', v-field-val )
     1042           .
     1043         end.
     1044         assign
     1045           o-where = substitute( "&1 &2", o-where, v-field-val )
     1046         .
     1047         if v-word-link = "":U then do:
     1048           assign
     1049             v-word-link = "and":U
     1050           .
     1051         end.
     1052       end.
     1053       delete object bh_tbl-name.
     1054       if     bh_tbl-key ne ?
     1055       then
     1056          delete object bh_tbl-key.
     1057       if p-key-handle = ?
     1058         and v-count-fld <> v-field-num
     1059       then do:
     1060         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2", vss-include-info8, vTable ).
     1061       end.
     1062     end.
     1063   end procedure.
     1064   procedure gen-hn-keyr-tab :
     1065     define input  parameter i-tableSerach as character no-undo.
     1066     define input  parameter i-tablekey   as character no-undo.
     1067     define input  parameter p-key-rec    as character no-undo.
     1068     define input  parameter p-key-handle as handle    no-undo .
     1069     define input  parameter p-db-name    as character no-undo .
     1070     define input  parameter p-tt-handle  as handle    no-undo .
     1071     define input  parameter p-stts-lock  as integer   no-undo .
     1072     define output parameter o-hn         as handle    no-undo.
     1073     define variable v-full-tbl-name as character no-undo.
     1074     define variable v-where         as character no-undo.
     1075     define variable bh_tbl-name     as handle    no-undo.
     1076     define variable vTable          as character no-undo.
     1077     do
     1078     on error  undo, return error substitute( "&1 (gen-row-keyr). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1079     on stop   undo, return error substitute( "&1 (gen-row-keyr). stop", vss-workfile )
     1080     on endkey undo, return error substitute( "&1 (gen-row-keyr). endkey", vss-workfile ):
     1081         run gen-where-keyr-tab(i-tableSerach,
     1082                                i-tablekey,
     1083                                p-key-rec,
     1084                                p-key-handle,
     1085                                p-db-name,
     1086                                p-tt-handle,
     1087                                output v-where).
     1088         if i-tableSerach ne "" and i-tableSerach ne ?
     1089         then do:
     1090            v-full-tbl-name = substitute( "&1.&2":U, p-db-name, i-tableSerach ).
     1091            create buffer bh_tbl-name for table v-full-tbl-name .
     1092         end.
     1093         else do:
     1094            if p-tt-handle = ? then do:
     1095               assign
     1096                  vTable = entry( 1 , p-key-rec, chr(3) )
     1097               .
     1098               v-full-tbl-name = substitute( "&1.&2":U, p-db-name, vTable ).
     1099               create buffer bh_tbl-name for table v-full-tbl-name .
     1100            end.
     1101            else do:
     1102               create buffer bh_tbl-name for table p-tt-handle:table-handle .
     1103            end.
     1104         end.
     1105         if p-tt-handle = ? then do:
     1106            bh_tbl-name:find-first( v-where, p-stts-lock ) no-error .
     1107         end.
     1108         else do:
     1109            bh_tbl-name:find-first( v-where ) no-error .
     1110         end.
     1111         o-hn = bh_tbl-name.
     1112      end.
     1113   end procedure.
     1114   procedure gen-hn-keyr :
     1115     define input  parameter p-key-rec    as character no-undo.
     1116     define input  parameter p-key-handle as handle    no-undo .
     1117     define input  parameter p-db-name    as character no-undo .
     1118     define input  parameter p-tt-handle  as handle    no-undo .
     1119     define input  parameter p-stts-lock  as integer   no-undo .
     1120     define output parameter o-hn         as handle    no-undo.
     1121     run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output o-hn).
     1122   end.
     1123   procedure gen-row-keyr :
     1124     define input  parameter p-key-rec    as character no-undo.
     1125     define input  parameter p-key-handle as handle    no-undo .
     1126     define input  parameter p-db-name    as character no-undo .
     1127     define input  parameter p-tt-handle  as handle    no-undo .
     1128     define input  parameter p-stts-lock  as integer   no-undo .
     1129     define output parameter p-tbl-row    as rowid     no-undo.
     1130     define output parameter p-tbl-name   as character no-undo.
     1131     define variable vHn as handle no-undo.
     1132       run gen-hn-keyr-tab(?,?,p-key-rec,p-key-handle,p-db-name,p-tt-handle,p-stts-lock,output vHn).
     1133       p-tbl-row = if vHn:available then vHn:rowid else ?.
     1134       p-tbl-name =  vHn:table.
     1135       delete object vHn no-error.
     1136     if p-tbl-row = ? then do:
     1137       return substitute( "Не найдена запись таблицы &2 по ключу &3", vss-include-info8, p-tbl-name, p-key-rec ).
     1138     end.
     1139     else do:
     1140       return.
     1141     end.
     1142   end procedure.
     1143   procedure gen-key-fv :
     1144     define input  parameter p-key-rec    as character no-undo .
     1145     define output parameter p-field-list as character no-undo .
     1146     define output parameter p-value-list as character no-undo.
     1147     do
     1148     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1149     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1150     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1151     :
     1152       define variable v-full-tbl-name  as character no-undo .
     1153       define variable bh_tbl-name      as handle    no-undo .
     1154       define variable v-tbl-name       as character no-undo .
     1155       define variable v-field-num      as integer   no-undo .
     1156       define variable v-count-fld      as integer   no-undo .
     1157       define variable v-inform         as character no-undo .
     1158       define variable v-ind            as integer   no-undo .
     1159       define variable v-idx-field-qnty as integer   no-undo .
     1160       define variable v-delim-key      as character no-undo .
     1161       if p-key-rec = ?
     1162         or p-key-rec = "":U
     1163       then do:
     1164         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан уникальный ключ.", vss-include-info8 ).
     1165       end.
     1166       assign
     1167         v-tbl-name      = entry( 1 , p-key-rec, chr(3) )
     1168         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1169       .
     1170       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1171       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверный уникальный ключ.", vss-include-info8 ).
     1172       assign
     1173         v-inform = bh_tbl-name:index-information(1)
     1174         v-ind    = 2
     1175       .
     1176       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1177       on error undo, return error
     1178       :
     1179         assign
     1180           v-inform = bh_tbl-name:index-information( v-ind )
     1181           v-ind    = v-ind + 1
     1182         .
     1183       end.
     1184       if v-inform = ?
     1185         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1186         or entry( 3, v-inform, ",":U ) <> "1":U
     1187       then do:
     1188         delete object bh_tbl-name no-error.
     1189         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1190       end.
     1191       assign
     1192         v-idx-field-qnty = num-entries( v-inform ) - 4
     1193       .
     1194       if v-idx-field-qnty < 2 then do:
     1195         delete object bh_tbl-name no-error.
     1196         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1197       end.
     1198       assign
     1199         p-field-list = "":U
     1200         p-value-list = "":U
     1201         v-delim-key  = "":U
     1202         v-field-num  = num-entries( p-key-rec, chr(3) ) - 1
     1203         v-count-fld  = 0
     1204       .
     1205       block_where:
     1206       do v-ind = 1 to v-idx-field-qnty by 2
     1207       on error undo, return error
     1208       :
     1209         assign
     1210           v-count-fld = v-count-fld + 1
     1211         .
     1212         if v-count-fld > v-field-num then do:
     1213           leave block_where.
     1214         end.
     1215         assign
     1216           p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U )
     1217           p-value-list = p-value-list + v-delim-key + entry( v-count-fld + 1 , p-key-rec, chr(3) )
     1218         .
     1219         if v-ind = 1 then do:
     1220           assign
     1221             v-delim-key = chr(3)
     1222           .
     1223         end.
     1224       end.
     1225       delete object bh_tbl-name.
     1226       if v-count-fld <> v-field-num then do:
     1227         return error substitute( "&1. Не совпадает количество полей первичного ключа для таблицы &2 в БД", vss-include-info8, v-tbl-name ).
     1228       end.
     1229     end.
     1230   end procedure.
     1231   procedure gen-key-field :
     1232     define input  parameter p-table      as character no-undo .
     1233     define output parameter p-field-list as character no-undo .
     1234     do
     1235     on error  undo, return error substitute( "&1 (gen-key-fv). &2&3&4", vss-workfile, return-value, chr(10), error-status :get-message ( error-status :num-messages ) )
     1236     on stop   undo, return error substitute( "&1 (gen-key-fv). stop", vss-workfile )
     1237     on endkey undo, return error substitute( "&1 (gen-key-fv). endkey", vss-workfile )
     1238     :
     1239       define variable v-full-tbl-name  as character no-undo .
     1240       define variable bh_tbl-name      as handle    no-undo .
     1241       define variable v-tbl-name       as character no-undo .
     1242       define variable v-field-num      as integer   no-undo .
     1243       define variable v-count-fld      as integer   no-undo .
     1244       define variable v-inform         as character no-undo .
     1245       define variable v-ind            as integer   no-undo .
     1246       define variable v-idx-field-qnty as integer   no-undo .
     1247       define variable v-delim-key      as character no-undo .
     1248       if p-table = ?
     1249         or p-table = "":U
     1250       then do:
     1251         return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Не задан таблица.", vss-include-info8 ).
     1252       end.
     1253       assign
     1254         v-tbl-name      = p-table
     1255         v-full-tbl-name = substitute( "ub.&1":U, v-tbl-name )
     1256       .
     1257       create buffer bh_tbl-name for table v-full-tbl-name no-error .
     1258       if error-status:error then return error substitute( "&1 (gen-key-fv). Ошибка задания входных параметров. Неверная таблица.", vss-include-info8 ).
     1259       assign
     1260         v-inform = bh_tbl-name:index-information(1)
     1261         v-ind    = 2
     1262       .
     1263       do while v-inform <> ? and entry( 3, v-inform, ",":U ) <> "1":U
     1264       on error undo, return error
     1265       :
     1266         assign
     1267           v-inform = bh_tbl-name:index-information( v-ind )
     1268           v-ind    = v-ind + 1
     1269         .
     1270       end.
     1271       if v-inform = ?
     1272         or LC( entry( 1, v-inform, ",":U ) ) = "default":U
     1273         or entry( 3, v-inform, ",":U ) <> "1":U
     1274       then do:
     1275         return error substitute( "&1. Таблица &2 не имеет первичного ключа в БД", vss-include-info8, v-tbl-name ).
     1276       end.
     1277       assign
     1278         v-idx-field-qnty = num-entries( v-inform ) - 4
     1279       .
     1280       if v-idx-field-qnty < 2 then do:
     1281         return error substitute( "&1. Определенный первичный индекс (&2) не содержит списка полей для таблицы &3", vss-include-info8, v-inform, v-tbl-name ).
     1282       end.
     1283       assign
     1284         p-field-list = "":U
     1285         v-delim-key  = "":U
     1286         v-count-fld  = 0
     1287       .
     1288       block_where:
     1289       do v-ind = 1 to v-idx-field-qnty by 2
     1290       on error undo, return error
     1291       :
     1292         assign
     1293           v-count-fld = v-count-fld + 1
     1294         .
     1295         p-field-list = p-field-list + v-delim-key + entry( 4 + v-ind, v-inform, ",":U ).
     1296         if v-ind = 1 then do:
     1297           assign
     1298             v-delim-key = chr(3)
     1299           .
     1300         end.
     1301       end.
     1302       delete object bh_tbl-name.
     1303     end.
     1304   end procedure.
     1305   CREATE WIDGET-POOL.
     1306   DEFINE VARIABLE State-source      as WIDGET-HANDLE NO-UNDO .
     1307   DEFINE VARIABLE v-esys-id         AS integer NO-UNDO.
     1308   DEFINE VARIABLE v-profile-id         AS integer NO-UNDO.
     1309   define variable v-keep-days-num as integer no-undo .
     1310   define variable loc-ref-list as character no-undo .
     1311   DEFINE BUTTON b-esys
     1312        IMAGE-UP FILE "btn-down-arrow":U
     1313        IMAGE-DOWN FILE "btn-down-arrow":U
     1314        IMAGE-INSENSITIVE FILE "btn-down-arrow":U
     1315        LABEL "Btn 1"
     1316        SIZE 4 BY 1.
     1317   DEFINE VARIABLE f-esys-id AS INTEGER FORMAT ">>>>>>9":U INITIAL 0
     1318        LABEL "Код Внеш.системы, в которую идет выгрузка"
     1319         VIEW-AS TEXT
     1320        SIZE 10 BY .67 NO-UNDO.
     1321   DEFINE VARIABLE f-esys-name AS CHARACTER FORMAT "X(256)":U
     1322         VIEW-AS TEXT
     1323        SIZE 68.5 BY .67
     1324        FGCOLOR 4  NO-UNDO.
     1325   DEFINE VARIABLE f-keep-days-num AS INTEGER FORMAT ">>9":U INITIAL 0
     1326        LABEL "Срок хранения отчета (дни)"
     1327        VIEW-AS FILL-IN
     1328        SIZE 5 BY 1 NO-UNDO.
     1329   DEFINE RECTANGLE RECT-7
     1330        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1331        SIZE 71.4 BY 16.27.
     1332   DEFINE FRAME F-Main
     1333        b-esys AT ROW 7.4 COL 63 WIDGET-ID 16
     1334        f-keep-days-num AT ROW 11.67 COL 48.5 COLON-ALIGNED WIDGET-ID 20
     1335        f-esys-id AT ROW 7.4 COL 48 COLON-ALIGNED WIDGET-ID 14
     1336        f-esys-name AT ROW 9.53 COL 2 COLON-ALIGNED NO-LABEL WIDGET-ID 18
     1337        RECT-7 AT ROW 1.27 COL 2
     1338       WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY
     1339            SIDE-LABELS NO-UNDERLINE THREE-D
     1340            AT COL 1 ROW 1 SCROLLABLE
     1341            BGCOLOR 8 .
     1342   IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
     1343     MESSAGE "c:\tester\Rls_16_0\rc_160_rus\cmpdir\src\rep\e-ptdysa.w should only be RUN PERSISTENT.":U
     1344             VIEW-AS ALERT-BOX ERROR BUTTONS OK.
     1345     RETURN.
     1346   END.
     1347   DEFINE VAR adm-object-hdl       AS HANDLE NO-UNDO.
     1348   DEFINE VAR adm-query-opened        AS LOGICAL NO-UNDO INIT NO.
     1349   DEFINE VAR adm-row-avail-state     AS LOGICAL NO-UNDO INIT ?.
     1350   DEFINE VAR adm-initial-lock        AS CHARACTER NO-UNDO INIT "NO-LOCK":U.
     1351   DEFINE VAR adm-new-record          AS LOGICAL NO-UNDO INIT no.
     1352   DEFINE VAR adm-updating-record     AS LOGICAL NO-UNDO INIT no.
     1353   DEFINE VAR adm-check-modified-all  AS LOGICAL NO-UNDO INIT no.
     1354   DEFINE NEW GLOBAL SHARED VAR adm-broker-hdl    AS HANDLE  NO-UNDO.
     1355         adm-object-hdl = FRAME F-Main:HANDLE.
     1356   RUN ensure-broker.
     1357   THIS-PROCEDURE:ADM-DATA =
     1358        'ADM1.1~`':U +
     1359        'SmartViewer~`':U +
     1360        '~`':U +
     1361        'NO ~`':U +
     1362        '~`':U +
     1363        '~`':U +
     1364        '~`':U +
     1365        (IF adm-object-hdl = ? THEN "":U ELSE STRING(adm-object-hdl))
     1366           + "~`":U +
     1367        'Initial-Lock,Hide-on-Init,Disable-on-Init,Key-Name,Layout,Create-On-Add~`':U +
     1368        'Record-Source,Record-Target,TableIO-Target~`':U +
     1369        '~`':U +
     1370        '~`~`~`~`~`~`~`~`~`~`~`':U +
     1371        IF THIS-PROCEDURE:ADM-DATA = "":U OR THIS-PROCEDURE:ADM-DATA = ?
     1372            THEN "^^":U
     1373        ELSE "^":U + ENTRY(2, THIS-PROCEDURE:ADM-DATA, "^":U) +
     1374             "^":U + ENTRY(3, THIS-PROCEDURE:ADM-DATA, "^":U).
     1375   PROCEDURE adm-apply-entry :
     1376     RUN broker-apply-entry IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1377   END PROCEDURE.
     1378   PROCEDURE adm-destroy :
     1379    RUN broker-destroy IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1380   END PROCEDURE.
     1381   PROCEDURE adm-disable :
     1382       DISABLE RECT-7 b-esys f-keep-days-num WITH FRAME F-Main.
     1383       RUN dispatch ('disable-fields':U).
     1384       RUN set-attribute-list ('ENABLED=no':U).
     1385       RETURN.
     1386   END PROCEDURE.
     1387   PROCEDURE adm-edit-attribute-list :
     1388         RUN adm/support/viewerd.w (INPUT THIS-PROCEDURE).
     1389         RETURN.
     1390   END PROCEDURE.
     1391   PROCEDURE adm-enable :
     1392       ENABLE UNLESS-HIDDEN RECT-7 b-esys f-keep-days-num WITH FRAME F-Main.
     1393       RUN enable_UI IN THIS-PROCEDURE NO-ERROR.
     1394       RUN set-attribute-list ('ENABLED=yes':U).
     1395       RETURN.
     1396   END PROCEDURE.
     1397   PROCEDURE adm-exit :
     1398        RUN notify ('exit':U).
     1399     RETURN.
     1400   END PROCEDURE.
     1401   PROCEDURE adm-hide :
     1402     RUN broker-hide IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1403   END PROCEDURE.
     1404   PROCEDURE adm-initialize :
     1405     RUN broker-initialize IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1406   END PROCEDURE.
     1407   PROCEDURE adm-show-errors :
     1408       DEFINE VARIABLE        cntr                  AS INTEGER   NO-UNDO.
     1409       DO cntr = 1 TO ERROR-STATUS:NUM-MESSAGES:
     1410           MESSAGE ERROR-STATUS:GET-MESSAGE(cntr).
     1411       END.
     1412       RETURN.
     1413   END PROCEDURE.
     1414   PROCEDURE adm-UIB-mode :
     1415     RUN broker-UIB-mode IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1416   END PROCEDURE.
     1417   PROCEDURE adm-view :
     1418     RUN broker-view IN adm-broker-hdl (THIS-PROCEDURE) NO-ERROR.
     1419   END PROCEDURE.
     1420   PROCEDURE dispatch :
     1421       DEFINE INPUT PARAMETER p-method-name    AS CHARACTER NO-UNDO.
     1422       RUN broker-dispatch IN adm-broker-hdl
     1423           (THIS-PROCEDURE, p-method-name) NO-ERROR.
     1424       IF RETURN-VALUE = "ADM-ERROR":U THEN RETURN "ADM-ERROR":U.
     1425   END PROCEDURE.
     1426   PROCEDURE ensure-broker :
     1427   RUN get-attribute IN adm-broker-hdl ('TYPE':U) NO-ERROR.
     1428   IF RETURN-VALUE NE "ADM-Broker":U THEN
     1429   DO:
     1430       RUN adm/objects/broker.p PERSISTENT set adm-broker-hdl.
     1431       RUN set-broker-owner IN adm-broker-hdl (THIS-PROCEDURE).
     1432   END.
     1433   END PROCEDURE.
     1434   PROCEDURE get-attribute :
     1435     DEFINE INPUT PARAMETER p-attr-name    AS CHARACTER NO-UNDO.
     1436     RUN broker-get-attribute IN adm-broker-hdl
     1437         (INPUT THIS-PROCEDURE, INPUT p-attr-name) NO-ERROR.
     1438     RETURN RETURN-VALUE.
     1439   END PROCEDURE.
     1440   PROCEDURE get-attribute-list :
     1441     DEFINE OUTPUT PARAMETER p-attr-list AS CHARACTER NO-UNDO.
     1442     RUN broker-get-attribute-list IN adm-broker-hdl
     1443         (INPUT THIS-PROCEDURE,
     1444          INPUT ?,
     1445          OUTPUT p-attr-list) NO-ERROR.
     1446     RETURN.
     1447   END PROCEDURE.
     1448   PROCEDURE new-state :
     1449     DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
     1450     RUN broker-new-state IN adm-broker-hdl (THIS-PROCEDURE, p-state) NO-ERROR.
     1451     RETURN.
     1452   END PROCEDURE.
     1453   PROCEDURE notify :
     1454     DEFINE INPUT PARAMETER p-method AS CHARACTER NO-UNDO.
     1455     RUN broker-notify IN adm-broker-hdl (THIS-PROCEDURE, p-method) NO-ERROR.
     1456     IF RETURN-VALUE = "ADM-ERROR":U THEN
     1457         RETURN "ADM-ERROR":U.
     1458     RETURN.
     1459   END PROCEDURE.
     1460   PROCEDURE set-attribute-list :
     1461     DEFINE INPUT PARAMETER p-attr-list    AS CHARACTER NO-UNDO.
     1462     RUN ensure-broker.
     1463     RUN broker-set-attribute-list IN adm-broker-hdl
     1464         (INPUT THIS-PROCEDURE, INPUT p-attr-list) NO-ERROR.
     1465     RETURN.
     1466   END PROCEDURE.
     1467   PROCEDURE set-position :
     1468       DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
     1469       DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
     1470       IF VALID-HANDLE(adm-object-hdl) THEN
     1471       DO:
     1472         ASSIGN adm-object-hdl:ROW    =   p-row
     1473                adm-object-hdl:COLUMN =   p-col.
     1474       END.
     1475       RETURN.
     1476   END PROCEDURE.
     1477   PROCEDURE adm-display-fields :
     1478       RUN check-modified IN THIS-PROCEDURE ('clear':U) NO-ERROR.
     1479       RETURN.
     1480   END PROCEDURE.
     1481   PROCEDURE adm-open-query :
     1482     RETURN.
     1483   END PROCEDURE.
     1484   PROCEDURE adm-row-changed :
     1485         IF VALID-HANDLE(adm-object-hdl) THEN
     1486           RUN dispatch IN THIS-PROCEDURE ('display-fields':U).
     1487         RUN notify ('row-available':U).
     1488         RETURN.
     1489   END PROCEDURE.
     1490   PROCEDURE reposition-query :
     1491       DEFINE INPUT PARAMETER p-requestor-hdl     AS HANDLE NO-UNDO.
     1492       RUN set-attribute-list ('REPOSITION-PENDING = NO':U).
     1493       RETURN.
     1494   END PROCEDURE.
     1495     DEFINE VARIABLE adm-first-table         AS ROWID NO-UNDO.
     1496     DEFINE VARIABLE adm-second-table        AS ROWID NO-UNDO.
     1497     DEFINE VARIABLE adm-third-table         AS ROWID NO-UNDO.
     1498     DEFINE VARIABLE adm-adding-record       AS LOGICAL NO-UNDO INIT no.
     1499     DEFINE VARIABLE adm-return-status       AS LOGICAL   NO-UNDO.
     1500     DEFINE VARIABLE adm-first-prev-rowid    AS ROWID     NO-UNDO.
     1501     DEFINE VARIABLE adm-second-prev-rowid   AS ROWID     NO-UNDO.
     1502     DEFINE VARIABLE adm-third-prev-rowid    AS ROWID     NO-UNDO.
     1503     DEFINE VARIABLE adm-first-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1504     DEFINE VARIABLE adm-second-tmpl-recid   AS RECID     NO-UNDO INIT ?.
     1505     DEFINE VARIABLE adm-third-tmpl-recid    AS RECID     NO-UNDO INIT ?.
     1506     DEFINE VARIABLE adm-index-pos           AS INTEGER   NO-UNDO.
     1507     DEFINE VARIABLE adm-query-empty         AS LOGICAL   NO-UNDO.
     1508     DEFINE VARIABLE adm-create-complete     AS LOGICAL   NO-UNDO.
     1509     DEFINE VARIABLE adm-create-on-add       AS LOGICAL   NO-UNDO INIT ?.
     1510     DEFINE VARIABLE group-assign-target     AS LOGICAL   NO-UNDO INIT ?.
     1511     DEFINE VARIABLE group-target-list       AS CHARACTER NO-UNDO INIT ?.
     1512     IF "":U = "":U THEN
     1513       RUN modify-list-attribute IN adm-broker-hdl
     1514         (THIS-PROCEDURE, "REMOVE":U, "SUPPORTED-LINKS":U, "TABLEIO-TARGET":U).
     1515     RUN use-create-on-add(?).
     1516   PROCEDURE adm-add-record :
     1517       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1518          "must have at least one Enabled Table to perform Add.":U
     1519          VIEW-AS ALERT-BOX ERROR.
     1520       RETURN.
     1521   END PROCEDURE.
     1522   PROCEDURE adm-assign-record :
     1523    MESSAGE
     1524          "Object ":U THIS-PROCEDURE:FILE-NAME
     1525            "must have at least one Enabled Table to perform Assign.":U
     1526              VIEW-AS ALERT-BOX ERROR.
     1527      RETURN.
     1528     END PROCEDURE.
     1529   PROCEDURE adm-assign-statement :
     1530     RETURN.
     1531   END PROCEDURE.
     1532   PROCEDURE adm-cancel-record :
     1533      RETURN.
     1534     END PROCEDURE.
     1535   PROCEDURE adm-copy-record :
     1536       MESSAGE "Object ":U THIS-PROCEDURE:FILE-NAME
     1537        "must have at least one Enabled Table to perform Copy.":U
     1538          VIEW-AS ALERT-BOX ERROR.
     1539       RETURN.
     1540   END PROCEDURE.
     1541   PROCEDURE adm-create-record :
     1542      RETURN.
     1543   END PROCEDURE.
     1544   PROCEDURE adm-current-changed :
     1545     RETURN.
     1546   END PROCEDURE.
     1547   PROCEDURE adm-delete-record :
     1548    MESSAGE
     1549          "Object ":U THIS-PROCEDURE:FILE-NAME
     1550            "must have at least one Enabled Table to perform Delete.":U
     1551              VIEW-AS ALERT-BOX ERROR.
     1552       RUN dispatch IN THIS-PROCEDURE ('apply-entry':U).
     1553       RETURN.
     1554   END PROCEDURE.
     1555   PROCEDURE adm-disable-fields :
     1556         RUN notify ('disable-fields, GROUP-ASSIGN-TARGET':U).
     1557       RETURN.
     1558   END PROCEDURE.
     1559   PROCEDURE adm-enable-fields :
     1560       RETURN.
     1561   END PROCEDURE.
     1562   PROCEDURE adm-end-update :
     1563     RETURN.
     1564   END PROCEDURE.
     1565   PROCEDURE adm-reset-record :
     1566       RETURN.
     1567   END PROCEDURE.
     1568   PROCEDURE adm-update-record :
     1569       MESSAGE
     1570         "Object ":U THIS-PROCEDURE:FILE-NAME
     1571           "must have at least one Enabled Table to perform Update.":U
     1572             VIEW-AS ALERT-BOX ERROR.
     1573      RETURN.
     1574   END PROCEDURE.
     1575   PROCEDURE check-modified :
     1576   DEFINE INPUT PARAMETER check-state AS CHARACTER NO-UNDO.
     1577   DEFINE VARIABLE curr-widget       AS HANDLE      NO-UNDO.
     1578   DEFINE VARIABLE container-hdl-str AS CHARACTER   NO-UNDO.
     1579   DEFINE VARIABLE i                 AS INTEGER     NO-UNDO.
     1580     IF check-state = "check":U THEN
     1581     DO:
     1582       RUN get-link-handle IN adm-broker-hdl
     1583         (INPUT THIS-PROCEDURE, INPUT 'GROUP-ASSIGN-TARGET':U,
     1584            OUTPUT group-target-list).
     1585       IF group-target-list NE "":U THEN
     1586       DO i = 1 TO NUM-ENTRIES(group-target-list):
     1587         curr-widget = WIDGET-HANDLE(ENTRY(i, group-target-list)).
     1588         RUN check-modified IN curr-widget ('group-check':U).
     1589         IF RETURN-VALUE NE "":U THEN
     1590         DO:
     1591           RUN check-modified-message(RETURN-VALUE).
     1592           RETURN "":U.
     1593         END.
     1594       END.
     1595     END.
     1596     RETURN "":U.
     1597   END PROCEDURE.
     1598   PROCEDURE check-modified-message :
     1599     DEFINE INPUT PARAMETER p-changed-table AS CHARACTER NO-UNDO.
     1600        RUN request-attribute IN adm-broker-hdl (THIS-PROCEDURE,
     1601           'CONTAINER-SOURCE':U, 'HIDDEN':U).
     1602        IF RETURN-VALUE = "YES":U THEN
     1603           RUN notify ('view,CONTAINER-SOURCE':U).
     1604        MESSAGE IF p-changed-table NE ? THEN
     1605           SUBSTITUTE ("Current &1 record has been changed.", p-changed-table)
     1606           ELSE "Current values have been changed."
     1607           SKIP "  Do you wish to save those changes?"
     1608           VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO UPDATE ANS AS LOGICAL.
     1609        IF ANS THEN
     1610        DO:
     1611           IF group-assign-target THEN
     1612             RUN notify('update-record,GROUP-ASSIGN-SOURCE':U).
     1613           ELSE RUN dispatch('update-record':U).
     1614           IF RETURN-VALUE = "ADM-ERROR":U THEN
     1615           DO:
     1616               MESSAGE "Changes to the previous record were not saved."
     1617                 VIEW-AS ALERT-BOX ERROR.
     1618               IF group-assign-target THEN
     1619                 RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1620               ELSE RUN dispatch ('cancel-record':U).
     1621           END.
     1622        END.
     1623        ELSE DO:
     1624          IF group-assign-target THEN
     1625             RUN notify('cancel-record,GROUP-ASSIGN-SOURCE':U).
     1626          ELSE RUN dispatch('cancel-record':U).
     1627        END.
     1628        RETURN.
     1629   END PROCEDURE.
     1630   PROCEDURE get-rowid :
     1631       DEFINE OUTPUT PARAMETER p-table           AS ROWID NO-UNDO.
     1632       ASSIGN
     1633       p-table   =   adm-first-table.
     1634       RETURN.
     1635   END PROCEDURE.
     1636   PROCEDURE init-group-assign :
     1637       RUN request-attribute IN adm-broker-hdl
     1638         (THIS-PROCEDURE, 'GROUP-ASSIGN-SOURCE':U, 'ENABLED-TABLES':U).
     1639       IF LOOKUP("":U, RETURN-VALUE, " ":U) NE 0 THEN
     1640         group-assign-target = yes.
     1641       ELSE group-assign-target = no.
     1642       RETURN.
     1643   END PROCEDURE.
     1644   PROCEDURE set-editors :
     1645       DEFINE INPUT PARAMETER p-field-setting  AS CHARACTER NO-UNDO.
     1646       DEFINE VARIABLE curr-widget             AS HANDLE    NO-UNDO.
     1647       DEFINE VARIABLE read-only-list          AS CHARACTER NO-UNDO INIT "":U.
     1648       ASSIGN curr-widget = FRAME F-Main:CURRENT-ITERATION.
     1649       ASSIGN curr-widget = curr-widget:FIRST-CHILD.
     1650       DO WHILE VALID-HANDLE (curr-widget):
     1651           IF curr-widget:TYPE = "EDITOR":U AND curr-widget:TABLE NE ? AND
     1652              curr-widget:HIDDEN = no THEN DO:
     1653             CASE p-field-setting:
     1654               WHEN "INITIALIZE":U THEN
     1655               DO:
     1656                 IF curr-widget:READ-ONLY = yes THEN read-only-list =
     1657                     read-only-list +
     1658                       (IF read-only-list NE "":U THEN ",":U ELSE "":U) +
     1659                        STRING(curr-widget).
     1660               END.
     1661               WHEN "DISABLE":U OR
     1662               WHEN "ENABLE":U THEN
     1663               DO:
     1664                   curr-widget:SENSITIVE = yes.
     1665                   RUN get-attribute ('Read-Only-Editors':U).
     1666                   IF RETURN-VALUE = ? OR
     1667                     LOOKUP (STRING(curr-widget), RETURN-VALUE) EQ 0 THEN
     1668                       curr-widget:READ-ONLY =
     1669                         IF p-field-setting = "ENABLE":U THEN no ELSE yes.
     1670               END.
     1671               WHEN "CLEAR":U THEN
     1672                   curr-widget:SCREEN-VALUE = "":U.
     1673             END CASE.
     1674           END.
     1675           ASSIGN curr-widget = curr-widget:NEXT-SIBLING.
     1676       END.
     1677       IF p-field-setting = "INITIALIZE":U AND read-only-list NE "":U THEN
     1678         RUN set-attribute-list ('Read-Only-Editors = "':U + read-only-list
     1679           + '"':U).
     1680       RETURN.
     1681   END PROCEDURE.
     1682   PROCEDURE use-check-modified-all :
     1683    DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1684     ASSIGN adm-check-modified-all = IF p-attr-value = "YES":U THEN yes ELSE no.
     1685     RETURN.
     1686   END PROCEDURE.
     1687   PROCEDURE use-create-on-add :
     1688   DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1689      RETURN.
     1690   END PROCEDURE.
     1691   PROCEDURE use-initial-lock :
     1692     DEFINE INPUT PARAMETER p-attr-value AS CHARACTER NO-UNDO.
     1693     ASSIGN adm-initial-lock = p-attr-value.
     1694     RETURN.
     1695   END PROCEDURE.
     1696     RUN set-attribute-list ('FIELDS-ENABLED=no,ADM-NEW-RECORD=no':U).
     1697   ASSIGN
     1698          FRAME F-Main:SCROLLABLE       = FALSE
     1699          FRAME F-Main:HIDDEN           = TRUE.
     1700   ASSIGN
     1701          f-esys-id:READ-ONLY IN FRAME F-Main        = TRUE.
     1702   ON CHOOSE OF b-esys IN FRAME F-Main
     1703   DO:
     1704   RUN get-ext-system IN THIS-PROCEDURE  ( INPUT YES).
     1705   END.
     1706   PROCEDURE disable_UI :
     1707     HIDE FRAME F-Main.
     1708     IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
     1709   END PROCEDURE.
     1710   PROCEDURE get-ext-system :
     1711   DEFINE INPUT PARAMETER p-interface AS LOGICAL NO-UNDO.
     1712   DEFINE VARIABLE v-ok AS LOGICAL NO-UNDO.
     1713   DEFINE VARIABLE v-int AS integer NO-UNDO.
     1714   DEFINE VARIABLE v-uniq-key-rec AS CHARACTER NO-UNDO.
     1715   DEFINE VARIABLE v-rid-list AS CHARACTER NO-UNDO.
     1716   DEFINE VARIABLE v-tbl-row AS rowid NO-UNDO.
     1717   DEFINE VARIABLE v-tbl-name AS CHARACTER NO-UNDO.
     1718   DEFINE BUFFER buf_ext-system FOR ub.ext-system.
     1719   IF f-esys-id <> 0  THEN DO:
     1720      FIND FIRST buf_ext-system NO-LOCK WHERE
     1721                   buf_ext-system.esys-id = f-esys-id
     1722            AND buf_ext-system.db-num = 0 NO-ERROR.
     1723      IF AVAILABLE buf_ext-system THEN DO:
     1724          RUN gen-key-rec IN THIS-PROCEDURE ( INPUT 'ext-system':U
     1725                                             ,INPUT (BUFFER buf_ext-system:HANDLE)
     1726                                             ,OUTPUT v-uniq-key-rec) NO-ERROR.
     1727      END.
     1728   END.
     1729    IF p-interface THEN DO:
     1730         run bge/oxmlexts.p (
     1731               input my-handle
     1732             , input 2
     1733             , input substitute("esys-type = &1", '6':U)
     1734             , input v-uniq-key-rec
     1735             , output v-rid-list
     1736             , output v-ok
     1737         ).
     1738        IF NOT v-ok  THEN RETURN ERROR.
     1739             run gen-row-keyr in this-procedure
     1740             ( input v-rid-list
     1741              ,input ?
     1742              ,input "ub"
     1743              ,input ?
     1744              ,input no-lock
     1745              ,output v-tbl-row
     1746              ,output v-tbl-name
     1747            ).
     1748           find first buf_ext-system no-lock where
     1749                     rowid(buf_ext-system) = v-tbl-row.
     1750     END.
     1751     IF AVAILABLE buf_ext-system
     1752     AND (buf_ext-system.esys-id   <> f-esys-id
     1753     OR NOT p-interface) THEN DO:
     1754       f-esys-id = buf_ext-system.esys-id.
     1755       f-esys-name = buf_ext-system.esys-NAME.
     1756       DISPLAY
     1757       f-esys-id
     1758       f-esys-name
     1759       WITH FRAME F-Main.
     1760     END.
     1761   END PROCEDURE.
     1762   PROCEDURE local-apply-layout :
     1763     RUN dispatch IN THIS-PROCEDURE ( INPUT 'apply-layout':U ) .
     1764   END PROCEDURE.
     1765   PROCEDURE local-initialize :
     1766   define variable v-seconds    as integer      no-undo.
     1767      define variable v-time    as integer      no-undo.
     1768      RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .
     1769      CASE place-call:
     1770        WHEN 'schedule':U THEN DO:
     1771          RUN rcps_get-profile-id IN parent-handle ( OUTPUT v-profile-id).
     1772          CASE v-profile-id:
     1773              WHEN 51 THEN DO:
     1774                f-keep-days-num = v-keep-days-num.
     1775                f-esys-id = v-esys-id.
     1776                RUN get-ext-system IN THIS-PROCEDURE ( INPUT NO).
     1777                DISPLAY
     1778                f-esys-id
     1779                f-esys-name
     1780                f-keep-days-num
     1781                WITH FRAME F-Main.
     1782                ENABLE
     1783                b-esys WHEN params-only-mode <> 'ПРОСМОТР':U
     1784                WITH FRAME F-Main.
     1785              END.
     1786          END CASE.
     1787        END.
     1788        OTHERWISE DO:
     1789           HIDE
     1790           b-esys
     1791           f-esys-id
     1792           f-esys-name
     1793           f-keep-days-num
     1794           in FRAME F-Main.
     1795        END.
     1796      END CASE.
     1797   END PROCEDURE.
     1798   PROCEDURE my-params :
     1799   define input parameter p-action as character no-undo .
     1800   define variable v-value-character as character no-undo .
     1801   define variable v-value-date as date no-undo .
     1802   define variable v-value-decimal as decimal no-undo .
     1803   define variable v-value-integer as integer no-undo .
     1804   define variable v-value-logical as logical no-undo .
     1805   define variable v-index-id as integer no-undo .
     1806   define variable v-loc-output-type as character no-undo .
     1807   case p-action:
     1808     when "get" then do:
     1809        IF v-profile-id = 51  THEN DO:
     1810          v-index-id = 0.
     1811          RUN rcps_get-value IN parent-handle (
     1812                                             input "p-esys-id"
     1813                                            ,INPUT-output v-index-id
     1814                                            ,output v-value-character
     1815                                            ,output v-value-date
     1816                                            ,output v-value-decimal
     1817                                            ,output v-esys-id
     1818                                            ,output v-value-logical
     1819                                            ) no-error .
     1820          v-index-id = 0.
     1821          RUN rcps_get-value IN parent-handle (
     1822                                             input "p-keep-days-num"
     1823                                            ,INPUT-output v-index-id
     1824                                            ,output v-value-character
     1825                                            ,output v-value-date
     1826                                            ,output v-value-decimal
     1827                                            ,output v-keep-days-num
     1828                                            ,output v-value-logical
     1829                                            ) no-error .
     1830        END.
     1831        RUN local-initialize IN THIS-PROCEDURE.
     1832     end.
     1833     when "set" then do:
     1834       IF v-profile-id = 51 THEN DO:
     1835           ASSIGN
     1836           FRAME F-Main
     1837           f-esys-id
     1838           f-keep-days-num
     1839           .
     1840           RUN rcps_set-value IN parent-handle (
     1841                                            input "p-esys-id"
     1842                                           ,INPUT 0
     1843                                           ,input ''
     1844                                           ,input ?
     1845                                           ,input 0.0
     1846                                           ,input f-esys-id
     1847                                           ,input no
     1848                                           ) no-error .
     1849           RUN rcps_set-value IN parent-handle (
     1850                                            input "p-keep-days-num"
     1851                                           ,INPUT 0
     1852                                           ,input ''
     1853                                           ,input ?
     1854                                           ,input 0.0
     1855                                           ,input f-keep-days-num
     1856                                           ,input no
     1857                                           ) no-error .
     1858       END.
     1859     end.
     1860   end case.
     1861   END PROCEDURE.
     1862   PROCEDURE my-report :
     1863   define variable v-dataseth as handle no-undo .
     1864   define variable v-xmlh as handle no-undo .
     1865   message
     1866   "Данный отчет запускается только по расписанию!!!"
     1867   view-as alert-box error .
     1868   END PROCEDURE.
     1869   PROCEDURE my-var :
     1870   CASE place-call:
     1871     WHEN 'schedule':U THEN DO:
     1872       case v-profile-id:
     1873         when 51 then do:        assign
     1874           frame F-Main
     1875           f-esys-id
     1876           f-keep-days-num
     1877           .
     1878           ReportHeader = substitute("&1Маршрутизация во ВС: &2 &3&1Срок хранения отчетов: &4 (дни)"
     1879                                     , chr(10)
     1880                                     , f-esys-id
     1881                                     , f-esys-name
     1882                                     , f-keep-days-num
     1883                                     ).
     1884         end.
     1885       end case.
     1886     end.
     1887     otherwise do:
     1888     end.
     1889   end case.
     1890   END PROCEDURE.
     1891   PROCEDURE state-changed :
     1892     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     1893     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     1894     CASE p-state:
     1895     END CASE.
     1896     END PROCEDURE.
     1897   PROCEDURE write-to-log :
     1898   define input param p-str as char no-undo.
     1899   do
     1900   on error undo, return error
     1901   :
     1902      message
     1903         p-str
     1904         skip
     1905      view-as alert-box error.
     1906   end.
     1907   END PROCEDURE.
