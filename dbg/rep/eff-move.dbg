     1272   define variable v-value-logical   as logical   no-undo .
     1273     define variable g#report-num as integer   no-undo .
     1274     run get-report-num  in parParentProc ( output g#report-num ).
     1275     define variable g#quest-print as logical   no-undo .
     1276     run get-quest-print in parParentProc ( output g#quest-print ).
     1277     define variable g#log as logical   no-undo .
     1278     define stream Out_stream .
     1279     define shared variable sort-gr      as logical          no-undo.
     1280     define shared variable sort-name    as logical          no-undo.
     1281     define buffer buf_trn-doc  for trn-doc.
     1282     define buffer buf_doc-line for doc-line .
     1283     define buffer buf_goods    for goods .
     1284     define buffer buf_clients  for clients .
     1285     define variable sum-no-vat              as decimal     no-undo.
     1286     define variable doc-sum                 as decimal     no-undo.
     1287     define variable doc-price               as decimal     no-undo.
     1288     define variable sum                     as decimal     no-undo.
     1289     define variable price                   as decimal     no-undo.
     1290     define variable nazen                   as decimal     no-undo.
     1291     define variable eff                     as decimal     no-undo.
     1292     define variable num                     as integer   no-undo .
     1293     define variable sum1              as decimal     no-undo.
     1294     define variable sum2              as decimal     no-undo.
     1295     define variable sum3              as decimal     no-undo.
     1296     define variable sum4              as decimal     no-undo.
     1297     define variable sum5              as decimal     no-undo.
     1298     define variable VAT-sum                 as decimal     no-undo.
     1299     define variable b-code as integer   no-undo .
     1300     define variable t-dec as decimal   no-undo .
     1301     define variable v-sum-base    as decimal   no-undo .
     1302     define variable v-sum-rubl    as decimal   no-undo .
     1303     define variable v-vat-base    as decimal   no-undo .
     1304     define variable v-vat-rubl    as decimal   no-undo .
     1305     define variable v-sum-base1   as decimal   no-undo .
     1306     define variable v-sum-rubl1   as decimal   no-undo .
     1307     define variable v-vat-base1   as decimal   no-undo .
     1308     define variable v-vat-rubl1   as decimal   no-undo .
     1309     define variable v-vat-pc     like ub.doc-line.vat-pc         no-undo .
     1310     define variable Line            as character        no-undo.
     1311     define variable sym1  as character initial ":"   no-undo.
     1312     define variable sym2  as character initial ":"   no-undo.
     1313     define variable sym3  as character initial ":"   no-undo.
     1314     define variable sym4  as character initial ":"   no-undo.
     1315     define variable sym5  as character initial ":"   no-undo.
     1316     define variable sym6  as character initial ":"   no-undo.
     1317     define variable sym7  as character initial ":"   no-undo.
     1318     define variable sym8  as character initial ":"   no-undo.
     1319     define variable sym9  as character initial ":"   no-undo.
     1320     define variable sym10 as character initial ":"   no-undo.
     1321     define variable sym11 as character initial ":"   no-undo.
     1322     define variable sym12 as character initial ":"   no-undo.
     1323     define variable sym13 as character initial ":"   no-undo.
     1324     define variable sym14 as character initial ":"   no-undo.
     1325     define variable sym15 as character initial ":"   no-undo.
     1326     define variable tb-code    as character             no-undo.
     1327     define variable tdoc-date  like    trn-doc.doc-date no-undo.
     1328     define variable tdoc-code  like trn-doc.doc-code    no-undo.
     1329     def buffer Our_Host for clients.
     1330     define variable v-sort-prod             as character            no-undo.
     1331   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1332   empty temp-table thbjattr_thbj-attr.
     1333   run adm/shattri.p (
     1334      input "get":U
     1335     ,input ''
     1336     ,input 0
     1337     ,input 'prt-glob':U
     1338     ,input  ""
     1339     ,output v-value-character
     1340     ,output v-value-date
     1341     ,output v-value-decimal
     1342     ,output v-value-integer
     1343     ,output v-value-logical
     1344     ,output par-type
