     1009   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1010   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1011     (output varoutvprb
     1012     )  .
     1013   if varoutvprb = "base":u then do:
     1014     assign
     1015           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1016       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1)
     1017     .
     1018   end.
     1019   else do:
     1020     assign
     1021           road-tax-base-sale    =  (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1022       excise-base-sale      =  (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   / buf_trn-doc.base-rate * buf_trn-doc.base-scale)
     1023     .
     1024   end.
     1025   if varoutvprb = "rubl":u then do:
     1026     assign
     1027           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * 1)
     1028       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * 1) .
     1029   end.
     1030   else do:
     1031     assign
     1032           road-tax-rubl-sale    = (if buf_doc-line.road-tax = ? then 0 else buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale)
     1033       excise-rubl-sale      = (if buf_doc-line.excise   = ? then 0 else buf_doc-line.excise   * buf_trn-doc.base-rate / buf_trn-doc.base-scale) .
     1034   end.
     1035   assign
     1036     varis-cons-parts-have =  no.
     1037   assign
     1038     varfact-qnty       = 0
     1039     varcons-qnty       = 0
     1040     varprice-base-cons = 0
     1041     varprice-rubl-cons = 0.
     1042   find first out-vatp_doc-line where
     1043              out-vatp_doc-line.doc-code   = buf_trn-doc.doc-code
     1044          and out-vatp_doc-line.artic      = buf_doc-line.artic
     1045          and out-vatp_doc-line.prod-type  = buf_doc-line.prod-type
     1046          and out-vatp_doc-line.prod-code  = buf_doc-line.prod-code no-lock no-error.
     1047   if available out-vatp_doc-line           and
     1048     (out-vatp_doc-line.status_ = 'запрос':U or out-vatp_goods.gds-type = 'у':U) then do:
     1049     assign
     1050       varfact-qnty = out-vatp_doc-line.fact-qnty.
     1051   end.
     1052   else do:
     1053     for each out-vatp_parts where out-vatp_parts.out-code   = buf_trn-doc.doc-code
     1054                                  and out-vatp_parts.obj-type   = buf_trn-doc.obj-type
     1055                                  and out-vatp_parts.obj-code   = buf_trn-doc.obj-code
     1056                                  and out-vatp_parts.artic      = buf_doc-line.artic
     1057                                  and out-vatp_parts.prod-type  = buf_doc-line.prod-type
     1058                                  and out-vatp_parts.prod-code  = buf_doc-line.prod-code no-lock :
     1059       if out-vatp_parts.purch-code = 2 then do:
     1060   assign
     1061     price-rubl-with-tax-loco = out-vatp_parts.price-rubl
     1062     price-base-with-tax-loco = out-vatp_parts.price-base
     1063   .
     1064   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1065   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1066     (output varinvprbo
     1067     )  .
     1068     if out-vatp_parts.out-code = 'free-zone':U     or
     1069        out-vatp_parts.out-code = 'out-zone':U   or
     1070        out-vatp_parts.doc-type = 'акт':U then do:
     1071       assign
     1072         in-vatp-have-vat-slto = yes.
     1073     end.
     1074     else do:
     1075       find first in-vatp_doc-attro no-lock
     1076         where in-vatp_doc-attro.doc-code  = out-vatp_parts.out-code
     1077           and in-vatp_doc-attro.attr-code = 'envd':U
     1078         no-error .
     1079       if not available in-vatp_doc-attro then do:
     1080         assign
     1081           in-vatp-have-vat-slto = yes.
     1082       end.
     1083       else do:
     1084            in-vatp-have-vat-slto = no.
     1085       end.
     1086     end.
     1087     assign
     1088      price-cli-with-tax-loco = out-vatp_parts.price-cli
     1089      cli-base-rateo          = out-vatp_parts.cli-base-rate.
     1090     ASSIGN   road-tax-base-loco  = (if out-vatp_parts.road-tax-base  = ? then 0 else out-vatp_parts.road-tax-base)
     1091              road-tax-rubl-loco  = (if out-vatp_parts.road-tax-rubl  = ? then 0 else out-vatp_parts.road-tax-rubl).
     1092     ASSIGN  transport-base-loco = (if out-vatp_parts.transport-base = ? then 0 else out-vatp_parts.transport-base)
     1093             transport-rubl-loco = (if out-vatp_parts.transport-rubl = ? then 0 else out-vatp_parts.transport-rubl)
     1094             other-base-loco     = (if out-vatp_parts.other-base     = ? then 0 else out-vatp_parts.other-base)
     1095             other-rubl-loco     = (if out-vatp_parts.other-rubl     = ? then 0 else out-vatp_parts.other-rubl)
     1096             vat-pc-loco         = (if out-vatp_parts.vat-pc         = ? then 0 else out-vatp_parts.vat-pc)
     1097             slt-pc-loco         = (if out-vatp_parts.slt-pc         = ? then 0 else out-vatp_parts.slt-pc).
     1098             ASSIGN   slt-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-base-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-base-with-tax-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1099       ASSIGN   slt-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco)))                           * slt-pc-loco / (100 + slt-pc-loco))                        vat-rubl-loco    = (if in-vatp-have-vat-slto = no then 0 else (price-rubl-with-tax-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))) * (1 - slt-pc-loco / (100 + slt-pc-loco)) * vat-pc-loco / (100 + vat-pc-loco)).
     1100     assign
     1101       exch-rate-cli-loco = (out-vatp_parts.price-rubl - transport-rubl-loco - other-rubl-loco - road-tax-rubl-loco - (if out-vatp_parts.vat-type <> 'в т. ч.':U then vat-rubl-loco else 0) - (if out-vatp_parts.slt-type <> 'в т. ч.':U then slt-rubl-loco else 0)) / out-vatp_parts.price-cli .
     1102     assign
     1103       slt-cli-loco        = slt-rubl-loco       / exch-rate-cli-loco
     1104       vat-cli-loco        = vat-rubl-loco       / exch-rate-cli-loco
     1105       road-tax-cli-loco   = road-tax-rubl-loco  / exch-rate-cli-loco
     1106       transport-cli-loco  = 0
     1107       other-cli-loco      = 0
     1108     .
     1109   ASSIGN
     1110             price-base-without-tax-loco = price-base-with-tax-loco - vat-base-loco - slt-base-loco - ((if road-tax-base-loco  = ? then 0 else road-tax-base-loco) + (if transport-base-loco = ? then 0 else transport-base-loco) + (if other-base-loco = ? then 0 else other-base-loco))
     1111       price-rubl-without-tax-loco = price-rubl-with-tax-loco - vat-rubl-loco - slt-rubl-loco - ((if road-tax-rubl-loco  = ? then 0 else road-tax-rubl-loco) + (if transport-rubl-loco = ? then 0 else transport-rubl-loco) + (if other-rubl-loco = ? then 0 else other-rubl-loco))
     1112   .
     1113         assign
     1114           varprice-base-cons = varprice-base-cons + (price-base-with-tax-loco - (if road-tax-base-loco = ? then 0 else road-tax-base-loco))* out-vatp_parts.fact-qnty
     1115           varprice-rubl-cons = varprice-rubl-cons + (price-rubl-with-tax-loco - (if road-tax-rubl-loco = ? then 0 else road-tax-rubl-loco))* out-vatp_parts.fact-qnty.
     1116         assign
     1117           varis-cons-parts-have = yes
     1118           varcons-qnty          = varcons-qnty + out-vatp_parts.fact-qnty.
     1119       end.
     1120       assign
     1121         varfact-qnty = varfact-qnty + out-vatp_parts.fact-qnty.
     1122     end.
     1123   end.
     1124   assign
     1125     varprice-base-cons = varprice-base-cons / varcons-qnty
     1126     varprice-rubl-cons = varprice-rubl-cons / varcons-qnty.
     1127   if varprice-base-cons = ? then do:
     1128     assign
     1129       varprice-base-cons = 0.
     1130   end.
     1131   if varprice-rubl-cons = ? then do:
     1132     assign
     1133       varprice-rubl-cons = 0.
     1134   end.
     1135   assign
     1136       slt-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1137     vat-base-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1138     discnt-base-sale            = buf_gds-dtl.discnt-base
     1139     price-base-with-tax-sale    = (buf_gds-dtl.price-base - buf_gds-dtl.discnt-base)
     1140       slt-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc)
     1141     vat-rubl-buyer              = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1142     discnt-rubl-sale            = buf_gds-dtl.discnt-rubl
     1143     price-rubl-with-tax-sale    = (buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl)
     1144     .
     1145   if buf_trn-doc.doc-type = 'инв':U then do:
     1146     assign
     1147       varfact-qnty = buf_gds-dtl.doc-qnty.
     1148   end.
     1149   else do:
     1150     assign
     1151       varfact-qnty = buf_gds-dtl.fact-qnty.
     1152   end.
     1153   if varis-cons-parts-have = no then do:
     1154     assign
     1155           vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc)
     1156           vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc).
     1157   end.
     1158   else do:
     1159     if buf_trn-doc.doc-type = 'инв':U then do:
     1160       assign
     1161               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1162               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.doc-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.doc-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1163        .
     1164     end.
     1165     else do:
     1166       assign
     1167               vat-base-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-base-sale - varprice-base-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-base - buf_gds-dtl.discnt-base) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-base - buf_gds-dtl.discnt-base                - road-tax-base-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-base-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1168               vat-rubl-sale               = (if out-vatp-have-vat-slt = no then 0 else (((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - road-tax-rubl-sale - varprice-rubl-cons) * buf_doc-line.cons-vat-pc / (100 + buf_doc-line.cons-vat-pc) * buf_gds-dtl.fact-qnty * varcons-qnty / varfact-qnty + ((buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl) - (if out-vatp-have-vat-slt = no then 0 else buf_gds-dtl.price-rubl - buf_gds-dtl.discnt-rubl                - road-tax-rubl-sale) * buf_doc-line.SLT-pc / (100 + buf_doc-line.SLT-pc) - varprice-rubl-cons) * buf_doc-line.vat-pc / (100 + buf_doc-line.vat-pc) * buf_gds-dtl.fact-qnty * (varfact-qnty - varcons-qnty) / varfact-qnty) / varfact-qnty)
     1169        .
     1170     end.
     1171   end.
     1172   assign
     1173   price-base-without-tax-sale = price-base-with-tax-sale - vat-base-sale - slt-base-sale - road-tax-base-sale
     1174   price-rubl-without-tax-sale = price-rubl-with-tax-sale - vat-rubl-sale - slt-rubl-sale - road-tax-rubl-sale.
     1175               ASSIGN
     1176                   p-fact-qnty           = p-fact-qnty     + v-gds-dtl-fact-qnty
     1177                   p-sum-base            = p-sum-base      + price-base-with-tax-sale  * v-gds-dtl-fact-qnty
     1178                   p-sum-rubl            = p-sum-rubl      + price-rubl-with-tax-sale  * v-gds-dtl-fact-qnty
     1179                   p-vat-base            = p-vat-base      + vat-base-sale             * v-gds-dtl-fact-qnty
     1180                   p-vat-rubl            = p-vat-rubl      + vat-rubl-sale             * v-gds-dtl-fact-qnty
     1181                   p-slt-base            = p-slt-base      + slt-base-sale             * v-gds-dtl-fact-qnty
     1182                   p-slt-rubl            = p-slt-rubl      + slt-rubl-sale             * v-gds-dtl-fact-qnty
     1183                   p-road-tax-base       = p-road-tax-base + road-tax-base-sale        * v-gds-dtl-fact-qnty
     1184                   p-road-tax-rubl       = p-road-tax-rubl + road-tax-rubl-sale        * v-gds-dtl-fact-qnty
     1185                   p-excise-base         = p-excise-base   + excise-base-sale          * v-gds-dtl-fact-qnty
     1186                   p-excise-rubl         = p-excise-rubl   + excise-rubl-sale          * v-gds-dtl-fact-qnty
     1187                   p-other-base          = p-other-base    + discnt-base-sale          * v-gds-dtl-fact-qnty
     1188                   p-other-rubl          = p-other-rubl    + discnt-rubl-sale          * v-gds-dtl-fact-qnty
     1189               .
     1190           end.
     1191       end.
     1192       assign
     1193           p-transport-base      = 0
     1194           p-transport-rubl      = 0
     1195           p-vat-pc              = buf_doc-line.vat-pc
     1196           p-slt-pc              = buf_doc-line.slt-pc
     1197       .
     1198     end.
     1199     if p-fact-qnty      = ?
     1200     or p-vat-pc         = ?
     1201     or p-slt-pc         = ?
     1202     or p-sum-base       = ?
     1203     or p-sum-rubl       = ?
     1204     or p-vat-base       = ?
     1205     or p-vat-rubl       = ?
     1206     or p-slt-base       = ?
     1207     or p-slt-rubl       = ?
     1208     or p-road-tax-base  = ?
     1209     or p-road-tax-rubl  = ?
     1210     or p-transport-base = ?
     1211     or p-transport-rubl = ?
     1212     or p-other-base     = ?
     1213     or p-other-rubl     = ?
     1214     or p-excise-base    = ?
     1215     or p-excise-rubl    = ?
     1216     then do:
     1217       message
     1218         vss-workfile vss-revision vss-description skip
     1219         vss-include-info8 skip
     1220         "Получены неопределенные значения" skip
     1221         "Документ" p-doc-code skip
     1222         "Артикул" p-artic p-prod-type p-prod-code skip
     1223         "fact-qnty     " p-fact-qnty      skip
     1224         "vat-pc        " p-vat-pc         skip
     1225         "slt-pc        " p-slt-pc         skip
     1226         "sum-base      " p-sum-base       skip
     1227         "sum-rubl      " p-sum-rubl       skip
     1228         "vat-base      " p-vat-base       skip
     1229         "vat-rubl      " p-vat-rubl       skip
     1230         "slt-base      " p-slt-base       skip
     1231         "slt-rubl      " p-slt-rubl       skip
     1232         "road-tax-base " p-road-tax-base  skip
     1233         "road-tax-rubl " p-road-tax-rubl  skip
     1234         "transport-base" p-transport-base skip
     1235         "transport-rubl" p-transport-rubl skip
     1236         "other-base    " p-other-base     skip
     1237         "other-rubl    " p-other-rubl     skip
     1238         "excise-base   " p-excise-base    skip
     1239         "excise-rubl   " p-excise-rubl    skip
     1240         view-as alert-box error .
     1241       undo, return error .
     1242     end.
     1243   end procedure.
     1244   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1245     define variable v-cntxt-db-num        as integer   no-undo .
     1246     define variable v-cntxt-userid        as character no-undo .
     1247     define variable v-cntxt-level         as character no-undo .
     1248     define variable v-cntxt-host-code-obj as integer   no-undo .
     1249     define variable v-cntxt-obj-type      as character no-undo .
