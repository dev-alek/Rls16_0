     1263       ) .
     1264   define variable vss-include-info14 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1265   define variable vss-include-info15 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1266   define temp-table thbjattr_thbj-attr no-undo like ub.thbj-attr.
     1267   define variable par-type          as character no-undo.
     1268   define variable v-value-character as character no-undo .
     1269   define variable v-value-date      as date      no-undo .
     1270   define variable v-value-decimal   as decimal   no-undo .
