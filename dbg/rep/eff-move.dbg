        1   block-level on error undo, throw.
        2   do
        3   on error undo, return error
        4   :
        5   define input parameter parParentProc     AS WIDGET-HANDLE NO-UNDO.
        6   define input parameter rec_id as recid no-undo .
        7   define variable vss-revision    as character no-undo initial "$Revision: aea5316774be, 0, rls $":U .
        8   define variable vss-author      as character no-undo initial "$Author: expertek $":U .
        9   define variable vss-date        as character no-undo initial "$Date: Mon Jan 27 18:27:46 2014 +0400 $":U .
       10   define variable vss-workfile    as character no-undo initial "$Workfile: eff-move.p $":U .
       11   define variable vss-archive     as character no-undo initial "$Archive: rep/eff-move.p $":U .
       12   define variable vss-description as character no-undo initial "Печать акта формирования продажной цены":U .
       13   procedure vss-get-info :
       14     define output parameter p-vss-revision    like vss-revision    no-undo .
       15     define output parameter p-vss-author      like vss-author      no-undo .
       16     define output parameter p-vss-date        like vss-date        no-undo .
       17     define output parameter p-vss-workfile    like vss-workfile    no-undo .
       18     define output parameter p-vss-archive     like vss-archive     no-undo .
       19     define output parameter p-vss-description like vss-description no-undo .
       20     assign
       21       p-vss-revision    = vss-revision
       22       p-vss-author      = vss-author
       23       p-vss-date        = vss-date
       24       p-vss-workfile    = vss-workfile
       25       p-vss-archive     = vss-archive
       26       p-vss-description = vss-description
       27     .
       28   end procedure.
       29   procedure vss-get-parameters :
       30     define output parameter p-vss-parameters as character no-undo .
       31   end procedure.
       32   define new global shared variable g#vssrevis-logger as handle    no-undo .
       33   define variable v-vssrevis-logevent                 as logical   no-undo init false .
       34   define variable v-vssrevis-logger                   as handle    no-undo .
       35   procedure vss-logevent :
       36     define input  parameter p-extra-paramters as character no-undo .
       37     define variable v-vssrevis-parameters as character no-undo .
       38     do
       39     on error undo, return error return-value
       40     :
       41       if  valid-handle(v-vssrevis-logger)
       42       and v-vssrevis-logger :get-signature("logevent") <> ""
       43       then do:
       44         run vss-get-parameters in this-procedure
       45           (output v-vssrevis-parameters
       46           ).
       47         run logevent in v-vssrevis-logger
       48           (input vss-workfile
       49           ,input vss-revision
       50           ,input v-vssrevis-parameters
       51           ,input p-extra-paramters
       52           ).
       53       end.
       54     end.
       55   end procedure.
       56   assign
       57     v-vssrevis-logger = g#vssrevis-logger
       58   .
       59   if  valid-handle(v-vssrevis-logger)
       60   and v-vssrevis-logger :get-signature("logevent") <> ""
       61   then do:
       62     assign
       63       v-vssrevis-logevent = true
       64     .
       65     run vss-logevent in this-procedure (input vss-description) .
       66   end.
       67   define new global shared variable g#language as character no-undo .
       68   if g#language <> '' and g#language <> 'rus':U then do:
       69     undo, return error substitute( '&1. incorrect language&2str-glbl: rus&2db: &3':U, this-procedure :file-name, chr(10), g#language  ).
       70   end.
       71   define variable vss-include-info0 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
       72   procedure cur-time :
       73      define output parameter p-today as date      no-undo .
       74      define output parameter p-time  as integer   no-undo .
       75     do
       76     on error undo, return error
       77     :
       78       define variable v-date1 as date      no-undo .
       79       define variable v-date2 as date      no-undo .
       80       define variable v-time  as integer   no-undo .
       81       assign
       82         v-date1 = today
       83         v-time  = time
       84         v-date2 = today
       85       .
       86       if v-date1 <> v-date2
       87       then do:
       88         assign
       89           v-date1 = today
       90           v-time  = v-time
       91         .
       92       end.
       93       assign
       94         p-today = v-date1
       95         p-time  = v-time
       96       .
       97     end.
       98   end.
       99   function cur-time-date returns character
      100   :
      101     return string(today, '99/99/9999':U) .
      102   end.
      103   function cur-time-mjd returns decimal
      104   :
      105     define variable v-date as date      no-undo .
      106     define variable v-time as integer   no-undo .
      107     run cur-time in this-procedure
      108       (output v-date
      109       ,output v-time
      110       ) .
      111     return integer(v-date) - 2400002 + (v-time / 86400) .
      112   end.
      113   function cur-time-get-ending-index returns integer
      114   (input p-number as integer
      115   )
      116   :
      117     if p-number < 0
      118     or p-number = ?
      119     then do:
      120       return 1 .
      121     end.
      122     define variable v-rest as integer   no-undo .
      123     assign
      124       p-number = p-number modulo 100
      125     .
      126     if p-number < 20
      127     then do:
      128       assign
      129         v-rest = p-number
      130       .
      131     end.
      132     else do:
      133       assign
      134         v-rest = p-number modulo 10
      135       .
      136     end.
      137     case v-rest :
      138       when 1
      139       then do:
      140         return 2 .
      141       end.
      142       when 2 or
      143       when 3 or
      144       when 4
      145       then do:
      146         return 3 .
      147       end.
      148       otherwise do:
      149         return 1 .
      150       end.
      151     end case .
      152   end.
      153   procedure cur-time-mjd-to-date :
      154      define input  parameter i-mjd-diff as decimal no-undo.
      155      define output parameter o-Date     as date    no-undo.
      156      define output parameter o-Time     as integer no-undo.
      157      define variable v-day-number as integer   no-undo .
      158      if    i-mjd-diff < 0
      159         or i-mjd-diff = ?
      160      then do:
      161         return "?" .
      162      end.
      163      assign
      164         v-day-number = truncate(i-mjd-diff,0).
      165         o-Date = date(v-day-number + 2400002).
      166         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      167     .
      168   end.
      169   function cur-time-mjd-to-string returns character
      170   (input p-mjd-diff as decimal
      171   )
      172   :
      173     define variable v-day-number as integer   no-undo .
      174     define variable v-seconds    as integer   no-undo .
      175     define variable v-hour       as integer   no-undo .
      176     define variable v-min        as integer   no-undo .
      177     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      178     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      179     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      180     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      181     if p-mjd-diff < 0
      182     or p-mjd-diff = ?
      183     then do:
      184       return "?" .
      185     end.
      186     assign
      187       v-day-number = integer(truncate(p-mjd-diff,0))
      188       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      189     .
      190     if v-seconds > 86400
      191     then do:
      192       assign
      193         v-seconds = 86400 - 1
      194       .
      195     end.
      196     if v-seconds < 0
      197     then do:
      198       assign
      199         v-seconds = 0
      200       .
      201     end.
      202     assign
      203       v-hour = truncate(v-seconds / 3600, 0)
      204     .
      205     assign
      206       v-seconds = v-seconds modulo 3600
      207     .
      208     assign
      209       v-min = truncate(v-seconds / 60, 0)
      210     .
      211     assign
      212       v-seconds = v-seconds modulo 60
      213     .
      214     return
      215         (if v-day-number <> 0
      216           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      217           else ""
      218         )
      219       + (if v-day-number <> 0 or v-hour <> 0
      220           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      221           else ""
      222         )
      223       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      224           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      225           else ""
      226         )
      227       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      228       .
      229   end.
      230   function cur-time-string returns character
      231   :
      232     define variable v-date as date      no-undo .
      233     define variable v-time as integer   no-undo .
      234     run cur-time in this-procedure
      235       (output v-date
      236       ,output v-time
      237       ) .
      238     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      239   end.
      240   function cur-time-string-sec returns character
      241   :
      242     define variable v-date as date      no-undo .
      243     define variable v-time as integer   no-undo .
      244     run cur-time in this-procedure
      245       (output v-date
      246       ,output v-time
      247       ) .
      248     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      249   end.
      250   function cur-time-custom  returns character
      251   (input p-prefix as character
      252   ,input p-date-format as character
      253   ,input p-delimiter as character
      254   ,input p-time-format as character
      255   ,input p-suffix as character
      256   )
      257   :
      258     define variable v-date as date      no-undo .
      259     define variable v-time as integer   no-undo .
      260     run cur-time in this-procedure
      261       (output v-date
      262       ,output v-time
      263       ) .
      264     return
      265       p-prefix
      266       + string(v-date, p-date-format)
      267       + p-delimiter
      268       + string(v-time, p-time-format)
      269       + p-suffix
      270       .
      271   end.
      272   function cur-time-print  returns character
      273   :
      274     define variable v-date as date      no-undo .
      275     define variable v-time as integer   no-undo .
      276     run cur-time in this-procedure
      277       (output v-date
      278       ,output v-time
      279       ) .
      280     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      281   end.
      282   function cur-time-datetime returns datetime
      283   :
      284     define variable v-char as character no-undo .
      285     define variable v-datetime as datetime no-undo .
      286     v-char = cur-time-string().
      287     v-datetime = datetime(v-char).
      288     return  v-datetime.
      289   end.
      290   function cur-time-string-msec returns character
      291   :
      292     define variable v-date as datetime  no-undo .
      293     v-date = now.
      294     return string(v-date) .
      295   end.
      296   define variable vss-include-info1 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      297   define  shared variable PrintCopiesCounter as integer   no-undo initial 1 .
      298   define  shared variable RepPathName        as character no-undo .
      299   define  shared variable PrintRubl          as logical   no-undo .
      300   define new global shared variable g#library  as handle no-undo .
      301   define new global shared variable g#library2 as handle no-undo .
      302   define variable vss-include-info2 as character format "X(65)" no-undo
      303   initial "@(#)$Workfile$ $Revision$".
      304   def var vss-include-info3 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      305   procedure r-cost :
      306     define input  parameter v-doc-code       like ub.doc-line.doc-code          no-undo .
      307     define input  parameter v-artic          like ub.doc-line.artic             no-undo .
      308     define input  parameter v-prod-type      like ub.doc-line.prod-type         no-undo .
      309     define input  parameter v-prod-code      like ub.doc-line.prod-code         no-undo .
      310     define output parameter v-fact-qnty      like ub.ot-line.fact-qnty       no-undo .
      311     define output parameter v-vat-pc         like ub.doc-line.vat-pc         no-undo .
      312     define output parameter v-slt-pc         like ub.doc-line.slt-pc         no-undo .
      313     define output parameter v-sum-base       like ub.ot-line.sum-base        no-undo .
      314     define output parameter v-sum-rubl       like ub.ot-line.sum-rubl        no-undo .
      315     define output parameter v-vat-base       like ub.ot-line.vat-base        no-undo .
      316     define output parameter v-vat-rubl       like ub.ot-line.vat-rubl        no-undo .
      317     define output parameter v-slt-base       like ub.ot-line.slt-base        no-undo .
      318     define output parameter v-slt-rubl       like ub.ot-line.slt-rubl        no-undo .
      319     define output parameter v-road-tax-base  like ub.ot-line.road-tax-base   no-undo .
      320     define output parameter v-road-tax-rubl  like ub.ot-line.road-tax-rubl   no-undo .
      321     define output parameter v-transport-base like ub.ot-line.transport-base  no-undo .
      322     define output parameter v-transport-rubl like ub.ot-line.transport-rubl  no-undo .
      323     define output parameter v-other-base     like ub.ot-line.other-base      no-undo .
      324     define output parameter v-other-rubl     like ub.ot-line.other-rubl      no-undo .
      325     define output parameter v-excise-base    like ub.ot-line.excise-base     no-undo .
      326     define output parameter v-excise-rubl    like ub.ot-line.excise-rubl     no-undo .
      327     do
      328     on error undo, return error
      329     :
      330       define buffer   in-vatp-trn-doc  for ub.trn-doc .
      331       define buffer   in-vatp-parts    for ub.parts   .
      332       define buffer   in-vatp-doc      for ub.trn-doc .
      333       define buffer   in-vatp-goods    for ub.goods   .
      334       define buffer   in-vatp-sysconf  for ub.sysconf .
      335       define buffer   in-vatp_doc-attr for ub.doc-attr.
      336       define variable in-vatp-have-vat-slt       as   logical initial yes    no-undo.
      337       define variable vat-pc-loc                 like ub.doc-line.vat-pc     no-undo.
      338       define variable varinvprb                  as   character              no-undo.
      339       define variable slt-pc-loc                 like ub.doc-line.slt-pc     no-undo.
      340       define variable cli-base-rate              as   decimal                no-undo.
      341       define variable price-rubl-with-tax-loc    like ub.doc-line.price-rubl no-undo.
      342       define variable price-base-with-tax-loc    like ub.doc-line.price-base no-undo.
      343       define variable price-cli-with-tax-loc     like ub.doc-line.price-cli  no-undo.
      344       define variable price-rubl-without-tax-loc like ub.doc-line.price-rubl no-undo.
      345       define variable price-base-without-tax-loc like ub.doc-line.price-base no-undo.
      346       define variable price-cli-without-tax-loc  like ub.doc-line.price-base no-undo.
      347       define variable vat-base-loc               like ub.doc-line.price-base no-undo.
      348       define variable vat-rubl-loc               like ub.doc-line.price-rubl no-undo.
      349       define variable vat-cli-loc                like ub.doc-line.price-rubl no-undo.
      350       define variable slt-base-loc               like ub.doc-line.price-base no-undo.
      351       define variable slt-rubl-loc               like ub.doc-line.price-rubl no-undo.
      352       define variable slt-cli-loc                like ub.doc-line.price-rubl no-undo.
      353       define variable road-tax-base-loc          like ub.doc-line.road-tax   no-undo.
      354       define variable road-tax-rubl-loc          like ub.doc-line.road-tax   no-undo.
      355       define variable road-tax-cli-loc           like ub.doc-line.road-tax   no-undo.
      356       define variable transport-base-loc         like ub.doc-line.price-base no-undo.
      357       define variable transport-rubl-loc         like ub.doc-line.price-rubl no-undo.
      358       define variable transport-cli-loc          like ub.doc-line.price-rubl no-undo.
      359       define variable other-base-loc             like ub.doc-line.price-base no-undo.
      360       define variable other-rubl-loc             like ub.doc-line.price-rubl no-undo.
      361       define variable other-cli-loc              like ub.doc-line.price-rubl no-undo.
      362       define variable exch-rate-cli-loc          like ub.trn-doc.exch-rate   no-undo.
      363       define variable varinvatp-envd             as   character              no-undo.
      364       define variable varinvatp-type             as   character              no-undo.
      365       def var v-parts-fact-qnty as decimal   no-undo .
      366       define buffer buf_parts    for ub.parts    .
      367       define buffer buf_goods    for ub.goods    .
      368       define buffer buf_trn-doc  for ub.trn-doc  .
      369       define buffer buf_doc-line for ub.doc-line .
      370       find first buf_doc-line no-lock
      371         where buf_doc-line.doc-code  = v-doc-code
      372           and buf_doc-line.artic     = v-artic
      373           and buf_doc-line.prod-type = v-prod-type
      374           and buf_doc-line.prod-code = v-prod-code
      375         no-error .
      376       if not available buf_doc-line then do:
      377         message
      378           vss-workfile vss-revision vss-description skip
      379           vss-include-info3 skip
      380           "Ошибка задания входных параметров" skip
      381           "Не найдена строка документа"  skip
      382           "Документ" v-doc-code skip
      383           "Артикул" v-artic v-prod-type v-prod-code skip
      384           view-as alert-box error .
      385         return error .
      386       end.
      387       find first buf_trn-doc no-lock
      388         where buf_trn-doc.doc-code = v-doc-code
      389         no-error .
      390       if not available buf_trn-doc then do:
      391         message
      392           vss-workfile vss-revision vss-description skip
      393           vss-include-info3 skip
      394           "Ошибка задания входных параметров" skip
      395           "Не найден документ" skip
      396           "Документ" v-doc-code skip
      397           "Артикул" v-artic v-prod-type v-prod-code skip
      398           view-as alert-box error .
      399         undo, return error .
      400       end.
      401       find first buf_goods no-lock
      402         where buf_goods.artic     = buf_doc-line.artic
      403           and buf_goods.prod-type = buf_doc-line.prod-type
      404           and buf_goods.prod-code = buf_doc-line.prod-code
      405         no-error .
      406       if not available buf_goods then do:
      407         message
      408           vss-workfile vss-revision vss-description skip
      409           vss-include-info3 skip
      410           "Ошибка задания входных параметров" skip
      411           "Не найден товар" skip
      412           "Документ" v-doc-code skip
      413           "Артикул" v-artic v-prod-type v-prod-code skip
      414           view-as alert-box error .
      415         undo, return error .
      416       end.
      417       if buf_goods.gds-type = 'т':U then do:
      418             for each buf_parts no-lock
      419               where buf_parts.out-code  = buf_trn-doc.doc-code
      420                 and buf_parts.obj-type  = buf_trn-doc.obj-type
      421                 and buf_parts.obj-code  = buf_trn-doc.obj-code
      422                 and buf_parts.artic     = buf_doc-line.artic
      423                 and buf_parts.prod-type = buf_doc-line.prod-type
      424                 and buf_parts.prod-code = buf_doc-line.prod-code
      425             on error undo, return error
      426             :
      427   assign
      428     price-rubl-with-tax-loc = buf_parts.price-rubl
      429     price-base-with-tax-loc = buf_parts.price-base
      430   .
      431   define variable vss-include-info4 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      432   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      433     (output varinvprb
      434     )  .
      435     if buf_parts.out-code = 'free-zone':U     or
      436        buf_parts.out-code = 'out-zone':U   or
      437        buf_parts.doc-type = 'акт':U then do:
      438       assign
      439         in-vatp-have-vat-slt = yes.
      440     end.
      441     else do:
      442       find first in-vatp_doc-attr no-lock
      443         where in-vatp_doc-attr.doc-code  = buf_parts.out-code
      444           and in-vatp_doc-attr.attr-code = 'envd':U
      445         no-error .
      446       if not available in-vatp_doc-attr then do:
      447         assign
      448           in-vatp-have-vat-slt = yes.
      449       end.
      450       else do:
      451            in-vatp-have-vat-slt = no.
      452       end.
      453     end.
      454     assign
      455      price-cli-with-tax-loc = buf_parts.price-cli
      456      cli-base-rate          = buf_parts.cli-base-rate.
      457     ASSIGN   road-tax-base-loc  = (if buf_parts.road-tax-base  = ? then 0 else buf_parts.road-tax-base)
      458              road-tax-rubl-loc  = (if buf_parts.road-tax-rubl  = ? then 0 else buf_parts.road-tax-rubl).
      459     ASSIGN  transport-base-loc = (if buf_parts.transport-base = ? then 0 else buf_parts.transport-base)
      460             transport-rubl-loc = (if buf_parts.transport-rubl = ? then 0 else buf_parts.transport-rubl)
      461             other-base-loc     = (if buf_parts.other-base     = ? then 0 else buf_parts.other-base)
      462             other-rubl-loc     = (if buf_parts.other-rubl     = ? then 0 else buf_parts.other-rubl)
      463             vat-pc-loc         = (if buf_parts.vat-pc         = ? then 0 else buf_parts.vat-pc)
      464             slt-pc-loc         = (if buf_parts.slt-pc         = ? then 0 else buf_parts.slt-pc).
      465             ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
