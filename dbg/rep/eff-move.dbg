     1348         if thbjattr_thbj-attr.prop-code = 'sort-prd' then v-sort-prod = string( thbjattr_thbj-attr.property-value-logical) .
     1349     end.
     1350     DEFINE FRAME Akt
     1351           sym1           column-label ":!:" format "X(1)" space(0)
     1352           tb-code        column-label "Код! " format "x(10)"
     1353           sym2           column-label ":!:" format "X(1)" space(0)
     1354           buf_goods.artic    column-label "Артикул! " format "X(16)"
     1355           sym3           column-label ":!:" format "X(1)" space(0)
     1356           buf_goods.gds-name column-label "Название товара! " format "X(36)"
     1357           sym4           column-label ":!:" format "X(1)" space(0)
     1358           buf_doc-line.fact-qnty           column-label "Количество ! " format ">>>>>>9.<<<"
     1359           sym5           column-label ":!:" format "X(1)" space(0)
     1360           price          column-label "Учет. цена!с НДС" format ">>>>>>9.99"
     1361           sym6           column-label ":!:" format "X(1)" space(0)
     1362           sum            column-label "Сумма в учет.!ценах с НДС" format ">>,>>>,>>9.99"
     1363           sym7           column-label ":!:" format "X(1)" space(0)
     1364           sum-no-vat     column-label "Сумма в учет.!ценах без НДС" format ">>,>>>,>>9.99"
     1365           sym8           column-label ":!:" format "X(1)" space(0)
     1366           doc-price      column-label "Цена по!докум." format ">>>>>>9.99"
     1367           sym9           column-label ":!:" format "X(1)" space(0)
     1368           doc-sum        column-label "Сумма по!докум." format ">>,>>>,>>9.99"
     1369           sym10          column-label ":!:" format "X(1)" space(0)
     1370           nazen          column-label "Торговая!наценка" format "->>>>9.<<%"
     1371           sym11          column-label ":!:" format "X(1)" space(0)
     1372           eff            column-label "Эффекти-!вность" format "->>>>>>>>9.99"
     1373           sym12          column-label ":!:" format "X(1)" space(0)
     1374           buf_doc-line.vat-pc column-label "Ставка!НДС" format ">>9.<<%"
     1375           sym13          column-label ":!:" format "X(1)" space(0)
     1376           VAT-sum        column-label "Сумма НДС от!цен док-та" format "->>>>>>>>9.99" space(0)
     1377           sym14          column-label ":!:" format "X(1)" space(0)
     1378       HEADER
     1379               cur-time-print() AT 5 format "X(35)"
     1380               string( "Эффективность движения товара по документу N " + tdoc-code + " от " + string( tdoc-date,"99/99/9999" ) ) AT 40 format "X(80)"
     1381               ( if PrintRubl then "Цены и суммы указаны в рублях" else "Цены и суммы указаны в б.вал." ) format "X(30)"
     1382               string( "Страница " + string( PAGE-NUMBER(Out_stream), ">>9") ) AT 164 format "X(15)" SKIP
     1383           Line format "X(198)" AT 1
     1384       with width 235 down stream-io.
     1385     Line = fill("-", 200).
     1386     FIND buf_trn-doc WHERE recid(buf_trn-doc) = rec_id  NO-LOCK.
     1387     assign
     1388       tdoc-date = buf_trn-doc.doc-date
     1389       tdoc-code    = buf_trn-doc.doc-code
     1390     .
     1391     FIND Our_Host WHERE Our_Host.obj-type = 'орг':U AND Our_Host.obj-code = buf_trn-doc.host-code NO-LOCK.
     1392   output stream Out_stream to value( string( session:temp-directory +
     1393                                        "rpt" + string( g#report-num ) ) )
     1394                                        page-size  value(43) .
     1395     PUT stream Out_stream SPACE(90) Our_Host.obj-name format "x(40)" SKIP(2)
     1396           SPACE(20) "Эффективность движения товара  по документу  N " format "x(50)"
     1397           buf_trn-doc.doc-code format "X(10)" "  от  " buf_trn-doc.doc-date format "99.99.9999" SKIP(1).
     1398     PUT stream Out_stream SPACE(20) string( "ПОКУПАТЕЛЬ : " + buf_trn-doc.cli-name ) format "x(90)" SKIP(1) .
     1399     FORM HEADER
     1400       Line format "X(198)" AT 1 SKIP  "Продолжение - на следующей странице" AT 30 SKIP
     1401       with FRAME BottomFrame width 235 PAGE-BOTTOM NO-LABELS NO-BOX .
     1402     VIEW stream Out_stream FRAME BottomFrame .
     1403     form with frame Akt .
     1404     assign num = 1 .
     1405     if v-sort-prod = "yes" then do:
     1406       if sort-gr = yes then do:
     1407         if sort-name = yes then do:
     1408           for each buf_doc-line no-lock
     1409             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1410             , first buf_goods no-lock
     1411               where buf_goods.artic      = buf_doc-line.artic
     1412                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1413                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1414             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_goods.gds-name
     1415           :
     1416             if  first-of( buf_doc-line.prod-code) then do:
     1417               run print-prod in this-procedure .
     1418             end.
     1419             if  first-of( buf_goods.grp-name) then do:
     1420               run print-grp in this-procedure .
     1421             end.
     1422             run print-line in this-procedure .
     1423           end.
     1424         end.
     1425         else do:
     1426           for each buf_doc-line
     1427             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1428             , first buf_goods no-lock
     1429               where buf_goods.artic      = buf_doc-line.artic
     1430                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1431                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1432             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.grp-name  by buf_doc-line.num-place
     1433           :
     1434             if  first-of( buf_doc-line.prod-code) then do:
     1435               run print-prod in this-procedure .
     1436             end.
     1437             if  first-of( buf_goods.grp-name) then do:
     1438               run print-grp in this-procedure .
     1439             end.
     1440             run print-line in this-procedure .
     1441           end.
     1442         end.
     1443       end.
     1444       else do:
     1445         if sort-name = yes then do:
     1446           for each buf_doc-line no-lock
     1447             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1448             , first buf_goods no-lock
     1449             where buf_goods.artic      = buf_doc-line.artic
     1450               and buf_goods.prod-type  = buf_doc-line.prod-type
     1451               and buf_goods.prod-code  = buf_doc-line.prod-code
     1452             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_goods.gds-name
     1453           :
     1454             if  first-of( buf_doc-line.prod-code) then do:
     1455               run print-prod in this-procedure .
     1456             end.
     1457             run print-line in this-procedure .
     1458           end.
     1459         end.
     1460         else do:
     1461           for each buf_doc-line
     1462             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1463             , first buf_goods no-lock
     1464             where buf_goods.artic      = buf_doc-line.artic
     1465                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1466                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1467             break by buf_doc-line.prod-type by buf_doc-line.prod-code by buf_doc-line.num-place
     1468           :
     1469             if  first-of( buf_doc-line.prod-code) then do:
     1470               run print-prod in this-procedure .
     1471             end.
     1472             run print-line in this-procedure .
     1473           end.
     1474         end.
     1475       end.
     1476     end.
     1477     else do:
     1478       if sort-gr = yes then do:
     1479         if sort-name = yes then do:
     1480           for each buf_doc-line no-lock
     1481             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1482             , first buf_goods no-lock
     1483               where buf_goods.artic      = buf_doc-line.artic
     1484                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1485                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1486             break by buf_goods.grp-name  by buf_goods.gds-name
     1487           :
     1488             if  first-of( buf_goods.grp-name) then do:
     1489               run print-grp in this-procedure .
     1490             end.
     1491             run print-line in this-procedure .
     1492           end.
     1493         end.
     1494         else do:
     1495           for each buf_doc-line
     1496             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1497             , first buf_goods no-lock
     1498               where buf_goods.artic      = buf_doc-line.artic
     1499                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1500                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1501             break by buf_goods.grp-name  by buf_doc-line.num-place
     1502           :
     1503             if  first-of( buf_goods.grp-name) then do:
     1504               run print-grp in this-procedure .
     1505             end.
     1506             run print-line in this-procedure .
     1507           end.
     1508         end.
     1509       end.
     1510       else do:
     1511         if sort-name = yes then do:
     1512           for each buf_doc-line no-lock
     1513             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1514             , first buf_goods no-lock
     1515             where buf_goods.artic      = buf_doc-line.artic
     1516               and buf_goods.prod-type  = buf_doc-line.prod-type
     1517               and buf_goods.prod-code  = buf_doc-line.prod-code
     1518             break by buf_goods.gds-name
     1519           :
     1520             run print-line in this-procedure .
     1521           end.
     1522         end.
     1523         else do:
     1524           for each buf_doc-line
     1525             where buf_doc-line.doc-code = buf_trn-doc.doc-code
     1526             , first buf_goods no-lock
     1527             where buf_goods.artic      = buf_doc-line.artic
     1528                 and buf_goods.prod-type  = buf_doc-line.prod-type
     1529                 and buf_goods.prod-code  = buf_doc-line.prod-code
     1530             break by buf_doc-line.num-place
     1531           :
     1532             run print-line in this-procedure .
     1533           end.
     1534         end.
     1535       end.
     1536     end.
     1537     PUT stream Out_stream  Line format "X(198)"   SKIP  .
     1538       display stream out_stream            sym1   sym2  sym3
     1539         "ИТОГО" @ buf_goods.gds-name       sym4
     1540         sum1 @ buf_doc-line.fact-qnty      sym5   sym6
     1541         sum2 @ sum                         sym7
     1542         sum3 @  sum-no-vat                 sym8   sym9
     1543         sum4 @ doc-sum                     sym10
     1544         ((sum4 - sum2) * 100 / sum2)  @ nazen     sym11
     1545         (sum4 - sum2) @ eff                sym12  sym13
     1546         sum5 @ VAT-sum                     sym14
     1547       with frame Akt.
     1548       down stream out_stream with frame Akt .
     1549     PUT stream Out_stream  Line format "X(198)"   SKIP(1)  .
     1550     PUT stream Out_stream  SPACE(10) "Всего  " string(num,">>>>9")  " наименований." format "X(15)"  SKIP(1)  .
     1551     PUT stream Out_stream  SPACE(20) "Зав. складом/Зав. секцией : " format "X(30)" .
     1552     HIDE stream Out_stream  FRAME BottomFrame .
     1553     output stream Out_stream close .
     1554   if g#quest-print = false
     1555   then do:
     1556     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
     1557                                         7, (if 8 >= 8 then 2 else 0), 0, 0,
     1558                                         OUTPUT g#log ).
     1559   end.
     1560   else do:
     1561     os-command silent
     1562       value( "COPY /b " +
     1563         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
     1564         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
     1565         string( session:temp-directory) +  "$" + string( g#report-num )
     1566                 ) .
     1567     os-command silent
     1568       value( "COPY /b " +
     1569         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
     1570         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
     1571         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
     1572                 ) .
     1573   end.
     1574   end.
     1575   procedure Print-prod :
     1576     do on error undo, return error return-value :
     1577       find first buf_clients where buf_clients.obj-type = buf_goods.prod-type and buf_clients.obj-code = buf_goods.prod-code no-lock .
     1578       display stream out_stream sym1 "Производитель -" @ buf_goods.artic buf_clients.obj-name @ buf_goods.gds-name sym14 with frame Akt .
     1579       down stream out_stream with frame Akt .
     1580     end.
     1581   end procedure.
     1582   procedure print-grp :
     1583     do on error undo, return error return-value :
     1584       display stream out_stream sym1 "Группа -" @ buf_goods.artic buf_goods.grp-name @ buf_goods.gds-name sym14 with frame Akt .
     1585       down stream out_stream with frame Akt .
     1586     end.
     1587   end procedure.
     1588   procedure print-line :
     1589     do on error undo, return error return-value :
     1590   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1591     (input  buf_goods.gds-code
     1592     ,input  ?
     1593     ,output b-code
     1594     ) no-error .
     1595       if error-status :error then do:
     1596         message vss-workfile vss-revision vss-description skip "Ошибка при определении бар-кода товара" skip  "Код товара" buf_goods.gds-code skip
     1597         view-as alert-box error .
     1598       end.
     1599       assign
     1600         num = num + 1
     1601         tb-code = string(b-code)
     1602       .
     1603       run r-cost in this-procedure ( input buf_doc-line.doc-code  ,input buf_doc-line.artic ,input buf_doc-line.prod-type
     1604                 ,input buf_doc-line.prod-code  ,output t-dec       ,output v-vat-pc   ,output t-dec
     1605                 ,output v-sum-base             ,output v-sum-rubl  ,output v-vat-base ,output v-vat-rubl
     1606                 ,output t-dec                  ,output t-dec       ,output t-dec      ,output t-dec
     1607                 ,output t-dec   ,output t-dec  ,output t-dec       ,output t-dec      ,output t-dec   ,output t-dec ) no-error .
     1608       run r-sale in this-procedure ( input buf_doc-line.doc-code  ,input buf_doc-line.artic ,input buf_doc-line.prod-type
     1609                 ,input buf_doc-line.prod-code  ,output t-dec       ,output v-vat-pc   ,output t-dec
     1610                 ,output v-sum-base1            ,output v-sum-rubl1 ,output v-vat-base1 ,output v-vat-rubl1
     1611                 ,output t-dec                  ,output t-dec  ,output t-dec      ,output t-dec
     1612                 ,output t-dec   ,output t-dec  ,output t-dec       ,output t-dec      ,output t-dec   ,output t-dec ) no-error .
     1613       if PrintRubl then
     1614         assign
     1615           price      = - v-sum-rubl / buf_doc-line.fact-qnty
     1616           sum        = - v-sum-rubl
     1617           sum-no-vat = - (v-sum-rubl - v-vat-rubl)
     1618           doc-price  = - v-sum-rubl1 / buf_doc-line.fact-qnty
     1619           doc-sum    = - v-sum-rubl1
     1620           VAT-sum    = - v-vat-rubl1
     1621         .
     1622       else
     1623         assign
     1624           price      = - v-sum-base / buf_doc-line.fact-qnty
     1625           sum        = - v-sum-base
     1626           sum-no-vat = - (v-sum-base - v-vat-base)
     1627           doc-price  = - v-sum-base1 / buf_doc-line.fact-qnty
     1628           doc-sum    = - v-sum-base1
     1629           VAT-sum    = - v-vat-base1
     1630         .
     1631       assign
     1632         eff   = doc-sum - sum
     1633         nazen = eff * 100 / sum
     1634         sum1 = sum1 + buf_doc-line.fact-qnty
     1635         sum2 = sum2 + sum
     1636         sum3 = sum3 + sum-no-vat
     1637         sum4 = sum4 + doc-sum
     1638         sum5 = sum5 + VAT-sum
     1639       .
     1640       display stream out_stream
     1641         sym1 tb-code  sym2 buf_goods.artic sym3 buf_goods.gds-name sym4 buf_doc-line.fact-qnty sym5
     1642          price        sym6
     1643          sum          sym7
     1644          sum-no-vat   sym8
     1645          doc-price    sym9
     1646          doc-sum      sym10
     1647          nazen        sym11
     1648          eff          sym12
     1649          buf_doc-line.vat-pc sym13
     1650          VAT-sum      sym14
     1651       with frame Akt.
     1652       down stream out_stream with frame Akt .
     1653     end.
     1654   end procedure.
