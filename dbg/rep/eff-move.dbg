      973                                      out-vatp_goods.prod-type = buf_doc-line.prod-type and
      974                                      out-vatp_goods.prod-code = buf_doc-line.prod-code no-lock.
      975   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
