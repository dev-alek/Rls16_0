      634     price-base-with-tax-loc = buf_doc-line.price-base
      635   .
      636   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      637   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      638     (output varinvprb
      639     )  .
      640      find first in-vatp_doc-attr no-lock
      641       where in-vatp_doc-attr.doc-code  = buf_trn-doc.doc-code
      642         and in-vatp_doc-attr.attr-code = 'envd':U
      643       no-error .
      644       if available in-vatp_doc-attr
      645          then do:
      646          assign
      647            in-vatp-have-vat-slt = no.
      648      end.
      649      else do:
      650        assign
      651          in-vatp-have-vat-slt = yes.
      652      end.
      653      find first in-vatp-goods where in-vatp-goods.artic     = buf_doc-line.artic     and
      654                                        in-vatp-goods.prod-type = buf_doc-line.prod-type and
      655                                        in-vatp-goods.prod-code = buf_doc-line.prod-code no-lock.
      656      if (not buf_trn-doc.internal and
      657              buf_trn-doc.doc-type = 'при':U) or
      658         in-vatp-goods.gds-type = 'у':U then do:
      659         if varinvprb = "base":u then do:
      660           assign
      661             road-tax-base-loc = buf_doc-line.road-tax
      662             road-tax-rubl-loc = buf_doc-line.road-tax * buf_trn-doc.base-rate / buf_trn-doc.base-scale.
      663         end.
      664         else do:
      665           ASSIGN
      666             road-tax-rubl-loc = buf_doc-line.road-tax
      667             road-tax-base-loc = buf_doc-line.road-tax / buf_trn-doc.base-rate * buf_trn-doc.base-scale.
      668         end.
      669         if road-tax-base-loc = ? then road-tax-base-loc = 0.
      670         if road-tax-rubl-loc = ? then road-tax-rubl-loc = 0.
      671         assign
      672           road-tax-cli-loc = ?.
      673         ASSIGN
      674           transport-base-loc = (if buf_doc-line.transport-base = ? then 0 else buf_doc-line.transport-base)
      675           transport-rubl-loc = (if buf_doc-line.transport-rubl = ? then 0 else buf_doc-line.transport-rubl)
      676           transport-cli-loc  = 0
      677           other-base-loc     = (if buf_doc-line.other-base     = ? then 0 else buf_doc-line.other-base)
      678           other-rubl-loc     = (if buf_doc-line.other-rubl     = ? then 0 else buf_doc-line.other-rubl)
      679           other-cli-loc      = 0
      680           vat-pc-loc         = (if buf_doc-line.vat-pc         = ? then 0 else buf_doc-line.vat-pc)
      681           slt-pc-loc         = (if buf_doc-line.slt-pc         = ? then 0 else buf_doc-line.slt-pc).
      682                                 ASSIGN   slt-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-base-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-base-with-tax-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      683               ASSIGN   slt-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc)))                           * slt-pc-loc / (100 + slt-pc-loc))                        vat-rubl-loc    = (if in-vatp-have-vat-slt = no then 0 else (price-rubl-with-tax-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))) * (1 - slt-pc-loc / (100 + slt-pc-loc)) * vat-pc-loc / (100 + vat-pc-loc)).
      684         assign
      685           vat-cli-loc            = ?
      686           slt-cli-loc            = ?
      687           price-cli-with-tax-loc = ?.
      688      end.
      689      else do:
      690                                                   for each in-vatp-parts where in-vatp-parts.out-code  = buf_doc-line.doc-code  and
      691                                         in-vatp-parts.obj-type  = buf_doc-line.obj-type  and
      692                                         in-vatp-parts.obj-code  = buf_doc-line.obj-code  and
      693                                         in-vatp-parts.artic     = buf_doc-line.artic     and
      694                                         in-vatp-parts.prod-type = buf_doc-line.prod-type and
      695                                         in-vatp-parts.prod-code = buf_doc-line.prod-code
      696                            use-index out-code no-lock:
      697             accumulate  in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty (total)
      698                         in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty (total)
      699                         in-vatp-parts.transport-base * in-vatp-parts.fact-qnty (total)
      700                         in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty (total)
      701                         in-vatp-parts.other-base     * in-vatp-parts.fact-qnty (total)
      702                         in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty (total)
      703                                                                                                                 (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      704                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      705                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      706                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      707                                               (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  (total)
      708                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))  (total)
      709                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))  (total)
      710                         (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc))  (total)
      711                         .
      712         end.
      713         ASSIGN
      714           road-tax-base-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-base  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      715           road-tax-rubl-loc   = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.road-tax-rubl  * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      716           transport-base-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-base * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      717           transport-rubl-loc  = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.transport-rubl * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      718           other-base-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-base     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      719           other-rubl-loc      = if buf_doc-line.fact-qnty <> 0 then (accum total in-vatp-parts.other-rubl     * in-vatp-parts.fact-qnty) / buf_doc-line.fact-qnty  else 0
      720                                           vat-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      721           slt-base-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-base - ((if in-vatp-parts.road-tax-base  = ? then 0 else in-vatp-parts.road-tax-base) + (if in-vatp-parts.transport-base = ? then 0 else in-vatp-parts.transport-base) + (if in-vatp-parts.other-base = ? then 0 else in-vatp-parts.other-base)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      722                   vat-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / buf_doc-line.fact-qnty   else 0
      723           slt-rubl-loc        = if buf_doc-line.fact-qnty <> 0 then (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / buf_doc-line.fact-qnty   else 0
      724           vat-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc)) * in-vatp-parts.vat-pc / (100 + in-vatp-parts.vat-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty * (1 - in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))  / (100 + in-vatp-parts.vat-pc)))
      725           slt-pc-loc          = (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                     * in-vatp-parts.slt-pc / (100 + in-vatp-parts.slt-pc))) / (accum total (if in-vatp-have-vat-slt = no then 0 else (in-vatp-parts.price-rubl - ((if in-vatp-parts.road-tax-rubl  = ? then 0 else in-vatp-parts.road-tax-rubl) + (if in-vatp-parts.transport-rubl = ? then 0 else in-vatp-parts.transport-rubl) + (if in-vatp-parts.other-rubl = ? then 0 else in-vatp-parts.other-rubl)))   * in-vatp-parts.fact-qnty                      / (100 + in-vatp-parts.slt-pc))).
      726         if road-tax-base-loc  = ? then road-tax-base-loc  = 0.
      727         if road-tax-rubl-loc  = ? then road-tax-rubl-loc  = 0.
      728         if transport-base-loc = ? then transport-base-loc = 0.
      729         if transport-rubl-loc = ? then transport-rubl-loc = 0.
      730         if other-base-loc     = ? then other-base-loc     = 0.
      731         if other-rubl-loc     = ? then other-rubl-loc     = 0.
      732         assign
      733           transport-cli-loc      = 0
      734           other-cli-loc          = 0
      735           road-tax-cli-loc       = ?
      736           vat-cli-loc            = ?
      737           slt-cli-loc            = ?
      738           price-cli-with-tax-loc = ?.
      739      end.
      740   ASSIGN
      741             price-base-without-tax-loc = price-base-with-tax-loc - vat-base-loc - slt-base-loc - ((if road-tax-base-loc  = ? then 0 else road-tax-base-loc) + (if transport-base-loc = ? then 0 else transport-base-loc) + (if other-base-loc = ? then 0 else other-base-loc))
      742       price-rubl-without-tax-loc = price-rubl-with-tax-loc - vat-rubl-loc - slt-rubl-loc - ((if road-tax-rubl-loc  = ? then 0 else road-tax-rubl-loc) + (if transport-rubl-loc = ? then 0 else transport-rubl-loc) + (if other-rubl-loc = ? then 0 else other-rubl-loc))
      743   .
      744             assign
      745               v-fact-qnty           = v-fact-qnty      + v-parts-fact-qnty
      746               v-vat-pc              = vat-pc-loc
      747               v-slt-pc              = slt-pc-loc
      748               v-sum-base            = v-sum-base       + (price-base-with-tax-loc * v-parts-fact-qnty)
      749               v-sum-rubl            = v-sum-rubl       + (price-rubl-with-tax-loc * v-parts-fact-qnty)
      750               v-vat-base            = v-vat-base       + (vat-base-loc            * v-parts-fact-qnty)
      751               v-vat-rubl            = v-vat-rubl       + (vat-rubl-loc            * v-parts-fact-qnty)
      752               v-slt-base            = v-slt-base       + (slt-base-loc            * v-parts-fact-qnty)
      753               v-slt-rubl            = v-slt-rubl       + (slt-rubl-loc            * v-parts-fact-qnty)
      754               v-road-tax-base       =  0
      755               v-road-tax-rubl       =  0
      756               v-excise-base         =  0
      757               v-excise-rubl         =  0
      758               v-transport-base      =  0
      759               v-transport-rubl      =  0
      760               v-other-base          =  0
      761               v-other-rubl          =  0
      762             .
      763       end.
      764     end.
      765   end procedure.
      766   define variable vss-include-info7 as character format "X(65)" no-undo
      767   initial "@(#)$Workfile$ $Revision$".
      768   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   procedure r-sale :
      770     define input parameter  p-doc-code          like ub.doc-line.doc-code          no-undo .
      771     define input parameter  p-artic             like ub.doc-line.artic             no-undo .
      772     define input parameter  p-prod-type         like ub.doc-line.prod-type         no-undo .
      773     define input parameter  p-prod-code         like ub.doc-line.prod-code         no-undo .
      774     define output parameter p-fact-qnty         like ub.ot-line.fact-qnty       no-undo .
      775     define output parameter p-vat-pc            like ub.doc-line.vat-pc         no-undo .
      776     define output parameter p-slt-pc            like ub.doc-line.slt-pc         no-undo .
      777     define output parameter p-sum-base          like ub.ot-line.sum-base        no-undo .
      778     define output parameter p-sum-rubl          like ub.ot-line.sum-rubl        no-undo .
      779     define output parameter p-vat-base          like ub.ot-line.vat-base        no-undo .
      780     define output parameter p-vat-rubl          like ub.ot-line.vat-rubl        no-undo .
      781     define output parameter p-slt-base          like ub.ot-line.slt-base        no-undo .
      782     define output parameter p-slt-rubl          like ub.ot-line.slt-rubl        no-undo .
      783     define output parameter p-road-tax-base     like ub.ot-line.road-tax-base   no-undo .
      784     define output parameter p-road-tax-rubl     like ub.ot-line.road-tax-rubl   no-undo .
      785     define output parameter p-transport-base    like ub.ot-line.transport-base  no-undo .
      786     define output parameter p-transport-rubl    like ub.ot-line.transport-rubl  no-undo .
      787     define output parameter p-other-base        like ub.ot-line.other-base      no-undo .
      788     define output parameter p-other-rubl        like ub.ot-line.other-rubl      no-undo .
      789     define output parameter p-excise-base       like ub.ot-line.excise-base     no-undo .
      790     define output parameter p-excise-rubl       like ub.ot-line.excise-rubl     no-undo .
      791     define variable vss-description as character no-undo initial "r-sale-01: обработка продажных цен товара".
      792     do
      793     on error undo, return error
      794     :
      795       define  variable price-rubl-with-tax-sale    like ub.doc-line.price-rubl no-undo.
      796       define  variable price-base-with-tax-sale    like ub.doc-line.price-base no-undo.
      797       define  variable price-rubl-without-tax-sale like ub.doc-line.price-rubl no-undo.
      798       define  variable price-base-without-tax-sale like ub.doc-line.price-base no-undo.
      799       define  variable vat-base-sale               like ub.doc-line.price-base no-undo.
      800       define  variable vat-rubl-sale               like ub.doc-line.price-rubl no-undo.
      801       define  variable vat-base-buyer              like ub.doc-line.price-base no-undo.
      802       define  variable vat-rubl-buyer              like ub.doc-line.price-rubl no-undo.
      803       define  variable slt-base-sale               like ub.doc-line.price-base no-undo.
      804       define  variable slt-rubl-sale               like ub.doc-line.price-rubl no-undo.
      805       define  variable road-tax-base-sale          like ub.doc-line.road-tax   no-undo.
      806       define  variable road-tax-rubl-sale          like ub.doc-line.road-tax   no-undo.
      807       define  variable excise-base-sale            like ub.doc-line.price-base no-undo.
      808       define  variable excise-rubl-sale            like ub.doc-line.price-rubl no-undo.
      809       define  variable discnt-base-sale            like ub.gds-dtl.discnt-base no-undo.
      810       define  variable discnt-rubl-sale            like ub.gds-dtl.discnt-rubl no-undo.
      811       define buffer out-vatp_gds-dtl     for ub.gds-dtl.
      812       define buffer buf_out-vatp_gds-dtl for ub.gds-dtl.
      813       define buffer out-vatp_parts       for ub.parts.
      814       define buffer out-vatp_sysconf     for ub.sysconf.
      815       define buffer out-vatp_doc-line    for ub.doc-line.
      816       define buffer out-vatp_goods       for ub.goods.
      817       define buffer out-vatp_trn-doc     for ub.trn-doc.
      818       define buffer out-vatp_doc-attr    for ub.doc-attr.
      819       define variable varprice-base-cons      like ub.doc-line.price-base initial 0.00 no-undo.
      820       define variable varprice-rubl-cons      like ub.doc-line.price-rubl initial 0.00 no-undo.
      821       define variable varfrm-cnsv-type         as   character                           no-undo.
