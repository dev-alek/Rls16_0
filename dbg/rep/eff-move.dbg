      984       vss-workfile vss-revision vss-description skip
      985       "Ошибка при определении корневого признака товара" skip
      986       "Артикул" buf_doc-line.artic buf_doc-line.prod-type buf_doc-line.prod-code skip
      987       error-status :get-message(1) skip
