      943                       v-gds-dtl-fact-qnty = - buf_gds-dtl.fact-qnty
      944                   .
      945               end.
      946           end.
      947           else do:
      948               assign
      949                   v-gds-dtl-fact-qnty = buf_gds-dtl.doc-qnty
      950               .
      951           end.
      952           if v-gds-dtl-fact-qnty <> 0
      953           then do:
      954   if buf_trn-doc.ext-doc-type = 'ot':U or
      955      buf_trn-doc.ext-doc-type = ?                 then do:
