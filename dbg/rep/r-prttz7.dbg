     7753     if c-f-qnty <>  ?  then do :
     7754       c-f-qnty:screen-value = string(accum TOTAL f-qnty) .
     7755       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7756           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7757           display STREAM OutStream    with frame top-frame .
     7758       End.
     7759     End.
     7760     if c-f-cost-sum <>  ?  then do :
     7761       c-f-cost-sum:screen-value = string(accum TOTAL f-cost-sum) .
     7762       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7763           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7764           display STREAM OutStream    with frame top-frame .
     7765       End.
     7766     End.
     7767     if c-f-sale-sum <>  ?  then do :
     7768       c-f-sale-sum:screen-value = string(accum TOTAL f-sale-sum) .
     7769       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7770           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7771           display STREAM OutStream    with frame top-frame .
     7772       End.
     7773     End.
     7774     if c-f-sale-other <>  ?  then do :
     7775       c-f-sale-other:screen-value = string(accum TOTAL f-sale-other) .
     7776       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7777           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7778           display STREAM OutStream    with frame top-frame .
     7779       End.
     7780     End.
     7781     if c-f-free-qnty <>  ?  then do :
     7782       c-f-free-qnty:screen-value = string(accum TOTAL f-free-qnty) .
     7783       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7784           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7785           display STREAM OutStream    with frame top-frame .
     7786       End.
     7787     End.
     7788     if c-f-wait-qnty <>  ?  then do :
     7789       c-f-wait-qnty:screen-value = string(accum TOTAL f-wait-qnty) .
     7790       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7791           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7792           display STREAM OutStream    with frame top-frame .
     7793       End.
     7794     End.
     7795     if c-f-rez-qnty <>  ?  then do :
     7796       c-f-rez-qnty:screen-value = string(accum TOTAL f-rez-qnty) .
     7797       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7798           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7799           display STREAM OutStream    with frame top-frame .
     7800       End.
     7801     End.
     7802     if c-f-rez-cost <>  ?  then do :
     7803       c-f-rez-cost:screen-value = string(accum TOTAL f-rez-cost) .
     7804       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7805           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7806           display STREAM OutStream    with frame top-frame .
     7807       End.
     7808     End.
     7809     if c-f-rez-sale <>  ?  then do :
     7810       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     7811       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7812           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7813           display STREAM OutStream    with frame top-frame .
     7814       End.
     7815     End.
     7816   dIsplay stream OutStream with FRAME Zapas no-error .
     7817   down stream OutStream with FRAME Zapas.
     7818   run u-line in this-procedure.
     7819   if Make-Excel then  put   stream ForExcel unformatted
     7820   "ИТОГО"                       CHR(9)
     7821   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     7822    CHR(9)
     7823   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     7824   CHR(9)
     7825   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     7826   CHR(9)
     7827   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     7828   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     7829   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     7830   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     7831   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     7832   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     7833   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     7834   chr(10) .
     7835   end procedure.
     7836   procedure display-prt-t :
     7837   define variable pr-cursor as integer no-undo init 0.
     7838   define variable go-work   as logical no-undo init no.
     7839   IF goods.prt-root <> Prtroot Then DO:
     7840     for each sl-obj-list ,
     7841       each prt-obj where
     7842         prt-obj.artic     = goods.artic     and
     7843         prt-obj.prod-type = goods.prod-type and
     7844         prt-obj.prod-code = goods.prod-code and
     7845         prt-obj.obj-code  = sl-obj-list.obj-code and
     7846         prt-obj.obj-type  = sl-obj-list.obj-type and
     7847         prt-obj.IS-term   =  true no-lock
     7848             break by prt-obj.prt-code with frame zapas :
     7849             pr-cursor = 0.
     7850             go-work = false.
     7851             if v-prizn = "" then go-work = true.
     7852             else
     7853             do while pr-cursor < num-entries(v-prizn,","):
     7854                 pr-cursor = pr-cursor + 1.
     7855                 if entry(pr-cursor,v-prizn,",") <> "" then do:
     7856                     if integer(entry(pr-cursor,v-prizn,",")) = prt-obj.prt-code then do:
     7857                         pr-cursor = num-entries(v-prizn,",").
     7858                         go-work = true.
     7859                     end.
     7860                 end.
     7861             end.
     7862             if go-work then do:
     7863                 if v-var <> "no-today" then do:
     7864                     assign
     7865                       p-qnty      = p-qnty       + prt-obj.fact-qnty
     7866                       p-free-qnty = p-free-qnty  + prt-obj.free-qnty
     7867                       p-sale-sum  = p-sale-sum   + prt-obj.fact-qnty * prt-obj.price-sale
     7868                       p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7869                       .
     7870                 end.
     7871       if last-of (prt-obj.prt-code) then do:
     7872   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     7873     (input  gds-obj.gds-code
     7874     ,input  prt-obj.prt-code
     7875     ,output v-bar-code
     7876     )  .
     7877                 if v-var = "no-today" then do:
     7878                 for each buf_sl-obj-list ,
     7879                     first buf_prt-obj no-lock where
     7880                           buf_prt-obj.artic     = prt-obj.artic     and
     7881                           buf_prt-obj.prod-type = prt-obj.prod-type and
     7882                           buf_prt-obj.prod-code = prt-obj.prod-code and
     7883                           buf_prt-obj.prt-code  = prt-obj.prt-code  and
     7884                           buf_prt-obj.obj-code  = buf_sl-obj-list.obj-code and
     7885                           buf_prt-obj.obj-type  = buf_sl-obj-list.obj-type and
     7886                           buf_prt-obj.IS-term   = prt-obj.IS-term
     7887                           :
     7888                    run  prdoclib-init-prt-obj-by-factord in this-procedure
     7889                     ( input buf_sl-obj-list.obj-type  ,
     7890                       input buf_sl-obj-list.obj-code  ,
     7891                       input gds-obj.artic     ,
     7892                       input gds-obj.prod-type ,
     7893                       input gds-obj.prod-code ,
     7894                       input fact-order-2 ,
     7895                       input false ) .
     7896                   find first temp-prt-obj no-lock
     7897                        where temp-prt-obj.prt-obj-recid   = recid (buf_prt-obj) no-error .
     7898                        if available temp-prt-obj then do :
     7899                          run  calc-price-sale-for-prt in this-procedure  (output v-price-sale) .
     7900                           assign
     7901                             p-qnty      = p-qnty   +   temp-prt-obj.fact-qnty
     7902                             p-free-qnty =  0
     7903                             p-sale-sum  = p-sale-sum + temp-prt-obj.fact-qnty * v-price-sale
     7904                             p-sale-pr   = if p-qnty = 0 then 0 else p-sale-sum / p-qnty
     7905                             .
     7906                         end.
     7907                 end.
     7908               end.
     7909           find first gds-prt  where gds-prt.node-code = prt-obj.prt-code no-lock no-error .
     7910           if c-f-wait-qnty <> ? then do :
     7911             for each buf_sl-obj-list ,
     7912                 each trn-doc no-lock  where
     7913                 trn-doc.obj-code        = buf_sl-obj-list.obj-code and
     7914                 trn-doc.obj-type        = buf_sl-obj-list.obj-type and
     7915                 trn-doc.status_         = 'накл':U           and
     7916                 trn-doc.flag_           = true              and
     7917                 trn-doc.ext-doc-type    = 'ie':U :
     7918                 for each gds-dtl no-lock where
     7919                           gds-dtl.doc-code   = trn-doc.doc-code   and
     7920                           gds-dtl.artic      = goods.artic        and
     7921                           gds-dtl.prod-code  = goods.prod-code    and
     7922                           gds-dtl.prod-type  = goods.prod-type    and
     7923                           gds-dtl.prt-code   = prt-obj.prt-code   and
     7924                           gds-dtl.obj-code   = buf_sl-obj-list.obj-code  and
     7925                           gds-dtl.obj-type   = buf_sl-obj-list.obj-type
     7926                           :
     7927                           assign
     7928                             p-wait-qnty   = p-wait-qnty     + gds-dtl.fact-qnty
     7929                             .
     7930                 end.
     7931             end.
     7932           end.
     7933           assign
     7934             p-cost-sum     = determined( f-cost-sum * p-qnty  / f-qnty)
     7935             p-sale-other   = 100 * determined((p-sale-sum - p-cost-sum) / p-cost-sum)
     7936             p-cost-pr      = if p-qnty = 0 then 0 else p-cost-sum   / p-qnty
     7937             .
     7938           if ( f-rez-qnty <> ? or
     7939                f-rez-cost <> ? or
     7940                f-rez-sale <> ? ) and  v-var <> "no-today"
     7941           then do:
     7942                 for each temp_gds-dtl where
     7943                          temp_gds-dtl.prt-code   = prt-obj.prt-code  :
     7944                     assign
     7945                       p-rez-qnty = p-rez-qnty  + temp_gds-dtl.doc-qnty
     7946                       p-rez-cost = p-rez-cost  + temp_gds-dtl.cost-sum
     7947                       p-rez-sale = p-rez-sale  + temp_gds-dtl.sale-sum
     7948                       p-rez-cost-pr = ( if p-rez-qnty = 0 then 0 else p-rez-cost / p-rez-qnty )
     7949                     .
     7950                 end.
     7951           end.
     7952               if not (p-zero = false  and
     7953                    (p-qnty        =  0  and
     7954                     p-cost-sum    =  0  and
     7955                     p-sale-sum    =  0  and
     7956                     p-sale-other  =  0  and
     7957                     p-free-qnty   =  0  and
     7958                     p-wait-qnty  =  0  ) ) then do:
     7959     if c-nn <>  ?  then do :
     7960       c-nn:screen-value = string('') .
     7961       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7962           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7963           display STREAM OutStream    with frame top-frame .
     7964       End.
     7965     End.
     7966     if c-f-artic <>  ?  then do :
     7967       c-f-artic:screen-value = string('') .
     7968       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7969           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7970           display STREAM OutStream    with frame top-frame .
     7971       End.
     7972     End.
     7973     if c-f-b-code <>  ?  then do :
     7974       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     7975       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7976           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7977           display STREAM OutStream    with frame top-frame .
     7978       End.
     7979     End.
     7980     if c-f-prt-name <>  ?  then do :
     7981       c-f-prt-name:screen-value = string(gds-prt.f-name) .
     7982       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7983           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7984           display STREAM OutStream    with frame top-frame .
     7985       End.
     7986     End.
     7987     if c-f-qnty <>  ?  then do :
     7988       c-f-qnty:screen-value = string(p-qnty) .
     7989       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7990           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7991           display STREAM OutStream    with frame top-frame .
     7992       End.
     7993     End.
     7994     if c-f-sale-pr <>  ?  then do :
     7995       c-f-sale-pr:screen-value = string(p-sale-pr) .
     7996       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7997           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7998           display STREAM OutStream    with frame top-frame .
     7999       End.
     8000     End.
     8001     if c-f-sale-sum <>  ?  then do :
     8002       c-f-sale-sum:screen-value = string(p-sale-sum) .
     8003       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8004           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8005           display STREAM OutStream    with frame top-frame .
     8006       End.
     8007     End.
     8008     if c-f-sale-other <>  ?  then do :
     8009       c-f-sale-other:screen-value = string(p-sale-other) .
     8010       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8011           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8012           display STREAM OutStream    with frame top-frame .
     8013       End.
     8014     End.
     8015     if c-f-free-qnty <>  ?  then do :
     8016       c-f-free-qnty:screen-value = string(p-free-qnty) .
     8017       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8018           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8019           display STREAM OutStream    with frame top-frame .
     8020       End.
     8021     End.
     8022     if c-f-wait-qnty <>  ?  then do :
     8023       c-f-wait-qnty:screen-value = string(p-wait-qnty) .
     8024       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8025           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8026           display STREAM OutStream    with frame top-frame .
     8027       End.
     8028     End.
     8029     if c-f-rez-qnty <>  ?  then do :
     8030       c-f-rez-qnty:screen-value = string(p-rez-qnty) .
     8031       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8032           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8033           display STREAM OutStream    with frame top-frame .
     8034       End.
     8035     End.
     8036     if c-f-rez-cost <>  ?  then do :
     8037       c-f-rez-cost:screen-value = string(p-rez-cost) .
     8038       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8039           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8040           display STREAM OutStream    with frame top-frame .
     8041       End.
     8042     End.
     8043     if c-f-rez-sale <>  ?  then do :
     8044       c-f-rez-sale:screen-value = string(p-rez-sale) .
     8045       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     8046           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     8047           display STREAM OutStream    with frame top-frame .
     8048       End.
     8049     End.
     8050                   Display stream OutStream no-error.
     8051                   DOWN stream OutStream .
     8052                   if Make-Excel then  put   stream ForExcel unformatted
     8053                   CHR(9)
     8054                   string(v-bar-code,"999999999")
     8055                   CHR(9)
     8056                   CHR(9)
     8057                   CHR(9)
     8058                   gds-prt.f-name                 CHR(9)
     8059                   excel-qnty(p-qnty)             CHR(9)
     8060                                            CHR(9)
     8061                                            CHR(9)
     8062                   excel-sum(p-sale-pr)          CHR(9)
     8063                   excel-sum(p-sale-sum)         CHR(9)
     8064                   excel-sum(p-sale-other)       CHR(9)
     8065                   excel-sum(p-free-qnty)        CHR(9)
     8066                   excel-sum(p-wait-qnty)   CHR(9)
     8067                   excel-sum(p-rez-qnty)    CHR(9)
     8068                   excel-sum(p-rez-cost)    CHR(9)
     8069                   excel-sum(p-rez-sale)    CHR(9)
     8070                   chr(10) .
     8071               end.
     8072           Assign
     8073             p-qnty        =  0
     8074             p-cost-sum    =  0
     8075             p-sale-sum    =  0
     8076             p-sale-other  =  0
     8077             p-free-qnty   =  0
     8078             p-wait-qnty   =  0
     8079             p-rez-qnty   = 0
     8080             p-rez-cost   = 0
     8081             p-rez-sale   = 0
     8082             .
     8083       End.
     8084       end.
     8085     End.
     8086   End.
     8087   end procedure.
     8088   PROCEDURE on-same-page :
     8089     define input parameter p-line-number as integer  no-undo .
     8090     if p-line-number > page-size( OutStream ) then do:
     8091       return .
     8092     end.
     8093     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     8094       page stream OutStream .
     8095     end.
     8096   end procedure.
     8097   PROCEDURE ostatok :
     8098   def input parameter x-store-code  like ub.clients.obj-code    no-undo.
     8099   def input parameter x-store-type  like ub.clients.obj-type    no-undo.
     8100   def input parameter x-tog-shift   as   logical             no-undo.
     8101   def input parameter x-date-start  like ub.stk-tot.Fact-date   no-undo.
     8102   def input parameter x-date-end    like ub.stk-tot.Fact-date   no-undo.
     8103   def input parameter x-shift-start as integer               no-undo.
     8104   def input parameter x-shift-end   as integer               no-undo.
     8105   def input parameter x-sum-type    like ub.stk-tot.sum-type    no-undo.
     8106   def input parameter x-cat-id      like ub.stk-tot.cat-id      no-undo.
     8107   def input parameter xTog-obj   as log no-undo.
     8108   def output parameter Quantity    like ub.stk-tot.fact-qnty   no-undo.
     8109   def output parameter Coast_R     like ub.stk-tot.sum-rubl    no-undo.
     8110   def output parameter Coast_V     like ub.stk-tot.sum-rubl    no-undo.
     8111   def output parameter VAT_R       like ub.stk-tot.sum-rubl    no-undo.
     8112   def output parameter VAT_V       like ub.stk-tot.sum-rubl    no-undo.
     8113   def output parameter Fact-order  like ub.stk-tot.Fact-order  no-undo.
     8114   def var              Fact-order#   like ub.stk-tot.Fact-order  no-undo.
     8115   def var              Fact-orderS   as char  no-undo.
     8116   def var x-date-start-t  like ub.stk-tot.shift-date   no-undo.
     8117      Assign
     8118         Fact-order   = 0
     8119         Quantity     = 0
     8120         Coast_R      = 0
     8121         Coast_V      = 0
     8122         VAT_R        = 0
     8123         VAT_V        = 0 .
     8124    x-date-start-t  = x-date-start + 1 .
     8125   IF x-date-end = date('') then DO:
     8126      Fact-order = 0 .
     8127      for each obj-list
     8128          where  ( not xtog-obj or
     8129                 ( x-store-type = obj-list.obj-type and x-store-code = obj-list.obj-code ))
     8130                 no-lock :
     8131         if  x-tog-shift = false then do:
     8132                          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8133                               ub.stk-tot.Fact-date <=  x-date-start
     8134                               and ub.stk-tot.shift-num = 0
     8135                               USE-INDEX fact-date no-lock no-error .
     8136              if Available ub.stk-tot THEN  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8137         End.
     8138         Else  DO :
     8139             find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8140              (ub.stk-tot.shift-date  = x-date-start-t and
     8141               ub.stk-tot.shift-num  < x-shift-start or
     8142               ub.stk-tot.shift-date  < x-date-start-t  )
     8143               and ub.stk-tot.shift-num  > 0
     8144               USE-INDEX Shift-num no-lock no-error .
     8145            If Available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8146           END.
     8147       If Fact-order < Fact-order#  and Fact-order# <> 0  THEN  Fact-order = Fact-order# .
     8148     End.
     8149   End.
     8150   Else DO:
     8151     For each obj-list  WHERE
     8152        (NOT xTog-obj OR (x-store-type = obj-list.obj-type AND x-store-code = obj-list.obj-code))
     8153         no-lock :
     8154      IF  x-TOG-Shift = False Then DO:
     8155          find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8156               ub.stk-tot.Fact-date <= x-date-end
     8157               and ub.stk-tot.shift-num = 0
     8158               USE-INDEX fact-date no-lock no-error.
     8159          if available ub.stk-tot then  Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8160      END.
     8161      Else DO:
     8162           find last ub.stk-tot where ub.stk-tot.obj-type = obj-list.obj-type and                             ub.stk-tot.obj-code = obj-list.obj-code and                             ub.stk-tot.sum-type = x-sum-type and                             ub.stk-tot.cat-id   = x-cat-id   and
     8163               (ub.stk-tot.shift-date  = x-date-end and
     8164               ub.stk-tot.shift-num  <= x-shift-end or
     8165               ub.stk-tot.shift-date  < x-date-end       ) and
     8166               ub.stk-tot.shift-num   > 0      use-index shift-num no-lock no-error.
     8167               if Available ub.stk-tot THEN Assign                           Quantity     = Quantity   + ub.stk-tot.fact-qnty                           Coast_R      = Coast_R    + ub.stk-tot.sum-rubl                           Coast_V      = Coast_V    + ub.stk-tot.sum-base                           VAT_R        = VAT_R      + ub.stk-tot.VAT-rubl                           VAT_V        = VAT_V      + ub.stk-tot.VAT-base                           Fact-order#  = ub.stk-tot.Fact-order.
     8168       End.
     8169       if Fact-order < Fact-order#  THEN  Fact-order = Fact-order#.
     8170     End.
     8171   End.
     8172   END PROCEDURE.
     8173   procedure ost-line :
     8174     define input  parameter x-store-code like ub.clients.obj-code    no-undo .
     8175     define input  parameter x-store-type like ub.clients.obj-type    no-undo .
     8176     define input  parameter x-artic      like ub.stk-line.artic      no-undo .
     8177     define input  parameter x-prod-code  like ub.stk-line.prod-code  no-undo .
     8178     define input  parameter x-prod-type  like ub.stk-line.prod-type  no-undo .
     8179     define input  parameter x-tog-shift  as logical no-undo .
     8180     define input  parameter x-fact-order like ub.stk-line.fact-order no-undo .
     8181     define input  parameter x-sum-type   like ub.stk-line.sum-type   no-undo .
     8182     define input  parameter x-cat-id     like ub.stk-line.cat-id     no-undo .
     8183     define input  parameter xtog-obj     as logical no-undo .
     8184     define output parameter quantity     like ub.stk-line.fact-qnty  no-undo .
     8185     define output parameter coast_r      like ub.stk-line.sum-rubl   no-undo .
     8186     define output parameter coast_v      like ub.stk-line.sum-rubl   no-undo .
     8187     define output parameter vat_r        like ub.stk-line.sum-rubl   no-undo .
     8188     define output parameter vat_v        like ub.stk-line.sum-rubl   no-undo .
     8189     define output parameter slt_r        like ub.stk-line.sum-rubl   no-undo .
     8190     define output parameter slt_v        like ub.stk-line.sum-rubl   no-undo .
     8191     define buffer buff-obj-list  for obj-list .
     8192     define buffer buff-stk-line  for ub.stk-line .
     8193     assign
     8194       Quantity = 0
     8195       Coast_R  = 0
     8196       Coast_V  = 0
     8197       VAT_R    = 0
     8198       VAT_V    = 0
     8199       SLT_R    = 0
     8200       SLT_V    = 0
     8201     .
     8202     if  x-tog-shift = false then do:
     8203       for each buff-obj-list no-lock
     8204         where xtog-obj = false
     8205            or (buff-obj-list.obj-type = x-store-type
     8206               and buff-obj-list.obj-code = x-store-code
     8207               )
     8208       on error undo, return error
     8209       :
     8210       find last buff-stk-line no-lock
     8211         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8212           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8213           and buff-stk-line.artic      = x-artic
     8214           and buff-stk-line.prod-type  = x-prod-type
     8215           and buff-stk-line.prod-code  = x-prod-code
     8216           and buff-stk-line.sum-type   = x-sum-type
     8217           and buff-stk-line.cat-id     = '##,##':U
     8218           and buff-stk-line.fact-order <= x-fact-order
     8219           and buff-stk-line.shift-num  = 0
     8220         use-index category
     8221         no-error .
     8222       if available buff-stk-line then do:
     8223         assign
     8224           Quantity = Quantity + buff-stk-line.fact-qnty
     8225           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8226           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8227           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8228           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8229           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8230           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8231         .
     8232       end.
     8233      end.
     8234     end.
     8235     else do:
     8236       for each buff-obj-list no-lock
     8237         where xtog-obj = false
     8238            or (buff-obj-list.obj-type = x-store-type
     8239               and buff-obj-list.obj-code = x-store-code
     8240               )
     8241       on error undo, return error
     8242       :
     8243         find last buff-stk-line no-lock
     8244           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8245             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8246             and buff-stk-line.artic      = x-artic
     8247             and buff-stk-line.prod-type  = x-prod-type
     8248             and buff-stk-line.prod-code  = x-prod-code
     8249             and buff-stk-line.sum-type   = x-sum-type
     8250             and buff-stk-line.cat-id     = '##,##':U
     8251             and buff-stk-line.fact-order <= x-fact-order
     8252             and buff-stk-line.shift-num  > 0
     8253           use-index category
     8254           no-error .
     8255         if available buff-stk-line then do:
     8256           assign
     8257             Quantity = Quantity +  buff-stk-line.fact-qnty
     8258             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8259             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8260             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8261             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8262             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8263             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8264           .
     8265         end.
     8266       end.
     8267     end.
     8268   end procedure.
     8269   procedure ost-lineother-tax :
     8270     define input  parameter x-store-code like ub.clients.obj-code      no-undo.
     8271     define input  parameter x-store-type like ub.clients.obj-type      no-undo.
     8272     define input  parameter x-artic      like ub.stk-line.artic        no-undo.
     8273     define input  parameter x-prod-code  like ub.stk-line.prod-code    no-undo.
     8274     define input  parameter x-prod-type  like ub.stk-line.prod-type    no-undo.
     8275     define input  parameter x-tog-shift  as logical no-undo .
     8276     define input  parameter x-fact-order like ub.stk-line.fact-order   no-undo.
     8277     define input  parameter x-sum-type   like ub.stk-line.sum-type     no-undo.
     8278     define input  parameter x-type-id    like ub.stk-line.cat-id       no-undo.
     8279     define input  parameter xTog-obj     as logical no-undo .
     8280     define output parameter Quantity     like ub.stk-line.fact-qnty   no-undo.
     8281     define output parameter Coast_R      like ub.stk-line.sum-rubl    no-undo.
     8282     define output parameter Coast_V      like ub.stk-line.sum-rubl    no-undo.
     8283     define output parameter VAT_R        like ub.stk-line.sum-rubl    no-undo.
     8284     define output parameter VAT_V        like ub.stk-line.sum-rubl    no-undo.
     8285     define output parameter SLT_R        like ub.stk-line.sum-rubl    no-undo.
     8286     define output parameter SLT_V        like ub.stk-line.sum-rubl    no-undo.
     8287     define output parameter other_R      like ub.stk-line.sum-rubl    no-undo.
     8288     define output parameter other_V      like ub.stk-line.sum-rubl    no-undo.
     8289     define buffer buff-obj-list  for obj-list .
     8290     define buffer buff-stk-line  for ub.stk-line .
     8291     assign
     8292       Quantity = 0
     8293       Coast_R  = 0
     8294       Coast_V  = 0
     8295       VAT_R    = 0
     8296       VAT_V    = 0
     8297       SLT_R    = 0
     8298       SLT_V    = 0
     8299       other_R  = 0
     8300       other_V  = 0
     8301     .
     8302     if  x-tog-shift = false then do:
     8303       for each buff-obj-list no-lock
     8304         where xtog-obj = false
     8305            or (buff-obj-list.obj-type = x-store-type
     8306               and buff-obj-list.obj-code = x-store-code
     8307               )
     8308       on error undo, return error
     8309       :
     8310       find last buff-stk-line no-lock
     8311         where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8312           and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8313           and buff-stk-line.artic      = x-artic
     8314           and buff-stk-line.prod-type  = x-prod-type
     8315           and buff-stk-line.prod-code  = x-prod-code
     8316           and buff-stk-line.sum-type   = x-sum-type
     8317           and buff-stk-line.cat-id     = '##,##':U
     8318           and buff-stk-line.fact-order <= x-fact-order
     8319           and buff-stk-line.shift-num  = 0
     8320         use-index category
     8321         no-error .
     8322       if available buff-stk-line then do:
     8323         assign
     8324           Quantity = Quantity + buff-stk-line.fact-qnty
     8325           Coast_R  = Coast_R  + buff-stk-line.sum-rubl
     8326           Coast_V  = Coast_V  + buff-stk-line.sum-base
     8327           VAT_R    = VAT_R    + buff-stk-line.VAT-rubl
     8328           VAT_V    = VAT_V    + buff-stk-line.VAT-base
     8329           SLT_R    = SLT_R    + buff-stk-line.SLT-rubl
     8330           SLT_V    = SLT_V    + buff-stk-line.SLT-base
     8331           other_R  = other_R  + buff-stk-line.other-rubl
     8332           other_V  = other_V  + buff-stk-line.other-base
     8333         .
     8334       end.
     8335    end.
     8336     end.
     8337     else do:
     8338       for each buff-obj-list no-lock
     8339         where xtog-obj = false
     8340            or (buff-obj-list.obj-type = x-store-type
     8341               and buff-obj-list.obj-code = x-store-code
     8342               )
     8343       on error undo, return error
     8344       :
     8345         find last buff-stk-line no-lock
     8346           where buff-stk-line.obj-type   = buff-obj-list.obj-type
     8347             and buff-stk-line.obj-code   = buff-obj-list.obj-code
     8348             and buff-stk-line.artic      = x-artic
     8349             and buff-stk-line.prod-type  = x-prod-type
     8350             and buff-stk-line.prod-code  = x-prod-code
     8351             and buff-stk-line.sum-type   = x-sum-type
     8352             and buff-stk-line.cat-id     = '##,##':U
     8353             and buff-stk-line.fact-order <= x-fact-order
     8354             and buff-stk-line.shift-num  > 0
     8355           use-index category
     8356           no-error .
     8357         if available buff-stk-line then do:
     8358           assign
     8359             Quantity = Quantity +  buff-stk-line.fact-qnty
     8360             Coast_R  = Coast_R  +  buff-stk-line.sum-rubl
     8361             Coast_V  = Coast_V  +  buff-stk-line.sum-base
     8362             VAT_R    = VAT_R    +  buff-stk-line.VAT-rubl
     8363             VAT_V    = VAT_V    +  buff-stk-line.VAT-base
     8364             SLT_R    = SLT_R    +  buff-stk-line.SLT-rubl
     8365             SLT_V    = SLT_V    +  buff-stk-line.SLT-base
     8366             other_R = other_R   +  buff-stk-line.other-rubl
     8367             other_V = other_V   +  buff-stk-line.other-base
     8368           .
     8369         end.
     8370       end.
     8371     end.
     8372   end procedure.
     8373   procedure ost-line-kg :
     8374     define  input parameter p-obj-code    like ub.stk-line.obj-code   no-undo .
     8375     define  input parameter p-obj-type    like ub.stk-line.obj-type   no-undo .
     8376     define  input parameter p-artic       like ub.stk-line.artic      no-undo .
     8377     define  input parameter p-prod-code   like ub.stk-line.prod-code  no-undo .
     8378     define  input parameter p-prod-type   like ub.stk-line.prod-type  no-undo .
     8379     define  input parameter p-fact-order  like ub.stk-line.fact-order no-undo .
     8380     define output parameter p-quantity-kg like ub.stk-line.fact-qnty  no-undo initial 0.00 .
     8381     define buffer buff-obj-list  for obj-list .
     8382     define buffer buf_doc-line for ub.doc-line .
     8383     define buffer buf_inv-line for ub.inv-line .
     8384     do
     8385     on error undo, return error
     8386     :
     8387       for each buf_doc-line no-lock where
     8388                buf_doc-line.obj-type    = p-obj-type   and
     8389                buf_doc-line.obj-code    = p-obj-code   and
     8390                buf_doc-line.prod-type   = p-prod-type  and
     8391                buf_doc-line.prod-code   = p-prod-code  and
     8392                buf_doc-line.artic       = p-artic      and
     8393                buf_doc-line.status_     = 'факт':U      and
     8394                buf_doc-line.fact-order <= p-fact-order
     8395             by buf_doc-line.fact-order    descending
     8396       :
     8397         find first buf_inv-line no-lock where
     8398                    buf_inv-line.doc-code  = buf_doc-line.doc-code  and
     8399                    buf_inv-line.artic     = buf_doc-line.artic     and
     8400                    buf_inv-line.prod-type = buf_doc-line.prod-type and
     8401                    buf_inv-line.prod-code = buf_doc-line.prod-code no-error .
     8402         if available buf_inv-line
     8403         then do:
     8404           if buf_inv-line.after-cli-qnty <> ?
     8405           then do:
     8406             assign
     8407               p-quantity-kg = buf_inv-line.after-cli-qnty
     8408             .
     8409             leave .
     8410           end.
     8411         end.
     8412       end.
     8413       if p-quantity-kg = ?
     8414       then do:
     8415         assign
     8416           p-quantity-kg = 0
     8417         .
     8418       end.
     8419     end.
     8420   end procedure.
