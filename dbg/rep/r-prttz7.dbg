     5227   Assign
     5228       l1f-wait-qnty  = c-f-wait-qnty:DATA-TYPE
     5229       l2f-wait-qnty  = c-f-wait-qnty:FORMAT
     5230       c-f-wait-qnty:DATA-TYPE = "CHARACTER"
     5231       c-f-wait-qnty:FORMAT    = "x(" + string(C-f-wait-qnty:WIDTH-CHARS) + ")"
     5232       c-f-wait-qnty:screen-value = string(ff)  .
     5233   End.
     5234   if c-f-rez-qnty <>  ?  then do :
     5235   Assign
     5236       l1f-rez-qnty  = c-f-rez-qnty:DATA-TYPE
     5237       l2f-rez-qnty  = c-f-rez-qnty:FORMAT
     5238       c-f-rez-qnty:DATA-TYPE = "CHARACTER"
     5239       c-f-rez-qnty:FORMAT    = "x(" + string(C-f-rez-qnty:WIDTH-CHARS) + ")"
     5240       c-f-rez-qnty:screen-value = string(ff)  .
     5241   End.
     5242   if c-f-rez-cost <>  ?  then do :
     5243   Assign
     5244       l1f-rez-cost  = c-f-rez-cost:DATA-TYPE
     5245       l2f-rez-cost  = c-f-rez-cost:FORMAT
     5246       c-f-rez-cost:DATA-TYPE = "CHARACTER"
     5247       c-f-rez-cost:FORMAT    = "x(" + string(C-f-rez-cost:WIDTH-CHARS) + ")"
     5248       c-f-rez-cost:screen-value = string(ff)  .
     5249   End.
     5250   if c-f-rez-sale <>  ?  then do :
     5251   Assign
     5252       l1f-rez-sale  = c-f-rez-sale:DATA-TYPE
     5253       l2f-rez-sale  = c-f-rez-sale:FORMAT
     5254       c-f-rez-sale:DATA-TYPE = "CHARACTER"
     5255       c-f-rez-sale:FORMAT    = "x(" + string(C-f-rez-sale:WIDTH-CHARS) + ")"
     5256       c-f-rez-sale:screen-value = string(ff)  .
     5257   End.
     5258   if c-f-rez-cost-pr <>  ?  then do :
     5259   Assign
     5260       l1f-rez-cost-pr  = c-f-rez-cost-pr:DATA-TYPE
     5261       l2f-rez-cost-pr  = c-f-rez-cost-pr:FORMAT
     5262       c-f-rez-cost-pr:DATA-TYPE = "CHARACTER"
     5263       c-f-rez-cost-pr:FORMAT    = "x(" + string(C-f-rez-cost-pr:WIDTH-CHARS) + ")"
     5264       c-f-rez-cost-pr:screen-value = string(ff)  .
     5265   End.
     5266     Display stream OutStream  with FRAME Zapas no-error .
     5267     DOWN stream OutStream  with FRAME Zapas .
     5268   if c-f-qnty <>  ?  then do :
     5269   Assign
     5270       c-f-qnty:DATA-TYPE = l1f-qnty
     5271       c-f-qnty:FORMAT    = l2f-qnty.
     5272   End.
     5273   if c-f-cost-pr <>  ?  then do :
     5274   Assign
     5275       c-f-cost-pr:DATA-TYPE = l1f-cost-pr
     5276       c-f-cost-pr:FORMAT    = l2f-cost-pr.
     5277   End.
     5278   if c-f-cost-sum <>  ?  then do :
     5279   Assign
     5280       c-f-cost-sum:DATA-TYPE = l1f-cost-sum
     5281       c-f-cost-sum:FORMAT    = l2f-cost-sum.
     5282   End.
     5283   if c-f-sale-pr <>  ?  then do :
     5284   Assign
     5285       c-f-sale-pr:DATA-TYPE = l1f-sale-pr
     5286       c-f-sale-pr:FORMAT    = l2f-sale-pr.
     5287   End.
     5288   if c-f-sale-sum <>  ?  then do :
     5289   Assign
     5290       c-f-sale-sum:DATA-TYPE = l1f-sale-sum
     5291       c-f-sale-sum:FORMAT    = l2f-sale-sum.
     5292   End.
     5293   if c-f-sale-other <>  ?  then do :
     5294   Assign
     5295       c-f-sale-other:DATA-TYPE = l1f-sale-other
     5296       c-f-sale-other:FORMAT    = l2f-sale-other.
     5297   End.
     5298   if c-f-free-qnty <>  ?  then do :
     5299   Assign
     5300       c-f-free-qnty:DATA-TYPE = l1f-free-qnty
     5301       c-f-free-qnty:FORMAT    = l2f-free-qnty.
     5302   End.
     5303   if c-f-wait-qnty <>  ?  then do :
     5304   Assign
     5305       c-f-wait-qnty:DATA-TYPE = l1f-wait-qnty
     5306       c-f-wait-qnty:FORMAT    = l2f-wait-qnty.
     5307   End.
     5308   if c-f-rez-qnty <>  ?  then do :
     5309   Assign
     5310       c-f-rez-qnty:DATA-TYPE = l1f-rez-qnty
     5311       c-f-rez-qnty:FORMAT    = l2f-rez-qnty.
     5312   End.
     5313   if c-f-rez-cost <>  ?  then do :
     5314   Assign
     5315       c-f-rez-cost:DATA-TYPE = l1f-rez-cost
     5316       c-f-rez-cost:FORMAT    = l2f-rez-cost.
     5317   End.
     5318   if c-f-rez-sale <>  ?  then do :
     5319   Assign
     5320       c-f-rez-sale:DATA-TYPE = l1f-rez-sale
     5321       c-f-rez-sale:FORMAT    = l2f-rez-sale.
     5322   End.
     5323   if c-f-rez-cost-pr <>  ?  then do :
     5324   Assign
     5325       c-f-rez-cost-pr:DATA-TYPE = l1f-rez-cost-pr
     5326       c-f-rez-cost-pr:FORMAT    = l2f-rez-cost-pr.
     5327   End.
     5328   End.
     5329   END PROCEDURE.
     5330   PROCEDURE CalcItog :
     5331   run ostatok  in this-procedure (
     5332       input x-store-code  ,
     5333       input x-store-type  , x-TOG-Shift,
     5334       input x-date-start - 1 ,
     5335       input date('')      , x-Shift-Start,x-Shift-End,
     5336       input 'crsa':U   ,
     5337       input '##,##':U,
     5338       input xTog-obj ,
     5339       output  Quantity1  ,
     5340       output  Coast_R1   ,
     5341       output  Coast_V1   ,
     5342       output  VAT_R1     ,
     5343       output  VAT_V1     ,
     5344       output  Fact-order-1 ).
     5345       Quantity1  = 0.
     5346       Coast_R1   = 0.
     5347       Coast_V1   = 0.
     5348       VAT_R1     = 0.
     5349       VAT_V1     = 0.
     5350   run ostatok  in this-procedure (
     5351       input x-store-code  ,
     5352       input x-store-type  , x-TOG-Shift,
     5353       input x-date-start ,
     5354       input x-date-end   , x-Shift-Start,x-Shift-End,
     5355       input 'crsa':U   ,
     5356       input '##,##':U,
     5357       input xTog-obj ,
     5358       output  Quantity1  ,
     5359       output  Coast_R1   ,
     5360       output  Coast_V1   ,
     5361       output  VAT_R1     ,
     5362       output  VAT_V1     ,
     5363       output  Fact-order-2 ).
     5364       Quantity1  = 0.
     5365       Coast_R1   = 0.
     5366       Coast_V1   = 0.
     5367       VAT_R1     = 0.
     5368       VAT_V1     = 0.
     5369   END PROCEDURE.
     5370   procedure foreach1t :
     5371   define variable pr-cursor as integer no-undo init 0.
     5372   define variable go-work   as logical no-undo init no.
     5373   .
     5374    For each obj-list ,
     5375        each gds-obj where
     5376             gds-obj.obj-code    = obj-list.obj-code and
     5377             gds-obj.obj-type    = obj-list.obj-type
     5378             no-lock,
     5379       first goods where
     5380             goods.prod-type = gds-obj.prod-type and
     5381             goods.prod-code = gds-obj.prod-code and
     5382             goods.artic     = gds-obj.artic  and
     5383             goods.gds-type    = 'т':U
     5384             no-lock
     5385             , first gds-list where
     5386                     gds-list.prod-type = gds-obj.prod-type and
     5387                     gds-list.prod-code = gds-obj.prod-code and
     5388                     gds-list.artic     = gds-obj.artic
     5389                     no-lock
     5390                   break
     5391                   by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     5392                    by gds-obj.prod-type
     5393                     by gds-obj.prod-code
     5394                      by gds-obj.artic
     5395                    with FRAME Zapas :
     5396                    pr-cursor = 0.
     5397                    go-work = false.
     5398                    if v-prizn = "" then go-work = true.
     5399                     else if goods.prt-root <> Prtroot then
     5400                     do while pr-cursor < num-entries(v-prizn,","):
     5401                         pr-cursor = pr-cursor + 1.
     5402                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5403                             for first prt-obj where
     5404                             prt-obj.artic     = goods.artic     and
     5405                             prt-obj.prod-type = goods.prod-type and
     5406                             prt-obj.prod-code = goods.prod-code and
     5407                             prt-obj.obj-code  = obj-list.obj-code and
     5408                             prt-obj.obj-type  = obj-list.obj-type and
     5409                             prt-obj.is-term   =  true  and
     5410                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5411                             no-lock:
     5412                                 pr-cursor = num-entries(v-prizn,",").
     5413                                 go-work = true.
     5414                             end.
     5415                         end.
     5416                     end.
     5417                     if go-work then do:
     5418                 n-nm = n-nm + 1.
     5419   IF ( n-nm modulo v-account = 0 )  then DO:
     5420             if  log-manager:logfile-name ne ?
     5421             then DO:
     5422                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5423             end.
     5424              if mFrameView
     5425              then do:
     5426               DISPLAY
     5427                 n-nm @ RecordsDone
     5428                 WITH FRAME InfoFrame.
     5429              end.
     5430   End.
     5431      if v-button-stop then  DO:
     5432            if mFrameView
     5433            then
     5434               PROCESS EVENTS.
     5435            IF StopProcessing THEN DO:
     5436            RETURN error.
     5437            End.
     5438      end.
     5439                 IF first-of(gds-obj.artic) then DO:
     5440                   assign
     5441                     f-qnty         = 0
     5442                     f-cost-sum     = 0
     5443                     f-sale-sum     = 0
     5444                     f-cost-pr      = 0
     5445                     f-sale-pr      = 0
     5446                     f-sale-other   = 0
     5447                     f-free-qnty    = 0
     5448                     f-wait-qnty    = 0
     5449                     f-rez-qnty     = 0
     5450                     f-rez-cost     = 0
     5451                     f-rez-sale     = 0
     5452                     f-rez-cost-pr  = 0
     5453                     tot-v-sale-sum = 0
     5454                     tot-v-cost-sum = 0
     5455                     .
     5456               End.
     5457   if last-of(gds-obj.artic) then DO:
     5458    IF v-var = "no-today" then DO:
     5459                  run ost-line in this-procedure
     5460                  (input   gds-obj.obj-code  ,
     5461                   input   gds-obj.obj-type  ,
     5462                   input   gds-obj.artic     ,
     5463                   input   gds-obj.prod-code ,
     5464                   input   gds-obj.prod-type ,
     5465                   input   0                 ,
     5466                   input   fact-order-2      ,
     5467                   input   'crsa':U       ,
     5468                   input   '##,##':U    ,
     5469                   input   false             ,
     5470                   output  quantity1         ,
     5471                   output  coast_r1          ,
     5472                   output  coast_v1          ,
     5473                   output  vat_r1            ,
     5474                   output  vat_v1            ,
     5475                   output  slt_r1            ,
     5476                   output  slt_v1            ).
     5477                Assign
     5478                   f-qnty       = Quantity1
     5479                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5480                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5481                   .
     5482                  run ost-line in this-procedure
     5483                  (input   gds-obj.obj-code  ,
     5484                   input   gds-obj.obj-type  ,
     5485                   input   gds-obj.artic     ,
     5486                   input   gds-obj.prod-code ,
     5487                   input   gds-obj.prod-type ,
     5488                   input   0                 ,
     5489                   input   fact-order-2      ,
     5490                   input   'cost':U       ,
     5491                   input   '##,##':U    ,
     5492                   input   false             ,
     5493                   output  quantity1   ,
     5494                   output  coast_r1  ,
     5495                   output  coast_v1  ,
     5496                   output  vat_r1    ,
     5497                   output  vat_v1    ,
     5498                   output  slt_r1    ,
     5499                   output  slt_v1    ).
     5500                Assign
     5501                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     5502                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     5503                   .
     5504   end.
     5505   else do:
     5506      empty temp-table t-trn-doc .
     5507      empty temp-table temp_gds-dtl .
     5508      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     5509        pr-cursor = 0.
     5510        f-qnty = 0.
     5511        do while pr-cursor < num-entries(v-prizn,","):
     5512            pr-cursor = pr-cursor + 1.
     5513            if entry(pr-cursor,v-prizn,",") <> "" then do:
     5514                for each sl-obj-list,
     5515                first buf_gds-obj no-lock where
     5516                buf_gds-obj.gds-code =  goods.gds-code and
     5517                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5518                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5519                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     5520                    and prt-obj.artic = buf_gds-obj.artic
     5521                    and prt-obj.obj-code = buf_gds-obj.obj-code
     5522                    and prt-obj.obj-type = buf_gds-obj.obj-type
     5523                    and prt-obj.is-term   =  true
     5524                    :
     5525                    assign
     5526                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     5527                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5528                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     5529                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     5530                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     5531                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     5532                       .
     5533                    end.
     5534                end.
     5535            end.
     5536        end.
     5537      end.
     5538      else do:
     5539          for each sl-obj-list,
     5540              first buf_gds-obj no-lock where
     5541                    buf_gds-obj.gds-code =  goods.gds-code and
     5542                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     5543                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     5544              assign
     5545               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     5546               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     5547               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     5548               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     5549               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     5550               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     5551             .
     5552       end.
     5553         for each buf_parts no-lock where
     5554                   buf_parts.artic      = buf_gds-obj.artic       and
     5555                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     5556                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     5557                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     5558                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     5559                   buf_parts.status_    = false               and
     5560                   buf_parts.rsrv-free  = true    ,
     5561           first bufi_trn-doc no-lock where
     5562                 bufi_trn-doc.doc-code = buf_parts.out-code
     5563                 and
     5564               ( bufi_trn-doc.doc-type = 'рас':U or
     5565                 bufi_trn-doc.doc-type = 'спи':U )
     5566                 :
     5567                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     5568                     create t-trn-doc.
     5569                     assign
     5570                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     5571                     .
     5572                 end.
     5573               end.
     5574      end.
     5575         for each t-trn-doc :
     5576             for each  bufd_gds-dtl no-lock where
     5577                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     5578                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     5579                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     5580                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     5581                 first buff_doc-line no-lock where
     5582                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     5583                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     5584                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     5585                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     5586                       :
     5587                       assign
     5588                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     5589                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     5590                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     5591                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     5592                       .
     5593                       create temp_gds-dtl.
     5594                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     5595                       assign
     5596                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     5597                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     5598                       .
     5599             end.
     5600      end.
     5601   end.
     5602                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     5603                 if c-f-wait-qnty <> ? Then DO :
     5604                  for each sl-obj-list :
     5605                   for each trn-doc no-lock  where
     5606                       trn-doc.obj-code        = sl-obj-list.obj-code and
     5607                       trn-doc.obj-type        = sl-obj-list.obj-type and
     5608                       trn-doc.status_         = 'накл':U           and
     5609                       trn-doc.flag_           = true              and
     5610                       trn-doc.Fact-order      <= fact-order-2     and
     5611                       trn-doc.ext-doc-type    = 'ie':U :
     5612                       for each doc-line no-lock where
     5613                           doc-line.doc-code   = trn-doc.doc-code   and
     5614                           doc-line.artic      = goods.artic        and
     5615                           doc-line.prod-code  = goods.prod-code    and
     5616                           doc-line.prod-type  = goods.prod-type    :
     5617                               Assign
     5618                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     5619                       end.
     5620                   End.
     5621                  End.
     5622                 End.
     5623                if itog = false and
     5624                ( p-zero-ost = true or
     5625                   not(f-qnty         = 0 and
     5626                       f-cost-sum     = 0 and
     5627                       f-sale-sum     = 0 and
     5628                       f-sale-other   = 0 and
     5629                       f-free-qnty    = 0 and
     5630                       f-wait-qnty    = 0  ))
     5631                   Then DO:
     5632                       n-nn = n-nn + 1 .
     5633   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     5634     (input  goods.gds-code
     5635     ,input  ?
     5636     ,output v-bar-code
     5637     )  .
     5638     if c-nn <>  ?  then do :
     5639       c-nn:screen-value = string(string(n-nn)) .
     5640       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5641           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5642           display STREAM OutStream    with frame top-frame .
     5643       End.
     5644     End.
     5645     if c-f-artic <>  ?  then do :
     5646       c-f-artic:screen-value = string(gds-obj.artic) .
     5647       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5648           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5649           display STREAM OutStream    with frame top-frame .
     5650       End.
     5651     End.
     5652     if c-f-b-code <>  ?  then do :
     5653       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     5654       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5655           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5656           display STREAM OutStream    with frame top-frame .
     5657       End.
     5658     End.
     5659     if c-f-gds-name <>  ?  then do :
     5660       c-f-gds-name:screen-value = string(goods.gds-name) .
     5661       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5662           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5663           display STREAM OutStream    with frame top-frame .
     5664       End.
     5665     End.
     5666     if c-f-qnty <>  ?  then do :
     5667       c-f-qnty:screen-value = string(f-qnty) .
     5668       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
