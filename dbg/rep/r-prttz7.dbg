     8459       define variable varvatcons-base-factovp-prl  like ub.gds-dtl.price-base               no-undo.
     8460       define variable vardsc-base-factovp-prl      like ub.gds-dtl.price-base               no-undo.
     8461       define variable varsum-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8462       define variable varslt-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
     8463       define variable varvat-base-docovp-prl       like ub.gds-dtl.price-base               no-undo.
