     6502           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6503           display STREAM OutStream    with frame top-frame .
     6504       End.
     6505     End.
     6506     if c-f-rez-cost <>  ?  then do :
     6507       c-f-rez-cost:screen-value = string(accum TOTAL f-rez-cost) .
     6508       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6509           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6510           display STREAM OutStream    with frame top-frame .
     6511       End.
     6512     End.
     6513     if c-f-rez-sale <>  ?  then do :
     6514       c-f-rez-sale:screen-value = string(accum TOTAL f-rez-sale) .
     6515       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6516           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6517           display STREAM OutStream    with frame top-frame .
     6518       End.
     6519     End.
     6520   dIsplay stream OutStream with FRAME Zapas no-error .
     6521   down stream OutStream with FRAME Zapas.
     6522   run u-line in this-procedure.
     6523   if Make-Excel then  put   stream ForExcel unformatted
     6524   "ИТОГО"                       CHR(9)
     6525   "ПО ВСЕМ ОБЬЕКТАМ"            CHR(9) CHR(9) CHR(9)
     6526    CHR(9)
     6527   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     6528   CHR(9)
     6529   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     6530   CHR(9)
     6531   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     6532   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     6533   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     6534   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     6535   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     6536   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     6537   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     6538   chr(10) .
     6539   end procedure.
     6540   procedure foreach3t :
     6541   define variable pr-cursor as integer no-undo init 0.
     6542   define variable go-work   as logical no-undo init no.
     6543   .
     6544    For each obj-list ,
     6545        each gds-obj where
     6546             gds-obj.obj-code    = obj-list.obj-code and
     6547             gds-obj.obj-type    = obj-list.obj-type
     6548             no-lock,
     6549       first goods where
     6550             goods.prod-type = gds-obj.prod-type and
     6551             goods.prod-code = gds-obj.prod-code and
     6552             goods.artic     = gds-obj.artic  and
     6553             goods.gds-type    = 'т':U
     6554             no-lock
     6555             , first gds-list where
     6556                     gds-list.prod-type = gds-obj.prod-type and
     6557                     gds-list.prod-code = gds-obj.prod-code and
     6558                     gds-list.artic     = gds-obj.artic
     6559                     no-lock
     6560                   break
     6561                   by goods.grp-name
     6562                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     6563                     by gds-obj.artic
     6564                    with FRAME Zapas :
     6565                    pr-cursor = 0.
     6566                    go-work = false.
     6567                    if v-prizn = "" then go-work = true.
     6568                     else if goods.prt-root <> Prtroot then
     6569                     do while pr-cursor < num-entries(v-prizn,","):
     6570                         pr-cursor = pr-cursor + 1.
     6571                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     6572                             for first prt-obj where
     6573                             prt-obj.artic     = goods.artic     and
     6574                             prt-obj.prod-type = goods.prod-type and
     6575                             prt-obj.prod-code = goods.prod-code and
     6576                             prt-obj.obj-code  = obj-list.obj-code and
     6577                             prt-obj.obj-type  = obj-list.obj-type and
     6578                             prt-obj.is-term   =  true  and
     6579                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     6580                             no-lock:
     6581                                 pr-cursor = num-entries(v-prizn,",").
     6582                                 go-work = true.
     6583                             end.
     6584                         end.
     6585                     end.
     6586                     if go-work then do:
     6587                 n-nm = n-nm + 1.
     6588   IF ( n-nm modulo v-account = 0 )  then DO:
     6589             if  log-manager:logfile-name ne ?
     6590             then DO:
     6591                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     6592             end.
     6593              if mFrameView
     6594              then do:
     6595               DISPLAY
     6596                 n-nm @ RecordsDone
     6597                 WITH FRAME InfoFrame.
     6598              end.
     6599   End.
     6600      if v-button-stop then  DO:
     6601            if mFrameView
     6602            then
     6603               PROCESS EVENTS.
     6604            IF StopProcessing THEN DO:
     6605            RETURN error.
     6606            End.
     6607      end.
     6608                 IF first-of(gds-obj.artic) then DO:
     6609                   assign
     6610                     f-qnty         = 0
     6611                     f-cost-sum     = 0
     6612                     f-sale-sum     = 0
     6613                     f-cost-pr      = 0
     6614                     f-sale-pr      = 0
     6615                     f-sale-other   = 0
     6616                     f-free-qnty    = 0
     6617                     f-wait-qnty    = 0
     6618                     f-rez-qnty     = 0
     6619                     f-rez-cost     = 0
     6620                     f-rez-sale     = 0
     6621                     f-rez-cost-pr  = 0
     6622                     tot-v-sale-sum = 0
     6623                     tot-v-cost-sum = 0
     6624                     .
     6625               End.
     6626             if first-of(goods.grp-name) then  DO:
     6627                var-client = goods.grp-name.
     6628                     if  Itog = false Then do:
     6629                       PUT stream OutStream  goods.grp-name  AT 1 format "X(160)" SKIP.
     6630                       DOWN stream OutStream .
     6631                       if Make-Excel then  put   stream ForExcel unformatted goods.grp-name chr(10) .
     6632                     End.
     6633             End.
     6634   if last-of(gds-obj.artic) then DO:
     6635    IF v-var = "no-today" then DO:
     6636                  run ost-line in this-procedure
     6637                  (input   gds-obj.obj-code  ,
     6638                   input   gds-obj.obj-type  ,
     6639                   input   gds-obj.artic     ,
     6640                   input   gds-obj.prod-code ,
     6641                   input   gds-obj.prod-type ,
     6642                   input   0                 ,
     6643                   input   fact-order-2      ,
     6644                   input   'crsa':U       ,
     6645                   input   '##,##':U    ,
     6646                   input   false             ,
     6647                   output  quantity1         ,
     6648                   output  coast_r1          ,
     6649                   output  coast_v1          ,
     6650                   output  vat_r1            ,
     6651                   output  vat_v1            ,
     6652                   output  slt_r1            ,
     6653                   output  slt_v1            ).
     6654                Assign
     6655                   f-qnty       = Quantity1
     6656                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6657                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6658                   .
     6659                  run ost-line in this-procedure
     6660                  (input   gds-obj.obj-code  ,
     6661                   input   gds-obj.obj-type  ,
     6662                   input   gds-obj.artic     ,
     6663                   input   gds-obj.prod-code ,
     6664                   input   gds-obj.prod-type ,
     6665                   input   0                 ,
     6666                   input   fact-order-2      ,
     6667                   input   'cost':U       ,
     6668                   input   '##,##':U    ,
     6669                   input   false             ,
     6670                   output  quantity1   ,
     6671                   output  coast_r1  ,
     6672                   output  coast_v1  ,
     6673                   output  vat_r1    ,
     6674                   output  vat_v1    ,
     6675                   output  slt_r1    ,
     6676                   output  slt_v1    ).
     6677                Assign
     6678                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6679                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6680                   .
     6681   end.
     6682   else do:
     6683      empty temp-table t-trn-doc .
     6684      empty temp-table temp_gds-dtl .
     6685      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6686        pr-cursor = 0.
     6687        f-qnty = 0.
     6688        do while pr-cursor < num-entries(v-prizn,","):
     6689            pr-cursor = pr-cursor + 1.
     6690            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6691                for each sl-obj-list,
     6692                first buf_gds-obj no-lock where
     6693                buf_gds-obj.gds-code =  goods.gds-code and
     6694                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6695                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6696                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6697                    and prt-obj.artic = buf_gds-obj.artic
     6698                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6699                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6700                    and prt-obj.is-term   =  true
     6701                    :
     6702                    assign
     6703                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6704                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6705                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6706                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6707                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6708                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6709                       .
     6710                    end.
     6711                end.
     6712            end.
     6713        end.
     6714      end.
     6715      else do:
     6716          for each sl-obj-list,
     6717              first buf_gds-obj no-lock where
     6718                    buf_gds-obj.gds-code =  goods.gds-code and
     6719                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6720                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6721              assign
     6722               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6723               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6724               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6725               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6726               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6727               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6728             .
     6729       end.
     6730         for each buf_parts no-lock where
     6731                   buf_parts.artic      = buf_gds-obj.artic       and
     6732                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     6733                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     6734                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     6735                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     6736                   buf_parts.status_    = false               and
     6737                   buf_parts.rsrv-free  = true    ,
     6738           first bufi_trn-doc no-lock where
     6739                 bufi_trn-doc.doc-code = buf_parts.out-code
     6740                 and
     6741               ( bufi_trn-doc.doc-type = 'рас':U or
     6742                 bufi_trn-doc.doc-type = 'спи':U )
     6743                 :
     6744                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     6745                     create t-trn-doc.
     6746                     assign
     6747                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     6748                     .
     6749                 end.
     6750               end.
     6751      end.
     6752         for each t-trn-doc :
     6753             for each  bufd_gds-dtl no-lock where
     6754                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     6755                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     6756                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     6757                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     6758                 first buff_doc-line no-lock where
     6759                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     6760                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     6761                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     6762                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     6763                       :
     6764                       assign
     6765                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     6766                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     6767                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     6768                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     6769                       .
     6770                       create temp_gds-dtl.
     6771                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     6772                       assign
     6773                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     6774                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     6775                       .
     6776             end.
     6777      end.
     6778   end.
     6779                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     6780                 if c-f-wait-qnty <> ? Then DO :
     6781                  for each sl-obj-list :
     6782                   for each trn-doc no-lock  where
     6783                       trn-doc.obj-code        = sl-obj-list.obj-code and
     6784                       trn-doc.obj-type        = sl-obj-list.obj-type and
     6785                       trn-doc.status_         = 'накл':U           and
     6786                       trn-doc.flag_           = true              and
     6787                       trn-doc.Fact-order      <= fact-order-2     and
     6788                       trn-doc.ext-doc-type    = 'ie':U :
     6789                       for each doc-line no-lock where
     6790                           doc-line.doc-code   = trn-doc.doc-code   and
     6791                           doc-line.artic      = goods.artic        and
     6792                           doc-line.prod-code  = goods.prod-code    and
     6793                           doc-line.prod-type  = goods.prod-type    :
     6794                               Assign
     6795                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     6796                       end.
     6797                   End.
     6798                  End.
     6799                 End.
     6800                if itog = false and
     6801                ( p-zero-ost = true or
     6802                   not(f-qnty         = 0 and
     6803                       f-cost-sum     = 0 and
     6804                       f-sale-sum     = 0 and
     6805                       f-sale-other   = 0 and
     6806                       f-free-qnty    = 0 and
     6807                       f-wait-qnty    = 0  ))
     6808                   Then DO:
     6809                       n-nn = n-nn + 1 .
     6810   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     6811     (input  goods.gds-code
     6812     ,input  ?
     6813     ,output v-bar-code
     6814     )  .
     6815     if c-nn <>  ?  then do :
     6816       c-nn:screen-value = string(string(n-nn)) .
     6817       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6818           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6819           display STREAM OutStream    with frame top-frame .
     6820       End.
     6821     End.
     6822     if c-f-artic <>  ?  then do :
     6823       c-f-artic:screen-value = string(gds-obj.artic) .
     6824       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6825           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6826           display STREAM OutStream    with frame top-frame .
     6827       End.
     6828     End.
     6829     if c-f-b-code <>  ?  then do :
     6830       c-f-b-code:screen-value = string(string(v-bar-code,'999999999')) .
     6831       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6832           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6833           display STREAM OutStream    with frame top-frame .
     6834       End.
     6835     End.
     6836     if c-f-gds-name <>  ?  then do :
     6837       c-f-gds-name:screen-value = string(goods.gds-name) .
     6838       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6839           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6840           display STREAM OutStream    with frame top-frame .
     6841       End.
     6842     End.
     6843     if c-f-qnty <>  ?  then do :
     6844       c-f-qnty:screen-value = string(f-qnty) .
     6845       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6846           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6847           display STREAM OutStream    with frame top-frame .
     6848       End.
     6849     End.
     6850     if c-f-cost-pr <>  ?  then do :
     6851       c-f-cost-pr:screen-value = string(f-cost-pr) .
     6852       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6853           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6854           display STREAM OutStream    with frame top-frame .
     6855       End.
     6856     End.
     6857     if c-f-cost-sum <>  ?  then do :
     6858       c-f-cost-sum:screen-value = string(f-cost-sum) .
     6859       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6860           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6861           display STREAM OutStream    with frame top-frame .
     6862       End.
     6863     End.
     6864     if c-f-sale-pr <>  ?  then do :
     6865       c-f-sale-pr:screen-value = string(f-sale-pr) .
     6866       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6867           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6868           display STREAM OutStream    with frame top-frame .
     6869       End.
     6870     End.
     6871     if c-f-sale-sum <>  ?  then do :
     6872       c-f-sale-sum:screen-value = string(f-sale-sum) .
     6873       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6874           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6875           display STREAM OutStream    with frame top-frame .
     6876       End.
     6877     End.
     6878     if c-f-sale-other <>  ?  then do :
     6879       c-f-sale-other:screen-value = string(f-sale-other) .
     6880       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6881           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6882           display STREAM OutStream    with frame top-frame .
     6883       End.
     6884     End.
     6885     if c-f-free-qnty <>  ?  then do :
     6886       c-f-free-qnty:screen-value = string(f-free-qnty) .
     6887       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6888           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6889           display STREAM OutStream    with frame top-frame .
     6890       End.
     6891     End.
     6892     if c-f-wait-qnty <>  ?  then do :
     6893       c-f-wait-qnty:screen-value = string(f-wait-qnty) .
     6894       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6895           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6896           display STREAM OutStream    with frame top-frame .
     6897       End.
     6898     End.
     6899     if c-f-rez-qnty <>  ?  then do :
     6900       c-f-rez-qnty:screen-value = string(f-rez-qnty) .
     6901       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     6902           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     6903           display STREAM OutStream    with frame top-frame .
     6904       End.
     6905     End.
     6906     if c-f-rez-cost <>  ?  then do :
     6907       c-f-rez-cost:screen-value = string(f-rez-cost) .
     6908       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
