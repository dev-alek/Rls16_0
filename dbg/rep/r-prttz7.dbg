     5768                        excel-sum (f-rez-sale   )         CHR(9)
     5769                        excel-sum (f-rez-cost-pr)         CHR(9)
     5770                        chr(10) .
     5771                        run display-prt-t in this-procedure  .
     5772                End.
     5773                 accumulate f-qnty           (TOTAL ) .
     5774                 accumulate f-cost-sum       (TOTAL ) .
     5775                 accumulate f-sale-sum       (TOTAL ) .
     5776                 accumulate f-sale-other     (TOTAL ) .
     5777                 accumulate f-free-qnty      (TOTAL ) .
     5778                 accumulate f-wait-qnty      (TOTAL ) .
     5779       accumulate f-rez-qnty   (TOTAL ) .
     5780       accumulate f-rez-cost   (TOTAL ) .
     5781       accumulate f-rez-sale   (TOTAL ) .
     5782         Assign
     5783           f-qnty          = 0
     5784           f-cost-sum      = 0
     5785           f-sale-sum      = 0
     5786           f-sale-other    = 0
     5787           f-free-qnty     = 0
     5788           f-wait-qnty     = 0
     5789           f-rez-qnty      = 0
     5790           f-rez-cost      = 0
     5791           f-rez-sale      = 0
     5792           .
     5793    End.
     5794   end.
     5795   End.
     5796   run u-line in this-procedure.
     5797     if c-nn <>  ?  then do :
     5798       c-nn:screen-value = string('ИТОГО') .
     5799       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5800           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
