     7451                           doc-line.prod-code  = goods.prod-code    and
     7452                           doc-line.prod-type  = goods.prod-type    :
     7453                               Assign
     7454                                 f-wait-qnty   = f-wait-qnty     + doc-line.fact-qnty.
     7455                       end.
     7456                   End.
     7457                  End.
     7458                 End.
     7459                if itog = false and
     7460                ( p-zero-ost = true or
