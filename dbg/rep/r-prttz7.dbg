     5880    CHR(9)
     5881   excel-qnty(accum TOTAL f-qnty           )   CHR(9)
     5882   CHR(9)
     5883   excel-sum (accum TOTAL f-cost-sum       )   CHR(9)
     5884   CHR(9)
     5885   excel-sum (accum TOTAL f-sale-sum       )   CHR(9)
     5886   excel-sum (accum TOTAL f-sale-other     )   CHR(9)
     5887   excel-sum (accum TOTAL f-free-qnty      )   CHR(9)
     5888   excel-sum (accum TOTAL f-wait-qnty      )   CHR(9)
     5889   excel-sum (accum TOTAL f-rez-qnty   )   CHR(9)
     5890   excel-sum (accum TOTAL f-rez-cost   )   CHR(9)
     5891   excel-sum (accum TOTAL f-rez-sale   )   CHR(9)
     5892   chr(10) .
     5893   end procedure.
     5894   procedure foreach2t :
     5895   define variable pr-cursor as integer no-undo init 0.
     5896   define variable go-work   as logical no-undo init no.
     5897   .
     5898    For each obj-list ,
     5899        each gds-obj where
     5900             gds-obj.obj-code    = obj-list.obj-code and
     5901             gds-obj.obj-type    = obj-list.obj-type
     5902             no-lock,
     5903       first goods where
     5904             goods.prod-type = gds-obj.prod-type and
     5905             goods.prod-code = gds-obj.prod-code and
     5906             goods.artic     = gds-obj.artic  and
     5907             goods.gds-type    = 'т':U
     5908             no-lock
     5909             , first gds-list where
     5910                     gds-list.prod-type = gds-obj.prod-type and
     5911                     gds-list.prod-code = gds-obj.prod-code and
     5912                     gds-list.artic     = gds-obj.artic
     5913                     no-lock
     5914                   break
     5915                   by gds-obj.prod-type
     5916                    by gds-obj.prod-code
     5917                     by gds-obj.artic
     5918                    with FRAME Zapas :
     5919                    pr-cursor = 0.
     5920                    go-work = false.
     5921                    if v-prizn = "" then go-work = true.
     5922                     else if goods.prt-root <> Prtroot then
     5923                     do while pr-cursor < num-entries(v-prizn,","):
     5924                         pr-cursor = pr-cursor + 1.
     5925                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     5926                             for first prt-obj where
     5927                             prt-obj.artic     = goods.artic     and
     5928                             prt-obj.prod-type = goods.prod-type and
     5929                             prt-obj.prod-code = goods.prod-code and
     5930                             prt-obj.obj-code  = obj-list.obj-code and
     5931                             prt-obj.obj-type  = obj-list.obj-type and
     5932                             prt-obj.is-term   =  true  and
     5933                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     5934                             no-lock:
     5935                                 pr-cursor = num-entries(v-prizn,",").
     5936                                 go-work = true.
     5937                             end.
     5938                         end.
     5939                     end.
     5940                     if go-work then do:
     5941                 n-nm = n-nm + 1.
     5942   IF ( n-nm modulo v-account = 0 )  then DO:
     5943             if  log-manager:logfile-name ne ?
     5944             then DO:
     5945                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     5946             end.
     5947              if mFrameView
     5948              then do:
     5949               DISPLAY
     5950                 n-nm @ RecordsDone
     5951                 WITH FRAME InfoFrame.
     5952              end.
     5953   End.
     5954      if v-button-stop then  DO:
     5955            if mFrameView
     5956            then
     5957               PROCESS EVENTS.
     5958            IF StopProcessing THEN DO:
     5959            RETURN error.
     5960            End.
     5961      end.
     5962                 IF first-of(gds-obj.artic) then DO:
     5963                   assign
     5964                     f-qnty         = 0
     5965                     f-cost-sum     = 0
     5966                     f-sale-sum     = 0
     5967                     f-cost-pr      = 0
     5968                     f-sale-pr      = 0
     5969                     f-sale-other   = 0
     5970                     f-free-qnty    = 0
     5971                     f-wait-qnty    = 0
     5972                     f-rez-qnty     = 0
     5973                     f-rez-cost     = 0
     5974                     f-rez-sale     = 0
     5975                     f-rez-cost-pr  = 0
     5976                     tot-v-sale-sum = 0
     5977                     tot-v-cost-sum = 0
     5978                     .
     5979               End.
     5980             if first-of(gds-obj.prod-code)  and classify = 2 then DO:
     5981                 FIND FIRST clients-p where  gds-obj.prod-type = clients-p.obj-type AND
     5982                                             gds-obj.prod-code = clients-p.obj-code no-lock no-error.
     5983                  if avail clients-p then var-client = Clients-p.obj-name.
     5984                     if  Itog = false Then do:
     5985     if c-f-gds-name <>  ?  then do :
     5986       c-f-gds-name:screen-value = string(var-client) .
     5987       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     5988           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     5989           display STREAM OutStream    with frame top-frame .
     5990       End.
     5991     End.
     5992                       Display stream OutStream .
     5993                       DOWN stream OutStream .
     5994                       if Make-Excel then  put   stream ForExcel unformatted var-client chr(10) .
     5995                     End.
     5996             End.
     5997   if last-of(gds-obj.artic) then DO:
     5998    IF v-var = "no-today" then DO:
     5999                  run ost-line in this-procedure
     6000                  (input   gds-obj.obj-code  ,
     6001                   input   gds-obj.obj-type  ,
     6002                   input   gds-obj.artic     ,
     6003                   input   gds-obj.prod-code ,
     6004                   input   gds-obj.prod-type ,
     6005                   input   0                 ,
     6006                   input   fact-order-2      ,
     6007                   input   'crsa':U       ,
     6008                   input   '##,##':U    ,
     6009                   input   false             ,
     6010                   output  quantity1         ,
     6011                   output  coast_r1          ,
     6012                   output  coast_v1          ,
     6013                   output  vat_r1            ,
     6014                   output  vat_v1            ,
     6015                   output  slt_r1            ,
     6016                   output  slt_v1            ).
     6017                Assign
     6018                   f-qnty       = Quantity1
     6019                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6020                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6021                   .
     6022                  run ost-line in this-procedure
     6023                  (input   gds-obj.obj-code  ,
     6024                   input   gds-obj.obj-type  ,
     6025                   input   gds-obj.artic     ,
     6026                   input   gds-obj.prod-code ,
     6027                   input   gds-obj.prod-type ,
     6028                   input   0                 ,
     6029                   input   fact-order-2      ,
     6030                   input   'cost':U       ,
     6031                   input   '##,##':U    ,
     6032                   input   false             ,
     6033                   output  quantity1   ,
     6034                   output  coast_r1  ,
     6035                   output  coast_v1  ,
     6036                   output  vat_r1    ,
     6037                   output  vat_v1    ,
     6038                   output  slt_r1    ,
     6039                   output  slt_v1    ).
     6040                Assign
     6041                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     6042                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     6043                   .
     6044   end.
     6045   else do:
     6046      empty temp-table t-trn-doc .
     6047      empty temp-table temp_gds-dtl .
     6048      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     6049        pr-cursor = 0.
     6050        f-qnty = 0.
     6051        do while pr-cursor < num-entries(v-prizn,","):
     6052            pr-cursor = pr-cursor + 1.
     6053            if entry(pr-cursor,v-prizn,",") <> "" then do:
     6054                for each sl-obj-list,
     6055                first buf_gds-obj no-lock where
     6056                buf_gds-obj.gds-code =  goods.gds-code and
     6057                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6058                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6059                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     6060                    and prt-obj.artic = buf_gds-obj.artic
     6061                    and prt-obj.obj-code = buf_gds-obj.obj-code
     6062                    and prt-obj.obj-type = buf_gds-obj.obj-type
     6063                    and prt-obj.is-term   =  true
     6064                    :
     6065                    assign
     6066                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     6067                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6068                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     6069                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     6070                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     6071                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     6072                       .
     6073                    end.
     6074                end.
     6075            end.
     6076        end.
     6077      end.
     6078      else do:
     6079          for each sl-obj-list,
     6080              first buf_gds-obj no-lock where
     6081                    buf_gds-obj.gds-code =  goods.gds-code and
     6082                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     6083                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     6084              assign
     6085               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     6086               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     6087               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     6088               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     6089               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     6090               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     6091             .
     6092       end.
     6093         for each buf_parts no-lock where
     6094                   buf_parts.artic      = buf_gds-obj.artic       and
     6095                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     6096                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     6097                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     6098                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     6099                   buf_parts.status_    = false               and
     6100                   buf_parts.rsrv-free  = true    ,
     6101           first bufi_trn-doc no-lock where
     6102                 bufi_trn-doc.doc-code = buf_parts.out-code
     6103                 and
     6104               ( bufi_trn-doc.doc-type = 'рас':U or
     6105                 bufi_trn-doc.doc-type = 'спи':U )
