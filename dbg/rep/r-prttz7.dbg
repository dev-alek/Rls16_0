     7177   procedure foreach4t :
     7178   define variable pr-cursor as integer no-undo init 0.
     7179   define variable go-work   as logical no-undo init no.
     7180    For Each gds-obj no-lock  where
     7181             gds-obj.obj-code    = obj-list.obj-code and
     7182             gds-obj.obj-type    = obj-list.obj-type,
     7183             first goods no-lock where
     7184                   goods.prod-type = gds-obj.prod-type and
     7185                   goods.prod-code = gds-obj.prod-code and
     7186                   goods.artic     = gds-obj.artic
     7187                   :
     7188        find first gds-list where gds-list.gds-code = gds-obj.gds-code  no-error .
     7189        if not available  gds-list then create gds-list .
     7190        buffer-copy goods to gds-list
     7191        assign
     7192          gds-list.qnty = func-vat ( input gds-obj.gds-code , input gds-obj.obj-type, input gds-obj.obj-code)
     7193        .
     7194    end.
     7195   .
     7196    For each obj-list ,
     7197        each gds-obj where
     7198             gds-obj.obj-code    = obj-list.obj-code and
     7199             gds-obj.obj-type    = obj-list.obj-type
     7200             no-lock,
     7201       first goods where
     7202             goods.prod-type = gds-obj.prod-type and
     7203             goods.prod-code = gds-obj.prod-code and
     7204             goods.artic     = gds-obj.artic  and
     7205             goods.gds-type    = 'т':U
     7206             no-lock
     7207             , first gds-list where
     7208                     gds-list.prod-type = gds-obj.prod-type and
     7209                     gds-list.prod-code = gds-obj.prod-code and
     7210                     gds-list.artic     = gds-obj.artic
     7211                     no-lock
     7212                   break
     7213                   by gds-list.qnty
     7214                    by ( gds-obj.artic + gds-obj.prod-type + string ( gds-obj.prod-code ))
     7215                     by gds-obj.artic
     7216                    with FRAME Zapas :
     7217                    pr-cursor = 0.
     7218                    go-work = false.
     7219                    if v-prizn = "" then go-work = true.
     7220                     else if goods.prt-root <> Prtroot then
     7221                     do while pr-cursor < num-entries(v-prizn,","):
     7222                         pr-cursor = pr-cursor + 1.
     7223                         if entry(pr-cursor,v-prizn,",") <> "" then do:
     7224                             for first prt-obj where
     7225                             prt-obj.artic     = goods.artic     and
     7226                             prt-obj.prod-type = goods.prod-type and
     7227                             prt-obj.prod-code = goods.prod-code and
     7228                             prt-obj.obj-code  = obj-list.obj-code and
     7229                             prt-obj.obj-type  = obj-list.obj-type and
     7230                             prt-obj.is-term   =  true  and
     7231                             prt-obj.prt-code  = integer(entry(pr-cursor,v-prizn,","))
     7232                             no-lock:
     7233                                 pr-cursor = num-entries(v-prizn,",").
     7234                                 go-work = true.
     7235                             end.
     7236                         end.
     7237                     end.
     7238                     if go-work then do:
     7239                 n-nm = n-nm + 1.
     7240   IF ( n-nm modulo v-account = 0 )  then DO:
     7241             if  log-manager:logfile-name ne ?
     7242             then DO:
     7243                 log-manager:write-message("DISP mFrameView=" + string(mFrameView), "frameRepError").
     7244             end.
     7245              if mFrameView
     7246              then do:
     7247               DISPLAY
     7248                 n-nm @ RecordsDone
     7249                 WITH FRAME InfoFrame.
     7250              end.
     7251   End.
     7252      if v-button-stop then  DO:
     7253            if mFrameView
     7254            then
     7255               PROCESS EVENTS.
     7256            IF StopProcessing THEN DO:
     7257            RETURN error.
     7258            End.
     7259      end.
     7260                 IF first-of(gds-obj.artic) then DO:
     7261                   assign
     7262                     f-qnty         = 0
     7263                     f-cost-sum     = 0
     7264                     f-sale-sum     = 0
     7265                     f-cost-pr      = 0
     7266                     f-sale-pr      = 0
     7267                     f-sale-other   = 0
     7268                     f-free-qnty    = 0
     7269                     f-wait-qnty    = 0
     7270                     f-rez-qnty     = 0
     7271                     f-rez-cost     = 0
     7272                     f-rez-sale     = 0
     7273                     f-rez-cost-pr  = 0
     7274                     tot-v-sale-sum = 0
     7275                     tot-v-cost-sum = 0
     7276                     .
     7277               End.
     7278       if first-of(gds-list.qnty) then do:
     7279           var-client = string(gds-list.qnty) + '%'.
     7280           if  itog = false then do:
     7281     if c-f-gds-name <>  ?  then do :
     7282       c-f-gds-name:screen-value = string('Ставка НДС ' + string(gds-list.qnty) + '%') .
     7283       IF ( line-counter( OutStream )  modulo page-size( OutStream ) = 0 ) AND
     7284           ( line-counter( OutStream ) >= page-size( OutStream ) )          then DO:
     7285           display STREAM OutStream    with frame top-frame .
     7286       End.
     7287     End.
     7288             display stream outstream .
     7289             down stream outstream .
     7290             if Make-Excel then  put   stream ForExcel unformatted 'Ставка НДС ' + string(gds-list.qnty) + '%' chr(10) .
     7291           end.
     7292       end.
     7293   if last-of(gds-obj.artic) then DO:
     7294    IF v-var = "no-today" then DO:
     7295                  run ost-line in this-procedure
     7296                  (input   gds-obj.obj-code  ,
     7297                   input   gds-obj.obj-type  ,
     7298                   input   gds-obj.artic     ,
     7299                   input   gds-obj.prod-code ,
     7300                   input   gds-obj.prod-type ,
     7301                   input   0                 ,
     7302                   input   fact-order-2      ,
     7303                   input   'crsa':U       ,
     7304                   input   '##,##':U    ,
     7305                   input   false             ,
     7306                   output  quantity1         ,
     7307                   output  coast_r1          ,
     7308                   output  coast_v1          ,
     7309                   output  vat_r1            ,
     7310                   output  vat_v1            ,
     7311                   output  slt_r1            ,
     7312                   output  slt_v1            ).
     7313                Assign
     7314                   f-qnty       = Quantity1
     7315                   f-sale-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7316                   f-sale-pr    = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7317                   .
     7318                  run ost-line in this-procedure
     7319                  (input   gds-obj.obj-code  ,
     7320                   input   gds-obj.obj-type  ,
     7321                   input   gds-obj.artic     ,
     7322                   input   gds-obj.prod-code ,
     7323                   input   gds-obj.prod-type ,
     7324                   input   0                 ,
     7325                   input   fact-order-2      ,
     7326                   input   'cost':U       ,
     7327                   input   '##,##':U    ,
     7328                   input   false             ,
     7329                   output  quantity1   ,
     7330                   output  coast_r1  ,
     7331                   output  coast_v1  ,
     7332                   output  vat_r1    ,
     7333                   output  vat_v1    ,
     7334                   output  slt_r1    ,
     7335                   output  slt_v1    ).
     7336                Assign
     7337                   f-cost-sum   = if tprintrubl then Coast_R1 else Coast_V1
     7338                   f-cost-pr    = if Quantity1 = 0 then 0 else ( f-cost-sum / Quantity1 )
     7339                   .
     7340   end.
     7341   else do:
     7342      empty temp-table t-trn-doc .
     7343      empty temp-table temp_gds-dtl .
     7344      if v-prizn <> "" and goods.prt-root <> Prtroot then do:
     7345        pr-cursor = 0.
     7346        f-qnty = 0.
     7347        do while pr-cursor < num-entries(v-prizn,","):
     7348            pr-cursor = pr-cursor + 1.
     7349            if entry(pr-cursor,v-prizn,",") <> "" then do:
     7350                for each sl-obj-list,
     7351                first buf_gds-obj no-lock where
     7352                buf_gds-obj.gds-code =  goods.gds-code and
     7353                buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7354                buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7355                    for each prt-obj no-lock where prt-obj.prt-code = integer(entry(pr-cursor,v-prizn,","))
     7356                    and prt-obj.artic = buf_gds-obj.artic
     7357                    and prt-obj.obj-code = buf_gds-obj.obj-code
     7358                    and prt-obj.obj-type = buf_gds-obj.obj-type
     7359                    and prt-obj.is-term   =  true
     7360                    :
     7361                    assign
     7362                       f-qnty       =  f-qnty + prt-obj.fact-qnty
     7363                       f-cost-sum   = f-cost-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7364                       f-sale-sum   = f-sale-sum + if buf_gds-obj.fact-qnty = 0 then 0 else prt-obj.fact-qnty * buf_gds-obj.fact-sale / buf_gds-obj.fact-qnty
     7365                       f-free-qnty  = f-free-qnty + prt-obj.free-qnty
     7366                       f-cost-pr   = if prt-obj.fact-qnty  = 0 then 0 else determined(buf_gds-obj.fact-rubl) / buf_gds-obj.fact-qnty
     7367                       f-sale-pr   = if prt-obj.fact-qnty  = 0 then 0 else prt-obj.price-sale
     7368                       .
     7369                    end.
     7370                end.
     7371            end.
     7372        end.
     7373      end.
     7374      else do:
     7375          for each sl-obj-list,
     7376              first buf_gds-obj no-lock where
     7377                    buf_gds-obj.gds-code =  goods.gds-code and
     7378                    buf_gds-obj.obj-type =  sl-obj-list.obj-type and
     7379                    buf_gds-obj.obj-code =  sl-obj-list.obj-code :
     7380              assign
     7381               f-qnty       = f-qnty      + buf_gds-obj.fact-qnty
     7382               f-cost-sum   = f-cost-sum  + determined(buf_gds-obj.fact-rubl)
     7383               f-sale-sum   = f-sale-sum  + buf_gds-obj.fact-sale
     7384               f-free-qnty  = f-free-qnty + buf_gds-obj.free-qnty
     7385               f-cost-pr   = if f-qnty = 0 then 0 else f-cost-sum / f-qnty
     7386               f-sale-pr   = if f-qnty = 0 then 0 else f-sale-sum / f-qnty
     7387             .
     7388       end.
     7389         for each buf_parts no-lock where
     7390                   buf_parts.artic      = buf_gds-obj.artic       and
     7391                   buf_parts.prod-type  = buf_gds-obj.prod-type   and
     7392                   buf_parts.prod-code  = buf_gds-obj.prod-code   and
     7393                   buf_parts.obj-type   = buf_gds-obj.obj-type    and
     7394                   buf_parts.obj-code   = buf_gds-obj.obj-code    and
     7395                   buf_parts.status_    = false               and
     7396                   buf_parts.rsrv-free  = true    ,
     7397           first bufi_trn-doc no-lock where
     7398                 bufi_trn-doc.doc-code = buf_parts.out-code
     7399                 and
     7400               ( bufi_trn-doc.doc-type = 'рас':U or
     7401                 bufi_trn-doc.doc-type = 'спи':U )
     7402                 :
     7403                 if not can-find( first t-trn-doc where t-trn-doc.doc-code = bufi_trn-doc.doc-code) then do:
     7404                     create t-trn-doc.
     7405                     assign
     7406                     t-trn-doc.doc-code = bufi_trn-doc.doc-code .
     7407                     .
     7408                 end.
     7409               end.
     7410      end.
     7411         for each t-trn-doc :
     7412             for each  bufd_gds-dtl no-lock where
     7413                       bufd_gds-dtl.doc-code   = t-trn-doc.doc-code  and
     7414                       bufd_gds-dtl.artic      = buf_gds-obj.artic       and
     7415                       bufd_gds-dtl.prod-type  = buf_gds-obj.prod-type   and
     7416                       bufd_gds-dtl.prod-code  = buf_gds-obj.prod-code ,
     7417                 first buff_doc-line no-lock where
     7418                       buff_doc-line.doc-code   = bufd_gds-dtl.doc-code  and
     7419                       buff_doc-line.artic      = bufd_gds-dtl.artic     and
     7420                       buff_doc-line.prod-type  = bufd_gds-dtl.prod-type and
     7421                       buff_doc-line.prod-code  = bufd_gds-dtl.prod-code
     7422                       :
     7423                       assign
     7424                         f-rez-qnty = f-rez-qnty  + bufd_gds-dtl.doc-qnty
     7425                         f-rez-cost = f-rez-cost  + ( bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl )
     7426                         f-rez-sale = f-rez-sale  + ( bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl )
     7427                         f-rez-cost-pr = ( if f-rez-qnty = 0 then 0 else f-rez-cost / f-rez-qnty )
     7428                       .
     7429                       create temp_gds-dtl.
     7430                       buffer-copy bufd_gds-dtl to temp_gds-dtl
     7431                       assign
     7432                           temp_gds-dtl.cost-sum = bufd_gds-dtl.doc-qnty * buff_doc-line.price-rubl
     7433                           temp_gds-dtl.sale-sum = bufd_gds-dtl.doc-qnty * bufd_gds-dtl.price-rubl
     7434                       .
     7435             end.
     7436      end.
     7437   end.
     7438                 f-sale-other = 100 * determined((f-sale-sum - f-cost-sum) / f-cost-sum).
     7439                 if c-f-wait-qnty <> ? Then DO :
     7440                  for each sl-obj-list :
     7441                   for each trn-doc no-lock  where
     7442                       trn-doc.obj-code        = sl-obj-list.obj-code and
