      511         sym3                            no-label format "X(1)"             space(0)
      512         goods.gds-name                  no-label format "X(42)"            space(0)
      513         sym4                            no-label format "X(1)"             space(0)
      514         serial_num                      no-label format "X(6)"             space(0)
      515         sym5                            no-label format "X(1)"             space(0)
      516         goods.unit-base                 no-label format "x(7)"             space(0)
      517         sym6                            no-label format "X(1)"             space(0)
      518         price-list.doc-qnty             no-label format "->>>>>>>>9.<<"    space(0)
      519         sym7                            no-label format "X(1)"             space(0)
      520         price-list.price-prev           no-label format "->>,>>>,>>9.99"   space(0)
      521         sym8                            no-label format "X(1)"             space(0)
      522         sum_before                      no-label format "->>,>>>,>>9.99"   space(0)
      523         sym9                            no-label format "X(1)"             space(0)
      524         price-list.price-sale           no-label format "->>,>>>,>>9.99"   space(0)
      525         sym10                           no-label format "X(1)"             space(0)
      526         sum_after                       no-label format "->>,>>>,>>9.99"   space(0)
      527         sym11                           no-label format "X(1)"             space(0)
      528         ucenka                          no-label format "->,>>>,>>9.99"    space(0)
      529         sym12                           no-label format "X(1)"             space(0)
      530         doocenka                        no-label format "->>,>>>,>>9.99"   space(0)
      531         sym13                           no-label format "X(1)"             space(0)
      532         comments                        no-label format "X(10)"            space(0)
      533         sym14                           no-label format "X(1)"             space(0)
      534         header
      535           "+-----+---------+------------------------------------------+------+-------+-----------+-----------------------------------------------------------+----------------------------+----------+" skip
      536           "|     |         |                                          |      |       |           |               Стоимость, руб. , коп.                      |                            |          |" skip
      537           "|  N  |   Код   |                                          |      |       |           +-----------------------------+-----------------------------+                            |          |" skip
      538           "|     |         |            Наименование товара           |Серия |Ед.изм.|Количество |        До переоценки        |       После переоценки      |          Разница           |Примечание|" skip
      539           "| п/п |   ОКДП  |                                          |      |       |           +--------------+--------------+--------------+--------------+-------------+--------------|          |" skip
      540           "|     |         |                                          |      |       |           |     Цена     |    Сумма     |     Цена     |    Сумма     |   Уценка    |   Дооценка   |          |" skip
      541           "+-----+---------+------------------------------------------+------+-------+-----------+--------------+--------------+--------------+--------------+-------------+--------------+----------+" skip
      542         with width 187 down stream-io no-box no-underline no-labels .
      543   if session :set-wait-state( "compiler" ) then.
      544   run get-report-num in parparentproc (
      545       output g#report-num
      546   ).
      547   run get-quest-print in parparentproc (
      548       output g#quest-print
      549   ).
      550   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      551   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run rbisbase in g#library
      552     (output v-rb-is-base
      553     )  .
      554   find first price-doc no-lock
      555         where recid(price-doc) = rec_id .
      556   if not available price-doc
      557   then do:
      558       bell.
      559       message 'Порушена табличка "price-doc"(r-akt.p).'.
      560       return error.
      561   end.
      562   assign
      563       v-price-doc-doc-num  = price-doc.doc-num
      564       v-price-doc-doc-date = price-doc.doc-date
      565   .
      566   find    clients no-lock
      567     where clients.obj-code = price-doc.obj-code
      568       and clients.obj-type = price-doc.obj-type
      569   .
      570   if not available clients then
      571   do:
      572       bell.
      573       message 'Порушена табличка "clients" (r-akt.p).'.
      574       return error.
      575   end.
      576   define variable vss-include-info9 as character format "X(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      577   do:
      578     if (valid-handle(g#library2) <> true) then do:   run gbl/library2.p persistent no-error .   if error-status :error or (valid-handle(g#library2) <> true) then do:     message       "Error starting library2.p" skip       g#library2 skip       g#library2 :type skip       g#library2 :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run chk-actg in g#library2
      579       (input  v-cntxt-db-num
      580       ,input  v-cntxt-userid
      581       ,input  0
      582       ,input  'actn_overvalue-cast_print':U
      583       ,input  'firm':U
      584       ,input  v-cntxt-host-code-obj
      585       ,input  '':U
      586       ,input  0
      587       ,input  0
      588       ,input  0
      589       ,input  0
      590       ,input  false
      591       ,output Log-Resym1
      592       )  .
      593   end.
      594   assign
      595       v-single-line = fill("-", 197)
      596   .
      597   output stream AktStr to value( string( session:temp-directory +
      598                                        "rpt" + string( g#report-num ) ) )
      599                                        page-size 62 .
      600   find    buf_clients no-lock
      601     where buf_clients.obj-type = 'орг':U
      602       and buf_clients.obj-code = price-doc.host-code
      603   no-error.
      604   if available buf_clients
      605   then do:
      606       assign  firm_name = buf_clients.obj-name.
      607   end.
      608   put stream AktStr
      609       "БНФ №ТОРГ-7.1" at 175 skip
      610       "Наименование организации : " firm_name format "x(42)"   skip
      611       "Подразделение : " clients.obj-name skip
      612       skip
      613   .
      614   put stream AktStr
      615       "АКТ" at 93 skip
      616       "О ПЕРЕОЦЕНКЕ ТОВАРОВ" at 84 skip
      617       "от '__' ____________ 20__ г." at 81 skip
      618       skip
      619   .
      620   put stream AktStr
      621   chr(10)
      622   chr(10)
      623       "Комиссия в составе: председатель ____________________________, члены комиссии _____________________________________________" at 37 skip
      624       "                                 (должность)       (Ф.И.О)                         (должность)             (Ф.И.О.)        " at 37 skip
      625       chr(10)
      626       "на основании _____________________________ произвела переоценку товара по ___________________ ценам" at 44 skip
      627   .
      628           for each price-list no-lock
      629              where price-list.doc-num = price-doc.doc-num
      630             , each goods no-lock
      631              where goods.artic     = price-list.artic
      632                and goods.prod-type = price-list.prod-type
      633                and goods.prod-code = price-list.prod-code
      634           break by goods.grp-name by goods.artic descending
      635           :
      636                string_counter = string_counter + 1.
      637                sum_before = price-list.price-prev * price-list.doc-qnty.
      638                sum_after = price-list.price-sale * price-list.doc-qnty.
      639                if price-list.price-prev > price-list.price-sale then do:
      640                    ucenka = -(price-list.price-prev - price-list.price-sale).
      641                    doocenka = 0.
      642                    end_sum_ucenka = end_sum_ucenka + ucenka.
      643                end.
      644                else do:
      645                    doocenka = price-list.price-sale - price-list.price-prev.
      646                    end_sum_doocenka = end_sum_doocenka + doocenka.
      647                    ucenka = 0.
      648                end.
      649                end_sum_before = end_sum_before + sum_before.
      650                end_sum_after = end_sum_after + sum_after.
      651                display stream AktStr
      652                sym1 string_counter sym2 goods.okdp sym3 goods.gds-name sym4 serial_num sym5 goods.unit-base sym6 price-list.doc-qnty sym7
      653                price-list.price-prev sym8 sum_before sym9 price-list.price-sale sym10 sum_after sym11 ucenka sym12 doocenka sym13 comments sym14
      654                with frame Akt-Cost.
      655           end.
      656          put stream aktstr
      657            "+-----------------------------------------------------------------+-------+-----------+--------------+--------------------------------------------+-------------+--------------+----------+" skip
      658            "|                                                          Итого :|    X  |     X     |       X      |"  end_sum_before format "->>,>>>,>>9.99"  "|      X       |" end_sum_after format "->>,>>>,>>9.99" "|" end_sum_ucenka format "->,>>>,>>9.99" "|"   end_sum_doocenka format "->>,>>>,>>9.99" "|          |" skip
      659            "+-----------------------------------------------------------------+-------+-----------+--------------+--------------+--------------+--------------+-------------+--------------+----------+" skip
      660          .
      661       put stream AktStr skip(5)
      662                  "  Председатель комиссии :   ___________  _____________  ____________________"skip
      663                  "                            (должность)    (подпись)          (Ф.И.О.)      "skip
      664                  "          Члены комиссии: "skip
      665                  "                            ___________  _____________  ____________________"skip
      666                  "                            (должность)    (подпись)          (Ф.И.О.)      "skip
      667                  skip
      668                  "                            ___________  _____________  ____________________"skip
      669                  "                            (должность)    (подпись)          (Ф.И.О.)      "
      670                  skip
      671                  "                            ___________  _____________  ____________________"skip
      672                  "                            (должность)    (подпись)          (Ф.И.О.)      "
      673                  skip
      674                  "                            ___________  _____________  ____________________"skip
      675                  "                            (должность)    (подпись)          (Ф.И.О.)      " skip
      676                  "Материально ответственное" skip
      677                  "                   лицо :"skip
      678                  "                            ___________  _____________  ____________________"skip
      679                  "                            (должность)    (подпись)          (Ф.И.О.)      "
      680                  skip .
      681   output stream AktStr close.
      682   if session :set-wait-state( "" ) then.
      683   if g#quest-print = false
      684   then do:
      685     run adecomm/_osprint.p ( ?, string( session:temp-directory + "rpt" + string( g#report-num ) ),
      686                                         7, (if 4 >= 8 then 2 else 0), 0, 0,
      687                                         OUTPUT g#log ).
      688   end.
      689   else do:
      690     os-command silent
      691       value( "COPY /b " +
      692         string( session:temp-directory) +  "$" + string( g#report-num ) + " + " +
      693         string( session:temp-directory) + "rpt" + string( g#report-num ) + " " +
      694         string( session:temp-directory) +  "$" + string( g#report-num )
      695                 ) .
      696     os-command silent
      697       value( "COPY /b " +
      698         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl" + " + " +
      699         string( session:temp-directory) + "rpt" + string( g#report-num ) + ".txl" + " " +
      700         string( session:temp-directory) +  "$" + string( g#report-num ) + ".txl"
      701                 ) .
      702   end.
      703   end.
