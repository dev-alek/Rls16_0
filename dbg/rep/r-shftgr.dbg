      514     .
      515    end.
      516   end procedure.
      517   define new global shared variable g#library  as handle no-undo .
      518   define new global shared variable g#library2 as handle no-undo .
      519   define variable var-report-r-b as character no-undo .
      520   define variable vss-include-info6 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      521   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      522     (output var-report-r-b
      523     )  .
      524   define variable vss-include-info7 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      525   DEFINE shared TEMP-TABLE t-3 no-undo
      526   FIELD grp-code-sheet like ub.goods.grp-code
      527   FIELD grp-name like ub.gds-grp.node-name format "X(32)"
      528   FIELD serv-name as char
      529   FIELD qnty1-before as decimal FORMAT "->>>>9.99"
      530   FIELD netto-before as decimal FORMAT "->>>>9.99"
      531   FIELD qnty1-after as decimal FORMAT "->>>>9.99"
      532   FIELD netto-after as decimal FORMAT "->>>>9.99"
      533   FIELD lines as integer
      534   INDEX pi IS UNIQUE primary
      535   grp-code-sheet
      536   INDEX gname
      537   grp-name
      538   INDEX sname
      539   serv-name
      540   .
      541   DEFINE shared TEMP-TABLE tincome-3 no-undo
      542   FIELD grp-code-sheet as integer
      543   FIELD doc-code  like ub.trn-doc.doc-code
      544   FIELD supp-name like ub.clients.obj-name FORMAT "X(20)"
      545   FIELD supp-type like ub.clients.obj-type
      546   FIELD supp-code like ub.clients.obj-code FORMAT ">>>>>>>>9"
      547   FIELD qnty1-in as decimal FORMAT "->>>>9.99"
      548   FIELD netto-in as decimal FORMAT "->>>>>>>9.99"
      549   FIELD is-fact as logical
      550   FIELD ii as integer
      551   INDEX pi IS UNIQUE PRIMARY
      552         grp-code-sheet
      553         doc-code
      554   INDEX vi IS UNIQUE
      555         grp-code-sheet
      556         ii
      557   .
      558   define variable vss-include-info8 as character format "X(65)" no-undo
      559   initial "@(#)$Workfile$ $Revision$".
      560   procedure grplib-get-full-name :
      561      define input parameter p-node-code  as integer      no-undo.
      562      define output parameter p-full-name as character    no-undo.
      563      do
      564   on error undo, return error
      565   :
      566       define variable v-upper-code    as integer           no-undo.
      567       define buffer buf_gds-grp       for ub.gds-grp.
      568       define buffer buf_upper_gds-grp for ub.gds-grp.
      569       find first buf_gds-grp no-lock
      570            where buf_gds-grp.node-code = p-node-code
      571       no-error.
      572       if not available buf_gds-grp
      573       then do:
      574           undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом " + string( p-node-code ).
      575       end.
      576       assign
      577           p-full-name  = ""
      578           v-upper-code = 1
      579       .
      580       do while buf_gds-grp.upper-code <> 0
      581       on error undo, return error "grplib-get-full-name: Ошибка составления полного имени группы"
      582       :
      583           assign
      584               p-full-name  = buf_gds-grp.node-name
      585                            + (if p-full-name <> "" then chr(47) else "")
      586                            + p-full-name
      587               v-upper-code = buf_gds-grp.upper-code
      588           .
      589           find first buf_gds-grp no-lock
      590                where buf_gds-grp.node-code = v-upper-code
      591           no-error.
      592           if not available buf_gds-grp
      593           then do:
      594               undo, return error "grplib-get-full-name: Не найдена группа товаров с кодом "
      595                                   + string( v-upper-code )
      596                                   + ". Ошибка ссылки в дереве товаров для узла p-node-code".
      597           end.
      598       end.
      599       assign
      600       p-full-name = p-full-name + (if p-full-name = "":U then "":U else chr(47))
      601       .
      602   end.
      603   end .
      604   procedure grplib-get-node-from-full-name :
      605   define input parameter p-full-name as character no-undo .
      606   define output parameter p-node-code as integer no-undo .
      607   define variable v-ii as integer no-undo .
      608   define variable v-upper-code as integer no-undo .
      609   define variable v-root-code as integer no-undo .
      610   define variable v-entry as character no-undo .
      611   define buffer buf_gds-grp       for ub.gds-grp.
      612   do
      613   on error undo, return error
      614   :
      615     find first buf_gds-grp no-lock
      616         where buf_gds-grp.upper-code = 0
      617     no-error .
      618     if not available buf_gds-grp
      619     then do:
      620         undo, return error substitute("Не найдена корневая группа товаров (upper-code = 0)").
      621     end.
      622     else do:
      623       assign
      624       v-root-code = buf_gds-grp.node-code
      625       .
      626     end.
      627     v-upper-code = v-root-code.
      628     do v-ii = 1 to num-entries(p-full-name, chr(47)):
      629       assign
      630       v-entry = entry(v-ii, p-full-name, chr(47)).
      631       if v-entry = '' then leave.
      632       find first buf_gds-grp no-lock where
      633                 buf_gds-grp.node-name = v-entry
      634             and buf_gds-grp.upper-code = v-upper-code
      635             no-error.
      636       if not available buf_gds-grp then do:
      637         undo, return error substitute("Не найдена подгруппа &1 в группе с вн. кодом &2", v-entry, v-upper-code).
      638       end.
      639       else do:
      640         p-node-code = buf_gds-grp.node-code.
      641         v-upper-code = buf_gds-grp.node-code.
      642       end.
      643     end.
      644   end.
      645   end .
      646   procedure t-level :
      647     define input parameter loc-node-code like ub.gds-grp.node-code no-undo .
      648     define buffer loc-gds-grp for ub.gds-grp .
      649     define variable loc-grp-name as character no-undo .
      650     for each loc-gds-grp no-lock where
      651              loc-gds-grp.upper-code = loc-node-code
      652     :
      653       if loc-gds-grp.is-term = no
      654       then do:
      655         run t-level in this-procedure ( input loc-gds-grp.node-code ) no-error .
      656       end.
      657       else do:
      658         run grplib-get-full-name in this-procedure
      659           (  input loc-gds-grp.node-code
      660           , output loc-grp-name
      661           ) .
      662         create t-3 .
      663         assign t-3.grp-code  = loc-gds-grp.node-code
      664                t-3.serv-name = loc-grp-name
      665                t-3.grp-name  = loc-gds-grp.node-name
      666         .
      667       end.
      668     end.
      669   end procedure.
      670   procedure n-level :
      671     define input parameter loc-node-code like ub.gds-grp.node-code no-undo .
      672     define input parameter locvar-lavel  as   integer              no-undo .
      673     define buffer loc-gds-grp for ub.gds-grp .
      674     define variable loc-grp-name as character no-undo .
      675     for each loc-gds-grp no-lock where
      676              loc-gds-grp.upper-code = loc-node-code
      677     :
      678       run grplib-get-full-name in this-procedure
      679         (  input loc-gds-grp.node-code
      680         , output loc-grp-name
      681         ) .
      682       if loc-gds-grp.lvl-num  > locvar-lavel or
      683        ( loc-gds-grp.lvl-num <  locvar-lavel and
      684          loc-gds-grp.is-term <> yes )
      685       then do:
      686         run n-level in this-procedure
      687           ( input loc-gds-grp.node-code
      688           , input locvar-lavel
      689           ) no-error .
      690       end.
      691       else do:
      692         create t-3 .
      693         assign t-3.grp-code = loc-gds-grp.node-code
      694                t-3.serv-name = loc-grp-name
      695                t-3.grp-name = loc-gds-grp.node-name
      696         .
      697       end.
      698     end.
      699   end procedure.
      700   define variable loc-classify  as   integer              no-undo .
      701   define variable curr-grp-code like ub.gds-grp.node-code no-undo .
      702   define variable for-grp-name  like ub.gds-grp.node-name no-undo .
      703   case pClassify :
      704     when "totals":U
      705     then do:
      706       assign
      707         loc-classify = - 1
      708       .
      709     end.
      710     when "no-classify":U
      711     then do:
      712       assign
      713         loc-classify = 1
      714       .
      715     end.
      716     when "n-level":U
      717     then do:
      718       assign
      719         loc-classify = pvar-lavel
      720       .
      721     end.
      722     when "t-level":U
      723     then do:
      724       assign
      725         loc-classify = 0
      726       .
      727     end.
      728   end case.
      729   for each t-3
      730   :
      731     delete t-3 .
      732   end.
      733   if loc-classify = - 1
      734   then do:
      735     create t-3 .
      736     assign t-3.grp-code  = 0
      737            t-3.serv-name = "":U
      738            t-3.grp-name  = ( if X-selectgood = 2 then "ИТОГО ПО ВСЕМ ВЫБРАННЫМ ГРУППАМ" else "ИТОГО ПО ВСЕМ ГРУППАМ" )
      739     .
      740     return .
      741   end.
      742   if X-selectgood = 2
      743   then do:
      744     for each tmp#grp no-lock
      745     :
      746       run grplib-get-full-name in this-procedure
      747         (  input tmp#grp.node-code
      748         , output for-grp-name
      749         ) .
      750       case loc-Classify :
      751         when 1
      752         then do:
      753           create t-3 .
      754           assign t-3.grp-code  = tmp#grp.node-code
      755                  t-3.serv-name = for-grp-name
      756                  t-3.grp-name  = tmp#grp.grp-name
      757           .
      758         end.
      759         when  0 or
      760         when -1
      761         then do:
      762           if tmp#grp.is-term = yes
      763           then do:
      764             create t-3 .
      765             assign t-3.grp-code  = tmp#grp.node-code
      766                    t-3.serv-name = for-grp-name
      767                    t-3.grp-name  = tmp#grp.grp-name
      768             .
      769           end.
      770           else do:
      771             run t-level in this-procedure ( input tmp#grp.node-code ) no-error .
      772           end.
      773         end.
      774         when pvar-lavel
      775         then do:
      776           if tmp#grp.lvl-num >= pvar-lavel or
      777            ( tmp#grp.lvl-num <  pvar-lavel and
      778              tmp#grp.is-term  = yes )
      779           then do:
      780             create t-3 .
      781             assign t-3.grp-code  = tmp#grp.node-code
      782                    t-3.serv-name = for-grp-name
      783                    t-3.grp-name  = tmp#grp.grp-name
      784             .
      785           end.
      786           else
      787           run n-level in this-procedure(tmp#grp.node-code, pvar-lavel) no-error.
      788         end.
      789       end case.
      790     end.
      791   end.
      792   else do:
      793     for each ub.gds-grp no-lock
      794     :
      795       assign
      796         curr-grp-code = ub.gds-grp.node-code
      797       .
      798       run grplib-get-full-name in this-procedure
      799         (  input gds-grp.node-code
      800         , output for-grp-name
      801         ) .
      802       case loc-Classify :
      803         when 1
      804         then do:
      805           if ub.gds-grp.lvl-num <> 1
      806           then do:
      807             next .
      808           end.
      809         end.
      810         when 0
      811         then do:
      812           IF not ub.gds-grp.is-term
      813           then do:
      814             next .
      815           end.
      816         end.
      817         when pvar-lavel
      818         then do:
      819           if ub.gds-grp.lvl-num > pvar-lavel or
      820            ( ub.gds-grp.lvl-num < pvar-lavel and
      821              ub.gds-grp.is-term = no )
      822           then do:
      823             next .
      824           end.
      825         end.
      826       end case.
      827       create t-3 .
      828       assign t-3.grp-code  = curr-grp-code
      829              t-3.serv-name = for-grp-name
      830              t-3.grp-name  = ub.gds-grp.node-name
      831       .
      832     end.
      833   end.
