       81   def
       82    shared
       83   temp-table  obj-list no-undo
       84     field obj-type like ub.clients.obj-type
       85     field obj-code like ub.clients.obj-code
       86     field obj-name like ub.clients.obj-name
       87     field obj-id   as integer
       88     field db-num   as integer
