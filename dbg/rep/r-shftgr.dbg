      486     Col-name[229]=   'HU':U
      487     Col-name[230]=   'HV':U
      488     Col-name[231]=   'HW':U
      489     Col-name[232]=   'HX':U
      490     Col-name[233]=   'HY':U
      491     Col-name[234]=   'HZ':U
      492     Col-name[235]=   'IA':U
      493     Col-name[236]=   'IB':U
      494     Col-name[237]=   'IC':U
      495     Col-name[238]=   'ID':U
      496     Col-name[239]=   'IE':U
      497     Col-name[240]=   'IF':U
      498     Col-name[241]=   'IG':U
      499     Col-name[242]=   'IH':U
      500     Col-name[243]=   'II':U
      501     Col-name[244]=   'IJ':U
      502     Col-name[245]=   'IK':U
      503     Col-name[246]=   'IL':U
      504     Col-name[247]=   'IM':U
