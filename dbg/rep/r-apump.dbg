      588   define  stream PrnLibStream.
      589   procedure prn-lib-prn-file :
      590     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      591     define input parameter p-DIsabledoptions as integer no-undo .
      592     define variable v-report-name as character no-undo .
      593     define variable v-user-action as character no-undo .
      594     define variable v-printed     as logical   no-undo .
      595     define variable v-exist       as logical   no-undo .
      596     do
      597       on error undo, return error
      598       :
      599       run prn-lib-get-report-name  in this-procedure (
      600         input parParentProc
      601         ,output v-report-name
      602         ).
      603   define variable vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      604   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run filenmln in g#library
      605     (input  v-report-name
      606     ,input  2
      607     ,output v-exist
      608     )  .
      609       if NOT v-exist then
      610       DO:
      611         Message
      612           "Нет заданий на печать ! "
      613           view-as alert-box .
      614         Return  .
      615       End.
      616       run gbl/prnfilen.w
      617         (input  ""
      618         ,input  p-DisabledOptions
      619         ,input  string(v-report-name )
      620         ,input  7
      621         ,output v-user-action
      622         ,output v-printed
      623         ) .
      624       if v-printed then
      625       do:
      626         return "YES" .
      627       end.
      628       else
      629       do:
      630         return "NO" .
      631       end.
      632     end.
      633   end procedure.
      634   procedure prn-lib-open-stream :
      635     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      636     define input parameter p-page-size    as integer no-undo .
      637     define input parameter p-is-stream    as logical no-undo .
      638     define input parameter p-append       as logical no-undo .
      639     define variable v-report-name as character no-undo .
      640     do
      641       on error undo, return error
      642       :
      643       run prn-lib-get-report-name  in this-procedure (
      644         input parParentProc
      645         ,output v-report-name
      646         ).
      647       if p-is-stream then
      648       do:
      649         if p-append then
      650         do:
      651           output stream PrnLibStream to value( v-report-name )
      652             page-size value(p-page-size) append .
      653         end.
      654         if not p-append then
      655         do:
      656           output stream PrnLibStream to value( v-report-name )
      657             page-size value(p-page-size) .
      658         end.
      659       end.
      660       if not p-is-stream then
      661       do:
      662         if p-append then
      663         do:
      664           output to value( v-report-name )
      665             page-size value(p-page-size) append .
      666         end.
      667         if not p-append then
      668         do:
      669           output to value( v-report-name )
      670             page-size value(p-page-size) .
      671         end.
      672       end.
      673     end.
      674   end procedure.
      675   procedure prn-lib-open-exp :
      676     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      677     define input parameter p-is-stream    as logical no-undo .
      678     define input parameter p-is-append    as logical no-undo .
      679     define output parameter p-ReportFileName as char init "report" no-undo.
      680     define output parameter p-process as logical no-undo .
      681     define variable glog as logical no-undo .
      682     do
      683       on error undo, return error
      684       :
      685       SYSTEM-DIALOG GET-FILE p-ReportFileName
      686         TITLE      "Укажите путь"
      687         FILTERS "Текстовый файл (*.txt)"   "*.txt"
      688         ASK-OVERWRITE
      689         CREATE-TEST-FILE
      690         SAVE-AS
      691         USE-FILENAME
      692         DEFAULT-EXTENSION "txt"
      693         UPDATE glog
      694         .
      695       if not glog then  return.
      696       p-ReportFileName = trim( string( p-ReportFileName ) ) .
      697       if p-is-stream then
      698       do:
      699         if p-is-append then
      700         do:
      701           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      702         end.
      703         else
      704         do:
      705           OUTPUT stream PrnLibStream TO value ( p-ReportFileName ) PAGE-SIZE 0.
      706         end.
      707       end.
      708       else
      709       do:
      710         if p-is-append then
      711         do:
      712           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0 append.
      713         end.
      714         else
      715         do:
      716           OUTPUT TO value ( p-ReportFileName ) PAGE-SIZE 0.
      717         end.
      718       end.
      719       p-process = yes.
      720     end.
      721   end procedure.
      722   procedure prn-lib-get-report-name :
      723     define input parameter parParentProc  as widget-handle no-undo.
      724     define output parameter p-report-name as character no-undo .
      725     p-report-name = ibs.th.gbl.gbl-inipar:prn-lib-get-report-name("rpt").
      726   end procedure.
      727   procedure prn-lib-reportviewer-report-name :
      728     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      729     define input parameter p-report-name-html as character no-undo .
      730     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer-report-name(p-report-name-html) no-error.
      731   end procedure.
      732   procedure prn-lib-reportviewer :
      733     define input parameter parParentProc  AS WIDGET-HANDLE NO-UNDO.
      734     define input parameter p-report-name-html as character no-undo .
      735     define input parameter p-param        as character no-undo .
      736     define variable v-excel           as character no-undo init 'TRUE' .
      737     define variable v-value-character as character no-undo .
      738     define variable v-value-integer   as character no-undo .
      739     define variable v-value-date      as date      no-undo .
      740     define variable v-value-decimal   as decimal   no-undo .
      741     define variable rep-excel         as logical   no-undo .
      742     define variable excel-string      as character no-undo .
      743     define variable v-param-type      as character no-undo .
      744     define variable v-tth             as handle    no-undo .
      745     run adm/shattri.p (
      746       input "get":U
      747       ,input  ""
      748       ,input  0
      749       ,input  'report-glob':U
      750       ,input  'rep-excel':U
      751       ,output v-value-character
      752       ,output v-value-date
      753       ,output v-value-decimal
      754       ,output v-value-integer
      755       ,output rep-excel
      756       ,output v-param-type
      757       ,INPUT-OUTPUT table-handle v-tth
      758       )  .
      759     if rep-excel then v-excel = "TRUE" .
      760     else v-excel = "FALSE" .
      761     if p-param eq ""
      762     then
      763        p-param = "EXCEL:" + v-excel.
      764     else
      765        p-param = p-param + chr(4) + "EXCEL:" + v-excel .
      766     ibs.th.gbl.gbl-inipar:prn-lib-reportviewer(p-report-name-html, p-param).
      767   end procedure.
      768   define variable vss-include-info10 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      769   procedure cur-time :
      770      define output parameter p-today as date      no-undo .
      771      define output parameter p-time  as integer   no-undo .
      772     do
      773     on error undo, return error
      774     :
      775       define variable v-date1 as date      no-undo .
      776       define variable v-date2 as date      no-undo .
      777       define variable v-time  as integer   no-undo .
      778       assign
      779         v-date1 = today
      780         v-time  = time
      781         v-date2 = today
      782       .
      783       if v-date1 <> v-date2
      784       then do:
      785         assign
      786           v-date1 = today
      787           v-time  = v-time
      788         .
      789       end.
      790       assign
      791         p-today = v-date1
      792         p-time  = v-time
      793       .
      794     end.
      795   end.
      796   function cur-time-date returns character
      797   :
      798     return string(today, '99/99/9999':U) .
      799   end.
      800   function cur-time-mjd returns decimal
      801   :
      802     define variable v-date as date      no-undo .
      803     define variable v-time as integer   no-undo .
      804     run cur-time in this-procedure
      805       (output v-date
      806       ,output v-time
      807       ) .
      808     return integer(v-date) - 2400002 + (v-time / 86400) .
      809   end.
      810   function cur-time-get-ending-index returns integer
      811   (input p-number as integer
      812   )
      813   :
      814     if p-number < 0
      815     or p-number = ?
      816     then do:
      817       return 1 .
      818     end.
      819     define variable v-rest as integer   no-undo .
      820     assign
      821       p-number = p-number modulo 100
      822     .
      823     if p-number < 20
      824     then do:
      825       assign
      826         v-rest = p-number
      827       .
      828     end.
      829     else do:
      830       assign
      831         v-rest = p-number modulo 10
      832       .
      833     end.
      834     case v-rest :
      835       when 1
      836       then do:
      837         return 2 .
      838       end.
      839       when 2 or
      840       when 3 or
      841       when 4
      842       then do:
      843         return 3 .
      844       end.
      845       otherwise do:
      846         return 1 .
      847       end.
      848     end case .
      849   end.
      850   procedure cur-time-mjd-to-date :
      851      define input  parameter i-mjd-diff as decimal no-undo.
      852      define output parameter o-Date     as date    no-undo.
      853      define output parameter o-Time     as integer no-undo.
      854      define variable v-day-number as integer   no-undo .
      855      if    i-mjd-diff < 0
      856         or i-mjd-diff = ?
      857      then do:
      858         return "?" .
      859      end.
      860      assign
      861         v-day-number = truncate(i-mjd-diff,0).
      862         o-Date = date(v-day-number + 2400002).
      863         o-Time = truncate((i-mjd-diff - v-day-number) * 86400, 0)
      864     .
      865   end.
      866   function cur-time-mjd-to-string returns character
      867   (input p-mjd-diff as decimal
      868   )
      869   :
      870     define variable v-day-number as integer   no-undo .
      871     define variable v-seconds    as integer   no-undo .
      872     define variable v-hour       as integer   no-undo .
      873     define variable v-min        as integer   no-undo .
      874     define variable v-day-name    as character no-undo extent 3 initial [   "дней",    "день",     "дня" ] .
      875     define variable v-hour-name   as character no-undo extent 3 initial [  "часов",     "час",    "часа" ] .
      876     define variable v-min-name    as character no-undo extent 3 initial [  "минут",  "минута",  "минуты" ] .
      877     define variable v-second-name as character no-undo extent 3 initial [ "секунд", "секунда", "секунды" ] .
      878     if p-mjd-diff < 0
      879     or p-mjd-diff = ?
      880     then do:
      881       return "?" .
      882     end.
      883     assign
      884       v-day-number = integer(truncate(p-mjd-diff,0))
      885       v-seconds    = truncate((p-mjd-diff - v-day-number) * 86400, 0)
      886     .
      887     if v-seconds > 86400
      888     then do:
      889       assign
      890         v-seconds = 86400 - 1
      891       .
      892     end.
      893     if v-seconds < 0
      894     then do:
      895       assign
      896         v-seconds = 0
      897       .
      898     end.
      899     assign
      900       v-hour = truncate(v-seconds / 3600, 0)
      901     .
      902     assign
      903       v-seconds = v-seconds modulo 3600
      904     .
      905     assign
      906       v-min = truncate(v-seconds / 60, 0)
      907     .
      908     assign
      909       v-seconds = v-seconds modulo 60
      910     .
      911     return
      912         (if v-day-number <> 0
      913           then string(v-day-number) + " " + v-day-name[cur-time-get-ending-index(v-day-number)] + " "
      914           else ""
      915         )
      916       + (if v-day-number <> 0 or v-hour <> 0
      917           then string(v-hour) + " " + v-hour-name[cur-time-get-ending-index(v-hour)] + " "
      918           else ""
      919         )
      920       + (if v-day-number <> 0 or v-hour <> 0 or v-min <> 0
      921           then string(v-min) + " " + v-min-name[cur-time-get-ending-index(v-min)] + " "
      922           else ""
      923         )
      924       + string(v-seconds) + " " + v-second-name[cur-time-get-ending-index(v-seconds)]
      925       .
      926   end.
      927   function cur-time-string returns character
      928   :
      929     define variable v-date as date      no-undo .
      930     define variable v-time as integer   no-undo .
      931     run cur-time in this-procedure
      932       (output v-date
      933       ,output v-time
      934       ) .
      935     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM':U) .
      936   end.
      937   function cur-time-string-sec returns character
      938   :
      939     define variable v-date as date      no-undo .
      940     define variable v-time as integer   no-undo .
      941     run cur-time in this-procedure
      942       (output v-date
      943       ,output v-time
      944       ) .
      945     return string(v-date, '99/99/9999':U) + ' ':u + string(v-time, 'HH:MM:SS':U) .
      946   end.
      947   function cur-time-custom  returns character
      948   (input p-prefix as character
      949   ,input p-date-format as character
      950   ,input p-delimiter as character
      951   ,input p-time-format as character
      952   ,input p-suffix as character
      953   )
      954   :
      955     define variable v-date as date      no-undo .
      956     define variable v-time as integer   no-undo .
      957     run cur-time in this-procedure
      958       (output v-date
      959       ,output v-time
      960       ) .
      961     return
      962       p-prefix
      963       + string(v-date, p-date-format)
      964       + p-delimiter
      965       + string(v-time, p-time-format)
      966       + p-suffix
      967       .
      968   end.
      969   function cur-time-print  returns character
      970   :
      971     define variable v-date as date      no-undo .
      972     define variable v-time as integer   no-undo .
      973     run cur-time in this-procedure
      974       (output v-date
      975       ,output v-time
      976       ) .
      977     return "Дата печати : " + string(v-date, '99.99.9999':U) + ' , ':U + string(v-time, 'HH:MM':U) .
      978   end.
      979   function cur-time-datetime returns datetime
      980   :
      981     define variable v-char as character no-undo .
      982     define variable v-datetime as datetime no-undo .
      983     v-char = cur-time-string().
      984     v-datetime = datetime(v-char).
      985     return  v-datetime.
      986   end.
      987   function cur-time-string-msec returns character
      988   :
      989     define variable v-date as datetime  no-undo .
      990     v-date = now.
      991     return string(v-date) .
      992   end.
      993   define variable vss-include-info11 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      994   define variable v-waitfram-action01         as character   no-undo .
      995   define variable v-waitfram-action02         as character   no-undo .
      996   define variable v-waitfram-action03         as character   no-undo .
      997   define variable mWaitFramTextBeg            as character   no-undo.
      998   define variable mWaitFramTextEnd            as character   no-undo.
      999   define variable mWaitFramView               as logical     no-undo.
     1000   define variable mWaitProcEvent              as logical     no-undo init yes.
     1001   define variable mWaitFramInterval           as integer     no-undo init 1 .
     1002   define variable mWaitFramStop               as logical     no-undo.
     1003   define variable mWaitFramStopUser           as logical     no-undo.
     1004   define variable mWaitFramStopTimeOut        as logical     no-undo.
     1005   define variable mWaitFramStartProc          as datetime-tz no-undo.
     1006   define variable mWaitFramTimeOut            as decimal     no-undo init ?.
     1007   define button B-WaitFramStop auto-end-key
     1008        label "Стоп"
     1009        size 10 by 1 tooltip "Остоновить процесс".
     1010   define button B-viewProcInfo
     1011        label "Информация"
     1012        size 15 by 1 tooltip "Информация о процесс".
     1013   define frame waitfram
     1014     v-waitfram-action01 format "x(72)" no-label skip
     1015     v-waitfram-action02 format "x(72)" no-label skip
     1016     v-waitfram-action03 format "x(72)" no-label skip
     1017     B-viewProcInfo
     1018     B-WaitFramStop at row 4 col 30
     1019     with view-as dialog-box side-labels three-d cancel-button B-WaitFramStop
     1020     .
     1021   define new global shared variable mBatchMode as logical no-undo init ?.
     1022   define variable mFramBachModHandle as handle no-undo.
     1023   mFramBachModHandle = frame waitfram:handle.
     1024   define variable mFameOldVis as logical no-undo.
     1025   define variable mVisCUrentVin as logical no-undo.
     1026   if session:batch-mode
     1027   then
     1028      mBatchMode = yes.
     1029   if mBatchMode = ? then do:
     1030     mVisCUrentVin = current-window:visible.
     1031     mFameOldVis = mFramBachModHandle:visible.
     1032     mFramBachModHandle:visible  = yes.
     1033     mBatchMode = mFramBachModHandle:visible ne yes.
     1034     mFramBachModHandle:visible = mFameOldVis.
     1035     current-window:visible = mVisCUrentVin.
     1036   end.
     1037    if  log-manager:logfile-name ne ?
     1038     then DO:
     1039         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1040         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1041         log-manager:write-message("visible-frame-mod=" + string(mFramBachModHandle:visible), "frameRepError").
     1042     end.
     1043   on choose of B-WaitFramStop in frame waitfram
     1044   do:
     1045     mWaitFramStop = yes.
     1046     mWaitFramStopUser = yes.
     1047   end.
     1048   function waitfram-check-timeout returns logical():
     1049      define variable vtime as int64 no-undo.
     1050      if mWaitFramStopTimeOut
     1051      then
     1052         return yes.
     1053      vtime = ( now - mWaitFramStartProc ) / 1000 .
     1054      if     mWaitFramTimeOut ne ?
     1055         and mWaitFramTimeOut ne 0
     1056         and mWaitFramTimeOut lt vtime
     1057      then do:
     1058         mWaitFramStopTimeOut = yes.
     1059      end.
     1060      return mWaitFramStopTimeOut.
     1061   end.
     1062   procedure waitfram-hide :
     1063     if not session:batch-mode
     1064     then do
     1065     on error undo, return error return-value
     1066     :
     1067       pause 0 before-hide .
     1068       if not mBatchMode then
     1069         hide frame waitfram .
     1070     if     not mWaitFramView
     1071        and mWaitProcEvent
     1072     then
     1073       process events .
     1074     end.
     1075   end procedure.
     1076   procedure waitfram-show :
     1077     define input  parameter p-message as character no-undo .
     1078     define variable v-left-margin as integer   no-undo .
     1079     if not session:batch-mode
     1080     then do
     1081     on error undo, return error return-value
     1082     :
     1083       if length(p-message) <= 70 then do:
     1084         assign
     1085           v-left-margin = integer((70 - length(p-message)) / 2)
     1086         .
     1087         assign
     1088           v-left-margin = max(0, v-left-margin - (v-left-margin mod 5))
     1089         .
     1090         assign
     1091           v-waitfram-action01 = " "
     1092           v-waitfram-action02 = " "
     1093                                    + fill(" ", v-left-margin)
     1094                                    + p-message
     1095           v-waitfram-action03 = " "
     1096         .
     1097       end.
     1098       else do:
     1099         define variable vRindex1 as integer no-undo.
     1100         define variable vRindex2 as integer no-undo.
     1101         vRindex1 = r-index(p-message," ",70).
     1102         if vRindex1 = 0
     1103         then
     1104            vRindex1 = 70.
     1105         if length(p-message)  <= vRindex1 + 70 then do:
     1106           assign
     1107             v-waitfram-action01 = " "
     1108             v-waitfram-action02 = " " + substring(p-message,   1          , vRindex1)
     1109             v-waitfram-action03 = " " + substring(p-message,  vRindex1 + 1, 70      )
     1110           .
     1111         end.
     1112         else do:
     1113           vRindex2 = r-index(p-message," ",vRindex1 + 70).
     1114           if vRindex2 <= vRindex1
     1115           then
     1116              vRindex2 = vRindex1 + 70.
     1117           assign
     1118             v-waitfram-action01 = " " + substring(p-message,   1          , vRindex1)
     1119             v-waitfram-action02 = " " + substring(p-message,  vRindex1 + 1, vRindex2 - vRindex1 )
     1120             v-waitfram-action03 = " " + substring(p-message,  vRindex2 + 1, 70)
     1121           .
     1122         end.
     1123       end.
     1124       B-viewProcInfo:visible   in frame waitfram = no.
     1125       B-viewProcInfo:sensitive in frame waitfram = no.
     1126       B-WaitFramStop:visible   in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1127       B-WaitFramStop:sensitive in frame waitfram = if not mBatchMode and mWaitFramView then yes else no .
     1128       if  (   mWaitFramView
     1129          or  mWaitProcEvent)
     1130          and not mBatchMode
     1131       then
     1132          display
     1133             v-waitfram-action01 skip
     1134             v-waitfram-action02 skip
     1135             v-waitfram-action03 skip
     1136          with frame waitfram .
     1137       if     mWaitFramView
     1138          then do:
     1139             if     mWaitFramInterval ne ?
     1140                and not mBatchMode
     1141             then
     1142                wait-for go of frame waitfram pause mWaitFramInterval.
     1143          end.
     1144          else
     1145             if     mWaitProcEvent
     1146                and not mBatchMode
     1147             then
     1148                process events .
     1149     end.
     1150   end procedure.
     1151      procedure waitfram-show-this:
     1152         define input  parameter iInterval as int64 no-undo.
     1153         define variable vtime as int64 no-undo.
     1154         vtime = ( now - mWaitFramStartProc  ) / 1000 .
     1155         mWaitFramInterval = iInterval.
     1156         run waitfram-show (substitute("&1&2 &3&4" ,
     1157                                       mWaitFramTextBeg ,
     1158                                       if vtime eq ? then "" else substitute (" Прошло: &1 сек" , string( vtime)),
     1159                                       if mWaitFramTimeOut ne 0 and mWaitFramTimeOut ne ? then " из " + string(mWaitFramTimeOut) + " сек. " else "",
     1160                                       mWaitFramTextEnd
     1161                                      )
     1162                           ).
     1163      end.
     1164      procedure WaitFramRunPause:
     1165         define input  parameter iInterval as dec no-undo.
     1166         define variable vStart  as datetime-tz no-undo.
     1167         define variable vend    as datetime-tz no-undo.
     1168         define variable vint as int64 no-undo.
     1169         define variable vOk as logical no-undo.
     1170         vStart = now.
     1171         vend   = vStart.
     1172         publish "WaitFramPause" (iInterval,output vOk).
     1173         vend   =  now.
     1174         vint = vend - vStart.
     1175         vint = iInterval - vint / 1000.
     1176         if     not mWaitFramStop
     1177            and (   vint > 0
     1178                 or (    not vOk
     1179                     and iInterval eq ?
     1180                     )
     1181                 )
     1182         then
     1183            run waitfram-show-this (iInterval).
     1184         vend   =  now.
     1185         vint = vend - vStart.
     1186         vint = iInterval - vint / 1000.
     1187         if     not mWaitFramStop
     1188            and vint > 0
     1189         then do:
     1190            run gbl/pause.p (vint * 1000).
     1191         end.
     1192         if iInterval ne ?
     1193         then
     1194            publish "WaitFramStop".
     1195         waitfram-check-timeout().
     1196      end.
     1197      procedure WaitFramWaitFor:
     1198         define input  parameter iInterval as dec no-undo.
     1199         assign
     1200            mWaitFramStartProc   = now
     1201            mWaitFramStopUser    = no
     1202            mWaitFramStopTimeOut = no
     1203         .
     1204         block-wait:
     1205         do while not mWaitFramStop:
     1206            run WaitFramRunPause (iInterval).
     1207            if  waitfram-check-timeout()
     1208            then do:
     1209               leave block-wait.
     1210            end.
     1211         end.
     1212         run waitfram-hide.
     1213      end.
     1214   procedure waitfram-join :
     1215     define input  parameter p-line-1  as character no-undo .
     1216     define input  parameter p-line-2  as character no-undo .
     1217     define input  parameter p-line-3  as character no-undo .
     1218     define output parameter p-message as character no-undo .
     1219     do
     1220     on error undo, return error return-value
     1221     :
     1222       assign
     1223         p-message = substring(p-line-1 + fill(' ', 70), 1, 70)
     1224                   + substring(p-line-2 + fill(' ', 70), 1, 70)
     1225                   + substring(p-line-3 + fill(' ', 70), 1, 70)
     1226       .
     1227     end.
     1228   end procedure.
     1229   function waitfram-join-function returns character
     1230     (input p-line-1 as character
     1231     ,input p-line-2 as character
     1232     ,input p-line-3 as character
     1233     ).
     1234     define variable v-message as character no-undo .
     1235     run waitfram-join in this-procedure
     1236       (input  p-line-1
     1237       ,input  p-line-2
     1238       ,input  p-line-3
     1239       ,output v-message
     1240       ) .
     1241     return v-message .
     1242   end function .
     1243   define variable v-ind         as integer   no-undo .
     1244   define variable n-pump        as integer   no-undo .
     1245   define variable v-line        as character no-undo format "X(105)" .
     1246   define variable l-line        as character no-undo format "X(75)" .
     1247   define buffer buf_icnt-doc  for ub.icnt-doc.
     1248   define buffer buf_icnt-line for ub.icnt-line.
     1249   define buffer buf_goods     for ub.goods.
     1250   define buffer buf_clients for ub.clients .
     1251   assign
     1252     v-line = fill("-", 105 )
     1253     l-line = fill("-", 75 )
     1254   .
     1255   define variable v-line1        as character no-undo format "X(105)" .
     1256   define variable v-line2        as character no-undo format "X(105)" .
     1257   define variable l-line1        as character no-undo format "X(75)" .
     1258   define variable l-line2        as character no-undo format "X(75)" .
     1259   assign
     1260     v-line1 = v-line
     1261     v-line2 = v-line
     1262     l-line1 = v-line
     1263     l-line2 = v-line
     1264   .
     1265   define variable sym1          as character no-undo format "x(1)":u  init ":":u .
     1266   define variable sym2          as character no-undo format "x(1)":u  init ":":u .
     1267   define variable sym3          as character no-undo format "x(1)":u  init ":":u .
     1268   define variable sym4          as character no-undo format "x(1)":u  init ":":u .
     1269   define variable sym5          as character no-undo format "x(1)":u  init ":":u .
     1270   define variable sym6          as character no-undo format "x(1)":u  init ":":u .
     1271   define variable sym7          as character no-undo format "x(1)":u  init ":":u .
     1272   define variable sym8          as character no-undo format "x(1)":u  init ":":u .
     1273   run prn-lib-open-stream  in this-procedure (
     1274                                                input parParentProc
     1275                                               ,input 63
     1276                                               ,input yes
     1277                                               ,input no
     1278                                               ).
     1279   find first buf_icnt-doc no-lock
     1280     where recid(buf_icnt-doc) = p-recid no-error.
     1281   if not available buf_icnt-doc then do:
     1282    message
     1283       vss-workfile vss-revision vss-description skip
     1284       "Документ не найден" skip
     1285       view-as alert-box.
     1286     undo, return error .
     1287   end.
     1288   if buf_icnt-doc.doc-type <> 'инв-сч-трк':U then do:
     1289    message
     1290       vss-workfile vss-revision vss-description skip
     1291       substitute("Документ &1 не может быть напечатан по данной форме", buf_icnt-doc.doc-code) skip
     1292       view-as alert-box.
     1293     undo, return error .
     1294   end.
     1295   run waitfram-show in this-procedure ( 'Подождите ...' ) .
     1296   define variable v-obj-name as character no-undo .
     1297   define variable v-header-name as character no-undo .
     1298   define variable v-print-time  as character no-undo .
     1299   define variable v-host-name   as character no-undo.
     1300   define variable v-host-code like ub.sysconf.host-code no-undo .
     1301   define buffer frm-clients for ub.clients.
     1302   assign
     1303     v-header-name = substitute(" N док-та &1", buf_icnt-doc.doc-code)
     1304     v-print-time  = cur-time-string()
     1305   .
     1306   find first buf_clients no-lock
     1307     where buf_clients.obj-type = buf_icnt-doc.obj-type
     1308       and buf_clients.obj-code = buf_icnt-doc.obj-code
     1309     .
     1310   assign
     1311     v-obj-name = buf_clients.obj-name
     1312   .
     1313   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1314   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run hostcode in g#library
     1315     (input  buf_icnt-doc.obj-type
     1316     ,input  buf_icnt-doc.obj-code
     1317     ,output v-host-code
     1318     )  .
     1319   find first frm-clients no-lock
     1320     where frm-clients.obj-type = 'орг':U
     1321       and frm-clients.obj-code = v-host-code
     1322     .
     1323   assign
     1324     v-host-name = frm-clients.obj-name
     1325   .
     1326   put stream PrnLibStream unformatted
     1327     string(v-host-name + fill(" ", 40), "x(40)")  skip
     1328     string(v-obj-name + fill(" ", 40), "x(40)")  skip
     1329     v-print-time skip
     1330     "                                         Ж У Р Н А Л" skip
     1331     "                              инвентаризации показаний счетчиков ТРК" skip
     1332     skip(2)
     1333     "Смена № " + string(buf_icnt-doc.shift-name) + " от " + string(buf_icnt-doc.shift-date,"99/99/9999") skip
     1334     "Дата и время снятия показаний " + v-print-time skip
     1335     string( if buf_icnt-doc.fact-date <> ? then buf_icnt-doc.fact-date else buf_icnt-doc.doc-date ) skip
     1336     buf_icnt-doc.doc-code  + " дата " + string( if buf_icnt-doc.fact-date <> ? then buf_icnt-doc.fact-date else buf_icnt-doc.doc-date ) skip
     1337     .
     1338   put stream PrnLibStream unformatted
     1339     v-line skip
     1340     "! № !                                   !      Код       !   Показание   !  Показание   !               !" skip
     1341     "!ТРК! Наименование продукта             !    продукта    ! механического ! электронного !    Дельта     !" skip
     1342     "!   !                                   !                !   счетчика    !  счетчика    !               !" skip
     1343     v-line skip
     1344     "! 1 !               2                   !        3       !        4      !      5       !       6       !" skip
     1345     v-line
     1346   .
     1347   form header
     1348     v-header-name format "x(50)" at 1
     1349     "Дата:" at 60
     1350     v-print-time format "x(20)"
     1351     "стр." + string( page-number(PrnLibStream), ">>>9" )  at 95
     1352     with frame topframe
     1353     width 106 page-top  no-labels   no-box stream-io use-text.
     1354    view stream PrnLibStream frame topframe .
     1355     form header
     1356       v-line1 at 1 skip
     1357       "! 1 !               2                   !        3       !       4       !      5       !       6       !"  at 1
     1358       v-line2 at 1
     1359       with frame top2frame
     1360       width 106 page-top no-labels  no-box stream-io use-text.
     1361      view stream PrnLibStream frame top2frame .
     1362   form header
     1363     v-line at 1 skip
     1364     "Продолжение на следующей странице" at 30 skip
     1365     with frame bottomframe
     1366     width 106 page-bottom no-labels no-box stream-io use-text.
     1367   view stream PrnLibStream frame bottomframe .
     1368   define variable v-bar-code  like ub.bar-code.b-code no-undo  .
     1369   define variable v-column-4  as decimal no-undo   format "->>,>>>,>>9.99" .
     1370   define variable v-column-5  as decimal no-undo   format "->>,>>>,>>9.99" .
     1371   define variable v-column-6  as decimal no-undo   format "->>>,>>>,>>9.99" .
     1372   define frame icnt-line-frm
     1373   sym1  no-label space(0)  n-pump         format ">>9"   no-label space(0)
     1374   sym2  no-label space(0) buf_goods.gds-name  format "x(35)" no-label  space(0)
     1375   sym3  no-label space(4) v-bar-code   no-label  space(3)
     1376   sym4  no-label space(1) v-column-4   no-label space(0)
     1377   sym5  no-label space(0) v-column-5   no-label space(0)
     1378   sym6  no-label space(0) v-column-6   no-label space(0)
     1379   sym7  no-label space(0)
     1380   with width 106  down stream-io use-text  no-labels no-box.
     1381   for each buf_icnt-line no-lock
     1382     where buf_icnt-line.doc-code = buf_icnt-doc.doc-code with frame icnt-line-frm :
     1383       find first buf_goods no-lock  where buf_goods.gds-code     = buf_icnt-line.gds-code no-error .
     1384   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run gdsbcode in g#library
     1385     (input  buf_icnt-line.gds-code
     1386     ,input  ?
     1387     ,output v-bar-code
     1388     )  .
     1389     assign
     1390       v-ind = v-ind + 1
     1391     .
     1392     run waitfram-show in this-procedure ("Печать документа. Обработано строк: " + string(v-ind) ) .
     1393         n-pump      = buf_icnt-line.pump-code .
     1394         v-column-4  = buf_icnt-line.state-mh-cnt .
     1395         v-column-5  = buf_icnt-line.state-el-cnt .
     1396         v-column-6  = buf_icnt-line.state-el-cnt - buf_icnt-line.state-mh-cnt.
     1397       display stream PrnLibStream
     1398       frame icnt-line-frm
     1399         sym1  n-pump
     1400         sym2  buf_goods.gds-name
     1401         sym3
     1402         v-bar-code
     1403         sym4
     1404         v-column-4
     1405         sym5
     1406         v-column-5
     1407         sym6
     1408         v-column-6
     1409         sym7
     1410         .
     1411        down stream PrnLibStream  .
     1412   End.
     1413   hide frame bottomframe .
     1414   hide frame top2frame .
     1415   hide frame input-frm .
     1416   hide frame icnt-line-frm .
     1417       put stream PrnLibStream  v-line  skip  .
     1418       put stream PrnLibStream   skip(2)  .
     1419       run on-same-page in this-procedure (input 14) .
     1420       put stream PrnLibStream unformatted
     1421         "Инвентаризационная комиссия в составе:" SKIP(2)
     1422         "Председатель комиссии__________________________________ подпись _______________________________ " skip(2)
     1423         "Члены комиссии_________________________________________ подпись _______________________________ " skip(2)
     1424         "_______________________________________________________ подпись _______________________________ " skip(2)
     1425         "_______________________________________________________ подпись _______________________________ " skip(2)
     1426         .
     1427   hide stream PrnLibStream frame bottomframe .
     1428   output stream PrnLibStream close.
     1429   run waitfram-hide in this-procedure .
     1430   run prn-lib-prn-file in this-procedure (
     1431                                             input parParentProc
     1432                                             ,input 4
     1433                                             ).
     1434   procedure on-same-page :
     1435     define input parameter p-line-number as integer no-undo .
     1436     if p-line-number > page-size( PrnLibStream ) then do:
     1437       return .
     1438     end.
     1439     if line-counter( PrnLibStream ) + p-line-number > page-size( PrnLibStream ) then do:
     1440       page stream PrnLibStream .
     1441     end.
     1442   end procedure.
     1443   procedure next-page :
     1444     page stream PrnLibStream .
     1445   end procedure.
     1446   procedure clear-column-vars :
     1447     assign
     1448       v-column-4  = 0
     1449       v-column-5  = 0
     1450       v-column-6  = 0
     1451     .
     1452   end procedure.
