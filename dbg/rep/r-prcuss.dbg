     1203   define variable vss-include-info16 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1204   procedure factord :
     1205     define input  parameter p-fact-date            as date    no-undo .
     1206     define input  parameter p-fact-time            as integer no-undo .
     1207     define input  parameter p-fact-num             as integer no-undo .
     1208     define input  parameter p-shift-date           as date    no-undo .
     1209     define input  parameter p-shift-num            as integer no-undo .
     1210     define input  parameter p-shift-on             as logical no-undo .
     1211     define output parameter p-fact-order           as decimal no-undo .
     1212     define output parameter p-shift-end-fact-order as decimal no-undo .
     1213     define output parameter p-day-end-fact-order   as decimal no-undo .
     1214     define variable vss-description as character no-undo init "factord: Определение порядкового номера документа".
     1215     if p-fact-date = ?
     1216     then do:
     1217       return error "Не указана фактическая дата" .
     1218     end.
     1219     define variable v-fact-date-num as integer no-undo .
     1220     assign
     1221       v-fact-date-num = integer(p-fact-date)
     1222     .
     1223     if p-fact-num = ?
     1224     or p-fact-num = 0
     1225     then do:
     1226       return error "Не задан p-fact-num " + string(p-fact-num) .
     1227     end.
     1228     if p-fact-num < 0
     1229     then do:
     1230       return error "Отрицательный fact-num " + string(p-fact-num) .
     1231     end.
     1232     if p-fact-num >= 100000000
     1233     then do:
     1234       return error "Недопустимо большой fact-num " + string(p-fact-num) .
     1235     end.
     1236     if p-shift-on = true
     1237     then do:
     1238       if p-shift-date = ?
     1239       then do:
     1240         return error "Не задана дата смены" .
     1241       end.
     1242       if p-shift-num = ?
     1243       or p-shift-num = 0
     1244       then do:
     1245         return error "Не задан номер смены" .
     1246       end.
     1247     end.
     1248     else do:
     1249       assign
     1250         p-shift-date = p-fact-date
     1251         p-shift-num  = 24
     1252       .
     1253     end.
     1254     define variable v-shift-offset as integer no-undo .
     1255     if p-shift-date = p-fact-date
     1256     then do:
     1257       assign
     1258         v-shift-offset = 1
     1259       .
     1260     end.
     1261     if p-shift-date < p-fact-date
     1262     then do:
     1263       assign
     1264         v-shift-offset = 0
     1265       .
     1266     end.
     1267     if p-shift-date > p-fact-date
     1268     then do:
     1269       message
     1270         vss-workfile vss-revision vss-description skip
     1271         "Неправильная дата закрытия смены" skip
     1272         "Дата закрытия не смены не может быть раньше чем дата открытия смены" skip
     1273         view-as alert-box error .
     1274       undo, return error
     1275         substitute("Дата закрытия не смены &1 не может быть раньше чем дата открытия смены &2"
     1276           ,string(p-fact-date, '99/99/9999':U)
     1277           ,string(p-shift-date, '99/99/9999':U)
     1278           )
     1279       .
     1280     end.
     1281     if p-shift-num < 1
     1282     or p-shift-num > 24
     1283     then do:
     1284       message
     1285         vss-workfile vss-revision vss-description skip
     1286         "Неправильный номер смены" skip
     1287         "p-shift-num" p-shift-num skip
     1288         view-as alert-box error .
     1289       undo, return error return-value .
     1290     end.
     1291     assign
     1292       p-fact-order           = v-fact-date-num
     1293                              + v-shift-offset * 0.5
     1294                              + p-shift-num    * 0.02 - 0.01
     1295                              + p-fact-num     * 0.0000000001
     1296       p-shift-end-fact-order = v-fact-date-num
     1297                              + v-shift-offset * 0.5
     1298                              + p-shift-num    * 0.02
     1299       p-day-end-fact-order   = v-fact-date-num
     1300                              + 0.99
     1301     .
     1302     if p-fact-order           <= v-fact-date-num
     1303     or p-shift-end-fact-order <= v-fact-date-num
     1304     or p-fact-order           >= p-shift-end-fact-order - 0.0000000001
     1305     or p-shift-end-fact-order >= p-day-end-fact-order
     1306     then do:
     1307       message
     1308         vss-workfile vss-revision vss-description skip
     1309         "Внутренняя ошибка при генерации фактического номера" skip
     1310         "p-fact-date"            p-fact-date            skip
     1311         "p-fact-time"            p-fact-time            skip
     1312         "p-fact-num"             p-fact-num             skip
     1313         "p-shift-date"           p-shift-date           skip
     1314         "p-shift-num"            p-shift-num            skip
     1315         "p-shift-on"             p-shift-on             skip
     1316         "p-shift-end-fact-order" p-shift-end-fact-order skip
     1317         "p-day-end-fact-order"   p-day-end-fact-order   skip
     1318         "v-fact-date-num"        v-fact-date-num        skip
     1319         view-as alert-box error .
     1320       undo, return error return-value .
     1321     end.
     1322   end procedure.
     1323   procedure day-begin-fact-order :
     1324     define input  parameter p-fact-date            as date    no-undo .
     1325     define output parameter p-day-begin-fact-order as decimal no-undo .
     1326     do
     1327     on error undo, return error return-value
     1328     :
     1329       if p-fact-date = ?
     1330       then do:
     1331         assign
     1332           p-day-begin-fact-order = 0
     1333         .
     1334       end.
     1335       else do:
     1336         assign
     1337           p-day-begin-fact-order = integer(p-fact-date)
     1338         .
     1339       end.
     1340     end.
     1341   end procedure.
     1342   procedure factord-max-fact-order :
     1343     define output parameter p-max-fact-order as decimal   no-undo .
     1344     do
     1345     on error undo, return error return-value
     1346     :
     1347       run day-begin-fact-order in this-procedure
     1348         (input  date(1, 1, 5000)
     1349         ,output p-max-fact-order
     1350         ) .
     1351     end.
     1352   end procedure.
     1353   procedure factord-cut-archive :
     1354     define input  parameter p-obj-type             as character no-undo .
     1355     define input  parameter p-obj-code             as integer   no-undo .
     1356     define input  parameter p-fact-date            as date      no-undo .
     1357     define output parameter p-shift-on             as logical   no-undo .
     1358     define output parameter p-shift-date           as date      no-undo .
     1359     define output parameter p-shift-num            as integer   no-undo .
     1360     define output parameter p-day-end-fact-order   as decimal   no-undo .
     1361     define output parameter p-shift-end-fact-order as decimal   no-undo .
     1362     define variable v-fact-order as decimal   no-undo .
     1363     define buffer buf_shift-obj for ub.shift-obj .
     1364     do
     1365     on error undo, return error return-value
     1366     :
     1367   define variable vss-include-info17 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1368   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1369     (input  p-obj-type
     1370     ,input  p-obj-code
     1371     ,input  'shift-on=request'
     1372     ,output p-shift-on
     1373     ) no-error .
     1374       if error-status :error
     1375       then do:
     1376         message
     1377           vss-workfile vss-revision vss-description skip
     1378           "Ошибка при определении атрибута объекта" skip
     1379           "Объект" p-obj-type p-obj-code skip
     1380           error-status :get-message(1) skip
     1381           return-value skip
     1382           view-as alert-box error .
     1383         undo, return error return-value .
     1384       end.
     1385       if p-shift-on = false
     1386       then do:
     1387         assign
     1388           p-shift-date               = ?
     1389           p-shift-num                = 0
     1390         .
     1391       end.
     1392       else do:
     1393         find first buf_shift-obj share-lock
     1394           where buf_shift-obj.obj-type   = p-obj-type
     1395             and buf_shift-obj.obj-code   = p-obj-code
     1396             and buf_shift-obj.shift-date > p-fact-date
     1397           use-index pi
     1398           no-error .
     1399         if not available buf_shift-obj
     1400         or buf_shift-obj.status_ <> 'зкр':U
     1401         then do:
     1402           message
     1403             vss-workfile vss-revision vss-description skip
     1404             "Невозможно вычислить последнюю смену" skip
     1405             "Отсутствует закрытая смена с датой большей чем дата инициализации архива" skip
     1406             "Объект" p-obj-type p-obj-code skip
     1407             "Дата" p-fact-date skip
     1408             view-as alert-box error .
     1409           undo, return error return-value .
     1410         end.
     1411         find last buf_shift-obj share-lock
     1412           where buf_shift-obj.obj-type = p-obj-type
     1413             and buf_shift-obj.obj-code = p-obj-code
     1414             and buf_shift-obj.shift-date <= p-fact-date
     1415           use-index pi
     1416           no-error .
     1417         if available buf_shift-obj
     1418         then do:
     1419           if  buf_shift-obj.status_ = 'зкр':U
     1420           then do:
     1421             assign
     1422               p-shift-date = buf_shift-obj.shift-date
     1423               p-shift-num  = buf_shift-obj.shift-num
     1424             .
     1425           end.
     1426           else do:
     1427             message
     1428               vss-workfile vss-revision vss-description skip
     1429               "Невозможно вычислить последнюю смену" skip
     1430               "Статус смены отличен от статуса" 'зкр':U skip
     1431               "Объект" p-obj-type p-obj-code skip
     1432               "Дата" p-fact-date skip
     1433               "Смена" buf_shift-obj.shift-date buf_shift-obj.shift-num skip
     1434               view-as alert-box error .
     1435             undo, return error return-value .
     1436           end.
     1437         end.
     1438         else do:
     1439           assign
     1440             p-shift-date = p-fact-date - 1
     1441             p-shift-num  = 1
     1442           .
     1443         end.
     1444       end.
     1445       run factord in this-procedure
     1446         (input  p-fact-date
     1447         ,input  1
     1448         ,input  1
     1449         ,input  p-shift-date
     1450         ,input  p-shift-num
     1451         ,input  p-shift-on
     1452         ,output v-fact-order
     1453         ,output p-shift-end-fact-order
     1454         ,output p-day-end-fact-order
     1455         ) no-error .
     1456       if error-status :error
     1457       then do:
     1458         message
     1459           vss-workfile vss-revision vss-description skip
     1460           "Ошибка при вызове процедуры factord"
     1461           error-status :get-message(1) skip
     1462           return-value skip
     1463           view-as alert-box error .
     1464         undo, return error return-value .
     1465       end.
     1466     end.
     1467   end procedure.
     1468   procedure factord-lock-shift :
     1469     define input  parameter p-obj-type  as character no-undo .
     1470     define input  parameter p-obj-code  as integer   no-undo .
     1471     define input  parameter p-fact-date as date      no-undo .
     1472     define parameter buffer buf_shift-obj for ub.shift-obj .
     1473     define variable v-shift-on      as logical   no-undo .
     1474     define variable v-extra-message as character no-undo .
     1475     define variable v-error as character no-undo .
     1476     do
     1477     on error undo, return error return-value
     1478     :
     1479   define variable vss-include-info18 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     1480   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run objat in g#library
     1481     (input  p-obj-type
     1482     ,input  p-obj-code
     1483     ,input  'shift-on=request'
     1484     ,output v-shift-on
     1485     ) no-error .
     1486       if error-status :error
     1487       then do:
     1488         v-error = substitute("Ошибка при определении атрибута объекта  &1 &2 &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value) .
     1489         undo, return error v-error .
     1490       end.
     1491       if v-shift-on = true
     1492       then do:
     1493         find first buf_shift-obj share-lock
     1494           where buf_shift-obj.obj-type   = p-obj-type
     1495             and buf_shift-obj.obj-code   = p-obj-code
     1496             and buf_shift-obj.shift-date > p-fact-date
     1497           use-index pi
     1498           no-error .
     1499         if not available buf_shift-obj
     1500         or buf_shift-obj.status_ <> 'зкр':U
     1501         then do:
     1502           find last buf_shift-obj
     1503             where buf_shift-obj.obj-type = p-obj-type
     1504               and buf_shift-obj.obj-code = p-obj-code
     1505               and buf_shift-obj.status_  = 'зкр':U
     1506             use-index stts
     1507             no-error .
     1508           if available buf_shift-obj
     1509           then do:
     1510             assign
     1511               v-extra-message =
     1512                     substitute("Дата начала последеней закрытой смены на объекте &1"
     1513                               ,string(buf_shift-obj.shift-date, '99/99/9999':u)
     1514                               )
     1515             .
     1516           end.
     1517           v-error = substitute("Ошибка при блокировке смены объекта  &1 &2 Отсутствует закрытая смена с датой большей чем указанная дата  &5  &3 &4" ,p-obj-type , p-obj-code  , error-status :get-message(1) , return-value , p-fact-date) .
     1518           undo, return error v-error .
     1519         end.
     1520       end.
     1521     end.
     1522   end procedure.
     1523   procedure factord-end-day :
     1524     define input  parameter p-fact-date            as date    no-undo .
     1525     define output parameter p-day-end-fact-order   as decimal no-undo .
     1526     do
     1527     on error undo, return error return-value
     1528     :
     1529       if p-fact-date = ?
     1530       then do:
     1531         return error "Не указана фактическая дата" .
     1532       end.
     1533       assign
     1534         p-day-end-fact-order = integer(p-fact-date) + 0.99
     1535       .
     1536     end.
     1537   end procedure.
     1538   procedure factord-to-date :
     1539     define input  parameter p-fact-order as decimal no-undo .
     1540     define output parameter p-fact-date  as date    no-undo .
     1541     define variable v-ref-date  as date      no-undo .
     1542     define variable v-ref-delta as integer   no-undo .
     1543     do
     1544     on error undo, return error return-value
     1545     :
     1546       if p-fact-order = ?
     1547       or p-fact-order = 0
     1548       then do:
     1549         return error "Не указан fact-order" .
     1550       end.
     1551       assign
     1552         v-ref-date  = date(1, 1, 2000)
     1553       .
     1554       assign
     1555         v-ref-delta = integer(truncate(p-fact-order, 0)) - integer(v-ref-date)
     1556       .
     1557       assign
     1558         p-fact-date = v-ref-date + v-ref-delta
     1559       .
     1560     end.
     1561   end procedure.
     1562   procedure factord-to-fact-num :
     1563     define input  parameter p-fact-order as decimal no-undo .
     1564     define output parameter p-fact-num   as integer no-undo .
     1565     define variable v-fact-order-trunc as decimal no-undo .
     1566     do
     1567     on error undo, return error return-value
     1568     :
     1569       if p-fact-order = ?
     1570       or p-fact-order = 0
     1571       then do:
     1572         return error "Не указан fact-order" .
     1573       end.
     1574       assign
     1575        v-fact-order-trunc = truncate(p-fact-order, 2)
     1576       .
     1577       assign
     1578         p-fact-num = (p-fact-order - v-fact-order-trunc ) * 10000000000
     1579       .
     1580     end.
     1581   end procedure.
     1582   procedure factord-to-shift-num :
     1583     define input  parameter p-fact-order as decimal no-undo .
     1584     define output parameter p-shift-num   as integer no-undo .
     1585     define variable  p-shift-numd  as decimal   no-undo .
     1586     define variable v-fact-order-trunc as decimal no-undo .
     1587     do
     1588     on error undo, return error return-value
     1589     :
     1590       if p-fact-order = ?
     1591       or p-fact-order = 0
     1592       then do:
     1593         return error "Не указан fact-order" .
     1594       end.
     1595       assign
     1596        v-fact-order-trunc = truncate(p-fact-order, 2)  - truncate(p-fact-order,0)
     1597       .
     1598       if v-fact-order-trunc < 0.5 then do:
     1599         v-fact-order-trunc = v-fact-order-trunc + 0.5.
     1600       end.
     1601       assign
     1602         p-shift-numd = (( v-fact-order-trunc  * 100 - 50 ) + 1 ) / 2
     1603         .
     1604        assign
     1605         p-shift-num = truncate (p-shift-numd , 0)
     1606       .
     1607     end.
     1608   end procedure.
     1609   define temp-table temp-font no-undo
     1610     field fontnum  as integer
     1611     field fontname as character
     1612     field fontsize as character
     1613     field fonttype as character
     1614     field font-h   as integer
     1615     field font-w   as integer
     1616     field v-row    as integer
     1617     field v-col    as integer
     1618     field v-row-lans as integer
     1619     field v-col-lans as integer
     1620   index pi fontnum
     1621   .
     1622   procedure get-font-ini :
     1623     do
     1624     on error undo, return error return-value
     1625     :
     1626   define variable ii as integer   no-undo .
     1627   define variable v-font7 as character no-undo .
     1628   define variable v-font as character no-undo .
     1629   define variable loc-name as character no-undo .
     1630   define variable loc-size as character no-undo .
     1631   define variable loc-type as character no-undo .
     1632   define variable old_H as integer   no-undo .
     1633   define variable old_w as integer   no-undo .
     1634   define variable old-row  as integer   no-undo .
     1635   define variable old-col  as integer   no-undo .
     1636   define variable old-row-lans  as integer   no-undo .
     1637   define variable old-col-lans  as integer   no-undo .
     1638   define variable vv as integer   no-undo .
     1639   empty temp-table temp-font.
     1640     GET-KEY-VALUE SECTION "fonts" KEY "font7" VALUE v-font7 .
     1641       case num-entries (v-font7) :
     1642         when 4 then do:
     1643             assign
     1644               loc-name = entry ( 1 , v-font7 )
     1645               loc-size = entry ( 2 , v-font7 )
     1646               loc-type = entry ( 3 , v-font7 ) + "," +  entry ( 4 , v-font7 )
     1647             .
     1648         end.
     1649         when 3 then do:
     1650             assign
     1651               loc-name = entry ( 1 , v-font7 )
     1652               loc-size = entry ( 2 , v-font7 )
     1653               loc-type = entry ( 3 , v-font7 )
     1654             .
     1655         end.
     1656         when 2 then  do:
     1657             assign
     1658               loc-name = entry ( 1 , v-font7 )
     1659               loc-size = entry ( 2 , v-font7 )
     1660               loc-type = ""
     1661             .
     1662         end.
     1663         when 1 then do:
     1664             assign
     1665               loc-name = trim(entry ( 1 , v-font7 ))
     1666               loc-size = ""
     1667               loc-type = ""
     1668             .
     1669         end.
     1670       end case.
     1671     create temp-font.
     1672     assign
     1673       temp-font.fontnum  = 7
     1674       temp-font.fontname = trim(loc-name)
     1675       temp-font.fontsize = trim(loc-size)
     1676       temp-font.fonttype = trim(loc-type)
     1677       temp-font.v-row    = 62
     1678       temp-font.v-col    = 136
     1679       temp-font.v-row-lans = 43
     1680       temp-font.v-col-lans = 198
     1681     .
     1682     repeat ii = 16 to 100 :
     1683       get-key-value section 'fonts' key 'font' + string(ii)   value v-font  .
     1684       if v-font = "" or v-font = ? then leave.
     1685       case num-entries (v-font) :
     1686         when 4 then do:
     1687             assign
     1688               loc-name = entry ( 1 , v-font )
     1689               loc-size = entry ( 2 , v-font )
     1690               loc-type = entry ( 3 , v-font ) + "," +  entry ( 4 , v-font )
     1691             .
     1692         end.
     1693         when 3 then do:
     1694             assign
     1695               loc-name = entry ( 1 , v-font )
     1696               loc-size = entry ( 2 , v-font )
     1697               loc-type = entry ( 3 , v-font )
     1698             .
     1699         end.
     1700         when 2 then do:
     1701             assign
     1702               loc-name = entry ( 1 , v-font )
     1703               loc-size = entry ( 2 , v-font )
     1704               loc-type = ""
     1705             .
     1706         end.
     1707         when 1 then do:
     1708             assign
     1709               loc-name = trim(entry ( 1 , v-font ))
     1710               loc-size = ""
     1711               loc-type = ""
     1712             .
     1713         end.
     1714       end case.
     1715     create temp-font.
     1716     assign
     1717       temp-font.fontnum  = ii
     1718       temp-font.fontname = trim(loc-name)
     1719       temp-font.fontsize = trim(loc-size)
     1720       temp-font.fonttype = trim(loc-type)
     1721     .
     1722     end.
     1723       for each temp-font :
     1724          vv = integer(entry(2,temp-font.fontsize, "=" )) no-error .
     1725          if  vv = ? then vv =  0 .
     1726           run rep/exfont.p (
     1727             input   temp-font.fontname ,
     1728             input   vv ,
     1729             input   temp-font.fonttype ,
     1730             output  temp-font.font-h   ,
     1731             output  temp-font.font-w   )
     1732           .
     1733       end.
     1734   find first temp-font where  temp-font.fontnum  = 7  .
     1735   old_H = temp-font.font-H .
     1736   old_w = temp-font.font-W .
     1737   old-row = temp-font.v-row .
     1738   old-col = temp-font.v-col .
     1739   old-row-lans = temp-font.v-row-lans .
     1740   old-col-lans = temp-font.v-col-lans .
     1741       for each temp-font where
     1742                temp-font.fontnum  <> 7 :
     1743           assign
     1744               temp-font.v-row    = old_H * old-row / temp-font.font-h
     1745               temp-font.v-col    = old_W * old-col / temp-font.font-W
     1746               temp-font.v-row-lans    = old_H * old-row-lans / temp-font.font-h
     1747               temp-font.v-col-lans    = old_W * old-col-lans / temp-font.font-W
     1748           .
     1749       end.
     1750     end.
     1751   end procedure.
     1752   PROCEDURE How-name :
     1753   define input  parameter h as integer no-undo .
     1754   define input  parameter w as integer no-undo .
     1755   define output parameter n as character  no-undo .
     1756   define variable A4port-H as integer   no-undo init 63.
     1757   define variable A4port-W as integer   no-undo init 136.
     1758   define variable A4lans-H as integer   no-undo init 43.
     1759   define variable A4lans-W as integer   no-undo init 198.
     1760   define variable Strim-W  as integer   no-undo init 278.
     1761   run define-a4-size (
     1762        input ReportFontNum
     1763       ,output A4port-H
     1764       ,output A4port-W
     1765       ,output A4lans-H
     1766       ,output A4lans-W ).
     1767   If w >= 1 and w <= A4port-W Then DO:
     1768     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1769     If h > A4lans-H  and h <= A4port-H Then n = "A4-port":U.
     1770     If h > A4port-H              Then n = "to-file":U.
     1771   End.
     1772   If w > A4port-W and w <= A4lans-W Then DO:
     1773     If h >= 1  and h <= A4lans-H Then n = "A4-lans":U.
     1774     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1775     If h > A4port-H              Then n = "to-file":U.
     1776   End.
     1777   If w > A4lans-W and w <= Strim-W Then DO:
     1778     If h >= 1  and h <= A4lans-H Then n = "to-file":U.
     1779     If h > A4lans-H  and h <= A4port-H Then n = "A3-lans":U.
     1780     If h > A4port-H              Then n = "to-file":U.
     1781   End.
     1782   If w > Strim-W Then DO:
     1783      n = "to-file":U.
     1784   End.
     1785   END PROCEDURE.
     1786   PROCEDURE define-a4-size :
     1787   define input  parameter p-ReportFontNum as integer   no-undo .
     1788   define output parameter A4port-H as integer   no-undo .
     1789   define output parameter A4port-W as integer   no-undo .
     1790   define output parameter A4lans-H as integer   no-undo .
     1791   define output parameter A4lans-W as integer   no-undo .
     1792   if not can-find (first temp-font ) then do:
     1793      run get-font-ini .
     1794   end.
     1795   find first temp-font where temp-font.fontnum = p-ReportFontNum no-error .
     1796   if available temp-font then do:
     1797   assign
     1798     A4port-H = temp-font.v-row
     1799     A4port-W = temp-font.v-col
     1800     A4lans-H = temp-font.v-row-lans
     1801     A4lans-W = temp-font.v-col-lans
     1802   .
     1803   end.
     1804   else do:
     1805   assign
     1806     A4port-H = 63
     1807     A4port-W = 136
     1808     A4lans-H = 43
     1809     A4lans-W = 198
     1810   .
     1811   end.
     1812   END PROCEDURE.
