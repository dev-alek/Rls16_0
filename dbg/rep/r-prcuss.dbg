     3209                       temp-price.plt-id     = buf_price-all.plt-id
     3210                       temp-price.plt-db-num = buf_price-all.plt-db-num
     3211                   .
     3212                   find first temp-pdf where
     3213                             temp-pdf.b-code     = buf_price-all.b-code     and
     3214                             temp-pdf.plt-id     = buf_price-all.plt-id     and
     3215                             temp-pdf.plt-db-num = buf_price-all.plt-db-num  no-error .
     3216                   if not available temp-pdf then do:
     3217                       create temp-pdf.
     3218                       assign
     3219                           temp-pdf.gds-code   = buf_bar-code.gds-code
     3220                           temp-pdf.prior      = buf_price-all.plt-priority
     3221                           temp-pdf.date1      = buf_price-all.start-date
     3222                           temp-pdf.date2      = buf_price-all.end-date
     3223                           temp-pdf.b-code     = buf_price-all.b-code
     3224                           temp-pdf.plt-id     = buf_price-all.plt-id
     3225                           temp-pdf.plt-db-num = buf_price-all.plt-db-num
     3226                           temp-pdf.gds-name   = buf_goods.gds-name
     3227                           temp-pdf.unit-cli   = buf_goods.unit-cli
     3228                           temp-pdf.price-roz  = gp-price-sale
     3229                           temp-pdf.artic      = buf_goods.artic
     3230                           temp-pdf.prod-typecode  = buf_goods.prod-type + string(buf_goods.prod-code)
     3231                           temp-pdf.prod-name  = buf_clients.obj-name
     3232                           temp-pdf.grp-code   = buf_goods.grp-code
     3233                           temp-pdf.grp-name   = buf_goods.grp-name
     3234                       .
     3235                   end.
     3236                 end.
     3237         end.
     3238       end.
     3239     end case.
     3240   end.
     3241   end procedure.
     3242   procedure din-tt-go :
     3243   define input  parameter p-table-name    as character no-undo .
     3244   define input  parameter P-query-prepare as character no-undo .
     3245   define input  parameter p-sort-pole  as character no-undo .
     3246   define input  parameter p-sort-pole2 as character no-undo .
     3247   define variable qh as widget-handle no-undo .
     3248   define variable bh as widget-handle no-undo .
     3249   define variable old-sort-pole as character no-undo .
     3250   define variable new-sort-pole as character no-undo .
     3251   define variable old-sort-pole2 as character no-undo .
     3252   define variable new-sort-pole2 as character no-undo .
     3253     do
     3254     on error undo, return error return-value
     3255     :
     3256       create buffer bh for table p-table-name.
     3257       create query qh.
     3258         qh:set-buffers (bh).
     3259         qh:query-prepare (p-query-prepare).
     3260         qh:query-open ().
     3261         qh:get-first ().
     3262         if bh:available <> true then do:
     3263            qh:query-close() .
     3264            delete object qh.
     3265            delete object bh.
     3266            return.
     3267          end.
     3268          old-sort-pole  = bh:buffer-field ( p-sort-pole  ):buffer-value .
     3269          old-sort-pole2 = bh:buffer-field ( p-sort-pole2 ):buffer-value .
     3270          run print-grp-header  ( bh:recid , old-sort-pole ) .
     3271          run print-grp-header2 ( bh:recid , old-sort-pole2 ) .
     3272         do while qh:query-off-end = false :
     3273             new-sort-pole  = bh:buffer-field ( p-sort-pole ):buffer-value .
     3274             new-sort-pole2 = bh:buffer-field ( p-sort-pole2):buffer-value .
     3275             if old-sort-pole <> new-sort-pole then do:
     3276               run print-grp-header ( bh:recid , new-sort-pole ) .
     3277             end.
     3278                 if old-sort-pole2 <> new-sort-pole2 or old-sort-pole <> new-sort-pole
     3279                 then do:
     3280                   run print-grp-header2 ( bh:recid , new-sort-pole2 ) .
     3281                 end.
     3282             run print-line ( bh:recid ) .
     3283             qh:get-next().
     3284             old-sort-pole  = new-sort-pole.
     3285             old-sort-pole2 = new-sort-pole2.
     3286         end.
     3287       qh:query-close() .
     3288       delete object qh.
     3289       delete object bh.
     3290     end.
     3291   end procedure.
     3292   procedure print-grp-header :
     3293   define input  parameter p-recid as recid no-undo .
     3294   define input  parameter p-sort-pole as character no-undo .
     3295   define buffer buf_temp-pdf for temp-pdf  .
     3296   define variable v-name as character no-undo .
     3297   define variable v-val as character no-undo .
     3298     do
     3299     on error undo, return error return-value
     3300     :
     3301       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     3302       case v-clas:
     3303           when "no-classify":U then do:
     3304               return.
     3305           end.
     3306           when "prod":U        then do:
     3307             v-name = "По производителю " .
     3308             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     3309             else      v-val = p-sort-pole.
     3310           end.
     3311           when "grp-goods":U   then do:
     3312             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     3313             else      v-val = p-sort-pole.
     3314           end.
     3315           when "prod/grp-goods":U then do:
     3316             v-name = "По производителю " .
     3317             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     3318             else      v-val = p-sort-pole.
     3319           end.
     3320           when "grp-goods/prod":U then do:
     3321             v-name = "По группе " .
     3322             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     3323             else      v-val = p-sort-pole.
     3324           end.
     3325       end case.
     3326       put stream outstream unformatted  ( v-name + v-val ) at 1 skip .
     3327       num#col# = 2 .
     3328       num#str# = num#str# + 1 .
     3329       run macr_cell_format in this-procedure
     3330           ( 10    ,
     3331             true  ,
     3332             false ,
     3333             ?     ,
     3334             num#str# ,
     3335             num#col# ,
     3336             num#str# ,
     3337             num#col# ) .
     3338       run macr_excel_char in this-procedure( v-name + v-val  , num#str# , num#col#   ) .
     3339     end.
     3340   end procedure.
     3341   procedure print-grp-header2 :
     3342   define input  parameter p-recid as recid no-undo .
     3343   define input  parameter p-sort-pole as character no-undo .
     3344   define buffer buf_temp-pdf for temp-pdf  .
     3345   define variable v-name as character no-undo .
     3346   define variable v-val as character no-undo .
     3347     do
     3348     on error undo, return error return-value
     3349     :
     3350       find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     3351       case v-clas:
     3352           when "no-classify":U then do:
     3353               return.
     3354           end.
     3355           when "prod":U        then do:
     3356              return.
     3357           end.
     3358           when "grp-goods":U   then do:
     3359              return.
     3360           end.
     3361           when "prod/grp-goods":U then do:
     3362             v-name = "По группе " .
     3363             if available buf_temp-pdf then v-val = buf_temp-pdf.grp-name .
     3364                                       else v-val = p-sort-pole.
     3365           end.
     3366           when "grp-goods/prod":U then do:
     3367             v-name = "По производителю " .
     3368             if available buf_temp-pdf then v-val = buf_temp-pdf.prod-name .
     3369                                       else v-val = p-sort-pole.
     3370           end.
     3371       end case.
     3372       put stream outstream unformatted  ( v-name + v-val ) at 10 skip .
     3373       num#col# = 2 .
     3374       num#str# = num#str# + 1 .
     3375       run macr_cell_format in this-procedure
     3376           ( 10    ,
     3377             true  ,
     3378             false ,
     3379             ?     ,
     3380             num#str# ,
     3381             num#col# ,
     3382             num#str# ,
     3383             num#col# ) .
     3384       run macr_excel_char in this-procedure ( v-name + v-val  , num#str# , num#col# ) .
     3385     end.
     3386   end procedure.
     3387   def var vss-include-info39 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
     3388   procedure macr_excel_char :
     3389    do
     3390    on error undo, return error return-value
     3391    :
     3392    define input parameter  p-val as character no-undo .
     3393    define input parameter  p-row as integer no-undo .
     3394    define input parameter  p-col as integer no-undo .
     3395    if p-val = ? then p-val = "" .
     3396       put stream macr_excel unformatted
     3397             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3398    end.
     3399   end procedure.
     3400   procedure macr_excel_char_with_format :
     3401    do
     3402    on error undo, return error return-value
     3403    :
     3404    define input parameter  p-val as character no-undo .
     3405    define input parameter  p-row as integer no-undo .
     3406    define input parameter  p-col as integer no-undo .
     3407    if p-val = ? then p-val = "" .
     3408       put stream macr_excel unformatted
     3409             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3410       put stream macr_excel unformatted 'format.number("@")' + chr(10) .
     3411       put stream macr_excel unformatted
     3412             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3413    end.
     3414   end procedure.
     3415   procedure macr_excel_cell_format :
     3416    do
     3417    on error undo, return error return-value
     3418    :
     3419    define input parameter  p-val    as character no-undo .
     3420    define input parameter  p-row    as integer   no-undo .
     3421    define input parameter  p-col    as integer   no-undo .
     3422    define input parameter  p-format as character no-undo .
     3423    if p-val = ? then p-val = "" .
     3424       put stream macr_excel unformatted
     3425             substitute('select("r&1c&2")', p-row , p-col ) + chr(10) .
     3426       put stream macr_excel unformatted substitute('format.number("&1")', p-format) + chr(10) .
     3427       put stream macr_excel unformatted
     3428             substitute('formula(&3,"r&1c&2")', p-row , p-col , format-excel-text-macr ( p-val) ) + chr(10)  .
     3429    end.
     3430   end procedure.
     3431   procedure macr_excel_sum :
     3432    do
     3433    on error undo, return error return-value
     3434    :
     3435    define input parameter  p-row as integer no-undo .
     3436    define input parameter  p-col as integer no-undo .
     3437    define input parameter  p-row1 as integer no-undo .
     3438    define input parameter  p-col1 as integer no-undo .
     3439    define input parameter  p-row2 as integer no-undo .
     3440    define input parameter  p-col2 as integer no-undo .
     3441       put stream macr_excel unformatted
     3442             substitute('formula("=sum(r&3c&4:r&5c&6)","r&1c&2")', p-row , p-col , p-row1 , p-col1 ,p-row2 , p-col2 ) + chr(10)  .
     3443    end.
     3444   end procedure.
     3445   procedure macr_excel_dec :
     3446    do
     3447    on error undo, return error return-value
     3448    :
     3449    define input parameter  p-val as character no-undo .
     3450    define input parameter  p-row as integer   no-undo .
     3451    define input parameter  p-col as integer   no-undo .
     3452     if p-val = ? then p-val =  "" .
     3453      put  stream macr_excel unformatted
     3454           substitute('formula(&3,"r&1c&2")', p-row , p-col ,  p-val )  + chr(10) .
     3455    end.
     3456   end procedure.
     3457   procedure macr_cell_format :
     3458    do
     3459    on error undo, return error return-value
     3460    :
     3461    define input parameter  p-size   as integer   no-undo .
     3462    define input parameter  p-bold   as logical   no-undo .
     3463    define input parameter  p-italic as logical   no-undo .
     3464    define input parameter  p-color  as integer   no-undo .
     3465    define input parameter  p-row    as integer   no-undo .
     3466    define input parameter  p-col    as integer   no-undo .
     3467    define input parameter  p-row-2  as integer   no-undo .
     3468    define input parameter  p-col-2  as integer   no-undo .
     3469     if p-size = ? then p-size = 10 .
     3470     if p-bold = ? then p-bold = false .
     3471     if p-italic = ? then p-italic = false .
     3472     if p-row-2 = ? then p-row-2 = p-row .
     3473     if p-col-2 = ? then p-col-2 = p-col .
     3474     put  stream macr_excel unformatted
     3475      substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 ) + chr(10) .
     3476     if p-color <> ? then do:
     3477        put  stream macr_excel unformatted
     3478          substitute('patterns(1,,&1,true)', p-color ) + chr(10)  .
     3479     end.
     3480     put  stream macr_excel unformatted
     3481          substitute('format.font(,&1,&2,&3)' , p-size,
     3482                                           string ( p-bold  , "true/false" ) ,
     3483                                           string ( p-italic , "true/false" )
     3484                                           ) + chr(10) .
     3485    end.
     3486   end procedure.
     3487   procedure macr_cell_size :
     3488    do
     3489    on error undo, return error return-value
     3490    :
     3491    define input parameter  p-w   as integer   no-undo .
     3492    define input parameter  p-l   as integer   no-undo .
     3493    define input parameter  p-row    as integer   no-undo .
     3494    define input parameter  p-col    as integer   no-undo .
     3495    define input parameter  p-row-2  as integer   no-undo .
     3496    define input parameter  p-col-2  as integer   no-undo .
     3497     if p-row-2 = ? then p-row-2 = p-row .
     3498     if p-col-2 = ? then p-col-2 = p-col .
     3499     if p-w = ? then    p-w = 0 .
     3500     if p-l = ? then    p-l = 0 .
     3501    define variable s-w as character no-undo .
     3502    define variable s-l as character no-undo .
     3503    if p-w = 0 then s-w = "" .
     3504               else s-w = string(p-w)  .
     3505    if p-l = 0 then s-l = "" .
     3506               else s-l = string(p-l)  .
     3507   put  stream macr_excel unformatted
     3508        substitute('select("r&1c&2:r&3c&4 ")' , p-row , p-col , p-row-2 , p-col-2 )  skip .
     3509   put  stream macr_excel unformatted
     3510        substitute('COLUMN.WIDTH(&1,,,,)' , s-w  )  skip.
     3511   put  stream macr_excel unformatted
     3512        'FORMAT.TEXT(2,2,0,,,,,)'  skip.
     3513    end.
     3514   end procedure.
     3515   procedure proc-print-header :
     3516    do
     3517    on error undo, return error return-value
     3518    :
     3519      find first sheetf .
     3520        sheetf.excel-row-heder =  num-entries( c-str ,chr(10)) + 1.
     3521        sheetf.excel-row-title =  num-entries( sheetf.excel-column-lable , chr(10) ).
     3522        var-1 =  num#str# .
     3523        repeat c-c = 1 to sheetf.excel-row-title :
     3524        num#str# = num#str# + 1 .
     3525        p-var = num-entries( entry (c-c, sheetf.excel-column-lable, chr(10)) , chr(44) ) .
     3526        do c-i = 1 to p-var :
     3527           str--1 = entry( c-i, entry (c-c,sheetf.excel-column-lable, chr(10)) , chr(44)) .
     3528           str--2 = integer(entry( c-i, sheetf.sizes )) .
     3529           num#col# = c-i .
     3530           run macr_excel_char_with_format ( str--1  , num#str# , num#col#  ) .
     3531           run macr_cell_size ( str--2 , ? , num#str# , num#col# , ?, ? ) .
     3532        end.
     3533       c-i = 0.
     3534       end.
     3535       run macr_cell_format (
     3536           10       ,
     3537           true     ,
     3538           false    ,
     3539           35       ,
     3540           var-1 + 1,
     3541           1        ,
     3542           num#str# ,
     3543           num#col# )
     3544           .
     3545     put  stream macr_excel unformatted
     3546          substitute('select("r&1c&2:r&3c&4 ")' , var-1 + 1 , 1 , num#str# ,  num#col# ) + chr(10)  +
     3547          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     3548          .
     3549    end.
     3550   end procedure.
     3551   procedure end-proc :
     3552    do
     3553    on error undo, return error return-value
     3554    :
     3555     v-file-name = ( string( session:temp-directory + "rpt" + string( g#report-num ) ) + ".t-t").
     3556     OUTPUT to VALUE (v-file-name) .
     3557     for each temp-param :
     3558       export  temp-param  .
     3559     end.
     3560    end.
     3561   end procedure.
