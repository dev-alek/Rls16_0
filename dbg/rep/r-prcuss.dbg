     1968   define variable p-sort-pole as character no-undo .
     1969   define variable p-sort-pole2 as character no-undo .
     1970   define variable p-sort-pole-a as character no-undo .
     1971   define variable p-query-prepare as character no-undo .
     1972   define variable p-table-name as character no-undo .
     1973   p-table-name = "temp-pdf" .
     1974   case v-sort :
     1975     when "sort-code":U  then do:
     1976       p-sort-pole-a = "temp-pdf.b-code" .
     1977     end.
     1978     when "sort-artic":U then do:
     1979         p-sort-pole-a = "temp-pdf.artic" .
     1980     end.
     1981     when "sort-name":U then do:
     1982         p-sort-pole-a = "temp-pdf.gds-name" .
     1983     end.
     1984   end case.
     1985   case v-clas:
     1986       when "no-classify":U then do:
     1987          p-query-prepare  = substitute( "for each temp-pdf by &1 " , p-sort-pole-a ).
     1988          p-sort-pole   = "nul" .
     1989          p-sort-pole2  = "nul" .
     1990       end.
     1991       when "prod":U        then do:
     1992          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.prod-typecode" , p-sort-pole-a).
     1993          p-sort-pole   = "prod-typecode" .
     1994          p-sort-pole2  = "nul" .
     1995       end.
     1996       when "grp-goods":U   then do:
     1997          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 " , "temp-pdf.grp-code" , p-sort-pole-a).
     1998          p-sort-pole   = "grp-code" .
     1999          p-sort-pole2  = "nul" .
     2000       end.
     2001       when "prod/grp-goods":U then do:
     2002          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.prod-typecode" , "temp-pdf.grp-code" , p-sort-pole-a) .
     2003          p-sort-pole   = "prod-typecode" .
     2004          p-sort-pole2  = "grp-code" .
     2005       end.
     2006       when "grp-goods/prod":U then do:
     2007          p-query-prepare  = substitute( "for each temp-pdf by &1 by &2 by &3 " , "temp-pdf.grp-code" , "temp-pdf.prod-typecode" , p-sort-pole-a) .
     2008          p-sort-pole   = "grp-code" .
     2009          p-sort-pole2  = "prod-typecode" .
     2010       end.
     2011   end case.
     2012        run din-tt-go (
     2013             p-table-name    ,
     2014             P-query-prepare ,
     2015             p-sort-pole ,
     2016             p-sort-pole2
     2017             ).
     2018         run print-all-itog in this-procedure .
     2019         run on-same-page in this-procedure (input 1) .
     2020         run PrintPodval in this-procedure .
     2021         run paramls-write in this-procedure
     2022         (input "file"
     2023         ,input string(v-ind) + obj-list.obj-name
     2024         ,input v-file-name
     2025         ) .
     2026         page stream OutStream .
     2027       end.
     2028   HIDE STREAM OutStream FRAME plan-menu.
     2029   HIDE stream OutStream FRAME BottomFrame .
     2030   HIDE stream OutStream FRAME BottomFrame2 .
     2031   output stream OutStream CLOSE .
     2032   Output stream Macr_Excel  close .
     2033   if mFrameView
     2034   then do:
     2035      HIDE FRAME InfoFrame.
     2036   end.
     2037       run paramls-write in this-procedure
     2038           (input "charcol"
     2039           ,input ""
     2040           ,input "1,2,3"
     2041           ) .
     2042     define variable v-user-action as character no-undo .
     2043     define variable v-printed as logical   no-undo .
     2044     define variable DisabledOptions as integer   no-undo .
     2045     run end-proc in this-procedure .
     2046     define variable v-orient-page as character no-undo .
     2047     run How-name in this-procedure (
     2048         input ReportPageHeight,
     2049         input ReportPageWidth,
     2050         output v-orient-page )
     2051         .
     2052     if v-orient-page = "A4-lans":U then DisabledOptions = 8 .
     2053                                    else DisabledOptions = 0 .
     2054     run gbl/prnfilen.w
     2055       (input  ""
     2056       ,input  DisabledOptions
     2057       ,input  string(session :temp-directory) + "rpt" + string( g#report-num )
     2058       ,input ReportFontNum
     2059       ,output v-user-action
     2060       ,output v-printed
     2061       ) .
     2062   procedure print-line :
     2063   do on error undo, return error return-value :
     2064   define input  parameter p-recid as recid no-undo .
     2065   define buffer buf_temp-pdf for temp-pdf  .
     2066   find first buf_temp-pdf where recid(buf_temp-pdf) = p-recid no-error .
     2067   define variable  p-code       as character no-undo .
     2068   define variable  p-artic      as character no-undo .
     2069   define variable  p-name       as character no-undo .
     2070   define variable  p-prod-name  as character no-undo .
     2071   define variable  p-unit-cli   as character no-undo .
     2072   define variable  p-plt-id     as decimal   no-undo .
     2073   define variable  p-price-roz  as decimal   no-undo .
     2074   p-code      = string(buf_temp-pdf.b-code) .
     2075   p-artic     = buf_temp-pdf.artic   .
     2076   p-name      = buf_temp-pdf.gds-name .
     2077   p-prod-name = buf_temp-pdf.prod-name .
     2078   p-unit-cli  = buf_temp-pdf.unit-cli .
     2079   p-plt-id    = buf_temp-pdf.plt-id .
     2080   p-price-roz = buf_temp-pdf.price-roz .
     2081     assign
     2082        Lines_Counter = Lines_Counter + 1
     2083       .
     2084     if line-counter( OutStream ) + 2 > page-size( OutStream ) then do:
     2085        run p-line in this-procedure.
     2086        page stream OutStream.
     2087        PUT STREAM OutStream UNFORMATTED
     2088            string( "Лист " + string( PAGE-NUMBER(OutStream) , ">>>>9") ) AT 100 format "X(13)" SKIP .
     2089        run print-1 in this-procedure.
     2090        end.
     2091     if line-counter( OutStream ) < Tmp_Counter then
     2092       assign
     2093       .
     2094     assign
     2095       Tmp_Counter  = line-counter( OutStream )
     2096       num-ln = num-ln + 1
     2097     .
     2098     if line-counter( OutStream ) + j > page-size( OutStream ) then  PAGE STREAM OutStream.
     2099   define variable ii as integer   no-undo .
     2100   define variable v-price-sale as decimal   no-undo .
     2101       num#col# = 1.
     2102       num#str# = num#str# + 1.
     2103       run macr_excel_char in this-procedure(p-code      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2104       run macr_excel_char in this-procedure(p-artic     , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2105       run macr_excel_char in this-procedure(p-name      , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2106       run macr_excel_char in this-procedure(p-prod-name , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2107       run macr_excel_char in this-procedure(p-unit-cli  , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2108       run macr_excel_char in this-procedure(p-plt-id    , num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2109       if p-price-roz = 0 or p-price-roz = ?
     2110       then do:
     2111         PUT STREAM OutStream UNFORMATTED
     2112             sym1                format "X(1)" space(0)
     2113             p-code              format "X(10)" space(0)
     2114             sym2                format "X(1)" space(0)
     2115             p-artic             format "X(16)" space(0)
     2116             sym3                format "X(1)" space(0)
     2117             p-name              format "X(30)" space(0)
     2118             sym4                format "X(1)" space(0)
     2119             p-prod-name         format "X(30)" space(0)
     2120             sym5                format "X(1)" space(0)
     2121             p-unit-cli          format "X(7)" space(0)
     2122             sym6                format "X(1)" space(0)
     2123             p-plt-id            format ">>>>>>9"   space(0)
     2124             sym7                format "X(1)" space(0)
     2125             v-strline           format "x(17)" space(0)
     2126         .
     2127         run macr_excel_char in this-procedure(v-strline, num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2128         assign
     2129           f-price-roz = true
     2130         .
     2131       end.
     2132       else do:
     2133         PUT STREAM OutStream UNFORMATTED
     2134             sym1                format "X(1)" space(0)
     2135             p-code              format "X(10)" space(0)
     2136             sym2                format "X(1)" space(0)
     2137             p-artic             format "X(16)" space(0)
     2138             sym3                format "X(1)" space(0)
     2139             p-name              format "X(30)" space(0)
     2140             sym4                format "X(1)" space(0)
     2141             p-prod-name         format "X(30)" space(0)
     2142             sym5                format "X(1)" space(0)
     2143             p-unit-cli          format "X(7)" space(0)
     2144             sym6                format "X(1)" space(0)
     2145             p-plt-id            format ">>>>>>9"   space(0)
     2146             sym7                format "X(1)" space(0)
     2147             p-price-roz         format ">>>>>>>>>>>>>9.99" space(0)
     2148         .
     2149         run macr_excel_dec in this-procedure(p-price-roz, num#str# , num#col#   ) . assign    num#col# = num#col# + 1 .
     2150         assign
     2151           f-price-roz = false
     2152         .
     2153       end.
     2154         repeat ii = 1 to v-kol-price :
     2155           find first  temp-price where
     2156                       temp-price.plt-id     = buf_temp-pdf.plt-id     and
     2157                       temp-price.plt-db-num = buf_temp-pdf.plt-db-num and
     2158                       temp-price.gds-code = int(p-code) and
     2159                       temp-price.id = ii no-error .
     2160                       if available temp-price then  v-price-sale = temp-price.price-sale .
     2161                                               else v-price-sale = 0 .
     2162           put stream outstream unformatted
     2163               sym1                                        format "x(1)"  space(0)
     2164               .
     2165           if v-price-sale = 0 or v-price-sale = ?
     2166           then do:
     2167             put stream outstream unformatted
     2168                 v-strline                                   format "x(19)" space(0)
     2169                 .
     2170             run macr_excel_char in this-procedure( v-strline , num#str# , num#col# ) .
     2171           end.
     2172           else do:
     2173             put stream outstream unformatted
     2174             v-price-sale         format ">>>>>>>>>>>>>>>9.99" space(0)
     2175                 .
     2176             run macr_excel_dec in this-procedure( v-price-sale , num#str# , num#col# ) .
     2177             if f-price-roz then do:
     2178               run macr_cell_format in this-procedure
     2179               ( ?     ,
     2180                 ?     ,
     2181                 ?     ,
     2182                 38    ,
     2183                 num#str# ,
     2184                 num#col# ,
     2185                 ?        ,
     2186                 ?        ) .
     2187             end.
     2188           end.
     2189                   assign  num#col# = num#col# + 1 .
     2190         end.
     2191       PUT STREAM OutStream UNFORMATTED skip.
     2192   end.
     2193   end procedure.
     2194   procedure print-all-itog :
     2195   end procedure.
     2196   procedure PrintTitul :
     2197     do  on error undo, return error return-value  :
     2198     define variable cc as integer no-undo .
     2199     define variable tt as integer no-undo .
     2200     define variable pp as integer no-undo .
     2201     define variable ii as integer   no-undo .
     2202   if v-curr-code = ? then
     2203      find first ub.currency no-lock where ub.currency.curr-code = new-curr-code no-error .
     2204   else find first ub.currency no-lock where ub.currency.curr-code = v-curr-code no-error .
     2205    if available ub.currency then v-curr-abbr = ub.currency.curr-abbr .
     2206   PUT STREAM OutStream UNFORMATTED
     2207   space(0)
     2208      v-ReportNAme skip
     2209      "Отчет сформирован: " + cur-time-date() skip
     2210      "На дату:  "  + string (x-date-alone, "99/99/9999") skip
     2211      "Детализация цен:  "  + if entry (1, p-par1) = "bgl" then "По группам покупателей" else "По покупателям" skip
     2212      "Валюта: " + v-curr-abbr skip
     2213         .
     2214     define variable i as integer no-undo .
     2215     Repeat i = 1 to NUM-ENTRIES(ReportHeader,chr(10)) :
     2216       PUT STREAM OutStream UNFORMATTED  Entry(i,ReportHeader,chr(10))  AT 1 format "X(90)" SKIP.
     2217     End.
     2218       num#str# = 1.
     2219       num#col# = 1.
     2220       run macr_cell_format in this-procedure
     2221       ( 14    ,
     2222         true  ,
     2223         false ,
     2224         ?     ,
     2225         1     ,
     2226         1     ,
     2227         num#str# ,
     2228         num#col# ) .
     2229       run macr_excel_char in this-procedure( v-Reportname , num#str# , num#col#   ) .
     2230       num#str# = num#str# + 2.
     2231       run macr_cell_format in this-procedure
     2232       ( 10    ,
     2233         false ,
     2234         false ,
     2235         ?     ,
     2236         num#str# ,
     2237         num#col# ,
     2238         ?     ,
     2239         ?     ) .
     2240       run macr_excel_char in this-procedure( "Отчет сформирован: " + cur-time-date() , num#str# , num#col#   ) .
     2241       num#str# = num#str# + 1.
     2242       run macr_cell_format in this-procedure
     2243       ( 10    ,
     2244         false ,
     2245         false ,
     2246         ?     ,
     2247         num#str# ,
     2248         num#col# ,
     2249         ?     ,
     2250         ?     ) .
     2251       run macr_excel_char in this-procedure("Детализация цен:  "  + if entry (1, p-par1) = "bgl" then "По группам покупателей" else "По покупателям" , num#str# , num#col#   ) .
     2252       num#str# = num#str# + 1.
     2253       run macr_cell_format in this-procedure
     2254       ( 10    ,
     2255         true  ,
     2256         true  ,
     2257         ?     ,
     2258         num#str# ,
     2259         num#col# ,
     2260         ?     ,
     2261         ?     ) .
     2262       run macr_excel_char in this-procedure("На дату:  "  + string (x-date-alone, "99/99/9999")  , num#str# , num#col#   ) .
     2263       num#str# = num#str# + 1.
     2264       run macr_cell_format in this-procedure
     2265       ( 10    ,
     2266         false ,
     2267         false ,
     2268         ?     ,
     2269         num#str# ,
     2270         num#col# ,
     2271         ?     ,
     2272         ?     ) .
     2273       run macr_excel_char in this-procedure("Валюта:  " + v-curr-abbr   , num#str# , num#col#   ) .
     2274       num#str# = num#str# + 1.
     2275       run macr_excel_char in this-procedure("Код"  , num#str# , num#col#   ) .    run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2276       num#col# = 2.
     2277       run macr_excel_char in this-procedure("Артикул"  , num#str# , num#col#   ) .  run macr_cell_size ( 16 , ? , num#str# , num#col# , ?, ? ) .
     2278       num#col# = 3.
     2279       run macr_excel_char in this-procedure("Наименование"  , num#str# , num#col#   ) . run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2280       num#col# = 4.
     2281       run macr_excel_char in this-procedure("Производитель"  , num#str# , num#col#   ) . run macr_cell_size ( 30 , ? , num#str# , num#col# , ?, ? ) .
     2282       num#col# = 5.
     2283       run macr_excel_char in this-procedure("Ед.изм."  , num#str# , num#col#   ) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2284       num#col# = 6.
     2285       run macr_excel_char in this-procedure("Код ТПЛ"  , num#str# , num#col#   ) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2286       num#col# = 7.
     2287       run macr_excel_char in this-procedure("Цена за ед."  , num#str# , num#col#   ) . run macr_cell_size ( 10 , ? , num#str# , num#col# , ?, ? ) .
     2288       repeat ii = 1 to num#col# :
     2289         run macr_cell_format in this-procedure
     2290         ( 10    ,
     2291           true  ,
     2292           false ,
     2293           34    ,
     2294           num#str# ,
     2295           ii       ,
     2296           ?        ,
     2297           ?        ) .
     2298       end.
     2299       run print-1 in this-procedure .
     2300       repeat ii = 1 to v-kol-price :
     2301         find first  temp-header where temp-header.id = ii no-error .
     2302         num#col# = num#col# + 1.
     2303         run macr_excel_char in this-procedure( temp-header.name , num#str# , num#col#   ) .
     2304         run macr_cell_format in this-procedure
     2305         ( 10    ,
     2306           true  ,
     2307           false ,
     2308           34    ,
     2309           num#str# ,
     2310           num#col# ,
     2311           ?        ,
     2312           ?        ) .
     2313       end.
     2314       put  stream macr_excel unformatted
     2315          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  num#col# ) + chr(10)  +
     2316          'BORDER( 2 , 2 , 2 , 2 , 2 , ,0,0,0,0,0) '  + chr(10) +
     2317          'ALIGNMENT(3 , , 4 , 4 ,)'  + chr(10)
     2318          .
     2319       put  stream macr_excel unformatted
     2320          substitute('select("r&1c&2:r&3c&4 ")' , num#str# , 1 , num#str# ,  3 ) + chr(10)  +
     2321          'BORDER( 2, , , , , , , , , , ) '  + chr(10) .
     2322     end.
     2323   end procedure.
     2324   procedure PrintPodval :
     2325     do on error undo, return error return-value  :
     2326     define variable pp as integer no-undo .
     2327     define variable rr as integer no-undo .
     2328       run p-line in this-procedure.
     2329     end.
     2330   end procedure.
     2331   PROCEDURE on-same-page :
     2332     define input parameter p-line-number as integer  no-undo .
     2333     if p-line-number > page-size( OutStream ) then return .
     2334     if line-counter( OutStream ) + p-line-number > page-size( OutStream ) then do:
     2335       run p-line in this-procedure.
     2336       page stream OutStream .
     2337       end.
     2338   end procedure.
     2339   procedure print-1 :
     2340   define variable ii as integer   no-undo .
     2341     do
     2342     on error undo, return error return-value
     2343     :
     2344       run p-line in this-procedure.
     2345       PUT STREAM OutStream UNFORMATTED  ":Код"  AT 1 format "X(11)" .
     2346       PUT STREAM OutStream UNFORMATTED  ":Артикул"  format "X(17)" .
     2347       PUT STREAM OutStream UNFORMATTED  ":Наименование"  format "X(31)" .
     2348       PUT STREAM OutStream UNFORMATTED  ":Производитель"  format "X(31)" .
     2349       PUT STREAM OutStream UNFORMATTED  ":Ед.изм."  format "X(8)" .
     2350       PUT STREAM OutStream UNFORMATTED  ":Код ТПЛ:"  format "X(8)" .
     2351       PUT STREAM OutStream UNFORMATTED  ":Цена за ед. руб."  format "X(18)" .
     2352         repeat ii = 1 to v-kol-price :
     2353           find first  temp-header where temp-header.id = ii no-error .
     2354           put stream outstream unformatted   ":" + string(temp-header.name)    format "x(20)" space(0)  .
     2355         end.
     2356       put stream outstream unformatted skip .
     2357       run p-line in this-procedure.
     2358     end.
     2359   end procedure.
     2360   procedure p-line :
     2361   define variable ii as integer   no-undo .
     2362     do
     2363     on error undo, return error return-value
     2364     :
     2365       PUT STREAM OutStream UNFORMATTED  fill("-",11)  AT 1 format "X(11)" .
     2366       PUT STREAM OutStream UNFORMATTED  fill("-",17)  format "X(17)" .
     2367       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     2368       PUT STREAM OutStream UNFORMATTED  fill("-",31)  format "X(31)" .
     2369       PUT STREAM OutStream UNFORMATTED  fill("-",8)  format "X(8)" .
     2370       PUT STREAM OutStream UNFORMATTED  fill("-",8)  format "X(8)" .
     2371       PUT STREAM OutStream UNFORMATTED  fill("-",18)  format "X(18)" .
     2372         repeat ii = 1 to v-kol-price :
     2373           put stream outstream unformatted   fill("-",21)  format "x(21)" space(0)  .
     2374         end.
     2375       PUT STREAM OutStream UNFORMATTED  skip .
     2376     end.
     2377   end procedure.
     2378   procedure make-header :
     2379   define output parameter ii as integer   no-undo  .
     2380     do
     2381     on error undo, return error return-value
     2382     :
     2383       define variable ix as integer   no-undo  .
     2384       define buffer buf_clients for ub.clients .
     2385       define buffer buf_buyer-in-buyer-group for ub.buyer-in-buyer-group .
     2386       ii = 0 .
     2387       if entry (1, p-par1) = "bgl"
     2388       then do:
     2389         repeat ix = 2 to num-entries (p-par1) :
     2390           for buf_buyer-group no-lock where recid (buf_buyer-group) = int (entry (ix, p-par1) )
     2391                     :
     2392               ii = ii + 1.
     2393               create  temp-header.
     2394               assign
     2395                 temp-header.id     = ii
     2396                 temp-header.name   = buf_buyer-group.name
     2397                 temp-header.bgr-id     = buf_buyer-group.bgr-id
     2398                 temp-header.bgr-db-num = buf_buyer-group.bgr-db-num
     2399               .
     2400           end.
     2401         end.
     2402       end.
     2403       else do:
     2404         repeat ix = 2 to num-entries (p-par1) :
     2405           for buf_clients no-lock where recid (buf_clients) = int (entry (ix, p-par1) )
     2406                     :
     2407               find first buf_buyer-in-buyer-group no-lock
     2408                 where buf_clients.obj-code = buf_buyer-in-buyer-group.bbg-obj-code
     2409                 and buf_clients.obj-type = buf_buyer-in-buyer-group.bbg-obj-type
     2410                 and buf_buyer-in-buyer-group.stts <> 1 no-error
     2411               .
     2412               find first buf_buyer-group no-lock
     2413                 where buf_buyer-group.bgr-id = buf_buyer-in-buyer-group.bgr-id
     2414                 and buf_buyer-group.bgr-db-num = buf_buyer-in-buyer-group.bgr-db-num
     2415                 and buf_buyer-group.stts <> 1 no-error
     2416               .
     2417               if available buf_buyer-group
     2418               then do:
     2419                 ii = ii + 1.
     2420                 create  temp-header.
     2421                 assign
     2422                   temp-header.id     = ii
     2423                   temp-header.name   = buf_clients.obj-name
     2424                   temp-header.bgr-id     = buf_buyer-group.bgr-id
     2425                   temp-header.bgr-db-num = buf_buyer-group.bgr-db-num
     2426                 .
     2427               end.
     2428           end.
     2429         end.
     2430       end.
     2431     end.
     2432   end procedure.
     2433   procedure make-tt :
     2434   define input  parameter p-obj-type as character no-undo .
     2435   define input  parameter p-obj-code as integer no-undo .
     2436   define buffer buf_bar-code for ub.bar-code  .
     2437   define buffer buf_clients  for ub.clients  .
     2438   define variable v-i as integer   no-undo .
     2439     do
     2440     on error undo, return error return-value
     2441     :
     2442     define buffer buf_price-all for ub.price-all.
     2443     v-i = 0.
     2444     for each temp-price : delete temp-price. end.
     2445     for each temp-pdf   : delete temp-pdf  . end.
     2446     case x-SelectGood :
