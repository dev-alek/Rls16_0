      796   define new global shared variable g#library  as handle no-undo .
      797   define new global shared variable g#library2 as handle no-undo .
      798   define variable var-report-r-b as character no-undo .
      799   define variable vss-include-info8 as character format "x(65)" no-undo initial "@(#)$Workfile$".
      800   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
      801     (output var-report-r-b
      802     )  .
      803   function excel-format-dec-to-char returns char (input p-dec as decimal ).
      804     if num-entries(string(p-dec), '.') = 2
      805       then return( entry(1, string(p-dec), '.') + v-delim + entry(2, string(p-dec), '.')) .
      806       else return( string(p-dec)) .
      807   end function.
      808   function format-point-to-comma returns char (input orig as char ) .
      809   define variable rtext as character no-undo .
      810   define variable strt as integer no-undo .
      811   define variable leng as integer no-undo .
      812   assign rtext = orig .
      813   repeat:
      814     strt =  index(rtext,'.').
      815     if strt = 0 then leave.
      816     leng = 1.
      817     substring(rtext,strt,leng,"character") = v-delim .
      818   end.
      819   return rtext.
      820   end function.
      821   function format-excel-text returns char ( input start-text as char ) :
      822   def var  i    as int no-undo.
      823   def var  ch   as char no-undo.
      824   def var  n    as int no-undo.
      825   def var  ipos as int no-undo.
      826     n = num-entries(trim(start-text), chr(10)) - 1 .
      827     do i = 1 to n :
      828       ipos = index( start-text, chr(10)).
      829       if ipos > 0 then
      830         substr( start-text, ipos, 1 ) = ' '.
      831     end.
      832     n = num-entries(trim(start-text), chr(13)) - 1 .
      833     do i = 1 to n :
      834       ipos = index( start-text, chr(13)).
      835       if ipos > 0 then
      836         substr( start-text, ipos, 1 ) = ' '.
      837     end.
      838     if index( start-text, '"' ) = 0 then
      839       start-text =  '="'   + trim( start-text) + '"'   .
      840       else do:
      841         n = num-entries(trim(start-text), '"') - 1.
      842         do i = 1 to n :
      843           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      844         end.
      845         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      846         start-text = '="'  + ch  + '"' .
      847       end.
      848     return start-text.
      849   end.
      850   function excel-sum returns char (input p-dec as decimal ).
      851     return(format-excel-text(excel-format-dec-to-char(round(p-dec,2)))) .
      852   end function.
      853   function excel-qnty returns char (input p-dec as decimal ).
      854     return(format-excel-text(excel-format-dec-to-char(round(p-dec,3)))) .
      855   end function.
      856   function format-excel-text-macr returns char ( input start-text as char ) :
      857   def var  i    as int no-undo.
      858   def var  ch   as char no-undo.
      859   def var  n    as int no-undo.
      860   def var  ipos as int no-undo.
      861     n = num-entries(trim(start-text), chr(10)) - 1 .
      862     do i = 1 to n :
      863       ipos = index( start-text, chr(10)).
      864       if ipos > 0 then
      865         substring( start-text, ipos , 1 ) = ' '.
      866     end.
      867     n = num-entries(trim(start-text), chr(13)) - 1 .
      868     do i = 1 to n :
      869       ipos = index( start-text, chr(13)).
      870       if ipos > 0 then
      871         substring( start-text, ipos, 1 ) = ' '.
      872     end.
      873     if index( start-text, '"' ) = 0 then
      874       start-text =  '"'   + trim( start-text) + '"'   .
      875       else do:
      876         n = num-entries(trim(start-text), '"') - 1.
      877         do i = 1 to n :
      878           ch = ch + entry(i,trim(start-text), '"' ) + '""'.
      879         end.
      880         ch = ch + entry(num-entries(trim(start-text), '"'),trim(start-text), '"' ).
      881         start-text = '"'  + ch  + '"' .
      882       end.
      883     n = num-entries(trim(start-text), chr(10)) - 1 .
      884     do i = 1 to n :
      885       ipos = index( start-text, chr(10)).
      886       if ipos > 0 then
      887         substring( start-text, ipos , 1 ) = ' '.
      888     end.
      889       if num-entries(trim(start-text), chr(10)) > 1 then  message num-entries(trim(start-text), chr(10)) start-text.
      890     return start-text.
      891   end.
      892   def var vss-include-info9 as character format "x(65)" no-undo initial "@(#)$Workfile$ $Revision$".
      893   define temp-table temp-param no-undo   field param-code     as character   field param-sub-code as character   field param-value    as character   index xpk is primary unique param-code param-sub-code   .
      894   procedure paramls-clear :
      895     define buffer buf_temp-param for temp-param .
      896     do
      897     on error undo, return error return-value
      898     :
      899       for each buf_temp-param
      900       on error undo, return error
      901       :
      902         delete buf_temp-param .
      903       end.
      904     end.
      905   end procedure.
      906   procedure paramls-write :
      907     define input  parameter p-code     as character no-undo .
      908     define input  parameter p-sub-code as character no-undo .
      909     define input  parameter p-value    as character no-undo .
      910     define buffer buf_temp-param for temp-param .
      911     do
      912     on error undo, return error return-value
      913     :
      914       find first buf_temp-param
      915         where buf_temp-param.param-code     = p-code
      916           and buf_temp-param.param-sub-code = p-sub-code
      917         no-error .
      918       if not available buf_temp-param then do:
      919         create buf_temp-param .
      920         assign
      921           buf_temp-param.param-code     = p-code
      922           buf_temp-param.param-sub-code = p-sub-code
      923         .
      924       end.
      925       assign
      926         buf_temp-param.param-value = p-value
      927       .
      928     end.
      929   end procedure.
      930   procedure paramls-read :
      931     define input  parameter p-code          as character no-undo .
      932     define input  parameter p-sub-code      as character no-undo .
      933     define input  parameter p-default-value as character no-undo .
      934     define output parameter p-value         as character no-undo .
      935     define buffer buf_temp-param for temp-param .
      936     do
      937     on error undo, return error return-value
      938     :
      939       find first buf_temp-param
      940         where buf_temp-param.param-code     = p-code
      941           and buf_temp-param.param-sub-code = p-sub-code
      942         no-error .
      943       if available buf_temp-param then do:
      944         assign
      945           p-value = buf_temp-param.param-value
      946         .
      947       end.
      948       else do:
      949         assign
      950           p-value = p-default-value
      951         .
      952       end.
      953     end.
      954   end procedure.
      955   procedure paramls-append :
      956     define input  parameter p-code     as character no-undo .
      957     define input  parameter p-sub-code as character no-undo .
      958     define input  parameter p-value    as character no-undo .
      959     define buffer buf_temp-param for temp-param .
      960     do
      961     on error undo, return error return-value
      962     :
      963       find first buf_temp-param
      964            where buf_temp-param.param-code     = p-code
      965              and buf_temp-param.param-sub-code = p-sub-code
      966         no-error .
      967       if not available buf_temp-param then do:
      968         create buf_temp-param .
      969         assign
      970           buf_temp-param.param-code     = p-code
      971           buf_temp-param.param-sub-code = p-sub-code
      972           buf_temp-param.param-value    = p-value
      973         .
      974       end.
      975       else do:
      976           assign
      977               buf_temp-param.param-value = buf_temp-param.param-value + ",":U + p-value
      978           .
      979       end.
      980     end.
      981   end procedure.
      982   define variable v-account as integer init 0 no-undo .
      983   define variable v-account-lavel as character no-undo .
      984   define variable v-button-stop as logical no-undo .
      985   define variable v-kol-spice as integer no-undo .
      986   define variable v-kol-spice2 as integer no-undo .
      987   define variable v-kol-spice3 as integer no-undo .
      988   DEFINE VARIABLE StopProcessing AS LOGICAL NO-UNDO.
      989   DEFINE BUTTON StopBtn AUTO-END-KEY
      990        LABEL "Стоп"
      991        SIZE 10 BY 1.
      992   DEFINE VARIABLE RecordsDone AS INTEGER FORMAT ">,>>>,>>>,>>9":U INITIAL 0
      993        LABEL "Обработано записей"
      994         VIEW-AS TEXT
      995        SIZE 14 BY .67 NO-UNDO.
      996   DEFINE VARIABLE RecordsString AS CHARACTER FORMAT "X(60)"
      997         VIEW-AS TEXT
      998        SIZE 53.25 BY .67
      999        FGCOLOR 1  NO-UNDO.
     1000   DEFINE VARIABLE RecordsString2 AS CHARACTER FORMAT "X(60)"
     1001         VIEW-AS TEXT
     1002        SIZE 53.25 BY .67
     1003        FGCOLOR 1  NO-UNDO.
     1004   DEFINE VARIABLE RecordsString3 AS CHARACTER FORMAT "X(60)"
     1005         VIEW-AS TEXT
     1006        SIZE 53.25 BY .67
     1007        FGCOLOR 1  NO-UNDO.
     1008   DEFINE RECTANGLE RECT-1
     1009        EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL
     1010        SIZE 55.13 BY 4.46.
     1011   DEFINE FRAME InfoFrame
     1012        StopBtn AT ROW 4.25 COL 21.75
     1013        RecordsString AT ROW 1.21 COL 2 NO-LABEL
     1014        RecordsString2 AT ROW 1.96 COL 2 NO-LABEL
     1015        RecordsString3 AT ROW 2.58 COL 2 NO-LABEL
     1016        RecordsDone AT ROW 3.42 COL 24.88 COLON-ALIGNED
     1017        RECT-1 AT ROW 1 COL 1
     1018       WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER
     1019            SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE
     1020            TITLE "Процесс"
     1021            DEFAULT-BUTTON StopBtn CANCEL-BUTTON StopBtn.
     1022   define variable mFrameView      as logical   no-undo init yes.
     1023     define variable mFramHandle as handle no-undo.
     1024     mFramHandle = frame InfoFrame:handle.
     1025     if  log-manager:logfile-name ne ?
     1026     then DO:
     1027         log-manager:write-message("Logname=" + log-manager:logfile-name , "frameRepError").
     1028         log-manager:write-message("Batch-mod=" + string(session:batch-mode) , "frameRepError").
     1029         log-manager:write-message("visible-frame-mod=" + string(mFramHandle:visible), "frameRepError").
     1030     end.
     1031     mFrameView = not session:batch-mode and mFramHandle:visible.
     1032     if mFrameView
     1033     then do:
     1034       ASSIGN
     1035          FRAME InfoFrame:HIDDEN                           = TRUE
     1036          StopBtn:sensitive IN FRAME InfoFrame             = TRUE.
     1037     end.
     1038   ON CHOOSE OF StopBtn IN FRAME InfoFrame
     1039   DO:
     1040     IF not StopProcessing THEN
     1041       Message "Вы действительно хотите прервать" SKIP
     1042               "процесс проверки?" view-as alert-box QUESTION BUTTONS yes-no
     1043                 UPDATE StopProcessing.
     1044     IF StopProcessing THEN do:
     1045        if mFrameView
     1046        then do:
     1047           HIDE FRAME InfoFrame.
     1048        end.
     1049     End.
     1050   END.
     1051   assign v-account = ( if integer( 100 ) = 0 then 100 else integer( 100 ) ).
     1052     if  log-manager:logfile-name ne ?
