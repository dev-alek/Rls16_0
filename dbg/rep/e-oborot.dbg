     1440       ,input  0
     1441       ,input  0
     1442       ,input  0
     1443       ,input  false
     1444       ,output g#log
     1445       )  .
     1446   end.
     1447    if not g#log then
     1448       disable ShowSAle-2 ShowSaleNDS-2 ShowSaleSlt with frame F-Main.
     1449   display editor-1 with frame F-Main.
     1450   END PROCEDURE.
     1451   PROCEDURE my-report :
     1452   case sorttype :
     1453     when "sort-artic" then do:
     1454        run proc-e-obor3-r in this-procedure .
     1455     end.
     1456     when "sort-code" then do:
     1457        run proc-e-obor3-c in this-procedure .
     1458     end.
     1459     when "sort-name" then do:
     1460        run proc-e-obor3-n in this-procedure .
     1461     end.
     1462   end case.
     1463   END PROCEDURE.
     1464   PROCEDURE my-var :
     1465   Assign frame F-Main SumsOnly ShowZero tog-obj Classify SortType
     1466          ShowCost ShowCostNDS ShowSale ShowSaleNDS  ShowSale-2 ShowSaleNDS-2
     1467          TOG-excel ShowZero-2 tog-lavel var-lavel tog-tree ShowMediator
     1468          ShowSaleSLT ShowCost-2 ShowZero-3 long-name tog-wt tog-ms.
     1469   v-show-all-goods  = ShowZero-3 .
     1470   Assign
     1471    STR-obj-type = ''
     1472    STR-obj-code = ''
     1473    STR-obj-name = ''
     1474    STR-obj      = '' .
     1475   For each obj-list no-lock:
     1476    Assign
     1477    STR-obj-type = STR-obj-type + obj-list.obj-type + ','
     1478    STR-obj-code = STR-obj-code + String(obj-list.obj-code) + ','
     1479    STR-obj-name = STR-obj-name + obj-list.obj-name + ','
     1480    STR-obj = STR-obj +  obj-list.obj-type + '#' + string(obj-list.obj-code)  + ',' .
     1481   End.
     1482   ReportNAme = "О Т Ч Е Т   О   С О С Т О Я Н И И   З А П А С А   И   П Р О Д А Ж А Х   ( О Б О Р О Т Н А Я   В Е Д О М О С Т Ь ) по типам документов".
     1483   def var t-class as char no-undo.
     1484   def var t-sort as char no-undo.
     1485     case classify:
     1486       when "no-classify":u    then t-class =   "Без классификации" .
     1487       when "prod":u           then t-class =   "Производители"   .
     1488       when "post":u           then t-class =   "Поставщики"   .
     1489       when "grp-goods":u      then t-class =   "Группы товаров"  .
     1490       when "post/grp-goods":u then t-class =   "Поставщики/Группы товаров" .
     1491       when "prod/grp-goods":u then t-class =   "Производители/Группы товаров" .
     1492       when "grp-goods/prod":u then t-class =   "Группы товаров/Производители" .
     1493       when "grp-goods/post":u then t-class =   "Группы товаров/Поставщики" .
     1494       when  "vat-ps":u        then t-class =   "Ставка НДС" .
     1495       when  "sort":u          then t-class =   "Проба(Сорт)" .
     1496       when  "n-level":u       then t-class =   "Группы с уровнем вложенности " .
     1497       when  "t-level":u       then t-class =   "Терминальные группы" .
     1498    end case.
     1499     case sorttype:
     1500       when "sort-pp":u               then t-sort =   "по порядку" .
     1501       when "sort-code":u             then t-sort =   "по коду" .
     1502       when "sort-artic":u            then t-sort =   "по артикулу"  .
     1503       when "sort-qunty":u            then t-sort =   "по реализации".
     1504       when "sort-name":u             then t-sort =   "по наименованию".
     1505       when "sort-type":u             then t-sort =   "по типу ткани".
     1506       when "sort-doc-code":u         then t-sort =   "по номеру документа".
     1507       when "sort-recipe-code":u      then t-sort =   "по номеру рецепта".
     1508    end case.
     1509   ReportHeader = "Классификация : " + t-Class.
     1510   ReportHeader = ReportHeader +
     1511                  (if tog-lavel  then "    Итоги с уровня  "  + String(var-lavel)  else " "    ).
     1512   ReportHeader = ReportHeader  + chr(10).
     1513   ReportHeader = ReportHeader +
     1514                  "Сортировка " + t-Sort  + chr(10) +
     1515                  "Показать : " +
     1516                  (if tog-wt     then " Вес, "               else " " ) +
     1517                  (if tog-ms     then " Объем, "             else " " ) +
     1518                  (if SumsOnly     then " Только итоги, "             else " " ) +
     1519                  (if ShowCost     then " Суммы в учетных ценах, "    else " " ) +
     1520                  (if ShowCost-2   then " Суммы в учетных ценах без НДС, "    else " " ) +
     1521                  (if ShowCostNDS  then " НДС в учетных ценах, "      else " " ) +
     1522                  (if ShowSale     then " Суммы в продажных ценах, "  else " " ) +
     1523                  (if ShowSaleNDS  then " НДС в продажных ценах "     else " " ) +
     1524                  (if ShowSale-2     then " Суммы в ценах документа, "  else " " ) +
     1525                  (if ShowSaleNDS-2  then " НДС в ценах документа"      else " " ) +
     1526                  (if ShowSaleslt    then " НсП в ценах документа"      else " " ) +
     1527                  (if ShowMediator   then " Суммы в ценах посредника"   else " " )  + chr(10) +
     1528                  (if tog-tree       then " группировка ввиде дерева"   else " " ) +  chr(10) +
     1529                  (if ShowZero-3     then " Показывать все выбранные товары "  else " " ) +
     1530                  (if ShowZero       then " Показывать нулевые остатки "  else " Не показывать нулевые остатки" ) +
     1531                  (if ShowZero-2     then " Показывать нулевые обороты "  else " Не показывать нулевые обороты" ) .
     1532   ReportHeader = ReportHeader + (if Rserv <> 'все':U     then  chr(10) + "Только " + Rserv  else " "  ) .
     1533   if tog-tree and (use-column [1] = false OR use-column [2] = false  ) then  do:
     1534      message "Для получения отчета с группировкой по дереву должны быть выбраны колонки  Код и Артикул !" view-as alert-box .
     1535   return error.
     1536   end.
     1537   END PROCEDURE.
