     4523       input var-lavel        ,
     4524       input rserv            ,
     4525       input ShowMediator     ,
     4526       input ShowSaleSLT      ,
     4527       input ShowCost-2       ,
     4528       input long-name        ,
     4529       input tog-wt           ,
     4530       input tog-ms           ,
     4531       input is-petrl         ,
     4532       input tog-dens
     4533       ) .
     4534           else
     4535           run rep/xlobor6n.p
     4536      (input v-cntxt-obj-code ,
     4537       input v-cntxt-obj-type ,
     4538       input base-type        ,
     4539       input base-code        ,
     4540       input Classify         ,
     4541       input SortType         ,
     4542       input SumsOnly         ,
     4543       input ShowZero         ,
     4544       input ShowZero-2       ,
     4545       input tog-obj          ,
     4546       input ShowCost         ,
     4547       input ShowCostNDS      ,
     4548       input ShowSale         ,
     4549       input ShowSaleNDS      ,
     4550       input ShowSale-2       ,
     4551       input ShowSaleNDS-2    ,
     4552       input tog-lavel        ,
     4553       input var-lavel        ,
     4554       input rserv            ,
     4555       input ShowMediator     ,
     4556       input ShowSaleSLT      ,
     4557       input ShowCost-2       ,
     4558       input long-name        ,
     4559       input tog-wt           ,
     4560       input tog-ms           ,
     4561       input is-petrl         ,
     4562       input tog-dens
     4563       ) .
     4564       end.
     4565     end case.
     4566   End.
     4567   END PROCEDURE.
     4568   PROCEDURE state-changed :
     4569     DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
     4570     DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.
     4571     CASE p-state:
     4572       when "link-changed":U then  DO:
     4573            run my-var in this-procedure .
     4574            End.
     4575     END CASE.
     4576   END PROCEDURE.
