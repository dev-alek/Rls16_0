     1530   do on error undo, return error return-value :
     1531   find first cl_tt-clcparts where recid(cl_tt-clcparts) = parrec-parts no-lock.
     1532   for each bf_tt-allsum on error undo, return error return-value :
     1533     delete bf_tt-allsum.
     1534   end.
     1535   assign
     1536     price-rubl-with-tax-loccl = cl_tt-clcparts.price-rubl
     1537     price-base-with-tax-loccl = cl_tt-clcparts.price-base
     1538   .
     1539   define variable vss-include-info12 as character format "x(65)" no-undo initial "@(#)$Workfile$".
     1540   if (valid-handle(g#library) <> true) then do:   run gbl/library.p persistent no-error .   if error-status :error or (valid-handle(g#library) <> true) then do:     message       "Error starting library.p" skip       g#library skip       g#library :type skip       g#library :file-name skip       error-status :get-message(1) skip       return-value skip       view-as alert-box error .     stop .   end. end. run curr-r-b in g#library
     1541     (output varinvprbcl
     1542     )  .
     1543     if cl_tt-clcparts.out-code = 'free-zone':U     or
     1544        cl_tt-clcparts.out-code = 'out-zone':U   or
     1545        cl_tt-clcparts.doc-type = 'акт':U then do:
     1546       assign
     1547         in-vatp-have-vat-sltcl = yes.
     1548     end.
     1549     else do:
     1550       find first in-vatp_doc-attrcl no-lock
     1551         where in-vatp_doc-attrcl.doc-code  = cl_tt-clcparts.out-code
     1552           and in-vatp_doc-attrcl.attr-code = 'envd':U
     1553         no-error .
     1554       if not available in-vatp_doc-attrcl then do:
     1555         assign
     1556           in-vatp-have-vat-sltcl = yes.
     1557       end.
     1558       else do:
     1559            in-vatp-have-vat-sltcl = no.
     1560       end.
     1561     end.
     1562     assign
     1563      price-cli-with-tax-loccl = cl_tt-clcparts.price-cli
     1564      cli-base-ratecl          = cl_tt-clcparts.cli-base-rate.
     1565     ASSIGN   road-tax-base-loccl  = (if cl_tt-clcparts.road-tax-base  = ? then 0 else cl_tt-clcparts.road-tax-base)
     1566              road-tax-rubl-loccl  = (if cl_tt-clcparts.road-tax-rubl  = ? then 0 else cl_tt-clcparts.road-tax-rubl).
     1567     ASSIGN  transport-base-loccl = (if cl_tt-clcparts.transport-base = ? then 0 else cl_tt-clcparts.transport-base)
     1568             transport-rubl-loccl = (if cl_tt-clcparts.transport-rubl = ? then 0 else cl_tt-clcparts.transport-rubl)
     1569             other-base-loccl     = (if cl_tt-clcparts.other-base     = ? then 0 else cl_tt-clcparts.other-base)
     1570             other-rubl-loccl     = (if cl_tt-clcparts.other-rubl     = ? then 0 else cl_tt-clcparts.other-rubl)
     1571             vat-pc-loccl         = (if cl_tt-clcparts.vat-pc         = ? then 0 else cl_tt-clcparts.vat-pc)
     1572             slt-pc-loccl         = (if cl_tt-clcparts.slt-pc         = ? then 0 else cl_tt-clcparts.slt-pc).
     1573             ASSIGN   slt-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-base-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-base-with-tax-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     1574       ASSIGN   slt-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl)))                           * slt-pc-loccl / (100 + slt-pc-loccl))                        vat-rubl-loccl    = (if in-vatp-have-vat-sltcl = no then 0 else (price-rubl-with-tax-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))) * (1 - slt-pc-loccl / (100 + slt-pc-loccl)) * vat-pc-loccl / (100 + vat-pc-loccl)).
     1575     assign
     1576       exch-rate-cli-loccl = (cl_tt-clcparts.price-rubl - transport-rubl-loccl - other-rubl-loccl - road-tax-rubl-loccl - (if cl_tt-clcparts.vat-type <> 'в т. ч.':U then vat-rubl-loccl else 0) - (if cl_tt-clcparts.slt-type <> 'в т. ч.':U then slt-rubl-loccl else 0)) / cl_tt-clcparts.price-cli .
     1577     assign
     1578       slt-cli-loccl        = slt-rubl-loccl       / exch-rate-cli-loccl
     1579       vat-cli-loccl        = vat-rubl-loccl       / exch-rate-cli-loccl
     1580       road-tax-cli-loccl   = road-tax-rubl-loccl  / exch-rate-cli-loccl
     1581       transport-cli-loccl  = 0
     1582       other-cli-loccl      = 0
     1583     .
     1584   ASSIGN
     1585             price-base-without-tax-loccl = price-base-with-tax-loccl - vat-base-loccl - slt-base-loccl - ((if road-tax-base-loccl  = ? then 0 else road-tax-base-loccl) + (if transport-base-loccl = ? then 0 else transport-base-loccl) + (if other-base-loccl = ? then 0 else other-base-loccl))
     1586       price-rubl-without-tax-loccl = price-rubl-with-tax-loccl - vat-rubl-loccl - slt-rubl-loccl - ((if road-tax-rubl-loccl  = ? then 0 else road-tax-rubl-loccl) + (if transport-rubl-loccl = ? then 0 else transport-rubl-loccl) + (if other-rubl-loccl = ? then 0 else other-rubl-loccl))
     1587   .
     1588   if paris-doc then do:
     1589     assign
     1590       parartic     = cl_tt-clcparts.artic
     1591       parprod-type = cl_tt-clcparts.prod-type
     1592       parprod-code = cl_tt-clcparts.prod-code
     1593       pardoc-type  = cl_tt-clcparts.doc-type
